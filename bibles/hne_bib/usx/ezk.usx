<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZK" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">यहेजकेल</para>
  <para style="toc1">यहेजकेल के किताब</para>
  <para style="toc2">यहेजकेल</para>
  <para style="toc3">यहे</para>
  <para style="mt1">यहेजकेल</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="EZK 1"/>
  <para style="s1">यहेजकेल के पहिला दरसन</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 1:1"/>जब मोर उमर ह तीस साल, चार महिना अऊ पांच दिन रिहिस, अऊ मेंह बंधुवामन के बीच कबार नदी के तीर म रहेंव, त अकास खुल गीस अऊ मेंह परमेसर के दरसनमन ला देखेंव।<verse eid="EZK 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 1:2"/>यहोयाकीन राजा के बंधुवई म जाय के पांचवां साल के पांचवां महिना के पांचवां दिन— <verse eid="EZK 1:2"/><verse number="3" style="v" sid="EZK 1:3"/>बेबिलोन देस म कबार नदी के तीर म, यहोवा के बचन ह बूजी के बेटा यहेजकेल पुरोहित करा आईस, अऊ यहोवा के हांथ ह ओकर ऊपर रिहिस।<verse eid="EZK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 1:4"/>मेंह देखेंव कि उत्तर कोति ले एक बड़े आंधी आवत रिहिस—कड़कत बिजली के संग एक बड़े बादर अऊ चारों कोति बहुंत अंजोर रिहिस। आगी के बीच ह चमकत धातु के सहीं दिखत रिहिस, <verse eid="EZK 1:4"/><verse number="5" style="v" sid="EZK 1:5"/>अऊ आगी म चार जीयत जीवधारी सहीं दिखत रिहिन। देखे म ओमन के रूप ह मनखे असन रिहिस, <verse eid="EZK 1:5"/><verse number="6" style="v" sid="EZK 1:6"/>पर ओमन म ले हर एक के चार ठन मुहूं अऊ चार ठन डेना रिहिस। <verse eid="EZK 1:6"/><verse number="7" style="v" sid="EZK 1:7"/>ओमन के गोड़ सीधा रिहिस; अऊ ओमन के गोड़ के तलवा ह बछरू के खुरमन असन रिहिस अऊ चिक्कन कांसा असन चमकत रिहिस। <verse eid="EZK 1:7"/><verse number="8" style="v" sid="EZK 1:8"/>ओमन के चारों कोति डेनामन के खाल्हे म मनखे सहीं हांथमन रिहिन। ओ चारों के मुहूं अऊ डेनामन रिहिन, <verse eid="EZK 1:8"/><verse number="9" style="v" sid="EZK 1:9"/>अऊ ओमन के डेनामन एक-दूसर के डेना ला छूवत रिहिन। हर एक ह आघू सीधा जावय; अऊ ओमन बिगर मुड़े आघू बढ़त रिहिन।<verse eid="EZK 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 1:10"/>ओमन के मुहूं ह अइसने रिहिस: चारों म ले हर एक के एक मुहूं ह मनखे असन रिहिस, अऊ ओ चारों के जेवनी कोति के मुहूं ह सिंह सहीं, डेरी कोति के मुहूं ह बईला सहीं; अऊ हर एक के गिधवा असन घलो एक मुहूं रिहिस। <verse eid="EZK 1:10"/><verse number="11" style="v" sid="EZK 1:11"/>ओमन के मुहूंमन अइसने ही रिहिन। ओमन के हर एक के दू ठन डेना ऊपर कोति फईले रिहिन, अऊ ये डेनामन अपन दूनों तरफ के जीवधारीमन ला छूवत रिहिन, अऊ हर एक ह दू ठन डेनामन ले अपन देहें ला तोपे रिहिस। <verse eid="EZK 1:11"/><verse number="12" style="v" sid="EZK 1:12"/>ओमन सीधा आघू जावत रिहिन, जेति आतमा जावय, ओमन बिगर मुड़े ओती जावत रिहिन। <verse eid="EZK 1:12"/><verse number="13" style="v" sid="EZK 1:13"/>ओ जीवधारीमन के रूप ह आगी के बरत कोइला या मसाल सहीं रिहिस। ओ आगी ह जीवधारीमन के बीच एती-ओती खसकत रिहिस; येह चमकत रिहिस, अऊ येकर ले बिजली चमकत रिहिस। <verse eid="EZK 1:13"/><verse number="14" style="v" sid="EZK 1:14"/>ओ जीवधारीमन बिजली के चमक सहीं तेजी से एती-ओती होवत रिहिन।<verse eid="EZK 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 1:15"/>जब मेंह जीवधारीमन ला देखत रहेंव, त का देखेंव कि ओ चार मुहूंवाले हर एक जीवधारी के बाजू म भुइयां म एक-एक चक्का रहय। <verse eid="EZK 1:15"/><verse number="16" style="v" sid="EZK 1:16"/>ओ चक्कामन के रूप अऊ बनावट ये किसम ले रहय: ओमन पुखराज असन चमकत रिहिन, अऊ चारों एक समान दिखत रिहिन। ओमन अइसे बनाय गे दिखत रिहिन मानो एक पहिया के भीतर म दूसर पहिया हो। <verse eid="EZK 1:16"/><verse number="17" style="v" sid="EZK 1:17"/>जब ओमन आघू बढ़ंय, त ओमन ओ दिसा म जावंय, जऊन दिसा कोति जीवधारीमन के चेहरा रहय; जब जीवधारीमन चलंय, त पहियामन अपन दिसा नइं बदलंय। <verse eid="EZK 1:17"/><verse number="18" style="v" sid="EZK 1:18"/>ओ चक्कामन के घेरा ह ऊंचा अऊ अद्भूत रिहिस, अऊ चारों पहिया के घेरामन म जम्मो कोति आंखी ही आंखी रिहिस।<verse eid="EZK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 1:19"/>जब ओ जीवधारीमन आघू बढ़ंय, तब ओमन के बाजू के पहियामन घलो आघू बढ़ंय; अऊ जब ओ जीवधारीमन भुइयां ले ऊपर उठंय, तब पहियामन घलो ऊपर उठंय। <verse eid="EZK 1:19"/><verse number="20" style="v" sid="EZK 1:20"/>जऊन कोति आतमा ह जावय, ओती ओमन घलो जावंय, अऊ ओ पहियामन जीवधारीमन के संग ऊपर उठंय; काबरकि ओमन के आतमा ह ओ पहियामन म रिहिस। <verse eid="EZK 1:20"/><verse number="21" style="v" sid="EZK 1:21"/>जब ओ जीवधारीमन आघू बढ़ंय, त येमन घलो आघू बढ़ंय; अऊ जब ओ जीवधारीमन ठाढ़ होवंय, त येमन घलो ठाढ़ हो जावंय; अऊ जब ओमन भुइयां ले ऊपर उठंय, त ये पहियामन घलो ओमन के संग ऊपर उठंय; काबरकि जीवधारीमन के आतमा ह ये पहियामन म रिहिस।<verse eid="EZK 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 1:22"/>जीवधारीमन के मुड़ के ऊपर जऊन चीज ह फईले रिहिस, ओह अकास-मंडल सहीं दिखत रिहिस, अऊ बरफ असन चमकत रिहिस, अऊ अद्भूत रिहिस। <verse eid="EZK 1:22"/><verse number="23" style="v" sid="EZK 1:23"/>अकास-मंडल के खाल्हे, ओमन के डेनामन एक-दूसर कोति फईले रिहिन; अऊ हर एक जीवधारी ह दू ठन डेना ले अपन देहें ला ढांपे रिहिस। <verse eid="EZK 1:23"/><verse number="24" style="v" sid="EZK 1:24"/>जब ओ जीवधारीमन आघू बढ़ंय, त मेंह सुनंय, ओमन के डेना ले बहत पानी के गरजन सहीं, सर्वसक्तिमान परमेसर के अवाज सहीं, सेना के कोलाहल असन अवाज आवय। जब ओमन ठाढ़ होवंय, तब ओमन अपन डेना ला खाल्हे कर लेवंय।<verse eid="EZK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 1:25"/>फेर ओमन के मुड़ीमन के ऊपर जऊन अकास-मंडल रिहिस, ओकरे ऊपर ले एक सबद सुनई पड़य जब ओमन डेना ला लटकाके ठाढ़ होवंय। <verse eid="EZK 1:25"/><verse number="26" style="v" sid="EZK 1:26"/>जऊन ह अकास-मंडल अऊ ओमन के मुड़ के ऊपर म रिहिस, ओह नीलमनि के सिंघासन असन दिखत रिहिस; ये सिंघासन के ऊपर एक मनखे असन कोनो दिखई देवत रिहिस। <verse eid="EZK 1:26"/><verse number="27" style="v" sid="EZK 1:27"/>ओकर कनिहां ले लेके ऊपर कोति मोला चमकत धातु असन दिखई पड़त रिहिस, मानो आगी ले भरे हवय, अऊ ओकर कनिहां ले लेके खाल्हे कोति आगी असन दिखई पड़त रिहिस; अऊ ओकर चारों कोति चमकत अंजोर रिहिस। <verse eid="EZK 1:27"/><verse number="28" style="v" sid="EZK 1:28"/>जइसने बरसात के दिन बादर म धनुस दिखई पड़थे, वइसने ही चारों कोति के अंजोर के चमक दिखत रिहिस।</para>
  <para style="p" vid="EZK 1:28">यहोवा के महिमा के समानता म ये रूप रिहिस। ओला देखके, मेंह मुहूं के बल गिरेंव,<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सास्टांग दंडवत करेंव</char></note> अऊ मेंह एक झन के गोठियाय के अवाज सुनेंव।<verse eid="EZK 1:28"/></para>
  <chapter eid="EZK 1"/>
  <chapter number="2" style="c" sid="EZK 2"/>
  <para style="s1">एक अगमजानी के रूप म यहेजकेल के बुलाहट</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 2:1"/>ओह मोर ले कहिस, “हे मनखे के बेटा, अपन गोड़ म ठाढ़ हो जा, अऊ मेंह तोर ले गोठियाहूं।” <verse eid="EZK 2:1"/><verse number="2" style="v" sid="EZK 2:2"/>जइसने ही ओह मोर ले ये कहिस, वइसने ही आतमा ह मोर म हमाके मोला मोर गोड़ के बल म ठाढ़ कर दीस; अऊ मेंह ओला मोर ले गोठियावत सुनेंव।<verse eid="EZK 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 2:3"/>ओह मोर ले कहिस, “हे मनखे के बेटा, मेंह तोला इसरायलीमन करा याने कि बलवा करइया जाति मेर पठोवत हंव, जेमन मोर बिरूध म बलवा करे हवंय; ओमन अऊ ओमन के पुरखामन आज के दिन तक मोर बिरूध म बिदरोह करत आवत हवंय। <verse eid="EZK 2:3"/><verse number="4" style="v" sid="EZK 2:4"/>जऊन मनखेमन करा मेंह तोला पठोवत हंव, ओमन हठी अऊ जिद्दी अंय। तेंह ओमन ले कहिबे, ‘परमपरधान यहोवा ह ये कहत हे।’ <verse eid="EZK 2:4"/><verse number="5" style="v" sid="EZK 2:5"/>अऊ चाहे ओमन सुनंय या झन सुनंय—काबरकि ओमन बलवा करइया मनखे अंय—ओमन अतका जान लीहीं कि ओमन के बीच म एक अगमजानी हवय। <verse eid="EZK 2:5"/><verse number="6" style="v" sid="EZK 2:6"/>अऊ तें, हे मनखे के बेटा, ओमन ले या ओमन के बात ले झन डरबे। झन डरबे, हालाकि कंटिली झाड़ी अऊ कांटामन तोर चारों कोति हवंय अऊ तेंह बिच्छूमन के बीच म रहिथस। ओमन के बात ले झन डरबे अऊ ओमन ले भयभीत झन होबे, हालाकि ओमन बिदरोही मनखे अंय। <verse eid="EZK 2:6"/><verse number="7" style="v" sid="EZK 2:7"/>तेंह ओमन ला मोर बात ला जरूर बताबे, चाहे ओमन सुनंय या झन सुनंय, काबरकि ओमन बिदरोही मनखे अंय। <verse eid="EZK 2:7"/><verse number="8" style="v" sid="EZK 2:8"/>पर तें, हे मनखे के बेटा, मेंह जऊन बात कहत हंव, ओला सुन। ओ बिदरोही मनखेमन असन तेंह बिदरोह झन करबे; जऊन कुछू मेंह तोला देवत हंव, ओला मुहूं खोलके खा ले।”<verse eid="EZK 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 2:9"/>तब मेंह देखेंव कि मोर कोति एक हांथ बढ़िस। ओ हांथ म एक ठन किताब रिहिस, <verse eid="EZK 2:9"/><verse number="10" style="v" sid="EZK 2:10"/>जेला ओह मोर आघू म खोलिस। ओ किताब के दूनों कोति बिलाप अऊ सोक अऊ दुख के बातमन लिखाय रिहिन।<verse eid="EZK 2:10"/></para>
  <chapter eid="EZK 2"/>
  <chapter number="3" style="c" sid="EZK 3"/>
  <para style="p">
    <verse number="1" style="v" sid="EZK 3:1"/>अऊ ओह मोर ले कहिस, “हे मनखे के बेटा, तोर आघू म जऊन कुछू हवय, ओला खा ले; याने कि ये किताब ला खा, तब जाके इसरायल के मनखेमन ले गोठिया।” <verse eid="EZK 3:1"/><verse number="2" style="v" sid="EZK 3:2"/>एकरसेति मेंह मुहूं खोलेंव, अऊ ओह ओ किताब ला मोला खाय बर दीस।<verse eid="EZK 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 3:3"/>तब ओह मोर ले कहिस, “हे मनखे के बेटा, ये किताब, जेला मेंह तोला देवत हंव, येला खा अऊ येकर से अपन पेट भर ले।” त मेंह ओला खा लेंव, अऊ ओह मोर मुहूं म मंधरस सहीं मीठ लगिस।<verse eid="EZK 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 3:4"/>तब ओह मोर ले कहिस: “हे मनखे के बेटा, अब तें इसरायल के मनखेमन करा जाके ओमन ला मोर बात सुना। <verse eid="EZK 3:4"/><verse number="5" style="v" sid="EZK 3:5"/>तोला कोनो कठिन बोली या अनजान भासा वाले मनखेमन करा भेजे नइं जावत हे, पर तोला इसरायल के मनखेमन करा पठोय जावत हे— <verse eid="EZK 3:5"/><verse number="6" style="v" sid="EZK 3:6"/>कठिन बोली या अनजान भासा वाले बहुंते मनखेमन करा नइं, जेमन के गोठ ला तें नइं समझ सकस। खचित यदि मेंह तोला ओमन करा पठोय रहितेंव, त ओमन तोर बात ला सुनतिन। <verse eid="EZK 3:6"/><verse number="7" style="v" sid="EZK 3:7"/>पर इसरायल के मनखेमन तोर बात ला सुने नइं चाहत हें, काबरकि ओमन मोर बात ला सुने नइं चाहत हें; जम्मो इसरायलीमन अपन मन ला कठोर कर ले हवंय अऊ जिद्दी हो गे हवंय। <verse eid="EZK 3:7"/><verse number="8" style="v" sid="EZK 3:8"/>पर मेंह तोला ओमन सहीं न झुकनेवाला अऊ कठोर बना दूहूं। <verse eid="EZK 3:8"/><verse number="9" style="v" sid="EZK 3:9"/>मेंह तोर माथा ला सबले कठोर पथरा सहीं कर दूहूं, चकमक पथरा ले घलो कठोर। ओमन ले झन डरबे या ओमन ले भयभीत झन होबे, हालाकि ओमन बिदरोही मनखे अंय।”<verse eid="EZK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 3:10"/>अऊ ओह मोर ले कहिस, “हे मनखे के बेटा, धियान देके सुन अऊ जऊन बात मेंह तोर ले कहत हंव, ओ जम्मो ला अपन हिरदय म धर। <verse eid="EZK 3:10"/><verse number="11" style="v" sid="EZK 3:11"/>अब बंधुवई म गय अपन ओ मनखेमन करा जाके ओमन ले बातचीत कर। ओमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे,’ चाहे ओमन सुनंय या झन सुनंय।”<verse eid="EZK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 3:12"/>तब आतमा ह मोला ऊपर उठाईस, अऊ मेंह अपन पाछू बड़े घरघराहट के अवाज सुनेंव, जब यहोवा के तेज ह ओ जगह ले उठिस, जिहां ओह रिहिस। <verse eid="EZK 3:12"/><verse number="13" style="v" sid="EZK 3:13"/>येह जीवधारीमन के ओ डेनामन के अवाज रिहिस, जेमन एक-दूसर ले रगड़ात रिहिन, अऊ येह ओमन के बाजू के पहियामन के अवाज रिहिस, एक बड़े घरघराहट के अवाज। <verse eid="EZK 3:13"/><verse number="14" style="v" sid="EZK 3:14"/>आतमा ह तब मोला उठाके दूरिहा ले गीस, अऊ मोर मन ह करू हो गे अऊ मेंह कोरोध ले भर गेंव, अऊ यहोवा के मजबूत हांथ ह मोर ऊपर रिहिस। <verse eid="EZK 3:14"/><verse number="15" style="v" sid="EZK 3:15"/>मेंह ओ बंधुवा मनखेमन करा आयेंव, जेमन कबार नदी के लकठा म तेल-अबीब म रहत रिहिन। अऊ उहां, जिहां ओमन रहत रिहिन, मेंह सात दिन तक ओमन के बीच म दुखी होके बईठे रहेंव।<verse eid="EZK 3:15"/></para>
  <para style="s1">पहरेदार के रूप म यहेजकेल के काम</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 3:16"/>सात दिन के आखिरी म यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 3:16"/><verse number="17" style="v" sid="EZK 3:17"/>“हे मनखे के बेटा, मेंह तोला इसरायल के मनखेमन बर एक पहरेदार ठहिराय हंव; एकरसेति जऊन बात मेंह कहत हंव, ओला सुन अऊ ओमन ला मोर कोति ले चेता दे। <verse eid="EZK 3:17"/><verse number="18" style="v" sid="EZK 3:18"/>जब मेंह एक दुस्ट मनखे ला कहिथंव, ‘तेंह जरूर मरबे,’ अऊ यदि तें ओकर जिनगी बचाय बर ओकर दुस्ट चालचलन ला बदले बर नइं चेतावस या नइं कहस, त ओ दुस्ट मनखे ह अपन पाप के कारन मरही, अऊ मेंह तोला ओकर खून बर जिम्मेदार ठहिराहूं। <verse eid="EZK 3:18"/><verse number="19" style="v" sid="EZK 3:19"/>पर यदि तेंह दुस्ट मनखे ला चेताथस अऊ ओह अपन दुस्टता ला या अपन बुरई के काम ला नइं छोंड़य, त ओह अपन पाप के कारन मरही; पर तें अपनआप ला बचा लेबे।<verse eid="EZK 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 3:20"/>“जब कोनो धरमी जन अपन धरमीपन ले फिरके दुस्ट काम करथे, अऊ मेंह ओकर आघू म ठोकर खाय के चीज धर देथंव, त ओह मरही, काबरकि तेंह ओला नइं चेताय, एकरसेति ओह अपन पाप म मरही। अऊ जऊन धरमी काम ओह करे होही, ओला सुरता नइं करे जावय, अऊ मेंह तोला ओकर खून बर जिम्मेदार ठहिराहूं। <verse eid="EZK 3:20"/><verse number="21" style="v" sid="EZK 3:21"/>पर यदि तें धरमी जन ला पाप नइं करे बर चेताथस अऊ ओह पाप नइं करय, त ओह जरूर जीयत रहिही, काबरकि ओह चेतउनी ऊपर धियान दीस, अऊ तें अपनआप ला बचा लेबे।”<verse eid="EZK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 3:22"/>यहोवा के हांथ ह उहां मोर ऊपर रिहिस, अऊ ओह मोर ले कहिस, “उठ अऊ मैदान म जा, अऊ उहां मेंह तोर ले गोठियाहूं।” <verse eid="EZK 3:22"/><verse number="23" style="v" sid="EZK 3:23"/>तब मेंह उठके मैदान म गेंव, अऊ मेंह देखेंव कि यहोवा के तेज ह उहां रिहिस, ये तेज ह वइसने ही रिहिस, जइसने मेंह कबार नदी के तीर म देखे रहेंव, अऊ मेंह मुहूं के बल गिर पड़ेंव।<verse eid="EZK 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 3:24"/>तब आतमा ह मोर म हमाईस अऊ मोला मोर गोड़मन म ठाढ़ कर दीस। ओह मोर ले गोठियाईस अऊ कहिस: “जा, अपनआप ला अपन घर के भीतरी बंद कर ले। <verse eid="EZK 3:24"/><verse number="25" style="v" sid="EZK 3:25"/>अऊ हे मनखे के बेटा, ओमन तोला रस्सी म बांध दीहीं; तोला बांध दिये जाही, जेकर कारन तेंह निकलके मनखेमन के बीच म नइं जा सकबे। <verse eid="EZK 3:25"/><verse number="26" style="v" sid="EZK 3:26"/>मेंह तोर जीभ ला तोर मुहूं के तालू ले चपका दूहूं; जेकर ले तेंह चुपेचाप रहिबे अऊ ओमन ला डांट नइं सकबे, काबरकि ओमन बिदरोही मनखे अंय। <verse eid="EZK 3:26"/><verse number="27" style="v" sid="EZK 3:27"/>पर जब मेंह तोर ले गोठियाहूं, तब मेंह तोर मुहूं ला खोल दूहूं अऊ तें ओमन ला कहिबे, ‘परमपरधान यहोवा ह ये कहत हे।’ जऊन ह सुने चाहथे, ओह सुनय, अऊ जऊन ह नइं सुने चाहय, ओह झन सुनय; काबरकि ओमन बिदरोही मनखे अंय।<verse eid="EZK 3:27"/></para>
  <chapter eid="EZK 3"/>
  <chapter number="4" style="c" sid="EZK 4"/>
  <para style="s1">यरूसलेम के घेराबंदी ला देखाय के चिनहां</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 4:1"/>“अब, हे मनखे के बेटा, तें माटी के एक ईंटा ला ले अऊ येला अपन आघू म रखके ओकर ऊपर यरूसलेम सहर के तसबीर बना। <verse eid="EZK 4:1"/><verse number="2" style="v" sid="EZK 4:2"/>तब येकर घेराबंदी कर: येकर बिरूध घेराबंदी के काम कर, येमा एक ठन उतारू जगह बना, येकर बिरूध छावनीमन ला देखा अऊ येकर चारों कोति बार-बार पीटके अवाज करइया मसीन लगा। <verse eid="EZK 4:2"/><verse number="3" style="v" sid="EZK 4:3"/>तब तेंह लोहा के एक कढ़ाही ले, अऊ ओला अपन अऊ सहर के बीच लोहा के एक दीवार सहीं रख अऊ अपन मुहूं ला ओकर कोति कर। त ओकर घेराबंदी हो जाही, अऊ तें ओकर घेराबंदी कर लेबे। येह इसरायल के मनखेमन बर एक चिनहां ठहिरही।<verse eid="EZK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 4:4"/>“फेर तें डेरी करवट लेके लेट जा अऊ इसरायल के मनखेमन के पाप ला अपन ऊपर रख।<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अपन तरफ रख</char></note> तोला बहुंत दिन तक अइसने करवट म लेटके ओमन के पाप के बोझा ला सहना हे। <verse eid="EZK 4:4"/><verse number="5" style="v" sid="EZK 4:5"/>ओमन जतेक साल पाप म लगाय हवंय, मेंह ओही संखिया म तोर बर दिन ठहिराय हवंव; याने कि 390 दिन तक तें इसरायल के मनखेमन के पाप के भार ला सहत रहिबे।<verse eid="EZK 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 4:6"/>“जब तें येला पूरा कर लेबे, तब तें फेर लेट जाबे, ये बेरा जेवनी करवट म लेटबे, अऊ यहूदा के मनखेमन के पाप ला सहिबे। मेंह तोर बर 40 दिन ठहिराय हंव, हर साल बर एक दिन। <verse eid="EZK 4:6"/><verse number="7" style="v" sid="EZK 4:7"/>तब तें अपन मुहूं ला यरूसलेम के घेराबंदी कोति कर लेबे अऊ उघरे बाहां ओकर बिरूध अगमबानी करबे। <verse eid="EZK 4:7"/><verse number="8" style="v" sid="EZK 4:8"/>मेंह तोला रस्सीमन ले बांध दूहूं, ताकि तेंह करवट नइं बदल सकबे, जब तक कि तेंह अपन घेराबंदी के दिनमन ला पूरा नइं कर लेबे।<verse eid="EZK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 4:9"/>“तें गहूं अऊ जौ, सेमी अऊ दाल, बाजरा अऊ कठिया गहूं ला ले; येमन ला एक ठन बड़े बरतन म रख अऊ ओमन ले अपन बर रोटी बनाय करबे। तेंह येला ओ 390 दिन के दौरान खाय करबे, जब तें अपन करवट म लेटे रहिबे। <verse eid="EZK 4:9"/><verse number="10" style="v" sid="EZK 4:10"/>हर दिन तोला तऊलके बीस सेकेल<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">लगभग 230 ग्राम</char></note> जेवन करना हे अऊ ये जेवन ला ठहिराय गे समय म करना हे। <verse eid="EZK 4:10"/><verse number="11" style="v" sid="EZK 4:11"/>पानी ला घलो तें नापके; हर दिन एक हीन<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">लगभग 0.6 लीटर</char></note> के छठवां भाग ला ठहिराय गय समय म पीबे। <verse eid="EZK 4:11"/><verse number="12" style="v" sid="EZK 4:12"/>तोर जेवन जौ के बने एक रोटी बरोबर होही; येला मनखेमन के देखत म बनाबे अऊ येला बनाय बर मनखे के मल के उपयोग आगी बारे बर करबे।” <verse eid="EZK 4:12"/><verse number="13" style="v" sid="EZK 4:13"/>फेर यहोवा ह कहिस, “ये किसम ले इसरायल के मनखेमन ओ जातिमन के बीच म असुध जेवन खाय करहीं, जिहां मेंह ओमन ला भगा दूहूं।”<verse eid="EZK 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 4:14"/>तब मेंह कहेंव, “हे परमपरधान यहोवा, अइसन झन होवय। मेंह अपनआप ला कभू असुध नइं करे हवंव। अपन जवानी ले लेके अब तक मेंह कोनो मरे पसु अऊ जंगली पसु के दुवारा मारे गय मांस नइं खाय हंव। कोनो भी असुध मांस मोर मुहूं म कभू नइं गे हवय।”<verse eid="EZK 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 4:15"/>तब ओह मोला कहिस, “ठीक हे, मेंह तोला रोटी बनाय बर मनखे के मल के बदले आगी बर गाय के गोबर के उपयोग करे बर देवत हंव।”<verse eid="EZK 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 4:16"/>फेर ओह मोर ले कहिस, “हे मनखे के बेटा, मेंह यरूसलेम म जेवन-पानी देना बंद कर दूहूं। ये खातिर मनखेमन हर दिन तऊल-तऊलके चिंता करत जेवन करहीं अऊ नाप-नापके निरास मन से पानी पीहीं, <verse eid="EZK 4:16"/><verse number="17" style="v" sid="EZK 4:17"/>काबरकि जेवन अऊ पानी के कमी हो जाही। ओमन एक-दूसर ला देखके डर जाहीं अऊ अपन पाप के कारन बरबाद हो जाहीं।<verse eid="EZK 4:17"/></para>
  <chapter eid="EZK 4"/>
  <chapter number="5" style="c" sid="EZK 5"/>
  <para style="s1">नियाय बर परमेसर के उस्तरा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 5:1"/>“अब, हे मनखे के बेटा, एक धारदार तलवार ला ले, अऊ ओकर उपयोग अपन मुड़ अऊ दाढ़ी के चुंदी ला मुड़ाय बर उस्तरा के रूप म कर। तब तराजू लेके चुंदीमन के भाग कर ले। <verse eid="EZK 5:1"/><verse number="2" style="v" sid="EZK 5:2"/>जब तोर घेराबंदी के दिनमन खतम हो जावंय, तब सहर के भीतर एक तिहाई चुंदी ला जला देबे। तब एक तिहाई चुंदी ला लेके सहर के चारों कोति जाके तलवार ले मारबे। अऊ एक तिहाई चुंदी ला हवा म उड़ा देबे। काबरकि मेंह तलवार खींचके ओमन के पीछा करहूं। <verse eid="EZK 5:2"/><verse number="3" style="v" sid="EZK 5:3"/>पर कुछू चुंदी ला लेके अपन ओनहा के छोर के मोड़ान म खोंच देबे। <verse eid="EZK 5:3"/><verse number="4" style="v" sid="EZK 5:4"/>फेर ये चुंदी म ले कुछू ला लेबे अऊ ओमन ला आगी म फेंकके जला देबे। उहां ले एक ठन जुवाला ह पूरा इसरायल म फईल जाही।<verse eid="EZK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 5:5"/>“परमपरधान यहोवा ह ये कहत हे: येह यरूसलेम अय, जेला मेंह जाति-जाति के मनखेमन के एकदम मांझा म बसाय हंव, अऊ येह चारों कोति ले देसमन ले घिरे हवय। <verse eid="EZK 5:5"/><verse number="6" style="v" sid="EZK 5:6"/>तभो ले ओह मोर कानून अऊ बिधिमन के बिरूध अपन चारों कोति के जाति अऊ देसमन ले जादा बिदरोह करे हवय। ओह मोर कानूनमन ला नइं माने हे अऊ मोर बिधिमन के पाछू नइं चले हे।<verse eid="EZK 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 5:7"/>“एकरसेति परमपरधान यहोवा ह ये कहत हे: तुमन अपन चारों कोति के जातिमन ले जादा उदंड हो गे हव अऊ मोर बिधिमन म नइं चले हव या मोर कानून ला नइं माने हव। अऊ त अऊ तुमन अपन चारों कोति के जातिमन के बराबरी के भी नइं बने हवव।<verse eid="EZK 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 5:8"/>“ये खातिर परमपरधान यहोवा ह ये कहत हे: हे यरूसलेम, मेंह खुद तोर बिरूध म हवंव, अऊ जाति-जाति के मनखेमन के देखत म ही मेंह तोला दंड दूहूं। <verse eid="EZK 5:8"/><verse number="9" style="v" sid="EZK 5:9"/>तोर जम्मो घिनौना मूरतीमन के कारन, मेंह तोर बीच म अइसन करहूं, जइसन मेंह पहिले कभू नइं करे हंव अऊ न ही भविस्य म कभू करहूं। <verse eid="EZK 5:9"/><verse number="10" style="v" sid="EZK 5:10"/>ये खातिर तोर बीच म दाई-ददामन अपन लइकामन के, अऊ लइकामन अपन दाई-ददामन के मांस ला खाहीं। मेंह तोला सजा दूहूं अऊ तोर जम्मो बांचे मनखेमन ला चारों कोति तितिर-बितिर कर दूहूं। <verse eid="EZK 5:10"/><verse number="11" style="v" sid="EZK 5:11"/>ये खातिर मोर जिनगी के कसम, परमपरधान यहोवा ह घोसना करत हे, काबरकि तेंह मोर पबितर-स्थान ला अपन जम्मो दुस्ट मूरती अऊ घिनौना काममन ले असुध कर दे हस, मेंह खुद तोला छोलहूं; मेंह तोर ऊपर दया-दिरिस्टी नइं करंव अऊ तोला नइं बचावंव। <verse eid="EZK 5:11"/><verse number="12" style="v" sid="EZK 5:12"/>तोर एक तिहाई मनखेमन महामारी ले मरहीं या तोर बीच म ही अकाल ले मर जाहीं; एक तिहाई मनखेमन तोर दीवारमन के बाहिर तलवार ले मारे जाहीं; अऊ एक तिहाई मनखेमन ला मेंह चारों कोति तितिर-बितिर कर दूहूं अऊ तलवार खींचके ओमन के पीछा करहूं।<verse eid="EZK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 5:13"/>“तब मोर कोरोध ह बंद होही अऊ ओमन के बिरूध मोर कोप ह सांत होही, अऊ मोर बदला लेवई ह पूरा होही। अऊ जब ओमन ऊपर मोर कोप ह भड़कके सांत हो जाही, तब ओमन जानहीं कि में यहोवा ह अपन उत्साह म आके ये कहे हवंव।<verse eid="EZK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 5:14"/>“मेंह तोला तोर चारों कोति के जातिमन के बीच, जम्मो अवइया-जवइयामन के देखत म उजाड़ दूहूं अऊ तोला कलंकित करहूं। <verse eid="EZK 5:14"/><verse number="15" style="v" sid="EZK 5:15"/>जब मेंह तोला कोरोध म अऊ कोप म पीरा देवइया डांट के संग सजा दूहूं, तब तेंह तोर चारों कोति के जातिमन के मनखेमन बर एक कलंक अऊ एक ठट्ठा, एक चेतउनी अऊ एक आतंक के चीज बन जाबे। में यहोवा ह ये कहे हवंव। <verse eid="EZK 5:15"/><verse number="16" style="v" sid="EZK 5:16"/>जब मेंह अपन घातक अऊ बिनासकारी अकाल के तीरमन ला तोर ऊपर छोंड़हूं, त मेंह तोला नास करे बर येमन ला छोंड़हूं। मेंह तोर ऊपर बार-बार अकाल लानहूं अऊ तोर जेवन-पानी ला बंद कर दूहूं। <verse eid="EZK 5:16"/><verse number="17" style="v" sid="EZK 5:17"/>मेंह तुम्हर बिरूध अकाल अऊ जंगली पसुमन ला पठोहूं, अऊ ओमन तुम्हर लइकामन ला मार डारहीं। महामारी अऊ खून बहई तुम्हर बीच म चलत रहिही, अऊ मेंह तुम्हर ऊपर तलवार चलवाहूं। में यहोवा ह ये कहे हवंव।”<verse eid="EZK 5:17"/></para>
  <chapter eid="EZK 5"/>
  <chapter number="6" style="c" sid="EZK 6"/>
  <para style="s1">इसरायल के पहाड़मन बर परमेसर के दंड</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 6:1"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 6:1"/><verse number="2" style="v" sid="EZK 6:2"/>“हे मनखे के बेटा, अपन मुहूं ला इसरायल के पहाड़मन कोति करके; ओमन के बिरूध म अगमबानी कर <verse eid="EZK 6:2"/><verse number="3" style="v" sid="EZK 6:3"/>अऊ कह: हे इसरायल के पहाड़मन, तुमन परमपरधान यहोवा के बचन ला सुनव। परमपरधान यहोवा ह पहाड़ अऊ पहाड़ीमन ले, तराई अऊ घाटीमन ले ये कहत हे: मेंह तुम्हर ऊपर एक तलवार चलइया हंव, अऊ मेंह तुम्हर पूजा-पाठ के ऊंचहा जगहमन ला नास कर दूहूं। <verse eid="EZK 6:3"/><verse number="4" style="v" sid="EZK 6:4"/>तुम्हर बेदीमन ला गिरा दिये जाही अऊ तुम्हर धूप के बेदीमन ला कुचर दिये जाही; अऊ मेंह तुम्हर मनखेमन ला तुम्हर मूरतीमन के आघू म मार डारहूं। <verse eid="EZK 6:4"/><verse number="5" style="v" sid="EZK 6:5"/>मेंह इसरायलीमन के लासमन ला ओमन के मूरतीमन के आघू म मढ़ा दूहूं, अऊ मेंह तुम्हर हाड़ामन ला तुम्हर बेदीमन के चारों कोति बगरा दूहूं। <verse eid="EZK 6:5"/><verse number="6" style="v" sid="EZK 6:6"/>जिहां भी तुमन रहिहू, उहां नगरमन उजड़ जाहीं अऊ पूजा के ऊंचहा जगहमन गिर जाहीं, जेकर से तुम्हर बेदीमन उजड़ जाहीं अऊ नास हो जाहीं, तुम्हर मूरतीमन कुचराके नास हो जाहीं, तुम्हर धूप के बेदीमन टूटके गिर जाहीं, अऊ तुम्हर बनाय चीजमन खतम हो जाहीं। <verse eid="EZK 6:6"/><verse number="7" style="v" sid="EZK 6:7"/>तुम्हर मनखेमन तुम्हर बीच म ही मरके गिरहीं, अऊ तुमन जान लूहू कि मेंह यहोवा अंव।<verse eid="EZK 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 6:8"/>“ ‘तभो ले मेंह कतेक झन ला बचाके रखहूं, तुमन म ले कुछू झन तलवार ले बच जाहू जब तुमन देस-देस म अऊ जाति-जाति के मनखेमन के बीच तितिर-बितिर हो जाहू। <verse eid="EZK 6:8"/><verse number="9" style="v" sid="EZK 6:9"/>तब ओ जातिमन के बीच जिहां ओमन बंधुवई म जाहीं, अऊ जेमन बांचे रहिहीं, ओमन मोला सुरता करहीं—ओमन के ओ बेभिचारी हिरदय ले मेंह कतेक दुखी होय हवंव, जऊन ह मोर ले दूरिहा हो गे हवय, अऊ ओमन के ओ आंखीमन ले मेंह कतेक दुखी हंव, जेमन ओमन के मूरतीमन के लालसा करथें। ओमन अपन करे गय बुरई के काम अऊ अपन जम्मो घिनौना बुता के कारन अपनआप ले घिन करहीं। <verse eid="EZK 6:9"/><verse number="10" style="v" sid="EZK 6:10"/>अऊ ओमन जान लीहीं कि मेंह यहोवा अंव; ओमन ऊपर ये बिपत्ति लाने बर, मेंह ओमन ला बेकार म नइं धमकाय रहेंव।<verse eid="EZK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 6:11"/>“ ‘परमपरधान यहोवा ह ये कहत हे: अपन हांथमन ला एक संग मारके अऊ अपन गोड़मन ला पटकके जोर से कहव, “हाय-हाय!” इसरायल के मनखेमन के जम्मो दुस्ट अऊ घिनौना बुतामन के कारन ओमन तलवार, अकाल अऊ महामारी ले नास हो जाहीं। <verse eid="EZK 6:11"/><verse number="12" style="v" sid="EZK 6:12"/>जऊन ह दूरिहा म हवय, ओह महामारी ले मरही, अऊ जऊन ह लकठा म हवय, ओह तलवार ले मारे जाही, अऊ जऊन ह बांचे हे अऊ छोंड़ दिये जाथे, ओह अकाल ले मरही। ये किसम ले मेंह अपन कोप ओमन ऊपर डालहूं। <verse eid="EZK 6:12"/><verse number="13" style="v" sid="EZK 6:13"/>अऊ ओमन जान लीहीं कि मेंह यहोवा अंव, जब हर एक ऊंचा पहाड़ी अऊ जम्मो पहाड़मन के टीप म, हर एक फईले रूख अऊ हर एक पानवाले बलूत रूख के खाल्हे म—ओ जगह जिहां ओमन अपन जम्मो मूरतीमन ला खुसबूवाला धूप चघाथें, उहां ओमन के मारे गय मनखेमन ओमन के मूरतीमन के बीच ओमन के बेदीमन के चारों कोति पड़े होहीं। <verse eid="EZK 6:13"/><verse number="14" style="v" sid="EZK 6:14"/>अऊ मेंह अपन हांथ ओमन के बिरूध बढ़ाहूं अऊ ओ देस ला मरू-भुइयां ले लेके दिबलाह<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">कुछू इबरानी हस्तलिपि म </char><char style="fqa" closed="false">रिबला</char></note> तक उजाड़ दूहूं—ओ सब जगह, जिहां ओमन रहिथें। तब ओमन जान लीहीं कि मेंह यहोवा अंव।’ ”<verse eid="EZK 6:14"/></para>
  <chapter eid="EZK 6"/>
  <chapter number="7" style="c" sid="EZK 7"/>
  <para style="s1">आखिरी समय आ गे हवय</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 7:1"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 7:1"/><verse number="2" style="v" sid="EZK 7:2"/>“हे मनखे के बेटा, परमपरधान यहोवा ह इसरायल देस ला ये कहत हे:</para>
  <para style="q1" vid="EZK 7:2">“ ‘अन्त! देस के चारों कोना म</para>
  <para style="q2" vid="EZK 7:2">आखिरी समय आ गे हवय!<verse eid="EZK 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 7:3"/>तोर आखिरी समय आ गे हवय,</para>
  <para style="q2" vid="EZK 7:3">अऊ मोर कोप ह तोर ऊपर भड़कही।</para>
  <para style="q1" vid="EZK 7:3">तोर चालचलन के मुताबिक मेंह तोर नियाय करहूं</para>
  <para style="q2" vid="EZK 7:3">अऊ तोर जम्मो घिनौना काममन के फर तोला दूहूं।<verse eid="EZK 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 7:4"/>मेंह तोर ऊपर दया-दिरिस्टी नइं करंव;</para>
  <para style="q2" vid="EZK 7:4">मेंह तोला नइं छोड़ंव।</para>
  <para style="q1" vid="EZK 7:4">खचित मेंह तोर चालचलन के</para>
  <para style="q2" vid="EZK 7:4">अऊ तुम्हर बीच के घिनौना काममन के बदला लूहूं।</para>
  <para style="m" vid="EZK 7:4">तब तेंह जान लेबे कि मेंह यहोवा अंव।’<verse eid="EZK 7:4"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="5" style="v" sid="EZK 7:5"/>“परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 7:5">“ ‘घोर बिपत्ति! नइं सुने गय घोर बिपत्ति!</para>
  <para style="q2" vid="EZK 7:5">देखव, येह आवत हे!<verse eid="EZK 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 7:6"/>अन्त आ गे हवय!</para>
  <para style="q2" vid="EZK 7:6">अन्त आ गे हवय!</para>
  <para style="q1" vid="EZK 7:6">येह खुद तोर बिरूध जाग गे हवय।</para>
  <para style="q2" vid="EZK 7:6">देखव, येह आवत हे!<verse eid="EZK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 7:7"/>बिनास ह तुम्हर ऊपर आ गे हवय,</para>
  <para style="q2" vid="EZK 7:7">तुम्हर ऊपर, जेमन देस म रहिथव।</para>
  <para style="q1" vid="EZK 7:7">समय ह आ गे हवय! दिन ह लकठा म हवय!</para>
  <para style="q2" vid="EZK 7:7">पहाड़मन म आनंद नइं, पर आतंक हवय।<verse eid="EZK 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 7:8"/>तोर ऊपर मोर कोप भड़कनेच वाला हे</para>
  <para style="q2" vid="EZK 7:8">अऊ तोर ऊपर मेंह अपन कोरोध परगट करहूं।</para>
  <para style="q1" vid="EZK 7:8">मेंह तोर चालचलन के मुताबिक तोर नियाय करहूं</para>
  <para style="q2" vid="EZK 7:8">अऊ तोर जम्मो घिनौना काममन के फर तोला दूहूं।<verse eid="EZK 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 7:9"/>मेंह तोर ऊपर दया-दिरिस्टी नइं करहूं;</para>
  <para style="q2" vid="EZK 7:9">मेंह तोला नइं छोंड़हूं।</para>
  <para style="q1" vid="EZK 7:9">मेंह तोर चालचलन</para>
  <para style="q2" vid="EZK 7:9">अऊ तुम्हर बीच के घिनौना काममन के फर तोला दूहूं।</para>
  <para style="b" vid="EZK 7:9"/>
  <para style="m" vid="EZK 7:9">“ ‘तब तेंह जान लेबे कि येह में यहोवा अंव, जऊन ह तोला सजा देथे।<verse eid="EZK 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 7:10"/>“ ‘देखव, ओ दिन ला!</para>
  <para style="q2" vid="EZK 7:10">देखव, येह आवत हे!</para>
  <para style="q1" vid="EZK 7:10">बिनास ह फट गे हवय,</para>
  <para style="q2" vid="EZK 7:10">लउठी म पीका निकल गे हवय,</para>
  <para style="q2" vid="EZK 7:10">घमंड के फूल फूले हवय!<verse eid="EZK 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 7:11"/>हिंसा ह ठाढ़ हो गे हवय,</para>
  <para style="q2" vid="EZK 7:11">दुस्ट ला सजा देय बर एक ठन लउठी बन गे हवय।</para>
  <para style="q1" vid="EZK 7:11">मनखेमन ले कोनो भी नइं बचंय,</para>
  <para style="q2" vid="EZK 7:11">ओ भीड़ म के कोनो भी नइं—</para>
  <para style="q1" vid="EZK 7:11">ओमन के कोनो धन-संपत्ति भी नइं,</para>
  <para style="q2" vid="EZK 7:11">अऊ न ही कोनो कीमती सामान।<verse eid="EZK 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 7:12"/>समय ह आ गे हवय!</para>
  <para style="q2" vid="EZK 7:12">ओ दिन ह आ गे हवय!</para>
  <para style="q1" vid="EZK 7:12">बिसोइया ह आनंद झन मनावय</para>
  <para style="q2" vid="EZK 7:12">अऊ न ही बेचइया ह सोक करय,</para>
  <para style="q2" vid="EZK 7:12">काबरकि मोर कोप ह जम्मो भीड़ ऊपर भड़के हवय।<verse eid="EZK 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 7:13"/>बेचइया ला ओ संपत्ति फेर नइं मिलय</para>
  <para style="q2" vid="EZK 7:13">जेला बेचे जा चुके हवय</para>
  <para style="q2" vid="EZK 7:13">जब तक कि बिसोइया अऊ बेचइया दूनों जीयत हें।</para>
  <para style="q1" vid="EZK 7:13">काबरकि जम्मो भीड़ के बारे म ओ दरसन ला</para>
  <para style="q2" vid="EZK 7:13">पलटे नइं जा सकय।</para>
  <para style="q1" vid="EZK 7:13">ओमन के पाप के कारन, ओमा के कोनो भी</para>
  <para style="q2" vid="EZK 7:13">अपन जिनगी ला बचा नइं सकंय।<verse eid="EZK 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 7:14"/>“ ‘ओमन तुरही ला फूंके हवंय,</para>
  <para style="q2" vid="EZK 7:14">ओमन जम्मो चीजमन ला तियार कर ले हवंय,</para>
  <para style="q1" vid="EZK 7:14">पर कोनो भी लड़ई म नइं जावंय,</para>
  <para style="q2" vid="EZK 7:14">काबरकि मोर कोप ह जम्मो भीड़ ऊपर हवय।<verse eid="EZK 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 7:15"/>बाहिर म तलवार हवय;</para>
  <para style="q2" vid="EZK 7:15">अऊ भीतर म महामारी अऊ अकाल।</para>
  <para style="q1" vid="EZK 7:15">जेमन गांव-गंवई म हवंय</para>
  <para style="q2" vid="EZK 7:15">ओमन तलवार ले मरहीं;</para>
  <para style="q1" vid="EZK 7:15">जेमन सहर म हवंय</para>
  <para style="q2" vid="EZK 7:15">ओमन अकाल अऊ महामारी ले मारे जाहीं।<verse eid="EZK 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 7:16"/>ओ भागनेवालामन, जेमन बांच निकलहीं</para>
  <para style="q2" vid="EZK 7:16">ओमन पहाड़मन ऊपर भाग जाहीं।</para>
  <para style="q1" vid="EZK 7:16">हर एक ह अपन खुद के पाप बर,</para>
  <para style="q2" vid="EZK 7:16">घाटीमन के पंड़कीमन सहीं,</para>
  <para style="q2" vid="EZK 7:16">ओमन जम्मो बिलाप करहीं।<verse eid="EZK 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 7:17"/>हर एक के हांथ ह लचक जाही;</para>
  <para style="q2" vid="EZK 7:17">हर एक के गोड़ ह पेसाब ले गीला हो जाही।<verse eid="EZK 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 7:18"/>ओमन बोरा के कपड़ा पहिरहीं</para>
  <para style="q2" vid="EZK 7:18">अऊ आतंक ले भर जाहीं।</para>
  <para style="q1" vid="EZK 7:18">हर एक के मुहूं ह सरम के मारे ढंके रहिही,</para>
  <para style="q2" vid="EZK 7:18">अऊ हर एक के मुड़ के मुंडन करे जाही।<verse eid="EZK 7:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="EZK 7:19"/>“ ‘ओमन अपन चांदी ला गलीमन म फटिक दीहीं,</para>
  <para style="q2" vid="EZK 7:19">अऊ ओमन के सोन ला असुध चीज समझे जाही।</para>
  <para style="q1" vid="EZK 7:19">ओमन के सोन अऊ चांदी ह</para>
  <para style="q2" vid="EZK 7:19">यहोवा के कोप के दिन म</para>
  <para style="q2" vid="EZK 7:19">ओमन ला बचा नइं सकही।</para>
  <para style="q1" vid="EZK 7:19">येह ओमन के भूख ला नइं मिटाही</para>
  <para style="q2" vid="EZK 7:19">या ओमन के पेट ला नइं भरही,</para>
  <para style="q2" vid="EZK 7:19">काबरकि येह ओमन के पाप म गिरे के कारन होय हवय।<verse eid="EZK 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="EZK 7:20"/>ओमन अपन सुघर जेवर ऊपर घमंड करिन</para>
  <para style="q2" vid="EZK 7:20">अऊ येकर उपयोग अपन घिनौना मूरतीमन ला बनाय म करिन।</para>
  <para style="q1" vid="EZK 7:20">ओमन येकर ले नीच मूरतीमन ला बनाईन;</para>
  <para style="q2" vid="EZK 7:20">एकरसेति मेंह येला ओमन बर एक असुध चीज बना दूहूं।<verse eid="EZK 7:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="EZK 7:21"/>मेंह ओमन के धन-संपत्ति ला लूट के सामान के रूप म</para>
  <para style="q2" vid="EZK 7:21">ओ परदेसीमन ला अऊ धरती के ओ दुस्टमन ला दे दूहूं,</para>
  <para style="q2" vid="EZK 7:21">जेमन येला असुध कर दीहीं।<verse eid="EZK 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="EZK 7:22"/>मेंह ओमन ले अपन मुहूं मोड़ लूहूं,</para>
  <para style="q2" vid="EZK 7:22">अऊ लुटेरामन मोर कीमती जगह<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">संभवतः मंदिर</char></note> ला अपबितर करहीं।</para>
  <para style="q1" vid="EZK 7:22">ओमन येकर भीतर घुसहीं</para>
  <para style="q2" vid="EZK 7:22">अऊ येला असुध करहीं।<verse eid="EZK 7:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="EZK 7:23"/>“ ‘बेड़ीमन ला तियार करव!</para>
  <para style="q2" vid="EZK 7:23">काबरकि देस ह खून ले,</para>
  <para style="q2" vid="EZK 7:23">अऊ सहर ह हिंसा ले भर गे हवय।<verse eid="EZK 7:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="EZK 7:24"/>मेंह जाति-जाति के सबले दुस्ट मनखेमन ला</para>
  <para style="q2" vid="EZK 7:24">ओमन के घरमन ऊपर कब्जा करे बर लानहूं।</para>
  <para style="q1" vid="EZK 7:24">मेंह बलवान के घमंड ला टोर दूहूं,</para>
  <para style="q2" vid="EZK 7:24">अऊ ओमन के पबितर-स्थानमन अपबितर करे जाहीं।<verse eid="EZK 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="EZK 7:25"/>जब आतंक आही,</para>
  <para style="q2" vid="EZK 7:25">तब ओमन बेकार म सांति के खोज करहीं।<verse eid="EZK 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="EZK 7:26"/>बिपत्ति के ऊपर बिपत्ति आही,</para>
  <para style="q2" vid="EZK 7:26">अऊ अफवाह के ऊपर अफवाह फईलही।</para>
  <para style="q1" vid="EZK 7:26">ओमन अगमजानी ले दरसन के खोज म निकलहीं,</para>
  <para style="q2" vid="EZK 7:26">कानून म पुरोहिती निरदेस बंद हो जाही,</para>
  <para style="q2" vid="EZK 7:26">अगुवामन के सलाह देवई ह खतम हो जाही।<verse eid="EZK 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="EZK 7:27"/>राजा ह सोक करही,</para>
  <para style="q2" vid="EZK 7:27">अऊ हाकिम ह उदासी के ओनहा पहिरही,</para>
  <para style="q2" vid="EZK 7:27">अऊ देस के मनखेमन के हांथमन कांपहीं।</para>
  <para style="q1" vid="EZK 7:27">मेंह ओमन संग ओमन के चालचलन के मुताबिक बरताव करहूं,</para>
  <para style="q2" vid="EZK 7:27">अऊ ओमन के खुद के हैसियत के मुताबिक ओमन के नियाय करहूं।</para>
  <para style="b" vid="EZK 7:27"/>
  <para style="m" vid="EZK 7:27">“ ‘तब ओमन जान लीहीं कि मेंह यहोवा अंव।’ ”<verse eid="EZK 7:27"/></para>
  <chapter eid="EZK 7"/>
  <chapter number="8" style="c" sid="EZK 8"/>
  <para style="s1">मंदिर म मूरती-पूजा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 8:1"/>हमर बंधुवई के छठवां साल के छठवां महिना के पांचवां दिन म, जब मेंह अपन घर म बईठे रहेंव अऊ यहूदा के अगुवामन मोर आघू म बईठे रिहिन, तब परमपरधान यहोवा के हांथ<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सक्ति</char></note> उहां मोर ऊपर आईस। <verse eid="EZK 8:1"/><verse number="2" style="v" sid="EZK 8:2"/>तब मेंह देखेंव, अऊ मोला आदमी सहीं एक रूप दिखिस।<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">आगी के सहीं एक रूप</char></note> ओकर कनिहां के तरी कोति आगी सहीं रिहिस, अऊ ओकर कनिहां ले ऊपर कोति लाल धातु सहीं चमकत रिहिस। <verse eid="EZK 8:2"/><verse number="3" style="v" sid="EZK 8:3"/>ओह अपन हांथ असन चीज ला बढ़ाके मोर मुड़ के चुंदी ला पकड़िस। तब परमेसर के आतमा ह मोला धरती अऊ अकास के बीच उठा लीस अऊ परमेसर के दरसन म मोला यरूसलेम ले गीस, याने कि भीतरी अंगना के उत्तर कोति के प्रवेस दुवार करा ले गीस, जिहां जलन के भावना ला भड़कानेवाला मूरती ह रिहिस। <verse eid="EZK 8:3"/><verse number="4" style="v" sid="EZK 8:4"/>अऊ उहां मोर आघू म इसरायल के परमेसर के तेज वइसने ही रिहिस, जइसने मेंह मैदान म दरसन म देखे रहेंव।<verse eid="EZK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 8:5"/>तब ओह मोला कहिस, “हे मनखे के बेटा, उत्तर कोति देख।” त मेंह आंखी उठाके देखेंव, अऊ बेदी के उत्तर कोति के प्रवेस दुवार म, मेंह ये जलन उपजइया मूरती ला देखेंव।<verse eid="EZK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 8:6"/>अऊ ओह मोर ले कहिस, “हे मनखे के बेटा, का तेंह देखे कि ओमन का करत हें—इसरायलीमन इहां बहुंत ही घिनौना काम करत हें, अइसन काम, जऊन ह मोला मोर पबितर-स्थान ले दूरिहा ले जाही? पर तें येकर ले घलो जादा घिनौना चीजमन ला देखबे।”<verse eid="EZK 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 8:7"/>तब ओह मोला अंगना के प्रवेस दुवार मेर ले आईस। अऊ मेंह देखेंव कि दीवार म एक छेदा रिहिस। <verse eid="EZK 8:7"/><verse number="8" style="v" sid="EZK 8:8"/>ओह मोर ले कहिस, “हे मनखे के बेटा, दीवार ला फोर।” त मेंह दीवार ला फोरेंव अऊ उहां मोला एक दुवार दिखिस।<verse eid="EZK 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 8:9"/>अऊ ओह मोर ले कहिस, “भीतर जा अऊ देख कि ओमन इहां कइसे दुस्ट अऊ घिनौना काममन ला करत हवंय।” <verse eid="EZK 8:9"/><verse number="10" style="v" sid="EZK 8:10"/>त मेंह भीतर गेंव अऊ देखेंव कि पूरा दीवारमन म जम्मो किसम के रेंगइया जन्तु अऊ असुध पसु अऊ इसरायल के जम्मो मूरतीमन के चित्र बनाय गे हवय। <verse eid="EZK 8:10"/><verse number="11" style="v" sid="EZK 8:11"/>ओमन के आघू म, इसरायल के सत्तर अगुवामन ठाढ़े रहंय, अऊ ओमन के बीच म सापान के बेटा याजनयाह ह ठाढ़े रहय। हर एक मनखे ह अपन हांथ म एक धूपदान धरे रहय, अऊ कहरत धूप के धुआं ह ऊपर उठत रहय।<verse eid="EZK 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 8:12"/>तब ओह मोर ले कहिस, “हे मनखे के बेटा, का तेंह देखे कि इसरायल के अगुवामन अंधियार म, अपन-अपन मूरती के जगह म का करत हवंय? ओमन कहत हें, ‘यहोवा ह हमन ला नइं देखय; यहोवा ह देस ला तियाग दे हवय।’ ” <verse eid="EZK 8:12"/><verse number="13" style="v" sid="EZK 8:13"/>फेर, ओह कहिस, “तें ओमन ला अऊ जादा घिनौना काम करत देखबे।”<verse eid="EZK 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 8:14"/>तब ओह मोला यहोवा के भवन के उत्तर के प्रवेस दुवार मेर ले आईस, अऊ उहां मेंह माईलोगनमन ला बईठे देखेंव अऊ ओमन तम्मूज देवता बर सोक मनात रिहिन। <verse eid="EZK 8:14"/><verse number="15" style="v" sid="EZK 8:15"/>ओह मोर ले कहिस, “हे मनखे के बेटा, का तेंह देखत हस? तेंह येकर ले घलो जादा घिनौना चीजमन ला देखबे।”<verse eid="EZK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 8:16"/>तब ओह मोला यहोवा के भवन के भीतरी अंगना म ले आईस, अऊ उहां मंदिर के प्रवेस दुवार म, मंडप अऊ बेदी के बीच लगभग पच्चीस आदमीमन रहंय। ओमन के पीठ ह यहोवा के मंदिर कोति अऊ ओमन के मुहूं ह पूरब कोति रहय, ओमन पूरब म सूरज ला दंडवत करत रिहिन।<verse eid="EZK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 8:17"/>ओह मोर ले कहिस, “हे मनखे के बेटा, का तेंह येला देखे हस? का यहूदा के मनखेमन बर घिनौना काम करई छोटे बात ए, जेला ओमन इहां करत हवंय? खचित ओमन देस ला हिंसा ले घलो भर देवत हें अऊ मोर कोरोध ला लगातार भड़कावत हें। ओमन ला देख, ओमन डारा ला अपन नाक म डारे हवंय!<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमेसर के बेजत्ती</char></note> <verse eid="EZK 8:17"/><verse number="18" style="v" sid="EZK 8:18"/>ये खातिर मेंह कोरोध करके ओमन के संग बरताव करहूं, मेंह ओमन ऊपर दया-दिरिस्टी नइं करंव या ओमन ला नइं छोड़ंव। चाहे ओमन मोर कान म चिचियावंय, तभो ले मेंह ओमन के बात ला नइं सुनंव।”<verse eid="EZK 8:18"/></para>
  <chapter eid="EZK 8"/>
  <chapter number="9" style="c" sid="EZK 9"/>
  <para style="s1">मूरती-पूजा करइयामन ला सजा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 9:1"/>तब मेंह ओला ऊंचहा अवाज म ये कहत सुनंय, “ओमन ला लकठा म लानव, जेमन ला सहर के मनखेमन के नियाय करे बर ठहिराय गे हवय, ओमन के हर एक के हांथ म एक हथियार रहय।” <verse eid="EZK 9:1"/><verse number="2" style="v" sid="EZK 9:2"/>अऊ मेंह छै आदमी ला ऊपरी दुवार के तरफ ले आवत देखेंव, जऊन ह उत्तर कोति खुलथे, ओमन के हर एक के हांथ म एक घातक हथियार रहय। ओमन के संग मलमल के कपड़ा पहिरे एक आदमी रहय, जऊन ह अपन बगल म लिखे के सामान के एक झोला धरे रहय। ओमन आईन अऊ कांसा के बेदी के बगल म ठाढ़ हो गीन।<verse eid="EZK 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 9:3"/>तब इसरायल के परमेसर के तेज, जऊन ह करूबमन के ऊपर रिहिस, उहां ले ऊपर उठिस, अऊ मंदिर के दुवार मेर आ गीस। तब यहोवा ह ओ मलमल के ओनहा पहिरे आदमी ला बलाईस, जऊन ह अपन बगल म लिखे के सामान के झोला धरे रिहिस <verse eid="EZK 9:3"/><verse number="4" style="v" sid="EZK 9:4"/>अऊ ओला कहिस, “पूरा यरूसलेम सहर म होवत जा अऊ ओ जम्मो झन के माथा म एक चिनहां लगा, जेमन दुखी हवंय अऊ ओ जम्मो घिनौना काम बर बिलाप करत हें, जेमन ला यरूसलेम म करे जावत हे।”<verse eid="EZK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 9:5"/>जइसे कि मेंह सुनेंव, ओह आने मन ला कहिस, “पूरा सहर म ओकर पाछू-पाछू जावव, अऊ बिगर दया या सहानुभूति देखाय मनखेमन ला मारत जावव। <verse eid="EZK 9:5"/><verse number="6" style="v" sid="EZK 9:6"/>डोकरा, जवान अऊ जवान छोकरी, दाई अऊ लइकामन ला मार डालव, पर अइसन मनखे ला झन छुवव, जेकर माथा म चिनहां हवय। मोर पबितर-स्थान ले सुरू करव।” तब ओमन ओ डोकरा मनखेमन ले सुरू करिन, जेमन मंदिर के आघू म रिहिन।<verse eid="EZK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 9:7"/>तब ओह ओमन ले कहिस, “मंदिर ला असुध कर दव अऊ अंगनामन ला लासमन ले भर दव। जावव!” तब ओमन निकलके पूरा सहर म मनखेमन ला मारे के सुरू करिन। <verse eid="EZK 9:7"/><verse number="8" style="v" sid="EZK 9:8"/>जब ओमन मारत रिहिन अऊ मेंह अकेला रह गेंव, तब मेंह मुहूं के बल गिरेंव, अऊ चिचियाके कहेंव, “हाय, हे परमपरधान यहोवा! का तें यरूसलेम ऊपर अपन भयंकर कोप के कारन इसरायल के जम्मो बांचे मनखे ला नास कर देबे?”<verse eid="EZK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 9:9"/>तब ओह मोला जबाब दीस, “इसरायल अऊ यहूदा के मनखेमन के पाप बहुंत ही जादा हे; देस ह खून बहाय ले अऊ सहर ह अनियाय ले भर गे हवय। ओमन कहिथें, ‘यहोवा ह देस ला तियाग दे हवय; यहोवा ह नइं देखय।’ <verse eid="EZK 9:9"/><verse number="10" style="v" sid="EZK 9:10"/>ये खातिर में ओमन ऊपर दया-दिरिस्टी नइं करंव या ओमन ला नइं छोड़ंव, पर मेंह ओमन के काम ला ओहीचमन के मुड़ ऊपर डाल दूहूं।”<verse eid="EZK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 9:11"/>तब ओ आदमी, जऊन ह मलमल के ओनहा पहिरे रिहिस अऊ अपन बगल म लिखे के सामान धरे के पेटी रखे रिहिस, वापिस आके ये समाचार दीस, “जइसने तेंह हुकूम देय रहय, मेंह वइसने ही करे हवंव।”<verse eid="EZK 9:11"/></para>
  <chapter eid="EZK 9"/>
  <chapter number="10" style="c" sid="EZK 10"/>
  <para style="s1">परमेसर के तेज ह मंदिर ले चले जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 10:1"/>एकर बाद, मेंह देखेंव कि करूबमन के मुड़ी ऊपर जऊन अकास-मंडल हवय, ओकर ऊपर नीलमनि के सिंघासन असन कुछू दिखत रिहिस। <verse eid="EZK 10:1"/><verse number="2" style="v" sid="EZK 10:2"/>तब यहोवा ह मलमल के ओनहा पहिरे ओ मनखे ला कहिस, “करूबमन के खाल्हे चक्कामन के बीच म जा अऊ अपन दूनों हथेली ला करूबमन के बीच बरत कोइला ले भर ले अऊ ओला सहर के ऊपर बगरा दे।” अऊ ओह मोर देखत म भीतर चल दीस।<verse eid="EZK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 10:3"/>जब ओ आदमी ह भीतर गीस, तब करूबमन मंदिर के दक्खिन कोति ठाढ़े रिहिन, अऊ भीतरी अंगना ह एक बादर ले भर गे रिहिस। <verse eid="EZK 10:3"/><verse number="4" style="v" sid="EZK 10:4"/>तब यहोवा के तेज ह करूबमन के ऊपर ले उठिस अऊ मंदिर के दुवार मेर आ गीस। मंदिर ह बादर ले भर गीस, अऊ ओ अंगना ह यहोवा के तेज के चमक ले पूरा भर गीस। <verse eid="EZK 10:4"/><verse number="5" style="v" sid="EZK 10:5"/>करूबमन के डेनामन के अवाज ह बाहिर के अंगना तक सुनाई देवत रिहिस, अऊ येह सर्वसक्तिमान परमेसर के गोठियाय असन अवाज रिहिस।<verse eid="EZK 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 10:6"/>जब यहोवा ह मलमल के ओनहा पहिरे आदमी ला हुकूम दीस, “चक्कामन के बीच ले, करूबमन के बीच म ले आगी ला ले,” त ओ आदमी ह भीतर गीस अऊ एक चक्का के बाजू म ठाढ़ हो गीस। <verse eid="EZK 10:6"/><verse number="7" style="v" sid="EZK 10:7"/>तब करूबमन के बीच म ले एक करूब ह अपन बीच के आगी कोति अपन हांथ ला लमाईस अऊ ओमा ले कुछू आगी ला लेके मलमल के ओनहा पहिरे ओ आदमी के हांथ म रख दीस, अऊ ओ आदमी ह ओला धरके बाहिर चल दीस। <verse eid="EZK 10:7"/><verse number="8" style="v" sid="EZK 10:8"/>(करूबमन के डेनामन के खाल्हे म मनखे के हांथमन असन कुछू दिखत रिहिस।)<verse eid="EZK 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 10:9"/>तब मेंह करूबमन के बाजू म चार ठन चक्का देखेंव, याने कि हर करूब के बाजू म एक चक्का; ओ चक्कामन पुखराज के सहीं चमकत रिहिन। <verse eid="EZK 10:9"/><verse number="10" style="v" sid="EZK 10:10"/>जहां तक ओमन के बनावट के बात ए, ओ चारों चक्का के बनावट ह एके सहीं रिहिस, मानो हर चक्का ह आने चक्का म हमाय रिहिस। <verse eid="EZK 10:10"/><verse number="11" style="v" sid="EZK 10:11"/>जब ओमन चलंय, त ओमन चारों दिग म ले ओ दिग कोति चलंय, जऊन कोति करूबमन के मुहूं रहय; चक्कामन एती-ओती नइं मुड़ंय, जब करूबमन चलंय। करूबमन बिगर एती-ओती मुड़े ओ दिग म जावंय, जऊन कोति ओमन के मुहूं रहय। <verse eid="EZK 10:11"/><verse number="12" style="v" sid="EZK 10:12"/>ओमन के पीठ, ओमन के हांथ अऊ ओमन के डेनामन समेत ओमन के जम्मो देहें ह पूरा आंखीमन ले भरे रिहिस, अऊ वइसने ही ओमन के चारों चक्का म आंखी ही आंखी रिहिस। <verse eid="EZK 10:12"/><verse number="13" style="v" sid="EZK 10:13"/>मेंह सुनेंव, ओ चक्कामन ला “तेजी से घुमइया चक्का” कहे गीस। <verse eid="EZK 10:13"/><verse number="14" style="v" sid="EZK 10:14"/>हर एक करूब के चार-चार मुहूं रिहिस: एक मुहूं करूब असन, दूसर मुहूं मनखे असन, तीसर मुहूं सिंह असन, अऊ चौथा मुहूं गिधवा असन।<verse eid="EZK 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 10:15"/>तब करूबमन भुइयां म ले ऊपर उठिन। येमन ओही जीवधारी अंय, जेमन ला मेंह कबार नदी के तीर म देखे रहेंव। <verse eid="EZK 10:15"/><verse number="16" style="v" sid="EZK 10:16"/>जब करूबमन चलंय, तब ओमन के बाजू के चक्कामन घलो चलंय; अऊ जब करूबमन भुइयां ले उठे बर अपन डेनामन ला फईलावंय, तब चक्कामन ओमन के बाजू ला नइं छोंड़ंय। <verse eid="EZK 10:16"/><verse number="17" style="v" sid="EZK 10:17"/>जब करूबमन ठाढ़ हो जावंय, तब चक्कामन घलो ठाढ़ हो जावंय; अऊ जब करूबमन उठंय, तब चक्कामन घलो ओमन के संग उठंय, काबरकि जीवधारीमन के आतमा ह ओमन म रिहिस।<verse eid="EZK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 10:18"/>तब यहोवा के तेज ह मंदिर के दुवार के ऊपर ले चल दीस अऊ करूबमन के ऊपर आके ठहर गीस। <verse eid="EZK 10:18"/><verse number="19" style="v" sid="EZK 10:19"/>जब मेंह देखत रहेंव, त करूबमन अपन डेनामन ला फईलाके भुइयां ले ऊपर उठिन, अऊ जब ओमन जावत रिहिन, त चक्कामन घलो ओमन के संगे-संग गीन। ओमन जाके यहोवा के भवन के पूरबी दुवार के कपाट मेर रूक गीन, अऊ इसरायल के परमेसर के तेज ह ओमन के ऊपर रिहिस।<verse eid="EZK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 10:20"/>येमन ओ जीवधारी रिहिन, जेमन ला मेंह कबार नदी के तीर इसरायल के परमेसर के खाल्हे म देखे रहेंव, अऊ मेंह जान गेंव कि ओमन करूब रिहिन। <verse eid="EZK 10:20"/><verse number="21" style="v" sid="EZK 10:21"/>हर एक के चार मुहूं अऊ चार ठन डेना रिहिस, अऊ ओमन के डेनामन के खाल्हे म मनखे के हांथमन असन कुछू दिखत रहंय। <verse eid="EZK 10:21"/><verse number="22" style="v" sid="EZK 10:22"/>ओमन के चेहरा ह ओ जीवधारीमन असन ही रिहिस, जेमन ला मेंह कबार नदी के तीर म देखे रहेंव। हर एक ह आघू सीधा ही चलत रिहिस।<verse eid="EZK 10:22"/></para>
  <chapter eid="EZK 10"/>
  <chapter number="11" style="c" sid="EZK 11"/>
  <para style="s1">यरूसलेम ऊपर परमेसर के ठहिराय निस्चित दंड</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 11:1"/>तब परमेसर के आतमा ह मोला उठाके यहोवा के भवन के ओ दुवार मेर ले आईस, जेकर मुहूं पूरब कोति हवय। उहां दुवार के कपाट मेर पच्चीस आदमी रिहिन, अऊ मेंह ओमन के बीच अज्जूर के बेटा याजनयाह अऊ बनायाह के बेटा पलतयाह ला देखेंव, जेमन मनखेमन के अगुवा रिहिन। <verse eid="EZK 11:1"/><verse number="2" style="v" sid="EZK 11:2"/>यहोवा ह मोर ले कहिस, “हे मनखे के बेटा, येमन ओ आदमीमन अंय, जेमन खराप साजिस रचत हें अऊ ये सहर म खराप सलाह देवत हें। <verse eid="EZK 11:2"/><verse number="3" style="v" sid="EZK 11:3"/>ओमन कहिथें, ‘का हमर घरमन ला अभी हालेच म नइं बनाय गे हवय? ये सहर ह एक बरतन, अऊ हमन ओमा रखे मांस अन।’ <verse eid="EZK 11:3"/><verse number="4" style="v" sid="EZK 11:4"/>ये खातिर, हे मनखे के बेटा, ओमन के बिरूध म अगमबानी कर; अगमबानी कर।”<verse eid="EZK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 11:5"/>तब यहोवा के आतमा मोर ऊपर आईस, अऊ ओह मोला ये कहे बर कहिस: “यहोवा ह ये कहत हे: हे इसरायल के अगुवामन, तुमन येहीच कहत हव, पर तुम्हर मन म का चलत हे, ओला में जानत हंव। <verse eid="EZK 11:5"/><verse number="6" style="v" sid="EZK 11:6"/>तुमन ये सहर म बहुंते झन ला मार डारे हव अऊ येकर गलीमन ला लासमन ले भर दे हव।<verse eid="EZK 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 11:7"/>“एकरसेति परमपरधान यहोवा ह ये कहत हे: जऊन देहेंमन ला तुमन उहां फेंक दे हव, ओमन मांस अंय अऊ ये सहर ह बरतन, पर मेंह तुमन ला इहां ले भगा दूहूं। <verse eid="EZK 11:7"/><verse number="8" style="v" sid="EZK 11:8"/>तुमन तलवार ले डरथव, अऊ मेंह तलवार के उपयोग तुम्हर बिरूध करहूं, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 11:8"/><verse number="9" style="v" sid="EZK 11:9"/>मेंह तुमन ला सहर ले भगा दूहूं अऊ तुमन ला परदेसीमन के हांथ म दे दूहूं अऊ तुमन ला सजा दूहूं। <verse eid="EZK 11:9"/><verse number="10" style="v" sid="EZK 11:10"/>तुमन तलवार ले मारे जाहू, अऊ मेंह इसरायल के सीमनामन म तुमन ला दंड दूहूं। तब तुमन जानहू कि मेंह यहोवा अंव। <verse eid="EZK 11:10"/><verse number="11" style="v" sid="EZK 11:11"/>ये सहर ह तुम्हर बर एक बरतन नइं होही, अऊ न ही तुमन येमा के मांस होहू; मेंह इसरायल के सीमनामन म तुमन ला दंड दूहूं। <verse eid="EZK 11:11"/><verse number="12" style="v" sid="EZK 11:12"/>अऊ तुमन जानहू कि मेंह यहोवा अंव, काबरकि तुमन मोर बिधिमन म नइं चले हव या मोर कानूनमन ला नइं माने हव पर अपन चारों कोति के जातिमन के रीतिमन म चले हव।”<verse eid="EZK 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 11:13"/>जब मेंह अगमबानी करत रहेंव कि बनायाह के बेटा पलतयाह ह मर गीस। तब मेंह मुहूं के बल गिरेंव अऊ ऊंचहा अवाज म चिचियाके कहेंव, “हाय, हे परमपरधान यहोवा! का तें इसरायल के बांचे मनखेमन ला पूरा नास कर देबे?”<verse eid="EZK 11:13"/></para>
  <para style="s1">इसरायल के बंधुवई ले लहुंटे के वायदा</para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 11:14"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 11:14"/><verse number="15" style="v" sid="EZK 11:15"/>“हे मनखे के बेटा, यरूसलेम के मनखेमन, तोर संगी बंधुवा मनखे अऊ आने जम्मो इसरायलीमन के बारे म कहे हवंय, ‘ओमन यहोवा ले बहुंत दूरिहा हवंय; ये देस ह हमन ला हमर अधिकार म देय गे रिहिस।’<verse eid="EZK 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 11:16"/>“एकरसेति ये कह, ‘परमपरधान यहोवा ह ये कहत हे: हालाकि मेंह ओमन ला बहुंत दूरिहा जाति-जाति के मनखेमन के बीच भेज देंव अऊ ओमन ला देस-देस म तितिर-बितिर कर देंव, तभो ले जऊन भी देस म ओमन गीन, ओ देसमन म, थोरकन समय बर मेंह ओमन बर एक पबितर-स्थान ठहिरे हंव।’<verse eid="EZK 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 11:17"/>“एकरसेति ओमन ले कह: ‘परमपरधान यहोवा ह ये कहत हे: मेंह तुमन ला ओ जाति-जाति के मनखेमन के बीच म ले संकेलहूं अऊ जऊन देसमन म तुमन तितिर-बितिर करे गे हवव, उहां ले मेंह तुमन ला वापिस लानहूं, अऊ मेंह फेर तुमन ला इसरायल देस वापिस दे दूहूं।’<verse eid="EZK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 11:18"/>“ओमन उहां लहुंट आहीं अऊ येकर जम्मो असुध अऊ घिनौना मूरतीमन ला हटा दीहीं। <verse eid="EZK 11:18"/><verse number="19" style="v" sid="EZK 11:19"/>मेंह ओमन के मन ला एक कर दूहूं अऊ ओमन म एक नवां आतमा डालहूं; मेंह ओमन ले ओमन के पथरा सहीं हिरदय ला निकाल दूहूं अऊ ओमन ला मांस के एक हिरदय दूहूं। <verse eid="EZK 11:19"/><verse number="20" style="v" sid="EZK 11:20"/>तब ओमन मोर बिधिमन ला मानहीं अऊ धियान देके मोर कानूनमन म चलहीं। ओमन मोर मनखे होहीं, अऊ मेंह ओमन के परमेसर ठहिरहूं। <verse eid="EZK 11:20"/><verse number="21" style="v" sid="EZK 11:21"/>पर ओ मनखे, जेमन के मन ह ओमन के असुध अऊ घिनौना मूरतीमन म लगे हवय, मेंह ओमन के काम ला ओहीचमन के मुड़ म ले आहूं, परमपरधान यहोवा ह घोसना करत हे।”<verse eid="EZK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 11:22"/>तब करूबमन अपन डेना ला फईलाईन, अऊ चक्कामन ओमन के बाजू म रहंय, अऊ इसरायल के परमेसर के तेज ओमन ऊपर रिहिस। <verse eid="EZK 11:22"/><verse number="23" style="v" sid="EZK 11:23"/>तब यहोवा के तेज सहर के भीतर ले ऊपर उठिस अऊ सहर के पूरब कोति के पहाड़ ऊपर जाके ठहर गीस। <verse eid="EZK 11:23"/><verse number="24" style="v" sid="EZK 11:24"/>फेर परमेसर के आतमा ह मोला ऊपर उठाईस अऊ परमेसर के आतमा के दुवारा दिये गय दरसन म मोला बेबिलोनिया देस<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन के देस</char></note> म बंधुवामन करा ले आईस।</para>
  <para style="p" vid="EZK 11:24">तब ओ दरसन जेला मेंह देखे रहेंव, ओह गायब हो गीस, <verse eid="EZK 11:24"/><verse number="25" style="v" sid="EZK 11:25"/>अऊ हर ओ बात, जेला यहोवा ह मोला देखाय रिहिस, ओ जम्मो ला मेंह बंधुवामन ला बता देंव।<verse eid="EZK 11:25"/></para>
  <chapter eid="EZK 11"/>
  <chapter number="12" style="c" sid="EZK 12"/>
  <para style="s1">बंधुवई म जाय के चिनहां</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 12:1"/>यहोवा के बचन फेर मोर मेर आईस: <verse eid="EZK 12:1"/><verse number="2" style="v" sid="EZK 12:2"/>“हे मनखे के बेटा, तें एक बिदरोही मनखेमन के बीच म रहत हस। ओमन करा देखे बर आंखी तो हवय पर नइं देखंय अऊ सुने बर कान तो हवय पर नइं सुनंय, काबरकि ओमन बिदरोही मनखे अंय।<verse eid="EZK 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 12:3"/>“एकरसेति, हे मनखे के बेटा, बंधुवई म जाय बर अपन सामान ला तियार कर अऊ दिन के बेरा, ओमन के देखत म चले जा अऊ जिहां तें हस, उहां ले आने जगह चले जा। हालाकि ओमन बिदरोही मनखे अंय, तभो ले, सायद ओमन समझ जांय। <verse eid="EZK 12:3"/><verse number="4" style="v" sid="EZK 12:4"/>दिन के बेरा, ओमन के देखत म, बंधुवई बर तियार अपन सामान ला बाहिर ले आ। तब संझा के बेरा, जब ओमन देखत होहीं, तब तें अइसन बाहिर जाबे, जइसन मनखेमन बंधुवई म जाथें। <verse eid="EZK 12:4"/><verse number="5" style="v" sid="EZK 12:5"/>जब ओमन देखत होहीं, तभे दीवार ला फोरबे अऊ ओही म ले अपन सामान ला बाहिर ले जाबे। <verse eid="EZK 12:5"/><verse number="6" style="v" sid="EZK 12:6"/>ओमन के देखत म ही सामान ला अपन खांध म रखबे अऊ बेर बुड़े के बेरा ओमन ला उठाके बाहिर ले जाबे। अपन चेहरा ला ढांप लेबे ताकि तें भुइयां ला झन देख सकस, काबरकि मेंह तोला इसरायलीमन बर एक चिनहां ठहिराय हंव।”<verse eid="EZK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 12:7"/>त मेंह वइसने करेंव, जइसने मोला हुकूम देय गे रिहिस। दिन के समय, बंधुवई बर तियार अपन सामान ला मेंह बाहिर ले आंय। तब संझा के बेरा, मेंह अपन हांथ ले दीवार ला फोरेंव। सूरज डुबे के बेरा, में अपन सामान ला बाहिर ले गेंव, अऊ ओला ओमन के देखत म अपन कंधा म उठांय अऊ चले गेंव।<verse eid="EZK 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 12:8"/>बिहनियां यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 12:8"/><verse number="9" style="v" sid="EZK 12:9"/>“हे मनखे के बेटा, ओ इसरायली, बिदरोही मनखेमन का तोर ले नइं पुछिन, ‘तें का करत हस?’<verse eid="EZK 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 12:10"/>“ओमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: ये अगमबानी यरूसलेम के हाकिम अऊ उहां के जम्मो इसरायलीमन के बारे म अय।’ <verse eid="EZK 12:10"/><verse number="11" style="v" sid="EZK 12:11"/>ओमन ले कह, ‘मेंह तुम्हर बर एक चिनहां अंव।’</para>
  <para style="p" vid="EZK 12:11">“जइसने मेंह करे हवंव, वइसने ही इसरायली मनखेमन संग करे जाही। ओमन बंदी होके बंधुवई म चले जाहीं।<verse eid="EZK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 12:12"/>“ओमन के बीच जऊन हाकिम हवय, ओह सांझ के बेरा अपन सामान ला अपन कंधा म उठाके चले जाही, अऊ दीवार म एक बड़े छेदा करे जाही, ताकि ओह ओमा ले निकलके जा सकय। ओह अपन मुहूं ला ढांप लीही, ताकि ओला भुइयां झन दिखय। <verse eid="EZK 12:12"/><verse number="13" style="v" sid="EZK 12:13"/>मेंह ओकर बर अपन जाल फईलाहूं, अऊ ओह मोर फांदा म फंसही; मेंह ओला बेबिलोनिया, कसदीमन के देस म ले आहूं, पर ओह ओला नइं देखही, अऊ उहां ओह मर जाही। <verse eid="EZK 12:13"/><verse number="14" style="v" sid="EZK 12:14"/>मेंह ओकर आसपास के जम्मो मनखेमन ला तितिर-बितिर कर दूहूं—ओकर करमचारी अऊ ओकर जम्मो सेना ला—अऊ तलवार खींचके मेंह ओमन के पीछा करहूं।<verse eid="EZK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 12:15"/>“जब मेंह ओमन ला जाति-जाति अऊ देस-देस के बीच तितिर-बितिर कर दूहूं, तब ओमन जानहीं कि मेंह यहोवा अंव। <verse eid="EZK 12:15"/><verse number="16" style="v" sid="EZK 12:16"/>पर मेंह ओमन ले कुछू झन ला तलवार के मार, अकाल अऊ महामारी ले बचाके रखहूं, ताकि ओ जाति-जाति के बीच, जिहां ओमन जावंय, उहां ओमन अपन जम्मो घिनौना काममन ला मान लेवंय। तब ओमन जानहीं कि मेंह यहोवा अंव।”<verse eid="EZK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 12:17"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 12:17"/><verse number="18" style="v" sid="EZK 12:18"/>“हे मनखे के बेटा, तें कांपत-कांपत अपन जेवन करबे, अऊ भय म कांपत अपन पानी ला पीबे। <verse eid="EZK 12:18"/><verse number="19" style="v" sid="EZK 12:19"/>देस के मनखेमन ले ये कह: ‘परमपरधान यहोवा ह यरूसलेम अऊ इसरायल देस म रहइया मनखेमन के बारे म ये कहत हे: ओमन चिंतित होके अपन जेवन करहीं, अऊ निरास होके अपन पानी पीहीं, काबरकि देस म रहइया जम्मो मनखेमन के हिंसा के कारन, ओमन के देस के जम्मो चीज ले लिये जाही। <verse eid="EZK 12:19"/><verse number="20" style="v" sid="EZK 12:20"/>बसे हुए नगरमन उजड़ जाहीं अऊ देस ह घलो उजाड़ हो जाही। तब तुमन जानहू कि मेंह यहोवा अंव।’ ”<verse eid="EZK 12:20"/></para>
  <para style="s1">देरी नइं होवय</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 12:21"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 12:21"/><verse number="22" style="v" sid="EZK 12:22"/>“हे मनखे के बेटा, इसरायल देस म ये का कहावत कहे जाथे: ‘दिनमन बीतत जावत हें अऊ कोनो भी दरसन पूरा नइं होवत हे’? <verse eid="EZK 12:22"/><verse number="23" style="v" sid="EZK 12:23"/>ये खातिर ओमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: मेंह ये कहावत ला खतम करइया हंव, अऊ ओमन फेर कभू इसरायल म ये कहावत के उपयोग नइं करहीं।’ ओमन ले कह, ‘ओ दिनमन लकठा म हवंय, जब हर एक दरसन ह पूरा होही। <verse eid="EZK 12:23"/><verse number="24" style="v" sid="EZK 12:24"/>काबरकि तब इसरायल के मनखेमन के बीच कोनो झूठा दरसन या चापलूसी ले भरे सकुन-बिचार नइं होही। <verse eid="EZK 12:24"/><verse number="25" style="v" sid="EZK 12:25"/>पर जऊन भी बात बोलहूं, में यहोवा ही बोलहूं, अऊ ओ बात ह बिगर देरी के पूरा होही। काबरकि हे बिदरोही मनखेमन, तुम्हर ही दिनमन म, मेंह ओ बातमन ला पूरा करहूं, जेला मेंह कहत हंव, परमपरधान यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 12:26"/>फेर यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 12:26"/><verse number="27" style="v" sid="EZK 12:27"/>“हे मनखे के बेटा, इसरायलीमन कहत हें, ‘जऊन दरसन ओह देखत हे, ओह बहुंत साल के बाद पूरा होही, अऊ जऊन अगमबानी ओह करत हे, ओह भविस्य म बहुंत समय बाद के बातमन ला करत हे।’<verse eid="EZK 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 12:28"/>“ये खातिर तें ओमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: मोर कोनो भी बचन के पूरा होय म अऊ देरी नइं होवय; जऊन कुछू मेंह कहत हंव, ओह पूरा होही, परमपरधान यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 12:28"/></para>
  <chapter eid="EZK 12"/>
  <chapter number="13" style="c" sid="EZK 13"/>
  <para style="s1">लबरा अगमजानीमन ला सजा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 13:1"/>यहोवा के ये बचन मोर मेर आईस, <verse eid="EZK 13:1"/><verse number="2" style="v" sid="EZK 13:2"/>“हे मनखे के बेटा, इसरायल के जऊन अगमजानीमन अभी अगमबानी करत हें। ओमन के बिरूध अगमबानी कर। ओमन ला कह, जेमन अपन मन के बिचार ले अगमबानी करथें: ‘यहोवा के बचन ला सुनव! <verse eid="EZK 13:2"/><verse number="3" style="v" sid="EZK 13:3"/>परमपरधान यहोवा ह ये कहत हे: हाय, ओ मुरूख<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">दुस्ट</char></note> अगमजानीमन ऊपर, जेमन अपन ही मन के मुताबिक चलथें, अऊ ओमन कुछू दरसन नइं देखे रहंय! <verse eid="EZK 13:3"/><verse number="4" style="v" sid="EZK 13:4"/>हे इसरायल, तोर अगमजानीमन खंडहरमन म सियार सहीं अंय। <verse eid="EZK 13:4"/><verse number="5" style="v" sid="EZK 13:5"/>तुमन इसरायल के मनखेमन बर दीवार के फटानमन ला सुधारे बर ऊपर नइं चघे हव, ताकि यहोवा के दिन लड़ई म येह मजबूत बने रहय। <verse eid="EZK 13:5"/><verse number="6" style="v" sid="EZK 13:6"/>ओमन के दरसन अऊ अगम के बात एक लबारी बात ए। हालाकि यहोवा ह ओमन ला नइं पठोय हे, तभो ले ओमन कहिथें, “यहोवा ह घोसना करत हे,” अऊ आसा करथें कि यहोवा ह ओमन के अगमबानी ला पूरा करही। <verse eid="EZK 13:6"/><verse number="7" style="v" sid="EZK 13:7"/>का तुमन झूठा दरसन नइं देखेव अऊ लबारी सकुन-बिचार के बात नइं कहे हव, जब तुमन ये कहिथव, “यहोवा ह घोसना करत हे,” हालाकि मेंह नइं कहे हंव?<verse eid="EZK 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 13:8"/>“ ‘ये खातिर परमपरधान यहोवा ह ये कहत हे: तुम्हर लबारी बात अऊ झूठा दरसन के कारन, मेंह तुम्हर बिरूध म हंव, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 13:8"/><verse number="9" style="v" sid="EZK 13:9"/>मोर हांथ ह ओ अगमजानीमन के बिरूध होही, जेमन झूठा दरसन देखथें अऊ लबारी सकुन-बिचार करथें। ओमन मोर मनखेमन के सभा के नइं होहीं या इसरायल के सूची म ओमन के नांव नइं लिखे जावय, अऊ न ही ओमन इसरायल देस म जा सकहीं। तब तुमन जानहू कि मेंह परमपरधान यहोवा अंव।<verse eid="EZK 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 13:10"/>“ ‘काबरकि ओमन मोर मनखेमन ला ये कहिके बहकाथें, “सांति हे,” जबकि उहां सांति नइं हे, अऊ ये खातिर कि जब एक कमजोर दीवार बनाय जाथे, त ओमन ओमा पोताई करके ओला ढांप देथें, <verse eid="EZK 13:10"/><verse number="11" style="v" sid="EZK 13:11"/>एकरसेति जेमन पोताई करके येला ढांप देथें, ओमन ले कह कि येह गिर जाही। बहुंत जोर से बरसात होही, अऊ मेंह बड़े-बड़े करा गिराहूं, जेमन दीवार ले टकराहीं, अऊ भारी आंधी चलही। <verse eid="EZK 13:11"/><verse number="12" style="v" sid="EZK 13:12"/>जब दीवार ह गिर जाही, तब का मनखेमन तुमन ले ये नइं पुछहीं, “जऊन पोताई करके तुमन ढांपे रहेव, ओह कहां गीस?”<verse eid="EZK 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 13:13"/>“ ‘ये खातिर परमपरधान यहोवा ह ये कहत हे: मेंह अपन कोप म एक भारी आंधी चलाहूं, अऊ अपन कोरोध म भयंकर बिनास के संग बड़े-बड़े करा गिराहूं अऊ भारी बारिस भेजहूं। <verse eid="EZK 13:13"/><verse number="14" style="v" sid="EZK 13:14"/>मेंह ओ दीवार ला टोरके गिरा दूहूं, जेला तुमन पोताई करके ढांप दे हवव अऊ मेंह ओला माटी म मिला दूहूं ताकि येकर नीव ह खाली पड़े रहय। जब ओह<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सहर</char></note> गिरही, त तुमन ओकर खाल्हे दबके नास हो जाहू; अऊ तुमन जानहू कि मेंह यहोवा अंव। <verse eid="EZK 13:14"/><verse number="15" style="v" sid="EZK 13:15"/>ये किसम ले मोर कोप ह ओ दीवार ऊपर अऊ ओ मनखेमन ऊपर भड़कही, जेमन ओकर ऊपर पोताई करे रिहिन। फेर मेंह तुमन ले कहिहूं, “दीवार ह नास हो गीस, अऊ ओमन घलो नास हो गीन, जेमन येमा पोताई करे रिहिन, <verse eid="EZK 13:15"/><verse number="16" style="v" sid="EZK 13:16"/>इसरायल के ओ अगमजानीमन, जेमन यरूसलेम के बारे म अगमबानी करंय अऊ ओकर सांति के दरसन देखंय, जबकि उहां कोनो सांति नइं रिहिस, परमपरधान यहोवा ह घोसना करत हे।” ’<verse eid="EZK 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 13:17"/>“हे मनखे के बेटा, अब, तें अपन मुहूं अपन मनखेमन के ओ बेटीमन के बिरूध खोल, जेमन अपन ही मन ले अगमबानी करथें। ओमन के बिरूध अगमबानी कर <verse eid="EZK 13:17"/><verse number="18" style="v" sid="EZK 13:18"/>अऊ कह, ‘परमपरधान यहोवा ह ये कहत हे: हाय, ओ माईलोगनमन ला, जेमन अपन कलईमन म जादू के ताबीज बांधथें अऊ मनखेमन ला फंसाय बर अपन मुड़ी बर अलग-अलग लम्बई के घूंघट बनाथें। का तुमन मोर मनखेमन के परान ला खतरा म डालहू पर अपन खुद के परान ला बचाय रखहू? <verse eid="EZK 13:18"/><verse number="19" style="v" sid="EZK 13:19"/>तुमन थोरकन मुट्ठी भर जौ अऊ रोटी के कुटामन बर मोर मनखेमन के बीच मोला अपबितर करे हव। मोर ओ मनखे, जेमन लबारी बात सुनथें, ओमन ले लबारी बात करके तुमन ओमन ला मार डारे हव, जेमन ला जिंदा रहना रिहिस अऊ तुमन ओमन ला छोंड़ देव, जेमन ला जिंदा नइं रहना रिहिस।<verse eid="EZK 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 13:20"/>“ ‘ये खातिर परमपरधान यहोवा ह ये कहत हे: मेंह तुम्हर ओ जादू के ताबीजमन के बिरूध हवंव, जेकर ले तुमन मनखेमन ला चिरई सहीं फंसाथव; मेंह तुम्हर बाहांमन के ओ ताबीजमन ला टोर दूहूं; मेंह ओ मनखेमन ला छोंड़ दूहूं, जेमन ला तुमन चिरई सहीं फंसाथव। <verse eid="EZK 13:20"/><verse number="21" style="v" sid="EZK 13:21"/>मेंह तुम्हर घूंघट ला चीर दूहूं अऊ अपन मनखेमन ला तुम्हर हांथ ले बचाहूं, अऊ ओमन फेर कभू तुम्हर बस म नइं होहीं। तब तुमन जानहू कि मेंह यहोवा अंव। <verse eid="EZK 13:21"/><verse number="22" style="v" sid="EZK 13:22"/>काबरकि तुमन अपन लबारी बात ले धरमी जन ला निरास करे हवव, जबकि मेंह ओमन ऊपर कोनो दुख नइं लाने रहेंव, अऊ काबरकि तुमन दुस्ट मनखे ला ओमन के दुस्ट काम नइं छोंड़े बर उत्साहित करे हव, अऊ अइसने करके ओमन के परान बचाय हव, <verse eid="EZK 13:22"/><verse number="23" style="v" sid="EZK 13:23"/>ये खातिर अब तुमन न तो फेर झूठा दरसन देखहू, अऊ न ही लबारी सकुन-बिचार कर सकहू। मेंह अपन मनखेमन ला तुम्हर हांथ ले बचाहूं। अऊ तब तुमन जानहू कि मेंह यहोवा अंव।’ ”<verse eid="EZK 13:23"/></para>
  <chapter eid="EZK 13"/>
  <chapter number="14" style="c" sid="EZK 14"/>
  <para style="s1">मूरती-पूजा करइयामन ला दंड</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 14:1"/>इसरायल के कुछू अगुवामन मोर मेर आके मोर आघू म बईठ गीन। <verse eid="EZK 14:1"/><verse number="2" style="v" sid="EZK 14:2"/>तब यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 14:2"/><verse number="3" style="v" sid="EZK 14:3"/>“हे मनखे के बेटा, ये मनखेमन अपन हिरदय म मूरतीमन ला बसाय हवंय अऊ अपन चेहरा के आघू म अधरम के ठोकर के चीजमन ला रखे हवंय। त का में ओमन ला मोर ले कुछू जानकारी लेवन दंव? <verse eid="EZK 14:3"/><verse number="4" style="v" sid="EZK 14:4"/>एकरसेति तें ओमन ले बात कर अऊ ओमन ला बता, ‘परमपरधान यहोवा ह ये कहत हे: जब कोनो इसरायली अपन हिरदय म मूरतीमन ला बसाय रखथे अऊ अपन चेहरा के आघू म अधरम के ठोकर के चीजमन ला रखथे अऊ तब ओह कोनो अगमजानी मेर जाथे, त में यहोवा ह ओकर बड़े मूरती-पूजा के बात ला धियान म रखत ओला जबाब दूहूं। <verse eid="EZK 14:4"/><verse number="5" style="v" sid="EZK 14:5"/>मेंह अइसे करहूं ताकि में इसरायल के ओ मनखेमन के हिरदय ला फेर अपन कोति कर सकंव, जेमन अपन मूरतीमन बर मोला तियाग दे हवंय।’<verse eid="EZK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 14:6"/>“एकरसेति इसरायल के मनखेमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: पछताप करव! अपन मूरतीमन ले दूरिहा हो जावव अऊ अपन जम्मो घिनौना काममन ला तियाग देवव!<verse eid="EZK 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 14:7"/>“ ‘जब इसरायलीमन के कोनो मनखे या इसरायल म रहइया कोनो परदेसी अपनआप ला मोर ले अलग कर लेथे अऊ अपन हिरदय म मूरतीमन ला बसा लेथे अऊ अपन चेहरा के आघू म अधरम के ठोकर के चीज ला रखथे अऊ तब ओह मोर ले जानकारी लेय बर कोनो अगमजानी मेर जाथे, त में यहोवा खुद ओला जबाब दूहूं। <verse eid="EZK 14:7"/><verse number="8" style="v" sid="EZK 14:8"/>में ओ मनखे के बिरूध अपन मुहूं कर लूहूं अऊ ओला आने मन बर एक चेतउनी अऊ एक कहावत बना दूहूं। मेंह ओला अपन मनखेमन के बीच ले हटा दूहूं। तब तुमन जानहू कि मेंह यहोवा अंव।<verse eid="EZK 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 14:9"/>“ ‘यदि अगमजानी ह अगमबानी करे बर बहकाय जाथे, त ये जानव कि में यहोवा ह ओ अगमजानी ला बहकाय हंव, अऊ मेंह ओकर बिरूध अपन हांथ बढ़ाहूं अऊ ओला अपन मनखे इसरायलीमन के बीच ले नास कर दूहूं। <verse eid="EZK 14:9"/><verse number="10" style="v" sid="EZK 14:10"/>ओमन अपन अपराध के बोझा ला उठाहीं—अगमजानी ह भी ओतकेच दोसी ठहिरही, जतेक ओकर ले सलाह लेवइया मनखे ह ठहिरही। <verse eid="EZK 14:10"/><verse number="11" style="v" sid="EZK 14:11"/>तब इसरायल के मनखेमन फेर कभू मोर ले नइं भटकहीं अऊ न ही फेर कभू ओमन अपन जम्मो पाप के दुवारा अपनआप ला असुध करहीं। ओमन मोर मनखे होहीं, अऊ मेंह ओमन के परमेसर ठहिरहूं, परमपरधान यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 14:11"/></para>
  <para style="s1">यरूसलेम के नियाय जरूरी</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 14:12"/>तब यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 14:12"/><verse number="13" style="v" sid="EZK 14:13"/>“हे मनखे के बेटा, यदि कोनो देस बिसवासघात करके मोर बिरूध पाप करथे अऊ मेंह ओकर बिरूध अपन हांथ बढ़ाके ओकर जेवन-पानी ला बंद कर देथंव अऊ ओकर ऊपर अकाल भेजके ओकर मनखे अऊ पसुमन ला मार डालथंव, <verse eid="EZK 14:13"/><verse number="14" style="v" sid="EZK 14:14"/>अऊ चाहे यदि ये तीन मनखे—नूह, दानिएल<note caller="+" style="f"><char style="fr" closed="false">14:14 </char><char style="ft" closed="false">पुराना लेख म </char><char style="fqa" closed="false">दानेल</char></note> अऊ अयूब—ओमा होतिन, त ओमन अपन धरमीपन के दुवारा सिरिप अपनआप ला ही बचा सकतिन, परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 14:15"/>“या यदि मेंह ओ देस म जंगली पसुमन ला भेजंव अऊ ओमन ओ देस ला निरजन करके उजाड़ देवंय ताकि ओ जंगली पसुमन के कारन कोनो ओ देस म ले होके झन जावंय, <verse eid="EZK 14:15"/><verse number="16" style="v" sid="EZK 14:16"/>त मोर जिनगी के कसम, परमपरधान यहोवा ह घोसना करत हे, चाहे ये तीनों मनखे भी उहां होतिन, त ओमन अपन खुद के बेटा-बेटीमन ला घलो नइं बचा पातिन। ओमन अकेला ही बचतिन, पर ओ देस ह उजड़ जातिस।<verse eid="EZK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 14:17"/>“या यदि मेंह ओ देस के बिरूध तलवार उठांव अऊ कहंव, ‘पूरा देस म तलवार चलय,’ अऊ मेंह ओमा के मनखे अऊ पसुमन ला मार डारंव, <verse eid="EZK 14:17"/><verse number="18" style="v" sid="EZK 14:18"/>त मोर जिनगी के कसम, परमपरधान यहोवा ह घोसना करत हे, चाहे ये तीनों मनखे भी उहां होतिन, त ओमन अपन खुद के बेटा-बेटीमन ला घलो बचा नइं पातिन। ओमन अकेला ही बचतिन।<verse eid="EZK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 14:19"/>“या यदि में ओ देस म महामारी भेजंव अऊ ओ देस के मनखे अऊ ओमन के पसुमन ला मारत, खून बहाय के दुवारा ओकर ऊपर अपन कोप देखातेंव, <verse eid="EZK 14:19"/><verse number="20" style="v" sid="EZK 14:20"/>त मोर जिनगी के कसम, परमपरधान यहोवा ह घोसना करत हे, चाहे नूह, दानिएल अऊ अयूब भी उहां होतिन, त ओमन न तो अपन बेटा ला बचा पातिन, अऊ न ही अपन बेटी ला। ओमन अपन धरमीपन के कारन सिरिप अपनआप ला बचा पातिन।<verse eid="EZK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 14:21"/>“काबरकि परमपरधान यहोवा ह ये कहत हे: कतेक खराप दसा होही जब मेंह यरूसलेम म ये चार किसम के भयंकर दंड पठोहूं—तलवार अऊ अकाल अऊ जंगली पसु अऊ महामारी, ताकि येकर आदमी अऊ पसुमन मारे जावंय। <verse eid="EZK 14:21"/><verse number="22" style="v" sid="EZK 14:22"/>तभो ले कुछू मनखेमन बांच जाहीं—बेटा अऊ बेटीमन, जेमन इहां ले बाहिर लाय जाहीं। ओमन तुमन करा आहीं, अऊ जब तुमन ओमन के चालचलन अऊ काममन ला देखहू, त तुमन ला ओ बिपत्ति के बारे म सांति मिलही, जेला मेंह यरूसलेम म डाले हंव—हर एक बिपत्ति जेला मेंह येकर ऊपर लाय हंव। <verse eid="EZK 14:22"/><verse number="23" style="v" sid="EZK 14:23"/>तुमन ला सांति मिलही, जब तुमन ओमन के चालचलन अऊ काममन ला देखहू, काबरकि तब तुमन जानहू कि मेंह यरूसलेम म जऊन कुछू करे हंव, ओला बिगर कारन के नइं करे हंव, परमपरधान यहोवा ह घोसना करत हे।”<verse eid="EZK 14:23"/></para>
  <chapter eid="EZK 14"/>
  <chapter number="15" style="c" sid="EZK 15"/>
  <para style="s1">यरूसलेम, एक बेकार अंगूर के नार के रूप म</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 15:1"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 15:1"/><verse number="2" style="v" sid="EZK 15:2"/>“हे मनखे के बेटा, कोनो अंगूर के नार के लकरी अऊ जंगल के रूखमन के कोनो लकरी म का फरक होथे? <verse eid="EZK 15:2"/><verse number="3" style="v" sid="EZK 15:3"/>का कोनो उपयोगी चीज बनाय बर अंगूर के नार के लकरी लेय जाथे? का कोनो चीज ला टांगे बर ओमा ले खूंटी बनाय जाथे? <verse eid="EZK 15:3"/><verse number="4" style="v" sid="EZK 15:4"/>अऊ जब येला जलाय बर आगी म डारे जाथे अऊ येकर दूनों छोर आगी म जर जाथें, अऊ बीच के भाग ह झुरा जाथे, तब का कोनो काम म ओकर उपयोग होथे? <verse eid="EZK 15:4"/><verse number="5" style="v" sid="EZK 15:5"/>जब येह सइघो रिहिस, तब येह कोनो काम के नइं रिहिस, त जब येह आगी म जर गीस अऊ झुरा गीस, त फेर येकर का उपयोग हो सकथे?<verse eid="EZK 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 15:6"/>“एकरसेति परमपरधान यहोवा ह ये कहत हे: जइसने जंगल के रूखमन म ले मेंह अंगूर के नार के लकरी ला आगी बर ईंधन के रूप म देय हंव, वइसने ही मेंह यरूसलेम म रहइया मनखेमन के संग बरताव करहूं। <verse eid="EZK 15:6"/><verse number="7" style="v" sid="EZK 15:7"/>मेंह अपन मुहूं ओमन के बिरूध करहूं। हालाकि ओमन आगी म ले निकल आय हवंय, तभो ले आगी ही ओमन ला जलाके नास कर दीही। अऊ जब मेंह अपन मुहूं ओमन के बिरूध करहूं, तब तुमन जानहू कि मेंह यहोवा अंव। <verse eid="EZK 15:7"/><verse number="8" style="v" sid="EZK 15:8"/>मेंह देस ला उजाड़ दूहूं, काबरकि ओमन बिसवासघात करे हवंय, परमपरधान यहोवा ह घोसना करत हे।”<verse eid="EZK 15:8"/></para>
  <chapter eid="EZK 15"/>
  <chapter number="16" style="c" sid="EZK 16"/>
  <para style="s1">यरूसलेम, एक बेभिचारिन घरवाली के रूप म</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 16:1"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 16:1"/><verse number="2" style="v" sid="EZK 16:2"/>“हे मनखे के बेटा, यरूसलेम के जम्मो घिनौना काम बर ओकर बिरोध कर <verse eid="EZK 16:2"/><verse number="3" style="v" sid="EZK 16:3"/>अऊ कह, ‘परमपरधान यहोवा ह यरूसलेम ले ये कहत हे: तोर पुरखा अऊ तोर जनम कनानीमन के देस म होईस; तोर ददा एक अमोरी अऊ तोर दाई एक हित्ती रिहिस। <verse eid="EZK 16:3"/><verse number="4" style="v" sid="EZK 16:4"/>जऊन दिन तें जनमे, न तो तोर नाल काटे गीस, न ही तोला पानी ले धोके साफ करे गीस, अऊ न तो तोला नून ले रगड़े गीस, अऊ न ही तोला ओनहा म लपेटे गीस। <verse eid="EZK 16:4"/><verse number="5" style="v" sid="EZK 16:5"/>तोर खातिर येमा के कोनो भी काम करे बर न तो कोनो तोर ऊपर दया-दिरिस्टी करिन, अऊ न ही तरस खाईन। बल्कि तोला बाहिर खुला मैदान म फटिक दिये गीस, काबरकि तोर जनम के दिन ले ही तोला तुछ समझे गीस।<verse eid="EZK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 16:6"/>“ ‘तब मेंह उहां ले होके गेंव अऊ तोला अपन खून म लोटत देखेंव, अऊ जब तेंह उहां अपन खून म पड़े रहय, त मेंह तोला कहेंव, “जीयत रह!” <verse eid="EZK 16:6"/><verse number="7" style="v" sid="EZK 16:7"/>मेंह तोला खेत के एक पऊधा सहीं बढ़ांय। तेंह बढ़य अऊ बढ़के जवान हो गय। तोर थन ह बाढ़ गीस, अऊ तोर चुंदी ह बाढ़िस, तब भी तें एकदम नंगरी रहय।<verse eid="EZK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 16:8"/>“ ‘बाद म, में फेर उहां ले होके गेंव, अऊ जब तोला देखेंव, त तेंह मया करे लईक बड़े हो गे रहय, तब मेंह अपन ओनहा के छोर ला तोर ऊपर ओढ़ाके तोर उघरा देहें ला ढांक देंय। तब में तोर ले सच्चई के संग सपथ खांय अऊ तोर संग एक करार करेंव, अऊ तें मोर हो गेय, परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 16:9"/>“ ‘तब मेंह तोला पानी म नहवाके तोर ऊपर लगे खून ला धोयेंव, अऊ तोर देहें म तेल लगांय। <verse eid="EZK 16:9"/><verse number="10" style="v" sid="EZK 16:10"/>मेंह तोला कसीदावाला ओनहा अऊ बढ़िया खाल के पनही पहिरांय। मेंह तोला सुघर मलमल के ओनहा पहिरांय अऊ तोला मंहगा ओनहा ओढ़ांय। <verse eid="EZK 16:10"/><verse number="11" style="v" sid="EZK 16:11"/>मेंह जेवर पहिराके तोर सिंगार करेंव: मेंह तोर बाहां म बहुंटा अऊ गला म हार पहिरांय, <verse eid="EZK 16:11"/><verse number="12" style="v" sid="EZK 16:12"/>अऊ मेंह तोर नाक म नथनी, कानमन म बाली अऊ मुड़ म सुघर मुकुट पहिरांय। <verse eid="EZK 16:12"/><verse number="13" style="v" sid="EZK 16:13"/>ये किसम ले सोन अऊ चांदी ले तोर सिंगार करे गीस; तोर ओनहामन सुघर मलमल, मंहगा अऊ कसीदावाला कपड़ा के बनिस। तोर जेवन म मंधरस, जैतून तेल अऊ सुघर आंटा रिहिस। तेंह बहुंत सुघर अऊ रानी होय के लईक हो गेय। <verse eid="EZK 16:13"/><verse number="14" style="v" sid="EZK 16:14"/>तोर सुघरता के कारन तोर कीरति जाति-जाति के मनखेमन के बीच फईल गीस, काबरकि मेंह तोला जऊन सोभा देय रहेंव, ओह तोर सुघरता ला पूरा कर दीस, परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 16:15"/>“ ‘पर तेंह अपन सुघरता ऊपर भरोसा करय अऊ अपन कीरति के उपयोग बेभिचारिन बने बर करय। जऊन ह भी तोर लकठा म ले होके गीस, तेंह ओकर ऊपर बहुंत किरपा करय अऊ तोर सुघरता ह ओला मोह लीस। <verse eid="EZK 16:15"/><verse number="16" style="v" sid="EZK 16:16"/>तेंह अपन कुछू ओनहा ला लेके भड़कीला ऊंचहा जगहमन<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मूरती-पूजा के जगह</char></note> ला बनाय, अऊ उहां बेभिचार के काम करय। तें ओकर मेर गेय, अऊ ओह तोर सुघरता ऊपर अधिकार कर लीस।<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">इबरानी म ये वाक्य के मतलब स्पस्ट नइं ए</char></note> <verse eid="EZK 16:16"/><verse number="17" style="v" sid="EZK 16:17"/>तेंह मोर दिये सुघर जेवरमन ला घलो लेय, ओ जेवर जेमन मोर सोन अऊ चांदी ले बने रिहिन, अऊ ओमन ले तेंह नर मूरतीमन ला बना लेय अऊ ओ मूरतीमन के संग बेभिचार करन लगय। <verse eid="EZK 16:17"/><verse number="18" style="v" sid="EZK 16:18"/>अऊ तें अपन कसीदावाले ओनहा ला लेके ओ मूरतीमन ला पहिराय, अऊ मोर तेल अऊ धूप ओमन के आघू म चघाय। <verse eid="EZK 16:18"/><verse number="19" style="v" sid="EZK 16:19"/>जऊन जेवन मेंह तोर बर देय रहेंव—आंटा, जैतून तेल अऊ मंधरस मेंह तोर खाय बर देय रहेंव—तेंह येमन ला खुसबूवाला धूप के रूप म ओ मूरतीमन के आघू म चघाय। अइसने ही होय हवय, परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 16:20"/>“ ‘अऊ तेंह अपन बेटा-बेटीमन ला लेय, जेमन ला तेंह मोर बर जनम देय रहय, अऊ ओमन ला ओ मूरतीमन बर भोग करके चघा देय। का तोर बेभिचार ह परयाप्त नइं रिहिस? <verse eid="EZK 16:20"/><verse number="21" style="v" sid="EZK 16:21"/>तेंह मोर लइकामन ला बध करके ओमन ला मूरतीमन ला चघा दे हस। <verse eid="EZK 16:21"/><verse number="22" style="v" sid="EZK 16:22"/>अपन ये जम्मो घिनौना काम अऊ बेभिचार के बीच, तेंह अपन लइकापन के ओ दिनमन ला सुरता नइं करय, जब तेंह नंगरी अऊ उघरा अपन खून म लोटत रहय।<verse eid="EZK 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 16:23"/>“ ‘हाय! तोर ऊपर हाय, परमपरधान यहोवा ह घोसना करत हे। तोर आने जम्मो दुस्टता के अलावा, <verse eid="EZK 16:23"/><verse number="24" style="v" sid="EZK 16:24"/>तेंह अपन बर एक गुम्मट बना लेय अऊ हर एक चऊक म एक ऊंचहा पूजा के जगह बनवा लेय। <verse eid="EZK 16:24"/><verse number="25" style="v" sid="EZK 16:25"/>हर एक गली के कोनटा म तेंह अपन ऊंचहा पूजा के जगह बनवा लेय अऊ उहां ले जावत मनखे के आघू म अपन बढ़त दुराचार काम के संग अपन गोड़मन ला पसारके अपन सुघरता के अपमान करय। <verse eid="EZK 16:25"/><verse number="26" style="v" sid="EZK 16:26"/>तेंह बड़े जनन अंगवाले अपन परोसी मिसरी मनखेमन के संग बेभिचार करय, अऊ अपन बढ़त दुराचार काम ले तेंह मोर कोरोध ला भड़काय हस। <verse eid="EZK 16:26"/><verse number="27" style="v" sid="EZK 16:27"/>एकरसेति मेंह अपन हांथ तोर बिरूध उठाय हंव अऊ तोर इलाका ला कम कर दे हंव; मेंह तोला तोर बईरीमन के किरपा ऊपर छोंड़ दे हंव, याने कि पलिस्तीमन के बेटीमन के किरपा ऊपर, जेमन ला तोर बेभिचारी चालचलन के कारन धक्का लगे हे। <verse eid="EZK 16:27"/><verse number="28" style="v" sid="EZK 16:28"/>तेंह अस्सूरी मनखेमन संग घलो बेभिचार करय, काबरकि तोला संतोस नइं होवत रिहिस; अऊ ओकर बाद घलो तोला संतोस नइं होईस। <verse eid="EZK 16:28"/><verse number="29" style="v" sid="EZK 16:29"/>तब तेंह अपन दुराचार काम ला बढ़ाके ओमा बेबिलोनिया<note caller="+" style="f"><char style="fr" closed="false">16:29 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीया</char></note> देस ला घलो सामिल कर लेय, जऊन ह बेपारीमन के एक देस अय, पर येकर ले घलो तोला संतोस नइं होईस।<verse eid="EZK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 16:30"/>“ ‘जब तेंह एक निरलज बेस्या के सहीं ये जम्मो चीज करथस, त मेंह तोर बिरूध कोरोध ले भर जाथंव, परमपरधान यहोवा ह घोसना करत हे! <verse eid="EZK 16:30"/><verse number="31" style="v" sid="EZK 16:31"/>जब तेंह हर एक गली के कोनटा म अपन गुम्मट अऊ हर एक चऊक म अपन ऊंचहा पूजा के जगह बनवाय, त तेंह एक बेस्या सहीं ठहिरय, काबरकि तेंह दिये गय रकम के अपमान करय।<verse eid="EZK 16:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 16:32"/>“ ‘हे बेभिचारिन घरवाली! तें अपन खुद के घरवाला के बदले पराया मनखेमन ला जादा पसंद करथस। <verse eid="EZK 16:32"/><verse number="33" style="v" sid="EZK 16:33"/>जम्मो बेस्यामन भेंट के रूप म कुछू लेथें, पर तें अपन जम्मो मयारूमन ला घूस के रूप म भेंट म कुछू देथस ताकि ओमन हर जगह ले तोर अवैध किरपा बर आवंय। <verse eid="EZK 16:33"/><verse number="34" style="v" sid="EZK 16:34"/>ये किसम ले तोर बेभिचार ह आने मन के बेभिचार ले उल्टा अय; तोर किरपा बर तोर पाछू कोनो नइं जावंय। तें एकदम उल्टा अस, काबरकि तेंह दाम देथस अऊ तोला कुछू नइं देय जावय।<verse eid="EZK 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 16:35"/>“ ‘ये खातिर, हे बेस्या, यहोवा के बचन ला सुन! <verse eid="EZK 16:35"/><verse number="36" style="v" sid="EZK 16:36"/>परमपरधान यहोवा ह ये कहत हे: काबरकि तेंह अपन काम-वासना ला उंडेले हस अऊ अपन मयारूमन के संग अपन दुराचारी काम म अपन उघरा देहें ला देखाय हस, अऊ तोर जम्मो घिनौना मूरतीमन के कारन, अऊ काबरकि तेंह ओ मूरतीमन ला अपन लइकामन के खून दे हस, <verse eid="EZK 16:36"/><verse number="37" style="v" sid="EZK 16:37"/>ये खातिर मेंह तोर ओ जम्मो मयारूमन ला इकट्ठा करइया हंव, जेमन के संग तोला खुसी मिले हे, जेमन ले तेंह मया करे हस अऊ जेमन ले तेंह घिन करे हस। मेंह ओमन ला चारों कोति ले तोर बिरूध म इकट्ठा करहूं अऊ ओमन के आघू म तोर ओनहा उतारहूं, अऊ ओमन तोर एकदम उघरा देहें ला देखहीं। <verse eid="EZK 16:37"/><verse number="38" style="v" sid="EZK 16:38"/>तब में तोला ओ माईलोगनमन के सजा दूहूं, जेमन बेभिचार करथें अऊ जेमन खून बहाथें; मेंह अपन कोप अऊ जलन के कोरोध के संग तोर ले खून के बदला लूहूं। <verse eid="EZK 16:38"/><verse number="39" style="v" sid="EZK 16:39"/>तब में तोला तोर मयारूमन के हांथ म सऊंप दूहूं, अऊ ओमन तोर गुम्मटमन ला टोरके गिरा दीहीं अऊ तोर ऊंचहा पूजा के जगहमन ला नास कर दीहीं। ओमन तोर ओनहा ला उतार लीहीं अऊ तोर सुघर जेवर ला लूट लीहीं अऊ तोला अबगा नंगरी करके छोंड़ दीहीं। <verse eid="EZK 16:39"/><verse number="40" style="v" sid="EZK 16:40"/>ओमन तोर बिरूध एक उपदरवी भीड़ ले आहीं, जेमन तोर ऊपर पथरवाह करहीं अऊ तोला अपन तलवार ले कुटा-कुटा कर डालहीं। <verse eid="EZK 16:40"/><verse number="41" style="v" sid="EZK 16:41"/>तब ओमन तोर घरमन ला जला दीहीं अऊ बहुंत माईलोगनमन के देखत म सजा दीहीं। मेंह तोर बेभिचार के काम ला बंद कर दूहूं, अऊ तेंह फेर तोर मयारूमन ला दाम नइं देबे। <verse eid="EZK 16:41"/><verse number="42" style="v" sid="EZK 16:42"/>तब तोर बिरूध मोर कोप ह सांत होही अऊ तोर ऊपर ले मोर जलन के कोरोध ह हट जाही; में सांत हो जाहूं अऊ फेर गुस्सा नइं करहूं।<verse eid="EZK 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="EZK 16:43"/>“ ‘काबरकि तें अपन जवानी के दिनमन ला सुरता नइं रखय, पर ये जम्मो काममन के दुवारा मोला नराज करय, एकरसेति तें जऊन कुछू करे हस, खचित मेंह ओ बातमन ला तोर ही मुड़ ऊपर ले आहूं, परमपरधान यहोवा ह घोसना करत हे। का तेंह अपन आने जम्मो घिनौना काम के अलावा, फूहड़ काम घलो नइं करय?<verse eid="EZK 16:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 16:44"/>“ ‘हर ओ मनखे, जऊन ह कहावतमन के उपयोग करथे, ओह तोर बारे म ये कहावत के उपयोग करही: “जइसने दाई, वइसने बेटी।” <verse eid="EZK 16:44"/><verse number="45" style="v" sid="EZK 16:45"/>तेंह अपन दाई के सही बेटी अस, जऊन ह अपन घरवाला अऊ अपन लइकामन ला तुछ समझिस; अऊ तेंह अपन ओ बहिनीमन के सही बहिनी अस, जेमन अपन घरवाला अऊ अपन लइकामन ला तुछ समझिन। तोर दाई ह एक हित्ती अऊ तोर ददा एक अमोरी रिहिस। <verse eid="EZK 16:45"/><verse number="46" style="v" sid="EZK 16:46"/>सामरिया ह तोर बड़े बहिनी रिहिस, जऊन ह अपन बेटीमन के संग तोर उत्तर कोति रहत रिहिस; अऊ तोर छोटे बहिनी सदोम रिहिस, जऊन ह अपन बेटीमन के संग तोर दक्खिन कोति रहत रिहिस। <verse eid="EZK 16:46"/><verse number="47" style="v" sid="EZK 16:47"/>तें न सिरिप ओमन के रसता म चलके ओमन के घिनौना काममन के नकल करय, पर बहुंत जल्दी, तें अपन जम्मो काम म ओमन ले घलो जादा बिगड़ गेय। <verse eid="EZK 16:47"/><verse number="48" style="v" sid="EZK 16:48"/>परमपरधान यहोवा ह घोसना करत हे, मोर जिनगी के कसम, तोर बहिनी सदोम अऊ ओकर बेटीमन अइसने घिनौना काम कभू नइं करिन, जइसने तें अऊ तोर बेटीमन करे हवंय।<verse eid="EZK 16:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="EZK 16:49"/>“ ‘तोर बहिनी सदोम के पाप ये रिहिस: ओह अऊ ओकर बेटीमन घमंडी, खधरी अऊ बेफिकर जिनगी जीनेवाली रिहिन; ओमन गरीब अऊ जरूरतमंद के मदद नइं करिन। <verse eid="EZK 16:49"/><verse number="50" style="v" sid="EZK 16:50"/>ओमन घमंडी रिहिन अऊ ओमन मोर आघू म घिनौना काम करिन। एकरसेति मेंह ओमन ला दूरिहा म कर देंव, जइसे कि तेंह देखे हस। <verse eid="EZK 16:50"/><verse number="51" style="v" sid="EZK 16:51"/>सामरिया ह तोर पापमन के आधा घलो पाप नइं करिस। तेंह ओमन ले जादा घिनौना काम करे हस, अऊ तोर दुवारा करे गय ये जम्मो काम ले तेंह अपन बहिनी ला धरमी देखाय के कोसिस करे हस। <verse eid="EZK 16:51"/><verse number="52" style="v" sid="EZK 16:52"/>अपन कलंक के बोझा उठात रह, काबरकि तेंह अपन बहिनीमन बर कुछू नियाय दे हस। काबरकि तोर पापमन ओमन के पाप ले जादा दुस्टता ले भरे रिहिन, ओमन तोर ले जादा धरमी दिखत हें। एकरसेति तें लज्जित होके अपन कलंक के बोझा ला उठात रह, काबरकि तेंह अपन बहिनीमन ला धरमी देखाय के कोसिस करे हस।<verse eid="EZK 16:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="EZK 16:53"/>“ ‘तभो ले, में सदोम अऊ ओकर बेटीमन के जिनगी, सामरिया अऊ ओकर बेटीमन के जिनगी, अऊ संग म तोर जिनगी ला घलो बदलहूं, <verse eid="EZK 16:53"/><verse number="54" style="v" sid="EZK 16:54"/>ताकि तें अपन कलंक के बोझा ला उठा सकस अऊ ओमन ला सांति देय म जऊन काम करे हस, ओ जम्मो ले लज्जित हो। <verse eid="EZK 16:54"/><verse number="55" style="v" sid="EZK 16:55"/>अऊ तोर बहिनी, सदोम अऊ सामरिया अपन-अपन बेटीमन समेत अपन पहिली दसा म फेर आ जाहीं; अऊ तें अऊ तोर बेटीमन घलो अपन पहिली दसा म फेर आ जाहू। <verse eid="EZK 16:55"/><verse number="56" style="v" sid="EZK 16:56"/>अपन घमंड के दिन म, तें अपन बहिनी सदोम के नांव तक नइं लेवत रहय, <verse eid="EZK 16:56"/><verse number="57" style="v" sid="EZK 16:57"/>जब तोर दुस्टता परगट नइं होय रिहिस। ओही किसम ले, अब एदोम<note caller="+" style="f"><char style="fr" closed="false">16:57 </char><char style="ft" closed="false">कतको इबरानी हस्तलिपि म </char><char style="fqa" closed="false">अराम</char></note> के बेटी अऊ ओकर जम्मो परोसी अऊ पलिस्तीमन के बेटीमन तोला अपमानित करथें—तोर चारों कोति के जम्मो मनखेमन तोला तुछ समझथें। <verse eid="EZK 16:57"/><verse number="58" style="v" sid="EZK 16:58"/>तोला अपन नंगई अऊ अपन घिनौना काममन के परिनाम भुगते बर पड़ही, यहोवा ह घोसना करत हे।<verse eid="EZK 16:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="EZK 16:59"/>“ ‘परमपरधान यहोवा ह ये कहत हे: मेंह तोर संग म वइसनेच बरताव करहूं, जइसने तोर संग होना चाही, काबरकि तेंह करार ला टोरे के दुवारा मोर सपथ ला तुछ समझे हस। <verse eid="EZK 16:59"/><verse number="60" style="v" sid="EZK 16:60"/>तभो ले मेंह ओ करार ला सुरता रखहूं, जेला मेंह तोर संग तोर जवानी के दिन म करे रहेंव, अऊ मेंह तोर संग सदाकाल तक बने रहइया एक करार करहूं। <verse eid="EZK 16:60"/><verse number="61" style="v" sid="EZK 16:61"/>जब तें अपन चालचलन ला सुरता करके सरमिंदा होबे, जब तें अपन बहिनीमन ले मिलबे, याने कि बड़े अऊ छोटे बहिनीमन ले मिलबे। मेंह ओमन ला तोला तोर बेटीमन के रूप म दूहूं, पर येह तोर संग करे गय करार के आधार म नइं होवय। <verse eid="EZK 16:61"/><verse number="62" style="v" sid="EZK 16:62"/>ये किसम ले, मेंह तोर संग अपन करार करहूं, अऊ तेंह जानबे कि मेंह यहोवा अंव। <verse eid="EZK 16:62"/><verse number="63" style="v" sid="EZK 16:63"/>जब मेंह तोर करे गय जम्मो गलत काम ला छेमा करहूं, तब तेंह सुरता करबे अऊ लज्जित होबे अऊ अपमानित होय के कारन फेर कभू अपन मुहूं नइं खोलबे, परमपरधान यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 16:63"/></para>
  <chapter eid="EZK 16"/>
  <chapter number="17" style="c" sid="EZK 17"/>
  <para style="s1">दू ठन गिधवा अऊ अंगूर के नार के पटंतर</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 17:1"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 17:1"/><verse number="2" style="v" sid="EZK 17:2"/>“हे मनखे के बेटा, एक पहेली बना अऊ येला इसरायलीमन ला एक पटंतर के रूप सुना। <verse eid="EZK 17:2"/><verse number="3" style="v" sid="EZK 17:3"/>ओमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: एक बड़े गिधवा लबानोन म आईस, जेकर सक्तिसाली डेना अऊ लम्बा पांखीमन रिहिन अऊ पूरा पांखीमन रंग-बिरंगा रिहिन। एक देवदार के रूख के चोटी के डारा ला धरके, <verse eid="EZK 17:3"/><verse number="4" style="v" sid="EZK 17:4"/>ओह सबले ऊपर के एक कोअंर डारा ला टोर लीस अऊ ओला बेपारीमन के एक देस म ले गीस, अऊ ओ डारा ला ओह उहां बेपारीमन के एक सहर म जगा दीस।<verse eid="EZK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 17:5"/>“ ‘ओह इसरायल देस के छोटे बीजामन ले एक ठन बीजा लेके ओला उपजाऊ भुइयां म जगा दीस। ओह ओला बहुंत पानीवाले जगह के तीर म एक सरई असन लगाईस, <verse eid="EZK 17:5"/><verse number="6" style="v" sid="EZK 17:6"/>अऊ ओ बीजा ह जामिस अऊ खाल्हे म फईलके एक ठन अंगूर के नार हो गीस। येकर डारामन ओकर कोति मुड़िन, पर ओकर जरीमन ओकर खाल्हे म रिहिन। ये किसम ले, ओह एक अंगूर के नार हो गीस अऊ ओमा ले डारामन निकलिन अऊ ये डारामन पानमन ले भर गीन।<verse eid="EZK 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 17:7"/>“ ‘पर उहां एक अऊ बड़े गिधवा रिहिस, जेकर सक्तिसाली डेनामन रिहिन अऊ ओह पांखीमन ले भरे रिहिस। ओ अंगूर के नार जिहां ओला लगाय गे रिहिस, उहां ले ओकर जरीमन ओ दूसर गिधवा कोति बढ़े लगिन अऊ ओकर डारामन पानी बर ओकर कोति फईले लगिन। <verse eid="EZK 17:7"/><verse number="8" style="v" sid="EZK 17:8"/>येला बने भुइयां म बहुंत पानीवाले जगह के तीर म लगाय गे रिहिस ताकि ओमा डारामन निकलंय, ओमा फर लगय अऊ ओह एक बहुंत बढ़िया अंगूर के नार होवय।’<verse eid="EZK 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 17:9"/>“तें ओमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: का येह बाढ़ही? का येला जरी ले उखानके येकर फरमन ला नइं गिरा दिये जाही ताकि येह सूखा जावय? येकर जम्मो नवां पानमन सूखा जाहीं। येला जड़ ले उखाने बर कोनो मजबूत हांथ या जादा मनखेमन के जरूरत नइं होही। <verse eid="EZK 17:9"/><verse number="10" style="v" sid="EZK 17:10"/>येला लगाय गे हवय, पर का येह बाढ़ही? जब पूरबी हवा येकर ऊपर चलही, तब का येह पूरा सूखा नइं जाही? ओ भुइयां म ही सूखा जाही, जिहां येह रिहिस।’ ”<verse eid="EZK 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 17:11"/>तब यहोवा के बचन मोर मेर आईस: <verse eid="EZK 17:11"/><verse number="12" style="v" sid="EZK 17:12"/>“ये बिदरोही मनखेमन ले कह, ‘का तुमन नइं जानव कि ये बातमन के का मतलब अय?’ ओमन ले कह: ‘बेबिलोन के राजा यरूसलेम गीस अऊ ओकर राजा अऊ ओकर परभावसाली मनखेमन ला अपन संग वापिस बेबिलोन ले आईस। <verse eid="EZK 17:12"/><verse number="13" style="v" sid="EZK 17:13"/>तब राज-परिवार के एक सदस्य ला लीस अऊ ओला सपथ खवाके ओकर संग एक करार करिस। ओह अपन संग देस के मुखिया आदमीमन ला घलो ले गीस, <verse eid="EZK 17:13"/><verse number="14" style="v" sid="EZK 17:14"/>ताकि ओ राज ह कमजोर हो जावय, अऊ फेर उन्नति झन कर सकय, अऊ सिरिप ओकर करार के मुताबिक चले के दुवारा ही बचे रहय। <verse eid="EZK 17:14"/><verse number="15" style="v" sid="EZK 17:15"/>पर ओ राज के राजा ह अपन दूतमन ला घोड़ा अऊ एक बड़े सेना लाय बर मिसर देस पठोईस अऊ ये किसम ले ओह बेबिलोन के राजा ले बिदरोह करिस। का ओह सफल होही? का अइसने काम करइया ह बांच जाही? का ओह करार टोरके घलो बांच जाही?<verse eid="EZK 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 17:16"/>“ ‘मोर जिनगी के कसम, परमपरधान यहोवा ह कहत हे: ओह बेबिलोन म, ओ राजा के देस म मर जाही, जऊन ह ओला सिंघासन म बईठाय रिहिस, जेकर कसम ला ओह तुछ जानिस अऊ जेकर करार ला ओह टोरिस। <verse eid="EZK 17:16"/><verse number="17" style="v" sid="EZK 17:17"/>जब ढलानमन बनाय जाहीं अऊ बहुंते मनखेमन ला नास करे बर घेराबंदी के काम करे जाही, तब फिरौन, ओकर सक्तिसाली सेना अऊ बड़े उपदरवी झुंड घलो लड़ई म ओकर कोनो मदद नइं कर सकहीं। <verse eid="EZK 17:17"/><verse number="18" style="v" sid="EZK 17:18"/>ओह करार ला टोरके कसम ला तुछ जानिस। काबरकि ओह हांथ देके कसम खाय रिहिस अऊ तभो ले ये सब काम करिस, एकरसेति ओह बांचे नइं पाही।<verse eid="EZK 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 17:19"/>“ ‘एकरसेति परमपरधान यहोवा ह ये कहत हे: मोर जिनगी के कसम, मेंह ओकर ले मोर कसम ला तुछ समझे के अऊ मोर करार ला टोरे के बदला लूहूं। <verse eid="EZK 17:19"/><verse number="20" style="v" sid="EZK 17:20"/>मेंह ओकर बर अपन जाल फईलाहूं अऊ ओह मोर फांदा म फंसही। मेंह ओला बेबिलोन ले आहूं अऊ उहां ओला दंड दूहूं काबरकि ओह मोर संग बिसवासघात करिस। <verse eid="EZK 17:20"/><verse number="21" style="v" sid="EZK 17:21"/>ओकर चुने गय सेना के दलमन तलवार ले मारे जाहीं, अऊ बांचे मनखेमन चारों कोति तितिर-बितिर हो जाहीं। तब तुमन जानहू कि में यहोवा ह ये कहे हंव।<verse eid="EZK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 17:22"/>“ ‘परमपरधान यहोवा ह ये कहत हे: में खुद एक ठन देवदार रूख के सबले ऊंच डारा के अंकुर ला लेके लगाहूं; में ओकर सबले ऊंच डारामन ले एक ठन कोअंर अंकुर ला टोरहूं अऊ ओला एक ऊंच पहाड़ म लगाहूं। <verse eid="EZK 17:22"/><verse number="23" style="v" sid="EZK 17:23"/>मेंह ओला इसरायल के पहाड़ के ऊंचई म लगाहूं; येमा डारामन निकलहीं अऊ फर लगही अऊ येह एक सानदार देवदार के रूख हो जाही। हर किसम के चिरईमन ओमा अपन खोंधरा बनाहीं; ओमन ओकर डारामन के छइहां म बसेरा करहीं। <verse eid="EZK 17:23"/><verse number="24" style="v" sid="EZK 17:24"/>जंगल के जम्मो रूखमन जान लीहीं कि में यहोवा ही ऊंचहा रूख ला खाल्हे अऊ छोटे रूख ला बढ़ाके ऊंचहा करथंव। मेंह हरियर रूख ला सूखा देथंव अऊ सूखा रूख ला हरियर करके बढ़ाथंव।</para>
  <para style="p" vid="EZK 17:24">“ ‘में यहोवा ह ये कहे हंव, अऊ मेंह येला पूरा करहूं।’ ”<verse eid="EZK 17:24"/></para>
  <chapter eid="EZK 17"/>
  <chapter number="18" style="c" sid="EZK 18"/>
  <para style="s1">जऊन ह पाप करथे, ओह मरही</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 18:1"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 18:1"/><verse number="2" style="v" sid="EZK 18:2"/>“इसरायल देस के बारे म ये कहावत कहे के तुमन के का मतलब ए:</para>
  <para style="q1" vid="EZK 18:2">“ ‘खट्टा अंगूर त खाईन दाई-ददामन,</para>
  <para style="q2" vid="EZK 18:2">अऊ दांत खट्टा होईस लइकामन के’?<verse eid="EZK 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 18:3"/>“मोर जिनगी के कसम, परमपरधान यहोवा ह कहत हे, तुमन ला इसरायल म फेर ये कहावत कहे के अवसर नइं मिलही। <verse eid="EZK 18:3"/><verse number="4" style="v" sid="EZK 18:4"/>काबरकि हरेक जन मोर अंय, दाई-ददा के संग लइका घलो—दूनों एके सहीं मोर अंय। एकरसेति जऊन ह पाप करथे, ओही ह मरही।<verse eid="EZK 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 18:5"/>“मानलो, एक धरमी मनखे हवय,</para>
  <para style="q2" vid="EZK 18:5">जऊन ह ओ काम करथे, जेह उचित अऊ सही अय।<verse eid="EZK 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 18:6"/>ओह पहाड़ के पूजा के जगह म नइं खावय</para>
  <para style="q2" vid="EZK 18:6">या इसरायल के मूरतीमन कोति नइं देखय।</para>
  <para style="q1" vid="EZK 18:6">ओह अपन परोसी के घरवाली ला असुध नइं करय</para>
  <para style="q2" vid="EZK 18:6">या कोनो माईलोगन के संग ओकर महिना के बेरा सारीरिक संबंध नइं बनाय।<verse eid="EZK 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 18:7"/>ओह काकरो ऊपर अतियाचार नइं करय,</para>
  <para style="q2" vid="EZK 18:7">पर गिरवी रखे चीज के करजा ला लहुंटा देथे।</para>
  <para style="q1" vid="EZK 18:7">ओह डाका नइं डालय</para>
  <para style="q2" vid="EZK 18:7">पर अपन जेवन भूखा मनखे ला देथे</para>
  <para style="q2" vid="EZK 18:7">अऊ नंगरा ला ओनहा देथे।<verse eid="EZK 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 18:8"/>ओह बिगर बियाज के पईसा उधार देथे,</para>
  <para style="q2" vid="EZK 18:8">या ओमन ले फायदा नइं उठाय।</para>
  <para style="q1" vid="EZK 18:8">ओह गलत काम करे ले अपन हांथ ला रोकथे</para>
  <para style="q2" vid="EZK 18:8">अऊ मनखेमन के बीच सही नियाय करथे।<verse eid="EZK 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 18:9"/>ओह मोर बिधिमन म चलथे</para>
  <para style="q2" vid="EZK 18:9">अऊ बिसवासयोग्यता के संग मोर कानूनमन के पालन करथे।</para>
  <para style="q1" vid="EZK 18:9">ओ मनखे ह धरमी अय;</para>
  <para style="q2" vid="EZK 18:9">ओह जरूर जीयत रहिही,</para>
  <para style="q2" vid="EZK 18:9">परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 18:10"/>“मानलो, ओकर एक हिंसा करइया बेटा हे, जऊन ह हतिया करथे या येमा के कोनो अऊ काम करथे <verse eid="EZK 18:10"/><verse number="11" style="v" sid="EZK 18:11"/>(हालाकि ओकर ददा ह येमा के कोनो भी काम नइं करे हवय):</para>
  <para style="q1" vid="EZK 18:11">“ओह पहाड़ के पूजा के जगह म खाथे।</para>
  <para style="q1" vid="EZK 18:11">ओह अपन परोसी के घरवाली ला असुध करथे।<verse eid="EZK 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 18:12"/>ओह गरीब अऊ जरूरतमंद ऊपर अतियाचार करथे।</para>
  <para style="q1" vid="EZK 18:12">ओह लूट-पाट करथे।</para>
  <para style="q1" vid="EZK 18:12">ओह गिरवी म रखे चीज ला नइं लहुंटाय।</para>
  <para style="q1" vid="EZK 18:12">ओह मूरतीमन कोति देखथे।</para>
  <para style="q1" vid="EZK 18:12">ओह घिनौना काम करथे।<verse eid="EZK 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 18:13"/>ओह बियाज म रूपिया देथे अऊ लाभ उठाथे।</para>
  <para style="m" vid="EZK 18:13">का अइसने आदमी जीयत रहिही? ओह नइं जीयय! काबरकि ओह ये सब घिनौना काम करे हवय, ओह जरूर मार डारे जावय; ओकर खून के दोस ओकरे मुड़ ऊपर पड़ही।<verse eid="EZK 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 18:14"/>“पर मानलो, ये मनखे के एक बेटा हवय, जऊन ह अपन ददा के ये जम्मो पाप ला देखथे, अऊ हालाकि ओह ओ पापमन ला देखथे, पर ओह अइसने कोनो पाप नइं करय:<verse eid="EZK 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 18:15"/>“ओह पहाड़ के पूजा के जगह म नइं खावय</para>
  <para style="q2" vid="EZK 18:15">या इसरायल के मूरतीमन ला नइं देखय।</para>
  <para style="q1" vid="EZK 18:15">ओह अपन परोसी के घरवाली ला असुध नइं करय।<verse eid="EZK 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 18:16"/>ओह काकरो ऊपर अतियाचार नइं करय</para>
  <para style="q2" vid="EZK 18:16">या करजा देय बर कोनो चीज ला गिरवी नइं रखय।</para>
  <para style="q1" vid="EZK 18:16">ओह लूट-पाट नइं करय</para>
  <para style="q2" vid="EZK 18:16">पर अपन जेवन भूखा मनखे ला देथे</para>
  <para style="q2" vid="EZK 18:16">अऊ नंगरा ला ओनहा देथे।<verse eid="EZK 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 18:17"/>ओह गरीबमन ला सताय ले अपन हांथ रोके रहिथे</para>
  <para style="q2" vid="EZK 18:17">अऊ ओमन ले कोनो बियाज या फायदा नइं उठाय।</para>
  <para style="q1" vid="EZK 18:17">ओह मोर कानूनमन ला मानथे अऊ मोर बिधिमन म चलथे।</para>
  <para style="m" vid="EZK 18:17">ओह अपन ददा के पाप के कारन नइं मरय; ओह जरूर जीयत रहिही। <verse eid="EZK 18:17"/><verse number="18" style="v" sid="EZK 18:18"/>पर ओकर ददा ह अपन खुद के पाप के कारन मरही, काबरकि ओह अवैध वसूली करिस, अपन भाई ला लूटिस अऊ ओ काम करिस, जऊन ह ओकर मनखेमन के बीच गलत अय।<verse eid="EZK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 18:19"/>“तभो ले, तुमन पुछथव, ‘बेटा ह अपन ददा के दोस के भागीदार काबर नइं होवय?’ जब बेटा ह उचित अऊ सही काम करे हवय अऊ धियान देके मोर जम्मो बिधिमन के पालन करे हवय, त ओह जरूर जीयत रहिही। <verse eid="EZK 18:19"/><verse number="20" style="v" sid="EZK 18:20"/>जऊन ह पाप करथे, ओही ह मरही। कोनो लइका ह अपन दाई-ददा के दोस के भागीदार नइं होही, अऊ न ही दाई-ददा अपन लइका के दोस के भागीदार होहीं। धरमी के धरमीपन के फर ओ धरमी ला ही मिलही, अऊ दुस्ट के दुस्टता के फर ओ दुस्ट ला ही मिलही।<verse eid="EZK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 18:21"/>“पर यदि कोनो दुस्ट मनखे अपन जम्मो पाप ला छोंड़ देथे अऊ मोर जम्मो बिधिमन के पालन करथे अऊ ओ काम करथे जऊन ह उचित अऊ सही अय, त ओ मनखे ह जरूर जीयत रहिही; ओह नइं मरय। <verse eid="EZK 18:21"/><verse number="22" style="v" sid="EZK 18:22"/>ओह जतेक पाप करे हवय, ओमन फेर सुरता नइं करे जावंय। जऊन धरमी काम ओह करे हवय, ओकर कारन ओह जीयत रहिही। <verse eid="EZK 18:22"/><verse number="23" style="v" sid="EZK 18:23"/>का मेंह कोनो दुस्ट के मिरतू ले खुस होथंव? परमपरधान यहोवा ह घोसना करत हे। बल्कि, का मेंह खुस नइं होवंव, जब ओह खराप काम ला छोंड़के जीयत रहिथे?<verse eid="EZK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 18:24"/>“पर यदि कोनो धरमी मनखे अपन धरमीपन ला छोंड़के पाप करथे अऊ ओही घिनौना काम करे लगथे, जेला एक दुस्ट मनखे करथे, त का ओह जीयत रहिही? ओकर दुवारा करे गय कोनो भी धरमी काम ला सुरता नइं करे जाही। जऊन बिसवासघात ओह करे हवय, ओकर खातिर ओह दोसी अय अऊ जऊन पाप ओह करे हवय, ओकर कारन ओह मरही।<verse eid="EZK 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 18:25"/>“तभो ले तुमन कहिथव, ‘परभू के नीति ह उचित नो हय।’ हे इसरायलीमन, तुमन सुनव: का मोर नीति ह अनुचित अय? का ये तुम्हर नीतिमन नो हंय, जेमन अनुचित अंय? <verse eid="EZK 18:25"/><verse number="26" style="v" sid="EZK 18:26"/>यदि कोनो धरमी मनखे अपन धरमीपन ला छोंड़के पाप करथे, त ओह अपन दुस्ट काम के कारन मरही; अपन करे गय पाप के कारन ओह मरही। <verse eid="EZK 18:26"/><verse number="27" style="v" sid="EZK 18:27"/>पर यदि कोनो दुस्ट मनखे अपन दुस्ट काममन ला छोंड़ देथे अऊ ओ काम करथे, जऊन ह उचित अऊ सही अय, त ओह अपन जिनगी ला बचाही। <verse eid="EZK 18:27"/><verse number="28" style="v" sid="EZK 18:28"/>काबरकि ओह अपन करे गय जम्मो पाप ऊपर सोच-बिचार करथे अऊ ओमन ला छोंड़ देथे, ये खातिर ओ मनखे ह जरूर जीयत रहिही; ओह नइं मरय। <verse eid="EZK 18:28"/><verse number="29" style="v" sid="EZK 18:29"/>तभो ले इसरायलीमन कहिथंय, ‘परभू के नीति ह उचित नो हय।’ हे इसरायल के मनखेमन, का मोर नीतिमन अनुचित अंय? का येमन तुम्हर नीति नो हंय, जेमन अनुचित अंय?<verse eid="EZK 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 18:30"/>“एकरसेति, हे इसरायलीमन, मेंह तुमन म ले हर एक मनखे के नियाय ओकर खुद के चालचलन के मुताबिक करहूं, परमपरधान यहोवा ह घोसना करत हे। पछताप करव! अपन जम्मो पाप ला छोंड़ दव; तब पाप ह तुम्हर पतन होय के कारन नइं होही। <verse eid="EZK 18:30"/><verse number="31" style="v" sid="EZK 18:31"/>अपन करे गय जम्मो अपराध ले दूरिहा हो जावव अऊ एक नवां हिरदय अऊ एक नवां आतमा ले लव। हे इसरायल के मनखेमन, तुम्हर मिरतू काबर होवय? <verse eid="EZK 18:31"/><verse number="32" style="v" sid="EZK 18:32"/>काबरकि मोला काकरो मिरतू ले खुसी नइं होवय, परमपरधान यहोवा ह घोसना करत हे। एकरसेति पछताप करव अऊ जीयत रहव!<verse eid="EZK 18:32"/></para>
  <chapter eid="EZK 18"/>
  <chapter number="19" style="c" sid="EZK 19"/>
  <para style="s1">इसरायल के हाकिममन बर बिलाप</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 19:1"/>“इसरायल के हाकिममन के संबंध म एक बिलापगीत लेय ले <verse eid="EZK 19:1"/><verse number="2" style="v" sid="EZK 19:2"/>अऊ कह:</para>
  <para style="q1" vid="EZK 19:2">“ ‘सिंहमन के बीच</para>
  <para style="q2" vid="EZK 19:2">तोर दाई ह एक अद्भूत सिंहनी रिहिस!</para>
  <para style="q1" vid="EZK 19:2">ओह ओमन के बीच म लेटय</para>
  <para style="q2" vid="EZK 19:2">अऊ अपन पीलामन के पालन-पोसन करय।<verse eid="EZK 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 19:3"/>ओह अपन पीलामन ले एक ठन ला पालके बड़े करिस,</para>
  <para style="q2" vid="EZK 19:3">अऊ ओह एक बलवान सिंह हो गीस।</para>
  <para style="q1" vid="EZK 19:3">ओह सिकार करे बर सीख गीस</para>
  <para style="q2" vid="EZK 19:3">अऊ ओह आदमी के मांस खानेवाला हो गीस।<verse eid="EZK 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 19:4"/>जाति-जाति के मनखेमन ओकर बारे म सुनिन,</para>
  <para style="q2" vid="EZK 19:4">अऊ ओह ओमन के दुवारा खोदे गय खंचवा म गिरके फंस गीस।</para>
  <para style="q1" vid="EZK 19:4">ओमन ओकर ऊपर नकेल डालके</para>
  <para style="q2" vid="EZK 19:4">ओला मिसर देस ले गीन।<verse eid="EZK 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 19:5"/>“ ‘जब सिंहनी ह देखिस कि ओकर आसा ह पूरा नइं होईस,</para>
  <para style="q2" vid="EZK 19:5">ओकर आसा ह टूट गीस,</para>
  <para style="q1" vid="EZK 19:5">तब ओह अपन एक ठन अऊ पीला ला लीस</para>
  <para style="q2" vid="EZK 19:5">अऊ ओला एक बलवान सिंह बनाईस।<verse eid="EZK 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 19:6"/>ओह आने सिंहमन के बीच म चले-फिरे लगिस,</para>
  <para style="q2" vid="EZK 19:6">काबरकि अब ओह एक बलवान सिंह हो गे रिहिस।</para>
  <para style="q1" vid="EZK 19:6">ओह सिकार करे बर सीख गीस</para>
  <para style="q2" vid="EZK 19:6">अऊ ओह एक आदमी के मांस खानेवाला बन गीस।<verse eid="EZK 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 19:7"/>ओह ओमन के गढ़मन ला टोर दीस</para>
  <para style="q2" vid="EZK 19:7">अऊ ओमन के नगरमन ला उजाड़ दीस।</para>
  <para style="q1" vid="EZK 19:7">पूरा देस अऊ ओमा रहइया जम्मो झन</para>
  <para style="q2" vid="EZK 19:7">ओकर गरजे ले डरात रिहिन।<verse eid="EZK 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 19:8"/>तब ओकर चारों कोति के</para>
  <para style="q2" vid="EZK 19:8">जाति-जाति के मनखेमन ओकर बिरूध हो गीन।</para>
  <para style="q1" vid="EZK 19:8">ओमन ओकर बर जाल बिछाईन,</para>
  <para style="q2" vid="EZK 19:8">अऊ ओह ओमन के कोड़े गय खंचवा म फंस गीस।<verse eid="EZK 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 19:9"/>ओमन नकेल डालके ओला ऊपर खींचिन अऊ ओला एक ठन पिंजरा म डाल दीन</para>
  <para style="q2" vid="EZK 19:9">अऊ ओला बेबिलोन के राजा करा ले गीन।</para>
  <para style="q1" vid="EZK 19:9">ओमन ओला जेल म डाल दीन,</para>
  <para style="q2" vid="EZK 19:9">जेकर कारन ओकर गरजन</para>
  <para style="q2" vid="EZK 19:9">इसरायल के पहाड़मन म फेर कभू सुनई नइं दीस।<verse eid="EZK 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 19:10"/>“ ‘तोर दाई ह पानी के तीर म लगाय गय</para>
  <para style="q2" vid="EZK 19:10">तोर अंगूर के बारी म अंगूर के एक नार सहीं रिहिस;</para>
  <para style="q1" vid="EZK 19:10">बहुंत पानी होय के कारन</para>
  <para style="q2" vid="EZK 19:10">ओमा फर लगत रिहिस अऊ ओह डारामन ले भरे रिहिस।<verse eid="EZK 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 19:11"/>ओकर डारामन मजबूत रिहिन,</para>
  <para style="q2" vid="EZK 19:11">अऊ एक सासन करइया के राजदंड सहीं रिहिन।</para>
  <para style="q1" vid="EZK 19:11">बहुंत पानमन के ऊपर</para>
  <para style="q2" vid="EZK 19:11">येह ऊंच बाढ़े रिहिस,</para>
  <para style="q1" vid="EZK 19:11">अपन ऊंचई के कारन</para>
  <para style="q2" vid="EZK 19:11">बहुंत डारामन के बीच येह साफ दिखत रिहिस।<verse eid="EZK 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 19:12"/>पर ओ अंगूर के नार ला कोरोध म उखान दिये गीस</para>
  <para style="q2" vid="EZK 19:12">अऊ भुइयां म फटिक दिये गीस।</para>
  <para style="q1" vid="EZK 19:12">पूरबी हवा ह ओला सूखा दीस,</para>
  <para style="q2" vid="EZK 19:12">ओकर फरमन गिर गीन;</para>
  <para style="q1" vid="EZK 19:12">ओकर मजबूत डालीमन सूख गीन</para>
  <para style="q2" vid="EZK 19:12">अऊ आगी ले जलके ओमन नास हो गीन।<verse eid="EZK 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 19:13"/>अब ओला निरजन जगह म लगाय गे हवय,</para>
  <para style="q2" vid="EZK 19:13">एक सूखा अऊ निरजल भुइयां म।<verse eid="EZK 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 19:14"/>ओकर एक ठन मुख्य डारा ले आगी ह फईलिस</para>
  <para style="q2" vid="EZK 19:14">अऊ ओकर फरमन ला जलाके नास कर दीस।</para>
  <para style="q1" vid="EZK 19:14">ओमा अऊ कोनो मजबूत डाली नइं बचिस</para>
  <para style="q2" vid="EZK 19:14">जऊन ह सासन करइया के राजदंड बर सही होतिस।’</para>
  <para style="m" vid="EZK 19:14">येह एक बिलापगीत अय अऊ येकर उपयोग एक बिलापगीत के रूप म करे जावय।”<verse eid="EZK 19:14"/></para>
  <chapter eid="EZK 19"/>
  <chapter number="20" style="c" sid="EZK 20"/>
  <para style="s1">बिदरोही इसरायल के पछतावा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 20:1"/>हमर बंधुवई के सातवां साल के पांचवां महिना के दसवां दिन इसरायल के कुछू अगुवामन यहोवा ले पुछे बर आईन, अऊ ओमन मोर आघू म बईठ गीन।<verse eid="EZK 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 20:2"/>तब यहोवा के बचन मोर मेर आईस: <verse eid="EZK 20:2"/><verse number="3" style="v" sid="EZK 20:3"/>“हे मनखे के बेटा, इसरायल के अगुवामन ले बात कर अऊ ओमन ला कह, ‘परमपरधान यहोवा ह ये कहत हे: का तुमन मोर ले पुछे बर आय हवव? मोर जिनगी के कसम, मेंह तुमन ला मोर ले पुछे बर नइं दंव, परमपरधान यहोवा ह घोसना करत हे।’<verse eid="EZK 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 20:4"/>“का तें ओमन के नियाय करबे? हे मनखे के बेटा, का तें ओमन के नियाय करबे? तब ओमन के पुरखामन के घिनौना काम ओमन ला बता <verse eid="EZK 20:4"/><verse number="5" style="v" sid="EZK 20:5"/>अऊ ओमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: जऊन दिन मेंह इसरायल ला चुने रहेंव, मेंह अपन हांथ उठाके याकूब के संतानमन ले सपथ खाय रहेंव अऊ मिसर देस म अपनआप ला ओमन ऊपर परगट करेंव। हांथ उठाके मेंह ओमन ले कहेंव, “मेंह यहोवा तुम्हर परमेसर अंव।” <verse eid="EZK 20:5"/><verse number="6" style="v" sid="EZK 20:6"/>ओही दिन मेंह ओमन ले सपथ खायेंव कि मेंह ओमन ला मिसर देस ले निकालके एक अइसे देस म ले आहूं, जेला मेंह ओमन बर खोजे रहेंव; एक अइसे देस जेमा दूध अऊ मंधरस के धारा बहिथे, अऊ जऊन ह जम्मो देसमन ले सुघर हवय। <verse eid="EZK 20:6"/><verse number="7" style="v" sid="EZK 20:7"/>अऊ मेंह ओमन ले कहेंव, “तुमन म ले हर एक जन ओ निकम्मा मूरतीमन ला निकाल फेंकव, जेमन ऊपर तुम्हर आंखी लगे हवय, अऊ मिसर के मूरतीमन ले अपनआप ला असुध झन करव। मेंह यहोवा तुम्हर परमेसर अंव।”<verse eid="EZK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 20:8"/>“ ‘पर ओमन मोर बिरूध बिदरोह करिन अऊ मोर बात ला नइं सुनिन; ओमन ओ निकम्मा मूरतीमन ला नइं फेंकिन, जेमा ओमन के आंखी लगे रिहिस, अऊ न ही ओमन मिसर के मूरतीमन ला छोंड़िन। एकरसेति मेंह कहेंव कि में ओमन ऊपर अपन कोप भड़काहू अऊ मिसर देस म ओमन के बिरूध अपन कोरोध देखाहूं। <verse eid="EZK 20:8"/><verse number="9" style="v" sid="EZK 20:9"/>पर अपन नांव के खातिर, में ओमन ला मिसर देस ले निकाल लानेंव। मेंह अइसने एकरसेति करेंव ताकि मोर नांव ओ जाति-जाति के मनखेमन के नजर म अपबितर झन ठहिरय, जेमन के बीच ओमन रहत रिहिन अऊ जेमन के देखत म मेंह अपनआप ला इसरायलीमन ऊपर परगट करे रहेंव। <verse eid="EZK 20:9"/><verse number="10" style="v" sid="EZK 20:10"/>एकरसेति मेंह ओमन ला मिसर देस ले निकालके सुन्ना जगह म ले आयेंव। <verse eid="EZK 20:10"/><verse number="11" style="v" sid="EZK 20:11"/>मेंह ओमन ला अपन बिधिमन ला देंव अऊ ओमन ला अपन कानूनमन ला बतांय, जेकर यदि कोनो मनखे पालन करथे, त ओह जीयत रहिही। <verse eid="EZK 20:11"/><verse number="12" style="v" sid="EZK 20:12"/>मेंह ओमन बर अपन बिसराम दिन घलो ठहिरांय, जऊन ह मोर अऊ ओमन के बीच म एक चिनहां ए, ताकि ओमन जानंय कि में यहोवा ह ओमन ला पबितर बनाय हंव।<verse eid="EZK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 20:13"/>“ ‘तभो ले इसरायल के मनखेमन सुन्ना जगह म मोर ले बिदरोह करिन। ओमन मोर बिधिमन म नइं चलिन अऊ मोर कानूनमन ला नइं मानिन—जेकर पालन यदि कोनो मनखे करथे, त ओह ओमन के दुवारा जीयत रहिही—अऊ ओमन मोर बिसराम दिनमन ला बहुंत अपबितर करिन। एकरसेति मेंह कहेंव कि ओमन ऊपर मोर कोप भड़कही अऊ सुन्ना जगह म ओमन ला नास कर दूहूं। <verse eid="EZK 20:13"/><verse number="14" style="v" sid="EZK 20:14"/>पर अपन नांव के खातिर मेंह ओ करेंव जेकर ले मोर नांव ओ जाति-जाति के मनखेमन के नजर म अपबितर झन ठहिरे, जेमन के देखत मेंह ओमन ला निकालके लाय रहेंव। <verse eid="EZK 20:14"/><verse number="15" style="v" sid="EZK 20:15"/>हांथ उठाके मेंह ओमन ले सुन्ना जगह म कसम घलो खायेंव कि जऊन देस मेंह ओमन ला दे रहेंव, ओ देस म ओमन ला नइं लानंव—एक अइसने देस जिहां दूध अऊ मंधरस के धारा बोहात हे, जऊन ह जम्मो देसमन ले सुघर हवय— <verse eid="EZK 20:15"/><verse number="16" style="v" sid="EZK 20:16"/>काबरकि ओमन मोर कानूनमन ला नइं मानिन अऊ मोर बिधिमन म नइं चलिन अऊ मोर बिसराम दिन ला अपबितर करिन। काबरकि ओमन के मन ह ओमन के मूरतीमन ऊपर लगे रिहिस। <verse eid="EZK 20:16"/><verse number="17" style="v" sid="EZK 20:17"/>तभो ले मेंह ओमन ऊपर दया-दिरिस्टी करेंव अऊ ओमन ला नास नइं करेंव या निरजन जगह म ओमन के अन्त नइं करेंव। <verse eid="EZK 20:17"/><verse number="18" style="v" sid="EZK 20:18"/>मेंह निरजन जगह म ओमन के लइकामन ले कहेंव, “अपन दाई-ददा के बिधिमन म या ओमन के कानूनमन म झन चलव या ओमन के मूरतीमन ले अपनआप ला असुध झन करव। <verse eid="EZK 20:18"/><verse number="19" style="v" sid="EZK 20:19"/>मेंह यहोवा तुम्हर परमेसर अंव; मोर बिधिमन म चलव अऊ धियान देके मोर कानूनमन के पालन करव। <verse eid="EZK 20:19"/><verse number="20" style="v" sid="EZK 20:20"/>मोर बिसराम दिन ला पबितर मानव कि ओमन मोर अऊ तुम्हर बीच एक चिनहां ठहिरंय। तब तुमन जानहू कि मेंह यहोवा तुम्हर परमेसर अंव।”<verse eid="EZK 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 20:21"/>“ ‘पर ओमन के लइकामन मोर ले बिदरोह करिन: ओमन मोर बिधिमन म नइं चलिन, ओमन मोर कानूनमन के पालन नइं करिन, जेमन के बारे म मेंह कहे रहेंव, “ओ मनखे जऊन ह ओमन के पालन करही, ओह ओमन के दुवारा जीयत रहिही,” अऊ ओमन मोर बिसराम दिन ला अपबितर करिन। एकरसेति मेंह कहेंव ओमन ऊपर मोर कोप भड़कही अऊ निरजन जगह म मेंह अपन कोरोध ओमन ला देखाहूं। <verse eid="EZK 20:21"/><verse number="22" style="v" sid="EZK 20:22"/>पर मेंह अपन हांथ ला रोके रखेंव, अऊ अपन नांव के खातिर मेंह ओ करेंव, जेकर कारन मोर नांव ओ जाति-जाति के मनखेमन के नजर म अपबितर झन ठहिरय, जेमन के देखत म मेंह इसरायलीमन ला निकाल लानेंव। <verse eid="EZK 20:22"/><verse number="23" style="v" sid="EZK 20:23"/>अपन हांथ उठाके सुन्ना जगह म मेंह ओमन ले सपथ घलो खायेंव कि मेंह ओमन ला जाति-जाति के मनखेमन के बीच बगरा दूहूं अऊ देस-देस म ओमन ला तितिर-बितिर कर दूहूं, <verse eid="EZK 20:23"/><verse number="24" style="v" sid="EZK 20:24"/>काबरकि ओमन मोर कानूनमन के पालन नइं करिन पर मोर बिधिमन ला अस्वीकार करिन अऊ मोर बिसराम दिनमन ला अपबितर करिन, अऊ ओमन के आंखी ओमन के दाई-ददा के मूरतीमन म लगे रिहिस। <verse eid="EZK 20:24"/><verse number="25" style="v" sid="EZK 20:25"/>एकरसेति मेंह ओमन ला आने बिधि-बिधान देंव, जेमन ठीक नइं रिहिन अऊ ओमन ला अइसे कानून देंव जेकर दुवारा ओमन जीयत नइं रह सकत रिहिन; <verse eid="EZK 20:25"/><verse number="26" style="v" sid="EZK 20:26"/>मेंह ओमन ला ओमन के ही भेंटमन के जरिये असुध करेंव—हर एक पहिलऊठा के बलिदान—ताकि मेंह ओमन ला भयभीत करंव अऊ ओमन जानंय कि मेंह यहोवा अंव।’<verse eid="EZK 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 20:27"/>“एकरसेति, हे मनखे के बेटा, इसरायल के मनखेमन ले बात कर अऊ ओमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: येमा घलो तुम्हर पुरखामन मोर ले बिसवासघात करके मोर निन्दा करिन: <verse eid="EZK 20:27"/><verse number="28" style="v" sid="EZK 20:28"/>जब मेंह ओमन ला ओ देस म ले आंय, जेला मेंह ओमन ला देय के कसम खाय रहेंव, त ओमन कोनो ऊंचहा पहाड़ी या कोनो पानवाले रूख ला देखके उहां अपन बलिदान अऊ भेंट चघाय लगिन, अऊ अपन खुसबूवाला धूप जलाके पेय-बलिदान चघाय लगिन, जेकर कारन मोर कोरोध ह भड़किस। <verse eid="EZK 20:28"/><verse number="29" style="v" sid="EZK 20:29"/>तब मेंह ओमन ले कहेंव: ये ऊंचहा जगह का ए कि तुमन उहां जाथव?’ ” (येला आज तक बामाह<note caller="+" style="f"><char style="fr" closed="false">20:29 </char><char style="fq" closed="false">बामाह </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">ऊंचहा जगह</char></note> कहे जाथे।)<verse eid="EZK 20:29"/></para>
  <para style="s1">बिदरोही इसरायलीमन ला नवां करई</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 20:30"/>“एकरसेति इसरायलीमन ले कह: ‘परमपरधान यहोवा ह ये कहत हे: का तुमन अपन पुरखामन सहीं अपनआप ला असुध करहू अऊ ओमन के निकम्मा मूरतीमन बर कामुक होहू? <verse eid="EZK 20:30"/><verse number="31" style="v" sid="EZK 20:31"/>जब तुमन अपन भेंट चघाथव—अपन लइकामन ला आगी म बलिदान करथव—त अइसने करे के दुवारा तुमन आज तक अपनआप ला अपन जम्मो मूरतीमन के दुवारा असुध करत आवत हव। त हे इसरायलीमन, का में तुमन ला मोर ले पुछताछ करन दूहूं? मोर जिनगी के कसम, परमपरधान यहोवा ह घोसना करत हे, में तुमन ला मोर ले पुछताछ करे बर नइं दंव।<verse eid="EZK 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 20:32"/>“ ‘तुमन कहिथव, “हमन ओ जाति-जाति अऊ संसार के मनखेमन सहीं होय चाहथन, जेमन कठवा अऊ पथरा के सेवा करथें।” पर तुम्हर मन म जऊन बात हवय, ओह कभू पूरा नइं होवय। <verse eid="EZK 20:32"/><verse number="33" style="v" sid="EZK 20:33"/>मोर जिनगी के कसम, परमपरधान यहोवा ह घोसना करत हे, में सक्तिसाली हांथ अऊ बढ़ाय हुए बाहां अऊ भड़के हुए कोप के संग तुम्हर ऊपर सासन करहूं। <verse eid="EZK 20:33"/><verse number="34" style="v" sid="EZK 20:34"/>मेंह तुमन ला ओ जाति-जाति के मनखेमन के बीच म ले लानहूं अऊ ओ देसमन ले लानके तुमन ला इकट्ठा करहूं, जिहां तुमन तितिर-बितिर हो गे हव—मेंह तुमन ला सक्तिसाली हांथ अऊ बढ़ाय हुए बाहां अऊ भड़के हुए कोप के संग इकट्ठा करहूं। <verse eid="EZK 20:34"/><verse number="35" style="v" sid="EZK 20:35"/>मेंह तुमन ला जाति-जाति के मनखेमन के निरजन जगह म ले आहूं अऊ उहां, आमने-सामने मेंह तुम्हर नियाय करहूं। <verse eid="EZK 20:35"/><verse number="36" style="v" sid="EZK 20:36"/>जऊन किसम ले, मेंह मिसर देस के सुन्ना जगह म तुम्हर पुरखामन के नियाय करे रहेंव, ओही किसम ले, मेंह तुम्हर नियाय करहूं, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 20:36"/><verse number="37" style="v" sid="EZK 20:37"/>जब तुमन मोर लउठी के अधीन होके चलहू, त मोर धियान तुम्हर ऊपर रहिही, अऊ में तुमन ला करार के बंधना म बांधहू। <verse eid="EZK 20:37"/><verse number="38" style="v" sid="EZK 20:38"/>मेंह तुमन ला ओमन ले हटाके सुध करहूं, जेमन मोर बिरूध बिदरोह अऊ अपराध करथें। हालाकि मेंह ओमन ला ओ देस ले निकालके लानहूं, जिहां ओमन रहत हवंय, तभो ले ओमन इसरायल देस म नइं जाय सकहीं। तब तुमन जानहू कि मेंह यहोवा अंव।<verse eid="EZK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="EZK 20:39"/>“ ‘हे इसरायल के मनखेमन, जहां तक तुम्हर बात ए, परमपरधान यहोवा ह ये कहत हे: तुमन म ले हर एक जन जावव अऊ अपन-अपन मूरतीमन के सेवा करव! पर बाद म तुमन मोर बात ला जरूर सुनहू अऊ मोर पबितर नांव ला अपन भेंट अऊ मूरतीमन के दुवारा फेर अपबितर नइं करहू। <verse eid="EZK 20:39"/><verse number="40" style="v" sid="EZK 20:40"/>काबरकि परमपरधान यहोवा ह घोसना करत हे, मोर पबितर पहाड़, इसरायल के ऊंचहा पहाड़ ऊपर, उहां देस म, इसरायल के जम्मो मनखेमन मोर सेवा करहीं, अऊ उहां में ओमन ला स्वीकार करहूं। उहां मेंह तुम्हर भेंट अऊ तुम्हर उत्तम चीजमन ला तुम्हर जम्मो पबितर बलिदानमन संग लूहूं। <verse eid="EZK 20:40"/><verse number="41" style="v" sid="EZK 20:41"/>मेंह तुमन ला एक खुसबूवाला धूप के रूप म स्वीकार करहूं, जब में तुमन ला जाति-जाति के मनखेमन के बीच ले निकाल लानहूं अऊ ओ देसमन ले तुमन ला इकट्ठा करहूं, जिहां तुमन तितिर-बितिर हो गे हवव, अऊ में जाति-जाति के मनखेमन के नजर म तुम्हर जरिये पबितर ठहिराय जाहूं। <verse eid="EZK 20:41"/><verse number="42" style="v" sid="EZK 20:42"/>तब तुमन जानहू कि मेंह यहोवा अंव, जब में तुमन ला इसरायल देस म ले आहूं, ओ देस जेला मेंह तुम्हर पुरखामन ला देय बर हांथ उठाके सपथ खाय रहेंव। <verse eid="EZK 20:42"/><verse number="43" style="v" sid="EZK 20:43"/>उहां तुमन अपन चालचलन अऊ अपन जम्मो काममन ला सुरता करहू, जेमन के दुवारा तुमन अपनआप ला असुध करे हव, अऊ अपन दुवारा करे गय जम्मो दुस्ट काममन के कारन, तुमन अपनआप ले घिन करहू। <verse eid="EZK 20:43"/><verse number="44" style="v" sid="EZK 20:44"/>हे इसरायल के मनखेमन, जब मेंह तुम्हर दुस्ट काम अऊ तुम्हर खराप चालचलन के मुताबिक नइं, पर अपन नांव के हित म तुमन ले बरताव करहूं, तब तुमन जानहू कि मेंह यहोवा अंव, परमपरधान यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 20:44"/></para>
  <para style="s1">दक्खिन के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="45" style="v" sid="EZK 20:45"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 20:45"/><verse number="46" style="v" sid="EZK 20:46"/>“हे मनखे के बेटा, अपन मुहूं ला दक्खिन कोति कर; दक्खिन के बिरोध म परचार कर, अऊ दक्खिन देस के जंगल के बिरूध अगमबानी कर। <verse eid="EZK 20:46"/><verse number="47" style="v" sid="EZK 20:47"/>दक्खिन के जंगल ला कह: ‘यहोवा के बचन ला सुनव। परमपरधान यहोवा ह ये कहत हे: मेंह तोर म आगी लगानेचवाला हंव, अऊ येह तोर हरियर अऊ सूखा जम्मो रूखमन ला जलाके नास कर दीही। धधकत जुवाला ह नइं बुताही, अऊ दक्खिन ले लेके उत्तर तक हर चेहरा येकर कारन झुलस जाही। <verse eid="EZK 20:47"/><verse number="48" style="v" sid="EZK 20:48"/>हर एक जन ह देखही कि में यहोवा ह येमा आगी लगाय हंव; येह नइं बुताही।’ ”<verse eid="EZK 20:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="EZK 20:49"/>तब मेंह कहेंव, “हे परमपरधान यहोवा, ओ मनखेमन मोर बारे म कहत हें, ‘का ओह सिरिप पटंतर ही नइं कहत हे?’ ”<note caller="+" style="f"><char style="fr" closed="false">20:49 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="EZK 20:45-49">20:45‑49</ref></char> ला 21:1‑5 गने गे हवय</char></note><verse eid="EZK 20:49"/></para>
  <chapter eid="EZK 20"/>
  <chapter number="21" style="c" sid="EZK 21"/>
  <para style="s1">बेबिलोन ह परमेसर के नियाय के तलवार के रूप म</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 21:1"/>यहोवा के बचन ह मोर मेर आईस: <verse eid="EZK 21:1"/><verse number="2" style="v" sid="EZK 21:2"/>“हे मनखे के बेटा, अपन चेहरा ला यरूसलेम के बिरूध कर अऊ पबितर-स्थान के बिरूध परचार कर। इसरायल देस के बिरूध अगमबानी कर <verse eid="EZK 21:2"/><verse number="3" style="v" sid="EZK 21:3"/>अऊ ओला कह: ‘यहोवा ह ये कहत हे: मेंह तोर बिरूध म हंव। मेंह अपन तलवार मियान ले खींचके तोर म ले धरमी अऊ दुस्ट दूनों ला नास करहूं। <verse eid="EZK 21:3"/><verse number="4" style="v" sid="EZK 21:4"/>काबरकि मेंह धरमी अऊ दुस्टमन ला मार डालनेवाला हंव, एकरसेति मोर तलवार ह दक्खिन ले लेके उत्तर तक जम्मो मनखेमन के बिरूध मियान ले निकलही। <verse eid="EZK 21:4"/><verse number="5" style="v" sid="EZK 21:5"/>तब जम्मो मनखेमन जानहीं कि में यहोवा ह मियान म ले अपन तलवार ला निकाले हंव; येह फेर मियान म नइं रखे जाही।’<verse eid="EZK 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 21:6"/>“एकरसेति हे मनखे के बेटा! तेंह कलहर! टूटे हिरदय अऊ बहुंत दुखी होके ओमन के आघू म कलहर। <verse eid="EZK 21:6"/><verse number="7" style="v" sid="EZK 21:7"/>अऊ जब ओमन तोर ले पुछंय, ‘तेंह काबर कलहरत हस?’ त तेंह कहिबे, ‘ओ खबर के कारन, जऊन ह मोला मिले हवय। हर एक के हिरदय ह डर ले भर जाही अऊ हर एक के हांथ ढीला पड़ जाही; हर एक के आतमा ह दुखी होही अऊ हर एक के टांग ह पेसाब के कारन गीला हो जाही।’ येह आवत हे! येह जरूर होही, परमपरधान यहोवा ह घोसना करत हे।”<verse eid="EZK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 21:8"/>यहोवा के बचन ह मोर मेर आईस: <verse eid="EZK 21:8"/><verse number="9" style="v" sid="EZK 21:9"/>“हे मनखे के बेटा, अगमबानी करके कह, ‘परभू ह ये कहत हे:</para>
  <para style="q1" vid="EZK 21:9">“ ‘एक तलवार, एक तलवार,</para>
  <para style="q2" vid="EZK 21:9">धारवाला अऊ चमकत—<verse eid="EZK 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 21:10"/>मार डारे बर धारदार,</para>
  <para style="q2" vid="EZK 21:10">बिजली के अंजोर असन चमकत!</para>
  <para style="p" vid="EZK 21:10">“ ‘का हमन मोर राजसी बेटा के राजदंड ऊपर आनंद मनावन? तलवार ह अइसने हर एक लउठी ला तुछ समझथे।<verse eid="EZK 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 21:11"/>“ ‘तलवार ला चमकाय बर,</para>
  <para style="q2" vid="EZK 21:11">अऊ हांथ ले पकड़े बर देय गे हवय;</para>
  <para style="q1" vid="EZK 21:11">येला धारदार बनाय अऊ चमकाय गे हवय,</para>
  <para style="q2" vid="EZK 21:11">अऊ मार डालनेवाला के हांथ म देय बर तियार करे गे हवय।<verse eid="EZK 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 21:12"/>हे मनखे के बेटा, रो अऊ बिलाप कर,</para>
  <para style="q2" vid="EZK 21:12">काबरकि ये तलवार मोर मनखेमन के बिरूध हवय;</para>
  <para style="q2" vid="EZK 21:12">येह इसरायल के जम्मो हाकिममन के बिरूध हवय।</para>
  <para style="q1" vid="EZK 21:12">ओमन ला मोर मनखेमन के संग</para>
  <para style="q2" vid="EZK 21:12">तलवार के आघू म फटिक देय गे हवय।</para>
  <para style="q1" vid="EZK 21:12">एकरसेति अपन छाती ला पीट।<verse eid="EZK 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 21:13"/>“ ‘परखे के समय ह जरूर आही। अऊ यदि राजदंड ह नइं रहिही, जेला तलवार ह तुछ समझथे, त का होही? परमपरधान यहोवा ह घोसना करत हे।’<verse eid="EZK 21:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 21:14"/>“एकरसेति, हे मनखे के बेटा, अगमबानी कर</para>
  <para style="q2" vid="EZK 21:14">अऊ हांथ ऊपर हांथ मार।</para>
  <para style="q1" vid="EZK 21:14">तलवार ह दू बार,</para>
  <para style="q2" vid="EZK 21:14">बरन तीन बार घात करय।</para>
  <para style="q1" vid="EZK 21:14">ये तलवार ह घात करे बर अय—</para>
  <para style="q2" vid="EZK 21:14">मनखेमन ला जम्मो कोति ले घेरके</para>
  <para style="q2" vid="EZK 21:14">ये तलवार ह बहुंत घात करे बर अय।<verse eid="EZK 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 21:15"/>ताकि ओमन के हिरदय ह डर ले भर जावय</para>
  <para style="q2" vid="EZK 21:15">अऊ बहुंत जन भुइयां म गिरंय,</para>
  <para style="q1" vid="EZK 21:15">मेंह ओमन के जम्मो दुवारमन म</para>
  <para style="q2" vid="EZK 21:15">घात करे बर तलवार ठहिराय हंव।</para>
  <para style="q1" vid="EZK 21:15">देखव! बिजली सहीं चोट करे बर येला गढ़े गे हवय,</para>
  <para style="q2" vid="EZK 21:15">येला घात करे बर उठाय जाथे।<verse eid="EZK 21:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 21:16"/>हे तलवार, जेवनी कोति काट,</para>
  <para style="q2" vid="EZK 21:16">फेर डेरी कोति,</para>
  <para style="q2" vid="EZK 21:16">जेति घलो तोर धार ह मुड़य, ओती काट।<verse eid="EZK 21:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 21:17"/>मेंह घलो अपन हांथमन ला एक संग मारहूं,</para>
  <para style="q2" vid="EZK 21:17">अऊ मोर कोप ह सांत हो जाही।</para>
  <para style="q1" vid="EZK 21:17">में यहोवा ह ये कहे हवंव।”<verse eid="EZK 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 21:18"/>यहोवा के बचन ह मोर मेर आईस: <verse eid="EZK 21:18"/><verse number="19" style="v" sid="EZK 21:19"/>“हे मनखे के बेटा, बेबिलोन के राजा के तलवार ला ले जाय बर दू ठन रसता ला चुन ले; दूनों रसता एकेच देस ले सुरू होवंय। जिहां ले भी एक अलग रसता सहर कोति निकलथे, उहां एक डहार बतइया चिनहां लगावव। <verse eid="EZK 21:19"/><verse number="20" style="v" sid="EZK 21:20"/>एक ठन रसता ला अमोनीमन के रब्बा के बिरूध तलवार के आय बर अऊ दूसर रसता ला यहूदा अऊ गढ़वाला सहर यरूसलेम के बिरूध चुन ले। <verse eid="EZK 21:20"/><verse number="21" style="v" sid="EZK 21:21"/>काबरकि बेबिलोन के राजा ह दुबट्टा म याने कि दूनों रसता के संगम के जगह म सकुन जाने बर रूकही: ओह तीरमन के संग चिट्ठी डालही, ओह अपन मूरतीमन ले सलाह लीही, ओह करेजा के जांच करही। <verse eid="EZK 21:21"/><verse number="22" style="v" sid="EZK 21:22"/>ओकर जेवनी हांथ म यरूसलेम बर चिट्ठी निकलही कि कहां ओह लड़ई के मसीन लगावय, ताकि घात करे के हुकूम देवय, लड़ई के अवाज के ललकार करवाय, दुवारमन करा लड़ई के मसीन लगावय, लड़ई बर ढलान बनावय अऊ घेराबंदी के काम करवाय। <verse eid="EZK 21:22"/><verse number="23" style="v" sid="EZK 21:23"/>येह ओ मनखेमन बर एक गलत सकुन जान पड़ही, जेमन ओकर ले राजभक्ति के सपथ खाय हवंय, पर ओह ओमन ला ओमन के अपराध ला सुरता कराही अऊ ओमन ला बंदी बनाके ले जाही।<verse eid="EZK 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 21:24"/>“एकरसेति परमपरधान यहोवा ह ये कहत हे: ‘काबरकि तुमन अपन करे गय जम्मो पाप ला परगट करके, अपन खुलेआम बिदरोह के दुवारा अपन अपराध ला सुरता करे हवव—काबरकि तुमन ये करे हवव, एकरसेति तुमन ला बंदी बना लिये जाही।<verse eid="EZK 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 21:25"/>“ ‘हे इसरायल के असुध अऊ दुस्ट हाकिम, तोर दिन ह आ गे हवय, तोला दंड देय के आखिरी बेरा आ गे हवय, <verse eid="EZK 21:25"/><verse number="26" style="v" sid="EZK 21:26"/>परमपरधान यहोवा ह ये कहत हे: अपन पगड़ी ला उतार, मुकुट ला घलो उतार। जइसने पहिले रिहिस, वइसने अब नइं रहय: छोटे दरजा के मनखेमन ऊंचहा करे जाहीं अऊ ऊंचहा दरजा के मनखेमन खाल्हे करे जाहीं। <verse eid="EZK 21:26"/><verse number="27" style="v" sid="EZK 21:27"/>बिनास! बिनास! मेंह येकर बिनास कर दूहूं! मुकुट ला वापिस नइं दिये जावय, जब तक कि ओह नइं आ जाही, जऊन ह येकर सही म हकदार ए; तब येला में ओला दे दूहूं।’<verse eid="EZK 21:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 21:28"/>“अऊ तें, हे मनखे के बेटा, अगमबानी करके कह, ‘परमपरधान यहोवा ह अमोनी अऊ ओमन के बेजत्ती के बारे म ये कहत हे:</para>
  <para style="q1" vid="EZK 21:28">“ ‘एक तलवार, एक तलवार,</para>
  <para style="q2" vid="EZK 21:28">घात करे बर निकाले गे हवय,</para>
  <para style="q1" vid="EZK 21:28">नास करे बर चमकाय गे हवय</para>
  <para style="q2" vid="EZK 21:28">अऊ बिजली असन चमकय!<verse eid="EZK 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZK 21:29"/>तुम्हर बारे म लबरा दरसन</para>
  <para style="q2" vid="EZK 21:29">अऊ लबरा सकुन-बिचार के बावजूद,</para>
  <para style="q1" vid="EZK 21:29">तलवार ह ओ दुस्टमन के घेंच म रखे जाही,</para>
  <para style="q2" vid="EZK 21:29">जेमन ला घात करे जाना हे,</para>
  <para style="q1" vid="EZK 21:29">जेमन के दिन ह आ गे हवय,</para>
  <para style="q2" vid="EZK 21:29">जेमन ला दंड देय के आखिरी समय आ गे हवय।<verse eid="EZK 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="EZK 21:30"/>“ ‘तलवार ला ओकर मियान म रखे जावय।</para>
  <para style="q2" vid="EZK 21:30">ओ जगह जिहां तुमन सिरजे गेव,</para>
  <para style="q1" vid="EZK 21:30">तुम्हर पुरखामन के देस म,</para>
  <para style="q2" vid="EZK 21:30">मेंह तुम्हर नियाय करहूं।<verse eid="EZK 21:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZK 21:31"/>तुम्हर ऊपर मोर कोप ह भड़कही</para>
  <para style="q2" vid="EZK 21:31">अऊ मोर भयंकर कोरोध तुम्हर ऊपर आही;</para>
  <para style="q1" vid="EZK 21:31">मेंह तुमन ला अइसने निरदयी मनखेमन के हांथ म दे दूहूं,</para>
  <para style="q2" vid="EZK 21:31">जेमन बिनास करे म माहिर अंय।<verse eid="EZK 21:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="EZK 21:32"/>तुमन आगी ला जलाय के चीज हो जाहू,</para>
  <para style="q2" vid="EZK 21:32">तुम्हर खून ह तुम्हर देस म गिरही,</para>
  <para style="q2" vid="EZK 21:32">तुमन ला फेर सुरता नइं करे जाही;</para>
  <para style="q1" vid="EZK 21:32">काबरकि में यहोवा ह कहे हवंव।’ ”<verse eid="EZK 21:32"/></para>
  <chapter eid="EZK 21"/>
  <chapter number="22" style="c" sid="EZK 22"/>
  <para style="s1">यरूसलेम के पाप के नियाय</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 22:1"/>यहोवा के बचन ह मोर मेर आईस:<verse eid="EZK 22:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="EZK 22:2"/>“हे मनखे के बेटा, का तेंह ओकर नियाय करबे? का तेंह ये खून बहानेवाला सहर के नियाय करबे? तब ओकर जम्मो घिनौना काममन ला ओला बता <verse eid="EZK 22:2"/><verse number="3" style="v" sid="EZK 22:3"/>अऊ कह: ‘परमपरधान यहोवा ह ये कहत हे: हे सहर, तें अपन बीच खून बहाय के दुवारा अपनआप ला दंड के भागी बनाथस अऊ मूरतीमन ला बनाके अपनआप ला असुध करथस, <verse eid="EZK 22:3"/><verse number="4" style="v" sid="EZK 22:4"/>तेंह दोसी ठहिरे हस काबरकि तेंह खून बहाय हस अऊ तें मूरतीमन ला बनाय के दुवारा असुध हो गे हस। तेंह अपन दिनमन के आखिरी कर ले हस, अऊ तोर बछरमन के अन्त आ गे हवय। एकरसेति मेंह तोला जाति-जाति के मनखेमन बर तिरस्कार के चीज अऊ जम्मो देसमन बर ठट्ठा के चीज बना दूहूं। <verse eid="EZK 22:4"/><verse number="5" style="v" sid="EZK 22:5"/>हे बदनाम सहर, तें उपदरव ले भरे हस। ओ मनखे, जेमन तोर लकठा म हवंय अऊ ओ मनखे, जेमन तोर ले दूरिहा म हवंय, ओ जम्मो झन तोर ठट्ठा करहीं।<verse eid="EZK 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 22:6"/>“ ‘देख, तोर म रहइया इसरायल के हर एक हाकिम ह कइसे अपन सक्ति के उपयोग खून बहाय म करत हे। <verse eid="EZK 22:6"/><verse number="7" style="v" sid="EZK 22:7"/>तोर म रहिके ओमन अपन दाई अऊ ददा ले अपमान के बरताव करे हवंय; तोर म रहिके ओमन परदेसीमन ला सताईन अऊ अनाथ अऊ बिधवा के संग गलत बरताव करे हवंय। <verse eid="EZK 22:7"/><verse number="8" style="v" sid="EZK 22:8"/>तेंह मोर पबितर चीजमन ला तुछ समझे हस अऊ मोर बिसराम दिनमन ला अपबितर करे हस। <verse eid="EZK 22:8"/><verse number="9" style="v" sid="EZK 22:9"/>तोर म निन्दा करइयामन हवंय, जेमन के झुकाव खून बहाय कोति रहिथे; तोर म ओ मनखेमन हवंय, जेमन पहाड़ के पूजा के जगह म खाथें अऊ बेभिचार के काम करथें। <verse eid="EZK 22:9"/><verse number="10" style="v" sid="EZK 22:10"/>तोर म ओ मनखेमन हवंय, जेमन अपन ददा के बिस्तर के अपमान करथें; तोर म ओ मनखेमन हवंय, जेमन माईलोगनमन ले ओमन के महिना के बेरा सारीरिक संबंध बनाथें, जब ओमन असुध रहिथें। <verse eid="EZK 22:10"/><verse number="11" style="v" sid="EZK 22:11"/>तोर म रहिके एक मनखे अपन परोसी के घरवाली के संग घिनौना काम करथे, त दूसर मनखे बेसरम होके अपन बेटा के घरवाली ला असुध करथे, अऊ एक आने मनखे अपन बहिनी, अपन खुद के ददा के बेटी ला भ्रस्ट करथे। <verse eid="EZK 22:11"/><verse number="12" style="v" sid="EZK 22:12"/>तोर म अइसने मनखे हवंय, जेमन हतिया करे बर घूस लेथें; तेंह बियाज लेथस अऊ गरीब मनखे ले लाभ कमाथस। तेंह अपन परोसीमन ले जबरदस्ती छीनके अनियाय के कमई करथस। अऊ तेंह मोला भुला गे हस, परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 22:13"/>“ ‘तेंह अनियाय ले जऊन कमई करे हस अऊ अपन बीच म तेंह जऊन खून बहाय हस, ओकर कारन मेंह अपन दूनों हांथ एक संग चलाहूं। <verse eid="EZK 22:13"/><verse number="14" style="v" sid="EZK 22:14"/>ओ दिन का तोर म हिम्मत होही या तोर हांथमन मजबूत होहीं, जब में तोर ले लेखा लूहूं? में यहोवा ह ये कहे हवंव, अऊ में येला करके ही रहिहूं। <verse eid="EZK 22:14"/><verse number="15" style="v" sid="EZK 22:15"/>मेंह तोर मनखेमन ला जाति-जाति के मनखेमन के बीच तितिर-बितिर कर दूहूं, अऊ देस-देस म बगरा दूहूं; अऊ मेंह तोर असुधता ला खतम कर दूहूं। <verse eid="EZK 22:15"/><verse number="16" style="v" sid="EZK 22:16"/>जब तें जाति-जाति के मनखेमन के नजर म असुध हो जाबे; तब तें जानबे कि मेंह यहोवा अंव।’ ”<verse eid="EZK 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 22:17"/>तब यहोवा के बचन मोर मेर आईस: <verse eid="EZK 22:17"/><verse number="18" style="v" sid="EZK 22:18"/>“हे मनखे के बेटा, इसरायल के मनखेमन मोर बर मईल हो गे हवंय; ओ जम्मो झन भट्ठी के भीतर छोंड़े गय तांबा, टीन, लोहा अऊ सीसा अंय। ओमन चांदी के मईल असन हो गे हवंय। <verse eid="EZK 22:18"/><verse number="19" style="v" sid="EZK 22:19"/>एकरसेति परमपरधान यहोवा ह ये कहत हे: ‘काबरकि तुमन जम्मो के जम्मो धातु के मईल असन हो गे हवव, एकरसेति मेंह तुमन ला यरूसलेम म इकट्ठा करहूं। <verse eid="EZK 22:19"/><verse number="20" style="v" sid="EZK 22:20"/>जइसने चांदी, तांबा, लोहा, सीसा अऊ टीन ला भट्ठी म इकट्ठा करके धधकत आगी म टघलाय जाथे, वइसने ही मेंह तुमन ला अपन कोरोध अऊ कोप म आके इकट्ठा करहूं अऊ तुमन ला सहर के भीतर डालके टघलाहूं। <verse eid="EZK 22:20"/><verse number="21" style="v" sid="EZK 22:21"/>मेंह तुमन ला संकेलहूं अऊ बहुंत कोप म आके तुम्हर ऊपर फूंक मारहूं, अऊ तुमन ओकर भीतर टघल जाहू। <verse eid="EZK 22:21"/><verse number="22" style="v" sid="EZK 22:22"/>जइसने चांदी ह भट्ठी म टघल जाथे, वइसने ही तुमन ओकर भीतर टघल जाहू, अऊ तब तुमन जानहू कि में यहोवा ह तुम्हर ऊपर कोप उंडेले हंव।’ ”<verse eid="EZK 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 22:23"/>यहोवा के बचन ह फेर मोर मेर आईस: <verse eid="EZK 22:23"/><verse number="24" style="v" sid="EZK 22:24"/>“हे मनखे के बेटा, ओ देस ले कह, ‘तेंह एक अइसन देस अस, जेला सुध नइं करे गे हवय या कोप के दिन म जेकर ऊपर बारिस नइं होय हवय।’ <verse eid="EZK 22:24"/><verse number="25" style="v" sid="EZK 22:25"/>जइसे गरजत सेर ह अपन सिकार ला चीरथे, वइसे ही ओकर भीतर ओकर राजकुमारमन<note caller="+" style="f"><char style="fr" closed="false">22:25 </char><char style="ft" closed="false">सेप्टाजिन्ट; इबरानी म </char><char style="fqa" closed="false">अगमजानीमन</char></note> एक साजिस करत हें; ओमन मनखेमन ला मार डालथें, अऊ ओमन खजाना अऊ कीमती चीजमन ला ले लेथें अऊ ओकरे भीतर बहुंते माईलोगन ला बिधवा बना देथें। <verse eid="EZK 22:25"/><verse number="26" style="v" sid="EZK 22:26"/>ओ देस के पुरोहितमन मोर कानून ला टोरथें अऊ मोर पबितर चीजमन ला अपबितर करथें; ओमन पबितर अऊ सधारन चीजमन के बीच कोनो भेद नइं करंय; ओमन सिखाथें कि सुध अऊ असुध म कोनो भेद नइं ए; अऊ ओमन मोर बिसराम दिनमन ला माने बर ढिलई करथें, जेकर कारन मेंह ओमन के बीच अपबितर ठहिरथंव। <verse eid="EZK 22:26"/><verse number="27" style="v" sid="EZK 22:27"/>ओकर भीतर ओकर करमचारीमन ओ भेड़ियामन सहीं अंय, जेमन अपन सिकार ला फार खाथें; ओमन खून बहाथें अऊ अनियाय करके फायदा उठाय बर मनखेमन ला मार डालथें। <verse eid="EZK 22:27"/><verse number="28" style="v" sid="EZK 22:28"/>ओकर अगमजानीमन लबरा दरसन अऊ लबरा सकुन बिचारे के दुवारा ओमन बर ये काममन ऊपर लीपा-पोती करथें। ओमन कहिथें, ‘परमपरधान यहोवा ह ये कहत हे’—जबकि यहोवा ह नइं कहे रहय। <verse eid="EZK 22:28"/><verse number="29" style="v" sid="EZK 22:29"/>देस के मनखेमन जबरदस्ती छीन लेथें अऊ लूट-पाट करथें; ओमन गरीब अऊ जरूरतमंद मनखेमन ऊपर अतियाचार करथें अऊ परदेसी के संग अनियाय करके ओमन ले गलत बरताव करथें।<verse eid="EZK 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 22:30"/>“मेंह ओमन के बीच एक अइसने मनखे ला खोजत रहेंव, जऊन ह दीवार ला बनावय अऊ ओ देस कोति ले दरार म मोर आघू ठाढ़ होवय, ताकि मोला ओकर नास झन करना पड़य, पर मोला अइसने कोनो मनखे नइं मिलिस। <verse eid="EZK 22:30"/><verse number="31" style="v" sid="EZK 22:31"/>एकरसेति ओमन ऊपर मोर कोप ह भड़कही अऊ मोर भयंकर कोरोध ले ओमन नास हो जाहीं, अऊ ओमन के करे गय जम्मो काम ओहीचमन के मुड़ ऊपर आही, परमपरधान यहोवा ह घोसना करत हे।”<verse eid="EZK 22:31"/></para>
  <chapter eid="EZK 22"/>
  <chapter number="23" style="c" sid="EZK 23"/>
  <para style="s1">दू झन बेभिचारिन बहिनीमन</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 23:1"/>यहोवा के बचन ह मोर मेर आईस: <verse eid="EZK 23:1"/><verse number="2" style="v" sid="EZK 23:2"/>“हे मनखे के बेटा, दू झन माईलोगन रिहिन, जेमन एकेच दाई के बेटी रिहिन। <verse eid="EZK 23:2"/><verse number="3" style="v" sid="EZK 23:3"/>ओमन मिसर देस म बेस्या बन गीन अऊ अपन जवानी के समय ले बेस्या के काम करत रिहिन। ओ देस म ओमन के छाती मिंजे गीस अऊ ओमन के कुंवारी छातीमन ले मया करे गीस। <verse eid="EZK 23:3"/><verse number="4" style="v" sid="EZK 23:4"/>बड़े बहिनी के नांव ओहोला अऊ छोटे बहिनी के नांव ओहोलीबा रिहिस। ओमन मोर रिहिन अऊ ओमन बेटा-बेटीमन ला जनम दीन। ओहोला ह सामरिया अय, अऊ ओहोलीबा ह यरूसलेम अय।<verse eid="EZK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 23:5"/>“ओहोला ह मोर रिहिस, तभे बेस्या के काम करे लगिस; अऊ ओह अपन मया करइया अस्सूरीमन ऊपर मोहित रिहिस—जेमन सैनिक रिहिन, <verse eid="EZK 23:5"/><verse number="6" style="v" sid="EZK 23:6"/>जेमन नीला कपड़ा पहिरे रहंय, राजपाल अऊ सेनापतिमन, ये जम्मो के जम्मो सुघर जवान, अऊ घुड़सवार रिहिन। <verse eid="EZK 23:6"/><verse number="7" style="v" sid="EZK 23:7"/>ओह अपनआप ला बेस्या के रूप म सबले बने अस्सूरीमन ला दे दीस अऊ ओ हर एक मूरतीमन ले अपनआप ला असुध करिस, जेकर पाछू ओह मोहित रहय। <verse eid="EZK 23:7"/><verse number="8" style="v" sid="EZK 23:8"/>जऊन बेस्या के काम ओह मिसर देस म सुरू करे रिहिस, ओला ओह नइं छोंड़िस, जब ओकर जवानी के समय म आदमीमन ओकर संग सुतंय, ओकर कुंवारी छाती ला दुलारंय अऊ अपन काम-वासना ओकर ऊपर लुटावंय।<verse eid="EZK 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 23:9"/>“एकरसेति मेंह ओला ओकर मयारू, अस्सूरीमन के हांथ म सऊंप देंव, जेमन ऊपर ओह मोहा गे रिहिस। <verse eid="EZK 23:9"/><verse number="10" style="v" sid="EZK 23:10"/>ओमन ओला नंगरी कर दीन, ओकर बेटा-बेटीमन ला ले लीन अऊ ओला तलवार ले मार डालिन। ओह माईलोगनमन के बीच एक कहावत बन गीस अऊ ओला दंड दिये गीस।<verse eid="EZK 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 23:11"/>“ओकर बहिनी ओहोलीबा ह येला देखिस, तभो ले ओह काम-वासना अऊ बेस्या के काम म अपन बहिनी ले घलो जादा गिर गे रिहिस। <verse eid="EZK 23:11"/><verse number="12" style="v" sid="EZK 23:12"/>ओह घलो अस्सूरीमन के पाछू मोहा गे रिहिस—जेमा राजपाल अऊ सेनापति, पूरा पोसाक पहिरे योद्धा, घुड़सवार अऊ जम्मो सुघर जवान आदमीमन रिहिन। <verse eid="EZK 23:12"/><verse number="13" style="v" sid="EZK 23:13"/>मेंह देखेंव कि ओह घलो अपनआप ला असुध कर ले रिहिस; ओ दूनों बहिनी के चालचलन एक सहीं रिहिस।<verse eid="EZK 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 23:14"/>“पर ओहोलीबा जादा बेभिचार करत गीस। ओह दीवारमन म आदमीमन के चित्र बने हुए देखिस, कसदीमन<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बेबिलोनीमन</char></note> के चित्र लाल रंग म बने रहय, <verse eid="EZK 23:14"/><verse number="15" style="v" sid="EZK 23:15"/>चित्र म मनखेमन के कनिहां म पट्टा बंधे रहय अऊ ओमन के मुड़ म लहरावत पगड़ी रहय; ओ जम्मो के जम्मो कसदीया के रहइया बेबिलोनी रथ के अधिकारीमन सहीं दिखत रहंय। <verse eid="EZK 23:15"/><verse number="16" style="v" sid="EZK 23:16"/>ओह ओमन ला देखत ही ओमन के पाछू लालायित हो गीस अऊ कसदीया म ओमन करा संदेसियामन ला पठोईस। <verse eid="EZK 23:16"/><verse number="17" style="v" sid="EZK 23:17"/>तब बेबिलोनीमन मया म ओकर संग सुते बर आईन, अऊ अपन काम-वासना म ओला असुध करिन। ओमन के दुवारा असुध होय के बाद, ओह घिन म ओमन ले अलग हो गीस। <verse eid="EZK 23:17"/><verse number="18" style="v" sid="EZK 23:18"/>जब ओह खुलेआम बेस्या के काम करे लगिस अऊ अपन नंगरी देहें ला देखाय लगिस, त मेंह घिन करके ओकर ले दूरिहा हो गेंव, जइसे कि मेंह ओकर बहिनी ले दूरिहा हो गे रहेंव। <verse eid="EZK 23:18"/><verse number="19" style="v" sid="EZK 23:19"/>तभो ले ओह अऊ जादा दुराचारी होवत गीस, अपन जवानी के दिनमन ला सुरता करत, जब ओह मिसर देस म एक बेस्या रिहिस। <verse eid="EZK 23:19"/><verse number="20" style="v" sid="EZK 23:20"/>उहां ओह अपन ओ यारमन के पाछू काम-वासना बर लगे रहय, जेमन के जननांग गदहामन के जननांग सहीं अऊ ओमन के बीर्य घोड़ामन कस रहय। <verse eid="EZK 23:20"/><verse number="21" style="v" sid="EZK 23:21"/>ये किसम ले, तें अपन जवानी के कामुकता के लालसा करत रहय, जब मिसर म तोर छाती ला दुलारे जावय अऊ तोर जवान थन ले लाड़ करे जावय।<verse eid="EZK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 23:22"/>“एकरसेति हे ओहोलीबा, परमपरधान यहोवा ह ये कहत हे: मेंह तोर मयारूमन ला तोर बिरूध भड़काहूं, जेमन ले तें घिन करत दूरिहा हो गे रहय, अऊ में चारों कोति ले ओमन ला तोर बिरूध लानहूं— <verse eid="EZK 23:22"/><verse number="23" style="v" sid="EZK 23:23"/>बेबिलोनीमन अऊ जम्मो कसदीमन, पकोद, सोआ अऊ कोआ के आदमीमन, अऊ ओमन के संग जम्मो अस्सूरी सुघर जवान, ओमा जम्मो के जम्मो राजपाल अऊ सेनापति, रथ के अधिकारी अऊ बड़े अधिकारी, जम्मो के जम्मो घोड़ा म सवार हवंय। <verse eid="EZK 23:23"/><verse number="24" style="v" sid="EZK 23:24"/>ओमन तोर बिरूध हथियार, रथ अऊ चार पहिया गाड़ी लेके मनखेमन के भीड़ के संग आहीं; ओमन चारों कोति ले छोटे अऊ बड़े ढाल के संग मुड़ म टोपा पहिरके तोर बिरूध मोरचा बांधहीं। मेंह तोला सजा देय बर ओमन के हांथ म सऊंप दूहूं, अऊ ओमन अपन हिसाब से तोला सजा दीहीं। <verse eid="EZK 23:24"/><verse number="25" style="v" sid="EZK 23:25"/>मेंह तोर ऊपर अपन जलन ले भरे कोरोध देखाहूं, ओमन कोरोध म आके तोर ले बरताव करहीं। ओमन तोर नाक अऊ कान ला काट डारहीं, अऊ तुमन म जेमन बांच जाहीं, ओमन तलवार ले मारे जाहीं। ओमन तोर बेटा अऊ बेटीमन ला ले जाहीं, अऊ तोर म जेमन बांच जाहीं, ओमन आगी ले जलके नास हो जाहीं। <verse eid="EZK 23:25"/><verse number="26" style="v" sid="EZK 23:26"/>ओमन तोर ओनहा ला घलो उतार लीहीं अऊ तोर सुघर जेवर ला छीनके ले जाहीं। <verse eid="EZK 23:26"/><verse number="27" style="v" sid="EZK 23:27"/>ये किसम ले मेंह ओ काम-वासना अऊ बेस्या के काम ला बंद कर दूहूं, जेला तेंह मिसर देस म सुरू करे रहय। तेंह ये चीजमन के ईछा नइं करबे या मिसर देस ला फेर सुरता नइं करबे।<verse eid="EZK 23:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 23:28"/>“काबरकि परमपरधान यहोवा ह ये कहत हे: मेंह तोला ओमन के हांथ म सऊंपनेच वाला हंव, जेमन ले तेंह घिन करथस अऊ घिन करे के कारन जेमन ले दूरिहा हो गे रहय। <verse eid="EZK 23:28"/><verse number="29" style="v" sid="EZK 23:29"/>ओमन तोर संग घिनौना बरताव करहीं अऊ तोर कमाय जम्मो चीज ला ले लीहीं। ओमन तोला एकदम नंगरी करके छोंड़ दीहीं, अऊ तोर बेस्या के काम के पाप ह परगट हो जाही। तोर नंगरीपन अऊ दुराचार के कारन <verse eid="EZK 23:29"/><verse number="30" style="v" sid="EZK 23:30"/>ये सब तोर संग होय हवय, काबरकि तेंह जाति-जाति के मनखेमन के पाछू काम-वासना बर भागे अऊ ओमन के मूरतीमन ले तेंह अपनआप ला असुध करे। <verse eid="EZK 23:30"/><verse number="31" style="v" sid="EZK 23:31"/>तेंह अपन बहिनी के चाल म चले हस; एकरसेति मेंह ओकर कटोरा<note caller="+" style="f"><char style="fr" closed="false">23:31 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">दंड के कटोरा</char></note> ला तोर हांथ म दूहूं।<verse eid="EZK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 23:32"/>“परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 23:32">“तेंह अपन बहिनी के कटोरा ले पीबे,</para>
  <para style="q2" vid="EZK 23:32">जऊन ह बड़े अऊ गहिला हवय;</para>
  <para style="q1" vid="EZK 23:32">येह तोर ऊपर हंसी अऊ ठट्ठा के बात लानही</para>
  <para style="q2" vid="EZK 23:32">काबरकि ये कटोरा म बहुंत कुछू धरे जाथे।<verse eid="EZK 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 23:33"/>तेंह मतवारपन अऊ दुख ले भर जाबे,</para>
  <para style="q2" vid="EZK 23:33">येह बिनास अऊ सुनापन के कटोरा ए,</para>
  <para style="q2" vid="EZK 23:33">येह तोर बहिनी सामरिया के कटोरा ए।<verse eid="EZK 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 23:34"/>तेंह येमा ले पीबे अऊ येला खाली कर देबे</para>
  <para style="q2" vid="EZK 23:34">अऊ येकर टुकड़ामन ला चाबबे—</para>
  <para style="q2" vid="EZK 23:34">अऊ अपन छाती ला घायल करबे।</para>
  <para style="m" vid="EZK 23:34">मेंह ये कहे हवंव, परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 23:34"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="35" style="v" sid="EZK 23:35"/>“एकरसेति परमपरधान यहोवा ह ये कहत हे: जब तेंह मोला भुला गे हस अऊ मोर ले अपन मुहूं ला मोड़ ले हस, त जरूरी अय कि तेंह अपन काम-वासना अऊ बेस्या के काम के परतिफल ला भुगतबे।”<verse eid="EZK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 23:36"/>यहोवा ह मोर ले कहिस: “हे मनखे के बेटा, का तें ओहोला अऊ ओहोलीबा के नियाय करबे? त फेर ओमन के घिनौना काम ओमन ला बता दे, <verse eid="EZK 23:36"/><verse number="37" style="v" sid="EZK 23:37"/>काबरकि ओमन बेभिचार करे हवंय, अऊ ओमन के हांथ म खून लगे हवय। ओमन अपन मूरतीमन के संग म बेभिचार करिन; अऊ त अऊ ओमन अपन लइकामन ला जेवन के रूप म मूरतीमन बर बलिदान करिन, जेमन ला ओमन मोर बर जनमाय रिहिन। <verse eid="EZK 23:37"/><verse number="38" style="v" sid="EZK 23:38"/>ओमन मोर संग अइसने घलो करे हवंय: ओही समय म ओमन मोर पबितर-स्थान ला असुध करिन अऊ मोर बिसराम दिनमन ला अपबितर करे हवंय। <verse eid="EZK 23:38"/><verse number="39" style="v" sid="EZK 23:39"/>जऊन दिन ओमन अपन लइकामन ला अपन मूरतीमन के आघू म बलिदान करिन, ओहीच दिन ओमन मोर पबितर-स्थान म घुसरके ओला अपबितर करिन। ओमन ये किसम के काम मोर भवन म करिन।<verse eid="EZK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="EZK 23:40"/>“अऊ त अऊ ओमन आदमीमन ला बलाय बर दूतमन ला पठोईन, अऊ जब ओमन आ गीन, त तें नहा-धोके अपनआप ला ओमन बर साफ करय, आंखीमन म काजर आंजय अऊ जेवर पहिरय। <verse eid="EZK 23:40"/><verse number="41" style="v" sid="EZK 23:41"/>तें एक सुघर सोफा म बईठेय; जेकर आघू म एक मेज रखे रहय अऊ ओ मेज म तेंह धूप अऊ जैतून तेल ला धरे रहय, जऊन ह मोर रिहिस।<verse eid="EZK 23:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EZK 23:42"/>“ओकर चारों कोति बेफिकर मनखेमन के भीड़ के कोलाहल होवत रिहिस; मतवारमन के संग निरजन जगह के कोलाहल करइया भीड़ ले आदमीमन ला लाने गे रिहिस, अऊ ओमन ओ माईलोगन अऊ ओकर बहिनी के कलई म कंगन अऊ ओमन के मुड़ म सुघर मुकुट पहिराईन। <verse eid="EZK 23:42"/><verse number="43" style="v" sid="EZK 23:43"/>तब मेंह ओकर बारे म कहेंव, जऊन ह बेभिचार करत-करत बेहाल हो गे रिहिस, ‘ओमन ओ माईलोगन के उपयोग एक बेस्या के रूप म करंय, काबरकि ओह एक बेस्या ही तो अय।’ <verse eid="EZK 23:43"/><verse number="44" style="v" sid="EZK 23:44"/>अऊ ओमन ओकर संग सुतिन। जइसने आदमीमन एक बेस्या के संग सुतथें, वइसने ओमन ओ बेभिचारी माईलोगन ओहोला अऊ ओहोलीबा के संग सुतिन। <verse eid="EZK 23:44"/><verse number="45" style="v" sid="EZK 23:45"/>पर धरमी नियायधीसमन ओमन ला ओ माईलोगनमन के दंड दीहीं, जेमन बेभिचार करथें अऊ खून बहाथें, काबरकि ओमन बेभिचारिन अंय अऊ ओमन के हांथ म खून लगे हवय।”<verse eid="EZK 23:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="EZK 23:46"/>“परमपरधान यहोवा ह ये कहत हे: ओमन के बिरूध मनखेमन के एक भीड़ ला ले आवव अऊ ओमन ला आतंकित होय अऊ लूटे जाय बर भीड़ के हांथ म सऊंप दव। <verse eid="EZK 23:46"/><verse number="47" style="v" sid="EZK 23:47"/>ओ भीड़ के मनखेमन ओमन ऊपर पथरवाह करहीं अऊ ओमन ला अपन तलवार ले काट डारहीं; मनखेमन ओमन के बेटा-बेटीमन ला मार डारहीं अऊ ओमन के घरमन ला जला दीहीं।<verse eid="EZK 23:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="EZK 23:48"/>“ये किसम ले मेंह बेभिचार के काम ला देस ले खतम कर दूहूं, ताकि जम्मो माईलोगनमन बर एक चेतउनी होवय अऊ ओमन तोर सहीं काम झन करंय। <verse eid="EZK 23:48"/><verse number="49" style="v" sid="EZK 23:49"/>तुमन ला तुम्हर बेभिचार के सजा मिलही अऊ तुमन ला मूरती-पूजा के पाप के परतिफल भुगतना पड़ही। तब तुमन जानहू कि मेंह परमपरधान यहोवा अंव।”<verse eid="EZK 23:49"/></para>
  <chapter eid="EZK 23"/>
  <chapter number="24" style="c" sid="EZK 24"/>
  <para style="s1">रांधे के बरतन के रूप म यरूसलेम</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 24:1"/>हमर बंधुवई म रहे के नौवां बछर के दसवां महिना के दसवां दिन, यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 24:1"/><verse number="2" style="v" sid="EZK 24:2"/>“हे मनखे के बेटा, आज के दिन, आज के तारिख ला लिख ले, काबरकि आजेच के दिन बेबिलोन के राजा ह यरूसलेम के घेराबंदी करे हवय। <verse eid="EZK 24:2"/><verse number="3" style="v" sid="EZK 24:3"/>ये बिदरोही मनखेमन ला एक पटंतर सुनाके कह: ‘परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 24:3">“ ‘रांधे के बरतन ला मढ़ा; येला चूल्हा म मढ़ा</para>
  <para style="q2" vid="EZK 24:3">अऊ येमा पानी डाल दे।<verse eid="EZK 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 24:4"/>तब येमा मांस के कुटामन ला डाल,</para>
  <para style="q2" vid="EZK 24:4">जम्मो बने-बने कुटामन ला—जांघ अऊ कंधा।</para>
  <para style="q1" vid="EZK 24:4">ये हाड़ामन के बढ़िया भाग ले येला भर दे;<verse eid="EZK 24:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="EZK 24:5"/>झुंड म के सबले बने पसु ला ले।</para>
  <para style="q1" vid="EZK 24:5">ओ हाड़ामन बर बरतन के तरी म लकरी ला बार;</para>
  <para style="q2" vid="EZK 24:5">ओला डबकन दे</para>
  <para style="q2" vid="EZK 24:5">अऊ येमा हाड़ामन ला चुरन दे।<verse eid="EZK 24:5"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="6" style="v" sid="EZK 24:6"/>“ ‘काबरकि परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 24:6">“ ‘खून बहइया सहर ऊपर हाय,</para>
  <para style="q2" vid="EZK 24:6">मुर्चा लगे ओ बरतन ऊपर हाय,</para>
  <para style="q2" vid="EZK 24:6">जेकर मुर्चा ह नइं छूटही!</para>
  <para style="q1" vid="EZK 24:6">मांस ला एक-एक कुटा करके निकालव</para>
  <para style="q2" vid="EZK 24:6">कोनो भी क्रम म कुटामन निकलथें, ओमन ला निकालव।<verse eid="EZK 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 24:7"/>“ ‘काबरकि ओ नगर ह अपन ही बीच म खून बहाय हवय:</para>
  <para style="q2" vid="EZK 24:7">ओह खाली चट्टान म येला रितोय हवय;</para>
  <para style="q1" vid="EZK 24:7">ओह येला भुइयां म नइं रितोय हवय,</para>
  <para style="q2" vid="EZK 24:7">जिहां धुर्रा ह येला तोप लेतिस।<verse eid="EZK 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 24:8"/>कोप ला भड़काय अऊ बदला लेय बर</para>
  <para style="q2" vid="EZK 24:8">मेंह ओकर खून ला खाली चट्टान ऊपर रखें,</para>
  <para style="q2" vid="EZK 24:8">ताकि येला झन तोपे जावय।<verse eid="EZK 24:8"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="9" style="v" sid="EZK 24:9"/>“ ‘एकरसेति परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 24:9">“ ‘खून बहइया सहर ऊपर हाय!</para>
  <para style="q2" vid="EZK 24:9">मेंह घलो लकरी के कुढ़ा ला बड़े करहूं।<verse eid="EZK 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 24:10"/>एकरसेति लकरी के कुढ़ा लगावव,</para>
  <para style="q2" vid="EZK 24:10">अऊ ओमा आगी लगावव।</para>
  <para style="q1" vid="EZK 24:10">मांस म मसाला मिलाके,</para>
  <para style="q2" vid="EZK 24:10">ओला बने करके पकावव;</para>
  <para style="q2" vid="EZK 24:10">अऊ हाड़ामन ला हल्का जलन दव।<verse eid="EZK 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 24:11"/>तब खाली बरतन ला अंगरामन ऊपर मढ़ावव</para>
  <para style="q2" vid="EZK 24:11">जब तक कि येह गरम होके येकर तांबा ह लाल नइं हो जावय,</para>
  <para style="q1" vid="EZK 24:11">ताकि येकर असुधता ह गलके निकल जावय</para>
  <para style="q2" vid="EZK 24:11">अऊ ओकर मुर्चा ह जल जावय।<verse eid="EZK 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 24:12"/>येह जम्मो मेहनत ला बेकार कर दीस;</para>
  <para style="q2" vid="EZK 24:12">येमा लगे भारी मुर्चा ह नइं छूटे हवय,</para>
  <para style="q2" vid="EZK 24:12">आगी ले घलो नइं छूटे हवय।<verse eid="EZK 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 24:13"/>“ ‘तोर असुधता ह काम-वासना ए। मेंह तोला साफ करे के कोसिस करेंव, पर तेंह अपन असुधता ले साफ नइं होय, अब तोला तब तक साफ करे नइं जावय, जब तक कि तोर बिरूध मोर कोप ह सांत नइं हो जाही।<verse eid="EZK 24:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="EZK 24:14"/>“ ‘में यहोवा ह कहे हवंव। मोर बर काम करे के बेरा आ गे हवय। मेंह नइं छोड़ंव; मेंह तोर ऊपर दया नइं करंव, अऊ न ही नरम पड़ंव। तोर चालचलन अऊ तोर काम के मुताबिक तोर नियाय करे जाही, परमपरधान यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 24:14"/></para>
  <para style="s1">यहेजकेल के घरवाली के मऊत</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 24:15"/>यहोवा के ये बचन ह मोर मेर आईस: <verse eid="EZK 24:15"/><verse number="16" style="v" sid="EZK 24:16"/>“हे मनखे के बेटा, मेंह एकेच चोट म तोर आंखी के खुसी ला छीननेवाला हंव। तभो ले तें न तो सोक मनाबे, न रोबे अऊ न ही आंसू बोहाबे। <verse eid="EZK 24:16"/><verse number="17" style="v" sid="EZK 24:17"/>चुपेचाप कलहरबे; मरे मनखे बर बिलाप झन करबे। अपन पगड़ी ला बांधे रख अऊ गोड़मन म पनही ला पहिरे रह; अपन दाढ़ी अऊ मूंछ ला झन ढांपबे या सोक करइयामन बर ठहिराय जेवन झन करबे।”<verse eid="EZK 24:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 24:18"/>एकरसेति बिहनियां मेंह मनखेमन ले बात करेंव, अऊ सांझ के बेरा मोर घरवाली ह मर गीस। ओकर दूसर दिन बिहनियां, मेंह वइसने करंय, जइसने मोला हुकूम देय गे रिहिस।<verse eid="EZK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 24:19"/>तब मनखेमन मोर ले पुछिन, “का तेंह हमन ला नइं बतावस कि ये चीजमन के हमर से का लेना-देना हे? तेंह काबर अइसने करत हस?”<verse eid="EZK 24:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 24:20"/>तब मेंह ओमन ला जबाब देंव, “यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 24:20"/><verse number="21" style="v" sid="EZK 24:21"/>इसरायल के मनखेमन ले कह: ‘परमपरधान यहोवा ह ये कहत हे: मेंह अपन पबितर-स्थान ला अपबितर करनेचवाला हंव—ओ गढ़ जेकर ऊपर तुमन घमंड करथव, जेकर ले तुमन ला खुसी मिलथे, जेह तुम्हर मया के चीज अय। जऊन बेटा-बेटीमन ला तुमन अपन पाछू छोंड़ गे हव, ओमन तलवार ले मारे जाहीं। <verse eid="EZK 24:21"/><verse number="22" style="v" sid="EZK 24:22"/>अऊ तुमन वइसनेच करहू, जइसने मेंह करे हवंव। तुमन अपन दाढ़ी अऊ मूंछ ला नइं ढांपहू या सोक करइयामन बर ठहिराय गे जेवन नइं खाहू। <verse eid="EZK 24:22"/><verse number="23" style="v" sid="EZK 24:23"/>तुमन अपन मुड़ म अपन पगड़ी ला बांधे रखहू अऊ गोड़ म अपन पनही ला पहिरे रहिहू। तुमन न तो सोक मनाहू अऊ न ही रोहू, बरन अपन पाप अऊ अपनेच बीच म कलहरे के कारन, तुमन बेकार हो जाहू। <verse eid="EZK 24:23"/><verse number="24" style="v" sid="EZK 24:24"/>यहेजकेल ह तुम्हर बर एक चिनहां ठहिरही; तुमन वइसने ही करहू, जइसने ओह करे हवय। जब येह होही, तब तुमन जानहू कि मेंह परमपरधान यहोवा अंव।’ ”<verse eid="EZK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 24:25"/>“अऊ हे मनखे के बेटा, जऊन दिन मेंह ओमन के मजबूत गढ़, ओमन के आनंद अऊ महिमा, ओमन के आंखी के खुसी, ओमन के हिरदय के ईछा, अऊ संग म ओमन के बेटा-बेटीमन ला लूट लूहूं— <verse eid="EZK 24:25"/><verse number="26" style="v" sid="EZK 24:26"/>ओही दिन एक भगोड़ा मनखे ह आके तोला खबर दीही। <verse eid="EZK 24:26"/><verse number="27" style="v" sid="EZK 24:27"/>ओ बेरा तोर मुहूं ह खुल जाही; तेंह ओ मनखे ले गोठियाबे अऊ फेर तें चुप नइं रहिबे। ये किसम ले तें ओमन बर एक चिनहां ठहिरबे, अऊ ओमन जानहीं के मेंह यहोवा अंव।”<verse eid="EZK 24:27"/></para>
  <chapter eid="EZK 24"/>
  <chapter number="25" style="c" sid="EZK 25"/>
  <para style="s1">अमोन के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 25:1"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 25:1"/><verse number="2" style="v" sid="EZK 25:2"/>“हे मनखे के बेटा, अमोनीमन कोति अपन मुहूं करके ओमन के बिरूध अगमबानी कर। <verse eid="EZK 25:2"/><verse number="3" style="v" sid="EZK 25:3"/>ओमन ले कह, ‘परमपरधान यहोवा के बचन ला सुनव। परमपरधान यहोवा ह ये कहत हे: काबरकि तुमन मोर पबितर-स्थान ऊपर “अहा!” कहेव, जब ओह अपबितर करे गीस अऊ जब इसरायल ह उजड़ गीस अऊ यहूदा के मनखेमन बंधुवई म गीन, <verse eid="EZK 25:3"/><verse number="4" style="v" sid="EZK 25:4"/>ये खातिर मेंह तुमन ला पूरब देस के मनखेमन के अधीन करनेवाला हंव। ओमन तुम्हर बीच म अपन डेरा डालहीं अऊ अपन तम्बूमन ला गाड़हीं; ओमन तुम्हर फर ला खाहीं अऊ तुम्हर पसुमन के दूध ला पीहीं। <verse eid="EZK 25:4"/><verse number="5" style="v" sid="EZK 25:5"/>मेंह रब्बा सहर ला ऊंटमन के चरागन अऊ अमोन ला भेड़मन के अराम करे के जगह बना दूहूं। तब तुमन जानहू कि मेंह यहोवा अंव। <verse eid="EZK 25:5"/><verse number="6" style="v" sid="EZK 25:6"/>एकरसेति परमपरधान यहोवा ह ये कहत हे: काबरकि तुमन इसरायल देस के बिरूध अपन हिरदय के जम्मो जलन भावना के कारन ताली बजाय हव अऊ अपन गोड़मन ला पटके हव अऊ आनंद मनाय हव, <verse eid="EZK 25:6"/><verse number="7" style="v" sid="EZK 25:7"/>एकरसेति, मेंह अपन हांथ ला तुम्हर बिरूध लमाहूं; अऊ तुमन ला लूट के सामान के रूप म जाति-जाति के मनखेमन ला दे दूहूं। मेंह जाति-जाति के मनखेमन के बीच म ले तुम्हर नामोनिसान मिटा दूहूं अऊ देसमन म मेंह तुमन ला पूरा नास कर दूहूं। मेंह तुमन ला नास कर दूहूं, अऊ तब तुमन जानहू कि मेंह यहोवा अंव।’ ”<verse eid="EZK 25:7"/></para>
  <para style="s1">मोआब के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 25:8"/>“परमपरधान यहोवा ह ये कहत हे: ‘काबरकि मोआब अऊ सेईर कहे हवंय, “देखव, यहूदा ह जम्मो आने जातिमन असन हो गे हवय,” <verse eid="EZK 25:8"/><verse number="9" style="v" sid="EZK 25:9"/>ये खातिर मेंह मोआब देस के किनारा ला खुला छोंड़हूं, येकर सीमना के नगरमन ले सुरू करहूं—बेत-यसीमोत, बाल-मेओन अऊ किरयातैम—जेमन ओ देस के महिमा अंय। <verse eid="EZK 25:9"/><verse number="10" style="v" sid="EZK 25:10"/>मेंह अमोनीमन के संग मोआब ला पूरब देस के मनखेमन के अधीन कर दूहूं, जेकर कारन जाति-जाति के बीच म कोनो भी अमोनीमन ला सुरता नइं करहीं; <verse eid="EZK 25:10"/><verse number="11" style="v" sid="EZK 25:11"/>अऊ मेंह मोआब ला दंड दूहूं। तब ओमन जानहीं कि मेंह यहोवा अंव।’ ”<verse eid="EZK 25:11"/></para>
  <para style="s1">एदोम के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 25:12"/>“परमपरधान यहोवा ह ये कहत हे: ‘काबरकि एदोम ह यहूदा ले बदला लीस अऊ अइसने करके ओह बहुंत दोसी हो गीस, <verse eid="EZK 25:12"/><verse number="13" style="v" sid="EZK 25:13"/>ये खातिर परमपरधान यहोवा ह ये कहत हे: मेंह एदोम देस के बिरूध अपन हांथ ला लमाहूं अऊ ओमा के आदमी अऊ पसु दूनों ला मार डारहूं। मेंह ओला उजाड़ दूहूं; अऊ तेमान सहर ले लेके ददान सहर तक ओमन तलवार ले मारे जाहीं। <verse eid="EZK 25:13"/><verse number="14" style="v" sid="EZK 25:14"/>मेंह अपन मनखे इसरायलीमन के दुवारा एदोम ले बदला लूहूं, अऊ ओमन एदोम के संग मोर कोरोध अऊ कोप के अनुसार बरताव करहीं; तब ओमन मोर बदला लेवई ला जानहीं, परमपरधान यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 25:14"/></para>
  <para style="s1">पलिस्ती के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 25:15"/>“परमपरधान यहोवा ह ये कहत हे: ‘काबरकि पलिस्ती मनखेमन बदला लेवई के भावना से काम करिन अऊ अपन मन म बईरता के कारन बदला लीन, अऊ पुराना बईरता के कारन यहूदा ला नास करे के कोसिस करिन, <verse eid="EZK 25:15"/><verse number="16" style="v" sid="EZK 25:16"/>एकरसेति परमपरधान यहोवा ह ये कहत हे: मेंह पलिस्तीमन के बिरूध अपन हांथ बढ़ानेचवाला हंव, अऊ मेंह करेतीमन ला मिटा दूहूं अऊ समुंदर तीर के बांचे मनखेमन ला नास कर दूहूं। <verse eid="EZK 25:16"/><verse number="17" style="v" sid="EZK 25:17"/>मेंह ओमन ले भयंकर बदला लूहूं अऊ अपन कोप म आके ओमन ला दंड दूहूं। तब ओमन जानहीं कि मेंह यहोवा अंव, जब मेंह ओमन ले बदला लूहूं।’ ”<verse eid="EZK 25:17"/></para>
  <chapter eid="EZK 25"/>
  <chapter number="26" style="c" sid="EZK 26"/>
  <para style="s1">सूर के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 26:1"/>हमर बंधुवई म रहे के बारहवां बछर के गियारहवां महिना के पहिला दिन, यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 26:1"/><verse number="2" style="v" sid="EZK 26:2"/>“हे मनखे के बेटा, काबरकि सूर सहर ह यरूसलेम के बिसय म ये कहे हवय, ‘अहा! जाति-जाति के मनखेमन के दुवार टूट गे हवय, अऊ ओकर कपाटमन मोर कोति खुल गे हवंय; अब ओह उजड़ गे हवय, त मेंह उन्नति करहूं,’ <verse eid="EZK 26:2"/><verse number="3" style="v" sid="EZK 26:3"/>एकरसेति परमपरधान यहोवा ह ये कहत हे: हे सूर, मेंह तोर बिरूध म हवंव, अऊ मेंह बहुंते जाति के मनखेमन ला तोर बिरूध समुंदर के लहरामन सहीं ले आहूं। <verse eid="EZK 26:3"/><verse number="4" style="v" sid="EZK 26:4"/>ओमन सूर के दीवारमन ला नास कर दीहीं अऊ ओकर मीनारमन ला टोरके गिरा दीहीं; मेंह ओकर माटी ला खुरचके ओला एक खाली चट्टान कर दूहूं। <verse eid="EZK 26:4"/><verse number="5" style="v" sid="EZK 26:5"/>बाहिर समुंदर म, ओह मछरी के जाल डाले के एक जगह हो जाही, काबरकि मेंह कहे हवंव, परमपरधान यहोवा ह घोसना करत हे। ओह जाति-जाति के मनखेमन बर लूट के सामान हो जाही, <verse eid="EZK 26:5"/><verse number="6" style="v" sid="EZK 26:6"/>अऊ महाद्वीप म बसे ओकर बस्ती ला तलवार के दुवारा नास करे जाही। तब ओमन जानहीं कि मेंह यहोवा अंव।<verse eid="EZK 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 26:7"/>“काबरकि परमपरधान यहोवा ह ये कहत हे: मेंह सूर के बिरूध उत्तर दिग ले राजाधिराज बेबिलोन के राजा नबूकदनेसर ला घोड़ा, रथ, घुड़सवार अऊ बड़े सेना के संग लानेवाला हंव। <verse eid="EZK 26:7"/><verse number="8" style="v" sid="EZK 26:8"/>ओह महाद्वीप म तोर बस्ती ला तलवार ले नास कर दीही; ओह तोर बिरूध घेराबंदी करही, तोर दीवारमन ले ढलान बनाही अऊ तोर बिरूध अपन ढाल ला उठाही। <verse eid="EZK 26:8"/><verse number="9" style="v" sid="EZK 26:9"/>ओह तोर दीवारमन के बिरूध लड़ई के हथियार चलाही अऊ तोर मीनारमन ला हथियारमन ले गिरा दीही। <verse eid="EZK 26:9"/><verse number="10" style="v" sid="EZK 26:10"/>ओकर घोड़ामन अतेक होहीं कि तेंह ओमन के धुर्रा ले तोपा जाबे। तोर दीवारमन लड़ई के घोड़ा, चार पहिया गाड़ी अऊ रथमन के अवाज ले कांप जाहीं, जब ओह तोर दुवारमन ले अइसने घुसही, जइसने आदमीमन टूटे दीवारमन ले कोनो सहर म घुसथें। <verse eid="EZK 26:10"/><verse number="11" style="v" sid="EZK 26:11"/>ओकर घोड़ामन के खुर ले तोर जम्मो गलीमन खुंदे जाहीं; ओह तोर मनखेमन ला तलवार ले मार डारही, अऊ तोर मजबूत खंभामन भुइयां म गिराय जाहीं। <verse eid="EZK 26:11"/><verse number="12" style="v" sid="EZK 26:12"/>ओमन तोर धन-संपत्ति ला लूटहीं अऊ तोर बेपार के चीजमन ला छीन लीहीं; ओमन तोर दीवारमन ला टोरके गिरा दीहीं अऊ तोर सुघर घरमन ला टोर दीहीं अऊ तोर पथरा, इमारती लकरी अऊ कचरा ला पानी म फटिक दीहीं। <verse eid="EZK 26:12"/><verse number="13" style="v" sid="EZK 26:13"/>मेंह तोर कंझट करइया गीतमन ला खतम कर दूहूं, अऊ तोर बीनामन के संगीत ह फेर सुनई नइं दीही। <verse eid="EZK 26:13"/><verse number="14" style="v" sid="EZK 26:14"/>मेंह तोला एक खाली चट्टान बना दूहूं, अऊ तेंह मछरी के जाल बगराय के एक जगह बन जाबे। तोला फेर बनाय नइं जाही, काबरकि में यहोवा ह कहे हवंव, परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 26:15"/>“परमपरधान यहोवा ह सूर ले ये कहत हे: का तोर गिरे के अवाज ले समुंदर तीर के भुइयां ह कांप नइं उठही, जब घायल मनखेमन कलहरहीं अऊ तोर बीच म मारकाट होही? <verse eid="EZK 26:15"/><verse number="16" style="v" sid="EZK 26:16"/>तब समुंदर तीर के जम्मो राजकुमारमन अपन-अपन सिंघासन ले उतरहीं अऊ अपन बागा ला अलग रख दीहीं अऊ अपन कसीदावाला ओनहा ला उतार दीहीं। आतंक के ओनहा पहिरके, हर पल कांपत अऊ तोर ले डराके भुइयां म बईठे रहिहीं। <verse eid="EZK 26:16"/><verse number="17" style="v" sid="EZK 26:17"/>तब ओमन तोर बिसय म एक बिलापगीत लीहीं अऊ तोला कहिहीं:</para>
  <para style="q1" vid="EZK 26:17">“ ‘हे खियाती पाय सहर, तेंह कइसे नास हो गे,</para>
  <para style="q2" vid="EZK 26:17">समुंदर तीर के मनखेमन तोर म बसे रिहिन!</para>
  <para style="q1" vid="EZK 26:17">तेंह समुंदर म एक सक्ति रहय,</para>
  <para style="q2" vid="EZK 26:17">तें अऊ तोर निवासीमन;</para>
  <para style="q1" vid="EZK 26:17">तेंह ओ जम्मो झन ला आतंकित करय</para>
  <para style="q2" vid="EZK 26:17">जेमन उहां रहत रिहिन।<verse eid="EZK 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 26:18"/>अब समुंदर तीर के भुइयां ह</para>
  <para style="q2" vid="EZK 26:18">तोर गिरे के दिन म कांपथे;</para>
  <para style="q1" vid="EZK 26:18">समुंदर के द्वीपमन</para>
  <para style="q2" vid="EZK 26:18">तोर गिरे ले भयभीत होवत हें।’<verse eid="EZK 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 26:19"/>“परमपरधान यहोवा ह ये कहत हे: जब मेंह तोला उजड़े सहर बना दूहूं, ओ सहरमन सहीं जिहां कोनो नइं रहंय, अऊ जब मेंह तोर ऊपर समुंदर के गहरई ला ले आहूं, अऊ ओकर बहुंते पानी म तेंह बुड़ जाबे, <verse eid="EZK 26:19"/><verse number="20" style="v" sid="EZK 26:20"/>तब में तोला ओमन के संग खाल्हे ले आहूं, जेमन खाल्हे खंचवा म बहुंत पहिले के मनखेमन करा जाथें। पुराना जमाना के बिनास सहीं, मेंह तोला धरती के खाल्हे ओमन के संग निवास करवाहूं, जेमन खाल्हे खंचवा म जाथें, अऊ तेंह जीयत मनखेमन के भुइयां म रहे बर फेर लहुंटके नइं आबे। <verse eid="EZK 26:20"/><verse number="21" style="v" sid="EZK 26:21"/>मेंह तोर एक भयंकर अन्त कर दूहूं अऊ तेंह खतम हो जाबे। तोला खोजे तो जाही, पर तेंह फेर कभू नइं मिलबे, परमपरधान यहोवा ह घोसना करत हे।”<verse eid="EZK 26:21"/></para>
  <chapter eid="EZK 26"/>
  <chapter number="27" style="c" sid="EZK 27"/>
  <para style="s1">सूर बर सोक मनई</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 27:1"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 27:1"/><verse number="2" style="v" sid="EZK 27:2"/>“हे मनखे के बेटा, सूर सहर के बिसय म एक ठन बिलापगीत ले। <verse eid="EZK 27:2"/><verse number="3" style="v" sid="EZK 27:3"/>सूर ले कह, जऊन ह समुंदर के मुंहटा म बसे हवय, अऊ बहुंत अकन समुंदर तीर के मनखेमन के बेपारी अय, ‘परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 27:3">“ ‘हे सूर, तेंह कहिथस,</para>
  <para style="q2" vid="EZK 27:3">“मेंह बहुंत सुघर हंव।”<verse eid="EZK 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 27:4"/>तोर इलाका ह ऊंच समुंदर म रिहिस;</para>
  <para style="q2" vid="EZK 27:4">तोर बनइयामन तोला एकदम सुघर बनाईन।<verse eid="EZK 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 27:5"/>ओमन तोर जम्मो इमारती लकरी</para>
  <para style="q2" vid="EZK 27:5">सनीर<note caller="+" style="f"><char style="fr" closed="false">27:5 </char><char style="ft" closed="false">हेरमोन पहाड़</char></note> के सनोवर के लकरी ले लीन;</para>
  <para style="q1" vid="EZK 27:5">तोर बर पतवार बनाय बर</para>
  <para style="q2" vid="EZK 27:5">ओमन लबानोन के देवदार के लकरी लीन।<verse eid="EZK 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 27:6"/>ओमन तोर पतवारमन ला</para>
  <para style="q2" vid="EZK 27:6">बासान के बलूत रूखमन ले बनाईन;</para>
  <para style="q1" vid="EZK 27:6">कित्ती के समुंदर तीर के गोपेर लकरी ले</para>
  <para style="q2" vid="EZK 27:6">ओमन तोर पानी जहाज के छत ला बनाईन अऊ हाथी-दांत ले सजाईन।<verse eid="EZK 27:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 27:7"/>तोर जहाज के तिरपाल ह मिसर देस के कसीदा करे गय मलमल कपड़ा ले बने रिहिस</para>
  <para style="q2" vid="EZK 27:7">अऊ येह तोर बर झंडा के काम करय;</para>
  <para style="q1" vid="EZK 27:7">तोर तिरपालमन एलीसाह<note caller="+" style="f"><char style="fr" closed="false">27:7 </char><char style="ft" closed="false">साइप्रस के द्वीप</char></note> के समुंदर तीर के</para>
  <para style="q2" vid="EZK 27:7">नीला अऊ बैंगनी कपड़ा के बने रिहिन।<verse eid="EZK 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 27:8"/>तोर पतवार चलानेवालामन सीदोन अऊ अरवद सहरमन के आदमी रिहिन;</para>
  <para style="q2" vid="EZK 27:8">हे सूर, तोर कुसल आदमीमन नाविक के रूप म जहाज म रिहिन।<verse eid="EZK 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 27:9"/>गबाल के अनुभवी कारीगरमन</para>
  <para style="q2" vid="EZK 27:9">जहाज के मरम्मत करे बर जहाज म रिहिन।</para>
  <para style="q1" vid="EZK 27:9">समुंदर के जम्मो जहाज अऊ ओमन के चलइयामन</para>
  <para style="q2" vid="EZK 27:9">तोर बेपार के सामान के लेन-देन करे बर संग-संग आ गे रिहिन।<verse eid="EZK 27:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 27:10"/>“ ‘फारसी, लूदी अऊ पूती मनखेमन</para>
  <para style="q2" vid="EZK 27:10">तोर सेना म सैनिक के रूप म रिहिन।</para>
  <para style="q1" vid="EZK 27:10">ओमन अपन ढाल अऊ टोप ला</para>
  <para style="q2" vid="EZK 27:10">तोर सोभा बढ़ात तोर दीवारमन म टांग दीन।<verse eid="EZK 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 27:11"/>अरवद सहर अऊ हेलेक इलाका के आदमीमन</para>
  <para style="q2" vid="EZK 27:11">चारों कोति ले तोर दीवारमन के पहरेदारी करिन;</para>
  <para style="q1" vid="EZK 27:11">गमाद नगर के आदमीमन</para>
  <para style="q2" vid="EZK 27:11">तोर मीनारमन म रिहिन।</para>
  <para style="q1" vid="EZK 27:11">ओमन अपन ढाल चारों कोति तोर दीवारमन म टांग दीन;</para>
  <para style="q2" vid="EZK 27:11">ओमन तोर सुघरता बहुंत बढ़ाईन।<verse eid="EZK 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 27:12"/>“ ‘जम्मो किसम के सामान के बहुंतायत के कारन तरसीस सहर के मनखेमन तोर संग बेपार करिन; ओमन चांदी, लोहा, टीन अऊ सीसा ला देके तोर माल ला बिसाईन।<verse eid="EZK 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 27:13"/>“ ‘यूनान, तूबल अऊ मेसेक देस के मनखेमन तोर संग बेपार करिन; ओमन तोर बेपारी सामान के बदला म दास-दासी अऊ कांसा के चीजमन ला दीन।<verse eid="EZK 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 27:14"/>“ ‘बेत-तोगरमा इलाका के आदमीमन तोर बेपार के सामान के बदला म रथवाला घोड़ा, सेना के घोड़ा अऊ खच्चरमन ला दीन।<verse eid="EZK 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 27:15"/>“ ‘रूदुस<note caller="+" style="f"><char style="fr" closed="false">27:15 </char><char style="ft" closed="false">सेप्टाजिन्ट; इबरानी म </char><char style="fqa" closed="false">ददान</char></note> के आदमीमन तोर संग बेपार करिन, अऊ बहुंत अकन समुंदर तीर के मनखेमन तोर खरीददार रिहिन; ओमन तोर सामान के बदले हाथी-दांत अऊ तेंदू के कठवा देवत रिहिन।<verse eid="EZK 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 27:16"/>“ ‘तोर मेर बहुंत सामान होय के कारन अराम के मनखेमन तोर ले बेपार करिन; ओमन तोर सामान के बदले हरा लालमनि, बैंगनी रंग के ओनहा, कसीदाकारी करे गय ओनहा, बढ़िया मलमल के ओनहा, मूंगा अऊ लालमनि देवत रिहिन।<verse eid="EZK 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 27:17"/>“ ‘यहूदा अऊ इसरायल घलो तोर ले बेपार करत रिहिन; ओमन तोर सामान के बदले मिन्नीत के गहूं, मिठई, मंधरस, जैतून तेल, अऊ मलहम देवत रिहिन।<verse eid="EZK 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 27:18"/>“ ‘तोर बहुंत अकन सामान अऊ बहुंत धन-संपत्ति के कारन दमिस्क ह तोर संग बेपार करिस। ओमन तोला हेलबोन नगर के अंगूर के मंद, अऊ जाहर नगर के ऊन दीन। <verse eid="EZK 27:18"/><verse number="19" style="v" sid="EZK 27:19"/>अऊ ईजाल ले लकरी के पीपा म भरे अंगूर के मंद के बदला बनाय गय लोहा, दालचीनी अऊ तेजपान दीन।<verse eid="EZK 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 27:20"/>“ ‘घोड़ा के पीठ म बिछाय के कम्बल बर ददान ह तोर संग बेपार करिस।<verse eid="EZK 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 27:21"/>“ ‘अरब के मनखे अऊ केदार के जम्मो राजकुमारमन तोर सामान के खरीददार रिहिन; ओमन मेढ़ा-पीला, मेढ़ा, अऊ बोकरा देके तोर संग लेन-देन करत रिहिन।<verse eid="EZK 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 27:22"/>“ ‘सेबा राज अऊ रामा सहर के बेपारीमन तोर संग बेपार करिन; तोर सामान के बदले म ओमन तोला सबले बने किसम के मसाला अऊ कीमती रत्न, अऊ सोन देवत रिहिन।<verse eid="EZK 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 27:23"/>“ ‘हारान, कन्ने, अऊ एदेन अऊ सेबा, अस्सूर अऊ किलमद सहरमन के बेपारीमन तोर संग बेपार करिन। <verse eid="EZK 27:23"/><verse number="24" style="v" sid="EZK 27:24"/>तोर बजार के जगह म ओमन तोर सामान के बदले सुघर ओनहा, नीला कपड़ा, बूटावाले ओनहा अऊ बंटे अऊ कसके बंधे डोरी वाले रंग-बिरंगा गलीचा देवत रिहिन।<verse eid="EZK 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="EZK 27:25"/>“ ‘तोर बेपारी सामान के ढोवई</para>
  <para style="q2" vid="EZK 27:25">तरसीस के पानी जहाजमन ले होथे।</para>
  <para style="q1" vid="EZK 27:25">जब तें समुंदर के यातरा म जाथस</para>
  <para style="q2" vid="EZK 27:25">त जहाज म भारी सामान भरे रहिथे।<verse eid="EZK 27:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="EZK 27:26"/>तोर जहाज के खेवइयामन</para>
  <para style="q2" vid="EZK 27:26">तोला गहिला समुंदर म ले जाथें।</para>
  <para style="q1" vid="EZK 27:26">पर पूरब के हवा ह दूरिहा समुंदर म</para>
  <para style="q2" vid="EZK 27:26">तोर जहाज के कुटा-कुटा कर दीही।<verse eid="EZK 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="EZK 27:27"/>तोर संपत्ति, बेपारी सामान अऊ आने सामान,</para>
  <para style="q2" vid="EZK 27:27">तोर नाविकमन, जहाज खेवइयामन अऊ जहाज ला मरम्मत करइयामन,</para>
  <para style="q1" vid="EZK 27:27">तोर बेपारी अऊ तोर सैनिकमन,</para>
  <para style="q2" vid="EZK 27:27">अऊ जहाज म के हर एक चीज</para>
  <para style="q1" vid="EZK 27:27">ओ दिन समुंदर के बीच डूब जाहीं</para>
  <para style="q2" vid="EZK 27:27">जब तोर जहाज ह टूट जाही।<verse eid="EZK 27:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="EZK 27:28"/>जब तोर जहाज खेवइयामन चिचियाहीं</para>
  <para style="q2" vid="EZK 27:28">त समुंदर तीर के भुइयां ह कांप उठही।<verse eid="EZK 27:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZK 27:29"/>पतवार चलइया जम्मो झन</para>
  <para style="q2" vid="EZK 27:29">अपन जहाजमन ला छोंड़ दीहीं;</para>
  <para style="q1" vid="EZK 27:29">नाविक अऊ जहाज खेवइया जम्मो झन</para>
  <para style="q2" vid="EZK 27:29">जहाज ले उतरके समुंदर तीर म ठाढ़ हो जाहीं।<verse eid="EZK 27:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="EZK 27:30"/>ओमन तोर ऊपर चिचियाहीं</para>
  <para style="q2" vid="EZK 27:30">अऊ फूट-फूटके रोहीं;</para>
  <para style="q1" vid="EZK 27:30">ओमन अपन मुड़ म धुर्रा छिंचके</para>
  <para style="q2" vid="EZK 27:30">राख म घुंडलहीं।<verse eid="EZK 27:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZK 27:31"/>ओमन तोर कारन अपन मुड़ ला मुड़ा लीहीं</para>
  <para style="q2" vid="EZK 27:31">अऊ बोरा के कपड़ा पहिरहीं।</para>
  <para style="q1" vid="EZK 27:31">ओमन अपन मन म भारी दुख</para>
  <para style="q2" vid="EZK 27:31">अऊ भारी सोक ले तोर बर रोहीं।<verse eid="EZK 27:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="EZK 27:32"/>जब ओमन तोर बिसय म रोहीं अऊ सोक मनाहीं,</para>
  <para style="q2" vid="EZK 27:32">त ओमन तोर बारे म एक बिलापगीत गाहीं:</para>
  <para style="q1" vid="EZK 27:32">“कोन ह समुंदर ले घिरे के बाद घलो</para>
  <para style="q2" vid="EZK 27:32">सूर के सहीं चुपेचाप रिहिस?”<verse eid="EZK 27:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 27:33"/>जब तोर बेपार के माल ह समुंदर म जावय,</para>
  <para style="q2" vid="EZK 27:33">त तेंह बहुंते जाति के मनखेमन ला संतुस्ट करय;</para>
  <para style="q1" vid="EZK 27:33">अपन बहुंत धन अऊ बेपार के माल ले</para>
  <para style="q2" vid="EZK 27:33">तेंह धरती के राजामन ला धनी कर देय।<verse eid="EZK 27:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 27:34"/>अब तें गहिला पानी म</para>
  <para style="q2" vid="EZK 27:34">समुंदर के दुवारा चकनाचूर हो गे हस;</para>
  <para style="q1" vid="EZK 27:34">तोर जहाज के माल अऊ तोर पूरा झुंड</para>
  <para style="q2" vid="EZK 27:34">तोर संग डूब गे हवय।<verse eid="EZK 27:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="EZK 27:35"/>समुंदर तीर म रहइया जम्मो झन</para>
  <para style="q2" vid="EZK 27:35">तोर दसा देखके डर गे हवंय;</para>
  <para style="q1" vid="EZK 27:35">ओमन के राजामन डर के मारे कांपथें</para>
  <para style="q2" vid="EZK 27:35">अऊ डर के मारे ओमन के चेहरा के रंग उड़ गे हवय।<verse eid="EZK 27:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="EZK 27:36"/>जाति-जाति के बीच बेपारीमन तोर हंसी उड़ाथें;</para>
  <para style="q2" vid="EZK 27:36">तोर एक भयंकर अन्त हो गे हवय</para>
  <para style="q2" vid="EZK 27:36">अऊ तोर नामोनिसान नइं रहय।’ ”<verse eid="EZK 27:36"/></para>
  <chapter eid="EZK 27"/>
  <chapter number="28" style="c" sid="EZK 28"/>
  <para style="s1">सूर के राजा के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 28:1"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 28:1"/><verse number="2" style="v" sid="EZK 28:2"/>“हे मनखे के बेटा, सूर के सासन करइया ले कह, ‘परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 28:2">“ ‘अपन मन म घमंड करके</para>
  <para style="q2" vid="EZK 28:2">तेंह कहिथस, “मेंह एक ईस्वर अंव;</para>
  <para style="q1" vid="EZK 28:2">मेंह समुंदर के बीच</para>
  <para style="q2" vid="EZK 28:2">ईस्वर के सिंघासन म बईठथंव।”</para>
  <para style="q1" vid="EZK 28:2">पर तेंह सिरिप एक मरनहार जीव अस, ईस्वर नो हस,</para>
  <para style="q2" vid="EZK 28:2">हालाकि तेंह सोचथस कि तेंह ईस्वर के सहीं बुद्धिमान अस।<verse eid="EZK 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 28:3"/>का तेंह दानिएल ले जादा होसियार अस?</para>
  <para style="q2" vid="EZK 28:3">का तोर ले कोनो भेद के बात छुपे नइं ए?<verse eid="EZK 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 28:4"/>अपन बुद्धि अऊ समझ के दुवारा</para>
  <para style="q2" vid="EZK 28:4">तेंह अपन बर धन कमाय हस</para>
  <para style="q1" vid="EZK 28:4">अऊ अपन खजाना म</para>
  <para style="q2" vid="EZK 28:4">सोन अऊ चांदी जमा करे हस।<verse eid="EZK 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 28:5"/>बेपार म अपन बड़े कुसलता के दुवारा</para>
  <para style="q2" vid="EZK 28:5">तेंह अपन संपत्ति बढ़ाय हस,</para>
  <para style="q1" vid="EZK 28:5">अऊ तोर धन के कारन</para>
  <para style="q2" vid="EZK 28:5">तोर मन ह घमंडी हो गे हवय।<verse eid="EZK 28:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 28:6"/>“ ‘एकरसेति परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 28:6">“ ‘काबरकि तें सोचथस</para>
  <para style="q2" vid="EZK 28:6">कि तें ईस्वर सहीं बुद्धिमान अस,<verse eid="EZK 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 28:7"/>एकरसेति मेंह परदेसीमन ले तोर बिरोध करवाहूं,</para>
  <para style="q2" vid="EZK 28:7">जेमन जम्मो जातिमन म सबले जादा निरदयी अंय;</para>
  <para style="q1" vid="EZK 28:7">ओमन तोर सुघरता अऊ बुद्धिमानी ऊपर अपन तलवार चलाहीं</para>
  <para style="q2" vid="EZK 28:7">अऊ तोर चमकत सोभा ला नास कर दीहीं।<verse eid="EZK 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 28:8"/>ओमन तोला खाल्हे खंचवा म ले आहीं,</para>
  <para style="q2" vid="EZK 28:8">अऊ समुंदर के बीच म</para>
  <para style="q2" vid="EZK 28:8">तें भयंकर मिरतू ले मरबे।<verse eid="EZK 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 28:9"/>जेमन तोला मार डालहीं, ओमन के आघू म</para>
  <para style="q2" vid="EZK 28:9">तब का तें कहिबे, “मेंह ईस्वर अंव?”</para>
  <para style="q1" vid="EZK 28:9">जेमन तोला मार डालथें, ओमन के हांथ म</para>
  <para style="q2" vid="EZK 28:9">तें एक मरनहार अस, ईस्वर नइं।<verse eid="EZK 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 28:10"/>तेंह परदेसीमन के हांथ म</para>
  <para style="q2" vid="EZK 28:10">खतनारहित मनखेमन असन मारे जाबे।</para>
  <para style="m" vid="EZK 28:10">मेंह कहे हंव, परमपरधान यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 28:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="EZK 28:11"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 28:11"/><verse number="12" style="v" sid="EZK 28:12"/>“हे मनखे के बेटा, सूर के राजा के बिसय म एक बिलापगीत ले अऊ ओला कह: ‘परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 28:12">“ ‘तें बुद्धि ले भरे अऊ बहुंत सुघर,</para>
  <para style="q2" vid="EZK 28:12">उत्तमता के मुहर रहय।<verse eid="EZK 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 28:13"/>तेंह परमेसर के बगीचा,</para>
  <para style="q2" vid="EZK 28:13">अदन म रहय;</para>
  <para style="q1" vid="EZK 28:13">हर एक कीमती रत्न ले तोला सजाय गे रिहिस:</para>
  <para style="q2" vid="EZK 28:13">मानिक, हीरा अऊ पन्ना,</para>
  <para style="q2" vid="EZK 28:13">पुखराज, गोमेदक अऊ मनि,</para>
  <para style="q2" vid="EZK 28:13">नीलमनि, फिरोजा अऊ मरकत।</para>
  <para style="q1" vid="EZK 28:13">तोर बईठे के जगह अऊ बईठकमन सोन के बने रिहिन;</para>
  <para style="q2" vid="EZK 28:13">जऊन दिन तोला बनाय गीस, ओहीच दिन ओमन ला तियार करे गीस।<verse eid="EZK 28:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 28:14"/>एक अविभावक करूब के रूप म तोर राजतिलक होईस,</para>
  <para style="q2" vid="EZK 28:14">इही काम बर मेंह तोर अभिसेक करेंव।</para>
  <para style="q1" vid="EZK 28:14">तें परमेसर के पबितर पहाड़ म रहय;</para>
  <para style="q2" vid="EZK 28:14">तेंह आगी कस चमकनेवाला पथरामन के बीच चलत-फिरत रहय।<verse eid="EZK 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 28:15"/>अपन सिरजे गय दिन ले</para>
  <para style="q2" vid="EZK 28:15">तेंह अपन चालचलन म निरदोस रहय</para>
  <para style="q2" vid="EZK 28:15">जब तक कि तोर दुस्टता नइं पाय गीस।<verse eid="EZK 28:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 28:16"/>तोर बेपार के फईले होय के कारन</para>
  <para style="q2" vid="EZK 28:16">तेंह हिंसा ले भर गे रहय,</para>
  <para style="q2" vid="EZK 28:16">अऊ तेंह पाप करय।</para>
  <para style="q1" vid="EZK 28:16">एकरसेति मेंह तोला कलंक म परमेसर के पहाड़ ले भगा देंव,</para>
  <para style="q2" vid="EZK 28:16">अऊ हे अविभावक करूब, मेंह तोला</para>
  <para style="q2" vid="EZK 28:16">आगी कस चमकत पथरामन के बीच ले निकाल देंव।<verse eid="EZK 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 28:17"/>तोर सुघरता के कारन</para>
  <para style="q2" vid="EZK 28:17">तोर मन ह घमंडी हो गीस,</para>
  <para style="q1" vid="EZK 28:17">अऊ तोर सोभा के कारन</para>
  <para style="q2" vid="EZK 28:17">तोर बुद्धि ह बिगड़ गीस।</para>
  <para style="q1" vid="EZK 28:17">एकरसेति मेंह तोला भुइयां म फटिक देंव;</para>
  <para style="q2" vid="EZK 28:17">मेंह तोला राजामन के आघू म एक तमासा बना देंव।<verse eid="EZK 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 28:18"/>अपन बहुंत पाप अऊ बेईमानी के बेपार ले</para>
  <para style="q2" vid="EZK 28:18">तेंह अपन पबितर-स्थानमन ला अपबितर कर दे हस।</para>
  <para style="q1" vid="EZK 28:18">एकरसेति मेंह तोर म ले ही एक अइसन आगी ला बनांय,</para>
  <para style="q2" vid="EZK 28:18">जऊन ह तोला जलाके नास कर दीस,</para>
  <para style="q1" vid="EZK 28:18">अऊ जेमन तोला देखत रिहिन, ओ जम्मो के आघू म</para>
  <para style="q2" vid="EZK 28:18">मेंह तोला भुइयां म राख बना देंव।<verse eid="EZK 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="EZK 28:19"/>ओ जम्मो जाति के मनखे जेमन तोला जानत रिहिन</para>
  <para style="q2" vid="EZK 28:19">तोर हालत ले डरा गीन;</para>
  <para style="q1" vid="EZK 28:19">तोर एक भयानक अन्त होय हवय</para>
  <para style="q2" vid="EZK 28:19">अऊ अब तोर नामोनिसान नइं रहय।’ ”<verse eid="EZK 28:19"/></para>
  <para style="s1">सीदोन के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 28:20"/>यहोवा के ये बचन ह मोर मेर आईस: <verse eid="EZK 28:20"/><verse number="21" style="v" sid="EZK 28:21"/>“हे मनखे के बेटा, अपन मुहूं ला सीदोन सहर कोति कर; ओकर बिरूध म अगमबानी कर <verse eid="EZK 28:21"/><verse number="22" style="v" sid="EZK 28:22"/>अऊ कह: ‘परमपरधान यहोवा ये कहत हे:</para>
  <para style="q1" vid="EZK 28:22">“ ‘हे सीदोन, मेंह तोर बिरूध हवंव,</para>
  <para style="q2" vid="EZK 28:22">अऊ तोर बीच म मेंह अपन महिमा परगट करहूं।</para>
  <para style="q1" vid="EZK 28:22">जब मेंह तोला दंड दूहूं</para>
  <para style="q2" vid="EZK 28:22">तब तेंह जानबे कि मेंह यहोवा अंव,</para>
  <para style="q2" vid="EZK 28:22">अऊ तोर ही बीच म मेंह पबितर ठहिरहूं।<verse eid="EZK 28:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="EZK 28:23"/>मेंह तोर बीच म महामारी पठोहूं</para>
  <para style="q2" vid="EZK 28:23">अऊ तोर गलीमन म खून बहाहूं।</para>
  <para style="q1" vid="EZK 28:23">चारों कोति ले तोर बिरूध तलवार चलही,</para>
  <para style="q2" vid="EZK 28:23">अऊ मारे गय मनखेमन तोरेच बीच म गिरहीं।</para>
  <para style="q1" vid="EZK 28:23">तब तेंह जानबे कि मेंह यहोवा अंव।<verse eid="EZK 28:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 28:24"/>“ ‘तब इसरायली मनखेमन के अइसे पड़ोसी नइं होहीं, जेमन पीरा देवइया कंटिली झाड़ी अऊ तेज गड़नेवाला कांटा सहीं अंय। तब ओमन जानहीं कि मेंह परमपरधान यहोवा अंव।<verse eid="EZK 28:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 28:25"/>“ ‘परमपरधान यहोवा ह ये कहत हे: जब मेंह इसरायल के मनखेमन ला ओ जातिमन ले इकट्ठा करहूं, जेमन के बीच म ओमन तितिर-बितिर हो गे हवंय, त में ओमन के जरिये ओ जातिमन के मनखे के नजर म पबितर ठहिरहूं। तब ओमन अपन खुद के देस म रहिहीं, जेला मेंह अपन सेवक याकूब ला देय रहेंव। <verse eid="EZK 28:25"/><verse number="26" style="v" sid="EZK 28:26"/>ओमन उहां सुरकछित रहिहीं अऊ घर बनाहीं अऊ अंगूर के बारी लगाहीं; ओमन सुरकछित रहिहीं जब में ओमन के ओ जम्मो परोसीमन ला दंड दूहूं, जेमन ओमन ले बईरता रखत रिहिन। तब ओमन जानहीं कि में यहोवा ओमन के परमेसर अंव।’ ”<verse eid="EZK 28:26"/></para>
  <chapter eid="EZK 28"/>
  <chapter number="29" style="c" sid="EZK 29"/>
  <para style="s1">मिसर देस के बिरूध अगमबानी</para>
  <para style="s2">फिरौन ला दंड</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 29:1"/>बंधुवई के दसवां बछर के, दसवां महिना के बारहवां दिन, यहोवा के बचन ह मोर मेर आईस: <verse eid="EZK 29:1"/><verse number="2" style="v" sid="EZK 29:2"/>“हे मनखे के बेटा, अपन मुहूं ला मिसर के राजा फिरौन कोति करके ओकर अऊ जम्मो मिसर के बिरूध अगमबानी कर। <verse eid="EZK 29:2"/><verse number="3" style="v" sid="EZK 29:3"/>ओकर ले बात कर अऊ कह, ‘परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 29:3">“ ‘हे मिसर के राजा फिरौन, मेंह तोर बिरूध हंव,</para>
  <para style="q2" vid="EZK 29:3">तें एक बहुंत बड़े जन्तु अस, जऊन ह अपन पानी के सोतामन के बीच पड़े रहिथस।</para>
  <para style="q1" vid="EZK 29:3">तेंह कहिथस, “नील नदी ह मोर ए;</para>
  <para style="q2" vid="EZK 29:3">मेंह ओला अपन बर बनाय हवंव।”<verse eid="EZK 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 29:4"/>पर मेंह तोर जबड़ामन म गरी डालहूं</para>
  <para style="q2" vid="EZK 29:4">अऊ तोर सोता के मछरीमन ला तोर खाल म चिपका दूहूं।</para>
  <para style="q1" vid="EZK 29:4">मेंह तोला तोर सोतामन ले बाहिर ले आहूं,</para>
  <para style="q2" vid="EZK 29:4">अऊ जम्मो मछरीमन तोर खाल म चिपके रहिहीं।<verse eid="EZK 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 29:5"/>मेंह तोला अऊ तोर सोतामन के जम्मो मछरीमन ला</para>
  <para style="q2" vid="EZK 29:5">मरू-भुइयां म छोंड़ दूहूं।</para>
  <para style="q1" vid="EZK 29:5">तेंह खुला मैदान म पड़े रहिबे</para>
  <para style="q2" vid="EZK 29:5">अऊ तोला न तो संकेले जाही अऊ न उठाय जाही।</para>
  <para style="q1" vid="EZK 29:5">मेंह तोला जेवन के रूप म</para>
  <para style="q2" vid="EZK 29:5">धरती के पसु अऊ अकास के चिरईमन ला दे दूहूं।<verse eid="EZK 29:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="EZK 29:6"/>तब मिसर देस म रहइया जम्मो झन जानहीं कि मेंह यहोवा अंव।</para>
  <para style="b" vid="EZK 29:6"/>
  <para style="p" vid="EZK 29:6">“ ‘तेंह इसरायल के मनखेमन बर सरकंडा के एक लउठी हो गे हस। <verse eid="EZK 29:6"/><verse number="7" style="v" sid="EZK 29:7"/>जब ओमन तोला अपन हांथ म धरिन, त तेंह चीरा गेय अऊ ओमन के कंधामन ला फार डारय; जब ओमन तोर ऊपर टेक लगाईन, त तेंह टूट गेय अऊ ओमन के पीठ के मंझरेटामन लचक गीन।<verse eid="EZK 29:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 29:8"/>“ ‘एकरसेति परमपरधान यहोवा ह ये कहत हे: मेंह तोर ऊपर तलवार चलाहूं अऊ आदमी अऊ पसु दूनों ला मार डालहूं। <verse eid="EZK 29:8"/><verse number="9" style="v" sid="EZK 29:9"/>मिसर देस ह निरजन अऊ उजाड़ हो जाही। तब ओमन जानहीं कि मेंह यहोवा अंव।</para>
  <para style="p" vid="EZK 29:9">“ ‘काबरकि तेंह कहय, “नील नदी ह मोर अय; मेंह ओला बनाय हंव,” <verse eid="EZK 29:9"/><verse number="10" style="v" sid="EZK 29:10"/>एकरसेति मेंह तोर अऊ तोर पानी के सोतामन के बिरूध हवंव, अऊ मिसर देस ला मिगदोल ले लेके असवान तक, बरन कूस देस के सीमना तक खंडहर कर दूहूं अऊ उजाड़ दूहूं। <verse eid="EZK 29:10"/><verse number="11" style="v" sid="EZK 29:11"/>न तो कोनो मनखे अऊ न ही कोनो पसु उहां ले होके जाहीं; उहां चालीस बछर तक कोनो नइं रहिहीं। <verse eid="EZK 29:11"/><verse number="12" style="v" sid="EZK 29:12"/>मेंह बरबाद हो गय देसमन के बीच मिसर देस ला उजाड़ दूहूं, अऊ ओकर सहरमन नास हो गय सहरमन के बीच चालीस बछर तक उजाड़ पड़े रहिहीं। अऊ मेंह मिसरीमन ला जाति-जाति के मनखेमन के बीच एती-ओती कर दूहूं अऊ देस-देस म तितिर-बितिर कर दूहूं।<verse eid="EZK 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 29:13"/>“ ‘तभो ले परमपरधान यहोवा ह ये कहत हे: चालीस बछर के आखिरी म मेंह मिसरीमन ला ओ जातिमन के बीच ले इकट्ठा करहूं, जिहां ओमन तितिर-बितिर हो गे रिहिन। <verse eid="EZK 29:13"/><verse number="14" style="v" sid="EZK 29:14"/>मेंह ओमन ला बंधुवई ले वापिस ले आहूं अऊ ओमन ला ऊपरी मिसर म लहुंटा ले आहूं, जऊन ह ओमन के पुरखामन के देस अय। उहां ओमन एक निचला दरजा के राज के रूप म होहीं। <verse eid="EZK 29:14"/><verse number="15" style="v" sid="EZK 29:15"/>येह जम्मो राजमन म सबले निचला दरजा के राज होही अऊ येह अपनआप ला फेर कभू आने जातिमन ले ऊपर नइं उठा सकही। मेंह येला अतेक कमजोर कर दूहूं कि येह फेर कभू जाति-जाति के मनखेमन ऊपर सासन नइं कर पाही। <verse eid="EZK 29:15"/><verse number="16" style="v" sid="EZK 29:16"/>मिसर ह फेर इसरायल के मनखेमन के भरोसा के कारन नइं होही, पर येह इसरायल ला ओमन के ओ पाप के सुरता करात रहिही, जब ओमन मदद बर मिसर कोति देखिन। तब ओमन जानहीं कि मेंह परमपरधान यहोवा अंव।’ ”<verse eid="EZK 29:16"/></para>
  <para style="s2">राजा नबूकदनेसर के ईनाम</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 29:17"/>फेर सत्ताईसवां बछर के पहिला महिना के पहिला दिन, यहोवा के बचन मोर मेर आईस: <verse eid="EZK 29:17"/><verse number="18" style="v" sid="EZK 29:18"/>“हे मनखे के बेटा, बेबिलोन के राजा नबूकदनेसर ह सूर के बिरूध एक कठोर सैनिक अभियान करवाय हवय; हर एक के मुड़ ह चंदवा हो गीस अऊ हर एक के कंधा के चमड़ी ह निकल गीस। तभो ले ओला अऊ ओकर सेना ला सूर के बिरूध करे गय अभियान ले कोनो फायदा नइं होईस। <verse eid="EZK 29:18"/><verse number="19" style="v" sid="EZK 29:19"/>एकरसेति परमपरधान यहोवा ह ये कहत हे: मेंह बेबिलोन के राजा नबूकदनेसर ला मिसर देस देनेवाला हंव, अऊ ओह मिसर के संपत्ति ला ले जाही। ओह अपन सेना के जरूरत ला पूरा करे बर मिसर देस के चीजमन ला लूटही अऊ छीन लीही। <verse eid="EZK 29:19"/><verse number="20" style="v" sid="EZK 29:20"/>मेंह ओकर मेहनत के बदला म ओला मिसर देस एक ईनाम के रूप म देय हवंव, काबरकि ओ अऊ ओकर सेना ह ये काम मोर बर करिन, परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 29:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 29:21"/>“ओहीच दिन मेंह इसरायलीमन बर एक सींग<note caller="+" style="f"><char style="fr" closed="false">29:21 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">इहां येह ताकत के प्रतीक अय</char></note> उगाहूं, अऊ मेंह ओमन के बीच तोर मुहूं ला खोलहूं। तब ओमन जानहीं कि मेंह यहोवा अंव।”<verse eid="EZK 29:21"/></para>
  <chapter eid="EZK 29"/>
  <chapter number="30" style="c" sid="EZK 30"/>
  <para style="s2">मिसर देस बर बिलापगीत</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 30:1"/>यहोवा के बचन ह मोर मेर आईस: <verse eid="EZK 30:1"/><verse number="2" style="v" sid="EZK 30:2"/>“हे मनखे के बेटा, अगमबानी करके कह: ‘परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 30:2">“ ‘बिलाप करव अऊ कहव,</para>
  <para style="q2" vid="EZK 30:2">“हाय ओ दिन बर!”<verse eid="EZK 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 30:3"/>काबरकि ओ दिन ह लकठा म हवय,</para>
  <para style="q2" vid="EZK 30:3">यहोवा के दिन ह लकठा म हवय—</para>
  <para style="q1" vid="EZK 30:3">बादरमन के दिन,</para>
  <para style="q2" vid="EZK 30:3">जाति-जाति के मनखेमन बर दंड के दिन होही।<verse eid="EZK 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 30:4"/>मिसर के बिरूध एक तलवार उठही,</para>
  <para style="q2" vid="EZK 30:4">अऊ कूस<note caller="+" style="f"><char style="fr" closed="false">30:4 </char><char style="ft" closed="false">ऊपरी नील नदी के इलाका</char></note> ऊपर पीरा के समय आही।</para>
  <para style="q1" vid="EZK 30:4">जब मिसर म हतिया करे जाही,</para>
  <para style="q2" vid="EZK 30:4">तब ओकर धन-संपत्ति ले लिये जाही</para>
  <para style="q2" vid="EZK 30:4">अऊ ओकर नीवमन ला टोरके गिरा दिये जाही।<verse eid="EZK 30:4"/></para>
  <para style="m">
    <verse number="5" style="v" sid="EZK 30:5"/>कूस अऊ लिबिया, लूदी अऊ जम्मो अरब, कूब अऊ करार करे देस के मनखेमन, मिसरीमन के संग म तलवार ले मारे जाहीं।<verse eid="EZK 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 30:6"/>“ ‘यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 30:6">“ ‘मिसर के संगी देसमन नास हो जाहीं</para>
  <para style="q2" vid="EZK 30:6">अऊ ओकर घमंड ले भरे बल ह खतम हो जाही।</para>
  <para style="q1" vid="EZK 30:6">मिगदोल ले लेके असवान तक</para>
  <para style="q2" vid="EZK 30:6">ओमन ओकर भीतर ही तलवार ले मारे जाहीं,</para>
  <para style="q2" vid="EZK 30:6">परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 30:7"/>ओमन निरजन देसमन के बीच</para>
  <para style="q2" vid="EZK 30:7">निरजन हो जाहीं,</para>
  <para style="q1" vid="EZK 30:7">अऊ नास हो गय सहरमन के बीच</para>
  <para style="q2" vid="EZK 30:7">ओमन के सहरमन नास होके पड़े रहिहीं।<verse eid="EZK 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 30:8"/>जब मेंह मिसर म आगी लगाहूं,</para>
  <para style="q2" vid="EZK 30:8">अऊ ओकर जम्मो मददगारमन कुचरे जाहीं,</para>
  <para style="q2" vid="EZK 30:8">तब ओमन जानहीं कि मेंह यहोवा अंव।<verse eid="EZK 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 30:9"/>“ ‘ओ दिन मोर करा ले संदेसियामन जहाजमन म निकलके जाहीं अऊ कूस के मनखेमन ला ओमन के आत्म-संतोस होय ले डराहीं। मिसर के बिनास के दिन ओमन पीरा ले भर जाहीं, काबरकि अइसने जरूर होही।<verse eid="EZK 30:9"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="10" style="v" sid="EZK 30:10"/>“ ‘परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 30:10">“ ‘मेंह बेबिलोन के राजा नबूकदनेसर के हांथ ले</para>
  <para style="q2" vid="EZK 30:10">मिसर के उपदरवी मनखेमन के अन्त कर दूहूं।<verse eid="EZK 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 30:11"/>ओ अऊ ओकर सेना ला जऊन मन जम्मो जातिमन म बहुंत निरदयी अंय</para>
  <para style="q2" vid="EZK 30:11">ओ देस ला नास करे बर लाय जाही।</para>
  <para style="q1" vid="EZK 30:11">ओमन मिसर के ऊपर तलवार चलाहीं</para>
  <para style="q2" vid="EZK 30:11">अऊ देस ला हतिया करे गय मनखेमन ले भर दीहीं।<verse eid="EZK 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 30:12"/>मेंह नील नदी के पानी ला सूखा दूहूं</para>
  <para style="q2" vid="EZK 30:12">अऊ देस ला एक दुस्ट जाति के हांथ म बेच दूहूं;</para>
  <para style="q1" vid="EZK 30:12">परदेसीमन के दुवारा</para>
  <para style="q2" vid="EZK 30:12">मेंह देस अऊ ओमा के हर एक चीज ला उजाड़ दूहूं।</para>
  <para style="m" vid="EZK 30:12">में यहोवा ह कहे हवंव।<verse eid="EZK 30:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="EZK 30:13"/>“ ‘परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 30:13">“ ‘मेंह मूरतीमन ला नास कर दूहूं</para>
  <para style="q2" vid="EZK 30:13">अऊ मेमफीस सहर म मूरतीमन के अन्त कर दूहूं।</para>
  <para style="q1" vid="EZK 30:13">मिसर देस म फेर कोनो राजकुमार नइं होहीं,</para>
  <para style="q2" vid="EZK 30:13">अऊ मेंह पूरा देस म डर फईला दूहूं।<verse eid="EZK 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 30:14"/>मेंह ऊपरी मिसर ला उजाड़ दूहूं,</para>
  <para style="q2" vid="EZK 30:14">सोअन सहर म आगी लगा दूहूं</para>
  <para style="q2" vid="EZK 30:14">अऊ थेबेस सहर ला सजा दूहूं।<verse eid="EZK 30:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 30:15"/>पेलुसियम, जऊन ह मिसर के मजबूत नगर अय,</para>
  <para style="q2" vid="EZK 30:15">ओकरे ऊपर मोर कोप ह भड़कही,</para>
  <para style="q2" vid="EZK 30:15">अऊ मेंह थेबेस के उपदरवी मनखेमन ला नास कर दूहूं।<verse eid="EZK 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 30:16"/>मेंह मिसर म आगी लगा दूहूं;</para>
  <para style="q2" vid="EZK 30:16">पेलुसियम ह पीरा म तड़पही।</para>
  <para style="q1" vid="EZK 30:16">थेबेस नगर गरेर म उड़ जाही;</para>
  <para style="q2" vid="EZK 30:16">मेमफीस म लगातार दुख-पीरा बने रहिही।<verse eid="EZK 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 30:17"/>ओन<note caller="+" style="f"><char style="fr" closed="false">30:17 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">हिलियापुलिस</char></note> अऊ पीवेसेत<note caller="+" style="f"><char style="fr" closed="false">30:17 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बुबास्तिस</char></note> सहर के जवानमन</para>
  <para style="q2" vid="EZK 30:17">तलवार ले मारे जाहीं,</para>
  <para style="q2" vid="EZK 30:17">अऊ ये सहरमन बंधुवई म चले जाहीं।<verse eid="EZK 30:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 30:18"/>जब मेंह मिसर के जुड़ा ला टोरहूं,</para>
  <para style="q2" vid="EZK 30:18">तब तहपनहेस नगर म दिन म ही अंधियार हो जाही;</para>
  <para style="q2" vid="EZK 30:18">तब उहां ओकर घमंड ले भरे बल के अन्त हो जाही।</para>
  <para style="q1" vid="EZK 30:18">ओकर ऊपर बादर छा जाही,</para>
  <para style="q2" vid="EZK 30:18">अऊ ओकर गांवमन बंधुवई म चले जाहीं।<verse eid="EZK 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="EZK 30:19"/>ये किसम ले मेंह मिसर देस ला सजा दूहूं,</para>
  <para style="q2" vid="EZK 30:19">अऊ ओमन जानहीं कि मेंह यहोवा अंव।’ ”<verse eid="EZK 30:19"/></para>
  <para style="s2">फिरौन के बाहांमन टूट गे हवंय</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 30:20"/>हमर बंधुवई के गियारहवां बछर के, पहिला महिना के सातवां दिन, यहोवा के बचन ह मोर मेर आईस: <verse eid="EZK 30:20"/><verse number="21" style="v" sid="EZK 30:21"/>“हे मनखे के बेटा, मेंह मिसर के राजा फिरौन के बाहां ला टोर देय हंव। ओकर ईलाज बर ओला बांधे नइं गे हवय या ओमा पलस्तर नइं चघाय गे हवय ताकि ओह मजबूत होके तलवार ला धर सकय। <verse eid="EZK 30:21"/><verse number="22" style="v" sid="EZK 30:22"/>एकरसेति परमपरधान यहोवा ह ये कहत हे: मेंह मिसर के राजा फिरौन के बिरूध म हवंव। मेंह ओकर दूनों बाहांमन ला टोर दूहूं, बने बाहां के संगे-संग टूटे बाहां ला घलो, अऊ तलवार ला ओकर हांथ ले गिरवा दूहूं। <verse eid="EZK 30:22"/><verse number="23" style="v" sid="EZK 30:23"/>मेंह मिसरीमन ला जाति-जाति के मनखेमन के बीच एती-ओती फईला दूहूं अऊ देस-देस म ओमन ला तितिर-बितिर कर दूहूं। <verse eid="EZK 30:23"/><verse number="24" style="v" sid="EZK 30:24"/>मेंह बेबिलोन के राजा के बाहांमन ला मजबूत करहूं अऊ अपन तलवार ला ओकर हांथ म दे दूहूं, पर मेंह फिरौन के बाहांमन ला टोर दूहूं, अऊ ओह बेबिलोन के राजा के आघू म अइसन कलहरही, जइसन मरनेवाला एक घायल मनखे कलहरथे। <verse eid="EZK 30:24"/><verse number="25" style="v" sid="EZK 30:25"/>मेंह बेबिलोन के राजा के बाहांमन ला मजबूत करहूं, पर फिरौन के बाहांमन ढीला पड़ जाहीं। तब ओमन जानहीं कि मेंह यहोवा अंव, जब मेंह अपन तलवार बेबिलोन के राजा के हांथ म दे दूहूं अऊ ओह येकर उपयोग मिसर देस के बिरूध करही। <verse eid="EZK 30:25"/><verse number="26" style="v" sid="EZK 30:26"/>मेंह मिसरीमन ला जाति-जाति के मनखेमन के बीच फईला दूहूं अऊ ओमन ला देस-देस म तितिर-बितिर कर दूहूं। तब ओमन जानहीं कि मेंह यहोवा अंव।”<verse eid="EZK 30:26"/></para>
  <chapter eid="EZK 30"/>
  <chapter number="31" style="c" sid="EZK 31"/>
  <para style="s2">फिरौन ह लबानोन के एक गिरे देवदार के रूख के रूप म</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 31:1"/>गियारहवां बछर के, तीसरा महिना के पहिला दिन, यहोवा के बचन ह मोर मेर आईस: <verse eid="EZK 31:1"/><verse number="2" style="v" sid="EZK 31:2"/>“हे मनखे के बेटा, मिसर के राजा फिरौन अऊ ओकर उपदरवी मनखेमन ले कह:</para>
  <para style="q1" vid="EZK 31:2">“ ‘तोर गौरव के तुलना काकर संग करे जाय?<verse eid="EZK 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 31:3"/>अस्सूर ऊपर बिचार कर, जऊन ह एक समय लबानोन के एक देवदार रिहिस,</para>
  <para style="q2" vid="EZK 31:3">ओकर डारामन सुघर अऊ जंगल ला छइहां देवंय;</para>
  <para style="q1" vid="EZK 31:3">येह बहुंत ऊंच रिहिस,</para>
  <para style="q2" vid="EZK 31:3">अऊ ओकर टीप ह घना पानमन ऊपर रिहिस।<verse eid="EZK 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 31:4"/>पानी ले येकर सिंचई होवत रिहिस,</para>
  <para style="q2" vid="EZK 31:4">गहिला सोतामन येला ऊपर बढ़ाईन;</para>
  <para style="q1" vid="EZK 31:4">ओकर सोतामन येकर अधार के</para>
  <para style="q2" vid="EZK 31:4">चारों कोति बहत रिहिन</para>
  <para style="q1" vid="EZK 31:4">अऊ ओमन के धारामन मैदान के</para>
  <para style="q2" vid="EZK 31:4">जम्मो रूखमन तक जावंय।<verse eid="EZK 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 31:5"/>एकरसेति मैदान के जम्मो रूखमन ले</para>
  <para style="q2" vid="EZK 31:5">येह ऊंच हो गीस;</para>
  <para style="q1" vid="EZK 31:5">येकर डारामन बहुंत होय लगिन</para>
  <para style="q2" vid="EZK 31:5">अऊ येकर डारामन बढ़के लम्बा हो गीन,</para>
  <para style="q2" vid="EZK 31:5">काबरकि उहां बहुंत पानी रिहिस।<verse eid="EZK 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 31:6"/>अकास के जम्मो चिरई</para>
  <para style="q2" vid="EZK 31:6">ओकर डारामन म बसेरा करत रिहिन,</para>
  <para style="q1" vid="EZK 31:6">ओकर डारामन के खाल्हे म</para>
  <para style="q2" vid="EZK 31:6">जम्मो जंगली पसुमन पीला जनमात रिहिन;</para>
  <para style="q1" vid="EZK 31:6">जम्मो बड़े जातिमन</para>
  <para style="q2" vid="EZK 31:6">ओकर छइहां म रहत रिहिन।<verse eid="EZK 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 31:7"/>येह अपन फईले डारामन के संग,</para>
  <para style="q2" vid="EZK 31:7">सुघरता म सोभायमान रिहिस,</para>
  <para style="q1" vid="EZK 31:7">काबरकि येकर जरीमन खाल्हे</para>
  <para style="q2" vid="EZK 31:7">भरपूर पानी के सोतामन तक गे रिहिन।<verse eid="EZK 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 31:8"/>परमेसर के बारी के देवदार रूखमन</para>
  <para style="q2" vid="EZK 31:8">येकर तुलना म कुछू नइं रिहिन,</para>
  <para style="q1" vid="EZK 31:8">न ही सनोवरमन येकर</para>
  <para style="q2" vid="EZK 31:8">डारामन के बरोबरी कर सकत रिहिन,</para>
  <para style="q1" vid="EZK 31:8">न ही अरमोन रूखमन के तुलना</para>
  <para style="q2" vid="EZK 31:8">येकर डारामन ले करे जा सकत रिहिस—</para>
  <para style="q1" vid="EZK 31:8">परमेसर के बारी के कोनो भी रूख</para>
  <para style="q2" vid="EZK 31:8">येकर सुघरता के बरोबरी नइं कर सकत रिहिन।<verse eid="EZK 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 31:9"/>मेंह बहुंत डारामन के संग</para>
  <para style="q2" vid="EZK 31:9">येला सुघर बनांय,</para>
  <para style="q1" vid="EZK 31:9">परमेसर के बारी, अदन के जम्मो रूख</para>
  <para style="q2" vid="EZK 31:9">येकर ले जलन करत रिहिन।<verse eid="EZK 31:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 31:10"/>“ ‘एकरसेति परमपरधान यहोवा ह ये कहत हे: काबरकि बड़े देवदार ह घना पानमन के ऊपर बाढ़िस, अऊ काबरकि येला अपन ऊंचई के घमंड रिहिस, <verse eid="EZK 31:10"/><verse number="11" style="v" sid="EZK 31:11"/>एकरसेति मेंह ओला जाति-जाति के मनखेमन ऊपर सासन करइयामन के हांथ म कर देंव, ताकि ओकर संग ओकर दुस्टता के मुताबिक बरताव करे जावय। मेंह ओला अलग फटिक देंव, <verse eid="EZK 31:11"/><verse number="12" style="v" sid="EZK 31:12"/>अऊ परदेस के जाति-जाति के बीच म, जेमन सबले जादा निरदयी अंय, ओमन ओला काटके छोंड़ दीन। ओकर डारामन पहाड़मन म, अऊ सबो घाटीमन म गिरिन; ओकर साखामन देस के सबो घाटीमन म टूटे पड़े रिहिन। अऊ जाति-जाति के जम्मो मनखेमन ओकर छइहां ले निकल आईन अऊ ओला छोंड़ दीन। <verse eid="EZK 31:12"/><verse number="13" style="v" sid="EZK 31:13"/>ओ गिरे रूख म जम्मो चिरई बसेरा करे लगिन, अऊ जम्मो पसुमन ओकर डारामन के बीच रहे लगिन। <verse eid="EZK 31:13"/><verse number="14" style="v" sid="EZK 31:14"/>एकरसेति पानी के लकठा म आने कोनो रूख घना पानमन के बीच अपन टीप ला ऊपर करत घमंड से ऊंच झन होवय। भरपूर पानी के लकठा के कोनो आने रूख अइसन ऊंच झन होवय; ओ जम्मो के मरना जरूरी अय, काबरकि ओमन के जगह धरती के खाल्हे ओ मरनहार मनखेमन के बीच हवय, जेमन मिरतू-लोक म खाल्हे जाथें।<verse eid="EZK 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 31:15"/>“ ‘परमपरधान यहोवा ह ये कहत हे: जऊन दिन येला मिरतू-लोक म खाल्हे उतारे गीस, ओ दिन मेंह येकर बर सोक के संग गहिला सोतामन ला ढांप देंव, अऊ येकर सोतामन ला रोक देंव, अऊ येकर भरपूर पानी के सोतामन बंद हो गीन। येकर कारन मेंह लबानोन म उदासी ले आंय, अऊ मैदान के सबो रूखमन मुरझा गीन। <verse eid="EZK 31:15"/><verse number="16" style="v" sid="EZK 31:16"/>मेंह येकर गिरे के अवाज ले जाति-जाति के मनखेमन ला कंपा देंव, जब मेंह येला मिरतू-लोक म खाल्हे लानेंव, ताकि येह ओमन के संग रहय, जेमन खाल्हे कबर म जाथें। तब अदन के बारी के जम्मो रूख, लबानोन के चुने अऊ सबले बने, भरपूर पानी ले पलोय गय रूखमन ला धरती के खाल्हे म सांतवना मिलिस। <verse eid="EZK 31:16"/><verse number="17" style="v" sid="EZK 31:17"/>बड़े देवदार के रूख सहीं, ओमन घलो ओ मिरतू-लोक म खाल्हे गीन, जेमन तलवार ले मारे गे रिहिन; संग म ओ हथियारबंद आदमीमन घलो रिहिन, जेमन जाति-जाति के मनखेमन के बीच येकर छइहां म रहत रिहिन।<verse eid="EZK 31:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 31:18"/>“ ‘सोभा अऊ गौरव म, अदन के कोन रूख के तुलना तोर ले करे जा सकत हे? तभो ले तोला भी अदन के रूखमन के संग धरती के खाल्हे लाय जाही; तें ओ खतनारहित मनखेमन के बीच पड़े रहिबे, जेमन तलवार ले मारे गे हवंय।</para>
  <para style="p" vid="EZK 31:18">“ ‘अइसने फिरौन अऊ ओकर जम्मो उपदरवी मनखेमन के संग होही, परमपरधान यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 31:18"/></para>
  <chapter eid="EZK 31"/>
  <chapter number="32" style="c" sid="EZK 32"/>
  <para style="s2">फिरौन बर एक बिलापगीत</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 32:1"/>हमर बंधुवई के बारहवां बछर के, बारहवां महिना के पहिला दिन, यहोवा के बचन ह मोर मेर आईस: <verse eid="EZK 32:1"/><verse number="2" style="v" sid="EZK 32:2"/>“हे मनखे के बेटा, मिसर के राजा फिरौन के बिसय म एक बिलापगीत ले अऊ ओला कह:</para>
  <para style="q1" vid="EZK 32:2">“ ‘जाति-जाति के मनखेमन के बीच तेंह एक सिंह सहीं अस;</para>
  <para style="q2" vid="EZK 32:2">समुंदर म तें एक बहुंत बड़े जन्तु सहीं अस</para>
  <para style="q1" vid="EZK 32:2">तें अपन सोतामन म मजा लेथस,</para>
  <para style="q2" vid="EZK 32:2">अपन पांव ले पानी ला एती-ओती करथस</para>
  <para style="q2" vid="EZK 32:2">अऊ सोतामन ला चीखला ले भर देथस।<verse eid="EZK 32:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 32:3"/>“ ‘परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 32:3">“ ‘मनखेमन के एक बड़े भीड़ के संग</para>
  <para style="q2" vid="EZK 32:3">में तोर ऊपर अपन जाल ला फईलाहूं,</para>
  <para style="q2" vid="EZK 32:3">अऊ ओमन तोला मोर जाल म ऊपर खींच लीहीं।<verse eid="EZK 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 32:4"/>मेंह तोला भुइयां म फटिक दूहूं</para>
  <para style="q2" vid="EZK 32:4">अऊ खुला मैदान म जोर से पटक दूहूं।</para>
  <para style="q1" vid="EZK 32:4">मेंह अकास के जम्मो चिरईमन ला तोर ऊपर बसेरा करवाहूं</para>
  <para style="q2" vid="EZK 32:4">अऊ जंगल के जम्मो पसु तोर मांस ला ठूंस-ठूंसके खाहीं।<verse eid="EZK 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 32:5"/>मेंह तोर मांस ला पहाड़मन म फईला दूहूं</para>
  <para style="q2" vid="EZK 32:5">अऊ घाटीमन ला तोर बांचे भागमन ले भर दूहूं।<verse eid="EZK 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 32:6"/>मेंह तोर बहत खून ले</para>
  <para style="q2" vid="EZK 32:6">पहाड़मन तक के भुइयां ला भिगो दूहूं,</para>
  <para style="q2" vid="EZK 32:6">अऊ घाटीमन तोर मांस ले भर जाहीं।<verse eid="EZK 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 32:7"/>जब मेंह तोला सुंघके निकालहूं, तब मेंह अकास ला ढांप दूहूं</para>
  <para style="q2" vid="EZK 32:7">अऊ ओकर तारामन ला अंधियार कर दूहूं;</para>
  <para style="q1" vid="EZK 32:7">मेंह सूरज ला बादर ले ढांप दूहूं,</para>
  <para style="q2" vid="EZK 32:7">अऊ चंदा ह अपन अंजोर नइं दीही।<verse eid="EZK 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 32:8"/>अकास म चमकत जम्मो अंजोरमन ला</para>
  <para style="q2" vid="EZK 32:8">मेंह तोर बर अंधियार कर दूहूं;</para>
  <para style="q2" vid="EZK 32:8">मेंह तोर देस म अंधियार ले आहूं, परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 32:9"/>जब जाति-जाति के मनखेमन के बीच</para>
  <para style="q2" vid="EZK 32:9">अऊ ओ देसमन के बीच, जेला तेंह नइं जानस,</para>
  <para style="q2" vid="EZK 32:9">मेंह तोर बिनास के बात लाहूं, तब मेंह बहुंते मनखेमन के मन ला बियाकुल करहूं।<verse eid="EZK 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 32:10"/>जब में ओमन के आघू म अपन तलवार चलाहूं,</para>
  <para style="q2" vid="EZK 32:10">तब में बहुंते मनखेमन ला तोर ले भयभीत करवाहूं,</para>
  <para style="q2" vid="EZK 32:10">अऊ ओमन के राजामन तोर कारन बहुंते भयभीत होके कांपहीं।</para>
  <para style="q1" vid="EZK 32:10">तोर पतन के दिन</para>
  <para style="q2" vid="EZK 32:10">ओमा के हर एक झन</para>
  <para style="q2" vid="EZK 32:10">अपन जिनगी बर हर पल कांपही।<verse eid="EZK 32:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 32:11"/>“ ‘काबरकि परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="EZK 32:11">“ ‘बेबिलोन के राजा के तलवार</para>
  <para style="q2" vid="EZK 32:11">तोर ऊपर चलही।<verse eid="EZK 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 32:12"/>मेंह तोर उपदरवी मनखेमन ला</para>
  <para style="q2" vid="EZK 32:12">सक्तिसाली आदमीमन के तलवार ले मरवाहूं—</para>
  <para style="q2" vid="EZK 32:12">ये सक्तिसाली आदमीमन जम्मो जाति म सबले जादा निरदयी अंय।</para>
  <para style="q1" vid="EZK 32:12">ओमन मिसर के घमंड ला चकनाचूर कर दीहीं,</para>
  <para style="q2" vid="EZK 32:12">अऊ ओकर जम्मो उपदरवी मनखेमन नास कर दिये जाहीं।<verse eid="EZK 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 32:13"/>में ओकर जम्मो पसुमन ला</para>
  <para style="q2" vid="EZK 32:13">पानीवाले तरियामन के तीर ले नास कर दूहूं</para>
  <para style="q1" vid="EZK 32:13">जेकर ले पानी ह मनखे के गोड़ ले मईला नइं होही</para>
  <para style="q2" vid="EZK 32:13">अऊ न ही पसुमन के खुर ले उहां गंदा चीखला होही।<verse eid="EZK 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 32:14"/>तब मेंह ओमा के पानी ला निरमल कर दूहूं</para>
  <para style="q2" vid="EZK 32:14">अऊ ओकर सोतामन ले पानी ला तेल असन बहाहूं,</para>
  <para style="q2" vid="EZK 32:14">परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 32:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 32:15"/>जब मेंह मिसर देस ला उजाड़हूं</para>
  <para style="q2" vid="EZK 32:15">अऊ देस के जम्मो चीज ला छीन लूहूं,</para>
  <para style="q1" vid="EZK 32:15">जब में उहां रहइया जम्मो झन ला मार डारहूं,</para>
  <para style="q2" vid="EZK 32:15">तब ओमन जानहीं कि मेंह यहोवा अंव।’<verse eid="EZK 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 32:16"/>“येह ओ बिलापगीत अय, जेला ओमन ओकर बर गाहीं। जाति-जाति के बेटीमन येला गाहीं; मिसर अऊ ओकर जम्मो उपदरवी मनखेमन बर ओमन येला गाहीं, परमपरधान यहोवा ह घोसना करत हे।”<verse eid="EZK 32:16"/></para>
  <para style="s2">मिसर के बंसज मिरतू-लोक म</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 32:17"/>हमर बंधुवई के बारहवां बछर के, पहिला महिना के पंदरहवां दिन, यहोवा के बचन मोर मेर आईस: <verse eid="EZK 32:17"/><verse number="18" style="v" sid="EZK 32:18"/>“हे मनखे के बेटा, मिसर देस के उपदरवी मनखेमन बर सोक मना अऊ ओला अऊ सक्तिसाली जातिमन के बेटीमन ला ओ मनखेमन के संग धरती ला सऊंप दे, जेमन खाल्हे कबर म जाथें। <verse eid="EZK 32:18"/><verse number="19" style="v" sid="EZK 32:19"/>ओमन ले कह, ‘का तुम्हर ऊपर आने मन ले जादा किरपा होथे? खाल्हे जाके खतनारहित मनखेमन के बीच लेट जावव।’ <verse eid="EZK 32:19"/><verse number="20" style="v" sid="EZK 32:20"/>ओमन ओहीच मनखेमन के बीच गिरहीं, जेमन तलवार ले मारे गे हवंय। तलवार ला मियान ले निकाले गे हवय; ओला ओकर जम्मो उपदरवी मनखेमन के संग घसीटके ले जावव। <verse eid="EZK 32:20"/><verse number="21" style="v" sid="EZK 32:21"/>मिरतू-लोक के भीतर के ही सक्तिसाली अगुवामन मिसर अऊ ओकर संग के मनखेमन के बारे म कहिहीं, ‘ओमन खाल्हे आ गे हवंय अऊ ओमन ओ खतनारहित मनखेमन के संग पड़े हवंय, जेमन तलवार ले मारे गे हवंय।’<verse eid="EZK 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 32:22"/>“अपन जम्मो सेना समेत अस्सूर घलो उहां हवय; ओकर मारे गय जम्मो मनखेमन के कबर ओकर चारों खूंट म हवय, ओ जम्मो जेमन तलवार ले मारे गे हवंय। <verse eid="EZK 32:22"/><verse number="23" style="v" sid="EZK 32:23"/>ओमन के कबरमन खंचवामन के गहरई म हवंय अऊ ओकर सेना ओकर कबर के चारों खूंट लेटे हवय। ओ जम्मो जेमन जीयतमन के देस म आतंक फईलाय रिहिन, मार डारे गे हवंय, ओमन तलवार ले मारे गे हवंय।<verse eid="EZK 32:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 32:24"/>“एलाम उहां हवय, अऊ ओकर जम्मो उपदरवी मनखेमन ओकर कबर के चारों खूंट हवंय। ओ जम्मो तलवार ले मारे गे हवंय। ओ जम्मो जेमन जीयत मनखेमन के देस म आतंक फईलाय रिहिन, ओमन खाल्हे धरती म खतनारहित दसा म चले गे हवंय। ओमन ओ मनखेमन के संग सरमिंदा हवंय, जेमन खाल्हे कबर म जाथें। <verse eid="EZK 32:24"/><verse number="25" style="v" sid="EZK 32:25"/>मारे गय मनखेमन के बीच ओकर बर एक बिस्तर बनाय गे हवय, अऊ ओकर जम्मो उपदरवी मनखेमन ओकर कबर के चारों कोति हवंय। ओ जम्मो के जम्मो खतनारहित मनखे अंय अऊ तलवार ले मारे गे हवंय। काबरकि ओमन के आतंक जीयतमन के देस म फईले रिहिस, एकरसेति ओमन ओ मनखेमन के संग सरमिंदा हवंय, जेमन खाल्हे कबर म जाथें; ओमन ला मारे गय मनखेमन के बीच रखे गे हवय।<verse eid="EZK 32:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 32:26"/>“मेसेक अऊ तूबल उहां हवंय, अऊ ओमन के जम्मो उपदरवी मनखे ओमन के कबर के चारों खूंट हवंय। ओ जम्मो के जम्मो खतनारहित मनखे अंय अऊ तलवार ले मारे गे हवंय काबरकि जीयत मनखेमन के देस म ओमन आतंक फईलाय रिहिन। <verse eid="EZK 32:26"/><verse number="27" style="v" sid="EZK 32:27"/>पर ओमन ओ मर गय पुराना योद्धामन<note caller="+" style="f"><char style="fr" closed="false">32:27 </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">योद्धामन </char><char style="fqa" closed="false">जेमन बिगर खतना के रिहिन</char></note> के संग नइं पड़े हवंय, जेमन अपन लड़ई के हथियार के संग मिरतू-लोक म खाल्हे चले गीन—ओमन के तलवारमन ओमन के मुड़ी के खाल्हे म माढ़े रिहिन अऊ ओमन के ढालमन ओमन के हाड़ामन म पड़े रिहिन—हालाकि ये योद्धामन घलो जीयत मनखेमन के देस ला आतंकित करके रखे रिहिन।<verse eid="EZK 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 32:28"/>“हे फिरौन, तोला घलो कुटा-कुटा कर दिये जाही अऊ तेंह घलो ओ खतनारहित मनखेमन के बीच पड़े रहिबे, जेमन तलवार ले मारे गे हवंय।<verse eid="EZK 32:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 32:29"/>“एदोम, ओकर राजामन अऊ ओकर जम्मो राजकुमारमन उहां हवंय; अपन सक्ति के बावजूद, ओमन ओ मनखेमन के संग पड़े हवंय, जेमन तलवार ले मारे गे हवंय। ओमन ओ खतनारहित मनखेमन के संग पड़े हवंय, जेमन खाल्हे कबर म जाथें।<verse eid="EZK 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 32:30"/>“उत्तर दिग के जम्मो हाकिम अऊ जम्मो सीदोनीमन घलो उहां हवंय; अपन सक्ति ले आतंक फईलाय के बावजूद, ओमन कलंकित होके मारे गय मनखेमन के संग कबर म चले गीन। ओमन खतनारहित दसा म ओमन के संग पड़े हवंय, जेमन तलवार ले मारे गे हवंय अऊ ओमन के संग सरमिंदा हवंय, जेमन खाल्हे कबर म जाथें।<verse eid="EZK 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZK 32:31"/>“फिरौन—ओ अऊ ओकर जम्मो सेना—येमन ला देखहीं अऊ ओला अपन ओ जम्मो उपदरवी मनखेमन के बारे म सांतवना मिलही, जेमन तलवार ले मारे गे रिहिन, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 32:31"/><verse number="32" style="v" sid="EZK 32:32"/>हालाकि मेंह जीयत मनखेमन के देस म फिरौन के आतंक फईला देय रहेंव, तभो ले ओह अऊ ओकर जम्मो उपदरवी मनखे ओ खतनारहित मनखेमन के बीच पड़े रहिहीं, जेमन तलवार ले मारे गे हवंय, परमपरधान यहोवा ह घोसना करत हे।”<verse eid="EZK 32:32"/></para>
  <chapter eid="EZK 32"/>
  <chapter number="33" style="c" sid="EZK 33"/>
  <para style="s1">पहरेदार के रूप म यहेजकेल के बुलावा के नवीनीकरन</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 33:1"/>यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 33:1"/><verse number="2" style="v" sid="EZK 33:2"/>“हे मनखे के बेटा, अपन मनखेमन ले गोठिया अऊ ओमन ला कह: ‘जब में कोनो देस ऊपर तलवार चलाथंव, अऊ ओ देस के मनखेमन अपन कोनो आदमी ला चुनके पहरेदार बनाथें, <verse eid="EZK 33:2"/><verse number="3" style="v" sid="EZK 33:3"/>अऊ ओ पहरेदार ह देखथे कि देस के बिरूध तलवार चलइया हे अऊ ओह तुरही फूंकके मनखेमन ला चेताथे, <verse eid="EZK 33:3"/><verse number="4" style="v" sid="EZK 33:4"/>तब कहूं कोनो मनखे तुरही के अवाज ला सुनके चेतउनी ऊपर धियान नइं देवय अऊ तलवार ह आके ओकर परान ले लेथे, त ओकर खून के दोस ओकरेच मुड़ ऊपर होही। <verse eid="EZK 33:4"/><verse number="5" style="v" sid="EZK 33:5"/>ओह तुरही के अवाज ला सुनिस, पर चेतउनी ऊपर धियान नइं दीस, एकरसेति ओकर खून के दोस ओकरेच मुड़ ऊपर होही। यदि ओह चेतउनी ऊपर धियान देय रहितिस, त ओह अपन परान ला बचा लेतिस। <verse eid="EZK 33:5"/><verse number="6" style="v" sid="EZK 33:6"/>पर यदि पहरेदार ह बईरी के तलवार ला आवत देखथे अऊ मनखेमन ला चेतउनी देय बर तुरही नइं फूंकय अऊ तलवार ह आके कोनो मनखे के परान ले लेथे, त ओकर पाप के कारन ओ मनखे के परान ले लिये जाही, पर में ओकर खून बर ओ पहरेदार ला जिम्मेदार ठहिराहूं।’<verse eid="EZK 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 33:7"/>“हे मनखे के बेटा, मेंह तोला इसरायल के मनखेमन बर एक पहरेदार ठहिराय हंव; एकरसेति जऊन बात मेंह कहत हंव, ओला सुन अऊ ओमन ला मोर कोति ले चेता दे। <verse eid="EZK 33:7"/><verse number="8" style="v" sid="EZK 33:8"/>जब मेंह दुस्ट मनखे ला कहिथंव, ‘हे दुस्ट मनखे, तेंह जरूर मरबे,’ अऊ तें ओ मनखे ला ओकर चालचलन बदले बर नइं कहस, त ओ दुस्ट मनखे ह अपन पाप के कारन मरही, अऊ मेंह तोला ओकर खून बर जिम्मेदार ठहिराहूं। <verse eid="EZK 33:8"/><verse number="9" style="v" sid="EZK 33:9"/>पर यदि तेंह दुस्ट मनखे ला ओकर चालचलन बदले बर चेताथस अऊ ओह अपन चालचलन ला नइं बदलय, त ओह अपन पाप के कारन मरही, पर तेंह खुद बच जाबे।<verse eid="EZK 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 33:10"/>“हे मनखे के बेटा, इसरायलीमन ले कह, ‘तुमन ये कहत हव: “हमर पाप अऊ अपराध हमन ला खाल्हे गिराथें, अऊ हमन ओमन के कारन बेकार होवत हन। तब हमन कइसे जीयत रह सकत हन?” ’ <verse eid="EZK 33:10"/><verse number="11" style="v" sid="EZK 33:11"/>ओमन ले कह, ‘मोर जिनगी के सपथ, परमपरधान यहोवा ह घोसना करत हे, में दुस्ट मनखे के मरे ले खुस नइं होवंव, पर बने ये होही कि ओह अपन चालचलन ला बदले अऊ जीयत रहय। बदलव! अपन खराप चालचलन ला बदलव! हे इसरायल के मनखेमन, तुमन काबर मरहू?’<verse eid="EZK 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 33:12"/>“एकरसेति, हे मनखे के बेटा, अपन मनखेमन ले कह, ‘यदि कोनो धरमी मनखे हुकूम ला नइं माने, तब ओकर पहिले के धरमीपन के कोनो मतलब नइं होवय। पर यदि दुस्ट मनखे ह पछताप करथे, त ओ मनखे के पहिले के दुस्टता के कारन ओला दंड नइं मिलय। जऊन धरमी मनखे ह पाप करथे, त ओह जीयत नइं रहय, हालाकि पहिले ओह धरमी रिहिस।’ <verse eid="EZK 33:12"/><verse number="13" style="v" sid="EZK 33:13"/>यदि मेंह एक धरमी ले कहंव कि ओह जरूर जीयत रहिही, पर तब ओह अपन धरमीपन म भरोसा करके दुस्ट काम करे लगथे, तब ओकर दुवारा करे गय कोनो भी धरमी काम ला सुरता नइं करे जाही; ओह अपन करे गय दुस्ट काम के कारन मरही। <verse eid="EZK 33:13"/><verse number="14" style="v" sid="EZK 33:14"/>अऊ यदि में कोनो दुस्ट मनखे ले ये कहिथंव, ‘तेंह जरूर मरबे,’ पर तब ओह अपन पाप ले मन फिराथे अऊ ओ काम करथे, जऊन ह उचित अऊ सही अय— <verse eid="EZK 33:14"/><verse number="15" style="v" sid="EZK 33:15"/>यदि ओह गिरवी रखे चीज ला लहुंटा देथे, चोरी करे गय चीज ला लहुंटा देथे, जिनगी देवइया नियममन के पालन करथे, अऊ कोनो दुस्टता नइं करय—त ओ मनखे ह जरूर जीयत रहिही; ओह नइं मरय। <verse eid="EZK 33:15"/><verse number="16" style="v" sid="EZK 33:16"/>ओकर दुवारा करे गय कोनो भी पाप ला फेर सुरता नइं करे जाही। ओह उचित अऊ सही काम करे हवय; ओह जरूर जीयत रहिही।<verse eid="EZK 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 33:17"/>“तभो ले तुम्हर मनखेमन कहिथें, ‘परभू के नीति ह उचित नो हय।’ पर येह ओमन के नीति अय, जऊन ह नियाय-संगत नो हय। <verse eid="EZK 33:17"/><verse number="18" style="v" sid="EZK 33:18"/>यदि कोनो धरमी मनखे अपन धरमीपन ला छोंड़के दुस्ट काम करथे, त ओह अपन दुस्ट काम के कारन मरही। <verse eid="EZK 33:18"/><verse number="19" style="v" sid="EZK 33:19"/>अऊ यदि कोनो दुस्ट मनखे अपन दुस्टता ला छोंड़ देथे, अऊ ओ काम करथे, जऊन ह उचित अऊ सही अय, त ओह अपन ये काममन के कारन जीयत रहिही। <verse eid="EZK 33:19"/><verse number="20" style="v" sid="EZK 33:20"/>तभो ले तुम इसरायलीमन कहिथव, ‘परभू के नीति ह उचित नो हय।’ पर में तुमन म ले हर एक के नियाय ओकर काम के मुताबिक करहूं।”<verse eid="EZK 33:20"/></para>
  <para style="s1">यरूसलेम के पतन के खुलासा</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 33:21"/>हमर बंधुवई के बारहवां बछर के दसवां महिना के पांचवां दिन, एक मनखे, जऊन ह यरूसलेम ले भागके बांच गेय रिहिस, ओह मोर मेर आके कहिस, “सहर<note caller="+" style="f"><char style="fr" closed="false">33:21 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरूसलेम</char></note> के पतन हो गे हवय!” <verse eid="EZK 33:21"/><verse number="22" style="v" sid="EZK 33:22"/>ओ मनखे के आय के पहिली के सांझ के बेरा यहोवा के किरपा मोर ऊपर होईस, अऊ ओह मोर मुहूं ला ओ मनखे के आघू म खोलिस, जेह बिहनियां मोर मेर आईस। ये किसम ले मोर मुहूं ह खुल गीस अऊ फेर मेंह चुप नइं रहेंव।<verse eid="EZK 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 33:23"/>तब यहोवा के बचन ह मोर मेर आईस: <verse eid="EZK 33:23"/><verse number="24" style="v" sid="EZK 33:24"/>“हे मनखे के बेटा, ओ मनखे, जेमन इसरायल देस के खंडहरमन म रहत हवंय, ओमन कहत हें, ‘अब्राहम ह सिरिप एकेच झन रिहिस, तभो ले ओह देस ऊपर अधिकार कर लीस; पर हमन तो अब्बड़ झन हवन; खचित ये देस हमन ला हमर अधिकार म दिये गे हवय।’ <verse eid="EZK 33:24"/><verse number="25" style="v" sid="EZK 33:25"/>एकरसेति ओमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: जब तुमन मांस ला खून समेत खाथव, अऊ अपन मूरतीमन कोति देखके खून करथव, तब का तुमन ला ओ देस ऊपर अधिकार करना चाही? <verse eid="EZK 33:25"/><verse number="26" style="v" sid="EZK 33:26"/>तुमन अपन तलवार ऊपर निरभर रहिथव, तुमन घिनौना काम करथव, अऊ तुमन म ले हर एक अपन परोसी के घरवाली ला असुध करथव। तब का तुमन ला ओ देस ऊपर अधिकार करना चाही?’<verse eid="EZK 33:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 33:27"/>“तें ओमन ले ये कह: ‘परमपरधान यहोवा ह ये कहत हे: मोर जिनगी के कसम, जेमन ये खंडहरमन म रहत हवंय ओमन तलवार ले मारे जाहीं, जऊन मन खुले मैदान म हवंय, ओमन ला मेंह जंगली पसुमन के आहार होय बर दे दूहूं, अऊ जऊन मन गढ़मन अऊ गुफामन म हवंय, ओमन महामारी ले मारे जाहीं। <verse eid="EZK 33:27"/><verse number="28" style="v" sid="EZK 33:28"/>मेंह ओ देस ला उजाड़ अऊ निरजन बना दूहूं, अऊ ओकर घमंड ले भरे ताकत के अन्त हो जाही, अऊ इसरायल के पहाड़मन सुनसान हो जाहीं, जेकर कारन उहां ले होवत कोनो भी नइं जाहीं। <verse eid="EZK 33:28"/><verse number="29" style="v" sid="EZK 33:29"/>ओ मनखेमन के दुवारा करे गय जम्मो घिनौना काममन के कारन जब में ओ देस ला उजाड़ अऊ निरजन बना दूहूं, तब ओमन जानहीं कि मेंह यहोवा अंव।’<verse eid="EZK 33:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 33:30"/>“हे मनखे के बेटा, जहां तक तोर बात ए, तोर मनखेमन तोर बारे म भीथीमन के तीर अऊ घरमन के कपाटमन म एक संग गोठियावत हें अऊ एक-दूसर ले ये कहत हें, ‘आवव अऊ ओ संदेस ला सुनव, जऊन ह यहोवा कोति ले आय हवय।’ <verse eid="EZK 33:30"/><verse number="31" style="v" sid="EZK 33:31"/>मोर मनखेमन तोर मेर आथें, जइसे कि ओमन सधारन रूप म करथें, अऊ ओमन तोर बचन सुने बर तोर आघू म बईठथें, पर ओमन ओ बचन के मुताबिक नइं चलंय। ओमन मुहूं ले मया के बात तो करथें, पर ओमन के मन ह अनियाय के कमई म लगे रहिथे। <verse eid="EZK 33:31"/><verse number="32" style="v" sid="EZK 33:32"/>वास्तव म, तेंह ओमन के नजर म सिरिप एक अइसने मनखे अस, जऊन ह मीठा अवाज म मया के गीत गाथे अऊ बढ़िया बाजा बजाथे, काबरकि ओमन तोर बचन ला तो सुनथें, पर ओ बचन के मुताबिक नइं चलंय।<verse eid="EZK 33:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 33:33"/>“जब ये जम्मो बातमन घटहीं—अऊ येमन जरूर होहीं—तब ओमन जानहीं कि ओमन के बीच एक अगमजानी रिहिस।”<verse eid="EZK 33:33"/></para>
  <chapter eid="EZK 33"/>
  <chapter number="34" style="c" sid="EZK 34"/>
  <para style="s1">यहोवा ह इसरायल के चरवाहा होही</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 34:1"/>यहोवा के बचन ह मोर मेर आईस: <verse eid="EZK 34:1"/><verse number="2" style="v" sid="EZK 34:2"/>“हे मनखे के बेटा, इसरायल के चरवाहामन के बिरूध म अगमबानी कर; अगमबानी कर अऊ ओमन ले कह: ‘परमपरधान यहोवा ह ये कहत हे: हे इसरायल के चरवाहामन, तुम्हर ऊपर धिक्कार ए, जेमन सिरिप अपनेच खियाल रखथव! का चरवाहामन ला झुंड के देखरेख नइं करना चाही? <verse eid="EZK 34:2"/><verse number="3" style="v" sid="EZK 34:3"/>तुमन दही खाथव, ऊन के ओनहा पहिरथव अऊ खाय बर छांटके पसुमन ला काटथव, पर तुमन झुंड के खियाल नइं रखव। <verse eid="EZK 34:3"/><verse number="4" style="v" sid="EZK 34:4"/>तुमन बिमरहामन ला बलवान नइं करेव, न ही रोगीमन ला चंगा करेव, अऊ न ही घायलमन ला मरहम पट्टी करेव। तुमन भटके मन ला सही रसता म नइं लानेव या गंवायमन ला नइं खोजेव। तुमन ओमन ऊपर कठोरता अऊ निरदयता से सासन करे हव। <verse eid="EZK 34:4"/><verse number="5" style="v" sid="EZK 34:5"/>कोनो चरवाहा नइं होय के कारन ओमन तितिर-बितिर हो गीन, अऊ जब ओमन तितिर-बितिर हो गीन, त ओमन जम्मो जंगली पसुमन के खाना हो गीन। <verse eid="EZK 34:5"/><verse number="6" style="v" sid="EZK 34:6"/>मोर भेड़मन जम्मो पहाड़मन अऊ ऊंच-ऊंच पहाड़ीमन ऊपर भटकत रिहिन। ओमन जम्मो धरती ऊपर तितिर-बितिर हो गीन, अऊ कोनो भी ओमन ला नइं खोजिन या ओमन के खियाल नइं रखिन।<verse eid="EZK 34:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 34:7"/>“ ‘एकरसेति हे चरवाहामन, यहोवा के बचन ला सुनव: <verse eid="EZK 34:7"/><verse number="8" style="v" sid="EZK 34:8"/>परमपरधान यहोवा ह घोसना करत हे, मोर जिनगी के कसम, काबरकि मोर झुंड के कोनो चरवाहा नइं एं अऊ एकरसेति ओला लूटे गे हवय अऊ ओह जम्मो जंगली पसुमन के आहार बन गे हवय, अऊ काबरकि मोर चरवाहामन मोर झुंड के खोज नइं करिन अऊ मोर झुंड ऊपर धियान देय के बदले अपनआप के ही धियान रखिन, <verse eid="EZK 34:8"/><verse number="9" style="v" sid="EZK 34:9"/>एकरसेति, हे चरवाहामन, यहोवा के बचन ला सुनव: <verse eid="EZK 34:9"/><verse number="10" style="v" sid="EZK 34:10"/>परमपरधान यहोवा ह ये कहत हे: मेंह चरवाहामन के बिरूध हवंव अऊ मेंह ओमन ले अपन झुंड के लेखा लूहूं। मेंह ओमन ला झुंड ला चराय के काम ले हटा दूहूं ताकि चरवाहामन फेर अपन भरन-पोसन झन कर सकंय। मेंह ओमन के मुहूं ले अपन झुंड ला छोंड़ाहूं, अऊ ओमन फेर चरवाहामन के जेवन नइं होहीं।<verse eid="EZK 34:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 34:11"/>“ ‘काबरकि परमपरधान यहोवा ह ये कहत हे: मेंह खुद अपन भेड़मन ला खोजहूं अऊ ओमन के देखभाल करहूं। <verse eid="EZK 34:11"/><verse number="12" style="v" sid="EZK 34:12"/>जइसने एक चरवाहा अपन बगरे झुंड के देखभाल करथे, जब ओह ओमन के संग होथे, वइसनेच मेंह घलो अपन भेड़मन के देखभाल करहूं। मेंह ओमन ला ओ जम्मो ठऊरमन ले निकालके ले आहूं, जिहां ओमन बादर अऊ अंधियार के दिन म तितिर-बितिर हो गे रिहिन। <verse eid="EZK 34:12"/><verse number="13" style="v" sid="EZK 34:13"/>मेंह ओमन ला जाति-जाति के मनखेमन के बीच ले निकाल लानहूं अऊ ओमन ला देस-देस ले इकट्ठा करहूं, अऊ मेंह ओमन ला ओमन के खुद के देस म ले आहूं। मेंह ओमन ला इसरायल के पहाड़मन ऊपर, घाटीमन म अऊ देस के ओ जम्मो जगह म चराहूं, जिहां मनखेमन बस गे हवंय। <verse eid="EZK 34:13"/><verse number="14" style="v" sid="EZK 34:14"/>मेंह ओमन ला बने चरागन म चराहूं, अऊ इसरायल के पहाड़ के ऊंच-ऊंच जगहमन ओमन के चरे के भुइयां होहीं। उहां ओमन चरे के बने जगह म बईठहीं, अऊ उहां ओमन इसरायल के पहाड़मन ऊपर एक ठन बने चरागन म चरहीं। <verse eid="EZK 34:14"/><verse number="15" style="v" sid="EZK 34:15"/>मेंह खुद अपन भेड़मन ला चराहूं अऊ ओमन ला अराम करवाहूं, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 34:15"/><verse number="16" style="v" sid="EZK 34:16"/>मेंह गंवायमन ला खोजहूं अऊ भटकेमन ला वापिस ले आहूं। मेंह घायलमन ला मरहम पट्टी करहूं अऊ जेमन कमजोर हवंय, ओमन ला ताकतवर बनाहूं, पर जेमन चिकना अऊ मोटा-ताजा हवंय, ओमन ला नास करहूं। मेंह नियाय के संग झुंड के देखभाल करहूं।<verse eid="EZK 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 34:17"/>“ ‘जहां तक तुम्हर बात ए, हे मोर झुंड, परमपरधान यहोवा ह ये कहत हे: मेंह एक भेड़ अऊ दूसर भेड़ के बीच, अऊ मेढ़ा अऊ बोकरामन के बीच नियाय करहूं। <verse eid="EZK 34:17"/><verse number="18" style="v" sid="EZK 34:18"/>का येह तुम्हर बर परयाप्त नो हय कि तुमन बने चरागन म चरव? का जरूरी अय कि अपन बाकि बचे चरागन ला अपन गोड़ ले कुचर दव? का निरमल पानी पीयई तुम्हर बर परयाप्त नो हय? का जरूरी अय कि बाकि पानी ला अपन गोड़ ले गंदा कर दव? <verse eid="EZK 34:18"/><verse number="19" style="v" sid="EZK 34:19"/>का जरूरी अय कि मोर झुंड ह ओमा ले खावय, जेला तुमन कुचर दे हव अऊ ओमा ले पीयय, जेला तुमन अपन गोड़ ले मतला दे हव?<verse eid="EZK 34:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 34:20"/>“ ‘एकरसेति परमपरधान यहोवा ह ओमन ले ये कहत हे: देखव, मेंह खुद मोटहा भेड़ अऊ पातर भेड़मन के बीच नियाय करहूं। <verse eid="EZK 34:20"/><verse number="21" style="v" sid="EZK 34:21"/>काबरकि तुमन जम्मो दुरबल भेड़मन ला अपन बाजू अऊ अपन कंधा ले तब तक ढकेलत अऊ सींग मारत रहिहू, जब तक कि ओमन दूरिहा नइं चले जावंय, <verse eid="EZK 34:21"/><verse number="22" style="v" sid="EZK 34:22"/>मेंह अपन झुंड ला बचाहूं, अऊ ओमन ला फेर नइं लूटे जाही। मेंह एक भेड़ अऊ दूसर भेड़ के बीच नियाय करहूं। <verse eid="EZK 34:22"/><verse number="23" style="v" sid="EZK 34:23"/>मेंह ओमन ऊपर एक चरवाहा, अपन सेवक दाऊद ला ठहिराहूं, अऊ ओह ओमन ला चराही; ओह ओमन ला चराही अऊ ओमन के चरवाहा होही। <verse eid="EZK 34:23"/><verse number="24" style="v" sid="EZK 34:24"/>में यहोवा ह ओमन के परमेसर ठहिरहूं, अऊ मोर सेवक दाऊद ह ओमन के बीच हाकिम होही। में यहोवा ह ये कहे हवंव।<verse eid="EZK 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 34:25"/>“ ‘में ओमन के संग सांति के एक करार करहूं अऊ देस ला दुस्ट पसुमन ले छुटकारा दूहूं, ताकि ओमन निरजन प्रदेस म सुरकछित रहंय अऊ जंगल म बिगर डरके सोवंय। <verse eid="EZK 34:25"/><verse number="26" style="v" sid="EZK 34:26"/>मेंह ओमन ला अऊ अपन पहाड़ी के आसपास के ठऊरमन ला आसीस के कारन बना दूहूं।<note caller="+" style="f"><char style="fr" closed="false">34:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 48:20">उत 48:20</ref></char></char></note> मेंह सही बेरा म बारिस भेजहूं; उहां आसीस के बारिस होही। <verse eid="EZK 34:26"/><verse number="27" style="v" sid="EZK 34:27"/>रूखमन म फर लगहीं अऊ भुइयां ह अपन ऊपज दीही; मनखेमन अपन देस म सुरकछित होहीं। जब में ओमन के जुड़ा ला टोरके ओमन ला ओ मनखेमन के हांथ ले छोंड़ाहूं, जेमन ओमन ला गुलाम बना ले हवंय, तब ओमन जानहीं कि मेंह यहोवा अंव। <verse eid="EZK 34:27"/><verse number="28" style="v" sid="EZK 34:28"/>ओमन जाति-जाति के मनखेमन के दुवारा फेर लूटे नइं जाहीं, अऊ न ही जंगली पसुमन ओमन ला फाड़के खाहीं। ओमन सुरकछित रहिहीं, अऊ ओमन ला कोनो नइं डरवाहीं। <verse eid="EZK 34:28"/><verse number="29" style="v" sid="EZK 34:29"/>मेंह ओमन ला एक अइसन देस दूहूं, जऊन ह अपन फसल बर जाने जाथे, अऊ ओमन देस म फेर अकाल ले पीड़ित नइं होहीं या जाति-जाति के मनखेमन ओमन ला अपमानित नइं करहीं। <verse eid="EZK 34:29"/><verse number="30" style="v" sid="EZK 34:30"/>तब ओमन जानहीं कि में, यहोवा ओमन के परमेसर ओमन के संग हवंव अऊ ये कि ओ, इसरायलीमन, मोर मनखे अंय, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 34:30"/><verse number="31" style="v" sid="EZK 34:31"/>तुमन मोर भेड़ अव, मोर चरागन के भेड़, अऊ मेंह तुम्हर परमेसर अंव, परमपरधान यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 34:31"/></para>
  <chapter eid="EZK 34"/>
  <chapter number="35" style="c" sid="EZK 35"/>
  <para style="s1">एदोम के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 35:1"/>यहोवा के बचन मोर मेर आईस: <verse eid="EZK 35:1"/><verse number="2" style="v" sid="EZK 35:2"/>“हे मनखे के बेटा, अपन मुहूं ला सेईर पहाड़ कोति करके; ओकर बिरूध अगमबानी कर <verse eid="EZK 35:2"/><verse number="3" style="v" sid="EZK 35:3"/>अऊ कह: ‘परमपरधान यहोवा ह ये कहत हे: हे सेईर पहाड़, मेंह तोर बिरूध हवंव, अऊ में अपन हांथ तोर बिरूध बढ़ाहूं अऊ मेंह तोला निरजन अऊ उजाड़ कर दूहूं। <verse eid="EZK 35:3"/><verse number="4" style="v" sid="EZK 35:4"/>मेंह तोर नगरमन ला खंडहर कर दूहूं अऊ तेंह निरजन हो जाबे। तब तेंह जान लेबे कि मेंह यहोवा अंव।<verse eid="EZK 35:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 35:5"/>“ ‘काबरकि तेंह पुराना जमाना ले बईरता रखत रहय अऊ इसरायलीमन के संकट के बेरा म तेंह ओमन ला तलवार के अधीन कर देय, येह ओ समय रिहिस जब ओमन के दंड ह चरम सीमा म रिहिस, <verse eid="EZK 35:5"/><verse number="6" style="v" sid="EZK 35:6"/>एकरसेति मेंह अपन जिनगी के सपथ खाके कहत हंव, परमपरधान यहोवा ह घोसना करत हे, मेंह तोला तोर खून बहाय बर दे दूहूं अऊ खून बहई ह तोर पीछा करही। काबरकि तें खून बहई ले घिन नइं करस, एकरसेति खून बहई ह तोर पीछा करही। <verse eid="EZK 35:6"/><verse number="7" style="v" sid="EZK 35:7"/>मेंह सेईर पहाड़ ला निरजन अऊ उजाड़ कर दूहूं अऊ ओ जम्मो ला नास कर दूहूं, जेमन येमा ले होके आथें-जाथें। <verse eid="EZK 35:7"/><verse number="8" style="v" sid="EZK 35:8"/>मेंह तोर पहाड़मन ला मारे गय मनखेमन ले भर दूहूं; जेमन तलवार ले मारे जाहीं, ओमन तोर पहाड़ीमन ऊपर अऊ तोर घाटीमन म अऊ तोर जम्मो पहाड़ी दर्रामन म गिरहीं। <verse eid="EZK 35:8"/><verse number="9" style="v" sid="EZK 35:9"/>मेंह तोला सदाकाल बर उजाड़ कर दूहूं; तोर नगरमन म फेर कोनो नइं बसहीं। तब तेंह जानबे कि मेंह यहोवा अंव।<verse eid="EZK 35:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 35:10"/>“ ‘काबरकि तेंह कहे हस, “ये दूनों जाति अऊ ये दूनों देस हमर होहीं अऊ हमन ओमन ला अपन अधिकार म ले लेबो,” हालाकि में यहोवा ह उहां रहेंव, <verse eid="EZK 35:10"/><verse number="11" style="v" sid="EZK 35:11"/>एकरसेति मोर जिनगी के सपथ, परमपरधान यहोवा ह घोसना करत हे, ओमन ले जब तें घिन करत रहय, ओ समय तेंह जऊन कोरोध अऊ जलन देखाय, ओकरे मुताबिक मेंह तोर ले बरताव करहूं अऊ जब मेंह तोर नियाय करहूं, तब में अपनआप ला ओमन के बीच परगट करहूं। <verse eid="EZK 35:11"/><verse number="12" style="v" sid="EZK 35:12"/>तब तेंह जानबे कि में यहोवा ह ओ जम्मो तुछ बातमन ला सुने हवंव, जेला तेंह इसरायल के पहाड़मन के बिरूध कहे हस। तेंह कहय, “ओमन उजाड़ पड़े हवंय अऊ ओमन ला हमर जेवन बर देय गे हवय कि हमन ओमन ला खा डारन।” <verse eid="EZK 35:12"/><verse number="13" style="v" sid="EZK 35:13"/>तेंह मोर बिरूध म डींग मारत रहय अऊ मोर बिरूध म बिगर रूके कहत रहय, अऊ मेंह ओ जम्मो बात ला सुने हंव। <verse eid="EZK 35:13"/><verse number="14" style="v" sid="EZK 35:14"/>परमपरधान यहोवा ह ये कहत हे: जब पूरा धरती ह आनंदित होही, तब मेंह तोला उजाड़ दूहूं। <verse eid="EZK 35:14"/><verse number="15" style="v" sid="EZK 35:15"/>काबरकि जब इसरायल के उत्तराधिकार ह उजड़ गीस, तब तें आनंद मनाय, एकरसेति मेंह वइसने ही बरताव तोर संग करहूं। हे सेईर पहाड़, तें उजड़ जाबे, तें अऊ पूरा एदोम। तब ओमन जान लीहीं कि मेंह यहोवा अंव।’ ”<verse eid="EZK 35:15"/></para>
  <chapter eid="EZK 35"/>
  <chapter number="36" style="c" sid="EZK 36"/>
  <para style="s1">इसरायल के पहाड़मन बर आसा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 36:1"/>“हे मनखे के बेटा, इसरायल के पहाड़मन बर अगमबानी कर अऊ कह, ‘हे इसरायल के पहाड़मन, यहोवा के बचन ला सुनव। <verse eid="EZK 36:1"/><verse number="2" style="v" sid="EZK 36:2"/>परमपरधान यहोवा ह ये कहत हे: बईरी ह तुम्हर बिसय म कहिस, “अहा! पुराना जमाना के ऊंच ठऊरमन हमर अधिकार म आ गे हवंय।” ’ <verse eid="EZK 36:2"/><verse number="3" style="v" sid="EZK 36:3"/>एकरसेति अगमबानी करके कह, ‘परमपरधान यहोवा ह ये कहत हे: काबरकि ओमन तुमन ला जम्मो कोति ले लूटिन अऊ कुचरिन, जेकर कारन तुमन बाकि जातिमन के अधीन हो गेव अऊ मनखेमन तुम्हर बारे म खराप बात कहिके तुम्हर निन्दा करे लगिन, <verse eid="EZK 36:3"/><verse number="4" style="v" sid="EZK 36:4"/>एकरसेति, हे इसरायल के पहाड़मन, परमपरधान यहोवा के बात ला सुनव: परमपरधान यहोवा ह पहाड़ अऊ पहाड़ीमन ले, तराई अऊ घाटीमन ले, उजड़े खंडहर अऊ तियाग दिये गय नगरमन ले, जेमन ला लूट लिये गीस अऊ जेमन के चारों कोति के बाकि जातिमन ओमन के हंसी उड़ाथें, ओ जम्मो ले कहत हे— <verse eid="EZK 36:4"/><verse number="5" style="v" sid="EZK 36:5"/>परमपरधान यहोवा ह ये कहत हे: बहुंत उत्साह म आके, मेंह बाकि जातिमन के बिरूध अऊ जम्मो एदोम के बिरूध कहे हंव, खुसी अऊ अपन मन म जलन के कारन, ओमन मोर देस ला अपन अधिकार म कर लीन ताकि ओमन येकर चरागन ला लूट सकंय।’ <verse eid="EZK 36:5"/><verse number="6" style="v" sid="EZK 36:6"/>एकरसेति इसरायल देस के बिसय म अगमबानी कर अऊ पहाड़ अऊ पहाड़ीमन ले, तराई अऊ घाटीमन ले कह: ‘परमपरधान यहोवा ह ये कहत हे: मेंह अपन जलन अऊ कोप म आके कहिथंव, काबरकि तुमन जाति-जाति के मनखेमन के निन्दा ला सहे हवव। <verse eid="EZK 36:6"/><verse number="7" style="v" sid="EZK 36:7"/>एकरसेति परमपरधान यहोवा ह ये कहत हे: मेंह हांथ उठाके कसम खावत हंव कि तुम्हर चारों कोति के जातिमन घलो निन्दा के चीज बनहीं।<verse eid="EZK 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 36:8"/>“ ‘पर हे इसरायल के पहाड़मन, तुमन म मोर इसरायली मनखेमन बर डारामन पनपहीं अऊ ओमा फर धरहीं, काबरकि ओमन जल्दी घर लहुंट आहीं। <verse eid="EZK 36:8"/><verse number="9" style="v" sid="EZK 36:9"/>मेंह तुम्हर बर चिंता करत हंव अऊ तुम्हर ऊपर किरपा-दिरिस्टी करहूं; तुमन ला जोते अऊ बोये जाही, <verse eid="EZK 36:9"/><verse number="10" style="v" sid="EZK 36:10"/>अऊ मेंह तुमन म बहुंत मनखेमन ला बसाहूं—हव, पूरा इसरायल ला। नगरमन ला बसाय जाही अऊ टूटे-फूटे घरमन ला फेर बनाय जाही। <verse eid="EZK 36:10"/><verse number="11" style="v" sid="EZK 36:11"/>मेंह तुमन म रहइया मनखे अऊ पसुमन के संखिया ला बढ़ाहूं, अऊ ओमन फरहीं अऊ बहुंत हो जाहीं। मेंह पहिले सहीं तुमन म मनखेमन ला बसाहूं अऊ मेंह तुम्हर पहिले से जादा उन्नति करहूं। तब तुमन जानहू कि मेंह यहोवा अंव। <verse eid="EZK 36:11"/><verse number="12" style="v" sid="EZK 36:12"/>मेंह अइसे करहूं कि मनखे याने कि मोर मनखे इसरायलीमन तुमन म बसहीं। ओमन तुमन ऊपर अधिकार कर लीहीं, अऊ तुमन ओमन के निज भाग होहू; तुमन फेर कभू ओमन के लइकामन ला छीनके अलग नइं करहू।<verse eid="EZK 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 36:13"/>“ ‘परमपरधान यहोवा ह ये कहत हे: काबरकि कुछू मनखेमन तुम्हर ले कहिथंय, “तुमन मनखेमन ला खा जाथव अऊ अपन जाति के मनखेमन ले ओमन के लइकामन ला छीनके अलग कर देथव,” <verse eid="EZK 36:13"/><verse number="14" style="v" sid="EZK 36:14"/>एकरसेति तुमन फेर मनखेमन ला नइं खाहू या अपन जाति ला संतानहीन नइं करहू, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 36:14"/><verse number="15" style="v" sid="EZK 36:15"/>मेंह अइसे करहूं कि जाति-जाति के मनखेमन तुमन ला फेर ताना नइं मारहीं, अऊ फेर तुमन ला मनखेमन के अपमान सहे बर नइं पड़ही या तुमन अपन जाति के गिरे के कारन नइं बनहू, परमपरधान यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 36:15"/></para>
  <para style="s1">इसरायल के फेर बसाय जाय के बात निस्चित</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 36:16"/>यहोवा के बचन फेर मोर मेर आईस: <verse eid="EZK 36:16"/><verse number="17" style="v" sid="EZK 36:17"/>“हे मनखे के बेटा, जब इसरायल के मनखेमन अपन देस म रहत रिहिन, तब ओमन देस ला अपन चालचलन अऊ काममन के दुवारा असुध करिन। मोर नजर म ओमन के चालचलन ह कोनो माईलोगन के महिना होय के असुधता सहीं रिहिस। <verse eid="EZK 36:17"/><verse number="18" style="v" sid="EZK 36:18"/>एकरसेति मोर कोप ह ओमन ऊपर भड़किस काबरकि ओमन देस म खून बहाय रिहिन अऊ येला अपन मूरतीमन के दुवारा असुध करे रिहिन। <verse eid="EZK 36:18"/><verse number="19" style="v" sid="EZK 36:19"/>मेंह ओमन ला जाति-जाति के मनखेमन के बीच तितिर-बितिर कर देंव, अऊ ओमन देस-देस म बगर गीन; मेंह ओमन के चालचलन अऊ ओमन के काममन के अनुसार ओमन के नियाय करेंव। <verse eid="EZK 36:19"/><verse number="20" style="v" sid="EZK 36:20"/>अऊ जिहां भी ओमन ओ जातिमन के बीच गीन, ओमन मोर नांव ला अपबितर करिन, काबरकि ओमन के बारे म ये कहे गे रिहिस, ‘येमन यहोवा के मनखे अंय, तभो ले ओमन ला ओकर देस ला छोंड़े बर पड़िस।’ <verse eid="EZK 36:20"/><verse number="21" style="v" sid="EZK 36:21"/>मोला मोर पबितर नांव के चिंता रिहिस, जेला इसरायल के मनखे जिहां भी गीन, उहां जाति-जाति के मनखेमन के बीच अपबितर करिन।<verse eid="EZK 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 36:22"/>“ये खातिर इसरायलीमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: हे इसरायल के मनखेमन, जऊन कुछू मेंह करे बर जावत हंव, ओह तुम्हर कारन नइं, पर अपन पबितर नांव के कारन करे बर जावत हंव, जेला तुमन जिहां भी गेव, उहां तुमन जाति-जाति के मनखेमन के बीच अपबितर करेव। <verse eid="EZK 36:22"/><verse number="23" style="v" sid="EZK 36:23"/>मेंह अपन बड़े नांव के पबितरता ला देखाहूं, जेह जाति-जाति के मनखेमन के बीच अपबितर होईस हे, ओ नांव जेला तुमन ओमन के बीच अपबितर करे हव। तब मनखेमन जानहीं कि मेंह यहोवा अंव, परमपरधान यहोवा ह घोसना करत हे, जब में ओमन के आंखी के आघू म तुम्हर जरिये पबितर ठहिरहूं।<verse eid="EZK 36:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 36:24"/>“ ‘काबरकि मेंह तुमन ला जातिमन ले बाहिर निकाल लूहूं; मेंह तुमन ला सब देसमन ले इकट्ठा करहूं अऊ तुमन ला तुम्हर खुद के देस म ले आहूं। <verse eid="EZK 36:24"/><verse number="25" style="v" sid="EZK 36:25"/>मेंह तुमन ऊपर सुध पानी छिंचहूं, अऊ तुमन सुध हो जाहू; मेंह तुमन ला तुम्हर जम्मो असुधता अऊ तुम्हर जम्मो मूरतीमन ले सुध करहूं। <verse eid="EZK 36:25"/><verse number="26" style="v" sid="EZK 36:26"/>मेंह तुमन ला नवां हिरदय दूहूं अऊ तुमन म एक नवां आतमा डालहूं; मेंह तुमन ले तुम्हर पथरा के हिरदय हटा दूहूं अऊ तुमन ला मांस के एक हिरदय दूहूं। <verse eid="EZK 36:26"/><verse number="27" style="v" sid="EZK 36:27"/>मेंह अपन आतमा तुमन म डालहूं अऊ अइसन करहूं कि तुमन मोर नियम म चलहू अऊ धियान देके मोर कानूनमन के पालन करहू। <verse eid="EZK 36:27"/><verse number="28" style="v" sid="EZK 36:28"/>तब तुमन ओ देस म रहिहू, जेला मेंह तुम्हर पुरखामन ला देय रहेंव; तुमन मोर मनखे होहू, अऊ मेंह तुम्हर परमेसर होहूं। <verse eid="EZK 36:28"/><verse number="29" style="v" sid="EZK 36:29"/>मेंह तुमन ला तुम्हर जम्मो असुधता ले छोंड़ाहूं। मेंह अनाज ला हुकूम दूहूं अऊ येला बहुंत कर दूहूं अऊ तुम्हर ऊपर अकाल नइं लानहूं। <verse eid="EZK 36:29"/><verse number="30" style="v" sid="EZK 36:30"/>मेंह रूखमन के फर के संखिया ला बढ़ाहूं अऊ खेत के फसल ला जादा उपजाहूं, ताकि अकाल के कारन, तुमन जाति-जाति के मनखेमन के बीच कलंकित झन होवव। <verse eid="EZK 36:30"/><verse number="31" style="v" sid="EZK 36:31"/>तब तुमन अपन खराप चालचलन अऊ दुस्टता के काममन ला सुरता करहू, तब तुमन अपन पाप अऊ घिनौना काममन के कारन अपनआप ले घिन करहू। <verse eid="EZK 36:31"/><verse number="32" style="v" sid="EZK 36:32"/>मेंह तुमन ला बताय चाहत हंव कि में ये सब तुम्हर बर नइं करत हंव, परमपरधान यहोवा ह घोसना करत हे। हे इसरायल के मनखेमन, अपन बरताव के कारन लज्जित अऊ कलंकित होवव!<verse eid="EZK 36:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 36:33"/>“ ‘परमपरधान यहोवा ह ये कहत हे: जऊन दिन मेंह तुमन ला तुम्हर जम्मो पाप ले सुध करहूं, मेंह तुम्हर नगरमन ला फेर बसाहूं, अऊ खंडहरमन फेर बनाय जाहीं। <verse eid="EZK 36:33"/><verse number="34" style="v" sid="EZK 36:34"/>उजाड़ भुइयां म फसल उगाय जाही, एकर बदले कि ओह उहां ले अवइया-जवइया जम्मो मनखेमन के नजर म उजाड़ पड़े रहय। <verse eid="EZK 36:34"/><verse number="35" style="v" sid="EZK 36:35"/>ओमन कहिहीं, “ये भुइयां, जऊन ह उजाड़ पड़े रिहिस, अब अदन के बगीचा असन हो गे हवय, ओ सहर जेमन खंडहर अऊ उजाड़ होके नास हो गे रिहिन, ओमन अब गढ़वाले सहर हो गे हवंय, मनखेमन उहां रहे के सुरू कर दे हवंय।” <verse eid="EZK 36:35"/><verse number="36" style="v" sid="EZK 36:36"/>तब तुम्हर आसपास के बांचे जातिमन के मनखेमन जानहीं कि में, यहोवा ह नास हो गय जगहमन ला फेर बनाय हंव अऊ उजड़े जगहमन ला फेर बसाय हंव। में यहोवा ह ये कहे हंव, अऊ मेंह येला पूरा करहूं।’<verse eid="EZK 36:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 36:37"/>“परमपरधान यहोवा ह ये कहत हे: एक बार फेर में इसरायल के बिनती ला स्वीकार करहूं अऊ येला ओमन बर करहूं: मेंह ओमन के मनखेमन के गनती ला भेड़-बकरीमन असन बहुंत बढ़ाहूं, <verse eid="EZK 36:37"/><verse number="38" style="v" sid="EZK 36:38"/>ओमन ला पसुमन के ओ झुंड सहीं बहुंत बढ़ाहूं, जेमन यरूसलेम म ठहिराय गय तिहारमन के बेरा बलिदान चघाय बर होथें। ये किसम ले ओ नास हो गय सहरमन मनखेमन के झुंड ले भर जाहीं। तब ओमन जानहीं कि मेंह यहोवा अंव।”<verse eid="EZK 36:38"/></para>
  <chapter eid="EZK 36"/>
  <chapter number="37" style="c" sid="EZK 37"/>
  <para style="s1">सूखे हाड़ामन के घाटी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 37:1"/>यहोवा के हांथ मोर ऊपर रिहिस, अऊ ओह मोला अपन आतमा के दुवारा बाहिर ले आईस अऊ एक घाटी के मांझा म ठाढ़ कर दीस; ओ घाटी ह हाड़ामन ले भरे पड़े रिहिस। <verse eid="EZK 37:1"/><verse number="2" style="v" sid="EZK 37:2"/>ओह मोला ओ हाड़ामन के बीच अवई-जवई म मोर अगुवई करिस, अऊ मेंह घाटी के तल म बहुंत अकन हाड़ा देखेंव, जेमन बहुंत सूखा रिहिन। <verse eid="EZK 37:2"/><verse number="3" style="v" sid="EZK 37:3"/>तब ओह मोर ले पुछिस, “हे मनखे के बेटा, का ये हाड़ामन जी सकत हें?”</para>
  <para style="p" vid="EZK 37:3">मेंह कहेंव, “हे परमपरधान यहोवा, येला सिरिप तेंहीच ह जानथस।”<verse eid="EZK 37:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 37:4"/>तब ओह मोर ले कहिस, “ये हाड़ामन ले अगमबानी करके कह, ‘हे सूखा हाड़ामन, यहोवा के बचन ला सुनव! <verse eid="EZK 37:4"/><verse number="5" style="v" sid="EZK 37:5"/>परमपरधान यहोवा ह ये हाड़ामन ले ये कहत हे: मेंह तुमन म सांस<note caller="+" style="f"><char style="fr" closed="false">37:5 </char><char style="ft" closed="false">इबरानी म येकर मतलब हो सकथे </char><char style="fqa" closed="false">हवा </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">आतमा</char></note> डाल दूहूं, अऊ तुमन जी उठहू। <verse eid="EZK 37:5"/><verse number="6" style="v" sid="EZK 37:6"/>मेंह तुम्हर नसमन ला लगाहूं अऊ तुम्हर ऊपर मांस ले आहूं अऊ तुमन ला चाम ले ढांप दूहूं; अऊ तुमन म सांस फूंक दूहूं, अऊ तुमन जीयत मनखे हो जाहू। तब तुमन जानहू कि मेंह यहोवा अंव।’ ”<verse eid="EZK 37:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 37:7"/>तब मेंह ये हुकूम के मुताबिक अगमबानी करेंव। अऊ जब मेंह अगमबानी करत रहेंव, त उहां एक अवाज होईस, एक खड़खड़ाहट के अवाज, अऊ हाड़ामन इकट्ठा होके एक-दूसर ले जुड़ गीन। <verse eid="EZK 37:7"/><verse number="8" style="v" sid="EZK 37:8"/>मेंह देखेंव कि ओमन म नस अऊ मांस-पेसी आ गीन अऊ ओमन चाम ले ढंक गीन, पर ओमन म सांस नइं रिहिस।<verse eid="EZK 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 37:9"/>तब ओह मोर ले कहिस, “सांस ले अगमबानी कर; अगमबानी कर, हे मनखे के बेटा, अऊ ओला कह, ‘परमपरधान यहोवा ह ये कहत हे: हे सांस, चारों खूंट ले आके ये घात करे गय मनखेमन म हमा जा ताकि येमन जी उठंय।’ ” <verse eid="EZK 37:9"/><verse number="10" style="v" sid="EZK 37:10"/>यहोवा के ये हुकूम के अनुसार मेंह अगमबानी करेंव, अऊ सांस ह ओमन म हमा गीस; ओमन जीके अपन-अपन गोड़ म ठाढ़ हो गीन—एक बहुंत बड़े सेना।<verse eid="EZK 37:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 37:11"/>फेर यहोवा ह मोर ले कहिस, “हे मनखे के बेटा, ये हाड़ामन इसरायल के मनखेमन अंय। ओमन कहिथंय, ‘हमर हाड़ामन सूख गे हवंय अऊ हमन कोनो आसा नइं करत हन; हमन अलग हो गे हन।’ <verse eid="EZK 37:11"/><verse number="12" style="v" sid="EZK 37:12"/>ये खातिर अगमबानी करके ओमन ले कह: ‘परमपरधान यहोवा ह ये कहत हे: हे मोर मनखेमन, मेंह तुम्हर कबरमन ला खोले बर जावत हंव अऊ तुमन ला उहां ले निकालहूं; मेंह तुमन ला वापिस इसरायल देस म ले आहूं। <verse eid="EZK 37:12"/><verse number="13" style="v" sid="EZK 37:13"/>तब हे मोर मनखेमन, तुमन जानहू कि मेंह यहोवा अंव, जब में तुम्हर कबरमन ला खोल दूहूं अऊ तुमन ला उहां ले बाहिर निकालहूं। <verse eid="EZK 37:13"/><verse number="14" style="v" sid="EZK 37:14"/>मेंह अपन आतमा तुमन म डालहूं अऊ तुमन जीयत मनखे हो जाहू, अऊ मेंह तुमन ला तुम्हर खुद के देस म बसाहूं। तब तुमन जानहू कि में यहोवा ह कहे हंव, अऊ मेंह येला करे हवंव, यहोवा ह घोसना करत हे।’ ”<verse eid="EZK 37:14"/></para>
  <para style="s1">एक राजा के अधीन एक जाति</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 37:15"/>फेर यहोवा के ये बचन मोर मेर आईस: <verse eid="EZK 37:15"/><verse number="16" style="v" sid="EZK 37:16"/>“हे मनखे के बेटा, लकरी के एक ठन लउठी ले अऊ ओमा ये लिख, ‘यहूदा अऊ ओकर संग के इसरायलीमन।’ तब लकरी के एक ठन अऊ लउठी ले अऊ ओमा लिख, ‘यूसुफ (याने कि एपरैम) अऊ ओकर संग के जम्मो इसरायलीमन।’ <verse eid="EZK 37:16"/><verse number="17" style="v" sid="EZK 37:17"/>ओ लउठीमन ला जोड़के एके ठन लउठी बना ले ताकि ओमन तोर हांथ म एके ठन हो जावंय।<verse eid="EZK 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 37:18"/>“जब तोर मनखेमन तोर ले पुछहीं, ‘का तेंह हमन ला नइं बताबे कि येमन से तोर का मतलब अय?’ <verse eid="EZK 37:18"/><verse number="19" style="v" sid="EZK 37:19"/>तब ओमन ले कहिबे, ‘परमपरधान यहोवा ह ये कहत हे: मेंह यूसुफ के लउठी ला लूहूं—जऊन ह एपरैम के हांथ म हवय—अऊ इसरायल के जऊन गोत्रमन ओकर संग जुड़े हवंय, ओमन ला लेके मेंह यहूदा के लउठी ले जोड़ दूहूं। मेंह ओमन ला लकरी के एके ठन लउठी बना दूहूं, अऊ ओमन मोर हांथ म एकेच लउठी हो जाहीं।’ <verse eid="EZK 37:19"/><verse number="20" style="v" sid="EZK 37:20"/>जऊन लउठीमन म तेंह लिखे हस, ओमन ला ओमन के आंखी के आघू म धर <verse eid="EZK 37:20"/><verse number="21" style="v" sid="EZK 37:21"/>अऊ ओमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: मेंह इसरायलीमन ला ओ जातिमन ले बाहिर निकाल लूहूं, जिहां ओमन गे हवंय। मेंह ओमन ला चारों कोति ले इकट्ठा करहूं अऊ ओमन ला ओमन के खुद के देस म वापिस ले आहूं। <verse eid="EZK 37:21"/><verse number="22" style="v" sid="EZK 37:22"/>मेंह ओमन ला इसरायल के पहाड़मन ऊपर एके ठन जाति बना दूहूं। ओ जम्मो के ऊपर एकेच राजा होही अऊ ओमन फेर कभू दू ठन जाति नइं होहीं या दू ठन राज म नइं बंटहीं। <verse eid="EZK 37:22"/><verse number="23" style="v" sid="EZK 37:23"/>ओमन फेर अपन मूरती अऊ बेकार के चीजमन या अपन कोनो अधरम के दुवारा अपनआप ला असुध नइं करहीं, काबरकि मेंह ओमन ला ओमन के पहिले के जम्मो पाप ले भरे काममन ले बचाहूं, अऊ मेंह ओमन ला सुध करहूं। ओमन मोर मनखे होहीं, अऊ मेंह ओमन के परमेसर होहूं।<verse eid="EZK 37:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 37:24"/>“ ‘मोर सेवक दाऊद ह ओमन के राजा होही, अऊ ओ जम्मो के एकेच चरवाहा होही। ओमन मोर कानून के पालन करहीं अऊ धियान देके मोर बिधिमन ला मानहीं। <verse eid="EZK 37:24"/><verse number="25" style="v" sid="EZK 37:25"/>ओमन ओ देस म रहिहीं, जेला मेंह अपन सेवक याकूब ला देय रहेंव, ओ देस जिहां तुम्हर पुरखामन रहत रिहिन। ओमन अऊ ओमन के लइकामन अऊ ओमन के लइका के लइकामन सदाकाल तक उहां रहिहीं, अऊ मोर सेवक दाऊद ह सदाकाल बर ओमन के हाकिम होही। <verse eid="EZK 37:25"/><verse number="26" style="v" sid="EZK 37:26"/>मेंह ओमन के संग म सांति के एक करार करहूं; येह हमेसा बने रहइया एक करार ठहिरही। मेंह ओमन ला बसाहूं अऊ ओमन के संखिया ला बढ़ाहूं, अऊ मेंह अपन पबितर-स्थान ला ओमन के बीच सदा बनाय रखहूं। <verse eid="EZK 37:26"/><verse number="27" style="v" sid="EZK 37:27"/>मोर निवास स्थान ओमन के संग होही; मेंह ओमन के परमेसर होहूं, अऊ ओमन मोर मनखे होहीं। <verse eid="EZK 37:27"/><verse number="28" style="v" sid="EZK 37:28"/>जब मोर पबितर-स्थान हमेसा बर ओमन के बीच होही, तब जाति-जाति के मनखेमन जानहीं कि में यहोवा ह इसरायल ला पबितर करथंव।’ ”<verse eid="EZK 37:28"/></para>
  <chapter eid="EZK 37"/>
  <chapter number="38" style="c" sid="EZK 38"/>
  <para style="s1">जाति-जाति ऊपर परमेसर के बड़े जीत</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 38:1"/>यहोवा के बचन मोर मेर आईस: <verse eid="EZK 38:1"/><verse number="2" style="v" sid="EZK 38:2"/>“हे मनखे के बेटा, मागोग देस के गोग कोति अपन मुहूं ला कर, जऊन ह रोस, मेसेक अऊ तूबल के मुखिया हाकिम ए; ओकर बिरूध म अगमबानी कर, <verse eid="EZK 38:2"/><verse number="3" style="v" sid="EZK 38:3"/>अऊ कह, ‘परमपरधान यहोवा ह ये कहत हे: हे गोग! रोस, मेसेक अऊ तूबल के मुखिया हाकिम, मेंह तोर बिरूध हवंव। <verse eid="EZK 38:3"/><verse number="4" style="v" sid="EZK 38:4"/>मेंह तोला उल्टा दिग म मोड़ दूहूं अऊ तोर जबड़ामन म कांटा डालके तोला तोर पूरा सेना के संग बाहिर ले आहूं—तोर घोड़ामन, पूरा हथियार धरे तोर घुड़सवारमन, अऊ छोटे अऊ बड़े ढाल धरे बड़े उपदरवी झुंड, जम्मो के जम्मो तलवार धरे हवंय। <verse eid="EZK 38:4"/><verse number="5" style="v" sid="EZK 38:5"/>फारस, कूस<note caller="+" style="f"><char style="fr" closed="false">38:5 </char><char style="ft" closed="false">नील नदी के ऊपरी इलाका</char></note> अऊ पूत अपन-अपन ढाल लेके अऊ टोप पहिरे ओमन के संग होहीं, <verse eid="EZK 38:5"/><verse number="6" style="v" sid="EZK 38:6"/>गोमेर अपन पूरा सेना के संग, दूरिहा उत्तर दिसा ले बेत-तोगरमा अपन पूरा सेना के संग—बहुंत अकन जातिमन ला तोर संग बाहिर ले आहूं।<verse eid="EZK 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 38:7"/>“ ‘तियार हो जावव; तियारी कर लव, तें अऊ पूरा उपदरवी भीड़, जऊन ह तोर मेर इकट्ठा होय हवय, ओ जम्मो ला अपन अधीन कर ले। <verse eid="EZK 38:7"/><verse number="8" style="v" sid="EZK 38:8"/>बहुंत समय के बाद तोला हथियार धरे बर बलाय जाही। अवइया सालमन म तेंह एक देस ऊपर हमला करबे, जऊन ह लड़ई के बाद संभल गे होही, जेकर मनखेमन बहुंते जातिमन ले आके इसरायल के ओ पहाड़मन म इकट्ठा होहीं, जऊन ह बहुंत समय ले उजाड़ पड़े रिहिस। ओमन ला बहुंत जातिमन ले बाहिर लाय गे रिहिस, अऊ अब ओमन जम्मो सुरकछित रहिथें। <verse eid="EZK 38:8"/><verse number="9" style="v" sid="EZK 38:9"/>तें अऊ तोर पूरा सेना अऊ तोर संग बहुंते जाति के मनखेमन आंधी असन आघू बढ़हीं; तेंह ओ बादर असन होबे, जऊन ह देस के ऊपर छा जाथे।<verse eid="EZK 38:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 38:10"/>“ ‘परमपरधान यहोवा ह ये कहत हे: ओ दिन तोर मन म अइसन बिचारमन आहीं कि तेंह एक दुस्ट योजना बनाबे। <verse eid="EZK 38:10"/><verse number="11" style="v" sid="EZK 38:11"/>तेंह कहिबे, “मेंह बिगर दीवारवाले गांवमन के एक देस ऊपर हमला करहूं; मेंह ओ मनखेमन ऊपर हमला करहूं, जेमन सांति म अऊ निडर रहिथें—ओमा के जम्मो झन बिगर कोनो दीवार अऊ बिगर दुवार अऊ पल्लामन के रहत हवंय। <verse eid="EZK 38:11"/><verse number="12" style="v" sid="EZK 38:12"/>मेंह ओमन ला लूटहूं अऊ ओमन ले छीन लूहूं अऊ मोर हांथ ह फेर बसाय गय खंडहरमन अऊ जाति-जाति ले इकट्ठा हो गय ओ मनखेमन के बिरूध उठही, जेमन करा बहुंत जादा पसु अऊ संपत्ति हवय अऊ जेमन देस के मांझा म रहिथें।” <verse eid="EZK 38:12"/><verse number="13" style="v" sid="EZK 38:13"/>सेबा अऊ ददान के मनखेमन अऊ तरसीस के बेपारीमन अऊ ओकर जम्मो गांवमन<note caller="+" style="f"><char style="fr" closed="false">38:13 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">जम्मो </char><char style="fqa" closed="false">बलवान सिंहमन</char></note> तोर ले कहिहीं, “का तेंह लूटे बर आय हस? का तेंह अपन उपदरवी भीड़ ला लूटे बर, सोन अऊ चांदी ले जाय बर, पसु अऊ सामान ले जाय बर अऊ लूट के सामान ऊपर कब्जा करे बर इकट्ठा करे हस?” ’<verse eid="EZK 38:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 38:14"/>“एकरसेति, हे मनखे के बेटा, अगमबानी करके गोग ला कह, ‘परमपरधान यहोवा ह ये कहत हे: ओ समय, जब मोर इसरायली मनखेमन सुरकछित रहत होहीं, त का तोर धियान ये तरफ नइं जाही? <verse eid="EZK 38:14"/><verse number="15" style="v" sid="EZK 38:15"/>तेंह अपन जगह बहुंत दूरिहा उत्तर दिग ले आबे, तोर संग बहुंत जाति के मनखेमन होहीं, ओ जम्मो घोड़ामन म चघके आहीं; येह एक बड़े उपदरवी भीड़, एक सक्तिसाली सेना होही। <verse eid="EZK 38:15"/><verse number="16" style="v" sid="EZK 38:16"/>तेंह मोर मनखेमन के बिरूध ओ बादर असन आघू बढ़बे, जऊन ह देस ऊपर छा जाथे। हे गोग, अवइया दिनमन म, मेंह तोर ले मोरेच देस के बिरूध हमला करवाहूं, ताकि जब में तोर जरिये जाति-जाति के मनखेमन के आंखी के आघू म पबितर साबित होवंव, त ओमन मोला जानंय।<verse eid="EZK 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 38:17"/>“ ‘परमपरधान यहोवा ह ये कहत हे: तेंह ओ अस, जेकर चरचा मेंह पहिले के समय म अपन सेवक याने कि इसरायल के अगमजानीमन के दुवारा करे रहेंव। ओ समय ओमन कतको साल तक अगमबानी करते रिहिन कि मेंह तोला ओमन के बिरूध लानहूं। <verse eid="EZK 38:17"/><verse number="18" style="v" sid="EZK 38:18"/>ओ दिन ये बात होही: जब गोग ह इसरायल देस ऊपर हमला करही, तब मोर गुस्सा ह बहुंत भड़कही, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 38:18"/><verse number="19" style="v" sid="EZK 38:19"/>में अपन उत्साह अऊ भयंकर कोप म घोसना करत हंव कि ओ समय इसरायल देस म एक बड़े भुइंडोल होही। <verse eid="EZK 38:19"/><verse number="20" style="v" sid="EZK 38:20"/>समुंदर के मछरी, अकास के चिरई, भुइयां म रेंगइया जम्मो जीव-जन्तु अऊ धरती म रहइया जम्मो मनखे मोर आघू म कांप उठहीं। पहाड़मन पलटा दिये जाहीं, ठाढ़ चट्टानमन कुटा-कुटा हो जाहीं अऊ हरेक भीथी ह भुइयां म गिर जाही। <verse eid="EZK 38:20"/><verse number="21" style="v" sid="EZK 38:21"/>मेंह गोग के बिरूध अपन जम्मो पहाड़मन म तलवार चलवाहूं, परमपरधान यहोवा ह घोसना करत हे। हर एक झन के तलवार ओकर भाई के बिरूध म उठही। <verse eid="EZK 38:21"/><verse number="22" style="v" sid="EZK 38:22"/>मेंह ओकर ऊपर महामारी लानके अऊ खून बहाय के दुवारा नियाय करहूं; मेंह ओकर ऊपर, ओकर सेना ऊपर अऊ ओकर संग के बहुंते जातिमन ऊपर भारी बारिस करवाहूं अऊ ओमन ऊपर बड़े-बड़े करा अऊ बरत गंधक बरसाहूं। <verse eid="EZK 38:22"/><verse number="23" style="v" sid="EZK 38:23"/>अऊ ये किसम ले मेंह अपन महानता अऊ पबितरता देखाहूं, अऊ मेंह बहुंते जाति के मनखेमन के नजर म अपनआप ला परगट करहूं। तब ओमन जानहीं कि मेंह यहोवा अंव।’<verse eid="EZK 38:23"/></para>
  <chapter eid="EZK 38"/>
  <chapter number="39" style="c" sid="EZK 39"/>
  <para style="p">
    <verse number="1" style="v" sid="EZK 39:1"/>“हे मनखे के बेटा, गोग के बिरूध अगमबानी करके कह: ‘परमपरधान यहोवा ह ये कहत हे: हे गोग, मेसेक अऊ तूबल के मुखिया हाकिम, मेंह तोर बिरूध हवंव। <verse eid="EZK 39:1"/><verse number="2" style="v" sid="EZK 39:2"/>मेंह तोला गोल घुमा दूहूं अऊ संग म घसीटहूं घलो। मेंह तोला बहुंत दूरिहा उत्तर दिग ले लानहूं अऊ तोला इसरायल के पहाड़मन के बिरूध भेजहूं। <verse eid="EZK 39:2"/><verse number="3" style="v" sid="EZK 39:3"/>तब में तोर डेरी हांथ के धनुस ला मारहूं अऊ तोर जेवनी हांथ के तीरमन ला गिरा दूहूं। <verse eid="EZK 39:3"/><verse number="4" style="v" sid="EZK 39:4"/>इसरायल के पहाड़मन म तेंह गिरबे, तोर संग तोर जम्मो सेना अऊ तोर संग के जातिमन घलो गिरहीं। मेंह तोला जेवन के रूप म सड़े मांस खवइया जम्मो किसम के चिरई अऊ जंगली पसुमन ला दे दूहूं। <verse eid="EZK 39:4"/><verse number="5" style="v" sid="EZK 39:5"/>तेंह खुला मैदान म गिरके मरबे, काबरकि मेंह कहे हवंव, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 39:5"/><verse number="6" style="v" sid="EZK 39:6"/>मेंह मागोग अऊ ओमन ऊपर आगी पठोहूं, जेमन समुंदर तीर म सुरकछित रहिथें, अऊ ओमन जानहीं कि मेंह यहोवा अंव।<verse eid="EZK 39:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 39:7"/>“ ‘मेंह अपन इसरायली मनखेमन के बीच अपन पबितर नांव ला परगट करहूं। मेंह अपन पबितर नांव ला फेर अपबितर होवन नइं दंव, अऊ जाति-जाति के मनखेमन जानहीं कि में यहोवा ही इसरायल म पबितर अंव। <verse eid="EZK 39:7"/><verse number="8" style="v" sid="EZK 39:8"/>ये घटना होवइया हे! येह जरूर होही, परमपरधान यहोवा ह घोसना करत हे। येह ओही दिन अय, जेकर चरचा मेंह करे हंव।<verse eid="EZK 39:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 39:9"/>“ ‘तब जेमन इसरायल के नगरमन म रहिथें ओमन बाहिर निकलहीं अऊ हथियारमन के उपयोग आगी बारे बर करहीं अऊ ओमन ला जला दीहीं—छोटे अऊ बड़े ढाल, तीर अऊ धनुस, लड़ई के गदा अऊ बरछी। सात बछर तक ओमन येमन के उपयोग आगी बारे बर करहीं। <verse eid="EZK 39:9"/><verse number="10" style="v" sid="EZK 39:10"/>ओमन ला मैदान ले लकरी इकट्ठा करे के या जंगल ले लकरी काटे के जरूरत नइं होही, काबरकि ओमन हथियारमन के उपयोग आगी बारे बर करहीं। अऊ ओमन ओ मनखेमन ला लूटहीं, जेमन ओमन ला लूटे रिहिन अऊ ओमन ले सामान छीनहीं, जेमन ओमन ले छीन ले रिहिन, परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 39:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 39:11"/>“ ‘ओ दिन मेंह गोग ला इसरायल म मरघटी बर एक जगह दूहूं, ये जगह ओ मनखेमन के घाटी म होही, जेमन समुंदर के पूरब कोति जाथें। ये मरघटी ह उहां ले होके जवइयामन के रसता ला रोकही, काबरकि गोग अऊ ओकर जम्मो उपदरवी भीड़ ला उहां माटी देय जाही। एकरसेति ओ जगह ला हामोन-गोग<note caller="+" style="f"><char style="fr" closed="false">39:11 </char><char style="fq" closed="false">हामोन-गोग </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">गोग के उपदरवी भीड़</char></note> के घाटी कहे जाही।<verse eid="EZK 39:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 39:12"/>“ ‘देस ला सुध करे बर इसरायलीमन ओमन ला सात महिना तक माटी देवत रहिहीं। <verse eid="EZK 39:12"/><verse number="13" style="v" sid="EZK 39:13"/>देस के सबो मनखेमन ओमन ला माटी दीहीं, अऊ जऊन दिन मेंह अपन महिमा परगट करहूं, ओह ओमन बर एक सुरता करइया दिन होही, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 39:13"/><verse number="14" style="v" sid="EZK 39:14"/>देस ला सुध करे बर मनखेमन ला लगातार ठहिराय जाही। ओमन पूरा देस म फईल जाहीं अऊ आने मन के संग मिलके ओमन ओ लासमन ला माटी दीहीं, जेमन भुइयां म पड़े मिलहीं।</para>
  <para style="p" vid="EZK 39:14">“ ‘सात महिना के बाद, ओमन अऊ बिस्तार से खोज करहीं। <verse eid="EZK 39:14"/><verse number="15" style="v" sid="EZK 39:15"/>जब ओमन देस म ले होके जाहीं अऊ यदि कोनो ला कोनो मनखे के हाड़ा ह दिखही, त ओह ओ हाड़ा के बाजू म एक चिनहां छोंड़ दीही, अऊ ओ चिनहां ह तब तक रहिही, जब तक कि माटी देवइयामन आके ओ लास ला हामोन-गोग के ओ घाटी म माटी नइं दे दीहीं, <verse eid="EZK 39:15"/><verse number="16" style="v" sid="EZK 39:16"/>जऊन ह हामोना<note caller="+" style="f"><char style="fr" closed="false">39:16 </char><char style="fq" closed="false">हामोना </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">उपदरवी भीड़</char></note> नांव के नगर के लकठा म हवय। अऊ ये किसम ले ओमन देस ला सुध करहीं।’<verse eid="EZK 39:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 39:17"/>“हे मनखे के बेटा, परमपरधान यहोवा ह ये कहत हे: जम्मो किसम के चिरई अऊ जम्मो जंगली पसुमन ला बला: ‘चारों कोति ले आवव अऊ ओ बलिदान बर इकट्ठा हो जावव, जेला मेंह तुम्हर बर तियार करत हंव; येह इसरायल के पहाड़मन के एक बड़े बलिदान होही। उहां तुमन मांस खाहू अऊ खून पीहू। <verse eid="EZK 39:17"/><verse number="18" style="v" sid="EZK 39:18"/>तुमन सक्तिसाली आदमीमन के मांस खाहू अऊ धरती के हाकिममन के खून ला अइसे पीहू, मानो ओमन मेढ़ा अऊ मेढ़ा-पीला, बोकरा अऊ बईलामन अंय—जम्मो के जम्मो बासान के मोटा-ताजा पसु होहीं। <verse eid="EZK 39:18"/><verse number="19" style="v" sid="EZK 39:19"/>जऊन बलिदान मेंह तुम्हर बर तियार करत हंव, ओला खावत-खावत तुमन अघा जाहू अऊ खून ला पीयत-पीयत तुमन छक जाहू। <verse eid="EZK 39:19"/><verse number="20" style="v" sid="EZK 39:20"/>तुमन मोर मेज म घोड़ा अऊ सवारमन, सक्तिसाली आदमी अऊ हर किसम के सैनिकमन ला खाके अघा जाहू,’ परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 39:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 39:21"/>“मेंह जाति-जाति के मनखेमन के बीच अपन महिमा परगट करहूं, अऊ जम्मो जाति के मनखेमन ओमन ला दिये मोर दंड अऊ ओमन ऊपर उठे मोर हांथ ला देखहीं। <verse eid="EZK 39:21"/><verse number="22" style="v" sid="EZK 39:22"/>ओ दिन ले लेके आघू तक इसरायल के मनखेमन जानहीं कि में यहोवा ओमन के परमेसर अंव। <verse eid="EZK 39:22"/><verse number="23" style="v" sid="EZK 39:23"/>अऊ जाति-जाति के मनखेमन जानहीं कि इसरायली मनखेमन अपन पाप के कारन बंधुवई म गेय रिहिन, काबरकि ओमन मोर संग बिसवासघात करिन। एकरसेति मेंह अपन मुहूं ओमन से मोड़ लेंव अऊ ओमन ला ओमन के बईरीमन के अधीन कर देंव, अऊ ओमन जम्मो तलवार ले मारे गीन। <verse eid="EZK 39:23"/><verse number="24" style="v" sid="EZK 39:24"/>मेंह ओमन के असुधता अऊ ओमन के अपराध के मुताबिक ओमन ले बरताव करेंव, अऊ मेंह ओमन ले अपन मुहूं मोड़ लेंव।<verse eid="EZK 39:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 39:25"/>“एकरसेति परमपरधान यहोवा ह ये कहत हे: अब मेंह याकूब ला बंधुवई ले लहुंटा ले आहूं, अऊ इसरायल के जम्मो मनखेमन ऊपर दया करहूं, अऊ अपन पबितर नांव बर मेंह उत्साही होहूं। <verse eid="EZK 39:25"/><verse number="26" style="v" sid="EZK 39:26"/>जब ओमन अपन देस म सुरकछित रिहिन अऊ ओमन ला कोनो डरवइया नइं रिहिस, तब ओमन जऊन लज्जा अऊ मोर संग बिसवासघात के काम करे रिहिन, ओ जम्मो ला भुला जाहीं। <verse eid="EZK 39:26"/><verse number="27" style="v" sid="EZK 39:27"/>जब मेंह ओमन ला जाति-जाति के बीच ले वापिस ले आहूं, अऊ ओमन के बईरीमन के देसमन ले ओमन ला इकट्ठा करहूं, तब ओमन के जरिये मेंह बहुंते जातिमन के नजर म पबितर ठहिरहूं। <verse eid="EZK 39:27"/><verse number="28" style="v" sid="EZK 39:28"/>तब ओमन जानहीं कि में यहोवा ओमन के परमेसर अंव, हालाकि मेंह ओमन ला जाति-जाति के मनखेमन के बीच बंधुवई म भेज दे रहेंव, पर में ओमन ला ओमन के खुद के देस म इकट्ठा करहूं, अऊ एको झन ला भी परदेस म नइं छोड़ंव। <verse eid="EZK 39:28"/><verse number="29" style="v" sid="EZK 39:29"/>में ओमन ले फेर कभू अपन मुहूं नइं मोड़ंव, काबरकि में इसरायल के मनखेमन ऊपर अपन आतमा उंडेलहूं, परमपरधान यहोवा ह घोसना करत हे।”<verse eid="EZK 39:29"/></para>
  <chapter eid="EZK 39"/>
  <chapter number="40" style="c" sid="EZK 40"/>
  <para style="s1">मंदिर के इलाका ला सुधारे जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 40:1"/>हमर बंधुवई के पच्चीसवां बछर के सुरू म, महिना के दसवां दिन, जऊन ह यरूसलेम नगर के पतन के बाद के चौदहवां बछर रिहिस, ओहीच दिन यहोवा के हांथ मोर ऊपर रिहिस अऊ ओह मोला उहां ले गीस। <verse eid="EZK 40:1"/><verse number="2" style="v" sid="EZK 40:2"/>परमेसर के दरसन म ओह मोला इसरायल के देस म ले गीस अऊ मोला एक बहुंत ऊंचहा पहाड़ म ठाढ़ कर दीस, जेकर दक्खिन कोति कुछू भवनमन रिहिन, जऊन ह एक सहर सहीं दिखय। <verse eid="EZK 40:2"/><verse number="3" style="v" sid="EZK 40:3"/>ओह मोला उहां ले गीस, अऊ मेंह एक आदमी ला देखेंव, जेकर रूप ह कांसा असन रिहिस; ओह अपन हांथ म सन के रस्सी अऊ नापे के एक लउठी लेके खड़े रिहिस। <verse eid="EZK 40:3"/><verse number="4" style="v" sid="EZK 40:4"/>ओ आदमी ह मोर ले कहिस, “हे मनखे के बेटा, धियान से देख, अऊ लकठा म जाके सुन अऊ जऊन कुछू मेंह तोला देखाहूं, ओ जम्मो ऊपर धियान दे, काबरकि इही काम बर तोला इहां लाय गे हवय। जऊन कुछू तेंह देखथस, ओ जम्मो चीज इसरायल के मनखेमन ला बता।”<verse eid="EZK 40:4"/></para>
  <para style="s2">बाहिर के अंगना बर पूरब के दुवार</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 40:5"/>मेंह एक दीवार देखेंव, जऊन ह मंदिर के इलाका ला पूरा घेरे रहय, ओ मनखे के हांथ म नापे के जऊन लउठी रिहिस, ओकर लम्बई छै क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:5 </char><char style="ft" closed="false">लगभग 11 फीट</char></note> रिहिस, जेमा के हर एक ह एक क्यूबीट अऊ एक हांथ चौड़ा रिहिस। ओह दीवार ला नापिस; ओह एक लउठी मोटा अऊ एक लउठी ऊंचहा रिहिस।<verse eid="EZK 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 40:6"/>तब ओह पूरब के दुवार मेर आईस। ओह ओकर सीढ़ी चघके दुवार के चौखट ला नापिस, जेकर चौड़ई एक लउठी भर रिहिस। <verse eid="EZK 40:6"/><verse number="7" style="v" sid="EZK 40:7"/>पहरेदारमन के खोलीमन एक लउठी भर लम्बा अऊ एक लउठी भर चौड़ा रिहिन, अऊ पहरेदारमन के खोलीमन के बीच के दीवारमन पांच क्यूबीट रिहिन। मंडप के बाद के दीवार, जऊन ह मंदिर कोति रिहिस, ओकर ऊंचई एक लउठी भर रिहिस।<verse eid="EZK 40:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 40:8"/>तब ओह दुवार के मंडप ला नापिस; <verse eid="EZK 40:8"/><verse number="9" style="v" sid="EZK 40:9"/>ओकर ऊंचई आठ क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:9 </char><char style="ft" closed="false">लगभग 14 फीट</char></note> रिहिस अऊ येकर खंभामन दू क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:9 </char><char style="ft" closed="false">लगभग साढ़े तीन फीट</char></note> मोटा रिहिन। दुवार के मंडप ह मंदिर कोति रिहिस।<verse eid="EZK 40:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 40:10"/>पूरबी दुवार के भीतर दूनों कोति तीन-तीन ठन पहरावाली खोलीमन रिहिन; तीनों के नाप एक समान रिहिस, अऊ दूनों कोति के दीवारमन घलो एकेच नाप के रिहिन। <verse eid="EZK 40:10"/><verse number="11" style="v" sid="EZK 40:11"/>तब ओह प्रवेस दुवार के चौड़ई ला नापिस, जऊन ह दस क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:11 </char><char style="ft" closed="false">लगभग 18 फीट</char></note> रिहिस अऊ येकर लम्बई तेरह क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:11 </char><char style="ft" closed="false">लगभग 23 फीट</char></note> रिहिस। <verse eid="EZK 40:11"/><verse number="12" style="v" sid="EZK 40:12"/>हर एक पहरावाली खोली के आघू म एक क्यूबीट ऊंचहा दीवार रिहिस, अऊ पहरावाली खोलीमन छै-छै क्यूबीट के रिहिन अऊ वर्गाकार रिहिन। <verse eid="EZK 40:12"/><verse number="13" style="v" sid="EZK 40:13"/>तब ओह एक पहरावाली खोली के पाछू के दीवार के टीप ले दूसर कोति के टीप तक दुवार ला नापिस; एक तरफ के ऊंचहा दीवार ले लेके दूसर तरफ के ऊंचहा दीवार तक, ओकर दूरी पच्चीस क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:13 </char><char style="ft" closed="false">लगभग 44 फीट</char></note> रिहिस। <verse eid="EZK 40:13"/><verse number="14" style="v" sid="EZK 40:14"/>ओह दुवार के भीतर चारों कोति के निकले दीवारमन ला नापिस, जऊन ह साठ क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:14 </char><char style="ft" closed="false">लगभग 105 फीट</char></note> रिहिस। मंडप तक नापे गीस, जेकर मुहूं ह अंगना कोति रिहिस। <verse eid="EZK 40:14"/><verse number="15" style="v" sid="EZK 40:15"/>प्रवेस दुवार ले लेके येकर मंडप के आखिरी छोर तक के दूरी पचास क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:15 </char><char style="ft" closed="false">लगभग 88 फीट</char></note> रिहिस। <verse eid="EZK 40:15"/><verse number="16" style="v" sid="EZK 40:16"/>पहरावाली खोलीमन म अऊ दुवार के भीतर चारों खूंट दीवारमन म छोटे खिड़कीमन रिहिन, वइसने ही मंडप घलो रिहिस; ये खिड़कीमन भीतर कोति खुलंय। निकले दीवारमन के सामनेवाले भाग म खजूर के रूख बनाके सजाय गे रिहिस।<verse eid="EZK 40:16"/></para>
  <para style="s2">बाहिर के अंगना</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 40:17"/>तब ओह मोला बाहिर के अंगना म ले आईस। उहां मेंह कुछू खोली अऊ पक्का बने एक पैदल रसता ला देखेंव, जेला अंगना के चारों कोति बनाय गे रिहिस; ओ रसता के संग तीस ठन खोलीमन बनाय गे रिहिन। <verse eid="EZK 40:17"/><verse number="18" style="v" sid="EZK 40:18"/>येह दुवार के तीर ले मिले हुए रिहिस अऊ येमन के लम्बई अऊ चौड़ई एक बरोबर रिहिस; येह खाल्हे के पैदल रसता रिहिस। <verse eid="EZK 40:18"/><verse number="19" style="v" sid="EZK 40:19"/>तब ओह खाल्हे के दुवार के भीतर ले लेके भीतरी अंगना के बाहिर तक के दूरी ला नापिस; ये दूरी पूरब कोति अऊ संग म उत्तर कोति एक सौ क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:19 </char><char style="ft" closed="false">लगभग 175 फीट</char></note> रिहिस।<verse eid="EZK 40:19"/></para>
  <para style="s2">उत्तरी दुवार</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 40:20"/>तब ओह उत्तरी दुवार के लम्बई अऊ चौड़ई ला नापिस, जऊन ह बाहिरी अंगना मेर जावत रिहिस। <verse eid="EZK 40:20"/><verse number="21" style="v" sid="EZK 40:21"/>दुवार के दूनों कोति तीन-तीन ठन पहरावाली खोलीमन रिहिन, येकर ले लगे दीवारमन अऊ येकर मंडप के नाप ठीक पहिला दुवार सहीं रिहिस। येह पचास क्यूबीट लम्बा अऊ पच्चीस क्यूबीट चौड़ा रिहिस। <verse eid="EZK 40:21"/><verse number="22" style="v" sid="EZK 40:22"/>येकर खिड़कीमन, येकर मंडप अऊ येकर खजूर के रूखमन के सजावट के नाप ओ दुवार सहीं रिहिस, जेकर मुहूं पूरब कोति रिहिस। येकर ऊपर जाय बर सीढ़ी म सात ठन पांवदान रिहिन, अऊ येकर मंडप ओमन के सामने म रिहिस। <verse eid="EZK 40:22"/><verse number="23" style="v" sid="EZK 40:23"/>भीतरी अंगना म एक दुवार रिहिस, जऊन ह उत्तर कोति खुलय, जइसे कि उहां पूरब कोति घलो रिहिस। ओह एक दुवार ले लेके सामने के दुवार के दूरी ला नापिस; येह एक सौ क्यूबीट रिहिस।<verse eid="EZK 40:23"/></para>
  <para style="s2">दक्खिनी दुवार</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 40:24"/>तब ओह मोला दक्खिन कोति ले गीस अऊ मेंह दक्खिन के दुवार ला देखेंव। ओह येकर चौखटमन ला अऊ मंडप ला नापिस, अऊ येमन के नाप घलो आने मन सहीं रिहिस। <verse eid="EZK 40:24"/><verse number="25" style="v" sid="EZK 40:25"/>दुवार अऊ येकर मंडप के चारों कोति छोटे खिड़कीमन रिहिन, जेमन आने खिड़कीमन सहीं रिहिन। येकर लम्बई पचास क्यूबीट अऊ चौड़ई पच्चीस क्यूबीट रिहिस। <verse eid="EZK 40:25"/><verse number="26" style="v" sid="EZK 40:26"/>येकर ऊपर जाय बर सीढ़ी के पांच पांवदान रिहिन, अऊ येकर मंडप ओमन के आघू म रिहिस; येकर दूनों कोति दीवारमन म खजूर के रूख बनाके सजाय गे रिहिस। <verse eid="EZK 40:26"/><verse number="27" style="v" sid="EZK 40:27"/>भीतरी अंगना के घलो एक दुवार रिहिस, जऊन ह दक्खिन कोति खुलत रिहिस, अऊ ओह ये दुवार ले लेके दक्खिन के बाहिरी दुवार तक नापिस, येह एक सौ क्यूबीट रिहिस।<verse eid="EZK 40:27"/></para>
  <para style="s2">भीतरी अंगना के दुवार</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 40:28"/>तब ओह मोला दक्खिनी दुवार ले होके भीतरी अंगना म ले आईस, अऊ ओह दक्खिनी दुवार ला नापिस; येकर नाप घलो आने मन सहीं ही रिहिस। <verse eid="EZK 40:28"/><verse number="29" style="v" sid="EZK 40:29"/>येकर पहरावाली खोलीमन, येकर ले जुड़े दीवारमन अऊ येकर मंडप के नाप घलो आने मन सहीं रिहिस। दुवार अऊ येकर मंडप के चारों खूंट खिड़कीमन रिहिन। येह पचास क्यूबीट लम्बा अऊ पच्चीस क्यूबीट चौड़ा रिहिस। <verse eid="EZK 40:29"/><verse number="30" style="v" sid="EZK 40:30"/>(भीतरी अंगना के चारों खूंट के दुवारमन के मंडपमन पच्चीस क्यूबीट चौड़ा अऊ पांच क्यूबीट गहरा रिहिन।) <verse eid="EZK 40:30"/><verse number="31" style="v" sid="EZK 40:31"/>येकर मंडप के मुहूं ह बाहिरी अंगना कोति रिहिस; येकर चौखटमन म खजूर के रूखमन ला बनाके सजाय गे रिहिस, अऊ येकर ऊपर जाय बर सीढ़ी के आठ ठन पांवदान रिहिन।<verse eid="EZK 40:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 40:32"/>तब ओह मोला पूरब कोति भीतरी अंगना म ले आईस, अऊ ओह दुवार ला नापिस; येकर नाप घलो आने मन सहीं रिहिस। <verse eid="EZK 40:32"/><verse number="33" style="v" sid="EZK 40:33"/>येकर पहरावाली खोलीमन, येकर ले जुड़े दीवारमन अऊ येकर मंडप के नाप घलो आने मन सहीं रिहिस। दुवार अऊ येकर मंडप के चारों खूंट खिड़कीमन रिहिन। येह पचास क्यूबीट लम्बा अऊ पच्चीस क्यूबीट चौड़ा रिहिस। <verse eid="EZK 40:33"/><verse number="34" style="v" sid="EZK 40:34"/>येकर मंडप के मुहूं बाहिरी अंगना कोति रिहिस; दूनों कोति येकर चौखट म खजूर के रूखमन ला बनाके सजाय गे रिहिस, अऊ येकर ऊपर जाय बर सीढ़ी के आठ ठन पांवदान रिहिन।<verse eid="EZK 40:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 40:35"/>तब ओह मोला उत्तरी दुवार मेर ले आईस अऊ ओला नापिस। येकर नाप घलो आने मन सहीं रिहिस, <verse eid="EZK 40:35"/><verse number="36" style="v" sid="EZK 40:36"/>वइसे ही येकर पहरावाली खोलीमन, येकर से लगे दीवारमन अऊ मंडप रिहिस, अऊ येकर चारों खूंट खिड़कीमन रिहिन। येह पचास क्यूबीट लम्बा अऊ पच्चीस क्यूबीट चौड़ा रिहिस। <verse eid="EZK 40:36"/><verse number="37" style="v" sid="EZK 40:37"/>येकर मंडप के मुहूं ह बाहिरी अंगना कोति रिहिस; येकर चौखट म दूनों कोति खजूर के रूखमन ला बनाके सजाय गे रिहिस, अऊ येकर ऊपर जाय बर सीढ़ी के आठ ठन पांवदान रिहिन।<verse eid="EZK 40:37"/></para>
  <para style="s2">बलिदान तियार करे बर खोलीमन</para>
  <para style="p">
    <verse number="38" style="v" sid="EZK 40:38"/>हर एक भीतरी दुवार के मंडप के बाजू म एक कपाट के संग एक खोली रिहिस, जिहां होम-बलिदान ला धोय जावत रिहिस। <verse eid="EZK 40:38"/><verse number="39" style="v" sid="EZK 40:39"/>दुवार के मंडप म दूनों कोति दू-दू ठन मेज रिहिन, जेमा होम-बलिदान, पाप-बलिदान अऊ दोस-बलिदान के पसुमन ला बध करे जावत रिहिस। <verse eid="EZK 40:39"/><verse number="40" style="v" sid="EZK 40:40"/>दुवार के मंडप के बाहिरी दीवार के बाजू म, उत्तरी प्रवेस दुवार के लकठा म दू ठन मेज रिहिन, अऊ सीढ़ी के दूसर कोति भी दू ठन मेज रिहिन। <verse eid="EZK 40:40"/><verse number="41" style="v" sid="EZK 40:41"/>ये किसम ले दुवार के एक तरफ चार ठन मेज अऊ दूसर कोति चार ठन मेज रिहिन—कुल आठ ठन मेज रिहिन, जेमा बलिदान के पसुमन के बध करे जावय। <verse eid="EZK 40:41"/><verse number="42" style="v" sid="EZK 40:42"/>होम-बलिदान बर गढ़े गय पथरा ले बने चार ठन मेज रिहिन, येमा के हर एक ह डेड़ क्यूबीट लम्बा, डेड़ क्यूबीट चौड़ा अऊ एक क्यूबीट ऊंचहा रिहिस।<note caller="+" style="f"><char style="fr" closed="false">40:42 </char><char style="ft" closed="false">लगभग 2 2⁄3 फीट लम्बा अऊ चौड़ा अऊ 21 ईंच ऊंचहा</char></note> येमन म ओ बरतनमन रखे रिहिन, जेमन के उपयोग होम-बलिदान अऊ आने बलिदान के पसुमन ला बध करे म होवय। <verse eid="EZK 40:42"/><verse number="43" style="v" sid="EZK 40:43"/>दीवार के चारों खूंट दोहरा दांतवाले कांटामन ला लगाय गे रिहिस, जेमा के हर एक के लम्बई हथेली<note caller="+" style="f"><char style="fr" closed="false">40:43 </char><char style="ft" closed="false">लगभग 3 1⁄2 ईंच</char></note> भर रिहिस। ये मेजमन बलिदान करे गय पसुमन के मांस रखे बर रिहिन।<verse eid="EZK 40:43"/></para>
  <para style="s2">पुरोहितमन बर कमरामन</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 40:44"/>भीतरी दुवार के बाहिर, भीतरी अंगना के भीतर दू ठन कमरा रिहिन, एक ठन उत्तरी दुवार कोति रिहिस, जऊन ह दक्खिन कोति खुलय, अऊ दूसर ह दक्खिन दुवार कोति रिहिस, जऊन ह उत्तर कोति खुलय। <verse eid="EZK 40:44"/><verse number="45" style="v" sid="EZK 40:45"/>ओह मोर ले कहिस, “जऊन कमरा ह दक्खिन कोति खुलथे, ओह ओ पुरोहितमन बर अय, जेमन मंदिर के पहरेदारी करथें, <verse eid="EZK 40:45"/><verse number="46" style="v" sid="EZK 40:46"/>अऊ ओ कमरा जऊन ह उत्तर कोति खुलथे, ओह ओ पुरोहितमन बर अय, जेमन बेदी के पहरेदारी करथें। येमन सादोक के बेटामन अंय, अऊ येमन ही सिरिप ओ लेवी अंय, जेमन यहोवा के लकठा म जाके ओकर आघू म सेवा-टहल करंय।”<verse eid="EZK 40:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="EZK 40:47"/>तब ओह अंगना ला नापिस: येह वर्गाकार रिहिस—एक सौ क्यूबीट लम्बा अऊ एक सौ क्यूबीट चौड़ा। अऊ बेदी ह मंदिर के सामने म रिहिस।<verse eid="EZK 40:47"/></para>
  <para style="s1">नवां मंदिर</para>
  <para style="p">
    <verse number="48" style="v" sid="EZK 40:48"/>तब ओह मोला मंदिर के मंडप म ले आईस अऊ ओह मंडप के चौखटमन ला नापिस; येमन दूनों कोति पांच-पांच क्यूबीट चौड़ा रिहिन। प्रवेस दुवार के चौड़ई चौदह क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:48 </char><char style="ft" closed="false">लगभग 25 फीट</char></note> अऊ येकर ले लगे दीवारमन के चौड़ई दूनों कोति तीन-तीन क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:48 </char><char style="ft" closed="false">लगभग 5 1⁄4 फीट</char></note> रिहिस। <verse eid="EZK 40:48"/><verse number="49" style="v" sid="EZK 40:49"/>मंडप ह बीस क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:49 </char><char style="ft" closed="false">लगभग 35 फीट</char></note> चौड़ा रिहिस, अऊ सामने ले लेके पाछू तक बारह क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">40:49 </char><char style="ft" closed="false">लगभग 21 फीट</char></note> रिहिस। ओमा चघे बर सीढ़ीमन रिहिन, अऊ दूनों कोति के चौखट के बाजू म खंभामन रिहिन।<verse eid="EZK 40:49"/></para>
  <chapter eid="EZK 40"/>
  <chapter number="41" style="c" sid="EZK 41"/>
  <para style="p">
    <verse number="1" style="v" sid="EZK 41:1"/>तब ओह मोला मुख्य बड़े कमरा म ले आईस अऊ चौखटमन ला नापिस; दूनों कोति के चौखटमन के चौड़ई छै-छै क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">41:1 </char><char style="ft" closed="false">लगभग 11 फीट</char></note> रिहिस। <verse eid="EZK 41:1"/><verse number="2" style="v" sid="EZK 41:2"/>प्रवेस दुवार के चौड़ई दस क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">41:2 </char><char style="ft" closed="false">लगभग 18 फीट</char></note>, अऊ येकर ले लगे दूनों कोति के दीवारमन के चौड़ई पांच-पांच क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">41:2 </char><char style="ft" closed="false">लगभग 8 3⁄4 फीट</char></note> रिहिस। ओह मुख्य बड़े कमरा ला घलो नापिस; येह चालीस क्यूबीट लम्बा अऊ बीस क्यूबीट चौड़ा रिहिस।<note caller="+" style="f"><char style="fr" closed="false">41:2 </char><char style="ft" closed="false">लगभग 70 फीट लम्बा अऊ 35 फीट चौड़ा</char></note><verse eid="EZK 41:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 41:3"/>तब ओह भीतरी पबितर-स्थान म गीस अऊ प्रवेस दुवार के चौखटमन ला नापिस; हर एक ह दू-दू क्यूबीट चौड़ा रिहिस। प्रवेस दुवार ह छै क्यूबीट चौड़ा रिहिस, अऊ येकर ले लगे दूनों कोति के दीवारमन सात-सात क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">41:3 </char><char style="ft" closed="false">लगभग 12 फीट</char></note> चौड़ा रिहिन। <verse eid="EZK 41:3"/><verse number="4" style="v" sid="EZK 41:4"/>तब ओह भीतरी पबितर-स्थान के लम्बई ला नापिस; येह बीस क्यूबीट रिहिस, अऊ येकर चौड़ई मुख्य बड़े कमरा के आखिरी तक बीस क्यूबीट रिहिस। ओह मोला कहिस, “येह महा पबितर स्थान ए।”<verse eid="EZK 41:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 41:5"/>तब ओह मंदिर के दीवार ला नापिस; येह छै क्यूबीट मोटा रिहिस, अऊ हर तरफ मंदिर के चारों कोति कमरा के चौड़ई चार-चार क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">41:5 </char><char style="ft" closed="false">लगभग 7 फीट</char></note> रिहिस। <verse eid="EZK 41:5"/><verse number="6" style="v" sid="EZK 41:6"/>बाजू के कमरामन तीन मंजिला रिहिन, एक के ऊपर दूसरा, हर एक मंजिल म तीस-तीस ठन कमरा रिहिन। बाजू के कमरामन ला सहारा देय बर मंदिर के दीवार के चारों कोति निकले भागमन रिहिन, जेकर कारन सहारा देवइया भागमन ला मंदिर के दीवार म घुसाय नइं गे रिहिस। <verse eid="EZK 41:6"/><verse number="7" style="v" sid="EZK 41:7"/>मंदिर के चारों कोति बाजू के कमरामन हर मंजिल म चौड़ा होवत गे रिहिन। मंदिर के चारों कोति के बनावट हर मंजिल म बड़े होवत गे रिहिस, जेकर कारन ऊपर जाय ले कमरामन चौड़ा होवत गे रिहिन। खाल्हे के मंजिल ले एक सीढ़ी बीच के मंजिल ले होवत ऊपर के मंजिल तक गे रिहिस।<verse eid="EZK 41:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 41:8"/>मेंह देखेंव कि मंदिर के चारों कोति एक उठे हुए आधार रिहिस, जऊन ह बाजू के कमरामन के नीव बने रिहिस। येह लउठी के लम्बई के रिहिस, छै क्यूबीट लम्बा। <verse eid="EZK 41:8"/><verse number="9" style="v" sid="EZK 41:9"/>बाजू के कमरामन के बाहिरी दीवार पांच क्यूबीट मोटा रिहिस। मंदिर के बाजू के कमरामन के बीच म खुला जगह रिहिस <verse eid="EZK 41:9"/><verse number="10" style="v" sid="EZK 41:10"/>अऊ पुरोहितमन के कमरामन के बीच के खुला भाग ह मंदिर के चारों कोति बीस क्यूबीट चौड़ा रिहिस। <verse eid="EZK 41:10"/><verse number="11" style="v" sid="EZK 41:11"/>खुले भाग ले बाजू के कमरामन म जाय बर प्रवेस दुवारमन रिहिन, एक ठन उत्तर म अऊ एक ठन दक्खिन म रिहिस; अऊ चारों कोति खुले हुए भाग ले जुड़े आधार के चौड़ई पांच क्यूबीट रिहिस।<verse eid="EZK 41:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 41:12"/>ओ भवन, जेकर मुहूं मंदिर के अंगना कोति पछिम भाग म रिहिस, ओकर चौड़ई सत्तर क्यूबीट रिहिस। चारों कोति ये भवन के दीवार के मोटई पांच क्यूबीट रिहिस, अऊ येकर लम्बई नब्बे क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">41:12 </char><char style="ft" closed="false">लगभग 158 फीट</char></note> रिहिस।<verse eid="EZK 41:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 41:13"/>तब ओह मंदिर ला नापिस; येह एक सौ क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">41:13 </char><char style="ft" closed="false">लगभग 175 फीट</char></note> लम्बा रिहिस, अऊ मंदिर के अंगना अऊ अपन दीवारमन के संग भवन ह घलो एक सौ क्यूबीट लम्बा रिहिस। <verse eid="EZK 41:13"/><verse number="14" style="v" sid="EZK 41:14"/>मंदिर के आघू के भाग ला मिलाके मंदिर के अंगना के चौड़ई पूरब कोति एक सौ क्यूबीट रिहिस।<verse eid="EZK 41:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 41:15"/>तब ओह मंदिर के पाछू कोति ओ भवन के लम्बई ला नापिस, जेकर मुहूं अंगना कोति रिहिस, येकर दूनों कोति के गैलरी ला मिलाके येकर लम्बई एक सौ क्यूबीट रिहिस।</para>
  <para style="p" vid="EZK 41:15">मुख्य बड़े कमरा, भीतरी पबितर-स्थान अऊ अंगना के सामने के मंडप, <verse eid="EZK 41:15"/><verse number="16" style="v" sid="EZK 41:16"/>संगे-संग दुवारमन अऊ संकरा खिड़कीमन अऊ ओ तीनों के चारों कोति के गैलरीमन—हर एक चीज के अलावा अऊ दुवार ला मिलाके जम्मो चीज लकरी ले मढ़े गे रिहिस। फर्स, खिड़की तक के दीवार, अऊ खिड़कीमन घलो मढ़े गे रिहिन। <verse eid="EZK 41:16"/><verse number="17" style="v" sid="EZK 41:17"/>भीतरी पबितर-स्थान के प्रवेस दुवार के ऊपर के जगह अऊ भीतरी अऊ बाहिरी पबितर-स्थान के चारों कोति दीवारमन म बरोबर जगह छोंड़-छोंड़के <verse eid="EZK 41:17"/><verse number="18" style="v" sid="EZK 41:18"/>करूब अऊ खजूर के रूखमन के नक्कासी करे गे रिहिस। खजूर के रूख अऊ करूबमन ला एक के बाद एक बनाय गे रिहिस। हर करूब के दू-दू ठन मुहूं रिहिस: <verse eid="EZK 41:18"/><verse number="19" style="v" sid="EZK 41:19"/>करूब के एक मुहूं ह एक तरफ के खजूर के रूख कोति मनखे के मुहूं सहीं अऊ करूब के दूसरा मुहूं ह दूसर कोति के खजूर के रूख कोति सिंह के मुहूं सहीं रिहिस। ये नक्कासी चारों खूंट पूरा मंदिर म करे गे रिहिस। <verse eid="EZK 41:19"/><verse number="20" style="v" sid="EZK 41:20"/>मुख्य बड़े कमरा के दीवार म फर्स ले लेके प्रवेस दुवार के ऊपरी भाग तक, करूब अऊ खजूर के रूखमन के नक्कासी करे गे रिहिस।<verse eid="EZK 41:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 41:21"/>मुख्य बड़े कमरा के एक चौकोर चौखट रिहिस, अऊ महा पबितर स्थान के सामने म घलो अइसने ही एक चौखट रिहिस। <verse eid="EZK 41:21"/><verse number="22" style="v" sid="EZK 41:22"/>उहां लकरी के एक बेदी रिहिस, जऊन ह तीन क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">41:22 </char><char style="ft" closed="false">लगभग 5 1⁄4 फीट</char></note> ऊंचहा रिहिस, अऊ येकर लम्बई अऊ चौड़ई दू-दू क्यूबीट रिहिस; येकर कोना, येकर आधार अऊ येकर किनारामन लकरी के बने रिहिन। ओ आदमी ह मोर ले कहिस, “येह ओ मेज अय, जऊन ह यहोवा के आघू म हवय।” <verse eid="EZK 41:22"/><verse number="23" style="v" sid="EZK 41:23"/>मुख्य बड़े कमरा अऊ महा पबितर स्थान के दू-दू ठन कपाट रिहिन। <verse eid="EZK 41:23"/><verse number="24" style="v" sid="EZK 41:24"/>हर एक कपाट के दू-दू ठन पल्ला रिहिन—हर एक कपाट के पल्ला म दू-दू ठन कब्जा लगे रिहिन। <verse eid="EZK 41:24"/><verse number="25" style="v" sid="EZK 41:25"/>अऊ मुख्य बड़े कमरा के कपाटमन म दीवारमन सहीं करूब अऊ खजूर के रूखमन के नक्कासी करे गे रिहिस, अऊ मंडप के सामने म कठवा के मोटा-मोटा बल्ली रिहिस। <verse eid="EZK 41:25"/><verse number="26" style="v" sid="EZK 41:26"/>मंडप के बाजू के दीवारमन म संकरा खिड़कीमन रिहिन अऊ खिड़कीमन म दूनों कोति खजूर के रूखमन के नक्कासी करे गे रिहिस। मंदिर के बाजू के कमरामन म घलो मोट-मोट बल्लीमन रिहिन।<verse eid="EZK 41:26"/></para>
  <chapter eid="EZK 41"/>
  <chapter number="42" style="c" sid="EZK 42"/>
  <para style="s1">पुरोहितमन बर कमरा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 42:1"/>तब ओ आदमी मोला उत्तर कोति बाहिरी अंगना म ले गीस अऊ मंदिर के अंगना के सामने के कमरामन म ले आईस, जऊन ह उत्तर दिग के बाहिरी दीवार के सामने रिहिस। <verse eid="EZK 42:1"/><verse number="2" style="v" sid="EZK 42:2"/>ओ भवन जेकर कपाट उत्तर कोति रिहिस, ओकर लम्बई एक सौ क्यूबीट अऊ चौड़ई पचास क्यूबीट रिहिस। <verse eid="EZK 42:2"/><verse number="3" style="v" sid="EZK 42:3"/>भीतरी अंगना ले दूनों भाग म बीस क्यूबीट अऊ बाहिरी अंगना के पैदल रसता के सामने के भाग म, तीनों मंजिल म गैलरी के सामने गैलरी रिहिस। <verse eid="EZK 42:3"/><verse number="4" style="v" sid="EZK 42:4"/>कमरामन के सामने म एक भीतरी रसता रिहिस, जऊन ह दस क्यूबीट चौड़ा अऊ एक सौ क्यूबीट लम्बा रिहिस।<note caller="+" style="f"><char style="fr" closed="false">42:4 </char><char style="ft" closed="false">लगभग 18 फीट चौड़ा अऊ 175 फीट लम्बा</char></note> ओमन के कपाटमन उत्तर कोति रिहिन। <verse eid="EZK 42:4"/><verse number="5" style="v" sid="EZK 42:5"/>ऊपर के कमरामन सांकुर रिहिन, काबरकि भवन के पहिला अऊ दूसरा मंजिल के कमरामन के तुलना म ऊपर के मंजिल के कमरामन के कुछू जगह ला गैलरीमन ले लेय रिहिन। <verse eid="EZK 42:5"/><verse number="6" style="v" sid="EZK 42:6"/>अंगनामन सहीं ऊपरी मंजिल के कमरामन म खंभा नइं रिहिन; एकरसेति पहिला अऊ दूसरा मंजिल के कमरामन के फर्स के जगह के तुलना म ऊपरी मंजिल के कमरामन के फर्स के जगह ह कम रिहिस। <verse eid="EZK 42:6"/><verse number="7" style="v" sid="EZK 42:7"/>कमरामन अऊ बाहिरी अंगना के समानांतर एक बाहिरी दीवार रिहिस; येह कमरामन के सामने पचास क्यूबीट तक आघू बढ़े रिहिस। <verse eid="EZK 42:7"/><verse number="8" style="v" sid="EZK 42:8"/>बाहिरी अंगना के बाद, तीर म कमरामन के कतार के लम्बई पचास क्यूबीट रिहिस, पबितर-स्थान के सबले नजदीक, तीर म कतार के लम्बई एक सौ क्यूबीट रिहिस। <verse eid="EZK 42:8"/><verse number="9" style="v" sid="EZK 42:9"/>बाहिरी अंगना ले खाल्हे कमरामन म जाय बर पूरब कोति एक प्रवेस दुवार रिहिस।<verse eid="EZK 42:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 42:10"/>दक्खिन कोति बाहिरी अंगना के दीवार के लम्बई के संग, मंदिर के अंगना ले जुड़के अऊ बाहिरी दीवार के सामने म कमरामन रिहिन, <verse eid="EZK 42:10"/><verse number="11" style="v" sid="EZK 42:11"/>अऊ ओमन के सामने म एक रसता रिहिस। ये कमरामन उत्तर कोति के कमरामन सहीं रिहिन; ओमन के लम्बई अऊ चौड़ई घलो वइसने ही रिहिस, अऊ ओमन के निकासी अऊ बनावट म घलो समानता रिहिस। उत्तर कोति के कपाटमन सहीं <verse eid="EZK 42:11"/><verse number="12" style="v" sid="EZK 42:12"/>दक्खिन कोति के कमरामन के कपाटमन रिहिन। कमरामन म जाय बर, रसता के सुरूआत म एक ठन कपाट रिहिस, ये रसता पूरब कोति बढ़े दीवार के समानांतर रिहिस, जेकर दुवारा कमरामन के भीतर कोनो मनखे जा सकत रिहिस।<verse eid="EZK 42:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 42:13"/>तब ओह मोर ले कहिस, “मंदिर के उत्तर अऊ दक्खिन के कमरामन पुरोहितमन के अंय, जिहां यहोवा के सेवा करइया पुरोहितमन महा पबितर बलिदानमन ला खाथें। उहां ओमन महा पबितर बलिदानमन—अन्न-बलिदान, पाप-बलिदान अऊ दोस-बलिदान ला रखंय काबरकि ये जगह ह पबितर अय। <verse eid="EZK 42:13"/><verse number="14" style="v" sid="EZK 42:14"/>जब भी पुरोहितमन पबितर जगह म जावंय, ओमन तब तक बाहिरी अंगना म नइं जावंय, जब तक कि ओमन ओ कपड़ामन ला उतारके पबितर स्थान म रख नइं देवंय, जेमन ला पहिरके ओमन सेवा करथें, काबरकि ओ कपड़ामन पबितर अंय। सधारन मनखेमन बर ठहिराय जगह के लकठा म जाय के पहिले पुरोहितमन आने कपड़ा ला पहिर लेवंय।”<verse eid="EZK 42:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 42:15"/>जब ओह मंदिर के इलाका के भीतरी भाग ला नाप लीस, तब ओह मोला पूरब के दुवार ले बाहिर ले गीस अऊ चारों कोति के इलाका ला नापिस: <verse eid="EZK 42:15"/><verse number="16" style="v" sid="EZK 42:16"/>ओह नापे के लउठी ले पूरबी भाग ला नापिस; येह पांच सौ क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">42:16 </char><char style="ft" closed="false">लगभग 875 फीट</char></note> रिहिस। <verse eid="EZK 42:16"/><verse number="17" style="v" sid="EZK 42:17"/>तब ओह उत्तरी भाग ला नापिस; येह घलो नापे के लउठी म पांच सौ क्यूबीट रिहिस। <verse eid="EZK 42:17"/><verse number="18" style="v" sid="EZK 42:18"/>तब ओह दक्खिनी भाग ला नापिस; येह घलो नापे के लउठी म पांच सौ क्यूबीट रिहिस। <verse eid="EZK 42:18"/><verse number="19" style="v" sid="EZK 42:19"/>तब ओह पछिम भाग कोति मुड़िस अऊ ओला नापिस; येह घलो नापे के लउठी म पांच सौ क्यूबीट रिहिस। <verse eid="EZK 42:19"/><verse number="20" style="v" sid="EZK 42:20"/>ये किसम ले ओह चारों कोति के भाग ला नापिस। येकर चारों मुड़ा एक ठन दीवार रिहिस, जऊन ह पांच सौ क्यूबीट लम्बा अऊ पांच सौ क्यूबीट चौड़ा रिहिस, येह पबितर जगह ला सार्वजनिक जगह ले अलग करय।<verse eid="EZK 42:20"/></para>
  <chapter eid="EZK 42"/>
  <chapter number="43" style="c" sid="EZK 43"/>
  <para style="s1">मंदिर म परमेसर के महिमा लहुंटथे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 43:1"/>तब ओ मनखे ह मोला ओ दुवार मेर ले आईस, जेकर मुहूं पूरब कोति रिहिस, <verse eid="EZK 43:1"/><verse number="2" style="v" sid="EZK 43:2"/>अऊ मेंह इसरायल के परमेसर के महिमा ला पूरब दिग ले आवत देखेंव। ओकर अवाज ह तेज बहत पानी के गरजन सहीं रिहिस, अऊ ओकर महिमा ले धरती ह जगमगावत रिहिस। <verse eid="EZK 43:2"/><verse number="3" style="v" sid="EZK 43:3"/>जऊन दरसन मेंह देखेंव येह ओ दरसन सहीं रिहिस, जेला मेंह तब देखे रहेंव जब ओह सहर ला नास करे बर आय रिहिस अऊ ओ दरसन असन रिहिस, जेला मेंह कबार नदी के तीर म देखे रहेंव, अऊ मेंह मुहूं के भार गिर पड़ेंव। <verse eid="EZK 43:3"/><verse number="4" style="v" sid="EZK 43:4"/>यहोवा के महिमा ह पूरब के दुवार ले मंदिर भीतर आईस। <verse eid="EZK 43:4"/><verse number="5" style="v" sid="EZK 43:5"/>तब आतमा ह मोला उठाके भीतरी अंगना म ले आईस, अऊ यहोवा के महिमा ले मंदिर ह भर गीस।<verse eid="EZK 43:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 43:6"/>जब ओ मनखे ह मोर बाजू म खड़े रिहिस, त मेंह सुनेंव कि कोनो मंदिर के भीतर ले मोर ले गोठियावत हे। <verse eid="EZK 43:6"/><verse number="7" style="v" sid="EZK 43:7"/>ओह कहिस: “हे मनखे के बेटा, येह मोर सिंघासन के जगह अऊ मोर पांव के तलवा रखे के जगह अय। येह ओ जगह अय जिहां में इसरायलीमन के बीच सदा निवास करहूं। इसरायल के मनखेमन फेर कभू मोर पबितर नांव ला अपबितर नइं करहीं—न तो ओमन अऊ न ही ओमन के राजामन अपन बेभिचार के दुवारा अऊ अपन राजामन के मिरतू के बेरा ओमन बर बलिदान चघाय के दुवारा अपबितर करहीं। <verse eid="EZK 43:7"/><verse number="8" style="v" sid="EZK 43:8"/>जब ओमन अपन दुवार ला मोर दुवार के लकठा म अऊ अपन चौखट ला मोर चौखट के बाजू म रखिन, अऊ मोर अऊ ओमन के बीच सिरिप एक दीवार रिहिस, त ओमन मोर पबितर नांव ला अपन घिनौना काममन के दुवारा असुध करिन। एकरसेति मेंह अपन कोरोध म ओमन ला नास कर देंव। <verse eid="EZK 43:8"/><verse number="9" style="v" sid="EZK 43:9"/>अब ओमन अपन बेभिचार अऊ अपन राजामन बर माटी देय के बेरा करे जानेवाला बलिदान ला छोंड़ देवंय, तब मेंह ओमन के बीच सदा निवास करहूं।<verse eid="EZK 43:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 43:10"/>“हे मनखे के बेटा, तेंह इसरायल के मनखेमन ला ये मंदिर के बखान कर, कि ओमन अपन पाप के काम ले लज्जित होवंय। ओमन येकर उत्तमता ऊपर बिचार करंय, <verse eid="EZK 43:10"/><verse number="11" style="v" sid="EZK 43:11"/>अऊ यदि ओमन अपन करे गय जम्मो काममन ले लज्जित होथंय, त ओमन ला मंदिर के बनावट के बारे म बता—येकर रचना, येकर निकास अऊ प्रवेस दुवार—येकर पूरा बनावट अऊ येकर पूरा नियम अऊ कानून। ओमन के आघू म ये बातमन ला लिख ले, ताकि ओमन येकर बनावट बर बिसवासयोग्य रहंय अऊ येकर नियममन ला मानंय।<verse eid="EZK 43:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 43:12"/>“येह मंदिर के कानून अय: पहाड़ के टीप के चारों खूंट के जम्मो भाग ह महा पबितर होही। येहीच ह ये मंदिर के कानून अय।<verse eid="EZK 43:12"/></para>
  <para style="s1">महान बेदी ला पहिले सहीं करे जाथे</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 43:13"/>“क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">43:13 </char><char style="ft" closed="false">लगभग 21 ईंच</char></note> म बेदी के नाप अइसने हवंय, एक क्यूबीट अऊ एक हथेली के नाप: येकर नाली ह एक क्यूबीट गहरा अऊ एक क्यूबीट चौड़ा, अऊ किनारा के चारों कोति एक स्पान<note caller="+" style="f"><char style="fr" closed="false">43:13 </char><char style="ft" closed="false">लगभग 11 ईंच</char></note> के गोट रिहिस। अऊ येह बेदी के ऊंचई ए: <verse eid="EZK 43:13"/><verse number="14" style="v" sid="EZK 43:14"/>भुइयां म नाली ले लेके खाल्हे निकले भाग तक, जऊन ह बेदी के चारों कोति जाथे, येह दू क्यूबीट ऊंचहा हवय, अऊ निकले भाग ह एक क्यूबीट चौड़ा हवय।<note caller="+" style="f"><char style="fr" closed="false">43:14 </char><char style="ft" closed="false">लगभग 3 1⁄2 फीट ऊंचहा अऊ 1 3⁄4 फीट चौड़ा</char></note> ये खाल्हे निकले भाग ले लेके ऊपर निकले भाग तक, जऊन ह बेदी के चारों कोति जाथे, येह चार क्यूबीट ऊंचहा हवय, अऊ ओ निकले भाग घलो एक क्यूबीट चौड़ा हवय।<note caller="+" style="f"><char style="fr" closed="false">43:14 </char><char style="ft" closed="false">लगभग 7 फीट लम्बा अऊ 1 3⁄4 फीट चौड़ा</char></note> <verse eid="EZK 43:14"/><verse number="15" style="v" sid="EZK 43:15"/>ओकर ऊपर, बेदी के चूल्हा ह चार क्यूबीट ऊंचहा हवय, अऊ बेदी के चूल्हा ले ऊपर कोति चार ठन सींग निकले हवंय। <verse eid="EZK 43:15"/><verse number="16" style="v" sid="EZK 43:16"/>बेदी के चूल्हा ह वर्गाकार हवय, जऊन ह बारह क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">43:16 </char><char style="ft" closed="false">लगभग 21 फीट</char></note> लम्बा अऊ बारह क्यूबीट चौड़ा हवय। <verse eid="EZK 43:16"/><verse number="17" style="v" sid="EZK 43:17"/>ऊपर के निकले भाग ह घलो वर्गाकार हवय, जऊन ह चौदह क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">43:17 </char><char style="ft" closed="false">लगभग 25 फीट</char></note> लम्बा अऊ चौदह क्यूबीट चौड़ा हवय। बेदी के चारों कोति एक क्यूबीट के एक नाली हवय, जेमा आधा क्यूबीट के एक गोट हवय। बेदी के सीढ़ी ह पूरब कोति हवय।”<verse eid="EZK 43:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 43:18"/>तब ओह मोर ले कहिस, “हे मनखे के बेटा, परमपरधान यहोवा ह ये कहत हे: जब बेदी ह बन जाही, त होम-बलिदान चघाय अऊ बेदी म लहू छिंचे बर ये बिधिमन होहीं: <verse eid="EZK 43:18"/><verse number="19" style="v" sid="EZK 43:19"/>पाप-बलिदान के रूप म तोला सादोक के परिवार के ओ लेवीय पुरोहितमन ला एक ठन बछवा देना होही, जऊन मन मोर सेवा करे बर मोर लकठा म आथें, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 43:19"/><verse number="20" style="v" sid="EZK 43:20"/>तब तेंह ओकर कुछू खून ला लेबे अऊ ओ खून ला चारों सींग अऊ निकले हुए भाग के चारों कोना अऊ किनारा म चारों कोति लगा देबे, अऊ ये किसम ले बेदी ला सुध करबे अऊ येकर बर प्रायस्चित करबे। <verse eid="EZK 43:20"/><verse number="21" style="v" sid="EZK 43:21"/>तें पाप-बलिदान के बछवा ला लेबे अऊ ओला पबितर-स्थान के बाहिर मंदिर छेत्र म ठहिराय गय भाग म जला देबे।<verse eid="EZK 43:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 43:22"/>“दूसर दिन, तेंह पाप-बलिदान बर एक ठन निरदोस बोकरा ला चघाबे, अऊ बेदी ला वइसने ही सुध करे जावय, जइसने बछवा ला लेके करे गे रिहिस। <verse eid="EZK 43:22"/><verse number="23" style="v" sid="EZK 43:23"/>जब तेंह ओला सुध कर डारबे, तब तें झुंड ले एक निरदोस बछवा अऊ एक निरदोस मेढ़ा लेके चघाबे। <verse eid="EZK 43:23"/><verse number="24" style="v" sid="EZK 43:24"/>तोला यहोवा के आघू म ओमन ला अरपन करना हे, अऊ पुरोहितमन ओमन ऊपर नून ला छिंचंय अऊ ओमन ला होम-बलिदान के रूप म यहोवा ला चघावंय।<verse eid="EZK 43:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 43:25"/>“सात दिन तक एक-एक ठन बोकरा तोला हर एक दिन पाप-बलिदान बर देना हे; झुंड म ले तोला एक-एक ठन निरदोस बछवा अऊ मेढ़ा घलो देना हे। <verse eid="EZK 43:25"/><verse number="26" style="v" sid="EZK 43:26"/>सात दिन तक, ओमन बेदी बर प्रायस्चित करंय अऊ सुध करंय; ये किसम ले ओमन येकर संस्कार करहीं। <verse eid="EZK 43:26"/><verse number="27" style="v" sid="EZK 43:27"/>जब ओ सात दिन खतम हो जाहीं, त आठवां दिन ले, पुरोहितमन तुम्हर होम-बलिदान अऊ मेल-बलिदान ला बेदी म चघांय। तब मेंह तुमन ला स्वीकार करहूं, परमपरधान यहोवा ह घोसना करत हे।”<verse eid="EZK 43:27"/></para>
  <chapter eid="EZK 43"/>
  <chapter number="44" style="c" sid="EZK 44"/>
  <para style="s1">पुरोहित पद ला फेर बनाय जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 44:1"/>तब ओ मनखे ह मोला पबितर-स्थान के ओ बाहिरी दुवार मेर वापिस ले आईस, जेकर मुहूं पूरब कोति रिहिस, अऊ ओह बंद रिहिस। <verse eid="EZK 44:1"/><verse number="2" style="v" sid="EZK 44:2"/>तब यहोवा ह मोर ले कहिस, “ये दुवार ह बंद रहय। येला खोले झन जावय; कोनो भी येमा ले होके भीतर झन जावंय। येह बंद रहय काबरकि यहोवा, इसरायल के परमेसर ह येमा ले भीतर गे हवय। <verse eid="EZK 44:2"/><verse number="3" style="v" sid="EZK 44:3"/>हाकिम ह खुद एके झन दुवार के भीतर यहोवा के आघू म जेवन करे बर बईठ सकत हे। ओह दुवार के मंडप के रसता ले भीतर आवय अऊ ओहीच रसता ले होके बाहिर निकलय।”<verse eid="EZK 44:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 44:4"/>तब ओ मनखे ह मोला मंदिर के सामने उत्तरी दुवार के रसता मेर ले आईस। तब मेंह यहोवा के मंदिर ला यहोवा के महिमा ले भरत देखेंव, अऊ मेंह मुहूं के भार गिरेंव।<verse eid="EZK 44:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 44:5"/>यहोवा ह मोर ले कहिस, “हे मनखे के बेटा, धियान से देख, लकठा जाके सुन अऊ यहोवा के मंदिर के बारे, जऊन बिधि अऊ नियममन ला मेंह तोला बतावत हंव, ओ जम्मो बात ऊपर धियान लगा। मंदिर के प्रवेस अऊ पबितर-स्थान के जम्मो निकास दुवारमन म धियान दे। <verse eid="EZK 44:5"/><verse number="6" style="v" sid="EZK 44:6"/>बिदरोही इसरायलीमन ले कह, ‘परमपरधान यहोवा ह ये कहत हे: हे इसरायल के मनखेमन! बहुंत हो गे तुम्हर घिनौना काम। <verse eid="EZK 44:6"/><verse number="7" style="v" sid="EZK 44:7"/>तुम्हर आने जम्मो घिनौना काम के अलावा, तुमन मोर पबितर-स्थान म मन अऊ देहें ले खतनारहित परदेसीमन ला ले आयेव, अऊ मोर मंदिर ला अपबितर करेव जब तुमन मोला जेवन, चरबी अऊ खून चघावत रहेव, अऊ तुमन मोर करार ला टोर देव। <verse eid="EZK 44:7"/><verse number="8" style="v" sid="EZK 44:8"/>मोर पबितर चीजमन के बारे म अपन काम करे के बदले, तुमन आने मन ला मोर पबितर-स्थान के जिम्मेदारी दे देव। <verse eid="EZK 44:8"/><verse number="9" style="v" sid="EZK 44:9"/>परमपरधान यहोवा ह ये कहत हे: मन अऊ देहें ले खतनारहित कोनो भी परदेसी मोर पबितर-स्थान के भीतर झन आवय, अऊ त अऊ इसरायलीमन के बीच रहइया परदेसीमन घलो झन आवंय।<verse eid="EZK 44:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 44:10"/>“ ‘ओ लेवी, जेमन मोर ले ओ समय दूरिहा हो गीन, जब इसरायली मनखेमन आने कोति चल दीन अऊ जेमन मोर ले भटकके अपन मूरतीमन के पाछू चल दीन, जरूरी अय कि ओमन अपन पाप के फर ला भोगंय। <verse eid="EZK 44:10"/><verse number="11" style="v" sid="EZK 44:11"/>ओमन मोर पबितर-स्थान म सेवा कर सकत हें; मंदिर के दुवारमन के जिम्मेदारी लेके येमा सेवा कर सकत हें; ओमन मनखेमन बर होम-बलिदान अऊ चढ़ावा के पसुमन के बध करंय, अऊ मनखेमन के आघू म ठाढ़ होके ओमन के सेवा करंय। <verse eid="EZK 44:11"/><verse number="12" style="v" sid="EZK 44:12"/>पर काबरकि लेवीमन ओमन के मूरतीमन के आघू म ओमन के सेवा करिन अऊ इसरायल के मनखेमन ला पाप म गिराईन, एकरसेति मेंह हांथ उठाके कसम खाय हंव कि ओमन अपन पाप के फर जरूर भोगंय, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 44:12"/><verse number="13" style="v" sid="EZK 44:13"/>ओमन पुरोहित के रूप म मोर सेवा करे बर मोर लकठा म झन आवंय या मोर कोनो पबितर चीज के लकठा म झन आवंय या मोर परम पबितर बलिदानमन करा झन आवंय; जरूरी ए कि ओमन अपन घिनौना काम बर सरमिंदा होवंय। <verse eid="EZK 44:13"/><verse number="14" style="v" sid="EZK 44:14"/>अऊ मेंह ओमन ला मंदिर के पहरेदारी बर ठहिराहू, ताकि येमा के जम्मो काम हो सकय।<verse eid="EZK 44:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 44:15"/>“ ‘पर ओ लेवीय पुरोहित, जेमन सादोक के संतान अंय अऊ जेमन ओ बेरा म मोर पबितर-स्थान के पहरेदारी करिन, जब इसरायलीमन मोर ले दूरिहा हो गे रिहिन, ओमन मोर आघू म सेवा करे बर मोर लकठा म आवंय; ओमन चरबी अऊ लहू चघाय बर मोर आघू म ठाढ़ होवंय, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 44:15"/><verse number="16" style="v" sid="EZK 44:16"/>सिरिप ओमन ही मोर पबितर-स्थान म प्रवेस करंय; सिरिप ओमन ही मोर सेवा करे बर मोर मेज के लकठा म आवंय अऊ पहरेदार के रूप म मोर सेवा करंय।<verse eid="EZK 44:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 44:17"/>“ ‘जब ओमन भीतरी अंगना के दुवारमन ले भीतर आवंय, तब ओमन सन के ओनहा पहिरंय; येह जरूरी अय कि ओमन कोनो भी किसम के ऊन के ओनहा झन पहिरंय, जब ओमन भीतरी अंगना के दुवारमन म या मंदिर के भीतर सेवा करत रहिथें। <verse eid="EZK 44:17"/><verse number="18" style="v" sid="EZK 44:18"/>ओमन अपन मुड़ म सन के ओनहा के पगड़ी पहिरंय अऊ कनिहां म सन के कच्छा पहिरंय। ओमन अइसने कोनो भी चीज झन पहिरंय, जेकर से ओमन ला पसीना आवय। <verse eid="EZK 44:18"/><verse number="19" style="v" sid="EZK 44:19"/>जब ओमन बाहिरी अंगना म मनखेमन करा जावंय, तब ओमन ओ ओनहा ला उतार देवंय, जेला पहिरके ओमन सेवा करत रिहिन अऊ ओमन ओ ओनहा ला पबितर कमरामन म छोंड़ देवंय, अऊ आने कपड़ा पहिर लें, ताकि ओमन के ओनहा ला छुये के दुवारा मनखेमन पबितर झन ठहिरंय।<verse eid="EZK 44:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 44:20"/>“ ‘ओमन अपन मुड़ के चुंदी ला झन मुड़ावंय या ओमन के चुंदी लम्बा झन होवंय, पर ओमन अपन मुड़ के चुंदी ला कटवांय। <verse eid="EZK 44:20"/><verse number="21" style="v" sid="EZK 44:21"/>कोनो भी पुरोहित अंगूर के मंद झन पीयय, जब ओह भीतरी अंगना म जाथे। <verse eid="EZK 44:21"/><verse number="22" style="v" sid="EZK 44:22"/>ओमन कोनो बिधवा या तलाकसुदा माईलोगन ले बिहाव झन करंय; ओमन सिरिप इसरायली बंस के कुंवारी ले या पुरोहित के बिधवा ले बिहाव करंय। <verse eid="EZK 44:22"/><verse number="23" style="v" sid="EZK 44:23"/>ओमन मोर मनखेमन ला पबितर अऊ सधारन के भेद ला सिखोवंय अऊ ओमन ला देखावंय कि सुध अऊ असुध के बीच कइसे भेद करे जाथे।<verse eid="EZK 44:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 44:24"/>“ ‘कोनो झगरा म, पुरोहितमन नियायधीस के रूप म काम करंय अऊ झगरा के फैसला मोर नियममन के मुताबिक करंय। मोर ठहिराय गय जम्मो तिहार म, ओमन मोर कानून अऊ बिधिमन के पालन करंय, अऊ ओमन मोर बिसराम दिन ला पबितर मानंय।<verse eid="EZK 44:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 44:25"/>“ ‘कोनो पुरोहित ह कोनो मनखे के लास के लकठा म जाके अपनआप ला असुध झन करय, पर यदि मरे मनखे ह ओकर दाई या ददा, बेटा या बेटी, भाई या अबिहाता बहिनी होवय, त ओह अपनआप ला असुध कर सकथे। <verse eid="EZK 44:25"/><verse number="26" style="v" sid="EZK 44:26"/>सुध होय के बाद, ओह सात दिन तक इंतजार करय। <verse eid="EZK 44:26"/><verse number="27" style="v" sid="EZK 44:27"/>जऊन दिन ओह पबितर-स्थान के भीतरी अंगना म सेवा करे बर जावय, त ओह अपन बर एक पाप-बलिदान<note caller="+" style="f"><char style="fr" closed="false">44:27 </char><char style="ft" closed="false">सुधिकरन-बलिदान </char><char style="ft" closed="false"><char style="xt" link-href="EZK 44:29"><ref loc="EZK 44:29">पद 29</ref></char>म घलो</char></note> चघावय, परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 44:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 44:28"/>“ ‘पुरोहितमन के सिरिप एकेच उत्तराधिकार हवय अऊ ओह में अंव। तुमन ओमन ला इसरायल म कोनो भी चीज ओमन के अधिकार म झन देवव; ओमन के संपत्ति में अंव। <verse eid="EZK 44:28"/><verse number="29" style="v" sid="EZK 44:29"/>ओमन अन्न-बलिदान, पाप-बलिदान अऊ दोस-बलिदान ला खाहीं; अऊ इसरायल म हर ओ चीज, जऊन ह यहोवा ला चघाय जाथे, ओह ओमन के होही। <verse eid="EZK 44:29"/><verse number="30" style="v" sid="EZK 44:30"/>जम्मो पहिली-फसल के सबले बने चीजमन अऊ तुम्हर जम्मो बिसेस भेंटमन पुरोहितमन के होहीं। तुमन अपन गूंधे पीसान ले बने जेवन के पहिली भाग ओमन ला देवव, ताकि तुम्हर घर-परिवार म आसीस होवय। <verse eid="EZK 44:30"/><verse number="31" style="v" sid="EZK 44:31"/>पुरोहितमन अइसने कोनो चिरई या पसु के मांस ला झन खावंय, जऊन ह मरे पाय गीस या जऊन ह कोनो जंगली पसु के दुवारा फार डाले गे हवय।<verse eid="EZK 44:31"/></para>
  <chapter eid="EZK 44"/>
  <chapter number="45" style="c" sid="EZK 45"/>
  <para style="s1">इसरायल ह पूरा पहिले के स्थिति म आ जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 45:1"/>“ ‘जब तेंह उत्तराधिकार के रूप म भुइयां ला बांटबे, त तेंह भुइयां के एक भाग यहोवा ला पबितर भाग के रूप म देबे, जऊन ह 25,000 क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">45:1 </char><char style="ft" closed="false">लगभग 13 किलोमीटर</char></note> लम्बा अऊ 20,000 क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">45:1 </char><char style="ft" closed="false">लगभग 11 किलोमीटर</char></note> चौड़ा होवय; ये पूरा इलाका ह पबितर होही। <verse eid="EZK 45:1"/><verse number="2" style="v" sid="EZK 45:2"/>इहीच इलाका म 500 क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">45:2 </char><char style="ft" closed="false">लगभग 875 फीट</char></note> के एक वर्गाकार भाग पबितर-स्थान बर होवय, अऊ येकर चारों कोति 50 क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">45:2 </char><char style="ft" closed="false">लगभग 88 फीट</char></note> खुला भुइयां रहय। <verse eid="EZK 45:2"/><verse number="3" style="v" sid="EZK 45:3"/>ये पबितर भाग म 25,000 क्यूबीट लम्बा अऊ 10,000 क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">45:3 </char><char style="ft" closed="false">लगभग 5.3 किलोमीटर</char></note> चौड़ा भाग ला नाप लेबे। येमा पबितर-स्थान याने कि महा पबितर स्थान होही। <verse eid="EZK 45:3"/><verse number="4" style="v" sid="EZK 45:4"/>येह ओ पुरोहितमन बर भुइयां के पबितर भाग होही, जेमन पबितर-स्थान म सेवा करथें अऊ जेमन यहोवा के आघू म सेवा करे बर लकठा म आथें। येह ओ जगह अय, जिहां पुरोहितमन बर घर होही अऊ संग म पबितर-स्थान बर पबितर जगह होही। <verse eid="EZK 45:4"/><verse number="5" style="v" sid="EZK 45:5"/>25,000 क्यूबीट लम्बा अऊ 10,000 क्यूबीट चौड़ा एक भाग ओ लेवीमन के होही, जेमन मंदिर म सेवा करथें, ये भाग म ओमन के अधिकार होही, जेमा ओमन के रहे बर नगरमन होहीं।<note caller="+" style="f"><char style="fr" closed="false">45:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओमन के अधिकार म 20 ठन कमरा होहीं</char></note><verse eid="EZK 45:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 45:6"/>“ ‘तेंह येकर संपत्ति के रूप म पबितर भाग ले लगे 5,000 क्यूबीट चौड़ा<note caller="+" style="f"><char style="fr" closed="false">45:6 </char><char style="ft" closed="false">2.7 किलोमीटर</char></note> अऊ 25,000 क्यूबीट लम्बा एक भाग सहर बर देबे; येह पूरा इसरायल के होही।<verse eid="EZK 45:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 45:7"/>“ ‘हाकिम के भुइयां के सीमना ओ इलाका के दूनों कोति होही, अऊ ये इलाका म पबितर जिला अऊ सहर के संपत्ति होही। येकर बिस्तार पछिम म पछिम कोति अऊ पूरब म पूरब कोति होही, जऊन ह लम्बई म पछिम ले लेके पूरबी सीमना तक जवइया गोत्र के भागमन के एक भाग के समानांतर होही। <verse eid="EZK 45:7"/><verse number="8" style="v" sid="EZK 45:8"/>इसरायल म ये भुइयां ऊपर ओ हाकिम के अधिकार होही। अऊ मोर ठहिराय हाकिममन मोर मनखेमन ला फेर नइं सताहीं पर ओमन इसरायल के मनखेमन ला ओकर गोत्र के मुताबिक भुइयां ला ओमन के अधिकार म दे दीहीं।<verse eid="EZK 45:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 45:9"/>“ ‘परमपरधान यहोवा ह ये कहत हे: हे इसरायल के हाकिममन! तुमन अति कर दे हवव, हिंसा करई अऊ सतावा ला छोंड़ दव अऊ ओ काम करव जऊन ह नियाय के काम ए अऊ सही ए। मोर मनखेमन ला बेदखल करना बंद करव, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 45:9"/><verse number="10" style="v" sid="EZK 45:10"/>तुमन सही नाप के उपयोग करव, सही एपा<note caller="+" style="f"><char style="fr" closed="false">45:10 </char><char style="ft" closed="false">एक ठन सूखा नापे के चीज, जेमा लगभग 22 लीटर पानी आवय</char></note> अऊ सही बत<note caller="+" style="f"><char style="fr" closed="false">45:10 </char><char style="ft" closed="false">एक नापे के चीज, जेमा लगभग 22 लीटर आवय</char></note> के उपयोग करव। <verse eid="EZK 45:10"/><verse number="11" style="v" sid="EZK 45:11"/>एपा अऊ बत दूनों एकेच नाप के होवंय, बत म होमेर के दसवां अंस समावय अऊ एपा म घलो होमेर के दसवां अंस समावय; होमेर ह दूनों के माने गय नाप होवय। <verse eid="EZK 45:11"/><verse number="12" style="v" sid="EZK 45:12"/>सेकेल<note caller="+" style="f"><char style="fr" closed="false">45:12 </char><char style="ft" closed="false">लगभग 12 ग्राम</char></note> म बीस गेरा आवय। बीस सेकेल अऊ पच्चीस सेकेल अऊ पंदरह सेकेल बराबर एक मीना<note caller="+" style="f"><char style="fr" closed="false">45:12 </char><char style="ft" closed="false">याने कि 60 सेकेल; लगभग 690 ग्राम</char></note> होवय।<verse eid="EZK 45:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 45:13"/>“ ‘येह बिसेस भेंट ए, जेला तुमन ला चघाना हे: गहूं के हर होमेर म ले एक एपा के छठवां अंस<note caller="+" style="f"><char style="fr" closed="false">45:13 </char><char style="ft" closed="false">लगभग 2.7 किलोग्राम</char></note> अऊ जौ के हर होमेर म ले एक एपा के छठवां अंस। <verse eid="EZK 45:13"/><verse number="14" style="v" sid="EZK 45:14"/>बत ले नापे, जैतून तेल के ठहिराय अंस, जऊन ह कोर म ले एक बत के दसवां अंस अय (कोर म दस बत या एक होमेर समाथे, काबरकि दस बत बराबर एक होमेर होथे)। <verse eid="EZK 45:14"/><verse number="15" style="v" sid="EZK 45:15"/>इसरायल के बने पानीवाले चरागन ले हर दू सौ भेड़ वाले झुंड ले एक-एक ठन भेड़ लिये जावय। येमन के उपयोग मनखेमन के प्रायस्चित करे बर अन्न-बलिदान, होम-बलिदान अऊ मेल-बलिदान के रूप म करे जावय, परमपरधान यहोवा ह घोसना करत हे। <verse eid="EZK 45:15"/><verse number="16" style="v" sid="EZK 45:16"/>देस के जम्मो मनखेमन ला इसरायल म हाकिम ला ये बिसेस भेंट देना जरूरी अय। <verse eid="EZK 45:16"/><verse number="17" style="v" sid="EZK 45:17"/>येह हाकिम के जिम्मेदारी होही कि ओह तिहारमन म, नवां चंदा के दिनमन म अऊ बिसराम दिन म होम-बलिदान, अन्न-बलिदान अऊ पेय-बलिदान देवय—याने कि इसरायल के ठहिराय जम्मो तिहारमन म। ओह इसरायलीमन के पछताप करे बर पाप-बलिदान,<note caller="+" style="f"><char style="fr" closed="false">45:17 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुधिकरन-बलिदान</char></note> अन्न-बलिदान, होम-बलिदान अऊ मेल-बलिदान दीही।<verse eid="EZK 45:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 45:18"/>“ ‘परमपरधान यहोवा ह ये कहत हे: साल के पहिला महिना के पहिला दिन तें एक निरदोस बछवा ला लेबे अऊ पबितर-स्थान ला सुध करबे। <verse eid="EZK 45:18"/><verse number="19" style="v" sid="EZK 45:19"/>पुरोहित ह पाप-बलिदान के कुछू खून ला लेवय अऊ ओला मंदिर के चौखटमन म, बेदी के ऊपरी निकले भाग के चारों कोना म अऊ भीतरी अंगना के दुवार के चौखटमन म लगावय। <verse eid="EZK 45:19"/><verse number="20" style="v" sid="EZK 45:20"/>तोला महिना के सातवां दिन ओ मनखे बर अइसने ही करना हे, जऊन ह अनजाने म या अगियानता म पाप करथे; ये किसम ले तोला मंदिर बर प्रायस्चित करना हे।<verse eid="EZK 45:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 45:21"/>“ ‘पहिला महिना के चौदहवां दिन तुमन फसह के तिहार मनावव; ये तिहार ह सात दिन के होवय, अऊ ये दौरान तुमन बिगर खमीर के बने रोटी ला खावव। <verse eid="EZK 45:21"/><verse number="22" style="v" sid="EZK 45:22"/>ओ दिन हाकिम ह अपन बर अऊ देस के जम्मो मनखेमन बर एक बछवा पाप-बलिदान के रूप म देवय। <verse eid="EZK 45:22"/><verse number="23" style="v" sid="EZK 45:23"/>तिहार के ओ सात दिन तक हर एक दिन ओह यहोवा ला होम-बलिदान के रूप म सात-सात ठन निरदोस बछवा अऊ सात-सात ठन निरदोस मेढ़ा देवय, अऊ पाप-बलिदान बर हर एक दिन एक-एक ठन बोकरा देवय। <verse eid="EZK 45:23"/><verse number="24" style="v" sid="EZK 45:24"/>ओह हर एक बछवा बर एक एपा अऊ हर एक मेढ़ा बर एक एपा अन्न-बलिदान के रूप म देवय, संग म हर एक एपा बर एक हीन<note caller="+" style="f"><char style="fr" closed="false">45:24 </char><char style="ft" closed="false">लगभग 3.8 लीटर</char></note> जैतून तेल घलो देवय।<verse eid="EZK 45:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 45:25"/>“ ‘तिहार के सात दिन के दौरान, जऊन ह सातवां महिना के पंदरहवां दिन सुरू होथे, ओह हर दिन पाप-बलिदान, होम-बलिदान, अन्न-बलिदान अऊ तेल के अइसने ही परबंध करय।<verse eid="EZK 45:25"/></para>
  <chapter eid="EZK 45"/>
  <chapter number="46" style="c" sid="EZK 46"/>
  <para style="p">
    <verse number="1" style="v" sid="EZK 46:1"/>“ ‘परमपरधान यहोवा ह ये कहत हे: भीतरी अंगना के पूरबमुखी दुवार ह काम-बुता के छै दिन बंद रहय, पर बिसराम दिन अऊ नवां चंदा के दिन येह खुला रहय। <verse eid="EZK 46:1"/><verse number="2" style="v" sid="EZK 46:2"/>हाकिम ह बाहिर ले दुवार के मंडप म ले होके प्रवेस करय अऊ दुवार के चौखट मेर खड़े रहय। पुरोहितमन ओकर होम-बलिदान अऊ मेल-बलिदान ला चघावंय। हाकिम ह दुवार के चौखट मेर भक्ति म मुड़ नवाय अऊ तब बाहिर चले जावय, अऊ दुवार ला संझा होवत तक झन बंद करे जावय। <verse eid="EZK 46:2"/><verse number="3" style="v" sid="EZK 46:3"/>देस के मनखेमन बिसराम दिन अऊ नवां चंदा के दिन ओही दुवार के फाटक मेर यहोवा के आघू म अराधना करंय। <verse eid="EZK 46:3"/><verse number="4" style="v" sid="EZK 46:4"/>हाकिम ह बिसराम दिन म यहोवा बर जऊन होम-बलिदान लाथे, ओमा छै ठन निरदोस मेढ़ा-पीला अऊ एक ठन निरदोस मेढ़ा होवय। <verse eid="EZK 46:4"/><verse number="5" style="v" sid="EZK 46:5"/>मेढ़ा के संग दिये जानेवाला अन्न-बलिदान एक एपा<note caller="+" style="f"><char style="fr" closed="false">46:5 </char><char style="ft" closed="false">लगभग 16 किलोग्राम; <char style="xt" link-href="EZK 46:7"><ref loc="EZK 46:7">पद 7</ref></char> अऊ <char style="xt" link-href="EZK 46:11"><ref loc="EZK 46:11">11</ref></char> म घलो</char></note> होवय, अऊ मेढ़ा-पीलामन के संग दिये जानेवाला अन्न-बलिदान अपन खुसी से जतेक जादा दे सकत हे, देवय; येकर संग हर एपा के पाछू एक हीन<note caller="+" style="f"><char style="fr" closed="false">46:5 </char><char style="ft" closed="false">लगभग 3.8 लीटर; <char style="xt" link-href="EZK 46:7"><ref loc="EZK 46:7">पद 7</ref></char> अऊ <char style="xt" link-href="EZK 46:11"><ref loc="EZK 46:11">11</ref></char> म घलो</char></note> जैतून तेल घलो देवय। <verse eid="EZK 46:5"/><verse number="6" style="v" sid="EZK 46:6"/>नवां चंदा के दिन ओह एक ठन निरदोस बछवा, छै ठन निरदोस मेढ़ा-पीला अऊ एक ठन निरदोस मेढ़ा चघावय, ये जम्मो निरदोस होवंय। <verse eid="EZK 46:6"/><verse number="7" style="v" sid="EZK 46:7"/>ओह अन्न-बलिदान के रूप म बछवा के संग एक एपा,<note caller="+" style="f"><char style="fr" closed="false">46:7 </char><char style="ft" closed="false">लगभग 9 किलोग्राम</char></note> मेढ़ा के संग एक एपा अऊ मेढ़ा-पीलामन के संग जतेक जादा ओह चाहथे, देवय, येकर संग हर एपा के पाछू एक हीन<note caller="+" style="f"><char style="fr" closed="false">46:7 </char><char style="ft" closed="false">लगभग 3 लीटर</char></note> तेल घलो देवय। <verse eid="EZK 46:7"/><verse number="8" style="v" sid="EZK 46:8"/>जब हाकिम ह भीतर जावय, त ओह दुवार के मंडप ले होके जावय, अऊ ओह ओही रद्दा ले बाहिर आवय।<verse eid="EZK 46:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 46:9"/>“ ‘जब देस के मनखेमन ठहिराय गय तिहार म यहोवा के आघू म आवंय, त जऊन ह अराधना करे बर उत्तरी दुवार ले होके आवय, ओह दक्खिनी दुवार ले होके बाहिर निकलय; अऊ जऊन ह दक्खिनी दुवार ले होके भीतर आवय, ओह उत्तरी दुवार ले होके बाहिर निकलय। कोनो भी ओहीच दुवार ले बाहिर झन निकलय, जेमा ले होके ओह भीतर आय रिहिस, पर हर एक ह बिरूध दिग के दुवार ले बाहिर निकलय। <verse eid="EZK 46:9"/><verse number="10" style="v" sid="EZK 46:10"/>जब ओमन भीतर जावंय, तब हाकिम ह ओमन के बीच म रहिके जावय, अऊ जब ओमन बाहिर निकलंय, तब ओह घलो ओमन के संग बाहिर निकलय। <verse eid="EZK 46:10"/><verse number="11" style="v" sid="EZK 46:11"/>जेवनार अऊ ठहिराय गय तिहारमन म, अन्न-बलिदान एक बछवा के पाछू एक एपा, एक मेढ़ा के पाछू एक एपा, अऊ मेढ़ा-पीलामन के संग अपन खुसी से जतेक जादा ओह दे सकथे, देवय; येकर संग हर एपा के पाछू हीन भर तेल घलो देवय।<verse eid="EZK 46:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 46:12"/>“ ‘जब हाकिम ह यहोवा ला स्वेच्छा-बलिदान देवय—चाहे येह एक होम-बलिदान या मेल-बलिदान हो, तब पूरबमुखी दुवार ला ओकर बर खोल दिये जावय। ओह अपन होम-बलिदान या मेल-बलिदान ला वइसनेच ही चघावय, जइसने ओह बिसराम दिन म चघाथे। तब ओह बाहिर चले जावय, अऊ ओकर जाय के बाद, दुवार ला बंद कर दिये जावय।<verse eid="EZK 46:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 46:13"/>“ ‘हर दिन तें यहोवा ला एक साल के एक निरदोस मेढ़ा-पीला होम-बलिदान बर देबे; हर बिहनियां तें येला देय करबे। <verse eid="EZK 46:13"/><verse number="14" style="v" sid="EZK 46:14"/>येकर संग तोला हर बिहनियां एक अन्न-बलिदान घलो देना हे, जेमा एक एपा के छठवां अंस<note caller="+" style="f"><char style="fr" closed="false">46:14 </char><char style="ft" closed="false">लगभग 2.7 किलोग्राम</char></note> अऊ पीसान म मिलाय बर एक हीन तेल के तिहाई भाग<note caller="+" style="f"><char style="fr" closed="false">46:14 </char><char style="ft" closed="false">लगभग 1.3 लीटर</char></note> होवय। यहोवा ला ये अन्न-बलिदान देवई ह एक हमेसा के आदेस ए। <verse eid="EZK 46:14"/><verse number="15" style="v" sid="EZK 46:15"/>एकरसेति नियमित होम-बलिदान बर हर बिहनियां मेढ़ा-पीला, अन्न-बलिदान अऊ तेल दिये जावय।<verse eid="EZK 46:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 46:16"/>“ ‘परमपरधान यहोवा ह ये कहत हे: यदि हाकिम ह अपन उत्तराधिकार म पाय संपत्ति म ले अपन कोनो बेटा ला कुछू ईनाम देथे, त ओह ओकर संतानमन के घलो होही; येह उत्तराधिकार म मिले ओमन के संपत्ति होवय। <verse eid="EZK 46:16"/><verse number="17" style="v" sid="EZK 46:17"/>पर यदि, ओह अपन उत्तराधिकार के संपत्ति म ले कुछू ईनाम अपन कोनो सेवक ला देथे, त सेवक ह ओ ईनाम ला अपन सुतंतर होय के बछर तक रखय, ओकर बाद ओ ईनाम हाकिम ला लहुंटा देय जावय। हाकिम के उत्तराधिकार के संपत्ति सिरिप ओकर बेटामन ला मिलय; येह ओमन के अय। <verse eid="EZK 46:17"/><verse number="18" style="v" sid="EZK 46:18"/>हाकिम ह मनखेमन के उत्तराधिकार के कोनो संपत्ति ला झन लेवय, ओह ओमन ला ओमन के संपत्ति ले बेदखल झन करय। ओह अपन बेटामन ला अपन ही संपत्ति ले उत्तराधिकार देवय, ताकि मोर मनखेमन ले कोनो ला भी ओकर संपत्ति ले अलग झन करे जावय।’ ”<verse eid="EZK 46:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 46:19"/>तब ओ मनखे मोला दुवार के बाजू म ले पुरोहितमन के पबितर कमरामन म ले आईस, जेमन उत्तर कोति खुलंय, अऊ ओह मोला पछिम छोर म एक जगह देखाईस। <verse eid="EZK 46:19"/><verse number="20" style="v" sid="EZK 46:20"/>तब ओह मोर ले कहिस, “येह ओ जगह अय, जिहां पुरोहितमन दोस-बलिदान अऊ पाप-बलिदान के मांस ला रांधंय अऊ अन्न-बलिदान ला पकावंय, जेकर कारन येमन ला बाहिरी अंगना म लाय के जरूरत नइं होवय अऊ मनखेमन ला पबितर करे के जरूरत घलो नइं होवय।”<verse eid="EZK 46:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 46:21"/>तब ओह मोला बाहिरी अंगना म ले जाके येकर चारों कोति चारों कोनटा म ले गीस, अऊ मेंह हर एक कोनटा म एक-एक ठन अऊ अंगना देखेंव। <verse eid="EZK 46:21"/><verse number="22" style="v" sid="EZK 46:22"/>बाहिरी अंगना के चारों कोनटा म, चालीस क्यूबीट लम्बा अऊ तीस क्यूबीट चौड़ा<note caller="+" style="f"><char style="fr" closed="false">46:22 </char><char style="ft" closed="false">लगभग 21 मीटर लम्बा अऊ 16 मीटर चौड़ा</char></note> घिरे हुए अंगनामन रिहिन; चारों कोनटा म हर एक अंगना एकेच नाप के रिहिन। <verse eid="EZK 46:22"/><verse number="23" style="v" sid="EZK 46:23"/>चारों अंगना के हर एक के भीतर चारों कोति पथरा के एक निकले भाग रिहिस, ओ निकले भाग के खाल्हे चारों कोति आगी बारे के जगह बनाय गे रिहिस। <verse eid="EZK 46:23"/><verse number="24" style="v" sid="EZK 46:24"/>ओ मनखे ह मोला कहिस, “येमन रंधनी खोली अंय, जिहां मंदिर म सेवा करइया लेवीमन, मनखेमन के चघाय बलिदानमन ला रांधंय।”<verse eid="EZK 46:24"/></para>
  <chapter eid="EZK 46"/>
  <chapter number="47" style="c" sid="EZK 47"/>
  <para style="s1">मंदिर ले बोहावत नदी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 47:1"/>फेर ओ मनखे ह मोला मंदिर के प्रवेस दुवार मेर वापिस ले आईस, अऊ मेंह देखेंव कि मंदिर के चौखट के खाल्हे ले पानी बाहिर निकलके पूरब कोति बोहावत हे (काबरकि मंदिर के मुहूं ह पूरब कोति रिहिस)। मंदिर के दक्खिन भाग के खाल्हे ले, बेदी के दक्खिन ले पानी ह खाल्हे निकलत रिहिस। <verse eid="EZK 47:1"/><verse number="2" style="v" sid="EZK 47:2"/>तब ओह मोला उत्तरी दुवार ले बाहिर ले आईस अऊ मोला बाहिर कोति घुमाके बाहिरी दुवार मेर ले आईस, जेकर मुहूं पूरब कोति रिहिस, अऊ दक्खिन कोति ले पानी ह चूहत रिहिस।<verse eid="EZK 47:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 47:3"/>तब ओ मनखे ह अपन हांथ म नापे के डोरी ला धरके पूरब कोति गीस, अऊ ओह एक हजार क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">47:3 </char><char style="ft" closed="false">लगभग 1,700 फीट</char></note> नापिस, तब ओह मोला पानी म ले रेंगाके ले गीस, अऊ पानी एड़ी तक रिहिस। <verse eid="EZK 47:3"/><verse number="4" style="v" sid="EZK 47:4"/>ओह फेर एक हजार क्यूबीट नापिस अऊ मोला पानी म ले होके ले गीस, जऊन ह माड़ीमन तक गहिरा रिहिस। ओह फेर एक हजार क्यूबीट नापिस अऊ मोला पानी म ले रेंगाके ले गीस, जऊन ह कनिहां तक गहिरा रिहिस। <verse eid="EZK 47:4"/><verse number="5" style="v" sid="EZK 47:5"/>ओह फेर एक हजार क्यूबीट नापिस, पर अब ओह एक नदी हो गीस, अऊ में ओ पार नइं जा सकेंव, काबरकि पानी ह बाढ़ गे रिहिस अऊ अतेक गहिरा रिहिस कि तउंरे जा सकत रिहिस—एक अइसने नदी, जेला कोनो पार नइं कर सकत रिहिन। <verse eid="EZK 47:5"/><verse number="6" style="v" sid="EZK 47:6"/>ओह मोर ले पुछिस, “हे मनखे के बेटा, का तेंह येला देखत हस?”</para>
  <para style="p" vid="EZK 47:6">तब ओह मोला वापिस नदी के तीर म ले आईस। <verse eid="EZK 47:6"/><verse number="7" style="v" sid="EZK 47:7"/>जब में उहां हबरेंव, तब मेंह नदी के दूनों कोति अब्बड़ अकन रूखमन ला देखेंव। <verse eid="EZK 47:7"/><verse number="8" style="v" sid="EZK 47:8"/>तब ओह मोर ले कहिस, “ये पानी ह पूरबी इलाका कोति बोहात हे अऊ खाल्हे अराबा<note caller="+" style="f"><char style="fr" closed="false">47:8 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरदन घाटी</char></note> म जावत हे, जिहां येह मिरतू सागर म मिल जाथे। जब येह सागर म मिल जाथे, त उहां नूनचूर पानी ह मीठा हो जाथे। <verse eid="EZK 47:8"/><verse number="9" style="v" sid="EZK 47:9"/>जिहां-जिहां नदी ह बोहाथे, उहां-उहां जीवमन के झुंडमन रहिहीं। उहां अब्बड़ अकन मछरीमन होहीं, काबरकि ये पानी ह उहां बोहाथे अऊ नूनचूर पानी ला मीठा बनाथे; एकरसेति जिहां-जिहां नदी ह बोहाथे, उहां हर चीज जीयत रहिहीं। <verse eid="EZK 47:9"/><verse number="10" style="v" sid="EZK 47:10"/>नदी के तीर म मछुआरमन ठाढ़ होहीं; एन-गदी ले लेके एन-एगलेम तक उहां जाल डारे के जगह होही। उहां कतको किसम के मछरी होहीं—भूमध्य सागर के मछरीमन सहीं। <verse eid="EZK 47:10"/><verse number="11" style="v" sid="EZK 47:11"/>पर चीखला भरे खंचवा अऊ पानी के खंचवामन मीठा नइं होहीं, ओमन ला नून बर छोंड़ दिये जाही। <verse eid="EZK 47:11"/><verse number="12" style="v" sid="EZK 47:12"/>जम्मो किसम के फर के रूखमन नदी के दूनों तीर म जामहीं। ओमन के पानमन नइं मुरझाहीं, अऊ न ही ओमन म फर धरई कभू बंद होही। हर महिना ओमन म फर लगही, काबरकि पबितर-स्थान ले पानी बहके ओमन म आथे। ओमन के फर खाय के काम आहीं अऊ ओमन के पान दवाई के काम म आहीं।”<verse eid="EZK 47:12"/></para>
  <para style="s1">देस के सीमनामन</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 47:13"/>परमपरधान यहोवा ह ये कहत हे: “देस के ये सीमनामन अंय, जेला तें इसरायल के बारह गोत्रमन के बीच ओमन के उत्तराधिकार के रूप म बांटबे, अऊ येमा यूसुफ ला दू भाग मिलय। <verse eid="EZK 47:13"/><verse number="14" style="v" sid="EZK 47:14"/>तें येला ओमन के बीच बरोबर-बरोबर बांटबे। काबरकि मेंह हांथ उठाके कसम खाय रहेंव कि मेंह येला तुम्हर पुरखामन ला दूहूं। ये देस तुम्हर उत्तराधिकार म हो जाही।<verse eid="EZK 47:14"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="15" style="v" sid="EZK 47:15"/>“देस के सीमना ये होवय:</para>
  <para style="b" vid="EZK 47:15"/>
  <para style="li1" vid="EZK 47:15">“उत्तर कोति के सीमना भूमध्य सागर ले हेतलोन सड़क के बाद लेबो-हमात ले होवत सेदाद सहर तक, <verse eid="EZK 47:15"/><verse number="16" style="v" sid="EZK 47:16"/>बेरोता अऊ सिबरैम (जऊन ह दमिस्क अऊ हमात के बीच सीमना म पड़थे), अऊ हसर-हत्तीकोन सहर तक, जऊन ह हौरान जिला के सीमना म हवय। <verse eid="EZK 47:16"/><verse number="17" style="v" sid="EZK 47:17"/>ये सीमना ह समुंदर ले लेके दमिस्क के उत्तरी सीमना के संगे-संग हसर-एनान सहर तक फईलही, अऊ संग म उत्तर कोति हमात के सीमना होही। येह उत्तरी सीमना होही।<verse eid="EZK 47:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="EZK 47:18"/>पूरब कोति के सीमना हौरान अऊ दमिस्क के बीच होवत, यरदन नदी के संग गिलाद अऊ इसरायल देस के बीच, मिरतू सागर तक होही अऊ तामार नगर तक फईलही। येह पूरबी सीमना होही।<verse eid="EZK 47:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="EZK 47:19"/>दक्खिन कोति के सीमना तामार ले लेके मरीबा-कादेस के पानी के सोता तक होही, तब मिसर के नरवा ले होवत भूमध्य सागर तक। येह दक्खिन के सीमना होही।<verse eid="EZK 47:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZK 47:20"/>पछिम कोति के सीमना भूमध्य सागर म लेबो-हमात के सामने के एक जगह तक होही। येह पछिम के सीमना होही।<verse eid="EZK 47:20"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="21" style="v" sid="EZK 47:21"/>“तोला ये देस ला अपन बीच म इसरायल के गोत्रमन के मुताबिक बांटना हे। <verse eid="EZK 47:21"/><verse number="22" style="v" sid="EZK 47:22"/>तोला ये देस ला एक उत्तराधिकार के रूप म अपन बर अऊ तुम्हर बीच रहइया परदेसी, जेमन के लइकामन हवंय, ओमन बर बांटना हे। ओमन ला तें देस म जनमे इसरायलीमन सहीं ही समझबे; अपन संग, ओमन ला घलो इसरायल के गोत्रमन के बीच एक उत्तराधिकार दिये जावय। <verse eid="EZK 47:22"/><verse number="23" style="v" sid="EZK 47:23"/>जऊन भी गोत्र म कोनो परदेसी रहिथे, उहां तें ओला ओकर भाग ला देबे,” परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 47:23"/></para>
  <chapter eid="EZK 47"/>
  <chapter number="48" style="c" sid="EZK 48"/>
  <para style="s1">भुइयां के बंटवारा</para>
  <para style="lh">
    <verse number="1" style="v" sid="EZK 48:1"/>“सूची म लिखे गय गोत्र के नांव ये अंय:</para>
  <para style="b" vid="EZK 48:1"/>
  <para style="li1" vid="EZK 48:1">“उत्तरी सीमना म, दान के एक भाग होही; येह हेतलोन सहर के रद्दा के पाछू लेबो-हमात तक जाही; हसर-एनान सहर अऊ हमात ले लगे दमिस्क के उत्तरी सीमना येकर सीमना के भाग होही, जऊन ह पूरब कोति ले पछिम तक होही।<verse eid="EZK 48:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="EZK 48:2"/>आसेर के एक भाग होही; येकर सीमना पूरब ले पछिम तक दान के सीमना ले लगे होही।<verse eid="EZK 48:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="EZK 48:3"/>आसेर के सीमना ले लगके, पूरब ले पछिम तक नपताली के एक भाग होही।<verse eid="EZK 48:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZK 48:4"/>नपताली के सीमना ले लगके, पूरब ले पछिम तक मनस्से के एक भाग होही।<verse eid="EZK 48:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZK 48:5"/>मनस्से के सीमना ले लगके, पूरब ले पछिम तक एपरैम के एक भाग होही।<verse eid="EZK 48:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZK 48:6"/>एपरैम के सीमना ले लगके, पूरब ले पछिम तक रूबेन के एक भाग होही।<verse eid="EZK 48:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZK 48:7"/>रूबेन के सीमना ले लगके, पूरब ले पछिम तक यहूदा के एक भाग होही।<verse eid="EZK 48:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="EZK 48:8"/>“यहूदा के सीमना ले लगके, पूरब ले पछिम तक एक भाग होही, जेला तें एक बिसेस भेंट के रूप म अरपन करबे। येकर चौड़ई 25,000 क्यूबीट,<note caller="+" style="f"><char style="fr" closed="false">48:8 </char><char style="ft" closed="false">लगभग 13 किलोमीटर</char></note> अऊ पूरब ले लेके पछिम तक येकर लम्बई कोनो एक गोत्र ला दिये गय भाग के बरोबर होही; ये भाग के बीच म पबितर-स्थान होही।<verse eid="EZK 48:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 48:9"/>“जऊन बिसेस भाग, तेंह यहोवा ला अरपन करबे, ओकर लम्बई 25,000 क्यूबीट अऊ चौड़ई 10,000 क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">48:9 </char><char style="ft" closed="false">लगभग 5.3 किलोमीटर</char></note> होही। <verse eid="EZK 48:9"/><verse number="10" style="v" sid="EZK 48:10"/>येह पुरोहितमन बर पबितर भाग होही। उत्तर कोति येकर लम्बई 25,000 क्यूबीट, पछिम कोति येकर चौड़ई 10,000 क्यूबीट, पूरब कोति येकर चौड़ई 10,000 क्यूबीट अऊ दक्खिन कोति येकर लम्बई 25,000 क्यूबीट होही। येकर मांझा म यहोवा के पबितर-स्थान होही। <verse eid="EZK 48:10"/><verse number="11" style="v" sid="EZK 48:11"/>ये भाग ह सादोक के बंस के ओ पबितर करे गय पुरोहितमन बर होही, जेमन मोर सेवा करे म बिसवासयोग्य रिहिन अऊ ओ लेवीमन सहीं नइं भटकिन, जेमन इसरायलीमन के भटके के बेरा, भटक गे रिहिन। <verse eid="EZK 48:11"/><verse number="12" style="v" sid="EZK 48:12"/>देस के पबितर भाग ले येह ओमन बर एक बिसेस भेंट होही, एक महा पबितर भाग, जऊन ह लेवीमन के सीमना ले लगे होही।<verse eid="EZK 48:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 48:13"/>“पुरोहितमन के इलाका ले लगे एक भाग लेवीमन बर होही, जऊन ह 25,000 क्यूबीट लम्बा अऊ 10,000 क्यूबीट चौड़ा होही। येकर पूरा लम्बई 25,000 क्यूबीट अऊ चौड़ई 10,000 क्यूबीट होही। <verse eid="EZK 48:13"/><verse number="14" style="v" sid="EZK 48:14"/>ओमन येला न तो बेचंय अऊ न ही येकर कोनो भाग ला अदला-बदली करंय। येह देस के सबले बने भाग ए अऊ कोनो भी हालत म येला आने मन के हांथ म झन देय जावय, काबरकि येह यहोवा बर पबितर अय।<verse eid="EZK 48:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 48:15"/>“बचे 5,000 क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">48:15 </char><char style="ft" closed="false">लगभग 2.7 किलोमीटर</char></note> चौड़ा अऊ 25,000 क्यूबीट लम्बा भाग ह सहर के सधारन उपयोग बर, घर अऊ चरागन बर होही। सहर ह येकर मांझा म होही <verse eid="EZK 48:15"/><verse number="16" style="v" sid="EZK 48:16"/>अऊ येकर नाप अइसने होही: उत्तर कोति 4,500 क्यूबीट,<note caller="+" style="f"><char style="fr" closed="false">48:16 </char><char style="ft" closed="false">लगभग 2.4 किलोमीटर; <char style="xt" link-href="EZK 48:30"><ref loc="EZK 48:30">पद 30</ref></char>, <char style="xt" link-href="EZK 48:32"><ref loc="EZK 48:32">32</ref></char>, <char style="xt" link-href="EZK 48:33"><ref loc="EZK 48:33">33</ref></char> अऊ <char style="xt" link-href="EZK 48:34"><ref loc="EZK 48:34">34</ref></char> म घलो</char></note> दक्खिन कोति 4,500 क्यूबीट, पूरब कोति 4,500 क्यूबीट अऊ पछिम कोति 4,500 क्यूबीट। <verse eid="EZK 48:16"/><verse number="17" style="v" sid="EZK 48:17"/>सहर के चरागन बर भुइयां ह उत्तर कोति 250 क्यूबीट,<note caller="+" style="f"><char style="fr" closed="false">48:17 </char><char style="ft" closed="false">लगभग 440 फीट</char></note> दक्खिन कोति 250 क्यूबीट, पूरब कोति 250 क्यूबीट, अऊ पछिम कोति 250 क्यूबीट होही। <verse eid="EZK 48:17"/><verse number="18" style="v" sid="EZK 48:18"/>पबितर भाग के सीमना ले लगे जऊन बचे भाग होही अऊ पबितर भाग के लम्बई म होही, ओह पूरब कोति 10,000 क्यूबीट अऊ पछिम कोति 10,000 क्यूबीट होही। येकर ऊपज ले सहर के काम करइयामन ला जेवन मिलही। <verse eid="EZK 48:18"/><verse number="19" style="v" sid="EZK 48:19"/>सहर के जऊन काम करइयामन येमा खेती-बारी करहीं, ओमन इसरायल के जम्मो गोत्रमन ले आहीं। <verse eid="EZK 48:19"/><verse number="20" style="v" sid="EZK 48:20"/>ये पूरा भाग ह वर्गाकार होही, हर एक कोति 25,000 क्यूबीट। एक बिसेस भेंट के रूप म, तें पबितर भाग ला, सहर के संपत्ति के संग अलग रखबे।<verse eid="EZK 48:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 48:21"/>“पबितर भाग ले बने इलाका के दूनों कोति जऊन भाग बच जाथे, ओह अऊ सहर के संपत्ति हाकिम के होही। येह पबितर भाग ले 25,000 क्यूबीट पूरब के सीमना कोति अऊ 25,000 क्यूबीट पछिम के सीमना कोति फईले होही। ये दूनों भाग हाकिम के होहीं, जेमन गोत्र के भागमन के लम्बई म होहीं, अऊ येमन के मांझा म पबितर भाग के संग मंदिर के पबितर-स्थान होही। <verse eid="EZK 48:21"/><verse number="22" style="v" sid="EZK 48:22"/>ये किसम ले लेवीमन के संपत्ति अऊ सहर के संपत्ति ओ इलाका म होही, जऊन ह हाकिम के होही। हाकिम के भाग यहूदा के सीमना अऊ बिनयामीन के सीमना के बीच म होही।<verse eid="EZK 48:22"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="23" style="v" sid="EZK 48:23"/>“बाकि गोत्रमन के भाग ह ये किसम ले होही:</para>
  <para style="b" vid="EZK 48:23"/>
  <para style="li1" vid="EZK 48:23">“पूरब कोति ले लेके पछिम तक फईले एक भाग बिनयामीन के होही।<verse eid="EZK 48:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZK 48:24"/>बिनयामीन के इलाका के सीमना ले लगके पूरब ले पछिम कोति एक भाग सिमोन के होही।<verse eid="EZK 48:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="EZK 48:25"/>सिमोन के भाग के सीमना ले लगके पूरब ले पछिम कोति एक भाग इस्साकार के होही।<verse eid="EZK 48:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZK 48:26"/>इस्साकार के भाग के सीमना ले लगके पूरब ले पछिम कोति एक भाग जबूलून के होही।<verse eid="EZK 48:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZK 48:27"/>जबूलून के भाग के सीमना ले लगके पूरब ले पछिम कोति एक भाग गाद के होही।<verse eid="EZK 48:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZK 48:28"/>गाद के दक्खिनी सीमना दक्खिन कोति तामार ले लेके मरीबा-कादेस के पानी के सोता तक जाही, तब मिसर के नरवा ले होवत भूमध्य सागर तक होही।<verse eid="EZK 48:28"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="29" style="v" sid="EZK 48:29"/>“येह ओ देस ए, जेला तें इसरायल के गोत्रमन ला एक उत्तराधिकार के रूप म बांट देबे, अऊ येमन ओमन के भाग होहीं,” परमपरधान यहोवा ह घोसना करत हे।<verse eid="EZK 48:29"/></para>
  <para style="s1">नवां सहर के दुवारमन</para>
  <para style="lh">
    <verse number="30" style="v" sid="EZK 48:30"/>“येमन सहर ले बाहिर निकले के दुवारमन होहीं:</para>
  <para style="b" vid="EZK 48:30"/>
  <para style="li1" vid="EZK 48:30">“उत्तर कोति ले सुरू होके, जेकर लम्बई 4,500 क्यूबीट हवय, <verse eid="EZK 48:30"/><verse number="31" style="v" sid="EZK 48:31"/>सहर के दुवारमन ला इसरायल के गोत्रमन के नांव दिये जाही। उत्तर कोति तीन ठन दुवारमन के नांव रूबेन के दुवार, यहूदा के दुवार अऊ लेवी के दुवार होही।<verse eid="EZK 48:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="EZK 48:32"/>पूरब कोति, जेकर लम्बई 4,500 क्यूबीट हवय, तीन ठन दुवार होहीं: यूसुफ के दुवार, बिनयामीन के दुवार अऊ दान के दुवार।<verse eid="EZK 48:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZK 48:33"/>दक्खिन कोति, जेकर नाप 4,500 क्यूबीट हवय, तीन ठन दुवार होहीं: सिमोन के दुवार, इस्साकार के दुवार अऊ जबूलून के दुवार।<verse eid="EZK 48:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZK 48:34"/>पछिम कोति, जेकर लम्बई 4,500 क्यूबीट हवय, तीन ठन दुवार होहीं: गाद के दुवार, आसेर के दुवार अऊ नपताली के दुवार।<verse eid="EZK 48:34"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="35" style="v" sid="EZK 48:35"/>“चारों कोति के दूरी 18,000 क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">48:35 </char><char style="ft" closed="false">लगभग 9.5 किलोमीटर</char></note> होही।</para>
  <para style="b" vid="EZK 48:35"/>
  <para style="p" vid="EZK 48:35">“अऊ ओ समय ले सहर के नांव होही, ‘यहोवा<note caller="+" style="f"><char style="fr" closed="false">48:35 </char><char style="ft" closed="false">याने कि </char><char style="fqa" closed="false">यहोवा सम्मा</char></note> उहां हवय।’ ”<verse eid="EZK 48:35"/></para>
  <chapter eid="EZK 48"/>
</usx>
