<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CH" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">2 इतिहास</para>
  <para style="toc1">इतिहास के दूसरा किताब</para>
  <para style="toc2">2 इतिहास</para>
  <para style="toc3">2 इति</para>
  <para style="mt1">इतिहास</para>
  <para style="mt2">के दूसरा किताब</para>
  <chapter number="1" style="c" sid="2CH 1" />
  <para style="s1">बुद्धि बर सुलेमान के पराथना</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 1:1" />दाऊद के बेटा राजा सुलेमान ह अपन राज म अपनआप ला मजबूती के साथ स्थापित कर लीस, काबरकि यहोवा ओकर परमेसर ह ओकर संग रिहिस अऊ ओला अति महान करिस।<verse eid="2CH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 1:2" />तब सुलेमान ह जम्मो इसरायल ले—हजार-हजार के ऊपर सेनापति अऊ सौ-सौ के ऊपर सेनापति, नियायी अऊ इसरायल के जम्मो अगुवा अऊ परिवारमन के मुखियामन ले गोठियाईस— <verse eid="2CH 1:2" /><verse number="3" style="v" sid="2CH 1:3" />अऊ सुलेमान अऊ ओकर सभा के जम्मो झन उठके गिबोन सहर के ऊंच जगह म गीन, काबरकि परमेसर के मिलापवाला तम्बू उहां रिहिस, जेला यहोवा के सेवक मूसा ह सुन्ना जगह म बनाय रिहिस। <verse eid="2CH 1:3" /><verse number="4" style="v" sid="2CH 1:4" />पर दाऊद ह परमेसर के सन्दूक ला किरयत-यारीम नगर ले ओ जगह म ले आय रिहिस, जऊन ला ओह येकर बर तियार करे रिहिस, काबरकि येकर बर दाऊद ह यरूसलेम म एक तम्बू खड़े करे रिहिस। <verse eid="2CH 1:4" /><verse number="5" style="v" sid="2CH 1:5" />पर ओ कांसा के बेदी, जऊन ला ऊरी के बेटा, हूर के पोता, बसलेल ह बनाय रिहिस, ओह गिबोन म यहोवा के पबितर-तम्बू के आघूच म माढ़े रिहिस; एकरसेति सुलेमान अऊ सभा के मनखेमन उहां परमेसर ले पुछताछ करिन। <verse eid="2CH 1:5" /><verse number="6" style="v" sid="2CH 1:6" />सुलेमान ह मिलापवाला तम्बू म कांसा के बेदी करा यहोवा के आघू म गीस अऊ ओकर ऊपर एक हजार होम-बलिदान चघाईस।<verse eid="2CH 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 1:7" />ओहीच रथिया परमेसर ह सुलेमान ला दरसन देके कहिस, “जऊन भी चीज तेंह चाहत हस, मांग अऊ मेंह तोला दूहूं।”<verse eid="2CH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 1:8" />सुलेमान ह परमेसर ला जबाब दीस, “तेंह मोर ददा दाऊद ऊपर बहुंत दया करे हवस अऊ मोला ओकर जगह म राजा बनाय हस। <verse eid="2CH 1:8" /><verse number="9" style="v" sid="2CH 1:9" />अब, हे यहोवा परमेसर, मोर ददा दाऊद ले करे गे वायदा ह पूरा होवय, काबरकि तेंह मोला अइसन मनखेमन ऊपर राजा बनाय हस, जऊन मन गनती म धरती के धुर्रा सहीं अनगिनत हवंय। <verse eid="2CH 1:9" /><verse number="10" style="v" sid="2CH 1:10" />मोला बुद्धि अऊ गियान दे कि मेंह ये मनखेमन के अगुवई कर सकंव, काबरकि कोन ह एकर लईक हवय कि तोर ये अब्बड़ मनखेमन ऊपर राज कर सकय?”<verse eid="2CH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 1:11" />परमेसर ह सुलेमान ला कहिस, “जब येह तोर हिरदय के ईछा ए अऊ तेंह मोर ले न तो धन-संपत्ति, न वैभव, न आदरमान, न ही अपन बईरीमन के मऊत अऊ न ही अपन बर लम्बा जिनगी के मांग करय, पर तेंह अपन बर बुद्धि अऊ गियान के मांग करय ताकि तें मोर मनखेमन ऊपर सासन कर सकस, जेमन के ऊपर मेंह तोला राजा बनाय हवंव, <verse eid="2CH 1:11" /><verse number="12" style="v" sid="2CH 1:12" />एकरसेति बुद्धि अऊ गियान त तोला देय जाही, संग म मेंह तोला अतेक धन, वैभव अऊ आदरमान दूहूं, जतेक कि तोर ले पहिली कोनो राजा ला न तो मिलिस अऊ न ही तोर बाद कोनो राजा ला मिलही।”<verse eid="2CH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 1:13" />तब सुलेमान ह गिबोन के ऊंचहा जगह, मिलापवाला तम्बू करा ले यरूसलेम लहुंट गीस। अऊ ओह इसरायल ऊपर राज करे लगिस।<verse eid="2CH 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 1:14" />सुलेमान ह रथ अऊ घोड़ामन ला संकेले रिहिस; ओकर मेर चौदह सौ रथ अऊ बारह हजार घोड़ामन<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सारथीमन</char></note> रिहिन; जऊन ला ओह रथ के नगरमन म अऊ अपन संग यरूसलेम म घलो रखय। <verse eid="2CH 1:14" /><verse number="15" style="v" sid="2CH 1:15" />राजा ह यरूसलेम म चांदी अऊ सोन ला पथरा के असन सधारन, अऊ देवदार लकड़ी ला खाल्हे पहाड़ी के डूमर रूख असन बहुंत अकन कर दीस। <verse eid="2CH 1:15" /><verse number="16" style="v" sid="2CH 1:16" />सुलेमान के घोड़ामन ला मिसर अऊ कू<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">संभवतः किलिकिया</char></note> ले मंगाय जावत रिहिस—राजा के बेपारीमन ओमन ला ओ समय ठहिराय दाम म कू ले बिसावंय। <verse eid="2CH 1:16" /><verse number="17" style="v" sid="2CH 1:17" />ओमन मिसर देस ले एक रथ ला चांदी के छै सौ सेकेल<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">लगभग 6.9 किलोग्राम</char></note> म, अऊ एक ठन घोड़ा ला चांदी के डेड़ सौ सेकेल<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">लगभग 1.7 किलोग्राम</char></note> म मंगावत रिहिन। राजा के बेपारीमन ओमन ला हित्ती अऊ अरामीमन के जम्मो राजामन ला घलो पठोवत रिहिन।<verse eid="2CH 1:17" /></para>
  <chapter eid="2CH 1" />
  <chapter number="2" style="c" sid="2CH 2" />
  <para style="s1">मंदिर बनाय के तियारी</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 2:1" />सुलेमान ह यहोवा के नांव बर एक मंदिर अऊ अपन बर एक राजमहल बनाय के हुकूम दीस। <verse eid="2CH 2:1" /><verse number="2" style="v" sid="2CH 2:2" />ओह 70,000 मनखेमन ला बोझा ढोये बर अऊ 80,000 मनखे ला पहाड़ी ले पथरा काटे बर अऊ 3,600 मनखे ला येमन ऊपर देखरेख करे बर ठहिराईस।<verse eid="2CH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 2:3" />सुलेमान ह सूर के राजा हीराम ला ये संदेस भेजिस:</para>
  <para style="pm" vid="2CH 2:3">“तेंह मोर ददा दाऊद ला ओकर रहे के महल बनाय बर देवदार के लकड़ी पठोय रहय, त मोर बर घलो अइसने ही देवदार के लकड़ी पठो। <verse eid="2CH 2:3" /><verse number="4" style="v" sid="2CH 2:4" />अब मेंह यहोवा मोर परमेसर के नांव बर एक मंदिर बनानेवाला हंव अऊ ओला समरपित करहूं, ताकि ओकर आघू म खुसबू देवइया धूप जलाय जावय, हमेसा पबितर रोटी रखे जावय, अऊ हर बिहनियां अऊ संझा के अऊ बिसराम दिन म, नवां चंदा अऊ यहोवा हमर परमेसर दुवारा ठहिराय गे तिहार म होम-बलिदान चघाय जावय। येह इसरायल बर हमेसा के एक बिधि अय।<verse eid="2CH 2:4" /></para>
  <para style="pm">
    <verse number="5" style="v" sid="2CH 2:5" />“जऊन मंदिर मेंह बनानेवाला हंव, ओह अब्बड़ महान होही, काबरकि हमर परमेसर ह आने जम्मो देवता ले महान अय। <verse eid="2CH 2:5" /><verse number="6" style="v" sid="2CH 2:6" />पर अइसन कोन हे, जऊन ह ओकर बर एक मंदिर बनवा सकथे, काबरकि स्वरगमन, अऊ त अऊ सबले ऊंच स्वरगमन घलो ओला धारन नइं कर सकंय? त मेंह कोन अंव, कि ओकर आघू म बलिदान के एक जगह ला छोंड़ ओकर बर एक मंदिर बनवावंव?<verse eid="2CH 2:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="2CH 2:7" />“एकरसेति मोर करा एक आदमी भेज, जऊन ह सोन अऊ चांदी, कांसा अऊ लोहा, अऊ बैंगनी, लाल अऊ नीला सूंत म काम करे के कुसल कारीगर होवय, अऊ नक्कासी के कला म अनुभवी होवय, अऊ जऊन ह मोर ओ कुसल कारीगरमन संग यहूदा अऊ यरूसलेम म काम कर सकय, जेमन ला मोर ददा दाऊद ह ठहिराय हवय।<verse eid="2CH 2:7" /></para>
  <para style="pm">
    <verse number="8" style="v" sid="2CH 2:8" />“मोर करा लबानोन ले देवदार, सनोवर अऊ चंदन के लकड़ी घलो भेज, काबरकि मोला मालूम हवय कि तोर सेवकमन उहां लकड़ी काटे म माहिर अंय। मोर सेवकमन तोर सेवकमन संग बुता करहीं <verse eid="2CH 2:8" /><verse number="9" style="v" sid="2CH 2:9" />जेकर ले मोला अब्बड़ अकन लकड़ी मिल जाही, काबरकि जऊन मंदिर मेंह बनवावत हंव, ओह बहुंत बड़े अऊ सानदार होना चाही। <verse eid="2CH 2:9" /><verse number="10" style="v" sid="2CH 2:10" />तोर जऊन सेवकमन लकड़ी काटहीं, मेंह ओमन ला बीस हजार कोर्स<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">लगभग 3,600 टन</char></note> गहूं, बीस हजार कोर्स<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">लगभग 3,000 टन</char></note> जौ, बीस हजार बत<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">लगभग 4,40,000 लीटर</char></note> अंगूर के मंद अऊ बीस हजार बत जैतून तेल दूहूं।”<verse eid="2CH 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 2:11" />तब सूर के राजा हीराम ह सुलेमान ला चिट्ठी लिखके जबाब दीस:</para>
  <para style="pm" vid="2CH 2:11">“काबरकि यहोवा ह अपन मनखेमन ले मया करथे, एकरसेति ओह तोला ओमन के राजा बनाय हवय।”<verse eid="2CH 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 2:12" />अऊ हीराम ह ओमा ये घलो जोड़िस:</para>
  <para style="pm" vid="2CH 2:12">“यहोवा, इसरायल के परमेसर के परसंसा होवय, जेह अकास अऊ धरती ला बनाईस! ओह राजा दाऊद ला एक बुद्धिमान बेटा देय हवय, जऊन ह बुद्धि अऊ सूझ-बूझ ले भरे हवय, जऊन ह यहोवा बर एक मंदिर अऊ अपन बर एक राजमहल बनवाही।<verse eid="2CH 2:12" /></para>
  <para style="pm">
    <verse number="13" style="v" sid="2CH 2:13" />“मेंह तोर मेर हूराम-अबी ला भेजत हवंव, जऊन ह एक बढ़िया कारीगर अय, <verse eid="2CH 2:13" /><verse number="14" style="v" sid="2CH 2:14" />जेकर दाई ह दान के गोत्र अऊ ददा ह सूर देस के रिहिस। ओह सोन अऊ चांदी, कांसा अऊ लोहा, पथरा अऊ लकड़ी, अऊ बैंगनी अऊ नीला अऊ लाल रंग के सूंत अऊ सुघर मलमल म काम करे बर सिखोय गे मनखे अय। ओह जम्मो किसम के नक्कासी के काम म अनुभवी अय अऊ ओला दिये गय कोनो भी बनावट ला ओह तियार कर सकथे। ओह तोर अऊ तोर ददा, मोर मालिक दाऊद के कुसल कारीगरमन संग बुता करही।<verse eid="2CH 2:14" /></para>
  <para style="pm">
    <verse number="15" style="v" sid="2CH 2:15" />“अब मोर मालिक ह अपन वायदा के मुताबिक अपन सेवकमन ला गहूं अऊ जौ अऊ जैतून तेल अऊ अंगूर के मंद भेज देवय, <verse eid="2CH 2:15" /><verse number="16" style="v" sid="2CH 2:16" />अऊ हमन लबानोन ले ओ जम्मो लकरी ला काट लेबो, जेकर तोला जरूरत हवय अऊ ओला बेड़ा म समुंदरी रसता ले यापा भेज देबो। तब तेंह ओमन ला यरूसलेम ले जा सकत हस।”<verse eid="2CH 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 2:17" />सुलेमान ह इसरायल म रहइया जम्मो परदेसीमन के गनती करवाईस, ये गनती ओकर ददा दाऊद के गनती के पाछू करे गीस; अऊ ओमन 1,53,600 रिहिन। <verse eid="2CH 2:17" /><verse number="18" style="v" sid="2CH 2:18" />ओह ओमा ले 70,000 मनखे ला बोझा ढोवइया अऊ 80,000 मनखे ला पहाड़ीमन म पथरा काटे बर, अऊ संग म 3,600 मनखे ला बुता करइयामन ऊपर देखरेख करे बर ठहिराईस।<verse eid="2CH 2:18" /></para>
  <chapter eid="2CH 2" />
  <chapter number="3" style="c" sid="2CH 3" />
  <para style="s1">सुलेमान ह मंदिर बनाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 3:1" />येकर बाद सुलेमान ह यरूसलेम म मोरियाह पहाड़ ऊपर यहोवा के मंदिर ला बनाय के सुरू करिस, जिहां यहोवा ह ओकर ददा दाऊद ला दरसन देय रिहिस। येह यबूसी ओरनान<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">ओरनान </char><char style="ft" closed="false">जऊन ह </char><char style="fqa" closed="false">अरौना </char><char style="ft" closed="false">के आने नांव ए</char></note> के कोठार रिहिस, जेला दाऊद ह देय रिहिस। <verse eid="2CH 3:1" /><verse number="2" style="v" sid="2CH 3:2" />सुलेमान ह अपन राज के चौथा बछर के दूसर महिना के दूसर दिन मंदिर ला बनाय के काम सुरू करिस।<verse eid="2CH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 3:3" />परमेसर के मंदिर बनाय बर सुलेमान दुवारा रखे गय नीव ह साठ क्यूबीट लम्बा अऊ बीस क्यूबीट चौड़ा<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">लगभग 90 फीट लम्बा अऊ 30 फीट चौड़ा</char></note> रिहिस (पुराना समय के क्यूबीट के उपयोग करे गीस)। <verse eid="2CH 3:3" /><verse number="4" style="v" sid="2CH 3:4" />मंदिर के सामने के मंडप ह बीस क्यूबीट लम्बा अऊ येह मंदिर के पूरा चौड़ई म रिहिस अऊ येकर ऊंचई बीस क्यूबीट रिहिस।</para>
  <para style="p" vid="2CH 3:4">ओह ओकर भीतरी भाग ला सुध सोन ले मढ़वाईस। <verse eid="2CH 3:4" /><verse number="5" style="v" sid="2CH 3:5" />ओह मुख्य सभा के मंडप के भीतरी भाग म सनोवर के लकड़ी लगवाईस अऊ खांटी सोन के परत ले मढ़वा दीस अऊ येला खजूर रूख अऊ जंजीर के बनावट ले सजवाईस। <verse eid="2CH 3:5" /><verse number="6" style="v" sid="2CH 3:6" />ओह मंदिर ला कीमती पथरामन ले सजवाईस। अऊ जऊन सोन के उपयोग ओह करिस, ओह परवैम के सोन रिहिस। <verse eid="2CH 3:6" /><verse number="7" style="v" sid="2CH 3:7" />ओह मंदिर के छत के कड़ीमन ला, कपाट के चौखटमन, दीवार अऊ कपाटमन ला सोन ले मढ़वाईस, अऊ दीवारमन म करूब के नक्कासी करवाईस।<verse eid="2CH 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 3:8" />ओह महा पबितर स्थान ला बनाईस, येकर लम्बई ह मंदिर के चौड़ई के बरोबर रिहिस—बीस क्यूबीट लम्बा अऊ बीस क्यूबीट चौड़ा। ओह येकर भीतरी भाग ला छै सौ टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">लगभग 23 टन</char></note> खांटी सोन ले मढ़वाईस। <verse eid="2CH 3:8" /><verse number="9" style="v" sid="2CH 3:9" />सोन के खीलामन के वजन पचास सेकेल<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">लगभग 575 ग्राम</char></note> रिहिस। ओह ऊपरी भागमन ला घलो सोन ले मढ़वा दीस।<verse eid="2CH 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 3:10" />महा पबितर स्थान बर खुदवाके करूबमन के एक जोड़ा बनाईस अऊ ओमन ला सोन ले मढ़वाईस। <verse eid="2CH 3:10" /><verse number="11" style="v" sid="2CH 3:11" />करूबमन के पूरा डेना ह बीस क्यूबीट रिहिस। पहिली करूब के एक ठन डेना ह पांच क्यूबीट लम्बा रिहिस अऊ मंदिर के दीवार ला छूवत रिहिस, जबकि येकर दूसर डेना ह घलो पांच क्यूबीट लम्बा रिहिस, अऊ आने करूब के डेना ला छूवत रिहिस। <verse eid="2CH 3:11" /><verse number="12" style="v" sid="2CH 3:12" />वइसने ही आने करूब के डेना ह घलो पांच क्यूबीट लम्बा रिहिस अऊ मंदिर के दूसर दीवार ला छूवत रिहिस, अऊ येकर आने डेना ह घलो पांच क्यूबीट लम्बा रिहिस, जऊन ह पहिली करूब के डेना ला छूवत रिहिस। <verse eid="2CH 3:12" /><verse number="13" style="v" sid="2CH 3:13" />ये करूबमन के डेनामन बीस क्यूबीट तक फईले रिहिन। येमन अपन गोड़ म खड़े रहंय अऊ येमन के मुहूं ह मुख्य मंडप कोति रहय।<verse eid="2CH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 3:14" />ओह नीला, बैंगनी अऊ लाली रंग के सूंत अऊ सुघर मलमल के परदा बनाईस, जेमा करूबमन के कढ़ई करिस।<verse eid="2CH 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 3:15" />मंदिर के आघू बर ओह दू ठन खंभा बनाईस, जेमन पैंतीस क्यूबीट लम्बा रिहिन, हर एक के ऊपर के कंगनी ह पांच क्यूबीट रिहिस। <verse eid="2CH 3:15" /><verse number="16" style="v" sid="2CH 3:16" />ओह गुंथाय सांकल बनवाके खंभामन के ऊपर म लगवा दीस। ओह सौ ठन अनार घलो बनाईस अऊ ओला सांकल म लटका दीस। <verse eid="2CH 3:16" /><verse number="17" style="v" sid="2CH 3:17" />ओह मंदिर के आघू म खंभामन ला बनाईस, एक ठन दक्खिन अऊ एक ठन ला उत्तर कोति। दक्खिन कोति के खंभा के नांव ओह याकीन<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="fq" closed="false">याकीन </char><char style="ft" closed="false">संभवतः येकर मतलब होथे </char><char style="fqa" closed="false">ओह स्थापित करथे</char></note> रखिस अऊ उत्तर कोति के खंभा के नांव बोअज<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="fq" closed="false">बोअज </char><char style="ft" closed="false">संभवतः येकर मतलब होथे </char><char style="fqa" closed="false">ओमा ताकत हवय</char></note> रखिस।<verse eid="2CH 3:17" /></para>
  <chapter eid="2CH 3" />
  <chapter number="4" style="c" sid="2CH 4" />
  <para style="s1">मंदिर के सामान</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 4:1" />राजा सुलेमान ह कांसा के एक बेदी बनाईस, जेह बीस क्यूबीट लम्बा, बीस क्यूबीट चौड़ा अऊ दस क्यूबीट ऊंचहा रिहिस।<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">लगभग 30 फीट लम्बा, 30 फीट चौड़ा अऊ 15 फीट ऊंचा</char></note> <verse eid="2CH 4:1" /><verse number="2" style="v" sid="2CH 4:2" />ओह ढाले गय धातु ले एक बड़े हौज बनाईस, जऊन ह आकार म गोल रिहिस, ओकर बियास ह दस क्यूबीट अऊ ऊंचई पांच क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">लगभग साढ़े सात फीट</char></note> रिहिस। येकर कुल घेरा के नाप तीस क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">लगभग 45 फीट</char></note> रिहिस। <verse eid="2CH 4:2" /><verse number="3" style="v" sid="2CH 4:3" />गोल घेरा के खाल्हे म बईलामन के मूरती दस क्यूबीट के घेरा म रिहिस। बईलामन ला हौज के संग दू कतार म एके ठन कुटा म ढालके बनाय गे रिहिस।<verse eid="2CH 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 4:4" />हौज ला बारह ठन बनाय गे बईलामन ऊपर रखे गे रिहिस, जेमा के तीन ठन के मुहूं उत्तर कोति, तीन ठन के मुहूं पछिम कोति, तीन ठन के मुहूं दक्खिन कोति अऊ तीन ठन के मुहूं पूरब कोति रिहिस। हौज ला ओमन के ऊपर मढ़ाय गे रिहिस, अऊ ओमन के पाछू के भागमन हौज के मांझा कोति रहंय। <verse eid="2CH 4:4" /><verse number="5" style="v" sid="2CH 4:5" />येकर मोटई लगभग तीन ईंच रिहिस, अऊ ओकर किनारा ह कटोरा के किनारा असन, खिले कुमुदिनी फूल सहीं रिहिस। ओमा तीन हजार बत पानी<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">लगभग 66,000 लीटर</char></note> हमात रिहिस।<verse eid="2CH 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 4:6" />ओकर बाद ओह धोय बर दस ठन तसला बनाईस अऊ पांच ठन ला दक्खिन कोति अऊ पांच ठन ला उत्तर कोति मढ़ाईस। ओमा होम-बलिदान चघाय म उपयोग के चीजमन ला धोय जावय, पर हौज के उपयोग पुरोहितमन के दुवारा धोय बर करे जावय।<verse eid="2CH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 4:7" />बिसेस निरदेस के मुताबिक ओह दस ठन सोन के दीवट ला बनाईस अऊ ओमन ला मंदिर म रख दीस, पांच ठन ला दक्खिन कोति अऊ पांच ठन ला उत्तर म रखिस।<verse eid="2CH 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 4:8" />ओह दस ठन मेज बनाईस अऊ ओमन ला मंदिर म रख दीस, पांच ठन ला दक्खिन कोति अऊ पांच ठन ला उत्तर म रखिस। ओह सौ ठन सोन के छिंचनेवाला कटोरा घलो बनाईस।<verse eid="2CH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 4:9" />ओह पुरोहितमन के अंगना, अऊ बड़े अंगना अऊ अंगना के कपाटमन ला बनाईस, अऊ कपाटमन ला कांसा ले मढ़वाईस। <verse eid="2CH 4:9" /><verse number="10" style="v" sid="2CH 4:10" />ओह हौज ला दक्खिन कोति, दक्खिन-पूरब के कोनटा म रखिस।<verse eid="2CH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 4:11" />अऊ हूराम ह बरतन अऊ बेलचा अऊ छिंचे बर कटोरामन ला घलो बनाईस।</para>
  <para style="p" vid="2CH 4:11">ये किसम ले हूराम ह राजा सुलेमान के दुवारा दिये गय काम ला परमेसर के मंदिर म पूरा करिस:<verse eid="2CH 4:11" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="12" style="v" sid="2CH 4:12" />दू ठन खंभामन;</para>
  <para style="li1" vid="2CH 4:12">खंभामन के टीप म कटोरा के आकार के दू ठन कंगनी;</para>
  <para style="li1" vid="2CH 4:12">खंभामन के टीप म कटोरा के आकार के दूनों कंगनीमन ला सजाय बर दू ठन जाली तियार करिस;<verse eid="2CH 4:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="2CH 4:13" />दूनों जाली बर चार सौ अनार (खंभामन के टीप म कटोरा के आकार के कंगनीमन ला सजाय बर हर एक जाली म ये अनारमन दू ठन कतार म रहंय);<verse eid="2CH 4:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="2CH 4:14" />तसलामन के संग ओमन के खुरामन;<verse eid="2CH 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="2CH 4:15" />हौज अऊ ओकर खाल्हे म बारह ठन बईला;<verse eid="2CH 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="2CH 4:16" />बरतन, बेलचा, मांस निकाले बर कांटा अऊ येकर से जुड़े सामान।</para>
  <para style="b" vid="2CH 4:16" />
  <para style="p" vid="2CH 4:16">ये जम्मो चीज, जेमन ला हूराम-अबी ह यहोवा के मंदिर बर राजा सुलेमान के हुकूम ले बनाईस, येमन चमकदार कांसा के बने रिहिन। <verse eid="2CH 4:16" /><verse number="17" style="v" sid="2CH 4:17" />राजा ह ओमन ला यरदन के मैदान म सुक्कोत अऊ सारतान<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">सरेदाता </char><char style="ft" closed="false">जऊन ह </char><char style="fq" closed="false">सारतान </char><char style="ft" closed="false">के आने नांव ए</char></note> के बीच म चिक्कन माटी के सांचा ले ढलवाय रिहिस। <verse eid="2CH 4:17" /><verse number="18" style="v" sid="2CH 4:18" />सुलेमान ह जतेक चीजमन ला बनवाय रिहिस, ओ जम्मो ह अतेक जादा रिहिस कि कांसा के वजन के गनती नइं करे जा सकत रिहिस।<verse eid="2CH 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 4:19" />सुलेमान ह ओ जम्मो सजावट के चीजमन ला घलो बनवाईस, जेमन परमेसर के मंदिर म रिहिन:</para>
  <para style="b" vid="2CH 4:19" />
  <para style="li1" vid="2CH 4:19">सोन के बेदी;</para>
  <para style="li1" vid="2CH 4:19">ओ मेज जेमा भेंट के रोटी रखे जावय;<verse eid="2CH 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="2CH 4:20" />सुध सोन के दीवटमन के संग ओमन के दीयामन ला भीतरी पबितर-स्थान के आघू म जलाय बर जइसे कि बताय गे रिहिस;<verse eid="2CH 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="2CH 4:21" />सोन के फूलवाला काम अऊ दीया अऊ चिमटामन (येमन ठोस सोन के रिहिन);<verse eid="2CH 4:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="2CH 4:22" />बाती ला काटे बर सुध सोन के कतरनी, छिंचे के कटोरामन, बरतन अऊ धूपदानीमन; अऊ मंदिर के सोन के कपाटमन: महा पबितर स्थान के भीतरी कपाटमन अऊ मुख्य सभा मंडप के कपाटमन।<verse eid="2CH 4:22" /></para>
  <para style="b" />
  <chapter eid="2CH 4" />
  <chapter number="5" style="c" sid="2CH 5" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 5:1" />जब सुलेमान ह यहोवा के मंदिर के जम्मो बुता ला पूरा कर डारिस, तब ओह ओ चीजमन ला लानिस, जेमन ला ओकर ददा दाऊद ह अरपन करे रिहिस—ओमा सोन अऊ चांदी अऊ जम्मो सजावट के चीजमन रिहिन—अऊ ओह ओमन ला परमेसर के मंदिर के खजाना म रख दीस।<verse eid="2CH 5:1" /></para>
  <para style="s1">मंदिर म सन्दूक ला लाय जाथे</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 5:2" />तब सुलेमान ह यरूसलेम म इसरायल के अगुवामन ला, गोत्रमन के जम्मो मुखियामन ला अऊ इसरायली परिवारमन के मुखियामन ला बलाईस कि ओमन सियोन ले याने कि दाऊद के सहर ले यहोवा के करार के सन्दूक ला लानंय। <verse eid="2CH 5:2" /><verse number="3" style="v" sid="2CH 5:3" />अऊ जम्मो इसरायलीमन सातवां महिना म तिहार के बेरा राजा करा जूरिन।<verse eid="2CH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 5:4" />जब इसरायल के जम्मो अगुवामन आ गीन, त लेवीमन सन्दूक<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">करार के सन्दूक</char></note> ला उठाईन, <verse eid="2CH 5:4" /><verse number="5" style="v" sid="2CH 5:5" />अऊ ओमन करार के सन्दूक अऊ मिलापवाला तम्बू अऊ ओमा के जम्मो पबितर चीजमन ला ऊपर ले आईन। लेवीय पुरोहितमन ओमन ला उठाके लानिन; <verse eid="2CH 5:5" /><verse number="6" style="v" sid="2CH 5:6" />अऊ राजा सुलेमान अऊ जम्मो इसरायली सभा, जऊन मन ओकर करा जूरे रिहिन, ओमन सन्दूक के आघू म होके अतेक भेड़ अऊ पसुमन ला बलि करत रिहिन कि ओमन के हिसाब या गनती नइं करे जा सकिस।<verse eid="2CH 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 5:7" />तब पुरोहितमन यहोवा के करार के सन्दूक ला ओकर जगह म याने कि मंदिर के भीतरी पबितर-स्थान, महा पबितर स्थान म लानिन, अऊ ओला करूबमन के डेना के खाल्हे म मढ़ा दीन। <verse eid="2CH 5:7" /><verse number="8" style="v" sid="2CH 5:8" />करूबमन अपन डेनामन ला सन्दूक के ऊपर फईलाय रिहिन अऊ सन्दूक अऊ ओकर बोहे के डंडामन ला ढांपे रिहिन। <verse eid="2CH 5:8" /><verse number="9" style="v" sid="2CH 5:9" />ये डंडामन अतेक लम्बा रिहिन कि ओमन के छोरमन सन्दूक ले निकले रिहिन अऊ येमन ला भीतरी पबितर-स्थान के सामने ले देखे जा सकत रिहिस, पर ओमन ला पबितर स्थान के बाहिर ले नइं देखे जा सकत रिहिस; अऊ ओमन आज भी उहेंच हवंय। <verse eid="2CH 5:9" /><verse number="10" style="v" sid="2CH 5:10" />सन्दूक म सिरिप ओ दू ठन पथरा के पटिया के छोंड़ अऊ कुछू नइं रिहिस, जेला मूसा ह येमा होरेब पहाड़ ऊपर रखे रिहिस, जिहां इसरायलीमन के मिसर देस ले बाहिर निकले के बाद, यहोवा ह ओमन के संग एक करार करे रिहिस।<verse eid="2CH 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 5:11" />तब पुरोहितमन पबितर स्थान ले हट गीन। जतेक भी पुरोहित उहां रिहिन, ओ जम्मो झन अपन दल म भेद करे बिगर अपनआप ला सुध करे रिहिन। <verse eid="2CH 5:11" /><verse number="12" style="v" sid="2CH 5:12" />जम्मो लेवी, जेमन संगीतकार रिहिन—आसाप, हेमान, यदूतून अऊ ओमन के लइका अऊ रिस्तेदारमन—बेदी के पूरब कोति खड़े रिहिन, अऊ ओमन बढ़िया मलमल के ओनहा पहिरे मंजीरा, बीना अऊ सारंगी बजात रिहिन। ओमन के संग तुरही बजात 120 पुरोहितमन रिहिन। <verse eid="2CH 5:12" /><verse number="13" style="v" sid="2CH 5:13" />तुरही बजइया अऊ संगीतकारमन एक संग जूरके यहोवा के धनबाद अऊ परसंसा करत रिहिन। तुरही, मंजीरा अऊ आने बाजामन के संग, गवइयामन यहोवा के परसंसा म अपन अवाज उठाईन अऊ गाईन:</para>
  <para style="q1" vid="2CH 5:13">“ओह बने अय;</para>
  <para style="q2" vid="2CH 5:13">ओकर मया हमेसा बने रहिथे।”</para>
  <para style="p" vid="2CH 5:13">तब यहोवा के मंदिर ह बादर ले भर गीस, <verse eid="2CH 5:13" /><verse number="14" style="v" sid="2CH 5:14" />अऊ पुरोहितमन बादर के कारन अपन सेवा नइं देय सकिन, काबरकि यहोवा के महिमा ले परमेसर के मंदिर ह भर गे रिहिस।<verse eid="2CH 5:14" /></para>
  <chapter eid="2CH 5" />
  <chapter number="6" style="c" sid="2CH 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 6:1" />तब सुलेमान ह कहिस, “यहोवा ह कहे हवय कि ओह करिया बादर म निवास करही; <verse eid="2CH 6:1" /><verse number="2" style="v" sid="2CH 6:2" />मेंह तोर बर एक सानदार मंदिर बनाय हंव, तोर हमेसा रहे बर निवास के एक ठन जगह।”<verse eid="2CH 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 6:3" />जब इसरायल के जम्मो सभा ह उहां ठाढ़े रिहिस, त राजा ह ओमन कोति मुहूं करके ओमन ला आसीरबाद दीस। <verse eid="2CH 6:3" /><verse number="4" style="v" sid="2CH 6:4" />तब ओह कहिस:</para>
  <para style="pm" vid="2CH 6:4">“यहोवा, इसरायल के परमेसर के महिमा होवय; जऊन ह अपन हांथ ले मोर ददा दाऊद के संग अपन मुहूं ले करे गय वायदा ला पूरा करे हवय। काबरकि ओह कहे रिहिस, <verse eid="2CH 6:4" /><verse number="5" style="v" sid="2CH 6:5" />‘जऊन दिन ले मेंह अपन मनखेमन ला मिसर ले निकालके लानंय, तब ले मेंह इसरायल के कोनो गोत्र के एको ठन सहर ला एक मंदिर बनाय बर नइं चुने हवंव कि उहां मोर नांव होवय, अऊ न ही मेंह कोनो ला अपन मनखे इसरायलीमन ऊपर राजा चुने हवंव। <verse eid="2CH 6:5" /><verse number="6" style="v" sid="2CH 6:6" />पर अब मेंह यरूसलेम ला अपन नांव बर चुने हंव, अऊ मेंह दाऊद ला अपन इसरायली मनखेमन ऊपर राज करे बर चुने हवंव।’<verse eid="2CH 6:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="2CH 6:7" />“मोर ददा दाऊद के मन म ये बात रिहिस कि ओह इसरायल के परमेसर, यहोवा के नांव खातिर एक मंदिर बनावय। <verse eid="2CH 6:7" /><verse number="8" style="v" sid="2CH 6:8" />पर यहोवा ह मोर ददा दाऊद ला कहिस, ‘मोर नांव खातिर अपन मन म, मंदिर बनवाय के ईछा करके, तेंह बने करे हवस। <verse eid="2CH 6:8" /><verse number="9" style="v" sid="2CH 6:9" />तभो ले, तेंह ओ मनखे नो हस, जऊन ह ओ मंदिर ला बनाही, पर तोर बेटा, तोर खुद के मांस अऊ लहू—ओही ह मोर नांव बर मंदिर बनवाही।’<verse eid="2CH 6:9" /></para>
  <para style="pm">
    <verse number="10" style="v" sid="2CH 6:10" />“यहोवा ह अपन करे गय वायदा ला पूरा करे हवय। मेंह अपन ददा दाऊद के जगह म राजा बने हंव अऊ अब यहोवा के वायदा के मुताबिक मेंह इसरायल के सिंघासन म बईठे हवंव, अऊ मेंह यहोवा, इसरायल के परमेसर के नांव खातिर मंदिर ला बनाय हवंव। <verse eid="2CH 6:10" /><verse number="11" style="v" sid="2CH 6:11" />उहां मेंह सन्दूक ला रखे हंव, जेमा यहोवा के ओ करार हवय, जेला ओह इसरायल के मनखेमन संग करे रिहिस।”<verse eid="2CH 6:11" /></para>
  <para style="s1">सुलेमान के समरपन के बिनती</para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 6:12" />तब सुलेमान ह इसरायल के जम्मो सभा के आघू म यहोवा के बेदी के आघू म ठाढ़ होईस अऊ अपन हांथ ला फैलाईस। <verse eid="2CH 6:12" /><verse number="13" style="v" sid="2CH 6:13" />ओह पांच क्यूबीट लम्बा, पांच क्यूबीट चौड़ा अऊ तीन क्यूबीट ऊंच<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">लगभग 2.3 मीटर लम्बा अऊ चौड़ा अऊ 1.4 मीटर ऊंच</char></note> कांसा के एक चबूतरा बनाय रिहिस, अऊ येला बाहिर के अंगना के बीचों-बीच रखिस। ओह चबूतरा म ठाढ़ होईस अऊ इसरायल के जम्मो सभा के आघू म माड़ी टेकिस अऊ अपन हांथ ला स्वरग कोति उठाईस। <verse eid="2CH 6:13" /><verse number="14" style="v" sid="2CH 6:14" />ओह पराथना करत कहिस:</para>
  <para style="pm" vid="2CH 6:14">“हे यहोवा, इसरायल के परमेसर, स्वरग अऊ धरती म तोर असन कोनो परमेसर नइं एं—तेंह अपन ओ सेवकमन संग करे मया के करार ला पूरा करथस, जेमन पूरा मन से तोर रसता म बने रहिथें। <verse eid="2CH 6:14" /><verse number="15" style="v" sid="2CH 6:15" />तेंह अपन सेवक मोर ददा दाऊद ले करे ओ वायदा ला बनाय रखे हस; जेला तेंह अपन मुहूं ले बोलके करे रहय अऊ अपन हांथ ले ओला पूरा करे हस—जइसने कि येह आज हवय।<verse eid="2CH 6:15" /></para>
  <para style="pm">
    <verse number="16" style="v" sid="2CH 6:16" />“अब, हे यहोवा, इसरायल के परमेसर, अपन सेवक मोर ददा दाऊद ले करे गय वायदा ला बनाय रख, जब तेंह कहय, ‘मोर आघू म इसरायल के सिंघासन म बईठे बर तोला उत्तराधिकारी के कमी कभू नइं होवय, यदि सिरिप तोर संतानमन अपन जम्मो काम ला धियान देके मोर कानून के मुताबिक करंय, जइसे कि तेंह करे हस।’ <verse eid="2CH 6:16" /><verse number="17" style="v" sid="2CH 6:17" />अऊ अब, हे यहोवा, इसरायल के परमेसर, तोर ओ बचन, जेकर वायदा तेंह अपन सेवक दाऊद ले करे रहय, ओला सच होवन दे।<verse eid="2CH 6:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="2CH 6:18" />“पर का सही म परमेसर ह मनखेमन संग धरती म निवास करही? स्वरगमन, अऊ त अऊ सबले ऊंच स्वरगमन घलो तोला धारन नइं कर सकंय। फेर मोर बनाय ये मंदिर तो बहुंत छोटे हे! <verse eid="2CH 6:18" /><verse number="19" style="v" sid="2CH 6:19" />तभो ले, हे यहोवा, मोर परमेसर, अपन सेवक के पराथना अऊ दया के ओकर बिनती ऊपर धियान दे। मोर रोवई अऊ ओ पराथना ला सुन, जेला तोर सेवक ह तोर आघू म करत हवय। <verse eid="2CH 6:19" /><verse number="20" style="v" sid="2CH 6:20" />तोर आंखीमन रात अऊ दिन ये मंदिर कोति लगे रहंय, ये जगह जेकर बारे म तेंह कहे हस कि तेंह अपन नांव ला उहां रखबे। तेंह ओ पराथना ला सुन, जेला तोर सेवक ये जगह कोति मुहूं करके करथे। <verse eid="2CH 6:20" /><verse number="21" style="v" sid="2CH 6:21" />अपन सेवक अऊ अपन मनखे इसरायलीमन के बिनती ला सुन, जब ओमन ये जगह कोति मुहूं करके पराथना करथें। स्वरग ले, अपन निवास के जगह ले सुन; अऊ जब तें सुनथस, त ओमन ला छेमा कर।<verse eid="2CH 6:21" /></para>
  <para style="pm">
    <verse number="22" style="v" sid="2CH 6:22" />“जब कोनो अपन परोसी के बिरूध कोनो अपराध करय अऊ ओला किरिया खाय के जरूरत पड़य अऊ ओह आके ये मंदिर म तोर बेदी के आघू म किरिया खावय, <verse eid="2CH 6:22" /><verse number="23" style="v" sid="2CH 6:23" />तब स्वरग ले सुनके, अपन सेवकमन के बीच म नियाय कर, अपराधी के काम ला ओकर मुड़ म लानके ओला सजा दे, अऊ निरदोस के ओकर निरदोसता के मुताबिक नियाय कर।<verse eid="2CH 6:23" /></para>
  <para style="pm">
    <verse number="24" style="v" sid="2CH 6:24" />“जब तोर इसरायली मनखेमन तोर बिरूध पाप करे के कारन अपन कोनो बईरी ले हार जावंय, अऊ जब ओमन तोर कोति फेर लहुंटंय अऊ ये मंदिर म तोर आघू म पराथना अऊ बिनती करत तोर नांव के परसंसा करंय, <verse eid="2CH 6:24" /><verse number="25" style="v" sid="2CH 6:25" />तब स्वरग ले सुनबे अऊ अपन इसरायली मनखेमन के पाप ला छेमा करबे अऊ ओमन ला ओ देस म लहुंटाके ले आबे, जेला तेंह ओमन ला अऊ ओमन के पुरखामन ला देय हस।<verse eid="2CH 6:25" /></para>
  <para style="pm">
    <verse number="26" style="v" sid="2CH 6:26" />“तोर मनखेमन के तोर बिरूध पाप करे के कारन, जब अकास ह बंद हो जावय अऊ बरसा नइं होवय, अइसने बेरा म जब ओमन ये जगह कोति होके पराथना करंय अऊ तोर नांव के परसंसा करंय अऊ अपन पाप ले मन फिरावंय, काबरकि तेंह ओमन ला दुख म डाले हस, <verse eid="2CH 6:26" /><verse number="27" style="v" sid="2CH 6:27" />तब स्वरग ले सुनके अपन सेवक, अपन इसरायली मनखेमन के पाप ला छेमा करबे। ओमन ला जीये के सही रसता सिखाबे, अऊ ओ देस म बारिस भेजबे, जेला तेंह अपन मनखेमन ला उत्तराधिकार म देय हस।<verse eid="2CH 6:27" /></para>
  <para style="pm">
    <verse number="28" style="v" sid="2CH 6:28" />“जब अकाल या महामारी देस म आवय, या फसल म रोग या फफूंदी, टिड्डी या फांफामन लगंय, या जब बईरीमन ओमन ला ओमन के कोनो सहर म घेर लेवंय, याने कोनो भी बिपत्ति या बेमारी आवय, <verse eid="2CH 6:28" /><verse number="29" style="v" sid="2CH 6:29" />अऊ जब तोर इसरायली मनखेमन के बीच म ले कोनो ओमन के दुख अऊ पीरा ला जानके, ये मंदिर कोति अपन हांथ ला फईलाके पराथना या बिनती करय— <verse eid="2CH 6:29" /><verse number="30" style="v" sid="2CH 6:30" />तब अपन निवास स्वरग ले सुनके छेमा करबे; हर एक के संग ओमन के काम के मुताबिक बरताव करबे, तेंह ओमन के मन के बात ला जानथस (काबरकि सिरिप तेंहीच ह मनखे के मन ला जानथस), <verse eid="2CH 6:30" /><verse number="31" style="v" sid="2CH 6:31" />ताकि जऊन देस ला तेंह हमर पुरखामन ला देय हवस, ओ देस म रहत ओमन तोर भय मानंय अऊ हर समय तोर हुकूम म चलंय।<verse eid="2CH 6:31" /></para>
  <para style="pm">
    <verse number="32" style="v" sid="2CH 6:32" />“जहां तक परदेसी के बात ए, जऊन ह तोर इसरायली मनखेमन के बीच म के नो हय, पर तोर बड़े नांव अऊ बलवंत हांथ अऊ तोर बड़े काम के कारन दूरिहा देस ले आय हवय—जब ओमन आवंय अऊ ये मंदिर कोति मुहूं करके पराथना करंय, <verse eid="2CH 6:32" /><verse number="33" style="v" sid="2CH 6:33" />तब स्वरग, अपन निवास स्थान ले सुनबे। जऊन कुछू ओ परदेसी तोर ले मांगय, ओला पूरा करबे, ताकि धरती के जम्मो मनखे तोर नांव ला जानंय अऊ तोर भय मानंय, जइसे कि तोर खुद के इसरायली मनखेमन करथें, अऊ ओमन जानंय कि ये घर ला मेंह तोर नांव बर बनाय हवंव।<verse eid="2CH 6:33" /></para>
  <para style="pm">
    <verse number="34" style="v" sid="2CH 6:34" />“जब तेंह अपन मनखेमन ला ओमन के बईरीमन के बिरूध लड़े बर जिहां कहीं भी पठोथस, अऊ जब ओमन तोर ले तोर चुने ये सहर अऊ तोर नांव बर मोर बनाय ये मंदिर कोति होके पराथना करंय, <verse eid="2CH 6:34" /><verse number="35" style="v" sid="2CH 6:35" />तब स्वरग ले ओमन के पराथना अऊ बिनती ला सुनबे, अऊ ओमन ला संभालबे।<verse eid="2CH 6:35" /></para>
  <para style="pm">
    <verse number="36" style="v" sid="2CH 6:36" />“जब ओमन तोर बिरूध पाप करंय—काबरकि कोनो भी अइसन नइं ए जऊन ह पाप नइं करय—अऊ तेंह ओमन ऊपर गुस्सा होके ओमन ला ओमन के बईरी के हांथ म कर देवस, जऊन ह ओमन ला बहुंत दूरिहा या लकठा के देस म बंदी बनाके ले जावय; <verse eid="2CH 6:36" /><verse number="37" style="v" sid="2CH 6:37" />अऊ यदि तोर मनखेमन ओ बंदी बनाय गे देस म अपन मन ला बदलंय, अऊ पछताप करंय अऊ बंदी बनाय गय देस म तोर ले बिनती करके कहंय, ‘हमन पाप करे हवन, हमन गलती करे हवन, अऊ दुस्टता के काम करे हवन’; <verse eid="2CH 6:37" /><verse number="38" style="v" sid="2CH 6:38" />अऊ यदि ओमन अपन ओ बंदी बनाय गय देस म जिहां ओमन ला ले जाय गे हवय, अपन पूरा मन अऊ आतमा ले तोर कोति फिरंय, अऊ ओमन के पुरखामन ला तोर दिये देस कोति, तोर चुने सहर कोति अऊ तोर नांव खातिर मोर बनाय ये मंदिर कोति होके तोर ले पराथना करंय; <verse eid="2CH 6:38" /><verse number="39" style="v" sid="2CH 6:39" />त स्वरग, अपन निवास स्थान ले ओमन के पराथना अऊ बिनती ला सुनबे, अऊ ओमन ला संभालबे। अऊ अपन मनखेमन ला छेमा करबे, जेमन कि तोर बिरूध पाप करे हवंय।<verse eid="2CH 6:39" /></para>
  <para style="pm">
    <verse number="40" style="v" sid="2CH 6:40" />“अब हे मोर परमेसर, तोर आंखीमन खुले रहंय अऊ तोर कान ह ये जगह म करे गे पराथना ऊपर धियान देवय।<verse eid="2CH 6:40" /></para>
  <para style="qm1">
    <verse number="41" style="v" sid="2CH 6:41" />“हे यहोवा परमेसर, अब उठ, अऊ अपन बिसराम के जगह म</para>
  <para style="qm2" vid="2CH 6:41">अपन सक्ति के सन्दूक के संग आ।</para>
  <para style="qm1" vid="2CH 6:41">हे यहोवा परमेसर, तोर पुरोहितमन उद्धार के कपड़ा पहिरंय।</para>
  <para style="qm2" vid="2CH 6:41">तोर बिसवासयोग्य मनखेमन तोर अच्छई म आनंद मनावंय।<verse eid="2CH 6:41" /></para>
  <para style="qm1">
    <verse number="42" style="v" sid="2CH 6:42" />हे यहोवा परमेसर, अपन अभिसिक्त जन ला झन तियाग।</para>
  <para style="qm2" vid="2CH 6:42">अपन सेवक दाऊद ले करे गे बड़े मया के परतिगियां ला सुरता कर।”<verse eid="2CH 6:42" /></para>
  <chapter eid="2CH 6" />
  <chapter number="7" style="c" sid="2CH 7" />
  <para style="s1">मंदिर के समरपन</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 7:1" />जब सुलेमान के पराथना ह खतम होईस, त आगी ह स्वरग ले खाल्हे गिरिस अऊ होम-बलिदान अऊ बलिदानमन ला जलाके भसम कर दीस, अऊ यहोवा के महिमा ले मंदिर ह भर गीस। <verse eid="2CH 7:1" /><verse number="2" style="v" sid="2CH 7:2" />पुरोहितमन यहोवा के मंदिर म प्रवेस नइं कर सकिन, काबरकि यहोवा के महिमा ले ओह भर गीस। <verse eid="2CH 7:2" /><verse number="3" style="v" sid="2CH 7:3" />जब जम्मो इसरायलीमन मंदिर के ऊपर आगी गिरत अऊ यहोवा के महिमा ला देखिन, त ओमन माड़ी टेकके मुहूं-भरसा भुइयां म हो गीन, अऊ ओमन ये कहिके यहोवा के अराधना करिन अऊ धनबाद दीन,</para>
  <para style="q1" vid="2CH 7:3">“ओह बने अय;</para>
  <para style="q2" vid="2CH 7:3">ओकर मया सदा बने रहिथे।”<verse eid="2CH 7:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="2CH 7:4" />तब राजा अऊ जम्मो मनखेमन यहोवा के आघू म बलिदान चघाईन। <verse eid="2CH 7:4" /><verse number="5" style="v" sid="2CH 7:5" />अऊ राजा सुलेमान ह बाईस हजार पसुमन के मुड़ी अऊ एक लाख बीस हजार भेड़ अऊ बकरामन के बलिदान चघाईस। ये किसम ले राजा अऊ जम्मो मनखेमन परमेसर के मंदिर के समरपन करिन। <verse eid="2CH 7:5" /><verse number="6" style="v" sid="2CH 7:6" />पुरोहितमन अपन-अपन जगह ला ले लीन, वइसे ही लेवीमन यहोवा के बाजामन संग अपन जगह लीन, जेला राजा दाऊद ह यहोवा के परसंसा बर बनाय रिहिस अऊ जेमन के उपयोग तब होवय, जब ओह ये कहिके धनबाद देवय, “ओकर मया हमेसा बने रहिथे।” लेवीमन के आघू म, पुरोहितमन अपन तुरही फूंकंय, अऊ जम्मो इसरायलीमन खड़े रहंय।<verse eid="2CH 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 7:7" />सुलेमान ह यहोवा के मंदिर के आघू के अंगना के मांझा वाले भाग के अभिसेक करिस, अऊ उहां ओह होम-बलिदान अऊ मेल-बलिदान के चरबी ला चघाईस, काबरकि जऊन कांसा के बेदी ओह बनाय रिहिस, ओमा होम-बलिदान, अन्न-बलिदान अऊ चरबी के हिस्सामन नइं समात रिहिन।<verse eid="2CH 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 7:8" />ओ बेरा, सुलेमान ह सात दिन तक तिहार मनाईस, अऊ ओकर संग जम्मो इसरायलीमन घलो मनाईन—येह एक बड़े सभा रिहिस, जेमा लेबो-हमात ले लेके मिसर के नरवा तक के मनखेमन रिहिन। <verse eid="2CH 7:8" /><verse number="9" style="v" sid="2CH 7:9" />आठवां दिन ओमन एक सभा के आयोजन करिन, काबरकि ओमन बेदी के समरपन बर सात दिन के उत्सव मनाय रिहिन अऊ सात दिन तिहार मनाय म बिताय रिहिन। <verse eid="2CH 7:9" /><verse number="10" style="v" sid="2CH 7:10" />सातवां महिना के तेईसवां दिन म, सुलेमान ह ओ मनखेमन ला ओमन के घर भेजिस; यहोवा ह जऊन भलई के काम दाऊद अऊ सुलेमान अऊ अपन इसरायली मनखेमन बर करे रिहिस, ओकर बर ओमन आनंदित अऊ मगन होके लहुंट गीन।<verse eid="2CH 7:10" /></para>
  <para style="s1">यहोवा ह सुलेमान ला दरसन देथे</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 7:11" />जब सुलेमान ह यहोवा के मंदिर अऊ राजमहल ला बना चुकिस, अऊ ओ सबो काम ला पूरा कर डारिस, जेमन ला ओह अपन मन म यहोवा के मंदिर अऊ अपन खुद के महल म करे के ठाने रिहिस, <verse eid="2CH 7:11" /><verse number="12" style="v" sid="2CH 7:12" />त यहोवा ह रथिया ओला दरसन दीस अऊ कहिस:</para>
  <para style="pm" vid="2CH 7:12">“मेंह तोर पराथना ला सुने हवंव अऊ ये जगह ला बलिदान बर मंदिर के रूप म अपन बर चुने हवंव।<verse eid="2CH 7:12" /></para>
  <para style="pm">
    <verse number="13" style="v" sid="2CH 7:13" />“जब मेंह अकास ला अइसन बंद कर देवंव कि बरसा झन होवय, या फांफामन ला देस ला उजारे के हुकूम देवंव, या अपन मनखेमन के बीच म महामारी भेजंव, <verse eid="2CH 7:13" /><verse number="14" style="v" sid="2CH 7:14" />तब कहूं मोर मनखेमन, जेमन मोर कहाथें, अपनआप ला दीन करके पराथना करहीं अऊ मोर दरसन के खोजी होहीं अऊ बुरई के रद्दा ले फिरहीं, तब मेंह स्वरग ले सुनके, ओमन के पाप ला छेमा करहूं अऊ ओमन के देस ला चंगा करहूं। <verse eid="2CH 7:14" /><verse number="15" style="v" sid="2CH 7:15" />अब मोर आंखी ह खुले रहिही, अऊ मोर कान ह ये जगह म करे गय पराथना ऊपर धियान दीही। <verse eid="2CH 7:15" /><verse number="16" style="v" sid="2CH 7:16" />मेंह ये मंदिर ला एकरसेति चुने अऊ अभिसेक करे हंव ताकि मोर नांव ह हमेसा बर उहां रहय। मोर आंखी अऊ मोर मन ह हमेसा उहां लगे रहिही।<verse eid="2CH 7:16" /></para>
  <para style="pm">
    <verse number="17" style="v" sid="2CH 7:17" />“जहां तक तोर बात ए, यदि तेंह मोर आघू म अपन ददा दाऊद के सहीं बिसवासयोग्यता से चलबे, अऊ मोर दिये जम्मो हुकूम ला मानबे, अऊ मोर बिधि अऊ कानूनमन के पालन करबे, <verse eid="2CH 7:17" /><verse number="18" style="v" sid="2CH 7:18" />त मेंह तोर राज सिंघासन ला स्थिर करहूं, जइसन कि मेंह तोर ददा दाऊद ले करार करके कहे रहेंव, ‘इसरायल ऊपर सासन करे बर, तोर बंस म उत्तराधिकारी के कमी कभू नइं होही।’<verse eid="2CH 7:18" /></para>
  <para style="pm">
    <verse number="19" style="v" sid="2CH 7:19" />“पर यदि तेंह<note caller="+" style="f"><char style="fr" closed="false">7:19 </char><char style="ft" closed="false">इबरानी म बहुबचन</char></note> मोर ले दूरिहा होके ओ बिधि अऊ हुकूममन ला तियाग देबे, जेला मेंह तोला देय हवंव अऊ जाके आने देवतामन के सेवा अऊ ओमन के अराधना करबे, <verse eid="2CH 7:19" /><verse number="20" style="v" sid="2CH 7:20" />तब मेंह अपन देस ले इसरायल ला उखान दूहूं, जेला मेंह ओमन ला देय हवंव, अऊ ये मंदिर ला तियाग दूहूं, जेला मेंह अपन नांव बर संस्कार करे हवंव। मेंह येला जम्मो झन के बीच म एक कहावत अऊ ठट्ठा के चीज बना दूहूं। <verse eid="2CH 7:20" /><verse number="21" style="v" sid="2CH 7:21" />ये मंदिर ह पथरामन के कुढ़हा हो जाही। अऊ ओ जम्मो, जेमन इहां ले होके जाहीं, ओमन अचरज करहीं अऊ कहिहीं, ‘यहोवा ह ये देस अऊ ये मंदिर ला अइसने काबर करे हवय?’ <verse eid="2CH 7:21" /><verse number="22" style="v" sid="2CH 7:22" />त मनखेमन जबाब दीहीं, ‘काबरकि ओमन यहोवा, अपन पुरखामन के ओ परमेसर ला तियाग दे हवंय, जऊन ह ओमन ला मिसर देस ले निकालके लानिस, ओमन आने देवतामन ला अपनाके ओमन के अराधना अऊ सेवा करत हवंय—एकरसेति ओह ये जम्मो बिपत्ति ओमन ऊपर लाने हवय।’ ”<verse eid="2CH 7:22" /></para>
  <chapter eid="2CH 7" />
  <chapter number="8" style="c" sid="2CH 8" />
  <para style="s1">सुलेमान के आने काममन</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 8:1" />बीसवां बछर के आखिर म, ये दौरान सुलेमान ह यहोवा के मंदिर अऊ अपन खुद के महल ला बनाईस, <verse eid="2CH 8:1" /><verse number="2" style="v" sid="2CH 8:2" />तब सुलेमान ह ओ गांवमन ला फेर बनाईस, जेला हीराम<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">हूराम, </char><char style="ft" closed="false">जऊन ह </char><char style="fq" closed="false">हीराम </char><char style="ft" closed="false">के आने नांव ए</char></note> ह ओला देय रिहिस, अऊ ओमा इसरायलीमन ला बसाईस। <verse eid="2CH 8:2" /><verse number="3" style="v" sid="2CH 8:3" />तब सुलेमान ह हमात-सोबा नगर जाके ओला कब्जा कर लीस। <verse eid="2CH 8:3" /><verse number="4" style="v" sid="2CH 8:4" />ओह सुनसान जगह म तदमोर नगर ला घलो बनाईस अऊ ओ जम्मो भंडार सहर, जेमन ला ओह हमात म बनाय रिहिस, ओमन ला घलो फेर बनाईस। <verse eid="2CH 8:4" /><verse number="5" style="v" sid="2CH 8:5" />ओह ऊपर के बेत-होरोन अऊ खाल्हे के बेत-होरोन ला गढ़वाला सहर के रूप म, दीवारमन के संग अऊ कपाट अऊ सरिया के संग फेर बनाईस, <verse eid="2CH 8:5" /><verse number="6" style="v" sid="2CH 8:6" />संगे-संग ओह बालात अऊ जम्मो भंडारवाले सहर, अऊ अपन रथ अऊ घोड़ामन<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सारथीमन</char></note> बर जम्मो सहर—ओह यरूसलेम म, लबानोन म अऊ अपन जम्मो राज म, जऊन कुछू बनाय चाहत रिहिस, ओ जम्मो ला बनाईस।<verse eid="2CH 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 8:7" />उहां अभी तक ले हित्ती, अमोरी, परिज्जी, हिब्बी, अऊ यबूसीमन के कुछू मनखेमन बांच गे रिहिन (ये मनखेमन इसरायली नइं रिहिन)। <verse eid="2CH 8:7" /><verse number="8" style="v" sid="2CH 8:8" />सुलेमान ह देस म ये जम्मो मनखे के ओ बांचे संतानमन ला बंधुवा मजदूर के रूप म सेवा करे बर रखिस, जेमन ला इसरायलीमन नास नइं करे रिहिन, ओमन आज तक वइसने ही हवंय। <verse eid="2CH 8:8" /><verse number="9" style="v" sid="2CH 8:9" />पर सुलेमान ह अपन बुता बर इसरायलीमन ला गुलाम नइं बनाईस; ओमन ओकर सैनिक, ओकर कप्तानमन के सेनापति, अऊ ओकर रथ अऊ सारथीमन के सेनापति रिहिन। <verse eid="2CH 8:9" /><verse number="10" style="v" sid="2CH 8:10" />ओमन राजा सुलेमान के मुखिया अधिकारीमन घलो रिहिन—दू सौ पचास अधिकारी, आदमीमन के काम ला देखंय।<verse eid="2CH 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 8:11" />सुलेमान ह फिरौन के बेटी ला दाऊद के सहर ले ओ महल म ले आईस, जेला सुलेमान ह ओकर बर बनाय रिहिस, काबरकि ओह सोचिस, “मोर घरवाली ला इसरायल के राजा दाऊद के महल म नइं रहना चाही, काबरकि यहोवा के सन्दूक ह जऊन-जऊन जगह म गे हवय ओ जगहमन पबितर अंय।”<verse eid="2CH 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 8:12" />यहोवा के बेदी म, जेला ओह मंडप के आघू म बनाय रिहिस, सुलेमान ह यहोवा ला होम-बलिदान चघाईस, <verse eid="2CH 8:12" /><verse number="13" style="v" sid="2CH 8:13" />ये बलिदान ला मूसा के दुवारा दिये हुकूम म हर दिन के जरूरत के मुताबिक बिसराम दिन, नवां चंदा अऊ तीन ठन सालाना तिहारमन बर चघाय जावय—याने कि अखमीरी रोटी के तिहार, हप्तामन के तिहार अऊ पबितर-तम्बूमन के तिहार। <verse eid="2CH 8:13" /><verse number="14" style="v" sid="2CH 8:14" />अपन ददा दाऊद के बिधि ला धियान म रखत, ओह पुरोहितमन ला ओमन के काम करे बर दल-दल म बांट दीस, अऊ लेवीमन ला अराधना करे म अगुवई करे बर अऊ हर एक दिन के जरूरत के मुताबिक पुरोहितमन के मदद करे बर ठहिराईस। ओह अलग-अलग दुवार बर दुवारपालमन के अलग-अलग दलमन ला घलो ठहिराईस, काबरकि अइसने ही परमेसर के जन दाऊद ह हुकूम देय रिहिस। <verse eid="2CH 8:14" /><verse number="15" style="v" sid="2CH 8:15" />ओमन राजा दुवारा पुरोहित या लेवीमन बर दिये गय कोनो भी हुकूम ले कोनो भी मामला म नइं हटिन, येमा खजानामन के मामला घलो रिहिस।<verse eid="2CH 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 8:16" />सुलेमान के जम्मो बुता ला करे गे रिहिस, यहोवा के मंदिर के नीव रखे के दिन ले लेके मंदिर के पूरा होवत तक। ये किसम ले यहोवा के मंदिर पूरा हो गीस।<verse eid="2CH 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 8:17" />तब सुलेमान ह एदोम देस के तट म एसियोन-गेबेर अऊ एलात नगर म गीस। <verse eid="2CH 8:17" /><verse number="18" style="v" sid="2CH 8:18" />अऊ हीराम ह ओकर मेर पानी जहाज पठोईस, जेला ओकर खुद के मनखेमन चलावंय, ओमन नाविक रिहिन अऊ समुंदर के जानकार रिहिन। येमन, सुलेमान के मनखेमन संग, ओपीर गीन अऊ उहां ले वापिस चार सौ पचास टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="ft" closed="false">लगभग 17 टन</char></note> सोन लानके राजा सुलेमान ला दे दीन।<verse eid="2CH 8:18" /></para>
  <chapter eid="2CH 8" />
  <chapter number="9" style="c" sid="2CH 9" />
  <para style="s1">सेबा के रानी के सुलेमान ले मिलई</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 9:1" />जब सेबा के रानी ह सुलेमान के जस ला सुनिस, तब ओह ओला परखे बर कठिन-कठिन सवाल लेके यरूसलेम आईस। ओह एक बड़े दल के संग ऊंटमन म मसाला, बहुंत अकन सोन, अऊ कीमती रत्नमन ला लेके आईस; ओह सुलेमान मेर आईस अऊ अपन मन म जऊन बात रिहिस, ओ जम्मो के बारे ओकर ले गोठियाईस। <verse eid="2CH 9:1" /><verse number="2" style="v" sid="2CH 9:2" />सुलेमान ह ओकर जम्मो सवाल के जबाब दीस; कोनो भी बात ओकर बर अइसे कठिन नइं रिहिस कि ओह ओला नइं समझा सकय। <verse eid="2CH 9:2" /><verse number="3" style="v" sid="2CH 9:3" />जब सेबा के रानी ह सुलेमान के बुद्धि ला देखिस, संग म ओकर बनाय महल, <verse eid="2CH 9:3" /><verse number="4" style="v" sid="2CH 9:4" />ओकर मेज के जेवन, ओकर करमचारीमन के बईठना, पोसाक पहिरे सेवकमन के सेवा करई, पोसाक पहिरे पीयानेवालामन अऊ यहोवा के मंदिर म ओकर दुवारा चघाय गे होम-बलिदानमन ला देखिस, त ओह चकित हो गीस।<verse eid="2CH 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 9:5" />ओह राजा ले कहिस, “जऊन बात, मेंह अपन देस म तोर काम अऊ तोर बुद्धि के बारे म सुने रहेंव, ओह सही अय। <verse eid="2CH 9:5" /><verse number="6" style="v" sid="2CH 9:6" />पर ओमन के कहे बात ऊपर मोला बिसवास नइं होईस, जब तक कि मेंह आके अपन आंखी ले नइं देख लेंव। वास्तव म, तोर बुद्धि के आधा महानता ला घलो मोला नइं बताय गे रिहिस; जऊन बात मेंह सुने रहेंव, तेंह ओकर ले बढ़के हस। <verse eid="2CH 9:6" /><verse number="7" style="v" sid="2CH 9:7" />तोर मनखेमन कतेक खुस होहीं! तोर करमचारीमन कतेक खुस होहीं, जऊन मन लगातार तोर आघू म ठाढ़े रहिके तोर बुद्धि के गोठ ला सुनथें! <verse eid="2CH 9:7" /><verse number="8" style="v" sid="2CH 9:8" />यहोवा तोर परमेसर के परसंसा होवय, जऊन ह तोर ले खुस हवय अऊ तोला राजा के रूप म अपन सिंघासन म बईठाय हवय, ताकि तें यहोवा अपन परमेसर कोति ले सासन कर सकस। इसरायल बर तोर परमेसर के मया अऊ हमेसा बर ओमन ला ऊपर बनाय रखे के ओकर मनसा के कारन, ओह तोला ओमन ऊपर राजा बनाय हवय, ताकि तेंह नियाय अऊ धरमीपन ला बनाय रख।”<verse eid="2CH 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 9:9" />तब ओह राजा ला 120 टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false">लगभग साढ़े चार टन</char></note> सोन, अब्बड़ अकन मसाला, अऊ कीमती रत्न दीस। अइसन मसाला कभू नइं देखे गे रिहिस, जइसन सेबा के रानी ह राजा सुलेमान ला दीस।<verse eid="2CH 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 9:10" />(हीराम के सेवक अऊ सुलेमान के सेवकमन ओपीर ले सोन लानिन; ओमन चंदन के लकरी अऊ कीमती पथरा घलो लानिन। <verse eid="2CH 9:10" /><verse number="11" style="v" sid="2CH 9:11" />राजा ह चंदन के लकरी ले यहोवा के मंदिर अऊ राजमहल बर सीढ़ी अऊ संगीतकारमन बर बीना अऊ सारंगी बनवाईस। ओकर असन कुछू भी कभू यहूदा म नइं देखे गे रिहिस।)<verse eid="2CH 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 9:12" />राजा सुलेमान ह सेबा के रानी ला ओ सब दीस, जेकर ईछा ओह करिस अऊ मांगिस; जतेक चीज सेबा के रानी ह सुलेमान ला देय रिहिस, सुलेमान ह ओकर ले जादा ओला दीस। तब रानी ह अपन सेवकमन के संग अपन देस लहुंट गीस।<verse eid="2CH 9:12" /></para>
  <para style="s1">सुलेमान के सान-सौकत</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 9:13" />सुलेमान ला हर साल 666 टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">लगभग 25 टन</char></note> सोन मिलत रिहिस, <verse eid="2CH 9:13" /><verse number="14" style="v" sid="2CH 9:14" />जेमा सौदागर अऊ बेपारीमन के दुवारा लाय गय लगान ह सामिल नइं रिहिस। संग म अरब देस के जम्मो राजा अऊ राजमन के राजपालमन घलो सोन अऊ चांदी सुलेमान मेर लानंय।<verse eid="2CH 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 9:15" />राजा सुलेमान ह गढ़े गय सोन ले दू सौ बड़े ढाल बनवाईस; हर एक ढाल म छै-छै सौ सेकेल गढ़े गय सोन लगिस।<note caller="+" style="f"><char style="fr" closed="false">9:15 </char><char style="ft" closed="false">लगभग 6.9 किलोग्राम</char></note> <verse eid="2CH 9:15" /><verse number="16" style="v" sid="2CH 9:16" />ओह गढ़े गय सोन के तीन सौ छोटे ढाल घलो बनाईस, जेमा के हर एक ढाल म तीन-तीन सौ सेकेल<note caller="+" style="f"><char style="fr" closed="false">9:16 </char><char style="ft" closed="false">लगभग 3.5 किलोग्राम</char></note> सोन लगिस। राजा ह ओमन ला लबानोन के जंगल के महल म रख दीस।<verse eid="2CH 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 9:17" />तब राजा ह हाथी-दांत ले ढंके एक बड़े सिंघासन बनवाईस अऊ ओला सुध सोन ले मढ़वाईस। <verse eid="2CH 9:17" /><verse number="18" style="v" sid="2CH 9:18" />सिंघासन के छै ठन पायदान रिहिस, अऊ सोन के एक ठन पांवदानी ओमा जुड़े रिहिस। आसन के दूनों कोति हांथ रखे के हत्था लगे रहय, अऊ दूनों हत्था के बाजू म एक-एक ठन सेर ठाढ़े स्थिति म बनाय गे रहंय। <verse eid="2CH 9:18" /><verse number="19" style="v" sid="2CH 9:19" />बारह ठन सेर छै ठन पायदानमन म खड़े रिहिन, हर एक पायदान के दूनों छोर म एक-एक ठन। कोनो आने राज म अइसने सिंघासन कभू नइं बनाय गे रिहिस। <verse eid="2CH 9:19" /><verse number="20" style="v" sid="2CH 9:20" />राजा सुलेमान के पीये के जम्मो पियालामन सोन के रिहिन, अऊ लबानोन के जंगल के महल म जम्मो बरतन सुध सोन के रिहिन। कुछू भी चीज चांदी के नइं बने रिहिस, काबरकि सुलेमान के समय म चांदी के जादा कीमत नइं रिहिस। <verse eid="2CH 9:20" /><verse number="21" style="v" sid="2CH 9:21" />राजा सुलेमान मेर हीराम के सेवकमन के दुवारा चलाय जानेवाला एक ब्यवसायिक जहाजी-बेड़ा रिहिस। हर तीन बछर म ये जहाजी-बेड़ा ह एक बार सोन, चांदी अऊ हाथी-दांत ले बने सामान, अऊ बिगर पुंछीवाला बेंदरा अऊ आने किसम के बेंदरामन ला लेके लहुंटय।<verse eid="2CH 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 9:22" />राजा सुलेमान ह धन अऊ बुद्धि म धरती के आने जम्मो राजामन ले बढ़के रिहिस। <verse eid="2CH 9:22" /><verse number="23" style="v" sid="2CH 9:23" />धरती के जम्मो राजामन सुलेमान के बुद्धि के ओ बात ला सुने के ताक म रहंय, जेला परमेसर ह ओकर मन म डाले रिहिस। <verse eid="2CH 9:23" /><verse number="24" style="v" sid="2CH 9:24" />हर एक बछर, ओकर करा अवइयामन भेंट लेके आवंय—सोन अऊ चांदी के सामान, अऊ ओनहा, हथियार अऊ मसाला, अऊ घोड़ा अऊ खच्चरमन।<verse eid="2CH 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 9:25" />सुलेमान मेर घोड़ा अऊ रथमन बर चार हजार घुड़साल रिहिस, अऊ बारह हजार घोड़ामन रिहिन, जेमन ला ओह रथमन के सहर अऊ अपन संग यरूसलेम म भी रखे रिहिस। <verse eid="2CH 9:25" /><verse number="26" style="v" sid="2CH 9:26" />ओह फरात नदी ले पलिस्तीमन के देस, याने कि मिसर देस के सीमना तक जम्मो राजामन ऊपर सासन करिस। <verse eid="2CH 9:26" /><verse number="27" style="v" sid="2CH 9:27" />राजा ह यरूसलेम म चांदी ला पथरा के असन सधारन कर दीस, अऊ देवदार ला खाल्हे पहाड़ी के डूमर रूख असन बहुंत अकन कर दीस। <verse eid="2CH 9:27" /><verse number="28" style="v" sid="2CH 9:28" />सुलेमान के घोड़ामन मिसर अऊ आने जम्मो देस ले मंगाय जावत रिहिन।<verse eid="2CH 9:28" /></para>
  <para style="s1">सुलेमान के मिरतू</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 9:29" />सुलेमान के राज के आने घटनामन सुरू ले आखिरी तक, नातान अगमजानी के किताब म, सीलोवासी अहियाह के अगमबानी म, अऊ नबात के बेटा यरोबाम के बारे म इद्दो अगम-दरसी के दरसन म लिखे गे हवय। <verse eid="2CH 9:29" /><verse number="30" style="v" sid="2CH 9:30" />सुलेमान ह यरूसलेम म जम्मो इसरायल ऊपर चालीस साल तक राज करिस। <verse eid="2CH 9:30" /><verse number="31" style="v" sid="2CH 9:31" />तब ओह अपन पुरखामन संग हमेसा बर सुत गीस अऊ ओला ओकर ददा दाऊद के सहर म माटी दिये गीस। अऊ ओकर बेटा रहूबियाम ह ओकर जगह म राजा बनिस।<verse eid="2CH 9:31" /></para>
  <chapter eid="2CH 9" />
  <chapter number="10" style="c" sid="2CH 10" />
  <para style="s1">रहूबियाम के बिरूध इसरायल के बिदरोह</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 10:1" />रहूबियाम ह सकेम सहर गीस, काबरकि जम्मो इसरायलीमन ओला राजा बनाय बर उहां गे रिहिन। <verse eid="2CH 10:1" /><verse number="2" style="v" sid="2CH 10:2" />जब नबात के बेटा यरोबाम ह येला सुनिस (ओह मिसर देस म रिहिस, जिहां ओह राजा सुलेमान के डर म भागके गे रिहिस), त ओह मिसर ले लहुंट आईस। <verse eid="2CH 10:2" /><verse number="3" style="v" sid="2CH 10:3" />तब ओमन यरोबाम ला बलाय बर पठोईन, अऊ ओह अऊ जम्मो इसरायलीमन रहूबियाम मेर गीन अऊ ओकर ले कहिन: <verse eid="2CH 10:3" /><verse number="4" style="v" sid="2CH 10:4" />“तोर ददा ह हमर ऊपर एक भारी बोझा डाले रिहिस, पर अब तें हमर ऊपर डाले ओकर कठोर काम अऊ भारी बोझा ला हल्का कर, अऊ हमन तोर सेवा करबो।”<verse eid="2CH 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 10:5" />रहूबियाम ह जबाब दीस, “तीन दिन के बाद मोर करा लहुंटके आवव।” तब मनखेमन चल दीन।<verse eid="2CH 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 10:6" />तब राजा रहूबियाम ह ओ अगुवामन ले सलाह लीस, जेमन ओकर ददा सुलेमान के जिनगी भर सेवा करे रिहिन। ओह ओमन ले पुछिस, “तुम्हर का सलाह ए? ये मनखेमन ला का जबाब देना चाही।”<verse eid="2CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 10:7" />ओमन जबाब दीन, “यदि तें ये मनखेमन ऊपर दया करबे अऊ ओमन ला खुस रखबे अऊ अपन जबाब म बने बात कहिबे, त ओमन हमेसा तोर सेवक बने रहिहीं।”<verse eid="2CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 10:8" />पर रहूबियाम ह अगुवामन के सलाह ला नइं मानिस, अऊ ओ जवानमन ले सलाह लीस, जेमन ओकर संग बड़े होय रिहिन अऊ ओकर सेवा करत रिहिन। <verse eid="2CH 10:8" /><verse number="9" style="v" sid="2CH 10:9" />ओह ओमन ले पुछिस, “तुम्हर का सलाह ए? हमन ला ये मनखेमन ला कइसे जबाब देना चाही, जेमन मोर ले ये कहत हें, ‘जऊन बोझा तोर ददा ह हमर ऊपर डाले हवय, ओला हल्का कर’?”<verse eid="2CH 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 10:10" />ओकर संग बाढ़े जवान मनखेमन ओला जबाब दीन, “जऊन मनखेमन तोला कहे हवंय, ‘तोर ददा ह हमर ऊपर भारी बोझा डाले हवय, पर तें हमर बोझा ला हल्का कर।’ अब तें ओमन ला अइसने कह, ‘मोर छोटे अंगरी ह मोर ददा के कनिहां ले मोट हवय। <verse eid="2CH 10:10" /><verse number="11" style="v" sid="2CH 10:11" />मोर ददा ह तुम्हर ऊपर जऊन भारी बोझा डाले हवय; ओला मेंह अऊ भारी करहूं। मोर ददा ह तो तुमन ला कोर्रा म पीटवाईस; पर मेंह तुमन ला बिच्छूमन ले कटवाहूं।’ ”<verse eid="2CH 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 10:12" />तीन दिन के बाद यरोबाम अऊ जम्मो मनखेमन रहूबियाम करा वापिस आईन, जइसे कि राजा ह कहे रिहिस, “तीन दिन म मोर मेर वापिस आवव।” <verse eid="2CH 10:12" /><verse number="13" style="v" sid="2CH 10:13" />राजा ह ओमन ला कठोर जबाब दीस। अगुवामन के सलाह ला ठुकराके, <verse eid="2CH 10:13" /><verse number="14" style="v" sid="2CH 10:14" />ओह जवानमन के सलाह ला मानिस अऊ कहिस, “मोर ददा ह तुम्हर बोझा ला भारी कर दीस; मेंह येला अऊ भारी करहूं। मोर ददा ह तो तुमन ला कोर्रा म पीटवाईस; पर मेंह तुमन ला बिच्छूमन ले कटवाहूं।” <verse eid="2CH 10:14" /><verse number="15" style="v" sid="2CH 10:15" />ये किसम ले राजा ह मनखेमन के बात ला नइं सुनिस, काबरकि ये घटना ह परमेसर कोति ले ओ बचन ला पूरा करे बर होईस, जेला यहोवा ह सीलोवासी अहियाह अगमजानी के दुवारा नबात के बेटा यरोबाम ले कहे रिहिस।<verse eid="2CH 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 10:16" />जब जम्मो इसरायलीमन देखिन कि राजा ह ओमन के बात ला सुने ले इनकार कर दीस, तब ओमन राजा ला जबाब दीन:</para>
  <para style="q1" vid="2CH 10:16">“दाऊद म हमर का बांटा हवय,</para>
  <para style="q2" vid="2CH 10:16">यिसै के बेटा म का भाग हवय?</para>
  <para style="q1" vid="2CH 10:16">हे इसरायलीमन, अपन-अपन तम्बू म चले जावव!</para>
  <para style="q2" vid="2CH 10:16">हे दाऊद, अपन खुद के घर ला संभाल!”</para>
  <para style="m" vid="2CH 10:16">तब जम्मो इसरायलीमन अपन-अपन घर चल दीन। <verse eid="2CH 10:16" /><verse number="17" style="v" sid="2CH 10:17" />पर ओ इसरायली, जेमन यहूदा के नगरमन म रहत रिहिन, रहूबियाम ह ओमन ऊपर राज करते रिहिस।<verse eid="2CH 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 10:18" />राजा रहूबियाम ह अदोनीराम<note caller="+" style="f"><char style="fr" closed="false">10:18 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">हदोराम, </char><char style="ft" closed="false">जऊन ह </char><char style="fq" closed="false">अदोनीराम </char><char style="ft" closed="false">के आने नांव ए</char></note> ला भेजिस, जऊन ह बंधुवा मजदूरमन ऊपर मुखिया रिहिस, पर इसरायलीमन ओकर ऊपर पथरवाह करके ओला मार डारिन। पर राजा रहूबियाम ह कोनो किसम ले अपन रथ म चघिस अऊ बचके यरूसलेम भाग गीस। <verse eid="2CH 10:18" /><verse number="19" style="v" sid="2CH 10:19" />ये किसम ले इसरायलीमन आज तक ले दाऊद के घराना के बिरूध बिदरोह करत हें।<verse eid="2CH 10:19" /></para>
  <chapter eid="2CH 10" />
  <chapter number="11" style="c" sid="2CH 11" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 11:1" />जब रहूबियाम ह यरूसलेम हबरिस, त ओह यहूदा अऊ बिनयामीन के गोत्र ले एक लाख अस्सी हजार काबिल जवानमन ला संकेलिस कि ओमन इसरायल के बिरूध लड़े बर जावंय अऊ ओ राज ला रहूबियाम के अधीन फेर कर देवंय।<verse eid="2CH 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 11:2" />पर परमेसर के जन समायाह करा यहोवा के ये बचन आईस: <verse eid="2CH 11:2" /><verse number="3" style="v" sid="2CH 11:3" />“यहूदा के राजा सुलेमान के बेटा रहूबियाम अऊ यहूदा अऊ बिनयामीन के जम्मो इसरायलीमन ले कह, <verse eid="2CH 11:3" /><verse number="4" style="v" sid="2CH 11:4" />‘यहोवा ह ये कहत हे: अपन संगी इसरायलीमन के बिरूध लड़ई करे बर झन जावव। तुमन जम्मो झन अपन-अपन घर जावव, काबरकि येला मेंह करत हंव।’ ” ओमन यहोवा के बचन के पालन करिन अऊ यरोबाम के बिरूध हमला करे बिगर वापिस लहुंट गीन।<verse eid="2CH 11:4" /></para>
  <para style="s1">रहूबियाम ह यहूदा ला मजबूत करथे</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 11:5" />रहूबियाम ह यरूसलेम म रहत रिहिस, अऊ यहूदा म सुरकछा बर सहर बनवाईस: <verse eid="2CH 11:5" /><verse number="6" style="v" sid="2CH 11:6" />बैतलहम, एताम, तकोआ, <verse eid="2CH 11:6" /><verse number="7" style="v" sid="2CH 11:7" />बेत-सूर, सोको, अदुल्लाम, <verse eid="2CH 11:7" /><verse number="8" style="v" sid="2CH 11:8" />गत, मारेसा, जीप, <verse eid="2CH 11:8" /><verse number="9" style="v" sid="2CH 11:9" />अदोरैम, लाकीस, अजेका, <verse eid="2CH 11:9" /><verse number="10" style="v" sid="2CH 11:10" />सोरा, अय्यालोन अऊ हेबरोन। येमन यहूदा अऊ बिनयामीन के गढ़वाला सहर रिहिन। <verse eid="2CH 11:10" /><verse number="11" style="v" sid="2CH 11:11" />ओह अपन सुरकछा ला मजबूत करिस अऊ ओमन म सेनापतिमन ला ठहिराईस, ओमन बर उहां जेवन, जैतून तेल अऊ अंगूर के मंद के परबंध घलो कर दीस। <verse eid="2CH 11:11" /><verse number="12" style="v" sid="2CH 11:12" />ओह जम्मो सहरमन म ढाल अऊ बरछीमन ला रखवा दीस, अऊ ओमन ला बहुंत मजबूत बना दीस। ये किसम ले यहूदा अऊ बिनयामीन ओकर अधिकार म रिहिस।<verse eid="2CH 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 11:13" />इसरायल के जम्मो जिला के पुरोहित अऊ लेवीमन ओकर कोति हो गीन। <verse eid="2CH 11:13" /><verse number="14" style="v" sid="2CH 11:14" />अऊ त अऊ लेवीमन अपन चरागन अऊ धन-दौलत ला तियाग दीन अऊ यहूदा अऊ यरूसलेम म आईन, काबरकि यरोबाम अऊ ओकर बेटामन ओमन ला यहोवा के पुरोहित के रूप म ठुकरा दे रिहिन <verse eid="2CH 11:14" /><verse number="15" style="v" sid="2CH 11:15" />जब ओह ऊंच जगह बर अऊ अपन बनाय बोकरा अऊ बछवा के मूरतीमन बर अपन खुद के पुरोहितमन ला ठहिराईस। <verse eid="2CH 11:15" /><verse number="16" style="v" sid="2CH 11:16" />इसरायल के जम्मो गोत्र के मनखेमन, जेमन अपन हिरदय ला यहोवा, इसरायल के परमेसर के खोज म लगाईन, ओमन यहोवा, अपन पुरखामन के परमेसर ला बलिदान चघाय बर यरूसलेम म लेवीमन करा आईन। <verse eid="2CH 11:16" /><verse number="17" style="v" sid="2CH 11:17" />ओमन यहूदा के राज ला मजबूत करिन अऊ सुलेमान के बेटा रहूबियाम ला तीन साल ले समरथन करिन, अऊ ये समय के दौरान दाऊद अऊ सुलेमान के बताय रद्दा म चलिन।<verse eid="2CH 11:17" /></para>
  <para style="s1">रहूबियाम के परिवार</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 11:18" />रहूबियाम ह महलत ले बिहाव करिस, जऊन ह दाऊद के बेटा यरीमोत अऊ यिसै के बेटा एलीआब के बेटी अबीहैल के बेटी रिहिस। <verse eid="2CH 11:18" /><verse number="19" style="v" sid="2CH 11:19" />महलत के बेटामन यूस, समरयाह अऊ जाहम रिहिन। <verse eid="2CH 11:19" /><verse number="20" style="v" sid="2CH 11:20" />तब ओह अबसालोम के बेटी माका ले बिहाव करिस, जेकर ले अबियाह, अत्तै, जीजा, अऊ सलोमीत पईदा होईन। <verse eid="2CH 11:20" /><verse number="21" style="v" sid="2CH 11:21" />रहूबियाम ह अपन आने जम्मो घरवालीमन अऊ रखैलमन ले जादा अबसालोम के बेटी माका ले मया करत रिहिस। सबो मिलाके ओकर अठारह घरवाली अऊ साठ रखैलमन रिहिन, अऊ अठाईस बेटा अऊ साठ बेटीमन रिहिन।<verse eid="2CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 11:22" />रहूबियाम ह माका के बेटा अबियाह ला राजा बनाय बर, ओकर भाईमन के बीच म ओला राजकुमार के रूप म ठहिराईस। <verse eid="2CH 11:22" /><verse number="23" style="v" sid="2CH 11:23" />रहूबियाम ह समझदारी ले काम लीस, अपन कुछू बेटामन ला यहूदा अऊ बिनयामीन के जिलामन म अऊ गढ़वाला सहरमन म जिम्मेदारी दे दीस। ओह ओमन ला बहुंत अकन खाय-पीये के चीज दीस अऊ ओमन बर कतको घरवालीमन के परबंध करिस।<verse eid="2CH 11:23" /></para>
  <chapter eid="2CH 11" />
  <chapter number="12" style="c" sid="2CH 12" />
  <para style="s1">सीसक के यरूसलेम ऊपर हमला</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 12:1" />एकर बाद, जब राजा के रूप म रहूबियाम के पद ह स्थिर हो गीस अऊ ओह मजबूत हो गीस, त ओह अऊ ओकर संग जम्मो इसरायल ह यहोवा के कानून ला छोंड़ दीस। <verse eid="2CH 12:1" /><verse number="2" style="v" sid="2CH 12:2" />काबरकि ओमन यहोवा ले बिसवासघात करे रिहिन, मिसर के राजा सीसक ह राजा रहूबियाम के राज के पांचवां साल म यरूसलेम ऊपर हमला करिस। <verse eid="2CH 12:2" /><verse number="3" style="v" sid="2CH 12:3" />बारह सौ रथ अऊ साठ हजार घुड़सवार अऊ मिसर ले ओकर संग आय लिबियन, सुक्की अऊ कूसीमन<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">नील नदी के ऊपरी इलाका के मनखेमन</char></note> के अनगिनत सेनामन के संग, <verse eid="2CH 12:3" /><verse number="4" style="v" sid="2CH 12:4" />ओह यहूदा के गढ़वाला सहरमन म कब्जा कर लीस अऊ यरूसलेम तक पहुंच गीस।<verse eid="2CH 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 12:5" />तब अगमजानी समायाह ह रहूबियाम अऊ यहूदा के अगुवामन मेर आईस, जेमन सीसक ले डराके यरूसलेम म जूरे रिहिन, अऊ ओह ओमन ले कहिस, “यहोवा ह ये कहत हे, ‘तुमन मोला छोंड़ दे हवव; एकरसेति मेंह अब तुमन ला सीसक के हांथ म छोंड़ देवत हंव।’ ”<verse eid="2CH 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 12:6" />इसरायल के अगुवामन अऊ राजा ह अपनआप ला दीन करिन अऊ कहिन, “यहोवा धरमी अय।”<verse eid="2CH 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 12:7" />जब यहोवा ह देखिस कि ओमन अपनआप ला नम्र कर ले हवंय, त यहोवा के ये बचन ह समायाह मेर आईस: “ओमन अब अपनआप ला नम्र कर ले हवंय, त मेंह ओमन ला नास नइं करंव, अऊ जल्दी ही ओमन ला छुटकारा दूहूं। सीसक के जरिये मोर कोप यरूसलेम म नइं भड़कय। <verse eid="2CH 12:7" /><verse number="8" style="v" sid="2CH 12:8" />तभो ले, ओमन ओकर अधीन रहिहीं, ताकि ओमन मोर सेवा करई अऊ आने देसमन के राजा के सेवा करई म फरक ला समझ सकंय।”<verse eid="2CH 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 12:9" />जब मिसर के राजा सीसक ह यरूसलेम म हमला करिस, तब ओह यहोवा के मंदिर के खजाना अऊ राजमहल के खजाना ला उठाके ले गीस। ओह सबो चीज ला ले गीस, जेमा सुलेमान के बनाय सोन के ढालमन घलो रिहिन। <verse eid="2CH 12:9" /><verse number="10" style="v" sid="2CH 12:10" />एकरसेति राजा रहूबियाम ह ओमन के बदला म कांसा के ढालमन ला बनवाईस अऊ ये ढालमन ला पहरेदारमन के ओ सेनापतिमन ला सऊंप दीस, जेमन राजमहल के प्रवेस दुवार म पहरेदारी करत रिहिन। <verse eid="2CH 12:10" /><verse number="11" style="v" sid="2CH 12:11" />जब भी राजा ह यहोवा के मंदिर म जावय, तब पहरेदारमन ढालमन ला धरके चलंय, अऊ ओकर बाद ओमन ओ ढालमन ला पहरेदारमन के कमरा म लहुंटा देवंय।<verse eid="2CH 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 12:12" />काबरकि रहूबियाम ह अपनआप ला नम्र बना लीस, एकरसेति यहोवा के कोरोध ओकर ले हट गीस, अऊ ओह पूरा नास नइं होईस। वास्तव म, यहूदा म कुछू अछई रिहिस।<verse eid="2CH 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 12:13" />राजा रहूबियाम ह अपनआप ला यरूसलेम सहर म मजबूती ले इस्थिर कर लीस अऊ राजा के रूप म ओह सासन करते रिहिस। ओह इकतालीस बछर के रिहिस, जब ओह राजा बनिस, अऊ ओह यरूसलेम म सतरह साल ले राज करिस, ओ सहर जेला यहोवा ह इसरायल के जम्मो गोत्र म ले अपन नांव रखे बर चुने रिहिस। ओकर दाई के नांव नामा रिहिस; ओह एक अमोनी माईलोगन रिहिस। <verse eid="2CH 12:13" /><verse number="14" style="v" sid="2CH 12:14" />रहूबियाम ह बुरई के काम करिस, काबरकि ओह अपन हिरदय ला यहोवा के खोज म नइं लगाईस।<verse eid="2CH 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 12:15" />रहूबियाम के राज के घटनामन सुरू ले आखिरी तक, समायाह अगमजानी के किताब अऊ इद्दो अगम-दरसी के ओ किताबमन म लिखाय हवंय, जऊन ह बंसावली ले संबंध रखथे? रहूबियाम अऊ यरोबाम के बीच म लड़ई हमेसा होते रिहिस। <verse eid="2CH 12:15" /><verse number="16" style="v" sid="2CH 12:16" />रहूबियाम ह अपन पुरखामन संग हमेसा बर सुत गीस अऊ ओला दाऊद के सहर म माटी देय गीस। अऊ ओकर बेटा अबियाह ओकर जगह म राजा बनिस।<verse eid="2CH 12:16" /></para>
  <chapter eid="2CH 12" />
  <chapter number="13" style="c" sid="2CH 13" />
  <para style="s1">यहूदा के राजा अबियाह</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 13:1" />यरोबाम के राज के अठारहवां साल म, अबियाह ह यहूदा के राजा बनिस, <verse eid="2CH 13:1" /><verse number="2" style="v" sid="2CH 13:2" />अऊ ओह तीन साल तक यरूसलेम म राज करिस। ओकर दाई के नांव माका रिहिस, जऊन ह गिबा सहर के उरीएल के एक बेटी<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">नतनीन</char></note> रिहिस।</para>
  <para style="p" vid="2CH 13:2">अबियाह अऊ यरोबाम के बीच म लड़ई होईस। <verse eid="2CH 13:2" /><verse number="3" style="v" sid="2CH 13:3" />अबियाह ह चार लाख योग्य लड़नेवाला मनखेमन संग लड़ई म गीस, अऊ यरोबाम ह आठ लाख योग्य सैनिकमन संग ओकर बिरूध लड़ई करे बर पांति बांधिस।<verse eid="2CH 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 13:4" />अबियाह ह एपरैम के पहाड़ी देस म, समारैम पहाड़ म ठाढ़ होईस, अऊ कहिस, “यरोबाम अऊ जम्मो इसरायलीमन, मोर बात ला सुनव! <verse eid="2CH 13:4" /><verse number="5" style="v" sid="2CH 13:5" />का तुमन नइं जानव कि यहोवा, इसरायल के परमेसर ह इसरायल के राज ला दाऊद अऊ ओकर संतानमन ला हमेसा बर नून के करार के दुवारा दे देय हवय? <verse eid="2CH 13:5" /><verse number="6" style="v" sid="2CH 13:6" />तभो ले नबात के बेटा यरोबाम, जऊन ह दाऊद के बेटा सुलेमान के करमचारी रिहिस, अपन मालिक के बिरूध बिदरोह करिस। <verse eid="2CH 13:6" /><verse number="7" style="v" sid="2CH 13:7" />कुछू निकम्मा दुस्ट मनखेमन ओकर संग जूर गीन अऊ सुलेमान के बेटा रहूबियाम के बिरोध करिन, जब ओह लड़का अऊ अलहड़ मन के रिहिस अऊ अतेक मजबूत नइं रिहिस कि ओमन के सामना कर सकय।<verse eid="2CH 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 13:8" />“अऊ अब तुमन यहोवा के राज के बिरोध करे के योजना बनात हव, जऊन ह कि दाऊद के संतानमन के हांथ म हवय। तुमन वास्तव म एक बड़े सेना अव अऊ तुम्हर संग सोन के बछवामन हवंय, जेमन ला यरोबाम ह तुम्हर देवता होय बर बनाय हवय। <verse eid="2CH 13:8" /><verse number="9" style="v" sid="2CH 13:9" />पर का तुमन यहोवा के पुरोहित, हारून के बेटामन ला अऊ लेवीमन ला भगाके, अपन खुद के मनखेमन ला पुरोहित नइं बनाय हव, जइसे कि आने देस के मनखेमन करथें? जऊन ह भी अपन संग एक जवान बछवा अऊ सात ठन मेढ़ा लाके अपनआप ला पबितर करथे, ओह ओ चीजमन के पुरोहित बन जाथे, जेमन देवता नो हंय।<verse eid="2CH 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 13:10" />“जहां तक हमर बात ए, यहोवा ह हमर परमेसर ए, अऊ हमन ओला नइं तियागे हन। जऊन पुरोहितमन यहोवा के सेवा करथें, ओमन हारून के संतान अंय, अऊ लेवीमन ओमन के मदद करथें। <verse eid="2CH 13:10" /><verse number="11" style="v" sid="2CH 13:11" />रोज बिहनियां अऊ संझा के बेरा ओमन यहोवा ला होम-बलिदान अऊ खुसबूदार धूप चघाथें। ओमन संस्कारिक रूप ले साफ मेज म रोटी ला रखथें अऊ रोज सांझकुन सोन के दीवट म दीयामन ला बारथें। हमन यहोवा अपन परमेसर के आदेस के पालन करत हन। पर तुमन ओला तियाग दे हवव। <verse eid="2CH 13:11" /><verse number="12" style="v" sid="2CH 13:12" />परमेसर ह हमर संग हवय; ओह हमर अगुवा अय। ओकर पुरोहितमन अपन तुरही के संग तुम्हर बिरूध लड़ई के अवाज करहीं। हे इसरायल के मनखेमन, यहोवा, अपन पुरखामन के परमेसर के बिरूध लड़ई झन करव, काबरकि तुमन सफल नइं होहू।”<verse eid="2CH 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 13:13" />यरोबाम ह पाछू कोति सेनामन ला भेजे रिहिस, ताकि जब ओह यहूदा के आघू म रहय, त घात लगाके सेना ह ओमन के पाछू कोति ले हमला करय। <verse eid="2CH 13:13" /><verse number="14" style="v" sid="2CH 13:14" />यहूदा ह मुड़के देखिस कि ओमन ऊपर आघू अऊ पाछू दूनों कोति ले हमला होवत हे। तब ओमन यहोवा ला पुकारिन। पुरोहितमन अपन तुरही ला फूंकिन <verse eid="2CH 13:14" /><verse number="15" style="v" sid="2CH 13:15" />अऊ यहूदा के आदमीमन लड़ई बर ललकारिन, तब ओमन के लड़ई के ललकार ला सुनके, परमेसर ह यरोबाम अऊ जम्मो इसरायली ला अबियाह अऊ यहूदा के दुवारा हरवा दीस। <verse eid="2CH 13:15" /><verse number="16" style="v" sid="2CH 13:16" />इसरायलीमन यहूदा के आघू ले भाग गीन, अऊ परमेसर ह ओमन ला यहूदा के हांथ म कर दीस। <verse eid="2CH 13:16" /><verse number="17" style="v" sid="2CH 13:17" />अबियाह अऊ ओकर सेना ह ओमन के अब्बड़ नुकसान करिन, जेकर कारन इसरायल के योग्य आदमीमन ले पांच लाख बीर सैनिक मारे गीन। <verse eid="2CH 13:17" /><verse number="18" style="v" sid="2CH 13:18" />इसरायलीमन ओ समय बस म कर लिये गीन, अऊ यहूदा के मनखेमन बिजयी हो गीन, काबरकि ओमन यहोवा अपन पुरखामन के परमेसर के ऊपर भरोसा करिन।<verse eid="2CH 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 13:19" />अबियाह ह यरोबाम के पीछा करिस अऊ बेतेल, यसाना, अऊ एपरोन सहर ला ओमन के आसपास के गांव के संग ले लीस। <verse eid="2CH 13:19" /><verse number="20" style="v" sid="2CH 13:20" />अबियाह के राजकाल म यरोबाम के ताकत फेर नइं बढ़ पाईस। अऊ यहोवा ह ओला अइसे मारिस कि ओह मर गीस।<verse eid="2CH 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 13:21" />पर अबियाह ह ताकत म बढ़िस। ओह चौदह माईलोगन ले बिहाव करिस अऊ ओकर बीस झन बेटा अऊ सोलह बेटीमन रिहिन।<verse eid="2CH 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 13:22" />अबियाह के राज के आने घटनामन, जऊन कुछू ओह करिस अऊ कहिस, ओ जम्मो बात अगमजानी इद्दो के कथा म लिखे हवय।<verse eid="2CH 13:22" /></para>
  <chapter eid="2CH 13" />
  <chapter number="14" style="c" sid="2CH 14" />
  <para style="p">
    <note caller="+" style="f">
      <char style="fr" closed="false">14 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="2CH 14:1">14:1</ref></char> ला 13:23, अऊ <char style="xt"><ref loc="2CH 14:2-15">14:2‑15</ref></char> ला 14:1‑14 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="2CH 14:1" />अऊ अबियाह ह अपन पुरखामन संग हमेसा बर सुत गीस अऊ ओला दाऊद के सहर म माटी देय गीस। ओकर बेटा आसा ह ओकर जगह म राजा बनिस, अऊ ओकर राजकाल म देस ह दस साल तक सांति म रिहिस।<verse eid="2CH 14:1" /></para>
  <para style="s1">यहूदा के राजा आसा</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 14:2" />आसा ह ओही काम करिस, जऊन ह यहोवा अपन परमेसर के नजर म बढ़िया अऊ सही रिहिस। <verse eid="2CH 14:2" /><verse number="3" style="v" sid="2CH 14:3" />ओह परदेसी बेदीमन ला अऊ ऊंच जगहमन ला हटा दीस, पूजा के पथरामन ला कुटा-कुटा कर दीस अऊ असेरा के खंभामन ला काटके गिरा दीस। <verse eid="2CH 14:3" /><verse number="4" style="v" sid="2CH 14:4" />ओह यहूदा ला हुकूम दीस कि अपन पुरखा के यहोवा, परमेसर ला खोजव अऊ ओकर कानून अऊ हुकूम के पालन करव। <verse eid="2CH 14:4" /><verse number="5" style="v" sid="2CH 14:5" />ओह यहूदा के जम्मो सहर म ऊंच जगहमन ला अऊ धूप के बेदीमन ला हटा दीस, अऊ ओकर अधीन राज म सांति रिहिस। <verse eid="2CH 14:5" /><verse number="6" style="v" sid="2CH 14:6" />ओह यहूदा म गढ़वाला सहरमन ला बनाईस, काबरकि ओ देस म सांति रिहिस। ओ समय म कोनो भी ओकर संग लड़ई नइं करिन, काबरकि यहोवा ह ओला अराम दीस।<verse eid="2CH 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 14:7" />आसा ह यहूदा ले कहिस, “आवव, हमन ये सहरमन ला बनावन, अऊ ओमन के चारों कोति मीनार, दुवार अऊ बल्लीमन के संग दीवार घलो लगा देवन। देस ह अभी भी हमर अय, काबरकि हमन यहोवा अपन परमेसर ला खोजे हवन; हमन ओला खोजेंन अऊ ओह हमन ला सबो कोति ले अराम दे हवय।” एकरसेति ओमन सहरमन ला बनाईन अऊ उन्नति करिन।<verse eid="2CH 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 14:8" />आसा मेर यहूदा के तीन लाख आदमीमन के सेना रिहिस, जऊन मन बड़े-बड़े ढाल अऊ संग म बरछी घलो धरे रिहिन, अऊ बिनयामीन म ले दू लाख अस्सी हजार आदमी रिहिन, जेमन छोटे ढाल अऊ तीर-कमान धरे रिहिन। ये जम्मो झन बहादुर योद्धा रिहिन।<verse eid="2CH 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 14:9" />ओमन के बिरूध जेरह कूसी ह हजारों-हजार सेना अऊ तीन सौ रथमन ला लेके आईस, अऊ ओह मारेसा नगर तक आ गीस। <verse eid="2CH 14:9" /><verse number="10" style="v" sid="2CH 14:10" />आसा ह ओकर ले मिले बर निकलिस, अऊ ओमन मारेसा करा सापता के घाटी म लड़ई बर तियार होईन।<verse eid="2CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 14:11" />तब आसा ह यहोवा परमेसर ला दुहाई दीस अऊ कहिस, “हे यहोवा, बलसाली के बिरूध बलहीन के मदद करे बर तोर असन कोनो नइं ए। हमर मदद कर, हे यहोवा हमर परमेसर, काबरकि हमन तोर ऊपर भरोसा करथन, अऊ तोर नांव म हमन ये अब्बड़ अकन सेना के बिरूध आय हवन। हे यहोवा, तेंह हमर परमेसर अस; नासमान मनखेमन ला तोर बिरूध झन आवन देय।”<verse eid="2CH 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 14:12" />यहोवा ह आसा अऊ यहूदा के आघू म कूसीमन ला मारिस। कूसीमन भागिन, <verse eid="2CH 14:12" /><verse number="13" style="v" sid="2CH 14:13" />अऊ आसा अऊ ओकर सेना गरार नगर तक ओमन के पीछा करिन। कूसी सेना के अतेक संखिया म मनखेमन मारे गीन कि ओमन फेर उबर नइं सकिन; ओमन यहोवा अऊ ओकर सेना के आघू म कुचर दिये गीन। यहूदा के आदमीमन अब्बड़ अकन सामान लूटके ले लीन। <verse eid="2CH 14:13" /><verse number="14" style="v" sid="2CH 14:14" />ओमन गरार के आसपास के जम्मो गांवमन ला नास कर दीन, काबरकि यहोवा के डर ओमन ऊपर छा गे रिहिस। ओमन ये जम्मो गांव ला लूट लीन, काबरकि उहां अब्बड़ लूट के सामान रिहिस। <verse eid="2CH 14:14" /><verse number="15" style="v" sid="2CH 14:15" />ओमन चरवाहामन के डेरामन म घलो हमला करिन अऊ भेड़-बकरी अऊ ऊंट के झुंडमन ला ले गीन। तब ओमन यरूसलेम लहुंट गीन।<verse eid="2CH 14:15" /></para>
  <chapter eid="2CH 14" />
  <chapter number="15" style="c" sid="2CH 15" />
  <para style="s1">आसा दुवारा करे सुधार के काम</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 15:1" />परमेसर के आतमा ह ओदेद के बेटा अजरयाह म आईस। <verse eid="2CH 15:1" /><verse number="2" style="v" sid="2CH 15:2" />अजरयाह ह राजा आसा ले मिले बर गीस अऊ ओला कहिस, “हे आसा अऊ जम्मो यहूदा अऊ बिनयामीन के मनखेमन, मोर बात ला सुनव। यहोवा ह तुम्हर संग हवय, जब तुमन ओकर संग हवव। यदि तुमन ओला खोजथव, त ओह तुमन ला मिलही, पर यदि तुमन ओला तियाग देथव, त ओह घलो तुमन ला तियाग दीही। <verse eid="2CH 15:2" /><verse number="3" style="v" sid="2CH 15:3" />एक लम्बा समय तक, इसरायल ह बिगर सच्चा परमेसर के, बिगर सिखानेवाला पुरोहित के, अऊ बिगर कानून के रिहिस। <verse eid="2CH 15:3" /><verse number="4" style="v" sid="2CH 15:4" />पर जब ओमन अपन बिपत्ति म यहोवा, इसरायल के परमेसर करा लहुंटिन, अऊ ओला खोजिन, त ओह ओमन ला मिलिस। <verse eid="2CH 15:4" /><verse number="5" style="v" sid="2CH 15:5" />ओ दिन म, यातरा करई ह सुरकछित नइं रिहिस, काबरकि देस के जम्मो निवासीमन के बीच बहुंत उपदरव होवत रिहिस। <verse eid="2CH 15:5" /><verse number="6" style="v" sid="2CH 15:6" />एक जाति के मनखे आने जाति के मनखेमन ला अऊ एक सहर ह आने सहर दुवारा कुचरे जावत रिहिन, काबरकि परमेसर ह ओमन ऊपर हर किसम के बिपत्ति लानके ओमन ला दुख देवत रिहिस। <verse eid="2CH 15:6" /><verse number="7" style="v" sid="2CH 15:7" />पर जहां तक तुम्हर बात ए, तुमन मजबूत बनव अऊ हार झन मानव, काबरकि तुमन के काम के ईनाम तुमन ला मिलही।”<verse eid="2CH 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 15:8" />जब आसा ह ये बातमन ला अऊ ओदेद के बेटा अगमजानी अजरयाह के अगमबानी ला सुनिस, त ओह हिम्मत करिस। ओह यहूदा अऊ बिनयामीन के सबो जगह ले घिनौना मूरतीमन ला हटा दीस अऊ ओ नगरमन ले घलो हटा दीस, जेमन ला ओह एपरैम के पहाड़ी इलाका म कब्जा करे रिहिस। ओह यहोवा के बेदी के मरम्मत करिस, जऊन ह यहोवा के मंदिर के मंडप के आघू म रिहिस।<verse eid="2CH 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 15:9" />तब ओह जम्मो यहूदा अऊ बिनयामीन ला अऊ एपरैम, मनस्से अऊ सिमोन के मनखेमन ला संकेलिस, जऊन मन ओमन के बीच बस गे रिहिन, काबरकि इसरायल ले ओमन के एक बड़े संखिया म मनखेमन ओकर करा आ गे रिहिन, जब ओमन देखिन कि यहोवा ओकर परमेसर ह ओकर संग रहिथे।<verse eid="2CH 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 15:10" />ओमन आसा के राज के पंदरहवां साल के तीसरा महिना म यरूसलेम म जूरिन। <verse eid="2CH 15:10" /><verse number="11" style="v" sid="2CH 15:11" />ओही बेरा म ओमन यहोवा ला सात सौ पसु अऊ सात हजार भेड़ अऊ बकरी, जेला ओमन लूटके लाय रिहिन, बलिदान चघाईन। <verse eid="2CH 15:11" /><verse number="12" style="v" sid="2CH 15:12" />ओमन अपन पूरा हिरदय अऊ आतमा ले यहोवा, अपन पुरखामन के परमेसर के खोज म लगे रहे के एक करार करिन। <verse eid="2CH 15:12" /><verse number="13" style="v" sid="2CH 15:13" />ओ जम्मो मनखे, जेमन यहोवा, इसरायल के परमेसर के खोज नइं करहीं, ओमन मार डारे जाहीं, चाहे ओह कोनो भी छोटे या बड़े, आदमी या माईलोगन होवय। <verse eid="2CH 15:13" /><verse number="14" style="v" sid="2CH 15:14" />ओमन ऊंचहा अवाज म चिचियावत तुरही अऊ नरसिंगामन के अवाज के संग यहोवा ले एक सपथ खाईन। <verse eid="2CH 15:14" /><verse number="15" style="v" sid="2CH 15:15" />जम्मो यहूदा ह ये सपथ ला लेके आनंदित होईस, काबरकि ओमन पूरा हिरदय ले सपथ लेय रिहिन। ओमन उत्सुक होके परमेसर ला खोजिन, अऊ ओह ओमन ला मिलिस। तब यहोवा ह ओमन ला सबो तरफ ले अराम दीस।<verse eid="2CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 15:16" />राजा आसा ह अपन दादी माका ला घलो राज-माता के पद ले हटा दीस, काबरकि माका ह असेरा के अराधना करे बर एक घिनौना मूरती बनाय रिहिस। आसा ह ओला काटके कुटा-कुटा कर दीस अऊ ओला किदरोन घाटी म जला दीस। <verse eid="2CH 15:16" /><verse number="17" style="v" sid="2CH 15:17" />हालाकि ओह इसरायल ले ऊंचहा जगहमन ला नइं हटाईस, तभो ले आसा के मन ह पूरा जिनगी भर यहोवा ला समरपित रिहिस। <verse eid="2CH 15:17" /><verse number="18" style="v" sid="2CH 15:18" />जऊन सोन, चांदी अऊ सामानमन ला, ओ अऊ ओकर ददा अरपन करे रिहिन, ओ जम्मो ला ओह परमेसर के मंदिर म ले आईस।<verse eid="2CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 15:19" />आसा के राजकाल के पैंतीसवां साल तक कोनो लड़ई नइं होईस।<verse eid="2CH 15:19" /></para>
  <chapter eid="2CH 15" />
  <chapter number="16" style="c" sid="2CH 16" />
  <para style="s1">आसा के आखिरी साल</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 16:1" />आसा के राज के छत्तीसवां साल म, इसरायल के राजा बासा ह यहूदा के बिरूध गीस अऊ रामा नगर के किलाबंदी करिस ताकि यहूदा के राजा आसा के इलाका ले न तो कोनो निकल सकंय अऊ न ही कोनो ओकर राज म जा सकंय।<verse eid="2CH 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 16:2" />तब आसा ह सोन अऊ चांदी ला यहोवा के मंदिर अऊ अपन महल के खजानामन ले लीस अऊ अराम के राजा बेन-हदद करा पठो दीस, जऊन ह दमिस्क सहर म सासन करत रिहिस। <verse eid="2CH 16:2" /><verse number="3" style="v" sid="2CH 16:3" />अऊ ओह कहिस, “जइसने मोर ददा अऊ तोर ददा के बीच म करार होय रिहिस, वइसनेच मोर अऊ तोर बीच म घलो करार होवय। देख, मेंह तोर मेर सोन अऊ चांदी पठोवत हंव। एकरसेति तें इसरायल के राजा बासा के संग अपन करार ला टोर दे, ताकि ओह मोर करा ले पाछू हट जाय।”<verse eid="2CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 16:4" />बेन-हदद ह राजा आसा के बात ला मान लीस अऊ अपन सेना के सेनापतिमन ला इसरायल के नगरमन के बिरूध भेजिस। ओमन इयोन, दान, आबेल-मैम अऊ नपताली के जम्मो भंडारवाले सहरमन ला जीत लीन। <verse eid="2CH 16:4" /><verse number="5" style="v" sid="2CH 16:5" />जब बासा ह ये बात ला सुनिस, त ओह रामा सहर ला बनाय के काम ला रोक दीस अऊ ओह अपन ओ काम ला ही छोंड़ दीस। <verse eid="2CH 16:5" /><verse number="6" style="v" sid="2CH 16:6" />तब राजा आसा ह यहूदा के जम्मो मनखेमन ला संग म लीस अऊ ओमन रामा ले ओ पथरा अऊ इमारती लकड़ीमन ला ले गीन, जेमन के उपयोग बासा ह करत रिहिस। येमन ले ओह गेबा अऊ मिसपा सहरमन ला बनाईस।<verse eid="2CH 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 16:7" />ओही बेरा अगम-दरसी हनानी ह यहूदा के राजा आसा करा आके ओला कहिस: “काबरकि तेंह अराम के राजा ऊपर भरोसा करय अऊ यहोवा अपन परमेसर के ऊपर नइं, एकरसेति अराम के राजा के सेना ह तोर हांथ ले बचके निकल गीस। <verse eid="2CH 16:7" /><verse number="8" style="v" sid="2CH 16:8" />का कूसी अऊ लिबियनमन के सेना एक बड़े सेना नइं रिहिस? अऊ का ओमन करा बहुंत अकन रथ अऊ घुड़सवारमन<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सारथीमन</char></note> नइं रिहिन? तभो ले जब तेंह यहोवा ऊपर भरोसा करय, त ओह ओमन ला तोर हांथ म कर दीस। <verse eid="2CH 16:8" /><verse number="9" style="v" sid="2CH 16:9" />काबरकि यहोवा के आंखी ह पूरा धरती म रहिथे अऊ ओमन ला मजबूत करथे, जेमन के हिरदय ओकर बर पूरा समरपित रहिथे। तेंह एक मुरूखता के काम करे हस, एकरसेति अब ले तें लड़ई म फंसे रहिबे।”<verse eid="2CH 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 16:10" />आसा ह एकर कारन अगम-दरसी ऊपर गुस्सा होईस; ओह अतेक गुस्सा होईस कि ओह ओला जेल म डलवा दीस। ओही बेरा म आसा ह कुछू मनखेमन ऊपर निरदयी होके अतियाचार करे लगिस।<verse eid="2CH 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 16:11" />आसा के सासन के घटनामन सुरू ले आखिरी तक, यहूदा अऊ इसरायल के राजामन के किताब म लिखाय हवय। <verse eid="2CH 16:11" /><verse number="12" style="v" sid="2CH 16:12" />अपन राज के उन्चालीसवां साल म, आसा ह अपन गोड़ के एक बेमारी ले रोगी हो गीस। ओकर बेमारी ह गंभीर रिहिस, तभो ले ओह अपन बेमारी म घलो यहोवा ले मदद के मांग नइं करिस, पर ओह सिरिप बईदमन के मदद लीस। <verse eid="2CH 16:12" /><verse number="13" style="v" sid="2CH 16:13" />तब अपन राज के इकतालीसवां साल म, आसा ह मर गीस अऊ अपन पुरखामन संग हमेसा बर सुत गीस। <verse eid="2CH 16:13" /><verse number="14" style="v" sid="2CH 16:14" />ओमन ओला ओ कबर म माटी दीन, जेला ओह दाऊद के सहर म अपन बर काटके बनाय रिहिस। ओमन ओला मसाला अऊ नाना किसम के इतर मिलाय पेटी म रखिन, अऊ ओमन ओकर आदर म एक बहुंत बड़े कुढ़ा बनाके ओमा आगी लगाईन।<verse eid="2CH 16:14" /></para>
  <chapter eid="2CH 16" />
  <chapter number="17" style="c" sid="2CH 17" />
  <para style="s1">यहोसापात यहूदा के राजा</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 17:1" />आसा के जगह म ओकर बेटा यहोसापात ह राजा बनिस अऊ इसरायल के बिरूध अपनआप ला मजबूत करिस। <verse eid="2CH 17:1" /><verse number="2" style="v" sid="2CH 17:2" />ओह यहूदा के जम्मो गढ़वाला सहर म सेना के दलमन ला तैनात करिस अऊ यहूदा अऊ एपरैम के ओ सहरमन म सेना के छावनी डार दीस, जेमन ला ओकर ददा आसा ह कब्जा करे रिहिस।<verse eid="2CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 17:3" />यहोवा ह यहोसापात के संग रिहिस काबरकि ओह अपन पहिले याने कि अपन पुरखा दाऊद के रसता म चलिस। ओह बाल देवता ले कोनो सलाह नइं लीस <verse eid="2CH 17:3" /><verse number="4" style="v" sid="2CH 17:4" />पर अपन ददा के परमेसर के खोज करिस अऊ इसरायल के रीति-रिवाज म चले के बजाय परमेसर के हुकूममन के पालन करिस। <verse eid="2CH 17:4" /><verse number="5" style="v" sid="2CH 17:5" />यहोवा ह ओकर अधीन म राज ला स्थापित करिस; अऊ यहूदा के जम्मो झन यहोसापात करा भेंट लानिन, जेकर ले ओकर करा अब्बड़ धन-दौलत हो गीस अऊ ओकर आदरमान होईस। <verse eid="2CH 17:5" /><verse number="6" style="v" sid="2CH 17:6" />ओकर हिरदय ह यहोवा के रसता बर समरपित रिहिस; एकर अलावा, ओह यहूदा के ऊंच स्थानमन ला अऊ असेरा के खंभामन ला हटा दीस।<verse eid="2CH 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 17:7" />अपन राज के तीसर साल म, ओह अपन करमचारी बेन-हैल, ओबदयाह, जकरयाह, नतनेल अऊ मीकायाह ला यहूदा के सहरमन म पढ़ाय बर भेजिस। <verse eid="2CH 17:7" /><verse number="8" style="v" sid="2CH 17:8" />ओमन के संग कुछू लेवीमन—समायाह, नतनयाह, जबदयाह, असाहेल, समीरामोत, यहोनातान, अदोनियाह, तोबियाह अऊ तोब-अदोनियाह अऊ पुरोहितमन ले एलीसामा अऊ यहोराम रिहिन। <verse eid="2CH 17:8" /><verse number="9" style="v" sid="2CH 17:9" />अपन संग म यहोवा के कानून के किताब लेके ओमन पूरा यहूदा म सिकछा दीन; ओमन यहूदा के जम्मो सहरमन म गीन अऊ मनखेमन ला सिखाईन।<verse eid="2CH 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 17:10" />यहोवा के डर ह यहूदा के आसपास के देस के जम्मो राज म फईल गीस, जेकर कारन ओमन यहोसापात के बिरूध लड़ई म नइं गीन। <verse eid="2CH 17:10" /><verse number="11" style="v" sid="2CH 17:11" />कुछू पलिस्तीमन यहोसापात करा भेंट अऊ चांदी के रूप म राजकर लानिन, अऊ अरब के मनखेमन सात हजार सात सौ मेढ़ा अऊ सात हजार सात सौ बोकरामन के झुंड लानिन।<verse eid="2CH 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 17:12" />यहोसापात ह अऊ जादा ताकतवर होवत गीस; ओह गढ़मन ला अऊ यहूदा म भंडार सहरमन ला बनाईस <verse eid="2CH 17:12" /><verse number="13" style="v" sid="2CH 17:13" />अऊ यहूदा के सहरमन म जरूरी चीजमन के अब्बड़ भंडारन करके रखिस। ओह यरूसलेम म अनुभवी लड़ई करइया आदमीमन ला रखिस। <verse eid="2CH 17:13" /><verse number="14" style="v" sid="2CH 17:14" />परिवार के हिसाब से ओमन के गनती अइसन रिहिस:</para>
  <para style="b" vid="2CH 17:14" />
  <para style="li1" vid="2CH 17:14">यहूदा के गोत्र ले, 1,000 के दल के सेनापतिमन:</para>
  <para style="li2" vid="2CH 17:14">सेनापति अदना संग 3,00,000 लड़ई करइया आदमीमन;<verse eid="2CH 17:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="2CH 17:15" />ओकर बाद, सेनापति यहोहानान संग 2,80,000;<verse eid="2CH 17:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="2CH 17:16" />ओकर बाद, जिकरी के बेटा अमसयाह, जऊन ह स्वेच्छा से अपनआप ला यहोवा के सेवा बर देय दे रिहिस; ओकर संग 2,00,000 आदमी रिहिन।<verse eid="2CH 17:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="2CH 17:17" />बिनयामीन के गोत्र ले:</para>
  <para style="li2" vid="2CH 17:17">एलयादा, जऊन ह एक बीर सैनिक रिहिस, ओकर संग 2,00,000 हथियारबंद आदमी तीर-कमान अऊ ढालमन ला धरके रिहिन;<verse eid="2CH 17:17" /></para>
  <para style="li2">
    <verse number="18" style="v" sid="2CH 17:18" />ओकर बाद, यहोजाबाद के संग 1,80,000 हथियारबंद आदमी लड़ई बर रिहिन।<verse eid="2CH 17:18" /></para>
  <para style="b" />
  <para style="m">
    <verse number="19" style="v" sid="2CH 17:19" />येमन ओ आदमीमन रिहिन, जेमन राजा के सेवा करत रिहिन, येमन ओमन के अलावा रिहिन, जेमन ला राजा ह पूरा यहूदा के गढ़वाला सहरमन म तैनात करे रिहिस।<verse eid="2CH 17:19" /></para>
  <chapter eid="2CH 17" />
  <chapter number="18" style="c" sid="2CH 18" />
  <para style="s1">अहाब के बिरूध मीकायाह के अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 18:1" />यहोसापात करा अब्बड़ धन-दौलत अऊ मान-सम्मान हो गीस, अऊ ओह बिहाव करके अपन रिस्ता अहाब संग बना लीस। <verse eid="2CH 18:1" /><verse number="2" style="v" sid="2CH 18:2" />कुछू बछर के बाद, ओह सामरिया सहर म अहाब ला देखे बर गीस। अहाब ह ओकर अऊ ओकर संग के मनखेमन बर अब्बड़ अकन भेड़ अऊ पसु मारिस अऊ ओकर ले रामोत-गिलाद म हमला करे बर बिनती करिस। <verse eid="2CH 18:2" /><verse number="3" style="v" sid="2CH 18:3" />इसरायल के राजा अहाब ह यहूदा के राजा यहोसापात ले पुछिस, “का तेंह मोर संग रामोत-गिलाद के बिरूध जाबे?”</para>
  <para style="p" vid="2CH 18:3">यहोसापात ह जबाब दीस, “मेंह घलो तोर असन अंव, अऊ मोर मनखेमन तोर मनखेमन असन अंय; हमन लड़ई म तोर संग देबो।” <verse eid="2CH 18:3" /><verse number="4" style="v" sid="2CH 18:4" />पर यहोसापात ह इसरायल के राजा ला ये घलो कहिस, “पहिले यहोवा के ईछा ला मालूम कर ले।”<verse eid="2CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 18:5" />तब इसरायल के राजा ह अगमजानीमन ला इकट्ठा करिस—ओमन चार सौ आदमी रिहिन—अऊ राजा ह ओमन ले पुछिस, “का हमन रामोत-गिलाद के बिरूध लड़ई करे बर जावन या नइं?”</para>
  <para style="p" vid="2CH 18:5">ओमन जबाब दीन, “जावव, काबरकि परमेसर ह ओला राजा के हांथ म कर दीही।”<verse eid="2CH 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 18:6" />पर यहोसापात ह पुछिस, “का इहां यहोवा के कोनो अगमजानी नइं अंय, जेकर ले हमन पुछताछ कर सकन?”<verse eid="2CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 18:7" />इसरायल के राजा ह यहोसापात ला जबाब दीस, “इहां अभी भी एक अगमजानी हवय, जेकर जरिये हमन यहोवा ले पुछताछ कर सकत हन, पर मेंह ओकर ले घिन करथंव, काबरकि ओह कभू भी मोर बारे म कोनो बने बात के अगमबानी नइं करय, पर हमेसा खराप बात ही कहिथे। ओह यिमला के बेटा मीकायाह ए।”</para>
  <para style="p" vid="2CH 18:7">यहोसापात ह कहिस, “राजा ला अइसन बात नइं कहना चाही।”<verse eid="2CH 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 18:8" />तब इसरायल के राजा ह अपन एक करमचारी ला बलाके कहिस, “यिमला के बेटा मीकायाह ला अभीचे लेके आवव।”<verse eid="2CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 18:9" />इसरायल के राजा अऊ यहूदा के राजा यहोसापात अपन राजसी कपड़ा पहिरे, सामरिया के प्रवेस दुवार के बगल म एक कोठार म अपन सिंघासन म बईठे रहंय, अऊ जम्मो अगमजानीमन ओमन के आघू म अगमबानी करत रहंय। <verse eid="2CH 18:9" /><verse number="10" style="v" sid="2CH 18:10" />कनाना के बेटा सिदकियाह ह लोहा के सींग बनाय रिहिस अऊ ओह घोसना करिस, “यहोवा ह ये कहत हे: ‘ये सींगमन ले तुमन अरामीमन ला अइसन मारहू कि ओमन नास हो जाहीं।’ ”<verse eid="2CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 18:11" />आने जम्मो अगमजानीमन घलो येहीच अगमबानी करत रिहिन। ओमन कहिन, “रामोत-गिलाद ऊपर हमला करव अऊ जीत जावव, काबरकि यहोवा ह ओला राजा के हांथ म कर दीही।”<verse eid="2CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 18:12" />जऊन संदेसिया ह मीकायाह ला बलाय बर गे रिहिस, ओह ओकर ले कहिस, “देख, आने अगमजानीमन बिगर कोनो आपत्ति के राजा बर सफलता के अगमबानी करत हवंय। तोर बात ह घलो ओमन के बात ले मेल खावय, अऊ तें राजा के हित म गोठियाबे।”<verse eid="2CH 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 18:13" />पर मीकायाह ह कहिस, “यहोवा के जिनगी के सपथ, मेंह ओला सिरिप ओही बात बताहूं, जेला मोर परमेसर ह कहिही।”<verse eid="2CH 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 18:14" />जब मीकायाह ह उहां हबरिस, त राजा ह ओकर ले पुछिस, “हे मीकायाह, का हमन रामोत-गिलाद के बिरूध लड़ई करे बर जावन या नइं?”</para>
  <para style="p" vid="2CH 18:14">ओह जबाब दीस, “हमला करव अऊ जीत जावव, काबरकि ओमन तोर हांथ म दे दिये जाहीं।”<verse eid="2CH 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 18:15" />राजा ह ओला कहिस, “मेंह तोला कतेक बार कसम खवावंव कि यहोवा के नांव म मोला सिरिप सच्चई के छोंड़ अऊ कुछू बात झन बता?”<verse eid="2CH 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 18:16" />तब मीकायाह ह जबाब दीस, “मेंह जम्मो इसरायल ला पहाड़ीमन म बिगर चरवाहा के बगरे भेड़मन सहीं देखेंव, अऊ यहोवा ह कहिस, ‘ये मनखेमन के कोनो मालिक नइं एं। हर एक जन सांति से अपन घर जावय।’ ”<verse eid="2CH 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 18:17" />इसरायल के राजा ह यहोसापात ला कहिस, “का मेंह तोला नइं कहे रहेंव कि ओह मोर बारे म कभू बने अगमबानी नइं करय, पर सिरिप खराप बात कहिथे?”<verse eid="2CH 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 18:18" />मीकायाह ह आगे कहिस, “एकरसेति यहोवा के बचन ला सुनव: मेंह यहोवा ला अपन सिंघासन म बईठे अऊ ओकर संग स्वरग के जम्मो भीड़ ला ओकर जेवनी अऊ डेरी कोति खड़े देखेंव। <verse eid="2CH 18:18" /><verse number="19" style="v" sid="2CH 18:19" />अऊ यहोवा ह कहिस, ‘कोन ह इसरायल के राजा अहाब ला रामोत-गिलाद ऊपर हमला करे बर अऊ उहां जाके मरे बर बहकाही?’</para>
  <para style="p" vid="2CH 18:19">“कोनो ह कुछू सलाह दीस, त कोनो ह कुछू अऊ। <verse eid="2CH 18:19" /><verse number="20" style="v" sid="2CH 18:20" />आखिर म, एक आतमा आघू म आके यहोवा के आघू म ठाढ़ होईस अऊ कहिस, ‘मेंह ओला बहकाहूं।’</para>
  <para style="p" vid="2CH 18:20">“यहोवा ह पुछिस, ‘कोन तरीका ले?’<verse eid="2CH 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 18:21" />“ओ आतमा ह कहिस, ‘मेंह जाहूं अऊ ओकर जम्मो अगमजानीमन के मुहूं म एक धोखा देवइया आतमा बनहूं।’</para>
  <para style="p" vid="2CH 18:21">“यहोवा ह कहिस, ‘तेंह ओला बहकाय म सफल होबे। जा अऊ येला कर।’<verse eid="2CH 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 18:22" />“एकरसेति अब यहोवा ह तोर ये अगमजानीमन के मुहूं म एक धोखा देवइया आतमा डाल दे हवय। यहोवा ह तोर बिनास के हुकूम दे हवय।”<verse eid="2CH 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 18:23" />तब कनाना के बेटा सिदकियाह ह ऊपर मीकायाह करा गीस अऊ ओकर गाल म थपरा मारके पुछिस, “कते रसता ले आतमा ह यहोवा करा ले गीस, जब ओह तोर ले गोठियाय बर मोर करा ले निकलके गीस?”<verse eid="2CH 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 18:24" />मीकायाह ह जबाब दीस, “तोला ओ दिन ये बात के पता चलही, जब तेंह लुकाय बर एक भीतरी कमरा म जाबे।”<verse eid="2CH 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 18:25" />तब इसरायल के राजा ह हुकूम दीस, “मीकायाह ला ले जावव अऊ ओला सहर के हाकिम आमोन अऊ राजा के बेटा योआस करा वापिस भेज दव, <verse eid="2CH 18:25" /><verse number="26" style="v" sid="2CH 18:26" />अऊ कहव, ‘राजा ह ये कहत हे: ये मनखे ला जेल म डाल दव अऊ जब तक मेंह सही-सलामत वापिस नइं लहुंटंव, तब तक येला रोटी अऊ पानी के छोंड़ अऊ कुछू झन दव।’ ”<verse eid="2CH 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 18:27" />मीकायाह ह घोसना करिस, “यदि तेंह सही-सलामत लहुंटके आ जाबे, त फेर यहोवा ह मोर जरिये बात नइं करे हवय।” तब ओह ये घलो कहिस, “तुमन जम्मो मनखेमन, मोर बात ला धियान म रखव!”<verse eid="2CH 18:27" /></para>
  <para style="s1">रामोत-गिलाद म अहाब के मऊत</para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 18:28" />इसरायल के राजा अऊ यहूदा के राजा यहोसापात, ऊपर रामोत-गिलाद गीन। <verse eid="2CH 18:28" /><verse number="29" style="v" sid="2CH 18:29" />इसरायल के राजा ह यहोसापात ला कहिस, “मेंह भेस बदलके लड़ई म जाहूं, पर तें अपन राजसी पहिरावा पहिरबे।” तब इसरायल के राजा ह अपन भेस ला बदल लीस अऊ लड़ई म गीस।<verse eid="2CH 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CH 18:30" />अराम के राजा ह अपन रथ के सेनापतिमन ला हुकूम देय रिहिस, “इसरायल के राजा के छोंड़, अऊ कोनो छोटे या बड़े मनखे ले लड़ई झन करहू।” <verse eid="2CH 18:30" /><verse number="31" style="v" sid="2CH 18:31" />जब रथ के सेनापतिमन यहोसापात ला देखिन, त ओमन सोचिन, “येह इसरायल के राजा अय।” एकरसेति ओमन ओकर ऊपर हमला करे बर मुड़िन, पर यहोसापात ह चिचियाईस, अऊ यहोवा ह ओकर मदद करिस। परमेसर ह ओमन ला ओकर से दूरिहा कर दीस, <verse eid="2CH 18:31" /><verse number="32" style="v" sid="2CH 18:32" />काबरकि जब रथ के सेनापतिमन देखिन कि ओह इसरायल के राजा नो हय, तब ओमन ओकर पीछा करई छोंड़ दीन।<verse eid="2CH 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2CH 18:33" />पर कोनो मनखे ह बिगर सोचे-बिचारे अपन तीर ला चला दीस अऊ ओ तीर ह इसरायल के राजा के छाती के कवच अऊ कमरबंध के बीच म लगिस। तब राजा ह रथ के सारथी ला कहिस, “मेंह घायल हो गे हवंव। रथ ला एती-ओती घुमाके मोला लड़ई ले बाहिर निकाल।” <verse eid="2CH 18:33" /><verse number="34" style="v" sid="2CH 18:34" />पूरा दिन भयंकर लड़ई होते रिहिस, अऊ इसरायल के राजा ह अपन रथ के सहारा म संझा तक अरामीमन कोति मुहूं करके ठाढ़े रिहिस। तब बेर बुड़े के बेरा ओह मर गीस।<verse eid="2CH 18:34" /></para>
  <chapter eid="2CH 18" />
  <chapter number="19" style="c" sid="2CH 19" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 19:1" />जब यहूदा के राजा यहोसापात ह यरूसलेम म अपन महल म सुरकछित लहुंट आईस, <verse eid="2CH 19:1" /><verse number="2" style="v" sid="2CH 19:2" />हनानी के बेटा, येहू अगम-दरसी ह ओकर ले मिले बर बाहिर गीस अऊ राजा ले कहिस, “का तोला ओ दुस्टमन के मदद अऊ ओमन ले मया करना चाही, जेमन यहोवा ले घिन करथें? एकर कारन यहोवा के कोप ह तोर ऊपर हवय। <verse eid="2CH 19:2" /><verse number="3" style="v" sid="2CH 19:3" />हालाकि, तोर म कुछू बने बात भी हवय, काबरकि तेंह असेरा के खंभामन ला देस ले हटा दे हस अऊ अपन हिरदय ला परमेसर के खोज म लगाय हस।”<verse eid="2CH 19:3" /></para>
  <para style="s1">यहोसापात ह नियायधीसमन ला ठहिराथे</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 19:4" />यहोसापात ह यरूसलेम म रहत रिहिस, अऊ ओह फेर बेरसेबा सहर ले लेके एपरैम के पहाड़ी देस के मनखेमन के बीच म गीस अऊ ओह ओमन ला फेर से वापिस यहोवा, ओमन के पुरखा के परमेसर कोति ले आईस। <verse eid="2CH 19:4" /><verse number="5" style="v" sid="2CH 19:5" />ओह देस म, यहूदा के हर एक गढ़वाला सहर म नियायधीसमन ला ठहिराईस। <verse eid="2CH 19:5" /><verse number="6" style="v" sid="2CH 19:6" />यहोसापात ह ओमन ला कहिस, “धियान देवव कि तुमन का करथव, काबरकि तुमन मरनहार मनखेमन बर नियाय नइं करत हव, पर यहोवा बर नियाय करत हव, जऊन ह तुम्हर संग हवय, जब भी तुमन कोनो फैसला करथव। <verse eid="2CH 19:6" /><verse number="7" style="v" sid="2CH 19:7" />अब यहोवा के भय तुमन ऊपर रहय। धियान से नियाय करव, काबरकि यहोवा हमर परमेसर के संग कोनो अनियाय अऊ पखियपात या घूसखोरी के लेना-देना नइं ए।”<verse eid="2CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 19:8" />यरूसलेम म घलो, यहोसापात ह कुछू लेवी, पुरोहितमन अऊ इसरायली परिवारमन के मुखियामन ला यहोवा के कानून के पालन करे बर अऊ बाद-बिबाद के निपटारा करे बर ठहिराईस। अऊ ओमन यरूसलेम म रहत रिहिन। <verse eid="2CH 19:8" /><verse number="9" style="v" sid="2CH 19:9" />ओह ओमन ला ये हुकूम दीस: “तुमन यहोवा के भय म रहिके पूरा बिसवासयोग्यता अऊ दिल से सेवा करव। <verse eid="2CH 19:9" /><verse number="10" style="v" sid="2CH 19:10" />हर ओ मामला ला, जेला तुम्हर सहर के रहइया मनखेमन तुम्हर आघू म लाथें—चाहे ओह हतिया के हो या ब्यवस्था, हुकूम, बिधि या नियममन के कोनो आने मामला हो—तुमन ओमन ला चेता देवव कि ओमन यहोवा के बिरूध पाप झन करंय; नइं तो ओकर कोरोध तुम्हर अऊ तुम्हर मनखेमन ऊपर आही। अइसने करव, अऊ तुमन पाप नइं करहू।<verse eid="2CH 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 19:11" />“यहोवा ले संबंधित कोनो भी बिसय म मुखिया पुरोहित अमरयाह ह तुम्हर ऊपर होही, अऊ राजा ले संबंधित कोनो बिसय म यहूदा के गोत्र के अगुवा, इसमायल के बेटा जबदयाह ह तुम्हर ऊपर होही, अऊ लेवीमन तुम्हर आघू म करमचारीमन के रूप म सेवा करहीं। हिम्मत के संग काम करव, अऊ यहोवा ह ओमन के संग रहय, जेमन बने बुता करथें।”<verse eid="2CH 19:11" /></para>
  <chapter eid="2CH 19" />
  <chapter number="20" style="c" sid="2CH 20" />
  <para style="s1">यहोसापात ह मोआब अऊ अमोनीमन ला हराथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 20:1" />एकर बाद, मोआबी अऊ अमोनीमन कुछू मूनीमन संग राजा यहोसापात के बिरूध लड़ई करे बर आईन।<verse eid="2CH 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 20:2" />कुछू मनखेमन यहोसापात करा आके बताईन, “एदोम ले, मिरतू सागर के ओ पार ले तोर बिरूध एक बड़े सेना आवत हे। येमन पहिली ले हससोन-तामार म हवंय” (मतलब कि एन-गदी म हवंय)। <verse eid="2CH 20:2" /><verse number="3" style="v" sid="2CH 20:3" />यहोसापात ह सचेत होके एकर बारे म यहोवा के ईछा जाने बर ठान लीस, अऊ जम्मो यहूदा म उपास रखे के घोसना करिस। <verse eid="2CH 20:3" /><verse number="4" style="v" sid="2CH 20:4" />यहूदा के मनखेमन यहोवा ले मदद के आसा करत एक संग जूरिन; वास्तव म, ओमन यहूदा के हर एक सहर ले ओकर ईछा जाने बर आईन।<verse eid="2CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 20:5" />तब यहोसापात ह यहूदा अऊ यरूसलेम के सभा म यहोवा के मंदिर मेर नवां अंगना के आघू म ठाढ़ होईस। <verse eid="2CH 20:5" /><verse number="6" style="v" sid="2CH 20:6" />अऊ पराथना करिस:</para>
  <para style="pm" vid="2CH 20:6">“हे यहोवा, हमर पुरखामन के परमेसर, का तें स्वरग म रहइया परमेसर नो हस? तेंह देस-देस के जम्मो राज ऊपर सासन करथस। सामर्थ अऊ ताकत तोर हांथ म हवय, अऊ कोनो भी तोर सामना नइं कर सकंय। <verse eid="2CH 20:6" /><verse number="7" style="v" sid="2CH 20:7" />हे हमर परमेसर, का तेंह अपन मनखे इसरायल के आघू ले ये देस के रहइयामन ला बाहिर निकालके अपन संगवारी अब्राहम के संतानमन ला नइं देय दे हस? <verse eid="2CH 20:7" /><verse number="8" style="v" sid="2CH 20:8" />ओमन येमा निवास करिन अऊ येमा तोर नांव बर ये कहत एक पबितर-स्थान बनाईन, <verse eid="2CH 20:8" /><verse number="9" style="v" sid="2CH 20:9" />‘यदि हमर ऊपर बिपत्ति आथे, चाहे नियाय के तलवार होवय, या महामारी या अकाल, हमन ये मंदिर के आघू म ठाढ़ होबो, जऊन ह तोर नांव म बने हवय, अऊ अपन दुख म तोर आघू म रोबो, अऊ तेंह हमर रोवई ला सुनके हमन ला बचाबे।’<verse eid="2CH 20:9" /></para>
  <para style="pm">
    <verse number="10" style="v" sid="2CH 20:10" />“पर अब इहां अमोन, मोआबी अऊ सेईर पहाड़ के मनखेमन, जेमन के राज म तेंह इसरायल ला जब ओमन मिसर ले आवत रिहिन, तेंह हमला करे के अनुमति नइं देय; एकरसेति ओमन उहां ले मुड़के चल दीन अऊ ओमन ला नास नइं करिन। <verse eid="2CH 20:10" /><verse number="11" style="v" sid="2CH 20:11" />देख कि ओमन कइसन हमन ला ओ जगह ले बाहिर निकाले बर आके बदला लेवत हवंय, जेला तेंह हमन ला उत्तराधिकार म दे हस। <verse eid="2CH 20:11" /><verse number="12" style="v" sid="2CH 20:12" />हे हमर परमेसर, का तेंह ओमन के काम के नियाय नइं करस? काबरकि हमर करा ये बड़े सेना के सामना करे के कोनो सक्ति नइं ए, जऊन ह हमर ऊपर हमला करत हवय। हमन नइं जानन कि हमन ला का करना हे, पर हमर आंखी तोर ऊपर लगे हवय।”<verse eid="2CH 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 20:13" />यहूदा के जम्मो मनखेमन, अपन घरवाली अऊ लइका अऊ कोरा के लइकामन संग, उहां यहोवा के आघू म खड़े रिहिन।<verse eid="2CH 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 20:14" />ओही बेरा यहोवा के आतमा ह यहजीएल के ऊपर आईस, ओह सभा म ठाढ़ होईस। ओह जकरयाह के बेटा, ओह बनायाह के बेटा, ओह येइल के बेटा, ओह मतनयाह के बेटा, जऊन ह एक लेवी अऊ आसाप के संतान रिहिस।<verse eid="2CH 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 20:15" />यहजीएल ह कहिस: “सुनव, राजा यहोसापात अऊ ओ जम्मो, जेमन यहूदा अऊ यरूसलेम म रहिथें! यहोवा ह तुमन ले ये कहत हे: ‘ये बड़े सेना के कारन तुमन झन डरव या हतास झन होवव। काबरकि लड़ई तुम्हर नइं, पर परमेसर के अय। <verse eid="2CH 20:15" /><verse number="16" style="v" sid="2CH 20:16" />कल ओमन के बिरूध हमला करव। ओमन सीस के चढ़ई म चढ़हीं, अऊ तुमन ओमन ला यरूएल के मरू-भुइयां के संकरी घाटी के आखिरी म पाहू। <verse eid="2CH 20:16" /><verse number="17" style="v" sid="2CH 20:17" />तुमन ला ये लड़ई लड़े बर नइं पड़य। अपन-अपन जगह ले लव; मजबूती से खड़े रहव अऊ यहोवा ह तुमन ला, यहूदा ला अऊ यरूसलेम ला जऊन छुटकारा दीही, ओला देखव। झन डरव; हतास झन होवव। कल ओमन के सामना करे बर बाहिर निकलव, अऊ यहोवा ह तुम्हर संग रहिही।’ ”<verse eid="2CH 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 20:18" />यहोसापात ह अपन मुड़-भरसा हो गीस, अऊ यहूदा अऊ यरूसलेम के जम्मो मनखेमन यहोवा के आघू म दंडवत करे बर मुड़-भरसा हो गीन। <verse eid="2CH 20:18" /><verse number="19" style="v" sid="2CH 20:19" />तब कहाती अऊ कोरहीमन के कुछू लेवीमन ठाढ़ हो गीन अऊ ऊंचहा अवाज म यहोवा, इसरायल के परमेसर के परसंसा करिन।<verse eid="2CH 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 20:20" />बड़े बिहनियां ओमन तकोआ के बंजर भुइयां करा जाय बर निकलिन। जब ओमन निकलिन, त यहोसापात ह ठाढ़ होईस अऊ कहिस, “हे यहूदा अऊ यरूसलेम के मनखेमन, मोर बात ला सुनव! यहोवा अपन परमेसर ऊपर भरोसा रखव अऊ तुमन बने रहिहू; ओकर अगमजानीमन ऊपर बिसवास रखव अऊ तुमन सफल होहू।” <verse eid="2CH 20:20" /><verse number="21" style="v" sid="2CH 20:21" />यहोसापात ह मनखेमन ले सलाह लेय के बाद, पुरूसमन ला यहोवा के गीत गाय बर चुनिस, ताकि ओमन ओकर पबितरता के सोभा बर सेना के आघू-आघू रेंगत ये कहिके परसंसा करंय:</para>
  <para style="q1" vid="2CH 20:21">“यहोवा के धनबाद करव,</para>
  <para style="q2" vid="2CH 20:21">काबरकि ओकर मया हमेसा बने रहिथे।”<verse eid="2CH 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 20:22" />जब ओमन गीत गाय के अऊ परसंसा करे के सुरू करिन, त यहोवा ह यहूदा ऊपर हमला करइया अमोनी अऊ मोआबी अऊ सेईर पहाड़ के मनखेमन के बिरूध घात लगा दीस, अऊ ओमन हार गीन। <verse eid="2CH 20:22" /><verse number="23" style="v" sid="2CH 20:23" />अमोनी अऊ मोआबीमन सेईर पहाड़ के मनखेमन ला नास करे बर ओमन के बिरूध खड़े हो गीन। सेईर के आदमीमन ला मार डारे के बाद, ओमन एक-दूसर ला मारे बर मदद करिन।<verse eid="2CH 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 20:24" />जब यहूदा के मनखेमन ओ जगह म आईन, जिहां ले सुन्ना जगह ह दिखथे अऊ ओ बड़े सेना कोति देखिन, त ओमन ला भुइयां म परे मनखेमन के सिरिप लास ही लास दिखिस; कोनो भी नइं बचे रिहिन। <verse eid="2CH 20:24" /><verse number="25" style="v" sid="2CH 20:25" />तब यहोसापात अऊ ओकर मनखेमन ओमन के लूट के सामान लेय बर गीन, अऊ ओमन उहां अब्बड़ अकन साज-सामान अऊ कपड़ा अऊ कीमती चीजमन ला पाईन—अतेक जादा सामान कि ओमन ले जा नइं सकत रिहिन। उहां अतेक जादा लूट के सामान रिहिस कि ओला संकेलत तीन दिन लग गीस। <verse eid="2CH 20:25" /><verse number="26" style="v" sid="2CH 20:26" />चौथा दिन ओमन बराका के घाटी म जूरिन, अऊ उहां ओमन यहोवा के परसंसा करिन। एकरसेति येला आज तक बराका<note caller="+" style="f"><char style="fr" closed="false">20:26 </char><char style="fq" closed="false">बराका </char><char style="ft" closed="false">के मतलब होथे </char><char style="fq" closed="false">परसंसा</char></note> के घाटी कहे जाथे।<verse eid="2CH 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 20:27" />तब, यहोसापात के अगुवई म, यहूदा अऊ यरूसलेम के जम्मो आदमीमन अब्बड़ खुसी से यरूसलेम ला लहुंट गीन, काबरकि यहोवा ह ओमन ला ओमन के बईरीमन ऊपर आनंदित होय के कारन देय रिहिस। <verse eid="2CH 20:27" /><verse number="28" style="v" sid="2CH 20:28" />ओमन यरूसलेम म आईन अऊ बीना अऊ सारंगी अऊ तुरहीमन के संग यहोवा के मंदिर म गीन।<verse eid="2CH 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 20:29" />आसपास के जम्मो राजमन म परमेसर के भय छा गीस, जब ओमन सुनिन कि कइसे यहोवा ह इसरायल के बईरीमन के बिरूध लड़ई लड़े हवय। <verse eid="2CH 20:29" /><verse number="30" style="v" sid="2CH 20:30" />अऊ यहोसापात के राज म सांति रिहिस, काबरकि ओकर परमेसर ह ओला सबो डहार ले बिसराम देय रिहिस।<verse eid="2CH 20:30" /></para>
  <para style="s1">यहोसापात के सासन के अन्त</para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 20:31" />यहोसापात ह यहूदा म सासन करिस। जब ओह यहूदा के राजा बनिस, त ओह पैंतीस साल के रिहिस अऊ ओह पच्चीस साल तक यरूसलेम म राज करिस। ओकर दाई के नांव अजूबा रिहिस, जऊन ह सिलही के बेटी रिहिस। <verse eid="2CH 20:31" /><verse number="32" style="v" sid="2CH 20:32" />ओह अपन ददा आसा के रसता म चलिस अऊ ओमन ले नइं हटिस; ओह ओही काम करिस, जऊन ह यहोवा के नजर म सही रिहिस। <verse eid="2CH 20:32" /><verse number="33" style="v" sid="2CH 20:33" />तभो ले, ऊंचहा जगहमन हटाय नइं गीन, अऊ मनखेमन अभी घलो अपन पुरखामन के परमेसर म अपन मन ला नइं लगाय रिहिन।<verse eid="2CH 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 20:34" />यहोसापात के सासन के आने घटनामन, सुरू ले आखिरी तक, हनानी के बेटा, येहू के इतिहास के किताब म लिखे गे हवय, जेमन ला इसरायल के राजामन के किताब म अंकित करे गे हवय।<verse eid="2CH 20:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2CH 20:35" />बाद म, यहूदा के राजा यहोसापात ह इसरायल के राजा अहजयाह के संग संधि कर लीस, जेकर काममन दुस्टता के रिहिन। <verse eid="2CH 20:35" /><verse number="36" style="v" sid="2CH 20:36" />ओह ओकर संग एक बेपारी जहाजी-बेड़ा बनाय बर राजी हो गीस। एसियोन-गेबेर नगर म येमन ला बनाय के बाद, <verse eid="2CH 20:36" /><verse number="37" style="v" sid="2CH 20:37" />मारेसा के दोदावाह के बेटा एलिएजेर ह यहोसापात के बिरूध ये कहिके अगमबानी करिस, “काबरकि तेंह अहजयाह के संग संधि करे हस, यहोवा ह ओला नास कर दीही, जेला तेंह बनाय हस।” एकरसेति जहाजमन टूट गीन अऊ बेपार बर पानी म चले के लईक नइं रिहिन।<verse eid="2CH 20:37" /></para>
  <chapter eid="2CH 20" />
  <chapter number="21" style="c" sid="2CH 21" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 21:1" />तब यहोसापात ह अपन पुरखामन संग हमेसा बर सुत गीस अऊ ओला ओमन के संग, दाऊद के सहर म माटी दिये गीस। अऊ ओकर बेटा यहोराम ओकर जगह म राजा बनिस। <verse eid="2CH 21:1" /><verse number="2" style="v" sid="2CH 21:2" />यहोसापात के बेटा, यहोराम के भाईमन ये रिहिन, अजरयाह, यहीएल, जकरयाह, अजरयाहू, मिकाएल अऊ सपतयाह। ये सबो झन इसरायल के राजा यहोसापात के बेटा रिहिन। <verse eid="2CH 21:2" /><verse number="3" style="v" sid="2CH 21:3" />ओमन के ददा ह ओमन ला सोन अऊ चांदी अऊ कीमती सामान के बहुंत अकन भेंट अऊ येकर अलावा यहूदा म गढ़वाला सहरमन ला देय रिहिस, पर ओह यहोराम ला राज ला देय रिहिस काबरकि ओह ओकर पहिलांत बेटा रिहिस।<verse eid="2CH 21:3" /></para>
  <para style="s1">यहोराम ह यहूदा के राजा</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 21:4" />जब यहोराम ह अपन ददा के राज म अपनआप ला मजबूती ले स्थापित कर लीस, तब ओह अपन जम्मो भाईमन ला अऊ संग म इसरायल के कुछू करमचारीमन ला तलवार ले मरवा दीस। <verse eid="2CH 21:4" /><verse number="5" style="v" sid="2CH 21:5" />यहोराम ह बत्तीस साल के रिहिस, जब ओह राजा बनिस अऊ ओह आठ साल तक यरूसलेम म राज करिस। <verse eid="2CH 21:5" /><verse number="6" style="v" sid="2CH 21:6" />ओह इसरायल के राजामन के रसता म चलिस, जइसने कि अहाब के घराना ह करे रिहिस, काबरकि ओह अहाब के एक बेटी ले बिहाव करे रिहिस। ओह यहोवा के नजर म दुस्ट काम करिस। <verse eid="2CH 21:6" /><verse number="7" style="v" sid="2CH 21:7" />तभो ले, यहोवा ह दाऊद के घर ला नास करे बर नइं चाहिस। काबरकि यहोवा ह दाऊद के संग करार करे रिहिस। ओह वायदा करे रिहिस कि ओह ओकर अऊ ओकर संतानमन बर एक दीया हमेसा बनाय रखही।<verse eid="2CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 21:8" />यहोराम के समय म, एदोम ह यहूदा के बिरूध बिदरोह करिस अऊ अपन खुद के एक राजा बना लीस। <verse eid="2CH 21:8" /><verse number="9" style="v" sid="2CH 21:9" />एकरसेति यहोराम ह अपन अधिकारी अऊ अपन जम्मो रथमन ला लेके उहां गीस। एदोमीमन ओला अऊ ओकर रथ के सेनापतिमन ला घेर लीन। पर रथिया उठके ओह निकल गीस। <verse eid="2CH 21:9" /><verse number="10" style="v" sid="2CH 21:10" />आज तक ले एदोम ह यहूदा के बिरूध बिदरोह करत रहिथे।</para>
  <para style="p" vid="2CH 21:10">ओही बेरा लिबना ह घलो बिदरोह कर दीस, काबरकि यहोराम ह यहोवा, अपन पुरखामन के परमेसर ला तियाग देय रिहिस। <verse eid="2CH 21:10" /><verse number="11" style="v" sid="2CH 21:11" />ओह यहूदा के पहाड़ीमन म ऊंच जगहमन ला बनाय रिहिस अऊ यरूसलेम के मनखेमन ला ओ जगहमन म अराधना करे बर उकसाके अपनआप ले बेभिचार करवाय रिहिस अऊ यहूदा ला भटका देय रिहिस।<verse eid="2CH 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 21:12" />यहोराम ला अगमजानी एलियाह ले एक चिट्ठी मिलिस, जेमा कहे गे रिहिस:</para>
  <para style="pm" vid="2CH 21:12">“यहोवा, तोर ददा दाऊद के परमेसर ह ये कहत हे: ‘तेंह अपन ददा यहोसापात अऊ यहूदा के राजा आसा के रसता म नइं चले हस। <verse eid="2CH 21:12" /><verse number="13" style="v" sid="2CH 21:13" />पर तेंह इसरायल के राजामन के रसता म चले हस, अऊ तेंह यहूदा अऊ यरूसलेम के मनखेमन ले बेभिचार करवाय हस, जइसने कि अहाब के घराना ह करे रिहिस। तेंह अपन ही भाईमन के, अपन खुद के परिवार के सदस्यमन के, ओ मनखेमन के हतिया करे हस, जऊन मन तोर ले बने रिहिन। <verse eid="2CH 21:13" /><verse number="14" style="v" sid="2CH 21:14" />एकरसेति अब यहोवा ह तोर मनखे, तोर बेटा, तोर घरवाली अऊ तोर हर एक चीज ऊपर भारी बिपत्ति लानही। <verse eid="2CH 21:14" /><verse number="15" style="v" sid="2CH 21:15" />तेंह खुद लम्बा समय तक आंत के बेमारी ले बेमार हो जाबे, इहां तक कि बेमारी के कारन तोर आंत ह बाहिर निकल आही।’ ”<verse eid="2CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 21:16" />यहोवा ह यहोराम के बिरूध पलिस्ती अऊ अरबीमन ला बईरी कर दीस, जऊन मन कूसीमन के लकठा म रहत रिहिन। <verse eid="2CH 21:16" /><verse number="17" style="v" sid="2CH 21:17" />ओमन यहूदा ऊपर हमला करिन, अऊ चढ़ई करके राजा के महल म मिले जम्मो सामान ला ले गीन, अऊ संग म ओकर बेटा अऊ घरवालीमन ला घलो ले गीन। सबले छोटे बेटा अहजयाह<note caller="+" style="f"><char style="fr" closed="false">21:17 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">यहोआहाज, </char><char style="ft" closed="false">जऊन ह </char><char style="fq" closed="false">अहजयाह </char><char style="ft" closed="false">के आने नांव ए</char></note> के छोंड़ कोनो बेटा नइं बचे रिहिस।<verse eid="2CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 21:18" />ये सब होय के बाद, यहोवा ह यहोराम ला अंतड़ी के असाध्य बेमारी ले पीड़ित कर दीस। <verse eid="2CH 21:18" /><verse number="19" style="v" sid="2CH 21:19" />समय के बीतत, दूसर साल के आखिरी म, बेमारी के कारन ओकर अंतड़ीमन बाहिर आ गीन, अऊ अब्बड़ पीरा म ओह मर गीस। ओकर मनखेमन ओकर आदर म माटी देय के बेरा कोनो किसम के आगी नइं बारिन, जइसने कि ओमन पहिली ओकर पुरखामन के आदर म आगी बारत रिहिन।<verse eid="2CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 21:20" />यहोराम ह बत्तीस साल के रिहिस, जब ओह राजा बनिस अऊ आठ साल तक यरूसलेम म सासन करिस। ओह मर गीस, अऊ ओकर बर कोनो दुखी नइं होईन, अऊ दाऊद के सहर म ओला माटी देय गीस, पर राजामन के कबर म नइं।<verse eid="2CH 21:20" /></para>
  <chapter eid="2CH 21" />
  <chapter number="22" style="c" sid="2CH 22" />
  <para style="s1">यहूदा के राजा अहजयाह</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 22:1" />यरूसलेम के मनखेमन यहोराम के सबले छोटे बेटा अहजयाह ला ओकर जगह म राजा बनाईन, काबरकि ओ हमलावरमन, जेमन अरबीमन संग आय रिहिन, ओमन यहोराम के जम्मो बड़े बेटामन ला मार डारे रिहिन। एकरसेति यहूदा के राजा यहोराम के बेटा अहजयाह ह राज करे लगिस।<verse eid="2CH 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 22:2" />जब अहजयाह ह राजा बनिस, तब ओह बाईस साल के रिहिस, अऊ ओह एक साल तक यरूसलेम म राज करिस। ओकर दाई के नांव अतलयाह रिहिस, जऊन ह राजा ओमरी के पोती रिहिस।<verse eid="2CH 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 22:3" />ओह घलो अहाब के घराना के रसता म चलिस, काबरकि ओकर दाई ह ओला दुस्टता ले भरे काम करे बर उकसाईस। <verse eid="2CH 22:3" /><verse number="4" style="v" sid="2CH 22:4" />ओह यहोवा के नजर म दुस्ट काम करिस, जइसे कि अहाब के घराना ह करे रिहिस, काबरकि ओकर ददा के मऊत के बाद, ओमन ओकर सलाहकार बन गीन, जेकर से ओकर नास हो गीस। <verse eid="2CH 22:4" /><verse number="5" style="v" sid="2CH 22:5" />ओह घलो ओमन के सलाह म चलिस, जब ओह इसरायल के राजा अहाब के बेटा योराम के संग रामोत-गिलाद सहर म अराम के राजा हजाएल के बिरूध लड़ई करे बर गीस। अरामीमन योराम ला घायल कर दीन; <verse eid="2CH 22:5" /><verse number="6" style="v" sid="2CH 22:6" />एकरसेति ओह ओ घावमन ले ठीक होय बर यिजरेल लहुंट गीस, जेमन ओला रामोत<note caller="+" style="f"><char style="fr" closed="false">22:6 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">रामा</char></note> म अराम के राजा हजाएल के संग लड़ई करत बेरा लगे रिहिन।</para>
  <para style="p" vid="2CH 22:6">तब यहूदा के राजा यहोराम के बेटा अहजयाह<note caller="+" style="f"><char style="fr" closed="false">22:6 </char><char style="ft" closed="false">जादा इबरानी हस्तलिपि म </char><char style="fqa" closed="false">अजरयाह</char></note> ह अहाब के बेटा योराम ला देखे बर यिजरेल गीस, काबरकि योराम ह घायल हो गे रिहिस।<verse eid="2CH 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 22:7" />अहजयाह के योराम ले मिले के कारन, परमेसर ह अहजयाह ला खाल्हे गिराईस। जब अहजयाह ह पहुंचिस, त ओह योराम संग निमसी के बेटा येहू ले मिले बर निकलिस, जेला यहोवा ह अहाब के घर ला नास करे बर अभिसेक करे रिहिस। <verse eid="2CH 22:7" /><verse number="8" style="v" sid="2CH 22:8" />जब येहू ह अहाब के घराना ला मिले दंड ऊपर अमल करत रिहिस, तब ओला यहूदा के करमचारी अऊ अहजयाह के रिस्तेदार के बेटामन मिलिन, जेमन अहजयाह के सेवा करत रिहिन, अऊ ओह ओमन ला मार डारिस। <verse eid="2CH 22:8" /><verse number="9" style="v" sid="2CH 22:9" />तब ओह अहजयाह ला खोजे बर गीस, अऊ ओकर मनखेमन ओला पकड़ लीन, जब ओह सामरिया म लुकाय रिहिस। ओला येहू करा लाय गीस अऊ मार डारे गीस। ओमन ओला माटी दे दीन, काबरकि ओमन कहिन, “ओह यहोसापात के एक बेटा रिहिस, जऊन ह पूरा हिरदय ले यहोवा ला खोजिस।” उहां अहजयाह के घराना म कोनो अतेक ताकतवर नइं रिहिन कि ओ राज ला बनाय रखतिन।<verse eid="2CH 22:9" /></para>
  <para style="s1">अतलयाह अऊ योआस</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 22:10" />जब अहजयाह के दाई अतलयाह ह देखिस कि ओकर बेटा ह मर गे हवय, त ओह यहूदा के घर के जम्मो राज-घराना ला नास करे बर सुरू कर दीस। <verse eid="2CH 22:10" /><verse number="11" style="v" sid="2CH 22:11" />पर राजा यहोराम के बेटी यहोसेबा ह अहजयाह के बेटा योआस ला धरिस अऊ ओला ओ साही राजकुमारमन के बीच ले निकालके ले गीस, जेमन मार डारे जवइया रिहिन अऊ ओह ओला अऊ ओकर धाई ला सोये के एक ठन कमरा म रख दीस। काबरकि राजा यहोराम के बेटी यहोसेबा अऊ पुरोहित यहोयादा के घरवाली ह अहजयाह के बहिनी रिहिस, ओह अतलयाह ले लइका ला लुका दीस, जेकर कारन ओह ओ लइका ला मार नइं सकिस। <verse eid="2CH 22:11" /><verse number="12" style="v" sid="2CH 22:12" />योआस ह छै साल तक ओमन के संग परमेसर के मंदिर म लुकाय रिहिस, जब तक कि अतलयाह ह ओ देस म राज करते रिहिस।<verse eid="2CH 22:12" /></para>
  <chapter eid="2CH 22" />
  <chapter number="23" style="c" sid="2CH 23" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 23:1" />सातवां साल म यहोयादा पुरोहित ह अपन ताकत देखाईस। ओह सौ-सौ सैनिकमन ऊपर ठहिराय गे सेनापतिमन संग एक करार करिस: यरोहाम के बेटा अजरयाह, यहोहानान के बेटा इसमायल, ओबेद के बेटा अजरयाह, अदायाह के बेटा मासेयाह अऊ जिकरी के बेटा एलीसापात। <verse eid="2CH 23:1" /><verse number="2" style="v" sid="2CH 23:2" />येमन पूरा यहूदा म जाके जम्मो सहर के लेवीमन ला अऊ इसरायली परिवारमन के मुखियामन ला संकेलिन। तब ओमन यरूसलेम आईन, <verse eid="2CH 23:2" /><verse number="3" style="v" sid="2CH 23:3" />त पूरा सभा ह परमेसर के मंदिर म राजा संग एक करार करिस।</para>
  <para style="p" vid="2CH 23:3">यहोयादा ह ओमन ले कहिस, “राजा के बेटा ह सासन करही, जइसे कि यहोवा ह दाऊद के संतानमन के बिसय म वायदा करे हवय। <verse eid="2CH 23:3" /><verse number="4" style="v" sid="2CH 23:4" />अब तुमन ला ये काम करना हे: एक तिहाई पुरोहित अऊ लेवीमन, जऊन मन बिसराम दिन म काम म जावत हवंय, ओमन कपाटमन करा पहरेदारी करंय, <verse eid="2CH 23:4" /><verse number="5" style="v" sid="2CH 23:5" />तुमन के एक तिहाई राजमहल म अऊ एक तिहाई नीव के दुवार म, अऊ जम्मो आने मन यहोवा के मंदिर के अंगना म रहिहीं। <verse eid="2CH 23:5" /><verse number="6" style="v" sid="2CH 23:6" />सेवा करइया पुरोहित अऊ लेवीमन के छोंड़ अऊ कोनो यहोवा के मंदिर के भीतर झन जावन पावय; पुरोहित अऊ लेवीमन जा सकत हें, काबरकि ओमन पबितर करे गे हवंय, पर जम्मो आने मन यहोवा के हुकूम के पालन करंय अऊ भीतर झन जावंय। <verse eid="2CH 23:6" /><verse number="7" style="v" sid="2CH 23:7" />लेवीमन राजा के चारों कोति रहंय, हर एक जन अपन हांथ म हथियार धरे रहय। जऊन कोनो मंदिर के भीतर जावय, ओह मार डारे जावय। जिहां भी राजा ह जाथे, ओकर संगे-संग रहव।”<verse eid="2CH 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 23:8" />लेवीमन अऊ यहूदा के जम्मो आदमीमन वइसे ही करिन, जइसे यहोयादा पुरोहित ह हुकूम दीस। हर एक जन अपन-अपन आदमीमन ला लीन—जऊन मन बिसराम दिन काम करे बर जानेवाला रिहिन अऊ जऊन मन काम करके आवत रिहिन—काबरकि यहोयादा पुरोहित ह कोनो भी दल ला छुट्टी नइं देय रिहिस। <verse eid="2CH 23:8" /><verse number="9" style="v" sid="2CH 23:9" />तब ओह सौ-सौ के ऊपर ठहिराय गे दल के सेनापतिमन ला बरछी अऊ बड़े अऊ छोटे ढालमन ला दीस, जेमन राजा दाऊद के रिहिन अऊ परमेसर के मंदिर म रखे गे रिहिन। <verse eid="2CH 23:9" /><verse number="10" style="v" sid="2CH 23:10" />ओह जम्मो आदमीमन ला, ओमन के हांथ म हथियार के संग, राजा के चारों कोति ठहिरा दीस—बेदी अऊ मंदिर के लकठा म, मंदिर के दक्खिन दिग ले उत्तर दिग तक ठहिरा दीस।<verse eid="2CH 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 23:11" />यहोयादा अऊ ओकर बेटामन राजा के बेटा ला बाहिर लेके आईन अऊ ओला मुकुट पहिरा दीन; ओमन ओला करार के एक नकल भेंट करिन अऊ ओला राजा घोसित करिन। ओमन ओकर अभिसेक करिन अऊ चिचियाके कहिन, “राजा ह चिरंजीव रहय!”<verse eid="2CH 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 23:12" />जब अतलयाह ह मनखेमन के हल्ला अऊ राजा के जय-जयकार के अवाज ला सुनिस, त ओह यहोवा के मंदिर म ओमन करा गीस। <verse eid="2CH 23:12" /><verse number="13" style="v" sid="2CH 23:13" />अऊ ओह देखिस कि राजा ह प्रवेस दुवार के खंभा करा खड़े हवय। अधिकारी अऊ तुरही बजइयामन राजा के बाजू म खड़े रहंय, अऊ देस के जम्मो मनखेमन आनंद मनात तुरही फूंकत रहंय, अऊ संगीतकारमन अपन बाजामन संग परसंसा करत अगुवई करत रिहिन। तब अतलयाह ह अपन कपड़ा ला चीरिस अऊ चिचियाके कहिस, “देस-द्रोह! देस-द्रोह!”<verse eid="2CH 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 23:14" />यहोयादा पुरोहित ह सौ-सौ सैनिक के दल के सेनापतिमन ला बाहिर भेज दीस, जऊन मन सेना के अधिकारी रिहिन, अऊ ओमन ला कहिस: “अतलयाह ला कतार के बीच ले बाहिर लानव अऊ जऊन कोनो भी ओकर पाछू चलथे, ओला तलवार ले मार डारव।” काबरकि पुरोहित ह कहे रिहिस, “यहोवा के मंदिर म ओकर हतिया झन करे जावय।” <verse eid="2CH 23:14" /><verse number="15" style="v" sid="2CH 23:15" />एकरसेति ओमन ओला पकड़ लीन, जब ओह महल के मैदान म घोड़ा फाटक के प्रवेस दुवार म हबरिस, अऊ उहां ओमन ओला मार डारिन।<verse eid="2CH 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 23:16" />तब यहोयादा ह एक करार करिस कि ओह, मनखेमन अऊ राजा ह यहोवा के मनखे होहीं। <verse eid="2CH 23:16" /><verse number="17" style="v" sid="2CH 23:17" />जम्मो मनखेमन बाल के मंदिर म गीन अऊ ओला गिरा दीन। ओमन बेदी अऊ मूरतीमन ला कुचर दीन अऊ बेदी के आघू म बाल के पुरोहित मतान ला मार डारिन।<verse eid="2CH 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 23:18" />तब यहोयादा ह यहोवा के मंदिर के सेवा लेवीय पुरोहितमन के हांथ म दे दीस, जेमन ला दाऊद ह मंदिर म काम सऊंपे रिहिस, ताकि ओमन आनंद मनात अऊ गीत गावत मूसा के कानून म लिखे मुताबिक यहोवा के होम-बलिदान चघावंय, जइसे कि दाऊद ह हुकूम देय रिहिस। <verse eid="2CH 23:18" /><verse number="19" style="v" sid="2CH 23:19" />ओह यहोवा के मंदिर के दुवारमन म घलो दुवारपालमन ला ठहिरा दीस ताकि कोनो भी असुध मनखे मंदिर के भीतर झन जा सकंय।<verse eid="2CH 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 23:20" />ओह अपन संग सौ-सौ सैनिक के ऊपर ठहिराय सेनापति, परभावसाली मनखे, मनखेमन ऊपर सासन करइया अऊ ओ देस के जम्मो मनखेमन ला लीस अऊ राजा ला यहोवा के मंदिर ले खाल्हे लानिस। ओमन ऊपरी दुवार ले होके महल म गीन अऊ राजा ला राज सिंघासन म बईठाईन। <verse eid="2CH 23:20" /><verse number="21" style="v" sid="2CH 23:21" />देस के जम्मो मनखेमन आनंद मनाईन, अऊ सहर म सांति रिहिस, काबरकि अतलयाह ह तलवार ले मार डारे गे रिहिस।<verse eid="2CH 23:21" /></para>
  <chapter eid="2CH 23" />
  <chapter number="24" style="c" sid="2CH 24" />
  <para style="s1">योआस ह मंदिर के मरम्मत करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 24:1" />योआस ह सात साल के रिहिस, जब ओह राजा बनिस, अऊ ओह यरूसलेम म चालीस साल तक राज करिस। ओकर दाई के नांव सिबयाह रिहिस, जऊन ह बेरसेबा के रिहिस। <verse eid="2CH 24:1" /><verse number="2" style="v" sid="2CH 24:2" />योआस ह यहोयादा पुरोहित के जिनगी भर यहोवा के नजर म सही काम करिस। <verse eid="2CH 24:2" /><verse number="3" style="v" sid="2CH 24:3" />यहोयादा ह ओकर बर दू झन घरवाली चुनिस, अऊ ओकर बेटा अऊ बेटीमन होईन।<verse eid="2CH 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 24:4" />कुछू समय के बाद, योआस ह यहोवा के मंदिर ला फेर स्थापित करे के फैसला करिस। <verse eid="2CH 24:4" /><verse number="5" style="v" sid="2CH 24:5" />ओह पुरोहित अऊ लेवीमन ला एक संग बलाईस अऊ ओमन ले कहिस, “यहूदा के नगरमन म जावव अऊ अपन परमेसर के मंदिर के मरम्मत बर जम्मो इसरायल ले हर साल धन इकट्ठा करव। येला तुरते करव।” पर लेवीमन तुरते ये बुता ला नइं करिन।<verse eid="2CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 24:6" />एकरसेति राजा ह यहोयादा मुखिया पुरोहित ला बलाईस अऊ कहिस, “तेंह काबर लेवीमन ले यहूदा अऊ यरूसलेम म यहोवा के सेवक मूसा अऊ इसरायल के सभा के दुवारा तम्बू बर करार के कानून के दुवारा लगाय गे लगान ला लाय बर नइं कहे हस?”<verse eid="2CH 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 24:7" />ओ दुस्ट माईलोगन अतलयाह के बेटामन परमेसर के मंदिर ला टोरके घुस गीन अऊ बाल देवता बर यहोवा के पबितर चीजमन के उपयोग करे रिहिन।<verse eid="2CH 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 24:8" />तब राजा के हुकूम ले, एक बड़े सन्दूक बनाय गीस अऊ बाहिर म, यहोवा के मंदिर के दुवार म रखवा दिये गीस। <verse eid="2CH 24:8" /><verse number="9" style="v" sid="2CH 24:9" />तब यहूदा अऊ यरूसलेम म घोसना करे गीस कि मनखेमन यहोवा करा ओ लगान ला लानंय, जेला परमेसर के सेवक मूसा ह सुन्ना जगह म इसरायल ऊपर लगाय रिहिस। <verse eid="2CH 24:9" /><verse number="10" style="v" sid="2CH 24:10" />जम्मो करमचारी अऊ जम्मो मनखेमन खुसी से अपन भाग के लगान ला तब तक सन्दूक म डालत गीन, जब तक कि ओह भर नइं गीस। <verse eid="2CH 24:10" /><verse number="11" style="v" sid="2CH 24:11" />जब भी लेवीमन के दुवारा राजा के करमचारीमन करा सन्दूक ला लाय जावय अऊ ओमन देखंय कि अब्बड़ अकन पईसा हो गे हवय, त साही सचिव अऊ मुखिया पुरोहित के अधिकारी आवंय अऊ सन्दूक ला खाली करके ओला फेर वापिस ओकर जगह म मढ़ा देवंय। ओमन हमेसा अइसने करंय अऊ ये किसम ले ओमन अब्बड़ अकन पईसा जमा कर लीन। <verse eid="2CH 24:11" /><verse number="12" style="v" sid="2CH 24:12" />राजा अऊ यहोयादा ह येला ओमन ला दे दीन, जऊन मन यहोवा के मंदिर के मरम्मत के काम ला करत रिहिन। ओमन यहोवा के मंदिर के मरम्मत बर राज-मिसतिरी अऊ बढ़ईमन ला, अऊ मंदिर के मरम्मत बर लोहा अऊ कांसा के काम करइयामन ला घलो ठहिराईन।<verse eid="2CH 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 24:13" />जऊन मन के ऊपर ओ काम के जिम्मेदारी रिहिस, ओमन मेहनती रिहिन, अऊ मरम्मत के काम ह ओमन के अधीन बढ़त गीस। ओमन पहिली जइसे असली बनावट म परमेसर के मंदिर ला फेर बनाईन अऊ ओला मजबूत करिन। <verse eid="2CH 24:13" /><verse number="14" style="v" sid="2CH 24:14" />जब ओमन काम ला पूरा कर डारिन, त ओमन बाकि बचे पईसा ला राजा अऊ यहोयादा करा लेय आईन, अऊ ये बाकि बचे पईसा ले यहोवा के मंदिर बर सामान बनाय गीस: सेवा बर सामान अऊ होम-बलिदान बर सामान, अऊ बरतन घलो अऊ आने सोन-चांदी के सामान। जब तक यहोयादा ह जीयत रिहिस, तब तक यहोवा के मंदिर म हमेसा होम-बलिदान चघाय जावत रिहिस।<verse eid="2CH 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 24:15" />अब यहोयादा ह डोकरा हो गे रिहिस अऊ ओह पूरा उमर के हो गे रिहिस, त ओह एक सौ तीस साल के उमर म मर गीस। <verse eid="2CH 24:15" /><verse number="16" style="v" sid="2CH 24:16" />ओला दाऊद के सहर म राजामन संग माटी देय गीस, काबरकि ओह इसरायल म परमेसर अऊ ओकर मंदिर बर बढ़िया काम करे रिहिस।<verse eid="2CH 24:16" /></para>
  <para style="s1">योआस के दुस्टता</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 24:17" />यहोयादा के मऊत के बाद, यहूदा के करमचारीमन आईन अऊ राजा ला अपन राजभक्ति देखाईन, अऊ ओह ओमन के बात ला सुनिस। <verse eid="2CH 24:17" /><verse number="18" style="v" sid="2CH 24:18" />ओमन यहोवा, अपन पुरखामन के परमेसर के मंदिर ला तियाग दीन, अऊ असेरा के खंभा अऊ मूरतीमन के अराधना करिन। ओमन के अपराध के कारन, परमेसर के कोरोध ह यहूदा अऊ यरूसलेम म आईस। <verse eid="2CH 24:18" /><verse number="19" style="v" sid="2CH 24:19" />हालाकि यहोवा ह ओ मनखेमन ला अपन करा लहुंटाके लाने बर अगमजानीमन ला भेजिस, अऊ हालाकि ओमन ओ मनखेमन के बिरूध गवाही दीन, तभो ले ओमन नइं सुनिन।<verse eid="2CH 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 24:20" />तब परमेसर के आतमा ह यहोयादा पुरोहित के बेटा जकरयाह ऊपर उतरिस। ओह मनखेमन के आघू म ठाढ़ होईस अऊ कहिस, “परमेसर ह ये कहत हे: ‘तुमन काबर यहोवा के हुकूम ला नइं मानत हव? तुम्हर उन्नति नइं होवय। काबरकि तुमन यहोवा ला छोंड़ दे हवव, अऊ ओह तुमन ला छोंड़ दे हवय।’ ”<verse eid="2CH 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 24:21" />पर मनखेमन ओकर बिरूध साजिस करिन, अऊ राजा के हुकूम ले ओमन ओला यहोवा के मंदिर के अंगना म पथरवाह करके मार डारिन। <verse eid="2CH 24:21" /><verse number="22" style="v" sid="2CH 24:22" />राजा योआस ह ओ दया के बात ला सुरता नइं करिस, जेला जकरयाह के ददा यहोयादा ह ओला देखाय रिहिस, पर ओह ओकर बेटा ला मार डारिस, जऊन ह मरत बेरा ये कहिस, “यहोवा ह येला देखय अऊ तोर ले लेखा लेवय।”<verse eid="2CH 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 24:23" />साल के सुरूआत म,<note caller="+" style="f"><char style="fr" closed="false">24:23 </char><char style="ft" closed="false">संभवतः बसन्त के समय म</char></note> अराम के सेना ह योआस के बिरूध आघू बढ़िस; ये सेना ह यहूदा अऊ यरूसलेम ऊपर हमला करिस अऊ मनखेमन के जम्मो अगुवामन ला मार डारिस। ओमन दमिस्क म अपन राजा करा जम्मो लूट के माल ला भेज दीन। <verse eid="2CH 24:23" /><verse number="24" style="v" sid="2CH 24:24" />हालाकि अरामी सेना ह सिरिप थोरकन आदमीमन संग आय रिहिस, तभो ले यहोवा ह एक जादा बड़े यहूदा के सेना ला ओमन के हांथ म कर दीस। काबरकि यहूदा ह यहोवा, अपन पुरखामन के परमेसर ला तियाग देय रिहिस, एकरसेति योआस ला दंड देय गीस। <verse eid="2CH 24:24" /><verse number="25" style="v" sid="2CH 24:25" />जब अरामीमन के सेना ह लहुंट गीस, त ओमन योआस ला बहुंत घायल करके छोंड़ दीन। ओकर करमचारीमन ओकर बिरूध यहोयादा पुरोहित के बेटा के हतिया करे के कारन साजिस करिन, अऊ ओमन ओला ओकर बिस्तर म मार डारिन। एकरसेति ओह मर गीस अऊ ओला दाऊद के सहर म माटी देय गीस, पर राजामन के कबर म नइं।<verse eid="2CH 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 24:26" />ओकर बिरूध सडयंत्र करइया म एक अमोनी माईलोगन सिमात के बेटा जाबाद,<note caller="+" style="f"><char style="fr" closed="false">24:26 </char><char style="fqa" closed="false">योजाबाद </char><char style="ft" closed="false">के आने नांव</char></note> अऊ एक मोआबी माईलोगन सिमरित के बेटा यहोजाबाद रिहिन। <verse eid="2CH 24:26" /><verse number="27" style="v" sid="2CH 24:27" />योआस के बेटामन के लेखा-जोखा, ओकर बारे म बहुंत अकन अगमबानी के बातमन, अऊ परमेसर के मंदिर के मरम्मत के लेखा-जोखा राजामन के इतिहास के किताब म लिखे गे हवय। अऊ ओकर बेटा अमसयाह ह ओकर जगह म राजा होईस।<verse eid="2CH 24:27" /></para>
  <chapter eid="2CH 24" />
  <chapter number="25" style="c" sid="2CH 25" />
  <para style="s1">यहूदा के राजा अमसयाह</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 25:1" />जब अमसयाह ह राजा बनिस, त ओह पच्चीस साल के रिहिस, अऊ ओह यरूसलेम म उनतीस साल तक राज करिस। ओकर दाई के नांव यहोअद्दीन रिहिस; जऊन ह यरूसलेम के रिहिस। <verse eid="2CH 25:1" /><verse number="2" style="v" sid="2CH 25:2" />अमसयाह ह ओही काम करिस, जऊन ह यहोवा के नजर म सही रिहिस, पर पूरा हिरदय ले नइं करिस। <verse eid="2CH 25:2" /><verse number="3" style="v" sid="2CH 25:3" />राज-सासन ह पूरा ओकर कब्जा म होय के बाद, ओह ओ करमचारीमन ला मार डारिस, जऊन मन ओकर ददा राजा ला मार डारे रिहिन। <verse eid="2CH 25:3" /><verse number="4" style="v" sid="2CH 25:4" />तभो ले ओमन के लइकामन ला नइं मारिस, पर ओह मूसा के किताब म लिखे कानून के मुताबिक काम करिस, जिहां यहोवा ह हुकूम दे हवय: “दाई-ददा ला ओमन के लइकामन के कारन झन मार डारे जावय, अऊ न ही लइकामन ला ओमन के दाई-ददा के कारन मार डारे जावय; हर एक ह अपन खुद के पाप के कारन मरही।”<note caller="+" style="f"><char style="fr" closed="false">25:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 24:16">ब्यव 24:16</ref></char></char></note><verse eid="2CH 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 25:5" />अमसयाह ह यहूदा के जम्मो मनखेमन ला एक संग बलाईस अऊ ओमन ला ओमन के परिवार के मुताबिक जम्मो यहूदा अऊ बिनयामीन म हजार-हजार के ऊपर सेनापति अऊ सौ-सौ के ऊपर सेनापति ठहिराईस। तब ओह ओमन ला इकट्ठा करिस, जेमन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ ओला पता चलिस कि उहां तीन लाख आदमी सेना के सेवा बर योग्य रिहिन, अऊ ओमन बरछी अऊ ढालमन ला चलाय म कुसल रिहिन। <verse eid="2CH 25:5" /><verse number="6" style="v" sid="2CH 25:6" />ओह इसरायल ले एक लाख सैनिकमन ला घलो चांदी के एक सौ टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">25:6 </char><char style="ft" closed="false">लगभग पौने चार टन</char></note> देके किराया म रखिस।<verse eid="2CH 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 25:7" />पर परमेसर के एक जन ह ओकर करा आईस अऊ कहिस, “हे महाराज, इसरायल के ये सेनामन तोर संग आघू झन बढ़ंय, काबरकि यहोवा ह इसरायल के संग नइं ए—अऊ न ही एपरैम के कोनो मनखे के संग हवय। <verse eid="2CH 25:7" /><verse number="8" style="v" sid="2CH 25:8" />अऊ त अऊ अगर तेंह लड़ई म जाबे अऊ हिम्मत करके लड़बे, तभो ले परमेसर ह तोला बईरी के आघू ले उखान फेंकही, काबरकि परमेसर करा मदद करे के या उखान फेंके के ताकत हवय।”<verse eid="2CH 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 25:9" />अमसयाह ह परमेसर के जन ले पुछिस, “पर ओ सौ टेलेन्ट के का होही, जेला मेंह इसरायल के सेनामन बर चुकाय हवंव?”</para>
  <para style="p" vid="2CH 25:9">परमेसर के जन ह जबाब दीस, “यहोवा ह तोला एकर ले जादा देय सकत हे।”<verse eid="2CH 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 25:10" />एकरसेति अमसयाह ह ओ सैनिकमन ला वापिस ओमन के घर भेज दीस, जेमन एपरैम ले ओकर करा आय रिहिन। ओमन यहूदा ऊपर बहुंत नराज होईन अऊ बहुंत गुस्सा होके अपन घर चल दीन।<verse eid="2CH 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 25:11" />तब अमसयाह ह हिम्मत करिस अऊ अपन सेना ला नून के घाटी म ले गीस, जिहां ओह सेईर के दस हजार मनखेमन ला मार डारिस। <verse eid="2CH 25:11" /><verse number="12" style="v" sid="2CH 25:12" />यहूदा के सेनामन दस हजार मनखेमन ला घलो जीयत पकड़ लीन, अऊ ओमन ला एक टीला के ऊपर ले गीन अऊ खाल्हे फेंक दीन, जेकर ले ओ जम्मो टकराके कुटा-कुटा हो गीन।<verse eid="2CH 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 25:13" />इही बीच, अमसयाह ह जऊन सेना ला वापिस भेज देय रिहिस अऊ ओमन ला लड़ई म सामिल करे ले मना कर दे रिहिस, ओ सेना ह सामरिया ले लेके बेत-होरोन तक यहूदा के नगरमन ऊपर हमला कर दीस। ओमन तीन हजार मनखेमन ला मार डारिन अऊ अब्बड़ अकन लूट के सामान ले गीन।<verse eid="2CH 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 25:14" />जब राजा अमसयाह ह एदोमीमन ला घात करके लहुंटिस, त ओह सेईर के मनखेमन के देवतामन ला वापिस ले आईस। ओह ओमन ला अपन खुद के देवतामन के रूप म स्थापित करिस, ओमन ला दंडवत करिस अऊ ओमन बर धूप जलाईस। <verse eid="2CH 25:14" /><verse number="15" style="v" sid="2CH 25:15" />अमसयाह के बिरूध यहोवा के कोरोध ह भड़किस, अऊ ओह ओकर करा एक अगमजानी ला पठोईस, जऊन ह ओला कहिस, “तेंह ओ मनखेमन के देवतामन ले सलाह काबर लेवत हस, जऊन मन अपन ही मनखेमन ला तोर हांथ ले नइं बचा सकिन?”<verse eid="2CH 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 25:16" />जब ओह गोठियात रिहिस, तब राजा ह ओकर ले कहिस, “का हमन तोला राजा के सलाहकार ठहिराय हन? बंद कर! काबर मरे बर चाहत हस?”</para>
  <para style="p" vid="2CH 25:16">एकरसेति अगमजानी ह रूक गीस पर ओह कहिस, “मेंह जानत हंव कि परमेसर ह तोला नास करे बर ठान ले हवय, काबरकि तेंह अइसे करे हस अऊ मोर सलाह ला नइं माने हस।”<verse eid="2CH 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 25:17" />जब यहूदा के राजा अमसयाह ह अपन सलाहकारमन ले सलाह कर लीस, त ओह इसरायल के राजा यहोआस ला ये चुनौती दीस, जऊन ह येहू के पोता अऊ यहोआहाज के बेटा रिहिस: “आ, हमन लड़ई म एक-दूसर के सामना करन।”<verse eid="2CH 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 25:18" />पर इसरायल के राजा यहोआस ह यहूदा के राजा अमसयाह ला जबाब भेजिस: “लबानोन के एक कंटिली झाड़ी ह लबानोन के एक देवदार रूख मेर ये संदेस भेजिस, ‘अपन बेटी के बिहाव मोर बेटा के संग कर दे।’ तब लबानोन म एक जंगली पसु आईस अऊ ओ कंटिली झाड़ी ला गोड़ खाल्हे कुचर दीस। <verse eid="2CH 25:18" /><verse number="19" style="v" sid="2CH 25:19" />तेंह अपनआप ले कहिथस कि तेंह एदोम ला हराय हस, अऊ अब तेंह जिद्दी अऊ घमंडी हो गे हस। पर अपन घर म रह! मुसीबत ला काबर नेवता देवत हस अऊ अपन खुद के अऊ यहूदा के घलो बिनास के कारन बनत हस?”<verse eid="2CH 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 25:20" />पर अमसयाह ह ओकर बात ला नइं सुनिस, काबरकि परमेसर ह अइसन करे रिहिस कि ओला यहोआस के हांथ म कर देवय, काबरकि ओमन एदोम के देवतामन के खोज म लगे रिहिन। <verse eid="2CH 25:20" /><verse number="21" style="v" sid="2CH 25:21" />एकरसेति इसरायल के राजा यहोआस ह हमला कर दीस। ओकर अऊ यहूदा के राजा अमसयाह के आमना-सामना यहूदा के बेत-सेमेस नगर म होईस। <verse eid="2CH 25:21" /><verse number="22" style="v" sid="2CH 25:22" />यहूदा ह इसरायल ले हार गीस अऊ जम्मो मनखेमन अपन-अपन घर भाग गीन। <verse eid="2CH 25:22" /><verse number="23" style="v" sid="2CH 25:23" />इसरायल के राजा यहोआस ह यहूदा के राजा अमसयाह ला, बेत-सेमेस करा बंदी बना लीस, जऊन ह योआस के बेटा अऊ अहजयाह के पोता रिहिस। तब यहोआस ह ओला यरूसलेम ले आईस अऊ यरूसलेम के दीवार ला एपरैम के दुवार ले लेके कोना के दुवार तक टोरके गिरा दीस—याने कि लगभग चार सौ क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">25:23 </char><char style="ft" closed="false">लगभग 600 फीट या 180 मीटर</char></note> लम्बा भाग ला गिरा दीस। <verse eid="2CH 25:23" /><verse number="24" style="v" sid="2CH 25:24" />ओह जम्मो सोन अऊ चांदी अऊ परमेसर के मंदिर म रखे ओ जम्मो सामान ला ले लीस, जऊन ह ओबेद-एदोम के देखरेख म रिहिस, संग म ओह महल के खजाना अऊ बंदी बनाय गे मनखेमन ला घलो लेके वापिस सामरिया लहुंट गीस।<verse eid="2CH 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 25:25" />यहूदा के राजा, योआस के बेटा अमसयाह ह यहोआहाज के बेटा इसरायल के राजा यहोआस के मिरतू के बाद पंदरह साल जिंदा रिहिस। <verse eid="2CH 25:25" /><verse number="26" style="v" sid="2CH 25:26" />अमसयाह के सासन के आने घटनामन, सुरू ले लेके आखिरी तक यहूदा अऊ इसरायल के राजामन के किताब म लिखे गे हवंय। <verse eid="2CH 25:26" /><verse number="27" style="v" sid="2CH 25:27" />जब अमसयाह ह यहोवा के पाछू चले बर बंद कर दीस, त ओ बेरा ले मनखेमन यरूसलेम म ओकर बिरूध साजिस करिन अऊ ओह लाकीस सहर ला भाग गीस, पर ओमन ओकर पाछू आदमीमन ला लाकीस पठोईन अऊ ओला उहां मार डारिन। <verse eid="2CH 25:27" /><verse number="28" style="v" sid="2CH 25:28" />ओकर लास ला घोड़ा म लादके वापिस लाय गीस अऊ ओला यहूदा के सहर म ओकर पुरखामन संग माटी देय गीस।<note caller="+" style="f"><char style="fr" closed="false">25:28 </char><char style="ft" closed="false">जादा इबरानी हस्तलिपि म </char><char style="fqa" closed="false">दाऊद </char><char style="ft" closed="false">(देखव <char style="xt"><ref loc="2KI 14:20">2 राजा 14:20</ref></char>)</char></note><verse eid="2CH 25:28" /></para>
  <chapter eid="2CH 25" />
  <chapter number="26" style="c" sid="2CH 26" />
  <para style="s1">यहूदा के राजा उजियाह</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 26:1" />तब यहूदा के जम्मो मनखेमन उजियाह ला लेके ओकर ददा अमसयाह के जगह म राजा बनाईन। उजियाह ह ओ समय सोलह साल के रिहिस। <verse eid="2CH 26:1" /><verse number="2" style="v" sid="2CH 26:2" />येह ओही मनखे अय, जऊन ह अमसयाह के ओकर पुरखामन संग हमेसा बर सुत जाय के बाद एलात नगर ला फेर बनाईस अऊ यहूदा म सामिल कर लीस।<verse eid="2CH 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 26:3" />जब उजियाह ह राजा बनिस, तब ओह सोलह साल के रिहिस, अऊ ओह यरूसलेम म बावन साल तक राज करिस। ओकर दाई के नांव यकोलियाह रिहिस, जऊन ह यरूसलेम के रिहिस। <verse eid="2CH 26:3" /><verse number="4" style="v" sid="2CH 26:4" />उजियाह ह अपन ददा अमसयाह के सहीं ओहीच काम करिस, जऊन ह यहोवा के नजर म सही अय। <verse eid="2CH 26:4" /><verse number="5" style="v" sid="2CH 26:5" />ओह जकरयाह के दिन म परमेसर ला खोजिस, जऊन ह ओला परमेसर के डर म बढ़े के निरदेस दीस। जब तक ओह यहोवा ला खोजिस, परमेसर ह ओला सफलता दीस।<verse eid="2CH 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 26:6" />उजियाह ह पलिस्तीमन के बिरूध लड़ई करे बर गीस अऊ गत, यबने अऊ असदोद के दीवारमन ला गिरा दीस। ओकर बाद ओह असदोद के लकठा के अऊ पलिस्तीमन के बीच म सहरमन ला फेर बनाईस। <verse eid="2CH 26:6" /><verse number="7" style="v" sid="2CH 26:7" />परमेसर ह पलिस्तीमन के बिरूध अऊ गुर-बाल नगर म रहइया अरबीमन के बिरूध अऊ मूनीमन के बिरूध ओकर मदद करिस। <verse eid="2CH 26:7" /><verse number="8" style="v" sid="2CH 26:8" />अमोनीमन उजियाह करा राजकर लानिन, अऊ ओकर बड़ई मिसर के सीमना तक फईल गीस, काबरकि ओह अब्बड़ ताकतवर हो गे रिहिस।<verse eid="2CH 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 26:9" />उजियाह ह यरूसलेम म कोना के दुवार, घाटी के दुवार अऊ सहर के दीवार के कोर म मीनारमन ला बनाईस अऊ ओला गढ़वाला करिस। <verse eid="2CH 26:9" /><verse number="10" style="v" sid="2CH 26:10" />ओह सुन्ना जगह म घलो मीनारमन ला बनाईस अऊ कई ठन तरिया कोड़वाईस, काबरकि ओकर करा पहाड़ी के खाल्हे म अऊ मैदान म अब्बड़ अकन मवेसी रिहिन। ओकर करा ओकर खेतमन म अऊ पहाड़ी के अंगूर के बारी म अऊ उपजाऊ जमीन म बुता करइया मनखेमन रिहिन, काबरकि ओह खेती-बारी ले मया करय।<verse eid="2CH 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 26:11" />उजियाह करा बढ़िया कुसल सेना रिहिस, जऊन मन अपन संखिया के मुताबिक दल के दल एक राज करमचारी हननयाह के अगुवई म येइल सचिव अऊ मासेयाह अधिकारी के दुवारा बाहिर जाय बर तियार रिहिन। <verse eid="2CH 26:11" /><verse number="12" style="v" sid="2CH 26:12" />लड़ई करइया आदमीमन के अलावा परिवार के अगुवामन के कुल संखिया 2,600 रिहिस। <verse eid="2CH 26:12" /><verse number="13" style="v" sid="2CH 26:13" />ओमन के हुकूम के अधीन लड़ई बर 3,07,500 कुसल आदमीमन के सेना रिहिस, येह राजा ला ओकर बईरीमन के बिरूध सहयोग करे बर एक ताकतवर सेना रिहिस। <verse eid="2CH 26:13" /><verse number="14" style="v" sid="2CH 26:14" />उजियाह ह पूरा सेना बर ढाल, बरछी, लोहा के टोपी, छाती के कवच, तीर अऊ गोफन के परबंध करिस। <verse eid="2CH 26:14" /><verse number="15" style="v" sid="2CH 26:15" />यरूसलेम म ओह मीनारमन म अऊ कोना म बचाव बर नवां-नवां किसम के औजारमन ला बनाईस, ताकि सिपाहीमन तीर चला सकंय अऊ दीवार ले बड़े पथरामन ला तेजी से फेंक सकंय। ओकर बड़ई ह दूरिहा-दूरिहा तक ले फईल गीस, काबरकि ओला अब्बड़ मदद मिलिस, जब तक कि ओह ताकतवर नइं हो गीस।<verse eid="2CH 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 26:16" />पर बाद म, जब उजियाह ह ताकतवर हो गीस, त ओकर घमंड के सेति ओकर पतन हो गीस। ओह यहोवा अपन परमेसर बर बिसवासघाती हो गीस, अऊ धूप के बेदी म धूप जलाय बर यहोवा के मंदिर भीतर गीस। <verse eid="2CH 26:16" /><verse number="17" style="v" sid="2CH 26:17" />अजरयाह पुरोहित ह यहोवा के अस्सी आने हिम्मती पुरोहितमन संग ओकर पाछू गीस। <verse eid="2CH 26:17" /><verse number="18" style="v" sid="2CH 26:18" />ओमन राजा उजियाह के सामना करिन अऊ कहिन, “हे उजियाह, यहोवा बर धूप जलाना तोर बर सही नो हय। ये काम ह हारून के संतान, पुरोहितमन के अय, जेमन ला धूप जलाय बर पबितर करे गे हवय। पबितर-स्थान ला छोंड़ दे, काबरकि तेंह बिसवासघाती हो गे हस; अऊ यहोवा परमेसर के दुवारा तोर आदर नइं करे जावय।”<verse eid="2CH 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 26:19" />उजियाह, जऊन ह अपन हांथ म धूपदान लेके धूप जलाय बर तियार रिहिस, गुस्सा हो गीस। जब ओह यहोवा के मंदिर म धूप के बेदी के आघू म पुरोहितमन ऊपर गुस्सा करत रिहिस, त ओकर माथा म कोढ़ के बेमारी हो गीस। <verse eid="2CH 26:19" /><verse number="20" style="v" sid="2CH 26:20" />जब मुखिया पुरोहित अजरयाह अऊ आने जम्मो पुरोहितमन ओला देखिन, त पाईन कि ओकर माथा म कोढ़ हो गे हवय, एकरसेति ओमन ओला जल्दी से बाहिर निकालिन। असल म, ओह खुद बाहिर निकले के जल्दी म रिहिस, काबरकि यहोवा ह ओला कोढ़ ले पीड़ित कर दे रिहिस।<verse eid="2CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 26:21" />राजा उजियाह ह ओ दिन तक कोढ़ के रोगी रिहिस, जब तक कि ओकर मिरतू नइं हो गीस। ओह अलग घर म रहत रिहिस—कोढ़ के सेति ओला यहोवा के मंदिर म जाय के मनाही रिहिस। ओकर बेटा योताम ह महल के अधिकारी होके देस के मनखेमन ऊपर सासन करिस।<verse eid="2CH 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 26:22" />उजियाह के सासन के आने घटनामन, सुरू ले आखिरी तक, आमोस के बेटा अगमजानी यसायाह के दुवारा लिखे गे हवंय। <verse eid="2CH 26:22" /><verse number="23" style="v" sid="2CH 26:23" />उजियाह ह हमेसा बर अपन पुरखामन संग सुत गीस अऊ ओला ओमन के लकठा म एक कबर म माटी दिये गीस, जऊन ह राजामन के रिहिस, काबरकि मनखेमन कहिन, “ओला कोढ़ के बेमारी रिहिस।” अऊ ओकर बेटा योताम ह ओकर जगह म राजा बनिस।<verse eid="2CH 26:23" /></para>
  <chapter eid="2CH 26" />
  <chapter number="27" style="c" sid="2CH 27" />
  <para style="s1">यहूदा के राजा योताम</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 27:1" />जब योताम ह राजा बनिस, त ओह पच्चीस साल के रिहिस, अऊ ओह सोलह साल तक यरूसलेम म राज करिस। ओकर दाई के नांव यरूसा रिहिस, जऊन ह सादोक के बेटी रिहिस। <verse eid="2CH 27:1" /><verse number="2" style="v" sid="2CH 27:2" />ओह अपन ददा उजियाह के सहीं ओही काम करिस, जऊन ह यहोवा के नजर म सही रिहिस, पर ओकर सहीं ओह यहोवा के मंदिर म प्रवेस नइं करिस। तभो ले, मनखेमन भ्रस्टाचार करते ही रिहिन। <verse eid="2CH 27:2" /><verse number="3" style="v" sid="2CH 27:3" />योताम ह यहोवा के मंदिर के ऊपर के दुवार ला फेर बनाईस अऊ ओपेल के पहाड़ी के दीवार ला अऊ बढ़ाईस। <verse eid="2CH 27:3" /><verse number="4" style="v" sid="2CH 27:4" />ओह यहूदा के पहाड़ी देस म सहरमन ला अऊ जंगली जगहमन म किला अऊ मीनारमन ला बनाईस।<verse eid="2CH 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 27:5" />योताम ह अमोनीमन के राजा के बिरूध लड़ई करिस अऊ ओमन ला जीत लीस। ओ बछर अमोनीमन ओला चांदी के एक सौ टेलेन्ट,<note caller="+" style="f"><char style="fr" closed="false">27:5 </char><char style="ft" closed="false">लगभग पौने चार टन</char></note> दस हजार कोर्स<note caller="+" style="f"><char style="fr" closed="false">27:5 </char><char style="ft" closed="false">लगभग 1,800 टन</char></note> गहूं अऊ दस हजार कोर्स<note caller="+" style="f"><char style="fr" closed="false">27:5 </char><char style="ft" closed="false">लगभग 1,500 टन</char></note> जौ दीन। अमोनीमन ओला दूसर अऊ तीसर बछर म घलो ओतकेच मात्रा म सामान दीन।<verse eid="2CH 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 27:6" />योताम ह ताकतवर होवत गीस, काबरकि ओह यहोवा अपन परमेसर के आघू म सही चलत रिहिस।<verse eid="2CH 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 27:7" />योताम के राज के आने घटनामन, ओकर जम्मो लड़ईमन अऊ ओकर करे गय आने काममन इसरायल अऊ यहूदा के राजामन के किताब म लिखे गे हवय। <verse eid="2CH 27:7" /><verse number="8" style="v" sid="2CH 27:8" />जब ओह राजा बनिस, त ओह पच्चीस साल के रिहिस, अऊ ओह सोलह साल तक यरूसलेम म राज करिस। <verse eid="2CH 27:8" /><verse number="9" style="v" sid="2CH 27:9" />योताम ह अपन पुरखामन संग हमेसा बर सुत गीस अऊ ओला दाऊद के सहर म माटी देय गीस। अऊ ओकर बेटा आहाज ह ओकर जगह म राजा बनिस।<verse eid="2CH 27:9" /></para>
  <chapter eid="2CH 27" />
  <chapter number="28" style="c" sid="2CH 28" />
  <para style="s1">यहूदा के राजा आहाज</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 28:1" />आहाज ह बीस साल के रिहिस, जब ओह राजा बनिस अऊ ओह यरूसलेम म सोलह साल तक सासन करिस। अपन पुरखा दाऊद के सहीं, ओह ओ काम नइं करिस, जऊन ह यहोवा के नजर म सही रिहिस। <verse eid="2CH 28:1" /><verse number="2" style="v" sid="2CH 28:2" />ओह इसरायल के राजामन के रसता म चलिस अऊ अराधना करे बर बाल के मूरतीमन ला घलो बनाईस। <verse eid="2CH 28:2" /><verse number="3" style="v" sid="2CH 28:3" />ओह बेन-हिन्नोम के घाटी म धूप के बलिदान चघाईस अऊ अपन लइकामन ला आगी म बलिदान करिस, अऊ ओ जाति-जाति के मनखेमन के घिनौना रीति-रिवाज म चलिस, जेमन ला यहोवा ह इसरायलीमन के आघू ले भगा दे रिहिस। <verse eid="2CH 28:3" /><verse number="4" style="v" sid="2CH 28:4" />ओह ऊंच जगह म, पहाड़ीमन के टीप म अऊ हर फईले हुए रूख के खाल्हे म बलिदान चघाईस अऊ धूप जलाईस।<verse eid="2CH 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 28:5" />एकरसेति यहोवा ओकर परमेसर ह ओला अराम के राजा के हांथ म कर दीस। अरामीमन ओमन ला हरा दीन अऊ ओकर कतको मनखेमन ला बंदी बनाके दमिस्क ले आईन।</para>
  <para style="p" vid="2CH 28:5">ओला इसरायल के राजा के हांथ म घलो दे दिये गीस, जऊन ह ओकर भारी नुकसान करिस। <verse eid="2CH 28:5" /><verse number="6" style="v" sid="2CH 28:6" />एकेच दिन म रमलियाह के बेटा पेकह ह यहूदा म एक लाख बीस हजार सैनिकमन ला मार डारिस, काबरकि यहूदा ह यहोवा, अपन पुरखामन के परमेसर ला तियाग दे रिहिस। <verse eid="2CH 28:6" /><verse number="7" style="v" sid="2CH 28:7" />एक एपरैमी योद्धा, जिकरी ह राजा के बेटा मासेयाह, महल के प्रभारी अधिकारी अजरीकाम, अऊ राजा के बाद दूसरा अधिकारी एलकाना ला मार डारिस। <verse eid="2CH 28:7" /><verse number="8" style="v" sid="2CH 28:8" />इसरायल के मनखेमन यहूदा के अपन संगी इसरायलीमन ला बंदी बना लीन, जेमा दू लाख घरवाली, बेटा अऊ बेटीमन रिहिन। ओमन अब्बड़ अकन लूट के सामान घलो ले लीन, जेला ओमन वापिस सामरिया ले गीन।<verse eid="2CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 28:9" />पर उहां ओदेद नांव के यहोवा के एक अगमजानी रिहिस, अऊ ओह सेना के मनखेमन ले मिले बर गीस, जब ओमन सामरिया लहुंटिन। ओह ओमन ला कहिस, “काबरकि यहोवा, तुम्हर पुरखामन के परमेसर ह यहूदा ले गुस्सा करिस, त ओह ओमन ला तुम्हर हांथ म दे दीस। पर तुमन ओमन ला गुस्सा म मार दे हवव, जऊन ह स्वरग तक पहुंच गे हवय। <verse eid="2CH 28:9" /><verse number="10" style="v" sid="2CH 28:10" />अऊ अब तुमन यहूदा अऊ यरूसलेम के आदमी अऊ माईलोगनमन ला अपन गुलाम बनाय चाहत हवव। पर का तुमन घलो यहोवा अपन परमेसर के बिरूध पाप के दोसी नइं हवव? <verse eid="2CH 28:10" /><verse number="11" style="v" sid="2CH 28:11" />अब मोर बात ला सुनव! अपन संगी इसरायलीमन ला वापिस भेज दव, जेला तुमन कैदी के रूप म ले आय हवव, काबरकि यहोवा के भयंकर कोरोध तुम्हर ऊपर हवय।”<verse eid="2CH 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 28:12" />तब एपरैम के कुछू अगुवा—यहोहानान के बेटा अजरयाह, मसिल्लेमोत के बेटा बेरेकियाह, सल्लूम के बेटा यहिजकियाह, अऊ हदले के बेटा अमासा—येमन ओमन के सामना करिन, जेमन लड़ई ले आवत रिहिन। <verse eid="2CH 28:12" /><verse number="13" style="v" sid="2CH 28:13" />ओमन कहिन, “तुमन ओ कैदीमन ला इहां झन लानव, नइं तो हमन यहोवा के आघू म दोसी ठहिरबो। का तुम्हर इरादा हमर पाप अऊ दोस ला अऊ बढ़ाय के हवय? काबरकि हमर दोस पहिले ले ही अब्बड़ हवय, अऊ ओकर भयंकर कोरोध इसरायल ऊपर हवय।”<verse eid="2CH 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 28:14" />एकरसेति सैनिकमन, करमचारी अऊ जम्मो सभा के आघू म कैदीमन ला अऊ लूट के सामान ला दे दीन। <verse eid="2CH 28:14" /><verse number="15" style="v" sid="2CH 28:15" />जेमन के नांव लिखके निरदेस दिये गीस, ओमन कैदीमन ला ले लीन, अऊ जेमन नंगरा रिहिन ओ जम्मो ला ओमन लूट म के कपड़ा ला पहिराईन। ओमन ला कपड़ा अऊ चप्पल, खाना-पीना अऊ चंगा करे के मलहम दिये गीस। ओ जम्मो, जेमन कमजोर रिहिन, ओमन ला गदहा म बईठाईन। ये किसम ले ओमन अपन संगी इसरायलीमन ला वापिस यरीहो, खजूर के सहर म ले गीन, अऊ सामरिया लहुंट आईन।<verse eid="2CH 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 28:16" />ओही बेरा, राजा आहाज ह अस्सूर के राजामन ले मदद मांगिस। <verse eid="2CH 28:16" /><verse number="17" style="v" sid="2CH 28:17" />एदोमीमन फेर आईन अऊ यहूदा ऊपर हमला करिन अऊ मनखेमन ला कैदी बनाके ले गीन, <verse eid="2CH 28:17" /><verse number="18" style="v" sid="2CH 28:18" />जबकि पलिस्तीमन खाल्हे कोति के सहरमन म अऊ यहूदा के नेगेव म हमला करिन। ओमन बेत-सेमेस, अय्यालोन अऊ गदेरोत, संग म सोको, तिमना अऊ गिमजो ऊपर ओमन के चारों कोति के गांवमन सहित कब्जा कर लीन। <verse eid="2CH 28:18" /><verse number="19" style="v" sid="2CH 28:19" />यहोवा ह इसरायल<note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="ft" closed="false">यहूदा</char></note> के राजा आहाज के कारन यहूदा ला दीन-हीन कर दीस, काबरकि ओह यहूदा म दुस्टता ला बढ़ावा देय रिहिस अऊ यहोवा के बिरूध सबले जादा बिसवासघात करे रिहिस। <verse eid="2CH 28:19" /><verse number="20" style="v" sid="2CH 28:20" />अस्सूर के राजा तिगलत-पिलेसेर ह ओकर करा आईस, पर ओह ओला मदद देय के बदले ओकर बर परेसानी खड़े करिस। <verse eid="2CH 28:20" /><verse number="21" style="v" sid="2CH 28:21" />आहाज ह यहोवा के मंदिर अऊ राजमहल अऊ करमचारीमन ले कुछू चीजमन ला लीस अऊ ओ चीजमन ला अस्सूर के राजा ला भेंट म दीस, पर येकर ले ओला कोनो फायदा नइं होईस।<verse eid="2CH 28:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 28:22" />अपन मुसीबत के ये बेरा म, राजा आहाज ह यहोवा बर अऊ बिसवासघाती हो गीस। <verse eid="2CH 28:22" /><verse number="23" style="v" sid="2CH 28:23" />ओह दमिस्क के देवतामन ला बलिदान चघाईस, जऊन मन ओला हराय रिहिन; काबरकि ओह सोचिस, “जब अराम के राजामन के देवतामन ओमन के मदद करे हवंय, एकरसेति मेंह ओमन ला बलिदान चघाहूं, त ओमन मोर घलो मदद करहीं।” पर ओमन ओकर अऊ जम्मो इसरायल के पतन के कारन बनिन।<verse eid="2CH 28:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 28:24" />आहाज ह परमेसर के मंदिर के सामान ला संकेलिस अऊ ओमन ला कुटा-कुटा करके काट दीस। ओह यहोवा के मंदिर के कपाटमन ला बंद करवा दीस अऊ यरूसलेम के हर एक गली के कोना म बेदी बनवाईस। <verse eid="2CH 28:24" /><verse number="25" style="v" sid="2CH 28:25" />यहूदा के हर एक नगर म, ओह आने देवतामन ला बलिदान चघाय बर ऊंच जगहमन ला बनाईस अऊ यहोवा, अपन पुरखामन के परमेसर के कोरोध ला भड़काईस।<verse eid="2CH 28:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 28:26" />ओकर राज के आने घटनामन अऊ ओकर जम्मो चालचलन, सुरू ले आखिरी तक, यहूदा अऊ इसरायल के राजामन के किताब म लिखे गे हवंय। <verse eid="2CH 28:26" /><verse number="27" style="v" sid="2CH 28:27" />आहाज ह अपन पुरखामन संग हमेसा बर सुत गीस अऊ ओला यरूसलेम सहर म माटी दिये गीस, पर ओला इसरायल के राजामन के कबर म नइं रखे गीस। अऊ ओकर बेटा हिजकियाह ह ओकर जगह म राजा बनिस।<verse eid="2CH 28:27" /></para>
  <chapter eid="2CH 28" />
  <chapter number="29" style="c" sid="2CH 29" />
  <para style="s1">हिजकियाह ह मंदिर ला सुध करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 29:1" />हिजकियाह ह पच्चीस साल के रिहिस, जब ओह राजा बनिस अऊ ओह यरूसलेम म उनतीस साल तक राज करिस। ओकर दाई के नांव अबियाह रिहिस, जऊन ह जकरयाह के बेटी रिहिस। <verse eid="2CH 29:1" /><verse number="2" style="v" sid="2CH 29:2" />हिजकियाह ह ओही काम करिस, जऊन ह यहोवा के नजर म सही रिहिस, जइसे कि ओकर पुरखा दाऊद ह करे रिहिस।<verse eid="2CH 29:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 29:3" />अपन सासनकाल के पहिला बछर के पहिला महिना म, ओह यहोवा के मंदिर के कपाटमन ला खोल दीस अऊ ओमन के मरम्मत करवाईस। <verse eid="2CH 29:3" /><verse number="4" style="v" sid="2CH 29:4" />ओह पुरोहित अऊ लेवीमन ला लेके, ओमन ला पूरब कोति चऊक म संकेलिस <verse eid="2CH 29:4" /><verse number="5" style="v" sid="2CH 29:5" />अऊ कहिस: “हे लेवीमन! मोर बात ला सुनव! अब अपनआप ला पबितर करव अऊ यहोवा, अपन पुरखामन के परमेसर के मंदिर ला पबितर करव। जम्मो असुधता ला पबितर-स्थान ले हटावव। <verse eid="2CH 29:5" /><verse number="6" style="v" sid="2CH 29:6" />हमर दाई-ददामन बिसवासघाती रिहिन; ओमन यहोवा हमर परमेसर के नजर म बुरई करिन अऊ ओला तियाग दीन। ओमन यहोवा के निवास ले अपन मुहूं फेर लीन अऊ ओला अपन पीठ देखा दीन। <verse eid="2CH 29:6" /><verse number="7" style="v" sid="2CH 29:7" />ओमन मंडप के कपाटमन ला घलो बंद कर दीन अऊ दीयामन ला बुता दीन। ओमन इसरायल के परमेसर बर पबितर-स्थान म न तो धूप जलाईन अऊ न ही कोनो किसम के होम-बलिदान चघाईन। <verse eid="2CH 29:7" /><verse number="8" style="v" sid="2CH 29:8" />एकरसेति यहोवा के कोरोध ह यहूदा अऊ यरूसलेम म भड़के हवय; ओह ओमन ला डर अऊ आतंक अऊ अपमान के चीज बना दे हवय, जइसन कि तुमन खुद अपन आंखी ले देख सकत हव। <verse eid="2CH 29:8" /><verse number="9" style="v" sid="2CH 29:9" />एकर कारन हमर ददामन तलवार ले मारे गे हवंय अऊ हमर बेटा अऊ बेटी अऊ हमर घरवालीमन बंधुवई म चल दीन। <verse eid="2CH 29:9" /><verse number="10" style="v" sid="2CH 29:10" />अब मेंह यहोवा, इसरायल के परमेसर संग एक करार करे के इरादा करत हंव, ताकि ओकर भयंकर कोरोध ह हमर ऊपर ले दूर हो जावय। <verse eid="2CH 29:10" /><verse number="11" style="v" sid="2CH 29:11" />हे मोर बेटामन, अब लापरवाही झन करव, काबरकि यहोवा ह तुमन ला अपन आघू म खड़े होय बर अऊ ओकर सेवा करे बर, अऊ ओकर आघू म सेवा करे अऊ धूप जलाय बर चुने हवय।”<verse eid="2CH 29:11" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="2CH 29:12" />तब ये लेवीमन बुता करे लगिन:</para>
  <para style="b" vid="2CH 29:12" />
  <para style="li1" vid="2CH 29:12">कहातीमन ले:</para>
  <para style="li2" vid="2CH 29:12">अमासै के बेटा महत अऊ अजरयाह के बेटा योएल;</para>
  <para style="li1" vid="2CH 29:12">मरारीमन ले:</para>
  <para style="li2" vid="2CH 29:12">अब्दी के बेटा कीस अऊ यहल्लेलेल के बेटा अजरयाह;</para>
  <para style="li1" vid="2CH 29:12">गेरसोनीमन ले:</para>
  <para style="li2" vid="2CH 29:12">जिम्मा के बेटा योआह अऊ योआह के बेटा एदेन;<verse eid="2CH 29:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="2CH 29:13" />एलीसापान के संतानमन ले:</para>
  <para style="li2" vid="2CH 29:13">सिमरी अऊ येइल;</para>
  <para style="li1" vid="2CH 29:13">आसाप के संतानमन ले:</para>
  <para style="li2" vid="2CH 29:13">जकरयाह अऊ मतनयाह;<verse eid="2CH 29:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="2CH 29:14" />हेमान के संतानमन ले:</para>
  <para style="li2" vid="2CH 29:14">यहीएल अऊ सिमी;</para>
  <para style="li1" vid="2CH 29:14">यदूतून के संतानमन ले:</para>
  <para style="li2" vid="2CH 29:14">समायाह अऊ उजीएल।<verse eid="2CH 29:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="2CH 29:15" />जब ओमन अपन संगी लेवीमन ला संकेल लीन अऊ अपनआप ला पबितर कर लीन, तब ओमन यहोवा के बचन ला मानके मंदिर ला सुध करे बर गीन, जइसन कि राजा ह हुकूम दे रिहिस। <verse eid="2CH 29:15" /><verse number="16" style="v" sid="2CH 29:16" />पुरोहितमन यहोवा के पबितर-स्थान ला सुध करे बर गीन। ओमन यहोवा के मंदिर म जऊन भी असुध चीज पाईन, ओ जम्मो ला यहोवा के मंदिर के अंगना म बाहिर निकालिन। लेवीमन येला लेके किदरोन घाटी करा गीन। <verse eid="2CH 29:16" /><verse number="17" style="v" sid="2CH 29:17" />ओमन पहिला महिना के पहिला दिन संस्कार करे के सुरू करिन, अऊ ओही महिना के आठवां दिन ओमन यहोवा के मंडप म पहुंच गीन। ओमन अऊ आठ दिन यहोवा के मंदिर के संस्कार करिन अऊ ये काम ला ओमन पहिला महिना के सोलहवां दिन पूरा करिन।<verse eid="2CH 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 29:18" />तब ओमन राजा हिजकियाह करा गीन अऊ ये खबर दीन: “हमन यहोवा के पूरा मंदिर ला सुध कर ले हन—होम-बलिदान के बेदी के संग ओकर जम्मो बरतन, अऊ पबितर रोटी ला रखे बर मेज के संग ओकर जम्मो बरतन ला। <verse eid="2CH 29:18" /><verse number="19" style="v" sid="2CH 29:19" />हमन ओ जम्मो सामान ला तियार करके संस्कार करे हवन, जेमन ला आहाज ह जब ओह राजा रिहिस, त बिसवासघाती होके निकाल दे रिहिस। ओ चीजमन अब यहोवा के बेदी के आघू म हवंय।”<verse eid="2CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 29:20" />दूसर दिन बड़े बिहनियां राजा हिजकियाह ह सहर के करमचारीमन ला एक जगह म संकेलिस अऊ यहोवा के मंदिर म गीस। <verse eid="2CH 29:20" /><verse number="21" style="v" sid="2CH 29:21" />ओमन राज बर, पबितर-स्थान बर अऊ यहूदा बर पाप-बलिदान<note caller="+" style="f"><char style="fr" closed="false">29:21 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुधिकरन-बलिदान</char></note> के रूप म सात ठन बईला, सात ठन मेढ़ा, सात ठन मेढ़ा-पीला अऊ सात ठन बोकरा लानिन। राजा ह हारून के संतान, पुरोहितमन ला हुकूम दीस कि ओमन येमन ला यहोवा के बेदी म चघावंय। <verse eid="2CH 29:21" /><verse number="22" style="v" sid="2CH 29:22" />तब ओमन बईलामन ला बलि करिन, अऊ पुरोहितमन खून ला लेके बेदी म छिंच दीन; तब ओमन मेढ़ामन ला बलि करिन अऊ खून ला बेदी म छिंच दीन। तब ओमन मेढ़ा-पीलामन ला बलि करिन अऊ खून ला बेदी म छिंच दीन। <verse eid="2CH 29:22" /><verse number="23" style="v" sid="2CH 29:23" />पाप-बलिदान बर बोकरामन ला राजा अऊ सभा के आघू म लाने गीस, अऊ ओमन अपन हांथ ओ बोकरामन ऊपर रखिन। <verse eid="2CH 29:23" /><verse number="24" style="v" sid="2CH 29:24" />तब पुरोहितमन बोकरामन ला बलि करिन अऊ बेदी म खून ला जम्मो इसरायल के पछताप बर पाप-बलिदान के रूप म चघा दीन, काबरकि राजा हिजकियाह ह जम्मो इसरायल बर होम-बलिदान अऊ पाप-बलिदान के हुकूम देय रिहिस।<verse eid="2CH 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 29:25" />ओह यहोवा के मंदिर म लेवीमन ला मंजीरा, बीना अऊ सितार के संग दाऊद अऊ राजा के अगम-दरसी गाद अऊ अगमजानी नातान दुवारा बताय बिधि के मुताबिक तैनात करिस; येकर हुकूम यहोवा के दुवारा अगमजानीमन के जरिये देय गे रिहिस। <verse eid="2CH 29:25" /><verse number="26" style="v" sid="2CH 29:26" />तब लेवीमन दाऊद के बताय बाजामन ला अऊ पुरोहितमन अपन तुरहीमन ला लेके तियार खड़े हो गीन।<verse eid="2CH 29:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 29:27" />हिजकियाह ह बेदी म होम-बलिदान चघाय के हुकूम दीस। जब बलिदान चघाय के काम सुरू होईस, त तुरही अऊ इसरायल के राजा दाऊद के बाजामन संग, यहोवा बर गाना गवई घलो सुरू होईस। <verse eid="2CH 29:27" /><verse number="28" style="v" sid="2CH 29:28" />जम्मो सभा के मन अराधना म झुक गीन, जबकि संगीतकारमन बजाते रिहिन अऊ तुरहीमन बजते रिहिन। ये जम्मो ह तब तक चलते रिहिस, जब तक कि होम-बलिदान चघाय के काम ह पूरा नइं हो गीस।<verse eid="2CH 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 29:29" />जब बलिदान चघई के काम खतम हो गीस, तब राजा अऊ उहां ओकर संग म जूरे जम्मो मनखेमन माड़ी टेकके अराधना करिन। <verse eid="2CH 29:29" /><verse number="30" style="v" sid="2CH 29:30" />राजा हिजकियाह अऊ ओकर करमचारीमन लेवीमन ला हुकूम दीन कि ओमन दाऊद अऊ आसाप अगम-दरसी के सबदमन के संग यहोवा के परसंसा करंय। एकरसेति ओमन खुसी के संग भजन गाईन अऊ मुड़ नवाके अराधना करिन।<verse eid="2CH 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 29:31" />तब हिजकियाह ह कहिस, “तुमन अब अपनआप ला यहोवा ला समरपित कर देय हवव। आवव अऊ बलिदान अऊ धनबाद-बलिदान यहोवा के मंदिर म लानव।” एकरसेति सभा के मनखेमन बलिदान अऊ धनबाद-बलिदान लाईन, अऊ जेमन के मन होईस, ओ जम्मो झन होम-बलिदान लाईन।<verse eid="2CH 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 29:32" />सभा के दुवारा लाय गे होम-बलिदान म सत्तर ठन बईला, एक सौ मेढ़ा अऊ दू सौ मेढ़ा-पीला रिहिन—ये जम्मो यहोवा के होम-बलिदान बर रिहिन। <verse eid="2CH 29:32" /><verse number="33" style="v" sid="2CH 29:33" />सुध करे गय पसु, जेमन ला बलिदान के रूप म चघाना रिहिस, ओमन के गनती छै सौ बईला अऊ तीन हजार भेड़ अऊ बोकरामन रिहिन। <verse eid="2CH 29:33" /><verse number="34" style="v" sid="2CH 29:34" />पर होम-बलिदान के पसुमन के चमड़ी ला निकाले बर उहां बहुंत कम पुरोहितमन रिहिन; एकरसेति ओमन के सगा-संबंधी लेवीमन तब तक ओमन के मदद करिन, जब तक कि काम ह पूरा नइं हो गीस अऊ जब तक कि आने पुरोहितमन के संस्कार नइं करे गीस, काबरकि लेवीमन अपनआप ला पुरोहितमन के तुलना म जादा मन लगाके संस्कार करत रिहिन। <verse eid="2CH 29:34" /><verse number="35" style="v" sid="2CH 29:35" />उहां अब्बड़ अकन होम-बलिदान रिहिस, संग म मेल-बलिदान के चरबी अऊ होम-बलिदान के संग पेय-बलिदान घलो रिहिस।</para>
  <para style="p" vid="2CH 29:35">ये किसम ले यहोवा के मंदिर के सेवा ला फेर से स्थापित करे गीस। <verse eid="2CH 29:35" /><verse number="36" style="v" sid="2CH 29:36" />परमेसर ह अपन मनखेमन बर जऊन कुछू करे रिहिस, ओकर बर राजा हिजकियाह अऊ जम्मो मनखेमन आनंद मनाईन, काबरकि येला बहुंत जल्दी कर लेय गे रिहिस।<verse eid="2CH 29:36" /></para>
  <chapter eid="2CH 29" />
  <chapter number="30" style="c" sid="2CH 30" />
  <para style="s1">हिजकियाह ह फसह तिहार मनाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 30:1" />हिजकियाह ह जम्मो इसरायल अऊ यहूदा म खबर भेजिस अऊ एपरैम अऊ मनस्से ला घलो नेवता देवत चिट्ठी लिखिस कि तुमन यरूसलेम म यहोवा के मंदिर म आवव अऊ यहोवा, इसरायल के परमेसर के फसह के तिहार मनावव। <verse eid="2CH 30:1" /><verse number="2" style="v" sid="2CH 30:2" />राजा अऊ ओकर करमचारी अऊ सभा के जम्मो मनखेमन यरूसलेम म दूसर महिना म फसह के तिहार मनाय के फैसला करिन। <verse eid="2CH 30:2" /><verse number="3" style="v" sid="2CH 30:3" />ओमन ये तिहार ला नियमित रूप म नइं मनाय पाय रिहिन, काबरकि परयाप्त पुरोहितमन अपन संस्कार नइं करे रिहिन अऊ मनखेमन यरूसलेम म संकलाय नइं रिहिन। <verse eid="2CH 30:3" /><verse number="4" style="v" sid="2CH 30:4" />ये योजना ह राजा अऊ जम्मो सभा ला सही लगिस। <verse eid="2CH 30:4" /><verse number="5" style="v" sid="2CH 30:5" />ओमन पूरा इसरायल म बेरसेबा ले लेके दान तक एक घोसना करे के फैसला करिन कि मनखेमन यरूसलेम आवंय अऊ यहोवा, इसरायल के परमेसर के फसह के तिहार मनावंय। काबरकि ओमन अतेक बड़े संखिया म येला नइं मनाय रिहिन, जइसे कि किताब म लिखे गे रिहिस।<verse eid="2CH 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 30:6" />राजा के हुकूम ले, दूतमन राजा अऊ ओकर अधिकारीमन के चिट्ठी लेके इसरायल अऊ यहूदा के पूरा देस म गीन, अऊ चिट्ठी म ये लिखाय रहय:</para>
  <para style="pm" vid="2CH 30:6">“हे इसरायल के मनखेमन, यहोवा करा लहुंट आवव, जऊन ह अब्राहम, इसहाक अऊ इसरायल के परमेसर अय, ताकि ओह तुम्हर करा लहुंट आवय, जेमन बचे हवव, जेमन अस्सूर के राजामन के हांथ ले बांच गे हवव। <verse eid="2CH 30:6" /><verse number="7" style="v" sid="2CH 30:7" />अपन दाई-ददा अऊ अपन संगी इसरायलीमन असन झन बनव, जेमन यहोवा, अपन पुरखामन के परमेसर बर बिसवासघाती हो गीन, जेकर कारन ओह ओमन ला आतंक के चीज बना दीस, जइसे कि तुमन देखत हवव। <verse eid="2CH 30:7" /><verse number="8" style="v" sid="2CH 30:8" />अपन पुरखामन असन हठी झन बनव; यहोवा के अधीन होवव। ओकर पबितर-स्थान म आवव, जेला ओह हमेसा बर संस्कार करे हवय। यहोवा अपन परमेसर के सेवा करव, ताकि ओकर भयंकर कोरोध ह तुम्हर ले दूरिहा हो जावय। <verse eid="2CH 30:8" /><verse number="9" style="v" sid="2CH 30:9" />यदि तुमन यहोवा करा लहुंट आहू, त तुम्हर संगी इसरायली अऊ तुम्हर लइकामन ऊपर ओमन के कैद करइया दुवारा दया देखाय जाही अऊ ओमन ये देस म लहुंट आहीं, काबरकि यहोवा तुम्हर परमेसर ह अनुग्रह करइया अऊ दयालु अय। यदि तुमन ओकर करा लहुंट आहू, त ओह तुम्हर ले अपन मुहूं नइं मोड़य।”<verse eid="2CH 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 30:10" />दूतमन एपरैम अऊ मनस्से म नगर-नगर ले होवत जबूलून के इलाका तक गीन, पर मनखेमन ओमन के अपमान अऊ ठट्ठा करिन। <verse eid="2CH 30:10" /><verse number="11" style="v" sid="2CH 30:11" />तभो ले, आसेर, मनस्से अऊ जबूलून के कुछू मनखेमन अपनआप ला नम्र करके यरूसलेम चले गीन। <verse eid="2CH 30:11" /><verse number="12" style="v" sid="2CH 30:12" />यहूदा म घलो परमेसर के हांथ मनखेमन ऊपर रिहिस कि ओमन यहोवा के बचन म चलत राजा अऊ ओकर अधिकारीमन के हुकूम ला पूरा करे बर एक मन हो गीन।<verse eid="2CH 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 30:13" />दूसर महिना म अखमीरी रोटी के तिहार मनाय बर यरूसलेम म मनखेमन के एक बड़े भीड़ जूर गीस। <verse eid="2CH 30:13" /><verse number="14" style="v" sid="2CH 30:14" />ओमन यरूसलेम म बेदीमन ला हटा दीन अऊ धूप के बेदीमन ला हटाके ओमन ला किदरोन घाटी म फेंक दीन।<verse eid="2CH 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 30:15" />ओमन दूसर महिना के चौदहवां दिन फसह के मेढ़ा-पीला बलिदान करिन। पुरोहित अऊ लेवीमन सरमिंदा होईन अऊ ओमन अपनआप ला पबितर करिन अऊ यहोवा के मंदिर म होम-बलिदान लाईन। <verse eid="2CH 30:15" /><verse number="16" style="v" sid="2CH 30:16" />तब ओमन परमेसर के जन मूसा के कानून के मुताबिक अपन नियमित जगह ला लीन। पुरोहितमन लेवीमन के दुवारा देय गे खून ला बेदी म छिंच दीन। <verse eid="2CH 30:16" /><verse number="17" style="v" sid="2CH 30:17" />काबरकि भीड़ म बहुंते अइसे मनखे रिहिन, जेमन अपनआप ला पबितर नइं करे रिहिन, तेकर खातिर लेवीमन ला ओ जम्मो मनखेमन बर फसह के मेढ़ा-पीलामन ला मारे ला पड़िस, जेमन बिधि के मुताबिक सुध नइं होय रिहिन अऊ अपन मेढ़ा-पीलामन<note caller="+" style="f"><char style="fr" closed="false">30:17 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अपनआप</char></note> ला यहोवा बर संस्कार नइं कर सके रिहिन। <verse eid="2CH 30:17" /><verse number="18" style="v" sid="2CH 30:18" />हालाकि एपरैम, मनस्से, इस्साकार अऊ जबूलून ले आय बहुंत अकन मनखेमन अपनआप ला सुध नइं करे रिहिन, तभो ले कानून म लिखे बात के उल्टा ओमन फसह ला खा लीन। पर हिजकियाह ह ये कहिके ओमन बर पराथना करिस, “यहोवा, जऊन ह बने अय, जम्मो ला छेमा करय <verse eid="2CH 30:18" /><verse number="19" style="v" sid="2CH 30:19" />जऊन ह ओमन के मन ला अपन परमेसर के खोज म लगाथे—यहोवा, ओमन के पुरखामन के परमेसर—भले ही ओमन पबितर-स्थान के नियम के मुताबिक सुध नइं अंय।” <verse eid="2CH 30:19" /><verse number="20" style="v" sid="2CH 30:20" />अऊ यहोवा ह हिजकियाह के पराथना ला सुनिस अऊ मनखेमन ला चंगा करिस।<verse eid="2CH 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 30:21" />जऊन इसरायलीमन ओ समय यरूसलेम म रिहिन, ओमन सात दिन ले अखमीरी रोटी के तिहार अब्बड़ आनंद के संग मनाईन, जबकि लेवी अऊ पुरोहितमन हर दिन बाजामन के अवाज के संग यहोवा के परसंसा करत रिहिन।<verse eid="2CH 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 30:22" />हिजकियाह ह ओ जम्मो लेवीमन ला उत्साह के बात कहिस, जेमन यहोवा के सेवा म बने समझदारी देखाईन। काबरकि सात दिन तक ओमन अपन ठहिराय भाग ला खाईन अऊ मेल-बलिदान चघाईन अऊ यहोवा, अपन पुरखामन के परमेसर के परसंसा करिन।<note caller="+" style="f"><char style="fr" closed="false">30:22 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अपन पापमन ला मान लीन</char></note><verse eid="2CH 30:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 30:23" />तब सभा के जम्मो मनखेमन तिहार ला अऊ सात दिन तक मनाय बर सहमत हो गीन; एकरसेति अऊ सात दिन तक ओमन आनंद सहित तिहार मनाईन। <verse eid="2CH 30:23" /><verse number="24" style="v" sid="2CH 30:24" />यहूदा के राजा हिजकियाह ह सभा बर एक हजार बईला अऊ सात हजार भेड़ अऊ बकरी दीस, अऊ अधिकारीमन ओमन ला एक हजार बईला अऊ दस हजार भेड़ अऊ बकरी दीन। अब्बड़ संखिया म पुरोहितमन अपनआप ला पबितर करिन। <verse eid="2CH 30:24" /><verse number="25" style="v" sid="2CH 30:25" />यहूदा के जम्मो सभा ह पुरोहित अऊ लेवीमन संग आनंद मनाईस अऊ ओमन घलो जेमन इसरायल ले जमा होय रिहिन, ओमा ओ परदेसीमन घलो रिहिन, जेमन इसरायल ले आय रिहिन अऊ ओमन घलो जेमन यहूदा म रहत रिहिन। <verse eid="2CH 30:25" /><verse number="26" style="v" sid="2CH 30:26" />यरूसलेम म बहुंत आनंद मनाय गीस, काबरकि इसरायल के राजा दाऊद के बेटा सुलेमान के दिन ले यरूसलेम म अइसन उत्सव नइं मनाय गे रिहिस। <verse eid="2CH 30:26" /><verse number="27" style="v" sid="2CH 30:27" />पुरोहित अऊ लेवीमन मनखेमन ला आसीरबाद देय बर ठाढ़ हो गीन, अऊ परमेसर ह ओमन के सुनिस, काबरकि ओमन के पराथना ह स्वरग म, ओकर पबितर निवास म हबर गीस।<verse eid="2CH 30:27" /></para>
  <chapter eid="2CH 30" />
  <chapter number="31" style="c" sid="2CH 31" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 31:1" />जब ये सबो काम खतम हो गीस, तब जऊन इसरायलीमन उहां रिहिन, ओमन यहूदा के सहरमन म गीन अऊ पबितर पथरामन ला कुटा-कुटा कर दीन अऊ असेरा देवी के खंभामन ला काटके गिरा दीन। ओमन पूरा यहूदा अऊ बिनयामीन अऊ एपरैम अऊ मनस्से के ऊंच जगह अऊ बेदीमन ला नास कर दीन। ओ सब ला नास करे के बाद, इसरायलीमन अपन-अपन सहर अऊ अपन जमीन-जायजाद म लहुंट गीन।<verse eid="2CH 31:1" /></para>
  <para style="s1">अराधना बर भेंट</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 31:2" />राजा हिजकियाह ह पुरोहित अऊ लेवीमन ला दल म बांट दीस—ओमा के हर एक ला ओमन के बुता के मुताबिक पुरोहित या लेवी के रूप म—ताकि ओमन होम-बलिदान अऊ मेल-बलिदान चघावंय, सेवा करंय, धनबाद देवंय अऊ यहोवा के निवास के दुवारमन म परसंसा के गीत गावंय। <verse eid="2CH 31:2" /><verse number="3" style="v" sid="2CH 31:3" />राजा ह बिहनियां अऊ संझा के होम-बलिदान अऊ बिसराम दिन के होम-बलिदान, नवां चंदा म अऊ यहोवा के कानून म लिखके ठहिराय तिहारमन बर अपन खुद के धन ले दान करिस। <verse eid="2CH 31:3" /><verse number="4" style="v" sid="2CH 31:4" />ओह यरूसलेम म रहइया मनखेमन ला हुकूम दीस कि ओमन पुरोहित अऊ लेवीमन ला ओमन के भाग देवंय, ताकि ओमन अपनआप ला यहोवा के कानून बर अरपित कर सकंय। <verse eid="2CH 31:4" /><verse number="5" style="v" sid="2CH 31:5" />जइसे ही ये हुकूम दिये गीस, इसरायलीमन उदारता ले अपन अनाज के पहिला फर, नवां अंगूर के मंद, जैतून तेल अऊ मंधरस अऊ खेत के जम्मो किसम के ऊपज ला दीन। ओमन अब्बड़ मात्रा म, सबो चीज के दसमांस ला लेके आईन। <verse eid="2CH 31:5" /><verse number="6" style="v" sid="2CH 31:6" />यहूदा के नगरमन म रहइया इसरायल अऊ यहूदा के मनखेमन घलो अपन गाय-बईला अऊ भेड़-बकरीमन के झुंड ले दसमांस अऊ यहोवा ओमन के परमेसर ला समरपित पबितर चीजमन के दसमांस लेके आईन, अऊ ओला कुढ़ोके ढेर कर दीन। <verse eid="2CH 31:6" /><verse number="7" style="v" sid="2CH 31:7" />ओमन तीसर महिना म अइसने करे के सुरू करिन अऊ सातवां महिना म खतम करिन। <verse eid="2CH 31:7" /><verse number="8" style="v" sid="2CH 31:8" />जब हिजकियाह अऊ ओकर करमचारीमन आके कुढ़ा के ये ढेर ला देखिन, तब ओमन यहोवा के परसंसा करिन अऊ इसरायल के मनखेमन ला आसीस दीन।<verse eid="2CH 31:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 31:9" />हिजकियाह ह पुरोहित अऊ लेवीमन ले कुढ़ा के बारे म पुछिस; <verse eid="2CH 31:9" /><verse number="10" style="v" sid="2CH 31:10" />सादोक के परिवार ले, अजरयाह मुखिया पुरोहित ह जबाब दीस, “जब ले मनखेमन यहोवा के मंदिर म अपन भेंट ला देय के सुरू करे हवंय, तब ले हमर करा खाय बर परयाप्त जेवन हवय अऊ बहुंत बांच घलो जावत हे, काबरकि यहोवा ह अपन मनखेमन ला आसीस देय हवय, अऊ अब्बड़ अकन बचे घलो हवय।”<verse eid="2CH 31:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 31:11" />हिजकियाह ह यहोवा के मंदिर म भंडारघरमन ला तियार करे के हुकूम दीस, अऊ ये काम ला करे गीस। <verse eid="2CH 31:11" /><verse number="12" style="v" sid="2CH 31:12" />तब ओमन बिसवास सहित भेंट, दसमांस अऊ समरपित भेंट लाईन। एक लेवी कोनन्याह ह ये चीजमन के अधिकारी रिहिस अऊ ओकर बाद ओकर भाई सिमी ह अधिकारी रिहिस। <verse eid="2CH 31:12" /><verse number="13" style="v" sid="2CH 31:13" />यहीएल, अजजियाह, नहत, असाहेल, यरीमोत, योजाबाद, एलीएल, यिसमाकियाह, महत अऊ बनायाह—येमन कोनन्याह अऊ ओकर भाई सिमी के सहायक रिहिन। ये जम्मो झन राजा हिजकियाह अऊ परमेसर के मंदिर के अधिकारी अजरयाह के हुकूम ले सेवा करत रिहिन।<verse eid="2CH 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 31:14" />पूरब दुवार के रखवार यिमना लेवी के बेटा कोरे ऊपर परमेसर ला देय गे स्वेच्छा-बलिदान के जबाबदारी रिहिस, जऊन ह यहोवा ला देय गे दान अऊ पबितर भेंट ला बांटय। <verse eid="2CH 31:14" /><verse number="15" style="v" sid="2CH 31:15" />एदेन, मिनयामीन, येहोसू, समायाह, अमरयाह अऊ सेकनयाह, पुरोहितमन के नगरमन म बिसवास के संग ओकर मदद करिन, अऊ ओमन के संगी पुरोहितमन ला ओमन के दल के मुताबिक दान अऊ भेंट ला बांट दीन, डोकरा अऊ जवान जम्मो ला एक समान बांटिन।<verse eid="2CH 31:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 31:16" />येकर अलावा, ओमन तीन साल या ओकर ले जादा उमर के ओ पुरूसमन ला बांटिन जेमन के नांव बंसावली म लिखे गे रिहिस—ओ जम्मो, जेमन अपन जबाबदारी अऊ अपन दल के मुताबिक, अपन अलग-अलग किसम के रोज के बुता बर यहोवा के मंदिर म प्रवेस करहीं। <verse eid="2CH 31:16" /><verse number="17" style="v" sid="2CH 31:17" />अऊ ओमन पुरोहितमन ला ओमन के परिवार के बंसावली के लेखा-जोखा के मुताबिक अऊ अइसने ही बीस साल या ओकर ले जादा उमर के लेवीमन ला, ओमन के जिम्मेदारी अऊ दल के मुताबिक बांट दीन। <verse eid="2CH 31:17" /><verse number="18" style="v" sid="2CH 31:18" />ओमन जम्मो छोटे लइका, घरवाली, अऊ ओ पूरा समाज के बेटा-बेटीमन ला सामिल करिन, जऊन मन के नांव ये बंसावली के लेखा-जोखा म लिखाय रिहिस। काबरकि ओमन अपनआप ला पबितर करे म बिसवासयोग्य रिहिन।<verse eid="2CH 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 31:19" />जहां तक हारून के संतान, पुरोहितमन के बात ए, जेमन अपन नगरमन के चारों कोति चराईवाले मैदान म या कोनो आने नगर म रहत रिहिन, ओमन के पुरूसमन ला ओमन के नांव के मुताबिक ठहिराय गीस, ताकि ओमन अपन बीच म ले हर एक पुरूस ला अऊ ओ जम्मो ला, जेमन के नांव लेवीमन के बंसावली म लिखे गे रिहिस, ओमन के भाग ला बांट देवंय।<verse eid="2CH 31:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 31:20" />हिजकियाह ह ये काम ला पूरा यहूदा प्रदेस म करिस, ओह ओ काम करिस, जऊन ह यहोवा ओकर परमेसर के नजर म बने अऊ सही अऊ बिसवास के लईक रिहिस। <verse eid="2CH 31:20" /><verse number="21" style="v" sid="2CH 31:21" />हर ओ काम, जेला ओह परमेसर के मंदिर के सेवा म अऊ कानून अऊ हुकूम के पालन म करिस, ओह हमेसा परमेसर के खोज म सबो काम ला पूरा मन से करिस। अऊ ये किसम ले ओह उन्नति करत गीस।<verse eid="2CH 31:21" /></para>
  <chapter eid="2CH 31" />
  <chapter number="32" style="c" sid="2CH 32" />
  <para style="s1">यरूसलेम ला सनहेरीब के धमकी</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 32:1" />हिजकियाह के दुवारा ये जम्मो काम ला बिसवासयोग्यता से पूरा करे के बाद, अस्सूर के राजा सनहेरीब ह आके यहूदा ऊपर हमला कर दीस। ओह गढ़वाला सहरमन ला घेर लीस, ये सोचके कि ये सहरमन ला ओह अपन बर जीत लीही। <verse eid="2CH 32:1" /><verse number="2" style="v" sid="2CH 32:2" />जब हिजकियाह ह देखिस कि सनहेरीब ह आय हवय अऊ ओह यरूसलेम के बिरूध लड़ई करे के इरादा रखथे, <verse eid="2CH 32:2" /><verse number="3" style="v" sid="2CH 32:3" />त हिजकियाह ह अपन करमचारी अऊ सेना के करमचारीमन ले सलाह लीस कि सहर के बाहिर पानी के सोता ला रोके जावय, अऊ ओमन ओकर मदद करिन। <verse eid="2CH 32:3" /><verse number="4" style="v" sid="2CH 32:4" />ओमन मनखेमन के एक बड़े दल ला संकेलिन, जऊन मन देस म होके बहत जम्मो सोता अऊ झरनामन ला रोक दीन। ओमन कहिन, “अस्सूर के राजा ह काबर आवय अऊ ओला अब्बड़ अकन पानी मिलय?” <verse eid="2CH 32:4" /><verse number="5" style="v" sid="2CH 32:5" />तब हिजकियाह ह दीवार के जम्मो टूटे भाग के मरम्मत अऊ येकर ऊपर मीनारमन ला बनाय के कठिन बुता ला करिस। ओह ओकर बाहिर म एक अऊ दीवार बनाईस अऊ दाऊद के सहर के छतमन ला मजबूत करिस। ओह अब्बड़ संखिया म हथियार अऊ ढालमन ला घलो बनाईस।<verse eid="2CH 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 32:6" />ओह मनखेमन ऊपर सेना के अधिकारीमन ला ठहिरा दीस अऊ ओमन ला अपन सामने चऊक म सहर के दुवार करा संकेलिस अऊ ये बात कहिके ओमन ला उत्साहित करिस: <verse eid="2CH 32:6" /><verse number="7" style="v" sid="2CH 32:7" />“मजबूत अऊ साहसी बनव। अस्सूर के राजा अऊ ओकर बड़े सेना के कारन झन डरव अऊ हतास झन होवव, काबरकि ओकर ले बड़े ताकत हमर संग हवय। <verse eid="2CH 32:7" /><verse number="8" style="v" sid="2CH 32:8" />ओकर संग सिरिप हाड़-मांस के हांथ हवय, पर हमर संग यहोवा हमर परमेसर हमर मदद करे बर अऊ हमर लड़ई लड़े बर हवय।” अऊ यहूदा के राजा हिजकियाह के बात ले मनखेमन के भरोसा ह बढ़िस।<verse eid="2CH 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 32:9" />बाद म, जब अस्सूर के राजा सनहेरीब अऊ ओकर जम्मो सेनामन लाकीस नगर ला घेरे रिहिन, तब ओह अपन अधिकारीमन ला यहूदा के राजा हिजकियाह अऊ उहां रहइया जम्मो यहूदा के मनखेमन करा ये संदेस के संग यरूसलेम भेजिस:<verse eid="2CH 32:9" /></para>
  <para style="pm">
    <verse number="10" style="v" sid="2CH 32:10" />“अस्सूर के राजा सनहेरीब ह ये कहत हे: तुमन का बात के ऊपर भरोसा करके यरूसलेम के भीतर म घेराय बईठे हवव? <verse eid="2CH 32:10" /><verse number="11" style="v" sid="2CH 32:11" />जब हिजकियाह ह कहिथे, ‘यहोवा हमर परमेसर ह हमन ला अस्सूर के राजा के हांथ ले बचाही,’ त ओह तुमन ला बहकावत हे, ताकि तुमन भूख अऊ पीयास म मर जावव। <verse eid="2CH 32:11" /><verse number="12" style="v" sid="2CH 32:12" />का हिजकियाह ह खुद देवतामन के ये ऊंच जगह अऊ बेदीमन ला यहूदा अऊ यरूसलेम ले ये कहिके नइं हटा दीस, ‘तुमन एकेच बेदी के आघू म अराधना करव अऊ ओमा बलिदान चघावव’?<verse eid="2CH 32:12" /></para>
  <para style="pm">
    <verse number="13" style="v" sid="2CH 32:13" />“का तुमन नइं जानव कि में अऊ मोर ले पहिले के राजामन आने देसमन के जम्मो मनखेमन संग का करे हवंय? का ओ जातिमन के देवतामन कभू अपन देस ला मोर हांथ ले छुड़ाय पाईन? <verse eid="2CH 32:13" /><verse number="14" style="v" sid="2CH 32:14" />ओ जातिमन के जम्मो देवता, जेमन ला मोर ले पहिले के राजामन नास कर दीन, ओमा के कोन ह अपन मनखेमन ला मोर ले बचा सकिस? तब तुम्हर देवता ह तुमन ला मोर हांथ ले कइसे छुड़ा सकथे? <verse eid="2CH 32:14" /><verse number="15" style="v" sid="2CH 32:15" />अब हिजकियाह ह तुमन ला धोखा झन देवय, अऊ तुमन ला अइसन झन बहकावय। ओकर ऊपर बिसवास झन करव, काबरकि कोनो भी देस या राज के देवता ह अपन मनखेमन ला मोर हांथ ले या मोर पुरखामन के हांथ ले नइं छुड़ा सके हवय। त फेर तुम्हर देवता ह तुमन ला मोर हांथ ले कइसे छुड़ाही!”<verse eid="2CH 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 32:16" />सनहेरीब के अधिकारीमन यहोवा परमेसर के बिरूध अऊ ओकर सेवक हिजकियाह के बिरूध अऊ बात कहिन। <verse eid="2CH 32:16" /><verse number="17" style="v" sid="2CH 32:17" />राजा ह घलो यहोवा, इसरायल के परमेसर के ठट्ठा करत अऊ ओकर बिरूध ये कहत चिट्ठी लिखिस: “जइसे कि आने देसमन के मनखेमन के देवतामन अपन मनखेमन ला मोर हांथ ले नइं बचाईन, वइसे ही हिजकियाह के देवता ह घलो ओकर मनखेमन ला मोर हांथ ले नइं बचा सकही।” <verse eid="2CH 32:17" /><verse number="18" style="v" sid="2CH 32:18" />तब ओमन यरूसलेम के मनखेमन ला जेमन दीवार ऊपर रिहिन, इबरानी म ऊंचहा अवाज म कहिन, ताकि ओमन आतंकित हो जावंय अऊ डर जावंय, अऊ सहर म सनहेरीब के अधिकारीमन कब्जा कर लेवंय। <verse eid="2CH 32:18" /><verse number="19" style="v" sid="2CH 32:19" />ओमन यरूसलेम के परमेसर के बारे म वइसे कहिन, जइसे ओमन संसार के आने मनखेमन के देवतामन के बारे म कहे रिहिन—जेमन मनखे के हांथ के काम अंय।<verse eid="2CH 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 32:20" />राजा हिजकियाह अऊ आमोस के बेटा अगमजानी यसायाह ह ये बारे म स्वरग के परमेसर ले चिल्लाके पराथना करिन। <verse eid="2CH 32:20" /><verse number="21" style="v" sid="2CH 32:21" />अऊ यहोवा ह एक स्वरगदूत ला भेजिस, जऊन ह अस्सूर के राजा के डेरा म जम्मो सैनिक अऊ सेनापति अऊ अधिकारीमन के पूरा सतियानास कर दीस। तब सनहेरीब ह कलंकित होके अपन देस चल दीस। अऊ जब ओह अपन देवता के मंदिर म गीस, तब ओकर कुछू बेटामन, जेमन ओकर खुद के मांस अऊ लहू रिहिन, ओला तलवार ले मार डालिन।<verse eid="2CH 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 32:22" />ये किसम ले यहोवा ह हिजकियाह अऊ यरूसलेम के मनखेमन ला अस्सूर के राजा सनहेरीब के हांथ ले अऊ जम्मो आने मन के हांथ ले बचाईस। यहोवा ह हर कोति ले ओमन के खियाल रखिस। <verse eid="2CH 32:22" /><verse number="23" style="v" sid="2CH 32:23" />बहुंत मनखेमन यरूसलेम म यहोवा बर भेंट अऊ यहूदा के राजा हिजकियाह बर कीमती उपहार लाईन। तब ले जम्मो जाति के मनखेमन हिजकियाह के बहुंत आदर करे लगिन।<verse eid="2CH 32:23" /></para>
  <para style="s1">हिजकियाह के घमंड, सफलता अऊ मिरतू</para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 32:24" />ओ समय म, हिजकियाह ह बेमार हो गीस अऊ मरइयाच रिहिस। ओह यहोवा ले पराथना करिस, अऊ यहोवा ह ओला जबाब दीस अऊ ओला एक अद्भूत चिनहां दीस। <verse eid="2CH 32:24" /><verse number="25" style="v" sid="2CH 32:25" />पर हिजकियाह के हिरदय ह घमंड ले भर गीस, अऊ ओह ओकर ऊपर करे गे दया के मुताबिक काम नइं करिस; एकरसेति यहोवा के कोरोध ह ओकर ऊपर अऊ यहूदा अऊ यरूसलेम ऊपर भड़किस। <verse eid="2CH 32:25" /><verse number="26" style="v" sid="2CH 32:26" />तब हिजकियाह ह अपन हिरदय के घमंड ले पछताप करिस, अऊ वइसने ही यरूसलेम के मनखेमन घलो पछताप करिन; एकरसेति यहोवा के कोप ह ओमन के ऊपर हिजकियाह के दिन म नइं आईस।<verse eid="2CH 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 32:27" />हिजकियाह करा अब्बड़ अकन धन रिहिस अऊ ओकर मान-सम्मान रिहिस, अऊ ओह अपन सोन अऊ चांदी बर अऊ अपन कीमती पथरा, मसाला, ढाल अऊ जम्मो किसम के कीमती सामान बर भंडार बनवाईस। <verse eid="2CH 32:27" /><verse number="28" style="v" sid="2CH 32:28" />ओह अनाज के फसल, नवां अंगूर के मंद अऊ जैतून तेल ला रखे बर भवन घलो बनवाईस; अऊ ओह आने-आने किसम के पसुमन बर कोठा, अऊ भेड़-बकरीमन बर बाड़ा बनवाईस। <verse eid="2CH 32:28" /><verse number="29" style="v" sid="2CH 32:29" />ओह गांवमन ला बनाईस, अऊ अब्बड़ अकन भेड़-बकरी अऊ गाय-बईलामन ला संकेलिस, काबरकि परमेसर ह ओला अब्बड़ अकन संपत्ति देय रिहिस।<verse eid="2CH 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CH 32:30" />येह हिजकियाह ही रिहिस, जऊन ह गीहोन सोता के ऊपर के नाली ला बंद कर दीस अऊ दाऊद के सहर के पछिम कोति ओ पानी के बहाव ला कर दीस। ओह जऊन कुछू भी करिस, ओमा ओला सफलता मिलिस। <verse eid="2CH 32:30" /><verse number="31" style="v" sid="2CH 32:31" />पर जब बेबिलोन के सासन करइयामन ओकर ले ओ देस म होय अद्भूत चिनहां के बारे म पुछे बर दूतमन ला भेजिन, तब परमेसर ह ओला परखे बर अऊ जऊन कुछू ओकर हिरदय म रिहिस, ओ सबो ला जाने बर ओला छोंड़ दीस।<verse eid="2CH 32:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 32:32" />हिजकियाह के राज के आने घटनामन अऊ ओकर भक्ति के काम आमोस के बेटा अगमजानी यसायाह के दरसन म यहूदा अऊ इसरायल के राजामन के किताब म लिखे गे हवय। <verse eid="2CH 32:32" /><verse number="33" style="v" sid="2CH 32:33" />हिजकियाह ह अपन पुरखामन के संग हमेसा बर सुत गीस अऊ ओला ओ पहाड़ी म माटी देय गीस, जिहां दाऊद के संतानमन के कबरमन हवंय। जब ओह मरिस, त जम्मो यहूदा अऊ यरूसलेम के मनखेमन ओकर आदर करिन। अऊ ओकर बेटा मनस्से ह ओकर जगह म राजा बनिस।<verse eid="2CH 32:33" /></para>
  <chapter eid="2CH 32" />
  <chapter number="33" style="c" sid="2CH 33" />
  <para style="s1">मनस्से, यहूदा के राजा</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 33:1" />मनस्से ह बारह साल के रिहिस, जब ओह राजा बनिस, अऊ ओह यरूसलेम म पचपन साल तक राज करिस। <verse eid="2CH 33:1" /><verse number="2" style="v" sid="2CH 33:2" />ओह यहोवा के नजर म दुस्ट काम करिस, ओह ओ जातिमन के घिनित काममन के पाछू चलिस, जेमन ला यहोवा ह इसरायलीमन के आघू ले भगा दे रिहिस। <verse eid="2CH 33:2" /><verse number="3" style="v" sid="2CH 33:3" />ओह ओ ऊंचहा जगहमन ला फेर बनाईस, जेमन ला ओकर ददा हिजकियाह ह गिरा दे रिहिस; ओह बाल देवतामन बर बेदीमन ला अऊ असेरा देवी के खंभामन ला बनाईस। ओह जम्मो तारामन के समूह ला दंडवत करके ओमन के अराधना करिस। <verse eid="2CH 33:3" /><verse number="4" style="v" sid="2CH 33:4" />ओह यहोवा के मंदिर म बेदीमन ला बनाईस, जेकर बारे म यहोवा ह कहे रिहिस, “मोर नांव यरूसलेम म हमेसा बने रहिही।” <verse eid="2CH 33:4" /><verse number="5" style="v" sid="2CH 33:5" />यहोवा के मंदिर के दूनों अंगना म, ओह जम्मो तारामन के समूह बर बेदीमन ला बनाईस। <verse eid="2CH 33:5" /><verse number="6" style="v" sid="2CH 33:6" />ओह बेन-हिन्नोम के घाटी म अपन लइकामन ला आगी म बलिदान कर दीस, ओह सकुन-बिचार अऊ जादू-टोना करवाईस, सुभ-असुभ समय ला मानिस, अऊ बईगा अऊ भूत-परेत साधकमन ले सलाह लीस। ओह यहोवा के नजर म बहुंत दुस्ट काम करिस अऊ ओकर कोरोध ला भड़काईस।<verse eid="2CH 33:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 33:7" />ओह अपन बनाय मूरती ला लीस अऊ ओला परमेसर के मंदिर म रखिस, जेकर बारे म परमेसर ह दाऊद अऊ ओकर बेटा सुलेमान ला कहे रिहिस, “इसरायल के जम्मो गोत्र म ले, मेंह ये मंदिर अऊ यरूसलेम ला चुने हंव अऊ इहां मेंह अपन नांव ला सदाकाल बर रखहूं। <verse eid="2CH 33:7" /><verse number="8" style="v" sid="2CH 33:8" />मेंह इसरायलीमन ला ओ देस ले फेर नइं निकालहूं, जेला मेंह तोर पुरखामन ला देय हंव, पर ओमन ला सिरिप ये करना हे कि मूसा के जरिये दिये गय मोर जम्मो कानून, बिधि अऊ नियम के ओमन धियान देके पालन करंय।” <verse eid="2CH 33:8" /><verse number="9" style="v" sid="2CH 33:9" />पर मनस्से ह यहूदा अऊ यरूसलेम के मनखेमन ला इहां तक भटका दीस, कि ओमन ओ जाति ले घलो जादा दुस्ट काम करिन, जेमन ला यहोवा ह इसरायलीमन के आघू ले नास कर दे रिहिस।<verse eid="2CH 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 33:10" />यहोवा ह मनस्से अऊ ओकर मनखेमन ले गोठियाईस, पर ओमन धियान नइं दीन। <verse eid="2CH 33:10" /><verse number="11" style="v" sid="2CH 33:11" />एकरसेति यहोवा ह ओमन के बिरूध अस्सूर के राजा के सेना के सेनापतिमन के दुवारा हमला करवाईस, जेमन मनस्से ला बंदी बना लीन अऊ ओकर नाक म एक नकेल डाल दीन अऊ ओला कांसा के बेड़ी म जकड़के बेबिलोन सहर ले गीन। <verse eid="2CH 33:11" /><verse number="12" style="v" sid="2CH 33:12" />ये दुख के बेरा, मनस्से ह यहोवा अपन परमेसर ले दया के भीख मांगिस अऊ अपन पुरखामन के परमेसर के आघू म अपनआप ला बहुंत दीन-हीन करिस। <verse eid="2CH 33:12" /><verse number="13" style="v" sid="2CH 33:13" />अऊ जब ओह यहोवा ले पराथना करिस, त यहोवा ह ओकर बिनती ले पिघल गीस अऊ ओकर पराथना ला सुनिस, अऊ ओह ओला वापिस यरूसलेम अऊ ओकर राज म लहुंटा ले आईस। तब मनस्से ह जानिस कि यहोवा ह परमेसर ए।<verse eid="2CH 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 33:14" />ओकर बाद ओह दाऊद के सहर के बाहिरी दीवार ला फेर बनाईस, जऊन ह घाटी म गीहोन नाला के पछिम कोति मछरी दुवार तक हवय अऊ ओह ओपेल के पहाड़ी तक घेरा लगा दीस; ओह येला अऊ जादा ऊंच बनाईस। ओह यहूदा के जम्मो गढ़वाले सहर म सेना के सेनापतिमन ला ठहिराईस।<verse eid="2CH 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 33:15" />ओह पराया देवतामन ला अऊ यहोवा के मंदिर ले मूरती ला निकाल दीस, अऊ संग म ओ जम्मो बेदी, जेमन ला ओह मंदिर के पहाड़ी अऊ यरूसलेम म बनाय रिहिस, ओ जम्मो ला घलो सहर के बाहिर फेंक दीस। <verse eid="2CH 33:15" /><verse number="16" style="v" sid="2CH 33:16" />तब ओह यहोवा के बेदी ला फेर स्थापित करिस अऊ येमा मेल-बलिदान अऊ धनबाद-बलिदान चघाईस अऊ यहूदीमन ला यहोवा इसरायल के परमेसर के सेवा करे बर कहिस। <verse eid="2CH 33:16" /><verse number="17" style="v" sid="2CH 33:17" />तभो ले मनखेमन ऊंच जगहमन म बलिदान चघाना जारी रखिन, पर सिरिप यहोवा अपन परमेसर ला।<verse eid="2CH 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 33:18" />मनस्से के राज के आने घटनामन, परमेसर ले करे गय ओकर पराथना अऊ यहोवा, इसरायल के परमेसर के नांव म अगम-दरसीमन के दुवारा ओला कहे गय बचन, ये जम्मो बातमन इसरायल के राजामन के इतिहास के किताब म लिखे हवंय। <verse eid="2CH 33:18" /><verse number="19" style="v" sid="2CH 33:19" />ओकर पराथना अऊ परमेसर ह कइसे ओकर बिनती ले पिघल गीस, येकर अलावा अपनआप ला नम्र करे के पहिले ओकर जम्मो पाप अऊ बिसवासघात, अऊ ओ जगहमन जिहां ओह ऊंचहा जगहमन ला बनाईस अऊ असेरा देवी के खंभा अऊ मूरतीमन ला स्थापित करिस—ये जम्मो बात अगमजानीमन के अभिलेख म लिखे हवय। <verse eid="2CH 33:19" /><verse number="20" style="v" sid="2CH 33:20" />मनस्से ह हमेसा बर अपन पुरखामन के संग सुत गीस अऊ ओला ओकर महल म माटी दिये गीस। अऊ ओकर बेटा आमोन ह ओकर जगह म राजा बनिस।<verse eid="2CH 33:20" /></para>
  <para style="s1">यहूदा के राजा आमोन</para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 33:21" />आमोन ह बाईस साल के रिहिस, जब ओह राजा बनिस, अऊ ओह यरूसलेम म दू साल तक राज करिस। <verse eid="2CH 33:21" /><verse number="22" style="v" sid="2CH 33:22" />ओह यहोवा के नजर म दुस्ट काम करिस, जइसे कि ओकर ददा मनस्से ह करे रिहिस। आमोन ह अपन ददा मनस्से के बनाय जम्मो मूरतीमन के अराधना करिस अऊ ओमन ला बलिदान चघाईस। <verse eid="2CH 33:22" /><verse number="23" style="v" sid="2CH 33:23" />पर अपन ददा मनस्से के सहीं, ओह अपनआप ला यहोवा के आघू म नम्र नइं करिस; आमोन ह अऊ जादा अपराध करत गीस।<verse eid="2CH 33:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 33:24" />आमोन के करमचारीमन ओकर बिरूध साजिस करिन अऊ ओकर महल म ओला मार डारिन। <verse eid="2CH 33:24" /><verse number="25" style="v" sid="2CH 33:25" />तब देस के मनखेमन ओ जम्मो झन ला मार डारिन, जेमन राजा आमोन के बिरूध साजिस करे रिहिन, अऊ ओमन ओकर बेटा योसियाह ला ओकर जगह म राजा बनाईन।<verse eid="2CH 33:25" /></para>
  <chapter eid="2CH 33" />
  <chapter number="34" style="c" sid="2CH 34" />
  <para style="s1">योसियाह के सुधार के काम</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 34:1" />योसियाह ह आठ साल के रिहिस, जब ओह राजा बनिस, अऊ ओह यरूसलेम म इकतीस साल तक राज करिस। <verse eid="2CH 34:1" /><verse number="2" style="v" sid="2CH 34:2" />ओह ओ काम करिस, जऊन ह यहोवा के नजर म सही रिहिस अऊ अपन पुरखा दाऊद के रसता म चलिस; ओकर ले ओह न तो जेवनी कोति मुड़िस अऊ न ही डेरी कोति।<verse eid="2CH 34:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 34:3" />अपन राज के आठवां साल म, जब ओह जवान ही रिहिस, तभे ओह अपन पुरखा दाऊद के परमेसर के खोज म लग गे रिहिस। अपन राज के बारहवां साल म, ओह पूजा के ऊंचहा जगह, असेरा के खंभा अऊ मूरतीमन ला हटाके यहूदा अऊ यरूसलेम ला सुध करे लगिस। <verse eid="2CH 34:3" /><verse number="4" style="v" sid="2CH 34:4" />ओकर हुकूम ले बाल देवता के बेदीमन ला टोरके गिरा दिये गीस; ओह ओमन के ऊपर के धूप के बेदीमन ला कुटा-कुटा कर दीस, अऊ असेरा के खंभा अऊ मूरतीमन ला चूर-चूर कर दीस। येमन ला ओह कुटा-कुटा करके, ओ कुटामन ला ओ मनखेमन के कबर ऊपर फेंकवा दीस, जेमन येकर ऊपर बलिदान चघांय। <verse eid="2CH 34:4" /><verse number="5" style="v" sid="2CH 34:5" />ओह ओ बेदीमन म सेवा करइया पुरोहितमन के हाड़ा ला जला दीस, अऊ ये किसम ले ओह यहूदा अऊ यरूसलेम ला सुध करिस। <verse eid="2CH 34:5" /><verse number="6" style="v" sid="2CH 34:6" />मनस्से, एपरैम अऊ सिमोन, इहां तक कि नपताली तक के नगरमन म, अऊ ओमन के आसपास खंडहरमन म, <verse eid="2CH 34:6" /><verse number="7" style="v" sid="2CH 34:7" />ओह बेदी अऊ असेरा के खंभामन ला टोरके गिरा दीस अऊ मूरतीमन ला कुचरके चूरा बना दीस अऊ पूरा इसरायल म जम्मो धूप के बेदीमन ला काटके कुटा-कुटा कर दीस। तब ओह वापिस यरूसलेम चल दीस।<verse eid="2CH 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 34:8" />अपन राज के अठारहवां साल म, योसियाह ह देस अऊ मंदिर ला सुध कर लीस। तब ओह असलियाह के बेटा सापान अऊ सहर के हाकिम मासेयाह के संग योआहाज के बेटा इतिहास के लेखक योआह ला यहोवा अपन परमेसर के मंदिर ला मरम्मत करे बर पठोईस।<verse eid="2CH 34:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 34:9" />तब ओमन हिलकियाह महा पुरोहित करा गीन अऊ परमेसर के मंदिर म लाने गय ओ पईसा ओला दीन, जेला दुवारपाल के काम करइया लेवीमन मनस्से, एपरैम अऊ इसरायल के बांचे जम्मो मनखे अऊ यहूदा अऊ बिनयामीन के जम्मो मनखे अऊ यरूसलेम म रहइया मनखेमन ले जमा करे रिहिन। <verse eid="2CH 34:9" /><verse number="10" style="v" sid="2CH 34:10" />तब ओमन ओ पईसा ला ओ मनखेमन के हांथ म सऊंप दीन, जेमन ला यहोवा के मंदिर के काम के देखरेख बर ठहिराय गे रिहिस। ये मनखेमन ओ पईसा मंदिर के मरम्मत अऊ सुधार करइयामन ला दीन। <verse eid="2CH 34:10" /><verse number="11" style="v" sid="2CH 34:11" />ओमन बढ़ई अऊ भवन बनानेवालामन ला पईसा दीन, ताकि ओमन ओ भवन बर गढ़े पथरा, जोड़े बर लकड़ी अऊ बल्ला बिसावंय, काबरकि भवन के गिरके नास होय म यहूदा के राजामन के सहमती रिहिस।<verse eid="2CH 34:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 34:12" />काम करइयामन बिसवासयोग्यता से काम करिन। येमन के काम के देखरेख करइयामन मरारी के संतान लेवी—यहत अऊ ओबदयाह, कहात के संतान—जकरयाह अऊ मसुल्लाम रिहिन। ओ जम्मो लेवी, जेमन अलग-अलग किसम के बाजा बजाय म कुसल रिहिन, <verse eid="2CH 34:12" /><verse number="13" style="v" sid="2CH 34:13" />ओमन घलो बनिहारमन के अधिकारी रिहिन अऊ अलग-अलग काम के देखरेख करिन। कुछू लेवीमन सचिव, लेखक अऊ दुवारपाल रिहिन।<verse eid="2CH 34:13" /></para>
  <para style="s1">कानून के किताब मिलथे</para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 34:14" />जब ओमन ओ पईसा ला निकालत रिहिन, जेला यहोवा के मंदिर म लाने गे रिहिस, त हिलकियाह पुरोहित ला यहोवा के कानून के किताब मिलिस, जेह मूसा के दुवारा दिये गे रिहिस। <verse eid="2CH 34:14" /><verse number="15" style="v" sid="2CH 34:15" />हिलकियाह ह सचिव सापान ला कहिस, “यहोवा के मंदिर म, मोला कानून के किताब मिले हवय।” अऊ ओह ओ किताब सापान ला दे दीस।<verse eid="2CH 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 34:16" />तब सापान ह ओ किताब ला राजा करा ले गीस अऊ ओला बताईस, “तोर करमचारीमन ओ सब करत हें, जेकर जिम्मेदारी ओमन ला देय गे हवय। <verse eid="2CH 34:16" /><verse number="17" style="v" sid="2CH 34:17" />ओमन यहोवा के मंदिर म ले पईसा के भुगतान कर दे हवंय अऊ येला देखरेख करइया अऊ काम करइयामन के हांथ म सऊंप दे हवंय।” <verse eid="2CH 34:17" /><verse number="18" style="v" sid="2CH 34:18" />तब सचिव सापान ह राजा ला ये बताईस, “हिलकियाह पुरोहित ह मोला एक किताब दे हवय।” अऊ सापान ह राजा के आघू म ओ किताब ला पढ़िस।<verse eid="2CH 34:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 34:19" />जब राजा ह कानून के बचन ला सुनिस, त ओह दुख म अपन ओनहा ला चीरिस। <verse eid="2CH 34:19" /><verse number="20" style="v" sid="2CH 34:20" />अऊ ओह हिलकियाह, सापान के बेटा अहीकाम, मीका के बेटा अबदोन, सचिव सापान अऊ राजा के सेवक असायाह ला ये हुकूम दीस: <verse eid="2CH 34:20" /><verse number="21" style="v" sid="2CH 34:21" />“जावव अऊ यहोवा ले पता लगावव कि मोर अऊ इसरायल अऊ यहूदा के बांचे मनखेमन के बारे म ओ किताब म का लिखे हवय, जऊन ह मिले हे। काबरकि भयंकर ए यहोवा के कोरोध, जऊन ह हमर ऊपर भड़के हे, काबरकि हमर पुरखामन यहोवा के बचन ला नइं मानिन; ओमन ये किताब म लिखे जम्मो बात के मुताबिक नइं चलिन।”<verse eid="2CH 34:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 34:22" />हिलकियाह अऊ ओकर संग राजा के दुवारा पठोय गय मनखेमन हुलदा अगमजानीन करा बात करे बर गीन, जऊन ह हसरा के नाती अऊ तोखत के बेटा सल्लूम के घरवाली रिहिस। ओह ओनहा रखे के कमरा के रखवारीन रिहिस अऊ ओह यरूसलेम के नवां बने मकान म रहत रिहिस।<verse eid="2CH 34:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 34:23" />हुलदा ह ओमन ला कहिस, “यहोवा, इसरायल के परमेसर ह ये कहत हे: जऊन मनखे ह तुमन ला मोर करा पठोय हवय, ओला ये कहव, <verse eid="2CH 34:23" /><verse number="24" style="v" sid="2CH 34:24" />‘यहोवा ह ये कहत हे: मेंह ये जगह अऊ इहां के मनखेमन ऊपर बिपत्ति लानेवाला हंव—ओ जम्मो सराप जेकर बारे ओ किताब म लिखे गे हवय, जेला यहूदा के राजा के आघू म पढ़े गीस। <verse eid="2CH 34:24" /><verse number="25" style="v" sid="2CH 34:25" />काबरकि ओमन मोला तियाग दे हवंय अऊ आने देवतामन बर धूप जलाय हवंय अऊ अपन हांथ के जम्मो काम के दुवारा मोर कोरोध ला भड़काय हवंय, एकरसेति ये जगह ऊपर मोर कोरोध ह भड़कही अऊ येह सांत नइं होही।’ <verse eid="2CH 34:25" /><verse number="26" style="v" sid="2CH 34:26" />यहूदा के राजा ले कहव, जऊन ह यहोवा ले पुछताछ करे बर तुमन ला पठोय हवय, ‘जऊन बातमन ला तेंह सुने हस, ओकर बारे म यहोवा, इसरायल के परमेसर ह ये कहत हे: <verse eid="2CH 34:26" /><verse number="27" style="v" sid="2CH 34:27" />काबरकि तोर मन ह उत्तरदायी होईस अऊ तेंह परमेसर के आघू म अपनआप ला नम्र करय, जब तेंह ये जगह अऊ इहां के मनखेमन के बिरूध म ओकर बात ला सुनय, अऊ काबरकि तेंह मोर आघू म अपनआप ला नम्र करय अऊ अपन ओनहा ला चीरके मोर आघू म रोवय, एकरसेति मेंह तोर बात ला सुने हंव, यहोवा ह घोसना करत हे। <verse eid="2CH 34:27" /><verse number="28" style="v" sid="2CH 34:28" />मेंह तोला तोर पुरखामन संग मिला दूहूं, अऊ तोला सांति म माटी दिये जाही। तोर आंखीमन ओ जम्मो बिपत्ति ला नइं देखहीं, जेला मेंह ये जगह अऊ इहां रहइयामन ऊपर लानेवाला हंव।’ ”</para>
  <para style="p" vid="2CH 34:28">तब ओमन वापिस जाके ओ माईलोगन के कहे बात राजा ला बताईन।<verse eid="2CH 34:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 34:29" />तब राजा ह यहूदा अऊ यरूसलेम के जम्मो अगुवामन ला बलाके इकट्ठा करिस। <verse eid="2CH 34:29" /><verse number="30" style="v" sid="2CH 34:30" />ओह यहूदा के मनखे, यरूसलेम के निवासी, पुरोहित अऊ लेवीमन के संग यहोवा के मंदिर म गीस—ओमा छोटे ले लेके बड़े जम्मो मनखे रिहिन। ओह ओमन ला करार के ओ किताब के जम्मो बचन ला पढ़के सुनाईस, जऊन ह यहोवा के मंदिर म मिले रिहिस। <verse eid="2CH 34:30" /><verse number="31" style="v" sid="2CH 34:31" />राजा ह अपन खंभा करा ठाढ़ होईस अऊ यहोवा के आघू म ये कहिके ओ करार ला नवां करिस कि ओह यहोवा के पाछू चलही अऊ अपन पूरा मन अऊ पूरा परान से ओकर हुकूम, नियम अऊ बिधिमन ला मानही, अऊ ओ किताब म लिखे करार के बचन के पालन करही।<verse eid="2CH 34:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 34:32" />तब ओह यरूसलेम अऊ बिनयामीन म के हर एक जन ले भी अइसने करे बर सपथ खवाईस; यरूसलेम के मनखेमन परमेसर, अपन पुरखामन के परमेसर के करार के मुताबिक अइसने ही करिन।<verse eid="2CH 34:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2CH 34:33" />योसियाह ह इसरायलीमन के अधीन जम्मो इलाका ले जम्मो घिनौना मूरतीमन ला हटा दीस, अऊ ओह इसरायल म रहइया जम्मो झन ले यहोवा अपन परमेसर के सेवा करवाईस। जब तक ओह जीयत रिहिस, ओमन यहोवा, अपन पुरखामन के परमेसर के पाछू चले बर नइं छोंड़िन।<verse eid="2CH 34:33" /></para>
  <chapter eid="2CH 34" />
  <chapter number="35" style="c" sid="2CH 35" />
  <para style="s1">योसियाह ह फसह तिहार मनाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 35:1" />राजा योसियाह ह यहोवा बर यरूसलेम म फसह तिहार मनाईस, अऊ साल के पहिला महिना के चौदहवां दिन फसह के मेढ़ा-पीला ला बध करे गीस। <verse eid="2CH 35:1" /><verse number="2" style="v" sid="2CH 35:2" />ओह पुरोहितमन ला ओमन के काम बर ठहिराईस अऊ ओमन ला यहोवा के मंदिर के सेवा बर उत्साहित करिस। <verse eid="2CH 35:2" /><verse number="3" style="v" sid="2CH 35:3" />ओह लेवीमन ला कहिस, जेमन जम्मो इसरायलीमन ला निरदेस देवंय अऊ जेमन यहोवा बर पबितर करे गे रिहिन: “ओ पबितर सन्दूक ला मंदिर म रखव, जेला इसरायल के राजा दाऊद के बेटा सुलेमान ह बनाईस। येला तुम्हर कंधा म उठाके नइं ले जाना हे। अब यहोवा अपन परमेसर अऊ ओकर मनखे इसरायलीमन के सेवा करव। <verse eid="2CH 35:3" /><verse number="4" style="v" sid="2CH 35:4" />अऊ इसरायल के राजा दाऊद अऊ ओकर बेटा सुलेमान के दुवारा दिये गय लिखित निरदेस के मुताबिक अपनआप ला अपन-अपन दल म अपन-अपन परिवार के मुताबिक तियार करव।<verse eid="2CH 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 35:5" />“अपन संगी इसरायली, सधारन मनखे के परिवारमन के हर एक उप-दल बर लेवीमन के एक दल के संग पबितर स्थान म ठाढ़ होवव। <verse eid="2CH 35:5" /><verse number="6" style="v" sid="2CH 35:6" />अऊ फसह के मेढ़ा-पीलामन ला बध करव, अपनआप ला पबितर करव अऊ मूसा के जरिये यहोवा के दिये हुकूम ला पूरा करत, अपन संगी इसरायलीमन बर मेढ़ा-पीलामन ला तियार करव।”<verse eid="2CH 35:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 35:7" />योसियाह ह उहां के जम्मो सधारन मनखे बर कुल तीस हजार मेढ़ा-पीला अऊ बोकरा फसह-बलिदान बर, अऊ अलग से तीन हजार पसु अऊ दीस—ये जम्मो पसु राजा के खुद के संपत्ति म ले दिये गीन।<verse eid="2CH 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 35:8" />ओकर करमचारीमन घलो अपन मन से मनखेमन ला अऊ पुरोहित अऊ लेवीमन ला दीन। हिलकियाह, जकरयाह अऊ यहीएल नांव के परमेसर के मंदिर के अधिकारीमन दू हजार छै सौ फसह-बलिदान अऊ तीन सौ पसु दीन। <verse eid="2CH 35:8" /><verse number="9" style="v" sid="2CH 35:9" />कोनन्याह के संग ओकर भाई समायाह अऊ नतनेल, अऊ लेवीमन के अगुवा हसबियाह, येइल अऊ योजाबाद घलो लेवीमन बर पांच हजार फसह-बलिदान अऊ पांच सौ पसुमन के मुड़ी दीन।<verse eid="2CH 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 35:10" />अराधना के तियारी करे गीस अऊ पुरोहितमन अपन जगह म लेवीमन के दलमन के संग ठाढ़ होईन, जइसे कि राजा ह हुकूम दे रिहिस। <verse eid="2CH 35:10" /><verse number="11" style="v" sid="2CH 35:11" />फसह के मेढ़ा-पीलामन के बध करे गीस, अऊ जऊन लहू पुरोहितमन ला दिये गीस, ओला ओमन बेदी के आघू म छिंचिन, अऊ लेवीमन बध करे गे पसुमन के खाल उतारिन। <verse eid="2CH 35:11" /><verse number="12" style="v" sid="2CH 35:12" />ओमन मनखेमन के परिवार के उप-दलमन ला देय बर होम-बलिदान ला अलग रखिन, ताकि ओ मनखेमन यहोवा ला बलिदान चघा सकंय, जइसे कि मूसा के किताब म लिखे हवय। ओमन पसुमन ला घलो वइसे करिन। <verse eid="2CH 35:12" /><verse number="13" style="v" sid="2CH 35:13" />बिधि म लिखे मुताबिक लेवीमन फसह के पसुमन ला आगी ऊपर भुंजिन, अऊ पबितर बलिदान ला बरतन, हांड़ी अऊ कढ़ाहीमन म उसनिन अऊ तुरते जम्मो मनखेमन ला परोस दीन। <verse eid="2CH 35:13" /><verse number="14" style="v" sid="2CH 35:14" />येकर बाद, ओमन अपन बर अऊ पुरोहितमन बर तियारी करिन, काबरकि हारून के संतान, पुरोहितमन होम-बलिदान अऊ चरबीवाला भाग ला रथिया होवत तक चघावत रिहिन। एकरसेति लेवीमन अपन बर अऊ हारून के बंस के पुरोहितमन बर तियारी करिन।<verse eid="2CH 35:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 35:15" />दाऊद, आसाप, हेमान अऊ राजा के अगम-दरसी यदूतून के दिये गय निरदेस के मुताबिक आसाप के बंसज संगीतकारमन अपन जगह लीन। हर एक दुवार म दुवारपालमन ला अपन-अपन जगह म रहे के हुकूम रिहिस, काबरकि ओमन के संगी लेवीमन तियारी करत रिहिन।<verse eid="2CH 35:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 35:16" />तब ओ बेरा, फसह के उत्सव बर अऊ यहोवा के बेदी ऊपर होम-बलिदान चघाय बर यहोवा के पूरा अराधना करे गीस, जइसे कि राजा योसियाह ह हुकूम देय रिहिस। <verse eid="2CH 35:16" /><verse number="17" style="v" sid="2CH 35:17" />जऊन इसरायलीमन उहां रिहिन, ओमन ओ बेरा फसह तिहार मनाईन अऊ सात दिन तक अखमीरी रोटी के तिहार मनाईन। <verse eid="2CH 35:17" /><verse number="18" style="v" sid="2CH 35:18" />ये फसह तिहार सहीं समूएल अगमजानी के समय ले लेके अब तक कोनो फसह तिहार नइं मनाय गे रिहिस; अऊ इसरायल के कोनो राजा अइसने फसह के तिहार नइं मनाय रिहिन, जइसने योसियाह ह पुरोहित, लेवी अऊ यहूदा अऊ इसरायल के ओ जम्मो मनखेमन संग मनाईस, जेमन उहां यरूसलेम के मनखेमन संग रिहिन। <verse eid="2CH 35:18" /><verse number="19" style="v" sid="2CH 35:19" />ये फसह तिहार योसियाह राजा के राज के अठारहवां साल म मनाय गीस।<verse eid="2CH 35:19" /></para>
  <para style="s1">योसियाह के मिरतू</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 35:20" />ये जम्मो के बाद, जब योसियाह ह मंदिर ला ब्यवस्थित कर लीस, तब मिसर के राजा नको ह फरात नदी के तीर म कर्कमीस नांव के सहर मेर लड़े बर चल दीस, अऊ योसियाह घलो ओकर ले लड़े बर आघू बढ़िस। <verse eid="2CH 35:20" /><verse number="21" style="v" sid="2CH 35:21" />पर नको ह ये कहिके ओकर करा संदेसिया पठोईस, “हे यहूदा के राजा, तोर अऊ मोर बीच म कोनो झगरा के बात नइं ए। ये समय मेंह तोर ऊपर हमला करे बर नइं आय हंव, पर मेंह ओ घराना के बिरूध लड़े बर आय हंव, जेकर से मोर झगरा हवय। परमेसर ह मोला जल्दी करे बर कहे हवय; एकरसेति परमेसर के बिरोध करई बंद कर, जऊन ह मोर संग हवय, नइं तो ओह तोला नास कर दीही।”<verse eid="2CH 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 35:22" />पर योसियाह ह ओकर ले पाछू नइं हटिस, बल्कि ओकर ले लड़े बर अपन भेस बदल लीस। ओह ओ बात ला नइं सुनिस, जेला नको ह परमेसर के हुकूम ले कहे रिहिस, पर ओह नको ले लड़े बर मगिद्दो के मैदान म गीस।<verse eid="2CH 35:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 35:23" />धनुसधारीमन राजा योसियाह ऊपर तीर चलाईन, त ओह अपन अधिकारीमन ला कहिस, “मोला दूरिहा ले जावव; मोला बहुंत चोट लगे हवय।” <verse eid="2CH 35:23" /><verse number="24" style="v" sid="2CH 35:24" />तब ओमन ओला ओकर रथ म ले उतारके एक आने रथ म डालिन अऊ ओला यरूसलेम ले गीन, जिहां ओह मर गीस। ओला ओकर पुरखामन के कबर म माटी दिये गीस, अऊ पूरा यहूदा अऊ यरूसलेम के मनखेमन ओकर बर सोक मनाईन।<verse eid="2CH 35:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 35:25" />यरमियाह ह योसियाह बर एक बिलापगीत लिखिस, अऊ आज तक पुरूस अऊ महिला गवइयामन योसियाह के सुरता म ओ बिलापगीत गाथें। येह इसरायल म एक परंपरा बन गीस अऊ येला बिलापगीत म लिखे गे हवय।<verse eid="2CH 35:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 35:26" />योसियाह के राज के आने घटनामन अऊ यहोवा के कानून म लिखे मुताबिक ओकर भक्ति के काम— <verse eid="2CH 35:26" /><verse number="27" style="v" sid="2CH 35:27" />सुरू ले लेके आखिरी तक, जम्मो घटनामन इसरायल अऊ यहूदा के राजामन के किताब म लिखे गे हवंय।<verse eid="2CH 35:27" /></para>
  <chapter eid="2CH 35" />
  <chapter number="36" style="c" sid="2CH 36" />
  <para style="nb">
    <verse number="1" style="v" sid="2CH 36:1" />अऊ देस के मनखेमन योसियाह के बेटा यहोआहाज ला लीन अऊ ओला ओकर ददा के जगह म यरूसलेम म राजा बनाईन।<verse eid="2CH 36:1" /></para>
  <para style="s1">यहूदा के राजा यहोआहाज</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 36:2" />यहोआहाज ह तेईस साल के रिहिस, जब ओह राजा बनिस, अऊ ओह यरूसलेम म तीन महिना राज करिस। <verse eid="2CH 36:2" /><verse number="3" style="v" sid="2CH 36:3" />मिसर के राजा ह ओला यरूसलेम के गद्दी ले हटा दीस अऊ यहूदा देस ऊपर एक सौ टेलेन्ट चांदी<note caller="+" style="f"><char style="fr" closed="false">36:3 </char><char style="ft" closed="false">लगभग 3.4 मिटरिक टन</char></note> अऊ एक टेलेन्ट सोन<note caller="+" style="f"><char style="fr" closed="false">36:3 </char><char style="ft" closed="false">लगभग 34 किलोग्राम</char></note> के कर लगा दीस। <verse eid="2CH 36:3" /><verse number="4" style="v" sid="2CH 36:4" />मिसर के राजा ह यहोआहाज के एक भाई एलयाकीम ला यहूदा अऊ यरूसलेम ऊपर राजा बना दीस अऊ एलयाकीम के नांव ला बदलके यहोयाकीम रख दीस। पर नको ह एलयाकीम के भाई यहोआहाज ला मिसर ले गीस।<verse eid="2CH 36:4" /></para>
  <para style="s1">यहूदा के राजा यहोयाकीम</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 36:5" />यहोयाकीम ह पच्चीस साल के रिहिस, जब ओह राजा बनिस, अऊ ओह यरूसलेम म गियारह साल तक राज करिस। ओह यहोवा अपन परमेसर के नजर म दुस्ट काम करिस। <verse eid="2CH 36:5" /><verse number="6" style="v" sid="2CH 36:6" />बेबिलोन के राजा नबूकदनेसर ह ओकर ऊपर हमला करिस अऊ ओला कांसा के संकली म बांधके बेबिलोन ले गीस। <verse eid="2CH 36:6" /><verse number="7" style="v" sid="2CH 36:7" />नबूकदनेसर ह यहोवा के मंदिर ले कुछू चीजमन ला घलो बेबिलोन ले गीस अऊ ओ चीजमन ला उहां अपन मंदिर<note caller="+" style="f"><char style="fr" closed="false">36:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">महल</char></note> म रखिस।<verse eid="2CH 36:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 36:8" />यहोयाकीम के राज के आने घटनामन, जऊन घिनौना काम ओह करिस अऊ ओमा जऊन बुरई के बातमन पाय गीस, ओ सब इसरायल अऊ यहूदा के राजामन के किताब म लिखे हवय। अऊ ओकर बेटा यहोयाकीन ओकर जगह म राजा बनिस।<verse eid="2CH 36:8" /></para>
  <para style="s1">यहूदा के राजा यहोयाकीन</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 36:9" />यहोयाकीन ह अठारह साल के रिहिस, जब ओह राजा बनिस, अऊ ओह यरूसलेम म तीन महिना अऊ दस दिन राज करिस। ओह यहोवा के नजर म दुस्ट काम करिस। <verse eid="2CH 36:9" /><verse number="10" style="v" sid="2CH 36:10" />बसन्त के मौसम म, नबूकदनेसर राजा ह ओला बेबिलोन बुलवा लीस अऊ संग म यहोवा के मंदिर ले कीमती चीजमन ला घलो बेबिलोन मंगवा लीस, अऊ ओह यहोयाकीन के कका<note caller="+" style="f"><char style="fr" closed="false">36:10 </char><char style="ft" closed="false">कका या भाई; (देखव <char style="xt"><ref loc="2KI 24:17">2 राजा 24:17</ref></char>)</char></note> सिदकियाह ला यहूदा अऊ यरूसलेम ऊपर राजा बना दीस।<verse eid="2CH 36:10" /></para>
  <para style="s1">यहूदा के राजा सिदकियाह</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 36:11" />सिदकियाह ह इक्कीस साल के रिहिस, जब ओह राजा बनिस, अऊ ओह यरूसलेम म गियारह साल तक राज करिस। <verse eid="2CH 36:11" /><verse number="12" style="v" sid="2CH 36:12" />ओह यहोवा अपन परमेसर के नजर म दुस्ट काम करिस अऊ अपनआप ला यरमियाह अगमजानी के आघू म नम्र नइं करिस, जऊन ह ओला यहोवा के बचन सुनाईस। <verse eid="2CH 36:12" /><verse number="13" style="v" sid="2CH 36:13" />ओह राजा नबूकदनेसर के बिरूध म घलो बिदरोह करिस, जऊन ह ओला परमेसर के नांव म सपथ देवाय रिहिस। ओह हठी हो गीस अऊ अपन मन ला कठोर करके यहोवा, इसरायल के परमेसर कोति नइं फिरिस। <verse eid="2CH 36:13" /><verse number="14" style="v" sid="2CH 36:14" />येकर अलावा, पुरोहित अऊ मनखेमन के जम्मो अगुवामन अऊ जादा बिसवासघाती होवत गीन, अऊ आनजातमन के घिनौना रीति-रिवाज के पाछू चलिन अऊ यहोवा के मंदिर ला असुध करिन, जेला ओह यरूसलेम म पबितर करे रिहिस।<verse eid="2CH 36:14" /></para>
  <para style="s1">यरूसलेम के पतन</para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 36:15" />यहोवा, ओमन के पुरखामन के परमेसर ह अपन संदेसियामन के जरिये बार-बार ओमन करा अपन संदेस भेजिस, काबरकि ओह अपन मनखे अऊ अपन निवास स्थान ऊपर दया देखात रिहिस। <verse eid="2CH 36:15" /><verse number="16" style="v" sid="2CH 36:16" />पर ओमन परमेसर के संदेसियामन के हंसी उड़ाईन, ओकर बचन ला तुछ समझिन अऊ ओकर अगमजानीमन के खिल्ली उड़ाईन, जब तक कि यहोवा के कोप ह ओमन ऊपर नइं भड़किस अऊ ओकर ले बचे के कोनो उपाय नइं रिहिस। <verse eid="2CH 36:16" /><verse number="17" style="v" sid="2CH 36:17" />परमेसर ह ओमन के बिरूध बेबिलोनीमन<note caller="+" style="f"><char style="fr" closed="false">36:17 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> के राजा ला ले आईस, जऊन ह ओमन के जवानमन ला पबितर-स्थान म तलवार ले मार डारिस, अऊ जवान या जवान छोकरी, डोकरा या दुरबल मनखेमन ला घलो नइं छोंड़िस। परमेसर ह ओ जम्मो ला नबूकदनेसर के हांथ म कर दीस। <verse eid="2CH 36:17" /><verse number="18" style="v" sid="2CH 36:18" />ओह परमेसर के मंदिर के छोटे-बड़े जम्मो चीजमन ला, अऊ यहोवा के मंदिर के खजाना अऊ राजा अऊ ओकर करमचारीमन के खजाना ला बेबिलोन ले गीस। <verse eid="2CH 36:18" /><verse number="19" style="v" sid="2CH 36:19" />ओमन परमेसर के मंदिर म आगी लगा दीन अऊ यरूसलेम के दीवार ला टोर दीन; ओमन जम्मो महलमन ला जला दीन अऊ उहां के जम्मो कीमती चीज ला नास कर दीन।<verse eid="2CH 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 36:20" />जऊन मन तलवार ले बच गे रिहिन, ओमन ला ओह बेबिलोन ले गीस, अऊ ओमन तब तक ओकर अऊ ओकर संतानमन के सेवक बने रिहिन, जब तक कि फारस के राज ह परबल नइं हो गीस। <verse eid="2CH 36:20" /><verse number="21" style="v" sid="2CH 36:21" />देस ह अपन बिसराम काल म आनंद उठाईस; अपन अलगाव के समय, ओ पूरा समय येह तब तक अराम करिस, जब तक कि ओ सत्तर साल पूरा नइं हो गीस, जेकर बारे म यरमियाह ह यहोवा के बचन के पूरा होय के बारे म कहे रिहिस।<verse eid="2CH 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 36:22" />फारस के राजा कुसरू के राज के पहिला बछर म यहोवा ह फारस के राजा कुसरू के मन ला उभारिस कि यहोवा के जऊन बचन यरमियाह अगमजानी के दुवारा कहे गे रिहिस, ओह पूरा हो जाय, एकरसेति राजा कुसरू ह अपन जम्मो राज म ये परचार करवाईस अऊ लिखवा भी दीस:<verse eid="2CH 36:22" /></para>
  <para style="pmo">
    <verse number="23" style="v" sid="2CH 36:23" />“फारस के राजा कुसरू ह ये कहत हे:</para>
  <para style="pm" vid="2CH 36:23">“ ‘यहोवा, स्वरग के परमेसर ह, धरती भर के जम्मो राज ला मोला दे हवय, अऊ यहूदा प्रदेस के यरूसलेम म ओकर बर एक मंदिर बनाय बर, ओह मोला ठहिराय हवय। तुम्हर बीच म ले, ओकर जऊन भी मनखे उहां जाय चाहत हवंय, ओमन जा सकत हें, अऊ यहोवा ओमन के परमेसर ह ओमन के संग रहय।’ ”<verse eid="2CH 36:23" /></para>
  <chapter eid="2CH 36" />
</usx>