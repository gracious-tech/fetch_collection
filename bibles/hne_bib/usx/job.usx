<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOB" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">अयूब</para>
  <para style="toc1">अयूब के किताब</para>
  <para style="toc2">अयूब</para>
  <para style="toc3">अयू</para>
  <para style="mt1">अयूब</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="JOB 1" />
  <para style="s1">भूमिका</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 1:1" />ऊज नांव के देस म अयूब नांव के एक झन मनखे रिहिस। ओह निरदोस अऊ ईमानदार रिहिस; ओह परमेसर के भय मानय अऊ बुरई ले दूरिहा रहय। <verse eid="JOB 1:1" /><verse number="2" style="v" sid="JOB 1:2" />ओकर सात झन बेटा अऊ तीन झन बेटी रिहिन, <verse eid="JOB 1:2" /><verse number="3" style="v" sid="JOB 1:3" />अऊ ओकर करा सात हजार भेड़, तीन हजार ऊंट, पांच सौ जोड़ी बईला, पांच सौ गदही, अऊ बहुंत अकन नौकर-चाकर रिहिन। पूरब देस के मनखेमन के बीच म, ओह सबले धनवान मनखे रिहिस।<verse eid="JOB 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 1:4" />ओकर बेटामन अपन जनम दिन म अपन घर म एक-दूसर ला बलाके भोज के आयोजन करंय, अऊ ओमन अपन तीनों बहिनीमन ला घलो अपन संग खाय-पीये बर नेवता देवंय। <verse eid="JOB 1:4" /><verse number="5" style="v" sid="JOB 1:5" />जब भी भोज खाय के दिन ह बीत जावय, त अयूब ह ओमन ला सुध करे के परबंध करय। बड़े बिहनियां, ओह ओमन के हर एक झन बर ये सोचके होम-बलिदान करय, “सायद मोर लइकामन पाप करे होहीं अऊ अपन मन म परमेसर के बिरोध म काम करे होहीं।” अयूब ह हमेसा अइसने करय।<verse eid="JOB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 1:6" />एक दिन स्वरगदूतमन<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">परमेसर के बेटामन</char></note> यहोवा करा आईन, अऊ सैतान<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">सैतान </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">बईरी </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बिरोधी</char></note> ह घलो ओमन के संग म आईस। <verse eid="JOB 1:6" /><verse number="7" style="v" sid="JOB 1:7" />यहोवा ह सैतान ले पुछिस, “तें कहां ले आवत हस?”</para>
  <para style="p" vid="JOB 1:7">सैतान ह यहोवा ला जबाब दीस, “जम्मो धरती म एती-ओती घुमत-फिरत आय हवंव।”<verse eid="JOB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOB 1:8" />तब यहोवा ह सैतान ला कहिस, “का तेंह मोर सेवक, अयूब कोति धियान देय हवस? धरती म ओकर सहीं कोनो नइं ए; ओह बिगर दोस के अऊ ईमानदार मनखे अय; ओह परमेसर के भय मानथे अऊ बुरई ले दूरिहा रहिथे।”<verse eid="JOB 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 1:9" />सैतान ह यहोवा ला जबाब दीस, “का अयूब ह बिगर कोनो कारन के परमेसर के भय मानथे? <verse eid="JOB 1:9" /><verse number="10" style="v" sid="JOB 1:10" />का तेंह ओकर अऊ ओकर घर-परिवार अऊ ओकर जम्मो जिनिस के चारों कोति अपन सुरकछा के बाड़ा बांधके नइं रखे हस? तेंह ओकर काम म आसीस देय हवस, जेकर ले ओकर पसुमन के संखिया जम्मो देस म बढ़ गे हवय। <verse eid="JOB 1:10" /><verse number="11" style="v" sid="JOB 1:11" />पर अब अपन हांथ ला बढ़ाके ओकर जम्मो जिनिस ला मार, अऊ ओह तोर मुहूं म तोर निन्दा करही।”<verse eid="JOB 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 1:12" />यहोवा ह सैतान ला कहिस, “ठीक हे! जऊन कुछू ओकर करा हवय, ओ जम्मो के अधिकार ला मेंह तोर हांथ म देवत हंव, पर अयूब के ऊपर तें अपन हांथ झन लगाबे।”</para>
  <para style="p" vid="JOB 1:12">तब सैतान ह यहोवा के आघू ले चल दीस।<verse eid="JOB 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOB 1:13" />एक दिन जब अयूब के बेटा-बेटीमन अपन बड़े भईया के घर म खावत रिहिन अऊ अंगूर के मंद पीयत रिहिन, <verse eid="JOB 1:13" /><verse number="14" style="v" sid="JOB 1:14" />तब एक संदेसिया ह अयूब करा आके कहिस, “हमर बईलामन खेत जोतत रिहिन अऊ गदहीमन लकठा म चरत रिहिन <verse eid="JOB 1:14" /><verse number="15" style="v" sid="JOB 1:15" />कि सबा के मनखेमन हमर ऊपर चढ़ई कर दीन अऊ पसुमन ला ले गीन। ओमन सेवकमन ला तलवार ले मार डारिन अऊ मेंह एके झन बांचके तोला बताय बर आय हवंव!”<verse eid="JOB 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 1:16" />अभी ओह अइसने कहितेच रिहिस कि दूसरा संदेसिया ह आके कहिस, “परमेसर के आगी अकास ले गिरिस अऊ ओकर ले भेड़मन अऊ चरवाहामन जरके भसम हो गीन अऊ मेंह एके झन बांचके तोला बताय बर आय हवंव!”<verse eid="JOB 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOB 1:17" />ओह अभी अइसने कहितेच रिहिस कि एक झन अऊ संदेसिया आके कहे लगिस, “कसदी के मनखेमन तीन दल बनाके आईन अऊ ऊंटमन ऊपर चढ़ई करके ओमन ला ले गीन अऊ ओमन सेवकमन ला तलवार ले मार डारिन। मेंह एके झन बांचके तोला बताय बर आय हवंव!”<verse eid="JOB 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOB 1:18" />ओह अभी अइसने कहितेच रिहिस कि एक आने संदेसिया आके कहिस, “तोर बेटा-बेटीमन अपन बड़े भईया के घर म खावत रिहिन अऊ अंगूर के मंद पीयत रिहिन <verse eid="JOB 1:18" /><verse number="19" style="v" sid="JOB 1:19" />कि अचानक सुनसान जगह ले एक भयंकर आंधी आईस अऊ घर के चारों कोनटा ला अइसन मारिस कि घर ह ओमन ऊपर गिर पड़िस अऊ ओमन मर गीन। मेंहीच ह एके झन बांचके तोला बताय बर आय हवंव!”<verse eid="JOB 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOB 1:20" />ये सुनके अयूब ह ठाढ़ होईस अऊ दुख म अपन ओनहा ला चीरिस अऊ मुड़ ला मुड़ाईस। तब ओह परमेसर के भक्ति म भुइयां म गिरके दंडवत करिस <verse eid="JOB 1:20" /><verse number="21" style="v" sid="JOB 1:21" />अऊ कहिस:</para>
  <para style="q1" vid="JOB 1:21">“नंगरा मेंह अपन दाई के कोख ले आय रहेंव,</para>
  <para style="q2" vid="JOB 1:21">अऊ नंगरा मेंह वापिस चले जाहूं।</para>
  <para style="q1" vid="JOB 1:21">यहोवा ह दीस अऊ यहोवा ह ले लीस;</para>
  <para style="q2" vid="JOB 1:21">यहोवा के नांव के परसंसा होवय।”<verse eid="JOB 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOB 1:22" />ये जम्मो बात म, अयूब ह न तो पाप करिस अऊ न ही परमेसर ऊपर अनियाय करे के दोस लगाईस।<verse eid="JOB 1:22" /></para>
  <para style="b" />
  <chapter eid="JOB 1" />
  <chapter number="2" style="c" sid="JOB 2" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 2:1" />फेर एक आने दिन स्वरगदूतमन<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">परमेसर के बेटामन</char></note> यहोवा करा आईन, अऊ सैतान घलो ओमन के संग म यहोवा करा आईस। <verse eid="JOB 2:1" /><verse number="2" style="v" sid="JOB 2:2" />तब यहोवा ह सैतान ला पुछिस, “तें कहां ले आवत हस?”</para>
  <para style="p" vid="JOB 2:2">सैतान ह यहोवा ला जबाब दीस, “जम्मो धरती म एती-ओती घुमत-फिरत आय हवंव।”<verse eid="JOB 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOB 2:3" />तब यहोवा ह सैतान ला कहिस, “का तेंह मोर दास अयूब के ऊपर धियान देय हवस? धरती म ओकर सहीं कोनो नइं ए; ओह बिगर दोस के अऊ ईमानदार मनखे अय अऊ ओह परमेसर के भय आदर के साथ मानथे अऊ बुरई ले दूरिहा रहिथे। हालाकि तेंह ओला बिगर कोनो कारन के नास करे बर मोला ओकर बिरोध म उकसाय हस, तभो ले ओह अब तक ईमानदार बने हवय।”<verse eid="JOB 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 2:4" />सैतान ह जबाब दीस, “खाल के बलदा म खाल! परान के बलदा म मनखे ह अपन जम्मो कुछू ला दे देथे। <verse eid="JOB 2:4" /><verse number="5" style="v" sid="JOB 2:5" />पर अब तेंह अपन हांथ बढ़ाके ओकर मांस अऊ हाड़ामन ला मार, अऊ ओह खचित तोर मुहूं म तोर निन्दा करही।”<verse eid="JOB 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 2:6" />यहोवा ह सैतान ला कहिस, “ठीक हे, अब ओह तोर अधिकार म हवय, पर तें ओकर परान ला सुरकछित रहन देबे।”<verse eid="JOB 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 2:7" />तब सैतान ह यहोवा करा ले चल दीस अऊ ओह अयूब के पांव के तरी ले लेके मुड़ के टीप तक पीरा देवइया फोड़ा निकालके दुख दीस। <verse eid="JOB 2:7" /><verse number="8" style="v" sid="JOB 2:8" />तब अयूब ह माटी के घघरी के एक ठन टुकड़ा लीस अऊ राख म बईठके ओ टुकड़ा ले अपनआप ला खुजीयाय लगिस।<verse eid="JOB 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 2:9" />तब ओकर घरवाली ह ओला कहिस, “का तेंह अभी घलो अपन ईमानदारी ला धरे हस? परमेसर के निन्दा कर अऊ मर जा!”<verse eid="JOB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 2:10" />अयूब ह ओला जबाब दीस, “तेंह मुरूख माईलोगन सहीं गोठियावत हस। का हमन परमेसर ले सिरिप बने चीजमन ला लेवन, अऊ समस्या ला नइं लेवन?”</para>
  <para style="p" vid="JOB 2:10">ये जम्मो बात म, अयूब ह अपन गोठ के दुवारा कोनो पाप नइं करिस।<verse eid="JOB 2:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="JOB 2:11" />जब अयूब के तीन झन संगी तेमानी के रहइया एलीपज, सूही के रहइया बिलदद अऊ नामाती के रहइया सोपर, अयूब के ऊपर आय ओ जम्मो समस्या के बारे म सुनिन, त ओमन अपन-अपन घर ले निकलिन अऊ एक संग मिलके ये निरनय करिन कि हमन ओकर करा जाके ओला सहानुभूति अऊ सांतवना देबो। <verse eid="JOB 2:11" /><verse number="12" style="v" sid="JOB 2:12" />जब ओमन थोरकन दूरिहा ले ओला देखिन, त ओला नइं चिन सकिन; ओमन चिचिया-चिचियाके रोय लगिन, अऊ अपन दुख परगट करके ओनहा ला चीरिन अऊ ऊपर कोति धुर्रा उड़ियाके अपन-अपन मुड़ म डारे लगिन। <verse eid="JOB 2:12" /><verse number="13" style="v" sid="JOB 2:13" />तब ओमन सात दिन अऊ सात रात ले ओकर संग भुइयां म बईठिन। कोनो अयूब ला एक सबद घलो नइं कहिन, काबरकि ओमन देखिन कि ओह अब्बड़ पीरा म रहय।<verse eid="JOB 2:13" /></para>
  <chapter eid="JOB 2" />
  <chapter number="3" style="c" sid="JOB 3" />
  <para style="s1">अयूब ह गोठियाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 3:1" />एकर बाद, अयूब ह अपन मुहूं खोलके अपन जनम दिन ला धिक्कारे लगिस। <verse eid="JOB 3:1" /><verse number="2" style="v" sid="JOB 3:2" />ओह कहिस:<verse eid="JOB 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 3:3" />“नास हो जावय ओ दिन, जऊन दिन मोर जनम होईस,</para>
  <para style="q2" vid="JOB 3:3">अऊ ओ रात घलो जेह कहिस, ‘पेट म बाबू हवय!’<verse eid="JOB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 3:4" />ओ दिन ह अंधियार हो जावय;</para>
  <para style="q2" vid="JOB 3:4">परमेसर ह ऊपर ले ओकर सुधि झन लेवय;</para>
  <para style="q2" vid="JOB 3:4">ओकर ऊपर अंजोर झन होवय।<verse eid="JOB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 3:5" />दुख अऊ मिरतू के छइहां ह ओ दिन के ऊपर अधिकार करय;</para>
  <para style="q2" vid="JOB 3:5">बादर ह ओकर ऊपर छाय रहय;</para>
  <para style="q2" vid="JOB 3:5">दिन के अंधियार ह ओला डरावय।<verse eid="JOB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 3:6" />ओ रथिया ला घोर अंधियार ह जकड़ डारय,</para>
  <para style="q2" vid="JOB 3:6">बछर के दिनमन म ओ दिन ला सामिल झन करे जावय</para>
  <para style="q2" vid="JOB 3:6">अऊ कोनो महिना म ओ दिन के गनती झन होवय।<verse eid="JOB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 3:7" />ओ रथिया ह ठड़गी हो जावय;</para>
  <para style="q2" vid="JOB 3:7">ओमा कोनो आनंद के धुन झन सुनई देवय।<verse eid="JOB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 3:8" />जऊन मन दिनमन ला धिक्कारथें, ओमन ओ दिन ला धिक्कारंय,</para>
  <para style="q2" vid="JOB 3:8">जऊन मन लिबयातान<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="fq" closed="false">लिबयातान </char><char style="ft" closed="false">इहां येकर मतलब होथे एक पौरानिक पसु जऊन ह समुंदर म रहिथे अऊ जेकर उपयोग बिनास लाय बर करे जाथे; येह एक </char><char style="fqa" closed="false">“बिसाल समुंदर के सांप” </char><char style="ft" closed="false">एक </char><char style="fqa" closed="false">“बिसाल अऊ बिलछन जन्तु” </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">“एक ठन ड्रैगन” </char><char style="ft" closed="false">ए</char></note> ला उत्तेजित करे बर तियार हवंय।<verse eid="JOB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 3:9" />ओकर बिहनियां के तारामन अंधियार हो जावंय;</para>
  <para style="q2" vid="JOB 3:9">ओह दिन के अंजोर बर तरसय अऊ ओ अंजोर ह झन आवय</para>
  <para style="q2" vid="JOB 3:9">अऊ ओह बिहनियां के पहिली किरन ला झन देखे पावय,<verse eid="JOB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 3:10" />काबरकि ओ दिन ह मोर दाई के कोख ला मोर बर बंद नइं करिस</para>
  <para style="q2" vid="JOB 3:10">कि मोर आंखीमन समस्या ला झन देखंय।<verse eid="JOB 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOB 3:11" />“जनम के बेरा ही मेंह काबर नास नइं हो गेंव,</para>
  <para style="q2" vid="JOB 3:11">अऊ गरभ ले निकलते ही मेंह काबर नइं मर गेंव?<verse eid="JOB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 3:12" />मोला थामे बर उहां माड़ीमन काबर रिहिन</para>
  <para style="q2" vid="JOB 3:12">अऊ मोला दूध पीयाय बर ओ थनमन काबर रिहिन?<verse eid="JOB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 3:13" />कहूं अइसने नइं होतिस, त मेंह सांति म चुपेचाप पड़े रहितेंव;</para>
  <para style="q2" vid="JOB 3:13">अऊ गहरी नींद म सुते अराम करतेंव,<verse eid="JOB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 3:14" />मेंह धरती के ओ राजामन अऊ सासन करइयामन संग होतेंव</para>
  <para style="q2" vid="JOB 3:14">जऊन मन अपन बर ओ जगहमन ला बनाईन, जऊन मन अब खंडहर हो गे हवंय,<verse eid="JOB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 3:15" />या ओ राजकुमारमन संग होतेंव, जेमन करा सोन रिहिस,</para>
  <para style="q2" vid="JOB 3:15">अऊ जऊन मन अपन घरमन ला चांदी ले भर ले रिहिन।<verse eid="JOB 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 3:16" />या बिगर समय के गिरे गरभ के लइका सहीं मोला भुइयां म काबर तोपे नइं गीस,</para>
  <para style="q2" vid="JOB 3:16">याने ओ लइका जऊन ह कभू दिन के अंजोर ला नइं देखिस?<verse eid="JOB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 3:17" />उहां दुस्ट मनखे के दुख देवई ह खतम हो जाथे,</para>
  <para style="q2" vid="JOB 3:17">अऊ उहां थके-मांदे मनखेमन बिसराम पाथें।<verse eid="JOB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 3:18" />उहां बंधक बनाय गे मनखेमन घलो अपन सुख के आनंद उठाथें;</para>
  <para style="q2" vid="JOB 3:18">ओमन ला बेगारी करवइयामन के ललकार ह सुनई नइं देवय।<verse eid="JOB 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 3:19" />उहां छोटे-बड़े जम्मो झन रहिथें,</para>
  <para style="q2" vid="JOB 3:19">अऊ गुलाममन अपन मालिक ले सुतंतर रहिथें।<verse eid="JOB 3:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 3:20" />“ओमन ला अंजोर काबर दिये जाथे, जऊन मन दुख म हवंय,</para>
  <para style="q2" vid="JOB 3:20">अऊ ओमन ला जिनगी काबर दिये जाथे, जऊन मन उदास हवंय?<verse eid="JOB 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 3:21" />जऊन मन मऊत के कामना करथें, पर मऊत ओमन ला आवय नइं,</para>
  <para style="q2" vid="JOB 3:21">जऊन मन गड़े खजाना ले घलो जादा मऊत के खोज करथें,<verse eid="JOB 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 3:22" />जऊन मन कि खुसी अऊ आनंद ले भरे रहिथें,</para>
  <para style="q2" vid="JOB 3:22">जब ओमन कबर म हबरथें?<verse eid="JOB 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 3:23" />ओ मनखे ला जिनगी काबर दिये जाथे</para>
  <para style="q2" vid="JOB 3:23">जेकर अगम के रद्दा ह लुकाय हवय,</para>
  <para style="q2" vid="JOB 3:23">जेकर चारों कोति परमेसर ह घेरा बांधे हवय?<verse eid="JOB 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 3:24" />काबरकि आह भरई ह हर दिन के मोर जेवन हो गे हवय;</para>
  <para style="q2" vid="JOB 3:24">मोर रोवई ह पानी के धारा कस बोहावत रहिथे।<verse eid="JOB 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 3:25" />जऊन बात ले मेंह डरावत रहेंव, ओही ह मोर ऊपर आ गे हवय;</para>
  <para style="q2" vid="JOB 3:25">जऊन बात के मोला भय रिहिस, ओही ह मोर संग घटे हवय।<verse eid="JOB 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 3:26" />मोला न तो सुख, न ही सांति हवय;</para>
  <para style="q2" vid="JOB 3:26">न ही मोला अराम मिलत हवय, पर सिरिप दुख ही दुख मोर ऊपर आ गे हवय।”<verse eid="JOB 3:26" /></para>
  <chapter eid="JOB 3" />
  <chapter number="4" style="c" sid="JOB 4" />
  <para style="s1">एलीपज के कहई</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 4:1" />तब तेमान के रहइया एलीपज ह कहिस:<verse eid="JOB 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 4:2" />“कहूं कोनो तोर ले दू सबद कहय, त का तेंह तमक जाबे?</para>
  <para style="q2" vid="JOB 4:2">पर कहे बिना कोन रह सकत हे?<verse eid="JOB 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 4:3" />सोच, तेंह कतेक झन ला सिकछा दे हवस,</para>
  <para style="q2" vid="JOB 4:3">अऊ तेंह कइसने दुरबलमन ला बलवान करे हवस।<verse eid="JOB 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 4:4" />तोर बचन ह ओमन ला सहारा देय हवय, जऊन मन लड़खड़ावत रिहिन;</para>
  <para style="q2" vid="JOB 4:4">तेंह लड़खड़ावत माड़ीमन ला बलवान करे हस।<verse eid="JOB 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 4:5" />फेर अब दुख ह तोर ऊपर आवत हे, अऊ तेंह निरास होवत हस;</para>
  <para style="q2" vid="JOB 4:5">ओह तोर ऊपर आईस अऊ तेंह डरा गे।<verse eid="JOB 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 4:6" />का परमेसर के भक्ति ही तोर भरोसा</para>
  <para style="q2" vid="JOB 4:6">अऊ तोर निरदोस जिनगी ह तोर आसा नइं होना चाही?<verse eid="JOB 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 4:7" />“बिचार कर: कोन ह निरदोस होके कभू नास होय हवय?</para>
  <para style="q2" vid="JOB 4:7">कोनो मेर कोनो धरमी मनखे ह नास होय हवय?<verse eid="JOB 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 4:8" />जइसने कि मेंह देखे हंव, जऊन मन बुरई ला जोतथें</para>
  <para style="q2" vid="JOB 4:8">अऊ दुख ला बोथें, ओमन उही ला लूहीं।<verse eid="JOB 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 4:9" />परमेसर के सांस ले ही ओमन नास हो जाथें;</para>
  <para style="q2" vid="JOB 4:9">अऊ ओकर रिस के झोंका ले ओमन खतम हो जाथें।<verse eid="JOB 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 4:10" />सेरमन गरजथें अऊ गुर्राथें,</para>
  <para style="q2" vid="JOB 4:10">तभो ले जवान सेरमन के दांत टोरे जाथे।<verse eid="JOB 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 4:11" />सिकार के कमी के कारन सेर ह मर जाथे,</para>
  <para style="q2" vid="JOB 4:11">अऊ सेरनी के पीलामन एती-ओती बगर जाथें।<verse eid="JOB 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 4:12" />“एक ठन गोठ मोला गुपत म बताय गीस,</para>
  <para style="q2" vid="JOB 4:12">मेंह येकर कानाफूसी ला सुनेंव।<verse eid="JOB 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 4:13" />रथिया बियाकुल करइया सपनामन के बीच म,</para>
  <para style="q2" vid="JOB 4:13">जब मनखेमन गहिरा नींद म रहिथें,<verse eid="JOB 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 4:14" />तभे डर अऊ कंपकपी ह मोर म हमा गीस</para>
  <para style="q2" vid="JOB 4:14">अऊ मोर जम्मो हाड़ामन कांपे लगिन।<verse eid="JOB 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 4:15" />एक आतमा ह मोर चेहरा के सामने ले होके गीस,</para>
  <para style="q2" vid="JOB 4:15">अऊ मोर देहें के रूआंमन ठाढ़ हो गीन।<verse eid="JOB 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 4:16" />ओह रूक गीस,</para>
  <para style="q2" vid="JOB 4:16">पर मेंह नइं बता सकेंव कि ओह का रिहिस।</para>
  <para style="q1" vid="JOB 4:16">मोर आंखी के आघू म एक ठन रूप ठाढ़े रिहिस,</para>
  <para style="q2" vid="JOB 4:16">अऊ मेंह एक सांत अवाज सुनेंव:<verse eid="JOB 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 4:17" />‘का नासमान मनखे ह परमेसर ले जादा धरमी हो सकथे?</para>
  <para style="q2" vid="JOB 4:17">का एक बलवान मनखे अपन सिरजनहार ले जादा सुध हो सकथे?<verse eid="JOB 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 4:18" />कहूं परमेसर ह अपन सेवकमन ऊपर भरोसा नइं करय,</para>
  <para style="q2" vid="JOB 4:18">अऊ ओह अपन स्वरगदूतमन ला दोसी ठहिराथे,<verse eid="JOB 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 4:19" />त फेर ओमन के का होही, जऊन मन माटी के घरमन म रहिथें,</para>
  <para style="q2" vid="JOB 4:19">जेमन के नीवमन धुर्रा म हवंय,</para>
  <para style="q2" vid="JOB 4:19">जऊन मन पतंगा के सहीं पीस जाथें!<verse eid="JOB 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 4:20" />बिहान अऊ संझा के बीच म ओमन ला कुटा-कुटा करे जाथे;</para>
  <para style="q2" vid="JOB 4:20">बिगर काकरो जाने, ओमन सदाकाल बर नास हो जाथें।<verse eid="JOB 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 4:21" />का ओमन के जिनगी के डेरा के डोरीमन ला नइं खींच दिये जावय,</para>
  <para style="q2" vid="JOB 4:21">जेकर ले ओमन बिगर बुद्धि के मर जाथें?’<verse eid="JOB 4:21" /></para>
  <para style="b" />
  <chapter eid="JOB 4" />
  <chapter number="5" style="c" sid="JOB 5" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 5:1" />“यदि तोर ईछा हवय, त पुकार, पर तोला कोन जबाब दीही?</para>
  <para style="q2" vid="JOB 5:1">पबितर जन म ले तेंह काकर कोति सहायता बर लहुंटबे?<verse eid="JOB 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 5:2" />तमकई ह तो मुरूख मनखे ला मार डारथे,</para>
  <para style="q2" vid="JOB 5:2">अऊ जलन ह सीधवा मनखे ला मार डारथे।<verse eid="JOB 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 5:3" />मेंह खुद मुरूख मनखे ला बढ़त देखे हंव,</para>
  <para style="q2" vid="JOB 5:3">पर अचानक ओकर घर ह सरापित हो गीस।<verse eid="JOB 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 5:4" />ओकर लइकामन सुरकछित नइं एं,</para>
  <para style="q2" vid="JOB 5:4">ओमन अदालत म कुचरे जाथें, अऊ ओमन के बचाव करइया कोनो नइं ए।<verse eid="JOB 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 5:5" />भूखहा मनखेमन ओकर फसल ला खा जाथें,</para>
  <para style="q2" vid="JOB 5:5">इहां तक कि ओमन कांटा-खूंटी के बीच ले घलो फसल ला ले लेथें,</para>
  <para style="q2" vid="JOB 5:5">अऊ पीयासा मनखेमन ओकर धन ला हड़प लेथें।<verse eid="JOB 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 5:6" />काबरकि बिपत्ति ह माटी ले नइं उपजय,</para>
  <para style="q2" vid="JOB 5:6">अऊ न ही समस्या ह भुइयां म ले उगय।<verse eid="JOB 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 5:7" />जइसे चिंगारीमन ऊपर कोति ही उड़थें,</para>
  <para style="q2" vid="JOB 5:7">वइसे ही मनखे ह दुख भोगे बर जनमे हवय।<verse eid="JOB 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 5:8" />“पर यदि मेंह तोर स्थिति म होतेंव, त में परमेसर ले पराथना करतेंव;</para>
  <para style="q2" vid="JOB 5:8">में अपन बात ओकर आघू म रखतेंव।<verse eid="JOB 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 5:9" />ओह अद्भूत काम करथे, जेला समझे नइं जा सकय</para>
  <para style="q2" vid="JOB 5:9">अऊ ओह चमतकार करथे, जेला गने नइं जा सकय।<verse eid="JOB 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 5:10" />ओह धरती म बारिस करथे;</para>
  <para style="q2" vid="JOB 5:10">ओह खेतमन म पानी पठोथे।<verse eid="JOB 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 5:11" />छोटे मनखेमन ला ओह ऊंचहा जगह म बईठारथे,</para>
  <para style="q2" vid="JOB 5:11">अऊ सोक करइया मनखेमन ला ओह सुरकछा देथे।<verse eid="JOB 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 5:12" />ओह चतुरामन के योजना ला बिफल कर देथे,</para>
  <para style="q2" vid="JOB 5:12">जेकर ले ओमन ला सफलता नइं मिलय।<verse eid="JOB 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 5:13" />ओह बुद्धिमानमन ला ओहीचमन के चतुरई म फंसो देथे,</para>
  <para style="q2" vid="JOB 5:13">अऊ चलाकमन के योजना ह बिफल हो जाथे।<verse eid="JOB 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 5:14" />दिन म ही ओमन के ऊपर अंधियार छा जाथे;</para>
  <para style="q2" vid="JOB 5:14">मंझन के बेरा ओमन रथिया कस टमड़े लगथें।<verse eid="JOB 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 5:15" />ओह जरूरतमंद मनखेमन ला ओमन के बोली के चोखा तलवार ले बचाथे;</para>
  <para style="q2" vid="JOB 5:15">ओह ओमन ला बलवानमन के हांथ ले बचाथे।<verse eid="JOB 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 5:16" />एकरसेति गरीबमन ला आसा होथे,</para>
  <para style="q2" vid="JOB 5:16">अऊ अनियायीमन अपन मुहूं बंद रखथें।<verse eid="JOB 5:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JOB 5:17" />“धइन अय ओ मनखे, जऊन ला परमेसर ह सुधारथे;</para>
  <para style="q2" vid="JOB 5:17">एकरसेति सर्वसक्तिमान के ताड़ना ला तुछ झन जान।<verse eid="JOB 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 5:18" />काबरकि ओह चोट पहुंचाथे, पर ओहीच ह पट्टी घलो बांधथे;</para>
  <para style="q2" vid="JOB 5:18">ओह घायल करथे, पर ओकर हांथमन घायल ला बने घलो करथें।<verse eid="JOB 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 5:19" />छै बिपत्तिमन ले ओह तोला छोंड़ाही;</para>
  <para style="q2" vid="JOB 5:19">सातवां म घलो तोर कुछू हानि नइं होही।<verse eid="JOB 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 5:20" />दुकाल म ओह तोला मिरतू ले,</para>
  <para style="q2" vid="JOB 5:20">अऊ लड़ई म तलवार के वार ले बचाही।<verse eid="JOB 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 5:21" />तेंह जीभ ले निकले बचन के मार ले बचाय जाबे,</para>
  <para style="q2" vid="JOB 5:21">अऊ जब बिनास ह तोर ऊपर आवय, त तोला डरे के जरूरत नइं ए।<verse eid="JOB 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 5:22" />तेंह बिनास अऊ दुकाल के बेरा म हंसबे,</para>
  <para style="q2" vid="JOB 5:22">अऊ जंगली पसुमन ले तोला डर नइं होही।<verse eid="JOB 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 5:23" />काबरकि मैदान के पथरामन संग तोर एक करार होही,</para>
  <para style="q2" vid="JOB 5:23">अऊ जंगली पसुमन तोर मितान सहीं होहीं।<verse eid="JOB 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 5:24" />तेंह जानबे कि तोर डेरा ह कुसल हवय;</para>
  <para style="q2" vid="JOB 5:24">तेंह अपन संपत्ति के जांच करबे अऊ तोर कुछू चीज गंवाय नइं रहिही।<verse eid="JOB 5:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 5:25" />तेंह ये घलो जानबे कि तोर लइकामन अब्बड़ होहीं,</para>
  <para style="q2" vid="JOB 5:25">अऊ तोर संतानमन भुइयां के कांदी सहीं बहुंत होहीं।<verse eid="JOB 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 5:26" />जइसे कि समय म बीड़ा ला खरही गांजे जाथे,</para>
  <para style="q2" vid="JOB 5:26">वइसे ही तेंह तोर पूरा उमर होय के बाद ही मरबे।<verse eid="JOB 5:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JOB 5:27" />“हमन येला परखके देख डारे हन, अऊ येह सच अय।</para>
  <para style="q2" vid="JOB 5:27">एकरसेति येला सुन, अऊ येला अपन जिनगी म लागू कर।”<verse eid="JOB 5:27" /></para>
  <chapter eid="JOB 5" />
  <chapter number="6" style="c" sid="JOB 6" />
  <para style="s1">अयूब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 6:1" />तब अयूब ह कहिस:<verse eid="JOB 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 6:2" />“यदि मोर पीरा ला तऊले जातिस</para>
  <para style="q2" vid="JOB 6:2">अऊ मोर दुरगति ला तराजू म मढ़ाय जातिस!<verse eid="JOB 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 6:3" />त खचित येह समुंदर के बालू ले जादा भारी होतिस—</para>
  <para style="q2" vid="JOB 6:3">कोनो अचम्भो के बात नो हय कि मेंह अपन गोठ म उतावला हो गे हंव।<verse eid="JOB 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 6:4" />सर्वसक्तिमान परमेसर के बानमन मोला बेधे हवंय,</para>
  <para style="q2" vid="JOB 6:4">मोर आतमा ह ओमन के जहर ला पीयथे;</para>
  <para style="q2" vid="JOB 6:4">परमेसर के आतंक ह मोर बिरोध म ठाढ़े हवय।<verse eid="JOB 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 6:5" />का जंगली गदहा ह रेंकथे, जब ओकर करा खाय बर कांदी रहिथे,</para>
  <para style="q2" vid="JOB 6:5">या का बईला ह नरियाथे, जब ओकर करा चारा रहिथे?<verse eid="JOB 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 6:6" />का बिगर सुवादवाले जेवन ला बिगर नून के खाय जाथे,</para>
  <para style="q2" vid="JOB 6:6">या दवाई के पऊधा के रस म कोनो सुवाद होथे?<verse eid="JOB 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 6:7" />मेंह येला छुये बर घलो नइं चाहंव;</para>
  <para style="q2" vid="JOB 6:7">अइसने जेवन ह मोला बिमरहा कस घिन लगथे।<verse eid="JOB 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 6:8" />“बने होतिस, कि मोर बिनती ह सुने जातिस,</para>
  <para style="q2" vid="JOB 6:8">अऊ जऊन बात के मेंह आसा करथंव, परमेसर ह ओला पूरा करतिस,<verse eid="JOB 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 6:9" />कि परमेसर ह मोला कुचर डारे के ईछा करतिस,</para>
  <para style="q2" vid="JOB 6:9">अऊ ओह अपन हांथ ला बढ़ाके मोर परान ला ले लेतिस!<verse eid="JOB 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 6:10" />तब मोला ये बात म ढाढ़स होतिस—</para>
  <para style="q2" vid="JOB 6:10">अब्बड़ पीरा म मोला आनंद होतिस—</para>
  <para style="q2" vid="JOB 6:10">कि मेंह ओ पबितर परमेसर के बचन ला इनकार नइं करेंव।<verse eid="JOB 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOB 6:11" />“मोर म बल ही कहां हवय कि में अब भी आसा करंव?</para>
  <para style="q2" vid="JOB 6:11">मोर सोच-बिचार ही का अय कि में धीरज धरंव?<verse eid="JOB 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 6:12" />का मोर बल पथरा कस हवय?</para>
  <para style="q2" vid="JOB 6:12">का मोर देहें ह कांसा कस हवय?<verse eid="JOB 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 6:13" />का मोर करा अपनआप के मदद करे बर कोनो सक्ति हवय?</para>
  <para style="q2" vid="JOB 6:13">का सफलता ह मोर ले दूरिहा नइं हो गे हवय?<verse eid="JOB 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOB 6:14" />“जऊन ह अपन संगी ऊपर दया नइं करय,</para>
  <para style="q2" vid="JOB 6:14">ओह सर्वसक्तिमान के भय मानना छोंड़ देथे।<verse eid="JOB 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 6:15" />पर मोर भाईमन समय-समय म बोहावत ओ नरवामन कस दगाबाज अंय,</para>
  <para style="q2" vid="JOB 6:15">जऊन मन छलकत बहथें<verse eid="JOB 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 6:16" />जब पिघलत बरफ के दुवारा मतलहा हो जाथें</para>
  <para style="q2" vid="JOB 6:16">अऊ टघले बरफ ह ओमा मिल जाथे।<verse eid="JOB 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 6:17" />पर सूखा समय म ओमन के बहना बंद हो जाथे,</para>
  <para style="q2" vid="JOB 6:17">अऊ गरमी म ओमन अपन जगह ले गायब हो जाथें।<verse eid="JOB 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 6:18" />यातरा करइया दलमन अपन रसता ले भटक जाथें;</para>
  <para style="q2" vid="JOB 6:18">ओमन भटकके सुनसान जगह म चल देथें अऊ नास हो जाथें।<verse eid="JOB 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 6:19" />तेमा<note caller="+" style="f"><char style="fr" closed="false">6:19 </char><char style="ft" closed="false">संभवतः अकाबा के खाड़ी के दक्खिन-पूरब म एक मरू-उदयान; देखव <char style="xt"><ref loc="ISA 21:14">यसा 21:14</ref></char> अऊ <char style="xt"><ref loc="JER 25:23">यर 25:23</ref></char></char></note> के यातरा करइया दलमन पानी खोजथें,</para>
  <para style="q2" vid="JOB 6:19">सेबा नांव के जगह के यातरा करइया बेपारीमन ओकर आसा करत रहिथें।<verse eid="JOB 6:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 6:20" />ओमन ला निरासा होथे, काबरकि ओमन भरोसा रखे रिहिन;</para>
  <para style="q2" vid="JOB 6:20">ओमन उहां हबरिन, त ओमन ला निरासा होईस।<verse eid="JOB 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 6:21" />वइसने तुमन घलो साबित कर दे हव कि तुमन मोर कोनो मदद नइं कर सकव;</para>
  <para style="q2" vid="JOB 6:21">तुमन मोर बिपत्ति ला देखके डरा गे हवव।<verse eid="JOB 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 6:22" />का मेंह कभू कहेंव, ‘मोर कोति ले कुछू देवव,</para>
  <para style="q2" vid="JOB 6:22">अपन संपत्ति म ले मोर बर एक छुड़ौती दव,<verse eid="JOB 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 6:23" />बईरी के हांथ ले मोला बचा लेवव,</para>
  <para style="q2" vid="JOB 6:23">निरदयी के पकड़ ले मोला छोंड़ावव?’<verse eid="JOB 6:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JOB 6:24" />“मोला सिखावव अऊ मेंह चुपेचाप रहिहूं;</para>
  <para style="q2" vid="JOB 6:24">मोला बतावव कि मेंह का गलती करे हंव।<verse eid="JOB 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 6:25" />खर्रा बोली ह कतेक पीरा देवइया होथे!</para>
  <para style="q2" vid="JOB 6:25">पर तुमन के बहस ह का साबित करथे?<verse eid="JOB 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 6:26" />का तुमन मोर कहे गोठ ला सुधारे चाहत हव,</para>
  <para style="q2" vid="JOB 6:26">अऊ मोर निरासा के गोठमन ला हवा के सहीं समझत हव?<verse eid="JOB 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 6:27" />तुमन तो अनाथमन ला गुलाम बनाय बर परची निकालहू,</para>
  <para style="q2" vid="JOB 6:27">अऊ अपन संगी ला घलो दाम लेके बदल डारहू।<verse eid="JOB 6:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="JOB 6:28" />“पर अब किरपा करके मोर कोति देखव।</para>
  <para style="q2" vid="JOB 6:28">का मेंह तुम्हर आघू म लबारी मारहूं?<verse eid="JOB 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 6:29" />नरम बनव, अनियायी झन होवव;</para>
  <para style="q2" vid="JOB 6:29">फेर बिचार करव, काबरकि मोर ईमानदारी ह संकट म हवय।<verse eid="JOB 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 6:30" />का मोर गोठ म कोनो बुरई के बात हवय?</para>
  <para style="q2" vid="JOB 6:30">का मेंह खराप भावना ला नइं चिन सकंव?<verse eid="JOB 6:30" /></para>
  <para style="b" />
  <chapter eid="JOB 6" />
  <chapter number="7" style="c" sid="JOB 7" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 7:1" />“का मनखेमन ला धरती म कठिन मेहनत नइं करे बर परय?</para>
  <para style="q2" vid="JOB 7:1">का ओमन के दिन ह बनी करइया बनिहार कस नइं होवय?<verse eid="JOB 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 7:2" />जइसने एक गुलाम ह संझा के छइहां के ईछा करथे,</para>
  <para style="q2" vid="JOB 7:2">या एक बनिहार ह अपन बनी के आसा म रहिथे,<verse eid="JOB 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 7:3" />वइसने ही मोला बेकार के महिनामन ला देय गे हवय,</para>
  <para style="q2" vid="JOB 7:3">अऊ मोर बर दुख भरे रथियामन ला ठहिराय गे हवय।<verse eid="JOB 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 7:4" />जब मेंह ढलंगथंव, त मेंह सोचथंव, ‘मेंह कब उठहूं?’</para>
  <para style="q2" vid="JOB 7:4">रथिया ह लाम होथे, अऊ मेंह बिहनियां होवत ले छटपटावत रहिथंव।<verse eid="JOB 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 7:5" />मोर देहें म कीरा अऊ घाव ह माटी के परत ले ढंकाय हवय,</para>
  <para style="q2" vid="JOB 7:5">मोर चमड़ी ह फट गे हवय अऊ घाव ह पाक गे हवय।<verse eid="JOB 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOB 7:6" />“मोर दिनमन कोसटा के ढरकी ले घलो जादा तेज चलत हवंय,</para>
  <para style="q2" vid="JOB 7:6">अऊ येमन बिगर कोनो आसा के बीत जाथें।<verse eid="JOB 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 7:7" />सुरता कर, हे परमेसर, मोर जिनगी ह सिरिप एक सांस अय;</para>
  <para style="q2" vid="JOB 7:7">मोर आंखीमन फेर कभू खुसी नइं देखहीं।<verse eid="JOB 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 7:8" />जऊन ह अभी मोला देखत हवय, ओकर आंखी ह मोला फेर नइं देखही;</para>
  <para style="q2" vid="JOB 7:8">तेंह मोला खोजबे, पर मेंह नइं मिलहूं।<verse eid="JOB 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 7:9" />जइसने बादर ह छरियाके गायब हो जाथे,</para>
  <para style="q2" vid="JOB 7:9">वइसने ही जऊन ला कबर म माटी दे दिये जाथे, ओह लहुंटके नइं आवय।<verse eid="JOB 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 7:10" />ओह अपन घर म फेर कभू नइं आही;</para>
  <para style="q2" vid="JOB 7:10">ओकर जगह ह ओला फेर कभू नइं चिनही।<verse eid="JOB 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOB 7:11" />“एकरसेति मेंह चुप नइं रहंव;</para>
  <para style="q2" vid="JOB 7:11">मेंह अपन आतमा के दुख म होके गोठियाहूं,</para>
  <para style="q2" vid="JOB 7:11">मेंह अपन जिनगी के करूवाहट म होके सिकायत करहूं।<verse eid="JOB 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 7:12" />का मेंह समुंदर अंव, या गहिरा पानी के बिकराल जन्तु,</para>
  <para style="q2" vid="JOB 7:12">कि तें मोला पहरेदारी म रखबे?<verse eid="JOB 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 7:13" />जब मेंह सोचथंव, मोर खटिया म मोला सांति मिलही</para>
  <para style="q2" vid="JOB 7:13">अऊ बिछौना म मोला मोर पीरा ले हरू लगही,<verse eid="JOB 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 7:14" />तब घलो तें मोला सपना म डरवाथस</para>
  <para style="q2" vid="JOB 7:14">अऊ दरसन देखाके मोला भयभीत करथस,<verse eid="JOB 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 7:15" />एकरसेति मोर गला घोंटे जावय अऊ मोला मिरतू मिलय,</para>
  <para style="q2" vid="JOB 7:15">एकर बदले कि मेंह ये देहें म बने रहंव।<verse eid="JOB 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 7:16" />मोला अपन जिनगी ले घिन आवथे; मेंह हमेसा जीयत नइं रहंव।</para>
  <para style="q2" vid="JOB 7:16">मोला अकेला छोंड़ दे; मोर जिनगी के दिनमन के कोनो मतलब नइं ए।<verse eid="JOB 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JOB 7:17" />“मनखे ह का ए कि तेंह ओला बहुंत महत्व देथस,</para>
  <para style="q2" vid="JOB 7:17">अऊ तेंह ओकर ऊपर बहुंत धियान देथस,<verse eid="JOB 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 7:18" />अऊ तेंह रोज बिहनियां ओकर जांच करथस</para>
  <para style="q2" vid="JOB 7:18">अऊ छिन-छिन म ओला परखत रहिथस?<verse eid="JOB 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 7:19" />का तेंह कभू मोर देखभाल करई नइं छोंड़स,</para>
  <para style="q2" vid="JOB 7:19">या छिन भर के लागि घलो मोला अकेला नइं छोंड़स?<verse eid="JOB 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 7:20" />तेंह ओ अस, जऊन ह हमर हर एक काम ला देखत रहिथे,</para>
  <para style="q2" vid="JOB 7:20">अगर मेंह पाप करे हंव, त मेंह तोर का बिगाड़े हंव?</para>
  <para style="q1" vid="JOB 7:20">तेंह काबर मोला अपन निसाना बनाय हस?</para>
  <para style="q2" vid="JOB 7:20">का मेंह तोर बर बोझ बन गे हवंव?<verse eid="JOB 7:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 7:21" />तेंह काबर मोर अपराध</para>
  <para style="q2" vid="JOB 7:21">अऊ मोर पाप ला छेमा नइं करस?</para>
  <para style="q1" vid="JOB 7:21">काबरकि अब तो मेंह माटी म मिल जाहूं;</para>
  <para style="q2" vid="JOB 7:21">तेंह मोला खोजबे, फेर मोला नइं पाबे।”<verse eid="JOB 7:21" /></para>
  <chapter eid="JOB 7" />
  <chapter number="8" style="c" sid="JOB 8" />
  <para style="s1">बिलदद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 8:1" />तब सूही के रहइया बिलदद ह जबाब दीस:<verse eid="JOB 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 8:2" />“तेंह कब तक अइसने बातमन ला कहत रहिबे?</para>
  <para style="q2" vid="JOB 8:2">तोर गोठमन गरजत गरेर सहीं अंय?<verse eid="JOB 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 8:3" />का परमेसर ह नियाय ला बिगाड़थे?</para>
  <para style="q2" vid="JOB 8:3">का सर्वसक्तिमान ह सही बात ला गलत कर देथे?<verse eid="JOB 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 8:4" />जब तोर लइकामन परमेसर के बिरूध पाप करिन,</para>
  <para style="q2" vid="JOB 8:4">त ओह ओमन ला ओमन के पाप के सजा दीस।<verse eid="JOB 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 8:5" />पर यदि तेंह ईमानदारी ले परमेसर ला सहायता बर खोजबे,</para>
  <para style="q2" vid="JOB 8:5">अऊ सर्वसक्तिमान ले बिनती करबे,<verse eid="JOB 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 8:6" />कहूं तेंह सुध अऊ धरमी अस,</para>
  <para style="q2" vid="JOB 8:6">त अभी घलो ओह तोर कोति ले ठाढ़ होही</para>
  <para style="q2" vid="JOB 8:6">अऊ तोला तोर पहिले के सम्पन्न दसा म ला दीही।<verse eid="JOB 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 8:7" />तोर सुरूआत ह छोटे जान पड़ही,</para>
  <para style="q2" vid="JOB 8:7">पर तोर भविस्य म बहुंत बढ़ती होही।<verse eid="JOB 8:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 8:8" />“पिछला पीढ़ी के मनखेमन ले पुछ</para>
  <para style="q2" vid="JOB 8:8">अऊ पता लगा कि ओमन के पुरखामन का सीखे रिहिन,<verse eid="JOB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 8:9" />काबरकि हमन तो कल जनमे हन अऊ कुछू नइं जानन,</para>
  <para style="q2" vid="JOB 8:9">अऊ धरती म हमर दिन ह छइहां कस अय।<verse eid="JOB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 8:10" />जऊन मन हमर ले पहिले आईन, का ओमन तोला नइं सिखाहीं अऊ नइं बताहीं?</para>
  <para style="q2" vid="JOB 8:10">का ओमन अपन समझ ले बात नइं करहीं?<verse eid="JOB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 8:11" />जिहां दलदली भुइयां नइं ए, का उहां पपीरस पऊधा ह लम्बा बढ़ सकथे?</para>
  <para style="q2" vid="JOB 8:11">का पानी बिगर कछार के कांदी ह बढ़ सकथे?<verse eid="JOB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 8:12" />ओमन बढ़ सकथें अऊ काटे घलो नइं गे रहंय,</para>
  <para style="q2" vid="JOB 8:12">पर ओमन कांदी ले घलो जल्दी सूख जाथें।<verse eid="JOB 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 8:13" />जऊन मन परमेसर ला बिसरा देथें, ओ जम्मो के हाल अइसने होथे;</para>
  <para style="q2" vid="JOB 8:13">अऊ अइसने भक्तिहीन मनखेमन के आसा ह टूट जाथे।<verse eid="JOB 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 8:14" />जेकर ऊपर ओमन भरोसा करथें, ओह कमजोर होथे;</para>
  <para style="q2" vid="JOB 8:14">अऊ जेला ओमन पतियाथें, ओह मेकरा के जाला सहीं अय।<verse eid="JOB 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 8:15" />ओमन जाला के ऊपर आसरा करथें, पर ओह टूट जाथे;</para>
  <para style="q2" vid="JOB 8:15">ओमन ओला थामथें, पर ओह थामे नइं रहय।<verse eid="JOB 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 8:16" />ओमन घाम म पानी पलोय गे पऊधा सहीं अंय,</para>
  <para style="q2" vid="JOB 8:16">जेकर डारामन बारी म चारों कोति बगरथें;<verse eid="JOB 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 8:17" />येह अपन जरीमन ला पथरा के कुढ़ा के चारों कोति लपेटथे</para>
  <para style="q2" vid="JOB 8:17">अऊ पथरामन के बीच म जगह खोजथे।<verse eid="JOB 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 8:18" />कहूं येला अपन जगह ले उखान दिये जाथे,</para>
  <para style="q2" vid="JOB 8:18">त ओ जगह ह ओकर इनकार करथे अऊ कहिथे, ‘मेंह तोला कभू देखे घलो नइं अंव।’<verse eid="JOB 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 8:19" />खचित, इही ह येकर जिनगी के अन्त अय,</para>
  <para style="q2" vid="JOB 8:19">अऊ ओ माटी म ले आने पऊधामन जामथें।<verse eid="JOB 8:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 8:20" />“खचित, परमेसर ह निरदोस मनखे ला अस्वीकार नइं करय</para>
  <para style="q2" vid="JOB 8:20">या दुस्ट काम करइया मनखेमन के हांथ ला मजबूत नइं करय।<verse eid="JOB 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 8:21" />ओह अब भी तोर मुहूं ला हंसी ले</para>
  <para style="q2" vid="JOB 8:21">अऊ तोर ओंठमन ला आनंद के जयकार ले भर दीही।<verse eid="JOB 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 8:22" />तोर बईरीमन ला लज्जित करे जाही,</para>
  <para style="q2" vid="JOB 8:22">अऊ दुस्टमन के डेरा कहूं मेर नइं रहिही।”<verse eid="JOB 8:22" /></para>
  <chapter eid="JOB 8" />
  <chapter number="9" style="c" sid="JOB 9" />
  <para style="s1">अयूब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 9:1" />तब अयूब ह जबाब दीस:<verse eid="JOB 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 9:2" />“सही म मेंह जानथंव कि येह सच अय।</para>
  <para style="q2" vid="JOB 9:2">पर परमेसर के आघू म मनखेमन कइसे अपन निरदोस होय के बात ला साबित कर सकथें?<verse eid="JOB 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 9:3" />हालाकि ओमन ओकर ले बाद-बिबाद करे बर चाहिन,</para>
  <para style="q2" vid="JOB 9:3">पर हजार म ले ओकर एको ठन गोठ के घलो जबाब नइं दे सकिन।<verse eid="JOB 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 9:4" />परमेसर ह अति बुद्धिमान ए अऊ अति बलवान ए।</para>
  <para style="q2" vid="JOB 9:4">कोन ह ओकर बिरोध करके बिगर हानि के बांचे हवय?<verse eid="JOB 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 9:5" />ओह पहाड़मन ला बिगर ओमन के जानकारी के टार देथे</para>
  <para style="q2" vid="JOB 9:5">अऊ ओह अपन रिस म ओमन ला उलट-पलट देथे।<verse eid="JOB 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 9:6" />ओह धरती ला अपन जगह ले हला देथे</para>
  <para style="q2" vid="JOB 9:6">अऊ ओकर खंभामन ला कंपा देथे।<verse eid="JOB 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 9:7" />ओकर कहे ले सूरज ह घलो अंजोर नइं देवय;</para>
  <para style="q2" vid="JOB 9:7">ओह तारामन के अंजोर ला बंद कर देथे।<verse eid="JOB 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 9:8" />ओह एके झन अकास-मंडल ला तानथे</para>
  <para style="q2" vid="JOB 9:8">अऊ समुंदर के लहरामन ऊपर चलथे।<verse eid="JOB 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 9:9" />ओह सपतरसी अऊ सिकारी तारापुंज</para>
  <para style="q2" vid="JOB 9:9">किरतिका अऊ दक्खिन के नछत्रमन के रचइता अय।<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओह उत्तरी अकास म तारामन के समूह, मांझा के अकास म तारामन के समूह ला बनाईस</char></note><verse eid="JOB 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 9:10" />परमेसर ह अइसने अद्भूत काम करथे, जेला समझे नइं जा सकय,</para>
  <para style="q2" vid="JOB 9:10">अऊ ओह अतेक चमतकार करथे, जेला गने नइं जा सकय।<verse eid="JOB 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 9:11" />जब ओह मोर लकठा ले होके निकलथे, त मेंह ओला देख नइं सकंव;</para>
  <para style="q2" vid="JOB 9:11">जब ओह चलथे, त मेंह समझ नइं सकंव।<verse eid="JOB 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 9:12" />कहूं ओह कुछू झटकके ले जाथे, त कोन ह ओला रोक सकथे?</para>
  <para style="q2" vid="JOB 9:12">कोन ह ओला पुछ सकत हे, ‘तें का करत हस?’<verse eid="JOB 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 9:13" />परमेसर ह अपन रिस ला नइं रोकय;</para>
  <para style="q2" vid="JOB 9:13">इहां तक कि राहाब<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="fq" closed="false">राहाब </char><char style="ft" closed="false">पुराना जमाना के काल्पनिक समुंदर के </char><char style="fqa" closed="false">अस्सूर</char></note> के मदद करइयामन ओकर पांव खाल्हे झुकिन।<verse eid="JOB 9:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOB 9:14" />“त मेंह ओकर संग कइसे झगरा कर सकत हंव?</para>
  <para style="q2" vid="JOB 9:14">ओकर संग बहस करे बर मेंह बचन कइसे पा सकथंव?<verse eid="JOB 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 9:15" />हालाकि मेंह निरदोस रहेंव, तभो ले ओला जबाब नइं दे सकेंव;</para>
  <para style="q2" vid="JOB 9:15">मेंह अपन नियाय करइया करा दया करे बर सिरिप बिनती कर सकहूं।<verse eid="JOB 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 9:16" />अऊ त अऊ कहूं मेंह ओकर ले गोहार पारतेंव अऊ ओह जबाब घलो देतिस,</para>
  <para style="q2" vid="JOB 9:16">पर मेंह बिसवास नइं करंव कि ओह मोर बात ला सुनही।<verse eid="JOB 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 9:17" />ओह आंधी चलाके मोला कुचर डारही</para>
  <para style="q2" vid="JOB 9:17">अऊ बिगर कोनो कारन के ओह मोला घाव के ऊपर घाव दीही।<verse eid="JOB 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 9:18" />ओह मोला सांस लेवन घलो नइं दीही</para>
  <para style="q2" vid="JOB 9:18">पर मोला दुख ले बियाकुल कर दीही।<verse eid="JOB 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 9:19" />कहूं येह बल के बात अय, त ओह बलसाली अय!</para>
  <para style="q2" vid="JOB 9:19">अऊ कहूं येह नियाय के बात अय, त कोन ह ओला ललकार सकथे?<verse eid="JOB 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 9:20" />चाहे मेंह बिना दोस के होवंव, पर मोर बात ह मोला गलत ठहिराही;</para>
  <para style="q2" vid="JOB 9:20">कहूं मेंह निरदोस होवंव, पर ओह मोला दोसी ठहिराही।<verse eid="JOB 9:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOB 9:21" />“हालाकि में निरदोस अंव,</para>
  <para style="q2" vid="JOB 9:21">मोला अपन बर चिंता नइं ए;</para>
  <para style="q2" vid="JOB 9:21">में अपन खुद के जिनगी ला तुछ समझथंव।<verse eid="JOB 9:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 9:22" />जम्मो बात ह एकेच अय; एकरसेति मेंह कहिथंव,</para>
  <para style="q2" vid="JOB 9:22">‘ओह निरदोस अऊ दुस्ट दूनों ला नास करथे।’<verse eid="JOB 9:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 9:23" />जब कोनो बिपत्ति ह अचानक मिरतू लानथे,</para>
  <para style="q2" vid="JOB 9:23">त ओह निरदोस मनखे के निरासा के हंसी उड़ाथे।<verse eid="JOB 9:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 9:24" />जब कोनो भुइयां ला दुस्ट मनखे के हांथ म दिये जाथे,</para>
  <para style="q2" vid="JOB 9:24">त परमेसर ह येकर नियाय करइयामन के आंखी ला मुंद देथे।</para>
  <para style="q2" vid="JOB 9:24">अइसने करइया ओह नो हय, त कोन अय?<verse eid="JOB 9:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOB 9:25" />“मोर जिनगी के दिनमन दऊड़नेवाला ले घलो जादा तेजी ले बीतत हवंय;</para>
  <para style="q2" vid="JOB 9:25">येमन बिगर कोनो आनंद के बीतत जावत हंय।<verse eid="JOB 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 9:26" />येमन पपीरस पऊधा के डोंगीमन कस निकल जावत हंय,</para>
  <para style="q2" vid="JOB 9:26">येमन अइसने बीतत हवंय, जइसने गिधवामन अपन सिकार ऊपर झपटथें।<verse eid="JOB 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 9:27" />कहूं मेंह कहंव, ‘मेंह अपन सिकायत ला भुला जाहूं</para>
  <para style="q3" vid="JOB 9:27">मेंह अपन पीरा ला छोंड़के मुस्कराहूं,’<verse eid="JOB 9:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 9:28" />तभो ले मेंह अपन जम्मो पीरा ले डरथंव,</para>
  <para style="q2" vid="JOB 9:28">काबरकि मेंह जानत हंव कि तेंह मोला निरदोस नइं ठहिराबे।<verse eid="JOB 9:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 9:29" />जब मेंह पहिले ले ही दोसी पाय गे हंव,</para>
  <para style="q2" vid="JOB 9:29">त फेर मेंह बेकार म काबर मेहनत करंव?<verse eid="JOB 9:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 9:30" />चाहे मेंह अपनआप ला साबुन ले</para>
  <para style="q2" vid="JOB 9:30">अऊ अपन हांथमन ला सफई करइया पावडर ले धोवंव,<verse eid="JOB 9:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 9:31" />तभो ले तेंह मोला चीखला के खंचवा म डार देबे,</para>
  <para style="q2" vid="JOB 9:31">अऊ मोर ओनहामन घलो मोर ले घिन करे लगहीं।<verse eid="JOB 9:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="JOB 9:32" />“परमेसर ह मोर सहीं कोनो मरनहार मनखे नो हय कि मेंह ओला जबाब दे सकंव,</para>
  <para style="q2" vid="JOB 9:32">अऊ हमन अदालत म एक-दूसर के सामना करन।<verse eid="JOB 9:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 9:33" />यदि हमर बीच म कोनो समझौता करोइया होतिस,</para>
  <para style="q2" vid="JOB 9:33">जऊन ह हमन ला एक संग लानतिस,<verse eid="JOB 9:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 9:34" />जऊन ह मोर ऊपर ले परमेसर के छड़ी ला टारतिस,</para>
  <para style="q2" vid="JOB 9:34">ताकि मेंह ओकर आतंक ले कभू नइं डरतंय।<verse eid="JOB 9:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 9:35" />तब मेंह ओकर बिगर भय के गोठियातेंव,</para>
  <para style="q2" vid="JOB 9:35">पर मेंह अपनआप म वइसने नो हंव।<verse eid="JOB 9:35" /></para>
  <para style="b" />
  <chapter eid="JOB 9" />
  <chapter number="10" style="c" sid="JOB 10" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 10:1" />“मेंह अपन जिनगी ले घिन करथंव;</para>
  <para style="q2" vid="JOB 10:1">एकरसेति मेंह खुलके सिकायत करहूं</para>
  <para style="q2" vid="JOB 10:1">अऊ अपन मन के करूवाहट ले गोठियाहूं।<verse eid="JOB 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 10:2" />मेंह परमेसर ला कहिथंव: मोला दोसी झन ठहिरा,</para>
  <para style="q2" vid="JOB 10:2">पर मोला बता कि मेंह तोर बिरोध म का अपराध करे हंव।<verse eid="JOB 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 10:3" />का मोला सताना,</para>
  <para style="q2" vid="JOB 10:3">अपन हांथ के काम ला तुछ जानना तोला बने लगथे,</para>
  <para style="q2" vid="JOB 10:3">जबकि दुस्टमन के बनाय योजना ऊपर तेंह हांसथस?<verse eid="JOB 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 10:4" />का तोर आंखीमन मनखे के आंखी कस हवंय?</para>
  <para style="q2" vid="JOB 10:4">का तेंह वइसने देखथस, जइसने मनखेमन देखथें?<verse eid="JOB 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 10:5" />का तोर उमर के दिन ह मनखे के दिन कस छोटे अय</para>
  <para style="q2" vid="JOB 10:5">या का तोर बछर ह मनखे के बछर सहीं अय,<verse eid="JOB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 10:6" />कि तेंह मोर गलतीमन ला खोजबे</para>
  <para style="q2" vid="JOB 10:6">अऊ मोर पाप के जांच-पड़ताल करबे—<verse eid="JOB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 10:7" />हालाकि तेंह जानत हस कि मेंह दोसी नो हंव</para>
  <para style="q2" vid="JOB 10:7">अऊ ये घलो कि तोर हांथ ले मोला कोनो बचाय नइं सकय?<verse eid="JOB 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 10:8" />“तोर हांथमन मोला रूप देय हवंय अऊ मोला बनाय हवंय।</para>
  <para style="q2" vid="JOB 10:8">तभो ले का तेंह मोला नास कर देबे?<verse eid="JOB 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 10:9" />सुरता कर कि तेंह मोला माटी ले बनाय हवस।</para>
  <para style="q2" vid="JOB 10:9">का तेंह मोला फेर धुर्रा म मिला देबे?<verse eid="JOB 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 10:10" />का तेंह मोला दूध के सहीं नइं रितोय</para>
  <para style="q2" vid="JOB 10:10">अऊ दही के सहीं नइं जमाय?<verse eid="JOB 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 10:11" />का तेंह मोर ऊपर मांस अऊ चमड़ी नइं चघाय</para>
  <para style="q2" vid="JOB 10:11">अऊ हाड़ा अऊ नसमन ला एक संग बुनके मोला नइं बनाय?<verse eid="JOB 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 10:12" />तेंह मोला जिनगी देय अऊ मोर ऊपर दया करय,</para>
  <para style="q2" vid="JOB 10:12">अऊ तोर किरपा के कारन मोर आतमा के देखरेख होय हवय।<verse eid="JOB 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 10:13" />“पर तेंह अपन हिरदय म ये बातमन ला लुकाके राखे हवस,</para>
  <para style="q2" vid="JOB 10:13">अऊ मेंह जानथंव कि येह तोर मन म रिहिस:<verse eid="JOB 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 10:14" />कहूं मेंह कोनो पाप करेंव, त तेंह ओला देखत होबे</para>
  <para style="q2" vid="JOB 10:14">अऊ मोला बिगर सजा दिये नइं छोंड़बे।<verse eid="JOB 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 10:15" />कहूं मेंह दोसी अंव, त दुख-तकलीफ मोर ऊपर आवय,</para>
  <para style="q2" vid="JOB 10:15">अऊ कहूं मेंह निरदोस घलो होवंव, तभो ले मेंह अपन मुड़ उठा नइं सकंव,</para>
  <para style="q1" vid="JOB 10:15">काबरकि मेंह बहुंत लज्जित हंव</para>
  <para style="q2" vid="JOB 10:15">अऊ अपन पीरा म मरत हंव।<verse eid="JOB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 10:16" />यदि मेंह अपन मुड़ ला उठावंव, त तेंह सेर के सिकार करे सहीं लुकाके मोर पीछा करथस</para>
  <para style="q2" vid="JOB 10:16">अऊ फेर तेंह मोर बिरोध म अपन अद्भूत बल देखाथस।<verse eid="JOB 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 10:17" />तेंह मोर बिरोध म नवां गवाहमन ले आथस</para>
  <para style="q2" vid="JOB 10:17">अऊ मोर ऊपर अपन रिस ला बढ़ाथस</para>
  <para style="q2" vid="JOB 10:17">अऊ बाधा के ऊपर बाधा मोर बिरोध म ले आथस।<verse eid="JOB 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOB 10:18" />“फेर तेंह मोला गरभ ले निकाले काबर?</para>
  <para style="q2" vid="JOB 10:18">बने होतिस, काकरो देखे के पहिली, मेंह मर गे रहितेंव,<verse eid="JOB 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 10:19" />मोर रचना नइं होय रहितिस,</para>
  <para style="q2" vid="JOB 10:19">या सीधा गरभ ले कबर म अमराय गे रहितेंव!<verse eid="JOB 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 10:20" />का मोर बांचे जिनगी के दिनमन थोरकून नइं ए?</para>
  <para style="q2" vid="JOB 10:20">मोला छोंड़ दे कि मेंह आनंद के कुछू समय बीता सकंव<verse eid="JOB 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 10:21" />येकर पहिली कि मेंह ओ जगह म जावंव, जिहां ले कोनो नइं लहुंटंय,</para>
  <para style="q2" vid="JOB 10:21">ओ जगह, जिहां अंधियार अऊ भारी अंधियार हवय,<verse eid="JOB 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 10:22" />याने ओ जगह, जिहां घोर रथिया,</para>
  <para style="q2" vid="JOB 10:22">भारी अंधियार अऊ गड़बड़ हवय,</para>
  <para style="q2" vid="JOB 10:22">अऊ त अऊ जिहां अंजोर ह घलो अंधियार सहीं अय।”<verse eid="JOB 10:22" /></para>
  <chapter eid="JOB 10" />
  <chapter number="11" style="c" sid="JOB 11" />
  <para style="s1">सोपर</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 11:1" />तब नामात के रहइया सोपर ह जबाब दीस:<verse eid="JOB 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 11:2" />“का ये जम्मो गोठ के जबाब नइं देना चाही?</para>
  <para style="q2" vid="JOB 11:2">का ये गोठ कहइया के समरथन करे जावय?<verse eid="JOB 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 11:3" />का तोर बड़े बोल ले आने मन चुप रहंय?</para>
  <para style="q2" vid="JOB 11:3">का तोला कोनो झन डांटय, जब तेंह हंसी उड़ाथस?<verse eid="JOB 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 11:4" />तेंह परमेसर ले कहिथस, ‘मोर बिसवास म कोनो कमी नइं ए</para>
  <para style="q2" vid="JOB 11:4">अऊ मेंह तोर नजर म सुध हवंव।’<verse eid="JOB 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 11:5" />बने होतिस, परमेसर ह खुद गोठियातिस,</para>
  <para style="q2" vid="JOB 11:5">अऊ तोर बिरोध म अपन मुहूं ला खोलतिस<verse eid="JOB 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 11:6" />अऊ तोर ऊपर बुद्धि के गुपत गोठमन ला परगट करतिस,</para>
  <para style="q2" vid="JOB 11:6">काबरकि सत-बुद्धि के दू ठन पहलू हवय।</para>
  <para style="q2" vid="JOB 11:6">येला जान ले: परमेसर ह तोर कुछू पापमन ला भुला गे हवय।<verse eid="JOB 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 11:7" />“का तेंह परमेसर के भेद के बातमन ला समझ सकथस?</para>
  <para style="q2" vid="JOB 11:7">का तेंह सर्वसक्तिमान के सीमना के पता पा सकत हस?<verse eid="JOB 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 11:8" />ओमन स्वरगमन ले घलो ऊंच हवंय—तेंह का कर सकत हस?</para>
  <para style="q2" vid="JOB 11:8">ओह तो पाताल-लोक ले जादा गहिरा हवय—तेंह का जान सकत हस?<verse eid="JOB 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 11:9" />ओमन के नाप ह धरती ले लम्बा</para>
  <para style="q2" vid="JOB 11:9">अऊ समुंदर ले घलो जादा चाकर हवय।<verse eid="JOB 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOB 11:10" />“कहूं ओह आवय अऊ तोला जेल म डाल देवय</para>
  <para style="q2" vid="JOB 11:10">अऊ अदालत लगावय, त कोन ह ओला रोक सकथे?<verse eid="JOB 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 11:11" />खचित ओह धोखा देवइयामन ला चिन लेथे;</para>
  <para style="q2" vid="JOB 11:11">अऊ जब ओह बुरई देखथे, त का ओह ओला धियान नइं देवय?<verse eid="JOB 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 11:12" />पर मुरूख मनखे ह बुद्धिमान नइं बन सकय,</para>
  <para style="q2" vid="JOB 11:12">जइसे कि जंगली गदहा के पीला ह मनखे के रूप म नइं जनम सकय।<verse eid="JOB 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 11:13" />“तभो ले कहूं तेंह अपन मन ला ओकर कोति लगाथस</para>
  <para style="q2" vid="JOB 11:13">अऊ अपन हांथमन ला ओकर कोति पसारथस,<verse eid="JOB 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 11:14" />यदि तेंह अपन पापमन ला छोंड़ देथस</para>
  <para style="q2" vid="JOB 11:14">अऊ अपन डेरा म बुरई ला रहे बर नइं देवस,<verse eid="JOB 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 11:15" />तब, तेंह निरदोस होके अपन चेहरा ऊपर उठा सकबे;</para>
  <para style="q2" vid="JOB 11:15">अऊ तेंह बिगर भय के मजबूत ठाढ़े रहिबे।<verse eid="JOB 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 11:16" />तेंह खचित अपन दुख ला भुला जाबे,</para>
  <para style="q2" vid="JOB 11:16">ओह तोला सिरिप बहा दिये गय पानी कस सुरता रहिही।<verse eid="JOB 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 11:17" />तोर जिनगी ह मंझनियां ले घलो जादा चमकदार होही,</para>
  <para style="q2" vid="JOB 11:17">अऊ अंधियार ह बिहनियां कस हो जाही।<verse eid="JOB 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 11:18" />तेंह सुरकछित रहिबे, काबरकि तोला आसा होही;</para>
  <para style="q2" vid="JOB 11:18">तेंह अपनआप ला देखबे अऊ निरभय होके अराम करबे।<verse eid="JOB 11:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 11:19" />जब तेंह लेटबे, त तोला कोनो नइं डराहीं,</para>
  <para style="q2" vid="JOB 11:19">अऊ बहुंते झन तोर बर मया देखाहीं।<verse eid="JOB 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 11:20" />पर दुस्ट मनखेमन के आंखीमन अंधरा हो जाहीं,</para>
  <para style="q2" vid="JOB 11:20">अऊ ओमन ला बचके निकले के कोनो रसता नइं दिखही;</para>
  <para style="q2" vid="JOB 11:20">ओमन ये आसा करहीं कि ओमन मर जावंय।”<verse eid="JOB 11:20" /></para>
  <chapter eid="JOB 11" />
  <chapter number="12" style="c" sid="JOB 12" />
  <para style="s1">अयूब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 12:1" />तब अयूब ह जबाब दीस:<verse eid="JOB 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 12:2" />“तुमन सोचथव कि सिरिप तुमन ही महत्व के मनखे अव</para>
  <para style="q2" vid="JOB 12:2">अऊ तुम्हर मरे ले तुम्हर संग बुद्धि ह घलो खतम हो जाही!<verse eid="JOB 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 12:3" />पर मोर म घलो तुम्हर सहीं समझ हवय;</para>
  <para style="q2" vid="JOB 12:3">मेंह तुमन ले कम नो हंव,</para>
  <para style="q2" vid="JOB 12:3">कोन ह ये जम्मो बातमन ला नइं जानय?<verse eid="JOB 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 12:4" />“मेंह अपन संगीमन बर ठिठोली के बिसय बन गे हवंव,</para>
  <para style="q2" vid="JOB 12:4">हालाकि मेंह परमेसर ले गोहारेंव अऊ ओह जबाब दीस—</para>
  <para style="q2" vid="JOB 12:4">हालाकि में धरमी अऊ निरदोस अंव, तभो ले एक ठिठोली के बिसय बन गे हवंव!<verse eid="JOB 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 12:5" />जऊन मन अराम के जिनगी जीयथें, ओमन दुखी मनखे ले घिन करथें</para>
  <para style="q2" vid="JOB 12:5">अऊ जेमन के गोड़ ह फिसलथे ओमन ला ढकेल देथें।<verse eid="JOB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 12:6" />लुटेरामन के डेरा म कोनो समस्या नइं आवय,</para>
  <para style="q2" vid="JOB 12:6">अऊ जऊन मन परमेसर ला रिस देवाथें, ओमन सुरकछित हवंय—</para>
  <para style="q2" vid="JOB 12:6">ओमन के ईस्वर ह ओमन के मुठा म हवय।<verse eid="JOB 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 12:7" />“पर पसुमन ले पुछ, अऊ ओमन तोला सिखोहीं,</para>
  <para style="q2" vid="JOB 12:7">या अकास के चिरईमन ले पुछ, अऊ ओमन तोला बताहीं;<verse eid="JOB 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 12:8" />या धरती ले गोठिया, अऊ येह तोला सिखोही,</para>
  <para style="q2" vid="JOB 12:8">या समुंदर के मछरीमन तोला बतावंय।<verse eid="JOB 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 12:9" />ये जम्मो म ले कोन ह नइं जानय</para>
  <para style="q2" vid="JOB 12:9">कि यहोवा ह अपन हांथ ले येला करे हवय?<verse eid="JOB 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 12:10" />ओकर हांथ म जम्मो जीवमन के जिनगी</para>
  <para style="q2" vid="JOB 12:10">अऊ जम्मो मनखेमन के सांस हवय।<verse eid="JOB 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 12:11" />का कान ह सबदमन ला नइं परखय,</para>
  <para style="q2" vid="JOB 12:11">जइसे जीभ ह जेवन के सुवाद ला चखथे?<verse eid="JOB 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 12:12" />का सियान मनखेमन के बीच म बुद्धि नइं पाय जावय?</para>
  <para style="q2" vid="JOB 12:12">का जादा उमरवालामन म समझदारी नइं रहय?<verse eid="JOB 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 12:13" />“बुद्धि अऊ बल परमेसर के अय;</para>
  <para style="q2" vid="JOB 12:13">सलाह अऊ समझ ओकर करा हवय।<verse eid="JOB 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 12:14" />जऊन ला ओह टोर-फोर देथे, ओला फेर नइं बनाय जा सकय;</para>
  <para style="q2" vid="JOB 12:14">जऊन ला ओह बंदी बनाथे, ओला छोंड़ाय नइं जा सकय।<verse eid="JOB 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 12:15" />यदि ओह पानी ला रोक देथे, त उहां सूखा पड़थे;</para>
  <para style="q2" vid="JOB 12:15">यदि ओह पानी ला छोंड़ देथे, त भुइयां ह बरबाद हो जाथे।<verse eid="JOB 12:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 12:16" />बल अऊ बुद्धि परमेसर के अंय;</para>
  <para style="q2" vid="JOB 12:16">धोखा-खवइया अऊ धोखा देवइया दूनों ह ओकरेच अंय।<verse eid="JOB 12:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 12:17" />ओह सासन करइयामन ला ओमन के अधिकार ले अलग कर देथे</para>
  <para style="q2" vid="JOB 12:17">अऊ नियाय करइयामन ला मुरूख बना देथे।<verse eid="JOB 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 12:18" />ओह राजामन के दुवारा डारे गे बेड़ी ला निकाल देथे</para>
  <para style="q2" vid="JOB 12:18">अऊ ओमन के कनिहां ला कमरपट्टा ले जकड़ देथे।<verse eid="JOB 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 12:19" />ओह पुरोहितमन ला ओमन के अधिकार ले अलग कर देथे</para>
  <para style="q2" vid="JOB 12:19">अऊ जमे-जमाय अधिकारीमन ला उखान फेंकथे।<verse eid="JOB 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 12:20" />ओह भरोसावाले सलाहकारमन के बोलती बंद कर देथे</para>
  <para style="q2" vid="JOB 12:20">अऊ सियानमन के समझ ला छीन लेथे।<verse eid="JOB 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 12:21" />ओह उच्च घराना के मनखेमन के अपमान करथे</para>
  <para style="q2" vid="JOB 12:21">अऊ बलवानमन ला बलहीन कर देथे।<verse eid="JOB 12:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 12:22" />ओह अंधियार के गहिरा बातमन ला परगट कर देथे</para>
  <para style="q2" vid="JOB 12:22">अऊ घिटके अंधियार ला अंजोर म ले आथे।<verse eid="JOB 12:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 12:23" />ओह देसमन ला महान करथे, अऊ ओमन ला नास घलो करथे;</para>
  <para style="q2" vid="JOB 12:23">ओह देसमन के बिस्तार करथे, अऊ ओमन ला छितिर-बितिर घलो कर देथे।<verse eid="JOB 12:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 12:24" />ओह धरती के अगुवामन के बिबेक ला छीन लेथे;</para>
  <para style="q2" vid="JOB 12:24">अऊ ओमन ला बिगर रसतावाले बीरान जगह म भटकाथे।<verse eid="JOB 12:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 12:25" />ओमन अंजोर के बिगर अंधियार म टमड़त रहिथें;</para>
  <para style="q2" vid="JOB 12:25">ओह ओमन ला अइसे बना देथे कि ओमन मतवार सहीं लड़खड़ावत रेंगथें।<verse eid="JOB 12:25" /></para>
  <para style="b" />
  <chapter eid="JOB 12" />
  <chapter number="13" style="c" sid="JOB 13" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 13:1" />“मेंह ये जम्मो ला अपन आंखी ले देखे हवंव,</para>
  <para style="q2" vid="JOB 13:1">मेंह येला अपन कान ले सुने अऊ समझ गे हवंव।<verse eid="JOB 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 13:2" />जऊन कुछू तुमन जानत हव, ओला मेंह घलो जानत हंव;</para>
  <para style="q2" vid="JOB 13:2">मेंह तुमन ले कम नो हंव।<verse eid="JOB 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 13:3" />पर मेंह तो सर्वसक्तिमान परमेसर ले बात करे चाहत हंव</para>
  <para style="q2" vid="JOB 13:3">अऊ मोर हालत के बारे म परमेसर ले बहस करे चाहत हंव।<verse eid="JOB 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 13:4" />तुमन तो मोर ऊपर लबारी गोठ के धब्बा लगावत हव;</para>
  <para style="q2" vid="JOB 13:4">तुमन जम्मो झन बेकार के बईद अव।<verse eid="JOB 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 13:5" />कास! तुमन एकदम चुप रहितेव!</para>
  <para style="q2" vid="JOB 13:5">तुम्हर बर ओह बुद्धिमानी होतिस।<verse eid="JOB 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 13:6" />अब मोर बहस ला सुनव;</para>
  <para style="q2" vid="JOB 13:6">मोर तर्क के बात ला धियान देके सुनव।<verse eid="JOB 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 13:7" />का तुमन परमेसर बर खराप बात कहिहू?</para>
  <para style="q2" vid="JOB 13:7">का तुमन ओकर बर कपट ले भरे गोठ गोठियाहू?<verse eid="JOB 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 13:8" />का तुमन ओकर संग पखियपात करहू?</para>
  <para style="q2" vid="JOB 13:8">का तुमन परमेसर बर बहस करहू?<verse eid="JOB 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 13:9" />कहूं ओह तुमन ला जांचय, त का येह बने होही?</para>
  <para style="q2" vid="JOB 13:9">का तुमन ओला कोनो मनखे ला धोखा देय सहीं धोखा दे सकत हव?<verse eid="JOB 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 13:10" />कहूं तुमन गुपत म पखियपात करहू,</para>
  <para style="q2" vid="JOB 13:10">त ओह खचित तुम्हर ले लेखा लीही।<verse eid="JOB 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 13:11" />का ओकर सोभा तुमन ला भयभीत नइं करही?</para>
  <para style="q2" vid="JOB 13:11">का ओकर डर तुमन म नइं समाही?<verse eid="JOB 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 13:12" />तुम्हर कहावतमन राख के नीतिबचन अंय;</para>
  <para style="q2" vid="JOB 13:12">तुम्हर सुरकछा के गढ़मन माटी के गढ़ अंय।<verse eid="JOB 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 13:13" />“चुप रहव अऊ मोला गोठियावन दव;</para>
  <para style="q2" vid="JOB 13:13">फेर चाहे जऊन कुछू मोर ऊपर आवय, त आवय।<verse eid="JOB 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 13:14" />काबर मेंह अपनआप ला जोखिम म डारंव</para>
  <para style="q2" vid="JOB 13:14">अऊ अपन परान ला अपन हथेली म ले लंव?<verse eid="JOB 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 13:15" />चाहे परमेसर ह मोला मार घलो डारय, तभो ले मेंह ओकर ऊपर आसा रखहूं;</para>
  <para style="q2" vid="JOB 13:15">मेंह खचित ओकर आघू म अपन बात के बचाव करहूं।<verse eid="JOB 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 13:16" />वास्तव म, इही ह मोर छुटकारा के कारन होही,</para>
  <para style="q2" vid="JOB 13:16">काबरकि भक्तिहीन मनखे ह ओकर आघू म आय के हिम्मत नइं कर सकय!<verse eid="JOB 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 13:17" />मोर बात ला धियान देके सुनव;</para>
  <para style="q2" vid="JOB 13:17">मोर बचन ह तुम्हर कान म एकदम पड़य।<verse eid="JOB 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 13:18" />अब मेंह अपन मामला तियार कर लेय हंव,</para>
  <para style="q2" vid="JOB 13:18">मेंह जानत हंव कि मोला नियाय मिलही।<verse eid="JOB 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 13:19" />का कोनो मोर ऊपर दोस लगा सकथे?</para>
  <para style="q2" vid="JOB 13:19">कहूं कोनो मोला दोसी ठहिरा देवय, त मेंह चुप हो जाहूं अऊ मर जाहूं।<verse eid="JOB 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 13:20" />“हे परमेसर! सिरिप मोर दू ठन मांग ला पूरा कर दे,</para>
  <para style="q2" vid="JOB 13:20">अऊ तब मेंह तोर ले नइं लुकावंव:<verse eid="JOB 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 13:21" />तोर ताड़ना के हांथ ला मोर ऊपर ले हटा ले,</para>
  <para style="q2" vid="JOB 13:21">अऊ अपन आतंक ले मोला डराना बंद कर दे।<verse eid="JOB 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 13:22" />तब मोला बला अऊ मेंह जबाब दूहूं,</para>
  <para style="q2" vid="JOB 13:22">या फेर मोला गोठियावन दे, अऊ तें मोला ओकर जबाब दे।<verse eid="JOB 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 13:23" />मेंह कतेक गलती अऊ पाप करे हवंव?</para>
  <para style="q2" vid="JOB 13:23">मोला मोर अपराध अऊ मोर पाप ला बता।<verse eid="JOB 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 13:24" />तेंह अपन चेहरा ला काबर लुकावत हस</para>
  <para style="q2" vid="JOB 13:24">अऊ मोला अपन बईरी समझत हस?<verse eid="JOB 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 13:25" />का तेंह हवा म उड़ियावत रूख के पान ला दुख देबे?</para>
  <para style="q2" vid="JOB 13:25">या का तेंह सूखाय भूंसा के पाछू पड़बे?<verse eid="JOB 13:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 13:26" />तेंह मोर बिरोध म करू गोठमन ला लिखत हवस,</para>
  <para style="q2" vid="JOB 13:26">अऊ मोर जवानी के पाप के फल मोला भुगतात हवस।<verse eid="JOB 13:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 13:27" />तेंह मोर गोड़ म बेड़ी पहिरा दे हवस;</para>
  <para style="q2" vid="JOB 13:27">तेंह मोर गोड़ के तरवा म चिनहां देके</para>
  <para style="q2" vid="JOB 13:27">मोर जम्मो चालचलन ला धियान ले देखत रहिथस।<verse eid="JOB 13:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="JOB 13:28" />“अइसने मनखे ह तो सरे-गले चीज सहीं बेकार हो जाथे,</para>
  <para style="q2" vid="JOB 13:28">जइसने कि कोनो ओनहा ला कीरामन खा डारे हवंय।<verse eid="JOB 13:28" /></para>
  <para style="b" />
  <chapter eid="JOB 13" />
  <chapter number="14" style="c" sid="JOB 14" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 14:1" />“मनखेमन माईलोगन ले जनमथें,</para>
  <para style="q2" vid="JOB 14:1">ओमन थोरकन दिन के अंय अऊ ओमन के जिनगी ह दुख ले भरे रहिथे।<verse eid="JOB 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 14:2" />ओमन फूल कस फूलथें, अऊ फेर मुरझा जाथें;</para>
  <para style="q2" vid="JOB 14:2">ओमन तेजी ले ढरत छइहां कस अंय, अऊ टिके नइं रहंय।<verse eid="JOB 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 14:3" />का तेंह ओमन ऊपर अपन नजर डारबे?</para>
  <para style="q2" vid="JOB 14:3">का तेंह ओमन ला नियाय बर अपन आघू म लानबे?<verse eid="JOB 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 14:4" />कोन ह असुध चीज म ले सुध चीज ला निकाल सकत हे?</para>
  <para style="q2" vid="JOB 14:4">कोनो नइं!<verse eid="JOB 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 14:5" />मनखे के उमर के दिनमन ला निस्चित करे गे हवय;</para>
  <para style="q2" vid="JOB 14:5">तेंह ओकर महिनामन के संखिया के फैसला कर डारे हस</para>
  <para style="q2" vid="JOB 14:5">अऊ ओकर सिवाना ठहिराय हस जेकर आगे ओह नइं जा सकय।<verse eid="JOB 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 14:6" />एकरसेति जब तक ओह बनिहार कस अपन समय ला पूरा नइं कर लेवय,</para>
  <para style="q2" vid="JOB 14:6">ओकर ऊपर ले अपन नजर ला हटा ले अऊ ओला अकेला रहन दे।<verse eid="JOB 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 14:7" />“एक रूख बर कम से कम ये आसा रहिथे:</para>
  <para style="q2" vid="JOB 14:7">यदि येह काटे जावय, त येह फेर उलहोही,</para>
  <para style="q2" vid="JOB 14:7">अऊ येकर नवां पीका निकलई बंद नइं होही।<verse eid="JOB 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 14:8" />चाहे येकर जरीमन भुइयां म जुन्ना हो जावंय</para>
  <para style="q2" vid="JOB 14:8">अऊ येकर ठुड़गा ह माटी म सूखा जावय,<verse eid="JOB 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 14:9" />तभो ले पानी के गंध पाके येह उलहोही</para>
  <para style="q2" vid="JOB 14:9">अऊ एक पऊधा कस पीका निकालही।<verse eid="JOB 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 14:10" />पर मनखे ह मर जाथे अऊ खाल्हे म परे रहिथे;</para>
  <para style="q2" vid="JOB 14:10">ओकर परान निकल जाय के बाद ओह इहां नइं रहय।<verse eid="JOB 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 14:11" />जइसने झील के पानी ह घट जाथे</para>
  <para style="q2" vid="JOB 14:11">या नदी ह गरमी म सूखा जाथे,<verse eid="JOB 14:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 14:12" />वइसने ही मनखे ह लेटथे अऊ फेर नइं उठय;</para>
  <para style="q2" vid="JOB 14:12">जब तक अकासमन खतम नइं हो जाहीं, मनखे ह नइं जागही</para>
  <para style="q2" vid="JOB 14:12">या ओला नींद ले जगाय नइं जाही।<verse eid="JOB 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 14:13" />“कास! तेंह मोला कबर म लुकाके रखते</para>
  <para style="q2" vid="JOB 14:13">अऊ तब तक लुकाय रखते, जब तक कि तोर गुस्सा ह सांत नइं हो जातिस!</para>
  <para style="q1" vid="JOB 14:13">कास! तेंह मोर बर एक समय ठहिरा देते</para>
  <para style="q2" vid="JOB 14:13">अऊ तब मोला सुरता करते!<verse eid="JOB 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 14:14" />कहूं कोनो मनखे ह मर जावय, त का ओह फेर जीही?</para>
  <para style="q2" vid="JOB 14:14">अपन कठिन सेवा के जम्मो दिन म</para>
  <para style="q2" vid="JOB 14:14">जब तक मोर छुटकारा नइं हो जावय, मेंह अगोरत रहिहूं।<verse eid="JOB 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 14:15" />तेंह मोला बलाबे अऊ मेंह तोला जबाब दूहूं;</para>
  <para style="q2" vid="JOB 14:15">तेंह अपन हांथ ले रचे परानीमन के लालसा करबे।<verse eid="JOB 14:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 14:16" />खचित तब तेंह मोर कदम ला गनबे</para>
  <para style="q2" vid="JOB 14:16">पर मोर पाप के हिसाब नइं रखबे।<verse eid="JOB 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 14:17" />मोर अपराधमन थैली म मुहरबंद करे जाहीं;</para>
  <para style="q2" vid="JOB 14:17">तेंह मोर पाप ला ढांप देबे।<verse eid="JOB 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOB 14:18" />“पर जइसे पहाड़ ह गिरथे अऊ चूर-चूर हो जाथे</para>
  <para style="q2" vid="JOB 14:18">अऊ जइसे चट्टान ह अपन जगह ले हट जाथे,<verse eid="JOB 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 14:19" />जइसे पानी ह पथरामन ला घीस डारथे</para>
  <para style="q2" vid="JOB 14:19">अऊ पानी के धारा ह माटी ला बोहाके ले जाथे,</para>
  <para style="q2" vid="JOB 14:19">वइसे तेंह मनखे के आसा ला नास कर देथस।<verse eid="JOB 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 14:20" />तेंह ओमन ला हमेसा बर हरा देथस, अऊ ओमन चल देथें;</para>
  <para style="q2" vid="JOB 14:20">तेंह ओमन के चेहरा ला बदल देथस अऊ ओमन ला निकाल देथस।<verse eid="JOB 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 14:21" />यदि ओमन के लइकामन के सम्मान करे जाथे, त ओमन येला नइं जानंय;</para>
  <para style="q2" vid="JOB 14:21">यदि ओमन के संतानमन के बेजत्ती होथे, त ओमन येला नइं देख पावंय।<verse eid="JOB 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 14:22" />ओमन पीरा के अनुभव तो करथें पर सिरिप अपन देहें के पीरा,</para>
  <para style="q2" vid="JOB 14:22">अऊ ओमन सिरिप अपन बर सोक मनाथें।”<verse eid="JOB 14:22" /></para>
  <chapter eid="JOB 14" />
  <chapter number="15" style="c" sid="JOB 15" />
  <para style="s1">एलीपज</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 15:1" />तब तेमान के रहइया एलीपज ह जबाब दीस:<verse eid="JOB 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 15:2" />“का बुद्धिमान मनखे बिगर सोचे-बिचारे जबाब दीही</para>
  <para style="q2" vid="JOB 15:2">या गरम पूरबी पवन ले अपन पेट भरही?<verse eid="JOB 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 15:3" />का ओमन बेकार के गोठ ले बहस करहीं</para>
  <para style="q2" vid="JOB 15:3">या बेमतलब के बात संग बहस करहीं?<verse eid="JOB 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 15:4" />पर तेंह परमेसर के आदर ला कम करथस</para>
  <para style="q2" vid="JOB 15:4">अऊ परमेसर के भक्ति म बाधा डालथस।<verse eid="JOB 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 15:5" />तोर पाप ह तोर मुहूं ला गोठियाय बर उकसावत हे;</para>
  <para style="q2" vid="JOB 15:5">तेंह चतुरामन के भासा म बातचीत करथस।<verse eid="JOB 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 15:6" />मेंह नइं, पर तोर खुद के मुहूं के गोठ ह तोला दोसी ठहिरात हे;</para>
  <para style="q2" vid="JOB 15:6">तोर खुद के जीभ ह तोर बिरोध म गवाही देवत हे।<verse eid="JOB 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 15:7" />“का जम्मो मनखे म सबले पहिली तेंह जनमे?</para>
  <para style="q2" vid="JOB 15:7">का परबतमन ले पहिली तोला बनाय गीस?<verse eid="JOB 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 15:8" />का तें परमेसर के सभा म बईठके सुनथस?</para>
  <para style="q2" vid="JOB 15:8">का सिरिप तोरेच करा बुद्धि हवय?<verse eid="JOB 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 15:9" />तेंह अइसे का जानथस, जऊन ला हमन नइं जानन?</para>
  <para style="q2" vid="JOB 15:9">तोर म अइसे कोन समझ के बात हवय, जऊन ह हमन म नइं ए?<verse eid="JOB 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 15:10" />पाके चुंदीवाला अऊ सियानमन हमर तरफ हवंय,</para>
  <para style="q2" vid="JOB 15:10">अऊ त अऊ तोर ददा ले घलो जादा उमर के मनखेमन।<verse eid="JOB 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 15:11" />का परमेसर के ढाढ़स देवई,</para>
  <para style="q2" vid="JOB 15:11">अऊ कहे गे कोमल बचन तोर बर परयाप्त नो हंय?<verse eid="JOB 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 15:12" />तोर मन ह तोला काबर आने कोति लेगत हे,</para>
  <para style="q2" vid="JOB 15:12">अऊ रिस म तोर आंखीमन काबर चमकत हवंय,<verse eid="JOB 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 15:13" />कि तेंह अपन गुस्सा ला परमेसर के बिरोध म परगट कर</para>
  <para style="q2" vid="JOB 15:13">अऊ अपन मुहूं ले अइसने बचन निकलन देय?<verse eid="JOB 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOB 15:14" />“मरनहार मनखे ह का अय कि ओह सुध हो सकय</para>
  <para style="q2" vid="JOB 15:14">या माईलोगन ले जनमे मनखेमन कोन अंय कि ओमन धरमी हो सकंय?<verse eid="JOB 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 15:15" />यदि परमेसर ह अपन पबितर मनखेमन ऊपर भरोसा नइं करय,</para>
  <para style="q2" vid="JOB 15:15">अऊ यदि स्वरगमन घलो ओकर नजर म सुध नइं अंय,<verse eid="JOB 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 15:16" />त फेर मरनहार मनखेमन के का हिसाब, जऊन मन दुस्ट अऊ भ्रस्ट अंय,</para>
  <para style="q2" vid="JOB 15:16">अऊ अधरम के काम करे बर पीयासन रहिथें!<verse eid="JOB 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JOB 15:17" />“मोर बात ला सुन अऊ मेंह तोला समझाहूं;</para>
  <para style="q2" vid="JOB 15:17">मेंह तोला बतात हंव कि मेंह का देखे हंव,<verse eid="JOB 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 15:18" />ओ बात जऊन ला बुद्धिमान मनखेमन अपन पुरखामन ले पाय रिहिन,</para>
  <para style="q2" vid="JOB 15:18">ओला बिगर छुपाय बताय हवंय,<verse eid="JOB 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 15:19" />(सिरिप पुरखामन ला देस दिये गे रिहिस</para>
  <para style="q2" vid="JOB 15:19">जब कोनो परदेसी के ओमन के बीच म आना-जाना नइं रिहिस):<verse eid="JOB 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 15:20" />दुस्ट मनखे ह अपन जिनगी भर पीरा सहथे,</para>
  <para style="q2" vid="JOB 15:20">अऊ निरदयी मनखे बर येह ओकर जिनगी भर बने रहिथे।<verse eid="JOB 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 15:21" />भयभीत करइया अवाज ओकर कान म गूंजत रहिथे;</para>
  <para style="q2" vid="JOB 15:21">जब सब सही जान पड़थे, तभे बिनास करइयामन ओकर ऊपर आ जाथें।<verse eid="JOB 15:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 15:22" />ओला अंधियार म ले बच निकले के बिसवास नइं रहय;</para>
  <para style="q2" vid="JOB 15:22">अऊ तलवार ले ओकर मारे जवई ह खचित ए।<verse eid="JOB 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 15:23" />ओह गिधवा के सहीं जेवन बर एती-ओती किंदरत रहिथे;</para>
  <para style="q2" vid="JOB 15:23">ओह जानथे कि अंधियार के दिन ह तीरेच म हवय।<verse eid="JOB 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 15:24" />पीरा अऊ बिपत्ति के भय ले ओह भरे रहिथे;</para>
  <para style="q2" vid="JOB 15:24">दुख-समस्या ले ओह बियाकुल रहिथे, जइसे कोनो राजा चढ़ई करे बर तियार हवय,<verse eid="JOB 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 15:25" />काबरकि ओह परमेसर के ऊपर मुक्का तानथे</para>
  <para style="q2" vid="JOB 15:25">अऊ सर्वसक्तिमान परमेसर के बिरोध म अपन डींग मारथे,<verse eid="JOB 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 15:26" />अऊ ओकर बिरोध म उतावला होके</para>
  <para style="q2" vid="JOB 15:26">एक मोटा अऊ मजबूत ढाल लेके ओकर ऊपर धावा बोलथे।<verse eid="JOB 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JOB 15:27" />“हालाकि ओकर चेहरा म चरबी बड़ गे हवय</para>
  <para style="q2" vid="JOB 15:27">अऊ ओकर कनिहां ह मांस भरे ले मोटा हो गे हवय,<verse eid="JOB 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 15:28" />पर ओह उजरे नगरमन म अऊ ओ घरमन म रहिही</para>
  <para style="q2" vid="JOB 15:28">जिहां कोनो नइं रहंय,</para>
  <para style="q2" vid="JOB 15:28">अऊ जिहां घर के दीवारमन कुटा-कुटा होके गिरथें।<verse eid="JOB 15:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 15:29" />ओह अऊ धनवान नइं रहिही अऊ ओकर धन बने नइं रहय,</para>
  <para style="q2" vid="JOB 15:29">ओकर धन ह देस म नइं फईलही।<verse eid="JOB 15:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 15:30" />ओह अंधियार ले नइं बांच पाही;</para>
  <para style="q2" vid="JOB 15:30">आगी के जुवाला ले ओकर पीकामन झुलस जाहीं,</para>
  <para style="q2" vid="JOB 15:30">अऊ परमेसर के मुहूं के सांस ले ओह दूरिहा छिटक जाही।<verse eid="JOB 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 15:31" />ओह बेकार के बातमन म भरोसा करके अपनआप ला धोखा झन देवय,</para>
  <para style="q2" vid="JOB 15:31">काबरकि ओकर बलदा म ओला कुछू नइं मिलय।<verse eid="JOB 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 15:32" />अपन समय के पहिली ओह मुरझा जाही,</para>
  <para style="q2" vid="JOB 15:32">अऊ ओकर डारामन नइं बड़हीं।<verse eid="JOB 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 15:33" />ओह ओ अंगूर के नार सहीं होही जेकर कइंचा अंगूरमन झरके गिर जाथें,</para>
  <para style="q2" vid="JOB 15:33">या ओह ओ जैतून रूख सहीं होही जेकर फूलमन झरके गिरत हवंय।<verse eid="JOB 15:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 15:34" />काबरकि भक्तिहीन के संगति म रहइया बिगर फर के होही,</para>
  <para style="q2" vid="JOB 15:34">अऊ घूसखोरमन के डेरामन ला आगी ह भसम कर दीही।<verse eid="JOB 15:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 15:35" />ओमन समस्या खड़े करे के योजना बनाथें अऊ दुस्ट काम करथें;</para>
  <para style="q2" vid="JOB 15:35">ओमन के मन म धोखाधड़ी के बिचार रहिथे।”<verse eid="JOB 15:35" /></para>
  <chapter eid="JOB 15" />
  <chapter number="16" style="c" sid="JOB 16" />
  <para style="s1">अयूब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 16:1" />तब अयूब ह जबाब दीस:<verse eid="JOB 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 16:2" />“मेंह ये किसम के बहुंत गोठ सुन चुके हंव;</para>
  <para style="q2" vid="JOB 16:2">तुमन जम्मो के जम्मो दयनीय तसल्ली देवइया अव।<verse eid="JOB 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 16:3" />का तुम्हर बेकार के लम्बा भासन कभू खतम नइं होवय?</para>
  <para style="q2" vid="JOB 16:3">तुमन ला का तकलीफ हे कि तुमन बहस करतेच हव?<verse eid="JOB 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 16:4" />मेंह घलो तुम्हर सहीं गोठियातेंव,</para>
  <para style="q2" vid="JOB 16:4">कहूं तुमन मोर जगह म होतेव त;</para>
  <para style="q1" vid="JOB 16:4">मेंह तुम्हर बिरोध म सुघर भासन देतेंव</para>
  <para style="q2" vid="JOB 16:4">अऊ मुड़ डोलातेंव।<verse eid="JOB 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 16:5" />पर मोर बचन ह तुमन ला उत्साहित करतिस;</para>
  <para style="q2" vid="JOB 16:5">अऊ तसल्ली देवइया मोर गोठ ह तुम्हर दुख ला कम करतिस।<verse eid="JOB 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOB 16:6" />“कहूं मेंह गोठियावंव, तभो ले मोर पीरा ह कम नइं होवय;</para>
  <para style="q2" vid="JOB 16:6">अऊ चाहे मेंह चुप रहंव, तभो ले ये पीरा ह मोर ले दूरिहा नइं होवय।<verse eid="JOB 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 16:7" />सही म, हे परमेसर, तेंह मोला थको दे हस;</para>
  <para style="q2" vid="JOB 16:7">तेंह मोर जम्मो परिवार ला उजाड़ दे हस।<verse eid="JOB 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 16:8" />तेंह मोला सूखा डारे हस—अऊ येह एक गवाह बन गे हवय;</para>
  <para style="q2" vid="JOB 16:8">मोर दुबलापन ह बाढ़त हे अऊ मोर बिरोध म उठके गवाही देवत हे।<verse eid="JOB 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 16:9" />परमेसर ह मोर ऊपर वार करथे अऊ अपन रिस म मोला चीर डारथे</para>
  <para style="q2" vid="JOB 16:9">अऊ मोर बर अपन दांत किटकिटाथे;</para>
  <para style="q2" vid="JOB 16:9">मोर बईरी ह मोला हीनता के आंखी देखावत हे।<verse eid="JOB 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 16:10" />मनखेमन मोला ताना मारथें;</para>
  <para style="q2" vid="JOB 16:10">ओमन तिरस्कार म मोर गाल म थपरा मारथें</para>
  <para style="q2" vid="JOB 16:10">अऊ मोर बिरोध म एक जुट होवथें।<verse eid="JOB 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 16:11" />परमेसर ह मोला भक्तिहीन मनखेमन के बस म कर दे हवय</para>
  <para style="q2" vid="JOB 16:11">अऊ मोला दुस्टमन के हांथ म सऊंप दे हवय।<verse eid="JOB 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 16:12" />मोर संग सब ठीक रिहिस, पर ओह मोला चकनाचूर कर दीस;</para>
  <para style="q2" vid="JOB 16:12">ओह मोर घेंच ला धरके मोला कुचर डारे हवय।</para>
  <para style="q1" vid="JOB 16:12">ओह मोला अपन निसाना बनाय हवय;<verse eid="JOB 16:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="JOB 16:13" />ओकर धनुसधारीमन मोला चारों कोति ले घेरे हवंय।</para>
  <para style="q1" vid="JOB 16:13">ओह निरदयी होके मोर गुरदामन ला बेधथे</para>
  <para style="q2" vid="JOB 16:13">अऊ मोर पित्त ला भुइयां म बोहा देथे।<verse eid="JOB 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 16:14" />बार-बार ओकर गुस्सा ह मोर ऊपर फूटथे;</para>
  <para style="q2" vid="JOB 16:14">ओह सूरबीर सहीं मोर ऊपर झपटत हवय।<verse eid="JOB 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOB 16:15" />“मेंह दुख के सेति अपन खाल ऊपर बोरा ला सील ले हवंव</para>
  <para style="q2" vid="JOB 16:15">अऊ अपन बल ला धुर्रा म गड़िया दे हवंव।<verse eid="JOB 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 16:16" />रो-रोके मोर चेहरा ह लाल हो गे हवय,</para>
  <para style="q2" vid="JOB 16:16">अऊ मोर आंखी के पलकमन के तरी ह करिया गे हवय;<verse eid="JOB 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 16:17" />तभो ले मेंह कोनो हिंसा के काम नइं करे हवंव</para>
  <para style="q2" vid="JOB 16:17">अऊ मोर पराथना ह पबितर अय।<verse eid="JOB 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOB 16:18" />“हे धरती! मोर लहू ला झन ढांप;</para>
  <para style="q2" vid="JOB 16:18">मोर दुहाई ह कभू झन रूकय।<verse eid="JOB 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 16:19" />अभी घलो स्वरग म मोर गवाह हवय;</para>
  <para style="q2" vid="JOB 16:19">मोर वकील ह ऊपर म हवय।<verse eid="JOB 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 16:20" />मोर संगीमन मोर निन्दा करइया अंय;</para>
  <para style="q2" vid="JOB 16:20">अऊ मोर आंखी ह परमेसर के आघू म आंसू बोहावत हवय;<verse eid="JOB 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 16:21" />एक मनखे कोति ले ओह परमेसर ले बिनती करथे</para>
  <para style="q2" vid="JOB 16:21">जइसे कोनो अपन संगी बर बिनती करथे।<verse eid="JOB 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JOB 16:22" />“सिरिप थोरकून बछर बीते के बाद</para>
  <para style="q2" vid="JOB 16:22">मेंह ओ रद्दा म चले जाहूं, जिहां ले कोनो लहुंटके नइं आवंय।<verse eid="JOB 16:22" /></para>
  <chapter eid="JOB 16" />
  <chapter number="17" style="c" sid="JOB 17" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 17:1" />मोर मन ह टूट गे हवय,</para>
  <para style="q2" vid="JOB 17:1">मोर जीये के दिनमन ला कम कर दिये गे हवय,</para>
  <para style="q2" vid="JOB 17:1">कबर ह मोला अगोरत हे।<verse eid="JOB 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 17:2" />खचित ठट्ठा करइयामन मोर चारों कोति हवंय;</para>
  <para style="q2" vid="JOB 17:2">मोर आंखीमन ओमन के बईरता ला देखत हवंय।<verse eid="JOB 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JOB 17:3" />“हे परमेसर, मोला छोंड़ाय बर जमानत दे।</para>
  <para style="q2" vid="JOB 17:3">अऊ कोन हवय, जऊन ह मोर बर ठाढ़ होही?<verse eid="JOB 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 17:4" />तेंह ओमन के समझ के सक्ति ला बंद कर दे हवस;</para>
  <para style="q2" vid="JOB 17:4">एकरसेति तेंह ओमन ला जीते बर नइं देवस।<verse eid="JOB 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 17:5" />कहूं कोनो अपन लाभ बर अपन संगीमन के चारी-चुगली करथे,</para>
  <para style="q2" vid="JOB 17:5">त ओकर लइकामन के आंखीमन फूट जाहीं।<verse eid="JOB 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOB 17:6" />“परमेसर ह मोला जम्मो झन बर एक कहावत बना दे हवय,</para>
  <para style="q2" vid="JOB 17:6">अऊ मेंह अइसे मनखे हो गे हवंव, जेकर चेहरा म मनखेमन थूकथें।<verse eid="JOB 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 17:7" />मोर आंखीमन दुख के कारन धुंधला गे हवंय;</para>
  <para style="q2" vid="JOB 17:7">मोर जम्मो देहें ह छइहां कस कमजोर हो गे हवय।<verse eid="JOB 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 17:8" />सीधवा मनखेमन येला देखके अचम्भो करथें;</para>
  <para style="q2" vid="JOB 17:8">अऊ निरदोस मनखेमन भक्तिहीन मनखेमन के बिरोध म भड़कथें।<verse eid="JOB 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 17:9" />तभो ले, धरमीमन अपन रद्दा ला धरे रहिहीं,</para>
  <para style="q2" vid="JOB 17:9">अऊ सुध काम करइया मनखेमन मजबूत होवत जाहीं।<verse eid="JOB 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOB 17:10" />“पर आवव, तुमन जम्मो झन, फेर कोसिस करव!</para>
  <para style="q2" vid="JOB 17:10">पर तुम्हर बीच म, मेंह एको झन ला बुद्धिमान नइं पाहूं।<verse eid="JOB 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 17:11" />मोर जीये के दिनमन तो बीत गीन, मोर योजनामन छितिर-बितिर हो गे हवंय।</para>
  <para style="q2" vid="JOB 17:11">मोर हिरदय के ईछामन चले गे हवंय<verse eid="JOB 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 17:12" />ओमन रथिया ला दिन म बदल देथें;<note caller="+" style="f"><char style="fr" closed="false">17:12 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सच ला झूठ म बदल देथें</char></note></para>
  <para style="q2" vid="JOB 17:12">अंजोर ह अंधियार के लकठा म हवय।<verse eid="JOB 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 17:13" />कहूं मेंह कोनो घर के आसा करंव, त ओह सिरिप कबर अय,</para>
  <para style="q2" vid="JOB 17:13">कहूं मेंह अंधियार के जगह म अपन बिस्तर ला बिछावंव,<verse eid="JOB 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 17:14" />कहूं मेंह भ्रस्ट काम ला कहंव, ‘तें मोर ददा अस,’</para>
  <para style="q2" vid="JOB 17:14">अऊ कीरा ला कहंव, ‘तें मोर दाई अस’ या ‘मोर बहिनी अस,’<verse eid="JOB 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 17:15" />त फेर मोर आसा कहां हवय—</para>
  <para style="q2" vid="JOB 17:15">कोन ह मोर आसा ला देख सकथे?<verse eid="JOB 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 17:16" />का मोर आसा ह मिरतू के कपाट करा खाल्हे चल दीही?</para>
  <para style="q2" vid="JOB 17:16">का हमन खाल्हे जाके एके संग धुर्रा म मिल जाबो?”<verse eid="JOB 17:16" /></para>
  <chapter eid="JOB 17" />
  <chapter number="18" style="c" sid="JOB 18" />
  <para style="s1">बिलदद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 18:1" />तब सूही के रहइया बिलदद ह जबाब दीस:<verse eid="JOB 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 18:2" />“तेंह कब ये भासन ला खतम करबे?</para>
  <para style="q2" vid="JOB 18:2">समझदार बन, अऊ तभे हमन गोठियाय सकथन।<verse eid="JOB 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 18:3" />हमन काबर पसु सहीं समझे जावत हन</para>
  <para style="q2" vid="JOB 18:3">अऊ तोर नजर म मुरूख ठहिरे हन?<verse eid="JOB 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 18:4" />तें जऊन ह अपन रिस म अपनआप ला कुटा-कुटा करत हस,</para>
  <para style="q2" vid="JOB 18:4">का तोर कारन धरती ला तियाग दिये जावय?</para>
  <para style="q2" vid="JOB 18:4">या फेर चट्टानमन अपन जगह ले हट जावंय?<verse eid="JOB 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 18:5" />“दुस्ट मनखे के दीया ह बुता जाथे;</para>
  <para style="q2" vid="JOB 18:5">ओकर आगी के जुवाला निकलई ह बंद हो जाथे।<verse eid="JOB 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 18:6" />दुस्ट मनखे के डेरा म अंजोर ह अंधियार हो जाथे,</para>
  <para style="q2" vid="JOB 18:6">ओकर ऊपर म टांगे दीया ह बुता जाथे।<verse eid="JOB 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 18:7" />ओकर गोड़ के बल ह कमजोर हो जाथे;</para>
  <para style="q2" vid="JOB 18:7">ओकर खुद के युक्ति ह ओला ले बुड़थे।<verse eid="JOB 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 18:8" />ओकर पांव ह ओला जाल म फंसोथे;</para>
  <para style="q2" vid="JOB 18:8">ओह जाल म फंसके एती-ओती होथे।<verse eid="JOB 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 18:9" />फांदा ह ओकर एड़ी ला जकड़ लेथे;</para>
  <para style="q2" vid="JOB 18:9">जाल ह ओला कसके पकड़ लेथे।<verse eid="JOB 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 18:10" />भुइयां म ओकर बर एक फांदा छिपे हवय;</para>
  <para style="q2" vid="JOB 18:10">एक जाल ह ओकर रसता म हवय।<verse eid="JOB 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 18:11" />आतंक ह ओला जम्मो कोति ले चउंकाथे</para>
  <para style="q2" vid="JOB 18:11">अऊ ओला पकड़े बर ओकर हर कदम के पीछा करथे।<verse eid="JOB 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 18:12" />बिपत्ति ह ओकर बर भूखन हवय;</para>
  <para style="q2" vid="JOB 18:12">जब ओह गिरथे, त बिपत्ति ह ओकर बर तियार रहिथे।<verse eid="JOB 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 18:13" />येह ओकर चाम के भागमन ला खा जाथे;</para>
  <para style="q2" vid="JOB 18:13">मिरतू के रोग ह ओकर देहें के अंगमन ला खा लेथे।<verse eid="JOB 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 18:14" />ओह अपन डेरा के सुरकछा ले चीर डाले जाथे</para>
  <para style="q2" vid="JOB 18:14">अऊ आतंक के राजा करा लाने जाथे।<verse eid="JOB 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 18:15" />आगी ह ओकर डेरा म रहिथे;</para>
  <para style="q2" vid="JOB 18:15">बरत गंधक ला ओकर निवास म छितराय जाथे।<verse eid="JOB 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 18:16" />ओकर जरी ह खाल्हे ले सूखा जाथे</para>
  <para style="q2" vid="JOB 18:16">अऊ ऊपर म ओकर डारामन मुरझा जाथें।<verse eid="JOB 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 18:17" />धरती ले ओकर सुरता ह मिट जाथे;</para>
  <para style="q2" vid="JOB 18:17">देस म ओकर नांव नइं रहय।<verse eid="JOB 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 18:18" />ओला अंजोर ले अंधियार के जगह म भगाय जाथे</para>
  <para style="q2" vid="JOB 18:18">अऊ ओला संसार ले हटा दिये जाथे।<verse eid="JOB 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 18:19" />अपन मनखेमन के बीच म, ओकर कोनो संतान नइं रहंय,</para>
  <para style="q2" vid="JOB 18:19">जिहां ओह रहत रिहिस, उहां ओकर कोनो नइं बचंय।<verse eid="JOB 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 18:20" />पछिम के मनखेमन ओकर दुरदसा ला देखके डराथें;</para>
  <para style="q2" vid="JOB 18:20">पूरब के मनखेमन ऊपर भयंकर भय छा जाथे।<verse eid="JOB 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 18:21" />खचित, दुस्ट मनखे के निवास ह अइसने ही होथे;</para>
  <para style="q2" vid="JOB 18:21">जऊन ह परमेसर ला नइं जानय, ओकर जगह ह अइसने होथे।”<verse eid="JOB 18:21" /></para>
  <chapter eid="JOB 18" />
  <chapter number="19" style="c" sid="JOB 19" />
  <para style="s1">अयूब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 19:1" />तब अयूब ह जबाब दीस:<verse eid="JOB 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 19:2" />“तुमन मोला कब तक दुख देवत रहिहू</para>
  <para style="q2" vid="JOB 19:2">अऊ ये गोठमन ले मोला कुचरत रहिहू?<verse eid="JOB 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 19:3" />दस बार अब तुमन मोर निन्दा कर चुके हव;</para>
  <para style="q2" vid="JOB 19:3">अऊ बिगर लाज-सरम के मोर बुरई करथव।<verse eid="JOB 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 19:4" />कहूं येह सच अय कि मेंह सही रसता ले भटक गे हवंव,</para>
  <para style="q2" vid="JOB 19:4">त फेर येह सिरिप मोर चिंता के बात ए।<verse eid="JOB 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 19:5" />कहूं तुमन सिरतों अपनआप ला मोर ले ऊपर करहू</para>
  <para style="q2" vid="JOB 19:5">अऊ मोर दुख ला मोर बिरोध म उपयोग करहू,<verse eid="JOB 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 19:6" />त येला जान लेवव कि परमेसर ह मोला गलत ठहिराय हवय</para>
  <para style="q2" vid="JOB 19:6">अऊ अपन जाल मोर चारों कोति बिछाय हवय।<verse eid="JOB 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 19:7" />“हालाकि मेंह चिचियाके कहिथंव, ‘उपदरव!’ पर मोला कोनो जबाब नइं मिलय;</para>
  <para style="q2" vid="JOB 19:7">हालाकि मेंह सहायता बर गोहार लगाथंव, पर कोनो नियाय नइं होवय।<verse eid="JOB 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 19:8" />परमेसर ह मोला रोके बर रद्दा ला रूंध देय हवय कि मेंह नाहकके झन जा सकंव;</para>
  <para style="q2" vid="JOB 19:8">ओह अंधियार म मोर रद्दा ला छुपा दे हवय।<verse eid="JOB 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 19:9" />ओह मोर आदरमान ला लेय ले हवय</para>
  <para style="q2" vid="JOB 19:9">अऊ मुकुट ला मोर मुड़ म ले हटा ले हवय।<verse eid="JOB 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 19:10" />ओह मोला चारों कोति ले चीर डारथे, जब तक कि मेंह खतम नइं हो जावंव;</para>
  <para style="q2" vid="JOB 19:10">ओह मोर आसा ला रूख के सहीं उखान देथे।<verse eid="JOB 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 19:11" />ओकर रिस ह मोर बिरोध म भड़कथे;</para>
  <para style="q2" vid="JOB 19:11">ओह मोला अपन एक बईरी समझथे।<verse eid="JOB 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 19:12" />ओकर सेनामन ताकत के संग आघू बढ़थें;</para>
  <para style="q2" vid="JOB 19:12">ओमन मोर बिरोध म घेरा बनाथें</para>
  <para style="q2" vid="JOB 19:12">अऊ मोर डेरा के चारों कोति डेरा डालथें।<verse eid="JOB 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 19:13" />“ओह मोर भाईमन ला मोर ले दूरिहा कर दे हवय;</para>
  <para style="q2" vid="JOB 19:13">मोर चिनहार मनखेमन मोर ले पूरा-पूरा अपन नाता टोर ले हवंय।<verse eid="JOB 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 19:14" />मोर रिस्तेदारमन मोला छोंड़ दे हवंय;</para>
  <para style="q2" vid="JOB 19:14">अऊ मोर सबले बने संगीमन मोला भुला गे हवंय।<verse eid="JOB 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 19:15" />मोर पहुना अऊ मोर दासीमन मोला परदेसी समझथें;</para>
  <para style="q2" vid="JOB 19:15">ओमन मोला एक अजनबी के सहीं देखथें।<verse eid="JOB 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 19:16" />मेंह अपन सेवक ला बलाथंव, पर ओह जबाब नइं देवय,</para>
  <para style="q2" vid="JOB 19:16">हालाकि मेंह ओकर ले बिनती करथंव।<verse eid="JOB 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 19:17" />मोर सांस ह मोर घरवाली ला बने नइं लगय;</para>
  <para style="q2" vid="JOB 19:17">मेंह अपन खुद के भाईमन बर घिनौना हो गे हवंव।<verse eid="JOB 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 19:18" />अऊ त अऊ नानकून लइकामन घलो मोर हंसी उड़ाथें;</para>
  <para style="q2" vid="JOB 19:18">जब मेंह उठके बाहिर निकलथंव, त ओमन मोर ठिठोली करथें।<verse eid="JOB 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 19:19" />मोर जम्मो नजदीकी संगी-साथीमन मोर ले घिन करथें;</para>
  <para style="q2" vid="JOB 19:19">जऊन मन ले मेंह मया करथंव, ओमन मोर बिरोध म हो गे हवंय।<verse eid="JOB 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 19:20" />मेंह सिरिप चमड़ी अऊ हाड़ा के छोंड़ अऊ कुछू नो हंव;</para>
  <para style="q2" vid="JOB 19:20">मेंह मरे ले लटपट बांचे हवंव।<verse eid="JOB 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOB 19:21" />“मोर ऊपर दया करव, हे मोर संगीमन, दया करव,</para>
  <para style="q2" vid="JOB 19:21">काबरकि परमेसर के कोप ह मोर ऊपर भड़के हवय।<verse eid="JOB 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 19:22" />तुमन परमेसर के सहीं काबर मोर पाछू पड़े हवव?</para>
  <para style="q2" vid="JOB 19:22">का मोला तड़फाय म तुमन ला कभू संतोस नइं होवय?<verse eid="JOB 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JOB 19:23" />“कास, मोर गोठमन ला लिखे जातिस,</para>
  <para style="q2" vid="JOB 19:23">कास, ओमन ला एक किताब म लिखे जातिस,<verse eid="JOB 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 19:24" />कास, ओमन सीसा म लोहा के कलम ले लिखे जातिन,</para>
  <para style="q2" vid="JOB 19:24">या हमेसा बर चट्टान के ऊपर खने जातिन!<verse eid="JOB 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 19:25" />मेंह जानत हंव कि मोला कैद ले छुड़इया ह जीयत हवय,</para>
  <para style="q2" vid="JOB 19:25">अऊ आखिर म ओह धरती ऊपर ठाढ़ होही।<verse eid="JOB 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 19:26" />अऊ मोर चमड़ी के नास हो जाय के पाछू घलो,</para>
  <para style="q2" vid="JOB 19:26">मेंह अपन मांस म होके परमेसर ला देखहूं;<verse eid="JOB 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 19:27" />मेंह खुद ओला देखहूं</para>
  <para style="q2" vid="JOB 19:27">अपन खुद के आंखी ले—मेंह देखहूं, आने अऊ कोनो नइं।</para>
  <para style="q2" vid="JOB 19:27">मोर हिरदय ह भीतरे-भीतर ओकर बहुंत कामना करत हवय।<verse eid="JOB 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="JOB 19:28" />“कहूं तुमन कहत हव, ‘हमन ओला कइसे सताबो,</para>
  <para style="q2" vid="JOB 19:28">जब समस्या के जरी ओकर ऊपर हवय,’<verse eid="JOB 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 19:29" />त तुमन ला खुद तलवार ले डरना चाही;</para>
  <para style="q2" vid="JOB 19:29">काबरकि कोरोध ह तलवार के दुवारा दंड लानही,</para>
  <para style="q2" vid="JOB 19:29">अऊ तब तुमन जानहू कि नियाय हवय।”<verse eid="JOB 19:29" /></para>
  <chapter eid="JOB 19" />
  <chapter number="20" style="c" sid="JOB 20" />
  <para style="s1">सोपर</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 20:1" />तब नामात के रहइया सोपर ह जबाब दीस:<verse eid="JOB 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 20:2" />“मोर बियाकुल बिचार ह मोला उकसावत हे कि मेंह जबाब दंव</para>
  <para style="q2" vid="JOB 20:2">काबरकि मेंह बहुंत असांत हंव।<verse eid="JOB 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 20:3" />मेंह एक डांट सुनेंव, जेकर ले मोर अपमान होथे,</para>
  <para style="q2" vid="JOB 20:3">अऊ मोर समझ ह जबाब देय बर मोला उकसावत हे।<verse eid="JOB 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 20:4" />“खचित तेंह जानत हस कि पुराना जमाना ले येह कइसे हवय,</para>
  <para style="q2" vid="JOB 20:4">याने जब ले धरती के ऊपर मनखे<note caller="+" style="f"><char style="fr" closed="false">20:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">आदम</char></note> के सिरिस्टी करे गीस,<verse eid="JOB 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 20:5" />दुस्टमन के खुसी ह थोरकून समय के अय,</para>
  <para style="q2" vid="JOB 20:5">अऊ भक्तिहीन मनखेमन के आनंद छिन भर के होथे।<verse eid="JOB 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 20:6" />हालाकि भक्तिहीन मनखे के घमंड ह अकास तक हबरथे</para>
  <para style="q2" vid="JOB 20:6">अऊ ओकर मुड़ ह बादरमन ला छूथे,<verse eid="JOB 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 20:7" />पर ओह अपन खुद के संडास सहीं सदाकाल बर नास हो जाही;</para>
  <para style="q2" vid="JOB 20:7">जऊन मन ओला देखे रिहिन, ओमन पुछहीं, ‘ओह कहां हवय?’<verse eid="JOB 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 20:8" />सपना कस ओह उड़ जाथे, अऊ फेर कभू नइं मिलय,</para>
  <para style="q2" vid="JOB 20:8">रात के एक दरसन कस ओह दूरिहा हो जाही।<verse eid="JOB 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 20:9" />जऊन आंखी ह ओला देखे रिहिस, ओह ओला फेर नइं देखही;</para>
  <para style="q2" vid="JOB 20:9">ओह अपन जगह म फेर नइं देखे जाही।<verse eid="JOB 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 20:10" />ओकर लइकामन गरीबमन ले दया के आसा करहीं;</para>
  <para style="q2" vid="JOB 20:10">ओकर खुद के हांथमन ओकर धन वापिस दीहीं।<verse eid="JOB 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 20:11" />जऊन जवानी के बल ह ओकर हाड़ामन म भरे रहिथे,</para>
  <para style="q2" vid="JOB 20:11">ओह ओकर संग धुर्रा म मिल जाही।<verse eid="JOB 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 20:12" />“हालाकि बुरई ह ओकर मुहूं म मीठ लगथे</para>
  <para style="q2" vid="JOB 20:12">अऊ ओह ओला अपन जीभ के तरी म लुकाके रखथे,<verse eid="JOB 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 20:13" />हालाकि ओह ओला छोंड़े बर नइं चाहय</para>
  <para style="q2" vid="JOB 20:13">अऊ ओला अपन मुहूं म रखे रहिथे,<verse eid="JOB 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 20:14" />तभो ले ओकर जेवन ह पेट म करू हो जाही;</para>
  <para style="q2" vid="JOB 20:14">येह ओकर भीतर म सांप के जहर हो जाही।<verse eid="JOB 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 20:15" />जऊन धन ला ओह लील ले रिहिस, ओह ओला निकाल दीही;</para>
  <para style="q2" vid="JOB 20:15">परमेसर ह ओला ओकर पेट म ले उल्टी करवा दीही।<verse eid="JOB 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 20:16" />ओह सांपमन के जहर ला चुहकही;</para>
  <para style="q2" vid="JOB 20:16">जहरिला सांप के दांतमन ओला मार डारहीं।<verse eid="JOB 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 20:17" />ओह ओ झरना अऊ नदियामन के आनंद नइं उठा सकही,</para>
  <para style="q2" vid="JOB 20:17">जेमा मंधरस अऊ दही के धार बोहावत हवय।<verse eid="JOB 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 20:18" />जेकर बर ओह कठोर मेहनत करिस, ओला बिगर खाय ओह वापिस करही;</para>
  <para style="q2" vid="JOB 20:18">ओह अपन धंधा ले मिले लाभ के आनंद नइं उठा सकही।<verse eid="JOB 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 20:19" />काबरकि ओह कंगालमन ऊपर अतियाचार करे हवय अऊ ओमन ला बेसहारा छोंड़ दे हवय;</para>
  <para style="q2" vid="JOB 20:19">ओह ओ घरमन ला हड़प ले हवय, जऊन ला ओह नइं बनाय रिहिस।<verse eid="JOB 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 20:20" />“खचित, ओकर लालसा के कभू अन्त नइं होवय;</para>
  <para style="q2" vid="JOB 20:20">ओह अपन धन के दुवारा अपनआप ला नइं बंचा सकय।<verse eid="JOB 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 20:21" />खाय बर ओकर लिये कुछू नइं बांचे हवय;</para>
  <para style="q2" vid="JOB 20:21">ओकर अमीरी ह बने नइं रहय।<verse eid="JOB 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 20:22" />ओकर धन अऊ सफलता के समय म ओला दुख ह घेर लीही;</para>
  <para style="q2" vid="JOB 20:22">दुरगति के जम्मो चीज ओकर ऊपर आ पड़ही।<verse eid="JOB 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 20:23" />जब ओह अपन पेट ला भर चुके होही,</para>
  <para style="q2" vid="JOB 20:23">तभे परमेसर ह अपन भारी रिस ला ओकर ऊपर देखाही</para>
  <para style="q2" vid="JOB 20:23">अऊ ओकर ऊपर दुख ही दुख लानही।<verse eid="JOB 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 20:24" />हालाकि ओह लोहा के हथियार ले बच निकलथे,</para>
  <para style="q2" vid="JOB 20:24">फेर कांस के बान ह ओला छेद डारथे।<verse eid="JOB 20:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 20:25" />ओह ये बान ला तीरके ओकर पीठ ले निकालथे,</para>
  <para style="q2" vid="JOB 20:25">चिकचिकावत छोर ह ओकर करेजा ले बाहिर निकलथे।</para>
  <para style="q1" vid="JOB 20:25">ओकर ऊपर आतंक छा जाही;<verse eid="JOB 20:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="JOB 20:26" />ओकर धन-संपत्ति बर घिटके अंधियार ह बाट जोहथे।</para>
  <para style="q1" vid="JOB 20:26">बिगर हवा के बरत आगी ह ओला भसम कर दीही</para>
  <para style="q2" vid="JOB 20:26">अऊ ओकर डेरा म बांचे चीजमन ला नास कर दीही।<verse eid="JOB 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 20:27" />अकास ह ओकर अपराध ला परगट करही;</para>
  <para style="q2" vid="JOB 20:27">धरती ह ओकर बिरोध म ठाढ़ होही।<verse eid="JOB 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 20:28" />पानी के बाढ़ ह ओकर घर ला बोहाके ले जाही,</para>
  <para style="q2" vid="JOB 20:28">परमेसर के रिस के दिन ओकर पूंजी ह बोहा जाही।<verse eid="JOB 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 20:29" />परमेसर ह दुस्ट मनखे के हालत अइसने करथे,</para>
  <para style="q2" vid="JOB 20:29">परमेसर कोति ले ओमन बर ये किसम के उत्तराधिकार ठहिराय गे हवय।”<verse eid="JOB 20:29" /></para>
  <chapter eid="JOB 20" />
  <chapter number="21" style="c" sid="JOB 21" />
  <para style="s1">अयूब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 21:1" />तब अयूब ह जबाब दीस:<verse eid="JOB 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 21:2" />“मोर गोठ ला धियान देके सुनव;</para>
  <para style="q2" vid="JOB 21:2">ये किसम ले तुमन मोला सांतवना दे सकत हव।<verse eid="JOB 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 21:3" />मोर गोठ के पूरा होवत ले धीरज धरव,</para>
  <para style="q2" vid="JOB 21:3">अऊ जब मेंह गोठिया लेवंव, त फेर मोर हंसी उड़ावव।<verse eid="JOB 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 21:4" />“का मोर सिकायत कोनो मनखे ले हवय?</para>
  <para style="q2" vid="JOB 21:4">फेर मेंह अधीर काबर नइं होवंव?<verse eid="JOB 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 21:5" />मोला देखव अऊ अचम्भो करव;</para>
  <para style="q2" vid="JOB 21:5">अपन मुहूं ला अपन हांथ ले छबकव।<verse eid="JOB 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 21:6" />जब में येकर बारे म सोचथंव, त मोर म भय छा जाथे;</para>
  <para style="q2" vid="JOB 21:6">मोर देहें ह थर-थर कांपे लगथे।<verse eid="JOB 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 21:7" />दुस्ट मनखेमन काबर जीयत रहिथें,</para>
  <para style="q2" vid="JOB 21:7">जबकि डोकरा होवत ओमन के ताकत ह बढ़त जाथे?<verse eid="JOB 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 21:8" />ओमन अपन लइकामन ला अपन चारों कोति बसत देखथें,</para>
  <para style="q2" vid="JOB 21:8">अऊ ओमन अपन नाती-पोतामन ला अपन आंखी ले बढ़त देखथें।<verse eid="JOB 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 21:9" />ओमन के घर सुरकछित रहिथे अऊ उहां डर नइं रहय;</para>
  <para style="q2" vid="JOB 21:9">परमेसर के सजा के छड़ी ओमन ऊपर नइं परय।<verse eid="JOB 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 21:10" />ओमन के सांड़मन गाभिन करे म कभू नइं चुकंय;</para>
  <para style="q2" vid="JOB 21:10">ओमन के गायमन बछरू जनमथें अऊ गरभ ला नइं गिरावंय।<verse eid="JOB 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 21:11" />ओमन अपन लइकामन ला बरदी के रूप म भेजथें;</para>
  <para style="q2" vid="JOB 21:11">ओमन के छोटे लइकामन नाचथें।<verse eid="JOB 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 21:12" />ओमन खंजरी अऊ बीना के धुन म गाथें;</para>
  <para style="q2" vid="JOB 21:12">ओमन बंसी के धुन म खुसी मनाथें।<verse eid="JOB 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 21:13" />ओमन अपन जिनगी के दिन सम्पन्नता म बिताथें</para>
  <para style="q2" vid="JOB 21:13">अऊ सांति म मरथें।<verse eid="JOB 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 21:14" />तभो ले ओमन परमेसर ला कहिथें, ‘हमन ला अकेला छोंड़ दे!</para>
  <para style="q2" vid="JOB 21:14">हमन तोर रद्दा ला जाने के ईछा नइं रखन।<verse eid="JOB 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 21:15" />सर्वसक्तिमान कोन ए कि हमन ओकर सेवा करन?</para>
  <para style="q2" vid="JOB 21:15">ओकर ले पराथना करके हमन ला का मिलही?’<verse eid="JOB 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 21:16" />पर ओमन के सम्पन्नता ओमन के हांथ म नइं ए,</para>
  <para style="q2" vid="JOB 21:16">एकरसेति मेंह दुस्टमन के योजना ले दूरिहा रहिथंव।<verse eid="JOB 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JOB 21:17" />“तभो ले दुस्टमन के दीया ह कतेक बार बुताथे?</para>
  <para style="q2" vid="JOB 21:17">ओमन ऊपर कतेक बार बिपत्ति पड़थे,</para>
  <para style="q2" vid="JOB 21:17">परमेसर ह अपन रिस म ओमन ला दुख देथे?<verse eid="JOB 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 21:18" />ओमन कतेक बार हवा के आघू म भूंसा कस होथें,</para>
  <para style="q2" vid="JOB 21:18">गरेर के दुवारा उड़ियाय भूंसा कस होथें?<verse eid="JOB 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 21:19" />ये कहे जाथे, ‘परमेसर ह दुस्टमन के सजा ला ओमन के लइकामन बर कुढ़ोके रखथे।’</para>
  <para style="q2" vid="JOB 21:19">ओला दुस्टमन ले बदला लेवन दव, ताकि ओमन खुद अनुभव करंय!<verse eid="JOB 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 21:20" />ओमन अपनेच आंखी ले अपन बिनास ला देखंय;</para>
  <para style="q2" vid="JOB 21:20">ओमन सर्वसक्तिमान के कोरोध ला झेलंय।<verse eid="JOB 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 21:21" />काबरकि ओमन अपन बाद अपन परिवार के का फिकर करथें</para>
  <para style="q2" vid="JOB 21:21">जब ओमन ला दिये गय समय ह खतम हो जाथे?<verse eid="JOB 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JOB 21:22" />“का कोनो मनखे परमेसर ला गियान दे सकथे,</para>
  <para style="q2" vid="JOB 21:22">ये जानत कि ओह सबले बड़े पदवाला के घलो नियाय करथे?<verse eid="JOB 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 21:23" />एक मनखे अपन पूरा बल सहित मरथे,</para>
  <para style="q2" vid="JOB 21:23">पूरा सुरकछित अऊ अराम से,<verse eid="JOB 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 21:24" />अपन देहें ला पुस्ट करके,</para>
  <para style="q2" vid="JOB 21:24">अऊ हाड़ामन ला मजबूत करके।<verse eid="JOB 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 21:25" />आने मनखे ह अपन जीव के करूवाहट म मरथे,</para>
  <para style="q2" vid="JOB 21:25">ओह कभू कोनो बने चीज के आनंद नइं उठावय।<verse eid="JOB 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 21:26" />एक के बाजू म एक, ओमन धुर्रा म लेटे रहिथें,<note caller="+" style="f"><char style="fr" closed="false">21:26 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओमन एक समान मरथें अऊ ओमन ला माटी दिये जाथे</char></note></para>
  <para style="q2" vid="JOB 21:26">अऊ कीरामन ओ दूनों ला ढांक लेथें।<verse eid="JOB 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JOB 21:27" />“मेंह बने करके जानत हंव कि तुमन का सोचत हव,</para>
  <para style="q2" vid="JOB 21:27">ओ चलाकी, जेकर दुवारा तुमन मोला गलत ठहिराहू।<verse eid="JOB 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 21:28" />तुमन पुछथव, ‘अब ओ बड़े मनखे के घर कहां हवय,</para>
  <para style="q2" vid="JOB 21:28">ओ डेरामन जिहां दुस्ट मनखेमन निवास करिन?’<verse eid="JOB 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 21:29" />का कभू तुमन ओमन ले सवाल करेव, जऊन मन डहार रेंगथें?</para>
  <para style="q2" vid="JOB 21:29">का तुमन ओमन के लेखा-जोखा ला धियान नइं दे हवव—<verse eid="JOB 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 21:30" />कि दुस्टमन बिपत्ति के दिन ले बचाय जावत हें,</para>
  <para style="q2" vid="JOB 21:30">कि ओमन परलय के दिन ले छुटकारा पावत हें?<verse eid="JOB 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 21:31" />कोन ह ओमन के मुहूं के आघू म ओमन के चालचलन के बुरई करही?</para>
  <para style="q2" vid="JOB 21:31">ओमन जऊन काम करे हवंय, ओकर बदला कोन लीही?<verse eid="JOB 21:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 21:32" />ओमन ला कबर म अमराय जाथे,</para>
  <para style="q2" vid="JOB 21:32">अऊ ओमन के कबर के रखवारी करे जाथे।<verse eid="JOB 21:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 21:33" />घाटी के माटी ह ओमन ला गुरतूर लगथे;</para>
  <para style="q2" vid="JOB 21:33">हर एक जन ओमन के पाछू-पाछू जाथें,</para>
  <para style="q2" vid="JOB 21:33">अऊ अनगिनत मनखेमन ओमन के आघू-आघू जाथें।<verse eid="JOB 21:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JOB 21:34" />“एकरसेति तुमन अपन बेकार के बात ले मोला कइसे सांतवना दे सकत हव?</para>
  <para style="q2" vid="JOB 21:34">तुमन के जबाब म लबारी ही लबारी हवय!”<verse eid="JOB 21:34" /></para>
  <chapter eid="JOB 21" />
  <chapter number="22" style="c" sid="JOB 22" />
  <para style="s1">एलीपज</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 22:1" />तब तेमान के रहइया एलीपज ह जबाब दीस:<verse eid="JOB 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 22:2" />“का कोनो मनखे ले परमेसर ला फायदा हो सकथे?</para>
  <para style="q2" vid="JOB 22:2">अऊ त अऊ का कोनो बुद्धिमान मनखे ले ओला फायदा हो सकथे?<verse eid="JOB 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 22:3" />यदि तेंह धरमी होते, त एकर ले सर्वसक्तिमान ला का खुसी मिलतिस?</para>
  <para style="q2" vid="JOB 22:3">यदि तोर चालचलन ह निरदोस होतिस, त ओला का फायदा होतिस?<verse eid="JOB 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 22:4" />“का ओह तोर भक्ति के कारन तोला दबकारथे</para>
  <para style="q2" vid="JOB 22:4">अऊ तोर बिरोध म दोस लगाथे?<verse eid="JOB 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 22:5" />का तोर दुस्टता बहुंत नइं हो गे हवय?</para>
  <para style="q2" vid="JOB 22:5">का तोर पापमन के कोनो अन्त हवय?<verse eid="JOB 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 22:6" />तेंह बिगर कोनो कारन के अपन रिस्तेदारमन ले सुरकछा मांगय;</para>
  <para style="q2" vid="JOB 22:6">तेंह मनखेमन के ओनहा ला उतारके ओमन ला नंगरा छोंड़ दे हस।<verse eid="JOB 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 22:7" />तेंह थके-मांदे मनखे ला पानी नइं पीयाय</para>
  <para style="q2" vid="JOB 22:7">अऊ भूखा मनखे ला जेवन देय बर इनकार करय,<verse eid="JOB 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 22:8" />हालाकि तेंह एक सामर्थी मनखे रहय अऊ तोर करा जमीन-बारी रिहिस—</para>
  <para style="q2" vid="JOB 22:8">एक सम्मानित मनखे के रूप म येमा रहत रहय।<verse eid="JOB 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 22:9" />अऊ तेंह बिधवामन ला खाली हांथ लहुंटा देय</para>
  <para style="q2" vid="JOB 22:9">अऊ अनाथमन के बल ला टोर देय।<verse eid="JOB 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 22:10" />एकरसेति तोर चारों कोति फांदामन हवंय,</para>
  <para style="q2" vid="JOB 22:10">अऊ बिपत्ति ह अचानक तोला भयभीत करथे,<verse eid="JOB 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 22:11" />अऊ अइसे अंधियार हवय कि तेंह देख नइं सकस,</para>
  <para style="q2" vid="JOB 22:11">अऊ पानी के बाढ़ ह तोला बुड़ो देथे।<verse eid="JOB 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 22:12" />“का परमेसर ह स्वरग के ऊंचई म नइं ए?</para>
  <para style="q2" vid="JOB 22:12">अऊ ओह देखथे कि तारामन कतेक ऊंच म हवंय!<verse eid="JOB 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 22:13" />तभो ले तेंह कहिथस, ‘परमेसर ह का जानथे?</para>
  <para style="q2" vid="JOB 22:13">का ओह अइसने अंधियार म ले नियाय करथे?<verse eid="JOB 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 22:14" />बादरमन ओकर आघू म परदा डार देथें, जेकर ले ओह हमन ला नइं देखय</para>
  <para style="q2" vid="JOB 22:14">जब ओह अकास-मंडल म रेंगथे-बुलथे।’<verse eid="JOB 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 22:15" />का तेंह ओ जुन्ना डहार ला धरे रहिबे</para>
  <para style="q2" vid="JOB 22:15">जऊन म दुस्ट मनखेमन चलिन?<verse eid="JOB 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 22:16" />ओमन ला ओमन के समय ले पहिली उठा लिये गीस,<note caller="+" style="f"><char style="fr" closed="false">22:16 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">समय के पहिली मिरतू हो गीस</char></note></para>
  <para style="q2" vid="JOB 22:16">ओमन के नीवमन बाढ़ म बोहा गीन।<verse eid="JOB 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 22:17" />ओमन परमेसर ला कहिन, ‘हमन ला अकेला छोंड़ दे!</para>
  <para style="q2" vid="JOB 22:17">सर्वसक्तिमान हमर का कर सकथे?’<verse eid="JOB 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 22:18" />तभो ले ओही ह ओमन के घर ला बढ़िया चीजमन ले भर दीस,</para>
  <para style="q2" vid="JOB 22:18">एकरसेति मेंह ओ दुस्टमन के योजना ले दूरिहा रहिथंव।<verse eid="JOB 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 22:19" />धरमीमन ओमन के बिनास ला देखथें अऊ आनंद मनाथें;</para>
  <para style="q2" vid="JOB 22:19">निरदोस मनखेमन ओमन के ये कहिके हंसी उड़ाथें,<verse eid="JOB 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 22:20" />‘खचित, हमर बिरोधीमन नास होवथें</para>
  <para style="q2" vid="JOB 22:20">अऊ आगी ह ओमन के धन-संपत्ति ला भसम कर देथे।’<verse eid="JOB 22:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOB 22:21" />“अपनआप ला परमेसर ला दे अऊ ओकर संग सांति बनाय रख;</para>
  <para style="q2" vid="JOB 22:21">ये किसम ले सम्पन्नता तोर करा आही।<verse eid="JOB 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 22:22" />ओकर निरदेस ला मान</para>
  <para style="q2" vid="JOB 22:22">अऊ ओकर बात ला अपन हिरदय म रख।<verse eid="JOB 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 22:23" />कहूं तेंह सर्वसक्तिमान करा लहुंटके आबे, त तेंह पहिली के सहीं हो जाबे:</para>
  <para style="q2" vid="JOB 22:23">कहूं तेंह अपन डेरा ले दुस्टता के काम ला हटा देबे<verse eid="JOB 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 22:24" />अऊ अपन सोन, धुर्रा ला,</para>
  <para style="q2" vid="JOB 22:24">अऊ ओपीर<note caller="+" style="f"><char style="fr" closed="false">22:24 </char><char style="fq" closed="false">ओपीर </char><char style="ft" closed="false">एक जगह के नांव रिहिस, जिहां बने किसम के सोन मिलत रिहिस</char></note> के सोन ला घाटी के पथरामन ला दे देबे,<verse eid="JOB 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 22:25" />त सर्वसक्तिमान ह तोर बर सोन,</para>
  <para style="q2" vid="JOB 22:25">अऊ उत्तम चांदी होही।<verse eid="JOB 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 22:26" />खचित, तब तें सर्वसक्तिमान म खुसी पाबे</para>
  <para style="q2" vid="JOB 22:26">अऊ अपन चेहरा परमेसर कोति उठाबे।<verse eid="JOB 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 22:27" />तेंह ओकर ले पराथना करबे, अऊ ओह तोर सुनही,</para>
  <para style="q2" vid="JOB 22:27">अऊ तेंह अपन मन्नत ला पूरा करबे।<verse eid="JOB 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 22:28" />जऊन कुछू करे बर तेंह ठान लेबे, ओह तोर बर पूरा हो जाही,</para>
  <para style="q2" vid="JOB 22:28">अऊ तोर डहार म अंजोर रहिही।<verse eid="JOB 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 22:29" />जब मनखेमन के बेजत्ती करे जाथे अऊ तेंह कहिथस, ‘ओमन के आदर करव!’</para>
  <para style="q2" vid="JOB 22:29">तब ओह दीन-हीन मनखेमन ला बचाही।<verse eid="JOB 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 22:30" />अऊ त अऊ जऊन ह निरदोस नो हय, ओह ओला घलो छोंड़ाही,</para>
  <para style="q2" vid="JOB 22:30">ओला ओह तोर हांथ के सुध काम के जरिये छोंड़ाही।”<verse eid="JOB 22:30" /></para>
  <chapter eid="JOB 22" />
  <chapter number="23" style="c" sid="JOB 23" />
  <para style="s1">अयूब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 23:1" />तब अयूब ह जबाब दीस:<verse eid="JOB 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 23:2" />“आज घलो मोर सिकायत ह करू अय;</para>
  <para style="q2" vid="JOB 23:2">मोर कलहरई के बावजूद ओकर हांथ ह मोर ऊपर भारी हवय।<verse eid="JOB 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 23:3" />कहूं मेंह सिरिप ये जानतेंव कि ओह कहां मिलही;</para>
  <para style="q2" vid="JOB 23:3">कहूं मेंह सिरिप ओकर निवास करा जा सकतेंव!<verse eid="JOB 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 23:4" />मेंह अपन मामला ओकर आघू म रखतेंव</para>
  <para style="q2" vid="JOB 23:4">अऊ बहुंत बहस करतेंव।<verse eid="JOB 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 23:5" />मेंह पता लगातेंव कि ओह मोला का जबाब देतिस,</para>
  <para style="q2" vid="JOB 23:5">अऊ जऊन कुछू ओह मोर ले कहितिस, ओकर ऊपर बिचार करतेंव।<verse eid="JOB 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 23:6" />का ओह अपन पूरा बल ले मोर संग बहस करही?</para>
  <para style="q2" vid="JOB 23:6">नइं, ओह मोर बिरोध म दोस नइं लगाही।<verse eid="JOB 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 23:7" />उहां ईमानदार मनखे ह ओकर आघू म अपन निरदोस होय के बात ला साबित कर सकथे,</para>
  <para style="q2" vid="JOB 23:7">अऊ उहां मेंह अपन नियाय करइया ले हमेसा बर छुटकारा पा लेतेंव।<verse eid="JOB 23:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 23:8" />“पर कहूं मेंह पूरब दिग म जावंव, त ओह उहां नइं ए;</para>
  <para style="q2" vid="JOB 23:8">कहूं मेंह पछिम दिग म जावंव, त ओह मोला नइं मिलय।<verse eid="JOB 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 23:9" />जब ओह उत्तर दिग म काम करत रहिथे, त मेंह ओला नइं देखंव;</para>
  <para style="q2" vid="JOB 23:9">जब ओह दक्खिन कोति मुड़थे, त मेंह ओकर झलक घलो नइं देख पावंव।<verse eid="JOB 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 23:10" />पर ओह जानथे कि मेंह कते रद्दा म जावत हंव;</para>
  <para style="q2" vid="JOB 23:10">जब ओह मोला परखही, त मेंह सोन कस निकलहूं।<verse eid="JOB 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 23:11" />मेंह बहुंत नजदीकी ले ओकर पाछू म चले हंव;</para>
  <para style="q2" vid="JOB 23:11">मेंह बिगर एती-ओती जाय ओकर रद्दा ला धरे हंव।<verse eid="JOB 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 23:12" />मेंह ओकर दिये मुहूं के हुकूम ले नइं हटे हंव;</para>
  <para style="q2" vid="JOB 23:12">मेंह ओकर मुहूं के गोठमन ला अपन रोज के जेवन ले घलो जादा अनमोल जानत हंव।<verse eid="JOB 23:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 23:13" />“पर ओह अपन बात म अडिग रहिथे, अऊ कोन ह ओकर बिरोध कर सकथे?</para>
  <para style="q2" vid="JOB 23:13">जऊन बात ओला बने लगथे, ओही ला ओह करथे।<verse eid="JOB 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 23:14" />ओह मोर बिरोध म अपन फैसला लेथे,</para>
  <para style="q2" vid="JOB 23:14">अऊ अइसने कतको योजना ओकर करा माढ़े हवय।<verse eid="JOB 23:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 23:15" />येकरे कारन मेंह ओकर आघू म भयभीत हंव;</para>
  <para style="q2" vid="JOB 23:15">जब में ये जम्मो के बारे म सोचथंव, त मेंह ओकर ले डरथंव।<verse eid="JOB 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 23:16" />परमेसर ह मोर मन ला हतास कर दे हवय;</para>
  <para style="q2" vid="JOB 23:16">सर्वसक्तिमान ह मोला भयभीत कर दे हवय।<verse eid="JOB 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 23:17" />तभो ले मेंह अंधियार के कारन चुप नइं अंव,</para>
  <para style="q2" vid="JOB 23:17">ओ गहिरा अंधियार जऊन ह मोर चेहरा ऊपर छाय हवय।<verse eid="JOB 23:17" /></para>
  <para style="b" />
  <chapter eid="JOB 23" />
  <chapter number="24" style="c" sid="JOB 24" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 24:1" />“सर्वसक्तिमान परमेसर ह नियाय के समय ला काबर नइं ठहिरात हे?</para>
  <para style="q2" vid="JOB 24:1">जऊन मन ओला जानथें, ओमन काबर बेकार म अइसने दिन बर अगोरंय?<verse eid="JOB 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 24:2" />कुछू मनखेमन भुइयां के सिवाना ला बढ़ा देथें;</para>
  <para style="q2" vid="JOB 24:2">ओमन चोराय भेड़मन के झुंड ला चराथें।<verse eid="JOB 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 24:3" />ओमन अनाथमन के गदहा ला खेदके ले जाथें</para>
  <para style="q2" vid="JOB 24:3">अऊ बिधवा के बईला ला गिरवी म रखथें।<verse eid="JOB 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 24:4" />ओमन जरूरतमंद मनखे ला रद्दा ले ढकेल देथें</para>
  <para style="q2" vid="JOB 24:4">अऊ देस के जम्मो गरीबमन ला छुपे बर बिबस कर देथें।<verse eid="JOB 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 24:5" />सुन्ना जगह म जंगली गदहामन कस,</para>
  <para style="q2" vid="JOB 24:5">गरीबमन जेवन के खोज म भटकत रहिथें;</para>
  <para style="q2" vid="JOB 24:5">सुन्ना जगह ले ओमन के लइकामन ला जेवन मिलथे।<verse eid="JOB 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 24:6" />ओमन खेत म फसल संकेलथें</para>
  <para style="q2" vid="JOB 24:6">अऊ दुस्टमन के अंगूर के बारी म सीला बिनथें।<verse eid="JOB 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 24:7" />ओमन बिगर ओनहा के नंगरा रथिया बिताथें;</para>
  <para style="q2" vid="JOB 24:7">जाड़ म ओढ़े बर ओमन करा कुछू नइं रहय।<verse eid="JOB 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 24:8" />ओमन परबत के बरसा ले भीग जाथें</para>
  <para style="q2" vid="JOB 24:8">अऊ सरन लेय के जगह नइं मिले के कारन ओमन चट्टान म सरन लेथें।<verse eid="JOB 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 24:9" />अनाथ लइका ला दूध पीयावत दाई के छाती ले छीन लेथें;</para>
  <para style="q2" vid="JOB 24:9">गरीब के नानकून लइका ला लागा बर धर लिये जाथे।<verse eid="JOB 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 24:10" />ओनहा के कमी के कारन, ओमन नंगरा रहिथें;</para>
  <para style="q2" vid="JOB 24:10">ओमन अनाज के करपा ला तो ले जाथें, तभो ले भूखन रहिथें।<verse eid="JOB 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 24:11" />ओमन चबूतरामन<note caller="+" style="f"><char style="fr" closed="false">24:11 </char><char style="ft" closed="false">इबरानी म ये सबद के मतलब साफ नइं ए</char></note> म जैतून तेल पेरथें;</para>
  <para style="q2" vid="JOB 24:11">ओमन अंगूर के रसकुंडमन म अंगूर ला खुंदथें, तभो ले पीयासन रहिथें।<verse eid="JOB 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 24:12" />सहर ले मरइयामन के कलहरई ह सुनई देथे,</para>
  <para style="q2" vid="JOB 24:12">अऊ घायलमन के आतमा ह मदद बर पुकारथे।</para>
  <para style="q2" vid="JOB 24:12">पर परमेसर ह कोनो ला गलती के दोस नइं देवय।<verse eid="JOB 24:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 24:13" />“अइसने मनखे हवंय, जऊन मन अंजोर के बिरोध म बिदरोह करथें,</para>
  <para style="q2" vid="JOB 24:13">ओमन येकर रद्दा ला नइं जानंय,</para>
  <para style="q2" vid="JOB 24:13">या येकर रद्दा म नइं रूकंय।<verse eid="JOB 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 24:14" />जब दिन के अंजोर ह चले जाथे, त हतियारा ह ठाढ़ होथे,</para>
  <para style="q2" vid="JOB 24:14">अऊ गरीब अऊ जरूरतमंद ला मार डारथे,</para>
  <para style="q2" vid="JOB 24:14">अऊ रथिया ओह चोर कस चोरी करथे।<verse eid="JOB 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 24:15" />बेभिचार करइया के आंखी ह संझाती के डहार देखथे;</para>
  <para style="q2" vid="JOB 24:15">ओह सोचथे, ‘मोला कोनो नइं देखहीं,’</para>
  <para style="q2" vid="JOB 24:15">अऊ ओह अपन चेहरा ला छुपाके रखथे।<verse eid="JOB 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 24:16" />अंधियार म चोरमन घर म सेंध लगाथें,</para>
  <para style="q2" vid="JOB 24:16">पर दिन म अपनआप ला लुकाय रखथें;</para>
  <para style="q2" vid="JOB 24:16">अंजोर म ओमन कुछू करे बर नइं चाहंय।<verse eid="JOB 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 24:17" />ओ जम्मो बर, आधा रथिया ह ओमन के बिहनियां ए;</para>
  <para style="q2" vid="JOB 24:17">ओमन अंधियार के आतंक ला संगी बनाथें।<verse eid="JOB 24:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOB 24:18" />“तभो ले ओमन पानी के ऊपर झाग सहीं अंय;</para>
  <para style="q2" vid="JOB 24:18">ओमन के बांटा के भुइयां ह सरापित ए,</para>
  <para style="q2" vid="JOB 24:18">जेकर ले अंगूर के बारीमन म कोनो नइं जावंय।<verse eid="JOB 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 24:19" />जइसे कि गरमी अऊ सूखा ह पिघलत बरफ के पानी ला ले जाथे,</para>
  <para style="q2" vid="JOB 24:19">वइसनेच ही कबर ह ओमन ला ले जाथे जऊन मन पाप करे हवंय।<verse eid="JOB 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 24:20" />दाई ह ओमन ला भुला जाथे,</para>
  <para style="q2" vid="JOB 24:20">कीरामन ओमन ला मजा लेके खाथें;</para>
  <para style="q1" vid="JOB 24:20">दुस्टमन ला कोनो सुरता नइं करंय</para>
  <para style="q2" vid="JOB 24:20">पर ओमन ला रूख कस काट डारे जाथे।<verse eid="JOB 24:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 24:21" />ओमन ठड़गी अऊ बिगर लइका के माईलोगनमन ला लूटथें,</para>
  <para style="q2" vid="JOB 24:21">अऊ बिधवामन ऊपर कुछू दया नइं देखावंय।<verse eid="JOB 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 24:22" />पर परमेसर ह अपन सामर्थ ले सूरबीरमन ला घिल्लावत ले जाथे;</para>
  <para style="q2" vid="JOB 24:22">हालाकि ओमन स्थापित रहिथें, पर ओमन ला जिनगी के भरोसा नइं रहय।<verse eid="JOB 24:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 24:23" />परमेसर ह ओमन ला सुरकछा के अनुभव म अराम करा सकथे,</para>
  <para style="q2" vid="JOB 24:23">पर ओकर आंखी ह ओमन के रद्दा ऊपर लगे रहिथे।<verse eid="JOB 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 24:24" />ओमन थोरकून समय बर ऊपर उठाय जाथें, अऊ ओकर बाद ओमन के कुछू महत्व नइं रहय;</para>
  <para style="q2" vid="JOB 24:24">ओमन ला गिराय जाथे अऊ जम्मो आने मन कस संकेले जाथे;</para>
  <para style="q2" vid="JOB 24:24">ओमन ला अनाज के बालीमन कस काट डारे जाथे।<verse eid="JOB 24:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOB 24:25" />“कहूं येह अइसे नो हय, त कोन ह मोला गलत साबित कर सकथे</para>
  <para style="q2" vid="JOB 24:25">अऊ मोर गोठ ला बिना मतलब के ठहिरा सकथे?”<verse eid="JOB 24:25" /></para>
  <chapter eid="JOB 24" />
  <chapter number="25" style="c" sid="JOB 25" />
  <para style="s1">बिलदद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 25:1" />तब सूही के रहइया बिलदद ह जबाब दीस:<verse eid="JOB 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 25:2" />“परभूता अऊ भय के अधिकारी परमेसर ही अय;</para>
  <para style="q2" vid="JOB 25:2">ओह ऊंच स्वरग म सांति स्थापित करथे।<verse eid="JOB 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 25:3" />का ओकर सेनामन के गनती करे जा सकथे?</para>
  <para style="q2" vid="JOB 25:3">अइसे कोन हवय, जेकर ऊपर ओकर अंजोर नइं परय?<verse eid="JOB 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 25:4" />तब एक मरनहार मनखे ह परमेसर के आघू म कइसे धरमी हो सकथे?</para>
  <para style="q2" vid="JOB 25:4">माईलोगन ले जनमे मनखे ह कइसे सुध हो सकथे?<verse eid="JOB 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 25:5" />कहूं ओकर नजर म चंदा ह घलो उजला</para>
  <para style="q2" vid="JOB 25:5">अऊ तारामन घलो ओकर नजर म सुध नइं अंय,<verse eid="JOB 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 25:6" />त फेर मरनहार मनखे के का गनती, जऊन ह सिरिप एक गेंगरूआ अय—</para>
  <para style="q2" vid="JOB 25:6">एक मनखे, जऊन ह सिरिप एक कीरा अय!”<verse eid="JOB 25:6" /></para>
  <chapter eid="JOB 25" />
  <chapter number="26" style="c" sid="JOB 26" />
  <para style="s1">अयूब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 26:1" />तब अयूब ह जबाब दीस:<verse eid="JOB 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 26:2" />“तेंह कइसे निरबलमन के मदद करे हवस!</para>
  <para style="q2" vid="JOB 26:2">तेंह कइसे ओ मनखे ला संभाले हस, जऊन ह कमजोर हवय!<verse eid="JOB 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 26:3" />तेंह ओ मनखे ला का सलाह दे हवस, जेकर करा बुद्धि नइं ए!</para>
  <para style="q2" vid="JOB 26:3">अऊ तेंह का अंतर-गियान देखाय हवस!<verse eid="JOB 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 26:4" />कोन ह तोला ये गोठ कहे बर मदद करे हवय?</para>
  <para style="q2" vid="JOB 26:4">अऊ काकर आतमा ह तोर मुहूं ले गोठियाईस?<verse eid="JOB 26:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 26:5" />“मरे मनखेमन बहुंत पीरा म हवंय,</para>
  <para style="q2" vid="JOB 26:5">ओमन, जऊन मन पानी के खाल्हे अऊ ओ जम्मो, जऊन मन ओमा रहिथंय।<verse eid="JOB 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 26:6" />अधोलोक ह परमेसर के आघू म खुला हवय;</para>
  <para style="q2" vid="JOB 26:6">बिनास ह नइं तोपाय हवय।<verse eid="JOB 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 26:7" />ओह उत्तर दिग के अकासमन ला खाली जगह म बगराथे;</para>
  <para style="q2" vid="JOB 26:7">ओह धरती ला अधर म लटकाय हवय।<verse eid="JOB 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 26:8" />ओह बारिस के पानी ला अपन बादर म लपेटे हवय,</para>
  <para style="q2" vid="JOB 26:8">तभो ले बादरमन ओमन के बोझ म होके बरसंय नइं।<verse eid="JOB 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 26:9" />ओह पून्नी के चंदा ला ढांप देथे,</para>
  <para style="q2" vid="JOB 26:9">ओकर ऊपर अपन बादरमन ला बगराय के दुवारा।<verse eid="JOB 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 26:10" />अंजोर अऊ अंधियार के बीच म सिवाना बांधे बर</para>
  <para style="q2" vid="JOB 26:10">ओह समुंदर के सतह म छितिज ला ठहिराय हवय।<verse eid="JOB 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 26:11" />ओकर दबकारे ले</para>
  <para style="q2" vid="JOB 26:11">अकास के खंभामन डरके थर-थर कांपथें।<verse eid="JOB 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 26:12" />अपन सामर्थ ले ओह समुंदर ला सांत कर देथे;</para>
  <para style="q2" vid="JOB 26:12">अपन बुद्धि ले ओह राहाब<note caller="+" style="f"><char style="fr" closed="false">26:12 </char><char style="fq" closed="false">राहाब </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">पुराना जमाना के काल्पनिक समुंदर के अस्सूर</char></note> ला कुटा-कुटा कर देथे।<verse eid="JOB 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 26:13" />ओकर सांस ले अकास-मंडल साफ हो जाथे;</para>
  <para style="q2" vid="JOB 26:13">ओकर हांथ ह भागत सांप ला मार देथे।<verse eid="JOB 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 26:14" />अऊ येमन तो ओकर काम के सिरिप एक झलक अंय;</para>
  <para style="q2" vid="JOB 26:14">ओकर फुसफुसाहट हमन ला कतेक कम सुनई देथे!</para>
  <para style="q2" vid="JOB 26:14">त फेर ओकर सामर्थ के गरजन ला कोन ह समझ सकथे?”<verse eid="JOB 26:14" /></para>
  <chapter eid="JOB 26" />
  <chapter number="27" style="c" sid="JOB 27" />
  <para style="s1">अयूब के अपन संगीमन ला कहे आखिरी गोठ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 27:1" />अऊ अयूब ह अपन बात ला आगे कहिस:<verse eid="JOB 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 27:2" />“जीयत परमेसर के किरिया, जऊन ह मोला नियाय नइं दे हवय,</para>
  <para style="q2" vid="JOB 27:2">ओ सर्वसक्तिमान, जऊन ह मोर जिनगी ला करू कर दे हवय,<verse eid="JOB 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 27:3" />जब तक मोर म परान हवय,</para>
  <para style="q2" vid="JOB 27:3">परमेसर के सांस ह मोर नाक म चलत हवय,<verse eid="JOB 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 27:4" />तब तक मेंह मोर मुहूं ले कोनो खराप बात नइं गोठियावंव,</para>
  <para style="q2" vid="JOB 27:4">अऊ मोर जीभ ले लबारी बात नइं निकलय।<verse eid="JOB 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 27:5" />मेंह कभू नइं मानंव कि तुमन सही अव;</para>
  <para style="q2" vid="JOB 27:5">मेंह अपन मरत ले अपन ईमानदारी नइं छोड़ंव।<verse eid="JOB 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 27:6" />मेंह अपन धरमीपन ला बनाय रखहूं अऊ एकर ले बाहिर नइं जावंव;</para>
  <para style="q2" vid="JOB 27:6">जब तक मेंह जीयत हंव मोर बिबेक ह मोला नइं धिक्कारय।<verse eid="JOB 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 27:7" />“मोर बईरी ह दुस्ट मनखे कस,</para>
  <para style="q2" vid="JOB 27:7">अऊ मोर बिरोधी ह अनियायी कस ठहिरय!<verse eid="JOB 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 27:8" />जब भक्तिहीन मनखेमन मर जाथें, त ओमन करा का आसा रहिथे,</para>
  <para style="q2" vid="JOB 27:8">याने कि जब परमेसर ह ओमन के परान ला ले लेथे?<verse eid="JOB 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 27:9" />जब ओमन ऊपर संकट आथे,</para>
  <para style="q2" vid="JOB 27:9">त का परमेसर ह ओमन के गोहार ला सुनथे?<verse eid="JOB 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 27:10" />का ओमन ला सर्वसक्तिमान म खुसी मिलही?</para>
  <para style="q2" vid="JOB 27:10">का ओमन परमेसर ला हर समय गोहारहीं?<verse eid="JOB 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOB 27:11" />“मेंह तुमन ला परमेसर के सामर्थ के बारे म सिखाहूं;</para>
  <para style="q2" vid="JOB 27:11">सर्वसक्तिमान के रद्दा ला मेंह नइं छुपावंव।<verse eid="JOB 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 27:12" />तुमन जम्मो ये बात ला देख डारे हव।</para>
  <para style="q2" vid="JOB 27:12">त फेर ये बेकार के बात काबर करत हव?<verse eid="JOB 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 27:13" />“दुस्ट मनखे के बांटा म परमेसर ह ये चीज देथे,</para>
  <para style="q2" vid="JOB 27:13">निरदयी मनखे ला सर्वसक्तिमान ले पुरखा के ये पूंजी मिलथे:<verse eid="JOB 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 27:14" />चाहे ओकर कतको लइका रहंय, ओमन तलवार ले घात करे जाहीं;</para>
  <para style="q2" vid="JOB 27:14">ओकर संतानमन ला कभू पेट भर जेवन नइं मिलय।<verse eid="JOB 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 27:15" />ओकर जऊन मनखेमन बांच जाहीं, ओमन महामारी ले मर जाहीं,</para>
  <para style="q2" vid="JOB 27:15">अऊ ओमन के बिधवामन ओमन बर नइं रोहीं।<verse eid="JOB 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 27:16" />हालाकि ओह चांदी ला धुर्रा कस कुढ़ोथे</para>
  <para style="q2" vid="JOB 27:16">अऊ ओनहा ला माटी कस ढेर लगाथे,<verse eid="JOB 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 27:17" />पर जऊन ओनहा के ढेर ओह लगाथे, ओला धरमी मनखे ह पहिरही,</para>
  <para style="q2" vid="JOB 27:17">अऊ निरदोस मनखेमन ओकर चांदी ला बांट लीहीं।<verse eid="JOB 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 27:18" />जऊन घर ओह बनाथे, ओह कीरा के घरौंदा कस अय,</para>
  <para style="q2" vid="JOB 27:18">या ओह रखवार के बनाय एक झोपड़ी कस अय।<verse eid="JOB 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 27:19" />ओह धनी होके सुतथे, पर अब अइसने नइं कर सकही;</para>
  <para style="q2" vid="JOB 27:19">जब ओह सुतके उठथे, त जम्मो ह खतम हो गे रहिथे।<verse eid="JOB 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 27:20" />आतंक ह ओला बाढ़ कस घेर लेथे;</para>
  <para style="q2" vid="JOB 27:20">गरेर ह ओला रथिया उड़िया ले जाथे।<verse eid="JOB 27:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 27:21" />पुरवई हवा ह ओला उड़िया ले जाथे, अऊ ओह नइं रहय;</para>
  <para style="q2" vid="JOB 27:21">येह ओला ओकर घर ले झपटके ले जाथे।<verse eid="JOB 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 27:22" />ओ हवा ह बिगर दया के ओला ओकर बिरूध उठाके फटिकथे;</para>
  <para style="q2" vid="JOB 27:22">ओह ओ हवा के सक्ति ले तेजी से भागथे।<verse eid="JOB 27:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 27:23" />येह हंसी उड़ाय सहीं ताली बजाथे</para>
  <para style="q2" vid="JOB 27:23">अऊ फुफकारके ओला ओकर जगह ले हटा देथे।”<verse eid="JOB 27:23" /></para>
  <chapter eid="JOB 27" />
  <chapter number="28" style="c" sid="JOB 28" />
  <para style="s1">बुद्धि ह कहां मिलथे</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 28:1" />चांदी ह खदान म मिलथे</para>
  <para style="q2" vid="JOB 28:1">अऊ सोन ला सुध करे बर एक जगह होथे।<verse eid="JOB 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 28:2" />माटी म ले लोहा निकाले जाथे,</para>
  <para style="q2" vid="JOB 28:2">अऊ तांबा ह धातु ला गलाय ले मिलथे।<verse eid="JOB 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 28:3" />मरनहार मनखेमन अंधियार के अन्त कर देथें;</para>
  <para style="q2" vid="JOB 28:3">ओमन बहुंत दूर तक कोना-कोना म</para>
  <para style="q2" vid="JOB 28:3">घोर अंधियार म धातु के खोज करथें।<verse eid="JOB 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 28:4" />मनखेमन के बसेरा ले बहुंत दूरिहा ओमन खदान खनथें,</para>
  <para style="q2" vid="JOB 28:4">जिहां मनखेमन के गोड़ घलो नइं परे रहय;</para>
  <para style="q2" vid="JOB 28:4">आने मनखेमन ले बहुंत दूर ओमन ओरमे अऊ झूलत रहिथें।<verse eid="JOB 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 28:5" />धरती, जिहां ले फसल आथे,</para>
  <para style="q2" vid="JOB 28:5">ओकर खाल्हे के रूप ह आगी के दुवारा बदलत हवय।<verse eid="JOB 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 28:6" />येकर चट्टानमन म ले नीलमनि,</para>
  <para style="q2" vid="JOB 28:6">अऊ येकर धुर्रा म सोन के कन पाय जाथे।<verse eid="JOB 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 28:7" />ओ छुपे रद्दा ला कोनो सिकार करइया चिरई नइं जानय,</para>
  <para style="q2" vid="JOB 28:7">येकर ऊपर कोनो बाज चिरई के आंखी नइं परे हवय।<verse eid="JOB 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 28:8" />येमा जंगली पसुमन अपन गोड़ नइं रखंय,</para>
  <para style="q2" vid="JOB 28:8">अऊ कोनो सेर उहां छुपके घलो नइं जावय।<verse eid="JOB 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 28:9" />मनखेमन कठोर चट्टान ऊपर अपन हांथ ले ठोकर मारथें</para>
  <para style="q2" vid="JOB 28:9">अऊ पहाड़मन के नीव ला उखानके हटा देथें।<verse eid="JOB 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 28:10" />ओमन चट्टान म ले सुरंग<note caller="+" style="f"><char style="fr" closed="false">28:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">पानी के नहर</char></note> निकाल लेथें;</para>
  <para style="q2" vid="JOB 28:10">ओमन के आंखी ह येकर खजाना ला देखथे।<verse eid="JOB 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 28:11" />ओमन नदीमन के सोतमन ला खोजथें</para>
  <para style="q2" vid="JOB 28:11">अऊ छुपे चीजमन ला सब के आघू म लानथें।<verse eid="JOB 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 28:12" />पर बुद्धि ह कहां मिल सकथे?</para>
  <para style="q2" vid="JOB 28:12">ओ जगह कहां हवय, जिहां समझ ह रहिथे।<verse eid="JOB 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 28:13" />कोनो मरनहार मनखे येकर कीमत नइं जान सकय;</para>
  <para style="q2" vid="JOB 28:13">येह जीयत परानीमन के लोक म नइं मिलय।<verse eid="JOB 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 28:14" />समुंदर के गहरई ह कहिथे, “बुद्धि ह मोर म नइं ए”;</para>
  <para style="q2" vid="JOB 28:14">समुंदर ह कहिथे, “बुद्धि ह मोर करा नइं ए।”<verse eid="JOB 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 28:15" />चोखा सोन ले येला बिसाय नइं जा सकय,</para>
  <para style="q2" vid="JOB 28:15">अऊ न ही येकर कीमत बर चांदी ला तऊले जा सकथे।<verse eid="JOB 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 28:16" />येला ओपीर के सोन ले बिसाय नइं जा सकय,</para>
  <para style="q2" vid="JOB 28:16">येला कीमती गोमेदक या नीलमनि ले घलो बिसाय नइं जा सकय।<verse eid="JOB 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 28:17" />न सोन, न कांच के तुलना येकर संग करे जा सकथे,</para>
  <para style="q2" vid="JOB 28:17">न ही सोन के जेवर के बलदा म येह मिल सकथे।<verse eid="JOB 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 28:18" />मूंगा अऊ मनि के येकर आघू म चरचा करई ह बेकार अय;</para>
  <para style="q2" vid="JOB 28:18">बुद्धि के कीमत ह मानिक ले घलो बढ़के अय।<verse eid="JOB 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 28:19" />कूस<note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">इथोपिया देस</char></note> के पुखराज के तुलना येकर संग करे नइं जा सकय;</para>
  <para style="q2" vid="JOB 28:19">येला चोखा सोन ले बिसाय नइं जा सकय।<verse eid="JOB 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 28:20" />त फेर बुद्धि ह कहां ले आथे?</para>
  <para style="q2" vid="JOB 28:20">समझ ह कहां रहिथे?<verse eid="JOB 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 28:21" />येह हर एक जीयत चीज के आंखी ले छुपे हवय,</para>
  <para style="q2" vid="JOB 28:21">अऊ त अऊ अकास के चिरईमन के आंखी घलो येला नइं देख सकंय।<verse eid="JOB 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 28:22" />बिनास अऊ मिरतू कहिथें,</para>
  <para style="q2" vid="JOB 28:22">“सिरिप येकर अफवाह ला हमन सुने हवन।”<verse eid="JOB 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 28:23" />परमेसर ह येकर रद्दा ला समझथे</para>
  <para style="q2" vid="JOB 28:23">अऊ सिरिप ओही ह येकर रहे के जगह ला जानथे,<verse eid="JOB 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 28:24" />काबरकि ओह धरती के छोर तक नजर रखथे</para>
  <para style="q2" vid="JOB 28:24">अऊ अकास के खाल्हे के हर एक चीज ला देखथे।<verse eid="JOB 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 28:25" />जब ओह हवा के ताकत ला स्थापित करिस</para>
  <para style="q2" vid="JOB 28:25">अऊ पानी ला नापिस,<verse eid="JOB 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 28:26" />जब ओह बरसा होय के नियम</para>
  <para style="q2" vid="JOB 28:26">अऊ बादर के गरजन के रद्दा ठहिराईस,<verse eid="JOB 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 28:27" />तब ओह बुद्धि ला देखिस अऊ येकर दाम आंकिस;</para>
  <para style="q2" vid="JOB 28:27">ओह येकर पुस्टि करिस अऊ येला जांचिस।<verse eid="JOB 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 28:28" />अऊ परमेसर ह मनखे-जात ला कहिस,</para>
  <para style="q2" vid="JOB 28:28">“परभू के भय मनई ह बुद्धि अय,</para>
  <para style="q2" vid="JOB 28:28">अऊ बुरई ले दूरिहा रहई ह समझ अय।”<verse eid="JOB 28:28" /></para>
  <chapter eid="JOB 28" />
  <chapter number="29" style="c" sid="JOB 29" />
  <para style="s1">अयूब के आखिरी बचाव</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 29:1" />अयूब ह अपन बात ला आगे कहिस:<verse eid="JOB 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 29:2" />“कास मोर स्थिति ह पहिली के महिनामन सहीं हो जातिस,</para>
  <para style="q2" vid="JOB 29:2">ओ दिनमन म, जब परमेसर ह मोर देखभाल करत रिहिस,<verse eid="JOB 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 29:3" />जब ओकर दीया के अंजोर ह मोर मुड़ म परत रिहिस</para>
  <para style="q2" vid="JOB 29:3">अऊ ओकर अंजोर के जरिये मेंह अंधियार म रेंगत रहेंव!<verse eid="JOB 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 29:4" />ओ दिनमन मोर बढ़िया दिन<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सम्पन्नता के दिन</char></note> रिहिन,</para>
  <para style="q2" vid="JOB 29:4">जब परमेसर के संग घनिस्ट संगी के रिस्ता ह मोर घर ला आसीस देवत रिहिस,<verse eid="JOB 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 29:5" />जब सर्वसक्तिमान ह मोर संग म रिहिस</para>
  <para style="q2" vid="JOB 29:5">अऊ मोर लइकामन मोर चारों कोति रिहिन,<verse eid="JOB 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 29:6" />जब मोर रसता ह मलाई ले गीला होवत रिहिस</para>
  <para style="q2" vid="JOB 29:6">अऊ चट्टानमन मोर बर जैतून के तेल के धारा बहात रिहिन।<verse eid="JOB 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JOB 29:7" />“जब मेंह सहर के कपाट करा जावंव</para>
  <para style="q2" vid="JOB 29:7">अऊ खुला चऊक<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">सहर के भीतर सहर के कपाट के लकठा म सहर के मनखेमन के बइसका करे के जगह</char></note> म अपन आसन म बईठंव,<verse eid="JOB 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 29:8" />त जवानमन मोला देखके डहार छोंड़ देवंय</para>
  <para style="q2" vid="JOB 29:8">अऊ डोकरामन आदर म उठके ठाढ़ हो जावंय;<verse eid="JOB 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 29:9" />मुखिया मनखेमन अपन गोठियाई बंद कर देवंय</para>
  <para style="q2" vid="JOB 29:9">अऊ अपन हांथ ले अपन मुहूं ला ढंक लेवंय;<verse eid="JOB 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 29:10" />आदरनीय मनखेमन चुप हो जावंय,</para>
  <para style="q2" vid="JOB 29:10">अऊ ओमन के जीभ ह ओमन के तालू म चपक जावय।<verse eid="JOB 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 29:11" />जऊन कोनो मोर बात ला सुनय, ओह मोला बने कहय,</para>
  <para style="q2" vid="JOB 29:11">अऊ जऊन मन मोला देखंय, ओमन मोर बड़ई करंय,<verse eid="JOB 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 29:12" />काबरकि मेंह मदद मंगइया गरीब</para>
  <para style="q2" vid="JOB 29:12">अऊ ओ अनाथ लइकामन, जेमन के मदद करइया कोनो नइं रहंय, ओमन ला छोंड़ावंव।<verse eid="JOB 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 29:13" />मिरतू के खटिया म परे मनखे ह मोला आसीरबाद देवय;</para>
  <para style="q2" vid="JOB 29:13">मोर कारन बिधवामन अपन हिरदय ले आनंद के गीत गावंय।<verse eid="JOB 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 29:14" />मेंह धरमीपन ला कपड़ा सहीं पहिर ले रहेंव;</para>
  <para style="q2" vid="JOB 29:14">नियाय ह मोर ओनहा अऊ मोर पागा रिहिस।<verse eid="JOB 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 29:15" />मेंह अंधरामन बर आंखी</para>
  <para style="q2" vid="JOB 29:15">अऊ खोरवामन बर गोड़ रहेंव।<verse eid="JOB 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 29:16" />में जरूरतमंद बर ददा सहीं रहेंव;</para>
  <para style="q2" vid="JOB 29:16">मेंह अनचिनहार मनखे के मामला ला निपटावंव।<verse eid="JOB 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 29:17" />मेंह दुस्टमन के दांत ला टोरंव</para>
  <para style="q2" vid="JOB 29:17">अऊ पीड़ित मनखे ला ओमन के पकड़ ले छोंड़ावंव।<verse eid="JOB 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOB 29:18" />“मेंह सोचेंव, ‘में अपन घर म ही मरहूं,</para>
  <para style="q2" vid="JOB 29:18">मोर जिनगी के दिनमन बालू कस अनगिनत होहीं।<verse eid="JOB 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 29:19" />मोर जरी ह पानी तक हबरही,</para>
  <para style="q2" vid="JOB 29:19">अऊ ओस ह रात भर मोर डारामन म रहिही।<verse eid="JOB 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 29:20" />मोर महिमा ह नइं मुरझाही;</para>
  <para style="q2" vid="JOB 29:20">धनुस ह मोर हांथ म हमेसा नवां बने रहिही।’<verse eid="JOB 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOB 29:21" />“मनखेमन मोर बात ला मन लगाके सुनंय,</para>
  <para style="q2" vid="JOB 29:21">अऊ चुपेचाप मोर सलाह के इंतजार करंय।<verse eid="JOB 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 29:22" />मोर गोठियाय के बाद ओमन अऊ नइं गोठियांय;</para>
  <para style="q2" vid="JOB 29:22">मोर गोठ ह ओमन के कान म सरलता से उतर जावय।<verse eid="JOB 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 29:23" />ओमन बारिस के सहीं मोर बाट जोहंय</para>
  <para style="q2" vid="JOB 29:23">अऊ बसंतकाल के बरसा सहीं मोर गोठ ला गरहन करंय।<verse eid="JOB 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 29:24" />जब मेंह ओमन ऊपर मुस्करावंव, त ओमन मुसकुल से येला बिसवास करंय;</para>
  <para style="q2" vid="JOB 29:24">मोर चेहरा के अंजोर ह ओमन बर कीमती रिहिस।<verse eid="JOB 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 29:25" />मेंह ओमन बर रसता चुनेंव अऊ ओमन के मुखिया के रूप म बईठेंव;</para>
  <para style="q2" vid="JOB 29:25">मेंह ओकर सेना के बीच म राजा सहीं रहत रहेंव;</para>
  <para style="q2" vid="JOB 29:25">मेंह सोक करइयामन ला सांति देवइया सहीं रहेंव।<verse eid="JOB 29:25" /></para>
  <para style="b" />
  <chapter eid="JOB 29" />
  <chapter number="30" style="c" sid="JOB 30" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 30:1" />“पर अब ओमन ही मोर हंसी उड़ाथें,</para>
  <para style="q2" vid="JOB 30:1">ओ मनखे जऊन मन उमर म मोर ले छोटे हवंय,</para>
  <para style="q1" vid="JOB 30:1">जऊन मन के ददामन ला मेंह अपन भेड़मन के रखवार कुकुरमन संग</para>
  <para style="q2" vid="JOB 30:1">रखे के लईक घलो नइं समझत रहेंव।<verse eid="JOB 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 30:2" />ओमन के भुजा के बल ह मोर का काम के रिहिस,</para>
  <para style="q2" vid="JOB 30:2">जब ओमन के ताकत ह खतम हो गे रिहिस?<verse eid="JOB 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 30:3" />गरीबी अऊ भूख ले दुबर-पातर,</para>
  <para style="q2" vid="JOB 30:3">ओमन बीरान अऊ बेकार पड़े भुइयां म</para>
  <para style="q2" vid="JOB 30:3">रथिया के बेरा भटकत रिहिन।<verse eid="JOB 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 30:4" />ओमन झाड़ी के बीच म लोनिया साग<note caller="+" style="f"><char style="fr" closed="false">30:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">नूनचूर भुइयां (ऊसर भुइयां) म उपजे साग-भाजी</char></note> टोरिन,</para>
  <para style="q2" vid="JOB 30:4">अऊ ओमन के जेवन,<note caller="+" style="f"><char style="fr" closed="false">30:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बारे के लकरी</char></note> बहरी बनाय के झाड़ी के जरी रिहिस।<verse eid="JOB 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 30:5" />ओमन ला समाज ले निकाल देय गे रिहिस,</para>
  <para style="q2" vid="JOB 30:5">मनखेमन ओमन ऊपर अइसे चिचियावंय, जइसे चोर ऊपर चिचियाथें।<verse eid="JOB 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 30:6" />ओमन ला डरावनी घाटीमन म, चट्टानमन के बीच म</para>
  <para style="q2" vid="JOB 30:6">अऊ भुइयां के बिलमन म रहे ला परय।<verse eid="JOB 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 30:7" />ओमन झाड़ीमन के बीच म पसु सहीं चिचियावंय</para>
  <para style="q2" vid="JOB 30:7">अऊ रूख के खाल्हे उगे झाड़ीमन म भीड़ लगावंय।<verse eid="JOB 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 30:8" />ओमन नीच अऊ अनामी संतान रिहिन,</para>
  <para style="q2" vid="JOB 30:8">जेमन ला देस ले निकाल देय जावय।<verse eid="JOB 30:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JOB 30:9" />“अब ओ जवानमन गीत गाके मोर हंसी उड़ाथें;</para>
  <para style="q2" vid="JOB 30:9">मेंह ओमन के बीच म एक नारा बन गे हवंव।<verse eid="JOB 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 30:10" />ओमन मोर ले घिन करथें अऊ मोर ले दूरिहा रहिथें;</para>
  <para style="q2" vid="JOB 30:10">ओमन मोर मुहूं ऊपर थूके म संकोच नइं करंय।<verse eid="JOB 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 30:11" />काबरकि परमेसर ह मोला सक्तिहीन कर दे हवय अऊ मोला पीरा दे हवय,</para>
  <para style="q2" vid="JOB 30:11">ओमन मोर आघू म बिगर लगाम के हो जाथंय।<verse eid="JOB 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 30:12" />मोर जेवनी कोति बरदी के बरदी चढ़ई करथें;</para>
  <para style="q2" vid="JOB 30:12">ओमन मोर गोड़ बर फांदा लगाथें,</para>
  <para style="q2" vid="JOB 30:12">ओमन मोर बिरोध म अपन घेराबंदी के ढलान बनाथें।<verse eid="JOB 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 30:13" />ओमन मोर डहार ला काटके बंद कर देथें;</para>
  <para style="q2" vid="JOB 30:13">ओमन मोला नास करे म सफल होथें।</para>
  <para style="q2" vid="JOB 30:13">ओमन कहिथें, ‘ओकर मदद कोनो झन करंय।’<verse eid="JOB 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 30:14" />दरार म ले बुलकके आय सहीं ओमन आघू बढ़थें;</para>
  <para style="q2" vid="JOB 30:14">बिनास के बीच म ओमन उंडलत आथें।<verse eid="JOB 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 30:15" />आतंक ह मोर ऊपर छा गे हवय;</para>
  <para style="q2" vid="JOB 30:15">मोर मान-सम्मान ह हवा कस उड़िया गे हवय,</para>
  <para style="q2" vid="JOB 30:15">मोर सुरकछा ह बादर कस गायब हो गे हवय।<verse eid="JOB 30:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOB 30:16" />“अब मोर जिनगी ह घटत हवय;</para>
  <para style="q2" vid="JOB 30:16">दुख के दिनमन मोला जकड़ ले हवंय।<verse eid="JOB 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 30:17" />रथिया ह मोर हाड़ामन ला भेद देथे;</para>
  <para style="q2" vid="JOB 30:17">मोर अब्बड़ पीरा ह कभू बंद नइं होवय।<verse eid="JOB 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 30:18" />परमेसर ह अपन बड़े सामर्थ म मोर ओनहा ला पकड़थे<note caller="+" style="f"><char style="fr" closed="false">30:18 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमेसर ह गुस्सा म मोर ओनहा ला पकड़थे</char></note>;</para>
  <para style="q2" vid="JOB 30:18">ओह मोर कुरता के कालर कस मोला लपेटथे।<verse eid="JOB 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 30:19" />ओह मोला चीखला म फटिकथे,</para>
  <para style="q2" vid="JOB 30:19">अऊ मेंह धुर्रा अऊ राख कस हो गे हंव।<verse eid="JOB 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOB 30:20" />“हे परमेसर, में तोला पुकारथंव, पर तेंह जबाब नइं देवस;</para>
  <para style="q2" vid="JOB 30:20">मेंह ठाढ़ होथंव, पर तेंह सिरिप मोला देखथस।<verse eid="JOB 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 30:21" />तें मोर बर कठोर हो गे हस;</para>
  <para style="q2" vid="JOB 30:21">अपन भुजा के बल ले मोला सताथस।<verse eid="JOB 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 30:22" />तेंह मोला उठाके हवा म उड़िया देथस;</para>
  <para style="q2" vid="JOB 30:22">तेंह मोला आंधी म उछाल देथस।<verse eid="JOB 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 30:23" />मेंह जानत हंव तेंह मोला मिरतू करा ले आबे,</para>
  <para style="q2" vid="JOB 30:23">ओ जगह जऊन ह जम्मो जीयत परानीमन बर ठहिराय गे हवय।<verse eid="JOB 30:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JOB 30:24" />“खचित कोनो टूटे मनखे कोति हांथ नइं बढ़ावय</para>
  <para style="q2" vid="JOB 30:24">जब ओह अपन बिपत्ति के समय मदद बर गोहारथे।<verse eid="JOB 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 30:25" />का मेंह ओमन बर नइं रोयेंव, जऊन मन समस्या म रिहिन?</para>
  <para style="q2" vid="JOB 30:25">का गरीबमन बर मोर आतमा ह दुखी नइं होईस?<verse eid="JOB 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 30:26" />तभो ले जब मेंह भलई के आसा करेंव, त बुरई ह आईस;</para>
  <para style="q2" vid="JOB 30:26">जब मेंह अंजोर के बाट जोहत रहेंव, त अंधियार आईस।<verse eid="JOB 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 30:27" />मोर भीतर म उथल-पुथल कभू बंद नइं होवय;</para>
  <para style="q2" vid="JOB 30:27">दुख के दिनमन मोर ऊपर आ गे हवंय।<verse eid="JOB 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 30:28" />मेंह करिया होवत हंव, पर सूरज के दुवारा नइं;</para>
  <para style="q2" vid="JOB 30:28">मेंह सभा म ठाढ़ होके मदद बर गोहारथंव।<verse eid="JOB 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 30:29" />मेंह गीदड़मन के भाई,</para>
  <para style="q2" vid="JOB 30:29">अऊ उल्लू चिरईमन के संगी बन गे हवंव।<verse eid="JOB 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 30:30" />मोर चमड़ी ह करिया होके गिरत हवय;</para>
  <para style="q2" vid="JOB 30:30">मोर देहें ह जर-बुखार म जरत हवय।<verse eid="JOB 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 30:31" />मोर बीना ले बिलाप के सुर,</para>
  <para style="q2" vid="JOB 30:31">अऊ मोर बंसी ले रोये के अवाज निकलत हवय।<verse eid="JOB 30:31" /></para>
  <para style="b" />
  <chapter eid="JOB 30" />
  <chapter number="31" style="c" sid="JOB 31" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 31:1" />“मेंह अपन आंखीमन के संग करार करे हंव</para>
  <para style="q2" vid="JOB 31:1">कि मेंह कोनो जवान माईलोगन ला लालसा ले नइं देखंव।<verse eid="JOB 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 31:2" />स्वरग ले परमेसर के दुवारा हमन ला का बांटा मिले हे,</para>
  <para style="q2" vid="JOB 31:2">या ऊंच म बिराजे सर्वसक्तिमान ले हमन ला मिले संपत्ति का ए?<verse eid="JOB 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 31:3" />का येह दुस्टमन बर बिनास,</para>
  <para style="q2" vid="JOB 31:3">अऊ गलत करइयामन बर बिपत्ति नो हय?<verse eid="JOB 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 31:4" />का परमेसर ह मोर चालचलन ला नइं देखय</para>
  <para style="q2" vid="JOB 31:4">अऊ मोर कदम-कदम ला नइं गनय?<verse eid="JOB 31:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 31:5" />“कहूं मेंह लबारी आचरन करे हंव</para>
  <para style="q2" vid="JOB 31:5">या मोर गोड़ ह धोखा देय बर दऊड़े हे—<verse eid="JOB 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 31:6" />त परमेसर ह मोला सच के तराजू म तऊल लेवय</para>
  <para style="q2" vid="JOB 31:6">अऊ ओह जान लेवय कि मेंह निरदोस अंव—<verse eid="JOB 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 31:7" />कहूं मोर कदम ह ओकर डहार ले भटक गे हवय,</para>
  <para style="q2" vid="JOB 31:7">कहूं मोर मन ह मोर आंखी के मुताबिक चले हवय,</para>
  <para style="q2" vid="JOB 31:7">या कहूं मोर हांथमन असुध हो गे हवंय,<verse eid="JOB 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 31:8" />त जऊन कुछू मेंह बोये हंव, ओला आने मन खावंय,</para>
  <para style="q2" vid="JOB 31:8">अऊ मोर फसल ला उखान दिये जावय।<verse eid="JOB 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JOB 31:9" />“कहूं मोर मन ह कोनो माईलोगन के दुवारा बहकाय गे हे,</para>
  <para style="q2" vid="JOB 31:9">या कहूं मेंह अपन परोसी के मुंहटा म घात लगाके बईठे हंव,<verse eid="JOB 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 31:10" />त मोर घरवाली ह आने आदमी के अनाज पीसय,</para>
  <para style="q2" vid="JOB 31:10">अऊ आने आदमीमन ओकर संग सुतंय।<verse eid="JOB 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 31:11" />काबरकि ओह दुस्ट काम होतिस,</para>
  <para style="q2" vid="JOB 31:11">अऊ नियायधीस के दुवारा पाप के दंड मिलतिस।<verse eid="JOB 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 31:12" />येह एक आगी ए, जऊन ह जलाके भसम कर देथे;</para>
  <para style="q2" vid="JOB 31:12">येह मोर कटनी के फसल ला जरी ले उखान देतिस।<verse eid="JOB 31:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 31:13" />“कहूं मेंह अपन कोनो सेवक के संग अनियाय करे हंव,</para>
  <para style="q2" vid="JOB 31:13">चाहे दास हो या दासी,</para>
  <para style="q2" vid="JOB 31:13">जब ओमन मोर बिरोध म मोर करा सिकायत करिन,<verse eid="JOB 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 31:14" />तब में का करहूं, जब परमेसर ह मोर ले जबाब मांगही?</para>
  <para style="q2" vid="JOB 31:14">मेंह का जबाब दूहूं, जब ओह मोर ले लेखा लीही?<verse eid="JOB 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 31:15" />जऊन ह मोला दाई के गरभ म बनाईस, का ओहीच ह ओमन ला नइं बनाईस?</para>
  <para style="q2" vid="JOB 31:15">का ओही ह हमन दूनों ला हमर दाईमन के गरभ म नइं रचिस?<verse eid="JOB 31:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOB 31:16" />“कहूं मेंह गरीबमन के ईछा ला पूरा नइं करे हंव</para>
  <para style="q2" vid="JOB 31:16">या मोर कारन बिधवामन म निरासा छा गीस,<verse eid="JOB 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 31:17" />कहूं मेंह खाना खाय म सुवारथी हो गे हंव,</para>
  <para style="q2" vid="JOB 31:17">अऊ खाना ला अनाथमन संग नइं बांटे हंव—<verse eid="JOB 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 31:18" />पर में तो ओमन ला अपन जवानी ले अइसे पालें-पोसें, जइसे एक ददा ह करथे,</para>
  <para style="q2" vid="JOB 31:18">अऊ मेंह अपन लइकापन ले ही बिधवा ला रसता देखावत हंव—<verse eid="JOB 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 31:19" />कहूं मेंह कोनो ला ओनहा के कमी के कारन नास होवत देखेंव,</para>
  <para style="q2" vid="JOB 31:19">या कोनो जरूरतमंद ला बिगर ओनहा के देखेंव,<verse eid="JOB 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 31:20" />त ओमन ला मेंह अपन भेड़ के ऊन ले गरम रखे के कारन</para>
  <para style="q2" vid="JOB 31:20">ओमन मोला हिरदय ले आसीरबाद नइं दे हवंय,<verse eid="JOB 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 31:21" />कहूं मेंह अनाथमन ऊपर अपन हांथ उठाय हंव,</para>
  <para style="q2" vid="JOB 31:21">ये जानके कि अदालत म मोर पहुंच हवय,<verse eid="JOB 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 31:22" />त मोर बाहां ह कंधा ले उखनके गिर जावय,</para>
  <para style="q2" vid="JOB 31:22">येह कोहनी ले टूटके अलग हो जावय।<verse eid="JOB 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 31:23" />काबरकि मेंह परमेसर कोति ले अवइया बिनास ले डरेंव,</para>
  <para style="q2" vid="JOB 31:23">अऊ ओकर सोभा के डर के कारन मेंह अइसे नइं कर सकेंव।<verse eid="JOB 31:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JOB 31:24" />“कहूं मेंह अपन भरोसा सोन ऊपर रखे हंव</para>
  <para style="q2" vid="JOB 31:24">या चोखा सोन ले कहे हंव, ‘तेंह मोर आसरा अस,’<verse eid="JOB 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 31:25" />कहूं मेंह अपन बहुंत धन,</para>
  <para style="q2" vid="JOB 31:25">या अपन हांथ के बहुंत कमई ऊपर आनंद मनाय हंव,<verse eid="JOB 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 31:26" />कहूं मेंह सूरज के चमकई,</para>
  <para style="q2" vid="JOB 31:26">या चंदा ला सोभा म चलत देखेंव,<verse eid="JOB 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 31:27" />ताकि मोर मन ह मोहा गीस</para>
  <para style="q2" vid="JOB 31:27">अऊ ओमन के भक्ति म मोर हांथ के चूमा लेय हंव,<verse eid="JOB 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 31:28" />त ये पापमन के घलो दंड मिलतिस,</para>
  <para style="q2" vid="JOB 31:28">काबरकि तब मेंह ऊपर म बिराजे परमेसर के इनकार करे रहितेंव।<verse eid="JOB 31:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JOB 31:29" />“कहूं मेंह अपन बईरी के दुरभाग्य म आनंद मनाय हंव</para>
  <para style="q2" vid="JOB 31:29">या ओकर ऊपर आय बिपत्ति ला देखके खुस होय हंव—<verse eid="JOB 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 31:30" />मेंह ओमन ला मरे के सराप देय के दुवारा</para>
  <para style="q2" vid="JOB 31:30">अपन मुहूं ले पाप नइं करे हंव—<verse eid="JOB 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 31:31" />कहूं मोर घर म रहइया मनखेमन ये कभू नइं कहे हवंय,</para>
  <para style="q2" vid="JOB 31:31">‘कोन ह अयूब के इहां खाके संतोस नइं होईस?’—<verse eid="JOB 31:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 31:32" />पर कोनो अजनबी ला गली म रथिया बिताना नइं परिस,</para>
  <para style="q2" vid="JOB 31:32">काबरकि मोर घर के मुंहटा ह बटोहीमन बर हमेसा खुला रिहिस—<verse eid="JOB 31:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 31:33" />अपन मन म अपन अपराध ला छुपाय के दुवारा</para>
  <para style="q2" vid="JOB 31:33">कहूं मेंह आने मनखेमन सहीं अपन पाप ला छुपाय हंव,<verse eid="JOB 31:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 31:34" />काबरकि मोला मनखेमन के भीड़ ले डर लगिस</para>
  <para style="q2" vid="JOB 31:34">अऊ अपन कुल के अपमान ले अइसे डर गेंव</para>
  <para style="q2" vid="JOB 31:34">कि मेंह चुप रहेंव अऊ घर ले बाहिर नइं निकलेंव—<verse eid="JOB 31:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="JOB 31:35" />(“आह, कि कोनो तो मोर बात के सुनइया रिहिस!</para>
  <para style="q2" vid="JOB 31:35">मेंह अब अपन बचाव के दसखत करत हंव—सर्वसक्तिमान ह मोला जबाब देवय;</para>
  <para style="q2" vid="JOB 31:35">मोर ऊपर दोस लगइया ह मोर दोस ला लिखित म देवय।<verse eid="JOB 31:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 31:36" />खचित मेंह येला अपन खांध म उठाहूं,</para>
  <para style="q2" vid="JOB 31:36">मेंह येला मुकुट कस पहिरहूं।<verse eid="JOB 31:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 31:37" />मेंह ओला अपन हर कदम के हिसाब दूहूं;</para>
  <para style="q2" vid="JOB 31:37">जइसे सासन करइया के आघू म मामला रखथें, वइसे मेंह येला ओकर आघू म रखहूं।)—<verse eid="JOB 31:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="JOB 31:38" />“कहूं मोर भुइयां ह मोर बिरोध म पुकारथे</para>
  <para style="q2" vid="JOB 31:38">अऊ नांगर ले बने येकर जम्मो घारीमन रोथें,<verse eid="JOB 31:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="JOB 31:39" />कहूं मेंह बिगर दाम चुकाय येकर ऊपज ला खा गे हंव</para>
  <para style="q2" vid="JOB 31:39">या येकर मालिक के मरे के कारन बने हंव,<note caller="+" style="f"><char style="fr" closed="false">31:39 </char><char style="ft" closed="false">अधरम करके दुख दे हंव</char></note><verse eid="JOB 31:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JOB 31:40" />त गहूं के बलदा म कंटिली झाड़ी</para>
  <para style="q2" vid="JOB 31:40">अऊ जवांर के बलदा म खरपतवार उगय।”</para>
  <para style="p" vid="JOB 31:40">अयूब के गोठ ह खतम होईस।<verse eid="JOB 31:40" /></para>
  <chapter eid="JOB 31" />
  <chapter number="32" style="c" sid="JOB 32" />
  <para style="s1">एलीहू</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 32:1" />तब अयूब के ये तीनों संगी अयूब ला जबाब देना बंद कर दीन, काबरकि अयूब ह खुद के नजर म धरमी रिहिस। <verse eid="JOB 32:1" /><verse number="2" style="v" sid="JOB 32:2" />पर राम के परिवार के बूजवासी बारकेल के बेटा एलीहू ह अयूब के ऊपर बहुंत गुस्सा होईस काबरकि अयूब ह परमेसर के बदले अपनआप ला धरमी ठहिरात रिहिस। <verse eid="JOB 32:2" /><verse number="3" style="v" sid="JOB 32:3" />एलीहू ह ये तीनो संगीमन ऊपर घलो गुस्सा होईस, काबरकि ओमन अयूब ला जबाब नइं दे सकिन, अऊ तभो ले ओमन ओला दोसी ठहिराईन। <verse eid="JOB 32:3" /><verse number="4" style="v" sid="JOB 32:4" />एलीहू ह अयूब के आघू म गोठियाय बर इंतजार करत रिहिस, काबरकि ओह ओमन ले उमर म छोटे रिहिस। <verse eid="JOB 32:4" /><verse number="5" style="v" sid="JOB 32:5" />पर जब ओह देखिस कि ओ तीनों झन करा कहे बर अऊ कुछू नइं ए, त ओकर रिस ह भड़किस।<verse eid="JOB 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 32:6" />तब बूजवासी बारकेल के बेटा एलीहू ह जबाब दीस:</para>
  <para style="q1" vid="JOB 32:6">“मेंह तो उमर म छोटे अंव,</para>
  <para style="q2" vid="JOB 32:6">अऊ तुमन सियान अव;</para>
  <para style="q1" vid="JOB 32:6">एकरसेति मेंह डरत रहेंव,</para>
  <para style="q2" vid="JOB 32:6">अऊ जऊन कुछू जानथंव, ओला कहे के हिम्मत नइं करत रहेंव।<verse eid="JOB 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 32:7" />मेंह सोचत रहेंव, ‘उमर म बड़ेमन ला गोठियाना चाही;</para>
  <para style="q2" vid="JOB 32:7">उमर म बड़ेमन ला बुद्धि के बात सिखाना चाही।’<verse eid="JOB 32:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 32:8" />पर मनखे म येह आतमा ए,</para>
  <para style="q2" vid="JOB 32:8">याने सर्वसक्तिमान के सांस ए, जऊन ह ओमन ला समझ देथे।<verse eid="JOB 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 32:9" />सिरिप सियान मनखेमन ही बुद्धिमान नइं होवंय,</para>
  <para style="q2" vid="JOB 32:9">अऊ सिरिप उमरवालामन ही सही बात के समझ नइं रखंय।<verse eid="JOB 32:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOB 32:10" />“एकरसेति मेंह कहत हंव: मोर बात ला सुनव;</para>
  <para style="q2" vid="JOB 32:10">मेंह घलो तुमन ला बताहूं, जऊन कुछू मेंह जानथंव।<verse eid="JOB 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 32:11" />जब तुमन गोठियावत रहेव, त मेंह रूके रहेंव,</para>
  <para style="q2" vid="JOB 32:11">मेंह तुम्हर बिचार ला सुनेंव;</para>
  <para style="q1" vid="JOB 32:11">जब तुमन बोले बर सबद खोजत रहेव,<verse eid="JOB 32:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="JOB 32:12" />मेंह पूरा धियान देके तुम्हर बात सुनेंव।</para>
  <para style="q1" vid="JOB 32:12">पर तुमन म ले कोनो अयूब ला गलत साबित नइं करेव;</para>
  <para style="q2" vid="JOB 32:12">तुमन म ले एको झन घलो ओकर बात के जबाब नइं दे सकेव।<verse eid="JOB 32:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 32:13" />ये झन कहव, ‘हमन बुद्धि पा गे हन;</para>
  <para style="q2" vid="JOB 32:13">कोनो मनखे नइं, पर परमेसर ह ओला लबरा साबित करय।’<verse eid="JOB 32:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 32:14" />पर अयूब ह मोर बिरोध म कुछू नइं कहिस,</para>
  <para style="q2" vid="JOB 32:14">अऊ मेंह ओला तुम्हर तर्क के संग जबाब नइं देवंव।<verse eid="JOB 32:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOB 32:15" />“ओमन अबक हो गे हवंय अऊ ओमन करा कहे बर कुछू नइं ए;</para>
  <para style="q2" vid="JOB 32:15">ओमन ला सबद ही नइं मिलिस।<verse eid="JOB 32:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 32:16" />ओमन चुप हवंय अऊ बिगर कोनो जबाब के ठाढ़े हवंय,</para>
  <para style="q2" vid="JOB 32:16">त का मेंह रूके रहंव?<verse eid="JOB 32:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 32:17" />मेंह घलो अपन बात कहिहूं;</para>
  <para style="q2" vid="JOB 32:17">जऊन कुछू मेंह जानथंव, मेंह घलो बताहूं।<verse eid="JOB 32:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 32:18" />काबरकि मेंह गोठमन ले भरे हवंव,</para>
  <para style="q2" vid="JOB 32:18">अऊ मोर भीतर के आतमा ह मोला बाध्य करत हवय;<verse eid="JOB 32:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 32:19" />भीतर म मेंह अंगूर के मंद के बोतल सहीं अंव,</para>
  <para style="q2" vid="JOB 32:19">नवां चाम के बोतल सहीं, जऊन ह फूटे बर तियार हवय।<verse eid="JOB 32:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 32:20" />मेंह जरूर बोलहूं अऊ येकर ले मोला अराम मिलही;</para>
  <para style="q2" vid="JOB 32:20">मेंह मुहूं खोलके जरूर जबाब दूहूं।<verse eid="JOB 32:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 32:21" />मेंह काकरो पखियपात नइं करंव,</para>
  <para style="q2" vid="JOB 32:21">अऊ न ही काकरो चापलूसी करहूं;<verse eid="JOB 32:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 32:22" />काबरकि कहूं मेंह चापलूसी करे म कुसल होतेंव,</para>
  <para style="q2" vid="JOB 32:22">त मोर सिरजनहार ह मोला जल्दी नास कर देतिस।<verse eid="JOB 32:22" /></para>
  <para style="b" />
  <chapter eid="JOB 32" />
  <chapter number="33" style="c" sid="JOB 33" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 33:1" />“पर अब, हे अयूब, मोर गोठ ला सुन;</para>
  <para style="q2" vid="JOB 33:1">अऊ मोर ओ जम्मो बात ऊपर धियान दे, जेला मेंह कहत हंव।<verse eid="JOB 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 33:2" />मेंह अपन मुहूं खोलनेचवाला हंव;</para>
  <para style="q2" vid="JOB 33:2">मोर जीभ ह गोठियाय बर चुलबुलावत हवय।<verse eid="JOB 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 33:3" />मोर गोठ ह सही मन ले आवत हे;</para>
  <para style="q2" vid="JOB 33:3">जऊन बात मेंह जानथंव, ओला मेंह ईमानदारी ले गोठियाथंव।<verse eid="JOB 33:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 33:4" />परमेसर के आतमा ह मोला बनाय हवय;</para>
  <para style="q2" vid="JOB 33:4">सर्वसक्तिमान के सांस ह मोला जिनगी देथे।<verse eid="JOB 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 33:5" />कहूं जबाब दे सकत हस, त दे;</para>
  <para style="q2" vid="JOB 33:5">ठाढ़ हो अऊ मोर आघू म अपन स्थिति बर जबाब दे।<verse eid="JOB 33:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 33:6" />परमेसर के नजर म तोरेच कस महूं घलो अंव;</para>
  <para style="q2" vid="JOB 33:6">महूं ह घलो माटी ले बनाय गे हंव।<verse eid="JOB 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 33:7" />मोर ले तोला कोनो किसम के डर झन होवय,</para>
  <para style="q2" vid="JOB 33:7">अऊ न ही मोर कोति ले तोर ऊपर कोनो किसम के दबाव होवय।<verse eid="JOB 33:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 33:8" />“पर तेंह मोर सुनत म कहे हस—</para>
  <para style="q2" vid="JOB 33:8">मेंह ओ बातमन ला सुने हंव—<verse eid="JOB 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 33:9" />‘मेंह सुध हंव, मेंह कोनो अपराध नइं करे हंव;</para>
  <para style="q2" vid="JOB 33:9">मेंह सुध अऊ पाप ले मुक्त हंव।<verse eid="JOB 33:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 33:10" />तभो ले परमेसर ह मोर म गलती पाय हे;</para>
  <para style="q2" vid="JOB 33:10">ओह मोला अपन बईरी समझथे।<verse eid="JOB 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 33:11" />ओह मोर गोड़ ला बेड़ी म बांधथे;</para>
  <para style="q2" vid="JOB 33:11">ओह मोर जम्मो चालचलन ला धियान से देखथे।’<verse eid="JOB 33:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 33:12" />“पर मेंह तोला कहत हंव कि ये बात म तेंह सही नो हस,</para>
  <para style="q2" vid="JOB 33:12">काबरकि परमेसर ह कोनो भी मनखे ले बड़े अय।<verse eid="JOB 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 33:13" />तेंह ओकर करा काबर सिकायत करथस</para>
  <para style="q2" vid="JOB 33:13">कि ओह काकरो बात के जबाब नइं देवय?<verse eid="JOB 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 33:14" />काबरकि परमेसर ह गोठियाथे जरूर—कभू एक रीति ले, त कभू आने रीति ले—</para>
  <para style="q2" vid="JOB 33:14">हालाकि येला कोनो मनखे नइं समझंय।<verse eid="JOB 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 33:15" />कभू सपना म, कभू रथिया दरसन म,</para>
  <para style="q2" vid="JOB 33:15">जब मनखेमन बहुंत नींद म परे रहिथें</para>
  <para style="q2" vid="JOB 33:15">अपन बिस्तर म आलस के मारे झपकी लेवत रहिथें,<verse eid="JOB 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 33:16" />त परमेसर ह ओमन के कान म गोठियाथे</para>
  <para style="q2" vid="JOB 33:16">अऊ ओमन ला चेतउनी देके डराथे,<verse eid="JOB 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 33:17" />ताकि ओमन गलत काम झन करंय</para>
  <para style="q2" vid="JOB 33:17">अऊ घमंड ले दूरिहा रहंय,<verse eid="JOB 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 33:18" />ताकि ओमन खंचवा म गिरे ले बचंय,</para>
  <para style="q2" vid="JOB 33:18">अऊ ओमन के जिनगी ह तलवार ले नास झन होवय।<verse eid="JOB 33:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOB 33:19" />“या कोनो मनखे अपन बिस्तर म पीरा ले पीड़ित हे,</para>
  <para style="q2" vid="JOB 33:19">ओकर हाड़ामन म लगातार पीरा ले ओला सजा मिलत हे,<verse eid="JOB 33:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 33:20" />जेकर ले जेवन ह ओकर मन ला नइं रूचय</para>
  <para style="q2" vid="JOB 33:20">अऊ ओकर मन ह सुवादवाले जेवन ले घिन करे लगथे।<verse eid="JOB 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 33:21" />ओकर देहें के मांस ह बेकार म नास होथे,</para>
  <para style="q2" vid="JOB 33:21">अऊ ओकर नइं दिखइया हाड़ामन दिखे लगथें।<verse eid="JOB 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 33:22" />ओकर जीव खंचवा के लकठा म जाथे,</para>
  <para style="q2" vid="JOB 33:22">अऊ ओकर जिनगी ह मिरतू के दूतमन<note caller="+" style="f"><char style="fr" closed="false">33:22 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मिरतू के जगह</char></note> करा जाथे।<verse eid="JOB 33:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 33:23" />कहूं एक स्वरगदूत ह ओकर कोति रहय</para>
  <para style="q2" vid="JOB 33:23">एक संदेसिया, जऊन ह हजार म ले एक अय</para>
  <para style="q2" vid="JOB 33:23">ओकर करा ये कहे बर भेजे जावय कि ईमानदार कइसे बनय,<verse eid="JOB 33:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 33:24" />अऊ ओह ओ मनखे ऊपर दयालु बनके परमेसर ले कहय,</para>
  <para style="q2" vid="JOB 33:24">‘ओला कबर म जाय ले बचा;</para>
  <para style="q2" vid="JOB 33:24">मोला ओकर छुड़ौती के कीमत मिल गे हवय—<verse eid="JOB 33:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 33:25" />ओकर मांस ह लइका के मांस सहीं कोमल हो जावय</para>
  <para style="q2" vid="JOB 33:25">ओला ओकर जवानी के दिन सहीं कर दिये जावय’—<verse eid="JOB 33:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 33:26" />तब ओ मनखे ह परमेसर ले पराथना करय अऊ परमेसर के अनुग्रह ला पावय,</para>
  <para style="q2" vid="JOB 33:26">ओह परमेसर के मुहूं ला देखही अऊ आनंद के मारे चिचियाही;</para>
  <para style="q2" vid="JOB 33:26">परमेसर ह ओला फेर पहिले सहीं बने स्थिति म ले आही।<verse eid="JOB 33:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 33:27" />अऊ ओह आने मनखेमन करा जाके कहिही,</para>
  <para style="q2" vid="JOB 33:27">‘मेंह पाप करे हंव, मेंह सही काम ला बिगाड़े हंव,</para>
  <para style="q2" vid="JOB 33:27">पर मोर गलती के सजा मोला नइं मिलिस।<verse eid="JOB 33:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 33:28" />परमेसर ह मोला कबर म जाय ले बचाय हवय,</para>
  <para style="q2" vid="JOB 33:28">अऊ मेंह अपन जिनगी के अंजोर के आनंद उठाय बर जीहूं।’<verse eid="JOB 33:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JOB 33:29" />“परमेसर ह ये जम्मो चीज मनखे के संग करथे—</para>
  <para style="q2" vid="JOB 33:29">दू बार, तीन बार घलो करथे—<verse eid="JOB 33:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 33:30" />ताकि ओमन कबर ले लहुंटंय,</para>
  <para style="q2" vid="JOB 33:30">अऊ जिनगी के अंजोर ह ओमन ऊपर चमकय।<verse eid="JOB 33:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JOB 33:31" />“हे अयूब, धियान दे, अऊ मोर बात ला सुन;</para>
  <para style="q2" vid="JOB 33:31">चुपे रह, अऊ मेंह गोठियाहूं।<verse eid="JOB 33:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 33:32" />कहूं तोला कुछू कहना हे, त मोला जबाब दे;</para>
  <para style="q2" vid="JOB 33:32">गोठिया, काबरकि मेंह तोला सही ठहिराय चाहत हंव।<verse eid="JOB 33:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 33:33" />पर कहूं नइं, त फेर मोर बात ला सुन;</para>
  <para style="q2" vid="JOB 33:33">चुपे रह, अऊ मेंह तोला बुद्धि के बात सिखोहूं।”<verse eid="JOB 33:33" /></para>
  <chapter eid="JOB 33" />
  <chapter number="34" style="c" sid="JOB 34" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 34:1" />तब एलीहू ह आगे कहिस:<verse eid="JOB 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 34:2" />“हे बुद्धिमान मनखेमन, मोर बात ला सुनव;</para>
  <para style="q2" vid="JOB 34:2">हे गियानी मनखेमन, मोर बात म कान लगावव।<verse eid="JOB 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 34:3" />काबरकि जइसे जीभ ले जेवन चखे जाथे,</para>
  <para style="q2" vid="JOB 34:3">वइसनेच ही कान ह गोठमन ला परखथे।<verse eid="JOB 34:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 34:4" />सही का ए, आवव, हमन ओला समझन;</para>
  <para style="q2" vid="JOB 34:4">भलई का ए, आवव हमन ओला एक संग सीखन।<verse eid="JOB 34:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 34:5" />“काबरकि अयूब ह ये कहिथे, ‘मेंह निरदोस अंव,</para>
  <para style="q2" vid="JOB 34:5">पर परमेसर ह मोर संग नियाय नइं करत हे।<verse eid="JOB 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 34:6" />हालाकि मेंह सही अंव,</para>
  <para style="q2" vid="JOB 34:6">पर मेंह लबरा समझे जावत हंव;</para>
  <para style="q1" vid="JOB 34:6">हालाकि मेंह अपराधी नो हंव,</para>
  <para style="q2" vid="JOB 34:6">पर ओकर तीर ह मोला असाध्य घाव देवत हे।’<verse eid="JOB 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 34:7" />का कोनो अयूब कस हवय,</para>
  <para style="q2" vid="JOB 34:7">जऊन ह अपमान ला पानी कस पी जाथे?<verse eid="JOB 34:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 34:8" />ओह कुकरमीमन के संग म रहिथे;</para>
  <para style="q2" vid="JOB 34:8">ओह दुस्ट मनखेमन के संगति करथे।<verse eid="JOB 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 34:9" />काबरकि ओह कहिथे, ‘परमेसर ला खुस करे के</para>
  <para style="q2" vid="JOB 34:9">कोसिस करे म कोनो फायदा नइं ए।’<verse eid="JOB 34:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOB 34:10" />“एकरसेति, हे समझदार मनखेमन, मोर बात सुनव।</para>
  <para style="q2" vid="JOB 34:10">येह संभव नो हय कि परमेसर ह बुरई करय,</para>
  <para style="q2" vid="JOB 34:10">सर्वसक्तिमान ह गलत करय।<verse eid="JOB 34:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 34:11" />ओह हर कोनो ला ओमन के काम के मुताबिक फर देथे;</para>
  <para style="q2" vid="JOB 34:11">ओह ओमन के चालचलन के मुताबिक ओमन ले बरताव करथे।<verse eid="JOB 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 34:12" />ये सोचे घलो नइं जा सकय कि परमेसर ह गलत करही,</para>
  <para style="q2" vid="JOB 34:12">ये कि सर्वसक्तिमान ह नियाय ला बिगाड़ही।<verse eid="JOB 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 34:13" />कोन ह ओला धरती ऊपर नियुक्त करे हवय?</para>
  <para style="q2" vid="JOB 34:13">कोन ह ओला जम्मो संसार के जबाबदारी दे हवय।<verse eid="JOB 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 34:14" />कहूं येह ओकर इरादा होतिस</para>
  <para style="q2" vid="JOB 34:14">अऊ ओह अपन आतमा अऊ अपन सांस ला वापिस ले लेतिस,<verse eid="JOB 34:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 34:15" />त जम्मो मानव-जाति एक संग नास हो जातिस</para>
  <para style="q2" vid="JOB 34:15">अऊ मनखे ह फेर धुर्रा म मिल जातिस।<verse eid="JOB 34:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOB 34:16" />“कहूं तोर म समझ हवय, त सुन;</para>
  <para style="q2" vid="JOB 34:16">मेंह का कहत हंव, ओला सुन।<verse eid="JOB 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 34:17" />जऊन ह नियाय के बईरी ए, का ओह सासन कर सकथे?</para>
  <para style="q2" vid="JOB 34:17">का तेंह धरमी अऊ बलसाली ला दोसी ठहिराबे?<verse eid="JOB 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 34:18" />का येह ओ नो हय, जऊन ह राजामन ला कहिथे, ‘तुमन निकम्मा अव,’</para>
  <para style="q2" vid="JOB 34:18">अऊ परधानमन ला कहिथे, ‘तुमन दुस्ट अव,’<verse eid="JOB 34:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 34:19" />परमेसर ह राजकुमारमन के तरफदारी नइं करय</para>
  <para style="q2" vid="JOB 34:19">अऊ न ही धनवान ला गरीब ले जादा महत्व देथे,</para>
  <para style="q2" vid="JOB 34:19">काबरकि ओ जम्मो झन परमेसर के हांथ के कारीगरी अंय।<verse eid="JOB 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 34:20" />ओमन छिन भर म, आधा रथिया के मर जाथें;</para>
  <para style="q2" vid="JOB 34:20">मनखेमन कांपथें अऊ मर जाथें;</para>
  <para style="q2" vid="JOB 34:20">परतापी मनखेमन बिगर हांथ लगाय नास हो जाथें।<verse eid="JOB 34:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOB 34:21" />“परमेसर के आंखी ह मनखे के चालचलन के ऊपर लगे रहिथे;</para>
  <para style="q2" vid="JOB 34:21">ओह ओमन के पग-पग ला देखत रहिथे।<verse eid="JOB 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 34:22" />अइसे कोनो घोर अंधियार या घिटके अंधियार नइं ए,</para>
  <para style="q2" vid="JOB 34:22">जिहां दुराचारीमन लुका सकंय।<verse eid="JOB 34:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 34:23" />परमेसर बर मनखेमन ला अऊ परखना जरूरी नो हय,</para>
  <para style="q2" vid="JOB 34:23">कि ओमन नियाय बर ओकर आघू म ठाढ़ होवंय।<verse eid="JOB 34:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 34:24" />बिगर छानबीन करे ओह बलवानमन ला चूर-चूर करथे</para>
  <para style="q2" vid="JOB 34:24">अऊ ओमन के जगह म आने मनखे ला ठाढ़ कर देथे।<verse eid="JOB 34:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 34:25" />काबरकि ओह ओमन के करनी ला जानथे,</para>
  <para style="q2" vid="JOB 34:25">ओह ओमन ला रथिया फटिक देथे अऊ ओमन चकनाचूर हो जाथें।<verse eid="JOB 34:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 34:26" />ओह ओमन ला ओमन के दुस्टता के सजा उहां देथे</para>
  <para style="q2" vid="JOB 34:26">जिहां जम्मो झन ओमन ला देख सकंय,<verse eid="JOB 34:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 34:27" />काबरकि ओमन ओकर पाछू रेंगई ला छोंड़ दे हवंय</para>
  <para style="q2" vid="JOB 34:27">अऊ ओकर कोनो कानून के आदर नइं करंय।<verse eid="JOB 34:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 34:28" />ओमन के कारन गरीबमन के गोहार ह परमेसर करा हबरिस,</para>
  <para style="q2" vid="JOB 34:28">अऊ ओह जरूरतमंद मनखे के गोहार ला सुनिस।<verse eid="JOB 34:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 34:29" />पर कहूं ओह चुप रहय, त कोन ह ओला दोसी ठहिरा सकत हे?</para>
  <para style="q2" vid="JOB 34:29">कहूं ओह अपन चेहरा ला छुपाय, त कोन ह ओला देख सकत हे?</para>
  <para style="q1" vid="JOB 34:29">चाहे एक झन मनखे होवय या मनखेमन के जाति, ओह जम्मो के संग एक समान बरताव करथे,<verse eid="JOB 34:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="JOB 34:30" />ताकि भक्तिहीन मनखे ह राज झन करय</para>
  <para style="q2" vid="JOB 34:30">अऊ मनखेमन फांदा म झन फंसय।<verse eid="JOB 34:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JOB 34:31" />“मान लव, कोनो मनखे परमेसर ला कहिथे,</para>
  <para style="q2" vid="JOB 34:31">‘मेंह दोसी अंव पर अब कभू अपराध नइं करंव।<verse eid="JOB 34:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 34:32" />जऊन ला मेंह नइं देख सकंव, तेंह मोला ओ बात सिखा;</para>
  <para style="q2" vid="JOB 34:32">कहूं मेंह गलती करे हंव, त मेंह अइसे फेर नइं करंव।’<verse eid="JOB 34:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 34:33" />त का परमेसर ह तोर सर्त के मुताबिक तोला परतिफल दीही,</para>
  <para style="q2" vid="JOB 34:33">जबकि तेंह प्रायस्चित करे बर इनकार करथस?</para>
  <para style="q1" vid="JOB 34:33">तें फैसला कर, में नइं;</para>
  <para style="q2" vid="JOB 34:33">मोला बता कि तेंह का जानथस।<verse eid="JOB 34:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JOB 34:34" />“समझदार मनखेमन बताथें,</para>
  <para style="q2" vid="JOB 34:34">बुद्धिमान मनखे जऊन मन मोर सुनथें, मोला कहिथें,<verse eid="JOB 34:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 34:35" />‘अयूब ह बिगर गियान के गोठियाथे;</para>
  <para style="q2" vid="JOB 34:35">ओकर बात म समझ नइं दिखय।’<verse eid="JOB 34:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 34:36" />बने होतिस, कि अयूब ह आखिरी तक परखे जातिस</para>
  <para style="q2" vid="JOB 34:36">काबरकि ओह दुस्ट मनखे कस जबाब देथे!<verse eid="JOB 34:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 34:37" />ओह अपन पाप के संगे-संग बिदरोह घलो करथे;</para>
  <para style="q2" vid="JOB 34:37">तिरस्कार करके, ओह हमर बीच म ताली बजाथे</para>
  <para style="q2" vid="JOB 34:37">अऊ परमेसर के बिरोध म बहुंत बात कहिथे।”<verse eid="JOB 34:37" /></para>
  <chapter eid="JOB 34" />
  <chapter number="35" style="c" sid="JOB 35" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 35:1" />तब एलीहू ह ये घलो कहिस:<verse eid="JOB 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 35:2" />“का तेंह येला नियाय-संगत मानथस?</para>
  <para style="q2" vid="JOB 35:2">तेंह कहिथस, ‘मेंह सही अंव, परमेसर नइं।’<verse eid="JOB 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 35:3" />तभो ले तेंह ओकर ले पुछथस, ‘मोला येकर ले का फायदा,</para>
  <para style="q2" vid="JOB 35:3">पाप नइं करे ले मोला का मिलत हे?’<verse eid="JOB 35:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 35:4" />“मेंह तोला अऊ तोर संगीमन ला</para>
  <para style="q2" vid="JOB 35:4">जबाब देय चाहत हंव।<verse eid="JOB 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 35:5" />अकासमन कोति निहार अऊ देख;</para>
  <para style="q2" vid="JOB 35:5">बादरमन कोति निहार, जऊन मन तोर बहुंत ऊपर हवंय।<verse eid="JOB 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 35:6" />कहूं तेंह पाप करथस, त परमेसर के का बिगड़थे?</para>
  <para style="q2" vid="JOB 35:6">कहूं तोर पापमन बहुंते हवंय, त येकर ले ओला का फरक पड़थे?<verse eid="JOB 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 35:7" />कहूं तेंह धरमी अस, त तेंह ओला का देथस?</para>
  <para style="q2" vid="JOB 35:7">या ओला तोर हांथ ले का मिल जाथे?<verse eid="JOB 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 35:8" />तोर दुस्टता ह सिरिप तोर सहीं मनखेमन ऊपर,</para>
  <para style="q2" vid="JOB 35:8">अऊ तोर धरमीपन ह आने मनखेमन ऊपर असर डालथे।<verse eid="JOB 35:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JOB 35:9" />“अब्बड़ अतियाचार के कारन मनखेमन कलहरथें;</para>
  <para style="q2" vid="JOB 35:9">ओमन बलवान के बाहुबल ले छुटकारा पाय बर बिनती करथें।<verse eid="JOB 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 35:10" />पर कोनो नइं कहय, ‘मोर सिरजनहार परमेसर कहां हवय,</para>
  <para style="q2" vid="JOB 35:10">जऊन ह रथिया गीत गाय बर देथे,<verse eid="JOB 35:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 35:11" />जऊन ह हमन ला धरती के जानवरमन ले जादा सिकछा देथे</para>
  <para style="q2" vid="JOB 35:11">अऊ हमन ला अकास के चिरईमन ले जादा बुद्धिमान बनाथे।’<verse eid="JOB 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 35:12" />दुस्ट मनखेमन के घमंड के कारन</para>
  <para style="q2" vid="JOB 35:12">परमेसर जबाब नइं देवय, जब मनखेमन गोहारथें।<verse eid="JOB 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 35:13" />वास्तव म, परमेसर ह ओमन के खाली निबेदन ला नइं सुनय;</para>
  <para style="q2" vid="JOB 35:13">सर्वसक्तिमान ह ओकर कोति धियान नइं देवय।<verse eid="JOB 35:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 35:14" />त ओह तोर का सुनही</para>
  <para style="q2" vid="JOB 35:14">जब तेंह कहिथस कि मेंह ओला नइं देखत हंव,</para>
  <para style="q1" vid="JOB 35:14">जबकि तोर मामला ओकर आघू म हवय,</para>
  <para style="q2" vid="JOB 35:14">अऊ तोला ओकर बाट जोहना जरूरी अय।<verse eid="JOB 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 35:15" />अऊ देख, ओह गुस्सा होके कभू दंड नइं देवय</para>
  <para style="q2" vid="JOB 35:15">अऊ ओह दुस्टता कोति कम धियान नइं देवय।<verse eid="JOB 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 35:16" />एकरसेति अयूब ह बेकार के बात कहे बर अपन मुहूं खोलथे;</para>
  <para style="q2" vid="JOB 35:16">बिगर गियान के, ओह बहुंत गोठियाथे।”<verse eid="JOB 35:16" /></para>
  <chapter eid="JOB 35" />
  <chapter number="36" style="c" sid="JOB 36" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 36:1" />फेर एलीहू ह ये घलो कहिस:<verse eid="JOB 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 36:2" />“थोरकून अऊ धीरज धर, त मेंह तोला देखाहूं</para>
  <para style="q2" vid="JOB 36:2">कि परमेसर कोति ले अऊ घलो बहुंत अकन कहे जा सकत हे।<verse eid="JOB 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 36:3" />मेंह अपन गियान बहुंत दूरिहा ले पाथंव;</para>
  <para style="q2" vid="JOB 36:3">मेंह अपन सिरजनहार करा नियाय के बात करहूं।<verse eid="JOB 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 36:4" />खचित मोर गोठ ह लबारी नो हय;</para>
  <para style="q2" vid="JOB 36:4">तोर संग म जऊन ह हवय, ओकर करा सिद्ध गियान हवय।<verse eid="JOB 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 36:5" />“परमेसर ह सक्तिमान ए, पर ओह कोनो मनखे ला तुछ नइं जानय;</para>
  <para style="q2" vid="JOB 36:5">ओह सक्तिमान ए, अऊ अपन उदेस्य ले नइं डिगय।<verse eid="JOB 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 36:6" />ओह दुस्ट ला जीयत नइं रहन देवय</para>
  <para style="q2" vid="JOB 36:6">पर दुखी मनखेमन ला ओमन के अधिकार देथे।<verse eid="JOB 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 36:7" />ओह धरमीमन ले अपन नजर नइं हटावय;</para>
  <para style="q2" vid="JOB 36:7">ओह ओमन ला राजामन संग सिंघासन म बईठाथे</para>
  <para style="q2" vid="JOB 36:7">अऊ ओमन ला सदाकाल बर ऊंचा उठाथे।<verse eid="JOB 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 36:8" />पर कहूं मनखेमन बेड़ी म बंधाय हवंय,</para>
  <para style="q2" vid="JOB 36:8">दुख के डोरी म जोर से जकड़े हवंय,<verse eid="JOB 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 36:9" />त ओह ओमन ला बताथे कि ओमन का करे हवंय—</para>
  <para style="q2" vid="JOB 36:9">कि ओमन घमंडी होके पाप करे हवंय।<verse eid="JOB 36:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 36:10" />ओह ओमन ला सुधारे खातिर सुनाथे</para>
  <para style="q2" vid="JOB 36:10">अऊ अपन बुरई ले प्रायस्चित करे बर ओमन ला हुकूम देथे।<verse eid="JOB 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 36:11" />कहूं ओमन हुकूम मानंय अऊ ओकर सेवा करंय,</para>
  <para style="q2" vid="JOB 36:11">त ओमन के जिनगी के बाकि दिनमन उन्नति करे म</para>
  <para style="q2" vid="JOB 36:11">अऊ ओमन के जिनगी के बछरमन सुख म बीतहीं।<verse eid="JOB 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 36:12" />पर कहूं ओमन नइं सुनंय,</para>
  <para style="q2" vid="JOB 36:12">त ओमन तलवार ले नास हो जाहीं</para>
  <para style="q2" vid="JOB 36:12">अऊ बिगर गियान के मर जाहीं।<verse eid="JOB 36:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 36:13" />“भक्तिहीनमन अपन दिल म कोरोध पालथें;</para>
  <para style="q2" vid="JOB 36:13">अऊ त अऊ जब परमेसर ह ओमन ला बेड़ी म बांधथे, तभो ले ओमन मदद बर नइं गोहारंय।<verse eid="JOB 36:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 36:14" />ओमन देवालय के पुरूस बेस्यामन<note caller="+" style="f"><char style="fr" closed="false">36:14 </char><char style="ft" closed="false">धारमिक बेस्या के काम, जेला राजामन के किताब म गलत कहे गे हवय; येह कनानीमन के धारमिक काम रिहिस</char></note> के बीच</para>
  <para style="q2" vid="JOB 36:14">अपन जवानी के दिन म ही मर जाथें।<verse eid="JOB 36:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 36:15" />पर परमेसर ह दुखी मनखेमन ला ओमन के दुख ले छुड़ाथे;</para>
  <para style="q2" vid="JOB 36:15">ओह ओमन के दुख के बेरा म ओमन ले गोठियाथे।<verse eid="JOB 36:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOB 36:16" />“ओह तोला बिपत्ति के मुहूं ले निकालके</para>
  <para style="q2" vid="JOB 36:16">अइसे चाकर जगह म अमरा देवत हे जिहां कोनो बाधा नइं ए,</para>
  <para style="q2" vid="JOB 36:16">जिहां सुवादवाला जेवन तोर सुबिधा के मेज म परोसे जाथे।<verse eid="JOB 36:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 36:17" />पर अब तोला ओ दंड दिये जावत हे, जऊन ह दुस्टमन बर अय;</para>
  <para style="q2" vid="JOB 36:17">निरनय अऊ नियाय तोला पकड़ ले हवय।<verse eid="JOB 36:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 36:18" />सचेत रह कि कोनो तोला धन-संपत्ति के दुवारा झन बहकावय;</para>
  <para style="q2" vid="JOB 36:18">अऊ बहुंत घूस ह तोला डहार ले झन भटकावय।<verse eid="JOB 36:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 36:19" />का तोर जम्मो धन-संपत्ति अऊ तोर जम्मो बल</para>
  <para style="q2" vid="JOB 36:19">तोला तोर दुख ले छुटकारा दीही?<verse eid="JOB 36:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 36:20" />ओ रथिया के आसा झन कर,</para>
  <para style="q2" vid="JOB 36:20">जेमा मनखेमन ला ओमन के घर ले घसीटके निकाले जाथे।<verse eid="JOB 36:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 36:21" />सचेत रह अऊ बुरई कोति झन लहुंट,</para>
  <para style="q2" vid="JOB 36:21">जेला तेंह सायद दुख ले जादा पसंद करथस।<verse eid="JOB 36:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JOB 36:22" />“परमेसर ह अपन सामर्थ म अति महान अय।</para>
  <para style="q2" vid="JOB 36:22">ओकर सहीं गुरू कोन हवय?<verse eid="JOB 36:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 36:23" />कोन ह ओकर बर डहार ठहिराय हवय,</para>
  <para style="q2" vid="JOB 36:23">या कोन ह ओला कह सकत हे, ‘तेंह गलती करे हस’?<verse eid="JOB 36:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 36:24" />ओकर काम के परसंसा करे बर झन भुला;</para>
  <para style="q2" vid="JOB 36:24">जेकर परसंसा मनखेमन गीत म करे हवंय।<verse eid="JOB 36:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 36:25" />जम्मो मानव-जाति ह येला देखे हवय;</para>
  <para style="q2" vid="JOB 36:25">मरनहार मनखेमन येला दूरिहा ले टकटकी लगाके देखथें।<verse eid="JOB 36:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 36:26" />परमेसर ह कतेक महान ए—हमर समझ के बाहिर ए!</para>
  <para style="q2" vid="JOB 36:26">ओकर उमर के गनई ह असंभव ए।<verse eid="JOB 36:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JOB 36:27" />“ओह पानी के बूंदमन ला ऊपर खींच लेथे,</para>
  <para style="q2" vid="JOB 36:27">जऊन ह बारिस के बूंद के रूप म नदी म बहथे;<verse eid="JOB 36:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 36:28" />बादरमन अपन नमी ला खाल्हे उंडेलथें</para>
  <para style="q2" vid="JOB 36:28">अऊ मानव-जाति ऊपर बहुंत बारिस होथे।<verse eid="JOB 36:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 36:29" />कोन ह समझ सकथे कि ओह बादरमन ला कइसे बगराथे,</para>
  <para style="q2" vid="JOB 36:29">अऊ कइसे ओह अपन जगह ले बादरमन ला गरजाथे?<verse eid="JOB 36:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 36:30" />देखव, ओह कइसे चारों कोति अपन बिजली ला चमकाथे,</para>
  <para style="q2" vid="JOB 36:30">अऊ समुंदर के गहरई ला ढांप देथे।<verse eid="JOB 36:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 36:31" />ये किसम ले ओह देस-देस के मनखेमन ऊपर सासन करथे<note caller="+" style="f"><char style="fr" closed="false">36:31 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">पालथे-पोसथे</char></note></para>
  <para style="q2" vid="JOB 36:31">अऊ ओमन ला बहुंतायत ले जेवन देथे।<verse eid="JOB 36:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 36:32" />ओह बिजली ला अपन हांथ म ले लेथे</para>
  <para style="q2" vid="JOB 36:32">अऊ ओला हुकूम देथे कि सही जगह म गिरय।<verse eid="JOB 36:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 36:33" />ओकर गरजई ह अवइया आंधी के घोसना करथे;</para>
  <para style="q2" vid="JOB 36:33">अऊ त अऊ पसुमन घलो येकर आय के चिनहां बताथें।<verse eid="JOB 36:33" /></para>
  <para style="b" />
  <chapter eid="JOB 36" />
  <chapter number="37" style="c" sid="JOB 37" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 37:1" />“इही बात म मोर हिरदय ह कांपथे</para>
  <para style="q2" vid="JOB 37:1">अऊ अपन जगह ले उदकथे।<verse eid="JOB 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 37:2" />सुन! परमेसर के अवाज के गरजन,</para>
  <para style="q2" vid="JOB 37:2">ओकर मुहूं ले निकलत गड़गड़ाहट ला सुन।<verse eid="JOB 37:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 37:3" />ओह अपन बिजली ला जम्मो अकास के खाल्हे जावन देथे</para>
  <para style="q2" vid="JOB 37:3">अऊ ओला धरती के छोर तक पठोथे।<verse eid="JOB 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 37:4" />ओकर बाद ओकर गरजन के अवाज आथे;</para>
  <para style="q2" vid="JOB 37:4">ओह अपन परतापी अवाज ले गरजथे।</para>
  <para style="q1" vid="JOB 37:4">जब ओकर अवाज फेर सुनई देथे,</para>
  <para style="q2" vid="JOB 37:4">तब ओह अपन करा कुछू नइं रख छोंड़य।<verse eid="JOB 37:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 37:5" />परमेसर के अवाज ह अद्भूत रीति ले गरजथे;</para>
  <para style="q2" vid="JOB 37:5">ओह हमर समझ ले बाहिर बड़े-बड़े काम करथे।<verse eid="JOB 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 37:6" />ओह बरफ ला हुकूम देथे, ‘धरती म गिर,’</para>
  <para style="q2" vid="JOB 37:6">अऊ बारिस के पानी ला हुकूम देथे, ‘जमके बरस,’<verse eid="JOB 37:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 37:7" />ताकि हर एक मनखे, जऊन ला ओह बनाय हे, ओकर काम ला जानय,</para>
  <para style="q2" vid="JOB 37:7">ओह जम्मो मनखे ला ओमन के मेहनत करे ले रोक देथे।<verse eid="JOB 37:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 37:8" />तब बन के पसुमन अपन गुफा म खुसर जाथें;</para>
  <para style="q2" vid="JOB 37:8">ओमन अपन मांद म रहिथें।<verse eid="JOB 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 37:9" />अपन छेत्र<note caller="+" style="f"><char style="fr" closed="false">37:9 </char><char style="ft" closed="false">याने कि, दक्खिन दिग</char></note> ले आंधी,</para>
  <para style="q2" vid="JOB 37:9">अऊ तेज बहत हवा ले जाड़ा आथे।<verse eid="JOB 37:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 37:10" />परमेसर के सांस फूंके ले बरफ बनथे,</para>
  <para style="q2" vid="JOB 37:10">अऊ बगरे पानी ह जम जाथे।<verse eid="JOB 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 37:11" />ओह बादरमन ला नमी ले लादथे;</para>
  <para style="q2" vid="JOB 37:11">अऊ अपन बिजली ला ओमन के जरिये बगराथे।<verse eid="JOB 37:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 37:12" />ओकर आदेस म येमन</para>
  <para style="q2" vid="JOB 37:12">धरती के चारों कोति ऊपर एती-ओती किंदरथें</para>
  <para style="q2" vid="JOB 37:12">अऊ ओकर हुकूम के मुताबिक काम करथें।<verse eid="JOB 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 37:13" />ओह मनखेमन ला दंड देय बर बादर लानथे,</para>
  <para style="q2" vid="JOB 37:13">या धरती ऊपर पानी लानके ओह अपन मया देखाथे।<verse eid="JOB 37:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOB 37:14" />“हे अयूब, येला सुन;</para>
  <para style="q2" vid="JOB 37:14">रूक अऊ परमेसर के अद्भूत काम ऊपर बिचार कर।<verse eid="JOB 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 37:15" />का तें जानथस कि परमेसर ह कइसे बादरमन ला अपन हुकूम ले चलाथे</para>
  <para style="q2" vid="JOB 37:15">अऊ अपन बिजली चमकाथे?<verse eid="JOB 37:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 37:16" />का तेंह जानथस कि बादरमन अधर म कइसे रहिथें,</para>
  <para style="q2" vid="JOB 37:16">ओकर ये अचरज के काम के बारे म कोन ला सिद्ध गियान हवय?<verse eid="JOB 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 37:17" />जब दक्खिन के हवा के कारन भुइयां ह सांत रहिथे,</para>
  <para style="q2" vid="JOB 37:17">अऊ तेंह अपन कपड़ा के गरमी म बियाकुल रहिथस,<verse eid="JOB 37:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 37:18" />त का तेंह ओकर संग म अकास-मंडल ला तान सकत हस,</para>
  <para style="q2" vid="JOB 37:18">जऊन ह ढरूवा कांसा के दरपन सहीं कठोर होथे?<verse eid="JOB 37:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOB 37:19" />“हमन ला बता कि हमन ओला का कहिबो;</para>
  <para style="q2" vid="JOB 37:19">हमर अंधियार के कारन, हमन अपन मामला नइं रख सकन।<verse eid="JOB 37:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 37:20" />का ओला बताय जावय कि मेंह गोठियाय चाहत हंव?</para>
  <para style="q2" vid="JOB 37:20">का कोनो मनखे चाहथे कि ओला लील डारे जावय?<verse eid="JOB 37:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 37:21" />अभी तो सूरज कोति कोनो नइं देख सकंय,</para>
  <para style="q2" vid="JOB 37:21">काबरकि हवा ह अकास ला साफ कर दे हे,</para>
  <para style="q2" vid="JOB 37:21">अऊ सूरज ह तेज चमकत हे।<verse eid="JOB 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 37:22" />उत्तर कोति ले ओह सोन कस चमकत आथे;</para>
  <para style="q2" vid="JOB 37:22">परमेसर ह अद्भूत महिमा म आथे।<verse eid="JOB 37:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 37:23" />सर्वसक्तिमान ह हमर पहुंच के बाहिर ए अऊ बहुंत सामर्थी ए;</para>
  <para style="q2" vid="JOB 37:23">अपन नियाय अऊ बड़े धरमीपन म, ओह अतियाचार नइं करय।<verse eid="JOB 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 37:24" />एकरसेति, मनखेमन ओकर आदर करंय,</para>
  <para style="q2" vid="JOB 37:24">काबरकि ओह जम्मो बुद्धिमान मनखेमन के आदर करथे।<note caller="+" style="f"><char style="fr" closed="false">37:24 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">काबरकि ओह ओमन के आदर नइं करय, जऊन मन अपनआप ला बुद्धिमान समझथें।</char></note>”<verse eid="JOB 37:24" /></para>
  <chapter eid="JOB 37" />
  <chapter number="38" style="c" sid="JOB 38" />
  <para style="s1">यहोवा ह गोठियाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 38:1" />तब यहोवा ह अयूब ला गरेर म ले गोठियाईस। ओह कहिस:<verse eid="JOB 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 38:2" />“येह कोन ए जऊन ह अगियानता के बात करके</para>
  <para style="q2" vid="JOB 38:2">मोर युक्ति ला बिगाड़े चाहत हे?<verse eid="JOB 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 38:3" />एक आदमी सहीं अपन कनिहां कस ले;</para>
  <para style="q2" vid="JOB 38:3">मेंह तोर ले सवाल पुछहूं,</para>
  <para style="q2" vid="JOB 38:3">अऊ तेंह मोला जबाब देबे।<verse eid="JOB 38:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 38:4" />“जब मेंह धरती के नीव डारेंव, त तेंह कहां रहय?</para>
  <para style="q2" vid="JOB 38:4">कहूं तेंह समझत हस, त मोला बता।<verse eid="JOB 38:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 38:5" />कोन ह येकर बिस्तार करिस? खचित तेंह जानत हस!</para>
  <para style="q2" vid="JOB 38:5">कोन ह येकर ऊपर नापे के लाईन धरिस?<verse eid="JOB 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 38:6" />येकर नीव काकर ऊपर रखे गीस,</para>
  <para style="q2" vid="JOB 38:6">या कोन ह येकर कोना के पथरा ला मढ़ाईस—<verse eid="JOB 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 38:7" />जब बिहनियां के तारामन एक संग गाईन</para>
  <para style="q2" vid="JOB 38:7">अऊ जम्मो स्वरगदूतमन आनंद के मारे चिचियाईन?<verse eid="JOB 38:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 38:8" />“कोन ह कपाटमन के पाछू समुंदर ला रोकिस</para>
  <para style="q2" vid="JOB 38:8">जब येह अइसे फूटके निकलिस, मानो ओह गरभ ले फूट निकले हे,<verse eid="JOB 38:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 38:9" />जब मेंह बादर ला ओकर ओनहा बनांय</para>
  <para style="q2" vid="JOB 38:9">अऊ येला घिटके अंधियार म लपेटें,<verse eid="JOB 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 38:10" />जब मेंह येकर सीमना ठहिरांय</para>
  <para style="q2" vid="JOB 38:10">अऊ येकर कपाट अऊ बाड़ा ठहिरांय,<verse eid="JOB 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 38:11" />जब मेंह समुंदर ला कहेंव, ‘तेंह इहां तक आ सकत हस अऊ आगे नइं;</para>
  <para style="q2" vid="JOB 38:11">येह ओ जगह ए, जिहां तोर उमड़इया लहरामन रूक जावंय’?<verse eid="JOB 38:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 38:12" />“का तेंह कभू बिहनियां ला हुकूम देय हवस,</para>
  <para style="q2" vid="JOB 38:12">या बिहान होय ला अपन जगह देखाय हवस,<verse eid="JOB 38:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 38:13" />कि येह धरती के छोर ला अपन बस म करय</para>
  <para style="q2" vid="JOB 38:13">अऊ दुस्ट मनखेमन ला येमा ले झर्रा देवय?<verse eid="JOB 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 38:14" />धरती ह अइसे आकार लेथे जइसे मुहर के खाल्हे के चिक्कन माटी के आकार बदलथे;</para>
  <para style="q2" vid="JOB 38:14">येकर रूप ह पोसाक के सहीं दिखे लगथे।<verse eid="JOB 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 38:15" />दुस्टमन ला ओमन के अंजोर ले रोक लिये जाथे,</para>
  <para style="q2" vid="JOB 38:15">अऊ ओमन के उठे बाहां ला टोर दिये जाथे।<verse eid="JOB 38:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOB 38:16" />“का तेंह कभू समुंदर के सोतमन करा हबरे हवस</para>
  <para style="q2" vid="JOB 38:16">या गहिरा समुंदर के पेंदी म कभू रेंगे-बुले हवस?<verse eid="JOB 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 38:17" />का मिरतू के कपाट ला तोला देखाय गे हवय?</para>
  <para style="q2" vid="JOB 38:17">का तेंह घिटके अंधियार के कपाटमन ला देखे हस?<verse eid="JOB 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 38:18" />का तेंह धरती के बिस्तार ला समझे हस?</para>
  <para style="q2" vid="JOB 38:18">कहूं तेंह ये जम्मो ला जानथस, त मोला बता।<verse eid="JOB 38:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOB 38:19" />“अंजोर के निवास के रसता का ए?</para>
  <para style="q2" vid="JOB 38:19">अऊ अंधियार ह कहां रहिथे?<verse eid="JOB 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 38:20" />का तेंह ओमन ला ओमन के जगह म ले जा सकबे?</para>
  <para style="q2" vid="JOB 38:20">का तेंह ओमन के निवास के रसता ला जानथस?<verse eid="JOB 38:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 38:21" />तेंह तो जरूर जानथस, काबरकि पहिली ही तोर जनम हो गे रिहिस!</para>
  <para style="q2" vid="JOB 38:21">तेंह बहुंत साल तक जीये हस!<verse eid="JOB 38:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JOB 38:22" />“का तेंह बरफ के भंडारघरमन म खुसरे हवस</para>
  <para style="q2" vid="JOB 38:22">या ओला के भंडारघरमन ला देखे हवस,<verse eid="JOB 38:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 38:23" />जऊन मन ला मेंह संकट के समय बर,</para>
  <para style="q2" vid="JOB 38:23">याने युद्ध अऊ लड़ई बर रखे हवंव?<verse eid="JOB 38:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 38:24" />ओ जगह के रसता का ए, जिहां ले अंजोर ला बगराय जाथे,</para>
  <para style="q2" vid="JOB 38:24">या ओ जगह कहां हवय, जिहां ले धरती ऊपर पुरवई हवा ह बहथे?<verse eid="JOB 38:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 38:25" />कोन ह भारी बारिस बर नरवा खनथे,</para>
  <para style="q2" vid="JOB 38:25">अऊ कोन ह बादर के गरजन बर रद्दा बनाथे;<verse eid="JOB 38:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 38:26" />ताकि निरजन भुइयां म,</para>
  <para style="q2" vid="JOB 38:26">मरू-भुइयां म, जिहां कोनो नइं रहंय, उहां पानी जा सकय,<verse eid="JOB 38:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 38:27" />जेकर ले उजरे अऊ बंजर भुइयां के पीयास बुझय</para>
  <para style="q2" vid="JOB 38:27">अऊ कांदी ह जामय?<verse eid="JOB 38:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 38:28" />का बरसा के कोनो ददा हवय?</para>
  <para style="q2" vid="JOB 38:28">ओस के बूंदी ला कोन ह पईदा करथे?<verse eid="JOB 38:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 38:29" />काकर गरभ ले बरफ ह निकलथे?</para>
  <para style="q2" vid="JOB 38:29">कोन ह अकास ले गिरे ओस ला जमाथे<verse eid="JOB 38:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 38:30" />जब पानी ह पथरा कस कठोर हो जाथे,</para>
  <para style="q2" vid="JOB 38:30">जब गहिरा पानी के सतह ह जम जाथे?<verse eid="JOB 38:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JOB 38:31" />“का तेंह नछत्र के समूह<note caller="+" style="f"><char style="fr" closed="false">38:31 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">सुघरता</char></note> ला जंजीर म बांध सकथस?</para>
  <para style="q2" vid="JOB 38:31">का तेंह मिरगासिरा<note caller="+" style="f"><char style="fr" closed="false">38:31 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अकास के मांझा म तारामन के समूह</char></note> के बंधना ला खोल सकथस?<verse eid="JOB 38:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 38:32" />का तेंह तारा मंडल ला ओमन के ठहिराय समय<note caller="+" style="f"><char style="fr" closed="false">38:32 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बिहनियां के तारा ला ओकर समय म</char></note> म परगट कर सकथस?</para>
  <para style="q2" vid="JOB 38:32">या का तेंह सपतरसी ला ओकर लइकामन संग ले जा सकथस?<verse eid="JOB 38:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 38:33" />का तेंह अकासमन के कानून ला जानथस?</para>
  <para style="q2" vid="JOB 38:33">का तेंह धरती म परमेसर के सासन लागू कर सकथस?<verse eid="JOB 38:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JOB 38:34" />“का तेंह बादरमन ला हुकूम दे सकथस</para>
  <para style="q2" vid="JOB 38:34">कि बहुंत बारिस होवय अऊ तोला छुपा लेवय<verse eid="JOB 38:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 38:35" />का तेंह बिजली ला गिरे के हुकूम दे सकथस?</para>
  <para style="q2" vid="JOB 38:35">का ओमन तोर करा आके कहिथें, ‘हमन इहां हवन’?<verse eid="JOB 38:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 38:36" />कोन ह सारस चिरई ला बुद्धि देथे</para>
  <para style="q2" vid="JOB 38:36">या कोन ह कुकरा ला समझे के सक्ति देथे?<verse eid="JOB 38:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 38:37" />बादरमन ला गने के बुद्धि काकर करा हवय?</para>
  <para style="q2" vid="JOB 38:37">कोन ह अकास के पानी के घघरी ला उलद सकत हे,<verse eid="JOB 38:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JOB 38:38" />जब धुर्रा ह कठोर हो जाथे</para>
  <para style="q2" vid="JOB 38:38">अऊ धरती के ढेलामन एक संग संट जाथें?<verse eid="JOB 38:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="JOB 38:39" />“का तेंह सिंहनी बर सिकार करके लानथस</para>
  <para style="q2" vid="JOB 38:39">अऊ सिंहमन के भूख ला मिटाथस<verse eid="JOB 38:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JOB 38:40" />जब ओमन अपन मांद म बईठे रहिथें</para>
  <para style="q2" vid="JOB 38:40">या झाड़ीमन के बीच म लेटके घात लगाय रहिथें?<verse eid="JOB 38:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="JOB 38:41" />कोन ह कऊआ ला भोजन देथे</para>
  <para style="q2" vid="JOB 38:41">जब ओकर पीलामन परमेसर ले गोहारथें</para>
  <para style="q2" vid="JOB 38:41">अऊ भोजन के खोज म भटकत रहिथें?<verse eid="JOB 38:41" /></para>
  <para style="b" />
  <chapter eid="JOB 38" />
  <chapter number="39" style="c" sid="JOB 39" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 39:1" />“का तेंह जानथस कि पहाड़ के जंगली छेरीमन कब पीला देथें?</para>
  <para style="q2" vid="JOB 39:1">का तेंह देखथस कि हिरनी ह कब पीला देथे?<verse eid="JOB 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 39:2" />का तेंह ओमन के गरभ धारन करे के महिनामन ला गनथस?</para>
  <para style="q2" vid="JOB 39:2">का तेंह ओमन के जनम देय के समय ला जानथस?<verse eid="JOB 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 39:3" />ओमन निहरके अपन पीला ला जनमथें;</para>
  <para style="q2" vid="JOB 39:3">अऊ ओमन के लइका जनमे के पीरा ह खतम हो जाथे।<verse eid="JOB 39:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 39:4" />ओमन के पीलामन जंगल म बाढ़थें अऊ मजबूत होवत जाथें;</para>
  <para style="q2" vid="JOB 39:4">ओमन चल देथें अऊ फेर लहुंटके नइं आवंय।<verse eid="JOB 39:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOB 39:5" />“कोन ह जंगली गदहामन ला खुला छोंड़ देथे?</para>
  <para style="q2" vid="JOB 39:5">कोन ह ओमन के बंधना ला खोल दीस?<verse eid="JOB 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 39:6" />ओमन ला मेंह ओमन के घर बर सुन्ना जगह,</para>
  <para style="q2" vid="JOB 39:6">अऊ ओमन के निवास बर नूनचूर ऊसर भुइयां देय हवंव।<verse eid="JOB 39:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 39:7" />ओमन तो सहर के कोलाहल ऊपर हांसथें;</para>
  <para style="q2" vid="JOB 39:7">ओमन गदहा खेदइया के हांका ला नइं सुनंय।<verse eid="JOB 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 39:8" />ओमन अपन चारा बर पहाड़मन म किंदरथें</para>
  <para style="q2" vid="JOB 39:8">अऊ हरियर-हरियर चारा खोजत रहिथें।<verse eid="JOB 39:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JOB 39:9" />“का जंगली बईला ह तोर सेवा करे बर सहमती दीही?</para>
  <para style="q2" vid="JOB 39:9">का ओह तोर कोटना के तीर म रात बिताही?<verse eid="JOB 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 39:10" />का तेंह जंगली बईला ला डोरी ले बांधके नांगर जोत सकथस?</para>
  <para style="q2" vid="JOB 39:10">का ओह तोर पाछू घाटी म पाटा ला खींचही?<verse eid="JOB 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 39:11" />का तेंह ओकर बड़े बल के सेति ओकर ऊपर भरोसा करबे?</para>
  <para style="q2" vid="JOB 39:11">का तेंह अपन मेहनत के काम ला ओकर ऊपर छोंड़ देबे?<verse eid="JOB 39:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 39:12" />का तेंह ओकर ऊपर भरोसा करबे कि ओह तोर अनाज ला लानय</para>
  <para style="q2" vid="JOB 39:12">अऊ लानके तोर कोठार म रखय?<verse eid="JOB 39:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOB 39:13" />“सुतुरमुर्ग ह अपन डेनामन ला आनंद म फड़फड़ाथे,</para>
  <para style="q2" vid="JOB 39:13">हालाकि ओमन के तुलना</para>
  <para style="q2" vid="JOB 39:13">सारस के डेना अऊ पांखीमन ले नइं करे जा सकय।<verse eid="JOB 39:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 39:14" />सुतुरमुर्ग ह तो अपन अंडा भुइयां म देथे</para>
  <para style="q2" vid="JOB 39:14">अऊ ओमन ला धुर्रा के गरमी ह सेथे,<verse eid="JOB 39:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 39:15" />ओला धियान नइं रहय कि ओमन काकरो गोड़ ले कुचरे जा सकथें,</para>
  <para style="q2" vid="JOB 39:15">या कोनो जंगली पसु ओमन ला कुचर सकथे।<verse eid="JOB 39:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 39:16" />ओह अपन पीलामन ले कठोर बरताव करथे, मानो कि ओमन ओकर पीला नो हंय;</para>
  <para style="q2" vid="JOB 39:16">ओह फिकर नइं करय कि ओकर मेहनत ह बेकार रिहिस,<verse eid="JOB 39:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 39:17" />काबरकि परमेसर ह ओला बुद्धि नइं देय हवय</para>
  <para style="q2" vid="JOB 39:17">या ओला बने समझ नइं देय हवय।<verse eid="JOB 39:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 39:18" />तभो ले जब ओह दऊड़े बर अपन डेना ला बगराथे,</para>
  <para style="q2" vid="JOB 39:18">त ओह घोड़ा अऊ ओकर सवारी करइया ऊपर हांसथे।<verse eid="JOB 39:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOB 39:19" />“का तेंह घोड़ा ला ओकर बल देथस</para>
  <para style="q2" vid="JOB 39:19">या का तेंह ओकर घेंच म उड़त लम्बा बाल पहिराय हस?<verse eid="JOB 39:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 39:20" />का तेंह ओला फांफा कस उचके के बल देथस,</para>
  <para style="q2" vid="JOB 39:20">जेकर फुंफकारे के अवाज ह आतंक फईला देथे?<verse eid="JOB 39:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 39:21" />ओह अपन बल ऊपर आनंद मनात, अपन खुर ले भुइयां ला खुरचथे,</para>
  <para style="q2" vid="JOB 39:21">अऊ लड़ई के सामना करथे।<verse eid="JOB 39:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 39:22" />ओह बिगर कोनो भय के, डर के ऊपर हंसथे;</para>
  <para style="q2" vid="JOB 39:22">ओह तलवार ला देखके पाछू नइं घुंचय।<verse eid="JOB 39:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 39:23" />तरकस ह अपन किनारा के बिरूध</para>
  <para style="q2" vid="JOB 39:23">चमकत बरछी अऊ भाला के संग खड़खड़ाथे।<verse eid="JOB 39:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 39:24" />उत्तेजित होके रिस के मारे, ओह भुइयां ला छेदथे;</para>
  <para style="q2" vid="JOB 39:24">अऊ तुरही के अवाज सुनके ओह सीधा ठाढ़ नइं होवय।<verse eid="JOB 39:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 39:25" />तुरही के अवाज म ओह हिनहिनाथे, ‘अहा!’</para>
  <para style="q2" vid="JOB 39:25">ओह दूरिहाच ले लड़ई के गंध ला सुंघ लेथे,</para>
  <para style="q2" vid="JOB 39:25">अऊ सेनापतिमन के ललकार अऊ लड़ई के गरजन ला सुन लेथे।<verse eid="JOB 39:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="JOB 39:26" />“का बाज चिरई ह तोर बुद्धि के दुवारा उड़थे</para>
  <para style="q2" vid="JOB 39:26">अऊ दक्खिन कोति उड़े बर अपन डेनामन ला बगराथे?<verse eid="JOB 39:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 39:27" />का गिधवा ह तोर हुकूम ले बहुंत ऊपर म उड़थे</para>
  <para style="q2" vid="JOB 39:27">अऊ अपन खोंधरा ला ऊंच जगह म बनाथे?<verse eid="JOB 39:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 39:28" />ओह निकले चट्टान के चोटी म रहिथे अऊ उहां रात बिताथे;</para>
  <para style="q2" vid="JOB 39:28">खड़े चट्टान ह ओकर घर अय।<verse eid="JOB 39:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 39:29" />उहां ले ओह अपन जेवन के ताक म रहिथे;</para>
  <para style="q2" vid="JOB 39:29">ओकर आंखी ह दूरिहा ले ही ओला देख लेथे।<verse eid="JOB 39:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 39:30" />ओकर पीलामन खून ला मजा लेके पीथें,</para>
  <para style="q2" vid="JOB 39:30">अऊ जिहां लास रहिथे, उहां ओह घलो होथे।”<verse eid="JOB 39:30" /></para>
  <chapter eid="JOB 39" />
  <chapter number="40" style="c" sid="JOB 40" />
  <para style="p">
    <verse number="1" style="v" sid="JOB 40:1" />यहोवा ह अयूब ला कहिस:<verse eid="JOB 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 40:2" />“जऊन ह सर्वसक्तिमान ऊपर दोस लगाथे, का ओह ओकर संग बहस करही?</para>
  <para style="q2" vid="JOB 40:2">जऊन ह परमेसर ऊपर दोस लगाथे, ओह ओला जबाब देवय!”<verse eid="JOB 40:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOB 40:3" />तब अयूब ह यहोवा ला जबाब दीस:<verse eid="JOB 40:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 40:4" />“मेंह तो तुछ मनखे अंव—मेंह तोला कइसे जबाब दे सकत हंव?</para>
  <para style="q2" vid="JOB 40:4">मेंह अपन मुहूं ऊपर अपन हांथ रख लेथंव।<verse eid="JOB 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 40:5" />एक बार मेंह गोठिया डारेंव, पर मोर करा जबाब नइं ए—</para>
  <para style="q2" vid="JOB 40:5">हव, दू बार घलो, पर अब मेंह नइं कहंव।”<verse eid="JOB 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 40:6" />तब यहोवा ह अयूब ला गरेर म ले गोठियाईस:<verse eid="JOB 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 40:7" />“एक आदमी कस अपन कनिहां कस ले;</para>
  <para style="q2" vid="JOB 40:7">मेंह तोर ले सवाल पुछहूं,</para>
  <para style="q2" vid="JOB 40:7">अऊ तेंह मोला जबाब देबे।<verse eid="JOB 40:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOB 40:8" />“का तेंह मोर नियाय ला बेकार ठहिराबे?</para>
  <para style="q2" vid="JOB 40:8">का तेंह अपनआप ला सही ठहिराय बर मोला दोस देबे?<verse eid="JOB 40:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 40:9" />का तोर करा परमेसर के सहीं भुजबल हवय,</para>
  <para style="q2" vid="JOB 40:9">अऊ का तेंह ओकर कस अवाज म गरज सकथस?<verse eid="JOB 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 40:10" />तब तेंह अपनआप ला महिमा अऊ परताप ले संवार ले,</para>
  <para style="q2" vid="JOB 40:10">अऊ अपनआप ला आदर अऊ गौरव के ओनहा पहिरा ले।<verse eid="JOB 40:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 40:11" />अपन उफनत रिस ला छोंड़ दे,</para>
  <para style="q2" vid="JOB 40:11">अऊ जऊन मन घमंडी अंय, ओमन ला देख अऊ ओमन ला झुकवा दे,<verse eid="JOB 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 40:12" />जऊन मन घमंडी अंय, ओमन ला देख अऊ ओमन ला नम्र बना,</para>
  <para style="q2" vid="JOB 40:12">दुस्टमन जिहां ठाढ़ होथें, उहां ओमन ला कुचर दे।<verse eid="JOB 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 40:13" />ओ जम्मो झन ला एके संग माटी म गाड़ दे;</para>
  <para style="q2" vid="JOB 40:13">अऊ कबर म ओमन के मुहूं ऊपर कफन ओढ़ा दे।<verse eid="JOB 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 40:14" />तब मेंह खुद मान लूहूं</para>
  <para style="q2" vid="JOB 40:14">कि तोरेच जेवनी हांथ ह तोला बचा सकत हे।<verse eid="JOB 40:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOB 40:15" />“जलहाथी<note caller="+" style="f"><char style="fr" closed="false">40:15 </char><char style="fq" closed="false">जलहाथी </char><char style="ft" closed="false">के मतलब एक </char><char style="fqa" closed="false">बड़े जन्तु </char><char style="ft" closed="false">जऊन ह पानी के लकठा म रहिथे, जइसे कि दरियाई घोड़ा</char></note> ला देख,</para>
  <para style="q2" vid="JOB 40:15">जेला मेंह तोर संग बनाय हवंव</para>
  <para style="q2" vid="JOB 40:15">अऊ जऊन ह बईला के सहीं कांदी खाथे।<verse eid="JOB 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 40:16" />ओकर कनिहां म कतेक बल होथे,</para>
  <para style="q2" vid="JOB 40:16">अऊ ओकर पेट के मांस-पेसी म कतेक सक्ति होथे!<verse eid="JOB 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 40:17" />ओकर पुंछी ह देवदार रूख कस झुमथे;</para>
  <para style="q2" vid="JOB 40:17">ओकर जांघ के नसमन एक-दूसर ले गुंथाय रहिथें।<verse eid="JOB 40:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 40:18" />ओकर हाड़ामन कांस के नलीमन कस अंय,</para>
  <para style="q2" vid="JOB 40:18">अऊ ओकर अंगमन लोहा के छड़ कस अंय।<verse eid="JOB 40:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 40:19" />परमेसर के रचना म ओह पहिला जगह पाथे,</para>
  <para style="q2" vid="JOB 40:19">तभो ले ओकर सिरजनहार ह ओकर करा तलवार लेके आ सकत हे।<verse eid="JOB 40:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 40:20" />पठारमन ले ओकर बर चारा मिलथे,</para>
  <para style="q2" vid="JOB 40:20">अऊ बन के जम्मो पसु ओकर लकठा म खेलथें।<verse eid="JOB 40:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 40:21" />ओह कमल फूल के नार के तरी म लेटथे,</para>
  <para style="q2" vid="JOB 40:21">चीखला म कांदी के बीच ओह छुपे रहिथे।<verse eid="JOB 40:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 40:22" />कमल फूल के नारमन ओला अपन छइहां म छुपाथें,</para>
  <para style="q2" vid="JOB 40:22">अऊ चिनार रूखमन नरवा के तीर म ओला घेरे रहिथें।<verse eid="JOB 40:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 40:23" />नदी म घुमड़त बाढ़ आय ले घलो ओह नइं घबरावय;</para>
  <para style="q2" vid="JOB 40:23">चाहे यरदन नदी के पानी ह ओकर मुहूं तक चघ जावय, तभो ले ओह सुरकछित रहिथे।<verse eid="JOB 40:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 40:24" />का कोनो ओला पकड़ सकथे जब ओह जागत रहिथे,</para>
  <para style="q2" vid="JOB 40:24">या फांदा म फंसाके ओकर नाक ला छेद सकथे?<verse eid="JOB 40:24" /></para>
  <para style="b" />
  <chapter eid="JOB 40" />
  <chapter number="41" style="c" sid="JOB 41" />
  <para style="q1">
    <verse number="1" style="v" sid="JOB 41:1" />“का तेंह लिबयातान<note caller="+" style="f"><char style="fr" closed="false">41:1 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="JOB 3:8">3:8</ref></char> ला</char></note> ला मछरी धरे के गरी ले तीरके निकाल सकथस</para>
  <para style="q2" vid="JOB 41:1">या डोरी ले ओकर जीभ ला बांध सकत हस।<verse eid="JOB 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 41:2" />का तेंह ओकर नाक म नत्थी लगा सकथस</para>
  <para style="q2" vid="JOB 41:2">या ओकर जबड़ा ला लोहा के कांटा ले छेद सकथस?<verse eid="JOB 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 41:3" />का ओह तोर ले दया के भीख मांगही?</para>
  <para style="q2" vid="JOB 41:3">का ओह तोर ले गुरतूर बोली बोलही?<verse eid="JOB 41:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 41:4" />का ओह तोर ले करार करही</para>
  <para style="q2" vid="JOB 41:4">कि तेंह ओला जिनगी भर अपन गुलाम बना ले?<verse eid="JOB 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 41:5" />का तेंह ओला कोनो चिरई के सहीं पालतू बना सकथस</para>
  <para style="q2" vid="JOB 41:5">या अपन घर म जवान माईलोगनमन के खेले बर ओमा पट्टा बांधके रख सकबे?<verse eid="JOB 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 41:6" />का बेपारीमन ओकर बर मोलभाव करहीं?</para>
  <para style="q2" vid="JOB 41:6">का ओमन ओला बेपारीमन के बीच म बांट दीहीं?<verse eid="JOB 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 41:7" />का तेंह ओकर खाल ला भाला ले,</para>
  <para style="q2" vid="JOB 41:7">या ओकर मुड़ ला मछरी मारे के बरछी ले भर सकथस?<verse eid="JOB 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 41:8" />यदि तेंह ओकर ऊपर अपन हांथ रखथस,</para>
  <para style="q2" vid="JOB 41:8">त तोला ओकर संग लड़े के सुरता आही अऊ तेंह अइसने फेर कभू नइं करबे!<verse eid="JOB 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 41:9" />ये बेकार के आसा ए कि तेंह ओला अपन अधिकार म रखबे;</para>
  <para style="q2" vid="JOB 41:9">तेंह ओकर आघू म आवत ही हार जाबे।<verse eid="JOB 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 41:10" />काकरो हिम्मत नइं ए कि ओला भड़कावंय।</para>
  <para style="q2" vid="JOB 41:10">त फेर कोन ह मोर सामना कर सकथे?<verse eid="JOB 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 41:11" />कोन ह मोला देय हवय कि मेंह ओला लहुंटावंव?</para>
  <para style="q2" vid="JOB 41:11">स्वरग के खाल्हे के जम्मो चीज मोर अय।<verse eid="JOB 41:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOB 41:12" />“मेंह लिबयातान के अंग, ओकर बल</para>
  <para style="q2" vid="JOB 41:12">अऊ ओकर सोभायमान रूप के बारे म बताय बर चुप नइं रहंव।<verse eid="JOB 41:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 41:13" />कोन ह ओकर बाहिर के आवरन ला उतार सकत हे?</para>
  <para style="q2" vid="JOB 41:13">कोन ह ओकर दोहरा कवच ला भेद सकथे?<verse eid="JOB 41:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 41:14" />कोन ह ओकर मुहूं ला खोले के हिम्मत कर सकथे?</para>
  <para style="q2" vid="JOB 41:14">जेकर भयानक दांतमन एक-दूसर ले जुड़े रहिथें।<verse eid="JOB 41:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 41:15" />ओकर पीठ म तह के तह ढालमन हवंय,</para>
  <para style="q2" vid="JOB 41:15">जऊन म मजबूती से एक संग मुहर लगे हवय;<verse eid="JOB 41:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 41:16" />ओमन एक-दूसर ले अइसे संटे हवंय</para>
  <para style="q2" vid="JOB 41:16">कि ओमन के बीच म ले हवा घलो नइं निकल सकय।<verse eid="JOB 41:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 41:17" />ओमन एक-दूसर ले मजबूती ले जुड़े हवंय;</para>
  <para style="q2" vid="JOB 41:17">ओमन एक-दूसर ले लिपटे हवंय अऊ ओमन ला अलग नइं करे जा सकय।<verse eid="JOB 41:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 41:18" />ओकर छींक ले अंजोर चमकथे;</para>
  <para style="q2" vid="JOB 41:18">ओकर आंखीमन बिहनियां के किरन कस अंय।<verse eid="JOB 41:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 41:19" />ओकर मुहूं ले बरत जुवाला निकलथे;</para>
  <para style="q2" vid="JOB 41:19">अऊ आगी के चिनगारी निकलथे।<verse eid="JOB 41:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 41:20" />ओकर नाक के छेदा ले धुआं निकलथे</para>
  <para style="q2" vid="JOB 41:20">जइसे बरत सरकंडामन ऊपर रखे उबलत बरतन ले निकलथे।<verse eid="JOB 41:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 41:21" />ओकर सांस ले कोइला ह बरथे,</para>
  <para style="q2" vid="JOB 41:21">अऊ ओकर मुहूं ले आगी के जुवाला निकलथे।<verse eid="JOB 41:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 41:22" />ओकर घेंच म ताकत रहिथे;</para>
  <para style="q2" vid="JOB 41:22">अऊ डर ह ओकर आघू-आघू जाथे।<verse eid="JOB 41:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 41:23" />ओकर मांस-पेसी के परतमन कसके जूरे हवंय;</para>
  <para style="q2" vid="JOB 41:23">ओमन मजबूत हवंय अऊ डोलंय नइं।<verse eid="JOB 41:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 41:24" />ओकर छाती ह पथरा कस कठोर हवय,</para>
  <para style="q2" vid="JOB 41:24">जांता के तरी के कुटा कस कठोर हवय।<verse eid="JOB 41:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 41:25" />जब ओह ठाढ़ होथे, त बलवालामन घलो डरा जाथें;</para>
  <para style="q2" vid="JOB 41:25">येकर मारे-कुटे के पहिले, ओमन पाछू हट जाथें।<verse eid="JOB 41:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 41:26" />ओकर ऊपर तलवार चलाय ले घलो ओला कुछू नइं होवय,</para>
  <para style="q2" vid="JOB 41:26">अऊ न ही भाला या बान या बरछी के परभाव पड़य।<verse eid="JOB 41:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 41:27" />ओह लोहा ला पैंरा सहीं</para>
  <para style="q2" vid="JOB 41:27">अऊ कांसा ला सरे लकरी सहीं जानथे।<verse eid="JOB 41:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 41:28" />बान ह ओला भगाय नइं सकय;</para>
  <para style="q2" vid="JOB 41:28">गुलेल के पथरा ह ओकर बर भूंसा सहीं अय।<verse eid="JOB 41:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 41:29" />लउठी घलो ओला पैंरा सहीं लगथे;</para>
  <para style="q2" vid="JOB 41:29">ओह बरछी के अवाज ऊपर हांसथे।<verse eid="JOB 41:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 41:30" />ओकर खाल्हे के भाग ह माटी के फटे बरतन के धार सहीं अय,</para>
  <para style="q2" vid="JOB 41:30">जऊन ह चीखला म अनाज कुटे के पट्टा सहीं चिनहां छोंड़थे।<verse eid="JOB 41:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 41:31" />ओह समुंदर के पानी ला खउलत हांड़ी के सहीं मथथे</para>
  <para style="q2" vid="JOB 41:31">अऊ समुंदर ला मलहम के बरतन सहीं हलाथे।<verse eid="JOB 41:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 41:32" />ओह अपन पाछू म एक चमकीला धारी छोंड़त जाथे;</para>
  <para style="q2" vid="JOB 41:32">मानो गहिरा पानी के सफेद बाल हवय।<verse eid="JOB 41:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 41:33" />धरती म ओकर बरोबर कोनो चीज नइं ए—</para>
  <para style="q2" vid="JOB 41:33">एक जीव जेला काकरो डर नइं ए।<verse eid="JOB 41:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 41:34" />ओह हर एक अभिमानी ला नीचा देखथे;</para>
  <para style="q2" vid="JOB 41:34">जम्मो घमंड करइयामन ऊपर ओह राजा अय।”<verse eid="JOB 41:34" /></para>
  <chapter eid="JOB 41" />
  <chapter number="42" style="c" sid="JOB 42" />
  <para style="s1">अयूब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 42:1" />तब अयूब ह यहोवा ला जबाब दीस:<verse eid="JOB 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 42:2" />“में जानत हंव कि तेंह जम्मो कुछू कर सकथस;</para>
  <para style="q2" vid="JOB 42:2">तोर कोनो योजना म बाधा नइं डाले जा सकय।<verse eid="JOB 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 42:3" />तेंह पुछय, ‘ये कोन ए, जऊन ह बिगर गियान के मोर योजना म परदा डालत हवय?’</para>
  <para style="q2" vid="JOB 42:3">सही म मेंह ओ चीजमन के बारे म गोठियांय, जेला मेंह नइं समझत रहेंव,</para>
  <para style="q2" vid="JOB 42:3">मोर जाने बर ओमन बहुंत अद्भूत चीजमन रिहिन।<verse eid="JOB 42:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOB 42:4" />“तेंह कहय, ‘अब सुन, मेंह गोठियाहूं;</para>
  <para style="q2" vid="JOB 42:4">मेंह तोर ले सवाल करहूं,</para>
  <para style="q2" vid="JOB 42:4">अऊ तेंह मोला जबाब देबे।’<verse eid="JOB 42:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 42:5" />मोर कानमन तोर बात ला सुने हवंय</para>
  <para style="q2" vid="JOB 42:5">पर अब मोर आंखीमन तोला देख डारिन।<verse eid="JOB 42:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 42:6" />एकरसेति मेंह अपनआप ला तुछ समझत हंव</para>
  <para style="q2" vid="JOB 42:6">अऊ धुर्रा अऊ राख म प्रायस्चित करत हंव।”<note caller="+" style="f"><char style="fr" closed="false">42:6 </char><char style="ft" closed="false">अपन दुख ला बताय बर मनखेमन अपन मुड़ ऊपर धुर्रा अऊ राख छिंचंय</char></note><verse eid="JOB 42:6" /></para>
  <para style="s1">उपसंहार</para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 42:7" />यहोवा ह अयूब ला अपन बात कहे के बाद, ओह तेमान के एलीपज ला कहिस, “मेंह तोर अऊ तोर दूनों संगीमन ऊपर गुस्सा हवंव, काबरकि तुमन मोर बिसय म सच बात नइं कहे हवव, जइसे कि मोर सेवक अयूब ह कहिस। <verse eid="JOB 42:7" /><verse number="8" style="v" sid="JOB 42:8" />एकरसेति, अब तुमन सात ठन बईला अऊ सात ठन मेढ़ा ला लेके मोर सेवक अयूब करा जावव अऊ अपन बर होम-बलिदान करव। मोर सेवक अयूब ह तुम्हर बर पराथना करही, अऊ मेंह ओकर पराथना ला गरहन करहूं अऊ मेंह तुम्हर संग तुम्हर मुरूखता के मुताबिक बेवहार नइं करहूं। तुमन मोर बारे म सच बात नइं कहे हवव, जइसे कि मोर सेवक अयूब ह कहिस।” <verse eid="JOB 42:8" /><verse number="9" style="v" sid="JOB 42:9" />एकरसेति तेमान के एलीपज, सूही के बिलदद अऊ नामात के सोपर वइसनेच करिन जइसने यहोवा ह ओमन ला कहे रिहिस; अऊ यहोवा ह अयूब के पराथना ला गरहन करिस।<verse eid="JOB 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 42:10" />जब अयूब ह अपन संगीमन बर पराथना कर डारिस, तब यहोवा ह ओकर जम्मो दुख ला दूर करिस अऊ जतेक संपत्ति अयूब करा पहिली रिहिस, ओकर दू गुना यहोवा ह ओला दीस। <verse eid="JOB 42:10" /><verse number="11" style="v" sid="JOB 42:11" />तब ओकर जम्मो भाई-बहिनी अऊ जतेक झन पहिली ओला जानत रिहिन, ओ जम्मो झन आईन अऊ अयूब के संग ओकर घर म जेवन करिन। अऊ जतेक बिपत्ति यहोवा ह अयूब ऊपर डाले रिहिस, ओ जम्मो के बारे म ओमन ओला सहानुभूति देखाके सांतवना दीन, अऊ हर एक झन ओला एक-एक ठन चांदी के टुकड़ा<note caller="+" style="f"><char style="fr" closed="false">42:11 </char><char style="ft" closed="false">सिक्का बने के पहिले येकर उपयोग खरिदी-बिकरी म करे जावय</char></note> अऊ सोन के बाली<note caller="+" style="f"><char style="fr" closed="false">42:11 </char><char style="ft" closed="false">माईलोगनमन नाक म पहिरंय (<char style="xt"><ref loc="GEN 24:47">उत 24:47</ref></char>) अऊ आदमी अऊ माईलोगनमन कान म पहिरंय (<char style="xt"><ref loc="EXO 32:2-3">निर 32:2‑3</ref></char>)</char></note> दीन।<verse eid="JOB 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 42:12" />यहोवा ह अयूब के एकर बाद के जिनगी ला एकर पहिली के जिनगी ले जादा आसीस दीस। ओकर करा चौदह हजार भेड़, छै हजार ऊंट, एक हजार जोड़ी बईला अऊ एक हजार गदहीमन रिहिन। <verse eid="JOB 42:12" /><verse number="13" style="v" sid="JOB 42:13" />ओकर सात बेटा अऊ तीन बेटी रिहिन। <verse eid="JOB 42:13" /><verse number="14" style="v" sid="JOB 42:14" />ओह बड़े बेटी के नांव यमीमा, मंझली के नांव कसीआ, अऊ छोटे बेटी के नांव केरेन-हपूक धरिस। <verse eid="JOB 42:14" /><verse number="15" style="v" sid="JOB 42:15" />ओ जम्मो देस भर म अयूब के बेटीमन कस सुघर अऊ कोनो माईलोगन नइं रिहिन, अऊ ओमन के ददा अयूब ह ओमन ला ओमन के भाईमन के संग म संपत्ति के एक बांटा दीस।<verse eid="JOB 42:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 42:16" />एकर बाद, अयूब ह एक सौ चालीस बछर तक जीयत रिहिस; ओह अपन लइका अऊ ओमन के लइकामन के चार पीढ़ी तक देखे बर पाईस। <verse eid="JOB 42:16" /><verse number="17" style="v" sid="JOB 42:17" />अऊ अयूब ह अपन पूरा उमर म डोकरा होके मर गीस।<verse eid="JOB 42:17" /></para>
  <chapter eid="JOB 42" />
</usx>