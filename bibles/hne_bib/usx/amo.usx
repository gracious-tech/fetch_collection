<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">आमोस</para>
  <para style="toc1">आमोस के किताब</para>
  <para style="toc2">आमोस</para>
  <para style="toc3">आमो</para>
  <para style="mt1">आमोस</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />येह आमोस के बचन अय। ओह तकोआ नगर के चरवाहामन म ले एक झन रिहिस; अऊ भुइंडोल के दू बछर पहिली इसरायल के बारे म ये दरसन देखिस, जब यहूदा प्रदेस के राजा उजियाह रिहिस अऊ इसरायल प्रदेस के राजा यहोआस के बेटा यरोबाम रिहिस।<verse eid="AMO 1:1" /></para>
  <para style="b" />
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />आमोस ह कहिस:</para>
  <para style="q1" vid="AMO 1:2">“यहोवा ह सियोन ले गरजथे,</para>
  <para style="q2" vid="AMO 1:2">अऊ यरूसलेम ले ओकर सबद ह गूंजथे;</para>
  <para style="q1" vid="AMO 1:2">चरवाहामन के चरागनमन सूखा जाथें।</para>
  <para style="q2" vid="AMO 1:2">अऊ करमेल पहाड़ के टीप ह अइला जाथे।”<verse eid="AMO 1:2" /></para>
  <para style="s1">इसरायल के परोसीमन के नियाय</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="AMO 1:3">“दमिस्क सहर के तीन पाप,</para>
  <para style="q2" vid="AMO 1:3">बल्कि चार पापमन के कारन मेंह ओमन ला सजा देय बिगर नइं छोड़ंव।</para>
  <para style="q1" vid="AMO 1:3">काबरकि ओह गिलाद ला</para>
  <para style="q2" vid="AMO 1:3">लोहा के दांतवाला हथियार ले दुख दे हवय,<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />मेंह हजाएल के परिवार ऊपर आगी बरसाहूं,</para>
  <para style="q2" vid="AMO 1:4">अऊ ओ आगी ह बेन-हदद के गढ़मन ला भसम कर दीही।<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />मेंह दमिस्क के दुवार ला टोर दूहूं,</para>
  <para style="q2" vid="AMO 1:5">मेंह आवेन<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">आवेन </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">दुस्टता</char></note> घाटी के राजा</para>
  <para style="q1" vid="AMO 1:5">अऊ बेत-एदेन सहर के राजदंडधारी ला नास कर दूहूं।</para>
  <para style="q2" vid="AMO 1:5">अऊ अराम के मनखेमन कीर देस के बंधुवई म जाहीं,”</para>
  <para style="q2" vid="AMO 1:5">यहोवा ह कहत हे।<verse eid="AMO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="AMO 1:6">“गाजा सहर के तीन पाप,</para>
  <para style="q2" vid="AMO 1:6">बल्कि चार पापमन के कारन मेंह ओला सजा देय बर नइं छोड़ंव,</para>
  <para style="q1" vid="AMO 1:6">काबरकि ओह पूरा समाज ला कैदी बनाके</para>
  <para style="q2" vid="AMO 1:6">एदोम देस के मनखेमन करा बेच दे हवय,<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />मेंह गाजा के दीवारमन म आगी बरसाहूं,</para>
  <para style="q2" vid="AMO 1:7">जऊन ह ओकर किलामन ला भसम कर दीही।<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />मेंह असदोद के राजा अऊ अस्कलोन के राजदंडधारी ला नास करहूं।</para>
  <para style="q1" vid="AMO 1:8">मेंह एकरोन ऊपर अपन हांथ चलाहूं,</para>
  <para style="q2" vid="AMO 1:8">जब तक कि आखिरी पलिस्ती मनखे घलो नइं मार डारे जाही,”</para>
  <para style="q2" vid="AMO 1:8">परमपरधान यहोवा ह कहत हे।<verse eid="AMO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="AMO 1:9">“सूर सहर के तीन पाप,</para>
  <para style="q2" vid="AMO 1:9">बल्कि चार पाप के कारन मेंह ओला सजा देय बिगर नइं छोड़ंव।</para>
  <para style="q1" vid="AMO 1:9">काबरकि ओह पूरा समाज ला बंधुवा बनाके एदोम करा बेच दीस,</para>
  <para style="q2" vid="AMO 1:9">अऊ भाई-चारा के करार ला नइं मानिस।<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />मेंह सूर के दीवारमन म आगी बरसाहूं</para>
  <para style="q2" vid="AMO 1:10">जऊन ह ओकर किलामन ला भसम कर दीही।”<verse eid="AMO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="AMO 1:11">“एदोम के तीन पाप,</para>
  <para style="q2" vid="AMO 1:11">बल्कि चार पाप के कारन मेंह ओला सजा देय बिगर नइं छोड़ंव।</para>
  <para style="q1" vid="AMO 1:11">काबरकि ओह तलवार लेके अपन भाईमन के पीछा करिस</para>
  <para style="q2" vid="AMO 1:11">अऊ देस के माईलोगनमन ला काट डारिस,</para>
  <para style="q1" vid="AMO 1:11">काबरकि ओकर रिस ह लगातार बढ़त गीस</para>
  <para style="q2" vid="AMO 1:11">अऊ ओकर कोरोध ह रूकबे नइं करिस<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />एकरसेति मेंह तेमान सहर म आगी लगाहूं,</para>
  <para style="q2" vid="AMO 1:12">जऊन ह बोसरा नगर के किलामन ला भसम कर दीही।”<verse eid="AMO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="AMO 1:13">“अमोन के तीन पाप,</para>
  <para style="q2" vid="AMO 1:13">बल्कि चार पाप के कारन मेंह ओमन ला सजा देय बिगर नइं छोड़ंव।</para>
  <para style="q1" vid="AMO 1:13">काबरकि ओह अपन सिवाना ला बढ़ाय बर</para>
  <para style="q2" vid="AMO 1:13">गिलाद देस के गरभवती माईलोगन के पेट ला चीर डारिस<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />एकरसेति मेंह रब्बा के दीवारमन म आगी लगाहूं</para>
  <para style="q2" vid="AMO 1:14">जऊन ह लड़ई के दिन लड़ई के ललकार के बीच,</para>
  <para style="q1" vid="AMO 1:14">अऊ आंधी चले के दिन हिंसक गरेर के बीच</para>
  <para style="q2" vid="AMO 1:14">ओकर किलामन ला भसम कर दीही।<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />ओकर राजा<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मोलेक</char></note> ह बंधुवई म जाही,</para>
  <para style="q2" vid="AMO 1:15">ओ अऊ ओकर करमचारीमन एक संग बंधुवई म जाहीं,”</para>
  <para style="q2" vid="AMO 1:15">यहोवा ह कहत हे।<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="AMO 2:1">“मोआब के तीन पाप</para>
  <para style="q2" vid="AMO 2:1">बल्कि चार पापमन के कारन</para>
  <para style="q2" vid="AMO 2:1">मेंह ओला सजा देय बिगर नइं छोड़ंव।</para>
  <para style="q1" vid="AMO 2:1">काबरकि ओह एदोम के राजा के हाड़ामन ला</para>
  <para style="q2" vid="AMO 2:1">जलाके राख कर दीस,<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />मेंह मोआब म आगी लगाहूं</para>
  <para style="q2" vid="AMO 2:2">जऊन ह करियोत सहर के किलामन ला जलाके भसम कर दीही।</para>
  <para style="q1" vid="AMO 2:2">मोआब ह बड़े हुल्लड़ म</para>
  <para style="q2" vid="AMO 2:2">लड़ई के ललकार अऊ तुरही के अवाज के बीच नास हो जाही।<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />मेंह मोआब के सासन करइया ला अऊ ओकर संग जम्मो अधिकारीमन ला मार डारहूं,”</para>
  <para style="q2" vid="AMO 2:3">यहोवा ह कहत हे।<verse eid="AMO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="AMO 2:4">“यहूदा के तीन पाप,</para>
  <para style="q2" vid="AMO 2:4">बल्कि चार पापमन के कारन, मेंह ओला सजा देय बिगर नइं छोड़ंव।</para>
  <para style="q1" vid="AMO 2:4">काबरकि ओमन यहोवा के कानून ला नइं मानिन</para>
  <para style="q2" vid="AMO 2:4">अऊ ओकर नियममन के पालन नइं करिन,</para>
  <para style="q1" vid="AMO 2:4">काबरकि ओमन लबरा देवतामन के पाछू चल दीन,</para>
  <para style="q2" vid="AMO 2:4">ओ देवता, जऊन मन के पाछू म ओमन के पुरखामन रेंगंय,<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />एकरसेति मेंह यहूदा म आगी लगाहूं</para>
  <para style="q2" vid="AMO 2:5">जऊन ह यरूसलेम के किलामन ला भसम कर दीही।”<verse eid="AMO 2:5" /></para>
  <para style="s1">इसरायल के ऊपर नियाय</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="AMO 2:6">“इसरायल के तीन पाप,</para>
  <para style="q2" vid="AMO 2:6">बल्कि चार पापमन के कारन, मेंह ओला सजा देय बिगर नइं छोड़ंव।</para>
  <para style="q1" vid="AMO 2:6">ओमन निरदोस ला चांदी बर</para>
  <para style="q2" vid="AMO 2:6">अऊ गरीबमन ला एक जोड़ी जूता खातिर बेच देथें।<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />ओमन गरीबमन के मुड़ ला अइसन कुचरथें</para>
  <para style="q2" vid="AMO 2:7">जइसन भुइयां के धुर्रा</para>
  <para style="q2" vid="AMO 2:7">अऊ दुखी मनखे के नियाय ला बिगाड़थें।</para>
  <para style="q1" vid="AMO 2:7">ददा अऊ बेटा दूनों एके छोकरी ले संबंध बनाथें</para>
  <para style="q2" vid="AMO 2:7">अऊ मोर पबितर नांव ला अपबितर करथें।<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />ओमन हर बेदी के बाजू म</para>
  <para style="q2" vid="AMO 2:8">गिरवी म रखे ओनहा ऊपर लेटथें।</para>
  <para style="q1" vid="AMO 2:8">ओमन अपन देवता के घर म</para>
  <para style="q2" vid="AMO 2:8">जुरबाना म लिये गय अंगूर के मंद ला पीथें।<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />“तभो ले मेंह अमोरीमन ला ओमन के आघू ले नास करेंव,</para>
  <para style="q2" vid="AMO 2:9">हालाकि ओमन देवदार रूख सहीं ऊंचहा</para>
  <para style="q2" vid="AMO 2:9">अऊ बलूत रूख सहीं मजबूत रिहिन।</para>
  <para style="q1" vid="AMO 2:9">मेंह ऊपर ले ओमन के फर</para>
  <para style="q2" vid="AMO 2:9">अऊ खाल्हे ओमन के जरी ला नास कर देंव।<verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />मेंह तुमन ला मिसर देस ले निकाल लानेंव</para>
  <para style="q2" vid="AMO 2:10">अऊ चालीस बछर ले सुनसान जगह म तुम्हर अगुवई करेंव</para>
  <para style="q2" vid="AMO 2:10">ताकि तुमन ला अमोरीमन के देस ला दे दंव।<verse eid="AMO 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />“मेंह तुम्हर लइकामन के बीच ले अगमजानीमन ला</para>
  <para style="q2" vid="AMO 2:11">अऊ तुम्हर जवानमन के बीच ले नाजीरमन<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">नाजीर </char><char style="ft" closed="false">ओ मनखे जऊन ह परमेसर ला बिसेस बचन देवय। जेकर मतलब होथे “कोनो ले अलग होवई।”</char></note> ला घलो चुनेंव।</para>
  <para style="q1" vid="AMO 2:11">हे इसरायल के मनखेमन, का येह सच नो हय?”</para>
  <para style="q2" vid="AMO 2:11">यहोवा ह घोसना करत हे।<verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />“पर तुमन नाजीरमन ला अंगूर के मंद पीयाएव</para>
  <para style="q2" vid="AMO 2:12">अऊ अगमजानीमन ला हुकूम देव कि ओमन अगमबानी झन करंय।<verse eid="AMO 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />“त अब, मेंह तुमन ला अइसन कुचरहूं</para>
  <para style="q2" vid="AMO 2:13">जइसन करपा ले भराय गाड़ी ले दाना ह कुचरे जाथे।<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />तेजी ले भगोइया घलो नइं बांच पाही,</para>
  <para style="q2" vid="AMO 2:14">अऊ बलवान के ताकत ह कोनो काम नइं आही,</para>
  <para style="q2" vid="AMO 2:14">अऊ सूरबीर ह अपन जिनगी ला नइं बचाय सकही।<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />धनुसधारी ह मैदान म ठाढ़ नइं हो सकही,</para>
  <para style="q2" vid="AMO 2:15">तेजी ले दऊड़इया सैनिक ह भाग नइं सकही,</para>
  <para style="q2" vid="AMO 2:15">अऊ घुड़सवार ह अपन जिनगी ला नइं बचाय सकही।<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />इहां तक कि सबले ताकतवर सूरबीरमन घलो</para>
  <para style="q2" vid="AMO 2:16">ओ दिन नंगरा भागहीं,”</para>
  <para style="q2" vid="AMO 2:16">यहोवा ह घोसना करत हे।<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s1">इसरायल के बिरूध गवाहमन ला बलाय जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />हे इसरायलीमन, ये बचन ला सुनव, यहोवा के बचन ह तुम्हर बिरूध कहे हवय—तुम्हर पूरा बंस के बिरूध, जेला मेंह मिसर देस ले निकाल लानेंव:<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />“सिरिप तुमन अव, जेला मेंह</para>
  <para style="q2" vid="AMO 3:2">धरती के सब बंसमन ले चुने हंव;</para>
  <para style="q1" vid="AMO 3:2">एकरसेति मेंह तुम्हर जम्मो</para>
  <para style="q2" vid="AMO 3:2">पाप के सजा दूहूं।”<verse eid="AMO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />का दू झन एक संग रेंगथें</para>
  <para style="q2" vid="AMO 3:3">जब तक ओमन अइसन करे बर राजी नइं हो जावंय?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />का सिंह ह बिगर सिकार देखे</para>
  <para style="q2" vid="AMO 3:4">झाड़ी म ले गरजथे?</para>
  <para style="q1" vid="AMO 3:4">का ओह बिगर कुछू धरे</para>
  <para style="q2" vid="AMO 3:4">अपन मांद म गुर्राथे?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />का कोनो चिरई भुइयां ऊपर बिगर चारा देखे</para>
  <para style="q2" vid="AMO 3:5">फांदा कोति झपटथे?</para>
  <para style="q1" vid="AMO 3:5">का फांदा ह भुइयां ले अपनआप उचकथे</para>
  <para style="q2" vid="AMO 3:5">जब ओमा कुछू नइं फंसे रहय?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />जब कोनो सहर म लड़ई के तुरही बजथे,</para>
  <para style="q2" vid="AMO 3:6">त का मनखेमन डर के मारे नइं कांपंय?</para>
  <para style="q1" vid="AMO 3:6">जब कोनो सहर म बिपत परथे,</para>
  <para style="q2" vid="AMO 3:6">त का येह यहोवा कोति ले नइं होवय?<verse eid="AMO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />सही म, परमपरधान यहोवा ह</para>
  <para style="q2" vid="AMO 3:7">अपन सेवक अगमजानीमन ऊपर</para>
  <para style="q2" vid="AMO 3:7">अपन योजना ला परगट करे बिगर कुछू नइं करय।<verse eid="AMO 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />जब सिंह ह गरजथे—</para>
  <para style="q2" vid="AMO 3:8">त कोन ए, जऊन ह नइं डरावय?</para>
  <para style="q1" vid="AMO 3:8">परमपरधान यहोवा ह कहे हवय—</para>
  <para style="q2" vid="AMO 3:8">कोन ए, जऊन ह अगमबानी नइं करही?<verse eid="AMO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />असदोद नगर के किलामन म</para>
  <para style="q2" vid="AMO 3:9">अऊ मिसर देस के किलामन म हांका पारव:</para>
  <para style="q1" vid="AMO 3:9">“सामरिया के पहाड़मन म जूर जावव;</para>
  <para style="q2" vid="AMO 3:9">अऊ देखव कि ओकर भीतर म कइसन असांति</para>
  <para style="q2" vid="AMO 3:9">अऊ ओकर मनखेमन के बीच म कइसन अतियाचार होवत हवय।”<verse eid="AMO 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />“ओमन सही काम करे बर नइं जानंय,” यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="AMO 3:10">“ओमन के लूटे अऊ छीने गय धन ला</para>
  <para style="q2" vid="AMO 3:10">कोन ह ओमन के किलामन म संकेलके रखथे।”<verse eid="AMO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11" />एकरसेति परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="AMO 3:11">“एक बईरी ह तुम्हर देस ला घेर लीही,</para>
  <para style="q2" vid="AMO 3:11">तुम्हर गढ़मन ला गिरा दीही,</para>
  <para style="q2" vid="AMO 3:11">अऊ किलामन ला लूट लीही।”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="AMO 3:12">“जइसन चरवाहा ह सिंह के मुहूं ले</para>
  <para style="q2" vid="AMO 3:12">सिरिप दू ठन टांग या कान के एक ठन कुटा ला छोंड़ाय पाथे,</para>
  <para style="q1" vid="AMO 3:12">वइसन सामरिया म रहइया इसरायलीमन बचाय जाहीं,</para>
  <para style="q2" vid="AMO 3:12">सिरिप दसना के मुड़सरिया,</para>
  <para style="q2" vid="AMO 3:12">अऊ खटिया के बिछौना के एक कुटा के संग बचाय जाहीं।”<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />“येला सुनव अऊ याकूब के संतानमन के बिरूध गवाही दव,” परभू, यहोवा सर्वसक्तिमान परमेसर ह घोसना करत हे।<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />“जऊन दिन मेंह इसरायल ला ओकर पापमन के सजा दूहूं,</para>
  <para style="q2" vid="AMO 3:14">ओ दिन बेतेल नगर के बेदीमन ला नास कर दूहूं;</para>
  <para style="q1" vid="AMO 3:14">बेदी के सींगमन ला काट डारे जाही</para>
  <para style="q2" vid="AMO 3:14">अऊ भुइयां म गिरा दिये जाही।<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />मेंह जड़काला के भवन के संग</para>
  <para style="q2" vid="AMO 3:15">घमनी के भवन ला टोरके गिरा दूहूं;</para>
  <para style="q1" vid="AMO 3:15">हाथी-दांत ले सजाय घरमन ला नास करे जाही</para>
  <para style="q2" vid="AMO 3:15">अऊ महलमन ला गिरा दिये जाही,”</para>
  <para style="q2" vid="AMO 3:15">यहोवा ह घोसना करत हे।<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s1">परमेसर करा इसरायल ह नइं लहुंटिस</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />हे सामरिया के पहाड़ ऊपर रहइया बासान के गायमन<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fq" closed="false">गायमन </char><char style="ft" closed="false">सामरिया के अगुवा </char><char style="fqa" closed="false">माईलोगनमन</char></note>, ये बचन ला सुनव,</para>
  <para style="q2" vid="AMO 4:1">हे माईलोगनमन, तुमन जऊन गरीब ला सताथव अऊ जरूरतमंद ला कुचर देथव</para>
  <para style="q2" vid="AMO 4:1">अऊ अपन घरवाला ला कहिथव, “हमर पीये बर कुछू लेके आ!”<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />परमपरधान यहोवा ह अपन पबितरता के किरिया खाके कहत हवय:</para>
  <para style="q2" vid="AMO 4:2">“अइसन समय जरूर अवइया हवय,</para>
  <para style="q1" vid="AMO 4:2">जब तुमन ला गरी ले,</para>
  <para style="q2" vid="AMO 4:2">आखिरी तक बांचे ला घलो मछरी फंसाय के गरी ले फंसाके ले जाय जाही।<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />तुमन म के जम्मो झन</para>
  <para style="q2" vid="AMO 4:3">सहर के दीवार के फाटे म ले सीधा बाहिर निकलहू।</para>
  <para style="q1" vid="AMO 4:3">तुमन ला हरमोन कोति फटिक दिये जाही,”</para>
  <para style="q2" vid="AMO 4:3">यहोवा ह घोसना करत हे।<verse eid="AMO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />“बेतेल नगर म जाके पाप करव;</para>
  <para style="q2" vid="AMO 4:4">अऊ गिलगाल नगर म जाके अऊ जादा पाप करव।</para>
  <para style="q1" vid="AMO 4:4">अपन बलिदान ला रोज बड़े बिहनियां</para>
  <para style="q2" vid="AMO 4:4">अऊ अपन दसमांस ला हर तीसरा साल<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">दिन</char></note> लाने करव।<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />धनबाद-बलिदान के रूप म खमीर मिले रोटी ला जरोवव</para>
  <para style="q2" vid="AMO 4:5">अऊ अपन स्वेच्छा-बलिदान के बारे डींग मारव—</para>
  <para style="q1" vid="AMO 4:5">हे इसरायलीमन, ओमन के बारे म घमंड करव,</para>
  <para style="q2" vid="AMO 4:5">काबरकि तुमन ला अइसने करई ह बने लगथे,”</para>
  <para style="q2" vid="AMO 4:5">परमपरधान यहोवा ह घोसना करत हे।<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />“मेंह हर सहर म तुमन ला भूखन पेट रखेंव</para>
  <para style="q2" vid="AMO 4:6">अऊ हर नगर म जेवन के घटी करेंव,</para>
  <para style="q1" vid="AMO 4:6">तभो ले तुमन मोर कोति नइं लहुंटेव।”</para>
  <para style="q2" vid="AMO 4:6">यहोवा ह घोसना करत हे।<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />“जब फसल लुवई ह तीन महिना बांचे रिहिस</para>
  <para style="q2" vid="AMO 4:7">तब मेंह बरसा ला रोक दे रहेंव।</para>
  <para style="q1" vid="AMO 4:7">में एक नगर म पानी गिरांय,</para>
  <para style="q2" vid="AMO 4:7">पर दूसर नगर म नइं गिरांय।</para>
  <para style="q1" vid="AMO 4:7">एक खेत म बारिस होईस;</para>
  <para style="q2" vid="AMO 4:7">अऊ दूसर म नइं होईस अऊ ओह सूखा गीस।<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />मनखेमन एक सहर ले दूसर सहर म पानी बर भटकिन</para>
  <para style="q2" vid="AMO 4:8">पर पीये बर भरपूर पानी नइं पाईन,</para>
  <para style="q1" vid="AMO 4:8">तभो ले तुमन मोर कोति नइं लहुंटेव,”</para>
  <para style="q2" vid="AMO 4:8">यहोवा ह घोसना करत हे।<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />“कई बार मेंह तुम्हर बारी अऊ अंगूर के बारी म फसल नइं होवन दें,</para>
  <para style="q2" vid="AMO 4:9">ओमन ला रोग अऊ फफूंदी ले बरबाद कर देंव।</para>
  <para style="q1" vid="AMO 4:9">फांफामन तुम्हर अंजीर अऊ जैतून के रूख ला खा डारिन,</para>
  <para style="q2" vid="AMO 4:9">तभो ले तुमन मोर कोति नइं लहुंटेव,”</para>
  <para style="q2" vid="AMO 4:9">यहोवा ह घोसना करत हे।<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />“मेंह तुम्हर बीच म महामारी पठोंय</para>
  <para style="q2" vid="AMO 4:10">जइसन मेंह मिसर देस म पठोय रहेंव।</para>
  <para style="q1" vid="AMO 4:10">मेंह लूटे गय घोड़ामन के संग</para>
  <para style="q2" vid="AMO 4:10">तुम्हर जवानमन ला तलवार ले मार डारेंव।</para>
  <para style="q1" vid="AMO 4:10">मेंह तुम्हर छावनी के बदबू ले तुम्हर नाक ला भर देंव,</para>
  <para style="q2" vid="AMO 4:10">तभो ले तुमन मोर कोति नइं फिरेव।</para>
  <para style="q2" vid="AMO 4:10">यहोवा ह घोसना करत हे।<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />“मेंह जइसन सदोम अऊ अमोरा सहरमन ला नास करेंव</para>
  <para style="q2" vid="AMO 4:11">वइसन ही मेंह तुमन म ले कुछू झन ला नास कर देंव।</para>
  <para style="q1" vid="AMO 4:11">तुमन आगी ले निकाले बरत लकरी कस रहेव,</para>
  <para style="q2" vid="AMO 4:11">तभो ले तुमन मोर कोति नइं फिरेव,”</para>
  <para style="q2" vid="AMO 4:11">यहोवा ह घोसना करत हे।<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />“एकरसेति हे इसरायल, मेंह तोर संग अइसन करहूं,</para>
  <para style="q2" vid="AMO 4:12">हे इसरायल, काबरकि मेंह तोर संग अइसन करहूं,</para>
  <para style="q2" vid="AMO 4:12">त तेंह अपन परमेसर ले भेंट करे बर तियार हो जा।”<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />ओ, जऊन ह पहाड़मन ला बनाथे,</para>
  <para style="q2" vid="AMO 4:13">जऊन ह हवा ला सिरजथे,</para>
  <para style="q2" vid="AMO 4:13">अऊ जऊन ह मानव-जाति ऊपर अपन बिचार ला परगट करथे,</para>
  <para style="q1" vid="AMO 4:13">जऊन ह बिहान ला अंधियार कर देथे,</para>
  <para style="q2" vid="AMO 4:13">अऊ जऊन ह धरती के ऊंचहा ठऊरमन म रेंगथे—</para>
  <para style="q2" vid="AMO 4:13">ओकर नांव यहोवा सर्वसक्तिमान परमेसर अय।<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">एक बिलापगीत अऊ पछताप करे बर बुलावा</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />हे इसरायल, ये बचन ला सुन, तोर बारे म मेंह ये बिलापगीत सुनावत हंव:<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />“कुंवारी इसरायल ह गिर गे हे,</para>
  <para style="q2" vid="AMO 5:2">ओह फेर कभू नइं उठय,</para>
  <para style="q1" vid="AMO 5:2">ओला ओकर खुद के देस म तियाग दिये गे हे,</para>
  <para style="q2" vid="AMO 5:2">अऊ ओला उठइया कोनो नइं एं।”<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />परमपरधान यहोवा ह इसरायल ले ये कहत हे:</para>
  <para style="q1" vid="AMO 5:3">“तोर सहर, जेमा ले एक हजार बीर योद्धा निकलथें</para>
  <para style="q2" vid="AMO 5:3">ओमा सिरिप एक सौ ही बांचहीं;</para>
  <para style="q1" vid="AMO 5:3">तोर नगर, जेमा ले एक सौ बीर निकलथें</para>
  <para style="q2" vid="AMO 5:3">ओमा सिरिप दस झन ही बांचहीं।”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />यहोवा ह इसरायल ले ये कहत हे:</para>
  <para style="q1" vid="AMO 5:4">“मोला खोजव अऊ जीयत रहव;<verse eid="AMO 5:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5" />बेतेल ला झन खोजव,</para>
  <para style="q1" vid="AMO 5:5">गिलगाल झन जावव,</para>
  <para style="q2" vid="AMO 5:5">बेरसेबा के यातरा झन करव;</para>
  <para style="q1" vid="AMO 5:5">काबरकि गिलगाल ह जरूर बंधुवई म जाही,</para>
  <para style="q2" vid="AMO 5:5">अऊ बेतेल ह सुनसान हो जाही,”<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />यहोवा ला खोजव अऊ जीयत रहव,</para>
  <para style="q2" vid="AMO 5:6">नइं तो ओह यूसुफ के गोत्र ऊपर आगी सहीं भड़कही;</para>
  <para style="q1" vid="AMO 5:6">येह ओमन ला भसम कर दीही,</para>
  <para style="q2" vid="AMO 5:6">अऊ बेतेल म ओ आगी ला बुतइया कोनो नइं होहीं।<verse eid="AMO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />अइसन मनखेमन हवंय, जेमन नियाय ला करूवाहट म बदल देथें,</para>
  <para style="q2" vid="AMO 5:7">अऊ धरमीपन ला माटी म मिला देथें।<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />जऊन ह नछत्र-पुंज अऊ मिरगासिरा ला बनाईस,</para>
  <para style="q2" vid="AMO 5:8">जऊन ह मंझ रथिया ला बिहनियां म</para>
  <para style="q2" vid="AMO 5:8">अऊ दिन ला रथिया म बदल देथे,</para>
  <para style="q1" vid="AMO 5:8">जऊन ह महासागर के पानी ला बलाथे</para>
  <para style="q2" vid="AMO 5:8">अऊ ओला भुइयां ऊपर गिरा देथे—</para>
  <para style="q2" vid="AMO 5:8">ओकर नांव यहोवा अय।<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />ओह किला ला मिटकी मारते ही नास कर देथे</para>
  <para style="q2" vid="AMO 5:9">अऊ गढ़वाले सहर ला खंडहर कर देथे।<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />अइसन मनखेमन हवंय, जेमन अदालत म नियाय पसंद करइयामन ले घिन करथें</para>
  <para style="q2" vid="AMO 5:10">अऊ सच बात कहइयामन ले घलो घिन करथें।<verse eid="AMO 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />तुमन गरीबमन ले भूंसा बर घलो चुंगी लेथव</para>
  <para style="q2" vid="AMO 5:11">अऊ ओमन के अनाज ऊपर घलो कर लगाथव।</para>
  <para style="q1" vid="AMO 5:11">एकरसेति, हालाकि तुमन पथरा के महल बनाय हव,</para>
  <para style="q2" vid="AMO 5:11">पर तुमन ओमा नइं रहे बर पाहू;</para>
  <para style="q1" vid="AMO 5:11">हालाकि तुमन रसीला अंगूर के बारी लगाय हव,</para>
  <para style="q2" vid="AMO 5:11">पर तुमन ओमन के मंद नइं पीये सकहू।<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />काबरकि मेंह जानत हंव कि तुम्हर अपराध कतेक जादा हवय</para>
  <para style="q2" vid="AMO 5:12">अऊ तुम्हर पापमन कतेक बड़े हवंय।</para>
  <para style="b" vid="AMO 5:12" />
  <para style="q1" vid="AMO 5:12">अइसन मनखे हवंय, जेमन निरदोस ऊपर अतियाचार करथें अऊ घूस लेथें</para>
  <para style="q2" vid="AMO 5:12">अऊ अदालत म गरीबमन के नियाय ला बिगाड़थें।<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />एकरसेति, अइसन समय म समझदार ह चुप रहय,</para>
  <para style="q2" vid="AMO 5:13">काबरकि समय ह खराप हवय।<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />बुरई के नइं, पर भलई के खोज करव,</para>
  <para style="q2" vid="AMO 5:14">ताकि तुमन जीयत रहव।</para>
  <para style="q1" vid="AMO 5:14">तभे यहोवा सर्वसक्तिमान परमेसर ह तुम्हर संग रहिही,</para>
  <para style="q2" vid="AMO 5:14">जइसन कि तुमन कहिथव कि ओह तुम्हर संग हवय।<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />बुरई ले घिन करव, अऊ भलई ले मया;</para>
  <para style="q2" vid="AMO 5:15">कचहरी म नियाय ला बनाय रखव।</para>
  <para style="q1" vid="AMO 5:15">सायद यहोवा सर्वसक्तिमान परमेसर ह</para>
  <para style="q2" vid="AMO 5:15">यूसुफ के बांचे मनखेमन ऊपर दया करय।<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />एकरे बर परभू, यहोवा, सर्वसक्तिमान परमेसर ह ये कहत हे:</para>
  <para style="q1" vid="AMO 5:16">“सब गलीमन म बिलाप करे जाही</para>
  <para style="q2" vid="AMO 5:16">अऊ सबो चऊकमन म दुख अऊ पीरा के अवाज सुनई दीही।</para>
  <para style="q1" vid="AMO 5:16">किसानमन ला रोय बर</para>
  <para style="q2" vid="AMO 5:16">अऊ बिलाप करइयामन ला बिलाप करे बर बलाय जाही।<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />अंगूर के सब बारीमन म बिलाप होही,</para>
  <para style="q2" vid="AMO 5:17">काबरकि ओ बेरा मेंह तुम्हर बीच ले होके जाहूं,”</para>
  <para style="q2" vid="AMO 5:17">यहोवा ह कहत हे।<verse eid="AMO 5:17" /></para>
  <para style="s1">यहोवा के दिन</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />हाय तुम्हर ऊपर,</para>
  <para style="q2" vid="AMO 5:18">जऊन मन यहोवा के दिन<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यहोवा के नियाय के दिन</char></note> के ईछा करथव!</para>
  <para style="q1" vid="AMO 5:18">तुमन काबर यहोवा के दिन के ईछा करथव?</para>
  <para style="q2" vid="AMO 5:18">ओह अंधियार के दिन होही, अंजोर के नइं।<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />ओ दिन ह अइसन होही मानो कोनो मनखे ह सिंह ले बांचे बर भागथे</para>
  <para style="q2" vid="AMO 5:19">अऊ ओकर सामना भालू ले हो जाथे,</para>
  <para style="q1" vid="AMO 5:19">या ओह घर के भीतर जाथे</para>
  <para style="q2" vid="AMO 5:19">अऊ अराम बर भीथी ऊपर हांथ मढ़ाथे अऊ सांप ह ओला चाब देथे।<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />का यहोवा के दिन ह अंजोर के बदले अंधियार के नइं होही—</para>
  <para style="q2" vid="AMO 5:20">बिरबिट अंधियार, एकोकनी अंजोर नइं?<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />“मेंह घिन करथंव, मेंह तुम्हर धारमिक तिहारमन ला तुछ समझथंव;</para>
  <para style="q2" vid="AMO 5:21">तुम्हर सभामन मोर बर बदबू सहीं अंय।<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />भले ही तुमन मोर बर होम-बलिदान अऊ अन्न-बलिदान लानव,</para>
  <para style="q2" vid="AMO 5:22">पर मेंह ओमन ला गरहन नइं करंव।</para>
  <para style="q1" vid="AMO 5:22">भले ही तुमन मनपसंद मेल-बलिदान लानव,</para>
  <para style="q2" vid="AMO 5:22">पर मेंह ओमन के आदर नइं करंव।<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />अपन गीतमन के कंझट ला मोर ले दूरिहा रखव!</para>
  <para style="q2" vid="AMO 5:23">मेंह तुम्हर बीना के संगीत ला नइं सुनंव।<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />पर नियाय ला नदी कस,</para>
  <para style="q2" vid="AMO 5:24">अऊ धरमीपन ला कभू नइं सूखइया सोता सहीं बोहावन दव!<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25" />“हे इसरायल के मनखेमन, निरजन जगह म चालीस साल तक</para>
  <para style="q2" vid="AMO 5:25">का तुमन मोर बर बलिदान अऊ भेंट लानेव?<verse eid="AMO 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26" />तुमन अपन राजा के देव-स्थल,</para>
  <para style="q2" vid="AMO 5:26">अपन मूरतीमन के गोड़ के पीढ़ा,</para>
  <para style="q2" vid="AMO 5:26">अपन देवता के तारा ला हांथ म उठाय हव—</para>
  <para style="q2" vid="AMO 5:26">जऊन मन ला तुमन खुद अपन बर बनाय हवव।<verse eid="AMO 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27" />एकरसेति मेंह तुमन ला दमिस्क नगर ले बाहिर बंधुवई म पठो दूहूं,”</para>
  <para style="q2" vid="AMO 5:27">यहोवा ह ये कहत हे, जेकर नांव सर्वसक्तिमान परमेसर अय।<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s1">आत्म-संतुस्ट मनखेमन ला धिक्कार</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />हाय तुमन ऊपर, जेमन सियोन म संतुस्ट हवव,</para>
  <para style="q2" vid="AMO 6:1">हाय तुमन ऊपर, जेमन सामरिया नगर के पहाड़ म अपनआप ला सुरकछित मानथव,</para>
  <para style="q1" vid="AMO 6:1">तुमन, जेमन सबले उत्तम देस के नामी आदमी अव,</para>
  <para style="q2" vid="AMO 6:1">जेमन करा इसरायल के मनखेमन आथें!<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />कलने नगर जाके ओला देखव;</para>
  <para style="q2" vid="AMO 6:2">उहां ले हमात नांव के बड़े सहर म जावव,</para>
  <para style="q2" vid="AMO 6:2">अऊ तब खाल्हे पलिस्ती के गत नांव के सहर म जावव।</para>
  <para style="q1" vid="AMO 6:2">का येमन तुम्हर दूनों राजमन ले जादा बढ़िया हवंय?</para>
  <para style="q2" vid="AMO 6:2">का तुम्हर देस ले ओमन के देस ह बड़खा हवय?<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />तुमन संकट के दिन ला दूरिहा कर देथव,</para>
  <para style="q2" vid="AMO 6:3">अऊ आतंक के राज ला लकठा म ले आथव।<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />तुमन हाथी-दांत ले सजे पलंग ऊपर लेटथव</para>
  <para style="q2" vid="AMO 6:4">अऊ अपन सोफा म अराम करथव।</para>
  <para style="q1" vid="AMO 6:4">तुमन मनपसंद भेड़</para>
  <para style="q2" vid="AMO 6:4">अऊ चरबीदार बछवामन ला खाथव।<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />तुमन दाऊद सहीं अपन बीना ला बजाथव</para>
  <para style="q2" vid="AMO 6:5">अऊ बाजामन ला तुरते बजाथव।<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />तुमन कटोरा भरके अंगूर के मंद पीथव</para>
  <para style="q2" vid="AMO 6:6">अऊ सबले बढ़िया तेल ला देहें म चुपरथव,</para>
  <para style="q2" vid="AMO 6:6">पर तुमन यूसुफ के बरबादी बर दुखी नइं होवव।<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />एकरसेति तुमन सबले पहिली बंधुवई म जाहू;</para>
  <para style="q2" vid="AMO 6:7">तुम्हर भोज खवई अऊ मऊज करई ह बंद हो जाही।<verse eid="AMO 6:7" /></para>
  <para style="s1">यहोवा ह इसरायल के घमंड ले घिन करथे</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />परमपरधान यहोवा ह अपनेच कसम खाय हवय—यहोवा सर्वसक्तिमान परमेसर ह घोसना करत हे:</para>
  <para style="q1" vid="AMO 6:8">“मेंह याकूब के घमंड ले घिन करथंव</para>
  <para style="q2" vid="AMO 6:8">अऊ ओकर किलामन ले घलो घिन करथंव;</para>
  <para style="q1" vid="AMO 6:8">मेंह सहर अऊ ओमा के जम्मो चीज ला</para>
  <para style="q2" vid="AMO 6:8">बईरी के हांथ म कर दूहूं।”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />कहूं एक घर म दस मनखे घलो बांचे रहिहीं, त ओमन घलो मर जाहीं। <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />कहूं कोनो रिस्तेदार ह ओमन के देहें ला जराय खातिर घर ले बाहिर ले जाय बर आथे अऊ उहां कोनो लुकाय मनखे ले पुछथे, “इहां तोर संग म कोनो अऊ हवंय?” अऊ ओह कहिथे, “नइं,” तब ओह ये कहिही, “चुपे रह! हमन ला यहोवा के नांव नइं लेना हवय।”<verse eid="AMO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />काबरकि यहोवा ह हुकूम देय हवय,</para>
  <para style="q2" vid="AMO 6:11">अऊ ओह बड़े घर ला फोरके कुटा-कुटा</para>
  <para style="q2" vid="AMO 6:11">अऊ छोटे घर ला चूर-चूर कर दीही।<verse eid="AMO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />का घोड़ामन ठाढ़ चट्टान म दऊड़थें?</para>
  <para style="q2" vid="AMO 6:12">का कोनो मनखे बईलामन ले समुंदर म नांगर जोतथे?</para>
  <para style="q1" vid="AMO 6:12">पर तुमन नियाय ला जहर म</para>
  <para style="q2" vid="AMO 6:12">अऊ धरमीपन के फर ला करूवाहट म बदल दे हवव—<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />तुमन, जेमन लो-देबार<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">लो-देबार </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">कुछू घलो नइं</char></note> ला अपन बस म करके आनंदित होथव</para>
  <para style="q2" vid="AMO 6:13">अऊ कहिथव, “हमन का अपन बल म करनेम<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">करनेम </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">सींग </char><char style="ft" closed="false">जऊन ह इहां ताकत के प्रतीक के रूप म आय हवय</char></note> ला नइं जीत ले हन?”<verse eid="AMO 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />काबरकि यहोवा सर्वसक्तिमान परमेसर ह घोसना करत हे,</para>
  <para style="q2" vid="AMO 6:14">“हे इसरायल, मेंह तोर बिरूध म एक जाति ला भड़काहूं,</para>
  <para style="q1" vid="AMO 6:14">जऊन ह तुम्हर ऊपर लेबो-हमात ले लेके</para>
  <para style="q2" vid="AMO 6:14">अराबा के घाटी तक अतियाचार करही।”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s1">फांफा, आगी अऊ एक ठन साहुल</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />परमपरधान यहोवा ह मोला ये देखाईस: जब राजा के हिस्सा के फसल ह लुआ गे रिहिस अऊ बाद के फसल ह आवत रिहिस, तब ओह फांफामन के दल ला तियार करत रिहिस। <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />जब फांफामन सब फसल ला खाके खेत ला साफ कर दीन, तब मेंह पराथना म पुकारेंव, “हे परमपरधान यहोवा, छेमा कर! याकूब ह कइसे जीयत रह सकत हे? ओह बहुंत छोटे हवय!”<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />तब यहोवा ह नरम पड़िस अऊ कहिस, “अब अइसन नइं होवय।”<verse eid="AMO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />परमपरधान यहोवा ह मोला ये देखाईस: परमपरधान यहोवा ह आगी के दुवारा नियाय करे बर बलावत रिहिस; ओ आगी ह महासागर ला सूखा दीस अऊ भुइयां ला नास कर दीस। <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />तब मेंह पुकारके कहेंव, “हे परमपरधान यहोवा, मेंह तोर ले बिनती करत हंव, येला रोक दे! याकूब ह कइसे जीयत रह सकत हे? ओह बहुंत छोटे हवय!”<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />तब यहोवा ह नरम पड़िस।</para>
  <para style="p" vid="AMO 7:6">“अब येह घलो नइं होवय,” परमपरधान यहोवा ह कहिस।<verse eid="AMO 7:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />ओह मोला ये देखाईस: परभू ह एक ठन भीथी के तीर म ठाढ़े रिहिस, जऊन ह साहुल के भार सहीं बनाय गे रिहिस, अऊ ओकर हांथ म एक ठन साहुल रिहिस। <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />अऊ यहोवा ह मोर ले पुछिस, “हे आमोस, तोला का दिखत हवय?”</para>
  <para style="p" vid="AMO 7:8">मेंह जबाब देंव, “एक ठन साहुल।”</para>
  <para style="p" vid="AMO 7:8">तब परभू ह कहिस, “देख, मेंह अपन मनखे इसरायलीमन के बीच एक साहुल लगावत हंव; मेंह ओमन ला अब नइं छोड़ंव।<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />“इसहाक के ऊंचहा ठऊरमन ला नास करे जाही</para>
  <para style="q2" vid="AMO 7:9">अऊ इसरायल के पबितर-स्थानमन खंडहर करे जाहीं;</para>
  <para style="q2" vid="AMO 7:9">मेंह अपन तलवार लेके राजा यरोबाम के घराना के बिरूध ठाढ़ होहूं।”<verse eid="AMO 7:9" /></para>
  <para style="s1">आमोस अऊ अमसयाह</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />तब बेतेल के पुरोहित अमसयाह ह इसरायल के राजा यरोबाम करा एक संदेस पठोईस: “आमोस ह इसरायल के बीच म तोर बिरूध एक सडयंत्र करत हे। ये देस ह ओकर बातमन ला सहे नइं सकय। <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />काबरकि आमोस ह ये कहत हे:</para>
  <para style="q1" vid="AMO 7:11">“ ‘यरोबाम ह तलवार ले मारे जाही,</para>
  <para style="q2" vid="AMO 7:11">अऊ इसरायल ह अपन जनम भुइयां ले दूरिहा,</para>
  <para style="q2" vid="AMO 7:11">जरूर बंधुवई म चले जाही।’ ”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />तब अमसयाह ह आमोस ले कहिस, “हे अगम-दरसी, इहां ले निकल जा! यहूदा प्रदेस ला वापिस चले जा। उहां कमाके खा अऊ उहां अपन अगमबानी कर। <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />बेतेल म फेर कभू अगमबानी झन करबे, काबरकि येह राजा के पबितर-स्थान अऊ राज के मंदिर अय।”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />आमोस ह अमसयाह ला उत्तर दीस, “मेंह न तो अगमजानी रहेंव अऊ न ही कोनो अगमजानी के बेटा, पर मेंह तो एक चरवाहा रहेंव, अऊ मेंह डूमर रूखमन के देखरेख घलो करेंव। <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />पर यहोवा ह मोला पसुमन ला चराय के काम बर बलाईस अऊ मोला कहिस, ‘जा, मोर मनखे इसरायलीमन ला अगमबानी कर।’ <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />एकरसेति अब यहोवा के बचन ला सुन। तेंह कहिथस,</para>
  <para style="q1" vid="AMO 7:16">“ ‘इसरायल के बिरूध म अगमबानी झन कर,</para>
  <para style="q2" vid="AMO 7:16">अऊ इसहाक के संतानमन के बिरूध म परचार करई ला बंद कर।’<verse eid="AMO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />“एकरसेति यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="AMO 7:17">“ ‘तोर घरवाली ह सहर म एक बेस्या हो जाही,</para>
  <para style="q2" vid="AMO 7:17">अऊ तोर बेटा अऊ बेटीमन तलवार ले मारे जाहीं।</para>
  <para style="q1" vid="AMO 7:17">तोर भुइयां ला नापे जाही अऊ बांट दिये जाही,</para>
  <para style="q2" vid="AMO 7:17">अऊ तेंह खुद मूरती-पूजा करइयामन<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">असुध</char></note> के एक देस म मरबे।</para>
  <para style="q2" vid="AMO 7:17">अऊ इसरायल ह अपन जनम भुइयां वाले देस ले दूरिहा,</para>
  <para style="q2" vid="AMO 7:17">जरूर बंधुवई म चले जाही।’ ”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s1">पाके फरमन के एक टुकनी</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />तब परमपरधान यहोवा ह मोला पाके फरमन के एक ठन टुकनी देखाईस, <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />अऊ ओह मोर ले पुछिस, “हे आमोस, तोला का दिखत हे?”</para>
  <para style="p" vid="AMO 8:2">मेंह जबाब देंव, “पाके फरमन के एक ठन टुकनी।”</para>
  <para style="p" vid="AMO 8:2">तब यहोवा ह मोला कहिस, “मोर मनखे इसरायलीमन के अन्त के समय आ गे हवय; मेंह ओमन ला अब नइं छोड़ंव।”<verse eid="AMO 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3" />परमपरधान यहोवा ह घोसना करत हे, “ओ दिन, मंदिर के गीतमन बिलाप म बदल जाहीं। कतको लासमन एती-ओती पड़े होहीं! अऊ सुनसान हो जाही!”<verse eid="AMO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />ये बात ला सुनव, तुमन, जऊन मन जरूरतमंदमन ला कुचरथव</para>
  <para style="q2" vid="AMO 8:4">अऊ गरीबमन ला देस ले नास करत,<verse eid="AMO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5" />ये कहिथव,</para>
  <para style="q1" vid="AMO 8:5">“नवां चंदा के उत्सव कब खतम होही</para>
  <para style="q2" vid="AMO 8:5">कि हमन अनाज बेच सकन,</para>
  <para style="q1" vid="AMO 8:5">अऊ बिसराम दिन ह कब सिराही</para>
  <para style="q2" vid="AMO 8:5">कि हमन गहूं बेच अऊ बिसो सकन?”—</para>
  <para style="q1" vid="AMO 8:5">कम चीजमन ला तराजू म तऊलके,</para>
  <para style="q2" vid="AMO 8:5">दाम ला बढ़ा देवन</para>
  <para style="q2" vid="AMO 8:5">अऊ लेवइयामन ला बेईमानी के तराजू ले ठगन,<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />अऊ गरीबमन ला चांदी के सिक्का ले,</para>
  <para style="q2" vid="AMO 8:6">अऊ जरूरतमंदमन ला एक जोड़ी चप्पल म बिसोवन,</para>
  <para style="q2" vid="AMO 8:6">अऊ त अऊ कचरा-कुढ़ा ला घलो गहूं म मिलाके बेच देवन।<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />यहोवा जऊन ह याकूब के घमंड अय, ओह खुद के सपथ खाके कहे हवय: “ओमन जऊन कुछू घलो करे हवंय, ओला में कभू नइं भुलावंव।<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />“का येकर बर भुइयां ह नइं कांपही,</para>
  <para style="q2" vid="AMO 8:8">अऊ जेमन येमा रहिथें, ओमन सोक नइं करहीं?</para>
  <para style="q1" vid="AMO 8:8">पूरा देस ह नील नदी कस उफनही;</para>
  <para style="q2" vid="AMO 8:8">येह मिसर देस के नदी सहीं उफनही</para>
  <para style="q2" vid="AMO 8:8">अऊ तब सांत हो जाही।”<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />परमपरधान यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="AMO 8:9">“ओ दिन, मेंह सूरज ला मंझन के बेरा बुड़ो दूहूं</para>
  <para style="q2" vid="AMO 8:9">अऊ मंझन के बेरा धरती ला अंधियार कर दूहूं।<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />मेंह तुम्हर धारमिक तिहारमन ला सोक म</para>
  <para style="q2" vid="AMO 8:10">अऊ तुम्हर जम्मो गीतमन ला रोवई म बदल दूहूं।</para>
  <para style="q1" vid="AMO 8:10">मेंह तुमन जम्मो झन ला बोरा के ओनहा<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सोक के ओनहा</char></note> पहिराहूं</para>
  <para style="q2" vid="AMO 8:10">अऊ तुम्हर मुड़मन ला मुड़ा दूहूं।</para>
  <para style="q1" vid="AMO 8:10">मेंह ओ समय ला अइसन सोकित कर दूहूं, जइसन कि एकलऊता बेटा मरे ले होथे</para>
  <para style="q2" vid="AMO 8:10">अऊ ओकर अन्त ला एक दुख के दिन कस करू कर दूहूं।”<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />परमपरधान यहोवा ह घोसना करत हे, “ओ दिनमन आवत हवंय,</para>
  <para style="q2" vid="AMO 8:11">जब मेंह देस भर म दुकाल पठोहूं—</para>
  <para style="q1" vid="AMO 8:11">ये दुकाल ह जेवन-पानी के नइं,</para>
  <para style="q2" vid="AMO 8:11">पर येह यहोवा के बचन सुने के दुकाल होही।<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />मनखेमन ये समुंदर ले ओ समुंदर तक</para>
  <para style="q2" vid="AMO 8:12">अऊ उत्तर ले लेके पूरब तक भटकत</para>
  <para style="q1" vid="AMO 8:12">यहोवा के बचन ला खोजहीं,</para>
  <para style="q2" vid="AMO 8:12">पर ओमन ओला नइं पाहीं।<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />“ओ दिन,</para>
  <para style="q1" vid="AMO 8:13">“सुघर मुटियारी छोकरीमन अऊ मजबूत जवान छोकरामन</para>
  <para style="q2" vid="AMO 8:13">पीयास के मारे बेहोस हो जाहीं।<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />जऊन मन सामरिया के पाप के कसम खाके कहिथें—</para>
  <para style="q2" vid="AMO 8:14">‘हे दान, तोर देवता के जिनगी के कसम,’</para>
  <para style="q2" vid="AMO 8:14">या, ‘बेरसेबा के देवता के कसम’—</para>
  <para style="q2" vid="AMO 8:14">ओमन अइसन गिरहीं कि फेर कभू नइं उठहीं।”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s1">इसरायल के बिनास होवई</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />मेंह दरसन म परभू ला बेदी के तीर म ठाढ़े देखेंव, अऊ ओह कहिस:</para>
  <para style="q1" vid="AMO 9:1">“खंभामन के टीप ला मार</para>
  <para style="q2" vid="AMO 9:1">कि दुवारमन डोल जावंय।</para>
  <para style="q1" vid="AMO 9:1">ओमन ला जम्मो मनखेमन के मुड़ म गिरा दे;</para>
  <para style="q2" vid="AMO 9:1">जऊन मन बांच जाहीं, ओमन ला मेंह तलवार ले मार डारहूं।</para>
  <para style="q1" vid="AMO 9:1">ओमन म के एको झन घलो भाग नइं सकंय,</para>
  <para style="q2" vid="AMO 9:1">कोनो घलो बच नइं सकंय।<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />चाहे ओमन खंचवा खनके बहुंत गहरई म चले जावंय,</para>
  <para style="q2" vid="AMO 9:2">उहां ले मोर हांथ ह ओमन ला ले आही।</para>
  <para style="q1" vid="AMO 9:2">चाहे ओमन अकास के ऊपर घलो चघ जावंय,</para>
  <para style="q2" vid="AMO 9:2">उहां ले मेंह ओमन ला खाल्हे ले आहूं।<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />चाहे ओमन करमेल पहाड़ के टीप म लुका जावंय,</para>
  <para style="q2" vid="AMO 9:3">मेंह उहां ले ओमन ला खोजके खाल्हे ले आहूं अऊ बंदी बना लूहूं।</para>
  <para style="q1" vid="AMO 9:3">चाहे ओमन मोर ले नजर बचाके समुंदर के पेंदी म लुका जावंय,</para>
  <para style="q2" vid="AMO 9:3">उहां मेंह सांप ला ओमन ला डसे के हुकूम दूहूं।<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />चाहे ओमन बईरीमन के दुवारा बंधुवई म ले जाय जाहीं,</para>
  <para style="q2" vid="AMO 9:4">उहां मेंह तलवार ला हुकूम देके ओमन ला कटवा दूहूं।</para>
  <para style="b" vid="AMO 9:4" />
  <para style="q1" vid="AMO 9:4">“मेंह ओमन ऊपर अपन नजर</para>
  <para style="q2" vid="AMO 9:4">ओमन के भलई करे बर नइं, पर ओमन के हानि करे बर रखहूं।”<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />परभू, सर्वसक्तिमान यहोवा—</para>
  <para style="q1" vid="AMO 9:5">ओह धरती ला छूथे अऊ ओह टघल जाथे,</para>
  <para style="q2" vid="AMO 9:5">अऊ ओमा रहइया जम्मो झन बिलाप करथें;</para>
  <para style="q1" vid="AMO 9:5">जम्मो देस ह नील नदी कस उफनथे,</para>
  <para style="q2" vid="AMO 9:5">अऊ तब मिसर के नदी कस सूखा जाथे;<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />ओह अकास म अपन ऊंचहा महल ला बनाथे,</para>
  <para style="q2" vid="AMO 9:6">अऊ ओकर नीव धरती म रखथे;</para>
  <para style="q1" vid="AMO 9:6">ओह समुंदर के पानी ला बलाथे</para>
  <para style="q2" vid="AMO 9:6">अऊ ओला भुइयां ऊपर ढार देथे—</para>
  <para style="q2" vid="AMO 9:6">यहोवा ओकर नांव ए।<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />“का तुमन इसरायली नो हव</para>
  <para style="q2" vid="AMO 9:7">का मोर बर कूसीमन<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ऊपरी नील नदी के इलाका के मनखेमन</char></note> सहीं नो हव?”</para>
  <para style="q2" vid="AMO 9:7">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="AMO 9:7">“का मेंह इसरायलीमन ला मिसर ले,</para>
  <para style="q2" vid="AMO 9:7">पलिस्तीमन ला कपतोर ले</para>
  <para style="q2" vid="AMO 9:7">अऊ अरामीमन ला कीर ले निकालके नइं लानेंव?<verse eid="AMO 9:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />“सही म परमपरधान यहोवा के नजर ह</para>
  <para style="q2" vid="AMO 9:8">पाप ले भरे राज ऊपर लगे हवय।</para>
  <para style="q1" vid="AMO 9:8">मेंह येला धरती के ऊपर ले</para>
  <para style="q2" vid="AMO 9:8">नास कर दूहूं।</para>
  <para style="q1" vid="AMO 9:8">तभो ले मेंह याकूब के संतानमन ला</para>
  <para style="q2" vid="AMO 9:8">पूरा नास नइं करंव,”</para>
  <para style="q2" vid="AMO 9:8">यहोवा ह घोसना करत हे।<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />“काबरकि मेंह हुकूम दूहूं,</para>
  <para style="q2" vid="AMO 9:9">अऊ मेंह इसरायल के मनखेमन ला</para>
  <para style="q2" vid="AMO 9:9">जम्मो जाति के मनखेमन के बीच म अइसन हलाहूं</para>
  <para style="q1" vid="AMO 9:9">जइसन छननी म अन्न ला हलाय जाथे,</para>
  <para style="q2" vid="AMO 9:9">अऊ भुइयां म एको ठन गोटी नइं गिरय।<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />मोर मनखेमन के बीच ले जम्मो पापीमन</para>
  <para style="q2" vid="AMO 9:10">तलवार ले मारे जाहीं,</para>
  <para style="q1" vid="AMO 9:10">ओ जम्मो, जेमन ये कहिथें,</para>
  <para style="q1" vid="AMO 9:10">‘न तो हमर ऊपर बिपत्ति आही अऊ न ही बिपत्ति ले हमर सामना होही।’<verse eid="AMO 9:10" /></para>
  <para style="s1">इसरायलीमन के फेर स्थापित होवई</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />“ओ दिन म,</para>
  <para style="q1" vid="AMO 9:11">“मेंह दाऊद के गिरे आसरय ला फेर ठीक कर दूहूं—</para>
  <para style="q2" vid="AMO 9:11">मेंह येकर टूटे भीथीमन के मरम्मत करहूं,</para>
  <para style="q2" vid="AMO 9:11">अऊ येकर खंडहरमन ला फेर बनाहूं—</para>
  <para style="q2" vid="AMO 9:11">अऊ येला पहिले के सहीं फेर बना दूहूं,<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />ताकि ओमन एदोम के बांचे मनखेमन ला</para>
  <para style="q2" vid="AMO 9:12">अऊ मोर नांव लेवइया जम्मो जातिमन ला अपन अधीन कर लेवंय,”</para>
  <para style="q2" vid="AMO 9:12">ओ यहोवा ह घोसना करत हे, जऊन ह ये चीजमन ला करही।<verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />“अइसन दिनमन आवत हवंय।” यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="AMO 9:13">“जब नांगर जोतइया ह लुवइया ले,</para>
  <para style="q2" vid="AMO 9:13">अऊ अंगूर खुंदइया ह अंगूर के नार लगइया ले आघू बढ़ जाही।</para>
  <para style="q1" vid="AMO 9:13">नवां अंगूर के रस ह पहाड़मन ले थिपही</para>
  <para style="q2" vid="AMO 9:13">अऊ जम्मो पहाड़ीमन ले बोहा जाही,<verse eid="AMO 9:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14" />अऊ मेंह अपन मनखे इसरायलीमन ला बंधुवई ले वापिस ले आहूं।</para>
  <para style="b" vid="AMO 9:14" />
  <para style="q1" vid="AMO 9:14">“ओमन उजड़े सहरमन ला फेर बनाहीं अऊ ओमा रहे लगहीं।</para>
  <para style="q2" vid="AMO 9:14">ओमन अंगूर के बारी लगाहीं अऊ ओमा के मंद ला पीहीं;</para>
  <para style="q2" vid="AMO 9:14">ओमन बारी लगाहीं अऊ ओकर फर ला खाहीं।<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />मेंह इसरायलीमन ला ओमन के निज देस म बसाहूं,</para>
  <para style="q2" vid="AMO 9:15">अऊ ओमन फेर कभू ओ देस ले निकाले नइं जाहीं,</para>
  <para style="q2" vid="AMO 9:15">जऊन ला मेंह ओमन ला देय हवंव,”</para>
  <para style="m" vid="AMO 9:15">यहोवा तुम्हर परमेसर ह कहत हे।<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>