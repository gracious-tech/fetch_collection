<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">योना</para>
  <para style="toc1">योना के किताब</para>
  <para style="toc2">योना</para>
  <para style="toc3">योना</para>
  <para style="mt1">योना</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s1">योना यहोवा करा ले भागथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />एक दिन, यहोवा के ये बचन अमित्तै के बेटा योना करा आईस: <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />“उठके ओ बड़े नगर नीनवे ला जा, अऊ ओकर बिरूध परचार कर, काबरकि येकर बुरई ह मोर नजर म आ गे हवय।”<verse eid="JON 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3" />पर योना ह यहोवा के आघू ले भाग गीस अऊ तरसीस सहर ला जाय बर निकलिस। ओह खाल्हे कोति यापा नगर म गीस; उहां बंदरगाह म एक पानी जहाज जवइया रिहिस। भाड़ा देके ओह जहाज म चघ गीस ताकि यहोवा मेर ले भागके तरसीस जा सकय।<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />तब यहोवा ह समुंदर म भयानक आंधी चलाईस, अऊ जोरदार तूफान उठिस जेकर कारन जहाज के टूटे के नौबत आ गीस। <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />तब जम्मो डोंगहारमन डराके अपन-अपन देवता ला पुकारे लगिन। अऊ जहाज म लदे सामान ला ओमन समुंदर म फेंके लगिन ताकि जहाज ह हल्का हो जावय।</para>
  <para style="p" vid="JON 1:5">पर योना ह जहाज के खाल्हे भाग म जाके सुत गे रिहिस, अऊ ओह भारी नींद म रिहिस। <verse eid="JON 1:5" /><verse number="6" style="v" sid="JON 1:6" />तब जहाज के कप्तान ह ओकर मेर जाके कहिस, “तेंह कइसे सुतत हस? उठ अऊ अपन देवता ला पुकार! सायद ओह हमर कोति धियान देवय कि हमन नास झन होवन।”<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />तब डोंगहारमन एक-दूसर ला कहिन, “आवव, हमन चिट्ठी डालके पता लगावन कि काकर कारन से ये बिपत्ति आय हवय।” ओमन चिट्ठी डारिन अऊ चिट्ठी ह योना के नांव म निकलिस। <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />तब ओमन योना ले पुछिन, “हमन ला बता कि काकर कारन ये बिपत्ति हमर ऊपर आय हवय? तेंह का बुता करथस? तें कहां ले आवत हस? कोन देस के अस? कोन जाति के मनखे अस?”<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />योना ह जबाब दीस, “मेंह एक इबरी अंव अऊ मेंह यहोवा, स्वरग के परमेसर के उपासना करथंव, जऊन ह समुंदर अऊ जमीन दूनों ला बनाय हवय।”<verse eid="JON 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10" />ये सुनके ओमन डरा गीन अऊ ओमन पुछिन, “तेंह का करे हस?” (ओमन जान डारे रिहिन कि ओह यहोवा मेर ले भाग के आय हे, काबरकि ओह ये बात ओमन ला बता डारे रिहिस।)<verse eid="JON 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 1:11" />समुंदर के लहरामन बढ़तेच जावत रिहिन। तब ओमन ओला पुछिन, “हमन तोर संग का करन, जेकर से समुंदर ह हमर बर सांत हो जाय?”<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />ओह ओमन ला कहिस, “मोला उठाके समुंदर म फेंक दव, तब समुंदर ह सांत हो जाही, काबरकि मेंह जानत हंव कि मोर कारन ही ये भारी तूफान तुम्हर ऊपर आय हवय?”<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />तभो ले, डोंगहारमन जहाज ला समुंदर तीर म ले जाय के बहुंत कोसिस करिन। पर ओमन नइं ले जा सकिन, काबरकि समुंदर के लहरामन पहिली ले अऊ भयंकर हो गे रिहिन। <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />तब ओमन यहोवा ला पुकारके कहिन, “हे यहोवा, किरपा करके ये आदमी के परान लेय के कारन हमन ला नास झन होवन दे। हमन ला एक निरदोस आदमी ला मारे के दोसी झन ठहिरा, काबरकि हे यहोवा, जऊन बात तोला बने लगिस, वइसन तेंह करे हस।” <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />तब ओमन योना ला उठाके समुंदर म फेंक दीन, अऊ समुंदर के भारी लहरामन थम गीन। <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />येला देखके ओमन यहोवा के बहुंतेच भय मानिन, अऊ ओमन यहोवा ला भेंट चघाईन अऊ मन्नत मानिन।<verse eid="JON 1:16" /></para>
  <para style="s1">योना के पराथना</para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />जब योना ला समुंदर म डार दिये गीस, त यहोवा ह एक बड़े मछरी ला ठहिराय रिहिस, जऊन ह योना ला लील डारिस, अऊ योना ह ओ मछरी के पेट म तीन दिन अऊ तीन रात रिहिस।<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="nb">
    <note caller="+" style="f">
      <char style="fr" closed="false">2 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="JON 2:1">2:1</ref></char> ला 1:17, अऊ <char style="xt"><ref loc="JON 2:1-10">2:1‑10</ref></char> ला 2:2‑11गने गे हवय</char>
    </note> <verse number="1" style="v" sid="JON 2:1" />योना ह मछरी के पेट ले यहोवा अपन परमेसर ले पराथना करिस। <verse eid="JON 2:1" /><verse number="2" style="v" sid="JON 2:2" />ओह कहिस:</para>
  <para style="q1" vid="JON 2:2">“अपन संकट म मेंह यहोवा ला पुकारें,</para>
  <para style="q2" vid="JON 2:2">अऊ ओह मोला जबाब दीस।</para>
  <para style="q1" vid="JON 2:2">मिरतू-लोक के गहरई ले मेंह मदद बर पुकारें,</para>
  <para style="q2" vid="JON 2:2">अऊ तेंह मोर पुकार ला सुन लेय।<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />तेंह मोला गहिला म,</para>
  <para style="q2" vid="JON 2:3">समुंदर के गहरई म डाल देय,</para>
  <para style="q2" vid="JON 2:3">अऊ मेंह धारामन के मांझा म पड़े रहेंव;</para>
  <para style="q1" vid="JON 2:3">तोर भड़के धारा अऊ लहरामन</para>
  <para style="q2" vid="JON 2:3">मोर ऊपर ले बोहा गीन।<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />तब मेंह कहेंव, ‘मोला तोर आघू ले</para>
  <para style="q2" vid="JON 2:4">निकाल दिये गे हवय;</para>
  <para style="q1" vid="JON 2:4">तभो ले मेंह फेर</para>
  <para style="q2" vid="JON 2:4">तोर पबितर मंदिर कोति देखहूं।’<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />बुड़ोइया पानी ह मोला डरवात रिहिस,</para>
  <para style="q2" vid="JON 2:5">गहिला पानी मोला घेरे रिहिस;</para>
  <para style="q2" vid="JON 2:5">समुंदरी घांस ह मोर मुड़ म लपटाय रिहिस।<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />मेंह पहाड़ के जरी तक चल दे रहेंव;</para>
  <para style="q2" vid="JON 2:6">मेंह हमेसा बर भुइयां म गड़ गे रहेंव।</para>
  <para style="q1" vid="JON 2:6">पर हे यहोवा मोर परमेसर,</para>
  <para style="q2" vid="JON 2:6">तेंह मोला खंचवा म ले निकाले हस।<verse eid="JON 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />“जब मेंह बेहोस होवत रहेंव,</para>
  <para style="q2" vid="JON 2:7">तब हे यहोवा, मेंह तोला सुरता करेंव,</para>
  <para style="q1" vid="JON 2:7">अऊ मोर पराथना तोर मेर,</para>
  <para style="q2" vid="JON 2:7">तोर पबितर मंदिर म पहुंचिस।<verse eid="JON 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />“जऊन मनखेमन बेकार के मूरतीमन म मन लगाथें</para>
  <para style="q2" vid="JON 2:8">ओमन अपनआप ला परमेसर के मया ले दूरिहा कर लेथें।<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />पर मेंह, ऊंचहा सबद ले परसंसा करके</para>
  <para style="q2" vid="JON 2:9">तोला बलिदान चघाहूं।</para>
  <para style="q1" vid="JON 2:9">जऊन मन्नत मेंह माने हंव, ओला मेंह पूरा करहूं।</para>
  <para style="q2" vid="JON 2:9">मेंह कहिहूं, ‘उद्धार सिरिप यहोवा ही से होथे।’ ”<verse eid="JON 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />तब यहोवा ह ओ बड़े मछरी ला हुकूम दीस, अऊ ओह योना ला सूखा भुइयां म उगल दीस।<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s1">योना के नीनवे सहर जवई</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />तब यहोवा के बचन दूसर बार योना करा आईस: <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />“ओ बड़े नगर नीनवे म जा अऊ जऊन संदेस मेंह तोला दूहूं, ओकर तें उहां परचार कर।”<verse eid="JON 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3" />तब योना ह यहोवा के हुकूम ला मानके नीनवे ला गीस। नीनवे ह एक बहुंत बड़े सहर रिहिस; येमा ले चलके जाय म तीन दिन लगय। <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />योना ह एक दिन तक सहर के भीतर चलिस, अऊ ये परचार करत गीस, “अब ले चालीस दिन के बाद नीनवे ला नास कर दिये जाही।” <verse eid="JON 3:4" /><verse number="5" style="v" sid="JON 3:5" />नीनवे के मनखेमन परमेसर ऊपर बिसवास करिन। उपास रखे के घोसना करे गीस अऊ छोटे ले लेके बड़े मनखे, सबो झन बोरा<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fq" closed="false">बोरा </char><char style="ft" closed="false">याने कि </char><char style="fqa" closed="false">सोक मनाय के ओनहा</char></note> पहिरिन।<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />जब योना के चेतउनी ह नीनवे के राजा के कान म पहुंचिस, त ओह सिंघासन ले उठिस, अपन राज पोसाक ला उतारिस अऊ बोरा ला ओढ़के राख ऊपर बईठ गीस। <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />ओह नीनवे म ये घोसना करवाईस:</para>
  <para style="pmo" vid="JON 3:7">“राजा अऊ ओकर परधानमन के फैसला के मुताबिक:</para>
  <para style="pm" vid="JON 3:7">“कोनो मनखे या पसु, गरूवा-बईला या भेड़-बकरी, कुछू भी चीज झन खावंय; ओमन ला कुछू खाय या पीये बर झन दिये जावय। <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />पर मनखे अऊ पसु दूनों बोरा ओढ़ंय। हर एक झन तुरते परमेसर ला पुकारय। ओमन अपन गलत काम अऊ हिंसा ला छोंड़ंय। <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />कोन जाने? सायद परमेसर ह अपन मन ला बदल ले अऊ अपन भयंकर कोरोध ला छोंड़के हमर ऊपर दया करे अऊ हमन नास होय ले बच जावन।”<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />जब परमेसर ह ओमन के काम ला देखिस कि कइसे ओमन अपन गलत काम ला छोंड़त हवंय, त परमेसर ह अपन ईछा ला बदल दीस अऊ ओमन के ऊपर ओ बिनास नइं लानिस, जेला लाने के ओह ठाने रिहिस।<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s1">परमेसर के दया ऊपर योना के कोरोध</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />परमेसर के ये बात ह योना ला बहुंतेच गलत लगिस अऊ ओह गुस्सा हो गीस। <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />ओह यहोवा ले पराथना करिस, “हे यहोवा, का मेंह ये नइं कहे रहेंव, जब मेंह अपन घर म रहेंव? एकरे कारन तरसीस कोति भागे के दुवारा मेंह अन्दाजा लगाय के कोसिस करेंव। मेंह जानत रहेंव कि तेंह अनुग्रहकारी अऊ दयालु परमेसर अस; तेंह देरी से कोरोध करइया अऊ मया ले भरे हवस; तें अइसे परमेसर अस, जऊन ह बिपत्ति डाले नइं चाहय। <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />हे यहोवा, अब तें मोर परान लेय ले, काबरकि मोर जीयत रहई ले मर जवई ह बने बात अय।”<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />पर यहोवा ह जबाब दीस, “का तोर कोरोध करई ह सही अय?”<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />तब योना ह निकलके ओ सहर के पूरब कोति एक जगह म बईठ गीस। उहां ओह अपन बर एक छाजन बनाईस अऊ ओकर छइहां म बईठके इंतजार करे लगिस कि अब सहर के का होही? <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />तब यहोवा परमेसर ह पान-पतईवाला एक पऊधा<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">ये पऊधा के एकदम सही जानकारी नइं ए</char></note> ला उगाईस अऊ अइसन बढ़ा दीस कि ओकर ले योना के मुड़ म छइहां हो जाय अऊ ओला असुबिधा झन होवय, अऊ योना ह ओ पऊधा के कारन बहुंत खुस हो गीस। <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />पर ओकर दूसर दिन, बिहनियां परमेसर ह एक ठन कीरा ला भेजिस, जऊन ह ओ पऊधा ला कुतर दीस, जेकर से ओ पऊधा ह सूखा गीस। <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />जब सूरज निकलिस, त परमेसर ह झुलसा देवइया पुरवई हवा चलाईस, अऊ घाम ह योना के मुड़ म पड़े लगिस, जेकर से ओह बेहोस होय लगिस। योना ह मर जाय के ईछा करत कहिस, “बने होतिस कि मेंह जीयत रहे के बदले मर जातेंव।”<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />पर परमेसर ह योना ला कहिस, “का ओ पऊधा बर कोरोध करई तोर बर उचित अय?”</para>
  <para style="p" vid="JON 4:9">ओह कहिस, “हव, उचित अय। मेंह अतेक गुस्सा म हंव कि मरे के मन होवत हे।”<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />पर यहोवा ह कहिस, “तेंह ये पऊधा बर चिंता करत हस, जेकर तेंह न तो देखभाल करे रहय अऊ न ही तें ओला बढ़ाय रहय। येह रथिया भर म निकलिस अऊ रथिया भर म मर घलो गीस। <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />त फेर का में ये बड़े सहर नीनवे के चिंता नइं करंव, जेमा एक लाख बीस हजार ले जादा मनखे हवंय अऊ जेमन अपन डेरी-जेवनी हांथ के भेद ला नइं जानंय—अऊ ये सहर म बहुंत पसु भी हवंय?”<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>