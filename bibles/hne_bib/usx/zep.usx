<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">सपनयाह</para>
  <para style="toc1">सपनयाह के किताब</para>
  <para style="toc2">सपनयाह</para>
  <para style="toc3">सप</para>
  <para style="mt1">सपनयाह</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="ZEP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1"/>आमोन के बेटा, यहूदा प्रदेस के राजा योसियाह के सासनकाल म यहोवा के बचन ह सपनयाह करा आईस; सपनयाह ह कूसी के बेटा, कूसी ह गदलयाह के बेटा, गदलयाह ह अमरयाह के बेटा अऊ अमरयाह ह हिजकियाह के बेटा रिहिस:<verse eid="ZEP 1:1"/></para>
  <para style="b"/>
  <para style="s1">यहोवा के दिन जम्मो धरती ऊपर नियाय</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2"/>“मेंह धरती के</para>
  <para style="q2" vid="ZEP 1:2">जम्मो चीज ला नास करहूं,”</para>
  <para style="q2" vid="ZEP 1:2">यहोवा ह घोसना करत हे।<verse eid="ZEP 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3"/>“मेंह मनखे अऊ पसु दूनों ला नास कर दूहूं;</para>
  <para style="q2" vid="ZEP 1:3">मेंह अकास के चिरई</para>
  <para style="q2" vid="ZEP 1:3">अऊ समुंदर के मछरीमन ला नास कर दूहूं—</para>
  <para style="q2" vid="ZEP 1:3">अऊ मूरतीमन ला नास कर दूहूं, जेमन दुस्ट मनखे के गिरे के कारन बनथें।”</para>
  <para style="b" vid="ZEP 1:3"/>
  <para style="q1" vid="ZEP 1:3">“जब में जम्मो मानव-जाति ला</para>
  <para style="q2" vid="ZEP 1:3">धरती ले मिटा दूहूं,”</para>
  <para style="q2" vid="ZEP 1:3">यहोवा ह घोसना करत हे,<verse eid="ZEP 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4"/>“तब मेंह यहूदा के बिरूध</para>
  <para style="q2" vid="ZEP 1:4">अऊ यरूसलेम के जम्मो रहइयामन के बिरूध अपन हांथ बढ़ाहूं।</para>
  <para style="q1" vid="ZEP 1:4">मेंह ये ठऊर ले बाल देवता के उपासना करइया जम्मो बांचे मनखेमन ला,</para>
  <para style="q2" vid="ZEP 1:4">अऊ मूरती-पूजा करइया जम्मो पुरोहितमन के नांव ला घलो मेटा दूहूं—<verse eid="ZEP 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5"/>जऊन मन अपन घर के छानीमन म</para>
  <para style="q2" vid="ZEP 1:5">अकास के तारामन ला गिरके दंडवत करथें,</para>
  <para style="q1" vid="ZEP 1:5">जऊन मन झुकके यहोवा के कसम खाथें</para>
  <para style="q2" vid="ZEP 1:5">अऊ जऊन मन मोलेक<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">मल्काम</char></note> देवता के घलो कसम खाथें,<verse eid="ZEP 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6"/>जेमन यहोवा के पाछू चले बर छोंड़ देथें</para>
  <para style="q2" vid="ZEP 1:6">अऊ न तो यहोवा के खोज करथें अऊ न ही ओकर ईछा जाने के कोसिस करथें,</para>
  <para style="q2" vid="ZEP 1:6">ओ जम्मो ला मेटा दूहूं।”<verse eid="ZEP 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7"/>परमपरधान यहोवा के आघू म चुपे रहव,</para>
  <para style="q2" vid="ZEP 1:7">काबरकि यहोवा के दिन ह लकठा म हवय।</para>
  <para style="q1" vid="ZEP 1:7">यहोवा ह एक बलिदान तियार करे हवय;</para>
  <para style="q2" vid="ZEP 1:7">ओह ओमन ला पबितर करे हवय, जेमन ला ओह नेवता देय हवय।<verse eid="ZEP 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8"/>“यहोवा के ठहिराय बलिदान के दिन</para>
  <para style="q2" vid="ZEP 1:8">मेंह अधिकारीमन ला</para>
  <para style="q2" vid="ZEP 1:8">अऊ राजामन के बेटामन ला</para>
  <para style="q1" vid="ZEP 1:8">अऊ ओ जम्मो जेमन बिदेसी ओनहा पहिरथें</para>
  <para style="q2" vid="ZEP 1:8">ओ जम्मो झन ला सजा दूहूं।<verse eid="ZEP 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9"/>ओ दिन मेंह ओमन ला सजा दूहूं</para>
  <para style="q2" vid="ZEP 1:9">जऊन मन मंदिर के दुवार म आय ले बचथें,<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="1SA 5:5">1 समू 5:5</ref></char></char></note></para>
  <para style="q1" vid="ZEP 1:9">जऊन मन अपन देवतामन के मंदिर ला</para>
  <para style="q2" vid="ZEP 1:9">हिंसा अऊ छल ले भर देथें।<verse eid="ZEP 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10"/>“ओ दिन”</para>
  <para style="q2" vid="ZEP 1:10">यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="ZEP 1:10">“मछरी दुवार ले पुकारे के</para>
  <para style="q2" vid="ZEP 1:10">अऊ नवां निवास ले बिलाप के</para>
  <para style="q2" vid="ZEP 1:10">अऊ पहाड़ीमन ले बहुंत जोर से धमाका के अवाज सुनई दीही।<verse eid="ZEP 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11"/>तुमन, जेमन बजारवाले<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">बेपारीमन के मुख्य ठऊर, जिहां सामान बिसाय अऊ बेचे जावय</char></note> इलाका म रहिथव, बिलाप करव;</para>
  <para style="q2" vid="ZEP 1:11">तुम्हर सबो बेपारीमन ला,</para>
  <para style="q2" vid="ZEP 1:11">ओ जम्मो ला, जेमन चांदी के बेपार करथें, नास कर दिये जाही।<verse eid="ZEP 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12"/>ओ समय, मेंह दीया धरके यरूसलेम म खोजहूं,</para>
  <para style="q2" vid="ZEP 1:12">अऊ ओमन ला दंड दूहूं, जेमन अपनआप म खुस हवंय,</para>
  <para style="q2" vid="ZEP 1:12">जेमन पेंदी म छोंड़े गय अंगूर के मंद के मईल कस अंय,</para>
  <para style="q1" vid="ZEP 1:12">जेमन ये सोचथें, ‘यहोवा ह कुछू नइं करही,</para>
  <para style="q2" vid="ZEP 1:12">न भलई करही अऊ न ही बुरई।’<verse eid="ZEP 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13"/>ओमन के धन-दौलत लूट लिये जाही,</para>
  <para style="q2" vid="ZEP 1:13">ओमन के घरमन गिर जाहीं।</para>
  <para style="q1" vid="ZEP 1:13">हालाकि ओमन घर बनाहीं,</para>
  <para style="q2" vid="ZEP 1:13">पर ओमन ओमा रहे बर नइं पाहीं;</para>
  <para style="q1" vid="ZEP 1:13">हालाकि ओमन अंगूर के बारी लगाहीं,</para>
  <para style="q2" vid="ZEP 1:13">पर ओमन ओकर ले अंगूर के मंद पीये बर नइं पाहीं।”<verse eid="ZEP 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14"/>यहोवा के भयानक दिन ह लकठा म हवय—</para>
  <para style="q2" vid="ZEP 1:14">येह लकठा म हवय अऊ जल्दी आवत हे।</para>
  <para style="q1" vid="ZEP 1:14">यहोवा के दिन के रोवई ह भयंकर ए;</para>
  <para style="q2" vid="ZEP 1:14">बड़े बीर घलो दुख के मारे चिचियाथे।<verse eid="ZEP 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15"/>ओ दिन ह कोप के दिन होही—</para>
  <para style="q2" vid="ZEP 1:15">संकट अऊ पीरा के दिन,</para>
  <para style="q3" vid="ZEP 1:15">समस्या अऊ बिनास के दिन,</para>
  <para style="q2" vid="ZEP 1:15">अंधियार अऊ उदासी के दिन,</para>
  <para style="q3" vid="ZEP 1:15">करिया बादर अऊ अंधियार के दिन होही—<verse eid="ZEP 1:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="ZEP 1:16"/>गढ़वाले सहरमन के बिरूध</para>
  <para style="q1" vid="ZEP 1:16">अऊ कोनटा के मीनारमन के बिरूध</para>
  <para style="q2" vid="ZEP 1:16">ओह तुरही फूंके अऊ लड़ई के ललकार के दिन होही।<verse eid="ZEP 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17"/>“मेंह जम्मो मनखेमन ऊपर अइसन बिपत्ति लानहूं</para>
  <para style="q2" vid="ZEP 1:17">कि ओमन अंधरा मनखे कस टमड़हीं,</para>
  <para style="q2" vid="ZEP 1:17">काबरकि ओमन यहोवा के बिरोध म पाप करे हवंय।</para>
  <para style="q1" vid="ZEP 1:17">ओमन के लहू ला धुर्रा कस</para>
  <para style="q2" vid="ZEP 1:17">अऊ ओमन के अंतड़ी ला गोबर कस फटिक दिये जाही।<verse eid="ZEP 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18"/>यहोवा के कोप के दिन</para>
  <para style="q2" vid="ZEP 1:18">न तो ओमन के सोन</para>
  <para style="q2" vid="ZEP 1:18">अऊ न ही ओमन के चांदी ओमन ला बचा सकही।”</para>
  <para style="b" vid="ZEP 1:18"/>
  <para style="q1" vid="ZEP 1:18">ओकर जलन के आगी म</para>
  <para style="q2" vid="ZEP 1:18">जम्मो धरती ह भसम हो जाही,</para>
  <para style="q1" vid="ZEP 1:18">काबरकि ओह ओ जम्मो के अचानक अन्त कर दीही</para>
  <para style="q2" vid="ZEP 1:18">जेमन धरती म रहिथें।<verse eid="ZEP 1:18"/></para>
  <chapter eid="ZEP 1"/>
  <chapter number="2" style="c" sid="ZEP 2"/>
  <para style="s1">आने मनखेमन संग यहूदा अऊ यरूसलेम के नियाय</para>
  <para style="s2">यहूदा ला मन-फिराय के बुलावा</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1"/>हे बेसरम जाति के मनखेमन,</para>
  <para style="q2" vid="ZEP 2:1">एक संग जूरव, तुमन एक संग जूरव,<verse eid="ZEP 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2"/>एकर पहिली कि हुकूम ह लागू होवय</para>
  <para style="q2" vid="ZEP 2:2">अऊ दिन ह भूंसा कस निकल जावय,</para>
  <para style="q1" vid="ZEP 2:2">एकर पहिली कि यहोवा के भयंकर कोरोध ह तुम्हर ऊपर भड़कय,</para>
  <para style="q1" vid="ZEP 2:2">एकर पहिली कि यहोवा के कोप के दिन ह</para>
  <para style="q2" vid="ZEP 2:2">तुम्हर ऊपर आ जावय।<verse eid="ZEP 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3"/>तुमन जम्मो, जेमन देस के नम्र मनखे अव,</para>
  <para style="q2" vid="ZEP 2:3">तुमन जेमन यहोवा के हुकूम ला मानथव, यहोवा के खोज म रहव।</para>
  <para style="q1" vid="ZEP 2:3">धरमीपन के खोज म रहव, नम्र बनव;</para>
  <para style="q2" vid="ZEP 2:3">सायद यहोवा के कोप के दिन म</para>
  <para style="q2" vid="ZEP 2:3">तुमन ला आसरय मिल जावय।<verse eid="ZEP 2:3"/></para>
  <para style="s2">पलिस्ती</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4"/>गाजा सहर ला तियाग देय जाही,</para>
  <para style="q2" vid="ZEP 2:4">अऊ अस्कलोन सहर ह बरबाद हो जाही</para>
  <para style="q1" vid="ZEP 2:4">असदोद सहर ला मंझनियां खाली कर देय जाही,</para>
  <para style="q2" vid="ZEP 2:4">अऊ एकरोन सहर ला उखान देय जाही।<verse eid="ZEP 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5"/>तुमन ऊपर हाय, जेमन समुंदर तीर म रहिथव,</para>
  <para style="q2" vid="ZEP 2:5">हे करेती मनखेमन, तुमन ऊपर हाय;</para>
  <para style="q1" vid="ZEP 2:5">हे कनान, पलिस्तीमन के देस,</para>
  <para style="q2" vid="ZEP 2:5">यहोवा के बचन ह तोर बिरूध हवय।</para>
  <para style="q1" vid="ZEP 2:5">ओह कहिथे, “मेंह तुमन ला नास कर दूहूं,</para>
  <para style="q2" vid="ZEP 2:5">कोनो नइं बांचय।”<verse eid="ZEP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6"/>समुंदर तीर के भुइयां ह चरागन हो जाही,</para>
  <para style="q2" vid="ZEP 2:6">जिहां चरवाहामन बर कुआं</para>
  <para style="q2" vid="ZEP 2:6">अऊ पसु के झुंड बर बाड़ा होही।<verse eid="ZEP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7"/>ओ देस ह यहूदा के घराना के</para>
  <para style="q2" vid="ZEP 2:7">बांचे मनखेमन के देस होही;</para>
  <para style="q2" vid="ZEP 2:7">उहां ओमन ला चरागन मिलही।</para>
  <para style="q1" vid="ZEP 2:7">सांझ के बेरा, ओमन अस्कलोन के</para>
  <para style="q2" vid="ZEP 2:7">घरमन म लेटके अराम करहीं।</para>
  <para style="q1" vid="ZEP 2:7">यहोवा ओमन के परमेसर ह उहां ओमन के देखरेख करही;</para>
  <para style="q2" vid="ZEP 2:7">ओह ओमन के धन-दौलत ला घलो लहुंटाही।<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बंधुवई म गय ओमन के मनखेमन ला लहुंटा लानही</char></note><verse eid="ZEP 2:7"/></para>
  <para style="s2">मोआब अऊ अमोन</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8"/>“मेंह मोआबीमन के बेजत्ती के बात</para>
  <para style="q2" vid="ZEP 2:8">अऊ अमोनीमन के ताना ला सुने हंव,</para>
  <para style="q1" vid="ZEP 2:8">ओमन मोर मनखेमन के बेजत्ती करिन</para>
  <para style="q2" vid="ZEP 2:8">अऊ ओमन के देस ला छीन लेय के धमकी दीन।<verse eid="ZEP 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9"/>एकरसेति, मोर जिनगी के सपथ,”</para>
  <para style="q2" vid="ZEP 2:9">सर्वसक्तिमान यहोवा,</para>
  <para style="q2" vid="ZEP 2:9">इसरायल के परमेसर ह घोसना करत हे,</para>
  <para style="q1" vid="ZEP 2:9">“सही म मोआब ह सदोम कस,</para>
  <para style="q2" vid="ZEP 2:9">अऊ अमोनीमन अमोरा कस हो जाहीं—</para>
  <para style="q1" vid="ZEP 2:9">येमन कांदी-कचरा के ठऊर अऊ नून के खंचवामन हो जाहीं,</para>
  <para style="q2" vid="ZEP 2:9">येमन हमेसा बर उजड़ जाहीं।</para>
  <para style="q1" vid="ZEP 2:9">मोर बांचे मनखेमन ओमन ला लूट लीहीं;</para>
  <para style="q2" vid="ZEP 2:9">मोर जाति के बांचे मनखेमन ओमन के देस ऊपर अधिकार कर लीहीं।”<verse eid="ZEP 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10"/>ओमन के घमंड करे अऊ सर्वसक्तिमान यहोवा के मनखेमन के</para>
  <para style="q2" vid="ZEP 2:10">अपमान करे अऊ हंसी उड़ाय के</para>
  <para style="q2" vid="ZEP 2:10">ओमन ला ये परतिफल मिलही।<verse eid="ZEP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11"/>यहोवा के भय ओमन म पईदा होही</para>
  <para style="q2" vid="ZEP 2:11">जब यहोवा ह धरती के जम्मो देवतामन ला नास कर दीही।</para>
  <para style="q1" vid="ZEP 2:11">दूरिहा-दूरिहा के जाति-जाति के जम्मो मनखेमन अपन-अपन देस म</para>
  <para style="q2" vid="ZEP 2:11">यहोवा ला झुकके दंडवत करहीं।<verse eid="ZEP 2:11"/></para>
  <para style="s2">कूस</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12"/>“हे कूसी मनखेमन,<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">नील नदी के ऊपरी इलाका के मनखेमन</char></note> तुमन घलो</para>
  <para style="q2" vid="ZEP 2:12">मोर तलवार ले मारे जाहू।”<verse eid="ZEP 2:12"/></para>
  <para style="s2">अस्सूर</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13"/>यहोवा ह उत्तर दिग के बिरूध अपन हांथ बढ़ाही</para>
  <para style="q2" vid="ZEP 2:13">अऊ अस्सूर देस ला नास कर दीही,</para>
  <para style="q1" vid="ZEP 2:13">अऊ नीनवे सहर ला पूरा उजारके</para>
  <para style="q2" vid="ZEP 2:13">मरू-भुइयां सहीं सूखा छोंड़ दीही।<verse eid="ZEP 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14"/>गरूवा-बईला अऊ भेड़-बकरीमन</para>
  <para style="q2" vid="ZEP 2:14">अऊ जम्मो किसम के जीव-जन्तुमन उहां अराम करहीं।</para>
  <para style="q1" vid="ZEP 2:14">ओकर खंभामन म मरू-भुइयां के उल्लू</para>
  <para style="q2" vid="ZEP 2:14">अऊ चिचियानेवाला उल्लूमन बसेरा करहीं।</para>
  <para style="q1" vid="ZEP 2:14">खिड़कीमन ले ओ उल्लूमन के अवाज सुनई दीही,</para>
  <para style="q2" vid="ZEP 2:14">पथरा के कुटामन ले कपाट के रसतामन भर जाहीं,</para>
  <para style="q2" vid="ZEP 2:14">देवदार लकरी के बल्लामन उघर जाहीं।<verse eid="ZEP 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15"/>येह ओ चहल-पहल वाले सहर के स्थिति अय</para>
  <para style="q2" vid="ZEP 2:15">जऊन ह एक समय सुरकछित रिहिस।</para>
  <para style="q1" vid="ZEP 2:15">ओह अपनआप ला कहय,</para>
  <para style="q2" vid="ZEP 2:15">“मेंह अकेला अंव! मोला छोंड़ अऊ कोनो दूसरा नइं ए।”</para>
  <para style="q1" vid="ZEP 2:15">अब ओह कइसन उजर गे हवय,</para>
  <para style="q2" vid="ZEP 2:15">जंगली पसुमन के एक मांद बन गे हवय!</para>
  <para style="q1" vid="ZEP 2:15">ओ जम्मो, जेमन उहां ले होके जाथें,</para>
  <para style="q2" vid="ZEP 2:15">ओमन एकर हंसी उड़ाथें अऊ अपन हांथ ला झटकारथें।<verse eid="ZEP 2:15"/></para>
  <chapter eid="ZEP 2"/>
  <chapter number="3" style="c" sid="ZEP 3"/>
  <para style="s2">यरूसलेम</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1"/>दुख देवइया, बिदरोही</para>
  <para style="q2" vid="ZEP 3:1">अऊ असुध मनखेमन के सहर ऊपर हाय!<verse eid="ZEP 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2"/>ओह काकरो बात ला नइं मानय,</para>
  <para style="q2" vid="ZEP 3:2">अऊ न ही काकरो सलाह ला स्वीकार करय।</para>
  <para style="q1" vid="ZEP 3:2">ओह यहोवा ऊपर भरोसा नइं करय,</para>
  <para style="q2" vid="ZEP 3:2">ओह अपन परमेसर के लकठा म नइं आवय।<verse eid="ZEP 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3"/>ओकर अधिकारीमन ओकर भीतर</para>
  <para style="q2" vid="ZEP 3:3">दहाड़त सेर कस,</para>
  <para style="q1" vid="ZEP 3:3">अऊ ओकर सासन करइयामन सांझ के बेरा सिकार करइया ओ भेड़ियामन कस अंय,</para>
  <para style="q2" vid="ZEP 3:3">जेमन बिहनियां बर कुछू ला नइं बचांय।<verse eid="ZEP 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4"/>ओकर अगमजानीमन सही मनखे नो हंय;</para>
  <para style="q2" vid="ZEP 3:4">ओमन बिसवासघाती अंय।</para>
  <para style="q1" vid="ZEP 3:4">ओकर पुरोहितमन पबितर-स्थान ला अपबितर करथें</para>
  <para style="q2" vid="ZEP 3:4">अऊ ओमन कानून ला टोरथें।<verse eid="ZEP 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5"/>यहोवा, जऊन ह ओकर भीतर हवय, ओह धरमी अय;</para>
  <para style="q2" vid="ZEP 3:5">ओह कोनो गलत काम नइं करय।</para>
  <para style="q1" vid="ZEP 3:5">रोज बिहनियां ओह अपन नियाय ला परगट करथे,</para>
  <para style="q2" vid="ZEP 3:5">अऊ कोनो दिन ओह कोनो बात म नइं चुकय,</para>
  <para style="q2" vid="ZEP 3:5">तभो ले अधरमीमन ला लाज नइं आवय।<verse eid="ZEP 3:5"/></para>
  <para style="s2">यरूसलेम के मनखेमन पछताप नइं करिन</para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6"/>“मेंह जाति-जाति के मनखेमन ला नास करे हंव;</para>
  <para style="q2" vid="ZEP 3:6">अऊ ओमन के गढ़मन ला गिरा देय गे हवय।</para>
  <para style="q1" vid="ZEP 3:6">मेंह ओमन के गलीमन ला सुन्ना कर दे हंव,</para>
  <para style="q2" vid="ZEP 3:6">अऊ ओ गलीमन ले होके कोनो नइं जावंय।</para>
  <para style="q1" vid="ZEP 3:6">ओमन के सहरमन उजर गे हवंय;</para>
  <para style="q2" vid="ZEP 3:6">ओमन ला छोंड़ देय गे हवय अऊ ओमन खाली हवंय।<verse eid="ZEP 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7"/>यरूसलेम के बारे म मोर ये बिचार रिहिस,</para>
  <para style="q2" vid="ZEP 3:7">‘तेंह जरूर मोर भय मानबे</para>
  <para style="q2" vid="ZEP 3:7">अऊ मोर सलाह ला मानबे!’</para>
  <para style="q1" vid="ZEP 3:7">तब ओकर सरन-स्थान ला न तो नास करे जातिस,</para>
  <para style="q2" vid="ZEP 3:7">अऊ न ही मोर कोनो दंड ओमन ऊपर आतिस,</para>
  <para style="q1" vid="ZEP 3:7">पर ओमन तब भी अपन जम्मो काम म</para>
  <para style="q2" vid="ZEP 3:7">उत्सुक होके बुरई के काम करे लगिन।<verse eid="ZEP 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8"/>एकर कारन मोर बर ओ दिन के इंतजार करव,” यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="ZEP 3:8">“जब मेंह गवाही देय बर ठाढ़ होहूं।</para>
  <para style="q1" vid="ZEP 3:8">मेंह ठान ले हंव कि मेंह जाति-जाति के मनखे,</para>
  <para style="q2" vid="ZEP 3:8">अऊ राज-राज के मनखेमन ला इकट्ठा करहूं</para>
  <para style="q1" vid="ZEP 3:8">अऊ ओमन ऊपर अपन कोप परगट करहूं—</para>
  <para style="q2" vid="ZEP 3:8">मोर पूरा भयानक गुस्सा।</para>
  <para style="q1" vid="ZEP 3:8">मोर जलन के कोरोध के आगी ले</para>
  <para style="q2" vid="ZEP 3:8">पूरा संसार ह जलके नास हो जाही।<verse eid="ZEP 3:8"/></para>
  <para style="s1">इसरायल के बांचे भाग के फेर स्थापित होवई</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9"/>“तब में मनखेमन के ओंठ ला सुध करहूं,</para>
  <para style="q2" vid="ZEP 3:9">ताकि ओमन जम्मो झन यहोवा के नांव ला पुकारंय</para>
  <para style="q2" vid="ZEP 3:9">अऊ कंधा ले कंधा मिलाके ओकर सेवा करंय।<verse eid="ZEP 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10"/>कूस के नदीमन के ओ पार ले</para>
  <para style="q2" vid="ZEP 3:10">मोर अराधना करइया, मोर तितिर-बितिर होय मनखेमन</para>
  <para style="q2" vid="ZEP 3:10">मोर बर चढ़ावा लानहीं।<verse eid="ZEP 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11"/>हे यरूसलेम, ओ दिन, तोला मोर बिरूध करे गय</para>
  <para style="q2" vid="ZEP 3:11">खराप काम के कारन लज्जित होय बर नइं पड़य,</para>
  <para style="q1" vid="ZEP 3:11">काबरकि मेंह तोर बीच ले</para>
  <para style="q2" vid="ZEP 3:11">तोर जिद्दी घमंडी मनखेमन ला निकाल दूहूं।</para>
  <para style="q1" vid="ZEP 3:11">अऊ तेंह मोर पबितर पहाड़ी ऊपर</para>
  <para style="q2" vid="ZEP 3:11">फेर कभू घमंड नइं करबे।<verse eid="ZEP 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12"/>पर मेंह तुम्हर बीच म</para>
  <para style="q2" vid="ZEP 3:12">सिरिप नम्र अऊ दीन मनखेमन ला रहन दूहूं।</para>
  <para style="q1" vid="ZEP 3:12">इसरायल के बांचे मनखेमन</para>
  <para style="q2" vid="ZEP 3:12">यहोवा के नांव म भरोसा करहीं।<verse eid="ZEP 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13"/>ओमन कोनो गलत काम नइं करहीं;</para>
  <para style="q2" vid="ZEP 3:13">ओमन लबारी नइं मारहीं।</para>
  <para style="q1" vid="ZEP 3:13">ओमन के मुहूं ले</para>
  <para style="q2" vid="ZEP 3:13">कोनो छल के बात नइं निकलही।</para>
  <para style="q1" vid="ZEP 3:13">ओमन खाहीं अऊ अराम करहीं</para>
  <para style="q2" vid="ZEP 3:13">अऊ कोनो ओमन ला नइं डराहीं।”<verse eid="ZEP 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14"/>हे बेटी सियोन, गा;</para>
  <para style="q2" vid="ZEP 3:14">हे इसरायल, जय-जयकार कर!</para>
  <para style="q1" vid="ZEP 3:14">हे बेटी यरूसलेम,</para>
  <para style="q2" vid="ZEP 3:14">खुसी रह अऊ अपन पूरा मन से आनंद मना!<verse eid="ZEP 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15"/>यहोवा ह तोर दंड ला दूरिहा कर दे हवय,</para>
  <para style="q2" vid="ZEP 3:15">ओह तोर बईरीमन ला हटा दे हवय।</para>
  <para style="q1" vid="ZEP 3:15">यहोवा, इसरायल के राजा ह तोर संग हवय;</para>
  <para style="q2" vid="ZEP 3:15">फेर कभू तोला कोनो हानि के डर नइं होही।<verse eid="ZEP 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16"/>ओ दिन</para>
  <para style="q2" vid="ZEP 3:16">ओमन यरूसलेम ले कहिहीं,</para>
  <para style="q1" vid="ZEP 3:16">“हे सियोन, झन डर;</para>
  <para style="q2" vid="ZEP 3:16">तोर हांथ ह दुरबल झन होवय।<verse eid="ZEP 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17"/>यहोवा, तोर परमेसर ह तोर संग हवय,</para>
  <para style="q2" vid="ZEP 3:17">ओह बड़े सूरबीर अय, जऊन ह तोला बचाथे।</para>
  <para style="q1" vid="ZEP 3:17">ओह तोर कारन बहुंत आनंदित होही;</para>
  <para style="q2" vid="ZEP 3:17">अपन मया म ओह तोला फेर कभू नइं डांटही,</para>
  <para style="q2" vid="ZEP 3:17">पर तोर कारन ओह गीत गावत आनंदित होही।”<verse eid="ZEP 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18"/>“मेंह ओ सबो झन ला तोर बीच ले हटा दूहूं</para>
  <para style="q2" vid="ZEP 3:18">जऊन मन तोर ठहिराय तिहारमन के हट जाय के कारन दुखी हवंय,</para>
  <para style="q2" vid="ZEP 3:18">जऊन ह तोर बर एक बोझा अऊ कलंक अय।<verse eid="ZEP 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19"/>ओ समय मेंह ओ जम्मो झन ले लेखा लूहूं</para>
  <para style="q2" vid="ZEP 3:19">जेमन तोला दुख देय रिहिन।</para>
  <para style="q1" vid="ZEP 3:19">मेंह खोरवा मनखे ला बचाहूं;</para>
  <para style="q2" vid="ZEP 3:19">अऊ बंधुवामन ला संकेलहूं।</para>
  <para style="q1" vid="ZEP 3:19">मेंह ओमन ला हर ओ देस म महिमा अऊ आदर दूहूं</para>
  <para style="q2" vid="ZEP 3:19">जिहां ओमन लज्जित होवत रिहिन।<verse eid="ZEP 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20"/>ओ समय मेंह तुमन ला संकेलहूं;</para>
  <para style="q2" vid="ZEP 3:20">ओ समय मेंह तुमन ला घर ले आनहूं।</para>
  <para style="q1" vid="ZEP 3:20">मेंह धरती के जम्मो मनखेमन के बीच</para>
  <para style="q2" vid="ZEP 3:20">तुमन ला आदर अऊ महिमा दूहूं</para>
  <para style="q1" vid="ZEP 3:20">जब मेंह तुम्हर आंखी के आघू म</para>
  <para style="q2" vid="ZEP 3:20">तुम्हर खुसहाली जिनगी ला लहुंटा लानहूं,”<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">तुम्हर बंधुवामन ला लहुंटाके ले आनहूं</char></note></para>
  <para style="q2" vid="ZEP 3:20">यहोवा ह कहत हे।<verse eid="ZEP 3:20"/></para>
  <chapter eid="ZEP 3"/>
</usx>
