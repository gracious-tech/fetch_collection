<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">नहूम</para>
  <para style="toc1">नहूम के किताब</para>
  <para style="toc2">नहूम</para>
  <para style="toc3">नहू</para>
  <para style="mt1">नहूम</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />नीनवे सहर के बारे म अगमबानी। एलकोस के रहइया नहूम के दरसन के किताब।<verse eid="NAM 1:1" /></para>
  <para style="b" />
  <para style="s1">नीनवे सहर के बिरूध यहोवा के कोरोध</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />यहोवा जलन रखइया अऊ बदला लेवइया परमेसर अय;</para>
  <para style="q2" vid="NAM 1:2">यहोवा बदला लेथे अऊ कोरोध ले भरे हवय।</para>
  <para style="q1" vid="NAM 1:2">यहोवा अपन बईरीमन ले बदला लेथे</para>
  <para style="q2" vid="NAM 1:2">अऊ अपन कोरोध अपन बईरीमन के बिरूध देखाथे।<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />यहोवा ह कोरोध करे म धीमा, पर सामर्थ म बड़े अय;</para>
  <para style="q2" vid="NAM 1:3">यहोवा दुस्टमन ला दंड देय बिगर नइं छोंड़ही।</para>
  <para style="q1" vid="NAM 1:3">ओकर रद्दा ह बवंडर अऊ आंधी म ले होके जाथे,</para>
  <para style="q2" vid="NAM 1:3">अऊ बादरमन ओकर गोड़ के धुर्रा अंय।<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />ओह समुंदर ला दबकारथे अऊ ओला सूखा देथे;</para>
  <para style="q2" vid="NAM 1:4">ओह जम्मो नदीमन ला सूखा देथे।</para>
  <para style="q1" vid="NAM 1:4">बासान के खेत अऊ करमेल पहाड़ के बगीचा कुम्हला जाथें</para>
  <para style="q2" vid="NAM 1:4">अऊ लबानोन के फूल मुरझा जाथें।<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />यहोवा के आघू म पहाड़मन कांपथें</para>
  <para style="q2" vid="NAM 1:5">अऊ पहाड़ीमन टघल जाथें।</para>
  <para style="q1" vid="NAM 1:5">ओकर आघू म धरती,</para>
  <para style="q2" vid="NAM 1:5">पूरा संसार अऊ ओमा रहइया जम्मो कांपथें।<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />ओकर कोरोध के सामना कोन कर सकथे?</para>
  <para style="q2" vid="NAM 1:6">ओकर भयंकर कोरोध ला कोन सह सकथे?</para>
  <para style="q1" vid="NAM 1:6">ओकर कोप ह आगी सहीं भड़कथे;</para>
  <para style="q2" vid="NAM 1:6">ओकर आघू म चट्टानमन चूर-चूर हो जाथें।<verse eid="NAM 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />यहोवा बने अय,</para>
  <para style="q2" vid="NAM 1:7">अऊ संकट के बेरा म मजबूत गढ़ अय।</para>
  <para style="q1" vid="NAM 1:7">ओह ओमन के खियाल रखथे, जऊन मन ओकर ऊपर भरोसा रखथें,<verse eid="NAM 1:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8" />पर एक भयंकर बाढ़ के दुवारा</para>
  <para style="q1" vid="NAM 1:8">ओह नीनवे सहर ला खतम कर दीही;</para>
  <para style="q2" vid="NAM 1:8">ओह अपन बईरीमन ला अंधियार के राज म भगा दीही।<verse eid="NAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />ओमन जऊन भी सडयंत्र यहोवा के बिरूध करहीं</para>
  <para style="q2" vid="NAM 1:9">ओह ओला असफल कर दीही;</para>
  <para style="q2" vid="NAM 1:9">संकट ह दूबारा नइं आही।<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />ओकर बईरीमन कंटिला झाड़ीमन म फंस जाहीं</para>
  <para style="q2" vid="NAM 1:10">अऊ मंद पीके मतवार होहीं;</para>
  <para style="q2" vid="NAM 1:10">ओमन ला खेत म सूखाय नर्रा सहीं जलाके नास कर दिये जाही।<verse eid="NAM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11" />हे नीनवे, तोर ले ही एक जन निकले हवय</para>
  <para style="q2" vid="NAM 1:11">जऊन ह यहोवा के बिरूध दुस्टता के सडयंत्र करथे,</para>
  <para style="q2" vid="NAM 1:11">अऊ दुस्ट योजना बनाथे।<verse eid="NAM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12" />यहोवा ह ये कहिथे:</para>
  <para style="q1" vid="NAM 1:12">“हालाकि ओमन संग ओमन ला मदद करइयामन हवंय अऊ ओमन अनगिनत हवंय,</para>
  <para style="q2" vid="NAM 1:12">पर ओमन नास करे जाहीं अऊ मिट जाहीं।</para>
  <para style="q1" vid="NAM 1:12">हे यहूदा, हालाकि मेंह तोला पीरा दे हवंव,</para>
  <para style="q2" vid="NAM 1:12">पर अब मेंह तोला पीरा नइं दंव।<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />अब मेंह तोर गरदन म रखे ओमन के जुड़ा ला टोर दूहूं</para>
  <para style="q2" vid="NAM 1:13">अऊ तोर बेड़ीमन ला टोर दूहूं।”<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />हे नीनवे, यहोवा ह तोर बारे म एक हुकूम दे हवय:</para>
  <para style="q2" vid="NAM 1:14">“तोर बंस ला बढ़ाय बर तोर कोनो संतान नइं होहीं।</para>
  <para style="q1" vid="NAM 1:14">मेंह तोर देवतामन के मंदिर म रखे</para>
  <para style="q2" vid="NAM 1:14">तोर पूजा के चीज अऊ मूरतीमन ला नास कर दूहूं।</para>
  <para style="q1" vid="NAM 1:14">में तोर बर कबर कोड़हूं,</para>
  <para style="q2" vid="NAM 1:14">काबरकि तेंह दुस्ट अस।”<verse eid="NAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15" />देख, उहां पहाड़मन ऊपर,</para>
  <para style="q2" vid="NAM 1:15">ओकर गोड़मन ला देख, जऊन ह सुघर संदेस लाथे,</para>
  <para style="q2" vid="NAM 1:15">जऊन ह सांति के घोसना करथे!</para>
  <para style="q1" vid="NAM 1:15">हे यहूदा, अपन तिहारमन ला मना,</para>
  <para style="q2" vid="NAM 1:15">अऊ अपन मन्नतमन ला पूरा कर।</para>
  <para style="q1" vid="NAM 1:15">काबरकि दुस्ट मनखेमन अब तोर ऊपर हमला नइं करंय;</para>
  <para style="q2" vid="NAM 1:15">ओमन ला पूरा नास करे जाही।<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">इबरानी म पद (<char style="xt"><ref loc="NAM 1:15">1:15</ref></char>) ला 2:1 गने गे हवय</char></note><verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s1">नीनवे के बिनास</para>
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">2 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="NAM 2:1-13">2:1‑13</ref></char> ला 2:2‑14 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="NAM 2:1" />हे नीनवे, एक हमला करइया ह तोर बिरूध म आवत हे,</para>
  <para style="q2" vid="NAM 2:1">एकरसेति गढ़मन के सुरकछा कर,</para>
  <para style="q2" vid="NAM 2:1">सड़क के रखवारी कर,</para>
  <para style="q2" vid="NAM 2:1">अपनआप ला मजबूत कर,</para>
  <para style="q2" vid="NAM 2:1">अपन पूरा सैनिक बल ला तियार कर ले!<verse eid="NAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />यहोवा ह याकूब के सोभा ला</para>
  <para style="q2" vid="NAM 2:2">इसरायल के सोभा सहीं कर दीही,</para>
  <para style="q1" vid="NAM 2:2">हालाकि नास करइयामन ओमन ला उजाड़ दे हवंय</para>
  <para style="q2" vid="NAM 2:2">अऊ ओमन के अंगूर के नारमन ला नास कर दे हवंय।<verse eid="NAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />ओमन के सैनिकमन के ढाल के रंग ह लाल हे;</para>
  <para style="q2" vid="NAM 2:3">ओकर योद्धामन भड़कीला लाल कपड़ा पहिरे हवंय।</para>
  <para style="q1" vid="NAM 2:3">जऊन दिन ओमन ला लड़ई बर तियार करे जाथे,</para>
  <para style="q2" vid="NAM 2:3">ओमन के रथ के धातु ह चमकथे;</para>
  <para style="q2" vid="NAM 2:3">सनोवर के बरछीमन ला घुमाय जाथे।<verse eid="NAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />गलीमन म रथमन तेजी से दऊड़थें,</para>
  <para style="q2" vid="NAM 2:4">अऊ चऊक म एती ले ओती भागत रहिथें।</para>
  <para style="q1" vid="NAM 2:4">ओमन बरत मसाल सहीं दिखथें;</para>
  <para style="q2" vid="NAM 2:4">ओमन बिजली सहीं भागथें।<verse eid="NAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />नीनवे अपन छांटे गय सैनिक दलमन ला आय के आदेस देथे,</para>
  <para style="q2" vid="NAM 2:5">पर ओमन अपन रद्दा म लड़खड़ाथें।</para>
  <para style="q1" vid="NAM 2:5">ओमन सहर के दीवार ले टकराथें;</para>
  <para style="q2" vid="NAM 2:5">सुरकछा के ढाल अपन जगह म खड़े करे गे हवय।<verse eid="NAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />नदी के दुवारमन ला खोल दिये गे हवय</para>
  <para style="q2" vid="NAM 2:6">अऊ महल ह गिरत हे।<verse eid="NAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />ये निरनय हो गे हवय कि</para>
  <para style="q2" vid="NAM 2:7">नीनवे ला बंधुवा बनाके ले जाय जावय।</para>
  <para style="q1" vid="NAM 2:7">ओकर गुलाम माईलोगनमन पंड़की चिरई सहीं बिलाप करहीं</para>
  <para style="q2" vid="NAM 2:7">अऊ अपन छाती पीटहीं।<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />नीनवे ह पानी के एक पोखरी सहीं अय,</para>
  <para style="q2" vid="NAM 2:8">जेकर पानी सूखात जावत हे।</para>
  <para style="q1" vid="NAM 2:8">ओमन चिचियाके कहिथें, “रूकव! रूकव!”</para>
  <para style="q2" vid="NAM 2:8">पर कोनो मुड़के नइं देखंय।<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />चांदी ला लूटव!</para>
  <para style="q2" vid="NAM 2:9">सोन ला लूटव!</para>
  <para style="q1" vid="NAM 2:9">येकर जम्मो खजानामन ले</para>
  <para style="q2" vid="NAM 2:9">धन अवई ह खतम नइं होवय!<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />ओला लूट लिये, छीन लिये अऊ ओकर कपड़ा उतार लिये गे हवय!</para>
  <para style="q2" vid="NAM 2:10">हिम्मत ही नइं ए, माड़ीमन म ताकत नइं ए,</para>
  <para style="q2" vid="NAM 2:10">देहेंमन कांपत हें, अऊ हर एक के चेहरा के रंग उड़ गे हवय।<verse eid="NAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />अब कहां हवय सिंहमन के मांद,</para>
  <para style="q2" vid="NAM 2:11">ओ जगह जिहां ओमन अपन छोटे सिंहमन ला खाना खवात रिहिन,</para>
  <para style="q1" vid="NAM 2:11">जिहां सिंह अऊ सिंहनी जावत रिहिन,</para>
  <para style="q2" vid="NAM 2:11">अऊ ओमन के लइकामन निडर होके रहत रिहिन?<verse eid="NAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />सिंह अपन लइकामन बर भरपूर सिकार करत रिहिस</para>
  <para style="q2" vid="NAM 2:12">अऊ अपन संगी सिंहनी बर सिकार ला गला घोंटके मारत रिहिस,</para>
  <para style="q1" vid="NAM 2:12">अऊ अपन मांद ला मारे गे पसु ले</para>
  <para style="q2" vid="NAM 2:12">अऊ अपन गुफा ला सिकार ले भर लेवत रिहिस।<verse eid="NAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />सर्वसक्तिमान यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="NAM 2:13">“मेंह तुम्हर बिरूध हवंव।</para>
  <para style="q1" vid="NAM 2:13">मेंह तुम्हर रथमन ला आगी ले जला दूहूं,</para>
  <para style="q2" vid="NAM 2:13">अऊ तुम्हर जवान सिंह सहीं सैनिकमन तलवार ले मारे जाहीं।</para>
  <para style="q2" vid="NAM 2:13">मेंह धरती ऊपर तुम्हर सिकार करे बर कुछू नइं छोड़ंव।</para>
  <para style="q1" vid="NAM 2:13">तुम्हर संदेसियामन के अवाज</para>
  <para style="q2" vid="NAM 2:13">फेर कभू सुनई नइं दीही।”<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s1">नीनवे ऊपर धिक्कार</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1" />धिक्कार ए ओ खून के सहर<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">नीनवे</char></note> ला,</para>
  <para style="q2" vid="NAM 3:1">जऊन ह लबारी बात ले भरे हवय,</para>
  <para style="q1" vid="NAM 3:1">जऊन ह लूट-पाट ले भरे हवय,</para>
  <para style="q2" vid="NAM 3:1">अऊ जऊन ह दुखित-पीड़ित मनखेमन ले कभू नइं छूटय!<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />कोर्रा के चटके के अवाज,</para>
  <para style="q2" vid="NAM 3:2">चक्कामन के खड़खड़ई,</para>
  <para style="q1" vid="NAM 3:2">घोड़ामन के सरपट भगई</para>
  <para style="q2" vid="NAM 3:2">अऊ रथमन के हालई-डोलई!<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />घुड़सवार सेना के हमला करई,</para>
  <para style="q2" vid="NAM 3:3">तलवारमन के चमकई</para>
  <para style="q2" vid="NAM 3:3">बरछीमन के चमकई!</para>
  <para style="q1" vid="NAM 3:3">मार डारे गय बहुंत मनखे,</para>
  <para style="q2" vid="NAM 3:3">लासमन के ढेर,</para>
  <para style="q1" vid="NAM 3:3">अनगिनत मरे मनखेमन के देहें,</para>
  <para style="q2" vid="NAM 3:3">लासमन के ऊपर लड़खड़ावत मनखे—<verse eid="NAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />ये जम्मो एक बेस्या के लम्पट वासना के कारन अय,</para>
  <para style="q2" vid="NAM 3:4">जऊन ह ललचाथे अऊ जादू-टोना के मालकिन अय,</para>
  <para style="q1" vid="NAM 3:4">जऊन ह जाति-जाति के मनखेमन ला अपन बेस्यागमन ले</para>
  <para style="q2" vid="NAM 3:4">अऊ अपन जादू-टोना ले गुलाम बना लेथे।<verse eid="NAM 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />यहोवा ह घोसना करत हे, “मेंह तुम्हर बिरूध हवंव।</para>
  <para style="q2" vid="NAM 3:5">मेंह तुम्हर लंहगा ला तुम्हर चेहरा ऊपर तक उठा दूहूं।</para>
  <para style="q1" vid="NAM 3:5">मेंह जाति-जाति के मनखेमन ला तुम्हर नंगई ला देखाहूं</para>
  <para style="q2" vid="NAM 3:5">अऊ राज-राज म तुमन ला लज्जित करहूं।<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />मेंह तुम्हर ऊपर कचरा-कूटा फटिकहूं,</para>
  <para style="q2" vid="NAM 3:6">मेंह तुमन ला अपमानित करहूं</para>
  <para style="q2" vid="NAM 3:6">अऊ तुम्हर तमासा बनाहूं।<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />ओ जम्मो जऊन मन तुमन ला देखहीं, ओमन तुम्हर ले दूरिहा भागहीं अऊ कहिहीं,</para>
  <para style="q2" vid="NAM 3:7">‘नीनवे नास हो गीस—कोन ओकर बर बिलाप करही?’</para>
  <para style="q2" vid="NAM 3:7">तुमन ला सांति देय बर मोला कोनो कहां मिल सकत हे?”<verse eid="NAM 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />का तुमन ओ थेबेस सहर ले जादा बने अव,</para>
  <para style="q2" vid="NAM 3:8">जऊन ह नील नदी म बसे हवय,</para>
  <para style="q2" vid="NAM 3:8">जेकर चारों कोति ह पानी ले घेराय हवय?</para>
  <para style="q1" vid="NAM 3:8">नदी ह ओकर सुरकछा रिहिस,</para>
  <para style="q2" vid="NAM 3:8">अऊ पानी ह ओकर बर दीवार रिहिस।<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />कूस अऊ मिसर देस ओकर बर असीमित बल रिहिन,</para>
  <para style="q2" vid="NAM 3:9">पूत अऊ लिबिया ओकर संगी देसमन रिहिन।<verse eid="NAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />तभो ले ओला बंधुवा बनाके</para>
  <para style="q2" vid="NAM 3:10">बंधुवई म ले जाय गीस।</para>
  <para style="q1" vid="NAM 3:10">हर गली के मोड़ म ओकर छोटे लइकामन ला</para>
  <para style="q2" vid="NAM 3:10">पटक-पटकके मार डारे गीस।</para>
  <para style="q1" vid="NAM 3:10">ओकर परभावसाली मनखेमन बर चिट्ठी निकाले गीस,</para>
  <para style="q2" vid="NAM 3:10">अऊ ओकर जम्मो बड़े मनखेमन ला बेड़ीमन म बांध दिये गीस।<verse eid="NAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11" />हे नीनवे सहर, तेंह घलो नसा म मतवार हो जाबे;</para>
  <para style="q2" vid="NAM 3:11">तेंह लुकाय बर चले जाबे</para>
  <para style="q2" vid="NAM 3:11">अऊ बईरीमन ले बांचे बर आसरय खोजबे।<verse eid="NAM 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />तोर जम्मो गढ़मन ओ अंजीर रूखमन सहीं अंय</para>
  <para style="q2" vid="NAM 3:12">जेमन म पहिली-फसल के पाके फर होथें;</para>
  <para style="q1" vid="NAM 3:12">जब ओमन ला हलाय जाथे,</para>
  <para style="q2" vid="NAM 3:12">त अंजीर के फरमन खानेवाला के मुहूं म गिरथें।<verse eid="NAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />अपन सैनिक दलमन ला देख—</para>
  <para style="q2" vid="NAM 3:13">ओ जम्मो दुरबल हो गे हवंय।</para>
  <para style="q1" vid="NAM 3:13">तोर देस के दुवारमन</para>
  <para style="q2" vid="NAM 3:13">तोर बईरीमन बर खुले हवंय;</para>
  <para style="q2" vid="NAM 3:13">आगी ह तोर दुवारमन के छड़मन ला जलाके नास कर दे हवय।<verse eid="NAM 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />अपन सैनिक घेरा बर पानी भर ले,</para>
  <para style="q2" vid="NAM 3:14">अपन सुरकछा ला मजबूत कर!</para>
  <para style="q1" vid="NAM 3:14">माटी ला तियार कर,</para>
  <para style="q2" vid="NAM 3:14">गोड़ ले खुंदके गारा बना ले,</para>
  <para style="q2" vid="NAM 3:14">ईंटा बनाय के काम ला सुधार!<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />उहां आगी ह तोला जलाके नास कर दीही;</para>
  <para style="q2" vid="NAM 3:15">तलवार ह तोला काट डारही—</para>
  <para style="q2" vid="NAM 3:15">ओमन तोला फांफामन के दल सहीं खा जाहीं।</para>
  <para style="q1" vid="NAM 3:15">फांफामन सहीं अपन संखिया ला बढ़ावव,</para>
  <para style="q2" vid="NAM 3:15">टिड्डीमन सहीं अपन संखिया ला बढ़ावव!<verse eid="NAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />तुमन अपन बेपारीमन के संखिया</para>
  <para style="q2" vid="NAM 3:16">अकास के तारामन के संखिया ले घलो जादा बढ़ा ले हवव,</para>
  <para style="q1" vid="NAM 3:16">पर ओमन टिड्डीमन सहीं</para>
  <para style="q2" vid="NAM 3:16">देस ला नास करके भाग जाथें।<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />तोर पहरेदारमन टिड्डीमन सहीं अंय,</para>
  <para style="q2" vid="NAM 3:17">तोर करमचारीमन टिड्डीमन के दल सहीं अंय</para>
  <para style="q2" vid="NAM 3:17">जऊन मन ठंड के दिन म दीवारमन म रहिथें—</para>
  <para style="q1" vid="NAM 3:17">पर जब सूरज निकलथे त ओमन उड़ जाथें,</para>
  <para style="q2" vid="NAM 3:17">अऊ कोनो नइं जानंय कि ओमन कहां जाथें।<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18" />हे अस्सूर के राजा, तोर चरवाहामन<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">याने कि, सासकमन</char></note> ओंघाथें;</para>
  <para style="q2" vid="NAM 3:18">तोर परभावसाली मनखेमन अराम करे बर लेट जाथें।</para>
  <para style="q1" vid="NAM 3:18">तोर मनखेमन पहाड़ ऊपर तितिर-बितिर हो गे हवंय</para>
  <para style="q2" vid="NAM 3:18">अऊ ओमन ला इकट्ठा करइया कोनो नइं अंय।<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />तोर चंगई नइं हो सकय;</para>
  <para style="q2" vid="NAM 3:19">तोर घाव ह बहुंत घातक ए।</para>
  <para style="q1" vid="NAM 3:19">ओ जम्मो, जऊन मन तोर बारे म सुनथें,</para>
  <para style="q2" vid="NAM 3:19">ओमन तोर पतन ऊपर ताली बजाथें,</para>
  <para style="q1" vid="NAM 3:19">काबरकि अइसने कोन हे</para>
  <para style="q2" vid="NAM 3:19">जऊन ह तोर खतम नइं होवइया निरदयता ले बच सके हे?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>