<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EST" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">एस्तर</para>
  <para style="toc1">एस्तर के किताब</para>
  <para style="toc2">एस्तर</para>
  <para style="toc3">एस्त</para>
  <para style="mt1">एस्तर</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="EST 1" />
  <para style="s1">रानी वसती ला पटरानी पद ले हटाय जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 1:1" />छयर्स राजा के समय म ये बात होईस, येह ओही छयर्स अय, जऊन ह 127 राजमन म, याने भारत ले लेके कूस<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">नील नदी के ऊपरी इलाका</char></note> देस तक राज करत रिहिस: <verse eid="EST 1:1" /><verse number="2" style="v" sid="EST 1:2" />ओ समय छयर्स राजा ह सूसनगढ़ के किला म अपन राज सिंघासन म बईठके राज करत रिहिस, <verse eid="EST 1:2" /><verse number="3" style="v" sid="EST 1:3" />अऊ अपन राज के तीसरा साल म, ओह अपन जम्मो परभावसाली मनखे अऊ करमचारीमन बर एक जेवनार करिस। फारस अऊ मादै के सेनापतिमन, राजकुमारमन अऊ राज-राज के परभावसाली मनखेमन उहां रिहिन।<verse eid="EST 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 1:4" />पूरा 180 दिन तक, ओह ओमन ला अपन राज के बहुंत धन-संपत्ति अऊ अपन राजपद के सोभा अऊ महिमा ला देखाईस। <verse eid="EST 1:4" /><verse number="5" style="v" sid="EST 1:5" />जब ये दिनमन बीत गीन, त राजा ह का छोटे का बड़े अपन जम्मो मनखेमन बर, जऊन मन सूसनगढ़ के किला म जूरे रिहिन, राजमहल के बाड़ा ले घिरे बारी म 7 दिन तक जेवनार करिस। <verse eid="EST 1:5" /><verse number="6" style="v" sid="EST 1:6" />बारी म मलमल के बने सफेद अऊ नीला रंग के परदामन टंगाय रहंय, जेमन ला मलमल के बने सफेद डोरी अऊ बैंगनी चीज ले संगमरमर के खंभामन म चांदी के छल्ला म बांधे गे रहय। उहां सोन अऊ चांदी के सोफामन रिहिन, जेमन ला कारीगरी करे गे बड़े सफेद पथरा, संगमरमर, मोती अऊ कीमती पथरामन ले बने फर्स ऊपर मढ़ाय गे रिहिस। <verse eid="EST 1:6" /><verse number="7" style="v" sid="EST 1:7" />राजा के उदारता के कारन बहुंत अकन साही-मदिरा रिहिस, अऊ मंद ला सोन के पियाला म परोसे जावत रिहिस, अऊ हर एक जन ला आने किसम के पियाला म मंद दिये जावत रिहिस। <verse eid="EST 1:7" /><verse number="8" style="v" sid="EST 1:8" />राजा के हुकूम ले हर एक पहुना ह बिगर कोनो बाधा के मंद पी सकत रिहिस, काबरकि राजा ह जम्मो मदिरा देवइयामन ला आदेस दे रिहिस कि जऊन मनखे जइसने चाहय, ओला वइसने देवव।<verse eid="EST 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 1:9" />रानी वसती ह घलो राजा छयर्स के राजमहल म माईलोगनमन बर जेवनार करिस।<verse eid="EST 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 1:10" />जेवनार के सातवां दिन, जब राजा छयर्स के मन ह मंद पीके मगन हो गे रिहिस, त ओह अपन सेवा करइया सात झन खोजा—महूमान, बिजता, हरबोना, बिगता, अबगता, जेतेर अऊ करकस—ला हुकूम दीस <verse eid="EST 1:10" /><verse number="11" style="v" sid="EST 1:11" />कि रानी वसती ला राज-मुकुट पहिरे हुये राजा के आघू म लाने जावव, ताकि मनखे अऊ परभावसाली मनखेमन ओकर सुन्दरता ला देख सकंय, काबरकि ओह देखे म सुन्दर रिहिस। <verse eid="EST 1:11" /><verse number="12" style="v" sid="EST 1:12" />पर जब सेवकमन जाके राजा के ये हुकूम दीन, त रानी वसती ह आय बर मना कर दीस। तब राजा ह बहुंत नराज होईस अऊ गुस्सा के मारे जरे लगिस।<verse eid="EST 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 1:13" />काबरकि येह राजा के रिवाज रिहिस कि कानून अऊ नियाय के बात म, ओह जानकार मनखेमन ले सलाह लेवय, एकरसेति ओह ओ बुद्धिमान मनखेमन ले बात करिस, जऊन मन समय ला समझत रिहिन <verse eid="EST 1:13" /><verse number="14" style="v" sid="EST 1:14" />अऊ राजा के बहुंत करीबी रिहिन—ओमन करसना, सेतार, अदमाता, तरसीस, मेरेस, मरसना अऊ ममूकान नांव के फारस अऊ मादै के सात झन परभावसाली मनखे रिहिन; येमन के राजा करा बिसेस पहुंच रिहिस अऊ येमन राज के बड़े-बड़े पद म रिहिन।<verse eid="EST 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 1:15" />राजा ह पुछिस, “कानून के मुताबिक रानी वसती के संग का करना चाही? ओह राजा छयर्स के खोजामन के दुवारा देय गे हुकूम ला नइं माने हे।”<verse eid="EST 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 1:16" />तब ममूकान ह राजा अऊ परभावसाली मनखेमन के आघू म जबाब दीस, “रानी वसती सिरिप राजा के बिरूध ही गलत काम नइं करे हवय, पर ओह जम्मो परभावसाली मनखे अऊ राजा छयर्स के जम्मो राज के मनखेमन के बिरूध घलो गलत काम करे हवय। <verse eid="EST 1:16" /><verse number="17" style="v" sid="EST 1:17" />काबरकि जब जम्मो माईलोगनमन रानी के बरताव के बारे म जानहीं, त ओमन अपन घरवालामन ला तुछ समझहीं अऊ कहिहीं, ‘राजा छयर्स ह हुकूम दीस कि रानी वसती ला ओकर आघू म लाने जावय, पर ओह नइं आईस।’ <verse eid="EST 1:17" /><verse number="18" style="v" sid="EST 1:18" />आज के दिन जऊन परभावसाली फारसी अऊ मादी माईलोगनमन रानी के बरताव के बारे म सुने हवंय, ओमन घलो राजा के परभावसाली मनखेमन संग अइसने ही बरताव करहीं। अऊ अनादर अऊ बिरोध के कोनो अन्त नइं होही।<verse eid="EST 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EST 1:19" />“एकरसेति, यदि राजा ला बने लगय, त ओह एक राजकीय आदेस निकालय अऊ ओ आदेस ह फारस अऊ मादै के कानून म लिखे जावय, जेला रद्द नइं करे जा सकय कि वसती ह राजा छयर्स के आघू म फेर कभू झन जावय। अऊ ये घलो कि राजा ह ओकर पटरानी के पद कोनो आने ला दे देवय, जऊन ह ओकर ले घलो बने होवय। <verse eid="EST 1:19" /><verse number="20" style="v" sid="EST 1:20" />तब जब राजा के ये आदेस ला ओकर जम्मो राज म सुनाय जाही, त जम्मो माईलोगनमन, का छोटे का बड़े, अपन-अपन घरवालामन के आदरमान करहीं।”<verse eid="EST 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 1:21" />ये सलाह ह राजा अऊ ओकर परभावसाली मनखेमन ला बने लगिस, एकरसेति राजा ह ममूकान के सलाह ला मान लीस। <verse eid="EST 1:21" /><verse number="22" style="v" sid="EST 1:22" />ओह राज के जम्मो भाग म संदेस पठोईस; हर एक छेत्र म, उहां के लिपि अऊ उहां के मनखेमन के भासा म संदेस पठोईस अऊ घोसना करवाईस कि हर एक आदमी ह अपन खुद के भासा के उपयोग करत, अपन घर म हुकूम चलावय।<verse eid="EST 1:22" /></para>
  <chapter eid="EST 1" />
  <chapter number="2" style="c" sid="EST 2" />
  <para style="s1">एस्तर ला रानी बनाय जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1" />ये घटना के बाद, जब राजा छयर्स के गुस्सा ह सांत हो गीस, त ओह वसती अऊ ओकर बरताव अऊ जऊन आदेस राजा ह वसती के बारे म देय रिहिस, ओ जम्मो बात ला सुरता करिस। <verse eid="EST 2:1" /><verse number="2" style="v" sid="EST 2:2" />तब राजा के निजी सेवकमन सलाह दीन, “राजा बर सुन्दर अऊ कइनारी कुंवारीमन के खोज करे जावय। <verse eid="EST 2:2" /><verse number="3" style="v" sid="EST 2:3" />राजा ह अपन राज के हर छेत्र म आयुक्तमन ला ठहिरावय, जऊन मन ये जम्मो कइनारी कुंवारीमन ला सूसन के किला के रनवास म लानंय। अऊ ओमन ला राजा के खोजा हेगे के अधीन कर दिये जावय, जऊन ह कि माईलोगनमन के देखरेख करइयामन के मुखिया ए; अऊ ओमन ला सुघर बने चीजमन दिये जावंय। <verse eid="EST 2:3" /><verse number="4" style="v" sid="EST 2:4" />तब जऊन कइनारी माईलोगन ले राजा ह खुस होही, ओला वसती के जगह म रानी बनाय जावय।” ये सलाह ह राजा ला बने लगिस, अऊ ओह वइसनेच करिस।<verse eid="EST 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 2:5" />सूसनगढ़ के किला म मोरदकै नांव के बिनयामीन के गोत्र के एक झन यहूदी रिहिस, जऊन ह कीस के परनाती, सिमी के नाती अऊ याईर के बेटा रिहिस <verse eid="EST 2:5" /><verse number="6" style="v" sid="EST 2:6" />ओह ओ बंदीमन के संग यरूसलेम ले बंधुवई म आय रिहिस, जेमन ला बेबिलोन के राजा नबूकदनेसर ह यहूदा के राजा यहोयाकीन<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">यकुन्याह, </char><char style="ft" closed="false">जऊन ह </char><char style="fq" closed="false">यहोयाकीन </char><char style="ft" closed="false">के आने नांव ए</char></note> के संग बंदी बनाके ले गे रिहिस। <verse eid="EST 2:6" /><verse number="7" style="v" sid="EST 2:7" />मोरदकै के हदस्सा नांव के एक चचेरी बहिनी रिहिस, जेला ओह पाले-पोसे रिहिस, काबरकि हदस्सा के दाई-ददा कोनो नइं रिहिन। ये कइनारी माईलोगन ला एस्तर घलो कहे जावय; ओकर देहें ह सुघर अऊ ओह सुन्दर रिहिस। जब ओकर दाई-ददा मर गीन, त मोरदकै ह ओला लेके अपन खुद के बेटी सहीं पाले रिहिस।<verse eid="EST 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 2:8" />जब राजा के आदेस अऊ नियम के घोसना करे गीस, त बहुंत अकन कइनारी कुंवारीमन ला सूसनगढ़ के किला म लाने गीस अऊ ओमन ला हेगे के देखरेख म रखे गीस। एस्तर ला घलो राजा के महल म लाने गीस अऊ ओला हेगे के अधीन सऊंप दिये गीस, जऊन ह कि रनवास के देखरेख करइयामन के मुखिया रिहिस। <verse eid="EST 2:8" /><verse number="9" style="v" sid="EST 2:9" />एस्तर ला देखके हेगे ह खुस होईस अऊ ओ कइनारी माईलोगन ह ओला बने लगिस। तुरते ओह सुघर बनाय के चीजमन ओला दीस अऊ ओकर बर खास जेवन के परबंध करिस। ओह ओला राजा के महल ले चुने सात झन सेविका घलो दीस अऊ ओला अऊ ओकर सेविकामन ला रनवास म सबले बढ़िया जगह म रहे बर दीस।<verse eid="EST 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 2:10" />एस्तर ह न तो अपन जाति के बारे म अऊ न ही अपन परिवार के बारे म बताय रिहिस, काबरकि मोरदकै ह ओला ये बातमन ला बताय बर मना करे रिहिस। <verse eid="EST 2:10" /><verse number="11" style="v" sid="EST 2:11" />मोरदकै ह हर एक दिन रनवास के अंगना के आघू म ये जाने बर घुमय-फिरय कि एस्तर ह कइसे हवय अऊ ओकर संग का होवत हे।<verse eid="EST 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 2:12" />जब भी कोनो कइनारी माईलोगन के राजा छयर्स करा जाय के पारी आवय, त जाय के पहिली, ओ माईलोगन ला सुघर बनाय के बारह महिना ला पूरा करना पड़य; याने कि ओला छै महिना तक गंधरस के तेल लगाय जावय अऊ छै महिना तक खुसबूवाला तेल अऊ सुघर बनाय के चीजमन ला लगाय जावय। <verse eid="EST 2:12" /><verse number="13" style="v" sid="EST 2:13" />अऊ ये किसम ले ओ कइनारी माईलोगन ह राजा करा जावय: जऊन कुछू चीज ओह अपन संग रनवास म ले राजा के महल म ले जाय बर चाहय, ओ चीज ओला दिये जावय। <verse eid="EST 2:13" /><verse number="14" style="v" sid="EST 2:14" />संझा के बेरा, ओह राजा के महल म जावय अऊ बिहनियां, ओह लहुंटके रनवास के आने भाग म सासगज के देखरेख म रहे बर चले जावय; सासगज ह राजा के खोजा अऊ रखैलमन के देखरेख करइयामन के मुखिया रिहिस। ओ माईलोगन ह फेर राजा करा नइं जावय; कहूं राजा ह ओकर ले खुस हो जावय, त ओकर नांव लेके ओला फेर बलाय जावय।<verse eid="EST 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 2:15" />जब मोरदकै के कका अबीहैल के बेटी एस्तर, जेला मोरदकै ह बेटी बनाके रखे रिहिस, ओकर पारी आईस, कि ओह राजा करा जावय, त जऊन कुछू चीज रनवास के मुखिया, राजा के खोजा हेगे ह ओला ले जाय के सलाह दीस, ओला छोंड़ एस्तर ह अपन संग ले जाय बर अऊ कुछू चीज के मांग नइं करिस। अऊ जऊन मन एस्तर ला देखिन, ओ जम्मो झन ओकर ले खुस होईन। <verse eid="EST 2:15" /><verse number="16" style="v" sid="EST 2:16" />एस्तर ला राजमहल म राजा छयर्स करा ओकर राज के सातवां साल के तेबेत नांव के दसवां महिना म अमराय गीस।<verse eid="EST 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 2:17" />राजा ह एस्तर ला अऊ जम्मो माईलोगनमन ले जादा मया करिस, अऊ राजा के ओकर ऊपर अऊ जम्मो कइनारी कुंवारीमन ले जादा अनुग्रह अऊ किरपा होईस। एकरसेति ओह ओकर मुड़ म राज-मुकुट रखिस अऊ ओला वसती के जगह म रानी बनाईस। <verse eid="EST 2:17" /><verse number="18" style="v" sid="EST 2:18" />अऊ राजा ह अपन जम्मो परभावसाली मनखे अऊ करमचारीमन बर एक बड़े जेवनार करिस, जऊन ह एस्तर के जेवनार रिहिस। ओह जम्मो राज म एक दिन के छुट्टी के घोसना करवाईस अऊ साही उदारता से ईनाम घलो बांटिस।<verse eid="EST 2:18" /></para>
  <para style="s1">मोरदकै ह साजिस के भेद खोलथे</para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19" />जब कुंवारीमन ला दूसर बार संकेले गीस, त मोरदकै ह राजमहल के कपाट करा बईठे रिहिस। <verse eid="EST 2:19" /><verse number="20" style="v" sid="EST 2:20" />पर एस्तर ह अपन परिवार अऊ जाति के बात ला गुपत रखे रिहिस जइसने कि मोरदकै ह ओला करे बर कहे रिहिस, काबरकि एस्तर ह अभी घलो मोरदकै के बात ला वइसने ही मानय, जइसने ओह अपन पालन-पोसन के समय ओकर बात ला मानय।<verse eid="EST 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 2:21" />ओ दिनमन म, जब मोरदकै ह राजमहल के दुवार करा बईठे रहय, तब राजा के दू झन अधिकारी—बिगताना अऊ तेरेस, जऊन मन दुवारपाल रिहिन, राजा छयर्स के कोनो बात ले गुस्सा होके राजा के हतिया करे के साजिस रचिन। <verse eid="EST 2:21" /><verse number="22" style="v" sid="EST 2:22" />पर मोरदकै ला ये साजिस के पता चल गीस अऊ ओह ये बात एस्तर रानी ला बताईस, अऊ एस्तर ह मोरदकै के नांव लेके ये बात राजा ला बताईस। <verse eid="EST 2:22" /><verse number="23" style="v" sid="EST 2:23" />अऊ जब जांच-पड़ताल होईस, त ये बात ह सही पाय गीस अऊ ओ दूनों अधिकारीमन ला खंभामन म टांग दिये गीस। ये जम्मो बात ला राजा के आघू म इतिहास के किताब म लिख दिये गीस।<verse eid="EST 2:23" /></para>
  <chapter eid="EST 2" />
  <chapter number="3" style="c" sid="EST 3" />
  <para style="s1">यहूदीमन ला नास करे के हामान के साजिस</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1" />ये घटनामन के बाद, राजा छयर्स ह हम्मदाता अगागी के बेटा हामान ला ऊंचा उठाके अऊ ओला आने जम्मो परभावसाली मनखेमन ले जादा ऊंच पद देके ओकर महत्व ला बढ़ाईस। <verse eid="EST 3:1" /><verse number="2" style="v" sid="EST 3:2" />राजा के दुवार के जम्मो साही करमचारीमन हामान के आघू म माड़ी टेकंय अऊ ओकर आदर करंय, काबरकि राजा ह ओकर बारे म ये हुकूम देय रिहिस। पर मोरदकै ह न तो माड़ी टेकय अऊ न ही ओकर आदर करय।<verse eid="EST 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 3:3" />तब राजा के दुवार के साही करमचारीमन मोरदकै ले पुछिन, “तेंह राजा के हुकूम ला काबर नइं मानत हस?” <verse eid="EST 3:3" /><verse number="4" style="v" sid="EST 3:4" />हर दिन ओमन ओकर ले ये बारे म गोठियाईन पर ओह हुकूम माने नइं चाहिस। एकरसेति ओमन येकर बारे म हामान ला बताईन; ओमन ये देखे चाहत रिहिन कि मोरदकै के ये बरताव ला सहन करे जाही कि नइं, काबरकि ओह ओमन ला बता देय रिहिस कि ओह एक यहूदी अय।<verse eid="EST 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 3:5" />जब हामान ह देखिस कि मोरदकै ह न तो माड़ी टेकय अऊ न ही ओला आदर देवय, त हामान ह बहुंत गुस्सा होईस। <verse eid="EST 3:5" /><verse number="6" style="v" sid="EST 3:6" />मोरदकै के जाति के मनखेमन के बारे म जानके, हामान ह सिरिप मोरदकै ला मार डारे के योजना ला छोंड़ दीस। येकर बदले ओह छयर्स के जम्मो राज म रहइया मोरदकै के जम्मो मनखे—यहूदीमन ला नास करे के उपाय खोजे लगिस।<verse eid="EST 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 3:7" />राजा छयर्स के सासनकाल के बारहवां साल के नीसान नांव के पहिला महिना म, हामान के आघू म एक दिन अऊ महिना ला चुने बर <char style="tl">पुर</char> (चिट्ठी) निकाले गीस। अऊ चिट्ठी ह अदार नांव के बारहवां महिना बर निकलिस।<verse eid="EST 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 3:8" />तब हामान ह राजा छयर्स ला कहिस, “तोर राज के जम्मो छेत्र म मनखेमन के बीच म एक जाति के मनखेमन तितिर-बितिर होके रहत हें, जऊन मन अपनआप ला अलग रखथें। ओमन के रीति-रिवाज ह आने जम्मो मनखेमन ले अलग हवय, अऊ ओमन राजा के कानून ला नइं मानंय; एकरसेति ओमन ला अइसने रहन देवई ह राजा के हित म नो हय। <verse eid="EST 3:8" /><verse number="9" style="v" sid="EST 3:9" />यदि राजा ला ये बात बने लगय, त ओमन ला नास करे के एक आदेस निकाले जावय, अऊ मेंह राजा के हाकिममन ला साही खजाना बर चांदी के दस हजार टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">लगभग 375 टन</char></note> दूहूं।”<verse eid="EST 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 3:10" />त राजा ह अपन अंगरी ले मुहरवाला मुंदरी ला उतारिस अऊ हम्मदाता अगागी के बेटा हामान ला दे दीस, जऊन ह कि यहूदीमन के बईरी रिहिस। <verse eid="EST 3:10" /><verse number="11" style="v" sid="EST 3:11" />अऊ राजा ह हामान ला कहिस, “पईसा ला रख, अऊ जइसने तोला बने लगय, वइसने तें ओ मनखेमन संग कर।”<verse eid="EST 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 3:12" />तब पहिली महिना के तेरहवां दिन म राजा के सचिवमन ला बलाय गीस। अऊ ओमन हर इलाका के लिपि अऊ हर मनखे के भासा म, हामान के आदेस ला राजा के जम्मो अधिपति, अलग-अलग इलाका के राजपाल अऊ परभावसाली मनखेमन ला लिखिन। ये आदेस ला खुद राजा छयर्स के नांव म लिखे गीस अऊ ओमा राजा के मुंदरी के मुहर लगाय गीस। <verse eid="EST 3:12" /><verse number="13" style="v" sid="EST 3:13" />ये लिखित आदेस ला दूतमन के हांथ म राजा के जम्मो इलाका म ये आदेस के संग पठोय गीस कि का जवान का डोकरा, का माईलोगन का लइका—जम्मो के जम्मो यहूदीमन ला मारके ओमन के पूरा बिनास कर दिये जावय अऊ ओमन के संपत्ति ला लूट लिये जावय—अऊ ये काम ला एक ही दिन म, याने कि अदार नांव के बारहवां महिना के तेरहवां दिन म करे जावय। <verse eid="EST 3:13" /><verse number="14" style="v" sid="EST 3:14" />राजा के ये हुकूम के एक प्रति ला कानून के रूप म हर इलाका म पठोय जावय अऊ हर जाति के मनखेमन ला येकर बारे म बताय जावय ताकि ओमन ओ दिन बर तियार रहंय।<verse eid="EST 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 3:15" />राजा के हुकूम ले दूतमन निकलिन अऊ आघू बढ़ गीन, अऊ सूसनगढ़ म राजा के हुकूम निकाले गीस। राजा अऊ हामान मंद पीये बर बईठ गीन, पर सूसनगढ़ सहर म घबराहट फईल गीस।<verse eid="EST 3:15" /></para>
  <chapter eid="EST 3" />
  <chapter number="4" style="c" sid="EST 4" />
  <para style="s1">मोरदकै ह एस्तर ला मदद करे बर मनाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1" />जब मोरदकै ला ओ जम्मो बात के पता चलिस कि का-का करे गे हवय, त ओह अपन ओनहा ला चीरिस, बोरा के कपड़ा पहिरके अपन ऊपर राख डालिस, अऊ चिचियाके अऊ कलप-कलपके बिलाप करत सहर के भीतर गीस। <verse eid="EST 4:1" /><verse number="2" style="v" sid="EST 4:2" />पर ओह सिरिप राजा के दुवार तक गीस, काबरकि कोनो ला बोरा के ओनहा पहिरके ओकर भीतर जाय के अनुमति नइं रिहिस। <verse eid="EST 4:2" /><verse number="3" style="v" sid="EST 4:3" />ओ हर इलाका जिहां राजा के हुकूम अऊ राजा के आदेस पहुंचिस, उहां यहूदीमन उपास करत अऊ बहुंत रोवत बिलाप करे लगिन। बहुंत झन बोरा के कपड़ा पहिरके राख ऊपर पड़े रहंय।<verse eid="EST 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 4:4" />जब एस्तर रानी के खोजा अऊ सेविकामन आके ओला मोरदकै के बारे म बताईन, त ओह बहुंत दुखी होईस। ओह मोरदकै बर कपड़ा भिजवाईस कि ओह बोरा के कपड़ा ला उतारके ओ कपड़ा ला पहिरय, पर मोरदकै ह ओ कपड़ामन ला नइं लीस। <verse eid="EST 4:4" /><verse number="5" style="v" sid="EST 4:5" />तब एस्तर ह हताक ला बुलवाईस, जऊन ह राजा के खोजामन ले एक झन रिहिस अऊ एस्तर के सेवा बर ठहिराय गे रिहिस। ओह हताक ला हुकूम दीस कि ओह जाके पता लगावय कि मोरदकै ला का चीज के तकलीफ हवय अऊ ओकर कारन का ए।<verse eid="EST 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 4:6" />तब हताक ह राजा के दुवार के सामने, सहर के खुला चऊक म मोरदकै करा गीस। <verse eid="EST 4:6" /><verse number="7" style="v" sid="EST 4:7" />मोरदकै ह ओला ओ जम्मो बात बता दीस, जऊन ह ओकर ऊपर होय रिहिस; ओह ये घलो बताईस कि हामान ह यहूदीमन ला नास करे बर कतेक पईसा साही खजाना म देय के वायदा करे हवय। <verse eid="EST 4:7" /><verse number="8" style="v" sid="EST 4:8" />सूसनगढ़ म यहूदीमन के पूरा बिनास के जऊन साही हुकूम लिखे गे रिहिस, ओकर एक प्रति घलो मोरदकै ह हताक ला दीस, ताकि ओह ओ प्रति ला एस्तर ला देखावय अऊ ओकर बारे म समझा देवय, अऊ ओह हताक ला ये घलो कहिस कि ओह जाके एस्तर ला कहय कि एस्तर ह राजा के आघू म जाके अपन मनखेमन बर बिनती करय अऊ दया के भीख मांगय।<verse eid="EST 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 4:9" />तब हताक ह वापिस गीस अऊ जऊन कुछू मोरदकै ह कहे रिहिस, ओ जम्मो बात एस्तर ला बताईस। <verse eid="EST 4:9" /><verse number="10" style="v" sid="EST 4:10" />तब एस्तर ह हताक ला हुकूम दीस कि ओह जाके मोरदकै ला ये कहय, <verse eid="EST 4:10" /><verse number="11" style="v" sid="EST 4:11" />“साही इलाका के राजा के जम्मो करमचारी अऊ मनखेमन जानत हें कि यदि कोनो आदमी या माईलोगन बिगर बलाय राजमहल के भीतर राजा करा जाथे, त ओकर बर राजा के सिरिप एक कानून हवय: कि ओ आदमी या माईलोगन ला मार डारे जावय, पर यदि राजा ह सोन के राजदंड ला ओकर कोति बढ़ाथे, त ओकर परान ह बच जाथे। पर अब तीस दिन हो गे हवय, मोला राजा करा जाय के बुलावा नइं आय हवय।”<verse eid="EST 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 4:12" />जब एस्तर के ये बात मोरदकै ला बताय गीस। <verse eid="EST 4:12" /><verse number="13" style="v" sid="EST 4:13" />त ओह एस्तर करा ये जबाब भेजिस, “अइसने झन सोच कि तेंह राजा के घर म हवस, त तें एके झन जम्मो यहूदीमन म बच जाबे। <verse eid="EST 4:13" /><verse number="14" style="v" sid="EST 4:14" />काबरकि यदि तें ये बेरा म चुपेचाप रहिबे, त यहूदीमन के मदद अऊ छुटकारा कहीं अऊ जगह ले हो जाही, पर तें अऊ तोर ददा के परिवार ह नास हो जाही। अऊ कोन जाने, सायद अइसने कठिन बेरा बर ही तोला ये राजपद मिले हवय।”<verse eid="EST 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 4:15" />तब एस्तर ह मोरदकै करा ये जबाब भेजिस: <verse eid="EST 4:15" /><verse number="16" style="v" sid="EST 4:16" />“तें जा अऊ सूसनगढ़ के जम्मो यहूदीमन ला इकट्ठा कर, अऊ तुमन जम्मो मोर बर उपास करव। तीन दिन तक, रात हो या दिन, कुछू झन खावव-पीयव। में अऊ मोर सेविकामन घलो तुम्हर सहीं उपास करबो। अऊ ओकर बाद, मेंह राजा करा जाहूं, हालाकि येह कानून के बिरूध अय। अऊ कहूं मेंह नास हो जावंव, त हो जावंव।”<verse eid="EST 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 4:17" />त मोरदकै ह गीस अऊ जइसने एस्तर ह करे बर कहे रिहिस, वइसने करिस।<verse eid="EST 4:17" /></para>
  <chapter eid="EST 4" />
  <chapter number="5" style="c" sid="EST 5" />
  <para style="s1">एस्तर ह राजा ले बिनती करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1" />अपन उपास के तीसर दिन, एस्तर ह अपन राजकीय कपड़ा ला पहिरिस अऊ राजा के दरबार के आघू म जाके, महल के भीतरी अंगना म ठाढ़ हो गीस। राजा ह दरबार म राज सिंघासन म बईठे रहय अऊ ओकर मुहूं ह दुवारी कोति रहय। <verse eid="EST 5:1" /><verse number="2" style="v" sid="EST 5:2" />जब ओह एस्तर रानी ला अंगना म ठाढ़े देखिस, त ओह खुस होईस अऊ अपन हांथ म धरे सोन के राजदंड ला रानी कोति बढ़ाईस। तब एस्तर ह आघू बढ़िस अऊ राजदंड के छोर ला छुईस।<verse eid="EST 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 5:3" />तब राजा ह पुछिस, “हे एस्तर रानी, का बात ए? तोर का मांग हे? मांग अऊ इहां तक कि आधा राज ला घलो तोला दिये जाही।”<verse eid="EST 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 5:4" />एस्तर ह जबाब दीस, “यदि राजा ला ये बात बने लगय, त आज राजा ह हामान के संग ओ जेवनार म आवय, जेला मेंह राजा बर तियार करे हंव।”<verse eid="EST 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 5:5" />तब राजा ह हुकूम दीस, “हामान ला तुरते ले आवव, ताकि हमन एस्तर के दिये नेवता म जावन।”</para>
  <para style="p" vid="EST 5:5">त राजा अऊ हामान ओ जेवनार खाय बर चल दीन, जेला एस्तर ह बनाय रिहिस। <verse eid="EST 5:5" /><verse number="6" style="v" sid="EST 5:6" />जब ओमन मंद पीयत रिहिन, त राजा ह एस्तर ले पुछिस, “अब तोर का बिनती हे? ओ चीज तोला दिये जाही। अऊ तोर का मांग हे? मांग अऊ इहां तक कि आधा राज ला घलो तोला दिये जाही।”<verse eid="EST 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 5:7" />एस्तर ह जबाब दीस, “मोर बिनती अऊ मोर मांग ये अय: <verse eid="EST 5:7" /><verse number="8" style="v" sid="EST 5:8" />यदि राजा के दया-दिरिस्टी मोर ऊपर हवय अऊ मोर बिनती ला सुने अऊ मोर मांग ला पूरा करे म, राजा ला बने लगथे, त राजा अऊ हामान कल फेर ओ जेवनार म आवंय, जेला मेंह ओमन बर तियार करहूं। तब मेंह राजा के सवाल के जबाब दूहूं।”<verse eid="EST 5:8" /></para>
  <para style="s1">मोरदकै के बिरूध हामान के कोरोध</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9" />हामान ह ओ दिन खुस होके अऊ बड़े आनंद मन से बाहिर गीस। पर जब ओह राजा के दुवार करा गीस जिहां मोरदकै ह रहय, त ओह देखिस कि मोरदकै ह न तो उठिस अऊ न ही ओमा हामान के उहां होय के कोनो भय दिखिस, त ओह मोरदकै बर गुस्सा ले भर गीस। <verse eid="EST 5:9" /><verse number="10" style="v" sid="EST 5:10" />तभो ले, हामान अपनआप ला रोकिस अऊ घर चल दीस।</para>
  <para style="p" vid="EST 5:10">अपन संगीमन ला अऊ अपन घरवाली जेरेस ला बलाके, <verse eid="EST 5:10" /><verse number="11" style="v" sid="EST 5:11" />ओमन के आघू म हामान ह अपन बहुंत धन अऊ अपन बहुंते बेटामन ऊपर डींग मारिस, अऊ कहिस कि राजा ह कइसे ओकर आदर करे हवय अऊ ओह कइसे ओला आने परभावसाली मनखे अऊ करमचारीमन ले ऊंच पद दे हवय। <verse eid="EST 5:11" /><verse number="12" style="v" sid="EST 5:12" />हामान ह ये घलो कहिस, “अतका ही नइं, एस्तर रानी ह मोला छोंड़ अऊ कोनो ला राजा के संग म अपन तियार करे जेवनार म आय के नेवता नइं दीस। अऊ रानी ह कल बर घलो राजा के संग मोला नेवते हवय। <verse eid="EST 5:12" /><verse number="13" style="v" sid="EST 5:13" />पर ये जम्मो बात ले मोर मन ह संतोस नइं होवय, जब तक कि मेंह यहूदी मोरदकै ला राजा के दुवार करा बईठे देखत रहिहूं।”<verse eid="EST 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 5:14" />ओकर घरवाली जेरेस अऊ ओकर जम्मो संगीमन ओला कहिन, “करीब 50 क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">लगभग 75 फीट</char></note> ऊंच एक ठन खंभा गड़वा ले, अऊ बिहनियां राजा ले कहिबे कि ओमा मोरदकै ला टांग दिये जावय। तब राजा के संग जाके जेवनार के आनंद उठा।” ये सलाह ह हामान ला बने लगिस, अऊ ओह एक खंभा गड़वाईस।<verse eid="EST 5:14" /></para>
  <chapter eid="EST 5" />
  <chapter number="6" style="c" sid="EST 6" />
  <para style="s1">मोरदकै के आदरमान</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1" />ओ रथिया राजा ला नींद नइं आईस; एकरसेति ओह हुकूम दीस कि इतिहास के ओ किताब ला लाय जावय, जेमा ओकर सासन के बारे म लिखे गे हवय, अऊ ओह ये घलो हुकूम दीस कि ओला पढ़के सुनाय जावय। <verse eid="EST 6:1" /><verse number="2" style="v" sid="EST 6:2" />ओ किताब म, ये लिखे हुए मिलिस कि राजा के दू झन अधिकारी—बिगताना अऊ तेरेस, जेमन दुवारपाल रिहिन, राजा छयर्स के हतिया करे के साजिस रचे रिहिन, जेकर परदाफास मोरदकै ह करे रिहिस।<verse eid="EST 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 6:3" />तब राजा ह पुछिस, “येकर बदले म, मोरदकै ला का आदरमान अऊ ईनाम दिये गीस?”</para>
  <para style="p" vid="EST 6:3">ओकर सेवकमन जबाब दीन, “ओकर बर कुछू नइं करे गे हवय।”<verse eid="EST 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 6:4" />त राजा ह पुछिस, “अंगना म कोन हवय?” ओतकीच बेरा, हामान ह महल के बाहिरी अंगना म राजा ले ये कहे बर हबरे रिहिस कि ओह जऊन खंभा गड़वाय हवय, ओमा राजा ह मोरदकै ला टंगवा दे।<verse eid="EST 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 6:5" />राजा के सेवकमन जबाब दीन, “अंगना म तो हामान ह खड़े हवय।”</para>
  <para style="p" vid="EST 6:5">राजा ह हुकूम दीस, “ओला भीतर बलाके लानव।”<verse eid="EST 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 6:6" />जब हामान ह भीतर आईस, त राजा ह ओकर ले पुछिस, “जऊन मनखे के आदरमान राजा ह खुसी से करना चाहय, त ओ मनखे बर का करना उचित होही?”</para>
  <para style="p" vid="EST 6:6">हामान ह खुद अपन बारे म ये सोचिस, “मोला छोंड़ राजा ह अऊ काकर आदरमान करही?” <verse eid="EST 6:6" /><verse number="7" style="v" sid="EST 6:7" />एकरसेति ओह राजा ला जबाब दीस, “जऊन मनखे के राजा खुसी से आदरमान करना चाहय, <verse eid="EST 6:7" /><verse number="8" style="v" sid="EST 6:8" />ओकर बर राजकीय कपड़ा लाने जावय, जेला राजा पहिर चुके हवय अऊ एक घोड़ा लाने जावय, जेमा राजा सवारी कर चुके हवय अऊ ओकर मुड़ म राजकीय मुकुट धरे रहय। <verse eid="EST 6:8" /><verse number="9" style="v" sid="EST 6:9" />तब ओ कपड़ा अऊ घोड़ा ला राजा के सबले बने परभावसाली अधिकारीमन ले एक झन ला दे दिये जावय। अऊ राजा ह खुसी से जेकर आदरमान करे चाहत हे, ओला ओ कपड़ा ला पहिरा दिये जावय अऊ ओला घोड़ा म बईठाके सहर के गलीमन घुमाय जावय, अऊ ओकर आघू म ये घोसना करत जावय, ‘राजा ह खुसी से जेकर आदरमान करे चाहथे, ओकर संग अइसने करे जाथे।’ ”<verse eid="EST 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 6:10" />तब राजा ह हामान ला हुकूम दीस, “तुरते जा अऊ ओ कपड़ा अऊ घोड़ा ला ले आ अऊ अपन दिये सलाह के मुताबिक ओ यहूदी मोरदकै के संग वइसने ही कर, जऊन ह राजा के दुवार मेर बईठे रहिथे। अऊ जऊन सलाह तेंह दे हवस, ओमा कुछू भी कमी-घटी झन होवय।”<verse eid="EST 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 6:11" />तब हामान ह राजकीय कपड़ा अऊ घोड़ा ला लीस। ओह मोरदकै ला ओ कपड़ा पहिराईस, अऊ ओला घोड़ा म बईठाके सहर के गलीमन म घुमाईस, अऊ ओकर आघू म ये घोसना करत गीस, “राजा ह खुसी से जेकर आदरमान करे चाहथे, ओकर संग अइसने करे जाथे।”<verse eid="EST 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 6:12" />ओकर बाद, मोरदकै ह राजा के दुवार मेर लहुंट आईस। पर हामान ह दुख म अपन मुड़ ला ढांपके जल्दी से अपन घर चल दीस, <verse eid="EST 6:12" /><verse number="13" style="v" sid="EST 6:13" />अऊ ओह अपन घरवाली जेरेस अऊ अपन जम्मो संगीमन ला ओ जम्मो बात बताईस, जऊन ह ओकर ऊपर बीते रिहिस।</para>
  <para style="p" vid="EST 6:13">त ओकर सलाहकारमन अऊ ओकर घरवाली जेरेस ओला कहिन, “मोरदकै के आघू म तोर गिरे के सुरूआत हो चुके हवय, काबरकि ओह यहूदी जाति के अय, तेंह ओकर आघू म टिक नइं सकस—खचित, तेंह नास हो जाबे!” <verse eid="EST 6:13" /><verse number="14" style="v" sid="EST 6:14" />जब ओमन ओकर ले गोठियावत रिहिन, तभे राजा के खोजामन आ गीन अऊ ओमन हामान ला जल्दी करके एस्तर के बनाय जेवनार म ले गीन।<verse eid="EST 6:14" /></para>
  <chapter eid="EST 6" />
  <chapter number="7" style="c" sid="EST 7" />
  <para style="s1">हामान ला सूली म चढ़ाय जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 7:1" />त राजा अऊ हामान, रानी एस्तर के जेवनार म गीन, <verse eid="EST 7:1" /><verse number="2" style="v" sid="EST 7:2" />अऊ जब ओमन दूसर दिन घलो मंद पीयत रिहिन, त राजा ह रानी ले फेर पुछिस, “हे एस्तर रानी, तोर का बिनती हे? ओला पूरा करे जाही। तोर का मांग हे? मांग, इहां तक कि आधा राज घलो तोला दे दिये जाही।”<verse eid="EST 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 7:3" />तब एस्तर रानी ह जबाब दीस, “हे महाराज, यदि तोर दया-दिरिस्टी मोर ऊपर हवय, अऊ ये बात तोला बने लगय, त मोला मोर जिनगी मिले—येह मोर बिनती ए। अऊ मोर मनखेमन के परान ला बचा ले—येह मोर मांग ए। <verse eid="EST 7:3" /><verse number="4" style="v" sid="EST 7:4" />काबरकि में अऊ मोर मनखेमन नास होय बर, मारे जाय बर अऊ पूरा बिनास होय बर बेचे गे हवन। यदि हमन नर अऊ नारी गुलाम के रूप म बेचे गे रहितेंन, त मेंह चुप रहितंय, काबरकि वइसने बात बर राजा ला तकलीफ देवई सही बात नइं होतिस।”<verse eid="EST 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 7:5" />तब छयर्स राजा ह एस्तर रानी ले पुछिस, “ओह कोन ए? अऊ ओह कहां हवय—ओ मनखे, जऊन ह अइसने काम करे के हिम्मत करे हवय?”<verse eid="EST 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 7:6" />एस्तर रानी ह जबाब दीस, “एक बिरोधी अऊ बईरी ए! अऊ ओह ये दुस्ट हामान ए!”</para>
  <para style="p" vid="EST 7:6">तब हामान ह राजा अऊ रानी के आघू म डर गीस। <verse eid="EST 7:6" /><verse number="7" style="v" sid="EST 7:7" />राजा ह बहुंत गुस्सा होके उठिस अऊ अपन मंद ला छोंड़के बाहिर महल के बारी म चल दीस। पर हामान ह ये जानके कि राजा ह ओकर भाग्य के फैसला कर चुके हवय, ओह एस्तर रानी ले अपन परान के भीख मांगे बर उहां रूक गीस।<verse eid="EST 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 7:8" />जब राजा ह महल के बारी ले जेवनार के जगह म आईस, त देखिस कि जऊन सोफा म एस्तर ह बईठे हवय, ओहीच म हामान ह झुके हवय।</para>
  <para style="p" vid="EST 7:8">त राजा ह चिचियाके कहिस, “अऊ त अऊ का येह रानी के संग छेड़खानी घलो करही, जबकि ओह मोर संग घर म हवय?”</para>
  <para style="p" vid="EST 7:8">राजा के मुहूं ले ये बचन निकलतेच ही, राजा के सेवकमन हामान के मुहूं ला ढांप दीन। <verse eid="EST 7:8" /><verse number="9" style="v" sid="EST 7:9" />तब राजा के सेवा करइया खोजामन ले एक झन, जेकर नांव हरबोना रिहिस, ओह कहिस, “हामान के घर म पचास क्यूबीट<note caller="+" style="f" category="dup"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">लगभग 75 फीट</char></note> ऊंच एक ठन खंभा गड़वाय गे हवय। हामान ह ओला मोरदकै बर गड़वाय रिहिस, जऊन ह कि राजा के भलई के बात कहे रिहिस।”</para>
  <para style="p" vid="EST 7:9">तब राजा ह हुकूम दीस, “हामान ला ओमा टांग दव!” <verse eid="EST 7:9" /><verse number="10" style="v" sid="EST 7:10" />त ओमन हामान ला ओहीच खंभा म टांग दीन, जेला ओह मोरदकै बर गड़वाय रिहिस। तब राजा के गुस्सा ह ठंडा होईस।<verse eid="EST 7:10" /></para>
  <chapter eid="EST 7" />
  <chapter number="8" style="c" sid="EST 8" />
  <para style="s1">यहूदीमन बर राजा के हुकूम</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1" />ओहीच दिन राजा छयर्स ह यहूदीमन के बईरी, हामान के घर-बार अऊ जमीन-बारी एस्तर रानी ला दे दीस। अऊ मोरदकै ह राजा के आघू म आईस, काबरकि एस्तर ह मोरदकै के संग अपन रिस्तेदारी के बारे म राजा ला बता दे रिहिस। <verse eid="EST 8:1" /><verse number="2" style="v" sid="EST 8:2" />तब राजा ह अपन ओ राज मुहरवाला मुंदरी ला निकालिस, जऊन ला ओह हामान ले लेय ले रिहिस, अऊ ओ मुंदरी ला मोरदकै ला दे दीस। अऊ एस्तर ह मोरदकै ला हामान के घर-बार अऊ जमीन-बारी के अधिकारी ठहिराईस।<verse eid="EST 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 8:3" />एस्तर ह राजा के गोड़ खाल्हे गिरके अऊ रोवत ओकर ले फेर बिनती करिस। ओह बिनती करके कहिस कि अगागी हामान ह यहूदीमन के बिरूध म जऊन हानि करे के योजना बनाय रिहिस, ओला खतम कर दिये जावय। <verse eid="EST 8:3" /><verse number="4" style="v" sid="EST 8:4" />तब राजा ह एस्तर कोति सोन के राजदंड ला बढ़ाईस अऊ एस्तर ह उठिस अऊ राजा के आघू म ठाढ़ हो गीस।<verse eid="EST 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 8:5" />ओह फेर बिनती करके कहिस, “यदि ये बात राजा ला बने लगथे, अऊ यदि ओकर दया-दिरिस्टी मोर ऊपर हवय अऊ ओह सोचथे कि अइसने करई ह सही अय, अऊ यदि ओह मोर ले खुस हवय, त जऊन आदेस हम्मदाता अगागी के बेटा हामान ह राजा के राज के जम्मो इलाका म यहूदीमन ला नास करे के खातिर लिखके पठोय रिहिस, ओ आदेस ला खारिज कर दिये जावय। <verse eid="EST 8:5" /><verse number="6" style="v" sid="EST 8:6" />काबरकि मोर मनखेमन ऊपर बिपत्ति आवय, येला मेंह देख नइं सकंव। मेंह अपन परिवार के बिनास ला कइसे देख सकत हंव?”<verse eid="EST 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 8:7" />तब राजा छयर्स ह एस्तर रानी ला अऊ यहूदी मोरदकै ला कहिस, “काबरकि हामान ह यहूदीमन ऊपर हमला करिस, एकरसेति मेंह ओकर घर-बार अऊ जमीन-बारी एस्तर ला देय दे हंव, अऊ ओला ओकर गड़वाय खंभा म टांग दिये गे हवय। <verse eid="EST 8:7" /><verse number="8" style="v" sid="EST 8:8" />अब जइसने तुमन ला बने लगे, वइसने तुमन राजा के नांव म यहूदीमन बर लिखव, अऊ ओमा राजा के मुंदरी के मुहर घलो लगावव—काबरकि जऊन कागजात ह राजा के नांव म लिखे जावय अऊ ओमा राजा के मुंदरी के मुहर लगय, ओला कोनो खारिज नइं कर सकय।”<verse eid="EST 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 8:9" />त ओहीच बेरा याने कि सीवान<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="ft" closed="false">बेबिलोनी कलेन्डर, जेह मई-जून ला दरसाथे</char></note> नांव के तीसरा महिना के तेईसवां दिन, राजा के सचिवमन ला बलाय गीस अऊ ओमन मोरदकै के दिये जम्मो हुकूम ला यहूदीमन ला, अऊ भारत ले लेके कूस तक के 127 राज के बड़े हाकिममन, राजपालमन अऊ परभावसाली मनखेमन ला लिखिन। ये हुकूममन ला हर राज के लिपि अऊ हर जाति के मनखेमन के भासा म लिखे गीस। ये जम्मो हुकूम ला यहूदीमन ला ओमन के लिपि अऊ भासा म घलो लिखे गीस। <verse eid="EST 8:9" /><verse number="10" style="v" sid="EST 8:10" />मोरदकै ह राजा छयर्स के नांव म लिखिस अऊ ओ कागजात म राजा के मुंदरी के मुहर लगाईस, अऊ ओ कागजातमन ला ओ घुड़सवारी करइया दूतमन के हांथ म पठो दीस, जऊन मन बिसेस करके राजा बर तेज घुड़सवारी करंय।<verse eid="EST 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 8:11" />राजा के साही हुकूम ले हर सहर म यहूदीमन ला अधिकार मिलिस कि ओमन जूरंय अऊ अपनआप के बचाव करंय; कोनो भी जाति या राज के हथियारबंद मनखेमन ओमन अऊ ओमन के माईलोगनमन अऊ लइकामन ऊपर हमला करंय, त ओमन ओ हथियारबंद मनखेमन ला नास कर देवंय, मार डारंय अऊ ओमन के नामोनिसान मिटा देवंय, अऊ अपन बईरीमन के संपत्ति ला लूट लेवंय। <verse eid="EST 8:11" /><verse number="12" style="v" sid="EST 8:12" />राजा छयर्स के जम्मो राज म, ये काम ला करे बर यहूदीमन खातिर एक दिन ठहिराय गीस, अऊ ओ दिन ह अदार नांव के बारहवां महिना के तेरहवां दिन रिहिस। <verse eid="EST 8:12" /><verse number="13" style="v" sid="EST 8:13" />ये साही हुकूम के एक-एक नकल कानून के रूप म जम्मो राज म पठोय गीस अऊ हर एक जाति के मनखेमन ला बताय गीस, ताकि यहूदीमन ओ दिन अपन बईरीमन ले बदला लेय बर तियार रहंय।<verse eid="EST 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 8:14" />राजा के हुकूम ले दूतमन साही घोड़ामन म सवार होके निकलिन अऊ आघू बढ़िन, अऊ साही हुकूम ह सूसनगढ़ के किला म ले दिये गीस।<verse eid="EST 8:14" /></para>
  <para style="s1">यहूदीमन के बिजय</para>
  <para style="p">
    <verse number="15" style="v" sid="EST 8:15" />जब मोरदकै ह राजा करा ले निकलके गीस, त ओह नीला अऊ सफेद रंग के राजकीय कपड़ा पहिरे रिहिस अऊ ओकर मुड़ म सोन के मुकुट रहय अऊ ओह सुघर मलमल के बने बैंगनी रंग के बागा पहिरे रिहिस। अऊ सूसनगढ़ सहर के मनखेमन आनंद के मारे जय-जयकार करिन। <verse eid="EST 8:15" /><verse number="16" style="v" sid="EST 8:16" />यहूदीमन बर, येह खुसी, आनंद अऊ आदरमान के बेरा रिहिस। <verse eid="EST 8:16" /><verse number="17" style="v" sid="EST 8:17" />ओ हर राज अऊ सहर, जिहां भी राजा के साही हुकूम आईस, उहां यहूदीमन आनंद अऊ खुसी ले भर गीन, अऊ ओमन जेवनार करके उत्सव मनाईन। अऊ आने जाति के बहुंते मनखेमन यहूदी बन गीन, काबरकि ओमन के मन म यहूदीमन के डर हमा गे रिहिस।<verse eid="EST 8:17" /></para>
  <chapter eid="EST 8" />
  <chapter number="9" style="c" sid="EST 9" />
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1" />अदार नांव के बारहवां महिना के तेरहवां दिन, राजा के दुवारा दिये गे हुकूम ला पूरा करना रिहिस। ये दिन यहूदीमन के बईरीमन ओमन के ऊपर जय पाय के आसा म रिहिन, पर अब येकर उल्टा हो गीस अऊ यहूदीमन ओ बईरीमन ऊपर भारी पड़िन, जेमन ओमन ले घिन करत रिहिन। <verse eid="EST 9:1" /><verse number="2" style="v" sid="EST 9:2" />यहूदी मनखेमन राजा छयर्स के जम्मो राजमन के अपन-अपन सहर म जूरिन, ताकि ओमन ओ मनखेमन ऊपर हमला करंय, जेमन यहूदीमन ला नास करे के ठाने रिहिन। कोनो मनखे यहूदीमन के सामना नइं कर सकिन, काबरकि आने जम्मो जाति के मनखेमन म यहूदीमन के डर हमा गे रिहिस। <verse eid="EST 9:2" /><verse number="3" style="v" sid="EST 9:3" />अऊ राजमन के जम्मो परभावसाली मनखेमन, हाकिममन, राजपालमन अऊ राजा के अधिकारीमन यहूदीमन के मदद करिन, काबरकि ओमन म मोरदकै के डर हमा गे रिहिस। <verse eid="EST 9:3" /><verse number="4" style="v" sid="EST 9:4" />मोरदकै ह महल म एक बड़े मनखे हो गीस; ओकर नांव ह जम्मो राजमन म फईल गीस, अऊ ओह अऊ सक्तिसाली होवत गीस।<verse eid="EST 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 9:5" />यहूदीमन अपन जम्मो बईरीमन ऊपर तलवार चलाके मार डारिन अऊ ओमन ला नास कर दीन, अऊ ओमन अपन घिन करइयामन ऊपर अपन मन मुताबिक बरताव करिन। <verse eid="EST 9:5" /><verse number="6" style="v" sid="EST 9:6" />सूसनगढ़ के किला म, यहूदीमन पांच सौ मनखे ला मारके नास कर दीन। <verse eid="EST 9:6" /><verse number="7" style="v" sid="EST 9:7" />ओमन परसनदाता, दलपोन, असपाता, <verse eid="EST 9:7" /><verse number="8" style="v" sid="EST 9:8" />पोराता, अदलया, अरीदाता, <verse eid="EST 9:8" /><verse number="9" style="v" sid="EST 9:9" />परमसता, अरीसै, अरीदै अऊ वैजाता ला घलो मार डारिन; <verse eid="EST 9:9" /><verse number="10" style="v" sid="EST 9:10" />ये दस झन हम्मदाता के बेटा हामान के बेटा रिहिन, जऊन ह यहूदीमन के बईरी रिहिस। पर यहूदीमन ओमन के संपत्ति ला नइं लूटिन।<verse eid="EST 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 9:11" />ओ दिन सूसनगढ़ के किला म जतेक झन मारे गीन, ओमन के संखिया ला ओहीच दिन राजा ला बता दिये गीस। <verse eid="EST 9:11" /><verse number="12" style="v" sid="EST 9:12" />तब राजा ह एस्तर रानी ला कहिस, “यहूदीमन सूसनगढ़ के किला म पांच सौ मनखे अऊ हामान के दसों बेटामन ला मारके नास कर दे हवंय। राजा के बाकि राजमन म, ओमन न जाने का-का करे हवंय? अब तोर अऊ का निबेदन हे? ओला घलो पूरा करे जाही। तेंह अऊ का मांगत हस? ओ घलो तोला दिये जाही।”<verse eid="EST 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 9:13" />एस्तर ह जबाब दीस, “यदि राजा ला ये बात बने लगय, त सूसनगढ़ म यहूदीमन ला अनुमति दिये जावय कि ओमन आज के राजा के हुकूम ला कल घलो करंय, अऊ हामान के दसों बेटामन ला खंभामन म टांग दिये जावय।”<verse eid="EST 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 9:14" />राजा ह हुकूम दीस कि अइसने करे जावय। सूसनगढ़ म राजा के ये हुकूम दिये गीस, अऊ ओमन हामान के दसों बेटा ला खंभामन म टांग दीन। <verse eid="EST 9:14" /><verse number="15" style="v" sid="EST 9:15" />सूसनगढ़ म यहूदीमन अदार महिना के चौदहवां दिन जूरिन, अऊ ओमन सूसनगढ़ म तीन सौ मनखे ला मार डारिन, पर यहूदीमन ओमन के संपत्ति ला नइं लूटिन।<verse eid="EST 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 9:16" />इही बीच म, राजा के राजमन के बाकि यहूदीमन घलो जूरिन, ताकि ओमन अपनआप ला बचा सकंय अऊ अपन बईरीमन के सतावा ले छुटकारा पा सकंय। ओमन अपन बईरीमन म ले पचहत्तर हजार मनखेमन ला मार डारिन, पर ओमन ओमन के संपत्ति ला नइं लूटिन। <verse eid="EST 9:16" /><verse number="17" style="v" sid="EST 9:17" />ये काम ला अदार महिना के तेरहवां दिन म करे गीस, अऊ चौदहवां दिन, ओमन अराम करिन अऊ ओ दिन ओमन जेवनार करिन अऊ आनंद मनाईन।<verse eid="EST 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EST 9:18" />पर सूसनगढ़ के यहूदीमन अदार महिना के तेरहवां अऊ चौदहवां दिन जूरिन, अऊ तब पंदरहवां दिन, ओमन अराम करिन अऊ ओ दिन ओमन जेवनार करिन अऊ आनंद मनाईन।<verse eid="EST 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EST 9:19" />येकरे कारन देहात के यहूदी—जऊन मन गांव म रहिथें, ओमन अदार के महिना के चौदहवां दिन ला आनंद अऊ जेवनार के दिन के रूप म अऊ एक-दूसर ला उपहार देय के दिन के रूप म मनाथें।<verse eid="EST 9:19" /></para>
  <para style="s1">पुरीम स्थापित करे जाथे</para>
  <para style="p">
    <verse number="20" style="v" sid="EST 9:20" />ये घटनामन ला मोरदकै ह लिखिस, अऊ ओह राजा छयर्स के जम्मो राजमन म, लकठा अऊ दूरिहा म रहइया जम्मो यहूदीमन करा चिट्ठी भेजिस, <verse eid="EST 9:20" /><verse number="21" style="v" sid="EST 9:21" />ताकि ओमन हर साल अदार महिना के चौदहवां अऊ पंदरहवां दिन उत्सव मनावंय, <verse eid="EST 9:21" /><verse number="22" style="v" sid="EST 9:22" />काबरकि येह ओ समय रिहिस, जब यहूदीमन अपन बईरीमन ले छुटकारा पाईन, अऊ ये ओ महिना रिहिस, जब ओमन के दुख ह आनंद म अऊ ओमन के सोक ह उत्सव म बदल गे रिहिस। ओह ओमन ला लिखिस कि ओमन ओ दिनमन ला जेवनार अऊ आनंद अऊ एक-दूसर करा जेवन के उपहार भेजई अऊ गरीबमन ला ईनाम देवई के दिन के रूप म मानंय।<verse eid="EST 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EST 9:23" />तब यहूदीमन मोरदकै के लिखे चिट्ठी के मुताबिक हर साल ओ उत्सव ला मनाय बर सहमत हो गीन, जेला कि ओमन ओ साल सुरू करे रिहिन। <verse eid="EST 9:23" /><verse number="24" style="v" sid="EST 9:24" />काबरकि हम्मदाता अगागी के बेटा हामान, जऊन ह जम्मो यहूदीमन के बईरी रिहिस, ओह यहूदीमन ला नास करे के उपाय रचे रिहिस अऊ ओमन के बरबादी अऊ बिनास बर <char style="tl">पुर</char> (चिट्ठी) डाले रिहिस। <verse eid="EST 9:24" /><verse number="25" style="v" sid="EST 9:25" />पर जब ये साजिस के बारे म राजा ला बताय गीस, त ओह लिखित म ये हुकूम दीस कि जऊन दुस्ट योजना हामान ह यहूदीमन के बिरोध म बनाय हवय, ओ योजना ला ओकर ही ऊपर पूरा करे जावय, अऊ ओला अऊ ओकर बेटामन ला खंभा म टांग दिये जावय। <verse eid="EST 9:25" /><verse number="26" style="v" sid="EST 9:26" />(एकरसेति ये दिनमन ला <char style="tl">पुर</char> सबद के कारन पुरीम कहे गीस।) ये चिट्ठी म लिखे जम्मो बात के कारन अऊ जऊन कुछू यहूदीमन देखे रिहिन अऊ जऊन कुछू ओमन ऊपर होय रिहिस, ये जम्मो के कारन, <verse eid="EST 9:26" /><verse number="27" style="v" sid="EST 9:27" />यहूदीमन अपन बर एक रिवाज बनाईन कि ओमन अऊ ओमन के संतानमन अऊ ओ जम्मो, जेमन ओमन के संग मिल गे हवंय, ये जम्मो के जम्मो हर साल ये दू दिन बिगर भूले उत्सव मनावंय अऊ ये उत्सव चिट्ठी म लिखे बात के मुताबिक ठहिराय गे समय म ही मनाय जावय। <verse eid="EST 9:27" /><verse number="28" style="v" sid="EST 9:28" />ये दिनमन ला हर पीढ़ी म हर एक परिवार के दुवारा मनाय जावय, अऊ येला हर राज अऊ हर सहर म मनाय जावय। अऊ पुरीम के ये दिनमन ला यहूदीमन के दुवारा बिगर कभू भूले मनाय जावय—अऊ न ही ओमन के संतानमन ये दिनमन ला कभू भूलंय।<verse eid="EST 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EST 9:29" />त फेर अबीहैल के बेटी एस्तर रानी, मोरदकै यहूदी के संग पूरा अधिकार से मजबूत करे बर पुरीम के बारे म ये दूसर चिट्ठी लिखिस। <verse eid="EST 9:29" /><verse number="30" style="v" sid="EST 9:30" />अऊ मोरदकै ह छयर्स राजा के 127 राज के जम्मो यहूदीमन ला सद्भावना अऊ भरोसा के चिट्ठी लिख भेजिस, <verse eid="EST 9:30" /><verse number="31" style="v" sid="EST 9:31" />ताकि ओमन मोरदकै यहूदी अऊ एस्तर रानी के दिये हुकूम के मुताबिक पुरीम के ये दिनमन ला अपन ठहिराय गे समय म मानंय, अऊ जइसने कि ओमन अपन अऊ अपन संतानमन बर उपास अऊ सोक के समय ठहिराय रिहिन। <verse eid="EST 9:31" /><verse number="32" style="v" sid="EST 9:32" />एस्तर के हुकूम ह पुरीम के बारे म ये नियममन ला मजबूत करिस, अऊ येला किताब म लिखके रखे गीस।<verse eid="EST 9:32" /></para>
  <chapter eid="EST 9" />
  <chapter number="10" style="c" sid="EST 10" />
  <para style="s1">मोरदकै के महानता</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1" />राजा छयर्स ह पूरा देस म अऊ येकर दूरिहा के समुंदर तीर तक राजकर लगाईस। <verse eid="EST 10:1" /><verse number="2" style="v" sid="EST 10:2" />अऊ ओकर सक्ति अऊ पराकरम के जम्मो काम अऊ मोरदकै के महानता के पूरा लेखा-जोखा, जेला राजा ह ऊपर उठाय रिहिस, ओ जम्मो बात मादै अऊ फारस के राजामन के इतिहास के किताब म लिखे गे हवय। <verse eid="EST 10:2" /><verse number="3" style="v" sid="EST 10:3" />मोरदकै यहूदी के पद ह छयर्स राजा के बाद दूसरा रिहिस; यहूदीमन के बीच म ओह सबले उत्तम रिहिस, अऊ ओकर बहुंते यहूदी संगीमन ओकर बहुंत आदर करंय, काबरकि ओह अपन मनखेमन के भलई बर काम करय अऊ जम्मो यहूदीमन के सुख-सांति बर गोठियावय।<verse eid="EST 10:3" /></para>
  <chapter eid="EST 10" />
</usx>