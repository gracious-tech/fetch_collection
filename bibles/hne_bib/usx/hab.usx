<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">हबक्कूक</para>
  <para style="toc1">हबक्कूक के किताब</para>
  <para style="toc2">हबक्कूक</para>
  <para style="toc3">हब</para>
  <para style="mt1">हबक्कूक</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="HAB 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1"/>अगमबानी, जेला हबक्कूक अगमजानी ह पाईस।<verse eid="HAB 1:1"/></para>
  <para style="b"/>
  <para style="s1">हबक्कूक के सिकायत</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2"/>हे यहोवा, मेंह कब तक मदद बर तोर ले गोहार लगावत रहंव,</para>
  <para style="q2" vid="HAB 1:2">पर तेंह नइं सुनत हस?</para>
  <para style="q1" vid="HAB 1:2">या मेंह कब तक चिल्लावत रहंव, “हिंसा!”</para>
  <para style="q2" vid="HAB 1:2">पर तेंह नइं बचात हस?<verse eid="HAB 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3"/>तेंह काबर मोला अनियाय ला देखे बर मजबूर करथस?</para>
  <para style="q2" vid="HAB 1:3">काबर तेंह गलत काम ला सहत हस?</para>
  <para style="q1" vid="HAB 1:3">मोर आघू म बरबादी अऊ हिंसा होवथे;</para>
  <para style="q2" vid="HAB 1:3">झगड़ा अऊ बिबाद बहुंत होवत हे।<verse eid="HAB 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4"/>येकर कारन नियम-कानून ह ढीला पर गे हवय,</para>
  <para style="q2" vid="HAB 1:4">नियाय मिलत नइं ए।</para>
  <para style="q1" vid="HAB 1:4">दुस्टमन धरमीमन ला घेर डारे हवंय,</para>
  <para style="q2" vid="HAB 1:4">जेकर से सही नियाय नइं मिलत हवय।<verse eid="HAB 1:4"/></para>
  <para style="s1">यहोवा के जबाब</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5"/>“जाति-जाति के मनखेमन कोति धियान से देखव—</para>
  <para style="q2" vid="HAB 1:5">अऊ बहुंतेच चकित होवव।</para>
  <para style="q1" vid="HAB 1:5">काबरकि मेंह तुम्हर समय म कुछू अइसन करे बर जावत हंव</para>
  <para style="q2" vid="HAB 1:5">यदि ओकर बारे म कोनो तुमन ला बतावय,</para>
  <para style="q2" vid="HAB 1:5">तभो ले तुमन कभू बिसवास नइं करहू।<verse eid="HAB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6"/>मेंह बेबिलोनीमन<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> ला उभारत हंव,</para>
  <para style="q2" vid="HAB 1:6">ओमन निरदयी अऊ दुस्साहसी मनखे अंय,</para>
  <para style="q1" vid="HAB 1:6">जेमन पूरा धरती ऊपर फईलत हवंय</para>
  <para style="q2" vid="HAB 1:6">ताकि ओ निवासमन ऊपर कब्जा कर लेवंय, जेमन ओमन के नो हंय।<verse eid="HAB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7"/>ओमन डरावना अऊ भयानक मनखे अंय;</para>
  <para style="q2" vid="HAB 1:7">ओमन खुद अपनआप म कानून अंय</para>
  <para style="q2" vid="HAB 1:7">अऊ ओमन अपन खुद के आदरमान ला बढ़ावा देथें।<verse eid="HAB 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8"/>ओमन के घोड़ामन चीतवामन ले भी जादा तेज दऊड़थें,</para>
  <para style="q2" vid="HAB 1:8">अऊ संझा समय के भेड़ियामन ले भी जादा घातक होथें।</para>
  <para style="q1" vid="HAB 1:8">ओमन म सवार सैनिक अपन घोड़ामन ला बिगर सोचे-बिचारे दऊड़ाथें;</para>
  <para style="q2" vid="HAB 1:8">ओमन के घुड़सवारमन बहुंत दूरिहा ले आथें।</para>
  <para style="q1" vid="HAB 1:8">झपटके अपन सिकार ला खा जानेवाला गिधवा सहीं ओमन उड़थें;<verse eid="HAB 1:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9"/>ओमन सब के सब हतिया करे के मनसा से ही आथें।</para>
  <para style="q1" vid="HAB 1:9">ओमन के उपदरवी झुंडमन मरू-भुइयां के आंधी सहीं आघू बढ़थें</para>
  <para style="q2" vid="HAB 1:9">अऊ कैदीमन ला बालू कस संकेलथें।<verse eid="HAB 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10"/>ओमन राजामन के ठट्ठा करथें</para>
  <para style="q2" vid="HAB 1:10">अऊ हाकिममन के हंसी उड़ाथें।</para>
  <para style="q1" vid="HAB 1:10">ओमन गढ़वाले सहरमन ऊपर हंसथें;</para>
  <para style="q2" vid="HAB 1:10">माटी के ढलान बनाके ओमन ओ सहरमन ऊपर कब्जा करथें।<verse eid="HAB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11"/>तब ओमन हवा सहीं निकल जाथें अऊ आघू बढ़त रहिथें—</para>
  <para style="q2" vid="HAB 1:11">ओमन दोसी मनखे अंय, जेमन के खुद के बल ही ओमन के देवता अय।”<verse eid="HAB 1:11"/></para>
  <para style="s1">हबक्कूक के दूसरा सिकायत</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12"/>हे यहोवा, का तेंह अनादिकाल ले नइं अस?</para>
  <para style="q2" vid="HAB 1:12">हे मोर परमेसर, मोर पबितर परमेसर, तेंह कभू नइं मरस।</para>
  <para style="q1" vid="HAB 1:12">हे यहोवा, तेंह ओमन ला नियाय करे बर ठहिराय हस;</para>
  <para style="q2" vid="HAB 1:12">हे मोर चट्टान, तेंहीच ह ओमन ला दंड देय बर अभिसेक करे हस।<verse eid="HAB 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13"/>तोर आंखीमन अइसन सुध हें कि बुरई ला नइं देख सकंय;</para>
  <para style="q2" vid="HAB 1:13">तेंह अधरम ला सहे नइं सकस।</para>
  <para style="q1" vid="HAB 1:13">त फेर तेंह काबर बिसवासघातीमन के सहन करथस?</para>
  <para style="q2" vid="HAB 1:13">तेंह काबर चुप रहिथस, जब दुस्टमन</para>
  <para style="q2" vid="HAB 1:13">अपन ले जादा धरमीमन ला लील डारथें?<verse eid="HAB 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14"/>तेंह मनखेमन ला समुंदर के मछरी सहीं,</para>
  <para style="q2" vid="HAB 1:14">अऊ समुंदर के जीव-जन्तु सहीं बनाय हस, जेमन ऊपर कोनो हाकिम नइं रहय।<verse eid="HAB 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15"/>दुस्ट बईरी ह ओ जम्मो ला गरी म फंसाके खींच लेथे,</para>
  <para style="q2" vid="HAB 1:15">ओह ओमन ला अपन जाल म पकड़ लेथे,</para>
  <para style="q1" vid="HAB 1:15">ओह ओमन ला अपन मछरी के जाल म इकट्ठा करथे;</para>
  <para style="q2" vid="HAB 1:15">अऊ ये किसम ले ओह आनंद अऊ खुसी मनाथे।<verse eid="HAB 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16"/>एकरसेति ओह अपन जाल बर बलि चघाथे,</para>
  <para style="q2" vid="HAB 1:16">अऊ अपन मछरी के जाल के आघू म धूप जलाथे,</para>
  <para style="q1" vid="HAB 1:16">काबरकि अपन जाल के कारन ही ओह अराम के जिनगी जीथे</para>
  <para style="q2" vid="HAB 1:16">अऊ मनपसंद भोजन के मजा लेथे।<verse eid="HAB 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17"/>पर का ओह अपन जाल ला खाली करत,</para>
  <para style="q2" vid="HAB 1:17">बिगर दया के जाति-जाति के मनखेमन ला नास करते रहिही?<verse eid="HAB 1:17"/></para>
  <para style="b"/>
  <chapter eid="HAB 1"/>
  <chapter number="2" style="c" sid="HAB 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1"/>मेंह अपन पहरा म ठाढ़े रहिहूं</para>
  <para style="q2" vid="HAB 2:1">अऊ गढ़ के ऊंच दीवार ऊपर चढ़के ठाढ़े रहिहूं;</para>
  <para style="q1" vid="HAB 2:1">मेंह देखत रहिहूं कि ओह मोला का कहिही,</para>
  <para style="q2" vid="HAB 2:1">अऊ में ये सिकायत के का जबाब दंव।<verse eid="HAB 2:1"/></para>
  <para style="s1">यहोवा के जबाब</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2"/>तब यहोवा ह मोला जबाब दीस:</para>
  <para style="q1" vid="HAB 2:2">“दरसन के बात ला</para>
  <para style="q2" vid="HAB 2:2">पटियामन ऊपर साफ-साफ लिख दे</para>
  <para style="q2" vid="HAB 2:2">ताकि घोसना करइया ह दऊड़त-दऊड़त येमा लिखे बात पढ़के घोसना करय।<verse eid="HAB 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3"/>काबरकि ये दरसन के बात ह एक ठहिराय समय म पूरा होही;</para>
  <para style="q2" vid="HAB 2:3">येह आखिरी समय के बारे म बताथे</para>
  <para style="q2" vid="HAB 2:3">अऊ येह गलत साबित नइं होवय।</para>
  <para style="q1" vid="HAB 2:3">भले ही येमा देरी होवय, पर ये बात के इंतजार करव;</para>
  <para style="q2" vid="HAB 2:3">येह जरूर पूरा होही</para>
  <para style="q2" vid="HAB 2:3">अऊ येमा देरी नइं होवय।<verse eid="HAB 2:3"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4"/>“देख, बईरी के मन ह फुल गे हवय;</para>
  <para style="q2" vid="HAB 2:4">ओह बुरई के ईछा करथे—</para>
  <para style="q2" vid="HAB 2:4">पर धरमी मनखे ह अपन बिसवासयोग्यता<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बिसवास</char></note> के दुवारा जीयत रहिही—<verse eid="HAB 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5"/>वास्तव म, अंगूर के मंद ह ओला धोखा देथे;</para>
  <para style="q2" vid="HAB 2:5">ओह घमंडी अय अऊ कभू अराम से नइं रहय।</para>
  <para style="q1" vid="HAB 2:5">काबरकि ओह कबर सहीं लोभी अय</para>
  <para style="q2" vid="HAB 2:5">अऊ मिरतू सहीं कभू संतोस नइं होवय,</para>
  <para style="q1" vid="HAB 2:5">ओह जम्मो जाति के मनखेमन ला अपन करा संकेलथे,</para>
  <para style="q2" vid="HAB 2:5">अऊ जम्मो मनखेमन ला अपन बंधुवा बनाके ले जाथे।<verse eid="HAB 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6"/>“का ओ जम्मो झन ये कहिके ओकर हंसी नइं उड़ाहीं अऊ बेजत्ती करके ताना नइं मारहीं,</para>
  <para style="q1" vid="HAB 2:6">“ ‘ओकर ऊपर हाय, जऊन ह चोरी के सामान के ढेर लगाथे</para>
  <para style="q2" vid="HAB 2:6">लूट के धन ले धनवान बन जाथे!</para>
  <para style="q2" vid="HAB 2:6">येह कब तक चलत रहिही?’<verse eid="HAB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7"/>का तुमन ला करजा देवइयामन अचानक तुम्हर मेर नइं आ जाहीं?</para>
  <para style="q2" vid="HAB 2:7">का ओमन जागके तुमन ला नइं डरवाहीं?</para>
  <para style="q2" vid="HAB 2:7">तब तुमन ओमन के सिकार बन जाहू।<verse eid="HAB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8"/>काबरकि तुमन बहुंते जाति के मनखेमन ला लूटे हव,</para>
  <para style="q2" vid="HAB 2:8">बांचे मनखेमन अब तुमन ला लूटहीं।</para>
  <para style="q1" vid="HAB 2:8">काबरकि तुमन मनखेमन के लहू बहाय हव;</para>
  <para style="q2" vid="HAB 2:8">तुमन देस अऊ सहरमन ला उहां रहइया मनखेमन सहित बरबाद कर दे हवव।<verse eid="HAB 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9"/>“ओकर ऊपर हाय, जऊन ह अनियाय के कमई ले अपन घर ला बनाथे,</para>
  <para style="q2" vid="HAB 2:9">अऊ बरबादी ले बांचे बर</para>
  <para style="q2" vid="HAB 2:9">अपन खोंधरा ऊंचहा जगह म बनाथे!<verse eid="HAB 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10"/>अपन ही घर ला लज्जित करके अऊ अपन ही परान ला जोखिम म डालके</para>
  <para style="q2" vid="HAB 2:10">तेंह बहुंते मनखेमन के बिनास के उपाय करे हस।<verse eid="HAB 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11"/>दीवार के पथरामन चिचियाहीं,</para>
  <para style="q2" vid="HAB 2:11">अऊ लकरी के बल्लीमन येकर जबाब दीहीं।<verse eid="HAB 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12"/>“ओकर ऊपर हाय, जऊन ह लहू बोहाके एक सहर ला बनाथे</para>
  <para style="q2" vid="HAB 2:12">अऊ अनियाय करके नगर ला बसाथे।<verse eid="HAB 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13"/>का सर्वसक्तिमान यहोवा ह ये बात ला नइं ठान ले हवय</para>
  <para style="q2" vid="HAB 2:13">कि मनखेमन के मेहनत ह सिरिप आगी बारे के लकरी सहीं अय,</para>
  <para style="q2" vid="HAB 2:13">अऊ जाति-जाति के मनखेमन बेकार म मेहनत करथें?<verse eid="HAB 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14"/>काबरकि धरती ह यहोवा के महिमा के गियान ले अइसन भर जाही</para>
  <para style="q2" vid="HAB 2:14">जइसन पानी समुंदर म भरे रहिथे।<verse eid="HAB 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15"/>“ओकर ऊपर हाय, जऊन ह अपन परोसीमन ला मंद पीयाथे,</para>
  <para style="q2" vid="HAB 2:15">अऊ ओमन ला चाम के थैली ले तब तक ढारके देवत रहिथे,</para>
  <para style="q1" vid="HAB 2:15">जब तक कि ओमन पीके मतवाला नइं हो जावंय,</para>
  <para style="q2" vid="HAB 2:15">ताकि ओह ओमन के नंगरा देहें ला निहार सकय!<verse eid="HAB 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16"/>तेंह महिमा के बदले लाज ले भर जाबे।</para>
  <para style="q2" vid="HAB 2:16">अब तोर पारी ए! तेंह पी अऊ तोर नंगई ह दिखय!</para>
  <para style="q1" vid="HAB 2:16">यहोवा के जेवनी हांथ के कटोरा तोर मेर आवत हे,</para>
  <para style="q2" vid="HAB 2:16">अऊ कलंक ह तोर महिमा ला ढांप दीही।<verse eid="HAB 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17"/>तेंह जऊन हिंसा के काम लबानोन म करे हस, ओमन तोला बियाकुल करहीं,</para>
  <para style="q2" vid="HAB 2:17">अऊ पसुमन के जऊन बिनास तेंह करे हस, ओह तोला भयभीत करही।</para>
  <para style="q1" vid="HAB 2:17">काबरकि तेंह मनखेमन के लहू बहाय हस;</para>
  <para style="q2" vid="HAB 2:17">तेंह देस, सहर अऊ उहां के सब निवासीमन ला नास करे हस।<verse eid="HAB 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18"/>“एक कारीगर के दुवारा बनाय गे मूरती के का महत्व?</para>
  <para style="q2" vid="HAB 2:18">या ओ मूरती ले का लाभ, जऊन ह झूठ बोले बर सिखोथे?</para>
  <para style="q1" vid="HAB 2:18">काबरकि जऊन ह येला बनाथे, ओह अपनेच बनाय चीज ऊपर भरोसा करथे;</para>
  <para style="q2" vid="HAB 2:18">ओह मूरतीमन ला बनाथे, जेमन गोठियाय नइं सकंय।<verse eid="HAB 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19"/>ओकर ऊपर हाय, जऊन ह कठवा ले कहिथे, ‘जी उठ!’</para>
  <para style="q2" vid="HAB 2:19">या निरजीव पथरा ले कहिथे, ‘उठ!’</para>
  <para style="q1" vid="HAB 2:19">का येह सिखो सकथे?</para>
  <para style="q2" vid="HAB 2:19">येला सोन अऊ चांदी ले मढ़े जाथे;</para>
  <para style="q2" vid="HAB 2:19">ओमा सांस नइं ए।”<verse eid="HAB 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20"/>यहोवा ह अपन पबितर मंदिर म हवय;</para>
  <para style="q2" vid="HAB 2:20">पूरा धरती ह ओकर आघू म सांत रहे।<verse eid="HAB 2:20"/></para>
  <chapter eid="HAB 2"/>
  <chapter number="3" style="c" sid="HAB 3"/>
  <para style="s1">हबक्कूक के पराथना</para>
  <para style="d">
    <verse number="1" style="v" sid="HAB 3:1"/>
    <char style="tl">सिग्योनोत</char> के रीति म, हबक्कूक अगमजानी के एक पराथना।<verse eid="HAB 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2"/>हे यहोवा, मेंह तोर बड़ई ला सुने हंव;</para>
  <para style="q2" vid="HAB 3:2">हे यहोवा, मेंह तोर काममन ला देखके भयभीत होथंव।</para>
  <para style="q1" vid="HAB 3:2">हमर दिन म ओमन ला फेर दोहरा,</para>
  <para style="q2" vid="HAB 3:2">हमर समय म ओ काममन ला बता;</para>
  <para style="q2" vid="HAB 3:2">अपन कोप म भी अपन दया ला सुरता रख।<verse eid="HAB 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3"/>परमेसर ह तेमान देस ले आईस,</para>
  <para style="q2" vid="HAB 3:3">पबितर परमेसर ह पारान पहाड़ ले आईस।</para>
  <para style="q1" vid="HAB 3:3">ओकर महिमा ह अकास ला ढांप दीस</para>
  <para style="q2" vid="HAB 3:3">अऊ ओकर इस्तुति ले धरती ह भर गीस।<verse eid="HAB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4"/>ओकर सोभा ह सूरज निकले सहीं रिहिस;</para>
  <para style="q2" vid="HAB 3:4">ओकर हांथ ले किरन निकलत रिहिस,</para>
  <para style="q2" vid="HAB 3:4">जिहां ओकर सामर्थ ह छिपे रिहिस।<verse eid="HAB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5"/>ओकर आघू-आघू महामारी फईलत जात रिहिस;</para>
  <para style="q2" vid="HAB 3:5">महारोग ओकर पाछू-पाछू चलत रिहिस।<verse eid="HAB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6"/>ओह ठाढ़ होके धरती ला कंपा दीस;</para>
  <para style="q2" vid="HAB 3:6">ओह देखिस, अऊ जाति-जाति के मनखेमन ला कंपा दीस।</para>
  <para style="q1" vid="HAB 3:6">पुराना पहाड़मन कुटा-कुटा हो गीन</para>
  <para style="q2" vid="HAB 3:6">अऊ पुराना पहाड़ीमन गिर गीन—</para>
  <para style="q2" vid="HAB 3:6">पर ओह हमेसा ही आघू बढ़त रहिथे।<verse eid="HAB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7"/>मेंह कूसान के तम्बू म रहइयामन ला दुख म,</para>
  <para style="q2" vid="HAB 3:7">अऊ मिदयान देस के रहइयामन ला पीरा म पड़े देखेंव।<verse eid="HAB 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8"/>हे यहोवा, का तेंह नदीमन ऊपर गुस्सा करे?</para>
  <para style="q2" vid="HAB 3:8">का तोर कोप ह पानी के सोतामन ऊपर रिहिस?</para>
  <para style="q1" vid="HAB 3:8">का तेंह समुंदर ऊपर कोरोध करे</para>
  <para style="q2" vid="HAB 3:8">जब तेंह जय पाय बर अपन घोड़ामन ऊपर</para>
  <para style="q2" vid="HAB 3:8">अऊ अपन रथमन ऊपर सवारी करे?<verse eid="HAB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9"/>तेंह अपन धनुस ला ओकर खोल ले निकाले,</para>
  <para style="q2" vid="HAB 3:9">तेंह बहुंत अकन तीर ला मंगाय।</para>
  <para style="q1" vid="HAB 3:9">तेंह नदीमन ले धरती ला बांट देय;<verse eid="HAB 3:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 3:10"/>पहाड़मन तोला देखके कांप गीन।</para>
  <para style="q1" vid="HAB 3:10">भारी पानी तेजी से बहे लगिस;</para>
  <para style="q2" vid="HAB 3:10">गहिला समुंदर गरज उठिस</para>
  <para style="q2" vid="HAB 3:10">अऊ ओमा बड़े-बड़े लहरामन उठे लगिन।<verse eid="HAB 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11"/>तोर उड़त तीरमन के चमक ले,</para>
  <para style="q2" vid="HAB 3:11">तोर चमचमात भाला के तेज ले</para>
  <para style="q2" vid="HAB 3:11">सूरज अऊ चंदा अकास म ठहर गीन।<verse eid="HAB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12"/>तेंह कोरोध म आके धरती ऊपर तेजी से रेंगय</para>
  <para style="q2" vid="HAB 3:12">अऊ रिस म आके जाति-जाति के मनखेमन ला रऊंद देय।<verse eid="HAB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13"/>तेंह अपन मनखेमन के छुटकारा,</para>
  <para style="q2" vid="HAB 3:13">अऊ अपन अभिसिक्त जन ला बचाय बर बाहिर निकले।</para>
  <para style="q1" vid="HAB 3:13">तेंह दुस्ट देस के अगुवा ला कुचर देय,</para>
  <para style="q2" vid="HAB 3:13">ओला मुड़ ले लेके गोड़ तक नंगरा कर देय।<verse eid="HAB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14"/>तेंह ओकरेच भाला ले ओकर मुड़ ला छेद देय</para>
  <para style="q2" vid="HAB 3:14">जब ओकर सैनिकमन हमन ला तितिर-बितिर करे बर हमर ऊपर टूट पड़िन,</para>
  <para style="q1" vid="HAB 3:14">ओमन अइसन देखत रिहिन,</para>
  <para style="q2" vid="HAB 3:14">मानो लुकाय दुस्ट मनखेमन ला नास करइया हवंय।<verse eid="HAB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15"/>तेंह अपन घोड़ामन के दुवारा समुंदर ला खदमदात,</para>
  <para style="q2" vid="HAB 3:15">ओकर भयंकर पानी ला मथ डारे।<verse eid="HAB 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16"/>मेंह सुनेंव अऊ मोर मन ह टूट गीस,</para>
  <para style="q2" vid="HAB 3:16">ओ अवाज सुनके मोर ओंठ ह कांपे लगिस;</para>
  <para style="q1" vid="HAB 3:16">मोर हाड़ामन सरे लगिन,</para>
  <para style="q2" vid="HAB 3:16">अऊ मोर गोड़मन कांपे लगिन।</para>
  <para style="q1" vid="HAB 3:16">तभो ले, मेंह धीरज धरके ओ जाति के मनखेमन ऊपर</para>
  <para style="q2" vid="HAB 3:16">अवइया बिपत्ति के दिन के बाट जोहत रहिहूं, जेमन हमर ऊपर हमला करत हवंय।<verse eid="HAB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17"/>चाहे अंजीर के रूख म अंकुर झन निकलय</para>
  <para style="q2" vid="HAB 3:17">अऊ अंगूर के नार म अंगूर झन फरय,</para>
  <para style="q1" vid="HAB 3:17">चाहे जैतून के रूख म फर झन लगंय</para>
  <para style="q2" vid="HAB 3:17">अऊ खेत म अनाज झन होवय।</para>
  <para style="q1" vid="HAB 3:17">चाहे बाड़ा म कोनो भेड़ झन रहंय</para>
  <para style="q2" vid="HAB 3:17">अऊ कोठा म कोनो पसु झन होवंय,<verse eid="HAB 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18"/>तभो ले मेंह यहोवा म आनंद मनाहूं,</para>
  <para style="q2" vid="HAB 3:18">मेंह परमेसर अपन उद्धारकर्ता म आनंदित होहूं।<verse eid="HAB 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19"/>परमपरधान यहोवा ह मोर बल अय;</para>
  <para style="q2" vid="HAB 3:19">ओह मोर पांव ला हिरन के पांव सहीं बना देथे,</para>
  <para style="q2" vid="HAB 3:19">ओह मोला ऊंच जगह म चले के लईक बनाथे।</para>
  <para style="d" vid="HAB 3:19">संगीत निरदेसक बर। मोर तारवाले बाजामन के संग।<verse eid="HAB 3:19"/></para>
  <chapter eid="HAB 3"/>
</usx>
