<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2SA" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">2 समूएल</para>
  <para style="toc1">समूएल के दूसरा किताब</para>
  <para style="toc2">2 समूएल</para>
  <para style="toc3">2 समू</para>
  <para style="mt1">समूएल</para>
  <para style="mt2">के दूसरा किताब</para>
  <chapter number="1" style="c" sid="2SA 1" />
  <para style="s1">दाऊद ला साऊल के मिरतू के समाचार मिलथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1" />साऊल के मरे के बाद, जब दाऊद ह अमालेकीमन ला मारके लहुंटिस, अऊ दाऊद ला सिकलग सहर म रहत दू दिन हो गीस, <verse eid="2SA 1:1" /><verse number="2" style="v" sid="2SA 1:2" />तब तीसर दिन अइसने होईस कि साऊल के छावनी म ले एक मनखे आईस, जेकर ओनहा ह फटे रहय अऊ ओकर मुड़ म धुर्रा रहय। जब ओह दाऊद के लकठा म आईस, त ओह भुइयां म गिरके दाऊद ला दंडवत करिस।<verse eid="2SA 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 1:3" />दाऊद ह ओकर ले पुछिस, “तेंह कहां ले आवत हस?”</para>
  <para style="p" vid="2SA 1:3">ओह जबाब दीस, “मेंह इसरायली छावनी ले बांचके आय हवंव।”<verse eid="2SA 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 1:4" />दाऊद ह पुछिस, “उहां का बात होईस? मोला बता।”</para>
  <para style="p" vid="2SA 1:4">ओह जबाब दीस, “इसरायली मनखेमन लड़ई के मैदान ला छोंड़के भाग गीन। बहुंते झन गिरके मर गीन। अऊ साऊल अऊ ओकर बेटा योनातन घलो मारे गीन।”<verse eid="2SA 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 1:5" />तब दाऊद ह ओ समाचार देवइया जवान ले पुछिस, “तोला कइसे पता चलिस कि साऊल अऊ ओकर बेटा योनातन मर गे हवंय?”<verse eid="2SA 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 1:6" />ओ जवान ह कहिस, “संजोग के बात ए कि मेंह गिलबो पहाड़ म रहेंव, त मेंह देखेंव कि साऊल ह अपन भाला ऊपर टेक लगाय हवय, अऊ ओकर पीछा करत रथ अऊ सवारमन बड़ तेजी से आवत रहंय। <verse eid="2SA 1:6" /><verse number="7" style="v" sid="2SA 1:7" />जब साऊल ह पाछू मुड़िस अऊ मोला देखिस, त ओह मोला बलाईस, अऊ मेंह कहेंव, ‘मोर बर का हुकूम हे?’<verse eid="2SA 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 1:8" />“ओह मोर ले पुछिस, ‘तें कोन अस?’</para>
  <para style="p" vid="2SA 1:8">“मेंह कहेंव, ‘मेंह एक अमालेकी अंव।’<verse eid="2SA 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 1:9" />“तब ओह मोला कहिस, ‘मोर बाजू म ठाढ़ होके मोला मार डार! मेंह मिरतू के पीरा म कलपत हंव, पर मोर परान ह नइं निकलत हे।’<verse eid="2SA 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 1:10" />“तब मेंह ओकर बाजू म ठाढ़ होके ओला मार डारेंव, काबरकि मेंह जान गे रहेंव कि ओह गिर जाय के बाद नइं बांच सकय। अऊ मेंह ओकर मुड़ के मुकुट अऊ ओकर बाहां के कंगन ला इहां अपन मालिक करा ले आय हंव।”<verse eid="2SA 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 1:11" />तब दाऊद अऊ उहां ओकर संग के जम्मो मनखेमन सोक म अपन ओनहा ला पकड़के चीरिन। <verse eid="2SA 1:11" /><verse number="12" style="v" sid="2SA 1:12" />ओमन साऊल अऊ ओकर बेटा योनातन बर, अऊ यहोवा के सेना बर अऊ इसरायल के घराना बर बिलाप करिन अऊ रोईन अऊ संझा तक उपास करिन, काबरकि ओमन तलवार ले मारे गे रिहिन।<verse eid="2SA 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 1:13" />दाऊद ह ओ समाचार देवइया जवान ले पुछिस, “तें कहां के अस?”</para>
  <para style="p" vid="2SA 1:13">ओह जबाब दीस, “में एक परदेसी के बेटा, एक अमालेकी अंव।”<verse eid="2SA 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 1:14" />दाऊद ह ओकर ले पुछिस, “तेंह यहोवा के अभिसिक्त जन ला नास करे बर अपन हांथ उठाय ले काबर नइं डरय?”<verse eid="2SA 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 1:15" />तब दाऊद ह अपन एक जवान ला बलाके कहिस, “जा अऊ ओला मार डार।” तब ओह ओ समाचार देवइया ला अइसे मारिस कि ओह मर गीस। <verse eid="2SA 1:15" /><verse number="16" style="v" sid="2SA 1:16" />काबरकि दाऊद ह ओ समाचार देवइया ला कहे रिहिस, “तोर खून के दोस तोला ही लगय। तेंह खुद अपन मुहूं ले अपन बिरूध ये कहिके गवाही दे हस, ‘मेंह यहोवा के अभिसिक्त जन ला मार डारेंव।’ ”<verse eid="2SA 1:16" /></para>
  <para style="s1">साऊल अऊ योनातन बर दाऊद के बिलाप</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17" />तब दाऊद ह साऊल अऊ ओकर बेटा योनातन के बारे म ये बिलाप करिस, <verse eid="2SA 1:17" /><verse number="18" style="v" sid="2SA 1:18" />अऊ ओह हुकूम दीस कि यहूदा के मनखेमन ला धनुस नांव के ये बिलापगीत सिखाय जावय (ये बिलापगीत ह यासार नांव के किताब म लिखाय हवय):<verse eid="2SA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 1:19" />“हे इसरायल, एक सुघर हिरन<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="fq" closed="false">हिरन </char><char style="ft" closed="false">इहां येह मनखे के आदरमान ला बताथे</char></note> तोर ऊंचहा जगह म मरे पड़े हे।</para>
  <para style="q2" vid="2SA 1:19">सूरबीर ह कइसे गिरे पड़े हवय!<verse eid="2SA 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="2SA 1:20" />“गत म येला झन बतावव,</para>
  <para style="q2" vid="2SA 1:20">अस्कलोन के गलीमन म येकर घोसना झन करव,</para>
  <para style="q1" vid="2SA 1:20">अइसन झन होवय कि पलिस्तीमन के माईलोगनमन खुस होवंय,</para>
  <para style="q2" vid="2SA 1:20">अइसन झन होवय कि खतनारहित मनखेमन के माईलोगनमन आनंद मनावंय।<verse eid="2SA 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="2SA 1:21" />“हे गिलबो के पहाड़मन,</para>
  <para style="q2" vid="2SA 1:21">तुम्हर ऊपर न तो ओस पड़य अऊ न ही बारिस होवय,</para>
  <para style="q2" vid="2SA 1:21">तुम्हर चौरस खेतमन<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओ खेत जेमा भेंट चघाय के अनाज होथे</char></note> म झड़ी के फुहार झन लगय।</para>
  <para style="q1" vid="2SA 1:21">काबरकि उहां सूरबीर के ढाल ला तुछ समझे गीस,</para>
  <para style="q2" vid="2SA 1:21">साऊल के ढाल—बिगर तेल लगाय रह गीस।<verse eid="2SA 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="2SA 1:22" />“मारे गय मनखे के खून बोहाय बिगर,</para>
  <para style="q2" vid="2SA 1:22">सूरबीरमन के मांस खाय बिगर,</para>
  <para style="q1" vid="2SA 1:22">योनातन के धनुस ह नइं लहुंटत रिहिस,</para>
  <para style="q2" vid="2SA 1:22">अऊ न ही साऊल के तलवार ह असंतुस्ट होके लहुंटत रिहिस।<verse eid="2SA 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 1:23" />साऊल अऊ योनातन ला ओमन के जिनगी म</para>
  <para style="q2" vid="2SA 1:23">ओमन ला मया मिलिस अऊ ओमन के परसंसा करे गीस,</para>
  <para style="q2" vid="2SA 1:23">अऊ अपन मिरतू के बेरा म घलो ओमन अलग नइं होईन।</para>
  <para style="q1" vid="2SA 1:23">ओमन गिधवा ले घलो तेज चलइया,</para>
  <para style="q2" vid="2SA 1:23">अऊ सिंह ले घलो जादा बलवान रिहिन।<verse eid="2SA 1:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="2SA 1:24" />“हे इसरायल के बेटीमन,</para>
  <para style="q2" vid="2SA 1:24">साऊल बर रोवव,</para>
  <para style="q1" vid="2SA 1:24">जऊन ह तुमन ला सिन्दूरी अऊ सुघर ओनहा पहिराईस,</para>
  <para style="q2" vid="2SA 1:24">जऊन ह तुम्हर पहिरावा ला सोन के जेवर ले सजाईस।<verse eid="2SA 1:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="2SA 1:25" />“ओ सूरबीरमन लड़ई म कइसे गिरे पड़े हवंय!</para>
  <para style="q2" vid="2SA 1:25">तुम्हर ऊंचहा जगह म योनातन ह मरे पड़े हवय।<verse eid="2SA 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 1:26" />हे मोर भाई योनातन, मेंह तोर खातिर दुखी हवंव;</para>
  <para style="q2" vid="2SA 1:26">तेंह मोर बहुंत मयारू रहय।</para>
  <para style="q1" vid="2SA 1:26">मोर बर तोर मया ह अद्भूत रिहिस,</para>
  <para style="q2" vid="2SA 1:26">माईलोगनमन के मया ले घलो जादा अद्भूत रिहिस।<verse eid="2SA 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="2SA 1:27" />“सूरबीर सैनिकमन कइसे गिरे पड़े हवंय!</para>
  <para style="q2" vid="2SA 1:27">लड़ई के हथियारमन नास हो गे हवंय!”<verse eid="2SA 1:27" /></para>
  <chapter eid="2SA 1" />
  <chapter number="2" style="c" sid="2SA 2" />
  <para style="s1">दाऊद के यहूदा ऊपर राजा बनई</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1" />एकर बाद दाऊद ह यहोवा ले पुछताछ करिस, “का मेंह यहूदा प्रदेस के कोनो नगर म जावंव?”</para>
  <para style="p" vid="2SA 2:1">यहोवा ह ओला जबाब दीस, “हव, जा।”</para>
  <para style="p" vid="2SA 2:1">त दाऊद ह पुछिस, “कोन नगर म जावंव?”</para>
  <para style="p" vid="2SA 2:1">यहोवा ह जबाब दीस, “हेबरोन म।”<verse eid="2SA 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 2:2" />तब दाऊद ह यिजरेली अहीनोअम, अऊ करमेली नाबाल के बिधवा अबीगैल नांव के अपन दूनों घरवाली के संग उहां गीस। <verse eid="2SA 2:2" /><verse number="3" style="v" sid="2SA 2:3" />दाऊद ह अपन संग के मनखेमन ला घलो ओमन के परिवार के संग लेके गीस; अऊ ओमन हेबरोन अऊ येकर नगरमन म रहे लगिन। <verse eid="2SA 2:3" /><verse number="4" style="v" sid="2SA 2:4" />तब यहूदा के मनखेमन हेबरोन आईन, अऊ उहां ओमन यहूदा के गोत्र ऊपर राजा के रूप म दाऊद के अभिसेक करिन।</para>
  <para style="p" vid="2SA 2:4">जब दाऊद ला ये बताय गीस कि जेमन साऊल ला माटी दीन, ओमन याबेस-गिलाद के मनखे रिहिन, <verse eid="2SA 2:4" /><verse number="5" style="v" sid="2SA 2:5" />त ओह संदेसियामन ला ओमन करा ये कहे बर पठोईस, “अपन मालिक साऊल ला माटी देय के दुवारा तुमन जऊन दया देखाय हव, ओकर बर यहोवा ह तुमन ला आसीस देवय। <verse eid="2SA 2:5" /><verse number="6" style="v" sid="2SA 2:6" />यहोवा ह तुमन ले किरपा अऊ सच्चई के बरताव करय, अऊ मेंह घलो तुम्हर ऊपर अइसे किरपा करहूं, काबरकि तुमन ये काम करे हवव। <verse eid="2SA 2:6" /><verse number="7" style="v" sid="2SA 2:7" />अब तुमन मजबूत अऊ साहसी बनव, काबरकि तुम्हर मालिक साऊल ह मर गीस, अऊ यहूदा के मनखेमन अपन ऊपर राजा होय बर मोर अभिसेक करे हवंय।”<verse eid="2SA 2:7" /></para>
  <para style="s1">दाऊद के घराना अऊ साऊल के घराना के बीच लड़ई</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8" />ये दौरान, नेर के बेटा अबनेर, जऊन ह साऊल के सेनापति रिहिस, ओह साऊल के बेटा ईस-बोसेत ला लेके महनैम म आईस, <verse eid="2SA 2:8" /><verse number="9" style="v" sid="2SA 2:9" />अऊ ईस-बोसेत ला गिलाद, अस्सूरी अऊ यिजरेल, अऊ एपरैम, बिनयामीन अऊ जम्मो इसरायल ऊपर राजा बना दीस।<verse eid="2SA 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 2:10" />साऊल के बेटा ईस-बोसेत ह चालीस बछर के रिहिस, जब ओह इसरायल ऊपर राजा बनिस, अऊ ओह दू बछर तक राज करिस। पर यहूदा के गोत्र ह दाऊद बर वफादार बने रिहिस। <verse eid="2SA 2:10" /><verse number="11" style="v" sid="2SA 2:11" />हेबरोन म यहूदा के गोत्र ऊपर दाऊद ह साढ़े सात बछर तक राजा रिहिस।<verse eid="2SA 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12" />नेर के बेटा अबनेर ह साऊल के बेटा ईस-बोसेत के आदमीमन के संग महनैम ले गिबोन गीस। <verse eid="2SA 2:12" /><verse number="13" style="v" sid="2SA 2:13" />तब सरूयाह के बेटा योआब, अऊ दाऊद के आदमीमन निकलके गीन अऊ ओमन ले गिबोन के तरिया करा मिलिन। एक दल ह तरिया के एक तरफ बईठिस अऊ एक दल ह तरिया के दूसर तरफ बईठिस।<verse eid="2SA 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 2:14" />तब अबनेर ह योआब ले कहिस, “कुछू जवानमन उठके हमर आघू म एक-दूसर के संग लड़ंय।”</para>
  <para style="p" vid="2SA 2:14">योआब ह कहिस, “ठीक हे, ओमन लड़ंय।”<verse eid="2SA 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 2:15" />तब ओमन उठिन अऊ ओमन के गनती करे गीस—बिनयामीन अऊ साऊल के बेटा ईस-बोसेत के तरफ ले बारह झन, अऊ दाऊद के तरफ ले बारह झन। <verse eid="2SA 2:15" /><verse number="16" style="v" sid="2SA 2:16" />हर एक आदमी अपन बिरोधी के मुड़ ला धरिस अऊ अपन छुरा ला अपन बिरोधी के पंजरा म भोंग दीस, अऊ ओमन एक संग गिरके मर गीन। एकरसेति गिबोन म ओ जगह के नांव हेलकत-हस्सूरीम<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="fq" closed="false">हेलकत-हस्सूरीम </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">छुरामन के खेत </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बईरता के खेत</char></note> पड़िस।<verse eid="2SA 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 2:17" />ओ दिन बहुंत भयंकर लड़ई होईस, अऊ अबनेर अऊ इसरायलीमन दाऊद के जवानमन ले हार गीन।<verse eid="2SA 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 2:18" />उहां सरूयाह के तीन बेटा रिहिन: योआब, अबीसै अऊ असाहेल। असाहेल ह जंगली हिरन के सहीं तेज भागनेवाला मनखे रिहिस। <verse eid="2SA 2:18" /><verse number="19" style="v" sid="2SA 2:19" />ओह अबनेर के पीछा करन लगिस, अऊ बिगर जेवनी या डेरी कोति मुड़े, ओह अबनेर के पीछा करिस। <verse eid="2SA 2:19" /><verse number="20" style="v" sid="2SA 2:20" />अबनेर ह पाछू कोति मुड़के पुछिस, “का तेंह असाहेल अस?”</para>
  <para style="p" vid="2SA 2:20">ओह जबाब दीस, “हव, में अंव।”<verse eid="2SA 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 2:21" />त अबनेर ह ओकर ले कहिस, “अपन जेवनी या डेरी कोति मुड़ अऊ कोनो जवान ला पकड़के ओकर हथियारमन ला छीन ले।” पर असाहेल ह ओकर पीछा करई नइं छोंड़िस।<verse eid="2SA 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 2:22" />अबनेर ह फेर असाहेल ला चेतउनी दीस, “मोर पीछा करई छोंड़ दे! मेंह तोला काबर मार डारंव? अइसन करके मेंह तोर भाई योआब ला अपन मुहूं कइसे देखाहूं?”<verse eid="2SA 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 2:23" />पर असाहेल ह ओकर पीछा करई नइं छोंड़िस; तब अबनेर ह अपन बरछी के कुन्दा ला ओकर पेट म अइसे भोंग दीस कि बरछी ह ओकर आर-पार होके ओकर पीठ कोति निकल आईस। अऊ ओह गिरके उहेंच मर गीस। हर ओ मनखे जऊन ह ओ जगह म आईस, जिहां असाहेल ह गिरके मर गे रिहिस, उहां आके ओमन रूक गीन।<verse eid="2SA 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24" />पर योआब अऊ अबीसै अबनेर के पीछा करिन, अऊ जब बेर ह बुड़त रिहिस, त ओमन अम्मा नांव के ओ पहाड़ी करा हबरिन, जऊन ह गिबोन के उजाड़ जगह के रसता म गीह के लकठा म हवय। <verse eid="2SA 2:24" /><verse number="25" style="v" sid="2SA 2:25" />तब बिनयामीन के आदमीमन एक जुट होके अबनेर के पाछू हो लीन। ओमन अपन एक दल बनाके पहाड़ी के टीप म ठाढ़ हो गीन।<verse eid="2SA 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 2:26" />तब अबनेर ह योआब ला पुकारके कहिस, “का जरूरी अय कि तलवार ह सदा मारत रहय? का तें नइं जानस कि एकर अन्त दुखदाई होही? तेंह कब अपन आदमीमन ला हुकूम देबे कि ओमन अपन संगी इसरायलीमन के पीछा करई छोंड़ दें?”<verse eid="2SA 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 2:27" />योआब ह जबाब दीस, “परमेसर के जिनगी के सपथ, यदि तेंह नइं बोले होते, त मोर आदमीमन बिहान होवत तक ओमन के पीछा करे रहितिन।”<verse eid="2SA 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 2:28" />तब योआब ह तुरही फूंकिस, अऊ पूरा सैनिक दल ह रूक गीस; ओमन फेर इसरायलीमन के पीछा नइं करिन, अऊ न ही ओमन फेर लड़ई करिन।<verse eid="2SA 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 2:29" />ओ पूरा रथिया अबनेर अऊ ओकर आदमीमन अराबा म ले होके गीन। ओमन यरदन नदी ला पार करिन, अऊ बिहनियां के बेरा आघू बढ़त ओमन महनैम करा हबरिन।<verse eid="2SA 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30" />तब योआब ह अबनेर के पीछा करई छोंड़ दीस अऊ पूरा सेना ला इकट्ठा करिस। ओह देखिस कि असाहेल के अलावा, दाऊद के अऊ उन्नीस आदमी उहां नइं रिहिन। <verse eid="2SA 2:30" /><verse number="31" style="v" sid="2SA 2:31" />पर दाऊद के आदमीमन तीन सौ साठ ओ बिनयामीनीमन ला मार डारे रिहिन, जेमन अबनेर के संग रिहिन। <verse eid="2SA 2:31" /><verse number="32" style="v" sid="2SA 2:32" />योआब अऊ ओकर दल के मन असाहेल के लास ला लीन अऊ ओला बैतलहम म ओकर ददा के कबर म माटी दीन। तब ओमन अऊ ओकर आदमीमन रात भर आघू बढ़ते रिहिन अऊ बड़े बिहनियां हेबरोन म हबरिन।<verse eid="2SA 2:32" /></para>
  <chapter eid="2SA 2" />
  <chapter number="3" style="c" sid="2SA 3" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 3:1" />साऊल के घराना अऊ दाऊद के घराना के बीच बहुंत समय तक लड़ई चलते रिहिस। पर दाऊद ह अऊ मजबूत होवत गीस अऊ साऊल के घराना ह कमजोर होवत गीस।<verse eid="2SA 3:1" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="2" style="v" sid="2SA 3:2" />हेबरोन नगर म दाऊद के जऊन बेटामन जनमिन, ओमन ये रिहिन:</para>
  <para style="b" vid="2SA 3:2" />
  <para style="li1" vid="2SA 3:2">ओकर बड़े बेटा अमनोन रिहिस, जऊन ह यिजरेल के अहीनोअम ले जनमे रिहिस;<verse eid="2SA 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="2SA 3:3" />अऊ ओकर दूसर बेटा किलाब रिहिस, जऊन ह करमेल के नाबाल के बिधवा अबीगैल ले जनमे रिहिस;</para>
  <para style="li1" vid="2SA 3:3">तीसर, अबसालोम रिहिस, जऊन ह गसूर के राजा तलमै के बेटी माका ले जनमे रिहिस;<verse eid="2SA 3:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="2SA 3:4" />चौथा, अदोनियाह रिहिस, जऊन ह हगीत ले जनमे रिहिस;</para>
  <para style="li1" vid="2SA 3:4">पांचवां सपतयाह रिहिस, जेकर दाई अबीतल रिहिस;<verse eid="2SA 3:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="2SA 3:5" />अऊ छठवां यितराम, जऊन ह एगला नांव दाऊद के घरवाली ले जनमे रिहिस।</para>
  <para style="b" vid="2SA 3:5" />
  <para style="lf" vid="2SA 3:5">हेबरोन म दाऊद ले येहीच लइकामन होईन।<verse eid="2SA 3:5" /></para>
  <para style="s1">अबनेर ह दाऊद करा जाथे</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6" />जब साऊल अऊ दाऊद दूनों के घराना के बीच लड़ई होवत रिहिस, तब अबनेर ह साऊल के घराना म अपन खुद के स्थिति ला मजबूत करत गीस। <verse eid="2SA 3:6" /><verse number="7" style="v" sid="2SA 3:7" />साऊल के एक झन रखैल रिहिस, जेकर नांव रिस्पा रिहिस; ओह अय्या के बेटी रिहिस। ईस-बोसेत ह अबनेर ऊपर दोस लगाईस, “तेंह मोर ददा के रखैल संग काबर सुतय?”<verse eid="2SA 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 3:8" />ईस-बोसेत ह जऊन बात कहिस, ओकर कारन अबनेर ह बहुंत गुस्सा होईस अऊ कहिस, “का मेंह यहूदा के कुकुर के मुड़ अंव? आज तक मेंह तोर ददा साऊल के घराना अऊ ओकर परिवार अऊ संगवारीमन के पूरा मन से काम करे हंव। मेंह तोला दाऊद के हांथ म पड़न नइं दे हंव। तभो ले तेंह अब मोर ऊपर ये माईलोगन के बिसय म दोस लगावत हस! <verse eid="2SA 3:8" /><verse number="9" style="v" sid="2SA 3:9" />यहोवा ह सपथ खाके दाऊद ले जऊन वायदा करे हवय, यदि मेंह ओकर मुताबिक दाऊद के मदद नइं करंव, त परमेसर ह अबनेर ले लेखा लेवय अऊ बहुंत कड़ई से लेखा लेवय <verse eid="2SA 3:9" /><verse number="10" style="v" sid="2SA 3:10" />याने कि मेंह राज ला साऊल के घराना ले छीन लूहूं अऊ दाऊद के सिंघासन ला दान ले लेके बेरसेबा तक इसरायल अऊ यहूदा के ऊपर इस्थिर करहूं।” <verse eid="2SA 3:10" /><verse number="11" style="v" sid="2SA 3:11" />ईस-बोसेत ह अबनेर ला अऊ कुछू कहे के हिम्मत नइं करिस, काबरकि ओह अबनेर ले डरत रिहिस।<verse eid="2SA 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12" />तब अबनेर ह अपन कोति ले ये कहे बर संदेसियामन ला दाऊद करा पठोईस, “ये देस काकर अय? मोर संग एक समझौता कर, अऊ मेंह जम्मो इसरायल ला तोर अधीन करे म तोर मदद करहूं।”<verse eid="2SA 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 3:13" />दाऊद ह कहिस, “ठीक हे, मेंह तोर संग एक समझौता करहूं। पर एक बात मेंह तोर ले चाहथंव: तेंह मोर सामने नइं आबे, जब तक कि तेंह साऊल के बेटी मीकल ला लेके नइं आबे, जब तेंह मोर ले भेंट करे बर आबे।” <verse eid="2SA 3:13" /><verse number="14" style="v" sid="2SA 3:14" />तब दाऊद ह ये मांग के संग संदेसियामन ला साऊल के बेटा ईस-बोसेत करा पठोईस, “मोला मोर घरवाली मीकल ला दे, जेकर संग मोर रिस्ता तय करे बर एक सौ पलिस्तीमन के खलड़ी ला दाम के रूप म चुकाय रहेंव।”<verse eid="2SA 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 3:15" />तब ईस-बोसेत ह मनखेमन ला हुकूम देके मीकल ला ओकर घरवाला पलतीएल ले अलग कर दीस, जऊन ह लैस के बेटा रिहिस। <verse eid="2SA 3:15" /><verse number="16" style="v" sid="2SA 3:16" />तभो ले, ओकर घरवाला ह रोवत ओकर पाछू-पाछू बहूरीम तक गीस। तब अबनेर ह ओला कहिस, “अपन घर लहुंट जा।” त ओह लहुंट गीस।<verse eid="2SA 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 3:17" />फेर अबनेर ह इसरायल के अगुवामन संग सलाह-मसविरा करिस अऊ कहिस, “कुछू समय ले तुमन चाहत रहेव कि दाऊद ह तुम्हर राजा होवय। <verse eid="2SA 3:17" /><verse number="18" style="v" sid="2SA 3:18" />अब वइसनेच करव! काबरकि यहोवा ह दाऊद ले वायदा करे हवय, ‘अपन सेवक दाऊद के दुवारा मेंह अपन मनखे इसरायल ला पलिस्तीमन के हांथ ले अऊ ओमन के जम्मो बईरीमन के हांथ ले छोंड़ाहूं।’ ”<verse eid="2SA 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 3:19" />अबनेर ह बिनयामीनी मनखेमन ले घलो गोठियाईस। तब ओह हेबरोन म दाऊद ला ओ जम्मो बात बताय बर चल दीस, जेला इसरायल अऊ बिनयामीन के पूरा गोत्र के मनखेमन करे चाहत रिहिन। <verse eid="2SA 3:19" /><verse number="20" style="v" sid="2SA 3:20" />तब अबनेर ह अपन बीस जवानमन के संग हेबरोन म दाऊद करा आईस, त दाऊद ह ओकर अऊ ओकर मनखेमन बर एक जेवनार करिस। <verse eid="2SA 3:20" /><verse number="21" style="v" sid="2SA 3:21" />तब अबनेर ह दाऊद ला कहिस, “मोला तुरते जाके मोर मालिक, राजा बर जम्मो इसरायलीमन ला इकट्ठा करन दे, ताकि ओमन तोर संग एक करार करंय, अऊ ये कि तें अपन मन मुताबिक जम्मो के ऊपर राज कर सकस।” तब दाऊद ह अबनेर ला बिदा करिस, अऊ ओह सांत मन से चले गीस।<verse eid="2SA 3:21" /></para>
  <para style="s1">योआब ह अबनेर के हतिया कर देथे</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22" />तब ओही बेरा, दाऊद के जवानमन अऊ योआब बईरीमन के कोनो जगह म हमला करके लहुंटिन अऊ अपन संग बहुंत अकन लूट के सामान लेके आईन। पर ओ समय अबनेर ह दाऊद के संग हेबरोन म नइं रिहिस, काबरकि दाऊद ह ओला बिदा कर देय रिहिस, अऊ ओह सांत मन से चल दे रिहिस। <verse eid="2SA 3:22" /><verse number="23" style="v" sid="2SA 3:23" />जब योआब अऊ ओकर संग के जम्मो सैनिकमन आईन, त योआब ला बताय गीस कि नेर के बेटा अबनेर ह राजा करा आय रिहिस अऊ राजा ह ओला बिदा कर दीस अऊ ओह सांत मन से चल दीस।<verse eid="2SA 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 3:24" />तब योआब ह राजा करा जाके कहिस, “तेंह ये का करे हस? देख, अबनेर ह तोर करा आय रिहिस, त तेंह ओला काबर जावन देय? अब ओह चले गे हवय! <verse eid="2SA 3:24" /><verse number="25" style="v" sid="2SA 3:25" />तेंह नेर के बेटा अबनेर ला जानत हस; ओह तोला धोखा देय बर, अऊ तोर अवई-जवई अऊ तोर जम्मो काम के भेद लेय बर आय रिहिस।”<verse eid="2SA 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26" />तब योआब ह दाऊद करा ले चल दीस अऊ अबनेर के पाछू संदेसियामन ला पठोईस, अऊ ओमन ओला सीरा नांव के कुन्ड ले लहुंटाके ले आईन। पर दाऊद ला ये बात के पता नइं रिहिस। <verse eid="2SA 3:26" /><verse number="27" style="v" sid="2SA 3:27" />जब अबनेर ह हेबरोन म लहुंट आईस, त योआब ह ओला अलग एक भीतर के कमरा म ले गीस; ओह अइसे देखाईस मानो ओह ओकर ले गुपत म कुछू बात करे चाहत हे। अऊ उहां अपन भाई असाहेल के खून के बदला लेय बर, योआब ह ओकर पेट म छुरा ला अइसन भोंगिस कि ओह मर गीस।<verse eid="2SA 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 3:28" />बाद म, जब दाऊद ये बात ला सुनिस, त ओह घोसना करिस, “नेर के बेटा अबनेर के खून के बारे म, में अऊ मोर राज ह यहोवा के नजर म हमेसा निरदोस रहिबो। <verse eid="2SA 3:28" /><verse number="29" style="v" sid="2SA 3:29" />ओकर खून के दोस ह योआब अऊ ओकर पूरा परिवार ऊपर लगय! योआब के परिवार म हमेसा कोनो न कोनो मनखे ला बहत घाव या कोढ़ के बेमारी होवय या ओह लउठी के मदद ले चलय या तलवार ले मारे जावय या भूखन मरइया होवय।”<verse eid="2SA 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 3:30" />(योआब अऊ ओकर भाई अबीसै मिलके अबनेर के हतिया कर दीन, काबरकि ओह ओमन के भाई असाहेल ला गिबोन म लड़ई के बेरा मार डारे रिहिस।)<verse eid="2SA 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31" />तब दाऊद ह योआब अऊ अपन संग के जम्मो मनखेमन ला कहिस, “अपन-अपन ओनहा ला सोक म चीरव अऊ बोरा के ओनहा पहिरव अऊ अबनेर के आघू-आघू सोक मनात चलव।” दाऊद राजा खुद अरथी के पाछू-पाछू चलिस। <verse eid="2SA 3:31" /><verse number="32" style="v" sid="2SA 3:32" />ओमन अबनेर ला हेबरोन म माटी दीन, अऊ राजा ह अबनेर के कबर म जोर-जोर से रोईस, अऊ जम्मो मनखेमन घलो रोईन।<verse eid="2SA 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 3:33" />तब राजा ह अबनेर बर ये बिलापगीत गाईस:</para>
  <para style="q1" vid="2SA 3:33">“का उचित रिहिस कि अबनेर ह अइसने मरय, जइसने कोनो मुरूख ह मरथे?<verse eid="2SA 3:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="2SA 3:34" />न तो तोर हांथमन ला बांधे गीस,</para>
  <para style="q2" vid="2SA 3:34">न ही तोर गोड़मन म बेड़ी डारे गीस।</para>
  <para style="q1" vid="2SA 3:34">तेंह अइसे मरय, जइसे कोनो, दुस्ट मनखे के आघू म मरथे।”</para>
  <para style="p" vid="2SA 3:34">अऊ जम्मो मनखेमन ओकर बर फेर रोईन।<verse eid="2SA 3:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 3:35" />तब जम्मो मनखेमन आईन अऊ दाऊद ले बिनती करिन कि ओह दिन के रहत कुछू खा ले; पर दाऊद ह ये कहिके सपथ लीस, “यदि बेर बुड़े के पहिले मेंह रोटी या कुछू आने चीज ला खावंव, त परमेसर ह मोर ले अइसनेच, बरन एकर ले घलो जादा कठोर बरताव करय!”<verse eid="2SA 3:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 3:36" />जम्मो मनखेमन ये बात ऊपर धियान दीन अऊ खुस होईन; वास्तव म, ओ जम्मो चीज ले ओमन खुस रिहिन, जेला राजा ह करिस। <verse eid="2SA 3:36" /><verse number="37" style="v" sid="2SA 3:37" />तब ओ दिन, उहां ओ जम्मो मनखे अऊ जम्मो इसरायलीमन जान डारिन कि नेर के बेटा अबनेर के हतिया करे म राजा के कोनो हांथ नइं रिहिस।<verse eid="2SA 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 3:38" />तब राजा ह अपन अधिकारीमन ले कहिस, “का तुमन ये बात ला नइं समझत हव कि इसरायल म, आज एक सेनापति अऊ एक बड़े मनखे ह खतम हो गीस? <verse eid="2SA 3:38" /><verse number="39" style="v" sid="2SA 3:39" />अऊ आज, हालाकि मेंह अभिसिक्त राजा अंव, तभो ले मेंह कमजोर हंव, अऊ सरूयाह के ये बेटामन मोर ले जादा ताकतवर हो गे हवंय। यहोवा ह दुस्ट काम करइया ला ओकर दुस्ट काम के मुताबिक बदला देवय।”<verse eid="2SA 3:39" /></para>
  <chapter eid="2SA 3" />
  <chapter number="4" style="c" sid="2SA 4" />
  <para style="s1">ईस-बोसेत के हतिया</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1" />जब साऊल के बेटा, ईस-बोसेत ह सुनिस कि अबनेर ह हेबरोन म मारे गीस, तब ओह हिम्मत हार गीस, अऊ जम्मो इसरायलीमन घबरा गीन। <verse eid="2SA 4:1" /><verse number="2" style="v" sid="2SA 4:2" />साऊल के बेटा के दू झन आदमी रिहिन, जेमन छापामार दलमन के अगुवा रिहिन। एक के नांव बाना अऊ दूसर के नांव रेकाब रिहिस; येमन बिनयामीन के गोत्र के बेरोतवासी रिम्मोन के बेटा रिहिन—बेरोत ला बिनयामीन के भाग समझे जाथे, <verse eid="2SA 4:2" /><verse number="3" style="v" sid="2SA 4:3" />काबरकि बेरोत के मनखेमन गित्तैम नगर ला भाग गे रिहिन अऊ ओमन उहां आज तक परदेसी के रूप म रहिथें।<verse eid="2SA 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4" />(साऊल के बेटा योनातन के एक झन बेटा रिहिस, जऊन ह दूनों गोड़ ले खोरवा रिहिस। जब यिजरेल ले साऊल अऊ योनातन के बारे म समाचार आईस, तब ओह पांच बछर के रिहिस। ओ बेरा म, ओकर धाई ह ओला उठाके भागिस, अऊ जब ओह भागे बर जल्दी करत रिहिस, त लइका ह गिरके खोरवा हो गीस। ओकर नांव मपीबोसेत रिहिस।)<verse eid="2SA 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 4:5" />बेरोती रिम्मोन के बेटा रेकाब अऊ बाना, ईस-बोसेत के घर जाय बर निकलिन, अऊ ओमन उहां दिन म घाम के बेरा हबरिन, जब ईस-बोसेत ह मंझनियां अराम करत रिहिस। <verse eid="2SA 4:5" /><verse number="6" style="v" sid="2SA 4:6" />ओमन घर के भीतरी भाग म अइसे गीन, मानो ओमन कुछू गहूं ले जाय बर आय हवंय, अऊ उहां ओमन ईस-बोसेत के पेट म छुरा भोंग दीन। तब रेकाब अऊ ओकर भाई बाना चुपेचाप भाग निकलिन।<verse eid="2SA 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 4:7" />ओमन घर म तब घुसे रिहिन, जब ईस-बोसेत ह अपन सोये के कमरा म बिस्तर म लेटे रिहिस। ओमन ओला छुरा घोंपके मार डारिन अऊ ओकर मुड़ ला काट लीन, अऊ ओकर मुड़ ला लेके, ओमन रात भर अराबा के रसता म चलिन। <verse eid="2SA 4:7" /><verse number="8" style="v" sid="2SA 4:8" />ओमन ईस-बोसेत के मुड़ ला हेबरोन म दाऊद करा लानिन अऊ राजा ला कहिन, “तोर ओ बईरी साऊल, जऊन ह तोला मार डारे के कोसिस करत रिहिस, ये देख, हमन ओकर बेटा ईस-बोसेत के मुड़ ला ले आय हन। आज यहोवा ह साऊल अऊ ओकर बंस ले हमर मालिक, राजा के पलटा लेय ले हवय।”<verse eid="2SA 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9" />दाऊद ह बेरोती रिम्मोन के बेटा रेकाब अऊ ओकर भाई बाना ला ये जबाब दीस, “यहोवा के जिनगी के सपथ, जऊन ह मोला हर समस्या ले निकाले हवय, <verse eid="2SA 4:9" /><verse number="10" style="v" sid="2SA 4:10" />जब कोनो मनखे ह मोला बताईस, ‘साऊल ह मर गे हे,’ अऊ ओह सोचिस कि ओह सुघर संदेस लेके आय हवय, पर मेंह ओला पकड़के सिकलग म मरवा देंव। ओह ओकर ईनाम रिहिस, जेला मेंह ओकर ओ संदेस बर देंव! <verse eid="2SA 4:10" /><verse number="11" style="v" sid="2SA 4:11" />त फेर येकर ले जादा ईनाम काबर नइं मिलही—जब दुस्ट मनखेमन एक निरदोस मनखे ला ओकरेच घर म अऊ ओकर बिस्तर म मार डारे हवंय—त येह जरूरी अय कि मेंह ओकर खून के बदला तुमन ले लंव अऊ तुमन ला ये धरती ले मिटा दंव!”<verse eid="2SA 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 4:12" />तब दाऊद ह अपन आदमीमन ला हुकूम दीस, अऊ ओमन ओ दूनों झन ला मार डारिन अऊ ओमन के हांथ अऊ गोड़मन ला काटके ओमन के लास ला हेबरोन के तरिया के तीर म टांग दीन। पर ओमन ईस-बोसेत के मुड़ ला लेके हेबरोन म अबनेर के कबर म गाड़ दीन।<verse eid="2SA 4:12" /></para>
  <chapter eid="2SA 4" />
  <chapter number="5" style="c" sid="2SA 5" />
  <para style="s1">दाऊद के इसरायल ऊपर राजा बनई</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1" />इसरायल के जम्मो गोत्र के मनखेमन हेबरोन म दाऊद मेर आके कहिन, “सुन, हमन तोर खुद के मांस अऊ लहू अन। <verse eid="2SA 5:1" /><verse number="2" style="v" sid="2SA 5:2" />पहिले जब साऊल ह हमर राजा रिहिस, तब तेंहीच ह सैनिक अभियान म इसरायल के अगुवई करत रहय। अऊ यहोवा ह तोला कहे रिहिस, ‘तेंह मोर मनखे इसरायल के चरवाहा होबे, अऊ तेंह ओमन ऊपर सासन करबे।’ ”<verse eid="2SA 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 5:3" />जब इसरायल के जम्मो अगुवामन हेबरोन म राजा दाऊद मेर आय रिहिन, त दाऊद राजा ह ओमन के संग म हेबरोन म यहोवा के आघू म एक करार करिस, अऊ ओमन इसरायल के राजा होय बर दाऊद के अभिसेक करिन।<verse eid="2SA 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 5:4" />दाऊद ह तीस बछर के रिहिस, जब ओह राजा बनिस, अऊ चालीस बछर तक राज करिस। <verse eid="2SA 5:4" /><verse number="5" style="v" sid="2SA 5:5" />हेबरोन म यहूदा ऊपर, ओह साढ़े सात बछर तक राज करिस, अऊ यरूसलेम म जम्मो इसरायल अऊ यहूदा ऊपर, ओह तैंतीस बछर तक राज करिस।<verse eid="2SA 5:5" /></para>
  <para style="s1">दाऊद ह यरूसलेम ऊपर जय पाथे</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6" />राजा अऊ ओकर आदमीमन यरूसलेम जाके यबूसीमन ऊपर हमला करिन, जऊन मन उहां रहत रिहिन। यबूसीमन दाऊद ला कहिन, “तेंह इहां घुस नइं सकस; अऊ त अऊ अंधरा अऊ खोरवामन तोला रोक लीहीं।” ओमन सोचत रिहिन, “दाऊद ह इहां घुस नइं सकय।” <verse eid="2SA 5:6" /><verse number="7" style="v" sid="2SA 5:7" />तभो ले दाऊद ह सियोन के गढ़ ऊपर कब्जा कर लीस—जऊन ह दाऊद के नगर अय।<verse eid="2SA 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 5:8" />ओ दिन दाऊद ह कहे रिहिस, “जऊन कोनो यबूसीमन ऊपर जय पाय चाहथे, ओला ओ अंधरा अऊ खोरवामन करा हबरे बर पानी के लम्बा सुरंग के उपयोग करना पड़ही, जेमन दाऊद के बईरी अंय।” एकर कारन ओमन कहिथें, “अंधरा अऊ खोरवामन महल भीतर नइं आ सकंय।”<verse eid="2SA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 5:9" />तब दाऊद ह ओ किला म रहे लगिस, अऊ ओकर नांव दाऊद के नगर रखिस। ओह चारों कोति मिल्लो ले लेके भीतर कोति नगर ला बनवाईस। <verse eid="2SA 5:9" /><verse number="10" style="v" sid="2SA 5:10" />अऊ ओह अऊ जादा सक्तिसाली होवत गीस, काबरकि सर्वसक्तिमान यहोवा परमेसर ह ओकर संग रिहिस।<verse eid="2SA 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 5:11" />तब सूर के राजा हीराम ह दाऊद करा दूतमन ला पठोईस, अऊ संग म देवदार के लकड़ी, बढ़ई अऊ राज-मिसतिरीमन ला पठोईस, अऊ ओमन दाऊद बर एक महल बनाईन। <verse eid="2SA 5:11" /><verse number="12" style="v" sid="2SA 5:12" />तब दाऊद ला निस्चय हो गीस कि यहोवा ह ओला इसरायल ऊपर राजा के रूप म इस्थिर करे हवय अऊ अपन मनखे इसरायलीमन के हित म ओकर राज ला उठाय हवय।<verse eid="2SA 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13" />हेबरोन नगर ला छोंड़े के बाद, दाऊद ह यरूसलेम म अऊ रखैल अऊ घरवाली बना लीस, अऊ ओकर ले अऊ बेटा अऊ बेटीमन पईदा होईन। <verse eid="2SA 5:13" /><verse number="14" style="v" sid="2SA 5:14" />येमन ओ लइकामन के नांव अंय, जेमन उहां ओकर ले जनमिन: सम्मू, सोबाब, नातान, सुलेमान, <verse eid="2SA 5:14" /><verse number="15" style="v" sid="2SA 5:15" />यिभार, एलीसू, नेपेग, यापी, <verse eid="2SA 5:15" /><verse number="16" style="v" sid="2SA 5:16" />एलीसामा, एलयादा अऊ एलीपेलेत।<verse eid="2SA 5:16" /></para>
  <para style="s1">दाऊद ह पलिस्तीमन ला हराथे</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17" />जब पलिस्तीमन ये सुनिन कि इसरायल के ऊपर राजा के रूप म दाऊद के अभिसेक करे गे हवय, त ओमन पूरा सेना लेके दाऊद के खोज म निकलिन, पर दाऊद ह येकर बारे म सुनिस अऊ खाल्हे कोति गढ़ म चल दीस। <verse eid="2SA 5:17" /><verse number="18" style="v" sid="2SA 5:18" />तब पलिस्तीमन आके रपाईम के घाटी म बगर गीन। <verse eid="2SA 5:18" /><verse number="19" style="v" sid="2SA 5:19" />तब दाऊद ह परमेसर ले पुछताछ करिस, “का मेंह जाके पलिस्तीमन ऊपर हमला करंव? का तेंह ओमन ला मोर हांथ म कर देबे?”</para>
  <para style="p" vid="2SA 5:19">यहोवा ह दाऊद ला जबाब दीस, “जा, खचित मेंह पलिस्तीमन ला तोर हांथ म कर दूहूं।”<verse eid="2SA 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 5:20" />तब दाऊद ह बाल-परासीम ला गीस, अऊ उहां ओह ओमन ला हरा दीस। ओह कहिस, “यहोवा ह मोर आघू म मोर बईरीमन ला अइसे फोर दे हवय, जइसे पानी के धारा ह फूट निकलथे।” ये खातिर ओ जगह ला बाल-परासीम<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="fq" closed="false">बाल-परासीम </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">परभू, जऊन ह फोर देथे</char></note> कहे गीस। <verse eid="2SA 5:20" /><verse number="21" style="v" sid="2SA 5:21" />पलिस्तीमन उहां अपन मूरतीमन ला छोंड़ दीन, अऊ दाऊद अऊ ओकर आदमीमन ओमन ला उठाके ले गीन।<verse eid="2SA 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 5:22" />एक बार फेर पलिस्तीमन आईन अऊ रपाईम घाटी म बगर गीन; <verse eid="2SA 5:22" /><verse number="23" style="v" sid="2SA 5:23" />तब दाऊद ह यहोवा ले पुछताछ करिस, अऊ परमेसर ह जबाब दीस, “ओमन कोति सीधा झन जा, पर ओमन के पाछू कोति घेरा बनाके चिनार रूखमन के आघू म ओमन ऊपर हमला कर। <verse eid="2SA 5:23" /><verse number="24" style="v" sid="2SA 5:24" />जतेक जल्दी तेंह चिनार रूखमन के पान ऊपर म सेना के चले के खरखराहट ला सुनबे, त जल्दी करबे, काबरकि ओकर ये मतलब होही कि यहोवा ह पलिस्ती सेना ला मारे बर तोर आघू गे हवय।” <verse eid="2SA 5:24" /><verse number="25" style="v" sid="2SA 5:25" />दाऊद ह वइसे ही करिस, जइसे यहोवा ह ओला हुकूम देय रिहिस, अऊ ओह गिबोन सहर<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="ft" closed="false">सेटाजिन्ट (देखव <char style="xt"><ref loc="1CH 14:16">1 इति 14:16</ref></char>); इबरानी म </char><char style="fqa" closed="false">गेबा</char></note> ले लेके गेजेर नगर तक पलिस्तीमन ला मार गिराईस।<verse eid="2SA 5:25" /></para>
  <chapter eid="2SA 5" />
  <chapter number="6" style="c" sid="2SA 6" />
  <para style="s1">करार के सन्दूक ला यरूसलेम लाय जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1" />दाऊद ह फेर इसरायल के जम्मो योग्य जवानमन ला इकट्ठा करिस, जेमन के संखिया तीस हजार रिहिस। <verse eid="2SA 6:1" /><verse number="2" style="v" sid="2SA 6:2" />ओ अऊ ओकर आदमीमन यहूदा के बालाह<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">बालाह </char><char style="ft" closed="false">याने कि </char><char style="fqa" closed="false">किरयत-यारीम </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="1CH 13:6">1 इति 13:6</ref></char></char></note> नांव के जगह म गीन ताकि उहां ले ओमन परमेसर के ओ सन्दूक ला ले आवंय, जेला नांव ले पुकारे जाथे, याने कि सर्वसक्तिमान यहोवा के नांव ले पुकारे जाथे, जऊन ह सन्दूक ऊपर करूबमन के बीच म बिराजे हवय। <verse eid="2SA 6:2" /><verse number="3" style="v" sid="2SA 6:3" />तब ओमन पहाड़ी म रहइया अबीनादाब के घर ले परमेसर के सन्दूक ला निकालके एक नवां गाड़ी म रखिन। अऊ अबीनादाब के उज्जा अऊ अहियो नांव के दू झन बेटामन ओ गाड़ी ला हांकत रिहिन, <verse eid="2SA 6:3" /><verse number="4" style="v" sid="2SA 6:4" />जेमा परमेसर के सन्दूक रखाय रिहिस, अऊ अहियो ह सन्दूक के आघू-आघू चलत रिहिस। <verse eid="2SA 6:4" /><verse number="5" style="v" sid="2SA 6:5" />दाऊद अऊ जम्मो इसरायलीमन यहोवा के आघू म जम्मो किसम के बाजा, बीना, सारंगी, डफ, डमरू अऊ झांझ बजाके उत्सव मनात रिहिन।<verse eid="2SA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6" />जब ओमन नाकोन के कोठार मेर आईन, तब उज्जा ह अपन हांथ ला बढ़ाके परमेसर के सन्दूक ला थाम लीस, काबरकि बईलामन लड़खड़ा गे रिहिन। <verse eid="2SA 6:6" /><verse number="7" style="v" sid="2SA 6:7" />तब यहोवा के कोरोध उज्जा के ऊपर भड़किस, काबरकि ओह अनादर के काम करे रिहिस; एकरसेति परमेसर ह ओला अइसन मारिस कि ओह उहां परमेसर के सन्दूक के बाजू म मर गीस।<verse eid="2SA 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 6:8" />तब दाऊद ह गुस्सा होईस, काबरकि यहोवा के कोप ह उज्जा ऊपर भड़के रिहिस, अऊ आज तक ओ जगह ला पेरेस-उज्जा<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="fq" closed="false">पेरेस-उज्जा </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">उज्जा ऊपर कोप भड़कई</char></note> कहे जाथे।<verse eid="2SA 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 6:9" />ओ दिन दाऊद ह यहोवा ले डर गीस अऊ कहिस, “यहोवा के सन्दूक ह मोर इहां कभू कइसे आ सकत हे?” <verse eid="2SA 6:9" /><verse number="10" style="v" sid="2SA 6:10" />दाऊद ह यहोवा के सन्दूक ला अपन संग दाऊद के नगर म ले जाय बर नइं चाहत रिहिस। पर ओह येला गत के रहइया ओबेद-एदोम के घर ले गीस। <verse eid="2SA 6:10" /><verse number="11" style="v" sid="2SA 6:11" />यहोवा के सन्दूक ह गत के रहइया ओबेद-एदोम के घर म तीन महिना तक रिहिस, अऊ यहोवा ह ओबेद-एदोम अऊ ओकर जम्मो घराना ला आसीस दीस।<verse eid="2SA 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 6:12" />तब दाऊद राजा ला ये बताय गीस, “परमेसर के सन्दूक के कारन यहोवा ह ओबेद-एदोम के घराना अऊ ओकर हर चीज ला आसीस देय हवय।” तब दाऊद ह परमेसर के सन्दूक ला ओबेद-एदोम के घर ले दाऊद के नगर म लाने बर आनंद मनात गीस। <verse eid="2SA 6:12" /><verse number="13" style="v" sid="2SA 6:13" />जब यहोवा के सन्दूक ला उठानेवालामन छै कदम बढ़ाय रिहिन, तब दाऊद ह एक ठन बईला अऊ एक ठन मोटा-ताजा बछरू ला बलि चघाईस। <verse eid="2SA 6:13" /><verse number="14" style="v" sid="2SA 6:14" />मलमल के एक ठन एपोद पहिरे, दाऊद ह पूरा मन से यहोवा के आघू म नाचत रिहिस, <verse eid="2SA 6:14" /><verse number="15" style="v" sid="2SA 6:15" />जब ओ अऊ जम्मो इसरायलीमन जोर-सोर से अऊ तुरही फूंकत यहोवा के सन्दूक ला लावत रिहिन।<verse eid="2SA 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 6:16" />जब यहोवा के सन्दूक दाऊद के नगर म प्रवेस करत रिहिस, त साऊल के बेटी मीकल ह खिड़की ले झांकके देखिस। जब ओह दाऊद राजा ला यहोवा के आघू म नाचत-कूदत देखिस, त ओह अपन मन म ओला तुछ समझिस।<verse eid="2SA 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 6:17" />मनखेमन यहोवा के सन्दूक ला लानके ओ तम्बू के भीतर ओकर जगह म रख दीन, जेला दाऊद ह ओकर बर बनाय रिहिस, अऊ दाऊद ह यहोवा के आघू म होम-बलिदान अऊ मेल-बलिदान चघाईस। <verse eid="2SA 6:17" /><verse number="18" style="v" sid="2SA 6:18" />होम-बलिदान अऊ मेल-बलिदान चघाय के बाद, ओह मनखेमन ला सर्वसक्तिमान यहोवा के नांव म आसीस दीस। <verse eid="2SA 6:18" /><verse number="19" style="v" sid="2SA 6:19" />तब ओह इसरायलीमन के जम्मो भीड़ के हर एक मनखे, आदमी अऊ माईलोगन दूनों ला एक-एक ठन रोटी, एक-एक ठन खजूर के टिकिया अऊ एक-एक ठन किसमिस के टिकिया दीस। ओकर बाद जम्मो मनखेमन अपन-अपन घर चल दीन।<verse eid="2SA 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 6:20" />जब दाऊद ह अपन घराना ला आसीस देय बर घर लहुंटिस, त साऊल के बेटी मीकल ह ओकर ले मिले बर बाहिर निकलिस अऊ ओला कहिस, “आज इसरायल के राजा ह कइसे अपनआप ला अलग देखाईस! ओह अपन सेवकमन के दासीमन के देखत म आधा नंगरा हो गे रिहिस, जइसने कोनो गंवार मनखे ह करथे!”<verse eid="2SA 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 6:21" />दाऊद ह मीकल ला कहिस, “येह यहोवा के आघू म होईस, जऊन ह तोर ददा या ओकर घर के कोनो मनखे के बदले मोला चुनिस, जब ओह मोला यहोवा के मनखे इसरायलीमन ऊपर सासन करइया ठहिराईस—मेंह यहोवा के आघू म उत्सव मनाहूं। <verse eid="2SA 6:21" /><verse number="22" style="v" sid="2SA 6:22" />अऊ मेंह एकर ले घलो जादा तुछ बनहूं, अऊ मेंह अपन ही नजर म अपमानित होहूं। पर जऊन दासीमन के तेंह चरचा करय, ओमन के दुवारा मोला आदर मिलही।”<verse eid="2SA 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 6:23" />अऊ साऊल के बेटी मीकल के मरे के दिन तक ओकर कोनो लइका नइं होईस।<verse eid="2SA 6:23" /></para>
  <chapter eid="2SA 6" />
  <chapter number="7" style="c" sid="2SA 7" />
  <para style="s1">दाऊद बर परमेसर के वायदा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1" />जब राजा दाऊद ह अपन महल म रहे लगिस, अऊ यहोवा ओला ओकर चारों कोति के जम्मो बईरीमन ले बिसराम देय रिहिस, <verse eid="2SA 7:1" /><verse number="2" style="v" sid="2SA 7:2" />त एक दिन राजा ह नातान अगमजानी ला कहिस, “देख, मेंह देवदार लकरी ले बने घर म रहत हंव, जबकि परमेसर के सन्दूक ह एक तम्बू म हवय।”<verse eid="2SA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 7:3" />नातान ह राजा ले कहिस, “जऊन कुछू तोर मन म हवय, जा अऊ ओला कर, काबरकि यहोवा ह तोर संग हवय।”<verse eid="2SA 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 7:4" />पर ओहीच रथिया, यहोवा के ये बचन नातान मेर आईस:<verse eid="2SA 7:4" /></para>
  <para style="pm">
    <verse number="5" style="v" sid="2SA 7:5" />“जाके मोर सेवक दाऊद ला कह, ‘यहोवा ह ये कहत हे: का तेंह ओ अस, जऊन ह मोर निवास बर एक घर बनवाबे? <verse eid="2SA 7:5" /><verse number="6" style="v" sid="2SA 7:6" />जब ले मेंह इसरायलीमन ला मिसर देस ले निकालके लाने हंव, ओ दिन ले लेके आज तक मेंह कोनो घर म नइं रहे हंव। निवास के रूप म एक तम्बू के संग मेंह एक जगह ले दूसर जगह जावत हंव। <verse eid="2SA 7:6" /><verse number="7" style="v" sid="2SA 7:7" />जिहां-जिहां मेंह जम्मो इसरायलीमन के संग गेंव, का मेंह कभू ओमन के ऊपर सासन करइयामन ले, जेमन ला मेंह अपन इसरायली मनखेमन ऊपर सासक ठहिराय रहेंव, ओमन ले कोनो ला अइसन बात कहेंव, “तेंह मोर बर देवदार लकड़ी के घर काबर नइं बनवाय?” ’<verse eid="2SA 7:7" /></para>
  <para style="pm">
    <verse number="8" style="v" sid="2SA 7:8" />“एकरसेति, अब मोर सेवक दाऊद ले कह, ‘सर्वसक्तिमान यहोवा ह ये कहत हे: मेंह तोला चरागन ले, भेड़-बकरीमन ला चराय के काम ले लेंव, अऊ मेंह तोला मोर इसरायली मनखेमन ऊपर सासन करइया ठहिरांय। <verse eid="2SA 7:8" /><verse number="9" style="v" sid="2SA 7:9" />जिहां घलो तें गे, उहां में तोर संग रहेंव, अऊ मेंह तोर जम्मो बईरीमन ला तोर आघू ले नास कर देंव। अब मेंह तोर नांव ला धरती के सबले बड़े मनखेमन के नांव सहीं बड़े करहूं। <verse eid="2SA 7:9" /><verse number="10" style="v" sid="2SA 7:10" />अऊ मेंह अपन इसरायली मनखेमन बर एक जगह ठहिराहूं, अऊ ओमन ला बसाहूं, ताकि ओमन के अपन खुद के घर होवय अऊ ओमन फेर कभू एती-ओती झन होवंय। दुस्ट मनखेमन फेर ओमन ऊपर अतियाचार नइं करहीं, जइसने कि ओमन सुरू म करत रिहिन <verse eid="2SA 7:10" /><verse number="11" style="v" sid="2SA 7:11" />अऊ ओ बेरा ले करत आवत हें, जब मेंह अपन इसरायली मनखेमन ऊपर अगुवामन<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">परंपरा के रूप म येकर मतलब होथे </char><char style="fqa" closed="false">नियायीमन</char></note> ला ठहिरांय। मेंह तोला तोर जम्मो बईरीमन ले बिसराम दूहूं।</para>
  <para style="pm" vid="2SA 7:11">“ ‘यहोवा तोर करा घोसना करत हे कि यहोवा ह खुद तोर बर एक घर स्थापित करही: <verse eid="2SA 7:11" /><verse number="12" style="v" sid="2SA 7:12" />जब तोर उमर पूरा हो जाही, अऊ तेंह अपन पुरखामन संग मिल जाबे, त मेंह तोर संतान ला तोर जगह लेय बर ठाढ़ करहूं; ओह तोर खुद के देहें अऊ खून म ले होही, अऊ मेंह ओकर राज ला इस्थिर करहूं। <verse eid="2SA 7:12" /><verse number="13" style="v" sid="2SA 7:13" />ओही ह मोर नांव बर एक घर बनाही, अऊ मेंह ओकर राज के सिंघासन ला हमेसा बर इस्थिर करहूं। <verse eid="2SA 7:13" /><verse number="14" style="v" sid="2SA 7:14" />मेंह ओकर ददा होहूं, अऊ ओह मोर बेटा होही। जब ओह गलत काम करही, त मेंह ओला मनखेमन के दुवारा छड़ी ले अऊ कोर्रा ले पीटवाके दंड दूहूं। <verse eid="2SA 7:14" /><verse number="15" style="v" sid="2SA 7:15" />पर मोर मया ह ओकर ऊपर ले कभू नइं हटही, जइसे कि मेंह साऊल के ऊपर ले हटा ले रहेंव अऊ जेला मेंह तोर आघू ले दूरिहा कर देंव। <verse eid="2SA 7:15" /><verse number="16" style="v" sid="2SA 7:16" />तोर घराना अऊ तोर राज ह मोर आघू म सदा बने रहिही; तोर सिंघासन ह सदा बने रहिही।’ ”<verse eid="2SA 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 7:17" />नातान ह दरसन के हर एक बात दाऊद ला बता दीस।<verse eid="2SA 7:17" /></para>
  <para style="s1">दाऊद के पराथना</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18" />तब दाऊद राजा ह भीतर जाके यहोवा के आघू म बईठ गीस, अऊ कहिस:</para>
  <para style="pm" vid="2SA 7:18">“हे परमपरधान यहोवा, मेंह कोन अंव, अऊ मोर घराना का ए, कि तेंह मोला इहां तक लाने हस? <verse eid="2SA 7:18" /><verse number="19" style="v" sid="2SA 7:19" />अऊ हे परमपरधान यहोवा, मानो येह तोर नजर म परयाप्त नइं रिहिस कि तेंह अपन सेवक के घराना के भविस्य के बारे म गोठियाय—अऊ हे परमपरधान यहोवा, ये बिधि-बिधान ह सिरिप एक मनखे बर अय!<verse eid="2SA 7:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="2SA 7:20" />“दाऊद ह तोर ले अऊ का कह सकत हे? काबरकि हे परमपरधान यहोवा, तें तो अपन सेवक ला जानत हस। <verse eid="2SA 7:20" /><verse number="21" style="v" sid="2SA 7:21" />अपन बचन के हित म अऊ अपन ईछा के मुताबिक, तेंह ये बड़े काम करे हस अऊ अपन सेवक ला ये बात बताय हस।<verse eid="2SA 7:21" /></para>
  <para style="pm">
    <verse number="22" style="v" sid="2SA 7:22" />“हे परमपरधान यहोवा, तेंह कतेक महान अस! तोर सहीं अऊ कोनो नइं ए, अऊ तोला छोंड़ अऊ कोनो परमेसर नइं ए, जइसे कि हमन अपन कान ले सुने हवन। <verse eid="2SA 7:22" /><verse number="23" style="v" sid="2SA 7:23" />अऊ तोर मनखे इसरायल के सहीं कोन हे—धरती ऊपर के एक जाति, जेला अपन नांव के खातिर तेंह जाके छोंड़ाय, अऊ अपन मनखेमन के आघू ले जाति-जाति के मनखेमन ला निकालके बड़े अऊ अद्भूत काम करे, अऊ ओमन ला मिसर देस ले छोंड़ाय। <verse eid="2SA 7:23" /><verse number="24" style="v" sid="2SA 7:24" />तेंह अपन मनखे इसरायलीमन ला हमेसा बर अपन खुद के मनखे के रूप म स्थापित करे, अऊ हे यहोवा, तेंह ओमन के परमेसर बने हस।<verse eid="2SA 7:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="2SA 7:25" />“अऊ अब हे यहोवा परमेसर, तेंह जऊन वायदा अपन सेवक अऊ ओकर घराना के बारे म करे हस, ओला सदाकाल तक बनाय रख। अपन वायदा के मुताबिक ही कर, <verse eid="2SA 7:25" /><verse number="26" style="v" sid="2SA 7:26" />ताकि तोर नांव ह सदाकाल बर महान रहय। तब मनखेमन कहिहीं, ‘सर्वसक्तिमान यहोवा ह इसरायल ऊपर परमेसर अय!’ अऊ तोर सेवक दाऊद के घराना ह तोर नजर म बने रहिही।<verse eid="2SA 7:26" /></para>
  <para style="pm">
    <verse number="27" style="v" sid="2SA 7:27" />“हे सर्वसक्तिमान यहोवा, इसरायल के परमेसर, तेंह येला अपन सेवक ऊपर परगट करे हस, ‘मेंह तोर बर एक घर ला बनाहूं।’ एकरसेति तोर सेवक ला तोर ले पराथना करे के हिम्मत मिले हवय। <verse eid="2SA 7:27" /><verse number="28" style="v" sid="2SA 7:28" />हे परमपरधान यहोवा, तेंहीच ह परमेसर अस! तोर करार ह बिसवासयोग्य अय, अऊ तेंह ये बने चीजमन के वायदा अपन सेवक ले करे हस। <verse eid="2SA 7:28" /><verse number="29" style="v" sid="2SA 7:29" />त अब खुस होके अपन सेवक के घराना ला आसीस दे, कि येह तोर नजर म हमेसा बने रहय; काबरकि हे परमपरधान यहोवा, तेंह ये बात ला कहे हस, अऊ तोर आसीस ले ही तोर सेवक के घराना ह हमेसा आसीसित होही।”<verse eid="2SA 7:29" /></para>
  <chapter eid="2SA 7" />
  <chapter number="8" style="c" sid="2SA 8" />
  <para style="s1">दाऊद के जीत</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1" />कुछू समय के बाद, दाऊद ह पलिस्तीमन ला हराके ओमन ला अपन अधीन कर लीस, अऊ ओह मेतेग-अम्मा सहर ला पलिस्तीमन के हांथ ले छीन लीस।<verse eid="2SA 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2" />दाऊद ह मोआबीमन ला घलो हराईस। ओह ओमन ला भुइयां म लेटा दीस अऊ ओमन ला एक ठन डोरी ले नापिस। तब ओमा के हर दू पांति के मनखेमन मार डारे गीन, अऊ तीसरा पांति के मनखेमन ला जीयत छोंड़ दिये गीस। ये किसम ले मोआबीमन दाऊद के अधीन होके ओला कर पटाय लगिन।<verse eid="2SA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3" />येकर छोंड़ दाऊद ह रहोब के बेटा सोबा के राजा हददेजेर ला हराईस, जब हददेजेर ह फरात नदी करा अपन स्मारक के मरम्मत करे बर जावत रिहिस। <verse eid="2SA 8:3" /><verse number="4" style="v" sid="2SA 8:4" />दाऊद ह ओकर एक हजार रथ, सात हजार सारथी,<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">कुछू हस्तलिपि म सतरह सौ</char></note> अऊ बीस हजार पैदल सैनिकमन ला छीन लीस। ओह एक सौ रथवाले घोड़ामन ला छोंड़के बाकि जम्मो घोड़ामन के माड़ी के पाछू के नस ला कटवा दीस।<verse eid="2SA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5" />जब दमिस्क के अरामीमन सोबा के राजा हददेजेर के मदद करे बर आईन, त दाऊद ह ओमन के बाईस हजार मनखेमन ला मार डारिस। <verse eid="2SA 8:5" /><verse number="6" style="v" sid="2SA 8:6" />दाऊद ह दमिस्क के अरामी राज म सैनिक दलमन ला ठहिरा दीस, अऊ अरामीमन ओकर अधीन हो गीन अऊ ओला कर पटाय लगिन। दाऊद ह जिहां घलो गीस, यहोवा ह ओला जीतवाईस।<verse eid="2SA 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 8:7" />दाऊद ह हददेजेर के अधिकारीमन के सोन के ढालमन ला ले लीस अऊ ओ ढालमन ला यरूसलेम ले आईस। <verse eid="2SA 8:7" /><verse number="8" style="v" sid="2SA 8:8" />हददेजेर के तेबह<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">बेतह</char></note> अऊ बरोतै नांव के नगरमन ले दाऊद राजा ह बहुंत अकन कांसा ले आईस।<verse eid="2SA 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 8:9" />जब हमात के राजा तोऊ<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">तोई</char><char style="ft" closed="false">; <char style="xt" link-href="2SA 8:10"><ref loc="2SA 8:10">पद 10</ref></char> म घलो</char></note> ह सुनिस कि दाऊद ह हददेजेर के पूरा सेना ला हरा दे हवय, <verse eid="2SA 8:9" /><verse number="10" style="v" sid="2SA 8:10" />त ओह योराम नांव के अपन बेटा ला दाऊद राजा करा पठोईस, ताकि ओह ओकर ले भेंट करके हददेजेर के ऊपर लड़ई म मिले जीत बर बधाई देवय, काबरकि हददेजेर ह तोऊ ले लड़ई करत रिहिस। योराम ह अपन संग सोन, चांदी, अऊ कांसा के चीजमन ला लेके आय रिहिस।<verse eid="2SA 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 8:11" />दाऊद राजा ह ये चीजमन ला यहोवा बर अरपन कर दीस, जइसे कि ओह ओ चांदी अऊ सोन के संग करे रिहिस, जेला ओह ये जम्मो जाति— <verse eid="2SA 8:11" /><verse number="12" style="v" sid="2SA 8:12" />याने कि एदोम<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">जादा इबरानी हस्तलिपि म </char><char style="fqa" closed="false">अराम</char></note> अऊ मोआब, अमोनी अऊ पलिस्ती, अऊ अमालेकीमन ले लेय रिहिस। ओह रहोब के बेटा, सोबा के राजा हददेजेर ले लूटे चीजमन ला घलो अरपन कर दीस।<verse eid="2SA 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13" />अऊ जब दाऊद ह नून के घाटी म अठारह हजार एदोमीमन<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="ft" closed="false">जादा इबरानी हस्तलिपि म </char><char style="fqa" closed="false">अरामीमन</char></note> ला मारके लहुंटिस, त ओकर बड़े नांव हो गीस।<verse eid="2SA 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 8:14" />ओह पूरा एदोम म सैनिक दलमन के पहरा बईठा दीस, अऊ जम्मो एदोमीमन दाऊद के अधीन हो गीन। दाऊद ह जिहां घलो गीस, यहोवा ह ओला जीतवाईस।<verse eid="2SA 8:14" /></para>
  <para style="s1">दाऊद के करमचारीमन</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15" />दाऊद ह जम्मो इसरायल ऊपर राज करिस, अऊ ओ काम करिस, जऊन ह ओकर जम्मो मनखेमन बर ठीक अऊ सही रिहिस। <verse eid="2SA 8:15" /><verse number="16" style="v" sid="2SA 8:16" />सरूयाह के बेटा योआब ह सेना के सेनापति रिहिस; अहीलूद के बेटा यहोसापात ह इतिहास के लेखक रिहिस; <verse eid="2SA 8:16" /><verse number="17" style="v" sid="2SA 8:17" />अहीतूब के बेटा सादोक अऊ अबियातार के बेटा अहीमेलेक पुरोहित रिहिन; सरायाह ह सचिव रिहिस; <verse eid="2SA 8:17" /><verse number="18" style="v" sid="2SA 8:18" />यहोयादा के बेटा बनायाह ह करेती अऊ पलेतीमन के अधिकारी रिहिस; अऊ दाऊद के बेटामन मुखिया अधिकारी<note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">पुरोहित </char><char style="ft" closed="false">(देखव <char style="xt"><ref loc="1CH 18:17">1 इति 18:17</ref>)</char></char></note> रिहिन।<verse eid="2SA 8:18" /></para>
  <chapter eid="2SA 8" />
  <chapter number="9" style="c" sid="2SA 9" />
  <para style="s1">मपीबोसेत ऊपर दाऊद के किरपा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1" />एक दिन दाऊद ह सोचिस, “का साऊल के घराना म ले कोनो अभी घलो बांचे हवय, जेला मेंह योनातन के खातिर मया देखावंव?”<verse eid="2SA 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 9:2" />साऊल के घराना के सीबा नांव के एक झन सेवक रिहिस। ओला दाऊद करा बलाय गीस, अऊ जब राजा ह ओकर ले पुछिस, “का तेंह सीबा अस?”</para>
  <para style="p" vid="2SA 9:2">तब ओह जबाब दीस, “हव, तोर सेवा म हाजिर हे।”<verse eid="2SA 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 9:3" />राजा ह पुछिस, “का साऊल के घराना म ले कोनो अब तक बांचे हवय, जेला मेंह परमेसर के दया देखा सकंव?”</para>
  <para style="p" vid="2SA 9:3">सीबा ह राजा ला जबाब दीस, “अभी घलो योनातन के एक झन बेटा हवय, जऊन ह दूनों गोड़ ले खोरवा अय।”<verse eid="2SA 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 9:4" />राजा ह पुछिस, “ओह कहां हवय?”</para>
  <para style="p" vid="2SA 9:4">सीबा ह जबाब दीस, “ओह लो-देबार नगर म अमीएल के बेटा माकीर के घर म हवय।”<verse eid="2SA 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 9:5" />तब राजा दाऊद ह दूत ला पठोके ओला लो-देबार ले, अमीएल के बेटा माकीर के घर ले बुलवा लीस।<verse eid="2SA 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6" />जब मपीबोसेत, जऊन ह योनातन के बेटा अऊ साऊल के पोता रिहिस, दाऊद मेर आईस, तब ओह आदर देय बर मुहूं के बल गिरके दाऊद ला दंडवत करिस।</para>
  <para style="p" vid="2SA 9:6">दाऊद ह कहिस, “हे मपीबोसेत!”</para>
  <para style="p" vid="2SA 9:6">ओह कहिस, “तोर सेवा म हाजिर हे।”<verse eid="2SA 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 9:7" />दाऊद ह ओला कहिस, “झन डर, काबरकि तोर ददा योनातन के खातिर मेंह तोर ऊपर जरूर दया करहूं। अऊ तोर दादा साऊल के सबो भुइयां तोला फेर वापिस कर दूहूं, अऊ तेंह हमेसा मोर संग राजा के मेज म जेवन करबे।”<verse eid="2SA 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 9:8" />मपीबोसेत ह दंडवत करके कहिस, “तोर सेवक ह का अय कि तेंह मोर सहीं मरे कुकुर के कोति धियान देवत हस?”<verse eid="2SA 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 9:9" />तब राजा ह साऊल के करमचारी सीबा ला बलाके ओला कहिस, “जऊन कुछू साऊल अऊ ओकर परिवार के रिहिस, ओ जम्मो चीज मेंह तोर मालिक के पोता ला देय दे हंव। <verse eid="2SA 9:9" /><verse number="10" style="v" sid="2SA 9:10" />अब ले तें अपन बेटा अऊ सेवकमन संग ओकर बर भुइयां म खेती-बारी करके ओकर ऊपज ला ले आय करबे, ताकि तोर मालिक के पोता ला जेवन मिलय। अऊ तोर मालिक के पोता मपीबोसेत ह हमेसा मोर मेज म जेवन करही।” (सीबा के पंदरह बेटा अऊ बीस सेवक रिहिन।)<verse eid="2SA 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 9:11" />तब सीबा ह राजा ले कहिस, “मोर मालिक राजा ह अपन सेवक ला जऊन कुछू भी करे के हुकूम दीही, तोर सेवक ह ओहीच काम करही।” एकरसेति मपीबोसेत ह राजा के एक बेटा सहीं दाऊद के मेज म जेवन करे लगिस।<verse eid="2SA 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 9:12" />मपीबोसेत के मीका नांव के एक छोटे बेटा रिहिस, अऊ सीबा के घर के जम्मो मनखेमन मपीबोसेत के सेवक रिहिन। <verse eid="2SA 9:12" /><verse number="13" style="v" sid="2SA 9:13" />अऊ मपीबोसेत ह यरूसलेम म रहे लगिस; काबरकि ओह हमेसा राजा के मेज म जेवन करय; ओह दूनों गोड़ ले खोरवा रिहिस।<verse eid="2SA 9:13" /></para>
  <chapter eid="2SA 9" />
  <chapter number="10" style="c" sid="2SA 10" />
  <para style="s1">दाऊद ह अमोनीमन ला हराथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1" />कुछू समय के बाद, अमोनीमन के राजा नाहास ह मर गीस, अऊ ओकर बेटा हानून ह ओकर जगह म राजा बनिस। <verse eid="2SA 10:1" /><verse number="2" style="v" sid="2SA 10:2" />तब दाऊद ह ये सोचिस, “मेंह नाहास के बेटा हानून ऊपर दया करहूं, जइसे ओकर ददा ह मोर ऊपर दया करे रिहिस।” एकरसेति दाऊद ह अपन एक परतिनिधि-मंडल ला हानून करा ओकर ददा के बारे म सहानुभूति परगट करे बर पठोईस।</para>
  <para style="p" vid="2SA 10:2">जब दाऊद के आदमीमन अमोनीमन के देस म आईन, <verse eid="2SA 10:2" /><verse number="3" style="v" sid="2SA 10:3" />त अमोनी सेनापतिमन अपन मालिक हानून ला कहिन, “का तेंह ये सोचत हस कि दाऊद ह तोर संग सहानुभूति देखाय बर दूतमन ला पठोय के दुवारा तोर ददा के आदर करत हे? का दाऊद ह ओमन ला तोर मेर सिरिप एकर खातिर नइं पठोय हवय कि ओमन ये सहर के खोजबीन करंय अऊ भेद लेवंय अऊ येला उखान फेकंय?” <verse eid="2SA 10:3" /><verse number="4" style="v" sid="2SA 10:4" />एकरसेति हानून ह दाऊद के दूतमन ला पकड़ लीस, अऊ ओमन के हर एक के आधा-आधा दाढ़ी ला फंकवा दीस, अऊ ओमन के ओनहा ला कुलामन तक कटवा दीस अऊ ओमन ला वापिस भेज दीस।<verse eid="2SA 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 10:5" />जब दाऊद ला एकर बारे म बताय गीस, त ओह संदेसियामन ला ओमन ले मिले बर पठोईस, काबरकि ओमन के बहुंत बेजत्ती करे गे रिहिस। राजा ह ओमन करा ये खबर पठोईस, “जब तक तुम्हर दाढ़ी बाढ़ नइं जावय, तब तक तुमन यरीहो सहर म ठहिरे रहव, अऊ तब वापिस आ जावव।”<verse eid="2SA 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6" />जब अमोनीमन ला महसूस होईस कि ओमन दाऊद ला नराज कर दे हवंय, तब ओमन बेत-रहोब अऊ सोबा ले बीस हजार अरामी पैदल सैनिक, माका के राजा के संग एक हजार मनखे, अऊ बारह हजार मनखे तोब ले भाड़ा म लीन।<verse eid="2SA 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 10:7" />ये सुनके, दाऊद ह योआब ला योद्धामन के जम्मो सेना के संग पठोईस। <verse eid="2SA 10:7" /><verse number="8" style="v" sid="2SA 10:8" />तब अमोनीमन बाहिर निकलिन अऊ अपन सहर के प्रवेस दुवार करा लड़ई बर कतार बांधिन, जबकि सोबा अऊ रहोब के अरामीमन अऊ तोब अऊ माका के मनखेमन खुला मैदान म रिहिन।<verse eid="2SA 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 10:9" />जब योआब ह देखिस कि ओकर आघू अऊ पाछू दूनों कोति ओकर बिरूध लड़ई बर कतार बांधे गे हवय, त ओह इसरायल के सबले बढ़िया कुछू सैनिक दलमन ला चुनिस अऊ ओमन ला अरामीमन के बिरूध ठहिरा दीस। <verse eid="2SA 10:9" /><verse number="10" style="v" sid="2SA 10:10" />ओह बाकि बांचे आदमीमन ला अपन भाई अबीसै के अधीन करके ओमन ला अमोनीमन के बिरूध तैनात कर दीस। <verse eid="2SA 10:10" /><verse number="11" style="v" sid="2SA 10:11" />फेर योआब ह कहिस, “यदि अरामीमन मोर ऊपर भारी होवन लगंय, त तुमन मोर मदद करे बर आहू; अऊ यदि अमोनीमन तुम्हर ऊपर भारी होवन लगहीं, त मेंह आके तुम्हर मदद करहूं। <verse eid="2SA 10:11" /><verse number="12" style="v" sid="2SA 10:12" />मजबूत बनव, अऊ आवव, हमन अपन मनखे अऊ अपन परमेसर के सहरमन बर हिम्मत से लड़ई करन। यहोवा ह ओही करही, जऊन ह ओकर नजर म सही अय।”<verse eid="2SA 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13" />तब योआब अऊ ओकर संग के सैनिक दल अरामीमन ले लड़े बर आघू बढ़िन, अऊ अरामीमन ओकर आघू ले भाग गीन। <verse eid="2SA 10:13" /><verse number="14" style="v" sid="2SA 10:14" />जब अमोनीमन देखिन कि अरामीमन भागत हवंय, त अमोनीमन घलो अबीसै के आघू ले भागिन अऊ सहर के भीतर चल दीन। योआब ह अमोनीमन ले लड़े के बाद लहुंटके यरूसलेम आ गीस।<verse eid="2SA 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 10:15" />जब अरामीमन देखिन कि ओमन इसरायलीमन ले हार गे हवंय, त ओमन फेर दल बनाके एक संग जूरिन। <verse eid="2SA 10:15" /><verse number="16" style="v" sid="2SA 10:16" />हददेजेर ह फरात नदी के ओ पार ले अरामीमन ला बुलवा ले रिहिस; ओमन हेलाम नगर करा आ गीन अऊ हददेजेर के सेना के सेनापति सोबक ह ओमन के अगुवई करत रहय।<verse eid="2SA 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 10:17" />जब दाऊद ला ये बात बताय गीस, त ओह जम्मो इसरायलीमन ला इकट्ठा करिस, अऊ यरदन नदी ला पार करके हेलाम म आ गीस। तब अरामीमन दाऊद ले लड़े बर अपन कतार बांधिन अऊ ओकर ले लड़िन। <verse eid="2SA 10:17" /><verse number="18" style="v" sid="2SA 10:18" />पर ओमन इसरायलीमन के आघू ले भाग गीन, अऊ दाऊद ह अरामीमन के सात सौ सारथी अऊ चालीस हजार पैदल सैनिकमन ला मार डारिस।<note caller="+" style="f"><char style="fr" closed="false">10:18 </char><char style="ft" closed="false">कुछू सेप्टाजिन्ट हस्तलिपि म (देखव <char style="xt"><ref loc="1CH 19:18">1 इति 19:18</ref></char>); इबरानी म </char><char style="fqa" closed="false">घुड़सवारमन</char></note> ओह ओमन के सेना के सेनापति सोबक ला घलो अइसन मारिस कि ओह उहां मर गीस। <verse eid="2SA 10:18" /><verse number="19" style="v" sid="2SA 10:19" />जब हददेजेर के अधीन के जम्मो राजामन देखिन कि ओमन इसरायलीमन ले हार गे हवंय, त ओमन इसरायलीमन संग समझौता कर लीन अऊ ओमन के अधीन हो गीन।</para>
  <para style="p" vid="2SA 10:19">ओकर बाद, अरामीमन अमोनीमन के मदद करे बर डरे लगिन।<verse eid="2SA 10:19" /></para>
  <chapter eid="2SA 10" />
  <chapter number="11" style="c" sid="2SA 11" />
  <para style="s1">दाऊद अऊ बतसेबा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1" />बसन्त के मौसम म, जब राजामन लड़ई करे बर निकलथें, ओ बेरा, दाऊद ह योआब ला राजा के आदमी अऊ जम्मो इसरायली सेना के संग पठोईस। ओमन अमोनीमन ला नास कर दीन अऊ रब्बा नगर ला घेर लीन। पर दाऊद ह यरूसलेम म ही रिहिस।<verse eid="2SA 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 11:2" />एक दिन सांझ के बेरा, दाऊद ह अपन बिस्तर ले उठके महल के छत म टहलत रिहिस, अऊ छत ले ओह एक माईलोगन ला नहावत देखिस। ओ माईलोगन ह अब्बड़ सुघर रिहिस। <verse eid="2SA 11:2" /><verse number="3" style="v" sid="2SA 11:3" />दाऊद ह एक झन ला पठोके ओ माईलोगन के बारे म पता लगवाईस। ओ मनखे ह ओला ये बताईस, “ओह एलीआम के बेटी, अऊ हित्ती उरियाह के घरवाली बतसेबा ए” <verse eid="2SA 11:3" /><verse number="4" style="v" sid="2SA 11:4" />तब दाऊद ह दूतमन ला पठोके ओला बुलवा लीस। बतसेबा ह ओकर मेर आईस अऊ दाऊद ह ओकर संग सुतिस। (ओ समय ओह अपन माहवारी ले सुध हो गे रिहिस।) तब ओह अपन घर वापिस चल दीस। <verse eid="2SA 11:4" /><verse number="5" style="v" sid="2SA 11:5" />ओ माईलोगन ह आसरा म हो गीस अऊ तब दाऊद करा ये कहिके खबर पठोईस, “मेंह आसरा म हवंव।”<verse eid="2SA 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 11:6" />तब दाऊद ह योआब करा ये खबर पठोईस, “हित्ती उरियाह ला मोर करा पठो दे।” अऊ योआब ह उरियाह ला दाऊद मेर पठो दीस। <verse eid="2SA 11:6" /><verse number="7" style="v" sid="2SA 11:7" />जब उरियाह ह ओकर करा आईस, त दाऊद ह ओकर ले योआब अऊ सेना के हालचाल अऊ लड़ई के बारे म पुछिस। <verse eid="2SA 11:7" /><verse number="8" style="v" sid="2SA 11:8" />तब दाऊद ह उरियाह ले कहिस, “तेंह अपन घर म जाके अपन गोड़ ला धो।” अऊ उरियाह ह महल ले चल दीस, अऊ ओकर पाछू, ओकर बर राजा कोति ले कुछू ईनाम पठोय गीस। <verse eid="2SA 11:8" /><verse number="9" style="v" sid="2SA 11:9" />पर उरियाह ह अपन मालिक के जम्मो सेवकमन संग महल के प्रवेस दुवार म सुत गीस अऊ अपन घर नइं गीस।<verse eid="2SA 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 11:10" />दाऊद ला बताय गीस, “उरियाह ह अपन घर नइं गीस,” त दाऊद ह उरियाह ले पुछिस, “का तेंह अभी सैनिक अभियान ले नइं आय हस? त तें अपन घर म काबर नइं गेय?”<verse eid="2SA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 11:11" />उरियाह ह दाऊद ले कहिस, “जब सन्दूक अऊ इसरायल अऊ यहूदा के मनखेमन तम्बूमन<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="fq" closed="false">तम्बूमन </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुक्कोत</char></note> म रहत हवंय, अऊ मोर सेनापति योआब अऊ मोर मालिक के मनखेमन खुला मैदान म डेरा डाले हवंय, त फेर मेंह खाय-पीये बर अऊ अपन घरवाली ला मया करे बर अपन घर कइसे जा सकत हंव? तोर जिनगी के सपथ, मेंह अइसन काम नइं करंव।”<verse eid="2SA 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 11:12" />तब दाऊद ह उरियाह ला कहिस, “इहां एक दिन अऊ रूक जा, अऊ कल मेंह तोला बिदा कर दूहूं।” एकरसेति उरियाह ओ दिन अऊ दूसर दिन घलो यरूसलेम म रूक गीस। <verse eid="2SA 11:12" /><verse number="13" style="v" sid="2SA 11:13" />दाऊद ह ओला नेवता दीस, अऊ ओह ओकर संग खाईस-पीईस, अऊ दाऊद ह ओला मतवाला कर दीस। पर सांझ के बेरा, उरियाह ह गीस अऊ अपन मालिक के सेवकमन के बीच अपन चटई म सुत गीस; पर ओह अपन घर नइं गीस।<verse eid="2SA 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14" />बिहनियां दाऊद ह योआब के नांव म एक चिट्ठी लिखके उरियाह के हांथ म पठो दीस। <verse eid="2SA 11:14" /><verse number="15" style="v" sid="2SA 11:15" />ओ चिट्ठी म ओह ये लिखे रिहिस, “उरियाह ला सामने ओ जगह म रख, जिहां भयंकर लड़ई होवत हे। तब ओकर ले पाछू हट जा, ताकि बईरीमन के दुवारा ओह मार डारे जावय।”<verse eid="2SA 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 11:16" />जब योआब ह नगर ला घेर लेय रिहिस, त ओह उरियाह ला लड़ई बर ओ जगह म भेजिस, जिहां ओह जानत रिहिस कि बईरीमन के बलवान सैनिकमन हवंय। <verse eid="2SA 11:16" /><verse number="17" style="v" sid="2SA 11:17" />जब सहर के मनखेमन बाहिर निकलके योआब ले लड़ई करिन, त दाऊद के सेना के कुछू मनखेमन मारे गीन; अऊ ओमा हित्ती उरियाह घलो मर गीस।<verse eid="2SA 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 11:18" />तब योआब ह लड़ई के पूरा हालचाल लिखके दाऊद करा भेज दीस। <verse eid="2SA 11:18" /><verse number="19" style="v" sid="2SA 11:19" />ओह संदेसिया ला ये निरदेस दीस, “जब तें लड़ई के पूरा हाल राजा ला बता लेबे, <verse eid="2SA 11:19" /><verse number="20" style="v" sid="2SA 11:20" />तब राजा ह गुस्सा होके तोला पुछ सकत हे, ‘तुमन लड़े बर सहर के अतेक लकठा म काबर गेव? का तुमन नइं जानत रहेव कि ओमन दीवार म ले तीर चलाहीं? <verse eid="2SA 11:20" /><verse number="21" style="v" sid="2SA 11:21" />यरूब-बेसेत के बेटा अबीमेलेक ला कोन ह मार डारिस? का एक माईलोगन ह दीवार ले चक्की के ऊपर के पाट ला ओकर ऊपर नइं गिरा देय रिहिस, जेकर ले ओह तेबेस म मर गीस? फेर तुमन दीवार के अतेक लकठा म काबर गेव?’ यदि ओह तोर ले अइसने पुछथे, त ओला कहिबे, ‘येकर अलावा, तोर सेवक हित्ती उरियाह घलो मर गीस।’ ”<verse eid="2SA 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 11:22" />तब संदेसिया ह चल दीस, अऊ जब ओह दाऊद करा हबरिस, त ओह ओला ओ जम्मो बात बताईस, जेला कहे बर योआब ह ओला पठोय रिहिस। <verse eid="2SA 11:22" /><verse number="23" style="v" sid="2SA 11:23" />संदेसिया ह दाऊद ले कहिस, “ओ मनखेमन हमर ऊपर हावी हो गीन अऊ खुला मैदान म हमर ऊपर हमला करिन, पर हमन ओमन ला सहर के प्रवेस दुवार तक भगा देंन। <verse eid="2SA 11:23" /><verse number="24" style="v" sid="2SA 11:24" />तब धनुसधारीमन दीवार ले तोर सेवकमन ऊपर तीर चलाईन, अऊ राजा के कुछू मनखेमन मर गीन। ओमा तोर सेवक हित्ती उरियाह घलो मर गीस।”<verse eid="2SA 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 11:25" />दाऊद ह संदेसिया ला कहिस, “योआब ले अइसने कहिबे: ‘ये बात के खातिर उदास झन हो; तलवार ह जइसने एक ला मारथे, वइसने दूसर ला घलो मारथे। सहर के बिरूध अऊ जादा मजबूती से हमला कर अऊ ओला नास कर दे।’ योआब के हौसला बढ़ाय बर अइसने कह।”<verse eid="2SA 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 11:26" />जब उरियाह के घरवाली ह सुनिस कि ओकर घरवाला ह मर गीस, त ओह अपन घरवाला बर बिलाप करे लगिस। <verse eid="2SA 11:26" /><verse number="27" style="v" sid="2SA 11:27" />ओकर बिलाप के दिन खतम होय के बाद, दाऊद ह ओला अपन घर म ले आईस, अऊ ओह ओकर घरवाली हो गीस अऊ ओह एक बेटा ला जनम दीस। पर जऊन काम दाऊद ह करे रिहिस, ओकर ले यहोवा ह नराज होईस।<verse eid="2SA 11:27" /></para>
  <chapter eid="2SA 11" />
  <chapter number="12" style="c" sid="2SA 12" />
  <para style="s1">नातान ह दाऊद ला डांटथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1" />तब यहोवा ह नातान ला दाऊद मेर पठोईस। नातान ह ओकर मेर जाके कहिस, “एक नगर म दू झन मनखे रिहिन, जेमा एक झन ह धनी अऊ दूसर ह गरीब रिहिस। <verse eid="2SA 12:1" /><verse number="2" style="v" sid="2SA 12:2" />धनी मनखे करा अब्बड़ भेड़-बकरी अऊ गाय-बईला रिहिन, <verse eid="2SA 12:2" /><verse number="3" style="v" sid="2SA 12:3" />पर गरीब मेर एक ठन छोटे भेड़ी-पीला के छोंड़ अऊ कुछू नइं रिहिस, जेला कि ओह बिसाय रिहिस। ओह ओला पालिस-पोसिस, अऊ ओ भेड़ी-पीला ह ओकर अऊ ओकर लइकामन संग बढ़े रिहिस; ओह ओ गरीब मनखे के संग खावय, अऊ ओकर कटोरा म ले पीयय, अऊ ओकर कोरा म सुतय घलो। ओ भेड़ी-पीला ह ओकर बर ओकर एक बेटी के असन रिहिस।<verse eid="2SA 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 12:4" />“एक दिन अइसने होईस कि एक यातरा करइया मनखे ह धनी मनखे करा आईस, पर ओ यातरी, जऊन ह धनी मनखे करा आय रिहिस, ओकर खातिर जेवन बनाय बर, ओह अपन भेड़-बकरी या गाय-बईलामन ले कुछू नइं लीस, पर ओ गरीब मनखे के भेड़ी-पीला ला लेके, ओह ओ यातरी बर जेवन तियार करिस, जऊन ह ओकर मेर आय रिहिस।”<verse eid="2SA 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5" />ये सुनके दाऊद के कोप ओ मनखे ऊपर बहुंत भड़किस अऊ ओह नातान ला कहिस, “यहोवा के जिनगी के सपथ, जऊन मनखे ह ये काम करे हवय, ओकर मरना जरूरी ए! <verse eid="2SA 12:5" /><verse number="6" style="v" sid="2SA 12:6" />अऊ ओला ओ भेड़ी-पीला के चौगुना भरपई करे बर पड़ही, काबरकि ओह अइसन काम करिस, अऊ कुछू दया नइं करिस।”<verse eid="2SA 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7" />तब नातान ह दाऊद ले कहिस, “तेंह ओ मनखे अस! यहोवा, इसरायल के परमेसर ह, ये कहत हे: ‘मेंह इसरायल ऊपर राजा के रूप म तोर अभिसेक करेंव, अऊ मेंह तोला साऊल के हांथ ले बचायेंव। <verse eid="2SA 12:7" /><verse number="8" style="v" sid="2SA 12:8" />मेंह तोर मालिक के घर ला तोला दे देंव, अऊ तोर मालिक के घरवालीमन ला तोर हांथ म कर देंव। मेंह पूरा इसरायल अऊ यहूदा तोला दे देंव। अऊ यदि ये जम्मो ह थोरकन रिहिस, त मेंह तोला अऊ घलो बहुंत चीज देय रहितेंव। <verse eid="2SA 12:8" /><verse number="9" style="v" sid="2SA 12:9" />तेंह यहोवा के बचन ला तुछ जानके काबर ओकर नजर म दुस्ट काम करय? तेंह हित्ती उरियाह ला तलवार ले मार डारय, अऊ ओकर घरवाली ला अपन घरवाली बना लेय। तेंह उरियाह ला अमोनीमन के तलवार ले मरवा डारय। <verse eid="2SA 12:9" /><verse number="10" style="v" sid="2SA 12:10" />एकरसेति, अब तलवार ह तोर घर के पीछा कभू नइं छोंड़य, काबरकि तेंह मोला तुछ जानके हित्ती उरियाह के घरवाली ला अपन बना ले हस।’<verse eid="2SA 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 12:11" />“यहोवा ह ये कहत हे: ‘तोर खुद के घराना ले मेंह तोर ऊपर बिपत्ति लानहूं। तोर आंखी के आघू म मेंह तोर घरवालीमन ला लेके तोर नजदीकी मनखे ला दे दूहूं, अऊ ओह दिन के अंजोर म तोर घरवालीमन ले कुकरम करही। <verse eid="2SA 12:11" /><verse number="12" style="v" sid="2SA 12:12" />तेंह तो ये काम गुपत म करय, पर मेंह ये काम जम्मो इसरायलीमन के देखते-देखत दिन-दुपहरी म करहूं।’ ”<verse eid="2SA 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13" />तब दाऊद ह नातान ले कहिस, “मेंह यहोवा के बिरूध पाप करे हंव।”</para>
  <para style="p" vid="2SA 12:13">नातान ह दाऊद ला कहिस, “यहोवा ह तोर पाप ला दूरिहा कर दे हवय। तेंह नइं मरबे। <verse eid="2SA 12:13" /><verse number="14" style="v" sid="2SA 12:14" />पर तोर जऊन बेटा ह जनम लीही, ओह मर जाही, काबरकि ये काम करे के दुवारा तेंह यहोवा के बहुंत अपमान करे हस।”<verse eid="2SA 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 12:15" />नातान के अपन घर जाय के बाद, यहोवा ह ओ लइका ला बहुंत बिमरहा कर दीस, जेला उरियाह के घरवाली ह दाऊद कोति ले जनमाय रिहिस। <verse eid="2SA 12:15" /><verse number="16" style="v" sid="2SA 12:16" />दाऊद ह ओ लइका बर परमेसर ले बिनती करिस। ओह उपास करिस अऊ बोरा के ओनहा<note caller="+" style="f"><char style="fr" closed="false">12:16 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fq" closed="false">बोरा के ओनहा </char><char style="ft" closed="false">नइं ए</char></note> पहिरे रात भर भुइयां म पड़े रिहिस। <verse eid="2SA 12:16" /><verse number="17" style="v" sid="2SA 12:17" />ओकर घराना के सियानमन ओला भुइयां ले उठाय बर ओकर बाजू खड़े रिहिन, पर ओह नइं मानिस, अऊ ओमन के संग कोनो जेवन नइं करिस।<verse eid="2SA 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 12:18" />सात दिन बेमार रहे के बाद ओ लइका ह मर गीस। दाऊद के सेवकमन ओला लइका के मरे के समाचार देय बर डरत रिहिन, काबरकि ओमन सोचत रिहिन, “जब लइका ह जीयत रिहिस, अऊ हमन ओकर ले गोठियायेंन, त ओह हमर बात ला नइं सुनिस। पर अब हमन ओला कइसे बतावन कि लइका ह मर गे हवय? ओह निरासा म कुछू गलत झन कर बईठे।”<verse eid="2SA 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19" />दाऊद ह देखिस कि ओकर सेवकमन आपस म फुसफुसावत हवंय, त ओह जान डारिस कि लइका ह मर गे हवय। दाऊद ह ओमन ले पुछिस, “का लइका ह मर गीस?”</para>
  <para style="p" vid="2SA 12:19">त ओमन जबाब दीन, “हव, ओह मर गीस।”<verse eid="2SA 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 12:20" />तब दाऊद ह भुइयां ले उठिस, अऊ नहा-खोरके तेल लगाईस, अऊ अपन ओनहा ला बदलिस; तब ओह यहोवा के घर म जाके अराधना करिस। ओकर बाद, ओह अपन घर गीस, अऊ ओकर हुकूम ले ओला रोटी परोसे गीस, अऊ ओह जेवन करिस।<verse eid="2SA 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 12:21" />तब ओकर सेवकमन ओकर ले पुछिन, “तेंह काबर अइसन करत हस? जब तक लइका ह जीयत रिहिस, त तेंह उपास करय अऊ रोये, पर अब, जब लइका ह मर गीस, त तेंह उठके जेवन करत हस।”<verse eid="2SA 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 12:22" />ओह जबाब दीस, “जब लइका ह जीयत रिहिस, त मेंह उपास करेंव अऊ रोयें। काबरकि मेंह सोचत रहेंव, ‘कोन जानय? यहोवा के अनुग्रह मोर ऊपर होवय अऊ लइका ह जीयत रहय।’ <verse eid="2SA 12:22" /><verse number="23" style="v" sid="2SA 12:23" />पर अब ओह मर गीस, फेर मेंह काबर उपास करत रहंव? का मेंह ओला लहुंटाके ला सकत हंव? मेंह ओकर मेर जाहूं, पर ओह मोर करा लहुंटके नइं आवय।”<verse eid="2SA 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24" />तब दाऊद ह अपन घरवाली बतसेबा ला सांतवना दीस, अऊ ओह ओकर मेर जाके ओला मया करिस। बतसेबा ह एक बेटा ला जनम दीस, अऊ ओमन ओकर नांव सुलेमान रखिन। यहोवा ह ओकर ले मया करिस; <verse eid="2SA 12:24" /><verse number="25" style="v" sid="2SA 12:25" />अऊ काबरकि यहोवा ह ओकर ले मया करिस, एकरसेति ओह नातान अगमजानी के दुवारा संदेस पठोके ओ लइका के नांव यदिदियाह<note caller="+" style="f"><char style="fr" closed="false">12:25 </char><char style="fq" closed="false">यदिदियाह </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">यहोवा के मयारू</char></note> रखिस।<verse eid="2SA 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26" />इही बीच म योआब ह अमोनीमन के रब्बा नगर के बिरूध लड़िस अऊ साही किला ऊपर कब्जा कर लीस। <verse eid="2SA 12:26" /><verse number="27" style="v" sid="2SA 12:27" />तब योआब ह ये कहिके संदेसियामन ला दाऊद मेर पठोईस, “मेंह रब्बा के बिरूध लड़ेंव अऊ एकर पानी पूरोय के काम ला अपन अधीन कर ले हंव। <verse eid="2SA 12:27" /><verse number="28" style="v" sid="2SA 12:28" />एकरसेति अब बांचे सेना के मनखेमन ला इकट्ठा करके सहर के घेराबंदी कर अऊ ओला अपन अधीन कर ले। नइं तो मेंह सहर ला ले लूहूं, अऊ ओ सहर के नांव मोर नांव म रखे जाही।”<verse eid="2SA 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 12:29" />तब दाऊद ह जम्मो सेना ला इकट्ठा करके रब्बा नगर म गीस, अऊ ओकर ऊपर हमला करके ओला अपन अधीन कर लीस। <verse eid="2SA 12:29" /><verse number="30" style="v" sid="2SA 12:30" />तब दाऊद ह ओमन के राजा के मुड़ ले मुकुट ला ले लीस, अऊ ओ मुकुट ला दाऊद के मुड़ म रखे गीस। ओ मुकुट के वजन सोन के एक टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">12:30 </char><char style="ft" closed="false">लगभग 34 किलोग्राम</char></note> रिहिस, अऊ येमा कीमती पथरामन जड़े रिहिन। दाऊद ह ओ सहर ले बहुंत अकन सामान लूटके ले गीस <verse eid="2SA 12:30" /><verse number="31" style="v" sid="2SA 12:31" />अऊ उहां के मनखेमन ला बाहिर निकाल लीस अऊ ओमन ला आरी, रांपा अऊ टंगिया देके ओमन ले मजदूरी करवाईस, अऊ ओह ओमन ले ईंटा घलो बनवाईस। दाऊद ह अमोनी नगरमन के जम्मो मनखेमन के संग अइसने ही करिस। तब ओह अऊ ओकर पूरा सेना यरूसलेम लहुंट गीस।<verse eid="2SA 12:31" /></para>
  <chapter eid="2SA 12" />
  <chapter number="13" style="c" sid="2SA 13" />
  <para style="s1">अमनोन के कुकरम</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1" />तामार नांव के एक सुघर कन्या, जऊन ह दाऊद के बेटा अबसालोम के बहिनी रिहिस, ओकर ऊपर दाऊद के दूसर बेटा अमनोन ह मोहा गीस।<verse eid="2SA 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 13:2" />अमनोन के मन म ओकर बहिनी तामार ह अइसन छा गे रिहिस कि अमनोन ह बेमार पड़ गीस। तामार ह कुंवारी रिहिस, अऊ अमनोन ला ओकर संग कुछू करना असंभव लगत रिहिस।<verse eid="2SA 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 13:3" />अमनोन के योनादाब नांव के एक सलाहकार रिहिस, जऊन ह दाऊद के भाई सिमा के बेटा रिहिस। योनादाब ह बहुंत चतुर मनखे रिहिस। <verse eid="2SA 13:3" /><verse number="4" style="v" sid="2SA 13:4" />ओह अमनोन ले पुछिस, “तें राजा के बेटा अस, अऊ का कारन ए कि दिन ब दिन तेंह पातर होवत जावत हस? का तेंह मोला नइं बताबे?”</para>
  <para style="p" vid="2SA 13:4">अमनोन ह ओकर ले कहिस, “मेंह तो अपन भाई अबसालोम के बहिनी तामार ऊपर मोहा गे हंव।”<verse eid="2SA 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 13:5" />योनादाब ह कहिस, “अपन बिस्तर म जा अऊ अइसे बहाना कर कि तेंह बेमार हस, अऊ जब तोर ददा ह तोला देखे बर आही, तब ओकर ले कहिबे, ‘मेंह चाहत हंव कि मोर बहिनी तामार ह आके मोला खाय बर कुछू देवय। ओह जेवन ला मोर आघू म रांधय ताकि मेंह ओला देखंव अऊ तब ओकर हांथ ले खावंव।’ ”<verse eid="2SA 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 13:6" />तब अमनोन ह लेट गीस अऊ अइसे बहाना करे लगिस, मानो ओह बेमार हवय। अऊ जब राजा ह ओला देखे बर आईस, त अमनोन ह राजा ले कहिस, “मेंह चाहत हंव कि मोर बहिनी तामार ह आके मोर देखत म कुछू बिसेस रोटी बनाय कि मेंह ओकर हांथ ले खावंव।”<verse eid="2SA 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 13:7" />तब दाऊद ह महल म तामार मेर ये खबर पठोईस, “अपन भाई अमनोन के घर म जाके ओकर बर कुछू जेवन तियार कर।” <verse eid="2SA 13:7" /><verse number="8" style="v" sid="2SA 13:8" />तब तामार ह अपन भाई अमनोन के घर म गीस, जऊन ह अपन बिस्तर म लेटे रिहिस। तामार ह कुछू पीसान ला लेके गुंथिस, अऊ ओकर देखत म रोटी बनाईस। <verse eid="2SA 13:8" /><verse number="9" style="v" sid="2SA 13:9" />तब ओह थाली लेके ओला रोटी परोस दीस, पर अमनोन ह खाय ले मना करिस।</para>
  <para style="p" vid="2SA 13:9">ओह कहिस, “इहां ले जम्मो झन ला बाहिर भेज दे।” तब जम्मो झन उहां ले चल दीन। <verse eid="2SA 13:9" /><verse number="10" style="v" sid="2SA 13:10" />तब अमनोन ह तामार ले कहिस, “अब जेवन ला इहां मोर सुते के कमरा म ले आ कि में तोर हांथ ले खावंव।” त तामार ह अपन बनाय रोटी ला लीस अऊ ओला अपन भाई अमनोन मेर ओकर सुते के कमरा म ले आईस। <verse eid="2SA 13:10" /><verse number="11" style="v" sid="2SA 13:11" />पर जब ओह ओ रोटी ला ओकर करा खाय बर ले गीस, त अमनोन ह ओला पकड़ लीस अऊ कहिस, “हे मोर बहिनी, आ, मोर संग बिस्तर म सुत।”<verse eid="2SA 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 13:12" />तामार ह ओला कहिस, “हे मोर भाई, नइं, मोर संग जबरदस्ती झन कर; अइसन काम इसरायल म नइं होना चाही! अइसन दुस्ट काम झन कर। <verse eid="2SA 13:12" /><verse number="13" style="v" sid="2SA 13:13" />मोर का होही? मेंह अपन कलंक ले अलग कइसे होहूं? अऊ तोर का होही? तेंह इसरायल म एक दुस्ट मुरूख के रूप म गने जाबे। किरपा करके तेंह राजा ले गोठिया; ओह मोर बिहाव तोर संग करे बर मना नइं करही।” <verse eid="2SA 13:13" /><verse number="14" style="v" sid="2SA 13:14" />पर अमनोन ह ओकर बात नइं सुनिस; अऊ ओह तामार ले जादा ताकतवर होय के कारन ओह ओकर संग जबरदस्ती कुकरम करिस।<verse eid="2SA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 13:15" />ओकर बाद, अमनोन ह ओकर ले बहुंत घिन करे लगिस। पहिले जतेक मया ओह तामार ले करत रिहिस, ओकर ले बढ़के ओह घिन करे लगिस। तब अमनोन ह ओला कहिस, “उठ अऊ इहां ले निकल जा!”<verse eid="2SA 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 13:16" />पर तामार ह ओला कहिस, “नइं! जऊन गलत काम तेंह मोर संग करे हस, ओकर ले जादा गलती तो तेंह मोला इहां ले बाहिर भगाके करत हस।”</para>
  <para style="p" vid="2SA 13:16">पर अमनोन ह ओकर एको ठन बात नइं सुनिस। <verse eid="2SA 13:16" /><verse number="17" style="v" sid="2SA 13:17" />तब ओह अपन निजी सेवक ला बलाके कहिस, “ये माईलोगन ला मोर नजर ले हटा अऊ ओला निकालके कपाट ला बंद कर दे।” <verse eid="2SA 13:17" /><verse number="18" style="v" sid="2SA 13:18" />तब ओकर सेवक ह ओला निकाल दीस अऊ कपाट ला बंद कर दीस। ओह पूरा बांही के एक रंग-बिरंगी कुरता पहिरे रिहिस, काबरकि राजा के कुंवारी बेटीमन ये किसम के पहिरावा पहिरंय। <verse eid="2SA 13:18" /><verse number="19" style="v" sid="2SA 13:19" />तामार ह अपन मुड़ म राख ला डारिस, अऊ अपन पहिरे कुरता ला चीरिस, अऊ अपन मुड़ म अपन हांथ धरिस अऊ जोर-जोर से रोवत उहां ले चल दीस।<verse eid="2SA 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 13:20" />ओकर भाई अबसालोम ह ओकर ले पुछिस, “का तोर भाई, ओ अमनोन ह तोर संग म रिहिस? हे मोर बहिनी, अभी तें चुप हो जा; ओह तोर भाई अय। ये बात ला अपन मन म झन रख।” अऊ तामार ह अपन भाई अबसालोम के घर म अलग परे माईलोगन सहीं रहे लगिस।<verse eid="2SA 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 13:21" />जब दाऊद राजा ये जम्मो बात ला सुनिस, त ओह बहुंत नराज होईस। <verse eid="2SA 13:21" /><verse number="22" style="v" sid="2SA 13:22" />पर अबसालोम ह अमनोन ला कभू बने या खराप कुछू नइं कहिस; ओह ओकर ले घिन करय काबरकि अमनोन ह ओकर बहिनी तामार ला कलंकित करे रिहिस।<verse eid="2SA 13:22" /></para>
  <para style="s1">अबसालोम ह अमनोन ला मार डारथे</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23" />दू बछर के बाद, जब अबसालोम के ऊन कतरइयामन एपरैम के सीमना के लकठा म बाल-हासोर मेर रिहिन, त ओह राजा के जम्मो बेटामन ला उहां आय बर नेवता दीस। <verse eid="2SA 13:23" /><verse number="24" style="v" sid="2SA 13:24" />अबसालोम ह राजा करा जाके कहिस, “तोर सेवक ह भेड़ के ऊन कतरइयामन ला बलाय हवय, एकरसेति राजा अऊ ओकर सेवकमन किरपा करके मोर संग उहां चलंय।”<verse eid="2SA 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 13:25" />पर राजा ह जबाब दीस, “हे मोर बेटा, नइं, हमन जम्मो झन नइं जावन; नइं तो हमन तोर ऊपर एक बोझा सहीं हो जाबो।” हालाकि अबसालोम ओकर ले बिनती करिस, पर तभो ले राजा ह जाय बर मना कर दीस, पर ओला अपन आसीस दीस।<verse eid="2SA 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 13:26" />तब अबसालोम ह कहिस, “यदि तें नइं आ सकस, त किरपा करके मोर भाई अमनोन ला हमर संग म आवन दे।”</para>
  <para style="p" vid="2SA 13:26">राजा ह ओकर ले पुछिस, “ओह तोर संग काबर जाही?” <verse eid="2SA 13:26" /><verse number="27" style="v" sid="2SA 13:27" />पर अबसालोम ह ओकर ले बिनती करते रिहिस, त ओह अमनोन अऊ बाकि जम्मो राजकुमारमन ला ओकर संग पठो दीस।<verse eid="2SA 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 13:28" />अबसालोम ह अपन मनखेमन ला हुकूम दीस, “सुनव! जब अमनोन ह मंद पीके बहुंत नसा म आ जाही अऊ मेंह तुमन ले कहंव, ‘अमनोन ला मारव,’ तब ओला मार डारव। झन डरहू। का तुमन ला ये हुकूम देवइया में नो हंव। बलवान अऊ साहसी बनव।” <verse eid="2SA 13:28" /><verse number="29" style="v" sid="2SA 13:29" />एकरसेति अबसालोम के सेवकमन अमनोन के संग वइसे ही करिन, जइसे अबसालोम ह हुकूम देय रिहिस। तब जम्मो राजकुमारमन उठिन, अऊ अपन-अपन खच्चर म चघके भाग गीन।<verse eid="2SA 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 13:30" />जब ओमन रसता म ही रिहिन कि दाऊद ला ये खबर मिलिस, “अबसालोम ह राजा के जम्मो बेटामन ला मार डारे हे; ओमन के एको झन घलो नइं बांचे हवंय।” <verse eid="2SA 13:30" /><verse number="31" style="v" sid="2SA 13:31" />ये सुनके राजा ह उठके दुख म अपन ओनहा ला चीरिस अऊ भुइयां म लेट गीस; अऊ ओकर जम्मो सेवकमन घलो अपन ओनहा ला चीरके ओकर बाजू म ठाढ़ हो गीन।<verse eid="2SA 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 13:32" />पर दाऊद के भाई सिमा के बेटा योनादाब ह कहिस, “मोर मालिक ह ये झन सोचय कि जम्मो राजकुमार मार डारे गे हवंय; सिरिप अमनोन ही मारे गे हवय। जऊन दिन ले अमनोन ह अबसालोम के बहिनी तामार ले जबरदस्ती कुकरम करे रिहिस, ओही दिन ले ही अबसालोम ह एकर इरादा कर ले रिहिस। <verse eid="2SA 13:32" /><verse number="33" style="v" sid="2SA 13:33" />मोर मालिक राजा ह ये खबर सुनके उदास झन होवय कि राजा के जम्मो बेटामन मर गे हवंय। सिरिप अमनोन ही मारे गे हवय।”<verse eid="2SA 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34" />इही दौरान, अबसालोम ह भाग गे रिहिस।</para>
  <para style="p" vid="2SA 13:34">जऊन मनखे ह पहरा देवत रिहिस, ओह आंखी ला उठाके देखिस कि ओकर पछिम के रसता ले, पहाड़ी के बाजू ले बहुंते मनखेमन आवत हवंय। पहरेदार ह जाके राजा ला कहिस, “मेंह होरोनैम कोति, पहाड़ी के बाजू म मनखेमन ला देखत हंव।”<verse eid="2SA 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 13:35" />योनादाब ह राजा ला कहिस, “देख, राजा के बेटामन आ गे हवंय; जइसने तोर सेवक ह कहे रिहिस, वइसनेच होईस।”<verse eid="2SA 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 13:36" />ओह अपन बात खतम ही करे रिहिस कि राजा के बेटामन जोर-जोर से रोवत आ गीन। राजा ह घलो अपन जम्मो अधिकारीमन संग कलप-कलपके के रोवन लगिस।<verse eid="2SA 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 13:37" />अबसालोम ह भागके गसूर के राजा, अमीहूद के बेटा तलमै करा चल दीस। पर दाऊद ह अपन बेटा बर बहुंत दिन तक बिलाप करिस।<verse eid="2SA 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 13:38" />जब अबसालोम ह भागके गसूर ला गीस, त ओह उहां तीन बछर तक रिहिस। <verse eid="2SA 13:38" /><verse number="39" style="v" sid="2SA 13:39" />अऊ राजा दाऊद के मन म अबसालोम मेर जाय के बड़े लालसा रिहिस, काबरकि ओह अमनोन के मिरतू के बात ले उबर चुके रिहिस।<verse eid="2SA 13:39" /></para>
  <chapter eid="2SA 13" />
  <chapter number="14" style="c" sid="2SA 14" />
  <para style="s1">अबसालोम ह यरूसलेम लहुंटथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1" />सरूयाह के बेटा योआब ह जान डारिस कि राजा के मन ह अबसालोम कोति लगे हवय। <verse eid="2SA 14:1" /><verse number="2" style="v" sid="2SA 14:2" />एकरसेति योआब ह तकोआ नगर म दूत ला पठोके उहां ले एक बुद्धिमान माईलोगन ला बलाईस। ओह ओ माईलोगन ले कहिस, “अइसे दिखावा कर कि तेंह सोक मनात हस। सोक के पहिरावा ला पहिर ले, अऊ कोनो भी किसम के सजे-संवरे के चीज के उपयोग झन कर। अइसे माईलोगन सहीं दिखावा कर, जऊन ह मरे मनखे बर बहुंत दिन ले बिलाप करत हे। <verse eid="2SA 14:2" /><verse number="3" style="v" sid="2SA 14:3" />तब राजा करा जाके ओला ये बात कह।” अऊ योआब ह ओला सिखो दीस कि का कहना हे।<verse eid="2SA 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 14:4" />जब तकोआ नगर के ओ माईलोगन ह राजा मेर गीस, त ओह मुहूं के भार भुइयां म गिरके राजा के दंडवत करिस, अऊ ओह कहिस, “हे महाराज, मोर मदद कर!”<verse eid="2SA 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 14:5" />राजा ह ओकर ले पुछिस, “तोर का समस्या ए?”</para>
  <para style="p" vid="2SA 14:5">ओह जबाब दीस, “में एक बिधवा अंव; मोर घरवाला ह मर गीस। <verse eid="2SA 14:5" /><verse number="6" style="v" sid="2SA 14:6" />अऊ में, तोर सेविका के दू झन बेटा रिहिन, जब ओमन खेत म रिहिन, त ओ दूनों के बीच मारपीट होईस, अऊ उहां ओमन ला छोंड़ाके अलग करनेवाला कोनो नइं रिहिस। एक झन ह दूसर ला अइसन मारिस कि ओह मर गीस। <verse eid="2SA 14:6" /><verse number="7" style="v" sid="2SA 14:7" />अब जम्मो कुल के मनखेमन तोर सेविका के बिरूध हो गे हवंय; ओमन कहत हें, ‘जऊन ह अपन भाई ला घात करे हवय, ओला हमर हांथ म सऊंप दे, ताकि ओला ओकर भाई के हतिया करे के बदला म मार डारन;’ यदि ओमन अइसे करहीं, त फेर हमर वारिस ह घलो खतम हो जाही। जऊन एके ठन मोर बरत कोइला बांचे हवय, ओमन ओला घलो बुता दीहीं, अऊ ये धरती म मोर घरवाला के न तो नांव रहिही अऊ न ही ओकर कोनो संतान बांचही।”<verse eid="2SA 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 14:8" />राजा ह ओ माईलोगन ला कहिस, “तें अपन घर जा, अऊ मेंह तोर बिसय म एक हुकूम दूहूं।”<verse eid="2SA 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 14:9" />पर तकोआ के ओ माईलोगन ह राजा ले कहिस, “मोर मालिक, राजा ह मोला अऊ मोर परिवार ला छेमा करय, अऊ राजा अऊ ओकर सिंघासन ह निरदोस ठहिरय।”<verse eid="2SA 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 14:10" />राजा ह कहिस, “यदि कोनो मनखे तोर ले कुछू बोलथे, त ओला मोर करा ले आबे, अऊ ओ मनखेमन तोला फेर नइं सताहीं।”<verse eid="2SA 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 14:11" />ओह कहिस, “राजा ह यहोवा अपन परमेसर ला सुरता करय कि खून के पलटा लेवइया ह अऊ नास करन झन पावय, अऊ मोर बेटा ला नास झन करे जावय।”</para>
  <para style="p" vid="2SA 14:11">राजा ह कहिस, “यहोवा के जिनगी के सपथ, तोर बेटा के एको ठन बाल भी बांका नइं होवय।”<verse eid="2SA 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 14:12" />तब माईलोगन ह कहिस, “तोर सेविका ह मोर मालिक राजा ले एक ठन अऊ बात कहे चाहत हे।”</para>
  <para style="p" vid="2SA 14:12">ओह कहिस, “गोठिया।”<verse eid="2SA 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 14:13" />ओ माईलोगन ह कहिस, “फेर तेंह परमेसर के मनखेमन के बिरूध अइसनेच उपाय काबर करे हस? जब राजा ह ये बात कहिथे, त का ओह खुद दोसी नइं ठहिरत हे, काबरकि राजा अपन निकाले गय बेटा ला लहुंटाके नइं लाय हवय? <verse eid="2SA 14:13" /><verse number="14" style="v" sid="2SA 14:14" />हमन ला तो मरनेच हे, अऊ हमन भुइयां म गिरे हुए पानी के असन ठहिरबो, जेला फेर उठाय नइं जा सकय। पर परमेसर ह ओ बात ला नइं चाहय; एकर बदले, ओह अइसन उपाय करथे कि निकाले गय मनखे हमेसा बर ओकर ले निकाले गय सहीं झन रहय।<verse eid="2SA 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 14:15" />“अऊ अब मेंह अपन मालिक राजा ले ये बात कहे बर आय हवंव, काबरकि मनखेमन मोला डरा देय रिहिन। तोर सेविका ह सोचिस, ‘में राजा ले बात करहूं; सायद ओह अपन सेविका के बिनती ला सुन ले। <verse eid="2SA 14:15" /><verse number="16" style="v" sid="2SA 14:16" />सायद राजा ह अपन सेविका ला ओ मनखे के हांथ ले छोंड़ाय के अनुमति देवय, जऊन ह मोला अऊ मोर बेटा दूनों ला परमेसर के भाग ले अलग करे के कोसिस करत हे।’<verse eid="2SA 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 14:17" />“अब तोर सेविका ह कहत हे, ‘मोर मालिक राजा के बचन ह मोर भाग ला सुनिस्चित करय, काबरकि मोर मालिक राजा ह परमेसर के कोनो स्वरगदूत के असन बने अऊ खराप बात म भेद कर सकथे। यहोवा तोर परमेसर ह तोर संग रहय।’ ”<verse eid="2SA 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 14:18" />तब राजा ह ओ माईलोगन ला कहिस, “जऊन बात मेंह तोर ले पुछनेवाला हंव, ओला मोर ले झन छुपाबे।”</para>
  <para style="p" vid="2SA 14:18">ओ माईलोगन ह कहिस, “मोर मालिक राजा ह पुछय।”<verse eid="2SA 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 14:19" />राजा ह पुछिस, “का ये जम्मो बात म तोर पाछू योआब के हांथ हवय?”</para>
  <para style="p" vid="2SA 14:19">माईलोगन ह जबाब देके कहिस, “हे मोर मालिक राजा, तोर जिनगी के सपथ, जऊन कुछू मोर मालिक राजा ह कहत हे, ओकर ले कोनो न तो जेवनी कोति मुड़ सकथे अऊ न ही डेरी कोति। हव, येह तोर सेवक योआब ए, जऊन ह मोला ये सब करे के हुकूम दे रिहिस, अऊ ओही ह ये जम्मो बात तोर सेविका ला सिखोय रिहिस। <verse eid="2SA 14:19" /><verse number="20" style="v" sid="2SA 14:20" />तोर सेवक योआब ह अभी के स्थिति ला बदले बर ये सब करिस। मोर मालिक करा परमेसर के एक स्वरगदूत सहीं बुद्धि हवय—ओह ओ हर चीज ला जानथे, जऊन ह धरती म होथे।”<verse eid="2SA 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 14:21" />तब राजा ह योआब ला कहिस, “बहुंत बढ़िया, मेंह ये काम करहूं। तेंह जा अऊ ओ जवान अबसालोम ला वापिस लेके आ।”<verse eid="2SA 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 14:22" />योआब ह राजा के आदर म भुइयां म मुहूं के बल गिरके ओला दंडवत करिस, अऊ ओह राजा ला आसीरबाद दीस। योआब ह कहिस, “हे मोर मालिक राजा, आज तोर सेवक ह जान गीस कि मोर ऊपर तोर दया-दिरिस्टी हवय, काबरकि राजा ह अपन सेवक के बिनती ला मान ले हवय।”<verse eid="2SA 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 14:23" />तब योआब ह उठके गसूर राज ला गीस अऊ अबसालोम ला वापिस यरूसलेम ले आईस। <verse eid="2SA 14:23" /><verse number="24" style="v" sid="2SA 14:24" />पर राजा ह कहिस, “ओह अपन खुद के घर म जावय; ओह मोर चेहरा झन देखय।” तब अबसालोम अपन घर म चल दीस, अऊ राजा के चेहरा नइं देखिस।<verse eid="2SA 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25" />जम्मो इसरायल म अबसालोम के सुघर देहें के जतेक परसंसा होवय, ओकर तुलना म अऊ कोनो के नइं होवत रिहिस। ओकर मुड़ ले लेके गोड़ तक, ओमा कुछू भी दोस नइं रिहिस। <verse eid="2SA 14:25" /><verse number="26" style="v" sid="2SA 14:26" />जब भी ओह अपन मुड़ के बाल ला कटवाय—ओह बछर म एक बार अपन बाल कटवात रिहिस, काबरकि येह ओकर बर बहुंत भारी हो जावय—ओह अपन बाल के तऊल करवाय, अऊ ओकर वजन साही तऊल के मुताबिक दू सौ सेकेल<note caller="+" style="f"><char style="fr" closed="false">14:26 </char><char style="ft" closed="false">लगभग 2.3 किलोग्राम</char></note> होवय।<verse eid="2SA 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 14:27" />अबसालोम के तीन बेटा अऊ एक बेटी होईन। ओकर बेटी के नांव तामार रिहिस, अऊ ओह एक सुघर माईलोगन होईस।<verse eid="2SA 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 14:28" />अबसालोम ह दू बछर तक राजा के चेहरा देखे बिगर यरूसलेम म रिहिस। <verse eid="2SA 14:28" /><verse number="29" style="v" sid="2SA 14:29" />तब अबसालोम ह योआब ला बुलवाईस ताकि ओला राजा दाऊद करा पठोवय, पर योआब ह ओकर मेर आय ले मना कर दीस। तब ओह ओला दूसर बार बलाय बर पठोईस, पर तब भी योआब ह आय ले मना कर दीस। <verse eid="2SA 14:29" /><verse number="30" style="v" sid="2SA 14:30" />तब अबसालोम ह अपन सेवकमन ला कहिस, “देखव, योआब के खेत ह मोर खेत ले लगे हवय, अऊ ओमा जौ के फसल लगे हवय। तुमन जाके ओमा आगी लगा दव।” तब अबसालोम के सेवकमन जाके ओ खेत म आगी लगा दीन।<verse eid="2SA 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 14:31" />तब योआब ह अबसालोम के घर गीस, अऊ ओह ओकर ले पुछिस, “तोर सेवकमन मोर खेत म काबर आगी लगाय हवंय?”<verse eid="2SA 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 14:32" />अबसालोम ह योआब ले कहिस, “देख, मेंह तोर मेर ये कहे बर मनखे पठोय रहेंव, ‘इहां आ कि मेंह तोला राजा करा ये पुछे बर पठोवंव, “मेंह गसूर ले काबर आयेंव? बने होतिस कि मेंह अब तक उहेंच रहितेंव!” ’ एकरसेति अब मेंह राजा के दरसन करे चाहत हंव, अऊ यदि मेंह कोनो बात के दोसी अंव, त ओह मोला मार डारय।”<verse eid="2SA 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 14:33" />तब योआब ह राजा करा गीस अऊ ओला ये बात बताईस। अऊ राजा ह अबसालोम ला बलाईस, अऊ ओह राजा करा गीस अऊ ओकर आघू म भुइयां म मुहूं के बल गिरके ओला दंडवत करिस। अऊ राजा ह अबसालोम ला चूमिस।<verse eid="2SA 14:33" /></para>
  <chapter eid="2SA 14" />
  <chapter number="15" style="c" sid="2SA 15" />
  <para style="s1">अबसालोम के साजिस</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1" />कुछू दिन के बाद, अबसालोम ह अपन बर रथ अऊ घोड़ामन अऊ अपन आघू-आघू दऊड़इया पचास झन मनखेमन ला रख लीस। <verse eid="2SA 15:1" /><verse number="2" style="v" sid="2SA 15:2" />अबसालोम ह बड़े बिहनियां उठके ओ सड़क के किनारे म ठाढ़ हो जावय, जऊन ह सहर के दुवार करा जावय। जब भी कोनो मनखे अपन सिकायत लेके राजा मेर आवत दिखय, त अबसालोम ह ओला आरो लगाके पुछय, “तेंह कोन नगर ले आवत हस?” जब ओ मनखे ह कहय, “तोर सेवक ह इसरायल के एक गोत्र म के अय।” <verse eid="2SA 15:2" /><verse number="3" style="v" sid="2SA 15:3" />तब अबसालोम ह ओला कहय, “देख, तोर सिकायत ह सही अऊ उचित अय, पर तोर बात ला सुने बर राजा कोति ले कोनो मनखे नइं ए।” <verse eid="2SA 15:3" /><verse number="4" style="v" sid="2SA 15:4" />अऊ अबसालोम ह ये घलो कहय, “बने होतिस कि सिरिप मेंह ये देस म नियायी ठहिराय जातेंव! तब हर एक मनखे मोर करा अपन सिकायत या मामला ला लेके आतिन, अऊ मेंह देखतेंव कि ओमन ला नियाय मिलतिस।”<verse eid="2SA 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 15:5" />अबसालोम ह ये घलो करय कि जब भी कोनो मनखे झुकके ओला दंडवत करे बर ओकर करा आवय, त ओह अपन हांथ बढ़ाय अऊ ओला पकड़के चूम लेवय। <verse eid="2SA 15:5" /><verse number="6" style="v" sid="2SA 15:6" />जतेक इसरायलीमन राजा करा नियाय मांगे बर आवंय, ओ जम्मो के संग अबसालोम के अइसनेच बेवहार रहय, अऊ ये किसम ले अबसालोम ह इसरायली मनखेमन के मन ला जीत लीस।<verse eid="2SA 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 15:7" />चार<note caller="+" style="f"><char style="fr" closed="false">15:7 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">चालीस लिखाय हवय</char></note> बछर के आखिरी म, अबसालोम ह राजा ले कहिस, “मोला हेबरोन जावन दे कि यहोवा ले माने गय मन्नत ला पूरा कर सकंव। <verse eid="2SA 15:7" /><verse number="8" style="v" sid="2SA 15:8" />जब तोर सेवक ह अराम के गसूर म रहत रिहिस, तब ये मन्नत माने रिहिस: ‘यदि यहोवा ह मोला वापिस यरूसलेम ले जाथे, त मेंह यहोवा के उपासना हेबरोन<note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fq" closed="false">हेबरोन </char><char style="ft" closed="false">नइं ए</char></note> म करहूं।’ ”<verse eid="2SA 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 15:9" />राजा ह ओला कहिस, “सांति से जा।” अऊ ओह हेबरोन चल दीस।<verse eid="2SA 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 15:10" />तब अबसालोम ह इसरायल के जम्मो गोत्रमन म ये कहे बर गुपत संदेसियामन ला पठोईस, “जइसे ही तुमन तुरहीमन के अवाज सुनव, त कहव, ‘अबसालोम ह हेबरोन के राजा बन गीस।’ ” <verse eid="2SA 15:10" /><verse number="11" style="v" sid="2SA 15:11" />यरूसलेम ले दू सौ मनखे अबसालोम के संग गे रिहिन। ओमन ला पहुना के रूप म नेवता देय गे रिहिस अऊ ओमन सीधवा मन ले बिगर कोनो बात ला जाने उहां गे रिहिन। <verse eid="2SA 15:11" /><verse number="12" style="v" sid="2SA 15:12" />जब अबसालोम ह बलिदान चघात रिहिस, त ओह दाऊद के सलाहकार, गीलोनी अहीतोपेल ला घलो बुलवाईस कि ओह अपन नगर गीलो ले आवय। अऊ ये किसम ले साजिस ह अऊ मजबूत होईस, अऊ अबसालोम के तरफ के मनखेमन के गनती बराबर बाढ़त गीस।<verse eid="2SA 15:12" /></para>
  <para style="s1">दाऊद के यरूसलेम ले भगई</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13" />एक संदेसिया ह आके दाऊद ला बताईस, “इसरायली मनखेमन के मन ह अबसालोम कोति हो गे हवय।”<verse eid="2SA 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 15:14" />तब दाऊद ह अपन ओ जम्मो करमचारीमन ले कहिस, जेमन ओकर संग यरूसलेम म रिहिन, “आवव! हमन भाग चलन; नइं तो हमन म ले कोनो भी अबसालोम के हांथ ले नइं बांचही। हमन ला तुरते भागना पड़ही, नइं तो ओह बहुंत जल्दी आके हमन ला घेर लीही, अऊ हमर नुकसान करही अऊ ये नगर के मनखेमन ला तलवार ले मार डारही।”<verse eid="2SA 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 15:15" />राजा के करमचारीमन ओला जबाब दीन, “जइसने हमर मालिक राजा ह कहिही, वइसने हमन तोर सेवकमन करे बर तियार हवन।”<verse eid="2SA 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 15:16" />तब राजा ह निकल गीस, अऊ ओकर संग ओकर पूरा घराना घलो चल दीस; पर ओह दस रखैलमन ला महल के देखरेख करे बर छोंड़ दीस। <verse eid="2SA 15:16" /><verse number="17" style="v" sid="2SA 15:17" />राजा ह निकल गीस, अऊ ओकर पाछू-पाछू जम्मो मनखेमन घलो चल दीन, अऊ ओमन सहर के तीर म जाके रूक गीन। <verse eid="2SA 15:17" /><verse number="18" style="v" sid="2SA 15:18" />ओकर जम्मो आदमीमन ओकर सामने ले होके आघू बढ़ गीन; ओमन के संग म जम्मो करेती अऊ पलेतीमन अऊ ओ जम्मो छै सौ गतीमन घलो रिहिन, जेमन गत ले ओकर संग आय रिहिन; ओमन जम्मो राजा के आघू म चलिन।<verse eid="2SA 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 15:19" />तब राजा दाऊद ह गत के निवासी इत्तै ले पुछिस, “हमर संग तेंह काबर चलत हस? वापिस जा अऊ राजा अबसालोम के संग रह। तेंह एक परदेसी बंधुवा अस अऊ अपन देस ले बाहिर रहत हस। <verse eid="2SA 15:19" /><verse number="20" style="v" sid="2SA 15:20" />तेंह तो कल ही आय हस। अऊ का आज ही मेंह तोला हमर संग एती-ओती भटकावंव, जबकि मेंह खुद नइं जानत हंव कि मेंह कहां जावत हंव? तें लहुंट जा, अऊ अपन संग अपन मनखेमन ला घलो ले जा। यहोवा ह तोर ऊपर दया अऊ मया देखावय।”<verse eid="2SA 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 15:21" />पर इत्तै ह राजा ला जबाब दीस, “यहोवा के जिनगी के सपथ, अऊ मोर मालिक राजा के जिनगी के सपथ, जिहां कहूं मोर मालिक राजा ह रहिही, चाहे मरे या जीये के बात घलो होवय, उहां तोर सेवक तोर संग रहिही।”<verse eid="2SA 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 15:22" />तब दाऊद ह इत्तै ला कहिस, “ठीक हे, आघू बढ़।” तब गती इत्तै ह अपन जम्मो आदमी अऊ ओमन के परिवार के मनखेमन संग आघू बढ़िस।<verse eid="2SA 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 15:23" />गांव-गंवई के जम्मो मनखेमन चिचिया-चिचियाके रोईन, जब जम्मो मनखेमन उहां ले होके गीन। राजा घलो किदरोन घाटी ला पार करिस, अऊ जम्मो मनखेमन निरजन जगह कोति बढ़ गीन।<verse eid="2SA 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 15:24" />सादोक ह घलो उहां रिहिस, अऊ ओकर संग के जम्मो लेवीमन परमेसर के करार के सन्दूक ला उठाके ले जावत रिहिन। ओमन परमेसर के सन्दूक ला खाल्हे धर दीन; तब अबियातार ह बलिदान चघाईस, जब तक कि जम्मो मनखेमन सहर ले नइं निकल गीन।<verse eid="2SA 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 15:25" />तब राजा ह सादोक ला कहिस, “परमेसर के सन्दूक ला वापिस सहर म ले जा। यदि यहोवा के अनुग्रह के नजर मोर ऊपर होही, त ओह मोला लहुंटाके लानही अऊ येला अऊ ओकर निवास स्थान ला फेर देखाही। <verse eid="2SA 15:25" /><verse number="26" style="v" sid="2SA 15:26" />पर यदि ओह कहिथे, ‘मेंह तोर ले खुस नइं अंव,’ तब मेंह तियार हंव, जइसने ओला उचित लगय, वइसने ओह मोर संग करय।”<verse eid="2SA 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 15:27" />राजा ह सादोक पुरोहित ला ये घलो कहिस, “का तेंह समझत हस? मोर आसीस के संग वापिस सहर चले जा। अपन संग अपन बेटा अहीमास, अऊ अबियातार के बेटा योनातन ला घलो ले जा। तें अऊ अबियातार अपन-अपन बेटा संग लहुंट जावव। <verse eid="2SA 15:27" /><verse number="28" style="v" sid="2SA 15:28" />मेंह निरजन जगह के पानी के घाट म तब तक इंतजार करहूं, जब तक कि तोर खबर मोला नइं मिल जाही।” <verse eid="2SA 15:28" /><verse number="29" style="v" sid="2SA 15:29" />तब सादोक अऊ अबियातार, परमेसर के सन्दूक ला वापिस यरूसलेम ले गीन अऊ उहां रूक गीन।<verse eid="2SA 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30" />पर दाऊद ह जैतून पहाड़ ऊपर चढ़त गीस, अऊ चलत-चलत ओह रोवत रिहिस; ओकर मुड़ ह ढंके रिहिस अऊ ओह खाली गोड़ रिहिस। ओकर संग के जम्मो मनखेमन घलो अपन-अपन मुड़ ला ढांके रहंय अऊ चलत-चलत रोवत रहंय। <verse eid="2SA 15:30" /><verse number="31" style="v" sid="2SA 15:31" />दाऊद ला ये बताय गे रिहिस, “अबसालोम के संग साजिस करइयामन म अहीतोपेल घलो हवय।” एकरसेति दाऊद ह पराथना करिस, “हे यहोवा, अहीतोपेल के सलाह ला मुरूखता म बदल दे।”<verse eid="2SA 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 15:32" />जब दाऊद ह पहाड़ के चोटी म हबर गीस, जिहां मनखेमन परमेसर के अराधना करंय, त उहां ओकर ले मिले बर अरकी हूसै आय रिहिस अऊ ओकर ओनहा ह फटे रहय अऊ सोकित मनखे सहीं मुड़ म धुर्रा रहय। <verse eid="2SA 15:32" /><verse number="33" style="v" sid="2SA 15:33" />दाऊद ह ओला कहिस, “यदि तेंह मोर संग जाबे, त तेंह मोर बर एक बोझा सहीं होबे। <verse eid="2SA 15:33" /><verse number="34" style="v" sid="2SA 15:34" />पर यदि तेंह सहर ला वापिस जाके अबसालोम ला कहिबे, ‘हे महाराज, मेंह तोर एक सेवक होहूं; जइसे मेंह पहिले तोर ददा के सेवक रहेंव, पर अब में तोर सेवक होहूं,’ तब तेंह अहीतोपेल के सलाह ला असफल करके मोर मदद कर सकत हस। <verse eid="2SA 15:34" /><verse number="35" style="v" sid="2SA 15:35" />उहां तोर संग सादोक अऊ अबियातार पुरोहित घलो होहीं? राजा के महल म जऊन कुछू भी तेंह सुनथस, ओ बात तें ओमन ला बता देबे। <verse eid="2SA 15:35" /><verse number="36" style="v" sid="2SA 15:36" />ओमन के दू झन बेटा, याने कि सादोक के बेटा अहीमास, अऊ अबियातार के बेटा योनातन घलो उहां ओमन के संग हवंय। जऊन भी बात तें उहां सुनथस, ओकर खबर मोला ओमन के दुवारा पठो देबे।”<verse eid="2SA 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 15:37" />तब दाऊद के भरोसावाला मनखे, हूसै ह यरूसलेम सहर हबरिस, जब अबसालोम ह सहर के भीतर जावत रिहिस।<verse eid="2SA 15:37" /></para>
  <chapter eid="2SA 15" />
  <chapter number="16" style="c" sid="2SA 16" />
  <para style="s1">दाऊद अऊ सीबा</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1" />जब दाऊद ह पहाड़ के चोटी ले थोरकन आघू बढ़े रिहिस कि ओला मपीबोसेत के करमचारी सीबा ह मिलिस, जऊन ह राजा ले मिले बर आय रिहिस। ओकर करा सामान से लदे गदहामन रहंय अऊ ओमा दू सौ रोटी, किसमिस के एक सौ टिकिया, अंजीर के एक सौ टिकिया अऊ अंगूर के मंद ले भरे चमड़ा के एक थैली रहय।<verse eid="2SA 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 16:2" />राजा ह सीबा ले पुछिस, “तेंह काबर येमन ला लाने हस?”</para>
  <para style="p" vid="2SA 16:2">सीबा ह जबाब दीस, “गदहामन त राजा के घराना के सवारी बर, रोटी अऊ फर ह आदमीमन के खाय बर, अऊ अंगूर के मंद ह ओमन ला तरो-ताजा करे बर अय, जेमन निरजन प्रदेस म थक जाहीं।”<verse eid="2SA 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 16:3" />तब राजा ह पुछिस, “तोर मालिक के पोता<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बेटा</char></note> कहां हवय?”</para>
  <para style="p" vid="2SA 16:3">सीबा ह राजा ला जबाब दीस, “ओह यरूसलेम म हवय, काबरकि ओह सोचथे, ‘आज इसरायलीमन मोला मोर डोकरा ददा के राज फेर वापिस कर दीहीं।’ ”<verse eid="2SA 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 16:4" />तब राजा ह सीबा ला कहिस, “जऊन कुछू मपीबोसेत के रिहिस, ओ जम्मो चीज अब तोर अय।”</para>
  <para style="p" vid="2SA 16:4">सीबा ह कहिस, “हे मोर मालिक राजा, में तोर दंडवत करत हंव, मोर ऊपर तोर अनुग्रह के नजर बने रहय।”<verse eid="2SA 16:4" /></para>
  <para style="s1">सिमी ह दाऊद ला सराप देथे</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5" />जब दाऊद राजा बहूरीम नगर म हबरिस, त साऊल के परिवार के कुल म ले एक मनखे उहां ले निकलिस, ओकर नांव सिमी रिहिस अऊ ओह गेरा के बेटा रिहिस, अऊ ओह दाऊद ला सराप देवत बाहिर निकलिस। <verse eid="2SA 16:5" /><verse number="6" style="v" sid="2SA 16:6" />ओह दाऊद अऊ दाऊद राजा के जम्मो करमचारीमन ऊपर पथरा फेंकत रिहिस, हालाकि जम्मो सेना अऊ बिसेस पहरेदारमन दाऊद के जेवनी अऊ डेरी दूनों कोति रिहिन। <verse eid="2SA 16:6" /><verse number="7" style="v" sid="2SA 16:7" />सिमी ह सराप देवत कहिस, “दूरिहा हट, हे हतियारा, दूरिहा हट, हे दुस्ट! <verse eid="2SA 16:7" /><verse number="8" style="v" sid="2SA 16:8" />यहोवा ह तोर ले साऊल के घराना के जम्मो खून के बदला लेय हवय, जेकर जगह म तेंह राज करत हस। यहोवा ह राज ला तोर बेटा अबसालोम के हांथ म कर देय हवय। तेंह बरबाद होवत हस काबरकि तेंह हतियारा अस!”<verse eid="2SA 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 16:9" />तब सरूयाह के बेटा अबीसै ह राजा ले कहिस, “ये मरे कुकुर ह मोर मालिक राजा ला काबर सराप देवय? मोला उहां जावन दे कि मेंह ओकर मुड़ ला काटके अलग कर दंव।”<verse eid="2SA 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 16:10" />पर राजा ह कहिस, “हे सरूयाह के बेटामन, तुमन ला एकर से कुछू लेना-देना नइं ए? ओह सराप देवत हे, काबरकि यहोवा ह ओकर ले कहे हवय, ‘दाऊद ला सराप दे,’ त ओकर ले कोन पुछ सकथे, ‘तेंह अइसन काबर करत हस?’ ”<verse eid="2SA 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 16:11" />तब दाऊद ह अबीसै अऊ अपन जम्मो करमचारीमन ले कहिस, “जब मोर बेटा, मोर खुद के मांस अऊ खून ह मोला मार डारे के कोसिस करत हे, त फेर ये बिनयामीनी ह अइसन काबर नइं करही? ओला रहन दव, अऊ सराप देवन दव, काबरकि यहोवा ह ओला अइसन करे बर कहे हवय। <verse eid="2SA 16:11" /><verse number="12" style="v" sid="2SA 16:12" />हो सकत हे कि यहोवा ह मोर दुरगति ला देखय अऊ आज ओकर सराप के बदले मोला ओकर करार के आसीस फेर मिलय।”<verse eid="2SA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 16:13" />तब दाऊद अऊ ओकर आदमीमन रसता म आघू बढ़त गीन जबकि सिमी ह ओकर उल्टा पहाड़ के तीरे-तीर जावत रिहिस अऊ जावत-जावत ओह दाऊद ला सराप देवत रिहिस अऊ ओकर ऊपर पथरा अऊ धुर्रा घलो फेंकत रिहिस। <verse eid="2SA 16:13" /><verse number="14" style="v" sid="2SA 16:14" />जब राजा अऊ ओकर जम्मो मनखेमन अपन ठिकाना म हबरिन, त ओमन थक गे रिहिन। अऊ उहां राजा ह बिसराम करिस।<verse eid="2SA 16:14" /></para>
  <para style="s1">अहीतोपेल अऊ हूसै के सलाह</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15" />इही बीच म, अबसालोम ह इसरायल के जम्मो आदमीमन संग यरूसलेम आ गीस, अऊ ओकर संग अहीतोपेल घलो रिहिस। <verse eid="2SA 16:15" /><verse number="16" style="v" sid="2SA 16:16" />तब दाऊद के बिसवासयोग्य मनखे, अरकी हूसै ह अबसालोम मेर जाके नरियाईस, “राजा चिरंजीव रहय! राजा चिरंजीव रहय!”<verse eid="2SA 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 16:17" />अबसालोम ह हूसै ला कहिस, “का येह तोर मया अय, जेला तेंह अपन संगी बर देखात हस? यदि ओह तोर संगी अय, त फेर तें ओकर संग काबर नइं गेय?”<verse eid="2SA 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 16:18" />हूसै ह अबसालोम ला जबाब दीस, “अइसन नो हय, जऊन ला यहोवा, ये मनखेमन, अऊ इसरायल के जम्मो आदमीमन चुने हवंय, ओकर मेंह संगी अंव, अऊ ओकरे संग मेंह रहिहूं। <verse eid="2SA 16:18" /><verse number="19" style="v" sid="2SA 16:19" />अऊ फेर मेंह काकर सेवा करंव? का में ओकर बेटा के सेवा नइं करंव? जइसने मेंह तोर ददा के सेवा करत रहेंव, वइसने ही तोर सेवा करहूं।”<verse eid="2SA 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 16:20" />तब अबसालोम ह अहीतोपेल ला कहिस, “तेंह अपन सलाह दे। हमन ला का करना चाही?”<verse eid="2SA 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 16:21" />अहीतोपेल ह जबाब देवत कहिस, “तें अपन ददा के ओ रखैलमन संग सुत, जेमन ला तोर ददा ह महल के देखरेख करे बर छोंड़ दे हवय। तब जम्मो इसरायलीमन सुनहीं कि तेंह अपनआप ला अपन ददा के नजर म घिनौना बना ले हस, अऊ जेमन तोर संग रहिहीं ओमन अऊ हिम्मती हो जाहीं।” <verse eid="2SA 16:21" /><verse number="22" style="v" sid="2SA 16:22" />तब ओमन अबसालोम बर महल के छत म एक तम्बू गाड़िन, अऊ अबसालोम ह जम्मो इसरायलीमन के देखत अपन ददा के रखैलमन संग सुतिस।<verse eid="2SA 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 16:23" />ओ समय म, जऊन सलाह अहीतोपेल ह देवत रिहिस, ओह अइसन होवत रिहिस कि मानो कोनो मनखे ह परमेसर ले पुछके सलाह देवत हे। दाऊद अऊ अबसालोम दूनों अहीतोपेल के जम्मो सलाह ला अइसने ही समझंय।<verse eid="2SA 16:23" /></para>
  <chapter eid="2SA 16" />
  <chapter number="17" style="c" sid="2SA 17" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1" />ओकर बाद अहीतोपेल ह अबसालोम ला कहिस, “मोला बारह हजार मनखे ला छांटन देय, अऊ मेंह उठके आजेच रथिया दाऊद के पीछा करहूं। <verse eid="2SA 17:1" /><verse number="2" style="v" sid="2SA 17:2" />जब दाऊद ह थके-मांदे अऊ निरबल होही, तभे मेंह ओकर ऊपर हमला करहूं। मेंह ओला आतंकित कर दूहूं, अऊ तब ओकर संग के जम्मो मनखेमन भाग जाहीं। मेंह सिरिप राजा ही ला मारहूं <verse eid="2SA 17:2" /><verse number="3" style="v" sid="2SA 17:3" />अऊ जम्मो मनखेमन ला वापिस तोर करा ले आहूं। जऊन मनखे ला तेंह खोजत हस, ओकर मिरतू के मतलब होही—जम्मो मनखेमन के वापिस लहुंटई; जम्मो मनखेमन सही-सलामत होहीं।” <verse eid="2SA 17:3" /><verse number="4" style="v" sid="2SA 17:4" />ये बात ह अबसालोम अऊ इसरायल के जम्मो अगुवामन ला सही लगिस।<verse eid="2SA 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5" />फेर अबसालोम ह कहिस, “अरकी हूसै ला घलो बलाके लानव, ताकि ओकर बात ला घलो हमन सुनन कि ओह का कहिथे।” <verse eid="2SA 17:5" /><verse number="6" style="v" sid="2SA 17:6" />जब हूसै ह अबसालोम मेर आईस, त अबसालोम ह ओकर ले कहिस, “अहीतोपेल ह ये सलाह दे हवय। जऊन बात ओह कहत हे, का हमन ला करना चाही? यदि नइं, त फेर तोर का बिचार ए, हमन ला बता।”<verse eid="2SA 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 17:7" />हूसै ह अबसालोम ला जबाब दीस, “जऊन सलाह अहीतोपेल ह ये बखत दे हवय, ओह सही नो हय। <verse eid="2SA 17:7" /><verse number="8" style="v" sid="2SA 17:8" />तेंह तो अपन ददा अऊ ओकर आदमीमन ला जानत हस; ओमन योद्धा अंय, अऊ अपन पीला छीने गय जंगली भालू सहीं भयंकर कोरोधित होहीं। एकर अलावा, तोर ददा ह एक अनुभवी योद्धा अय; ओह सेना के दलमन के संग रात नइं बितावय। <verse eid="2SA 17:8" /><verse number="9" style="v" sid="2SA 17:9" />अऊ त अऊ अभी घलो ओह कोनो गुफा या कोनो आने जगह म लुकाय होही। यदि ओह पहिले हमला करथे, त जऊन ह भी ये बात ला सुनही, ओह कहिही, ‘अबसालोम के सेना के बहुंते जन मारे गे हवंय।’ <verse eid="2SA 17:9" /><verse number="10" style="v" sid="2SA 17:10" />तब सबले हिम्मती सैनिक घलो, जेकर हिरदय सिंह के असन होथे, डर के मारे टघल जाही, काबरकि पूरा इसरायल जानत हे कि तोर ददा ह एक योद्धा अय, अऊ जऊन मन ओकर संग हवंय, ओमन हिम्मती अंय।<verse eid="2SA 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 17:11" />“एकरसेति मोर सलाह ये अय: दान सहर ले लेके बेरसेबा सहर तक जम्मो इसरायलीमन, जेमन समुंदर तीर के बालू सहीं अनगिनत हवंय, येमन तोर करा इकट्ठा होवंय, अऊ तें खुद लड़ई म ओमन के अगुवई कर। <verse eid="2SA 17:11" /><verse number="12" style="v" sid="2SA 17:12" />तब जिहां कहूं भी ओह मिलही, हमन ओकर ऊपर हमला करबो, अऊ हमन ओकर ऊपर अइसे टूट पड़बो, जइसे भुइयां म ओस गिरथे। तब न तो ओ अऊ न ही ओकर आदमीमन ले कोनो बांचहीं। <verse eid="2SA 17:12" /><verse number="13" style="v" sid="2SA 17:13" />यदि ओह कोनो सहर म चले जाथे, त जम्मो इसरायलीमन ओ सहर म रस्सी ले आहीं, अऊ हमन सहर ला घाटी म घसीटके ले आबो, इहां तक कि उहां एक ठन कंकड़ घलो नइं बांचही।”<verse eid="2SA 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 17:14" />तब अबसालोम अऊ इसरायल के जम्मो आदमीमन कहिन, “अरकी हूसै के सलाह अहीतोपेल के सलाह ले उत्तम अय।” काबरकि यहोवा ह अहीतोपेल के सही सलाह ला असफल करे के ठान लेय रिहिस, ताकि ओह अबसालोम के ऊपर बिपत्ति लानय।<verse eid="2SA 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15" />तब हूसै ह सादोक अऊ अबियातार पुरोहितमन ले कहिस, “अहीतोपेल ह अबसालोम अऊ इसरायल के अगुवामन ला ये किसम के सलाह देय हवय, पर मेंह ओमन ला अइसे-अइसे करे बर कहे हवंव। <verse eid="2SA 17:15" /><verse number="16" style="v" sid="2SA 17:16" />अब तुमन दाऊद करा खबर पठोके ओला बतावव, ‘आज रथिया निरजन जगह के पानी के तीर म झन ठहिरव; बिगर रूके ओ पार चल दव, नइं तो राजा अऊ ओकर संग के जम्मो मनखेमन नास हो जाहीं।’ ”<verse eid="2SA 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 17:17" />योनातन अऊ अहीमास ह एन-रोगेल के नरवा करा ठहिरे रिहिन। एक सेविका ला जाके ओमन ला बताना रिहिस, अऊ ओमन ला जाके राजा दाऊद ला बताना रिहिस, काबरकि ओमन काकरो देखत म सहर के भीतर जाय के जोखिम नइं उठा सकत रिहिन। <verse eid="2SA 17:17" /><verse number="18" style="v" sid="2SA 17:18" />पर एक दिन एक जवान मनखे ह ओमन ला देख डारिस अऊ जाके अबसालोम ला बताईस। एकरसेति ओ दूनों तुरते उहां ले चल दीन अऊ बहूरीम म एक मनखे के घर म गीन। ओ मनखे के अंगना म एक ठन कुआं रिहिस अऊ ओमन ओ कुआं म उतरके छिप गीन। <verse eid="2SA 17:18" /><verse number="19" style="v" sid="2SA 17:19" />ओ मनखे के घरवाली ह एक ठन कपड़ा लेके कुआं के ऊपर बिछा दीस अऊ ओमा अनाज ला फईला दीस। एकर बारे म कोनो कुछू नइं जानत रिहिन।<verse eid="2SA 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 17:20" />जब अबसालोम के जवानमन ओ घर म ओ माईलोगन करा आईन, त ओमन पुछिन, “अहीमास अऊ योनातन कहां हवंय?”</para>
  <para style="p" vid="2SA 17:20">तब माईलोगन ह ओमन ला जबाब दीस, “ओमन तो नरवा के ओ पार चल दीन।” तब ओ आदमीमन ओ दूनों ला खोजिन, पर ओ दूनों ओमन ला नइं मिलिन, तब अबसालोम के आदमीमन यरूसलेम लहुंट गीन।<verse eid="2SA 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 17:21" />जब ओमन चल दीन, तब अहीमास अऊ योनातन दूनों कुआं ले निकलिन अऊ जाके दाऊद राजा ला खबर दीन। ओमन दाऊद ला कहिन, “तुमन आघू बढ़व अऊ तुरते नदी के ओ पार चले जावव; काबरकि अहीतोपेल ह राजा के बिरूध अइसन-अइसन सलाह देय हवय।” <verse eid="2SA 17:21" /><verse number="22" style="v" sid="2SA 17:22" />तब दाऊद अऊ ओकर संग के जम्मो मनखेमन आघू बढ़िन अऊ यरदन नदी के ओ पार चल दीन। बिहनियां होवत तक ओमन के जम्मो झन यरदन नदी के ओ पार हो गीन।<verse eid="2SA 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 17:23" />जब अहीतोपेल ह देखिस कि ओकर सलाह के मुताबिक काम नइं करे गे हवय, त ओह अपन गदहा म काठी ला कसिस, अऊ अपन नगर म अपन घर कोति निकल गीस। ओह अपन घर ला ब्यवस्थित करिस अऊ तब फांसी लगा लीस। ये किसम ले ओह मर गीस अऊ ओकर ददा के कबर म ओला माटी देय गीस।<verse eid="2SA 17:23" /></para>
  <para style="s1">अबसालोम के मिरतू</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 17:24" />तब दाऊद ह महनैम नगर म हबरिस, अऊ अबसालोम ह इसरायल के जम्मो आदमीमन के संग यरदन नदी ला पार करिस। <verse eid="2SA 17:24" /><verse number="25" style="v" sid="2SA 17:25" />अबसालोम ह अमासा ला योआब के जगह म सेना के सेनापति ठहिराय रिहिस। अमासा ह एक इसमायली मनखे के बेटा रिहिस, जेकर नांव येतेर रिहिस, अऊ ओह अबीगैल ले बिहाव करे रिहिस; अबीगैल ह नाहास के बेटी अऊ सरूयाह के बहिनी अऊ योआब के दाई रिहिस। <verse eid="2SA 17:25" /><verse number="26" style="v" sid="2SA 17:26" />इसरायलीमन अऊ अबसालोम गिलाद देस म डेरा डाले रिहिन।<verse eid="2SA 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 17:27" />जब दाऊद ह महनैम म आईस, तब अमोनीमन के रब्बा सहर के निवासी नाहास के बेटा सोबी, अऊ लो-देबार के निवासी अमीएल के बेटा माकीर, अऊ रोगलीम नगरवासी गिलादी बरजिलै, <verse eid="2SA 17:27" /><verse number="28" style="v" sid="2SA 17:28" />बिस्तर, कटोरा, माटी के बरतन लेके आईन। ओमन गहूं अऊ जौ, पीसान अऊ भुने अनाज, सेमी अऊ दाल, <verse eid="2SA 17:28" /><verse number="29" style="v" sid="2SA 17:29" />मंधरस, दही, भेड़, अऊ गाय के दूध के पनीर घलो दाऊद अऊ ओकर मनखेमन के खाय बर ले आईन। काबरकि ओमन सोचत रिहिन, “निरजन जगह म ओ मनखेमन थक गे होहीं अऊ भूखन-पियासन घलो होहीं।”<verse eid="2SA 17:29" /></para>
  <chapter eid="2SA 17" />
  <chapter number="18" style="c" sid="2SA 18" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1" />राजा दाऊद ह अपन संग के आदमीमन ला इकट्ठा करिस अऊ ओमन ला हजार-हजार अऊ सौ-सौ मनखेमन के ऊपर सेनापति ठहिरा दीस। <verse eid="2SA 18:1" /><verse number="2" style="v" sid="2SA 18:2" />तब दाऊद ह अपन सेना के एक तिहाई ला योआब के, अऊ एक तिहाई ला सरूयाह के बेटा, योआब के भाई अबीसै के, अऊ एक तिहाई ला गती इत्तै के अधीन म करके पठो दीस। राजा ह सेना के मनखेमन ला कहिस, “मेंह घलो जरूर तुम्हर संग चलहूं।”<verse eid="2SA 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 18:3" />पर आदमीमन कहिन, “नइं, तोला बिलकुल ही नइं जाना हे; यदि हमन ला उहां भागे बर पड़य, त ओमन हमर चिंता नइं करहीं। अऊ त अऊ यदि हमन आधा मनखे घलो मारे जाथन, तभो ले ओमन चिंता नइं करंय; पर तेंह हमर सहीं दस हजार मनखे के बरोबर अस। एकरसेति येह सही होही कि तेंह सहर ले हमन ला मदद कर।”<verse eid="2SA 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 18:4" />राजा ह जबाब दीस, “जऊन कुछू तुमन ला बने लगय, मेंह ओही काम करहूं।”</para>
  <para style="p" vid="2SA 18:4">तब राजा ह दुवार के एक कोति ठाढ़ हो गीस, अऊ ओकर जम्मो आदमीमन सौ-सौ अऊ हजार-हजार के दल म निकलत गीन। <verse eid="2SA 18:4" /><verse number="5" style="v" sid="2SA 18:5" />राजा ह योआब, अबीसै अऊ इत्तै ला हुकूम दीस, “मोर खियाल रखके ओ जवान अबसालोम के संग नमरता से बरताव करहू।” अऊ राजा ह अबसालोम के बारे म सेनापतिमन ला जऊन हुकूम देवत रिहिस, ओला सेना के जम्मो मनखेमन सुनिन।<verse eid="2SA 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 18:6" />दाऊद के सेना इसरायल के बिरूध लड़े बर बाहिर निकलिस, अऊ एपरैम के जंगल म ओमन के बीच लड़ई होईस। <verse eid="2SA 18:6" /><verse number="7" style="v" sid="2SA 18:7" />उहां इसरायल के सेना ह दाऊद के आदमीमन ले हार गीस, अऊ ओ दिन बहुंत आदमी मारे गीन—बीस हजार आदमी। <verse eid="2SA 18:7" /><verse number="8" style="v" sid="2SA 18:8" />लड़ई ह ओ जम्मो देहात छेत्र म फईल गीस, अऊ ओ दिन जतेक आदमी तलवार ले मारे गीन, ओकर ले जादा आदमी जंगल के कारन मर गीन।<verse eid="2SA 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 18:9" />अइसने होईस कि अबसालोम के मुलाकात राजा दाऊद के आदमीमन संग हो गीस। अबसालोम ह एक खच्चर म चघके जावत रिहिस, अऊ जब खच्चर ह एक बड़े बलूत रूख के घना डारामन के खाल्हे ले होके गीस, त अबसालोम के मुड़ के बाल ह रूख म फंस गीस। ओह अधर म लटक गीस, जबकि ओकर खच्चर ह आघू निकल गीस।<verse eid="2SA 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 18:10" />जब एक आदमी ह येला देखिस, त ओह योआब ला बताईस, “मेंह अभी-अभी अबसालोम ला एक ठन बलूत रूख म टंगे देखे हंव।”<verse eid="2SA 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 18:11" />तब योआब ह ओ खबर देवइया मनखे ला कहिस, “का! तें ओला देखे हस? फेर काबर तें ओला उहां मारके भुइयां म नइं गिरा देय? तब मेंह तोला चांदी के दस सेकेल<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">लगभग 115 ग्राम</char></note> अऊ एक ठन योद्धा के पट्टा देय रहितेंव।”<verse eid="2SA 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 18:12" />पर ओ मनखे ह योआब ला जबाब दीस, “अऊ त अऊ यदि तें मोला एक हजार सेकेल तऊलके देय रहितेय, तभो ले मेंह राजा के बेटा ऊपर हांथ नइं उठाय रहितेंव। काबरकि हमर सुनत म, राजा ह तोला अऊ अबीसै अऊ इत्तै ला ये हुकूम देय रिहिस, ‘मोर खियाल रखके ओ जवान अबसालोम ला कुछू झन करहू।’ <verse eid="2SA 18:12" /><verse number="13" style="v" sid="2SA 18:13" />अऊ यदि मेंह परान ला संकट म डाले रहितेंव<note caller="+" style="f"><char style="fr" closed="false">18:13 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यदि ओकर प्रति बिसवासघात करे रहितेंव</char></note>—त तेंह खुद मोर बिरोधी हो जाते, काबरकि राजा ले कोनो बात छिपे नइं ए।”<verse eid="2SA 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 18:14" />योआब ह कहिस, “मेंह तोर संग अइसनेच ठहिरे नइं रह सकंव।” तब ओह अपन हांथ म तीन ठन भाला लीस अऊ ओमन ला अबसालोम के हिरदय म भोंग दीस, जब अबसालोम ह बलूत रूख म लटके रिहिस अऊ जीयत रिहिस। <verse eid="2SA 18:14" /><verse number="15" style="v" sid="2SA 18:15" />अऊ योआब के दस हथियार ढोवइयामन अबसालोम ला घेरके ओकर ऊपर हमला करिन अऊ ओला मार डारिन।<verse eid="2SA 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 18:16" />फेर योआब ह तुरही ला फूंकिस, अऊ सेना के मनखेमन इसरायल<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">इसरायल के सैनिकमन</char></note> के पीछा करई छोंड़ दीन, काबरकि योआब ह ओमन ला रोक ले रिहिस। <verse eid="2SA 18:16" /><verse number="17" style="v" sid="2SA 18:17" />तब ओमन अबसालोम ला लीन अऊ जंगल के एक बड़े खंचवा म डाल दीन अऊ ओकर ऊपर पथरामन के एक बड़े ढेर लगाके पाट दीन। इही बीच म, जम्मो इसरायली अपन-अपन घर ला भाग गीन।<verse eid="2SA 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 18:18" />अपन जीते जी अबसालोम ह एक खंभा ला लेके राजा के घाटी म अपन खुद के स्मारक के रूप म ठाढ़ करे रिहिस, काबरकि ओह सोचिस, “मोर नांव ला आघू बढ़ानेवाला मोर कोनो बेटा नइं एं।” ओह ओ खंभा ला अपन नांव देय रिहिस, अऊ ओला आज के दिन तक अबसालोम के स्मारक कहे जाथे।<verse eid="2SA 18:18" /></para>
  <para style="s1">दाऊद ह सोक मनाथे</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19" />तब सादोक के बेटा अहीमास ह कहिस, “मेंह दऊड़के जाहूं अऊ राजा ला ये खबर दूहूं कि यहोवा ह राजा ला ओकर बईरीमन के हांथ ले छोंड़ाके ओला बचाय हवय।”<verse eid="2SA 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 18:20" />पर योआब ह ओला कहिस, “तें आज के दिन ये खबर ला झन ले जा, तें कोनो आने दिन ये खबर ले जा सकत हस, पर आज नइं, काबरकि राजा के बेटा मरे हवय।”<verse eid="2SA 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 18:21" />तब योआब ह एक कूसी मनखे ला कहिस, “जा अऊ ओ जम्मो बात राजा ला बता, जेला तेंह देखे हस।” ओ कूसी मनखे ह योआब ला दंडवत करिस अऊ दऊड़के चल दीस।<verse eid="2SA 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 18:22" />सादोक के बेटा अहीमास ह योआब ला फेर कहिस, “कुछू भी होवय, मोला घलो ओ कूसी मनखे के पाछू दऊड़के जावन दे।”</para>
  <para style="p" vid="2SA 18:22">पर योआब ह कहिस, “हे मोर बेटा, तें काबर जाय चाहत हस? तोर करा अइसने कोनो संदेस नइं ए, जेकर तोला ईनाम मिलय?”<verse eid="2SA 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 18:23" />ओह कहिस, “कुछू भी होवय, में दऊड़के जाय चाहत हंव।”</para>
  <para style="p" vid="2SA 18:23">तब योआब ह कहिस, “दऊड़!” तब अहीमास ह मैदान<note caller="+" style="f"><char style="fr" closed="false">18:23 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरदन नदी के मैदान</char></note> के रसता म होके दऊड़िस अऊ ओह कूसी मनखे ले आघू निकल गीस।<verse eid="2SA 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 18:24" />जब दाऊद ह भीतरी अऊ बाहिरी दुवारमन के बीच बईठे रिहिस, त पहरेदार ह दीवार म चढ़के दुवार के ऊपर बने छत म गीस, ओह आंखी उठाके देखिस कि एक मनखे ह अकेला दऊड़त आवत हे। <verse eid="2SA 18:24" /><verse number="25" style="v" sid="2SA 18:25" />तब पहरेदार ह आरो लगाके राजा ला ये बात बताईस।</para>
  <para style="p" vid="2SA 18:25">तब राजा ह कहिस, “यदि ओह एके झन हवय, त ओह जरूर बने खबर लावत होही।” अऊ ओ दऊड़नेवाला लकठा म आवत गीस।<verse eid="2SA 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 18:26" />तब पहरेदार ह एक अऊ मनखे ला दऊड़के आवत देखिस, अऊ ओह दुवारपाल ला आरो लगाके कहिस, “देख, एक अऊ मनखे दऊड़त आवत हे!”</para>
  <para style="p" vid="2SA 18:26">राजा ह कहिस, “ओह घलो जरूर बने खबर लावत होही।”<verse eid="2SA 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 18:27" />पहरेदार ह कहिस, “मोला अइसे लगत हे कि पहिले मनखे ह सादोक के बेटा अहीमास सहीं दऊड़त हे।”</para>
  <para style="p" vid="2SA 18:27">राजा ह कहिस, “ओह एक बने मनखे अय, अऊ ओह बने खबर लेके आथे।”<verse eid="2SA 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 18:28" />तब अहीमास ह आरो लगाके राजा ला कहिस, “सब ठीक हे!” फेर ओह भुइयां म मुहूं के बल गिरके राजा ला दंडवत करिस अऊ कहिस, “यहोवा तोर परमेसर के परसंसा होवय! जऊन मन मोर मालिक राजा के बिरूध हांथ उठाय रिहिन, ओमन ला परमेसर ह तोर अधीन कर दे हवय।”<verse eid="2SA 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 18:29" />राजा ह पुछिस, “का जवान अबसालोम ह सुरकछित हवय?”</para>
  <para style="p" vid="2SA 18:29">अहीमास ह जबाब दीस, “जब योआब ह राजा के सेवक अऊ तोर दास मोला भेजनेचवाला रिहिस, त मेंह उहां बहुंत गड़बड़ी देखेंव, पर में नइं जानंव कि का होय रिहिस।”<verse eid="2SA 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 18:30" />तब राजा ह कहिस, “बाजू म ठाढ़े रह अऊ इहां इंतजार कर।” त ओह बाजू म जाके उहां ठाढ़ हो गीस।<verse eid="2SA 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 18:31" />तब कूसी मनखे ह हबरिस अऊ कहिस, “हे मोर मालिक राजा, तोर बर बने खबर हवय। यहोवा ह तोला ओ जम्मो झन ले छोंड़ाके बचाय हवय, जेमन के हांथ तोर बिरूध उठे रिहिस।”<verse eid="2SA 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 18:32" />राजा ह ओ कूसी ले पुछिस, “का जवान अबसालोम ह सुरकछित हवय?”</para>
  <para style="p" vid="2SA 18:32">कूसी ह जबाब देवत कहिस, “मोर मालिक राजा के बईरी अऊ ओ जम्मो जऊन मन तोर हानि करे बर ठाढ़ होथें, ओमन के दसा ओ जवान के असन होवय।”<verse eid="2SA 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 18:33" />तब राजा ह कांपे लगिस। ओह सहर के दुवार के ऊपर बने कमरा म गीस अऊ रोवन लगिस। ओह जावत-जावत कहिस: “हाय मोर बेटा अबसालोम! मोर बेटा, मोर बेटा अबसालोम! बने होतिस कि तोर बदला म, में मर गे रहितेंव—हाय अबसालोम, मोर बेटा, मोर बेटा!”<note caller="+" style="f"><char style="fr" closed="false">18:33 </char><char style="ft" closed="false">इबरानी म (<char style="xt"><ref loc="2SA 18:33">18:33</ref></char>) ला 19:1 के रूप म गने गे हवय</char></note><verse eid="2SA 18:33" /></para>
  <chapter eid="2SA 18" />
  <chapter number="19" style="c" sid="2SA 19" />
  <para style="p">
    <note caller="+" style="f">
      <char style="fr" closed="false">19 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="2SA 19:1-43">19:1‑43</ref></char> ला 19:2‑44 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="2SA 19:1" />तब योआब ला ये समाचार मिलिस, “राजा ह अबसालोम बर रोवत हवय अऊ बिलाप करत हवय।” <verse eid="2SA 19:1" /><verse number="2" style="v" sid="2SA 19:2" />एकरसेति ओ दिन के बिजय ह सबो सेना बर बिलाप म बदल गीस, काबरकि ओ दिन सेना के मनखेमन ये सुनिन, “राजा ह अपन बेटा बर सोक मनात हे।” <verse eid="2SA 19:2" /><verse number="3" style="v" sid="2SA 19:3" />एकरसेति ओ दिन आदमीमन अइसन मुहूं ला लुकाके महनैम नगर म घुसिन, जइसन मनखेमन लड़ई ले भागके आय ले लज्जित होके अपन मुहूं छुपाथें। <verse eid="2SA 19:3" /><verse number="4" style="v" sid="2SA 19:4" />राजा ह अपन मुहूं ला ढांपके चिचिया-चिचियाके रोईस, “हाय मोर बेटा अबसालोम! हाय अबसालोम, मोर बेटा, मोर बेटा!”<verse eid="2SA 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 19:5" />तब योआब ह राजा के घर म जाके ओला कहिस, “आज तेंह ओ जम्मो आदमीमन ला लज्जित करे हस, जेमन अभी-अभी तोर परान अऊ तोर बेटा अऊ बेटीमन के परान अऊ तोर घरवाली अऊ रखैलमन के परान ला बचाय हवंय। <verse eid="2SA 19:5" /><verse number="6" style="v" sid="2SA 19:6" />तेंह ओमन ले मया करथस, जेमन तोर ले घिन करथें अऊ ओमन ले घिन करथस, जेमन तोर ले मया करथें। तेंह आज ये बात ला साफ कर देय कि तोर नजर म सेनापति अऊ ओमन के आदमीमन के कोनो महत्व नइं ए। मेंह देखत हंव कि तेंह खुस होते, यदि आज अबसालोम ह जीयत रहितिस अऊ हमन जम्मो झन मारे जातेंन। <verse eid="2SA 19:6" /><verse number="7" style="v" sid="2SA 19:7" />अब उठके बाहिर जा अऊ अपन आदमीमन ला उत्साहित कर। में यहोवा के सपथ खाके कहत हंव कि यदि तेंह बाहिर नइं जाबे, त आज रथिया तक एको झन भी तोर संग नइं रहंय। अऊ तोर लइकापन ले लेके अब तक जतेक बिपत्ति तोर ऊपर पड़े हवय, ओ सबो ले ये बिपत्ति ह बड़े होही।”<verse eid="2SA 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 19:8" />तब राजा ह उठिस अऊ दुवार म जाके बईठिस। जब आदमीमन ला ये बताय गीस, “राजा ह दुवार म बईठे हवय,” त ओ जम्मो झन ओकर करा आईन।</para>
  <para style="p" vid="2SA 19:8">इही बीच, इसरायलीमन अपन-अपन घर भाग गे रिहिन।<verse eid="2SA 19:8" /></para>
  <para style="s1">दाऊद के यरूसलेम लहुंटई</para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 19:9" />इसरायल के सबो गोत्र म, जम्मो मनखेमन आपस म ये कहिके बहस करत रिहिन, “राजा ह हमन ला हमर बईरीमन के हांथ ले बचाईस; ओह ओ मनखे अय, जऊन ह हमन ला पलिस्तीमन के हांथ ले छोंड़ाईस। पर अब ओह अबसालोम ले बचे बर देस छोंड़के भाग गीस; <verse eid="2SA 19:9" /><verse number="10" style="v" sid="2SA 19:10" />अऊ अबसालोम, जऊन ला हमन हमर ऊपर राज करे बर अभिसेक करेंन, ओह लड़ई म मर गीस। त अब तुमन राजा ला वापिस लाय के बारे म काबर कुछू नइं कहत हव?”<verse eid="2SA 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 19:11" />राजा दाऊद ह सादोक अऊ अबियातार पुरोहितमन करा ये खबर भेजिस, “यहूदा के अगुवामन ले पुछव, ‘तुमन राजा ला ओकर महल म लाय बर सबले पाछू काबर होवत हव, जबकि जम्मो इसरायल म जऊन बात के चरचा होवत हे, ओकर खबर राजा ला ओकर भवन म मिल चुके हे? <verse eid="2SA 19:11" /><verse number="12" style="v" sid="2SA 19:12" />तुमन त मोर रिस्तेदार, मोर खुद के मांस अऊ लहू अव। त तुमन राजा ला वापिस लाय म सबले पाछू काबर होवत हव?’ <verse eid="2SA 19:12" /><verse number="13" style="v" sid="2SA 19:13" />अऊ अमासा ला ये कहव, ‘का तेंह मोर खुद के मांस अऊ लहू नो हस? यदि तेंह योआब के जगह म हमेसा बर मोर सेना के सेनापति नइं ठहिरबे, त परमेसर मोर ले बहुंत कड़ई से बरताव करय।’ ”<verse eid="2SA 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 19:14" />ये किसम ले, ओह यहूदा के आदमीमन के मन ला अइसन अपन कोति कर लीस कि ओ जम्मो झन एके मन के हो गीन। ओमन राजा मेर ये खबर पठोईन, “तें अऊ तोर जम्मो आदमीमन वापिस आ जावव।” <verse eid="2SA 19:14" /><verse number="15" style="v" sid="2SA 19:15" />तब राजा ह लहुंटके यरदन नदी तक आ गीस।</para>
  <para style="p" vid="2SA 19:15">यहूदा के आदमीमन गिलगाल सहर तक गे रिहिन ताकि ओमन जाके राजा ले मिलंय अऊ ओला यरदन के ये पार ले आवंय। <verse eid="2SA 19:15" /><verse number="16" style="v" sid="2SA 19:16" />यहूदा के आदमीमन के संग बहूरीम नगर के निवासी बिनयामीनी, गेरा के बेटा सिमी ह घलो जल्दी करके राजा दाऊद ले भेंट करे बर गीस। <verse eid="2SA 19:16" /><verse number="17" style="v" sid="2SA 19:17" />ओकर संग एक हजार बिनयामीनी मनखे अऊ साऊल के घराना के परबंधक सीबा अऊ ओकर पंदरह बेटा अऊ बीस सेवकमन घलो रिहिन। ओमन जल्दी करके यरदन नदी करा गीन, जिहां राजा ह रिहिस। <verse eid="2SA 19:17" /><verse number="18" style="v" sid="2SA 19:18" />ओमन राजा के घराना ला लाने बर अऊ राजा के हर ईछा ला पूरा करे बर नदी के ओ पार गीन।</para>
  <para style="p" vid="2SA 19:18">जब गेरा के बेटा सिमी ह यरदन के ओ पार गीस, त ओह राजा ला सास्टांग दंडवत करिस <verse eid="2SA 19:18" /><verse number="19" style="v" sid="2SA 19:19" />अऊ राजा ला कहिस, “मोर मालिक ह मोला दोसी झन ठहिरावय। जऊन दिन मोर मालिक राजा ह यरूसलेम ला छोंड़ आईस, ओ दिन तोर सेवक ह जऊन गलती करिस, ओला तें सुरता झन कर। राजा ह ओ बात ला अपन मन ले निकाल देय। <verse eid="2SA 19:19" /><verse number="20" style="v" sid="2SA 19:20" />काबरकि में, तोर सेवक ह जानत हंव कि मेंह पाप करे हंव, पर आज अपन मालिक राजा ले भेंट करे बर, यूसुफ के गोत्र ले में ही पहिले आय हंव।”<verse eid="2SA 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 19:21" />तब सरूयाह के बेटा अबीसै ह कहिस, “का सिमी ला ओकर काम के कारन मिरतू-दंड नइं मिलना चाही? ओह यहोवा के अभिसिक्त जन ला सराप देय रिहिस।”<verse eid="2SA 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 19:22" />दाऊद ह जबाब दीस, “हे सरूयाह के बेटामन, एकर से तुम्हर का लेना-देना हे? येमा दखल देय के तुम्हर का अधिकार हे? का आज इसरायल म कोनो ला मिरतू-दंड मिलना चाही? का मेंह नइं जानत हंव कि आज मेंह इसरायल के ऊपर राजा अंव?” <verse eid="2SA 19:22" /><verse number="23" style="v" sid="2SA 19:23" />तब राजा ह सिमी ले कहिस, “तोला मिरतू-दंड नइं दिये जावय।” अऊ राजा ह ओकर ले सपथ खाके वायदा करिस।<verse eid="2SA 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24" />साऊल के पोता मपीबोसेत ह घलो राजा ले भेंट करे बर गे रिहिस। राजा के चले जाय के दिन ले लेके ओकर सुरकछित वापिस लहुंटके आवत तक, ओह न तो अपन गोड़मन के खियाल रखिस अऊ न ही अपन दाढ़ी-मूछ ला काटे रिहिस अऊ न ही अपन ओनहामन ला धोय रिहिस। <verse eid="2SA 19:24" /><verse number="25" style="v" sid="2SA 19:25" />जब ओह यरूसलेम ले राजा ले मिले बर आईस, त राजा ह ओकर ले पुछिस, “हे मपीबोसेत, तेंह मोर संग म काबर नइं गेय रहय?”<verse eid="2SA 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 19:26" />ओह कहिस, “हे मोर मालिक राजा, में तोर सेवक ह लंगड़ा अंव, त मेंह कहेंव, ‘में अपन गदहा म काठी कसवाहूं अऊ ओमा सवार होके राजा के संग चले जाहूं।’ पर सीबा, मोर सेवक ह मोला धोखा दीस। <verse eid="2SA 19:26" /><verse number="27" style="v" sid="2SA 19:27" />अऊ ओह मोर मालिक राजा करा मोर चुगली करे हवय। मोर मालिक राजा ह परमेसर के स्वरगदूत के असन अय; अब तोला जऊन कुछू बने लगय, ओला तें कर। <verse eid="2SA 19:27" /><verse number="28" style="v" sid="2SA 19:28" />मोर डोकरा-बबा<note caller="+" style="f"><char style="fr" closed="false">19:28 </char><char style="fq" closed="false">डोकरा-बबा </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">दादा</char></note> के जम्मो संतानमन मोर मालिक राजा ले मिरतू-दंड पाय के लईक रिहिन, पर तेंह अपन सेवक ला ओमन के बीच जगह देय, जेमन तोर मेज म खाथें। मोला अऊ कोनो हक नइं ए कि मेंह राजा ले अऊ बिनती करंव?”<verse eid="2SA 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 19:29" />राजा ह ओकर ले कहिस, “अऊ बातमन के चरचा करे के का मतलब? मेंह तोला अऊ सीबा ला हुकूम देवत हंव कि ओ भुइयां ला तुमन दूनों आपस म बांट लेवव।”<verse eid="2SA 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 19:30" />तब मपीबोसेत ह राजा ले कहिस, “सीबा ह जम्मो कुछू ला लेय ले, मोर बर ये काफी ए कि मोर मालिक राजा ह सुरकछित घर लहुंट आय हे।”<verse eid="2SA 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31" />गिलादी बरजिलै ह घलो रोगलीम ले आय रिहिस कि ओह राजा के संग यरदन नदी पार जावय अऊ उहां ले राजा ला ओकर रसता बर बिदा करय। <verse eid="2SA 19:31" /><verse number="32" style="v" sid="2SA 19:32" />बरजिलै बहुंत डोकरा हो गे रिहिस; ओकर उमर ह अस्सी बछर रिहिस। जब राजा ह महनैम म रिहिस, तब ओ दौरान बरजिलै ही ओकर देखरेख करत रिहिस, काबरकि ओह एक बहुंत धनी मनखे रिहिस। <verse eid="2SA 19:32" /><verse number="33" style="v" sid="2SA 19:33" />राजा ह बरजिलै ले कहिस, “मोर संग ओ पार चल अऊ यरूसलेम म मोर संग रूक, अऊ मेंह तोर देखरेख करहूं।”<verse eid="2SA 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 19:34" />पर बरजिलै ह राजा ला जबाब दीस, “मोला अऊ कतेक साल जीयत रहना हे कि मेंह राजा के संग यरूसलेम जावंव? <verse eid="2SA 19:34" /><verse number="35" style="v" sid="2SA 19:35" />मेंह अब अस्सी बछर के हो गे हंव। का मेंह ये बात म अंतर बता सकत हंव कि का चीज के आनंद उठाय जावय अऊ का चीज के नइं? जऊन कुछू तोर सेवक ह खाथे-पीथे, का ओह ओकर सुवाद ला पहिचान सकत हे? का में अब पुरूस अऊ महिला गायकमन के अवाज ला सुन सकत हंव? तोर सेवक ह अपन मालिक राजा ऊपर काबर एक अतकिहा बोझ बनय? <verse eid="2SA 19:35" /><verse number="36" style="v" sid="2SA 19:36" />तोर सेवक ह राजा के संग म यरदन के पार थोरकन दूरिहा तक जाही, पर राजा ह काबर मोला ये किसम के ईनाम देवय? <verse eid="2SA 19:36" /><verse number="37" style="v" sid="2SA 19:37" />अपन सेवक ला वापिस लहुंटन दे कि मेंह अपन ही नगर म अपन दाई-ददा के कबर के लकठा म मरंव। पर इहां तोर दास किमहाम हवय। ओला मोर मालिक राजा के संग ओ पार जावन दे। अऊ जइसने तोला भावय, वइसने ओकर बर करबे।”<verse eid="2SA 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 19:38" />राजा ह कहिस, “हव, किमहाम ह मोर संग ओ पार चलही, अऊ जइसने तोला बने लगय, वइसने मेंह ओकर बर करहूं। अऊ कोनो चीज तेंह मोर ले चाहत हस, त मेंह ओला तोर बर करहूं।”<verse eid="2SA 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2SA 19:39" />तब जम्मो मनखेमन यरदन के ओ पार गीन, अऊ राजा ह घलो ओ पार गीस। तब राजा ह बरजिलै ला चूमिस अऊ ओला बिदा करिस, अऊ बरजिलै ह अपन घर लहुंट गीस।<verse eid="2SA 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2SA 19:40" />जब राजा ह पार होके गिलगाल करा आईस, त ओकर संग किमहाम घलो पार होईस। यहूदा के जम्मो सेना अऊ इसरायल के आधा सेना के मनखेमन राजा ला ओ पार ले गीन।<verse eid="2SA 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2SA 19:41" />तब जल्दी ही इसरायल के जम्मो आदमीमन राजा करा आके ओला ये कहे लगिन, “का कारन ए कि हमर भाई, यहूदा के आदमीमन राजा ला चोर सहीं चुपेचाप ले जावत हें अऊ ओला अऊ ओकर घराना ला ओकर जम्मो आदमीमन के संग यरदन के ये पार लावत हें?”<verse eid="2SA 19:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="2SA 19:42" />यहूदा के जम्मो आदमीमन इसरायल के आदमीमन ला जबाब दीन, “हमन अइसने करेंन काबरकि राजा के हमर ले नजदीकी रिस्ता हवय। तुमन एकर बारे म, काबर गुस्सा करत हव? का हमन राजा के कुछू जेवन-पानी ला खाय हवन? या का ओमा के कुछू चीज ला हमन लेय हवन?”<verse eid="2SA 19:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2SA 19:43" />तब इसरायली आदमीमन यहूदी आदमीमन ला जबाब दीन, “राजा म दस भाग हमर हवय; एकरसेति दाऊद ऊपर तुम्हर ले जादा हमर अधिकार हवय। त फेर तुमन काबर हमन ला अपमानित करत हव? का हमन अपन राजा ला वापिस लाय के चरचा सबले पहिले नइं करे रहेंन?”</para>
  <para style="p" vid="2SA 19:43">पर यहूदी आदमीमन इसरायली आदमीमन ले अऊ जादा मजबूती से दावा करे लगिन।<verse eid="2SA 19:43" /></para>
  <chapter eid="2SA 19" />
  <chapter number="20" style="c" sid="2SA 20" />
  <para style="s1">सेबा ह दाऊद के बिरूध बिदरोह करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1" />उहां संजोग ले सेबा नांव के एक दुस्ट मनखे रिहिस, जऊन ह बिनयामीनी गोत्र के बिकरी के बेटा रिहिस। ओह तुरही ला फूंकिस अऊ चिचियाके कहिस,</para>
  <para style="q1" vid="2SA 20:1">“दाऊद म हमर कुछू भाग नइं ए,</para>
  <para style="q2" vid="2SA 20:1">यिसै के बेटा म हमर कोनो बांटा नइं ए!</para>
  <para style="q1" vid="2SA 20:1">हे इसरायलीमन, हर एक जन अपन-अपन तम्बू म चले जावव!”<verse eid="2SA 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 20:2" />तब इसरायल के जम्मो मनखेमन दाऊद ला छोंड़के बिकरी के बेटा सेबा के पाछू हो लीन। पर यहूदा के जम्मो मनखेमन यरदन ले लेके यरूसलेम तक पूरा रसता म अपन राजा के संग रिहिन।<verse eid="2SA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 20:3" />जब दाऊद ह यरूसलेम म अपन महल म आईस, त ओह ओ दस रखैलमन ला लीस, जेमन ला ओह महल के देखरेख करे बर छोंड़के गे रिहिस, अऊ ओमन ला पहरेदार के अधीन एक घर म रखिस। ओह ओमन के पालन-पोसन करिस पर ओमन के संग सारीरिक संबंध नइं बनाईस। ओमन अपन मिरतू के दिन तक बिधवा के सहीं ओ घर के सीमना के भीतर रिहिन।<verse eid="2SA 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 20:4" />तब राजा ह अमासा ला कहिस, “यहूदा के आदमीमन करा खबर भिजवा कि ओमन तीन दिन के भीतर मोर करा आवंय, अऊ तेंह घलो इहां हाजिर रहिबे।” <verse eid="2SA 20:4" /><verse number="5" style="v" sid="2SA 20:5" />पर जब अमासा ह यहूदा के आदमीमन ला बलाय बर गीस, त ओह राजा के दुवारा ठहिराय गय समय ले जादा समय लीस।<verse eid="2SA 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 20:6" />तब दाऊद ह अबीसै ला कहिस, “अब बिकरी के बेटा सेबा ह अबसालोम ले घलो हमर जादा नुकसान करही। एकरसेति तें अपन मालिक के आदमीमन ला लेके ओकर पीछा कर, नइं तो ओह गढ़वाले नगर ला जाके हमर ले बच जाही।” <verse eid="2SA 20:6" /><verse number="7" style="v" sid="2SA 20:7" />तब योआब के आदमीमन अऊ करेती अऊ पलेतीमन, अऊ जम्मो सूरबीरमन अबीसै के अधीन होके निकलिन। ओमन बिकरी के बेटा सेबा के पीछा करे बर यरूसलेम ले आघू बढ़िन।<verse eid="2SA 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 20:8" />जब ओमन गिबोन म बड़े पथरा करा रिहिन, त अमासा ह ओमन ले मिले बर आईस। योआब ह अपन सेना के पहिरावा ला पहिरे रिहिस, अऊ ओकर कनिहां म बंधे पट्टा के मियान म एक कटार रिहिस। जब ओह आघू बढ़िस, त कटार ह मियान ले निकलके गिर गीस।<verse eid="2SA 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 20:9" />योआब ह अमासा ला कहिस, “हे मोर भाई, का हालचाल हे?” तब योआब ह अमासा ला चूमे बर अपन जेवनी हांथ ले ओकर दाढ़ी ला पकड़िस। <verse eid="2SA 20:9" /><verse number="10" style="v" sid="2SA 20:10" />अमासा के धियान ये तरफ नइं गीस कि योआब के हांथ म कटार रिहिस, अऊ योआब ह कटार ला अमासा के पेट म भोंग दीस, जेकर से ओकर पोटामन निकलके भुइयां म गिरिन। अमासा ला दूसर बार कटार भोंगे बर नइं पड़िस, अऊ ओह मर गीस। तब योआब अऊ ओकर भाई अबीसै बिकरी के बेटा सेबा के पीछा करिन।<verse eid="2SA 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 20:11" />योआब के एक आदमी अमासा के बाजू म ठाढ़ होके कहिस, “जऊन कोनो योआब के तरफ अऊ दाऊद कोति हवय, ओह योआब के पाछू हो लेवय।” <verse eid="2SA 20:11" /><verse number="12" style="v" sid="2SA 20:12" />अमासा ह सड़क के बीच म अपन खून म लोटत रहय, अऊ ओ मनखे ह देखिस कि पूरा सेना ह उहां आके रूक गीस। जब ओह देखिस कि हर एक जन अमासा करा आके रूक गे हवंय, त ओह अमासा ला सड़क ले घसीटके खेत म ले गीस अऊ ओकर ऊपर एक ओनहा ला डार दीस। <verse eid="2SA 20:12" /><verse number="13" style="v" sid="2SA 20:13" />अमासा ला सड़क ले हटाय के बाद, जम्मो आदमी बिकरी के बेटा सेबा के पीछा करे बर योआब के संग चल दीन।<verse eid="2SA 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14" />सेबा ह सबो इसरायली गोत्रमन म ले होवत आबेल-बेत-माका हबरिस अऊ बिकरीमन<note caller="+" style="f"><char style="fr" closed="false">20:14 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">बेरीमन</char></note> के पूरा इलाका म ले होवत गीस, जेमन इकट्ठा होके ओकर पाछू म हो लीन। <verse eid="2SA 20:14" /><verse number="15" style="v" sid="2SA 20:15" />योआब ह पूरा सेना के संग आके आबेल-बेत-माका म सेबा ला घेर लीस। ओमन सहर ला घेरे बर एक टीला ठाढ़ कर दीन, अऊ एकर से सहर के बाहिरी किलाबंदी हो गीस। अऊ ओमन सहर के दीवार ला गिराय बर ओला धक्का देवन लगिन। <verse eid="2SA 20:15" /><verse number="16" style="v" sid="2SA 20:16" />तब एक बुद्धिमान माईलोगन ह सहर ले पुकारके कहिस, “सुनव! सुनव! योआब ले कहव कि ओह इहां मोर करा आवय, ताकि मेंह ओकर ले बात कर सकंव।” <verse eid="2SA 20:16" /><verse number="17" style="v" sid="2SA 20:17" />जब योआब ह ओकर लकठा म गीस, त ओ माईलोगन ह पुछिस, “का तेंह योआब अस?”</para>
  <para style="p" vid="2SA 20:17">योआब ह कहिस, “हव, मेंह ओहीच अंव।”</para>
  <para style="p" vid="2SA 20:17">माईलोगन ह कहिस, “अपन सेविका के बात ला सुन।”</para>
  <para style="p" vid="2SA 20:17">त ओह कहिस, “मेंह सुनत हंव।”<verse eid="2SA 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 20:18" />माईलोगन ह आघू कहिस, “पुराना जमाना म मनखेमन ये कहंय, ‘आबेल करा समस्या ला रखव,’ अऊ ये किसम ले समस्या के हल हो जावय। <verse eid="2SA 20:18" /><verse number="19" style="v" sid="2SA 20:19" />हमन इसरायल म सांति से अऊ ईमानदारी से रहिथन। तेंह एक अइसन सहर ला नास करे चाहत हस, जऊन ह इसरायल म एक दाई सहीं अय। तेंह यहोवा के भाग ला काबर लील जाय चाहत हस?”<verse eid="2SA 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 20:20" />योआब ह जबाब दीस, “अइसन काम मोर ले दूरिहा रहय! लीले या नास करे के काम मोर ले दूरिहा रहय! <verse eid="2SA 20:20" /><verse number="21" style="v" sid="2SA 20:21" />मामला अइसने नो हय। सेबा नांव के बिकरी के बेटा, जऊन ह एपरैम के पहाड़ी देस के अय, ओह दाऊद राजा के बिरूध हांथ उठाय हवय। ये एक आदमी ला मोर हांथ म कर दव, अऊ मेंह सहर ले चले जाहूं।” माईलोगन ह योआब ले कहिस, “ओकर मुड़ ला दीवार ले तोर करा फटिक दिये जाही।”<verse eid="2SA 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 20:22" />तब ओ माईलोगन ह अपन बुद्धिमानी के बात के संग जम्मो मनखे करा गीस, अऊ ओमन बिकरी के बेटा सेबा के मुड़ ला काटिन अऊ योआब करा फटिक दीन। तब योआब ह तुरही ला फूंकिस, अऊ ओकर आदमीमन सहर ले हट गीन, अऊ अपन-अपन घर वापिस चल दीन। अऊ योआब ह राजा करा यरूसलेम लहुंट गीस।<verse eid="2SA 20:22" /></para>
  <para style="s1">दाऊद के अधिकारीमन</para>
  <para style="li1">
    <verse number="23" style="v" sid="2SA 20:23" />योआब त जम्मो इसरायली सेना के सेनापति रिहिस;</para>
  <para style="li1" vid="2SA 20:23">यहोयादा के बेटा बनायाह ह करेतीमन अऊ पलेतीमन के ऊपर रिहिस;<verse eid="2SA 20:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="2SA 20:24" />अदोनीराम<note caller="+" style="f"><char style="fr" closed="false">20:24 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">अदोराम</char></note> ह बंधुवा मजदूरमन ऊपर मुखिया रिहिस;</para>
  <para style="li1" vid="2SA 20:24">अहीलूद के बेटा यहोसापात ह इतिहास के लिखइया रिहिस;<verse eid="2SA 20:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="2SA 20:25" />सेवा ह सचिव रिहिस;</para>
  <para style="li1" vid="2SA 20:25">सादोक अऊ अबियातार पुरोहित रिहिन;<verse eid="2SA 20:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="2SA 20:26" />अऊ याईरी<note caller="+" style="f"><char style="fr" closed="false">20:26 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">येतेरी; (देखव <char style="xt"><ref loc="2SA 23:38">23:38</ref></char>)</char></note> ईरा ह दाऊद के पुरोहित रिहिस।<verse eid="2SA 20:26" /></para>
  <chapter eid="2SA 20" />
  <chapter number="21" style="c" sid="2SA 21" />
  <para style="s1">गिबोनीमन के बदला लेवई</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1" />दाऊद के सासनकाल के समय म लगातार तीन बछर तक अकाल पड़िस; त एकर कारन जाने बर दाऊद ह यहोवा ले पुछिस। यहोवा ह जबाब दीस, “येह साऊल अऊ ओकर खूनी घराना के खातिर होईस, काबरकि ओह गिबोनीमन ला मरवा डारे रिहिस।”<verse eid="2SA 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 21:2" />तब राजा ह गिबोनीमन ला बलाके ओमन ले बात करिस। (गिबोनीमन इसरायलीमन के भाग नइं रिहिन, पर ओमन अमोरीमन के बांचे मनखेमन रिहिन; इसरायलीमन ओमन ला बचाय के सपथ खाय रिहिन, पर साऊल ह इसरायल अऊ यहूदा बर अपन उत्साह म ओमन ला पूरा नास कर डारे के कोसिस करिस।) <verse eid="2SA 21:2" /><verse number="3" style="v" sid="2SA 21:3" />दाऊद ह गिबोनीमन ले पुछिस, “मेंह तुम्हर बर का करंव? मेंह कइसे प्रायस्चित करंव कि तुमन यहोवा के निज भाग ला आसीरबाद देवव?”<verse eid="2SA 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 21:4" />गिबोनीमन ओला जबाब दीन, “हमर करा साऊल या ओकर घराना ले सोन या चांदी मांगे के कोनो अधिकार नइं ए, अऊ न ही हमर करा अधिकार हवय कि इसरायल म कोनो ला मार डारन।”</para>
  <para style="p" vid="2SA 21:4">दाऊद ह पुछिस, “तुमन मोर ले का चाहत हव कि में तुम्हर बर करंव।”<verse eid="2SA 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 21:5" />ओमन राजा ला जबाब दीन, “जहां तक ओ आदमी के बात ए, जऊन ह हमन ला नास कर दीस अऊ हमर बिरूध साजिस करिस, जेकर कारन लगभग हमन मेटा गे हन अऊ इसरायल म कोनो मेर हमर बर जगह नइं ए, <verse eid="2SA 21:5" /><verse number="6" style="v" sid="2SA 21:6" />ओकर संतानमन ले सात झन आदमी हमन ला दिये जावय कि हमन ओमन ला मार डारन अऊ ओमन के लासमन ला यहोवा के चुने जन साऊल के गिबा नांव के बस्ती म यहोवा के आघू म खुला म रखे जावय।”</para>
  <para style="p" vid="2SA 21:6">त राजा ह कहिस, “मेंह ओमन ला तुम्हर हांथ म दे दूहूं।”<verse eid="2SA 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 21:7" />पर दाऊद अऊ साऊल के बेटा योनातन आपस म यहोवा के आघू म सपथ खाय रिहिन, एकरसेति राजा ह साऊल के पोता, योनातन के बेटा मपीबोसेत ला बचाय रखिस। <verse eid="2SA 21:7" /><verse number="8" style="v" sid="2SA 21:8" />पर राजा ह अय्या के बेटी रिस्पा ले साऊल कोति ले जनमे दू झन बेटा अरमोनी अऊ मपीबोसेत के संग साऊल के बेटी मेरब के पांच झन बेटा ला लीस, जेमन महोलावासी बरजिलै के बेटा अदरीएल कोति ले जनमे रिहिन। <verse eid="2SA 21:8" /><verse number="9" style="v" sid="2SA 21:9" />राजा ह येमन ला गिबोनीमन के हांथ म सऊंप दीस, अऊ गिबोनीमन ओमन ला मार डारिन अऊ ओमन के लास ला एक पहाड़ी ऊपर यहोवा के आघू म खुला छोंड़ दीन। ओ जम्मो सातों जन एक संग नास हो गीन; ओमन ला कटनी के सुरूआती दिन म ही मार डारे गीस याने कि जब जौ के कटनी के सुरूआत होवत रिहिस।<verse eid="2SA 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 21:10" />तब अय्या के बेटी रिस्पा ह बोरा के कपड़ा लीस अऊ ओला एक चट्टान ऊपर अपन बर बिछा लीस। कटनी के सुरूआत ले लेके अकास ले ओ लासमन ऊपर बहुंत बारिस होवत तक, ओ लासमन ला ओह दिन के बेरा न तो चिरईमन ला अऊ रात के बेरा न ही जंगली पसुमन ला छुवन दीस। <verse eid="2SA 21:10" /><verse number="11" style="v" sid="2SA 21:11" />जब दाऊद ला अय्या के बेटी, साऊल के रखैल रिस्पा के ये काम के खबर देय गीस, <verse eid="2SA 21:11" /><verse number="12" style="v" sid="2SA 21:12" />त दाऊद ह जाके साऊल अऊ ओकर बेटा योनातन के हाड़ामन ला याबेस-गिलाद के मनखेमन ले लेय लीस। (जेमन ओमन के लास ला बेत-सान के सार्वजनिक चऊक ले चोरा ले रिहिन; पलिस्तीमन साऊल अऊ ओकर बेटा योनातन ला गिलबो म मार डारे के बाद ओमन के लास ला ओ चऊक म टांग दे रिहिन।) <verse eid="2SA 21:12" /><verse number="13" style="v" sid="2SA 21:13" />दाऊद ह साऊल अऊ ओकर बेटा योनातन के हाड़ामन ला याबेस ले लेय आईस, अऊ ओमन के हाड़ा ला घलो इकट्ठा करे गीस, जेमन ला मारके खुला म छोंड़ दिये गे रिहिस।<verse eid="2SA 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 21:14" />साऊल अऊ ओकर बेटा योनातन के हाड़ामन ला बिनयामीन के सेला म साऊल के ददा कीस के कबर म माटी दिये गीस; अऊ राजा दाऊद के हुकूम के मुताबिक हर काम करे गीस। ओकर बाद, परमेसर ह देस के मनखेमन के पराथना के जबाब दीस।<verse eid="2SA 21:14" /></para>
  <para style="s1">पलिस्तीमन के बिरूध लड़ई</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15" />कुछू दिन के बाद एक बार फेर, पलिस्ती अऊ इसरायलीमन के बीच लड़ई होय लगिस। दाऊद ह अपन आदमीमन संग खाल्हे पलिस्तीमन के बिरूध लड़े बर गीस, अऊ ओह थक गीस। <verse eid="2SA 21:15" /><verse number="16" style="v" sid="2SA 21:16" />अऊ रापा के एक संतान, यिसबी-बनोब, जेकर कांसा के भाला के मुठ के वजन तीन सौ सेकेल<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false">लगभग 3.5 किलोग्राम</char></note> रिहिस, अऊ जऊन ह एक नवां तलवार धरे रिहिस, ओह कहिस कि ओह दाऊद ला मार डारही। <verse eid="2SA 21:16" /><verse number="17" style="v" sid="2SA 21:17" />पर सरूयाह के बेटा अबीसै ह दाऊद के बचाव करे बर आईस; ओह ओ पलिस्ती ऊपर वार करिस अऊ ओला मार डारिस। तब दाऊद के आदमीमन सपथ खाके दाऊद ला कहिन, “तेंह हमर संग लड़ई म फेर कभू झन जाबे, ताकि इसरायल के दीया ह झन बुतावय।”<verse eid="2SA 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 21:18" />समय के बीतत, पलिस्तीमन ले गोब म फेर एक लड़ई होईस। ओ बेरा हूसाती सिब्बकै ह रापा के एक संतान, साप ला मार डारिस।<verse eid="2SA 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 21:19" />गोब म, पलिस्तीमन के संग फेर एक लड़ई म, बैतलहमवासी याईर के बेटा एल्हानान ह गत सहर के रहइया गोलियत के भाई ला मार डारिस, जेकर बरछी के मुठिया ह बुनकर के डोंगी सहीं रिहिस।<verse eid="2SA 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 21:20" />गत म एक अऊ लड़ई होईस, जिहां एक बहुंत बड़े डीलडौलवाला आदमी रिहिस, जेकर हर हांथ अऊ गोड़ म छै-छै ठन अंगरी रिहिस—कुल चौबीस ठन अंगरी। ओह घलो रापा के संतान रिहिस। <verse eid="2SA 21:20" /><verse number="21" style="v" sid="2SA 21:21" />जब ओह इसरायल ला ताना मारिस, त दाऊद के भाई, सिमा के बेटा योनातन ह ओला मार डारिस।<verse eid="2SA 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 21:22" />ये चारों जवान गत के रहइया रापा के संतान रिहिन, अऊ ओमन दाऊद अऊ ओकर आदमीमन के हांथ म मारे गीन।<verse eid="2SA 21:22" /></para>
  <chapter eid="2SA 21" />
  <chapter number="22" style="c" sid="2SA 22" />
  <para style="s1">दाऊद के इस्तुति के गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1" />दाऊद ह यहोवा बर ये गीत के बचनमन ला तब गाईस, जब यहोवा ह ओला ओकर जम्मो बईरीमन के हांथ ले अऊ साऊल के हांथ ले बचाईस। <verse eid="2SA 22:1" /><verse number="2" style="v" sid="2SA 22:2" />ओह कहिस:</para>
  <para style="q1" vid="2SA 22:2">“यहोवा ह मोर चट्टान, मोर गढ़ अऊ मोर छुड़ानेवाला अय;<verse eid="2SA 22:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="2SA 22:3" />मोर परमेसर ह मोर चट्टान अय, जेमा मेंह सरन लेथंव,</para>
  <para style="q2" vid="2SA 22:3">ओह मोर ढाल<note caller="+" style="f"><char style="fr" closed="false">22:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमपरधान परमेसर</char></note> अऊ मोर उद्धार के सींग<note caller="+" style="f"><char style="fr" closed="false">22:3 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">के मतलब इहां </char><char style="fqa" closed="false">बल</char></note> अय।</para>
  <para style="q1" vid="2SA 22:3">ओह मोर मजबूत गढ़, मोर सरन-स्थान अऊ मोर उद्धारकर्ता अय—</para>
  <para style="q2" vid="2SA 22:3">तेंह उपदरवी मनखे ले मोला बचाथस।<verse eid="2SA 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="2SA 22:4" />“मेंह यहोवा ला पुकारेंव, जऊन ह इस्तुति के योग्य अय,</para>
  <para style="q2" vid="2SA 22:4">अऊ मेंह अपन बईरीमन ले बचाय गे हवंव।<verse eid="2SA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 22:5" />मिरतू के लहरमन मोला घेर डारिन;</para>
  <para style="q2" vid="2SA 22:5">भयंकर बिनास के तेज धारा ह मोला घबरा दीस।<verse eid="2SA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 22:6" />कबर के डोरीमन मोर चारों कोति रिहिन;</para>
  <para style="q2" vid="2SA 22:6">मिरतू के फांदा ह मोर आघू म रिहिस।<verse eid="2SA 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="2SA 22:7" />“मेंह अपन बिपत्ति म यहोवा ला पुकारेंव;</para>
  <para style="q2" vid="2SA 22:7">मेंह अपन परमेसर ला पुकारेंव।</para>
  <para style="q1" vid="2SA 22:7">अपन मंदिर ले ओह मोर अवाज ला सुनिस;</para>
  <para style="q2" vid="2SA 22:7">मोर गोहार ह ओकर कान म पड़िस।<verse eid="2SA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="2SA 22:8" />तब धरती ह कांपिस अऊ डोलिस,</para>
  <para style="q2" vid="2SA 22:8">अऊ अकास<note caller="+" style="f"><char style="fr" closed="false">22:8 </char><char style="ft" closed="false">इबरानी म; (देखव <char style="xt"><ref loc="PSA 18:7">भजन 18:7</ref></char>) </char><char style="fqa" closed="false">पहाड़मन</char></note> के नीवमन डोल गीन;</para>
  <para style="q2" vid="2SA 22:8">ओमन कांपे लगिन, काबरकि ओह गुस्सा हो गे रिहिस।<verse eid="2SA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="2SA 22:9" />ओकर नाक ले धुआं निकलिस;</para>
  <para style="q2" vid="2SA 22:9">ओकर मुहूं ले भसम करइया आगी निकलिस,</para>
  <para style="q2" vid="2SA 22:9">जेमा ले बरत कोइला के जुवाला निकलिस।<verse eid="2SA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="2SA 22:10" />ओह अकास ला अलग करिस अऊ खाल्हे उतरिस;</para>
  <para style="q2" vid="2SA 22:10">करिया बादरमन ओकर गोड़ के खाल्हे रिहिन।<verse eid="2SA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="2SA 22:11" />ओह करूब ऊपर सवार होके उड़ गीस;</para>
  <para style="q2" vid="2SA 22:11">ओह हवा के डेनामन म सवार होके बहुंत ऊपर उड़िस।<verse eid="2SA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2SA 22:12" />ओह अंधियार ला अपन चारों कोति ओढ़ना बना लीस—</para>
  <para style="q2" vid="2SA 22:12">याने कि अकास के पानीवाले करिया बादरमन ला।<verse eid="2SA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2SA 22:13" />ओकर उपस्थिति के तेज ले</para>
  <para style="q2" vid="2SA 22:13">बिजली के जुवाला चमकिस।<verse eid="2SA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="2SA 22:14" />यहोवा ह स्वरग ले गरजिस;</para>
  <para style="q2" vid="2SA 22:14">सर्वोच्च परमेसर के अवाज ह गुंजिस।<verse eid="2SA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="2SA 22:15" />ओह अपन तीरमन ला चलाईस अऊ बईरीमन ला तितिर-बितिर कर दीस,</para>
  <para style="q2" vid="2SA 22:15">बिजली के बड़े कड़क ले ओह ओमन ला हराके भगा दीस।<verse eid="2SA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="2SA 22:16" />यहोवा के डांटे ले,</para>
  <para style="q2" vid="2SA 22:16">ओकर नाक के सांस फूंके ले,</para>
  <para style="q1" vid="2SA 22:16">समुंदर के घाटीमन दिखे लगिन</para>
  <para style="q2" vid="2SA 22:16">अऊ धरती के नीवमन खाली पड़ गीन।<verse eid="2SA 22:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="2SA 22:17" />“ओह ऊपर ले हांथ बढ़ाके मोला थाम लीस;</para>
  <para style="q2" vid="2SA 22:17">ओह मोला गहिरा पानी म ले बाहिर निकालिस।<verse eid="2SA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2SA 22:18" />ओह मोला मोर ओ ताकतवर बईरीमन ले,</para>
  <para style="q2" vid="2SA 22:18">मोर बिरोधीमन ले छोंड़ाईस, जेमन बहुंत बलवान रिहिन।<verse eid="2SA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 22:19" />ओमन मोर बिपत्ति के दिन म मोर बिरोध करिन,</para>
  <para style="q2" vid="2SA 22:19">पर यहोवा ह मोर सहारा रिहिस।<verse eid="2SA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 22:20" />ओह मोला एक ठन चाकर जगह म ले आईस;</para>
  <para style="q2" vid="2SA 22:20">ओह मोला बचाईस काबरकि ओह मोर ले खुस रिहिस।<verse eid="2SA 22:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="2SA 22:21" />“यहोवा ह मोर धरमीपन के मुताबिक मोर ले बरताव करे हवय;</para>
  <para style="q2" vid="2SA 22:21">मोर हांथ के सुधता के मुताबिक ओह मोला ईनाम दे हवय।<verse eid="2SA 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 22:22" />काबरकि मेंह यहोवा के रद्दा म चले हवंव;</para>
  <para style="q2" vid="2SA 22:22">मेंह अपन परमेसर के रद्दा ले हट जाय के पाप नइं करे हंव।<verse eid="2SA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 22:23" />ओकर जम्मो कानूनमन मोर आघू म हवंय;</para>
  <para style="q2" vid="2SA 22:23">मेंह ओकर बिधिमन ला माने ले नइं हटे हंव।<verse eid="2SA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 22:24" />मेंह ओकर आघू म निरदोस रहे हंव</para>
  <para style="q2" vid="2SA 22:24">अऊ मेंह अपनआप ला पाप ले दूरिहा रखे हंव।<verse eid="2SA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 22:25" />यहोवा ह मोर धरमीपन के मुताबिक मोला ईनाम दे हवय,</para>
  <para style="q2" vid="2SA 22:25">ओकर नजर म मोर सुधता के मुताबिक ओह मोला ईनाम दे हवय।<verse eid="2SA 22:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="2SA 22:26" />“बिसवासयोग्य मनखे बर तेंह बिसवासयोग्य रहिथस,</para>
  <para style="q2" vid="2SA 22:26">निरदोस मनखे बर तेंह निरदोस रहिथस,<verse eid="2SA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 22:27" />सुध मनखे बर तेंह सुध रहिथस,</para>
  <para style="q2" vid="2SA 22:27">पर भटके हुए मनखे बर तेंह चतुर बनथस।<verse eid="2SA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2SA 22:28" />तेंह नम्र सुभाव के मनखे ला बचाथस,</para>
  <para style="q2" vid="2SA 22:28">पर अभिमानीमन ला नीचा दिखाय बर तोर आंखी ह ओमन ऊपर लगे रहिथे।<verse eid="2SA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="2SA 22:29" />हे यहोवा, तेंह मोर दीया अस;</para>
  <para style="q2" vid="2SA 22:29">यहोवा ह मोर अंधियार ला अंजोर कर देथे।<verse eid="2SA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="2SA 22:30" />तोर मदद ले मेंह एक सेना के बिरूध जा सकत हंव;</para>
  <para style="q2" vid="2SA 22:30">मोर परमेसर के मदद ले मेंह एक दीवार ऊपर चढ़ सकत हंव।<verse eid="2SA 22:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="2SA 22:31" />“जहां तक परमेसर के बात ए, ओकर रसता ह बिलकुल सही ए:</para>
  <para style="q2" vid="2SA 22:31">यहोवा के बचन म कोनो कमी नइं ए;</para>
  <para style="q2" vid="2SA 22:31">ओह ओ जम्मो झन ला बचाथे, जऊन मन ओकर सरन म आथें।<verse eid="2SA 22:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="2SA 22:32" />काबरकि यहोवा ला छोंड़ कोन ह परमेसर ए?</para>
  <para style="q2" vid="2SA 22:32">अऊ हमर परमेसर ला छोंड़ कोन ह चट्टान ए?<verse eid="2SA 22:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="2SA 22:33" />येह परमेसर ए, जऊन ह सामर्थ से मोला संभालथे</para>
  <para style="q2" vid="2SA 22:33">अऊ मोर रसता ला सुरकछित रखथे।<verse eid="2SA 22:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 22:34" />ओह मोर गोड़ ला हिरन के गोड़ सहीं कर देथे;</para>
  <para style="q2" vid="2SA 22:34">ओह मोला ऊंच जगह म ठाढ़ करथे।<verse eid="2SA 22:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="2SA 22:35" />ओह मोर हांथमन ला लड़ई करे बर सिखाथे;</para>
  <para style="q2" vid="2SA 22:35">मोर बाहां ह कांसा के धनुस ला मोड़ सकथे।<verse eid="2SA 22:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="2SA 22:36" />तेंह अपन बचाव के मदद ला मोर ढाल बनाथस;</para>
  <para style="q2" vid="2SA 22:36">तोर मदद ह मोला महान कर दे हवय।<verse eid="2SA 22:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="2SA 22:37" />तेंह मोर पांव बर चाकर रसता देथस,</para>
  <para style="q2" vid="2SA 22:37">जेकर ले मोर एड़ीमन नइं थकंय।<verse eid="2SA 22:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="2SA 22:38" />“मेंह अपन बईरीमन के पीछा करके ओमन ला कुचर देंव;</para>
  <para style="q2" vid="2SA 22:38">मेंह तब तक नइं लहुंटंय, जब तक कि ओमन नास नइं हो गीन।<verse eid="2SA 22:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="2SA 22:39" />मेंह ओमन ला पूरा कुचर देंव, अऊ ओमन उठ नइं सकिन;</para>
  <para style="q2" vid="2SA 22:39">ओमन मोर गोड़ खाल्हे गिर गीन।<verse eid="2SA 22:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="2SA 22:40" />तेंह मोला लड़ई करे बर ताकत दे हस;</para>
  <para style="q2" vid="2SA 22:40">तेंह मोर बईरीमन ला मोर आघू म झुका दे हस।<verse eid="2SA 22:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="2SA 22:41" />तेंह मोर बईरीमन ला पीठ देखाके भागे बर बिबस कर दे हस,</para>
  <para style="q2" vid="2SA 22:41">अऊ मेंह मोर बईरीमन ला नास कर देंव।<verse eid="2SA 22:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="2SA 22:42" />ओमन मदद बर गोहारिन, पर ओमन ला बचानेवाला कोनो नइं रिहिस—</para>
  <para style="q2" vid="2SA 22:42">ओमन यहोवा ला पुकारिन, पर ओह जबाब नइं दीस।<verse eid="2SA 22:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="2SA 22:43" />मेंह ओमन ला मार-मारके भुइयां के धुर्रा सहीं कर देंव;</para>
  <para style="q2" vid="2SA 22:43">मेंह ओमन ला गली के चीखला सहीं कुटेंव अऊ रऊंदेंव।<verse eid="2SA 22:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="2SA 22:44" />“तेंह मोला मनखेमन के हमला ले बचाय हस;</para>
  <para style="q2" vid="2SA 22:44">तेंह मोला जाति-जाति के मनखेमन के मुखिया के रूप म बचाके रखे हस।</para>
  <para style="q1" vid="2SA 22:44">ओ मनखे, जेमन ला मेंह नइं जानत रहेंव, ओमन अब मोर सेवा करथें,<verse eid="2SA 22:44" /></para>
  <para style="q2">
    <verse number="45" style="v" sid="2SA 22:45" />परदेसीमन मोर आघू म डरथें;</para>
  <para style="q2" vid="2SA 22:45">मोर अवाज ला सुनतेच ही ओमन मोर हुकूम के पालन करथें।<verse eid="2SA 22:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="2SA 22:46" />ओ जम्मो झन घबरा जाथें;</para>
  <para style="q2" vid="2SA 22:46">ओमन कांपत अपन गढ़ ले बाहिर निकलथें।<verse eid="2SA 22:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="2SA 22:47" />“यहोवा ह जीयत हवय! मोर चट्टान के परसंसा होवय!</para>
  <para style="q2" vid="2SA 22:47">मोर परमेसर, चट्टान, मोर उद्धारकर्ता के बहुंत परसंसा होवय!<verse eid="2SA 22:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="2SA 22:48" />ओह परमेसर ए, जऊन ह मोर बदला लेथे,</para>
  <para style="q2" vid="2SA 22:48">जऊन ह जाति-जाति के मनखेमन ला मोर अधीन कर देथे,<verse eid="2SA 22:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="2SA 22:49" />जऊन ह मोला मोर बईरीमन ले छुड़ाथे;</para>
  <para style="q1" vid="2SA 22:49">तेंह मोला मोर बिरोधीमन ले ऊंच करे हस;</para>
  <para style="q2" vid="2SA 22:49">एक हिंसक आदमी ले तेंह मोला बचाय हस।<verse eid="2SA 22:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="2SA 22:50" />एकरसेति हे यहोवा, मेंह जाति-जाति के मनखेमन के बीच तोर परसंसा करहूं;</para>
  <para style="q2" vid="2SA 22:50">मेंह तोर नांव के परसंसा के गीत गाहूं।<verse eid="2SA 22:50" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="51" style="v" sid="2SA 22:51" />“ओह अपन राजा ला बड़े बिजय देथे;</para>
  <para style="q2" vid="2SA 22:51">ओह अपन अभिसिक्त जन, दाऊद</para>
  <para style="q2" vid="2SA 22:51">अऊ ओकर संतानमन ऊपर हमेसा बहुंत दया देखाथे।”<verse eid="2SA 22:51" /></para>
  <chapter eid="2SA 22" />
  <chapter number="23" style="c" sid="2SA 23" />
  <para style="s1">दाऊद के आखिरी बचन</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1" />दाऊद के आखिरी बचन ये अय:</para>
  <para style="q1" vid="2SA 23:1">“यिसै के बेटा दाऊद के उत्साह देवइया बचन,</para>
  <para style="q2" vid="2SA 23:1">ओ मनखे के बचन, जेला सर्वोच्च परमेसर ह ऊपर उठाईस,</para>
  <para style="q1" vid="2SA 23:1">ओ मनखे, जेला याकूब के परमेसर ह अभिसेक करिस,</para>
  <para style="q2" vid="2SA 23:1">इसरायल के गीतमन के नायक:<verse eid="2SA 23:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="2SA 23:2" />“यहोवा के आतमा ह मोर जरिये गोठियाईस;</para>
  <para style="q2" vid="2SA 23:2">ओकर बचन ह मोर मुहूं म रिहिस।<verse eid="2SA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 23:3" />इसरायल के परमेसर ह गोठियाईस,</para>
  <para style="q2" vid="2SA 23:3">इसरायल के चट्टान ह मोर ले कहिस:</para>
  <para style="q1" vid="2SA 23:3">‘जब एक झन धरमीपन म मनखेमन ऊपर सासन करथे,</para>
  <para style="q2" vid="2SA 23:3">जब ओह परमेसर के भय मानत सासन करथे,<verse eid="2SA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 23:4" />ओह बिहनियां सूरज निकले के बेरा के अंजोर सहीं अय</para>
  <para style="q2" vid="2SA 23:4">अइसन बिहनियां, जेमा बादर नइं होवय,</para>
  <para style="q1" vid="2SA 23:4">जइसन बरसात होय के बाद चमकीलापन होथे</para>
  <para style="q2" vid="2SA 23:4">जेह भुइयां ले हरियर-हरियर कांदी उगाथे।’<verse eid="2SA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="2SA 23:5" />“यदि मोर घराना के सही संबंध परमेसर के संग नइं होतिस,</para>
  <para style="q2" vid="2SA 23:5">त खचित ओह मोर संग सदा के एक करार नइं करतिस,</para>
  <para style="q2" vid="2SA 23:5">जऊन ह हर किसम ले ठीक अऊ सुरकछित हवय;</para>
  <para style="q1" vid="2SA 23:5">खचित ओह मोर उद्धार के फर ला नइं लानतिस</para>
  <para style="q2" vid="2SA 23:5">अऊ मोर हर ईछा ला पूरा नइं करतिस।<verse eid="2SA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 23:6" />पर जम्मो दुस्ट मनखेमन कांटा के सहीं बाजू म फटिक दिये जाय बर होथें,</para>
  <para style="q2" vid="2SA 23:6">जेला हांथ ले नइं संकेले जावय।<verse eid="2SA 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 23:7" />जऊन ह कांटा ला छूथे</para>
  <para style="q2" vid="2SA 23:7">ओह लोहा के कोनो चीज या कोनो भाला के डंडा के उपयोग करथे;</para>
  <para style="q2" vid="2SA 23:7">जहां ओमन पड़े रहिथें, ओ जगह ला जला दिये जाथे।”<verse eid="2SA 23:7" /></para>
  <para style="s1">दाऊद के बड़े सूरबीरमन</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 23:8" />दाऊद के तीन बड़े सूरबीरमन के नांव:</para>
  <para style="p" vid="2SA 23:8">योसेब-यसेबेत, येह एक तहकमोनी<note caller="+" style="f"><char style="fr" closed="false">23:8 </char><char style="ft" closed="false">संभवतः </char><char style="fqa" closed="false">हकमोनी </char><char style="ft" closed="false">के आने नांव</char></note> रिहिस अऊ तीनों झन के मुखिया रिहिस; ओह आठ सौ आदमीमन ऊपर अपन बरछी उठाईस अऊ ओमन ला एकेच मुकाबला म मार डारिस।<verse eid="2SA 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 23:9" />ओकर बाद अहोही दोदै के बेटा एलिआजर रिहिस। तीन बड़े योद्धा म ले एक झन के रूप म, ओह ओ समय म दाऊद के संग रिहिस, जब ओमन पलिस्तीमन ला ताना मारिन, जब पलिस्तीमन लड़ई बर पस-दमीम म जूरे रिहिन। तब इसरायलीमन पाछू हट गीन, <verse eid="2SA 23:9" /><verse number="10" style="v" sid="2SA 23:10" />पर एलिआजर ह सामना करिस अऊ ओह पलिस्तीमन ला तब तक मारत गीस, जब तक कि ओकर हांथ ह थकके तलवार ले चिपट नइं गीस। ओ दिन यहोवा ह एक बड़े जीत दिलाईस। सेना ह एलिआजर करा लहुंटके आईस, पर सिरिप मरे मनखेमन के सामान लूटे बर।<verse eid="2SA 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 23:11" />ओकर बाद, हरारी अगी के बेटा सम्मा रिहिस। जब पलिस्तीमन एक अइसन जगह म एक संग जूरिन, जिहां मसूर दाल ले भरे एक खेत रिहिस, त इसरायल के सेना ह ओमन ले डरके भाग गीस। <verse eid="2SA 23:11" /><verse number="12" style="v" sid="2SA 23:12" />पर सम्मा ह खेत के मांझा म ठाढ़ होके ओमन के सामना करिस। ओह बचाव करिस अऊ पलिस्तीमन ला मार गिराईस, अऊ यहोवा ह एक बड़े जीत दिलाईस।<verse eid="2SA 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 23:13" />फसल लुए के समय, तीस मुख्य सूरबीरमन ले तीन झन दाऊद करा अदुल्लाम के गुफा म आईन, अऊ ओ समय, पलिस्तीमन के एक दल ह रपाईम के घाटी म डेरा डाले रहय। <verse eid="2SA 23:13" /><verse number="14" style="v" sid="2SA 23:14" />ओ बेरा दाऊद ह गढ़ म रिहिस, अऊ पलिस्तीमन के गढ़ के सेना ह बैतलहम म रिहिस। <verse eid="2SA 23:14" /><verse number="15" style="v" sid="2SA 23:15" />दाऊद ला बहुंत पीयास लगिस, त ओह कहिस, “हाय, कोनो मोला बैतलहम के दुवार के लकठा के कुआं ले पानी लानके पीयावव!” <verse eid="2SA 23:15" /><verse number="16" style="v" sid="2SA 23:16" />त ओ तीनों सूरबीरमन पलिस्तीमन के कतार ला टोरके बैतलहम के दुवार के लकठा के कुआं ले पानी निकालिन अऊ ओ पानी ला लेके दाऊद करा वापिस आ गीन। पर ओह ओ पानी ला पीये ले मना करिस, अऊ ओह ओ पानी ला यहोवा के आघू म ढार दीस, <verse eid="2SA 23:16" /><verse number="17" style="v" sid="2SA 23:17" />अऊ कहिस, “हे यहोवा, अइसन काम करई ह मोर ले दूरिहा रहय! का येह ओ आदमीमन के लहू नो हय, जेमन अपन परान ला जोखिम म डालके गेय रिहिन?” अऊ दाऊद ह ओ पानी ला नइं पीईस।</para>
  <para style="p" vid="2SA 23:17">अइसने बीरता के काम रिहिस ओ तीनों बड़े सूरबीरमन के।<verse eid="2SA 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 23:18" />सरूयाह के बेटा, योआब के भाई अबीसै ह ओ तीनों झन के मुखिया रिहिस। ओह तीन सौ आदमीमन के बिरूध अपन बरछी उठाके ओमन ला मार डारिस, अऊ ये किसम ले ओह ओ तीनों के सहीं नामी हो गीस। <verse eid="2SA 23:18" /><verse number="19" style="v" sid="2SA 23:19" />का ओ तीनों ले ओकर जादा आदर नइं होईस? ओह ओमन के सेनापति बनिस, हालाकि ओला ओ तीनों के बीच सामिल नइं करे गीस।<verse eid="2SA 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 23:20" />यहोयादा के बेटा बनायाह ह कबसेल सहर के एक बड़े बीर रिहिस, अऊ ओह बहुंत बीरता देखाईस। ओह मोआब के दू झन सबले बड़े योद्धामन ला मार गिराईस। बरफ गिरे के दिन म ओह खाल्हे एक खंचवा म उतरके एक सिंह ला घलो मार डारिस। <verse eid="2SA 23:20" /><verse number="21" style="v" sid="2SA 23:21" />दूसर बार ओह एक बहुंत बड़े मिसरी मनखे ला मार डारिस। हालाकि ओ मिसरी मनखे ह अपन हांथ म बरछी धरे रिहिस, पर बनायाह एक ठन बड़े लउठी लेके ओकर बिरूध गीस। ओह ओ मिसरी मनखे के हांथ ले बरछी ला छीन लीस अऊ ओकरेच बरछी ले ही ओला मार डारिस। <verse eid="2SA 23:21" /><verse number="22" style="v" sid="2SA 23:22" />अइसने-अइसने बीरता के काम यहोयादा के बेटा बनायाह ह करिस; ओह घलो ओ तीनों बड़े सूरबीरमन सहीं नामी रिहिस। <verse eid="2SA 23:22" /><verse number="23" style="v" sid="2SA 23:23" />ओला ओ तीस सूरबीरमन ले जादा आदर मिलिस, पर ओला ओ तीनों म सामिल नइं करे गीस। अऊ दाऊद ह ओला अपन अंग रकछकमन के मुखिया ठहिराईस।<verse eid="2SA 23:23" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="24" style="v" sid="2SA 23:24" />येमन ओ तीस योद्धा रिहिन:</para>
  <para style="b" vid="2SA 23:24" />
  <para style="li1" vid="2SA 23:24">योआब के भाई असाहेल,</para>
  <para style="li1" vid="2SA 23:24">बैतलहम के दोदो के बेटा एल्हानान,<verse eid="2SA 23:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="2SA 23:25" />हेरोदी सम्मा,</para>
  <para style="li1" vid="2SA 23:25">हेरोदी एलीका,<verse eid="2SA 23:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="2SA 23:26" />पलती हेलेस,</para>
  <para style="li1" vid="2SA 23:26">तकोआ ले इक्केस के बेटा ईरा,<verse eid="2SA 23:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="2SA 23:27" />अनातोत ले अबिएजेर,</para>
  <para style="li1" vid="2SA 23:27">हूसाती<note caller="+" style="f"><char style="fr" closed="false">23:27 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">मबुन्ने</char></note> सिब्बकै,<verse eid="2SA 23:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="2SA 23:28" />अहोही सलमोन,</para>
  <para style="li1" vid="2SA 23:28">नतोपाती महरै,<verse eid="2SA 23:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="2SA 23:29" />नतोपाती बाना के बेटा हेलेद<note caller="+" style="f"><char style="fr" closed="false">23:29 </char><char style="ft" closed="false">जादा इबरानी हस्तलिपि म </char><char style="fqa" closed="false">हेलेब</char></note>,</para>
  <para style="li1" vid="2SA 23:29">बिनयामीन म गिबा नगर ले रीबै के बेटा इतै,<verse eid="2SA 23:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="2SA 23:30" />पिरातोनी बनायाह,</para>
  <para style="li1" vid="2SA 23:30">गास के घाटीमन के इलाका ले हिद्दै<note caller="+" style="f"><char style="fr" closed="false">23:30 </char><char style="ft" closed="false">कुछू इबरानी हस्तलिपि म </char><char style="fqa" closed="false">हूरै</char></note>,<verse eid="2SA 23:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="2SA 23:31" />अरबात के अबी-अल्बोन,</para>
  <para style="li1" vid="2SA 23:31">बरहूमी अजमावेत,<verse eid="2SA 23:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="2SA 23:32" />सालबोनी एल्यहबा,</para>
  <para style="li1" vid="2SA 23:32">यासेन के बेटामन,</para>
  <para style="li1" vid="2SA 23:32">योनातन <verse eid="2SA 23:32" /><verse number="33" style="v" sid="2SA 23:33" />हरारी सम्मा के बेटा,</para>
  <para style="li1" vid="2SA 23:33">हरारी सारार के बेटा अहीआम,<verse eid="2SA 23:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="2SA 23:34" />माकाती अहसबै के बेटा एलीपेलेत,</para>
  <para style="li1" vid="2SA 23:34">गीलोनी अहीतोपेल के बेटा एलीआम,<verse eid="2SA 23:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="2SA 23:35" />करमेली हेसरो,</para>
  <para style="li1" vid="2SA 23:35">अराबी पारै,<verse eid="2SA 23:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="2SA 23:36" />सोबा ले नातान के बेटा इगाल,</para>
  <para style="li1" vid="2SA 23:36">हगरी<note caller="+" style="f"><char style="fr" closed="false">23:36 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">हग्गादी </char><char style="ft" closed="false">(देखव <char style="xt"><ref loc="1CH 11:38">1 इति 11:38</ref></char>)</char></note> के बेटा,<verse eid="2SA 23:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="2SA 23:37" />अमोनी सेलेक,</para>
  <para style="li1" vid="2SA 23:37">बेरोती नहरै, जऊन ह सरूयाह के बेटा योआब के हथियार ढोवइया रिहिस,<verse eid="2SA 23:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="2SA 23:38" />येतेरी ईरा,</para>
  <para style="li1" vid="2SA 23:38">येतेरी गारेब,<verse eid="2SA 23:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="2SA 23:39" />अऊ हित्ती उरियाह।</para>
  <para style="b" vid="2SA 23:39" />
  <para style="lf" vid="2SA 23:39">जम्मो ला मिलाके सैंतीस बीर रिहिन।<verse eid="2SA 23:39" /></para>
  <chapter eid="2SA 23" />
  <chapter number="24" style="c" sid="2SA 24" />
  <para style="s1">दाऊद के दुवारा सैनिकमन के गनती करई</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1" />यहोवा के कोप ह फेर इसरायलीमन ऊपर भड़किस, अऊ ओह दाऊद ला ओमन के बिरूध ये कहिके उभारिस, “जा अऊ इसरायल अऊ यहूदा के गनती कर।”<verse eid="2SA 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 24:2" />एकरसेति राजा ह योआब अऊ ओकर संग के सेनापतिमन ला हुकूम दीस, “दान सहर ले लेके बेरसेबा तक इसरायल के जम्मो गोत्र म जावव, अऊ सैनिकमन के गनती करव, ताकि मेंह जानंव कि ओमन कतेक हवंय।”<verse eid="2SA 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 24:3" />पर योआब ह राजा ला जबाब दीस, “यहोवा तोर परमेसर ह इसरायल के मनखेमन ला सौ गुना बढ़ावय, अऊ मोर मालिक राजा के आंखी ह येला देखय। पर मोर मालिक राजा ह अइसने काम काबर करे चाहत हे?”<verse eid="2SA 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 24:4" />पर राजा ह योआब अऊ सेना के सेनापतिमन के बात ला नइं मानिस; तब ओमन राजा करा ले चल दीन अऊ इसरायल के सैनिकमन के गनती करिन।<verse eid="2SA 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 24:5" />यरदन नदी के ओ पार जाके, ओमन घाटी म नगर के दक्खिन कोति अरोएर नगर के लकठा म डेरा डालिन, अऊ तब गाद म ले होवत याजेर कोति गीन। <verse eid="2SA 24:5" /><verse number="6" style="v" sid="2SA 24:6" />तब ओमन गिलाद म अऊ तहतीम-होदसी के इलाका म गीन, फेर दान-यान गीन अऊ घुमके सीदोन सहर कोति चलिन। <verse eid="2SA 24:6" /><verse number="7" style="v" sid="2SA 24:7" />तब ओमन सूर के गढ़, अऊ हिब्बी अऊ कनानीमन के जम्मो नगरमन कोति गीन। आखिर म, ओमन यहूदा देस के नेगेव म बेरसेबा करा गीन।<verse eid="2SA 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 24:8" />पूरा देस भर म जाय के बाद, नौ महिना अऊ बीस दिन के आखिरी म ओमन यरूसलेम वापिस आईन।<verse eid="2SA 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 24:9" />योआब ह राजा ला सैनिकमन के गनती बताईस; इसरायल म आठ लाख योग्य आदमीमन रिहिन, जेमन तलवार चला सकत रिहिन, अऊ यहूदा म पांच लाख रिहिन।<verse eid="2SA 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 24:10" />सैनिकमन के गनती करे के बाद, दाऊद के मन ह बियाकुल होय लगिस, अऊ ओह यहोवा ले पराथना करिस, “जऊन काम मेंह करे हंव, ओह एक बड़े पाप ए। त अब, हे यहोवा, मेंह तोर ले बिनती करत हंव, अपन सेवक के दोस ला दूर कर दे। मेंह एक बहुंत मुरूखता के काम करे हंव।”<verse eid="2SA 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 24:11" />एकर पहिले कि दूसर दिन बिहनियां दाऊद ह सोके उठतिस, यहोवा के ये बचन गाद अगमजानी, दाऊद के अगम-दरसी करा आईस: <verse eid="2SA 24:11" /><verse number="12" style="v" sid="2SA 24:12" />“जा अऊ दाऊद ला बता, ‘यहोवा ह ये कहत हे: मेंह तोर आघू म तीन बात रखत हंव। ओमा ले कोनो एक ठन ला चुन ले, जेला में तोर बिरूध करहूं।’ ”<verse eid="2SA 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 24:13" />तब गाद ह दाऊद मेर जाके ओला कहिस, “का तोर देस म तीन<note caller="+" style="f"><char style="fr" closed="false">24:13 </char><char style="ft" closed="false">इबरानी म; (देखव <char style="xt"><ref loc="1CH 21:12">1 इति 21:12</ref></char>); </char><char style="fqa" closed="false">सात</char></note> बछर के अकाल पड़य? या तीन महिना तक तोर बईरीमन तोर पीछा करत रहंय अऊ तेंह ओमन ले भागत रहिबे? या फेर तोर देस म तीन दिन तक महामारी होवय? अब तें येकर ऊपर सोच-बिचार कर अऊ मोला बता ताकि में ओला जबाब दे सकंव, जऊन ह मोला पठोय हवय।”<verse eid="2SA 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 24:14" />दाऊद ह गाद ला कहिस, “मेंह बड़े संकट म पड़े हंव। हमन यहोवा के हांथ म पड़न, काबरकि ओकर दया बहुंत बड़े अय; पर मोला मनखेमन के हांथ म झन पड़न दे।”<verse eid="2SA 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 24:15" />तब यहोवा ह ओ बिहनियां ले लेके ठहिराय गय समय तक इसरायल ऊपर एक महामारी लानिस, अऊ दान ले लेके बेरसेबा तक सत्तर हजार मनखे मर गीन। <verse eid="2SA 24:15" /><verse number="16" style="v" sid="2SA 24:16" />जब स्वरगदूत ह यरूसलेम ला नास करे बर अपन हांथ ला बढ़ाईस, तब यहोवा के मन ह ओ बिपत्ति के बारे म पिघल गीस अऊ ओह ओ स्वरगदूत ला कहिस, जऊन ह मनखेमन ला पीरा देवत रिहिस, “बहुंत हो गे! अपन हांथ ला खींच ले।” ओ समय यहोवा के स्वरगदूत ह ओरनान नांव के एक यबूसी के कोठार म रिहिस।<verse eid="2SA 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 24:17" />जब दाऊद ह ओ स्वरगदूत ला देखिस, जऊन ह मनखेमन ला पीरा देवत रिहिस, त ओह यहोवा ले कहिस, “पाप तो में करे हंव; में, चरवाहा ह गलत काम करे हंव। येमन तो भेड़ अंय। येमन का करे हवंय? तोर हांथ ह मोर अऊ मोर परिवार ऊपर उठे।”<verse eid="2SA 24:17" /></para>
  <para style="s1">दाऊद ह एक बेदी बनाथे</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18" />ओहीच दिन, गाद ह दाऊद मेर गीस अऊ ओकर ले कहिस, “जा अऊ यबूसी ओरनान के कोठार म यहोवा बर एक बेदी बना।” <verse eid="2SA 24:18" /><verse number="19" style="v" sid="2SA 24:19" />तब दाऊद ह उहां गीस जइसे कि यहोवा ह गाद के जरिये हुकूम देय रिहिस। <verse eid="2SA 24:19" /><verse number="20" style="v" sid="2SA 24:20" />जब ओरनान ह राजा अऊ ओकर करमचारीमन ला अपन कोति आवत देखिस, त ओह निकलके राजा के आघू म भुइयां तक मुड़ नवाके ओला दंडवत करिस।<verse eid="2SA 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 24:21" />ओरनान ह कहिस, “मोर मालिक राजा ह अपन दास मेर काबर आय हवय?”</para>
  <para style="p" vid="2SA 24:21">दाऊद ह जबाब दीस, “तोर कोठार ला बिसाय बर आय हवंव, ताकि में इहां यहोवा बर एक बेदी बना सकंव, जेकर ले मनखेमन के महामारी ह खतम हो जावय।”<verse eid="2SA 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 24:22" />ओरनान ह दाऊद ले कहिस, “मोर मालिक राजा ला जऊन कुछू बने लगय, ओला ओह लेय ले अऊ भेंट चघावय। होम-बलिदान बर इहां बईलामन हवंय, अऊ इहां लकरी बर दंवरी के चीज अऊ बईलामन के जुड़ा हवय। <verse eid="2SA 24:22" /><verse number="23" style="v" sid="2SA 24:23" />हे महाराज, ओरनान ह ये जम्मो चीज राजा ला देवत हे।” ओरनान ह राजा ला ये घलो कहिस, “यहोवा तोर परमेसर ह तोला स्वीकार करय।”<verse eid="2SA 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 24:24" />पर राजा ह ओरनान ला जबाब दीस, “नइं, मेंह दाम देके तोर ले येला लूहूं। मेंह यहोवा अपन परमेसर ला अइसन होम-बलिदान नइं चघावंव, जेकर बर में कुछू दाम नइं चुकाय हंव।”</para>
  <para style="p" vid="2SA 24:24">एकरसेति दाऊद ह कोठार अऊ बईलामन ला चांदी के पचास सेकेल<note caller="+" style="f"><char style="fr" closed="false">24:24 </char><char style="ft" closed="false">लगभग 575 ग्राम</char></note> म बिसा लीस। <verse eid="2SA 24:24" /><verse number="25" style="v" sid="2SA 24:25" />उहां दाऊद ह यहोवा बर एक बेदी बनाईस अऊ होम-बलिदान अऊ मेल-बलिदान चघाईस। तब यहोवा ह देस बर दाऊद के दुवारा करे पराथना के जबाब दीस, अऊ इसरायल ऊपर आय महामारी ह खतम हो गीस।<verse eid="2SA 24:25" /></para>
  <chapter eid="2SA 24" />
</usx>