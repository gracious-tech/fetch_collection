<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">मीका</para>
  <para style="toc1">मीका के किताब</para>
  <para style="toc2">मीका</para>
  <para style="toc3">मीका</para>
  <para style="mt1">मीका</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />यहूदा के राजा योताम, आहाज अऊ हिजकियाह के सासनकाल म मोरेसेत नगर के रहइया मीका करा यहोवा के ये बचन आईस, जेला ओह सामरिया अऊ यरूसलेम सहर के बारे म दरसन म देखिस।<verse eid="MIC 1:1" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />हे जम्मो मनखेमन, सुनव,</para>
  <para style="q2" vid="MIC 1:2">हे धरती अऊ येमा रहइया जम्मो झन, सुनव,</para>
  <para style="q1" vid="MIC 1:2">कि परभू ह अपन पबितर मंदिर ले,</para>
  <para style="q2" vid="MIC 1:2">परमपरधान यहोवा ह तुम्हर बिरूध म गवाही देवय।<verse eid="MIC 1:2" /></para>
  <para style="s1">सामरिया अऊ यरूसलेम के बिरूध नियाय</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />देखव! यहोवा अपन निवास ले निकलके आवत हवय;</para>
  <para style="q2" vid="MIC 1:3">ओह खाल्हे उतरके धरती के ऊंचहा जगहमन ला कुचरथे।<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />ओकर गोड़ के तरी पहाड़मन पिघल जाथें</para>
  <para style="q2" vid="MIC 1:4">अऊ घाटीमन तड़कके फट जाथें,</para>
  <para style="q1" vid="MIC 1:4">जइसने कि आगी के आघू मोम पिघलथे,</para>
  <para style="q2" vid="MIC 1:4">जइसने कि ढलान ले पानी गिरथे।<verse eid="MIC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />ये जम्मो ह याकूब के अपराध,</para>
  <para style="q2" vid="MIC 1:5">अऊ इसरायल के मनखेमन के पाप के परिनाम अय।</para>
  <para style="q1" vid="MIC 1:5">याकूब के अपराध का ए?</para>
  <para style="q2" vid="MIC 1:5">का सामरिया नो हय?</para>
  <para style="q1" vid="MIC 1:5">यहूदा के ऊंचहा जगह का ए?</para>
  <para style="q2" vid="MIC 1:5">का यरूसलेम नो हय?<verse eid="MIC 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />एकरसेति मेंह सामरिया ला कचरा के कुढ़ा सहीं कर दूहूं,</para>
  <para style="q2" vid="MIC 1:6">एक अइसन जगह जिहां अंगूर के बारी लगाय जाथे।</para>
  <para style="q1" vid="MIC 1:6">मेंह ओकर पथरामन ला खाल्हे घाटी म लुड़का दूहूं</para>
  <para style="q2" vid="MIC 1:6">अऊ ओकर नीवमन ला खुला कर दूहूं।<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />ओकर जम्मो मूरतीमन ला कुटा-कुटा कर दिये जाही;</para>
  <para style="q2" vid="MIC 1:7">ओकर मंदिर के जम्मो चढ़ावा ला आगी म जरो दिये जाही;</para>
  <para style="q2" vid="MIC 1:7">मेंह ओकर जम्मो मूरतीमन ला नास कर दूहूं।</para>
  <para style="q1" vid="MIC 1:7">काबरकि ओह अपन भेंटमन ला बेस्यागमन करके कमाय हवय,</para>
  <para style="q2" vid="MIC 1:7">अऊ बेस्यागमन के बनी के रूप म ओमन ला फेर उपयोग म लाय जाही।<verse eid="MIC 1:7" /></para>
  <para style="s1">रोवई अऊ सोक मनई</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />एकरसेति मेंह रोहूं अऊ सोक मनाहूं;</para>
  <para style="q2" vid="MIC 1:8">में खाली गोड़ अऊ नंगरा चलहूं-फिरहूं।</para>
  <para style="q1" vid="MIC 1:8">मेंह सियार सहीं नरियाहूं</para>
  <para style="q2" vid="MIC 1:8">अऊ उल्लू चिरई सहीं कलरहूं।<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />काबरकि सामरिया के महामारी ह ठीक नइं होवय;</para>
  <para style="q2" vid="MIC 1:9">येह यहूदा तक बगर गे हवय।</para>
  <para style="q1" vid="MIC 1:9">येह मोर मनखेमन के फाटक तक,</para>
  <para style="q2" vid="MIC 1:9">अऊ त अऊ येह यरूसलेम तक हबर गे हवय।<verse eid="MIC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />गत<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">गत </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">कहई </char><char style="ft" closed="false">सहीं लगथे</char></note> सहर म येकर चरचा झन करव;</para>
  <para style="q2" vid="MIC 1:10">बिलकुल झन रोवव।</para>
  <para style="q1" vid="MIC 1:10">बेत-ओपरा<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">बेत-ओपरा </char><char style="ft" closed="false">एकर मतलब होथे </char><char style="fqa" closed="false">धुर्रा के घर</char></note> म जाके</para>
  <para style="q2" vid="MIC 1:10">धुर्रा म लोटव।<verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />तुमन जऊन मन सापीर<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fq" closed="false">सापीर </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">खुसहाली</char></note> सहर म रहिथव,</para>
  <para style="q2" vid="MIC 1:11">नंगरा अऊ निरलज होके आघू बढ़व।</para>
  <para style="q1" vid="MIC 1:11">जऊन मन सानान<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fq" closed="false">सानान </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">बाहिर निकलई </char><char style="ft" closed="false">सहीं लगथे</char></note> सहर म रहिथें</para>
  <para style="q2" vid="MIC 1:11">ओमन बाहिर नइं निकलहीं।</para>
  <para style="q1" vid="MIC 1:11">बेतेसेल नगर सोक मनात हवय;</para>
  <para style="q2" vid="MIC 1:11">येह तुम्हर कोनो अऊ बचाव नइं कर सकय।<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />जऊन मन मारोत<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fq" closed="false">मारोत </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">करू </char><char style="ft" closed="false">सहीं लगथे</char></note> म रहिथें, ओमन पीरा म छटपटावत हवंय,</para>
  <para style="q2" vid="MIC 1:12">अऊ मदद पाय के इंतजार म हवंय,</para>
  <para style="q1" vid="MIC 1:12">काबरकि यहोवा कोति ले भेजे गय बिपत्ति</para>
  <para style="q2" vid="MIC 1:12">यरूसलेम के कपाट तक हबर गे हवय।<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />तुमन जऊन मन लाकीस नगर म रहिथव,</para>
  <para style="q2" vid="MIC 1:13">रथ म तेज दऊड़इया घोड़ामन ला साज पहिराव।</para>
  <para style="q1" vid="MIC 1:13">तुम्हर ले ही सियोन के बेटी के पाप के सुरूआत होईस,</para>
  <para style="q2" vid="MIC 1:13">काबरकि तुमन म ही इसरायल के अपराध पाय गीस।<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />एकरसेति तुमन ला ही</para>
  <para style="q2" vid="MIC 1:14">मोरेसेत गत ला बिदाई के उपहार देय बर पड़ही।</para>
  <para style="q1" vid="MIC 1:14">अकजीब<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="fq" closed="false">अकजीब </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">धोखा</char></note> सहर के रहइयामन</para>
  <para style="q2" vid="MIC 1:14">इसरायल के राजामन बर धोखेबाज सिद्ध होहीं।<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />हे मारेसा<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="fq" closed="false">मारेसा </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">बिजयी होवइया </char><char style="ft" closed="false">सहीं लगथे</char></note> नगर के रहइयामन,</para>
  <para style="q2" vid="MIC 1:15">मेंह तुम्हर बिरूध एक बिजेता ला पठोहूं।</para>
  <para style="q1" vid="MIC 1:15">इसरायल के जाने-माने मनखेमन</para>
  <para style="q2" vid="MIC 1:15">अदुल्लाम ला भाग जाहीं।<verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />अपन मयारू लइकामन बर सोक म अपन मुड़ के चुंदी ला मुड़ावव;</para>
  <para style="q1" vid="MIC 1:16">गिधवा कस अपन मुड़ ला चंदवा कर लेवव,</para>
  <para style="q2" vid="MIC 1:16">काबरकि तुम्हर लइकामन तुम्हर करा ले बंधुवई म चले जाहीं।<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s1">मनखे के योजना अऊ परमेसर के योजना</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1" />धिक्कार अय ओमन ला, जऊन मन दुस्ट काम करे के योजना बनाथें,</para>
  <para style="q2" vid="MIC 2:1">अऊ जऊन मन अपन दसना म पड़े-पड़े सडयंत्र करथें!</para>
  <para style="q1" vid="MIC 2:1">बिहनियां होवत ही ओमन अपन योजना ला पूरा करथें</para>
  <para style="q2" vid="MIC 2:1">काबरकि येला करे बर ओमन करा सत्ता होथे।<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />ओमन आने के खेत के लोभ करके ओला हड़प लेथें,</para>
  <para style="q2" vid="MIC 2:2">अऊ आने मन के घर ला घलो छीन लेथें।</para>
  <para style="q1" vid="MIC 2:2">ओमन मनखेमन के घरमन ला छल करके ले लेथें,</para>
  <para style="q2" vid="MIC 2:2">अऊ ओमन के पुरखा के संपत्ति ला लूट लेथें।<verse eid="MIC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3" />एकरसेति, यहोवा ह कहिथे:</para>
  <para style="q1" vid="MIC 2:3">“में ये मनखेमन के बिरूध बिपत्ति लाने के योजना बनावत हंव,</para>
  <para style="q2" vid="MIC 2:3">जेकर ले तुमन अपनआप ला बचा नइं सकव।</para>
  <para style="q1" vid="MIC 2:3">तुमन घमंड ले मुड़ उठाके फेर कभू नइं चल सकव,</para>
  <para style="q2" vid="MIC 2:3">काबरकि येह बिपत्ति के घरी होही।<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />ओ दिन मनखेमन तुम्हर हंसी उड़ाहीं;</para>
  <para style="q2" vid="MIC 2:4">ओमन ये सोक गीत के संग तुमन ला ताना मारहीं:</para>
  <para style="q1" vid="MIC 2:4">‘हमन पूरा बरबाद हो गेंन;</para>
  <para style="q2" vid="MIC 2:4">हमर मनखेमन के संपत्ति ला बांट दे गे हवय।</para>
  <para style="q1" vid="MIC 2:4">परमेसर येला मोर ले लेय लेथे!</para>
  <para style="q2" vid="MIC 2:4">ओह हमर खेतमन ला बिसवासघातीमन ला देय देथे।’ ”<verse eid="MIC 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />एकरसेति यहोवा के सभा म भुइयां ला चिट्ठी दुवारा बांटे बर</para>
  <para style="q2" vid="MIC 2:5">तुम्हर करा कोनो नइं होही।<verse eid="MIC 2:5" /></para>
  <para style="s1">लबरा अगमजानीमन</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />ओमन के अगमजानीमन कहिथें, “अगमबानी झन करव;</para>
  <para style="q2" vid="MIC 2:6">ये बिसय म अगमबानी झन करव;</para>
  <para style="q2" vid="MIC 2:6">हमर ऊपर कलंक नइं लगही।”<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />हे याकूब के संतानमन, का अइसे कहे जावय,</para>
  <para style="q2" vid="MIC 2:7">“का यहोवा ह धीरज नइं धरय?</para>
  <para style="q2" vid="MIC 2:7">का ओह अइसने काम करथे?”</para>
  <para style="b" vid="MIC 2:7" />
  <para style="q1" vid="MIC 2:7">“का मोर बचन ले ओकर भलई नइं होवय,</para>
  <para style="q2" vid="MIC 2:7">जऊन ह नियाय के रद्दा म चलथे?<verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />कुछू समय पहिले ही मोर मनखेमन</para>
  <para style="q2" vid="MIC 2:8">एक बईरी कस उठ खड़े होय हवंय।</para>
  <para style="q1" vid="MIC 2:8">तुमन ओ मनखेमन के मंहगा कपड़ा ला छीन लेथव</para>
  <para style="q2" vid="MIC 2:8">जऊन मन बेफिकर होके जावत रहिथें,</para>
  <para style="q2" vid="MIC 2:8">मानो ओ मनखेमन लड़ई ले लहुंटत हवंय।<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />तुमन मोर मनखेमन के माईलोगनमन ला</para>
  <para style="q2" vid="MIC 2:9">ओमन के सुखमय घर ले निकाल देथव।</para>
  <para style="q1" vid="MIC 2:9">तुमन ओमन के लइकामन ले मोर आसीस ला</para>
  <para style="q2" vid="MIC 2:9">हमेसा बर छीन लेथव।<verse eid="MIC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />उठव, इहां ले चले जावव!</para>
  <para style="q2" vid="MIC 2:10">येह तुम्हर अराम करे के जगह नो हय,</para>
  <para style="q1" vid="MIC 2:10">काबरकि येह असुध हो गे हवय,</para>
  <para style="q2" vid="MIC 2:10">येह नास हो गे हवय, अऊ येकर कोनो ईलाज नइं ए।<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />कहूं कोनो लबरा अऊ धोखा देवइया मनखे आथे अऊ ये कहिथे,</para>
  <para style="q2" vid="MIC 2:11">‘मेंह अगमबानी करहूं कि तुम्हर करा बहुंत अंगूर के मंद अऊ जौ के मंद होवय,’</para>
  <para style="q2" vid="MIC 2:11">त अइसने मनखे ह ये मनखेमन बर सही अगमजानी होही!<verse eid="MIC 2:11" /></para>
  <para style="s1">छुटकारा के परतिगियां</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />“हे याकूब के संतानमन, खचित मेंह तुमन जम्मो झन ला इकट्ठा करहूं;</para>
  <para style="q2" vid="MIC 2:12">खचित मेंह इसरायल के बांचे मनखेमन ला इकट्ठा करहूं।</para>
  <para style="q1" vid="MIC 2:12">जइसे भेड़मन ला कोठा म ओलियाय जाथे,</para>
  <para style="q2" vid="MIC 2:12">जइसे चरागन म बरदी ला संकेले जाथे, वइसे ही मेंह ओमन ला इकट्ठा करहूं;</para>
  <para style="q2" vid="MIC 2:12">ओ जगह म मनखेमन के भीड़ लग जाही।<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />ओ जऊन ह बाड़ा टोरके रद्दा बनाथे, ओह ओमन के आघू-आघू जाही;</para>
  <para style="q2" vid="MIC 2:13">ओमन दुवार ला टोरके बाहिर निकल जाहीं।</para>
  <para style="q1" vid="MIC 2:13">ओमन के राजा ह ओमन के आघू-आघू निकलही,</para>
  <para style="q2" vid="MIC 2:13">यहोवा ह ओमन के अगुवई करही।”<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s1">अगुवा अऊ अगमजानीमन ला दबकारे जवई</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />तब मेंह कहेंव,</para>
  <para style="q1" vid="MIC 3:1">“हे याकूब के अगुवामन, सुनव,</para>
  <para style="q2" vid="MIC 3:1">हे इसरायल के सासन करइयामन, सुनव।</para>
  <para style="q1" vid="MIC 3:1">का तुमन ला नियाय के काम नइं करना चाही,<verse eid="MIC 3:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2" />तुमन जऊन मन भलई ले घिन करथव अऊ बुरई ले मया करथव;</para>
  <para style="q1" vid="MIC 3:2">तुमन, जऊन मन मोर मनखेमन के चमड़ी</para>
  <para style="q2" vid="MIC 3:2">अऊ ओमन के हाड़ा म ले मांस ला चीथ लेथव;<verse eid="MIC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3" />तुमन, जऊन मन मोर मनखेमन के मांस खाथव,</para>
  <para style="q2" vid="MIC 3:3">ओमन के खाल खींच लेथव</para>
  <para style="q2" vid="MIC 3:3">अऊ ओमन के हाड़ामन के कुटा-कुटा कर देथव;</para>
  <para style="q1" vid="MIC 3:3">तुमन, जऊन मन ओमन ला कराही म रंधइया मांस</para>
  <para style="q2" vid="MIC 3:3">या बरतन म रखे मांस के सहीं काट डारथव?”<verse eid="MIC 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />तब ओमन यहोवा ला पुकारहीं,</para>
  <para style="q2" vid="MIC 3:4">पर ओह ओमन के नइं सुनही।</para>
  <para style="q1" vid="MIC 3:4">ओमन के दुस्ट काम के कारन</para>
  <para style="q2" vid="MIC 3:4">ओ बेरा ओह अपन मुहूं ला ओमन ले छुपा लीही।<verse eid="MIC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5" />यहोवा ह ये कहिथे:</para>
  <para style="q1" vid="MIC 3:5">“ओ अगमजानी</para>
  <para style="q2" vid="MIC 3:5">जऊन मन मोर मनखेमन ला भटका देथें,</para>
  <para style="q1" vid="MIC 3:5">कहूं ओमन ला खाय बर कुछू मिलथे,</para>
  <para style="q2" vid="MIC 3:5">तब ओमन सांति के घोसना करथें,</para>
  <para style="q1" vid="MIC 3:5">पर जऊन मनखे ह ओमन ला खवाय बर मना करथे,</para>
  <para style="q2" vid="MIC 3:5">ओकर बिरूध म लड़ई करे बर तियार हो जाथें।<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />एकरसेति बिगर दरसन के तुम्हर ऊपर रथिया आ जाही</para>
  <para style="q2" vid="MIC 3:6">अऊ बिगर सकुन-बिचार के तुम्हर ऊपर अंधियार छा जाही।</para>
  <para style="q1" vid="MIC 3:6">अगमजानीमन बर बेर ह बुड़ जाही,</para>
  <para style="q2" vid="MIC 3:6">अऊ दिन रहत ओमन ऊपर अंधियार छा जाही।<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />अगम के बात ला देखइयामन लज्जित होहीं</para>
  <para style="q2" vid="MIC 3:7">अऊ सकुन-बिचार करइयामन कलंकित होहीं।</para>
  <para style="q1" vid="MIC 3:7">ओमन जम्मो लाज के मारे अपन मुहूं ढांप लीहीं</para>
  <para style="q2" vid="MIC 3:7">काबरकि ओमन ला परमेसर ले कोनो जबाब नइं मिलही।”<verse eid="MIC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />पर जहां तक मोर बात ए,</para>
  <para style="q2" vid="MIC 3:8">मेंह यहोवा के आतमा के संग सक्ति ले</para>
  <para style="q2" vid="MIC 3:8">अऊ नियाय अऊ बल ले भरे हंव,</para>
  <para style="q1" vid="MIC 3:8">ताकि याकूब ला ओकर अपराध,</para>
  <para style="q2" vid="MIC 3:8">अऊ इसरायल ला ओकर पाप बता सकंव।<verse eid="MIC 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />हे याकूब के अगुवामन, ये बात ला सुनव,</para>
  <para style="q2" vid="MIC 3:9">हे इसरायल के सासन करइयामन, सुनव,</para>
  <para style="q1" vid="MIC 3:9">तुमन जऊन मन नियाय ला तुछ समझथव</para>
  <para style="q2" vid="MIC 3:9">अऊ जम्मो सही बातमन ला बिगाड़थव;<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />तुमन जऊन मन सियोन ला खून-खराबा ले,</para>
  <para style="q2" vid="MIC 3:10">अऊ यरूसलेम ला दुस्टता ले भरथव।<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />ओकर<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओ सहर</char></note> अगुवामन घूस लेके नियाय करथें,</para>
  <para style="q2" vid="MIC 3:11">ओकर पुरोहितमन दाम लेके सिकछा देथें,</para>
  <para style="q2" vid="MIC 3:11">अऊ ओकर अगमजानीमन पईसा बर सकुन-बिचार करथें।</para>
  <para style="q1" vid="MIC 3:11">तभो ले ओमन यहोवा के मदद के आसा करत कहिथें,</para>
  <para style="q2" vid="MIC 3:11">“का यहोवा हमर बीच म नइं ए?</para>
  <para style="q2" vid="MIC 3:11">कोनो बिपत्ति हमर ऊपर नइं आही।”<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />एकरसेति तुम्हर कारन,</para>
  <para style="q2" vid="MIC 3:12">सियोन ला कोनो खेत के सहीं जोते जाही,</para>
  <para style="q1" vid="MIC 3:12">यरूसलेम ह गोटी-पथरामन के कुढ़ा हो जाही,</para>
  <para style="q2" vid="MIC 3:12">अऊ मंदिर के पहाड़ी ह झाड़ीमन ले भरके एक टीला बन जाही।<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s1">यहोवा के पहाड़</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1" />आखिरी के दिनमन म,</para>
  <para style="q1" vid="MIC 4:1">यहोवा के मंदिर के पहाड़ ह</para>
  <para style="q2" vid="MIC 4:1">सबले ऊंच पहाड़ के रूप म स्थापित करे जाही;</para>
  <para style="q1" vid="MIC 4:1">येला जम्मो पहाड़ीमन ले ऊंचहा करे जाही,</para>
  <para style="q2" vid="MIC 4:1">अऊ मनखेमन पानी के धारा सहीं येकर करा आहीं।<verse eid="MIC 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2" />बहुंत जाति के मनखेमन आके कहिहीं,</para>
  <para style="q1" vid="MIC 4:2">“आवव, हमन यहोवा के पहाड़ ऊपर,</para>
  <para style="q2" vid="MIC 4:2">याकूब के परमेसर के मंदिर म चलन।</para>
  <para style="q1" vid="MIC 4:2">ओह हमन ला अपन नियम-कानून सिखोही,</para>
  <para style="q2" vid="MIC 4:2">ताकि हमन ओकर रसता म चलन।”</para>
  <para style="q1" vid="MIC 4:2">कानून ह सियोन ले,</para>
  <para style="q2" vid="MIC 4:2">यहोवा के बचन ह यरूसलेम ले निकलही।<verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />ओह बहुंते मनखेमन के नियाय करही</para>
  <para style="q2" vid="MIC 4:3">अऊ दूरिहा तक फईले ताकतवर जातिमन के झगरा के निपटारा करही।</para>
  <para style="q1" vid="MIC 4:3">ओमन अपन तलवारमन ला पीट-पीटके नांगर के फाल</para>
  <para style="q2" vid="MIC 4:3">अऊ अपन बरछीमन ला हंसिया बना डारहीं।</para>
  <para style="q1" vid="MIC 4:3">एक जाति ह आने जाति के बिरूध लड़ई नइं करही,</para>
  <para style="q2" vid="MIC 4:3">अऊ न ही ओमन फेर लड़ई करे के सिकछा दीहीं।<verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />हर एक जन अपन ही अंगूर के नार</para>
  <para style="q2" vid="MIC 4:4">अऊ अपन ही अंजीर के रूख के खाल्हे बईठही,</para>
  <para style="q1" vid="MIC 4:4">अऊ ओमन ला कोनो नइं डराही,</para>
  <para style="q2" vid="MIC 4:4">काबरकि सर्वसक्तिमान यहोवा ह कहे हवय।<verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />जम्मो जातिमन अपन-अपन</para>
  <para style="q2" vid="MIC 4:5">देवतामन के नांव लेके चलंय त चलंय,</para>
  <para style="q1" vid="MIC 4:5">पर हमन सदा-सर्वदा यहोवा</para>
  <para style="q2" vid="MIC 4:5">अपन परमेसर के नांव लेके चलबो।<verse eid="MIC 4:5" /></para>
  <para style="s1">यहोवा के योजना</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6" />यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="MIC 4:6">“ओ दिन मेंह लंगड़ामन ला इकट्ठा करहूं;</para>
  <para style="q1" vid="MIC 4:6">मेंह बंधुवा मनखेमन ला</para>
  <para style="q2" vid="MIC 4:6">अऊ ओमन ला इकट्ठा करहूं, जेमन ला मेंह दुख दे हवंव।<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />मेंह लंगड़ामन ला अपन बांचे भाग,</para>
  <para style="q2" vid="MIC 4:7">अऊ भगाय गय मन ला एक ताकतवर जाति बनाहूं।</para>
  <para style="q1" vid="MIC 4:7">तब ओ दिन ले लेके सदा-सर्वदा तक</para>
  <para style="q2" vid="MIC 4:7">यहोवा ह सियोन पहाड़ म ओमन ऊपर सासन करही।<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />जहां तक तुम्हर बात ए, हे झुंड के पहरेदारी करे के मचान,</para>
  <para style="q2" vid="MIC 4:8">हे सियोन के बेटी के सुरकछा गढ़<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">पहाड़ी</char></note>,</para>
  <para style="q1" vid="MIC 4:8">तुमन ला तुम्हर पहिली के राज दे दिये जाही;</para>
  <para style="q2" vid="MIC 4:8">बेटी यरूसलेम ला राजपद दिये जाही।”<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />तेंह अब ऊंचहा अवाज म काबर चिचियावत हवस—</para>
  <para style="q2" vid="MIC 4:9">का तोर कोनो राजा नइं ए?</para>
  <para style="q1" vid="MIC 4:9">का तोर सासन करइया नास हो गे हवय,</para>
  <para style="q2" vid="MIC 4:9">कि तोला लइका जनमइया माईलोगन सहीं पीरा होवत हे?<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />हे बेटी सियोन लइका जनमइया माईलोगन सहीं</para>
  <para style="q2" vid="MIC 4:10">पीरा म छटपटा,</para>
  <para style="q1" vid="MIC 4:10">काबरकि अब तोला सहर ला छोंड़के</para>
  <para style="q2" vid="MIC 4:10">खुला मैदान म डेरा डालना जरूरी अय।</para>
  <para style="q1" vid="MIC 4:10">तेंह बेबिलोन जाबे;</para>
  <para style="q2" vid="MIC 4:10">उहां तोला बचाय जाही।</para>
  <para style="q1" vid="MIC 4:10">उहां यहोवा ह तोला</para>
  <para style="q2" vid="MIC 4:10">तोर बईरीमन के हांथ ले छोंड़ाही।<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />पर अब तोर बिरूध म</para>
  <para style="q2" vid="MIC 4:11">बहुंत जातिमन जूरत हें।</para>
  <para style="q1" vid="MIC 4:11">ओमन कहिथें, “ओला असुध होवन दव,</para>
  <para style="q2" vid="MIC 4:11">सियोन के दुरगति हमर आनंद के बिसय होवय!”<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />पर ओमन यहोवा के</para>
  <para style="q2" vid="MIC 4:12">बिचार ला नइं जानंय;</para>
  <para style="q1" vid="MIC 4:12">ओमन ओकर योजना ला नइं समझंय,</para>
  <para style="q2" vid="MIC 4:12">कि ओह ओमन ला फसल के बीड़ा के सहीं कोठार म कुढ़ोय हवय।<verse eid="MIC 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />“हे बेटी सियोन, उठ अऊ मिंजई कर,</para>
  <para style="q2" vid="MIC 4:13">काबरकि मेंह तोला लोहा के सींग दूहूं;</para>
  <para style="q1" vid="MIC 4:13">मेंह तोला कांसा के खुर दूहूं,</para>
  <para style="q2" vid="MIC 4:13">अऊ तेंह बहुंत जातिमन ला कुटा-कुटा कर देबे।”</para>
  <para style="q1" vid="MIC 4:13">तेंह ओमन के लूटे गय चीजमन ला यहोवा ला,</para>
  <para style="q2" vid="MIC 4:13">अऊ ओमन के संपत्ति ला पूरा धरती के परभू ला अरपित करबे।<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="s1">बैतलहम ले एक परतिगियां करे गे सासन करइया</para>
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">5: </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="MIC 5:1">5:1</ref></char> ला 4:14, अऊ <char style="xt"><ref loc="MIC 5:2-15">5:2‑15</ref></char> ला 5:1‑14 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="MIC 5:1" />हे सैनिक दलमन के सहर, अपन सैनिकमन ला कतार म कर ले,</para>
  <para style="q2" vid="MIC 5:1">काबरकि हमर बिरूध एक घेरा डाले गे हवय।</para>
  <para style="q1" vid="MIC 5:1">ओमन इसरायल के सासक के गाल म</para>
  <para style="q2" vid="MIC 5:1">लउठी ले मारहीं।<verse eid="MIC 5:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />“पर तेंह, हे बैतलहम एपराता,</para>
  <para style="q2" vid="MIC 5:2">हालाकि तेंह यहूदा के बंसमन<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सासकमन</char></note> म छोटे अस,</para>
  <para style="q1" vid="MIC 5:2">तभो ले तोर म ले ही मोर बर एक झन निकलके आही</para>
  <para style="q2" vid="MIC 5:2">जऊन ह इसरायल ऊपर सासन करही,</para>
  <para style="q1" vid="MIC 5:2">जेकर आरंभ पुराना समय ले,</para>
  <para style="q2" vid="MIC 5:2">प्राचीन समय ले होय हवय।”<verse eid="MIC 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />एकरसेति इसरायल ला ओ समय तक तियाग दिये जाही,</para>
  <para style="q2" vid="MIC 5:3">जब तक ओ जऊन ह छेवारी होय के पीरा म हवय, एक बेटा ला नइं जनमे,</para>
  <para style="q1" vid="MIC 5:3">अऊ ओकर बाकि भाईमन</para>
  <para style="q2" vid="MIC 5:3">इसरायलीमन संग मिल जाय बर लहुंटके नइं आ जावंय।<verse eid="MIC 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />यहोवा के सक्ति ले,</para>
  <para style="q2" vid="MIC 5:4">यहोवा अपन परमेसर के नांव के परताप ले</para>
  <para style="q2" vid="MIC 5:4">ओह ठाढ़ होही अऊ अपन झुंड के देखरेख करही।</para>
  <para style="q1" vid="MIC 5:4">अऊ ओमन निरभय रहिहीं, काबरकि तब</para>
  <para style="q2" vid="MIC 5:4">धरती के छोर तक मनखेमन ओकर महानता ला जानहीं।<verse eid="MIC 5:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />अऊ ओह हमर सांति होही</para>
  <para style="q2" vid="MIC 5:5">जब अस्सूरीमन हमर देस ऊपर हमला करहीं</para>
  <para style="q2" vid="MIC 5:5">अऊ हमर गढ़मन म हमाहीं।</para>
  <para style="q1" vid="MIC 5:5">हमन ओमन के बिरूध सात चरवाहा,</para>
  <para style="q2" vid="MIC 5:5">बरन आठ सेनापति ठाढ़ कर देबो,<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />जऊन मन अस्सूर देस ऊपर,</para>
  <para style="q2" vid="MIC 5:6">निमरोद के देस ऊपर तलवार ले सासन करहीं।</para>
  <para style="q1" vid="MIC 5:6">ओह हमन ला अस्सूर के निवासीमन ले छोंड़ाही</para>
  <para style="q2" vid="MIC 5:6">जब ओमन हमर देस ऊपर हमला करहीं</para>
  <para style="q2" vid="MIC 5:6">अऊ हमर सिवाना ला पार करहीं।<verse eid="MIC 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />याकूब के बांचे भाग</para>
  <para style="q2" vid="MIC 5:7">बहुंत मनखेमन के बीच म होही।</para>
  <para style="q1" vid="MIC 5:7">ओह यहोवा के पठोय ओस सहीं,</para>
  <para style="q2" vid="MIC 5:7">कांदी ऊपर पड़ोइया बारिस सहीं होही,</para>
  <para style="q1" vid="MIC 5:7">ओह काकरो इंतजार नइं करय</para>
  <para style="q2" vid="MIC 5:7">या कोनो मनखे ऊपर निरभर नइं रहय।<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />याकूब के बांचे भाग ह जाति-जाति के बीच</para>
  <para style="q2" vid="MIC 5:8">अऊ मनखेमन के बीच म अइसने होही,</para>
  <para style="q1" vid="MIC 5:8">जइसने एक सिंह ह जंगल के पसुमन के बीच म होथे,</para>
  <para style="q2" vid="MIC 5:8">अऊ एक जवान सिंह भेड़मन के झुंड के बीच होथे,</para>
  <para style="q1" vid="MIC 5:8">अऊ ओह ओमन के बीच ले जावत ओमन ऊपर झपटके ओमन ला चीर देथे,</para>
  <para style="q2" vid="MIC 5:8">अऊ कोनो ओमन ला बचा नइं सकंय।<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />तुम्हर हांथ ह अपन बईरीमन ऊपर जय पाय के खुसी म ऊपर उठही,</para>
  <para style="q2" vid="MIC 5:9">अऊ तुम्हर जम्मो बईरीमन नास करे जाहीं।<verse eid="MIC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10" />यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="MIC 5:10">“ओ दिन मेंह तुम्हर घोड़ामन ला तुम्हर बीच म ले नास कर दूहूं</para>
  <para style="q2" vid="MIC 5:10">अऊ तुम्हर रथमन ला घलो नास कर दूहूं।<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />मेंह तुम्हर देस के सहरमन ला नास कर दूहूं</para>
  <para style="q2" vid="MIC 5:11">अऊ तुम्हर जम्मो गढ़मन ला टोर दूहूं।<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />मेंह तुम्हर जादू-टोना ला खतम कर दूहूं</para>
  <para style="q2" vid="MIC 5:12">अऊ तुमन फेर कभू जादू-टोना के बात नइं करहू।<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />मेंह तुम्हर मूरतीमन ला</para>
  <para style="q2" vid="MIC 5:13">अऊ तुम्हर बीच ले तुम्हर पबितर पथरामन ला नास कर दूहूं;</para>
  <para style="q1" vid="MIC 5:13">तुमन फेर कभू अपन हांथ ले बनाय</para>
  <para style="q2" vid="MIC 5:13">चीजमन के अराधना नइं करहू।<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />जब मेंह तुम्हर सहरमन ला बिनास करहूं</para>
  <para style="q2" vid="MIC 5:14">त मेंह तुम्हर बीच ले तुम्हर असेरा नांव के खंभामन<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">असेरा देवी के लकरी के प्रतीक</char></note> ला उखान फेंकहूं।<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />मेंह गुस्सा अऊ कोरोध म ओ जातिमन ले बदला लूहूं</para>
  <para style="q2" vid="MIC 5:15">जऊन मन मोर बात ला नइं माने हवंय।”<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s1">इसरायल के बिरूध यहोवा के मामला</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />सुनव कि यहोवा ह का कहत हे:</para>
  <para style="q1" vid="MIC 6:1">“उठव, अऊ पहाड़मन के आघू म मोर मामला ला रखव;</para>
  <para style="q2" vid="MIC 6:1">पहाड़ीमन सुनंय कि तुम्हर का कहना हे।<verse eid="MIC 6:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />“हे पहाड़मन, यहोवा के दुवारा लगाय आरोप ला सुनव;</para>
  <para style="q2" vid="MIC 6:2">हे धरती के अटल नीव, तुमन घलो सुनव।</para>
  <para style="q1" vid="MIC 6:2">काबरकि यहोवा के अपन मनखेमन के बिरूध एक मामला हवय;</para>
  <para style="q2" vid="MIC 6:2">ओह इसरायल के बिरूध एक मामला दायर करत हवय।<verse eid="MIC 6:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />“हे मोर मनखेमन, मेंह तुम्हर संग का अनियाय करे हवंव?</para>
  <para style="q2" vid="MIC 6:3">मोला बतावव कि मेंह तुम्हर ऊपर का बोझ डारे हवंव?<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />मेंह तुमन ला मिसर देस ले बाहिर निकालेंव</para>
  <para style="q2" vid="MIC 6:4">अऊ तुमन ला गुलामी के देस ले छोंड़ांय।</para>
  <para style="q1" vid="MIC 6:4">मेंह तुम्हर अगुवई करे बर मूसा ला पठोंय,</para>
  <para style="q2" vid="MIC 6:4">हारून अऊ मिरियम ला घलो पठोंय।<verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />हे मोर मनखेमन, सुरता करव</para>
  <para style="q2" vid="MIC 6:5">मोआब के राजा बालाक ह का सडयंत्र करे रिहिस</para>
  <para style="q2" vid="MIC 6:5">अऊ बेओर के बेटा बिलाम ह का जबाब दीस।</para>
  <para style="q1" vid="MIC 6:5">सित्तीम ले गिलगाल तक अपन यातरा ला सुरता करव,</para>
  <para style="q2" vid="MIC 6:5">ताकि तुमन यहोवा के धरमी काममन ला जान सकव।”<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />में यहोवा के आघू म का लेके आवंव</para>
  <para style="q2" vid="MIC 6:6">अऊ महिमामय परमेसर के आघू म दंडवत करंव?</para>
  <para style="q1" vid="MIC 6:6">का में होम-बलिदान बर एक-एक साल के बछरू लेके</para>
  <para style="q2" vid="MIC 6:6">ओकर आघू म आवंव?<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />का यहोवा ह हजारों मेढ़ा,</para>
  <para style="q2" vid="MIC 6:7">अऊ जैतून तेल के दस हजार नदीमन ले खुस होही?</para>
  <para style="q1" vid="MIC 6:7">का में अपन अपराध के पछतावा करे बर अपन पहिलांत बेटा ला बलिदान करंव</para>
  <para style="q2" vid="MIC 6:7">या अपन आतमा के पाप बर अपन जनमाय कोनो ला बलिदान करंव?<verse eid="MIC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />हे मरनहार मनखे, ओह तोला देखाय हवय कि का ह बने अय।</para>
  <para style="q2" vid="MIC 6:8">अऊ यहोवा ह तोर ले का चाहथे?</para>
  <para style="q1" vid="MIC 6:8">नियाय के काम करव अऊ दया करे बर झन छोंड़व</para>
  <para style="q2" vid="MIC 6:8">अऊ अपन परमेसर संग नमरता से चलव।<verse eid="MIC 6:8" /></para>
  <para style="s1">इसरायल के अपराध अऊ दंड</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />सुनव! यहोवा ह सहर<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरूसलेम सहर</char></note> ला बलावत हे—</para>
  <para style="q2" vid="MIC 6:9">अऊ तोर नांव के भय मनई ही बुद्धिमानी ए—</para>
  <para style="q2" vid="MIC 6:9">“लउठी अऊ येला ठहिरानेवाला के बात ला धियान देके सुनव।<verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />हे दुस्ट घर, का में अब घलो तोर दुस्टता ले कमाय धन,</para>
  <para style="q2" vid="MIC 6:10">अऊ ओ छोटे नाप ला बिसरा दंव, जऊन ह सरापित अय?<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />का में कोनो ला बेईमानी के नाप,</para>
  <para style="q2" vid="MIC 6:11">अऊ गलत वजन के थैली के संग छोंड़ दंव?<verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />तोर धनी मनखेमन हिंसा करथें;</para>
  <para style="q2" vid="MIC 6:12">तोर निवासीमन लबरा अंय</para>
  <para style="q2" vid="MIC 6:12">अऊ ओमन धोखा देवइया बात करथें।<verse eid="MIC 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />एकरसेति, मेंह तुम्हर पाप के कारन</para>
  <para style="q2" vid="MIC 6:13">तुमन ला नास करई, तुम्हर पतन करई सुरू कर चुके हंव।<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />तुमन जेवन तो करहू पर मन ह नइं भरही;</para>
  <para style="q2" vid="MIC 6:14">खाय के बाद घलो तुम्हर पेट ह खाली रहिही।</para>
  <para style="q1" vid="MIC 6:14">तुमन जमा तो करहू पर कुछू घलो नइं बांचही,</para>
  <para style="q2" vid="MIC 6:14">काबरकि तुम्हर जमा-पूंजी ला मेंह तलवार ले लुटवा दूहूं।<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />तुमन अनाज के बोवई तो करहू, पर फसल नइं काटहू;</para>
  <para style="q2" vid="MIC 6:15">तुमन जैतून के तेल तो निकालहू, पर ओ तेल के उपयोग नइं कर सकहू,</para>
  <para style="q2" vid="MIC 6:15">तुमन अंगूर ला तो कुचरहू, पर ओकर मंद ला पी नइं सकहू।<verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />तुमन ओमरी राजा के बिधि-बिधान</para>
  <para style="q2" vid="MIC 6:16">अऊ अहाब राजा के घर के जम्मो रीति-रिवाजमन ला पालन करे हव;</para>
  <para style="q2" vid="MIC 6:16">तुमन ओमन के परंपरा के घलो पालन करे हव।</para>
  <para style="q1" vid="MIC 6:16">एकरसेति मेंह तुम्हर बिनास कर दूहूं</para>
  <para style="q2" vid="MIC 6:16">अऊ तुम्हर मनखेमन के ठट्ठा करे जाही;</para>
  <para style="q2" vid="MIC 6:16">तुमन जाति-जाति के मनखेमन के अपमान सहिहू।”<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s1">इसरायल के दुरगति</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1" />मोर का दुरगति हवय!</para>
  <para style="q1" vid="MIC 7:1">में ओ मनखे जइसे अंव, जऊन ह</para>
  <para style="q2" vid="MIC 7:1">धूपकाला के फर ला अंगूर के बारी के बिनई म बटोरथे;</para>
  <para style="q1" vid="MIC 7:1">खाय बर अंगूर के कोनो गुच्छा नइं बांचे हे,</para>
  <para style="q2" vid="MIC 7:1">मेंह सुरू के अंजीर के फर के जऊन ईछा करे रहेंव, ओमन घलो नइं एं।<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />बिसवास लईक मनखेमन देस ले नास हो गे हवंय;</para>
  <para style="q2" vid="MIC 7:2">एको झन ईमानदार मनखे नइं बांचे हवंय।</para>
  <para style="q1" vid="MIC 7:2">हर एक जन लहू बोहाय के घात म लगे रहिथे;</para>
  <para style="q2" vid="MIC 7:2">ओमन जाल फईलाके एक-दूसर ला फंसाय के चक्कर म रहिथें।<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />ओमन के दूनों हांथ दुस्ट काम करे म माहिर हवंय;</para>
  <para style="q2" vid="MIC 7:3">सासन करइयामन ईनाम के मांग करथें,</para>
  <para style="q1" vid="MIC 7:3">नियायधीसमन घूस लेथें,</para>
  <para style="q2" vid="MIC 7:3">सक्तिसाली मनखेमन अपन ईछा ला पूरा करे बर मनमानी करथें—</para>
  <para style="q2" vid="MIC 7:3">ओमन जम्मो मिलके सडयंत्र रचथें।<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />ओमन म जऊन ह सबले बने माने जाथे, ओह एक कांटावाले झाड़ी के सहीं अय,</para>
  <para style="q2" vid="MIC 7:4">जऊन ह सबले जादा ईमानदार समझे जाथे, ओह एक कांटावाले बाड़ा ले घलो खराप होथे।</para>
  <para style="q1" vid="MIC 7:4">तुम्हर करा, परमेसर के आय के दिन हो गे हवय,</para>
  <para style="q2" vid="MIC 7:4">याने कि तुम्हर पहरेदार के खतरा के घंटी बजाय के दिन आ गे हवय।</para>
  <para style="q2" vid="MIC 7:4">अब तुम्हर घबराय के बेरा ए।<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />कोनो परोसी ऊपर बिसवास झन करबे,</para>
  <para style="q2" vid="MIC 7:5">अऊ न ही कोनो संगी ऊपर भरोसा करबे।</para>
  <para style="q1" vid="MIC 7:5">अऊ त अऊ अपन घरवाली, जऊन ह तोला धरके लेटथे,</para>
  <para style="q2" vid="MIC 7:5">ओकर ले घलो संभलके बात करबे।<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />काबरकि बेटा ह अपन ददा के अनादर करथे,</para>
  <para style="q2" vid="MIC 7:6">बेटी ह अपन दाई के बिरूध,</para>
  <para style="q1" vid="MIC 7:6">अऊ बहू ह अपन सास के बिरूध ठाढ़ होथे—</para>
  <para style="q2" vid="MIC 7:6">मनखे के बईरी ओकर खुद के परिवार के मनखेमन होथें।<verse eid="MIC 7:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />पर जहां तक मोर बात ए, मोर आसा ह यहोवा ऊपर लगे रहिथे,</para>
  <para style="q2" vid="MIC 7:7">में अपन उद्धार करइया परमेसर के बाट जोहथंव;</para>
  <para style="q2" vid="MIC 7:7">मोर परमेसर ह मोर बात ला सुनही।<verse eid="MIC 7:7" /></para>
  <para style="s1">इसरायल ह उठही</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />हे मोर बईरी, मोर दसा ऊपर आनंद झन मना!</para>
  <para style="q2" vid="MIC 7:8">हालाकि मेंह गिर गे हंव, पर मेंह ठाढ़ होहूं।</para>
  <para style="q1" vid="MIC 7:8">हालाकि मेंह अंधियार म बईठे हंव,</para>
  <para style="q2" vid="MIC 7:8">पर यहोवा ह मोर अंजोर होही।<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />काबरकि मेंह ओकर बिरूध पाप करे हंव,</para>
  <para style="q2" vid="MIC 7:9">एकरसेति मेंह तब तक यहोवा के कोरोध ला सहत रहिहूं,</para>
  <para style="q1" vid="MIC 7:9">जब तक कि ओह मोर मामला ला सुनके</para>
  <para style="q2" vid="MIC 7:9">मोला नियाय नइं देवय।</para>
  <para style="q1" vid="MIC 7:9">ओह मोला अंजोर म ले आही;</para>
  <para style="q2" vid="MIC 7:9">मेंह ओकर धरमीपन ला देखहूं।<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />तब मोर बईरी ह येला देखही</para>
  <para style="q2" vid="MIC 7:10">अऊ सरम के मारे अपन मुहूं ला ढांप लीही,</para>
  <para style="q1" vid="MIC 7:10">ये बईरी ओही अय, जऊन ह मोला कहिस,</para>
  <para style="q2" vid="MIC 7:10">“कहां हवय यहोवा तोर परमेसर?”</para>
  <para style="q1" vid="MIC 7:10">मेंह ओ बईरी के पतन ला देखहूं;</para>
  <para style="q2" vid="MIC 7:10">इहां तक कि ओह गली के चीखला सहीं</para>
  <para style="q2" vid="MIC 7:10">गोड़ खाल्हे रऊंदे जाही।<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />तुम्हर भीथीमन ला बनाय के दिन,</para>
  <para style="q2" vid="MIC 7:11">अऊ तुम्हर सीमनामन ला बढ़ाय के दिन ह आही।<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />ओ दिन मनखेमन तुम्हर करा</para>
  <para style="q2" vid="MIC 7:12">अस्सूर ले अऊ मिसर देस के सहरमन ले आहीं,</para>
  <para style="q1" vid="MIC 7:12">इहां तक कि मिसर देस ले लेके फरात नदी तक ले,</para>
  <para style="q2" vid="MIC 7:12">अऊ समुंदर ले लेके समुंदर के बीच के</para>
  <para style="q2" vid="MIC 7:12">अऊ पहाड़ ले लेके पहाड़ के बीच के देसमन ले मनखेमन तुम्हर करा आहीं।<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />धरती के निवासीमन के कारन, ओमन के काम के परिनाम स्वरूप,</para>
  <para style="q2" vid="MIC 7:13">धरती ह उजड़ जाही।<verse eid="MIC 7:13" /></para>
  <para style="s1">पराथना अऊ परसंसा</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14" />अपन मनखेमन के रखवारी,</para>
  <para style="q2" vid="MIC 7:14">अपन उत्तराधिकार म पाय झुंड के रखवारी अपन लउठी ले करव,</para>
  <para style="q1" vid="MIC 7:14">जऊन ह जंगल म,</para>
  <para style="q2" vid="MIC 7:14">अऊ उपजाऊ चरागन म अपन भरोसा म रहिथे।</para>
  <para style="q1" vid="MIC 7:14">ओमन ला बहुंत पहिले के सहीं</para>
  <para style="q2" vid="MIC 7:14">बासान अऊ गिलाद म चरन दव।<verse eid="MIC 7:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />“जब तुमन मिसर देस ले निकलके आयेव, ओ दिनमन सहीं,</para>
  <para style="q2" vid="MIC 7:15">मेंह ओमन ला अचरज के काम देखाहूं।”<verse eid="MIC 7:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />जाति-जाति के मनखेमन येला देखहीं</para>
  <para style="q2" vid="MIC 7:16">अऊ अपन सक्ति ले बंचित होके सरमिंदा होहीं।</para>
  <para style="q1" vid="MIC 7:16">ओमन सरम के मारे अपन मुहूं अपन हांथ ले ढांप लीहीं</para>
  <para style="q2" vid="MIC 7:16">अऊ ओमन के कानमन भैंरा हो जाहीं।<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />ओमन सांप सहीं,</para>
  <para style="q2" vid="MIC 7:17">अऊ भुइयां म रेंगइया जन्तु सहीं धुर्रा चाटहीं।</para>
  <para style="q1" vid="MIC 7:17">ओमन अपन मांद ले कांपत निकलहीं;</para>
  <para style="q2" vid="MIC 7:17">ओमन यहोवा हमर परमेसर ले डरहीं</para>
  <para style="q2" vid="MIC 7:17">अऊ तोर ले भयभीत होहीं।<verse eid="MIC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />तोर सहीं अऊ कोन परमेसर हवय,</para>
  <para style="q2" vid="MIC 7:18">जऊन ह अपन निज भाग के बांचे मनखेमन के</para>
  <para style="q2" vid="MIC 7:18">पाप अऊ अपराधमन ला छेमा करथे?</para>
  <para style="q1" vid="MIC 7:18">तोर कोरोध ह हमेसा बर नइं रहय</para>
  <para style="q2" vid="MIC 7:18">पर दया देखाय म तोला खुसी होथे।<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />तेंह हमर ऊपर फेर दया करबे;</para>
  <para style="q2" vid="MIC 7:19">तेंह अपन गोड़ खाल्हे हमर पापमन ला कुचर देबे</para>
  <para style="q2" vid="MIC 7:19">अऊ हमर दुस्टता के जम्मो काम ला गहिरा समुंदर म फटिक देबे।<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />जइसे कि बहुंत पहिले हमर पुरखामन ले किरिया खाके,</para>
  <para style="q2" vid="MIC 7:20">तेंह परतिगियां करे रहे, ओकरे मुताबिक</para>
  <para style="q1" vid="MIC 7:20">तेंह याकूब के मनखेमन बर बिसवासयोग्य बने रहिबे,</para>
  <para style="q2" vid="MIC 7:20">अऊ अब्राहम के बंस के मनखेमन ला मया देखाबे।<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>