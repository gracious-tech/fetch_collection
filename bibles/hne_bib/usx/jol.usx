<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">योएल</para>
  <para style="toc1">योएल के किताब</para>
  <para style="toc2">योएल</para>
  <para style="toc3">योए</para>
  <para style="mt1">योएल</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>यहोवा के ओ बचन जऊन ह पतूएल के बेटा योएल मेर आईस।<verse eid="JOL 1:1"/></para>
  <para style="b"/>
  <para style="s1">टिड्डीमन के धावा</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>हे अगुवामन, ये बात ला सुनव;</para>
  <para style="q2" vid="JOL 1:2">हे यहूदा देस म रहइया जम्मो मनखेमन, सुनव।</para>
  <para style="q1" vid="JOL 1:2">का तुम्हर समय म</para>
  <para style="q2" vid="JOL 1:2">या तुम्हर पुरखामन के समय म अइसन कोनो बात कभू होईस?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>अपन लइकामन ला ये बात बतावव,</para>
  <para style="q2" vid="JOL 1:3">अऊ तुम्हर लइकामन ये बात ला अपन लइकामन ला बतावंय,</para>
  <para style="q2" vid="JOL 1:3">अऊ ओ लइकामन ओमन के आघू के पीढ़ी ला बतावंय।<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>टिड्डीमन के दल ह जऊन ला छोंड़ दे रिहिन</para>
  <para style="q2" vid="JOL 1:4">ओला बड़े टिड्डीमन खा ले हवंय;</para>
  <para style="q1" vid="JOL 1:4">जऊन ला बड़े टिड्डीमन छोंड़ दे रिहिन</para>
  <para style="q2" vid="JOL 1:4">ओला छोटे टिड्डीमन खा ले हवंय;</para>
  <para style="q1" vid="JOL 1:4">जऊन ला छोटे टिड्डीमन छोंड़ दे रिहिन</para>
  <para style="q2" vid="JOL 1:4">ओला आने टिड्डीमन खा ले हवंय।<verse eid="JOL 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>हे मतवारमन जागव, अऊ रोवव!</para>
  <para style="q2" vid="JOL 1:5">हे जम्मो मंद पीनेवालामन, बिलाप करव;</para>
  <para style="q1" vid="JOL 1:5">नवां मंद के कारन बिलाप करव,</para>
  <para style="q2" vid="JOL 1:5">काबरकि येला तुम्हर मुहूं ले छीन ले गे हवय।<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>मोर देस ऊपर एक जाति ह चढ़ई कर दे हवय,</para>
  <para style="q2" vid="JOL 1:6">ओह एक सक्तिसाली सेना ए अऊ ओमन के संखिया अनगिनत हे,</para>
  <para style="q1" vid="JOL 1:6">ओकर दांत सिंह के दांत सहीं,</para>
  <para style="q2" vid="JOL 1:6">ओकर जबड़ा सिंहनी के जबड़ा सहीं हवय।<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>ओह मोर अंगूर के नारमन ला उजाड़ दे हवय</para>
  <para style="q2" vid="JOL 1:7">अऊ मोर अंजीर के रूखमन ला नास कर दे हवय।</para>
  <para style="q1" vid="JOL 1:7">ओह ओमन के छाली ला निकाल दे हवय</para>
  <para style="q2" vid="JOL 1:7">अऊ ओमन के साखामन ला सफेद छोंड़के</para>
  <para style="q2" vid="JOL 1:7">ओमन के छाली ला फटिक दे हवय।<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>अइसन बिलाप करव, जइसन एक कुंवारी ह बोरा के कपड़ा पहिरे</para>
  <para style="q2" vid="JOL 1:8">अपन जवानी म मंगेतर बर सोक करथे।<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>यहोवा के घर म</para>
  <para style="q2" vid="JOL 1:9">न तो अन्न-बलिदान अऊ न ही पेय-बलिदान चघाय जाथे।</para>
  <para style="q1" vid="JOL 1:9">यहोवा के सेवा करइया पुरोहितमन</para>
  <para style="q2" vid="JOL 1:9">बिलाप करत हवंय।<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>खेतमन नास हो गे हवंय,</para>
  <para style="q2" vid="JOL 1:10">भुइयां ह सूखा गे हवय;</para>
  <para style="q1" vid="JOL 1:10">अनाज ह नास हो गे हवय,</para>
  <para style="q2" vid="JOL 1:10">नवां अंगूर के मंद ह सूखा गे हवय,</para>
  <para style="q2" vid="JOL 1:10">जैतून के तेल खतम होवथे।<verse eid="JOL 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>हे किसानमन, निरास होवव,</para>
  <para style="q2" vid="JOL 1:11">हे अंगूर के नार लगानेवालामन, बिलाप करव;</para>
  <para style="q1" vid="JOL 1:11">गहूं अऊ जौ के अनाज बर दुखी होवव,</para>
  <para style="q2" vid="JOL 1:11">काबरकि खेत के फसल ह नास हो गे हवय।<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>अंगूर के नार ह सूखा गे हवय</para>
  <para style="q2" vid="JOL 1:12">अऊ अंजीर के रूख ह मुरझा गे हवय;</para>
  <para style="q1" vid="JOL 1:12">अनार, खजूर अऊ सेव के रूख—</para>
  <para style="q2" vid="JOL 1:12">मैदान के जम्मो रूख—सूखा गे हवंय।</para>
  <para style="q1" vid="JOL 1:12">सही म मनखे के आनंद ह</para>
  <para style="q2" vid="JOL 1:12">खतम हो गे हवय।<verse eid="JOL 1:12"/></para>
  <para style="s1">बिलाप बर बुलावा</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>हे पुरोहितमन, बोरा के कपड़ा पहिरके बिलाप करव;</para>
  <para style="q2" vid="JOL 1:13">तुमन जऊन मन बेदी करा सेवा करथव, बिलाप करव।</para>
  <para style="q1" vid="JOL 1:13">तुमन जऊन मन मोर परमेसर के आघू म सेवा करथव</para>
  <para style="q2" vid="JOL 1:13">आवव, अऊ बोरा के कपड़ा पहिरके रथिया बितावव;</para>
  <para style="q1" vid="JOL 1:13">काबरकि तुम्हर परमेसर के घर म</para>
  <para style="q2" vid="JOL 1:13">अन्न-बलिदान अऊ पेय-बलिदान चघाय बर बंद कर दिये गे हवय।<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>एक पबितर उपास के घोसना करव;</para>
  <para style="q2" vid="JOL 1:14">एक पबितर सभा के आयोजन करव।</para>
  <para style="q1" vid="JOL 1:14">अगुवामन ला अऊ ओ जम्मो</para>
  <para style="q2" vid="JOL 1:14">जऊन मन देस म रहिथें ओमन ला</para>
  <para style="q1" vid="JOL 1:14">यहोवा तुम्हर परमेसर के घर म बलावव,</para>
  <para style="q2" vid="JOL 1:14">अऊ यहोवा के आघू म गिड़गिड़ाके बिनती करव।<verse eid="JOL 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>ओ दिन बर हाय!</para>
  <para style="q2" vid="JOL 1:15">काबरकि यहोवा के दिन ह लकठा म हवय;</para>
  <para style="q2" vid="JOL 1:15">येह सर्वसक्तिमान<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">सद्दै</char></note> कोति ले बिनास के दिन बनके आही।<verse eid="JOL 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>का हमर देखत म</para>
  <para style="q2" vid="JOL 1:16">दाना-पानी बंद नइं हो गीस—</para>
  <para style="q1" vid="JOL 1:16">अऊ एही किसम ले हमर परमेसर के घर ले</para>
  <para style="q2" vid="JOL 1:16">आनंद अऊ खुसी खतम नइं हो गीस?<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>माटी के ढेलामन के खाल्हे</para>
  <para style="q2" vid="JOL 1:17">बीजामन झुलस गे हवंय।</para>
  <para style="q1" vid="JOL 1:17">गोदाममन खंडहर होवत हें,</para>
  <para style="q2" vid="JOL 1:17">अन्न-भंडारमन ला गिरा दिये गे हवय,</para>
  <para style="q2" vid="JOL 1:17">काबरकि फसल नइं होईस।<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>पसुमन कइसे कराहत हवंय!</para>
  <para style="q2" vid="JOL 1:18">पसुमन के झुंडमन बियाकुल होके भटकत हवंय</para>
  <para style="q1" vid="JOL 1:18">काबरकि ओमन बर चरागन नइं ए;</para>
  <para style="q2" vid="JOL 1:18">इहां तक कि भेड़मन के झुंड घलो तकलीफ म हवंय।<verse eid="JOL 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>हे यहोवा, मेंह तोला पुकारत हंव,</para>
  <para style="q2" vid="JOL 1:19">काबरकि सुनसान जगह के चरागनमन ला आगी ह नास कर दे हवय</para>
  <para style="q2" vid="JOL 1:19">अऊ आगी के लपटा ले मैदान के जम्मो रूखमन जर गे हवंय।<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>अऊ त अऊ जंगली पसुमन तोर कामना करथें;</para>
  <para style="q2" vid="JOL 1:20">पानी के सोतमन सूखा गे हवंय</para>
  <para style="q2" vid="JOL 1:20">अऊ सुन्ना जगह के चरागनमन ला आगी ह नास कर दे हवय।<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">फांफामन के दल</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>सियोन म तुरही फूंकव;</para>
  <para style="q2" vid="JOL 2:1">मोर पबितर पहाड़ी म खतरा के घंटी बजावव।</para>
  <para style="b" vid="JOL 2:1"/>
  <para style="q1" vid="JOL 2:1">देस म रहइया जम्मो झन कांपंय,</para>
  <para style="q2" vid="JOL 2:1">काबरकि यहोवा के दिन आवत हे।</para>
  <para style="q1" vid="JOL 2:1">ओह लकठा म आ गे हवय—<verse eid="JOL 2:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2"/>ओ दिन ह अंधियार अऊ धुंधलापन के दिन अय,</para>
  <para style="q2" vid="JOL 2:2">ओह बादर ले भरे अंधियार के दिन अय।</para>
  <para style="q1" vid="JOL 2:2">जइसने पहाड़ ऊपर बिहनियां के अंजोर बगरथे</para>
  <para style="q2" vid="JOL 2:2">वइसने ही एक बड़े अऊ सक्तिसाली सेना आथे,</para>
  <para style="q1" vid="JOL 2:2">अइसने बात जऊन ह कि पुराना जमाना म कभू नइं होईस</para>
  <para style="q2" vid="JOL 2:2">अऊ न ही अवइया समय म कभू अइसने होही।<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>ओमन के आघू म आगी ह बिनास के काम करथे,</para>
  <para style="q2" vid="JOL 2:3">ओमन के पाछू कोति आगी के लपटा उठथे।</para>
  <para style="q1" vid="JOL 2:3">ओमन के आघू म देस ह अदन के बगीचा सहीं हवय,</para>
  <para style="q2" vid="JOL 2:3">अऊ ओमन के पाछू, एक उजाड़ मरू-भुइयां—</para>
  <para style="q2" vid="JOL 2:3">कोनो चीज ओमन ले नइं बचय।<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>ओमन घोड़ामन सहीं दिखथें;</para>
  <para style="q2" vid="JOL 2:4">ओमन घुड़सवार सेना सहीं सरपट भागथें।<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>रथमन सहीं अवाज के संग</para>
  <para style="q2" vid="JOL 2:5">ओमन पहाड़ के चोटीमन ऊपर कूद जाथें,</para>
  <para style="q1" vid="JOL 2:5">धधकत आगी सहीं ओमन ठूंठमन ला भसम करत जाथें,</para>
  <para style="q2" vid="JOL 2:5">ओमन लड़ई बर तियार सक्तिसाली सेना सहीं अंय।<verse eid="JOL 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>ओमन के नजर पड़त ही जाति-जाति के मनखेमन पीरा म पड़ जाथें;</para>
  <para style="q2" vid="JOL 2:6">हर एक के चेहरा ह डर ले पिंवरा पड़ जाथे।<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>ओमन योद्धा सहीं हमला करथें;</para>
  <para style="q2" vid="JOL 2:7">ओमन सैनिकमन सहीं सहर के दीवारमन ऊपर चढ़ जाथें।</para>
  <para style="q1" vid="JOL 2:7">ओमन जम्मो कतार म होके आघू बढ़थें,</para>
  <para style="q2" vid="JOL 2:7">ओमन अपन क्रम ले नइं हटंय।<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>ओमन एक-दूसर ला नइं ढकेलंय;</para>
  <para style="q2" vid="JOL 2:8">हर एक ह सीधा आघू बढ़थे।</para>
  <para style="q1" vid="JOL 2:8">ओमन अपन क्रम ला बिगर टोरे</para>
  <para style="q2" vid="JOL 2:8">समस्या ले होके निकल जाथें।<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>ओमन तेजी ले सहर म घुसरथें;</para>
  <para style="q2" vid="JOL 2:9">ओमन दीवारमन के तीरे-तीर दऊड़थें।</para>
  <para style="q1" vid="JOL 2:9">ओमन घरमन म चघ जाथें;</para>
  <para style="q2" vid="JOL 2:9">ओमन चोरमन सहीं खिड़कीमन ले भीतर घुसरथें।<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>ओमन के आघू म धरती ह डोल जाथे,</para>
  <para style="q2" vid="JOL 2:10">अकास ह कांपथे,</para>
  <para style="q1" vid="JOL 2:10">सूरज अऊ चंदा धुंधला हो जाथें,</para>
  <para style="q2" vid="JOL 2:10">अऊ तारामन फेर नइं चमकंय।<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>यहोवा ह अपन सेना के आघू म होके</para>
  <para style="q2" vid="JOL 2:11">ऊंचहा अवाज म आदेस करथे;</para>
  <para style="q1" vid="JOL 2:11">ओकर सेना के संखिया अनगिनत हे,</para>
  <para style="q2" vid="JOL 2:11">अऊ ओ सेना ह सक्तिसाली ए, जऊन ह ओकर आदेस ला मानथे।</para>
  <para style="q1" vid="JOL 2:11">यहोवा के दिन ह महान ए;</para>
  <para style="q2" vid="JOL 2:11">येह भयानक ए।</para>
  <para style="q2" vid="JOL 2:11">येला कोन ह सह सकथे?<verse eid="JOL 2:11"/></para>
  <para style="s1">अपन मन ला चीरव</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>“तभो ले अब,” यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="JOL 2:12">“तुमन अपन पूरा मन से उपास करत</para>
  <para style="q2" vid="JOL 2:12">अऊ रोवत अऊ बिलाप करत मोर करा लहुंट आवव।”<verse eid="JOL 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>अपन कपड़ामन ला नइं,</para>
  <para style="q2" vid="JOL 2:13">पर अपन मन ला चीरव।</para>
  <para style="q1" vid="JOL 2:13">यहोवा अपन परमेसर करा लहुंट आवव,</para>
  <para style="q2" vid="JOL 2:13">काबरकि ओह अनुग्रहकारी अऊ करूनामय,</para>
  <para style="q1" vid="JOL 2:13">गुस्सा करे म धीमा अऊ बहुंत मया करइया ए,</para>
  <para style="q2" vid="JOL 2:13">अऊ बिपत्ति भेजे म नमरता देखाथे।<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>कोन जाने? ओह अपन बिचार ला बदलके नमरता देखाय</para>
  <para style="q2" vid="JOL 2:14">अऊ अपन पाछू एक आसीस छोंड़ जाय—</para>
  <para style="q1" vid="JOL 2:14">यहोवा तुम्हर परमेसर बर</para>
  <para style="q2" vid="JOL 2:14">अन्न-बलिदान अऊ पेय-बलिदान।<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>सियोन म तुरही फूंकव,</para>
  <para style="q2" vid="JOL 2:15">एक पबितर उपास के घोसना करव,</para>
  <para style="q2" vid="JOL 2:15">एक पबितर सभा करव।<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>मनखेमन ला इकट्ठा करव,</para>
  <para style="q2" vid="JOL 2:16">सभा ला पबितर करव;</para>
  <para style="q1" vid="JOL 2:16">अगुवामन ला एक संग लानव,</para>
  <para style="q2" vid="JOL 2:16">लइकामन ला, दूध पीयइया छोटे लइकामन ला</para>
  <para style="q2" vid="JOL 2:16">इकट्ठा करव।</para>
  <para style="q1" vid="JOL 2:16">दूल्हा अपन कमरा ला</para>
  <para style="q2" vid="JOL 2:16">अऊ दुलहिन अपन कोठरी ला छोंड़के बाहिर आवंय।<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>पुरोहित, जेमन यहोवा के आघू म सेवा करथें,</para>
  <para style="q2" vid="JOL 2:17">मंडप अऊ बेदी के बीच म रोवंय।</para>
  <para style="q1" vid="JOL 2:17">ओमन कहंय, “हे यहोवा, अपन मनखेमन ला बचा।</para>
  <para style="q2" vid="JOL 2:17">अपन खुद के मनखेमन ला जाति-जाति के मनखेमन के बीच म</para>
  <para style="q2" vid="JOL 2:17">ठट्ठा के बिसय, एक कहावत झन बना।</para>
  <para style="q1" vid="JOL 2:17">ओमन मनखेमन के बीच म काबर कहंय,</para>
  <para style="q2" vid="JOL 2:17">‘कहां हवय ओमन के परमेसर?’ ”<verse eid="JOL 2:17"/></para>
  <para style="s1">यहोवा के जबाब</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>तब यहोवा ला अपन देस बर जलन होईस</para>
  <para style="q2" vid="JOL 2:18">अऊ ओह अपन मनखेमन ऊपर तरस खाईस।<verse eid="JOL 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19"/>यहोवा ह ओमन ला जबाब दीस:</para>
  <para style="q1" vid="JOL 2:19">“मेंह तुम्हर बर अनाज, नवां अंगूर के मंद</para>
  <para style="q2" vid="JOL 2:19">अऊ जैतून के तेल भरपूर मात्रा म पठोवत हवंव,</para>
  <para style="q2" vid="JOL 2:19">ताकि तुमन पूरा संतुस्ट हो जावव;</para>
  <para style="q1" vid="JOL 2:19">मेंह तुमन ला आनजातमन बर</para>
  <para style="q2" vid="JOL 2:19">फेर कभू हंसी के पात्र नइं बनावंव।<verse eid="JOL 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>“मेंह उत्तर के उपदरवी दल ला तुम्हर ले दूरिहा भगा दूहूं,</para>
  <para style="q2" vid="JOL 2:20">अऊ ओला एक सूखा अऊ बंजर देस कर दूहूं;</para>
  <para style="q1" vid="JOL 2:20">ओकर पूरब के भाग मिरतू सागर</para>
  <para style="q2" vid="JOL 2:20">अऊ पछिमी भाग भूमध्य सागर म डूब जाही।</para>
  <para style="q1" vid="JOL 2:20">अऊ येकर दुरगंध ह ऊपर जाही;</para>
  <para style="q2" vid="JOL 2:20">येकर गंध ह उठते रहिही।”</para>
  <para style="b" vid="JOL 2:20"/>
  <para style="q1" vid="JOL 2:20">सही म ओह बड़े-बड़े काम करे हवय!<verse eid="JOL 2:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21"/>हे यहूदा देस, झन डर;</para>
  <para style="q2" vid="JOL 2:21">खुस अऊ आनंदित हो।</para>
  <para style="q1" vid="JOL 2:21">सही म यहोवा ह बड़े-बड़े काम करे हवय!<verse eid="JOL 2:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22"/>हे जंगली पसुमन, झन डरव,</para>
  <para style="q2" vid="JOL 2:22">काबरकि निरजन जगह के चरागनमन हरा-भरा होवत हें।</para>
  <para style="q1" vid="JOL 2:22">रूखमन म फर लगत हवंय;</para>
  <para style="q2" vid="JOL 2:22">अंजीर के रूख अऊ अंगूर के नार भरपूर फसल देवत हें।<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>हे सियोन के मनखेमन, खुस रहव,</para>
  <para style="q2" vid="JOL 2:23">यहोवा अपन परमेसर म आनंदित रहव,</para>
  <para style="q1" vid="JOL 2:23">काबरकि ओह तुमन ला सरद महिना के बारिस दे हवय</para>
  <para style="q2" vid="JOL 2:23">काबरकि ओह बिसवासयोग्य अय।</para>
  <para style="q1" vid="JOL 2:23">ओह तुमन ला बहुंत बारिस दे हवय,</para>
  <para style="q2" vid="JOL 2:23">पहिले सहीं सरद अऊ बसन्त महिना के बारिस दे हवय।<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>कोठार ह अनाज ले भर जाही;</para>
  <para style="q2" vid="JOL 2:24">कुंडमन नवां अंगूर के मंद अऊ तेल के बहुंतायत के कारन छलके लगहीं।<verse eid="JOL 2:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>“मेंह तुमन ला ओ जम्मो बछर के फसल के भरपई कर दूहूं, जऊन ला फांफामन खा ले हवंय—</para>
  <para style="q2" vid="JOL 2:25">बड़े फांफा अऊ छोटे फांफा,</para>
  <para style="q2" vid="JOL 2:25">आने फांफा अऊ फांफामन के दल—</para>
  <para style="q1" vid="JOL 2:25">मोर बड़े सेना जऊन ला मेंह तुम्हर बीच म पठोय रहेंव।<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>तुम्हर करा खाय बर बहुंत जेवन होही अऊ तुमन पेट भर खाहू,</para>
  <para style="q2" vid="JOL 2:26">अऊ तुमन यहोवा अपन परमेसर के नांव के इस्तुति करहू,</para>
  <para style="q2" vid="JOL 2:26">जऊन ह तुम्हर बर अद्भूत काम करे हवय;</para>
  <para style="q1" vid="JOL 2:26">मोर मनखेमन फेर कभू लज्जा म नइं पड़हीं।<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>तब तुमन जानहू कि मेंह इसरायल म हवंव,</para>
  <para style="q2" vid="JOL 2:27">अऊ ये कि मेंह यहोवा तुम्हर परमेसर अंव,</para>
  <para style="q2" vid="JOL 2:27">अऊ ये कि मोर अलावा अऊ कोनो परमेसर नइं ए;</para>
  <para style="q1" vid="JOL 2:27">मोर मनखेमन फेर कभू लज्जा म नइं पड़हीं।<verse eid="JOL 2:27"/></para>
  <para style="s1">यहोवा के दिन</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>“अऊ ओकर बाद,</para>
  <para style="q2" vid="JOL 2:28">मेंह अपन आतमा ला जम्मो मनखेमन ऊपर उंडेलहूं।</para>
  <para style="q1" vid="JOL 2:28">तुम्हर बेटा अऊ बेटीमन अगमबानी करहीं,</para>
  <para style="q2" vid="JOL 2:28">अऊ तुम्हर सियानमन सपना देखहीं,</para>
  <para style="q2" vid="JOL 2:28">तुम्हर जवानमन दरसन देखहीं।<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>मेंह अपन दास अऊ अपन दासीमन ऊपर घलो</para>
  <para style="q2" vid="JOL 2:29">ओ दिन म अपन आतमा उंडेलहूं।<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>मेंह ऊपर अकास म</para>
  <para style="q2" vid="JOL 2:30">अऊ खाल्हे धरती म अद्भूत काम,</para>
  <para style="q2" vid="JOL 2:30">याने कि लहू, आगी अऊ धुआं के बादर देखाहूं।<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>यहोवा के महान अऊ भयानक दिन के आय के पहिली</para>
  <para style="q2" vid="JOL 2:31">सूरज ह अंधियार</para>
  <para style="q2" vid="JOL 2:31">अऊ चंदा ह लहू सहीं हो जाही।<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>अऊ हर एक, जऊन ह यहोवा के नांव लीही,</para>
  <para style="q2" vid="JOL 2:32">ओह उद्धार पाही;</para>
  <para style="q1" vid="JOL 2:32">काबरकि छुटकारा सियोन पहाड़</para>
  <para style="q2" vid="JOL 2:32">अऊ यरूसलेम म होही,</para>
  <para style="q2" vid="JOL 2:32">जइसने कि यहोवा ह कहे हवय,</para>
  <para style="q1" vid="JOL 2:32">अऊ त अऊ बचनेवालामन म ओ मनखेमन घलो होहीं</para>
  <para style="q2" vid="JOL 2:32">जेमन ला यहोवा ह बलाही।<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">जाति-जाति के मनखेमन के नियाय करई</para>
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">3 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="JOL 3:1-21">3:1‑21</ref></char> ला 4:1‑21 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="JOL 3:1"/>“ओ दिनमन म अऊ ओ समय म,</para>
  <para style="q2" vid="JOL 3:1">जब में यहूदा अऊ यरूसलेम के मनखेमन के जिनगी ला फेर ठीक कर दूहूं,<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>त में जम्मो जाति के मनखेमन ला इकट्ठा करहूं</para>
  <para style="q2" vid="JOL 3:2">अऊ ओमन ला खाल्हे यहोसापात<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">यहोसापात </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">यहोवा नियाय करथे</char></note> के घाटी म ले आहूं।</para>
  <para style="q1" vid="JOL 3:2">उहां मेंह ओमन के ओ काम बर परिछा करहूं</para>
  <para style="q2" vid="JOL 3:2">जऊन काम ओमन मोर निज भाग, मोर मनखे इसरायलीमन संग करे हवंय,</para>
  <para style="q1" vid="JOL 3:2">काबरकि ओमन मोर मनखेमन ला जाति-जाति के मनखेमन के बीच म तितिर-बितिर कर दे हवंय</para>
  <para style="q2" vid="JOL 3:2">अऊ मोर देस के बंटवारा कर दे हवंय।<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>ओमन मोर मनखेमन बर चिट्ठी निकालथें</para>
  <para style="q2" vid="JOL 3:3">अऊ बेस्यामन के बदला म लड़कामन ला देय दे हवंय;</para>
  <para style="q2" vid="JOL 3:3">ओमन मंद पीये बर नोनीमन ला बेच दे हवंय।<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>“हे सूर अऊ सीदोन अऊ पलिस्ती के जम्मो इलाका के मनखेमन, अब तुम्हर करा मोर बिरूध म का हवय? जऊन काम मेंह करे हवंव, का तुमन ओकर बदला चुकावत हव? यदि तुमन मोला वापिस बदला चुकावत हव, त में तुरते, जल्दी करत, तुम्हर दुवारा करे गे काममन ला वापिस तुम्हरेच मुड़ म डार दूहूं। <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>काबरकि तुमन मोर सोन अऊ मोर चांदी ला लेय ले हव अऊ मोर कीमती खजानामन ला अपन मंदिर<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">महल</char></note> म ले गेय हव। <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>तुमन यहूदा अऊ यरूसलेम के मनखेमन ला यूनानीमन के हांथ म बेच दे हवव, ताकि तुमन ओमन ला ओमन के देस ले दूरिहा पठो सकव।<verse eid="JOL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7"/>“देखव, मेंह ओमन ला ओ जगहमन ले लहुंटाके लानेवाला हंव, जिहां तुमन ओमन ला बेच दे रहेव, अऊ तुम्हर करे गे काममन ला वापिस तुम्हरेच मुड़ ऊपर डाल दूहूं। <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>मेंह तुम्हर बेटा अऊ बेटीमन ला यहूदा के मनखेमन के हांथ म बेच दूहूं, अऊ यहूदा के मनखेमन ओमन ला बहुंत दूर रहइया एक जाति सबायीमन के हांथ म बेच दीहीं।” यहोवा ह कहे हवय।<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>जाति-जाति के मनखेमन के बीच म ये घोसना करव:</para>
  <para style="q2" vid="JOL 3:9">लड़ई के तियारी करव!</para>
  <para style="q1" vid="JOL 3:9">योद्धामन ला उत्तेजित करव!</para>
  <para style="q2" vid="JOL 3:9">लड़इया जम्मो मनखेमन लकठा म आवंय अऊ हमला करंय।<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>अपन नांगर के फाल ला पीटके तलवार बना लव</para>
  <para style="q2" vid="JOL 3:10">अऊ अपन हंसियामन ला पीटके ओमन के बरछी बना लव।</para>
  <para style="q1" vid="JOL 3:10">जऊन ह दुरबल हवय, ओह कहय,</para>
  <para style="q2" vid="JOL 3:10">“मेंह बलवान अंव!”<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>हे चारों कोति के जाति-जाति के जम्मो मनखेमन, जल्दी आवव,</para>
  <para style="q2" vid="JOL 3:11">अऊ उहां तुमन जूरव।</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">हे यहोवा, अपन योद्धामन ला खाल्हे ले आ!<verse eid="JOL 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>“जाति-जाति के मनखेमन उत्तेजित होवंय;</para>
  <para style="q2" vid="JOL 3:12">अऊ ओमन यहोसापात के घाटी म जावंय,</para>
  <para style="q1" vid="JOL 3:12">काबरकि मेंह उहां चारों कोति के जाति-जाति के</para>
  <para style="q2" vid="JOL 3:12">जम्मो मनखेमन के नियाय करे बर बईठहूं।<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>हंसिया चलाय के सुरू करव,</para>
  <para style="q2" vid="JOL 3:13">काबरकि फसल ह पाक गे हवय।</para>
  <para style="q1" vid="JOL 3:13">आवव, अंगूर ला रऊंदव,</para>
  <para style="q2" vid="JOL 3:13">काबरकि अंगूर-रस के कुंड ह भर गे हवय</para>
  <para style="q2" vid="JOL 3:13">अऊ कुंडमन छलकत हवंय—</para>
  <para style="q1" vid="JOL 3:13">ओमन के दुस्टता बहुंत जादा हो गे हवय!”<verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>निरनय के घाटी म</para>
  <para style="q2" vid="JOL 3:14">मनखेमन के भीड़ ही भीड़ हवय!</para>
  <para style="q1" vid="JOL 3:14">काबरकि निरनय के घाटी म</para>
  <para style="q2" vid="JOL 3:14">यहोवा के दिन ह लकठा म हवय।<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>सूरज अऊ चंदा म अंधियार छा जाही,</para>
  <para style="q2" vid="JOL 3:15">अऊ तारामन के चमकई ह बंद हो जाही।<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>यहोवा ह सियोन ले गरजही</para>
  <para style="q2" vid="JOL 3:16">अऊ यरूसलेम ले गरजन सुनई दीही;</para>
  <para style="q2" vid="JOL 3:16">अकास अऊ धरती कांप उठहीं।</para>
  <para style="q1" vid="JOL 3:16">पर यहोवा ह अपन मनखेमन बर एक सरन-स्थान,</para>
  <para style="q2" vid="JOL 3:16">अऊ इसरायल के मनखेमन बर एक सुरकछा गढ़ होही।<verse eid="JOL 3:16"/></para>
  <para style="s1">परमेसर के मनखेमन बर आसीस</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>“तब तुमन जानहू कि में, यहोवा ही तुम्हर परमेसर अंव,</para>
  <para style="q2" vid="JOL 3:17">अऊ अपन पबितर पहाड़ी, सियोन म निवास करथंव।</para>
  <para style="q1" vid="JOL 3:17">यरूसलेम ह एक पबितर सहर होही;</para>
  <para style="q2" vid="JOL 3:17">परदेसीमन फेर कभू ओकर ऊपर हमला नइं करहीं।<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>“ओ दिन पहाड़मन ले नवां अंगूर के मंद टपकही,</para>
  <para style="q2" vid="JOL 3:18">अऊ पहाड़ीमन ले दूध के धारा बोहाही;</para>
  <para style="q2" vid="JOL 3:18">यहूदा के जम्मो टीलामन म पानी बोहाही।</para>
  <para style="q1" vid="JOL 3:18">यहोवा के घर ले पानी के एक सोता फूट निकलही</para>
  <para style="q2" vid="JOL 3:18">अऊ सित्तीम घाटी<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बंबरी के घाटी</char></note> के सिंचई करही।<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>पर मिसर देस उजाड़ हो जाही,</para>
  <para style="q2" vid="JOL 3:19">अऊ एदोम ह एक बेकार निरजन देस हो जाही,</para>
  <para style="q1" vid="JOL 3:19">काबरकि येमन यहूदा के मनखेमन ऊपर अतियाचार करिन,</para>
  <para style="q2" vid="JOL 3:19">अऊ येमन ओमन के देस म निरदोस मनखेमन के खून बोहाईन।<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>यहूदा म मनखेमन हमेसा निवास करत रहिहीं</para>
  <para style="q2" vid="JOL 3:20">अऊ यरूसलेम म मनखेमन पीढ़ी-पीढ़ी तक रहिहीं।<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>का में ओ निरदोस मनखेमन के खून के बदला लिये बिगर छोंड़ दंव?</para>
  <para style="q2" vid="JOL 3:21">नइं, बिलकुल नइं।”</para>
  <para style="b" vid="JOL 3:21"/>
  <para style="qc" vid="JOL 3:21">यहोवा ह सियोन म निवास करथे!<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
