<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">यसायाह</para>
  <para style="toc1">यसायाह के किताब</para>
  <para style="toc2">यसायाह</para>
  <para style="toc3">यसा</para>
  <para style="mt1">यसायाह</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="ISA 1" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1" />आमोस के बेटा यसायाह के दरसन, जऊन ला ओह यहूदा अऊ यरूसलेम के बारे म उजियाह, योताम, आहाज, अऊ हिजकियाह नांव यहूदा के राजामन के सासन के दौरान देखिस।<verse eid="ISA 1:1" /></para>
  <para style="b" />
  <para style="s1">एक बिदरोही जाति</para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 1:2" />हे स्वरग, तें मोर बात ला सुन! अऊ हे धरती सुन!</para>
  <para style="q2" vid="ISA 1:2">काबरकि यहोवा ह कहे हवय:</para>
  <para style="q1" vid="ISA 1:2">“मेंह लइकामन ला पालेंव-पोसेंव अऊ ओमन ला बढ़ांय,</para>
  <para style="q2" vid="ISA 1:2">पर ओमन मोर ले बिदरोह करिन।<verse eid="ISA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 1:3" />बईला ह तो अपन मालिक ला,</para>
  <para style="q2" vid="ISA 1:3">अऊ गदहा ह अपन मालिक के कोटना ला चिन्हथे,</para>
  <para style="q1" vid="ISA 1:3">पर इसरायल ह मोला नइं जानय,</para>
  <para style="q2" vid="ISA 1:3">मोर मनखेमन नइं समझंय।”<verse eid="ISA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 1:4" />हाय लगे ये पापी जाति के मनखेमन ऊपर,</para>
  <para style="q2" vid="ISA 1:4">जेमन के अपराध ह बहुंत भारी हवय,</para>
  <para style="q1" vid="ISA 1:4">जेमन कुकरमीमन के पीला अंय,</para>
  <para style="q2" vid="ISA 1:4">जेमन के लइकामन भ्रस्टाचार करे बर दे दिये जाथें!</para>
  <para style="q1" vid="ISA 1:4">ओमन यहोवा ला छोंड़ देय हवंय;</para>
  <para style="q2" vid="ISA 1:4">ओमन इसरायल के पबितर परमेसर के अपमान करे हवंय</para>
  <para style="q2" vid="ISA 1:4">अऊ ओकर कोति अपन पीठ कर ले हवंय।<verse eid="ISA 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 1:5" />तुमन काबर अऊ मार खावव?</para>
  <para style="q2" vid="ISA 1:5">तुमन काबर बिदरोह करते रहिथव?</para>
  <para style="q1" vid="ISA 1:5">तुम्हर मुड़ म चोट लगे हवय,</para>
  <para style="q2" vid="ISA 1:5">अऊ तुम्हर पूरा हिरदय ह दुख ले भरे हवय।<verse eid="ISA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 1:6" />तुम्हर गोड़ के तलवा ले लेके मुड़ के ऊपर तक</para>
  <para style="q2" vid="ISA 1:6">कुछू घलो ठीक नइं ए—</para>
  <para style="q1" vid="ISA 1:6">सिरिप घाव ही घाव</para>
  <para style="q2" vid="ISA 1:6">अऊ खुला पीरा देवइया फोड़ामन हवंय,</para>
  <para style="q1" vid="ISA 1:6">जेमन ला न साफ करे गे हवय अऊ न ही पट्टी बांधे गे हवय</para>
  <para style="q2" vid="ISA 1:6">अऊ न ही जैतून तेल लगाके नरम करे गे हवय।<verse eid="ISA 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 1:7" />तुम्हर देस ह उजार परे हवय,</para>
  <para style="q2" vid="ISA 1:7">तुम्हर नगरमन आगी ले जर गे हवंय;</para>
  <para style="q1" vid="ISA 1:7">तुम्हर खेतमन ला परदेसीमन</para>
  <para style="q2" vid="ISA 1:7">तुम्हर देखते-देखत ले लेवत हवंय,</para>
  <para style="q2" vid="ISA 1:7">ओमन उजार परे हवंय, मानो अजनबीमन ओला नास कर दे हवंय।<verse eid="ISA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 1:8" />बेटी सियोन ला</para>
  <para style="q2" vid="ISA 1:8">अंगूर के बारी के आसरय सहीं,</para>
  <para style="q1" vid="ISA 1:8">खीरा-बारी के झोपड़ी सहीं,</para>
  <para style="q2" vid="ISA 1:8">या घेराबंदी करे गय एक नगर के सहीं छोंड़ दिये गे हवय।<verse eid="ISA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 1:9" />यदि सर्वसक्तिमान यहोवा ह</para>
  <para style="q2" vid="ISA 1:9">हमर बर कुछू बांचेमन ला नइं छोंड़े होतिस,</para>
  <para style="q1" vid="ISA 1:9">त हमन घलो सदोम</para>
  <para style="q2" vid="ISA 1:9">अऊ अमोरा सहरमन सहीं पूरा नास हो गे रहितेंन।<verse eid="ISA 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 1:10" />हे सदोम के सासन करइयामन,</para>
  <para style="q2" vid="ISA 1:10">यहोवा के बचन ला सुनव;</para>
  <para style="q1" vid="ISA 1:10">हे अमोरा के मनखेमन,</para>
  <para style="q2" vid="ISA 1:10">परमेसर के हुकूम ऊपर धियान देवव!<verse eid="ISA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 1:11" />यहोवा ह कहत हे,</para>
  <para style="q2" vid="ISA 1:11">“तुम्हर बहुंत अकन बलिदानमन</para>
  <para style="q2" vid="ISA 1:11">मोर का काम के अंय?</para>
  <para style="q1" vid="ISA 1:11">मोर करा मेढ़ा अऊ मोटा-ताजा पसुमन के चरबी के</para>
  <para style="q2" vid="ISA 1:11">जरूरत ले जादा होम-बलिदान हवय;</para>
  <para style="q1" vid="ISA 1:11">मेंह बछवा अऊ मेढ़ा-पीला अऊ बोकरामन के</para>
  <para style="q2" vid="ISA 1:11">लहू ले खुस नइं होवंव।<verse eid="ISA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 1:12" />जब तुमन मोर मेर भेंट करे बर आथव,</para>
  <para style="q2" vid="ISA 1:12">त कोन ह कहिथे</para>
  <para style="q2" vid="ISA 1:12">कि तुमन मोर अंगना ला गोड़ ले खुंदव?<verse eid="ISA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 1:13" />बेकार के बलिदान लाय बर बंद करव!</para>
  <para style="q2" vid="ISA 1:13">तुम्हर धूप ले मोला घिन होथे।</para>
  <para style="q1" vid="ISA 1:13">नवां चंदा, बिसराम दिन अऊ समारोहमन—</para>
  <para style="q2" vid="ISA 1:13">तुम्हर बेकार के ये सभामन ला मेंह सहन नइं कर सकंव।<verse eid="ISA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 1:14" />तुम्हर नवां चंदा के जेवनार अऊ तुम्हर ठहिराय गय तिहारमन ले</para>
  <para style="q2" vid="ISA 1:14">मेंह अपन पूरा मन से घिन करथंव।</para>
  <para style="q1" vid="ISA 1:14">येमन मोर बर एक बोझ बन गे हवंय;</para>
  <para style="q2" vid="ISA 1:14">मेंह येमन के बोझ उठावत थक गे हंव।<verse eid="ISA 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 1:15" />जब तुमन पराथना म अपन हांथ फईलाथव,</para>
  <para style="q2" vid="ISA 1:15">त मेंह तुम्हर ले अपन आंखी मुंद लेथंव;</para>
  <para style="q1" vid="ISA 1:15">अऊ तुम्हर कतको पराथना करे ले घलो</para>
  <para style="q2" vid="ISA 1:15">मेंह तुम्हर नइं सुनंव।</para>
  <para style="b" vid="ISA 1:15" />
  <para style="q1" vid="ISA 1:15">“काबरकि तुम्हर हांथमन खून ले भरे हवंय!<verse eid="ISA 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 1:16" />“अपनआप ला धोके सुध करव।</para>
  <para style="q2" vid="ISA 1:16">मोर आंखी के आघू ले अपन दुस्ट काममन ला हटावव;</para>
  <para style="q2" vid="ISA 1:16">बुरई करई बर छोंड़ दव।<verse eid="ISA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 1:17" />भलई करे बर सीखव; नियाय के खोज म रहव।</para>
  <para style="q2" vid="ISA 1:17">जेमन ऊपर अतियाचार होथे, ओमन के मदद करव।<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अतियाचारीमन ला सुधारव</char></note></para>
  <para style="q1" vid="ISA 1:17">अनाथमन के नियाय करव;</para>
  <para style="q2" vid="ISA 1:17">बिधवामन के मुकदमा लड़व।”<verse eid="ISA 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 1:18" />यहोवा ह कहत हे,</para>
  <para style="q2" vid="ISA 1:18">“अब आवव, हमन मामला ला निपटावन;</para>
  <para style="q1" vid="ISA 1:18">चाहे तुम्हर पापमन बैंगनी रंग के सहीं होवंय,</para>
  <para style="q2" vid="ISA 1:18">तभो ले ओमन बरफ के सहीं सफेद हो जाहीं;</para>
  <para style="q1" vid="ISA 1:18">चाहे तुम्हर पापमन गाढ़ा लाल रंग के होवंय,</para>
  <para style="q2" vid="ISA 1:18">तभो ले ओमन ऊन कस सादा हो जाहीं।<verse eid="ISA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 1:19" />यदि तुम्हर ईछा हवय अऊ मोर हुकूम ला मानव,</para>
  <para style="q2" vid="ISA 1:19">त तुमन ला देस के बढ़िया-बढ़िया चीज खाय बर मिलही;<verse eid="ISA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 1:20" />पर यदि तुमन नइं मानहू अऊ बिदरोह करहू,</para>
  <para style="q2" vid="ISA 1:20">त तुमन तलवार ले मारे जाहू।”</para>
  <para style="q1" vid="ISA 1:20">काबरकि यहोवा के मुहूं ले ये बचन निकले हवय।<verse eid="ISA 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 1:21" />देखव, ओ बिसवासयोग्य नगर ह</para>
  <para style="q2" vid="ISA 1:21">कइसे एक बेस्या के सहीं हो गे हवय!</para>
  <para style="q1" vid="ISA 1:21">एक समय रिहिस कि ओह नियाय ले भरे रिहिस;</para>
  <para style="q2" vid="ISA 1:21">धरमीपन उहां पाय जावत रिहिस—</para>
  <para style="q2" vid="ISA 1:21">पर अब उहां हतियारामन रहिथें!<verse eid="ISA 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 1:22" />तुम्हर चांदी ह मईला गे हवय,</para>
  <para style="q2" vid="ISA 1:22">तुम्हर खांटी अंगूर के मंद म पानी मिला दिये गे हवय।<verse eid="ISA 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 1:23" />तुम्हर सासन करइयामन बिदरोही अंय,</para>
  <para style="q2" vid="ISA 1:23">अऊ चोरमन संग मिले हवंय;</para>
  <para style="q1" vid="ISA 1:23">ओ जम्मो झन ला घूस लेवई बने लगथे</para>
  <para style="q2" vid="ISA 1:23">अऊ भेंट के लालची अंय।</para>
  <para style="q1" vid="ISA 1:23">ओमन अनाथमन के नियाय नइं करंय;</para>
  <para style="q2" vid="ISA 1:23">अऊ ओमन बिधवामन के मामला अपन करा आवन नइं देवंय।<verse eid="ISA 1:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="ISA 1:24" />येकर कारन परभू, सर्वसक्तिमान यहोवा,</para>
  <para style="q2" vid="ISA 1:24">इसरायल के सक्तिसाली परमेसर ह घोसना करत हे:</para>
  <para style="q1" vid="ISA 1:24">“आह! मेंह अपन बईरीमन ला अपन कोप देखाहूं</para>
  <para style="q2" vid="ISA 1:24">अऊ अपन बईरीमन ले बदला लूहूं।<verse eid="ISA 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 1:25" />में तुम्हर बिरूध<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="ft" closed="false">यरूसलेम के बिरूध</char></note> अपन हांथ उठाहूं;</para>
  <para style="q2" vid="ISA 1:25">मेंह तुम्हर जम्मो मईल ला साफ कर दूहूं</para>
  <para style="q2" vid="ISA 1:25">अऊ तुम्हर जम्मो असुधता ला दूर कर दूहूं।<verse eid="ISA 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 1:26" />मेंह पहिली के सहीं अगुवा</para>
  <para style="q2" vid="ISA 1:26">अऊ सुरूआत के सहीं सासन करइया ठहिराहूं।</para>
  <para style="q1" vid="ISA 1:26">ओकर बाद तेंह धरमीपन के नगर,</para>
  <para style="q2" vid="ISA 1:26">बिसवासयोग्य नगर कहाबे।”<verse eid="ISA 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="ISA 1:27" />सियोन ला नियाय के दुवारा,</para>
  <para style="q2" vid="ISA 1:27">अऊ ओमा के पछतापी मनखेमन ला धरमीपन ले छोंड़ाय जाही।<verse eid="ISA 1:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 1:28" />पर बिदरोही अऊ पापीमन नास कर दिये जाहीं,</para>
  <para style="q2" vid="ISA 1:28">अऊ जेमन यहोवा ला तियाग देथें, ओमन नास हो जाहीं।<verse eid="ISA 1:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="ISA 1:29" />“जऊन पबितर बलूत रूखमन के कारन तुमन खुस होवत रहेव,</para>
  <para style="q2" vid="ISA 1:29">ओमन के कारन तुमन लज्जित होहू;</para>
  <para style="q1" vid="ISA 1:29">अऊ जऊन बारीमन ला तुमन चुने हव,</para>
  <para style="q2" vid="ISA 1:29">ओमन के कारन तुमन कलंकित होहू।<verse eid="ISA 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 1:30" />तुमन ओ बलूत रूख जइसन होहू, जेकर पानमन सूखावत हवंय,</para>
  <para style="q2" vid="ISA 1:30">अऊ तुमन बिन पानी के एक बारी सहीं हो जाहू।<verse eid="ISA 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 1:31" />बलवान मनखे चिनगारी ले जरोइया चीज हो जाही</para>
  <para style="q2" vid="ISA 1:31">अऊ ओकर काम ह एक चिनगारी;</para>
  <para style="q1" vid="ISA 1:31">दूनों एक संग जरहीं,</para>
  <para style="q2" vid="ISA 1:31">अऊ आगी बुतइया कोनो नइं होहीं।”<verse eid="ISA 1:31" /></para>
  <chapter eid="ISA 1" />
  <chapter number="2" style="c" sid="ISA 2" />
  <para style="s1">यहोवा के पहाड़</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1" />आमोस के बेटा यसायाह ह यहूदा अऊ यरूसलेम के बारे म ये दरसन देखिस:<verse eid="ISA 2:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="ISA 2:2" />आखिरी के दिनमन म,</para>
  <para style="q1" vid="ISA 2:2">यहोवा के मंदिर के पहाड़ ह</para>
  <para style="q2" vid="ISA 2:2">सबले ऊंच पहाड़ के रूप म स्थापित करे जाही;</para>
  <para style="q1" vid="ISA 2:2">येला जम्मो पहाड़ीमन ले ऊंचहा करे जाही,</para>
  <para style="q2" vid="ISA 2:2">अऊ जम्मो जाति के मनखेमन पानी के धारा सहीं येकर करा आहीं।<verse eid="ISA 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 2:3" />बहुंते मनखेमन आके कहिहीं,</para>
  <para style="q1" vid="ISA 2:3">“आवव, हमन यहोवा के पहाड़ ऊपर,</para>
  <para style="q2" vid="ISA 2:3">याकूब के परमेसर के मंदिर म चलन।</para>
  <para style="q1" vid="ISA 2:3">ओह हमन ला अपन नियम-कानून सिखोही,</para>
  <para style="q2" vid="ISA 2:3">ताकि हमन ओकर रसता म चलन।”</para>
  <para style="q1" vid="ISA 2:3">कानून ह सियोन ले,</para>
  <para style="q2" vid="ISA 2:3">यहोवा के बचन ह यरूसलेम ले निकलही।<verse eid="ISA 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 2:4" />ओह जाति-जाति के नियाय करही,</para>
  <para style="q2" vid="ISA 2:4">अऊ बहुंते मनखेमन के झगरा के निपटारा करही।</para>
  <para style="q1" vid="ISA 2:4">ओमन अपन तलवारमन ला पीट-पीटके नांगर के फाल</para>
  <para style="q2" vid="ISA 2:4">अऊ अपन बरछीमन ला हंसिया बना डारहीं।</para>
  <para style="q1" vid="ISA 2:4">एक जाति ह आने जाति के बिरूध लड़ई नइं करही,</para>
  <para style="q2" vid="ISA 2:4">अऊ न ही ओमन फेर लड़ई करे के सिकछा दीहीं।<verse eid="ISA 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 2:5" />हे याकूब के संतानमन, आवव,</para>
  <para style="q2" vid="ISA 2:5">हमन यहोवा के अंजोर म चलन।<verse eid="ISA 2:5" /></para>
  <para style="s1">यहोवा के दिन</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 2:6" />हे यहोवा, तेंह अपन मनखे,</para>
  <para style="q2" vid="ISA 2:6">याकूब के संतानमन ला तियाग दे हवस।</para>
  <para style="q1" vid="ISA 2:6">ओमन पूरब के मनखेमन सहीं पूरा अंधबिसवास ले भरे हवंय;</para>
  <para style="q2" vid="ISA 2:6">ओमन पलिस्तीमन सहीं टोनहा करथें</para>
  <para style="q2" vid="ISA 2:6">अऊ मूरती-पूजकमन के रीति-रिवाज म चलथें।<verse eid="ISA 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 2:7" />ओमन के देस ह सोन अऊ चांदी ले भरे हवय;</para>
  <para style="q2" vid="ISA 2:7">ओमन के दुवारा जमा करे गय धन के कोनो सीमा नइं ए।</para>
  <para style="q1" vid="ISA 2:7">ओमन के देस ह घोड़ामन ले भरे हवय;</para>
  <para style="q2" vid="ISA 2:7">अऊ ओमन करा अनगिनत रथमन हवंय।<verse eid="ISA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 2:8" />ओमन के देस ह मूरतीमन ले भरे हवय;</para>
  <para style="q2" vid="ISA 2:8">ओमन अपन हांथ के काम,</para>
  <para style="q2" vid="ISA 2:8">अपन अंगरी ले बनाय चीजमन ला दंडवत करथें।<verse eid="ISA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 2:9" />एकरसेति मनखेमन ला झुकाय जाही</para>
  <para style="q2" vid="ISA 2:9">अऊ हर एक जन नम्र करे जाहीं—</para>
  <para style="q2" vid="ISA 2:9">ओमन ला छेमा झन कर।<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओमन ला ऊपर झन उठा</char></note><verse eid="ISA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 2:10" />यहोवा के भययुक्त उपस्थिति</para>
  <para style="q2" vid="ISA 2:10">अऊ ओकर गौरव के सोभा के कारन</para>
  <para style="q2" vid="ISA 2:10">चट्टान म घुसर जावव अऊ भुइयां म लुका जावव!<verse eid="ISA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 2:11" />घमंडी के आंखी ला झुकाय जाही</para>
  <para style="q2" vid="ISA 2:11">अऊ मनखे के घमंड ला टोरे जाही;</para>
  <para style="q1" vid="ISA 2:11">ओ दिन सिरिप यहोवा ला ही ऊपर करे जाही।<verse eid="ISA 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 2:12" />काबरकि यहोवा ह एक दिन ला ठहिराय हवय</para>
  <para style="q2" vid="ISA 2:12">जब सबो घमंडी अऊ अहंकारी,</para>
  <para style="q1" vid="ISA 2:12">अऊ जऊन मन अपनआप ला ऊपर उठाय हवंय,</para>
  <para style="q2" vid="ISA 2:12">(ओमन के घमंड ला टोरे जाही),<verse eid="ISA 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 2:13" />काबरकि लबानोन के जम्मो ऊंच अऊ बड़े देवदार रूख,</para>
  <para style="q2" vid="ISA 2:13">अऊ बासान के जम्मो बलूत रूख,<verse eid="ISA 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 2:14" />जम्मो ऊंच पहाड़</para>
  <para style="q2" vid="ISA 2:14">अऊ जम्मो ऊंच पहाड़ीमन,<verse eid="ISA 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 2:15" />हर एक ऊंच मीनार</para>
  <para style="q2" vid="ISA 2:15">अऊ हर एक किलाबंदीवाला दीवार,<verse eid="ISA 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 2:16" />हर एक बेपारी पानी जहाज<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">हर एक </char><char style="fqa" closed="false">तरसीस के पानी जहाज</char></note></para>
  <para style="q2" vid="ISA 2:16">अऊ हर एक महत्व के चीजमन ला गिराय जाही।<verse eid="ISA 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 2:17" />मनखे के घमंड</para>
  <para style="q2" vid="ISA 2:17">अऊ मनखे के अहंकार ला टोरे जाही;</para>
  <para style="q1" vid="ISA 2:17">ओ दिन सिरिप यहोवा ला ही ऊपर करे जाही,<verse eid="ISA 2:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ISA 2:18" />अऊ मूरतीमन सब के सब नास हो जाहीं।<verse eid="ISA 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ISA 2:19" />जब यहोवा ह धरती ला कंपवाय बर उठही,</para>
  <para style="q2" vid="ISA 2:19">तब ओकर भययुक्त उपस्थिति</para>
  <para style="q1" vid="ISA 2:19">अऊ ओकर गौरव के सोभा ले डरके</para>
  <para style="q1" vid="ISA 2:19">मनखेमन भागहीं अऊ चट्टान के गुफा</para>
  <para style="q2" vid="ISA 2:19">अऊ भुइयां के बिल म जाके लुका जाहीं।<verse eid="ISA 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 2:20" />ओ दिन मनखेमन</para>
  <para style="q2" vid="ISA 2:20">छूछू अऊ चमगीदड़मन के आघू म</para>
  <para style="q1" vid="ISA 2:20">अपन सोन अऊ चांदी के मूरतीमन ला फेंक दीहीं,</para>
  <para style="q2" vid="ISA 2:20">जेमन ला ओमन दंडवत करे बर बनाय रिहिन।<verse eid="ISA 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 2:21" />जब यहोवा ह धरती ला कंपवाय बर उठही,</para>
  <para style="q2" vid="ISA 2:21">त ओकर भययुक्त उपस्थिति</para>
  <para style="q1" vid="ISA 2:21">अऊ ओकर गौरव के सोभा ले डरके</para>
  <para style="q2" vid="ISA 2:21">ओमन भागहीं अऊ चट्टानमन के गुफा</para>
  <para style="q2" vid="ISA 2:21">अऊ चट्टानमन के दरार म लुका जाहीं।<verse eid="ISA 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 2:22" />मनखेमन ऊपर भरोसा करई छोंड़ दव,</para>
  <para style="q2" vid="ISA 2:22">जेमन करा सिरिप एक सांस ओमन के नथुना म हवय।</para>
  <para style="q2" vid="ISA 2:22">ओमन के काबर आदर करे जावय?<verse eid="ISA 2:22" /></para>
  <chapter eid="ISA 2" />
  <chapter number="3" style="c" sid="ISA 3" />
  <para style="s1">यहूदा अऊ यरूसलेम ऊपर दंड</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 3:1" />देखव अब, परभू,</para>
  <para style="q2" vid="ISA 3:1">सर्वसक्तिमान यहोवा ह</para>
  <para style="q1" vid="ISA 3:1">यरूसलेम सहर अऊ यहूदा प्रदेस बर</para>
  <para style="q2" vid="ISA 3:1">जरूरी चीज अऊ मदद देवई ला बंद करइया हवय:</para>
  <para style="q1" vid="ISA 3:1">जम्मो जेवन के चीज अऊ जम्मो पानी के पूरती,<verse eid="ISA 3:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="ISA 3:2" />बीर अऊ योद्धा,</para>
  <para style="q1" vid="ISA 3:2">नियायधीस अऊ अगमजानी,</para>
  <para style="q2" vid="ISA 3:2">सकुन-बिचार करइया अऊ अगुवा,<verse eid="ISA 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 3:3" />पचास सैनिकमन के मुखिया अऊ उच्च पदवाला मनखे,</para>
  <para style="q2" vid="ISA 3:3">सलाहकार अऊ कुसल कारीगर अऊ चतुर जादूगर, जम्मो के जम्मो ला हटा लीही।<verse eid="ISA 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 3:4" />“मेंह सिरिप जवानमन ला ओमन के अधिकारी बनाहूं;</para>
  <para style="q2" vid="ISA 3:4">लइकामन ओमन ऊपर सासन करहीं।”<verse eid="ISA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 3:5" />मनखेमन एक-दूसर के ऊपर अतियाचार करहीं—</para>
  <para style="q2" vid="ISA 3:5">मनखे के बिरूध मनखे, परोसी के बिरूध परोसी होहीं।</para>
  <para style="q1" vid="ISA 3:5">जवानमन डोकरामन के बिरूध</para>
  <para style="q2" vid="ISA 3:5">अऊ तुछ मनखेमन आदरनीय मनखेमन के बिरूध ठाढ़ होहीं।<verse eid="ISA 3:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 3:6" />ओ समय एक मनखे ह अपन ददा के घर म</para>
  <para style="q2" vid="ISA 3:6">अपन भाई ला पकड़के कहिही,</para>
  <para style="q1" vid="ISA 3:6">“तोर करा एक बने ओनहा हवय, तेंह हमर अगुवा बन जा;</para>
  <para style="q2" vid="ISA 3:6">अऊ ये देस, जऊन ह उजर गे हवय, ओला अपन अधीन कर ले!”<verse eid="ISA 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 3:7" />पर ओ दिन ओह चिचियाके कहिही,</para>
  <para style="q2" vid="ISA 3:7">“मोर करा येकर कोनो ईलाज नइं ए।</para>
  <para style="q1" vid="ISA 3:7">मोर घर म न तो जेवन हवय अऊ न ही ओनहा;</para>
  <para style="q2" vid="ISA 3:7">एकरसेति तुमन मोला मनखेमन के अगुवा झन बनावव।”<verse eid="ISA 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 3:8" />यरूसलेम तो डगमगावथे,</para>
  <para style="q2" vid="ISA 3:8">अऊ यहूदा गिरत हे;</para>
  <para style="q1" vid="ISA 3:8">काबरकि ओमन के बचन अऊ काम यहोवा के बिरूध हवंय,</para>
  <para style="q2" vid="ISA 3:8">ओमन ओकर महिमामय उपस्थिति के परवाह नइं करत हवंय।<verse eid="ISA 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 3:9" />ओमन के चेहरा ओमन के बिरूध गवाही देथे;</para>
  <para style="q2" vid="ISA 3:9">ओमन सदोमीमन के सहीं अपन पाप ला बताथें;</para>
  <para style="q2" vid="ISA 3:9">ओमन ओला नइं लुकावंय।</para>
  <para style="q1" vid="ISA 3:9">ओमन ऊपर हाय!</para>
  <para style="q2" vid="ISA 3:9">ओमन अपन ऊपर बिपत्ति लाय हवंय।<verse eid="ISA 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 3:10" />धरमीमन ला बतावव कि ओमन के भलई होही,</para>
  <para style="q2" vid="ISA 3:10">काबरकि ओमन अपन काम के फर के आनंद उठाहीं।<verse eid="ISA 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 3:11" />दुस्टमन ऊपर हाय!</para>
  <para style="q2" vid="ISA 3:11">ओमन ऊपर घोर बिपत्ति हवय!</para>
  <para style="q1" vid="ISA 3:11">काबरकि जऊन दुस्ट काम ओमन करे हवंय,</para>
  <para style="q2" vid="ISA 3:11">ओकर फर ओमन ला मिलही।<verse eid="ISA 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 3:12" />जवानमन मोर मनखेमन ऊपर अतियाचार करथें,</para>
  <para style="q2" vid="ISA 3:12">अऊ माईलोगनमन ओमन ऊपर सासन करथें।</para>
  <para style="q1" vid="ISA 3:12">हे मोर मनखेमन, तुम्हर रसता बतइयामन तुमन ला भटका देथें;</para>
  <para style="q2" vid="ISA 3:12">ओमन तुमन ला डहार ले आने कोति ले जाथें।<verse eid="ISA 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 3:13" />यहोवा ह अदालत म अपन जगह बईठथे;</para>
  <para style="q2" vid="ISA 3:13">ओह मनखेमन के नियाय करे बर ठाढ़ होथे।<verse eid="ISA 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 3:14" />यहोवा ह अपन मनखेमन के सियान</para>
  <para style="q2" vid="ISA 3:14">अऊ अगुवामन के बिरूध नियाय सुरू करथे:</para>
  <para style="q1" vid="ISA 3:14">“येह तुमन अव, जेमन मोर अंगूर के बारी ला नास कर दे हव;</para>
  <para style="q2" vid="ISA 3:14">अऊ गरीबमन ले लूटे गय चीजमन तुम्हर घर म हवंय।<verse eid="ISA 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 3:15" />मोर मनखेमन ला कुचरे</para>
  <para style="q2" vid="ISA 3:15">अऊ गरीब मनखेमन के चेहरा ला पीसे के तुम्हर का मतलब अय?”</para>
  <para style="q2" vid="ISA 3:15">परभू, सर्वसक्तिमान यहोवा ह घोसना करत हे।<verse eid="ISA 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 3:16" />यहोवा ह कहिथे,</para>
  <para style="q2" vid="ISA 3:16">“सियोन के माईलोगनमन घमंडी अंय,</para>
  <para style="q1" vid="ISA 3:16">ओमन अपन मुड़ उठाके</para>
  <para style="q2" vid="ISA 3:16">आंखी ले नकली मया देखावत,</para>
  <para style="q1" vid="ISA 3:16">अपन गोड़ म घुंघरू के अवाज के संग</para>
  <para style="q2" vid="ISA 3:16">अकड़के एड़ी मटकावत चलथें।<verse eid="ISA 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 3:17" />एकरसेति परभू ह सियोन के माईलोगनमन के मुड़ ला फोड़ामन ले भर दीही;</para>
  <para style="q2" vid="ISA 3:17">यहोवा ह ओमन के मुड़ ला चंदवा कर दीही।”<verse eid="ISA 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18" />ओ दिन परभू ह ओमन के दिखावटी बेसभूसा ला छीन लीही: याने कि ओमन के चूड़ी अऊ मुड़ के फीता, आधा चंदा सहीं हार, <verse eid="ISA 3:18" /><verse number="19" style="v" sid="ISA 3:19" />कान के फूली अऊ कंगन अऊ ओढ़नी, <verse eid="ISA 3:19" /><verse number="20" style="v" sid="ISA 3:20" />पगड़ी अऊ पायल अऊ करधनी, इतर के सीसी अऊ बाजूबंद, <verse eid="ISA 3:20" /><verse number="21" style="v" sid="ISA 3:21" />मुहरवाला मुंदरी अऊ नथनी, <verse eid="ISA 3:21" /><verse number="22" style="v" sid="ISA 3:22" />सुघर ओनहा अऊ बिगर बाहां के बंडी अऊ कुरतामन, बटुवा, <verse eid="ISA 3:22" /><verse number="23" style="v" sid="ISA 3:23" />अऊ दरपन, अऊ मलमल के ओनहा अऊ मुकुट अऊ दुसालामन ला छीन लीही।<verse eid="ISA 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 3:24" />खुसबू के जगह बदबू;</para>
  <para style="q2" vid="ISA 3:24">करधनी के जगह म रस्सी;</para>
  <para style="q1" vid="ISA 3:24">सुघर गांथे बाल के जगह म ठेकली मुड़;</para>
  <para style="q2" vid="ISA 3:24">सुघर ओनहा के जगह म बोरा के ओनहा;</para>
  <para style="q2" vid="ISA 3:24">अऊ सुन्दरता के जगह म बदसूरती होही।<verse eid="ISA 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 3:25" />तुम्हर मनखेमन तलवार ले,</para>
  <para style="q2" vid="ISA 3:25">अऊ तुम्हर योद्धामन लड़ई म मारे जाहीं।<verse eid="ISA 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 3:26" />सियोन के दुवारमन रोहीं अऊ बिलाप करहीं;</para>
  <para style="q2" vid="ISA 3:26">गरीबी म, ओह भुइयां म बईठे रहिही।<verse eid="ISA 3:26" /></para>
  <chapter eid="ISA 3" />
  <chapter number="4" style="c" sid="ISA 4" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 4:1" />ओ दिन सात माईलोगनमन</para>
  <para style="q2" vid="ISA 4:1">एक पुरूस ला धरके कहिहीं,</para>
  <para style="q1" vid="ISA 4:1">“रोटी तो हमन अपन खुद के खाबो</para>
  <para style="q2" vid="ISA 4:1">अऊ ओनहा घलो अपन खुद के पहिरबो;</para>
  <para style="q1" vid="ISA 4:1">सिरिप तेंह हमन ला अपन नांव देय दे।</para>
  <para style="q2" vid="ISA 4:1">हमर कलंक ला दूर कर दे!”<verse eid="ISA 4:1" /></para>
  <para style="s1">यहोवा के डारा</para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2" />ओ दिन यहोवा के डंगाली ह सुघर अऊ महिमामय होही, अऊ देस के फर ह इसरायल के बांचे मनखेमन बर घमंड अऊ महिमा के बात होही। <verse eid="ISA 4:2" /><verse number="3" style="v" sid="ISA 4:3" />जऊन मन सियोन म बांचे रहिहीं, जऊन मन यरूसलेम म रहिहीं, याने कि ओ जम्मो जेमन के नांव यरूसलेम म जीयतमन के बीच म लिखे गे हवय, ओमन पबितर कहे जाहीं। <verse eid="ISA 4:3" /><verse number="4" style="v" sid="ISA 4:4" />परभू ह सियोन के माईलोगनमन के गंदगी ला धो दीही; ओह नियाय के आतमा अऊ आगी के आतमा के दुवारा यरूसलेम ले खून के दागमन ला साफ कर दीही। <verse eid="ISA 4:4" /><verse number="5" style="v" sid="ISA 4:5" />तब यहोवा ह जम्मो सियोन पहाड़ ऊपर अऊ ओ जम्मो जऊन मन उहां जूरहीं, ओमन ऊपर दिन के बेरा धुआं के एक बादर अऊ रथिया के बेरा धधकत आगी के एक अंजोर देखाही; अऊ जम्मो के ऊपर परमेसर के महिमा के एक मंडप छाय रहिही। <verse eid="ISA 4:5" /><verse number="6" style="v" sid="ISA 4:6" />येह दिन के गरमी बर एक आसरय अऊ छइहां, अऊ आंधी अऊ पानी ले बचे बर एक सरन-स्थान अऊ लुकाय के जगह होही।<verse eid="ISA 4:6" /></para>
  <chapter eid="ISA 4" />
  <chapter number="5" style="c" sid="ISA 5" />
  <para style="s1">अंगूर के बारी के गीत</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 5:1" />मेंह अपन मयारू बर गीत गाहूं</para>
  <para style="q2" vid="ISA 5:1">ओकर अंगूर के बारी के बारे म एक ठन गीत गाहूं:</para>
  <para style="q1" vid="ISA 5:1">एक बहुंत उपजाऊ पहाड़ी ऊपर</para>
  <para style="q2" vid="ISA 5:1">मोर मयारू के एक ठन अंगूर के बारी रिहिस।<verse eid="ISA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2" />ओह ओकर माटी खनिस अऊ ओमा के पथरामन ला हटाईस</para>
  <para style="q2" vid="ISA 5:2">अऊ ओमा सबले उत्तम अंगूर के नारमन ला लगाईस।</para>
  <para style="q1" vid="ISA 5:2">पहरा देय बर ओह ओमा एक गुम्मट बनाईस</para>
  <para style="q2" vid="ISA 5:2">अऊ एक ठन अंगूर के रसकुंड घलो बनाईस।</para>
  <para style="q1" vid="ISA 5:2">तब ओह उत्तम अंगूर के फसल के इंतजार करिस,</para>
  <para style="q2" vid="ISA 5:2">पर ओमा सिरिप खराप अंगूर ही फरिस।<verse eid="ISA 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3" />“अब हे यरूसलेम के रहइया अऊ यहूदा के मनखेमन,</para>
  <para style="q2" vid="ISA 5:3">मोर अऊ मोर अंगूर के बारी के बीच नियाय करव।<verse eid="ISA 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4" />मोर अंगूर के बारी बर अऊ का खंग गीस</para>
  <para style="q2" vid="ISA 5:4">जऊन ला मेंह नइं करेंव?</para>
  <para style="q1" vid="ISA 5:4">जब मेंह उत्तम अंगूर के आसा करेंव,</para>
  <para style="q2" vid="ISA 5:4">त ओमा सिरिप खराप अंगूर ही काबर फरिस?<verse eid="ISA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5" />अब मेंह तुमन ला बताहूं</para>
  <para style="q2" vid="ISA 5:5">कि मेंह अपन अंगूर के बारी के का करइया हंव:</para>
  <para style="q1" vid="ISA 5:5">मेंह येकर कांटा के रूंधान ला हटा दूहूं,</para>
  <para style="q2" vid="ISA 5:5">ताकि येह नास हो जावय;</para>
  <para style="q1" vid="ISA 5:5">मेंह येकर चारों कोति के बाड़ा ला गिरा दूहूं,</para>
  <para style="q2" vid="ISA 5:5">ताकि ये बारी ला कुचर दिये जावय।<verse eid="ISA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6" />मेंह येला उजार दूहूं,</para>
  <para style="q2" vid="ISA 5:6">येला न तो काटे जाही अऊ न ही जोते जाही,</para>
  <para style="q2" vid="ISA 5:6">अऊ ओमा नाना किसम के कंटिला रूख अऊ पऊधा जामहीं।</para>
  <para style="q1" vid="ISA 5:6">मेंह बादरमन ला हुकूम दूहूं</para>
  <para style="q2" vid="ISA 5:6">कि ओकर ऊपर पानी झन बरसावंय।”<verse eid="ISA 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7" />सर्वसक्तिमान यहोवा के</para>
  <para style="q2" vid="ISA 5:7">अंगूर के बारी ह इसरायली जाति अय,</para>
  <para style="q1" vid="ISA 5:7">अऊ यहूदा के मनखेमन</para>
  <para style="q2" vid="ISA 5:7">ओकर मनभावन अंगूर के नार अंय।</para>
  <para style="q1" vid="ISA 5:7">अऊ ओह ओमा नियाय के आसा करिस, पर ओला अनियाय ही दिखाई दीस;</para>
  <para style="q2" vid="ISA 5:7">ओह धरमीपन के आसा करिस, पर ओला रोवई अऊ दुख ही दिखाई दीस।<verse eid="ISA 5:7" /></para>
  <para style="s1">सराप अऊ नियाय</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 5:8" />ओमन ऊपर हाय, जेमन घर ले घर,</para>
  <para style="q2" vid="ISA 5:8">अऊ खेत ले खेत ला इहां तक मिलात जाथें</para>
  <para style="q1" vid="ISA 5:8">कि कुछू जगह नइं बांचय</para>
  <para style="q2" vid="ISA 5:8">अऊ ओमन देस म अकेला रहिथें।<verse eid="ISA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 5:9" />सर्वसक्तिमान यहोवा ह मोर सुनत म घोसना करे हवय:</para>
  <para style="q1" vid="ISA 5:9">“खचित बड़े-बड़े घरमन सुनसान हो जाहीं,</para>
  <para style="q2" vid="ISA 5:9">सुघर हवेलीमन बिगर मनखे के खाली पड़े होहीं।<verse eid="ISA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 5:10" />दस एकड़ के अंगूर के बारी ले सिरिप एक बत<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">लगभग 22 लीटर</char></note> अंगूर के मंद मिलही;</para>
  <para style="q2" vid="ISA 5:10">अऊ होमेर<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">लगभग 160 किलोग्राम</char></note> भर के बीज ले सिरिप एक एपा<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">लगभग 16 किलोग्राम</char></note> अनाज पईदा होही।”<verse eid="ISA 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 5:11" />ओमन ऊपर हाय, जेमन मंद पीये बर</para>
  <para style="q2" vid="ISA 5:11">बड़े बिहनियां उठथें,</para>
  <para style="q1" vid="ISA 5:11">अऊ बहुंत रथिया तक पीयत रहिथें</para>
  <para style="q2" vid="ISA 5:11">जब तक कि ओमन पूरा मात नइं जावंय।<verse eid="ISA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 5:12" />ओमन के जेवनारमन म बीना, सारंगी,</para>
  <para style="q2" vid="ISA 5:12">डफ, बांसुरी अऊ अंगूर के मंद होथे,</para>
  <para style="q1" vid="ISA 5:12">पर ओमन यहोवा के काम कोति धियान नइं देवंय,</para>
  <para style="q2" vid="ISA 5:12">अऊ न ही ओकर हांथ के काम बर ओमन के मन म कोनो आदर होथे।<verse eid="ISA 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 5:13" />एकरसेति समझ के कमी के कारन</para>
  <para style="q2" vid="ISA 5:13">मोर मनखेमन बंधुवई म चल दीहीं;</para>
  <para style="q1" vid="ISA 5:13">ऊंच पदवाले मनखेमन भूख म मर जाहीं</para>
  <para style="q2" vid="ISA 5:13">अऊ सधारन मनखेमन पीयास म बियाकुल होहीं।<verse eid="ISA 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 5:14" />एकरसेति मिरतू ह अपन जबड़ा ला</para>
  <para style="q2" vid="ISA 5:14">फारके अपन मुहूं ला खोलथे;</para>
  <para style="q1" vid="ISA 5:14">ओमन के परभावसाली मनखे अऊ मनखेमन के भीड़ ह</para>
  <para style="q2" vid="ISA 5:14">ओमन के जम्मो झगरा करइया अऊ आनंद मनइयामन के संग ओ मुहूं म चल दीहीं।<verse eid="ISA 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 5:15" />सधारन मनखेमन दबाय जाहीं</para>
  <para style="q2" vid="ISA 5:15">अऊ हर एक जन नम्र करे जाही,</para>
  <para style="q2" vid="ISA 5:15">घमंडीमन के आंखी ला झुकाय जाही।<verse eid="ISA 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 5:16" />पर सर्वसक्तिमान यहोवा ह अपन नियाय के दुवारा ऊपर उठही,</para>
  <para style="q2" vid="ISA 5:16">अऊ पबितर परमेसर ह अपन धरमी काममन के दुवारा पबितर ठहिरही।<verse eid="ISA 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 5:17" />तब भेड़मन अपन चरागन म चरहीं;</para>
  <para style="q2" vid="ISA 5:17">मेढ़ा-पीलामन<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">अजनबीमन</char></note> ला धनवानमन के उजरे जगह म खाय बर मिलही।<verse eid="ISA 5:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 5:18" />ओमन ऊपर हाय, जेमन पाप ला धोखा के डोरी,</para>
  <para style="q2" vid="ISA 5:18">अऊ दुस्टता ला गाड़ी के रस्सी ले खींचथें,<verse eid="ISA 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 5:19" />जेमन कहिथें, “परमेसर ह जल्दी करय;</para>
  <para style="q2" vid="ISA 5:19">ओह अपन काम ला जल्दी करय</para>
  <para style="q2" vid="ISA 5:19">ताकि हमन ओला देखन।</para>
  <para style="q1" vid="ISA 5:19">इसरायल के पबितर परमेसर के योजना—</para>
  <para style="q2" vid="ISA 5:19">येह आवय, येह नजर म आवय,</para>
  <para style="q2" vid="ISA 5:19">ताकि हमन ओला जानन।”<verse eid="ISA 5:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 5:20" />ओमन ऊपर हाय, जेमन बुरा ला भला</para>
  <para style="q2" vid="ISA 5:20">अऊ भला ला बुरा कहिथें,</para>
  <para style="q1" vid="ISA 5:20">जेमन अंधियार ला अंजोर</para>
  <para style="q2" vid="ISA 5:20">अऊ अंजोर ला अंधियार कहिथें,</para>
  <para style="q1" vid="ISA 5:20">जेमन करू ला मीठ</para>
  <para style="q2" vid="ISA 5:20">अऊ मीठ ला करू कर देथें।<verse eid="ISA 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 5:21" />ओमन ऊपर हाय, जेमन अपन खुद के आंखी म बुद्धिमान</para>
  <para style="q2" vid="ISA 5:21">अऊ अपन खुद के नजर म होसियार अंय।<verse eid="ISA 5:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 5:22" />ओमन ऊपर हाय, जेमन अंगूर के मंद पीये म बीर</para>
  <para style="q2" vid="ISA 5:22">अऊ मंद ला कड़ा बनाय म माहिर अंय,<verse eid="ISA 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 5:23" />जऊन मन घूस लेके दोसी मनखे ला छोंड़ देथें,</para>
  <para style="q2" vid="ISA 5:23">अऊ निरदोस मनखे ला दोसी ठहिराथें।<verse eid="ISA 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 5:24" />एकरसेति, जइसने आगी के जुवाला ले पैंरा ह भसम हो जाथे</para>
  <para style="q2" vid="ISA 5:24">अऊ सूखा घांस ह जलके राख हो जाथे,</para>
  <para style="q1" vid="ISA 5:24">वइसने ही ओमन के जरी ह सर जाही</para>
  <para style="q2" vid="ISA 5:24">अऊ ओमन के फूलमन धुर्रा सहीं उड़िया जाहीं;</para>
  <para style="q1" vid="ISA 5:24">काबरकि ओमन सर्वसक्तिमान यहोवा के कानून ला स्वीकार नइं करिन</para>
  <para style="q2" vid="ISA 5:24">अऊ इसरायल के पबितर जन के बचन ला तुछ समझिन।<verse eid="ISA 5:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 5:25" />एकरसेति यहोवा के रिस ह अपन मनखेमन ऊपर भड़कथे;</para>
  <para style="q2" vid="ISA 5:25">ओह अपन हांथ ले ओमन ला मारथे।</para>
  <para style="q1" vid="ISA 5:25">पहाड़मन कांपथें,</para>
  <para style="q2" vid="ISA 5:25">अऊ मनखेमन के लास ह गलीमन म कचरा सहीं परे हवंय।</para>
  <para style="b" vid="ISA 5:25" />
  <para style="q1" vid="ISA 5:25">एकर बाद घलो ओकर रिस नइं थमिस,</para>
  <para style="q2" vid="ISA 5:25">ओकर हांथ ह अभी घलो उठे हवय।<verse eid="ISA 5:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 5:26" />ओह दूरिहा-दूरिहा के जाति के मनखेमन बर एक झंडा ठाढ़ करथे,</para>
  <para style="q2" vid="ISA 5:26">ओह धरती के छोर के मनखेमन ला सीटी बजाके बलाथे।</para>
  <para style="q1" vid="ISA 5:26">ओमन आथें,</para>
  <para style="q2" vid="ISA 5:26">ओमन तेजी से अऊ दऊड़त आथें!<verse eid="ISA 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 5:27" />ओमा के कोनो घलो न तो थकंय अऊ न ही कोनो हपटंय,</para>
  <para style="q2" vid="ISA 5:27">न कोनो ओंघावंय अऊ न ही सुतंय;</para>
  <para style="q1" vid="ISA 5:27">न तो काकरो कमरपट्टा ह ढीला होथे,</para>
  <para style="q2" vid="ISA 5:27">अऊ न ही काकरो पनही के बंधना ह टूटथे।<verse eid="ISA 5:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 5:28" />ओमन के तीरमन चोख होथें,</para>
  <para style="q2" vid="ISA 5:28">अऊ ओमन के जम्मो धनुसमन तनाय रहिथें;</para>
  <para style="q1" vid="ISA 5:28">ओमन के घोड़ामन के खुरमन पथरा कस,</para>
  <para style="q2" vid="ISA 5:28">अऊ ओमन के रथमन के चक्कामन बवंडर सहीं लगथें।<verse eid="ISA 5:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 5:29" />ओमन के गरजन ह सिंह के गरजन सहीं होथे,</para>
  <para style="q2" vid="ISA 5:29">ओमन जवान सिंह के सही गरजथें;</para>
  <para style="q1" vid="ISA 5:29">ओमन गुर्राके अपन सिकार ऊपर झपटथें</para>
  <para style="q2" vid="ISA 5:29">अऊ ओला उठाके ले जाथें, जेला कोनो छोंड़ाय नइं सकंय।<verse eid="ISA 5:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 5:30" />ओ दिन ओमन येकर ऊपर</para>
  <para style="q2" vid="ISA 5:30">समुंदर के गरजन सहीं गरजहीं।</para>
  <para style="q1" vid="ISA 5:30">अऊ यदि कोनो ओ देस कोति देखही,</para>
  <para style="q2" vid="ISA 5:30">त ओला सिरिप अंधियार अऊ संकट ही दिखाई दीही;</para>
  <para style="q2" vid="ISA 5:30">अऊ त अऊ सूरज घलो बादरमन म लुकाके अंधियार हो जाही।<verse eid="ISA 5:30" /></para>
  <chapter eid="ISA 5" />
  <chapter number="6" style="c" sid="ISA 6" />
  <para style="s1">यसायाह के आयोग</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1" />जऊन बछर उजियाह राजा ह मरिस, मेंह परभू ला ऊंचहा अऊ महिमा के संग एक सिंघासन म बिराजमान देखेंव; अऊ ओकर ओनहा के घेरा ले मंदिर ढंपा गे रिहिस। <verse eid="ISA 6:1" /><verse number="2" style="v" sid="ISA 6:2" />ओकर ऊपर म सारापमन<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">स्वरग के जीव</char></note> रहंय, अऊ हर एक के छै-छै ठन डेना रहंय: दू ठन डेना ले ओमन अपन मुहूं ला अऊ दू ठन डेना ले अपन गोड़मन ला ढांपे रहंय, अऊ दू ठन डेना ले ओमन उड़त रहंय। <verse eid="ISA 6:2" /><verse number="3" style="v" sid="ISA 6:3" />अऊ ओमन एक-दूसर ला नरिया-नरियाके कहत रिहिन:</para>
  <para style="q1" vid="ISA 6:3">“सर्वसक्तिमान यहोवा ह पबितर, पबितर, पबितर ए;</para>
  <para style="q2" vid="ISA 6:3">पूरा धरती ह ओकर महिमा ले भरे हवय।”<verse eid="ISA 6:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="ISA 6:4" />ओमन के अवाज ले दुवार अऊ चौखटमन डोल गीन, अऊ मंदिर ह धुआं ले भर गीस।<verse eid="ISA 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 6:5" />तब मेंह चिचियाके कहेंव, “मोर ऊपर हाय! मेंह नास हो गेंव! काबरकि मेंह असुध ओंठवाला मनखे अंव, अऊ मेंह असुध ओंठवाले मनखेमन के बीच म रहिथंव, अऊ मोर आंखीमन राजा, सर्वसक्तिमान यहोवा ला देखे हवंय।”<verse eid="ISA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6" />तब एक ठन साराप ह हांथ म एक ठन बरत अंगरा ला धरके मोर करा उड़ियाके आईस; ओह ओ अंगरा ला बेदी म ले चिमटा ले उठाय रिहिस। <verse eid="ISA 6:6" /><verse number="7" style="v" sid="ISA 6:7" />ओह ओ अंगरा ले मोर मुहूं ला छूके कहिस, “देख, येह तोर ओंठ ला छुये हवय; तोर अपराध ह दूर हो गे हवय अऊ तोर पाप ला छेमा कर दिये गे हवय।”<verse eid="ISA 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8" />तब मेंह परभू के अवाज ला ये कहत सुनेंव, “मेंह कोन ला पठोवंव? अऊ कोन ह हमर बर जाही?”</para>
  <para style="p" vid="ISA 6:8">त मेंह कहेंव, “मेंह इहां हंव। मोला पठो।”<verse eid="ISA 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9" />ओह कहिस, “जा, अऊ ये मनखेमन ला कह:</para>
  <para style="q1" vid="ISA 6:9">“ ‘सुनत ही रहव, पर कभू झन समझव;</para>
  <para style="q2" vid="ISA 6:9">देखत ही रहव, पर कभू झन बुझव।’<verse eid="ISA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 6:10" />ये मनखेमन के मन ला कठोर,</para>
  <para style="q2" vid="ISA 6:10">ओमन के कान ला भारी</para>
  <para style="q2" vid="ISA 6:10">अऊ ओमन के आंखीमन ला बंद कर दे।</para>
  <para style="q1" vid="ISA 6:10">अइसन झन होवय कि ओमन अपन आंखी ले देखंय,</para>
  <para style="q2" vid="ISA 6:10">अपन कान ले सुनंय,</para>
  <para style="q2" vid="ISA 6:10">अपन मन म समझंय</para>
  <para style="q1" vid="ISA 6:10">अऊ मन फिराके चंगा हो जावंय।”<verse eid="ISA 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11" />तब मेंह पुछेंव, “हे परभू, कब तक?”</para>
  <para style="p" vid="ISA 6:11">ओह जबाब दीस:</para>
  <para style="q1" vid="ISA 6:11">“जब तक नगरमन उजड़ नइं जावंय</para>
  <para style="q2" vid="ISA 6:11">अऊ उहां कोनो झन बचंय,</para>
  <para style="q1" vid="ISA 6:11">जब तक घरमन ला खाली नइं छोंड़ दिये जावय</para>
  <para style="q2" vid="ISA 6:11">अऊ खेतमन बरबाद होके नास नइं हो जावंय,<verse eid="ISA 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 6:12" />जब तक यहोवा ह हर एक जन ला उहां ले दूरिहा नइं कर देवय</para>
  <para style="q2" vid="ISA 6:12">अऊ देस ला पूरा तियाग नइं दिये जावय।<verse eid="ISA 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 6:13" />अऊ हालाकि मनखेमन के दसवां हिस्सा उहां रही जाथे,</para>
  <para style="q2" vid="ISA 6:13">तभो ले येला फेर नास करे जाही।</para>
  <para style="q1" vid="ISA 6:13">पर जइसे छोटे अऊ बड़े बलूत रूख ला काटे के बाद घलो</para>
  <para style="q2" vid="ISA 6:13">ओकर ठूंठ ह बांच जाथे,</para>
  <para style="q2" vid="ISA 6:13">वइसे ही पबितर बीजा ह ओ देस के ठूंठ होही।”<verse eid="ISA 6:13" /></para>
  <chapter eid="ISA 6" />
  <chapter number="7" style="c" sid="ISA 7" />
  <para style="s1">इमानुएल के चिनहां</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1" />यहूदा के राजा आहाज, जऊन ह योताम के बेटा अऊ उजियाह के पोता रिहिस, ओकर समय म अराम के राजा रसीन अऊ इसरायल के राजा रमलियाह के बेटा पेकह ह यरूसलेम ले लड़े बर हमला करिन, पर ओमन ओला हरा नइं सकिन।<verse eid="ISA 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2" />जब दाऊद के घराना ला ये बताय गीस कि अराम ह एपरैम के संग संधि<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">डेरा बनाय हवय</char></note> करे हवय, त आहाज अऊ ओकर मनखेमन डर के मारे अइसन कांपे लगिन, जइसन जंगल के रूखमन हवा चले ले कांपथें।<verse eid="ISA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3" />तब यहोवा ह यसायाह ला कहिस, “तें अऊ तोर बेटा सार-यासूब<note caller="+" style="f"><char style="fr" closed="false">7:3 </char><char style="fq" closed="false">सार-यासूब </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">एक बांचे भाग ह लहुंटही</char></note> ऊपरवाला कुंड के नहर के आखिरी छोर करा जावव, जऊन ह धोबीमन के खेत कोति जवइया सड़क म हवय अऊ उहां जाके आहाज ले भेंट करव। <verse eid="ISA 7:3" /><verse number="4" style="v" sid="ISA 7:4" />अऊ ओला कहव, ‘सचेत अऊ सांत रह अऊ झन डर। ये दू ठन धुआं निकलत बारे के लकड़ी के ठूंठमन के कारन याने कि अराम के राजा रसीन अऊ रमलियाह के बेटा के भड़के कोप ले तोर मन ह बियाकुल झन होवय। <verse eid="ISA 7:4" /><verse number="5" style="v" sid="ISA 7:5" />अराम, एपरैम अऊ रमलियाह के बेटा ये कहिके तोर बिरूध युक्ति करे हवंय, <verse eid="ISA 7:5" /><verse number="6" style="v" sid="ISA 7:6" />“आवव, हमन यहूदा ऊपर हमला करन; आवव, हमन ओला चीरके कुटा-कुटा कर देवन अऊ अपन बीच म बांट लेवन, अऊ ताबेल के बेटा ला ओकर ऊपर राजा बना देवन।” <verse eid="ISA 7:6" /><verse number="7" style="v" sid="ISA 7:7" />पर परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 7:7">“ ‘ये चाल न तो सफल होही,</para>
  <para style="q2" vid="ISA 7:7">अऊ न ही ओमन के बात पूरा होही,<verse eid="ISA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 7:8" />काबरकि अराम के मुड़ दमिस्क,</para>
  <para style="q2" vid="ISA 7:8">अऊ दमिस्क के मुड़ सिरिप रसीन ए।</para>
  <para style="q1" vid="ISA 7:8">पैंसठ बछर के भीतर एपरैम ह अइसे टूट जाही</para>
  <para style="q2" vid="ISA 7:8">कि ओह एक जाति के रूप म नइं रहय।<verse eid="ISA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 7:9" />एपरैम के मुड़ सामरिया,</para>
  <para style="q2" vid="ISA 7:9">अऊ सामरिया के मुड़ सिरिप रमलियाह के बेटा अय।</para>
  <para style="q1" vid="ISA 7:9">यदि तुमन अपन बिसवास म बने नइं रहव,</para>
  <para style="q2" vid="ISA 7:9">त तुमन बिलकुल ही स्थिर नइं रह सकव।’ ”<verse eid="ISA 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10" />यहोवा ह आहाज ला फेर कहिस, <verse eid="ISA 7:10" /><verse number="11" style="v" sid="ISA 7:11" />“तेंह यहोवा अपन परमेसर ले कोनो चिनहां मांग, चाहे ओ गहिरा जगह के हो या ऊपर अकास के।”<verse eid="ISA 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 7:12" />पर आहाज ह कहिस, “मेंह नइं मांगंव, न ही मेंह यहोवा ला परखंव।”<verse eid="ISA 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13" />तब यसायाह ह कहिस, “हे दाऊद के घराना के मन, सुनव! मनखेमन के धीरज के परखई ह काफी नो हय कि तुमन मोर परमेसर के धीरज ला घलो परखहू? <verse eid="ISA 7:13" /><verse number="14" style="v" sid="ISA 7:14" />येकर कारन, परभू ह खुद तुमन ला एक चिनहां दीही: सुनव, एक कुंवारी ह गरभवती होही अऊ एक बेटा जनमही, अऊ<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओमन</char></note> ओकर नांव इमानुएल<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="fq" closed="false">इमानुएल </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">परमेसर हमर संग</char></note> रखही। <verse eid="ISA 7:14" /><verse number="15" style="v" sid="ISA 7:15" />अऊ जब तक ओह बुरा ला छोंड़े अऊ भला ला गरहन करे बर नइं जानही, तब तक ओह दही अऊ मंधरस खाही, <verse eid="ISA 7:15" /><verse number="16" style="v" sid="ISA 7:16" />काबरकि एकर पहिली कि ओ लड़का ह बुरई ला छोंड़े अऊ भलई ला धरे बर जानय, ओ देस, जेकर दूनों राजा ले तेंह घबराथस, निरजन हो जाही। <verse eid="ISA 7:16" /><verse number="17" style="v" sid="ISA 7:17" />यहोवा ह तोर ऊपर, तोर मनखेमन ऊपर अऊ तोर ददा के घराना ऊपर अइसे समय ला लानही कि जब ले एपरैम ह यहूदा ले अलग होय हवय, तब ले वइसे दिन कभू नइं आय हवय—याने कि ओह अस्सूर के राजा ला ले आही।”<verse eid="ISA 7:17" /></para>
  <para style="s1">अस्सूर, यहोवा के साधन</para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18" />ओ दिन यहोवा ह मिसर म नील के मुहाना ले माछीमन ला अऊ अस्सूर देस ले मधुमक्खीमन ला सीटी बजाके बलाही। <verse eid="ISA 7:18" /><verse number="19" style="v" sid="ISA 7:19" />ओमन सब के सब आहीं अऊ ये देस के पहाड़ी नरवामन म अऊ चट्टानमन के दरारमन म, जम्मो कंटिली झाड़ी म अऊ जम्मो पानी के सोत के लकठा म बईठ जाहीं। <verse eid="ISA 7:19" /><verse number="20" style="v" sid="ISA 7:20" />ओ दिन परभू ह फरात नदी के ओ पार अस्सूर के राजा ले भाड़ा म उस्तरा लीही अऊ तुम्हर मुड़ अऊ गुपत भाग के रूआंमन ला मुड़ही, अऊ तुम्हर दाढ़ी ला घलो काटही। <verse eid="ISA 7:20" /><verse number="21" style="v" sid="ISA 7:21" />ओ दिन एक मनखे ह सिरिप एक ठन बछिया अऊ दू ठन बकरी पोसही। <verse eid="ISA 7:21" /><verse number="22" style="v" sid="ISA 7:22" />ओमन अतेक दूध दीहीं कि खाय बर दही मिलही। ओ जम्मो, जेमन देस म बांचे होहीं, ओमन दही अऊ मंधरस खाहीं। <verse eid="ISA 7:22" /><verse number="23" style="v" sid="ISA 7:23" />ओ दिन, हर ओ जगह, जिहां एक हजार चांदी के सेकेल<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">लगभग 12 किलो</char></note> म एक हजार अंगूर के नारमन मिलत रिहिन, उहां सिरिप कंटिली झाड़ी अऊ कांटामन होहीं। <verse eid="ISA 7:23" /><verse number="24" style="v" sid="ISA 7:24" />सिकारीमन उहां तीर-धनुस लेके जाहीं, काबरकि ओ देस ह कंटिली झाड़ी अऊ कांटामन ले भरे होही। <verse eid="ISA 7:24" /><verse number="25" style="v" sid="ISA 7:25" />जहां तक जम्मो पहाड़ीमन के बात ए, एक बार जब उहां कुदारी ले खेती हो जाही, त तुमन ला उहां जाय म कंटिली झाड़ी अऊ कांटामन के भय नइं होही; ओमन अइसन जगह हो जाहीं, जिहां पसुमन ला चरे बर खुला छोंड़ दिये जाही अऊ भेड़-बकरीमन एती-ओती कूदहीं-फांदहीं।<verse eid="ISA 7:25" /></para>
  <chapter eid="ISA 7" />
  <chapter number="8" style="c" sid="ISA 8" />
  <para style="s1">यसायाह अऊ ओकर बेटामन चिनहां के रूप म</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1" />यहोवा ह मोला कहिस, “एक ठन बड़खा चामपट्टी ले अऊ ओमा एक सधारन कलम ले ये लिख: महेर-सालाल-हास-बज।”<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="fq" closed="false">महेर-सालाल-हास-बज </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">लूट बर जल्दी करव</char><char style="ft" closed="false">; <char style="xt" link-href="ISA 8:3"><ref loc="ISA 8:3">पद 3</ref></char> म घलो</char></note> <verse eid="ISA 8:1" /><verse number="2" style="v" sid="ISA 8:2" />मेंह उरियाह पुरोहित अऊ जेबेरेकियाह के बेटा जकरयाह ला मोर भरोसा के लईक गवाह के रूप म बलाएंव। <verse eid="ISA 8:2" /><verse number="3" style="v" sid="ISA 8:3" />तब मेंह अपन घरवाली<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अगमजानीन</char></note> करा गेंव, अऊ ओह गरभ म होईस अऊ एक बेटा ला जनम दीस। अऊ यहोवा ह मोला कहिस, “ओकर नांव महेर-सालाल-हास-बज रख। <verse eid="ISA 8:3" /><verse number="4" style="v" sid="ISA 8:4" />काबरकि एकर पहिली कि ओ लड़का ह दाई अऊ ददा कहे बर सीखय, दमिस्क अऊ सामरिया दूनों के धन-दौलत ला अस्सूर के राजा ह लूटके ले जाही।”<verse eid="ISA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5" />यहोवा ह फेर मोला कहिस:<verse eid="ISA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 8:6" />“काबरकि मनखेमन सीलोह के</para>
  <para style="q2" vid="ISA 8:6">धीरे-धीरे बोहावत पानी ला अस्वीकार करे हवंय</para>
  <para style="q1" vid="ISA 8:6">अऊ रसीन अऊ रमलियाह के बेटा के संग</para>
  <para style="q2" vid="ISA 8:6">एका करके आनंद मनावत हें,<verse eid="ISA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 8:7" />एकरसेति परभू ओमन ऊपर</para>
  <para style="q2" vid="ISA 8:7">फरात नदी के भयंकर बाढ़ के पानी लानेचवाला हे—</para>
  <para style="q2" vid="ISA 8:7">याने कि अस्सूर के राजा ला ओकर पूरा परताप के संग ले आही।</para>
  <para style="q1" vid="ISA 8:7">येकर जम्मो नहर म पूरा आ जाही,</para>
  <para style="q2" vid="ISA 8:7">अऊ ओमन के किनारा म पानी चढ़ जाही<verse eid="ISA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 8:8" />अऊ यहूदा ऊपर पानी चढ़ जाही, ओकर ऊपर बढ़त जाही,</para>
  <para style="q2" vid="ISA 8:8">येकर ऊपर ले जावत घेंच तक आ जाही।</para>
  <para style="q1" vid="ISA 8:8">येकर बाहिर फईले डेनामन तुम्हर देस के चौड़ई ला ढांप दीहीं,</para>
  <para style="q2" vid="ISA 8:8">इमानुएल<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="fq" closed="false">इमानुएल </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">परमेसर हमर संग</char></note>!”<verse eid="ISA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 8:9" />हे जाति-जाति के मनखेमन, लड़ई बर चिचियावव,<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सबले खराप काम करव</char></note> अऊ कुटा-कुटा हो जावव!</para>
  <para style="q2" vid="ISA 8:9">हे दूरिहा-दूरिहा के जम्मो देसमन, सुनव।</para>
  <para style="q1" vid="ISA 8:9">लड़ई बर तियारी करव, अऊ कुटा-कुटा हो जावव!</para>
  <para style="q2" vid="ISA 8:9">लड़ई बर तियारी करव, अऊ कुटा-कुटा हो जावव!<verse eid="ISA 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 8:10" />तुमन लड़ई के योजना बनावव, पर ओह बेकार हो जाही;</para>
  <para style="q2" vid="ISA 8:10">तुमन कुछू घलो कहव, पर तुम्हर कहे ह नइं ठहिरय,</para>
  <para style="q2" vid="ISA 8:10">काबरकि परमेसर ह हमर संग हवय।<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">इमानुएल</char></note><verse eid="ISA 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11" />अपन मजबूत हांथ मोर ऊपर रखके यहोवा ह मोला ये मनखेमन के रसता म नइं चले के चेतउनी देवत कहत हे:<verse eid="ISA 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 8:12" />“हर ओ चीज ला सडयंत्र झन कहव</para>
  <para style="q2" vid="ISA 8:12">जेला ये मनखेमन एक सडयंत्र कहिथें;</para>
  <para style="q1" vid="ISA 8:12">ओ चीज ले झन डरव, जऊन चीज ले ओमन डराथें,</para>
  <para style="q2" vid="ISA 8:12">अऊ ओकर ले भयभीत झन होवव।<verse eid="ISA 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 8:13" />सर्वसक्तिमान यहोवा ही ओ अय, जेकर एक पबितर परमेसर के रूप म तें आदर कर।</para>
  <para style="q2" vid="ISA 8:13">ओकरेच ले ही तेंह डर,</para>
  <para style="q2" vid="ISA 8:13">अऊ ओकरेच भय मान।<verse eid="ISA 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 8:14" />ओह एक पबितर जगह होही;</para>
  <para style="q2" vid="ISA 8:14">इसरायल अऊ यहूदा दूनों घराना बर ओह एक ठन पथरा होही,</para>
  <para style="q1" vid="ISA 8:14">जऊन ह मनखेमन के लड़खड़ाय के</para>
  <para style="q2" vid="ISA 8:14">अऊ एक चट्टान, जऊन ह ओमन के गिरे के कारन बनही।</para>
  <para style="q1" vid="ISA 8:14">अऊ यरूसलेम के मनखेमन बर</para>
  <para style="q2" vid="ISA 8:14">ओह एक फंदा अऊ एक जाल होही।<verse eid="ISA 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 8:15" />ओमा के कतको झन ठोकर खाहीं;</para>
  <para style="q2" vid="ISA 8:15">ओमन गिरहीं अऊ चकनाचूर हो जाहीं,</para>
  <para style="q2" vid="ISA 8:15">ओमन फंदा म फंसहीं अऊ धरे जाहीं।”<verse eid="ISA 8:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 8:16" />चेतउनी के ये गवाही ला बंद कर देवव</para>
  <para style="q2" vid="ISA 8:16">अऊ मोर चेलामन के बीच परमेसर के सिकछा म मुहर लगा देवव।<verse eid="ISA 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 8:17" />मेंह ओ यहोवा के रसता देखहूं,</para>
  <para style="q2" vid="ISA 8:17">जऊन ह याकूब के संतानमन ले अपन मुहूं ला लुकाय हवय।</para>
  <para style="q1" vid="ISA 8:17">मेंह ओकर ऊपर अपन भरोसा रखहूं।<verse eid="ISA 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 8:18" />देख, मेंह इहां हवंव अऊ जऊन लइकामन ला यहोवा ह मोला देय हवय, ओमन घलो हवंय। सर्वसक्तिमान यहोवा, जऊन ह सियोन पहाड़ म निवास करथे, ओकर कोति ले हमन इसरायलीमन बर चिनहां अऊ प्रतीक अन।<verse eid="ISA 8:18" /></para>
  <para style="s1">अंधियार ह अंजोर हो जाथे</para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19" />जब कोनो मनखे तुमन ला ओ ओझा अऊ टोनहामन करा जाके पुछे बर कहय, जेमन फुसफुसाथें अऊ बड़बड़ाथें, तब तुमन अइसन मनखे ले कहव, “का मनखेमन ला अपन परमेसर करा जाके नइं पुछना चाही? जीयत मनखेमन बर मुरदामन ले काबर पुछन?” <verse eid="ISA 8:19" /><verse number="20" style="v" sid="ISA 8:20" />परमेसर के सिकछा अऊ चेतउनी के गवाही ऊपर धियान देवव। यदि कोनो मनखे ये बचन के मुताबिक नइं बोलय, त ओकर करा बिहान के अंजोर नइं ए। <verse eid="ISA 8:20" /><verse number="21" style="v" sid="ISA 8:21" />दुख-तकलीफ अऊ भूख म, ओमन देस म एती-ओती फिरत रहिहीं; अऊ जब ओमन भूखन मरहीं, त ओमन गुस्सा करहीं अऊ, ऊपर कोति देखके अपन राजा अऊ अपन परमेसर ला सराप दीहीं। <verse eid="ISA 8:21" /><verse number="22" style="v" sid="ISA 8:22" />तब ओमन धरती कोति नजर करहीं अऊ ओमन ला सिरिप दुख अऊ अंधियार अऊ भयानक अंधियार दिखाई दीही, अऊ ओमन ला घोर अंधियार म ढकेल दिये जाही।<verse eid="ISA 8:22" /></para>
  <chapter eid="ISA 8" />
  <chapter number="9" style="c" sid="ISA 9" />
  <para style="p">
    <note caller="+" style="f">
      <char style="fr" closed="false">9 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="ISA 9:1">9:1</ref></char> ला 8:23 अऊ <char style="xt"><ref loc="ISA 9:2-21">9:2‑21</ref></char> ला 9:1‑20 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="ISA 9:1" />तभो ले, ओमन बर संकट भरे अंधियार खतम हो जाही, जेमन दुख-तकलीफ म रिहिन। बीते समय म तो ओह जबूलून के देस अऊ नपताली के देस के अपमान करिस, पर भविस्य म ओह समुंदर के तरफ जाय के रसता के दुवारा, यरदन नदी के ओ पार, आनजातमन के गलील प्रदेस के आदर करही—<verse eid="ISA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 9:2" />जऊन मनखेमन अंधियार म चलत रिहिन</para>
  <para style="q2" vid="ISA 9:2">ओमन एक बड़े अंजोर ला देखिन;</para>
  <para style="q1" vid="ISA 9:2">अऊ घोर अंधियार के देस म रहइया मनखेमन के ऊपर</para>
  <para style="q2" vid="ISA 9:2">एक अंजोर चमकिस।<verse eid="ISA 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 9:3" />तेंह जाति ला बढ़ाय हवस</para>
  <para style="q2" vid="ISA 9:3">अऊ ओमन ला बहुंत आनंदित करे हवस;</para>
  <para style="q1" vid="ISA 9:3">ओमन तोर आघू म वइसने आनंदित होथें,</para>
  <para style="q2" vid="ISA 9:3">जइसने मनखेमन कटनी के समय आनंदित होथें,</para>
  <para style="q1" vid="ISA 9:3">ओमन वइसने आनंदित होथें</para>
  <para style="q2" vid="ISA 9:3">जइसने योद्धामन लूट के सामान ला बांटे के बेरा आनंदित होथें।<verse eid="ISA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 9:4" />काबरकि तेंह ओमन के घेंच के भारी जुड़ा</para>
  <para style="q2" vid="ISA 9:4">ओमन के खांध के बहिंगा,</para>
  <para style="q1" vid="ISA 9:4">अऊ ओमन ऊपर अंधेर करइयामन के लउठी,</para>
  <para style="q2" vid="ISA 9:4">ये सबो ला अइसन टोर दे हवस,</para>
  <para style="q2" vid="ISA 9:4">जइसन मिदयानीमन के हार के दिन करे रहय।<verse eid="ISA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 9:5" />लड़ई म उपयोग होवइया हर एक सैनिक के पनही</para>
  <para style="q2" vid="ISA 9:5">अऊ लहू म लपटे हर एक ओनहा,</para>
  <para style="q1" vid="ISA 9:5">सब आगी के कौंरा हो जाहीं,</para>
  <para style="q2" vid="ISA 9:5">सब आगी म बारे के काम आहीं।<verse eid="ISA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 9:6" />काबरकि हमर बर एक बालक ह जनमे हे,</para>
  <para style="q2" vid="ISA 9:6">हमन ला एक बेटा दिये गे हवय,</para>
  <para style="q2" vid="ISA 9:6">अऊ परभूता ओकर खांध ऊपर होही।</para>
  <para style="q1" vid="ISA 9:6">अऊ ओकर नांव</para>
  <para style="q2" vid="ISA 9:6">अद्भूत युक्ति करइया, पराकरमी परमेसर,</para>
  <para style="q2" vid="ISA 9:6">अनंतकाल के ददा, अऊ सांति के राजकुमार रखे जाही।<verse eid="ISA 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 9:7" />ओकर परभूता सदा बाढ़त जाही,</para>
  <para style="q2" vid="ISA 9:7">अऊ ओकर सांति के अन्त नइं होही।</para>
  <para style="q1" vid="ISA 9:7">ओह दाऊद के सिंघासन</para>
  <para style="q2" vid="ISA 9:7">अऊ ओकर राज ऊपर सासन करही,</para>
  <para style="q1" vid="ISA 9:7">ओ समय ले लेके सदाकाल बर</para>
  <para style="q2" vid="ISA 9:7">नियाय अऊ धरमीपन के संग</para>
  <para style="q2" vid="ISA 9:7">ओकर राज ह स्थिर रहिही अऊ संभले रहिही।</para>
  <para style="q1" vid="ISA 9:7">सर्वसक्तिमान यहोवा के धुन ह</para>
  <para style="q2" vid="ISA 9:7">येला पूरा करही।<verse eid="ISA 9:7" /></para>
  <para style="s1">इसरायल ऊपर यहोवा के रिस</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 9:8" />परभू ह याकूब के बिरूध एक संदेस पठोय हवय;</para>
  <para style="q2" vid="ISA 9:8">येह इसरायल ऊपर पूरा होही।<verse eid="ISA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 9:9" />जम्मो मनखेमन येला जानहीं—</para>
  <para style="q2" vid="ISA 9:9">एपरैम अऊ सामरिया के रहइया मनखेमन—</para>
  <para style="q1" vid="ISA 9:9">जेमन घमंड अऊ मन के</para>
  <para style="q2" vid="ISA 9:9">कठोरता ले गोठियाथें,<verse eid="ISA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 9:10" />“ईंटामन तो गिर गे हवंय,</para>
  <para style="q2" vid="ISA 9:10">पर हमन गढ़े गय पथरा ले फेर बनाबो;</para>
  <para style="q1" vid="ISA 9:10">डूमर<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अंजीर</char></note> रूखमन ला काटके गिरा देय गे हवय,</para>
  <para style="q2" vid="ISA 9:10">पर ओमन के बदले हमन देवदार के रूख लगाबो।”<verse eid="ISA 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 9:11" />पर यहोवा ह रसीन के बईरीमन ला ओमन के बिरूध मजबूत करे हवय</para>
  <para style="q2" vid="ISA 9:11">अऊ ओमन के बईरीमन ला उकसाय हवय।<verse eid="ISA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 9:12" />पूरब ले अरामीमन अऊ पछिम ले पलिस्तीमन</para>
  <para style="q2" vid="ISA 9:12">मुहूं खोलके इसरायल ला लील ले हवंय।</para>
  <para style="b" vid="ISA 9:12" />
  <para style="q1" vid="ISA 9:12">ये जम्मो होय के बाद घलो, ओकर रिस ह सांत नइं होईस,</para>
  <para style="q2" vid="ISA 9:12">अऊ ओकर हांथ अब तक उठे हवय।<verse eid="ISA 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 9:13" />तभो ले मनखेमन<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">इसरायलीमन</char></note> ओकर मेर लहुंटके नइं गे हवंय, जऊन ह ओमन ला मारिस,</para>
  <para style="q2" vid="ISA 9:13">अऊ न ही ओमन सर्वसक्तिमान यहोवा के खोज करे हवंय।<verse eid="ISA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 9:14" />एकरसेति यहोवा ह इसरायल म ले मुड़ अऊ पुंछी दूनों ला काट डारही,</para>
  <para style="q2" vid="ISA 9:14">खजूर के डंगाली अऊ सरकंडामन ला एके दिन म काट डारही;<verse eid="ISA 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 9:15" />अगुवा अऊ नामी मनखेमन तो मुड़ अंय,</para>
  <para style="q2" vid="ISA 9:15">अऊ लबारी बात सिखोइया अगमजानीमन पुंछी अंय।<verse eid="ISA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 9:16" />जेमन ये मनखेमन के अगुवई करथें ओमन येमन ला भटका देथें,</para>
  <para style="q2" vid="ISA 9:16">अऊ जेमन के अगुवई होथे, ओमन भटक जाथें।<verse eid="ISA 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 9:17" />एकर कारन परभू ह जवानमन ले खुस नइं होही,</para>
  <para style="q2" vid="ISA 9:17">अऊ न ही अनाथ अऊ बिधवामन ऊपर दया करही,</para>
  <para style="q1" vid="ISA 9:17">काबरकि जम्मो झन भक्तिहीन अऊ कुकरमी अंय,</para>
  <para style="q2" vid="ISA 9:17">अऊ हर एक के मुहूं ले मुरूखता के बात निकलथे।</para>
  <para style="b" vid="ISA 9:17" />
  <para style="q1" vid="ISA 9:17">ये जम्मो होय के बाद घलो, ओकर रिस सांत नइं होईस,</para>
  <para style="q2" vid="ISA 9:17">अऊ ओकर हांथ ह अब तक उठे हवय।<verse eid="ISA 9:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 9:18" />खचित दुस्टता ह आगी के सहीं बरथे;</para>
  <para style="q2" vid="ISA 9:18">येह कंटिली झाड़ी अऊ कांटामन ला भसम कर देथे,</para>
  <para style="q1" vid="ISA 9:18">येह जंगल के झाड़ीमन म आगी लगा देथे,</para>
  <para style="q2" vid="ISA 9:18">अऊ येह धुआं के एक खंभा सहीं किंदर-किंदरके ऊपर उठथे।<verse eid="ISA 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 9:19" />सर्वसक्तिमान यहोवा के कोरोध ले</para>
  <para style="q2" vid="ISA 9:19">देस ह जलाय जाही</para>
  <para style="q1" vid="ISA 9:19">अऊ मनखेमन आगी बर लकरी के सहीं होहीं;</para>
  <para style="q2" vid="ISA 9:19">ओमन एक-दूसर ला नइं छोड़हीं।<verse eid="ISA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 9:20" />जेवनी कोति ले ओमन छीन-झपटके खाहीं,</para>
  <para style="q2" vid="ISA 9:20">पर तभो ले ओमन भूखन रहिहीं;</para>
  <para style="q1" vid="ISA 9:20">डेरी कोति ले ओमन खाहीं,</para>
  <para style="q2" vid="ISA 9:20">पर ओमन के पेट नइं भरही।</para>
  <para style="q1" vid="ISA 9:20">हर एक जन अपन खुद के संतान<note caller="+" style="f"><char style="fr" closed="false">9:20 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बाहां</char></note> के मांस ला खाही:<verse eid="ISA 9:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 9:21" />मनस्से ह एपरैम ला अऊ एपरैम ह मनस्से ला खाही;</para>
  <para style="q2" vid="ISA 9:21">एक संग ओमन यहूदा के बिरूध हो जाहीं।</para>
  <para style="b" vid="ISA 9:21" />
  <para style="q1" vid="ISA 9:21">ये जम्मो होय के बाद घलो, ओकर रिस ह सांत नइं होईस,</para>
  <para style="q2" vid="ISA 9:21">अऊ ओकर हांथ अब तक उठे हवय।<verse eid="ISA 9:21" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 9" />
  <chapter number="10" style="c" sid="ISA 10" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 10:1" />ओमन ऊपर हाय, जेमन अनियायी कानून बनाथें,</para>
  <para style="q2" vid="ISA 10:1">जेमन अतियाचारी फैसला सुनाथें,<verse eid="ISA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 10:2" />जेकर ले गरीबमन के नियाय बिगड़थे</para>
  <para style="q2" vid="ISA 10:2">अऊ मोर मनखेमन ला अतियाचार ले नियाय नइं मिलय,</para>
  <para style="q1" vid="ISA 10:2">जेकर ले ओमन बिधवामन ला अपन सिकार बनाथें</para>
  <para style="q2" vid="ISA 10:2">अऊ अनाथमन ला लूटथें।<verse eid="ISA 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 10:3" />ओ दिन तुमन का करहू, जब हिसाब लिये जाही,</para>
  <para style="q2" vid="ISA 10:3">जब दूरिहा ले बिपत्ति आ जाही?</para>
  <para style="q1" vid="ISA 10:3">मदद मांगे बर तुमन काकर करा भागके जाहू?</para>
  <para style="q2" vid="ISA 10:3">तुमन अपन धन-दौलत ला कहां रखहू?<verse eid="ISA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 10:4" />कैदीमन के बीच चापलूसी अऊ मुरदामन के बीच पड़े रहई</para>
  <para style="q2" vid="ISA 10:4">एकर अलावा अऊ कुछू नइं बचही।</para>
  <para style="b" vid="ISA 10:4" />
  <para style="q1" vid="ISA 10:4">ये जम्मो होय के बाद घलो, ओकर रिस ह सांत नइं होईस,</para>
  <para style="q2" vid="ISA 10:4">अऊ ओकर हांथ अब तक उठे हवय।<verse eid="ISA 10:4" /></para>
  <para style="s1">अस्सूर ऊपर परमेसर के दंड</para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 10:5" />“अस्सूर ऊपर हाय, जऊन ह मोर रिस के लउठी,</para>
  <para style="q2" vid="ISA 10:5">अऊ मोर कोप के डंडा अय!<verse eid="ISA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 10:6" />मेंह ओला एक भक्तिहीन जाति के बिरूध भेजत हंव,</para>
  <para style="q2" vid="ISA 10:6">मेंह ओला एक अइसन मनखेमन के बिरूध पठोवत हवंव, जेमन मोला रिस दिलाथें,</para>
  <para style="q1" vid="ISA 10:6">ताकि ओह ओमन के चीजमन ला लूटय अऊ छीनय,</para>
  <para style="q2" vid="ISA 10:6">अऊ ओमन ला गलीमन के चीखला सहीं खुंदय।<verse eid="ISA 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 10:7" />पर येह ओकर इरादा नो हय,</para>
  <para style="q2" vid="ISA 10:7">अऊ न ही ओकर मन म अइसन बिचार हवय;</para>
  <para style="q1" vid="ISA 10:7">ओकर उदेस्य ये अय कि बहुंते जातिमन ला</para>
  <para style="q2" vid="ISA 10:7">नास कर देवय अऊ ओमन ला खतम कर देवय।<verse eid="ISA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 10:8" />काबरकि ओह कहिथे, ‘का मोर जम्मो सेनापतिमन राजा सहीं नो हंय?<verse eid="ISA 10:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="ISA 10:9" />का कलनो ह कर्कमीस सहीं नो हय?</para>
  <para style="q1" vid="ISA 10:9">का हमात ह अरपाद के सहीं,</para>
  <para style="q2" vid="ISA 10:9">सामरिया ह दमिस्क के सहीं नो हय?<verse eid="ISA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 10:10" />जइसन मोर हांथ मूरतीमन ले भरे ओ राजमन ऊपर पहुंचिस,</para>
  <para style="q2" vid="ISA 10:10">जेकर मूरतीमन यरूसलेम अऊ सामरिया के मूरतीमन ले बढ़के रिहिन—<verse eid="ISA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 10:11" />का मेंह यरूसलेम अऊ ओकर मूरतीमन ले वइसे नइं करंव</para>
  <para style="q2" vid="ISA 10:11">जइसे मेंह सामरिया अऊ ओकर मूरतीमन ले करेंव?’ ”<verse eid="ISA 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12" />जब परभू ह सियोन पहाड़ अऊ यरूसलेम के बिरूध अपन सब काम ला कर डारही, तब ओह कहिही, “मेंह अस्सूर के राजा ला ओकर घमंड ले भरे बात अऊ घमंड ले चढ़े ओकर आंखी के दंड दूहूं। <verse eid="ISA 10:12" /><verse number="13" style="v" sid="ISA 10:13" />काबरकि अस्सूर के राजा ह कहिथे:</para>
  <para style="q1" vid="ISA 10:13">“ ‘अपन ही बाहुबल ले मेंह येला करे हंव,</para>
  <para style="q2" vid="ISA 10:13">अऊ अपन बुद्धि ले घलो करे हंव, काबरकि मोर करा समझ हवय।</para>
  <para style="q1" vid="ISA 10:13">मेंह देस-देस के सीमना ला हटा देंव,</para>
  <para style="q2" vid="ISA 10:13">अऊ ओमन के रखे गय धन ला लूट लेंव;</para>
  <para style="q2" vid="ISA 10:13">एक बलसाली जन के सहीं मेंह ओमन के राजामन ला अपन अधीन कर लेंव।<verse eid="ISA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 10:14" />जइसे कोनो मनखे चिरई के खोंधरा करा हबरथे,</para>
  <para style="q2" vid="ISA 10:14">वइसे देस-देस के मनखेमन के धन-संपत्ति करा मोर हांथ ह पहुंचे हवय;</para>
  <para style="q1" vid="ISA 10:14">जइसन छोंड़ दिये गय अंडामन ला मनखेमन बटोरथें,</para>
  <para style="q2" vid="ISA 10:14">वइसन ही मेंह जम्मो देसमन ला बटोर ले हंव;</para>
  <para style="q1" vid="ISA 10:14">कोनो घलो अपन डेना नइं फड़फड़ाईन,</para>
  <para style="q2" vid="ISA 10:14">अऊ न ही कोनो अपन मुहूं खोलके चीं-चीं करिन।’ ”<verse eid="ISA 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 10:15" />का टंगिया ह अपनआप ला ओकर ले जादा ऊपर करथे, जऊन ह येला चलाथे,</para>
  <para style="q2" vid="ISA 10:15">या आरी ह ओकर बिरूध बड़ई करथे, जऊन ह येकर उपयोग करथे?</para>
  <para style="q1" vid="ISA 10:15">येह तो वइसने अय, जइसने सोंटा ह ओ मनखे ला चलाय, जऊन ह येला उठाथे,</para>
  <para style="q2" vid="ISA 10:15">या छड़ी ह ओला उठाय, जऊन ह लकरी नो हय!<verse eid="ISA 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 10:16" />एकर कारन परभू, सर्वसक्तिमान यहोवा ह</para>
  <para style="q2" vid="ISA 10:16">ओकर हट्टा-कट्टा योद्धामन ऊपर एक दुरबल करइया बेमारी पठोही;</para>
  <para style="q1" vid="ISA 10:16">अऊ ओकर ठाट-बाट के खाल्हे</para>
  <para style="q2" vid="ISA 10:16">धधकत जुवाला के सहीं आगी जलाय जाही।<verse eid="ISA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 10:17" />इसरायल के अंजोर ह एक आगी,</para>
  <para style="q2" vid="ISA 10:17">अऊ ओमन के पबितर जन ह एक जुवाला हो जाही;</para>
  <para style="q1" vid="ISA 10:17">एकेच दिन म ओकर कांटा अऊ कंटिली झाड़ीमन</para>
  <para style="q2" vid="ISA 10:17">जलके भसम हो जाहीं।<verse eid="ISA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 10:18" />जइसन कोनो बेमार मनखे ह दुरबल होके बेकार हो जाथे,</para>
  <para style="q2" vid="ISA 10:18">वइसन ही ओकर जंगल अऊ उपजाऊ खेतमन के सोभा ला</para>
  <para style="q2" vid="ISA 10:18">पूरा नास कर दिये जाही।<verse eid="ISA 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 10:19" />अऊ ओकर जंगल के बांचे रूखमन अतेक कम हो जाहीं</para>
  <para style="q2" vid="ISA 10:19">कि कोनो लइका घलो ओमन ला गनके लिख लीही।<verse eid="ISA 10:19" /></para>
  <para style="s1">इसरायल के बांचे भाग</para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 10:20" />ओ दिन इसरायल के बांचे मनखेमन,</para>
  <para style="q2" vid="ISA 10:20">याकूब के बांचे मनखेमन</para>
  <para style="q1" vid="ISA 10:20">ओकर ऊपर फेर कभू भरोसा नइं करहीं</para>
  <para style="q2" vid="ISA 10:20">जऊन ह ओमन ला मारिस</para>
  <para style="q1" vid="ISA 10:20">पर सही म ओमन यहोवा,</para>
  <para style="q2" vid="ISA 10:20">इसरायल के पबितर परमेसर ऊपर भरोसा करहीं।<verse eid="ISA 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 10:21" />एक बांचे भाग ह लहुंट आही,<note caller="+" style="f"><char style="fr" closed="false">10:21 </char><char style="ft" closed="false">सार-यासूब (देखव <char style="xt"><ref loc="ISA 7:3">7:3</ref></char> ला); <char style="xt" link-href="ISA 10:22"><ref loc="ISA 10:22">पद 22</ref></char> म घलो</char></note></para>
  <para style="q2" vid="ISA 10:21">याकूब के एक बांचे भाग ह सक्तिसाली परमेसर करा लहुंट आही।<verse eid="ISA 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 10:22" />हे इसरायल, चाहे तोर मनखेमन समुंदर के बालू सहीं होहीं,</para>
  <para style="q2" vid="ISA 10:22">पर सिरिप एक बांचे भाग ही लहुंटही।</para>
  <para style="q1" vid="ISA 10:22">बिनास के फैसला करे जा चुके हवय</para>
  <para style="q2" vid="ISA 10:22">ये अभिभूत करइया फैसला नियाय के संग करे गे हवय।<verse eid="ISA 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 10:23" />परभू, सर्वसक्तिमान यहोवा ह पूरा देस म</para>
  <para style="q2" vid="ISA 10:23">बिनास के फैसला ला पूरा करही।<verse eid="ISA 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24" />एकरसेति परभू, सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 10:24">“हे सियोन म रहइया मोर मनखेमन,</para>
  <para style="q2" vid="ISA 10:24">अस्सूरीमन ले झन डरव,</para>
  <para style="q1" vid="ISA 10:24">जेमन तुमन ला सोंटा ले मारथें</para>
  <para style="q2" vid="ISA 10:24">अऊ मिसर के मनखेमन सहीं तुम्हर ऊपर छड़ी उठाथें।<verse eid="ISA 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 10:25" />बहुंत जल्दी तुम्हर ऊपर मोर रिस ह सांत हो जाही</para>
  <para style="q2" vid="ISA 10:25">अऊ मोर कोप ह ओमन के बिनास बर भड़कही।”<verse eid="ISA 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 10:26" />सर्वसक्तिमान यहोवा ह ओमन ला कोर्रा म अइसन मारही,</para>
  <para style="q2" vid="ISA 10:26">जइसन ओह ओरेब नांव के चट्टान करा मिदयानीमन ला मारे रिहिस;</para>
  <para style="q1" vid="ISA 10:26">अऊ ओह समुंदर ऊपर अपन लउठी ला उठाही,</para>
  <para style="q2" vid="ISA 10:26">जइसे कि ओह मिसर देस म करे रिहिस।<verse eid="ISA 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 10:27" />ओ दिन ओमन के बोझा तुम्हर खांध ले</para>
  <para style="q2" vid="ISA 10:27">अऊ ओमन के जुड़ा तुम्हर घेंच ले उतार दिये जाही;</para>
  <para style="q1" vid="ISA 10:27">ये जुड़ा ला टोर दिये जाही</para>
  <para style="q2" vid="ISA 10:27">काबरकि तुमन बहुंत मोटा हो गे हव।<verse eid="ISA 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="ISA 10:28" />ओमन अय्यात सहर के भीतर आथें;</para>
  <para style="q2" vid="ISA 10:28">अऊ मिगरोन नगर म ले होके जाथें;</para>
  <para style="q2" vid="ISA 10:28">मिकमास नगर म ओमन अपन सामान रखथें।<verse eid="ISA 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 10:29" />ओमन घाटी ला नाहकके कहिथें,</para>
  <para style="q2" vid="ISA 10:29">“हमन गेबा नगर म रथिया डेरा डालबो।”</para>
  <para style="q1" vid="ISA 10:29">रामा नगर ह कांपथे;</para>
  <para style="q2" vid="ISA 10:29">साऊल के गिबा नगर ह भाग जाथे।<verse eid="ISA 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 10:30" />हे बेटी गल्लीम, चिचिया!</para>
  <para style="q2" vid="ISA 10:30">हे लैसा, सुन!</para>
  <para style="q2" vid="ISA 10:30">बिचारा अनातोत!<verse eid="ISA 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 10:31" />मदमेना नगर ह भागत हवय;</para>
  <para style="q2" vid="ISA 10:31">गेबीम नगर के मनखेमन भागे बर अपन सामान ला इकट्ठा करत हवंय।<verse eid="ISA 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 10:32" />आज ओमन नोब नगर म रूकहीं;</para>
  <para style="q2" vid="ISA 10:32">बेटी सियोन के पहाड़ ऊपर,</para>
  <para style="q1" vid="ISA 10:32">यरूसलेम के पहाड़ी ऊपर,</para>
  <para style="q2" vid="ISA 10:32">ओमन हांथ उठाके धमकाहीं।<verse eid="ISA 10:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="ISA 10:33" />देखव, परभू, सर्वसक्तिमान यहोवा ह</para>
  <para style="q2" vid="ISA 10:33">बड़े सक्ति ले डारामन ला काट डारही।</para>
  <para style="q1" vid="ISA 10:33">बड़े-बड़े रूखमन ला काटके गिराय जाही,</para>
  <para style="q2" vid="ISA 10:33">अऊ ऊंच-ऊंच रूखमन ला खाल्हे करे जाही।<verse eid="ISA 10:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 10:34" />ओह घना जंगल ला टंगिया ले काट डारही;</para>
  <para style="q2" vid="ISA 10:34">अऊ लबानोन ह परतापी परमेसर के आघू म गिरही।<verse eid="ISA 10:34" /></para>
  <chapter eid="ISA 10" />
  <chapter number="11" style="c" sid="ISA 11" />
  <para style="s1">यिसै के डाली</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 11:1" />यिसै के ठूंठ म ले एक डंगाल फूट निकलही;</para>
  <para style="q2" vid="ISA 11:1">ओकर जरी म ले एक ठन डंगाल ह फरही।<verse eid="ISA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 11:2" />यहोवा के आतमा ओकर ऊपर ठहिरही—</para>
  <para style="q2" vid="ISA 11:2">येह बुद्धि अऊ समझ के आतमा,</para>
  <para style="q2" vid="ISA 11:2">युक्ति अऊ पराकरम के आतमा,</para>
  <para style="q2" vid="ISA 11:2">गियान के आतमा अऊ यहोवा के डर होही—<verse eid="ISA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 11:3" />अऊ ओह यहोवा के डर म खुस होही।</para>
  <para style="b" vid="ISA 11:3" />
  <para style="q1" vid="ISA 11:3">ओह मुहूं देखके नियाय नइं करही,</para>
  <para style="q2" vid="ISA 11:3">या अपन कान ले सुनके निरनय नइं करही;<verse eid="ISA 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 11:4" />पर धरमीपन ले ओह जरूरतमंद के नियाय करही,</para>
  <para style="q2" vid="ISA 11:4">अऊ धरती के गरीबमन के निरनय सच्चई से करही।</para>
  <para style="q1" vid="ISA 11:4">ओह धरती ला अपन बचन के छड़ी ले मारही;</para>
  <para style="q2" vid="ISA 11:4">अऊ अपन फूंक के झोंका ले ओह दुस्टमन ला मिटा दीही।<verse eid="ISA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 11:5" />धरमीपन ह ओकर पट्टा</para>
  <para style="q2" vid="ISA 11:5">अऊ बिसवासयोग्यता ह ओकर कनिहां के पट्टी होही।<verse eid="ISA 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 11:6" />भेड़िया ह मेढ़ा-पीला के संग रहिही,</para>
  <para style="q2" vid="ISA 11:6">अऊ चीतवा ह छेरी संग बईठही,</para>
  <para style="q1" vid="ISA 11:6">बछवा अऊ सेर अऊ पसु के पीला एक संग रहिहीं;</para>
  <para style="q2" vid="ISA 11:6">अऊ एक छोटे लड़का ह ओमन के अगुवई करही।<verse eid="ISA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 11:7" />गाय अऊ भालू एके संग चरहीं,</para>
  <para style="q2" vid="ISA 11:7">ओमन के पीलामन एक संग बईठहीं,</para>
  <para style="q2" vid="ISA 11:7">अऊ सिंह ह बईला सहीं भूंसा खाही।<verse eid="ISA 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 11:8" />दूध पीयत लइका ह नाग सांप के बिल मेर खेलही,</para>
  <para style="q2" vid="ISA 11:8">अऊ छोटे लइका ह करैत के बिल म हांथ डालही।<verse eid="ISA 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 11:9" />मोर जम्मो पबितर पहाड़ ऊपर</para>
  <para style="q2" vid="ISA 11:9">न तो ओमन चोट पहुंचाहीं अऊ न ही नास करहीं,</para>
  <para style="q1" vid="ISA 11:9">काबरकि धरती ह यहोवा के गियान ले अइसन भर जाही</para>
  <para style="q2" vid="ISA 11:9">जइसन पानी समुंदर म भरे रहिथे।<verse eid="ISA 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10" />ओ दिन यिसै के जरी ह मनखेमन बर एक झंडा होही; जाति-जाति के मनखेमन ओकर करा जूरहीं, अऊ ओकर अराम करे के जगह ह महिमामय होही। <verse eid="ISA 11:10" /><verse number="11" style="v" sid="ISA 11:11" />ओ दिन परभू ह दूसर बेर अपन बांचे मनखेमन ला सुधारे बर अस्सूर ले, मिसर के खाल्हे भाग ले, ऊपरी मिसर ले, कूस ले, एलाम ले, बेबिलोनिया<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">सिनार</char></note> ले, हमात ले, अऊ भूमध्य सागर के द्वीपमन ले हांथ बढ़ाके लानही।<verse eid="ISA 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 11:12" />ओह जाति-जाति के मनखे बर एक ठन झंडा ठाढ़ करही</para>
  <para style="q2" vid="ISA 11:12">अऊ इसरायल के बंधुवामन ला इकट्ठा करही;</para>
  <para style="q1" vid="ISA 11:12">ओह यहूदा के सब बगर गय मनखेमन ला</para>
  <para style="q2" vid="ISA 11:12">धरती के चारों कोना ले इकट्ठा करही।<verse eid="ISA 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 11:13" />फेर एपरैम के डाह करई ह खतम हो जाही,</para>
  <para style="q2" vid="ISA 11:13">अऊ यहूदा के बईरीमन ला नास करे जाही;</para>
  <para style="q1" vid="ISA 11:13">एपरैम ह यहूदा ले डाह नइं करही,</para>
  <para style="q2" vid="ISA 11:13">अऊ न ही यहूदा ह एपरैम ला तंग करही।<verse eid="ISA 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 11:14" />ओमन पछिम कोति ढाल म पलिस्तीमन ऊपर टूट पड़हीं;</para>
  <para style="q2" vid="ISA 11:14">एक संग मिलके ओमन पूरब कोति के मनखेमन ला लूटहीं।</para>
  <para style="q1" vid="ISA 11:14">ओमन एदोम अऊ मोआब ला जीत लीहीं,</para>
  <para style="q2" vid="ISA 11:14">अऊ अमोनीमन ओमन के अधीन हो जाहीं।<verse eid="ISA 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 11:15" />यहोवा ह मिसर के</para>
  <para style="q2" vid="ISA 11:15">समुंदर के खाड़ी ला सूखा दीही;</para>
  <para style="q1" vid="ISA 11:15">झुलसा देवइया हवा के संग ओह</para>
  <para style="q2" vid="ISA 11:15">फरात नदी ऊपर अपन हांथ बढ़ाही।</para>
  <para style="q1" vid="ISA 11:15">ओह येला सात ठन धारा म बांट दीही</para>
  <para style="q2" vid="ISA 11:15">ताकि मनखेमन रेंगत ओ पार हो जावंय।<verse eid="ISA 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 11:16" />ओकर बांचे मनखेमन बर अस्सूर ले</para>
  <para style="q2" vid="ISA 11:16">एक अइसन राजमार्ग होही,</para>
  <para style="q1" vid="ISA 11:16">जइसन इसरायलीमन बर रिहिस,</para>
  <para style="q2" vid="ISA 11:16">जब ओमन मिसर देस ले निकलके आईन।<verse eid="ISA 11:16" /></para>
  <chapter eid="ISA 11" />
  <chapter number="12" style="c" sid="ISA 12" />
  <para style="s1">इस्तुति के गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1" />ओ दिन तें कहिबे:</para>
  <para style="q1" vid="ISA 12:1">“हे यहोवा, मेंह तोर परसंसा करहूं।</para>
  <para style="q2" vid="ISA 12:1">हालाकि तें मोर ऊपर रिस करत रहे,</para>
  <para style="q1" vid="ISA 12:1">पर तोर रिस ह सांत हो गीस</para>
  <para style="q2" vid="ISA 12:1">अऊ तेंह मोला सांति देय हवस।<verse eid="ISA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 12:2" />खचित परमेसर ह मोर उद्धार अय;</para>
  <para style="q2" vid="ISA 12:2">मेंह भरोसा रखहूं अऊ नइं डरहूं।</para>
  <para style="q1" vid="ISA 12:2">काबरकि यहोवा, यहोवा खुद मोर बल अऊ मोर सुरकछा<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">गीत</char></note> अय;</para>
  <para style="q2" vid="ISA 12:2">ओह मोर उद्धारकर्ता हो गे हवय।”<verse eid="ISA 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 12:3" />आनंद समेत तुमन उद्धार के</para>
  <para style="q2" vid="ISA 12:3">कुआंमन ले पानी भरहू।<verse eid="ISA 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 12:4" />ओ दिन तुमन कहिहू:</para>
  <para style="q1" vid="ISA 12:4">“यहोवा के परसंसा करव, ओकर नांव के घोसना करव;</para>
  <para style="q2" vid="ISA 12:4">जाति-जाति के मनखेमन के बीच ओकर काममन के परचार करव,</para>
  <para style="q2" vid="ISA 12:4">अऊ घोसना करव कि ओकर नांव महान अय।<verse eid="ISA 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 12:5" />यहोवा के भजन गावव, काबरकि ओह परतापी काम करे हवय;</para>
  <para style="q2" vid="ISA 12:5">ये बात जम्मो संसार म बतावव।<verse eid="ISA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 12:6" />हे सियोन के मनखेमन, जोर से चिचियावव अऊ आनंद के मारे गावव,</para>
  <para style="q2" vid="ISA 12:6">काबरकि इसरायल के पबितर परमेसर ह तुम्हर बीच महान अय।”<verse eid="ISA 12:6" /></para>
  <chapter eid="ISA 12" />
  <chapter number="13" style="c" sid="ISA 13" />
  <para style="s1">बेबिलोन के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1" />बेबिलोन के बिरूध अगमबानी, जऊन ला आमोस के बेटा यसायाह ह दरसन म पाईस:<verse eid="ISA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 13:2" />खाली पहाड़ी के टीप म एक ठन झंडा ठाढ़ करव,</para>
  <para style="q2" vid="ISA 13:2">ओमन ला पुकारव;</para>
  <para style="q1" vid="ISA 13:2">ओमन ला हांथ ले इसारा करव</para>
  <para style="q2" vid="ISA 13:2">कि ओमन परभावसाली मनखेमन के दुवारमन म प्रवेस करंय।<verse eid="ISA 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 13:3" />मेंह ओमन ला हुकूम दे हंव, जेमन ला मेंह लड़ई बर तियार करे हंव;</para>
  <para style="q2" vid="ISA 13:3">मेंह अपन कोप ला पूरा करे बर अपन ओ योद्धामन ला बलाय हंव—</para>
  <para style="q2" vid="ISA 13:3">जेमन मोर जीत म आनंद मनाथें।<verse eid="ISA 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 13:4" />सुनव, पहाड़मन के ऊपर ले</para>
  <para style="q2" vid="ISA 13:4">एक बड़े भीड़ सहीं हल्ला-गुल्ला सुनई देवत हवय!</para>
  <para style="q1" vid="ISA 13:4">सुनव, राज-राजमन के बीच एक कोलाहल होवत हवय,</para>
  <para style="q2" vid="ISA 13:4">मानो जाति-जाति के मनखेमन इकट्ठा होवत हवंय!</para>
  <para style="q1" vid="ISA 13:4">सर्वसक्तिमान यहोवा ह युद्ध बर</para>
  <para style="q2" vid="ISA 13:4">अपन सेना ला इकट्ठा करत हे।<verse eid="ISA 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 13:5" />ओमन दूर देस म ले,</para>
  <para style="q2" vid="ISA 13:5">अकास के छोर म ले आथें—</para>
  <para style="q1" vid="ISA 13:5">हव, यहोवा ह अपन कोप के हथियार के संग</para>
  <para style="q2" vid="ISA 13:5">पूरा देस ला नास करे बर आवत हवय।<verse eid="ISA 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 13:6" />बिलाप करव, काबरकि यहोवा के दिन ह लकठा म हवय;</para>
  <para style="q2" vid="ISA 13:6">येह सर्वसक्तिमान परमेसर करा ले सतियानास करे बर आही।<verse eid="ISA 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 13:7" />एकर कारन सब के हांथमन कमजोर हो जाहीं,</para>
  <para style="q2" vid="ISA 13:7">हर मनखे के मन म डर हमा जाही।<verse eid="ISA 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 13:8" />आतंक ह ओमन ला जकड़ लीही,</para>
  <para style="q2" vid="ISA 13:8">ओमन के पीरा अऊ सोक ह बढ़ जाही;</para>
  <para style="q2" vid="ISA 13:8">ओमन छेवारी होवत माईलोगन सहीं छटपटाहीं।</para>
  <para style="q1" vid="ISA 13:8">ओमन चकित होके एक-दूसर ला ताकहीं, अऊ ओमन के मुहूंमन जल जाहीं।<verse eid="ISA 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 13:9" />देखव, यहोवा के दिन ह आवत हवय</para>
  <para style="q2" vid="ISA 13:9">—देस ला उजारे</para>
  <para style="q1" vid="ISA 13:9">अऊ पापीमन ला ओमा नास करे बर कोप</para>
  <para style="q2" vid="ISA 13:9">अऊ भयंकर कोरोध के संग एक निरदयता के दिन आवत हवय।<verse eid="ISA 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 13:10" />अकास के तारामन अऊ ओमन के तारा मंडल</para>
  <para style="q2" vid="ISA 13:10">अपन अंजोर नइं दीहीं।</para>
  <para style="q1" vid="ISA 13:10">सूरज ह निकलत-निकलत अंधियार हो जाही</para>
  <para style="q2" vid="ISA 13:10">अऊ चंदा अपन अंजोर नइं दीही।<verse eid="ISA 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 13:11" />मेंह संसार ला ओकर दुस्टता बर</para>
  <para style="q2" vid="ISA 13:11">दुस्ट मनखे ला ओकर पाप बर दंड दूहूं।</para>
  <para style="q1" vid="ISA 13:11">मेंह घमंडी के घमंड ला खतम कर दूहूं</para>
  <para style="q2" vid="ISA 13:11">अऊ निरदयी मनखे के घमंड ला टोर दूहूं।<verse eid="ISA 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 13:12" />मेंह मनखेमन के गनती ला सुध सोन ले घलो कम,</para>
  <para style="q2" vid="ISA 13:12">ओपीर के सोन ले घलो जादा दुरलभ कर दूहूं।<verse eid="ISA 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 13:13" />एकरसेति सर्वसक्तिमान यहोवा के कोप म,</para>
  <para style="q2" vid="ISA 13:13">ओकर भड़के भयंकर कोरोध के दिन</para>
  <para style="q1" vid="ISA 13:13">मेंह अकास ला कंपवाहूं;</para>
  <para style="q2" vid="ISA 13:13">अऊ धरती ह अपन जगह ले डोलही।<verse eid="ISA 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 13:14" />सिकार करे गय हिरन के सहीं,</para>
  <para style="q2" vid="ISA 13:14">बिन चरवाहा के भेड़मन के सहीं,</para>
  <para style="q1" vid="ISA 13:14">ओमन अपन खुद के मनखेमन करा लहुंटहीं,</para>
  <para style="q2" vid="ISA 13:14">ओमन भागके अपन-अपन देस चल दीहीं।<verse eid="ISA 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 13:15" />जऊन ह बंदी बनाय जाही, ओला छुरा भोंग दिये जाही;</para>
  <para style="q2" vid="ISA 13:15">जऊन मन पकड़े जाहीं, ओ जम्मो के जम्मो तलवार ले मारे जाहीं।<verse eid="ISA 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 13:16" />ओमन के छोटे लइकामन ला ओमन के आघू म पटकके कुटा-कुटा कर दिये जाही;</para>
  <para style="q2" vid="ISA 13:16">ओमन के घरमन लूट लिये जाहीं अऊ ओमन के घरवालीमन के संग कुकरम करे जाही।<verse eid="ISA 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 13:17" />देखव, मेंह ओमन के बिरूध मादीमन ला भड़काहूं,</para>
  <para style="q2" vid="ISA 13:17">जेमन के मन म चांदी बर न तो कुछू मोह रहय</para>
  <para style="q2" vid="ISA 13:17">अऊ न ही सोन के कोनो लालच।<verse eid="ISA 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 13:18" />ओमन के तीरमन जवानमन ला मार गिराहीं;</para>
  <para style="q2" vid="ISA 13:18">ओमन छोटे लइकामन ऊपर कुछू दया नइं करहीं,</para>
  <para style="q2" vid="ISA 13:18">अऊ न ही लइकामन ऊपर कुछू तरस खाहीं।<verse eid="ISA 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 13:19" />बेबिलोन, जऊन ह सब राजमन के मनि,</para>
  <para style="q2" vid="ISA 13:19">बेबिलोनीमन<note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> के सोभा अऊ घमंड अय,</para>
  <para style="q1" vid="ISA 13:19">ओला परमेसर ह सदोम</para>
  <para style="q2" vid="ISA 13:19">अऊ अमोरा सहर के सहीं उखानके फेंक दीही।<verse eid="ISA 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 13:20" />पीढ़ी-पीढ़ी तक उहां न तो कोनो निवास करहीं</para>
  <para style="q2" vid="ISA 13:20">अऊ न ही उहां कोनो रहिहीं;</para>
  <para style="q1" vid="ISA 13:20">घुमंतू जाति के मनखेमन न तो उहां डेरा डालहीं,</para>
  <para style="q2" vid="ISA 13:20">अऊ न ही चरवाहामन अपन पसुमन ला उहां बईठाहीं।<verse eid="ISA 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 13:21" />पर मरू-भुइयां के पसुमन उहां रहिहीं,</para>
  <para style="q2" vid="ISA 13:21">सियारमन ओकर घरमन म भर जाहीं;</para>
  <para style="q1" vid="ISA 13:21">उहां उल्लूमन के बसेरा होही,</para>
  <para style="q2" vid="ISA 13:21">अऊ उहां जंगली बोकरामन एती-ओती कूदहीं।<verse eid="ISA 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 13:22" />उहां के गढ़मन म हुंर्रामन के</para>
  <para style="q2" vid="ISA 13:22">अऊ सुख-बिलास के महलमन म सियारमन के बसेरा होही।</para>
  <para style="q1" vid="ISA 13:22">ओकर समय ह लकठा म हवय,</para>
  <para style="q2" vid="ISA 13:22">अऊ ओकर दिनमन ला अऊ बढ़ाय नइं जावय।<verse eid="ISA 13:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 13" />
  <chapter number="14" style="c" sid="ISA 14" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 14:1" />यहोवा ह याकूब<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अपन मनखे इसरायल</char></note> ऊपर दया करही;</para>
  <para style="q2" vid="ISA 14:1">एक बार फेर ओह इसरायल ला अपनाही</para>
  <para style="q2" vid="ISA 14:1">अऊ ओमन ला ओमन के खुद के देस म बसाही।</para>
  <para style="q1" vid="ISA 14:1">परदेसीमन ओमन के संग जुड़ जाहीं</para>
  <para style="q2" vid="ISA 14:1">अऊ याकूब के संतानमन के संग मिल जाहीं।<verse eid="ISA 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 14:2" />जाति-जाति के मनखेमन ओमन ला</para>
  <para style="q2" vid="ISA 14:2">ओमन के खुद के जगह म पहुंचाहीं।</para>
  <para style="q1" vid="ISA 14:2">अऊ इसरायल ह जाति-जाति के मनखेमन ऊपर अधिकार कर लीही</para>
  <para style="q2" vid="ISA 14:2">अऊ ओमन ला यहोवा के देस म दास अऊ दासी बना लीही।</para>
  <para style="q1" vid="ISA 14:2">इसरायलीमन ओमन ला बंदी बना लीहीं, जेमन इसरायलीमन ला बंदी बनाय रिहिन</para>
  <para style="q2" vid="ISA 14:2">अऊ इसरायलीमन अपन ऊपर अतियाचार करइयामन ऊपर सासन करहीं।<verse eid="ISA 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3" />ओ दिन यहोवा ह तुमन ला तुम्हर दुख अऊ घबराहट अऊ ओ कठोर मेहनत ले अराम दीही, जेला तुम्हर ले जबरदस्ती करवाय जावत रिहिस, <verse eid="ISA 14:3" /><verse number="4" style="v" sid="ISA 14:4" />तुमन बेबिलोन के राजा ऊपर ये ताना मारहू:</para>
  <para style="q1" vid="ISA 14:4">सतइयामन कइसन नास हो गे हवंय!</para>
  <para style="q2" vid="ISA 14:4">ओकर कोरोध ह कइसन खतम हो गीस!<verse eid="ISA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 14:5" />यहोवा ह दुस्टमन के सोंटा,</para>
  <para style="q2" vid="ISA 14:5">अऊ सासन करइयामन के राजदंड ला टोर दे हवय,<verse eid="ISA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 14:6" />जेकर ले ओमन गुस्सा होके</para>
  <para style="q2" vid="ISA 14:6">मनखेमन ला लगातार मारत रहंय,</para>
  <para style="q2" vid="ISA 14:6">अऊ जाति-जाति के मनखेमन ऊपर हमेसा कोरोध करत परभूता करंय।<verse eid="ISA 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 14:7" />अब पूरा धरती ला अराम अऊ सांति मिले हवय;</para>
  <para style="q2" vid="ISA 14:7">मनखेमन खुसी म गीत गावत हवंय।<verse eid="ISA 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 14:8" />अऊ त अऊ सनोवर अऊ लबानोन के देवदार रूख घलो</para>
  <para style="q2" vid="ISA 14:8">तुम्हर ऊपर खुस होके कहिथें,</para>
  <para style="q1" vid="ISA 14:8">“जब ले तुमन ला गिराय गे हवय,</para>
  <para style="q2" vid="ISA 14:8">तब ले कोनो हमन ला काटे बर नइं आवंय।”<verse eid="ISA 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 14:9" />खाल्हे मिरतू-लोक म तुम्हर आय ले</para>
  <para style="q2" vid="ISA 14:9">तुम्हर ले मिले बर हलचल होवत हे;</para>
  <para style="q1" vid="ISA 14:9">येह मुरदामन के आतमामन ला तुम्हर ले भेंट करे बर जगाथे—</para>
  <para style="q2" vid="ISA 14:9">ओ जम्मो ला, जेमन संसार म अगुवा रिहिन;</para>
  <para style="q1" vid="ISA 14:9">येह ओमन ला ओमन के सिंघासन ले ठाढ़ कराथे—</para>
  <para style="q2" vid="ISA 14:9">ओ जम्मो ला, जेमन जाति-जाति के मनखेमन ऊपर राजा रिहिन।<verse eid="ISA 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 14:10" />ओ जम्मो झन जबाब दीहीं,</para>
  <para style="q2" vid="ISA 14:10">ओमन तुमन ले कहिहीं,</para>
  <para style="q1" vid="ISA 14:10">“तुमन घलो हमर सहीं कमजोर हो गे हवव;</para>
  <para style="q2" vid="ISA 14:10">तुमन हमर सहीं बन गे हवव।”<verse eid="ISA 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 14:11" />तुम्हर जम्मो ठाट-बाट अऊ तुम्हर बीना के अवाज ला</para>
  <para style="q2" vid="ISA 14:11">मिरतू-लोक म कर देय गे हवय;</para>
  <para style="q1" vid="ISA 14:11">कीरामन तोर खाल्हे दसना म</para>
  <para style="q2" vid="ISA 14:11">अऊ गेंगरूआमन तोला ऊपर ले ढांप लेथें।<verse eid="ISA 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 14:12" />हे बिहान के तारा, बड़े बिहनियां के बेटा,</para>
  <para style="q2" vid="ISA 14:12">तें कइसे अकास ले गिरे हवस!</para>
  <para style="q1" vid="ISA 14:12">एक समय रिहिस, जब तें जाति-जाति के मनखेमन ला गिराय रहे,</para>
  <para style="q2" vid="ISA 14:12">पर अब तेंह खाल्हे धरती म गिराय गे हवस!<verse eid="ISA 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 14:13" />तेंह अपन मन म कहय,</para>
  <para style="q2" vid="ISA 14:13">“मेंह स्वरग ऊपर चघहूं;</para>
  <para style="q1" vid="ISA 14:13">मेंह अपन सिंघासन ला</para>
  <para style="q2" vid="ISA 14:13">परमेसर के तारागन ले अधिक ऊंचहा करहूं;</para>
  <para style="q1" vid="ISA 14:13">मेंह सभा के पहाड़ ऊपर, सापोन<note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="ft" closed="false">सापोन ह कनानीमन के सबले पबितर पहाड़ रिहिस</char></note> पहाड़ ऊपर</para>
  <para style="q2" vid="ISA 14:13">सबले दूरिहा जगह म बिराजहूं।<verse eid="ISA 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 14:14" />मेंह बादर ले घलो ऊपर ऊंच जगह म चघहूं;</para>
  <para style="q2" vid="ISA 14:14">मेंह अपनआप ला सर्वोच्च परमेसर के सहीं बनाहूं।”<verse eid="ISA 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 14:15" />पर तेंह मिरतू-लोक म</para>
  <para style="q2" vid="ISA 14:15">खंचवा के गहरई म लाने गे हवस।<verse eid="ISA 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 14:16" />जेमन के नजर तोर ऊपर जाथे, ओमन टकटकी लगाके तोला देखथें,</para>
  <para style="q2" vid="ISA 14:16">अऊ तोर बारे म सोचथें अऊ कहिथें:</para>
  <para style="q1" vid="ISA 14:16">“का येह ओही मनखे अय, जऊन ह धरती ला कंपा देवय</para>
  <para style="q2" vid="ISA 14:16">अऊ राजमन ला डोला देवय,<verse eid="ISA 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 14:17" />का येह ओ मनखे अय, जऊन ह संसार ला निरजन प्रदेस बना देवय,</para>
  <para style="q2" vid="ISA 14:17">अऊ सहरमन ला गिरा देवय</para>
  <para style="q2" vid="ISA 14:17">अऊ अपन बंधुवा मनखेमन ला ओमन के घर नइं जावन देवय?”<verse eid="ISA 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 14:18" />जाति-जाति के सब राजामन</para>
  <para style="q2" vid="ISA 14:18">अपन-अपन कबर म चैन से परे हवंय।<verse eid="ISA 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 14:19" />पर तेंह कंटिली डाली के सहीं</para>
  <para style="q2" vid="ISA 14:19">अपन कबर ले फेंक दिये गे हवस;</para>
  <para style="q1" vid="ISA 14:19">तें मारे गय मनखेमन के लास ले पाट दिये गे हवस,</para>
  <para style="q2" vid="ISA 14:19">ओ मनखेमन के लास ले, जेमन तलवार ले मारे गीन,</para>
  <para style="q2" vid="ISA 14:19">ओमन के लास, जेमन ला खंचवा के पथरामन म डारे गीस।</para>
  <para style="q1" vid="ISA 14:19">गोड़ खाल्हे कुचरे कोनो लास के सहीं,<verse eid="ISA 14:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="ISA 14:20" />तोला ओमन के संग कबर म नइं गाड़े जावय,</para>
  <para style="q1" vid="ISA 14:20">काबरकि तेंह अपन देस ला नास कर दे हवस,</para>
  <para style="q2" vid="ISA 14:20">अऊ अपन मनखेमन ला घात करे हवस।</para>
  <para style="b" vid="ISA 14:20" />
  <para style="b" vid="ISA 14:20" />
  <para style="q1" vid="ISA 14:20">दुस्टमन के संतान के चरचा</para>
  <para style="q2" vid="ISA 14:20">फेर कभू झन करे जावय।<verse eid="ISA 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 14:21" />ओमन के पुरखामन के पाप के कारन</para>
  <para style="q2" vid="ISA 14:21">ओमन के बेटामन ला घात करे बर एक जगह तियार करव;</para>
  <para style="q1" vid="ISA 14:21">अइसन झन होवय कि ओमन उठके देस के ऊपर अधिकार कर लेवंय</para>
  <para style="q2" vid="ISA 14:21">अऊ धरती ला अपन सहरमन ले भर देवंय।<verse eid="ISA 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 14:22" />सर्वसक्तिमान यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="ISA 14:22">“मेंह ओमन के बिरूध ठाढ़ होहूं।</para>
  <para style="q1" vid="ISA 14:22">मेंह बेबिलोन के नांव अऊ ओकर बांचे मनखे,</para>
  <para style="q2" vid="ISA 14:22">ओकर बंस अऊ संतानमन ला मिटा दूहूं।”</para>
  <para style="q2" vid="ISA 14:22">यहोवा ह घोसना करत हे,<verse eid="ISA 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 14:23" />“मेंह ओला उल्लूमन के जगह</para>
  <para style="q2" vid="ISA 14:23">अऊ चीखला ले भरे भुइयां बना दूहूं;</para>
  <para style="q1" vid="ISA 14:23">मेंह ओला सतियानास के बहरी ले बहार दूहूं।”</para>
  <para style="q2" vid="ISA 14:23">सर्वसक्तिमान यहोवा ह घोसना करत हे।<verse eid="ISA 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24" />सर्वसक्तिमान यहोवा ह सपथ खाके कहे हवय,</para>
  <para style="q1" vid="ISA 14:24">“बेसक जइसने मेंह ठाने हंव, वइसने ही होही,</para>
  <para style="q2" vid="ISA 14:24">अऊ जइसने मोर उदेस्य हवय, वइसने ही होही।<verse eid="ISA 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 14:25" />में अस्सूर ला अपन देस म कुटा-कुटा कर दूहूं;</para>
  <para style="q2" vid="ISA 14:25">अपन पहाड़मन ऊपर मेंह ओला कुचर डारहूं।</para>
  <para style="q1" vid="ISA 14:25">ओकर जुड़ा मोर मनखेमन के घेंच ले</para>
  <para style="q2" vid="ISA 14:25">अऊ ओकर बोझा ओमन के खांधा ऊपर ले हटा लिये जाही।”<verse eid="ISA 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 14:26" />येह ओ योजना ए, जऊन ह जम्मो संसार बर ठहिराय गे हवय;</para>
  <para style="q2" vid="ISA 14:26">येह ओ हांथ ए, जऊन ह जम्मो जाति के मनखेमन ऊपर उठे हवय।<verse eid="ISA 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 14:27" />काबरकि सर्वसक्तिमान यहोवा ह योजना बनाय हवय, त कोन ह ओकर बिरोध कर सकथे?</para>
  <para style="q2" vid="ISA 14:27">ओकर हांथ ह बढ़े हवय, अऊ कोन ह ओला रोक सकत हे?<verse eid="ISA 14:27" /></para>
  <para style="s1">पलिस्तीमन के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28" />जऊन बछर आहाज राजा मरिस, ओही बछर ये अगमबानी होईस:<verse eid="ISA 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 14:29" />हे जम्मो पलिस्तीमन, एकर बर आनंदित झन होवव</para>
  <para style="q2" vid="ISA 14:29">कि ओ लउठी ह टूट गीस, जेमा ले तुमन ला मार पड़े रिहिस;</para>
  <para style="q1" vid="ISA 14:29">काबरकि ओ सांप के जरी ले एक करैत सांप ह जनमही,</para>
  <para style="q2" vid="ISA 14:29">अऊ ओकर फर ह एक उड़इया, जहरिला सांप होही।<verse eid="ISA 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 14:30" />तब गरीब ले गरीब मनखे घलो खाय बर पाही,</para>
  <para style="q2" vid="ISA 14:30">अऊ जरूरतमंद ह सुरकछित अराम करही।</para>
  <para style="q1" vid="ISA 14:30">पर तोर बंस ला मेंह अकाल के दुवारा नास कर दूहूं;</para>
  <para style="q2" vid="ISA 14:30">येह तोर बांचे मनखेमन ला मार डारही।<verse eid="ISA 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="ISA 14:31" />हे दुवार, तेंह हाय-हाय कर! हे नगर, तें नरिया!</para>
  <para style="q2" vid="ISA 14:31">हे पलिस्तीमन, तुमन सब के सब पिघल जावव!</para>
  <para style="q1" vid="ISA 14:31">काबरकि उत्तर दिग ले एक धुआं उठत हे,</para>
  <para style="q2" vid="ISA 14:31">अऊ ओकर दल म छितरानेवाला कोनो नइं एं।<verse eid="ISA 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 14:32" />ओ जाति के दूतमन ला</para>
  <para style="q2" vid="ISA 14:32">का जबाब देय जाही?</para>
  <para style="q1" vid="ISA 14:32">“यहोवा ह सियोन ला स्थापित करे हवय,</para>
  <para style="q2" vid="ISA 14:32">अऊ ओमा ओकर दुखी मनखेमन सरन पाहीं।”<verse eid="ISA 14:32" /></para>
  <chapter eid="ISA 14" />
  <chapter number="15" style="c" sid="ISA 15" />
  <para style="s1">मोआब के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1" />मोआब देस के बिरूध एक अगमबानी:</para>
  <para style="q1" vid="ISA 15:1">मोआब के आर नगर ह बरबाद हो गीस,</para>
  <para style="q2" vid="ISA 15:1">एकेच रात म नास हो गीस!</para>
  <para style="q1" vid="ISA 15:1">मोआब के कीर नगर ह बरबाद हो गीस,</para>
  <para style="q2" vid="ISA 15:1">एकेच रात म नास हो गीस!<verse eid="ISA 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 15:2" />दीबोन ह रोए बर ऊपर अपन मंदिर म,</para>
  <para style="q2" vid="ISA 15:2">अपन ऊंचहा जगहमन म जाथे;</para>
  <para style="q2" vid="ISA 15:2">नबो अऊ मेदबा नगर बर मोआब के मनखेमन बिलाप करथें।</para>
  <para style="q1" vid="ISA 15:2">हर एक झन मुड़ मुड़ाय हवंय,</para>
  <para style="q2" vid="ISA 15:2">अऊ हर एक झन दाढ़ी कटाय हवंय।<verse eid="ISA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 15:3" />सड़कमन म ओमन बोरा के ओनहा पहिरे हवंय;</para>
  <para style="q2" vid="ISA 15:3">छत ऊपर अऊ चऊकमन म</para>
  <para style="q1" vid="ISA 15:3">ओमन जम्मो भुइयां म गिरके,</para>
  <para style="q2" vid="ISA 15:3">रोवत बिलाप करत हें।<verse eid="ISA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 15:4" />हेसबोन अऊ एलाले सहर के मनखेमन चिचियावत हें,</para>
  <para style="q2" vid="ISA 15:4">ओमन के अवाज ह यहस नगर तक सुनई देवत हे।</para>
  <para style="q1" vid="ISA 15:4">एकरसेति मोआब के हथियारधारी मनखेमन चिचियावत हें,</para>
  <para style="q2" vid="ISA 15:4">अऊ ओमन के मन बहुंत उदास हवय।<verse eid="ISA 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 15:5" />मोर हिरदय ह मोआब बर बिनती करत हे;</para>
  <para style="q2" vid="ISA 15:5">ओकर सोअर नगर तक भगई,</para>
  <para style="q2" vid="ISA 15:5">ओकर एगलत-सलीसिया नगर तक भगई।</para>
  <para style="q1" vid="ISA 15:5">ओमन ऊपर पहाड़ी म लूहीत नगर करा जाथें,</para>
  <para style="q2" vid="ISA 15:5">ओमन रोवत-रोवत जाथें;</para>
  <para style="q1" vid="ISA 15:5">होरोनैम नगर के रसता म अपन बिनास बर</para>
  <para style="q2" vid="ISA 15:5">ओमन बिलाप करथें।<verse eid="ISA 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 15:6" />निमरीम घाटी के पानी ह सूखा गीस</para>
  <para style="q2" vid="ISA 15:6">अऊ कांदी ह कुम्हला गीस;</para>
  <para style="q1" vid="ISA 15:6">साग-पात, रूख-रई सब खतम हो गीस</para>
  <para style="q2" vid="ISA 15:6">अऊ कोनो हरियाली नइं बांचिस।<verse eid="ISA 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 15:7" />एकर कारन जऊन धन-संपत्ति ओमन बनाय हवंय अऊ संकेले हवंय</para>
  <para style="q2" vid="ISA 15:7">ओला ओमन चिनार रूखमन के घाटी करा ले जावत हें।<verse eid="ISA 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 15:8" />ओमन के रोए के अवाज मोआब के सीमना तक सुनई देवत हे;</para>
  <para style="q2" vid="ISA 15:8">ओमन के सोक मनाय के अवाज एगलैम नगर,</para>
  <para style="q2" vid="ISA 15:8">अऊ ओमन के बिलाप करे के अवाज बेर-एलीम नगर तक सुनई देवत हे।<verse eid="ISA 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 15:9" />काबरकि दीमोन<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="fq" closed="false">दीमोन </char><char style="ft" closed="false">के मतलब सायद </char><char style="fqa" closed="false">दीबोन</char></note> के सोतामन लहू ले भर गे हवंय,</para>
  <para style="q2" vid="ISA 15:9">तभो ले मेंह दीमोन नगर ऊपर अऊ दुख-तकलीफ लानहूं—</para>
  <para style="q1" vid="ISA 15:9">मेंह मोआब के भागे मनखेमन ऊपर</para>
  <para style="q2" vid="ISA 15:9">अऊ ओ देस म बांचे मनखेमन ऊपर एक सिंह भेजहूं।<verse eid="ISA 15:9" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 15" />
  <chapter number="16" style="c" sid="ISA 16" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 16:1" />भेंट के रूप म मेढ़ा-पीलामन ला</para>
  <para style="q2" vid="ISA 16:1">देस के सासन करइया करा भेजव,</para>
  <para style="q1" vid="ISA 16:1">बंजर भुइयां के ओ पार, ओमन ला सेला नगर ले</para>
  <para style="q2" vid="ISA 16:1">बेटी सियोन के पहाड़ ऊपर भेजव।<verse eid="ISA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 16:2" />जइसन डेना फड़फड़ावत चिरई पीला ला उड़े बर खोंधरा ले धकेले जाथे,</para>
  <para style="q2" vid="ISA 16:2">वइसन मोआब के माईलोगनमन के दसा अरनोन नदी के घाट म हो गे हवय।<verse eid="ISA 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 16:3" />मोआब ह कहिथे, “अपन मन ला तियार करव,</para>
  <para style="q2" vid="ISA 16:3">एक निरनय लेवव।</para>
  <para style="q1" vid="ISA 16:3">भरे मंझनियां के बेरा</para>
  <para style="q2" vid="ISA 16:3">अपन-अपन छइहां ला रात सहीं करव।</para>
  <para style="q1" vid="ISA 16:3">घर ले निकाले गय मनखेमन ला छुपा देवव,</para>
  <para style="q2" vid="ISA 16:3">सरन लेवइयामन ला झन पकड़वावव।<verse eid="ISA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 16:4" />भागके आय मोआबीमन ला अपन संग रहन दव;</para>
  <para style="q2" vid="ISA 16:4">नास करइयामन ले ओमन ला बचावव।”</para>
  <para style="b" vid="ISA 16:4" />
  <para style="q1" vid="ISA 16:4">अतियाचार करइया के अन्त हो जाही,</para>
  <para style="q2" vid="ISA 16:4">अऊ बिनास ह रूक जाही;</para>
  <para style="q2" vid="ISA 16:4">देस म अंधेर करइया ह नास हो जाही।<verse eid="ISA 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 16:5" />मया के संग एक सिंघासन ला स्थापित करे जाही;</para>
  <para style="q2" vid="ISA 16:5">अऊ दाऊद के घराना<note caller="+" style="f"><char style="fr" closed="false">16:5 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">तम्बू</char></note> ले एक झन</para>
  <para style="q2" vid="ISA 16:5">बिसवासयोग्यता के संग ओमा बईठही—</para>
  <para style="q1" vid="ISA 16:5">एक अइसन जन, जऊन ह नियाय करत बेरा सच्चई ला देखथे</para>
  <para style="q2" vid="ISA 16:5">अऊ धरमीपन के मामला ला तेजी से निपटाथे।<verse eid="ISA 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 16:6" />हमन मोआब के घमंड के बारे म सुने हवन—</para>
  <para style="q2" vid="ISA 16:6">ओह अति घमंडी अय!—</para>
  <para style="q1" vid="ISA 16:6">ओकर अभिमान अऊ घमंड अऊ ओकर अहंकार;</para>
  <para style="q2" vid="ISA 16:6">पर ओकर डींग मरई ह बेकार अय।<verse eid="ISA 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 16:7" />एकरसेति मोआबीमन बिलाप करथें,</para>
  <para style="q2" vid="ISA 16:7">ओमन एक संग मोआब बर बिलाप करथें।</para>
  <para style="q1" vid="ISA 16:7">कीर-हरेसेत सहर के किसमिस के केक बर</para>
  <para style="q2" vid="ISA 16:7">बिलाप करव अऊ दुख मनावव।<verse eid="ISA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 16:8" />हेसबोन के खेत अऊ सिबमा नगर के</para>
  <para style="q2" vid="ISA 16:8">अंगूर के नारमन मुरझा गे हवंय।</para>
  <para style="q1" vid="ISA 16:8">जाति-जाति के सासन करइयामन</para>
  <para style="q2" vid="ISA 16:8">उत्तम-उत्तम नारमन ला कुचर डारे हवंय,</para>
  <para style="q1" vid="ISA 16:8">ये नारमन एक समय याजेर नगर तक पहुंचत रिहिन</para>
  <para style="q2" vid="ISA 16:8">अऊ मरू-भुइयां कोति बगरत रिहिन।</para>
  <para style="q1" vid="ISA 16:8">ओमन के नार बगरके</para>
  <para style="q2" vid="ISA 16:8">समुंदर<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">संभवतः मिरतू सागर</char></note> तक चले जावत रिहिन।<verse eid="ISA 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 16:9" />एकरसेति सिबमा के अंगूर के नार बर</para>
  <para style="q2" vid="ISA 16:9">मेंह वइसने रोथंव, जइसने याजेर ह रोथे।</para>
  <para style="q1" vid="ISA 16:9">हे हेसबोन अऊ एलाले,</para>
  <para style="q2" vid="ISA 16:9">मेंह तुमन ला अपन आंसू ले भिगो दूहूं!</para>
  <para style="q1" vid="ISA 16:9">तुम्हर पाके फरमन अऊ अनाज के कटई के बेरा, खुसी के</para>
  <para style="q2" vid="ISA 16:9">जऊन ललकार होथे, ओह थम गे हवय।<verse eid="ISA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 16:10" />फरवाले बारीमन ले आनंद अऊ खुसी ला ले लिये गे हवय;</para>
  <para style="q2" vid="ISA 16:10">अंगूर के बारीमन म कोनो न तो गीत गावंय, अऊ न ही खुसी ले चिचियावंय;</para>
  <para style="q1" vid="ISA 16:10">अऊ अंगूर के रसकुंडमन म कोनो अंगूर नइं खुंदय,</para>
  <para style="q2" vid="ISA 16:10">काबरकि मेंह ओमन के खुसी के मारे चिचियाई ला खतम कर दे हंव।<verse eid="ISA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 16:11" />मोर मन ह मोआब बर अऊ मोर अंतर मन ह</para>
  <para style="q2" vid="ISA 16:11">कीर-हरेसेत बर बीना के सहीं बिलाप करत हे।<verse eid="ISA 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 16:12" />जब मोआब ह अपन ऊंचहा जगह म जाथे,</para>
  <para style="q2" vid="ISA 16:12">त ओह सिरिप अपनआप ला थकाय बर जाथे;</para>
  <para style="q1" vid="ISA 16:12">अऊ जब ओह पराथना करे बर अपन देव-स्थल म जाथे,</para>
  <para style="q2" vid="ISA 16:12">त ओला कुछू फायदा नइं होवय।<verse eid="ISA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13" />येह यहोवा के ओ बचन अय, जेला ओह पहिली ले ही मोआब के बारे म कहे रिहिस। <verse eid="ISA 16:13" /><verse number="14" style="v" sid="ISA 16:14" />पर अब यहोवा ह कहिथे: “ठेका म लिये गय एक सेवक के गनती के मुताबिक, तीन बछर के भीतर मोआब के वैभव अऊ ओकर बहुंते मनखेमन तुछ समझे जाहीं, अऊ ओकर बांचे मनखेमन बहुंत कम अऊ कमजोर हो जाहीं।”<verse eid="ISA 16:14" /></para>
  <chapter eid="ISA 16" />
  <chapter number="17" style="c" sid="ISA 17" />
  <para style="s1">दमिस्क के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1" />दमिस्क सहर के बिरूध एक अगमबानी:</para>
  <para style="q1" vid="ISA 17:1">“देखव, दमिस्क फेर एक नगर नइं रहिही</para>
  <para style="q2" vid="ISA 17:1">पर ओह पूरा खंडहर हो जाही।<verse eid="ISA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 17:2" />अरोएर के नगरमन निरजन हो जाहीं</para>
  <para style="q2" vid="ISA 17:2">अऊ पसुमन के चरागन अऊ बईठे के जगह हो जाहीं,</para>
  <para style="q2" vid="ISA 17:2">अऊ ओमन ला डरवइया कोनो नइं होहीं।<verse eid="ISA 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 17:3" />एपरैम के गढ़वाला नगर</para>
  <para style="q2" vid="ISA 17:3">अऊ दमिस्क के राजकीय सक्ति खतम हो जाही;</para>
  <para style="q1" vid="ISA 17:3">अराम के बांचे भाग ह</para>
  <para style="q2" vid="ISA 17:3">इसरायलीमन के महिमा के सहीं हो जाही,”</para>
  <para style="q2" vid="ISA 17:3">सर्वसक्तिमान यहोवा ह घोसना करत हे।<verse eid="ISA 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 17:4" />“ओ दिन याकूब के महिमा ह घट जाही;</para>
  <para style="q2" vid="ISA 17:4">अऊ ओकर मोटहा देहें ह पातर हो जाही।<verse eid="ISA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 17:5" />येह अइसन होही, मानो खड़े फसल ला मनखेमन लुवत हें,</para>
  <para style="q2" vid="ISA 17:5">करपा ला अपन हांथ म संकेलत हें—</para>
  <para style="q1" vid="ISA 17:5">या येह अइसन होही मानो रपाईम के घाटी म</para>
  <para style="q2" vid="ISA 17:5">कोनो सीला बीनत हे।<verse eid="ISA 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 17:6" />तभो ले कुछू सीला ह छूट जाही,</para>
  <para style="q2" vid="ISA 17:6">जइसे जैतून रूख ला झर्रावत समय</para>
  <para style="q1" vid="ISA 17:6">दू तीन ठन फर टीप के डंगाल म छूट जाथें,</para>
  <para style="q2" vid="ISA 17:6">चार पांच ठन, फरवाले डंगाल म रह जाथें,”</para>
  <para style="q2" vid="ISA 17:6">यहोवा, इसरायल के परमेसर ह घोसना करत हे।<verse eid="ISA 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 17:7" />ओ दिन मनखेमन अपन सिरिस्टीकर्ता कोति देखहीं</para>
  <para style="q2" vid="ISA 17:7">अऊ ओमन के आंखी इसरायल के पबितर परमेसर कोति लगे रहिही।<verse eid="ISA 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 17:8" />ओमन अपन हांथ के बनाय</para>
  <para style="q2" vid="ISA 17:8">बेदी ला नइं देखहीं,</para>
  <para style="q1" vid="ISA 17:8">अऊ असेरा के खंभामन<note caller="+" style="f"><char style="fr" closed="false">17:8 </char><char style="ft" closed="false">असेरा देवी के लकड़ी के खंभा</char></note> अऊ अपन बनाय धूप के बेदीमन बर</para>
  <para style="q2" vid="ISA 17:8">ओमन के मन म कोनो आदर नइं होही।<verse eid="ISA 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9" />ओ दिन ओमन के गढ़वाले नगरमन, जेमन ला ओमन इसरायलीमन के डर के मारे छोंड़ देय रिहिन, अइसन होहीं, जइसन झाड़ी-झंखाड़ अऊ घांस-पूस बर जगहमन ला छोंड़े जाथे। ओ जम्मो उजार परे होहीं।<verse eid="ISA 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 17:10" />काबरकि तुमन अपन उद्धारकर्ता परमेसर ला भुला गे हव;</para>
  <para style="q2" vid="ISA 17:10">अऊ अपन चट्टान, अपन गढ़ ला सुरता नइं राखे हव।</para>
  <para style="q1" vid="ISA 17:10">एकरसेति, हालाकि तुमन सुघर पऊधा</para>
  <para style="q2" vid="ISA 17:10">अऊ बाहिर ले मंगाय अंगूर के नारमन ला लगाथव,<verse eid="ISA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 17:11" />हालाकि तुमन ओ पऊधामन ला बढ़ाय बर बाड़ा लगाथव</para>
  <para style="q2" vid="ISA 17:11">अऊ बिहनियां जब तुमन ओमन ला लगाथव अऊ ओमा पीका निकलथे,</para>
  <para style="q1" vid="ISA 17:11">तभो ले बेमारी अऊ असाध्य पीरा के दिन</para>
  <para style="q2" vid="ISA 17:11">ओमा कुछू फसल नइं होही।<verse eid="ISA 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 17:12" />ओ बहुंते जाति के मनखेमन ऊपर हाय, जेमन गरजथें—</para>
  <para style="q2" vid="ISA 17:12">ओमन समुंदर के लहरामन सहीं गरजथें!</para>
  <para style="q1" vid="ISA 17:12">ओ मनखेमन ऊपर हाय, जेमन गरजथें—</para>
  <para style="q2" vid="ISA 17:12">ओमन भयंकर पानी के धारा सहीं गरजथें!<verse eid="ISA 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 17:13" />हालाकि मनखेमन पानी के उमड़त लहरामन सहीं गरजथें,</para>
  <para style="q2" vid="ISA 17:13">पर जब ओह<note caller="+" style="f"><char style="fr" closed="false">17:13 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमेसर</char></note> ओमन ला घुड़कथे, त ओमन अइसे दूरिहा भागथें,</para>
  <para style="q1" vid="ISA 17:13">जइसे पहाड़ ऊपर के भूंसी ह हवा ले</para>
  <para style="q2" vid="ISA 17:13">अऊ गरेर आय ले धुर्रा उड़ियाथे।<verse eid="ISA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 17:14" />सांझ के बेरा, अचानक आतंक!</para>
  <para style="q2" vid="ISA 17:14">बिहान होय के पहिली ओमन लापता हो जाथें!</para>
  <para style="q1" vid="ISA 17:14">येह ओमन के भाग ए जेमन हमन ला लूटथें,</para>
  <para style="q2" vid="ISA 17:14">अऊ हमन ला सताथें, ओमन के ये दसा होही।<verse eid="ISA 17:14" /></para>
  <chapter eid="ISA 17" />
  <chapter number="18" style="c" sid="ISA 18" />
  <para style="s1">कूस के बिरूध एक अगमबानी</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 18:1" />सन-सन करत डेना<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">फांफामन</char></note> के फड़फड़ाहट के ओ देस ऊपर हाय,</para>
  <para style="q2" vid="ISA 18:1">जऊन ह कूस<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="ft" closed="false">नील के ऊपर के इलाका</char></note> के नदीमन के संग-संग फईले हवय,<verse eid="ISA 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 18:2" />अऊ जऊन ह समुंदर के रसता ले</para>
  <para style="q2" vid="ISA 18:2">पानी म नरकट के डोंगामन के दुवारा दूतमन ला ये कहिके पठोथे।</para>
  <para style="b" vid="ISA 18:2" />
  <para style="q1" vid="ISA 18:2">हे तेज चलइया दूतमन,</para>
  <para style="q1" vid="ISA 18:2">ओ मनखेमन करा जावव, जेमन ऊंच अऊ चिकना चमड़ी के अंय,</para>
  <para style="q2" vid="ISA 18:2">जेमन के भय मनखेमन के मन म दूरिहा-दूरिहा तक हवय,</para>
  <para style="q1" vid="ISA 18:2">ओमन अजीब भासा बोलइया एक हमलावर जाति अंय,</para>
  <para style="q2" vid="ISA 18:2">अऊ ओमन के देस ह नदीमन के दुवारा बंटे हवय।<verse eid="ISA 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 18:3" />हे संसार के जम्मो मनखेमन,</para>
  <para style="q2" vid="ISA 18:3">तुमन जेमन धरती म रहिथव,</para>
  <para style="q1" vid="ISA 18:3">जब एक झंडा ह पहाड़ ऊपर खड़े करे जाही,</para>
  <para style="q2" vid="ISA 18:3">त तुमन ओला देखहू,</para>
  <para style="q1" vid="ISA 18:3">अऊ जब तुरही ह फूंके जाही,</para>
  <para style="q2" vid="ISA 18:3">त तुमन ओकर अवाज सुनहू।<verse eid="ISA 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 18:4" />यहोवा ह मोला ये कहत हे:</para>
  <para style="q2" vid="ISA 18:4">“घाम के तेज गरमी अऊ कटनी के गरमी म</para>
  <para style="q1" vid="ISA 18:4">ओस के बादर सहीं</para>
  <para style="q2" vid="ISA 18:4">मेंह चुपचाप रहिहूं अऊ अपन निवास ले देखहूं।”<verse eid="ISA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 18:5" />काबरकि कटनी के पहिले, जब फूलमन खतम हो जाथें</para>
  <para style="q2" vid="ISA 18:5">अऊ फूल ह पके अंगूर बन जाथे,</para>
  <para style="q1" vid="ISA 18:5">तब ओह अंकुरमन ला चाकू ले काट डारही,</para>
  <para style="q2" vid="ISA 18:5">अऊ काटके फईले डालीमन ला अलग कर दीही।<verse eid="ISA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 18:6" />ओमन ला सिकार करइया पहाड़ी चिरईमन बर</para>
  <para style="q2" vid="ISA 18:6">अऊ जंगल के पसुमन बर छोंड़ दिये जाही;</para>
  <para style="q1" vid="ISA 18:6">चिरईमन पूरा घाम के महिना म</para>
  <para style="q2" vid="ISA 18:6">अऊ जंगली पसुमन पूरा जाड़ के महिना म ओमन ला खाहीं।<verse eid="ISA 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 18:7" />ओ समय सर्वसक्तिमान यहोवा बर ओ मनखेमन के दुवारा भेंट लाने जाही</para>
  <para style="q1" vid="ISA 18:7">जेमन ऊंच अऊ चिकना चाम के होहीं,</para>
  <para style="q2" vid="ISA 18:7">जेमन ले पास अऊ दूरिहा के मनखेमन डरथें,</para>
  <para style="q1" vid="ISA 18:7">जेमन अजीब भासा बोलइया हमलावर जाति के होहीं,</para>
  <para style="q2" vid="ISA 18:7">जेमन के देस ह नदीमन के दुवारा बंटे होही—</para>
  <para style="m" vid="ISA 18:7">ओ भेंटमन ला सियोन पहाड़, सर्वसक्तिमान यहोवा के नांव के जगह म लाने जाही।<verse eid="ISA 18:7" /></para>
  <chapter eid="ISA 18" />
  <chapter number="19" style="c" sid="ISA 19" />
  <para style="s1">मिसर के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1" />मिसर के बिरूध अगमबानी:</para>
  <para style="q1" vid="ISA 19:1">देखव, यहोवा तेज उड़इया बादर म चघके</para>
  <para style="q2" vid="ISA 19:1">मिसर म अवइया हवय।</para>
  <para style="q1" vid="ISA 19:1">ओकर आघू म मिसर के मूरतीमन कांपहीं,</para>
  <para style="q2" vid="ISA 19:1">अऊ मिसरीमन के मन ह डर के मारे पिघल जाही।<verse eid="ISA 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 19:2" />“मेंह मिसरीमन ला मिसरीमन के बिरूध भड़काहूं—</para>
  <para style="q2" vid="ISA 19:2">भाई ह भाई के बिरूध लड़ही,</para>
  <para style="q2" vid="ISA 19:2">परोसी ह परोसी के बिरूध,</para>
  <para style="q2" vid="ISA 19:2">नगर ह नगर के बिरूध,</para>
  <para style="q2" vid="ISA 19:2">अऊ राज ह राज के बिरूध लड़ही।<verse eid="ISA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 19:3" />तब मिसरीमन के हिम्मत टूट जाही,</para>
  <para style="q2" vid="ISA 19:3">अऊ मेंह ओमन के उपाय ला बिफल कर दूहूं;</para>
  <para style="q1" vid="ISA 19:3">ओमन अपन मूरतीमन ले अऊ मरे आतमामन ले,</para>
  <para style="q2" vid="ISA 19:3">बईगा अऊ झाड़-फूंक करइयामन ले पुछहीं।<verse eid="ISA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 19:4" />मेंह मिसरीमन ला एक निरदयी</para>
  <para style="q2" vid="ISA 19:4">हाकिम के हांथ म सऊंप दूहूं,</para>
  <para style="q1" vid="ISA 19:4">अऊ एक भयंकर राजा ह ओमन ऊपर सासन करही,”</para>
  <para style="q2" vid="ISA 19:4">परभू, सर्वसक्तिमान यहोवा ह घोसना करत हे।<verse eid="ISA 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 19:5" />तब नदी के पानी सूखा जाही,</para>
  <para style="q2" vid="ISA 19:5">अऊ नदी के तला तक सूखा जाही।<verse eid="ISA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 19:6" />नरवामन ले बदबू आही,</para>
  <para style="q2" vid="ISA 19:6">अऊ मिसर के सोतामन घलो सूखके खाली हो जाहीं।</para>
  <para style="q1" vid="ISA 19:6">नरकट अऊ हरियर चीजमन मुरझा जाहीं,<verse eid="ISA 19:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 19:7" />नील नदी के तीर के पऊधामन घलो,</para>
  <para style="q2" vid="ISA 19:7">नदी के मुंहाटी म जामे पऊधामन सूखके नास हो जाहीं।</para>
  <para style="q1" vid="ISA 19:7">नील नदी के तीर के खेतमन म बोये गय बीजा</para>
  <para style="q2" vid="ISA 19:7">सूखा जाही, ओह उड़िहा जाही अऊ ओकर पता नइं चलही।<verse eid="ISA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 19:8" />ओ जम्मो जेमन नील नदी म गरी खेलथें,</para>
  <para style="q2" vid="ISA 19:8">ओ मछुआरमन रोहीं अऊ बिलाप करहीं;</para>
  <para style="q1" vid="ISA 19:8">जेमन मछरी धरे बर पानी म जाल डालथें</para>
  <para style="q2" vid="ISA 19:8">ओमन सोक मनाहीं।<verse eid="ISA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 19:9" />जेमन सन के सूंत बनाथें, ओमन निरास होहीं,</para>
  <para style="q2" vid="ISA 19:9">सुघर मलमल के ओनहा बुनइयामन के आसा टूट जाही।<verse eid="ISA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 19:10" />ओनहा के धंधा करइयामन उदास होहीं,</para>
  <para style="q2" vid="ISA 19:10">अऊ जम्मो मजदूरमन दुखित हो जाहीं।<verse eid="ISA 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 19:11" />सोअन सहर के हाकिममन तो एकदम मुरूख अंय;</para>
  <para style="q2" vid="ISA 19:11">फिरौन के बुद्धिमान सलाहकारमन के सलाह बिलकुल बेकार अय।</para>
  <para style="q1" vid="ISA 19:11">तें फिरौन ले कइसे कह सकत हस,</para>
  <para style="q1" vid="ISA 19:11">“मेंह एक बुद्धिमान आदमी अंव,</para>
  <para style="q2" vid="ISA 19:11">पुराना जमाना के राजामन के एक चेला अंव”?<verse eid="ISA 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 19:12" />अब तोर बुद्धिमान आदमीमन कहां हवंय?</para>
  <para style="q2" vid="ISA 19:12">सर्वसक्तिमान यहोवा ह</para>
  <para style="q1" vid="ISA 19:12">मिसर देस के बिरूध जऊन योजना बनाय हवय</para>
  <para style="q2" vid="ISA 19:12">ओला ओ बुद्धिमान मनखेमन दिखावंय अऊ तोला बतावंय।<verse eid="ISA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 19:13" />सोअन के हाकिममन मुरूख हो गे हवंय,</para>
  <para style="q2" vid="ISA 19:13">मेमफीस के अगुवामन धोखा खाय हवंय;</para>
  <para style="q1" vid="ISA 19:13">ओकर मनखेमन के मुखियामन</para>
  <para style="q2" vid="ISA 19:13">मिसर ला भरमा दे हवंय।<verse eid="ISA 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 19:14" />यहोवा ह ओमन म</para>
  <para style="q2" vid="ISA 19:14">एक चक्कर देवइया आतमा डार दे हवय;</para>
  <para style="q1" vid="ISA 19:14">ओमन मिसर ला ओकर जम्मो काम म भटका देवत हें,</para>
  <para style="q2" vid="ISA 19:14">जइसे मतवार ह अपन उछरे चीज के चारों कोति डगमगावत रहिथे।<verse eid="ISA 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 19:15" />मिसर ह कुछू नइं कर सकय—</para>
  <para style="q2" vid="ISA 19:15">मुड़ी या पुंछी, खजूर के डंगाली या सरकंडा।<verse eid="ISA 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16" />ओ समय मिसरीमन दुरबल परानी हो जाहीं। सर्वसक्तिमान यहोवा ओमन के बिरूध जऊन हांथ उठाही, ओकर कारन, डर के मारे ओमन कांपे लगहीं। <verse eid="ISA 19:16" /><verse number="17" style="v" sid="ISA 19:17" />अऊ यहूदा के देस ह मिसरीमन ला आतंकित करही; जेकर ले घलो यहूदा के चरचा करे जाही, ओह भयभीत होही, ये सब ओ योजना के कारन होही, जेला सर्वसक्तिमान यहोवा ह मिसरीमन के बिरूध करत हे।<verse eid="ISA 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18" />ओ दन म मिसर देस म पांच सहर होहीं, जेकर मनखेमन कनान देस के भासा बोलहीं अऊ सर्वसक्तिमान यहोवा के भक्ति बर किरिया खाहीं। ओमा से एक ठन सहर के नांव सूरज<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">मासोरेटिक ग्रंथ के जादा हस्तलिपि म </char><char style="fqa" closed="false">बिनास के सहर</char></note> होही।<verse eid="ISA 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19" />ओ दिन म मिसर देस के बीच म यहोवा बर एक बेदी होही, अऊ ओकर सीमना म यहोवा बर एक स्मारक होही। <verse eid="ISA 19:19" /><verse number="20" style="v" sid="ISA 19:20" />मिसर देस म येह यहोवा बर एक चिनहां अऊ गवाही होही। अपन ऊपर अंधेर करइयामन के कारन, जब ओमन यहोवा ला पुकारहीं, तब ओह ओमन बर एक उद्धारकर्ता अऊ ओमन के रकछा करइया ला भेजही, अऊ ओह ओमन ला छोंड़ाही। <verse eid="ISA 19:20" /><verse number="21" style="v" sid="ISA 19:21" />ये किसम ले यहोवा अपनआप ला मिसरीमन ऊपर परगट करही, अऊ ओ दिन ओमन यहोवा ला चिनहीं। ओमन बलिदान अऊ अन्न-बलिदान चघाके ओकर उपासना करहीं; ओमन यहोवा बर मन्रत रखहीं अऊ ओला पूरा घलो करहीं। <verse eid="ISA 19:21" /><verse number="22" style="v" sid="ISA 19:22" />यहोवा ह मिसर देस ऊपर एक महामारी लानही; ओह ओमन ला मारही अऊ ओमन ला चंगा घलो करही। ओमन यहोवा कोति फिरहीं, अऊ ओह ओमन के बिनती सुनके ओमन ला चंगा करही।<verse eid="ISA 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23" />ओ दिन म मिसर ले अस्सूर तक एक राजमार्ग होही। अस्सूरीमन मिसर देस जाहीं अऊ मिसरीमन अस्सूर देस जाहीं। अऊ मिसरीमन अस्सूरीमन के संग मिलके अराधना करहीं। <verse eid="ISA 19:23" /><verse number="24" style="v" sid="ISA 19:24" />ओ दिन म धरती ऊपर इसरायल ह तीसरा देस होही, जेकर नांव मिसर अऊ अस्सूर के संग आसीसित देस के रूप म लिये जाही। <verse eid="ISA 19:24" /><verse number="25" style="v" sid="ISA 19:25" />सर्वसक्तिमान यहोवा ह ये कहिके ओमन ला आसीस दीही, “धइन होवंय मिसर म मोर मनखेमन, मोर हांथ के बनाय अस्सूर अऊ मोर उत्तराधिकार इसरायल।”<verse eid="ISA 19:25" /></para>
  <chapter eid="ISA 19" />
  <chapter number="20" style="c" sid="ISA 20" />
  <para style="s1">मिसर अऊ कूस के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1" />जऊन बछर अस्सूर के राजा सरगोन अपन परधान सेनापति ला भेजिस अऊ ओह असदोद म आके ओकर ऊपर हमला करिस अऊ असदोद ला अपन अधिकार म ले लीस— <verse eid="ISA 20:1" /><verse number="2" style="v" sid="ISA 20:2" />ओही बछर यहोवा ह आमोस के बेटा यसायाह के दुवारा कहिस, “जा अऊ अपन कनिहां ले टाट के ओनहा ला उतार अऊ अपन गोड़ ले जूता ला उतार।” अऊ ओह वइसने ही करिस, ओह नंगरा अऊ खाली गोड़ घुमे-फिरे लगिस।<verse eid="ISA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3" />तब यहोवा ह कहिस, “जइसन मोर दास यसायाह ह तीन बछर ले नंगरा होके खाली गोड़ रेंगत रिहिस, कि मिसर अऊ कूस बर एक चिनहां अऊ अपसकुन होवय, <verse eid="ISA 20:3" /><verse number="4" style="v" sid="ISA 20:4" />वइसन अस्सूर के राजा ह मिसर अऊ कूस के मनखेमन ला कैदी बनाके देस निकाला करही; का जवान का सियान, सबो ला कैदी बनाके नंगरा अऊ खाली गोड़ अऊ कुल्हा खुल्ला करके कैद म ले जाही, ताकि मिसर के बेजत्ती होवय। <verse eid="ISA 20:4" /><verse number="5" style="v" sid="ISA 20:5" />जेमन कूस ऊपर भरोसा करिन अऊ मिसर ऊपर घमंड करिन, ओमन भयभीत होहीं अऊ ओमन के बेजत्ती होही। <verse eid="ISA 20:5" /><verse number="6" style="v" sid="ISA 20:6" />ओ दिन म ये समुंदर तीर म रहइया मनखेमन कहिहीं, ‘देखव, जेमन ऊपर हमन भरोसा करत रहेंन अऊ जेमन करा हमन मदद बर अऊ अस्सूर के राजा ले बांचे बर भागके गेंन, ओमन के का होय हवय! त फेर हमन कइसे बच सकत हन?’ ”<verse eid="ISA 20:6" /></para>
  <chapter eid="ISA 20" />
  <chapter number="21" style="c" sid="ISA 21" />
  <para style="s1">बेबिलोन के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1" />समुंदर तीर के मरू-भुइयां के बिरूध अगमबानी:</para>
  <para style="q1" vid="ISA 21:1">जइसन दक्खिन के भुइयां ले आंधी आथे,</para>
  <para style="q2" vid="ISA 21:1">वइसन ही मरू-भुइयां ले,</para>
  <para style="q2" vid="ISA 21:1">आतंक के देस ले एक हमला करइया आवत हवय।<verse eid="ISA 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 21:2" />एक भयानक दरसन मोला देखाय गीस:</para>
  <para style="q2" vid="ISA 21:2">बिसवासघाती ह बिसवासघात करथे अऊ लूटनेवाला ह लूटथे।</para>
  <para style="q1" vid="ISA 21:2">हे एलाम, हमला कर! हे मादै, घेराबंदी कर!</para>
  <para style="q2" vid="ISA 21:2">मेंह ओ सब कराहना ला खतम कर दूहूं, जऊन ह ओकर कारन आय हवय।<verse eid="ISA 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 21:3" />एकर कारन मोर देहें म भारी पीरा हे,</para>
  <para style="q2" vid="ISA 21:3">छेवारी होवत माईलोगन के पीरा सहीं मोला पीरा होवत हे;</para>
  <para style="q1" vid="ISA 21:3">जऊन बात मेंह सुनत हंव, ओकर ले मेंह डर गे हंव,</para>
  <para style="q2" vid="ISA 21:3">जऊन चीज ला मेंह देखत हंव, ओकर ले घबरा गे हंव।<verse eid="ISA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 21:4" />मोर हिरदय ह कांपत हे,</para>
  <para style="q2" vid="ISA 21:4">डर के मारे मेंह कांपत हंव;</para>
  <para style="q1" vid="ISA 21:4">जऊन संझा के मेंह रसता देखत रहेंव</para>
  <para style="q2" vid="ISA 21:4">ओह मोर बर आतंक के बात हो गे हवय।<verse eid="ISA 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 21:5" />जेवन के तियारी होवत हे,</para>
  <para style="q2" vid="ISA 21:5">ओमन ओनहा बिछावत हें,</para>
  <para style="q2" vid="ISA 21:5">ओमन खावथें, ओमन पीयथें!</para>
  <para style="q1" vid="ISA 21:5">हे हाकिममन, उठव,</para>
  <para style="q2" vid="ISA 21:5">ढालमन म तेल लगावव!<verse eid="ISA 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 21:6" />परभू ह मोला ये कहत हे:</para>
  <para style="q1" vid="ISA 21:6">“जाके एक पहरेदार ठहिरा दे</para>
  <para style="q2" vid="ISA 21:6">अऊ जऊन कुछू ओह देखथे, ओला आके बतावय।<verse eid="ISA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 21:7" />जब ओह रथमन ला</para>
  <para style="q2" vid="ISA 21:7">घोड़ामन के दल के संग देखथे,</para>
  <para style="q1" vid="ISA 21:7">जब ओह गदहामन के सवार</para>
  <para style="q2" vid="ISA 21:7">या ऊंटमन के सवारमन ला देखथे,</para>
  <para style="q1" vid="ISA 21:7">त ओह सावधान हो जावय,</para>
  <para style="q2" vid="ISA 21:7">पूरा सावधान हो जावय।”<verse eid="ISA 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 21:8" />अऊ ओ पहरेदार<note caller="+" style="f"><char style="fr" closed="false">21:8 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">सिंह</char></note> ह चिचियाके कहिस,</para>
  <para style="q1" vid="ISA 21:8">“हे मालिक, हर दिन मेंह ठाढ़ होके पहरा देथंव;</para>
  <para style="q2" vid="ISA 21:8">हर रात मेंह पहरा म काटथंव।<verse eid="ISA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 21:9" />देखव, एक आदमी एक रथ म</para>
  <para style="q2" vid="ISA 21:9">घोड़ामन के एक दल के संग आवथे।</para>
  <para style="q1" vid="ISA 21:9">अऊ ओह जबाब देथे:</para>
  <para style="q2" vid="ISA 21:9">‘गिर परिस, बेबिलोन गिर परिस!</para>
  <para style="q1" vid="ISA 21:9">येकर देवतामन के जम्मो मूरतीमन</para>
  <para style="q2" vid="ISA 21:9">गिरके भुइयां म चकनाचूर हो गीन।’ ”<verse eid="ISA 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 21:10" />कोठार म कुचरे गय हे मोर मनखेमन,</para>
  <para style="q2" vid="ISA 21:10">जऊन बात मेंह सर्वसक्तिमान यहोवा,</para>
  <para style="q1" vid="ISA 21:10">इसरायल के परमेसर ले सुने हंव,</para>
  <para style="q2" vid="ISA 21:10">ओला मेंह तुमन ला बतात हंव।<verse eid="ISA 21:10" /></para>
  <para style="s1">एदोम के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11" />दूमा<note caller="+" style="f"><char style="fr" closed="false">21:11 </char><char style="fq" closed="false">दूमा </char><char style="ft" closed="false">येह </char><char style="fqa" closed="false">एदोम </char><char style="ft" closed="false">के दूसर नांव, जेकर मतलब होथे चुपचाप</char></note> के बिरूध अगमबानी:</para>
  <para style="q1" vid="ISA 21:11">सेईर म ले कोनो मोला बलावत हवय,</para>
  <para style="q2" vid="ISA 21:11">“हे चौकीदार, रथिया के का खबर हे?</para>
  <para style="q2" vid="ISA 21:11">हे चौकीदार, रथिया के का खबर हे?”<verse eid="ISA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 21:12" />चौकीदार ह कहिस,</para>
  <para style="q2" vid="ISA 21:12">“बिहान पहाथे, पर रथिया घलो होथे।</para>
  <para style="q1" vid="ISA 21:12">यदि तेंह पुछे चाहत हस, त पुछ;</para>
  <para style="q2" vid="ISA 21:12">अऊ फेर लहुंटके आ।”<verse eid="ISA 21:12" /></para>
  <para style="s1">अरब के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13" />अरब के बिरूध अगमबानी:</para>
  <para style="q1" vid="ISA 21:13">हे ददानीमन के रसता रेंगइया दलमन,</para>
  <para style="q2" vid="ISA 21:13">जेमन अरब के झाड़ीमन म डेरा डालथव,<verse eid="ISA 21:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 21:14" />पीयासन करा पानी लानव;</para>
  <para style="q1" vid="ISA 21:14">तुमन, जेमन तेमा नगर म रहिथव,</para>
  <para style="q2" vid="ISA 21:14">भगोड़ामन बर जेवन लेके आवव।<verse eid="ISA 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 21:15" />ओमन तलवार के डर ले भागत हें,</para>
  <para style="q2" vid="ISA 21:15">मियान ले खींचे तलवार ले,</para>
  <para style="q1" vid="ISA 21:15">ताने गय धनुस ले</para>
  <para style="q2" vid="ISA 21:15">अऊ भारी लड़ई ले भागत हवंय।<verse eid="ISA 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16" />परभू ह मोला ये कहत हे: “जइसे ठेका म बंधे बनिहार ह येला गनथे, एकेच बछर के भीतर, केदार गोत्र के जम्मो सोभा खतम हो जाही। <verse eid="ISA 21:16" /><verse number="17" style="v" sid="ISA 21:17" />केदार के धनुसधारी, सूरबीरमन ले थोरकन ही रह जाहीं।” यहोवा, इसरायल के परमेसर ह कहे हवय।<verse eid="ISA 21:17" /></para>
  <chapter eid="ISA 21" />
  <chapter number="22" style="c" sid="ISA 22" />
  <para style="s1">यरूसलेम के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1" />दरसन के घाटी<note caller="+" style="f"><char style="fr" closed="false">22:1 </char><char style="ft" closed="false">संभवतः </char><char style="fqa" closed="false">यरूसलेम</char></note> के बिरूध अगमबानी:</para>
  <para style="q1" vid="ISA 22:1">तुम्हर अब का समस्या हे</para>
  <para style="q2" vid="ISA 22:1">कि तुमन जम्मो के जम्मो छानी ऊपर चढ़ गे हव,<verse eid="ISA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 22:2" />हे हाहाकार अऊ उधम ले भरे नगर,</para>
  <para style="q2" vid="ISA 22:2">हे कोलाहल अऊ उपदरव के सहर?</para>
  <para style="q1" vid="ISA 22:2">तुम्हर मारे गय मनखेमन तलवार ले नइं मारे गे हवंय,</para>
  <para style="q2" vid="ISA 22:2">न ही ओमन लड़ई म मारे गे हवंय।<verse eid="ISA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 22:3" />तुम्हर जम्मो अगुवामन एक संग भाग गे हवंय;</para>
  <para style="q2" vid="ISA 22:3">बिगर धनुस के उपयोग करे ही ओमन ला बंदी बना लिये गे हवय।</para>
  <para style="q1" vid="ISA 22:3">ओ जम्मो जेमन पकड़े गीन, ओमन ला एक संग बंदी बना लिये गीस,</para>
  <para style="q2" vid="ISA 22:3">जबकि ओमन के भागत बेरा बईरी ह दूरिहा म रिहिस।<verse eid="ISA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 22:4" />एकरसेति मेंह कहेंव, “मोर ले मुहूं फेर लव;</para>
  <para style="q2" vid="ISA 22:4">मोला फूट-फूटके रोवन दव।</para>
  <para style="q1" vid="ISA 22:4">मोर मनखेमन के बिनास ऊपर</para>
  <para style="q2" vid="ISA 22:4">मोला सांति देय के कोसिस झन करव।”<verse eid="ISA 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 22:5" />काबरकि परभू, सर्वसक्तिमान यहोवा के एक दिन हवय,</para>
  <para style="q2" vid="ISA 22:5">जब दरसन के घाटी म हाहाकार</para>
  <para style="q2" vid="ISA 22:5">अऊ रऊंदई अऊ आतंक होही,</para>
  <para style="q1" vid="ISA 22:5">दीवारमन ला टोरके गिराय जाही</para>
  <para style="q2" vid="ISA 22:5">अऊ पहाड़मन करा रोये जाही।<verse eid="ISA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 22:6" />एलाम ह अपन सारथी अऊ घोड़ामन के संग</para>
  <para style="q2" vid="ISA 22:6">तरकस ला लेथे;</para>
  <para style="q2" vid="ISA 22:6">कीर सहर ह ढाल ला खोलथे।<verse eid="ISA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 22:7" />तोर मनपसंद घाटीमन रथमन ले भरे हवंय,</para>
  <para style="q2" vid="ISA 22:7">अऊ घुड़सवारमन सहर के दुवारमन म ठहिराय गे हवंय।<verse eid="ISA 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 22:8" />परभू ह यहूदा के सुरकछा ला हटा दीस,</para>
  <para style="q2" vid="ISA 22:8">अऊ ओ दिन तेंह जंगल के महल के</para>
  <para style="q2" vid="ISA 22:8">हथियारमन ला देखे।<verse eid="ISA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 22:9" />तेंह देखे कि दाऊद के सहर के दीवारमन</para>
  <para style="q2" vid="ISA 22:9">बहुंत जगह टूट गे रिहिन;</para>
  <para style="q1" vid="ISA 22:9">तेंह खाल्हे के पोखरी म</para>
  <para style="q2" vid="ISA 22:9">पानी ला इकट्ठा करे।<verse eid="ISA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 22:10" />तेंह यरूसलेम म भवनमन के गनती करे</para>
  <para style="q2" vid="ISA 22:10">अऊ दीवार ला मजबूत करे बर घरमन ला टोरके गिरा देय।<verse eid="ISA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 22:11" />जुन्ना पोखरी के पानी बर</para>
  <para style="q2" vid="ISA 22:11">तेंह दू ठन दीवार के बीच एक बांध बनवाय,</para>
  <para style="q1" vid="ISA 22:11">पर तें ओकर ऊपर धियान नइं देय, जऊन ह येला बनाईस,</para>
  <para style="q2" vid="ISA 22:11">या ओकर आदर नइं करे, जऊन ह बहुंत पहिले येकर योजना बनाय रिहिस।<verse eid="ISA 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 22:12" />परभू, सर्वसक्तिमान यहोवा ह</para>
  <para style="q2" vid="ISA 22:12">ओ दिन तोला रोये अऊ बिलाप करे बर,</para>
  <para style="q1" vid="ISA 22:12">अपन बाल नोचे बर</para>
  <para style="q2" vid="ISA 22:12">अऊ बोरा के ओनहा पहिरे बर बलाईस।<verse eid="ISA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 22:13" />पर देख, उहां आनंद अऊ खुसी मनाय जावत हे,</para>
  <para style="q2" vid="ISA 22:13">गरूवा-बईलामन ला काटे अऊ भेड़-बकरी के बध करे जावत हे,</para>
  <para style="q2" vid="ISA 22:13">मांस खाय अऊ अंगूर के मंद पीये जावत हे!</para>
  <para style="q1" vid="ISA 22:13">तेंह कहिथस, “आवव, हमन खावन अऊ पीयन,</para>
  <para style="q2" vid="ISA 22:13">काबरकि कल तो हमन ला मरना हे!”<verse eid="ISA 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 22:14" />सर्वसक्तिमान यहोवा ह मोर सुनत म ये परगट करे हवय: “तुम्हर मिरतू के दिन तक ये पाप ह छेमा नइं करे जावय,” परभू, सर्वसक्तिमान यहोवा ह कहत हे।<verse eid="ISA 22:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15" />परभू सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 22:15">“जावव, ये परबंधक,</para>
  <para style="q2" vid="ISA 22:15">महल के अधिकारी सेबना ला कहव:<verse eid="ISA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 22:16" />तेंह इहां का करत हस अऊ तोला कोन ह अनुमति दीस</para>
  <para style="q2" vid="ISA 22:16">कि तेंह इहां अपन बर एक कबर खनवात हस,</para>
  <para style="q1" vid="ISA 22:16">ऊंचहा जगह म अपन कबर बनवात हस</para>
  <para style="q2" vid="ISA 22:16">अऊ चट्टान ला काटके अपन अराम के जगह ला बनवात हस?<verse eid="ISA 22:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 22:17" />“हे बलवान मनखे, सावधान रह,</para>
  <para style="q2" vid="ISA 22:17">यहोवा तोला जोर से धरके दूरिहा फेंकनेचवाला हे।<verse eid="ISA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 22:18" />ओह तोला गेंद कस बने करके लपेटही</para>
  <para style="q2" vid="ISA 22:18">अऊ एक बड़े देस म फेंक दीही।</para>
  <para style="q1" vid="ISA 22:18">उहां तें मर जाबे</para>
  <para style="q2" vid="ISA 22:18">अऊ जऊन रथमन ऊपर तोला बहुंत घमंड रिहिस</para>
  <para style="li2" vid="ISA 22:18">उहां ओ रथमन तोर मालिक के घर बर एक कलंक हो जाहीं।<verse eid="ISA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 22:19" />मेंह तोला तोर जगह ले हटा दूहूं,</para>
  <para style="q2" vid="ISA 22:19">अऊ तोला तोर पद ले निकाल दिये जाही।<verse eid="ISA 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 22:20" />“ओ दिन मेंह हिलकियाह के बेटा अपन दास, एलयाकीम ला बुलवाहूं। <verse eid="ISA 22:20" /><verse number="21" style="v" sid="ISA 22:21" />मेंह ओला तोर अंगरखा पहिराहूं अऊ ओकर कनिहां म तोर कटिबंध ला बांधहूं अऊ तोर अधिकार ओकर हांथ म कर दूहूं। ओह यरूसलेम म रहइया अऊ यहूदा के मनखेमन बर एक ददा के सहीं ठहिरही। <verse eid="ISA 22:21" /><verse number="22" style="v" sid="ISA 22:22" />में दाऊद के घराना के कुची ओकर कंधा म मढ़ाहूं; ओह जेला खोलही, ओला कोनो बंद नइं कर सकहीं, अऊ जेला ओह बंद करही, ओला कोनो खोल नइं सकहीं। <verse eid="ISA 22:22" /><verse number="23" style="v" sid="ISA 22:23" />में ओला ठोस जगह म खूंटी सहीं गड़ियाहूं; ओह अपन ददा के घराना बर आदर के एक आसन<note caller="+" style="f"><char style="fr" closed="false">22:23 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सिंघासन</char></note> बन जाही। <verse eid="ISA 22:23" /><verse number="24" style="v" sid="ISA 22:24" />ओकर परिवार के पूरा महिमा ओकर ऊपर होही: येकर बंस अऊ संतानमन—येकर जम्मो छोटे-छोटे बरतन, कटोरामन ले लेके जम्मो सुराहीमन ओकर ऊपर टंगाहीं।<verse eid="ISA 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 22:25" />“ओ दिन म,” सर्वसक्तिमान यहोवा ह घोसना करत हे, “जऊन खूंटी ला ठोस जगह म गड़ियाय गे रिहिस, ओह ढीला हो जाही; येला काटके गिरा दिये जाही, अऊ ओकर ऊपर टंगे बोझा ला काटके गिरा दिये जाही।” यहोवा ह कहे हवय।<verse eid="ISA 22:25" /></para>
  <chapter eid="ISA 22" />
  <chapter number="23" style="c" sid="ISA 23" />
  <para style="s1">सूर के बिरूध अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1" />सूर सहर के बिरूध म अगमबानी:</para>
  <para style="q1" vid="ISA 23:1">हे तरसीस के जहाजमन, बिलाप करव!</para>
  <para style="q2" vid="ISA 23:1">काबरकि सूर ह नास हो गीस</para>
  <para style="q2" vid="ISA 23:1">उहां न तो कोनो घर अऊ न ही कोनो बंदरगाह हवय।</para>
  <para style="q1" vid="ISA 23:1">ये खबर ओमन ला</para>
  <para style="q2" vid="ISA 23:1">कित्तीमन के देस ले मिले हवय।<verse eid="ISA 23:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 23:2" />हे समुंदर के टापू म रहइयामन</para>
  <para style="q2" vid="ISA 23:2">अऊ सीदोनी बेपारीमन,</para>
  <para style="q2" vid="ISA 23:2">जेमन ला नाविकमन धनी कर दे हवंय, चुप रहव।<verse eid="ISA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 23:3" />महासागर ले होके</para>
  <para style="q2" vid="ISA 23:3">सीहोर<note caller="+" style="f"><char style="fr" closed="false">23:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मिसर देस</char></note> के अनाज आईस;</para>
  <para style="q1" vid="ISA 23:3">नील नदी के ऊपज ह सूर के आमदनी रिहिस,</para>
  <para style="q2" vid="ISA 23:3">अऊ ओह जाति-जाति के मनखेमन के बेपार के जगह हो गीस।<verse eid="ISA 23:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 23:4" />हे सीदोन, सरम कर, अऊ तें समुंदर के किला,</para>
  <para style="q2" vid="ISA 23:4">काबरकि समुंदर ह कहे हवय:</para>
  <para style="q1" vid="ISA 23:4">“न तो मोला कभू छेवारी के पीरा होईस अऊ न ही मेंह कोनो लइका जनमांय;</para>
  <para style="q2" vid="ISA 23:4">मेंह न तो बेटामन ला पालें-पोसें अऊ न ही बेटीमन ला पोसके बड़े करेंव।”<verse eid="ISA 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 23:5" />जब खबर ह मिसर देस म आही,</para>
  <para style="q2" vid="ISA 23:5">त सूर ले आय खबर ला सुनके ओमन ला पीरा होही।<verse eid="ISA 23:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 23:6" />तुमन पार होके तरसीस म जावव;</para>
  <para style="q2" vid="ISA 23:6">हे टापू म रहइयामन, बिलाप करव।<verse eid="ISA 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 23:7" />का येह खुसी ले भरे तुम्हर सहर अय,</para>
  <para style="q2" vid="ISA 23:7">पुराना, पुराना सहर,</para>
  <para style="q1" vid="ISA 23:7">जेकर गोड़मन ओला</para>
  <para style="q2" vid="ISA 23:7">दूरिहा देस म बसे बर ले गे हवंय?<verse eid="ISA 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 23:8" />सूर के बिरूध कोन ह ये योजना बनाईस,</para>
  <para style="q2" vid="ISA 23:8">जऊन ह राजामन ला गद्दी म बईठावय,</para>
  <para style="q1" vid="ISA 23:8">जेकर बेपारीमन हाकिम रिहिन,</para>
  <para style="q2" vid="ISA 23:8">जेकर साहूकारमन धरती म नामी मनखे रिहिन?<verse eid="ISA 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 23:9" />सर्वसक्तिमान यहोवा ह येकर योजना बनाईस,</para>
  <para style="q2" vid="ISA 23:9">ताकि ओकर सब गौरव के घमंड ला टोर देय</para>
  <para style="q2" vid="ISA 23:9">अऊ धरती के जम्मो नामी मनखेमन ला नम्र करे।<verse eid="ISA 23:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 23:10" />हे बेटी तरसीस,</para>
  <para style="q2" vid="ISA 23:10">जइसे ओमन नील नदी के संग करथें, वइसे अपन देस म होके जा,</para>
  <para style="q2" vid="ISA 23:10">काबरकि तोर मेर अऊ कोनो बंदरगाह नइं ए।<verse eid="ISA 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 23:11" />यहोवा ह अपन हांथ ला समुंदर ऊपर बढ़ाय हवय</para>
  <para style="q2" vid="ISA 23:11">राजमन ला हला दे हवय।</para>
  <para style="q1" vid="ISA 23:11">यहोवा ह फीनीके<note caller="+" style="f"><char style="fr" closed="false">23:11 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कनान</char></note> के बारे म आदेस दे हवय</para>
  <para style="q2" vid="ISA 23:11">कि ओकर किलामन ला नास करे जावय।<verse eid="ISA 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 23:12" />यहोवा ह कहिस, “हे कुंवारी बेटी सीदोन, अब तें कुचरे गे हस!</para>
  <para style="q2" vid="ISA 23:12">तेंह अब खुस नइं हो सकस;</para>
  <para style="b" vid="ISA 23:12" />
  <para style="q1" vid="ISA 23:12">“उठ, पार नाहकके कित्तीमन के देस<note caller="+" style="f"><char style="fr" closed="false">23:12 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">साइप्रस</char></note> म जा;</para>
  <para style="q2" vid="ISA 23:12">पर उहां घलो तोला चैन नइं मिलय।”<verse eid="ISA 23:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 23:13" />बेबिलोनीमन<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> के देस ला देखव,</para>
  <para style="q2" vid="ISA 23:13">ये मनखेमन के अब लेखा-जोखा नइं ए!</para>
  <para style="q1" vid="ISA 23:13">अस्सूर के मनखेमन येला</para>
  <para style="q2" vid="ISA 23:13">मरू-भुइयां के पसुमन के एक जगह बना दे हवंय;</para>
  <para style="q1" vid="ISA 23:13">ओमन अपन घेराबंदी के किला बनाय हवंय,</para>
  <para style="q2" vid="ISA 23:13">ओमन येकर किलामन ला लूट ले हवंय</para>
  <para style="q2" vid="ISA 23:13">अऊ येला खंडहर कर दे हवंय।<verse eid="ISA 23:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 23:14" />हे तरसीस के पानी जहाजमन, बिलाप करव;</para>
  <para style="q2" vid="ISA 23:14">तुम्हर गढ़ ह नास हो गे हवय!<verse eid="ISA 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15" />ओ समय सूर ला सत्तर बछर तक भुला दिये जाही, जऊन ह एक राजा के पूरा जिनगी के समय होथे। पर सत्तर बछर के बीते के बाद, येह सूर के संग होही, जइसे कि बेस्या के गीत हवय:<verse eid="ISA 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 23:16" />“हे बिसरा दिये गय बेस्या,</para>
  <para style="q2" vid="ISA 23:16">एक ठन बीना लेके सहर म घुम;</para>
  <para style="q1" vid="ISA 23:16">बने करके बीना ला बजा, बहुंत गीत गा,</para>
  <para style="q2" vid="ISA 23:16">ताकि तोला सुरता करे जावय।”<verse eid="ISA 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17" />सत्तर बछर बीते के बाद, यहोवा ह सूर ऊपर धियान दीही। ओह फेर अपन छिनारी के कमई म मन लगाके धरती भर के सब राजमन के संग अपन धंधा करही। <verse eid="ISA 23:17" /><verse number="18" style="v" sid="ISA 23:18" />तभो ले ओकर लाभ अऊ ओकर कमई यहोवा बर अलग रखे जाही; ओला न तो भंडार म रखे जाही, न ही जमा करे जाही। ओकर आमदनी ह ओमन करा जाही, जेमन यहोवा के आघू म रहिथें, ताकि ओमन ला भरपूर जेवन अऊ सुघर ओनहा मिलय।<verse eid="ISA 23:18" /></para>
  <chapter eid="ISA 23" />
  <chapter number="24" style="c" sid="ISA 24" />
  <para style="s1">धरती म परभू के दंड</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 24:1" />देखव, यहोवा ह धरती ला निरजन</para>
  <para style="q2" vid="ISA 24:1">अऊ नास करइया हवय;</para>
  <para style="q1" vid="ISA 24:1">ओह येकर सतह ला बरबाद कर दीही</para>
  <para style="q2" vid="ISA 24:1">अऊ येमा निवास करइयामन ला तितिर-बितिर कर दीही—<verse eid="ISA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 24:2" />जइसन मनखेमन के,</para>
  <para style="q2" vid="ISA 24:2">वइसन पुरोहित के दसा होही,</para>
  <para style="q2" vid="ISA 24:2">जइसन दास के, वइसन मालिक के,</para>
  <para style="q2" vid="ISA 24:2">जइसन दासी के, वइसन मालकिन के,</para>
  <para style="q2" vid="ISA 24:2">जइसन बिसोइया के, वइसन बेचइया के,</para>
  <para style="q2" vid="ISA 24:2">जइसन उधार देवइया के, वइसन उधार लेवइया के,</para>
  <para style="q2" vid="ISA 24:2">जइसन करजा देवइया के, वइसन करजा लेवइया के दसा होही।<verse eid="ISA 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 24:3" />धरती ह पूरा सुनसान पड़े होही</para>
  <para style="q2" vid="ISA 24:3">अऊ पूरा लूट लेय जाही।</para>
  <para style="q1" vid="ISA 24:3">काबरकि यहोवा ह ये बचन कहे हवय।<verse eid="ISA 24:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 24:4" />धरती सूख जाथे अऊ मुरझा जाथे,</para>
  <para style="q2" vid="ISA 24:4">संसार ह दुरबल हो जाथे अऊ अइला जाथे,</para>
  <para style="q2" vid="ISA 24:4">अकासमन घलो धरती के संग दुरबल हो जाथें।<verse eid="ISA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 24:5" />धरती अपन मनखेमन के दुवारा असुध हो जाथे;</para>
  <para style="q2" vid="ISA 24:5">काबरकि ओमन परमेसर के कानून</para>
  <para style="q1" vid="ISA 24:5">अऊ बिधिमन ला नइं माने हवंय</para>
  <para style="q2" vid="ISA 24:5">अऊ परमेसर के सदाकाल के करार ला टोर देय हवंय।<verse eid="ISA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 24:6" />येकर कारन धरती ऊपर एक सराप पड़ही;</para>
  <para style="q2" vid="ISA 24:6">अऊ येमा रहइयामन अपन दोस के फर भोगहीं।</para>
  <para style="q1" vid="ISA 24:6">एकरसेति धरती के रहइयामन ला जलाय जाथे,</para>
  <para style="q2" vid="ISA 24:6">अऊ बहुंत कम झन बांचे हवंय।<verse eid="ISA 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 24:7" />नवां अंगूर के मंद सूखा जाथे अऊ अंगूर के नार मुरझा जाथे;</para>
  <para style="q2" vid="ISA 24:7">जम्मो आनंद मनइयामन कराहथें।<verse eid="ISA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 24:8" />आनंद के डफली के अवाज ह बंद हो गीस,</para>
  <para style="q2" vid="ISA 24:8">खुसी मनाय के कोलाहल ह बंद हो गे हवय,</para>
  <para style="q2" vid="ISA 24:8">आनंदित बीना के अवाज सांत हो गे हवय।<verse eid="ISA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 24:9" />ओमन गीत गावत फेर अंगूर के मंद नइं पीयंय;</para>
  <para style="q2" vid="ISA 24:9">मंद ह येकर पीनेवालामन बर करू हो गे हवय।<verse eid="ISA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 24:10" />उजरे सहर ह निरजन परे हवय;</para>
  <para style="q2" vid="ISA 24:10">हर घर के कपाट ह बंद हो गे हवय।<verse eid="ISA 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 24:11" />गलीमन म मनखेमन अंगूर के मंद बर हल्ला करत हें;</para>
  <para style="q2" vid="ISA 24:11">जम्मो खुसी ह दुख म बदल जावत हे,</para>
  <para style="q2" vid="ISA 24:11">धरती म जम्मो आनंद के अवाज ह खतम हो गे हवय।<verse eid="ISA 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 24:12" />सहर ह उजाड़ पड़े हे,</para>
  <para style="q2" vid="ISA 24:12">येकर दुवार ला टोरके कुटा-कुटा कर दे गे हवय।<verse eid="ISA 24:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 24:13" />जइसने जब जैतून रूख ला झारे जाथे,</para>
  <para style="q2" vid="ISA 24:13">या जब अंगूर टोरे के बाद घलो कुछू अंगूरमन नार म बच जाथें,</para>
  <para style="q1" vid="ISA 24:13">वइसने ही येह धरती ऊपर</para>
  <para style="q2" vid="ISA 24:13">अऊ जाति-जाति के मनखेमन के बीच होही।<verse eid="ISA 24:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 24:14" />ओमन ऊंचहा अवाज म आनंद के मारे जय-जयकार करहीं;</para>
  <para style="q2" vid="ISA 24:14">पछिम कोति ले ओमन यहोवा के महानता के जय-जयकार करहीं।<verse eid="ISA 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 24:15" />एकर कारन पूरब म यहोवा के महिमा करव;</para>
  <para style="q2" vid="ISA 24:15">समुंदर के द्वीपमन म</para>
  <para style="q2" vid="ISA 24:15">यहोवा, इसरायल के परमेसर के नांव ला ऊंचहा करव।<verse eid="ISA 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 24:16" />धरती के छोर ले हमन ला अइसन गीत के अवाज सुनई देवत हे:</para>
  <para style="q2" vid="ISA 24:16">“धरमी जन के महिमा होवय।”</para>
  <para style="b" vid="ISA 24:16" />
  <para style="q1" vid="ISA 24:16">पर मेंह कहेंव, “मेंह बेकार हो गेंव, मेंह बेकार हो गेंव!</para>
  <para style="q2" vid="ISA 24:16">मोर ऊपर हाय!</para>
  <para style="q1" vid="ISA 24:16">बिसवासघाती धोखा!</para>
  <para style="q2" vid="ISA 24:16">बिसवासघात के संग बिसवासघाती धोखा!”<verse eid="ISA 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 24:17" />हे धरती के मनखेमन,</para>
  <para style="q2" vid="ISA 24:17">तुम्हर बर आतंक अऊ खंचवा अऊ फांदा हवय।<verse eid="ISA 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 24:18" />जऊन ह घलो आतंक के अवाज ले भागही</para>
  <para style="q2" vid="ISA 24:18">ओह खंचवा म गिरही;</para>
  <para style="q1" vid="ISA 24:18">जऊन ह खंचवा म ले निकलही</para>
  <para style="q2" vid="ISA 24:18">ओह फांदा म फंसही।</para>
  <para style="b" vid="ISA 24:18" />
  <para style="q1" vid="ISA 24:18">काबरकि अकास के झरोखामन खुल गे हवंय,</para>
  <para style="q2" vid="ISA 24:18">अऊ धरती के नीवमन डोलत हें।<verse eid="ISA 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 24:19" />धरती ह टूट गे हवय,</para>
  <para style="q2" vid="ISA 24:19">धरती ह टूटके अलग हो गे हवय,</para>
  <para style="q2" vid="ISA 24:19">धरती ह बहुंत डोलत हे।<verse eid="ISA 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 24:20" />धरती ह मतवार सहीं लड़खड़ाथे,</para>
  <para style="q2" vid="ISA 24:20">येह हवा म एक झोपड़ी के सहीं डोलथे;</para>
  <para style="q1" vid="ISA 24:20">येकर बिदरोह के दोस ह येकर ऊपर बहुंत भारी हवय</para>
  <para style="q2" vid="ISA 24:20">कि येह गिरथे, अऊ फेर कभू नइं उठय।<verse eid="ISA 24:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 24:21" />ओ दिन यहोवा ह</para>
  <para style="q2" vid="ISA 24:21">ऊपर अकास के सक्ति</para>
  <para style="q2" vid="ISA 24:21">अऊ खाल्हे धरती के राजामन ला दंड दीही।<verse eid="ISA 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 24:22" />एक काल-कोठरी म बांधे गय कैदीमन सहीं</para>
  <para style="q2" vid="ISA 24:22">ओमन ला एक संग संकेले जाही;</para>
  <para style="q1" vid="ISA 24:22">ओमन ला जेल म बंद कर दिये जाही</para>
  <para style="q2" vid="ISA 24:22">अऊ बहुंत दिन के बाद ओमन ला दंड दिये जाही।<note caller="+" style="f"><char style="fr" closed="false">24:22 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">छोंड़ दिये जाही</char></note><verse eid="ISA 24:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 24:23" />चंदा ला डराय जाही,</para>
  <para style="q2" vid="ISA 24:23">अऊ सूरज ह लज्जित होही;</para>
  <para style="q1" vid="ISA 24:23">काबरकि सर्वसक्तिमान यहोवा ह</para>
  <para style="q2" vid="ISA 24:23">सियोन पहाड़ ऊपर अऊ यरूसलेम म,</para>
  <para style="q2" vid="ISA 24:23">अऊ येकर अगुवामन के आघू म बड़े महिमा के संग राज करही।<verse eid="ISA 24:23" /></para>
  <chapter eid="ISA 24" />
  <chapter number="25" style="c" sid="ISA 25" />
  <para style="s1">परमेसर बर इस्तुति गीत</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 25:1" />हे यहोवा, तें मोर परमेसर अस;</para>
  <para style="q2" vid="ISA 25:1">मेंह तोर महिमा करत तोला ऊपर उठाहूं अऊ तोर नांव के परसंसा करहूं,</para>
  <para style="q1" vid="ISA 25:1">काबरकि पूरा बिसवासयोग्यता म</para>
  <para style="q2" vid="ISA 25:1">तेंह अद्भूत काम करे हस,</para>
  <para style="q2" vid="ISA 25:1">ओ काम जेकर योजना बहुंत पहिले बनाय गे रिहिस।<verse eid="ISA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 25:2" />तेंह सहर ला कचरा के एक ढेर बना दे हस,</para>
  <para style="q2" vid="ISA 25:2">गढ़वाले नगर ला खंडहर बना दे हस,</para>
  <para style="q1" vid="ISA 25:2">परदेसीमन के मजबूत गढ़वाला सहर अब नइं ए;</para>
  <para style="q2" vid="ISA 25:2">येला फेर कभू बसाय नइं जावय।<verse eid="ISA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 25:3" />एकरसेति बलवान मनखेमन तोर आदर करहीं;</para>
  <para style="q2" vid="ISA 25:3">निरदयी जातिमन के नगरमन तोर आदर करहीं।<verse eid="ISA 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 25:4" />तेंह गरीबमन बर एक सरन-स्थान,</para>
  <para style="q2" vid="ISA 25:4">जरूरतमंद बर ओमन के बिपत्ति म एक सरन-स्थान,</para>
  <para style="q1" vid="ISA 25:4">आंधी म एक आसरय,</para>
  <para style="q2" vid="ISA 25:4">अऊ घाम म एक छइहां के जगह रहे हस।</para>
  <para style="q1" vid="ISA 25:4">काबरकि निरदयी के सांस ह</para>
  <para style="q2" vid="ISA 25:4">दीवार म टकरावत एक आंधी के सहीं<verse eid="ISA 25:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="ISA 25:5" />अऊ मरू-भुइयां के गरमी सहीं अय।</para>
  <para style="q1" vid="ISA 25:5">तेंह परदेसीमन के कोलाहल ला वइसने सांत करथस;</para>
  <para style="q2" vid="ISA 25:5">जइसने बादर के छइहां के दुवारा गरमी ह सांत होथे,</para>
  <para style="q2" vid="ISA 25:5">ओही किसम ले निरदयी के गीत ह सांत हो जाथे।<verse eid="ISA 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 25:6" />ये पहाड़ ऊपर सर्वसक्तिमान यहोवा ह</para>
  <para style="q2" vid="ISA 25:6">जम्मो मनखेमन बर बढ़िया जेवन के एक भोज तियार करही,</para>
  <para style="q1" vid="ISA 25:6">पुराना अंगूर के मंद के एक जेवनार—</para>
  <para style="q2" vid="ISA 25:6">सबले बढ़िया मांस अऊ सबले बढ़िया अंगूर के मंद होही।<verse eid="ISA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 25:7" />ये पहाड़ ऊपर, ओह ओ परदा ला नास करही</para>
  <para style="q2" vid="ISA 25:7">जऊन ह जम्मो मनखेमन ला लपेटके रखथे,</para>
  <para style="q1" vid="ISA 25:7">ओ चादर, जऊन ह सब जातिमन ला ढांपे हवय;<verse eid="ISA 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="ISA 25:8" />ओह मऊत ला हमेसा बर नास कर दीही।</para>
  <para style="q1" vid="ISA 25:8">परमपरधान यहोवा ह सबो के चेहरा ले</para>
  <para style="q2" vid="ISA 25:8">आंसू ला पोंछ दीही;</para>
  <para style="q1" vid="ISA 25:8">ओह पूरा धरती ले</para>
  <para style="q2" vid="ISA 25:8">अपन मनखेमन के कलंक ला हटा दीही।</para>
  <para style="q1" vid="ISA 25:8">यहोवा ह कहे हवय।<verse eid="ISA 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9" />ओ दिन ओमन कहिहीं,</para>
  <para style="q1" vid="ISA 25:9">“खचित येह हमर परमेसर अय;</para>
  <para style="q2" vid="ISA 25:9">हमन ओकर ऊपर भरोसा करेंन, अऊ ओह हमर उद्धार करिस।</para>
  <para style="q1" vid="ISA 25:9">येह यहोवा अय, हमन ओकर भरोसा करे हवन;</para>
  <para style="q2" vid="ISA 25:9">आवव, हमन ओकर उद्धार म आनंद अऊ खुसी मनावन।”<verse eid="ISA 25:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 25:10" />यहोवा के हांथ ह ये पहाड़ ऊपर बने रहिही;</para>
  <para style="q2" vid="ISA 25:10">पर मोआब ह ओमन के देस म अइसन रऊंदे जाही</para>
  <para style="q2" vid="ISA 25:10">जइसन पैंरा ह खातू म रऊंदे जाथे।<verse eid="ISA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 25:11" />ओमन<note caller="+" style="f"><char style="fr" closed="false">25:11 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मोआबीमन</char></note> येमा अपन हांथ अइसन फईलाहीं,</para>
  <para style="q2" vid="ISA 25:11">जइसन तउंरइयामन तउंरे बर अपन हांथ फईलाथें।</para>
  <para style="q1" vid="ISA 25:11">पर ओमन के हांथ के चतुरई के बावजूद</para>
  <para style="q2" vid="ISA 25:11">परमेसर ह ओमन के घमंड ला टोर दीही।<verse eid="ISA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 25:12" />ओह तुम्हर ऊंच गढ़वाले दीवारमन ला खाल्हे ले आही</para>
  <para style="q2" vid="ISA 25:12">अऊ खाल्हे गिरा दीही;</para>
  <para style="q1" vid="ISA 25:12">ओह ओमन ला भुइयां म ले आही,</para>
  <para style="q2" vid="ISA 25:12">अऊ माटी म मिला दीही।<verse eid="ISA 25:12" /></para>
  <chapter eid="ISA 25" />
  <chapter number="26" style="c" sid="ISA 26" />
  <para style="s1">इस्तुति के एक गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1" />ओ दिन<note caller="+" style="f"><char style="fr" closed="false">26:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मोआब के बिनास के दिन</char></note> यहूदा देस म ये गीत गाय जाही:</para>
  <para style="q1" vid="ISA 26:1">हमर एक ठन मजबूत सहर हवय;</para>
  <para style="q2" vid="ISA 26:1">परमेसर उद्धार ला बनाथे</para>
  <para style="q2" vid="ISA 26:1">येकर दीवार अऊ गढ़ के घेरामन ला बनाथे।<verse eid="ISA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2" />सहर के दुवारमन ला खोलव</para>
  <para style="q2" vid="ISA 26:2">ताकि धरमी जाति ह भीतर आवय,</para>
  <para style="q2" vid="ISA 26:2">ओ जाति जऊन ह बिसवास ला बनाय रखथे।<verse eid="ISA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3" />जेमन के मन ह तोर बर अटल बने रहिथे,</para>
  <para style="q2" vid="ISA 26:3">ओमन ला तें पूरा सांति म रखथस,</para>
  <para style="q2" vid="ISA 26:3">काबरकि ओमन तोर ऊपर भरोसा करथें।<verse eid="ISA 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4" />यहोवा ऊपर हमेसा बर भरोसा रखव,</para>
  <para style="q2" vid="ISA 26:4">काबरकि यहोवा, यहोवा खुद सदाकाल के चट्टान अय।<verse eid="ISA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5" />ओह ओमन ला नम्र करथे, जेमन डींग मारथें,</para>
  <para style="q2" vid="ISA 26:5">ओह ऊंच सहर ला खाल्हे ले आथे;</para>
  <para style="q1" vid="ISA 26:5">ओह येला भुइयां म समतल कर देथे</para>
  <para style="q2" vid="ISA 26:5">अऊ येला धुर्रा म मिला देथे।<verse eid="ISA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6" />गोड़मन येला कुचर देथें—</para>
  <para style="q2" vid="ISA 26:6">सताय गय मनखेमन के गोड़मन,</para>
  <para style="q2" vid="ISA 26:6">गरीबमन के गोड़मन येला कुचर देथें।<verse eid="ISA 26:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7" />धरमी के डहार ह समतल होथे;</para>
  <para style="q2" vid="ISA 26:7">तें, धरमी जन अस अऊ धरमी के डहार ला सरल बनाथस।<verse eid="ISA 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8" />हे यहोवा, हव, तोर कानून के रसता म चलत,</para>
  <para style="q2" vid="ISA 26:8">हमन तोर बाट जोहत हन;</para>
  <para style="q1" vid="ISA 26:8">तोर नांव अऊ खियाती के</para>
  <para style="q2" vid="ISA 26:8">हमर मन ह लालसा करथे।<verse eid="ISA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9" />रथिया मोर परान ह तोर लालसा करथे;</para>
  <para style="q2" vid="ISA 26:9">बिहनियां मोर मन ह तोर लालसा करथे।</para>
  <para style="q1" vid="ISA 26:9">जब तोर नियाय के काम धरती ऊपर होथे,</para>
  <para style="q2" vid="ISA 26:9">तब संसार के मनखेमन, धरमीपन सीखथें।<verse eid="ISA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10" />पर जब दुस्ट ऊपर दया घलो करे जाथे,</para>
  <para style="q2" vid="ISA 26:10">तभो ले ओह धरमीपन के बात ला नइं सीखय;</para>
  <para style="q1" vid="ISA 26:10">सीधवा मनखेमन के देस म घलो ओमन दुस्टता करते रहिथें</para>
  <para style="q2" vid="ISA 26:10">अऊ यहोवा के महानता के आदर नइं करंय।<verse eid="ISA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11" />हे यहोवा तोर हांथ ह उठे हवय,</para>
  <para style="q2" vid="ISA 26:11">पर ओमन येला नइं देखंय।</para>
  <para style="q1" vid="ISA 26:11">ओमन तोर मनखेमन बर तोर उत्साह ला देखंय अऊ लज्जित होवंय;</para>
  <para style="q2" vid="ISA 26:11">तोर बईरीमन बर रखे आगी ह ओमन ला भसम कर देवय।<verse eid="ISA 26:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12" />हे यहोवा, तें हमर बर सांति लानथस;</para>
  <para style="q2" vid="ISA 26:12">हमर करा जऊन कुछू घलो हवय, ओला तेंह हमर बर करे हवस।<verse eid="ISA 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13" />हे यहोवा हमर परमेसर, तोर अलावा अऊ मालिकमन हमर ऊपर सासन करे हवंय,</para>
  <para style="q2" vid="ISA 26:13">पर सिरिप तोरेच नांव ला हमन आदर देथन।<verse eid="ISA 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14" />ओमन मर गीन, ओमन अब जीयत नइं एं;</para>
  <para style="q2" vid="ISA 26:14">ओमन के आतमा जी नइं उठय</para>
  <para style="q1" vid="ISA 26:14">तेंह ओमन ला दंड देय अऊ ओमन ला नास कर देय;</para>
  <para style="q2" vid="ISA 26:14">तें ओमन के सुरता ला घलो मेटा देय।<verse eid="ISA 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15" />हे यहोवा, तेंह जाति<note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यहूदी जाति</char></note> ला बढ़ाय हस;</para>
  <para style="q2" vid="ISA 26:15">तेंह जाति ला बढ़ाय हस।</para>
  <para style="q1" vid="ISA 26:15">तेंह अपन बर महिमा देखाय हस;</para>
  <para style="q2" vid="ISA 26:15">तेंह देस के सब सीमना ला बढ़ाय हस।<verse eid="ISA 26:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16" />हे यहोवा, दुख म ओमन तोला सुरता करिन;</para>
  <para style="q2" vid="ISA 26:16">जब तें ओमन के ताड़ना करे,</para>
  <para style="q2" vid="ISA 26:16">तब ओमन मुसकिल से फुसफुसाके पराथना कर सकत रिहिन।<verse eid="ISA 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17" />जइसन गरभवती माईलोगन ह लइका जनमावत बेरा</para>
  <para style="q2" vid="ISA 26:17">पीरा म छटपटाथे अऊ चिचियाथे,</para>
  <para style="q2" vid="ISA 26:17">हे यहोवा, हमर स्थिति घलो तोर आघू म वइसन हो गे रिहिस।<verse eid="ISA 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18" />हमन गरभवती रहेंन, हमन पीरा म छटपटायेंन,</para>
  <para style="q2" vid="ISA 26:18">पर हमन मानो हवा ला ही जनमेंन।</para>
  <para style="q1" vid="ISA 26:18">हमन धरती बर कोनो उद्धार के काम नइं करेंन,</para>
  <para style="q2" vid="ISA 26:18">अऊ न ही संसार के मनखेमन जिनगी पाईन।<verse eid="ISA 26:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19" />पर हे यहोवा, तोर मरे मनखेमन जी जाहीं;</para>
  <para style="q2" vid="ISA 26:19">ओमन के देहेंमन उठके ठाढ़ होहीं—</para>
  <para style="q1" vid="ISA 26:19">जेमन माटी म निवास करथें,</para>
  <para style="q2" vid="ISA 26:19">ओमन जागंय अऊ आनंद के मारे जय-जयकार करंय—</para>
  <para style="q1" vid="ISA 26:19">तोर ओस ह बिहनियां के ओस सहीं अय;</para>
  <para style="q2" vid="ISA 26:19">धरती ह अपन मुरदामन ला लहुंटा दीही।<verse eid="ISA 26:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 26:20" />हे मोर मनखेमन, जावव, अपन खोलीमन म जावव</para>
  <para style="q2" vid="ISA 26:20">अऊ कपाटमन ला बंद कर लेवव;</para>
  <para style="q1" vid="ISA 26:20">थोरकन देर बर अपनआप ला छुपाके रखव</para>
  <para style="q2" vid="ISA 26:20">जब तक कि गुस्सा ह सांत नइं हो जावय।<verse eid="ISA 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 26:21" />देखव, यहोवा ह अपन निवास ले बाहिर निकलत हे</para>
  <para style="q2" vid="ISA 26:21">ताकि धरती के मनखेमन ला ओमन के पाप के दंड देवय।</para>
  <para style="q1" vid="ISA 26:21">धरती ह अपन ऊपर बहे खून ला परगट कर दीही;</para>
  <para style="q2" vid="ISA 26:21">धरती ह घात करे गय मनखेमन ला अऊ छुपाके नइं रखही।<verse eid="ISA 26:21" /></para>
  <chapter eid="ISA 26" />
  <chapter number="27" style="c" sid="ISA 27" />
  <para style="s1">इसरायल के छुटकारा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1" />ओ दिन,<note caller="+" style="f"><char style="fr" closed="false">27:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">दंड के ओ दिन</char></note></para>
  <para style="q1" vid="ISA 27:1">यहोवा ह अपन तलवार ले—</para>
  <para style="q2" vid="ISA 27:1">अपन भयंकर, बड़े अऊ मजबूत तलवार ले—</para>
  <para style="q1" vid="ISA 27:1">लिबयातान नांव के टेड़गा रेंगइया सांप,</para>
  <para style="q2" vid="ISA 27:1">लिबयातान नांव के कुंडली मरइया सांप ला दंड दीही;</para>
  <para style="q1" vid="ISA 27:1">ओह समुंदर के बड़े अऊ बिकराल जन्तु ला मार डारही।<verse eid="ISA 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 27:2" />ओ दिन—</para>
  <para style="q1" vid="ISA 27:2">“फर देवइया एक अंगूर के बारी के बारे म गीत गाहू:<verse eid="ISA 27:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 27:3" />में, यहोवा ह येकर रकछा करथंव;</para>
  <para style="q2" vid="ISA 27:3">मेंह लगातार येमा पानी पलोथंव।</para>
  <para style="q1" vid="ISA 27:3">मेंह रात-दिन येकर पहरेदारी करथंव,</para>
  <para style="q2" vid="ISA 27:3">ताकि कोनो येकर हानि झन करंय।<verse eid="ISA 27:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 27:4" />मेंह गुस्सा नइं करत हंव।</para>
  <para style="q1" vid="ISA 27:4">यदि मोर आघू म उहां सिरिप झाड़ी अऊ कांटामन होतिन!</para>
  <para style="q2" vid="ISA 27:4">त मेंह ओमन के बिरूध लड़े बर आघू बढ़तेंव;</para>
  <para style="q2" vid="ISA 27:4">मेंह ओ जम्मो म आगी लगा देतेंव।<verse eid="ISA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 27:5" />या फेर ओमन मोर मेर सरन लेय बर आवंय;</para>
  <para style="q2" vid="ISA 27:5">ओमन मोर संग म मेल-मिलाप कर लेवंय,</para>
  <para style="q2" vid="ISA 27:5">हव, ओमन मोर संग मेल-मिलाप कर लेवंय।”<verse eid="ISA 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 27:6" />अवइया दिनमन म याकूब ह जरी धरही,</para>
  <para style="q2" vid="ISA 27:6">इसरायल ह बढ़ही अऊ ओमा फूल धरही</para>
  <para style="q2" vid="ISA 27:6">अऊ पूरा संसार ला फर ले भर दीही।<verse eid="ISA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 27:7" />का यहोवा ह ओला वइसने मारिस</para>
  <para style="q2" vid="ISA 27:7">जइसने ओह ओमन ला मारिस, जेमन ओला मारिन?</para>
  <para style="q1" vid="ISA 27:7">का ओह वइसने मार डारे गीस</para>
  <para style="q2" vid="ISA 27:7">जइसने ओमन मार डारे गीन, जेमन ओला मार डारिन?<verse eid="ISA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 27:8" />लड़ई अऊ बंधुवई के दुवारा तें ओकर संग लड़—</para>
  <para style="q2" vid="ISA 27:8">अपन भयंकर आंधी ले ओह ओला भगा देथे।</para>
  <para style="q2" vid="ISA 27:8">जइसे एक दिन पुरवाही हवा चलथे।<verse eid="ISA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 27:9" />तब एकर दुवारा, याकूब के अधरम के पछताप करे जाही,</para>
  <para style="q2" vid="ISA 27:9">अऊ ओकर पाप दूर होय के फर ये होही:</para>
  <para style="q1" vid="ISA 27:9">जब ओह बेदी के जम्मो पथरामन ला</para>
  <para style="q2" vid="ISA 27:9">चूना के पथरा सहीं कुचरके कुटा-कुटा कर देथे,</para>
  <para style="q1" vid="ISA 27:9">तब कोनो असेरा के खंभा<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">असेरा देवी के लकड़ी के खंभा</char></note> या धूप के बेदी ला</para>
  <para style="q2" vid="ISA 27:9">सही-सलामत नइं छोंड़े जाही।<verse eid="ISA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 27:10" />काबरकि गढ़वाला नगर निरजन हो गे हवय,</para>
  <para style="q2" vid="ISA 27:10">एक छोंड़े गय बस्ती ला निरजन जगह सहीं तियाग दिये गे हवय;</para>
  <para style="q1" vid="ISA 27:10">उहां बछवामन चरथें,</para>
  <para style="q2" vid="ISA 27:10">उहां ओमन बईठथें;</para>
  <para style="q2" vid="ISA 27:10">अऊ येकर डंगालीमन ला खाके ठुठवा कर देथें।<verse eid="ISA 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 27:11" />जब येकर छोटे डंगालीमन सूख जाथें, त ओमन टूट जाथें</para>
  <para style="q2" vid="ISA 27:11">अऊ माईलोगनमन आके ओमन ला जला देथें।</para>
  <para style="q1" vid="ISA 27:11">काबरकि येमन बिगर समझवाले मनखे अंय;</para>
  <para style="q2" vid="ISA 27:11">एकरसेति ओमन के बनानेवाला ओमन ऊपर दया नइं करय,</para>
  <para style="q2" vid="ISA 27:11">अऊ ओमन के सिरिस्टी करइया ह ओमन ऊपर किरपा नइं करय।<verse eid="ISA 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12" />ओ दिन यहोवा ह फरात नदी ले लेके मिसर के नरवा तक अपन अनाज ला पछिनही, अऊ हे इसरायलीमन, तुमन एक-एक करके इकट्ठा करे जाहू। <verse eid="ISA 27:12" /><verse number="13" style="v" sid="ISA 27:13" />अऊ ओ दिन एक बड़े तुरही फूंके जाही। जेमन अस्सूर देस म नास होवत रिहिन अऊ जेमन मिसर देस म बंधुवई म रिहिन, ओमन आहीं अऊ यरूसलेम म पबितर पहाड़ ऊपर यहोवा के अराधना करहीं।<verse eid="ISA 27:13" /></para>
  <chapter eid="ISA 27" />
  <chapter number="28" style="c" sid="ISA 28" />
  <para style="s1">एपरैम अऊ यहूदा के अगुवामन ऊपर हाय</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 28:1" />ओ मुकुट ऊपर हाय, जऊन ह एपरैम के मतवारमन के घमंड अय,</para>
  <para style="q2" vid="ISA 28:1">ओ मुरझावत फूल ऊपर हाय, ओकर महिमामय सुघरता,</para>
  <para style="q1" vid="ISA 28:1">जऊन ह एक उपजाऊ घाटी के टीप म रखे हवय—</para>
  <para style="q2" vid="ISA 28:1">ओ सहर ऊपर हाय, जेकर घमंड ला अंगूर के मंद के दुवारा खतम करे गे हवय!<verse eid="ISA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 28:2" />देखव, परभू करा एक झन हवय, जऊन ह बलवान अऊ मजबूत हे।</para>
  <para style="q2" vid="ISA 28:2">करा के आंधी या नास करइया गरेर के सहीं,</para>
  <para style="q1" vid="ISA 28:2">तेज बारिस अऊ मूसलाधार बारिस के सहीं,</para>
  <para style="q2" vid="ISA 28:2">ओह येला बहुंत जोर से भुइयां म फटिक दीही।<verse eid="ISA 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 28:3" />एपरैम के मतवारमन के घमंड के ओ मुकुट ला</para>
  <para style="q2" vid="ISA 28:3">गोड़ खाल्हे रऊंदे जाही।<verse eid="ISA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 28:4" />ओ मुरझावत फूल, ओकर महिमामय सुघरता,</para>
  <para style="q2" vid="ISA 28:4">जऊन ह एक उपजाऊ घाटी के टीप म रखे हवय,</para>
  <para style="q1" vid="ISA 28:4">ओह कटनी के पहिले पाके अंजीर के सहीं होही—</para>
  <para style="q2" vid="ISA 28:4">जेमन ला मनखेमन देखते ही अपन हांथ म लेथें,</para>
  <para style="q2" vid="ISA 28:4">अऊ ओमन ला लील जाथें।<verse eid="ISA 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 28:5" />ओ दिन सर्वसक्तिमान यहोवा ह</para>
  <para style="q2" vid="ISA 28:5">एक महिमामय मुकुट होही,</para>
  <para style="q1" vid="ISA 28:5">अपन बांचे मनखेमन बर</para>
  <para style="q2" vid="ISA 28:5">एक सुघर मुकुट ठहिरही।<verse eid="ISA 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 28:6" />ओह ओकर बर नियाय के एक आतमा होही</para>
  <para style="q2" vid="ISA 28:6">जऊन ह नियाय के आसन म बईठथे,</para>
  <para style="q1" vid="ISA 28:6">ओह ओमन बर ताकत के मूल होही</para>
  <para style="q2" vid="ISA 28:6">जेमन बईरीमन ला वापिस दुवार कोति ढकेल देथें।<verse eid="ISA 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 28:7" />अऊ येमन घलो अंगूर के मंद पीके डगमगाथें</para>
  <para style="q2" vid="ISA 28:7">अऊ मंद ले लड़खड़ाथें:</para>
  <para style="q1" vid="ISA 28:7">पुरोहित अऊ अगमजानीमन मंद पीके डगमगाथें</para>
  <para style="q2" vid="ISA 28:7">अऊ अंगूर के मंद पीके गिर जाथें;</para>
  <para style="q1" vid="ISA 28:7">ओमन मंद पीके लड़खड़ाथें,</para>
  <para style="q2" vid="ISA 28:7">ओमन डगमगाथें, जब ओमन दरसन देखथें,</para>
  <para style="q2" vid="ISA 28:7">ओमन लड़खड़ाथें, जब ओमन फैसला सुनाथें।<verse eid="ISA 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 28:8" />जम्मो मेजमन उल्टी ले भरे हवंय</para>
  <para style="q2" vid="ISA 28:8">अऊ अइसे कोनो जगह नइं बांचे हवय, जिहां गंदगी नइं ए।<verse eid="ISA 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 28:9" />“येह कोन ए, जेला ओह सिखाय के कोसिस करत हे?</para>
  <para style="q2" vid="ISA 28:9">कोन ला ओह अपन संदेस के अर्थ समझावत हे?</para>
  <para style="q1" vid="ISA 28:9">का ओ लइकामन ला, जेमन के दूध छोंड़ाय गे हवय,</para>
  <para style="q2" vid="ISA 28:9">का ओमन, जेमन ला अभी-अभी दाई के थन ले अलग करे गे हवय?<verse eid="ISA 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 28:10" />काबरकि येह अय:</para>
  <para style="q2" vid="ISA 28:10">येला करव, ओला करव,</para>
  <para style="q2" vid="ISA 28:10">एक नियम येकर बर, एक नियम ओकर बर;</para>
  <para style="q2" vid="ISA 28:10">थोरकन इहां, थोरकन उहां।”<verse eid="ISA 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 28:11" />तब बहुंत अछा, परदेसी भासा अऊ अनजान बोली के संग</para>
  <para style="q2" vid="ISA 28:11">परमेसर ह ये मनखेमन ले गोठियाही,<verse eid="ISA 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 28:12" />जऊन मन ला ओह कहिस,</para>
  <para style="q2" vid="ISA 28:12">“येह अराम करे के जगह अय, थके मनखेमन अराम करंय”;</para>
  <para style="q1" vid="ISA 28:12">अऊ, “येह अराम करे के जगह अय”—</para>
  <para style="q2" vid="ISA 28:12">पर ओमन सुने नइं चाहिन।<verse eid="ISA 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 28:13" />एकरसेति, यहोवा के बचन ह ओमन बर बन जाही:</para>
  <para style="q2" vid="ISA 28:13">येला करव, ओला करव,</para>
  <para style="q2" vid="ISA 28:13">एक नियम येकर बर, एक नियम ओकर बर;</para>
  <para style="q2" vid="ISA 28:13">थोरकन इहां, थोरकन उहां—</para>
  <para style="q1" vid="ISA 28:13">ताकि जब ओमन जावंय, त ओमन पाछू के भार गिरंय;</para>
  <para style="q2" vid="ISA 28:13">अऊ घायल हो जावंय अऊ फांदा म फंसके पकड़े जावंय।<verse eid="ISA 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 28:14" />येकर कारन, हे ठट्ठा करइयामन,</para>
  <para style="q2" vid="ISA 28:14">जेमन यरूसलेम म ये मनखेमन ऊपर सासन करथव, यहोवा के बचन ला सुनव।<verse eid="ISA 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 28:15" />तुमन ये डींग मारथव, “हमन मऊत के संग करार करे हन,</para>
  <para style="q2" vid="ISA 28:15">मिरतू-लोक के संग हमन एक समझौता करे हन।</para>
  <para style="q1" vid="ISA 28:15">एकर कारन जब बिपत्ति बाढ़ सहीं आथे,</para>
  <para style="q2" vid="ISA 28:15">त येह हमन ला छू नइं सकय,</para>
  <para style="q1" vid="ISA 28:15">काबरकि हमन झूठ के सरन लेय हवन</para>
  <para style="q2" vid="ISA 28:15">अऊ लबारी<note caller="+" style="f"><char style="fr" closed="false">28:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">लबरा देवतामन</char></note> के आड़ म लुकाय हवन।”<verse eid="ISA 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 28:16" />एकरसेति परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 28:16">“देखव, मेंह सियोन म एक ठन पथरा, एक परखे पथरा,</para>
  <para style="q2" vid="ISA 28:16">एक ठन कीमती कोना के पथरा, एक मजबूत नीव बर रखे हंव;</para>
  <para style="q1" vid="ISA 28:16">अऊ जऊन कोनो येकर ऊपर बिसवास करही</para>
  <para style="q2" vid="ISA 28:16">ओह कभू आतंकित नइं होही।<verse eid="ISA 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 28:17" />मेंह नियाय ला नापे के डोरी</para>
  <para style="q2" vid="ISA 28:17">अऊ धरमीपन ला साहुल ठहिराहूं;</para>
  <para style="q1" vid="ISA 28:17">करा ह तुम्हर झूठ के सरन-स्थान ला बोहाके ले जाही,</para>
  <para style="q2" vid="ISA 28:17">अऊ तुम्हर लुकाय के जगह ह पानी म बुड़ जाही।<verse eid="ISA 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 28:18" />मऊत के संग तुम्हर करार ह टूट जाही;</para>
  <para style="q2" vid="ISA 28:18">अऊ मिरतू-लोक के संग तुम्हर समझौता ह नइं ठहिरही।</para>
  <para style="q1" vid="ISA 28:18">जब बाढ़ सहीं बिपत्ति ह आही,</para>
  <para style="q2" vid="ISA 28:18">तब तुमन ओमा कुचरे जाहू।<verse eid="ISA 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 28:19" />जब-जब भी येह आही, येह तुमन ला दूरिहा ले जाही;</para>
  <para style="q2" vid="ISA 28:19">बिहनियां के बाद बिहनियां, रात अऊ दिन,</para>
  <para style="q2" vid="ISA 28:19">येह आके नुकसान करही।”</para>
  <para style="b" vid="ISA 28:19" />
  <para style="q1" vid="ISA 28:19">ये संदेस के समझ ह</para>
  <para style="q2" vid="ISA 28:19">भयंकर आतंक लानही।<verse eid="ISA 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 28:20" />बिछौना ह हांथ-गोड़ फईलाय बर बहुंत छोटे हे,</para>
  <para style="q2" vid="ISA 28:20">अऊ ओढ़ना ह ओढ़े बर सांकुर हवय।<verse eid="ISA 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 28:21" />काबरकि यहोवा ह वइसन उठके ठाढ़ होही,</para>
  <para style="q2" vid="ISA 28:21">जइसन ओह परासीम नांव पहाड़ म ठाढ़ होय रिहिस,</para>
  <para style="q2" vid="ISA 28:21">ओह अपनआप ला वइसन देखाही, जइसन ओह गिबोन के घाटी म देखाय रिहिस—</para>
  <para style="q1" vid="ISA 28:21">ताकि ओह अपन काम, अपन अद्भूत काम ला करय,</para>
  <para style="q2" vid="ISA 28:21">अऊ अपन काम, अपन अलग किसम ला देखावय।<verse eid="ISA 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 28:22" />एकरसेति अब तुमन ठट्ठा झन करव,</para>
  <para style="q2" vid="ISA 28:22">नइं तो तुम्हर बेड़ीमन ला अऊ भारी कर दिये जाही;</para>
  <para style="q1" vid="ISA 28:22">परभू, सर्वसक्तिमान यहोवा ह मोला बताय हवय</para>
  <para style="q2" vid="ISA 28:22">कि पूरा देस के बिरूध बिनास के फैसला करे गे हवय।<verse eid="ISA 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="ISA 28:23" />धियान दव अऊ मोर अवाज ला सुनव,</para>
  <para style="q2" vid="ISA 28:23">धियान दव अऊ मोर बात ला सुनव।<verse eid="ISA 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 28:24" />का कोनो किसान बीज बोय बर नांगर जोतथे, त का लगातार जोतत रहिथे?</para>
  <para style="q2" vid="ISA 28:24">का ओह लगातार माटी ला फोरथे अऊ काम करत रहिथे?<verse eid="ISA 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 28:25" />जब ओह भुइयां ला समतल कर लेथे,</para>
  <para style="q2" vid="ISA 28:25">त का ओह अजवाईन ला नइं बोवय अऊ जीरा ला नइं छिंचय?</para>
  <para style="q1" vid="ISA 28:25">का ओह गहूं ला येकर जगह म,</para>
  <para style="q2" vid="ISA 28:25">जौ ला येकर भाग म</para>
  <para style="q2" vid="ISA 28:25">अऊ कठिया गहूं ला येकर खेत के मुड़ा म नइं बोवय?<verse eid="ISA 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 28:26" />ओकर परमेसर ह ओला</para>
  <para style="q2" vid="ISA 28:26">सही तरीका सिखोथे अऊ बताथे।<verse eid="ISA 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="ISA 28:27" />अजवाईन ला बेलन चलाके नइं मिंजे जावय,</para>
  <para style="q2" vid="ISA 28:27">न ही जीरा ऊपर गाड़ी के चक्का चलाय जावय;</para>
  <para style="q1" vid="ISA 28:27">अजवाईन ला छड़ी ले</para>
  <para style="q2" vid="ISA 28:27">अऊ जीरा ला लउठी ले पीटके झर्राय जाथे।<verse eid="ISA 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 28:28" />रोटी बनाय बर अनाज ला पीसना जरूरी अय;</para>
  <para style="q2" vid="ISA 28:28">पर ओला कोनो हमेसा मिंजत नइं रहय।</para>
  <para style="q1" vid="ISA 28:28">मिंजई करे के गाड़ी के चक्का ह येकर ऊपर चल सकत हे,</para>
  <para style="q2" vid="ISA 28:28">पर कोनो मनखे अनाज ला पीसे बर घोड़ामन के उपयोग नइं करय।<verse eid="ISA 28:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 28:29" />ये जम्मो चीज घलो सर्वसक्तिमान यहोवा करा ले आथे,</para>
  <para style="q2" vid="ISA 28:29">जेकर योजना ह अद्भूत अय,</para>
  <para style="q2" vid="ISA 28:29">जेकर बुद्धि ह उत्तम अय।<verse eid="ISA 28:29" /></para>
  <chapter eid="ISA 28" />
  <chapter number="29" style="c" sid="ISA 29" />
  <para style="s1">दाऊद के नगर ऊपर हाय</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 29:1" />तोर ऊपर हाय, अरीएल, अरीएल,</para>
  <para style="q2" vid="ISA 29:1">ओ नगर जेमा दाऊद निवास करत रिहिस!</para>
  <para style="q1" vid="ISA 29:1">बछर ऊपर बछर जोड़त जावव</para>
  <para style="q2" vid="ISA 29:1">अऊ अपन तिहारमन ला मनाते जावव।<verse eid="ISA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 29:2" />तभो ले मेंह तो अरीएल ला संकट म डारहूं;</para>
  <para style="q2" vid="ISA 29:2">ओह रोही अऊ बिलाप करही,</para>
  <para style="q2" vid="ISA 29:2">अऊ ओह मोर नजर म एक अरीएल<note caller="+" style="f"><char style="fr" closed="false">29:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">आगी के कुंड</char></note> सहीं ठहिरही।<verse eid="ISA 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 29:3" />मेंह तोर बिरूध चारों कोति डेरा डालहूं;</para>
  <para style="q2" vid="ISA 29:3">मेंह मीनार बनाके तोला घेर लूहूं</para>
  <para style="q2" vid="ISA 29:3">अऊ तोर बिरूध सैनिक घेरा डालहूं।<verse eid="ISA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 29:4" />तोला खाल्हे लाने जाही, तेंह भुइयां ले गोठियाबे;</para>
  <para style="q2" vid="ISA 29:4">तेंह धुर्रा म ले बड़बड़ाबे।</para>
  <para style="q1" vid="ISA 29:4">एक भूत सहीं तोर अवाज धरती ले आही;</para>
  <para style="q2" vid="ISA 29:4">धुर्रा म ले तोर कानाफूसी के अवाज आही।<verse eid="ISA 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 29:5" />पर तोर बहुंते बईरीमन बारिक धुर्रा सहीं हो जाहीं,</para>
  <para style="q2" vid="ISA 29:5">निरदयी उपदरवी भीड़ ह उड़ियाय भूंसा सहीं।</para>
  <para style="q1" vid="ISA 29:5">अचानक, पल भर म,<verse eid="ISA 29:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 29:6" />सर्वसक्तिमान यहोवा ह गरजत</para>
  <para style="q1" vid="ISA 29:6">अऊ भुइंडोल अऊ बड़े अवाज के संग,</para>
  <para style="q2" vid="ISA 29:6">बवंडर अऊ आंधी अऊ भसम करइया आगी के संग आही।<verse eid="ISA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 29:7" />तब जम्मो जाति के उपदरवी भीड़, जेमन अरीएल के बिरूध लड़थें,</para>
  <para style="q2" vid="ISA 29:7">जेमन ओकर अऊ ओकर किला ऊपर हमला करके ओला घेर लेथें,</para>
  <para style="q1" vid="ISA 29:7">येह रथिया देखे गय एक सपना,</para>
  <para style="q2" vid="ISA 29:7">एक दरसन के सहीं होही—<verse eid="ISA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 29:8" />येह अइसन होही, जइसे कोनो भूखा मनखे जेवन करे के सपना देखथे,</para>
  <para style="q2" vid="ISA 29:8">पर जब ओह जागथे, त भूखन ही रहिथे;</para>
  <para style="q1" vid="ISA 29:8">या कोनो पीयासन मनखे पानी पीये के सपना देखथे,</para>
  <para style="q2" vid="ISA 29:8">पर जब जागथे, त दुरबल अऊ पीयासन ही रहिथे।</para>
  <para style="q1" vid="ISA 29:8">अइसन ही ओ जम्मो जातिमन के उपदरवी भीड़ के दसा होही</para>
  <para style="q2" vid="ISA 29:8">जेमन सियोन पहाड़ के बिरूध लड़थें।<verse eid="ISA 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 29:9" />ठहर जावव अऊ अचम्भो करव,</para>
  <para style="q2" vid="ISA 29:9">अपनआप ला अंधरा कर लव अऊ झन देखव;</para>
  <para style="q1" vid="ISA 29:9">मतवार बन जावव, पर अंगूर के मंद पीके नइं,</para>
  <para style="q2" vid="ISA 29:9">लड़खड़ावव, पर मंद पीके नइं।<verse eid="ISA 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 29:10" />यहोवा ह तुमन ला भारी नींद म डाल देय हवय:</para>
  <para style="q2" vid="ISA 29:10">ओह तुम्हर आंखीमन (अगमजानीमन) म मुहर लगा दे हवय;</para>
  <para style="q2" vid="ISA 29:10">ओह तुम्हर मुड़मन (अगम-दरसीमन) ला ढांप दे हवय।<verse eid="ISA 29:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11" />तुम्हर बर ये पूरा दरसन कुछू नइं, पर एक किताब म लिखे मुहरबंद बचन अय। अऊ कहूं तुमन ये किताब कोनो मनखे ला देथव, जऊन ह पढ़ सकथे, अऊ तुमन कहिथव, “येला पढ़,” अऊ ओह कहिथे, “मेंह नइं पढ़े सकंव, काबरकि येमा मुहर लगे हवय।” <verse eid="ISA 29:11" /><verse number="12" style="v" sid="ISA 29:12" />या कहूं तुमन ये किताब कोनो अइसने मनखे ला देथव जऊन ह पढ़ नइं सकय, अऊ तुमन कहिथव, “येला पढ़,” त ओह जबाब दीही, “मेंह तो पढ़े बर नइं जानंव।”<verse eid="ISA 29:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13" />परभू ह कहिथे:</para>
  <para style="q1" vid="ISA 29:13">“ये मनखेमन अपन बचन के संग मोर लकठा म आथें</para>
  <para style="q2" vid="ISA 29:13">अऊ अपन ओंठ ले मोर आदर करथें,</para>
  <para style="q2" vid="ISA 29:13">पर ओमन के हिरदय ह मोर ले दूरिहा हवय।</para>
  <para style="q1" vid="ISA 29:13">ओमन के मोर अराधना करई</para>
  <para style="q2" vid="ISA 29:13">मनखेमन के बनाय नियममन ऊपर अधारित हे, जेला ओमन ला सिखाय गे हवय।<verse eid="ISA 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 29:14" />एकरसेति, मेंह ये मनखेमन ला एक बार फेर</para>
  <para style="q2" vid="ISA 29:14">अद्भूत काम ऊपर अद्भूत काम करके चकित करहूं;</para>
  <para style="q1" vid="ISA 29:14">बुद्धिमान के बुद्धि ह नास होही,</para>
  <para style="q2" vid="ISA 29:14">होसियारमन के होसियारी ह जावत रहिही।”<verse eid="ISA 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 29:15" />हाय ओमन ऊपर, जेमन अपन चलाकी ला यहोवा ले</para>
  <para style="q2" vid="ISA 29:15">लुकाय बर अब्बड़ कोसिस करथें,</para>
  <para style="q1" vid="ISA 29:15">अऊ अपन काम अंधियार म करके कहिथें अऊ सोचथें,</para>
  <para style="q2" vid="ISA 29:15">“हमन ला कोन देखत हे? येला कोन ह जानही?”<verse eid="ISA 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 29:16" />तुमन चीजमन ला उल्टा पुलटा कर देथव,</para>
  <para style="q2" vid="ISA 29:16">मानो कुम्हार ह माटी के सहीं समझे गीस!</para>
  <para style="q1" vid="ISA 29:16">का बनाय गय चीज ह अपन बनानेवाला ला कहिथे,</para>
  <para style="q2" vid="ISA 29:16">“तेंह मोला नइं बनाय हस”?</para>
  <para style="q1" vid="ISA 29:16">का बरतन ह कुम्हार ले कह सकथे,</para>
  <para style="q2" vid="ISA 29:16">“तेंह कुछू नइं जानस”?<verse eid="ISA 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 29:17" />का थोरकन समय म ही, लबानोन ह उपजाऊ भुइयां म नइं बदले जाही</para>
  <para style="q2" vid="ISA 29:17">अऊ उपजाऊ भुइयां जंगल सहीं जान पड़थे?<verse eid="ISA 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 29:18" />ओ दिन भैंरामन किताब के बात ला सुनहीं,</para>
  <para style="q2" vid="ISA 29:18">धुंधलापन ले अऊ अंधियार म ले</para>
  <para style="q2" vid="ISA 29:18">अंधरामन के आंखीमन देखन लगहीं।<verse eid="ISA 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 29:19" />एक बार फेर नम्र मनखे ह यहोवा म आनंदित होही;</para>
  <para style="q2" vid="ISA 29:19">अऊ जरूरतमंद ह इसरायल के पबितर परमेसर म आनंदित होही।<verse eid="ISA 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 29:20" />निरदयी ह गायब हो जाही,</para>
  <para style="q2" vid="ISA 29:20">ठट्ठा करइयामन के अन्त हो जाही,</para>
  <para style="q2" vid="ISA 29:20">अऊ जेमन बुरई करे के नजर रखथें, ओमन काट डारे जाहीं—<verse eid="ISA 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 29:21" />जेमन अपन बात से आने मनखे ला दोसी ठहिराथें,</para>
  <para style="q2" vid="ISA 29:21">जेमन अदालत म बचाव करइया ला फंसा लेथें</para>
  <para style="q2" vid="ISA 29:21">अपन लबारी गवाही के दुवारा निरदोस के नियाय ला बिगाड़थें।<verse eid="ISA 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22" />एकरसेति यहोवा, जऊन ह अब्राहम ला छोंड़ाईस, याकूब के संतानमन ले ये कहत हे:</para>
  <para style="q1" vid="ISA 29:22">“याकूब ह अब लज्जित नइं होही;</para>
  <para style="q2" vid="ISA 29:22">ओमन के चेहरा अब उदास नइं होही।<verse eid="ISA 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 29:23" />जब याकूब के संतानमन अपन बीच</para>
  <para style="q2" vid="ISA 29:23">मोर हांथ के काममन ला देखहीं,</para>
  <para style="q1" vid="ISA 29:23">तब ओमन मोर आदर करहीं,</para>
  <para style="q2" vid="ISA 29:23">ओमन याकूब के पबितर परमेसर के पबितरता ला मानहीं,</para>
  <para style="q2" vid="ISA 29:23">अऊ इसरायल के परमेसर के भय म ठाढ़ होहीं।<verse eid="ISA 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 29:24" />जेमन आतमा म जिद्दी<note caller="+" style="f"><char style="fr" closed="false">29:24 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मुरूख</char></note> अंय, ओमन समझदार होहीं;</para>
  <para style="q2" vid="ISA 29:24">जेमन कुड़कुड़ाथें, ओमन सिकछा ला गरहन करहीं।”<verse eid="ISA 29:24" /></para>
  <chapter eid="ISA 29" />
  <chapter number="30" style="c" sid="ISA 30" />
  <para style="s1">जिद्दी देस ऊपर हाय</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 30:1" />“जिद्दी लइकामन ऊपर हाय,”</para>
  <para style="q2" vid="ISA 30:1">यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="ISA 30:1">“हाय ओमन ऊपर, जेमन ओ योजना ऊपर काम करथें, जऊन ह मोर नो हय,</para>
  <para style="q2" vid="ISA 30:1">करार तो करथें, पर मोर आतमा के दुवारा नइं,</para>
  <para style="q2" vid="ISA 30:1">अऊ अइसन करके पाप ऊपर पाप करत जाथें;<verse eid="ISA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 30:2" />जेमन बिगर मोर ले पुछे</para>
  <para style="q2" vid="ISA 30:2">खाल्हे मिसर देस जाथें;</para>
  <para style="q1" vid="ISA 30:2">जेमन आसा करथें कि फिरौन ह ओमन के बचाव करे,</para>
  <para style="q2" vid="ISA 30:2">अऊ ओमन मिसर के छइहां म सरन लेवंय।<verse eid="ISA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 30:3" />पर फिरौन के बचाव ले तुमन लज्जित होहू,</para>
  <para style="q2" vid="ISA 30:3">अऊ मिसर के छइहां ह तुमन ला कलंकित करही।<verse eid="ISA 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 30:4" />हालाकि ओमन के करमचारीमन सोअन सहर म हवंय</para>
  <para style="q2" vid="ISA 30:4">अऊ ओमन के दूतमन अब हानेस सहर म हबर गे हवंय।<verse eid="ISA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 30:5" />पर हर एक ला लज्जित होय बर पड़ही</para>
  <para style="q2" vid="ISA 30:5">काबरकि एक किसम के मनखेमन ओमन बर बेकार साबित होहीं,</para>
  <para style="q1" vid="ISA 30:5">जेमन ले न तो कोनो मदद मिलही अऊ न ही ओमन ले कोनो फायदा होही,</para>
  <para style="q2" vid="ISA 30:5">पर ओमन सिरिप लज्जा अऊ कलंक के कारन बनहीं।”<verse eid="ISA 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6" />नेगेव के पसुमन के बारे म एक अगमबानी:</para>
  <para style="q1" vid="ISA 30:6">कठिनई अऊ दुख ले भरे देस ले होवत,</para>
  <para style="q2" vid="ISA 30:6">सेर अऊ सेरनीमन ले होवत,</para>
  <para style="q2" vid="ISA 30:6">बिसैला अऊ फुफकारत सांपमन ले होवत,</para>
  <para style="q1" vid="ISA 30:6">दूतमन अपन धन-दौलत गदहामन के पीठ ऊपर,</para>
  <para style="q2" vid="ISA 30:6">अऊ अपन खजानामन ला ऊंटमन के पीठ म लादके</para>
  <para style="q1" vid="ISA 30:6">ओ देस म लाथें, जिहां ओमन ला कोनो फायदा नइं होवय,<verse eid="ISA 30:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 30:7" />याने कि मिसर देस म लाथें, जेकर मदद ह एकदम बेकार अय।</para>
  <para style="q1" vid="ISA 30:7">एकरसेति मेंह ओकर नांव</para>
  <para style="q2" vid="ISA 30:7">राहाब, कुछू नइं करइया रखे हंव।<verse eid="ISA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 30:8" />अब जा, येला ओमन बर एक ठन पटिया म खोदके लिख,</para>
  <para style="q2" vid="ISA 30:8">एक किताब म लिख,</para>
  <para style="q1" vid="ISA 30:8">ताकि अवइया दिनमन बर</para>
  <para style="q2" vid="ISA 30:8">येह सदाकाल के एक गवाही होवय।<verse eid="ISA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 30:9" />काबरकि येमन बिदरोही मनखे, धोखा देवइया लइकामन अंय,</para>
  <para style="q2" vid="ISA 30:9">अइसन लइकामन अंय, जेमन यहोवा के सिकछा ला सुने नइं चाहत हें।<verse eid="ISA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 30:10" />ओमन अगम-दरसीमन ला कहिथें,</para>
  <para style="q2" vid="ISA 30:10">“अऊ दरसन झन देखव!”</para>
  <para style="q1" vid="ISA 30:10">अऊ अगमजानीमन ला कहिथें,</para>
  <para style="q2" vid="ISA 30:10">“हमन ला ओ दरसन के बात झन बतावव, जऊन ह सही अय!</para>
  <para style="q1" vid="ISA 30:10">हमन ले खुसी देवइया बात कहव,</para>
  <para style="q2" vid="ISA 30:10">मोह लेवइया बात के अगमबानी करव।<verse eid="ISA 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 30:11" />ये डहार ला छोंड़व</para>
  <para style="q2" vid="ISA 30:11">ये रद्दा ले हट जावव,</para>
  <para style="q1" vid="ISA 30:11">अऊ इसरायल के पबितर परमेसर के संग</para>
  <para style="q2" vid="ISA 30:11">हमर बिरोध करई बंद करव!”<verse eid="ISA 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 30:12" />एकर कारन इसरायल के पबितर परमेसर ह ये कहत हे:</para>
  <para style="q1" vid="ISA 30:12">“काबरकि तुमन ये संदेस ला अस्वीकार करे हव,</para>
  <para style="q2" vid="ISA 30:12">अतियाचार ऊपर बिसवास करे हव</para>
  <para style="q2" vid="ISA 30:12">अऊ धोखा ऊपर भरोसा करे हव,<verse eid="ISA 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 30:13" />एकरसेति ये पाप ह तुम्हर बर अइसन हो जाही</para>
  <para style="q2" vid="ISA 30:13">जइसन कोनो ऊंचहा दीवार म दरार पड़थे अऊ टूटे लगथे,</para>
  <para style="q2" vid="ISA 30:13">ओह अचानक पल भर म टूटके गिर जाथे।<verse eid="ISA 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 30:14" />येह माटी के बरतन सहीं फूटके कुटा-कुटा हो जाही,</para>
  <para style="q2" vid="ISA 30:14">चकनाचूर होके अइसन बिखर जाही</para>
  <para style="q1" vid="ISA 30:14">कि ओकर टुकड़ा के एक ठिकरा घलो नइं मिलही</para>
  <para style="q2" vid="ISA 30:14">जेकर ले अंगीठी म ले आगी निकाले जावय</para>
  <para style="q2" vid="ISA 30:14">या टांकी म ले पानी निकाले जाय।”<verse eid="ISA 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 30:15" />परमपरधान यहोवा, इसरायल के पबितर परमेसर ह ये कहत हे:</para>
  <para style="q1" vid="ISA 30:15">“पछताप करके चुप रहे म तुम्हर उद्धार हवय,</para>
  <para style="q2" vid="ISA 30:15">सांत रहिके भरोसा करे म तुम्हर ताकत हवय,</para>
  <para style="q2" vid="ISA 30:15">पर तुमन येमा के एको ठन चीज नइं करेव।<verse eid="ISA 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 30:16" />तुमन कहेव, ‘नइं, हमन तो घोड़ा म चघके भाग जाबो।’</para>
  <para style="q2" vid="ISA 30:16">एकरसेति तुमन भागहू!</para>
  <para style="q1" vid="ISA 30:16">तुमन कहेव, ‘हमन तेज भगइया घोड़ामन म सवारी करबो।’</para>
  <para style="q2" vid="ISA 30:16">एकरसेति तुम्हर पीछा करइयामन तुम्हर ले तेज होहीं!<verse eid="ISA 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 30:17" />एके जन के धमकी ले</para>
  <para style="q2" vid="ISA 30:17">एक हजार भागहीं;</para>
  <para style="q1" vid="ISA 30:17">पांच जन के धमकी ले</para>
  <para style="q2" vid="ISA 30:17">तुमन जम्मो के जम्मो भागहू,</para>
  <para style="q1" vid="ISA 30:17">जब तक तुमन कोनो पहाड़ के टीप म झंडा के एक लउठी</para>
  <para style="q2" vid="ISA 30:17">या पहाड़ी के ऊपर एक झंडा सहीं नइं छोंड़ दिये जावव।”<verse eid="ISA 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 30:18" />तभो ले यहोवा ह तुम्हर ऊपर अनुग्रह करे के ईछा रखथे;</para>
  <para style="q2" vid="ISA 30:18">एकरसेति ओह तुम्हर ऊपर दया देखाय बर ठाढ़ होही।</para>
  <para style="q1" vid="ISA 30:18">काबरकि यहोवा ह नियाय के परमेसर अय</para>
  <para style="q2" vid="ISA 30:18">धइन अंय ओ जम्मो, जेमन ओकर ऊपर आसा लगाय रहिथें!<verse eid="ISA 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19" />हे सियोन के मनखेमन, जेमन यरूसलेम म रहिथव, तुमन ला अऊ रोना नइं पड़य। जब तुमन ओला मदद बर पुकारहू, त ओह तुम्हर ऊपर अनुग्रह करही! ओह तुम्हर बात सुनते ही तुमन ला जबाब दीही। <verse eid="ISA 30:19" /><verse number="20" style="v" sid="ISA 30:20" />हालाकि परभू ह तुमन ला बिपत्ति के रोटी अऊ दुख के पानी देथे, तभो ले तुम्हर गुरूमन अब लुकाय नइं रहंय; तुमन अपन आंखी ले ओमन ला देखहू। <verse eid="ISA 30:20" /><verse number="21" style="v" sid="ISA 30:21" />चाहे तुमन जेवनी मुड़व या डेरी कोति मुड़व, तुमन ला अपन पाछू म एक अवाज ये कहत सुनई दीही, “येह ओ डहार अय; इही म रेंगव।” <verse eid="ISA 30:21" /><verse number="22" style="v" sid="ISA 30:22" />तब तुमन ओ मूरतीमन ला अपबितर करहू, जेमन म चांदी मढ़े गे हवय अऊ जेमन ला सोन ले मढ़े गे हवय; तुमन ओमन ला माहवारी के ओनहा सहीं फेंक दूहू अऊ ओमन ला कहिहू, “दूरिहा होवव!”<verse eid="ISA 30:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23" />यहोवा ह तुम्हर ओ बीजा बर पानी बरसाही, जेला तुमन भुइयां म बोथव, अऊ भुइयां के ऊपज याने कि जेवन घलो बढ़िया अऊ भरपूर होही। ओ दिन तुम्हर पसुमन बड़े-बड़े चरागन म चरहीं। <verse eid="ISA 30:23" /><verse number="24" style="v" sid="ISA 30:24" />खेत म काम करइया बईला अऊ गदहामन रांपा अऊ बेलचा ले फईलाय भूंसा अऊ चारा खाहीं। <verse eid="ISA 30:24" /><verse number="25" style="v" sid="ISA 30:25" />बड़े महा संहार के दिन, जब खंभामन गिरहीं, त पानी के झरनामन हर एक ऊंच पहाड़ अऊ ऊंच पहाड़ी ले बहत आहीं। <verse eid="ISA 30:25" /><verse number="26" style="v" sid="ISA 30:26" />जब यहोवा ह अपन मनखेमन ला लगे चोट म पट्टी बांधही अऊ ओमन ला दिये घावमन ला चंगा करही, तब चंदा के अंजोर सूरज सहीं, अऊ सूरज के अंजोर सात गुना अऊ अंजोर हो जाही, याने कि पूरा सात दिन के अंजोर सहीं होही।<verse eid="ISA 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 30:27" />देखव, यहोवा ह दूरिहा ले</para>
  <para style="q2" vid="ISA 30:27">भड़के गुस्सा अऊ धुआं के घना बादल के संग आवत हे;</para>
  <para style="q1" vid="ISA 30:27">ओकर ओंठमन कोप ले भरे हवंय,</para>
  <para style="q2" vid="ISA 30:27">अऊ ओकर जीभ ह भसम करइया आगी सहीं अय।<verse eid="ISA 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 30:28" />ओकर सांस ह उमड़त पानी के धारा सहीं अय,</para>
  <para style="q2" vid="ISA 30:28">जऊन ह घेंच तक हबरत हे।</para>
  <para style="q1" vid="ISA 30:28">ओह सब जातिमन ला बिनास के छननी ले छानथे;</para>
  <para style="q2" vid="ISA 30:28">ओह मनखेमन के जबड़ा म ओ लगाम लगाथे,</para>
  <para style="q2" vid="ISA 30:28">जऊन ह ओमन ला रसता ले भटका देथे।<verse eid="ISA 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 30:29" />तब तुमन अइसन गाहू</para>
  <para style="q2" vid="ISA 30:29">जइसन तुमन कोनो पबितर तिहार ला मनाय के बेरा रथिया गाथव;</para>
  <para style="q1" vid="ISA 30:29">तुम्हर मन ह अइसन आनंदित होही</para>
  <para style="q2" vid="ISA 30:29">जइसन मनखेमन यहोवा के पहाड़,</para>
  <para style="q1" vid="ISA 30:29">इसरायल के चट्टान मेर ऊपर जाय के बेरा</para>
  <para style="q2" vid="ISA 30:29">बंसी बजात जाथें।<verse eid="ISA 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 30:30" />यहोवा अपन परतापी बचन मनखेमन ला सुनाही</para>
  <para style="q2" vid="ISA 30:30">अऊ भयंकर कोरोध अऊ भसम करइया आगी के संग,</para>
  <para style="q1" vid="ISA 30:30">भारी बारिस, बादर के गरजन अऊ करा के संग,</para>
  <para style="q2" vid="ISA 30:30">मनखेमन ला अपन भुजबल देखाही।<verse eid="ISA 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 30:31" />यहोवा के अवाज ह अस्सूर ला कुटा-कुटा कर दीही;</para>
  <para style="q2" vid="ISA 30:31">अपन सुंटी ले ओह ओमन ला मार गिराही।<verse eid="ISA 30:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 30:32" />अपन दंड देवइया गदा ले ओमन ऊपर</para>
  <para style="q2" vid="ISA 30:32">जब यहोवा ह चोट करथे</para>
  <para style="q1" vid="ISA 30:32">त हर एक चोट ह डफली अऊ बीना के संगीत म होही,</para>
  <para style="q2" vid="ISA 30:32">जब ओह अपन हांथ ले मुक्का मारत ओमन ले लड़ई करथे।<verse eid="ISA 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 30:33" />बहुंत समय ले तोपेत<note caller="+" style="f"><char style="fr" closed="false">30:33 </char><char style="fq" closed="false">तोपेत </char><char style="ft" closed="false">याने कि </char><char style="fqa" closed="false">आगी बारे के जगह, जिहां यरूसलेम के कचरा ला जलाय जावय</char></note> ला तियार करे गे हवय;</para>
  <para style="q2" vid="ISA 30:33">येला राजा बर तियार करे गे हवय।</para>
  <para style="q1" vid="ISA 30:33">येकर आगी के खंचवा ला गहिला अऊ चौड़ा बनाय गे हवय,</para>
  <para style="q2" vid="ISA 30:33">येमा बहुंत अकन आगी अऊ लकरी हवय;</para>
  <para style="q1" vid="ISA 30:33">यहोवा के सांस ह</para>
  <para style="q2" vid="ISA 30:33">बरत गंधक के धारा सहीं</para>
  <para style="q2" vid="ISA 30:33">ओमा आगी लगा देथे।<verse eid="ISA 30:33" /></para>
  <chapter eid="ISA 30" />
  <chapter number="31" style="c" sid="ISA 31" />
  <para style="s1">ओमन ऊपर हाय, जऊन मन मिसर ऊपर भरोसा रखथें</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 31:1" />ओमन ऊपर हाय, जेमन मदद पाय बर खाल्हे मिसर देस म जाथें,</para>
  <para style="q2" vid="ISA 31:1">जेमन घोड़ामन के आसरा करथें,</para>
  <para style="q1" vid="ISA 31:1">जेमन अपन भारी संखिया के रथमन ऊपर भरोसा रखथें</para>
  <para style="q2" vid="ISA 31:1">अऊ अपन घुड़सवारमन के बड़े ताकत ऊपर भरोसा करथें,</para>
  <para style="q1" vid="ISA 31:1">पर इसरायल के पबितर परमेसर कोति नइं देखंय,</para>
  <para style="q2" vid="ISA 31:1">अऊ न ही यहोवा ले मदद मांगंय।<verse eid="ISA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 31:2" />पर ओह घलो बुद्धिमान अय अऊ बिपत्ति ला सकथे;</para>
  <para style="q2" vid="ISA 31:2">ओह अपन बचन ला वापिस नइं लेवय।</para>
  <para style="q1" vid="ISA 31:2">ओह ओ दुस्ट जाति के बिरूध ठाढ़ होही,</para>
  <para style="q2" vid="ISA 31:2">ओह ओमन के बिरूध ठाढ़ होही, जेमन कुकरमीमन के मदद करथें।<verse eid="ISA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 31:3" />पर मिसरीमन सिरिप मरनहार मनखे अंय। परमेसर नइं;</para>
  <para style="q2" vid="ISA 31:3">ओमन के घोड़ामन आतमा नो हंय, पर मांस ही अंय।</para>
  <para style="q1" vid="ISA 31:3">जब यहोवा ह अपन हांथ ला बढ़ाही,</para>
  <para style="q2" vid="ISA 31:3">त जेमन मदद करथें ओमन लड़खड़ाहीं,</para>
  <para style="q2" vid="ISA 31:3">अऊ जेमन मदद पाथें ओमन गिरहीं;</para>
  <para style="q2" vid="ISA 31:3">जम्मो के जम्मो एक संग नास होहीं।<verse eid="ISA 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 31:4" />यहोवा ह मोला ये कहत हे:</para>
  <para style="q1" vid="ISA 31:4">“जइसन सिंह ह</para>
  <para style="q2" vid="ISA 31:4">एक बड़े सिंह ह अपन सिकार ऊपर गुर्राथे—</para>
  <para style="q1" vid="ISA 31:4">अऊ चरवाहामन के पूरा दल</para>
  <para style="q2" vid="ISA 31:4">येकर बिरूध आय ले घलो</para>
  <para style="q1" vid="ISA 31:4">येह ओमन के अवाज ले नइं डरावय</para>
  <para style="q2" vid="ISA 31:4">या ओमन के हल्ला-गुल्ला से येला कोनो फरक नइं पड़य—</para>
  <para style="q1" vid="ISA 31:4">वइसने ही सर्वसक्तिमान यहोवा ह खाल्हे आके</para>
  <para style="q2" vid="ISA 31:4">सियोन पहाड़ ऊपर अऊ येकर ऊंचई म लड़ई करही।<verse eid="ISA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 31:5" />जइसे चिरईमन मुड़ ऊपर मंडराथें,</para>
  <para style="q2" vid="ISA 31:5">वइसे सर्वसक्तिमान यहोवा ह यरूसलेम के रकछा करही;</para>
  <para style="q1" vid="ISA 31:5">ओह ओकर रकछा करही अऊ ओला छोंड़ाही,</para>
  <para style="q2" vid="ISA 31:5">ओह ओमा ले होके जाही अऊ ओला बचाही।”<verse eid="ISA 31:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6" />हे इसरायलीमन, जेकर बिरूध म तुमन भारी बिदरोह करे हवव, ओकर मेर लहुंटके आवव। <verse eid="ISA 31:6" /><verse number="7" style="v" sid="ISA 31:7" />काबरकि ओ दिन, तुमन म ले हर एक जन ओ सोन अऊ चांदी के मूरतीमन ला अस्वीकार करहू, जेमन ला तुम्हर पापी हांथमन बनाय हवंय।<verse eid="ISA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 31:8" />“अस्सूरीमन मनखे के तलवार ले मारे नइं जाहीं;</para>
  <para style="q2" vid="ISA 31:8">एक अइसन तलवार ह ओमन ला खा जाही, जऊन ह मरनहार मनखेमन के नो हय।</para>
  <para style="q1" vid="ISA 31:8">ओमन तलवार के सामने ले भागहीं</para>
  <para style="q2" vid="ISA 31:8">अऊ ओकर जवानमन ले बेगारी कराय जाही।<verse eid="ISA 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 31:9" />आतंक के मारे ओमन के गढ़ ह गिर जाही;</para>
  <para style="q2" vid="ISA 31:9">लड़ई के झंडा ला देखके ओमन के सेनापतिमन डर जाहीं,”</para>
  <para style="q1" vid="ISA 31:9">यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="ISA 31:9">जेकर आगी ह सियोन म,</para>
  <para style="q2" vid="ISA 31:9">अऊ जेकर भट्ठी ह यरूसलेम म हवय।<verse eid="ISA 31:9" /></para>
  <chapter eid="ISA 31" />
  <chapter number="32" style="c" sid="ISA 32" />
  <para style="s1">धरमीपन के सासन</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 32:1" />देखव, एक राजा ह धरमीपन से राज करही</para>
  <para style="q2" vid="ISA 32:1">अऊ सासन करइयामन नियाय के संग सासन करहीं।<verse eid="ISA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 32:2" />हर एक झन आंधी ले लुकाय के जगह,</para>
  <para style="q2" vid="ISA 32:2">अऊ तूफान ले आड़ लेय के जगह सहीं होही,</para>
  <para style="q1" vid="ISA 32:2">मरू-भुइयां म पानी के झरना,</para>
  <para style="q2" vid="ISA 32:2">अऊ तपत भुइयां म बड़े चट्टान के छइहां सहीं होही।<verse eid="ISA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 32:3" />ओ समय देखइयामन के आंखी ह नइं धुंधलाही,</para>
  <para style="q2" vid="ISA 32:3">अऊ सुनइयामन के कान ह सुनही।<verse eid="ISA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 32:4" />भय माननेवाला मनखे के मन ह जानही अऊ समझही,</para>
  <para style="q2" vid="ISA 32:4">अऊ तोतरामन के जीभ ह सही अऊ साफ हो जाही।<verse eid="ISA 32:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 32:5" />मुरूख ला फेर कभू उत्तम मनखे नइं कहे जाही</para>
  <para style="q2" vid="ISA 32:5">अऊ न ही दुस्ट मनखे ला बहुंत आदर दिये जाही।<verse eid="ISA 32:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 32:6" />काबरकि मुरूखमन तो मुरूखता के ही बात करथें,</para>
  <para style="q2" vid="ISA 32:6">अऊ ओमन के मन ह दुस्टता के बात म लगे रहिथे:</para>
  <para style="q1" vid="ISA 32:6">ओमन अधरम के काम करथें</para>
  <para style="q2" vid="ISA 32:6">अऊ यहोवा के बारे म लबारी बात फईलाथें;</para>
  <para style="q1" vid="ISA 32:6">भूखा ला भूखन ही रहन देथें</para>
  <para style="q2" vid="ISA 32:6">अऊ पीयासा ला पानी नइं देवंय।<verse eid="ISA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 32:7" />दुस्टमन दुस्ट तरीका अपनाथें,</para>
  <para style="q2" vid="ISA 32:7">ओमन दुस्ट उपाय निकालत रहिथें</para>
  <para style="q1" vid="ISA 32:7">ताकि गरीबमन ला लबारी बात कहिके लूटंय,</para>
  <para style="q2" vid="ISA 32:7">जब जरूरतमंद के बिनती ह सही होथे, तब घलो येमन अइसे ही करथें।<verse eid="ISA 32:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 32:8" />पर बने मनखे ह उत्तम उपाय करथे,</para>
  <para style="q2" vid="ISA 32:8">अऊ ओमन अपन उत्तम काममन के दुवारा बने रहिथें।<verse eid="ISA 32:8" /></para>
  <para style="s1">यरूसलेम के माईलोगनमन</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 32:9" />हे माईलोगनमन, जेमन बहुंत आत्म-संतुस्ट हवव,</para>
  <para style="q2" vid="ISA 32:9">उठव अऊ मोर बात ला सुनव;</para>
  <para style="q1" vid="ISA 32:9">हे बेटीमन, जेमन सुरकछित महसूस करथव,</para>
  <para style="q2" vid="ISA 32:9">मोर बात कोति कान लगावव!<verse eid="ISA 32:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 32:10" />एक बछर पूरा होय के थोरकन बाद</para>
  <para style="q2" vid="ISA 32:10">जेमन सुरकछित महसूस करत हवंय, ओमन कांपहीं;</para>
  <para style="q1" vid="ISA 32:10">काबरकि अंगूर के फसल ह नइं होही,</para>
  <para style="q2" vid="ISA 32:10">अऊ न ही कोनो किसम के फर धरही।<verse eid="ISA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 32:11" />हे आत्म-संतुस्ट माईलोगनमन, कांपव;</para>
  <para style="q2" vid="ISA 32:11">हे बेटीमन, जेमन सुरकछित महसूस करथव, तुमन कांपव!</para>
  <para style="q1" vid="ISA 32:11">अपन सुघर ओनहामन ला उतार दव</para>
  <para style="q2" vid="ISA 32:11">अऊ फटहा-चीरहा ओनहा ला लपेट लव।<verse eid="ISA 32:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 32:12" />बने खेतमन बर अऊ फरवाले अंगूर के नारमन बर</para>
  <para style="q2" vid="ISA 32:12">छाती पीट-पीटके रोवव<verse eid="ISA 32:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 32:13" />अऊ मोर मनखेमन के भुइयां बर,</para>
  <para style="q2" vid="ISA 32:13">अइसन भुइयां जेमा कांटा अऊ कंटिली झाड़ीमन बढ़ गे हवंय, रोवव—</para>
  <para style="q1" vid="ISA 32:13">हव, खुसी मनइया जम्मो घरमन बर</para>
  <para style="q2" vid="ISA 32:13">अऊ चहल-पहल वाले ये सहर बर बिलाप करव।<verse eid="ISA 32:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 32:14" />किला ला छोंड़ दिये जाही,</para>
  <para style="q2" vid="ISA 32:14">हल्ला-गुल्ला ले भरे सहर ला तियाग दिये जाही;</para>
  <para style="q1" vid="ISA 32:14">किला अऊ पहरेदारी के ऊंचहा जगहमन हमेसा बर सुनसान हो जाहीं</para>
  <para style="q2" vid="ISA 32:14">येमन गदहामन बर घुमे-फिरे के जगह अऊ पसुमन के चरागन ओ समय तक बने रहिहीं,<verse eid="ISA 32:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 32:15" />जब तक कि आतमा ला ऊपर ले हमर ऊपर ढारे नइं जाही,</para>
  <para style="q2" vid="ISA 32:15">अऊ मरू-भुइयां ह उपजाऊ खेत नइं बन जाही</para>
  <para style="q2" vid="ISA 32:15">अऊ उपजाऊ भुइयां एक जंगल सहीं नइं जान पड़ही।<verse eid="ISA 32:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 32:16" />यहोवा के नियाय ओ मरू-भुइयां म बसही,</para>
  <para style="q2" vid="ISA 32:16">ओकर धरमीपन ह ओ उपजाऊ भुइयां म रहिही।<verse eid="ISA 32:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 32:17" />ओ धरमीपन के फर ह सांति होही;</para>
  <para style="q2" vid="ISA 32:17">अऊ येकर नतीजा सबो दिन के सांति अऊ बिसवास होही।<verse eid="ISA 32:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 32:18" />मोर मनखेमन सांति के जगह म,</para>
  <para style="q2" vid="ISA 32:18">सुरकछित घरमन म,</para>
  <para style="q2" vid="ISA 32:18">अराम के जगहमन म निस्चिंत रहिहीं।<verse eid="ISA 32:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 32:19" />हालाकि करा ह जंगल ला चौरस कर देथे</para>
  <para style="q2" vid="ISA 32:19">अऊ सहर ह पूरा समतल हवय,<verse eid="ISA 32:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 32:20" />पर कतेक आसीसित होहू तुमन,</para>
  <para style="q2" vid="ISA 32:20">जब तुमन सोतामन के तीर म बीजा बोहू,</para>
  <para style="q2" vid="ISA 32:20">अऊ अपन पसु अऊ गदहामन ला चरे बर खुला छोंड़ दूहू।<verse eid="ISA 32:20" /></para>
  <chapter eid="ISA 32" />
  <chapter number="33" style="c" sid="ISA 33" />
  <para style="s1">संकट अऊ सहायता</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 33:1" />हे नास करइया, तोर ऊपर हाय,</para>
  <para style="q2" vid="ISA 33:1">तें, जेला नास नइं करे गे हवय!</para>
  <para style="q1" vid="ISA 33:1">हे बिसवासघात करइया, तोर ऊपर हाय,</para>
  <para style="q2" vid="ISA 33:1">तें, जेकर संग बिसवासघात नइं करे गे हवय!</para>
  <para style="q1" vid="ISA 33:1">जब तें नास करई बंद करबे,</para>
  <para style="q2" vid="ISA 33:1">तब तोला नास करे जाही;</para>
  <para style="q1" vid="ISA 33:1">जब तें बिसवासघात करई बंद करबे,</para>
  <para style="q2" vid="ISA 33:1">तब तोर संग बिसवासघात करे जाही।<verse eid="ISA 33:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 33:2" />हे यहोवा, हमर ऊपर अनुग्रह कर;</para>
  <para style="q2" vid="ISA 33:2">हमन तोर ही रसता देखत हवन।</para>
  <para style="q1" vid="ISA 33:2">हर बिहनियां तें हमर ताकत,</para>
  <para style="q2" vid="ISA 33:2">संकट के समय तें हमर उद्धारकर्ता बन जा।<verse eid="ISA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 33:3" />तोर सेना के हुल्लड़ करे ले मनखेमन भाग जाथें;</para>
  <para style="q2" vid="ISA 33:3">जब तेंह उठथस, त जाति-जाति के मनखेमन तितिर-बितिर हो जाथें।<verse eid="ISA 33:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 33:4" />जइसन जवान फांफामन खेत ला चट कर डारथें;</para>
  <para style="q2" vid="ISA 33:4">वइसन ही तुम्हर लूट ऊपर मनखेमन फांफामन के झुंड सहीं टूट पड़थें।<verse eid="ISA 33:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 33:5" />यहोवा ह ऊपर उठाय जाथे, काबरकि ओह ऊंच जगह<note caller="+" style="f"><char style="fr" closed="false">33:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">स्वरग</char></note> म रहिथे;</para>
  <para style="q2" vid="ISA 33:5">ओह सियोन ला अपन नियाय अऊ धरमीपन ले भर दीही।<verse eid="ISA 33:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 33:6" />यहोवा ह तुम्हर समय बर जरूरी आधार,</para>
  <para style="q2" vid="ISA 33:6">उद्धार अऊ बुद्धि अऊ गियान के एक उत्तम भंडार होही;</para>
  <para style="q2" vid="ISA 33:6">यहोवा के भय ह ये खजाना के चाबी अय।<verse eid="ISA 33:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 33:7" />देख, ओमन के सूरबीरमन गलीमन म जोर-जोर से रोवत हवंय;</para>
  <para style="q2" vid="ISA 33:7">सांति के दूतमन बिलख-बिलखके रोवत हवंय।<verse eid="ISA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 33:8" />राजमार्गमन सुनसान परे हवंय,</para>
  <para style="q2" vid="ISA 33:8">सड़कमन म कोनो यातरी नइं एं।</para>
  <para style="q1" vid="ISA 33:8">करार ला टोर दिये गे हवय,</para>
  <para style="q2" vid="ISA 33:8">येकर गवाहमन<note caller="+" style="f"><char style="fr" closed="false">33:8 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सहरमन</char></note> ला तुछ समझे जावत हे,</para>
  <para style="q2" vid="ISA 33:8">कोनो मनखे के आदर नइं होवत हे।<verse eid="ISA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 33:9" />भुइयां ह सूखत हे अऊ बेकार होवत हे,</para>
  <para style="q2" vid="ISA 33:9">लबानोन ह लज्जित होके मुरझावत हे;</para>
  <para style="q1" vid="ISA 33:9">सारोन ह अराबा के सहीं हो गे हवय,</para>
  <para style="q2" vid="ISA 33:9">अऊ बासान अऊ करमेल पहाड़ म पतझड़ होवत हवय।<verse eid="ISA 33:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 33:10" />यहोवा ह कहिथे, “अब मेंह उठहूं,</para>
  <para style="q2" vid="ISA 33:10">अब मेंह ऊपर उठाय जाहूं;</para>
  <para style="q2" vid="ISA 33:10">अब में ऊपर करे जाहूं।<verse eid="ISA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 33:11" />तुमन भूंसा ला गरभ म धरथव,</para>
  <para style="q2" vid="ISA 33:11">तुमन पैंरा ला जनम देथव;</para>
  <para style="q2" vid="ISA 33:11">तुम्हर सांस ह एक आगी अय, जऊन ह तुमन ला भसम कर देथे।<verse eid="ISA 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 33:12" />मनखेमन जरके राख हो जाहीं;</para>
  <para style="q2" vid="ISA 33:12">कटाय कंटिला झाड़ीमन सहीं ओमन ला आगी म जलाय जाही।”<verse eid="ISA 33:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 33:13" />तुमन, जेमन बहुंत दूरिहा म हवव, सुनव कि मेंह का करे हंव;</para>
  <para style="q2" vid="ISA 33:13">तुमन, जेमन लकठा म हवव, मोर ताकत ला जान लव!<verse eid="ISA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 33:14" />सियोन के पापीमन डर गे हवंय;</para>
  <para style="q2" vid="ISA 33:14">भक्तिहीनमन ला कंपकपी होवत हवय:</para>
  <para style="q1" vid="ISA 33:14">“हमन म ले कोन ह भसम करइया आगी म रह सकत हे?</para>
  <para style="q2" vid="ISA 33:14">हमन म ले कोन ह सदा बरत रहइया आगी म निवास कर सकत हे?”<verse eid="ISA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 33:15" />ओमन, जेमन धरमीपन म चलथें</para>
  <para style="q2" vid="ISA 33:15">अऊ सही बात बोलथें,</para>
  <para style="q1" vid="ISA 33:15">जेमन अंधेर के लाभ ले घिन करथें,</para>
  <para style="q2" vid="ISA 33:15">जेमन घूस नइं लेवंय,</para>
  <para style="q1" vid="ISA 33:15">जेमन हतिया करे के बात ला नइं सुनंय</para>
  <para style="q2" vid="ISA 33:15">अऊ बुरई करे के बात ले आंखी मुंद लेथें—<verse eid="ISA 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 33:16" />ओहीचमन ही ऊंचहा जगह म निवास करहीं,</para>
  <para style="q2" vid="ISA 33:16">जेमन के सरन-स्थान पहाड़ के किला होही।</para>
  <para style="q1" vid="ISA 33:16">ओमन ला रोटी दिये जाही,</para>
  <para style="q2" vid="ISA 33:16">अऊ ओमन ला पानी के कमी नइं होही।<verse eid="ISA 33:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 33:17" />तेंह अपन आंखी ले राजा ला ओकर सोभा समेत देखबे</para>
  <para style="q2" vid="ISA 33:17">अऊ लम्बा-चौड़ा देस ला देखबे।<verse eid="ISA 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 33:18" />अपन मन म तेंह पहिले के आतंक के दिन ला सुरता करबे:</para>
  <para style="q2" vid="ISA 33:18">“ओ मुखिया अधिकारी कहां हे?</para>
  <para style="q1" vid="ISA 33:18">ओह कहां हवय, जऊन ह मालगुजारी लेवय?</para>
  <para style="q2" vid="ISA 33:18">ऊंचहा महलमन के अधिकारी कहां हवय?”<verse eid="ISA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 33:19" />तेंह ओ जिद्दी मनखेमन ला फेर नइं देखबे,</para>
  <para style="q2" vid="ISA 33:19">ओ मनखे, जेमन के बात साफ नइं ए,</para>
  <para style="q2" vid="ISA 33:19">जेमन के भासा अजीब अऊ समझ म नइं आवय।<verse eid="ISA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 33:20" />सियोन कोति देख, हमर तिहारमन के सहर;</para>
  <para style="q2" vid="ISA 33:20">तें अपन आंखी ले यरूसलेम ला देखबे,</para>
  <para style="q2" vid="ISA 33:20">एक सांतिवाला डेरा, एक ठन तम्बू जेला हटाय नइं जावय;</para>
  <para style="q1" vid="ISA 33:20">येकर खूंटामन ला कभू निकाले नइं जावय,</para>
  <para style="q2" vid="ISA 33:20">अऊ न ही येकर कोनो रस्सी ला टोरे जावय।<verse eid="ISA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 33:21" />उहां यहोवा ह हमर सक्तिसाली जन होही।</para>
  <para style="q2" vid="ISA 33:21">येह चौड़ा-चौड़ा नदीमन अऊ सोतामन के एक जगह होही।</para>
  <para style="q1" vid="ISA 33:21">पतवार वाला डोंगा ह ओमन म नइं जा सकही,</para>
  <para style="q2" vid="ISA 33:21">अऊ न ही बड़े जहाज ह उहां ले होके जाही।<verse eid="ISA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 33:22" />काबरकि यहोवा ह हमर नियायी ए,</para>
  <para style="q2" vid="ISA 33:22">यहोवा ह हमर कानून-देवइया ए,</para>
  <para style="q1" vid="ISA 33:22">यहोवा ह हमर राजा ए;</para>
  <para style="q2" vid="ISA 33:22">ओही ह हमर उद्धार करही।<verse eid="ISA 33:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="ISA 33:23" />तोर जहाज के रस्सीमन ढीला हो गे हवंय:</para>
  <para style="q2" vid="ISA 33:23">मसतूल के जरी ला मजबूत नइं रखे गे हवय,</para>
  <para style="q2" vid="ISA 33:23">अऊ न ही पाल ला ताने गे हवय।</para>
  <para style="q1" vid="ISA 33:23">तब लूट के बहुंत सामान ला बांटे जाही</para>
  <para style="q2" vid="ISA 33:23">अऊ लंगड़ामन घलो लूटे गय सामान ला ले जाहीं।<verse eid="ISA 33:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 33:24" />सियोन म रहइया कोनो घलो ये नइं कहिहीं, “मेंह बेमार हंव”;</para>
  <para style="q2" vid="ISA 33:24">अऊ जेमन उहां रहिथें, ओमन के पाप छेमा करे जाही।<verse eid="ISA 33:24" /></para>
  <chapter eid="ISA 33" />
  <chapter number="34" style="c" sid="ISA 34" />
  <para style="s1">जाति-जाति के मनखेमन के बिरूध नियाय</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 34:1" />हे जाति-जाति के मनखेमन, लकठा म आवव अऊ सुनव;</para>
  <para style="q2" vid="ISA 34:1">हे मनखेमन, धियान देके सुनव!</para>
  <para style="q1" vid="ISA 34:1">धरती अऊ जऊन कुछू ओमा हवय,</para>
  <para style="q2" vid="ISA 34:1">संसार अऊ जऊन कुछू ओमा ले निकलके आथे, जम्मो के जम्मो सुनव!<verse eid="ISA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 34:2" />यहोवा सब जाति के मनखेमन ऊपर रिस करत हवय,</para>
  <para style="q2" vid="ISA 34:2">ओकर कोप ह ओमन के जम्मो सेना ऊपर हवय।</para>
  <para style="q1" vid="ISA 34:2">ओह ओमन ला पूरा नास कर दीही,</para>
  <para style="q2" vid="ISA 34:2">ओह ओमन के हतिया करे बर दे दीही।<verse eid="ISA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 34:3" />ओमन के मारे गय मनखेमन ला बाहिर फेंक दिये जाही,</para>
  <para style="q2" vid="ISA 34:3">ओमन के लास ले दुरगंध आही;</para>
  <para style="q2" vid="ISA 34:3">पहाड़मन ओमन के लहू ले गीला हो जाहीं।<verse eid="ISA 34:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 34:4" />अकास के जम्मो तारामन खतम हो जाहीं</para>
  <para style="q2" vid="ISA 34:4">अऊ अकास ला कागज सहीं लपेटे जाही;</para>
  <para style="q1" vid="ISA 34:4">जइसन अंगूर के नार के पानमन मुरझाके</para>
  <para style="q2" vid="ISA 34:4">अऊ अंजीर रूख ले अंजीरमन सिकुड़के गिर जाथें,</para>
  <para style="q2" vid="ISA 34:4">वइसन ही जम्मो तारा मंडल गिर जाहीं।<verse eid="ISA 34:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 34:5" />मोर तलवार ह अकास म पीके छक गे हवय;</para>
  <para style="q2" vid="ISA 34:5">देखव, येह नियाय बर एदोम ऊपर उतरत हे,</para>
  <para style="q2" vid="ISA 34:5">ओ मनखे, जेमन ला मेंह पूरा नास कर दे हंव।<verse eid="ISA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 34:6" />यहोवा के तलवार लहू ले भर गे हे,</para>
  <para style="q2" vid="ISA 34:6">येह चरबी ले ढंक गे हवय—</para>
  <para style="q1" vid="ISA 34:6">मेढ़ा-पीला अऊ बोकरामन के लहू ले,</para>
  <para style="q2" vid="ISA 34:6">मेढ़ामन के गुरदा के चरबी ले भरे हवय।</para>
  <para style="q1" vid="ISA 34:6">काबरकि बोसरा नगर म यहोवा बर एक बलिदान</para>
  <para style="q2" vid="ISA 34:6">अऊ एदोम देस म बड़े मारकाट करे गे हवय।<verse eid="ISA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 34:7" />ओमन के संग जंगली बईलामन,</para>
  <para style="q2" vid="ISA 34:7">बछवामन अऊ बड़े सांड़मन ला काटे जाही।</para>
  <para style="q1" vid="ISA 34:7">ओमन के देस ह खून ले भीग जाही,</para>
  <para style="q2" vid="ISA 34:7">अऊ धुर्रा ह चरबी ले भर जाही।<verse eid="ISA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 34:8" />काबरकि पलटा लेय बर यहोवा मेर एक दिन हवय,</para>
  <para style="q2" vid="ISA 34:8">सियोन के मामला ला उठाय बर, पलटा लेय के एक बछर हवय।<verse eid="ISA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 34:9" />एदोम के सोतामन ढलान म बदल जाहीं,</para>
  <para style="q2" vid="ISA 34:9">अऊ ओकर धुर्रा ह बरत गंधक म;</para>
  <para style="q2" vid="ISA 34:9">ओकर भुइयां ह बरत ढलान बन जाही!<verse eid="ISA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 34:10" />येह रात अऊ दिन नइं बुताही;</para>
  <para style="q2" vid="ISA 34:10">येकर धुआं हर समय उठत रहिही।</para>
  <para style="q1" vid="ISA 34:10">पीढ़ी-पीढ़ी तक येह उजाड़ परे रहिही;</para>
  <para style="q2" vid="ISA 34:10">कोनो ओमा ले होके फेर कभू नइं जाहीं।<verse eid="ISA 34:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 34:11" />मरू-भुइयां के उल्लू अऊ चीखनेवाला उल्लू ओमा निवास करहीं;</para>
  <para style="q2" vid="ISA 34:11">उहां बड़े उल्लू अऊ कऊआ बसेरा करहीं।</para>
  <para style="q1" vid="ISA 34:11">परमेसर ह एदोम ऊपर</para>
  <para style="q2" vid="ISA 34:11">गड़बड़ी के नापे के डोरी</para>
  <para style="q2" vid="ISA 34:11">अऊ सुन्नापन के नापे के बाट ला तानही।<verse eid="ISA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 34:12" />ओकर परभावसाली मनखेमन करा उहां अइसे कुछू नइं होही, जेला राजा के राज कहे जा सकय,</para>
  <para style="q2" vid="ISA 34:12">ओकर सब हाकिममन के अन्त हो जाही।<verse eid="ISA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 34:13" />ओकर महलमन म कंटिला रूख,</para>
  <para style="q2" vid="ISA 34:13">अऊ ओकर गढ़मन म बिच्छू पऊधा अऊ झाड़ीमन उगहीं।</para>
  <para style="q1" vid="ISA 34:13">ओह सियारमन के डेरा,</para>
  <para style="q2" vid="ISA 34:13">अऊ उल्लूमन के घर हो जाही।<verse eid="ISA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 34:14" />उहां मरू-भुइयां के जन्तुमन हुंर्रामन संग बसहीं,</para>
  <para style="q2" vid="ISA 34:14">अऊ जंगली बोकरामन एक-दूसर ला बलाहीं;</para>
  <para style="q1" vid="ISA 34:14">उहां रथिया के जीवमन घलो अराम करहीं</para>
  <para style="q2" vid="ISA 34:14">अऊ अपन बर अराम करे के जगह बना लीहीं।<verse eid="ISA 34:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 34:15" />उहां घुघवा ह खोंधरा बनाही अऊ अंडा दीही,</para>
  <para style="q2" vid="ISA 34:15">अंडा ले पीलामन निकलहीं, अऊ ओह अपन डेनामन के आड़ म</para>
  <para style="q2" vid="ISA 34:15">ओ पीलामन के देखभाल करही;</para>
  <para style="q1" vid="ISA 34:15">उहां बाज चिरईमन घलो</para>
  <para style="q2" vid="ISA 34:15">अपन-अपन जोड़ीदार के संग जूरहीं।<verse eid="ISA 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 34:16" />यहोवा के किताब म देखव अऊ पढ़व:</para>
  <para style="q1" vid="ISA 34:16">येमा के एको ठन घलो बात पूरा होय बिगर नइं रहय,</para>
  <para style="q2" vid="ISA 34:16">कोनो ला अपन जोड़ीदार के कमी नइं होही।</para>
  <para style="q1" vid="ISA 34:16">काबरकि येह यहोवा के मुहूं अय, जऊन ह हुकूम देय हवय,</para>
  <para style="q2" vid="ISA 34:16">अऊ ओकर आतमा ह ओमन ला इकट्ठा करे हवय।<verse eid="ISA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 34:17" />ओही ह ओमन के भाग ला बांटथे;</para>
  <para style="q2" vid="ISA 34:17">ओह अपन हांथ ले नापके ओमन ला बांट देथे।</para>
  <para style="q1" vid="ISA 34:17">ओमन येला हमेसा बर अपन अधिकार म ले लीहीं</para>
  <para style="q2" vid="ISA 34:17">अऊ पीढ़ी-पीढ़ी तक उहां निवास करहीं।<verse eid="ISA 34:17" /></para>
  <chapter eid="ISA 34" />
  <chapter number="35" style="c" sid="ISA 35" />
  <para style="s1">छोंड़ाय गय मनखेमन के आनंद</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 35:1" />मरू-भुइयां अऊ सूखा भुइयां खुस होहीं;</para>
  <para style="q2" vid="ISA 35:1">निरजन भुइयां ह आनंद मनाही अऊ उहां फूल धरही।</para>
  <para style="q1" vid="ISA 35:1">मरू-भुइयां ह मगन होके, <verse eid="ISA 35:1" /><verse number="2" style="v" sid="ISA 35:2" />केसर के सहीं फूल धरही;</para>
  <para style="q2" vid="ISA 35:2">येह बहुंत आनंदित होही अऊ आनंद के मारे जय-जयकार करही।</para>
  <para style="q1" vid="ISA 35:2">लबानोन के महिमा येला दिये जाही,</para>
  <para style="q2" vid="ISA 35:2">अऊ येकर सोभा करमेल अऊ सारोन के सहीं होही;</para>
  <para style="q1" vid="ISA 35:2">ओमन यहोवा के महिमा,</para>
  <para style="q2" vid="ISA 35:2">हमर परमेसर के सोभा ला देखहीं।<verse eid="ISA 35:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 35:3" />ढीला हांथमन ला मजबूत करव,</para>
  <para style="q2" vid="ISA 35:3">कमजोर माड़ीमन ला मजबूत करव;<verse eid="ISA 35:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 35:4" />घबरानेवाला मनखेमन ला कहव,</para>
  <para style="q2" vid="ISA 35:4">“मजबूत बनव, झन डरव;</para>
  <para style="q1" vid="ISA 35:4">तुम्हर परमेसर ह आही</para>
  <para style="q2" vid="ISA 35:4">ओह बदला लेय बर आही;</para>
  <para style="q1" vid="ISA 35:4">ईस्वरीय बदला के संग</para>
  <para style="q2" vid="ISA 35:4">ओह तुम्हर उद्धार करे बर आही।”<verse eid="ISA 35:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 35:5" />अंधरामन के आंखी खोले जाही</para>
  <para style="q2" vid="ISA 35:5">अऊ भैंरामन के कान घलो खोले जाही;<verse eid="ISA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 35:6" />तब खोरवा ह हिरन सहीं कूदही</para>
  <para style="q2" vid="ISA 35:6">अऊ कोंदामन अपन जीभ ले आनंद के मारे जय-जयकार करहीं।</para>
  <para style="q1" vid="ISA 35:6">काबरकि बंजर भुइयां म पानी के सोता फूट निकलही</para>
  <para style="q2" vid="ISA 35:6">अऊ मरू-भुइयां म नदी बोहाय लगही;<verse eid="ISA 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 35:7" />घाम ले बरत भुइयां ह तरिया बन जाही</para>
  <para style="q2" vid="ISA 35:7">अऊ सूखा भुइयां म सोतामन फूटहीं।</para>
  <para style="q1" vid="ISA 35:7">अऊ एक समय जिहां सियारमन रहत रिहिन</para>
  <para style="q2" vid="ISA 35:7">उहां घांस अऊ नरकट अऊ सरकंडा जामही।<verse eid="ISA 35:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 35:8" />अऊ उहां एक राजमार्ग होही;</para>
  <para style="q2" vid="ISA 35:8">येला पबितरता के रद्दा कहे जाही;</para>
  <para style="q2" vid="ISA 35:8">ये रद्दा ह ओमन बर होही, जेमन ओ रद्दा म रेंगथें।</para>
  <para style="q1" vid="ISA 35:8">कोनो असुध जन ओमा ले होके नइं जा सकही;</para>
  <para style="q2" vid="ISA 35:8">दुस्ट मुरूख मनखेमन येमा ले होके नइं जा सकहीं।<verse eid="ISA 35:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 35:9" />उहां कोनो सिंह नइं होही,</para>
  <para style="q2" vid="ISA 35:9">अऊ न ही कोनो हिंसक पसु;</para>
  <para style="q2" vid="ISA 35:9">ये पसुमन उहां नइं मिलहीं।</para>
  <para style="q1" vid="ISA 35:9">पर सिरिप छोंड़ाय गय मन ओमा रेंगहीं,<verse eid="ISA 35:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="ISA 35:10" />अऊ जेमन ला यहोवा ह बचाय हवय, ओमन लहुंटके आहीं।</para>
  <para style="q1" vid="ISA 35:10">ओमन गीत गावत सियोन म आहीं;</para>
  <para style="q2" vid="ISA 35:10">सदाकाल के आनंद ह ओमन के मुड़ के मुकुट होही।</para>
  <para style="q1" vid="ISA 35:10">खुसी अऊ आनंद ले ओमन भर जाहीं,</para>
  <para style="q2" vid="ISA 35:10">अऊ दुख अऊ पीरा के अन्त हो जाही।<verse eid="ISA 35:10" /></para>
  <chapter eid="ISA 35" />
  <chapter number="36" style="c" sid="ISA 36" />
  <para style="s1">सनहेरीब ह यरूसलेम ला धमकाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1" />हिजकियाह राजा के राज के चौदहवां साल म, अस्सूर के राजा सनहेरीब ह यहूदा के जम्मो गढ़वाले सहर ऊपर हमला करिस अऊ ओमन ला अपन अधिकार म कर लीस। <verse eid="ISA 36:1" /><verse number="2" style="v" sid="ISA 36:2" />अस्सूर के राजा ह अपन मैदान के सेनापति ला एक बड़े सेना के संग लाकीस नगर ले यरूसलेम म हिजकियाह राजा के बिरूध भेजिस। जब सेनापति ह ऊपरी तरिया के नहर करा धोबीमन के खेत के सड़क म जाके रूकिस। <verse eid="ISA 36:2" /><verse number="3" style="v" sid="ISA 36:3" />तब हिलकियाह के बेटा एलयाकीम, जऊन ह महल के अधिकारी रिहिस, अऊ सेबना, जऊन ह सचिव रिहिस, अऊ आसाप के बेटा योआह, जऊन ह अभिलेखक रिहिस, ये तीनों झन निकलके ओकर करा गीन।<verse eid="ISA 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4" />मैदान के सेनापति ह ओमन ला कहिस, “हिजकियाह ला बतावव:</para>
  <para style="pm" vid="ISA 36:4">“ ‘महाराजा, अस्सूर के राजा ह ये कहत हे: तोर ये भरोसा के आधार का ए? <verse eid="ISA 36:4" /><verse number="5" style="v" sid="ISA 36:5" />तेंह कहिथस कि तोर करा लड़ई बर नीति अऊ ताकत हवय—पर तेंह सिरिप खोखला बात करथस। काकर ऊपर भरोसा करके, तेंह मोर बिरूध बिदरोह करत हस? <verse eid="ISA 36:5" /><verse number="6" style="v" sid="ISA 36:6" />देख, मेंह जानत हंव कि तेंह मिसर देस ऊपर भरोसा करत हस, ओ एक लउठी के चीरे नरकट ऊपर, जऊन ह ओ मनखे के हांथ म चूभथे, जऊन ह येकर सहारा लेथे। फिरौन, मिसर के राजा ह ओ जम्मो झन बर अइसने ही अय, जेमन ओकर ऊपर भरोसा करथें। <verse eid="ISA 36:6" /><verse number="7" style="v" sid="ISA 36:7" />पर कहूं तें मोला ये कहिथस, “हमर भरोसा यहोवा, हमर परमेसर ऊपर हवय”—का येह ओ नो हय, जेकर ऊंचहा जगह अऊ बेदीमन ला हिजकियाह ह हटाके यहूदा अऊ यरूसलेम के मनखेमन ला कहिस, “ये जरूरी अय कि तुमन ये बेदी के आघू म उपासना करव”?<verse eid="ISA 36:7" /></para>
  <para style="pm">
    <verse number="8" style="v" sid="ISA 36:8" />“ ‘एकरसेति अब आ, अऊ मोर मालिक अस्सूर के राजा के संग मोलभाव कर: मेंह तोला दू हजार घोड़ा दूहूं—यदि तें ओमन बर घुड़सवारमन के परबंध कर सकबे त! <verse eid="ISA 36:8" /><verse number="9" style="v" sid="ISA 36:9" />हालाकि तेंह रथ अऊ घुड़सवारमन<note caller="+" style="f"><char style="fr" closed="false">36:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सारथीमन</char></note> बर मिसर देस ऊपर भरोसा करत हस, पर मोर मालिक के छोटे ले छोटे अधिकारी ला घलो कइसे भगा सकत हस? <verse eid="ISA 36:9" /><verse number="10" style="v" sid="ISA 36:10" />का मेंह यहोवा के बिगर कहे ये देस ऊपर हमला करेंव अऊ येला नास करे बर आय हवंव? यहोवा ह खुद मोला कहे हवय कि ये देस ऊपर हमला कर अऊ येला नास कर दे।’ ”<verse eid="ISA 36:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11" />तब एलयाकीम, सेबना अऊ योआह, मैदान के सेनापति ला कहिन, “अपन सेवकमन ले अरामिक भासा म गोठिया, काबरकि हमन ये भासा ला समझथन। भीथी ऊपर बईठे मनखेमन के सुनत म हमर ले इबरानी म झन गोठिया।”<verse eid="ISA 36:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12" />पर सेनापति ह जबाब दीस, “का मोर मालिक ह मोला सिरिप तुम्हर मालिक अऊ तुमन ला ये बात कहे बर पठोय हवय, अऊ दीवार ऊपर बईठे ओ मनखेमन ला नइं, जेमन ला तुम्हर सहीं, अपन खुद के मल ला खाना अऊ अपन खुद के पेसाब ला पीना पड़ही।”<verse eid="ISA 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13" />तब सेनापति ह ठाढ़ होईस अऊ इबरानी म जोर से कहिस, “महाराजा अस्सूर के राजा के बात ला सुनव! <verse eid="ISA 36:13" /><verse number="14" style="v" sid="ISA 36:14" />राजा ह ये कहत हे, हिजकियाह तुमन ला धोखा झन देवय। ओह तुमन ला छुड़ा नइं सकय। <verse eid="ISA 36:14" /><verse number="15" style="v" sid="ISA 36:15" />हिजकियाह के मनाय म झन आवव, जब ओह यहोवा ऊपर भरोसा रखे बर ये कहिथे, ‘खचित यहोवा ह हमन ला छुड़ाही; ये सहर<note caller="+" style="f"><char style="fr" closed="false">36:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरूसलेम सहर</char></note> ला अस्सूर के राजा के हांथ म नइं दिये जावय।’<verse eid="ISA 36:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 36:16" />“हिजकियाह के बात ला झन सुनव। अस्सूर के राजा ह ये कहिथे: मोर संग मेल-मिलाप करव अऊ बाहिर निकलके मोर करा आवव। तब तुमन म ले हर एक ह अपन खुद के अंगूर के नार के अऊ अंजीर के रूख के फर खाही अऊ अपन खुद के कुंड के पानी पीही, <verse eid="ISA 36:16" /><verse number="17" style="v" sid="ISA 36:17" />जब तक कि मेंह आके तुमन ला एक अइसन देस म नइं ले जाहूं, जऊन ह तुम्हर खुद के सहीं होही—अनाज अऊ नवां अंगूर के मंद के देस, रोटी अऊ अंगूर के बारीमन के देस।<verse eid="ISA 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 36:18" />“हिजकियाह ह तुमन ला बहकावन झन पावय, जब ओह कहिथे, ‘यहोवा ह हमन ला छुड़ाही।’ का अऊ जातिमन के देवतामन कभू अपन देसमन ला अस्सूर के राजा के हांथ ले छुड़ाय हवंय? <verse eid="ISA 36:18" /><verse number="19" style="v" sid="ISA 36:19" />हमात अऊ अरपाद के देवतामन कहां हवंय? सपरवैम के देवतामन कहां हवंय? का ओमन सामरिया ला मोर हांथ ले बचाय हवंय? <verse eid="ISA 36:19" /><verse number="20" style="v" sid="ISA 36:20" />ये देसमन के जम्मो देवतामन ले कोन ह अपन देस ला मोर हांथ ले बचाय हवय? तब यहोवा ह कइसे यरूसलेम ला मोर हांथ ले छुड़ा सकथे?”<verse eid="ISA 36:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21" />पर मनखेमन चुपेचाप रिहिन अऊ जबाब म कुछू नइं कहिन, काबरकि राजा ह ये हुकूम दे रिहिस, “ओला जबाब झन दव।”<verse eid="ISA 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22" />तब हिलकियाह के बेटा एलयाकीम, जऊन ह महल के अधिकारी रिहिस; सेबना जऊन ह सचिव रिहिस; अऊ आसाप के बेटा योआह, जऊन ह इतिहास के अभिलेखक रिहिस; ये तीनों अपन फटे कपड़ा के संग हिजकियाह मेर गीन, अऊ ओला मैदान के सेनापति के कहे बात ला बताईन।<verse eid="ISA 36:22" /></para>
  <chapter eid="ISA 36" />
  <chapter number="37" style="c" sid="ISA 37" />
  <para style="s1">यरूसलेम के छुड़ौती के अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1" />जब हिजकियाह राजा ह ये बात ला सुनिस, त ओह दुख म अपन ओनहा ला चीरिस अऊ बोरा के ओनहा पहिरिस अऊ यहोवा के मंदिर म गीस। <verse eid="ISA 37:1" /><verse number="2" style="v" sid="ISA 37:2" />ओह महल के अधिकारी एलयाकीम, सचिव सेबना अऊ अगुवा पुरोहितमन ला, जेमन बोरा के कपड़ा पहिरे रहंय, येमन ला आमोस के बेटा यसायाह अगमजानी करा पठोईस। <verse eid="ISA 37:2" /><verse number="3" style="v" sid="ISA 37:3" />ओमन ओला कहिन, “हिजकियाह ह ये कहत हे: ये दिन ह दुख अऊ फटकार अऊ निन्दा के दिन अय, येह अइसने अय, मानो लइकामन के जनमे के समय आ गे, पर दाई म ओमन ला जनम देय के ताकत नइं ए। <verse eid="ISA 37:3" /><verse number="4" style="v" sid="ISA 37:4" />ये हो सकत हे कि यहोवा तोर परमेसर ह ओ मैदान के सेनापति के बात ला सुनय, जेला ओकर मालिक, अस्सूर के राजा ह जीयत परमेसर के हंसी उड़ाय बर पठोय हवय, अऊ ये कि यहोवा तोर परमेसर ह ओकर बात ला सुनके ओला डांटय। एकरसेति ओ बांचे भाग बर पराथना कर, जेमन अभी जीयत हें।”<verse eid="ISA 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5" />जब हिजकियाह राजा के अधिकारीमन यसायाह करा आईन। <verse eid="ISA 37:5" /><verse number="6" style="v" sid="ISA 37:6" />तब यसायाह ह ओमन ला कहिस, “अपन मालिक ला बतावव, ‘यहोवा ह ये कहत हे: ओ बात ले झन डर, जेला तेंह सुने हस—ओ बात, जेला अस्सूर के राजा के सेवकमन मोर निन्दा करत कहे हवंय। <verse eid="ISA 37:6" /><verse number="7" style="v" sid="ISA 37:7" />सुन! जब ओह कोनो बिसेस खबर सुनही, त मेंह अइसे करहूं कि ओह अपन खुद के देस ला लहुंट जाही, अऊ उहां मेंह ओला तलवार ले मरवा दूहूं।’ ”<verse eid="ISA 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8" />जब मैदान के सेनापति ह ये सुनिस कि अस्सूर के राजा ह लाकीस नगर ला छोंड़के चले गे हवय, त ओह लहुंट गीस अऊ देखिस कि राजा ह लिबना के बिरूध लड़त हवय।<verse eid="ISA 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9" />सनहेरीब ला ये खबर मिलिस कि कूस के राजा तिरहाका ह ओकर बिरूध लड़ई करे बर सेना लेके आवत हे। जब ओह ये बात सुनिस, त ओह हिजकियाह मेर संदेसियामन के हांथ म ये खबर पठोईस: <verse eid="ISA 37:9" /><verse number="10" style="v" sid="ISA 37:10" />“यहूदा के राजा हिजकियाह ला कहव: तोर परमेसर जेकर ऊपर तेंह भरोसा करथस, ओह तोला ये कहिके धोखा झन देवय, ‘यरूसलेम ला अस्सूर के राजा के हांथ म नइं दिये जावय।’ <verse eid="ISA 37:10" /><verse number="11" style="v" sid="ISA 37:11" />तेंह ये जरूर सुने होबे कि अस्सूर के राजामन जम्मो देसमन ला पूरा नास कर दे हवंय। त का तेंह बच सकबे? <verse eid="ISA 37:11" /><verse number="12" style="v" sid="ISA 37:12" />मोर ले पहिले के राजामन गोजान, हारान, रेसेप सहरमन के देवता अऊ तेल-अस्सार म रहइया एदेन के मनखेमन ला नास करिन, त का ओ जाति के देवतामन ओमन ला बचा सकिन? <verse eid="ISA 37:12" /><verse number="13" style="v" sid="ISA 37:13" />हमात के राजा या अरपाद के राजा कहां हवंय? लायर, सपरवैम, हेना अऊ इव्वा के राजामन कहां हवंय?”<verse eid="ISA 37:13" /></para>
  <para style="s1">मंदिर म हिजकियाह के पराथना</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14" />हिजकियाह ला संदेसियामन ले चिट्ठी मिलिस अऊ ओह ओला पढ़िस। तब ओह यहोवा के मंदिर म गीस अऊ ओ चिट्ठी ला यहोवा के आघू म बगरा दीस, <verse eid="ISA 37:14" /><verse number="15" style="v" sid="ISA 37:15" />अऊ हिजकियाह ह यहोवा ले पराथना करिस, <verse eid="ISA 37:15" /><verse number="16" style="v" sid="ISA 37:16" />“हे सर्वसक्तिमान यहोवा, इसरायल के परमेसर, तेंह करूबमन के बीच म बिराजे हस, सिरिप तें ही धरती के जम्मो राजमन के ऊपर परमेसर अस। तें ही स्वरग अऊ धरती ला बनाय हस। <verse eid="ISA 37:16" /><verse number="17" style="v" sid="ISA 37:17" />हे यहोवा, कान लगाके सुन; हे यहोवा, अपन आंखी ला खोलके देख; सनहेरीब के ओ जम्मो बात ला सुन, जेला ओह जीयत परमेसर के हंसी उड़ाय बर लिखके भेजे हवय।<verse eid="ISA 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 37:18" />“हे यहोवा, ये बात सच ए कि अस्सूर के राजामन ये जम्मो मनखे अऊ ओमन के देसमन ला उजाड़ दे हवंय। <verse eid="ISA 37:18" /><verse number="19" style="v" sid="ISA 37:19" />अऊ ओमन के देवतामन ला आगी म फटिकके नास कर दे हवंय, काबरकि ओमन देवता नइं रिहिन; पर मनखेमन के हांथ के बनाय सिरिप लकरी अऊ पथरा ही रिहिन। <verse eid="ISA 37:19" /><verse number="20" style="v" sid="ISA 37:20" />अब हे यहोवा, हमर परमेसर, हमन ला ओकर हांथ ले बचा, ताकि धरती के जम्मो राजमन जानंय कि सिरिप तें यहोवा ही परमेसर अस।”<verse eid="ISA 37:20" /></para>
  <para style="s1">सनहेरीब के पतन</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21" />तब आमोस के बेटा यसायाह ह हिजकियाह करा ये खबर पठोईस: “यहोवा इसरायल के परमेसर ह ये कहत हे: काबरकि तेंह अस्सूर के राजा सनहेरीब के बारे म मोर ले पराथना करे हस, <verse eid="ISA 37:21" /><verse number="22" style="v" sid="ISA 37:22" />यहोवा ह ओकर बिरूध म ये बात कहे हवय:</para>
  <para style="q1" vid="ISA 37:22">“कुंवारी बेटी सियोन ह</para>
  <para style="q2" vid="ISA 37:22">तोला तुछ समझथे अऊ तोर हंसी उड़ाथे।</para>
  <para style="q1" vid="ISA 37:22">बेटी यरूसलेम ह</para>
  <para style="q2" vid="ISA 37:22">अपन मुड़ हलाथे, जब तेंह भागथस।<verse eid="ISA 37:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 37:23" />तेंह काकर हंसी उड़ाय हस अऊ निन्दा करे हस?</para>
  <para style="q2" vid="ISA 37:23">काकर बिरूध म, तेंह अपन अवाज उठाय हस</para>
  <para style="q1" vid="ISA 37:23">अऊ घमंड ले अपन आंखी उठाय हस?</para>
  <para style="q2" vid="ISA 37:23">इसरायल के पबितर परमेसर के बिरूध!<verse eid="ISA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 37:24" />अपन संदेसियामन के दुवारा</para>
  <para style="q2" vid="ISA 37:24">तेंह परभू के हंसी उड़ाय हस।</para>
  <para style="q1" vid="ISA 37:24">अऊ तेंह कहे हस,</para>
  <para style="q2" vid="ISA 37:24">‘अपन बहुंते रथमन के संग</para>
  <para style="q1" vid="ISA 37:24">मेंह पहाड़मन के ऊंचई म चघे हंव,</para>
  <para style="q2" vid="ISA 37:24">लबानोन के टीप तक।</para>
  <para style="q1" vid="ISA 37:24">मेंह ओकर सबले ऊंच देवदार रूखमन ला</para>
  <para style="q2" vid="ISA 37:24">अऊ सबले बने सनोवर रूखमन ला काट डारे हंव।</para>
  <para style="q1" vid="ISA 37:24">मेंह ओकर सबले दुरगम ऊंचई,</para>
  <para style="q2" vid="ISA 37:24">ओकर जंगल के सबले सुघर भाग म हबर गे हवंव।<verse eid="ISA 37:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 37:25" />मेंह परदेस म कुआं खने हंव</para>
  <para style="q2" vid="ISA 37:25">अऊ उहां पानी पीये हंव।</para>
  <para style="q1" vid="ISA 37:25">अपन गोड़ के तलवा ले</para>
  <para style="q2" vid="ISA 37:25">मेंह मिसर के जम्मो झरना ला सूखा दे हंव।’<verse eid="ISA 37:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 37:26" />“का तेंह नइं सुने?</para>
  <para style="q2" vid="ISA 37:26">बहुंत पहिले मेंह ओला ठहिराय रहेंव।</para>
  <para style="q1" vid="ISA 37:26">बहुंत पहिले ओकर योजना बनाय रहेंव;</para>
  <para style="q2" vid="ISA 37:26">अब मेंह ओला पूरा करत हंव,</para>
  <para style="q1" vid="ISA 37:26">कि तेंह गढ़वाले सहरमन ला</para>
  <para style="q2" vid="ISA 37:26">पथरा के कुढ़ा बना दे।<verse eid="ISA 37:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 37:27" />एकरे बर ओमन के ताकत ह चले गे हवय,</para>
  <para style="q2" vid="ISA 37:27">ओमन डर गे हवंय अऊ ओमन के बेजत्ती होय हवय।</para>
  <para style="q1" vid="ISA 37:27">ओमन खेत के पऊधा सहीं अंय,</para>
  <para style="q1" vid="ISA 37:27">हरियर कोअंर पऊधा के पीका सहीं,</para>
  <para style="q2" vid="ISA 37:27">छानी म उगत कांदी सहीं, जऊन ह बाढ़े के पहिली सूख जाथे।<verse eid="ISA 37:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="ISA 37:28" />“पर मेंह जानत हंव कि तेंह कहां हस</para>
  <para style="q2" vid="ISA 37:28">अऊ तें कब आथस अऊ जाथस</para>
  <para style="q2" vid="ISA 37:28">अऊ कइसे तेंह मोर ऊपर गुस्सा करथस।<verse eid="ISA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 37:29" />काबरकि तें मोर ऊपर गुस्सा करथस</para>
  <para style="q2" vid="ISA 37:29">अऊ तोर घमंड के बात मेंह सुने हवंव,</para>
  <para style="q1" vid="ISA 37:29">एकरसेति मेंह तोर नाक म नकेल डालहूं</para>
  <para style="q2" vid="ISA 37:29">अऊ तोर मुहूं म अपन लगाम लगाहूं,</para>
  <para style="q1" vid="ISA 37:29">अऊ जऊन रसता ले तेंह आय रहे,</para>
  <para style="q2" vid="ISA 37:29">ओही रसता ले तोला लहुंटा दूहूं।<verse eid="ISA 37:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30" />“हे हिजकियाह, तोर बर ये चिनहां होही:</para>
  <para style="q1" vid="ISA 37:30">“ये बछर तेंह ओला खाबे, जऊन ह अपनआप जामही,</para>
  <para style="q2" vid="ISA 37:30">अऊ दूसरा बछर ओला खाबे, जऊन ह ओकर ले पईदा होही</para>
  <para style="q1" vid="ISA 37:30">पर तीसरा बछर तेंह बोबे अऊ फसल लूबे,</para>
  <para style="q2" vid="ISA 37:30">अंगूर के बारी लगाबे अऊ ओकर फर खाबे।<verse eid="ISA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 37:31" />एक बार फेर यहूदा के राज के बांचे भाग ह खाल्हे जरी धरही</para>
  <para style="q2" vid="ISA 37:31">अऊ ऊपर फर लगही।<verse eid="ISA 37:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 37:32" />काबरकि यरूसलेम ले एक बांचे भाग निकलही,</para>
  <para style="q2" vid="ISA 37:32">अऊ सियोन पहाड़ ले बांचे मनखेमन के एक दल आही।</para>
  <para style="q1" vid="ISA 37:32">सर्वसक्तिमान यहोवा के उत्साह ह</para>
  <para style="q2" vid="ISA 37:32">येला पूरा करही।<verse eid="ISA 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33" />“एकरसेति अस्सूर के राजा के बारे म यहोवा ह ये कहिथे:</para>
  <para style="q1" vid="ISA 37:33">“ओह ये सहर म न तो घुसही</para>
  <para style="q2" vid="ISA 37:33">अऊ न ही इहां एको ठन तीर चलाही।</para>
  <para style="q1" vid="ISA 37:33">ओह येकर आघू म न तो ढाल लेके आही</para>
  <para style="q2" vid="ISA 37:33">अऊ न ही येकर बिरूध घेराबंदी के कोनो ढलान बनाही।<verse eid="ISA 37:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 37:34" />जऊन रसता ले ओह आय हवय, ओही रसता ले</para>
  <para style="q2" vid="ISA 37:34">ओह लहुंट जाही; ओह ये सहर म नइं घुसही,”</para>
  <para style="q2" vid="ISA 37:34">यहोवा ह घोसना करत हे।<verse eid="ISA 37:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ISA 37:35" />“मेंह अपन हित अऊ अपन सेवक दाऊद के हित म,</para>
  <para style="q2" vid="ISA 37:35">ये सहर के रकछा करहूं अऊ येला बचाहूं।”<verse eid="ISA 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36" />तब यहोवा के स्वरगदूत ह निकलके गीस अऊ अस्सूरीमन के सिविर म एक लाख पचयासी हजार मनखेमन ला मार डारिस। जब मनखेमन बिहनियां उठिन, त देखिन कि उहां मनखेमन के लास ही लास पड़े हवय! <verse eid="ISA 37:36" /><verse number="37" style="v" sid="ISA 37:37" />एकरसेति अस्सूर के राजा सनहेरीब ह सिविर ला उखानके वापिस चल दीस। ओह नीनवे सहर लहुंटिस अऊ उहां रहे लगिस।<verse eid="ISA 37:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ISA 37:38" />एक दिन, जब ओह अपन देवता निसरोक के मंदिर म उपासना करत रिहिस, त ओकर बेटा अद्रमेलेक अऊ सरेसेर ह ओला तलवार ले मार डारिन अऊ ओमन अरारात देस भाग गीन। अऊ ओकर बेटा एसरहदोन ह ओकर जगह म राजा बनिस।<verse eid="ISA 37:38" /></para>
  <chapter eid="ISA 37" />
  <chapter number="38" style="c" sid="ISA 38" />
  <para style="s1">हिजकियाह के बेमारी</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1" />ओ समय म हिजकियाह ह बेमार हो गीस अऊ मरइयाच रिहिस। तब आमोस के बेटा यसायाह अगमजानी ह ओकर मेर गीस अऊ कहिस, “यहोवा ह ये कहत हे: अपन घर-परिवार ला ठीक कर, काबरकि तेंह मरइयाच हस; तोर बेमारी ह ठीक नइं होवय।”<verse eid="ISA 38:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2" />तब हिजकियाह ह भीथी कोति अपन मुहूं करके यहोवा ले पराथना करिस, <verse eid="ISA 38:2" /><verse number="3" style="v" sid="ISA 38:3" />“हे यहोवा, सुरता कर कि मेंह कइसे सच्चई अऊ पूरा मन लगाके तोर आघू म चलत आय हंव अऊ ओ काम करे हंव, जऊन ह तोर नजर म सही अय।” अऊ हिजकियाह ह फूट-फूटके रोए लगिस।<verse eid="ISA 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4" />तब यहोवा के ये बचन यसायाह करा आईस: <verse eid="ISA 38:4" /><verse number="5" style="v" sid="ISA 38:5" />“जा अऊ हिजकियाह ला कह, ‘यहोवा, तोर पुरखा दाऊद के परमेसर ये कहत हे: मेंह तोर पराथना ला सुने हंव अऊ तोर आंसू ला देखे हंव; मेंह तोर उमर पंदरह बछर अऊ बढ़ा दूहूं। <verse eid="ISA 38:5" /><verse number="6" style="v" sid="ISA 38:6" />अऊ मेंह तोला अऊ ये सहर ला अस्सूर के राजा के हांथ ले छोंड़ाहूं। मेंह ये सहर के रकछा करहूं।<verse eid="ISA 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7" />“ ‘तोर बर यहोवा के ये चिनहां होही कि यहोवा ह अपन कहे बात ला पूरा करही, <verse eid="ISA 38:7" /><verse number="8" style="v" sid="ISA 38:8" />धूप के छइहां, जऊन ह आहाज के सीढ़ी के रसता म ढर गे हवय, मेंह दस कदम पाछू कोति लहुंटा दूहूं।’ ” तब ओ छइहां, जऊन ह ढर गे रिहिस, दस कदम पाछू हट गीस।<verse eid="ISA 38:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9" />यहूदा के राजा हिजकियाह के लेख जऊन ला ओह रोगी होके चंगा होय के बाद लिखिस, ओह ये अय:<verse eid="ISA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 38:10" />मेंह कहेंव, “अपन उमर के उत्तम समय म</para>
  <para style="q2" vid="ISA 38:10">जरूरी अय कि मेंह मिरतू के दुवारमन म ले होके जावंव</para>
  <para style="q2" vid="ISA 38:10">अऊ मोर बाकि उमर ह खतम हो जावय।”<verse eid="ISA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 38:11" />मेंह कहेंव, “मेंह यहोवा ला</para>
  <para style="q2" vid="ISA 38:11">जीयतमन के भुइयां म फेर नइं देखहूं;</para>
  <para style="q1" vid="ISA 38:11">मेंह अपन संगी मनखे ला फेर नइं देखहूं,</para>
  <para style="q2" vid="ISA 38:11">या ओमन संग नइं रहिहूं, जेमन ये संसार म रहिथें।<verse eid="ISA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 38:12" />मोर घर ला चरवाहामन के तम्बू सहीं</para>
  <para style="q2" vid="ISA 38:12">हटाके मोर ले लेय लिये गे हवय।</para>
  <para style="q1" vid="ISA 38:12">एक बुनकर सहीं मेंह अपन जिनगी ला लपेट ले हंव,</para>
  <para style="q2" vid="ISA 38:12">अऊ ओह मोला करघा ले काटके अलग कर दे हवय;</para>
  <para style="q2" vid="ISA 38:12">एकेच दिन म तेंह मोर अन्त कर डारय।<verse eid="ISA 38:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 38:13" />मेंह धीरज धरके बिहान तक इंतजार करेंव,</para>
  <para style="q2" vid="ISA 38:13">पर एक सिंह के सहीं ओह<note caller="+" style="f"><char style="fr" closed="false">38:13 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमेसर</char></note> मोर जम्मो हाड़ा ला टोर दीस;</para>
  <para style="q2" vid="ISA 38:13">एकेच दिन म तेंह मोर अन्त कर डारय।<verse eid="ISA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 38:14" />मेंह सूपाबेनी या तूती चिरई सहीं रोयेंव,</para>
  <para style="q2" vid="ISA 38:14">मेंह बिलाप करइया पंड़की सहीं बिलाप करेंव।</para>
  <para style="q1" vid="ISA 38:14">मोर आंखीमन ऊपर देखत-देखत कमजोर हो गीन।</para>
  <para style="q2" vid="ISA 38:14">हे परभू, मोला धमकाय जावत हे; मोर मदद करे बर आ!”<verse eid="ISA 38:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 38:15" />पर मेंह का कह सकत हंव?</para>
  <para style="q2" vid="ISA 38:15">ओह मोला कहे हवय, अऊ ओह खुद येला करे हवय।</para>
  <para style="q1" vid="ISA 38:15">मेंह मन के ये पीरा के कारन</para>
  <para style="q2" vid="ISA 38:15">जिनगी भर नम्र होके चलहूं।<verse eid="ISA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 38:16" />हे परभू, अइसन चीज के दुवारा मनखेमन जीयत रहिथें;</para>
  <para style="q2" vid="ISA 38:16">अऊ मोर आतमा ला घलो ओमन म जिनगी मिलथे।</para>
  <para style="q1" vid="ISA 38:16">तें मोला चंगा करय</para>
  <para style="q2" vid="ISA 38:16">अऊ मोला जीयत रखय।<verse eid="ISA 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 38:17" />खचित येह मोर फायदा बर रिहिस</para>
  <para style="q2" vid="ISA 38:17">कि मेंह अइसन पीरा भोगंय।</para>
  <para style="q1" vid="ISA 38:17">तेंह मोला मया करके</para>
  <para style="q2" vid="ISA 38:17">बिनास के खंचवा ले बचाय हवस;</para>
  <para style="q1" vid="ISA 38:17">मोर सब पाप ला तेंह</para>
  <para style="q2" vid="ISA 38:17">अपन पीठ के पाछू म कर दे हवस।<verse eid="ISA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 38:18" />काबरकि कबर ह तोर परसंसा नइं कर सकय,</para>
  <para style="q2" vid="ISA 38:18">न ही मऊत ह तोर इस्तुति कर सकय;</para>
  <para style="q1" vid="ISA 38:18">जेमन खाल्हे कबर म परे हवंय</para>
  <para style="q2" vid="ISA 38:18">ओमन तोर बिसवासयोग्यता के आसा नइं कर सकंय।<verse eid="ISA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 38:19" />जीयत मनखे, जीयत मनखे—ओमन तोर परसंसा करथें,</para>
  <para style="q2" vid="ISA 38:19">जइसन मेंह आज करत हंव;</para>
  <para style="q1" vid="ISA 38:19">दाई-ददामन अपन लइकामन ला</para>
  <para style="q2" vid="ISA 38:19">तोर बिसवासयोग्यता के बारे बताथें।<verse eid="ISA 38:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 38:20" />यहोवा ह मोर उद्धार करही,</para>
  <para style="q2" vid="ISA 38:20">अऊ हमन जिनगी भर</para>
  <para style="q1" vid="ISA 38:20">यहोवा के मंदिर म</para>
  <para style="q2" vid="ISA 38:20">तारवाला बाजा के संग गीत गावत रहिबो।<verse eid="ISA 38:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21" />यसायाह ह कहे रिहिस, “अंजीर के एक लेप बनावव अऊ हिजकियाह के फोड़ा म लगावव, अऊ ओह ठीक हो जाही।”<verse eid="ISA 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22" />हिजकियाह ह पुछे रिहिस, “येकर का चिनहां होही कि मेंह यहोवा के मंदिर म जाहूं?”<verse eid="ISA 38:22" /></para>
  <chapter eid="ISA 38" />
  <chapter number="39" style="c" sid="ISA 39" />
  <para style="s1">बेबिलोन के दूतमन के अवई</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1" />ओ समय बलदान के बेटा बेबिलोन के राजा मरोदक-बलदान ह हिजकियाह करा दूतमन के दुवारा चिट्ठी अऊ उपहार पठोईस, काबरकि ओह ओकर बेमारी अऊ ओकर चंगई के बारे म सुने रिहिस। <verse eid="ISA 39:1" /><verse number="2" style="v" sid="ISA 39:2" />एकर ले हिजकियाह ह खुस होके दूतमन के सुवागत करिस अऊ ओमन ला अपन भंडारघर के चीजमन ला देखाईस—सोन, चांदी, मसाला, उत्तम किसम के जैतून तेल—अपन पूरा हथियार-घर अऊ अपन खजाना म रखे जम्मो चीज ला देखाईस। उहां ओकर महल या ओकर जम्मो राज म अइसन कोनो चीज नइं बांचिस, जेला हिजकियाह ह ओमन ला नइं देखाय होही।<verse eid="ISA 39:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3" />तब यसायाह अगमजानी ह हिजकियाह राजा मेर जाके पुछिस, “ओ आदमीमन का कहिन अऊ ओमन कहां ले आय रिहिन?” हिजकियाह ह जबाब दीस, “ओमन एक दूरिहा के देस, बेबिलोन ले मोर मेर आय रिहिन।”<verse eid="ISA 39:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4" />अगमजानी ह पुछिस, “ओमन तोर महल म का देखिन?”</para>
  <para style="p" vid="ISA 39:4">हिजकियाह ह कहिस, “ओमन मोर महल के हर चीज ला देखिन, मोर खजाना म अइसन कोनो चीज नइं ए, जेला मेंह ओमन ला नइं देखाय होहूं।”<verse eid="ISA 39:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5" />तब यसायाह ह हिजकियाह ला कहिस, “सर्वसक्तिमान यहोवा के बचन ला सुन: <verse eid="ISA 39:5" /><verse number="6" style="v" sid="ISA 39:6" />अइसन समय जरूर आही, जब तोर महल के हर एक चीज, अऊ ओ जम्मो चीज, जेला तोर पुरखामन के दुवारा आज तक इकट्ठा करे गे हवय, ओ जम्मो ला बेबिलोन ले जाय जाही। कुछू भी चीज नइं बांचही, यहोवा ह कहत हे। <verse eid="ISA 39:6" /><verse number="7" style="v" sid="ISA 39:7" />अऊ तोर कुछू संतानमन ला, तोर खुद के मांस अऊ लहू, जऊन मन तोर ले पईदा होहीं, ओमन ला घलो ले जाय जाही, अऊ ओमन बेबिलोन के राजा के महल म खोजा बन जाहीं।”<verse eid="ISA 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8" />हिजकियाह ह जबाब दीस, “यहोवा के जऊन बात तेंह कहे हस, ओह बने बात ए।” काबरकि ओह सोचिस, “मोर जिनगी भर सांति अऊ सुरकछा बने रहिही।”<verse eid="ISA 39:8" /></para>
  <chapter eid="ISA 39" />
  <chapter number="40" style="c" sid="ISA 40" />
  <para style="s1">परमेसर के मनखेमन बर सांति</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 40:1" />तुम्हर परमेसर ह कहिथे,</para>
  <para style="q2" vid="ISA 40:1">मोर मनखेमन ला सांति देवव, सांति!<verse eid="ISA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 40:2" />यरूसलेम ला सांत मन से कहव,</para>
  <para style="q2" vid="ISA 40:2">अऊ घोसना करत ओला कहव</para>
  <para style="q1" vid="ISA 40:2">कि ओकर कठिन सेवा ह पूरा होईस,</para>
  <para style="q2" vid="ISA 40:2">ओकर पाप के दाम दे दिये गे हवय,</para>
  <para style="q1" vid="ISA 40:2">यहोवा के हांथ ले ओह अपन सब पाप के</para>
  <para style="q2" vid="ISA 40:2">दू गुना दंड पा गे हवय।<verse eid="ISA 40:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 40:3" />एक झन के बलाय के अवाज आवत हे:</para>
  <para style="q1" vid="ISA 40:3">“सुनसान जगह म</para>
  <para style="q2" vid="ISA 40:3">यहोवा बर डहार तियार करव;</para>
  <para style="q1" vid="ISA 40:3">हमर परमेसर बर मरू-भुइयां म</para>
  <para style="q2" vid="ISA 40:3">एक राजमार्ग ला सीधा करव।<verse eid="ISA 40:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 40:4" />हर एक घाटी ला पाट दिये जाही,</para>
  <para style="q2" vid="ISA 40:4">अऊ हर एक पहाड़ अऊ पहाड़ी ला नीचे करे जाही;</para>
  <para style="q1" vid="ISA 40:4">उबड़-खाबड़ भुइयां ह समतल होही,</para>
  <para style="q2" vid="ISA 40:4">अऊ ऊंच-नीच जगहमन चौरस हो जाहीं।<verse eid="ISA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 40:5" />तब यहोवा के महिमा ह परगट होही,</para>
  <para style="q2" vid="ISA 40:5">अऊ जम्मो मनखेमन येला एक संग देखहीं।</para>
  <para style="q1" vid="ISA 40:5">काबरकि यहोवा के मुहूं ले ये बात निकले हवय।”<verse eid="ISA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 40:6" />एक अवाज ह कहिथे, “चिचियाके कह!”</para>
  <para style="q2" vid="ISA 40:6">अऊ मेंह कहेंव, “मेंह चिचियाके का कहंव?”</para>
  <para style="b" vid="ISA 40:6" />
  <para style="q1" vid="ISA 40:6">“जम्मो मनखेमन कांदी के सहीं अंय,</para>
  <para style="q2" vid="ISA 40:6">अऊ ओमन के जम्मो बिसवासयोग्यता ह मैदान के फूल सहीं अंय।<verse eid="ISA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 40:7" />कांदी ह मुरझा जाथे अऊ फूलमन झर जाथें,</para>
  <para style="q2" vid="ISA 40:7">जब यहोवा के सांस ह ओमन ऊपर चलथे।</para>
  <para style="q2" vid="ISA 40:7">बेसक मनखेमन कांदी अंय।<verse eid="ISA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 40:8" />कांदी ह मुरझा जाथे अऊ फूलमन झर जाथें,</para>
  <para style="q2" vid="ISA 40:8">पर हमर परमेसर के बचन सदाकाल तक बने रहिथे।”<verse eid="ISA 40:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 40:9" />तें, जऊन ह सियोन म सुघर संदेस लाथस,</para>
  <para style="q2" vid="ISA 40:9">एक ठन ऊंचहा पहाड़ ऊपर चढ़ जा।</para>
  <para style="q1" vid="ISA 40:9">तें, जऊन ह यरूसलेम म सुघर संदेस लाथस,</para>
  <para style="q2" vid="ISA 40:9">चिचियाके अपन अवाज ला ऊंचा कर,</para>
  <para style="q1" vid="ISA 40:9">अवाज ला ऊंचा कर, झन डर;</para>
  <para style="q2" vid="ISA 40:9">यहूदा के नगरमन ले कह,</para>
  <para style="q2" vid="ISA 40:9">“इहां तुम्हर परमेसर हवय!”<verse eid="ISA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 40:10" />देखव, सर्वसक्तिमान यहोवा सामर्थ के संग आवत हे,</para>
  <para style="q2" vid="ISA 40:10">अऊ ओह अपन भुजबल ले सासन करथे।</para>
  <para style="q1" vid="ISA 40:10">देखव, ओकर ईनाम ह ओकर मेर हवय,</para>
  <para style="q2" vid="ISA 40:10">अऊ ओकर परतिफल देवइया ह ओकर संग हवय।<verse eid="ISA 40:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 40:11" />ओह एक चरवाहा सहीं अपन झुंड ला चराथे:</para>
  <para style="q2" vid="ISA 40:11">ओह मेढ़ा-पीलामन ला अपन गोद म लेके संकेलथे</para>
  <para style="q1" vid="ISA 40:11">अऊ ओमन ला अपन दिल म लगाके चलथे;</para>
  <para style="q2" vid="ISA 40:11">ओह ओमन ला धीरे-धीरे ले चलथे, जेमन करा पीलामन होथें।<verse eid="ISA 40:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 40:12" />कोन ह अपन हांथ के हथेली ले महासागर के पानी ला नापे हवय,</para>
  <para style="q2" vid="ISA 40:12">या कोन ह अपन हांथ के बित्ता ले अकास ला नापिस?</para>
  <para style="q1" vid="ISA 40:12">कोन ह धरती के धुर्रा ला एक ठन टुकनी म रखे हवय</para>
  <para style="q2" vid="ISA 40:12">या कोन ह पहाड़ अऊ पहाड़ीमन ला</para>
  <para style="q2" vid="ISA 40:12">तराजू म तऊले हवय?<verse eid="ISA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 40:13" />कोन ह यहोवा के आतमा<note caller="+" style="f"><char style="fr" closed="false">40:13 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मन</char></note> के गहरई ला समझ सकत हे,</para>
  <para style="q2" vid="ISA 40:13">या कोन ह यहोवा ला ओकर सलाहकार के रूप म निरदेस दे सकत हे?<verse eid="ISA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 40:14" />यहोवा ह अपन गियान बढ़ाय बर काकर ले सलाह लीस,</para>
  <para style="q2" vid="ISA 40:14">अऊ कोन ह ओला सही रसता बताईस?</para>
  <para style="q1" vid="ISA 40:14">कोन ह ओला गियान के बात सिखाईस,</para>
  <para style="q2" vid="ISA 40:14">या कोन ह ओला समझ के डहार देखाईस?<verse eid="ISA 40:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 40:15" />खचित जाति-जाति के मनखेमन बाल्टी म पानी के एक बूंद सहीं अंय;</para>
  <para style="q2" vid="ISA 40:15">ओमन तराजू म के धुर्रा सहीं अंय;</para>
  <para style="q2" vid="ISA 40:15">यहोवा ह द्वीपमन ला धुर्रा के कन सहीं उठाथे।<verse eid="ISA 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 40:16" />लबानोन के रूखमन बेदी के आगी बर परयाप्त नो हंय,</para>
  <para style="q2" vid="ISA 40:16">अऊ न ही ओमा के पसुमन होम-बलिदान बर परयाप्त होहीं।<verse eid="ISA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 40:17" />जम्मो जाति के मनखेमन ओकर आघू म कुछू नो हंय;</para>
  <para style="q2" vid="ISA 40:17">ओमन ओकर नजर म बेकार समझे जाथें</para>
  <para style="q2" vid="ISA 40:17">अऊ ओमन कुछू घलो नो हंय।<verse eid="ISA 40:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 40:18" />तब तुमन परमेसर के तुलना काकर संग करहू?</para>
  <para style="q2" vid="ISA 40:18">या ओकर का रूप तुमन बताहू?<verse eid="ISA 40:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 40:19" />जहां तक एक मूरती के बात ए, एक मूरतीकार ह येला ढालके बनाथे,</para>
  <para style="q2" vid="ISA 40:19">अऊ सुनार ह ओला सोन ले मढ़थे</para>
  <para style="q2" vid="ISA 40:19">अऊ ओकर बर चांदी के संकली गढ़के बनाथे।<verse eid="ISA 40:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 40:20" />गरीब मनखे, जऊन ह अइसन भेंट नइं चघा सकय,</para>
  <para style="q2" vid="ISA 40:20">ओह अइसन रूख ला चुनथे, जऊन ह नइं सरय;</para>
  <para style="q1" vid="ISA 40:20">ओमन एक कुसल कारीगर खोजथें</para>
  <para style="q2" vid="ISA 40:20">ताकि ओह मूरती ला अइसन स्थिर करय कि ओह झन हालय।<verse eid="ISA 40:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 40:21" />का तुमन नइं जानव?</para>
  <para style="q2" vid="ISA 40:21">का तुमन नइं सुने हव?</para>
  <para style="q1" vid="ISA 40:21">का तुमन ला सुरू ले ये नइं बताय गे हवय?</para>
  <para style="q2" vid="ISA 40:21">का तुमन धरती के नीव रखे के समय ले ही नइं समझे हव?<verse eid="ISA 40:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 40:22" />येह ओ अय, जऊन ह धरती के घेरा के ऊपर बिराजमान होथे,</para>
  <para style="q2" vid="ISA 40:22">अऊ धरती के मनखेमन टिड्डी के सहीं अंय।</para>
  <para style="q1" vid="ISA 40:22">ओह अकास ला तम्बू के सहीं बगराथे,</para>
  <para style="q2" vid="ISA 40:22">अऊ ओमन ला रहे के एक तम्बू सहीं तानथे।<verse eid="ISA 40:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 40:23" />ओह हाकिममन ला तुछ कर देथे</para>
  <para style="q2" vid="ISA 40:23">अऊ धरती के अधिकारीमन ला बेकार बना देथे।<verse eid="ISA 40:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 40:24" />ओमन ला रोपे जावत ही,</para>
  <para style="q2" vid="ISA 40:24">ओमन ला बोये जावत ही,</para>
  <para style="q2" vid="ISA 40:24">भुइयां म ओमन के जरी धरत ही,</para>
  <para style="q1" vid="ISA 40:24">ओह ओमन ऊपर हवा चलाथे अऊ ओमन सूखा जाथें,</para>
  <para style="q2" vid="ISA 40:24">अऊ आंधी ह ओमन ला भूंसा सहीं उड़ियाके ले जाथे।<verse eid="ISA 40:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="ISA 40:25" />“तुमन काकर संग मोर तुलना करहू?</para>
  <para style="q2" vid="ISA 40:25">या कोन ह मोर बरोबर हवय?” पबितर परमेसर ह कहिथे।<verse eid="ISA 40:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 40:26" />अपन आंखी उठाके अकास कोति देखव:</para>
  <para style="q2" vid="ISA 40:26">ये जम्मो ला कोन ह सिरजिस?</para>
  <para style="q1" vid="ISA 40:26">ओह अकास-मंडल ला एक के बाद एक बाहिर लानथे</para>
  <para style="q2" vid="ISA 40:26">अऊ ओमा के हर एक ला नांव लेके बलाथे।</para>
  <para style="q1" vid="ISA 40:26">ओकर बड़े सक्ति अऊ ताकत के कारन</para>
  <para style="q2" vid="ISA 40:26">ओमा के एको ठन घलो नइं छूटय।<verse eid="ISA 40:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="ISA 40:27" />हे याकूब, तेंह काबर सिकायत करथस?</para>
  <para style="q2" vid="ISA 40:27">हे इसरायल, तेंह काबर बोलथस,</para>
  <para style="q1" vid="ISA 40:27">“मोर डहार ह यहोवा ले लुकाय हवय;</para>
  <para style="q2" vid="ISA 40:27">मोर मामला ऊपर परमेसर ह धियान नइं देवत हे?”<verse eid="ISA 40:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 40:28" />का तुमन नइं जानव?</para>
  <para style="q2" vid="ISA 40:28">का तुमन नइं सुने हव?</para>
  <para style="q1" vid="ISA 40:28">यहोवा ह अनंतकाल के परमेसर,</para>
  <para style="q2" vid="ISA 40:28">अऊ धरती के सिरजनहार अय।</para>
  <para style="q1" vid="ISA 40:28">ओह न तो थकय न ही ओला उबासी आवय,</para>
  <para style="q2" vid="ISA 40:28">ओकर समझ के बात ला कोनो नइं जान सकंय।<verse eid="ISA 40:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 40:29" />ओह थके मनखे ला बल देथे</para>
  <para style="q2" vid="ISA 40:29">अऊ कमजोर मनखेमन के सक्ति ला बढ़ाथे।<verse eid="ISA 40:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 40:30" />जवानमन तो थकथें अऊ ओमन ला उबासी आथे,</para>
  <para style="q2" vid="ISA 40:30">अऊ जवान मनखेमन लड़खड़ाथें अऊ गिर जाथें;<verse eid="ISA 40:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 40:31" />पर जेमन यहोवा ऊपर आसा रखथें</para>
  <para style="q2" vid="ISA 40:31">ओमन नवां बल पावत जाहीं,</para>
  <para style="q1" vid="ISA 40:31">ओमन गिधवामन सहीं उड़हीं,</para>
  <para style="q2" vid="ISA 40:31">ओमन दऊड़हीं अऊ नइं थकहीं,</para>
  <para style="q2" vid="ISA 40:31">ओमन रेंगहीं अऊ नइं हांफहीं।<verse eid="ISA 40:31" /></para>
  <chapter eid="ISA 40" />
  <chapter number="41" style="c" sid="ISA 41" />
  <para style="s1">इसरायल के सहायक</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 41:1" />“हे द्वीपमन, मोर आघू म चुप रहव!</para>
  <para style="q2" vid="ISA 41:1">देस-देस के मनखेमन नवां बल पावंय!</para>
  <para style="q1" vid="ISA 41:1">ओमन आघू म आके बोलंय;</para>
  <para style="q2" vid="ISA 41:1">आवव, नियाय के जगह म एक संग जूरन।<verse eid="ISA 41:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 41:2" />“कोन ह पूरब दिग ले एक झन ला उभारे हे,</para>
  <para style="q2" vid="ISA 41:2">अऊ धरमीपन म ओला अपन सेवा बर बलाय हे?</para>
  <para style="q1" vid="ISA 41:2">ओह जातिमन ला ओकर हांथ म कर देथे</para>
  <para style="q2" vid="ISA 41:2">अऊ राजामन ला ओकर अधीन कर देथे।</para>
  <para style="q1" vid="ISA 41:2">ओह अपन तलवार ले ओमन ला धुर्रा,</para>
  <para style="q2" vid="ISA 41:2">अऊ अपन धनुस ले उड़ियाय भूंसा सहीं कर देथे।<verse eid="ISA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 41:3" />ओह ओमन के पीछा करथे अऊ बिगर हानि के,</para>
  <para style="q2" vid="ISA 41:3">ओह एक अइसन रसता म आघू बढ़थे, जेमा ओह पहिले कभू नइं गे रिहिस।<verse eid="ISA 41:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 41:4" />कोन ह ये काम करे हवय अऊ येला इहां तक लाने हवय</para>
  <para style="q2" vid="ISA 41:4">अऊ सुरू ले पीढ़ी-पीढ़ी के मनखेमन ला बलात आय हवय?</para>
  <para style="q1" vid="ISA 41:4">में, यहोवा—जऊन ह ओमन के सबले पहिली के संग</para>
  <para style="q2" vid="ISA 41:4">अऊ आखिरी के संग हंव—में ओही अंव।”<verse eid="ISA 41:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 41:5" />द्वीपमन येला देखे हवंय अऊ डरथें;</para>
  <para style="q2" vid="ISA 41:5">धरती के छोरमन कांपथें।</para>
  <para style="q1" vid="ISA 41:5">ओमन लकठा म आथें अऊ आघू म आथें;<verse eid="ISA 41:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 41:6" />ओमन एक-दूसर के सहायता करथें</para>
  <para style="q2" vid="ISA 41:6">अऊ अपन संगीमन ला कहिथें, “मजबूत बनव!”<verse eid="ISA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 41:7" />लोहार ह सुनार ला</para>
  <para style="q2" vid="ISA 41:7">अऊ जऊन ह हथौड़ा ले समतल करथे</para>
  <para style="q2" vid="ISA 41:7">ओह लोहा ऊपर हथौड़ा मरइया ला उत्साहित करथे।</para>
  <para style="q1" vid="ISA 41:7">जोड़नेवाला एक झन ह कहिथे, “येह बढ़िया हे।”</para>
  <para style="q2" vid="ISA 41:7">आने ह मूरती म खीला ठोंकथे ताकि येह झन गिरय।<verse eid="ISA 41:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 41:8" />“पर हे मोर सेवक, इसरायल,</para>
  <para style="q2" vid="ISA 41:8">हे मोर चुने गय, याकूब,</para>
  <para style="q2" vid="ISA 41:8">हे मोर संगी अब्राहम के संतानमन,<verse eid="ISA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 41:9" />मेंह तोला धरती के छोर ले लेंव,</para>
  <para style="q2" vid="ISA 41:9">मेंह तोला धरती के सबले दूरिहा जगहमन ले बलांय।</para>
  <para style="q1" vid="ISA 41:9">मेंह कहेंव, ‘तेंह मोर सेवक अस’;</para>
  <para style="q2" vid="ISA 41:9">मेंह तोला चुने हंव अऊ तोला छोंड़े नइं हंव।<verse eid="ISA 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 41:10" />झन डर, काबरकि में तोर संग हवंव;</para>
  <para style="q2" vid="ISA 41:10">भयभीत झन हो, काबरकि में तोर परमेसर अंव।</para>
  <para style="q1" vid="ISA 41:10">में तोला मजबूत करहूं अऊ तोर मदद करहूं;</para>
  <para style="q2" vid="ISA 41:10">अपन धरमी जेवनी हांथ ले में तोला संभाले रहिहूं।<verse eid="ISA 41:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 41:11" />“देख, ओ जम्मो जेमन तोर ले गुस्सा होथें</para>
  <para style="q2" vid="ISA 41:11">ओमन जरूर लज्जित अऊ कलंकित होहीं;</para>
  <para style="q1" vid="ISA 41:11">जेमन तोर बिरोध करथें</para>
  <para style="q2" vid="ISA 41:11">ओमन बेकार अऊ नास हो जाहीं।<verse eid="ISA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 41:12" />तेंह अपन बईरीमन ला खोजबे घलो</para>
  <para style="q2" vid="ISA 41:12">पर ओमन तोला नइं मिलहीं।</para>
  <para style="q1" vid="ISA 41:12">जेमन तोर ले लड़ई करथें</para>
  <para style="q2" vid="ISA 41:12">ओमन नास होके मेटा जाहीं।<verse eid="ISA 41:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 41:13" />काबरकि में यहोवा तोर परमेसर अंव</para>
  <para style="q2" vid="ISA 41:13">जऊन ह तोर जेवनी हांथ ला धरथे</para>
  <para style="q1" vid="ISA 41:13">अऊ तोला कहिथे, झन डर;</para>
  <para style="q2" vid="ISA 41:13">में तोर सहायता करहूं।<verse eid="ISA 41:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 41:14" />हे कीरा सहीं याकूब, झन डर,</para>
  <para style="q2" vid="ISA 41:14">हे छोटकन इसरायल, झन डर,</para>
  <para style="q1" vid="ISA 41:14">काबरकि में खुद तोर मदद करहूं,” यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="ISA 41:14">तोर छुड़इया, इसरायल के पबितर परमेसर।<verse eid="ISA 41:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 41:15" />देख, मेंह तोला बहुंत दांतमन के संग नवां</para>
  <para style="q2" vid="ISA 41:15">अऊ तेज कुटनेवाला एक बेलन बनाहूं।</para>
  <para style="q1" vid="ISA 41:15">तेंह पहाड़मन ला कुटबे अऊ ओमन ला चूर-चूर कर देबे,</para>
  <para style="q2" vid="ISA 41:15">अऊ पहाड़ीमन ला तें भूंसा सहीं कर देबे।<verse eid="ISA 41:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 41:16" />तें ओमन ला फटकबे, अऊ हवा ओमन ला उड़ियाके ले जाही,</para>
  <para style="q2" vid="ISA 41:16">अऊ आंधी ओमन ला तितिर-बितिर कर दीही।</para>
  <para style="q1" vid="ISA 41:16">पर तें यहोवा म आनंदित होबे</para>
  <para style="q2" vid="ISA 41:16">अऊ इसरायल के पबितर परमेसर म बड़ई मारबे।<verse eid="ISA 41:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 41:17" />“गरीब अऊ जरूरतमंद मनखेमन पानी के खोज करथें,</para>
  <para style="q2" vid="ISA 41:17">पर पानी कहीं नइं मिलय,</para>
  <para style="q2" vid="ISA 41:17">ओमन के जीभ ह पीयास के मारे सूखा जाथे।</para>
  <para style="q1" vid="ISA 41:17">पर में यहोवा ह ओमन ला जबाब दूहूं;</para>
  <para style="q2" vid="ISA 41:17">में, इसरायल के परमेसर ह ओमन ला छोंड़ नइं देवंव।<verse eid="ISA 41:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 41:18" />में सूखा पहाड़ीमन ले नदीमन ला</para>
  <para style="q2" vid="ISA 41:18">अऊ घाटीमन के बीच म सोतामन ला बहा दूहूं।</para>
  <para style="q1" vid="ISA 41:18">मेंह मरू-भुइयां ला तरिया म</para>
  <para style="q2" vid="ISA 41:18">अऊ सूखा भुइयां ला सोतामन म बदल दूहूं।<verse eid="ISA 41:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 41:19" />मेंह मरू-भुइयां म देवदार, बंबरी, मेंहदी,</para>
  <para style="q2" vid="ISA 41:19">अऊ जैतून उगाहूं।</para>
  <para style="q1" vid="ISA 41:19">मेंह उजाड़ जगह म सनोवर,</para>
  <para style="q2" vid="ISA 41:19">चिनार अऊ गोपेर के रूख इकट्ठा लगाहूं,<verse eid="ISA 41:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 41:20" />ताकि मनखेमन देखंय अऊ जानंय,</para>
  <para style="q2" vid="ISA 41:20">ओमन बिचार करंय अऊ समझंय,</para>
  <para style="q1" vid="ISA 41:20">कि येह यहोवा के हांथ के काम अय,</para>
  <para style="q2" vid="ISA 41:20">अऊ इसरायल के पबितर परमेसर ह येला बनाय हवय।”<verse eid="ISA 41:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 41:21" />“अपन मामला ला लानव,”</para>
  <para style="q2" vid="ISA 41:21">यहोवा ह कहिथे।</para>
  <para style="q1" vid="ISA 41:21">“अपन तर्क ला सामने रखव,”</para>
  <para style="q2" vid="ISA 41:21">याकूब के राजा कहिथे।<verse eid="ISA 41:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 41:22" />“हे मूरतीमन, हमन ला बतावव,</para>
  <para style="q2" vid="ISA 41:22">कि भविस्य म का होवइया हे।</para>
  <para style="q1" vid="ISA 41:22">हमन ला पहिले के चीजमन के बारे बतावव</para>
  <para style="q2" vid="ISA 41:22">ताकि हमन ओमन ऊपर सोच-बिचार करन</para>
  <para style="q2" vid="ISA 41:22">अऊ अंतिम बात ला समझन।</para>
  <para style="q1" vid="ISA 41:22">या होवइया चीजमन के बारे म हमन ला बतावव,<verse eid="ISA 41:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="ISA 41:23" />भविस्य म जऊन कुछू होवइया हे, तेला बतावव,</para>
  <para style="q2" vid="ISA 41:23">तभे हमन जानबो कि तुमन देवता अव।</para>
  <para style="q1" vid="ISA 41:23">भला या बुरा, कुछू घलो करव</para>
  <para style="q2" vid="ISA 41:23">ताकि हमन भयभीत होवन अऊ डर जावन।<verse eid="ISA 41:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 41:24" />पर तुमन कुछू घलो नो हव,</para>
  <para style="q2" vid="ISA 41:24">अऊ तुम्हर काममन एकदम बेकार अंय;</para>
  <para style="q2" vid="ISA 41:24">जऊन ह तुमन ला चाहथे, ओह घिनौना मनखे अय।<verse eid="ISA 41:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="ISA 41:25" />“मेंह उत्तर दिग ले एक झन ला उकसाय हंव, अऊ ओह आवत हे—</para>
  <para style="q2" vid="ISA 41:25">ओह पूरब दिग के अय अऊ मोर नांव के दुहाई देथे।</para>
  <para style="q1" vid="ISA 41:25">जइसन एक कुम्हार ह माटी ला खुंदथे,</para>
  <para style="q2" vid="ISA 41:25">वइसन ही ओह हाकिममन ला खुंदही, मानो ओमन गारा अंय।<verse eid="ISA 41:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 41:26" />कोन ह ये बात ला सुरूआत ले बताईस कि हमन ये जानतेंन,</para>
  <para style="q2" vid="ISA 41:26">या पहिले से कोन ह बताईस कि हमन कहितेंन, ‘ओह सही रिहिस’?</para>
  <para style="q1" vid="ISA 41:26">ये बात कोनो नइं बताईन,</para>
  <para style="q2" vid="ISA 41:26">पहिले से येला कोनो नइं बताईस,</para>
  <para style="q2" vid="ISA 41:26">तोर ले कोनो भी कुछू बात नइं सुनिस।<verse eid="ISA 41:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 41:27" />सबले पहिली मेंह सियोन ला बताएंव, ‘देख, ओमन इहां हवंय!’</para>
  <para style="q2" vid="ISA 41:27">मेंह यरूसलेम ला सुघर संदेस सुनानेवाला एक संदेसिया देंव।<verse eid="ISA 41:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 41:28" />मेंह खोजथंव, पर उहां कोनो नइं एं—</para>
  <para style="q2" vid="ISA 41:28">देवतामन के बीच म कोनो सलाह देवइया नइं एं,</para>
  <para style="q2" vid="ISA 41:28">जब मेंह ओमन ले पुछथंव, त जबाब देवइया कोनो नइं एं।<verse eid="ISA 41:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 41:29" />देखव, ओमन जम्मो के जम्मो गलत अंय!</para>
  <para style="q2" vid="ISA 41:29">ओमन के काम बेकार अंय;</para>
  <para style="q2" vid="ISA 41:29">ओमन के ढारे गय मूरतीमन हवा अऊ गड़बड़ी के अलावा अऊ कुछू नो हंय।<verse eid="ISA 41:29" /></para>
  <chapter eid="ISA 41" />
  <chapter number="42" style="c" sid="ISA 42" />
  <para style="s1">यहोवा के सेवक</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 42:1" />“येह मोर सेवक ए, जऊन ला में संभालथंव,</para>
  <para style="q2" vid="ISA 42:1">मोर चुने हुए जन, जेकर ले मेंह खुस रहिथंव;</para>
  <para style="q1" vid="ISA 42:1">मेंह येकर ऊपर अपन आतमा डालहूं,</para>
  <para style="q2" vid="ISA 42:1">अऊ येह जाति-जाति के मनखेमन बर नियाय लानही।<verse eid="ISA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 42:2" />न ओह चिचियाही अऊ न ऊंचहा सबद म बोलही,</para>
  <para style="q2" vid="ISA 42:2">न ही गलीमन म अपन अवाज ऊंचहा करही।<verse eid="ISA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 42:3" />कुचरे सरकंडा ला न तो ओह टोरही,</para>
  <para style="q2" vid="ISA 42:3">अऊ न ही सुलगत दीया के बाती ला बुताही।</para>
  <para style="q1" vid="ISA 42:3">बिसवासयोग्यता से ओह नियाय करही;<verse eid="ISA 42:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 42:4" />ओह नइं डगमगाही अऊ न ही हिम्मत हारही</para>
  <para style="q1" vid="ISA 42:4">जब तक कि ओह नियाय ला धरती ऊपर स्थापित नइं कर दीही।</para>
  <para style="q2" vid="ISA 42:4">ओकर सिकछा म द्वीपमन के मनखेमन अपन आसा रखहीं।”<verse eid="ISA 42:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 42:5" />परमेसर यहोवा ह ये कहत हे—</para>
  <para style="q1" vid="ISA 42:5">अकासमन ला बनानेवाला, जऊन ह ओमन ला तानथे,</para>
  <para style="q2" vid="ISA 42:5">जऊन ह धरती ला ओकर जम्मो चीजमन के संग फईलाथे,</para>
  <para style="q2" vid="ISA 42:5">जऊन ह येमा के मनखेमन ला सांस</para>
  <para style="q2" vid="ISA 42:5">अऊ येमा चलनेवालामन ला जिनगी देथे:<verse eid="ISA 42:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 42:6" />“में, यहोवा ह तोला धरमीपन म बलाय हंव;</para>
  <para style="q2" vid="ISA 42:6">में तोर हांथ ला धरके तोर रकछा करहूं।</para>
  <para style="q1" vid="ISA 42:6">में तोला संभाले रखहूं अऊ मनखेमन बर</para>
  <para style="q2" vid="ISA 42:6">तोला एक करार</para>
  <para style="q2" vid="ISA 42:6">अऊ आने जाति के मनखेमन बर एक अंजोर ठहिराहूं,<verse eid="ISA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 42:7" />ताकि तें अंधरामन के आंखी ला खोल दे,</para>
  <para style="q2" vid="ISA 42:7">कैदीमन ला कैदखाना ले बाहिर ले आ</para>
  <para style="q2" vid="ISA 42:7">अऊ जेमन अंधियार म बईठे हवंय, ओमन ला काल-कोठरी ले मुक्त कर दे।<verse eid="ISA 42:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 42:8" />“मेंह यहोवा अंव; येह मोर नांव अय!</para>
  <para style="q2" vid="ISA 42:8">मेंह आने ला अपन महिमा नइं देवंव</para>
  <para style="q2" vid="ISA 42:8">या अपन परसंसा मूरतीमन ला नइं देवंव।<verse eid="ISA 42:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 42:9" />देखव, पहिली के चीजमन हो गे हवंय,</para>
  <para style="q2" vid="ISA 42:9">अब नवां चीजमन के में घोसना करत हंव;</para>
  <para style="q1" vid="ISA 42:9">ओमन के होय के पहिली</para>
  <para style="q2" vid="ISA 42:9">मेंह तुमन ला ओमन के घोसना करत हंव।”<verse eid="ISA 42:9" /></para>
  <para style="s1">यहोवा बर इस्तुति के गीत</para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10" />हे समुंदर म चलइया, अऊ ओमा जम्मो रहइयामन,</para>
  <para style="q2" vid="ISA 42:10">हे द्वीपमन, अऊ ओमन म जम्मो रहइयामन,</para>
  <para style="q1" vid="ISA 42:10">यहोवा बर एक नवां गीत गावव,</para>
  <para style="q2" vid="ISA 42:10">अऊ धरती के छोर ले ओकर इस्तुति करव।<verse eid="ISA 42:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11" />सुनसान जगह अऊ ओमा के नगरमन अपन अवाज ऊंच करव;</para>
  <para style="q2" vid="ISA 42:11">केदार के बसे जगहमन आनंदित होवंय।</para>
  <para style="q1" vid="ISA 42:11">सेला सहर के मनखेमन आनंद के मारे गावंय;</para>
  <para style="q2" vid="ISA 42:11">ओमन पहाड़मन के टीपमन ले चिचियावंय।<verse eid="ISA 42:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12" />ओमन यहोवा के महिमा परगट करंय</para>
  <para style="q2" vid="ISA 42:12">अऊ द्वीपमन म ओकर परसंसा करंय।<verse eid="ISA 42:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13" />यहोवा ह एक बिजेता के सहीं निकलही,</para>
  <para style="q2" vid="ISA 42:13">एक योद्धा सहीं ओह अपन उत्साह ला भड़काही;</para>
  <para style="q1" vid="ISA 42:13">ओह चिचियाके लड़ई बर ललकारही</para>
  <para style="q2" vid="ISA 42:13">अऊ अपन बईरीमन ऊपर जयवंत होही।<verse eid="ISA 42:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14" />“बहुंत समय तक मेंह चुप रहेंव,</para>
  <para style="q2" vid="ISA 42:14">मेंह सांत रहेंव अऊ अपनआप ला रोकके रखे रहेंव।</para>
  <para style="q1" vid="ISA 42:14">पर अब, लइका जनमावत माईलोगन सहीं,</para>
  <para style="q2" vid="ISA 42:14">में कलहरत हंव, में जोर-जोर से सांस लेवत हंव अऊ हांफत हंव।<verse eid="ISA 42:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15" />मेंह पहाड़ अऊ पहाड़ीमन ला उजार दूहूं</para>
  <para style="q2" vid="ISA 42:15">अऊ ओमन के सब हरियाली ला सूखा दूहूं;</para>
  <para style="q1" vid="ISA 42:15">में नदीमन ला द्वीप बना दूहूं</para>
  <para style="q2" vid="ISA 42:15">अऊ तरियामन ला सूखा डारहूं।<verse eid="ISA 42:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16" />मेंह अंधरामन ला ओ रसता म ले जाहूं जऊन ला ओमन नइं जानंय,</para>
  <para style="q2" vid="ISA 42:16">अनजान रसता म में ओमन के अगुवई करहूं;</para>
  <para style="q1" vid="ISA 42:16">ओमन के आघू म मेंह अंधियार ला अंजोर कर दूहूं</para>
  <para style="q2" vid="ISA 42:16">अऊ उबड़-खाबड़ जगहमन ला समतल कर दूहूं।</para>
  <para style="q1" vid="ISA 42:16">ये सब काम में करहूं;</para>
  <para style="q2" vid="ISA 42:16">में ओमन ला नइं तियागंव।<verse eid="ISA 42:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17" />पर जेमन मूरतीमन ऊपर भरोसा करथें,</para>
  <para style="q2" vid="ISA 42:17">अऊ मूरतीमन ले कहिथें, ‘तुमन हमर देवता अव,’</para>
  <para style="q2" vid="ISA 42:17">ओमन ला लज्जित होके पाछू लहुंटे बर पड़ही।<verse eid="ISA 42:17" /></para>
  <para style="s1">अंधरा अऊ भैंरा इसरायल</para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 42:18" />“हे भैंरामन, सुनव;</para>
  <para style="q2" vid="ISA 42:18">हे अंधरामन, आंखी खोलव अऊ देखव!<verse eid="ISA 42:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 42:19" />मोर सेवक के छोंड़ कोन अंधरा अय,</para>
  <para style="q2" vid="ISA 42:19">अऊ मोर पठोय दूत सहीं कोन भैंरा अय?</para>
  <para style="q1" vid="ISA 42:19">जऊन ह मोर संग करार करे हवय, ओकर सहीं कोन अंधरा अय,</para>
  <para style="q2" vid="ISA 42:19">या यहोवा के सेवक सहीं कोन अंधरा अय?<verse eid="ISA 42:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 42:20" />तेंह बहुंते चीजमन ला देखे हस, पर तें धियान नइं देवस;</para>
  <para style="q2" vid="ISA 42:20">तोर कानमन तो खुले हवंय, पर तें सुनस नइं।”<verse eid="ISA 42:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 42:21" />यहोवा ला अपन धरमीपन बर</para>
  <para style="q2" vid="ISA 42:21">ये बने लगिस</para>
  <para style="q1" vid="ISA 42:21">कि अपन कानून ला ओह बड़े अऊ महिमामय करय।<verse eid="ISA 42:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 42:22" />पर येमन एक लूटे अऊ छीने गय मनखे अंय,</para>
  <para style="q2" vid="ISA 42:22">सब के सब खंचवा म फंसे</para>
  <para style="q2" vid="ISA 42:22">या जेल म बंद हवंय।</para>
  <para style="q1" vid="ISA 42:22">येमन लूट के चीज बन गे हवंय,</para>
  <para style="q2" vid="ISA 42:22">अऊ येमन ला कोनो बचानेवाला नइं एं;</para>
  <para style="q1" vid="ISA 42:22">येमन लूट लिये गे हवंय,</para>
  <para style="q2" vid="ISA 42:22">अऊ कोनो ये कहइया नइं एं, “येमन ला वापिस भेज दव।”<verse eid="ISA 42:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="ISA 42:23" />तुमन म ले कोन ह येला सुनही</para>
  <para style="q2" vid="ISA 42:23">या अवइया समय म बिसेस धियान दीही?<verse eid="ISA 42:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 42:24" />कोन ह याकूब ला लूट के चीज होय बर दे दीस,</para>
  <para style="q2" vid="ISA 42:24">अऊ इसरायल ला लुटेरामन के हांथ म कर दीस?</para>
  <para style="q1" vid="ISA 42:24">का येह यहोवा नइं रिहिस,</para>
  <para style="q2" vid="ISA 42:24">जेकर बिरूध हमन पाप करेंन?</para>
  <para style="q1" vid="ISA 42:24">काबरकि ओमन ओकर रसता म नइं चलिन;</para>
  <para style="q2" vid="ISA 42:24">ओमन ओकर कानून ला नइं मानिन।<verse eid="ISA 42:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 42:25" />एकरसेति ओमन ऊपर ओकर कोरोध ह भड़किस,</para>
  <para style="q2" vid="ISA 42:25">ओमन ऊपर लड़ई के हिंसा होईस।</para>
  <para style="q1" vid="ISA 42:25">येह आगी सहीं ओमन ला घेर लीस, तभो ले ओमन नइं समझिन;</para>
  <para style="q2" vid="ISA 42:25">येह ओमन ला भसम कर दीस, पर ओमन नइं चेतिन।<verse eid="ISA 42:25" /></para>
  <chapter eid="ISA 42" />
  <chapter number="43" style="c" sid="ISA 43" />
  <para style="s1">इसरायल के सिरिप एक उद्धारकर्ता</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 43:1" />हे याकूब, जऊन ह तोला बनाईस,</para>
  <para style="q2" vid="ISA 43:1">हे इसरायल, जऊन ह तोला रचिस,</para>
  <para style="q2" vid="ISA 43:1">अब ओ यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 43:1">“झन डर, काबरकि मेंह तोला छोंड़ाय हंव;</para>
  <para style="q2" vid="ISA 43:1">मेंह तोला नांव लेके बलाय हंव, तेंह मोरेच अस।<verse eid="ISA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 43:2" />जब तेंह पानी म ले होके जाबे,</para>
  <para style="q2" vid="ISA 43:2">त मेंह तोर संगे-संग रहिहूं;</para>
  <para style="q1" vid="ISA 43:2">अऊ जब तेंह नदीमन ले होके जाबे,</para>
  <para style="q2" vid="ISA 43:2">तब ओमन तोला नइं बुड़ो सकंय।</para>
  <para style="q1" vid="ISA 43:2">जब तेंह आगी म रेंगबे,</para>
  <para style="q2" vid="ISA 43:2">तब तोला आंच नइं लगय;</para>
  <para style="q2" vid="ISA 43:2">अऊ ओकर जुवाला ह तोला नइं जला सकय।<verse eid="ISA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 43:3" />काबरकि में यहोवा तोर परमेसर अंव,</para>
  <para style="q2" vid="ISA 43:3">इसरायल के पबितर परमेसर, तोर उद्धार करइया अंव;</para>
  <para style="q1" vid="ISA 43:3">तोर छुड़ौती म मेंह मिसर देस ला</para>
  <para style="q2" vid="ISA 43:3">अऊ तोर बदला कूस अऊ सबा देसमन ला देथंव।<verse eid="ISA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 43:4" />मोर नजर म तेंह अनमोल अऊ आदर के योग्य अस,</para>
  <para style="q2" vid="ISA 43:4">अऊ काबरकि मेंह तोर ले मया करथंव,</para>
  <para style="q1" vid="ISA 43:4">एकर कारन में तोर बदला म मनखेमन ला</para>
  <para style="q2" vid="ISA 43:4">अऊ तोर परान के बदला म जाति-जाति के मनखेमन ला दे दूहूं।<verse eid="ISA 43:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 43:5" />झन डर, काबरकि में तोर संग हवंव;</para>
  <para style="q2" vid="ISA 43:5">मेंह तोर लइकामन ला पूरब ले लानहूं</para>
  <para style="q2" vid="ISA 43:5">अऊ पछिम ले घलो तोला इकट्ठा करहूं।<verse eid="ISA 43:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 43:6" />मेंह उत्तर ले कहिहूं, ‘ओमन ला देय दे!’</para>
  <para style="q2" vid="ISA 43:6">अऊ दक्खिन ले कहिहूं, ‘ओमन ला रोकके झन रख।’</para>
  <para style="q1" vid="ISA 43:6">मोर बेटामन ला दूरिहा ले</para>
  <para style="q2" vid="ISA 43:6">अऊ मोर बेटीमन ला धरती के छोर ले लेय आवव—<verse eid="ISA 43:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 43:7" />हर एक जन, जऊन ह मोर नांव ले जाने जाथे,</para>
  <para style="q2" vid="ISA 43:7">जेला मेंह अपन महिमा बर सिरजेंव,</para>
  <para style="q2" vid="ISA 43:7">जेला मेंह रचेंव अऊ बनाएंव।”<verse eid="ISA 43:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 43:8" />ओमन ला ले आवव, जेमन आंखी के रहत अंधवा अंय,</para>
  <para style="q2" vid="ISA 43:8">अऊ कान के रहत भैंरा अंय।<verse eid="ISA 43:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 43:9" />जाति-जाति के मनखेमन एक संग जूरंय</para>
  <para style="q2" vid="ISA 43:9">अऊ मनखेमन जमा होवंय।</para>
  <para style="q1" vid="ISA 43:9">ओमन के कोन देवता ह ये बात ला पहिले ले बताय रिहिस</para>
  <para style="q2" vid="ISA 43:9">अऊ हमन ला पहिली के चीजमन के घोसना करे रिहिस?</para>
  <para style="q1" vid="ISA 43:9">ओमन अपन गवाहमन ला लानके साबित करंय कि ओमन सही अंय,</para>
  <para style="q2" vid="ISA 43:9">ताकि आने मन सुनंय अऊ कहंय, “येह सच अय।”<verse eid="ISA 43:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 43:10" />यहोवा ह घोसना करत हे, “तुमन मोर गवाह अव,</para>
  <para style="q2" vid="ISA 43:10">अऊ मोर सेवक अव, जेमन ला मेंह चुने हंव,</para>
  <para style="q1" vid="ISA 43:10">ताकि तुमन जानव अऊ मोर ऊपर बिसवास करव</para>
  <para style="q2" vid="ISA 43:10">अऊ ये बात ला समझव कि में ओही अंव।</para>
  <para style="q1" vid="ISA 43:10">मोर ले पहिली कोनो देवता के रचना नइं होईस,</para>
  <para style="q2" vid="ISA 43:10">अऊ न ही कोनो मोर बाद होहीं।<verse eid="ISA 43:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 43:11" />में ही यहोवा अंव,</para>
  <para style="q2" vid="ISA 43:11">अऊ मोला छोंड़ कोनो अऊ उद्धारकर्ता नइं एं।<verse eid="ISA 43:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 43:12" />मेंह परगट करे हंव अऊ उद्धार करेंव अऊ घोसना करेंव—</para>
  <para style="q2" vid="ISA 43:12">में, अऊ तुम्हर बीच म कोनो अऊ पराया देवता नइं।</para>
  <para style="q1" vid="ISA 43:12">तुमन ही मोर गवाह अव,” यहोवा ह घोसना करत हे, “कि में परमेसर अंव।<verse eid="ISA 43:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="ISA 43:13" />हव, अऊ प्राचीन समय ले मेंह ओही अंव।</para>
  <para style="q1" vid="ISA 43:13">मोर हांथ ले कोनो छोंड़ा नइं सकंय।</para>
  <para style="q2" vid="ISA 43:13">जब मेंह काम करथंव, त कोन ह ओला पलट सकथे?”<verse eid="ISA 43:13" /></para>
  <para style="s1">परमेसर के दया अऊ इसरायल के बिसवासघात</para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 43:14" />तुम्हर छुड़इया, इसरायल के पबितर परमेसर,</para>
  <para style="q2" vid="ISA 43:14">यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 43:14">“तुम्हर बर मेंह बेबिलोन ला भेजहूं</para>
  <para style="q2" vid="ISA 43:14">अऊ जम्मो बेबिलोनीमन<note caller="+" style="f"><char style="fr" closed="false">43:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> ला भगोड़ा के सहीं ले आहूं,</para>
  <para style="q2" vid="ISA 43:14">ओमन ला पानी जहाज म ले आहूं, जेकर ऊपर ओमन घमंड करथें।<verse eid="ISA 43:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 43:15" />में, यहोवा, तुम्हर पबितर परमेसर,</para>
  <para style="q2" vid="ISA 43:15">इसरायल के सिरजइया, तुम्हर राजा अंव।”<verse eid="ISA 43:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 43:16" />यहोवा ह ये कहत हे—</para>
  <para style="q2" vid="ISA 43:16">जऊन ह समुंदर म एक रसता,</para>
  <para style="q2" vid="ISA 43:16">पानी के तेज लहरा म एक डहार बनाईस,<verse eid="ISA 43:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 43:17" />जऊन ह रथ अऊ घोड़ामन ला,</para>
  <para style="q2" vid="ISA 43:17">सेना अऊ सैनिक ताकत ला एक संग निकाल लेथे,</para>
  <para style="q1" vid="ISA 43:17">अऊ ओमन उहां पड़े रहिथें, अऊ फेर कभू नइं उठंय,</para>
  <para style="q2" vid="ISA 43:17">ओमन खतम हो गीन, एक ठन बाती के सहीं बुता गीन:<verse eid="ISA 43:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 43:18" />“पहिली के चीजमन ला सुरता झन करव;</para>
  <para style="q2" vid="ISA 43:18">भूतकाल म झन जीयव।<verse eid="ISA 43:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 43:19" />देखव, में एक नवां चीज करत हंव!</para>
  <para style="q2" vid="ISA 43:19">येह परगट होवत हे; का तुमन येला नइं समझत हव?</para>
  <para style="q1" vid="ISA 43:19">मेंह सुनसान जगह म एक रसता</para>
  <para style="q2" vid="ISA 43:19">अऊ निरजल देस म सोतामन ला बनात हंव।<verse eid="ISA 43:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 43:20" />जंगल के पसु,</para>
  <para style="q2" vid="ISA 43:20">गीदड़ अऊ उल्लूमन मोर आदर करथें,</para>
  <para style="q1" vid="ISA 43:20">काबरकि में सुनसान जगह म पानी</para>
  <para style="q2" vid="ISA 43:20">अऊ निरजल जगह म सोतामन ला निकालथंव,</para>
  <para style="q1" vid="ISA 43:20">ताकि मोर मनखे, मोर चुने मनखेमन पानी पीयंय,<verse eid="ISA 43:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 43:21" />ये मनखे, जेमन ला मेंह अपन बर बनाय हंव</para>
  <para style="q2" vid="ISA 43:21">ताकि ओमन मोर परसंसा करंय।<verse eid="ISA 43:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 43:22" />“तभो ले, हे याकूब, तेंह मोला नइं पुकारे हस,</para>
  <para style="q2" vid="ISA 43:22">हे इसरायल, तेंह अपनआप ला मोर बर नइं थकाय हस।<verse eid="ISA 43:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 43:23" />तेंह होम-बलिदान करे बर मोर मेर भेड़ नइं लाने हस,</para>
  <para style="q2" vid="ISA 43:23">अऊ न ही अपन बलिदानमन ला चघाके मोर आदर करे हस।</para>
  <para style="q1" vid="ISA 43:23">मेंह अन्न-बलिदान चघाय के बोझ तोर ऊपर नइं डाले हंव,</para>
  <para style="q2" vid="ISA 43:23">न ही धूप के मांग करके तोला थकाय हंव।<verse eid="ISA 43:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 43:24" />तेंह मोर बर कोनो खुसबूवाला तेजपान नइं लाने हस,</para>
  <para style="q2" vid="ISA 43:24">अऊ न ही मोला अपन बलिदान के चरबी चघाय हस।</para>
  <para style="q1" vid="ISA 43:24">पर तेंह अपन पापमन के दुवारा मोर ऊपर बोझा डाले हस</para>
  <para style="q2" vid="ISA 43:24">अऊ अपन अधरम के काम ले मोला थका दे हस।<verse eid="ISA 43:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="ISA 43:25" />“में, में ही ओ अंव, जऊन ह अपन नांव बर</para>
  <para style="q2" vid="ISA 43:25">तोर पापमन ला मेटा देथंव,</para>
  <para style="q2" vid="ISA 43:25">अऊ तोर पापमन ला फेर सुरता नइं करंव।<verse eid="ISA 43:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 43:26" />मोर खातिर पहिले के चीजमन ला सुरता कर,</para>
  <para style="q2" vid="ISA 43:26">आ, हमन ओ बात ऊपर आपस म बहस करन;</para>
  <para style="q2" vid="ISA 43:26">तें अपन मामला ला बता, जऊन ह तोला निरदोस ठहिराथे।<verse eid="ISA 43:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 43:27" />तोर पहिली पुरखा ह पाप करिस;</para>
  <para style="q2" vid="ISA 43:27">जेमन ला मेंह तोर मेर सिखाय बर पठोंय, ओमन मोर ले बिदरोह करिन।<verse eid="ISA 43:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 43:28" />एकर कारन मेंह तोर मंदिर के सम्मानीय मनखेमन ला कलंकित करेंव;</para>
  <para style="q2" vid="ISA 43:28">मेंह याकूब ला बिनास बर</para>
  <para style="q2" vid="ISA 43:28">अऊ इसरायल ला अपमानित होय बर सऊंप देंव।<verse eid="ISA 43:28" /></para>
  <chapter eid="ISA 43" />
  <chapter number="44" style="c" sid="ISA 44" />
  <para style="s1">इसरायल चुने गे हवय</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 44:1" />“पर अब, हे मोर दास याकूब,</para>
  <para style="q2" vid="ISA 44:1">हे मोर चुने इसरायल, सुन।<verse eid="ISA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 44:2" />यहोवा ह ये कहत हे—</para>
  <para style="q2" vid="ISA 44:2">ओ, जऊन ह तोला बनाईस, जऊन ह तोला गरभ म रचिस,</para>
  <para style="q2" vid="ISA 44:2">अऊ जऊन ह तोर सहायता करही:</para>
  <para style="q1" vid="ISA 44:2">हे मोर दास याकूब, हे मोर चुने यसूरून,<note caller="+" style="f"><char style="fr" closed="false">44:2 </char><char style="fq" closed="false">यसूरून </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">धरमी जन, </char><char style="ft" closed="false">याने कि इसरायल</char></note></para>
  <para style="q2" vid="ISA 44:2">झन डर।<verse eid="ISA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 44:3" />काबरकि में पीयासन भुइयां म पानी</para>
  <para style="q2" vid="ISA 44:3">अऊ सूखा जमीन ऊपर पानी के धारा बोहाहूं;</para>
  <para style="q1" vid="ISA 44:3">में तोर बंस ऊपर अपन आतमा,</para>
  <para style="q2" vid="ISA 44:3">अऊ तोर संतानमन ऊपर अपन आसीस ढारहूं।<verse eid="ISA 44:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 44:4" />ओमन चरागन म कांदी सहीं,</para>
  <para style="q2" vid="ISA 44:4">पानी के धारामन के तीर म चिनार रूखमन सहीं बाढ़हीं।<verse eid="ISA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 44:5" />कोनो कहिही, ‘में यहोवा के अंव’;</para>
  <para style="q2" vid="ISA 44:5">आने मन अपनआप ला याकूब के नांव म बलाहीं;</para>
  <para style="q1" vid="ISA 44:5">अऊ कुछू आने मन अपन हांथ म लिखहीं, ‘में यहोवा के अंव,’</para>
  <para style="q2" vid="ISA 44:5">अऊ इसरायल के नांव ले लीहीं।<verse eid="ISA 44:5" /></para>
  <para style="s1">यहोवा, मूरती नइं</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 44:6" />“सर्वसक्तिमान यहोवा, जऊन ह इसरायल के राजा अऊ छुड़इया अय,</para>
  <para style="q2" vid="ISA 44:6">ओ यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 44:6">में ही पहिला अंव अऊ में ही अन्त अंव;</para>
  <para style="q2" vid="ISA 44:6">मोला छोंड़ अऊ कोनो परमेसर नइं एं।<verse eid="ISA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 44:7" />मोर सहीं कोन हे? ओह येला बतावय।</para>
  <para style="q2" vid="ISA 44:7">ओह घोसना करय अऊ मोर आघू म रखय</para>
  <para style="q1" vid="ISA 44:7">कि जब ले मेंह पुराना जमाना म मनखेमन ला ठहिरांय, तब ले का होय हवय</para>
  <para style="q2" vid="ISA 44:7">अऊ का होवइया हे—</para>
  <para style="q2" vid="ISA 44:7">हव, पहिले से बतावय कि का होवइया हे।<verse eid="ISA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 44:8" />झन कांपव, झन डरव।</para>
  <para style="q2" vid="ISA 44:8">का मेंह येकर घोसना नइं करेंव अऊ बहुंत पहिले ही येला नइं बताय रहेंव?</para>
  <para style="q1" vid="ISA 44:8">तुमन मोर गवाह अव। का मोला छोंड़ अऊ कोनो परमेसर हवय?</para>
  <para style="q2" vid="ISA 44:8">नइं, मोला छोंड़ अऊ कोनो चट्टान नइं ए; में कोनो अऊ ला नइं जानंव।”<verse eid="ISA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 44:9" />ओ जम्मो जेमन मूरतीमन ला बनाथें, ओमन कुछू नो हंय,</para>
  <para style="q2" vid="ISA 44:9">अऊ जऊन चीजमन ला ओमन जतन के रखथें, ओमन बेकार अंय।</para>
  <para style="q1" vid="ISA 44:9">जऊन मन ओमन बर गोठियाथें, ओमन अंधरा अंय;</para>
  <para style="q2" vid="ISA 44:9">ओमन अपन खुद के लज्जा के बारे म अनजान हवंय।<verse eid="ISA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 44:10" />कोन ह एक देवता ला आकार देथे अऊ मूरती ला बनाथे,</para>
  <para style="q2" vid="ISA 44:10">जेकर से कोनो लाभ नइं होवय?<verse eid="ISA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 44:11" />ओ मनखे, जेमन ओ काम करथें, ओमन लज्जा म पड़हीं;</para>
  <para style="q2" vid="ISA 44:11">अइसन कारीगरमन तो मनखे ही अंय।</para>
  <para style="q1" vid="ISA 44:11">ओ जम्मो एक संग आवंय अऊ अपन बात ला साबित करंय;</para>
  <para style="q2" vid="ISA 44:11">ओमन आतंकित होहीं अऊ लज्जा म पड़हीं।<verse eid="ISA 44:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 44:12" />लोहार ह एक ठन औजार ला लेथे</para>
  <para style="q2" vid="ISA 44:12">अऊ धातु ला कोइला म गरम करके ये औजार ले काम करथे;</para>
  <para style="q1" vid="ISA 44:12">ओह हथौड़ा ले मूरती ला रूप देथे,</para>
  <para style="q2" vid="ISA 44:12">ओह अपन भुजबल ले येला गढ़थे।</para>
  <para style="q1" vid="ISA 44:12">ओला भूख लगथे अऊ ओकर ताकत कम हो जाथे;</para>
  <para style="q2" vid="ISA 44:12">ओह पानी नइं पीयय अऊ दुरबल हो जाथे।<verse eid="ISA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 44:13" />बढ़ई ह अपन नाप ले नापथे</para>
  <para style="q2" vid="ISA 44:13">अऊ तब ओ चीज के पेन्सिल से रूप-रेखा बनाथे;</para>
  <para style="q1" vid="ISA 44:13">अऊ बंसुला ले काम करके चिकना करथे</para>
  <para style="q1" vid="ISA 44:13">अऊ परकार ले लकीर खींचथे।</para>
  <para style="q2" vid="ISA 44:13">ओह येला मनखे के रूप देथे,</para>
  <para style="q1" vid="ISA 44:13">पूरा महिमा म येला मनखे के रूप देथे,</para>
  <para style="q2" vid="ISA 44:13">ताकि येह कोनो देवालय म रहय।<verse eid="ISA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 44:14" />ओह देवदार रूख ला काटथे,</para>
  <para style="q2" vid="ISA 44:14">या ओह आने कोनो रूख या बलूत रूख लेथे।</para>
  <para style="q1" vid="ISA 44:14">ओह जंगल के रूखमन के बीच येला बढ़े बर देथे,</para>
  <para style="q2" vid="ISA 44:14">या देवदार के रूख लगाथे, बरसा के पानी ले येह बाढ़थे।<verse eid="ISA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 44:15" />तब ओह आगी बारे के काम आथे;</para>
  <para style="q2" vid="ISA 44:15">ओह ओमा के कुछू ला सुलगाके आगी तापथे,</para>
  <para style="q2" vid="ISA 44:15">ओह आगी बारके रोटी बनाथे।</para>
  <para style="q1" vid="ISA 44:15">पर ओह येला एक देवता के रूप देके येकर अराधना घलो करथे;</para>
  <para style="q2" vid="ISA 44:15">ओह एक मूरती बनाके येकर आघू म मुड़ नवाथे।<verse eid="ISA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 44:16" />आधा लकरी ला तो ओह आगी बारथे;</para>
  <para style="q2" vid="ISA 44:16">अऊ येमा अपन खाना पकाथे,</para>
  <para style="q2" vid="ISA 44:16">ओह मांस ला भुंजके भरपेट खाथे।</para>
  <para style="q1" vid="ISA 44:16">ओह आगी घलो तापथे अऊ कहिथे,</para>
  <para style="q2" vid="ISA 44:16">“अहा! मेंह गरम हो गेंव; मेंह आगी ला देखत हंव!”<verse eid="ISA 44:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 44:17" />अऊ बाकि बांचे लकरी ले ओह एक देवता, अपन बर मूरती बनाथे;</para>
  <para style="q2" vid="ISA 44:17">ओह ओकर दंडवत करथे अऊ ओकर अराधना करथे।</para>
  <para style="q1" vid="ISA 44:17">ओह ओकर ले पराथना करके कहिथे,</para>
  <para style="q2" vid="ISA 44:17">“मोला बचा ले! तेंह मोर देवता अस!”<verse eid="ISA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 44:18" />ओमन कुछू नइं जानंय, ओमन कुछू नइं समझंय;</para>
  <para style="q2" vid="ISA 44:18">ओमन के आंखीमन अइसन बंद रहिथें कि ओमन देख नइं सकंय,</para>
  <para style="q2" vid="ISA 44:18">अऊ ओमन के दिमाग ह अइसन बंद रहिथे कि ओमन समझ नइं सकंय।<verse eid="ISA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 44:19" />सोच-बिचार करे बर कोनो नइं रूकंय,</para>
  <para style="q2" vid="ISA 44:19">काकरो मेर ये कहे बर गियान अऊ समझ नइं ए,</para>
  <para style="q1" vid="ISA 44:19">“आधा लकरी के उपयोग मेंह आगी बारे बर करेंव;</para>
  <para style="q2" vid="ISA 44:19">येकर कोइला म रोटी बनांय,</para>
  <para style="q2" vid="ISA 44:19">मेंह मांस ला भुंजके खांय।</para>
  <para style="q1" vid="ISA 44:19">त जऊन लकरी बांच गीस, का ओकर ले में एक घिनौना चीज बनावंव?</para>
  <para style="q2" vid="ISA 44:19">का मेंह कठवा के एक भाग ला दंडवत करंव?”<verse eid="ISA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 44:20" />अइसन मनखे ह राख ला खाथे; ओकर मन ह भटक गे हे अऊ ओला गलत रसता म ले जाथे;</para>
  <para style="q2" vid="ISA 44:20">ओह अपनआप ला बचा नइं सकय अऊ ये नइं कह सकय,</para>
  <para style="q2" vid="ISA 44:20">“जऊन चीज ह मोर जेवनी हांथ म हवय, का ओह एक झूठ नो हय?”<verse eid="ISA 44:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 44:21" />“हे याकूब, हे इसरायल, ये बातमन ला सुरता कर,</para>
  <para style="q2" vid="ISA 44:21">काबरकि तेंह मोर सेवक अस।</para>
  <para style="q1" vid="ISA 44:21">मेंह तोला रचे हंव, तेंह मोर सेवक अस;</para>
  <para style="q2" vid="ISA 44:21">हे इसरायल, मेंह तोला नइं भुलावंव।<verse eid="ISA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 44:22" />मेंह तोर अपराधमन ला बादर सहीं,</para>
  <para style="q2" vid="ISA 44:22">अऊ तोर पापमन ला बिहनियां के कुहरा सहीं मिटा देय हंव।</para>
  <para style="q1" vid="ISA 44:22">मोर मेर लहुंट आ,</para>
  <para style="q2" vid="ISA 44:22">काबरकि मेंह तोला छोंड़ाय हंव।”<verse eid="ISA 44:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="ISA 44:23" />हे अकासमन, आनंद के मारे गावव, काबरकि यहोवा ह ये काम करे हवय;</para>
  <para style="q2" vid="ISA 44:23">हे धरती के गहिला जगहमन, जोर-जोर से जय-जयकार करव।</para>
  <para style="q1" vid="ISA 44:23">हे पहाड़मन, हे जंगलमन अऊ तुमन के जम्मो रूखमन,</para>
  <para style="q2" vid="ISA 44:23">गला खोलके जोर से गावव,</para>
  <para style="q1" vid="ISA 44:23">काबरकि यहोवा ह याकूब ला छोंड़ाय हवय,</para>
  <para style="q2" vid="ISA 44:23">ओह इसरायल म अपन महिमा परगट करथे।<verse eid="ISA 44:23" /></para>
  <para style="s1">यरूसलेम सहर फेर बसाय जाही</para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 44:24" />यहोवा, तोर छुड़इया,</para>
  <para style="q2" vid="ISA 44:24">जऊन ह तोला गरभ म रचिस, ओह ये कहत हे:</para>
  <para style="b" vid="ISA 44:24" />
  <para style="q1" vid="ISA 44:24">“में ही ओ यहोवा,</para>
  <para style="q2" vid="ISA 44:24">जम्मो चीज के बनइया अंव,</para>
  <para style="q2" vid="ISA 44:24">जऊन ह अकास ला तानिस,</para>
  <para style="q2" vid="ISA 44:24">जऊन ह खुद होके धरती ला फईलाईस,<verse eid="ISA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 44:25" />जऊन ह लबरा अगमजानीमन के चिनहां ला बेकार कर देथे</para>
  <para style="q2" vid="ISA 44:25">अऊ सकुन-बिचार करइयामन ला मुरूख बना देथे।</para>
  <para style="q1" vid="ISA 44:25">जऊन ह बुद्धिमान के सिकछा ला दूरिहा फटिक देथे</para>
  <para style="q2" vid="ISA 44:25">अऊ येला बेमतलब के बात बना देथे,<verse eid="ISA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 44:26" />जऊन ह अपन सेवक के बचन ला पूरा करथे</para>
  <para style="q2" vid="ISA 44:26">अऊ अपन दूतमन के बात ला सफल करथे,</para>
  <para style="b" vid="ISA 44:26" />
  <para style="q1" vid="ISA 44:26">“जऊन ह यरूसलेम के बारे म कहिथे, ‘येला फेर बसाय जाही,’</para>
  <para style="q2" vid="ISA 44:26">अऊ यहूदा के नगरमन के बारे कहिथे, ‘ओमन फेर बनाय जाहीं,’</para>
  <para style="q2" vid="ISA 44:26">अऊ ओमन के खंडहरमन के बारे कहिथे, ‘मेंह येमन ला सुधारहूं,’<verse eid="ISA 44:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 44:27" />जऊन ह गहिला पानी ला कहिथे, ‘सूखा जा,</para>
  <para style="q2" vid="ISA 44:27">अऊ मेंह तोर सोतामन ला सूखा दूहूं,’<verse eid="ISA 44:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 44:28" />में ही ओ अंव, जऊन ह कुसरू के बारे म कहिथे, ‘ओह मोर चरवाहा अय,</para>
  <para style="q2" vid="ISA 44:28">अऊ ओह मोर ईछा ला पूरा करही;</para>
  <para style="q1" vid="ISA 44:28">ओह यरूसलेम के बारे म कहिही, “येला फेर बनाय जावय,”</para>
  <para style="q2" vid="ISA 44:28">अऊ मंदिर के बारे म कहिही, “येकर नीवमन ला डारे जावय।” ’ ”<verse eid="ISA 44:28" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 44" />
  <chapter number="45" style="c" sid="ISA 45" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 45:1" />यहोवा ह अपन अभिसिक्त, कुसरू ला ये कहत हे,</para>
  <para style="q2" vid="ISA 45:1">ओकर जेवनी हांथ ला मेंह थामे रहिथंव</para>
  <para style="q1" vid="ISA 45:1">कि ओकर सामने ही जाति-जाति के मनखे ला ओकर अधीन कर देवंव</para>
  <para style="q2" vid="ISA 45:1">अऊ राजामन ला बिगर हथियार के कर दंव,</para>
  <para style="q1" vid="ISA 45:1">ओकर सामने म ही कपाटमन ला अइसन खोल देवंव</para>
  <para style="q2" vid="ISA 45:1">कि ओ दुवारमन बंद झन हो सकंय:<verse eid="ISA 45:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 45:2" />मेंह तोर आघू-आघू जाहूं</para>
  <para style="q2" vid="ISA 45:2">अऊ पहाड़मन ला समतल कर दूहूं;</para>
  <para style="q1" vid="ISA 45:2">मेंह कांसा के दुवारमन ला टोर दूहूं</para>
  <para style="q2" vid="ISA 45:2">अऊ लोहा के बेड़ीमन ला काट दूहूं।<verse eid="ISA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 45:3" />मेंह तोला छुपे खजाना दूहूं,</para>
  <para style="q2" vid="ISA 45:3">अऊ गुपत जगह म रखे धन दूहूं,</para>
  <para style="q1" vid="ISA 45:3">ताकि तेंह जान सकस कि मेंह यहोवा,</para>
  <para style="q2" vid="ISA 45:3">इसरायल के परमेसर अंव, जऊन ह तोला नांव लेके बलाथे।<verse eid="ISA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 45:4" />मोर अपन सेवक याकूब,</para>
  <para style="q2" vid="ISA 45:4">मोर चुने इसरायल के हित म,</para>
  <para style="q1" vid="ISA 45:4">मेंह तोला नांव लेके बलात हंव</para>
  <para style="q2" vid="ISA 45:4">अऊ तोला आदर के एक पदवी देवत हंव,</para>
  <para style="q2" vid="ISA 45:4">हालाकि तेंह मोला नइं मानस।<verse eid="ISA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 45:5" />मेंह यहोवा अंव, अऊ दूसर कोनो नइं;</para>
  <para style="q2" vid="ISA 45:5">मोला छोंड़ अऊ कोनो परमेसर नइं एं।</para>
  <para style="q1" vid="ISA 45:5">हालाकि तेंह मोला नइं माने हस</para>
  <para style="q2" vid="ISA 45:5">तभो ले मेंह तोला मजबूत करहूं,<verse eid="ISA 45:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 45:6" />ताकि बेर के उगती ले लेके</para>
  <para style="q2" vid="ISA 45:6">बुड़ती तक के जगह के</para>
  <para style="q1" vid="ISA 45:6">मनखेमन ये जान लेवंय कि मोर छोंड़ आने अऊ कोनो नइं एं।</para>
  <para style="q2" vid="ISA 45:6">मेंह यहोवा अंव, अऊ आने कोनो नइं एं।<verse eid="ISA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 45:7" />मेंह अंजोर के बनइया अऊ अंधियार के सिरजनहार अंव,</para>
  <para style="q2" vid="ISA 45:7">मेंह सुख-सांति के दाता अऊ में ही बिपत्ति ला बनाथंव;</para>
  <para style="q2" vid="ISA 45:7">में, यहोवा ही ये जम्मो चीज ला करथंव।<verse eid="ISA 45:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 45:8" />हे ऊपर के अकास, मोर धरमीपन के बारिस कर;</para>
  <para style="q2" vid="ISA 45:8">बादरमन येकर बारिस करंय।</para>
  <para style="q1" vid="ISA 45:8">धरती ह बहुंत खुल जावय,</para>
  <para style="q2" vid="ISA 45:8">उद्धार ह निकल आवय,</para>
  <para style="q1" vid="ISA 45:8">अऊ धरमीपन ह येकर संग बढ़त जावय;</para>
  <para style="q2" vid="ISA 45:8">में, यहोवा ही येकर सिरिस्टी करे हवंव।<verse eid="ISA 45:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 45:9" />“ओमन ऊपर हाय, जेमन अपन रचइया ले झगरा करथें,</para>
  <para style="q2" vid="ISA 45:9">ओमन कुछू नो हंय, पर भुइयां म</para>
  <para style="q2" vid="ISA 45:9">माटी के बरतन के कुटामन के बीच बरतन के कुटा अंय।</para>
  <para style="q1" vid="ISA 45:9">का माटी ह कुम्हार ले कहिथे,</para>
  <para style="q2" vid="ISA 45:9">‘तें का बनात हस?’</para>
  <para style="q1" vid="ISA 45:9">का कारीगर के बनाय चीज ह कहिथे,</para>
  <para style="q2" vid="ISA 45:9">‘कुम्हार के तो हांथमन नइं एं’?<verse eid="ISA 45:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 45:10" />हाय ओकर ऊपर, जऊन ह अपन ददा ला कहिथे,</para>
  <para style="q2" vid="ISA 45:10">‘तेंह का जनमाय हस?’</para>
  <para style="q1" vid="ISA 45:10">या अपन दाई ला कहिथे,</para>
  <para style="q2" vid="ISA 45:10">‘तेंह का ला जनम दे हस?’<verse eid="ISA 45:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 45:11" />“यहोवा, इसरायल के पबितर परमेसर,</para>
  <para style="q2" vid="ISA 45:11">अऊ ओकर बनइया ह ये कहत हे:</para>
  <para style="q1" vid="ISA 45:11">अवइया चीजमन के बारे म,</para>
  <para style="q2" vid="ISA 45:11">का तेंह मोर लइकामन के बारे पुछबे,</para>
  <para style="q2" vid="ISA 45:11">या मोर हांथ के काम के बारे म मोला हुकूम देबे?<verse eid="ISA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 45:12" />येह में अंव, जऊन ह धरती ला बनाईस</para>
  <para style="q2" vid="ISA 45:12">अऊ येकर ऊपर मानव-जाति ला सिरजिस।</para>
  <para style="q1" vid="ISA 45:12">मोर खुद के हांथमन अकास ला ताने हवंय;</para>
  <para style="q2" vid="ISA 45:12">मेंह ओकर तारा मंडल ला सही जगह म रखे हंव।<verse eid="ISA 45:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 45:13" />मेंह कुसरू<note caller="+" style="f"><char style="fr" closed="false">45:13 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">ओला</char></note> ला अपन धरमीपन म उठाय हंव:</para>
  <para style="q2" vid="ISA 45:13">मेंह ओकर सबो डहार ला सीधा करहूं।</para>
  <para style="q1" vid="ISA 45:13">ओह मोर नगर ला फेर बनाही</para>
  <para style="q2" vid="ISA 45:13">अऊ मोर बंदीमन ला</para>
  <para style="q1" vid="ISA 45:13">बिगर दाम या बिगर भेंट लिये छोंड़ दीही,</para>
  <para style="q2" vid="ISA 45:13">सर्वसक्तिमान यहोवा ह कहत हे।”<verse eid="ISA 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 45:14" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 45:14">“मिसर देस के कमई अऊ कूस देस<note caller="+" style="f"><char style="fr" closed="false">45:14 </char><char style="ft" closed="false">ऊपरी नील नदी के इलाका</char></note> के बेपार,</para>
  <para style="q2" vid="ISA 45:14">अऊ ओ ऊंच सबायीमन—</para>
  <para style="q1" vid="ISA 45:14">ओमन तोर मेर चले आहीं</para>
  <para style="q2" vid="ISA 45:14">अऊ तोर हो जाहीं;</para>
  <para style="q1" vid="ISA 45:14">ओमन थकके तोर पाछू-पाछू आहीं,</para>
  <para style="q2" vid="ISA 45:14">ओमन सांकल म बंधाय तोर मेर चले आहीं।</para>
  <para style="q1" vid="ISA 45:14">ओमन तोर आघू म मुड़ नवाहीं</para>
  <para style="q2" vid="ISA 45:14">अऊ ये कहिके तोर ले बिनती करहीं,</para>
  <para style="q1" vid="ISA 45:14">‘निस्चय परमेसर ह तोर संग हवय, अऊ दूसर कोनो नइं ए;</para>
  <para style="q2" vid="ISA 45:14">कोनो अऊ देवता नइं एं।’ ”<verse eid="ISA 45:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 45:15" />सही म तेंह परमेसर अस, जऊन ह अपनआप ला छुपाय रिहिस,</para>
  <para style="q2" vid="ISA 45:15">परमेसर अऊ इसरायल के उद्धारकर्ता।<verse eid="ISA 45:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 45:16" />मूरतीमन के बनइयामन सब के सब लज्जित अऊ कलंकित होहीं;</para>
  <para style="q2" vid="ISA 45:16">ओमन एक संग अपमानित होहीं।<verse eid="ISA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 45:17" />पर इसरायल ह यहोवा के दुवारा</para>
  <para style="q2" vid="ISA 45:17">सदाकाल के उद्धार के संग बचाय जाही;</para>
  <para style="q1" vid="ISA 45:17">तेंह अनंतकाल तक न तो कभू लज्जित होबे,</para>
  <para style="q2" vid="ISA 45:17">अऊ न ही कभू कलंकित होबे।<verse eid="ISA 45:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 45:18" />काबरकि यहोवा ह ये कहत हे—</para>
  <para style="q1" vid="ISA 45:18">ओ, जऊन ह अकास के सिरिस्टी करिस,</para>
  <para style="q2" vid="ISA 45:18">ओह परमेसर अय;</para>
  <para style="q1" vid="ISA 45:18">ओ, जऊन ह धरती ला आकार दीस अऊ बनाईस,</para>
  <para style="q2" vid="ISA 45:18">ओह येकर नीव रखिस;</para>
  <para style="q1" vid="ISA 45:18">ओह येला खाली रहे बर नइं,</para>
  <para style="q2" vid="ISA 45:18">पर येला बसे बर रचिस—</para>
  <para style="q1" vid="ISA 45:18">ओह कहिथे:</para>
  <para style="q1" vid="ISA 45:18">“मेंह यहोवा अंव,</para>
  <para style="q2" vid="ISA 45:18">अऊ आने कोनो परमेसर नइं एं।<verse eid="ISA 45:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 45:19" />मेंह गुपत म,</para>
  <para style="q2" vid="ISA 45:19">कोनो अंधियार देस के कोनो जगह ले नइं कहे हंव;</para>
  <para style="q1" vid="ISA 45:19">मेंह याकूब के संतानमन ले नइं कहे हंव,</para>
  <para style="q2" vid="ISA 45:19">‘मोला बेकार म खोजव।’</para>
  <para style="q1" vid="ISA 45:19">में, यहोवा, सच कहिथंव;</para>
  <para style="q2" vid="ISA 45:19">मेंह सही बात के घोसना करथंव।<verse eid="ISA 45:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 45:20" />“हे जाति-जाति के भगोड़ा मनखेमन, एक संग जूरव,</para>
  <para style="q2" vid="ISA 45:20">आवव अऊ इकट्ठा होवव।</para>
  <para style="q1" vid="ISA 45:20">अगियानी ओमन अंय, जेमन लकरी के मूरतीमन ला धरके चलथें,</para>
  <para style="q2" vid="ISA 45:20">जेमन अइसन देवतामन ले पराथना करथें, जेमन उद्धार नइं कर सकंय।<verse eid="ISA 45:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 45:21" />घोसना करव कि का होना हे, ओला सामने लानव—</para>
  <para style="q2" vid="ISA 45:21">ओमन एक संग सलाह लेवंय।</para>
  <para style="q1" vid="ISA 45:21">बहुंत पहिले ये बात कोन ह बताईस,</para>
  <para style="q1" vid="ISA 45:21">बहुंत पहिले ले कोन ह येकर घोसना करिस?</para>
  <para style="q1" vid="ISA 45:21">का में यहोवा ही नइं करेंव?</para>
  <para style="q2" vid="ISA 45:21">अऊ मोला छोंड़ कोनो अऊ दूसर परमेसर हय ही नइं,</para>
  <para style="q1" vid="ISA 45:21">एक धरमी परमेसर अऊ उद्धारकर्ता;</para>
  <para style="q2" vid="ISA 45:21">मोला छोंड़ अऊ कोनो नइं एं।<verse eid="ISA 45:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 45:22" />“हे जम्मो धरती के मनखेमन,</para>
  <para style="q2" vid="ISA 45:22">मोर कोति फिरव अऊ उद्धार पावव;</para>
  <para style="q2" vid="ISA 45:22">काबरकि में ही परमेसर अंव, अऊ दूसर कोनो अऊ परमेसर नइं एं।<verse eid="ISA 45:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 45:23" />मेंह अपन ही किरिया खाय हंव,</para>
  <para style="q2" vid="ISA 45:23">पूरा ईमानदारी से मोर मुहूं ले ये बचन निकले हवय</para>
  <para style="q2" vid="ISA 45:23">अऊ ये बात ह नइं टरय:</para>
  <para style="q1" vid="ISA 45:23">हर एक मनखे ह मोर आघू म माड़ी टेकही;</para>
  <para style="q2" vid="ISA 45:23">हर एक मनखे ह मोर किरिया खाही।<verse eid="ISA 45:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 45:24" />मनखेमन मोर बारे म कहिहीं,</para>
  <para style="q2" vid="ISA 45:24">‘सिरिप यहोवा ही म छुटकारा अऊ ताकत हवय।’ ”</para>
  <para style="q1" vid="ISA 45:24">ओ जम्मो जेमन ओकर ले गुस्सा होय रिहिन,</para>
  <para style="q2" vid="ISA 45:24">ओमन आहीं अऊ लज्जित होहीं।<verse eid="ISA 45:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 45:25" />पर इसरायल के जम्मो संतानमन</para>
  <para style="q2" vid="ISA 45:25">यहोवा म छुटकारा पाहीं</para>
  <para style="q2" vid="ISA 45:25">अऊ ओमा अपन घमंड करहीं।<verse eid="ISA 45:25" /></para>
  <chapter eid="ISA 45" />
  <chapter number="46" style="c" sid="ISA 46" />
  <para style="s1">बेबिलोन के देवतामन</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 46:1" />बेल देवता ह झुकथे, नबो देवता ह घलो खाल्हे झुकथे;</para>
  <para style="q2" vid="ISA 46:1">ओमन के मूरतीमन ला पसुमन ऊपर लादके ले जाय जाथे।</para>
  <para style="q1" vid="ISA 46:1">जऊन मूरतीमन ला ले जाय जावत हे, ओमन भारी हवंय,</para>
  <para style="q2" vid="ISA 46:1">थके पसु बर एक बोझा।<verse eid="ISA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 46:2" />ओमन एक संग मुड़ नवाके झुक गीन;</para>
  <para style="q2" vid="ISA 46:2">बोझा ला उठा नइं सकिन,</para>
  <para style="q2" vid="ISA 46:2">ओमन खुद बंधुवई म चले गीन।<verse eid="ISA 46:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 46:3" />“हे याकूब के संतानमन,</para>
  <para style="q2" vid="ISA 46:3">हे इसरायल के जम्मो बांचे मनखेमन, मोर बात ला सुनव,</para>
  <para style="q1" vid="ISA 46:3">तुमन, जेमन ला मेंह तुम्हर जनम ले ही ऊपर उठाय हंव,</para>
  <para style="q2" vid="ISA 46:3">अऊ तुम्हर जनम ही ले तुमन ला धरके चलत हंव।<verse eid="ISA 46:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 46:4" />तुम्हर बुढ़ापा अऊ तुम्हर पाके चुंदी के बेरा घलो</para>
  <para style="q2" vid="ISA 46:4">मेंह वइसन ही बने रहिहूं, मेंह ओही अंव, जऊन ह तुमन ला संभाले रखही।</para>
  <para style="q1" vid="ISA 46:4">मेंह तुमन ला बनाय हंव अऊ तुमन ला धरके ले चलहूं;</para>
  <para style="q2" vid="ISA 46:4">मेंह तुमन ला संभालहूं अऊ तुमन ला बचाहूं।<verse eid="ISA 46:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 46:5" />“काकर संग तुमन मोर तुलना करहू या काकर सहीं मोला बताहू?</para>
  <para style="q2" vid="ISA 46:5">काकर संग मोर मिलान करहू कि हमर तुलना करे जा सकय?<verse eid="ISA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 46:6" />कुछू जन अपन थैली ले सोन उंडेलथें</para>
  <para style="q2" vid="ISA 46:6">अऊ तराजू म चांदी तऊलथें;</para>
  <para style="q1" vid="ISA 46:6">ओमन सुनार ला बनी देके ये चीजमन ले देवता बनवाथें,</para>
  <para style="q2" vid="ISA 46:6">अऊ ओमन येला दंडवत करथें अऊ येकर अराधना करथें।<verse eid="ISA 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 46:7" />ओमन येला अपन कंधा म उठाके ले चलथें,</para>
  <para style="q2" vid="ISA 46:7">ओमन येला ओकर जगह म रखथें अऊ ओह उहां ठाढ़े रहिथे।</para>
  <para style="q2" vid="ISA 46:7">ओ जगह ले येह हट नइं सकय।</para>
  <para style="q1" vid="ISA 46:7">यदि कोनो ओकर मेर जोर से गोहार पारके कहिही, तभो ले येह जबाब नइं दे सकय;</para>
  <para style="q2" vid="ISA 46:7">येह ओमन ला ओमन के समस्या ले नइं बचा सकय।<verse eid="ISA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 46:8" />“येला सुरता रखव, येला मन म रखव,</para>
  <para style="q2" vid="ISA 46:8">हे बिदरोहीमन, ये बात तुम्हर मन म रहय।<verse eid="ISA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 46:9" />पहिले के बातमन ला सुरता करव, बहुंत पहिले के बातमन ला;</para>
  <para style="q2" vid="ISA 46:9">काबरकि में परमेसर अंव, अऊ दूसर कोनो नइं एं;</para>
  <para style="q2" vid="ISA 46:9">में ही परमेसर अंव अऊ मोर सहीं अऊ कोना नइं एं।<verse eid="ISA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 46:10" />में तो अन्त के बात सुरू ले ही बतात आय हंव,</para>
  <para style="q2" vid="ISA 46:10">अऊ पुराना जमाना ले बतात आय हंव कि अभी घलो का अवइया हे।</para>
  <para style="q1" vid="ISA 46:10">में कहिथंव, ‘मोर उपाय स्थिर रहिही,</para>
  <para style="q2" vid="ISA 46:10">अऊ जऊन बात मोला बने लगथे, ओला मेंह करहूं।’<verse eid="ISA 46:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 46:11" />मेंह पूरब ले एक सिकार करइया चिरई,</para>
  <para style="q2" vid="ISA 46:11">दूरिहा देस ले, अपन उदेस्य ला पूरा करे बर एक मनखे ला बलावत हंव।</para>
  <para style="q1" vid="ISA 46:11">जऊन बात मेंह कहे हंव, ओला पूरा करहूं;</para>
  <para style="q2" vid="ISA 46:11">जऊन बात के मेंह योजना बनाय हंव, ओला में करहूं।<verse eid="ISA 46:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 46:12" />हे कठोर मन वाले, तुमन मोर बात ला सुनव,</para>
  <para style="q2" vid="ISA 46:12">तुमन, जऊन मन अब मोर धरमीपन ले दूरिहा हव।<verse eid="ISA 46:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 46:13" />मेंह अपन धरमीपन ला लकठा म लावत हंव,</para>
  <para style="q2" vid="ISA 46:13">येह दूरिहा म नइं ए;</para>
  <para style="q2" vid="ISA 46:13">अऊ मोर उद्धार करे म देरी नइं होवय।</para>
  <para style="q1" vid="ISA 46:13">मेंह सियोन के उद्धार करहूं,</para>
  <para style="q2" vid="ISA 46:13">अऊ इसरायल ला मोर सोभा दूहूं।<verse eid="ISA 46:13" /></para>
  <chapter eid="ISA 46" />
  <chapter number="47" style="c" sid="ISA 47" />
  <para style="s1">बेबिलोन के गिरई</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 47:1" />“हे कुंवारी बेटी बेबिलोन,</para>
  <para style="q2" vid="ISA 47:1">खाल्हे जा अऊ धुर्रा म बईठ;</para>
  <para style="q1" vid="ISA 47:1">हे बेबिलोनीमन<note caller="+" style="f"><char style="fr" closed="false">47:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> के रानी सहर,</para>
  <para style="q2" vid="ISA 47:1">बिगर सिंघासन के भुइयां ऊपर बईठ।</para>
  <para style="q1" vid="ISA 47:1">तोला अब फेर कभू कोमल</para>
  <para style="q2" vid="ISA 47:1">या सुकुमार नइं कहे जाही।<verse eid="ISA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 47:2" />जांता ला लेके पीसान पीस;</para>
  <para style="q2" vid="ISA 47:2">अपन घूंघट ला हटा दे।</para>
  <para style="q1" vid="ISA 47:2">अपन लंहगा ला उठाके उघारे टांग</para>
  <para style="q2" vid="ISA 47:2">सोतामन के पानी म ले होके जा।<verse eid="ISA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 47:3" />तोर नंगई ह उघारे जाही</para>
  <para style="q2" vid="ISA 47:3">अऊ तोर लाज ह परगट होही।</para>
  <para style="q1" vid="ISA 47:3">मेंह बदला लूहूं;</para>
  <para style="q2" vid="ISA 47:3">मेंह कोनो मनखे ला नइं छोड़ंव।”<verse eid="ISA 47:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 47:4" />हमर छुड़इया के नांव सर्वसक्तिमान यहोवा अय,</para>
  <para style="q2" vid="ISA 47:4">ओह इसरायल के पबितर परमेसर अय।<verse eid="ISA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 47:5" />“हे बेबिलोनीमन के रानी सहर,</para>
  <para style="q2" vid="ISA 47:5">चुपेचाप बईठे रह अऊ अंधियार म जा;</para>
  <para style="q1" vid="ISA 47:5">तोला अऊ फेर राजमन के रानी</para>
  <para style="q2" vid="ISA 47:5">नइं कहे जाही।<verse eid="ISA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 47:6" />मेंह अपन मनखेमन ले नराज रहेंव</para>
  <para style="q2" vid="ISA 47:6">अऊ अपन निज भाग ला अपबितर करेंव;</para>
  <para style="q1" vid="ISA 47:6">मेंह ओमन ला तोर बस म कर देंव,</para>
  <para style="q2" vid="ISA 47:6">अऊ तेंह ओमन ऊपर कुछू दया नइं करे।</para>
  <para style="q1" vid="ISA 47:6">डोकरामन ऊपर घलो</para>
  <para style="q2" vid="ISA 47:6">तेंह एक ठन भारी जुड़ा मढ़ा देय।<verse eid="ISA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 47:7" />तेंह कहे, ‘मेंह हमेसा बर</para>
  <para style="q2" vid="ISA 47:7">रानी अंव!’</para>
  <para style="q1" vid="ISA 47:7">पर तेंह ये बातमन ऊपर बिचार नइं करे</para>
  <para style="q2" vid="ISA 47:7">या येकर ऊपर धियान नइं देय कि का हो सकत हे।<verse eid="ISA 47:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 47:8" />“तब हे मऊज-मस्ती ले मया करइया, ये बात ला सुन,</para>
  <para style="q2" vid="ISA 47:8">तेंह जो अपन सुरकछा म निडर रहिके</para>
  <para style="q1" vid="ISA 47:8">अपनआप ले कहिथस,</para>
  <para style="q2" vid="ISA 47:8">‘में ही अंव, अऊ मोला छोंड़ कोनो दूसर नइं एं।</para>
  <para style="q1" vid="ISA 47:8">मेंह कभू बिधवा नइं होवंव</para>
  <para style="q2" vid="ISA 47:8">अऊ न ही मोर लइकामन मरहीं।’<verse eid="ISA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 47:9" />पर, ये दूनों दुख, लइकामन के मरई</para>
  <para style="q2" vid="ISA 47:9">अऊ बिधवा होवई अचानक</para>
  <para style="q2" vid="ISA 47:9">एके दिन तोर ऊपर आ पड़ही।</para>
  <para style="q1" vid="ISA 47:9">तोर बहुंत जादूगरी</para>
  <para style="q2" vid="ISA 47:9">अऊ भारी जादू टोनहा करे के बावजूद</para>
  <para style="q2" vid="ISA 47:9">ये दुखमन तोर ऊपर पूरा ताकत से आ जाहीं।<verse eid="ISA 47:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 47:10" />तेंह अपन दुस्टता ऊपर भरोसा करे हस</para>
  <para style="q2" vid="ISA 47:10">अऊ कहे हस, ‘मोला कोनो नइं देखत हवंय।’</para>
  <para style="q1" vid="ISA 47:10">तोर बुद्धि अऊ गियान तोला बहकाथें</para>
  <para style="q2" vid="ISA 47:10">जब तेंह अपनआप ला कहिथस,</para>
  <para style="q2" vid="ISA 47:10">‘में ही अंव, अऊ मोर छोंड़ अऊ कोनो नइं एं।’<verse eid="ISA 47:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 47:11" />बिपत्ति ह तोर ऊपर आ जाही,</para>
  <para style="q2" vid="ISA 47:11">अऊ तेंह नइं जानबे कि येकर ले बाहिर कइसे निकले जाय।</para>
  <para style="q1" vid="ISA 47:11">तोर ऊपर अइसन संकट आ जाही</para>
  <para style="q2" vid="ISA 47:11">कि तेंह छुड़ौती देके येकर ले बच नइं सकबे;</para>
  <para style="q1" vid="ISA 47:11">एक बड़े बिपत्ति, जेकर बारे म तोला मालूम नइं होही,</para>
  <para style="q2" vid="ISA 47:11">ओह अचानक तोर ऊपर आ पड़ही।<verse eid="ISA 47:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 47:12" />“तब, अपन जादू टोनहा</para>
  <para style="q2" vid="ISA 47:12">अऊ अपन बहुंत जादूगरी के ओ काममन ला करते रह,</para>
  <para style="q2" vid="ISA 47:12">जेला तेंह अपन लइकापन ले ही सीखे हस।</para>
  <para style="q1" vid="ISA 47:12">सायद तेंह सफल हो जाबे,</para>
  <para style="q2" vid="ISA 47:12">सायद तेंह आतंकित कर सकबे।<verse eid="ISA 47:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 47:13" />जऊन सलाहमन ला तेंह ले हस, ओकर ले तोला सिरिप थकावट मिले हवय!</para>
  <para style="q2" vid="ISA 47:13">तोर जोतिसीमन आघू आवंय,</para>
  <para style="q1" vid="ISA 47:13">ओ तारा देखइयामन, जेमन महिना दर महिना अगम के बात कहिथें,</para>
  <para style="q2" vid="ISA 47:13">ओमन तोला तोर ऊपर अवइया बिपत्ति ले बचावंय।<verse eid="ISA 47:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 47:14" />देख, ओमन भूंसा के सहीं अंय;</para>
  <para style="q2" vid="ISA 47:14">आगी ह ओमन ला जला दीही।</para>
  <para style="q1" vid="ISA 47:14">ओमन अपनआप ला</para>
  <para style="q2" vid="ISA 47:14">आगी के जुवाला ले नइं बचा सकंय।</para>
  <para style="q1" vid="ISA 47:14">येमन गरम करे कोइला नो हंय,</para>
  <para style="q2" vid="ISA 47:14">येह ओ आगी नो हय, जिहां बईठके आगी तापथें।<verse eid="ISA 47:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 47:15" />जम्मो तोर बर वइसने ही अंय—</para>
  <para style="q2" vid="ISA 47:15">जेमन के संग तेंह लेन-देन करे हस</para>
  <para style="q2" vid="ISA 47:15">अऊ लइकापन ले जेमन के संग मेहनत करे हस।</para>
  <para style="q1" vid="ISA 47:15">ओ जम्मो के जम्मो अपन गलत रद्दा म चले जाथें;</para>
  <para style="q2" vid="ISA 47:15">अइसे कोनो नइं ए, जऊन ह तोला बचा सकय।<verse eid="ISA 47:15" /></para>
  <chapter eid="ISA 47" />
  <chapter number="48" style="c" sid="ISA 48" />
  <para style="s1">ढीठ इसरायल</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 48:1" />“हे याकूब के संतानमन, ये बात ला सुनव,</para>
  <para style="q2" vid="ISA 48:1">तुमन जेमन ला इसरायल के नांव ले बलाय जाथे</para>
  <para style="q2" vid="ISA 48:1">अऊ यहूदा के कतार म ले आथव,</para>
  <para style="q1" vid="ISA 48:1">तुमन जऊन मन यहोवा के नांव के सपथ लेथव</para>
  <para style="q2" vid="ISA 48:1">अऊ इसरायल के परमेसर के दुहाई देथव—</para>
  <para style="q2" vid="ISA 48:1">पर सच्चई या धरमीपन म नइं—<verse eid="ISA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 48:2" />तुमन जेमन अपनआप ला पबितर सहर के नागरिक बताथव</para>
  <para style="q2" vid="ISA 48:2">अऊ इसरायल के परमेसर ऊपर भरोसा रखे के घोसना करथव—</para>
  <para style="q2" vid="ISA 48:2">सर्वसक्तिमान यहोवा ओकर नांव अय:<verse eid="ISA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 48:3" />बहुंत पहिले मेंह पहिले के बातमन ला बताय हंव,</para>
  <para style="q2" vid="ISA 48:3">मोर मुहूं ह ओमन के घोसना करिस अऊ मेंह ओमन ला परगट करेंव;</para>
  <para style="q2" vid="ISA 48:3">तब अचानक मेंह काम करेंव, अऊ ओ बातमन सच म होईन।<verse eid="ISA 48:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 48:4" />काबरकि मेंह जानत रहेंव कि तुमन कतेक ढीठ रहेव;</para>
  <para style="q2" vid="ISA 48:4">अऊ तुम्हर घेंच के मांस-पेसीमन लोहा सहीं रिहिन,</para>
  <para style="q2" vid="ISA 48:4">अऊ तुम्हर माथा ह कांसा के सहीं रिहिस।<verse eid="ISA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 48:5" />एकर कारन बहुंत पहिले, मेंह ये बातमन ला तुमन ला बताएंव;</para>
  <para style="q2" vid="ISA 48:5">ओमन के होय के पहिली, मेंह तुमन ला ओमन के घोसना कर दे रहेंव</para>
  <para style="q1" vid="ISA 48:5">ताकि तुमन ये झन कह सकव,</para>
  <para style="q2" vid="ISA 48:5">‘येह हमर देवता के काम अय;</para>
  <para style="q2" vid="ISA 48:5">मोर लकरी के मूरती अऊ धातु के देवता के हुकूम ले येह होईस।’<verse eid="ISA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 48:6" />तुमन ये बातमन ला सुने हवव; ओ जम्मो चीज ला देखव।</para>
  <para style="q2" vid="ISA 48:6">का तुमन ओमन ला स्वीकार नइं करहू?</para>
  <para style="b" vid="ISA 48:6" />
  <para style="q1" vid="ISA 48:6">“अब ले मेंह तोला नवां-नवां बात</para>
  <para style="q2" vid="ISA 48:6">अऊ गुपत के बातमन ला बताहूं, जेमन ला तेंह नइं जानस।<verse eid="ISA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 48:7" />ओमन अभी सिरजे गे हवंय, बहुंत पहिले ले नइं;</para>
  <para style="q2" vid="ISA 48:7">आज ले पहिली तेंह ओमन के बारे सुने घलो नइं रहे।</para>
  <para style="q1" vid="ISA 48:7">एकरसेति तें ये नइं कह सकस,</para>
  <para style="q2" vid="ISA 48:7">‘हव, में ओमन के बारे म जानत रहेंव।’<verse eid="ISA 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 48:8" />तेंह ओमन के बारे न तो सुने, अऊ न ही समझे हस;</para>
  <para style="q2" vid="ISA 48:8">पुराना समय ले, तोर कानमन ला नइं खोले गे रिहिस।</para>
  <para style="q1" vid="ISA 48:8">काबरकि मेंह जानत रहेंव कि तेंह कतेक बिसवासघाती अस;</para>
  <para style="q2" vid="ISA 48:8">तोला जनम ले ही बिदरोही कहे गे रिहिस।<verse eid="ISA 48:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 48:9" />अपन नांव बर मेंह कोप करे म देरी करथंव;</para>
  <para style="q2" vid="ISA 48:9">अपन महिमा बर मेंह येला तोर ले रोके रखथंव,</para>
  <para style="q2" vid="ISA 48:9">अइसन झन होवय कि मेंह तोला पूरा मेटा डारंव।<verse eid="ISA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 48:10" />देख, मेंह तोला साफ करे हंव, हालाकि चांदी के सहीं नइं;</para>
  <para style="q2" vid="ISA 48:10">मेंह दुख के भट्ठी म तोला परखे हंव।<verse eid="ISA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 48:11" />अपन हित म, हव, अपनेच हित म, मेंह ये करत हंव।</para>
  <para style="q2" vid="ISA 48:11">मेंह अपनआप ला बदनाम कइसे कर सकत हंव?</para>
  <para style="q2" vid="ISA 48:11">में अपन महिमा दूसर ला नइं देवंव।<verse eid="ISA 48:11" /></para>
  <para style="s1">इसरायल सुतंतर होईस</para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 48:12" />“हे याकूब, हे इसरायल,</para>
  <para style="q2" vid="ISA 48:12">जेला मेंह बलाय हंव, मोर बात सुन:</para>
  <para style="q1" vid="ISA 48:12">मेंह ओही अंव;</para>
  <para style="q2" vid="ISA 48:12">मेंह ही सुरू अऊ में ही आखिरी अंव।<verse eid="ISA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 48:13" />मोर खुद के हांथ ह धरती के नीव डारिस,</para>
  <para style="q2" vid="ISA 48:13">अऊ मोर जेवनी हांथ ह अकास ला बगराईस;</para>
  <para style="q1" vid="ISA 48:13">जब में ओमन ला बलाथंव,</para>
  <para style="q2" vid="ISA 48:13">त ओमन एक संग ठाढ़ हो जाथें।<verse eid="ISA 48:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 48:14" />“तुमन सब के सब एक संग आवव, अऊ सुनव:</para>
  <para style="q2" vid="ISA 48:14">मूरतीमन ले कोन ह ये बातमन ला पहिले ले बताईस?</para>
  <para style="q1" vid="ISA 48:14">यहोवा के चुने संगी ह</para>
  <para style="q2" vid="ISA 48:14">बेबिलोन के बिरूध ओकर उदेस्य ला पूरा करही;</para>
  <para style="q2" vid="ISA 48:14">ओकर हांथ ह बेबिलोनीमन<note caller="+" style="f"><char style="fr" closed="false">48:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char><char style="ft" closed="false">; <char style="xt" link-href="ISA 48:20"><ref loc="ISA 48:20">पद 20</ref></char> म घलो</char></note> के बिरूध उठही।<verse eid="ISA 48:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 48:15" />में, हव, मेंह कहे हंव;</para>
  <para style="q2" vid="ISA 48:15">हव, मेंह ओला बलाय हंव।</para>
  <para style="q1" vid="ISA 48:15">मेंह ओला लानहूं,</para>
  <para style="q2" vid="ISA 48:15">अऊ ओह अपन उदेस्य म सफल होही।<verse eid="ISA 48:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 48:16" />“मोर लकठा म आके ये बात ला सुनव:</para>
  <para style="q1" vid="ISA 48:16">“सुरू ले लेके अब तक के घोसना म कोनो बात मेंह गुपत म नइं कहेंव;</para>
  <para style="q2" vid="ISA 48:16">जब येह होथे, तब में उहां हंव।”</para>
  <para style="b" vid="ISA 48:16" />
  <para style="q1" vid="ISA 48:16">अऊ अब परमपरधान यहोवा ह मोला पठोय हवय,</para>
  <para style="q2" vid="ISA 48:16">अऊ अपन आतमा ले मोला भर दे हवय।<verse eid="ISA 48:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 48:17" />यहोवा, तोर छुड़इया,</para>
  <para style="q2" vid="ISA 48:17">इसरायल के पबितर परमेसर ह ये कहत हे:</para>
  <para style="q1" vid="ISA 48:17">“मेंह यहोवा तुम्हर परमेसर अंव,</para>
  <para style="q2" vid="ISA 48:17">जऊन ह तोला ओ बात सिखोथे, जऊन ह तोर बर सबले बने अय,</para>
  <para style="q2" vid="ISA 48:17">अऊ तोला ओ डहार दिखाथे, जेमा तोला जाना चाही।<verse eid="ISA 48:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 48:18" />कहूं तें मोर हुकूम ला धियान देय रहिते,</para>
  <para style="q2" vid="ISA 48:18">तब तोर सांति ह नदी सहीं,</para>
  <para style="q2" vid="ISA 48:18">अऊ तोर अच्छई ह समुंदर के लहरा सहीं होतिस।<verse eid="ISA 48:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 48:19" />तोर संतानमन बालू के सहीं होतिन,</para>
  <para style="q2" vid="ISA 48:19">अऊ तोर लइकामन येकर अनगिनत दाना सहीं होतिन;</para>
  <para style="q1" vid="ISA 48:19">ओमन के नांव मोर आघू ले न कभू मिटाय जातिस</para>
  <para style="q2" vid="ISA 48:19">न कभू नास करे जातिस।”<verse eid="ISA 48:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 48:20" />बेबिलोन ला छोंड़ दव,</para>
  <para style="q2" vid="ISA 48:20">बेबिलोनीमन ले भाग जावव!</para>
  <para style="q1" vid="ISA 48:20">आनंद के जय-जयकार करत ये बात के घोसना करव,</para>
  <para style="q2" vid="ISA 48:20">अऊ येकर परचार करव।</para>
  <para style="q1" vid="ISA 48:20">धरती के छोर तक येला भेजव,</para>
  <para style="q2" vid="ISA 48:20">अऊ कहव, “यहोवा ह अपन सेवक याकूब ला छोंड़ाय हवय।”<verse eid="ISA 48:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 48:21" />जब यहोवा ह अपन मनखेमन ला मरू-भुइयां म ले होके ले गीस,</para>
  <para style="q2" vid="ISA 48:21">तब ओमन ला पीयास नइं लगिस;</para>
  <para style="q2" vid="ISA 48:21">ओह ओमन बर चट्टान म ले पानी निकालिस;</para>
  <para style="q1" vid="ISA 48:21">ओह चट्टान ला फोर दीस</para>
  <para style="q2" vid="ISA 48:21">अऊ पानी के तेज धारा निकलिस।<verse eid="ISA 48:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 48:22" />“दुस्टमन बर कुछू सांति नइं ए,” यहोवा ह कहिथे।<verse eid="ISA 48:22" /></para>
  <chapter eid="ISA 48" />
  <chapter number="49" style="c" sid="ISA 49" />
  <para style="s1">यहोवा के सेवक</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 49:1" />हे द्वीपमन, मोर बात ला सुनव;</para>
  <para style="q2" vid="ISA 49:1">हे दूरिहा-दूरिहा के जातिमन येला सुनव:</para>
  <para style="q1" vid="ISA 49:1">मोर जनमे के पहिली, यहोवा ह मोला बलाईस,</para>
  <para style="q1" vid="ISA 49:1">मोर दाई के गरभ ले ही ओह मोर नांव ला रखिस।<verse eid="ISA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 49:2" />ओह मोर मुहूं ला चोख तलवार सहीं बनाईस,</para>
  <para style="q2" vid="ISA 49:2">अऊ अपन हांथ के आड़ म मोला छुपा लीस;</para>
  <para style="q1" vid="ISA 49:2">ओह मोला एक चमकीला तीर बनाके</para>
  <para style="q2" vid="ISA 49:2">अपन तरकस म छुपाके रखिस।<verse eid="ISA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 49:3" />ओह मोला कहिस, “तेंह मोर सेवक इसरायल अस,</para>
  <para style="q2" vid="ISA 49:3">जेमा मेंह अपन महिमा परगट करहूं।”<verse eid="ISA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 49:4" />तब मेंह कहेंव, “में तो बेकार म मेहनत करें;</para>
  <para style="q2" vid="ISA 49:4">मेंह बेकार म अपन ताकत लगांय।</para>
  <para style="q1" vid="ISA 49:4">तभो ले येह यहोवा के हांथ म हवय कि मोला का मिलही,</para>
  <para style="q2" vid="ISA 49:4">अऊ मोर ईनाम ह मोर परमेसर के हांथ म हवय।”<verse eid="ISA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 49:5" />अऊ अब यहोवा ह कहिथे—</para>
  <para style="q2" vid="ISA 49:5">जऊन ह मोला गरभ म एकरसेति रचिस कि मेंह ओकर सेवक बनंव</para>
  <para style="q1" vid="ISA 49:5">अऊ याकूब ला ओकर मेर लहुंटाके ले आवंव</para>
  <para style="q2" vid="ISA 49:5">अऊ इसरायल ला ओकर मेर इकट्ठा करंव,</para>
  <para style="q1" vid="ISA 49:5">काबरकि यहोवा के नजर म मोर आदर होय हवय</para>
  <para style="q2" vid="ISA 49:5">अऊ मोर परमेसर ह मोर ताकत अय—<verse eid="ISA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 49:6" />यहोवा ह कहिथे:</para>
  <para style="q1" vid="ISA 49:6">“येह तोर बर बहुंत छोटे बात ए कि मोर सेवक बनके</para>
  <para style="q2" vid="ISA 49:6">तें याकूब के गोत्र ला फेर पहिले के सहीं कर दे</para>
  <para style="q2" vid="ISA 49:6">अऊ इसरायल के ओ बांचे मनखेमन ला वापिस ले आ, जेमन ला मेंह बचाके रखे हंव।</para>
  <para style="q1" vid="ISA 49:6">में तोला आनजातमन बर एक अंजोर घलो ठहिराहूं,</para>
  <para style="q2" vid="ISA 49:6">ताकि मोर उद्धार ह धरती के छोर तक हबरे।”<verse eid="ISA 49:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 49:7" />जऊन ह मनखेमन म तुछ जाने जाथे, जेकर ले जाति ह घिन करथे,</para>
  <para style="q2" vid="ISA 49:7">जऊन ह सासन करइयामन के सेवक अय,</para>
  <para style="q1" vid="ISA 49:7">ओकर ले यहोवा, इसरायल के छुड़इया</para>
  <para style="q2" vid="ISA 49:7">अऊ पबितर परमेसर ह ये कहत हे:</para>
  <para style="q1" vid="ISA 49:7">“राजा ह तोला देखके ठाढ़ हो जाही,</para>
  <para style="q2" vid="ISA 49:7">हाकिममन देखके दंडवत करहीं,</para>
  <para style="q1" vid="ISA 49:7">येह यहोवा के कारन होही, जऊन ह बिसवासयोग्य,</para>
  <para style="q2" vid="ISA 49:7">इसरायल के पबितर परमेसर अय अऊ जऊन ह तोला चुने हवय।”<verse eid="ISA 49:7" /></para>
  <para style="s1">इसरायल के फेर स्थापना</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 49:8">“मोर दया के समय म मेंह तोला जबाब दूहूं,</para>
  <para style="q2" vid="ISA 49:8">अऊ उद्धार के दिन म मेंह तोर सहायता करहूं;</para>
  <para style="q1" vid="ISA 49:8">में तोर रकछा करके तोला</para>
  <para style="q2" vid="ISA 49:8">मनखेमन बर एक करार ठहिराहूं,</para>
  <para style="q1" vid="ISA 49:8">ताकि देस ह स्थिर होवय</para>
  <para style="q2" vid="ISA 49:8">अऊ उजाड़ पड़े उत्तराधिकार ला फेर सऊंपे जावय,<verse eid="ISA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 49:9" />अऊ बंधुवई म गय मनखेमन ला कहे जावय, ‘बाहिर आवव,’</para>
  <para style="q2" vid="ISA 49:9">अऊ जेमन अंधियार म हवंय ओमन ला कहे जावय, ‘सुतंतर हो जावव।’</para>
  <para style="b" vid="ISA 49:9" />
  <para style="q1" vid="ISA 49:9">“ओमन रद्दा के तीरे-तीर जेवन पाहीं</para>
  <para style="q2" vid="ISA 49:9">अऊ हर बंजर पहाड़ी म ओमन ला चरागन मिलही।<verse eid="ISA 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 49:10" />ओमन न तो भूखन होहीं, न ही पीयासन,</para>
  <para style="q2" vid="ISA 49:10">अऊ न ही मरू-भुइयां के गरमी अऊ सूरज के घाम ओमन ला लगही।</para>
  <para style="q1" vid="ISA 49:10">जऊन ह ओमन ऊपर दया करथे, ओह ओमन के अगुवई करही</para>
  <para style="q2" vid="ISA 49:10">अऊ ओमन ला पानी के सोतामन के तीर म ले जाही।<verse eid="ISA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 49:11" />मेंह अपन सब पहाड़मन ला सड़क बना दूहूं,</para>
  <para style="q2" vid="ISA 49:11">अऊ मोर राजमार्गमन ऊंचहा करे जाहीं।<verse eid="ISA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 49:12" />देखव, ओमन दूरिहा ले आहीं—</para>
  <para style="q2" vid="ISA 49:12">कुछू झन उत्तर ले, कुछू झन पछिम ले,</para>
  <para style="q2" vid="ISA 49:12">कुछू झन असवान<note caller="+" style="f"><char style="fr" closed="false">49:12 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">सीनीम</char></note> के इलाका ले आहीं।”<verse eid="ISA 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 49:13" />हे अकास, आनंद के मारे जय-जयकार कर;</para>
  <para style="q2" vid="ISA 49:13">हे धरती, आनंदित हो;</para>
  <para style="q2" vid="ISA 49:13">हे पहाड़मन, गला खोलके गीत गावव!</para>
  <para style="q1" vid="ISA 49:13">काबरकि यहोवा ह अपन मनखेमन ला सांति देथे</para>
  <para style="q2" vid="ISA 49:13">अऊ अपन दुखित मनखेमन ऊपर दया करही।<verse eid="ISA 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 49:14" />पर सियोन ह कहिस, “यहोवा ह मोला तियाग दे हवय,</para>
  <para style="q2" vid="ISA 49:14">परभू ह मोला भुला गे हवय।”<verse eid="ISA 49:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 49:15" />“का कोनो दाई अपन दूध पीयत लइका ला भुला सकत हे</para>
  <para style="q2" vid="ISA 49:15">अऊ अपन जनमाय लइका ऊपर कुछू दया नइं करय?</para>
  <para style="q1" vid="ISA 49:15">हां, ओह तो भुला सकत हे,</para>
  <para style="q2" vid="ISA 49:15">पर में तोला नइं भुलावंव!<verse eid="ISA 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 49:16" />देख, मेंह अपन हथेली म खोदके तोर तसबीर बनाय हंव;</para>
  <para style="q2" vid="ISA 49:16">तोर दीवारमन हरदम मोर आघू म बने रहिथें।<verse eid="ISA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 49:17" />तोर लइकामन जल्दी करके वापिस आवत हें,</para>
  <para style="q2" vid="ISA 49:17">अऊ जेमन तोला उजाड़ दीन, ओमन तोर करा ले चले जावथें।<verse eid="ISA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 49:18" />अपन आंखी उठाके चारों कोति देख;</para>
  <para style="q2" vid="ISA 49:18">तोर जम्मो लइकामन जूरत हें अऊ तोर मेर आवत हें।</para>
  <para style="q1" vid="ISA 49:18">मोर जिनगी के कसम,” यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="ISA 49:18">“तेंह ओ जम्मो झन ला जेवर सहीं पहिरबे;</para>
  <para style="q2" vid="ISA 49:18">तें एक दुलहिन के सहीं ओमन ला पहिरबे।<verse eid="ISA 49:18" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ISA 49:19" />“हालाकि तेंह नास होके उजाड़ पड़े रहय</para>
  <para style="q2" vid="ISA 49:19">अऊ तोर देस ह उजाड़ पड़े रिहिस,</para>
  <para style="q1" vid="ISA 49:19">पर अब तें अपन मनखेमन बर बहुंत छोटे पड़बे,</para>
  <para style="q2" vid="ISA 49:19">अऊ जेमन तोला नास करे रिहिन, ओमन दूरिहा हो जाहीं।<verse eid="ISA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 49:20" />तोर दुख के समय जनमे लइकामन</para>
  <para style="q2" vid="ISA 49:20">तोर सुनत म कहिहीं,</para>
  <para style="q1" vid="ISA 49:20">‘ये जगह ह हमर बर छोटे हे;</para>
  <para style="q2" vid="ISA 49:20">हमन ला रहे बर अऊ जगह दे।’<verse eid="ISA 49:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 49:21" />तब तें अपन मन म कहिबे,</para>
  <para style="q2" vid="ISA 49:21">‘कोन ह येमन ला मोर बर जनमाईस?</para>
  <para style="q1" vid="ISA 49:21">में तो दुखी अऊ बिगर लइका के रहेंव,</para>
  <para style="q2" vid="ISA 49:21">मेंह बंधुवई म रहेंव अऊ छोंड़ दिये गे रहेंव।</para>
  <para style="q2" vid="ISA 49:21">येमन के पालन-पोसन कोन करिस?</para>
  <para style="q1" vid="ISA 49:21">मेंह एके झन छोंड़ दिये गे रहेंव,</para>
  <para style="q2" vid="ISA 49:21">पर येमन कहां ले आय हवंय?’ ”<verse eid="ISA 49:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 49:22" />परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 49:22">“देख, में जाति-जाति के मनखेमन ला इसारा करके बलाहूं,</para>
  <para style="q2" vid="ISA 49:22">मेंह देस-देस के मनखेमन के आघू म अपन झंडा ठाढ़ करहूं;</para>
  <para style="q1" vid="ISA 49:22">ओमन तोर बेटामन ला अपन गोदी म धरके लानहीं</para>
  <para style="q2" vid="ISA 49:22">अऊ तोर बेटीमन ला अपन पीठ म बईठाके लानहीं।<verse eid="ISA 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 49:23" />राजामन तोर पालक ददा</para>
  <para style="q2" vid="ISA 49:23">अऊ ओमन के रानीमन तोला दूध पीयानेवाली दाई होहीं।</para>
  <para style="q1" vid="ISA 49:23">ओमन भुइयां म झुकके तोला दंडवत करहीं;</para>
  <para style="q2" vid="ISA 49:23">ओमन तोर गोड़ के धुर्रा ला चाटहीं।</para>
  <para style="q1" vid="ISA 49:23">तब तेंह ये जानबे कि मेंह यहोवा अंव;</para>
  <para style="q2" vid="ISA 49:23">जेमन मोर ऊपर आसा रखथें, ओमन निरास नइं होवंय।”<verse eid="ISA 49:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="ISA 49:24" />का बीर के हांथ ले सामान लूटे जा सकथे,</para>
  <para style="q2" vid="ISA 49:24">या का दुस्ट<note caller="+" style="f"><char style="fr" closed="false">49:24 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">धरमी</char></note> ले कैदीमन ला छोंड़ाय जा सकथे?<verse eid="ISA 49:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 49:25" />पर यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 49:25">“हव, बीर ले कैदीमन ला छीने जा सकथे,</para>
  <para style="q2" vid="ISA 49:25">अऊ दुस्ट ले लूट के सामान लिये जा सकथे;</para>
  <para style="q1" vid="ISA 49:25">में ओमन ले लड़हूं, जेमन तोर संग लड़थें,</para>
  <para style="q2" vid="ISA 49:25">अऊ तोर लइकामन ला मेंह बचाहूं।<verse eid="ISA 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 49:26" />में तोर ऊपर अतियाचार करइयामन ला ओहीचमन के मांस खवाहूं;</para>
  <para style="q2" vid="ISA 49:26">अऊ ओमन अपन खुद के लहू पीहीं, जइसे मंद पीथें।</para>
  <para style="q1" vid="ISA 49:26">तब जम्मो मानव-जाति ह जानही</para>
  <para style="q2" vid="ISA 49:26">कि में, यहोवा ह तोर उद्धारकर्ता,</para>
  <para style="q2" vid="ISA 49:26">तोर छुड़इया, याकूब के सक्तिमान परमेसर अंव।”<verse eid="ISA 49:26" /></para>
  <chapter eid="ISA 49" />
  <chapter number="50" style="c" sid="ISA 50" />
  <para style="s1">इसरायल के पाप अऊ सेवक के हुकूम मनई</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 50:1">“तोर दाई के तियाग पतर कहां हे,</para>
  <para style="q2" vid="ISA 50:1">जेला मेंह ओला छोंड़त समय देय रहंय?</para>
  <para style="q1" vid="ISA 50:1">या अपन कोन साहूकार के हांथ म</para>
  <para style="q2" vid="ISA 50:1">मेंह तोला बेचेंव?</para>
  <para style="q1" vid="ISA 50:1">सुन, तेंह अपन पाप के कारन बेचे गे रहय;</para>
  <para style="q2" vid="ISA 50:1">तोर अपराधमन के कारन तोर दाई ला छोंड़ दिये गीस।<verse eid="ISA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 50:2" />जब मेंह आयेंव, त काबर उहां कोनो नइं रिहिन?</para>
  <para style="q2" vid="ISA 50:2">जब मेंह बलांय, त जबाब देय बर उहां काबर कोनो नइं रिहिन?</para>
  <para style="q1" vid="ISA 50:2">तोला छोंड़ाय बर का मोर हांथ ह बहुंत छोटे हो गीस?</para>
  <para style="q2" vid="ISA 50:2">तोला बचाय बर का मोर म ताकत के कमी हवय?</para>
  <para style="q1" vid="ISA 50:2">सिरिप एक डांट के दुवारा मेंह समुंदर ला सूखा देथंव,</para>
  <para style="q2" vid="ISA 50:2">में नदीमन ला मरू-भुइयां बना देथंव;</para>
  <para style="q1" vid="ISA 50:2">उहां के मछरीमन पानी बिगर मर जाथें</para>
  <para style="q2" vid="ISA 50:2">अऊ पीयास म मरके बस्साथें।<verse eid="ISA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 50:3" />में अकास ला अंधियार रूपी ओनहा पहिराथंव,</para>
  <para style="q2" vid="ISA 50:3">अऊ बोरा के ओनहा ला ओकर ओढ़ना बना देथंव।”<verse eid="ISA 50:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 50:4" />परमपरधान यहोवा ह मोला एक बने सिखानेवाला के जीभ देय हवय,</para>
  <para style="q2" vid="ISA 50:4">ताकि मेंह थके-हारे मनखे ला अपन बचन के दुवारा संभाले बर जानंव।</para>
  <para style="q1" vid="ISA 50:4">ओह मोला हर बिहनियां जगाथे,</para>
  <para style="q2" vid="ISA 50:4">ओह मोर कान ला खोलथे कि मेंह एक सेवक के सहीं सुनंव।<verse eid="ISA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 50:5" />परमपरधान यहोवा ह मोर कानमन ला खोल दे हवय;</para>
  <para style="q2" vid="ISA 50:5">मेंह बिदरोह नइं करे हंव,</para>
  <para style="q2" vid="ISA 50:5">अऊ न ही पाछू हटे हंव।<verse eid="ISA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 50:6" />जेमन मोला मारिन, ओमन कोति अपन पीठ,</para>
  <para style="q2" vid="ISA 50:6">अऊ जेमन मोर दाढ़ी नोचिन, ओमन कोति अपन गाल ला कर देंव;</para>
  <para style="q1" vid="ISA 50:6">मोर हंसी उड़ाय अऊ मोर ऊपर थूके ले घलो</para>
  <para style="q2" vid="ISA 50:6">मेंह अपन चेहरा ला नइं छुपांय।<verse eid="ISA 50:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 50:7" />काबरकि परमपरधान यहोवा ह मोर सहायता करथे,</para>
  <para style="q2" vid="ISA 50:7">मेंह कलंकित नइं होवंव।</para>
  <para style="q1" vid="ISA 50:7">एकरसेति मेंह अपन चेहरा ला चकमक पथरा के सहीं कड़ा कर ले हंव,</para>
  <para style="q2" vid="ISA 50:7">अऊ मेंह जानत हंव कि मोला लजाय बर नइं पड़य।<verse eid="ISA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 50:8" />जऊन ह मोर रकछा करथे, ओह मोर लकठा म हवय।</para>
  <para style="q2" vid="ISA 50:8">तब कोन ह मोर ऊपर दोस लगाही?</para>
  <para style="q2" vid="ISA 50:8">आवव, हमन एक-दूसर के सामना करन!</para>
  <para style="q1" vid="ISA 50:8">मोर ऊपर दोस लगइया कोन ए?</para>
  <para style="q2" vid="ISA 50:8">ओह मोर सामना करय!<verse eid="ISA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 50:9" />सुनव, येह परमपरधान यहोवा ए, जऊन ह मोर सहायता करथे।</para>
  <para style="q2" vid="ISA 50:9">मोला कोन ह दोसी ठहिराही?</para>
  <para style="q1" vid="ISA 50:9">मोर ऊपर दोस लगानेवाले जम्मो झन ओनहा सहीं जुन्ना हो जाहीं;</para>
  <para style="q2" vid="ISA 50:9">अऊ ओमन ला कीरामन खा जाहीं।<verse eid="ISA 50:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 50:10" />तुम्हर बीच म ले कोन ह यहोवा के भय मानथे</para>
  <para style="q2" vid="ISA 50:10">अऊ ओकर सेवक के बात ला मानथे?</para>
  <para style="q1" vid="ISA 50:10">जऊन ह अंधियार म रेंगथे,</para>
  <para style="q2" vid="ISA 50:10">जेकर मेर अंजोर नइं ए,</para>
  <para style="q1" vid="ISA 50:10">ओह यहोवा के नांव ऊपर भरोसा रखय</para>
  <para style="q2" vid="ISA 50:10">अऊ अपन परमेसर ऊपर बिसवास करय।<verse eid="ISA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 50:11" />पर अब, तुमन जम्मो झन, जेमन आगी बारथव</para>
  <para style="q2" vid="ISA 50:11">अऊ अपनआप ला बरत मसाल देथव,</para>
  <para style="q1" vid="ISA 50:11">जावव, अपन आगी के अंजोर म</para>
  <para style="q2" vid="ISA 50:11">अऊ अपन बारे गय मसाल के अंजोर म रेंगव।</para>
  <para style="q1" vid="ISA 50:11">मोर हांथ ले तुमन ला ये चीज ही मिलही:</para>
  <para style="q2" vid="ISA 50:11">तुमन पीरा म परे रहिहू।<verse eid="ISA 50:11" /></para>
  <chapter eid="ISA 50" />
  <chapter number="51" style="c" sid="ISA 51" />
  <para style="s1">सियोन बर अनंतकाल के उद्धार</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 51:1" />“तुमन, जेमन धरमीपन म चलथव</para>
  <para style="q2" vid="ISA 51:1">अऊ यहोवा के खोज करथव, मोर बात ला सुनव:</para>
  <para style="q1" vid="ISA 51:1">ओ चट्टान ला देखव, जेमा ले तुमन ला काटे गे हवय</para>
  <para style="q2" vid="ISA 51:1">अऊ पथरा के ओ खदान ला देखव, जेमा ले तुमन ला निकाले गे हवय;<verse eid="ISA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 51:2" />अपन पुरखा अब्राहम</para>
  <para style="q2" vid="ISA 51:2">अऊ सारा ला देखव, जेकर तुमन संतान अव।</para>
  <para style="q1" vid="ISA 51:2">जब में ओला बलांय, तब ओह सिरिप एके झन आदमी रिहिस,</para>
  <para style="q2" vid="ISA 51:2">अऊ मेंह ओला आसीस देंव अऊ ओला बहुंते झन कर देंव।<verse eid="ISA 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 51:3" />यहोवा ह सियोन ला जरूर सांति दीही</para>
  <para style="q2" vid="ISA 51:3">ओह ओकर सब खंडहरमन ऊपर दया देखाही;</para>
  <para style="q1" vid="ISA 51:3">ओह ओकर बंजर जगह ला अदन के बारी सहीं</para>
  <para style="q2" vid="ISA 51:3">अऊ ओकर उजाड़ जगह ला यहोवा के बारी सहीं बना दीही।</para>
  <para style="q1" vid="ISA 51:3">ओमा खुसी अऊ आनंद</para>
  <para style="q2" vid="ISA 51:3">धनबाद अऊ गीत गाय के सबद सुनई पड़ही।<verse eid="ISA 51:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 51:4" />“हे मोर मनखेमन, मोर बात ला सुनव;</para>
  <para style="q2" vid="ISA 51:4">हे मोर जाति के मनखेमन, मोर बात ला सुनव:</para>
  <para style="q1" vid="ISA 51:4">कानून ह मोर ले निकलके जाही;</para>
  <para style="q2" vid="ISA 51:4">मोर नियाय ह देस-देस के मनखेमन बर एक अंजोर बन जाही।<verse eid="ISA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 51:5" />मोर धरमीपन ह तेजी से लकठा म आथे,</para>
  <para style="q2" vid="ISA 51:5">मोर उद्धार ह डहार म हवय,</para>
  <para style="q2" vid="ISA 51:5">अऊ मोर भुजा ह देस-देस के मनखेमन बर नियाय लानही।</para>
  <para style="q1" vid="ISA 51:5">द्वीपमन मोर कोति देखहीं</para>
  <para style="q2" vid="ISA 51:5">अऊ मोर भुजा म आसा रखहीं।<verse eid="ISA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 51:6" />अकास कोति आंखी उठाके देखव,</para>
  <para style="q2" vid="ISA 51:6">खाल्हे धरती ला देखव;</para>
  <para style="q1" vid="ISA 51:6">अकास ह धुआं के सहीं लोप हो जाही,</para>
  <para style="q2" vid="ISA 51:6">धरती ह ओनहा के सहीं जुन्ना हो जाही</para>
  <para style="q2" vid="ISA 51:6">अऊ येमा रहइयामन माछीमन कस मर जाहीं।</para>
  <para style="q1" vid="ISA 51:6">पर मोर उद्धार ह सदाकाल तक बने रहिही,</para>
  <para style="q2" vid="ISA 51:6">अऊ मोर धरमीपन के कभू अन्त नइं होही।<verse eid="ISA 51:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 51:7" />“तुमन, जेमन सही बात ला जानथव,</para>
  <para style="q2" vid="ISA 51:7">तुमन, जेमन मोर कानून ला अपन मन म रखे हव, मोर बात ला सुनव:</para>
  <para style="q1" vid="ISA 51:7">मरनहार मनखेमन के निन्दा करई ले झन डरव</para>
  <para style="q2" vid="ISA 51:7">या ओमन के दुवारा बेजत्ती करे ले भयभीत झन होवव।<verse eid="ISA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 51:8" />काबरकि घूना ह ओमन ला ओनहा सहीं</para>
  <para style="q2" vid="ISA 51:8">अऊ कीरा ह ओमन ला ऊन सहीं खा जाही।</para>
  <para style="q1" vid="ISA 51:8">पर मोर धरमीपन ह अनंतकाल तक</para>
  <para style="q2" vid="ISA 51:8">अऊ मोर उद्धार ह पीढ़ी-पीढ़ी तक बने रहिही।”<verse eid="ISA 51:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 51:9" />हे यहोवा के भुजा, जाग, जाग,</para>
  <para style="q2" vid="ISA 51:9">अऊ बल धारन कर!</para>
  <para style="q1" vid="ISA 51:9">जाग, जब दिनमन बीतत हें,</para>
  <para style="q2" vid="ISA 51:9">जाग, पुराना पीढ़ी के मनखेमन सहीं।</para>
  <para style="q1" vid="ISA 51:9">का ये तें नइं रहय, जऊन ह राहाब ला कुटा-कुटा कर देय,</para>
  <para style="q2" vid="ISA 51:9">जऊन ह ओ बिकराल जन्तु ला छेद दीस?<verse eid="ISA 51:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 51:10" />का ये तें नइं रहय, जऊन ह समुंदर ला,</para>
  <para style="q2" vid="ISA 51:10">गहिला सागर के पानी ला सूखा दीस,</para>
  <para style="q1" vid="ISA 51:10">जऊन ह समुंदर के गहरई म एक सड़क बना दीस</para>
  <para style="q2" vid="ISA 51:10">ताकि छोंड़ाय गय मनखेमन ओ पार जा सकंय?<verse eid="ISA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 51:11" />जेमन ला यहोवा ह बचाय हवय, ओमन लहुंटके आहीं।</para>
  <para style="q2" vid="ISA 51:11">ओमन गीत गावत सियोन म आहीं;</para>
  <para style="q2" vid="ISA 51:11">सदाकाल के आनंद ह ओमन के मुड़ के मुकुट होही।</para>
  <para style="q1" vid="ISA 51:11">खुसी अऊ आनंद ले ओमन भर जाहीं,</para>
  <para style="q2" vid="ISA 51:11">अऊ दुख अऊ पीरा के अन्त हो जाही।<verse eid="ISA 51:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 51:12" />“में, हव, में ही तो तोला सांति देथंव।</para>
  <para style="q2" vid="ISA 51:12">तें कोन अस कि तें मरनहार मनखे ले डरथस,</para>
  <para style="q2" vid="ISA 51:12">ओ मानव-जाति, जेमन घांस के सहीं अंय,<verse eid="ISA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 51:13" />तें, यहोवा अपन सिरजनहार ला भुला जाथस</para>
  <para style="q2" vid="ISA 51:13">जऊन ह अकास ला तानथे</para>
  <para style="q2" vid="ISA 51:13">अऊ जऊन ह धरती के नीव धरथे,</para>
  <para style="q1" vid="ISA 51:13">अऊ तें हर दिन लगातार आतंक म जीथस,</para>
  <para style="q2" vid="ISA 51:13">ओ अतियाचारी के कोप के कारन,</para>
  <para style="q2" vid="ISA 51:13">जऊन ह बिनास करे म लगे रहिथे।</para>
  <para style="q1" vid="ISA 51:13">पर ओ अतियाचारी के कोप ह कहां हवय?<verse eid="ISA 51:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 51:14" />भयभीत कैदीमन जल्दी ही सुतंतर करे जाहीं;</para>
  <para style="q1" vid="ISA 51:14">ओमन अपन काल-कोठरी म नइं मरंय,</para>
  <para style="q2" vid="ISA 51:14">अऊ न ही ओमन ला रोटी के कमी होही।<verse eid="ISA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 51:15" />काबरकि मेंह यहोवा तुम्हर परमेसर अंव,</para>
  <para style="q2" vid="ISA 51:15">जऊन ह समुंदर ला उथल-पुथल करथे, जेकर ले ओकर लहरामन म गरजन होथे,</para>
  <para style="q2" vid="ISA 51:15">सर्वसक्तिमान यहोवा ओकर नांव ए।<verse eid="ISA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 51:16" />मेंह तोर मुहूं म अपन बचन ला डाले हंव</para>
  <para style="q2" vid="ISA 51:16">अऊ तोला अपन हांथ के छइहां म ढांपे हंव—</para>
  <para style="q1" vid="ISA 51:16">में, जऊन ह अकास ला तानथंव,</para>
  <para style="q2" vid="ISA 51:16">जऊन ह धरती के नीव डारेंव,</para>
  <para style="q2" vid="ISA 51:16">अऊ जऊन ह सियोन ले कहिथे, ‘तुमन मोर मनखे अव।’ ”<verse eid="ISA 51:16" /></para>
  <para style="s1">यहोवा के कोरोध के कटोरा</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 51:17" />हे यरूसलेम, जाग, जाग!</para>
  <para style="q2" vid="ISA 51:17">जाग उठ!</para>
  <para style="q1" vid="ISA 51:17">तें, जऊन ह यहोवा के हांथ ले</para>
  <para style="q2" vid="ISA 51:17">ओकर कोप के कटोरा म ले पीये हस,</para>
  <para style="q1" vid="ISA 51:17">तेंह कटोरा के पूरा मंद ला पी गे हस</para>
  <para style="q2" vid="ISA 51:17">जेकर से मनखे ह लड़खड़ाथे।<verse eid="ISA 51:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 51:18" />ओकर जनमे जम्मो लइका म</para>
  <para style="q2" vid="ISA 51:18">अइसे कोनो घलो नइं एं, जऊन ह ओकर अगुवई करे;</para>
  <para style="q1" vid="ISA 51:18">ओकर पाले जम्मो लइका म</para>
  <para style="q2" vid="ISA 51:18">अइसे कोनो नइं एं, जऊन ह ओकर हांथ ला थामके ले चलय।<verse eid="ISA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 51:19" />तोर ऊपर ये दू ठन बिपत्ति आय हवंय—</para>
  <para style="q2" vid="ISA 51:19">कोन ह तोला सांति दे सकत हे?—</para>
  <para style="q1" vid="ISA 51:19">उजाड़ अऊ बिनास, अकाल अऊ तलवार आ परे हवय—</para>
  <para style="q2" vid="ISA 51:19">कोन ह तोला सांति दे सकत हे?<verse eid="ISA 51:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 51:20" />तोर लइकामन मूरछित होके</para>
  <para style="q2" vid="ISA 51:20">हर गली के कोनटा म पड़े हवंय,</para>
  <para style="q2" vid="ISA 51:20">जइसे हिरन ह जाल म फंसके परे रहिथे।</para>
  <para style="q1" vid="ISA 51:20">ओमन यहोवा के कोप</para>
  <para style="q2" vid="ISA 51:20">तुम्हर परमेसर के डांट ले भर गे हवंय।<verse eid="ISA 51:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 51:21" />एकर कारन हे दुखियारी मनखे, सुन,</para>
  <para style="q2" vid="ISA 51:21">तें मतवार तो हवस, पर अंगूर के मंद पीके नइं।<verse eid="ISA 51:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 51:22" />तोर परमपरधान यहोवा, तोर परमेसर,</para>
  <para style="q2" vid="ISA 51:22">जऊन ह अपन मनखेमन के रकछा करथे, ओह ये कहत हे:</para>
  <para style="q1" vid="ISA 51:22">“देख, मेंह तोर हांथ ले ओ कटोरा ला लेय ले हंव,</para>
  <para style="q2" vid="ISA 51:22">जेकर मंद ला पीके तें लड़खड़ाथस;</para>
  <para style="q1" vid="ISA 51:22">ओ कटोरा ले, मोर कोप के कटोरा ले,</para>
  <para style="q2" vid="ISA 51:22">तेंह फेर कभू नइं पीबे।<verse eid="ISA 51:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 51:23" />में येला तोर दुख देवइयामन के हांथ म दे दूहूं,</para>
  <para style="q2" vid="ISA 51:23">जेमन तोला कहिन,</para>
  <para style="q2" vid="ISA 51:23">‘पेट के भार गिर जा, ताकि हमन तोर ऊपर रेंगन।’</para>
  <para style="q1" vid="ISA 51:23">अऊ तेंह अपन पीठ ला भुइयां सहीं कर ले हस,</para>
  <para style="q2" vid="ISA 51:23">एक गली सहीं, जेमा ले रेंगके जाथें।”<verse eid="ISA 51:23" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 51" />
  <chapter number="52" style="c" sid="ISA 52" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 52:1" />हे सियोन, जाग, जाग,</para>
  <para style="q2" vid="ISA 52:1">अपन ताकत ला धर!</para>
  <para style="q1" vid="ISA 52:1">हे पबितर नगर, यरूसलेम,</para>
  <para style="q2" vid="ISA 52:1">अपन सोभा के ओनहा ला पहिर ले।</para>
  <para style="q1" vid="ISA 52:1">काबरकि तोर भीतर खतनारहित</para>
  <para style="q2" vid="ISA 52:1">अऊ असुध मनखेमन फेर नइं आय पाहीं।<verse eid="ISA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 52:2" />अपन ऊपर ले धुर्रा ला झर्रा दे;</para>
  <para style="q2" vid="ISA 52:2">हे यरूसलेम, उठ, बिराजमान हो।</para>
  <para style="q1" vid="ISA 52:2">हे बेटी सियोन, अभी तें एक बंदी अस,</para>
  <para style="q2" vid="ISA 52:2">अपन घेंच के बंधन ला खोल दे।<verse eid="ISA 52:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3" />काबरकि यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 52:3">“तोला मुफत म बेच दिये गे रिहिस,</para>
  <para style="q2" vid="ISA 52:3">अऊ बिगर पईसा के तेंह छोंड़ाय जाबे।”<verse eid="ISA 52:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 52:4" />परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 52:4">“पहिली मोर मनखेमन मिसर देस म रहे बर गीन;</para>
  <para style="q2" vid="ISA 52:4">बाद म, अस्सूरीमन ओमन ऊपर अतियाचार करिन।<verse eid="ISA 52:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 52:5" />“अऊ अब, इहां मोर करा का हवय?” यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="ISA 52:5">“काबरकि मोर मनखेमन ला मुफत म ले जाय गे हवय,</para>
  <para style="q2" vid="ISA 52:5">अऊ जेमन ओमन ऊपर सासन करथें, ओमन ठट्ठा करथें,<note caller="+" style="f"><char style="fr" closed="false">52:5 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">सोक मनाथें</char></note>”</para>
  <para style="q2" vid="ISA 52:5">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="ISA 52:5">“अऊ दिन भर</para>
  <para style="q2" vid="ISA 52:5">लगातार मोर नांव के निन्दा होवत हे।<verse eid="ISA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 52:6" />एकर कारन मोर मनखेमन मोर नांव ला जानहीं;</para>
  <para style="q2" vid="ISA 52:6">एकर कारन ओ दिन ओमन जानहीं</para>
  <para style="q1" vid="ISA 52:6">कि येह में अंव, जऊन ह पहिले ले ये बात बताय रहेंव।</para>
  <para style="q2" vid="ISA 52:6">हव, येह में अंव।”<verse eid="ISA 52:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 52:7" />पहाड़ ऊपर कतेक सुघर होथे ओमन के अवई ह,</para>
  <para style="q2" vid="ISA 52:7">जऊन मन के पांव सुघर संदेस लेके आथें,</para>
  <para style="q1" vid="ISA 52:7">जेमन सांति के बात सुनाथें</para>
  <para style="q2" vid="ISA 52:7">जेमन सुघर संदेस लेके आथें,</para>
  <para style="q2" vid="ISA 52:7">जेमन उद्धार के घोसना करथें,</para>
  <para style="q1" vid="ISA 52:7">जेमन सियोन ले कहिथें,</para>
  <para style="q2" vid="ISA 52:7">“तोर परमेसर ह राज करथे!”<verse eid="ISA 52:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 52:8" />सुन! तोर पहरेदारमन ऊंच अवाज म कहत हें;</para>
  <para style="q2" vid="ISA 52:8">एक संग ओमन आनंद के मारे जय-जयकार करत हें।</para>
  <para style="q1" vid="ISA 52:8">जब यहोवा ह सियोन म लहुंटके आही</para>
  <para style="q2" vid="ISA 52:8">त ओमन येला अपन आंखी ले देखहीं।<verse eid="ISA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 52:9" />हे यरूसलेम के खंडहरमन,</para>
  <para style="q2" vid="ISA 52:9">एक संग आनंद के मारे जय-जयकार के गीत गावव,</para>
  <para style="q1" vid="ISA 52:9">काबरकि यहोवा ह अपन मनखेमन ला सांति देय हवय,</para>
  <para style="q2" vid="ISA 52:9">ओह यरूसलेम ला छोंड़ाय हवय।<verse eid="ISA 52:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 52:10" />यहोवा ह सब जातिमन के आघू म</para>
  <para style="q2" vid="ISA 52:10">अपन पबितर भुजा परगट करे हवय</para>
  <para style="q1" vid="ISA 52:10">अऊ धरती के छोर तक के सब मनखेमन</para>
  <para style="q2" vid="ISA 52:10">हमर परमेसर के करे गय उद्धार ला देखहीं।<verse eid="ISA 52:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 52:11" />चले जावव, चले जावव, उहां<note caller="+" style="f"><char style="fr" closed="false">52:11 </char><char style="ft" closed="false">याने कि </char><char style="fqa" closed="false">बेबिलोन</char></note> ले निकल जावव!</para>
  <para style="q2" vid="ISA 52:11">कोनो असुध चीज ला झन छुवव!</para>
  <para style="q1" vid="ISA 52:11">येमा ले बाहिर आवव अऊ सुध होवव,</para>
  <para style="q2" vid="ISA 52:11">तुमन, जेमन यहोवा के घर के चीजमन ला उठाके ले चलथव।<verse eid="ISA 52:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 52:12" />पर तुमन ला जल्दबाजी म नइं जाना हे</para>
  <para style="q2" vid="ISA 52:12">या दऊड़त नइं जाना हे;</para>
  <para style="q1" vid="ISA 52:12">काबरकि यहोवा ह तुम्हर आघू-आघू जाही,</para>
  <para style="q2" vid="ISA 52:12">इसरायल के परमेसर ह तुम्हर पाछू कोति के पहरेदार होही।<verse eid="ISA 52:12" /></para>
  <para style="s1">सेवक के दुख अऊ महिमा</para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 52:13" />देखव, मोर सेवक ह बुद्धिमानी से काम करही;</para>
  <para style="q2" vid="ISA 52:13">ओला खड़े करके ऊपर करे जाही अऊ ओला बहुंत उठाय जाही।<verse eid="ISA 52:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 52:14" />जइसन बहुंते झन ओला देखके भयभीत होईन—</para>
  <para style="q2" vid="ISA 52:14">ओकर रूप ह कोनो मनखे के रूप ले बहुंत जादा बिगड़ गे रिहिस</para>
  <para style="q2" vid="ISA 52:14">ओकर आकार ह मनखे के आकार सहीं नइं जान पड़त रिहिस—<verse eid="ISA 52:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 52:15" />वइसन ही ओह बहुंते जातिमन ला छिंचही,<note caller="+" style="f"><char style="fr" closed="false">52:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बहुंत जातिमन ओकर ऊपर अचम्भो करहीं</char></note></para>
  <para style="q2" vid="ISA 52:15">अऊ ओकर कारन राजामन अपन मुहूं ला बंद कर लीहीं।</para>
  <para style="q1" vid="ISA 52:15">काबरकि जऊन बात ओमन ला नइं बताय गीस, ओला ओमन देखहीं,</para>
  <para style="q2" vid="ISA 52:15">अऊ जऊन बात ओमन नइं सुने रिहिन, ओला ओमन समझहीं।<verse eid="ISA 52:15" /></para>
  <para style="b" />
  <chapter eid="ISA 52" />
  <chapter number="53" style="c" sid="ISA 53" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 53:1" />कोन ह हमर संदेस ऊपर बिसवास करिस</para>
  <para style="q2" vid="ISA 53:1">अऊ काकर ऊपर यहोवा के भुजबल परगट होईस?<verse eid="ISA 53:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 53:2" />ओह ओकर आघू म एक कोअंर अंकुर सहीं,</para>
  <para style="q2" vid="ISA 53:2">अऊ सूखा भुइयां म एक जरी सहीं निकलिस।</para>
  <para style="q1" vid="ISA 53:2">ओमा कोनो सुन्दरता या महानता नइं रिहिस कि हमर धियान ओकर कोति जातिस,</para>
  <para style="q2" vid="ISA 53:2">अऊ ओकर रूप म अइसन कोनो चीज नइं रिहिस, जेला हमन देखे के ईछा करतेंन।<verse eid="ISA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 53:3" />ओह मानव-जाति के दुवारा तुछ समझे गीस अऊ अस्वीकार करे गीस,</para>
  <para style="q2" vid="ISA 53:3">ओह दुखी मनखे रिहिस, अऊ पीरा ले ओकर जान-पहिचान रिहिस।</para>
  <para style="q1" vid="ISA 53:3">जइसे कोनो मनखे ले आने मनखेमन अपन चेहरा छुपाथें।</para>
  <para style="q2" vid="ISA 53:3">वइसे ओह तुछ समझे गीस अऊ हमन ओकर आदरमान नइं करेंन।<verse eid="ISA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 53:4" />सही म ओह हमर पीरा ला ले लीस</para>
  <para style="q2" vid="ISA 53:4">अऊ हमर दुख ला सहिस,</para>
  <para style="q1" vid="ISA 53:4">तभो ले हमन ओला परमेसर के दुवारा दंड,</para>
  <para style="q2" vid="ISA 53:4">ओकर दुवारा मारे-कूटे अऊ दुख देय लईक समझेंन।<verse eid="ISA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 53:5" />पर ओह हमर अपराधमन के कारन घायल करे गीस,</para>
  <para style="q2" vid="ISA 53:5">ओह हमर अधरम के काममन के कारन कुचरे गीस;</para>
  <para style="q1" vid="ISA 53:5">ओला दिये गय दंड ह हमर बर सांति लानिस,</para>
  <para style="q2" vid="ISA 53:5">अऊ ओला मिले घावमन के दुवारा हमन ला चंगई मिलथे।<verse eid="ISA 53:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 53:6" />हमन सब के सब भेड़मन कस भटक गे रहेंन,</para>
  <para style="q2" vid="ISA 53:6">हमन म ले हर एक झन अपन-अपन रद्दा धर ले रहेंन;</para>
  <para style="q1" vid="ISA 53:6">अऊ यहोवा ह हमर सब के अधरम के बोझा ला</para>
  <para style="q2" vid="ISA 53:6">ओकरे ऊपर लदक दीस।<verse eid="ISA 53:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 53:7" />ओह सताय गीस अऊ ओला पीरा दिये गीस,</para>
  <para style="q2" vid="ISA 53:7">तभो ले ओह कुछू नइं कहिस;</para>
  <para style="q1" vid="ISA 53:7">ओला बध करे बर ले जाय भेड़ सहीं ले गीन,</para>
  <para style="q2" vid="ISA 53:7">अऊ जइसने ऊन कतरइयामन के आघू म भेड़ ह चुपेचाप रहिथे,</para>
  <para style="q2" vid="ISA 53:7">वइसने ओह घलो अपन मुहूं ला नइं खोलिस।<verse eid="ISA 53:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 53:8" />अतियाचार करके अऊ दोस लगाके ओमन ओला ले गीन।</para>
  <para style="q2" vid="ISA 53:8">तभो ले ओकर पीढ़ी के कोन ह ये सब बात के बिरोध करिस?</para>
  <para style="q1" vid="ISA 53:8">ओह जीयतमन के बीच म ले उठा लिये गीस;</para>
  <para style="q2" vid="ISA 53:8">मोर मनखेमन के अपराध के कारन ओला दंड मिलिस।<verse eid="ISA 53:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 53:9" />ओकर कबर दुस्टमन के संग रखे गीस,</para>
  <para style="q2" vid="ISA 53:9">अऊ मऊत के समय ओह धनवानमन के संगी होईस,</para>
  <para style="q1" vid="ISA 53:9">हालाकि ओह कोनो हिंसा के काम नइं करे रिहिस,</para>
  <para style="q2" vid="ISA 53:9">अऊ न ही ओकर मुहूं ले कोनो छल के बात निकले रिहिस।<verse eid="ISA 53:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 53:10" />तभो ले यहोवा ला ये बने लगिस कि ओला कुचरय अऊ ओला दुख देवय,</para>
  <para style="q2" vid="ISA 53:10">अऊ हालाकि यहोवा ह ओकर जिनगी ला पाप के एक बलिदान बना देथे,</para>
  <para style="q1" vid="ISA 53:10">तभो ले ओह अपन बंस देखे बर पाही अऊ ओह बहुंत दिन तक जीयत रहिही,</para>
  <para style="q2" vid="ISA 53:10">ओकर हांथ म यहोवा के ईछा पूरा होही।<verse eid="ISA 53:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 53:11" />दुख सहे के बाद,</para>
  <para style="q2" vid="ISA 53:11">ओह जिनगी के अंजोर ला देखही अऊ संतुस्ट होही;</para>
  <para style="q1" vid="ISA 53:11">अपन गियान के दुवारा मोर धरमी सेवक ह बहुंते झन ला धरमी ठहिराही,</para>
  <para style="q2" vid="ISA 53:11">अऊ ओमन के अधरम के बोझा ला उठाही।<verse eid="ISA 53:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 53:12" />एकर कारन मेंह ओला महान मनखेमन संग एक भाग दूहूं,</para>
  <para style="q2" vid="ISA 53:12">अऊ ओह ताकतवर मनखेमन के संग लूटे चीजमन ला बांट दीही,</para>
  <para style="q1" vid="ISA 53:12">काबरकि ओह अपन जिनगी ला मऊत म ढार दीस,</para>
  <para style="q2" vid="ISA 53:12">अऊ ओह अपराधीमन संग गने गीस।</para>
  <para style="q1" vid="ISA 53:12">काबरकि ओह बहुंत झन के पाप के बोझा ला उठाईस,</para>
  <para style="q2" vid="ISA 53:12">अऊ अपराधीमन बर बिनती करिस।<verse eid="ISA 53:12" /></para>
  <chapter eid="ISA 53" />
  <chapter number="54" style="c" sid="ISA 54" />
  <para style="s1">सियोन के भविस्य के महिमा</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 54:1" />यहोवा ह कहिथे, “हे ठड़गी माईलोगन, गीत गा,</para>
  <para style="q2" vid="ISA 54:1">तें, जऊन ह कभू लइका नइं जनमाय;</para>
  <para style="q1" vid="ISA 54:1">तोला लइका जनमे के पीरा कभू नइं होईस,</para>
  <para style="q2" vid="ISA 54:1">जोर से गीत गा अऊ आनंद के मारे चिचिया;</para>
  <para style="q1" vid="ISA 54:1">काबरकि तियागे माईलोगन के लइकामन</para>
  <para style="q2" vid="ISA 54:1">बिहाता माईलोगन के लइकामन ले जादा हवंय,”</para>
  <para style="q2" vid="ISA 54:1">यहोवा ह कहत हे।<verse eid="ISA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 54:2" />“अपन तम्बू के जगह ला चाकर कर,</para>
  <para style="q2" vid="ISA 54:2">अऊ तम्बू के परदा ला चौड़ा कर,</para>
  <para style="q2" vid="ISA 54:2">अपन हांथ ला झन रोक;</para>
  <para style="q1" vid="ISA 54:2">अपन डोरीमन ला लम्बा कर,</para>
  <para style="q2" vid="ISA 54:2">अऊ खूंटीमन ला मजबूत कर।<verse eid="ISA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 54:3" />काबरकि तेंह जेवनी कोति अऊ डेरी कोति बगरबे;</para>
  <para style="q2" vid="ISA 54:3">तोर संतानमन जाति-जाति के मनखेमन ला बेदखल कर दीहीं</para>
  <para style="q2" vid="ISA 54:3">अऊ ओमन के उजरे नगरमन म बस जाहीं।<verse eid="ISA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 54:4" />“झन डर; तोला लज्जित होना नइं पड़य।</para>
  <para style="q2" vid="ISA 54:4">कलंक के बात ले झन डर; तेंह अपमानित नइं होवस।</para>
  <para style="q1" vid="ISA 54:4">तें अपन जवानी के लज्जा ला भुला जाबे</para>
  <para style="q2" vid="ISA 54:4">अऊ अपन बिधवापन के अपमान ला फेर सुरता नइं करबे।<verse eid="ISA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 54:5" />काबरकि तोर रचइया ह तोर घरवाला ए—</para>
  <para style="q2" vid="ISA 54:5">सर्वसक्तिमान यहोवा ओकर नांव ए—</para>
  <para style="q1" vid="ISA 54:5">इसरायल के पबितर परमेसर तोर छुड़इया ए;</para>
  <para style="q2" vid="ISA 54:5">ओला जम्मो धरती के परमेसर कहे जाथे।<verse eid="ISA 54:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 54:6" />यहोवा ह तोला वापिस बलाही</para>
  <para style="q2" vid="ISA 54:6">मानो तेंह एक छोंड़ दिये गय घरवाली रहय अऊ मन म दुखी हस—</para>
  <para style="q1" vid="ISA 54:6">एक अइसन घरवाली, जेकर बिहाव जवानी म ये कारन होय रिहिस</para>
  <para style="q2" vid="ISA 54:6">ताकि ओला छोंड़ दिये जावय,” तोर परमेसर ह कहत हे।<verse eid="ISA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 54:7" />“पल भर बर ही मेंह तोला छोंड़ दे रहंय,</para>
  <para style="q2" vid="ISA 54:7">पर अब बड़े दया करके में तोला वापिस लानहूं।<verse eid="ISA 54:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 54:8" />रिस म आके पल भर बर</para>
  <para style="q2" vid="ISA 54:8">मेंह तोर ले अपन मुहूं छुपा ले रहेंव,</para>
  <para style="q1" vid="ISA 54:8">पर अब अनंत करूना ले</para>
  <para style="q2" vid="ISA 54:8">में तोर ऊपर दया करहूं,”</para>
  <para style="q2" vid="ISA 54:8">तोर छुड़इया यहोवा ह कहत हे।<verse eid="ISA 54:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 54:9" />“मोर नजर म येह नूह के समय के सहीं अय,</para>
  <para style="q2" vid="ISA 54:9">जब मेंह किरिया खाय रहेंव कि नूह के समय के सहीं जल-परलय करके मेंह धरती ला फेर कभू नइं बुड़ोवंव।</para>
  <para style="q1" vid="ISA 54:9">एकरसेति अब मेंह ये किरिया खाय हंव कि फेर कभू तोर ऊपर रिस नइं करंव,</para>
  <para style="q2" vid="ISA 54:9">तोला फेर कभू नइं डांटंव।<verse eid="ISA 54:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 54:10" />चाहे पहाड़मन कांपंय</para>
  <para style="q2" vid="ISA 54:10">अऊ पहाड़ीमन हट जावंय,</para>
  <para style="q1" vid="ISA 54:10">पर तोर बर मोर अटल मया ह नइं टलय</para>
  <para style="q2" vid="ISA 54:10">अऊ न ही सांति के मोर करार ह टलही,”</para>
  <para style="q2" vid="ISA 54:10">ओ यहोवा ह कहत हे, जऊन ह तोर ऊपर दया करथे।<verse eid="ISA 54:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 54:11" />“हे दुखियारी सहर, तें जऊन ह आंधी ले सताय गय अऊ जऊन ला सांति नइं मिलिस,</para>
  <para style="q2" vid="ISA 54:11">में तोला बहुंत कीमती पथरामन ले फेर बनाहूं,</para>
  <para style="q2" vid="ISA 54:11">अऊ तोर नीवमन ला नीलमनि ले बनाहूं।<verse eid="ISA 54:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 54:12" />में तोर दीवारमन के कलस ला मूंगा ले,</para>
  <para style="q2" vid="ISA 54:12">तोर दुवारमन ला चमकत मनि ले</para>
  <para style="q2" vid="ISA 54:12">अऊ तोर जम्मो दीवारमन ला कीमती पथरामन ले बनाहूं।<verse eid="ISA 54:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 54:13" />तोर जम्मो लइकामन यहोवा के दुवारा सिखोय जाहीं,</para>
  <para style="q2" vid="ISA 54:13">अऊ ओमन ला बड़े सांति मिलही।<verse eid="ISA 54:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 54:14" />तोला धरमीपन म स्थिर करे जाही:</para>
  <para style="q1" vid="ISA 54:14">अतियाचार ह तोर ले दूरिहा होही;</para>
  <para style="q2" vid="ISA 54:14">तोला कोनो डर-भय नइं होही।</para>
  <para style="q1" vid="ISA 54:14">आतंक ला तोर ले बहुंत दूरिहा कर दिये जाही;</para>
  <para style="q2" vid="ISA 54:14">येह तोर लकठा म नइं आही।<verse eid="ISA 54:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 54:15" />कहूं कोनो तोर ऊपर हमला करथे, त जान ले, येह मोर काम नइं होही;</para>
  <para style="q2" vid="ISA 54:15">जऊन ह घलो तोर ऊपर हमला करथे, ओह तोर सरन म आही।<verse eid="ISA 54:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 54:16" />“देख, येह में अंव, जऊन ह लोहार ला बनाईस</para>
  <para style="q2" vid="ISA 54:16">जऊन ह धुकके कोइला म आगी लगाथे</para>
  <para style="q1" vid="ISA 54:16">अऊ सही काम करे बर गढ़के एक हथियार बनाथे।</para>
  <para style="q2" vid="ISA 54:16">अऊ येह में अंव, जऊन ह नास करइया ला बनाथे कि ओह बिनास के बदला लेवय;<verse eid="ISA 54:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 54:17" />तोर बिरूध बनाय गे कोनो घलो हथियार जय नइं पा सकय,</para>
  <para style="q2" vid="ISA 54:17">अऊ तें हर ओ मनखे ला लबरा साबित करबे, जऊन ह तोर ऊपर दोस लगाही।</para>
  <para style="q1" vid="ISA 54:17">येह यहोवा के सेवकमन ला मिले भाग ए,</para>
  <para style="q2" vid="ISA 54:17">अऊ येह मोर कोति ले ओमन बर नियाय के बात ए,”</para>
  <para style="q2" vid="ISA 54:17">यहोवा ह घोसना करत हे।<verse eid="ISA 54:17" /></para>
  <chapter eid="ISA 54" />
  <chapter number="55" style="c" sid="ISA 55" />
  <para style="s1">पीयासन मनखेमन बर नेवता</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 55:1" />“हे सब पीयासन मनखेमन,</para>
  <para style="q2" vid="ISA 55:1">पानी के तीर म आवव;</para>
  <para style="q1" vid="ISA 55:1">अऊ जेमन करा रूपिया नइं ए,</para>
  <para style="q2" vid="ISA 55:1">ओमन घलो आवंय, बिसावंय अऊ खावंय!</para>
  <para style="q1" vid="ISA 55:1">आवव, अंगूर के मंद अऊ दूध</para>
  <para style="q2" vid="ISA 55:1">बिगर रूपिया अऊ बिगर दाम के ले जावव।<verse eid="ISA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 55:2" />जऊन ह खाय के चीज नो हय, ओकर बर काबर रूपिया खरच करन,</para>
  <para style="q2" vid="ISA 55:2">अऊ जेकर ले पेट नइं भरय, ओकर बर काबर मेहनत करन?</para>
  <para style="q1" vid="ISA 55:2">सुनव, मोर बात ला सुनव, अऊ ओ चीज ला खावव जऊन ह बने अय,</para>
  <para style="q2" vid="ISA 55:2">अऊ तुमन खाय के सबले बढ़िया चीजमन के आनंद उठाहू।<verse eid="ISA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 55:3" />कान लगावव, अऊ मोर करा आवव;</para>
  <para style="q2" vid="ISA 55:3">सुनव, ताकि तुमन जीयत रहव।</para>
  <para style="q1" vid="ISA 55:3">में तुम्हर संग एक सदाकाल के करार करहूं,</para>
  <para style="q2" vid="ISA 55:3">याने कि मोर बिसवासयोग्य मया, जेकर वायदा मेंह दाऊद ले करे रहेंव।<verse eid="ISA 55:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 55:4" />सुनव, मेंह ओला राज-राज के मनखेमन बर एक गवाह,</para>
  <para style="q2" vid="ISA 55:4">एक सासन करइया अऊ हुकूम देवइया ठहिराय हंव।<verse eid="ISA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 55:5" />खचित तें अइसन जातिमन ला बलाबे, जेमन ला तें नइं जानस,</para>
  <para style="q2" vid="ISA 55:5">अऊ जऊन जातिमन ला तें नइं जानस, ओमन तोर करा दऊड़त आहीं,</para>
  <para style="q1" vid="ISA 55:5">येह यहोवा तोर परमेसर,</para>
  <para style="q2" vid="ISA 55:5">इसरायल के पबितर परमेसर के कारन होही,</para>
  <para style="q2" vid="ISA 55:5">काबरकि ओह तोला सोभायमान करे हवय।”<verse eid="ISA 55:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 55:6" />जब तक यहोवा मिल सकथे, तब तक ओकर खोज म रहव;</para>
  <para style="q2" vid="ISA 55:6">जब तक ओह लकठा म हवय, तब तक ओला पुकारव।<verse eid="ISA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 55:7" />दुस्ट ह अपन चालचलन</para>
  <para style="q2" vid="ISA 55:7">अऊ अधरमी ह अपन सोच-बिचार छोंड़य।</para>
  <para style="q1" vid="ISA 55:7">ओमन यहोवा कोति फिरंय, अऊ ओह ओमन ऊपर दया करही,</para>
  <para style="q2" vid="ISA 55:7">अऊ हमर परमेसर कोति फिरंय, काबरकि ओह बिगर कोनो दाम के छेमा करही।<verse eid="ISA 55:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 55:8" />“काबरकि मोर बिचार अऊ तुम्हर बिचार एक सहीं नो हंय,</para>
  <para style="q2" vid="ISA 55:8">न ही तुम्हर चाल अऊ मोर चाल एक सहीं अंय,”</para>
  <para style="q2" vid="ISA 55:8">यहोवा ह घोसना करत हे।<verse eid="ISA 55:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 55:9" />“जइसे अकास ह धरती ले ऊंच हवय,</para>
  <para style="q2" vid="ISA 55:9">वइसे मोर चाल ह तुम्हर चाल ले</para>
  <para style="q2" vid="ISA 55:9">अऊ मोर सोच-बिचार ह तुम्हर सोच-बिचार ले बहुंत ऊंच हवय।<verse eid="ISA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 55:10" />जइसे बरसा अऊ बरफ</para>
  <para style="q2" vid="ISA 55:10">अकास ले गिरथें,</para>
  <para style="q1" vid="ISA 55:10">अऊ धरती म बिगर पानी पलोय</para>
  <para style="q2" vid="ISA 55:10">अऊ येमा बिगर बीजा के जामय अऊ बढ़य,</para>
  <para style="q1" vid="ISA 55:10">अकास म वापिस नइं लहुंटंय,</para>
  <para style="q2" vid="ISA 55:10">जेकर ले बोवइया ला बीजा अऊ खवइया ला रोटी मिलथे,<verse eid="ISA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 55:11" />वइसे ही मोर बचन घलो अय, जऊन ह मोर मुहूं ले निकलथे:</para>
  <para style="q2" vid="ISA 55:11">येह मोर करा खाली नइं लहुंटय,</para>
  <para style="q1" vid="ISA 55:11">पर जो मोर ईछा हे, ओला पूरा करही</para>
  <para style="q2" vid="ISA 55:11">अऊ जऊन काम बर मेंह येला पठोय रहेंव, ओला येह पूरा करही।<verse eid="ISA 55:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 55:12" />काबरकि तुमन आनंद के संग निकलहू,</para>
  <para style="q2" vid="ISA 55:12">अऊ सांति के संग अमराय जाहू;</para>
  <para style="q1" vid="ISA 55:12">पहाड़ अऊ पहाड़ीमन तुम्हर आघू म</para>
  <para style="q2" vid="ISA 55:12">जय-जयकार के गीत गाहीं,</para>
  <para style="q1" vid="ISA 55:12">अऊ मैदान के जम्मो रूखमन</para>
  <para style="q2" vid="ISA 55:12">आनंद के मारे ताली बजाहीं।<verse eid="ISA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 55:13" />कंटिली झाड़ी के बदले सनोवर रूख उगही,</para>
  <para style="q2" vid="ISA 55:13">अऊ जंगली पऊधा के बदले मेंहदी के रूख बढ़ही।</para>
  <para style="q1" vid="ISA 55:13">येह यहोवा के नांव बर होही,</para>
  <para style="q2" vid="ISA 55:13">सदाकाल के एक चिनहां बर होही,</para>
  <para style="q2" vid="ISA 55:13">जऊन ह सदाकाल तक बने रहिही।”<verse eid="ISA 55:13" /></para>
  <chapter eid="ISA 55" />
  <chapter number="56" style="c" sid="ISA 56" />
  <para style="s1">दूसरमन बर उद्धार</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 56:1">“नियाय ला बनाय रखव</para>
  <para style="q2" vid="ISA 56:1">अऊ ओ काम करव, जऊन ह सही ए,</para>
  <para style="q1" vid="ISA 56:1">काबरकि में जल्दी ही तुम्हर उद्धार करहूं,</para>
  <para style="q2" vid="ISA 56:1">अऊ मोर धरमीपन ह जल्दी परगट होही।<verse eid="ISA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 56:2" />धइन ए ओ मनखे, जऊन ह ये करथे—</para>
  <para style="q2" vid="ISA 56:2">ओ मनखे, जऊन ह येमा अटल रहिथे,</para>
  <para style="q1" vid="ISA 56:2">जऊन ह येकर धियान रखथे कि बिसराम दिन ह अपबितर झन होवय,</para>
  <para style="q2" vid="ISA 56:2">अऊ अपन हांथ ला कोनो घलो बुरई के काम करे ले रोकथे।”<verse eid="ISA 56:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 56:3" />जऊन परदेसी ह यहोवा ले जुड़े हवय, ओह ये झन कहय,</para>
  <para style="q2" vid="ISA 56:3">“यहोवा ह मोला अपन मनखेमन ले जरूर अलग कर दीही।”</para>
  <para style="q1" vid="ISA 56:3">अऊ कोनो कोचिया<note caller="+" style="f"><char style="fr" closed="false">56:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">हिजड़ा</char></note> ये सिकायत झन करय,</para>
  <para style="q2" vid="ISA 56:3">“मेंह तो सिरिप एक सूखा रूख अंव।”<verse eid="ISA 56:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 56:4" />काबरकि यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 56:4">“ओ कोचियामन, जेमन मोर बिसराम दिन ला मानथें,</para>
  <para style="q2" vid="ISA 56:4">जेमन ओ चीज ला चुनथें, जऊन ह मोला बने लगथे</para>
  <para style="q2" vid="ISA 56:4">अऊ मोर करार म मजबूती से बने रहिथें—<verse eid="ISA 56:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 56:5" />ओमन ला में अपन मंदिर अऊ येकर भीथीमन के भीतर</para>
  <para style="q2" vid="ISA 56:5">एक स्मारक अऊ एक नांव दूहूं</para>
  <para style="q2" vid="ISA 56:5">जऊन ह बेटा अऊ बेटीमन ले कहीं उत्तम होही;</para>
  <para style="q1" vid="ISA 56:5">मेंह ओमन ला सदाकाल के एक नांव दूहूं</para>
  <para style="q2" vid="ISA 56:5">जऊन ह हमेसा बने रहिही।<verse eid="ISA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 56:6" />अऊ परदेसी, जेमन अपनआप ला यहोवा ले जोड़े रखथें</para>
  <para style="q2" vid="ISA 56:6">ताकि ओकर सेवा-टहल करंय,</para>
  <para style="q1" vid="ISA 56:6">यहोवा के नांव ले मया रखंय,</para>
  <para style="q2" vid="ISA 56:6">अऊ ओकर सेवक बनंय,</para>
  <para style="q1" vid="ISA 56:6">ओ जम्मो जेमन धियान रखथें कि बिसराम दिन ह अपबितर झन होवय</para>
  <para style="q2" vid="ISA 56:6">अऊ जेमन मोर करार म मजबूती से बने रहिथें—<verse eid="ISA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 56:7" />ओमन ला में अपन पबितर पहाड़ म लानहूं</para>
  <para style="q2" vid="ISA 56:7">अऊ ओमन ला पराथना के मोर घर म आनंदित करहूं।</para>
  <para style="q1" vid="ISA 56:7">ओमन के होम-बलिदान अऊ मेल-बलिदान</para>
  <para style="q2" vid="ISA 56:7">मोर बेदी ऊपर गरहन करे जाहीं;</para>
  <para style="q1" vid="ISA 56:7">काबरकि मोर भवन ह जम्मो जाति के मनखेमन बर</para>
  <para style="q2" vid="ISA 56:7">पराथना के घर कहे जाही।”<verse eid="ISA 56:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 56:8" />परमपरधान यहोवा ह घोसना करत हे—</para>
  <para style="q2" vid="ISA 56:8">जऊन ह इसरायल ले निकाले गय मनखेमन ला इकट्ठा करथे:</para>
  <para style="q1" vid="ISA 56:8">“जेमन इकट्ठा करे गे हवंय</para>
  <para style="q2" vid="ISA 56:8">ओमन के संग मेंह आने मन ला घलो इकट्ठा करके मिला दूहूं।”<verse eid="ISA 56:8" /></para>
  <para style="s1">दुस्टमन के बिरूध परमेसर के चेतउनी</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 56:9" />हे मैदान के जम्मो पसुमन, आवव,</para>
  <para style="q2" vid="ISA 56:9">हे जंगल के जम्मो पसुमन, आवव अऊ खावव!<verse eid="ISA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 56:10" />इसरायल के पहरेदारमन अंधवा अंय,</para>
  <para style="q2" vid="ISA 56:10">ओ जम्मो म गियान के कमी हवय;</para>
  <para style="q1" vid="ISA 56:10">ओमन सब के सब कोंदा कुकुर अंय,</para>
  <para style="q2" vid="ISA 56:10">जेमन भूंके नइं सकंय;</para>
  <para style="q1" vid="ISA 56:10">ओमन पड़े रहिथें अऊ सपना देखथें,</para>
  <para style="q2" vid="ISA 56:10">ओमन ला नींद बहुंत बने लगथे।<verse eid="ISA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 56:11" />ओमन बहुंत खानेवाला कुकुर अंय;</para>
  <para style="q2" vid="ISA 56:11">ओमन के पेट कभू नइं भरय।</para>
  <para style="q1" vid="ISA 56:11">ओमन अइसन चरवाहा अंय, जेमन म समझ नइं ए;</para>
  <para style="q2" vid="ISA 56:11">ओमन जम्मो अपन खुद के डहार म चलथें,</para>
  <para style="q2" vid="ISA 56:11">ओमन अपन खुद के फायदा ला देखथें।<verse eid="ISA 56:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 56:12" />ओमा के हर एक ह चिचियाके कहिथे, “आवव, में अंगूर के मंद लेके आवत हंव!</para>
  <para style="q2" vid="ISA 56:12">आवव, हमन छकके मंद पीयन!</para>
  <para style="q1" vid="ISA 56:12">अऊ कल के दिन घलो आज के सहीं होही,</para>
  <para style="q2" vid="ISA 56:12">या येकर ले घलो बेहतर होही।”<verse eid="ISA 56:12" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 56" />
  <chapter number="57" style="c" sid="ISA 57" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 57:1" />धरमी जन नास हो जाथें,</para>
  <para style="q2" vid="ISA 57:1">अऊ कोनो ये बात के चिंता नइं करंय;</para>
  <para style="q1" vid="ISA 57:1">भक्त जनमन उठा लिये जाथें,</para>
  <para style="q2" vid="ISA 57:1">अऊ कोनो नइं समझंय</para>
  <para style="q1" vid="ISA 57:1">धरमी जन एकर बर उठा लिये जाथें</para>
  <para style="q2" vid="ISA 57:1">ताकि अवइया बिपत्ति ले बांच जावंय।<verse eid="ISA 57:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 57:2" />जेमन सीधा चाल चलथें</para>
  <para style="q2" vid="ISA 57:2">ओमन सांति पाथें;</para>
  <para style="q2" vid="ISA 57:2">ओमन आराम पाथें, जब ओमन के मऊत होथे।<verse eid="ISA 57:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 57:3" />“पर तुमन—इहां आवव, हे जादूगरनी के लइकामन,</para>
  <para style="q2" vid="ISA 57:3">हे बेभिचारी अऊ बेस्यामन के संतान!<verse eid="ISA 57:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 57:4" />तुमन काकर हंसी उड़ात हव?</para>
  <para style="q2" vid="ISA 57:4">काकर ऊपर तुमन हंसत हव</para>
  <para style="q2" vid="ISA 57:4">अऊ कोन ला तुमन अपन जीभ देखात हव?</para>
  <para style="q1" vid="ISA 57:4">का तुमन बिदरोही</para>
  <para style="q2" vid="ISA 57:4">अऊ लबरामन के संतान नो हव?<verse eid="ISA 57:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 57:5" />तुमन बलूत रूखमन के बीच</para>
  <para style="q2" vid="ISA 57:5">अऊ हर फईले रूखमन के खाल्हे म कामातुर होथव;</para>
  <para style="q1" vid="ISA 57:5">तुमन अपन लइकामन ला घाटी म</para>
  <para style="q2" vid="ISA 57:5">अऊ बाहिर निकले चट्टानमन के खाल्हे म बलिदान चघाथव।<verse eid="ISA 57:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 57:6" />घाटी के चिकना पथरामन के बीच मूरतीमन तुम्हर हिस्सा अंय;</para>
  <para style="q2" vid="ISA 57:6">वास्तव म, ओमन तुम्हर भाग अंय।</para>
  <para style="q1" vid="ISA 57:6">हव, ओमन बर तुमन पेय-बलिदान</para>
  <para style="q2" vid="ISA 57:6">अऊ अन्न-बलिदान चघाय हव।</para>
  <para style="q2" vid="ISA 57:6">ये सब ला देखके घलो, का में सांत हो जावंव?<verse eid="ISA 57:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 57:7" />तुमन एक ठन ऊंचहा अऊ उठे हुए पहाड़ी ऊपर अपन बिस्तर बिछाय हवव;</para>
  <para style="q2" vid="ISA 57:7">उहां तुमन अपन बलिदान चघाय बर गे रहेव।<verse eid="ISA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 57:8" />अपन कपाट अऊ अपन चौखटमन के पाछू म</para>
  <para style="q2" vid="ISA 57:8">तुमन अपन मूरती-पूजा के चीजमन ला रखे हव।</para>
  <para style="q1" vid="ISA 57:8">मोला छोंड़के, तुमन अपन बिस्तर ला खुला रखे हव,</para>
  <para style="q2" vid="ISA 57:8">तुमन येकर ऊपर चघके येला चौड़ा कर ले हव;</para>
  <para style="q1" vid="ISA 57:8">तुमन ओमन ले एक समझौता कर ले हव, जेमन के बिस्तर तुमन ला बने लगथे,</para>
  <para style="q1" vid="ISA 57:8">अऊ तुमन ओमन के नंगरा देहें ला काम-वासना से देखे हव।<verse eid="ISA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 57:9" />तें जैतून तेल लेके मोलेक<note caller="+" style="f"><char style="fr" closed="false">57:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">राजा</char></note> करा गे रहे</para>
  <para style="q2" vid="ISA 57:9">अऊ अपन खुसबू ला बढ़ाय।</para>
  <para style="q1" vid="ISA 57:9">तेंह अपन दूतमन<note caller="+" style="f"><char style="fr" closed="false">57:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मूरतीमन</char></note> ला बहुंत दूरिहा तक पठोय;</para>
  <para style="q2" vid="ISA 57:9">तें खाल्हे अधोलोक तक चले गेय!<verse eid="ISA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 57:10" />तें यातरा के दुवारा अपनआप ला थका लेय,</para>
  <para style="q2" vid="ISA 57:10">पर तेंह ये नइं कहे, ‘येह बेकार अय।’</para>
  <para style="q1" vid="ISA 57:10">तोर म नवां बल के संचार होईस,</para>
  <para style="q2" vid="ISA 57:10">एकर कारन तेंह नइं थके।<verse eid="ISA 57:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 57:11" />“तेंह काकर डर ले अतेक भय खाय हस अऊ डर गे हस</para>
  <para style="q2" vid="ISA 57:11">कि तेंह मोर ले सच नइं बोलय,</para>
  <para style="q1" vid="ISA 57:11">अऊ मोला सुरता नइं राखे,</para>
  <para style="q2" vid="ISA 57:11">न ही येकर ऊपर धियान देय?</para>
  <para style="q1" vid="ISA 57:11">येकर कारन ये नो हय कि में बहुंत समय ले चुपेचाप हंव</para>
  <para style="q2" vid="ISA 57:11">जेकर ले तें मोला नइं डरस?<verse eid="ISA 57:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 57:12" />मेंह तोर धरमीपन अऊ तोर करम ला परगट कर दूहूं,</para>
  <para style="q2" vid="ISA 57:12">पर ओमन ले तोला कुछू फायदा नइं होवय।<verse eid="ISA 57:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 57:13" />जब तें मदद बर पुकारथस,</para>
  <para style="q2" vid="ISA 57:13">त तोर जमा करे गय मूरतीमन तोला बचावंय!</para>
  <para style="q1" vid="ISA 57:13">हवा ह ओ जम्मो ला दूरिहा ले जाही,</para>
  <para style="q2" vid="ISA 57:13">सिरिप एक सांस ह ओमन ला उड़िहा ले जाही।</para>
  <para style="q1" vid="ISA 57:13">पर जऊन ह मोर सरन लीही</para>
  <para style="q2" vid="ISA 57:13">ओह देस के उत्तराधिकारी होही</para>
  <para style="q2" vid="ISA 57:13">अऊ मोर पबितर पहाड़ ह ओकर अधिकार म रहिही।”<verse eid="ISA 57:13" /></para>
  <para style="s1">टूटे मन बर सांति</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 57:14" />अऊ ये कहे जाही:</para>
  <para style="q1" vid="ISA 57:14">“बनावव, बनावव, सड़क ला तियार करव!</para>
  <para style="q2" vid="ISA 57:14">मोर मनखेमन के रद्दा ले बाधामन ला हटावव।”<verse eid="ISA 57:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 57:15" />काबरकि ऊंच अऊ उठाय गय परमेसर ह ये कहत हे—</para>
  <para style="q2" vid="ISA 57:15">ओ जऊन ह सदा जीयत हे, जेकर नांव पबितर ए:</para>
  <para style="q1" vid="ISA 57:15">“मेंह एक ऊंच अऊ पबितर स्थान म रहिथंव,</para>
  <para style="q2" vid="ISA 57:15">पर ओकर संग घलो रहिथंव, जऊन ह टूटे मन के अऊ आतमा म नम्र ए,</para>
  <para style="q1" vid="ISA 57:15">कि नम्र मन के आतमा</para>
  <para style="q2" vid="ISA 57:15">अऊ टूटे मन वाले के हिरदय ला खुस करंव।<verse eid="ISA 57:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 57:16" />में हमेसा ओमन ऊपर दोस नइं लगावंव,</para>
  <para style="q2" vid="ISA 57:16">न ही हमेसा मेंह गुस्सा करहूं,</para>
  <para style="q1" vid="ISA 57:16">काबरकि तब ओ मोर बनाय मनखेमन</para>
  <para style="q2" vid="ISA 57:16">मोर कारन मूरछित हो जाहीं।<verse eid="ISA 57:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 57:17" />ओमन के पापी लालची सुभाव के कारन मेंह बहुंत गुस्सा करेंव;</para>
  <para style="q2" vid="ISA 57:17">में ओमन ला दंड देंय, अऊ गुस्सा म अपन चेहरा छुपांय;</para>
  <para style="q2" vid="ISA 57:17">तभो ले ओमन अपन मन के रद्दा म चलते रिहिन।<verse eid="ISA 57:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 57:18" />में ओमन के चालचलन ला देखे हंव, तभो ले ओमन ला चंगा करहूं;</para>
  <para style="q2" vid="ISA 57:18">मेंह ओमन ला ले चलहूं अऊ इसरायल के सोक करइयामन ला सांति दूहूं,<verse eid="ISA 57:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="ISA 57:19" />मेंह ओमन के ओंठ म परसंसा के बात लानहूं।</para>
  <para style="q1" vid="ISA 57:19">सांति, जेमन दूरिहा अऊ लकठा म हवंय, दूनों ला सांति मिलय,”</para>
  <para style="q2" vid="ISA 57:19">यहोवा ह कहत हे।</para>
  <para style="q1" vid="ISA 57:19">“अऊ में ओमन ला चंगा करहूं।”<verse eid="ISA 57:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 57:20" />पर दुस्टमन लहरावत समुंदर सहीं अंय,</para>
  <para style="q2" vid="ISA 57:20">जऊन ह आराम नइं कर सकय,</para>
  <para style="q2" vid="ISA 57:20">अऊ जेकर लहरामन मईला अऊ चीखला उछालथें।<verse eid="ISA 57:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 57:21" />“दुस्टमन बर सांति नइं ए,” मोर परमेसर ह कहत हे।<verse eid="ISA 57:21" /></para>
  <chapter eid="ISA 57" />
  <chapter number="58" style="c" sid="ISA 58" />
  <para style="s1">सही उपास</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 58:1" />“गला फारके चिचियावव, दबाके झन रखव।</para>
  <para style="q2" vid="ISA 58:1">तुरही के सहीं अपन अवाज ला ऊंचहा करव।</para>
  <para style="q1" vid="ISA 58:1">मोर मनखेमन<note caller="+" style="f"><char style="fr" closed="false">58:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">इसरायली मनखे</char></note> ला ओमन के बिदरोह के काम बतावव</para>
  <para style="q2" vid="ISA 58:1">अऊ याकूब के संतानमन ला ओमन के पाप जता दव।<verse eid="ISA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 58:2" />काबरकि ओमन रोज-रोज मोर मेर आथें;</para>
  <para style="q2" vid="ISA 58:2">अइसे लगथे कि ओमन मोर रसता ला जाने बर उत्सुक हवंय,</para>
  <para style="q1" vid="ISA 58:2">मानो ओमन एक अइसे जाति अंय, जऊन ह सही काम ला करथे</para>
  <para style="q2" vid="ISA 58:2">अऊ अपन परमेसर के हुकूममन ला नइं छोंड़े हवय।</para>
  <para style="q1" vid="ISA 58:2">ओमन मोला सिरिप फैसला के बारे म पुछथें</para>
  <para style="q2" vid="ISA 58:2">अऊ परमेसर बर उत्सुक जान पड़थें कि ओह ओमन के लकठा म आवय।<verse eid="ISA 58:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 58:3" />ओमन कहिथें, ‘का कारन ए कि हमन तो उपास राखेंन,</para>
  <para style="q2" vid="ISA 58:3">पर तेंह येला नइं देखे?</para>
  <para style="q1" vid="ISA 58:3">का कारन ए कि हमन अपनआप ला नम्र करे हन,</para>
  <para style="q2" vid="ISA 58:3">पर तेंह धियान नइं दे हस?’</para>
  <para style="b" vid="ISA 58:3" />
  <para style="q1" vid="ISA 58:3">“काबरकि उपास के दिन म तुमन अपन मन मुताबिक करथव</para>
  <para style="q2" vid="ISA 58:3">अऊ अपन बनिहारमन के सोसन करथव।<verse eid="ISA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 58:4" />तुम्हर उपास ह लड़ई-झगरा</para>
  <para style="q2" vid="ISA 58:4">अऊ एक-दूसर ला मुक्का मारके झगरा करे म खतम होथे।</para>
  <para style="q1" vid="ISA 58:4">जइसन उपास तुमन आजकल रखथव, वइसन झन रखव,</para>
  <para style="q2" vid="ISA 58:4">अइसन उपास रखके तुमन आसा करथव कि तुम्हर अवाज ला ऊपर म सुने जाही।<verse eid="ISA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 58:5" />का ये किसम के उपास ले में खुस होथंव,</para>
  <para style="q2" vid="ISA 58:5">कि सिरिप एके दिन बर मनखेमन अपनआप ला दीन करंय?</para>
  <para style="q1" vid="ISA 58:5">का येह, नरकट पऊधा सहीं कोनो मनखे के सिरिप अपन मुड़ ला झुकाना ए?</para>
  <para style="q2" vid="ISA 58:5">अऊ सिरिप बोरा के ओनहा अऊ राख म लेटना ए?</para>
  <para style="q1" vid="ISA 58:5">का येला तुमन उपास कहिथव,</para>
  <para style="q2" vid="ISA 58:5">एक अइसन दिन, जेला यहोवा स्वीकार करथे?<verse eid="ISA 58:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 58:6" />“का येह ओ किसम के उपास नो हय, जेकर ले में खुस होथंव:</para>
  <para style="q1" vid="ISA 58:6">कि अनियाय के बंधना ला टोर दिये जावय</para>
  <para style="q2" vid="ISA 58:6">अऊ जुड़ा के बंधना ला खोलके</para>
  <para style="q1" vid="ISA 58:6">अतियाचार सहइयामन ला सुतंतर कर दिये जावय</para>
  <para style="q2" vid="ISA 58:6">अऊ हर एक जुड़ा ला टोर दिये जावय?<verse eid="ISA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 58:7" />का येह ओ किसम के उपास नो हय, कि भूखन मन के संग खाना बांटे जावय</para>
  <para style="q2" vid="ISA 58:7">अऊ गरीब घुमंतू ला आसरय दिये जावय—</para>
  <para style="q1" vid="ISA 58:7">जब तुमन नंगरामन ला देखथव, त ओमन ला ओनहा पहिरावव,</para>
  <para style="q2" vid="ISA 58:7">अऊ अपन खुद के रिस्तेदारमन ले मुहूं झन मोड़व?<verse eid="ISA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 58:8" />तब तुम्हर अंजोर ह बिहान पहाय सहीं चमकही,</para>
  <para style="q2" vid="ISA 58:8">अऊ तुम्हर चंगई ह जल्दी दिखही;</para>
  <para style="q1" vid="ISA 58:8">तब तुम्हर धरमीपन<note caller="+" style="f"><char style="fr" closed="false">58:8 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">तुम्हर </char><char style="fqa" closed="false">धरमी जन</char></note> ह तुम्हर आघू-आघू जाही,</para>
  <para style="q2" vid="ISA 58:8">अऊ यहोवा के तेज ह तुम्हर पाछू तुम्हर रकछा करही।<verse eid="ISA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 58:9" />तब तुमन पुकारहू, अऊ यहोवा जबाब दीही;</para>
  <para style="q2" vid="ISA 58:9">तुमन मदद बर बिनती करहू, अऊ ओह कहिही: में इहां हंव।</para>
  <para style="b" vid="ISA 58:9" />
  <para style="q1" vid="ISA 58:9">“यदि तें अंधेर करई के जुड़ा के संग</para>
  <para style="q2" vid="ISA 58:9">अंगरी उठई अऊ दुस्ट बात करई के आदत ला छोंड़ देबे,<verse eid="ISA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 58:10" />अऊ यदि तें भूखन मनखे के सहायता करबे</para>
  <para style="q2" vid="ISA 58:10">अऊ दीन दुखीमन के दुख ला दूर करबे,</para>
  <para style="q1" vid="ISA 58:10">तब अंधियार म तोर अंजोर ह चमकही,</para>
  <para style="q2" vid="ISA 58:10">अऊ तोर रथिया ह मंझनियां सहीं अंजोर हो जाही।<verse eid="ISA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 58:11" />यहोवा हमेसा तोर अगुवई करही;</para>
  <para style="q2" vid="ISA 58:11">ओह सूखा भुइयां म तोर जरूरत ला पूरा करही</para>
  <para style="q2" vid="ISA 58:11">अऊ तोर हाड़ामन ला मजबूत करही।</para>
  <para style="q1" vid="ISA 58:11">तें बने पानी पलोय एक बारी सहीं होबे,</para>
  <para style="q2" vid="ISA 58:11">अऊ अइसन सोता सहीं होबे, जेकर पानी कभू नइं सूखावय।<verse eid="ISA 58:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 58:12" />तोर मनखेमन पुराना उजरे जगहमन ला फेर बसाहीं</para>
  <para style="q2" vid="ISA 58:12">अऊ पीढ़ी-पीढ़ी ले माढ़े नीवमन म घर बनाहीं;</para>
  <para style="q1" vid="ISA 58:12">तोला टूटहा दीवारमन ला फेर बनानेवाला,</para>
  <para style="q2" vid="ISA 58:12">अऊ घरमन के संग गलीमन ला ठीक करनेवाला कहे जाही।<verse eid="ISA 58:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 58:13" />“यदि तें बिसराम दिन ला असुध नइं करबे</para>
  <para style="q2" vid="ISA 58:13">अऊ मोर ओ पबितर दिन म अपन ईछा पूरा करे के कोसिस नइं करबे,</para>
  <para style="q1" vid="ISA 58:13">यदि बिसराम दिन ला आनंद के दिन</para>
  <para style="q2" vid="ISA 58:13">अऊ यहोवा के पबितर दिन मानके आदर करबे,</para>
  <para style="q1" vid="ISA 58:13">अऊ यदि तें येकर आदर करके ओ दिन अपन मुताबिक नइं चलबे</para>
  <para style="q2" vid="ISA 58:13">अऊ अपन ईछा पूरा नइं करबे या बेकार बात नइं बोलबे,<verse eid="ISA 58:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 58:14" />त तोला यहोवा के कारन आनंद मिलही,</para>
  <para style="q2" vid="ISA 58:14">अऊ में तोला देस के ऊंचहा जगह म बिजयी मनखे सहीं चलाहूं</para>
  <para style="q2" vid="ISA 58:14">अऊ तोर पुरखा याकूब के निज भाग के ऊपज ले तोला भोज खवाहूं।”</para>
  <para style="q1" vid="ISA 58:14">यहोवा ह ये बात ला कहे हवय।<verse eid="ISA 58:14" /></para>
  <chapter eid="ISA 58" />
  <chapter number="59" style="c" sid="ISA 59" />
  <para style="s1">पाप, पछताप अऊ छुटकारा</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 59:1" />खचित, यहोवा के हांथ अइसन छोटे नइं हो गे हवय कि तुम्हर उद्धार नइं कर सकय,</para>
  <para style="q2" vid="ISA 59:1">न ही ओह अइसन भैंरा हो गे हवय कि सुन नइं सकय।<verse eid="ISA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 59:2" />पर तुम्हर अधरम के काममन</para>
  <para style="q2" vid="ISA 59:2">तुमन ला तुम्हर परमेसर ले अलग कर दे हवंय;</para>
  <para style="q1" vid="ISA 59:2">तुम्हर पापमन ओकर मुहूं ला तुम्हर ले छुपा रखे हें,</para>
  <para style="q2" vid="ISA 59:2">जेकर कारन ओह नइं सुनय।<verse eid="ISA 59:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 59:3" />काबरकि तुम्हर हांथमन म खून,</para>
  <para style="q2" vid="ISA 59:3">अऊ तुम्हर अंगठीमन म अधरम के धब्बा लगे हवय।</para>
  <para style="q1" vid="ISA 59:3">तुम्हर मुहूं ह लबारी बात कहे हवय,</para>
  <para style="q2" vid="ISA 59:3">अऊ तुम्हर जीभ ले खराप बात निकलथे।<verse eid="ISA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 59:4" />कोनो नियाय के बात नइं करंय;</para>
  <para style="q2" vid="ISA 59:4">न कोनो सच्चई ले मुकदमा लड़ंय।</para>
  <para style="q1" vid="ISA 59:4">ओमन लबारी बात ऊपर भरोसा रखथें; ओमन लबारी बात कहिथें;</para>
  <para style="q2" vid="ISA 59:4">ओमन समस्या ला गरभ म धरथें अऊ पाप ला जनम देथें।<verse eid="ISA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 59:5" />ओमन करैत सांप के अंडा ला सेथें</para>
  <para style="q2" vid="ISA 59:5">अऊ मेकरा के जाली बनाथें।</para>
  <para style="q1" vid="ISA 59:5">जऊन कोनो ओमन के अंडा ला खाथे, ओह मर जाथे,</para>
  <para style="q2" vid="ISA 59:5">अऊ जब कोनो एक ठन ला फोरे जाथे, त ओमा ले बिसैला सांप के पीला निकलथे।<verse eid="ISA 59:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 59:6" />ओमन के बुने जालीमन ओनहा के काम नइं आवंय;</para>
  <para style="q2" vid="ISA 59:6">अऊ ओमन जऊन कुछू बनाथें, ओकर ले अपनआप ला ढांप नइं सकंय।</para>
  <para style="q1" vid="ISA 59:6">ओमन के काममन दुस्टता के काम अंय,</para>
  <para style="q2" vid="ISA 59:6">अऊ ओमन के हांथ ले हिंसा के काम होथे।<verse eid="ISA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 59:7" />ओमन के गोड़मन बुरई करे बर दऊड़थें;</para>
  <para style="q2" vid="ISA 59:7">ओमन निरदोस के हतिया करे बर तियार रहिथें।</para>
  <para style="q1" vid="ISA 59:7">ओमन दुस्ट साजिस करे म लगे रहिथें;</para>
  <para style="q2" vid="ISA 59:7">हिंसा के काममन ले ओमन के डहार भरे हवय।<verse eid="ISA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 59:8" />सांति के डहार ला ओमन नइं जानंय;</para>
  <para style="q2" vid="ISA 59:8">ओमन के सुभाव म नियाय के बात नइं ए।</para>
  <para style="q1" vid="ISA 59:8">ओमन अपन डहारमन ला बेईमानी के सड़क बना ले हवंय;</para>
  <para style="q2" vid="ISA 59:8">ओमन के संग रेंगइया कोनो भी मनखे सांति के बात नइं जानंय।<verse eid="ISA 59:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 59:9" />एकर कारन ले नियाय ह हमन ले दूरिहा हवय,</para>
  <para style="q2" vid="ISA 59:9">अऊ धरमीपन हमर मेर नइं आवय।</para>
  <para style="q1" vid="ISA 59:9">हमन अंजोर के डहार तो देखथन, पर देखव अंधियार ही बने रहिथे;</para>
  <para style="q2" vid="ISA 59:9">हमन अंजोर के आसा तो लगाय हवन, पर घोर अंधियार म रेंगथन।<verse eid="ISA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 59:10" />हमन अंधरा सहीं दीवार पकड़के टमड़त रहिथन,</para>
  <para style="q2" vid="ISA 59:10">हमन बिन आंखी के मनखे सहीं महसूस करथन।</para>
  <para style="q1" vid="ISA 59:10">गोधूलि के बेरा सहीं, हमन दिन-दुपहरी म हपटत रहिथन,</para>
  <para style="q2" vid="ISA 59:10">हट्टा-कट्टामन के बीच म हमन मुरदा सहीं हवन।<verse eid="ISA 59:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 59:11" />हमन सब के सब भालू सहीं गुर्राथन;</para>
  <para style="q2" vid="ISA 59:11">अऊ पंड़की सहीं सोक करत बिलाप करथन।</para>
  <para style="q1" vid="ISA 59:11">हमन नियाय के डहार तो देखथन, पर नियाय नइं मिलय;</para>
  <para style="q2" vid="ISA 59:11">हमन छुटकारा के तो डहार देखथन, पर ओह हमन ले दूरिहा ही रहिथे।<verse eid="ISA 59:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 59:12" />काबरकि हमर अपराध तोर नजर म बहुंत हो गे हवय,</para>
  <para style="q2" vid="ISA 59:12">हमर पापमन हमर बिरूध म साखी देथें।</para>
  <para style="q1" vid="ISA 59:12">हमर अपराधमन हमेसा हमर संग हवंय,</para>
  <para style="q2" vid="ISA 59:12">अऊ हमन अपन अधरम के काम ला मान लेथन:<verse eid="ISA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 59:13" />यहोवा के बिरूध बिदरोह अऊ धोखा,</para>
  <para style="q2" vid="ISA 59:13">अपन परमेसर कोति अपन पीठ देखई,</para>
  <para style="q1" vid="ISA 59:13">बिदरोह अऊ अतियाचार करई,</para>
  <para style="q2" vid="ISA 59:13">अपन मन म रखे लबरा बात कहई।<verse eid="ISA 59:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 59:14" />एकरसेति नियाय ह पाछू हट जावत हे,</para>
  <para style="q2" vid="ISA 59:14">अऊ धरमीपन ह दूरिहा म ठाढ़ रहिथे;</para>
  <para style="q1" vid="ISA 59:14">सच्चई ह गलीमन म गिर गे हवय,</para>
  <para style="q2" vid="ISA 59:14">ईमानदारी आ नइं सकय।<verse eid="ISA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 59:15" />सच्चई कहूं नइं ए,</para>
  <para style="q2" vid="ISA 59:15">अऊ जऊन ह बुरई ले भागथे, ओह खुद सिकार हो जाथे।</para>
  <para style="b" vid="ISA 59:15" />
  <para style="q1" vid="ISA 59:15">यहोवा ह देखिस अऊ ओला ये बात बने नइं लगिस</para>
  <para style="q2" vid="ISA 59:15">कि उहां नियाय नइं रिहिस।<verse eid="ISA 59:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 59:16" />ओह देखिस कि उहां कोनो नइं एं,</para>
  <para style="q2" vid="ISA 59:16">अऊ ओह अचम्भो करिस कि कोनो बिचवई करइया नइं एं;</para>
  <para style="q1" vid="ISA 59:16">तब ओह अपन ही भुजबल ले ओकर बर उद्धार के काम ला करिस,</para>
  <para style="q2" vid="ISA 59:16">अऊ अपन ही धरमीपन म ओला संभालिस।<verse eid="ISA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 59:17" />ओह धरमीपन ला झिलम के सहीं पहिर लीस,</para>
  <para style="q2" vid="ISA 59:17">अऊ ओकर मुड़ म उद्धार के टोप राखे गीस;</para>
  <para style="q1" vid="ISA 59:17">ओह बदला लेय के ओनहा पहिरिस</para>
  <para style="q2" vid="ISA 59:17">अऊ उत्साह के पहिरावा ला अपन म लपेट लीस।<verse eid="ISA 59:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 59:18" />ओमन के करम के मुताबिक</para>
  <para style="q2" vid="ISA 59:18">ओह ओमन ला फर दीही,</para>
  <para style="q1" vid="ISA 59:18">ओकर बईरीमन ऊपर कोप भड़कही</para>
  <para style="q2" vid="ISA 59:18">अऊ अपन बिरोधीमन ले बदला लीही;</para>
  <para style="q2" vid="ISA 59:18">ओह द्वीप म रहइयामन ला ओमन के काम के परतिफल दीही।<verse eid="ISA 59:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 59:19" />तब पछिम कोति मनखेमन यहोवा के नांव के भय मानहीं,</para>
  <para style="q2" vid="ISA 59:19">अऊ पूरब कोति ओकर महिमा के आदर होही।</para>
  <para style="q1" vid="ISA 59:19">काबरकि ओह बाढ़ के पानी सहीं आही</para>
  <para style="q2" vid="ISA 59:19">तब यहोवा के आतमा ह ओला भगाही।<verse eid="ISA 59:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 59:20" />“छुड़इया ह सियोन मेर ओमन करा आही, जेमन याकूब म हवंय</para>
  <para style="q2" vid="ISA 59:20">अऊ अपन पाप ले मन फिराथें,”</para>
  <para style="q2" vid="ISA 59:20">यहोवा ह घोसना करत हे।<verse eid="ISA 59:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 59:21" />“जहां तक मोर बात ए, येह ओमन के संग मोर करार ए,” यहोवा ह कहत हे। “मोर आतमा, जऊन ह तोर ऊपर हवय, ओह तोर ले अलग नइं होवय, अऊ मोर जऊन बचन, मेंह तोर मुहूं म डारे हंव, ओह तोर मुहूं म, तोर लइकामन के मुहूं म अऊ ओमन के संतानमन के मुहूं म अब ले लेके हमेसा रहिही,” यहोवा ह कहत हे।<verse eid="ISA 59:21" /></para>
  <chapter eid="ISA 59" />
  <chapter number="60" style="c" sid="ISA 60" />
  <para style="s1">सियोन के महिमा</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 60:1" />“उठ, चमकदार हो; काबरकि तोर अंजोर ह आय हवय,</para>
  <para style="q2" vid="ISA 60:1">अऊ यहोवा के महिमा तोर ऊपर उदय होवत हे।<verse eid="ISA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 60:2" />देख, धरती ऊपर अंधियार</para>
  <para style="q2" vid="ISA 60:2">अऊ राज-राज के मनखेमन ऊपर बिरबिट अंधियार छावत हे,</para>
  <para style="q1" vid="ISA 60:2">पर तोर ऊपर यहोवा उदय होवत हे</para>
  <para style="q2" vid="ISA 60:2">अऊ ओकर तेज तोर ऊपर परगट होवत हे।<verse eid="ISA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 60:3" />जाति-जाति के मनखेमन तोर मेर अंजोर बर,</para>
  <para style="q2" vid="ISA 60:3">अऊ राजामन तोर बिहान के अंजोर कोति आहीं।<verse eid="ISA 60:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 60:4" />“अपन चारों कोति आंखी उठाके देख:</para>
  <para style="q2" vid="ISA 60:4">सब के सब इकट्ठा होके तोर मेर आवत हें;</para>
  <para style="q1" vid="ISA 60:4">तोर बेटामन दूरिहा ले आवत हें,</para>
  <para style="q2" vid="ISA 60:4">अऊ तोर बेटीमन ला गोद म उठाके लाय जावत हे।<verse eid="ISA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 60:5" />तब तें देखबे अऊ तें चमकबे,</para>
  <para style="q2" vid="ISA 60:5">तोर हिरदय ह धड़कही अऊ आनंद ले भर जाही;</para>
  <para style="q1" vid="ISA 60:5">समुंदर के धन-संपत्ति तोर मेर लाय जाही,</para>
  <para style="q2" vid="ISA 60:5">तोर मेर देस-देस के धन-संपत्ति आही।<verse eid="ISA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 60:6" />तोर देस ह ऊंटमन के झुंड ले भर जाही,</para>
  <para style="q2" vid="ISA 60:6">मिदयान अऊ एपा देसमन के जवान ऊंटमन आहीं।</para>
  <para style="q1" vid="ISA 60:6">अऊ सेबा के जम्मो झन</para>
  <para style="q2" vid="ISA 60:6">सोन अऊ खुसबू बर धूप लेके आहीं</para>
  <para style="q2" vid="ISA 60:6">अऊ यहोवा के गुन गावत आहीं।<verse eid="ISA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 60:7" />केदार छेत्र के पसुमन के झुंड ला तोर मेर इकट्ठा करे जाही,</para>
  <para style="q2" vid="ISA 60:7">नबायोत छेत्र के मेढ़ामन तोर सेवा-टहल के काम म आहीं;</para>
  <para style="q1" vid="ISA 60:7">ओमन ला मोर बेदी म भेंट के रूप म गरहन करे जाही,</para>
  <para style="q2" vid="ISA 60:7">अऊ में अपन सोभायमान मंदिर ला सजाहूं।<verse eid="ISA 60:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 60:8" />“येमन कोन अंय, जेमन बादर सहीं,</para>
  <para style="q2" vid="ISA 60:8">अपन खोड़रा कोति पंड़की सहीं उड़त आवत हें?<verse eid="ISA 60:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 60:9" />सच म द्वीपमन मोर रसता देखथें;</para>
  <para style="q2" vid="ISA 60:9">आघू म तरसीस के पानी जहाजमन हवंय,</para>
  <para style="q1" vid="ISA 60:9">ओमन तोर लइकामन ला दूरिहा ले</para>
  <para style="q2" vid="ISA 60:9">ओमन के सोन अऊ चांदी समेत लेके आवत हें,</para>
  <para style="q1" vid="ISA 60:9">ताकि यहोवा तोर परमेसर,</para>
  <para style="q2" vid="ISA 60:9">इसरायल के पबितर परमेसर के आदर होवय,</para>
  <para style="q2" vid="ISA 60:9">काबरकि ओह तोला सोभायमान करे हवय।<verse eid="ISA 60:9" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 60:10" />“परदेसीमन तोर सहर के दीवार ला फेर बनाहीं,</para>
  <para style="q2" vid="ISA 60:10">अऊ ओमन के राजामन तोर सेवा-टहल करहीं।</para>
  <para style="q1" vid="ISA 60:10">हालाकि मेंह रिस म आके तोला दुख देय रहेंव,</para>
  <para style="q2" vid="ISA 60:10">पर अब खुस होके मेंह तोर ऊपर दया करहूं।<verse eid="ISA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 60:11" />तोर दुवारमन हरदम खुला रहिहीं,</para>
  <para style="q2" vid="ISA 60:11">दिन अऊ रात ओमन कभू बंद नइं होहीं,</para>
  <para style="q1" vid="ISA 60:11">ताकि मनखेमन जाति-जाति के मनखेमन के धन-संपत्ति तोर मेर लानंय—</para>
  <para style="q2" vid="ISA 60:11">ओमन के राजामन ला बंदी बनाके बिजयी जुलूस म लाने जावय।<verse eid="ISA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 60:12" />काबरकि जऊन जाति या राज के मन तोर सेवा नइं करहीं, ओमन नास हो जाहीं;</para>
  <para style="q2" vid="ISA 60:12">हां, अइसन जाति के पूरा सतियानास हो जाही।<verse eid="ISA 60:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 60:13" />“लबानोन के वैभव तोर मेर आही,</para>
  <para style="q2" vid="ISA 60:13">सनोवर, देवदार अऊ गोपेर के रूखमन ला</para>
  <para style="q1" vid="ISA 60:13">मोर पबितर-स्थान ला सजाय बर लाय जाही;</para>
  <para style="q2" vid="ISA 60:13">अऊ में अपन पांव बर ओ जगह ला महिमा दूहूं।<verse eid="ISA 60:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 60:14" />तोला दुख देवइयामन के लइकामन मुड़ नवाके तोर मेर आहीं;</para>
  <para style="q2" vid="ISA 60:14">ओ जम्मो जेमन तोला तुछ जानथें, ओमन तोर गोड़ तरी गिरके तोला दंडवत करहीं</para>
  <para style="q1" vid="ISA 60:14">अऊ ओमन तोला यहोवा के नगर,</para>
  <para style="q2" vid="ISA 60:14">इसरायल के पबितर परमेसर के सियोन कहिके बलाहीं।<verse eid="ISA 60:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 60:15" />“हालाकि तोला छोंड़ दिये गे हवय अऊ तोर ले घिन करे जाथे,</para>
  <para style="q2" vid="ISA 60:15">अऊ कोनो तोर म ले होके नइं जावंय,</para>
  <para style="q1" vid="ISA 60:15">पर मेंह तोला सदा के घमंड के चीज</para>
  <para style="q2" vid="ISA 60:15">अऊ पीढ़ी-पीढ़ी के मनखेमन बर आनंद के चीज ठहिराहूं।<verse eid="ISA 60:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 60:16" />तें जाति-जाति के मनखेमन के दूध पीबे</para>
  <para style="q2" vid="ISA 60:16">अऊ साही माईलोगनमन तोला दूध पीयाहीं।</para>
  <para style="q1" vid="ISA 60:16">तब तें जानबे कि में, यहोवा ह तोर उद्धारकर्ता,</para>
  <para style="q2" vid="ISA 60:16">तोर छुड़इया, याकूब के सक्तिसाली परमेसर अंव।<verse eid="ISA 60:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 60:17" />में कांसा के बदला सोन,</para>
  <para style="q2" vid="ISA 60:17">लोहा के बदला चांदी,</para>
  <para style="q1" vid="ISA 60:17">लकरी के बदला कांसा,</para>
  <para style="q2" vid="ISA 60:17">अऊ पथरा के बदला लोहा लानहूं।</para>
  <para style="q1" vid="ISA 60:17">में सांति ला तोर हाकिम</para>
  <para style="q2" vid="ISA 60:17">अऊ अच्छई ला तोर सासन करइया ठहिराहूं।<verse eid="ISA 60:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 60:18" />तोर देस म फेर कभू हिंसा के बात</para>
  <para style="q2" vid="ISA 60:18">अऊ तोर सीमना के भीतर उतपात या बिनास के चरचा नइं सुनई पड़ही,</para>
  <para style="q1" vid="ISA 60:18">पर तें अपन सहर के दीवारमन के नांव उद्धार</para>
  <para style="q2" vid="ISA 60:18">अऊ अपन सहर के दुवारमन के नांव परसंसा रखबे।<verse eid="ISA 60:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 60:19" />दिन म सूरज ह फेर तोर अंजोर नइं होही,</para>
  <para style="q2" vid="ISA 60:19">अऊ न ही चंदा के अंजोर तोर ऊपर फेर चमकही,</para>
  <para style="q1" vid="ISA 60:19">काबरकि यहोवा ह तोर सदा के अंजोर,</para>
  <para style="q2" vid="ISA 60:19">अऊ तोर परमेसर ह तोर सोभा ठहिरही।<verse eid="ISA 60:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 60:20" />तोर सूरज फेर कभू नइं बुड़ही,</para>
  <para style="q2" vid="ISA 60:20">अऊ न ही तोर चंदा के अंजोर फेर कभू कम होही;</para>
  <para style="q1" vid="ISA 60:20">यहोवा ह तोर सदा के अंजोर होही,</para>
  <para style="q2" vid="ISA 60:20">अऊ तोर दुख के दिनमन खतम हो जाहीं।<verse eid="ISA 60:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 60:21" />तब तोर मनखेमन सब के सब धरमी होहीं</para>
  <para style="q2" vid="ISA 60:21">अऊ देस ह हमेसा बर ओमन के अधिकार म होही।</para>
  <para style="q1" vid="ISA 60:21">ओमन मोर लगाय पऊधा</para>
  <para style="q2" vid="ISA 60:21">अऊ मोर हांथ के काम अंय,</para>
  <para style="q2" vid="ISA 60:21">येकर ले मोर महिमा परगट होही।<verse eid="ISA 60:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 60:22" />तुमन म छोटे ले छोटे ह एक हजार हो जाही,</para>
  <para style="q2" vid="ISA 60:22">अऊ सबले कमजोर ह एक बलवान जाति बन जाही।</para>
  <para style="q1" vid="ISA 60:22">मेंह यहोवा अंव;</para>
  <para style="q2" vid="ISA 60:22">सही समय म, मेंह येला तेजी से पूरा करहूं।”<verse eid="ISA 60:22" /></para>
  <chapter eid="ISA 60" />
  <chapter number="61" style="c" sid="ISA 61" />
  <para style="s1">यहोवा के किरपा के बछर</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 61:1" />परमपरधान यहोवा के आतमा मोर ऊपर हवय,</para>
  <para style="q2" vid="ISA 61:1">काबरकि यहोवा ह गरीबमन ला</para>
  <para style="q2" vid="ISA 61:1">सुघर संदेस के परचार करे बर मोर अभिसेक करे हवय।</para>
  <para style="q1" vid="ISA 61:1">ओह मोला एकर बर पठोय हवय कि दुखित मनखेमन ला सांति दंव,</para>
  <para style="q2" vid="ISA 61:1">बंधुवा मनखेमन के सुतंतरता के</para>
  <para style="q2" vid="ISA 61:1">अऊ कैदीमन<note caller="+" style="f"><char style="fr" closed="false">61:1 </char><char style="ft" closed="false">इबरानी; सेप्टाजिन्ट म </char><char style="fqa" closed="false">अंधरा</char></note> ला अंधियार ले छुटकारा के परचार करंव,<verse eid="ISA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 61:2" />यहोवा के किरपा-दिरिस्टी के बछर के</para>
  <para style="q2" vid="ISA 61:2">अऊ हमर परमेसर के पलटा लेय के दिन के परचार करंव,</para>
  <para style="q1" vid="ISA 61:2">जम्मो सोक करइयामन ला सांति दंव,<verse eid="ISA 61:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 61:3" />अऊ सियोन म दुखित मनखेमन के जरूरत ला पूरा करंव—</para>
  <para style="q1" vid="ISA 61:3">राख के बदले ओमन ला</para>
  <para style="q2" vid="ISA 61:3">सुघरता के मुकुट पहिरावंव,</para>
  <para style="q1" vid="ISA 61:3">सोक के बदले</para>
  <para style="q2" vid="ISA 61:3">आनंद के तेल चुपरंव,</para>
  <para style="q1" vid="ISA 61:3">अऊ उदासी के आतमा के बदले</para>
  <para style="q2" vid="ISA 61:3">परसंसा के ओढ़ना ओढ़ावंव।</para>
  <para style="q1" vid="ISA 61:3">ओमन ला यहोवा के लगाय</para>
  <para style="q2" vid="ISA 61:3">धरमीपन के बलूत रूख कहे जाही</para>
  <para style="q2" vid="ISA 61:3">अऊ येकर ले यहोवा के महिमा परगट होही।<verse eid="ISA 61:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 61:4" />तब ओमन पुराना उजरे जगहमन ला फेर बनाहीं</para>
  <para style="q2" vid="ISA 61:4">अऊ बहुंत पहिले बरबाद हो गय जगहमन ला फेर ठीक करहीं;</para>
  <para style="q1" vid="ISA 61:4">ओमन ओ नगरमन ला फेर बसाहीं</para>
  <para style="q2" vid="ISA 61:4">जेमन पीढ़ी-पीढ़ी ले उजरे परे हवंय।<verse eid="ISA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 61:5" />अजनबीमन तुम्हर भेड़-बकरीमन ला चराहीं;</para>
  <para style="q2" vid="ISA 61:5">परदेसीमन तुम्हर खेत अऊ अंगूर के बारी म काम करहीं।<verse eid="ISA 61:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 61:6" />पर तुमन ला यहोवा के पुरोहित कहे जाही,</para>
  <para style="q2" vid="ISA 61:6">तुमन ला हमर परमेसर के सेवक नांव दिये जाही।</para>
  <para style="q1" vid="ISA 61:6">तुमन जाति-जाति के मनखेमन के धन-दौलत ला खाहू,</para>
  <para style="q2" vid="ISA 61:6">अऊ ओमन के संपत्ति ऊपर तुमन घमंड करहू।<verse eid="ISA 61:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 61:7" />तुम्हर बदनामी के बदला</para>
  <para style="q2" vid="ISA 61:7">तुमन ला दू गुना हिस्सा मिलही,</para>
  <para style="q1" vid="ISA 61:7">अऊ कलंक के बदला म</para>
  <para style="q2" vid="ISA 61:7">तुमन अपन भाग के कारन आनंदित होहू।</para>
  <para style="q1" vid="ISA 61:7">अऊ ये किसम ले तुमन ला अपन देस म दू गुना हिस्सा मिलही,</para>
  <para style="q2" vid="ISA 61:7">अऊ तुमन सदा आनंदित बने रहिहू।<verse eid="ISA 61:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 61:8" />“काबरकि में, यहोवा, नियाय ले मया रखथंव;</para>
  <para style="q2" vid="ISA 61:8">मेंह डकैती अऊ अनियाय ले घिन करथंव।</para>
  <para style="q1" vid="ISA 61:8">अपन बिसवासयोग्यता म, में अपन मनखेमन ला ईनाम दूहूं,</para>
  <para style="q2" vid="ISA 61:8">अऊ ओमन के संग सदाकाल के एक करार करहूं।<verse eid="ISA 61:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 61:9" />ओमन के संतानमन जाति-जाति के मनखेमन के बीच</para>
  <para style="q2" vid="ISA 61:9">अऊ ओमन के बंसज मनखेमन के बीच जाने-माने मनखे होहीं।</para>
  <para style="q1" vid="ISA 61:9">जऊन मन ओमन ला देखहीं, ओ जम्मो स्वीकार करहीं</para>
  <para style="q2" vid="ISA 61:9">कि येमन ओ मनखे अंय, जेमन ला यहोवा ह आसीस देय हवय।”<verse eid="ISA 61:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 61:10" />में यहोवा म अति आनंदित हंव;</para>
  <para style="q2" vid="ISA 61:10">मोर जीव ह मोर परमेसर म आनंदित होथे।</para>
  <para style="q1" vid="ISA 61:10">काबरकि ओह मोला उद्धार के ओनहा पहिराय हवय</para>
  <para style="q2" vid="ISA 61:10">अऊ अपन धरमीपन के पहिरावा ले अइसन सजाय हवय,</para>
  <para style="q1" vid="ISA 61:10">जइसन कोनो दूल्हा ह अपन मुड़ी ला एक पुरोहित के सहीं सजाथे,</para>
  <para style="q2" vid="ISA 61:10">अऊ जइसन कोनो दुलहिन अपनआप ला अपन जेवर ले सिंगार करथे।<verse eid="ISA 61:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 61:11" />काबरकि जइसन भुइयां म ले बीजा के अंकुर निकलथे</para>
  <para style="q2" vid="ISA 61:11">अऊ बारी म पऊधामन बढ़थें,</para>
  <para style="q1" vid="ISA 61:11">वइसन ही परमपरधान यहोवा ह</para>
  <para style="q2" vid="ISA 61:11">सब जातिमन के सामने धरमीपन अऊ परसंसा ला बढ़ाही।<verse eid="ISA 61:11" /></para>
  <chapter eid="ISA 61" />
  <chapter number="62" style="c" sid="ISA 62" />
  <para style="s1">सियोन के नवां नांव</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 62:1" />सियोन के हित म, में चुप नइं रहंव,</para>
  <para style="q2" vid="ISA 62:1">अऊ यरूसलेम के हित म, में सांत नइं रहंव,</para>
  <para style="q1" vid="ISA 62:1">जब तक कि ओकर धरमीपन बिहान के अंजोर सहीं</para>
  <para style="q2" vid="ISA 62:1">अऊ ओकर उद्धार<note caller="+" style="f"><char style="fr" closed="false">62:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बिजय</char></note> ह बरत मसाल सहीं नइं चमकही।<verse eid="ISA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 62:2" />तब जाति-जाति के मनखेमन तोर धरमीपन,</para>
  <para style="q2" vid="ISA 62:2">अऊ सब राजामन तोर महिमा ला देखहीं;</para>
  <para style="q1" vid="ISA 62:2">तोर एक नवां नांव रखे जाही</para>
  <para style="q2" vid="ISA 62:2">जऊन ह यहोवा के मुहूं ले निकलही।<verse eid="ISA 62:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 62:3" />तें यहोवा के हांथ म एक सोभायमान मुकुट</para>
  <para style="q2" vid="ISA 62:3">अऊ अपन परमेसर के हथेली म एक राज-मुकुट ठहिरबे।<verse eid="ISA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 62:4" />ओमन फेर तोला तियागे गय नइं कहिहीं,</para>
  <para style="q2" vid="ISA 62:4">या तोर भुइयां के नांव उजरे भुइयां नइं होही।</para>
  <para style="q1" vid="ISA 62:4">पर तोला हेपसीबा,<note caller="+" style="f"><char style="fr" closed="false">62:4 </char><char style="fq" closed="false">हेपसीबा </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">मोर खुसी ओमा हवय</char></note></para>
  <para style="q2" vid="ISA 62:4">अऊ तोर भुइयां ला ब्यूला<note caller="+" style="f"><char style="fr" closed="false">62:4 </char><char style="fq" closed="false">ब्यूला </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">बिहाता</char></note> कहे जाही,</para>
  <para style="q1" vid="ISA 62:4">काबरकि यहोवा तोर ले खुस होही,</para>
  <para style="q2" vid="ISA 62:4">अऊ तोर भुइयां ह सुहागिन होही।<verse eid="ISA 62:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 62:5" />जइसन एक जवान पुरूस एक जवान छोकरी ले बिहाव करथे,</para>
  <para style="q2" vid="ISA 62:5">वइसन ही तोर बनइया ह तोर ले बिहाव करही;</para>
  <para style="q1" vid="ISA 62:5">जइसन दूल्हा ह अपन दुलहिन ऊपर आनंदित होथे,</para>
  <para style="q2" vid="ISA 62:5">वइसन ही तोर परमेसर तोर ऊपर आनंदित होही।<verse eid="ISA 62:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 62:6" />हे यरूसलेम, मेंह तोर भीथी म पहरेदार ठहिराय हंव;</para>
  <para style="q2" vid="ISA 62:6">ओमन दिन-रात कभू चुप नइं रहिहीं।</para>
  <para style="q1" vid="ISA 62:6">तुमन, जेमन यहोवा ला पुकारथव,</para>
  <para style="q2" vid="ISA 62:6">अराम झन करव,<verse eid="ISA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 62:7" />अऊ जब तक ओह<note caller="+" style="f"><char style="fr" closed="false">62:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यहोवा</char></note> यरूसलेम ला स्थिर करके</para>
  <para style="q2" vid="ISA 62:7">ओकर परसंसा धरती ऊपर नइं करवाय, तब तक ओला घलो अराम झन करन दव।<verse eid="ISA 62:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 62:8" />यहोवा ह अपन जेवनी हांथ के</para>
  <para style="q2" vid="ISA 62:8">अऊ अपन बलवंत भुजा के किरिया खाय हवय:</para>
  <para style="q1" vid="ISA 62:8">“मेंह फेर कभू तोर अनाज ला</para>
  <para style="q2" vid="ISA 62:8">तोर बईरीमन ला खाय बर नइं दंव,</para>
  <para style="q1" vid="ISA 62:8">अऊ फेर कभू परदेसीमन ओ नवां अंगूर के मंद ला पीये नइं पाहीं</para>
  <para style="q2" vid="ISA 62:8">जेकर बर तेंह मेहनत करे हवस;<verse eid="ISA 62:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 62:9" />पर जेमन येकर पैदावार करथें, ओमन येला खाहीं</para>
  <para style="q2" vid="ISA 62:9">अऊ यहोवा के इस्तुति करहीं,</para>
  <para style="q1" vid="ISA 62:9">अऊ जेमन अंगूर के मंद ला भंडार म इकट्ठा करथें,</para>
  <para style="q2" vid="ISA 62:9">ओमन येला मोर पबितर-स्थान के अंगना म पीये पाहीं।”<verse eid="ISA 62:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 62:10" />जावव, दुवारमन म ले होके जावव!</para>
  <para style="q2" vid="ISA 62:10">मनखेमन बर डहार तियार करव।</para>
  <para style="q1" vid="ISA 62:10">बनावव, राजमार्ग ला बनावव!</para>
  <para style="q2" vid="ISA 62:10">पथरामन ला हटावव।</para>
  <para style="q1" vid="ISA 62:10">जाति-जाति के मनखेमन बर झंडा ठाढ़ करव।<verse eid="ISA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 62:11" />देखव, यहोवा ह धरती के छोर तक</para>
  <para style="q2" vid="ISA 62:11">ये घोसना करे हवय:</para>
  <para style="q1" vid="ISA 62:11">“बेटी सियोन ला कहव,</para>
  <para style="q2" vid="ISA 62:11">‘देख, तोर उद्धारकर्ता आवत हे!</para>
  <para style="q1" vid="ISA 62:11">देख, ओकर ईनाम ओकर मेर हवय,</para>
  <para style="q2" vid="ISA 62:11">अऊ जऊन कुछू देना हे, ओह ओला लेके आवत हे।’ ”<verse eid="ISA 62:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 62:12" />ओमन ला पबितर मनखे कहे जाही,</para>
  <para style="q2" vid="ISA 62:12">यहोवा के छोंड़ाय गय;</para>
  <para style="q1" vid="ISA 62:12">अऊ तोला खोजे गय, कहे जाही,</para>
  <para style="q2" vid="ISA 62:12">ओ सहर जऊन ह अब तियागे गय नो हय।<verse eid="ISA 62:12" /></para>
  <chapter eid="ISA 62" />
  <chapter number="63" style="c" sid="ISA 63" />
  <para style="s1">परमेसर के बदला अऊ पाप ले मुक्ति देय के दिन</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 63:1" />येह कोन ए, जऊन ह एदोम देस के बोसरा नगर ले आवत हे</para>
  <para style="q2" vid="ISA 63:1">जेकर ओनहा म गहिरा लाल रंग के धब्बामन लगे हवंय?</para>
  <para style="q1" vid="ISA 63:1">येह कोन ए, जऊन ह सोभायमान ओनहा पहिरे,</para>
  <para style="q2" vid="ISA 63:1">अपन बड़े ताकत म, लम्बा कदम डालत चले आवत हे?</para>
  <para style="b" vid="ISA 63:1" />
  <para style="q1" vid="ISA 63:1">“येह में अंव, जऊन ह जय के घोसना करत हंव,</para>
  <para style="q2" vid="ISA 63:1">अऊ मेंह उद्धार करे के सक्ति रखथंव।”<verse eid="ISA 63:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 63:2" />तुम्हर ओनहा ह काबर लाल हवय,</para>
  <para style="q2" vid="ISA 63:2">जइसन रसकुंड म अंगूर खुंदत बेरा मनखेमन के होथे?<verse eid="ISA 63:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 63:3" />“मेंह अकेला रसकुंड म अंगूर रऊंदे हंव;</para>
  <para style="q2" vid="ISA 63:3">अऊ कोनो मनखे मोर संग नइं रिहिन।</para>
  <para style="q1" vid="ISA 63:3">मेंह अपन रिस म आके ही ओमन ला खुंदेंव</para>
  <para style="q2" vid="ISA 63:3">अऊ अपन कोप म मेंह ओमन ला कुचरेंव;</para>
  <para style="q1" vid="ISA 63:3">ओमन के लहू के छींटा मोर ओनहा म पड़िस,</para>
  <para style="q2" vid="ISA 63:3">अऊ मोर पूरा पहिरावा म दाग लग गीस।<verse eid="ISA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 63:4" />येह मोर बर बदला लेय के दिन रिहिस;</para>
  <para style="q2" vid="ISA 63:4">मोर बर छोंड़ाय के बछर ह आ गे रिहिस।<verse eid="ISA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 63:5" />मेंह खोजेंव पर कोनो मदद करइया नइं रिहिन,</para>
  <para style="q2" vid="ISA 63:5">मेंह डरा गेंव कि कोनो मोर मदद नइं करिन;</para>
  <para style="q1" vid="ISA 63:5">तब मेंह अपनेच भुजबल ले उद्धार करेंव</para>
  <para style="q2" vid="ISA 63:5">अऊ मोर खुद के कोरोध ह मोला संभालिस।<verse eid="ISA 63:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 63:6" />हां, अपन रिस म आके देस-देस के मनखेमन ला कुचरेंव;</para>
  <para style="q2" vid="ISA 63:6">अपन रिस म, मेंह ओमन ला मतवाला कर देंव,</para>
  <para style="q2" vid="ISA 63:6">अऊ ओमन के लहू ला भुइयां म बोहा देंव।”<verse eid="ISA 63:6" /></para>
  <para style="s1">परसंसा अऊ पराथना</para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 63:7" />मेंह यहोवा के दया के काम के बखान करहूं,</para>
  <para style="q2" vid="ISA 63:7">ओ काम जेकर कारन ओकर गुनगान होना चाही,</para>
  <para style="q2" vid="ISA 63:7">हमर बर यहोवा के करे गय ओ जम्मो काम के मुताबिक ओकर गुनगान होवय—</para>
  <para style="q1" vid="ISA 63:7">हव, अपन बहुंते दया अऊ करूना के कारन</para>
  <para style="q2" vid="ISA 63:7">ओह इसरायल बर</para>
  <para style="q2" vid="ISA 63:7">बहुंते भलई के काम करे हवय।<verse eid="ISA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 63:8" />यहोवा ह कहिस, “सही म ओमन मोर मनखे अंय,</para>
  <para style="q2" vid="ISA 63:8">अइसन लइका, जेमन मोर बर ईमानदार रहिहीं”;</para>
  <para style="q2" vid="ISA 63:8">अऊ ओह ओमन के उद्धारकर्ता हो गीस।<verse eid="ISA 63:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 63:9" />ओमन के सबो दुख म ओह घलो दुख उठाईस,</para>
  <para style="q2" vid="ISA 63:9">अऊ ओकर उपस्थिति के स्वरगदूत ह ओमन के उद्धार करिस।</para>
  <para style="q1" vid="ISA 63:9">अपन मया अऊ दया के कारन ओह ओमन ला छोंड़ाईस;</para>
  <para style="q2" vid="ISA 63:9">ओह ओमन ला उठाईस अऊ पुराना समय ले ओमन ला उठाके चलिस।<verse eid="ISA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 63:10" />तभो ले ओमन बिदरोह करिन</para>
  <para style="q2" vid="ISA 63:10">अऊ ओकर पबितर आतमा ला दुखित करिन।</para>
  <para style="q1" vid="ISA 63:10">एकर कारन ओह पलटके ओमन के बईरी हो गीस</para>
  <para style="q2" vid="ISA 63:10">अऊ ओह खुद ओमन ले लड़े लगिस।<verse eid="ISA 63:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 63:11" />तब ओकर मनखेमन पुराना दिनमन ला,</para>
  <para style="q2" vid="ISA 63:11">याने कि मूसा अऊ ओकर मनखेमन के दिनमन ला सुरता करके कहिन—</para>
  <para style="q1" vid="ISA 63:11">ओह कहां हवय, जऊन ह ओमन ला समुंदर म ले होवत</para>
  <para style="q2" vid="ISA 63:11">अपन झुंड के चरवाहा के संग ले आईस?</para>
  <para style="q1" vid="ISA 63:11">ओह कहां हवय, जऊन ह ओमन के बीच म</para>
  <para style="q2" vid="ISA 63:11">अपन पबितर आतमा डारिस,<verse eid="ISA 63:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 63:12" />जऊन ह अपन परतापी भुजबल ला</para>
  <para style="q2" vid="ISA 63:12">मूसा के जेवनी हांथ म कर दीस,</para>
  <para style="q1" vid="ISA 63:12">जऊन ह ओमन के आघू म पानी<note caller="+" style="f"><char style="fr" closed="false">63:12 </char><char style="ft" closed="false">समुंदर के पानी</char></note> ला दू भाग करके</para>
  <para style="q2" vid="ISA 63:12">अपन बर सदाकाल के जस कमाईस,<verse eid="ISA 63:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 63:13" />जऊन ह ओमन ला गहिला समुंदर म ले होके ले गीस?</para>
  <para style="q1" vid="ISA 63:13">जइसन घोड़ा ला खुला मैदान म ठोकर नइं लगय,</para>
  <para style="q2" vid="ISA 63:13">वइसन ही ओमन ला घलो ठोकर नइं लगिस;<verse eid="ISA 63:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 63:14" />जइसन घरेलू-पसुमन खाल्हे मैदान म चले जाथें,</para>
  <para style="q2" vid="ISA 63:14">वइसन ही यहोवा के आतमा ह ओमन ला आराम दीस।</para>
  <para style="q1" vid="ISA 63:14">अपन एक महिमामय नांव बनाय बर</para>
  <para style="q2" vid="ISA 63:14">ये किसम ले तेंह अपन मनखेमन के अगुवई करे।<verse eid="ISA 63:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 63:15" />स्वरग ले, अपन ऊंच सिंघासन ले, जऊन ह पबितर</para>
  <para style="q2" vid="ISA 63:15">अऊ महिमा ले भरे हवय, उहां ले खाल्हे देख।</para>
  <para style="q1" vid="ISA 63:15">तोर जलन अऊ पराकरम कहां हवय?</para>
  <para style="q2" vid="ISA 63:15">तोर दया अऊ करूना हमर ऊपर ले हट गे हवय।<verse eid="ISA 63:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 63:16" />पर तें हमर ददा अस,</para>
  <para style="q2" vid="ISA 63:16">हालाकि अब्राहम हमन ला नइं जानय</para>
  <para style="q2" vid="ISA 63:16">या इसरायल हमन ला गरहन नइं करय;</para>
  <para style="q1" vid="ISA 63:16">तभो ले, हे यहोवा, तें हमर ददा</para>
  <para style="q2" vid="ISA 63:16">अऊ हमर छुड़इया अस; पुराना जमाना ले ये तोर नांव अय।<verse eid="ISA 63:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 63:17" />हे यहोवा, तें काबर हमन ला अपन रद्दा ले भटका देथस</para>
  <para style="q2" vid="ISA 63:17">अऊ हमर मन ला कठोर कर देथस कि हमन तोर भय नइं मानन?</para>
  <para style="q1" vid="ISA 63:17">अपन दासमन के हित म, ओ गोत्रमन, जेमन तोर निज भाग अंय,</para>
  <para style="q2" vid="ISA 63:17">ओमन के हित म लहुंट आ।<verse eid="ISA 63:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 63:18" />थोरकन समय तक तोर मनखेमन तोर पबितर जगह ऊपर अधिकार रखिन,</para>
  <para style="q2" vid="ISA 63:18">पर हमर बईरीमन तोर पबितर-स्थान ला कुचर दे हवंय।<verse eid="ISA 63:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 63:19" />पुराना जमाना ले हमन तोर अन;</para>
  <para style="q2" vid="ISA 63:19">पर हमन<note caller="+" style="f"><char style="fr" closed="false">63:19 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">पर हमन ओमन सहीं हो गे हन, जेमन ऊपर तेंह कभू परभूता नइं करे</char></note> तो अइसे हो गे हन मानो तेंह हमर ऊपर कभू परभूता नइं करे,</para>
  <para style="q2" vid="ISA 63:19">अऊ हमन<note caller="+" style="f"><char style="fr" closed="false">63:19 </char><char style="ft" closed="false">ओमन सहीं, जेमन ला तोर नांव ले कभू बलाय नइं गीस</char></note> तोर नांव ले कभू बलाय नइं गे हवन।<verse eid="ISA 63:19" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 63" />
  <chapter number="64" style="c" sid="ISA 64" />
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">64 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="ISA 64:1">64:1</ref></char> ला 63:19, अऊ <char style="xt"><ref loc="ISA 64:2-12">64:2‑12</ref></char> ला 64:1‑11 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="ISA 64:1" />बने होतिस कि तें अकास ला चीरके खाल्हे उतर आते,</para>
  <para style="q2" vid="ISA 64:1">कि पहाड़मन तोर आघू म कांप उठतिन!<verse eid="ISA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 64:2" />जइसन आगी ह डारामन ला जला देथे</para>
  <para style="q2" vid="ISA 64:2">अऊ पानी ला डपकाथे,</para>
  <para style="q1" vid="ISA 64:2">वइसन तें अपन बईरीमन ऊपर अपन नांव परगट करे बर</para>
  <para style="q2" vid="ISA 64:2">अऊ जाति-जाति के मनखेमन ला अपन आघू म कंपाय बर खाल्हे उतर!<verse eid="ISA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 64:3" />काबरकि जब तेंह अद्भूत काम करे, जेकर हमन आसा नइं करत रहेंन,</para>
  <para style="q2" vid="ISA 64:3">तब तें खाल्हे उतरे, अऊ पहाड़मन तोर आघू म कांप उठिन।<verse eid="ISA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 64:4" />पुराना जमाना ले तोला छोंड़ कोनो अऊ परमेसर के बारे म न तो सुने गीस,</para>
  <para style="q2" vid="ISA 64:4">न कोनो मनखे ओला जानिन,</para>
  <para style="q1" vid="ISA 64:4">अऊ न कोनो कभू ओला देखिन,</para>
  <para style="q2" vid="ISA 64:4">तेंह अइसन परमेसर अस, जऊन ह अपन बाट जोहइया कोति ले काम करथस।<verse eid="ISA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 64:5" />तें ओमन के मदद करे बर आथस, जेमन खुसी से भलई के काम करथें,</para>
  <para style="q2" vid="ISA 64:5">जेमन तोर डहारमन ला सुरता म रखथें।</para>
  <para style="q1" vid="ISA 64:5">पर जब हमन लगातार तोर बिरूध म पाप करेंन,</para>
  <para style="q2" vid="ISA 64:5">त तें गुस्सा करे।</para>
  <para style="q2" vid="ISA 64:5">तब हमर उद्धार कइसे हो सकथे?<verse eid="ISA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 64:6" />हमन सब के सब असुध मनखे सहीं हो गे हवन,</para>
  <para style="q2" vid="ISA 64:6">अऊ हमर जम्मो धरमी काममन मईला चेंदरा सहीं अंय;</para>
  <para style="q1" vid="ISA 64:6">हमन सब के सब पान सहीं मुरझा जाथन,</para>
  <para style="q2" vid="ISA 64:6">अऊ हवा सहीं हमर पापमन हमन ला उड़ियाके ले जाथे।<verse eid="ISA 64:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 64:7" />कोनो तोर नांव नइं लेवंय</para>
  <para style="q2" vid="ISA 64:7">या तोला धरे रहे के कोसिस कोनो नइं करंय;</para>
  <para style="q1" vid="ISA 64:7">काबरकि तेंह हमन ले अपन मुहूं ला छुपा ले हस,</para>
  <para style="q2" vid="ISA 64:7">अऊ हमन ला हमर पाप के बस म कर दे हस।<verse eid="ISA 64:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 64:8" />तभो ले, हे यहोवा, तेंह हमर ददा अस।</para>
  <para style="q2" vid="ISA 64:8">हमन माटी अन, अऊ तें हमर कुम्हार अस;</para>
  <para style="q2" vid="ISA 64:8">हमन सब के सब तोर हांथ के रचना अन।<verse eid="ISA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 64:9" />एकरसेति हे यहोवा, जादा रिस झन कर;</para>
  <para style="q2" vid="ISA 64:9">अनंतकाल तक हमर पाप ला सुरता झन रख।</para>
  <para style="q1" vid="ISA 64:9">हमर तरफ धियान दे, हमन पराथना करत हन,</para>
  <para style="q2" vid="ISA 64:9">काबरकि हमन सब तोर मनखे अन।<verse eid="ISA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 64:10" />देख, तोर पबितर नगरमन बंजर भुइयां हो गे हवंय;</para>
  <para style="q2" vid="ISA 64:10">अऊ त अऊ सियोन ह बंजर भुइयां हो गे हवय, यरूसलेम ह उजरे परे हवय।<verse eid="ISA 64:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 64:11" />हमर पबितर अऊ सोभायमान मंदिर, जेमा हमर पुरखामन तोर इस्तुति करत रिहिन,</para>
  <para style="q2" vid="ISA 64:11">आगी ले जला दे गे हवय,</para>
  <para style="q2" vid="ISA 64:11">अऊ हमर कीमती चीजमन नास हो गीन।<verse eid="ISA 64:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 64:12" />ये सब होय के बाद घलो, हे यहोवा, का तें अपनआप ला रोके रहिबे?</para>
  <para style="q2" vid="ISA 64:12">का तें चुप रहिबे अऊ हमन ला सीमना के बाहिर सजा देबे?<verse eid="ISA 64:12" /></para>
  <chapter eid="ISA 64" />
  <chapter number="65" style="c" sid="ISA 65" />
  <para style="s1">नियाय अऊ उद्धार</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 65:1" />“मेंह अपनआप ला ओमन ऊपर परगट करेंव, जऊन मन मोर बारे म नइं पुछिन;</para>
  <para style="q2" vid="ISA 65:1">ओमन मोला पा गीन, जऊन मन मोला नइं खोजत रिहिन।</para>
  <para style="q1" vid="ISA 65:1">ओ जाति के मनखे, जेमन मोर नांव ला नइं पुकारिन,</para>
  <para style="q2" vid="ISA 65:1">ओमन ला मेंह कहेंव, ‘देखव, में इहां हंव, में इहां हंव।’<verse eid="ISA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 65:2" />मेंह एक हठी जाति के मनखेमन कोति</para>
  <para style="q2" vid="ISA 65:2">दिन भर अपन हांथ ला पसारे रहेंव,</para>
  <para style="q1" vid="ISA 65:2">जेमन अपन खुद के कल्पना के मुताबिक</para>
  <para style="q2" vid="ISA 65:2">बुरई के रद्दा म रेंगथें—<verse eid="ISA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 65:3" />अइसन मनखे, जेमन मोर आंखी के आघू म ही</para>
  <para style="q2" vid="ISA 65:3">बारीमन म बलिदान चघाके</para>
  <para style="q1" vid="ISA 65:3">अऊ ईंटा के बेदीमन म धूप जलाके,</para>
  <para style="q2" vid="ISA 65:3">मोला लगातार रिस देवाथें।<verse eid="ISA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 65:4" />येमन कबरमन के बीच बईठथें</para>
  <para style="q2" vid="ISA 65:4">अऊ अपन रातमन ला गुपत रतजगा करके काटथें;</para>
  <para style="q1" vid="ISA 65:4">जेमन सूरा के मांस खाथें,</para>
  <para style="q2" vid="ISA 65:4">अऊ जेमन के बरतन म असुध मांस के रसा रहिथे;<verse eid="ISA 65:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 65:5" />जेमन आने मन ला कहिथें, ‘हट जा; मोर तीर म झन आ,</para>
  <para style="q2" vid="ISA 65:5">काबरकि में तोर ले बहुंत पबितर हंव!’</para>
  <para style="q1" vid="ISA 65:5">अइसन मनखे मोर नाक म धुआं,</para>
  <para style="q2" vid="ISA 65:5">अऊ ओ आगी सहीं अंय, जऊन ह दिन भर बरत रहिथे।<verse eid="ISA 65:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 65:6" />“देखव, ये बात मोर आघू म लिखाय हे:</para>
  <para style="q2" vid="ISA 65:6">में चुप नइं रहंव, पर येकर पूरा बदला लूहूं;</para>
  <para style="q2" vid="ISA 65:6">मेंह ओमन के गलत काममन के बदला ओमन के गोदी म डाल दूहूं—<verse eid="ISA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 65:7" />तुम्हर पाप अऊ तुम्हर पुरखामन के पाप ला,”</para>
  <para style="q2" vid="ISA 65:7">यहोवा ह कहिथे।</para>
  <para style="q1" vid="ISA 65:7">“काबरकि ओमन पहाड़मन ऊपर धूप जलाईन</para>
  <para style="q2" vid="ISA 65:7">अऊ पहाड़ीमन ऊपर मोर निन्दा करिन,</para>
  <para style="q1" vid="ISA 65:7">में ओमन के पहिले के काममन के पूरा बदला</para>
  <para style="q2" vid="ISA 65:7">ओमन के गोदी म तऊलके दूहूं।”<verse eid="ISA 65:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 65:8" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 65:8">“जइसन जब अंगूर के गुच्छा म अंगूर के रस भराय रहिथे,</para>
  <para style="q2" vid="ISA 65:8">तब मनखेमन कहिथें, ‘येला बरबाद झन करव,</para>
  <para style="q2" vid="ISA 65:8">येमा अभी भी आसीस हवय,’</para>
  <para style="q1" vid="ISA 65:8">वइसन ही में अपन सेवकमन बर करहूं;</para>
  <para style="q2" vid="ISA 65:8">में ओ सब झन ला नास नइं करंव।<verse eid="ISA 65:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 65:9" />में याकूब म ले संतान लानहूं,</para>
  <para style="q2" vid="ISA 65:9">अऊ यहूदा ले ओमन ला, जेमन मोर पहाड़मन ऊपर अधिकार रखहीं;</para>
  <para style="q1" vid="ISA 65:9">मोर चुने मनखेमन ओमन के वारिस होहीं,</para>
  <para style="q2" vid="ISA 65:9">अऊ मोर दासमन उहां निवास करहीं।<verse eid="ISA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 65:10" />मोर मनखे, जऊन मन मोला खोजथें,</para>
  <para style="q2" vid="ISA 65:10">ओमन के भेड़-बकरीमन बर सारोन ह एक चरागन होही,</para>
  <para style="q2" vid="ISA 65:10">अऊ आकोर के घाटी ह ओमन के गरूवा-बईलामन के अराम करे के जगह होही।<verse eid="ISA 65:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 65:11" />“पर जहां तक तुम्हर बात ए, जऊन मन यहोवा ला छोंड़ देथव</para>
  <para style="q2" vid="ISA 65:11">अऊ मोर पबितर पहाड़ ला भुला जाथव,</para>
  <para style="q1" vid="ISA 65:11">जऊन मन भाग्य देवता बर मेज ऊपर खाय के चीज सजाथें</para>
  <para style="q2" vid="ISA 65:11">अऊ तकदीर बर मसाला मिलाय अंगूर के मंद कटोरामन म भरथें,<verse eid="ISA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 65:12" />में तुमन ला तलवार के कौंरा बनाहूं,</para>
  <para style="q2" vid="ISA 65:12">अऊ तुमन जम्मो झन के मुड़ काटे जाही;</para>
  <para style="q1" vid="ISA 65:12">काबरकि मेंह तुमन ला बलांय, पर तुमन जबाब नइं देव,</para>
  <para style="q2" vid="ISA 65:12">मेंह बोलेंव, पर तुमन नइं सुनेव।</para>
  <para style="q1" vid="ISA 65:12">तुमन मोर नजर म दुस्ट काम करेव</para>
  <para style="q2" vid="ISA 65:12">अऊ जेकर ले में नाखुस होथंव, ओही ला तुमन चुनेव।”<verse eid="ISA 65:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 65:13" />एकर कारन परमपरधान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 65:13">“देखव, मोर सेवकमन तो खाहीं,</para>
  <para style="q2" vid="ISA 65:13">पर तुमन भूखन रहिहू;</para>
  <para style="q1" vid="ISA 65:13">मोर सेवकमन पीहीं,</para>
  <para style="q2" vid="ISA 65:13">पर तुमन पीयासन रहिहू;</para>
  <para style="q1" vid="ISA 65:13">मोर सेवकमन आनंद मनाहीं,</para>
  <para style="q2" vid="ISA 65:13">पर तुमन लज्जा म पड़हू।<verse eid="ISA 65:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 65:14" />मोर सेवकमन अपन मन के</para>
  <para style="q2" vid="ISA 65:14">खुसी के मारे गीत गाहीं,</para>
  <para style="q1" vid="ISA 65:14">पर मन म दुख के कारन</para>
  <para style="q2" vid="ISA 65:14">तुमन रोहू</para>
  <para style="q2" vid="ISA 65:14">अऊ टूटे मन के कारन बिलाप करहू।<verse eid="ISA 65:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 65:15" />तुमन अपन नांव ला छोंड़हू</para>
  <para style="q2" vid="ISA 65:15">काबरकि मोर चुने मनखेमन तुम्हर नांव ले लेके सराप दीहीं;</para>
  <para style="q1" vid="ISA 65:15">परमपरधान यहोवा ह तुमन ला नास कर दीही,</para>
  <para style="q2" vid="ISA 65:15">पर अपन सेवकमन के ओह दूसर नांव रखही।<verse eid="ISA 65:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 65:16" />जऊन कोनो देस म आसीस मांगथे</para>
  <para style="q2" vid="ISA 65:16">ओह सच्चा परमेसर के नांव लेके अइसने करही;</para>
  <para style="q1" vid="ISA 65:16">जऊन कोनो देस म किरिया खाथे</para>
  <para style="q2" vid="ISA 65:16">ओह सच्चा परमेसर के नांव म किरिया खाही।</para>
  <para style="q1" vid="ISA 65:16">काबरकि पहिली के दुखमन भुला दिये जाहीं</para>
  <para style="q2" vid="ISA 65:16">अऊ मोर आंखी ले लुका जाहीं।<verse eid="ISA 65:16" /></para>
  <para style="s1">नवां अकास अऊ नवां धरती</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 65:17" />“देखव, मेंह नवां अकास</para>
  <para style="q2" vid="ISA 65:17">अऊ नवां धरती के सिरिस्टी करहूं।</para>
  <para style="q1" vid="ISA 65:17">अऊ पहिली के चीजमन ला सुरता नइं करे जाही,</para>
  <para style="q2" vid="ISA 65:17">अऊ न ही ओमन मनखे के मन म आहीं।<verse eid="ISA 65:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 65:18" />एकर कारन जऊन कुछू के मेंह सिरिस्टी करथंव,</para>
  <para style="q2" vid="ISA 65:18">ओमा सदा खुस रहव अऊ आनंदित रहव,</para>
  <para style="q1" vid="ISA 65:18">काबरकि देखव, में यरूसलेम ला खुसी बर</para>
  <para style="q2" vid="ISA 65:18">अऊ येकर मनखेमन ला आनंद बर बनाहूं।<verse eid="ISA 65:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 65:19" />में यरूसलेम ऊपर आनंदित होहूं</para>
  <para style="q2" vid="ISA 65:19">अऊ अपन मनखेमन ले खुस होहूं;</para>
  <para style="q1" vid="ISA 65:19">येमा रोय अऊ नरियाय के अवाज</para>
  <para style="q2" vid="ISA 65:19">फेर सुनाई नइं पड़ही।<verse eid="ISA 65:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 65:20" />“ओमा फेर न तो कुछू दिन के लइका,</para>
  <para style="q2" vid="ISA 65:20">अऊ न अइसन बुढ़वा मरही</para>
  <para style="q2" vid="ISA 65:20">जऊन ह अपन उमर पूरा नइं करे होही;</para>
  <para style="q1" vid="ISA 65:20">काबरकि जऊन ह लड़कपन म मरइया हे</para>
  <para style="q2" vid="ISA 65:20">ओह सौ बछर के होके मरही,</para>
  <para style="q1" vid="ISA 65:20">पर जऊन ह सौ बछर के पहिले मरही,</para>
  <para style="q2" vid="ISA 65:20">ओह सापित समझे जाही।<verse eid="ISA 65:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 65:21" />ओमन घर बनाके ओमा बसहीं;</para>
  <para style="q2" vid="ISA 65:21">ओमन अंगूर के बारी लगाके ओकर फर खाहीं।<verse eid="ISA 65:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 65:22" />अइसन नइं होवय कि ओमन बनावंय अऊ दूसरमन ओमा बसंय,</para>
  <para style="q2" vid="ISA 65:22">या ओमन रूख लगांय, अऊ दूसरमन खावंय।</para>
  <para style="q1" vid="ISA 65:22">काबरकि जतका उमर रूख के होही,</para>
  <para style="q2" vid="ISA 65:22">ओतका मोर मनखेमन के उमर होही;</para>
  <para style="q1" vid="ISA 65:22">मोर चुने गय मनखेमन अपन हांथ के काम के</para>
  <para style="q2" vid="ISA 65:22">लम्बा समय तक आनंद उठाहीं।<verse eid="ISA 65:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 65:23" />ओमन के मेहनत ह बेकार नइं होवय,</para>
  <para style="q2" vid="ISA 65:23">न ओमन के लइकामन दुख झेले बर पईदा होहीं;</para>
  <para style="q1" vid="ISA 65:23">काबरकि ओमन यहोवा के दुवारा आसीसित मनखे होहीं,</para>
  <para style="q2" vid="ISA 65:23">ओमन अऊ ओमन के लइकामन घलो आसीसित होहीं।<verse eid="ISA 65:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 65:24" />ओमन के पुकारे के पहिली ही में ओमन ला उत्तर दूहूं;</para>
  <para style="q2" vid="ISA 65:24">ओमन के गोठियावत बेरा ही, में ओमन के सुन लूहूं।<verse eid="ISA 65:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 65:25" />भेड़िया अऊ मेढ़ा-पीला एके संग चरहीं,</para>
  <para style="q2" vid="ISA 65:25">अऊ सिंह ह बईला सहीं भूंसा खाही,</para>
  <para style="q2" vid="ISA 65:25">अऊ सांप के जेवन धुर्रा होही।</para>
  <para style="q1" vid="ISA 65:25">मोर जम्मो पबितर पहाड़ ऊपर</para>
  <para style="q2" vid="ISA 65:25">न तो कोनो चोट पहुंचाहीं अऊ न ही नुकसान करहीं,”</para>
  <para style="q2" vid="ISA 65:25">यहोवा ह कहत हे।<verse eid="ISA 65:25" /></para>
  <chapter eid="ISA 65" />
  <chapter number="66" style="c" sid="ISA 66" />
  <para style="s1">परमेसर के नियाय अऊ आसा</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 66:1">“स्वरग ह मोर सिंघासन,</para>
  <para style="q2" vid="ISA 66:1">अऊ धरती ह मोर गोड़ मढ़ाय के चौकी अय।</para>
  <para style="q1" vid="ISA 66:1">तुमन मोर बर कइसने घर बनाहू?</para>
  <para style="q2" vid="ISA 66:1">मोर बिसराम के ठऊर कहां होही?<verse eid="ISA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 66:2" />का ये जम्मो चीज ला मोर हांथ ह नइं बनाय हे,</para>
  <para style="q2" vid="ISA 66:2">अऊ ये किसम ले येमन आकार लीन?”</para>
  <para style="q2" vid="ISA 66:2">यहोवा ह घोसना करत हे।</para>
  <para style="b" vid="ISA 66:2" />
  <para style="q1" vid="ISA 66:2">“येमन ऊपर मोर दया-दिरिस्टी रहिथे:</para>
  <para style="q2" vid="ISA 66:2">जऊन मन नम्र अऊ पछतापी मन के होथें,</para>
  <para style="q2" vid="ISA 66:2">अऊ जेमन मोर बचन सुनके कांपथें।<verse eid="ISA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 66:3" />पर जऊन ह बईला के बलि चघाथे</para>
  <para style="q2" vid="ISA 66:3">ओह मनखे ला मार डारे के बरोबर अय,</para>
  <para style="q1" vid="ISA 66:3">अऊ जऊन ह मेढ़ा-पीला के बलि चघाथे</para>
  <para style="q2" vid="ISA 66:3">ओह कुकुर के घेंच ला काटे के बरोबर अय;</para>
  <para style="q1" vid="ISA 66:3">जऊन ह अन्न-बलिदान चघाथे</para>
  <para style="q2" vid="ISA 66:3">ओह सूरा के लहू चघाय सहीं अय,</para>
  <para style="q1" vid="ISA 66:3">अऊ जऊन ह धूप जलाथे</para>
  <para style="q2" vid="ISA 66:3">ओह मूरती-पूजा करे सहीं अय।</para>
  <para style="q1" vid="ISA 66:3">ये जम्मो झन अपन-अपन रद्दा चुन ले हवंय,</para>
  <para style="q2" vid="ISA 66:3">अऊ ओमन अपन घिनौना चीजमन म खुस रहिथें;<verse eid="ISA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 66:4" />एकर कारन में घलो ओमन बर कठोर बात चुनहूं</para>
  <para style="q2" vid="ISA 66:4">अऊ जऊन बात ले ओमन डराथें, ओही ला ओमन ऊपर लानहूं।</para>
  <para style="q1" vid="ISA 66:4">काबरकि जब मेंह बलांय तब कोनो जबाब नइं दीन,</para>
  <para style="q2" vid="ISA 66:4">अऊ जब में ओमन ले बात करेंव, तब कोनो मोर बात ला नइं सुनिन।</para>
  <para style="q1" vid="ISA 66:4">ओमन मोर नजर म दुस्ट काम करिन</para>
  <para style="q2" vid="ISA 66:4">अऊ जेकर ले में नाखुस होथंव, ओही काम ला ओमन चुनिन।”<verse eid="ISA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 66:5" />तुमन, जेमन यहोवा के बचन सुनके कांपथव,</para>
  <para style="q2" vid="ISA 66:5">ओकर बचन ला सुनव:</para>
  <para style="q1" vid="ISA 66:5">“तुम्हर खुद के मनखे, जेमन तुम्हर ले बईर रखथें,</para>
  <para style="q2" vid="ISA 66:5">अऊ मोर नांव के कारन तुमन ला अलगिया देथें, ओमन कहे हवंय,</para>
  <para style="q1" vid="ISA 66:5">‘यहोवा के महिमा होवय,</para>
  <para style="q2" vid="ISA 66:5">जेकर ले हमन तुम्हर आनंद ला देखन!’</para>
  <para style="q2" vid="ISA 66:5">पर ओही मन ला लजाय बर पड़ही।<verse eid="ISA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 66:6" />सहर<note caller="+" style="f"><char style="fr" closed="false">66:6 </char><char style="fqa" closed="false">यरूसलेम </char><char style="ft" closed="false">सहर</char></note> म होवत हल्ला-गुल्ला ला सुनव,</para>
  <para style="q2" vid="ISA 66:6">मंदिर म होवत ओ कोलाहल ला सुनव!</para>
  <para style="q1" vid="ISA 66:6">येह यहोवा के अवाज अय,</para>
  <para style="q2" vid="ISA 66:6">ओह अपन बईरीमन ला ओमन के करनी के फल देवत हे।<verse eid="ISA 66:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 66:7" />“छेवारी पीरा सुरू होय के पहिली ही</para>
  <para style="q2" vid="ISA 66:7">ओह जनम देथे;</para>
  <para style="q1" vid="ISA 66:7">ओला पीरा होय के पहिली ही</para>
  <para style="q2" vid="ISA 66:7">ओह एक बेटा ला जनम देथे।<verse eid="ISA 66:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 66:8" />अइसन बात कोनो कभू सुने हवंय?</para>
  <para style="q2" vid="ISA 66:8">अइसन बात कोनो कभू देखे हवंय?</para>
  <para style="q1" vid="ISA 66:8">का कोनो देस एके दिन म उतपन हो सकथे</para>
  <para style="q2" vid="ISA 66:8">या कोनो जाति ला छिन भर म उतपन करे जा सकथे?</para>
  <para style="q1" vid="ISA 66:8">पर सियोन ला छेवारी पीरा उठते ही</para>
  <para style="q2" vid="ISA 66:8">ओह अपन लइकामन ला जनम देथे।<verse eid="ISA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 66:9" />का में लइका जनमाय के समय ला लाथंव</para>
  <para style="q2" vid="ISA 66:9">अऊ लइका ला पईदा होवन नइं दंव?”</para>
  <para style="q2" vid="ISA 66:9">यहोवा ह कहत हे।</para>
  <para style="q1" vid="ISA 66:9">“जब में लइका जनमाय के समय ला लाथंव</para>
  <para style="q2" vid="ISA 66:9">त का में कोख ला बंद कर देथंव?”</para>
  <para style="q2" vid="ISA 66:9">तुम्हर परमेसर ह कहत हे।<verse eid="ISA 66:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 66:10" />“तुमन जम्मो, जेमन यरूसलेम ले मया करथव,</para>
  <para style="q2" vid="ISA 66:10">ओकर संग आनंद मनावव अऊ ओकर बर खुसी मनावव;</para>
  <para style="q1" vid="ISA 66:10">तुमन जम्मो, जेमन ओकर बर सोक करथव,</para>
  <para style="q2" vid="ISA 66:10">ओकर संग बहुंत आनंदित होवव।<verse eid="ISA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 66:11" />काबरकि तुमन ला दूध पिलाय जाही</para>
  <para style="q2" vid="ISA 66:11">अऊ तुमन ओकर सांति देवइया थन ले संतुस्ट होहू;</para>
  <para style="q2" vid="ISA 66:11">तुमन बहुंत दूध पीहू</para>
  <para style="q1" vid="ISA 66:11">अऊ ओकर अधिकता ले तुमन खुस होहू।”<verse eid="ISA 66:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 66:12" />काबरकि यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="ISA 66:12">“देखव, मेंह ओला नदी के सहीं सांति,</para>
  <para style="q2" vid="ISA 66:12">अऊ नरवा म पूरा आय सहीं जाति-जाति के धन ओला दूहूं;</para>
  <para style="q1" vid="ISA 66:12">तुमन दूध पीहू अऊ तुमन ला ओह अपन गोदी म लीही</para>
  <para style="q2" vid="ISA 66:12">अऊ अपन माड़ी म रखके तुमन ला लाड़ करही।<verse eid="ISA 66:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 66:13" />जइसन एक दाई ह अपन लइका ला दुलारथे,</para>
  <para style="q2" vid="ISA 66:13">वइसन ही में घलो तुमन ला दुलारहूं;</para>
  <para style="q2" vid="ISA 66:13">अऊ तुमन ला यरूसलेम म ही सांति मिलही।”<verse eid="ISA 66:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 66:14" />जब तुमन ये देखहू, त तुम्हर मन ह आनंदित होही</para>
  <para style="q2" vid="ISA 66:14">अऊ तुमन घांस सहीं बाढ़हू;</para>
  <para style="q1" vid="ISA 66:14">यहोवा के हांथ ओकर सेवकमन ऊपर परगट होही,</para>
  <para style="q2" vid="ISA 66:14">पर ओकर बईरीमन ऊपर ओकर रिस ह भड़कही।<verse eid="ISA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 66:15" />देखव, यहोवा ह आगी के संग आवत हे,</para>
  <para style="q2" vid="ISA 66:15">अऊ ओकर रथमन बवंडर सहीं अंय;</para>
  <para style="q1" vid="ISA 66:15">ओह अपन रिस ला जलजलाहट के संग</para>
  <para style="q2" vid="ISA 66:15">अऊ अपन डांट ला आगी के लपट के संग लानही।<verse eid="ISA 66:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 66:16" />काबरकि यहोवा ह जम्मो मनखेमन के नियाय</para>
  <para style="q2" vid="ISA 66:16">आगी ले अऊ अपन तलवार ले करही,</para>
  <para style="q2" vid="ISA 66:16">अऊ यहोवा के दुवारा मारे गय मनखेमन अब्बड़ होहीं।<verse eid="ISA 66:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17" />यहोवा ह कहिथे, “जेमन अपनआप ला एकर बर पबितर अऊ सुध करथें कि ओमन ओकर पाछू-पाछू बारीमन म जावंय, जऊन ह ओ मनखेमन के बीच हवय, जेमन सूरा अऊ मुसवा के मांस अऊ आने असुध चीजमन ला खाथें—ओमन जेकर पाछू-पाछू जावत हें, ओमन आखिरी म एके संग नास हो जाहीं,” यहोवा ह घोसना करत हे।<verse eid="ISA 66:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18" />“ओमन जऊन योजना बनाके काम करे हवंय, ओकर कारन मेंह आनेचवाला हंव अऊ मेंह जाति-जाति अऊ भासा-भासा के मनखेमन ला इकट्ठा करहूं अऊ ओमन आके मोर महिमा देखहीं।<verse eid="ISA 66:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 66:19" />“में ओमन म एक चिनहां परगट करहूं, अऊ ओमन के बांचे कुछू मनखेमन ला में ओ जातिमन करा पठोहूं, जेमन न तो मोर बारे म सुने हवंय अऊ न ही मोर महिमा देखे हवंय, याने कि मेंह ओमन ला तरसीसीमन करा, लिबियन<note caller="+" style="f"><char style="fr" closed="false">66:19 </char><char style="ft" closed="false">कुछू सेप्टाजिन्ट हस्तलिपि म </char><char style="fqa" closed="false">पूत; इबरानी म </char><char style="fqa" closed="false">पूल</char></note> अऊ लूदीमन करा (धनुसधारी के रूप म माहिर), तूबली अऊ यूनानीमन करा अऊ दूरिहा के द्वीपवासीमन करा पठोहूं। ओमन जाति-जाति के मनखेमन के बीच मोर महिमा के बखान करहीं। <verse eid="ISA 66:19" /><verse number="20" style="v" sid="ISA 66:20" />अऊ ओमन जम्मो जातिमन ले तुम्हर जम्मो मनखेमन ला यहोवा बर एक भेंट के रूप म यरूसलेम म मोर पबितर पहाड़ मेर लानहीं—ओमन ला घोड़ा, रथ, गाड़ी, खच्चर अऊ ऊंटमन म बईठाके लानहीं,” यहोवा ह कहत हे। “ओमन ला अइसे लाय जाही, जइसे इसरायलीमन यहोवा के मंदिर म सुध बरतन म अन्न-बलिदान लानथें। <verse eid="ISA 66:20" /><verse number="21" style="v" sid="ISA 66:21" />अऊ मेंह ओमन के कुछू मनखे ला पुरोहित अऊ लेवी के रूप म काम करे बर अलग करहूं,” यहोवा ह कहत हे।<verse eid="ISA 66:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22" />“जइसन नवां अकास अऊ नवां धरती, जेमन ला मेंह बनाहूं, मोर आघू म बने रहिहीं,” यहोवा ह घोसना करत हे, “वइसन तुम्हर नांव अऊ तुम्हर संतानमन घलो बने रहिहीं। <verse eid="ISA 66:22" /><verse number="23" style="v" sid="ISA 66:23" />एक नवां चंदा ले दूसर नवां चंदा तक अऊ एक बिसराम दिन ले दूसर बिसराम दिन तक, जम्मो मनखेमन आहीं अऊ मोर आघू म मुड़ नवाहीं,” यहोवा ह कहत हे। <verse eid="ISA 66:23" /><verse number="24" style="v" sid="ISA 66:24" />“अऊ ओमन बाहिर निकलहीं अऊ ओ मनखेमन के लास ला देखहीं, जेमन मोर ले बिदरोह करे रिहिन; जऊन कीरामन ओ लासमन ला खाथें, ओमन नइं मरंय, अऊ जऊन आगी ले ओमन ला जलाय जाथे, ओह नइं बुतावय, अऊ ओमन जम्मो मानव-जाति बर घिनौना हो जाहीं।”<verse eid="ISA 66:24" /></para>
  <chapter eid="ISA 66" />
</usx>