<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">मत्ती</para>
  <para style="toc1">मत्ती के लिखे सुघर संदेस</para>
  <para style="toc2">मत्ती</para>
  <para style="toc3">मत्ती</para>
  <para style="mt1">मत्ती</para>
  <para style="mt2">के लिखे सुघर संदेस</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">यीसू के बंसावली</para>
  <para style="r">(<ref loc="LUK 3:23-38">लूका 3:23‑38</ref>)</para>
  <para style="lh">
    <verse number="1" style="v" sid="MAT 1:1" />येह यीसू मसीह के बंसावली अय—यीसू ह दाऊद के बंस के रिहिस अऊ दाऊद ह अब्राहम के बंस के रिहिस।<verse eid="MAT 1:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />अब्राहम के बेटा इसहाक रिहिस;</para>
  <para style="li1" vid="MAT 1:2">इसहाक के बेटा याकूब रिहिस;</para>
  <para style="li1" vid="MAT 1:2">याकूब ह यहूदा अऊ ओकर भाईमन के ददा रिहिस;<verse eid="MAT 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3" />यहूदा के बेटा पेरेस अऊ जेरह रिहिन; जेमन के दाई के नांव तामार रिहिस;</para>
  <para style="li1" vid="MAT 1:3">पेरेस के बेटा हेसरोन रिहिस,</para>
  <para style="li1" vid="MAT 1:3">अऊ हेसरोन के बेटा एराम रिहिस;<verse eid="MAT 1:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4" />एराम के बेटा अम्मीनादाब रिहिस;</para>
  <para style="li1" vid="MAT 1:4">अम्मीनादाब के बेटा नहसोन,</para>
  <para style="li1" vid="MAT 1:4">नहसोन के बेटा सलमोन रिहिस;<verse eid="MAT 1:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5" />सलमोन के बेटा बोअज रिहिस; बोअज के दाई के नांव राहाब रिहिस;</para>
  <para style="li1" vid="MAT 1:5">बोअज के बेटा ओबेद रिहिस; अऊ ओबेद के दाई के नांव रूत रिहिस;</para>
  <para style="li1" vid="MAT 1:5">ओबेद के बेटा यिसै रिहिस;<verse eid="MAT 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6" />यिसै के बेटा राजा दाऊद रिहिस।</para>
  <para style="b" vid="MAT 1:6" />
  <para style="li1" vid="MAT 1:6">दाऊद के बेटा सुलेमान रिहिस; सुलेमान ह ओ माईलोगन ले जनमिस, जऊन ह पहिली उरियाह के घरवाली रिहिस;<verse eid="MAT 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7" />सुलेमान के बेटा रहूबियाम रिहिस;</para>
  <para style="li1" vid="MAT 1:7">रहूबियाम के बेटा अबियाह रिहिस;</para>
  <para style="li1" vid="MAT 1:7">अऊ अबियाह के बेटा आसा रिहिस;<verse eid="MAT 1:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8" />आसा के बेटा यहोसापात रिहिस;</para>
  <para style="li1" vid="MAT 1:8">यहोसापात के बेटा योराम रिहिस;</para>
  <para style="li1" vid="MAT 1:8">अऊ योराम के बेटा उजियाह रिहिस;<verse eid="MAT 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9" />उजियाह के बेटा योताम रिहिस;</para>
  <para style="li1" vid="MAT 1:9">योताम के बेटा आहाज रिहिस;</para>
  <para style="li1" vid="MAT 1:9">अऊ आहाज के बेटा हिजकियाह रिहिस;<verse eid="MAT 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10" />हिजकियाह के बेटा मनस्से रिहिस;</para>
  <para style="li1" vid="MAT 1:10">मनस्से के बेटा आमोन रिहिस;</para>
  <para style="li1" vid="MAT 1:10">अऊ आमोन के बेटा योसियाह रिहिस;<verse eid="MAT 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11" />बंधुवा होके बेबिलोन देस ले जाय के बेरा म योसियाह के बेटा यकुन्याह, अऊ ओकर भाईमन रिहिन।<verse eid="MAT 1:11" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="MAT 1:12" />बंधुवा होके बेबिलोन जाय के पाछू:</para>
  <para style="li1" vid="MAT 1:12">यकुन्याह के बेटा सालतीएल रिहिस;</para>
  <para style="li1" vid="MAT 1:12">अऊ सालतीएल के बेटा जरूब्बाबेल रिहिस;<verse eid="MAT 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13" />जरूब्बाबेल के बेटा अबीहूद रिहिस;</para>
  <para style="li1" vid="MAT 1:13">अबीहूद के बेटा एलयाकीम रिहिस;</para>
  <para style="li1" vid="MAT 1:13">अऊ एलयाकीम के बेटा आजोर रिहिस;<verse eid="MAT 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14" />आजोर के बेटा सादोक रिहिस;</para>
  <para style="li1" vid="MAT 1:14">सादोक के बेटा अखीम रिहिस;</para>
  <para style="li1" vid="MAT 1:14">अऊ अखीम के बेटा इलीहूद रिहिस;<verse eid="MAT 1:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15" />इलीहूद के बेटा एलिआजर रिहिस;</para>
  <para style="li1" vid="MAT 1:15">एलिआजर के बेटा मतान रिहिस;</para>
  <para style="li1" vid="MAT 1:15">अऊ मतान के बेटा याकूब रिहिस;<verse eid="MAT 1:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16" />याकूब के बेटा यूसुफ रिहिस; यूसुफ ह मरियम के घरवाला रिहिस, अऊ मरियम ले यीसू जनमिस, जऊन ला मसीह कहे जाथे।<verse eid="MAT 1:16" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="17" style="v" sid="MAT 1:17" />ये किसम ले अब्राहम ले लेके दाऊद तक जम्मो चौदह पीढ़ी होईस, अऊ दाऊद ले लेके बेबिलोन म बंधुवई म जावत तक चौदह पीढ़ी, अऊ बंधुवई ले लेके मसीह<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="fq" closed="false">मसीह </char><char style="ft" closed="false">इबरानी म अऊ </char><char style="fqa" closed="false">ख्रिस्त </char><char style="ft" closed="false">यूनानी म, दूनों सबद के मतलब </char><char style="fqa" closed="false">अभिसिक्त जन </char><char style="ft" closed="false">होथे।</char></note> तक चौदह पीढ़ी होईस।<verse eid="MAT 1:17" /></para>
  <para style="s1">यीसू मसीह के जनम</para>
  <para style="r">(<ref loc="LUK 2:1-7">लूका 2:1‑7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />यीसू मसीह के जनम ये किसम ले होईस। यीसू के दाई मरियम के मंगनी यूसुफ के संग होय रिहिस, पर एकर पहिली कि ओमन दूनों घरवाला-घरवाली के रूप म एक संग होतिन, मरियम ह पबितर आतमा के जरिये पेट म पाय गीस। <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />काबरकि मरियम के होवइया घरवाला यूसुफ ह एक धरमी मनखे रिहिस अऊ ओह मरियम ला मनखेमन के आघू म बदनाम करे नइं चाहत रिहिस, एकर खातिर ओह ओला चुपेचाप छोंड़ देय के बिचार करिस।<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />पर ओकर ये बिचार करे के पाछू, परभू के एक स्वरगदूत ह ओला सपना म दिखिस अऊ ओ स्वरगदूत ह ओला कहिस, “हे यूसुफ, दाऊद के संतान, तेंह मरियम ला अपन घरवाली के रूप म घर लाय बर झन डर, काबरकि जऊन ह ओकर गरभ म हवय, ओह पबितर आतमा के तरफ ले अय। <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />ओह एक बेटा ला जनम दीही अऊ तें ओकर नांव यीसू<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fqa" closed="false">यहोसू </char><char style="ft" closed="false">ला यूनानी भासा म </char><char style="fq" closed="false">यीसू </char><char style="ft" closed="false">कहिथें, जेकर मतलब होथे </char><char style="fqa" closed="false">परभू बचाथे </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परभू उद्धार करथे</char></note> रखबे, काबरकि ओह अपन मनखेमन ला ओमन के पाप ले छुटकारा दीही।”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />ये जम्मो बात एकर खातिर होईस कि जऊन बात, परभू ह अगमजानी के जरिये कहे रिहिस, ओह पूरा होवय: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“देखव, एक कुंवारी ह गरभवती होही, अऊ ओह एक बेटा जनमही, अऊ ओकर नांव इमानुएल रखे जाही”<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 7:14">यसा 7:14</ref></char></char></note> (जेकर मतलब होथे “परमेसर हमर संग”)।<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />जब यूसुफ ह नींद ले जागिस, त ओह वइसनेच करिस जइसने परभू के स्वरगदूत ह ओला हुकूम दे रिहिस अऊ ओह मरियम ला अपन घरवाली के रूप म अपन घर ले गीस। <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />पर जब तक मरियम ह बेटा ला जनम नइं दीस, तब तक यूसुफ ह ओकर करा नइं गीस। अऊ ओह ओकर नांव यीसू रखिस।<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">जोतिसीमन मसीह करा जाथें</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />जब हेरोदेस राजा ह राज करत रिहिस, त यहूदिया प्रदेस के बैतलहम गांव म यीसू के जनम होईस, तब पूरब दिग के देस म ले कुछू जोतिसीमन यरूसलेम<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">यरूसलेम </char><char style="ft" closed="false">ह यहूदी मनखेमन के </char><char style="fqa" closed="false">खास सहर </char><char style="ft" closed="false">अय।</char></note> सहर म आईन, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />अऊ मनखेमन ले पुछिन, “ओ लइका के जनम कहां होईस हवय, जऊन ह यहूदीमन के राजा अय? हमन पूरब दिग म ओकर तारा देखे हवन अऊ ओकर अराधना करे बर आय हवन।”<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false"><char style="xt"><ref loc="NUM 24:17">गन 24:17</ref></char></char></note><verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />ये सुनके हेरोदेस राजा अऊ यरूसलेम सहर के जम्मो मनखेमन घबरा गीन। <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />राजा ह मनखेमन के जम्मो मुखिया पुरोहित अऊ कानून के गुरूमन ला एक जगह म बलाईस अऊ ओमन ले पुछिस, “मसीह के जनम कहां होना चाही?” <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />ओमन कहिन, “यहूदिया प्रदेस के बैतलहम गांव म, काबरकि अगमजानी ह अइसने लिखे हवय:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“ ‘हे यहूदा प्रदेस के बैतलहम गांव,</para>
  <para style="q2" vid="MAT 2:6">तेंह यहूदा प्रदेस के बड़े सहरमन ले कोनो भी किसम ले छोटे नो हस,</para>
  <para style="q1" vid="MAT 2:6">काबरकि तोर म ले एक झन सासन करइया निकलही,</para>
  <para style="q2" vid="MAT 2:6">जऊन ह मोर मनखे इसरायलीमन के रखवारी करही।’<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="MIC 5:2">मीका 5:2</ref></char></char></note>”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />तब हेरोदेस राजा ह जोतिसीमन ला चुपेचाप बलाईस अऊ ओमन ले पता लगाईस कि तारा ह ठऊका का बेरा म दिखे रिहिस। <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />तब ओह ओमन ला ये कहिके बैतलहम पठोईस, “जावव अऊ ओ लइका के बारे म सही-सही पता मालूम करव। अऊ जब ओह तुमन ला मिल जावय, त मोला खबर भिजवाव, ताकि महूं घलो जाके ओकर अराधना करंव।”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />जोतिसीमन राजा के बात ला सुने के पाछू अपन डहार म चल दीन, अऊ जऊन तारा ला ओमन पूरब दिग म देखे रिहिन, ओह ओमन के आघू-आघू गीस अऊ ओ ठऊर के ऊपर जाके ठहर गीस, जिहां लइका ह रहय। <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />जब ओमन ओ तारा ला देखिन, त अब्बड़ आनंदित होईन। <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />घर भीतरी जाके, ओमन लइका ला ओकर दाई मरियम के संग देखिन अऊ भुइयां म गिरके ओला दंडवत करिन। तब ओमन अपन-अपन झोला ला खोलके ओला सोन, लोबान अऊ गंधरस के भेंट चघाईन। <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />अऊ परमेसर ह ओमन ला सपना म चेतउनी दीस कि ओमन हेरोदेस करा झन जावंय, एकरसेति, ओमन आने डहार ले अपन देस लहुंट गीन।<verse eid="MAT 2:12" /></para>
  <para style="s1">मिसर देस जवई</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />जब जोतिसीमन चले गीन, त परभू के एक स्वरगदूत ह सपना म यूसुफ ला दिखाई दीस अऊ ओला कहिस, “उठ, लइका अऊ ओकर दाई ला लेके मिसर देस भाग जा। अऊ जब तक मेंह नइं कहंव, तब तक तें उहेंच रह, काबरकि हेरोदेस राजा ह ये लइका ला मरवाय खातिर खोजवइया हवय।”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />तब यूसुफ ह उठिस अऊ रथियाच, ओह लइका अऊ ओकर दाई ला लेके, मिसर देस चल दीस, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />अऊ ओह उहां हेरोदेस के मिरतू तक रिहिस, ताकि जऊन बात परभू ह अगमजानी के दुवारा कहे रिहिस, ओह पूरा होवय: “मिसर देस ले मेंह अपन बेटा ला बलांय।”<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 11:1">होसे 11:1</ref>; <ref loc="EXO 4:22-23">निर 4:22‑23</ref></char></char></note><verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />जब हेरोदेस राजा ला मालूम होईस कि जोतिसीमन ओकर संग धोखा करे हवंय, त ओह बहुंत नराज होईस, अऊ ओह ये हुकूम दीस कि बैतलहम अऊ ओकर आसपास के गांव के दू बछर या ओकर ले छोटे जम्मो लइकामन ला मार डारे जावय। काबरकि येह जोतिसीमन के बताय गय समय के मुताबिक रिहिस। <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />तब जऊन बात यरमियाह अगमजानी कहे रिहिस, ओह पूरा होईस:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“रामाह सहर म रोये अऊ बहुंते बिलाप करे के अवाज सुनई दीस,</para>
  <para style="q2" vid="MAT 2:18">राहेल ह अपन लइकामन खातिर रोवत रिहिस,</para>
  <para style="q1" vid="MAT 2:18">अऊ ओह नइं चाहत रिहिस कि कोनो ओला सांतवना देवंय,</para>
  <para style="q2" vid="MAT 2:18">काबरकि ओकर लइकामन मर गे रिहिन<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fq" closed="false">राहेल </char><char style="ft" closed="false">ह इहां </char><char style="fqa" closed="false">इसरायल के मनखेमन </char><char style="ft" closed="false">ला दरसाथे, जऊन मन बहुंत दुख सहिन।</char></note>।”<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:15">यर 31:15</ref></char></char></note><verse eid="MAT 2:18" /></para>
  <para style="s1">मिसर देस ले नासरत वापिस अवई</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />हेरोदेस राजा के मरे के पाछू, परभू के एक स्वरगदूत ह मिसर देस म यूसुफ ला सपना म दिखाई दीस, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />अऊ यूसुफ ले कहिस, “उठ! लइका अऊ ओकर दाई ला लेके इसरायल देस चले जा, काबरकि जऊन मन ये लइका के परान लेय के कोसिस करत रिहिन, ओमन मर गे हवंय।”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />तब यूसुफ ह उठिस, अऊ लइका अऊ ओकर दाई ला लेके इसरायल देस चल दीस। <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />पर जब ओह ये सुनिस कि अरखिलाउस ह अपन ददा हेरोदेस के जगह म यहूदिया प्रदेस म राज करत हवय, त ओह उहां जाय बर डराईस। सपना म चेतउनी पाके, ओह गलील प्रदेस चले गीस, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />अऊ ओह उहां जाके नासरत नांव के एक नगर म निवास करिस। तब अगमजानीमन के दुवारा कहे गे ये बात ह पूरा होईस: “ओला नासरी कहे जाही<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">नासरत ह यूसुफ अऊ मरियम के गांव रिहिस। <char style="xt"><ref loc="LUK 1:26-27">लूका 1:26‑27</ref>; <ref loc="LUK 2:4">2:4</ref>, <ref loc="LUK 2:39">39</ref></char></char></note>।”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">यूहन्ना बतिसमा देवइया डहार तियार करथे</para>
  <para style="r">(<ref loc="MRK 1:1-8">मरकुस 1:1‑8</ref>; <ref loc="LUK 3:1-18">लूका 3:1‑18</ref>; <ref loc="JHN 1:6-8">यूहन्ना 1:6‑8</ref>, <ref loc="JHN 1:15-34">15‑34</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />ओ दिनमन म यूहन्ना बतिसमा देवइया आईस अऊ यहूदिया प्रदेस के सुनसान जगह म ये परचार करे लगिस, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />“पछताप करव, काबरकि स्वरग के राज ह लकठा आ गे हवय।” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />ये यूहन्ना ओ मनखे अय, जेकर बारे म यसायाह अगमजानी ह ये कहे रिहिस:</para>
  <para style="q1" vid="MAT 3:3">“सुनसान जगह म एक झन अवाज देवत रिहिस,</para>
  <para style="q1" vid="MAT 3:3">‘परभू बर डहार ला तियार करव,</para>
  <para style="q2" vid="MAT 3:3">अऊ ओकर डहार ला सीधा करव।’ ”<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">यसा 40:3</ref></char></char></note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />यूहन्ना ह ऊंट के रूआं के बने कपड़ा पहिरय अऊ अपन कनिहां म चमड़ा के बने पट्टा बांधय। ओह फांफा अऊ जंगली मंधरस खावय। <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />फेर यरूसलेम, अऊ जम्मो यहूदिया प्रदेस अऊ यरदन नदी के जम्मो छेत्र के मनखेमन ओकर करा गीन, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />अऊ अपन-अपन पाप ला मानके, ओमन यरदन नदी म यूहन्ना ले बतिसमा लीन।<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />जब यूहन्ना बतिसमा देवइया ह देखिस कि अब्बड़ फरीसी अऊ सदूकीमन ओकर करा बतिसमा लेय बर आवत हवंय, त ओह ओमन ला कहिस, “हे जहरिला सांप के पीलामन हो! तुमन ला कोन ह चेता दीस कि तुमन परमेसर के अवइया कोरोध ले भागव? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />अपन काम के दुवारा देखावव कि पाप ले पछतावा करे हवव। <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />अऊ अपन मन म ये बात झन सोचव कि तुमन अब्राहम के संतान अव। मेंह तुमन ला बतावत हंव कि ये पथरामन ले परमेसर ह अब्राहम बर संतान पईदा कर सकथे। <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />टंगिया ला पहिले ही रूखमन के जरी म रखे जा चुके हवय, अऊ जऊन रूख म बने फर नइं फरय, ओह काटे अऊ आगी म झोंके जाही।<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />“जऊन मन अपन पाप ले पछताप करथें, मेंह ओमन ला पानी ले बतिसमा देवत हंव। पर मोर बाद, एक झन आही, जऊन ह मोर ले जादा सक्तिसाली ए। मेंह ओकर पनही ला उठाय के लईक घलो नो हंव। ओह तुमन ला पबितर आतमा अऊ आगी ले बतिसमा दीही। <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />ओकर सूपा ह ओकर हांथ म हवय अऊ ओह अपन कोठार ला साफ करही, अऊ अपन गहूं ला कोठा म कुढ़ोही। पर ओह भूंसा ला ओ आगी म बारही, जऊन ह कभू नइं बुतावय।”<verse eid="MAT 3:12" /></para>
  <para style="s1">यीसू के बतिसमा</para>
  <para style="r">(<ref loc="MRK 1:9-11">मरकुस 1:9‑11</ref>; <ref loc="LUK 3:21-22">लूका 3:21‑22</ref>; <ref loc="JHN 1:31-34">यूहन्ना 1:31‑34</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />तब यीसू ह गलील प्रदेस ले यरदन नदी करा यूहन्ना ले बतिसमा लेय बर आईस। <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />पर यूहन्ना ह ये कहिके ओला रोके के कोसिस करिस, “मोला तोर ले बतिसमा लेय के जरूरत हवय, अऊ तेंह मोर करा आय हवस?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />पर यीसू ह ओला ये जबाब दीस, “अभी तो अइसने होवन दे; काबरकि जम्मो धरमीपन ला पूरा करे बर अइसने करई, हमर बर उचित ए।” तब यूहन्ना ह यीसू के बात ला मान लीस।<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />बतिसमा लेय के बाद यीसू ह तुरते पानी ले बाहिर निकलिस। ओहीच समय अकास ह खुल गीस, अऊ ओह परमेसर के आतमा ला पंड़की के सहीं अपन ऊपर उतरत देखिस। <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />अऊ अकास ले ये अवाज आईस, “येह मोर मयारू बेटा अय, जेकर ले मेंह बहुंत खुस हवंव।”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">यीसू के परिछा</para>
  <para style="r">(<ref loc="MRK 1:12-13">मरकुस 1:12‑13</ref>; <ref loc="LUK 4:1-13">लूका 4:1‑13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />तब पबितर आतमा ह यीसू ला निरजन जगह म ले गीस कि सैतान के दुवारा ओकर परिछा होवय। <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />यीसू ह चालीस दिन अऊ चालीस रात उपास रिहिस, ओकर पाछू ओला भूख लगिस। <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />तब सैतान ह ओकर करा आईस अऊ कहिस, “यदि तेंह परमेसर के बेटा अस, त ये पथरामन ले कह कि येमन रोटी बन जावंय।”<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="HEB 2:17-18">इब 2:17‑18</ref>; <ref loc="HEB 4:15">4:15</ref></char></char></note><verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />यीसू ह जबाब दीस, “परमेसर के बचन म लिखे हवय, ‘मनखे ह सिरिप रोटी ले ही जीयत नइं रहय, फेर हर ओ बचन, जऊन ह परमेसर के मुहूं ले निकलथे जीयत रहिही।’<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="HEB 8:3">इब 8:3</ref></char></char></note>”<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />तब सैतान ह यीसू ला पबितर सहर<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">इहां </char><char style="fq" closed="false">पबितर सहर </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">यरूसलेम सहर </char><char style="ft" closed="false">अय।</char></note> म ले गीस अऊ ओला मंदिर के टीप म ठाढ़ करके कहिस, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />“कहूं तेंह परमेसर के बेटा अस, त उहां ले खाल्हे कूद जा, काबरकि परमेसर के बचन म ये लिखे हवय,</para>
  <para style="q1" vid="MAT 4:6">“परमेसर ह तोर बारे म अपन स्वरगदूतमन ला हुकूम दीही,</para>
  <para style="q2" vid="MAT 4:6">अऊ ओमन तोला अपन हांथ म उठा लीहीं,</para>
  <para style="q2" vid="MAT 4:6">ताकि तोर गोड़ म पथरा ले चोट झन लगय।<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 91:11-12">भजन 91:11‑12</ref></char></char></note>”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />यीसू ह ओला कहिस, “परमेसर के बचन म ये घलो लिखे हवय, ‘परभू अपन परमेसर के परिछा झन कर।’<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:16">ब्यव 6:16</ref>; <ref loc="EXO 17:2-7">निर 17:2‑7</ref></char></char></note>”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />तब फेर सैतान ह यीसू ला एक ठन बहुंत ऊंच पहाड़ ऊपर ले गीस अऊ ओला संसार के जम्मो राजपाट अऊ ओकर सोभा ला देखाके कहिस, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />“यदि तेंह झुकके मोर अराधना करबे, त मेंह तोला ये जम्मो ला दे दूहूं।”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />फेर यीसू ह ओला कहिस, “हे सैतान! मोर ले दूरिहा हट; काबरकि परमेसर के बचन म ये लिखे हवय, तेंह परभू अपन परमेसर के अराधना कर अऊ सिरिप ओकरेच सेवा कर।”<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:13">ब्यव 6:13</ref></char></char></note><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />तब सैतान ह ओकर करा ले चले गीस, अऊ स्वरगदूतमन आके ओकर सेवा करे लगिन।<verse eid="MAT 4:11" /></para>
  <para style="s1">यीसू ह परचार करे के सुरू करथे</para>
  <para style="r">(<ref loc="MRK 1:14-15">मरकुस 1:14‑15</ref>; <ref loc="LUK 4:14-15">लूका 4:14‑15</ref>, <ref loc="LUK 4:31">31</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />जब यीसू ह ये सुनिस कि यूहन्ना ला जेल म डार दे गे हवय, त ओह गलील प्रदेस ला चल दीस। <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />यीसू ह, नासरत ला छोंड़ दीस अऊ कफरनहूम सहर म जाके बस गीस, ये सहर ह जबूलून अऊ नपताली के सीमना म झील के तीर म रिहिस। <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />येह एकर खातिर होईस ताकि यसायाह अगमजानी के दुवारा कहे गय ये बात ह पूरा होवय:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“जबूलून के देस अऊ नपताली के देस,</para>
  <para style="q2" vid="MAT 4:15">समुंदर के तरफ जाय के रसता म,</para>
  <para style="q2" vid="MAT 4:15">यरदन नदी के ओ पार, आनजातमन के गलील प्रदेस,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />जऊन मनखेमन अंधियार म रहत रिहिन,</para>
  <para style="q2" vid="MAT 4:16">ओमन एक बड़े अंजोर ला देखिन;</para>
  <para style="q1" vid="MAT 4:16">अऊ जऊन मन मिरतू के छइहां के प्रदेस म रहत रिहिन,</para>
  <para style="q2" vid="MAT 4:16">ओमन के ऊपर एक अंजोर चमकिस।”<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 9:1-2">यसा 9:1‑2</ref></char></char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />ओ समय ले यीसू ह परचार करन लगिस अऊ कहिस, “अपन पाप ले पछताप करव, काबरकि स्वरग के राज ह लकठा आ गे हवय।”<verse eid="MAT 4:17" /></para>
  <para style="s1">यीसू के पहिली चेलामन</para>
  <para style="r">(<ref loc="MRK 1:16-20">मरकुस 1:16‑20</ref>; <ref loc="LUK 5:1-11">लूका 5:1‑11</ref>; <ref loc="JHN 1:35-42">यूहन्ना 1:35‑42</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />जब यीसू ह गलील झील के तीरे-तीर जावत रिहिस, त ओह दू झन भाईमन ला देखिस; ओमन के नांव सिमोन जऊन ला पतरस कहे जाथे अऊ ओकर भाई अन्द्रियास रिहिस। ये दूनों भाई झील म जाल डारत रिहिन, काबरकि ओमन मछुआर रिहिन। <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />यीसू ह ओमन ला कहिस, “मोर पाछू आवव; मेंह तुमन ला मनखे पकड़इया मछुआर बनाहूं।” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />ओमन तुरते अपन जाल ला छोंड़के ओकर पाछू हो लीन।<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />उहां ले आघू जाय के बाद, यीसू ह दू झन अऊ भाईमन ला देखिस—याकूब अऊ ओकर भाई यूहन्ना ला, जऊन मन जबदी के बेटा रिहिन। ओमन अपन ददा जबदी के संग एक ठन डोंगा म रहंय अऊ अपन जाल ला सुधारत रहंय। यीसू ह ओमन ला बलाईस, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />अऊ ओमन तुरते डोंगा अऊ अपन ददा ला छोंड़के यीसू के पाछू हो लीन।<verse eid="MAT 4:22" /></para>
  <para style="s1">यीसू ह बिमरहा ला बने करथे</para>
  <para style="r">(<ref loc="LUK 6:17-19">लूका 6:17‑19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />यीसू ह जम्मो गलील प्रदेस म जाके, यहूदीमन के सभा-घर म उपदेस दीस, अऊ परमेसर के राज के सुघर संदेस के परचार करिस, अऊ मनखेमन के हर किसम के रोग अऊ बेमारी ला बने करिस। <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />यीसू के खबर ह जम्मो सीरिया देस म फईल गीस, अऊ मनखेमन ओ जम्मो झन ला ओकर करा लाने लगिन, जऊन मन कतको किसम के रोग ले बेमार रहंय, जऊन मन असहनीय पीरा म रहंय, जऊन मन ला परेत आतमा धरे रहय, जऊन मन ला मिरगी के बेमारी रहय, अऊ जऊन मन ला लकवा मारे रहय; यीसू ह ओ जम्मो झन ला चंगा करिस। <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />गलील प्रदेस, दिकापुलिस,<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">दस सहर</char></note> यरूसलेम, यहूदिया, अऊ यरदन नदी के ओ पार के मनखेमन के एक बड़े भीड़ ओकर पाछू हो लीस।<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">पहाड़ ऊपर यीसू के उपदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />जब यीसू ह मनखेमन के भीड़ ला देखिस, त ओह पहाड़ ऊपर चघके उहां बईठ गीस। तब ओकर चेलामन ओकर करा आईन, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />अऊ ओह ओमन ला उपदेस देवन लगिस।</para>
  <para style="s1" vid="MAT 5:2">धइन बचन</para>
  <para style="m" vid="MAT 5:2">ओह कहिस:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“धइन अंय ओमन, जऊन मन आतमा म दीन अंय,</para>
  <para style="q2" vid="MAT 5:3">काबरकि स्वरग के राज ओमन के अय।<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />धइन अंय ओमन, जऊन मन सोक करथें,</para>
  <para style="q2" vid="MAT 5:4">काबरकि ओमन ला सांति दिये जाही।<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />धइन अंय ओमन, जऊन मन नरम सुभाव के अंय,</para>
  <para style="q2" vid="MAT 5:5">काबरकि ओमन धरती के उत्तराधिकारी होहीं।<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />धइन अंय ओमन, जऊन मन धरमीपन बर भूखन अऊ पीयासन हवंय,</para>
  <para style="q2" vid="MAT 5:6">काबरकि परमेसर ह ओमन ला संतोस करही।<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />धइन अंय ओमन, जऊन मन दयालु अंय,</para>
  <para style="q2" vid="MAT 5:7">काबरकि ओमन के ऊपर दया करे जाही।<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />धइन अंय ओमन, जऊन मन के हिरदय निरमल हवय,</para>
  <para style="q2" vid="MAT 5:8">काबरकि ओमन परमेसर के दरसन करहीं।<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />धइन अंय ओमन, जऊन मन मेल-मिलाप कराथें,</para>
  <para style="q2" vid="MAT 5:9">काबरकि ओमन ला परमेसर के बेटा कहे जाही।<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />धइन अंय ओमन, जऊन मन धरमीपन के कारन सताय जाथें,</para>
  <para style="q2" vid="MAT 5:10">काबरकि स्वरग के राज ओमन के अय।<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“धइन अव तुमन, जब मनखेमन मोर कारन तुम्हर बेजत्ती करथें, तुमन ला सताथें अऊ झूठ-मूठ के, तुम्हर बिरोध म किसम-किसम के खराप बात कहिथें। <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />आनंद मनावव अऊ खुस रहव, काबरकि स्वरग म तुम्हर बर बड़े ईनाम रखे हवय। तुम्हर ले पहिली अगमजानीमन ला मनखेमन अइसनेच सताय रिहिन।<verse eid="MAT 5:12" /></para>
  <para style="s1">नून अऊ अंजोर</para>
  <para style="r">(<ref loc="MRK 9:50">मरकुस 9:50</ref>; <ref loc="LUK 14:34-35">लूका 14:34‑35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“तुमन धरती के नून अव। पर कहूं नून ह अपन सुवाद ला गंवा देथे, त कोनो किसम ले येला फेर नूनचूर नइं करे जा सकय। येह कोनो काम के नइं रह जावय। येला बाहिर फटिक दिये जाथे अऊ येह मनखेमन के गोड़ तरी रऊंदे जाथे।<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />“तुमन संसार के अंजोर अव। पहाड़ ऊपर बसे सहर ह छिपे नइं रह सकय। <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />अऊ न तो मनखेमन दीया ला बारके बड़े कटोरा के खाल्हे म रखथें, पर दीया ला दीवट ऊपर मढ़ाथें, जिहां ले येह घर के हर एक जन ला अंजोर देथे। <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />ओही किसम ले, तुम्हर अंजोर ह मनखेमन के आघू म चमकय, ताकि ओमन तुम्हर बने काम ला देखंय अऊ स्वरग म रहइया तुम्हर ददा के बड़ई करंय।<verse eid="MAT 5:16" /></para>
  <para style="s1">मूसा के कानून के पूरा होवई</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“ये झन सोचव कि मेंह मूसा के कानून या अगमजानीमन के बातमन ला खतम करे बर आय हवंव। मेंह ओमन ला खतम करे खातिर नइं, पर ओमन ला पूरा करे खातिर आय हवंव। <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />मेंह तुमन ला सच कहत हंव कि जब तक स्वरग अऊ धरती हवय, तब तक मूसा के कानून के एक छोटे अकछर या बिन्दू घलो पूरा होय बिगर खतम नइं होवय। <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />जऊन ह ये हुकूममन के छोटे ले छोटे बात ला घलो नइं मानय अऊ आने मन ला घलो अइसने करे बर सिखोथे, ओह स्वरग के राज म सबले छोटे समझे जाही, पर जऊन ह ये हुकूममन ला मानथे अऊ आने मन ला माने बर सिखोथे, ओह स्वरग के राज म बड़े समझे जाही। <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />काबरकि मेंह तुमन ला कहत हवंव कि जब तक तुम्हर धरमीपन ह फरीसी अऊ कानून के गुरूमन के धरमीपन ले बढ़के नइं होवय, तब तक तुमन स्वरग के राज म नइं जा सकव।<verse eid="MAT 5:20" /></para>
  <para style="s1">हतिया अऊ गुस्सा</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“तुमन सुने हवव कि बहुंत पहिले मनखेमन ला ये कहे गे रिहिस, ‘हतिया झन करव, अऊ यदि कोनो हतिया करथे, त ओह कचहरी म दंड के भागी होही।’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />पर मेंह तुमन ला कहत हंव कि यदि कोनो अपन भाई ऊपर गुस्सा करथे, त ओह दंड के भागी होही। जऊन कोनो अपन भाई के बेजत्ती करथे, त ओला धरम महासभा के आघू म जबाब देना पड़ही। पर जऊन कोनो अपन भाई ला कहिथे, ‘ए मुरूख!’ ओह नरक के आगी म पड़े के खतरा म होही।<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />“एकरसेति, यदि तेंह बेदी म अपन भेंट चघावत हस अऊ उहां तोला सुरता आथे कि तोर भाई के मन म तोर बिरोध म कुछू हवय, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />त उहां बेदी के आघू म अपन भेंट ला छोंड़ दे अऊ पहिली अपन भाई करा जा अऊ ओकर संग मेल-मिलाप कर, तब आ अऊ अपन भेंट ला चघा।<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />“ओ मनखे जऊन ह तोर बिरोध म अदालत जावत हे, ओकर संग जल्दी करके मामला के निपटारा कर ले। कचहरी जावत बेरा डहार म ही ओकर संग मेल-मिलाप कर ले, नइं तो ओह तोला नियायधीस ला सऊंप दीही, अऊ नियायधीस ह तोला पुलिस अधिकारी ला सऊंप दीही, अऊ तेंह जेल म डाल दिये जाबे। <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />मेंह तोला सच कहत हंव कि जब तक तुमन कौड़ी-कौड़ी नइं चुका दूहू, तब तक उहां ले नइं छूट सकव।<verse eid="MAT 5:26" /></para>
  <para style="s1">छिनारीपन</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“तुमन सुने हवव कि ये कहे गे रिहिस, ‘छिनारी झन करव।’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />पर मेंह तुमन ला कहत हंव कि जऊन कोनो माईलोगन ला खराप नजर ले देखथे, त ओह अपन मन म ओकर संग पहिली ले छिनारी कर चुकिस। <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />कहूं तोर जेवनी आंखी ह तोर पाप म गिरे के कारन बनथे, त ओला निकालके फटिक दे। तोर बर येह बने अय कि अपन देहें के एक ठन अंग ला गंवा दे, पर तोर जम्मो देहें ह नरक म झन डारे जावय। <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />अऊ कहूं तोर जेवनी हांथ ह तोर पाप म गिरे के कारन बनथे, त ओला काटके फटिक दे। तोर बर येह बने अय कि अपन देहें के एक ठन अंग ला गंवा दे, पर तोर जम्मो देहें ह नरक म झन चले जावय।<verse eid="MAT 5:30" /></para>
  <para style="s1">तलाक</para>
  <para style="r">(<ref loc="MAT 19:9">मत्ती 19:9</ref>; <ref loc="MRK 10:11-12">मरकुस 10:11‑12</ref>; <ref loc="LUK 16:18">लूका 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“ये घलो कहे गे रिहिस, ‘जऊन कोनो अपन घरवाली ला छोंड़ देथे, त ओह ओला तियाग पतर जरूर देवय।’<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 24:1">ब्यव 24:1</ref>; <ref loc="MAT 19:3-9">मत्ती 19:3‑9</ref></char></char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />पर मेंह तुमन ला कहत हंव कि जऊन कोनो बेभिचार के छोंड़ कोनो आने कारन ले अपन घरवाली ला छोंड़ देथे, त ओह ओकर छिनारी करे के कारन बनथे, अऊ जऊन ह ओ तियागे गय माईलोगन ले बिहाव करथे, त ओह घलो छिनारी करथे।<verse eid="MAT 5:32" /></para>
  <para style="s1">किरिया</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“तुमन ये घलो सुने हवव कि बहुंत पहिले मनखेमन ला ये कहे गे रिहिस, ‘तुमन झूठ-मूठ के किरिया झन खावव, पर परभू के आघू म करे गे किरिया ला पूरा करव।’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />पर मेंह तुमन ला कहत हंव कि किरिया कभू झन खावव: न तो स्वरग के, काबरकि ओह परमेसर के सिंघासन अय; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />न तो धरती के, काबरकि येह परमेसर के गोड़ रखे के चउकी अय; न तो यरूसलेम के, काबरकि ओह महाराजा के सहर अय। <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />अऊ अपन मुड़ के घलो किरिया झन खावव, काबरकि तुमन एको ठन चुंदी ला घलो पंर्रा या करिया नइं कर सकव। <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />साफ-साफ तुम्हर गोठ ह हां के हां अऊ नइं के नइं होवय। एकर ले जादा जऊन कुछू होथे, ओह सैतान के तरफ ले होथे।<note caller="+" style="f"><char style="fr" closed="false">5:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="JAS 5:12">याकू 5:12</ref></char></char></note><verse eid="MAT 5:37" /></para>
  <para style="s1">बदला लेय के बारे म उपदेस</para>
  <para style="r">(<ref loc="LUK 6:29-30">लूका 6:29‑30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“तुमन सुने हवव कि ये कहे गे रिहिस, ‘आंखी के बलदा आंखी अऊ दांत के बलदा दांत।’<note caller="+" style="f"><char style="fr" closed="false">5:38 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:23-24">निर 21:23‑24</ref></char></char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />पर मेंह तुमन ला कहत हंव कि दुस्ट मनखे के सामना झन करव। यदि कोनो तुम्हर जेवनी गाल म थपरा मारथे, त अपन डेरी गाल ला घलो ओकर अंग कर देवव। <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />अऊ यदि कोनो तुम्हर ऊपर मुकदमा चलाके तुम्हर कुरता ला लेय चाहथे, त तुमन ओला अपन कोटी ला घलो लेवन दव। <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />यदि कोनो तुमन ला जबरन एक मील<note caller="+" style="f"><char style="fr" closed="false">5:41 </char><char style="ft" closed="false">लगभग डेड़ किलोमीटर</char></note> ले जाथे, त तुमन ओकर संग दू मील चले जावव। <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />जऊन ह तुम्हर ले मांगथे, ओला देवव, अऊ जऊन ह तुम्हर ले उधार मांगथे, ओला उधार देवव।<verse eid="MAT 5:42" /></para>
  <para style="s1">बईरीमन बर मया</para>
  <para style="r">(<ref loc="LUK 6:27-28">लूका 6:27‑28</ref>, <ref loc="LUK 6:32-36">32‑36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“तुमन सुने हवव कि ये कहे गे रिहिस, ‘अपन परोसी ले मया अऊ बईरीमन ले नफरत करव।’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />पर मेंह तुमन ला कहत हंव कि अपन बईरीमन ले मया करव, अऊ जऊन मन तुम्हर ऊपर अतियाचार करथें, ओमन बर पराथना करव।<note caller="+" style="f"><char style="fr" closed="false">5:44 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 23:4-5">निर 23:4‑5</ref></char></char></note> <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />ताकि तुमन अपन स्वरगीय ददा के संतान हो जावव। ओह खराप अऊ बने दूनों मनखेमन ऊपर अपन सूरज चमकाथे, अऊ धरमी अऊ अधरमी दूनों के ऊपर पानी बरसाथे। <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />यदि तुमन ओमन ले मया करथव, जऊन मन तुम्हर ले मया करथें, त तुमन ला का ईनाम मिलही? का लगान लेवइया पापीमन घलो अइसने ही नइं करंय? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />यदि तुमन सिरिप अपन भाईमन ला ही जोहार करथव, त आने मन ले तुमन का बड़े बुता करथव? का आनजातमन घलो अइसने नइं करंय? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />एकरसेति, तुमन सिद्ध बनव, जइसने स्वरग म रहइया तुम्हर ददा ह सिद्ध अय।<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">जरूरतमंद ला दान</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“सचेत रहव! तुमन मनखेमन के आघू म ओमन ला देखाय बर अपन धरमीपन के काम झन करव। नइं तो तुमन ला अपन स्वरगीय ददा ले कुछू ईनाम नइं मिलय।<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />“एकरसेति, जब तुमन जरूरतमंद मनखे ला देथव, त डुगडुगी झन पीटवाव, जइसने कि ढोंगी मनखेमन यहूदीमन के सभा-घर अऊ गलीमन म करथें, ताकि मनखेमन ओमन के बड़ई करंय। मेंह तुमन ला सच कहत हंव कि ओमन अपन जम्मो ईनाम पा गीन। <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />पर जब तुमन जरूरतमंद मनखे ला देथव, त तुम्हर डेरी हांथ ये बात ला झन जानय कि तुम्हर जेवनी हांथ का करत हवय। <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />तुम्हर दान ह गुपत म रहय। तब तुम्हर स्वरगीय ददा, जऊन ह गुपत म करे गय काम ला घलो देखथे, तुमन ला ईनाम दीही।<verse eid="MAT 6:4" /></para>
  <para style="s1">पराथना</para>
  <para style="r">(<ref loc="LUK 11:2-4">लूका 11:2‑4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“जब तुमन पराथना करथव, त ढोंगी मनखेमन सहीं झन करव, काबरकि मनखेमन ला देखाय बर, यहूदीमन के सभा-घर अऊ गली के चऊकमन म ठाढ़ होके पराथना करई, ओमन ला बने लगथे। मेंह तुमन ला सच कहत हंव कि ओमन अपन जम्मो ईनाम पा गीन। <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />जब तुमन पराथना करथव, त अपन खोली म जावव, अऊ कपाट ला बंद करके, अपन ददा ले पराथना करव, जऊन ह नइं दिखय। तब तुम्हर ददा, जऊन ह गुपत म करे गय काम ला घलो देखथे, तुमन ला ईनाम दीही। <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />अऊ जब तुमन पराथना करथव, त आनजातमन सहीं बेमतलब के बातमन ला घेरी-बेरी झन दुहराव, काबरकि ओमन ये सोचथें कि ओमन के बहुंत बात बोले के कारन, परमेसर ह ओमन के सुनही। <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />ओमन सहीं झन बनव, काबरकि तुम्हर मांगे के पहिली, तुम्हर ददा ह जानथे कि तुमन ला का चीज के जरूरत हवय।<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />“तुमन ला ये किसम ले पराथना करना चाही:</para>
  <para style="q1" vid="MAT 6:9">“ ‘हे हमर ददा, तें जो स्वरग म हवस,</para>
  <para style="q1" vid="MAT 6:9">तोर नांव ह पबितर माने जावय,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />तोर राज आवय,</para>
  <para style="q1" vid="MAT 6:10">जइसने तोर ईछा स्वरग म पूरा होथे,</para>
  <para style="q2" vid="MAT 6:10">वइसने धरती म घलो पूरा होवय।<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />हमन ला हर दिन के सहीं आज के भोजन दे।<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />हमर पापमन ला छेमा कर,</para>
  <para style="q2" vid="MAT 6:12">जइसने हमन ओमन ला छेमा करे हवन,</para>
  <para style="q1" vid="MAT 6:12">जऊन मन हमर बिरोध म पाप करे हवंय।<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />अऊ हमन ला परिछा म झन पड़न दे,</para>
  <para style="q2" vid="MAT 6:13">पर हमन ला बुरई ले बचा,</para>
  <para style="q1" vid="MAT 6:13">काबरकि राज, अऊ पराकरम अऊ महिमा सदाकाल तक तोर अय। आमीन।’<verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />यदि तुमन ओ मनखेमन ला छेमा करथव, जऊन मन तुम्हर बिरोध म पाप करे हवंय, त तुम्हर स्वरगीय ददा घलो तुमन ला छेमा करही। <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />पर यदि तुमन ओ मनखेमन के पाप ला छेमा नइं करव, त तुम्हर ददा घलो तुम्हर पाप ला छेमा नइं करही।<verse eid="MAT 6:15" /></para>
  <para style="s1">उपास</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“जब तुमन उपास करथव, त तुमन अपन चेहरा ला उदास झन बनावव, जइसने कि ढोंगीमन करथें; ओमन अपन चेहरा ला ओरमाय रहिथें, ताकि मनखेमन देखंय कि ओमन उपास करत हवंय। मेंह तुमन ला सच कहत हंव कि ओमन अपन जम्मो ईनाम पा चुकिन। <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />पर जब तुमन उपास करथव, त अपन मुड़ म तेल चुपरव अऊ मुहूं ला धोवव, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />ताकि मनखेमन ये झन जानंय कि तुमन उपास करत हवव, पर सिरिप तुम्हर ददा परमेसर ह जानय, जऊन ह नइं दिखय। अऊ तुम्हर ददा, जऊन ह हर गुपत के काम ला देखथे, तुमन ला ईनाम दीही।<verse eid="MAT 6:18" /></para>
  <para style="s1">स्वरग म धन</para>
  <para style="r">(<ref loc="LUK 12:33-34">लूका 12:33‑34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“अपन खातिर ये धरती म धन जमा झन करव, जिहां कीरा अऊ मुर्चा येला नास करथें, अऊ चोरमन सेंध मारके चोरा लेथें। <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />पर अपन खातिर स्वरग म धन जमा करव, जिहां कीरा अऊ मुर्चा येला नास नइं कर सकंय, अऊ न ही चोरमन सेंध मारके चोरी कर सकंय। <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />काबरकि जिहां तुम्हर धन हवय, उहां तुम्हर मन घलो लगे रहिही।<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“आंखी ह देहें के दीया अय। यदि तुम्हर आंखीमन ठीक हवंय, त तुम्हर जम्मो देहें ह अंजोर ले भर जाही। <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />पर यदि तुम्हर आंखीमन खराप हवंय, त तुम्हर जम्मो देहें ह अंधियार ले भर जाही। एकरसेति, ओ अंजोर जऊन ह तुमन म हवय, यदि अंधियार हो जाथे, त ओह कतेक भयंकर अंधियार होही।<note caller="+" style="f"><char style="fr" closed="false">6:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="LUK 11:34-36">लूका 11:34‑36</ref>; <ref loc="JHN 9:39-41">यूह 9:39‑41</ref>; <ref loc="MAT 15:14">मत्ती 15:14</ref></char></char></note><verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“कोनो भी मनखे दू झन मालिक के सेवा नइं कर सकय। या तो ओह एक झन ले नफरत करही अऊ दूसर झन ले मया; या फेर ओह एक झन बर समरपित रहिही अऊ दूसर झन ला तुछ जानही। तुमन परमेसर अऊ धन दूनों के सेवा नइं कर सकव।<verse eid="MAT 6:24" /></para>
  <para style="s1">चिंता झन करव</para>
  <para style="r">(<ref loc="LUK 12:22-34">लूका 12:22‑34</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“एकरसेति, मेंह तुमन ला कहत हंव कि तुमन अपन जिनगी के बारे म चिंता झन करव कि तुमन का खाहू या का पीहू, अऊ न अपन देहें के बारे म चिंता करव कि तुमन का पहिरहू। का जिनगी ह भोजन ले जादा महत्व के नो हय? अऊ देहें ह ओनहा ले बढ़के नो हय? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />अकास के चिरईमन ला देखव; ओमन न कुछू बोवंय, न लुवंय अऊ न कोठार म जमा करंय; तभो ले तुम्हर स्वरगीय ददा ह ओमन ला खवाथे। का तुमन चिरईमन ले जादा महत्व के नो हव? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />तुमन म ले कोन ह चिंता करे के दुवारा अपन जिनगी के एको घरी ला घलो बढ़ा सकथे?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />“तुमन ओनहा बर काबर चिंता करथव? खेत के जंगली फूलमन ला देखव कि ओमन कइसने बाढ़थें। ओमन न तो मेहनत करंय अऊ न ही ओनहा बिनंय। <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />तभो ले मेंह तुमन ला बतावत हंव कि राजा सुलेमान घलो अपन जम्मो सोभा म येमन ले एको झन सहीं नइं सजे-धजे रिहिस। <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />यदि परमेसर ह भुइयां के कांदी ला, जऊन ह आज इहां हवय अऊ कल आगी म झोंक दिये जाही, अइसने ओनहा पहिराथे, त हे अल्‍प बिसवासीमन ओह तुमन ला अऊ बने ओनहा काबर नइं पहिराही? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />एकरसेति तुमन चिंता झन करव अऊ ये झन कहव कि हमन का खाबो? या का पीबो? या का पहिरबो? <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />आनजातमन ये जम्मो चीज के खोज म रहिथें। तुम्हर स्वरगीय ददा ह जानथे कि तुमन ला ये जम्मो चीजमन के जरूरत हवय। <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />पहिली परमेसर के राज अऊ ओकर धरमीपन के खोज करव, त ये जम्मो चीजमन घलो संग म तुमन ला दिये जाही। <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />एकरसेति, कल के चिंता झन करव, काबरकि कल के दिन ह अपन चिंता खुद कर लीही। आज के दुख ह आज खातिर बहुंते हवय।<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">आने ऊपर दोस लगई</para>
  <para style="r">(<ref loc="LUK 6:37-38">लूका 6:37‑38</ref>, <ref loc="LUK 6:41-42">41‑42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“आने मन के गलती झन निकालव, ताकि तुम्हर घलो गलती झन निकाले जावय। <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />काबरकि जऊन किसम ले तुमन आने ऊपर दोस लगाथव, ओही किसम ले तुम्हर ऊपर घलो दोस लगाय जाही, अऊ जऊन नाप ले तुमन नापथव, ओही नाप ले तुम्हर बर नापे जाही।<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />“तुमन काबर अपन भाई के आंखी के छोटे कचरा ला देखथव, जबकि अपन खुद के आंखी के बड़े कचरा ला धियान नइं देवव? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />जब तुम्हर खुद के आंखी म लकरी के लट्ठा हवय, त तुमन अपन भाई ला कइसने कह सकथव, ‘लान मेंह तोर आंखी के छोटे कचरा ला निकाल दंव?’ <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />हे ढोंगीमन हो, पहिली अपन खुद के आंखी के लट्ठा ला निकालव, तभे तुमन अपन भाई के आंखी के छोटे कचरा ला साफ-साफ देखहू अऊ ओला निकाल सकहू।<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />“पबितर चीज कुकुरमन ला झन देवव, अऊ अपन मोती ला सुरामन के आघू म झन डालव, नइं तो ओमन ओला अपन गोड़ तरी कुचरहीं अऊ तब लहुंटके तुम्हर ऊपर चढ़ बईठहीं।<verse eid="MAT 7:6" /></para>
  <para style="s1">मांगव, खोजव, खटखटावव</para>
  <para style="r">(<ref loc="LUK 11:9-13">लूका 11:9‑13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“मांगव, त तुमन ला दिये जाही; खोजव, त तुमन पाहू; खटखटावव, त तुम्हर बर कपाट ह खोले जाही। <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />काबरकि जऊन ह मांगथे, ओला मिलथे; जऊन ह खोजथे, ओह पाथे; अऊ जऊन ह खटखटाथे, ओकर खातिर कपाट ला खोले जाथे।<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />“तुमन म अइसने कोन मनखे अय कि यदि ओकर बेटा ह ओकर ले रोटी मांगथे, त ओह ओला पथरा देथे? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />या यदि ओह एक ठन मछरी मांगथे, त ओला सांप देथे? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />जब तुम्हर सहीं खराप मनखेमन अपन लइकामन ला बने चीज के भेंट देय बर जानथव, त स्वरग म रहइया तुम्हर ददा ह ओमन ला अऊ जादा बने चीज काबर नइं दीही, जऊन मन ओकर ले मांगथें। <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />आने मन संग वइसने बरताव करव, जइसने तुमन चाहथव कि ओमन तुम्हर संग करंय, काबरकि मूसा के कानून अऊ अगमजानीमन के एहीच सिकछा अय।<verse eid="MAT 7:12" /></para>
  <para style="s1">संकरा दुवार अऊ चाकर दुवार</para>
  <para style="r">(<ref loc="LUK 13:24">लूका 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“संकरा कपाट ले घुसरव। काबरकि चाकर हवय ओ कपाट अऊ सरल हवय ओ रसता, जऊन ह बिनास कोति ले जाथे अऊ बहुंते झन ओमा ले होके जाथें। <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />पर छोटे हवय ओ कपाट अऊ कठिन हवय ओ रसता, जऊन ह जिनगी कोति ले जाथे, अऊ सिरिप थोरकन झन येला पाथें।<verse eid="MAT 7:14" /></para>
  <para style="s1">सच्चा अऊ लबरा अगमजानी</para>
  <para style="r">(<ref loc="LUK 6:43-44">लूका 6:43‑44</ref>, <ref loc="LUK 6:46">46</ref>; <ref loc="LUK 13:25-27">13:25‑27</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“लबरा अगमजानीमन ले सचेत रहव। ओमन भेड़ के भेस म तुम्हर करा आथें, पर भीतर ले ओमन भयंकर भेड़िया अंय। <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />ओमन के काम के दुवारा ओमन ला तुमन चिन डारहू। का मनखेमन कंटिली झाड़ी ले अंगूर या ऊंटकटारा झाड़ी ले अंजीर के फर टोरथें? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />ओही किसम ले बने रूख ह बने फर देथे, अऊ खराप रूख ह खराप फर देथे। <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />बने रूख ह खराप फर नइं दे सकय अऊ न ही खराप रूख बने फर दे सकथे। <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />हर ओ रूख जऊन ह बने फर नइं देवय, काटे अऊ आगी म झोंके जाथे। <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />ये किसम ले, ओमन के फर के दुवारा, तुमन ओमन ला चिन डारहू।<verse eid="MAT 7:20" /></para>
  <para style="s1">सच्चा अऊ लबरा चेला</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“जऊन मन मोला, ‘हे परभू! हे परभू!’ कहिथें, ओमन म ले जम्मो झन स्वरग के राज म नइं जा सकंय, पर जऊन ह स्वरग म रहइया मोर ददा के ईछा ला पूरा करथे, सिरिप ओहीच ह स्वरग के राज म जाही। <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />नियाय के दिन म कतको मनखेमन मोला कहिहीं, ‘हे परभू! हे परभू! का हमन तोर नांव म अगमबानी नइं करेंन? का हमन तोर नांव म परेत आतमामन ला नइं निकालेंन? अऊ तोर नांव म कतको अचरज के काम नइं करेंन?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />तब मेंह ओमन ला साफ-साफ बता दूहूं, ‘मेंह तुमन ला कभू नइं जानेंव। हे कुकरमीमन हो, मोर ले दूरिहा हटव।’<verse eid="MAT 7:23" /></para>
  <para style="s1">घर बनइया दू झन मनखे: बुद्धिमान अऊ मुरूख</para>
  <para style="r">(<ref loc="LUK 6:47-49">लूका 6:47‑49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“एकरसेति, जऊन ह मोर ये गोठमन ला सुनथे अऊ ओकर पालन करथे, ओह ओ बुद्धिमान मनखे सहीं अय, जऊन ह चट्टान ऊपर अपन घर बनाईस। <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />पानी बरसिस, नदीमन म पूरा आईस, गरेर चलिस, अऊ ओ घर ले टकराईस, तभो ले ओ घर ह नइं गिरिस, काबरकि ओकर नीव ह चट्टान ऊपर डारे गे रिहिस। <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />पर जऊन ह मोर ये गोठमन ला सुनथे अऊ ओकर पालन नइं करय, ओह ओ मुरूख मनखे सहीं अय, जऊन ह बालू ऊपर अपन घर बनाईस। <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />पानी बरसिस, नदीमन म पूरा आईस, गरेर चलिस अऊ ओ घर ले टकराईस अऊ ओ घर ह भरभरा के गिर गीस।”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />जब यीसू ह ये बातमन ला कह चुकिस, त मनखेमन के भीड़ ह ओकर उपदेस ला सुनके चकित हो गीस। <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />काबरकि यीसू ह ओमन के कानून के गुरूमन सहीं नइं, पर अधिकार के संग ओमन ला उपदेस देवत रिहिस।<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">यीसू ह कोढ़ी मनखे ला चंगा करथे</para>
  <para style="r">(<ref loc="MRK 1:40-45">मरकुस 1:40‑45</ref>; <ref loc="LUK 5:12-16">लूका 5:12‑16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />जब यीसू ह पहाड़ ले उतरिस, त एक बड़े भीड़ ओकर पाछू हो लीस। <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />तब एक झन मनखे जऊन ला कोढ़ के बेमारी रहय, ओकर करा आईस, अऊ ओह यीसू ला दंडवत करके कहिस, “हे परभू, यदि तेंह चाहस, त मोला सुध कर सकथस।”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />यीसू ह अपन हांथ ला ओ मनखे अंग बढ़ाईस अऊ ओला छूके कहिस, “मेंह चाहत हंव; तेंह सुध हो जा!” अऊ तुरते ओ मनखे ह कोढ़ के बेमारी ले सुध हो गीस। <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />तब यीसू ह ओला कहिस, “देख, तें कोनो ला कुछू झन कहिबे। पर जा अऊ अपनआप ला पुरोहित ला देखा, अऊ जइसने मूसा ह हुकूम दे हवय, वइसने भेंट चघा, ताकि मनखेमन म सबूत होवय कि तेंह बेमारी ले ठीक हो गे हवस।<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="MRK 1:45">मर 1:45</ref></char></char></note>”<verse eid="MAT 8:4" /></para>
  <para style="s1">रोमी सेना के अधिकारी के बिसवास</para>
  <para style="r">(<ref loc="LUK 7:1-10">लूका 7:1‑10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />जब यीसू ह कफरनहूम सहर म आईस, त एक झन रोमी सेना के अधिकारी ओकर करा आईस अऊ ओकर ले बिनती करके कहिस, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“हे परभू, मोर सेवक ह घर म पड़े हवय; ओला लकवा मार दे हवय, अऊ ओह अब्बड़ दुख भोगत हवय।”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />यीसू ह ओला कहिस, “मेंह जाहूं अऊ ओला चंगा करहूं।”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />तब रोमी सेना के अधिकारी ह ये जबाब दीस, “हे परभू, मेंह एकर लईक नो हंव कि तेंह मोर घर म आ। पर सिरिप अपन मुहूं ले कहि दे, त मोर सेवक ह ठीक हो जाही। <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />काबरकि मेंह खुद हाकिम के अधीन म हवंव अऊ सैनिकमन मोर अधीन म हवंय। मेंह एक झन ला कहिथंव, ‘जा’, त ओह जाथे अऊ दूसर ला कहिथंव, ‘आ’, त ओह आथे। मेंह अपन सेवक ला कहिथंव, येला कर, त ओला करथे।”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />येला सुनके यीसू ह चकित हो गीस, अऊ जऊन मन ओकर पाछू-पाछू आवत रिहिन, ओमन ला ओह कहिस, “मेंह तुमन ला सच कहत हंव कि मेंह इसरायली मनखेमन म घलो अइसने बड़े बिसवास नइं देखेंव। <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />मेंह तुमन ला कहत हंव कि कतको मनखेमन पूरब अऊ पछिम दिग ले आहीं अऊ अब्राहम, इसहाक अऊ याकूब के संग स्वरग के राज के भोज म सामिल होहीं। <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />पर जऊन मन ला स्वरग राज म होना चाही, ओमन ला बाहिर अंधियार म डार दिये जाही, जिहां ओमन रोहीं अऊ अपन दांत पीसहीं।”<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />तब यीसू ह रोमी सेना के अधिकारी ले कहिस, “जा, जइसने तेंह बिसवास करे हवस वइसने तोर बर होही।” अऊ ओकर सेवक ह ओहीच घरी चंगा हो गीस।<verse eid="MAT 8:13" /></para>
  <para style="s1">यीसू ह बहुंते झन ला चंगा करथे</para>
  <para style="r">(<ref loc="MRK 1:29-34">मरकुस 1:29‑34</ref>; <ref loc="LUK 4:38-41">लूका 4:38‑41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />जब यीसू ह पतरस के घर म आईस, त ओह देखिस कि पतरस के सास ह जर के मारे खटिया म पड़े रहय। <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />यीसू ह ओकर हांथ ला छुईस अऊ ओकर जर ह उतर गीस, अऊ ओह उठके यीसू के सेवा-टहल करे लगिस।<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />जब सांझ होईस, त मनखेमन परेत आतमा ले जकड़े बहुंते मनखेमन ला यीसू करा लानिन। यीसू ह सिरिप गोठ के दुवारा ओ परेत आतमामन ला निकाल दीस अऊ जम्मो बिमरहामन ला चंगा करिस। <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />ये किसम ले, यसायाह अगमजानी के दुवारा कहे गय ये बचन ह पूरा होईस:</para>
  <para style="q1" vid="MAT 8:17">“ओह हमर कमजोरी ला ले लीस,</para>
  <para style="q2" vid="MAT 8:17">अऊ हमर रोगमन ला दूर करिस।”<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:4">यसा 53:4</ref></char></char></note><verse eid="MAT 8:17" /></para>
  <para style="s1">यीसू के चेला बने के कीमत</para>
  <para style="r">(<ref loc="LUK 9:57-62">लूका 9:57‑62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />जब यीसू ह अपन चारों कोति मनखेमन के भीड़ ला देखिस, त ओह अपन चेलामन ला झील के ओ पार जाय के हुकूम दीस। <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />तब मूसा के कानून के एक गुरू ह यीसू करा आके कहिस, “हे गुरू, तेंह जिहां कहूं घलो जाबे, मेंह तोर पाछू-पाछू चलहूं।”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />यीसू ह ओला कहिस, “कोलिहामन बर रहे के बिल हवय अऊ अकास के चिरईमन के बसेरा हवय, पर मनखे के बेटा के मुड़ ला थेबे बर घलो कोनो जगह नइं ए।”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />एक आने चेला ह ओकर ले कहिस, “हे परभू, पहिली मोला जावन दे कि मेंह अपन मरे ददा ला माटी दे दंव।”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />पर यीसू ह ओला कहिस, “तेंह मोर पाछू हो ले, अऊ मुरदामन ला अपन मुरदा गाड़न दे।”<verse eid="MAT 8:22" /></para>
  <para style="s1">यीसू ह आंधी ला सांत करथे</para>
  <para style="r">(<ref loc="MRK 4:35-41">मरकुस 4:35‑41</ref>; <ref loc="LUK 8:22-25">लूका 8:22‑25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />तब यीसू ह डोंगा म चघिस अऊ ओकर चेलामन घलो ओकर संग गीन। <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />अचानक झील म एक भयंकर गर्रा उठिस अऊ डोंगा ह पानी के लहरामन ले भरे लगिस। पर यीसू ह सोवत रहय। <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />चेलामन यीसू करा गीन अऊ ओला उठाके कहिन, “हे परभू, हमन ला बचा। हमन पानी म बुड़त हवन।”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />यीसू ह ओमन ला कहिस, “हे अल्‍प बिसवासी मनखेमन हो, तुमन काबर डरावत हवव?” तब ओह उठिस अऊ आंधी अऊ पानी के लहरामन ला दबकारिस अऊ जम्मो ह एकदम सांत हो गीस।<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />ओ मनखेमन अचम्भो म पड़ गीन अऊ कहिन, “येह का किसम के मनखे अय? अऊ त अऊ आंधी अऊ पानी के लहरामन घलो एकर हुकूम मानथें।”<verse eid="MAT 8:27" /></para>
  <para style="s1">परेत आतमा बाधित दू झन मनखे के चंगई</para>
  <para style="r">(<ref loc="MRK 5:1-20">मरकुस 5:1‑20</ref>; <ref loc="LUK 8:26-39">लूका 8:26‑39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />जब यीसू ह झील के ओ पार गदरेनीमन के इलाका<note caller="+" style="f"><char style="fr" closed="false">8:28 </char><char style="fqa" closed="false">गदरेनी </char><char style="ft" closed="false">ह आनजातमन के इलाका रिहिस।</char></note> म आईस, त दू झन मनखे, जेमन म परेत आतमा रहंय, मरघटी ले निकलके ओकर करा आईन। ओमन अतेक उदंड रिहिन कि कोनो ओ रसता म आय-जाय नइं सकत रिहिन। <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />ओमन चिचियाके कहिन, “हे परमेसर के बेटा, हमर ले तोला का काम? का तेंह ठहिराय गय समय ले पहिली हमन ला इहां सताय बर आय हवस?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />उहां ले कुछू दूरिहा म, सुरामन के एक बड़े झुंड ह चरत रहय। <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />ओ परेत आतमामन यीसू ले बिनती करके कहिन, “यदि तेंह हमन ला निकालत हवस, त हमन ला ओ सुरामन के झुंड म पठो दे।”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />यीसू ह ओमन ला कहिस, “जावव।” तब परेत आतमामन ओ मनखेमन ले निकलके सुरामन म हमा गीन अऊ सुरामन के जम्मो झुंड ह तीर म निकले पथरा ले झील म झपटके कूदिस, अऊ बुड़ मरिस। <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />सूरा चरइयामन भाग गीन अऊ सहर म जाके जम्मो बात ला बताईन। ओमन ओ परेत आतमा ले बाधित मनखेमन के बारे म घलो बताईन। <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />तब सहर के जम्मो मनखेमन यीसू करा भेंट करे बर आईन, अऊ जब ओमन ओला देखिन, त ओकर ले बिनती करिन कि ओह ओमन के इलाका ले चले जावय।<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">यीसू ह लकवा के मारे एक झन मनखे ला चंगा करथे</para>
  <para style="r">(<ref loc="MRK 2:1-12">मरकुस 2:1‑12</ref>; <ref loc="LUK 5:17-26">लूका 5:17‑26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />यीसू ह डोंगा म चघिस अऊ झील ला पार करके अपन सहर म आईस<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">इहां </char><char style="fq" closed="false">अपन सहर </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">कफरनहूम </char><char style="ft" closed="false">ए। यीसू ह नासरत ला छोंड़े के बाद कफरनहूम म रिहिस।</char></note>। <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />कुछू मनखेमन लकवा के मारे एक मनखे ला ओकर करा लानिन; ओ मनखे ह खटिया म पड़े रहय। जब यीसू ह ओमन के बिसवास ला देखिस, त ओह लकवा के मारे मनखे ला कहिस, “बेटा, खुसी मना! तोर पाप ह छेमा हो गे।”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />येला सुनके, मूसा के कानून के कुछू गुरूमन अपन मन म कहिन, “ये मनखे ह परमेसर के निन्दा करत हवय!”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />ओमन के मन के बात ला जानके यीसू ह कहिस, “तुमन अपन मन म काबर अइसने खराप बात सोचत हवव? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />कते बात ह सरल ए? ये कहई, ‘तोर पाप ह छेमा हो गीस,’ या फेर ये कहई, ‘उठ, अऊ चल फिर।’ <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />मेंह तुमन ला देखाहूं कि मनखे के बेटा ला धरती म पाप छेमा करे के अधिकार हवय।” तब ओह लकवा के मारे ला कहिस, “उठ, अपन खटिया ला उठा अऊ घर जा।” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />अऊ ओ मनखे ह उठिस अऊ अपन घर चल दीस। <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />जब भीड़ के मनखेमन येला देखिन, त ओमन डरा गीन, अऊ ओमन परमेसर के महिमा करे लगिन, जऊन ह मनखेमन ला अइसने अधिकार दे हवय।<verse eid="MAT 9:8" /></para>
  <para style="s1">यीसू ह मत्ती ला बलाथे</para>
  <para style="r">(<ref loc="MRK 2:13-17">मरकुस 2:13‑17</ref>; <ref loc="LUK 5:27-32">लूका 5:27‑32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />जब यीसू ह उहां ले आघू बढ़िस, त ओह मत्ती नांव के एक झन मनखे ला लगान पटाय के नाका म बईठे देखिस, त ओह ओला कहिस, “मोर पाछू आ।” अऊ मत्ती ह उठके ओकर पाछू हो लीस।<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />जब यीसू ह मत्ती के घर म खाना खाय बर बईठिस, त कतको लगान लेवइया अधिकारी अऊ पापी मनखेमन आईन अऊ ओमन घलो यीसू अऊ ओकर चेलामन संग खाना खाय बर बईठिन। <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />येला देखके फरीसीमन यीसू के चेलामन ले पुछिन, “तुम्हर गुरू ह लगान लेवइया अऊ पापीमन संग काबर खावत हवय?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />येला सुनके, यीसू ह कहिस, “भला-चंगा मनखेमन ला डाक्टर के जरूरत नइं होवय, पर बिमरहामन ला होथे। <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />जावव अऊ सीखव कि परमेसर के ये बचन के का मतलब होथे: ‘मेंह बलिदान नइं, पर दया चाहथंव।’<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">होसे 6:6</ref>; <ref loc="LUK 5:32">लूका 5:32</ref></char></char></note> काबरकि मेंह धरमीमन ला नइं, पर पापीमन ला बलाय बर आय हवंव।”<verse eid="MAT 9:13" /></para>
  <para style="s1">उपास के बारे म सवाल</para>
  <para style="r">(<ref loc="MRK 2:18-22">मरकुस 2:18‑22</ref>; <ref loc="LUK 5:33-39">लूका 5:33‑39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />तब यूहन्ना के चेलामन यीसू करा आईन अऊ पुछिन, “का कारन ए कि हमन अऊ फरीसीमन उपास करथन, पर तोर चेलामन उपास नइं करंय?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />यीसू ह ओमन ला जबाब दीस, “का बरातीमन दुख मनाथें, जब दूल्हा ह ओमन के संग म रहिथे? पर ओ समय आही जब दूल्हा ह ओमन ले अलग करे जाही; तब ओमन उपास करहीं।<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“जुन्ना कपड़ा म नवां कपड़ा के खाप कोनो नइं लगावंय, काबरकि ओ खाप ह जुन्ना कपड़ा ला तीरके अऊ चीर दीही। <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />वइसने ही मनखेमन जुन्ना चमड़ा के थैली म नवां अंगूर के मंद ला नइं भरंय। यदि ओमन अइसने करथें, त ओ चमड़ा के थैली फट जाही, अऊ अंगूर के मंद ह बोहा जाही अऊ ओ थैली ह बरबाद हो जाही। एकरे बर ओमन नवां मंद ला नवां चमड़ा के थैली म भरथें, अऊ ये किसम ले दूनों चीज सही-सलामत रहिथे।”<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 12:6">मत्ती 12:6</ref>, <ref loc="MAT 12:41-42">41‑42</ref></char></char></note><verse eid="MAT 9:17" /></para>
  <para style="s1">मरे छोकरी अऊ बिमरहा माईलोगन</para>
  <para style="r">(<ref loc="MRK 5:21-43">मरकुस 5:21‑43</ref>; <ref loc="LUK 8:40-56">लूका 8:40‑56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />जब यीसू ह ओमन ला ये कहत रिहिस, तभे यहूदीमन के सभा-घर के एक अधिकारी आईस अऊ यीसू के आघू म माड़ी टेकके कहिस, “मोर बेटी ह अभीच मरे हवय। पर तेंह चल अऊ अपन हांथ ला ओकर ऊपर रख, अऊ ओह जी जाही।” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />यीसू ह उठिस अऊ ओकर संग गीस। यीसू के चेलामन घलो ओकर संग गीन।<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />तभे एक झन माईलोगन रहय, जऊन ला बारह बछर ले लहू बोहाय के बेमारी रिहिस, ओह यीसू के पाछू ले आईस अऊ ओकर कपड़ा के छोर ला छू लीस। <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />काबरकि ओह अपन मन म कहत रिहिस, “यदि मेंह ओकर कपड़ा ला ही छू लूहूं, त चंगा हो जाहूं।”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />यीसू ह पाछू कोति मुड़के ओला देखिस अऊ कहिस, “हिम्मत रख, बेटी। तोर बिसवास ह तोला चंगा करे हवय।” अऊ ओहीच घरी ओ माईलोगन ह बने हो गीस।<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />जब यीसू ह ओ अधिकारी के घर के भीतर गीस अऊ बांसुरी बजइयामन ला अऊ मनखेमन ला रोवत-पीटत देखिस,<note caller="+" style="f"><char style="fr" closed="false">9:23 </char><char style="ft" closed="false">ओ समय जब कोनो मर जावय, त माटी देय के बेरा बांसुरी बजावंय।</char></note> <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />त ओह कहिस, “घुंच जावव! ये छोकरी ह मरे नइं ए, पर सुतत हवय।” पर ओमन ओकर हंसी उड़ाय लगिन। <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />जब मनखेमन ला घर के बाहिर कर दिये गीस, त यीसू ह भीतर गीस अऊ छोकरी के हांथ ला धरके उठाईस, अऊ ओ छोकरी ह उठ बईठिस। <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />ये बात के चरचा ओ जम्मो इलाका म फईल गीस।<verse eid="MAT 9:26" /></para>
  <para style="s1">यीसू ह अंधरा अऊ कोंदामन ला चंगा करथे</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />यीसू ह उहां ले आघू बढ़िस, त दू झन अंधरा मनखे ये गोहार पारत ओकर पाछू हो लीन, “हे दाऊद के संतान, हमर ऊपर दया कर।”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />जब यीसू ह घर के भीतर गीस, त ओ अंधरा मनखेमन ओकर करा आईन। यीसू ह ओमन ले पुछिस, “का तुमन ला बिसवास हवय कि मेंह ये काम कर सकत हंव?”</para>
  <para style="p" vid="MAT 9:28">ओमन ओला कहिन, “हव परभू।”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />तब यीसू ह ओमन के आंखी ला छुईस अऊ कहिस, “तुम्हर बिसवास के मुताबिक तुम्हर बर होवय।” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />अऊ ओमन के आंखीमन देखे लगिन। यीसू ह ओमन ला बहुंत चेताके कहिस, “देखव, ये बात ला अऊ कोनो ला झन बतावव।” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />पर बाहिर निकलके, ओमन ओ जम्मो इलाका म यीसू के जस ला फईला दीन।<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />जब ओमन बाहिर निकलत रिहिन, त कुछू मनखेमन भूत धरे एक कोंदा मनखे ला यीसू करा लानिन। <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />अऊ जब यीसू ह भूत ला निकाल दीस, त ओ कोंदा मनखे ह गोठियाय लगिस। मनखेमन अचम्भो करत कहे लगिन, “हमन इसरायल देस म अइसने बात कभू नइं देखे रहेंन।”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />पर फरीसीमन कहिन, “येह परेत आतमामन के सरदार के मदद ले परेत आतमामन ला निकालथे।”<verse eid="MAT 9:34" /></para>
  <para style="s1">बनिहार थोरकन हवंय</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />यीसू ह जम्मो नगर अऊ गांव म ले होवत गीस, अऊ ओह यहूदीमन के सभा-घरमन म उपदेस देवत, परमेसर के राज के सुघर संदेस के परचार करत अऊ जम्मो किसम के रोग अऊ बेमारी ला बने करत गीस। <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />जब यीसू ह मनखेमन के भीड़ ला देखिस, त ओला ओमन के ऊपर तरस आईस, काबरकि ओमन परेसान अऊ बिन सहारा के रिहिन। ओमन बिन चरवाहा के भेड़ सहीं रिहिन।<note caller="+" style="f"><char style="fr" closed="false">9:36 </char><char style="ft" closed="false"><char style="xt"><ref loc="NUM 27:16-17">गन 27:16‑17</ref></char></char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />तब ओह अपन चेलामन ला कहिस, “खेत म फसल तो बहुंते हवय, पर बनिहारमन थोरकन हवंय। <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />एकरसेति, फसल के मालिक ले बिनती करव कि ओह अपन फसल ला लुए बर बनिहार पठोवय।”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">यीसू बारह चेलामन ला पठोथे</para>
  <para style="r">(<ref loc="MRK 3:13-19">मरकुस 3:13‑19</ref>; <ref loc="LUK 6:12-16">लूका 6:12‑16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />यीसू ह अपन बारह चेलामन ला अपन करा बलाईस अऊ ओमन ला असुध आतमामन ला निकाले अऊ हर एक किसम के रोग अऊ बेमारी ला बने करे के अधिकार दीस।<verse eid="MAT 10:1" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="2" style="v" sid="MAT 10:2" />बारह प्रेरितमन के नांव ये अय:</para>
  <para style="b" vid="MAT 10:2" />
  <para style="li1" vid="MAT 10:2">पहिला सिमोन, जऊन ला पतरस कहे जाथे अऊ ओकर भाई अन्द्रियास;</para>
  <para style="li1" vid="MAT 10:2">जबदी के बेटा याकूब अऊ ओकर भाई यूहन्ना;<verse eid="MAT 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 10:3" />फिलिप्पुस अऊ बरतुलमै;</para>
  <para style="li1" vid="MAT 10:3">थोमा अऊ लगान लेवइया मत्ती;</para>
  <para style="li1" vid="MAT 10:3">हलफई के बेटा याकूब, अऊ तद्दै;<verse eid="MAT 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 10:4" />सिमोन कनानी अऊ यहूदा इस्करियोती जऊन ह यीसू के संग बिसवासघात करिस।<verse eid="MAT 10:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />ये बारहों झन ला, यीसू ह ये हुकूम देके पठोईस, “आनजातमन इहां झन जावव अऊ न ही सामरीमन के कोनो सहर म जावव। <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />एकर बदले, इसरायल के घराना के गंवाय भेड़मन करा जावव।<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 15:24">मत्ती 15:24</ref></char></char></note> <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />जब तुमन जावव, त ये संदेस के परचार करव: ‘स्वरग के राज ह लकठा म आ गे हवय।’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />बिमरहामन ला चंगा करव, मरे मनखेमन ला जियावव, कोढ़ी मनखेमन ला सुध करव, परेत आतमामन ला निकालव। मुफत म तुमन ला मिले हवय, एकरसेति मुफत म देवव।<verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />“अपन पटका म सोन या चांदी या तांबा झन रखव। <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />रसता बर झोला या अतकिहा कुरता या पनही या लउठी झन रखव, काबरकि बनिहार ला ओकर जरूरत के चीज दिये जाना चाही।<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 9:37">मत्ती 9:37</ref></char></char></note> <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />जऊन कोनो सहर या गांव म तुमन जावव, त उहां कोनो काबिल मनखे के पता लगावव अऊ उहां ले बिदा होवत तक ओकरे घर म ठहिरव। <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />जऊन घर म तुमन जावव, त ओ घर ला आसीस देवव। <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />यदि ओ घर के मनखेमन काबिल होहीं, त तुम्हर सांति ह उहां ठहिरही, पर यदि ओमन काबिल नो हंय, त तुम्हर सांति ह तुम्हर करा लहुंट आही। <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />यदि कोनो तुमन ला गरहन नइं करय या तुम्हर गोठ ला नइं सुनय, त ओ घर या सहर ले निकलत बेरा अपन गोड़ के धुर्रा ला झर्रा देवव। <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />मेंह तुमन ला सच कहत हंव कि नियाय के दिन म, ये सहर के मनखेमन ले सदोम अऊ अमोरा सहर के मनखेमन के दसा ह जादा सहे के लईक होही।<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“देखव! मेंह तुमन ला भेड़ियामन के बीच म भेड़मन सहीं पठोवत हंव। एकरसेति, सांप के सहीं चतुरा अऊ पंड़की के सहीं निरदोस बनव। <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />मनखेमन ले सचेत रहव। ओमन तुमन ला धरम-सभा ला सऊंप दीहीं अऊ यहूदीमन के सभा-घर म तुमन ला कोर्रा म मारहीं। <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />मोर कारन, तुमन ला हाकिम अऊ राजामन के आघू म लाने जाही कि तुमन मोर बिसय म ओमन ला अऊ आनजातमन ला गवाही देवव। <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />जब ओमन तुमन ला पकड़थें, त एकर चिंता झन करव कि तुमन ला का कहना हे या कइसने कहना हे, काबरकि ओहीच बखत तुमन ला बताय जाही कि का कहना हे। <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />काबरकि बोलइया तुमन नइं, पर तुम्हर ददा परमेसर के आतमा ह तुमन म होके बोलही।<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />“भाई ह अपन भाई ला अऊ ददा ह अपन लइका ला मार डारे बर सऊंप दीही। लइकामन अपन दाई-ददा के बिरोध म खड़े होहीं अऊ ओमन ला मरवा डारहीं। <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />मोर कारन, जम्मो मनखेमन तुम्हर ले नफरत करहीं, पर जऊन ह आखिरी तक अडिग बने रहिही, ओकरेच उद्धार होही। <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />जब ओमन तुमन ला एक सहर म सताथें, त तुमन आने सहर म भाग जावव। मेंह तुमन ला सच कहत हंव कि मनखे के बेटा के आय के पहिली, तुमन इसरायल के जम्मो सहर म नइं जा सके होहू।<note caller="+" style="f"><char style="fr" closed="false">10:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="DAN 7:13">दानि 7:13</ref></char></char></note><verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“चेला ह अपन गुरू ले बड़े नइं होवय अऊ न ही सेवक ह अपन मालिक ले बड़े होथे। <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />चेला ह अपन गुरू सहीं अऊ सेवक ह अपन मालिक सहीं बन जाना ही बहुंत अय। जब ओमन घर के मुखिया ला बालजबूल<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">याने कि सैतान</char></note> कहिन, त फेर ओमन ओकर घर के सदस्यमन ला का कुछू नइं कहिहीं।<verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“एकरसेति, ओमन ले झन डरव। काबरकि कुछू घलो बात ढंके नइं ए, जऊन ला उघारे नइं जाही या कुछू भी बात छिपे नइं ए, जऊन ला बताय नइं जाही। <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />जऊन बात मेंह तुमन ला अंधियार म कहत हंव, ओला तुमन अंजोर म कहव। जऊन बात, तुमन ला कान म फुसफुसाके कहे जाथे, ओला तुमन घर के छानी ऊपर ले चिचिया-चिचियाके बतावव। <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />ओमन ले झन डरव, जऊन मन सरीर ला मार डारथें, पर आतमा ला नइं मार सकंय। पर ओकर ले डरव, जऊन ह आतमा अऊ सरीर दूनों ला नरक म नास कर सकथे। <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />एक पईसा म दू ठन गौरइया चिरई बिकथे, तभो ले तुम्हर ददा परमेसर के बिगर ईछा के ओमा ले एको ठन घलो धरती ऊपर नइं गिरय। <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />अऊ त अऊ तुम्हर मुड़ के जम्मो चुंदीमन गने गे हवंय। <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />झन डरव; तुमन गौरइया चिरईमन ले जादा कीमत के अव।<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“जऊन कोनो मोला मनखेमन के आघू म स्वीकार करथे, ओला मेंह घलो स्वरग म अपन ददा के आघू म स्वीकार करहूं। <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />पर जऊन कोनो मोला मनखेमन के आघू म इनकार करथे, त ओला मेंह घलो स्वरग म अपन ददा के आघू म इनकार करहूं।<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“ये झन सोचव कि मेंह धरती म सांति इस्‍थापना करे बर आय हवंव। मेंह सांति इस्‍थापना करे बर नइं, पर तलवार चलवाय बर आय हवंव।<verse eid="MAT 10:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="MAT 10:35" />“मेंह बेटा ला ओकर ददा के बिरूध,</para>
  <para style="q2" vid="MAT 10:35">बेटी ला ओकर दाई के बिरूध</para>
  <para style="q1" vid="MAT 10:35">अऊ बहू ला ओकर सास के बिरूध करे बर आय हवंव।<verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />मनखे के बईरी ओकर खुद के परिवार के मनखेमन होहीं।<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“जऊन ह अपन ददा या दाई ला मोर ले जादा मया करथे, ओह मोर लईक नो हय। जऊन ह अपन बेटा या बेटी ला मोर ले जादा मया करथे, ओह मोर लईक नो हय; <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />अऊ जऊन ह अपन कुरूस ला उठाके मोर पाछू नइं आवय, ओह मोर लईक नो हय। <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />जऊन ह अपन परान ला बचाथे, ओह ओला गंवाही, अऊ जऊन ह मोर कारन अपन परान ला गंवाथे, ओह ओला बचाही।<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“जऊन ह तुमन ला गरहन करथे, ओह मोला गरहन करथे, अऊ जऊन ह मोला गरहन करथे, ओह ओला गरहन करथे जऊन ह मोला पठोय हवय। <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />जऊन ह एक अगमजानी ला अगमजानी जानके गरहन करथे, त ओह एक अगमजानी के ईनाम पाही, अऊ जऊन ह धरमी मनखे ला धरमी मनखे जानके गरहन करथे, ओह एक धरमी मनखे के ईनाम पाही। <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />अऊ जऊन ह ये छोटे मन म ले कोनो ला मोर चेला जानके एक गिलास ठंडा पानी पीये बर देथे, त मेंह तुमन ला सच कहत हंव कि ओह एकर ईनाम जरूर पाही।”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">यीसू अऊ यूहन्ना बतिसमा देवइया</para>
  <para style="r">(<ref loc="LUK 7:18-35">लूका 7:18‑35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />अपन बारह चेलामन ला ये हुकूम देय के बाद, यीसू ह उहां ले चल दीस। ओह गलील प्रदेस के सहरमन म सिकछा दे बर अऊ परचार करे बर गीस।<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />जब यूहन्ना ह जेल म मसीह के काम के चरचा ला सुनिस, त ओह अपन चेलामन ला ओकर करा ये पुछे बर पठोईस, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“का तेंह ओही अस, जऊन ह अवइया रिहिस या फेर हमन कोनो आने के बाट जोहन।”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />यीसू ह ओमन ला ये जबाब दीस, “तुमन जावव, अऊ जऊन कुछू तुमन सुनत अऊ देखत हवव, ओला यूहन्ना ला बतावव— <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />अंधरामन देखथें, खोरवामन रेंगथें, कोढ़ीमन सुध करे जावथें, भैंरा मनखेमन सुनथें, मुरदामन जी उठथें, अऊ गरीबमन ला सुघर संदेस के परचार करे जाथे।<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 61:1">यसा 61:1</ref>; <ref loc="LUK 4:18-19">लूका 4:18‑19</ref></char></char></note> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />धइन ए ओह जऊन ह मोर ऊपर संदेह नइं करय।”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />जब यूहन्ना के चेलामन जावत रिहिन, त यीसू ह मनखेमन ला यूहन्ना के बारे म कहन लगिस, “जब तुमन सुनसान जगह म यूहन्ना करा गेव, त तुमन का देखे के आसा करत रहेव? का हवा म डोलत बड़े घांस के पऊधा ला? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />यदि नइं! त फेर तुमन का देखे बर गे रहेव? का सुघर कपड़ा पहिरे एक मनखे ला देखे बर? जऊन मन सुघर कपड़ा पहिरथें, ओमन राजा के महल म रहिथें। <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />त तुमन का देखे बर गे रहेव? एक अगमजानी ला देखे बर? हव, मेंह तुमन ला कहथंव कि तुमन एक अगमजानी ले घलो बड़े मनखे ला देखेव। <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />येह ओ मनखे अय, जेकर बारे म परमेसर के बचन म लिखे हवय:</para>
  <para style="q1" vid="MAT 11:10">“ ‘मेंह अपन संदेसिया ला तोर आघू पठोवत हंव,</para>
  <para style="q2" vid="MAT 11:10">जऊन ह तोर आघू तोर रसता तियार करही।’<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAL 3:1">मला 3:1</ref></char></char></note><verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />मेंह तुमन ला सच कहत हंव कि अभी तक जऊन मनखेमन संसार म माईलोगन ले जनमे हवंय, ओमन म कोनो घलो यूहन्ना बतिसमा देवइया ले बड़े नो हय। पर जऊन ह स्वरग के राज म सबले छोटे अय, ओह यूहन्ना ले घलो बड़े अय। <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />यूहन्ना बतिसमा देवइया के समय ले अभी तक स्वरग के राज ऊपर सतावा होय हवय अऊ सतानेवालामन ताकत के दुवारा येला अपन अधिकार म कर लेथें। <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />काबरकि जम्मो अगमजानी अऊ मूसा के कानून, यूहन्ना के समय तक अगमबानी करत रिहिन। <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />अऊ यदि तुमन ये बात ला मानत हव, त जान लेवव कि ओह एलियाह अय, जऊन ह अवइया रिहिस। <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />जेकर कान हवय, ओह सुन ले।<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“मेंह ये पीढ़ी के मनखेमन के तुलना काकर ले करंव? ओमन बजार म बईठे लइकामन सहीं अंय, जऊन मन अपन दूसर संगीमन ला पुकारके कहिथंय:<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />“ ‘हमन तुम्हर बर बांसुरी बजाएंन,</para>
  <para style="q2" vid="MAT 11:17">पर तुमन नइं नाचेव;</para>
  <para style="q1" vid="MAT 11:17">हमन बिलाप करेंन,</para>
  <para style="q2" vid="MAT 11:17">अऊ तुमन ला दुख नइं होईस।’<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />काबरकि यूहन्ना आईस, पर ओह सधारन मनखे सहीं, न तो खाईस अऊ न ही पीईस, अऊ मनखेमन कहिथें, ‘ओमा परेत आतमा हवय।’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />मनखे के बेटा ह आईस, जऊन ह खाथे अऊ पीथे, अऊ मनखेमन कहिथें, ‘देखव, ओह पेटहा अऊ पियक्कड़ अय, अऊ लगान लेवइया अऊ पापीमन के संगवारी अय।’ पर बुद्धि ह अपन काम के दुवारा सही ठहिरथे।”<verse eid="MAT 11:19" /></para>
  <para style="s1">पछताप नइं करइया सहरमन ला धिक्कार</para>
  <para style="r">(<ref loc="LUK 10:13-15">लूका 10:13‑15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />तब यीसू ह ओ सहरमन ला धिक्कारे लगिस, जिहां ओह सबले जादा चमतकार करे रिहिस, पर ओ सहरमन पछताप नइं करिन। <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />यीसू ह कहिस, “धिक्कार ए तोला, खुराजीन! धिक्कार ए तोला, बैतसैदा। जऊन चमतकार के काम तुमन म करे गीस, यदि ओ काम सूर अऊ सीदोन सहर म करे गे होतिस, त ओमन बहुंत पहिली टाट के कपड़ा ओढ़के अऊ राख म बईठके पछताप कर चुके होतिन। <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />पर मेंह तुमन ला कहत हंव कि नियाय के दिन म सूर अऊ सीदोन के दसा ह तुम्हर दसा ले कहूं जादा सहे के लईक होही। <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />अऊ तें कफरनहूम! का तेंह अकास तक ऊंचा उठाय जाबे! नइं! तेंह खाल्हे पाताल-लोक ला चले जाबे। काबरकि जऊन चमतकार के काम तोर म करे गीस, यदि ओ काम सदोम सहर म करे गे होतिस, त ओ सहर ह आज तक ले बने रहितिस। <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />पर मेंह तोला कहत हंव कि नियाय के दिन म सदोम सहर के दसा ह तोर दसा ले कहूं जादा सहे के लईक होही।”<verse eid="MAT 11:24" /></para>
  <para style="s1">थके-हारे मनखेमन बर बिसराम</para>
  <para style="r">(<ref loc="LUK 10:21-22">लूका 10:21‑22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />ओही बेरा यीसू ह कहिस, “हे ददा! स्वरग अऊ धरती के परभू! मेंह तोर धनबाद करत हंव, काबरकि तेंह ये बातमन ला बुद्धिमान अऊ गियानी मनखेमन ले छुपाय रखय, पर येला छोटे लइकामन ऊपर परगट करय। <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />हव, ददा, ये काम करे म तोला खुसी होईस।<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“मोर ददा ह मोला जम्मो चीज ला सऊंप दे हवय। ददा के छोंड़ अऊ कोनो, बेटा ला नइं जानंय, अऊ ददा ला कोनो नइं जानंय, सिरिप बेटा ह जानथे अऊ ओमन घलो जानथें, जऊन मन ला बेटा ह चुनथे कि ओमन ऊपर ददा ला उजागर करे।<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“हे जम्मो थके-मांदे अऊ बोझ ले दबे मनखेमन, मोर करा आवव, मेंह तुमन ला बिसराम दूहूं। <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />मोर जुआड़ी ला अपन ऊपर रखव अऊ मोर ले सीखव, काबरकि मेंह हिरदय म दयालु अऊ नम्र अंव, अऊ तुमन अपन आतमा म बिसराम पाहू। <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />काबरकि मोर जुआड़ी ह सरल अऊ मोर बोझा ह हरू हवय।”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">बिसराम दिन के परभू</para>
  <para style="r">(<ref loc="MRK 2:23-28">मरकुस 2:23‑28</ref>; <ref loc="LUK 6:1-5">लूका 6:1‑5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />ओ समय यीसू ह बिसराम के दिन अनाज के खेत म ले होके जावत रिहिस। ओकर चेलामन ला भूख लगिस, त ओमन अनाज के कुछू दाना ला टोर-टोरके खावन लगिन। <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />येला देखके फरीसीमन यीसू ले कहिन, “देख! तोर चेलामन ओ काम करत हवंय, जेला बिसराम के दिन करई कानून के बिरूध अय।”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />यीसू ह कहिस, “का तुमन परमेसर के बचन म नइं पढ़ेव कि दाऊद ह का करिस, जब ओला अऊ ओकर संगीमन ला भूख लगिस? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />ओह परमेसर के घर म गीस, अऊ ओह अऊ ओकर संगवारीमन परमेसर ला भेंट चघाय रोटी ला खाईन, जऊन ला खवई, ओमन बर कानून के बिरूध रिहिस। ओ रोटी ला सिरिप पुरोहितमन खा सकत रिहिन।<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 24:9">लैव्य 24:9</ref></char></char></note> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />या का तुमन मूसा के कानून म नइं पढ़े हवव कि पुरोहितमन बिसराम के दिन मंदिर म बिसराम के कानून ला टोरथें, तभो ले ओमन दोसी नइं ठहिरंय? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />मेंह तुमन ला कहथंव कि इहां एक झन हवय, जऊन ह मंदिर ले घलो बड़े अय। <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />मेंह बलिदान नइं पर दया चाहथंव। परमेसर के बचन म लिखे ये बात ला यदि तुमन समझतेव,<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">होसे 6:6</ref></char></char></note> त तुमन निरदोसीमन ला दोसी नइं ठहिरातेव। <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />काबरकि मनखे के बेटा ह बिसराम दिन के परभू अय।”<note caller="+" style="f"><char style="fr" closed="false">12:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 8:4-8">भजन 8:4‑8</ref>; <ref loc="MRK 2:28">मर 2:28</ref></char></char></note><verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />उहां ले चलके, यीसू ह यहूदीमन के सभा-घर म आईस। <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />उहां एक झन मनखे रहय, जेकर एक हांथ ह सूख गे रहय। उहां कुछू मनखेमन यीसू ऊपर दोस लगाय बर बहाना खोजत रिहिन, एकरसेति ओमन यीसू ले पुछिन, “का बिसराम के दिन कोनो बिमरहा ला चंगा करई कानून के मुताबिक सही अय?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />यीसू ह ओमन ला कहिस, “यदि तुमन के काकरो एक ठन भेड़ हवय अऊ ओह बिसराम के दिन खंचवा म गिर जावय, त का तुमन ओला पकड़के बाहिर नइं निकालहू? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />मनखे के कीमत ह एक ठन भेड़ ले बहुंत बढ़के होथे। एकरसेति बिसराम के दिन म भलई करई कानून के मुताबिक सही अय।”<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />तब यीसू ह ओ सूखा हांथवाले मनखे ले कहिस, “अपन हांथ ला लमा।” ओह अपन हांथ ला लमाईस अऊ ओ हांथ ह दूसर हांथ सहीं पूरा बने हो गीस। <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />पर फरीसीमन बाहिर निकलिन अऊ ओमन यीसू ला मार डारे के योजना बनाईन।<verse eid="MAT 12:14" /></para>
  <para style="s1">परमेसर के चुने सेवक</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />येला जानके यीसू ह उहां ले चल दीस, अऊ बहुंत मनखेमन यीसू के पाछू हो लीन। ओह जम्मो बिमरहा मनखेमन ला चंगा करिस, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />अऊ ओमन ला चेताके कहिस, “कोनो ला झन बतावव कि मेंह कोन अंव।” <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />ये किसम ले यसायाह अगमजानी के दुवारा कहे गे ये बचन ह पूरा होईस:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“देखव, येह मोर सेवक ए, जऊन ला मेंह चुने हवंव,</para>
  <para style="q2" vid="MAT 12:18">येला मेंह मया करथंव, अऊ येकर ले मेंह बहुंत खुस हवंव।</para>
  <para style="q1" vid="MAT 12:18">मेंह येकर ऊपर अपन आतमा डालहूं,</para>
  <para style="q2" vid="MAT 12:18">अऊ येह जाति-जाति के मनखेमन ला नियाय के संदेस दीही।<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />येह न तो झगरा करही अऊ न ऊंचहा सबद म बोलही,</para>
  <para style="q2" vid="MAT 12:19">अऊ न ही गलीमन म कोनो एकर अवाज सुनहीं।<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />कुचरे सरकंडा ला न तो ओह टोरही,</para>
  <para style="q2" vid="MAT 12:20">अऊ न ही सुलगत दीया के बाती ला बुताही,</para>
  <para style="q1" vid="MAT 12:20">जब तक कि येह नियाय ला जीत नइं देवा दीही।<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />जाति-जाति के मनखेमन एकर नांव म अपन आसा रखहीं।”<note caller="+" style="f"><char style="fr" closed="false">12:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 42:1-4">यसा 42:1‑4</ref></char></char></note><verse eid="MAT 12:21" /></para>
  <para style="s1">यीसू अऊ बालजबूल</para>
  <para style="r">(<ref loc="MRK 3:20-30">मरकुस 3:20‑30</ref>; <ref loc="LUK 11:14-23">लूका 11:14‑23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />तब मनखेमन एक भूत धरे मनखे ला यीसू करा लानिन, जऊन ह अंधरा अऊ कोंदा रिहिस। यीसू ह ओला चंगा करिस अऊ ओ मनखे ह बोलन अऊ देखन लगिस। <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />जम्मो मनखेमन चकित होके कहे लगिन, “कहूं येह दाऊद के संतान तो नो हय?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />पर जब फरीसीमन ये बात ला सुनिन, त ओमन कहिन, “ये मनखे ह परेत आतमामन के सरदार बालजबूल के मदद ले परेत आतमामन ला निकालथे।”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />यीसू ह ओमन के मन के बात ला जानके ओमन ला कहिस, “जऊन राज म फूट पड़ जाथे, ओह उजर जाथे, अऊ जऊन सहर या घराना म फूट पड़ जाथे, ओह टिके नइं रहय। <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />यदि सैतान ह सैतान ला निकालथे, त ओह अपन खुद के बिरोधी हो गे हवय। तब ओकर राज ह कइसने टिके रह सकथे? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />यदि मेंह बालजबूल के मदद ले परेत आतमामन ला निकालथंव, त फेर तुम्हर मनखेमन काकर मदद ले ओमन ला निकालथें? एकरसेति, ओही मन तुम्हर नियाय करहीं। <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />पर यदि मेंह परमेसर के आतमा के मदद ले परेत आतमामन ला निकालथंव, त फेर परमेसर के राज ह तुम्हर करा आ गे हवय।<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />“या कोन ह कोनो बलवान मनखे के घर म घुसरके ओकर संपत्ति ला लूट सकथे, जब तक कि पहिली ओह ओ बलवान मनखे ला नइं बांध लेवय? एकर बाद ही ओह ओकर घर ला लूट सकही।<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />“जऊन ह मोर संग नइं ए, ओह मोर बिरोध म हवय, अऊ जऊन ह मोर संग नइं संकेलय, ओह बगराथे। <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />एकरसेति, मेंह तुमन ला कहत हंव कि मनखेमन के हर एक पाप अऊ निन्दा ला छेमा करे जाही, पर पबितर आतमा के निन्दा ला छेमा नइं करे जावय। <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />जऊन ह मनखे के बेटा के बिरोध म कोनो बात कहिथे, त ओला छेमा करे जाही, पर जऊन ह पबितर आतमा के बिरोध म कहिथे, ओला छेमा नइं करे जावय, न तो ये समय म अऊ न ही अवइया समय म।<note caller="+" style="f"><char style="fr" closed="false">12:32 </char><char style="ft" closed="false"><char style="xt"><ref loc="MRK 3:29">मर 3:29</ref></char></char></note><verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“बने रूख ला लगाहू, त ओमा सुघर फर धरही; यदि खराप रूख लगाहू, त ओमा खराप फर धरही; काबरकि रूख ह अपन फर ले चिनहे जाथे। <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />हे जहरिला सांप के पीलामन हो! तुमन खराप मनखे अव अऊ सुघर गोठ कइसने कह सकथव? काबरकि जऊन बात ले दिल ह भरे रहिथे, ओहीच ह मुहूं ले निकलथे। <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />बने मनखे ह अपन दिल के बने भंडार ले बने बातमन ला निकालथे, अऊ खराप मनखे ह अपन हिरदय म भरे खराप भंडार ले खराप बात निकालथे। <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />पर मेंह तुमन ला कहत हंव कि नियाय के दिन मनखेमन ला ओमन के मुहूं ले निकले हर एक बेकार बात के हिसाब देय पड़ही। <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />काबरकि तुमन अपन गोठ के दुवारा निरदोस ठहिरहू अऊ अपन गोठ के दुवारा ही दोसी ठहिरहू।”<verse eid="MAT 12:37" /></para>
  <para style="s1">योना अगमजानी के चिनहां</para>
  <para style="r">(<ref loc="MRK 8:11-12">मरकुस 8:11‑12</ref>; <ref loc="LUK 11:29-32">लूका 11:29‑32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />तब कुछू फरीसी अऊ कानून के गुरूमन यीसू ले कहिन, “हे गुरू! हमन तोर ले कोनो अचरज के चिनहां देखे चाहत हन।”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />यीसू ह ओमन ला जबाब दीस, “ये दुस्ट अऊ बेभिचारी पीढ़ी के मनखेमन चिनहां देखाय बर कहत हवंय! पर योना अगमजानी के चिनहां ला छोंड़ येमन ला अऊ कोनो चिनहां नइं दिये जावय। <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />जइसने योना ह तीन दिन अऊ तीन रात एक ठन बड़े मछरी के पेट म रिहिस, वइसने मनखे के बेटा ह घलो तीन दिन अऊ तीन रात धरती के भीतर म रहिही।<note caller="+" style="f"><char style="fr" closed="false">12:40 </char><char style="ft" closed="false"><char style="xt"><ref loc="JON 1:17">योना 1:17</ref>; <ref loc="1CO 15:4">1 कुरि 15:4</ref></char></char></note> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />नियाय के दिन नीनवे सहर के मनखेमन, ये पीढ़ी के मनखेमन संग ठाढ़ होहीं, अऊ येमन ऊपर दोस लगाहीं, काबरकि ओमन योना के संदेस ला सुनके मन फिराईन। पर देखव! इहां एक झन हवय, जऊन ह योना ले घलो बड़के अय। <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />नियाय के दिन दक्खिन दिग के रानी ह ये पीढ़ी के मनखेमन संग ठाढ़ होही अऊ येमन ऊपर दोस लगाही, काबरकि ओ रानी ह राजा सुलेमान के गियान के बात ला सुने बर धरती के छोर ले आय रिहिस। पर देखव! इहां एक झन हवय, जऊन ह राजा सुलेमान ले घलो बड़के अय।<verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“जब एक असुध आतमा ह कोनो मनखे म ले बाहिर निकलथे, त ओह सुरताय के ठिकाना खोजत सूखा ठऊरमन म जाथे, पर ओला कोनो जगह नइं मिलय। <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />तब ओह कहिथे, ‘जऊन घर ला मेंह छोंड़के आय रहेंव, मेंह ओहीच घर म लहुंट जाहूं।’ अऊ जब ओह लहुंटके आथे, त ओह ओ घर ला सूना, झाड़े-बहारे अऊ सजे-धजे पाथे। <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />तब ओह जाथे अऊ अपन ले घलो जादा खराप सात ठन आने आतमामन ला ले आथे, अऊ ओमन ओ मनखे म जाथें अऊ उहां बस जाथें। अऊ ओ मनखे के आखिरी दसा ह पहिली ले अऊ खराप हो जाथे। अइसनेच ये दुस्ट पीढ़ी के मनखेमन के दसा घलो होही।”<verse eid="MAT 12:45" /></para>
  <para style="s1">यीसू के दाई अऊ भाईमन</para>
  <para style="r">(<ref loc="MRK 3:31-35">मरकुस 3:31‑35</ref>; <ref loc="LUK 8:19-21">लूका 8:19‑21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />जब यीसू ह मनखेमन ले गोठियावत रिहिस, त ओकर दाई अऊ भाईमन आके बाहिर खड़े रिहिन अऊ ओमन ओकर ले बात करे चाहत रिहिन। <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />एक झन ह यीसू ला कहिस, “तोर दाई अऊ भाईमन बाहिर म ठाढ़े हवंय अऊ तोर ले बात करे चाहत हवंय।”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />पर यीसू ह ओ मनखे ला कहिस, “कोन ह मोर दाई अय, अऊ कोन मन मोर भाई अंय?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />अऊ यीसू ह अपन चेलामन कोति अपन हांथ ला लमाके कहिस, “येमन अंय मोर दाई अऊ मोर भाई। <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />काबरकि जऊन ह मोर स्वरग के ददा के ईछा मुताबिक चलथे, ओहीच ह मोर भाई, मोर बहिनी अऊ मोर दाई अय।”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">बीज बोवइया के पटंतर</para>
  <para style="r">(<ref loc="MRK 4:1-9">मरकुस 4:1‑9</ref>; <ref loc="LUK 8:4-8">लूका 8:4‑8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />ओहीच दिन, यीसू ह घर ले निकलिस, अऊ जाके झील के तीर म बईठ गीस। <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />तब ओकर चारों कोति अतेक बड़े भीड़ जूर गीस कि ओला एक ठन डोंगा ऊपर चघके बईठे पड़िस, अऊ जम्मो मनखेमन झील के तीर म ठाढ़े रहंय। <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />तब यीसू ह ओमन ला पटंतर म बहुंत अकन बात बताईस। ओह कहिस, “एक किसान ह बीज बोय बर निकलिस। <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />जब ओह बोवत रिहिस, त कुछू बीजामन रसता के तीर म गिरिन अऊ चिरईमन आके ओला खा लीन। <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />कुछू बीजामन पथर्री भुइयां म गिरिन, जिहां ओमन ला जादा माटी नइं मिलिस। ओ बीजामन जल्दी जाम गीन काबरकि उहां माटी ह गहिरा नइं रिहिस। <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />पर जब सूरज निकलिस, त ओमन मुरझा गीन अऊ जरी नइं धरे रहय के कारन ओमन सूख गीन। <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />कुछू बीजामन कंटिली झाड़ीमन के बीच म गिरिन अऊ ओ झाड़ीमन बढ़के ओमन ला दबा दीन। <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />पर कुछू बीजामन बने भुइयां ऊपर गिरिन अऊ जादा फर लानिन; कोनो सौ गुना, कोनो साठ गुना अऊ कोनो तीस गुना। <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />जेकर कान हवय, ओह सुन ले।”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />चेलामन यीसू करा आके ओकर ले पुछिन, “तेंह मनखेमन संग पटंतर म काबर गोठियाथस?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />ओह जबाब दीस, “स्वरग राज के भेद के गियान तुमन ला देय गे हवय, पर ओमन ला नइं।<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="MRK 4:11">मर 4:11</ref></char></char></note> <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />काबरकि जेकर करा हवय, ओला अऊ दिये जाही अऊ ओकर करा बहुंत जादा हो जाही। पर जेकर करा नइं ए, ओकर करा ले ओला घलो ले लिये जाही, जऊन थोर बहुंत ओकर करा हवय। <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />मेंह ओमन ले एकर कारन पटंतर म गोठियाथंव:</para>
  <para style="q1" vid="MAT 13:13">“ताकि देखत ले घलो ओमन झन देख सकंय,</para>
  <para style="q2" vid="MAT 13:13">अऊ सुनत ले घलो ओमन झन सुन सकंय या समझ सकंय।<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />ओमन के बारे म यसायाह अगमजानी के ये अगमबानी ह पूरा होथे:</para>
  <para style="q1" vid="MAT 13:14">“ ‘तुमन सुनहू जरूर, पर कभू नइं समझहू,</para>
  <para style="q2" vid="MAT 13:14">अऊ तुमन देखहू जरूर, पर कभू नइं सुझही।<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />काबरकि ये मनखेमन के हिरदय ह कठोर हो गे हवय;</para>
  <para style="q2" vid="MAT 13:15">अऊ येमन अपन कान ला बंद कर ले हवंय,</para>
  <para style="q2" vid="MAT 13:15">अऊ येमन अपन आंखी ला मुंद ले हवंय।</para>
  <para style="q1" vid="MAT 13:15">नइं तो येमन अपन आंखीमन ले देखतिन,</para>
  <para style="q2" vid="MAT 13:15">अपन कानमन ले सुनतिन,</para>
  <para style="q2" vid="MAT 13:15">अपन हिरदय ले समझतिन अऊ मोर कोति फिरतिन,</para>
  <para style="q1" vid="MAT 13:15">अऊ मेंह येमन ला चंगा कर देतेंव।’<verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />पर धइन अंय तुम्हर आंखीमन, काबरकि ओमन देखथें, अऊ धइन अंय तुम्हर कानमन, काबरकि ओमन सुनथें। <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />मेंह तुमन ला सच कहथंव कि जऊन चीज ला तुमन देखत हव, ओला कतको अगमजानी अऊ धरमी मनखेमन देखे चाहत रिहिन, पर देख नइं सकिन; अऊ जऊन बात ला तुमन सुनत हवव, ओला ओमन सुने चाहत रिहिन, पर सुन नइं सकिन।<note caller="+" style="f"><char style="fr" closed="false">13:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="1JN 1:1">1 यूह 1:1</ref>, <ref loc="1JN 1:2">2</ref></char></char></note><verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“अब तुमन किसान के पटंतर के मतलब ला सुनव। <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />जब कोनो मनखे स्वरग राज के बचन ला सुनथे अऊ ओला नइं समझय, त जऊन बचन ओकर हिरदय म बोय गे रहिथे, ओला दुस्ट सैतान ह आके छीन लेथे। येह ओ बीजा ए, जऊन ह रसता के तीर म बोय गे रिहिस। <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />जऊन बीजा ह पथर्री भुइयां म बोय गे रिहिस, येह ओ मनखे अय, जऊन ह बचन ला सुनके तुरते ओला आनंद सहित गरहन करथे। <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />पर अपन म जरी नइं धरे रहय के कारन, ओकर बिसवास ह कुछू समय तक ही रहिथे। जब बचन के सेति समस्या अऊ सतावा आथे, त ओह तुरते बचन के मुताबिक चले बर बंद कर देथे। <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />जऊन बीजा ह कंटिली झाड़ीमन के बीच म बोय गे रिहिस, येह ओ मनखे अय, जऊन ह बचन ला सुनथे, पर ये जिनगी के चिंता अऊ धन के लोभ ह बचन ला दबा देथे अऊ ओह फर नइं लानय। <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />पर जऊन बीजा ह बने भुइयां म बोय गे रिहिस, येह ओ मनखे अय, जऊन ह बचन ला सुनथे अऊ ओला समझथे। ओह फर लानथे; कोनो सौ गुना, कोनो साठ गुना अऊ कोनो तीस गुना।”<verse eid="MAT 13:23" /></para>
  <para style="s1">जंगली बीजा के पटंतर</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />यीसू ह ओमन ला एक अऊ पटंतर सुनाईस: “स्वरग के राज ह ओ मनखे के सहीं अय, जऊन ह अपन खेत म बने बीजा ला बोईस। <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />पर जब मनखेमन सुतत रिहिन, त ओ मनखे के बईरी ह आईस अऊ गहूं के बीच म जंगली बीजा ला बोके चल दीस। <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />जब गहूं ह जामिस अऊ एकर बाली दिखे लगिस, त फेर जंगली पऊधामन घलो दिखे लगिन।<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />“तब ओ खेत के मालिक के सेवकमन ओकर करा आईन अऊ कहिन, ‘मालिक, का तेंह अपन खेत म बने बीजा नइं बोय रहय? तब ओमा ये जंगली पऊधामन कहां ले आ गीन?’<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />“ओह ओमन ला कहिस, ‘येह कोनो बईरी के काम अय।’</para>
  <para style="p" vid="MAT 13:28">“तब सेवकमन ओकर ले पुछिन, ‘का तेंह चाहथस कि हमन जाके ओ जंगली पऊधामन ला उखान दन?’<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />“खेत के मालिक ह कहिस, ‘नइं, काबरकि जंगली पऊधा ला उखानत बखत, हो सकथे कि तुमन ओमन के संग म गहूं ला घलो उखान डारव। <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />लुवई के समय तक दूनों ला संगे-संग बढ़न देवव। लुवई के समय, मेंह लुवइयामन ला कहिहूं; पहिली जंगली पऊधामन ला संकेलव अऊ जलाय बर ओमन के बोझा बांध लेवव। तब गहूं ला जमा करके मोर कोठार म ले आवव।’ ”<verse eid="MAT 13:30" /></para>
  <para style="s1">सरसों के बीजा अऊ खमीर के पटंतर</para>
  <para style="r">(<ref loc="MRK 4:30-32">मरकुस 4:30‑32</ref>; <ref loc="LUK 13:18-19">लूका 13:18‑19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />यीसू ह ओमन ला एक अऊ पटंतर सुनाईस: “स्वरग के राज ह सरसों के एक बीजा के सहीं अय, जऊन ला लेके एक मनखे ह अपन खेत म बोईस। <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />सरसों के बीजा ह तो जम्मो बीजामन ले छोटे होथे, पर जब येह बाढ़थे, त जम्मो साग-भाजी ले बड़े हो जाथे अऊ अइसने रूख बन जाथे कि अकास के चिरईमन आके एकर डारामन म बसेरा करथें।<note caller="+" style="f"><char style="fr" closed="false">13:32 </char><char style="ft" closed="false">ए किसम के सरसों के पऊधा ह करीब तीन मीटर तक बढ़य।</char></note>”<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />यीसू ह ओमन ला एक ठन अऊ पटंतर सुनाईस: “स्वरग के राज ह खमीर सहीं अय, जऊन ला एक माईलोगन ह लीस अऊ ओला तीन पसेरी पीसान म मिलाके तब तक गुंथिस जब तक कि ओ जम्मो पीसान ह खमीर नइं हो गीस<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">खमीर के उपयोग पीसान ला फूलोय बर करे जावत रिहिस।</char></note>।”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />यीसू ह मनखेमन ला ये जम्मो बात पटंतर म कहिस, अऊ बिगर पटंतर के ओह ओमन ला कुछू नइं कहत रिहिस। <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />अइसने करे के दुवारा ओह अगमजानी के दुवारा कहे गय ये बात ला पूरा करिस:</para>
  <para style="q1" vid="MAT 13:35">“मेंह अपन बात पटंतर म करहूं।</para>
  <para style="q2" vid="MAT 13:35">मेंह ओ बातमन ला उजागर करहूं, जऊन ह संसार के सिरजे के समय ले गुपत म हवय।”<note caller="+" style="f"><char style="fr" closed="false">13:35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 78:2">भजन 78:2</ref></char></char></note><verse eid="MAT 13:35" /></para>
  <para style="s1">जंगली बीजा के पटंतर के मतलब</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />तब यीसू ह भीड़ ला छोंड़के घर के भीतर गीस। ओकर चेलामन ओकर करा आके कहिन, “खेत म जंगली बीजा के पटंतर के बारे म हमन ला समझा दे।”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />यीसू ह जबाब दीस, “जऊन मनखे ह बने बीजा ला बोईस, ओह मनखे के बेटा अय। <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />खेत ह संसार अय, अऊ बने बीजा ह स्वरग राज के संतान अंय। जंगली बीजामन दुस्ट सैतान के संतान अंय, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />अऊ जऊन बईरी ह येमन ला बोथे, ओह सैतान अय। लुवई ह संसार के अन्त अय, अऊ लुवइयामन स्वरगदूत अंय।<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />“जइसने जंगली पऊधामन ला जमा करके आगी म बार दिये जाथे, वइसने संसार के अन्त समय म होही। <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />मनखे के बेटा ह अपन स्वरगदूतमन ला पठोही, अऊ ओमन ओकर राज के ओ जम्मो झन ला निकालहीं, जऊन मन मनखेमन के पाप के कारन बनथें अऊ जऊन मन कुकरम करथें। <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />स्वरगदूतमन ओमन ला आगी के भट्ठी म झोंक दीहीं, जिहां ओमन रोहीं अऊ अपन दांत पीसहीं। <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />तब धरमी मनखेमन अपन परमेसर ददा के राज म सूरज सहीं चमकहीं। जेकर कान हवय, ओह सुन ले।<verse eid="MAT 13:43" /></para>
  <para style="s1">गुपत खजाना अऊ मोती के पटंतर</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“स्वरग के राज ह एक खेत म छिपे खजाना के सहीं अय, जऊन ला एक मनखे ह पाईस, अऊ ओह ओला फेर लुका दीस। तब ओह खुसी म गीस अऊ अपन जम्मो कुछू ला बेचके ओ खेत ला बिसा लीस।<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“फेर, स्वरग के राज ह एक सौदागर के सहीं अय, जऊन ह सुघर मोती के खोज म रहिथे। <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />जब ओला एक ठन मंहगा मोती मिलथे, त ओह जाथे अऊ अपन जम्मो कुछू ला बेचके ओ मोती ला बिसा लेथे।<verse eid="MAT 13:46" /></para>
  <para style="s1">जाल के पटंतर</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“फेर स्वरग के राज ह एक जाल के सहीं अय, जऊन ला समुंदर म डारे गीस, अऊ ओमा जम्मो किसम के मछरी फंसिन। <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />जब जाल ह भर गीस त मछुआरमन ओला खींचके तीर म ले आईन। तब ओमन बईठ गीन अऊ बने मछरीमन ला निमारके टुकना म संकेलिन, अऊ खराप मछरीमन ला फटिक दीन। <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />संसार के अन्त समय म अइसनेच होही। स्वरगदूतमन आहीं, अऊ दुस्ट मनखेमन ला धरमीमन के बीच ले अलग करहीं, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />अऊ ओमन ला आगी के भट्ठी म झोंक दीहीं, जिहां ओमन रोहीं अऊ अपन दांत पीसहीं।<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />“का तुमन ये जम्मो गोठ ला समझेव?” यीसू ह अपन चेलामन ले पुछिस।</para>
  <para style="p" vid="MAT 13:51">“हव जी।” ओमन जबाब दीन।<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />यीसू ह ओमन ला कहिस, “एकरसेति, मूसा के कानून के हर ओ गुरू, जऊन ह स्वरग राज के चेला बन चुके हवय, ओह एक घर के मालिक सहीं अय, जऊन ह अपन भंडार ले नवां के संग-संग जुन्ना चीजमन ला निकालथे।”<verse eid="MAT 13:52" /></para>
  <para style="s1">एक अगमजानी बिगर आदरमान के</para>
  <para style="r">(<ref loc="MRK 6:1-6">मरकुस 6:1‑6</ref>; <ref loc="LUK 4:16-30">लूका 4:16‑30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />यीसू ह ये पटंतरमन ला सुनाय के बाद उहां ले चल दीस। <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />ओह अपन नगर म आईस, अऊ मनखेमन ला ओमन के सभा-घर म सिकछा देवन लगिस। मनखेमन ओकर उपदेस ला सुनके चकित होईन अऊ कहिन, “ये मनखे ला, ये बुद्धि अऊ ये अचरज के काम करे के सामर्थ कहां ले मिलिस? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />का येह बढ़ई के बेटा नो हय? का एकर दाई के नांव मरियम नो हय? का याकूब, यूसुफ, सिमोन अऊ यहूदा एकर भाई नो हंय? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />का एकर जम्मो बहिनीमन हमर बीच म नइं रहंय? तब ये मनखे ला ये जम्मो चीज कहां ले मिलिस?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />अऊ ओमन ओकर ऊपर नराज होईन।</para>
  <para style="p" vid="MAT 13:57">पर यीसू ह ओमन ला कहिस, “अगमजानी ह अपन नगर अऊ अपन घर के छोंड़ जम्मो जगह म आदरमान पाथे।”<note caller="+" style="f"><char style="fr" closed="false">13:57 </char><char style="ft" closed="false"><char style="xt"><ref loc="LUK 4:28-29">लूका 4:28‑29</ref></char></char></note><verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />मनखेमन के अबिसवास के कारन, ओह उहां जादा अचरज के काम नइं करिस।<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">यूहन्ना बतिसमा देवइया के हतिया</para>
  <para style="r">(<ref loc="MRK 6:14-29">मरकुस 6:14‑29</ref>; <ref loc="LUK 9:7-9">लूका 9:7‑9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />ओ समय चौथाई भाग के राजा हेरोदेस ह यीसू के बारे म सुनिस, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />अऊ ओह अपन सेवकमन ला कहिस, “येह यूहन्ना बतिसमा देवइया अय। ओह मरे म ले जी उठे हवय। एकर कारन ओकर दुवारा चमतकार के काममन होवत हवंय।”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />हेरोदेस ह अपन भाई फिलिप्पुस के घरवाली हेरोदियास के कारन यूहन्ना ला पकड़वाके बंदी बनवाय रिहिस अऊ ओला जेल म डलवा दे रिहिस। <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />काबरकि यूहन्ना ह हेरोदेस ला कहे रिहिस, “अपन भाई के घरवाली ला रखई तोर बर कानून के मुताबिक उचित नो हय।” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />हेरोदेस ह यूहन्ना ला मार डारे चाहत रिहिस, पर ओह मनखेमन ले डरावत रिहिस काबरकि मनखेमन यूहन्ना ला एक अगमजानी मानत रिहिन।<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />हेरोदेस के जनम दिन म हेरोदियास के बेटी ह नेवताहारीमन के आघू म नाचिस अऊ हेरोदेस ला खुस कर दीस। <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />तब हेरोदेस ह किरिया खाके ओला ये बचन दीस, “जऊन कुछू तेंह मांगबे, मेंह तोला दूहूं।” <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />ओह अपन दाई के सिखोय म आके कहिस, “यूहन्ना बतिसमा देवइया के मुड़ ला एक ठन थाली म इहां मोर करा मंगवा दे।” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />राजा ह दुखी होईस, पर अपन किरिया अऊ जेवनार म आय पहुनामन के सेति ओह हुकूम दीस, “येला यूहन्ना के मुड़ दे दिये जावय।” <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />ओह सिपाहीमन ला पठोके, जेल म यूहन्ना के मुड़ ला कटवा दीस। <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />ओकर मुड़ ला एक ठन थाली म लाय गीस अऊ ओ छोकरी ला दे दिये गीस, अऊ ओह मुड़ ला अपन दाई करा ले गीस। <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />यूहन्ना के चेलामन आईन अऊ ओकर लास ला ले जाके, ओला माटी दे दीन। तब ओमन जाके यीसू ला ये खबर दीन।<verse eid="MAT 14:12" /></para>
  <para style="s1">यीसू ह पांच हजार मनखेमन ला खाना खवाथे</para>
  <para style="r">(<ref loc="MRK 6:30-44">मरकुस 6:30‑44</ref>; <ref loc="LUK 9:10-17">लूका 9:10‑17</ref>; <ref loc="JHN 6:1-14">यूहन्ना 6:1‑14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />जब यीसू ह ये खबर ला सुनिस, त एक ठन डोंगा म चघके, ओह एके झन उहां ले एक सुनसान जगह म चल दीस। जब मनखेमन ला ये बात के पता चलिस, त ओमन सहरमन ले निकलके पैदलेच ओकर खोज म गीन। <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />जब यीसू ह डोंगा ले उतरिस अऊ मनखेमन के एक बड़े भीड़ ला देखिस, त ओला ओमन के ऊपर तरस आईस अऊ ओह ओमन के बिमरहामन ला बने करिस।<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />जब सांझ होय लगिस, तब चेलामन ओकर करा आईन अऊ कहिन, “येह एक सुनसान जगह ए, अऊ बेरा ह ढरक गे हवय। भीड़ के मनखेमन ला भेज, ताकि ओमन गांवमन म जाके अपन बर कुछू जेवन बिसो सकंय।”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />यीसू ह कहिस, “येमन ला कहीं जाय के जरूरत नइं ए। तुमन येमन ला कुछू खाय बर देवव।”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />ओमन यीसू ला कहिन, “इहां हमर करा सिरिप पांच ठन रोटी अऊ दू ठन मछरी हवय।”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />यीसू ह कहिस, “ओमन ला इहां मोर करा लानव।” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />तब यीसू ह मनखेमन ला कांदी म बईठे के हुकूम दीस। ओह पांच रोटी अऊ दू ठन मछरी ला लीस अऊ स्वरग कोति देखके, ओह परमेसर ला धनबाद दीस, अऊ रोटीमन ला टोर-टोरके अपन चेलामन ला दीस अऊ चेलामन मनखेमन ला दीन। <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />ओ जम्मो झन खाईन अऊ खाके अघा गीन। चेलामन बांचे-खुचे टुकड़ा के बारह टुकना भर के उठाईन। <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />जऊन मन भोजन करिन, ओमा माईलोगन अऊ लइकामन ला छोंड़के, करीब पांच हजार आदमीमन रिहिन।<verse eid="MAT 14:21" /></para>
  <para style="s1">यीसू ह पानी ऊपर रेंगथे</para>
  <para style="r">(<ref loc="MRK 6:45-52">मरकुस 6:45‑52</ref>; <ref loc="JHN 6:15-21">यूहन्ना 6:15‑21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />एकर बाद, यीसू ह तुरते चेलामन ला डोंगा म चघाईस कि ओमन ओकर ले आघू झील के ओ पार जावंय, तब तक ओह मनखेमन ला बिदा करिस। <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />मनखेमन ला बिदा करे पाछू, यीसू ह एके झन पराथना करे बर पहाड़ ऊपर गीस। जब सांझ होईस, त ओह उहां एके झन रिहिस। <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />ओ समय डोंगा ह भुइयां ले बहुंत दूरिहा म रिहिस, अऊ पानी के लहरा म डगमगावत रिहिस, काबरकि हवा ह ओकर उल्टा बोहावत रहय।<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />झूलझूलहा यीसू ह समुंदर ऊपर रेंगत चेलामन करा आईस। <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />जब चेलामन यीसू ला समुंदर ऊपर रेंगत देखिन, त ओमन डरा गीन अऊ कहिन, “येह भूत अय।” अऊ ओमन डर के मारे चिचियाय लगिन।<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />तब यीसू ह तुरते ओमन ला कहिस, “हिम्मत रखव। येह में अंव। झन डरव।”<note caller="+" style="f"><char style="fr" closed="false">14:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:14">निर 3:14</ref></char></char></note><verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />पतरस ह कहिस, “हे परभू, यदि तें अस, त मोला पानी ऊपर तोर करा आय के हुकूम दे।”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />यीसू ह कहिस, “आ।”</para>
  <para style="p" vid="MAT 14:29">तब पतरस ह डोंगा ले उतरिस अऊ पानी ऊपर रेंगत यीसू कोति आय लगिस। <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />पर जब ओह हवा ला बहत देखिस, त ओह डरा गीस अऊ पानी म बुड़न लगिस, त चिचियाके कहिस, “हे परभू! मोला बचा।”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />यीसू ह तुरते अपन हांथ बढ़ाके ओला थाम लीस अऊ कहिस, “हे अल्‍प बिसवासी, तेंह संका काबर करय?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />जब ओ दूनों डोंगा म चघ गीन, त हवा ह सांत हो गीस। <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />तब जऊन मन डोंगा म रिहिन, ओमन यीसू ला दंडवत करिन अऊ कहिन, “सही म तेंह परमेसर के बेटा अस।”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />ओमन झील के ओ पार गन्नेसरत सहर म हबरिन। <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />उहां के मनखेमन यीसू ला चिन डारिन अऊ ओमन आसपास के जम्मो गांव म खबर भिजवा दीन। मनखेमन जम्मो बिमरहामन ला यीसू करा लानिन, <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />अऊ ओकर ले बिनती करिन, “ये बिमरहामन ला तोर ओनहा के छोर ला सिरिप छुवन दे।” अऊ जतेक झन ओला छुईन, ओ जम्मो झन चंगा हो गीन।<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">सुध अऊ असुध</para>
  <para style="r">(<ref loc="MRK 7:1-13">मरकुस 7:1‑13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />तब यरूसलेम सहर ले कुछू फरीसी अऊ कानून के गुरूमन यीसू करा आईन, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />अऊ ओकर ले पुछिन, “तोर चेलामन काबर पुरखामन के रीति-रिवाज ला नइं मानंय? खाना खाय के पहिली, ओमन अपन हांथ ला नइं धोवंय।”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />यीसू ह ओमन ला जबाब दीस, “अऊ तुमन अपन रीति-रिवाज के हित म परमेसर के हुकूम ला काबर नइं मानव? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />काबरकि परमेसर ह हुकूम दे हवय, ‘अपन दाई अऊ ददा के आदरमान करव,<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12">निर 20:12</ref>;</char> <char style="xt"><ref loc="DEU 5:16">ब्यव 5:16</ref></char></char></note> अऊ जऊन ह अपन दाई या ददा के बुरई करथे, ओह मार डारे जावय।’<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:17">निर 21:17</ref>;</char> <char style="xt"><ref loc="LEV 20:9">लैव्य 20:9</ref></char></char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />पर तुमन कहिथव कि यदि कोनो अपन दाई या ददा ले कहय कि जऊन मदद तुमन ला मोर कोति ले हो सकत रिहिस, मेंह ओला परमेसर ला भेंट के रूप म चघा दे हवंव। <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />तब ओला अपन ददा या दाई के आदरमान करे के जरूरत नइं अय। ये किसम ले तुमन अपन रीति-रिवाज के हित म परमेसर के बचन ला टार देथव। <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />हे ढोंगी मनखेमन! यसायाह अगमजानी ह तुम्हर बारे म ये कहिके बिलकुल सही अगमबानी करे हवय:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“ये मनखेमन अपन ओंठ ले मोर आदर करथें,</para>
  <para style="q2" vid="MAT 15:8">पर ओमन के हिरदय ह मोर ले दूरिहा हवय,<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />येमन बेकार म मोर अराधना करथें;</para>
  <para style="q2" vid="MAT 15:9">काबरकि येमन मनखे के बनाय नियममन ला सिखाथें।”<verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />यीसू ह मनखेमन के भीड़ ला अपन करा बलाईस अऊ कहिस, “तुमन सुनव अऊ समझव। <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />जऊन चीज ह मुहूं म जाथे, ओह मनखे ला असुध नइं करय, पर जऊन ह मुहूं ले बाहिर निकलथे, ओह मनखे ला असुध करथे।”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />तब चेलामन यीसू करा आके पुछिन, “का तेंह जानथस कि तोर ये बात ले फरीसीमन ला ठेस लगे हवय?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />यीसू ह जबाब दीस, “जऊन पऊधा ला, स्वरग म रहइया मोर ददा ह नइं लगाय हवय, ओला जरी ले उखान दिये जाही। <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />ओमन ला रहन दव। ओमन अंधरा अगुवा अंय। यदि एक अंधरा ह दूसर अंधरा ला रसता देखाही, त ओमन दूनों खंचवा म गिरहीं।”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />येला सुनके पतरस ह ओला कहिस, “ये पटंतर ला हमन ला समझा दे।”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />यीसू ह कहिस, “का तुमन अभी तक ले नासमझ हवव? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />का तुमन नइं जानव कि जऊन चीज ह मुहूं म जाथे, ओह पेट म ले होके संडास ले बाहिर निकल जाथे? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />पर जऊन चीज ह मुहूं ले निकलथे, ओह हिरदय ले आथे अऊ ओह मनखे ला असुध करथे। <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />काबरकि खराप बिचार, हतिया, बेभिचार, छिनारीपन, चोरी, लबारी गवाही अऊ निन्दा—ये जम्मो बात हिरदय ले निकलथे, <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />अऊ ये बातमन मनखे ला असुध करथें, पर बिगर हांथ धोय भोजन करई, मनखे ला असुध नइं करय।”<verse eid="MAT 15:20" /></para>
  <para style="s1">एक कनानी माईलोगन के बिसवास</para>
  <para style="r">(<ref loc="MRK 7:24-30">मरकुस 7:24‑30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />ओ जगह ला छोंड़के, यीसू ह सूर अऊ सीदोन के सीमना म चले गीस। <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />ओ इलाका के एक कनानी माईलोगन ह ओकर करा आईस अऊ चिचियाके कहिस, “हे परभू, दाऊद के संतान, मोर ऊपर दया कर! मोर बेटी ला भूत धरे हवय अऊ ओला भयंकर सतावत हवय।”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />पर यीसू ह ओला कुछू जबाब नइं दीस। तब ओकर चेलामन आईन अऊ ओकर ले बिनती करिन, “ओ माईलोगन ला बिदा कर, काबरकि ओह चिचियावत हमर पाछू-पाछू आवत हवय।”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />यीसू ह कहिस, “मेंह सिरिप इसरायल के गंवाय भेड़मन करा पठोय गे हवंव।”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />तब ओ माईलोगन ह आईस अऊ यीसू के आघू म माड़ी टेकके कहिस, “हे परभू, मोर मदद कर।”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />यीसू ह जबाब दीस, “लइकामन के रोटी ला लेके कुकुरमन ला देवई ठीक नो हय।”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />ओह कहिस, “हव परभू, पर कुकुरमन घलो ओमन के मालिक के मेज ले गिरे जूठा-काठा ला खा लेथें।”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />तब यीसू ह ओला कहिस, “हे माईलोगन, तोर बिसवास ह बहुंत बड़े अय। जइसने तेंह चाहथस, वइसनेच तोर बर होवय।” अऊ ओकर बेटी ह ओहीच बखत चंगा हो गीस।<verse eid="MAT 15:28" /></para>
  <para style="s1">यीसू ह चार हजार मनखेमन ला खाना खवाथे</para>
  <para style="r">(<ref loc="MRK 8:1-10">मरकुस 8:1‑10</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />यीसू ह ओ जगह ला छोंड़ दीस अऊ गलील के झील के तीरे-तीर गीस। तब ओह पहाड़ी ऊपर चघिस अऊ उहां बईठ गीस। <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />भीड़ के भीड़ मनखेमन ओकर करा आईन अऊ ओमन खोरवा, अंधरा, लूलवा, कोंदा अऊ बहुंते आने बिमरहामन ला लानके यीसू के गोड़ करा रख दीन, अऊ यीसू ह ओमन ला चंगा करिस। <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />मनखेमन अब्बड़ अचरज करिन, जब ओमन ये देखिन कि कोंदा ह गोठियावत हवय, लूलवा ह ठीक हो गे हवय, खोरवा ह रेंगत हवय अऊ अंधरा ह देखत हवय। अऊ ओमन इसरायल के परमेसर के महिमा करिन।<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />यीसू ह अपन चेलामन ला अपन करा बलाके कहिस, “मोला ये मनखेमन ऊपर तरस आथे। येमन तीन दिन ले मोर संग म हवंय, अऊ येमन करा खाय बर कुछू नइं ए। मेंह येमन ला भूखन पेट बिदा करे नइं चाहथंव, नइं तो येमन डहार म ही थकके गिर सकथें।”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />ओकर चेलामन कहिन, “अतेक बड़े भीड़ ला खवाय बर, ये सुनसान जगह म हमन कहां ले अतेक रोटी पाबो?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />यीसू ह पुछिस, “तुम्हर करा के ठन रोटी हवय?”</para>
  <para style="p" vid="MAT 15:34">ओमन कहिन, “सात ठन, अऊ कुछू छोटे-छोटे मछरी घलो।”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />यीसू ह मनखेमन ला भुइयां म बईठे बर कहिस। <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />तब ओह ओ सात ठन रोटी अऊ मछरीमन ला लीस, अऊ परमेसर ला धनबाद देके ओमन ला टोरिस अऊ अपन चेलामन ला देवत गीस अऊ चेलामन ओला मनखेमन ला बांट दीन। <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />ओ जम्मो झन खाईन अऊ खाके अघा गीन। ओकर बाद चेलामन बांचे-खुचे टुकड़ा के सात ठन टुकना भरके उठाईन। <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />जऊन मन उहां खाना खाईन, ओमा माईलोगन अऊ लइकामन ला छोंड़के, चार हजार आदमीमन रिहिन। <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />तब यीसू ह भीड़ ला बिदा करिस अऊ डोंगा म चघके ओह मगदन छेत्र म चल दीस।<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">एक चिनहां देखाय के मांग</para>
  <para style="r">(<ref loc="MRK 8:11-13">मरकुस 8:11‑13</ref>; <ref loc="LUK 12:54-56">लूका 12:54‑56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />फरीसी अऊ सदूकीमन यीसू करा आईन अऊ ओला परखे खातिर ओकर ले पुछिन, “हमन ला स्वरग ले कोनो चिनहां देखा।”<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />यीसू ह ओमन ला जबाब दीस, “जब संझा होथे, त तुमन कहिथव कि मौसम ह साफ रहिही, काबरकि अकास म लाली हवय, <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />अऊ बड़े बिहनियां के बखत तुमन कहिथव कि आज आंधी चलही, काबरकि अकास म लाली हवय अऊ बादर छाय हवय। तुमन ह अकास के चिनहां ला देखके, मौसम के बारे म बता देथव, पर तुमन समय के चिनहां के बारे नइं बता सकव। <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />ये दुस्ट अऊ बेभिचारी पीढ़ी के मनखेमन अचरज के चिनहां खोजथें, पर योना अगमजानी के चिनहां के छोंड़, येमन ला अऊ कुछू चिनहां नइं दिये जावय।” तब यीसू ह ओमन ला छोंड़के चल दीस।<verse eid="MAT 16:4" /></para>
  <para style="s1">फरीसी अऊ सदूकीमन के खमीर</para>
  <para style="r">(<ref loc="MRK 8:14-21">मरकुस 8:14‑21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />जब ओमन झील के ओ पार गीन, त चेलामन अपन संग रोटी लाने बर भुला गे रिहिन। <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />यीसू ह ओमन ला कहिस, “फरीसी अऊ सदूकीमन के खमीर ले सचेत रहव।”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />ओमन आपस म एकर बारे म बिचार करिन अऊ कहिन, “हमन रोटी नइं लाने हवन, एकरसेति ओह अइसने कहत हवय।”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />ओमन के सोच-बिचार ला जानके, यीसू ह ओमन ला कहिस, “हे अल्‍प बिसवासीमन हो! तुमन काबर अपन बीच म अइसने गोठियावत हव कि तुम्हर करा रोटी नइं ए? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />का तुमन अभी तक ले नइं समझत हवव? पांच हजार मनखेमन बर पांच ठन रोटी के बात, का तुमन सुरता नइं करत हव, अऊ कतेक ठन टुकना भरके तुमन संकेले रहेव? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />या फेर ओ चार हजार मनखेमन बर सात ठन रोटी के बात, का तुमन ला सुरता नइं ए, अऊ कतेक ठन टुकना भरके तुमन संकेले रहेव? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />तुमन ये काबर नइं समझव कि मेंह तुमन ला रोटी के बारे म नइं कहत रहेंव? पर तुमन ला फरीसी अऊ सदूकीमन के खमीर ले सचेत रहे बर कहत रहेंव।” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />तब ओमन समझिन कि यीसू ह ओमन ला रोटी के खमीर के बारे म नइं गोठियावत रिहिस, पर ओह ओमन ला फरीसी अऊ सदूकीमन के सिकछा ले सचेत रहे बर कहत रिहिस।<verse eid="MAT 16:12" /></para>
  <para style="s1">पतरस ह यीसू ला मसीह मान लेथे</para>
  <para style="r">(<ref loc="MRK 8:27-30">मरकुस 8:27‑30</ref>; <ref loc="LUK 9:18-21">लूका 9:18‑21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />जब यीसू ह कैसरिया-फिलिप्पी के इलाका म आईस, त ओह अपन चेलामन ले पुछिस, “मनखेमन मनखे के बेटा ला कोन ए, कहिथें?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />ओमन कहिन, “कुछू मनखेमन कहिथें कि ओह यूहन्ना बतिसमा देवइया अय; कुछू मन एलियाह अय, कहिथें; अऊ कुछू मनखेमन कहिथें कि ओह यरमियाह या अगमजानीमन ले एक झन अय।”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />यीसू ह ओमन ले पुछिस, “पर तुमन मोला कोन ए, कहत हव?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />सिमोन पतरस ह जबाब दीस, “तेंह जीयत परमेसर के बेटा—मसीह अस।”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />यीसू ह ओला कहिस, “सिमोन, योना के बेटा! धइन अस तेंह, काबरकि ये बात तोला कोनो मनखे ह नइं बताय हवय, पर मोर ददा जऊन ह स्वरग म हवय, ये बात तोर ऊपर उजागर करे हवय। <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />अऊ मेंह तोला कहत हंव कि तेंह पतरस<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="fq" closed="false">पतरस </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">चट्टान।</char></note> अस, अऊ ये चट्टान ऊपर मेंह अपन कलीसिया बनाहूं, अऊ पाताल-लोक<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मिरतू-लोक</char></note> के कपाटमन एकर ऊपर जय नइं पा सकंय। <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />मेंह तोला स्वरग राज के कुचीमन ला दूहूं। जऊन कुछू तेंह धरती ऊपर बांधबे, ओह स्वरग म बंधाही, अऊ जऊन कुछू तेंह धरती ऊपर खोलबे, ओह स्वरग म खुलही।” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />तब यीसू ह अपन चेलामन ला ये चेतउनी दीस, “तुमन कोनो ला, ये झन बतावव कि मेंह मसीह अंव।”<verse eid="MAT 16:20" /></para>
  <para style="s1">यीसू ह अपन मिरतू के बारे म अगमबानी करथे</para>
  <para style="r">(<ref loc="MRK 8:31-33">मरकुस 8:31‑33</ref>; <ref loc="LUK 9:22">लूका 9:22</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />ओ समय ले यीसू ह अपन चेलामन ला ये बताय लगिस, “येह जरूरी अय कि मेंह यरूसलेम जावंव अऊ यहूदीमन के अगुवा, मुखिया पुरोहित अऊ कानून के गुरूमन के हांथ ले बहुंते दुख भोगंव; अऊ मार डारे जावंव; अऊ तीसरा दिन जी उठंव।”<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />पतरस ह यीसू ला अलग ले गीस अऊ ओला ये कहिके डांटे लगिस, “परमेसर ह अइसने झन करय, परभू! तोर संग ये बात कभू झन होवय।”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />यीसू ह पतरस कोति मुड़के कहिस, “मोर नजर ले दूर हट, सैतान! तेंह मोर रसता म एक बाधा अस। तोर मन म परमेसर के बात नइं, पर मनखेमन के बात हवय।”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />तब यीसू ह अपन चेलामन ला कहिस, “जऊन कोनो मोर चेला बने चाहत हे, त येह जरूरी ए कि ओह अपन ईछा ला मारय, अऊ दुख उठाय बर तियार रहय अऊ तब मोर पाछू हो लेवय। <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />काबरकि जऊन ह अपन परान ला बचाय चाहथे, ओह ओला गंवाही; पर जऊन ह मोर खातिर अपन परान ला गंवाथे, ओह ओला बचाही। <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />यदि मनखे ह जम्मो संसार ला पा जावय, पर अपन परान ला गंवा दे, त ओला का फायदा? या कोनो मनखे अपन परान के बदले का दे सकथे? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />काबरकि मनखे के बेटा ह अपन स्वरगदूतमन के संग अपन ददा के महिमा म अवइया हवय, अऊ तब ओह हर एक मनखे ला ओकर काम के मुताबिक ईनाम दीही।<verse eid="MAT 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 16:28" />“मेंह तुमन ला सच कहत हंव कि कुछू झन, जऊन मन इहां ठाढ़े हवंय, तब तक नइं मरंय, जब तक कि ओमन मनखे के बेटा ला ओकर राज म आवत नइं देख लीहीं।”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">यीसू के रूपान्तरन</para>
  <para style="r">(<ref loc="MRK 9:2-13">मरकुस 9:2‑13</ref>; <ref loc="LUK 9:28-36">लूका 9:28‑36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />छै दिन के बाद यीसू ह पतरस, याकूब अऊ याकूब के भाई यूहन्ना ला अपन संग लीस अऊ ओमन ला अकेला एक ऊंचहा पहाड़ म ले गीस। <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />उहां ओमन के आघू म यीसू के रूप ह बदल गीस। ओकर चेहरा ह सूरज सहीं चमकत रहय अऊ ओकर कपड़ा ह अंजोर सहीं पंर्रा हो गीस। <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />तब उहां चेलामन के आघू म मूसा अऊ एलियाह परगट होईन अऊ ओमन यीसू के संग गोठियावत रिहिन।<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />पतरस ह यीसू ला कहिस, “हे परभू, हमन के इहां रहई बने अय। यदि तोर ईछा हवय, त मेंह इहां तीन ठन मंडप बनावत हंव—एक ठन तोर बर, एक मूसा बर अऊ एक एलियाह बर।”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />जब ओह गोठियावत रिहिस, त एक चमकीला बादर ह ओमन के ऊपर छा गीस, अऊ ओ बादर ले ये अवाज आईस, “येह मोर मयारू बेटा ए। एकर ले मेंह बहुंत खुस हवंव। एकर बात ला सुनव।”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />येला सुनके चेलामन मुहूं के भार भुइयां म गिरिन अऊ ओमन बहुंत डरा गीन। <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />पर यीसू ह आईस अऊ ओमन ला छूके कहिस, “उठव, झन डरव।” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />जब ओमन ऊपर देखिन, त ओमन ला यीसू के छोंड़ अऊ कोनो नइं दिखिस।<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />जब ओमन पहाड़ ले उतरत रिहिन, त यीसू ह ओमन ला हुकूम दीस, “जब तक मनखे के बेटा ह मरे म ले नइं जी उठय, तब तक तुमन जऊन कुछू देखे हवव, ओ बात कोनो ला झन बतावव।”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />तब चेलामन ओकर ले पुछिन, “त फेर कानून के गुरूमन काबर कहिथें कि पहिली एलियाह के अवई जरूरी अय।”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />यीसू ह जबाब दीस, “ये बात सही अय कि एलियाह ह आवत हवय अऊ ओह जम्मो चीज ला ठीक करही। <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />पर मेंह तुमन ला कहत हंव कि एलियाह ह आ चुके हवय अऊ मनखेमन ओला नइं चिन्हिन। पर ओमन जइसने चाहिन, वइसने ओकर संग बरताव करिन। इही किसम ले मनखे के बेटा घलो ओमन के हांथ ले दुख उठाही।” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />तब चेलामन समझिन कि यीसू ह ओमन ले यूहन्ना बतिसमा देवइया के बारे म कहत रिहिस।<verse eid="MAT 17:13" /></para>
  <para style="s1">यीसू ह मिरगी के रोगी एक छोकरा ला चंगा करथे</para>
  <para style="r">(<ref loc="MRK 9:14-29">मरकुस 9:14‑29</ref>; <ref loc="LUK 9:37-43">लूका 9:37‑43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />जब ओमन भीड़ करा आईन, त एक मनखे ह यीसू करा आईस अऊ ओकर आघू म माड़ी टेकके कहिस, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“हे परभू! मोर बेटा ऊपर दया कर। ओला मिरगी आथे अऊ ओकर कारन बहुंत दुख झेलथे। ओह अकसर आगी या पानी म गिर जाथे। <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />मेंह ओला तोर चेलामन करा लानेंव, पर ओमन ओला ठीक नइं कर सकिन।”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />यीसू ह कहिस, “हे अबिसवासी अऊ ढीठ पीढ़ी के मनखेमन! कब तक मेंह तुम्हर संग रहिहूं? कब तक मेंह तुम्हर सहत रहिहूं? ओ छोकरा ला इहां मोर करा लानव।” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />यीसू ह परेत आतमा ला दबकारिस अऊ ओह ओमा ले निकल गीस, अऊ ओ छोकरा ह ओहीच बखत ठीक हो गीस।<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />तब चेलामन यीसू करा अकेला म आईन अऊ पुछिन, “हमन ओला काबर नइं निकाल सकेंन?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />यीसू ह ओमन ला कहिस, “काबरकि तुम्हर बहुंत कम बिसवास हवय। मेंह तुमन ला सच कहत हंव कि यदि तुम्हर बिसवास ह सरसों के दाना के बरोबर घलो हवय, अऊ तुमन ये पहाड़ ले कहव, ‘इहां ले घुंचके उहां चले जा,’ त ओह घुंच जाही। तुम्हर बर कोनो घलो बात असंभव नइं होही। <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />पर ये किसम के परेत आतमा ह सिरिप पराथना अऊ उपास के दुवारा निकलथे।<note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">कुछू पुराना हस्तलिपि म ये पद नइं मिलय।</char></note>”<verse eid="MAT 17:21" /></para>
  <para style="s1">यीसू ह दूसर बार अपन मिरतू के अगमबानी करथे</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />जब चेलामन गलील प्रदेस म जूरिन, त यीसू ह ओमन ला कहिस, “मनखे के बेटा ह मनखेमन के हांथ म पकड़वाय जाही। <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />ओमन ओला मार डारहीं, पर तीसरा दिन ओह जी उठही।” येला सुनके चेलामन बहुंत उदास होईन।<verse eid="MAT 17:23" /></para>
  <para style="s1">मंदिर के लगान</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />जब यीसू अऊ ओकर चेलामन कफरनहूम म आईन, त मंदिर के लगान लेवइयामन पतरस करा आईन अऊ पुछिन, “का तुम्हर गुरू ह मंदिर के लगान नइं पटावय?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />ओह कहिस, “हव, ओह पटाथे।”</para>
  <para style="p" vid="MAT 17:25">जब पतरस ह घर के भीतर आईस, त ओकर पुछे के पहिली यीसू ह कहिस, “हे सिमोन, तेंह का सोचथस? ये धरती के राजामन काकर ले लगान लेथें? अपन खुद के बेटामन ले या आने मन ले?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />पतरस ह कहिस, “आने मन ले।”</para>
  <para style="p" vid="MAT 17:26">यीसू ह ओला कहिस, “तब तो बेटामन ला लगान पटाय बर नइं पड़य। <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />पर हमन ओमन ला ठेस पहुंचाय नइं चाहथन, एकरसेति तेंह झील म जा अऊ अपन गरी ला खेल। जऊन मछरी पहिली फंसही, ओला पकड़बे अऊ ओकर मुहूं ला खोलबे, त तोला उहां एक ठन सिक्का मिलही। ओला लेके मोर अऊ तुम्हर तरफ ले ओमन ला लगान पटा देबे।”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">स्वरग के राज म सबले बड़े कोन ए</para>
  <para style="r">(<ref loc="MRK 9:33-37">मरकुस 9:33‑37</ref>; <ref loc="LUK 9:46-48">लूका 9:46‑48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />ओ समय चेलामन यीसू करा आईन अऊ पुछिन, “स्वरग के राज म सबले बड़े कोन ए?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />यीसू ह एक छोटे लइका ला बलाईस अऊ ओला ओमन के बीच म ठाढ़ करके कहिस, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />“मेंह तुमन ला सच कहत हंव कि जब तक तुमन नइं बदलव अऊ छोटे लइकामन सहीं नइं बनव, तब तक तुमन स्वरग के राज म जाय नइं सकव। <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />एकरसेति जऊन ह अपनआप ला ये लइका के सहीं नम्र करथे, ओह स्वरग के राज म सबले बड़े अय। <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />अऊ जऊन ह मोर नांव म अइसने छोटे लइका ला गरहन करथे, ओह मोला गरहन करथे।<verse eid="MAT 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />“पर कोनो मनखे मोर ऊपर बिसवास करइया ये छोटे मन ले कोनो के पाप म गिरे के कारन बनथे, त ओकर बर बने होतिस कि ओकर घेंच म एक ठन बड़े जांता के पथरा ला बांधे जातिस अऊ ओला गहिरा समुंदर म बुड़ो दिये जातिस। <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />संसार ला ओ चीजमन बर धिक्कार अय, जऊन मन मनखेमन के पाप म पड़े के कारन बनथें। अइसने चीजमन के अवई जरूरी अय। पर धिक्कार अय ओ मनखे ला, जेकर दुवारा ओमन आथें। <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />यदि तुम्हर हांथ या तुम्हर गोड़ ह तुम्हर पाप म गिरे के कारन बनथे, त ओला काटके फटिक दव। तुम्हर बर येह बने अय कि तुमन लूलवा या खोरवा होके जिनगी म प्रवेस करव, एकर बनिस्पत कि दूनों हांथ या दूनों गोड़ के रहत, तुमन ला सदाकाल के आगी म डार दिये जावय। <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />अऊ यदि तुम्हर आंखी ह तुम्हर पाप म गिरे के कारन बनथे, त ओला निकालके फटिक दव। तुम्हर बर येह बने अय कि तुमन एक आंखी ले कनवां होके जिनगी म प्रवेस करव, एकर बनिस्पत कि दूनों आंखी के रहत तुमन ला नरक के आगी म डार दिये जावय।”<verse eid="MAT 18:9" /></para>
  <para style="s1">गंवाय भेड़ के पटंतर</para>
  <para style="r">(<ref loc="LUK 15:3-7">लूका 15:3‑7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“देखव! तुमन ये छोटे मन ले कोनो ला घलो तुछ झन समझव। काबरकि मेंह तुमन ला कहत हंव कि येमन के दूतमन स्वरग म मोर ददा के आघू म हमेसा रहिथें। <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />काबरकि मनखे के बेटा ह गंवायमन ला बंचाय बर आईस।<note caller="+" style="f" category="dup"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">कुछू पुराना हस्तलिपि म ये पद नइं मिलय।</char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />“तुमन का सोचथव? यदि कोनो मनखे करा सौ ठन भेड़ हवंय, अऊ ओमा के एक ठन भेड़ ह भटक जाथे, त का ओह निनानबे भेड़मन ला पहाड़ी ऊपर छोंड़के ओ एक ठन भटके भेड़ ला खोजे बर नइं जावय? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />अऊ यदि ओ भेड़ ह ओला मिल जावय, त मेंह तुमन ला सच कहत हंव, ओह ओ भेड़ खातिर जादा आनंद मनाही, एकर बनिस्पत कि ओ निनानबे भेड़ जऊन मन भटके नइं रिहिन। <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />अइसनेच स्वरग म तुम्हर ददा ह नइं चाहत हवय कि ये छोटे मन ले एको झन घलो नास होवंय।”<verse eid="MAT 18:14" /></para>
  <para style="s1">अपराधी भाई के संग बरताव</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“यदि तोर भाई ह तोर बिरोध म पाप करथे, त जा अऊ ओकर गलती ला बता, अऊ ये बात ह सिरिप तुमन दूनों के बीच म होवय। यदि ओह तोर बात ला मान लेथे, त तेंह अपन भाई ला वापिस पा लेय। <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />यदि ओह तोर बात ला नइं मानय, त अपन संग म एक या दू झन मनखे ला ले, ताकि दू या तीन झन के गवाही ले हर एक बात के पुस्टि करे जावय।<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 19:15">ब्यव 19:15</ref></char></char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />यदि ओह ओमन के बात ला घलो नइं सुनय, त ये बात कलीसिया ला बता दे, अऊ यदि ओह कलीसिया के बात ला घलो नइं सुनय, त तेंह ओला एक आनजात या एक लगान लेवइया के सहीं समझ।<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“मेंह तुमन ला सच कहत हंव कि जऊन कुछू तुमन धरती ऊपर बांधहू, ओह स्वरग म बंधाही, अऊ जऊन कुछू तुमन धरती ऊपर खोलहू, ओह स्वरग म खोले जाही।<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />“मेंह तुम्हर ले फेर सच-सच कहत हंव, यदि तुमन म ले दू झन मनखे एक मन होके धरती ऊपर कोनो बात बर पराथना करहू, त मोर ददा जऊन ह स्वरग म हवय, ओ काम ला तुम्हर बर कर दीही। <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />काबरकि जिहां दू या तीन मनखे मोर नांव म जूरथें, उहां मेंह ओमन के बीच म रहिथंव।”<note caller="+" style="f"><char style="fr" closed="false">18:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 16:19">मत्ती 16:19</ref></char></char></note><verse eid="MAT 18:20" /></para>
  <para style="s1">निरदयी सेवक के पटंतर</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />तब पतरस ह यीसू करा आईस अऊ पुछिस, “हे परभू, यदि मोर भाई ह मोर बिरोध म पाप करथे, त मेंह कतेक बार ओला छेमा करंव? का सात बार?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />यीसू ह ओला कहिस, “मेंह तोला नइं कहत हंव कि सात बार, पर सात बार के सत्तर गुना तक।<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />“एकरसेति, स्वरग के राज ह ओ राजा के सहीं अय, जऊन ह अपन सेवकमन ले हिसाब लेय बर चाहिस। <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />जब ओह हिसाब लेवन लगिस, त ओकर आघू म एक झन मनखे ला लाने गीस, जऊन ह ओकर दस हजार<note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="fq" closed="false">दस हजार </char><char style="fqa" closed="false">टेलेन्ट</char><char style="ft" closed="false">; एक टेलेन्ट ह लगभग बीस साल के कमई के बरोबर होथे</char></note> सोन ले भरे झोलामन के करजा लागत रिहिस। <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />काबरकि ओह करजा चुकाय नइं सकत रिहिस, एकरसेति मालिक ह हुकूम दीस कि ओला अऊ ओकर घरवाली ला अऊ ओकर लइकामन ला अऊ जऊन कुछू ओकर करा हवय, ओ जम्मो ला बेच दिये जावय अऊ करजा के चुकता करे जावय।<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />“येला सुनके ओ सेवक ह मालिक के आघू म अपन माड़ी के भार गिरिस अऊ बिनती करिस, ‘हे परभू, मोर ऊपर धीरज धर। मेंह तोर जम्मो करजा ला चुकता कर दूहूं।’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />तब ओ सेवक के मालिक ला ओकर ऊपर तरस आईस। ओह ओकर करजा ला माफ कर दीस अऊ ओला छोंड़ दीस।<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“पर जब ओ सेवक ह बाहिर निकलिस, त ओला ओकर एक संगी सेवक मिलिस, जेकर ऊपर ओकर एक सौ चांदी के सिक्का के करजा रिहिस। ओह ओला पकड़िस अऊ ओकर टोंटा ला दबाके कहिस, ‘तोर ऊपर मोर जऊन करजा हवय, ओला चुकता कर।’<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />“ओकर संगी सेवक ह अपन माड़ी के भार गिरके ओकर ले बिनती करिस, ‘मोला कुछू समय दे। मेंह तोर करजा ला चुकता कर दूहूं।’<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />“पर ओह नइं मानिस अऊ जाके ओ मनखे ला तब तक जेल म डलवा दीस, जब तक कि ओह करजा के चुकता नइं कर दीस। <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />जब आने सेवकमन ये जम्मो ला देखिन, त ओमन अब्बड़ उदास होईन, अऊ अपन मालिक करा जाके, ओमन जम्मो बात ला बता दीन।<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />“तब ओकर मालिक ह ओ सेवक ला बलाईस अऊ कहिस, ‘हे दुस्ट सेवक! मेंह तोर जम्मो करजा ला माफ करेंव, काबरकि तेंह मोर ले बिनती करय। <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />जइसने मेंह तोर ऊपर दया करे रहेंव, वइसने का तोला अपन संगी सेवक ऊपर दया नइं करना चाही?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />गुस्सा होके ओकर मालिक ह ओला सजा देवइयामन के हांथ म सऊंप दीस कि ओह तब तक ओमन के हांथ म रहय, जब तक कि ओह जम्मो करजा ला नइं पटा देवय।<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />“यदि तुमन अपन भाई ला अपन हिरदय ले छेमा नइं करहूं, त स्वरग म रहइया मोर ददा ह घलो तुमन म के हर एक के संग अइसनेच करही।”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">तलाक</para>
  <para style="r">(<ref loc="MRK 10:1-12">मरकुस 10:1‑12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />ये बातमन ला कहे के बाद, यीसू ह गलील प्रदेस ले चल दीस, अऊ यरदन नदी के ओ पार यहूदिया प्रदेस के इलाका म आईस। <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />मनखेमन के एक बड़े भीड़ ह ओकर पाछू हो लीस, अऊ यीसू ह उहां बिमरहामन ला चंगा करिस।<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />कुछू फरीसीमन यीसू ला परखे बर ओकर करा आईन अऊ ओमन यीसू ले पुछिन, “कहूं कोनो आदमी कोनो भी कारन ले अपन घरवाली ला तियाग देथे,<note caller="+" style="f"><char style="fr" closed="false">19:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">तलाक देथे</char></note> त का येह कानून के मुताबिक सही अय?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />यीसू ह जबाब दीस, “का तुमन परमेसर के बचन म नइं पढ़े हवव कि संसार के रचइया ह ओमन ला सुरूआत ले नर अऊ नारी करके बनाईस,<note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 1:27">उत 1:27</ref></char></char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />अऊ कहिस, ‘एकरे कारन मरद ह अपन दाई-ददा ले अलग होके अपन घरवाली संग मिले रहिही। अऊ ओ दूनों एक तन होहीं।’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />ओमन अब दू नइं, पर एक अंय। एकरसेति, जऊन ला परमेसर ह जोड़े हवय, ओला कोनो मनखे अलग झन करय।”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />ओमन यीसू ला कहिन, “त फेर मूसा ह ये हुकूम काबर देय हवय कि मनखे ह अपन घरवाली ला तियाग पतर देके ओला छोंड़ दे।”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />यीसू ह ओमन ला जबाब दीस, “तुम्हर हिरदय के कठोरता के कारन, मूसा ह तुमन ला अपन घरवाली ला तियागे के अनुमति दीस। पर सुरू ले अइसने नइं रिहिस। <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />मेंह तुमन ला कहत हंव कि जऊन मनखे ह बेभिचार के छोंड़ कोनो आने कारन ले अपन घरवाली ला छोंड़ देथे, अऊ आने माईलोगन ले बिहाव करथे, त ओह छिनारी करथे।”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />चेलामन यीसू ला कहिन, “यदि मनखे के संबंध ह अपन घरवाली के संग अइसने अय, तब बिहाव नइं करई ठीक अय।”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />यीसू ह ओमन ला कहिस, “जम्मो मनखे ये सिकछा ला माने नइं सकंय, पर सिरिप ओहीचमन मान सकथें, जऊन मन ला ये बरदान दिये गे हवय। <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />काबरकि कुछू हिजड़ामन हवंय, जऊन मन अपन दाई के पेट ले अइसने जनमे हवंय। कुछू झन ला मनखेमन हिजड़ा बना देय हवंय, पर कुछू मनखेमन स्वरग राज के खातिर बिहाव नइं करे हवंय। जऊन ह ये बात ला मान सकथे, ओला मानना चाही।”<verse eid="MAT 19:12" /></para>
  <para style="s1">यीसू अऊ छोटे लइकामन</para>
  <para style="r">(<ref loc="MRK 10:13-16">मरकुस 10:13‑16</ref>; <ref loc="LUK 18:15-17">लूका 18:15‑17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />तब मनखेमन लइकामन ला यीसू करा लानिन ताकि यीसू ह ओमन ऊपर अपन हांथ रखय अऊ ओमन बर पराथना करय। पर चेलामन मनखेमन ला डांटिन।<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />यीसू ह कहिस, “छोटे लइकामन ला मोर करा आवन दव, अऊ ओमन ला झन रोकव काबरकि स्वरग के राज ह अइसने मन बर अय।” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />अऊ ओह लइकामन ऊपर अपन हांथ रखिस अऊ उहां ले चल दीस।<verse eid="MAT 19:15" /></para>
  <para style="s1">एक धनी जवान अऊ परमेसर के राज</para>
  <para style="r">(<ref loc="MRK 10:17-31">मरकुस 10:17‑31</ref>; <ref loc="LUK 18:18-30">लूका 18:18‑30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />एक मनखे ह यीसू करा आईस अऊ पुछिस, “हे गुरू, मेंह का भलई के काम करंव कि मोला परमेसर के संग सदाकाल के जिनगी मिलय?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />यीसू ह ओला जबाब दीस, “तेंह मोर ले भलई के बारे म काबर पुछथस? सिरिप एके झन ह बने अय। यदि तेंह जिनगी म जाय चाहथस, त हुकूममन ला माने कर।”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />ओ मनखे ह पुछिस, “कोन हुकूममन ला?”</para>
  <para style="p" vid="MAT 19:18">यीसू ह जबाब दीस, “हतिया झन करव, छिनारी झन करव, चोरी झन करव, लबारी गवाही झन देवव, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />अपन दाई अऊ ददा के आदर करव, अऊ अपन परोसी ला अपन सहीं मया करव।”<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">लैव्य 19:18</ref></char></char></note><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />ओ जवान ह यीसू ला कहिस, “ये जम्मो बात ला मेंह मानत आवत हंव। तभो ले मोर म अऊ कोन बात के कमी हवय?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />यीसू ह ओला कहिस, “यदि तेंह सिद्ध बने चाहत हस, त जा, अपन जायदाद ला बेचके गरीबमन ला देय दे, अऊ तोला स्वरग म धन मिलही। तब आ अऊ मोर पाछू हो ले।”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />जब ये बात ला ओ जवान ह सुनिस, त ओह उदास होके उहां ले चल दीस, काबरकि ओकर मेर अब्बड़ संपत्ति रिहिस।<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />तब यीसू ह अपन चेलामन ला कहिस, “मेंह तुमन ला सच कहत हंव, धनवान मनखे के स्वरग राज म जवई कठिन अय। <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />मेंह तुमन ला फेर कहत हंव कि परमेसर के राज म धनवान मनखे के जाय के बनिस्पत सूजी के छेदा म ले ऊंट के निकल जवई सरल अय।”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />ये बात ला सुनके चेलामन अब्बड़ चकित होईन अऊ पुछिन, “त फेर कोन ह उद्धार पा सकथे?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />यीसू ह ओमन कोति देखिस अऊ कहिस, “ये बात ह मनखे के दुवारा संभव नो हय, पर परमेसर के दुवारा जम्मो बात ह संभव अय।”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />तब पतरस ह यीसू ला कहिस, “देख, हमन तो जम्मो कुछू ला छोंड़के तोर पाछू हो ले हवन। त हमन ला का मिलही?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />यीसू ह ओमन ला कहिस, “मेंह तुमन ला सच कहत हंव कि नवां संसार म, जब मनखे के बेटा ह महिमा के अपन सिंघासन म बईठही, त तुमन जऊन मन मोर पाछू चलत हव, बारह सिंघासन म बईठहू अऊ इसरायल के बारह गोत्र के नियाय करहू। <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />अऊ जऊन कोनो मोर खातिर अपन घर-दुवार या भाई या बहिनी या ददा या दाई या लइका या खेत-खार ला छोंड़ देय हवय, ओह सौ गुना पाही अऊ ओह सदाकाल के जिनगी के अधिकारी होही। <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />पर कतको झन जऊन मन अभी आघू म हवंय, ओमन आखिरी म हो जाहीं अऊ जऊन मन आखिरी म हवंय, ओमन आघू हो जाहीं।<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">अंगूर के बारी म बनिहारमन के पटंतर</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“स्वरग के राज ह ओ घर के मालिक सहीं अय, जऊन ह बड़े बिहनियां घर ले निकलिस ताकि अपन अंगूर के बारी म बनिहारमन ला काम म लगावय। <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />ओह बनिहारमन ला रोजी एक दीनार<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">एक दीनार ह एक दिन के बनी के बरोबर होथे।</char></note> देय बर तय करिस अऊ ओमन ला अपन अंगूर के बारी म पठोईस।<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />“करीब नौ बजे ओह बाहिर निकलिस अऊ कुछू अऊ बनिहारमन ला बजार के ठऊर म ठलहा खड़े देखिस, <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />त ओह ओमन ला कहिस, ‘तुमन घलो जावव अऊ मोर अंगूर के बारी म काम करव अऊ जऊन कुछू सही मजदूरी होही, मेंह तुमन ला दूहूं।’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />तब ओमन घलो गीन।</para>
  <para style="p" vid="MAT 20:5">“करीब बारह बजे अऊ तीन बजे दूसरइया घलो ओह फेर बाहिर निकलिस अऊ अइसनेच करिस। <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />ओह संझा करीब पांच बजे फेर बाहिर निकलिस अऊ उहां कुछू अऊ बनिहारमन ला ठाढ़े देखिस, त ओह ओमन ला कहिस, ‘तुमन काबर इहां दिन भर ले ठलहा ठाढ़े हवव?’<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />“ओमन जबाब दीन, ‘काबरकि कोनो हमन ला मजदूरी करे बर नइं ले गीस।’</para>
  <para style="p" vid="MAT 20:7">“ओह ओमन ला कहिस, ‘तुमन घलो जावव अऊ मोर अंगूर के बारी म काम करव।’<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />“जब सांझ होईस, त अंगूर के बारी के मालिक ह अपन संपत्ति के देखरेख करइया ला कहिस, ‘बनिहारमन ला बला अऊ आखिरी म अवइया बनिहारमन ले सुरू करके पहिली अवइया बनिहारमन तक जम्मो ला ओमन के बनी देय दे।’<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />“जऊन बनिहारमन संझा करीब पांच बजे काम म लगाय गे रिहिन, ओमन आईन अऊ ओमा के हर एक ला एक-एक दीनार मिलिस। <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />जऊन बनिहारमन पहिली काम म लगाय गे रिहिन, जब ओमन आईन, त सोचिन कि ओमन ला जादा मिलही। पर ओमन ला घलो एक-एक दीनार मिलिस। <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />जब ओमन ला बनी मिलिस, त ओमन मालिक ऊपर कुड़कुड़ाय लगिन <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />अऊ कहिन, ‘ये मनखेमन ला आखिरी म काम म लगाय गे रिहिस अऊ येमन सिरिप एक घंटा काम करे हवंय, तभो ले तेंह येमन ला हमर बरोबर बनी दे हवस। जबकि हमन दिन भर काम के भार उठायेंन अऊ घाम सहे हवन।’<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />“पर ओह ओमन के एक झन ला जबाब दीस, ‘संगी, मेंह तोर संग अनियाय नइं करत हवंव। का तेंह एक दीनार म काम करे बर राजी नइं होय रहय? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />अपन बनी ला ले अऊ जा। ये मोर ईछा अय कि आखिरी के मनखे ला घलो ओतकीच देवंव जतकी कि तोला दे हवंव। <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />का मोला ये अधिकार नइं अय कि अपन पईसा ला मेंह जइसने चाहंव वइसने करंव? या फेर मोर उदार हिरदय के कारन तोला जलन होवत हवय?’<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />“ए किसम ले जऊन मन आखिरी म हवंय, ओमन पहिली हो जाहीं अऊ जऊन मन पहिली हवंय, ओमन आखिरी म हो जाहीं।”<verse eid="MAT 20:16" /></para>
  <para style="s1">यीसू ह तीसर बार अपन मिरतू के अगमबानी करथे</para>
  <para style="r">(<ref loc="MRK 10:32-34">मरकुस 10:32‑34</ref>; <ref loc="LUK 18:31-34">लूका 18:31‑34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />यरूसलेम सहर ला जावत बेरा यीसू ह अपन बारह चेलामन ला अलग ले गीस अऊ ओमन ला कहिस, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“देखव, हमन यरूसलेम जावत हन अऊ उहां मनखे के बेटा ला पकड़के मुखिया पुरोहितमन अऊ कानून के गुरूमन के हांथ म सऊंपे जाही, अऊ ओमन ओला मार डारे के सजा दीहीं, <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />अऊ ओला आनजातमन के हांथ म सऊंप दीहीं, जऊन मन ओकर हंसी उड़ाहीं, ओला कोर्रा म मारहीं अऊ कुरूस ऊपर चघाहीं। पर तीसरा दिन ओह जी उठही।”<verse eid="MAT 20:19" /></para>
  <para style="s1">एक दाई के बिनती</para>
  <para style="r">(<ref loc="MRK 10:35-45">मरकुस 10:35‑45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />तब जबदी के बेटामन के दाई ह अपन बेटामन के संग यीसू करा आईस अऊ ओकर आघू म माड़ी टेकके कुछू मांगे लगिस।<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />यीसू ह ओकर ले पुछिस, “तेंह का चाहथस?”</para>
  <para style="p" vid="MAT 20:21">ओह कहिस, “तेंह हुकूम दे कि तोर राज म मोर ये दूनों बेटामन म ले एक झन तोर जेवनी कोति अऊ दूसर ह तोर डेरी कोति बईठे।”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />यीसू ह ओमन ला कहिस, “तुमन नइं जानत हव कि तुमन का मांगत हव। जऊन कटोरा म ले मेंह पीवइया हवंव, का तुमन ओला पी सकथव?”</para>
  <para style="p" vid="MAT 20:22">ओमन कहिन, “हमन पी सकथन।”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />यीसू ह ओमन ला कहिस, “तुमन मोर कटोरा ले पी सकथव, पर कोनो ला मोर जेवनी या डेरी कोति बईठाय के मोला अधिकार नइं ए। ये जगह ओमन के अय, जेमन बर मोर ददा ह येला तियार करे हवय।”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />जब आने दस चेलामन ये बात ला सुनिन, त ओमन ओ दूनों भाई ऊपर गुस्सा करिन। <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />यीसू ह ओमन ला एक संग अपन करा बलाईस अऊ कहिस, “तुमन जानथव कि आनजातमन के सासकमन ओमन ऊपर परभूता रखथंय अऊ ओमन के बड़े अधिकारीमन ओमन ऊपर अधिकार जताथंय। <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />तुमन के संग अइसने नइं होवय। पर जऊन ह तुमन म बड़े होय चाहथे, ओह तुम्हर सेवक बनय, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />अऊ जऊन ह तुमन म पहिली होय चाहथे, ओह तुम्हर गुलाम बनय। <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />जइसे कि मनखे के बेटा ह अपन सेवा करवाय बर नइं आईस, पर एकर खातिर आईस कि ओह आने मन के सेवा करय अऊ बहुंत झन के छुड़ौती बर अपन परान ला देवय।”<verse eid="MAT 20:28" /></para>
  <para style="s1">दू झन अंधरामन आंखी पाथें</para>
  <para style="r">(<ref loc="MRK 10:46-52">मरकुस 10:46‑52</ref>; <ref loc="LUK 18:35-43">लूका 18:35‑43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />जब यीसू अऊ ओकर चेलामन यरीहो सहर ले निकलत रिहिन, त एक बड़े भीड़ यीसू के पाछू हो लीस। <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />सड़क के तीर म दू झन अंधरा मनखे बईठे रिहिन, अऊ जब ओमन सुनिन कि यीसू ह ओ सड़क म जावत हवय, त ओमन चिचियाके कहिन, “हे परभू, दाऊद के संतान, हमर ऊपर दया कर।”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />भीड़ के मनखेमन ओमन ला दबकारिन अऊ ओमन ला चुपेचाप रहे बर कहिन, पर ओमन अऊ चिचियाके कहिन, “हे परभू, दाऊद के संतान, हमर ऊपर दया कर।”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />तब यीसू ह रूक गीस अऊ ओह ओमन ला बलाके पुछिस, “तुमन का चाहथव कि मेंह तुम्हर बर करंव?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />ओमन कहिन, “हे परभू, हमन चाहथन कि हमर आंखीमन देखे लगंय।”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />ओमन ऊपर तरस खाके यीसू ह ओमन के आंखीमन ला छुईस। तुरते ओमन देखन लगिन अऊ ओमन यीसू के पाछू हो लीन।<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">यीसू ह राजा के सहीं यरूसलेम म आथे</para>
  <para style="r">(<ref loc="MRK 11:1-11">मरकुस 11:1‑11</ref>; <ref loc="LUK 19:28-40">लूका 19:28‑40</ref>; <ref loc="JHN 12:12-19">यूहन्ना 12:12‑19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />जब ओमन यरूसलेम के लकठा म हबरिन अऊ जैतून पहाड़ के बैतफगे गांव करा आईन, त यीसू ह दू झन चेलामन ला ये कहिके पठोईस, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />“आघू के गांव म जावव। जइसने ही तुमन उहां हबरहू, तुमन ला एक ठन गदही बंधाय मिलही अऊ ओकर संग म ओकर बछेड़ा घलो होही। ओमन ला ढीलके मोर करा ले आवव। <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />यदि कोनो तुमन ला कुछू कहिथे, त ओला कहव कि परभू ला येमन के जरूरत हवय। तब ओह तुरते ओमन ला पठो दीही।”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />येह एकरसेति होईस ताकि अगमजानी के दुवारा कहे गय ये बात ह पूरा होवय:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“बेटी सियोन ले कहव,</para>
  <para style="q2" vid="MAT 21:5">‘देख, तोर राजा ह तोर करा आवत हवय।</para>
  <para style="q1" vid="MAT 21:5">ओह नम्र अय अऊ एक गदही ऊपर,</para>
  <para style="q2" vid="MAT 21:5">अऊ एक बछेड़ा ऊपर, गदही के एक बछेड़ा ऊपर सवारी करे हवय<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="fq" closed="false">बेटी सियोन </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">यरूसलेम सहर अय।</char></note>।’ ”<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 9:9">जकर 9:9</ref></char></char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />तब दूनों चेलामन गीन, अऊ जइसने यीसू ह ओमन ला करे बर कहे रिहिस, वइसनेच करिन। <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />ओमन गदही अऊ ओकर बछेड़ा ला लानिन अऊ ओमन के ऊपर अपन ओनहामन ला दसा दीन; तब यीसू ह ओमन ऊपर बईठ गीस। <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />भीड़ के बहुंत मनखेमन अपन ओनहा ला डहार म दसा दीन अऊ दूसर मनखेमन रूख के डारामन ला काटके डहार म दसा दीन। <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />भीड़ के मनखेमन यीसू के आघू-आघू अऊ पाछू-पाछू घलो चलत रहंय अऊ ओमन चिचिया-चिचियाके कहत रहंय,</para>
  <para style="q1" vid="MAT 21:9">“दाऊद के संतान के होसाना!”</para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">“धइन ए ओ, जऊन ह परभू के नांव म आथे!”<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:25-26">भजन 118:25‑26</ref></char></char></note></para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">“सबले ऊंच स्वरग म होसाना!<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="fq" closed="false">होसाना </char><char style="ft" closed="false">ये इबरानी सबद के मतलब होथे </char><char style="fqa" closed="false">बचा </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">उद्धार कर</char><char style="ft" closed="false">, पर बाद म ये सबद के उपयोग </char><char style="fqa" closed="false">परसंसा </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">इस्तुति </char><char style="ft" closed="false">के रूप म करे गीस।</char></note>”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />जब यीसू ह यरूसलेम म आईस, त जम्मो सहर म हलचल मच गीस अऊ मनखेमन पुछन लगिन, “येह कोन ए?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />भीड़ के मनखेमन कहिन, “येह अगमजानी यीसू ए, अऊ गलील प्रदेस के नासरत के रहइया ए।”<verse eid="MAT 21:11" /></para>
  <para style="s1">मंदिर म यीसू</para>
  <para style="r">(<ref loc="MRK 11:15-19">मरकुस 11:15‑19</ref>; <ref loc="LUK 19:45-48">लूका 19:45‑48</ref>; <ref loc="JHN 2:13-22">यूहन्ना 2:13‑22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />यीसू ह मंदिर म गीस, अऊ ओ जम्मो मनखेमन ला निकाल दीस, जऊन मन मंदिर म लेन-देन करत रिहिन। ओह रूपिया-पईसा के अदला-बदली करइयामन के मेज अऊ पंड़की बेचइयामन के बेंचमन ला खपल दीस। <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />अऊ ओह ओमन ला कहिस, “परमेसर के बचन म ये लिखे हवय कि मोर घर ह पराथना के घर कहे जाही, पर तुमन येला डाकूमन के अड्डा बनावत हवव।”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />अंधरा अऊ खोरवामन यीसू करा मंदिर म आईन अऊ ओह ओमन ला चंगा करिस। <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />पर जब मुखिया पुरोहित अऊ मूसा के कानून के गुरूमन ओकर अद्भूत काम ला देखिन अऊ लइकामन ला मंदिर के इलाका म चिचियाके ये कहत सुनिन, “दाऊद के संतान के होसाना,” त ओमन नराज होईन।<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />ओमन यीसू ला कहिन, “का तेंह सुनत हवस कि ये लइकामन का कहत हवंय?”</para>
  <para style="p" vid="MAT 21:16">यीसू ह कहिस, “हव, का तुमन परमेसर के बचन म ये कभू नइं पढ़ेव,</para>
  <para style="q1" vid="MAT 21:16">“ ‘लइका अऊ छोटे लइकामन के मुहूं ले</para>
  <para style="q2" vid="MAT 21:16">हे परभू, तें अपन इस्तुति करवाय।’<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 8:2">भजन 8:2</ref></char></char></note>”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />तब यीसू ह ओमन ला छोंड़के सहर के बाहिर बैतनियाह गांव म गीस अऊ उहां रात बिताईस।<verse eid="MAT 21:17" /></para>
  <para style="s1">यीसू ह अंजीर के रूख ला सराप देथे</para>
  <para style="r">(<ref loc="MRK 11:12-14">मरकुस 11:12‑14</ref>, <ref loc="MRK 11:20-24">20‑24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />बड़े बिहनियां, जब यीसू ह सहर ला वापिस जावत रिहिस, त ओला भूख लगिस। <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />सड़क के तीर म एक ठन अंजीर के रूख ला देखके, ओह उहां गीस, पर ओला पान के छोंड़ ओमा अऊ कुछू नइं मिलिस। तब यीसू ह ओ रूख ला कहिस, “अब ले तोर म फेर कभू फर झन लगय।” अऊ तुरते ओ अंजीर के रूख ह सूख गीस।<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />जब चेलामन येला देखिन, त ओमन अचम्भो करिन अऊ कहिन, “अंजीर के रूख ह तुरते कइसने सूख गीस?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />यीसू ह ओमन ला जबाब दीस, “मेंह तुमन ला सच कहत हंव, यदि तुमन बिसवास करव अऊ संका झन करव, त तुमन न सिरिप अइसने करहू, जइसने मेंह ये अंजीर के रूख के संग करे हवंव, पर यदि तुमन ये पहाड़ ले कहिहू, ‘जा अऊ समुंदर म गिर जा।’ अऊ येह हो जाही। <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />यदि तुमन बिसवास करथव, त जऊन कुछू तुमन पराथना म मांगव, ओह तुमन ला मिल जाही।”<verse eid="MAT 21:22" /></para>
  <para style="s1">यीसू के अधिकार ऊपर सवाल</para>
  <para style="r">(<ref loc="MRK 11:27-33">मरकुस 11:27‑33</ref>; <ref loc="LUK 20:1-8">लूका 20:1‑8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />यीसू ह मंदिर म गीस, अऊ जब ओह उपदेस देवत रिहिस, त मुखिया पुरोहितमन अऊ मनखेमन के अगुवामन ओकर करा आईन अऊ पुछिन, “तेंह कोन अधिकार ले ये चीजमन ला करत हवस? अऊ कोन ह तोला ये अधिकार दे हवय?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />यीसू ह ओमन ला जबाब दीस, “मेंह घलो तुमन ले एक सवाल पुछत हंव, यदि तुमन मोला जबाब दूहू, त मेंह घलो तुमन ला बताहूं कि कोन अधिकार ले मेंह ये काममन ला करत हवंव। <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />यूहन्ना के बतिसमा देवई ह कहां ले रिहिस? स्वरग ले रिहिस या मनखे कोति ले?”</para>
  <para style="p" vid="MAT 21:25">ओमन आपस म सोच-बिचार करिन अऊ कहिन, “यदि हमन कहन, ‘स्वरग ले’ त ओह कहिही, ‘तब तुमन ओकर ऊपर बिसवास काबर नइं करेव?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />पर यदि हमन कहन, ‘मनखे कोति ले,’ त हमन ला मनखेमन के डर हवय, काबरकि ओ जम्मो झन बिसवास करथें कि यूहन्ना ह एक अगमजानी रिहिस।”<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />एकरसेति ओमन यीसू ला जबाब दीन, “हमन नइं जानन।”</para>
  <para style="p" vid="MAT 21:27">तब यीसू ह ओमन ला कहिस, “त मेंह घलो नइं बतावंव कि कोन अधिकार ले मेंह ये काममन ला करत हवंव।<verse eid="MAT 21:27" /></para>
  <para style="s1">दू बेटामन के पटंतर</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“तुमन का सोचथव? एक मनखे रिहिस, जेकर दू झन बेटा रिहिन। ओह पहिला बेटा करा गीस अऊ कहिस, ‘बेटा, जा अऊ आज अंगूर के बारी म काम कर।’<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />“ओह जबाब दीस, ‘मेंह नइं जावंव।’ पर बाद म ओह पछताईस अऊ गीस।<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />“तब ददा ह दूसर बेटा करा गीस अऊ ओहीच बात कहिस। ओह जबाब दीस, ‘हव ददा, मेंह जावत हंव।’ पर ओह नइं गीस।<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />“ये दूनों बेटा म ले कोन ह अपन ददा के ईछा ला पूरा करिस?”</para>
  <para style="p" vid="MAT 21:31">ओमन कहिन, “पहिला ह।”</para>
  <para style="p" vid="MAT 21:31">यीसू ह ओमन ला कहिस, “मेंह तुमन ला सच कहत हंव कि लगान लेवइया अऊ बेस्यामन तुम्हर ले आघू परमेसर के राज म जावत हवंय। <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />काबरकि यूहन्ना ह तुमन ला धरमीपन के रसता देखाय बर आईस, अऊ तुमन ओकर ऊपर बिसवास नइं करेव, पर लगान लेवइया अऊ बेस्यामन ओकर ऊपर बिसवास करिन। येला देखे के बाद घलो, तुमन पछताप नइं करेव अऊ न ही ओकर ऊपर बिसवास करेव।<verse eid="MAT 21:32" /></para>
  <para style="s1">दुस्ट किसानमन के पटंतर</para>
  <para style="r">(<ref loc="MRK 12:1-12">मरकुस 12:1‑12</ref>; <ref loc="LUK 20:9-19">लूका 20:9‑19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />“एक अऊ पटंतर सुनव: एक जमींदार रिहिस, जऊन ह एक अंगूर के बारी लगाईस। ओह बारी के चारों खूंट बाड़ा बांधिस। ओह ओमा एक ठन रस के कुन्ड खनवाईस अऊ एक ठन मचान बनाईस। तब ओह ओ अंगूर के बारी ला कुछू किसानमन ला रेगहा म देके आने देस चल दीस। <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />जब फर के समय ह आईस, त ओह अपन सेवकमन ला किसानमन करा पठोईस ताकि ओमन ओकर बांटा के फर ला लानंय।<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />“पर किसानमन ओकर सेवकमन ला पकड़ लीन, अऊ ओमन कोनो ला मारिन-पीटिन, कोनो ला जान सहित मार डारिन अऊ काकरो ऊपर पथरा फेंकिन। <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />तब जमींदार ह आने सेवकमन ला पठोईस, जऊन मन संखिया म पहिली ले जादा रिहिन; पर किसानमन ओमन के संग घलो वइसनेच करिन। <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />आखिरी म, ओह ये सोचके अपन बेटा ला पठोईस कि ओमन मोर बेटा के आदर करहीं।<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />“पर जब किसानमन जमींदार के बेटा ला देखिन, त एक-दूसर ला कहिन, ‘येह तो अंगूर के बारी के वारिस ए। आवव, हमन येला मार डालन अऊ एकर संपत्ति ला ले लेवन।’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />ओमन ओला पकड़िन अऊ अंगूर के बारी के बाहिर फटिक दीन अऊ ओला मार डारिन।<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />“एकरसेति जब अंगूर के बारी के मालिक ह आही, त ओह ओ किसानमन के संग का करही?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />ओमन यीसू ला कहिन, “ओह ओ दुस्टमन ला पूरा नास कर दीही, अऊ अंगूर के बारी के रेगहा आने किसानमन ला दे दीही, जऊन मन समय म ओकर बांटा के फसल ओला दीहीं।”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />यीसू ह ओमन ला कहिस, “का तुमन पबितर बचन म कभू नइं पढ़ेव:</para>
  <para style="q1" vid="MAT 21:42">“ ‘जऊन पथरा ला घर के बनइयामन बेकार समझे रिहिन,</para>
  <para style="q2" vid="MAT 21:42">ओहीच ह कोना के मुख पथरा हो गीस।</para>
  <para style="q1" vid="MAT 21:42">येह परभू के दुवारा होईस,</para>
  <para style="q2" vid="MAT 21:42">अऊ येह हमर नजर म अद्भूत ए।’<note caller="+" style="f"><char style="fr" closed="false">21:42 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:22-23">भजन 118:22‑23</ref></char></char></note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“एकरसेति मेंह तुमन ला कहत हंव कि परमेसर के राज ह तुम्हर ले लेय लिये जाही, अऊ ओ मनखेमन ला दिये जाही, जऊन मन परमेसर बर फर पईदा करहीं। <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />जऊन ह ये पथरा ऊपर गिरही, ओह कुटा-कुटा हो जाही, पर जेकर ऊपर ये पथरा ह गिरही, ओह पीसा जाही।”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />यीसू के पटंतर ला सुनके मुखिया पुरोहित अऊ फरीसीमन समझ गीन कि ओह ओमन के बारे म गोठियावत हवय। <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />ओमन ओला पकड़े के उपाय सोचत रिहिन, पर ओमन मनखेमन के भीड़ ले डरावत रिहिन, काबरकि मनखेमन यीसू ला एक अगमजानी मानत रिहिन।<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">बिहाव भोज के पटंतर</para>
  <para style="r">(<ref loc="LUK 14:15-24">लूका 14:15‑24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />यीसू ह फेर ओमन ले पटंतर म गोठियाय लगिस। ओह कहिस, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“स्वरग के राज ह एक राजा के सहीं अय, जऊन ह अपन बेटा के बिहाव म एक जेवनार करिस। <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />ओह अपन सेवकमन ला पठोईस कि ओमन नेवताहारीमन ला भोज बर बलाके लानंय, पर नेवताहारीमन आय बर नइं चाहिन।<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />“तब फेर ओह कुछू अऊ सेवकमन ला ये कहिके पठोईस, ‘नेवताहारीमन ला कहव कि मेंह भोज तियार कर चुके हवंव। मोर बईला अऊ मोटहा-मोटहा पसुमन मारे गे हवंय, अऊ जम्मो चीज ह तियार हवय। बिहाव के भोज म आवव।’<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />“पर नेवताहारीमन राजा के नेवता ला धियान नइं दीन अऊ एती-ओती चल दीन—कोनो अपन खेत ला, त कोनो अपन धंधा म। <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />बाकि बचे नेवताहारीमन राजा के सेवकमन ला पकड़िन अऊ ओमन के संग गलत बरताव करिन अऊ ओमन ला मार डारिन। <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />राजा ह बहुंत गुस्सा करिस। ओह अपन सेना ला पठोईस अऊ ओ हतियारामन ला नास कर दीस अऊ ओमन के सहर ला जरा दीस।<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />“तब राजा ह अपन सेवकमन ला कहिस, ‘बिहाव भोज तो तियार हवय, पर नेवताहारीमन एकर लईक नो हंय। <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />एकरसेति गली के चऊक म जावव अऊ तुमन ला जऊन मन घलो मिलथें, ओ जम्मो ला बिहाव भोज के नेवता देवव।’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />ओ सेवकमन गलीमन म गीन अऊ ओमन ला बने या खराप जऊन ह घलो मिलिस, ओ जम्मो ला संकेलके ले आईन अऊ बिहाव के मड़वा ह पहुनामन ले भर गीस।<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />“पर जब राजा ह पहुनामन ला देखे बर भीतर आईस, त ओह उहां एक मनखे ला देखिस, जऊन ह बिहाव के पोसाक नइं पहिरे रहय। <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />राजा ह ओकर ले पुछिस, ‘संगी, बिहाव के पोसाक पहिरे बिगर तेंह इहां कइसने आ गे।’ ओ मनखे ह कुछू कहे नइं सकिस।<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />“तब राजा ह सेवकमन ला कहिस, ‘एकर हांथ-गोड़ ला बांधव अऊ येला बाहिर अंधियार म फटिक दव, जिहां येह रोही अऊ अपन दांत पीसही।’<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />“काबरकि बलाय गय मनखे तो बहुंत हवंय, पर चुने गय मनखेमन थोरकन हवंय।”<verse eid="MAT 22:14" /></para>
  <para style="s1">रोमी महाराज ला लगान देवई</para>
  <para style="r">(<ref loc="MRK 12:13-17">मरकुस 12:13‑17</ref>; <ref loc="LUK 20:20-26">लूका 20:20‑26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />तब फरीसीमन बाहिर जाके योजना बनाईन कि ओमन कइसने यीसू ला ओकरेच गोठ म फंसावंय। <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />ओमन अपन चेलामन ला हेरोदीमन के संग यीसू करा ये पुछे बर पठोईन, “हे गुरू, हमन जानत हवन कि तेंह सच्चा अस अऊ तेंह सच्चई के संग परमेसर के रसता के सिकछा देथस। तेंह मनखेमन के बहकावा म नइं आवस, काबरकि तेंह मनखे के मुहूं देखके नइं गोठियावस। <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />त हमन ला बता, तोर का बिचार हवय? रोमी महाराजा ला लगान देवई कानून के मुताबिक ठीक अय कि नइं?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />ओमन के दुस्टता ला जानके यीसू ह कहिस, “हे ढोंगी मनखेमन हो! तुमन काबर मोला फंसाय के कोसिस करत हव? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />मोला ओ सिक्का ला देखावव, जेकर उपयोग तुमन लगान पटाय बर करथव।” ओमन ओकर करा एक सिक्का लानिन। <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />यीसू ह ओमन ले पुछिस, “येमा काकर मूरती अऊ काकर नांव लिखाय हवय?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />ओमन कहिन, “महाराजा के।”</para>
  <para style="p" vid="MAT 22:21">तब यीसू ह ओमन ला कहिस, “जऊन ह महाराजा के अय, ओला महाराजा ला देवव अऊ जऊन ह परमेसर के अय, ओला परमेसर ला देवव।”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />येला सुनके, ओमन चकित हो गीन अऊ यीसू ला छोंड़के चल दीन।<verse eid="MAT 22:22" /></para>
  <para style="s1">मरे मनखेमन के जी उठई अऊ सादी-बिहाव</para>
  <para style="r">(<ref loc="MRK 12:18-27">मरकुस 12:18‑27</ref>; <ref loc="LUK 20:27-40">लूका 20:27‑40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />ओहीच दिन सदूकीमन यीसू करा आईन, जऊन मन ये कहिथंय कि मरे मनखेमन के जी उठई नइं होवय। ओमन यीसू ले पुछिन, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“हे गुरू, मूसा ह कहे हवय कि यदि कोनो मनखे ह बिगर संतान के मर जावय, त ओकर भाई ह ओ बिधवा ले बिहाव करय अऊ अपन भाई बर संतान पईदा करय<note caller="+" style="f"><char style="fr" closed="false">22:24 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 25:5-6">ब्यव 25:5‑6</ref></char></char></note>। <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />हमर बीच म सात झन भाई रिहिन। पहिला भाई ह बिहाव करिस, पर ओह बिगर संतान के मर गीस अऊ अपन घरवाली ला अपन भाई बर छोंड़ गीस। <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />दूसरा अऊ तीसरा भाई ले लेके जम्मो सातों भाई के संग अइसनेच होईस। सातों के सातों भाई मर गीन। <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />आखिरी म, ओ माईलोगन घलो मर गीस। <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />तब मरे मनखेमन के जी उठे के बाद, ओह ओ सातों भाई म के काकर घरवाली होही? काबरकि ओ सातों झन ओकर ले बिहाव करे रिहिन।”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />यीसू ह ओमन ला जबाब दीस, “तुमन गलत समझत हव, काबरकि तुमन परमेसर के बचन या परमेसर के सामर्थ ला नइं जानत हव। <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />मरे मनखेमन के जी उठे के बाद, मनखेमन न तो बिहाव करहीं अऊ न ही ओमन ला बिहाव म दिये जाही; ओमन स्वरग म स्वरगदूतमन सहीं होहीं। <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />मरे मनखेमन के जी उठे के बारे म परमेसर ह तुमन ला का कहे हवय—का तुमन नइं पढ़े हवव, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘मेंह अब्राहम के परमेसर, इसहाक के परमेसर अऊ याकूब के परमेसर अंव’? ओह मरे मन के नइं, पर जीयतमन के परमेसर अय।”<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />येला सुनके, भीड़ के मनखेमन यीसू के उपदेस ले चकित होईन।<verse eid="MAT 22:33" /></para>
  <para style="s1">सबले बड़े हुकूम</para>
  <para style="r">(<ref loc="MRK 12:28-34">मरकुस 12:28‑34</ref>; <ref loc="LUK 10:25-28">लूका 10:25‑28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />जब फरीसीमन सुनिन कि यीसू ह सदूकीमन के मुहूं बंद कर दे हवय, त ओमन जूरिन। <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />ओमा ले एक झन, जऊन ह कानून के एक जानकार रिहिस, यीसू ला परखे बर ये सवाल करिस, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“हे गुरू, मूसा के कानून के मुताबिक सबले बड़े हुकूम कते ह अय?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />यीसू ह ओला जबाब दीस: “ ‘परभू अपन परमेसर ले अपन पूरा हिरदय अऊ अपन पूरा परान अऊ अपन पूरा मन ले मया करव।’<note caller="+" style="f"><char style="fr" closed="false">22:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:5">ब्यव 6:5</ref></char></char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />येह पहिली अऊ सबले बड़े हुकूम अय। <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />अऊ दूसरा हुकूम ये किसम ले अय: ‘तेंह अपन परोसी ले अपन सहीं मया कर।’<note caller="+" style="f"><char style="fr" closed="false">22:39 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">लैव्य 19:18</ref></char></char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />ये दूनों हुकूम जम्मो कानून अऊ अगमजानीमन के सिकछा के सार अंय।”<verse eid="MAT 22:40" /></para>
  <para style="s1">मसीह ह काकर बेटा अय?</para>
  <para style="r">(<ref loc="MRK 12:35-37">मरकुस 12:35‑37</ref>; <ref loc="LUK 20:41-44">लूका 20:41‑44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />जब फरीसीमन उहां जूरे रिहिन, त यीसू ह ओमन ले पुछिस, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“मसीह के बारे म, तुमन का सोचथव? ओह काकर बेटा अय?”</para>
  <para style="p" vid="MAT 22:42">“ओमन कहिन,” “दाऊद के बेटा!”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />यीसू ह ओमन ला कहिस, “त फेर दाऊद ह पबितर आतमा म होके ओला ‘परभू’ काबर कहिथे? दाऊद ह कहिथे,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />“ ‘परभू ह मोर परभू ले कहिस:</para>
  <para style="q2" vid="MAT 22:44">“मोर जेवनी हांथ कोति बईठ,</para>
  <para style="q1" vid="MAT 22:44">जब तक कि मेंह तोर बईरीमन ला तोर</para>
  <para style="q2" vid="MAT 22:44">गोड़ खाल्हे नइं कर देवंव।” ’<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />जब दाऊद ह ओला परभू कहिथे, त फेर ओह दाऊद के बेटा कइसने हो सकथे?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />कोनो ओला कुछू जबाब नइं दे सकिन, अऊ ओ दिन ले, कोनो ओकर ले अऊ कुछू सवाल पुछे के हिम्मत नइं करिन।<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">ढोंगीपन के बिरूध चेतउनी</para>
  <para style="r">(<ref loc="MRK 12:38-39">मरकुस 12:38‑39</ref>; <ref loc="LUK 11:43">लूका 11:43</ref>, <ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-46">20:45‑46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />तब यीसू ह भीड़ के मनखे अऊ अपन चेलामन ला कहिस: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“मूसा के कानून के गुरू अऊ फरीसीमन मूसा के कानून ला सिखाथें। <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />एकरसेति, ओमन जऊन कुछू कहिथें ओला मानव अऊ करव। पर ओमन सहीं काम झन करव, काबरकि ओमन जइसने कहिथें वइसने नइं करंय। <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />ओमन कानून के भारी बोझा ला बांधथे, अऊ ओला मनखेमन के खांधा ऊपर लदक देथें, पर ओमन खुदे ओला टारे बर अपन अंगरी घलो उठाय नइं चाहंय।<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />“ओमन अपन जम्मो काम मनखेमन ला देखाय बर करथें। ओमन देखाय बर चाकर-चाकर ताबीज<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false">ताबीज याने एक किसम के डिब्बा, जऊन म परमेसर के बचन के पद रहिथे।</char></note> बनाके अपन बाहां अऊ माथा म पहिरथें अऊ अपन कपड़ा म लम्बा झालर लगवाथें। <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />जेवनारमन म आदर के ठऊर अऊ यहूदीमन के सभा-घर म सबले बने आसन म बईठई ओमन ला बने लगथे। <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />बजार के जगह म आदर के संग जोहार झोंकई अऊ मनखेमन के दुवारा गुरूजी कहई ओमन ला बने लगथे।<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />“पर तुमन अपन ला गुरू झन कहावव, काबरकि तुम्हर सिरिप एक गुरू हवय, अऊ तुमन जम्मो झन भाई-भाई अव। <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />धरती म कोनो ला अपन ददा झन कहव, काबरकि तुम्हर एके ददा हवय, जऊन ह स्वरग म हवय। <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />तुमन अपन ला मालिक घलो झन कहावव, काबरकि तुम्हर एके मालिक हवय याने कि मसीह। <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />जऊन ह तुमन जम्मो म बड़े अय, ओह तुम्हर सेवक बनय। <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />काबरकि जऊन ह अपनआप ला बड़े समझथे, ओला दीन-हीन करे जाही, अऊ जऊन ह अपनआप ला दीन-हीन करथे, ओला बड़े करे जाही।<verse eid="MAT 23:12" /></para>
  <para style="s1">कानून के गुरू अऊ फरीसीमन ऊपर सात ठन धिक्कार</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“हे ढोंगी, कानून के गुरू अऊ फरीसीमन, तुम्हर ऊपर धिक्कार! तुमन मनखेमन बर स्वरग राज के दुवारी ला बंद कर देथव। न तो तुमन खुदे ओमा जावव अऊ न ही ओमन ला जावन देवव, जऊन मन ओमा जाय के कोसिस करथें।<verse eid="MAT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14" />“हे ढोंगी, कानून के गुरू अऊ फरीसीमन, तुम्हर ऊपर हाय! तुमन बिधवामन के घर ला लूटथव अऊ देखाय बर लम्बा-लम्बा पराथना करथव। एकरसेति, तुमन ला जादा कठोर सजा मिलही।<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">कुछू पुराना हस्तलिपि म ये पद नइं मिलय।</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“हे ढोंगी, कानून के गुरू अऊ फरीसीमन, तुम्हर ऊपर धिक्कार! तुमन एक झन ला अपन यहूदी बिसवास म लाने बर समुंदर अऊ धरती ऊपर फिरथव, अऊ जब ओह तुम्हर बिसवास म आ जाथे, त तुमन ओला अपन ले दू गुना नरक के लइका सहीं बना देथव।<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />“हे अंधरा अगुवामन, तुम्हर ऊपर धिक्कार! तुमन कहिथव, ‘यदि कोनो मंदिर के कसम खाथे, त ओकर कुछू मतलब नइं होवय, पर यदि कोनो मंदिर के सोन के कसम खाथे, त ओह अपन कसम म बंध जाथे।’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />हे अंधरा मुरूख मनखेमन! कते ह बड़े अय—सोन या फेर मंदिर जऊन ह ओ सोन ला पबितर बनाथे?<note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 40:9-11">निर 40:9‑11</ref></char></char></note> <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />तुमन ये घलो कहिथव, ‘यदि कोनो बेदी के कसम खाथे, त ओकर कुछू मतलब नइं होवय, पर यदि कोनो बेदी म चघाय भेंट के कसम खाथे, त ओह अपन कसम म बंध जाथे।’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />हे अंधरा मनखेमन! कते ह बड़े अय—भेंट, या फेर बेदी जऊन ह ओ भेंट ला पबितर बनाथे? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />एकरसेति जऊन ह बेदी के कसम खाथे, ओह ओकर अऊ ओकर ऊपर रखे जम्मो चीज के कसम खाथे। <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />अऊ जऊन ह मंदिर के कसम खाथे, ओह ओकर अऊ ओमा रहइया के घलो कसम खाथे। <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />अऊ जऊन ह स्वरग के कसम खाथे, ओह परमेसर के सिंघासन अऊ ओकर ऊपर बईठइया के घलो कसम खाथे।<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“हे ढोंगी, कानून के गुरू अऊ फरीसीमन, तुम्हर ऊपर धिक्कार ए! तुमन अपन मसाला जइसने कि पोदीना, सौंफ अऊ जीरा के दसवां भाग ला देथव,<note caller="+" style="f"><char style="fr" closed="false">23:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 27:30">लैव्य 27:30</ref></char></char></note> पर तुमन मूसा के कानून के जादा महत्व के बात जइसने कि नियाय, दया अऊ बिसवास के अनदेखी करथव।<note caller="+" style="f"><char style="fr" closed="false">23:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">होसे 6:6</ref>; <ref loc="JER 9:23">यर 9:23</ref></char></char></note> तुम्हर बर उचित अय कि ये काममन ला करव अऊ ओ दूसर काम के अनदेखी घलो झन करव। <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />हे अंधरा अगुवामन! तुमन उड़इया छोटे कीरा ला तो छान लेथव, पर ऊंट ला लील लेथव।<note caller="+" style="f"><char style="fr" closed="false">23:24 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 11:20-23">लैव्य 11:20‑23</ref>, <ref loc="LEV 11:40">40</ref></char></char></note><verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“हे ढोंगी, कानून के गुरू अऊ फरीसीमन, तुम्हर ऊपर धिक्कार! तुमन कटोरा अऊ थाली के बाहिर ला तो मांजथव, पर भीतर ले, ओमन लोभ अऊ लूट-खसोट ले छीने गय चीजमन ले भरे हवंय। <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />हे अंधरा फरीसीमन हो! पहिली कटोरा अऊ थाली के भीतरी ला मांजव, तब ओमन के बाहिरी भाग घलो साफ होही।<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“हे ढोंगी, कानून के गुरू अऊ फरीसीमन, तुमन ला धिक्कार ए! तुमन चूना पोताय कबर के सहीं अव, जऊन ह बाहिर ले तो सुघर दिखथे, पर भीतर ह मुरदा मनखेमन के हाड़ा अऊ जम्मो असुध चीज ले भरे रहिथे। <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />ओही किसम ले, तुमन मनखेमन ला बाहिर ले धरमी दिखथव, पर भीतर ले तुमन ढोंग अऊ अधरम ले भरे हवव।<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“हे ढोंगी, कानून के गुरू अऊ फरीसीमन, तुम्हर ऊपर धिक्कार! तुमन अगमजानीमन के कबर ला बनाथव अऊ धरमीमन के कबर ला सजाथव, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />अऊ तुमन ये कहिथव, ‘यदि हमन अपन पुरखामन के जुग म होतेंन, त हमन अगमजानीमन के हतिया करई म ओमन संग भागी नइं होतेंन।’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />ये किसम ले, तुमन खुदे मान लेथव कि तुमन ओमन के संतान अव, जऊन मन अगमजानीमन ला मार डारिन। <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />तब तुमन अपन पुरखामन के छोंड़े पाप के घघरी ला भर देथव।<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />“हे सांपमन हो! हे जहरिला सांप के पीलामन हो! तुमन नरक के सजा ले कइसने बचहू? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />एकरसेति, मेंह तुम्हर करा अगमजानी, अऊ बुद्धिमान अऊ गुरूजी मन ला पठोवत हंव। ओमा ले कतेक झन ला तुमन मार डारहू अऊ कुरूस ऊपर चघाहू; कतेक झन ला तुमन अपन सभा-घर म कोर्रा म मारहू अऊ सहर-सहर म ओमन ला सताहू। <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />ये किसम ले, जम्मो धरमीमन के लहू, जऊन ह धरती ऊपर बोहाय हवय—धरमी हाबिल के लहू ले लेके बेरेकियाह के बेटा जकरयाह के लहू तक, जऊन ला तुमन मंदिर अऊ बेदी के बीच म मार डारेव; ये जम्मो के दोस तुम्हर ऊपर आही। <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />मेंह तुमन ला सच कहत हंव, ये जम्मो बात, ये पीढ़ी के मनखेमन ऊपर होही।<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“हे यरूसलेम सहर! हे यरूसलेम सहर! तेंह अगमजानीमन ला मार डारथस अऊ जेमन ला तोर करा पठोय जाथे, ओमन ला तेंह पथरा ले मारथस। मेंह कतेक बार चाहेंव कि तोर लइकामन ला वइसने संकेलंव, जइसने कुकरी ह अपन चियांमन ला अपन डेना खाल्हे संकेलथे, पर तेंह ये नइं चाहय। <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />देख, तोर घर ह उजाड़ पड़े हवय। <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />मेंह तोला कहत हंव कि तेंह मोला तब तक फेर नइं देख सकस, जब तक कि तेंह ये नइं कहस, ‘धइन ए ओह, जऊन ह परभू के नांव म आथे।’ ”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">जुग के अन्त के चिनहांमन</para>
  <para style="r">(<ref loc="MRK 13:1-2">मरकुस 13:1‑2</ref>; <ref loc="LUK 21:5-6">लूका 21:5‑6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />जब यीसू ह मंदिर म ले निकलके जावत रिहिस, त ओकर चेलामन ओकर करा आईन अऊ ओला मंदिर के बनावट ला देखाईन। <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />यीसू ह ओमन ला कहिस, “तुमन ये जम्मो चीज ला देखत हवव?” मेंह तुमन ला सच कहत हंव, “इहां एको ठन पथरा अपन जगह म नइं बांचय। जम्मो ला गिरा दिये जाही।”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />जब यीसू ह जैतून पहाड़ ऊपर बईठे रिहिस, त ओकर चेलामन अकेला ओकर करा आईन अऊ पुछिन, “हमन ला बता कि येह कब होही? तोर आय के समय अऊ ये जुग के अन्त के का चिनहां होही।”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />यीसू ह ओमन ला जबाब दीस, “सचेत रहव। कोनो तुमन ला धोखा झन देवय। <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />काबरकि कतको झन मोर नांव म आहीं अऊ कहिहीं, ‘मेंह मसीह अंव,’ अऊ बहुंते झन ला भरमाहीं <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />तुमन लड़ई अऊ लड़ई होय के अफवाह सुनहू, पर धियान रहय कि एकर ले तुमन झन घबरावव। अइसने बात के होवई जरूरी अय, पर ओ बखत अन्त नइं होवय। <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />एक देस ह दूसर देस ऊपर अऊ एक राज ह दूसर राज ऊपर चढ़ई करही। कतको जगह म दुकाल पड़ही अऊ भुइंडोल होही। <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />ये जम्मो ह छेवारी होय के पीरा के सुरूआत के सहीं अय।<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />“तब ओमन तुमन ला सताय बर पकड़वाहीं अऊ तुमन ला मार डारहीं। मोर कारन जम्मो जाति के मनखेमन तुम्हर ले घिन करहीं। <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />ओ समय कतको झन अपन बिसवास ला छोंड़ दीहीं। ओमन एक-दूसर के संग बिसवासघात करहीं अऊ एक-दूसर ले घिन करहीं। <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />अऊ कतको लबरा अगमजानीमन आहीं अऊ कतको झन ला धोखा दीहीं। <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />अधरम के बढ़े के कारन, बहुंत झन के मया ह कम हो जाही। <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />पर जऊन ह आखिरी तक अडिग बने रहिही, ओकरेच उद्धार होही। <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />परमेसर के राज के ये सुघर संदेस के परचार जम्मो संसार म करे जाही, ताकि जम्मो जाति के मनखेमन बर एक गवाही होवय, अऊ तब अन्त के बेरा आ जाही।<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“एकरसेति जब तुमन ‘ओ बिनासकारी घिन चीज’ ला पबितर स्थान म ठाढ़े देखव,<note caller="+" style="f"><char style="fr" closed="false">24:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="DAN 9:27">दानि 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></char></note> जेकर बारे म अगमजानी दानिएल ह कहे हवय, त पढ़इया ह समझ जावय। <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />तब जऊन मन यहूदिया प्रदेस म हवंय, ओमन पहाड़ ऊपर भाग जावंय। <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />जऊन ह अपन घर के छानी ऊपर होवय, ओह अपन घर के चीजमन ला लेय बर खाल्हे झन उतरय। <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />जऊन ह खेत म होवय, ओह अपन कपड़ा ला लेय बर पाछू झन लहुंटय। <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />ओ माईलोगनमन बर कतेक भयानक बात होही, जऊन मन ओ दिन म देहें म होहीं अऊ जऊन दाईमन लइकामन ला दूध पीयावत होहीं! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />पराथना करव कि तुमन ला जड़काला म या बिसराम के दिन म भागे ला झन पड़य। <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />काबरकि ओ समय अइसने भयंकर बिपत्ति आही, जइसने संसार के सुरू ले लेके अब तक न तो अइसने होय हवय अऊ न कभू फेर होही।<verse eid="MAT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 24:22" />“यदि ओ दिनमन ला कम नइं करे जातिस, त कोनो मनखे नइं बांचतिन; पर चुने गय मनखेमन के कारन, परमेसर ह ओ दिनमन ला कम कर दीही। <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />ओ बखत, कहूं कोनो तुमन ला ये कहय, ‘देखव, मसीह ह इहां हवय’ या ‘ओह उहां हवय।’ त बिसवास झन करव। <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />काबरकि लबरा मसीह अऊ लबरा अगमजानीमन परगट होहीं अऊ अइसने बड़े-बड़े चिनहां अऊ चमतकार देखाहीं कि कहूं हो सकय त चुने गय मनखेमन ला घलो भरमा देवंय। <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />देखव, मेंह तुमन ला पहिली ले बता चुके हवंव।<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />“एकरसेति, यदि ओमन तुमन ला ये कहंय, ‘देखव, मसीह ह उहां सुनसान जगह म हवय।’ त उहां झन जावव; या यदि ओमन कहंय, ‘मसीह ह इहां भीतर के खोली म हवय।’ त ओमन के बात ला बिसवास झन करव। <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />काबरकि जइसने बिजली ह पूरब ले निकलथे अऊ पछिम तक चमकथे, वइसने मनखे के बेटा के अवई होही। <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />जिहां लास होथे, उहां गिधवामन जूरथें।<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“ओ दिनमन म, बिपत पड़े के तुरते बाद,</para>
  <para style="q1" vid="MAT 24:29">“ ‘सूरज ह अंधियार हो जाही,</para>
  <para style="q2" vid="MAT 24:29">अऊ चंदा ह अपन अंजोर नइं दीही;</para>
  <para style="q1" vid="MAT 24:29">तारामन अकास ले गिर जाहीं,</para>
  <para style="q2" vid="MAT 24:29">अऊ अकास के सक्तिमन हलाय जाहीं।’<note caller="+" style="f"><char style="fr" closed="false">24:29 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 13:10">यसा 13:10</ref>; <ref loc="ISA 34:4">34:4</ref>; <ref loc="HAG 2:21">हाग्गै 2:21</ref></char></char></note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />“तब ओ समय, मनखे के बेटा के चिनहां ह अकास म दिखही अऊ धरती के जम्मो जाति के मनखेमन सोक मनाहीं। ओमन मनखे के बेटा ला सामर्थ अऊ बड़े महिमा के संग अकास के बादर म आवत देखहीं। <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />अऊ ओह तुरही के बड़े अवाज के संग अपन स्वरगदूतमन ला पठोही, अऊ ओमन अकास के एक छोर ले लेके दूसर छोर तक, चारों दिग के हवा ले ओकर चुने मनखेमन ला संकेलहीं।<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“अब अंजीर के रूख ले ये बात ला सीखव: जब एकर छोटे डारामन कोअंर बन जाथें अऊ ओमा पान निकले लगथें, त तुमन जान लेथव कि घाम के महिना ह अवइया हवय। <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />ओहीच किसम ले, जब तुमन ये जम्मो घटनामन ला देखव, त जान लेवव कि ओ समय ह लकठा म हवय, पर दुवारी म आ गे हवय। <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />मेंह तुमन ला सच कहत हंव कि जब तक ये जम्मो बातमन नइं हो जाहीं, तब तक ये पीढ़ी के मनखेमन नइं मरंय। <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />अकास अऊ धरती ह टर जाही, पर मोर बचन ह कभू नइं टरय।<verse eid="MAT 24:35" /></para>
  <para style="s1">दिन अऊ समय के जानकारी नइं अय</para>
  <para style="r">(<ref loc="MRK 13:32-37">मरकुस 13:32‑37</ref>; <ref loc="LUK 17:26-30">लूका 17:26‑30</ref>, <ref loc="LUK 17:34-36">34‑36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“ओ दिन या समय के बारे म कोनो नइं जानंय; न तो स्वरग के दूत अऊ न ही बेटा, पर सिरिप ददा ह येला जानथे। <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />जइसने नूह के समय म होय रिहिस, वइसनेच मनखे के बेटा के अवई के समय म घलो होही। <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />ओ समय जल-परलय होय के पहिली, नूह के पानी जहाज म चघे के दिन तक, मनखेमन खावत-पीयत रिहिन अऊ ओमन के बीच म सादी-बिहाव होवत रिहिस; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />जब तक जल-परलय नइं आईस अऊ ओ जम्मो ला बोहाके नइं ले गीस, तब तक ओमन कुछू नइं जानत रिहिन। वइसनेच मनखे के बेटा के अवई ह घलो होही। <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />ओ बखत दू झन मनखे खेत म होहीं; एक झन ला ले लिये जाही, अऊ दूसर ला छोंड़ दिये जाही। <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />दू झन माईलोगनमन जांता म पीसान पीसत होहीं; ओमा ले एक झन ला ले लिये जाही, अऊ दूसर ला छोंड़ दिये जाही।<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />“एकरसेति, सचेत रहव, काबरकि तुमन नइं जानव कि तुम्हर परभू ह कोन दिन आही। <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />पर ये बात ला समझ लेवव: यदि घर के मालिक ला मालूम होतिस कि चोर ह रात के कतेक बेरा आही, त ओह सचेत रहितिस अऊ अपन घर म सेंध नइं लगन देतिस। <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />एकरसेति तुमन घलो तियार रहव, काबरकि मनखे के बेटा ह ओ समय आ जाही, जब तुमन ओकर आय के आसा नइं करत होहू।<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“तब ओ बिसवासयोग्य अऊ बुद्धिमान सेवक कोन ए, जऊन ला मालिक ह अपन घर के आने सेवकमन ऊपर मुखिया ठहिराय हवय ताकि ओह ओमन ला सही समय म खाना देवय। <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />धइन अय ओ सेवक, जऊन ला ओकर मालिक ह लहुंटके आय के पाछू, अइसने करत पाथे। <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />मेंह तुमन ला सच कहत हंव कि मालिक ह ओ सेवक ला अपन जम्मो संपत्ति के जिम्मेदारी दे दीही। <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />पर यदि ओ सेवक ह दुस्ट अय अऊ अपन मन म ये कहय, ‘मोर मालिक के अवई म देरी हवय’, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />अऊ तब ओह अपन संगी सेवकमन ला मारन-पीटन लगय अऊ मतवारमन के संग खावय-पीयय, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />तब ओ सेवक के मालिक ह अइसने दिन म आ जाही, जब ओह ओकर आय के आसा नइं करत होही अऊ अइसने समय, जऊन ला ओह नइं जानत होही। <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />तब मालिक ह ओला सजा दीही, अऊ ओला ढोंगीमन के संग ठऊर दीही, जिहां ओह रोही अऊ अपन दांत पीसही।”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">दस कुंवारीमन के पटंतर</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“ओ समय स्वरग के राज ह ओ दस कुंवारीमन सहीं होही, जऊन मन अपन-अपन दीया ला लेके दूल्हा के संग भेंट करे बर गीन। <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />ओमन म पांच झन मुरूख अऊ पांच झन बुद्धिमान रिहिन। <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />मुरूख कुंवारीमन दीयामन ला तो लीन, पर अपन संग तेल नइं ले गीन। <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />पर बुद्धिमान कुंवारीमन अपन-अपन दीया के संग बोतल म तेल घलो ले गीन। <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />दूल्हा के आय म देरी होईस, त ओमन ला ऊंघासी आईस अऊ ओमन सुत गीन।<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />“आधा रथिया ये चिचियाय के अवाज आईस, ‘देखव, दूल्हा ह आवत हवय। ओकर संग भेंट करे बर आवव।’<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />“तब जम्मो कुंवारीमन जाग गीन अऊ अपन-अपन दीया ला ठीक करे लगिन। <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />मुरूख कुंवारीमन बुद्धिमान कुंवारीमन ला कहिन, ‘अपन तेल म ले थोरकन हमन ला घलो देवव, काबरकि हमर दीयामन बुतावत हवंय।’<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />“पर बुद्धिमान कुंवारीमन जबाब दीन, ‘सायद, हमर बर अऊ तुम्हर बर तेल ह नइं पूरही, एकरसेति तुमन तेल बेचइयामन करा जावव अऊ अपन बर तेल बिसा लेवव।’<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />“पर जब ओमन तेल बिसाय बर गे रिहिन, त दूल्हा ह आ गीस। जऊन कुंवारीमन तियार रिहिन, ओमन ओकर संग बिहाव के भोज म भीतर गीन। अऊ कपाट ह बंद हो गीस।<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />“बाद म ओ आने कुंवारीमन घलो आईन अऊ कहिन, ‘हे मालिक, हे मालिक! हमर बर कपाट ला खोल दे।’<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />“पर ओह जबाब दीस, ‘मेंह तुमन ला सच कहत हंव, मेंह तुमन ला नइं जानंव।’<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />“एकरसेति, सचेत रहव, काबरकि तुमन न तो ओ दिन ला जानत हव अऊ न ही ओ समय ला।”<verse eid="MAT 25:13" /></para>
  <para style="s1">सिक्कामन के पटंतर</para>
  <para style="r">(<ref loc="LUK 19:11-27">लूका 19:11‑27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“स्वरग के राज ह ओ मनखे के सहीं अय, जऊन ह परदेस जावत बेरा अपन सेवकमन ला बलाईस अऊ ओमन ला अपन संपत्ति सऊंप दीस। <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />हर एक ला ओह ओमन के योग्यता के मुताबिक दीस; एक सेवक ला ओह पांच सिक्का, दूसर ला दू सिक्का अऊ तीसरा ला एक सिक्का दीस।<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">एक </char><char style="fq" closed="false">सिक्का </char><char style="ft" closed="false">के मतलब इहां कतको </char><char style="fqa" closed="false">हजार रूपिया </char><char style="ft" closed="false">अय।</char></note> अऊ तब ओह परदेस चल दीस। <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />जऊन सेवक ला पांच सिक्का मिले रिहिस, ओह तुरते गीस अऊ ओ सिक्का ले लेन-देन करके पांच सिक्का अऊ कमा लीस। <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />वइसने जऊन सेवक ला दू सिक्का मिले रिहिस, ओह घलो दू सिक्का अऊ कमाईस। <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />पर जऊन सेवक ला एक ठन सिक्का मिले रिहिस, ओह गीस अऊ भुइयां ला खनके अपन मालिक के पईसा ला उहां लुका दीस।<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“बहुंत समय के बाद, ओ सेवकमन के मालिक ह लहुंटिस अऊ ओमन ले हिसाब मांगिस। <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />जऊन सेवक ला पांच सिक्का मिले रिहिस, ओह पांच सिक्का अऊ लेके आईस अऊ कहिस, ‘मालिक, तेंह मोला पांच सिक्का देय रहय। देख, मेंह पांच सिक्का अऊ कमाय हवंव।’<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />“ओकर मालिक ह ओला कहिस, ‘बहुंत अछा करय। तेंह बने अऊ ईमानदार सेवक अस। तेंह थोरकन म ईमानदार रहय। मेंह तोला बहुंत चीजमन ऊपर अधिकार दूहूं। आ अऊ अपन मालिक के खुसी म सामिल हो जा।’<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />“जऊन सेवक ला दू ठन सिक्का मिले रिहिस, ओह घलो आईस अऊ कहिस, ‘मालिक, तेंह मोला दू ठन सिक्का देय रहय। देख, मेंह दू ठन सिक्का अऊ कमाय हवंव।’<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />“ओकर मालिक ह ओला कहिस, ‘बहुंत अछा करय। तेंह बने अऊ ईमानदार सेवक अस। तेंह थोरकन म ईमानदार रहय। मेंह तोला बहुंत चीजमन ऊपर अधिकार दूहूं। आ अऊ अपन मालिक के खुसी म सामिल हो जा।’<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />“तब जऊन सेवक ला एक सिक्का मिले रिहिस, ओह आईस अऊ कहिस, ‘मालिक, मेंह जानत रहेंव कि तेंह एक कठोर मनखे अस। तेंह जिहां नइं बोए रहस, उहां ले लूथस, अऊ जिहां बीजा नइं बगराय रहस, उहां ले संकेलथस। <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />एकरसेति मेंह डरा गेंव अऊ बाहिर जाके मेंह तोर सिक्का ला भुइयां म गड़िया देंव; ये हवय तोर सिक्का।’<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />“ओकर मालिक ह ओला कहिस, ‘दुस्ट अऊ अलाल सेवक! जब तेंह जानत रहय कि जिहां मेंह नइं बोए रहंव, उहां ले लूथंव, अऊ जिहां बीजा नइं बगराय रहंव, उहां ले संकेलथंव। <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />त तोला मोर पईसा ला बैंक म जमा कर देना रिहिस, ताकि जब मेंह वापिस आयेंव, त ओला बियाज सहित ले लेतेंव।<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />“ ‘एकरसेति ये सिक्का ला एकर ले लेय लव, अऊ ओला दे दव, जेकर करा दस ठन सिक्का हवय। <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />काबरकि जेकर करा हवय, ओला अऊ दिये जाही अऊ ओकर करा बहुंत जादा हो जाही। पर जेकर करा नइं ए, ओकर करा ले ओला घलो ले लिये जाही, जऊन थोर बहुंत ओकर करा हवय। <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />ये बेकार सेवक ला बाहिर अंधियार म फटिक दव, जिहां ओह रोही अऊ अपन दांत पीसही।’ <verse eid="MAT 25:30" /></para>
  <para style="s1">भेड़ अऊ छेरीमन</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“जब मनखे के बेटा ह अपन महिमा म आही अऊ जम्मो स्वरगदूतमन ओकर संग आहीं, त ओह अपन महिमा के सिंघासन म बिराजही। <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />अऊ ओकर आघू म संसार के जम्मो मनखेमन ला लाने जाही। जइसने चरवाहा ह भेड़मन ला बोकरामन ले अलग करथे, वइसने ओह मनखेमन ला एक-दूसर ले अलग करही। <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />ओह भेड़मन ला अपन जेवनी अंग अऊ बोकरामन ला अपन डेरी अंग ठाढ़ करही।<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />“तब राजा ह अपन जेवनी अंग के मनखेमन ला कहिही, ‘तुमन मोर ददा के आसीसित मनखे अव। आवव, अऊ ओ राज के उत्तराधिकारी बन जावव, जऊन ला तुम्हर खातिर संसार के सिरजे के समय ले तियार करे गे हवय। <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />काबरकि मेंह भूखा रहेंव अऊ तुमन मोला खाना खवाएव; मेंह पीयासा रहेंव अऊ तुमन मोला पानी पीयाएव; मेंह परदेसी रहेंव अऊ तुमन मोला अपन घर म रखेव; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />मोर करा कपड़ा नइं रिहिस अऊ तुमन मोला कपड़ा पहिराएव; मेंह बेमार रहेंव अऊ तुमन मोर देखरेख करेव, मेंह जेल म रहेंव अऊ तुमन मोर ले मिले बर आयेव।’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />“तब धरमीमन ओला कहिहीं, ‘हे परभू, हमन कब तोला भूखा देखेंन अऊ खाना खवाएंन या कब पीयासा देखेंन अऊ तोला पानी पीयाएंन? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />हमन कब तोला एक परदेसी के रूप म देखेंन अऊ अपन घर म ठहिराएंन, या कब तोर करा कपड़ा नइं रिहिस अऊ हमन तोला कपड़ा पहिराएंन? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />हमन कब तोला बेमार या जेल म देखेंन अऊ तोर ले मिले बर आयेंन?’<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />“तब राजा ह ओमन ला ये जबाब दीही, ‘मेंह तुमन ला सच कहथंव कि जऊन कुछू तुमन मोर ये छोटे ले छोटे भाईमन के कोनो एक झन खातिर करेव, त तुमन ओ मोर बर करेव।<note caller="+" style="f"><char style="fr" closed="false">25:40 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 10:40-42">मत्ती 10:40‑42</ref></char></char></note>’<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“तब राजा ह अपन डेरी अंग के मनखेमन ला कहिही, ‘तुमन सरापित मनखे अव। मोर ले दूरिहा हटव अऊ ओ सदाकाल के आगी म चले जावव, जऊन ला सैतान अऊ ओकर दूतमन बर तियार करे गे हवय। <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />काबरकि मेंह भूखा रहेंव, अऊ तुमन मोला खाना नइं खवाएव; मेंह पीयासा रहेंव अऊ तुमन मोला पानी नइं पीयाएव। <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />मेंह परदेसी रहेंव अऊ तुमन मोला अपन घर म नइं रखेव; मोर करा कपड़ा नइं रिहिस अऊ तुमन मोला कपड़ा नइं पहिराएव; मेंह बेमार रहेंव अऊ जेल म रहेंव अऊ तुमन मोर देखरेख नइं करेव।’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />“तब ओमन कहिहीं, ‘हे परभू! हमन कब तोला भूखा या पीयासा या परदेसी या बिगर कपड़ा या बेमार या जेल म देखेंन अऊ तोर मदद नइं करेंन?’<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />“तब राजा ह ओमन ला ये जबाब दीही, ‘मेंह तुमन ला सच कहथंव कि जब भी तुमन ये छोटे मन के कोनो एक झन के मदद नइं करेव, त तुमन मोर घलो मदद नइं करेव।’<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />“तब ओमन सदाकाल के दंड भोगहीं, पर धरमीमन परमेसर के संग सदाकाल के जिनगी पाहीं।”<note caller="+" style="f"><char style="fr" closed="false">25:46 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 18:4-6">मत्ती 18:4‑6</ref></char></char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">यीसू के बिरोध म साजिस</para>
  <para style="r">(<ref loc="MRK 14:1-2">मरकुस 14:1‑2</ref>; <ref loc="LUK 22:1-2">लूका 22:1‑2</ref>; <ref loc="JHN 11:45-53">यूहन्ना 11:45‑53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />ये जम्मो बात ला कहे के बाद, यीसू ह चेलामन ला कहिस, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“जइसने कि तुमन जानत हव कि दू दिन के बाद फसह के तिहार मनाय जाही। तब कुरूस ऊपर चघाय बर मनखे के बेटा ह पकड़वाय जाही।”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />तब काइफा नांव के महा पुरोहित के महल म मुखिया पुरोहितमन अऊ मनखेमन के अगुवामन जूरिन। <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />अऊ ओमन ये बिचार करिन कि कइसने ओमन छल-कपट करके यीसू ला पकड़ंय अऊ ओला मार डारंय। <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />ओमन कहिन, “तिहार के समय नइं। कहूं अइसने झन होवय कि मनखेमन म दंगा हो जावय।”<verse eid="MAT 26:5" /></para>
  <para style="s1">बैतनियाह गांव म यीसू के अभिसेक</para>
  <para style="r">(<ref loc="MRK 14:3-9">मरकुस 14:3‑9</ref>; <ref loc="JHN 12:1-8">यूहन्ना 12:1‑8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />जब यीसू ह बैतनियाह गांव म सिमोन कोढ़ी के घर म रिहिस, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />त एक झन माईलोगन संगमरमर के बरतन म बहुंत मंहगा इतर तेल लेके आईस, अऊ जब यीसू ह खाना खावत रहय, त ओ माईलोगन ह यीसू के मुड़ ऊपर इतर ला ढार दीस।<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />येला देखके चेलामन नराज होईन अऊ कहिन, “येला काबर बरबाद करिस? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />ये इतर ला बने दाम म बेचके, ओ रूपिया ला गरीबमन म बांटे जा सकत रिहिस।”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />येला जानके यीसू ह ओमन ला कहिस, “तुमन ये माईलोगन ला काबर परेसान करत हवव? ओह मोर बर सुघर काम करे हवय। <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />गरीब मनखेमन तुम्हर संग हमेसा रहिहीं, पर मेंह तुम्हर संग हमेसा नइं रहंव। <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />ओह मोर देहें ऊपर जऊन इतर ढारिस, त ओह येला मोर गड़ियाय जाय के तियारी म करिस। <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />मेंह तुमन ला सच कहत हंव कि जम्मो संसार म जिहां-जिहां मोर सुघर संदेस के परचार करे जाही, उहां ओकर ये काम के चरचा घलो ओकर सुरता म करे जाही।”<verse eid="MAT 26:13" /></para>
  <para style="s1">यहूदा ह यीसू के संग बिसवासघात करथे</para>
  <para style="r">(<ref loc="MRK 14:10-11">मरकुस 14:10‑11</ref>; <ref loc="LUK 22:3-6">लूका 22:3‑6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />तब यहूदा इस्करियोती जऊन ह बारह चेलामन ले एक झन रिहिस, मुखिया पुरोहितमन करा गीस, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />अऊ ओमन ला कहिस, “यदि मेंह यीसू ला तुम्हर हांथ म पकड़वा दूहूं, त तुमन मोला का दूहू?” अऊ ओमन यहूदा ला चांदी के तीस ठन सिक्का दीन। <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />ओ समय ले यहूदा ह यीसू ला पकड़वाय बर मऊका खोजे लगिस।<verse eid="MAT 26:16" /></para>
  <para style="s1">परभू भोज या फसह तिहार के भोज</para>
  <para style="r">(<ref loc="MRK 14:12-21">मरकुस 14:12‑21</ref>; <ref loc="LUK 22:7-13">लूका 22:7‑13</ref>, <ref loc="LUK 22:21-23">21‑23</ref>; <ref loc="JHN 13:21-30">यूहन्ना 13:21‑30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />बिन खमीर के रोटी के तिहार के पहिली दिन चेलामन यीसू करा आईन अऊ पुछिन, “तेंह कहां चाहथस कि हमन जाके तोर बर फसह के भोज खाय के तियारी करन?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />यीसू ह कहिस, “सहर म ओ मनखे करा जावव अऊ ओला कहव, ‘गुरू ह कहिथे: मोर समय ह लकठा आ गे हवय। मेंह फसह के तिहार ला अपन चेलामन संग तोर घर म मनाय चाहथंव।’ ” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />जइसने यीसू ह हुकूम दे रिहिस, चेलामन वइसनेच करिन अऊ ओमन फसह तिहार के भोज तियार करिन।<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />जब सांझ होईस, त यीसू अपन बारह चेलामन संग खाना खाय बर बईठिस। <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />अऊ जब ओमन खावत रिहिन, त यीसू ह कहिस, “मेंह तुमन ला सच कहथंव, तुमन म ले एक झन मोर संग बिसवासघात करही।”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />येला सुनके चेलामन बहुंत उदास होईन अऊ एक-एक करके ओकर ले पुछन लगिन, “का ओह में अंव, परभू?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />यीसू ह जबाब दीस, “जऊन ह मोर संग कटोरा म अपन हांथ ला डारे हवय, ओहीच ह मोर संग बिसवासघात करही। <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />मनखे के बेटा ह मरही, जइसने ओकर बारे म परमेसर के बचन म लिखे हवय। पर धिक्कार ए, ओ मनखे ऊपर, जऊन ह मनखे के बेटा संग बिसवासघात करत हे। ओ मनखे बर बने होतिस, यदि ओकर जनम ही नइं होय रहितिस।”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />तब यहूदा जऊन ह यीसू के संग बिसवासघात करइया रिहिस, यीसू ले कहिस, “हे गुरू! का ओह में अंव?”</para>
  <para style="p" vid="MAT 26:25">यीसू ह ओला कहिस, “हव, ओ मनखे तेंह अस।”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />जब ओमन खावत रिहिन, तब यीसू ह रोटी ला लीस अऊ परमेसर ला धनबाद देके ओला टोरिस अऊ अपन चेलामन ला देके कहिस, “लेवव अऊ खावव; येह मोर देहें अय।”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />तब ओह कटोरा ला लीस अऊ परमेसर ला धनबाद दीस अऊ ओमन ला ये कहिके कटोरा ला दीस, “येमा ले तुमन जम्मो झन पीयव। <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />येह करार के मोर लहू ए, जऊन ह बहुंते जन बर पाप के छेमा खातिर ढारे जावत हे। <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />मेंह तुमन ला कहथंव कि मेंह ये अंगूर के मंद ला ओ दिन तक नइं पीयंव, जब तक कि मेंह तुम्हर संग मोर ददा के राज म नवां अंगूर के मंद ला नइं पी लंव।”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />तब ओमन एक भजन गाय के बाद, जैतून पहाड़ ऊपर चल दीन।<verse eid="MAT 26:30" /></para>
  <para style="s1">पतरस ह यीसू के इनकार करथे</para>
  <para style="r">(<ref loc="MRK 14:27-31">मरकुस 14:27‑31</ref>; <ref loc="LUK 22:31-34">लूका 22:31‑34</ref>; <ref loc="JHN 13:36-38">यूहन्ना 13:36‑38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />तब यीसू ह चेलामन ला कहिस, “आज रात के तुमन जम्मो झन मोला छोंड़के भाग जाहू, काबरकि परमेसर के बचन म ये लिखे हवय,</para>
  <para style="q1" vid="MAT 26:31">“ ‘मेंह चरवाहा ला मारहूं।</para>
  <para style="q2" vid="MAT 26:31">अऊ झुंड के भेड़मन तितिर-बितिर हो जाहीं।’<note caller="+" style="f"><char style="fr" closed="false">26:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 13:7">जकर 13:7</ref></char></char></note><verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />पर मेंह जी उठे के बाद, तुम्हर ले पहिली गलील प्रदेस जाहूं।”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />तब पतरस ह यीसू ला कहिस, “चाहे जम्मो झन तोला छोंड़के भाग जावंय त भाग जावंय, पर मेंह तोला कभू नइं छोड़ंव।”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />यीसू ह ओला जबाब दीस, “मेंह तोला सच कहथंव, आजेच रात के, कुकरा के बासे के पहिली तेंह तीन बार मोर इनकार करबे।”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />पर पतरस ह कहिस, “चाहे मोला तोर संग मरना घलो पड़य, तभो ले मेंह तोर कभू इनकार नइं करंव।” अऊ आने जम्मो चेलामन घलो अइसनेच कहिन।<verse eid="MAT 26:35" /></para>
  <para style="s1">गतसमनी म यीसू पराथना करथे</para>
  <para style="r">(<ref loc="MRK 14:32-42">मरकुस 14:32‑42</ref>; <ref loc="LUK 22:39-46">लूका 22:39‑46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />तब यीसू ह अपन चेलामन संग गतसमनी नांव के एक ठऊर म गीस अऊ ओह ओमन ला कहिस, “तुमन इहां बईठव, जब तक कि मेंह उहां जाके पराथना करथंव।” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />ओह पतरस अऊ जबदी के दू झन बेटा ला अपन संग म लीस, अऊ यीसू के मन ह दुखी अऊ बियाकुल होय लगिस। <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />तब ओह ओमन ला कहिस, “मोर परान ह अतकी उदास हवय कि मेंह मर जावंव सहीं लगत हवय। तुमन इहां ठहिरव अऊ मोर संग जागत रहव।”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />थोरकन आघू जाके, यीसू ह मुहूं के भार भुइयां म गिरिस अऊ ये पराथना करिस, “हे मोर ददा! कहूं हो सकय, त दुख के ये कटोरा ला मोर म ले टार दे। तभो ले मोर नइं, फेर तोर ईछा पूरा होवय।”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />तब ओह अपन चेलामन करा आईस अऊ ओमन ला सुतत देखिस, त ओह पतरस ला कहिस, “का तुमन मोर संग एक घंटा घलो नइं जाग सकव? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />जागत रहव अऊ पराथना करव, ताकि तुमन परिछा म झन पड़व। आतमा त तियार हवय, फेर देहें ह दुरबल अय।”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />यीसू ह दूसर बार गीस अऊ ये पराथना करिस, “हे मोर ददा! कहूं दुख के ये कटोरा ह मोर पीये बिगर नइं टर सकय, त फेर तोर ईछा पूरा होवय।”<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />जब यीसू ह वापिस आईस, त ओह अपन चेलामन ला फेर सुतत पाईस, काबरकि ओमन के आंखीमन नींद ले भारी हो गे रहंय। <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />एकरसेति ओह ओमन ला छोंड़के फेर एक बार गीस अऊ ओहीच बात ला कहिके, तीसरा बार पराथना करिस।<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />तब ओह चेलामन करा आईस अऊ ओमन ला कहिस, “का तुमन अभी तक ले सुतत हव अऊ सुरतावत हव? देखव, ओ घरी ह लकठा आ गे हवय, अऊ मनखे के बेटा ह पापीमन के हांथ म पकड़वाय जवइया हे। <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />उठव! आवव, हमन चलन! देखव, मोर संग बिसवासघात करइया ह लकठा आ गे हवय!”<verse eid="MAT 26:46" /></para>
  <para style="s1">यीसू ह पकड़वाय जाथे</para>
  <para style="r">(<ref loc="MRK 14:43-50">मरकुस 14:43‑50</ref>; <ref loc="LUK 22:47-53">लूका 22:47‑53</ref>; <ref loc="JHN 18:3-12">यूहन्ना 18:3‑12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />जब यीसू ह ये बात कहितेच रिहिस, तभे यहूदा जऊन ह बारह चेलामन ले एक झन रहय, आईस। ओकर संग म मनखेमन के एक बड़े भीड़ रहय अऊ मनखेमन तलवार अऊ लउठी धरे रहंय। येमन ला मुखिया पुरोहित अऊ मनखेमन के अगुवामन पठोय रिहिन। <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />बिसवासघात करइया ह ओमन ला पहिली ले ये संकेत बता दे रिहिस, “जऊन ला मेंह चूमहूं, ओहीच मनखे अय; ओला पकड़ लूहू।” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />यहूदा ह तुरते यीसू करा आईस अऊ कहिस, “हे गुरू, जोहार!” अऊ ओह यीसू ला चूमिस।<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />यीसू ह ओला कहिस, “संगवारी! जऊन काम बर तेंह आय हवस, ओला कर।”</para>
  <para style="p" vid="MAT 26:50">तब मनखेमन आघू म आईन अऊ यीसू ला पकड़के गिरफतार कर लीन। <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />तब यीसू के संगवारीमन ले एक झन तलवार ला खींचके निकालिस अऊ महा पुरोहित के सेवक ऊपर चलाके ओकर कान ला काट दीस।<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />यीसू ह ओला कहिस, “अपन तलवार ला मियान म रख, काबरकि जऊन मन तलवार चलाथें, ओमन तलवार ले मारे जाहीं। <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />का तेंह नइं जानस कि मेंह अपन ददा ले बिनती कर सकथंव अऊ ओह मोर बर तुरते स्वरगदूतमन के बारह ठन बड़े-बड़े सैनिक दल ले घलो जादा पठो दीही। <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />पर तब परमेसर के ओ बचन ह कइसे पूरा होही, जऊन ह ये कहिथे कि ये बात ला ये किसम ले होना जरूरी अय।”<note caller="+" style="f"><char style="fr" closed="false">26:54 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:12">यसा 53:12</ref></char></char></note><verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />ओतकीच बेरा यीसू ह मनखेमन के भीड़ ला कहिस, “का तुमन मोला डाकू समझथव कि तलवार अऊ लउठी लेके मोला पकड़े बर आय हवव? मेंह हर दिन मंदिर म बईठके उपदेस देवत रहेंव अऊ तुमन मोला नइं पकड़ेव। <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />पर ये जम्मो बात एकरसेति होईस कि अगमजानीमन के लिखे बचन ह पूरा होवय।” तब जम्मो चेलामन यीसू ला छोंड़के भाग गीन।<verse eid="MAT 26:56" /></para>
  <para style="s1">यीसू ह धरम महासभा के आघू म</para>
  <para style="r">(<ref loc="MRK 14:53-65">मरकुस 14:53‑65</ref>; <ref loc="LUK 22:54-55">लूका 22:54‑55</ref>, <ref loc="LUK 22:63-71">63‑71</ref>; <ref loc="JHN 18:13-14">यूहन्ना 18:13‑14</ref>, <ref loc="JHN 18:19-24">19‑24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />जऊन मन यीसू ला गिरफतार करे रिहिन, ओमन ओला महा पुरोहित काइफा करा ले गीन, जिहां कानून के गुरू अऊ अगुवामन जूरे रहंय। <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />पर पतरस ह कुछू दूरिहा म रहत ओकर पाछू-पाछू गीस। ओह महा पुरोहित के घर के अंगना तक गीस अऊ ये देखे बर कि का होवइया हे—ओह भीतर जाके पहरेदारमन के संग बईठ गीस।<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />मुखिया पुरोहितमन अऊ धरम महासभा के जम्मो मनखेमन यीसू के बिरूध म लबरा गवाही खोजत रहंय ताकि ओमन ओला मार डारंय। <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />पर ओमन ला एको झन नइं मिलिन, हालाकि कतको लबरा गवाहमन आईन।</para>
  <para style="p" vid="MAT 26:60">आखिर म दू झन गवाह आईन <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />अऊ कहिन, “ये मनखे ह कहे हवय, ‘मेंह परमेसर के मंदिर ला गिराके ओला तीन दिन म फेर बना सकत हंव।’ ”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />तब महा पुरोहित ह ठाढ़ होईस अऊ यीसू ला कहिस, “ये मनखेमन तोर बिरूध जऊन गवाही देवत हवंय, का तेंह ओकर कोनो जबाब नइं देवस?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />पर यीसू ह चुपेचाप रिहिस।</para>
  <para style="p" vid="MAT 26:63">महा पुरोहित ह यीसू ला कहिस, “मेंह तोला जीयत परमेसर के कसम देवत हंव: कहूं तेंह परमेसर के बेटा मसीह अस, त हमन ला बता।”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />यीसू ह ओला कहिस, “हव जी। जइसने कि तेंह कहय। पर मेंह तुमन जम्मो झन ला कहत हंव कि एकर बाद तुमन मनखे के बेटा ला सर्वसक्तिमान परमेसर के जेवनी हांथ कोति बईठे अऊ अकास के बादरमन ऊपर आवत देखहू।”<note caller="+" style="f"><char style="fr" closed="false">26:64 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="PSA 110:1">भजन 110:1</ref>; <ref loc="DAN 7:13">दानि 7:13</ref></char></char></note><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />तब महा पुरोहित ह अपन कपड़ा ला चीरिस अऊ कहिस, “येह परमेसर के निन्दा करे हवय। हमन ला अऊ कोनो गवाह के जरूरत नइं ए। देखव! अभीच तुमन ये निन्दा ला सुने हवव। <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />तुम्हर का बिचार हवय?”</para>
  <para style="p" vid="MAT 26:66">ओमन जबाब दीन, “येह मिरतू-दंड के लईक अय।”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />तब ओमन यीसू के मुहूं ऊपर थूकिन अऊ ओला मुक्का मारिन। आने मनखेमन ओला थपरा मारके कहिन, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />“हे मसीह, अगमबानी करके हमन ला बता कि तोला कोन मारिस?”<verse eid="MAT 26:68" /></para>
  <para style="s1">पतरस ह यीसू के इनकार करथे</para>
  <para style="r">(<ref loc="MRK 14:66-72">मरकुस 14:66‑72</ref>; <ref loc="LUK 22:56-62">लूका 22:56‑62</ref>; <ref loc="JHN 18:15-18">यूहन्ना 18:15‑18</ref>, <ref loc="JHN 18:25-27">25‑27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />ओ बखत पतरस ह बाहिर अंगना म बईठे रिहिस, तब एक नौकरानी छोकरी ओकर करा आईस अऊ कहिस, “तेंह घलो गलील के रहइया यीसू के संग रहय।”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />पर ओह ओ जम्मो झन के आघू म इनकार करिस अऊ कहिस, “मेंह नइं जानंव कि तेंह का कहत हवस?”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />तब पतरस ह बाहिर दुवारी करा गीस, उहां एक आने नौकरानी छोकरी ओला देखिस अऊ उहां मनखेमन ला कहिस, “ये मनखे ह नासरत के यीसू संग रिहिस।”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />पतरस ह कसम खाके फेर इनकार करिस अऊ कहिस, “मेंह ओ मनखे ला नइं जानंव।”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />एकर थोरकन देर बाद, जऊन मन उहां ठाढ़े रहंय, ओमन पतरस करा आईन अऊ कहिन, “सही म तेंह घलो ओमन ले एक झन अस, काबरकि तोर बोली ले, ये बात के पता चलत हे।”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />तब पतरस ह अपनआप ला कोसन लगिस अऊ किरिया खाके कहिस, “मेंह ओ मनखे ला नइं जानंव।”</para>
  <para style="p" vid="MAT 26:74">अऊ तुरते कुकरा ह बासिस। <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />तब पतरस ह यीसू के कहे ये बात ला सुरता करिस: “कुकरा बासे के पहिली, तेंह तीन बार मोर इनकार करबे।” अऊ ओह बाहिर गीस अऊ फूट-फूटके रोय लगिस।<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">यहूदा ह फांसी लगा लेथे</para>
  <para style="r">(<ref loc="ACT 1:18-19">प्रेरितमन के काम 1:18‑19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />जब बिहनियां होईस, त जम्मो मुखिया पुरोहित अऊ मनखेमन के अगुवामन यीसू ला मार डारे के फैसला करिन। <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />ओमन यीसू ला बांधिन अऊ ओला ले जाके राजपाल पीलातुस<note caller="+" style="f"><char style="fr" closed="false">27:2 </char><char style="ft" closed="false">पीलातुस ह रोमी राजपाल रिहिस।</char></note> के हांथ म सऊंप दीन।<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />यीसू के संग बिसवासघात करइया यहूदा ह जब देखिस कि यीसू ला दोसी ठहिराय गे हवय, त ओह पछताईस अऊ ओह मुखिया पुरोहित अऊ अगुवामन ला चांदी के तीस सिक्का वापिस कर दीस, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />अऊ कहिस, “मेंह पाप करे हवंव काबरकि मेंह एक निरदोस मनखे ला मरवाय बर ओकर संग बिसवासघात करेंव।”</para>
  <para style="p" vid="MAT 27:4">ओमन कहिन, “हमन ला एकर ले का मतलब! येला तें जान।”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />तब यहूदा ह ओ चांदी के सिक्कामन ला मंदिर म फटिक दीस अऊ उहां ले चले गीस अऊ जाके फांसी लगा लीस।<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />मुखिया पुरोहितमन ओ सिक्कामन ला उठाईन अऊ कहिन, “ये पईसा ला खजाना म रखना कानून के मुताबिक सही नो हय, काबरकि येह लहू के कीमत अय।” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />एकरसेति ओमन ओ पईसा ले कुम्हार के खेत ला बिसाय के फैसला करिन ताकि ओ जगह ह परदेसीमन बर मरघटी के रूप म काम आवय। <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />एकरे कारन, ओ खेत ला आज तक ले लहू के खेत कहे जाथे। <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />ये किसम ले यरमियाह अगमजानी के दुवारा कहे गय ये बचन ह पूरा होईस: “ओमन चांदी के तीस टुकड़ामन ला ले लीन, जऊन ला इसरायली मनखेमन ओकर कीमत ठहिराय रिहिन, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />अऊ ओमन ओ पईसा के उपयोग कुम्हार के खेत बिसाय म करिन जइसने परभू ह मोला हुकूम दे रिहिस।”<note caller="+" style="f"><char style="fr" closed="false">27:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 11:12-13">जकर 11:12‑13</ref>;</char> <char style="xt"><ref loc="JER 32:6-8">यर 32:6‑8</ref></char></char></note><verse eid="MAT 27:10" /></para>
  <para style="s1">यीसू ह रोमन राजपाल पीलातुस के आघू म</para>
  <para style="r">(<ref loc="MRK 15:2-5">मरकुस 15:2‑5</ref>; <ref loc="LUK 23:3-5">लूका 23:3‑5</ref>; <ref loc="JHN 18:33-38">यूहन्ना 18:33‑38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />जब यीसू ह राजपाल के आघू म ठाढ़ होईस, त राजपाल ह ओकर ले पुछिस, “का तेंह यहूदीमन के राजा अस?”</para>
  <para style="p" vid="MAT 27:11">यीसू ह ओला जबाब दीस, “हव जी, जइसने तेंह कहत हवस।”<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />जब मुखिया पुरोहित अऊ अगुवामन यीसू ऊपर दोस लगाईन, त ओह कुछू जबाब नइं दीस। <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />तब पीलातुस ह यीसू ला कहिस, “का तेंह नइं सुनत हवस कि ओमन तोर ऊपर कइसने दोस लगावत हवंय।” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />पर यीसू ह आरोप के जबाब म एको सबद नइं कहिस। जेकर ले राजपाल ला बहुंत अचरज होईस।<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />राजपाल के ये रिवाज रिहिस कि फसह तिहार के मऊका म, ओह एक झन कैदी ला छोंड़ देवय, जऊन ला मनखेमन चाहंय। <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />ओ समय म बरब्बा नांव के एक बदनाम कैदी जेल म रिहिस। <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />जब भीड़ ह जूरे रिहिस, त पीलातुस ह भीड़ के मनखेमन ले पुछिस, “तुमन कोन ला चाहत हव कि मेंह ओला तुम्हर बर छोंड़ देवंव—बरब्बा ला या यीसू ला, जऊन ला मसीह कहे जाथे?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />काबरकि पीलातुस ह जानत रिहिस कि ओमन जलन के कारन यीसू ला ओकर हांथ म सऊंपे रिहिन।<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />जब पीलातुस ह नियाय आसन म बईठे रिहिस, त ओकर घरवाली ह ओकर करा ये संदेस पठोईस, “ओ धरमी मनखे संग कुछू झन कर, काबरकि मेंह आज सपना म ओकर कारन बहुंत दुख उठाय हवंव।”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />पर मुखिया पुरोहित अऊ अगुवामन भीड़ के मनखेमन ला राजी कर लीन कि ओमन बरब्बा ला छोंड़े के अऊ यीसू ला मार डारे के मांग करंय।<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />राजपाल ह ओमन ला फेर पुछिस, “ये दूनों म ले तुमन कोन ला चाहथव कि मेंह तुम्हर खातिर छोंड़ देवंव?”</para>
  <para style="p" vid="MAT 27:21">ओमन कहिन, “बरब्बा ला।”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />पीलातुस ह ओमन ले पुछिस, “तब मेंह यीसू के का करंव, जऊन ला मसीह कहे जाथे।”</para>
  <para style="p" vid="MAT 27:22">ओ जम्मो झन जबाब दीन, “येला कुरूस ऊपर चघाय जावय।”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />पीलातुस ह पुछिस, “काबर? ओह का अपराध करे हवय?”</para>
  <para style="p" vid="MAT 27:23">पर ओमन अऊ जादा चिचियाके कहिन, “येला कुरूस ऊपर चघाय जावय।”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />जब पीलातुस ह देखिस कि ओकर दुवारा कुछू नइं हो सकत हे, पर हुल्लड़ होवत हवय, त ओह पानी लीस अऊ भीड़ के आघू म अपन हांथ ला धोके कहिस, “मेंह ये मनखे के मिरतू के दोसी नो हंव। एकर जिम्मेदार तुमन अव।”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />जम्मो मनखेमन जबाब दीन, “एकर मिरतू के दोस हमर अऊ हमर संतान ऊपर होवय।”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />तब पीलातुस ह ओमन खातिर बरब्बा ला छोंड़ दीस अऊ यीसू ला कोर्रा म पीटवाईस, अऊ ओला कुरूस ऊपर चघाय बर सऊंप दीस।<verse eid="MAT 27:26" /></para>
  <para style="s1">सैनिकमन यीसू के हंसी उड़ाथें</para>
  <para style="r">(<ref loc="MRK 15:16-20">मरकुस 15:16‑20</ref>; <ref loc="JHN 19:2-3">यूहन्ना 19:2‑3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />तब राजपाल के सैनिकमन यीसू ला राजपाल के महल म ले गीन अऊ सैनिकमन के पूरा दल ला यीसू करा संकेलिन। <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />ओमन यीसू के कपड़ा ला उतारिन अऊ ओला सिन्दूरी लाल रंग के चोगा पहिराईन, <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />अऊ तब कांटा के एक मुकुट गुंथके ओकर मुड़ ऊपर रखिन, अऊ ओकर जेवनी हांथ म एक ठन लउठी धरा दीन अऊ ओकर आघू म माड़ी टेकिन अऊ ये कहिके ओकर हंसी उड़ाईन, “हे यहूदीमन के राजा, तोला जोहार।” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />ओमन ओकर ऊपर थूकिन अऊ लउठी लेके ओकर मुड़ म मारे लगिन। <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />जब ओमन ओकर हंसी उड़ा चुकिन, त चोगा ला ओकर ऊपर ले उतारके ओला ओकरेच कपड़ा ला पहिराईन अऊ तब ओमन कुरूस ऊपर चघाय बर ओला बाहिर ले गीन।<verse eid="MAT 27:31" /></para>
  <para style="s1">यीसू के कुरूस ऊपर चघाय जवई</para>
  <para style="r">(<ref loc="MRK 15:21-32">मरकुस 15:21‑32</ref>; <ref loc="LUK 23:26-43">लूका 23:26‑43</ref>; <ref loc="JHN 19:17-27">यूहन्ना 19:17‑27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />जब ओमन सहर ले बाहिर निकलत रिहिन, त ओमन ला कुरेन<note caller="+" style="f"><char style="fr" closed="false">27:32 </char><char style="fq" closed="false">कुरेन </char><char style="ft" closed="false">ह आफ्रिका देस म एक सहर रिहिस।</char></note> के सिमोन नांव के एक झन मनखे मिलिस। ओमन ओकर ले जबरन कुरूस ला उठवाके ले गीन। <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />ओमन “गुलगुता” नांव के ठऊर म आईन (गुलगुता के मतलब होथे—खोपड़ी के ठऊर)। <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />उहां ओमन यीसू ला पित्त मिले अंगूर के मंद पीये बर दीन। यीसू ह ओला चिखिस, पर ओला पीये बर नइं चाहिस। <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />जब ओमन यीसू ला कुरूस ऊपर चघा लीन, त ओमन चिट्ठी डालके ओकर मुताबिक कपड़ा ला अपन म बांट लीन। <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />तब ओमन उहां बईठके ओकर पहरा देवन लगिन। <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />अऊ ओकर मुड़ ऊपर ओकर दोस-पतर टांग दीन, जऊन म ये लिखाय रहय—</para>
  <para style="pc" vid="MAT 27:37">येह यहूदीमन के राजा यीसू अय।<verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />ओ समय यीसू के संग दू झन डाकूमन घलो कुरूस ऊपर चघाय गे रिहिन, एक झन ओकर जेवनी कोति अऊ दूसर झन ओकर डेरी कोति। <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />उहां ले अवइया-जवइयामन यीसू के बेजत्ती करंय अऊ अपन मुड़ ला डोला-डोला के ये कहंय, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />“तेंह तो मंदिर ला गिराके ओला तीन दिन म बनइया अस, अपनआप ला बचा ले। कहूं तेंह परमेसर के बेटा अस, त फेर कुरूस ऊपर ले उतर आ।” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />अइसनेच मुखिया पुरोहित, कानून के गुरू अऊ अगुवामन घलो ये कहिके ओकर ठट्ठा करत रिहिन, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“येह आने मन ला बचाईस, पर येह अपनआप ला नइं बचा सकय! येह तो इसरायल के राजा अय! अब येह कुरूस ऊपर ले उतर आवय, त हमन एकर ऊपर बिसवास करबो। <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />येह परमेसर ऊपर भरोसा रखथे। यदि परमेसर येला चाहथे, त ओह येला छुड़ा ले, काबरकि येह कहे रिहिस, ‘मेंह परमेसर के बेटा अंव।’ ” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />अइसनेच ओ डाकूमन घलो जऊन मन ओकर संग कुरूस ऊपर चघाय गे रिहिन, ओकर ठट्ठा करिन।<verse eid="MAT 27:44" /></para>
  <para style="s1">यीसू के मिरतू</para>
  <para style="r">(<ref loc="MRK 15:33-41">मरकुस 15:33‑41</ref>; <ref loc="LUK 23:44-49">लूका 23:44‑49</ref>; <ref loc="JHN 19:28-30">यूहन्ना 19:28‑30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />ओ मंझनियां बारह बजे ले लेके तीन बजे तक जम्मो देस ऊपर अंधियार छाय रिहिस। <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />करीब तीन बजे यीसू ह जोर से नरियाके कहिस, <char style="tl">“एली, एली, लमा सबकतनी?”</char> (जेकर मतलब होथे, “हे मोर परमेसर, हे मोर परमेसर, तेंह मोला काबर छोंड़ देय?)”<note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:1">भजन 22:1</ref></char></char></note><verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />जब उहां ठाढ़े मनखेमन ले कुछू झन येला सुनिन, त ओमन कहिन, “येह एलियाह ला बलावत हवय।”<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />ओमन ले एक झन तुरते दऊड़के एक पनसोखवा रबर ला लानिस, अऊ ओह ओला सिरका म बोरिस अऊ एक ठन लउठी म रखके यीसू ला पीये बर दीस। <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />पर बाकि मनखेमन कहिन, “अब ओला रहन दे। आवव, हमन देखन, एलियाह ह येला बचाय बर आथे कि नइं।”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />अऊ यीसू ह फेर जोर से गोहार पारिस अऊ अपन परान ला तियाग दीस।<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />ओतकीच बेरा मंदिर के परदा ह ऊपर ले खाल्हे तक चीराके दू कुटा हो गीस। धरती ह कांप उठिस अऊ चट्टानमन तड़क गीन <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />अऊ कबरमन उघर गीन अऊ कतको मरे पबितर मनखे के देहेंमन फेर जी उठिन। <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />ओमन कबर म ले बाहिर निकलिन, अऊ यीसू के जी उठे के बाद, ओमन पबितर सहर म गीन अऊ कतको मनखेमन ला दिखिन।<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />जब सिपाहीमन के अधिकारी<note caller="+" style="f"><char style="fr" closed="false">27:54 </char><char style="ft" closed="false">एक सूबेदार के अधीन एक सौ सैनिक रहंय।</char></note> अऊ ओकर संग के सैनिक, जऊन मन यीसू के पहरा देवत रिहिन, भुइंडोल अऊ ओ जम्मो घटना ला देखिन, त अब्बड़ डरा गीन अऊ ओमन कहिन, “सही म येह परमेसर के बेटा रिहिस।”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />उहां कतको माईलोगन घलो रिहिन, जऊन मन दूरिहा ले यीसू ला देखत रिहिन। ओमन यीसू के सेवा करत गलील प्रदेस ले ओकर संगे-संग आय रिहिन। <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />ओमन म मरियम मगदलिनी, याकूब अऊ यूसुफ के दाई मरियम अऊ जबदी के बेटामन के दाई रिहिन।<verse eid="MAT 27:56" /></para>
  <para style="s1">यीसू के दफनाय जवई</para>
  <para style="r">(<ref loc="MRK 15:42-47">मरकुस 15:42‑47</ref>; <ref loc="LUK 23:50-56">लूका 23:50‑56</ref>; <ref loc="JHN 19:38-42">यूहन्ना 19:38‑42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />जब संझा होईस, त अरमतिया सहर ले एक धनवान मनखे आईस। ओकर नांव यूसुफ रिहिस अऊ ओह खुदे यीसू के चेला बन गे रिहिस। <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ओ बेरा ओह पीलातुस करा जाके यीसू के लास ला मांगिस अऊ पीलातुस ह यीसू के लास ला ओला सऊंप देय के हुकूम दीस। <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />यूसुफ ह लास ला लीस अऊ ओला एक ठन साफ मलमल के कपड़ा म लपेटिस, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />अऊ ओला अपन खुद के नवां कबर म रखिस, जऊन ला ओह चट्टान ला काटके बनवाय रिहिस। तब ओह एक ठन बड़े पथरा ला कबर के मुंहाटी म टेका दीस अऊ उहां ले चले गीस। <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />मरियम मगदलिनी अऊ दूसर मरियम उहां कबर के आघू म बईठे रिहिन।<verse eid="MAT 27:61" /></para>
  <para style="s1">कबर म पहरेदारी</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />ओकर दूसर दिन, जऊन ह तियारी के दिन के बाद के दिन रिहिस, मुखिया पुरोहित अऊ फरीसीमन पीलातुस करा जूरिन<note caller="+" style="f"><char style="fr" closed="false">27:62 </char><char style="ft" closed="false">बिसराम दिन के पहिली के दिन ला तियारी के दिन कहे जावय।</char></note> <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />अऊ कहिन, “महाराज, हमन ला सुरता हवय कि ओ धोखेबाज ह जब जीयत रिहिस, त कहे रिहिस, ‘तीन दिन के बाद मेंह फेर जी उठहूं।’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />एकरसेति हुकूम दे कि तीसरा दिन तक ओ कबर के रखवारी करे जावय। अइसने झन होवय कि ओकर चेलामन आवंय अऊ ओकर लास ला चोराके ले जावंय अऊ मनखेमन ला कहंय कि ओह मरे म ले जी उठे हवय। तब ये आखिरी धोखा ह पहिली ले घलो अऊ खराप होही।”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />पीलातुस ह ओमन ला कहिस, “तुम्हर करा पहरेदारमन हवंय। जावव, अऊ जइसने तुमन उचित समझथव, कबर के रखवारी के परबंध करव।” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />तब ओमन गीन अऊ कबर के पथरा ऊपर मुहर लगाईन अऊ उहां पहरेदार बईठाके ओमन कबर के रखवारी के परबंध करिन।<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">यीसू के फेर जी उठई</para>
  <para style="r">(<ref loc="MRK 16:1-10">मरकुस 16:1‑10</ref>; <ref loc="LUK 24:1-12">लूका 24:1‑12</ref>; <ref loc="JHN 20:1-10">यूहन्ना 20:1‑10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />बिसराम दिन के बाद, हप्ता के पहिली दिन बड़े बिहनियां मरियम मगदलिनी अऊ दूसर मरियम कबर ला देखे बर गीन।<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />ओ समय एक भयंकर भुइंडोल होईस, काबरकि परभू के एक स्वरगदूत ह स्वरग ले उतरिस अऊ कबर करा आईस अऊ पथरा ला ढुनगाके ओकर ऊपर बईठ गीस। <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />ओकर रूप ह बिजली सहीं चमकत रहय अऊ ओकर कपड़ा ह झक पंर्रा रिहिस। <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />पहरेदारमन ओकर ले डरके थर-थर कांपे लगिन अऊ मुरदा के सहीं हो गीन।<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />स्वरगदूत ह माईलोगनमन ला कहिस, “झन डरव, काबरकि मेंह जानत हंव कि तुमन यीसू ला खोजत हव, जऊन ला कुरूस ऊपर चघाय गे रिहिस। <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />ओह इहां नइं ए; ओह जी उठे हवय, जइसने ओह कहे रिहिस। आवव अऊ ओ ठऊर ला देखव, जिहां ओला रखे गे रिहिस। <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />अब तुमन तुरते जाके ओकर चेलामन ला ये बतावव: ‘ओह मरे म ले जी उठे हवय अऊ ओह तुम्हर ले आघू गलील प्रदेस जावत हवय। उहां तुमन ओला देखहू।’ देखव! मेंह तुमन ला बता दे हंव।”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />एकरसेति ओ माईलोगनमन जल्दी कबर ले चले गीन। ओमन डरा गे रिहिन, पर बड़े आनंद सहित चेलामन ला बताय बर दऊड़के गीन। <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />अचानक यीसू ह ओमन ले मिलिस अऊ कहिस, “खुस रहव।” ओमन ओकर करा आईन अऊ ओकर गोड़ ला धरके ओकर दंडवत करिन। <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />तब यीसू ह ओमन ला कहिस, “झन डरव। जावव अऊ मोर भाईमन ला कहव कि ओमन गलील प्रदेस जावंय। उहां ओमन मोला देखहीं।”<verse eid="MAT 28:10" /></para>
  <para style="s1">पहरेदारमन के सूचना</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />जब माईलोगनमन डहार म रिहिन, त कुछू पहरेदारमन सहर म गीन अऊ जऊन कुछू होय रिहिस, ओ जम्मो बात मुखिया पुरोहितमन ला बताईन। <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />तब मुखिया पुरोहितमन अगुवामन संग मिलके एक योजना बनाईन। ओमन सैनिकमन ला बहुंत अकन पईसा देके कहिन, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />“तुमन मनखेमन ला ये कहव, ‘जब हमन रथिया सुते रहेंन, त ओकर चेलामन आईन अऊ ओला चोराके ले गीन।’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />यदि ये बात राजपाल के कान म पड़ही, त हमन ओला समझा देबो अऊ तुमन ला मुसीबत ले बचा लेबो।” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />सैनिकमन पईसा ला लीन अऊ वइसने करिन, जइसने ओमन ला सिखाय गे रिहिस। अऊ ये बात यहूदीमन के बीच म आज तक फईले हवय।<verse eid="MAT 28:15" /></para>
  <para style="s1">महान हुकूम</para>
  <para style="r">(<ref loc="MRK 16:14-18">मरकुस 16:14‑18</ref>; <ref loc="LUK 24:36-49">लूका 24:36‑49</ref>; <ref loc="JHN 20:19-23">यूहन्ना 20:19‑23</ref>; <ref loc="ACT 1:6-8">प्रेरितमन के काम 1:6‑8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />तब गियारह चेलामन गलील प्रदेस के ओ पहाड़ ऊपर गीन, जिहां जाय बर यीसू ह ओमन ला कहे रिहिस। <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />अऊ जब ओमन यीसू ला देखिन, त ओला दंडवत करिन, पर कोनो-कोनो ला संका होईस। <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />तब यीसू ह ओमन करा आईस अऊ कहिस, “स्वरग अऊ धरती ऊपर मोला पूरा अधिकार देय गे हवय। <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />एकरसेति जावव अऊ जम्मो जाति के मनखेमन ला मोर चेला बनावव अऊ ओमन ला ददा, बेटा अऊ पबितर आतमा के नांव म बतिसमा देवव, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />अऊ ओमन ला ओ जम्मो बात मानना सिखोवव, जेकर हुकूम मेंह तुमन ला देय हवंव। अऊ देखव, मेंह संसार के अन्त होवत तक हमेसा तुम्हर संग हवंव।”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>