<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">गनती</para>
  <para style="toc1">गनती के किताब</para>
  <para style="toc2">गनती</para>
  <para style="toc3">गन</para>
  <para style="mt1">गनती</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="NUM 1"/>
  <para style="s1">इसरायलीमन के पहिली गनती</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1"/>इसरायलीमन के मिसर देस ले निकल जाय के दूसर बछर के दूसर महिना के पहिली दिन, यहोवा ह सीनय के निरजन जगह म, मिलापवाला तम्बू म मूसा ला कहिस: <verse eid="NUM 1:1"/><verse number="2" style="v" sid="NUM 1:2"/>“इसरायलीमन के जम्मो समाज ओमन के गोत्र अऊ परिवार के मुताबिक, हर एक पुरूस के गनती नांव लिख-लिखके कर। <verse eid="NUM 1:2"/><verse number="3" style="v" sid="NUM 1:3"/>जतेक इसरायली बीस साल या ओकर ले जादा उमर के हवंय अऊ ओमन सेना म सेवा देय के लईक हवंय, ओ जम्मो के गनती तें अऊ हारून ओमन के दल के मुताबिक करव। <verse eid="NUM 1:3"/><verse number="4" style="v" sid="NUM 1:4"/>हर एक गोत्र के एक-एक पुरूस, जऊन मन अपन परिवार के मुखिया अंय, ओमन तुम्हर मदद करंय।<verse eid="NUM 1:4"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="5" style="v" sid="NUM 1:5"/>“ये ओ पुरूसमन के नांव अय, जऊन मन तुम्हर मदद करहीं:</para>
  <para style="b" vid="NUM 1:5"/>
  <para style="li1" vid="NUM 1:5">“रूबेन के गोत्र ले सदेऊर के बेटा एलीसूर;<verse eid="NUM 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 1:6"/>सिमोन के गोत्र ले सूरीसद्दाय के बेटा सलूमीएल;<verse eid="NUM 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 1:7"/>यहूदा के गोत्र ले अमीनादाब के बेटा नहसोन;<verse eid="NUM 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 1:8"/>इस्साकार के गोत्र ले सूआर के बेटा नतनेल;<verse eid="NUM 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 1:9"/>जबूलून के गोत्र ले हेलोन के बेटा एलीआब;<verse eid="NUM 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 1:10"/>यूसुफ के बेटामन ले:</para>
  <para style="li2" vid="NUM 1:10">एपरैम के गोत्र ले अमीहूद के बेटा एलीसामा;</para>
  <para style="li2" vid="NUM 1:10">मनस्से के गोत्र ले पदासूर के बेटा गमलीएल;<verse eid="NUM 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 1:11"/>बिनयामीन के गोत्र ले गिदोनी के बेटा अबीदान;<verse eid="NUM 1:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 1:12"/>दान के गोत्र ले अम्मीसद्दाय के बेटा अहीएजेर;<verse eid="NUM 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 1:13"/>आसेर के गोत्र ले ओकरान के बेटा पगीएल;<verse eid="NUM 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 1:14"/>गाद के गोत्र ले दूएल के बेटा एलियासाप;<verse eid="NUM 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 1:15"/>नपताली के गोत्र ले एनान के बेटा अहीरा।”<verse eid="NUM 1:15"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="16" style="v" sid="NUM 1:16"/>येमन समाज के ओ मनखे रिहिन, जेमन ला अपन पुरखा के गोत्रमन ले अगुवा ठहिराय गीस। येमन इसरायल के गोत्रमन के मुखिया रिहिन।<verse eid="NUM 1:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17"/>जऊन मनखेमन के नांव ऊपर लिखे गे हवय, ओमन ला मूसा अऊ हारून अपन संग लीन, <verse eid="NUM 1:17"/><verse number="18" style="v" sid="NUM 1:18"/>अऊ ओमन ओ साल के दूसरा महिना के पहिला दिन पूरा समाज ला इकट्ठा करिन। मनखेमन अपन गोत्र अऊ परिवार के मुताबिक अपन बंसावली लिखवाईन, अऊ जतेक झन बीस साल या बीस साल ले जादा उमर के रिहिन, ओमन के नांव एक-एक करके लिखे गीस, <verse eid="NUM 1:18"/><verse number="19" style="v" sid="NUM 1:19"/>जइसे कि यहोवा ह मूसा ला हुकूम दे रिहिस। ये किसम ले ओह सीनय के सुनसान जगह म ओमन के गनती करिस:<verse eid="NUM 1:19"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 1:20"/>इसरायल के बेटा रूबेन के बंस ले:</para>
  <para style="li2" vid="NUM 1:20">जतेक पुरूस बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा दे सकत रिहिन, ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक एक-एक करके लिखे गीस। <verse eid="NUM 1:20"/><verse number="21" style="v" sid="NUM 1:21"/>रूबेन के गोत्र के गनती 46,500 होईस।<verse eid="NUM 1:21"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 1:22"/>सिमोन के बंस ले:</para>
  <para style="li2" vid="NUM 1:22">ओ जम्मो पुरूस, जऊन मन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा देय के लईक रिहिन, ओमन के गनती करे गीस अऊ ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक एक-एक करके लिखे गीस। <verse eid="NUM 1:22"/><verse number="23" style="v" sid="NUM 1:23"/>सिमोन के गोत्र के गनती 59,300 होईस।<verse eid="NUM 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 1:24"/>गाद के बंस ले:</para>
  <para style="li2" vid="NUM 1:24">ओ जम्मो पुरूस, जऊन मन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा देय के लईक रिहिन, ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक लिखे गीस। <verse eid="NUM 1:24"/><verse number="25" style="v" sid="NUM 1:25"/>गाद के गोत्र के गनती 45,650 होईस।<verse eid="NUM 1:25"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 1:26"/>यहूदा के बंस ले:</para>
  <para style="li2" vid="NUM 1:26">ओ जम्मो पुरूस, जऊन मन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा देय के लईक रिहिन, ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक लिखे गीस। <verse eid="NUM 1:26"/><verse number="27" style="v" sid="NUM 1:27"/>यहूदा के गोत्र के गनती 74,600 होईस।<verse eid="NUM 1:27"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 1:28"/>इस्साकार के बंस ले:</para>
  <para style="li2" vid="NUM 1:28">ओ जम्मो मनखे, जऊन मन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा देय के लईक रिहिन, ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक लिखे गीस। <verse eid="NUM 1:28"/><verse number="29" style="v" sid="NUM 1:29"/>इस्साकार के गोत्र के गनती 54,400 होईस।<verse eid="NUM 1:29"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 1:30"/>जबूलून के बंस ले:</para>
  <para style="li2" vid="NUM 1:30">ओ जम्मो पुरूस, जऊन मन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा देय के लईक रिहिन, ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक लिखे गीस। <verse eid="NUM 1:30"/><verse number="31" style="v" sid="NUM 1:31"/>जबूलून के गोत्र के गनती 57,400 होईस।<verse eid="NUM 1:31"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="32" style="v" sid="NUM 1:32"/>यूसुफ के बेटामन ले:</para>
  <para style="li1" vid="NUM 1:32">एपरैम के बंस ले:</para>
  <para style="li2" vid="NUM 1:32">ओ जम्मो पुरूस, जऊन मन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा देय के लईक रिहिन, ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक लिखे गीस। <verse eid="NUM 1:32"/><verse number="33" style="v" sid="NUM 1:33"/>एपरैम के गोत्र के गनती 40,500 होईस।<verse eid="NUM 1:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 1:34"/>मनस्से के बंस ले:</para>
  <para style="li2" vid="NUM 1:34">ओ जम्मो पुरूस, जऊन मन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा देय के लईक रिहिन, ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक लिखे गीस। <verse eid="NUM 1:34"/><verse number="35" style="v" sid="NUM 1:35"/>मनस्से के गोत्र के गनती 32,200 होईस।<verse eid="NUM 1:35"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="36" style="v" sid="NUM 1:36"/>बिनयामीन के बंस ले:</para>
  <para style="li2" vid="NUM 1:36">ओ जम्मो पुरूस, जऊन मन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा देय के लईक रिहिन, ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक लिखे गीस। <verse eid="NUM 1:36"/><verse number="37" style="v" sid="NUM 1:37"/>बिनयामीन के गोत्र के गनती 35,400 होईस।<verse eid="NUM 1:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 1:38"/>दान के बंस ले:</para>
  <para style="li2" vid="NUM 1:38">ओ जम्मो पुरूस, जऊन मन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा देय के लईक रिहिन, ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक लिखे गीस। <verse eid="NUM 1:38"/><verse number="39" style="v" sid="NUM 1:39"/>दान के गोत्र के गनती 62,700 होईस।<verse eid="NUM 1:39"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 1:40"/>आसेर के बंस ले:</para>
  <para style="li2" vid="NUM 1:40">ओ जम्मो पुरूस, जऊन मन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा देय के लईक रिहिन, ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक लिखे गीस। <verse eid="NUM 1:40"/><verse number="41" style="v" sid="NUM 1:41"/>आसेर के गोत्र के गनती 41,500 होईस।<verse eid="NUM 1:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 1:42"/>नपताली के बंस ले:</para>
  <para style="li2" vid="NUM 1:42">ओ जम्मो पुरूस, जऊन मन बीस साल या बीस साल ले जादा उमर के रिहिन अऊ सेना म सेवा देय के लईक रिहिन, ओमन के नांव ओमन के गोत्र अऊ परिवार के मुताबिक लिखे गीस। <verse eid="NUM 1:42"/><verse number="43" style="v" sid="NUM 1:43"/>नपताली के गोत्र के गनती 53,400 होईस।<verse eid="NUM 1:43"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="44" style="v" sid="NUM 1:44"/>मूसा अऊ हारून अऊ इसरायल के बारह अगुवा, जेमन अपन-अपन परिवार के मुखिया घलो रिहिन, येमन के गनती करिन। <verse eid="NUM 1:44"/><verse number="45" style="v" sid="NUM 1:45"/>जम्मो इसरायली, जऊन मन बीस साल ले जादा उमर के रिहिन अऊ इसरायली सेना म सेवा देय के लईक रिहिन, ओमन के गनती परिवार के मुताबिक होईस। <verse eid="NUM 1:45"/><verse number="46" style="v" sid="NUM 1:46"/>कुल गनती 6,03,550 होईस।<verse eid="NUM 1:46"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47"/>पर लेवीमन के पुरखा के गोत्र ला आने मन के संग नइं गने गीस। <verse eid="NUM 1:47"/><verse number="48" style="v" sid="NUM 1:48"/>यहोवा ह मूसा ला कहे रिहिस: <verse eid="NUM 1:48"/><verse number="49" style="v" sid="NUM 1:49"/>“लेवी गोत्र ला झन गनबे या ओमन ला आने इसरायलीमन संग गनती म सामिल झन करबे। <verse eid="NUM 1:49"/><verse number="50" style="v" sid="NUM 1:50"/>पर लेवीमन ला करार के कानून के पबितर-तम्बू म अधिकारी ठहिराबे—ओकर जम्मो सजावट अऊ ओमा के जम्मो चीज ऊपर अधिकारी ठहिराबे। ओमन पबितर-तम्बू अऊ ओमा के जम्मो चीज ला उठावंय; ओमन ओकर देखभाल करंय अऊ ओकर चारों कोति डेरा डाले रहंय। <verse eid="NUM 1:50"/><verse number="51" style="v" sid="NUM 1:51"/>जब भी पबितर-तम्बू ला आने जगह ले जाय के समय होवय, त लेवीमन ओला उसालंय, अऊ जब भी पबितर-तम्बू ला गाड़े के समय होवय, त लेवीमन ही ओला गाड़ंय। यदि कोनो आने मनखे येकर लकठा म आवय, त ओह मार डारे जावय। <verse eid="NUM 1:51"/><verse number="52" style="v" sid="NUM 1:52"/>इसरायलीमन दल के मुताबिक अपन तम्बूमन ला गाड़ंय, हर एक जन अपन झंडा के अधीन अपन सिविर म तम्बू गाड़ंय। <verse eid="NUM 1:52"/><verse number="53" style="v" sid="NUM 1:53"/>पर लेवीमन करार के कानून के पबितर-तम्बू के चारों कोति अपन तम्बू गाड़ंय ताकि मोर कोप ह इसरायली समाज ऊपर झन भड़कय। लेवीमन करार के कानून के पबितर-तम्बू के देखभाल बर जिम्मेदार अंय।”<verse eid="NUM 1:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54"/>इसरायलीमन जम्मो चीज वइसने ही करिन, जइसने यहोवा ह मूसा ला हुकूम दे रिहिस।<verse eid="NUM 1:54"/></para>
  <chapter eid="NUM 1"/>
  <chapter number="2" style="c" sid="NUM 2"/>
  <para style="s1">इसरायलीमन के सिविर ब्यवस्था</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1"/>यहोवा ह मूसा अऊ हारून ला कहिस: <verse eid="NUM 2:1"/><verse number="2" style="v" sid="NUM 2:2"/>“इसरायलीमन मिलापवाला तम्बू के थोरकन दूरिहा म ओकर चारों कोति डेरा डालंय, हर एक जन अपन दल के अधीन अऊ अपन परिवार के झंडा धरे डेरा डालंय।”<verse eid="NUM 2:2"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="3" style="v" sid="NUM 2:3"/>पूरब तरफ, सूरज निकले कोति:</para>
  <para style="li1" vid="NUM 2:3">यहूदा के सिविर के दलमन अपन झंडा के अधीन डेरा डालंय। यहूदा के मनखेमन के अगुवा अमीनादाब के बेटा नहसोन होवय। <verse eid="NUM 2:3"/><verse number="4" style="v" sid="NUM 2:4"/>ओकर दल के गनती 74,600 रिहिस।<verse eid="NUM 2:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 2:5"/>ओमन के बाद इस्साकार गोत्र के परधान सूआर के बेटा नतनेल ह डेरा डालही। <verse eid="NUM 2:5"/><verse number="6" style="v" sid="NUM 2:6"/>ओकर दल के गनती 54,400 रिहिस।<verse eid="NUM 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 2:7"/>ओकर बाद जबूलून के गोत्र डेरा डालही। जबूलून के मनखेमन के अगुवा हेलोन के बेटा एलीआब होही। <verse eid="NUM 2:7"/><verse number="8" style="v" sid="NUM 2:8"/>ओकर दल के गनती 57,400 रिहिस।<verse eid="NUM 2:8"/></para>
  <para style="lf">
    <verse number="9" style="v" sid="NUM 2:9"/>यहूदा के सिविर बर जतेक आदमी सऊंपे गे रिहिन, ओमन के गनती ओमन के दल के मुताबिक 1,86,400 रिहिस। येमन पहिले निकलहीं।<verse eid="NUM 2:9"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="10" style="v" sid="NUM 2:10"/>दक्खिन कोति:</para>
  <para style="li1" vid="NUM 2:10">रूबेन के सिविर के दलमन अपन झंडा के अधीन डेरा डालंय। रूबेन के मनखेमन के अगुवा सदेऊर के बेटा एलीसूर होही। <verse eid="NUM 2:10"/><verse number="11" style="v" sid="NUM 2:11"/>ओकर दल के गनती 46,500 रिहिस।<verse eid="NUM 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 2:12"/>ओमन के बाद सिमोन के गोत्र ह डेरा डालही। सिमोन के मनखेमन के अगुवा सूरीसद्दाय के बेटा सलूमीएल होही। <verse eid="NUM 2:12"/><verse number="13" style="v" sid="NUM 2:13"/>ओकर दल के गनती 59,300 रिहिस।<verse eid="NUM 2:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 2:14"/>ओकर बाद गाद के गोत्र डेरा डालही। गाद के मनखेमन के अगुवा दूएल<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">कतको हस्तलिपि म </char><char style="fqa" closed="false">रूएल</char></note> के बेटा एलियासाप होही। <verse eid="NUM 2:14"/><verse number="15" style="v" sid="NUM 2:15"/>ओकर दल के गनती 45,650 रिहिस।<verse eid="NUM 2:15"/></para>
  <para style="lf">
    <verse number="16" style="v" sid="NUM 2:16"/>रूबेन के सिविर के जतेक आदमी रिहिन, ओमन के गनती दल के मुताबिक 1,51,450 रिहिस। दूसर बार म येमन बाहिर निकलहीं।<verse eid="NUM 2:16"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 2:17"/>तब मिलापवाला तम्बू अऊ लेवीमन के सिविर ह ले जाय के बेरा सिविरमन के बीच म रहय। ओमन ला ओहीच किसम ले लेय जावंय, जऊन किसम ले ओमन गाड़े जावंय, हर एक अपन झंडा के अधीन अपन-अपन जगह म रहिके चलंय।<verse eid="NUM 2:17"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="18" style="v" sid="NUM 2:18"/>पछिम कोति:</para>
  <para style="li1" vid="NUM 2:18">एपरैम के सिविर के दलमन अपन झंडा के अधीन डेरा डालंय। एपरैम के मनखेमन के अगुवा अमीहूद के बेटा एलीसामा होही। <verse eid="NUM 2:18"/><verse number="19" style="v" sid="NUM 2:19"/>ओकर दल के गनती 40,500 रिहिस।<verse eid="NUM 2:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 2:20"/>ओकर बाद मनस्से के गोत्र डेरा डालही। मनस्से के मनखेमन के अगुवा पदासूर के बेटा गमलीएल होही। <verse eid="NUM 2:20"/><verse number="21" style="v" sid="NUM 2:21"/>ओकर दल के गनती 32,200 रिहिस।<verse eid="NUM 2:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 2:22"/>ओकर बाद बिनयामीन के गोत्र डेरा डालही। बिनयामीन के मनखेमन के अगुवा गिदोनी के बेटा अबीदान होही। <verse eid="NUM 2:22"/><verse number="23" style="v" sid="NUM 2:23"/>ओकर दल के गनती 35,400 रिहिस।<verse eid="NUM 2:23"/></para>
  <para style="lf">
    <verse number="24" style="v" sid="NUM 2:24"/>एपरैम के सिविर म जतेक आदमी रिहिन, ओमन अपन दल के मुताबिक 1,08,100 रिहिन। येमन तीसरा नम्बर म निकलहीं।<verse eid="NUM 2:24"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="25" style="v" sid="NUM 2:25"/>उत्तर कोति:</para>
  <para style="li1" vid="NUM 2:25">दान के सिविर के दलमन अपन झंडा के अधीन डेरा डालंय। दान के मनखेमन के अगुवा अम्मीसद्दाय के बेटा अहीएजेर होही। <verse eid="NUM 2:25"/><verse number="26" style="v" sid="NUM 2:26"/>ओकर दल के गनती 62,700 रिहिस।<verse eid="NUM 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 2:27"/>ओमन के बाद आसेर के गोत्र डेरा डालही। आसेर के मनखेमन के अगुवा ओकरान के बेटा पगीएल होही। <verse eid="NUM 2:27"/><verse number="28" style="v" sid="NUM 2:28"/>ओकर दल के गनती 41,500 रिहिस।<verse eid="NUM 2:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 2:29"/>ओकर बाद नपताली के गोत्र डेरा डालही। नपताली के मनखेमन के अगुवा एनान के बेटा अहीरा होही। <verse eid="NUM 2:29"/><verse number="30" style="v" sid="NUM 2:30"/>ओकर दल के गनती 53,400 रिहिस।<verse eid="NUM 2:30"/></para>
  <para style="lf">
    <verse number="31" style="v" sid="NUM 2:31"/>दान के सिविर के जतेक आदमी रिहिन, ओमन के गनती 1,57,600 रिहिस। आखिरी म येमन अपन झंडा के अधीन निकलहीं।<verse eid="NUM 2:31"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="32" style="v" sid="NUM 2:32"/>येमन ओ इसरायली रिहिन, जेमन ला ओमन के परिवार के मुताबिक गने गीस। सिविरमन म जम्मो पुरूस के गनती ओमन के दल के मुताबिक 6,03,550 रिहिस। <verse eid="NUM 2:32"/><verse number="33" style="v" sid="NUM 2:33"/>पर लेवीमन ला आने इसरायलीमन संग नइं गने गीस, जइसे कि यहोवा ह मूसा ला हुकूम दे रिहिस।<verse eid="NUM 2:33"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34"/>इसरायलीमन ओ हर काम करिन, जेकर हुकूम यहोवा ह मूसा ला दे रिहिस; ओ हुकूम के मुताबिक ओमन अपन-अपन झंडा के अधीन डेरा डालंय अऊ हुकूम के मुताबिक ही ओमा के हर एक जन अपन-अपन गोत्र अऊ परिवार के संग निकलंय।<verse eid="NUM 2:34"/></para>
  <chapter eid="NUM 2"/>
  <chapter number="3" style="c" sid="NUM 3"/>
  <para style="s1">लेवीमन</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1"/>जब यहोवा ह सीनय पहाड़ ऊपर मूसा ले गोठियाईस, ओ समय हारून अऊ मूसा के परिवार के लेखा-जोखा अइसने रिहिस।<verse eid="NUM 3:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="NUM 3:2"/>हारून के बेटामन के नांव: पहिलऊठा नादाब ओकर बाद अबीहू, एलिआजर अऊ ईतामार। <verse eid="NUM 3:2"/><verse number="3" style="v" sid="NUM 3:3"/>हारून के बेटामन के ये नांव अय, जेमन अभिसिक्त पुरोहित रिहिन अऊ जेमन ला पुरोहिती सेवा बर अभिसेक करे गे रिहिस। <verse eid="NUM 3:3"/><verse number="4" style="v" sid="NUM 3:4"/>पर नादाब अऊ अबीहू यहोवा के आघू म मर गीन, जब ओमन ओकर आघू म सीनय के सुन्ना जगह म बरजे गय आगी के संग बलिदान चघाईन।<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="LEV 10:1-7">लैव्य 10:1‑7</ref></char></char></note> ओमन के कोनो बेटा नइं रिहिस, एकरसेति एलिआजर अऊ ईतामार अपन ददा हारून के समय म पुरोहित के रूप म सेवा करिन।<verse eid="NUM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5"/>यहोवा ह मूसा ला कहिस, <verse eid="NUM 3:5"/><verse number="6" style="v" sid="NUM 3:6"/>“लेवी गोत्र के मनखेमन ला बलाके हारून पुरोहित करा लान कि ओमन ओकर मदद करंय। <verse eid="NUM 3:6"/><verse number="7" style="v" sid="NUM 3:7"/>ओमन पबितर-तम्बू के काम करे के दुवारा मिलापवाला तम्बू म हारून बर अऊ पूरा समाज बर जिम्मेदारी पूरा करंय। <verse eid="NUM 3:7"/><verse number="8" style="v" sid="NUM 3:8"/>ओमन मिलापवाला तम्बू के जम्मो सामान के देखरेख करंय अऊ पबितर-तम्बू के काम करे के दुवारा इसरायलीमन के काम ला पूरा करंय। <verse eid="NUM 3:8"/><verse number="9" style="v" sid="NUM 3:9"/>लेवीमन ला लानके हारून अऊ ओकर बेटामन के हांथ म सऊंप दे; येमन ओ इसरायली अंय, जेमन ओला पूरा दे दिये जावंय। <verse eid="NUM 3:9"/><verse number="10" style="v" sid="NUM 3:10"/>हारून अऊ ओकर बेटामन ला पुरोहित के पद म सेवा करे बर ठहिरा; यदि आने मनखे पबितर-स्थान म जावय, त ओह मार डारे जावय।”<verse eid="NUM 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11"/>यहोवा ह मूसा ला ये घलो कहिस, <verse eid="NUM 3:11"/><verse number="12" style="v" sid="NUM 3:12"/>“हर एक इसरायली माईलोगन के पहिलांत बेटा के बदला म मेंह इसरायलीमन के बीच ले लेवीमन ला लेय ले हंव। लेवीमन मोर अंय, <verse eid="NUM 3:12"/><verse number="13" style="v" sid="NUM 3:13"/>काबरकि जम्मो पहिलांतमन मोर अंय। जब मेंह मिसर देस म जम्मो पहिलांतमन ला मार डारेंव, त मेंह इसरायल म हर एक पहिलांत ला अपन बर पबितर कर ले रहेंव, चाहे ओह मनखे होवय या पसु। ओमन मोर होहीं। मेंह यहोवा अंव।”<verse eid="NUM 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14"/>यहोवा ह सीनय के सुनसान जगह म मूसा ला कहिस, <verse eid="NUM 3:14"/><verse number="15" style="v" sid="NUM 3:15"/>“लेवीमन ला परिवार अऊ गोत्र के मुताबिक गनती कर। एक महिना अऊ जादा उमर के, पुरूसमन ला गन।” <verse eid="NUM 3:15"/><verse number="16" style="v" sid="NUM 3:16"/>एकरसेति मूसा ह ओमन ला वइसने गनिस, जइसने यहोवा ह ओला हुकूम देय रिहिस।<verse eid="NUM 3:16"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 3:17"/>लेवी के बेटामन के नांव ये अंय:</para>
  <para style="li2" vid="NUM 3:17">गेरसोन, कहात अऊ मरारी।<verse eid="NUM 3:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="NUM 3:18"/>गेरसोन बंस के नांवमन ये रिहिन:</para>
  <para style="li2" vid="NUM 3:18">लिबनी अऊ सिमी।<verse eid="NUM 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 3:19"/>कहात बंस के येमन रिहिन:</para>
  <para style="li2" vid="NUM 3:19">अमराम, ईसहार, हेबरोन अऊ उजीएल।<verse eid="NUM 3:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 3:20"/>मरारी बंस के येमन रिहिन:</para>
  <para style="li2" vid="NUM 3:20">महली अऊ मूसी।</para>
  <para style="b" vid="NUM 3:20"/>
  <para style="lf" vid="NUM 3:20">लेवी के परिवारमन के मुताबिक येमन ओमन के बंस रिहिन।<verse eid="NUM 3:20"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="21" style="v" sid="NUM 3:21"/>गेरसोन के बंस म लिबनी अऊ सिमीमन रिहिन; येमन गेरसोनी बंस रिहिन।<verse eid="NUM 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 3:22"/>एक महिना या जादा उमर के जम्मो पुरूसमन के गनती 7,500 रिहिस।<verse eid="NUM 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 3:23"/>गेरसोनीमन के बंस ला पछिम कोति, पबितर-तम्बू के पाछू म डेरा डालना रिहिस।<verse eid="NUM 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 3:24"/>गेरसोनीमन के परिवारमन के अगुवा लाएल के बेटा एलियासाप रिहिस।<verse eid="NUM 3:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 3:25"/>मिलापवाला तम्बू म गेरसोन बंस के ऊपर पबितर-तम्बू अऊ तम्बू, ओकर ढपना, मिलापवाला तम्बू के प्रवेस दुवार के परदा, <verse eid="NUM 3:25"/><verse number="26" style="v" sid="NUM 3:26"/>अंगना के परदा, पबितर-तम्बू अऊ बेदी के चारों कोति अंगना के प्रवेस दुवार के परदा, अऊ रस्सी—अऊ ओमन के उपयोग ले संबंधित हर एक चीज के जिम्मेदारी रिहिस।<verse eid="NUM 3:26"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="27" style="v" sid="NUM 3:27"/>कहात ले अमरामी, ईसहारी, हेबरोनी अऊ उजीएलीमन के बंस चलिस; येमन कहातीमन के बंस रिहिन।<verse eid="NUM 3:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 3:28"/>ओ जम्मो पुरूस, जऊन मन एक महिना या जादा उमर के रिहिन, ओमन के गनती 8,600<note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">8,300</char></note> रिहिस।</para>
  <para style="li1" vid="NUM 3:28">कहातीमन पबितर-स्थान के देखरेख करंय।<verse eid="NUM 3:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 3:29"/>कहात के बंस ला पबितर-तम्बू के दक्खिन कोति डेरा डालना रिहिस।<verse eid="NUM 3:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 3:30"/>कहाती बंस के परिवारमन के अगुवा उजीएल के बेटा एलीसापान रिहिस।<verse eid="NUM 3:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 3:31"/>ओमन के ऊपर सन्दूक, मेज, दीवट, बेदी, सेवा म उपयोग अवइया पबितर-स्थान के बरतन, परदा, अऊ ओमन के उपयोग ले संबंधित हर एक चीज के जिम्मेदारी रिहिस।<verse eid="NUM 3:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="NUM 3:32"/>लेवीमन के परधान अगुवा एलिआजर ह हारून पुरोहित के बेटा रिहिस। ओला ओमन के ऊपर ठहिराय गे रिहिस, जऊन मन के ऊपर पबितर-स्थान के देखरेख के जिम्मेदारी रिहिस।<verse eid="NUM 3:32"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="33" style="v" sid="NUM 3:33"/>मरारी ले महली अऊ मूसी गोत्र के बंस चलिस; येमन मरारी के बंस रिहिन।<verse eid="NUM 3:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 3:34"/>एक महिना या जादा उमर के पुरूसमन गने गीन, ओमन 6,200 रिहिन।<verse eid="NUM 3:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 3:35"/>मरारी बंस के परिवारमन के अगुवा अबीहैल के बेटा सूरीएल रिहिस।</para>
  <para style="li1" vid="NUM 3:35">ओमन ला पबितर-तम्बू के उत्तर कोति डेरा डालना रिहिस।<verse eid="NUM 3:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="NUM 3:36"/>मरारी बंस के ऊपर पबितर-तम्बू के ढांचा, येकर बल्ली, खंभा, आधार, येकर जम्मो सामान, ओमन के उपयोग ले संबंधित हर एक चीज के जिम्मेदारी रिहिस; <verse eid="NUM 3:36"/><verse number="37" style="v" sid="NUM 3:37"/>अंगना के संग ओमन के आधार के चारों कोति के खंभा, तम्बू के खूंटी अऊ डोरीमन के जिम्मेदारी घलो रिहिस।<verse eid="NUM 3:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 3:38"/>मूसा अऊ हारून अऊ ओकर बेटामन ला पबितर-तम्बू के पूरब दिसा म, सूरज निकले कोति, मिलापवाला तम्बू के आघू म डेरा डालना रिहिस।</para>
  <para style="li1" vid="NUM 3:38">ओमन के ऊपर इसरायलीमन कोति ले पबितर-स्थान के देखरेख के जिम्मेदारी रिहिस।</para>
  <para style="li1" vid="NUM 3:38">यदि कोनो आने मनखे पबितर-स्थान करा जावय, त ओह मार डारे जावय।<verse eid="NUM 3:38"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="39" style="v" sid="NUM 3:39"/>मूसा अऊ हारून यहोवा के हुकूम ले लेवीमन के ओमन के बंस के मुताबिक गनती करिन, अऊ एक महिना या ओकर ले जादा उमर के पुरूसमन के संखिया 22,000 रिहिस।<verse eid="NUM 3:39"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40"/>ओकर बाद यहोवा ह मूसा ला कहिस, “इसरायलीमन के पहिलांत पुरूसमन ला गन, जऊन मन एक महिना या जादा उमर के हवंय ओमन के नांव के एक सूची बना। <verse eid="NUM 3:40"/><verse number="41" style="v" sid="NUM 3:41"/>मोर बर इसरायलीमन के जम्मो पहिलांत के बदले लेवीमन ला, अऊ इसरायलीमन के पसुमन के जम्मो पहिलांत के बदले लेवीमन के पसुमन ला लेय ले। मेंह यहोवा अंव।”<verse eid="NUM 3:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 3:42"/>एकरसेति मूसा ह इसरायलीमन के जम्मो पहिलांतमन के गनती, यहोवा के हुकूम के मुताबिक करिस। <verse eid="NUM 3:42"/><verse number="43" style="v" sid="NUM 3:43"/>जऊन पहिलांत पुरूसमन, एक महिना या ओकर ले जादा उमर के रिहिन, ओमन के लिखे गय नांव के मुताबिक ओमन गनती म 22,273 रिहिन।<verse eid="NUM 3:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44"/>यहोवा ह मूसा ला ये घलो कहिस, <verse eid="NUM 3:44"/><verse number="45" style="v" sid="NUM 3:45"/>“इसरायल के जम्मो पहिलांत के बदले लेवीमन, अऊ ओमन के पसुमन के बदले लेवीमन के पसुमन ला लेय ले। लेवीमन मोर अंय। मेंह यहोवा अंव। <verse eid="NUM 3:45"/><verse number="46" style="v" sid="NUM 3:46"/>इसरायलीमन के ओ 273 पहिलांत, जेमन गनती म लेवीमन ले जादा हवंय, ओमन के छुड़ौती बर, <verse eid="NUM 3:46"/><verse number="47" style="v" sid="NUM 3:47"/>तें ओ हर एक पुरूस बर पांच सेकेल<note caller="+" style="f"><char style="fr" closed="false">3:47 </char><char style="ft" closed="false">लगभग 58 ग्राम</char></note> जमा कर, येह पबितर-स्थान के सेकेल के मुताबिक होवय, जेकर वजन बीस गेरा होथे। <verse eid="NUM 3:47"/><verse number="48" style="v" sid="NUM 3:48"/>ये रकम ला उपरहा इसरायलीमन के छुड़ौती बर हारून अऊ ओकर बेटामन ला दे देबे।”<verse eid="NUM 3:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49"/>एकरसेति मूसा ह ओ मनखेमन ले छोंड़ाय के दाम जमा करिस, जेमन लेवीमन के दुवारा छोंड़ाय गे मनखेमन ले जादा रिहिन। <verse eid="NUM 3:49"/><verse number="50" style="v" sid="NUM 3:50"/>इसरायलीमन के पहिलांतमन ले ओह पबितर-स्थान के सेकेल के मुताबिक दाम जमा करिस, जेकर वजन 1,365 सेकेल<note caller="+" style="f"><char style="fr" closed="false">3:50 </char><char style="ft" closed="false">लगभग 16 किलोग्राम</char></note> होईस। <verse eid="NUM 3:50"/><verse number="51" style="v" sid="NUM 3:51"/>मूसा ह हारून अऊ ओकर बेटामन ला छुड़ौती के दाम दीस, जइसे कि ओला यहोवा ह हुकूम दे रिहिस।<verse eid="NUM 3:51"/></para>
  <chapter eid="NUM 3"/>
  <chapter number="4" style="c" sid="NUM 4"/>
  <para style="s1">कहातीमन</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1"/>यहोवा ह मूसा अऊ हारून ला कहिस: <verse eid="NUM 4:1"/><verse number="2" style="v" sid="NUM 4:2"/>“लेवीमन के बीच म ले कहातीमन के ओमन के बंस अऊ परिवार के मुताबिक गनती कर। <verse eid="NUM 4:2"/><verse number="3" style="v" sid="NUM 4:3"/>तीस साल ले लेके पचास साल के उमर के ओ जम्मो आदमीमन के गनती कर, जेमन मिलापवाला तम्बू के काम म सेवा करे बर आथें।<verse eid="NUM 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 4:4"/>“मिलापवाला तम्बू म कहातीमन के काम ये होही: महा पबितर चीजमन के देखरेख। <verse eid="NUM 4:4"/><verse number="5" style="v" sid="NUM 4:5"/>जब डेरा ह आघू बढ़थे तब हारून अऊ ओकर बेटामन भीतर जाके आड़ करइया परदा ला उतार लेवंय अऊ ओला करार कानून के सन्दूक ऊपर ढांप देवंय। <verse eid="NUM 4:5"/><verse number="6" style="v" sid="NUM 4:6"/>तब ओमन परदा ला एक टिकाऊ खाल ले ढांप देवंय, अऊ ओकर ऊपर पूरा नीला रंग के कपड़ा ओढ़ा देवंय अऊ डंडामन ला ओमन के जगह म लगावंय।<verse eid="NUM 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7"/>“उपस्थिति के मेज के ऊपर ओमन एक नीला कपड़ा ला फईला देवंय अऊ येकर ऊपर थाली, बरतन अऊ कटोरा, अऊ पेय-बलिदान के सुराहीमन ला रखंय; ओ रोटी, जऊन ह उहां हमेसा रहिथे, ओह उहां रखे रहय। <verse eid="NUM 4:7"/><verse number="8" style="v" sid="NUM 4:8"/>ओमन एक सिन्दूरी रंग के कपड़ा येमन के ऊपर फईलाके, टिकाऊ खाल ले ढांप देवंय अऊ डंडामन ला ओमन के जगह म लगावंय।<verse eid="NUM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9"/>“फेर ओमन एक नीला कपड़ा लेके अंजोर करे बर रखे दीवट, ओकर दीया, ओकर बाती ला काटे के कतरनी अऊ बड़े थाली, अऊ जैतून तेल डारे म उपयोग अवइया ओकर जम्मो सुराहीमन ला ढांप देवंय। <verse eid="NUM 4:9"/><verse number="10" style="v" sid="NUM 4:10"/>तब ओमन येला अऊ ओकर जम्मो सामान ला एक टिकाऊ खाल के ढकना म लपेट देवंय अऊ येला ले जवइया ढांचा म डार देवंय।<verse eid="NUM 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11"/>“सोन के बेदी ऊपर ओमन एक नीला कपड़ा फईला देवंय अऊ ओला टिकाऊ खाल ले ढांप देवंय अऊ डंडामन ला ओकर जगह म लगा देवंय।<verse eid="NUM 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 4:12"/>“ओमन पबितर-स्थान म सेवा बर उपयोग होवइया जम्मो सामान ला लेवंय अऊ ओमन ला एक नीला कपड़ा म लपेटंय, अऊ ओकर ऊपर टिकाऊ खाल ला ढांप देवंय अऊ ओमन ला ले जवइया ढांचा म रख देवंय।<verse eid="NUM 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13"/>“ओमन कांसा के बेदी ले राख ला हटाके ओकर ऊपर एक बैंगनी कपड़ा फईला देवंय। <verse eid="NUM 4:13"/><verse number="14" style="v" sid="NUM 4:14"/>तब ओमन ओमा बेदी करा सेवा म उपयोग होवइया जम्मो बरतन ला रख देवंय, जेमा करछूल, मांस म उपयोग होवइया कांटा, बेलचा अऊ छिंचे के कटोरामन घलो रहंय। येला ओमन एक टिकाऊ खाल ले ढांप देवंय अऊ डंडामन ला ओकर जगह म लगा देवंय।<verse eid="NUM 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15"/>“जब हारून अऊ ओकर बेटामन पबितर-स्थान अऊ ओकर जम्मो पबितर सामान अऊ पबितर बरतनमन ला ढांप लीहीं, अऊ जब सिविर ह चले बर तियार हो जाही, तब ही कहातीमन आवंय अऊ ओला उठाके ले जावंय। पर जरूरी अय कि ओमन पबितर चीजमन ला झन छुवंय, नइं तो ओमन मर जाहीं। मिलापवाला तम्बू म जऊन सामान रहिथे, कहातीमन ओमन ला उठाके ले जावंय।<verse eid="NUM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16"/>“हारून पुरोहित के बेटा एलिआजर के देखरेख म ये चीजमन रहंय: दीया जलाय के तेल, खुसबूवाला धूप, नियमित अन्न-बलिदान अऊ अभिसेक के तेल। ओकर ऊपर पूरा पबितर-तम्बू अऊ ओमा के हर एक चीज के जिम्मेदारी रहय, ओमा के पबितर सामान अऊ बरतनमन के घलो जिम्मेदारी।”<verse eid="NUM 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17"/>फेर यहोवा ह मूसा अऊ हारून ला कहिस, <verse eid="NUM 4:17"/><verse number="18" style="v" sid="NUM 4:18"/>“धियान रहय कि कहाती बंस ह लेवीमन के बीच ले नास झन होवय, <verse eid="NUM 4:18"/><verse number="19" style="v" sid="NUM 4:19"/>ताकि जब ओमन सबले पबितर चीजमन के लकठा म आवंय, त ओमन जीयत रहंय अऊ झन मरंय, ओमन बर ये करव: हारून अऊ ओकर बेटामन पबितर-स्थान म जावंय अऊ हर एक झन ला ओकर काम के जिम्मेदारी सऊंपंय अऊ बतावंय कि कोन ह का उठाके ले जाही। <verse eid="NUM 4:19"/><verse number="20" style="v" sid="NUM 4:20"/>पर कहातीमन पबितर चीजमन ला देखे बर बिलकुल ही भीतर झन जावंय, थोरकन देर बर घलो नइं, नइं तो ओमन मर जाहीं।”<verse eid="NUM 4:20"/></para>
  <para style="s1">गेरसोनीमन</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21"/>यहोवा ह मूसा ला कहिस, <verse eid="NUM 4:21"/><verse number="22" style="v" sid="NUM 4:22"/>“गेरसोनीमन के घलो ओमन के परिवार अऊ बंस के मुताबिक गनती कर। <verse eid="NUM 4:22"/><verse number="23" style="v" sid="NUM 4:23"/>तीस ले लेके पचास साल के ओ जम्मो पुरूसमन के गनती कर, जऊन मन मिलापवाला तम्बू म सेवा करे बर आथें।<verse eid="NUM 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24"/>“सामान ले जवई अऊ ओमन के आने काम म गेरसोनी बंस के मनखेमन के ये सेवा होही: <verse eid="NUM 4:24"/><verse number="25" style="v" sid="NUM 4:25"/>ओमन पबितर-तम्बू के परदा ला उठाके ले जावंय, येमा मिलापवाला तम्बू, कपड़ा के तोपनी अऊ टिकाऊ खाल के येकर बाहिरी तोपनी, मिलापवाला तम्बू के प्रवेस दुवार म लगे परदामन, <verse eid="NUM 4:25"/><verse number="26" style="v" sid="NUM 4:26"/>पबितर-तम्बू अऊ बेदी के चारों कोति के अंगना के परदामन, अंगना के प्रवेस दुवार म लगे परदा, तम्बू के सेवा म उपयोग होवइया रस्सी अऊ जम्मो सामानमन होहीं। गेरसोनीमन ये चीजमन ले संबंधित जम्मो काम ला करहीं। <verse eid="NUM 4:26"/><verse number="27" style="v" sid="NUM 4:27"/>गेरसोनीमन के जम्मो काम, चाहे ओह सामान उठाके ले जवई या आने काम; ये सब हारून अऊ ओकर बेटामन के निरदेसन म करे जावय। ओमन जऊन काम करहीं, येला एक जिम्मेदारी के रूप म तेंह ओमन ला सऊंपबे। <verse eid="NUM 4:27"/><verse number="28" style="v" sid="NUM 4:28"/>येह मिलापवाला तम्बू म गेरसोनी बंस के सेवा अय। ओमन अपन काम हारून पुरोहित के बेटा ईतामार के निरदेसन म करंय।<verse eid="NUM 4:28"/></para>
  <para style="s1">मरारीमन</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29"/>“मरारीमन ला ओमन के बंस अऊ परिवार के मुताबिक गन। <verse eid="NUM 4:29"/><verse number="30" style="v" sid="NUM 4:30"/>तीस ले लेके पचास साल के ओ जम्मो आदमीमन के गनती कर, जऊन मन मिलापवाला तम्बू म सेवा करे बर आथें। <verse eid="NUM 4:30"/><verse number="31" style="v" sid="NUM 4:31"/>तम्बू म अपन जम्मो सेवा के भाग के रूप म, ओमन पबितर-तम्बू के ढांचा, येकर डंडा, खंभा अऊ आधारमन ला उठाके ले जावंय, <verse eid="NUM 4:31"/><verse number="32" style="v" sid="NUM 4:32"/>संगे-संग ओमन अंगना के चारों कोति के खंभामन ला ओमन के आधार सहित, तम्बू के खूंटी, रस्सी, ओमन के जम्मो सामान अऊ ओमन के उपयोग के हर एक चीज ला ले जावंय। हर एक आदमी ला बता कि ओह का चीज ला ले जाही। <verse eid="NUM 4:32"/><verse number="33" style="v" sid="NUM 4:33"/>हारून पुरोहित के बेटा ईतामार के निरदेसन म मिलापवाला तम्बू म मरारी गोत्र के ये सेवा होही।”<verse eid="NUM 4:33"/></para>
  <para style="s1">लेवी गोत्र के गनती</para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 4:34"/>तब मूसा, हारून अऊ समाज के अगुवामन कहातीमन ला ओमन के बंस अऊ परिवारमन के मुताबिक गनती करिन।<verse eid="NUM 4:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 4:35"/>तीस ले लेके पचास साल के ओ जम्मो पुरूस, जऊन मन मिलापवाला तम्बू म सेवा करे बर आईन, <verse eid="NUM 4:35"/><verse number="36" style="v" sid="NUM 4:36"/>बंस के मुताबिक 2,750 रिहिन। <verse eid="NUM 4:36"/><verse number="37" style="v" sid="NUM 4:37"/>येह कहाती बंस म ओ जम्मो झन के संखिया रिहिस, जऊन मन मिलापवाला तम्बू म सेवा करिन। यहोवा के दुवारा मूसा ला दिये गय हुकूम के मुताबिक मूसा अऊ हारून ओमन के गनती करिन।<verse eid="NUM 4:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 4:38"/>गेरसोनीमन ओमन के कुल अऊ परिवारमन के मुताबिक गने गीन।<verse eid="NUM 4:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 4:39"/>तीस ले लेके पचास साल के ओ जम्मो पुरूस, जऊन मन मिलापवाला तम्बू म सेवा करे बर आईन, <verse eid="NUM 4:39"/><verse number="40" style="v" sid="NUM 4:40"/>ओमन के कुल अऊ परिवारमन के मुताबिक ओमन के संखिया 2,630 रिहिस। <verse eid="NUM 4:40"/><verse number="41" style="v" sid="NUM 4:41"/>येह गेरसोनी कुल म ओ जम्मो झन के संखिया रिहिस, जऊन मन मिलापवाला तम्बू म सेवा करिन। यहोवा के हुकूम के मुताबिक मूसा अऊ हारून ओमन के गनती करिन।<verse eid="NUM 4:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 4:42"/>मरारीमन ला ओमन के कुल अऊ परिवार के मुताबिक गने गीस।<verse eid="NUM 4:42"/></para>
  <para style="li2">
    <verse number="43" style="v" sid="NUM 4:43"/>तीस ले लेके पचास साल के ओ जम्मो पुरूस, जऊन मन मिलापवाला तम्बू म सेवा करे बर आईन, <verse eid="NUM 4:43"/><verse number="44" style="v" sid="NUM 4:44"/>ओमन के कुल के मुताबिक ओमन के संखिया 3,200 रिहिस। <verse eid="NUM 4:44"/><verse number="45" style="v" sid="NUM 4:45"/>येह मरारी बंस के कुल संखिया रिहिस। यहोवा के दुवारा मूसा ला दिये गय हुकूम के मुताबिक मूसा अऊ हारून ओमन के गनती करिन।<verse eid="NUM 4:45"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="46" style="v" sid="NUM 4:46"/>मूसा, हारून अऊ इसरायल के अगुवामन जम्मो लेवीमन के ओमन के बंस अऊ परिवार के मुताबिक गनती करिन। <verse eid="NUM 4:46"/><verse number="47" style="v" sid="NUM 4:47"/>तीस ले लेके पचास साल के ओ जम्मो पुरूस, जऊन मन सेवा के काम करे बर अऊ मिलापवाला तम्बू ला उठाके ले जाय बर आईन, <verse eid="NUM 4:47"/><verse number="48" style="v" sid="NUM 4:48"/>ओमन के संखिया 8,580 रिहिस। <verse eid="NUM 4:48"/><verse number="49" style="v" sid="NUM 4:49"/>मूसा ला दिये गय यहोवा के हुकूम के मुताबिक हर एक जन ला ओकर काम सऊंपे गीस, अऊ बताय गीस कि कोन ह का चीज ला उठाके ले जाही।</para>
  <para style="b" vid="NUM 4:49"/>
  <para style="p" vid="NUM 4:49">ये किसम ले यहोवा के दुवारा मूसा ला दिये गय हुकूम के मुताबिक ओमन के गनती होईस।<verse eid="NUM 4:49"/></para>
  <chapter eid="NUM 4"/>
  <chapter number="5" style="c" sid="NUM 5"/>
  <para style="s1">सिविर के सुधता</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 5:1"/><verse number="2" style="v" sid="NUM 5:2"/>“इसरायलीमन ला हुकूम दे कि यदि कोनो ला असुध चाम के बेमारी<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">इबरानी सबद </char><char style="fq" closed="false">असुध चाम के बेमारी </char><char style="ft" closed="false">ला अकसर “कोढ़” अनुवाद करे गे हवय</char></note> या देहें ले कोनो चीज निकले, या लास ला छुए से असुध हो गे हवय, ओला सिविर ले बाहिर निकाल दिये जावय। <verse eid="NUM 5:2"/><verse number="3" style="v" sid="NUM 5:3"/>चाहे पुरूस हो या माईलोगन, ओला निकाल दव; ओमन ला सिविर के बाहिर निकाल दव ताकि ओमन सिविर ला असुध झन करंय, जिहां मेंह ओमन के बीच म रहिथंव।” <verse eid="NUM 5:3"/><verse number="4" style="v" sid="NUM 5:4"/>इसरायलीमन अइसने ही करिन; ओमन मनखेमन ला सिविर के बाहिर कर दीन। ओमन वइसने ही करिन, जइसने यहोवा ह मूसा ला निरदेस दे रिहिस।<verse eid="NUM 5:4"/></para>
  <para style="s1">नुकसान के भरपई</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 5:5"/><verse number="6" style="v" sid="NUM 5:6"/>“इसरायलीमन ला कह: ‘जब कोनो पुरूस या माईलोगन कोनो मनखे के संग गलत बरताव करथे अऊ ये किसम ले यहोवा के संग बिसवासघात करके दोसी ठहिरथे, <verse eid="NUM 5:6"/><verse number="7" style="v" sid="NUM 5:7"/>त ओह अपन करे गे पाप ला जरूर मान लेवय। ओह अपन करे गे दोस के पूरा भरपई करय; नुकसान करे गे चीज के दाम म ओकर पांचवां भाग जोड़के ओह ओ मनखे ला दे देवय, जेकर ओह नुकसान करे हवय। <verse eid="NUM 5:7"/><verse number="8" style="v" sid="NUM 5:8"/>पर कहूं ओ मनखे के कोनो नजदीकी रिस्तेदार नइं ए, जेला गलत काम के भरपई करे जा सकय, त फेर भरपई ह यहोवा के हो जाही अऊ येला पुरोहित ला ओ मेढ़ा के संग दे दिये जावय, जेकर संग बिसवासघात करइया मनखे ह पछताप करथे। <verse eid="NUM 5:8"/><verse number="9" style="v" sid="NUM 5:9"/>ओ जम्मो पबितर चीज के बांटा, जेला इसरायलीमन पुरोहित करा लानथें, ओ सब पुरोहित के होही। <verse eid="NUM 5:9"/><verse number="10" style="v" sid="NUM 5:10"/>पबितर चीजमन ओमन के मालिक के अंय, पर जऊन चीज ओमन पुरोहित ला देथें, ओह पुरोहित के हो जाही।’ ”<verse eid="NUM 5:10"/></para>
  <para style="s1">बिसवासघाती घरवाली के जांच</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11"/>तब यहोवा ह मूसा ला कहिस, <verse eid="NUM 5:11"/><verse number="12" style="v" sid="NUM 5:12"/>“इसरायलीमन ले बात कर अऊ ओमन ला कह: ‘कहूं कोनो मनखे के घरवाली बदचलन होके ओकर संग बिसवासघात करथे <verse eid="NUM 5:12"/><verse number="13" style="v" sid="NUM 5:13"/>याने कि कोनो आने मनखे ह ओकर घरवाली संग सुतथे, अऊ ये बात ओकर घरवाला ला मालूम नइं ए अऊ ओकर असुध होय के पता नइं चले हे (काबरकि ओकर बिरूध कोनो सबूत नइं ए अऊ ओह ओ काम म पकड़े नइं गे हवय), <verse eid="NUM 5:13"/><verse number="14" style="v" sid="NUM 5:14"/>अऊ कहूं ओकर घरवाला के मन म जलन होथे अऊ ओह अपन घरवाली ऊपर संका करथे कि ओह असुध हवय—या फेर ओकर घरवाली के असुध नइं होवत घलो, कहूं ओ मनखे ह ओकर ऊपर जलन अऊ संका करथे— <verse eid="NUM 5:14"/><verse number="15" style="v" sid="NUM 5:15"/>तब ओह अपन घरवाली ला पुरोहित करा ले जावय। ओह अपन घरवाली कोति ले एक एपा<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">1.6 किलोग्राम</char></note> के दसवां भाग जौ के पीसान घलो चढ़ावा के रूप म ले जावय। ओह ओकर ऊपर जैतून के तेल झन डालय या ओकर ऊपर धूप झन रखय, काबरकि येह जलन बर एक अन्न-बलिदान अय, पाप कोति धियान देय बर एक सुरता-बलिदान ए।<verse eid="NUM 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16"/>“ ‘पुरोहित ह ओ माईलोगन ला लानय अऊ यहोवा के आघू म ओला ठाढ़ करय। <verse eid="NUM 5:16"/><verse number="17" style="v" sid="NUM 5:17"/>तब पुरोहित ह माटी के सुराही म थोरकन पबितर पानी लेवय अऊ पबितर-तम्बू के फर्स ले कुछू धुर्रा लेके ओ पानी म डाल देवय। <verse eid="NUM 5:17"/><verse number="18" style="v" sid="NUM 5:18"/>पुरोहित ह ओ माईलोगन ला यहोवा के आघू म ठाढ़ करे के बाद, ओकर बाल ला खोल देवय अऊ ओकर हांथ म जलन के सुरता-बलिदान, अन्न-बलिदान ला रखय, जबकि पुरोहित ह खुद ओ करू पानी ला धरय, जऊन ह सराप लानथे। <verse eid="NUM 5:18"/><verse number="19" style="v" sid="NUM 5:19"/>तब पुरोहित ह ओ माईलोगन ला कसम खवाके कहय, “अपन घरवाला के संग बिहाव के जिनगी जीयत, यदि कोनो आने पुरूस ह तोला असुध नइं करे हवय अऊ तेंह निरदोस हस, त ये सराप लानेवाला करू पानी ले तोला कोनो हानि नइं होवय। <verse eid="NUM 5:19"/><verse number="20" style="v" sid="NUM 5:20"/>पर यदि अपन घरवाला के संग बिहाव के जिनगी जीयत, तेंह बदचलनी करे हस अऊ अपन घरवाला के छोंड़ आने पुरूस के संग सुतके अपनआप ला असुध करे हस”— <verse eid="NUM 5:20"/><verse number="21" style="v" sid="NUM 5:21"/>इहां पुरोहित ह ओ माईलोगन ला ये सराप के अधीन रखय—“त यहोवा ह मनखेमन के बीच म तोला सरापित<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">आने मन देखंय कि तेंह सरापित अस</char></note> करय, ओह तोर गरभपात करवा देवय अऊ तोर पेट ह फूल जावय। <verse eid="NUM 5:21"/><verse number="22" style="v" sid="NUM 5:22"/>ये सराप लानेवाला करू पानी ह तोर देहें भीतर जावय, ताकि तोर पेट ह फूल जावय या तोर गरभ गिर जावय।”</para>
  <para style="p" vid="NUM 5:22">“ ‘तब ओ माईलोगन ह कहय, “आमीन। अइसने ही होवय।”<verse eid="NUM 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23"/>“ ‘पुरोहित ह ये सराप ला एक ठन चामपट्टी<note caller="+" style="f"><char style="fr" closed="false">5:23 </char><char style="fq" closed="false">चामपट्टी </char><char style="ft" closed="false">येह चाम या रूख के छाली ले बने पन्ना रहय, जेला लपेटके रखे जावय</char></note> म लिख लेवय अऊ तब ओला ओ करू पानी म धो लेवय। <verse eid="NUM 5:23"/><verse number="24" style="v" sid="NUM 5:24"/>ओकर बाद ओ सराप लानेवाला करू पानी ला ओह ओ माईलोगन ला पीये बर देवय, तब ये सराप लानेवाला पानी ओकर भीतर जाही, जेकर ले करू पीरा होथे। <verse eid="NUM 5:24"/><verse number="25" style="v" sid="NUM 5:25"/>तब पुरोहित ह जलन के अन्न-बलिदान ला ओ माईलोगन के हांथ ले लेय लेवय, अऊ येला यहोवा के आघू म हलावय अऊ येला बेदी करा लानय। <verse eid="NUM 5:25"/><verse number="26" style="v" sid="NUM 5:26"/>तब पुरोहित ह यादगार-बलिदान के रूप म ओ अन्न-बलिदान म ले एक मुठा ले लेवय अऊ येला बेदी ऊपर जला देवय; ओकर बाद, ओह ओ माईलोगन ला पानी पीयावय। <verse eid="NUM 5:26"/><verse number="27" style="v" sid="NUM 5:27"/>यदि ओह अपनआप ला असुध करे होही अऊ अपन घरवाला के संग बिसवासघात करे होही, त फेर ओकर ये हाल होही: जब ओला ओ सराप देवइया अऊ बहुंत पीरा देवइया पानी पीयाय जाही, त येह ओकर देहें भीतर जाके ओकर पेट ला फूला दीही अऊ ओकर गरभ गिर जाही, अऊ ओह अपन मनखेमन के बीच सरापित हो जाही। <verse eid="NUM 5:27"/><verse number="28" style="v" sid="NUM 5:28"/>पर यदि ओ माईलोगन ह अपनआप ला असुध नइं करे होही, पर साफ होही, त ओह निरदोस ठहिरही अऊ ओकर गरभ धरे म समस्या नइं होही।<verse eid="NUM 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29"/>“ ‘जलन के संबंध म इही ह सही नियम ए, जब कोनो माईलोगन ह अपन घरवाला के संग बिहाव के जिनगी जीयत बदचलनी करथे अऊ अपनआप ला असुध करथे, <verse eid="NUM 5:29"/><verse number="30" style="v" sid="NUM 5:30"/>या जब कोनो मनखे ऊपर अपन घरवाली बर संका के भावना आथे, त येह जलन के कानून अय। पुरोहित ह ओ माईलोगन ला यहोवा के आघू म ठाढ़ करय अऊ ओकर ऊपर ये जम्मो बिधि पूरा करय। <verse eid="NUM 5:30"/><verse number="31" style="v" sid="NUM 5:31"/>ओ घरवाला ह गलत काम बर निरदोस ठहिरही, पर ओ माईलोगन ला ओकर पाप के दंड मिलही।’ ”<verse eid="NUM 5:31"/></para>
  <chapter eid="NUM 5"/>
  <chapter number="6" style="c" sid="NUM 6"/>
  <para style="s1">नाजीर</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 6:1"/><verse number="2" style="v" sid="NUM 6:2"/>“इसरायलीमन ले गोठिया अऊ ओमन ला कह: ‘यदि कोनो माईलोगन या पुरूस कोनो बिसेस मन्नत माने के दुवारा अपनआप ला एक नाजीर<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">अलग करे गय या पबितर करे गय मनखे</char></note> के रूप म यहोवा ला सऊंप देथे, <verse eid="NUM 6:2"/><verse number="3" style="v" sid="NUM 6:3"/>त जरूरी अय कि ओह अंगूर के मंद अऊ कोनो आने किसम के मंद अऊ अंगूर के मंद ले बने सिरका या आने किसम के मंद ले अलग रहय। जरूरी अय कि ओह अंगूर के रस झन पीयय या अंगूर या किसमिस झन खावय। <verse eid="NUM 6:3"/><verse number="4" style="v" sid="NUM 6:4"/>जब तक नाजीर ह मन्नत बर अलग रहिथे, तब तक जरूरी अय कि ओह अंगूर के नार के कोनो चीज ला झन खावय, इहां तक कि अंगूर के छिलका या बीजा ला घलो झन खावय।<verse eid="NUM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5"/>“ ‘नाजीर के मन्नत माने के पूरा समय ओह अपन मुड़ म उस्तरा झन चलवाय। ओह तब तक अलग रहय। जब तक कि यहोवा ला दिये समय ह खतम नइं हो जावय, तब तक ओह पबितर बने रहय; ओह अपन चुंदी ला लम्बा बाढ़न देवय।<verse eid="NUM 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 6:6"/>“ ‘यहोवा ला अपन दिये गय समय के बीच म नाजीर ह कोनो लास के लकठा म झन जावय। <verse eid="NUM 6:6"/><verse number="7" style="v" sid="NUM 6:7"/>अऊ त अऊ यदि ओकर खुद के दाई या ददा या भाई या बहिनी घलो मर जावय, तभो ले ओह अपनआप ला ओमन के कारन संस्कार म असुध झन करय, काबरकि अपनआप ला यहोवा ले मन्नत बर सऊंपे के चिनहां ह ओकर मुड़ म हवय। <verse eid="NUM 6:7"/><verse number="8" style="v" sid="NUM 6:8"/>अपन मन्नत बर ओ पूरा समय म, ओह यहोवा बर पबितर ठहिरथे।<verse eid="NUM 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9"/>“ ‘यदि नाजीर के उहां रहत कोनो मनखे ह अचानक मर जावय, त फेर ओकर बाल ह असुध हो जाथे, जऊन ह कि ओकर मन्नत बर चिनहां अय, ये स्थिति म सातवां दिन याने कि सुध होय के दिन, ओह अपन मुड़ मुड़ा ले। <verse eid="NUM 6:9"/><verse number="10" style="v" sid="NUM 6:10"/>तब आठवां दिन, ओह मिलापवाला तम्बू के मुंहटा म पुरोहित करा दू ठन पंड़की या दू ठन परेवा पीला लानय। <verse eid="NUM 6:10"/><verse number="11" style="v" sid="NUM 6:11"/>पुरोहित ह नाजीर बर पछताप करे के खातिर एक ठन ला पाप-बलिदान अऊ आने ला होम-बलिदान के रूप म चघावय, काबरकि ओह लास करा रहे के दुवारा पाप करे हवय। ओहीच दिन ओह अपन मुड़ ला फेर पबितर करय। <verse eid="NUM 6:11"/><verse number="12" style="v" sid="NUM 6:12"/>ओह फेर अपनआप ला मन्नत बर यहोवा ला सऊंपे अऊ ओह दोस-बलिदान के रूप म एक साल के मेढ़ा-पीला लानय। पहिले के दिनमन ला झन गने जावय, काबरकि ओह अपन मन्नत के दौरान असुध हो गे रिहिस।<verse eid="NUM 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13"/>“ ‘जब नाजीर के मन्नत बर ठहिराय समय ह पूरा हो जाथे, त येह ओकर कानून अय। ओला मिलापवाला तम्बू के मुंहटा करा लाने जावय। <verse eid="NUM 6:13"/><verse number="14" style="v" sid="NUM 6:14"/>उहां ओह यहोवा बर अपन बलिदान चघावय: होम-बलिदान बर एक साल के निरदोस मेढ़ा-पीला, पाप-बलिदान बर एक साल के निरदोस भेड़ी-पीला, अऊ मेल-बलिदान बर एक ठन निरदोस मेढ़ा, <verse eid="NUM 6:14"/><verse number="15" style="v" sid="NUM 6:15"/>संग म अपन अन्न-बलिदान अऊ पेय-बलिदान, अऊ एक टुकना अखमीरी रोटी, जऊन ह बढ़िया किसम के पीसान ले बने होवय—मोटहा रोटीमन म जैतून तेल मिले होवय, अऊ पातर रोटीमन के ऊपर जैतून तेल चुपरे होवय।<verse eid="NUM 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16"/>“ ‘पुरोहित ह ये जम्मो चीज ला यहोवा के आघू म लानय अऊ पाप-बलिदान अऊ होम-बलिदान चघावय। <verse eid="NUM 6:16"/><verse number="17" style="v" sid="NUM 6:17"/>पुरोहित ह अखमीरी रोटी के टोकरी ला लानय अऊ मेढ़ा ला मेल-बलिदान के रूप म यहोवा ला चढ़ावा चघावय, संग म अन्न-बलिदान अऊ पेय-बलिदान ला घलो चघावय।<verse eid="NUM 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18"/>“ ‘तब मिलापवाला तम्बू के मुंहटा म, नाजीर ह अपन ओ बाल ला मुड़ावय, जऊन ह कि ओकर मन्नत बर चिनहां अय। तब ओह ओ बाल ला ले जाके ओ आगी म डार देवय, जऊन ह मेल-बलिदान के चढ़ावा के खाल्हे म होथे।<verse eid="NUM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19"/>“ ‘जब नाजीर ह बाल ला मुड़वा लेवय, जऊन ह ओकर मन्नत बर चिनहां अय, तब पुरोहित ह ओकर हांथ म मेढ़ा के एक ठन उबले कंधा, अऊ टुकना के एक ठन मोटहा अखमीरी रोटी अऊ एक ठन पातर अखमीरी रोटी रख देवय। <verse eid="NUM 6:19"/><verse number="20" style="v" sid="NUM 6:20"/>तब पुरोहित ह येमन ला हलाय-बलिदान के रूप म यहोवा के आघू म हलावय; येमन पबितर अंय अऊ पुरोहित के अंय, संग म ओ छाती, जेला हलाय गीस अऊ ओ जांघ जेला चघाय गीस, ओमन घलो पुरोहित के अंय। ओकर बाद, नाजीर ह अंगूर के मंद पी सकथे।<verse eid="NUM 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21"/>“ ‘येह नाजीर के कानून ए, जऊन ह अपन मन्नत के मुताबिक यहोवा ला मन्नत के चढ़ावा चघाथे, येकर अलावा अऊ जऊन कुछू ओह दे सकथे, ओह देवय। येह जरूरी अय कि ओह अपन माने गय मन्नत ला नाजीर के कानून के मुताबिक पूरा करय।’ ”<verse eid="NUM 6:21"/></para>
  <para style="s1">पुरोहितमन के आसीस</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 6:22"/><verse number="23" style="v" sid="NUM 6:23"/>“हारून अऊ ओकर बेटामन ला कह, ‘ये किसम ले तुमन इसरायलीमन ला आसीस देवव। ओमन ला कहव:<verse eid="NUM 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24"/>“ ‘ “यहोवा तुमन ला आसीस देवय</para>
  <para style="q2" vid="NUM 6:24">अऊ तुम्हर रकछा करय;<verse eid="NUM 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25"/>यहोवा ह अपन चेहरा के अंजोर तुम्हर ऊपर चमकाय</para>
  <para style="q2" vid="NUM 6:25">अऊ अनुग्रह करय;<verse eid="NUM 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26"/>यहोवा ह अपन चेहरा तुम्हर कोति करय</para>
  <para style="q2" vid="NUM 6:26">अऊ तुमन ला सांति देवय।” ’<verse eid="NUM 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27"/>“ये किसम ले ओमन मोर नांव ला इसरायलीमन म रखंय अऊ मेंह ओमन ला आसीस दूहूं।”<verse eid="NUM 6:27"/></para>
  <chapter eid="NUM 6"/>
  <chapter number="7" style="c" sid="NUM 7"/>
  <para style="s1">परमेसर के पबितर-तम्बू के समरपन के बेरा चढ़ावा</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1"/>जब मूसा ह पबितर-तम्बू ला खड़े कर लीस, त ओह ओला ओकर जम्मो सामान सहित अभिसेक करिस अऊ ओला पबितर करिस। ओह बेदी अऊ ओकर जम्मो बरतनमन ला घलो अभिसेक करिस अऊ पबितर करिस, <verse eid="NUM 7:1"/><verse number="2" style="v" sid="NUM 7:2"/>तब इसरायल के अगुवामन, परिवारमन के ओ मुखियामन बलिदान चघाईन, जऊन मन ओमन के गोत्र के मुखिया रिहिन, जेमन ला गने गीस। <verse eid="NUM 7:2"/><verse number="3" style="v" sid="NUM 7:3"/>ओमन यहोवा के आघू म अपन चढ़ावा के रूप म छै ठन ढंपे बईला गाड़ी अऊ बारह ठन बईला लानिन—एक बईला एक अगुवा ले अऊ एक गाड़ी हर दू झन अगुवा ले। येमन ला ओमन पबितर-तम्बू के आघू म भेंट कर दीन।<verse eid="NUM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4"/>तब यहोवा ह मूसा ला कहिस, <verse eid="NUM 7:4"/><verse number="5" style="v" sid="NUM 7:5"/>“ये चीजमन ला ओमन ले लेय ले, ताकि येमन के उपयोग मिलापवाला तम्बू के काम म करे जा सकय। लेवीमन ला ओमन के काम के मुताबिक येमन ला देय दे।”<verse eid="NUM 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6"/>तब मूसा ह गाड़ी अऊ बईलामन ला लेके लेवीमन ला दे दीस। <verse eid="NUM 7:6"/><verse number="7" style="v" sid="NUM 7:7"/>ओह गेरसोन के परिवार ला ओमन के काम के मुताबिक दू ठन गाड़ी अऊ चार ठन बईला दीस, <verse eid="NUM 7:7"/><verse number="8" style="v" sid="NUM 7:8"/>अऊ मरारीमन ला ओमन के काम के मुताबिक चार ठन गाड़ी अऊ आठ ठन बईला दीस। ओमन जम्मो हारून पुरोहित के बेटा ईतामार के अधीन काम करंय। <verse eid="NUM 7:8"/><verse number="9" style="v" sid="NUM 7:9"/>पर मूसा ह कहातीमन ला कुछू नइं दीस, काबरकि ओमन पबितर चीजमन ला अपन कंधा म उठाके ले जावंय, अऊ येह ओमन के जिम्मेदारी रिहिस।<verse eid="NUM 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10"/>जब बेदी के अभिसेक करे गीस, तब अगुवामन येकर समरपन बर अपन चढ़ावा ला लानके बेदी के आघू म रखिन। <verse eid="NUM 7:10"/><verse number="11" style="v" sid="NUM 7:11"/>काबरकि यहोवा ह मूसा ला कहे रिहिस, “बेदी के समरपन बर हर दिन एक अगुवा अपन चढ़ावा ला लानय।”<verse eid="NUM 7:11"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="12" style="v" sid="NUM 7:12"/>जऊन ह पहिले दिन चढ़ावा लानिस, ओह यहूदा के गोत्र के अमीनादाब के बेटा नहसोन रिहिस।<verse eid="NUM 7:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 7:13"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:13">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">लगभग 1.5 किलोग्राम</char></note> वजन के एक ठन चांदी के थाली अऊ सत्तर सेकेल<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">लगभग 800 ग्राम</char></note> वजन के छिंचनेवाला एक ठन चांदी के कटोरा; अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन;<verse eid="NUM 7:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="NUM 7:14"/>धूप ले भरे दस सेकेल<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">लगभग 115 ग्राम</char></note> के एक ठन सोन के धूपदान;<verse eid="NUM 7:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="NUM 7:15"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 7:16"/>पाप-बलिदान<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">सुध होय के बलिदान</char></note> बर एक ठन बोकरा;<verse eid="NUM 7:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 7:17"/>अऊ मेल-बलिदान के रूप म चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:17">येह अमीनादाब के बेटा नहसोन के चढ़ावा रिहिस।<verse eid="NUM 7:17"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="18" style="v" sid="NUM 7:18"/>दूसर दिन इस्साकार गोत्र के अगुवा सूआर के बेटा नतनेल अपन चढ़ावा लानिस।<verse eid="NUM 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 7:19"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:19">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल के एक ठन चांदी के थाली अऊ सत्तर सेकेल के एक ठन छिंचनेवाला चांदी के कटोरा; अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन;<verse eid="NUM 7:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="NUM 7:20"/>धूप ले भरे दस सेकेल के एक ठन सोन के धूपदान;<verse eid="NUM 7:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 7:21"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="NUM 7:22"/>पाप-बलिदान बर एक ठन बोकरा;<verse eid="NUM 7:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="NUM 7:23"/>अऊ मेल-बलिदान के रूप म चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:23">येह सूआर के बेटा नतनेल के चढ़ावा रिहिस।<verse eid="NUM 7:23"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="24" style="v" sid="NUM 7:24"/>तीसर दिन, जबूलून के मनखेमन के अगुवा हेलोन के बेटा एलीआब अपन चढ़ावा लानिस।<verse eid="NUM 7:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 7:25"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:25">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल के एक ठन चांदी के थाली अऊ सत्तर सेकेल के एक ठन छिंचनेवाला चांदी के कटोरा, अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन।<verse eid="NUM 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="NUM 7:26"/>धूप ले भरे दस सेकेल के एक ठन सोन के धूपदान;<verse eid="NUM 7:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="NUM 7:27"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="NUM 7:28"/>पाप-बलिदान बर एक ठन बोकरा;<verse eid="NUM 7:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="NUM 7:29"/>अऊ मेल-बलिदान के रूप म चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:29">येह हेलोन के बेटा एलीआब के चढ़ावा रिहिस।<verse eid="NUM 7:29"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="30" style="v" sid="NUM 7:30"/>चौथा दिन, रूबेन के मनखेमन के अगुवा सदेऊर के बेटा एलीसूर अपन चढ़ावा लानिस।<verse eid="NUM 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 7:31"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:31">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल के एक ठन चांदी के थाली अऊ सत्तर सेकेल के छिंचनेवाला एक ठन चांदी के कटोरा, अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन;<verse eid="NUM 7:31"/></para>
  <para style="li2">
    <verse number="32" style="v" sid="NUM 7:32"/>धूप ले भरे दस सेकेल के एक ठन सोन के धूपदान;<verse eid="NUM 7:32"/></para>
  <para style="li2">
    <verse number="33" style="v" sid="NUM 7:33"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="NUM 7:34"/>पाप-बलिदान बर एक ठन बोकरा;<verse eid="NUM 7:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 7:35"/>अऊ मेल-बलिदान चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:35">येह सदेऊर के बेटा एलीसूर के चढ़ावा रिहिस।<verse eid="NUM 7:35"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="36" style="v" sid="NUM 7:36"/>पांचवां दिन सिमोन के मनखेमन के अगुवा सूरीसद्दाय के बेटा सलूमीएल अपन चढ़ावा लानिस।<verse eid="NUM 7:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="NUM 7:37"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:37">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल के एक ठन चांदी के थाली अऊ सत्तर सेकेल के छिंचनेवाला एक ठन चांदी के कटोरा; अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन;<verse eid="NUM 7:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="NUM 7:38"/>धूप ले भरे, दस सेकेल के एक ठन सोन के धूपदान;<verse eid="NUM 7:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 7:39"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 7:40"/>पाप-बलिदान बर एक ठन बोकरा;<verse eid="NUM 7:40"/></para>
  <para style="li2">
    <verse number="41" style="v" sid="NUM 7:41"/>अऊ मेल-बलिदान चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:41">येह सूरीसद्दाय के बेटा सलूमीएल के चढ़ावा रिहिस।<verse eid="NUM 7:41"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="42" style="v" sid="NUM 7:42"/>छठवां दिन गाद के मनखेमन के अगुवा दूएल के बेटा एलियासाप अपन चढ़ावा लानिस।<verse eid="NUM 7:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="NUM 7:43"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:43">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल के एक ठन चांदी के थाली अऊ सत्तर सेकेल के छिंचनेवाला एक ठन चांदी के कटोरा; अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन;<verse eid="NUM 7:43"/></para>
  <para style="li2">
    <verse number="44" style="v" sid="NUM 7:44"/>धूप ले भरे, दस सेकेल के एक ठन सोन के धूपदान;<verse eid="NUM 7:44"/></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 7:45"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="NUM 7:46"/>पाप-बलिदान बर एक ठन बोकरा;<verse eid="NUM 7:46"/></para>
  <para style="li2">
    <verse number="47" style="v" sid="NUM 7:47"/>अऊ मेल-बलिदान चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:47">येह दूएल के बेटा एलियासाप के चढ़ावा रिहिस।<verse eid="NUM 7:47"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="48" style="v" sid="NUM 7:48"/>सातवां दिन एपरैम के मनखेमन के अगुवा अमीहूद के बेटा एलीसामा अपन चढ़ावा लानिस।<verse eid="NUM 7:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="NUM 7:49"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:49">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल के एक ठन चांदी के थाली अऊ सत्तर सेकेल के छिंचनेवाला एक ठन चांदी के कटोरा; अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन;<verse eid="NUM 7:49"/></para>
  <para style="li2">
    <verse number="50" style="v" sid="NUM 7:50"/>धूप ले भरे, दस सेकेल के एक ठन सोन के धूपदान;<verse eid="NUM 7:50"/></para>
  <para style="li2">
    <verse number="51" style="v" sid="NUM 7:51"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="NUM 7:52"/>पाप-बलिदान बर एक ठन बोकरा;<verse eid="NUM 7:52"/></para>
  <para style="li2">
    <verse number="53" style="v" sid="NUM 7:53"/>अऊ मेल-बलिदान चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:53">येह अमीहूद के बेटा एलीसामा के चढ़ावा रिहिस।<verse eid="NUM 7:53"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="54" style="v" sid="NUM 7:54"/>आठवां दिन मनस्से के मनखेमन के अगुवा पदासूर के बेटा गमलीएल ह अपन चढ़ावा लानिस।<verse eid="NUM 7:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="NUM 7:55"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:55">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल के एक ठन चांदी के थाली अऊ सत्तर सेकेल के छिंचनेवाला एक ठन चांदी के कटोरा; अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन;<verse eid="NUM 7:55"/></para>
  <para style="li2">
    <verse number="56" style="v" sid="NUM 7:56"/>धूप ले भरे दस सेकेल के एक ठन सोन के धूपदान;<verse eid="NUM 7:56"/></para>
  <para style="li2">
    <verse number="57" style="v" sid="NUM 7:57"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:57"/></para>
  <para style="li2">
    <verse number="58" style="v" sid="NUM 7:58"/>पाप-बलिदान बर एक ठन बोकरा;<verse eid="NUM 7:58"/></para>
  <para style="li2">
    <verse number="59" style="v" sid="NUM 7:59"/>अऊ मेल-बलिदान चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:59">येह पदासूर के बेटा गमलीएल के चढ़ावा रिहिस।<verse eid="NUM 7:59"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="60" style="v" sid="NUM 7:60"/>नौवां दिन बिनयामीन के मनखेमन के अगुवा गिदोनी के बेटा अबीदान ह अपन चढ़ावा लानिस।<verse eid="NUM 7:60"/></para>
  <para style="li1">
    <verse number="61" style="v" sid="NUM 7:61"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:61">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल के एक ठन चांदी के थाली अऊ सत्तर सेकेल के एक ठन छिंचनेवाला चांदी के कटोरा; अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन;<verse eid="NUM 7:61"/></para>
  <para style="li2">
    <verse number="62" style="v" sid="NUM 7:62"/>धूप ले भरे दस सेकेल के एक ठन सोन के धूपदान;<verse eid="NUM 7:62"/></para>
  <para style="li2">
    <verse number="63" style="v" sid="NUM 7:63"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:63"/></para>
  <para style="li2">
    <verse number="64" style="v" sid="NUM 7:64"/>पाप-बलिदान बर एक ठन बोकरा;<verse eid="NUM 7:64"/></para>
  <para style="li2">
    <verse number="65" style="v" sid="NUM 7:65"/>अऊ मेल-बलिदान चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:65">येह गिदोनी के बेटा अबीदान के चढ़ावा रिहिस।<verse eid="NUM 7:65"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="66" style="v" sid="NUM 7:66"/>दसवां दिन दान के मनखेमन के अगुवा अम्मीसद्दाय के बेटा अहीएजेर ह अपन चढ़ावा लानिस।<verse eid="NUM 7:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="NUM 7:67"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:67">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल के एक ठन चांदी के थाली अऊ सत्तर सेकेल के छिंचनेवाला एक ठन चांदी के कटोरा; अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन;<verse eid="NUM 7:67"/></para>
  <para style="li2">
    <verse number="68" style="v" sid="NUM 7:68"/>धूप ले भरे, दस सेकेल के एक ठन सोन के धूपदान;<verse eid="NUM 7:68"/></para>
  <para style="li2">
    <verse number="69" style="v" sid="NUM 7:69"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:69"/></para>
  <para style="li2">
    <verse number="70" style="v" sid="NUM 7:70"/>पाप-बलिदान बर एक ठन बोकरा;<verse eid="NUM 7:70"/></para>
  <para style="li2">
    <verse number="71" style="v" sid="NUM 7:71"/>अऊ मेल-बलिदान चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:71">येह अम्मीसद्दाय के बेटा अहीएजेर के चढ़ावा रिहिस।<verse eid="NUM 7:71"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="72" style="v" sid="NUM 7:72"/>गियारहवां दिन आसेर के मनखेमन के अगुवा ओकरान के बेटा पगीएल अपन चढ़ावा लानिस।<verse eid="NUM 7:72"/></para>
  <para style="li1">
    <verse number="73" style="v" sid="NUM 7:73"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:73">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल के चांदी के एक ठन थाली अऊ सत्तर सेकेल के छिंचनेवाला एक ठन चांदी के कटोरा; अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन;<verse eid="NUM 7:73"/></para>
  <para style="li2">
    <verse number="74" style="v" sid="NUM 7:74"/>धूप ले भरे, दस सेकेल के एक ठन सोन के धूपदान;<verse eid="NUM 7:74"/></para>
  <para style="li2">
    <verse number="75" style="v" sid="NUM 7:75"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:75"/></para>
  <para style="li2">
    <verse number="76" style="v" sid="NUM 7:76"/>पाप-बलिदान बर एक ठन बोकरा;<verse eid="NUM 7:76"/></para>
  <para style="li2">
    <verse number="77" style="v" sid="NUM 7:77"/>अऊ मेल-बलिदान चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:77">येह ओकरान के बेटा पगीएल के चढ़ावा रिहिस।<verse eid="NUM 7:77"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="78" style="v" sid="NUM 7:78"/>बारहवां दिन नपताली के मनखेमन के अगुवा एनान के बेटा अहीरा अपन चढ़ावा लानिस।<verse eid="NUM 7:78"/></para>
  <para style="li1">
    <verse number="79" style="v" sid="NUM 7:79"/>ओकर चढ़ावा ये रिहिस:</para>
  <para style="li2" vid="NUM 7:79">पबितर-स्थान के सेकेल के मुताबिक एक सौ तीस सेकेल के चांदी के एक ठन थाली अऊ सत्तर सेकेल के छिंचनेवाला चांदी के एक ठन कटोरा; अन्न-बलिदान के रूप म ये दूनों चीज जैतून तेल ले सने उत्तम पीसान ले भरे रिहिन;<verse eid="NUM 7:79"/></para>
  <para style="li2">
    <verse number="80" style="v" sid="NUM 7:80"/>धूप ले भरे, दस सेकेल के एक ठन सोन के धूपदान;<verse eid="NUM 7:80"/></para>
  <para style="li2">
    <verse number="81" style="v" sid="NUM 7:81"/>होम-बलिदान बर एक ठन बछवा, एक ठन मेढ़ा अऊ एक साल के एक ठन मेढ़ा-पीला;<verse eid="NUM 7:81"/></para>
  <para style="li2">
    <verse number="82" style="v" sid="NUM 7:82"/>पाप-बलिदान बर एक ठन बोकरा;<verse eid="NUM 7:82"/></para>
  <para style="li2">
    <verse number="83" style="v" sid="NUM 7:83"/>अऊ मेल-बलिदान चघाय बर दू ठन बईला, पांच ठन मेढ़ा, पांच ठन बोकरा अऊ एक-एक साल के पांच ठन मेढ़ा-पीला।</para>
  <para style="lf" vid="NUM 7:83">येह एनान के बेटा अहीरा के चढ़ावा रिहिस।<verse eid="NUM 7:83"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="84" style="v" sid="NUM 7:84"/>जब बेदी के अभिसेक करे गीस, त ओकर समरपन बर इसरायली अगुवामन के ये चढ़ावा रिहिन:</para>
  <para style="li2" vid="NUM 7:84">चांदी के बारह थाली, छिंचे बर चांदी के बारह कटोरा अऊ सोन के बारह धूपदान। <verse eid="NUM 7:84"/><verse number="85" style="v" sid="NUM 7:85"/>हर चांदी के थाली के वजन एक सौ तीस सेकेल, अऊ हर छिंचनेवाला कटोरा के वजन सत्तर सेकेल रिहिस। पबितर-स्थान के सेकेल के मुताबिक, जम्मो चांदी के बरतन के वजन दू हजार चार सौ सेकेल<note caller="+" style="f"><char style="fr" closed="false">7:85 </char><char style="ft" closed="false">लगभग 28 किलोग्राम</char></note> रिहिस। <verse eid="NUM 7:85"/><verse number="86" style="v" sid="NUM 7:86"/>पबितर-स्थान के सेकेल के मुताबिक, धूप ले भरे बारह सोन के धूपदान म ले हर एक के वजन दस सेकेल रिहिस। जम्मो धूपदान के वजन एक सौ बीस सेकेल<note caller="+" style="f"><char style="fr" closed="false">7:86 </char><char style="ft" closed="false">लगभग 1.4 किलोग्राम</char></note> रिहिस।<verse eid="NUM 7:86"/></para>
  <para style="li2">
    <verse number="87" style="v" sid="NUM 7:87"/>होम-बलिदान बर पसुमन के कुल संखिया ओमन के अन्न-बलिदान के संग बारह ठन बछवा, बारह ठन मेढ़ा अऊ एक-एक साल के बारह ठन मेढ़ा-पीला रिहिस। पाप-बलिदान बर बारह ठन बोकरा के उपयोग करे गीस।<verse eid="NUM 7:87"/></para>
  <para style="li2">
    <verse number="88" style="v" sid="NUM 7:88"/>मेल-बलिदान चघाय बर पसुमन के कुल संखिया चौबीस ठन बईला, साठ ठन मेढ़ा, साठ ठन बोकरा अऊ एक-एक साल के साठ ठन मेढ़ा-पीला रिहिस।</para>
  <para style="b" vid="NUM 7:88"/>
  <para style="lf" vid="NUM 7:88">बेदी ला अभिसेक करे के बाद, ओकर समरपन बर येमन ओकर चढ़ावा रिहिन।<verse eid="NUM 7:88"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89"/>जब मूसा ह यहोवा ले गोठियाय बर मिलापवाला तम्बू के भीतर गीस, त करार कानून के सन्दूक ला ढंके पछताप ढकना के ऊपर दूनों करूबमन के बीच ले ओला गोठियाय के अवाज सुनाई दीस। ये किसम ले यहोवा ह मूसा ले गोठियाईस।<verse eid="NUM 7:89"/></para>
  <chapter eid="NUM 7"/>
  <chapter number="8" style="c" sid="NUM 8"/>
  <para style="s1">दीयामन ला मढ़ई</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 8:1"/><verse number="2" style="v" sid="NUM 8:2"/>“हारून ले बात कर अऊ ओला कह, ‘जब भी तेंह दीयामन ला मढ़ाथस, त धियान रख कि जम्मो सातों दीया दीवट के सामने कोति अंजोर देवंय।’ ”<verse eid="NUM 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3"/>हारून ह वइसने करिस; ओह दीयामन ला मढ़ाईस कि ओमन दीवट के सामने अंजोर देवंय, जइसे कि यहोवा ह मूसा ला हुकूम दे रिहिस। <verse eid="NUM 8:3"/><verse number="4" style="v" sid="NUM 8:4"/>ये दीवट ला ये किसम ले बनाय गे रिहिस: येकर आधार ले लेके येकर फूल तक येह हथौड़ी ले पीटे गय सोन के बने रिहिस। दीवट ह बिलकुल ओहीच नमूना म बने रिहिस, जइसे कि यहोवा ह मूसा ला देखाय रिहिस।<verse eid="NUM 8:4"/></para>
  <para style="s1">लेवीमन ला अलग करई</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5"/>फेर यहोवा ह मूसा ला कहिस: <verse eid="NUM 8:5"/><verse number="6" style="v" sid="NUM 8:6"/>“जम्मो इसरायलीमन के बीच ले लेवीमन ला अलग कर अऊ ओमन ला बिधि के मुताबिक सुध कर। <verse eid="NUM 8:6"/><verse number="7" style="v" sid="NUM 8:7"/>ओमन ला सुध करे बर तेंह अइसने कर: सुध करइया पानी के छिड़काव ओमन ऊपर कर; तब ओमन अपन पूरा देहें म उस्तरा चलवांय अऊ अपन कपड़ा ला धोवंय। अऊ अइसने ओमन अपनआप ला सुध करंय। <verse eid="NUM 8:7"/><verse number="8" style="v" sid="NUM 8:8"/>तब ओमन जैतून तेल ले सने उत्तम पीसान के अन्न-बलिदान के संग एक ठन बछवा लेवंय, अऊ पाप-बलिदान<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुधिकरन-बलिदान</char></note> बर तें एक ठन दूसर बछवा ले। <verse eid="NUM 8:8"/><verse number="9" style="v" sid="NUM 8:9"/>ओकर बाद लेवीमन ला मिलापवाला तम्बू के आघू म लान अऊ जम्मो इसरायली समाज ला इकट्ठा कर। <verse eid="NUM 8:9"/><verse number="10" style="v" sid="NUM 8:10"/>तेंह लेवीमन ला यहोवा के आघू म लानबे, अऊ इसरायलीमन ओमन ऊपर अपन हांथ रखंय। <verse eid="NUM 8:10"/><verse number="11" style="v" sid="NUM 8:11"/>तब हारून ह इसरायलीमन कोति ले लेवीमन ला यहोवा के आघू म एक हलाय-बलिदान के रूप म लानय, ताकि ओमन यहोवा के काम करे बर तियार होवंय।<verse eid="NUM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 8:12"/>“तब लेवीमन अपन हांथ बछवामन के मुड़ ऊपर रखंय; येमा के एक ठन बछवा के उपयोग यहोवा ला पाप-बलिदान बर अऊ दूसर बछवा के उपयोग लेवीमन के पछताप करे बर होम-बलिदान के रूप म करे जावय। <verse eid="NUM 8:12"/><verse number="13" style="v" sid="NUM 8:13"/>ओकर बाद लेवीमन ला हारून अऊ ओकर बेटामन के आघू म ठाढ़ कर अऊ तब ओमन ला एक हलाय-बलिदान के रूप म यहोवा ला अरपन कर। <verse eid="NUM 8:13"/><verse number="14" style="v" sid="NUM 8:14"/>ये किसम ले तेंह लेवीमन ला आने इसरायलीमन ले अलग करबे, अऊ लेवीमन मोर होहीं।<verse eid="NUM 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 8:15"/>“जब तेंह लेवीमन ला सुध करके ओमन ला एक हलाय-बलिदान के रूप म अरपन कर लेबे, तब ओमन मिलापवाला तम्बू म अपन काम करे बर आवंय। <verse eid="NUM 8:15"/><verse number="16" style="v" sid="NUM 8:16"/>येमन ओ इसरायली अंय, जेमन ला पूरा मोला दिये जावय। मेंह ओमन ला अपन जानके के पहिलांतमन के जगह म याने कि हर एक इसरायली माईलोगनमन के पहिला जनमे लड़का के रूप म लेय ले हंव। <verse eid="NUM 8:16"/><verse number="17" style="v" sid="NUM 8:17"/>इसरायल म हर पहिला जनमे नर, चाहे ओह मनखे होवय या पसु, ओह मोर अय। मेंह ओमन ला अपन बर पबितर करे हंव, जब मेंह मिसर देस म जम्मो पहिलांतमन ला मार डारेंव। <verse eid="NUM 8:17"/><verse number="18" style="v" sid="NUM 8:18"/>अऊ मेंह इसरायल म जम्मो पहिलांत बेटामन के जगह म लेवीमन ला लेय ले हंव। <verse eid="NUM 8:18"/><verse number="19" style="v" sid="NUM 8:19"/>जम्मो इसरायलीमन के बीच ले, मेंह लेवीमन ला एक भेंट के रूप म हारून अऊ ओकर बेटामन ला देय दे हंव कि ओमन इसरायलीमन कोति ले मिलापवाला तम्बू म काम करंय अऊ ओमन बर प्रायस्चित करंय, ताकि जब इसरायलीमन पबितर-स्थान के लकठा म जावंय त ओमन ऊपर कोनो महामारी झन आवय।”<verse eid="NUM 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20"/>मूसा, हारून अऊ पूरा इसरायली समाज ह लेवीमन के संग वइसे ही करिन, जइसे यहोवा ह मूसा ला हुकूम दे रिहिस। <verse eid="NUM 8:20"/><verse number="21" style="v" sid="NUM 8:21"/>लेवीमन अपनआप ला सुध करिन अऊ अपन ओनहा ला धोईन। तब हारून ह ओमन ला यहोवा के आघू म हलाय-बलिदान के रूप म अरपन करिस अऊ ओमन ला सुध करे बर ओमन बर प्रायस्चित करिस। <verse eid="NUM 8:21"/><verse number="22" style="v" sid="NUM 8:22"/>ओकर बाद, लेवीमन हारून अऊ ओकर बेटामन के देखरेख म मिलापवाला तम्बू म अपन काम करे बर आईन। ओमन लेवीमन के संग वइसने ही करिन, जइसे यहोवा ह मूसा ला हुकूम दे रिहिस।<verse eid="NUM 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 8:23"/><verse number="24" style="v" sid="NUM 8:24"/>“ये नियम लेवीमन ऊपर लागू होथे: पच्चीस साल या ओकर ले जादा उमर के मनखेमन मिलापवाला तम्बू म काम करे बर आवंय, <verse eid="NUM 8:24"/><verse number="25" style="v" sid="NUM 8:25"/>पर पचास साल के उमर म, ओमन अपन नियमित सेवा ले हट जावंय अऊ फेर काम झन करंय। <verse eid="NUM 8:25"/><verse number="26" style="v" sid="NUM 8:26"/>येकर बाद ओमन मिलापवाला तम्बू म अपन भाईमन<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">अपन संगी लेवीमन</char></note> के काम म मदद कर सकत हें, पर ओमन खुद होके कोनो काम झन करंय। ये किसम ले तेंह लेवीमन ला ओमन के जिम्मेदारी सऊंपबे।”<verse eid="NUM 8:26"/></para>
  <chapter eid="NUM 8"/>
  <chapter number="9" style="c" sid="NUM 9"/>
  <para style="s1">फसह के तिहार</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1"/>इसरायलीमन के मिसर देस ले निकल आय के दूसरा साल के पहिला महिना म यहोवा ह सीनय के सुन्ना जगह म मूसा ला कहिस, <verse eid="NUM 9:1"/><verse number="2" style="v" sid="NUM 9:2"/>“इसरायलीमन ठहिराय गे समय म फसह के तिहार मनावंय। <verse eid="NUM 9:2"/><verse number="3" style="v" sid="NUM 9:3"/>ठहिराय गे समय म, इही महिना के चौदहवां दिन सूरज बुड़े के पाछू, तुमन येला येकर जम्मो नियम अऊ बिधि के मुताबिक मनावव।”<verse eid="NUM 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 9:4"/>तब मूसा ह इसरायलीमन ला फसह के तिहार मनाय बर कहिस, <verse eid="NUM 9:4"/><verse number="5" style="v" sid="NUM 9:5"/>अऊ ओमन सीनय के सुन्ना जगह म, पहिला महिना के चौदहवां दिन, सूरज बुड़े के पाछू फसह ला मनाईन। इसरायलीमन हर चीज वइसने ही करिन, जइसने कि यहोवा ह मूसा ला हुकूम दे रिहिस।<verse eid="NUM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6"/>पर ओमा के कुछू झन ओ दिन फसह नइं मना सकिन, काबरकि एक लास के कारन ओमन बिधि के मुताबिक असुध रिहिन। एकरसेति ओहीच दिन ओमन मूसा अऊ हारून करा आईन <verse eid="NUM 9:6"/><verse number="7" style="v" sid="NUM 9:7"/>अऊ मूसा ला कहिन, “हमन एक लास के कारन असुध हो गे हन, पर ठहिराय गे समय म, यहोवा ला चढ़ावा चघाय बर, आने इसरायलीमन ले हमन ला काबर अलग करे जावथे?”<verse eid="NUM 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8"/>मूसा ह ओमन ला जबाब दीस, “मेंह पता लगात हंव कि तुम्हर बारे म यहोवा के का हुकूम अय, तब तक तुमन ठहिरे रहव।”<verse eid="NUM 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9"/>तब यहोवा ह मूसा ला कहिस, <verse eid="NUM 9:9"/><verse number="10" style="v" sid="NUM 9:10"/>“इसरायलीमन ला बता: ‘जब तुमन म ले कोनो या तुम्हर संतान म के कोनो मनखे कोनो लास के कारन असुध हवय या कोनो काम ले बाहिर गे हवय, तब भी ओह यहोवा के फसह ला मना सकत हे, <verse eid="NUM 9:10"/><verse number="11" style="v" sid="NUM 9:11"/>पर ओह दूसरा महिना के चौदहवां दिन बेर बुड़े के बाद येला मनावय। ओह मेढ़ा के मांस ला अखमीरी रोटी अऊ करू साग के संग खावय। <verse eid="NUM 9:11"/><verse number="12" style="v" sid="NUM 9:12"/>ओह बिहनियां होवत तक कुछू ला झन छोंड़य या येकर कोनो हाड़ा ला झन टोरय। जब ओह फसह तिहार ला मनावय, त ओह जम्मो बिधि के पालन करय। <verse eid="NUM 9:12"/><verse number="13" style="v" sid="NUM 9:13"/>पर यदि बिधि के मुताबिक सुध हवय अऊ यातरा म नइं ए, पर फसह के तिहार ला नइं मनाथे, त ओला अपन मनखेमन ले अलग करे जाय, काबरकि ओह ठहिराय गे समय म यहोवा ला चढ़ावा के अरपन नइं करिस। ओह अपन पाप के दुख भोगही।<verse eid="NUM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14"/>“ ‘यदि कोनो परदेसी तुम्हर बीच म रहत हवय, त ओह घलो नियम अऊ बिधि के मुताबिक यहोवा के फसह ला मनावय। देस म जनमे मनखे अऊ परदेसी दूनों बर फसह माने के तुम्हर ओहीच बिधि होवय।’ ”<verse eid="NUM 9:14"/></para>
  <para style="s1">पबितर-तम्बू के ऊपर बादर</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15"/>जऊन दिन पबितर-तम्बू, करार कानून के तम्बू ला खड़े करे गीस, ओ दिन बादर ह येला ढांप लीस। सांझ ले लेके बिहनियां तक बादर ह पबितर-तम्बू ऊपर आगी सहीं दिखिस। <verse eid="NUM 9:15"/><verse number="16" style="v" sid="NUM 9:16"/>अऊ हर दिन अइसने ही होईस; बादर ह येला ढांपय, अऊ रथिया के बेरा येह आगी सहीं दिखय। <verse eid="NUM 9:16"/><verse number="17" style="v" sid="NUM 9:17"/>जब भी बादर ह तम्बू के ऊपर ले उठय, त इसरायलीमन आघू बढ़ंय, अऊ जिहां भी बादर ह ठहर जावय, उहां इसरायलीमन डेरा डालंय। <verse eid="NUM 9:17"/><verse number="18" style="v" sid="NUM 9:18"/>यहोवा के हुकूम ले इसरायलीमन आघू बढ़िन, अऊ ओकर हुकूम ले ही ओमन डेरा डालिन। जब तक बादर ह पबितर-तम्बू के ऊपर रहय, ओमन डेरा डाले रहंय। <verse eid="NUM 9:18"/><verse number="19" style="v" sid="NUM 9:19"/>जब बादर ह पबितर-तम्बू के ऊपर बहुंत दिन तक बने रहय, त इसरायलीमन यहोवा के हुकूम ला मानंय अऊ आघू नइं बढ़ंय। <verse eid="NUM 9:19"/><verse number="20" style="v" sid="NUM 9:20"/>कभू-कभू बादर ह पबितर-तम्बू ऊपर सिरिप कुछू दिन बर रहय; यहोवा के हुकूम ले ओमन डेरा डालंय, अऊ तब ओकर हुकूम ले ही ओमन आघू बढ़ंय। <verse eid="NUM 9:20"/><verse number="21" style="v" sid="NUM 9:21"/>कभू-कभू बादर ह सिरिप सांझ ले बिहनियां तक रहय, अऊ जब येह बिहनियां उठय, त ओमन आघू बढ़ जावंय। चाहे दिन हो या रथिया, जब भी बादर ह उठ जावय, ओमन आघू बढ़ जावंय। <verse eid="NUM 9:21"/><verse number="22" style="v" sid="NUM 9:22"/>जब भी बादर ह पबितर-तम्बू ऊपर दू दिन या एक महिना या एक साल बर ठहिरय, त इसरायलीमन डेरा म रहंय अऊ आघू नइं बढ़ंय; पर जब येह उठ जावय, त ओमन आघू बढ़ंय। <verse eid="NUM 9:22"/><verse number="23" style="v" sid="NUM 9:23"/>यहोवा के हुकूम ले ओमन डेरा डालंय, अऊ यहोवा के हुकूम ले ही ओमन आघू बढ़ंय। ओमन यहोवा के हुकूम मानंय, जेला ओह मूसा के जरिये ओमन ला देवय।<verse eid="NUM 9:23"/></para>
  <chapter eid="NUM 9"/>
  <chapter number="10" style="c" sid="NUM 10"/>
  <para style="s1">चांदी के तुरहीमन</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1"/>फेर यहोवा ह मूसा ला कहिस: <verse eid="NUM 10:1"/><verse number="2" style="v" sid="NUM 10:2"/>“चांदी ला पीटके दू ठन तुरही बना, अऊ ओमन के उपयोग समाज ला एक संग जूरे बर अऊ सिविर के आघू बढ़े बर कर। <verse eid="NUM 10:2"/><verse number="3" style="v" sid="NUM 10:3"/>जब दूनों तुरही बजाय जावंय, त पूरा समाज मिलापवाला तम्बू के दुवार म तोर आघू म जूर जावय। <verse eid="NUM 10:3"/><verse number="4" style="v" sid="NUM 10:4"/>अऊ यदि सिरिप एक ठन ला बजाय जावय, त अगुवामन—इसरायल के गोत्र के मुखियामन तोर आघू म जूर जावंय। <verse eid="NUM 10:4"/><verse number="5" style="v" sid="NUM 10:5"/>जब तुरही ला एक बार जोर से फूंके जावय, त पूरब दिसा म डेरा डाले गोत्र के मन आघू बढ़ंय। <verse eid="NUM 10:5"/><verse number="6" style="v" sid="NUM 10:6"/>तुरही ला दूसर बार जोर से फूंके जावय, त दक्खिन कोति डेरा डाले मनखेमन आघू बढ़ंय। तुरही ला जोर से फूंकई ह आघू बढ़े के संकेत होही। <verse eid="NUM 10:6"/><verse number="7" style="v" sid="NUM 10:7"/>समाज ला इकट्ठा करे बर तुरहीमन ला फूंके जावय, पर येमा आघू बढ़े के संकेत झन होवय।<verse eid="NUM 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 10:8"/>“हारून के बेटा, पुरोहितमन तुरही ला फूंकंय। येह हमेसा के बिधि होवय अऊ अवइया पीढ़ीमन म घलो येकर पालन करे जावय। <verse eid="NUM 10:8"/><verse number="9" style="v" sid="NUM 10:9"/>जब तुमन अपन ही देस म कोनो बईरी के बिरूध लड़े बर निकलव, जऊन ह तुम्हर ऊपर अतियाचार करत हे, त तुरहीमन ला एक बार जोर से बजावव। तब यहोवा तुम्हर परमेसर ह तुमन ला सुरता करही अऊ तुम्हर बईरीमन ले बचाही। <verse eid="NUM 10:9"/><verse number="10" style="v" sid="NUM 10:10"/>अपन आनंद मनाय के बेरा—तुम्हर ठहिराय गय तिहार अऊ नवां चंदा के जेवनार के बेरा, तुमन होम-बलिदान अऊ मेल-बलिदान चढ़ावा के समय तुरहीमन ला फूंकव, अऊ ओह तुम्हर बर परमेसर के आघू म एक सुरता करइया होही। मेंह यहोवा तुम्हर परमेसर अंव।”<verse eid="NUM 10:10"/></para>
  <para style="s1">इसरायलीमन के सीनय पहाड़ ले आघू बढ़ई</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11"/>इसरायलीमन के मिसर देस ले निकले के दूसरा साल के दूसरा महिना के बीसवां दिन बादर ह करार के कानून के पबितर-तम्बू के ऊपर ले उठ गीस। <verse eid="NUM 10:11"/><verse number="12" style="v" sid="NUM 10:12"/>तब इसरायलीमन सीनय के सुन्ना जगह ले आघू बढ़िन अऊ जगह-जगह होवत ओमन आघू बढ़त गीन जब तक कि बादर ह पारान के सुन्ना जगह म ठहर नइं गीस। <verse eid="NUM 10:12"/><verse number="13" style="v" sid="NUM 10:13"/>ओमन पहिली बार, मूसा के जरिये यहोवा के हुकूम के मुताबिक आघू बढ़िन।<verse eid="NUM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14"/>पहिले यहूदा के सिविर के दलमन अपन झंडा के अधीन आघू बढ़िन। अमीनादाब के बेटा नहसोन ओमन के अगुवा रिहिस। <verse eid="NUM 10:14"/><verse number="15" style="v" sid="NUM 10:15"/>इस्साकार गोत्र के दल के अगुवा सूआर के बेटा नतनेल, <verse eid="NUM 10:15"/><verse number="16" style="v" sid="NUM 10:16"/>अऊ जबूलून के गोत्र के दल के अगुवा हेलोन के बेटा एलीआब रिहिस। <verse eid="NUM 10:16"/><verse number="17" style="v" sid="NUM 10:17"/>तब पबितर-तम्बू ला उसाले गीस, अऊ गेरसोनी अऊ मरारीमन येला उठाके आघू बढ़िन।<verse eid="NUM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18"/>ओकर बाद, रूबेन के सिविर के दलमन अपन झंडा के अधीन आघू बढ़िन। सदेऊर के बेटा एलीसूर ओमन के अगुवा रिहिस। <verse eid="NUM 10:18"/><verse number="19" style="v" sid="NUM 10:19"/>सिमोन के गोत्र के दल के अगुवा सूरीसद्दाय के बेटा सलूमीएल, <verse eid="NUM 10:19"/><verse number="20" style="v" sid="NUM 10:20"/>अऊ गाद के गोत्र के दल के अगुवा दूएल के बेटा एलियासाप रिहिस। <verse eid="NUM 10:20"/><verse number="21" style="v" sid="NUM 10:21"/>तब कहातीमन पबितर चीजमन ला उठाके आघू बढ़िन। ओमन के हबरे के पहिले पबितर-तम्बू ला गाड़े जावय।<verse eid="NUM 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22"/>ओकर बाद एपरैम के सिविर के दलमन अपन झंडा के अधीन बढ़िन। अमीहूद के बेटा एलीसामा ह ओमन के अगुवा रिहिस। <verse eid="NUM 10:22"/><verse number="23" style="v" sid="NUM 10:23"/>मनस्से के गोत्र के दल के अगुवा पदासूर के बेटा गमलीएल, <verse eid="NUM 10:23"/><verse number="24" style="v" sid="NUM 10:24"/>अऊ बिनयामीन के गोत्र के दल के अगुवा गिदोनी के बेटा अबीदान रिहिस।<verse eid="NUM 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25"/>आखिरी म, जम्मो दल बर पाछू के पहरेदार के रूप म, दान के सिविर के दलमन अपन झंडा के अधीन आघू बढ़िन। अम्मीसद्दाय के बेटा अहीएजेर ओमन के अगुवा रिहिस। <verse eid="NUM 10:25"/><verse number="26" style="v" sid="NUM 10:26"/>आसेर के गोत्र के दल के अगुवा ओकरान के बेटा पगीएल, <verse eid="NUM 10:26"/><verse number="27" style="v" sid="NUM 10:27"/>अऊ नपताली के गोत्र के दल के अगुवा एनान के बेटा अहीरा रिहिस। <verse eid="NUM 10:27"/><verse number="28" style="v" sid="NUM 10:28"/>इसरायलीमन जब भी आघू बढ़ंय, त ओमन के दलमन के क्रम अइसने ही रहय।<verse eid="NUM 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29"/>मूसा ह अपन ससुर रूएल, जऊन ह मिदयानी रिहिस, ओकर बेटा होबाब ला कहिस, “हमन ओ जगह म जावत हन, जेकर बारे म यहोवा ह कहे हवय, ‘मेंह ओ जगह तुमन ला दूहूं।’ तें घलो हमर संग आ अऊ हमन तोर बने धियान रखबो, काबरकि यहोवा ह इसरायल बर बने चीजमन के वायदा करे हे।”<verse eid="NUM 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30"/>होबाब ह जबाब दीस, “नइं, में नइं जावंव; मेंह अपन देस अऊ अपन मनखेमन करा वापिस जावत हंव।”<verse eid="NUM 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31"/>पर मूसा ह कहिस, “हमन ला झन छोंड़। तेंह जानथस कि सुन्ना जगह म हमन ला कहां डेरा डालना चाही, अऊ तें हमर बर आंखी<note caller="+" style="f"><char style="fr" closed="false">10:31 </char><char style="fq" closed="false">आंखी </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">डहार दिखइया</char></note> सहीं अस। <verse eid="NUM 10:31"/><verse number="32" style="v" sid="NUM 10:32"/>यदि तेंह हमर संग आबे, त जऊन भी बने चीज यहोवा ह हमन ला दीही, ओला हमन तोर संग बांटबो।”<verse eid="NUM 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33"/>तब इसरायलीमन यहोवा के पहाड़ ले आघू बढ़िन अऊ तीन दिन तक चलते रिहिन। ओ तीन दिन के दौरान, यहोवा के करार के सन्दूक ह ओमन बर एक ठन अराम के जगह के खोज म ओमन के आघू-आघू बढ़ते रिहिस। <verse eid="NUM 10:33"/><verse number="34" style="v" sid="NUM 10:34"/>जब ओमन डेरा ले आघू बढ़ंय, त दिन के बेरा यहोवा के बादर ह ओमन के ऊपर बने रहय।<verse eid="NUM 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 10:35"/>जब भी सन्दूक ह आघू बढ़य, त मूसा ह कहय,</para>
  <para style="q1" vid="NUM 10:35">“हे यहोवा, उठ!</para>
  <para style="q2" vid="NUM 10:35">तोर बईरीमन तितिर-बितिर हो जावंय;</para>
  <para style="q2" vid="NUM 10:35">तोर बईरीमन तोर आघू ले भाग जावंय।”<verse eid="NUM 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 10:36"/>जब भी सन्दूक ह ठहर जावय, त मूसा ह कहय,</para>
  <para style="q1" vid="NUM 10:36">“हे यहोवा, इसरायल के</para>
  <para style="q2" vid="NUM 10:36">हजारों-हजार मनखेमन करा लहुंट आ।”<verse eid="NUM 10:36"/></para>
  <chapter eid="NUM 10"/>
  <chapter number="11" style="c" sid="NUM 11"/>
  <para style="s1">यहोवा ले आगी निकलई</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1"/>अब इसरायलीमन यहोवा के सुनत म अपन तकलीफ के सिकायत करे लगिन, अऊ जब ओह ओमन के बात ला सुनिस, त ओकर गुस्सा भड़क उठिस। तब ओमन के बीच यहोवा के आगी बरिस अऊ सिविर के कुछू बाहिरी भाग ला जलाके भसम कर दीस। <verse eid="NUM 11:1"/><verse number="2" style="v" sid="NUM 11:2"/>जब मनखेमन मूसा करा आके गोहार पारिन, त ओह यहोवा ले पराथना करिस अऊ आगी ह बुता गीस। <verse eid="NUM 11:2"/><verse number="3" style="v" sid="NUM 11:3"/>एकरसेति ओ जगह ला तबेरा<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="fq" closed="false">तबेरा </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">आगी बरई या जलई</char></note> कहे गीस, काबरकि यहोवा के आगी ह ओमन के बीच बरे रिहिस।<verse eid="NUM 11:3"/></para>
  <para style="s1">यहोवा कोति ले बटेर चिरई</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4"/>ओकर बाद ओमन के संग के हल्ला मचानेवालामन आने जेवन खाय के लालसा करे लगिन, अऊ फेर इसरायलीमन बिलाप करत कहिन, “कास हमर करा खाय बर मांस होतिस! <verse eid="NUM 11:4"/><verse number="5" style="v" sid="NUM 11:5"/>हमन ला मिसर के मछरी के सुरता आवत हे, जेला मुफत म खावत रहेंन—खीरा, कलिंदर, कांदा, गोंदली, अऊ लहसुन घलो। <verse eid="NUM 11:5"/><verse number="6" style="v" sid="NUM 11:6"/>पर अब हमर भूख ह खतम हो गे हवय; हमन ला ये मन्ना के छोंड़ अऊ कुछू नइं दिखय!”<verse eid="NUM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7"/>मन्ना ह धनियां के बीजा सहीं रिहिस अऊ रंग ह मोती सहीं दिखय। <verse eid="NUM 11:7"/><verse number="8" style="v" sid="NUM 11:8"/>मनखेमन आसपास जाके ओला संकेलंय, अऊ तब ओला जांता म पीसंय या ओखली म कुटंय। ओमन ओला एक बरतन म रांधंय या ओकर रोटी बनांय। अऊ येकर सुवाद ह जैतून तेल ले बने कुछू चीज सहीं लगय। <verse eid="NUM 11:8"/><verse number="9" style="v" sid="NUM 11:9"/>जब रथिया सिविर म ओस पड़य, त संग म मन्ना घलो गिरय।<verse eid="NUM 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10"/>मूसा ह हर परिवार के मनखेमन ला अपन-अपन तम्बू के दुवार म रोवत सुनिस। यहोवा ह बहुंत गुस्सा करिस, अऊ मूसा ह परेसान हो गीस। <verse eid="NUM 11:10"/><verse number="11" style="v" sid="NUM 11:11"/>तब मूसा ह यहोवा ले पुछिस, “तेंह अपन सेवक ऊपर ये समस्या काबर लाने हस? मेंह अइसने का काम करके तोला दुखी करेंव कि ये जम्मो मनखेमन के बोझ मोर ऊपर डाल दे हस? <verse eid="NUM 11:11"/><verse number="12" style="v" sid="NUM 11:12"/>का ये जम्मो मनखेमन मोर गरभ म रिहिन? का येमन ला में जनमांय? तेंह मोला काबर कहिथस कि जइसने एक धाई ह छोटे लइका ला अपन कोरा म पाके चलथे, वइसने येमन ला ओ देस म लेके जा, जेला देय के वायदा तेंह येमन के पुरखामन ले कसम खाके करे रहय? <verse eid="NUM 11:12"/><verse number="13" style="v" sid="NUM 11:13"/>मेंह ये जम्मो झन बर मांस कहां ले लानंव? येमन लगातार रो-रोके मांगत रहिथें, ‘हमन ला खाय बर मांस दे!’ <verse eid="NUM 11:13"/><verse number="14" style="v" sid="NUM 11:14"/>मेंह एके झन ये जम्मो मनखेमन के भार नइं उठा सकंव; येह मोर बर भारी हे। <verse eid="NUM 11:14"/><verse number="15" style="v" sid="NUM 11:15"/>यदि ये किसम ले तोला मोर संग बरताव करना हे, त आघू बढ़ अऊ मोला मार डार—यदि तोर दया के नजर मोर ऊपर हवय, त मोला अपन खुद के दुरदसा ला झन देखा।”<verse eid="NUM 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16"/>यहोवा ह मूसा ला कहिस: “मोर करा इसरायल के सत्तर अइसने अगुवामन ला लान, जेमन ला तेंह मनखेमन के अगुवा अऊ अधिकारी के रूप म जानथस। ओमन ला मिलापवाला तम्बू करा ले आ कि ओमन उहां तोर संग ठाढ़ होवंय। <verse eid="NUM 11:16"/><verse number="17" style="v" sid="NUM 11:17"/>तब मेंह खाल्हे उतरके उहां तोर ले गोठियाहूं, अऊ जऊन आतमा के सक्ति तोर म हवय, ओमा ले कुछू सक्ति लेके मेंह ओमन म डार दूहूं। ओमन तोर संग मिलके मनखेमन के ये बोझा ला उठाहीं, ताकि तोला एके झन येला उठाना झन पड़य।<verse eid="NUM 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18"/>“मनखेमन ला कह: ‘कल के तियारी म अपनआप ला पबितर करव, कल तुमन ला मांस खाय बर मिलही। काबरकि यहोवा ह तुम्हर ओ बात ला सुन ले हवय, जब तुमन बिलाप करके कहेव, “कास हमन ला मांस खाय बर मिलतिस! मिसर देस म ही हमर दसा बने रिहिस!” अब यहोवा ह तुमन ला मांस दीही, अऊ तुमन ओला खाहू। <verse eid="NUM 11:18"/><verse number="19" style="v" sid="NUM 11:19"/>तुमन ओला सिरिप एक दिन, या दू दिन, या पांच, दस या बीस दिन नइं, <verse eid="NUM 11:19"/><verse number="20" style="v" sid="NUM 11:20"/>पर पूरा एक महिना तक खाहू—जब तक कि येह तुम्हर नाक ले निकले नइं लगे अऊ येकर ले तुमन ला घिन नइं हो जावय—काबरकि तुमन यहोवा ला तुछ जाने हव, जऊन ह तुम्हर बीच म हवय, अऊ तुमन ओकर आघू म ये कहिके बिलाप करे हव, “हमन काबर मिसर देस ला छोंड़के आ गेंन?” ’ ”<verse eid="NUM 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21"/>पर मूसा ह कहिस, “इहां मेंह छै लाख पैदल चलइया मनखेमन के बीच हवंव, अऊ तेंह कहिथस, ‘मेंह पूरा एक महिना येमन ला खाय बर मांस दूहूं!’ <verse eid="NUM 11:21"/><verse number="22" style="v" sid="NUM 11:22"/>यदि पसु अऊ चिरईमन के झुंड घलो काटे जाय, त का येमन ला पूरही? यदि समुंदर के जम्मो मछरी ला घलो येमन बर पकड़े जावय, त का येमन ला पूरही?”<verse eid="NUM 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23"/>यहोवा ह मूसा ला जबाब दीस, “का यहोवा के हांथ अतेक छोटे हवय? अब तेंह देखबे कि जऊन बात मेंह तोला कहे हंव, ओह सच होथे कि नइं।”<verse eid="NUM 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24"/>तब मूसा ह बाहिर निकलिस अऊ मनखेमन ला यहोवा के कहे बात ला बताईस। ओह ओमन के सत्तर अगुवामन ला इकट्ठा करिस अऊ ओमन ला तम्बू के लकठा म ठाढ़ करिस। <verse eid="NUM 11:24"/><verse number="25" style="v" sid="NUM 11:25"/>तब यहोवा ह बादर म होके खाल्हे उतरिस अऊ मूसा ले गोठियाईस, अऊ जऊन आतमा के सक्ति मूसा म रिहिस, ओमा ले कुछू सक्ति लेके, ओह ओ सत्तर अगुवामन म डार दीस। जब ओ आतमा ओमन म आईस, त ओमन अगमबानी करे लगिन—पर एकर बाद ओमन फेर दूबारा नइं करिन।<verse eid="NUM 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26"/>पर दू झन मनखे सिविर म रह गीन, जेमा के एक झन के नांव एलदाद अऊ दूसर के नांव मेदाद रिहिस। ओमन के नांव अगुवामन के सूची म रिहिस, पर ओमन बाहिर तम्बू करा नइं गीन। तभो ले आतमा ह ओमन म आईस, अऊ ओमन घलो सिविर म अगमबानी करे लगिन। <verse eid="NUM 11:26"/><verse number="27" style="v" sid="NUM 11:27"/>एक जवान ह दऊड़के गीस अऊ मूसा ला बताईस, “एलदाद अऊ मेदाद सिविर म अगमबानी करत हें।”<verse eid="NUM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 11:28"/>नून के बेटा यहोसू, जऊन ह अपन जवानी के समय ले मूसा के सहायक रिहिस; ओह मूसा ला कहिस, “हे मोर मालिक, मूसा, ओमन ला मना कर!”<verse eid="NUM 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29"/>पर मूसा ह जबाब दीस, “का मोर कारन तोला जलन होवत हे? बने होतिस कि यहोवा के जम्मो मनखेमन अगमजानी होतिन अऊ यहोवा ह अपन आतमा ओमन म डार देतिस!” <verse eid="NUM 11:29"/><verse number="30" style="v" sid="NUM 11:30"/>तब मूसा अऊ इसरायल के ओ अगुवामन डेरा म वापिस चल दीन।<verse eid="NUM 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31"/>यहोवा कोति ले एक गरेर चलिस अऊ ये गरेर ह समुंदर ले बटेर चिरईमन ला ले आईस। येह बटेरमन ला दू क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="ft" closed="false">लगभग 3 फीट या 90 सेन्टीमीटर</char></note> ऊंचई तक डेरा के चारों कोति, हर दिसा म एक दिन के रसता तक बगरा दीस। <verse eid="NUM 11:31"/><verse number="32" style="v" sid="NUM 11:32"/>ओ पूरा दिन अऊ रथिया अऊ दूसर दिन घलो मनखेमन बाहिर जाके बटेरमन ला संकेलिन। कम से कम बटोरनेवाला घलो दस होमेर<note caller="+" style="f"><char style="fr" closed="false">11:32 </char><char style="ft" closed="false">लगभग 1006 किलोग्राम</char></note> ले कम नइं बटोरिस। तब ओमन ओ बटेरमन ला सिविर के चारों कोति बगरा दीन। <verse eid="NUM 11:32"/><verse number="33" style="v" sid="NUM 11:33"/>पर खाय के बेरा जब मांस ह ओमन के मुहूं म ही रिहिस अऊ येकर पहिले कि ओमन ओला चबाके लीलतिन, यहोवा के कोरोध ह ओमन ऊपर भड़क उठिस अऊ ओह ओमन के बीच बड़े महामारी फईला दीस। <verse eid="NUM 11:33"/><verse number="34" style="v" sid="NUM 11:34"/>एकरसेति ओ जगह के नांव किबरोत-हतावा<note caller="+" style="f"><char style="fr" closed="false">11:34 </char><char style="fq" closed="false">किबरोत-हतावा </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">लालसा के कबर</char></note> पड़िस, काबरकि उहां ओमन ओ मनखेमन ला माटी दे रिहिन, जेमन आने जेवन के लालसा करे रिहिन।<verse eid="NUM 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35"/>ओकर बाद किबरोत-हतावा ले मनखेमन हसेरोत गीन अऊ उहां रूक गीन।<verse eid="NUM 11:35"/></para>
  <chapter eid="NUM 11"/>
  <chapter number="12" style="c" sid="NUM 12"/>
  <para style="s1">मिरियम अऊ हारून मूसा के बिरोध करथें</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1"/>मूसा ह एक कूसी माईलोगन ले बिहाव कर ले रिहिस, त मिरियम अऊ हारून ओकर कूसी घरवाली के कारन ओकर बिरूध गोठियाय लगिन। <verse eid="NUM 12:1"/><verse number="2" style="v" sid="NUM 12:2"/>ओमन कहिन, “का यहोवा ह सिरिप मूसा के दुवारा ही बात करे हवय? का ओह हमर दुवारा घलो बात नइं करे हवय?” अऊ यहोवा ह ये बात ला सुनिस।<verse eid="NUM 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 12:3"/>(मूसा ह एक बहुंत नम्र सुभाव के मनखे रिहिस, धरती म ओकर ले जादा अऊ कोनो नम्र मनखे नइं रिहिन।)<verse eid="NUM 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4"/>तुरते यहोवा ह मूसा, हारून अऊ मिरियम ला कहिस, “तुमन तीनों झन बाहिर मिलापवाला तम्बू करा आवव।” त ओ तीनों झन बाहिर आ गीन। <verse eid="NUM 12:4"/><verse number="5" style="v" sid="NUM 12:5"/>तब यहोवा ह बादर के एक खंभा म खाल्हे आईस; ओह तम्बू के दुवार करा ठाढ़ हो गीस अऊ हारून अऊ मिरियम ला बलाईस। जब ओ दूनों झन आघू आईन, <verse eid="NUM 12:5"/><verse number="6" style="v" sid="NUM 12:6"/>त यहोवा ह कहिस, “मोर बात ला सुनव:</para>
  <para style="q1" vid="NUM 12:6">“जब तुम्हर बीच म कोनो अगमजानी होथे,</para>
  <para style="q2" vid="NUM 12:6">त में, यहोवा अपनआप ला ओकर करा दरसन म परगट करथंव,</para>
  <para style="q2" vid="NUM 12:6">मेंह ओकर ले सपना म गोठियाथंव।<verse eid="NUM 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 12:7"/>पर ये बात मोर सेवक मूसा बर लागू नइं होवय;</para>
  <para style="q2" vid="NUM 12:7">ओह मोर जम्मो घर<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">इसरायली</char></note> म बिसवासयोग्य ए।<verse eid="NUM 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 12:8"/>ओकर संग मेंह आमने-सामने,</para>
  <para style="q2" vid="NUM 12:8">अऊ साफ-साफ गोठियाथंव, पहेलीमन म नइं गोठियावंव;</para>
  <para style="q2" vid="NUM 12:8">ओह यहोवा के स्वरूप ला देखथे।</para>
  <para style="q1" vid="NUM 12:8">तब तुमन काबर मोर सेवक मूसा के बिरूध</para>
  <para style="q2" vid="NUM 12:8">गोठियाय बर नइं डरेव?”<verse eid="NUM 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9"/>तब यहोवा के कोरोध ओमन ऊपर भड़किस, अऊ ओह ओमन ला छोंड़के चल दीस।<verse eid="NUM 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 12:10"/>जब बादर ह तम्बू के ऊपर ले उठ गीस, त मिरियम ला कोढ़ के बेमारी हो गीस अऊ ओह बरफ सहीं सफेद हो गीस। हारून ह ओकर कोति मुड़िस अऊ देखिस कि ओला असुध करइया चाम-रोग हो गे हे, <verse eid="NUM 12:10"/><verse number="11" style="v" sid="NUM 12:11"/>अऊ ओह मूसा ला कहिस, “हे मोर मालिक, मेंह बिनती करत हंव कि हमर ओ पाप ला झन धर, जेला हमन बहुंत मुरूख होके करे हवन। <verse eid="NUM 12:11"/><verse number="12" style="v" sid="NUM 12:12"/>ओला दाई के गरभ ले निकलत आधा गले देहेंवाले लइका सहीं झन रहन दे।”<verse eid="NUM 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13"/>तब मूसा ह यहोवा ले गोहारिस, “हे परमेसर, किरपा करके ओला बने कर दे!”<verse eid="NUM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14"/>यहोवा ह मूसा ला जबाब दीस, “यदि ओकर ददा ह ओकर चेहरा म थूक दे होतिस, त का ओह सात दिन तक कलंक म नइं रहितिस; ओला सात दिन तक सिविर के बाहिर रखव; ओकर बाद ओला वापिस लाने जावय।” <verse eid="NUM 12:14"/><verse number="15" style="v" sid="NUM 12:15"/>तब मिरियम ला सात दिन तक सिविर के बाहिर रखे गीस, अऊ मनखेमन आघू नइं बढ़िन जब तक कि ओला वापिस नइं लाने गीस।<verse eid="NUM 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 12:16"/>ओकर बाद, मनखेमन हसेरोत ले आघू बढ़िन अऊ पारान के सुन्ना जगह म डेरा डालिन।<verse eid="NUM 12:16"/></para>
  <chapter eid="NUM 12"/>
  <chapter number="13" style="c" sid="NUM 13"/>
  <para style="s1">कनान देस के बारे म खोजबीन करई</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1"/>यहोवा ह मूसा ला कहिस, <verse eid="NUM 13:1"/><verse number="2" style="v" sid="NUM 13:2"/>“कुछू मनखेमन ला कनान देस के खोजबीन करे बर भेज, जेला मेंह इसरायलीमन ला देनेवाला हंव। हर पुरखा के गोत्र म ले एक-एक झन अगुवा ला भेज।”<verse eid="NUM 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 13:3"/>तब यहोवा के हुकूम पाके मूसा ह ओमन ला पारान के सुन्ना जगह ले पठो दीस। ओ जम्मो झन इसरायलीमन के अगुवा रिहिन।<verse eid="NUM 13:3"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="4" style="v" sid="NUM 13:4"/>ओमन के नांव ये अंय:</para>
  <para style="b" vid="NUM 13:4"/>
  <para style="li1" vid="NUM 13:4">रूबेन के गोत्र ले जक्कूर के बेटा सम्मू;<verse eid="NUM 13:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 13:5"/>सिमोन के गोत्र ले होरी के बेटा सापात;<verse eid="NUM 13:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 13:6"/>यहूदा के गोत्र ले यपुन्ने के बेटा कालेब;<verse eid="NUM 13:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 13:7"/>इस्साकार के गोत्र ले यूसुफ के बेटा इगाल;<verse eid="NUM 13:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 13:8"/>एपरैम के गोत्र ले नून के बेटा होसे;<verse eid="NUM 13:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 13:9"/>बिनयामीन के गोत्र ले राफू के बेटा पलती;<verse eid="NUM 13:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 13:10"/>जबूलून के गोत्र ले सोदी के बेटा गदीएल;<verse eid="NUM 13:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 13:11"/>मनस्से के गोत्र ले (यूसुफ के एक गोत्र) सूसी के बेटा गद्दी;<verse eid="NUM 13:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 13:12"/>दान के गोत्र ले गमली के बेटा अमीएल;<verse eid="NUM 13:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 13:13"/>आसेर के गोत्र ले मिकाएल के बेटा सतूर;<verse eid="NUM 13:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 13:14"/>नपताली के गोत्र ले वोपसी के बेटा नहबी;<verse eid="NUM 13:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 13:15"/>गाद के गोत्र ले माकी के बेटा गूएल।<verse eid="NUM 13:15"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="16" style="v" sid="NUM 13:16"/>ये ओ मनखेमन के नांव ए, जेमन ला मूसा ह देस के खोजबीन करे बर पठोईस। (मूसा ह नून के बेटा होसे के नांव यहोसू रखिस।)<verse eid="NUM 13:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17"/>जब मूसा ह ओमन ला कनान देस के खोजबीन करे बर पठोईस, त ओह कहिस, “तुमन नेगेव राज<note caller="+" style="f"><char style="fr" closed="false">13:17 </char><char style="fq" closed="false">नेगेव </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कनान के दक्खिनी भाग</char></note> म होवत पहाड़ी देस म जावव। <verse eid="NUM 13:17"/><verse number="18" style="v" sid="NUM 13:18"/>देखव कि ओ देस ह कइसे हवय अऊ जऊन मनखेमन उहां रहिथें, ओमन बलवान हें कि कमजोर, संखिया म कम हवंय कि जादा। <verse eid="NUM 13:18"/><verse number="19" style="v" sid="NUM 13:19"/>कइसे हवय ओ देस, जेमा ओमन रहिथें? बने कि खराप? रहे के नगरमन कइसे हवंय? ओ नगरमन खुला हवंय कि चारों कोति दीवार बने हवय? <verse eid="NUM 13:19"/><verse number="20" style="v" sid="NUM 13:20"/>उहां के माटी कइसे हवय? उपजाऊ हे या बंजर? उहां रूखमन हवंय कि नइं? ओ देस म ले कुछू फर लाने के पूरा कोसिस करव।” (येह पाके अंगूर के पहिली-फसल के मौसम रिहिस।)<verse eid="NUM 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21"/>त ओमन गीन अऊ सीन के सुन्ना जगह ले लेके लेबो-हमात कोति रहोब नगर तक ओ देस के खोजबीन करिन। <verse eid="NUM 13:21"/><verse number="22" style="v" sid="NUM 13:22"/>ओमन नेगेव कोति ले होवत हेबरोन आ गीन, जिहां अनाक के बंसज अहीमन, सेसै अऊ तलमै रहत रिहिन। (हेबरोन सहर ह मिसर के सोअन ले सात साल पहिले बन गे रिहिस।) <verse eid="NUM 13:22"/><verse number="23" style="v" sid="NUM 13:23"/>जब ओमन एसकोल<note caller="+" style="f"><char style="fr" closed="false">13:23 </char><char style="fq" closed="false">एसकोल </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">गुच्छा</char></note> के घाटी म हबरिन, त ओमन अंगूर के एक नार ला काट लीन, जेमा अंगूर के सिरिप एके ठन गुच्छा रिहिस। ओमा के दू झन येला कुछू अनार अऊ अंजीर के संग एक ठन लउठी म लटकात बोहके ले चलिन। <verse eid="NUM 13:23"/><verse number="24" style="v" sid="NUM 13:24"/>ओ जगह ला एसकोल के घाटी कहे गीस काबरकि उहां इसरायलीमन अंगूर के एक गुच्छा ला काटे रिहिन। <verse eid="NUM 13:24"/><verse number="25" style="v" sid="NUM 13:25"/>चालीस दिन के बाद ओमन ओ देस के खोजबीन करके लहुंट आईन।<verse eid="NUM 13:25"/></para>
  <para style="s1">खोजबीन के लेखा-जोखा</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 13:26"/>ओमन पारान के सुन्ना जगह के कादेस नगर म मूसा अऊ हारून अऊ जम्मो इसरायली समाज करा वापिस आईन। ओमन उहां ओमन ला अऊ जम्मो इसरायली सभा ला लेखा-जोखा दीन अऊ ओ देस के फर ओमन ला देखाईन। <verse eid="NUM 13:26"/><verse number="27" style="v" sid="NUM 13:27"/>ओमन मूसा ला बताईन: “हमन ओ देस म गेंन, जिहां तेंह हमन ला पठोय रहय, ओ देस म दूध अऊ मंधरस बहुंत हवय! हमन उहां ले ये कुछू फर लेके आय हन। <verse eid="NUM 13:27"/><verse number="28" style="v" sid="NUM 13:28"/>पर उहां के मनखेमन बलवान अंय, सहरमन के चारों कोति किला हे अऊ सहरमन बहुंत बड़े हवंय। अऊ त अऊ हमन उहां अनाक के संतानमन ला घलो देखेंन। <verse eid="NUM 13:28"/><verse number="29" style="v" sid="NUM 13:29"/>अमालेकीमन नेगेव म रहिथें; हित्ती, यबूसी अऊ अमोरी पहाड़ी इलाका म रहिथें; अऊ कनानीमन समुंदर के लकठा म, यरदन नदी के तीरे-तीर रहिथें।”<verse eid="NUM 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30"/>तब कालेब ह मूसा के आघू म मनखेमन ला चुप कराईस अऊ कहिस, “हमन ला जाके ओ देस ऊपर अधिकार कर लेना चाही, काबरकि हमन खचित अइसने कर सकत हन।”<verse eid="NUM 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31"/>पर जऊन मनखेमन ओकर संग गे रिहिन, ओमन कहिन, “हमन ओमन ऊपर हमला नइं कर सकन; काबरकि ओमन हमर ले जादा बलवान हें।” <verse eid="NUM 13:31"/><verse number="32" style="v" sid="NUM 13:32"/>अऊ ओमन इसरायलीमन के बीच म ओ देस के बारे म एक खराप बात फईला दीन, जिहां ओमन गे रिहिन। ओमन कहिन, “जऊन देस के हमन भेद लेके आय हन, ओ देस ह उहां के निवासीमन ला खा जाथे। उहां जम्मो मनखेमन बड़े डीलडौल के हवंय। <verse eid="NUM 13:32"/><verse number="33" style="v" sid="NUM 13:33"/>हमन उहां नेफिलीम<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="fq" closed="false">नेफिलीम </char><char style="ft" closed="false">बड़े डीलडौलवाला मनखे; </char><char style="fqa" closed="false">दानव</char></note> देखेंन (अनाक के संतानमन नेफिलीम के बंस ले आथें)। हमन अपन नजर म ओमन के आघू म फांफा सहीं लगत रहेंन, अऊ अइसने ही हमन ओमन ला दिखत रहेंन।”<verse eid="NUM 13:33"/></para>
  <chapter eid="NUM 13"/>
  <chapter number="14" style="c" sid="NUM 14"/>
  <para style="s1">मनखेमन बिदरोह करथें</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1"/>ओ रथिया समाज के जम्मो झन अपन अवाज ऊंचहा करिन अऊ जोर-जोर से रोईन। <verse eid="NUM 14:1"/><verse number="2" style="v" sid="NUM 14:2"/>जम्मो इसरायलीमन मूसा अऊ हारून के बिरूध बड़बड़ाय लगिन, अऊ पूरा सभा ह ओमन ला कहिस, “बने होतिस कि हमन मिसर म मर गे होतेंन! या ये सुन्ना जगह म मर जातेंन! <verse eid="NUM 14:2"/><verse number="3" style="v" sid="NUM 14:3"/>तलवार ले मारे जाय बर ही यहोवा ह हमन ला ये देस म काबर लानत हे? हमर घरवाली अऊ लइकामन ला लूट के सामान सहीं ले लिये जाही। का येह बने नइं होही कि हमन मिसर देस वापिस चले जावन?” <verse eid="NUM 14:3"/><verse number="4" style="v" sid="NUM 14:4"/>अऊ ओमन एक-दूसर ला कहिन, “आवव, हमन अपन बर एक अगुवा चुनके वापिस मिसर देस चल देवन।”<verse eid="NUM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5"/>तब उहां जूरे सबो इसरायली समाज के आघू म मूसा अऊ हारून मुहूं के बल गिरिन। <verse eid="NUM 14:5"/><verse number="6" style="v" sid="NUM 14:6"/>नून के बेटा यहोसू अऊ यपुन्ने के बेटा कालेब दुखी होके अपन कपड़ा चीरिन; ये दूनों ओ दल म रिहिन, जेमन ओ देस के पता लगाय गे रिहिन। <verse eid="NUM 14:6"/><verse number="7" style="v" sid="NUM 14:7"/>ये दूनों इसरायलीमन के पूरा सभा ला कहिन, “जऊन देस म हमन गे रहेंन अऊ खोजबीन करके आय हन, ओह बहुंत ही बने देस अय। <verse eid="NUM 14:7"/><verse number="8" style="v" sid="NUM 14:8"/>यदि यहोवा ह हमन ले खुस हवय, त ओह हमन ला ओ देस म ले जाही, जिहां दूध अऊ मंधरस के भरमार हे, अऊ ओह ओ देस हमन ला दीही। <verse eid="NUM 14:8"/><verse number="9" style="v" sid="NUM 14:9"/>यहोवा के बिरूध बिदरोह झन करव। अऊ ओ देस के मनखेमन ले झन डरव, काबरकि हमन ओमन ला नास कर देबो। ओमन के सुरकछा ह हट गे हवय, पर यहोवा ह हमर संग हवय। ओमन ले झन डरावव।”<verse eid="NUM 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10"/>पर पूरा सभा के मनखेमन ओमन ला पथरवाह करे के बात करत रिहिन। तब मिलापवाला तम्बू करा जम्मो इसरायलीमन ऊपर यहोवा के महिमा परगट होईस। <verse eid="NUM 14:10"/><verse number="11" style="v" sid="NUM 14:11"/>यहोवा ह मूसा ला कहिस, “कब तक ये मनखेमन मोर संग अपमान के बरताव करत रहिहीं? मोर दुवारा येमन के बीच म ये जम्मो चिनहां देखाय के बाद भी, येमन कब तक मोर ऊपर बिसवास नइं करहीं? <verse eid="NUM 14:11"/><verse number="12" style="v" sid="NUM 14:12"/>मेंह महामारी लानके ओमन ला नास कर दूहूं, पर मेंह तोर दुवारा एक बड़े जाति बनाहूं, जऊन ह येमन ले घलो बड़े अऊ सक्तिसाली होही।”<verse eid="NUM 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13"/>मूसा ह यहोवा ला कहिस, “तब तो मिसर देस के मनखेमन येकर बारे म सुनहीं! तेंह अपन सामर्थ ले ये इसरायलीमन ला ओमन के बीच ले निकाल लाने हस। <verse eid="NUM 14:13"/><verse number="14" style="v" sid="NUM 14:14"/>अऊ ओमन ये देस के निवासीमन ला येकर बारे म बताहीं। ओमन ये बात ला सुने हवंय कि तें यहोवा ये मनखेमन के संग रहिथस अऊ ये कि तें यहोवा आमने-सामने दिखथस, कि तोर बादर ह येमन के ऊपर ठहिरे रहिथे, अऊ ये घलो कि तेंह दिन के बेरा बादर के एक खंभा के रूप म अऊ रथिया आगी के एक खंभा के रूप म येमन के आघू-आघू रेंगथस। <verse eid="NUM 14:14"/><verse number="15" style="v" sid="NUM 14:15"/>यदि तेंह ये जम्मो मनखेमन ला मार डारबे, कोनो ला नइं छोंड़बे, त ओ जाति के मनखेमन, जऊन मन येला सुने हवंय, ओमन कहिहीं, <verse eid="NUM 14:15"/><verse number="16" style="v" sid="NUM 14:16"/>‘यहोवा ह ये इसरायलीमन ला ओ देस म नइं लाने सकिस, जेकर वायदा ओह येमन ले कसम खाके करे रिहिस, एकरसेति ओह येमन ला सुन्ना जगह म मार डारिस।’<verse eid="NUM 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 14:17"/>“पर अब परभू के सक्ति ह परगट होवय, जइसे कि तेंह घोसना करे हस: <verse eid="NUM 14:17"/><verse number="18" style="v" sid="NUM 14:18"/>‘यहोवा ह कोरोध करे म धीमा, मया ले भरपूर अऊ पाप अऊ बिदरोह ला छेमा करइया ए। फेर दोसी ला ओह निरदोस नइं छोंड़य; ओह दाई-ददा के पाप बर ओमन के लइकामन ला तीसरा अऊ चौथा पीढ़ी तक दंड<note caller="+" style="f"><char style="fr" closed="false">14:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 34:6">निर 34:6</ref></char></char></note> देथे।’ <verse eid="NUM 14:18"/><verse number="19" style="v" sid="NUM 14:19"/>तोर महान मया के मुताबिक, ये मनखेमन के पाप ला छेमा कर, जइसे कि तेंह येमन ला मिसर देस ले निकल आय के समय ले लेके अब तक छेमा करत आय हस।”<verse eid="NUM 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20"/>यहोवा ह जबाब दीस, “तोर बिनती के मुताबिक मेंह येमन ला छेमा कर दे हंव। <verse eid="NUM 14:20"/><verse number="21" style="v" sid="NUM 14:21"/>तभो ले, मोर जिनगी के कसम अऊ जब तक पूरा धरती ह यहोवा के महिमा ले भरे हवय, <verse eid="NUM 14:21"/><verse number="22" style="v" sid="NUM 14:22"/>ओ जम्मो झन, जऊन मन मोर महिमा अऊ चिनहांमन ला मिसर अऊ सुन्ना जगह म देखिन, ओमा के जऊन मन भी मोर बात ला नइं मानिन अऊ दस बार मोला जांचिन-परखिन— <verse eid="NUM 14:22"/><verse number="23" style="v" sid="NUM 14:23"/>ओमन कोनो भी ओ देस ला देखे नइं पाहीं, जेकर वायदा मेंह ओमन के पुरखामन ले कसम खाके करे रहेंव। मोर अपमान करइयामन कभू ओ देस ला देखे नइं पाहीं। <verse eid="NUM 14:23"/><verse number="24" style="v" sid="NUM 14:24"/>पर काबरकि मोर सेवक कालेब करा एक अलग आतमा हवय अऊ ओह पूरा मन से मोर पाछू चलथे, एकरसेति मेंह ओला उहां ले जाहूं, जिहां ओह गे रिहिस, अऊ ओकर संतानमन ओ देस ऊपर अधिकार करहीं। <verse eid="NUM 14:24"/><verse number="25" style="v" sid="NUM 14:25"/>काबरकि अमालेकीमन अऊ कनानीमन ओ घाटीमन म रहत हें, एकरसेति कल तुमन वापिस लहुंटव अऊ लाल-समुंदर<note caller="+" style="f"><char style="fr" closed="false">14:25 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">नरकटमन के समुंदर</char></note> के तीरे-तीर रसता ले सुन्ना जगह कोति आघू बढ़व।”<verse eid="NUM 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26"/>तब यहोवा ह मूसा अऊ हारून ला कहिस: <verse eid="NUM 14:26"/><verse number="27" style="v" sid="NUM 14:27"/>“ये दुस्ट समाज के मनखेमन कब तक मोर बिरूध बड़बड़ावत रहिहीं? मेंह ये बड़बड़ानेवाले इसरायलीमन के सिकायत ला सुने हंव। <verse eid="NUM 14:27"/><verse number="28" style="v" sid="NUM 14:28"/>एकरसेति ओमन ले कह, ‘यहोवा अपन जिनगी के कसम खाके घोसना करत हे, जऊन बात तुमन मोर सुनत म कहे हव, में तुम्हर संग वइसने ही करहूं। <verse eid="NUM 14:28"/><verse number="29" style="v" sid="NUM 14:29"/>ये सुन्ना जगह म ही तुम्हर लास पड़े रहिही—ओ जम्मो, जऊन मन बीस साल या जादा उमर के हवंय, जेमन के गनती हो चुके हवय अऊ जेमन मोर बिरूध बड़बड़ाय हवंय। <verse eid="NUM 14:29"/><verse number="30" style="v" sid="NUM 14:30"/>यपुन्ने के बेटा कालेब अऊ नून के बेटा यहोसू के छोंड़, तुमन म ले कोनो ओ देस म जाय नइं सकहू, जेला तुम्हर घर बनाय बर मेंह हांथ उठाके कसम खाय रहेंव। <verse eid="NUM 14:30"/><verse number="31" style="v" sid="NUM 14:31"/>जहां तक तुम्हर लइकामन के बात ए, जेमन के लूट म जाय के बारे म तुमन कहे रहेव, मेंह ओमन ला ओ देस म आनंद करे बर लानहूं, जेला तुमन ठुकरा दे हव। <verse eid="NUM 14:31"/><verse number="32" style="v" sid="NUM 14:32"/>पर जहां तक तुम्हर बात अय, तुमन ये सुन्ना जगह म मर जाहू। <verse eid="NUM 14:32"/><verse number="33" style="v" sid="NUM 14:33"/>तुम्हर बिसवासघात के कारन, तुम्हर लइकामन चालीस बछर तक दुख भोगत इहां चरवाहा होके रहिहीं, जब तक कि तुम्हर आखिरी जन ये सुन्ना जगह म मर नइं जाही। <verse eid="NUM 14:33"/><verse number="34" style="v" sid="NUM 14:34"/>तुमन चालीस दिन तक ओ देस के खोजबीन करे रहेव—एक दिन के पाछू एक साल याने कि चालीस साल तक तुमन अपन पाप के दुख भोगहू, तब तुमन जानहू कि मोर बिरूध होय के मतलब का होथे।’ <verse eid="NUM 14:34"/><verse number="35" style="v" sid="NUM 14:35"/>में, यहोवा ये बात ला कहे हवंव, अऊ मेंह खचित ये पूरा दुस्ट समाज के संग अइसने ही करहूं, जेमन मोर बिरूध म एक जुट हो गे हवंय। ये सुन्ना जगह म येमन के आखिरी समय बीतही; इहां ओमन मर जाहीं।”<verse eid="NUM 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36"/>ओ मनखे जेमन ला मूसा ह ओ देस के खोजबीन करे बर पठोय रिहिस, ओमन लहुंटके ओ देस के बारे म गलत बात कहिके मूसा के बिरूध जम्मो समाज ला बड़बड़ाय बर उभारे रिहिन— <verse eid="NUM 14:36"/><verse number="37" style="v" sid="NUM 14:37"/>ये मनखे जेमन ओ देस के बारे म गलत बात फईलाय बर जिम्मेदार रिहिन, ओ जम्मो के जम्मो मार डारे गीन अऊ यहोवा के आघू म एक महामारी ले मर गीन। <verse eid="NUM 14:37"/><verse number="38" style="v" sid="NUM 14:38"/>जऊन मनखेमन ओ देस के खोजबीन करे बर गे रिहिन, ओमा ले सिरिप नून के बेटा यहोसू अऊ यपुन्ने के बेटा कालेब बांचिन।<verse eid="NUM 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39"/>जब मूसा ह जम्मो इसरायलीमन ला ये बात बताईस, त ओमन बहुंत सोक मनाईन। <verse eid="NUM 14:39"/><verse number="40" style="v" sid="NUM 14:40"/>दूसर दिन बड़े बिहनियां ये कहिके ओमन पहाड़ी देस के चोटी कोति आघू बढ़िन, “खचित हमन पाप करे हन! पर अब हमन ओ देस म जाय बर तियार हन, जेकर वायदा यहोवा ह करे हवय।”<verse eid="NUM 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41"/>पर मूसा ह कहिस, “तुमन काबर यहोवा के हुकूम ला नइं मानत हव? तुम्हर ये काम सफल नइं होवय! <verse eid="NUM 14:41"/><verse number="42" style="v" sid="NUM 14:42"/>तुमन ऊपर झन जावव, काबरकि यहोवा ह तुम्हर संग नइं ए। तुमन अपन बईरीमन ले हार जाहू, <verse eid="NUM 14:42"/><verse number="43" style="v" sid="NUM 14:43"/>अमालेकीमन अऊ कनानीमन उहां तुम्हर सामना करहीं। काबरकि तुमन यहोवा के रसता ले हट गे हव, एकरसेति ओह तुम्हर संग नइं रहय अऊ तुमन तलवार ले मार डारे जाहू।”<verse eid="NUM 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44"/>तभो ले, ओमन अपन ढिठई म पहाड़ी देस के चोटी कोति आघू बढ़िन, पर न तो मूसा अऊ न ही यहोवा के करार के सन्दूक ह सिविर ले आघू बढ़िस। <verse eid="NUM 14:44"/><verse number="45" style="v" sid="NUM 14:45"/>तब अमालेकीमन अऊ कनानीमन, जेमन ओ पहाड़ी देस म रहत रिहिन, ओमन खाल्हे उतरके इसरायलीमन ऊपर हमला कर दीन अऊ ओमन ला होरमा सहर तक मारत चले गीन।<verse eid="NUM 14:45"/></para>
  <chapter eid="NUM 14"/>
  <chapter number="15" style="c" sid="NUM 15"/>
  <para style="s1">पूरक-बलिदान</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1"/>यहोवा ह मूसा ला कहिस, <verse eid="NUM 15:1"/><verse number="2" style="v" sid="NUM 15:2"/>“इसरायलीमन ले बात कर अऊ ओमन ला कह: ‘जब तुमन ओ देस म हबरव, जेला मेंह तुम्हर घर के रूप म देवत हंव <verse eid="NUM 15:2"/><verse number="3" style="v" sid="NUM 15:3"/>अऊ तुमन यहोवा ला सुख-देवइया खुसबू के रूप म भेड़-बकरी या गाय-बईला के झुंड ले जेवन-बलिदान चघावव—चाहे होम-बलिदान या चढ़ावा होवय, बिसेस मन्नत या स्वेच्छा-बलिदान या तिहार-बलिदान होवय— <verse eid="NUM 15:3"/><verse number="4" style="v" sid="NUM 15:4"/>त जऊन मनखे ह चढ़ावा लानथे, ओह यहोवा ला जैतून तेल के एक हीन<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">लगभग 1 लीटर</char></note> के चौथा भाग म सनाय उत्तम पीसान के एक एपा<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">लगभग 1.6 किलोग्राम</char></note> के दसवां भाग के एक अन्न-बलिदान चघावय। <verse eid="NUM 15:4"/><verse number="5" style="v" sid="NUM 15:5"/>होम-बलिदान या चढ़ावा बर हर एक मेढ़ा-पीला के संग पेय-बलिदान के रूप म अंगूर के मंद के एक हीन के चौथा भाग<note caller="+" style="f" category="dup"><char style="fr" closed="false">15:5 </char><char style="ft" closed="false">लगभग 1 लीटर</char></note> तियार करव।<verse eid="NUM 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 15:6"/>“ ‘एक मेढ़ा-पीला के संग जैतून तेल के एक हीन के तीसरा भाग<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">लगभग 1.3 लीटर</char></note> म सनाय उत्तम पीसान के एक एपा के दू-दसवां भाग<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">लगभग 3.2 किलोग्राम</char></note> के एक अन्न-बलिदान, <verse eid="NUM 15:6"/><verse number="7" style="v" sid="NUM 15:7"/>अऊ पेय-बलिदान बर अंगूर के मंद के एक हीन के तीसरा भाग ला, यहोवा ला सुख-देवइया सुगंध के रूप म चघावव।<verse eid="NUM 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 15:8"/>“ ‘जब तुमन यहोवा बर एक होम-बलिदान या चढ़ावा, एक बिसेस मन्नत या मेल-बलिदान के चढ़ावा बर एक बछवा तियार करथव, <verse eid="NUM 15:8"/><verse number="9" style="v" sid="NUM 15:9"/>त बछवा के संग जैतून तेल के आधा हीन<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">लगभग 1.9 लीटर</char></note> ले सनाय उत्तम पीसान के एक एपा के तीन-दसवां भाग<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">लगभग 5 किलोग्राम</char></note> के एक अन्न-बलिदान लानव, <verse eid="NUM 15:9"/><verse number="10" style="v" sid="NUM 15:10"/>अऊ पेय-बलिदान के रूप म आधा हीन अंगूर के मंद<note caller="+" style="f"><char style="fr" closed="false">15:10 </char><char style="ft" closed="false">लगभग 2 लीटर</char></note> घलो लानव। येह यहोवा ला महकत सुख-देवइया एक जेवन-बलिदान होही। <verse eid="NUM 15:10"/><verse number="11" style="v" sid="NUM 15:11"/>हर बछवा या मेढ़ा, हर मेढ़ा-पीला या छेरी-पीला ला इही तरीका ले तियार करे जावय। <verse eid="NUM 15:11"/><verse number="12" style="v" sid="NUM 15:12"/>हर एक बलिदान के तियारी बर, तुमन इही तरीका अपनावव।<verse eid="NUM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 15:13"/>“ ‘हर एक मनखे, जऊन ह उहां देस म जनमे हवय, ओह ये चीजमन ला ये किसम ले करय, जब ओह यहोवा ला महकत सुख-देवइया एक जेवन-बलिदान चघाथे। <verse eid="NUM 15:13"/><verse number="14" style="v" sid="NUM 15:14"/>अवइया पीढ़ी-पीढ़ी तक, जब कोनो परदेसी या कोनो अऊ मनखे, जऊन ह तुम्हर बीच म रहत हे, यदि ओह यहोवा ला महकत सुख-देवइया जेवन-बलिदान चघाथे, त ओह वइसने ही करय जइसने तुमन करथव। <verse eid="NUM 15:14"/><verse number="15" style="v" sid="NUM 15:15"/>तुम्हर बर अऊ तुम्हर बीच रहइया परदेसी बर समाज के ओहीच नियम होवय; येह अवइया पीढ़ी-पीढ़ी तक हमेसा के बिधि ठहिरय। तुमन अऊ परदेसीमन यहोवा के आघू म एक समान होहू: <verse eid="NUM 15:15"/><verse number="16" style="v" sid="NUM 15:16"/>ओहीच कानून अऊ बिधि तुम्हर अऊ तुम्हर बीच रहइया परदेसी दूनों बर लागू होही।’ ”<verse eid="NUM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 15:17"/><verse number="18" style="v" sid="NUM 15:18"/>“इसरायलीमन ले बात कर अऊ ओमन ला कह: ‘जऊन देस म मेंह तुमन ला ले जावत हंव, जब तुमन उहां हबरव <verse eid="NUM 15:18"/><verse number="19" style="v" sid="NUM 15:19"/>अऊ ओ देस के जेवन ला खावव, त ओकर एक भाग यहोवा ला बलिदान के रूप म चघावव। <verse eid="NUM 15:19"/><verse number="20" style="v" sid="NUM 15:20"/>अपन भुइयां के ऊपज के पहिली भाग के रूप म एक रोटी चघावव अऊ येला कोठार के बलिदान के रूप म चघावव। <verse eid="NUM 15:20"/><verse number="21" style="v" sid="NUM 15:21"/>अवइया पीढ़ी-पीढ़ी तक तुमन ला अपन भुइयां के पहिली ऊपज ले यहोवा ला ये बलिदान चघाना हे।<verse eid="NUM 15:21"/></para>
  <para style="s1">अनजाने म करे गे पाप के बलिदान</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22"/>“ ‘यदि समाज के रूप म तुमन अनजाने म, यहोवा के मूसा ला दिये कोनो हुकूम के पालन करे म असफल होथव— <verse eid="NUM 15:22"/><verse number="23" style="v" sid="NUM 15:23"/>यहोवा दुवारा मूसा के जरिये तुमन ला दिये कोनो हुकूम, जेह पीढ़ी-पीढ़ी ले चले आवत हे— <verse eid="NUM 15:23"/><verse number="24" style="v" sid="NUM 15:24"/>अऊ यदि येह अनजाने म समाज के बिगर जानकारी म होथे, तब पूरा समाज ह यहोवा ला एक महकत सुख-देवइया होम-बलिदान बर एक बछवा चघावय, अऊ संग म येकर बताय गे अन्न-बलिदान अऊ पेय-बलिदान, अऊ एक ठन बोकरा पाप-बलिदान<note caller="+" style="f"><char style="fr" closed="false">15:24 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुधिकरन-बलिदान</char></note> बर चघावय। <verse eid="NUM 15:24"/><verse number="25" style="v" sid="NUM 15:25"/>पुरोहित ह पूरा इसरायली समाज बर प्रायस्चित करय, अऊ ओमन के पाप छेमा हो जाही, काबरकि ये पाप ह जानबूझके नइं करे गे रिहिस अऊ ओमन यहोवा ला अपन गलती बर जेवन-बलिदान अऊ पाप-बलिदान चघाय हवंय। <verse eid="NUM 15:25"/><verse number="26" style="v" sid="NUM 15:26"/>पूरा इसरायली समाज अऊ ओमन के बीच रहइया परदेसीमन के पाप छेमा हो जाही, काबरकि ओ जम्मो झन अनजाने म करे गे गलती म सामिल रिहिन।<verse eid="NUM 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27"/>“ ‘पर यदि एक मनखे ह अनजाने म पाप करथे, त ओ मनखे ह पाप-बलिदान बर एक साल के बकरी लानय। <verse eid="NUM 15:27"/><verse number="28" style="v" sid="NUM 15:28"/>पुरोहित ह यहोवा के आघू म ओ मनखे बर प्रायस्चित करय, जऊन ह अनजाने म पाप करे हवय, अऊ जब प्रायस्चित कर लिये जाथे, त ओ मनखे के पाप छेमा हो जाही। <verse eid="NUM 15:28"/><verse number="29" style="v" sid="NUM 15:29"/>ओहीच कानून हर ओ मनखे ऊपर लागू होथे, जऊन ह अनजाने म पाप करथे, चाहे ओह देस म जनमे कोनो इसरायली हो या फेर तुम्हर बीच म रहइया कोनो परदेसी।<verse eid="NUM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30"/>“ ‘पर ओ मनखे, जऊन ह जानबूझके पाप करथे, अऊ यहोवा के निन्दा करथे, चाहे जनमजात देसी हो या परदेसी, ओला इसरायलीमन ले जरूर अलग करे जावय। <verse eid="NUM 15:30"/><verse number="31" style="v" sid="NUM 15:31"/>काबरकि ओह यहोवा के बचन ला तुछ समझिस अऊ ओकर हुकूम ला टोरे हवय, ओला खचित अलग कर दिये जावय; ओकर दोस ओकर ऊपर बने रहिथे।’ ”<verse eid="NUM 15:31"/></para>
  <para style="s1">बिसराम दिन के नियम टोरइया मार डारे जावय</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32"/>जब इसरायलीमन सुन्ना जगह म रिहिन, त एक मनखे मिलिस, जऊन ह बिसराम दिन म लकड़ी बीनत रहय। <verse eid="NUM 15:32"/><verse number="33" style="v" sid="NUM 15:33"/>जेमन ला ओह लकड़ी बीनत मिलिस, ओमन ओला मूसा अऊ हारून अऊ जम्मो सभा के आघू म लानिन, <verse eid="NUM 15:33"/><verse number="34" style="v" sid="NUM 15:34"/>अऊ ओमन ओला हिरासत म रखिन, काबरकि अइसे मनखे के संग का करे जावय, ये बात ह साफ नइं रिहिस। <verse eid="NUM 15:34"/><verse number="35" style="v" sid="NUM 15:35"/>तब यहोवा ह मूसा ला कहिस, “ओ मनखे के मरना जरूरी ए। सिविर के बाहिर पूरा सभा ह ओला पथरवाह करय।” <verse eid="NUM 15:35"/><verse number="36" style="v" sid="NUM 15:36"/>तब सभा ह ओला सिविर के बाहिर ले गीस अऊ पथरवाह करके मार डारिस, जइसे कि यहोवा ह मूसा ला हुकूम दे रिहिस।<verse eid="NUM 15:36"/></para>
  <para style="s1">कपड़ा म झालर</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 15:37"/><verse number="38" style="v" sid="NUM 15:38"/>“इसरायलीमन ले बात कर अऊ ओमन ला कह: ‘अवइया पीढ़ी-पीढ़ी तक तुमन अपन कपड़ा के छोर म झालर लगाय करव, अऊ हर झालर ह नीला रंग के डोरी ले बने रहय। <verse eid="NUM 15:38"/><verse number="39" style="v" sid="NUM 15:39"/>ये झालरमन ला जब भी तुमन देखहू, त येह तुमन ला यहोवा के ओ जम्मो हुकूम ला सुरता कराही, जेकर पालन तुमन ला करना हे अऊ तुमन अपन मन अऊ आंखी के लालसा म पड़के अपनआप से बेभिचार नइं करहू। <verse eid="NUM 15:39"/><verse number="40" style="v" sid="NUM 15:40"/>तब तुमन मोर जम्मो हुकूम ला पालन करे बर सुरता करहू अऊ अपनआप ला अपन परमेसर बर पबितर करहू। <verse eid="NUM 15:40"/><verse number="41" style="v" sid="NUM 15:41"/>मेंह यहोवा तुम्हर परमेसर अंव, जऊन ह तुम्हर परमेसर होय बर तुमन ला मिसर देस ले निकाल लानिस। मेंह यहोवा तुम्हर परमेसर अंव।’ ”<verse eid="NUM 15:41"/></para>
  <chapter eid="NUM 15"/>
  <chapter number="16" style="c" sid="NUM 16"/>
  <para style="s1">कोरह, दातान अऊ अबीराम</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1"/>कोरह, जेह लेवी के परपोता, कहात के पोता अऊ ईसहार के बेटा रिहिस, अऊ कुछू रूबेनी—जेमा एलीआब के बेटा दातान अऊ अबीराम, अऊ पेलेत के बेटा ओन—उदंड हो गीन <verse eid="NUM 16:1"/><verse number="2" style="v" sid="NUM 16:2"/>अऊ येमन आके मूसा के बिरूध हो गीन। ओमन के संग 250 इसरायली मनखे घलो सामिल हो गीन, जेमन समाज के नामी अगुवा अऊ समिति के सदस्य घलो चुने गे रिहिन। <verse eid="NUM 16:2"/><verse number="3" style="v" sid="NUM 16:3"/>ओमन मूसा अऊ हारून के बिरोध करे बर एक दल के रूप म आईन अऊ ओमन ला कहिन, “तुमन अति कर दे हवव! पूरा समाज ह पबितर हे; येमा के हर एक जन पबितर हे, अऊ यहोवा ह ओमन के संग हवय। तब तुमन अपनआप ला यहोवा के सभा के ऊपर काबर ठहिराथव?”<verse eid="NUM 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4"/>मूसा ह येला सुनके, दुख म मुहूं-भरसा गिरिस। <verse eid="NUM 16:4"/><verse number="5" style="v" sid="NUM 16:5"/>तब ओह कोरह अऊ ओकर जम्मो दल ला कहिस: “कल बिहनियां यहोवा ह देखाही कि कोन ह ओकर अय अऊ कोन ह पबितर हवय, अऊ ओह ओ मनखे ला अपन लकठा म आवन दीही। जऊन मनखे ला ओह चुनही, ओला ओह अपन लकठा म लानही। <verse eid="NUM 16:5"/><verse number="6" style="v" sid="NUM 16:6"/>हे कोरह, तें अऊ तोर पाछू चलइया मनखेमन ये काम करव: धूपदानमन ला लेवव <verse eid="NUM 16:6"/><verse number="7" style="v" sid="NUM 16:7"/>अऊ कल यहोवा के आघू म ओमा कोइला के अंगरा अऊ धूप डालव। जऊन मनखे ला यहोवा ह चुनही, ओह पबितर अय। तुम लेवीमन अति कर दे हवव!”<verse eid="NUM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8"/>मूसा ह कोरह ला ये घलो कहिस, “हे लेवीमन, तुमन सुनव! <verse eid="NUM 16:8"/><verse number="9" style="v" sid="NUM 16:9"/>का येह तुम्हर बर परयाप्त नो हय कि इसरायल के परमेसर ह तुमन ला बाकि इसरायली समाज ले अलग करे हवय अऊ तुमन ला अपन लकठा म लाने हवय कि तुमन यहोवा के पबितर-तम्बू म सेवा करव अऊ समाज के आघू म ठाढ़ होके ओमन के सेवा करव? <verse eid="NUM 16:9"/><verse number="10" style="v" sid="NUM 16:10"/>ओह तोला अऊ तोर जम्मो संगी लेवीमन ला अपन लकठा म लाने हवय, पर अब तेंह पुरोहित के पद ला घलो पाय के कोसिस करत हस। <verse eid="NUM 16:10"/><verse number="11" style="v" sid="NUM 16:11"/>ये काम ह यहोवा के बिरूध अय कि तें अऊ तोर जम्मो मंडली एक संग जूरे हव। हारून ह कोन ए कि तेंह ओकर बिरूध म बड़बड़ावत हस?”<verse eid="NUM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12"/>तब मूसा ह एलीआब के बेटा दातान अऊ अबीराम ला बुलवाईस, पर ओमन कहिन, “हमन नइं आवन! <verse eid="NUM 16:12"/><verse number="13" style="v" sid="NUM 16:13"/>का येह परयाप्त नो हय कि तेंह दूध अऊ मंधरस के भरमार वाले देस ले हमन ला ये सुन्ना जगह म मारे बर ले आय हस? अऊ अब हमर ऊपर मालिक बने चाहत हस! <verse eid="NUM 16:13"/><verse number="14" style="v" sid="NUM 16:14"/>येकर छोंड़, तेंह हमन ला अइसन देस म नइं लाने, जिहां दूध अऊ मंधरस के भरमार हे अऊ न ही हमन ला खेत अऊ अंगूर के बारीमन के उत्तराधिकार दे हस। का ये मनखेमन संग गुलाम सहीं बरताव करे चाहथस<note caller="+" style="f"><char style="fr" closed="false">16:14 </char><char style="ft" closed="false">का तें ये </char><char style="fq" closed="false">मनखेमन </char><char style="ft" closed="false">के </char><char style="fqa" closed="false">आंखी ला निकाल देय चाहथस</char></note>? नइं, हमन नइं आवन!”<verse eid="NUM 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15"/>तब मूसा ह बहुंत गुस्सा होईस अऊ यहोवा ला कहिस, “ओमन के भेंट ला गरहन झन कर। मेंह ओमन ले एक गदहा तक नइं ले हंव, अऊ न ही ओमन के कुछू हानि करे हंव।”<verse eid="NUM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16"/>मूसा ह कोरह ले कहिस, “तें अऊ तोर जम्मो मंडली ला कल यहोवा के आघू म आना हे—तें अऊ तोर संगीमन अऊ हारून। <verse eid="NUM 16:16"/><verse number="17" style="v" sid="NUM 16:17"/>हर मनखे अपन धूपदान ला लेवय अऊ ओमा धूप डालय—कुल मिलाके 250 धूपदान—येला यहोवा के आघू म अरपन करव। तें अऊ हारून घलो अपन धूपदान ला अरपन करव।” <verse eid="NUM 16:17"/><verse number="18" style="v" sid="NUM 16:18"/>तब ओमन के हर एक जन अपन-अपन धूपदान ला लीन, ओमा कोइला के अंगरा अऊ धूप डालिन, अऊ मिलापवाला तम्बू के मुंहटा म मूसा अऊ हारून के संग ठाढ़ हो गीन। <verse eid="NUM 16:18"/><verse number="19" style="v" sid="NUM 16:19"/>जब कोरह ह अपन जम्मो पाछू चलइयामन ला मिलापवाला तम्बू के मुंहटा म ओमन के बिरोध म इकट्ठा कर लीस, त यहोवा के महिमा ह जम्मो सभा ऊपर परगट होईस। <verse eid="NUM 16:19"/><verse number="20" style="v" sid="NUM 16:20"/>यहोवा ह मूसा अऊ हारून ला कहिस, <verse eid="NUM 16:20"/><verse number="21" style="v" sid="NUM 16:21"/>“अपनआप ला ये सभा ले अलग करव, ताकि मेंह तुरते येमन ला खतम कर दंव।”<verse eid="NUM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22"/>पर मूसा अऊ हारून दुख म मुहूं-भरसा गिरिन अऊ गोहार पारके कहिन, “हे परमेसर, तेंह जम्मो जीयत परानीमन ला सांस देथस, त का सिरिप एक आदमी के पाप करे के कारन पूरा सभा ऊपर गुस्सा करबे?”<verse eid="NUM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23"/>तब यहोवा ह मूसा ला कहिस, <verse eid="NUM 16:23"/><verse number="24" style="v" sid="NUM 16:24"/>“इसरायली सभा ला कह, ‘कोरह, दातान अऊ अबीराम के तम्बू ले हट जावव।’ ”<verse eid="NUM 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25"/>मूसा ह उठिस अऊ दातान अऊ अबीराम करा गीस, अऊ इसरायल के अगुवामन ओकर पाछू-पाछू गीन। <verse eid="NUM 16:25"/><verse number="26" style="v" sid="NUM 16:26"/>ओह इसरायली सभा ला चेताईस, “ये दुस्ट मनखेमन के तम्बू ले दूरिहा हट जावव! ओमन के कुछू भी चीज ला झन छुवव, नइं तो ओमन के जम्मो पाप के कारन तुमन खतम हो जाहू।” <verse eid="NUM 16:26"/><verse number="27" style="v" sid="NUM 16:27"/>तब ओमन कोरह, दातान अऊ अबीराम के तम्बू ले दूरिहा हट गीन। दातान अऊ अबीराम बाहिर निकलके अपन-अपन घरवाली, लइका अऊ छोटे लइकामन संग अपन-अपन तम्बू के दुवार म खड़े रिहिन।<verse eid="NUM 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 16:28"/>तब मूसा ह कहिस, “ये किसम ले तुमन जान लूहू कि यहोवा ह ये जम्मो काम करे बर मोला पठोय हवय अऊ येह मोर उपाय नो हय। <verse eid="NUM 16:28"/><verse number="29" style="v" sid="NUM 16:29"/>यदि ये मनखेमन सुभाविक मऊत मरके जम्मो मानव-जाति सहीं दुख भोगथें, तब यहोवा ह मोला नइं पठोय हे। <verse eid="NUM 16:29"/><verse number="30" style="v" sid="NUM 16:30"/>पर यदि यहोवा ह कुछू एकदम नवां चीज करथे, अऊ धरती ह अपन मुहूं फारथे अऊ येमन ला येमन के जम्मो चीज के संग लील लेथे, अऊ येमन जीयत खाल्हे अधोलोक<note caller="+" style="f"><char style="fr" closed="false">16:30 </char><char style="fq" closed="false">अधोलोक </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मरे मनखेमन के लोक</char></note> म चले जावंय, तब तुमन जान लूहू कि ये मनखेमन यहोवा के अपमान करे हवंय।”<verse eid="NUM 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31"/>मूसा के ये बात खतम होते ही, ओमन के खाल्हे भुइयां ह दू भाग म फट गीस <verse eid="NUM 16:31"/><verse number="32" style="v" sid="NUM 16:32"/>अऊ धरती ह अपन मुहूं ला फारिस अऊ ओमन ला अऊ ओमन के घर के सामान अऊ कोरह के संग के जम्मो मनखे अऊ ओमन के सामान ला लील लीस। <verse eid="NUM 16:32"/><verse number="33" style="v" sid="NUM 16:33"/>ओमन जीते जी खाल्हे अधोलोक म अपन सामान सहित हमा गीन; ओमन के हमाय के बाद, धरती फेर जस के तस हो गीस, अऊ ओमन नास होके समाज के बीच ले मिटा गीन। <verse eid="NUM 16:33"/><verse number="34" style="v" sid="NUM 16:34"/>ओमन के चिल्लई सुनके, ओमन के आसपास के जम्मो इसरायलीमन ये चिचियावत भागिन, “धरती ह हमन ला घलो लीलनेवाला हे!”<verse eid="NUM 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 16:35"/>तब यहोवा ले आगी निकलिस अऊ ओ 250 आदमी ला भसम कर दीस, जऊन मन धूप चढ़ात रिहिन।<verse eid="NUM 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36"/>तब यहोवा ह मूसा ला कहिस, <verse eid="NUM 16:36"/><verse number="37" style="v" sid="NUM 16:37"/>“हारून पुरोहित के बेटा एलिआजर ला कह कि ओह आगी म ले धूपदानमन ला हटा ले अऊ बरत कोइला ला कुछू दूरिहा म बगरा दे, काबरकि ओ धूपदानमन पबितर अंय— <verse eid="NUM 16:37"/><verse number="38" style="v" sid="NUM 16:38"/>ओ मनखेमन के धूपदान, जऊन मन पाप के बदले अपन परान गंवाय हें। ओ धूपदानमन ला पीटके चद्दर बना दव, ताकि ओह बेदी म मढ़े जावय, काबरकि ओमन यहोवा ला चढ़ाय गे रिहिन अऊ पबितर हो गे हवंय। येमन इसरायलीमन बर एक चिनहां ठहिरंय।”<verse eid="NUM 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39"/>तब एलिआजर पुरोहित ह ओ कांसा के धूपदानमन ला संकेलिस, जेला ओमन लाने रिहिन, जेमन जलके मर गीन, अऊ ओह ओमन ला बेदी ऊपर मढ़े बर पीट-पीटके चद्दर बना दीस, <verse eid="NUM 16:39"/><verse number="40" style="v" sid="NUM 16:40"/>जइसे कि यहोवा ह ओला मूसा के दुवारा निरदेस देय रिहिस। अइसने इसरायली सभा ला सुरता कराय बर करे गीस, ताकि हारून के संतानमन ला छोंड़ अऊ कोनो आने मनखे आके यहोवा के आघू म धूप झन जलावय, नइं तो ओह कोरह अऊ ओकर संगवारीमन सहीं हो जाही।<verse eid="NUM 16:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41"/>ओकर दूसर दिन पूरा इसरायली समाज ह मूसा अऊ हारून के बिरूध ये कहिके बड़बड़ाय लगिस, “तुमन यहोवा के मनखेमन ला मार डारेव।”<verse eid="NUM 16:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 16:42"/>पर जब ओ सभा ह मूसा अऊ हारून के बिरोध म जूरिस अऊ मिलापवाला तम्बू कोति मुड़िस, त अचानक बादर ह तम्बू ला ढांप लीस अऊ यहोवा के महिमा परगट होईस। <verse eid="NUM 16:42"/><verse number="43" style="v" sid="NUM 16:43"/>तब मूसा अऊ हारून मिलापवाला तम्बू के सामने गीन, <verse eid="NUM 16:43"/><verse number="44" style="v" sid="NUM 16:44"/>अऊ यहोवा ह मूसा ला कहिस, <verse eid="NUM 16:44"/><verse number="45" style="v" sid="NUM 16:45"/>“ये सभा ले दूरिहा चल दे ताकि मेंह अभीच येमन ला खतम कर दंव।” अऊ मूसा अऊ हारून दुख म मुहूं-भरसा गिरिन।<verse eid="NUM 16:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 16:46"/>तब मूसा ह हारून ला कहिस, “अपन धूपदान ला ले अऊ ओमा बेदी के बरत कोइला लेके ओमा धूप डाल, अऊ बिगर देरी करे सभा के मनखेमन करा जा अऊ ओमन बर पछताप कर। यहोवा के कोप ह भड़के हवय; अऊ महामारी ह सुरू हो गे हवय।” <verse eid="NUM 16:46"/><verse number="47" style="v" sid="NUM 16:47"/>हारून ह वइसने ही करिस, जइसने मूसा ह कहिस, अऊ ओह सभा के बीच म दऊड़के गीस। महामारी ह मनखेमन के बीच सुरू हो गे रिहिस, पर हारून ह धूप चढ़ाईस अऊ ओमन बर पछताप करिस। <verse eid="NUM 16:47"/><verse number="48" style="v" sid="NUM 16:48"/>ओह मरे अऊ जीयत मनखेमन के बीच ठाढ़ होईस, अऊ महामारी ह रूक गीस। <verse eid="NUM 16:48"/><verse number="49" style="v" sid="NUM 16:49"/>पर 14,700 मनखे महामारी ले मर गीन; येह ओमन ला छोंड़के आय, जेमन कोरह के कारन मरे रिहिन। <verse eid="NUM 16:49"/><verse number="50" style="v" sid="NUM 16:50"/>तब हारून ह मिलापवाला तम्बू के दुवार म मूसा करा लहुंट आईस, काबरकि महामारी ह खतम हो गे रिहिस।<note caller="+" style="f"><char style="fr" closed="false">16:50 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="NUM 16:36-50">16:36‑50</ref></char> ला 17:1‑15 गने गे हवय</char></note><verse eid="NUM 16:50"/></para>
  <chapter eid="NUM 16"/>
  <chapter number="17" style="c" sid="NUM 17"/>
  <para style="s1">हारून के लउठी म अंकुर निकलई</para>
  <para style="p">
    <note caller="+" style="f">
      <char style="fr" closed="false">17 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="NUM 17:1-13">17:1‑13</ref></char> ला 17:16‑28 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="NUM 17:1"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 17:1"/><verse number="2" style="v" sid="NUM 17:2"/>“इसरायलीमन ले गोठिया अऊ ओमन ले बारह ठन लउठी ले, ओमन के पुरखा के गोत्र के हर अगुवा ले एक ठन लउठी। हर एक अगुवा के नांव ओकर लउठी म लिख। <verse eid="NUM 17:2"/><verse number="3" style="v" sid="NUM 17:3"/>लेवी के लउठी म हारून के नांव लिख, काबरकि हर गोत्र के मुखिया के नांव म एक लउठी होना चाही। <verse eid="NUM 17:3"/><verse number="4" style="v" sid="NUM 17:4"/>ओ लउठीमन ला मिलापवाला तम्बू म करार कानून के सन्दूक के आघू म रख, जिहां मेंह तुम्हर ले मिलथंव। <verse eid="NUM 17:4"/><verse number="5" style="v" sid="NUM 17:5"/>तब ओ मनखे जेला मेंह चुनहूं, ओकर लउठी म पीका निकलही, अऊ इसरायलीमन तोर बिरूध म जऊन लगातार बड़बड़ावत हें, ओकर ले मेंह अपनआप ला अलग कर लूहूं।”<verse eid="NUM 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6"/>त मूसा ह इसरायलीमन ले बात करिस, अऊ ओमन के अगुवामन ओला बारह ठन लउठी दीन, ओमन के पुरखा के गोत्र के हर अगुवा बर एक ठन लउठी, अऊ हारून के लउठी घलो ओमा रिहिस। <verse eid="NUM 17:6"/><verse number="7" style="v" sid="NUM 17:7"/>मूसा ह लउठीमन ला करार कानून के तम्बू म यहोवा के आघू म रखिस।<verse eid="NUM 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8"/>ओकर दूसर दिन मूसा ह तम्बू के भीतर गीस, त ओह देखिस कि लेवी गोत्र के हारून के लउठी म सिरिप पीका ही नइं निकले रिहिस, पर ओमा कली निकलके, फूल फूटके ओमा बादाम फर भी लगे रिहिस। <verse eid="NUM 17:8"/><verse number="9" style="v" sid="NUM 17:9"/>तब मूसा ह जम्मो लउठी ला यहोवा के आघू ले निकालके इसरायलीमन करा ले आईस। ओमन लउठीमन ला देखिन, अऊ हर एक अगुवा ह अपन-अपन लउठी ला ले लीस।<verse eid="NUM 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 17:10"/>तब यहोवा ह मूसा ला कहिस, “हारून के लउठी ला करार कानून के सन्दूक के आघू म वापिस रख दे, ताकि येह बिदरोहीमन बर एक चिनहां के रूप म रहय। येह मोर बिरूध ओमन के बड़बड़ई ला खतम कर दीही, अऊ ओमन नइं मरहीं।” <verse eid="NUM 17:10"/><verse number="11" style="v" sid="NUM 17:11"/>मूसा ह वइसे ही करिस, जइसे यहोवा ह ओला हुकूम दे रिहिस।<verse eid="NUM 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12"/>इसरायलीमन मूसा ले कहिन, “हमन मर जाबो! हमन भटक गे हन, हमन जम्मो झन भटक गे हन! <verse eid="NUM 17:12"/><verse number="13" style="v" sid="NUM 17:13"/>जऊन ह यहोवा के पबितर-तम्बू के लकठा म भी आही, ओह मर जाही। का हमन जम्मो के जम्मो मर जाबो?”<verse eid="NUM 17:13"/></para>
  <chapter eid="NUM 17"/>
  <chapter number="18" style="c" sid="NUM 18"/>
  <para style="s1">पुरोहित अऊ लेवीमन के काम</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1"/>यहोवा ह हारून ला कहिस, “तें, तोर बेटामन अऊ तोर परिवार, पबितर-स्थान ले संबंधित अपराध के काम के जिम्मेदारी लेवंय, अऊ तें अऊ तोर बेटामन पुरोहित के पद ले संबंधित अपराध के जिम्मेदारी लेवंय। <verse eid="NUM 18:1"/><verse number="2" style="v" sid="NUM 18:2"/>तोर पुरखा के गोत्र के तोर लेवी संगीमन ला अपन संग लेय ले, ताकि जब तें अऊ तोर बेटामन करार कानून के तम्बू के आघू म सेवा करव, त ओमन तुम्हर मदद करंय। <verse eid="NUM 18:2"/><verse number="3" style="v" sid="NUM 18:3"/>ओमन तोर बर जिम्मेदार होवंय अऊ तम्बू के जम्मो काम करंय, पर ओमन पबितर-स्थान के चीजमन के लकठा म या बेदी करा झन जावंय। नइं तो ओमन अऊ तें दूनों मर जाहू। <verse eid="NUM 18:3"/><verse number="4" style="v" sid="NUM 18:4"/>ओमन तोर संग काम करहीं अऊ मिलापवाला तम्बू के देखरेख बर जिम्मेदार होहीं—तम्बू के जम्मो काम बर—पर कोनो आने मनखे तोर लकठा म झन आवय।<verse eid="NUM 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 18:5"/>“पबितर-स्थान अऊ बेदी के देखरेख बर तें जिम्मेदार होबे, ताकि मोर कोप ह इसरायलीमन ऊपर फेर झन भड़के। <verse eid="NUM 18:5"/><verse number="6" style="v" sid="NUM 18:6"/>मेंह इसरायलीमन के बीच ले तोर संगी लेवीमन ला चुने हवंव; येमन मिलापवाला तम्बू म काम करे बर यहोवा ला समरपित तोर बर एक भेंट के सहीं अंय। <verse eid="NUM 18:6"/><verse number="7" style="v" sid="NUM 18:7"/>पर सिरिप तें अऊ तोर बेटामन ही पुरोहित के रूप म बेदी ले संबंधित हर काम अऊ परदा के भीतर के काम करहू। मेंह तोला पुरोहित के पद ला एक भेंट के रूप म देवत हंव। यदि कोनो आने मनखे पबितर-स्थान के लकठा म आथे, त ओह मार डारे जावय।”<verse eid="NUM 18:7"/></para>
  <para style="s1">पुरोहित अऊ लेवीमन बर भेंट</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8"/>तब यहोवा ह हारून ला कहिस, “मोला चघाय गे बलिदानमन के जिम्मेदारी मेंह खुद तोला देवत हंव; ओ जम्मो पबितर बलिदान, जेला इसरायलीमन मोला देथें, ओमन ला मेंह तोला अऊ तोर बेटामन ला तुम्हर भाग, तुम्हर हमेसा के भाग के रूप म देवत हंव। <verse eid="NUM 18:8"/><verse number="9" style="v" sid="NUM 18:9"/>सबले पबितर बलिदानमन, जेला आगी ले अलग रखे जाथे, ओमन तोर होहीं। ओ जम्मो भेंट म ले, जेला ओमन मोर करा सबले पबितर बलिदान के रूप म लानथें, चाहे ओह अन्न या पाप<note caller="+" style="f"><char style="fr" closed="false">18:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुधिकरन</char></note> या दोस-बलिदान होवय, ओ भाग ह तोर अऊ तोर बेटामन के होही। <verse eid="NUM 18:9"/><verse number="10" style="v" sid="NUM 18:10"/>येला सबले पबितर चीज समझके खाय करव; हर एक पुरूस येला खावय। येला तेंह पबितर समझबे।<verse eid="NUM 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11"/>“येह घलो तोर अय: कोनो भी चीज, जेला इसरायलीमन के जम्मो हलाय-बलिदान के भेंट म ले अलग रखे जाथे। मेंह ये चीज तोला अऊ तोर बेटा अऊ बेटीमन ला तोर हमेसा के भाग के रूप म देवत हंव। तोर घर-परिवार के हर ओ मनखे जऊन ह रीति-बिधि से सुध हे, ओह येला खा सकथे।<verse eid="NUM 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 18:12"/>“मेंह तोला ओ जम्मो बढ़िया जैतून तेल अऊ बढ़िया नवां अंगूर के मंद अऊ अनाज देवत हंव, जेला ओमन यहोवा ला अपन फसल के पहिली फर के रूप म देथें। <verse eid="NUM 18:12"/><verse number="13" style="v" sid="NUM 18:13"/>देस के ओ जम्मो पहिली-फसल, जेला ओमन यहोवा करा लानथें, ओह तोर होही। तोर घर-परिवार के हर ओ मनखे जऊन ह रीति-बिधि से सुध हे, ओह येला खा सकथे।<verse eid="NUM 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14"/>“इसरायल म कोनो भी चीज यहोवा ला अरपित करे जाथे, ओह तोर अय। <verse eid="NUM 18:14"/><verse number="15" style="v" sid="NUM 18:15"/>हर परानी के पहिलांत, चाहे ओह मनखे हो या पसु, जेला यहोवा ला अरपन करे जाथे, ओह तोर अय। पर जरूरी अय कि हर पहिलांत बेटा अऊ असुध पसु के हर पहिलांत नर ला दाम लेके छोंड़ देबे। <verse eid="NUM 18:15"/><verse number="16" style="v" sid="NUM 18:16"/>जब ओमन एक महिना के हो जाथें, त तेंह पबितर-स्थान के सेकेल के मुताबिक ठहिराय गे छुटकारा के दाम चांदी के पांच सेकेल<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">लगभग 58 ग्राम</char></note> लेके ओमन ला छोंड़ देबे, येह वजन म बीस गेरा<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">तऊले के सबले छोटे वजन</char></note> होथे।<verse eid="NUM 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 18:17"/>“पर तेंह कोनो गाय, भेड़ या बकरी के पहिलांत ला दाम लेके झन छोंड़बे; येमन पबितर पसु अंय। ओमन के खून ला बेदी ऊपर छिड़कबे अऊ ओमन के चरबी ला यहोवा ला महकत सुख-देवइया एक जेवन-बलिदान के रूप म जलाबे। <verse eid="NUM 18:17"/><verse number="18" style="v" sid="NUM 18:18"/>ओमन के मांस ह तोर होवय, जइसे कि हलाय-बलिदान के छाती अऊ जेवनी जांघ ह तोर होथे। <verse eid="NUM 18:18"/><verse number="19" style="v" sid="NUM 18:19"/>जऊन पबितर बलिदान इसरायलीमन यहोवा ला चघाथें, ओमा ले अलग रखे गे कोनो भी चीज मेंह तोला अऊ तोर बेटा अऊ बेटीमन ला तोर हमेसा के भाग के रूप म देवत हंव। येह तोर अऊ तोर संतानमन बर यहोवा के आघू म हमेसा बर नून के करार ए।”<verse eid="NUM 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20"/>फेर यहोवा ह हारून ला कहिस, “ओमन के देस म तोर कोनो उत्तराधिकार नइं होही, अऊ न ही ओमन के बीच तोर कोनो भाग होही; इसरायलीमन के बीच म, मेंह तोर भाग अऊ उत्तराधिकार अंव।<verse eid="NUM 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21"/>“मिलापवाला तम्बू म लेवीमन सेवा के जऊन काम करथें, ओकर बदले म, मेंह इसरायल म ओमन ला उत्तराधिकार के रूप म जम्मो दसमांस देवत हंव। <verse eid="NUM 18:21"/><verse number="22" style="v" sid="NUM 18:22"/>अब के बाद, इसरायलीमन मिलापवाला तम्बू के लकठा म झन जावंय, नइं तो ओमन अपन पाप के परतिफल भोगहीं अऊ मर जाहीं। <verse eid="NUM 18:22"/><verse number="23" style="v" sid="NUM 18:23"/>येमन लेवी अंय, जेमन मिलापवाला तम्बू म काम करहीं अऊ येकर बिरूध करे गे कोनो अपराध के जिम्मेदारी ओमन ऊपर होही। येह अवइया पीढ़ी-पीढ़ी तक एक बिधि ठहिरय। इसरायलीमन के बीच म, ओमन के कोनो उत्तराधिकार नइं होही। <verse eid="NUM 18:23"/><verse number="24" style="v" sid="NUM 18:24"/>बदले म, मेंह लेवीमन ला ओमन के उत्तराधिकार के रूप म ओ दसमांस ला देवत हंव, जेला इसरायलीमन यहोवा करा एक बलिदान के रूप म चघाथें। एकरे कारन मेंह ओमन के बारे म कहेंव: ‘इसरायलीमन के बीच म ओमन के कोनो उत्तराधिकार नइं होही।’ ”<verse eid="NUM 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25"/>यहोवा ह मूसा ला कहिस, <verse eid="NUM 18:25"/><verse number="26" style="v" sid="NUM 18:26"/>“लेवीमन ले बात कर अऊ ओमन ला कह: ‘जब तुमन ला इसरायलीमन ले दसमांस मिलथे, जेला मेंह तुमन ला तुम्हर उत्तराधिकार के रूप म देथंव, त तुमन ओ दसमांस के दसवां भाग यहोवा ला भेंट के रूप म चघावव। <verse eid="NUM 18:26"/><verse number="27" style="v" sid="NUM 18:27"/>तुम्हर भेंट के हिसाब तुम्हर बर कोठार के अनाज के रूप म या अंगूर के रसकुंड के रस के रूप म करे जाही। <verse eid="NUM 18:27"/><verse number="28" style="v" sid="NUM 18:28"/>ये किसम ले तुमन घलो ओ जम्मो दसमांस म ले यहोवा ला एक भेंट चघाहू, जेह तुमन ला इसरायलीमन ले मिलथे। अऊ येह जरूरी अय कि ये दसमांस म ले यहोवा के भाग ला तुमन हारून पुरोहित ला देवव। <verse eid="NUM 18:28"/><verse number="29" style="v" sid="NUM 18:29"/>तुमन ला जऊन चीज भी दिये जाथे, ओ हर चीज के सबले बने अऊ पबितर भाग ला यहोवा के भाग मानके भेंट चघावव।’<verse eid="NUM 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30"/>“लेवीमन ला कह: ‘जब तुमन सबले बने भाग ला चघाथव, त येला तुम्हर बर कोठार के अनाज या अंगूर के रसकुंड के रस सहीं हिसाब करे जाही। <verse eid="NUM 18:30"/><verse number="31" style="v" sid="NUM 18:31"/>तुमन अपन परिवार सहित बांचे चीज ला कहूं मेर खा सकत हव, काबरकि येह तुम्हर मिलापवाला तम्बू म काम करे के मजदूरी अय। <verse eid="NUM 18:31"/><verse number="32" style="v" sid="NUM 18:32"/>येकर सबले बने भाग ला चघाय के दुवारा तुमन ये बात म दोसी नइं ठहिरहू; तब तुमन इसरायलीमन के पबितर बलिदानमन ला असुध नइं करहू, अऊ तुमन नइं मरहू।’ ”<verse eid="NUM 18:32"/></para>
  <chapter eid="NUM 18"/>
  <chapter number="19" style="c" sid="NUM 19"/>
  <para style="s1">सुध करइया पानी</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1"/>यहोवा ह मूसा अऊ हारून ला कहिस: <verse eid="NUM 19:1"/><verse number="2" style="v" sid="NUM 19:2"/>“येह कानून के एक जरूरत अय, जेकर हुकूम यहोवा ह दे हवय: इसरायलीमन ला कह कि ओमन एक लाल रंग के बछिया बिगर दोस के लानंय, जेकर ऊपर जुड़ा कभू नइं रखे गे हवय। <verse eid="NUM 19:2"/><verse number="3" style="v" sid="NUM 19:3"/>येला एलिआजर पुरोहित ला दे दव; येला सिविर के बाहिर लाने जावय अऊ ओकर आघू म मारे जावय। <verse eid="NUM 19:3"/><verse number="4" style="v" sid="NUM 19:4"/>तब एलिआजर पुरोहित ह एकर कुछू खून ला अपन अंगठी म लेवय अऊ येला मिलापवाला तम्बू के सामने कोति सात बार छिंचय। <verse eid="NUM 19:4"/><verse number="5" style="v" sid="NUM 19:5"/>ओकर बाद ओकर देखत म, ओ बछिया ला जला दिये जावय—ओकर चाम, मांस, लहू अऊ पोटा ला। <verse eid="NUM 19:5"/><verse number="6" style="v" sid="NUM 19:6"/>पुरोहित ह कुछू देवदार लकड़ी, जूफा अऊ सिन्दूरी रंग के ऊन लेवय अऊ ये चीजमन ला ओ बरत बछिया के ऊपर फटिक देवय। <verse eid="NUM 19:6"/><verse number="7" style="v" sid="NUM 19:7"/>ओकर बाद, जरूरी अय कि पुरोहित ह अपन ओनहा ला धोवय अऊ खुद नहावय। तब ओह सिविर म आवय, पर ओह बिधि के रूप म सांझ तक असुध रहिही। <verse eid="NUM 19:7"/><verse number="8" style="v" sid="NUM 19:8"/>जऊन मनखे ह येला जलाथे, ओह घलो अपन ओनहा ला जरूर धोवय अऊ नहावय, अऊ ओह घलो सांझ तक असुध रहिही।<verse eid="NUM 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9"/>“ओ मनखे जऊन ह सुध हे, ओह ओ बछिया के राख ला इकट्ठा करय अऊ ओला सिविर के बाहिर बिधि के रूप म सुध करे गे एक जगह म रख देवय। इसरायली समाज ह पानी ला सुध करे म येकर उपयोग करय; येह पाप ले सुध होय बर अय। <verse eid="NUM 19:9"/><verse number="10" style="v" sid="NUM 19:10"/>जऊन मनखे ह बछिया के राख ला इकट्ठा करथे, ओह घलो अपन ओनहा ला जरूर धोवय, अऊ ओह घलो सांझ तक असुध रहिही। येह इसरायली अऊ ओमन के बीच रहइया परदेसी दूनों बर हमेसा-हमेसा के एक बिधि ठहिरही।<verse eid="NUM 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11"/>“जऊन मनखे कोनो मनखे के लास ला छूही, त ओह सात दिन तक असुध रहिही। <verse eid="NUM 19:11"/><verse number="12" style="v" sid="NUM 19:12"/>जरूरी अय कि ओह तीसरा दिन अऊ सातवां दिन अपनआप ला पानी ले सुध करय; तब ओह सुध होही। पर यदि ओह तीसरा अऊ सातवां दिन अपनआप ला सुध नइं करय, त ओह सुध नइं होही। <verse eid="NUM 19:12"/><verse number="13" style="v" sid="NUM 19:13"/>यदि ओह कोनो मनखे के लास ला छूए के बाद अपनआप ला सुध नइं करय, त ओह यहोवा के पबितर-तम्बू ला असुध करथे। अइसे मनखे ला इसरायल ले अलग कर दिये जावय। ओह असुध हवय, काबरकि ओकर ऊपर सुध करइया पानी छिंचे नइं गे हवय; ओकर असुधता ओकर ऊपर बने रहिथे।<verse eid="NUM 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14"/>“ये कानून ह तब लागू होथे, जब कोनो मनखे कोनो तम्बू म मर जाथे: कोनो मनखे ओ तम्बू के भीतर जाथे या जऊन ह ओ तम्बू म हवय, ओह सात दिन तक असुध रहिही, <verse eid="NUM 19:14"/><verse number="15" style="v" sid="NUM 19:15"/>अऊ ओ तम्बू म हर एक खुला बरतन, जेला ढकना ले ढांपे नइं गे हवय, ओह असुध होही।<verse eid="NUM 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 19:16"/>“जऊन मनखे ह बाहिर खुला मैदान म तलवार ले मारे गे मनखे या सुभाविक मिरतू ले मरे मनखे या मनखे के हाड़ा या कोनो कबर ला छू लेथे, त ओह सात दिन तक असुध रहिही।<verse eid="NUM 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17"/>“असुध मनखे बर, ओ जलाय गे सुध करइया पाप-बलिदान म ले कुछू राख लेके एक बरतन म रखव अऊ ओकर ऊपर ताजा पानी डारव। <verse eid="NUM 19:17"/><verse number="18" style="v" sid="NUM 19:18"/>तब बिधि के मुताबिक कोनो सुध मनखे ह कुछू जूफा लेवय अऊ येला पानी म बोरके तम्बू अऊ जम्मो सामान अऊ ओ मनखेमन ऊपर छिंचय, जेमन उहां हवंय। ओह ओ मनखे के ऊपर घलो छिंचय, जऊन ह कोनो मनखे के हाड़ा या कोनो कबर या कोनो मारे गे मनखे या कोनो सुभाविक मिरतू ले मरे मनखे ला छू ले हवय। <verse eid="NUM 19:18"/><verse number="19" style="v" sid="NUM 19:19"/>ओ मनखे जऊन ह सुध हे, ओह असुध मनखे ऊपर तीसरा अऊ सातवां दिन छिंचय, अऊ सातवां दिन ओह ओला सुध करय। जेमन ला सुध करे जाथे, ओमन अपन कपड़ा ला जरूर धोवंय अऊ नहावंय, अऊ ओ सांझ के बेरा ओमन सुध हो जाहीं। <verse eid="NUM 19:19"/><verse number="20" style="v" sid="NUM 19:20"/>पर जऊन मनखेमन असुध हवंय अऊ यदि अपनआप ला सुध नइं करंय, त ओमन ला समाज ले अलग कर दिये जावय, काबरकि ओमन यहोवा के पबितर-स्थान ला असुध करे हवंय। सुध करइया पानी ह ओमन ऊपर छिंचे नइं गे हवय, अऊ ओमन असुध हवंय। <verse eid="NUM 19:20"/><verse number="21" style="v" sid="NUM 19:21"/>येह ओमन बर हमेसा के बिधि ठहिरय।</para>
  <para style="p" vid="NUM 19:21">“जऊन मनखे ह सुध करइया पानी ला छिंचथे, ओह घलो अपन ओनहा ला जरूर धोवय, अऊ जऊन ह सुध करइया पानी ला छूथे, ओह सांझ तक असुध रहिही। <verse eid="NUM 19:21"/><verse number="22" style="v" sid="NUM 19:22"/>जऊन भी चीज ला ओ असुध मनखे छूथे, ओह असुध हो जाथे, अऊ जऊन मनखे ओ चीज ला छूथे, ओह सांझ तक असुध हो जाथे।”<verse eid="NUM 19:22"/></para>
  <chapter eid="NUM 19"/>
  <chapter number="20" style="c" sid="NUM 20"/>
  <para style="s1">चट्टान ले पानी</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1"/>पहिला महिना म, जम्मो इसरायली समाज के मनखेमन सीन के सुन्ना जगह म हबरिन, अऊ ओमन कादेस नगर म डेरा डालिन। उहां मिरियम ह मर गीस अऊ ओला उहां माटी दिये गीस।<verse eid="NUM 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2"/>उहां समाज के मनखेमन बर पानी नइं रिहिस, अऊ मनखेमन मूसा अऊ हारून के बिरोध म जूर गीन। <verse eid="NUM 20:2"/><verse number="3" style="v" sid="NUM 20:3"/>ओमन मूसा ले झगरा करे लगिन अऊ कहिन, “बने होतिस कि हमन घलो अपन संगी इसरायलीमन संग, यहोवा के आघू म मर गे रहितेंन! <verse eid="NUM 20:3"/><verse number="4" style="v" sid="NUM 20:4"/>तेंह काबर यहोवा के समाज ला ये सुन्ना जगह म लाने कि हमन अऊ हमर पसुमन इहां मर जावन? <verse eid="NUM 20:4"/><verse number="5" style="v" sid="NUM 20:5"/>तेंह काबर हमन ला मिसर देस ले बाहिर निकालके ये भयानक जगह म ले आय? इहां न तो अनाज या अंजीर, अऊ न ही अंगूर के नार या अनार हवय। अऊ इहां पीये बर पानी घलो नइं ए!”<verse eid="NUM 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6"/>मूसा अऊ हारून सभा ले निकलके मिलापवाला तम्बू के दुवार करा गीन अऊ निरासा म मुहूं-भरसा गिरिन, अऊ यहोवा के महिमा ओमन ऊपर परगट होईस। <verse eid="NUM 20:6"/><verse number="7" style="v" sid="NUM 20:7"/>यहोवा ह मूसा ला कहिस, <verse eid="NUM 20:7"/><verse number="8" style="v" sid="NUM 20:8"/>“ओ लउठी ला ले अऊ तें अऊ तोर भाई हारून इसरायली सभा ला एक जगह इकट्ठा करव। अऊ ओमन के देखत म ओ चट्टान ले बात कर अऊ येह अपन म ले पानी निकालही। तेंह समाज बर ये चट्टान म ले पानी निकालबे ताकि ओमन अऊ ओमन के पसु पानी पी सकंय।”<verse eid="NUM 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 20:9"/>तब मूसा ह यहोवा के हुकूम के मुताबिक ओकर आघू म ओ लउठी ला ले लीस। <verse eid="NUM 20:9"/><verse number="10" style="v" sid="NUM 20:10"/>अऊ मूसा अऊ हारून चट्टान के आघू म समाज ला इकट्ठा करिन अऊ मूसा ह ओमन ला कहिस, “हे बिदरोह करइयामन, सुनव! का हमन ला ये चट्टान म ले तुम्हर बर पानी निकाले बर पड़ही?” <verse eid="NUM 20:10"/><verse number="11" style="v" sid="NUM 20:11"/>तब मूसा ह अपन हांथ उठाईस अऊ अपन लउठी ले ओ चट्टान ला दू बार मारिस। तब ओमा ले पानी बहे लगिस, अऊ पूरा समाज अऊ ओमन के पसुमन ओ पानी ला पीईन।<verse eid="NUM 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12"/>पर यहोवा ह मूसा अऊ हारून ला कहिस, “काबरकि तुमन इसरायलीमन के नजर म मोर ऊपर न तो परयाप्त भरोसा रखेव, न ही पबितर मानके आदर देव, एकरसेति तुमन ये समाज ला ओ देस म नइं ले जा सकहू, जेला मेंह ओमन ला दे हंव।”<verse eid="NUM 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 20:13"/>येमन मरीबा<note caller="+" style="f"><char style="fr" closed="false">20:13 </char><char style="fq" closed="false">मरीबा </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">झगरा करई</char></note> पानी के सोतामन रिहिन, जिहां इसरायलीमन यहोवा ले झगरा करिन अऊ जिहां ओह ओमन के बीच म पबितर ठहिराय गीस।<verse eid="NUM 20:13"/></para>
  <para style="s1">इसरायल के यातरा ला एदोम के इनकार</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14"/>मूसा ह एदोम के राजा करा कादेस ले संदेसियामन ला ये कहिके पठोईस:</para>
  <para style="pm" vid="NUM 20:14">“तोर भाई इसरायल ह ये कहत हे: तेंह हमर ऊपर आय ओ जम्मो मुसीबत ला जानत हस। <verse eid="NUM 20:14"/><verse number="15" style="v" sid="NUM 20:15"/>हमर पुरखामन मिसर देस ला गीन, अऊ हमन उहां बहुंत साल रहेंन। मिसर के मनखेमन हमर अऊ हमर पुरखामन संग बुरा बरताव करिन, <verse eid="NUM 20:15"/><verse number="16" style="v" sid="NUM 20:16"/>पर जब हमन यहोवा ले गोहारेंन, त ओह हमर गोहार ला सुनिस अऊ एक स्वरगदूत पठोके हमन ला मिसर देस ले बाहिर निकालिस।</para>
  <para style="pm" vid="NUM 20:16">“अब हमन इहां कादेस नगर म हन, जऊन ह तोर राज के तीर म हवय। <verse eid="NUM 20:16"/><verse number="17" style="v" sid="NUM 20:17"/>किरपा करके तोर देस म ले होके हमन ला जावन दे। हमन कोनो खेत या अंगूर के बारी म ले होके नइं जावन, अऊ न ही कोनो कुआं के पानी पीयन। हमन राजा के राजमार्ग म ही जाबो अऊ जब तक तोर राज ले निकल नइं जाबो तब तक न तो जेवनी मुड़बो अऊ न ही डेरी।”<verse eid="NUM 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18"/>पर एदोम ह जबाब दीस:</para>
  <para style="pm" vid="NUM 20:18">“तुमन इहां ले होके नइं जा सकव; यदि कोसिस करहू, त हमन बाहिर निकलके तलवार से तुम्हर ऊपर हमला करबो।”<verse eid="NUM 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19"/>तब इसरायलीमन ये जबाब दीन:</para>
  <para style="pm" vid="NUM 20:19">“हमन सिरिप मुख्य सड़क म जाबो, अऊ यदि हमन या हमर पसुमन तुम्हर कोनो पानी ला पीहीं, त हमन ओकर दाम चुकाबो। हमन सिरिप पैदल जाय चाहथन—अऊ कुछू नइं।”<verse eid="NUM 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20"/>फेर ओह ये जबाब दीस:</para>
  <para style="pm" vid="NUM 20:20">“तुमन इहां ले होके नइं जा सकव।”</para>
  <para style="p" vid="NUM 20:20">तब एदोम ह ओमन के बिरूध एक बड़े अऊ सक्तिसाली सेना लेके निकलिस। <verse eid="NUM 20:20"/><verse number="21" style="v" sid="NUM 20:21"/>एदोम ह ओमन ला अपन राज म ले होके जाय बर मना करिस, त इसरायल ह उहां ले मुड़के चल दीस।<verse eid="NUM 20:21"/></para>
  <para style="s1">हारून के मिरतू</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22"/>पूरा इसरायली समाज ह कादेस ले चलके होर पहाड़ करा आईस। <verse eid="NUM 20:22"/><verse number="23" style="v" sid="NUM 20:23"/>एदोम के सीमना के लकठा म, होर पहाड़ म, यहोवा ह मूसा अऊ हारून ला कहिस, <verse eid="NUM 20:23"/><verse number="24" style="v" sid="NUM 20:24"/>“हारून ह अपन पुरखा संग हमेसा बर सुत जाही। ओह ओ देस म नइं जा सकही, जेला मेंह इसरायलीमन ला दे हंव, काबरकि तुमन दूनों मरीबा के सोता करा मोर हुकूम के बिरूध बिदरोह करे रहेव।<note caller="+" style="f"><char style="fr" closed="false">20:24 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="DEU 32:50">ब्यव 32:50</ref></char></char></note> <verse eid="NUM 20:24"/><verse number="25" style="v" sid="NUM 20:25"/>हारून अऊ ओकर बेटा एलिआजर ला लेके होर पहाड़ के ऊपर जा। <verse eid="NUM 20:25"/><verse number="26" style="v" sid="NUM 20:26"/>हारून के पुरोहिती कपड़ा ला उतारके ओला ओकर बेटा एलिआजर ला पहिरा, काबरकि हारून ह अपन मनखेमन संग मिल जाही; ओह उहां मर जाही।”<verse eid="NUM 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27"/>मूसा ह यहोवा के हुकूम के मुताबिक करिस: ओमन जम्मो समाज के देखत म होर पहाड़ ऊपर गीन। <verse eid="NUM 20:27"/><verse number="28" style="v" sid="NUM 20:28"/>मूसा ह हारून के पुरोहिती कपड़ामन ला उतारिस अऊ ओ कपड़ा ला हारून के बेटा एलिआजर ला पहिरा दीस। अऊ हारून ह उहां पहाड़ के टीप म मर गीस। तब मूसा अऊ एलिआजर पहाड़ ले खाल्हे उतरिन, <verse eid="NUM 20:28"/><verse number="29" style="v" sid="NUM 20:29"/>अऊ जब पूरा समाज ला पता चलिस कि हारून ह मर गे हवय, त जम्मो इसरायलीमन ओकर बर तीस दिन तक बिलाप करिन।<verse eid="NUM 20:29"/></para>
  <chapter eid="NUM 20"/>
  <chapter number="21" style="c" sid="NUM 21"/>
  <para style="s1">अराद ह नास हो जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1"/>जब नेगेव<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="fq" closed="false">नेगेव </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कनान के दक्खिनी निरजन प्रदेस</char></note> म रहइया अराद के कनानी राजा ये सुनिस कि इसरायल ह अतारीम के सड़क के रसता ले आवत हे, त ओह इसरायलीमन ऊपर हमला करिस अऊ ओमा के कुछू झन ला बंदी बना लीस। <verse eid="NUM 21:1"/><verse number="2" style="v" sid="NUM 21:2"/>तब इसरायल ह यहोवा ले ये मन्नत मानिस: “यदि तेंह ये मनखेमन ला हमर हांथ म कर देबे, त हमन ओमन के सहरमन ला पूरा नास कर देबो।” <verse eid="NUM 21:2"/><verse number="3" style="v" sid="NUM 21:3"/>यहोवा ह इसरायल के बिनती ला सुनिस अऊ कनानीमन ला ओमन के अधीन कर दीस। इसरायलीमन ओमन ला अऊ ओमन के नगरमन ला पूरा नास कर दीन, एकरसेति ओ जगह के नांव होरमा<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="fq" closed="false">होरमा </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">बिनास </char><char style="ft" closed="false">होथे</char></note> पड़िस।<verse eid="NUM 21:3"/></para>
  <para style="s1">कांसा के सांप</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4"/>ओमन होर पहाड़ ले आघू बढ़िन अऊ एदोम देस के बाहिर-बाहिर लाल-समुंदर के रसता ला धरिन। पर रसता म मनखेमन के धीरज खतम होय लगिस; <verse eid="NUM 21:4"/><verse number="5" style="v" sid="NUM 21:5"/>ओमन परमेसर अऊ मूसा के बिरूध गोठियाय लगिन, अऊ कहिन, “तेंह काबर हमन ला मिसर देस ले निकालके ये सुन्ना जगह म मरे बर ले आय? इहां न तो रोटी हवय न पानी! अऊ हमन ला ये बेकार के जेवन ले घिन हो गे हवय!”<verse eid="NUM 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 21:6"/>तब यहोवा ह ओमन के बीच जहरिला सांप पठोईस; ओमन मनखेमन ला चाबिन अऊ कतको इसरायलीमन मर गीन। <verse eid="NUM 21:6"/><verse number="7" style="v" sid="NUM 21:7"/>तब मनखेमन मूसा करा आके कहिन, “हमन यहोवा अऊ तोर बिरूध बात करके पाप करे हन। पराथना कर कि यहोवा ह ये सांपमन ला हमर करा ले हटा ले।” तब मूसा ह मनखेमन बर पराथना करिस।<verse eid="NUM 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8"/>यहोवा ह मूसा ला कहिस, “सांप के एक मूरती बनाके खंभा के ऊपर टांग दे; सांप के चाबे मनखे ह ओला देखके जीयत रहिही।” <verse eid="NUM 21:8"/><verse number="9" style="v" sid="NUM 21:9"/>त मूसा ह कांसा के एक ठन सांप के मूरती बनाईस अऊ ओला एक खंभा के ऊपर रख दीस। तब सांप के चाबे जऊन भी मनखे ओ कांसा के सांप ला देखय, त ओह बच जावय।<verse eid="NUM 21:9"/></para>
  <para style="s1">मोआब के यातरा</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10"/>इसरायलीमन आघू बढ़िन अऊ ओबोत नांव के जगह म डेरा डालिन। <verse eid="NUM 21:10"/><verse number="11" style="v" sid="NUM 21:11"/>तब ओमन ओबोत ले कूच करके इये-अबारीम के सुन्ना जगह म डेरा डालिन, जऊन ह मोआब के सामने पूरब कोति हवय। <verse eid="NUM 21:11"/><verse number="12" style="v" sid="NUM 21:12"/>उहां ले ओमन आघू बढ़िन अऊ जेरेद के घाटी म डेरा डालिन। <verse eid="NUM 21:12"/><verse number="13" style="v" sid="NUM 21:13"/>ओमन उहां ले बढ़त गीन अऊ अरनोन के तीर म डेरा डालिन, जऊन ह सुन्ना जगह म हवय अऊ अमोरी राज के सीमना तक फईले हवय। अरनोन ह मोआब के सीमना अय, मोआब अऊ अमोरीमन के बीच म। <verse eid="NUM 21:13"/><verse number="14" style="v" sid="NUM 21:14"/>एकरसेति यहोवा के लड़ई नांव के किताब म ये लिखे हवय:</para>
  <para style="q1" vid="NUM 21:14">“सूपा म जाहब<note caller="+" style="f"><char style="fr" closed="false">21:14 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">वाहेब</char></note> अऊ घाटीमन,</para>
  <para style="q2" vid="NUM 21:14">अरनोन <verse eid="NUM 21:14"/><verse number="15" style="v" sid="NUM 21:15"/>अऊ घाटीमन के ढलान</para>
  <para style="q1" vid="NUM 21:15">जऊन ह आर के इलाका तक जाथे</para>
  <para style="q2" vid="NUM 21:15">अऊ मोआब के सीमना तक फईले हवय।”<verse eid="NUM 21:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 21:16"/>उहां ले ओमन आघू बढ़िन अऊ बीर नांव कुआं करा हबरिन, जिहां यहोवा ह मूसा ला कहे रिहिस, “मनखेमन ला एक जगह म इकट्ठा कर अऊ मेंह ओमन ला पानी दूहूं।”<verse eid="NUM 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17"/>तब इसरायल ह ये गीत गाईस:</para>
  <para style="q1" vid="NUM 21:17">“हे कुआं, पानी ले भर जा!</para>
  <para style="q2" vid="NUM 21:17">ये गीत गावव,<verse eid="NUM 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18"/>ओ कुआं के बारे म जेला हाकिममन कोड़िन,</para>
  <para style="q2" vid="NUM 21:18">जेला परभावसाली मनखेमन कोड़िन—</para>
  <para style="q2" vid="NUM 21:18">परभावसाली मनखेमन राजदंड अऊ लउठी ले कोड़िन।”</para>
  <para style="m" vid="NUM 21:18">तब ओमन सुन्ना जगह ले मत्ताना करा गीन, <verse eid="NUM 21:18"/><verse number="19" style="v" sid="NUM 21:19"/>मत्ताना ले नहलीएल, नहलीएल ले बामोत, <verse eid="NUM 21:19"/><verse number="20" style="v" sid="NUM 21:20"/>अऊ बामोत ले मोआब के घाटी करा, जिहां पिसगा पहाड़ के टीप ह बीरान भुइयां ले ऊंच हवय।<verse eid="NUM 21:20"/></para>
  <para style="s1">सीहोन अऊ ओग के हार</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21"/>इसरायल ह अमोरीमन के राजा सीहोन करा संदेसियामन ला ये कहे बर पठोईस:<verse eid="NUM 21:21"/></para>
  <para style="pm">
    <verse number="22" style="v" sid="NUM 21:22"/>“हमन ला तोर देस म ले होके जावन दे। हमन कोनो खेत या अंगूर के बारी कोति नइं जावन, न ही कोनो कुआं के पानी पीयन। जब तक तोर राज ले निकल नइं जाबो, तब तक हमन राजा के राजमार्ग म ही जाबो।”<verse eid="NUM 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23"/>पर सीहोन ह इसरायल ला अपन देस म ले होके जावन नइं दीस। ओह अपन पूरा सेना ला इकट्ठा करिस अऊ इसरायल के बिरूध सुन्ना जगह करा गीस। जब ओह यहस नगर करा हबरिस, त उहां ओह इसरायल के संग लड़िस। <verse eid="NUM 21:23"/><verse number="24" style="v" sid="NUM 21:24"/>पर इसरायल ह ओला तलवार ले मार डारिस अऊ अरनोन नदी ले लेके यब्बोक नदी तक ओकर देस म अधिकार कर लीस, पर सिरिप उहां तक, जिहां अमोनीमन रिहिन, काबरकि ओमन के सीमना ला किलाबंदी करे गे रिहिस। <verse eid="NUM 21:24"/><verse number="25" style="v" sid="NUM 21:25"/>इसरायल ह अमोरीमन के जम्मो सहर ऊपर कब्जा करके ओमन ऊपर अधिकार कर लीस, जेमा हेसबोन सहर अऊ ओकर आसपास के नगर अऊ बस्तीमन घलो रिहिन। <verse eid="NUM 21:25"/><verse number="26" style="v" sid="NUM 21:26"/>हेसबोन ह अमोरीमन के राजा सीहोन के सहर रिहिस, जऊन ह मोआब के पहिले के राजा के बिरूध लड़े रिहिस अऊ ओकर ले अरनोन तक ओकर जम्मो देस ला लेय ले रिहिस।<verse eid="NUM 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 21:27"/>एकरे कारन कबिमन कहिथें:</para>
  <para style="q1" vid="NUM 21:27">“हेसबोन म आवव अऊ येला फेर बनावव;</para>
  <para style="q2" vid="NUM 21:27">सीहोन के सहर ह फेर पहिले सहीं हो जावय।<verse eid="NUM 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28"/>“हेसबोन ले आगी,</para>
  <para style="q2" vid="NUM 21:28">अऊ सीहोन के सहर ले जुवाला निकलिस।</para>
  <para style="q1" vid="NUM 21:28">येह मोआब के आर नगर ला,</para>
  <para style="q2" vid="NUM 21:28">अरनोन के ऊंच जगह के मनखेमन ला भसम कर दीस।<verse eid="NUM 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29"/>हे मोआब, तोर ऊपर हाय!</para>
  <para style="q2" vid="NUM 21:29">हे कमोस देवता के मनखेमन, तुमन नास हो गेव!</para>
  <para style="q1" vid="NUM 21:29">ओह अपन बेटामन ला सरनार्थी के रूप म</para>
  <para style="q2" vid="NUM 21:29">अऊ अपन बेटीमन ला कैदी के रूप म</para>
  <para style="q2" vid="NUM 21:29">अमोरीमन के राजा सीहोन ला दे दीस।<verse eid="NUM 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30"/>“पर हमन ओमन ला गिरा दे हन;</para>
  <para style="q2" vid="NUM 21:30">हेसबोन सहर के राज ह दीबोन नगर तक नास हो गे हवय।</para>
  <para style="q1" vid="NUM 21:30">हमन ओमन ला नोपह नगर तक उजाड़ दे हन</para>
  <para style="q2" vid="NUM 21:30">जऊन ह मेदबा नगर तक फईले हवय।”<verse eid="NUM 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31"/>ये किसम ले इसरायल ह अमोरीमन के देस म बस गीस।<verse eid="NUM 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 21:32"/>मूसा के याजेर सहर म भेदियामन ला पठोय के बाद, इसरायलीमन ओकर आसपास के इलाका म कब्जा कर लीन अऊ जऊन अमोरीमन उहां रिहिन, ओमन ला भगा दीन। <verse eid="NUM 21:32"/><verse number="33" style="v" sid="NUM 21:33"/>तब ओमन मुड़के सड़क म होवत बासान कोति गीन, अऊ बासान के राजा ओग अऊ ओकर पूरा सेना ओमन के संग लड़ई करे बर निकलके एदरेई नगर करा आईन।<verse eid="NUM 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 21:34"/>यहोवा ह मूसा ला कहिस, “ओकर ले झन डर, काबरकि मेंह ओला ओकर पूरा सेना अऊ ओकर देस सहित तोर हांथ म कर देवत हंव। ओकर संग वइसने ही कर, जइसने तेंह अमोरीमन के राजा सीहोन के संग करय, जऊन ह हेसबोन म राज करत रिहिस।”<verse eid="NUM 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 21:35"/>तब इसरायलीमन राजा ओग अऊ ओकर बेटामन ला पूरा सेना सहित मार डारिन; ओमा के एको झन घलो नइं बचिन। अऊ इसरायलीमन ओकर देस ऊपर अधिकार कर लीन।<verse eid="NUM 21:35"/></para>
  <chapter eid="NUM 21"/>
  <chapter number="22" style="c" sid="NUM 22"/>
  <para style="s1">बालाक ह बिलाम ला बुलवाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1"/>तब इसरायलीमन मोआब के मैदान म हबरिन अऊ यरीहो के सामने यरदन नदी के तीर म डेरा डालिन।<verse eid="NUM 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2"/>सिप्पोर के बेटा बालाक ह ओ जम्मो ला देखिस, जेला इसरायल ह अमोरीमन संग करे रिहिस, <verse eid="NUM 22:2"/><verse number="3" style="v" sid="NUM 22:3"/>अऊ मोआब ह डरा गीस, काबरकि इसरायलीमन बहुंत बड़े संखिया म रिहिन। वास्तव म, मोआब ह इसरायलीमन के कारन भयंकर डरा गीस।<verse eid="NUM 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 22:4"/>मोआबीमन मिदयानीमन के अगुवामन ला कहिन, “ये उपदरवी दल ह हमर चारों कोति के जम्मो चीज ला चट कर डारही, जइसे बईला ह खेत के घांस ला चट कर जाथे।”</para>
  <para style="p" vid="NUM 22:4">ओ समय सिप्पोर के बेटा बालाक ह मोआब के राजा रिहिस; <verse eid="NUM 22:4"/><verse number="5" style="v" sid="NUM 22:5"/>ओह बेओर के बेटा बिलाम ला बलाय बर संदेसियामन ला भेजिस, जऊन ह फरात नदी के लकठा म अपन जनम भुइयां पतोर सहर म रिहिस। बालाक ह कहिस:</para>
  <para style="pm" vid="NUM 22:5">“मिसर ले अब्बड़ मनखेमन आय हवंय; अऊ मोर बाजू म बस गे हवंय ओमन ले पूरा भुइयां ह ढंक गे हवय। <verse eid="NUM 22:5"/><verse number="6" style="v" sid="NUM 22:6"/>त तेंह आ अऊ ये मनखेमन ला सराप दे, काबरकि येमन मोर ले बहुंत सक्तिसाली हें। तब सायद में येमन ला हराय सकहूं अऊ देस ले बाहिर भगाय सकहूं। काबरकि मेंह जानत हंव कि जेला तें आसीस देथस, ओह आसीस पाथे, अऊ जेला तें सराप देथस, ओह सरापित हो जाथे।”<verse eid="NUM 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7"/>तब मोआब अऊ मिदयान के अगुवामन अगम बिचारे के दाम लेके चल दीन। जब ओमन बिलाम करा हबरिन, त ओला बालाक के कहे बात ला बताईन।<verse eid="NUM 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 22:8"/>बिलाम ह ओमन ला कहिस, “आज रथिया इहां रूक जावव, अऊ जऊन बात यहोवा ह मोला कहिही, ओकर मुताबिक मेंह तुमन ला जबाब दूहूं।” त मोआब के अधिकारीमन ओकर संग रूक गीन।<verse eid="NUM 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9"/>परमेसर ह बिलाम करा आईस अऊ पुछिस, “तोर संग ये मनखेमन कोन अंय?”<verse eid="NUM 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10"/>बिलाम ह परमेसर ला कहिस, “सिप्पोर के बेटा, मोआब के राजा बालाक ह मोला ये संदेस भेजे हवय: <verse eid="NUM 22:10"/><verse number="11" style="v" sid="NUM 22:11"/>‘मिसर देस ले निकलके आय मनखेमन के एक दल ले भुइयां ह ढंक गे हवय। अब तें आ अऊ मोर बर ओमन ला सराप दे। तब सायद में ओमन संग लड़ सकहूं अऊ ओमन ला भगाय सकहूं।’ ”<verse eid="NUM 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12"/>पर परमेसर ह बिलाम ला कहिस, “ओमन के संग झन जा। तें ओ मनखेमन ला सराप झन दे, काबरकि ओमन मोर आसीसित मनखे अंय।”<verse eid="NUM 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13"/>ओकर दूसर दिन बिहनियां बिलाम ह उठके बालाक के अधिकारीमन ला कहिस, “तुमन अपन देस वापिस जावव, काबरकि यहोवा ह मोला तुम्हर संग जाय बर मना करे हवय।”<verse eid="NUM 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14"/>तब मोआब के अधिकारीमन बालाक करा लहुंटके कहिन, “बिलाम ह हमर संग आय बर मना कर दीस।”<verse eid="NUM 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15"/>तब बालाक ह आने अधिकारीमन ला पठोईस, जऊन मन संखिया म पहिले से अधिक अऊ जादा आदर योग्य रिहिन। <verse eid="NUM 22:15"/><verse number="16" style="v" sid="NUM 22:16"/>ओमन बिलाम करा आईन अऊ कहिन:</para>
  <para style="pm" vid="NUM 22:16">“सिप्पोर के बेटा बालाक ह ये कहिथे: तोला मोर करा आय ले कोनो चीज झन रोकय, <verse eid="NUM 22:16"/><verse number="17" style="v" sid="NUM 22:17"/>काबरकि में तोला बहुंत बढ़िया ईनाम दूहूं अऊ जऊन कुछू तें कहिबे, ओला करहूं। आ मोर बर ये मनखेमन ला सराप दे।”<verse eid="NUM 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18"/>पर बिलाम ह ओमन ला जबाब दीस, “अऊ त अऊ यदि बालाक ह अपन महल के जम्मो सोन अऊ चांदी मोला देय दे, तभो ले मेंह यहोवा मोर परमेसर के हुकूम के बाहिर जाके छोटे या बड़े कुछू काम नइं कर सकंव। <verse eid="NUM 22:18"/><verse number="19" style="v" sid="NUM 22:19"/>पर तुमन आज रथिया इहां रूकव, ताकि मेंह पता लगा सकंव कि यहोवा ह मोला का कहत हे।”<verse eid="NUM 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20"/>रथिया परमेसर ह बिलाम करा आके कहिस, “जब ये मनखेमन तोला ले जाय बर आय हवंय, त ओमन के संग जा, पर सिरिप वइसने ही करबे, जइसने मेंह तोला कहिहूं।”<verse eid="NUM 22:20"/></para>
  <para style="s1">बिलाम के गदही</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21"/>बिलाम ह बिहनियां उठिस, अपन गदही म काठी बांधिस अऊ मोआब के अधिकारीमन संग चल दीस। <verse eid="NUM 22:21"/><verse number="22" style="v" sid="NUM 22:22"/>पर परमेसर ह बहुंत गुस्सा होईस, जब बिलाम ह ओमन के संग गीस, अऊ यहोवा के स्वरगदूत ह ओकर बिरोध करे बर सड़क म ठाढ़ हो गीस। बिलाम ह अपन गदही म चघके जावत रिहिस, अऊ दू झन सेवकमन ओकर संग रिहिन। <verse eid="NUM 22:22"/><verse number="23" style="v" sid="NUM 22:23"/>जब ओ गदही ह यहोवा के स्वरगदूत ला अपन हांथ म तलवार लिये देखिस, त ओह सड़क ला छोंड़के खेत कोति उतर गीस। तब बिलाम ह गदही ला फेर सड़क म लाने बर ओला मारिस।<verse eid="NUM 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 22:24"/>तब यहोवा के स्वरगदूत ह अंगूर के बारीमन के संकरा रसता म ठाढ़ हो गीस, जेकर दूनों कोति दीवार रहय। <verse eid="NUM 22:24"/><verse number="25" style="v" sid="NUM 22:25"/>जब गदही ह यहोवा के स्वरगदूत ला देखिस, त ओह दीवार ले संट गीस, जेकर ले बिलाम के गोड़ ह दीवार ले रगड़ा गीस। त ओह फेर गदही ला मारिस।<verse eid="NUM 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 22:26"/>तब यहोवा के स्वरगदूत ह आघू बढ़िस अऊ संकरा जगह म ठाढ़ हो गीस, जिहां न तो जेवनी अऊ न ही डेरी कोति हटे के जगह रिहिस। <verse eid="NUM 22:26"/><verse number="27" style="v" sid="NUM 22:27"/>जब गदही ह यहोवा के स्वरगदूत ला देखिस, त ओह बिलाम ला लेके बईठ गीस; तब बिलाम ह गुस्सा होईस अऊ गदही ला अपन लउठी ले मारे लगिस। <verse eid="NUM 22:27"/><verse number="28" style="v" sid="NUM 22:28"/>तब यहोवा ह गदही के मुहूं ला खोल दीस अऊ गदही ह बिलाम ला कहिस, “मेंह तोर का करे हंव कि तीन बार हो गीस, तेंह मोला मारत हस?”<verse eid="NUM 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29"/>त बिलाम ह गदही ला जबाब दीस, “तेंह मोला मुरूख बना दे हस! कहूं मोर हांथ म तलवार होतिस, त अभीच मेंह तोला मार डारतेंव।”<verse eid="NUM 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30"/>ओ गदही ह बिलाम ला कहिस, “का मेंह तोर खुद के गदही नो हंव, जेमा तेंह हमेसा आज तक सवारी करत आय हस? का मेंह तोर संग कभू अइसने करे रहंय?”</para>
  <para style="p" vid="NUM 22:30">ओह कहिस, “नइं।”<verse eid="NUM 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31"/>तब यहोवा ह बिलाम के आंखी ला खोल दीस, अऊ ओह यहोवा के स्वरगदूत ला तलवार लेके सड़क म खड़े देखिस। तब ओह झुकिस अऊ मुहूं के भार गिरके दंडवत करिस।<verse eid="NUM 22:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 22:32"/>यहोवा के स्वरगदूत ह ओकर ले पुछिस, “तेंह अपन गदही ला ये तीन बार ले काबर मारय? मेंह इहां तोर बिरोध करे बर आय हंव, काबरकि जऊन काम तेंह करत हस, ओह मोर आघू म सही नो हय। <verse eid="NUM 22:32"/><verse number="33" style="v" sid="NUM 22:33"/>गदही ह मोला देखिस अऊ तीन बार मोर ले दूरिहा घुंचिस। यदि ओह नइं घुंचे रहितिस, त खचित मेंह अब तक तो तोला मार डारे रहितेंव, पर गदही ला छोंड़ देतेंव।”<verse eid="NUM 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34"/>बिलाम ह यहोवा के स्वरगदूत ला कहिस, “मेंह पाप करे हंव। मोला पता नइं रिहिस कि तेंह मोर सामना करे बर सड़क म खड़े हस। यदि तेंह ये बात ले नाखुस हस, त मेंह वापिस चल दूहूं।”<verse eid="NUM 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35"/>यहोवा के स्वरगदूत ह बिलाम ला कहिस, “ओ मनखेमन संग जा, पर जऊन बात में बताहूं, ओही बात ला कहिबे।” तब बिलाम ह बालाक के अधिकारीमन संग चल दीस।<verse eid="NUM 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36"/>जब बालाक ह सुनिस कि बिलाम ह आवत हे, त ओह बिलाम ले मिले बर अरनोन के सीमना म मोआबी नगर करा गीस, जऊन ह ओकर इलाका के तीर म हवय। <verse eid="NUM 22:36"/><verse number="37" style="v" sid="NUM 22:37"/>बालाक ह बिलाम ला कहिस, “का मेंह तोला जरूरी बात बर नइं बलाय रहेंव? तेंह मोर करा काबर नइं आवत रहय? का मेंह तोला आदर देय के लईक नो हंव?”<verse eid="NUM 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38"/>बिलाम ह बालाक ला जबाब दीस, “देख, अब तो में तोर करा आ गे हंव, पर मेंह अपन मन से कुछू नइं कहंव। जेला परमेसर मोर मुहूं म डारही, सिरिप ओहीच बात कहिहूं।”<verse eid="NUM 22:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 22:39"/>तब बिलाम ह बालाक के संग किरयत-हुसोत नगर म गीस। <verse eid="NUM 22:39"/><verse number="40" style="v" sid="NUM 22:40"/>उहां बालाक ह पसु अऊ भेड़मन के बलि चघाईस, अऊ कुछू भाग बिलाम अऊ अधिकारीमन ला दीस, जेमन ओकर संग रिहिन। <verse eid="NUM 22:40"/><verse number="41" style="v" sid="NUM 22:41"/>ओकर दूसर दिन बिहनियां बालाक ह बिलाम ला ऊपर बामोत-बाल करा ले गीस, अऊ उहां ले ओह इसरायलीमन के डेरा के बाहिरी भाग ला देखिस।<verse eid="NUM 22:41"/></para>
  <chapter eid="NUM 22"/>
  <chapter number="23" style="c" sid="NUM 23"/>
  <para style="s1">बिलाम के पहिला संदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1"/>बिलाम ह बालाक ला कहिस, “इहां मोर बर सात ठन बेदी बनवा, अऊ सात-सात ठन बछवा अऊ मेढ़ा बलिदान करे बर तियार कर।” <verse eid="NUM 23:1"/><verse number="2" style="v" sid="NUM 23:2"/>बालाक ह बिलाम के कहे मुताबिक करिस, अऊ दूनों झन हर एक बेदी म एक-एक ठन बछवा अऊ मेढ़ा चघाईन।<verse eid="NUM 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 23:3"/>तब बिलाम ह बालाक ला कहिस, “तेंह इहां अपन बलि करा ठाढ़े रह; मेंह थोरकन दूरिहा जावत हंव। हो सकथे यहोवा ह मोर ले मिले बर आवय। जऊन कुछू ओह मोर ऊपर परगट करही, मेंह तोला बताहूं।” तब ओह एक उजाड़ पहाड़ी ऊपर गीस।<verse eid="NUM 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 23:4"/>परमेसर ह ओकर ले मिलिस, त बिलाम ह कहिस, “में सात ठन बेदी तियार करे हंव, अऊ हर बेदी म एक ठन बछवा अऊ एक ठन मेढ़ा चघाय हंव।”<verse eid="NUM 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5"/>यहोवा ह बिलाम के मुहूं म एक ठन बात डालिस अऊ कहिस, “तें बालाक करा वापिस जा अऊ ओला ये बात कह।”<verse eid="NUM 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 23:6"/>तब बिलाम ह बालाक करा वापिस गीस अऊ ओला जम्मो मोआब के अधिकारीमन के संग अपन चढ़ावा के बाजू म खड़े पाईस। <verse eid="NUM 23:6"/><verse number="7" style="v" sid="NUM 23:7"/>तब बिलाम ह अपन संदेस दीस:</para>
  <para style="q1" vid="NUM 23:7">“बालाक ह मोला अराम देस ले लानिस,</para>
  <para style="q2" vid="NUM 23:7">मोआब के राजा, पूरब के पहाड़ीमन ले।</para>
  <para style="q1" vid="NUM 23:7">ओह कहिस, ‘आ अऊ मोर बर याकूब ला सराप दे;</para>
  <para style="q2" vid="NUM 23:7">आ अऊ इसरायल के निन्दा कर।’<verse eid="NUM 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8"/>ओमन ला मेंह कइसे सराप दंव</para>
  <para style="q2" vid="NUM 23:8">जेमन ला परमेसर ह सराप नइं दीस?</para>
  <para style="q1" vid="NUM 23:8">ओमन के निन्दा कइसे करंव</para>
  <para style="q2" vid="NUM 23:8">जेमन के निन्दा यहोवा ह नइं करिस?<verse eid="NUM 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9"/>चट्टानमन के ऊपर ले मेंह ओमन ला देखत हंव,</para>
  <para style="q2" vid="NUM 23:9">ऊंचई ले ओमन मोला दिखत हें।</para>
  <para style="q1" vid="NUM 23:9">मेंह अइसे मनखेमन ला देखत हंव, जेमन अलग रहिथें</para>
  <para style="q2" vid="NUM 23:9">अऊ अपनआप ला आने जातमन सहीं नइं समझंय।<verse eid="NUM 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10"/>कोन ह याकूब के धुर्रा सहीं संतानमन ला</para>
  <para style="q2" vid="NUM 23:10">या इसरायल के एक चौथाई ला घलो गन सकथे?</para>
  <para style="q1" vid="NUM 23:10">बने होही कि मेंह एक धरमी के सहीं मरंव,</para>
  <para style="q2" vid="NUM 23:10">अऊ मोर अन्त ह ओमन सहीं होवय!”<verse eid="NUM 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11"/>बालाक ह बिलाम ला कहिस, “तेंह मोर संग का करय? मेंह तोला मोर बईरीमन ला सराप दे बर लानेंव, पर तेंह ओमन ला सिरिप आसीस देय के अलावा कुछू नइं करे हस!”<verse eid="NUM 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12"/>ओह जबाब दीस, “जऊन बात यहोवा ह मोला कहे हवय, का ओही ला नइं बतावंव?”<verse eid="NUM 23:12"/></para>
  <para style="s1">बिलाम के दूसरा संदेस</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13"/>तब बालाक ह ओला कहिस, “तेंह मोर संग आने जगह म आ, जिहां ले तें ओमन ला देख सकबे; तेंह जम्मो झन ला नइं, सिरिप ओमन के सिविर के बाहिर ला देख सकबे। अऊ उहां ले, तें मोर बर ओमन ला सराप दे।” <verse eid="NUM 23:13"/><verse number="14" style="v" sid="NUM 23:14"/>त ओह बिलाम ला पिसगा पहाड़ के ऊपर सोपीम के खेत म ले गीस, अऊ उहां ओह सात ठन बेदी बनवाईस अऊ हर बेदी म एक बछवा अऊ एक मेढ़ा चघाईस।<verse eid="NUM 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15"/>बिलाम ह बालाक ला कहिस, “तें इहां अपन चढ़ावा के बाजू म रूक अऊ मेंह जाके उहां यहोवा ले मिलत हंव।”<verse eid="NUM 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16"/>यहोवा ह बिलाम ले मिलिस अऊ ओकर मुहूं म अपन बात डालके कहिस, “बालाक करा वापिस जा अऊ ओला ये बात कह।”<verse eid="NUM 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17"/>तब बिलाम ह बालाक करा गीस अऊ ओला मोआब के अधिकारीमन के संग अपन चढ़ावा के बाजू म खड़े पाईस। बालाक ह ओकर ले पुछिस, “यहोवा ह का कहिस?”<verse eid="NUM 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18"/>तब बिलाम ह अपन संदेस दीस:</para>
  <para style="q1" vid="NUM 23:18">“हे बालाक, सिप्पोर के बेटा उठ अऊ सुन;</para>
  <para style="q2" vid="NUM 23:18">मोर बात ला सुन।<verse eid="NUM 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19"/>परमेसर ह मनखे नो हय, कि ओह लबारी मारय,</para>
  <para style="q2" vid="NUM 23:19">ओह मनखे नो हय, कि ओह अपन मन ला बदलय।</para>
  <para style="q1" vid="NUM 23:19">का ओह बोलथे अऊ वइसने नइं करय?</para>
  <para style="q2" vid="NUM 23:19">का ओह वायदा करथे अऊ ओला पूरा नइं करय?<verse eid="NUM 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20"/>मोला आसीस देय के हुकूम मिले हवय;</para>
  <para style="q2" vid="NUM 23:20">ओह आसीस दे हवय, अऊ येला मेंह नइं बदल सकंव।<verse eid="NUM 23:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21"/>“याकूब म कोनो अनर्थ,</para>
  <para style="q2" vid="NUM 23:21">अऊ इसरायल म कोनो दुरगति नइं दिखत हे।</para>
  <para style="q1" vid="NUM 23:21">यहोवा ओमन के परमेसर ह ओमन के संग हवय;</para>
  <para style="q2" vid="NUM 23:21">ओमन के बीच म राजा के जय-जयकार होथे।<verse eid="NUM 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22"/>परमेसर ह ओमन ला मिसर ले लेय आईस;</para>
  <para style="q2" vid="NUM 23:22">ओमन करा जंगली बईला के ताकत हवय।<verse eid="NUM 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23"/>याकूब के बिरूध म न कोनो अपसकुन हवय,</para>
  <para style="q2" vid="NUM 23:23">न इसरायल के बिरूध म कोनो खराप सकुन-बिचार।</para>
  <para style="q1" vid="NUM 23:23">अब याकूब अऊ इसरायल के बारे म कहे जाही,</para>
  <para style="q2" vid="NUM 23:23">‘देखव, परमेसर ह का अद्भूत काम करे हवय!’<verse eid="NUM 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24"/>ये मनखेमन सेरनी सहीं निकलथें;</para>
  <para style="q2" vid="NUM 23:24">ओमन एक सिंह सहीं ठाढ़ होथें</para>
  <para style="q1" vid="NUM 23:24">ओमन तब तक अराम नइं करंय, जब तक कि अपन सिकार ला खा नइं लेवंय</para>
  <para style="q2" vid="NUM 23:24">अऊ ओकर खून ला पी नइं लेवंय।”<verse eid="NUM 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25"/>तब बालाक ह बिलाम ला कहिस, “तें ओमन ला न तो कोनो सराप दे अऊ न ही कोनो आसीस!”<verse eid="NUM 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26"/>बिलाम ह बालाक ला जबाब दीस, “का मेंह तोला नइं कहे रहेंव कि यहोवा जइसने कहिही, वइसने करहूं?”<verse eid="NUM 23:26"/></para>
  <para style="s1">बिलाम के तीसरा संदेस</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27"/>तब बालाक ह बिलाम ला कहिस, “आ, तोला एक आने जगह म ले चलत हंव। सायद येह परमेसर ला बने लगय कि उहां ले ओह तोला मोर बर इसरायलीमन ला सराप देवन दे।” <verse eid="NUM 23:27"/><verse number="28" style="v" sid="NUM 23:28"/>अऊ बालाक ह बिलाम ला पेओर पहाड़ के चोटी ऊपर ले, उजाड़ जगह ला देखा दीस।<verse eid="NUM 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29"/>बिलाम ह बालाक ला कहिस, “इहां मोर बर सात ठन बेदी बनवा, अऊ सात ठन बछवा अऊ सात ठन मेढ़ा तियार कर।” <verse eid="NUM 23:29"/><verse number="30" style="v" sid="NUM 23:30"/>बिलाम के कहे मुताबिक बालाक ह करिस, अऊ हर बेदी म एक बछवा अऊ एक मेढ़ा चघाईस।<verse eid="NUM 23:30"/></para>
  <chapter eid="NUM 23"/>
  <chapter number="24" style="c" sid="NUM 24"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1"/>जब बिलाम ह देखिस कि इसरायल ला आसीस देवई ह यहोवा ला बने लगथे, त ओह पहिले के सहीं सकुन-बिचार करे म मन नइं लगाईस, पर अपन चेहरा ला सुन्ना जगह कोति करिस। <verse eid="NUM 24:1"/><verse number="2" style="v" sid="NUM 24:2"/>जब बिलाम ह देखिस कि इसरायल ह गोत्र-गोत्र के मुताबिक डेरा डाले हवय, त परमेसर के आतमा ओकर ऊपर आईस <verse eid="NUM 24:2"/><verse number="3" style="v" sid="NUM 24:3"/>अऊ बिलाम ह अपन संदेस दीस:</para>
  <para style="q1" vid="NUM 24:3">“बेओर के बेटा बिलाम के अगमबानी,</para>
  <para style="q2" vid="NUM 24:3">ओ मनखे के अगमबानी, जेकर आंखी ह साफ-साफ देखथे,<verse eid="NUM 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4"/>ओ मनखे के अगमबानी, जऊन ह परमेसर के बचन ला सुनथे,</para>
  <para style="q2" vid="NUM 24:4">जऊन ह सर्वसक्तिमान परमेसर ले एक दरसन पाथे,</para>
  <para style="q2" vid="NUM 24:4">जऊन ह सास्टांग दंडवत करथे, अऊ जेकर आंखीमन खुला हवंय:<verse eid="NUM 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5"/>“हे याकूब, का ही सुघर हवंय तोर तम्बूमन,</para>
  <para style="q2" vid="NUM 24:5">हे इसरायल, तोर निवासमन!<verse eid="NUM 24:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6"/>“ओमन घाटीमन सहीं फईले हवंय,</para>
  <para style="q2" vid="NUM 24:6">नदी के तीर म बगीचा सहीं,</para>
  <para style="q1" vid="NUM 24:6">यहोवा दुवारा लगाय मुसब्बर,</para>
  <para style="q2" vid="NUM 24:6">अऊ पानी तीर म लगे देवदार रूखमन सहीं हवंय।<verse eid="NUM 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7"/>ओमन के बाल्टीमन ले पानी ह बहते रहिही;</para>
  <para style="q2" vid="NUM 24:7">ओमन के बीजा ला बहुंत पानी मिलही।</para>
  <para style="b" vid="NUM 24:7"/>
  <para style="q1" vid="NUM 24:7">“ओमन के राजा ह अमालेकी राजा अगाग ले घलो महान होही;</para>
  <para style="q2" vid="NUM 24:7">ओमन के राज ह बढ़ते ही रहिही।<verse eid="NUM 24:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8"/>“परमेसर ह ओमन ला मिसर देस ले निकाल लानिस;</para>
  <para style="q2" vid="NUM 24:8">ओमन करा जंगली बईला के ताकत हवय।</para>
  <para style="q1" vid="NUM 24:8">जेमन बिरोधी देसमन ला नास करके</para>
  <para style="q2" vid="NUM 24:8">ओमन के हाड़ा ला कुटा-कुटा कर देथें;</para>
  <para style="q2" vid="NUM 24:8">अऊ अपन तीरमन ले बिरोधीमन ला छेद डारथें।<verse eid="NUM 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9"/>सिंह सहीं ओमन लेटके अराम करथें,</para>
  <para style="q2" vid="NUM 24:9">सिंहनी सहीं—ओमन ला छेड़े के हिम्मत कोन करय?</para>
  <para style="b" vid="NUM 24:9"/>
  <para style="q1" vid="NUM 24:9">“जऊन मन तोला आसीस देथें, ओमन आसीस पावंय</para>
  <para style="q2" vid="NUM 24:9">अऊ जऊन मन तोला सराप देथें, ओमन सरापित होवंय!”<verse eid="NUM 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10"/>तब बालाक के कोप बिलाम ऊपर भड़किस। ओह अपन दूनों हांथ ला ठोंकके बिलाम ला कहिस, “मेंह अपन बईरीमन ला सराप दे बर तोला बुलवाय हंव, पर तेंह तीन बार ओमन ला आसीस दे हस। <verse eid="NUM 24:10"/><verse number="11" style="v" sid="NUM 24:11"/>अब तें तुरते इहां ले भाग अऊ अपन घर जा! मेंह कहे रहेंव कि मेंह तोला बने ईनाम दूहू, पर यहोवा ह तोला ओ ईनाम ले दूरिहा रखे हवय।”<verse eid="NUM 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12"/>बिलाम ह बालाक ला कहिस, “का मेंह तोर संदेसियामन ला ये नइं कहे रहेंव, <verse eid="NUM 24:12"/><verse number="13" style="v" sid="NUM 24:13"/>‘यदि बालाक ह मोला अपन महल के जम्मो सोन अऊ चांदी ला घलो दे दीही, तभो ले मेंह अपन ईछा ले यहोवा के हुकूम के बाहिर बने या खराप कुछू नइं कर सकंव—अऊ सिरिप ओहीच बात कहिहूं, जऊन बात यहोवा ह कहिही?’ <verse eid="NUM 24:13"/><verse number="14" style="v" sid="NUM 24:14"/>अब सुन, मेंह अपन मनखेमन करा वापिस जावत हंव, पर मेंह तोला चेतात हंव कि अवइया समय म ये इसरायली मनखेमन तोर मनखेमन संग का करहीं।”<verse eid="NUM 24:14"/></para>
  <para style="s1">बिलाम के चौथा संदेस</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 24:15"/>तब ओह अपन संदेस दीस:</para>
  <para style="q1" vid="NUM 24:15">“बेओर के बेटा बिलाम के अगमबानी,</para>
  <para style="q2" vid="NUM 24:15">ओ मनखे के अगमबानी, जेकर आंखी ह साफ-साफ देखथे,<verse eid="NUM 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16"/>ओ मनखे के अगमबानी, जऊन ह परमेसर के बचन ला सुनथे,</para>
  <para style="q2" vid="NUM 24:16">जेला सर्वोच्च परमेसर ले गियान मिले हवय,</para>
  <para style="q1" vid="NUM 24:16">जऊन ह सर्वसक्तिमान परमेसर के दरसन देखथे,</para>
  <para style="q2" vid="NUM 24:16">जऊन ह सास्टांग दंडवत करथे, अऊ जेकर आंखीमन खुला हवंय:<verse eid="NUM 24:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17"/>“मेंह ओला देखथंव, पर अभी नइं;</para>
  <para style="q2" vid="NUM 24:17">मेंह ओला देखथंव, पर लकठा ले नइं।</para>
  <para style="q1" vid="NUM 24:17">याकूब ले एक तारा निकलके आही;</para>
  <para style="q2" vid="NUM 24:17">इसरायल ले एक राजदंड के उदय होही।</para>
  <para style="q1" vid="NUM 24:17">ओह मोआब के माथा ला कुचरही,</para>
  <para style="q2" vid="NUM 24:17">सेत के जम्मो मनखेमन<note caller="+" style="f"><char style="fr" closed="false">24:17 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">जम्मो </char><char style="fqa" closed="false">दंगा करइया घमंडी</char></note> के खोपड़ी ला कुचरही।<verse eid="NUM 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18"/>एदोम के ऊपर जय मिलही;</para>
  <para style="q2" vid="NUM 24:18">ओकर बईरी सेईर के ऊपर जीत मिलही,</para>
  <para style="q2" vid="NUM 24:18">पर इसरायल ह ताकतवर होवत जाही।<verse eid="NUM 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19"/>याकूब ले एक सासन करइया निकलही</para>
  <para style="q2" vid="NUM 24:19">अऊ सहर के बांचे मनखेमन ला नास कर दीही।”<verse eid="NUM 24:19"/></para>
  <para style="s1">बिलाम के पांचवां संदेस</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20"/>तब बिलाम ह अमालेक ला देखिस अऊ अपन संदेस दीस:</para>
  <para style="q1" vid="NUM 24:20">“अमालेक ह जातिमन म पहिले रिहिस,</para>
  <para style="q2" vid="NUM 24:20">पर ओमन के अन्त ह बहुंत बिनासकारी होही।”<verse eid="NUM 24:20"/></para>
  <para style="s1">बिलाम के छठवां संदेस</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21"/>तब बिलाम ह केनीमन ला देखिस अऊ अपन संदेस दीस:</para>
  <para style="q1" vid="NUM 24:21">“तुम्हर निवास स्थान ह सुरकछित हवय,</para>
  <para style="q2" vid="NUM 24:21">तुम्हर बसेरा ह चट्टान म हवय;<verse eid="NUM 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22"/>तभो ले केनी मनखेमन, तुमन नास हो जाहू</para>
  <para style="q2" vid="NUM 24:22">जब अस्सूर ह तुमन ला बंधुवई म ले जाही।”<verse eid="NUM 24:22"/></para>
  <para style="s1">बिलाम के सातवां संदेस</para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23"/>तब बिलाम ह अपन ये संदेस दीस:</para>
  <para style="q1" vid="NUM 24:23">“हाय! जब परमेसर ह अइसने करही, त कोन ह बचही?<verse eid="NUM 24:23"/></para>
  <para style="q2">
    <verse number="24" style="v" sid="NUM 24:24"/>कित्ती<note caller="+" style="f"><char style="fr" closed="false">24:24 </char><char style="fq" closed="false">कित्ती </char><char style="ft" closed="false">संभवतः </char><char style="fqa" closed="false">साइप्रस दीप</char></note> के समुंदर तीर ले पानी जहाजमन आहीं;</para>
  <para style="q1" vid="NUM 24:24">ओमन अस्सूर अऊ एबेर ला अपन अधीन कर लीहीं,</para>
  <para style="q2" vid="NUM 24:24">पर आखिर म ओमन घलो नास हो जाहीं।”<verse eid="NUM 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25"/>तब बिलाम ह उठिस अऊ अपन घर वापिस चल दीस, अऊ बालाक घलो अपन रसता म चल दीस।<verse eid="NUM 24:25"/></para>
  <chapter eid="NUM 24"/>
  <chapter number="25" style="c" sid="NUM 25"/>
  <para style="s1">मोआब ह इसरायल ला बहकाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1"/>जब इसरायल ह सित्तीम म रूके रिहिस, तब कुछू इसरायली मनखेमन मोआब के माईलोगनमन संग कुकरम करे लगिन। <verse eid="NUM 25:1"/><verse number="2" style="v" sid="NUM 25:2"/>अऊ ये माईलोगनमन अपन देवता ला बलिदान चघाय के बेरा म ओमन ला नेवता देय लगिन। ये मनखेमन ओ बलि चघाय जेवन खाके ये देवतामन ला दंडवत करे लगिन। <verse eid="NUM 25:2"/><verse number="3" style="v" sid="NUM 25:3"/>ये किसम ले इसरायलीमन बाल-पेओर देवता के संग जुड़ गीन। अऊ यहोवा के कोप ओमन के बिरूध भड़किस।<verse eid="NUM 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 25:4"/>यहोवा ह मूसा ला कहिस, “ये मनखेमन के जम्मो अगुवामन ला ले, अऊ ओमन ला मारके दिन-दुपहरी म यहोवा के आघू म खुला रख दे, ताकि यहोवा के भयंकर कोरोध ह इसरायल ले हट जावय।”<verse eid="NUM 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 25:5"/>तब मूसा ह इसरायल के नियायीमन ला कहिस, “तुमन ले हर एक जन अपन ओ मनखेमन ला मार डारव, जेमन अपनआप ला बाल-पेओर के अधीन कर दे हवंय।”<verse eid="NUM 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6"/>जब इसरायलीमन मिलापवाला तम्बू के प्रवेस दुवार म रोवत रिहिन, तब एक इसरायली मनखे ह मूसा अऊ जम्मो सभा के देखत म एक मिदयानी माईलोगन ला सिविर म ले आईस। <verse eid="NUM 25:6"/><verse number="7" style="v" sid="NUM 25:7"/>जब हारून पुरोहित के पोता, एलिआजर के बेटा पीनहास ह येला देखिस, त ओह सभा ले उठके गीस अऊ अपन हांथ म एक ठन बरछी लीस <verse eid="NUM 25:7"/><verse number="8" style="v" sid="NUM 25:8"/>अऊ ओ इसरायली मनखे के पाछू-पाछू तम्बू म गीस। ओह ओ इसरायली मनखे अऊ मिदयानी माईलोगन के पेट ला बरछी ले बेध दीस। तब इसरायलीमन के बिरूध फईले महामारी ह रूक गीस; <verse eid="NUM 25:8"/><verse number="9" style="v" sid="NUM 25:9"/>पर जेमन महामारी ले मरिन, ओमन 24,000 रिहिन।<verse eid="NUM 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10"/>यहोवा ह मूसा ला कहिस, <verse eid="NUM 25:10"/><verse number="11" style="v" sid="NUM 25:11"/>“हारून पुरोहित के पोता, एलिआजर के बेटा पीनहास ह इसरायलीमन के बिरूध मोर कोरोध ला सांत कर दे हवय। ओह ओमन के बीच मोर आदरमान बर अइसने जलन रखिस, जइसने मेंह रखथंव, एकर कारन मेंह अपन उत्साह म ओमन के अन्त नइं करेंव। <verse eid="NUM 25:11"/><verse number="12" style="v" sid="NUM 25:12"/>अब ओला बतावव कि मेंह ओकर संग अपन सांति के करार करत हंव। <verse eid="NUM 25:12"/><verse number="13" style="v" sid="NUM 25:13"/>ओह अऊ ओकर संतानमन बर हमेसा के पुरोहित के पद के एक करार होही, काबरकि ओला अपन परमेसर के आदरमान बर जलन होईस अऊ ओह इसरायलीमन बर पछताप करिस।”<verse eid="NUM 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14"/>जऊन इसरायली ह मिदयानी माईलोगन के संग मारे गीस, ओह सिमोनी गोत्र के एक अगुवा सालू के बेटा जिमरी रिहिस। <verse eid="NUM 25:14"/><verse number="15" style="v" sid="NUM 25:15"/>अऊ जऊन मिदयानी माईलोगन ह मारे गीस, ओकर नांव कोजबी रिहिस, जऊन ह एक मिदयानी परिवार के गोत्र के एक मुखिया सूर के बेटी रिहिस।<verse eid="NUM 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 25:16"/><verse number="17" style="v" sid="NUM 25:17"/>“मिदयानीमन के संग बईरी के सहीं बरताव करत ओमन ला मार डार। <verse eid="NUM 25:17"/><verse number="18" style="v" sid="NUM 25:18"/>काबरकि ओमन तुम्हर संग बईरी के सहीं बरताव करिन, जब ओमन अपन बहिनी, एक मिदयानी अगुवा के बेटी कोजबी ला सामिल करके पेओर के मामला म तुमन ला धोखा दीन, ओ माईलोगन ह मारे गीस, जब ओ घटना के कारन महामारी आईस।”<verse eid="NUM 25:18"/></para>
  <chapter eid="NUM 25"/>
  <chapter number="26" style="c" sid="NUM 26"/>
  <para style="s1">इसरायलीमन के दूसर बार गनती करई</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1"/>महामारी के बाद यहोवा ह मूसा अऊ हारून पुरोहित के बेटा एलिआजर ला कहिस, <verse eid="NUM 26:1"/><verse number="2" style="v" sid="NUM 26:2"/>“जम्मो इसरायली समाज के गनती परिवार के मुताबिक करव—जेमन बीस साल या जादा उमर के हवंय अऊ इसरायल के सेना म सेवा दे सकत हें।” <verse eid="NUM 26:2"/><verse number="3" style="v" sid="NUM 26:3"/>तब मूसा अऊ एलिआजर पुरोहित, यरीहो के ओ पार यरदन नदी के तीर, मोआब के मैदान म इसरायलीमन ले बात करिन अऊ कहिन, <verse eid="NUM 26:3"/><verse number="4" style="v" sid="NUM 26:4"/>“बीस साल या ओकर ले जादा उमर के मनखेमन के गनती करव, जइसने यहोवा ह मूसा ला हुकूम दे हवय।”</para>
  <para style="b" vid="NUM 26:4"/>
  <para style="lh" vid="NUM 26:4">येमन ओ इसरायली रिहिन, जेमन मिसर देस ले निकलके आय रिहिन:<verse eid="NUM 26:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 26:5"/>इसरायल के पहिलांत बेटा रूबेन के संतान:</para>
  <para style="li2" vid="NUM 26:5">हनोक के जरिये हनोकी गोत्र;</para>
  <para style="li2" vid="NUM 26:5">पल्लू के जरिये पल्लूयी गोत्र;<verse eid="NUM 26:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="NUM 26:6"/>हेसरोन के जरिये हेसरोनी गोत्र;</para>
  <para style="li2" vid="NUM 26:6">करमी के जरिये करमी गोत्र।<verse eid="NUM 26:6"/></para>
  <para style="lf">
    <verse number="7" style="v" sid="NUM 26:7"/>येमन रूबेनी गोत्र के रिहिन; जेमन के गनती, 43,730 रिहिस।<verse eid="NUM 26:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="NUM 26:8"/>पल्लू के बेटा एलीआब रिहिस, <verse eid="NUM 26:8"/><verse number="9" style="v" sid="NUM 26:9"/>अऊ एलीआब के बेटामन नमूएल, दातान अऊ अबीराम रिहिन। इही दातान अऊ अबीराम समाज के करमचारी रिहिन अऊ येमन मूसा अऊ हारून के बिरूध बिदरोह करिन अऊ येमन कोरह के ओ अनुयायीमन के संग रिहिन, जब ओमन यहोवा के बिरूध बिदरोह करिन। <verse eid="NUM 26:9"/><verse number="10" style="v" sid="NUM 26:10"/>धरती ह अपन मुहूं फारिस अऊ ओमन ला कोरह के संग लील लीस; ओकर पाछू चलइयामन मर गीन, जब आगी ह 250 मनखे ला भसम कर दीस। अऊ ओमन चेतउनी के एक चिनहां होईन। <verse eid="NUM 26:10"/><verse number="11" style="v" sid="NUM 26:11"/>तभो ले कोरह के बंस ह खतम नइं होईस।<verse eid="NUM 26:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 26:12"/>सिमोन के संतान ओमन के गोत्र के मुताबिक:</para>
  <para style="li2" vid="NUM 26:12">नमूएल के जरिये नमूएली गोत्र;</para>
  <para style="li2" vid="NUM 26:12">यामीन के जरिये यामीनी गोत्र;</para>
  <para style="li2" vid="NUM 26:12">याकीन के जरिये याकीनी गोत्र;<verse eid="NUM 26:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="NUM 26:13"/>जेरह के जरिये जेरही गोत्र;</para>
  <para style="li2" vid="NUM 26:13">साऊल के जरिये साऊली गोत्र।<verse eid="NUM 26:13"/></para>
  <para style="lf">
    <verse number="14" style="v" sid="NUM 26:14"/>येमन सिमोन गोत्र के रिहिन; जेमन के गनती, 22,200 रिहिस।<verse eid="NUM 26:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 26:15"/>गाद के संतान ओमन के गोत्र के मुताबिक:</para>
  <para style="li2" vid="NUM 26:15">सपोन के जरिये सपोनी गोत्र;</para>
  <para style="li2" vid="NUM 26:15">हाग्गी के जरिये हाग्गी गोत्र;</para>
  <para style="li2" vid="NUM 26:15">सूनी के जरिये सूनी गोत्र;<verse eid="NUM 26:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 26:16"/>ओजनी के जरिये ओजनी गोत्र;</para>
  <para style="li2" vid="NUM 26:16">एरी के जरिये एरी गोत्र;<verse eid="NUM 26:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 26:17"/>अरोद के जरिये अरोदी गोत्र;</para>
  <para style="li2" vid="NUM 26:17">अरेली के जरिये अरेली गोत्र।<verse eid="NUM 26:17"/></para>
  <para style="lf">
    <verse number="18" style="v" sid="NUM 26:18"/>येमन गाद गोत्र के रिहिन; जेमन के गनती 40,500 रिहिस।<verse eid="NUM 26:18"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="19" style="v" sid="NUM 26:19"/>यहूदा के बेटा एर अऊ ओनान रिहिन, पर ओमन कनान देस म मर गीन।<note caller="+" style="f"><char style="fr" closed="false">26:19 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="GEN 38:3-4">उत 38:3‑4</ref></char> अऊ <char style="xt"><ref loc="NUM 7:8">7:8</ref></char></char></note><verse eid="NUM 26:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 26:20"/>यहूदा के संतान ओमन के गोत्र के मुताबिक:</para>
  <para style="li2" vid="NUM 26:20">सेलह के जरिये सेलानी गोत्र;</para>
  <para style="li2" vid="NUM 26:20">पेरेस के जरिये पेरेसी गोत्र;</para>
  <para style="li2" vid="NUM 26:20">जेरह के जरिये जेरही गोत्र।<verse eid="NUM 26:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 26:21"/>पेरेस के संतान येमन रिहिन:</para>
  <para style="li3" vid="NUM 26:21">हेसरोन के जरिये हेसरोनी गोत्र;</para>
  <para style="li3" vid="NUM 26:21">हामूल के जरिये हामूली गोत्र।<verse eid="NUM 26:21"/></para>
  <para style="lf">
    <verse number="22" style="v" sid="NUM 26:22"/>येमन यहूदा गोत्र के रिहिन; जेमन के गनती 76,500 रिहिस।<verse eid="NUM 26:22"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 26:23"/>इस्साकार के संतान ओमन के गोत्र के मुताबिक:</para>
  <para style="li2" vid="NUM 26:23">तोला के जरिये तोलायी गोत्र;</para>
  <para style="li2" vid="NUM 26:23">पुआ के जरिये पुवी गोत्र;<verse eid="NUM 26:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="NUM 26:24"/>यासूब के जरिये यासूबी गोत्र;</para>
  <para style="li2" vid="NUM 26:24">सिमरोन के जरिये सिमरोनी गोत्र।<verse eid="NUM 26:24"/></para>
  <para style="lf">
    <verse number="25" style="v" sid="NUM 26:25"/>येमन इस्साकार गोत्र के रिहिन; जेमन के गनती 64,300 रिहिस।<verse eid="NUM 26:25"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 26:26"/>जबूलून के संतान ओमन के गोत्र के मुताबिक:</para>
  <para style="li2" vid="NUM 26:26">सेरेद के जरिये सेरेदी गोत्र;</para>
  <para style="li2" vid="NUM 26:26">एलोन के जरिये एलोनी गोत्र;</para>
  <para style="li2" vid="NUM 26:26">यहलेल के जरिये यहलेली गोत्र।<verse eid="NUM 26:26"/></para>
  <para style="lf">
    <verse number="27" style="v" sid="NUM 26:27"/>येमन जबूलूनी गोत्र के रिहिन; जेमन के गनती, 60,500 रिहिस।<verse eid="NUM 26:27"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="28" style="v" sid="NUM 26:28"/>यूसुफ के संतान, जेमन गोत्र के मुताबिक मनस्से अऊ एपरैम के जरिये होईन:<verse eid="NUM 26:28"/></para>
  <para style="lh">
    <verse number="29" style="v" sid="NUM 26:29"/>मनस्से के संतान:</para>
  <para style="li2" vid="NUM 26:29">माकीर के जरिये माकीरी गोत्र (माकीर ह गिलाद के ददा रिहिस);</para>
  <para style="li2" vid="NUM 26:29">गिलाद के जरिये गिलादी गोत्र।<verse eid="NUM 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="NUM 26:30"/>गिलाद के संतान येमन रिहिन:</para>
  <para style="li3" vid="NUM 26:30">ईएजेर के जरिये ईएजेरी गोत्र;</para>
  <para style="li3" vid="NUM 26:30">हेलेक के जरिये हेलेकी गोत्र;<verse eid="NUM 26:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="NUM 26:31"/>असरीएल के जरिये असरीएली गोत्र;</para>
  <para style="li3" vid="NUM 26:31">सकेम के जरिये सकेमी गोत्र;<verse eid="NUM 26:31"/></para>
  <para style="li3">
    <verse number="32" style="v" sid="NUM 26:32"/>समीदा के जरिये समीदायी गोत्र;</para>
  <para style="li3" vid="NUM 26:32">हेपेर के जरिये हेपेरी गोत्र।<verse eid="NUM 26:32"/></para>
  <para style="li3">
    <verse number="33" style="v" sid="NUM 26:33"/>(हेपेर के बेटा सलोफाद के कोनो बेटा नइं रिहिन; ओकर सिरिप बेटीमन रिहिन, जेमन के नांव महला, नोआ, होगला, मिलका अऊ तिरसा रिहिस।)<verse eid="NUM 26:33"/></para>
  <para style="lf">
    <verse number="34" style="v" sid="NUM 26:34"/>येमन मनस्से के गोत्र रिहिन; जेमन के गनती 52,700 रिहिस।<verse eid="NUM 26:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 26:35"/>एपरैम के संतान ओमन के गोत्र के मुताबिक येमन रिहिन:</para>
  <para style="li2" vid="NUM 26:35">सूतेलह के जरिये सूतेलही गोत्र;</para>
  <para style="li2" vid="NUM 26:35">बेकेर के जरिये बेकेरी गोत्र;</para>
  <para style="li2" vid="NUM 26:35">तहान के जरिये तहानी गोत्र।<verse eid="NUM 26:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="NUM 26:36"/>सूतेलह के संतान येमन रिहिन:</para>
  <para style="li3" vid="NUM 26:36">एरान के जरिये एरानी गोत्र।<verse eid="NUM 26:36"/></para>
  <para style="lf">
    <verse number="37" style="v" sid="NUM 26:37"/>येमन एपरैम के संतान रिहिन; जेमन के गनती, 32,500 रिहिस।</para>
  <para style="lf" vid="NUM 26:37">येमन गोत्र के मुताबिक यूसुफ के संतान रिहिन।<verse eid="NUM 26:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 26:38"/>बिनयामीन के संतान ओमन के गोत्र के मुताबिक:</para>
  <para style="li2" vid="NUM 26:38">बेला के जरिये बेलायी गोत्र;</para>
  <para style="li2" vid="NUM 26:38">असबेल के जरिये असबेली गोत्र;</para>
  <para style="li2" vid="NUM 26:38">अहीराम के जरिये अहीरामी गोत्र;<verse eid="NUM 26:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 26:39"/>सूपाम<note caller="+" style="f"><char style="fr" closed="false">26:39 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सपूपाम</char></note> के जरिये सूपामी गोत्र;</para>
  <para style="li2" vid="NUM 26:39">हूपाम के जरिये हूपामी गोत्र।<verse eid="NUM 26:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 26:40"/>बेला के संतान अर्द अऊ नामान के जरिये:</para>
  <para style="li3" vid="NUM 26:40">अर्द के जरिये अर्दी गोत्र;</para>
  <para style="li3" vid="NUM 26:40">नामान के जरिये नामानी गोत्र।<verse eid="NUM 26:40"/></para>
  <para style="lf">
    <verse number="41" style="v" sid="NUM 26:41"/>येमन बिनयामीन के गोत्र रिहिन; जेमन के संखिया 45,600 रिहिस।<verse eid="NUM 26:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 26:42"/>दान के संतान ओमन के गोत्र के मुताबिक येमन रिहिन:</para>
  <para style="li2" vid="NUM 26:42">सूहाम के जरिये सूहामी गोत्र।</para>
  <para style="lf" vid="NUM 26:42">येमन दान के गोत्र रिहिन: <verse eid="NUM 26:42"/><verse number="43" style="v" sid="NUM 26:43"/>येमा के जम्मो झन सूहामी गोत्र के रिहिन; जेमन के संखिया 64,400 रिहिस।<verse eid="NUM 26:43"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="44" style="v" sid="NUM 26:44"/>आसेर के संतान ओमन के गोत्र के मुताबिक:</para>
  <para style="li2" vid="NUM 26:44">यिमना के जरिये यिमनी गोत्र;</para>
  <para style="li2" vid="NUM 26:44">इसवी के जरिये इसवी गोत्र;</para>
  <para style="li2" vid="NUM 26:44">बरीया के जरिये बरीयी गोत्र;<verse eid="NUM 26:44"/></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 26:45"/>अऊ बरीया के संतान के जरिये:</para>
  <para style="li3" vid="NUM 26:45">हेबेर के जरिये हेबेरी गोत्र;</para>
  <para style="li3" vid="NUM 26:45">मलकीएल के जरिये मलकीएली गोत्र।<verse eid="NUM 26:45"/></para>
  <para style="lf">
    <verse number="46" style="v" sid="NUM 26:46"/>आसेर के सेरह नांव के एक बेटी रिहिस।<verse eid="NUM 26:46"/></para>
  <para style="lf">
    <verse number="47" style="v" sid="NUM 26:47"/>येमन आसेर के गोत्र रिहिन; जेमन के गनती 53,400 रिहिस।<verse eid="NUM 26:47"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="48" style="v" sid="NUM 26:48"/>नपताली के संतान ओमन के गोत्र के मुताबिक:</para>
  <para style="li2" vid="NUM 26:48">यहसेल के जरिये यहसेली गोत्र;</para>
  <para style="li2" vid="NUM 26:48">गूनी के जरिये गूनी गोत्र;<verse eid="NUM 26:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="NUM 26:49"/>येसेर के जरिये येसेरी गोत्र;</para>
  <para style="li2" vid="NUM 26:49">सिल्लेम के जरिये सिल्लेमी गोत्र।<verse eid="NUM 26:49"/></para>
  <para style="lf">
    <verse number="50" style="v" sid="NUM 26:50"/>येमन नपताली गोत्र के रिहिन; जेमन के गनती 45,400 रिहिस।<verse eid="NUM 26:50"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="51" style="v" sid="NUM 26:51"/>इसरायल के पुरूसमन के कुल संखिया 6,01,730 रिहिस।<verse eid="NUM 26:51"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52"/>यहोवा ह मूसा ला कहिस, <verse eid="NUM 26:52"/><verse number="53" style="v" sid="NUM 26:53"/>“नांव के गनती के आधार म ओमन के बीच म भुइयां ला ओमन के उत्तराधिकार के रूप म बांटना हे। <verse eid="NUM 26:53"/><verse number="54" style="v" sid="NUM 26:54"/>बड़े दल ला बड़े भाग दे, अऊ छोटे दल ला छोटे भाग; सूची म ओमन के गनती के मुताबिक हर एक ला ओकर उत्तराधिकार मिलय। <verse eid="NUM 26:54"/><verse number="55" style="v" sid="NUM 26:55"/>येकर धियान रखबे कि भुइयां ला चिट्ठी के जरिये बांटे जावय। हर एक दल ला जऊन भाग मिलथे, ओह ओकर पुरखा के गोत्र के नांव के मुताबिक होवय। <verse eid="NUM 26:55"/><verse number="56" style="v" sid="NUM 26:56"/>हर उत्तराधिकार ला चिट्ठी के दुवारा बड़े अऊ छोटे दलमन के बीच बांटे जावय।”<verse eid="NUM 26:56"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="57" style="v" sid="NUM 26:57"/>ये लेवीमन रिहिन, जेमन के गनती ओमन के गोत्र के मुताबिक होईस:</para>
  <para style="li2" vid="NUM 26:57">गेरसोन के जरिये गेरसोनी गोत्र;</para>
  <para style="li2" vid="NUM 26:57">कहात के जरिये कहाती गोत्र;</para>
  <para style="li2" vid="NUM 26:57">मरारी के जरिये मरारी गोत्र।<verse eid="NUM 26:57"/></para>
  <para style="li1">
    <verse number="58" style="v" sid="NUM 26:58"/>लेवी गोत्र के येमन घलो रिहिन:</para>
  <para style="li2" vid="NUM 26:58">लिबनी गोत्र,</para>
  <para style="li2" vid="NUM 26:58">हेबरोनी गोत्र,</para>
  <para style="li2" vid="NUM 26:58">महली गोत्र,</para>
  <para style="li2" vid="NUM 26:58">मूसी गोत्र,</para>
  <para style="li2" vid="NUM 26:58">कोरही गोत्र।</para>
  <para style="li2" vid="NUM 26:58">(कहात ह अमराम के पुरखा रिहिस; <verse eid="NUM 26:58"/><verse number="59" style="v" sid="NUM 26:59"/>अमराम के घरवाली के नांव योकेबेद रिहिस, जऊन ह लेवी के एक संतान रिहिस, अऊ मिसर म लेवी बंस म जनमे रिहिस। अमराम कोति ले ओह हारून, मूसा अऊ ओमन के बहिनी मिरियम ला जनम दीस। <verse eid="NUM 26:59"/><verse number="60" style="v" sid="NUM 26:60"/>हारून ह नादाब, अबीहू, एलिआजर अऊ ईतामार के ददा रिहिस। <verse eid="NUM 26:60"/><verse number="61" style="v" sid="NUM 26:61"/>पर नादाब अऊ अबीहू मर गीन, जब ओमन यहोवा के आघू म बिगर अधिकार वाले आगी ले एक बलिदान चघाईन।)<note caller="+" style="f"><char style="fr" closed="false">26:61 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="LEV 10:1-7">लैव्य 10:1‑7</ref></char></char></note><verse eid="NUM 26:61"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="62" style="v" sid="NUM 26:62"/>जम्मो लेवी पुरूस, जेमन एक महिना अऊ जादा उमर के रिहिन, गनती म 23,000 रिहिन। येमन ला आने इसरायलीमन संग नइं गने गीस, काबरकि येमन ला ओमन के बीच उत्तराधिकार नइं मिले रिहिस।<verse eid="NUM 26:62"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63"/>मूसा अऊ एलिआजर पुरोहित के दुवारा येमन ला गने गीस, जब ओमन यरीहो के ओ पार यरदन नदी के तीर मोआब के मैदान म इसरायलीमन के गनती करिन। <verse eid="NUM 26:63"/><verse number="64" style="v" sid="NUM 26:64"/>जऊन इसरायलीमन ला मूसा अऊ हारून पुरोहित, सीनय के सुन्ना जगह म गने रिहिन, ओमा के एको झन घलो अभी गने गय मनखेमन के बीच नइं रिहिन। <verse eid="NUM 26:64"/><verse number="65" style="v" sid="NUM 26:65"/>काबरकि यहोवा ह ओ इसरायलीमन ला कहे रिहिस कि ओमन खचित सुन्ना जगह म मर जाहीं, अऊ सिरिप यपुन्ने के बेटा कालेब अऊ नून के बेटा यहोसू ला छोंड़ ओमा के एको झन घलो नइं बांचिन।<note caller="+" style="f"><char style="fr" closed="false">26:65 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="NUM 14:29-35">गन 14:29‑35</ref></char></char></note><verse eid="NUM 26:65"/></para>
  <chapter eid="NUM 26"/>
  <chapter number="27" style="c" sid="NUM 27"/>
  <para style="s1">सलोफाद के बेटीमन</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1"/>मनस्से के बेटा माकीर, माकीर के बेटा गिलाद, गिलाद के बेटा हेपेर, हेपेर के बेटा सलोफाद, सलोफाद ले ओकर बेटीमन रिहिन; येमन यूसुफ के बेटा मनस्से के गोत्र के रिहिन। सलोफाद के बेटीमन के नांव महला, नोआ, होगला, मिलका अऊ तिरसा रिहिस। एक दिन ओमन आईन <verse eid="NUM 27:1"/><verse number="2" style="v" sid="NUM 27:2"/>अऊ मिलापवाला तम्बू के प्रवेस दुवार करा मूसा, एलिआजर पुरोहित, अगुवामन अऊ जम्मो सभा के आघू म ठाढ़ होके कहिन, <verse eid="NUM 27:2"/><verse number="3" style="v" sid="NUM 27:3"/>“हमर ददा ह सुन्ना जगह म मर गीस। ओह कोरह के मनखेमन के संग नइं रिहिस, जेमन मिलके यहोवा के बिरोध करिन, पर हमर ददा ह अपन खुद के पाप के कारन मर गीस अऊ ओकर कोनो बेटा नइं ए। <verse eid="NUM 27:3"/><verse number="4" style="v" sid="NUM 27:4"/>ओकर कोनो बेटा नइं होय के कारन ओकर नांव ह गोत्र ले काबर खतम हो जावय? एकरसेति हमर ददा के रिस्तेदारमन के बीच म हमन ला घलो संपत्ति देवव।”<verse eid="NUM 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5"/>तब मूसा ह ओमन के ये बात ला यहोवा ला कहिस, <verse eid="NUM 27:5"/><verse number="6" style="v" sid="NUM 27:6"/>अऊ यहोवा ह मूसा ला कहिस, <verse eid="NUM 27:6"/><verse number="7" style="v" sid="NUM 27:7"/>“सलोफाद के बेटीमन जऊन बात कहत हें, ओह सही अय। जरूरी ए कि तें ओमन ला ओमन के ददा के रिस्तेदारमन के बीच उत्तराधिकार के रूप म संपत्ति दे अऊ ओमन के ददा के उत्तराधिकार ओमन ला दे।<verse eid="NUM 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 27:8"/>“इसरायलीमन ला कह, ‘यदि कोनो मनखे बिगर बेटा के मर जाथे, त ओकर उत्तराधिकार ओकर बेटी ला दिये जावय। <verse eid="NUM 27:8"/><verse number="9" style="v" sid="NUM 27:9"/>यदि ओकर कोनो बेटी नइं ए, त ओकर भाईमन ला उत्तराधिकार दिये जावय। <verse eid="NUM 27:9"/><verse number="10" style="v" sid="NUM 27:10"/>यदि ओकर कोनो भाई नइं ए, त ओकर उत्तराधिकार ओकर ददा के भाईमन ला दिये जावय। <verse eid="NUM 27:10"/><verse number="11" style="v" sid="NUM 27:11"/>यदि ओकर ददा के भाई नइं ए, त उत्तराधिकार ओकर गोत्र के सबले नजदीकी रिस्तेदार ला मिलय, संपत्ति ला ओह ले लेवय। ये कानून ला इसरायलीमन के बीच म कड़ई से माने जावय, जइसने कि यहोवा ह मूसा ला हुकूम दे हवय।’ ”<verse eid="NUM 27:11"/></para>
  <para style="s1">यहोसू ह मूसा के जगह लेथे</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12"/>तब यहोवा ह मूसा ला कहिस, “ये पहाड़<note caller="+" style="f"><char style="fr" closed="false">27:12 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">नबो पहाड़</char><char style="ft" closed="false">; देखव <char style="xt"><ref loc="DEU 32:49">ब्यव 32:49</ref></char></char></note> के अबारीम छेत्र म ऊपर जा अऊ ओ देस ला देख, जेला मेंह इसरायलीमन ला दे हंव। <verse eid="NUM 27:12"/><verse number="13" style="v" sid="NUM 27:13"/>येला देखे के बाद, तेंह घलो अपन भाई हारून सहीं अपन मनखेमन के संग हमेसा बर सुत जाबे, <verse eid="NUM 27:13"/><verse number="14" style="v" sid="NUM 27:14"/>काबरकि जब समाज ह सीन के सुन्ना जगह म पानी के सोता करा बिदरोह करिस, त तुमन दूनों मोर हुकूम ला नइं मानके ओमन के नजर म मोर पबितरता के अनादर करेव।” (येमन सीन के सुन्ना जगह म मरीबा-कादेस के पानी के सोतामन रिहिन।)<verse eid="NUM 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15"/>मूसा ह यहोवा ले बिनती करिस, <verse eid="NUM 27:15"/><verse number="16" style="v" sid="NUM 27:16"/>“यहोवा, परमेसर जऊन ह जम्मो जीयत चीजमन ला सांस देथे, ओह ये समाज के ऊपर कोनो ला ठहिरावय <verse eid="NUM 27:16"/><verse number="17" style="v" sid="NUM 27:17"/>जऊन ह ओमन के आघू म आवय-जावय, जऊन ह ओमन के अवई अऊ जवई म अगुवई करय, ताकि यहोवा के समाज बिगर चरवाहा के भेड़मन सहीं झन होवय।”<verse eid="NUM 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18"/>तब यहोवा ह मूसा ला कहिस, “नून के बेटा यहोसू ला ले अऊ ओकर ऊपर अपन हांथ रख; ओह एक अइसे मनखे अय, जेमा अगुवई करे के आतमा हवय। <verse eid="NUM 27:18"/><verse number="19" style="v" sid="NUM 27:19"/>ओला एलिआजर पुरोहित अऊ जम्मो सभा के आघू म ठाढ़ कर अऊ ओमन के आघू म ओला अधिकार दे। <verse eid="NUM 27:19"/><verse number="20" style="v" sid="NUM 27:20"/>ओला तोर कुछू अधिकार दे ताकि पूरा इसरायली समाज ओकर बात मानय। <verse eid="NUM 27:20"/><verse number="21" style="v" sid="NUM 27:21"/>ओह एलिआजर पुरोहित के आघू म ठाढ़ होवय, जऊन ह यहोवा के आघू म ऊरीम के पुछताछ के दुवारा ओकर बर परमेसर के ईछा मालूम करय। ओकर हुकूम ले ओह अऊ पूरा इसरायली समाज जावंय अऊ ओकर हुकूम ले ओमन आवंय।”<verse eid="NUM 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22"/>मूसा ह वइसने ही करिस, जइसने यहोवा ह ओला हुकूम दे रिहिस। ओह यहोसू ला लीस अऊ ओला एलिआजर पुरोहित अऊ जम्मो सभा के आघू म ठाढ़ करिस। <verse eid="NUM 27:22"/><verse number="23" style="v" sid="NUM 27:23"/>तब मूसा ह यहोसू के ऊपर अपन हांथ रखके ओला अधिकार दीस, जइसे यहोवा ह मूसा ला हुकूम दे रिहिस।<verse eid="NUM 27:23"/></para>
  <chapter eid="NUM 27"/>
  <chapter number="28" style="c" sid="NUM 28"/>
  <para style="s1">हर दिन के बलिदान</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 28:1"/><verse number="2" style="v" sid="NUM 28:2"/>“इसरायलीमन ला ये हुकूम देके कह: ‘धियान रहय कि ठहिराय गे समय म मोला महकत सुख-देवइया जेवन-बलिदान चघावव।’ <verse eid="NUM 28:2"/><verse number="3" style="v" sid="NUM 28:3"/>ओमन ला कह: ‘तुमन यहोवा ला ये जेवन-बलिदान चघावव: हर दिन होम-बलिदान के रूप म एक-एक बछर के दू ठन निरदोस मेढ़ा-पीला चघाय जावय। <verse eid="NUM 28:3"/><verse number="4" style="v" sid="NUM 28:4"/>एक ठन मेढ़ा-पीला ला बिहनियां अऊ एक ठन ला सांझ के चघावव, <verse eid="NUM 28:4"/><verse number="5" style="v" sid="NUM 28:5"/>संग म एक एपा उत्तम पीसान के दसवां भाग<note caller="+" style="f"><char style="fr" closed="false">28:5 </char><char style="ft" closed="false">लगभग 1.6 किलोग्राम</char></note> ला चढ़ावा चघावव, जेमा पेरके निकाले गय एक हीन जैतून तेल के चौथा भाग<note caller="+" style="f"><char style="fr" closed="false">28:5 </char><char style="ft" closed="false">लगभग 1 लीटर</char></note> मिले रहय। <verse eid="NUM 28:5"/><verse number="6" style="v" sid="NUM 28:6"/>येह यहोवा ला चघाय जानेवाला महकत सुख-देवइया एक जेवन-बलिदान सीनय पहाड़ म ठहिराय गे नियमित होम-बलिदान ए। <verse eid="NUM 28:6"/><verse number="7" style="v" sid="NUM 28:7"/>संग म हर मेढ़ा-पीला के संग एक हीन के एक चौथाई<note caller="+" style="f" category="dup"><char style="fr" closed="false">28:7 </char><char style="ft" closed="false">लगभग 1 लीटर</char></note> मंद के पेय-बलिदान रहय। पेय-बलिदान ला पबितर-स्थान म यहोवा बर ढार दव। <verse eid="NUM 28:7"/><verse number="8" style="v" sid="NUM 28:8"/>दूसर मेढ़ा-पीला ला सांझ के बेरा चघावव; संग म ओहीच किसम के अन्न-बलिदान अऊ पेय-बलिदान के चढ़ावा घलो चघाय जावय, जइसे कि तुमन बिहनियां के बेरा चघाथव। येह यहोवा ला एक महकत सुख-देवइया जेवन-बलिदान अय।<verse eid="NUM 28:8"/></para>
  <para style="s1">बिसराम दिन के बलिदान</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9"/>“ ‘बिसराम दिन म, एक-एक साल के दू ठन निरदोस मेढ़ा-पीला के चढ़ावा चघावव; संग म येकर पेय-बलिदान अऊ एक एपा के दू-दसवां भाग<note caller="+" style="f"><char style="fr" closed="false">28:9 </char><char style="ft" closed="false">लगभग 3.2 किलोग्राम; <char style="xt" link-href="NUM 28:12"><ref loc="NUM 28:12">पद 12</ref></char>, <char style="xt" link-href="NUM 28:20"><ref loc="NUM 28:20">20</ref></char> अऊ <char style="xt" link-href="NUM 28:28"><ref loc="NUM 28:28">28</ref></char> म घलो</char></note> जैतून तेल म सने उत्तम पीसान के एक अन्न-बलिदान चघावव। <verse eid="NUM 28:9"/><verse number="10" style="v" sid="NUM 28:10"/>नियमित रूप से चघाय जानेवाला होम-बलिदान अऊ येकर पेय-बलिदान के अलावा येह हर बिसराम दिन बर होम-बलिदान अय।<verse eid="NUM 28:10"/></para>
  <para style="s1">मासिक-बलिदान</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11"/>“ ‘हर महिना के सुरू म, दू ठन बछवा, एक ठन मेढ़ा अऊ एक-एक साल के सात ठन निरदोस मेढ़ा-पीला यहोवा ला एक होम-बलिदान के रूप म चघाय करव। <verse eid="NUM 28:11"/><verse number="12" style="v" sid="NUM 28:12"/>हर बछवा के संग तेल ले सने उत्तम पीसान के एक एपा के तीन-दसवां भाग<note caller="+" style="f"><char style="fr" closed="false">28:12 </char><char style="ft" closed="false">लगभग 5 किलोग्राम</char></note> अन्न-बलिदान के रूप म चघावव; मेढ़ा-पीला के संग तेल ले सने उत्तम पीसान के एक एपा के दू-दसवां भाग अन्न-बलिदान के रूप म चघावव; <verse eid="NUM 28:12"/><verse number="13" style="v" sid="NUM 28:13"/>अऊ हर एक मेढ़ा-पीला के संग तेल ले सने उत्तम पीसान के एक एपा के दसवां भाग<note caller="+" style="f"><char style="fr" closed="false">28:13 </char><char style="ft" closed="false">लगभग 1 किलोग्राम</char></note> अन्न-बलिदान के रूप म चघावव। येह यहोवा बर चघाय जानेवाला एक होम-बलिदान, एक महकत सुख-देवइया जेवन-बलिदान अय। <verse eid="NUM 28:13"/><verse number="14" style="v" sid="NUM 28:14"/>हर एक बछवा के संग आधा हीन<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">लगभग 1.9 लीटर</char></note> अंगूर के मंद; मेढ़ा के संग एक हीन<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">लगभग 1.3 लीटर</char></note> के तीसरा भाग; अऊ हर एक मेढ़ा-पीला संग एक हीन के चौथा भाग पेय-बलिदान के रूप म चघाय जावय। येह साल भर हर नवां चंदा के दिन चघाय जानेवाला मासिक होम-बलिदान अय। <verse eid="NUM 28:14"/><verse number="15" style="v" sid="NUM 28:15"/>नियमित होम-बलिदान के संग येकर पेय-बलिदान के अलावा एक ठन बोकरा पाप-बलिदान<note caller="+" style="f"><char style="fr" closed="false">28:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुधिकरन-बलिदान</char><char style="ft" closed="false">; <char style="xt" link-href="NUM 28:22"><ref loc="NUM 28:22">पद 22</ref></char> म घलो</char></note> के रूप म यहोवा ला चघाय जावय।<verse eid="NUM 28:15"/></para>
  <para style="s1">फसह तिहार</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16"/>“ ‘हर साल पहिला महिना के चौदहवां दिन यहोवा के फसह माने जावय। <verse eid="NUM 28:16"/><verse number="17" style="v" sid="NUM 28:17"/>ये महिना के पंदरहवां दिन एक तिहार होवय; काबरकि सात दिन बिगर खमीर के बने रोटी खावव। <verse eid="NUM 28:17"/><verse number="18" style="v" sid="NUM 28:18"/>पहिली दिन एक पबितर सभा करव अऊ ओ दिन तुमन रोजमर्रा के काम झन करव। <verse eid="NUM 28:18"/><verse number="19" style="v" sid="NUM 28:19"/>यहोवा ला एक जेवन-बलिदान चघावव, जेह दू ठन बछवा, एक ठन मेढ़ा-पीला अऊ एक-एक साल के सात ठन निरदोस मेढ़ा-पीला के होम-बलिदान ले बने होवय। <verse eid="NUM 28:19"/><verse number="20" style="v" sid="NUM 28:20"/>हर एक बछवा के चढ़ावा के संग तेल ले सने उत्तम पीसान के एक एपा के तीन-दसवां भाग; मेढ़ा के संग दू-दसवां भाग एक अन्न-बलिदान के रूप म चघावव; <verse eid="NUM 28:20"/><verse number="21" style="v" sid="NUM 28:21"/>अऊ सात मेढ़ा-पीला के हर एक के संग एक-दसवां भाग। <verse eid="NUM 28:21"/><verse number="22" style="v" sid="NUM 28:22"/>अपन पछताप करे बर एक ठन बोकरा पाप-बलिदान के रूप म मिलावव। <verse eid="NUM 28:22"/><verse number="23" style="v" sid="NUM 28:23"/>हर बिहनियां के होम-बलिदान के अलावा येमन ला चघावव। <verse eid="NUM 28:23"/><verse number="24" style="v" sid="NUM 28:24"/>ये किसम ले हर एक दिन सात दिन तक यहोवा ला एक महकत सुख-देवइया जेवन-बलिदान चघावव; नियमित होम-बलिदान अऊ येकर पेय-बलिदान के अलावा ये बलिदान चघाय जावव। <verse eid="NUM 28:24"/><verse number="25" style="v" sid="NUM 28:25"/>सातवां दिन एक पबितर सभा करव अऊ ओ दिन रोजमर्रा के काम झन करव।<verse eid="NUM 28:25"/></para>
  <para style="s1">हप्तामन के तिहार</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26"/>“ ‘पहिली-फसल के दिन, जब तुमन हप्तामन के तिहार के समय नवां अनाज के बलिदान यहोवा ला चघावव, त एक पबितर सभा करव अऊ कोनो रोजमर्रा के काम झन करव। <verse eid="NUM 28:26"/><verse number="27" style="v" sid="NUM 28:27"/>दू ठन बछवा, एक ठन मेढ़ा अऊ एक-एक बछर के सात ठन निरदोस मेढ़ा-पीला के एक होम-बलिदान यहोवा बर महकत सुख-देवइया चढ़ावा के रूप म चघावव। <verse eid="NUM 28:27"/><verse number="28" style="v" sid="NUM 28:28"/>हर एक बछवा के चढ़ावा संग तेल ले सने उत्तम पीसान के एक एपा के तीन-दसवां भाग; मेढ़ा के संग दू-दसवां भाग; <verse eid="NUM 28:28"/><verse number="29" style="v" sid="NUM 28:29"/>अऊ हर सात मेढ़ा-पीला के संग एक-दसवां भाग। <verse eid="NUM 28:29"/><verse number="30" style="v" sid="NUM 28:30"/>अपन पछताप करे बर एक ठन बोकरा मिलावव। <verse eid="NUM 28:30"/><verse number="31" style="v" sid="NUM 28:31"/>नियमित होम-बलिदान अऊ येकर अन्न-बलिदान के अलावा येमन ला एक संग ओमन के पेय-बलिदान के संग चघावव। ये बात के धियान रहय कि पसुमन निरदोस होवंय।<verse eid="NUM 28:31"/></para>
  <chapter eid="NUM 28"/>
  <chapter number="29" style="c" sid="NUM 29"/>
  <para style="s1">तुरही के तिहार</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1"/>“ ‘हर साल सातवां महिना के पहिला दिन एक पबितर सभा करव अऊ ओ दिन नियमित काम झन करव। येह तुम्हर बर तुरही बजाय के दिन अय। <verse eid="NUM 29:1"/><verse number="2" style="v" sid="NUM 29:2"/>यहोवा ला एक महकत सुख-देवइया चढ़ावा के रूप म एक ठन बछवा, एक ठन मेढ़ा अऊ एक-एक साल के सात ठन निरदोस मेढ़ा-पीला के होम-बलिदान चघावव। <verse eid="NUM 29:2"/><verse number="3" style="v" sid="NUM 29:3"/>बछवा के चढ़ावा के संग जैतून तेल ले सने उत्तम पीसान के एक एपा के तीन-दसवां भाग<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="ft" closed="false">लगभग 5 किलोग्राम</char></note>; मेढ़ा के संग दू-दसवां भाग<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="ft" closed="false">लगभग 3.2 किलोग्राम</char></note>; <verse eid="NUM 29:3"/><verse number="4" style="v" sid="NUM 29:4"/>अऊ हर सातों मेढ़ा-पीला संग एक-दसवां भाग चघावव।<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">लगभग 1.6 किलोग्राम</char></note> <verse eid="NUM 29:4"/><verse number="5" style="v" sid="NUM 29:5"/>अपन पछताप करे बर ओमा पाप-बलिदान<note caller="+" style="f"><char style="fr" closed="false">29:5 </char><char style="ft" closed="false">सुध होय के बलिदान</char></note> बर एक ठन बोकरा घलो मिला लेवव। <verse eid="NUM 29:5"/><verse number="6" style="v" sid="NUM 29:6"/>बताय गे मासिक अऊ हर दिन के होम-बलिदान के संग ओमन के अन्न-बलिदान अऊ पेय-बलिदान के अलावा ये बलिदानमन ला चघाय जावय। येमन यहोवा ला एक महकत सुख-देवइया चघाय गे जेवन-बलिदान अंय।<verse eid="NUM 29:6"/></para>
  <para style="s1">पछताप के दिन</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7"/>“ ‘ये सातवां महिना के दसवां दिन एक पबितर सभा करव। तुमन अपनआप के इनकार करव<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">उपास करव</char></note> अऊ काम झन करव। <verse eid="NUM 29:7"/><verse number="8" style="v" sid="NUM 29:8"/>यहोवा ला एक महकत सुख-देवइया चढ़ावा के रूप म एक ठन बछवा, एक ठन मेढ़ा अऊ एक-एक साल के सात ठन निरदोस मेढ़ा-पीला के होम-बलिदान चघावव। <verse eid="NUM 29:8"/><verse number="9" style="v" sid="NUM 29:9"/>बछवा के चढ़ावा संग तेल ले सने उत्तम पीसान के एक एपा के तीन-दसवां भाग; मेढ़ा के संग दू-दसवां भाग; <verse eid="NUM 29:9"/><verse number="10" style="v" sid="NUM 29:10"/>अऊ सातों मेढ़ा-पीलामन के हर एक के संग एक-दसवां भाग चघावव। <verse eid="NUM 29:10"/><verse number="11" style="v" sid="NUM 29:11"/>पछताप करे बर पाप-बलिदान अऊ नियमित होम-बलिदान के संग येकर अन्न-बलिदान, अऊ ओमन के पेय-बलिदान के अलावा, पाप-बलिदान के रूप म एक ठन बोकरा मिलावव।<verse eid="NUM 29:11"/></para>
  <para style="s1">पबितर-तम्बूमन के तिहार</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12"/>“ ‘सातवां महिना के पंदरहवां दिन एक पबितर सभा करव अऊ ओ दिन नियमित काम झन करव। सात दिन तक यहोवा बर तिहार मनावव। <verse eid="NUM 29:12"/><verse number="13" style="v" sid="NUM 29:13"/>यहोवा ला एक महकत सुख-देवइया चढ़ावा के रूप म एक जेवन-बलिदान चघावव, जेमा तेरह ठन बछवा, दू ठन मेढ़ा अऊ एक-एक साल के चौदह ठन निरदोस मेढ़ा-पीला होम-बलिदान के होवंय। <verse eid="NUM 29:13"/><verse number="14" style="v" sid="NUM 29:14"/>तेरह बछवा म ले हर एक बछवा के चढ़ावा संग तेल ले सने उत्तम पीसान के एक एपा के तीन-दसवां भाग; दूनों मेढ़ा म ले हर एक के संग दू-दसवां भाग; <verse eid="NUM 29:14"/><verse number="15" style="v" sid="NUM 29:15"/>अऊ चौदह मेढ़ा-पीलामन के हर एक के संग म एक-दसवां भाग चघावव। <verse eid="NUM 29:15"/><verse number="16" style="v" sid="NUM 29:16"/>नियमित होम-बलिदान के संग येकर अन्न-बलिदान अऊ पेय-बलिदान के अलावा, एक ठन बोकरा पाप-बलिदान के रूप म मिलावव।<verse eid="NUM 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17"/>“ ‘दूसरा दिन बारह ठन बछवा, दू ठन मेढ़ा अऊ एक-एक साल के चौदह ठन निरदोस मेढ़ा-पीला चघावव। <verse eid="NUM 29:17"/><verse number="18" style="v" sid="NUM 29:18"/>बछवा, मेढ़ा अऊ मेढ़ा-पीला के संग बताय गे संखिया के मुताबिक ओमन के अन्न-बलिदान अऊ पेय-बलिदान चघावव। <verse eid="NUM 29:18"/><verse number="19" style="v" sid="NUM 29:19"/>नियमित होम-बलिदान के संग येकर अन्न-बलिदान, अऊ ओमन के पेय-बलिदान के अलावा, एक ठन बोकरा पाप-बलिदान के रूप म मिलावव।<verse eid="NUM 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20"/>“ ‘तीसरा दिन गियारह ठन बछवा, दू ठन मेढ़ा अऊ एक-एक साल के चौदह ठन निरदोस मेढ़ा-पीला चघावव। <verse eid="NUM 29:20"/><verse number="21" style="v" sid="NUM 29:21"/>बछवा, मेढ़ा अऊ मेढ़ा-पीला के संग बताय गे संखिया के मुताबिक ओमन के अन्न-बलिदान अऊ पेय-बलिदान चघावव। <verse eid="NUM 29:21"/><verse number="22" style="v" sid="NUM 29:22"/>नियमित होम-बलिदान के संग येकर अन्न-बलिदान अऊ पेय-बलिदान के अलावा, एक ठन बोकरा पाप-बलिदान के रूप म मिलावव।<verse eid="NUM 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23"/>“ ‘चौथा दिन दस ठन बछवा, दू ठन मेढ़ा अऊ एक-एक साल के चौदह ठन निरदोस मेढ़ा-पीला चघावव। <verse eid="NUM 29:23"/><verse number="24" style="v" sid="NUM 29:24"/>बछवा, मेढ़ा अऊ मेढ़ा-पीला के संग बताय गे संखिया के मुताबिक ओमन के अन्न-बलिदान अऊ पेय-बलिदान चघावव। <verse eid="NUM 29:24"/><verse number="25" style="v" sid="NUM 29:25"/>नियमित होम-बलिदान के संग येकर अन्न-बलिदान अऊ पेय-बलिदान के अलावा, एक ठन बोकरा पाप-बलिदान के रूप म मिलावव।<verse eid="NUM 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26"/>“ ‘पांचवां दिन नौ ठन बछवा, दू ठन मेढ़ा अऊ एक-एक साल के चौदह ठन निरदोस मेढ़ा-पीला चघावव। <verse eid="NUM 29:26"/><verse number="27" style="v" sid="NUM 29:27"/>बछवा, मेढ़ा अऊ मेढ़ा-पीला के संग बताय गे संखिया के मुताबिक ओमन के अन्न-बलिदान अऊ पेय-बलिदान चघावव। <verse eid="NUM 29:27"/><verse number="28" style="v" sid="NUM 29:28"/>नियमित होम-बलिदान के संग येकर अन्न-बलिदान अऊ पेय-बलिदान के अलावा, एक ठन बोकरा पाप-बलिदान के रूप म मिलावव।<verse eid="NUM 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29"/>“ ‘छठवां दिन आठ ठन बछवा, दू ठन मेढ़ा अऊ एक-एक साल के चौदह ठन निरदोस मेढ़ा-पीला चघावव। <verse eid="NUM 29:29"/><verse number="30" style="v" sid="NUM 29:30"/>बछवा, मेढ़ा अऊ मेढ़ा-पीला के संग बताय गे संखिया के मुताबिक ओमन के अन्न-बलिदान अऊ पेय-बलिदान चघावव। <verse eid="NUM 29:30"/><verse number="31" style="v" sid="NUM 29:31"/>नियमित होम-बलिदान के संग येकर अन्न-बलिदान अऊ पेय-बलिदान के अलावा, एक ठन बोकरा पाप-बलिदान के रूप म मिलावव।<verse eid="NUM 29:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32"/>“ ‘सातवां दिन सात ठन बछवा, दू ठन मेढ़ा अऊ एक-एक साल के चौदह ठन निरदोस मेढ़ा-पीला चघावव। <verse eid="NUM 29:32"/><verse number="33" style="v" sid="NUM 29:33"/>बछवा, मेढ़ा अऊ मेढ़ा-पीला के संग बताय गे संखिया के मुताबिक ओमन के अन्न-बलिदान अऊ पेय-बलिदान चघावव। <verse eid="NUM 29:33"/><verse number="34" style="v" sid="NUM 29:34"/>नियमित होम-बलिदान के संग येकर अन्न-बलिदान अऊ पेय-बलिदान के अलावा, एक ठन बोकरा पाप-बलिदान के रूप म मिलावव।<verse eid="NUM 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35"/>“ ‘आठवां दिन एक बिसेस समापन सभा करव अऊ ओ दिन नियमित काम झन करव। <verse eid="NUM 29:35"/><verse number="36" style="v" sid="NUM 29:36"/>यहोवा ला एक महकत सुख-देवइया चढ़ावा के रूप म एक जेवन-बलिदान चघावव, जेमा एक ठन बछवा, एक ठन मेढ़ा अऊ एक-एक साल के सात ठन निरदोस मेढ़ा-पीला के एक होम-बलिदान होवय। <verse eid="NUM 29:36"/><verse number="37" style="v" sid="NUM 29:37"/>बछवा, मेढ़ा अऊ मेढ़ा-पीला के संग बताय गे संखिया के मुताबिक ओमन के अन्न-बलिदान अऊ पेय-बलिदान चघावव। <verse eid="NUM 29:37"/><verse number="38" style="v" sid="NUM 29:38"/>नियमित होम-बलिदान के संग येकर अन्न-बलिदान अऊ पेय-बलिदान के अलावा, एक ठन बोकरा पाप-बलिदान के रूप म मिलावव।<verse eid="NUM 29:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39"/>“ ‘अपन मन्नत अऊ अपन स्वेच्छा-बलिदान के चढ़ावा के अलावा, तुम्हर ठहिराय गे तिहार म यहोवा ला ये घलो चघावव: तुम्हर होम-बलिदान, अन्न-बलिदान, पेय-बलिदान अऊ मेल-बलिदान।’ ”<verse eid="NUM 29:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40"/>यहोवा के जम्मो हुकूम ला मूसा ह इसरायलीमन ला बता दीस।<note caller="+" style="f"><char style="fr" closed="false">29:40 </char><char style="ft" closed="false">इबरानी अनुवाद म ये पद (<char style="xt"><ref loc="NUM 29:40">29:40</ref></char>) ला अधियाय 30:1 के रूप म गने गे हवय</char></note><verse eid="NUM 29:40"/></para>
  <chapter eid="NUM 29"/>
  <chapter number="30" style="c" sid="NUM 30"/>
  <para style="s1">मन्नत</para>
  <para style="p">
    <note caller="+" style="f">
      <char style="fr" closed="false">30 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="NUM 30:1-16">30:1‑16</ref></char> ला 30:2‑17 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="NUM 30:1"/>मूसा ह इसरायल के गोत्रमन के मुखियामन ला कहिस: “यहोवा के ये हुकूम अय: <verse eid="NUM 30:1"/><verse number="2" style="v" sid="NUM 30:2"/>जब कोनो मनखे यहोवा के मन्नत मानथे या अपनआप परन करके सपथ खावय, त ओह अपन बचन ले झन मुकरय, पर अपन कहे हर बात ला पूरा करय।<verse eid="NUM 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3"/>“जब कोनो जवान नोनी अपन ददा के घर म रहत यहोवा के मन्नत मानथे या अपनआप कोनो परन करथे <verse eid="NUM 30:3"/><verse number="4" style="v" sid="NUM 30:4"/>अऊ ओकर ददा ओकर मन्नत या परन ला सुनथे, पर ओला कुछू नइं कहय, त ओ जवान नोनी के जम्मो मन्नत अऊ ओकर करे गे हर परन ह लागू होथे। <verse eid="NUM 30:4"/><verse number="5" style="v" sid="NUM 30:5"/>पर यदि ओकर ददा ह ओकर मन्नत या ओकर बचन देवई ला सुनके ओला मना कर देथे, त ओकर दुवारा माने गय कोनो मन्नत या परन ह लागू नइं होवय; यहोवा ह ओला छोंड़ दीही, काबरकि ओकर ददा ह ओला मना कर दे हवय।<verse eid="NUM 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6"/>“यदि ओह कोनो परन करे के बाद या अपनआप बिगर सोचे-बिचारे कोनो मन्नत के बाद बिहाव कर लेथे <verse eid="NUM 30:6"/><verse number="7" style="v" sid="NUM 30:7"/>अऊ जब ओकर घरवाला ह येकर बारे म सुनथे, पर ओला कुछू नइं कहय, त फेर ओकर मन्नत या अपनआप करे गे परन करई ह लागू होथे। <verse eid="NUM 30:7"/><verse number="8" style="v" sid="NUM 30:8"/>पर यदि ओकर घरवाला ह मन्नत के बारे म सुनके ओला मना कर देथे, त ओह ओकर घरवाली के परन या बिगर सोचे-बिचारे अपनआप करे गे मन्नत ला खतम कर देथे, अऊ यहोवा ह ओला छेमा कर दीही।<verse eid="NUM 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9"/>“यदि बिधवा या तलाकसुदा माईलोगन कोनो मन्नत मानथे या बचन देथे, त ओह ओकर ले बंधे रहिथे।<verse eid="NUM 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10"/>“यदि कोनो माईलोगन अपन घरवाला के संग रहत कोनो मन्नत मानथे या सपथ खाके कोनो परन करथे <verse eid="NUM 30:10"/><verse number="11" style="v" sid="NUM 30:11"/>अऊ ओकर घरवाला येला सुनके ओला कुछू नइं कहय अऊ ओला मना नइं करय, त ओकर माने गे जम्मो मन्नत या ओकर दुवारा करे गे जम्मो परन लागू होथे। <verse eid="NUM 30:11"/><verse number="12" style="v" sid="NUM 30:12"/>पर यदि ओकर घरवाला ह ओ मन्नत या बचन ला सुनके खतम कर देथे, तब ओ माईलोगन के दुवारा माने गे मन्नत या बचन लागू नइं होवय। ओकर घरवाला ह ओमन ला रद्द कर दे हवय, एकरसेति यहोवा ह ओला छेमा कर दीही। <verse eid="NUM 30:12"/><verse number="13" style="v" sid="NUM 30:13"/>ओकर घरवाला ह ओकर दुवारा माने गे कोनो मन्नत या करे गय सपथ ला लागू कर सकथे या ओला खतम घलो कर सकथे। <verse eid="NUM 30:13"/><verse number="14" style="v" sid="NUM 30:14"/>पर यदि ओकर घरवाला दिन-प्रतिदिन ओकर बारे म ओला कुछू नइं कहय, त येकर मतलब ये अय कि ओह ओकर दुवारा करे गय जम्मो मन्नत या परन ला सहमती देथे। ओह सुनके ओला कुछू नइं कहे के दुवारा ओकर मन्नत या बचन बर सहमती देथे। <verse eid="NUM 30:14"/><verse number="15" style="v" sid="NUM 30:15"/>पर यदि ओह ओ मन्नत या बचन ला सुनके कुछू समय बाद ओमन ला खतम कर देथे, तब ओह अपन घरवाली के दोस के भार उठाही।”<verse eid="NUM 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16"/>एक मनखे अऊ ओकर घरवाली के बीच, अऊ एक ददा अऊ ओकर कुंवारी बेटी के बीच जऊन ह अभी भी घर म रहिथे, ओमन के संबंध के बारे म येमन बिधि अंय, जेला यहोवा ह मूसा ला दीस।<verse eid="NUM 30:16"/></para>
  <chapter eid="NUM 30"/>
  <chapter number="31" style="c" sid="NUM 31"/>
  <para style="s1">मिदयानीमन ले बदला लेवई</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1"/>यहोवा ह मूसा ला कहिस, <verse eid="NUM 31:1"/><verse number="2" style="v" sid="NUM 31:2"/>“इसरायलीमन बर मिदयानीमन ले बदला ले। ओकर बाद, तेंह मरके अपन पुरखामन संग हमेसा बर मिल जाबे।”<verse eid="NUM 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3"/>तब मूसा ह मनखेमन ला कहिस, “मिदयानीमन के बिरूध लड़ई करे बर अपन कुछू मनखेमन ला तियार होय बर कहव, ताकि ओमन मिदयानीमन ले यहोवा के बदला लेवंय। <verse eid="NUM 31:3"/><verse number="4" style="v" sid="NUM 31:4"/>इसरायल के हर गोत्र म ले एक-एक हजार पुरूसमन ला लड़ई म भेजव।” <verse eid="NUM 31:4"/><verse number="5" style="v" sid="NUM 31:5"/>हर गोत्र म ले एक-एक हजार, कुल बारह हजार हथियारबंद पुरूस लड़ई बर इसरायल के बंस ले तियार होईन। <verse eid="NUM 31:5"/><verse number="6" style="v" sid="NUM 31:6"/>मूसा ह हर गोत्र म ले एक-एक हजार पुरूस लड़ई म भेजिस; संग म एलिआजर पुरोहित के बेटा पीनहास ला पठोईस, जऊन ह अपन संग पबितर-स्थान के चीज अऊ फूंकके इसारा करे बर तुरहीमन ला धरे रिहिस।<verse eid="NUM 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 31:7"/>यहोवा के मूसा ला दिये हुकूम के मुताबिक ओमन मिदयानीमन के बिरूध लड़के जम्मो मिदयानी पुरूस ला मार डारिन। <verse eid="NUM 31:7"/><verse number="8" style="v" sid="NUM 31:8"/>मारे गे मनखेमन के बीच मिदयानीमन के पांच राजा—एवी, रेकेम, सूर, हूर अऊ रेबा रिहिन। ओमन बेओर के बेटा बिलाम ला घलो तलवार ले मार डारिन। <verse eid="NUM 31:8"/><verse number="9" style="v" sid="NUM 31:9"/>इसरायलीमन मिदयानी माईलोगन अऊ लइकामन ला बंदी बना लीन अऊ मिदयानीमन के जम्मो गरूवा-बईला, भेड़-बकरी के झुंड अऊ सामान ला लूट लीन। <verse eid="NUM 31:9"/><verse number="10" style="v" sid="NUM 31:10"/>ओमन मिदयानीमन के बसे जम्मो नगर अऊ ओमन के जम्मो सिविरमन ला नास कर दीन। <verse eid="NUM 31:10"/><verse number="11" style="v" sid="NUM 31:11"/>ओमन जम्मो लूट के सामान, मनखे अऊ पसुमन ला ले लीन, <verse eid="NUM 31:11"/><verse number="12" style="v" sid="NUM 31:12"/>अऊ बंदीमन ला अऊ लूट के सामान ला मूसा अऊ एलिआजर पुरोहित अऊ इसरायली सभा करा मोआब के मैदान म डारे ओमन के डेरा म ले आईन, जऊन ह यरीहो के ओ पार यरदन नदी के तीर म रिहिस।<verse eid="NUM 31:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13"/>मूसा, एलिआजर पुरोहित अऊ समाज के जम्मो अगुवामन ओमन ले मिले बर सिविर के बाहिर गीन। <verse eid="NUM 31:13"/><verse number="14" style="v" sid="NUM 31:14"/>मूसा ह लड़ई ले लहुंटे सेना के ओ अधिकारीमन ले नराज होईस, जेमन हजारों अऊ सैकड़ों सैनिक के ऊपर सेनापति ठहिराय गे रिहिन।<verse eid="NUM 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 31:15"/>मूसा ह ओमन ले पुछिस, “का तुमन जम्मो माईलोगन ला जीयत छोंड़ दे हव?” <verse eid="NUM 31:15"/><verse number="16" style="v" sid="NUM 31:16"/>येमन ओ माईलोगन रिहिन, जेमन पेओर के घटना म बिलाम के सलाह मानिन अऊ यहोवा के संग बिसवासघात करे बर इसरायली समाज ला बहकाईन, जेकर ले यहोवा के मनखेमन ऊपर एक महामारी फईलिस। <verse eid="NUM 31:16"/><verse number="17" style="v" sid="NUM 31:17"/>अब जम्मो लड़कामन ला मार डारव। अऊ हर ओ माईलोगन ला मार डारव, जऊन ह पुरूस के संग सुते हवय, <verse eid="NUM 31:17"/><verse number="18" style="v" sid="NUM 31:18"/>पर हर ओ लड़की ला अपन बर बचाके रखव, जेह पुरूस के संग कभू नइं सुते हे।<verse eid="NUM 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 31:19"/>“जऊन मनखे ह कोनो मनखे ला मार डारे हे या कोनो मारे गे मनखे ला छुए हे, त ओ मनखे ह सात दिन तक डेरा ले बाहिर रहय। तीसरा अऊ सातवां दिन तुमन अपनआप ला अऊ अपन बंदीमन ला सुध करव। <verse eid="NUM 31:19"/><verse number="20" style="v" sid="NUM 31:20"/>हर एक कपड़ा अऊ संग म चाम के बने हर चीज ला सुध करव, बोकरा के रूआं हो या लकड़ी।”<verse eid="NUM 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21"/>तब एलिआजर पुरोहित ह ओ सैनिकमन ला कहिस, जऊन मन लड़ई म गे रिहिन, “यहोवा के दुवारा मूसा ला दिये गे कानून के मुताबिक ये काम करे के जरूरत हे: <verse eid="NUM 31:21"/><verse number="22" style="v" sid="NUM 31:22"/>सोन, चांदी, कांसा, लोहा, टीन, सीसा <verse eid="NUM 31:22"/><verse number="23" style="v" sid="NUM 31:23"/>अऊ जऊन कुछू चीज आगी म नइं जलय, ओमन ला आगी म डालके निकालव, अऊ तब ये चीजमन सुध हो जाहीं। पर येमन ला सुध करइया पानी ले घलो सुध करना जरूरी ए। अऊ जऊन कुछू चीज आगी म ठहर नइं सकय, ओला ओ पानी म डालके निकालव। <verse eid="NUM 31:23"/><verse number="24" style="v" sid="NUM 31:24"/>सातवां दिन अपन कपड़ामन ला धोवव अऊ तुमन सुध हो जाहू। तब तुमन डेरा म आ सकत हव।”<verse eid="NUM 31:24"/></para>
  <para style="s1">लूट के सामान के बंटवारा</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 31:25"/><verse number="26" style="v" sid="NUM 31:26"/>“तें अऊ एलिआजर पुरोहित अऊ समाज के परिवार के मुखियामन बंदी बनाय गे जम्मो मनखे अऊ पसुमन के गनती करव। <verse eid="NUM 31:26"/><verse number="27" style="v" sid="NUM 31:27"/>लूट के सामान ला लड़ई म गय सैनिक अऊ समाज के बाकि मनखेमन के बीच बरोबर-बरोबर बांट दव। <verse eid="NUM 31:27"/><verse number="28" style="v" sid="NUM 31:28"/>जऊन सैनिकमन लड़ई म गे रिहिन, ओमा ले हर पांच सौ के पाछू एक झन ला यहोवा बर राजकर के रूप म अलग रखव; चाहे ओमन मनखे, पसु, गदहा या भेड़मन होवंय। <verse eid="NUM 31:28"/><verse number="29" style="v" sid="NUM 31:29"/>ओमन के आधा भाग म ले ये राजकर ला लेय ले अऊ येला यहोवा बर एलिआजर पुरोहित ला भेंट देय दे। <verse eid="NUM 31:29"/><verse number="30" style="v" sid="NUM 31:30"/>इसरायलीमन के आधा भाग म ले, हर पचास के पाछू एक झन ला अलग रख; चाहे ओमन मनखे, पसु, गदहा, भेड़ या आने पसुमन होवंय। ये भाग ला ओ लेवीमन ला देय दे, जेमन के ऊपर यहोवा के पबितर-तम्बू के देखरेख के जिम्मेदारी हवय।” <verse eid="NUM 31:30"/><verse number="31" style="v" sid="NUM 31:31"/>मूसा अऊ एलिआजर पुरोहित मूसा ला दिये गय यहोवा के हुकूम के मुताबिक करिन।<verse eid="NUM 31:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 31:32"/>सैनिकमन के दुवारा लूटे गय सामान म ले ये बचे रिहिस 6,75,000 भेड़, <verse eid="NUM 31:32"/><verse number="33" style="v" sid="NUM 31:33"/>72,000 पसु <verse eid="NUM 31:33"/><verse number="34" style="v" sid="NUM 31:34"/>61,000 गदहा <verse eid="NUM 31:34"/><verse number="35" style="v" sid="NUM 31:35"/>32,000 माईलोगन जेमन कभू कोनो पुरूस संग नइं सुते रिहिन।<verse eid="NUM 31:35"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="36" style="v" sid="NUM 31:36"/>जेमन लड़ई म गे रिहिन, ओमन के आधा भाग ये रिहिस:</para>
  <para style="b" vid="NUM 31:36"/>
  <para style="li1" vid="NUM 31:36">3,37,500 भेड़, <verse eid="NUM 31:36"/><verse number="37" style="v" sid="NUM 31:37"/>जेमा ले यहोवा के राजकर 675 ठन भेड़ रिहिन;<verse eid="NUM 31:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 31:38"/>36,000 पसु, जेमा ले यहोवा के राजकर 72 ठन पसु रिहिन;<verse eid="NUM 31:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="NUM 31:39"/>30,500 गदहा, जेमा ले यहोवा के राजकर 61 ठन गदहा रिहिन;<verse eid="NUM 31:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 31:40"/>16,000 मनखे, जेमा यहोवा बर ठहिराय राजकर के रूप म 32 झन मनखे रिहिन।<verse eid="NUM 31:40"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="41" style="v" sid="NUM 31:41"/>मूसा ह एलिआजर पुरोहित ला यहोवा के बांटा के रूप म राजकर दीस, जइसे कि यहोवा ह मूसा ला हुकूम दे रिहिस।<verse eid="NUM 31:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42"/>मूसा ह सैनिकमन ले लूट के आधा सामान ला इसरायलीमन बर अलग रखिस; <verse eid="NUM 31:42"/><verse number="43" style="v" sid="NUM 31:43"/>समाज के आधा भाग 3,37,500 भेड़, <verse eid="NUM 31:43"/><verse number="44" style="v" sid="NUM 31:44"/>36,000 पसु, <verse eid="NUM 31:44"/><verse number="45" style="v" sid="NUM 31:45"/>30,500 गदहा, <verse eid="NUM 31:45"/><verse number="46" style="v" sid="NUM 31:46"/>अऊ 16,000 मनखे। <verse eid="NUM 31:46"/><verse number="47" style="v" sid="NUM 31:47"/>इसरायलीमन के आधा भाग म ले, मूसा ह हर पचास मनखे अऊ पचास पसु के पाछू एक-एक मनखे अऊ पसु ला अलग करिस, जइसे कि यहोवा ह ओला हुकूम दे रिहिस, अऊ ओला लेवीमन ला दे दीस, जेमन यहोवा के पबितर-तम्बू के देखरेख करत रिहिन।<verse eid="NUM 31:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48"/>तब सेना के हर दल के ऊपर ठहिराय गय अधिकारीमन—हजारों सैनिकमन अऊ सैकड़ों सैनिकमन ऊपर ठहिराय गय सेनापतिमन मूसा करा गीन <verse eid="NUM 31:48"/><verse number="49" style="v" sid="NUM 31:49"/>अऊ मूसा ला कहिन, “तोर सेवकमन हमर अधीन रहे सैनिकमन के गनती करे हवंय, अऊ ओमा ले एको झन भी नइं छूटे हवंय। <verse eid="NUM 31:49"/><verse number="50" style="v" sid="NUM 31:50"/>हमन म ले हर एक जन सोन के जऊन चीजमन ला अपन अधिकार म ले हन—बाजूबंद, कंगन, मुंदरी, कान के बाली अऊ माला—येला हमन यहोवा बर चढ़ावा के रूप म लाने हन, ताकि यहोवा के आघू म हमन पछताप कर सकन।”<verse eid="NUM 31:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51"/>तब मूसा अऊ एलिआजर पुरोहित ओमन ले तरासके बनाय गे सोन के जम्मो चीजमन ला ले लीन। <verse eid="NUM 31:51"/><verse number="52" style="v" sid="NUM 31:52"/>हजारों सैनिक अऊ सैकड़ों सैनिक के सेनापति दुवारा दिये गय जम्मो सोन ला, मूसा अऊ एलिआजर यहोवा ला भेंट म चघाईन, ओकर वजन 16,750 सेकेल<note caller="+" style="f"><char style="fr" closed="false">31:52 </char><char style="ft" closed="false">लगभग 190 किलोग्राम</char></note> रिहिस। <verse eid="NUM 31:52"/><verse number="53" style="v" sid="NUM 31:53"/>हर एक सैनिक अपन बर लूट के सामान लेय ले रिहिन। <verse eid="NUM 31:53"/><verse number="54" style="v" sid="NUM 31:54"/>मूसा अऊ एलिआजर पुरोहित हजारों अऊ सैकड़ों सैनिकमन के सेनापति ले ओ सोन ला स्वीकार कर लीन अऊ ओ सोन ला मिलापवाला तम्बू म ले आईन, ताकि ओह यहोवा के आघू म इसरायलीमन बर एक सुरता करइया चीज ठहिरे।<verse eid="NUM 31:54"/></para>
  <chapter eid="NUM 31"/>
  <chapter number="32" style="c" sid="NUM 32"/>
  <para style="s1">गोत्र</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1"/>रूबेनी अऊ गादीमन करा गरूवा-बईला अऊ भेड़-बकरी के बड़े-बड़े झुंड रिहिन। जब ओमन देखिन कि याजेर अऊ गिलाद पसु-धन बर उचित छेत्र अंय, <verse eid="NUM 32:1"/><verse number="2" style="v" sid="NUM 32:2"/>त ओमन मूसा अऊ एलिआजर पुरोहित अऊ समाज के अगुवामन करा आईन अऊ कहिन, <verse eid="NUM 32:2"/><verse number="3" style="v" sid="NUM 32:3"/>“अतारोत, दीबोन, याजेर, निमराह, हेसबोन, एलाले, सबाम, नबो अऊ बोन नगरमन ला <verse eid="NUM 32:3"/><verse number="4" style="v" sid="NUM 32:4"/>यहोवा ह इसरायली समाज के मनखेमन के आघू म जीत लीस; ये नगरमन पसु-धन बर सही अंय, अऊ तुम्हर सेवकमन करा पसु-धन हवय। <verse eid="NUM 32:4"/><verse number="5" style="v" sid="NUM 32:5"/>यदि तुम्हर किरपा के नजर हमर ऊपर हवय, त ये देस ला तुम्हर सेवकमन के अधिकार म दिये जावय। हमन ला यरदन नदी के ओ पार झन जावन दव।”<verse eid="NUM 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6"/>तब मूसा ह गादी अऊ रूबेनीमन ला कहिस, “का तुम्हर संगी इसरायलीमन लड़ई करे बर जावंय, जब तुमन इहां बईठे रहव? <verse eid="NUM 32:6"/><verse number="7" style="v" sid="NUM 32:7"/>तुमन काबर इसरायलीमन ला यरदन के ओ पार के देस म जाय बर हतास करत हव, जेला कि यहोवा ह ओमन ला दे हवय? <verse eid="NUM 32:7"/><verse number="8" style="v" sid="NUM 32:8"/>तुम्हर पुरखामन घलो अइसने ही करिन, जब मेंह ओमन ला कादेस-बरने ले ओ देस ला देखे बर पठोंय। <verse eid="NUM 32:8"/><verse number="9" style="v" sid="NUM 32:9"/>जब ओमन एसकोल के घाटी म हबरिन अऊ उहां ले ओ देस ला देखिन, त ओमन इसरायलीमन ला ओ देस म जाय बर हतास करिन, जेला यहोवा ह ओमन ला दे रिहिस। <verse eid="NUM 32:9"/><verse number="10" style="v" sid="NUM 32:10"/>तब ओ दिन यहोवा के कोप ह भड़किस अऊ ओह ये सपथ खाईस: <verse eid="NUM 32:10"/><verse number="11" style="v" sid="NUM 32:11"/>‘काबरकि ओमन पूरा मन से मोर पाछू नइं चलिन, एकरसेति मिसर ले निकले के बेरा जतेक झन बीस साल या ओकर ले जादा उमर के रिहिन, ओमा के कोनो भी ओ देस ला देखे नइं सकहीं, जेला देय के परतिगियां मेंह अब्राहम, इसहाक अऊ याकूब ले सपथ खाके करे रहेंव— <verse eid="NUM 32:11"/><verse number="12" style="v" sid="NUM 32:12"/>सिरिप कनजी यपुन्ने के बेटा कालेब अऊ नून के बेटा यहोसू ही ओ देस ला देखे सकहीं, काबरकि ओमन पूरा मन से यहोवा के पाछू चले हवंय।’ <verse eid="NUM 32:12"/><verse number="13" style="v" sid="NUM 32:13"/>त यहोवा के कोप इसरायल ऊपर भड़किस अऊ ओह ओमन ला सुन्ना जगह म चालीस साल तक भटकाईस, जब तक कि ओ पूरा पीढ़ी खतम नइं हो गीस, जेमन ओकर नजर म दुस्ट काम करे रिहिन।<verse eid="NUM 32:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 32:14"/>“अऊ तुमन इहां, पापीमन के संतान, अपन पुरखामन के जगह म खड़े हव अऊ इसरायल बर यहोवा ला अऊ गुस्सा देवात हव। <verse eid="NUM 32:14"/><verse number="15" style="v" sid="NUM 32:15"/>यदि तुमन ओकर पाछू चलई बंद कर दूहू, त ओह फेर ये जम्मो मनखेमन ला सुन्ना जगह म छोंड़ दीही, अऊ तुमन ओमन के बिनास के कारन होहू।”<verse eid="NUM 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16"/>तब गादी अऊ रूबेनीमन मूसा करा आके कहिन, “हमन इहां अपन पसुमन बर थान अऊ हमर माईलोगन अऊ लइकामन बर सहर बसाय चाहत हन। <verse eid="NUM 32:16"/><verse number="17" style="v" sid="NUM 32:17"/>पर हमन खुद लड़ई बर हथियार धरबो अऊ इसरायलीमन के आघू-आघू जाबो, जब तक कि हमन ओमन ला ओमन के जगह म अमरा नइं देबो। इही दौरान हमर माईलोगन अऊ लइकामन ये देस के निवासीमन ले बचे बर गढ़वाले सहर म रहिहीं। <verse eid="NUM 32:17"/><verse number="18" style="v" sid="NUM 32:18"/>हमन तब तक अपन घर नइं लहुंटन, जब तक कि हर एक इसरायली अपन उत्तराधिकार ला नइं पा लीही। <verse eid="NUM 32:18"/><verse number="19" style="v" sid="NUM 32:19"/>हमन यरदन के ओ पार ओमन के संग कोनो उत्तराधिकार नइं लेवन, काबरकि हमर उत्तराधिकार हमन ला यरदन के पूरब कोति मिल गे हवय।”<verse eid="NUM 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20"/>तब मूसा ह ओमन ला कहिस, “यदि तुमन ये करहू—यदि तुमन खुद यहोवा कोति ले लड़ई बर हथियार धरहू <verse eid="NUM 32:20"/><verse number="21" style="v" sid="NUM 32:21"/>अऊ यदि तुमन जम्मो, जऊन मन हथियार धरहू अऊ परभू के आघू यरदन के ओ पार जाहू अऊ यहोवा ह अपन आघू ले अपन बईरीमन ला निकाल दीही— <verse eid="NUM 32:21"/><verse number="22" style="v" sid="NUM 32:22"/>तब जब देस ह यहोवा के आघू म जीत लिये जाही, त तुमन लहुंट सकत हव अऊ यहोवा बर अऊ अपन संगी इसरायलीमन बर अपन जिम्मेदारी ले छूट सकत हव। अऊ ये देस ह यहोवा के आघू म तुम्हर अधिकार म हो जाही।<verse eid="NUM 32:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 32:23"/>“पर यदि तुमन ये काम करे म असफल होहू, त तुमन यहोवा के बिरूध पाप करहू, अऊ तुमन ये बात ला खचित जान लव कि तुमन ला तुम्हर पाप लगही। <verse eid="NUM 32:23"/><verse number="24" style="v" sid="NUM 32:24"/>अपन माईलोगन अऊ लइकामन बर सहर अऊ अपन पसुमन बर थान बनावव, अऊ अपन करे गे परतिगियां ला पूरा करव।”<verse eid="NUM 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25"/>गादी अऊ रूबेनीमन मूसा ला कहिन, “हमन तोर सेवकमन, जइसे हमर मालिक ह हुकूम देवत हे, वइसे करबो। <verse eid="NUM 32:25"/><verse number="26" style="v" sid="NUM 32:26"/>हमर लइका अऊ घरवाली, हमर गरूवा-बईला अऊ भेड़-बकरी के झुंड इहां गिलाद के सहरमन म रहिहीं। <verse eid="NUM 32:26"/><verse number="27" style="v" sid="NUM 32:27"/>पर तोर सेवकमन, हर ओ मनखे जऊन ह लड़ई बर हथियार धरे हवय, यहोवा के आघू म लड़ई करे बर ओ पार जाही, जइसे कि हमर मालिक ह कहत हे।”<verse eid="NUM 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28"/>तब मूसा ह ओमन के बारे म एलिआजर पुरोहित अऊ नून के बेटा यहोसू अऊ इसरायली गोत्र के परिवार के मुखियामन ला हुकूम दीस। <verse eid="NUM 32:28"/><verse number="29" style="v" sid="NUM 32:29"/>मूसा ह ओमन ला कहिस, “यदि गादी अऊ रूबेनीमन के लड़ई बर हथियार धरे हर एक पुरूस यहोवा के आघू म तुम्हर संग यरदन के ओ पार जाथें, अऊ तब जब ओ देस ह तुम्हर अधिकार म आ जाथे, त तुमन गिलाद के देस ला ओमन के अधिकार म दे दूहू। <verse eid="NUM 32:29"/><verse number="30" style="v" sid="NUM 32:30"/>पर यदि ओमन हथियार धरके तुम्हर संग ओ पार नइं जाहीं, त ओमन ला कनान म ही अपन भाग स्वीकार करना पड़ही।”<verse eid="NUM 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31"/>गादी अऊ रूबेनीमन जबाब दीन, “तोर सेवकमन वइसने ही करहीं, जइसने यहोवा ह कहे हवय। <verse eid="NUM 32:31"/><verse number="32" style="v" sid="NUM 32:32"/>हमन हथियार धरके यहोवा के आघू म ओ पार कनान देस म जाबो, पर उत्तराधिकार के रूप म हमर संपत्ति यरदन के इही पार रहय।”<verse eid="NUM 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33"/>तब मूसा ह गाद, रूबेन अऊ यूसुफ के बेटा मनस्से के आधा गोत्र ला अमोरीमन के राजा सीहोन के राज अऊ बासान के राजा ओग के राज ला दे दीस—पूरा देस, येकर सहरमन अऊ ओमन के चारों कोति के इलाका ला दे दीस।<verse eid="NUM 32:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 32:34"/>गादीमन दीबोन, अतारोत, अरोएर, <verse eid="NUM 32:34"/><verse number="35" style="v" sid="NUM 32:35"/>अतरोत-सोपान, याजेर, योगबहा, <verse eid="NUM 32:35"/><verse number="36" style="v" sid="NUM 32:36"/>बेत-निमरा अऊ बेत-हारान ला गढ़वाले नगर बना दीन, अऊ अपन पसुमन बर थान बनाईन। <verse eid="NUM 32:36"/><verse number="37" style="v" sid="NUM 32:37"/>अऊ रूबेनीमन हेसबोन, एलाले, अऊ किरयातैम, <verse eid="NUM 32:37"/><verse number="38" style="v" sid="NUM 32:38"/>अऊ संग म नबो अऊ बाल-मेओन (ये नांवमन ला बदल दिये गीस) अऊ सिबमा ला फेर बनाईन। ओमन फेर बनाय गे सहरमन के नांव रखिन।<verse eid="NUM 32:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39"/>मनस्से के बेटा माकीर के संतानमन गिलाद जाके ओला अपन कब्जा म कर लीन अऊ जऊन अमोरीमन उहां रहत रिहिन, ओमन ला भगा दीन। <verse eid="NUM 32:39"/><verse number="40" style="v" sid="NUM 32:40"/>तब मूसा ह मनस्से के संतान माकीर ला गिलाद के इलाका दे दीस, अऊ ओमन उहां बस गीन। <verse eid="NUM 32:40"/><verse number="41" style="v" sid="NUM 32:41"/>मनस्से के एक संतान याईर ह गिलाद के नगरमन ऊपर कब्जा कर लीस अऊ ओमन के नांव हव्वोत-याईर<note caller="+" style="f"><char style="fr" closed="false">32:41 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">याईर के बस्तीमन</char></note> रखिस। <verse eid="NUM 32:41"/><verse number="42" style="v" sid="NUM 32:42"/>अऊ नोबह ह कनात अऊ ओकर आसपास के बस्तीमन ऊपर कब्जा कर लीस अऊ ओला अपन ही नांव नोबह दीस।<verse eid="NUM 32:42"/></para>
  <chapter eid="NUM 32"/>
  <chapter number="33" style="c" sid="NUM 33"/>
  <para style="s1">इसरायल के यातरा म पड़ाव</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1"/>जब इसरायलीमन मूसा अऊ हारून के अगुवई म दल बना-बनाके मिसर देस ले बाहिर निकलिन, त येमन ओमन के यातरा के पड़ाव रिहिन। <verse eid="NUM 33:1"/><verse number="2" style="v" sid="NUM 33:2"/>यहोवा के हुकूम ले मूसा ह ओमन के यातरा के पड़ावमन के लेखा रखिस। पड़ावमन के मुताबिक येह ओमन के यातरा रिहिस:<verse eid="NUM 33:2"/></para>
  <para style="b"/>
  <para style="pi1">
    <verse number="3" style="v" sid="NUM 33:3"/>पहिला महिना<note caller="+" style="f"><char style="fr" closed="false">33:3 </char><char style="ft" closed="false">इबरीमन के पहिला महिना संभवतः मध्य मार्च ले लेके मध्य अप्रेल तक होथे</char></note> के पंदरहवां दिन, याने कि फसह तिहार के बाद दूसर दिन इसरायलीमन रामसेस सहर ले आघू बढ़िन। ओमन जम्मो मिसरीमन के देखत म बड़े निडरता से निकलिन; <verse eid="NUM 33:3"/><verse number="4" style="v" sid="NUM 33:4"/>ओ समय मिसरीमन अपन पहिलांतमन ला माटी देवत रिहिन, जेमन ला यहोवा ह मार डारे रिहिस; काबरकि यहोवा ह ओमन के देवतामन ला दंड देय रिहिस।<verse eid="NUM 33:4"/></para>
  <para style="pi1">
    <verse number="5" style="v" sid="NUM 33:5"/>इसरायलीमन रामसेस ले चलके सुक्कोत नांव के जगह म डेरा डालिन।<verse eid="NUM 33:5"/></para>
  <para style="pi1">
    <verse number="6" style="v" sid="NUM 33:6"/>फेर सुक्कोत ले आघू बढ़के एताम म डेरा डालिन, जऊन ह सुन्ना जगह के तीर म हवय।<verse eid="NUM 33:6"/></para>
  <para style="pi1">
    <verse number="7" style="v" sid="NUM 33:7"/>ओमन एताम ले पाछू लहुंटके पी-हाहीरोत गीन, जऊन ह बाल-सपोन के पूरब म हवय, अऊ उहां मिगदोल के लकठा म डेरा डालिन।<verse eid="NUM 33:7"/></para>
  <para style="pi1">
    <verse number="8" style="v" sid="NUM 33:8"/>तब ओमन पी-हाहीरोत ले चलके समुंदर ले होवत सुन्ना जगह म आईन, अऊ एताम के सुन्ना जगह म तीन दिन के रसता तय करिन, अऊ मारा नांव के जगह म डेरा डालिन।<verse eid="NUM 33:8"/></para>
  <para style="pi1">
    <verse number="9" style="v" sid="NUM 33:9"/>ओमन मारा ले चलके एलीम म आईन, जिहां बारह ठन पानी के सोता अऊ सत्तर ठन खजूर के रूख रिहिन, अऊ ओमन उहां डेरा डालिन।<verse eid="NUM 33:9"/></para>
  <para style="pi1">
    <verse number="10" style="v" sid="NUM 33:10"/>ओमन एलीम ले चलके लाल-समुंदर<note caller="+" style="f"><char style="fr" closed="false">33:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">नरकटमन के समुंदर</char></note> के तीर म डेरा डालिन।<verse eid="NUM 33:10"/></para>
  <para style="pi1">
    <verse number="11" style="v" sid="NUM 33:11"/>ओमन लाल-समुंदर ले चलके सीन के सुन्ना जगह म डेरा डालिन।<verse eid="NUM 33:11"/></para>
  <para style="pi1">
    <verse number="12" style="v" sid="NUM 33:12"/>फेर ओमन सीन के सुन्ना जगह ले दोपका म डेरा डालिन।<verse eid="NUM 33:12"/></para>
  <para style="pi1">
    <verse number="13" style="v" sid="NUM 33:13"/>ओमन दोपका ले चलके आलूस म डेरा डालिन।<verse eid="NUM 33:13"/></para>
  <para style="pi1">
    <verse number="14" style="v" sid="NUM 33:14"/>फेर ओमन आलूस ले चलके रपीदीम म डेरा डालिन, जिहां मनखेमन के पीये बर पानी नइं रिहिस।<verse eid="NUM 33:14"/></para>
  <para style="pi1">
    <verse number="15" style="v" sid="NUM 33:15"/>तब ओमन रपीदीम ले चलके सीनय के सुन्ना जगह म डेरा डालिन।<verse eid="NUM 33:15"/></para>
  <para style="pi1">
    <verse number="16" style="v" sid="NUM 33:16"/>फेर ओमन सीनय के सुन्ना जगह ले चलके किबरोत-हतावा म डेरा डालिन।<verse eid="NUM 33:16"/></para>
  <para style="pi1">
    <verse number="17" style="v" sid="NUM 33:17"/>तब ओमन किबरोत-हतावा ले चलके हसेरोत म डेरा डालिन।<verse eid="NUM 33:17"/></para>
  <para style="pi1">
    <verse number="18" style="v" sid="NUM 33:18"/>फेर ओमन हसेरोत ले चलके रितमा म डेरा डालिन।<verse eid="NUM 33:18"/></para>
  <para style="pi1">
    <verse number="19" style="v" sid="NUM 33:19"/>ओमन रितमा ले चलके रिम्मोन-पेरेस म डेरा डालिन।<verse eid="NUM 33:19"/></para>
  <para style="pi1">
    <verse number="20" style="v" sid="NUM 33:20"/>ओमन रिम्मोन-पेरेस ले चलके लिबना म डेरा डालिन।<verse eid="NUM 33:20"/></para>
  <para style="pi1">
    <verse number="21" style="v" sid="NUM 33:21"/>ओमन लिबना ले चलके रिस्सा म डेरा डालिन।<verse eid="NUM 33:21"/></para>
  <para style="pi1">
    <verse number="22" style="v" sid="NUM 33:22"/>ओमन रिस्सा ले चलके कहेलाता म डेरा डालिन।<verse eid="NUM 33:22"/></para>
  <para style="pi1">
    <verse number="23" style="v" sid="NUM 33:23"/>तब ओमन कहेलाता ले चलके सेपेर पहाड़ करा डेरा डालिन।<verse eid="NUM 33:23"/></para>
  <para style="pi1">
    <verse number="24" style="v" sid="NUM 33:24"/>फेर ओमन सेपेर पहाड़ ले चलके हरादा म डेरा डालिन।<verse eid="NUM 33:24"/></para>
  <para style="pi1">
    <verse number="25" style="v" sid="NUM 33:25"/>तब ओमन हरादा ले चलके मखेलोत म डेरा डालिन।<verse eid="NUM 33:25"/></para>
  <para style="pi1">
    <verse number="26" style="v" sid="NUM 33:26"/>फेर ओमन मखेलोत ले चलके तहत म डेरा डालिन।<verse eid="NUM 33:26"/></para>
  <para style="pi1">
    <verse number="27" style="v" sid="NUM 33:27"/>तब ओमन तहत ले चलके तेरह म डेरा डालिन।<verse eid="NUM 33:27"/></para>
  <para style="pi1">
    <verse number="28" style="v" sid="NUM 33:28"/>फेर ओमन तेरह ले चलके मितका म डेरा डालिन।<verse eid="NUM 33:28"/></para>
  <para style="pi1">
    <verse number="29" style="v" sid="NUM 33:29"/>तब ओमन मितका ले चलके हसमोना म डेरा डालिन।<verse eid="NUM 33:29"/></para>
  <para style="pi1">
    <verse number="30" style="v" sid="NUM 33:30"/>फेर ओमन हसमोना ले चलके मोसेरोत म डेरा डालिन।<verse eid="NUM 33:30"/></para>
  <para style="pi1">
    <verse number="31" style="v" sid="NUM 33:31"/>तब ओमन मोसेरोत ले चलके बेने-जाकन म डेरा डालिन।<verse eid="NUM 33:31"/></para>
  <para style="pi1">
    <verse number="32" style="v" sid="NUM 33:32"/>फेर ओमन बेने-जाकन ले चलके होर-हग्गीदगाद म डेरा डालिन।<verse eid="NUM 33:32"/></para>
  <para style="pi1">
    <verse number="33" style="v" sid="NUM 33:33"/>तब ओमन होर-हग्गीदगाद ले चलके योतबाता म डेरा डालिन।<verse eid="NUM 33:33"/></para>
  <para style="pi1">
    <verse number="34" style="v" sid="NUM 33:34"/>फेर ओमन योतबाता ले चलके अबरोना म डेरा डालिन।<verse eid="NUM 33:34"/></para>
  <para style="pi1">
    <verse number="35" style="v" sid="NUM 33:35"/>ओमन अबरोना ले चलके एसियोन-गेबेर म डेरा डालिन।<verse eid="NUM 33:35"/></para>
  <para style="pi1">
    <verse number="36" style="v" sid="NUM 33:36"/>फेर ओमन एसियोन-गेबेर ले चलके सीन के सुन्ना जगह कादेस म डेरा डालिन।<verse eid="NUM 33:36"/></para>
  <para style="pi1">
    <verse number="37" style="v" sid="NUM 33:37"/>तब ओमन कादेस ले चलके एदोम के सीमना म होर पहाड़ करा डेरा डालिन। <verse eid="NUM 33:37"/><verse number="38" style="v" sid="NUM 33:38"/>यहोवा के हुकूम ले हारून पुरोहित ह होर पहाड़ ऊपर गीस, जिहां ओह मर गीस; ओकर मिरतू इसरायलीमन के मिसर देस ले निकले के चालीसवां साल के पांचवां महिना के पहिला दिन होईस। <verse eid="NUM 33:38"/><verse number="39" style="v" sid="NUM 33:39"/>जब हारून के मिरतू होर पहाड़ म होईस, त ओकर उमर एक सौ तेईस साल रिहिस।<verse eid="NUM 33:39"/></para>
  <para style="pi1">
    <verse number="40" style="v" sid="NUM 33:40"/>इही समय कनान के नेगेव म रहइया अराद के कनानी राजा ला पता चलिस कि इसरायलीमन आवत हें।<verse eid="NUM 33:40"/></para>
  <para style="pi1">
    <verse number="41" style="v" sid="NUM 33:41"/>इसरायलीमन होर पहाड़ ले चलके सलमोना म डेरा डालिन।<verse eid="NUM 33:41"/></para>
  <para style="pi1">
    <verse number="42" style="v" sid="NUM 33:42"/>ओमन सलमोना ले चलके पुनोन म डेरा डालिन।<verse eid="NUM 33:42"/></para>
  <para style="pi1">
    <verse number="43" style="v" sid="NUM 33:43"/>ओमन पुनोन ले चलके ओबोत म डेरा डालिन।<verse eid="NUM 33:43"/></para>
  <para style="pi1">
    <verse number="44" style="v" sid="NUM 33:44"/>फेर ओमन ओबोत ले चलके मोआब के सीमना म इये-अबारीम करा डेरा डालिन।<verse eid="NUM 33:44"/></para>
  <para style="pi1">
    <verse number="45" style="v" sid="NUM 33:45"/>फेर इये-अबारीम ले चलके दीबोन-गाद म डेरा डालिन।<verse eid="NUM 33:45"/></para>
  <para style="pi1">
    <verse number="46" style="v" sid="NUM 33:46"/>फेर ओमन दीबोन-गाद ले चलके अलमोन-दिबलातैम म डेरा डालिन।<verse eid="NUM 33:46"/></para>
  <para style="pi1">
    <verse number="47" style="v" sid="NUM 33:47"/>तब ओमन अलमोन-दिबलातैम ले चलके नबो के लकठा म अबारीम के पहाड़मन म डेरा डालिन।<verse eid="NUM 33:47"/></para>
  <para style="pi1">
    <verse number="48" style="v" sid="NUM 33:48"/>फेर ओमन अबारीम के पहाड़मन ले चलके यरीहो के ओ पार यरदन नदी के तीर मोआब के मैदान म डेरा डालिन। <verse eid="NUM 33:48"/><verse number="49" style="v" sid="NUM 33:49"/>उहां ओमन यरदन नदी के तीर बेत-यसीमोत ले लेके आबेल-सित्तीम तक मोआब के मैदान म डेरा डालिन।<verse eid="NUM 33:49"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50"/>यरीहो के ओ पार यरदन नदी के तीर मोआब के मैदान म यहोवा ह मूसा ला कहिस, <verse eid="NUM 33:50"/><verse number="51" style="v" sid="NUM 33:51"/>“इसरायलीमन ले बात कर अऊ ओमन ला कह: ‘जब तुमन यरदन नदी ला पार करके कनान देस म जावव, <verse eid="NUM 33:51"/><verse number="52" style="v" sid="NUM 33:52"/>त अपन आघू ले ओ देस के जम्मो निवासी ला भगा दव। ओमन के गढ़े, अऊ ढालके बनाय गय जम्मो मूरती ला नास कर दव, अऊ ओमन के जम्मो ऊंचहा जगहमन ला गिरा दव। <verse eid="NUM 33:52"/><verse number="53" style="v" sid="NUM 33:53"/>ओ देस ला अपन अधिकार म ले लव अऊ उहां बस जावव, काबरकि मेंह ओ देस तुमन ला अधिकार करे बर दे हवंव। <verse eid="NUM 33:53"/><verse number="54" style="v" sid="NUM 33:54"/>अपन गोत्र के मुताबिक चिट्ठी निकालके ओ देस ला बांट लेवव। बड़े दल ला बड़े भाग अऊ छोटे दल ला छोटे भाग देवव। चिट्ठी के मुताबिक जऊन भाग ओमन ला मिलथे, ओह ओमन के होही। अपन पुरखा के गोत्रमन के मुताबिक येला बांटव।<verse eid="NUM 33:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="NUM 33:55"/>“ ‘पर यदि तुमन ओ देस के निवासीमन ला निकाल नइं सकव, त ओमन म ले जेमन ला तुमन रहे बर दूहू, ओमन तुम्हर आंखीमन म कचरा अऊ तुम्हर पंजरामन म कांटा सहीं हो जाहीं। ओमन तुम्हर बर ओ देस म समस्या खड़े करहीं, जिहां तुमन रहिहू। <verse eid="NUM 33:55"/><verse number="56" style="v" sid="NUM 33:56"/>अऊ मेंह तुम्हर संग वइसने करहूं, जइसने ओमन बर करे के ठाने हंव।’ ”<verse eid="NUM 33:56"/></para>
  <chapter eid="NUM 33"/>
  <chapter number="34" style="c" sid="NUM 34"/>
  <para style="s1">कनान देस के सीमना</para>
  <para style="lh">
    <verse number="1" style="v" sid="NUM 34:1"/>यहोवा ह मूसा ला कहिस, <verse eid="NUM 34:1"/><verse number="2" style="v" sid="NUM 34:2"/>“इसरायलीमन ला हुकूम देके कह: ‘जब तुमन कनान देस म जावव, त जऊन भुइयां तुमन ला उत्तराधिकार के रूप म दिये जाही, ओकर ये सीमना होवय:<verse eid="NUM 34:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="NUM 34:3"/>“ ‘तुम्हर दक्खिन कोति सीन के सुन्ना जगह के कुछू भाग घलो होही, जऊन ह एदोम के सीमना ए। तुम्हर दक्खिनी सीमना ह पूरब म मिरतू सागर के दक्खिनी छोर ले सुरू होही, <verse eid="NUM 34:3"/><verse number="4" style="v" sid="NUM 34:4"/>अऊ अकरबीम चढ़ई के दक्खिन के पार सीन कोति आही अऊ कादेस-बरने नगर के दक्खिन तक जाही। तब येह हाजार-अद्दार तक जाके असमोन तक जाही, <verse eid="NUM 34:4"/><verse number="5" style="v" sid="NUM 34:5"/>असमोन ले मुड़के मिसर के नरवा म जुड़ जाही अऊ भूमध्य सागर म खतम होही।<verse eid="NUM 34:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 34:6"/>तुम्हर पछिमी सीमना ह भूमध्य सागर के किनारा होही। येह पछिम म तुम्हर सीमना होही।<verse eid="NUM 34:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 34:7"/>अपन उत्तरी सीमना बर, भूमध्य सागर ले होर पहाड़ तक एक लकीर खींचव <verse eid="NUM 34:7"/><verse number="8" style="v" sid="NUM 34:8"/>अऊ होर पहाड़ ले लेबो-हमात सहर तक ये लकीर जाही। तब सीमना ह सेदाद नगर तक जाही, <verse eid="NUM 34:8"/><verse number="9" style="v" sid="NUM 34:9"/>अऊ जिपरोन तक बढ़के हसर-एनान करा खतम होही। येह उत्तर म तुम्हर सीमना होही।<verse eid="NUM 34:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 34:10"/>अपन पूरब के सीमना बर, हसर-एनान ले सपाम तक एक लकीर खींचव। <verse eid="NUM 34:10"/><verse number="11" style="v" sid="NUM 34:11"/>सीमना ह सपाम ले खाल्हे ऐन के पूरब कोति रिबला तक जाही अऊ ढलान म बढ़त गलील<note caller="+" style="f"><char style="fr" closed="false">34:11 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">किन्नेरेत</char></note> समुंदर के पूरब तक जाही। <verse eid="NUM 34:11"/><verse number="12" style="v" sid="NUM 34:12"/>तब सीमना ह खाल्हे यरदन के तीरे-तीर जाही अऊ मिरतू सागर करा खतम होही।</para>
  <para style="b" vid="NUM 34:12"/>
  <para style="lf" vid="NUM 34:12">“ ‘चारों कोति अपन सीमना के संग येह तुम्हर देस होही।’ ”<verse eid="NUM 34:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13"/>मूसा ह इसरायलीमन ला हुकूम दीस: “चिट्ठी डारके ये देस ला बांटव, अऊ ओमन ला उत्तराधिकार के रूप म दे दव। यहोवा के हुकूम अय कि ये देस साढ़े नौ गोत्रमन ला दिये जावय, <verse eid="NUM 34:13"/><verse number="14" style="v" sid="NUM 34:14"/>काबरकि रूबेन के गोत्र, गाद के गोत्र अऊ मनस्से के आधा गोत्र के परिवारमन अपन उत्तराधिकार पा गे हवंय। <verse eid="NUM 34:14"/><verse number="15" style="v" sid="NUM 34:15"/>ये ढाई गोत्र के मनखेमन सूरज निकले के दिसा म, यरीहो के ओ पार, यरदन के पूरब म अपन उत्तराधिकार पा गे हवंय।”<verse eid="NUM 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16"/>फेर यहोवा ह मूसा ला कहिस, <verse eid="NUM 34:16"/><verse number="17" style="v" sid="NUM 34:17"/>“एलिआजर पुरोहित अऊ नून के बेटा यहोसू ओ मनखेमन के नांव अय, जेमन के ऊपर ये देस ला बांटके तुमन ला उत्तराधिकार म देय के जिम्मेदारी हवय। <verse eid="NUM 34:17"/><verse number="18" style="v" sid="NUM 34:18"/>अऊ हर एक गोत्र ले एक अगुवा ठहिरा, जेमन ये देस ला बांटे म मदद करहीं।<verse eid="NUM 34:18"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="19" style="v" sid="NUM 34:19"/>“ओमन के नांव ये अय:</para>
  <para style="b" vid="NUM 34:19"/>
  <para style="li1" vid="NUM 34:19">“यहूदा के गोत्र ले, यपुन्ने के बेटा कालेब;<verse eid="NUM 34:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 34:20"/>सिमोन के गोत्र ले, अमीहूद के बेटा समूएल;<verse eid="NUM 34:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="NUM 34:21"/>बिनयामीन के गोत्र ले, किसलोन के बेटा एलीदाद;<verse eid="NUM 34:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 34:22"/>दान के गोत्र ले, योगली के बेटा बुक्की ह अगुवा रिहिस;<verse eid="NUM 34:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 34:23"/>यूसुफ के बेटा मनस्से के गोत्र ले, एपोद के बेटा हन्नीएल ह अगुवा रिहिस;<verse eid="NUM 34:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 34:24"/>यूसुफ के बेटा एपरैम के गोत्र ले, सिपतान के बेटा कमूएल ह अगुवा रिहिस;<verse eid="NUM 34:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 34:25"/>जबूलून के गोत्र ले, परनाक के बेटा एलीसापान ह अगुवा रिहिस;<verse eid="NUM 34:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 34:26"/>इस्साकार के गोत्र ले, अज्जान के बेटा पलतीएल ह अगुवा रिहिस;<verse eid="NUM 34:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 34:27"/>आसेर के गोत्र ले, सलोमी के बेटा अहीहूद ह अगुवा रिहिस;<verse eid="NUM 34:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 34:28"/>अऊ नपताली के गोत्र ले, अमीहूद के बेटा पदहेल ह अगुवा रिहिस।”<verse eid="NUM 34:28"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="29" style="v" sid="NUM 34:29"/>येमन ओ मनखे अंय, जेमन ला यहोवा ह कनान देस म इसरायलीमन ला उत्तराधिकार बांटे के हुकूम दीस।<verse eid="NUM 34:29"/></para>
  <chapter eid="NUM 34"/>
  <chapter number="35" style="c" sid="NUM 35"/>
  <para style="s1">लेवीमन ला दिये गे नगर</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1"/>यरीहो के ओ पार, यरदन नदी के तीर, मोआब के मैदान म यहोवा ह मूसा ला कहिस, <verse eid="NUM 35:1"/><verse number="2" style="v" sid="NUM 35:2"/>“इसरायलीमन ला हुकूम दे कि ओमन अपन उत्तराधिकार म पाय नगरमन ले कुछू नगर लेवीमन ला देवंय। अऊ ओमन ला नगर के चारों कोति के चरागन घलो देवंय। <verse eid="NUM 35:2"/><verse number="3" style="v" sid="NUM 35:3"/>तब ओमन करा रहे बर नगर अऊ गाय-बईला, भेड़-बकरी अऊ ओमन के आने जम्मो पसु बर चरागन होही।<verse eid="NUM 35:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 35:4"/>“नगरमन के चारों कोति जऊन चरागन तेंह लेवीमन ला देबे, ओ चरागनमन के फईलाव नगर के दीवार ले एक हजार क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">35:4 </char><char style="ft" closed="false">लगभग 450 मीटर</char></note> तक होवय। <verse eid="NUM 35:4"/><verse number="5" style="v" sid="NUM 35:5"/>नगर के बाहिर, पूरब कोति दू हजार क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">35:5 </char><char style="ft" closed="false">लगभग 900 मीटर</char></note>, दक्खिन कोति दू हजार क्यूबीट, पछिम कोति दू हजार क्यूबीट अऊ उत्तर कोति दू हजार क्यूबीट नापव अऊ नगर ह मांझा म रहय। ओमन करा ये जगह नगर म चरागन के रूप म होही।<verse eid="NUM 35:5"/></para>
  <para style="s1">सरन लेय के सहर</para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6"/>“लेवीमन ला तेंह जऊन सहरमन ला देबे, ओमा के छै ठन सहरमन सरन लेय के सहर होहीं, अऊ येमा ओ मनखे ह भागके जा सकथे, जऊन ह कोनो ला मार डारे हवय। येकर छोंड़, ओमन ला अऊ बियालीस सहर देबे। <verse eid="NUM 35:6"/><verse number="7" style="v" sid="NUM 35:7"/>तेंह लेवीमन ला कुल मिलाके अड़तालीस ठन नगर ओमन के चरागन सहित देबे। <verse eid="NUM 35:7"/><verse number="8" style="v" sid="NUM 35:8"/>इसरायलीमन के अधिकार के देस म ले जऊन नगर तेंह लेवीमन ला देबे, ओ नगरमन गोत्र के मुताबिक उत्तराधिकार के अनुपात म दिये जावंय: जऊन गोत्र के जादा नगर हवंय, ओकर ले जादा, पर जऊन गोत्र के कम नगर हवंय, ओकर ले कम नगर लेबे।”<verse eid="NUM 35:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9"/>तब यहोवा ह मूसा ला कहिस: <verse eid="NUM 35:9"/><verse number="10" style="v" sid="NUM 35:10"/>“इसरायलीमन ले बात कर अऊ ओमन ला कह: ‘जब तुमन यरदन पार करके कनान देस म जावव, <verse eid="NUM 35:10"/><verse number="11" style="v" sid="NUM 35:11"/>तब कुछू नगरमन ला अपन सरन लेय के नगर के रूप म चुनव, जिहां ओ मनखे ह भागके जा सकथे, जऊन ह कोनो ला अनजाने म मार डारे हवय। <verse eid="NUM 35:11"/><verse number="12" style="v" sid="NUM 35:12"/>ओ नगरमन बदला लेवइया मनखे ले सरन के जगह होहीं, ताकि सभा के आघू म जांच होय के पहिली ओला झन मार डारे जावय। <verse eid="NUM 35:12"/><verse number="13" style="v" sid="NUM 35:13"/>ये छै ठन नगर जेला तुमन दूहू, येमन तुम्हर सरन लेय के सहर होहीं। <verse eid="NUM 35:13"/><verse number="14" style="v" sid="NUM 35:14"/>तीन सहर यरदन के ये पार अऊ तीन सहर कनान देस म सरन लेय के सहर के रूप म दव। <verse eid="NUM 35:14"/><verse number="15" style="v" sid="NUM 35:15"/>ये छै नगर इसरायली अऊ ओमन के बीच रहइया परदेसीमन बर सरन लेय के जगह होहीं, ताकि कोनो मनखे अनजाने म कोनो आने मनखे ला मार डारथे, त ओह उहां भागके जा सकय।<verse eid="NUM 35:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16"/>“ ‘यदि कोनो मनखे आने मनखे ला लोहा के चीज ले अइसे मारथे कि ओह मर जाथे, त ओ मनखे ह हतियारा अय; अऊ ओ हतियारा ला मार डारे जावय। <verse eid="NUM 35:16"/><verse number="17" style="v" sid="NUM 35:17"/>या यदि कोनो मनखे पथरा लेके कोनो आने मनखे ला अइसे चोट पहुंचाथे कि ओह मर जाथे, त ओ मनखे ह हतियारा अय; ओला मार डारे जावय। <verse eid="NUM 35:17"/><verse number="18" style="v" sid="NUM 35:18"/>या कोनो मनखे ह लकड़ी के कोनो चीज धरे हवय अऊ ओकर ले कोनो आने मनखे ला अइसे मारथे कि ओह मर जाथे, त ओ मनखे ह हतियारा अय; ओला मार डारे जावय। <verse eid="NUM 35:18"/><verse number="19" style="v" sid="NUM 35:19"/>खून के बदला लेवइया ह ओ हतियारा ला मार डारय; जब भी बदला लेवइया ह हतियारा ला देखथे, त ओ बदला लेवइया ह हतियारा ला मार डारय। <verse eid="NUM 35:19"/><verse number="20" style="v" sid="NUM 35:20"/>यदि कोनो मनखे जलन के कारन कोनो आने मनखे ला ढकेल देथे या जानबूझके ओकर ऊपर कोनो चीज फेंकथे, जेकर से ओह मर जाथे <verse eid="NUM 35:20"/><verse number="21" style="v" sid="NUM 35:21"/>या यदि बईरता के कारन एक मनखे ह कोनो आने मनखे ला मुक्का मारथे, जेकर से ओह मर जाथे, त ओ मुक्का मारनेवाला मनखे ह मार डारे जावय; ओ मनखे ह एक हतियारा अय। जब भी खून के बदला लेवइया ह हतियारा ले मिलय, त ओ बदला लेवइया ह ओला मार डारय।<verse eid="NUM 35:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22"/>“ ‘पर यदि बिगर बईरता के कोनो मनखे कोनो ला धक्का देथे या अनजाने म ओकर ऊपर कुछू चीज ला फेंकथे <verse eid="NUM 35:22"/><verse number="23" style="v" sid="NUM 35:23"/>या ओला बिगर देखे ओकर ऊपर कोनो भारी पथरा गिरा देथे, जेकर से आने मनखे ह मर जाथे, त जब ओ आने मनखे ह कोनो बईरी नइं रिहिस अऊ चोट पहुंचाय के कोनो इरादा नइं रिहिस, <verse eid="NUM 35:23"/><verse number="24" style="v" sid="NUM 35:24"/>तब सभा ह ये मामला म मारइया अऊ खून के पलटा लेवइया के बीच ये नियम के मुताबिक नियाय करय। <verse eid="NUM 35:24"/><verse number="25" style="v" sid="NUM 35:25"/>सभा ह हतिया के दोसी मनखे ला खून के पलटा लेवइया मनखे ले बचावय अऊ दोसी मनखे ला सरन लेय के सहर म वापिस पठो दे, जिहां ओह भागके गे रिहिस। दोसी मनखे ह उहां तब तक रहय, जब तक कि पबितर तेल ले अभिसेक करे गय ओ समय के महा पुरोहित के मिरतू न हो जाय।<verse eid="NUM 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26"/>“ ‘पर यदि दोसी मनखे ह ओ सरन लेय के सहर के सीमना ले बाहिर जाथे, जिहां ओह भागके गे हवय <verse eid="NUM 35:26"/><verse number="27" style="v" sid="NUM 35:27"/>अऊ खून के बदला लेवइया ह ओला नगर के बाहिर पाथे, त खून के बदला लेवइया ह दोसी मनखे ला मार सकथे अऊ हतिया के दोसी नइं होवय। <verse eid="NUM 35:27"/><verse number="28" style="v" sid="NUM 35:28"/>जरूरी अय कि दोसी मनखे ह महा पुरोहित के मिरतू तक सरन लेय के सहर म रहय; सिरिप महा पुरोहित के मिरतू के बाद ही ओह अपन खुद के संपत्ति म लहुंट सकथे।<verse eid="NUM 35:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29"/>“ ‘जिहां कहूं भी तुमन रहव, येह तुम्हर पीढ़ी-पीढ़ी तक कानून बने रहय।<verse eid="NUM 35:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30"/>“ ‘जऊन मनखे ह कोनो आने मनखे ला मार डारथे, त ओह सिरिप गवाहमन के गवाही के आधार म ही हतियारा के रूप म मार डारे जावय। पर कोनो भी मनखे एक गवाह के गवाही के आधार म झन मार डारे जावय।<verse eid="NUM 35:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 35:31"/>“ ‘कोनो हतियारा, जऊन ह मिरतू के दोसी हवय, ओकर जिनगी के बदले कोनो किसम के धन झन लेवव। ओह मार डारे जावय।<verse eid="NUM 35:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 35:32"/>“ ‘जऊन ह सरन लेय के सहर म भाग गे हवय, ओकर बर कोनो किसम के छुड़ौती के धन स्वीकार झन करव कि ओह महा पुरोहित के मिरतू के पहिले वापिस जाके अपन देस म रह सकय।<verse eid="NUM 35:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 35:33"/>“ ‘ओ देस ला असुध झन करव, जिहां तुमन रहत हव। खून करई ह देस ला असुध कर देथे, अऊ ओ देस बर पछताप नइं करे जा सकय, जिहां खून बहाय गे हवय; पछताप सिरिप ओ मनखे के खून के दुवारा होथे, जऊन ह खून बहाय हवय। <verse eid="NUM 35:33"/><verse number="34" style="v" sid="NUM 35:34"/>ओ देस ला असुध झन करव, जिहां तुमन रहिथव अऊ जिहां मेंह रहिथंव, काबरकि में यहोवा ह इसरायलीमन के बीच रहिथंव।’ ”<verse eid="NUM 35:34"/></para>
  <chapter eid="NUM 35"/>
  <chapter number="36" style="c" sid="NUM 36"/>
  <para style="s1">सलोफाद के बेटीमन के उत्तराधिकार</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1"/>तब गिलाद, जऊन ह माकीर के बेटा अऊ मनस्से के पोता रिहिस, ओकर गोत्र के परिवार के मुखियामन यूसुफ के संतानमन के गोत्र म ले रिहिन; ये मुखियामन आईन अऊ मूसा अऊ अगुवामन के आघू म याने कि इसरायली परिवार के मुखियामन के आघू म कहे लगिन, <verse eid="NUM 36:1"/><verse number="2" style="v" sid="NUM 36:2"/>“जब यहोवा ह हमर मालिक ला चिट्ठी के दुवारा इसरायलीमन ला देस म उत्तराधिकार देय के हुकूम दीस, त ओह ये हुकूम देय रिहिस कि हमर भाई सलोफाद के उत्तराधिकार ओकर बेटीमन ला दिये जावय।<note caller="+" style="f"><char style="fr" closed="false">36:2 </char><char style="ft" closed="false"><char style="xt"><ref loc="NUM 27:1-11">गन 27:1‑11</ref></char></char></note> <verse eid="NUM 36:2"/><verse number="3" style="v" sid="NUM 36:3"/>यदि ओमन कोनो आने इसरायली गोत्र के मनखे ले बिहाव करथें, त फेर ओमन के उत्तराधिकार ह हमर पुरखामन के भाग ले, ले लिये जाही अऊ ओ गोत्र म मिला दिये जाही, जेमा ओमन के बिहाव होही। अऊ ये किसम ले हमन ला मिले उत्तराधिकार के एक भाग ह ले लिये जाही। <verse eid="NUM 36:3"/><verse number="4" style="v" sid="NUM 36:4"/>जब इसरायलीमन के जुबली बछर ह आही, त ओमन<note caller="+" style="f"><char style="fr" closed="false">36:4 </char><char style="ft" closed="false">ओमन </char><char style="fqa" closed="false">सलोफाद के बेटीमन</char></note> के उत्तराधिकार ह ओ गोत्र म मिला दिये जाही, जेमा ओमन के बिहाव होथे, अऊ ओमन के संपत्ति ह हमर पुरखामन के गोत्र के उत्तराधिकार ले लेय लिये जाही।”<verse eid="NUM 36:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5"/>तब यहोवा ले हुकूम पाके मूसा ह इसरायलीमन ला ये हुकूम दीस: “यूसुफ के संतान के गोत्र के मनखेमन जऊन बात कहत हें, ओह सही ए। <verse eid="NUM 36:5"/><verse number="6" style="v" sid="NUM 36:6"/>सलोफाद के बेटीमन के बारे म यहोवा ह ये हुकूम दे हवय: ओमन अपन ईछा ले अपन ददा के गोत्र म ले ही कोनो पुरूस ले बिहाव कर सकथें। <verse eid="NUM 36:6"/><verse number="7" style="v" sid="NUM 36:7"/>इसरायल म कोनो भी उत्तराधिकार एक गोत्र ले आने गोत्र म झन जावय, काबरकि हर एक इसरायली ह अपन पुरखा के गोत्र के उत्तराधिकार ला बनाय रखही। <verse eid="NUM 36:7"/><verse number="8" style="v" sid="NUM 36:8"/>हर ओ बेटी, जऊन ह कोनो इसरायली जाति म उत्तराधिकार पाथे, त ओकर बर जरूरी अय कि ओह अपन ददा के जाति के गोत्र के कोनो पुरूस ले ही बिहाव करय, ताकि हर एक इसरायली ह अपन पुरखामन के उत्तराधिकार बनाय रखय। <verse eid="NUM 36:8"/><verse number="9" style="v" sid="NUM 36:9"/>कोनो भी उत्तराधिकार एक गोत्र ले आने गोत्र म झन जावय, काबरकि हर एक इसरायली ह उत्तराधिकार म मिले भाग ला बनाय रखय।”<verse eid="NUM 36:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10"/>सलोफाद के बेटीमन मूसा ला दिये गय यहोवा के हुकूम मुताबिक ही करिन। <verse eid="NUM 36:10"/><verse number="11" style="v" sid="NUM 36:11"/>सलोफाद के बेटीमन के नांव महला, तिरसा, होगला, मिलका अऊ नोआ रिहिस अऊ येमन अपन चचेरा-भाईमन ले बिहाव कर लीन। <verse eid="NUM 36:11"/><verse number="12" style="v" sid="NUM 36:12"/>ओमन यूसुफ के बेटा मनस्से के संतान के गोत्र म बिहाव करिन, अऊ ओमन के उत्तराधिकार ह ओमन के ददा के जाति अऊ गोत्र म बने रिहिस।<verse eid="NUM 36:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13"/>येमन ओ हुकूम अऊ नियम अंय, जेला यहोवा ह मूसा के जरिये इसरायलीमन ला यरीहो के ओ पार यरदन नदी के तीर मोआब के मैदान म दीस।<verse eid="NUM 36:13"/></para>
  <chapter eid="NUM 36"/>
</usx>
