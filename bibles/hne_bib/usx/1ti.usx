<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">1 तीमुथियुस</para>
  <para style="toc1">तीमुथियुस के नांव पौलुस के पहिली चिट्ठी</para>
  <para style="toc2">1 तीमुथियुस</para>
  <para style="toc3">1 तीमु</para>
  <para style="mt1">तीमुथियुस</para>
  <para style="mt2">के नांव पौलुस के पहिली चिट्ठी</para>
  <chapter number="1" style="c" sid="1TI 1"/>
  <para style="po">
    <verse number="1" style="v" sid="1TI 1:1"/>में, पौलुस ह हमर उद्धार करइया परमेसर अऊ हमर आसा मसीह यीसू के हुकूम ले मसीह यीसू के प्रेरित अंव,<verse eid="1TI 1:1"/></para>
  <para style="po">
    <verse number="2" style="v" sid="1TI 1:2"/>बिसवास म मोर पक्का बेटा तीमुथियुस, तोला मेंह ये चिट्ठी लिखत हवंव:</para>
  <para style="po" vid="1TI 1:2">हमर ददा परमेसर अऊ हमर परभू मसीह यीसू ले तोला अनुग्रह, दया अऊ सांति मिलत रहय।<verse eid="1TI 1:2"/></para>
  <para style="s1">कानून के लबरा गुरूमन के बिरोध म चेतउनी</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3"/>जइसने कि मेंह मकिदुनिया जावत बेरा तोर ले बिनती करे रहेंव कि तें इफिसुस म रहिके ओ कुछू मनखेमन ला हुकूम दे कि ओमन गलत बात झन सिखोवंय, <verse eid="1TI 1:3"/><verse number="4" style="v" sid="1TI 1:4"/>अऊ न ही ओमन कथा-कहानी अऊ अन्तहीन बंसावलीमन म मन लगावंय, जेकर ले बिवाद होथे। अइसने बात ले परमेसर के काम, जऊन ह बिसवास म अधारित हवय, नइं होवय। <verse eid="1TI 1:4"/><verse number="5" style="v" sid="1TI 1:5"/>ये हुकूम के उदेस्य ह मया अय, जऊन ह साफ मन, बने बिबेक अऊ निस्कपट बिसवास ले पईदा होथे। <verse eid="1TI 1:5"/><verse number="6" style="v" sid="1TI 1:6"/>कुछू मनखेमन ये बातमन ले भटकके बेकार के बात म मन लगाय हवंय। <verse eid="1TI 1:6"/><verse number="7" style="v" sid="1TI 1:7"/>ओमन चाहत हवंय कि मनखेमन ओमन ला मूसा के कानून के गुरू के रूप म जानंय, पर ओमन अपनेच बातमन ला नइं समझंय या ओ बात ला नइं जानंय, जेकर बारे म ओमन बहुंत जोर देके गोठियाथें।<verse eid="1TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8"/>हमन जानत हन कि मूसा के कानून ह बने ए, यदि मनखे ह ओकर सही उपयोग करय त। <verse eid="1TI 1:8"/><verse number="9" style="v" sid="1TI 1:9"/>हमन ये घलो जानत हन कि कानून ह बने मनखेमन बर नो हय, पर येह कानून टोरइया, निरंकुस, भक्तिहीन, पापी, अपबितर मनखे अऊ अधरमी, दाई-ददा के हतिया करइया, हतियारा, <verse eid="1TI 1:9"/><verse number="10" style="v" sid="1TI 1:10"/>छिनारी करइया, बेभिचारी, गुलाममन ला बेचइया या बिसोइया, लबरा अऊ लबरा गवाही देवइया अऊ सही उपदेस के बिरोध करइयामन बर अय। <verse eid="1TI 1:10"/><verse number="11" style="v" sid="1TI 1:11"/>एहीच ह परमधन्य परमेसर के महिमामय सुघर संदेस के मुताबिक ए, जऊन ला मोला सऊंपे गे हवय।<verse eid="1TI 1:11"/></para>
  <para style="s1">पौलुस ऊपर परभू के अनुग्रह</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12"/>मेंह अपन परभू मसीह यीसू के धनबाद करत हंव, जऊन ह मोला ताकत दे हवय अऊ मोला बिसवास के लईक समझके अपन सेवा बर ठहिराय हवय। <verse eid="1TI 1:12"/><verse number="13" style="v" sid="1TI 1:13"/>मेंह तो पहिली ओकर निन्दा करइया, अतियाचारी अऊ ओकर बेजत्ती करइया रहेंव, तभो ले परमेसर के दया मोर ऊपर होईस काबरकि मेंह ये जम्मो ला नासमझी अऊ अबिसवास म करेंव। <verse eid="1TI 1:13"/><verse number="14" style="v" sid="1TI 1:14"/>हमर परभू के अनुग्रह, ओ बिसवास अऊ मया के संग, जऊन ह मसीह यीसू म हवय, मोर ऊपर बहुंत अकन होईस।<verse eid="1TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15"/>ये बात सच ए अऊ पूरा माने अऊ बिसवास करे के लईक अय कि मसीह यीसू ह ये संसार म पापीमन के उद्धार करे बर आईस, जेमा सबले बड़े पापी मेंह अंव। <verse eid="1TI 1:15"/><verse number="16" style="v" sid="1TI 1:16"/>पर मोर ऊपर एकरसेति दया होईस कि मोर म, जऊन ह कि सबले बड़े पापी अंव, मसीह यीसू ह अपन पूरा सहनसीलता देखावय, ताकि जऊन मनखेमन मसीह ऊपर बिसवास करहीं अऊ परमेसर के संग सदाकाल के जिनगी पाहीं, ओमन बर मेंह एक नमूना बनंव। <verse eid="1TI 1:16"/><verse number="17" style="v" sid="1TI 1:17"/>सदाकाल के राजा, अबिनासी, अनदेखे, सिरिप एकेच परमेसर के आदर अऊ महिमा जुग-जुग होवत रहय। आमीन।<verse eid="1TI 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18"/>हे बेटा तीमुथियुस, ओ अगम बात के मुताबिक, जऊन ह पहिली तोर बारे म कहे गे रिहिस, मेंह तोला ये हुकूम देवत हंव कि ओकर मुताबिक सही जिनगी म चलत रह, <verse eid="1TI 1:18"/><verse number="19" style="v" sid="1TI 1:19"/>अऊ बिसवास अऊ सही बिबेक म बने रह। कुछू मनखेमन येला नइं मानिन अऊ एकरसेति ओमन के बिसवास ह खतम हो गीस। <verse eid="1TI 1:19"/><verse number="20" style="v" sid="1TI 1:20"/>ओमन म हुमिनयुस अऊ सिकन्दर अंय, जेमन ला मेंह सैतान ला सऊंप दे हवंव, ताकि ओमन सीखंय अऊ परमेसर के निन्दा झन करंय।<verse eid="1TI 1:20"/></para>
  <chapter eid="1TI 1"/>
  <chapter number="2" style="c" sid="1TI 2"/>
  <para style="s1">अराधना के बारे म निरदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1"/>एकरसेति, सबले पहिली ये अनुरोध करत हंव कि बिनती, पराथना, निबेदन अऊ धनबाद जम्मो मनखे बर करे जावय— <verse eid="1TI 2:1"/><verse number="2" style="v" sid="1TI 2:2"/>राजा अऊ जम्मो ऊंच पद के मनखे बर ये करे जावय, ताकि हमन सांत अऊ सुख के जिनगी भक्ति अऊ पबितरता के संग जीयन। <verse eid="1TI 2:2"/><verse number="3" style="v" sid="1TI 2:3"/>येह बने बात ए अऊ येह हमर उद्धार करइया परमेसर ला भाथे। <verse eid="1TI 2:3"/><verse number="4" style="v" sid="1TI 2:4"/>ओह चाहथे कि जम्मो मनखेमन के उद्धार होवय अऊ ओमन सत के गियान ला जानंय। <verse eid="1TI 2:4"/><verse number="5" style="v" sid="1TI 2:5"/>काबरकि सिरिप एके परमेसर हवय अऊ परमेसर अऊ मनखेमन के बीच म एकेच बिचवई हवय, याने ओ मनखे मसीह यीसू, <verse eid="1TI 2:5"/><verse number="6" style="v" sid="1TI 2:6"/>जऊन ह जम्मो मनखेमन के पाप के छुटकारा खातिर अपनआप ला दे दीस अऊ ये गवाही ह ठीक समय म दिये गीस। <verse eid="1TI 2:6"/><verse number="7" style="v" sid="1TI 2:7"/>मेंह सच कहत हंव, लबारी नइं मारत हंव। एकरे खातिर, मेंह सुघर संदेस के परचारक, प्रेरित अऊ आनजातमन बर एक सच्चा अऊ बिसवासयोग्य गुरू ठहिराय गे हवंव।<verse eid="1TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8"/>एकरसेति मेंह चाहत हंव कि जम्मो जगह मनखेमन बिगर गुस्सा या बिवाद के, पबितरता के संग अपन हांथ ऊपर उठाके पराथना करंय। <verse eid="1TI 2:8"/><verse number="9" style="v" sid="1TI 2:9"/>मेंह ये घलो चाहत हंव कि माईलोगनमन संकोच अऊ बने आचरन के संग ठीक से कपड़ा पहिरंय, न कि बाल गुंथके या सोन या मोती या मंहगा कपड़ा ले अपनआप ला संवारंय, <verse eid="1TI 2:9"/><verse number="10" style="v" sid="1TI 2:10"/>पर भलई के काम करंय, जइसने कि ओ माईलोगनमन ला सोभा देथे, जऊन मन परमेसर के अराधना करे के घोसना करथें।<verse eid="1TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11"/>माईलोगन<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">घरवाली</char></note> ला चुपेचाप अऊ पूरा अधीनता म रहिके सीखना चाही। <verse eid="1TI 2:11"/><verse number="12" style="v" sid="1TI 2:12"/>मेंह कोनो माईलोगन ला ये अनुमति नइं देवंव कि ओह सिखोय या मरद<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओकर घरवाला</char></note> के ऊपर अधिकार रखय, पर ओह एकदम चुपेचाप रहय। <verse eid="1TI 2:12"/><verse number="13" style="v" sid="1TI 2:13"/>काबरकि आदम ह पहिली बनाय गीस अऊ ओकर बाद हवा बनाय गीस। <verse eid="1TI 2:13"/><verse number="14" style="v" sid="1TI 2:14"/>अऊ आदम ह बहकाय नइं गीस, पर माईलोगन ह बहकाय गीस अऊ पापिन बनिस। <verse eid="1TI 2:14"/><verse number="15" style="v" sid="1TI 2:15"/>पर माईलोगनमन लइका जने के दुवारा उद्धार पाहीं, यदि ओमन बने आचरन के संग बिसवास, मया अऊ पबितरता म बने रहंय।<verse eid="1TI 2:15"/></para>
  <chapter eid="1TI 2"/>
  <chapter number="3" style="c" sid="1TI 3"/>
  <para style="s1">पास्टर अऊ डीकन</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1"/>ए बात सही ए: कहूं कोनो मनखे पास्टर बने चाहथे, त ओह बहुंत बढ़िया काम करे के ईछा करथे। <verse eid="1TI 3:1"/><verse number="2" style="v" sid="1TI 3:2"/>पास्टर ला बिलकुल निरदोस होना चाही। ओकर सिरिप एकेच घरवाली होवय। ओह संयमी, सुसील, सभ्य, पहुनई करइया अऊ बने गुरू होवय। <verse eid="1TI 3:2"/><verse number="3" style="v" sid="1TI 3:3"/>ओह पियक्कड़ या मारपीट करइया झन होवय, पर नम्र सुभाव के होवय। ओह न झगरा करइया अऊ न रूपिया-पईसा के लोभी होवय। <verse eid="1TI 3:3"/><verse number="4" style="v" sid="1TI 3:4"/>ओह अपन परिवार के सुघर परबंध करइया होवय, अऊ ओह ये देखय कि ओकर लइकामन पूरा आदरमान के संग ओकर बात मानंय। <verse eid="1TI 3:4"/><verse number="5" style="v" sid="1TI 3:5"/>(कहूं कोनो अपन खुद के परिवार के परबंध नइं कर सकय, त फेर ओह परमेसर के कलीसिया के खियाल कइसने रख सकथे?) <verse eid="1TI 3:5"/><verse number="6" style="v" sid="1TI 3:6"/>ओह नवां मसीही झन होवय, नइं तो ओला घमंड हो सकथे अऊ सैतान के सहीं दंड पा सकथे। <verse eid="1TI 3:6"/><verse number="7" style="v" sid="1TI 3:7"/>कलीसिया के बाहिर के मनखेमन म घलो ओकर बने नांव होना चाही, ताकि ओकर निन्दा झन होवय अऊ ओह सैतान के फांदा म झन फंसय।<verse eid="1TI 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8"/>एही किसम ले, डीकनमन ला घलो आदर के लईक होना चाही। ओमन ईमानदार होवंय अऊ पियक्कड़ अऊ नीच कमई के लोभी झन होवंय। <verse eid="1TI 3:8"/><verse number="9" style="v" sid="1TI 3:9"/>ओमन बिसवास के गहिरा सच ला सही बिबेक के संग थामे रहंय। <verse eid="1TI 3:9"/><verse number="10" style="v" sid="1TI 3:10"/>ओमन पहिली जरूर परखे जावंय अऊ यदि निरदोस निकलंय, त ओमन डीकन के रूप म सेवा करंय।<verse eid="1TI 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11"/>ओही किसम ले, डीकनमन के घरवालीमन<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">यूनानी भासा के सबद “गुनाइका” (डीकन के घरवाली) के मतलब “माईलोगन” या “घरवाली” हो सकथे।</char></note> ला घलो आदर के लईक होना चाही। ओमन बक-बक करइया झन होवंय, पर संयमी अऊ जम्मो बात म बिसवास के लईक होवंय।<verse eid="1TI 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12"/>डीकन के सिरिप एक घरवाली होवय अऊ ओह अपन लइकामन के अऊ घर के सुघर परबंध करय। <verse eid="1TI 3:12"/><verse number="13" style="v" sid="1TI 3:13"/>जऊन मन बने सेवा करे हवंय, ओमन बने आदरमान पाथें अऊ मसीह यीसू म अपन बिसवास के दुवारा भरोसा के लईक समझे जाथें।<verse eid="1TI 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14"/>हालाकि मेंह तोर करा जल्दी आय के आसा करत हंव, तभो ले तोला ये बात लिखत हवंव, <verse eid="1TI 3:14"/><verse number="15" style="v" sid="1TI 3:15"/>ताकि कहूं मोर आय म देरी होवय, त तोला जानकारी होना चाही कि मनखेमन परमेसर के घराना म कइसने बरताव करंय अऊ ये परिवार ह जीयत परमेसर के कलीसिया ए, अऊ येह सच्चई के खंभा अऊ नीव ए। <verse eid="1TI 3:15"/><verse number="16" style="v" sid="1TI 3:16"/>ये बात म कोनो संका नइं ए कि परमेसर के भक्ति के भेद ह महान ए:</para>
  <para style="q1" vid="1TI 3:16">ओह मनखे के रूप म परगट होईस,</para>
  <para style="q2" vid="1TI 3:16">पबितर आतमा के दुवारा साबित करे गीस,</para>
  <para style="q1" vid="1TI 3:16">स्वरगदूतमन ला दिखाई दीस,</para>
  <para style="q2" vid="1TI 3:16">जाति-जाति म ओकर परचार होईस,</para>
  <para style="q1" vid="1TI 3:16">जम्मो संसार म मनखेमन ओकर ऊपर बिसवास करिन,</para>
  <para style="q2" vid="1TI 3:16">अऊ ओह महिमा म स्वरग ऊपर उठा लिये गीस।<verse eid="1TI 3:16"/></para>
  <chapter eid="1TI 3"/>
  <chapter number="4" style="c" sid="1TI 4"/>
  <para style="s1">तीमुथियुस ला निरदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1"/>पबितर आतमा ह साफ-साफ कहिथे कि अवइया समय म कुछू मनखेमन बिसवास ला छोंड़ दीहीं अऊ धोखा देवइया आतमा अऊ परेत आतमामन के सिखोय बात ला मानहीं। <verse eid="1TI 4:1"/><verse number="2" style="v" sid="1TI 4:2"/>ये बातमन ढोंगी मनखेमन ले आथे, जऊन मन लबारी मारथें अऊ जेमन के बिबेक ह मर गे हवय, मानो ओह गरम लोहा ले दागे गे हवय। <verse eid="1TI 4:2"/><verse number="3" style="v" sid="1TI 4:3"/>ओमन मनखेमन ला बिहाव करे बर मना करथें अऊ कुछू खाय के चीजमन ला खाय बर मना करथें जऊन ला परमेसर ह एकरसेति बनाईस कि सत ला जाननेवाला बिसवासीमन, ये भोजन-बस्तु बर धनबाद के पराथना करंय अऊ ओला खावंय। <verse eid="1TI 4:3"/><verse number="4" style="v" sid="1TI 4:4"/>परमेसर के बनाय हर चीज ह बने ए, अऊ कोनो घलो चीज अस्वीकार करे के लईक नो हय, यदि ओला परमेसर ला धनबाद देके खाय जाथे। <verse eid="1TI 4:4"/><verse number="5" style="v" sid="1TI 4:5"/>काबरकि ओह परमेसर के बचन अऊ पराथना के दुवारा सुध हो जाथे।<verse eid="1TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6"/>कहूं तेंह बिसवासी भाईमन ला ये बातमन के सुरता कराथस, त तेंह मसीह यीसू के बने सेवक बनबे, जइसने कि तेंह परमेसर के बचन के बिसवास म पले-बढ़े अऊ सही सिकछा म चले हवस। <verse eid="1TI 4:6"/><verse number="7" style="v" sid="1TI 4:7"/>अपनआप ला अधरमी अऊ डोकरीमन के कथा-कहानी ले दूरिहा रख अऊ अपनआप ला आतमिक बात म अनुसासित कर। <verse eid="1TI 4:7"/><verse number="8" style="v" sid="1TI 4:8"/>सारीरिक कसरत करे ले कुछू फायदा होथे, पर भक्ति के साधना ले जम्मो बात म फायदा होथे, काबरकि येह ये जिनगी अऊ अवइया जिनगी दूनों के वायदा करथे। <verse eid="1TI 4:8"/><verse number="9" style="v" sid="1TI 4:9"/>ये बात सच ए अऊ हर किसम ले माने अऊ बिसवास करे के लईक ए। <verse eid="1TI 4:9"/><verse number="10" style="v" sid="1TI 4:10"/>एकरसेति हमन मेहनत अऊ संघर्स करथन, काबरकि हमर आसा ओ जीयत परमेसर ऊपर हवय, जऊन ह जम्मो मनखेमन के, अऊ बिसेस करके बिसवासीमन के उद्धार करइया अय।<verse eid="1TI 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11"/>ये बातमन के हुकूम दे अऊ सिखोय कर। <verse eid="1TI 4:11"/><verse number="12" style="v" sid="1TI 4:12"/>अइसने कर कि कोनो मनखे तोर जवानी के कारन, तोला तुछ झन समझय, पर बिसवासीमन खातिर अपन गोठ-बात, अपन जिनगी, अपन मया, बिसवास अऊ सुधता के दुवारा एक नमूना पेस कर। <verse eid="1TI 4:12"/><verse number="13" style="v" sid="1TI 4:13"/>जब तक मेंह नइं आ जावंव, तब तक अपनआप ला मनखेमन के आघू म परमेसर के बचन पढ़े, उपदेस करे अऊ सिखोय म लगाय रख। <verse eid="1TI 4:13"/><verse number="14" style="v" sid="1TI 4:14"/>अपन बरदान के खियाल रख, जऊन ह तोला एक अगमबानी के जरिये दिये गे रिहिस, जब अगुवामन अपन हांथ ला तोर ऊपर रखिन।<verse eid="1TI 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15"/>ये काममन ला करते रह; अऊ येमन खातिर अपनआप ला पूरा लगा दे, ताकि हर एक झन तोर बढ़ती ला देख सकंय। <verse eid="1TI 4:15"/><verse number="16" style="v" sid="1TI 4:16"/>अपन जिनगी अऊ अपन सिकछा ला बिसेस धियान दे। ओमा लगे रह, काबरकि यदि तेंह अइसने करबे, त तेंह, तोर अऊ तोर बात सुनइया, दूनों के उद्धार करबे।<verse eid="1TI 4:16"/></para>
  <chapter eid="1TI 4"/>
  <chapter number="5" style="c" sid="1TI 5"/>
  <para style="s1">बिधवा, अगुवा अऊ गुलाममन के बारे म सलाह</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1"/>कोनो सियान मनखे ला झन डांट, पर ओला अपन ददा सहीं जानके समझा दे। जवानमन ला भाई, <verse eid="1TI 5:1"/><verse number="2" style="v" sid="1TI 5:2"/>डोकरी माईलोगनमन ला दाई अऊ जवान माईलोगनमन ला पूरा सुध मन ले बहिनी जानके ओमन के संग बरताव कर।<verse eid="1TI 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3"/>ओ बिधवामन के आदर कर, जऊन मन ला सही म मदद के जरूरत हवय। <verse eid="1TI 5:3"/><verse number="4" style="v" sid="1TI 5:4"/>कहूं कोनो बिधवा के लइका अऊ नाती-नतनीन हवंय, त ओमन ला अपन परिवार के देखरेख करे के दुवारा पहिली अपन धरम के काम ला पूरा करना चाही। ये किसम ले ओमन अपन दाई-ददा अऊ डोकरी-डोकरा दाई-ददामन के बदला चुकावंय, काबरकि ये काम ह परमेसर ला भाथे। <verse eid="1TI 5:4"/><verse number="5" style="v" sid="1TI 5:5"/>ओह सही बिधवा ए, जेकर कोनो नइं ए अऊ जऊन ह परमेसर ऊपर भरोसा रखथे अऊ रात-दिन पराथना म लगे रहिथे अऊ परमेसर ले मदद मांगथे। <verse eid="1TI 5:5"/><verse number="6" style="v" sid="1TI 5:6"/>पर ओ बिधवा, जऊन ह भोग-बिलास म जिनगी बिताथे, ओह जीते-जीयत मर गीस। <verse eid="1TI 5:6"/><verse number="7" style="v" sid="1TI 5:7"/>ओमन ला हुकूम दे, ताकि ओमन निरदोस जिनगी जीयंय। <verse eid="1TI 5:7"/><verse number="8" style="v" sid="1TI 5:8"/>यदि कोनो अपन रिस्तेदार अऊ बिसेस करके अपन परिवार के देखरेख नइं करय, त एकर ले पता चलथे कि ओह मसीह के ऊपर बिसवास करे बर छोंड़ दे हवय, अऊ एक अबिसवासी ले घलो खराप हो गे हवय।<verse eid="1TI 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9"/>बिधवामन के सूची म, ओ बिधवा के नांव लिखे जावय, जेकर उमर साठ साल ले ऊपर हवय अऊ जऊन ह एके झन मनखे के घरवाली रहे हवय। <verse eid="1TI 5:9"/><verse number="10" style="v" sid="1TI 5:10"/>अऊ भलई के काम करे म ओकर बने नांव होवय—जइसने कि अपन लइकामन के पालन-पोसन करई, पहुनई करई, परमेसर के मनखेमन के गोड़ धोवई, जऊन मन मुसीबत म हवंय, ओमन के मदद करई अऊ अपनआप ला जम्मो किसम के बने काम म लगाय रखई।<verse eid="1TI 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11"/>पर जवान बिधवामन ला अइसने सूची म झन रख, काबरकि जब ओमन के सारीरिक भोग-बिलास के ईछा ह ओमन ला मसीह ले दूरिहा ले जाथे, त ओमन बिहाव करे चाहथें। <verse eid="1TI 5:11"/><verse number="12" style="v" sid="1TI 5:12"/>ये किसम ले ओमन दोसी होथें, काबरकि ओमन मसीह के संग करे अपन पहिली परतिगियां ला टोर देथें। <verse eid="1TI 5:12"/><verse number="13" style="v" sid="1TI 5:13"/>एकर अलावा, ओमन घर-घर जाके आलसी बन जाथें। अऊ सिरिप आलसी ही नइं बनंय, पर बक-बक करथें अऊ आने मन के काम म दखल देथें, ओ बातमन ला कहिके जऊन ला कि नइं कहना चाही। <verse eid="1TI 5:13"/><verse number="14" style="v" sid="1TI 5:14"/>एकरसेति, बने होतिस कि जवान बिधवामन बिहाव करंय अऊ लइका जनमावंय, अपन घर-बार ला संभालंय अऊ बईरी ला बदनाम करे के कोनो मऊका झन देवंय। <verse eid="1TI 5:14"/><verse number="15" style="v" sid="1TI 5:15"/>काबरकि कुछू बिधवामन पहिले ही बहकके सैतान के पाछू चलत हवंय।<verse eid="1TI 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16"/>कहूं कोनो बिसवासी माईलोगन के अइसने रिस्तेदार हवंय, जऊन मन बिधवा अंय, त ओह ओमन के मदद करय ताकि ओमन के बोझा कलीसिया ऊपर झन होवय अऊ कलीसिया ह आने मन के मदद कर सकय, जऊन मन सही म बिधवा अंय।<verse eid="1TI 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17"/>ओ अगुवा जऊन मन कलीसिया के बने काम करथें, ओमन दू गुना आदर के लईक समझे जावंय, बिसेस करके जऊन मन परमेसर के बचन के परचार अऊ सिखोय के काम करथें। <verse eid="1TI 5:17"/><verse number="18" style="v" sid="1TI 5:18"/>काबरकि परमेसर के बचन ह कहिथे, “दंवरी म चलत बईला के मुहूं ला झन बांधव”<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 25:4">ब्यव 25:4</ref></char></char></note> अऊ “बनिहार ला ओकर बनी मिलना चाही।”<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="LUK 10:7">लूका 10:7</ref></char></char></note> <verse eid="1TI 5:18"/><verse number="19" style="v" sid="1TI 5:19"/>कहूं कोनो मनखे ह कोनो अगुवा ऊपर दोस लगाथे, त बिगर दू या तीन गवाह के ओकर झन सुने कर। <verse eid="1TI 5:19"/><verse number="20" style="v" sid="1TI 5:20"/>जऊन मन पाप करथें, ओमन ला जम्मो के आघू म डांट, ताकि आने मन पाप करे बर डरंय। <verse eid="1TI 5:20"/><verse number="21" style="v" sid="1TI 5:21"/>परमेसर, मसीह यीसू अऊ चुने स्वरगदूतमन ला हाजिर जानके, मेंह तोला हुकूम देवत हंव कि ये बातमन ला बिगर काकरो तरफदारी के माने कर अऊ कोनो काम म पखियपात झन कर।<verse eid="1TI 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22"/>कोनो मनखे ला परभू के सेवा खातिर चुने म जल्दबाजी करके ओकर ऊपर हांथ झन रख अऊ आने मन के पाप म भागीदार झन हो। अपनआप ला सुध बनाय रख।<verse eid="1TI 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23"/>सिरिप पानी झन पीये कर, पर अपन पेट खातिर अऊ बार-बार बेमार पड़े के कारन, थोरकन अंगूर के मंद घलो पीये कर।<verse eid="1TI 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24"/>कुछू मनखेमन के पाप ह साफ-साफ दिख जाथे अऊ ओमन के पाप ह ओमन ले पहिले नियाय बर पहुंच जाथे; पर आने मन के पाप ह बाद म दिखथे। <verse eid="1TI 5:24"/><verse number="25" style="v" sid="1TI 5:25"/>वइसनेच बने काममन साफ-साफ दिखथें अऊ कहूं साफ नइं घलो दिखंय, त ओमन सदाकाल तक छुपे नइं रह सकंय।<verse eid="1TI 5:25"/></para>
  <chapter eid="1TI 5"/>
  <chapter number="6" style="c" sid="1TI 6"/>
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1"/>जऊन मन गुलाम अंय, ओमन अपन मालिक ला बड़े आदर के लईक समझंय, ताकि परमेसर के नांव अऊ हमर सिकछा के निन्दा झन होवय। <verse eid="1TI 6:1"/><verse number="2" style="v" sid="1TI 6:2"/>जेमन के मालिकमन बिसवासी अंय, एकर खातिर ओमन अपन मालिक के आदर करे म कमी झन करंय कि ओमन संगी बिसवासी अंय। बल्कि ओमन ला अपन मालिकमन के अऊ बने सेवा करना चाही काबरकि जऊन मन सेवा के लाभ उठाथें, ओ मालिकमन संगी बिसवासी अऊ ओमन के मयारू अंय अऊ अपन गुलाममन के खुसी के खियाल रखथें। ये बात तेंह ओमन ला सिखोय अऊ समझाय कर।</para>
  <para style="s1" vid="1TI 6:2">रूपिया-पईसा के लोभ</para>
  <para style="p" vid="1TI 6:2">ये बातमन ला, तें सिखोय अऊ समझाय कर। <verse eid="1TI 6:2"/><verse number="3" style="v" sid="1TI 6:3"/>कहूं कोनो आने किसम के उपदेस देथे अऊ हमर परभू यीसू मसीह के सही निरदेस अऊ परमेसर के सिकछा ले सहमत नइं ए, <verse eid="1TI 6:3"/><verse number="4" style="v" sid="1TI 6:4"/>त ओह घमंडी हो गे हवय अऊ कुछू नइं जानय। ओह बाद-बिबाद अऊ परमेसर के बचन के बारे झगरा करे म बेकार के रूचि रखथे, जेकर ले जलन, झगरा, निन्दा के बात, खराप भरम, <verse eid="1TI 6:4"/><verse number="5" style="v" sid="1TI 6:5"/>अऊ बिगड़े बुद्धि वाले मनखेमन के बीच म लगातार मतभेद पईदा होथे, जेमन कि सत ले दूरिहा हो गे हवंय। अऊ ओमन सोचथें कि परमेसर के भक्ति ह पईसा कमाय के रसता ए।<verse eid="1TI 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6"/>पर संतोस सहित परमेसर के भक्ति म जिनगी बितई ह बहुंत बड़े कमई ए। <verse eid="1TI 6:6"/><verse number="7" style="v" sid="1TI 6:7"/>काबरकि हमन ये संसार म कुछू नइं लाने हवन अऊ हमन इहां ले कुछू नइं ले जा सकन। <verse eid="1TI 6:7"/><verse number="8" style="v" sid="1TI 6:8"/>एकरसेति कहूं हमर करा भोजन अऊ कपड़ा हवय, त हमन ला ओहीच म संतोस रहना चाही। <verse eid="1TI 6:8"/><verse number="9" style="v" sid="1TI 6:9"/>जऊन मन धनी होय चाहथें, ओमन लालच म, अऊ फांदा म अऊ कतको किसम के मुरूख अऊ हानिकारक ईछा म फंसथें, जऊन ह मनखेमन ला बरबादी अऊ बिनास म बुड़ो देथे। <verse eid="1TI 6:9"/><verse number="10" style="v" sid="1TI 6:10"/>काबरकि रूपिया-पईसा ले मया करई ह जम्मो बुरई के जरी अय। कुछू मनखेमन रूपिया-पईसा के लोभ म पड़के बिसवास ले भटक गे हवंय अऊ अपनआप ला नाना किसम के दुख म डार दे हवंय।<verse eid="1TI 6:10"/></para>
  <para style="s1">तीमुथियुस ला पौलुस के निरदेस</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11"/>पर, हे परमेसर के जन, तेंह ये जम्मो चीज ले दूरिहा रह अऊ धरमीपन, भक्ति, बिसवास, मया, सहनसीलता अऊ नमरता के काम म अपन मन ला लगाय रख। <verse eid="1TI 6:11"/><verse number="12" style="v" sid="1TI 6:12"/>बिसवास के बने लड़ई लड़त रह अऊ परमेसर के संग सदाकाल के जिनगी ला थामे रह, काबरकि एकरे बर तोला बलाय गे रिहिस, जब तेंह कतको गवाहमन के आघू म अपन बिसवास के सही गवाही देय रहय। <verse eid="1TI 6:12"/><verse number="13" style="v" sid="1TI 6:13"/>परमेसर ला हाजिर जानके, जऊन ह जम्मो ला जिनगी देथे अऊ मसीह यीसू ला हाजिर जानके, जऊन ह पुन्तियुस पीलातुस के आघू म निडर होके गवाही दीस, मेंह तोला हुकूम देवत हंव <verse eid="1TI 6:13"/><verse number="14" style="v" sid="1TI 6:14"/>कि तेंह हमर परभू यीसू मसीह के परगट होवत तक, ये हुकूम ला निस्कलंक अऊ सही-सही मानत रह। <verse eid="1TI 6:14"/><verse number="15" style="v" sid="1TI 6:15"/>यीसू ला परमेसर ह अपन सही समय म परगट करही। परमेसर ह परमधन्य अऊ सिरिप एके सासक, राजामन के राजा अऊ परभूमन के परभू अय। <verse eid="1TI 6:15"/><verse number="16" style="v" sid="1TI 6:16"/>ओह एके झन अमर अय, ओह अगम-अपार अंजोर म रहिथे, जेला कोनो नइं देखे हवंय अऊ न कोनो ओला देख सकंय। ओकर आदर अऊ पराकरम जुग-जुग होवत रहय। आमीन।<verse eid="1TI 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17"/>ये संसार के धनवानमन ला हुकूम दे कि ओमन घमंडी झन होवंय अऊ नासमान धन ऊपर आसा झन रखंय, पर परमेसर ऊपर आसा रखंय, जऊन ह हमन ला आनंद मनाय बर हर चीज उदार मन ले देथे। <verse eid="1TI 6:17"/><verse number="18" style="v" sid="1TI 6:18"/>ओमन ला हुकूम दे कि ओमन भलई करंय अऊ भलई के काम म धनी बनंय अऊ ओमन उदार बनंय अऊ मदद करे बर तियार रहंय। <verse eid="1TI 6:18"/><verse number="19" style="v" sid="1TI 6:19"/>ये किसम ले ओमन अपन बर खजाना बटोरहीं, जऊन ह अवइया समय बर एक मजबूत नीव होही, अऊ तब ओमन ओ जिनगी म बने रह सकथें, जऊन ह कि सही के जिनगी ए।<verse eid="1TI 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20"/>हे तीमुथियुस, जऊन चीज ला तोर देखरेख म दिये गे हवय, ओकर रखवारी कर। अऊ जऊन गियान ला गियान कहना ही गलत ए, ओकर बिरोध के बात अऊ भक्तिहीन बातचीत ले दूरिहा रह। <verse eid="1TI 6:20"/><verse number="21" style="v" sid="1TI 6:21"/>काबरकि कुछू मनखेमन ये गियान ला मानके बिसवास ले दूरिहा हो गे हवंय।</para>
  <para style="b" vid="1TI 6:21"/>
  <para style="b" vid="1TI 6:21"/>
  <para style="p" vid="1TI 6:21">तोर ऊपर अनुग्रह होवत रहय।<verse eid="1TI 6:21"/></para>
  <chapter eid="1TI 6"/>
</usx>
