<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">भजन-संहिता</para>
  <para style="toc1">भजन-संहिता के किताब</para>
  <para style="toc2">भजन-संहिता</para>
  <para style="toc3">भजन</para>
  <para style="mt1">भजन-संहिता</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">भाग 1</para>
  <para style="mr">
    <ref loc="PSA 1-41">भजन-संहिता 1–41</ref></para>
  <para style="cl">भजन-संहिता 1</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>धइन अय ओ मनखे,</para>
  <para style="q2" vid="PSA 1:1">जऊन ह दुस्टमन के चाल म नइं चलय</para>
  <para style="q1" vid="PSA 1:1">या पापीमन के रद्दा म ठाढ़ नइं होवय,</para>
  <para style="q2" vid="PSA 1:1">या ठट्ठा करइयामन के संग म नइं बईठय,<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>पर ओह यहोवा के कानून म खुस रहिथे,</para>
  <para style="q2" vid="PSA 1:2">अऊ ओह ओकर कानून म रात अऊ दिन मनन-चिंतन करत रहिथे।<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>ओ मनखे ह ओ रूख सहीं अय, जऊन ला बहत नरवा के तीर म लगाय गे हवय,</para>
  <para style="q1" vid="PSA 1:3">अऊ सही समय म फरथे,</para>
  <para style="q1" vid="PSA 1:3">अऊ जेकर पान ह कभू नइं अयलाय—</para>
  <para style="q2" vid="PSA 1:3">जऊन कुछू ओह करथे, ओह सफल होथे।<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>दुस्ट मनखेमन अइसे नइं होवंय,</para>
  <para style="q2" vid="PSA 1:4">ओमन बदरा जइसे होथें,</para>
  <para style="q2" vid="PSA 1:4">जऊन ला हवा ह उड़िया ले जाथे।<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>एकरसेति दुस्ट मनखेमन अदालत म ठहर नइं सकंय,</para>
  <para style="q2" vid="PSA 1:5">अऊ न ही पापीमन धरमीमन के सभा म ठहिरहीं।<verse eid="PSA 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>काबरकि यहोवा के नजर ह धरमीमन के चालचलन ऊपर रहिथे,</para>
  <para style="q2" vid="PSA 1:6">पर दुस्टमन के चालचलन ह ओमन ला बिनास कोति ले जाथे।<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="cl">भजन-संहिता 2</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>जाति-जाति के मनखेमन काबर हो-हल्ला मचाथें</para>
  <para style="q2" vid="PSA 2:1">अऊ मनखेमन काबर बेकार म सडयंत्र रचथें?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>यहोवा अऊ ओकर अभिसिक्त जन के बिरूध</para>
  <para style="q2" vid="PSA 2:2">धरती के राजामन ठाढ़ होथें अऊ सासन करइयामन</para>
  <para style="q2" vid="PSA 2:2">ये कहिके एक संग जूरथें,<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>“आवव, हमन ओमन के बेड़ीमन ला टोर दन</para>
  <para style="q2" vid="PSA 2:3">अऊ ओमन के बंधना ला उतार फेंकन।”<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>जऊन ह स्वरग के सिंघासन म बिराजे हवय, ओह हंसथे;</para>
  <para style="q2" vid="PSA 2:4">परमेसर ह ओमन के ठट्ठा करथे।<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>ओह गुस्सा होके ओमन ला डांटथे</para>
  <para style="q2" vid="PSA 2:5">अऊ अपन कोप म ओमन ला ये कहिके डरवाथे,<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>“मेंह अपन राजा ला</para>
  <para style="q2" vid="PSA 2:6">अपन पबितर पहाड़ सियोन ऊपर बईठा दे हंव।”<verse eid="PSA 2:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7"/>मेंह यहोवा के बिधि-बिधान के घोसना करहूं:</para>
  <para style="b" vid="PSA 2:7"/>
  <para style="q1" vid="PSA 2:7">ओह मोला कहिस, “तेंह मोर बेटा अस;</para>
  <para style="q2" vid="PSA 2:7">आज मेंह तोर ददा बन गे हवंव।<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>मोर ले मांग,</para>
  <para style="q2" vid="PSA 2:8">अऊ मेंह जम्मो देसमन ला तोर संपत्ति होय बर,</para>
  <para style="q2" vid="PSA 2:8">अऊ धरती के छोर तक के जगह ला तोर अधिकार म दे दूहूं।<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>तेंह ओमन ला लोहा के छड़ ले टोर-फोर देबे<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">लोहा के राजदंड ले राज करबे</char></note>;</para>
  <para style="q2" vid="PSA 2:9">तेंह ओमन ला माटी के बरतन सहीं फोरके कुटा-कुटा कर देबे।”<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>एकरसेति, हे राजामन, तुमन बुद्धिमान बनव;</para>
  <para style="q2" vid="PSA 2:10">हे धरती के सासन करइयामन, सचेत रहव।<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>भय के संग यहोवा के सेवा करव</para>
  <para style="q2" vid="PSA 2:11">अऊ कांपत-कांपत ओकर सासन के खुसी मनावव।<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>ओकर बेटा ला चूमव, नइं तो ओह गुस्सा हो जाही</para>
  <para style="q2" vid="PSA 2:12">अऊ तुम्हर जिनगी ह तुमन ला बिनास कोति ले जाही,</para>
  <para style="q1" vid="PSA 2:12">काबरकि छिन भर म ओकर कोप ह भड़क सकथे।</para>
  <para style="q2" vid="PSA 2:12">धइन अंय ओमन, जेमन ओकर करा सरन लेथें।<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="cl">भजन-संहिता 3<note caller="+" style="f"><char style="fr" closed="false">3 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 3:1-8">3:1‑8</ref></char> ला 3:2‑9 गने गे हवय</char></note></para>
  <para style="d">दाऊद के एक भजन। जब ओह अपन बेटा अबसालोम करा ले भागत रिहिस।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>हे यहोवा, कतेक जादा हवंय मोर बईरीमन!</para>
  <para style="q2" vid="PSA 3:1">कतेक मनखेमन मोर बिरोध म ठाढ़ होवत हें!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>बहुंते झन मोर बारे म कहत हें,</para>
  <para style="q2" vid="PSA 3:2">“परमेसर ह ओला नइं बचाय।”<verse eid="PSA 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>पर हे यहोवा, तेंह मोर चारों कोति एक ढाल अस,</para>
  <para style="q2" vid="PSA 3:3">तेंह मोर महिमा अस, अऊ तेंह मोर मुड़ ला ऊंचहा करथस।<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>मेंह यहोवा ला जोर से पुकारथंव,</para>
  <para style="q2" vid="PSA 3:4">अऊ ओह अपन पबितर पहाड़ ले मोला जबाब देथे।<verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>मेंह लेटथंव अऊ सुत जाथंव;</para>
  <para style="q2" vid="PSA 3:5">मेंह फेर जागथंव, काबरकि यहोवा ह मोला संभालथे।<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>मेंह ओ हजारों-हजार मनखेमन ले नइं डरंव,</para>
  <para style="q2" vid="PSA 3:6">जेमन चारों कोति ले मोर ऊपर हमला करथें।<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>हे यहोवा, उठ!</para>
  <para style="q2" vid="PSA 3:7">हे मोर परमेसर, मोला बचा!</para>
  <para style="q1" vid="PSA 3:7">मोर जम्मो बईरीमन के जबड़ा म मार;</para>
  <para style="q2" vid="PSA 3:7">अऊ दुस्टमन के दांत ला टोर दे।<verse eid="PSA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>छुटकारा यहोवा ही देथे।</para>
  <para style="q2" vid="PSA 3:8">हे यहोवा, तोर आसीस तोर मनखेमन ऊपर होवय।<verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="cl">भजन-संहिता 4<note caller="+" style="f"><char style="fr" closed="false">4 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 4:1-8">4:1‑8</ref></char> ला 4:2‑9 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। तारवाले बाजामन के संग। दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>हे मोर धरमी परमेसर,</para>
  <para style="q2" vid="PSA 4:1">जब मेंह तोला बलावंव, त तेंह मोला जबाब दे।</para>
  <para style="q1" vid="PSA 4:1">मोला मोर बिपत्ति म सहारा दे;</para>
  <para style="q2" vid="PSA 4:1">मोर ऊपर दया कर अऊ मोर पराथना ला सुन।<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>हे मनखेमन! तुमन कब तक मोर महिमा के बेजत्ती करत रहिहू?</para>
  <para style="q2" vid="PSA 4:2">तुमन कब तक भरम ले मया करत रहिहू अऊ लबरा देवतामन के खोज म रहिहू?<verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>तुमन जान लव कि यहोवा ह अपन बिसवासयोग्य सेवक ला अपन बर अलग रखे हवय;</para>
  <para style="q2" vid="PSA 4:3">जब मेंह यहोवा ला पुकारथंव, त ओह मोर बात ला सुनथे।<verse eid="PSA 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>कांपत रहव अऊ<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">गुस्सा होके</char></note> पाप झन करव;</para>
  <para style="q2" vid="PSA 4:4">जब तुमन अपन दसना म रहिथव,</para>
  <para style="q2" vid="PSA 4:4">त अपन मन ला जांचव अऊ चुप रहव।<verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>धरमीपन के बलिदान चघावव</para>
  <para style="q2" vid="PSA 4:5">अऊ यहोवा ऊपर भरोसा रखव।<verse eid="PSA 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>बहुंते जन पुछत हवंय, “कोन ह हमर उन्नति करही?”</para>
  <para style="q2" vid="PSA 4:6">हे यहोवा, तोर मुख के अंजोर हमर ऊपर चमका।<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>जब ओमन के अनाज अऊ नवां अंगूर के मंद बहुंत होथे,</para>
  <para style="q2" vid="PSA 4:7">त तेंह मोर मन ला आनंद ले भर दे।<verse eid="PSA 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>सांति से मेंह लेटहूं अऊ सुतहूं,</para>
  <para style="q2" vid="PSA 4:8">काबरकि हे यहोवा, तेंहीच ह</para>
  <para style="q2" vid="PSA 4:8">मोला सुरकछा म रखथस।<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="cl">भजन-संहिता 5<note caller="+" style="f"><char style="fr" closed="false">5 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 5:1-12">5:1‑12</ref></char> ला 5:2‑13 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। बांसुरी या नलीवाले बाजा बर। दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>हे यहोवा, मोर बात ला सुन,</para>
  <para style="q2" vid="PSA 5:1">मोर बिलाप करई ऊपर धियान दे।<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>हे मोर राजा अऊ मोर परमेसर,</para>
  <para style="q2" vid="PSA 5:2">मदद बर मोर गोहार ला सुन,</para>
  <para style="q2" vid="PSA 5:2">काबरकि तोरेच ले मेंह पराथना करत हंव।<verse eid="PSA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>हे यहोवा, बिहनियां के बेरा तेंह मोर गोठ ला सुनथस;</para>
  <para style="q2" vid="PSA 5:3">बिहनियां के बेरा मेंह तोर ले बिनती करथंव</para>
  <para style="q2" vid="PSA 5:3">अऊ तोर जबाब के बाट जोहथंव।<verse eid="PSA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>काबरकि तेंह अइसन परमेसर नो हस, जऊन ह दुस्टता ले खुस होथे;</para>
  <para style="q2" vid="PSA 5:4">दुस्ट मनखेमन तोर संग नइं रह सकंय।<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>घमंडी मनखे ह तोर आघू म</para>
  <para style="q2" vid="PSA 5:5">ठाढ़ नइं हो सकय।</para>
  <para style="q1" vid="PSA 5:5">तेंह जम्मो दुस्ट काम करइयामन ले घिन करथस;<verse eid="PSA 5:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 5:6"/>तेंह ओमन ला नास कर देथस, जेमन लबारी मारथंय।</para>
  <para style="q1" vid="PSA 5:6">यहोवा ओमन ले घिन करथे,</para>
  <para style="q2" vid="PSA 5:6">जेमन खून करथें अऊ धोखा देथें।<verse eid="PSA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>पर मेंह तोर बड़े मया के कारन</para>
  <para style="q2" vid="PSA 5:7">तोर घर म आ सकत हंव;</para>
  <para style="q1" vid="PSA 5:7">आदर म तोर पबितर मंदिर कोति</para>
  <para style="q2" vid="PSA 5:7">मेंह मुड़ नवाथंव।<verse eid="PSA 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>हे यहोवा, अपन धरमीपन म मोर अगुवई कर,</para>
  <para style="q2" vid="PSA 5:8">मोर बईरीमन के कारन—</para>
  <para style="q2" vid="PSA 5:8">मोर आघू म तोर रद्दा ला सीधा देखा।<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>ओमन के मुहूं के एको ठन बात ऊपर भरोसा नइं करे जा सकय;</para>
  <para style="q2" vid="PSA 5:9">ओमन के मन ह डाह-बैर ले भरे हवय।</para>
  <para style="q1" vid="PSA 5:9">ओमन के टोंटा ह एक खुला कबर ए;</para>
  <para style="q2" vid="PSA 5:9">अपन जीभ ले ओमन लबारी मारथें।<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>हे परमेसर, ओमन ला दोसी ठहिरा!</para>
  <para style="q2" vid="PSA 5:10">ओमन के चालबाजी ह ओमन के गिरे के कारन होवय।</para>
  <para style="q1" vid="PSA 5:10">ओमन के बहुंते पाप के कारन ओमन ला बाहिर निकाल दे,</para>
  <para style="q2" vid="PSA 5:10">काबरकि ओमन तोर बिरूध बिदरोह करे हवंय।<verse eid="PSA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>पर जेमन तोर करा सरन लेथें, ओमन खुस होवंय;</para>
  <para style="q2" vid="PSA 5:11">ओमन हमेसा आनंद के गीत गावंय।</para>
  <para style="q1" vid="PSA 5:11">ओमन ला अपन सुरकछा म रख,</para>
  <para style="q2" vid="PSA 5:11">ताकि जऊन मन तोर नांव ले मया करथें, ओमन तोर म आनंद मनावंय।<verse eid="PSA 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>हे यहोवा, सही म तेंह धरमी जन ला आसीस देथस;</para>
  <para style="q2" vid="PSA 5:12">तेंह एक ढाल के सहीं ओमन ला अपन अनुग्रह के घेरा म रखथस।<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="cl">भजन-संहिता 6<note caller="+" style="f"><char style="fr" closed="false">6 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 6:1-10">6:1‑10</ref></char> ला 6:2‑11 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। तारवाले बाजामन के संग। <char style="tl">सेमिनित</char><note caller="+" style="f"><char style="fr" closed="false">6:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note> के मुताबिक। दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>हे यहोवा, अपन गुस्सा म मोला झन फटकार</para>
  <para style="q2" vid="PSA 6:1">या अपन कोप म मोर ताड़ना झन कर।<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>हे यहोवा मोर ऊपर दया कर, काबरकि मेंह दुरबल हो गे हंव;</para>
  <para style="q2" vid="PSA 6:2">हे यहोवा, मोर बेमारी ला बने कर दे, काबरकि मोर हाड़ामन म पीरा हवय।<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>मोर परान ह अब्बड़ पीरा म हवय।</para>
  <para style="q2" vid="PSA 6:3">हे यहोवा, कब तक, कब तक ठहिरे रहिबे?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>हे यहोवा, किंदरके मोला छुड़ा;</para>
  <para style="q2" vid="PSA 6:4">अपन बहुंते मया के कारन मोला बचा।<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>मरे मनखेमन के बीच कोनो तोर नांव के परचार नइं करंय।</para>
  <para style="q2" vid="PSA 6:5">कबर ले कोन ह तोर इस्तुति करथे?<verse eid="PSA 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>मेंह कराहत-कराहत थक गे हंव।</para>
  <para style="b" vid="PSA 6:6"/>
  <para style="q1" vid="PSA 6:6">पूरा रथिया रोवत-रोवत मोर दसना ह भीग जाथे</para>
  <para style="q2" vid="PSA 6:6">अऊ मोर आंसू ले मोर पलंग ह भीग जाथे।<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>मोर आंखीमन दुख के मारे कमजोर होवत हें;</para>
  <para style="q2" vid="PSA 6:7">मोर जम्मो बईरीमन के कारन ओमन धुंधला गे हवंय।<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>हे जम्मो दुस्ट काम करइयामन, मोर ले दूरिहा हटव,</para>
  <para style="q2" vid="PSA 6:8">काबरकि यहोवा ह मोर रोये के अवाज ला सुने हवय।<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>यहोवा ह दया बर मोर रोवई ला सुने हवय;</para>
  <para style="q2" vid="PSA 6:9">यहोवा ह मोर पराथना ला गरहन करथे।<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>मोर जम्मो बईरीमन लाज अऊ पीरा के मारे घबराहीं;</para>
  <para style="q2" vid="PSA 6:10">ओमन पाछू मुड़हीं अऊ अचानक लज्जित होहीं।<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="cl">भजन-संहिता 7<note caller="+" style="f"><char style="fr" closed="false">7 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 7:1-17">7:1‑17</ref></char> ला 7:2‑18 गने गे हवय</char></note></para>
  <para style="d">दाऊद के <char style="tl">सिग्गायोन</char><note caller="+" style="f"><char style="fr" closed="false">7:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note> नांव के एक भजन, जेला ओह बिनयामीनी कूस के संबंध म यहोवा के आघू म गाईस।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1"/>हे यहोवा मोर परमेसर, मेंह तोर सरन लेथंव;</para>
  <para style="q2" vid="PSA 7:1">मोला ओ जम्मो झन ले बचा अऊ छुड़ा, जेमन मोर पीछा करत हें,<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>नइं तो ओमन सिंह के सहीं मोला चीरके कुटा-कुटा कर दीहीं</para>
  <para style="q2" vid="PSA 7:2">अऊ मोला बचानेवाला कोनो नइं होहीं।<verse eid="PSA 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>हे यहोवा मोर परमेसर, कहूं मेंह ये काम करे हंव</para>
  <para style="q2" vid="PSA 7:3">अऊ मोर हांथमन दोसी अंय—<verse eid="PSA 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4"/>यदि मेंह मोर संग मेल रखइयामन के संग भलई के बदले बुरई करे हंव</para>
  <para style="q2" vid="PSA 7:4">या बिगर कारन के मेंह अपन बईरी ला लूटे हंव—<verse eid="PSA 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>त फेर मोर बईरी ह मोर पीछा करके मोला धर लेवय;</para>
  <para style="q2" vid="PSA 7:5">ओह मोला भुइयां म कुचरके मार डारय</para>
  <para style="q2" vid="PSA 7:5">अऊ मोला माटी म मिला देवय।<verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>हे यहोवा, अपन कोरोध म उठ;</para>
  <para style="q2" vid="PSA 7:6">मोर बईरीमन के कोरोध के बिरूध म उठ।</para>
  <para style="q2" vid="PSA 7:6">हे मोर परमेसर, जाग अऊ नियाय कर।<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>मनखेमन के भीड़ तोर चारों कोति जूरय,</para>
  <para style="q2" vid="PSA 7:7">अऊ तें ओमन ऊपर ऊंच जगह म बिराजमान हो जा।<verse eid="PSA 7:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 7:8"/>यहोवा ह मनखेमन के नियाय करय।</para>
  <para style="q1" vid="PSA 7:8">हे यहोवा, हे सर्वोच्च परमेसर, मोर धरमीपन के मुताबिक,</para>
  <para style="q2" vid="PSA 7:8">मोर ईमानदारी के मुताबिक मोर नियाय कर।<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>हे धरमी परमेसर,</para>
  <para style="q2" vid="PSA 7:9">तें जऊन ह मन अऊ हिरदय ला जांचथस;</para>
  <para style="q1" vid="PSA 7:9">दुस्टमन के बुरई ला खतम कर दे</para>
  <para style="q2" vid="PSA 7:9">अऊ धरमीमन ला सुरकछित रख।<verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>सर्वोच्च परमेसर ह मोर ढाल ए,</para>
  <para style="q2" vid="PSA 7:10">जऊन ह सीधवा मनखेमन ला बचाथे।<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>परमेसर ह धरमी नियायधीस अय,</para>
  <para style="q2" vid="PSA 7:11">अइसन परमेसर, जऊन ह हर दिन कोप करथे।<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>यदि मनखे ह पछताप नइं करही,</para>
  <para style="q2" vid="PSA 7:12">त परमेसर ह अपन तलवार ला धार करही;</para>
  <para style="q2" vid="PSA 7:12">ओह धनुस ला साधके ओमा तीर चघाही।<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>ओह मिरतू के हथियार तियार करे हवय;</para>
  <para style="q2" vid="PSA 7:13">ओह अपन आगी बरत तीरमन ला तियार रखथे।<verse eid="PSA 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>जऊन ह दुस्टता के बात सोचथे,</para>
  <para style="q2" vid="PSA 7:14">ओह समस्या खड़े करथे अऊ बईरता ला पईदा करथे।<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>जऊन ह माटी निकालके खंचवा कोड़थे,</para>
  <para style="q2" vid="PSA 7:15">ओह अपन कोड़े खंचवा म खुद गिरथे।<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>जऊन समस्या ओह खड़े करथे, ओह लहुंटके ओकरे ऊपर आ जाथे;</para>
  <para style="q2" vid="PSA 7:16">ओकर हिंसा के काम ओकरेच मुड़ ऊपर आ जाथे।<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>मेंह यहोवा ला ओकर धरमीपन बर धनबाद दूहूं;</para>
  <para style="q2" vid="PSA 7:17">मेंह यहोवा सर्वोच्च परमेसर के नांव म परसंसा के गीत गाहूं।<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="cl">भजन-संहिता 8<note caller="+" style="f"><char style="fr" closed="false">8 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 8:1-9">8:1‑9</ref></char> ला 8:2‑10 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। <char style="tl">गित्तीथ</char><note caller="+" style="f"><char style="fr" closed="false">8:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note> के मुताबिक दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>हे यहोवा, हमर परभू,</para>
  <para style="q2" vid="PSA 8:1">तोर नांव ह जम्मो धरती म का ही परतापी ए!</para>
  <para style="b" vid="PSA 8:1"/>
  <para style="q1" vid="PSA 8:1">तेंह अपन महिमा</para>
  <para style="q2" vid="PSA 8:1">स्वरग म ठहिराय हस।<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>लइका अऊ छोटे लइकामन के दुवारा परसंसा करवाके</para>
  <para style="q2" vid="PSA 8:2">तेंह बईरी अऊ पलटा लेवइयामन ला चुप कराय बर</para>
  <para style="q2" vid="PSA 8:2">ओमन के बिरूध एक गढ़ बनाय हस।<verse eid="PSA 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>जब मेंह अकास ऊपर बिचार करथंव,</para>
  <para style="q2" vid="PSA 8:3">जऊन ह तोर हांथ के काम ए</para>
  <para style="q1" vid="PSA 8:3">चंदा अऊ तारामन,</para>
  <para style="q2" vid="PSA 8:3">जेमन ला तेंह अपन-अपन जगह म रखे हस,<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>त मनखे ह का ए कि तेंह ओकर ऊपर धियान देथस,</para>
  <para style="q2" vid="PSA 8:4">मानव-जाति<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">एक मनखे के बेटा</char></note> ह का ए कि तेंह ओकर खियाल रखथस?<verse eid="PSA 8:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>तेंह ओला स्वरगदूतमन<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमेसर</char></note> ले थोरकन कम करके बनाय हस</para>
  <para style="q2" vid="PSA 8:5">अऊ ओला महिमा अऊ आदर के मुकुट पहिराय हस।<verse eid="PSA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>तेंह ओला अपन हांथ के काममन के ऊपर राज-करइया बनाय हस;</para>
  <para style="q2" vid="PSA 8:6">तेंह हर एक चीज ला ओकर<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">हर चीज ऊपर सासन करइया</char></note> गोड़ खाल्हे कर दे हस:<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>जम्मो भेड़-बकरी अऊ गाय-बईला,</para>
  <para style="q2" vid="PSA 8:7">अऊ जंगल के पसु,<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>अकास के चिरई,</para>
  <para style="q2" vid="PSA 8:8">अऊ समुंदर के मछरी,</para>
  <para style="q2" vid="PSA 8:8">अऊ ओ जम्मो जीव-जन्तु, जेमन समुंदर के पानी म रहिथें।<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>हे यहोवा हमर परभू,</para>
  <para style="q2" vid="PSA 8:9">तोर नांव ह जम्मो धरती म का ही वैभवसाली अय।<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="cl">भजन-संहिता 9<note caller="+" style="f"><char style="fr" closed="false">9 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 9:1-20">9:1‑20</ref></char> ला 9:2‑21 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। “बेटा के मिरतू” के धुन म दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1"/>हे यहोवा, मेंह अपन पूरा मन से तोर धनबाद करहूं;</para>
  <para style="q2" vid="PSA 9:1">मेंह तोर जम्मो अचरज के काम के बखान करहूं।<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>मेंह तोर कारन खुस होहूं अऊ आनंद मनाहूं;</para>
  <para style="q2" vid="PSA 9:2">हे सर्वोच्च परमेसर, मेंह तोर नांव के महिमा के गीत गाहूं।<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>मोर बईरीमन पीठ देखाके भागथें;</para>
  <para style="q2" vid="PSA 9:3">ओमन ठोकर खाके तोर आघू म नास हो जाथें।<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>काबरकि तेंह मोर सही नियाय अऊ फैसला करे हस,</para>
  <para style="q2" vid="PSA 9:4">तेंह एक धरमी नियायधीस के रूप म सिंघासन म बिराजमान होके नियाय करे हस।<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>तेंह जाति-जाति के मनखेमन ला फटकारे हस अऊ दुस्टमन के नास करे हस;</para>
  <para style="q2" vid="PSA 9:5">तेंह ओमन के नांव ला हमेसा-हमेसा बर मिटा दे हस।<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>कभू खतम नइं होवइया बिनास मोर बईरीमन ऊपर आ गे हवय,</para>
  <para style="q2" vid="PSA 9:6">तेंह ओमन के सहरमन ला गिरा दे हस;</para>
  <para style="q2" vid="PSA 9:6">अऊ त अऊ ओमन के सुरता घलो नइं ए।<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>यहोवा ह सदाकाल बर राज करथे;</para>
  <para style="q2" vid="PSA 9:7">ओह अपन सिंघासन ला नियाय बर स्थापित करे हवय।<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>ओह धरमीपन से संसार के नियाय करथे</para>
  <para style="q2" vid="PSA 9:8">अऊ बिगर पखियपात के मनखेमन के मामला निपटाथे।<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>यहोवा ह दबे-कुचरे मनखेमन बर सरन के जगह</para>
  <para style="q2" vid="PSA 9:9">अऊ संकट के बेरा म एक मजबूत गढ़ ए।<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>जेमन तोर नांव ला जानथें, ओमन तोर ऊपर भरोसा करथें,</para>
  <para style="q2" vid="PSA 9:10">काबरकि हे यहोवा, तेंह ओमन ला कभू नइं छोंड़स, जऊन मन तोला खोजथें।<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>सियोन म बिराजे, यहोवा के महिमा के गीत गावव;</para>
  <para style="q2" vid="PSA 9:11">जाति-जाति के मनखेमन के बीच ओकर काम के बखान करव।<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>काबरकि जऊन ह खून के बदला लेथे, ओह सुरता रखथे;</para>
  <para style="q2" vid="PSA 9:12">ओह दुखी मनखे के पुकार ला अनसुना नइं करय।<verse eid="PSA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>हे यहोवा, देख, मोर बईरीमन मोला कइसन सतात हवंय!</para>
  <para style="q2" vid="PSA 9:13">मोर ऊपर दया कर अऊ मोला मिरतू के दुवार ले हटा,<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>ताकि मेंह बेटी सियोन के दुवारमन म</para>
  <para style="q2" vid="PSA 9:14">तोर परसंसा के बखान करंव,</para>
  <para style="q2" vid="PSA 9:14">अऊ उहां तोर करे गय उद्धार ले आनंदित होवंव।<verse eid="PSA 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>जाति-जाति के मनखेमन ओ खंचवा म गिरे हवंय, जेला ओमन कोड़े रिहिन;</para>
  <para style="q2" vid="PSA 9:15">ओमन के गोड़मन ओ फांदा म फंस गे हवंय, जेला ओमन लगाय रिहिन।<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>यहोवा ह अपन नियाय के काम बर जाने जाथे;</para>
  <para style="q2" vid="PSA 9:16">दुस्ट मनखेमन अपन करे गे काम के दुवारा ही फंस जाथें।<verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>दुस्ट मनखेमन खाल्हे अधोलोक म चले जाथें,</para>
  <para style="q2" vid="PSA 9:17">अऊ ओ जम्मो जाति के मनखेमन घलो, जेमन परमेसर ला भुला जाथें।<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>पर परमेसर ह दीन-दुखी ला कभू नइं भूलय;</para>
  <para style="q2" vid="PSA 9:18">दुखीमन के आसा कभू नइं टूटय।<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>हे यहोवा, उठ, मरनहार मनखे ला जय झन पावन दे;</para>
  <para style="q2" vid="PSA 9:19">जाति-जाति के मनखेमन के नियाय तोर आघू म होवय।<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>हे यहोवा, तें ओमन ला डरवा;</para>
  <para style="q2" vid="PSA 9:20">जाति-जाति के मनखेमन जानंय कि ओमन सिरिप मरनहार मनखे अंय।<verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="cl">भजन-संहिता 10<note caller="+" style="f"><char style="fr" closed="false">10 </char><char style="ft" closed="false">भजन-संहिता 9 अऊ 10 सायद मूल रूप म एक कविता के रूप म रिहिन। सेप्टाजिन्ट म ये दूनों एक भजन-संहिता के रूप म हवंय</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>हे यहोवा, तेंह दूरिहा म काबर ठाढ़े रहिथस?</para>
  <para style="q2" vid="PSA 10:1">संकट के बेरा म तेंह काबर अपनआप ला छिपा लेथस?<verse eid="PSA 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>दुस्ट मनखे ह अपन घमंड म दुरबल मनखे के सिकार कर लेथे;</para>
  <para style="q2" vid="PSA 10:2">ओह दुस्ट के बिछाय जाल म फंस जाथे।<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>दुस्ट ह अपन मन के लालसा ऊपर घमंड करथे;</para>
  <para style="q2" vid="PSA 10:3">ओह लालची मनखे ला आसीस देथे अऊ यहोवा के तिरस्कार करथे।<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>अपन घमंड के कारन दुस्ट मनखे ह परमेसर के खोज नइं करय;</para>
  <para style="q2" vid="PSA 10:4">ओकर जम्मो सोच-बिचार म परमेसर बर कोनो जगह नइं रहय।<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>ओकर रसता ह हमेसा उन्नति के रहिथे;</para>
  <para style="q2" vid="PSA 10:5">तोर कानून ला ओह नइं मानय<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">ओह घमंडी अय अऊ तोर कानून ह ओकर ले दूरिहा रहिथे</char></note>;</para>
  <para style="q2" vid="PSA 10:5">ओह अपन जम्मो बईरीमन के ऊपर हंसके ओमन के ठट्ठा करथे।<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>ओह अपनआप ले कहिथे, “मोला कभू कोनो हला नइं सकंय।”</para>
  <para style="q2" vid="PSA 10:6">ओह कसम खाके कहिथे, “मेंह हमेसा दुख ले बचे रहिहूं।”<verse eid="PSA 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>ओकर मुहूं ह लबारी अऊ धमकी के बात ले भरे हवय,</para>
  <para style="q2" vid="PSA 10:7">समस्या अऊ दुस्टता के बात ओकर जीभ म रहिथे।<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>ओह गांवमन के लकठा म घात लगाय बईठे रहिथे;</para>
  <para style="q2" vid="PSA 10:8">ओह छिपके निरदोस मनखे के हतिया करथे।</para>
  <para style="q1" vid="PSA 10:8">ओकर आंखी ह छुपके अपन सिकार ला देखत रहिथे।<verse eid="PSA 10:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 10:9"/>छुपके बईठे सिंह के सहीं ओह घात म रहिथे।</para>
  <para style="q1" vid="PSA 10:9">ओह असहाय ला धरे बर घात म रहिथे;</para>
  <para style="q2" vid="PSA 10:9">ओह असहाय ला धरथे अऊ अपन जाल म घसीटके ले जाथे।<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>ओकर सिकारमन कुचरे जाथें, ओमन गिर जाथें;</para>
  <para style="q2" vid="PSA 10:10">ओमन ओकर ताकत के आघू म हार जाथें।<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>ओह अपनआप ले कहिथे, “परमेसर ह कभू धियान नइं दीही;</para>
  <para style="q2" vid="PSA 10:11">ओह अपन चेहरा ला ढांप लेथे अऊ कभू नइं देखय।”<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>हे यहोवा, उठ! हे परमेसर अपन हांथ ला उठा।</para>
  <para style="q2" vid="PSA 10:12">असहाय मनखेमन ला झन भुला।<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>दुस्ट मनखे ह काबर परमेसर ला तुछ समझथे?</para>
  <para style="q2" vid="PSA 10:13">ओह अपनआप ले काबर कहिथे,</para>
  <para style="q2" vid="PSA 10:13">“परमेसर ह मोर ले लेखा नइं लेवय?”<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>पर हे परमेसर, तेंह दुखी मनखे के समस्या ला देखथस;</para>
  <para style="q2" vid="PSA 10:14">तेंह ओमन के दुख ऊपर बिचार करके ओला अपन हांथ म ले लेथस।</para>
  <para style="q1" vid="PSA 10:14">पीड़ित मनखे ह अपनआप ला तोर हांथ म सऊंप देथे;</para>
  <para style="q2" vid="PSA 10:14">तेंह अनाथमन के सहारा अस।<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>दुस्ट मनखे के बाहां ला टोर दे;</para>
  <para style="q2" vid="PSA 10:15">दुस्ट काम करइया मनखे ले ओकर दुस्टता के हिसाब ले</para>
  <para style="q2" vid="PSA 10:15">ताकि ओकर दुस्टता ह खतम हो जावय।<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>यहोवा ह सदाकाल बर राजा अय;</para>
  <para style="q2" vid="PSA 10:16">आने जाति के मनखेमन ओकर देस ले नास हो जाहीं।<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>हे यहोवा, तेंह दुखी मनखे के मन के बात<note caller="+" style="f"><char style="fr" closed="false">10:17 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">पराथना</char></note> ला सुनथस;</para>
  <para style="q2" vid="PSA 10:17">तेंह ओमन ला उत्साहित करथस अऊ ओमन के गोहार ला सुनथस,<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>अऊ तेंह अनाथ अऊ दुखी-पीड़ित मनखेमन के बचाव करथस,</para>
  <para style="q2" vid="PSA 10:18">ताकि धरती म रहइया मरनहार मनखे ह</para>
  <para style="q2" vid="PSA 10:18">फेर कभू आतंक झन मचावय।<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="cl">भजन-संहिता 11</para>
  <para style="d">संगीत के निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>मेंह यहोवा करा सरन लेथंव।</para>
  <para style="q2" vid="PSA 11:1">तब तेंह मोला कइसे कह सकत हस:</para>
  <para style="q2" vid="PSA 11:1">“चिरई के सहीं अपन पहाड़ करा उड़ जा।<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>काबरकि देख, दुस्ट मनखेमन अपन धनुस ला साधत हें;</para>
  <para style="q2" vid="PSA 11:2">ओमन तीर ला धनुस के डोरी म रखत हें</para>
  <para style="q1" vid="PSA 11:2">ताकि अंधियार म ले</para>
  <para style="q2" vid="PSA 11:2">सीधवा मनखे ऊपर तीर चलावंय।<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>जब नीव ला गिराय जावत हे,</para>
  <para style="q2" vid="PSA 11:3">त फेर धरमी ह का कर सकथे?”<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>यहोवा ह अपन पबितर मंदिर म हवय;</para>
  <para style="q2" vid="PSA 11:4">यहोवा ह अपन स्वरग के सिंघासन म बिराजे हवय।</para>
  <para style="q1" vid="PSA 11:4">ओह धरती ऊपर हर एक जन ला देखत रहिथे;</para>
  <para style="q2" vid="PSA 11:4">ओकर आंखी ह ओमन ला परखथे।<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>यहोवा ह धरमी ला परखथे,</para>
  <para style="q2" vid="PSA 11:5">पर ओह ओ दुस्टमन ले बहुंत घिन करथे,</para>
  <para style="q2" vid="PSA 11:5">जेमन हिंसा ले मया करथें।<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>दुस्ट मनखेमन ऊपर परमेसर ह</para>
  <para style="q2" vid="PSA 11:6">बरत कोइला अऊ बरत गंधक बरसाही;</para>
  <para style="q2" vid="PSA 11:6">लेसा देवइया हवा ह ओमन के भाग होही।<verse eid="PSA 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>काबरकि यहोवा ह धरमी अय,</para>
  <para style="q2" vid="PSA 11:7">ओह नियाय ले मया करथे;</para>
  <para style="q2" vid="PSA 11:7">धरमी मनखे ह ओकर दरसन करही।<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="cl">भजन-संहिता 12<note caller="+" style="f"><char style="fr" closed="false">12 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 12:1-8">12:1‑8</ref></char> ला 12:2‑9 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। <char style="tl">सेमिनित</char><note caller="+" style="f"><char style="fr" closed="false">12:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note> के मुताबिक दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>हे यहोवा, मदद कर, काबरकि अऊ कोनो वफादार नइं अंय;</para>
  <para style="q2" vid="PSA 12:1">जऊन मन बिसवासयोग्य अंय, ओमन मनखेमन के बीच ले गायब हो गे हवंय।<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>हर एक मनखे अपन परोसी ले लबारी मारथे;</para>
  <para style="q2" vid="PSA 12:2">ओमन अपन मुहूं ले चापलूसी करथें</para>
  <para style="q2" vid="PSA 12:2">पर अपन मन म धोखा के बात रखथें।<verse eid="PSA 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>यहोवा ह जम्मो चापलूसी करइया मुहूं</para>
  <para style="q2" vid="PSA 12:3">अऊ हर ओ घमंड करइया जीभ ला बंद कर देवय—<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>जेमन कहिथें,</para>
  <para style="q2" vid="PSA 12:4">“हमन अपन जीभ के दुवारा जीत जाबो;</para>
  <para style="q2" vid="PSA 12:4">हमर खुद के ओंठ ह हमर बचाव करही—हमर मालिक कोन अय?”<verse eid="PSA 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>यहोवा ह कहिथे, “मेंह अब उठहूं,</para>
  <para style="q2" vid="PSA 12:5">काबरकि गरीब मनखे ला लूटे जाथे अऊ जरूरतमंद ह कलहरथे।</para>
  <para style="q2" vid="PSA 12:5">मेंह ओमन ला ओ मनखेमन ले बचाहूं, जेमन ओमन ला कलंकित करत हें।”<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>यहोवा के बचन म कोनो कमी नइं ए,</para>
  <para style="q2" vid="PSA 12:6">येह भट्ठी म सुध करे गे चांदी के सहीं अय,</para>
  <para style="q2" vid="PSA 12:6">ये सात बार सुध करे गे सोन के सहीं अय।<verse eid="PSA 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>हे यहोवा, तेंह जरूरतमंद ला सही-सलामत रखबे</para>
  <para style="q2" vid="PSA 12:7">अऊ हमन ला हमेसा बर ओ दुस्टमन ले बचाय रखबे,<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>जेमन अकड़के चलथें</para>
  <para style="q2" vid="PSA 12:8">जब दुस्टता ला मनखेमन के दुवारा आदर करे जाथे।<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="cl">भजन-संहिता 13<note caller="+" style="f"><char style="fr" closed="false">13 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 13:1-6">13:1‑6</ref></char> ला 13:2‑6 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>हे यहोवा, कब तक? का तेंह मोला हमेसा बर भुला जाबे?</para>
  <para style="q2" vid="PSA 13:1">कब तक तेंह अपन चेहरा ला मोर ले छुपाय रहिबे?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>कब तक मेंह अपन बिचार म फंसे रहिहूं</para>
  <para style="q2" vid="PSA 13:2">अऊ हर दिन अपन मन म दुखी होवत रहिहूं?</para>
  <para style="q2" vid="PSA 13:2">कब तक मोर बईरी ह मोर ऊपर जय पावत रहिही?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>हे यहोवा मोर परमेसर, मोर कोति देख अऊ जबाब दे,</para>
  <para style="q2" vid="PSA 13:3">मोर आंखी ला देखे के सक्ति दे, नइं तो मेंह मिरतू के नींद म सो जाहूं,<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>नइं तो मोर बईरी ह कहिही, “मेंह ओला जीत डारे हंव,”</para>
  <para style="q2" vid="PSA 13:4">अऊ मोर बईरीमन आनंद मनाहीं, जब में गिर जाहूं।<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>पर मेंह तोर अब्बड़ मया ऊपर भरोसा रखथंव;</para>
  <para style="q2" vid="PSA 13:5">मोर हिरदय ह तोर उद्धार म आनंद मनाथे।<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>मेंह यहोवा के गीत गाहूं,</para>
  <para style="q2" vid="PSA 13:6">काबरकि ओह मोर भलई करे हवय।<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="cl">भजन-संहिता 14</para>
  <para style="d">संगीत के निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1"/>मुरूख ह अपन मन म कहिथे,</para>
  <para style="q2" vid="PSA 14:1">“परमेसर नइं ए।”</para>
  <para style="q1" vid="PSA 14:1">ओमन बिगड़ गे हवंय, ओमन दुस्टता के काम करथें;</para>
  <para style="q2" vid="PSA 14:1">अइसे कोनो नइं ए, जऊन ह भलई करथे।<verse eid="PSA 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>यहोवा ह स्वरग ले</para>
  <para style="q2" vid="PSA 14:2">जम्मो मानव-जाति ला ये आसा म देखथे</para>
  <para style="q1" vid="PSA 14:2">कि कोनो समझदार हवय कि नइं,</para>
  <para style="q2" vid="PSA 14:2">कोनो परमेसर के खोज करथे कि नइं।<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>जम्मो झन भटक गे हवंय, जम्मो झन बिगड़ गे हवंय;</para>
  <para style="q2" vid="PSA 14:3">अइसे कोनो नइं ए, जऊन ह भलई करथे,</para>
  <para style="q2" vid="PSA 14:3">एको झन घलो नइं।<verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>का ये जम्मो दुस्ट काम करइयामन कुछू नइं जानंय?</para>
  <para style="b" vid="PSA 14:4"/>
  <para style="q1" vid="PSA 14:4">ओमन मोर मनखेमन ला अइसे खा जाथें, मानो कि रोटी खावत हें;</para>
  <para style="q2" vid="PSA 14:4">ओमन कभू यहोवा के नांव तक नइं लेवंय।<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>पर उहां, ओमन डर के मारे घबरा गे हवंय,</para>
  <para style="q2" vid="PSA 14:5">काबरकि परमेसर ह धरमीमन के संग हवय।<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>दुस्ट काम करइयामन, तुमन गरीबमन के योजना ला बेकार कर देथव,</para>
  <para style="q2" vid="PSA 14:6">पर यहोवा ह ओमन के सरन-स्थान अय।<verse eid="PSA 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>बने होतिस कि इसरायल बर उद्धार ह सियोन ले बाहिर आतिस!</para>
  <para style="q2" vid="PSA 14:7">जब यहोवा ह अपन मनखेमन ला पहिले के सहीं कर देथे,</para>
  <para style="q2" vid="PSA 14:7">याकूब ह आनंद मनावय अऊ इसरायल ह खुस होवय!<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="cl">भजन-संहिता 15</para>
  <para style="d">दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>हे यहोवा, तोर पबितर तम्बू म कोन निवास कर सकथे?</para>
  <para style="q2" vid="PSA 15:1">तोर पबितर पहाड़ म कोन रह सकथे?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>ओ, जेकर चालचलन ह निरदोस हे,</para>
  <para style="q2" vid="PSA 15:2">जऊन ह धरमी काम करथे,</para>
  <para style="q2" vid="PSA 15:2">जऊन ह अपन हिरदय ले सच बोलथे;<verse eid="PSA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3"/>जेकर मुहूं ले निन्दा के बात नइं निकलय,</para>
  <para style="q2" vid="PSA 15:3">जऊन ह अपन परोसी के बिरूध कोनो गलत काम नइं करय,</para>
  <para style="q2" vid="PSA 15:3">अऊ आने मन के निन्दा नइं करय;<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>जऊन ह दुस्ट मनखे ला तुछ समझथे</para>
  <para style="q2" vid="PSA 15:4">पर ओमन के आदर करथे, जेमन यहोवा ले डरथें;</para>
  <para style="q1" vid="PSA 15:4">जऊन ह हानि उठाके घलो अपन सपथ ला पूरा करथे,</para>
  <para style="q2" vid="PSA 15:4">अऊ अपन मन ला नइं बदलय;<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>जऊन ह बिगर बियाज के गरीब ला अपन पईसा उधार देथे;</para>
  <para style="q2" vid="PSA 15:5">जऊन ह निरदोस मनखे ले घूस नइं लेवय।</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q1" vid="PSA 15:5">जऊन ह ये काममन ला करथे,</para>
  <para style="q2" vid="PSA 15:5">ओह कभू नइं डोलय।<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="cl">भजन-संहिता 16</para>
  <para style="d">दाऊद के एक <char style="tl">मिकताम</char><note caller="+" style="f"><char style="fr" closed="false">16:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>हे मोर परमेसर, मोला सुरकछित रख,</para>
  <para style="q2" vid="PSA 16:1">काबरकि तोर करा मेंह सरन लेवत हंव।<verse eid="PSA 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>मेंह यहोवा ले कहिथंव, “तेंह मोर परभू अस;</para>
  <para style="q2" vid="PSA 16:2">तोर छोंड़ मोर करा अऊ कोनो बने चीज नइं ए।”<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>ओ पबितर मनखे, जऊन मन देस म हवंय, ओमन के बारे मेंह कहिथंव,</para>
  <para style="q2" vid="PSA 16:3">“ओमन उत्तम मनखे अंय, जेमन म मोर जम्मो खुसी हवय।”<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>ओ मनखे, जऊन मन आने देवतामन के पाछू भागथें, ओमन के दुख बढ़ते ही जाही।</para>
  <para style="q2" vid="PSA 16:4">मेंह अइसन देवतामन ला लहू के अरपन नइं करंव</para>
  <para style="q2" vid="PSA 16:4">अऊ न ही मोर मुहूं ले ओमन के नांव लेवंव।<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>हे यहोवा, सिरिप तेंहीच ह मोर हिस्सा अऊ मोर कटोरा अस;</para>
  <para style="q2" vid="PSA 16:5">तेंह मोर हिस्सा ला सुरकछित रखथस।<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>सीमना रेखा ह मोर बर खुसी के जगह म पड़े हवय;</para>
  <para style="q2" vid="PSA 16:6">सही म मोर करा मनभावन बिरासत हवय।<verse eid="PSA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>मेंह यहोवा के परसंसा करहूं, जऊन ह मोला सलाह देथे;</para>
  <para style="q2" vid="PSA 16:7">अऊ त अऊ रथिया के बेरा घलो मोर मन ह मोला सिखोथे।<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>मोर आंखी ह हमेसा यहोवा ऊपर लगे रहिथे।</para>
  <para style="q2" vid="PSA 16:8">ओह मोर जेवनी हांथ कोति हवय, मेंह नइं डोलंव।<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>एकरसेति मोर मन ह खुस हवय अऊ मोर मुहूं ह आनंद मनाथे;</para>
  <para style="q2" vid="PSA 16:9">मोर देहें घलो चैन से अराम करही।<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>काबरकि तेंह मोला मरे मनखेमन के लोक म नइं छोंड़बे,</para>
  <para style="q2" vid="PSA 16:10">अऊ न ही अपन बिसवासयोग्य जन<note caller="+" style="f"><char style="fr" closed="false">16:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">पबितर जन</char></note> ला तेंह सड़न देबे।<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>तेंह मोला जिनगी के रसता देखाथस;</para>
  <para style="q2" vid="PSA 16:11">तेंह अपन आघू म मोला आनंद ले भर देबे,</para>
  <para style="q2" vid="PSA 16:11">तोर जेवनी हांथ म अनंतकाल के खुसी रहिही।<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="cl">भजन-संहिता 17</para>
  <para style="d">दाऊद के एक पराथना।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>हे यहोवा, मोर सच्चई के बिनती ला सुन;</para>
  <para style="q2" vid="PSA 17:1">मोर गोहार ला सुन।</para>
  <para style="q1" vid="PSA 17:1">मोर पराथना ला सुन—</para>
  <para style="q2" vid="PSA 17:1">येह कपटरहित बात बोलइया मुहूं ले निकले हवय।<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>मोर नियाय तोरेच करा ले आथे;</para>
  <para style="q2" vid="PSA 17:2">तोर आंखी ह सही बात ला देखय।<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>हालाकि तेंह मोर मन ला जांचथस,</para>
  <para style="q2" vid="PSA 17:3">हालाकि रथिया तेंह मोला परखथस अऊ मोला जांचथस,</para>
  <para style="q1" vid="PSA 17:3">तभो ले तेंह पाबे कि मेंह कोनो दुस्टता के योजना नइं बनाय हंव;</para>
  <para style="q2" vid="PSA 17:3">मोर मुहूं ह कोनो पाप नइं करे हवय।<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>हालाकि मनखेमन मोला घूस देय के कोसिस करिन,</para>
  <para style="q2" vid="PSA 17:4">पर तोर दिये गय हुकूम के जरिये</para>
  <para style="q2" vid="PSA 17:4">मेंह अपनआप ला गलत काम ले दूरिहा रखे हंव।<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>मोर पांव ह तोर रसता ला धरे हवय;</para>
  <para style="q2" vid="PSA 17:5">मोर गोड़ ह नइं लड़खड़ाय हवय।<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>हे परमेसर, मेंह तोला पुकारत हंव, काबरकि तेंह मोला जबाब देबे;</para>
  <para style="q2" vid="PSA 17:6">अपन कान ला मोर कोति लगा अऊ मोर पराथना ला सुन।<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>अपन बड़े मया के अद्भूत काममन ला मोला देखा,</para>
  <para style="q2" vid="PSA 17:7">तें जऊन ह अपन जेवनी हांथ के दुवारा</para>
  <para style="q2" vid="PSA 17:7">ओमन ला बचाथस, जऊन मन अपन बईरीमन ले तोर करा सरन लेथें।<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>मोला अपन आंखी के पुतली सहीं रख;</para>
  <para style="q2" vid="PSA 17:8">मोला अपन डेना के छइहां म छुपा ले<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>ओ दुस्ट मनखेमन ले, जेमन मोला नास करे बर निकले हवंय,</para>
  <para style="q2" vid="PSA 17:9">ओ मोर मरनहार बईरीमन ले, जेमन मोला घेर ले हवंय।<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>ओमन अपन कठोर हिरदय ला बंद कर लेथें,</para>
  <para style="q2" vid="PSA 17:10">अऊ ओमन के मुहूं ले घमंड के बात निकलथे।<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>ओमन मोर पता लगा ले हवंय, अऊ अब ओमन मोला घेरत हवंय,</para>
  <para style="q2" vid="PSA 17:11">मोला भुइयां म पटके बर ओमन के आंखीमन सचेत हवंय।<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>ओमन सिकार के भूखा एक सिंह सहीं अंय,</para>
  <para style="q2" vid="PSA 17:12">ओ भयंकर सिंह, जऊन ह ओधा लेके घात म बईठे रहिथे।<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>हे यहोवा, उठ, ओमन के सामना कर, ओमन ला पटक दे;</para>
  <para style="q2" vid="PSA 17:13">अपन तलवार के दुवारा मोला दुस्ट ले बचा।<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>हे यहोवा, अपन हांथ के दुवारा मोला अइसन मनखेमन ले बचा,</para>
  <para style="q2" vid="PSA 17:14">ये संसार के ओ मनखेमन ले, जेमन के ईनाम इही जिनगी म हवय।</para>
  <para style="q1" vid="PSA 17:14">ओमन के पेट ओमा ले भरय, जेला तेंह दुस्टमन बर रखे हस;</para>
  <para style="q2" vid="PSA 17:14">ओमन के लइकामन ओमा ले पेट भरके खावंय,</para>
  <para style="q2" vid="PSA 17:14">अऊ ओमा ले ओमन के छोटे लइकामन बर घलो बच जावय।<verse eid="PSA 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>जहां तक मोर बात ए, मेंह बचाय जाहूं अऊ तोर चेहरा ला देखहूं;</para>
  <para style="q2" vid="PSA 17:15">जब मेंह जागहूं, त तोर सरूप ला देखके संतोस करहूं।<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="cl">भजन-संहिता 18<note caller="+" style="f"><char style="fr" closed="false">18 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 18:1-50">18:1‑50</ref></char> ला 18:2‑51 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर यहोवा के सेवक दाऊद के एक भजन। ओह यहोवा बर ये गीत ला तब गाईस, जब यहोवा ह ओला ओकर जम्मो बईरीमन के हांथ ले अऊ साऊल के हांथ ले बचाईस। ओह कहिस:</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>हे यहोवा, मोर बल, मेंह तोर ले मया करथंव।<verse eid="PSA 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>यहोवा ह मोर चट्टान, मोर गढ़ अऊ मोर छुड़ानेवाला अय;</para>
  <para style="q2" vid="PSA 18:2">मोर परमेसर ह मोर चट्टान अय, जेमा मेंह सरन लेथंव,</para>
  <para style="q2" vid="PSA 18:2">ओह मोर ढाल अऊ मोर उद्धार के सींग, मोर मजबूत गढ़ अय।<verse eid="PSA 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>मेंह यहोवा ला पुकारेंव, जऊन ह इस्तुति के योग्य अय,</para>
  <para style="q2" vid="PSA 18:3">अऊ मेंह अपन बईरीमन ले बचाय गे हवंव।<verse eid="PSA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>मिरतू के डोरीमन मोला फंसा लीन;</para>
  <para style="q2" vid="PSA 18:4">भयंकर बिनास के तेज धारा ह मोला घबरा दीस।<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>कबर के डोरीमन मोर चारों कोति रिहिन;</para>
  <para style="q2" vid="PSA 18:5">मिरतू के फांदा ह मोर आघू म रिहिस।<verse eid="PSA 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>मेंह अपन बिपत्ति म यहोवा ला पुकारेंव;</para>
  <para style="q2" vid="PSA 18:6">मेंह अपन परमेसर ले मदद करे बर गोहार लगांय।</para>
  <para style="q1" vid="PSA 18:6">अपन मंदिर ले ओह मोर अवाज ला सुनिस;</para>
  <para style="q2" vid="PSA 18:6">मोर गोहार ह ओकर आघू म, ओकर कान म पड़िस।<verse eid="PSA 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>धरती ह कांपिस अऊ डोलिस,</para>
  <para style="q2" vid="PSA 18:7">अऊ पहाड़मन के नीवमन डोल गीन;</para>
  <para style="q2" vid="PSA 18:7">ओमन कांपे लगिन, काबरकि ओह गुस्सा हो गे रिहिस।<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>ओकर नाक ले धुआं निकलिस;</para>
  <para style="q2" vid="PSA 18:8">ओकर मुहूं ले भसम करइया आगी निकलिस,</para>
  <para style="q2" vid="PSA 18:8">जेमा ले बरत कोइला के जुवाला निकलिस।<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>ओह अकास ला अलग करिस अऊ खाल्हे उतरिस;</para>
  <para style="q2" vid="PSA 18:9">करिया बादरमन ओकर गोड़ के खाल्हे रिहिन।<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>ओह करूब<note caller="+" style="f"><char style="fr" closed="false">18:10 </char><char style="ft" closed="false">येह डेनावाला एक जीव अय, (देखव <char style="xt"><ref loc="EXO 25:17-20">निर 25:17‑20</ref></char>)</char></note> ऊपर सवार होके उड़ गीस;</para>
  <para style="q2" vid="PSA 18:10">ओह हवा के डेनामन म सवार होके बहुंत ऊपर उड़िस।<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>ओह अंधियार ला अपन ओढ़ना बना लीस, ओह ओकर चारों कोति सुघर ओढ़ना रिहिस—</para>
  <para style="q2" vid="PSA 18:11">याने कि अकास के पानीवाले करिया बादरमन।<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>ओकर उपस्थिति के तेज ले बादरमन बढ़िन,</para>
  <para style="q2" vid="PSA 18:12">अऊ करा गिरिस अऊ बिजली कड़किस।<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>यहोवा ह स्वरग ले गरजिस;</para>
  <para style="q2" vid="PSA 18:13">सर्वोच्च परमेसर के अवाज ह गुंजिस।<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>ओह अपन तीरमन ला चलाईस अऊ बईरीमन ला तितिर-बितिर कर दीस,</para>
  <para style="q2" vid="PSA 18:14">बिजली के बड़े कड़क ले ओह ओमन ला हराके भगा दीस।<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>हे यहोवा, तोर घुड़की ले,</para>
  <para style="q2" vid="PSA 18:15">तोर नाक के सांस फूंके ले,</para>
  <para style="q1" vid="PSA 18:15">समुंदर के घाटीमन दिखे लगिन</para>
  <para style="q2" vid="PSA 18:15">अऊ धरती के नीवमन खाली पड़ गीन।<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>ओह ऊपर ले हांथ बढ़ाके मोला थाम लीस;</para>
  <para style="q2" vid="PSA 18:16">ओह मोला गहिरा पानी म ले बाहिर निकालिस।<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>ओह मोला मोर ओ ताकतवर बईरीमन ले, मोर बिरोधीमन ले छोंड़ाईस,</para>
  <para style="q2" vid="PSA 18:17">जेमन बहुंत बलवान रिहिन।<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>ओमन मोर बिपत्ति के दिन म मोर बिरोध करिन,</para>
  <para style="q2" vid="PSA 18:18">पर यहोवा ह मोर सहारा रिहिस।<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>ओह मोला एक ठन चाकर जगह म ले आईस;</para>
  <para style="q2" vid="PSA 18:19">ओह मोला बचाईस, काबरकि ओह मोर ले खुस रिहिस।<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>यहोवा ह मोर धरमीपन के मुताबिक मोर ले बरताव करे हवय;</para>
  <para style="q2" vid="PSA 18:20">मोर हांथ के सुधता के मुताबिक ओह मोला ईनाम दे हवय।<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>काबरकि मेंह यहोवा के रद्दा म चले हवंव;</para>
  <para style="q2" vid="PSA 18:21">मेंह अपन परमेसर के रद्दा ले हट जाय के पाप नइं करे हंव।<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>ओकर जम्मो कानूनमन मोर आघू म हवंय;</para>
  <para style="q2" vid="PSA 18:22">मेंह ओकर बिधिमन ला माने ले नइं हटे हंव।<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>मेंह ओकर आघू म निरदोस रहे हंव</para>
  <para style="q2" vid="PSA 18:23">अऊ मेंह अपनआप ला पाप ले दूरिहा रखे हंव।<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>यहोवा ह मोर धरमीपन के मुताबिक मोला ईनाम दे हवय,</para>
  <para style="q2" vid="PSA 18:24">ओकर नजर म मोर हांथ के सुधता के मुताबिक, ओह मोला ईनाम दे हवय।<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>बिसवासयोग्य मनखे बर तेंह बिसवासयोग्य रहिथस,</para>
  <para style="q2" vid="PSA 18:25">निरदोस मनखे बर तेंह निरदोस रहिथस,<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>सुध मनखे बर तेंह सुध रहिथस,</para>
  <para style="q2" vid="PSA 18:26">पर भटके हुए मनखे बर तेंह चतुर बनथस।<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>तेंह नम्र सुभाव के मनखे ला बचाथस,</para>
  <para style="q2" vid="PSA 18:27">पर घमंड ले चढ़े आंखीवाले ला नीचा देखाथस।<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>हे यहोवा, तेंह मोर दीया ला बारे रखथस;</para>
  <para style="q2" vid="PSA 18:28">मोर परमेसर ह मोर अंधियार ला अंजोर कर देथे।<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>तोर मदद ले मेंह एक सेना के बिरूध जा सकत हंव;</para>
  <para style="q2" vid="PSA 18:29">मोर परमेसर के मदद ले मेंह एक दीवार ऊपर चढ़ सकत हंव।<verse eid="PSA 18:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>जहां तक परमेसर के बात ए, ओकर रसता ह बिलकुल सही ए:</para>
  <para style="q2" vid="PSA 18:30">यहोवा के बचन म कोनो कमी नइं ए;</para>
  <para style="q2" vid="PSA 18:30">ओह ओ जम्मो झन ला बचाथे, जऊन मन ओकर सरन म आथें।<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>काबरकि यहोवा ला छोंड़ कोन ह परमेसर ए?</para>
  <para style="q2" vid="PSA 18:31">अऊ हमर परमेसर ला छोंड़ कोन ह चट्टान ए?<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>येह परमेसर ए, जऊन ह सामर्थ से मोला संभालथे</para>
  <para style="q2" vid="PSA 18:32">अऊ मोर रसता ला सुरकछित रखथे।<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>ओह मोर गोड़ ला हिरन के गोड़ सहीं कर देथे;</para>
  <para style="q2" vid="PSA 18:33">ओह मोला ऊंच जगह म ठाढ़ करथे।<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>ओह मोर हांथमन ला लड़ई करे बर सिखाथे;</para>
  <para style="q2" vid="PSA 18:34">मोर बाहां ह कांसा के धनुस ला मोड़ सकथे।<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>तेंह अपन बचाव के मदद ला मोर ढाल बनाथस,</para>
  <para style="q2" vid="PSA 18:35">अऊ तोर जेवनी हांथ ह मोला संभालथे;</para>
  <para style="q2" vid="PSA 18:35">तोर मदद ह मोला महान कर दे हवय।<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>तेंह मोर पांव बर चाकर रसता देथस,</para>
  <para style="q2" vid="PSA 18:36">जेकर ले मोर एड़ीमन नइं थकंय।<verse eid="PSA 18:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>मेंह अपन बईरीमन के पीछा करके ओमन ला पकड़ लेंव;</para>
  <para style="q2" vid="PSA 18:37">मेंह तब तक नइं लहुंटंय, जब तक कि ओमन नास नइं हो गीन।<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>मेंह ओमन ला कुचर देंव, जेकर ले ओमन उठ नइं सकिन;</para>
  <para style="q2" vid="PSA 18:38">ओमन मोर गोड़ खाल्हे गिर गीन।<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>तेंह मोला लड़ई करे बर ताकत दे हस;</para>
  <para style="q2" vid="PSA 18:39">तेंह मोर बईरीमन ला मोर आघू म झुका दे हस।<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>तेंह मोर बईरीमन ला पीठ देखाके भागे बर बिबस कर दे हस,</para>
  <para style="q2" vid="PSA 18:40">अऊ मेंह मोर बईरीमन ला नास कर देंव।<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>ओमन मदद बर गोहारिन, पर ओमन ला बचानेवाला कोनो नइं रिहिस—</para>
  <para style="q2" vid="PSA 18:41">ओमन यहोवा ला पुकारिन, पर ओह ओमन ला जबाब नइं दीस।<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>मेंह ओमन ला मार-मारके हवा म उड़ियावत धुर्रा के सहीं कर देंव;</para>
  <para style="q2" vid="PSA 18:42">मेंह ओमन ला गली के चीखला सहीं रऊंदेंव।<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>तेंह मोला मनखेमन के हमला ले बचाय हस;</para>
  <para style="q2" vid="PSA 18:43">तेंह मोला जाति-जाति के मनखेमन के मुखिया बनाय हस।</para>
  <para style="q1" vid="PSA 18:43">ओ मनखे, जेमन ला मेंह नइं जानत रहेंव, ओमन अब मोर सेवा करथें,<verse eid="PSA 18:43"/></para>
  <para style="q2">
    <verse number="44" style="v" sid="PSA 18:44"/>परदेसीमन मोर आघू म डरथें;</para>
  <para style="q2" vid="PSA 18:44">मोर अवाज ला सुनतेच ही ओमन मोर हुकूम के पालन करथें।<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>ओ जम्मो झन घबरा जाथें;</para>
  <para style="q2" vid="PSA 18:45">ओमन कांपत अपन गढ़ ले बाहिर निकलथें।<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>यहोवा ह जीयत हवय! मोर चट्टान के परसंसा होवय!</para>
  <para style="q2" vid="PSA 18:46">परमेसर मोर उद्धारकर्ता के बहुंत परसंसा होवय!<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>ओह परमेसर ए, जऊन ह मोर बदला लेथे,</para>
  <para style="q2" vid="PSA 18:47">जऊन ह जाति-जाति के मनखेमन ला मोर अधीन कर देथे,<verse eid="PSA 18:47"/></para>
  <para style="q2">
    <verse number="48" style="v" sid="PSA 18:48"/>जऊन ह मोला मोर बईरीमन ले बचाथे।</para>
  <para style="q1" vid="PSA 18:48">तेंह मोला मोर बिरोधीमन ले ऊंच करे हस;</para>
  <para style="q2" vid="PSA 18:48">एक हिंसक आदमी ले तेंह मोला बचाय हस।<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>एकरसेति हे यहोवा, मेंह जाति-जाति के मनखेमन के बीच तोर परसंसा करहूं;</para>
  <para style="q2" vid="PSA 18:49">मेंह तोर नांव के परसंसा के गीत गाहूं।<verse eid="PSA 18:49"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>ओह अपन राजा ला बड़े बिजय देथे;</para>
  <para style="q2" vid="PSA 18:50">ओह अपन अभिसिक्त जन,</para>
  <para style="q2" vid="PSA 18:50">दाऊद अऊ ओकर संतानमन ऊपर हमेसा अटूट मया देखाथे।<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="cl">भजन-संहिता 19<note caller="+" style="f"><char style="fr" closed="false">19 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 19:1-14">19:1‑14</ref></char> ला 19:2‑15 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>स्वरग ह परमेसर के महिमा के बखान करत हे;</para>
  <para style="q2" vid="PSA 19:1">अकास ह ओकर हांथ के काम ला परगट करत हे।<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>हर दिन ओमन बखान करथें;</para>
  <para style="q2" vid="PSA 19:2">हर रथिया ओमन गियान परगट करथें।<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>ओमन के कोनो बोली नइं ए, ओमन कोनो सबद के उपयोग नइं करंय;</para>
  <para style="q2" vid="PSA 19:3">ओमन ले कोनो अवाज सुनई नइं देय।<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>तभो ले ओमन के अवाज जम्मो धरती म जाथे,</para>
  <para style="q2" vid="PSA 19:4">ओमन के सबद संसार के छोर तक हबरथे।</para>
  <para style="q1" vid="PSA 19:4">अकास म परमेसर ह सूरज बर एक तम्बू ताने हवय।<verse eid="PSA 19:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 19:5"/>येह एक दूल्हा के अपन कमरा ले बाहिर निकलके आय सहीं ए,</para>
  <para style="q2" vid="PSA 19:5">येह एक बिजेता के सहीं अय, जऊन ह अपन दऊड़ ला दऊड़े बर आनंदित हे।<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>येह अकास के एक छोर ले निकलथे</para>
  <para style="q2" vid="PSA 19:6">अऊ दूसर छोर तक चक्कर लगाथे;</para>
  <para style="q2" vid="PSA 19:6">जम्मो चीज ला येकर गरमी मिलथे।<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>यहोवा के कानून ह बिलकुल सही ए,</para>
  <para style="q2" vid="PSA 19:7">अऊ येह आतमा ला ताजा कर देथे।</para>
  <para style="q1" vid="PSA 19:7">यहोवा के बिधिमन भरोसा के लईक अंय,</para>
  <para style="q2" vid="PSA 19:7">अऊ येमन सधारन मनखे ला बुद्धिमान बना देथें।<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>यहोवा के उपदेसमन सही अंय,</para>
  <para style="q2" vid="PSA 19:8">अऊ येमन हिरदय ला आनंदित करथें।</para>
  <para style="q1" vid="PSA 19:8">यहोवा के हुकूममन चमकीला एं,</para>
  <para style="q2" vid="PSA 19:8">अऊ येमन आंखी ला अंजोर देथें।<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>यहोवा के भय ह सुध ए,</para>
  <para style="q2" vid="PSA 19:9">अऊ येह सदाकाल तक बने रहिथे।</para>
  <para style="q1" vid="PSA 19:9">यहोवा के नियममन पक्का अंय,</para>
  <para style="q2" vid="PSA 19:9">अऊ ये जम्मो के जम्मो नियाय के अंय।<verse eid="PSA 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>ओमन सोन ले घलो,</para>
  <para style="q2" vid="PSA 19:10">सुध सोन ले घलो कीमती अंय;</para>
  <para style="q1" vid="PSA 19:10">ओमन मंधरस ले घलो,</para>
  <para style="q2" vid="PSA 19:10">मधुमक्खी के छत्ता के मंधरस ले घलो जादा मीठ अंय।<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>ओमन के दुवारा तोर सेवक ला चेतउनी मिलथे;</para>
  <para style="q2" vid="PSA 19:11">ओमन के पालन करे ले बड़े ईनाम मिलथे।<verse eid="PSA 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>पर अपन खुद के गलती ला कोन समझ सकथे?</para>
  <para style="q2" vid="PSA 19:12">मोर छिपे गलतीमन ला छेमा कर।<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>अपन सेवक ला जानबूझके करइया पाप ले दूरिहा रख;</para>
  <para style="q2" vid="PSA 19:13">ओमन के अधिकार मोर ऊपर झन होवय।</para>
  <para style="q1" vid="PSA 19:13">तब मेंह निरदोस होहूं,</para>
  <para style="q2" vid="PSA 19:13">अऊ बड़े अपराध के दोसी नइं होहूं।<verse eid="PSA 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>हे यहोवा, मोर चट्टान अऊ मोर छुड़इया,</para>
  <para style="q2" vid="PSA 19:14">मोर मुहूं के ये बचन</para>
  <para style="q2" vid="PSA 19:14">अऊ मोर मन के ये बिचार तोला भावय।<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="cl">भजन-संहिता 20<note caller="+" style="f"><char style="fr" closed="false">20 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 20:1-9">20:1‑9</ref></char> ला 20:2‑10 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>बिपत्ति के बेरा म यहोवा ह तोर बिनती के जबाब देवय;</para>
  <para style="q2" vid="PSA 20:1">याकूब के परमेसर के नांव ह तोला बचावय।<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>पबितर-स्थान ले ओह तोर बर मदद पठोवय</para>
  <para style="q2" vid="PSA 20:2">अऊ सियोन ले तोला मदद देवय।<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>ओह तोर जम्मो बलिदान ला सुरता करय;</para>
  <para style="q2" vid="PSA 20:3">अऊ तोर होम-बलिदान ला स्वीकार करय।<verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>ओह तोर मन के ईछा ला पूरा करय</para>
  <para style="q2" vid="PSA 20:4">अऊ तोर जम्मो योजना ला सफल करय।<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>हमन तोर जय के कारन आनंद के मारे चिचियावन</para>
  <para style="q2" vid="PSA 20:5">अऊ अपन परमेसर के नांव के झंडा ला ऊंचा करन।</para>
  <para style="b" vid="PSA 20:5"/>
  <para style="q1" vid="PSA 20:5">यहोवा ह तोर जम्मो बिनती ला पूरा करय।<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>अब ये बात मेंह जानत हंव:</para>
  <para style="q2" vid="PSA 20:6">यहोवा ह अपन अभिसिक्त जन ला बिजयी बनाथे।</para>
  <para style="q1" vid="PSA 20:6">ओह ओला अपन स्वरगीय पबितर-स्थान ले</para>
  <para style="q2" vid="PSA 20:6">अपन जेवनी हांथ के बिजयी सक्ति के संग जबाब देथे।<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>कुछू मनखेमन रथ ऊपर अऊ कुछू मनखेमन घोड़ामन ऊपर भरोसा करथें,</para>
  <para style="q2" vid="PSA 20:7">पर हमन तो यहोवा हमर परमेसर के नांव ऊपर भरोसा करथन।<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>ओमन ला ओमन के माड़ी म लाय जाथे अऊ ओमन गिरथें,</para>
  <para style="q2" vid="PSA 20:8">पर हमन उठके मजबूती से खड़े रहिथन।<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>हे यहोवा, राजा ला बिजयी बना!</para>
  <para style="q2" vid="PSA 20:9">जब हमन पुकारथन, त हमन ला जबाब दे!<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="cl">भजन-संहिता 21<note caller="+" style="f"><char style="fr" closed="false">21 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 21:1-13">21:1‑13</ref></char> ला 21:2‑14 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>हे यहोवा, राजा ह तोर सामर्थ म आनंदित होथे।</para>
  <para style="q2" vid="PSA 21:1">तोर दिये गे बिजय म ओला बहुंत आनंद मिलथे!<verse eid="PSA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>तेंह ओकर हिरदय के ईछा ला पूरा करे हस</para>
  <para style="q2" vid="PSA 21:2">अऊ ओकर मुहूं के बिनती ला अस्वीकार नइं करे हस।<verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>तेंह उत्तम आसीस के संग ओकर ले मिले बर आय</para>
  <para style="q2" vid="PSA 21:3">अऊ ओकर मुड़ म सुध सोन के मुकुट पहिराय हस।<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>ओह तोर ले जिनगी मांगिस, अऊ तेंह ओला जिनगी देय—</para>
  <para style="q2" vid="PSA 21:4">तेंह ओकर जिनगी ला सदाकाल बर बढ़ाय।<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>जऊन जय तेंह ओला दे हस, ओकर महिमा ह बड़े ए;</para>
  <para style="q2" vid="PSA 21:5">तेंह ओला सोभा अऊ महिमा दे हस।<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>सही म तेंह ओला खतम नइं होवइया आसीस दे हस</para>
  <para style="q2" vid="PSA 21:6">अऊ अपन उपस्थिति के आनंद ले ओला खुस कर दे हस।<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>काबरकि राजा ह यहोवा ऊपर भरोसा करथे;</para>
  <para style="q2" vid="PSA 21:7">सर्वोच्च परमेसर के बड़े मया के कारन</para>
  <para style="q2" vid="PSA 21:7">ओह अटल बने रहिही।<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>तोर हांथ ह तोर जम्मो बईरीमन के ऊपर पड़ही;</para>
  <para style="q2" vid="PSA 21:8">तोर जेवनी हांथ ह तोर बईरीमन ला धर लीही।<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>जब तेंह लड़ई करे बर परगट होबे,</para>
  <para style="q2" vid="PSA 21:9">त तेंह ओमन ला बरत भट्ठी म बारे सहीं बार देबे।</para>
  <para style="q1" vid="PSA 21:9">यहोवा ह अपन कोप म ओमन ला लील जाही,</para>
  <para style="q2" vid="PSA 21:9">अऊ ओकर आगी ह ओमन ला भसम कर दीही।<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>तेंह ओमन के संतानमन ला धरती ले नास कर देबे,</para>
  <para style="q2" vid="PSA 21:10">मानव-जाति ले ओमन के बंस ला मिटा देबे।<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>हालाकि ओमन तोर बिरूध सडयंत्र रचथें</para>
  <para style="q2" vid="PSA 21:11">अऊ दुस्ट योजना बनाथें, पर ओमन सफल नइं होवंय।<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>जब तेंह अपन धनुस ले ओमन ला अपन निसाना बनाबे।</para>
  <para style="q2" vid="PSA 21:12">त ओमन अपन पीठ देखाके भागहीं।<verse eid="PSA 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>हे यहोवा, तोर सामर्थ ह अऊ बढ़य;</para>
  <para style="q2" vid="PSA 21:13">हमन तोर सक्ति के गीत गाबो अऊ परसंसा करबो।<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="cl">भजन-संहिता 22<note caller="+" style="f"><char style="fr" closed="false">22 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 22:1-31">22:1‑31</ref></char> ला 22:2‑32 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। “बिहनियां के मादा हिरन” के धुन म दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>हे मोर परमेसर, हे मोर परमेसर, तेंह मोला काबर तियाग दे हस?</para>
  <para style="q2" vid="PSA 22:1">तेंह मोर बचाव काबर नइं करत हस?</para>
  <para style="q2" vid="PSA 22:1">मोर पीरा के गोहार ला काबर नइं सुनत हस?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>हे मोर परमेसर, मेंह दिन म गोहारथंव, पर तेंह जबाब नइं देवस,</para>
  <para style="q2" vid="PSA 22:2">रथिया घलो, मोला अराम नइं मिलय।<verse eid="PSA 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>पर तेंह पबितर परमेसर के रूप म बिराजमान हस;</para>
  <para style="q2" vid="PSA 22:3">तेंह ओ अस, जेकर परसंसा इसरायल करथे।<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>तोर ऊपर ही हमर पुरखामन भरोसा करिन;</para>
  <para style="q2" vid="PSA 22:4">ओमन भरोसा करिन अऊ तेंह ओमन ला छोंड़ाय।<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>तोर ले ओमन गोहारिन अऊ ओमन बचाय गीन;</para>
  <para style="q2" vid="PSA 22:5">तोर ऊपर ओमन भरोसा करिन अऊ ओमन लज्जा म नइं पड़िन।<verse eid="PSA 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>पर में तो एक कीरा अंव, मनखे नइं,</para>
  <para style="q2" vid="PSA 22:6">हर एक जन मोला अपमानित करथें, मनखेमन मोला तुछ समझथें।<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>ओ जम्मो झन, जेमन मोला देखथें, ओमन मोर हंसी उड़ाथें;</para>
  <para style="q2" vid="PSA 22:7">ओमन अपन मुड़ हला-हलाके मोर बेजत्ती करथें।<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>ओमन कहिथें, “ओह यहोवा ऊपर भरोसा करथे,</para>
  <para style="q2" vid="PSA 22:8">यहोवा ह ओला बचावय।</para>
  <para style="q1" vid="PSA 22:8">जब ओह यहोवा म खुस रहिथे,</para>
  <para style="q2" vid="PSA 22:8">त ओही ह ओला छोंड़ावय।”<verse eid="PSA 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>तभो ले तेंह मोला गरभ ले बाहिर लानय,</para>
  <para style="q2" vid="PSA 22:9">जब मेंह दूध पीयत लइका रहेंव, तब ले तेंह मोला तोर ऊपर भरोसा करे बर सिखोय हस।<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>जनम ले ही मोला तोर देखरेख म छोंड़ दिये गीस;</para>
  <para style="q2" vid="PSA 22:10">जब मेंह मोर दाई के गरभ म रहेंव, तब ले ही तेंह मोर परमेसर अस।<verse eid="PSA 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>मोर ले दूरिहा झन रह,</para>
  <para style="q2" vid="PSA 22:11">काबरकि समस्या ह लकठा म हवय</para>
  <para style="q2" vid="PSA 22:11">अऊ कोनो मदद करइया नइं ए,<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>बहुंत अकन सांड़मन मोला घेरत हवंय;</para>
  <para style="q2" vid="PSA 22:12">बासान देस के बलवान सांड़मन मोला चारों कोति ले घेरत हवंय।<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>गरजत सिंह, जेमन अपन सिकार ला फाड़ डालथें,</para>
  <para style="q2" vid="PSA 22:13">ओमन मोर बिरोध म अपन मुहूं खोलत हवंय।<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>मेंह पानी कस ढारे जावत हंव,</para>
  <para style="q2" vid="PSA 22:14">अऊ मोर जम्मो हाड़ामन अपन जोड़ ले खिसक गे हवंय।</para>
  <para style="q1" vid="PSA 22:14">मोर हिरदय ह मोम कस हो गे हवय;</para>
  <para style="q2" vid="PSA 22:14">येह मोर भीतर म ही टघल गे हवय।<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>मोर मुहूं ह माटी के टूटे बरतन सहीं सूखा गे हवय,</para>
  <para style="q2" vid="PSA 22:15">अऊ मोर जीभ ह मोर तालू म चिपकत हे,</para>
  <para style="q2" vid="PSA 22:15">तेंह मोला मिरतू के माटी म लेटाथस।<verse eid="PSA 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>कुकुरमन मोला घेरत हें,</para>
  <para style="q2" vid="PSA 22:16">दुस्ट मनखेमन के एक दल ह मोला चारों कोति ले घेरत हे;</para>
  <para style="q2" vid="PSA 22:16">ओमन मोर हांथ अऊ गोड़मन ला छेदत हवंय।<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>मोर जम्मो हाड़ामन दिखत हवंय;</para>
  <para style="q2" vid="PSA 22:17">मनखेमन मोला घूरथें अऊ गंदा नजर ले देखथें।<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>ओमन मोर ओनहा ला आपस म बांट लेथंय</para>
  <para style="q2" vid="PSA 22:18">अऊ मोर कुरता बर चिट्ठी निकालथें।<verse eid="PSA 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>पर हे यहोवा, तेंह मोर ले दूरिहा झन रह।</para>
  <para style="q2" vid="PSA 22:19">तेंह मोर ताकत अस; मोर मदद करे बर जल्दी आ।<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>मोर जिनगी ला तलवार ले बचा,</para>
  <para style="q2" vid="PSA 22:20">मोर बहुमोल जिनगी ला कुकुरमन के सक्ति ले बचा।<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>सिंहमन के मुहूं ले मोला बचा;</para>
  <para style="q2" vid="PSA 22:21">जंगली बईलामन के सींग ले मोला बचा।<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>मेंह अपन भाईमन के आघू म तोर नांव के परचार करहूं;</para>
  <para style="q2" vid="PSA 22:22">सभा के बीच म, मेंह तोर परसंसा करहूं।<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>हे यहोवा के भय मनइयामन, ओकर परसंसा करव!</para>
  <para style="q2" vid="PSA 22:23">हे याकूब के जम्मो संतानमन, ओकर आदर करव!</para>
  <para style="q2" vid="PSA 22:23">हे इसरायल के जम्मो संतानमन, ओकर सम्मान करव!<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>काबरकि ओह दुख म परे मनखे ला तुछ नइं समझे हे</para>
  <para style="q2" vid="PSA 22:24">या ओला छोंड़ नइं दे हे;</para>
  <para style="q1" vid="PSA 22:24">ओह ओकर ले अपन मुहूं नइं छुपाय हवय</para>
  <para style="q2" vid="PSA 22:24">पर मदद बर ओकर गोहार ला सुने हवय।<verse eid="PSA 22:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>बड़े सभा म तोर परसंसा के बिसय तोरेच करा ले आथे;</para>
  <para style="q2" vid="PSA 22:25">जऊन मन तोर भय मानथें, ओमन के आघू म मेंह अपन मन्नत ला पूरा करहूं।<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>गरीबमन खाहीं अऊ संतुस्ट हो जाहीं;</para>
  <para style="q2" vid="PSA 22:26">जऊन मन यहोवा ला खोजथें, ओमन ओकर परसंसा करहीं—</para>
  <para style="q2" vid="PSA 22:26">तुम्हर परान हमेसा जीयत रहय!<verse eid="PSA 22:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>धरती के जम्मो छोर तक मनखेमन यहोवा ला</para>
  <para style="q2" vid="PSA 22:27">सुरता करहीं अऊ ओकर कोति फिरहीं,</para>
  <para style="q1" vid="PSA 22:27">अऊ जाति-जाति के जम्मो परिवारमन</para>
  <para style="q2" vid="PSA 22:27">ओकर आघू म दंडवत करहीं।<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>काबरकि राज ह यहोवा के ही अय</para>
  <para style="q2" vid="PSA 22:28">अऊ जाति-जाति के मनखेमन ऊपर ओहीच ह राज करथे।<verse eid="PSA 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>धरती के जम्मो धनवानमन भोज खाहीं अऊ ओकर अराधना करहीं;</para>
  <para style="q2" vid="PSA 22:29">ओ जम्मो जऊन मन धुर्रा म मिल जाथें, ओमन ओकर आघू म माड़ी टेकहीं—</para>
  <para style="q2" vid="PSA 22:29">ओ मनखे, जऊन मन अपनआप ला जीयत नइं रख सकंय।<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>अवइया पीढ़ी के मनखेमन ओकर सेवा करहीं;</para>
  <para style="q2" vid="PSA 22:30">अवइया पीढ़ी के मनखेमन ला परभू के बारे बताय जाही।<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>ओमन ओकर धरमीपन के बखान करहीं,</para>
  <para style="q2" vid="PSA 22:31">ओ मनखेमन के आघू म बखान करहीं, जेमन अभी जनमे नइं अंय:</para>
  <para style="q2" vid="PSA 22:31">ओह येला करे हवय!<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="cl">भजन-संहिता 23</para>
  <para style="d">दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>यहोवा ह मोर चरवाहा अय, मोला कुछू घटी नइं होवय।<verse eid="PSA 23:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 23:2"/>ओह मोला हरियर-हरियर चरागन म अराम कराथे,</para>
  <para style="q1" vid="PSA 23:2">ओह मोला सांत पानी के तीर म ले जाथे,<verse eid="PSA 23:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 23:3"/>ओह मोर जीव ला तरो-ताजा कर देथे।</para>
  <para style="q1" vid="PSA 23:3">अपन नांव के खातिर</para>
  <para style="q2" vid="PSA 23:3">ओह मोला धरमीपन के रसता म ले चलथे।<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>चाहे मेंह घिटके अंधियार के</para>
  <para style="q2" vid="PSA 23:4">घाटी<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मिरतू के छइहां के घाटी</char></note> म ले होके जावंव,</para>
  <para style="q1" vid="PSA 23:4">तभो ले कोनो अहित होय ले नइं डरंव,</para>
  <para style="q2" vid="PSA 23:4">काबरकि तेंह मोर संग रहिथस;</para>
  <para style="q1" vid="PSA 23:4">तोर सुंटी अऊ तोर लउठी ले</para>
  <para style="q2" vid="PSA 23:4">मोला अराम मिलथे।<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>तेंह मोर बईरीमन के आघू म</para>
  <para style="q2" vid="PSA 23:5">मोर बर जेवन के मेज सजाथस।</para>
  <para style="q1" vid="PSA 23:5">तेंह मोर मुड़ ला तेल ले अभिसेक करथस;</para>
  <para style="q2" vid="PSA 23:5">मोर कटोरा ह छलकत हे।<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>खचित तोर भलई अऊ मया</para>
  <para style="q2" vid="PSA 23:6">मोर जिनगी भर मोर संग रहिही,</para>
  <para style="q1" vid="PSA 23:6">अऊ मेंह सदा-सर्वदा यहोवा के घर म</para>
  <para style="q2" vid="PSA 23:6">निवास करहूं।<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="cl">भजन-संहिता 24</para>
  <para style="d">दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>धरती अऊ येमा के हर एक चीज यहोवा के अय,</para>
  <para style="q2" vid="PSA 24:1">संसार, अऊ ओ जम्मो जेमन येमा रहिथें;<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>काबरकि ओह एकर नीव समुंदरमन के ऊपर रखिस</para>
  <para style="q2" vid="PSA 24:2">अऊ पानी के ऊपर येला इस्थिर करिस।<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>यहोवा के पहाड़ ऊपर कोन चढ़ सकत हे?</para>
  <para style="q2" vid="PSA 24:3">ओकर पबितर स्थान म कोन ठाढ़ हो सकत हे?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>ओह, जेकर काम सही अऊ हिरदय सुध हवय,</para>
  <para style="q2" vid="PSA 24:4">जऊन ह मूरती ऊपर भरोसा नइं करय</para>
  <para style="q2" vid="PSA 24:4">या लबरा ईस्वर के सपथ नइं खावय।<verse eid="PSA 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>ओह यहोवा ले आसीस पाही</para>
  <para style="q2" vid="PSA 24:5">अऊ ओला अपन उद्धार करइया परमेसर ले सुरकछा मिलही।<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>अइसने ही होथे ओमन के पीढ़ी, जऊन मन परमेसर के खोज करथें,</para>
  <para style="q2" vid="PSA 24:6">हे याकूब के परमेसर, जऊन मन तोर दरसन के खोज म रहिथें।<verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>हे दुवारमन, अपन मुड़ ला ऊंचा करव;</para>
  <para style="q2" vid="PSA 24:7">हे पुराना जमाना के कपाटमन, ऊपर उठव,</para>
  <para style="q2" vid="PSA 24:7">ताकि महिमा के राजा ह भीतर आवय।<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>ये महिमा के राजा कोन ए?</para>
  <para style="q2" vid="PSA 24:8">यहोवा, जऊन ह बलवान अऊ सक्तिसाली ए,</para>
  <para style="q2" vid="PSA 24:8">यहोवा, जऊन ह लड़ई म सक्तिसाली ए।<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>हे दुवारमन, अपन मुड़ ला ऊंचा करव;</para>
  <para style="q2" vid="PSA 24:9">हे पुराना जमाना के कपाटमन, ऊपर उठव,</para>
  <para style="q2" vid="PSA 24:9">ताकि महिमा के राजा ह भीतर आवय।<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>ये महिमा के राजा कोन ए?</para>
  <para style="q2" vid="PSA 24:10">सर्वसक्तिमान यहोवा—</para>
  <para style="q2" vid="PSA 24:10">ओह महिमा के राजा अय।<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="cl">भजन-संहिता 25</para>
  <para style="d">दाऊद के भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>हे यहोवा, मोर परमेसर, तोर ऊपर</para>
  <para style="q2" vid="PSA 25:1">मेंह अपन भरोसा रखथंव।<verse eid="PSA 25:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>मेंह तोर ऊपर भरोसा करथंव;</para>
  <para style="q2" vid="PSA 25:2">मोला सरमिंदा झन होवन दे,</para>
  <para style="q2" vid="PSA 25:2">न ही मोर बईरीमन ला मोर ऊपर जय पावन दे।<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>जऊन ह तोर ऊपर आसा रखथे</para>
  <para style="q2" vid="PSA 25:3">ओह कभू सरमिंदा नइं होही,</para>
  <para style="q1" vid="PSA 25:3">पर सरमिंदा ओमन होहीं</para>
  <para style="q2" vid="PSA 25:3">जऊन मन बिगर कारन के बिसवासघात करथें।<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>हे यहोवा, मोला अपन डहार देखा,</para>
  <para style="q2" vid="PSA 25:4">मोला अपन रसता के बात सिखा।<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>अपन सच्चई म मोर अगुवई कर अऊ मोला सिखा,</para>
  <para style="q2" vid="PSA 25:5">काबरकि तेंह परमेसर मोर उद्धारकर्ता अस,</para>
  <para style="q2" vid="PSA 25:5">अऊ दिन भर मोर आसा ह तोर ऊपर रहिथे।<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>हे यहोवा, अपन बड़े दया अऊ मया ला सुरता कर,</para>
  <para style="q2" vid="PSA 25:6">काबरकि ओमन पुराना जमाना ले हवंय।<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>मोर जवानी के पाप</para>
  <para style="q2" vid="PSA 25:7">अऊ मोर बिदरोही काममन ला सुरता झन कर;</para>
  <para style="q1" vid="PSA 25:7">अपन मया के मुताबिक मोला सुरता कर,</para>
  <para style="q2" vid="PSA 25:7">काबरकि हे यहोवा, तेंह बने अस।<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>यहोवा ह बने अऊ ईमानदार अय;</para>
  <para style="q2" vid="PSA 25:8">एकरसेति ओह पापीमन ला अपन तरीका ले सिखाथे।<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>जऊन बात ह सही अय, ओमा ओह नम्र मनखे के अगुवई करथे</para>
  <para style="q2" vid="PSA 25:9">अऊ ओमन ला अपन रसता के सिकछा देथे।<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>जऊन मन यहोवा के करार के बात ला मानथें</para>
  <para style="q2" vid="PSA 25:10">ओमन बर ओकर जम्मो रसतामन मया ले भरे अऊ बिसवासयोग्य अंय।<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>हे यहोवा, अपन नांव के खातिर,</para>
  <para style="q2" vid="PSA 25:11">मोर अपराध ला छेमा कर, हालाकि येह बहुंत बड़े हवय।<verse eid="PSA 25:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>तब ओमन कोन अंय, जेमन यहोवा के भय मानथें?</para>
  <para style="q2" vid="PSA 25:12">ओह ओमन ला ओ रसता म ले जाही, जेला ओह ओमन बर चुनथे।<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>ओमन अमीरी म अपन दिन काटहीं,</para>
  <para style="q2" vid="PSA 25:13">अऊ ओमन के संतानमन देस के ऊपर अधिकार करहीं।<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>यहोवा ह ओमन ऊपर भरोसा रखथे, जेमन ओकर भय मानथें;</para>
  <para style="q2" vid="PSA 25:14">ओह ओमन ला अपन करार के बारे म बताथे।<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>मोर आंखी ह हमेसा यहोवा ऊपर लगे रहिथे,</para>
  <para style="q2" vid="PSA 25:15">काबरकि सिरिप ओहीच ह मोर गोड़ ला फांदा ले छुड़ाही।<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>हे यहोवा, मोर कोति लहुंट अऊ मोर ऊपर अनुग्रह कर,</para>
  <para style="q2" vid="PSA 25:16">काबरकि मेंह अकेला अऊ दुखित हंव।<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>मोर हिरदय के दुख ला दूरिहा कर दे</para>
  <para style="q2" vid="PSA 25:17">अऊ मोला तकलीफ ले छुड़ा ले।<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>मोर दुख अऊ तकलीफ ला देख</para>
  <para style="q2" vid="PSA 25:18">अऊ मोर जम्मो पाप ला दूरिहा कर दे।<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>देख मोर बईरीमन कतेक जादा हवंय</para>
  <para style="q2" vid="PSA 25:19">अऊ कतेक जादा ओमन मोर ले घिन करथें!<verse eid="PSA 25:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>मोर जिनगी के रकछा कर अऊ मोला बचा ले;</para>
  <para style="q2" vid="PSA 25:20">मोला सरमिंदा झन होवन दे,</para>
  <para style="q2" vid="PSA 25:20">काबरकि मेंह तोर सरन ले हवंव।<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>मोर ईमानदारी अऊ सच्चई ह मोला बचावय,</para>
  <para style="q2" vid="PSA 25:21">काबरकि मोर आसा तोर ऊपर हवय।<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>हे परमेसर, इसरायल ला</para>
  <para style="q2" vid="PSA 25:22">ओकर जम्मो संकट ले छोंड़ा ले।<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="cl">भजन-संहिता 26</para>
  <para style="d">दाऊद के भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>हे यहोवा, मोला नियाय दे,</para>
  <para style="q2" vid="PSA 26:1">काबरकि मेंह एक निरदोस जिनगी जीये हवंव;</para>
  <para style="q1" vid="PSA 26:1">मेंह यहोवा ऊपर भरोसा करे हंव</para>
  <para style="q2" vid="PSA 26:1">अऊ नइं डगमगाय हंव।<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>हे यहोवा, मोला परख अऊ मोला जांच,</para>
  <para style="q2" vid="PSA 26:2">मोर हिरदय अऊ मोर मन ला जांच ले;<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>काबरकि तोर अटूट मया के खियाल मोर मन म हमेसा रहिथे</para>
  <para style="q2" vid="PSA 26:3">अऊ मेंह तोर बिसवासयोग्यता के भरोसा म जीयत हंव।<verse eid="PSA 26:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>मेंह धोखेबाजमन के संग म नइं बईठंव,</para>
  <para style="q2" vid="PSA 26:4">अऊ न ही पाखंडीमन के संगति करंव।<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>मेंह गलत काम करइयामन के संगति ले घिन करथंव</para>
  <para style="q2" vid="PSA 26:5">अऊ दुस्टमन के संग नइं बईठंव।<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>हे यहोवा, मेंह अपन हांथ ला निरदोस रखथंव,</para>
  <para style="q2" vid="PSA 26:6">अऊ तोर बेदी करा जाथंव,<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>अऊ ऊंचहा अवाज म तोर परसंसा करथंव</para>
  <para style="q2" vid="PSA 26:7">अऊ तोर जम्मो अद्भूत काममन ला बताथंव।<verse eid="PSA 26:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>हे यहोवा, मेंह ओ घर ले मया करथंव, जिहां तेंह रहिथस,</para>
  <para style="q2" vid="PSA 26:8">ओ जगह जिहां तोर महिमा रहिथे।<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>मोर परान ला पापीमन के संग</para>
  <para style="q2" vid="PSA 26:9">अऊ मोर जिनगी ला खून के पीयासामन के संग झन ले,<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>जेमन के हांथमन दुस्टता के उपाय करथें,</para>
  <para style="q2" vid="PSA 26:10">अऊ जेमन के जेवनी हांथ ह घूसखोरी ले भरे हवय।<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>मेंह तो निरदोस जिनगी जीथंव;</para>
  <para style="q2" vid="PSA 26:11">मोला छोंड़ा ले अऊ मोर ऊपर दया कर।<verse eid="PSA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>मेंह समतल भुइयां म ठाढ़े हवंव;</para>
  <para style="q2" vid="PSA 26:12">सभामन म मेंह यहोवा के इस्तुति करहूं।<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="cl">भजन-संहिता 27</para>
  <para style="d">दाऊद के भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>यहोवा ह मोर अंजोर अऊ मोर उद्धार अय—</para>
  <para style="q2" vid="PSA 27:1">त मेंह काकर ले डरहूं?</para>
  <para style="q1" vid="PSA 27:1">यहोवा ह मोर जिनगी के मजबूत किला अय—</para>
  <para style="q2" vid="PSA 27:1">त काकर ले मेंह भय खाहूं?<verse eid="PSA 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>जब दुस्ट मनखेमन मोला नास<note caller="+" style="f"><char style="fr" closed="false">27:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बदनाम</char></note> करे बर</para>
  <para style="q2" vid="PSA 27:2">मोर बिरूध आघू बढ़थें,</para>
  <para style="q1" vid="PSA 27:2">त ये मोर बईरी अऊ बिरोधीमन ही</para>
  <para style="q2" vid="PSA 27:2">ठोकर खाहीं अऊ गिरहीं।<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>यदि एक सेना घलो मोला घेर ले,</para>
  <para style="q2" vid="PSA 27:3">तभो ले मेंह नइं डरंव;</para>
  <para style="q1" vid="PSA 27:3">यदि मोर बिरोध म लड़ई घलो सुरू हो जावय,</para>
  <para style="q2" vid="PSA 27:3">तभो ले मोला भरोसा रहिही।<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>एक ठन चीज मेंह यहोवा ले मांगथंव,</para>
  <para style="q2" vid="PSA 27:4">सिरिप ये बात मेंह चाहथंव:</para>
  <para style="q1" vid="PSA 27:4">कि अपन जिनगी भर</para>
  <para style="q2" vid="PSA 27:4">मेंह यहोवा के घर म रहंव,</para>
  <para style="q1" vid="PSA 27:4">ताकि यहोवा के सुघरता ला देखंव</para>
  <para style="q2" vid="PSA 27:4">अऊ ओकर मंदिर म ओकर धियान करंव।<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>काबरकि बिपत्ति के दिन म</para>
  <para style="q2" vid="PSA 27:5">ओह मोला अपन निवास म सुरकछित रखही;</para>
  <para style="q1" vid="PSA 27:5">ओह अपन पबितर तम्बू के खाल्हे म मोला छिपा लीही</para>
  <para style="q2" vid="PSA 27:5">अऊ एक चट्टान के ऊपर ऊंचहा जगह म रखही।<verse eid="PSA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>तब मोर मुड़ ह ओ बईरीमन के आघू म ऊपर हो जाही</para>
  <para style="q2" vid="PSA 27:6">जऊन मन मोला चारों कोति ले घेरथें;</para>
  <para style="q1" vid="PSA 27:6">ओकर पबितर तम्बू म मेंह आनंद के मारे चिचियावत बलिदान चघाहूं;</para>
  <para style="q2" vid="PSA 27:6">मेंह यहोवा बर गीत गाहूं अऊ बाजा बजाहूं।<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>हे यहोवा, जब मेंह गोहारंव, त मोर अवाज ला सुन;</para>
  <para style="q2" vid="PSA 27:7">मोर ऊपर दया करके मोला जबाब दे।<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>मोर हिरदय ह तोर बारे कहिथे, “ओकर चेहरा के खोज म रह!”</para>
  <para style="q2" vid="PSA 27:8">हे यहोवा, मेंह तोरेच दरसन के खोज म रहिहूं।<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>तेंह मोर ले अपन चेहरा झन छिपा,</para>
  <para style="q2" vid="PSA 27:9">गुस्सा होके अपन सेवक ला दूरिहा झन कर दे;</para>
  <para style="q2" vid="PSA 27:9">तेंह मोर मदद करइया रहे हस।</para>
  <para style="q1" vid="PSA 27:9">हे परमेसर मोर उद्धारकर्ता,</para>
  <para style="q2" vid="PSA 27:9">मोला अस्वीकार झन कर या मोला झन तियाग।<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>भले ही मोर दाई-ददा मोला तियाग देवंय,</para>
  <para style="q2" vid="PSA 27:10">पर यहोवा ह मोला गरहन करही।<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>हे यहोवा, मोला अपन रसता के बात सिखा;</para>
  <para style="q2" vid="PSA 27:11">मोर ऊपर अतियाचार करइयामन के कारन</para>
  <para style="q2" vid="PSA 27:11">मोला सीधा रसता म ले चल।<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>मोर बईरीमन के ईछा ऊपर मोला झन छोंड़ दे,</para>
  <para style="q2" vid="PSA 27:12">काबरकि लबरा गवाहमन मोर बिरूध ठाढ़ होथें,</para>
  <para style="q2" vid="PSA 27:12">अऊ जलन से भरके मोर ऊपर दोस लगाथें।<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>मोला ये बात के भरोसा हवय:</para>
  <para style="q2" vid="PSA 27:13">कि जीयत परानीमन के देस म</para>
  <para style="q2" vid="PSA 27:13">मेंह यहोवा के भलई ला देखहूं।<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>यहोवा के बाट जोहत रहव;</para>
  <para style="q2" vid="PSA 27:14">मजबूत बनव अऊ हिम्मत रखव</para>
  <para style="q2" vid="PSA 27:14">अऊ यहोवा के बाट जोहत रहव।<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="cl">भजन-संहिता 28</para>
  <para style="d">दाऊद के भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>हे यहोवा, मेंह तोहीच ला पुकारथंव;</para>
  <para style="q2" vid="PSA 28:1">तेंह मोर चट्टान अस,</para>
  <para style="q2" vid="PSA 28:1">मोर गोठ ला अनसुना झन कर।</para>
  <para style="q1" vid="PSA 28:1">काबरकि यदि तेंह चुपचाप रहिबे,</para>
  <para style="q2" vid="PSA 28:1">त मेंह ओ मरे मनखेमन सहीं हो जाहूं, जऊन मन कबर म चले जाथें।<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>जब मेंह मदद बर तोला पुकारंव,</para>
  <para style="q2" vid="PSA 28:2">जब मेंह तोर महा पबितर स्थान कोति</para>
  <para style="q1" vid="PSA 28:2">अपन हांथ उठावंव,</para>
  <para style="q2" vid="PSA 28:2">त दया के मोर गोहार ला सुन ले।<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>ओ दुस्ट मनखेमन संग मोला घसीटके अलग झन कर,</para>
  <para style="q2" vid="PSA 28:3">ओमन के संग, जऊन मन दुस्ट काम करथें,</para>
  <para style="q1" vid="PSA 28:3">जऊन मन अपन परोसी संग मया के गोठ करथें,</para>
  <para style="q2" vid="PSA 28:3">पर ओमन के मन म बुरई के बात रहिथे।<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>ओमन के काम अऊ बुरई के काम बर</para>
  <para style="q2" vid="PSA 28:4">ओमन ले बदला ले;</para>
  <para style="q1" vid="PSA 28:4">ओमन ले ओमन के काम के बदला ले</para>
  <para style="q2" vid="PSA 28:4">ओमन के दुस्ट काम के मुताबिक ओमन ला दंड दे।<verse eid="PSA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>काबरकि ओमन यहोवा के काम ऊपर</para>
  <para style="q2" vid="PSA 28:5">अऊ ओह जऊन कुछू करथे, ओकर ऊपर धियान नइं देवंय,</para>
  <para style="q1" vid="PSA 28:5">एकरसेति ओह ओमन ला नास कर दीही</para>
  <para style="q2" vid="PSA 28:5">अऊ ओमन ला फेर कभू नइं उठाही।<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>यहोवा के परसंसा होवय,</para>
  <para style="q2" vid="PSA 28:6">काबरकि ओह दया के मोर गोहार ला सुने हवय।<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>यहोवा ह मोर बल अऊ मोर ढाल अय;</para>
  <para style="q2" vid="PSA 28:7">मोर मन ह ओकर ऊपर भरोसा करथे, अऊ ओह मोर मदद करथे।</para>
  <para style="q1" vid="PSA 28:7">मोर मन ह आनंद ले भर गे हवय,</para>
  <para style="q2" vid="PSA 28:7">अऊ अपन गीत के दुवारा मेंह ओकर परसंसा करथंव।<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>यहोवा ह अपन मनखेमन के बल अय,</para>
  <para style="q2" vid="PSA 28:8">अऊ अपन अभिसिक्त जन बर उद्धार के एक गढ़ अय।<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>हे यहोवा, अपन मनखेमन ला बचा अऊ अपन निज भाग ला आसीस दे;</para>
  <para style="q2" vid="PSA 28:9">ओमन के चरवाहा बन अऊ ओमन ला हमेसा संभाले रह।<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="cl">भजन-संहिता 29</para>
  <para style="d">दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>हे स्वरगीय जीवमन,<note caller="+" style="f"><char style="fr" closed="false">29:1 </char><char style="fq" closed="false">स्वरगीय जीवमन </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">स्वरगदूतमन </char><char style="ft" closed="false">हो सकथे</char></note> यहोवा के बखान करव,</para>
  <para style="q2" vid="PSA 29:1">यहोवा के महिमा अऊ बल के बखान करव।<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>यहोवा के नांव के मुताबिक ओकर बखान करव;</para>
  <para style="q2" vid="PSA 29:2">यहोवा के पबितरता के सोभा म ओकर अराधना करव।<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>यहोवा के अवाज समुंदर के ऊपर म हवय;</para>
  <para style="q2" vid="PSA 29:3">महिमा के परमेसर ह गरजथे,</para>
  <para style="q2" vid="PSA 29:3">यहोवा ह समुंदर के भयंकर लहरामन ऊपर गरजथे।<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>यहोवा के अवाज ह सक्तिसाली अय;</para>
  <para style="q2" vid="PSA 29:4">यहोवा के अवाज ह सानदार हवय।<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>यहोवा के अवाज ह देवदार के रूख ला टोर देथे;</para>
  <para style="q2" vid="PSA 29:5">यहोवा ह लबानोन के देवदार रूखमन ला कुटा-कुटा कर देथे।<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>ओह लबानोन ला एक बछरू के सहीं</para>
  <para style="q2" vid="PSA 29:6">अऊ सिरयोन<note caller="+" style="f"><char style="fr" closed="false">29:6 </char><char style="ft" closed="false">हेरमोन पहाड़</char></note> ला जंगली बईला के सहीं उछालथे।<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>यहोवा के अवाज ह</para>
  <para style="q2" vid="PSA 29:7">बिजली के चमक के संग चोट करथे।<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>यहोवा के अवाज ह बीरान भुइयां ला हला देथे;</para>
  <para style="q2" vid="PSA 29:8">यहोवा ह कादेस के बीरान भुइयां ला घलो हला देथे।<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>यहोवा के अवाज ह बांज के रूख ला मुरकेट देथे<note caller="+" style="f"><char style="fr" closed="false">29:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यहोवा ह हिरन ले पीला जनमवाथे</char></note></para>
  <para style="q2" vid="PSA 29:9">अऊ जंगल म पतझड़ हो जाथे।</para>
  <para style="q1" vid="PSA 29:9">अऊ ओकर मंदिर म जम्मो झन चिचियाके कहिथें, “परमेसर के महिमा होवय!”<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>यहोवा ह बाढ़ के पानी ऊपर बिराजमान होथे;</para>
  <para style="q2" vid="PSA 29:10">यहोवा ह सदाकाल बर राजा के रूप म बिराजमान होथे।<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>यहोवा ह अपन मनखेमन ला ताकत देथे;</para>
  <para style="q2" vid="PSA 29:11">यहोवा ह अपन मनखेमन ला सांति के आसीस देथे।<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="cl">भजन-संहिता 30<note caller="+" style="f"><char style="fr" closed="false">30 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 30:1-12">30:1‑12</ref></char> ला 30:2‑13 गने गे हवय</char></note></para>
  <para style="d">मंदिर<note caller="+" style="f"><char style="fr" closed="false">30:0 </char><char style="fl" closed="false">या </char><char style="fqa" closed="false">महल</char></note> के समरपन बर दाऊद के एक भजन। एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>हे यहोवा, मेंह तोर बहुंत परसंसा करहूं,</para>
  <para style="q2" vid="PSA 30:1">काबरकि तेंह मोला खंचवा ले ऊपर निकाले हस</para>
  <para style="q2" vid="PSA 30:1">अऊ मोर बईरीमन ला मोर ऊपर आनंद करे बर नइं दे हस।<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>हे यहोवा मोर परमेसर, मेंह तोला मदद बर पुकारेंव,</para>
  <para style="q2" vid="PSA 30:2">अऊ तेंह मोला चंगा करय।<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>हे यहोवा, तेंह मोला मिरतू-लोक ले निकाले हस;</para>
  <para style="q2" vid="PSA 30:3">तेंह मोला खाल्हे खंचवा म जाय ले बचाय हस।<verse eid="PSA 30:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>हे यहोवा के बिसवासयोग्य मनखेमन, तुमन ओकर महिमा के गीत गावव;</para>
  <para style="q2" vid="PSA 30:4">ओकर पबितर नांव के परसंसा करव।<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>काबरकि ओकर गुस्सा छीन भर के होथे,</para>
  <para style="q2" vid="PSA 30:5">पर ओकर किरपा ह जिनगी भर रहिथे;</para>
  <para style="q1" vid="PSA 30:5">रोवई ह रथिया भर रह सकथे,</para>
  <para style="q2" vid="PSA 30:5">पर आनंद के समय ह बिहनियां आथे।<verse eid="PSA 30:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>जब मेंह सुरकछित महसूस करेंव, त मेंह अपनआप ला कहेंव,</para>
  <para style="q2" vid="PSA 30:6">“मेंह कभूच नइं डोलंव।”<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>हे यहोवा, जब तेंह मोर ऊपर किरपा करय,</para>
  <para style="q2" vid="PSA 30:7">त तेंह मोर साही पहाड़<note caller="+" style="f"><char style="fr" closed="false">30:7 </char><char style="ft" closed="false">सियोन पहाड़</char></note> ला मजबूती से खड़े करय;</para>
  <para style="q1" vid="PSA 30:7">पर जब तेंह अपन चेहरा ला छिपा लेय,</para>
  <para style="q2" vid="PSA 30:7">त मेंह डर गेंव।<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>हे यहोवा, तोला मेंह पुकारेंव;</para>
  <para style="q2" vid="PSA 30:8">परभू ला मेंह दया बर गोहारेंव:<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“का फायदा होही यदि मेंह मर जावंव त,</para>
  <para style="q2" vid="PSA 30:9">यदि मेंह खाल्हे कबर म चले जावंव त?</para>
  <para style="q1" vid="PSA 30:9">का माटी ह तोर महिमा करही?</para>
  <para style="q2" vid="PSA 30:9">का येह तोर बिसवासयोग्यता के बखान करही?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>हे यहोवा, मोर बात ला सुन, अऊ मोर ऊपर दया कर;</para>
  <para style="q2" vid="PSA 30:10">हे यहोवा, मोर मदद कर।”<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>तेंह मोर बिलाप करई ला नचई म बदल दे हस;</para>
  <para style="q2" vid="PSA 30:11">तेंह मोर दुख के कपड़ा ला हटाके मोला आनंद के कपड़ा पहिराय हस,<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>ताकि मोर मन ह तोर महिमा के गीत गावय अऊ चुप झन रहय।</para>
  <para style="q2" vid="PSA 30:12">हे यहोवा मोर परमेसर, मेंह हमेसा तोर परसंसा करहूं।<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="cl">भजन-संहिता 31<note caller="+" style="f"><char style="fr" closed="false">31 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 31:1-24">31:1‑24</ref></char> ला 31:2‑25 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>हे यहोवा, मेंह तोर सरन म हंव;</para>
  <para style="q2" vid="PSA 31:1">मोला कभू लज्जित झन होवन दे;</para>
  <para style="q2" vid="PSA 31:1">अपन धरमीपन के कारन मोला छुड़ा ले।<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>मोर कोति अपन कान लगा,</para>
  <para style="q2" vid="PSA 31:2">अऊ मोला बचाय बर जल्दी आ;</para>
  <para style="q1" vid="PSA 31:2">मोर सरन के चट्टान बन,</para>
  <para style="q2" vid="PSA 31:2">अऊ मोला बचाय बर एक मजबूत गढ़ बन जा।<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>जब तेंह मोर चट्टान अऊ मोर गढ़ अस,</para>
  <para style="q2" vid="PSA 31:3">त अपन नांव के खातिर मोर अगुवई कर अऊ मोला डहार देखा।<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>मोर बर लगाय गे फांदा ले मोला बचा ले,</para>
  <para style="q2" vid="PSA 31:4">काबरकि तेंह मोर सरन लेय के जगह अस।<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>तोर हांथ म मेंह अपन आतमा ला सऊंपत हवंव;</para>
  <para style="q2" vid="PSA 31:5">हे यहोवा, मोर बिसवासयोग्य परमेसर, मोला छोंड़ा ले।<verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>मेंह ओमन ले घिन करथंव, जऊन मन बेकार के मूरतीमन म मन लगाय रहिथें;</para>
  <para style="q2" vid="PSA 31:6">जहां तक मोर बात ए, मेंह यहोवा के ऊपर भरोसा करथंव।<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>मेंह खुस होहूं अऊ तोर मया म आनंद मनाहूं,</para>
  <para style="q2" vid="PSA 31:7">काबरकि तेंह मोर दुख ला देखे हस</para>
  <para style="q2" vid="PSA 31:7">अऊ मोर आतमा के पीरा ला जाने हस।<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>तेंह मोला बईरीमन के हांथ म नइं दे हस</para>
  <para style="q2" vid="PSA 31:8">पर मोर गोड़ ला चाकर जगह म मढ़ाय हस।<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>हे यहोवा, मोर ऊपर दया कर,</para>
  <para style="q2" vid="PSA 31:9">काबरकि मेंह दुख-तकलीफ म हवंव;</para>
  <para style="q1" vid="PSA 31:9">दुख के मारे मोर आंखी, मोर जीव</para>
  <para style="q2" vid="PSA 31:9">अऊ मोर देहें ह कमजोर होवत हे।<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>मोर जिनगी ह दुख-पीरा</para>
  <para style="q2" vid="PSA 31:10">अऊ जम्मो बछरमन कलहरत-कलहरत खतम होवथें;</para>
  <para style="q1" vid="PSA 31:10">मोर दुख<note caller="+" style="f"><char style="fr" closed="false">31:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">दोस</char></note> के कारन मोर ताकत ह कम होवथे,</para>
  <para style="q2" vid="PSA 31:10">अऊ मोर हाड़ामन कमजोर होवत हें।<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>मोर जम्मो बईरीमन के कारन,</para>
  <para style="q2" vid="PSA 31:11">मेंह मोर परोसीमन के बहुंत अपमान के बिसय</para>
  <para style="q1" vid="PSA 31:11">अऊ मोर नजदीकी संगवारीमन बर एक डर के बिसय हो गे हवंव—</para>
  <para style="q2" vid="PSA 31:11">जऊन मन मोला सड़क म देखथें, ओमन मोर ले दूरिहा भागथें।<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>मरे मनखे के सहीं मोला भुला दिये गे हवय;</para>
  <para style="q2" vid="PSA 31:12">मेंह माटी के टूटहा-फूटहा बरतन सहीं हो गे हवंव।<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>मेंह सुनत हंव कि बहुंते जन ये कानाफूसी करत हंय,</para>
  <para style="q2" vid="PSA 31:13">“आतंक ह जम्मो कोति हवय!”</para>
  <para style="q1" vid="PSA 31:13">ओमन मोर बिरूध गोस्टी करथें</para>
  <para style="q2" vid="PSA 31:13">अऊ मोर परान लेय के योजना बनाथें।<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>पर हे यहोवा, मेंह तोर ऊपर भरोसा करथंव;</para>
  <para style="q2" vid="PSA 31:14">मेंह कहिथंव, “तेंह मोर परमेसर अस।”<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>मोर जिनगी ह तोर हांथ म हवय;</para>
  <para style="q2" vid="PSA 31:15">मोला मोर बईरीमन के हांथ ले,</para>
  <para style="q2" vid="PSA 31:15">मोर पीछा करइयामन के हांथ ले छुड़ा।<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>तोर सेवक के ऊपर तोर मुहूं के अंजोर चमकय;</para>
  <para style="q2" vid="PSA 31:16">अपन बहुंत मया के कारन मोर उद्धार कर।<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>हे यहोवा, मोला लज्जित झन होवन दे,</para>
  <para style="q2" vid="PSA 31:17">काबरकि मेंह तोर करा गोहारे हंव;</para>
  <para style="q1" vid="PSA 31:17">पर दुस्ट मनखे ह लज्जित होवय</para>
  <para style="q2" vid="PSA 31:17">अऊ मिरतू-लोक म चुप रहय।<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>ओमन के लबारी बात कहइया मुहूं ह बंद हो जावय,</para>
  <para style="q2" vid="PSA 31:18">काबरकि घमंड अऊ अपमान के संग</para>
  <para style="q2" vid="PSA 31:18">ओमन धरमीमन के बिरूध बड़े अभिमान से गोठियाथें।<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>कतेक जादा हवंय बने-बने चीजमन,</para>
  <para style="q2" vid="PSA 31:19">जेला तेंह ओमन बर कुढ़ोके रखे हस, जेमन तोर भय मानथें,</para>
  <para style="q1" vid="PSA 31:19">ताकि तेंह येला जम्मो के देखत म</para>
  <para style="q2" vid="PSA 31:19">ओमन ला दे, जेमन तोर सरन म आथें।<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>अपन उपस्थिति के आसरय म तेंह ओमन ला</para>
  <para style="q2" vid="PSA 31:20">मनखेमन के जम्मो सडयंत्र ले छुपा लेथस;</para>
  <para style="q1" vid="PSA 31:20">तेंह ओमन ला अपन निवास म</para>
  <para style="q2" vid="PSA 31:20">दोस लगइयामन ले बचाके रखथस।<verse eid="PSA 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>यहोवा के परसंसा होवय,</para>
  <para style="q2" vid="PSA 31:21">काबरकि जब मेंह बईरीमन ले घेराय एक सहर म रहेंव,</para>
  <para style="q2" vid="PSA 31:21">त ओह मोला अपन अद्भूत मया देखाईस।<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>घबराहट म मेंह कहेंव,</para>
  <para style="q2" vid="PSA 31:22">“मेंह तोर नजर ले दूरिहा हो गे हवंव!”</para>
  <para style="q1" vid="PSA 31:22">तभो ले जब मेंह तोला मदद बर पुकारेंव,</para>
  <para style="q2" vid="PSA 31:22">त तेंह मोर दया के गोहार ला सुनय।<verse eid="PSA 31:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>हे ओकर जम्मो बिसवासयोग्य मनखेमन, यहोवा ले मया करव!</para>
  <para style="q2" vid="PSA 31:23">यहोवा ह ओमन ला सुरकछित रखथे, जऊन मन ओकर बर ईमानदार रहिथें,</para>
  <para style="q2" vid="PSA 31:23">पर घमंडी मनखे ले ओह पूरा बदला लेथे।<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>हे यहोवा ऊपर आसा रखइया जम्मो मनखेमन,</para>
  <para style="q2" vid="PSA 31:24">मजबूत बनव अऊ धीरज धरे रहव।<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="cl">भजन-संहिता 32</para>
  <para style="d">दाऊद के एक <char style="tl">मसकील</char><note caller="+" style="f"><char style="fr" closed="false">32:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>धइन अय ओ मनखे,</para>
  <para style="q2" vid="PSA 32:1">जेकर अपराध छेमा करे जाथे,</para>
  <para style="q2" vid="PSA 32:1">जेकर पाप तोपे जाथे।<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>धइन अय ओ मनखे,</para>
  <para style="q2" vid="PSA 32:2">जेकर पाप ला यहोवा ह ओकर बिरूध नइं गनय</para>
  <para style="q2" vid="PSA 32:2">अऊ जेकर आतमा म कोनो कपट के बात नइं ए।<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>जब मेंह कलेचुप रहंय,</para>
  <para style="q2" vid="PSA 32:3">त दिन भर कलहरत-कलहरत</para>
  <para style="q2" vid="PSA 32:3">मोर हाड़ामन बेकार होय लगिन।<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>काबरकि रात अऊ दिन</para>
  <para style="q2" vid="PSA 32:4">तोर हांथ ह मोर ऊपर भारी पड़िस;</para>
  <para style="q1" vid="PSA 32:4">अऊ जइसे घाम महिना के घाम म चीजमन सूखा जाथें</para>
  <para style="q2" vid="PSA 32:4">वइसे मोर बल ह कम हो गीस।<verse eid="PSA 32:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>तब मेंह अपन पाप ला तोर आघू म मान लेंव</para>
  <para style="q2" vid="PSA 32:5">अऊ मोर अपराध ला नइं छुपांय।</para>
  <para style="q1" vid="PSA 32:5">मेंह कहेंव, “मेंह यहोवा के आघू म</para>
  <para style="q2" vid="PSA 32:5">अपन पाप ला मान लूहूं।”</para>
  <para style="q1" vid="PSA 32:5">अऊ तेंह मोर पाप के दोस ला</para>
  <para style="q2" vid="PSA 32:5">छेमा करय।<verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>एकरसेति जम्मो बिसवासयोग्य मनखेमन तोर ले पराथना करंय</para>
  <para style="q2" vid="PSA 32:6">जब तेंह मिल सकत हस;</para>
  <para style="q1" vid="PSA 32:6">खचित संकट रूपी पानी के भयंकर लहरामन</para>
  <para style="q2" vid="PSA 32:6">ओमन करा नइं हबरहीं।<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>तेंह मोर छुपे के जगह अस;</para>
  <para style="q2" vid="PSA 32:7">तेंह मोला संकट ले बचाबे</para>
  <para style="q2" vid="PSA 32:7">अऊ छुटकारा के गीत म मोला घेर लेबे।<verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>मेंह तोला निरदेस दूहूं अऊ ओ रसता के बात सिखाहूं, जेमा तोला जाना चाही;</para>
  <para style="q2" vid="PSA 32:8">मेंह तोर ऊपर अपन मया के नजर रखके तोला सलाह दूहूं।<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>तेंह घोड़ा अऊ खच्चर के सहीं झन बन,</para>
  <para style="q2" vid="PSA 32:9">जेमन करा कोनो समझ नइं रहय</para>
  <para style="q1" vid="PSA 32:9">पर ओमन ला काठी अऊ लगाम ले काबू म करे जाथे</para>
  <para style="q2" vid="PSA 32:9">नइं तो ओमन तुम्हर लकठा म नइं आवंय।<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>दुस्टमन के दुख-तकलीफ बहुंत हवय,</para>
  <para style="q2" vid="PSA 32:10">पर यहोवा के अब्बड़ मया ह</para>
  <para style="q2" vid="PSA 32:10">ओमन ला घेरे रहिथे, जऊन मन ओकर ऊपर भरोसा करथें।<verse eid="PSA 32:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>हे धरमी मनखेमन, यहोवा म आनंद मनावव अऊ खुस रहव;</para>
  <para style="q2" vid="PSA 32:11">अऊ हे मन के जम्मो सीधवा मनखेमन, तुमन गीत गावव।<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="cl">भजन-संहिता 33</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>हे धरमी मनखेमन, आनंद ले भर के यहोवा के गीत गावव;</para>
  <para style="q2" vid="PSA 33:1">ईमानदार मनखे बर ओकर परसंसा करई ह जंचथे।<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>बीना बजाके यहोवा के परसंसा करव;</para>
  <para style="q2" vid="PSA 33:2">दस तारवाले बीना बजाके ओकर परसंसा करव।<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>ओकर बर एक नवां गीत गावव;</para>
  <para style="q2" vid="PSA 33:3">कुसलता से बजावव, अऊ आनंद के मारे जय-जयकार करव।<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>काबरकि यहोवा के बचन ह सही अऊ सच अय;</para>
  <para style="q2" vid="PSA 33:4">ओह अपन हर काम म बिसवासयोग्य अय।<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>यहोवा ह धरमीपन अऊ नियाय ले मया करथे;</para>
  <para style="q2" vid="PSA 33:5">धरती ह ओकर अब्बड़ मया ले भरे हवय।<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>अकास-मंडल यहोवा के बचन के दुवारा</para>
  <para style="q2" vid="PSA 33:6">अऊ ओमन के तारागन ओकर मुहूं के सांस के दुवारा बनाय गीन।<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>ओह समुंदर के पानी ला एके ठऊर म रखथे;</para>
  <para style="q2" vid="PSA 33:7">अऊ गहिरा पानी ला भंडार म रखथे।<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>धरती के जम्मो मनखेमन यहोवा के भय मानंय;</para>
  <para style="q2" vid="PSA 33:8">संसार के जम्मो मनखेमन ओकर आदर करंय।<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>काबरकि ओकर कहे ले संसार ह बनिस;</para>
  <para style="q2" vid="PSA 33:9">ओह हुकूम दीस अऊ येह इस्थिर हो गीस।<verse eid="PSA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>यहोवा ह आनजात के मनखेमन के योजना ला बिगाड़ देथे;</para>
  <para style="q2" vid="PSA 33:10">ओह मनखेमन के उदेस्य म बाधा डाल देथे।<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>पर यहोवा के योजना ह हमेसा मजबूत बने रहिथे,</para>
  <para style="q2" vid="PSA 33:11">ओकर मन के उदेस्य ह पीढ़ी-पीढ़ी तक बने रहिथे।<verse eid="PSA 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>धइन अंय ओ जाति के मनखेमन, जेमन के परमेसर यहोवा अय,</para>
  <para style="q2" vid="PSA 33:12">ओ मनखे, जेमन ला ओह अपन वारिस होय बर चुनिस।<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>स्वरग ले यहोवा ह खाल्हे निहारथे</para>
  <para style="q2" vid="PSA 33:13">अऊ जम्मो मानव-जाति ला देखथे;<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>अपन निवास स्थान ले ओह ओ जम्मो झन ला देखत रहिथे,</para>
  <para style="q2" vid="PSA 33:14">जऊन मन धरती म रहिथें—<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>ओ, जऊन ह जम्मो झन के हिरदय ला गढ़थे,</para>
  <para style="q2" vid="PSA 33:15">जऊन ह ओमन के करे गे जम्मो काम ऊपर बिचार करथे।<verse eid="PSA 33:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>कोनो भी राजा अपन बड़े सेना होय के कारन नइं बचय;</para>
  <para style="q2" vid="PSA 33:16">कोनो भी योद्धा अपन बड़े बल के कारन बचके नइं जा सकय।<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>बचके निकले बर घोड़ा ऊपर आसा करई ह बेकार ए;</para>
  <para style="q2" vid="PSA 33:17">अपन अब्बड़ बल के बावजूद येह बचा नइं सकय।<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>पर यहोवा के नजर ह ओमन ऊपर लगे रहिथे, जऊन मन ओकर भय मानथें,</para>
  <para style="q2" vid="PSA 33:18">जऊन मन ओकर बड़े मया के कारन ये आसा लगाय रहिथें,<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>कि ओह ओमन ला मिरतू ले बचाही</para>
  <para style="q2" vid="PSA 33:19">अऊ अकाल के बेरा म घलो ओमन ला जीयत रखही।<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>हमन यहोवा के आस म बाट जोहत रहिथन;</para>
  <para style="q2" vid="PSA 33:20">ओहीच ह हमर मदद अऊ हमर ढाल ए।<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>ओहीच म ही हमर हिरदय ह आनंदित होथे,</para>
  <para style="q2" vid="PSA 33:21">काबरकि हमन ओकर पबितर नांव ऊपर भरोसा करथन।<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>हे यहोवा, जइसे हमन तोर ऊपर अपन आसा रखथन,</para>
  <para style="q2" vid="PSA 33:22">वइसे तोर बड़े मया ह हमर ऊपर बने रहय।<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="cl">भजन-संहिता 34<note caller="+" style="f"><char style="fr" closed="false">34 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 34:1-22">34:1‑22</ref></char> ला 34:2‑23 गने गे हवय</char></note></para>
  <para style="d">दाऊद के एक भजन। जब ओह अबीमेलेक के आघू म पागल होय के नाटक करिस, जेकर से अबीमेलेक ह ओला भगा दीस, अऊ ओह उहां ले भाग गीस।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>मेंह हर समय यहोवा के परसंसा करहूं;</para>
  <para style="q2" vid="PSA 34:1">ओकर परसंसा हमेसा मोर मुहूं ले होवत रहिही।<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>मेंह यहोवा ऊपर घमंड करहूं;</para>
  <para style="q2" vid="PSA 34:2">दुखित-पीड़ित मनखेमन सुनंय अऊ आनंद मनांय।<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>मोर संग यहोवा के महिमा करव;</para>
  <para style="q2" vid="PSA 34:3">आवव, हमन मिलके ओकर नांव के परसंसा करन।<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>मेंह यहोवा ले पराथना करेंव; अऊ ओह मोला जबाब दीस;</para>
  <para style="q2" vid="PSA 34:4">ओह मोला मोर जम्मो डर ले मुक्त करिस।<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>जऊन मन ओकर कोति देखथें, ओमन दीप्तिमान होथें;</para>
  <para style="q2" vid="PSA 34:5">ओमन कभू लज्जित नइं होवंय।<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>ये दीन-हीन मनखे ह पुकारिस, अऊ यहोवा ह ओकर बात ला सुनिस;</para>
  <para style="q2" vid="PSA 34:6">ओह ओला ओकर जम्मो दुख-तकलीफ ले बचाईस।<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>यहोवा के स्वरगदूत ह ओमन के चारों कोति डेरा डालथे, जऊन मन ओकर भय मानथें,</para>
  <para style="q2" vid="PSA 34:7">अऊ ओह ओमन ला छुड़ाथे।<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>परखके देखव कि यहोवा ह बने अय;</para>
  <para style="q2" vid="PSA 34:8">धइन अय ओ मनखे, जऊन ह ओकर करा सरन लेथे।<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>हे ओकर पबितर मनखेमन, तुमन यहोवा के भय मानव,</para>
  <para style="q2" vid="PSA 34:9">काबरकि जऊन मन ओकर भय मानथें, ओमन ला कुछू चीज के घटी नइं होवय।<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>भले ही सिंह ह कमजोर हो सकथे अऊ भूखा रह सकथे,</para>
  <para style="q2" vid="PSA 34:10">पर जऊन मन यहोवा के खोज म रहिथें, ओमन ला कोनो बने चीज के घटी नइं होवय।<verse eid="PSA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>हे मोर लइकामन, आवव, मोर बात ला सुनव;</para>
  <para style="q2" vid="PSA 34:11">मेंह तुमन ला यहोवा के भय मानना सिखोहूं।<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>तुमन म ले जऊन ह भी जिनगी ले मया करथे</para>
  <para style="q2" vid="PSA 34:12">अऊ बहुंते बने दिनमन ला देखे के ईछा करथे,<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>त ओह अपन जीभ ला खराप बात ले</para>
  <para style="q2" vid="PSA 34:13">अऊ अपन मुहूं ला लबारी बात ले दूरिहा रखय।<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>बुरई ला छोंड़के भलई करव;</para>
  <para style="q2" vid="PSA 34:14">सांति के खोज म रहव अऊ ओकर पाछू लगे रहव।<verse eid="PSA 34:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>यहोवा के नजर ह धरमीमन ऊपर लगे रहिथे,</para>
  <para style="q2" vid="PSA 34:15">अऊ ओकर कान ह ओमन के गोहार के तरफ लगे रहिथे;<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>पर यहोवा ह बुरई करइयामन के बिरोध करथे,</para>
  <para style="q2" vid="PSA 34:16">ताकि ओह ओमन के नांव ला धरती ले मिटा देवय।<verse eid="PSA 34:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>धरमीमन गोहारथें, अऊ यहोवा ह ओमन के सुनथे;</para>
  <para style="q2" vid="PSA 34:17">ओह ओमन ला ओमन के जम्मो समस्या ले बाहिर निकालथे।<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>यहोवा ह टूटे मनवाला के लकठा म रहिथे</para>
  <para style="q2" vid="PSA 34:18">अऊ ओमन के उद्धार करथे, जऊन मन आतमा म बहुंत दुखी होथें।<verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>धरमी मनखे करा बहुंत समस्या हो सकथे,</para>
  <para style="q2" vid="PSA 34:19">पर यहोवा ह ओला ओकर जम्मो समस्या ले निकालथे;<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>ओह ओकर जम्मो हाड़ामन के रकछा करथे,</para>
  <para style="q2" vid="PSA 34:20">ओमा के एको ठन घलो नइं टूटय।<verse eid="PSA 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>बुरई ही दुस्ट मनखे ला मार डालही;</para>
  <para style="q2" vid="PSA 34:21">धरमी जन के बईरीमन दोसी ठहिरहीं।<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>यहोवा ह अपन सेवकमन ला बचाही;</para>
  <para style="q2" vid="PSA 34:22">अऊ जऊन ह ओकर करा सरन लेथे, ओह दोसी नइं ठहिरही।<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="cl">भजन-संहिता 35</para>
  <para style="d">दाऊद के भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>हे यहोवा, ओमन के बिरोध कर, जेमन मोर बिरोध करथें;</para>
  <para style="q2" vid="PSA 35:1">ओमन के बिरूध लड़, जेमन मोर बिरूध लड़थें।<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>ढाल अऊ कवच ला ले;</para>
  <para style="q2" vid="PSA 35:2">अऊ उठके मोर मदद करे बर आ।<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>जऊन मन मोर पीछा करथें,</para>
  <para style="q2" vid="PSA 35:3">ओमन के बिरूध बरछी अऊ भाला उठा।</para>
  <para style="q1" vid="PSA 35:3">अऊ मोर आतमा ला कह,</para>
  <para style="q2" vid="PSA 35:3">“मेंह तोर उद्धार अंव।”<verse eid="PSA 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>जऊन मन मोर परान के पाछू पड़े हवंय,</para>
  <para style="q2" vid="PSA 35:4">ओमन कलंकित अऊ लज्जित होवंय;</para>
  <para style="q1" vid="PSA 35:4">जऊन मन मोर बिनास के गोस्टी करथें,</para>
  <para style="q2" vid="PSA 35:4">ओमन भयभीत होके वापिस लहुंटंय।<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>ओमन हवा म उड़ जानेवाला भूंसा के सहीं हो जावंय,</para>
  <para style="q2" vid="PSA 35:5">अऊ यहोवा के स्वरगदूत ह ओमन ला भगा देवय;<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>ओमन के डहार ह अंधियार हो जावय अऊ ओमा फिसलन होवय,</para>
  <para style="q2" vid="PSA 35:6">अऊ यहोवा के स्वरगदूत ह ओमन के पीछा करत रहय।<verse eid="PSA 35:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>काबरकि ओमन बिगर कारन के मोर बर जाल बिछाईन</para>
  <para style="q2" vid="PSA 35:7">अऊ बिगर कारन के मोर बर खंचवा कोड़िन।<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>अचानक ओमन के बिनास हो जावय—</para>
  <para style="q2" vid="PSA 35:8">अपन बिछाय जाल म ओमन खुद फंस जावंय,</para>
  <para style="q2" vid="PSA 35:8">अपन खने खंचवा म ओमन खुद गिरंय, अऊ ओमन के बिनास हो जावय।<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>तब मोर आतमा ह यहोवा म आनंदित होही</para>
  <para style="q2" vid="PSA 35:9">अऊ ओकर करे गे उद्धार ले खुस होही।<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>मोर पूरा हिरदय ह कहिही,</para>
  <para style="q2" vid="PSA 35:10">“हे यहोवा, तोर सहीं कोन हवय?</para>
  <para style="q1" vid="PSA 35:10">तेंह गरीबमन ला ओमन ले बचाथस, जेमन बहुंत बलवान हवंय,</para>
  <para style="q2" vid="PSA 35:10">अऊ गरीब अऊ जरूरतमंद ला ओमन ले बचाथस, जेमन ओमन ला लूटथें।”<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>निरदयी गवाहमन ठाढ़ होथें;</para>
  <para style="q2" vid="PSA 35:11">अऊ ओमन मोर ले ओ बिसय म सवाल करथें, जेकर बारे म मेंह कुछू नइं जानंव।<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>ओमन मोर भलई के बदले मोर ले बुरई करथें</para>
  <para style="q2" vid="PSA 35:12">अऊ मोला एक सोकित मनखे के सहीं छोंड़ देथें।<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>तभो ले जब ओमन बेमार रिहिन, त मेंह ओमन ला दुख के ओनहा ओढ़ांय</para>
  <para style="q2" vid="PSA 35:13">अऊ मेंह अपनआप ला नम्र करके उपास करेंव।</para>
  <para style="q1" vid="PSA 35:13">जब मोर पराथनामन बिगर जबाब के मोर करा लहुंट आईन,<verse eid="PSA 35:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 35:14"/>त मेंह सोक मनांय</para>
  <para style="q2" vid="PSA 35:14">मानो कि मेंह अपन संगी या भाई बर सोक मनात हंव।</para>
  <para style="q1" vid="PSA 35:14">मेंह दुख म अपन मुड़ ला तरी कर लेंव</para>
  <para style="q2" vid="PSA 35:14">मानो कि मेंह अपन दाई बर रोवत हंव।<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>पर जब मेंह ठोकर खांय, त ओमन खुसी से जूर गीन;</para>
  <para style="q2" vid="PSA 35:15">हमला करइयामन मोर बिगर जाने मोर बिरूध जूर गीन।</para>
  <para style="q2" vid="PSA 35:15">ओमन बिगर रूके मोर निन्दा करिन।<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>अधरमी मनखे सहीं ओमन जलन म मोर हंसी उड़ाईन;</para>
  <para style="q2" vid="PSA 35:16">ओमन मोर ऊपर दांत किटकिटाईन।<verse eid="PSA 35:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>हे परभू, तेंह कब तक देखत रहिबे?</para>
  <para style="q2" vid="PSA 35:17">ओमन के बिनास के काम ले मोला बचा,</para>
  <para style="q2" vid="PSA 35:17">मोर अनमोल जिनगी ला सिंहमन के सहीं ये बईरीमन ले बचा।<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>मेंह बड़े सभा म तोला धनबाद दूहूं;</para>
  <para style="q2" vid="PSA 35:18">मनखेमन के भीड़ म मेंह तोर परसंसा करहूं।<verse eid="PSA 35:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>जऊन मन बिगर कारन के मोर बईरी अंय,</para>
  <para style="q2" vid="PSA 35:19">ओमन बुरा नजर से मोला झन देखन पांय;</para>
  <para style="q1" vid="PSA 35:19">जऊन मन बिगर कारन के मोर ले घिन करथें</para>
  <para style="q2" vid="PSA 35:19">ओमन जलन से मोर ऊपर आंखी झन मारन पांय।<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>ओमन सांति के बात नइं करंय,</para>
  <para style="q2" vid="PSA 35:20">पर ओमन ओ मनखेमन के बिरूध लबारी बात कहिथें,</para>
  <para style="q2" vid="PSA 35:20">जेमन देस म सांति से रहिथें।<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>ओमन मोर हंसी उड़ाके कहिथें, “अहा! अहा!</para>
  <para style="q2" vid="PSA 35:21">हमन अपन आंखी ले देखे हवन।”<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>हे यहोवा, तेंह तो येला देखे हस; चुप झन रह।</para>
  <para style="q2" vid="PSA 35:22">हे परभू मोर ले दूरिहा झन रह।<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>जाग, अऊ मोर बचाव करे बर उठ!</para>
  <para style="q2" vid="PSA 35:23">हे मोर परमेसर अऊ हे मोर परभू, मोर बर लड़।<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>हे यहोवा मोर परमेसर, अपन धरमीपन म मोर रकछा कर;</para>
  <para style="q2" vid="PSA 35:24">ओमन ला मोर बिरूध आनंदित झन होवन दे।<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>ओमन ला ये सोचन झन दे, “अहा, इही बात तो हमन चाहत रहेंन!”</para>
  <para style="q2" vid="PSA 35:25">या ओमन ला ये झन कहन दे, “हमन ओला लील ले हन।”<verse eid="PSA 35:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>ओ जम्मो, जऊन मन मोर दुख म खुस होथें,</para>
  <para style="q2" vid="PSA 35:26">ओमन लज्जित होवंय अऊ घबरावंय;</para>
  <para style="q1" vid="PSA 35:26">ओ जम्मो, जऊन मन मोला नीचा दिखाथें,</para>
  <para style="q2" vid="PSA 35:26">ओमन लज्जा अऊ निन्दा ले ढंक जावंय।<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>जऊन मन मोर सही साबित होय म खुस होथें,</para>
  <para style="q2" vid="PSA 35:27">ओमन आनंद अऊ खुसी के जय-जयकार करंय;</para>
  <para style="q1" vid="PSA 35:27">अऊ ओमन हमेसा कहंय, “यहोवा के बड़ई होवय,</para>
  <para style="q2" vid="PSA 35:27">जऊन ह अपन सेवक के कुसलता म खुस होथे।”<verse eid="PSA 35:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>मोर मुहूं ह तोर धरमीपन के बखान करही,</para>
  <para style="q2" vid="PSA 35:28">अऊ दिन भर तोरेच परसंसा करही।<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="cl">भजन-संहिता 36<note caller="+" style="f"><char style="fr" closed="false">36 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 36:1-12">36:1‑12</ref></char> ला 36:2‑13 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर यहोवा के सेवक दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>दुस्ट मनखेमन के दुस्टता के बारे</para>
  <para style="q2" vid="PSA 36:1">मोर हिरदय म एक ठन संदेस हवय:</para>
  <para style="q1" vid="PSA 36:1">ओमन के आंखी के आघू म</para>
  <para style="q2" vid="PSA 36:1">परमेसर के कोनो डर नइं ए।<verse eid="PSA 36:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>ओमन खुद ही अपनआप के अतेक बड़ई करथें</para>
  <para style="q2" vid="PSA 36:2">कि ओमन अपन पाप ला जानंय नइं या ओकर ले घिन नइं करंय।<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>ओमन के मुहूं ले बुरई अऊ धोखा के बात निकलथे;</para>
  <para style="q2" vid="PSA 36:3">ओमन बुद्धिमानी के काम या भलई के काम नइं करंय।<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>अऊ त अऊ ओमन अपन दसना म घलो सडयंत्र रचथें;</para>
  <para style="q2" vid="PSA 36:4">ओमन अपनआप ला पाप के काम करे बर सऊंप देथें</para>
  <para style="q2" vid="PSA 36:4">अऊ खराप काम करे बर मना नइं करंय।<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>हे यहोवा, तोर मया ह स्वरग तक,</para>
  <para style="q2" vid="PSA 36:5">अऊ तोर बिसवासयोग्यता ह अकास तक पहुंचथे।<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>तोर धरमीपन ह सबले ऊंच पहाड़ सहीं अय,</para>
  <para style="q2" vid="PSA 36:6">अऊ तोर नियाय ह समुंदर के गहरई सहीं अय।</para>
  <para style="q2" vid="PSA 36:6">हे यहोवा, तेंह मनखे अऊ पसु दूनों के देखरेख करथस।<verse eid="PSA 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>हे परमेसर, तोर अब्बड़ मया ह अनमोल ए!</para>
  <para style="q2" vid="PSA 36:7">मनखेमन तोर डेना के छइहां म सरन लेथें।<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>ओमन तोर घर के भरे भंडार म ले जेवनार करथें;</para>
  <para style="q2" vid="PSA 36:8">तेंह अपन खुसी के नदी म ले ओमन ला पीये बर देथस।<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>काबरकि तोरेच करा जिनगी के पानी के सोत हवय;</para>
  <para style="q2" vid="PSA 36:9">तोरेच अंजोर म हमन अंजोर देखथन।<verse eid="PSA 36:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>जऊन मन तोला जानथें, ओमन ऊपर अपन मया,</para>
  <para style="q2" vid="PSA 36:10">अऊ मन के सीधवा मनखे ऊपर अपन धरमीपन ला बनाय रख।<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>घमंडी ह मोर ऊपर लात झन उठाय,</para>
  <para style="q2" vid="PSA 36:11">अऊ न ही दुस्ट मनखे मोला अपन हांथ ले भगाय।<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>देखव, दुस्ट काम करइयामन कइसने गिरे-परे हवंय—</para>
  <para style="q2" vid="PSA 36:12">अइसने फटिक दिये गे हवंय कि ओमन अब उठ नइं सकत हवंय!<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="cl">भजन-संहिता 37</para>
  <para style="d">दाऊद के भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>दुस्ट मनखेमन के कारन झन चिढ़व</para>
  <para style="q2" vid="PSA 37:1">या गलत काम करइयामन ले जलन झन करव;<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>काबरकि कांदी के सहीं ओमन अइला जाहीं,</para>
  <para style="q2" vid="PSA 37:2">हरियर पऊधा के सहीं ओमन जल्दी खतम हो जाहीं।<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>यहोवा ऊपर भरोसा रखव अऊ भलई करव;</para>
  <para style="q2" vid="PSA 37:3">देस म रहिके सुरकछित निवास के आनंद उठावव।<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>यहोवा के सेवा करे म खुस रहव,</para>
  <para style="q2" vid="PSA 37:4">अऊ ओह तुम्हर मन के ईछा ला पूरा करही।<verse eid="PSA 37:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>यहोवा ला अपन जिनगी सऊंप दे;</para>
  <para style="q2" vid="PSA 37:5">ओकर ऊपर भरोसा रख अऊ ओह येला करही:<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>ओह तोर धरमीपन के ईनाम ला बिहान के अंजोर सहीं,</para>
  <para style="q2" vid="PSA 37:6">अऊ तोर काम के नियाय ला मंझनियां के सूरज सहीं चमकाही।<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>यहोवा के आघू म चुपेचाप रह</para>
  <para style="q2" vid="PSA 37:7">अऊ धीरज धरके ओकर इंतजार कर;</para>
  <para style="q1" vid="PSA 37:7">जब मनखेमन अपन योजना म सफल होथें</para>
  <para style="q2" vid="PSA 37:7">या अपन दुस्टता के काम ला करंय, त झन कुढ़बे।<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>गुस्सा झन करव अऊ कोप करई ले दूरिहा रहव;</para>
  <para style="q2" vid="PSA 37:8">झन चिढ़व—एकर ले सिरिप बुरई होथे।<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>काबरकि जऊन मन दुस्ट मनखे अंय, ओमन नास करे जाहीं,</para>
  <para style="q2" vid="PSA 37:9">पर जऊन मन यहोवा ऊपर भरोसा करथें, ओमन देस के वारिस होहीं।<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>थोरकन समय अऊ हे, तब दुस्ट मनखेमन खतम हो जाहीं;</para>
  <para style="q2" vid="PSA 37:10">हालाकि तेंह ओमन ला खोजबे, पर ओमन नइं मिलहीं।<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>पर नम्र मनखेमन देस के वारिस होहीं</para>
  <para style="q2" vid="PSA 37:11">अऊ सांति अऊ धन-संपत्ति के आनंद उठाहीं।<verse eid="PSA 37:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>दुस्टमन धरमी मनखेमन के बिरूध साजिस रचथें</para>
  <para style="q2" vid="PSA 37:12">अऊ ओमन ऊपर अपन दांत पीसथें;<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>पर परभू ह दुस्टमन के ऊपर हंसथे,</para>
  <para style="q2" vid="PSA 37:13">काबरकि ओह जानथे कि ओमन के आखिरी दिन ह आवत हे।<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>दुस्टमन अपन तलवार खींचथें,</para>
  <para style="q2" vid="PSA 37:14">अऊ धनुस ला तानथें</para>
  <para style="q1" vid="PSA 37:14">ताकि ओमन गरीब अऊ जरूरतमंद ला नीचा दिखावंय,</para>
  <para style="q2" vid="PSA 37:14">अऊ सीधवा मनखेमन ला मार डारंय।<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>फेर ओमन के तलवार ह ओमन के खुद के हिरदय ला बेधही,</para>
  <para style="q2" vid="PSA 37:15">अऊ ओमन के धनुस ह टूट जाही।<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>धरमी के थोरकन चीज ह</para>
  <para style="q2" vid="PSA 37:16">दुस्टमन के अब्बड़ धन ले जादा बने अय;<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>काबरकि दुस्टमन के सक्ति ला खतम कर दिये जाही,</para>
  <para style="q2" vid="PSA 37:17">पर यहोवा ह धरमी जन ला संभालथे।<verse eid="PSA 37:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>निरदोस मनखेमन यहोवा के देखरेख म दिन बिताथें,</para>
  <para style="q2" vid="PSA 37:18">अऊ ओमन के निज भाग ह हमेसा बने रहिही।<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>बिपत्ति के बेरा ओमन नइं मुरझांय;</para>
  <para style="q2" vid="PSA 37:19">अऊ अकाल के दिन म ओमन भरपूर चीज के आनंद उठाहीं।<verse eid="PSA 37:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>पर दुस्टमन नास हो जाहीं:</para>
  <para style="q2" vid="PSA 37:20">हालाकि यहोवा के बईरीमन खेत के फूल सहीं अंय,</para>
  <para style="q2" vid="PSA 37:20">पर ओमन जलके खतम हो जाहीं, ओमन धुआं म समा जाहीं।<verse eid="PSA 37:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>दुस्टमन उधार लेथें अऊ नइं पटांय,</para>
  <para style="q2" vid="PSA 37:21">पर धरमीमन हांथ खोलके देथें;<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>जेमन ला यहोवा ह आसीस देथे, ओमन देस के वारिस होहीं,</para>
  <para style="q2" vid="PSA 37:22">पर जेमन ला ओह सराप देथे, ओमन नास हो जाहीं।<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>यहोवा ह ओकर पांव ला मजबूत करथे,</para>
  <para style="q2" vid="PSA 37:23">जऊन ह यहोवा म खुस रहिथे;<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>हालाकि ओह लड़खड़ा सकथे, पर ओह गिरय नइं,</para>
  <para style="q2" vid="PSA 37:24">काबरकि यहोवा ह ओला अपन हांथ ले संभालथे।<verse eid="PSA 37:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>मेंह जवान रहेंव अऊ अब डोकरा हो गे हंव,</para>
  <para style="q2" vid="PSA 37:25">पर मेंह ये बात कभू नइं देखेंव कि धरमीमन ला तियाग दिये गीस</para>
  <para style="q2" vid="PSA 37:25">या ओमन के लइकामन खाय बर भीख मांगिन।<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>ओमन हमेसा उदार दिल के होथें अऊ दिल खोलके उधार देथें;</para>
  <para style="q2" vid="PSA 37:26">ओमन के लइकामन एक आसीस के कारन बनहीं।<note caller="+" style="f"><char style="fr" closed="false">37:26 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">आने मनखेमन देखहीं कि ओमन के लइकामन आसीसित हवंय</char></note><verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>बुरई ला छोंड़व अऊ भलई करव;</para>
  <para style="q2" vid="PSA 37:27">तब तुमन देस म हमेसा बने रहिहू।<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>काबरकि यहोवा ह सच्चई ले मया करथे</para>
  <para style="q2" vid="PSA 37:28">अऊ अपन बिसवासयोग्य मनखेमन ला नइं तियागे,</para>
  <para style="b" vid="PSA 37:28"/>
  <para style="q1" vid="PSA 37:28">ओमन के हमेसा रकछा करे जाही;</para>
  <para style="q2" vid="PSA 37:28">पर दुस्टमन के संतानमन नास हो जाहीं।<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>धरमी मनखेमन देस के उत्तराधिकारी होहीं</para>
  <para style="q2" vid="PSA 37:29">अऊ ओमा हमेसा निवास करहीं।<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>धरमीमन के मुहूं ले बुद्धि के बात निकलथे,</para>
  <para style="q2" vid="PSA 37:30">अऊ ओमन के जीभ ओ बात कहिथे, जऊन ह सही अय।<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>ओमन के परमेसर के कानून ह ओमन के हिरदय म हवय;</para>
  <para style="q2" vid="PSA 37:31">ओमन के गोड़ ह नइं फिसलय।<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>दुस्ट मनखे ह ये इरादा से धरमीमन के घात म रहिथे</para>
  <para style="q2" vid="PSA 37:32">कि ओह ओमन ला मार डारय।<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>पर यहोवा ह धरमीमन ला दुस्ट मनखेमन के हांथ म नइं छोंड़य</para>
  <para style="q2" vid="PSA 37:33">या ओमन ला दोसी नइं ठहिराय, जब ओमन अदालत म लाय जाथें।<verse eid="PSA 37:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>यहोवा ऊपर आसा रखव</para>
  <para style="q2" vid="PSA 37:34">अऊ ओकर रसता म चलव।</para>
  <para style="q1" vid="PSA 37:34">ओह तुमन ला बढ़ाही अऊ देस के उत्तराधिकारी बनाही;</para>
  <para style="q2" vid="PSA 37:34">जब दुस्ट मनखेमन के नास करे जाही, त तुमन येला देखहू।<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>मेंह एक दुस्ट अऊ निरदयी मनखे ला</para>
  <para style="q2" vid="PSA 37:35">बड़े देसी रूख के सहीं बाढ़त देखे हंव,<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>पर ओह जल्दी खतम हो गीस अऊ ओह फेर नइं दिखिस;</para>
  <para style="q2" vid="PSA 37:36">हालाकि मेंह ओला खोजेंव, पर ओह नइं मिलिस।<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>निरदोस मनखे ऊपर बिचार कर, अऊ ईमानदार मनखे ला देख;</para>
  <para style="q2" vid="PSA 37:37">ओमन के भविस्य उज्जवल होथे, जेमन सांति के खोज म रहिथें।<note caller="+" style="f"><char style="fr" closed="false">37:37 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">जऊन मन सांति के खोज म रहिथें, ओमन उन्नति करहीं</char></note><verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>पर जम्मो पापीमन ला नास करे जाही;</para>
  <para style="q2" vid="PSA 37:38">दुस्टमन के कुछू भविस्य नइं होही।<verse eid="PSA 37:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>धरमीमन के उद्धार ह यहोवा कोति ले होथे;</para>
  <para style="q2" vid="PSA 37:39">संकट के बेरा म ओहीच ह ओमन के मजबूत गढ़ ए।<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>यहोवा ह ओमन के मदद करथे अऊ ओमन ला छुड़ाथे;</para>
  <para style="q2" vid="PSA 37:40">ओह ओमन ला दुस्ट मनखे ले छुड़ाथे अऊ ओमन ला बचाथे।</para>
  <para style="q2" vid="PSA 37:40">काबरकि ओमन यहोवा करा सरन लेथें।<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="cl">भजन-संहिता 38<note caller="+" style="f"><char style="fr" closed="false">38 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 38:1-22">38:1‑22</ref></char> ला 38:2‑23 गने गे हवय</char></note></para>
  <para style="d">दाऊद के एक भजन। एक बिनती।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>हे यहोवा, गुस्सा होके मोला झन फटकार</para>
  <para style="q2" vid="PSA 38:1">या अपन कोप म मोर ताड़ना झन कर।<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>तोर तीरमन मोला छेद डारे हवंय,</para>
  <para style="q2" vid="PSA 38:2">अऊ तोर हांथ ह मोर ऊपर पड़े हवय।<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>तोर कोप के कारन मोर देहें ह स्वस्थ नइं ए;</para>
  <para style="q2" vid="PSA 38:3">मोर पाप के कारन मोर हाड़ामन म कुछू बल नइं ए।<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>मोर अपराध ह मोला बियाकुल कर दे हवय,</para>
  <para style="q2" vid="PSA 38:4">येह भारी बोझा के सहीं सहन सक्ति ले बाहिर हो गे हवय।<verse eid="PSA 38:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>मोर पाप के मुरूखता के कारन</para>
  <para style="q2" vid="PSA 38:5">मोर घावमन पाकके सड़ गे हवंय।<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>मोला लज्जित करे जाथे अऊ मोला झुकाय गे हवय;</para>
  <para style="q2" vid="PSA 38:6">दिन भर मेंह सोक मनात रहिथंव।<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>मोर पीठ ह चूभत पीरा ले भरे हवय;</para>
  <para style="q2" vid="PSA 38:7">अऊ मोर देहें ह स्वस्थ नइं ए।<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>मेंह कमजोर होके चूर-चूर हो गे हंव;</para>
  <para style="q2" vid="PSA 38:8">मेंह अपन हिरदय के पीरा म कलहरत हंव।<verse eid="PSA 38:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>हे परभू, मोर जम्मो ईछा ला तेंह जानत हस;</para>
  <para style="q2" vid="PSA 38:9">मोर आह भरई ह तोर ले नइं छुपे हे।<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>मोर हिरदय ह कुटा-कुटा होवत हे, मोर म ताकत नइं ए;</para>
  <para style="q2" vid="PSA 38:10">अऊ त अऊ मोर आंखी के अंजोर ह खतम हो गे हवय।<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>मोर घावमन के कारन मोर संगी-साथीमन मोर ले अलग होवथें;</para>
  <para style="q2" vid="PSA 38:11">मोर पड़ोसीमन मोर ले बहुंत दूरिहा रहिथें।<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>जऊन मन मोला मार डारे चाहथें, ओमन अपन जाल बिछात हवंय,</para>
  <para style="q2" vid="PSA 38:12">जऊन मन मोर हानि करहीं, ओमन मोर बिनास के बात करत हवंय;</para>
  <para style="q2" vid="PSA 38:12">दिन भर ओमन साजिस करत पड़े रहिथें।<verse eid="PSA 38:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>मेंह तो भैंरा मनखे सहीं अंव, जऊन ह सुन नइं सकय,</para>
  <para style="q2" vid="PSA 38:13">अऊ कोंदा सहीं अंव, जऊन ह गोठियाय नइं सकय;<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>हव, मेंह ओ मनखे सहीं हो गे हंव, जऊन ह नइं सुनय,</para>
  <para style="q2" vid="PSA 38:14">जेकर मुहूं ले कोनो जबाब नइं निकलय।<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>हे यहोवा, मेंह तोर इंतजार करत हंव;</para>
  <para style="q2" vid="PSA 38:15">हे परभू मोर परमेसर, तेंह मोला जबाब देबे।<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>काबरकि मेंह कहेंव, “जब मोर गोड़ ह फिसलथे,</para>
  <para style="q2" vid="PSA 38:16">त ओमन ला मोर ऊपर खुस होवन झन दे या ओमन अपनआप ला मोर ले ऊपर झन करंय।”<verse eid="PSA 38:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>काबरकि मेंह गिरनेचवाला हंव,</para>
  <para style="q2" vid="PSA 38:17">अऊ मोर म हमेसा पीरा हवय।<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>मेंह अपन पाप ला मान लेवत हंव;</para>
  <para style="q2" vid="PSA 38:18">मेंह अपन पाप के कारन बियाकुल हंव।<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>बहुंते जन बिगर कारन के मोर बईरी हो गे हवंय;</para>
  <para style="q2" vid="PSA 38:19">जऊन मन बिगर कारन के मोर ले घिन करथें, ओमन के संखिया अनगिनत हवय।<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>जऊन मन मोर भलई करे के कारन मोर बुरई करथें</para>
  <para style="q2" vid="PSA 38:20">अऊ मोर बिरूध दोस लगाथें,</para>
  <para style="q2" vid="PSA 38:20">जबकि मेंह सिरिप भलई के काम करे चाहथंव।<verse eid="PSA 38:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>हे यहोवा, मोला झन तियाग;</para>
  <para style="q2" vid="PSA 38:21">हे मोर परमेसर, मोर ले दूरिहा झन रह।<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>हे मोर परभू अऊ मोर उद्धारकर्ता,</para>
  <para style="q2" vid="PSA 38:22">मोर मदद करे बर जल्दी आ।<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="cl">भजन-संहिता 39<note caller="+" style="f"><char style="fr" closed="false">39 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 39:1-13">39:1‑13</ref></char> ला 39:2‑14 गने गे हवय</char></note></para>
  <para style="d">संगीत निरदेसक बर। यदूतून बर। दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>मेंह अपन मन म कहेंव, “मेंह अपन चालचलन ऊपर धियान दूहूं</para>
  <para style="q2" vid="PSA 39:1">अऊ मोर जीभ ला पाप के बात ले दूरिहा रखहूं;</para>
  <para style="q1" vid="PSA 39:1">जब दुस्ट मनखेमन मोर आघू म होहीं,</para>
  <para style="q2" vid="PSA 39:1">त मेंह अपन मुहूं म लगाम लगाय रखहूं।”<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>एकरसेति मेंह एकदम चुप रहेंव,</para>
  <para style="q2" vid="PSA 39:2">इहां तक कि मेंह कोनो बने बात घलो नइं कहेंव।</para>
  <para style="q1" vid="PSA 39:2">पर मोर पीरा ह बढ़ गीस;<verse eid="PSA 39:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 39:3"/>मोर हिरदय ह भीतरे-भीतर बरत रिहिस।</para>
  <para style="q1" vid="PSA 39:3">जब मेंह सोचत रहेंव, आगी ह भड़क उठिस;</para>
  <para style="q2" vid="PSA 39:3">तब मेंह अपन जीभ ले बोले लगेंव:<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>“हे यहोवा, मोला मोर जिनगी के अन्त ला देखा</para>
  <para style="q2" vid="PSA 39:4">अऊ मोर जिनगी के कतेक दिन बांचे हवय, मोला बता;</para>
  <para style="q2" vid="PSA 39:4">मोला बता कि मोर जिनगी कइसे तेजी से खतम होवथे।<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>तेंह मोर जिनगी के दिन ला सिरिप बीता भर कर दे हस;</para>
  <para style="q2" vid="PSA 39:5">मोर जिनगी के थोरकन बछरमन तोर आघू म कुछू नो हंय।</para>
  <para style="q1" vid="PSA 39:5">हर एक जन एक सांस के सहीं अय,</para>
  <para style="q2" vid="PSA 39:5">अऊ त अऊ ओमन घलो, जऊन मन सुरकछित जान पड़थें।<verse eid="PSA 39:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>“खचित हर एक जन छइहां के सहीं एती-ओती फिरत रहिथें;</para>
  <para style="q2" vid="PSA 39:6">बेकार म ओमन भाग-दऊड़ करके धन जमा करत रहिथें,</para>
  <para style="q2" vid="PSA 39:6">ये जाने बिगर कि मरे के बाद ये धन ह काकर होही।<verse eid="PSA 39:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>“पर अब, हे परभू, मेंह का चीज के डहार देखत हंव?</para>
  <para style="q2" vid="PSA 39:7">मोर आसा ह तोरेच ऊपर हवय।<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>मोला मोर जम्मो अपराध ले बचा ले;</para>
  <para style="q2" vid="PSA 39:8">मोला मुरूखमन के तिरस्कार के पात्र झन बना।<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>मेंह चुप रहेंव; अऊ अपन मुहूं नइं खोलेंव,</para>
  <para style="q2" vid="PSA 39:9">काबरकि तें अस ओ जन, जऊन ह येला करे हवय।<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>तेंह मोर ऊपर जऊन बिपत्ति डाले हस, ओला हटा ले;</para>
  <para style="q2" vid="PSA 39:10">तोर हांथ के मार ले मेंह कुछू करे के लईक नइं अंव।<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>जब तेंह कोनो मनखे ला ओकर पाप के कारन डांटथस अऊ दंड देथस,</para>
  <para style="q2" vid="PSA 39:11">त तेंह ओमन के धन-संपत्ति ला घूना खाय सहीं खतम कर देथस—</para>
  <para style="q2" vid="PSA 39:11">खचित हर एक जन जिनगी के एक सांस के सहीं अय।<verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>“हे यहोवा, मोर पराथना ला सुन,</para>
  <para style="q2" vid="PSA 39:12">मदद बर मोर गोहार ला सुन;</para>
  <para style="q2" vid="PSA 39:12">मोर रोवई ला सुनके चुप झन रह।</para>
  <para style="q1" vid="PSA 39:12">मेंह एक परदेसी, एक अजनबी के सहीं तोर संग रहिथंव,</para>
  <para style="q2" vid="PSA 39:12">जइसे कि मोर जम्मो पुरखामन रिहिन।<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>एकर पहिले कि मेंह ये संसार ले चले जावंव अऊ खतम हो जावंव,</para>
  <para style="q2" vid="PSA 39:13">तेंह अपन कोप ला मोर ऊपर ले हटा ले, ताकि मेंह जिनगी के फेर आनंद उठा सकंव।”<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="cl">भजन-संहिता 40<note caller="+" style="f"><char style="fr" closed="false">40 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 40:1-17">40:1‑17</ref></char> ला 40:2‑18 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>मेंह धीरज धरके यहोवा के डहार देखेंव;</para>
  <para style="q2" vid="PSA 40:1">ओह मोर तरफ धियान दीस अऊ मोर गोहार ला सुनिस।<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>ओह मोला चीखला ले भरे खंचवा ले,</para>
  <para style="q2" vid="PSA 40:2">चीखला अऊ दलदल ले बाहिर निकालिस;</para>
  <para style="q1" vid="PSA 40:2">अऊ मोला चट्टान ऊपर ठाढ़ करिस</para>
  <para style="q2" vid="PSA 40:2">अऊ ठाढ़ होय बर मोला एक मजबूत जगह दीस।<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>ओह मोला एक नवां गीत दीस,</para>
  <para style="q2" vid="PSA 40:3">हमर परमेसर के इस्तुति करे बर एक ठन भजन दीस।</para>
  <para style="q1" vid="PSA 40:3">बहुंते जन देखहीं अऊ यहोवा के भय मानहीं</para>
  <para style="q2" vid="PSA 40:3">अऊ ओकर ऊपर भरोसा करहीं।<verse eid="PSA 40:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>धइन अय ओ मनखे,</para>
  <para style="q2" vid="PSA 40:4">जऊन ह यहोवा ऊपर भरोसा रखथे,</para>
  <para style="q1" vid="PSA 40:4">जऊन ह घमंडी मनखेमन कोति नइं देखय,</para>
  <para style="q2" vid="PSA 40:4">या ओमन कोति नइं देखय, जेमन लबरा देवतामन ऊपर अपन मन लगाथें।<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>हे यहोवा मोर परमेसर,</para>
  <para style="q2" vid="PSA 40:5">तेंह बहुंते अद्भूत काम करे हस,</para>
  <para style="q2" vid="PSA 40:5">अऊ हमर बर बहुंते चीजमन के योजना बनाय हस।</para>
  <para style="q1" vid="PSA 40:5">काकरो तुलना तोर से नइं करे जा सकय;</para>
  <para style="q2" vid="PSA 40:5">यदि मेंह तोर काममन के चरचा करंव अऊ ओमन के बारे बतावंव,</para>
  <para style="q2" vid="PSA 40:5">त ओमन अतेक जादा हवंय कि ओमन के गनती नइं करे जा सकय।<verse eid="PSA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>बलिदान अऊ भेंट तेंह नइं चाहय—</para>
  <para style="q2" vid="PSA 40:6">पर मोर कान ला तेंह खोल दे हस<note caller="+" style="f"><char style="fr" closed="false">40:6 </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">पर </char><char style="fqa" closed="false">एक ठन देहें तेंह मोर बर तियार करे हस</char></note>—</para>
  <para style="q2" vid="PSA 40:6">होम-बलिदान अऊ पाप-बलिदान तेंह नइं चाहय।<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>तब मेंह कहेंव, “मेंह इहां हंव, मेंह आय हंव—</para>
  <para style="q2" vid="PSA 40:7">मोर बारे म ये बात ह किताब<note caller="+" style="f"><char style="fr" closed="false">40:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कानून के किताब</char></note> म लिखे हवय।<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>हे मोर परमेसर, मेंह तोर ईछा ला पूरा करे चाहथंव;</para>
  <para style="q2" vid="PSA 40:8">तोर कानून ह मोर हिरदय म बसे हवय।”<verse eid="PSA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>मेंह तोर धरमीपन के काम के बखान बड़े सभा म करथंव;</para>
  <para style="q2" vid="PSA 40:9">हे यहोवा, जइसे कि तेंह जानत हस,</para>
  <para style="q2" vid="PSA 40:9">मेंह अपन मुहूं ला बंद नइं रखंव।<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>मेंह तोर धरमीपन ला अपन हिरदय म नइं छुपावंव;</para>
  <para style="q2" vid="PSA 40:10">मेंह तोर बिसवासयोग्यता अऊ तोर उद्धार के काम के बारे म गोठियाथंव।</para>
  <para style="q1" vid="PSA 40:10">मेंह बड़े सभा ले तोर मया अऊ तोर</para>
  <para style="q2" vid="PSA 40:10">बिसवासयोग्यता के बात ला नइं छुपावंव।<verse eid="PSA 40:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>हे यहोवा, मोर ऊपर ले अपन दया ला झन हटा;</para>
  <para style="q2" vid="PSA 40:11">तोर मया अऊ बिसवासयोग्यता हमेसा मोर बचाव करय।<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>काबरकि अनगिनत समस्यामन मोला घेरे हवंय;</para>
  <para style="q2" vid="PSA 40:12">मोर पापमन मोला दबा ले हवंय, अऊ मेंह देख नइं सकत हंव।</para>
  <para style="q1" vid="PSA 40:12">ओमन के संखिया मोर मुड़ के चुंदी ले घलो जादा हवय,</para>
  <para style="q2" vid="PSA 40:12">एकरसेति मोर मन ह टूट गे हवय।<verse eid="PSA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>हे यहोवा, किरपा करके मोला बचा ले;</para>
  <para style="q2" vid="PSA 40:13">हे यहोवा, मोर मदद करे बर जल्दी आ।<verse eid="PSA 40:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>जऊन मन मोर परान लेय चाहथें,</para>
  <para style="q2" vid="PSA 40:14">ओ जम्मो झन लज्जित होवंय अऊ घबरावंय;</para>
  <para style="q1" vid="PSA 40:14">ओ जम्मो, जऊन मन मोर बिनास के ईछा रखथें,</para>
  <para style="q2" vid="PSA 40:14">ओमन कलंकित होके पाछू हटंय।<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>जऊन मन मोला ये कहिथें, “अहा! अहा!”</para>
  <para style="q2" vid="PSA 40:15">ओमन अपन ही लज्जा म चकित होवंय।<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>पर ओ जम्मो, जऊन मन तोर खोज म रहिथें,</para>
  <para style="q2" vid="PSA 40:16">ओमन तोर कारन आनंद मनावंय अऊ खुस होवंय;</para>
  <para style="q1" vid="PSA 40:16">जऊन मन तोर उद्धार के मदद चाहथें, ओमन हमेसा कहंय,</para>
  <para style="q2" vid="PSA 40:16">“यहोवा महान ए!”<verse eid="PSA 40:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>पर जहां तक मोर बात ए, मेंह गरीब अऊ जरूरतमंद अंव;</para>
  <para style="q2" vid="PSA 40:17">परभू ह मोर बारे म सोचय।</para>
  <para style="q1" vid="PSA 40:17">तेंह मोर मददगार अऊ मोर छुड़ानेवाला अस;</para>
  <para style="q2" vid="PSA 40:17">तेंह मोर परमेसर अस, मोर मदद करे म देरी झन कर।<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="cl">भजन-संहिता 41<note caller="+" style="f"><char style="fr" closed="false">41 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 41:1-13">41:1‑13</ref></char> ला 41:2‑14 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>धइन अंय ओमन, जऊन मन कमजोर मनखे के सुधि लेथें;</para>
  <para style="q2" vid="PSA 41:1">यहोवा ह संकट के बेरा म ओमन ला बचाथे।<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>यहोवा ह ओमन ला बचाथे अऊ ओमन ला संभाले रखथे—</para>
  <para style="q2" vid="PSA 41:2">देस म ओमन के गनती आसीसित मनखेमन के बीच होथे—</para>
  <para style="q2" vid="PSA 41:2">ओह ओमन ला ओमन के बईरीमन के ईछा म नइं छोंड़य।<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>जब ओमन बेमार होके बिस्तर म पड़े रहिथें, त यहोवा ह ओमन ला संभालथे</para>
  <para style="q2" vid="PSA 41:3">अऊ ओमन ला ठीक करके बेमारी के बिस्तर ले ठाढ़ करथे।<verse eid="PSA 41:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>मेंह कहेंव, “हे यहोवा, मोर ऊपर दया कर;</para>
  <para style="q2" vid="PSA 41:4">मोला चंगा कर, काबरकि मेंह तोर बिरूध पाप करे हंव।”<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>मोर बईरीमन मोर बुरई करके कहिथें,</para>
  <para style="q2" vid="PSA 41:5">“ओह कब मरही अऊ ओकर नांव ह मिटाही?”<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>जब ओमन ले कोनो मोला देखे बर आथे,</para>
  <para style="q2" vid="PSA 41:6">त ओह लबारी बात कहिथे, अऊ अपन मन म बदनामी के बात ला रखथे;</para>
  <para style="q2" vid="PSA 41:6">तब ओह बाहिर जाथे अऊ ओ बात ला फईलाथे।<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>मोर जम्मो बईरीमन एक संग मोर बिरूध म कानाफूसी करथें;</para>
  <para style="q2" vid="PSA 41:7">ओमन ये कहिके मोर बिरूध खराप कल्पना करथें,<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>“ओला एक खराप बेमारी हो गे हवय;</para>
  <para style="q2" vid="PSA 41:8">ओह ओ जगह ले कभू उठ नइं सकय, जिहां ओह पड़े हवय।”<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>अऊ त अऊ मोर खास संगी,</para>
  <para style="q2" vid="PSA 41:9">जेकर ऊपर मेंह भरोसा करत रहंय,</para>
  <para style="q1" vid="PSA 41:9">जऊन ह मोर संग खाना खावत रिहिस,</para>
  <para style="q2" vid="PSA 41:9">ओह मोर बिरूध हो गे हवय।<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>पर हे यहोवा, तेंह मोर ऊपर दया कर;</para>
  <para style="q2" vid="PSA 41:10">मोला उठा कि मेंह ओमन ले बदला ले सकंव।<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>मेंह जानत हंव कि तेंह मोर ले खुस हवस,</para>
  <para style="q2" vid="PSA 41:11">काबरकि मोर बईरीमन मोर ऊपर जय नइं पावथें।<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>मोर ईमानदारी के कारन तेंह मोला संभाले रखथस</para>
  <para style="q2" vid="PSA 41:12">अऊ हमेसा बर मोला अपन आघू म रखथस।<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>यहोवा, इसरायल के परमेसर के परसंसा</para>
  <para style="q2" vid="PSA 41:13">आदि ले अनंतकाल तक होवत रहय।</para>
  <para style="qc" vid="PSA 41:13">आमीन अऊ आमीन।<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">किताब II</para>
  <para style="mr">
    <ref loc="PSA 42-72">भजन-संहिता 42–72</ref></para>
  <para style="cl">भजन-संहिता 42<note caller="+" style="f"><char style="fr" closed="false">42 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 42:1-11">42:1‑11</ref></char> ला 42:2‑12 गने गे हवय अऊ बहुंत इबरानी मूल अनुवाद म भजन-संहिता <char style="xt"><ref loc="PSA 42">42</ref></char> अऊ <char style="xt"><ref loc="PSA 43">43</ref></char> ला एक भजन कहे गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर कोरह के बेटामन के एक <char style="tl">मसकील</char><note caller="+" style="f"><char style="fr" closed="false">42:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>जइसे हिरन ह पानी के सोता बर हांफथे,</para>
  <para style="q2" vid="PSA 42:1">हे मोर परमेसर, वइसे ही मोर जीव ह तोर बर हांफथे।<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>मोर जीव ह परमेसर बर, जीयत परमेसर बर पीयासा हवय।</para>
  <para style="q2" vid="PSA 42:2">कब मेंह जाके परमेसर संग मिल सकत हंव?<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>रात अऊ दिन</para>
  <para style="q2" vid="PSA 42:3">मेंह अपन आंखी के आंसू ला पीयत हंव,</para>
  <para style="q1" vid="PSA 42:3">जबकि दिन भर मनखेमन मोला कहिथें,</para>
  <para style="q2" vid="PSA 42:3">“कहां हवय तोर परमेसर?”<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>जब मेंह अपन मन के बात ला रखथंव,</para>
  <para style="q2" vid="PSA 42:4">त मोला ये बातमन सुरता आथें:</para>
  <para style="q1" vid="PSA 42:4">मेंह कइसे उत्सव मनावत भीड़ के संग</para>
  <para style="q2" vid="PSA 42:4">परमेसर के सुरकछा म</para>
  <para style="q1" vid="PSA 42:4">आनंद अऊ परसंसा के जय-जयकार करत</para>
  <para style="q2" vid="PSA 42:4">परमेसर के घर म जाय के आदि रहेंव।<verse eid="PSA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>हे मोर मन, तेंह काबर उदास होवत हस?</para>
  <para style="q2" vid="PSA 42:5">तेंह भीतरे-भीतर काबर बियाकुल हस?</para>
  <para style="q1" vid="PSA 42:5">परमेसर ऊपर अपन आसा रख,</para>
  <para style="q2" vid="PSA 42:5">काबरकि मेंह अब भी</para>
  <para style="q1" vid="PSA 42:5">मोर उद्धारकर्ता अऊ मोर परमेसर के</para>
  <para style="q2" vid="PSA 42:5">परसंसा करहूं।<verse eid="PSA 42:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>मोर मन ह भीतरे-भीतर उदास हवय;</para>
  <para style="q2" vid="PSA 42:6">एकरसेति यरदन के देस ले,</para>
  <para style="q1" vid="PSA 42:6">हेरमोन के ऊंचई—मिसार पहाड़ ले</para>
  <para style="q2" vid="PSA 42:6">मेंह तोला सुरता करहूं।<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>तोर जल-परपात के गरजन म</para>
  <para style="q2" vid="PSA 42:7">गहरई ह गहरई ला पुकारथे;</para>
  <para style="q1" vid="PSA 42:7">तोर जम्मो पानी के उफान अऊ लहरामन</para>
  <para style="q2" vid="PSA 42:7">मोर ऊपर ले निकले हवंय।<verse eid="PSA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>दिन के बेरा यहोवा ह अपन मया देखाथे,</para>
  <para style="q2" vid="PSA 42:8">अऊ रथिया मेंह ओकर गीत गाथंव—</para>
  <para style="q2" vid="PSA 42:8">मोर जिनगी के परमेसर बर पराथना के गीत।<verse eid="PSA 42:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>मेंह परमेसर अपन चट्टान ला कहिथंव,</para>
  <para style="q2" vid="PSA 42:9">“तेंह काबर मोला भुला गे हस?</para>
  <para style="q1" vid="PSA 42:9">बईरीमन के दुवारा सताय जाके</para>
  <para style="q2" vid="PSA 42:9">मेंह काबर सोक मनावंव?”<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>जब मोर बईरीमन ये कहिके</para>
  <para style="q2" vid="PSA 42:10">दिन भर मोला ताना मारथें,</para>
  <para style="q1" vid="PSA 42:10">“कहां हे तोर परमेसर?”</para>
  <para style="q2" vid="PSA 42:10">त मोर हाड़ामन पीरा म चूर-चूर हो जाथें।<verse eid="PSA 42:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>हे मोर मन, तेंह काबर उदास होवत हस?</para>
  <para style="q2" vid="PSA 42:11">मोर भीतरे-भीतर काबर अतेक बियाकुल हस?</para>
  <para style="q1" vid="PSA 42:11">परमेसर ऊपर अपन आसा रख,</para>
  <para style="q2" vid="PSA 42:11">काबरकि मेंह अब भी</para>
  <para style="q2" vid="PSA 42:11">मोर उद्धारकर्ता अऊ मोर परमेसर के परसंसा करहूं।<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="cl">भजन-संहिता 43</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>हे मोर परमेसर, मोला निरदोस साबित कर,</para>
  <para style="q2" vid="PSA 43:1">बिसवासघाती जाति के मनखेमन के बिरूध</para>
  <para style="q2" vid="PSA 43:1">मोर मामला ला देख।</para>
  <para style="q1" vid="PSA 43:1">ओमन ले मोला बचा,</para>
  <para style="q2" vid="PSA 43:1">जऊन मन धोखेबाज अऊ दुस्ट अंय।<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>तेंह परमेसर अस अऊ मोर मजबूत गढ़ अस।</para>
  <para style="q2" vid="PSA 43:2">तेंह काबर मोला तिरस्कार करे हस?</para>
  <para style="q1" vid="PSA 43:2">बईरी के दुवारा दुख मिले के कारन</para>
  <para style="q2" vid="PSA 43:2">मेंह काबर सोक मनावंव?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>अपन अंजोर अऊ सच्चई ला मोर करा पठो,</para>
  <para style="q2" vid="PSA 43:3">ओमन मोर अगुवई करंय;</para>
  <para style="q1" vid="PSA 43:3">ओमन मोला तोर पबितर पहाड़ करा लानंय,</para>
  <para style="q2" vid="PSA 43:3">ओ जगह म जिहां तेंह रहिथस।<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>तब मेंह परमेसर के बेदी करा जाहूं,</para>
  <para style="q2" vid="PSA 43:4">ओ परमेसर, जऊन ह मोर आनंद अऊ मोर खुसी अय।</para>
  <para style="q1" vid="PSA 43:4">हे परमेसर, मोर परमेसर,</para>
  <para style="q2" vid="PSA 43:4">मेंह बीना बजा-बजाके तोर इस्तुति करहूं।<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>हे मोर मन, तेंह काबर उदास होवत हस?</para>
  <para style="q2" vid="PSA 43:5">मोर भीतरे-भीतर काबर अतेक बियाकुल हस?</para>
  <para style="q1" vid="PSA 43:5">परमेसर ऊपर अपन आसा रख,</para>
  <para style="q2" vid="PSA 43:5">काबरकि मेंह अब भी</para>
  <para style="q2" vid="PSA 43:5">मोर उद्धारकर्ता अऊ मोर परमेसर के परसंसा करहूं।<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="cl">भजन-संहिता 44<note caller="+" style="f"><char style="fr" closed="false">44 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 44:1-26">44:1‑26</ref></char> ला 44:2‑27 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर कोरह के बेटामन के एक <char style="tl">मसकील</char><note caller="+" style="f"><char style="fr" closed="false">44:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>हे परमेसर, हमन अपन कान ले सुने हवन;</para>
  <para style="q2" vid="PSA 44:1">हमर पुरखामन हमन ला बताय हवंय</para>
  <para style="q1" vid="PSA 44:1">कि बहुंत समय पहिले</para>
  <para style="q2" vid="PSA 44:1">तेंह ओमन के समय म का-का काम करे हस।<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>अपन हांथ ले तेंह जाति-जाति के मनखेमन ला निकालके भगा देय</para>
  <para style="q2" vid="PSA 44:2">अऊ हमर पुरखामन ला बसाय;</para>
  <para style="q1" vid="PSA 44:2">तेंह मनखेमन ला कुचर डारय</para>
  <para style="q2" vid="PSA 44:2">अऊ हमर पुरखामन ला बढ़ाय।<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>ओमन अपन तलवार के ताकत ले देस ला नइं जीतिन,</para>
  <para style="q2" vid="PSA 44:3">न ही ओमन अपन बाहां के ताकत ले जय पाईन;</para>
  <para style="q1" vid="PSA 44:3">पर येह तोर जेवनी हांथ, तोर बाहां,</para>
  <para style="q2" vid="PSA 44:3">अऊ तोर चेहरा के अंजोर रिहिस जेकर दुवारा जीत मिलिस, काबरकि तेंह ओमन ले मया करय।<verse eid="PSA 44:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>तेंह मोर राजा अऊ मोर परमेसर अस,</para>
  <para style="q2" vid="PSA 44:4">जऊन ह याकूब बर जीत के हुकूम देथे।<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>तोर जरिये ही हमन अपन बईरीमन ला पाछू ढकेल देथन;</para>
  <para style="q2" vid="PSA 44:5">तोर नांव ले ही हमन अपन बिरोधीमन ला कुचर देथन।<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>मेंह अपन धनुस ऊपर भरोसा नइं करंव,</para>
  <para style="q2" vid="PSA 44:6">मोर तलवार के दुवारा मोला जीत नइं मिलय;<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>पर तेंह हमन ला हमर बईरीमन ऊपर जीत देवाथस,</para>
  <para style="q2" vid="PSA 44:7">तेंह हमर बईरीमन ला लज्जित करथस।<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>परमेसर ऊपर हमन दिन भर घमंड करत रहिथन,</para>
  <para style="q2" vid="PSA 44:8">अऊ हमन हमेसा तोर नांव के परसंसा करत रहिबो।<verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>पर अब तेंह हमन ला तियाग दे हस अऊ हमर अनादर करे हस;</para>
  <para style="q2" vid="PSA 44:9">तेंह हमर सेना के संग अब नइं जावस।<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>तेंह हमन ला हमर बईरी के आघू ले भगा दे हस,</para>
  <para style="q2" vid="PSA 44:10">अऊ हमर बईरीमन हमन ला लूट ले हवंय।<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>तेंह हमन ला भेड़मन के सहीं मारे जाय बर देय दे हस</para>
  <para style="q2" vid="PSA 44:11">अऊ हमन ला जाति-जाति के मनखेमन के बीच तितिर-बितिर कर दे हस।<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>तेंह अपन मनखेमन ला थोरकन दाम म बेच दे हस,</para>
  <para style="q2" vid="PSA 44:12">अऊ ओमन ला बेचे ले कुछू लाभ नइं होईस।<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>तेंह हमन ला हमर पड़ोसीमन बर निन्दा के कारन बना दे हस,</para>
  <para style="q2" vid="PSA 44:13">हमर चारों कोति के मनखे बर हंसी अऊ ठट्ठा के चीज बना दे हस।<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>तेंह हमन ला जाति-जाति के मनखेमन के बीच म एक कहावत बना दे हस;</para>
  <para style="q2" vid="PSA 44:14">ओमन हमर बर मुड़ झटक लेथें।<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>मेंह दिन भर कलंक म जीयत हंव,</para>
  <para style="q2" vid="PSA 44:15">अऊ मोर मुहूं ह लाज म ढंपा गे हवय,<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>ओमन के ताना मारे के कारन, जऊन मन मोर निन्दा करथें अऊ मोला गाली देथें,</para>
  <para style="q2" vid="PSA 44:16">ओ बईरी के कारन, जऊन ह मोर ले बदला लेय बर तियार हवय।<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>ये जम्मो कुछू हमर ऊपर होईस,</para>
  <para style="q2" vid="PSA 44:17">हालाकि हमन तोला नइं भुलाय रहेंन;</para>
  <para style="q2" vid="PSA 44:17">अऊ हमन तोर करार ला नइं टोरे रहेंन।<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>हमर मन ह तोर ले नइं हटे रिहिस;</para>
  <para style="q2" vid="PSA 44:18">हमर गोड़मन तोर रसता ले नइं भटके रिहिन।<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>पर तेंह हमन ला कुचर डारय अऊ हमन ला गीदड़मन के डेरा बना डारय;</para>
  <para style="q2" vid="PSA 44:19">तेंह हमन ला घोर अंधियार ले ढांप ले हस।<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>यदि हमन अपन परमेसर के नांव ला भुला गे रहेंन</para>
  <para style="q2" vid="PSA 44:20">या अपन हांथ ला आने देवता कोति बढ़ाय रहेंन,<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>त का परमेसर ला ये बात के पता नइं चल गे होतिस?</para>
  <para style="q2" vid="PSA 44:21">काबरकि ओह तो मन के गुपत बात ला घलो जानथे।<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>तभो ले तोर बर, हमन दिन भर मिरतू के जोखिम म रहिथन;</para>
  <para style="q2" vid="PSA 44:22">हमन ओ भेड़ सहीं समझे जाथन, जऊन मन के बध होवइया हवय।<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>हे परभू, जाग! तेंह काबर सुतत हस?</para>
  <para style="q2" vid="PSA 44:23">अपनआप ला जगा! हमन ला सदाकाल बर झन तियाग।<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>तेंह काबर अपन मुहूं ला छिपात हस</para>
  <para style="q2" vid="PSA 44:24">अऊ हमर अतियाचार अऊ दुरगति ला भुला देत हस?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>हमन ला खाल्हे धुर्रा म पटक दिये गे हवय;</para>
  <para style="q2" vid="PSA 44:25">हमर देहें ह भुइयां म पड़े हवय।<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>उठ अऊ हमर मदद कर;</para>
  <para style="q2" vid="PSA 44:26">अपन अटूट मया के कारन हमन ला छोंड़ा ले।<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="cl">भजन-संहिता 45<note caller="+" style="f"><char style="fr" closed="false">45 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 45:1-17">45:1‑17</ref></char> ला 45:2‑18 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर कुमुदिनी के स्वर म कोरह के बेटामन के एक <char style="tl">मसकील</char>।<note caller="+" style="f"><char style="fr" closed="false">45:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note> एक बिहाव गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>मोर हिरदय म एक ठन उत्तम बिसय आवत हे</para>
  <para style="q2" vid="PSA 45:1">जइसे कि मेंह राजा बर अपन पदमन के पाठ करथंव;</para>
  <para style="q2" vid="PSA 45:1">त मोर जीभ ह एक कुसल लेखक के कलम बन जाथे।<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>तेंह मनखेमन म सबले उत्तम अस</para>
  <para style="q2" vid="PSA 45:2">अऊ तोर ओंठ ला अनुग्रह ले अभिसेक करे गे हवय,</para>
  <para style="q2" vid="PSA 45:2">काबरकि परमेसर ह तोला सदाकाल बर आसीस दे हवय।<verse eid="PSA 45:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>हे बलसाली मनखे, तेंह अपन बाजू म तलवार ला धर ले;</para>
  <para style="q2" vid="PSA 45:3">सोभा अऊ महिमा देवइया कपड़ा पहिर ले।<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>सच्चई, नमरता अऊ नियाय के हित म</para>
  <para style="q2" vid="PSA 45:4">अपन महिमा के संग बिजयी होके निकल;</para>
  <para style="q2" vid="PSA 45:4">तोर जेवनी हांथ ले अद्भूत काम होवय।<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>तोर नुकीला तीरमन राजा के बईरीमन के हिरदय ला छेद डारंय;</para>
  <para style="q2" vid="PSA 45:5">जाति-जाति के मनखेमन तोर गोड़ खाल्हे गिरंय।<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>हे परमेसर, तोर सिंघासन ह सदाकाल तक बने रहिही;</para>
  <para style="q2" vid="PSA 45:6">अऊ धरमीपन के राजदंड ह तोर राज के राजदंड होही।<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>तेंह धरमीपन ले मया अऊ दुस्टता ले घिन करथस;</para>
  <para style="q2" vid="PSA 45:7">एकरसेति परमेसर, तोर परमेसर ह आनंद के तेल ले तोर अभिसेक करे के दुवारा</para>
  <para style="q2" vid="PSA 45:7">तोला तोर संगीमन ले ऊपर करे हवय।<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>तोर जम्मो ओनहामन लोहबान, मुसब्बर अऊ दालचीनी के सुगंध ले महकत हंय;</para>
  <para style="q2" vid="PSA 45:8">हाथी-दांत ले सजे महल ले</para>
  <para style="q2" vid="PSA 45:8">तारवाले बाजा के संगीत ह तोला खुसी देवत हे।<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>राजामन के बेटीमन तोर सम्मानित माईलोगनमन के बीच हवंय;</para>
  <para style="q2" vid="PSA 45:9">तोर जेवनी हांथ कोति ओपीर के सोन ले सजे राजसी दुलहिन हवय।<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>हे बेटी, सुन, अऊ बने करके ये बात ऊपर धियान दे:</para>
  <para style="q2" vid="PSA 45:10">तोर मनखेमन अऊ तोर ददा के घर ला भुला दे।<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>राजा ह तोर सुघरता ला देखके मोहित होवय;</para>
  <para style="q2" vid="PSA 45:11">ओकर आदर कर, काबरकि ओह तोर परभू अय।<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>सूर देस के सहर ह एक ठन भेंट लेके आही,<note caller="+" style="f"><char style="fr" closed="false">45:12 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सूर के कपड़ा भेंट के रूप म होथे</char></note></para>
  <para style="q2" vid="PSA 45:12">धनी मनखेमन तोर दया के कामना करहीं।<verse eid="PSA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>राजकुमारी ह अपन कमरा म पूरा सोभायमान हे;</para>
  <para style="q2" vid="PSA 45:13">ओकर ओढ़ना म सोन के कसीदा कढ़ाय हवय।<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>कसीदा करे कपड़ा पहिराके ओला राजा करा लाने जाथे;</para>
  <para style="q2" vid="PSA 45:14">ओकर कुंवारी सखीमन ओकर पाछू-पाछू चलथें—</para>
  <para style="q2" vid="PSA 45:14">ओ सखीमन, जेमन ला ओकर संग रहे बर लाने जाथे।<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>आनंद अऊ खुसी के संग ओमन ला लाने जाथे,</para>
  <para style="q2" vid="PSA 45:15">अऊ ओमन राजा के महल के भीतर जाथें।<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>तोर ददामन के जगह ला तोर बेटामन लीहीं;</para>
  <para style="q2" vid="PSA 45:16">तेंह ओमन ला पूरा देस म राज करे बर ठहिराबे।<verse eid="PSA 45:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>मेंह अइसे करहूं कि पीढ़ी-पीढ़ी तक तोर नांव के चरचा होवत रहय;</para>
  <para style="q2" vid="PSA 45:17">एकरसेति जाति-जाति के मनखेमन हमेसा-हमेसा बर तोर परसंसा करहीं।<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="cl">भजन-संहिता 46<note caller="+" style="f"><char style="fr" closed="false">46 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 46:1-11">46:1‑11</ref></char> ला 46:2‑12 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। कोरह के बेटामन के <char style="tl">अलामोत</char><note caller="+" style="f"><char style="fr" closed="false">46:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note> के मुताबिक एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>परमेसर ह हमर सरन-स्थान अऊ बल अय,</para>
  <para style="q2" vid="PSA 46:1">बिपत के बेरा म ओह मदद करे बर हमेसा तियार रहिथे।<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>एकरसेति हमन नइं डरन, चाहे धरती ह पलट जावय</para>
  <para style="q2" vid="PSA 46:2">अऊ पहाड़ ह समुंदर के गरभ म जा गिरय।<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>चाहे समुंदर के पानी ह गरजय अऊ ओमा ले फेन निकलय</para>
  <para style="q2" vid="PSA 46:3">अऊ ओकर बड़े लहरामन ले पहाड़मन कांप उठंय।<verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>एक नदी हवय, जेकर जल-धारामन परमेसर के सहर ला खुस कर देथें,</para>
  <para style="q2" vid="PSA 46:4">ये ओ पबितर स्थान अय, जिहां सर्वोच्च परमेसर ह रहिथे।<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>परमेसर ह ओ नगर<note caller="+" style="f"><char style="fr" closed="false">46:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरूसलेम</char></note> म हवय, ओ नगर ह नइं गिरय;</para>
  <para style="q2" vid="PSA 46:5">बड़े बिहनियां परमेसर ह ओकर मदद करही।<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>जाति-जाति के मनखेमन के बीच खलबली मचे हवय, कतको राजमन गिर जावत हें;</para>
  <para style="q2" vid="PSA 46:6">ओह अपन अवाज ऊंचा करथे, त धरती ह टघल जाथे।<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>यहोवा सर्वसक्तिमान ह हमर संग हवय;</para>
  <para style="q2" vid="PSA 46:7">याकूब के परमेसर ह हमर गढ़ अय।<verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>आवव अऊ यहोवा के काम ला देखव</para>
  <para style="q2" vid="PSA 46:8">कि ओह धरती ला कइसे उजाड़ दे हवय।<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>ओह धरती के छोर तक</para>
  <para style="q2" vid="PSA 46:9">लड़ई ला रोक देथे।</para>
  <para style="q1" vid="PSA 46:9">ओह धनुस ला टोर देथे अऊ बरछी ला कुटा-कुटा कर देथे;</para>
  <para style="q2" vid="PSA 46:9">ओह ढालमन<note caller="+" style="f"><char style="fr" closed="false">46:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">रथमन</char></note> ला आगी म जला देथे।<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>ओह कहिथे, “सांत रहव, अऊ ये बात ला जान लव कि मेंह परमेसर अंव;</para>
  <para style="q2" vid="PSA 46:10">जाति-जाति के मनखेमन के बीच मोर नांव ला ऊंचा करे जाही,</para>
  <para style="q2" vid="PSA 46:10">धरती म मोर नांव ला ऊंचा करे जाही।”<verse eid="PSA 46:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>यहोवा सर्वसक्तिमान ह हमर संग हवय;</para>
  <para style="q2" vid="PSA 46:11">याकूब के परमेसर ह हमर गढ़ अय।<verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="cl">भजन-संहिता 47<note caller="+" style="f"><char style="fr" closed="false">47 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 47:1-9">47:1‑9</ref></char> ला 47:2‑10 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर कोरह के बेटामन के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>हे देस-देस के जम्मो मनखेमन, ताली बजावव;</para>
  <para style="q2" vid="PSA 47:1">आनंद के जय-जयकार के संग परमेसर ला पुकारव।<verse eid="PSA 47:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>काबरकि यहोवा, सर्वोच्च परमेसर ह अद्भूत ए,</para>
  <para style="q2" vid="PSA 47:2">ओह जम्मो धरती ऊपर महाराजा अय।<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>ओह देस-देस के मनखेमन ला</para>
  <para style="q2" vid="PSA 47:3">हमर अधीन, हमर गोड़ खाल्हे कर दे हवय।<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>ओह हमर निज भाग ला हमर बर चुनिस,</para>
  <para style="q2" vid="PSA 47:4">जऊन ह ओकर मयारू याकूब के घमंड के कारन अय।<verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>परमेसर ह आनंद के जय-जयकार के बीच ऊपर गे हवय,</para>
  <para style="q2" vid="PSA 47:5">यहोवा ह तुरही के अवाज के संग ऊपर गे हवय।<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>परमेसर के परसंसा के गीत गावव, परसंसा के गीत गावव;</para>
  <para style="q2" vid="PSA 47:6">हमर राजा के परसंसा के गीत गावव, परसंसा के गीत गावव।<verse eid="PSA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>काबरकि परमेसर ह जम्मो धरती के राजा अय;</para>
  <para style="q2" vid="PSA 47:7">ओकर परसंसा के भजन गावव।<verse eid="PSA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>परमेसर ह जाति-जाति के मनखेमन ऊपर राज करथे;</para>
  <para style="q2" vid="PSA 47:8">परमेसर ह अपन पबितर सिंघासन म बिराजे हवय।<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>राज-राज के परभावसाली मनखेमन</para>
  <para style="q2" vid="PSA 47:9">अब्राहम के परमेसर के मनखेमन के रूप म जूरथें,</para>
  <para style="q1" vid="PSA 47:9">काबरकि धरती के राजामन<note caller="+" style="f"><char style="fr" closed="false">47:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ढालमन</char></note> परमेसर के अंय;</para>
  <para style="q2" vid="PSA 47:9">ओला बहुंत ऊपर करे जाथे।<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="cl">भजन-संहिता 48<note caller="+" style="f"><char style="fr" closed="false">48 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 48:1-14">48:1‑14</ref></char> ला 48: 2‑15 गने गे हवय</char></note></para>
  <para style="d">एक गीत। कोरह के बेटामन के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>महान ए यहोवा, अऊ हमर परमेसर के सहर म,</para>
  <para style="q2" vid="PSA 48:1">ओकर पबितर पहाड़ म, ओह सबले जादा परसंसा के योग्य अय।<verse eid="PSA 48:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>सुघर हे अपन ऊंचई म</para>
  <para style="q2" vid="PSA 48:2">अऊ येह जम्मो धरती के आनंद ए,</para>
  <para style="q1" vid="PSA 48:2">सपोन<note caller="+" style="f"><char style="fr" closed="false">48:2 </char><char style="fq" closed="false">सपोन </char><char style="ft" closed="false">ह कनानीमन के सबले पबितर परबत रिहिस</char></note> के ऊंचई के सहीं हवय सियोन परबत,</para>
  <para style="q2" vid="PSA 48:2">जऊन ह महाराजा के सहर अय।<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>परमेसर ह उहां के किलामन म हवय;</para>
  <para style="q2" vid="PSA 48:3">ओह अपनआप ला ओकर गढ़ के रूप म देखाय हवय।<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>जब राजामन अपन सेना ला मिलाईन,</para>
  <para style="q2" vid="PSA 48:4">जब ओमन एक संग आघू बढ़िन,<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>त ओमन ओला देखिन अऊ चकित हो गीन;</para>
  <para style="q2" vid="PSA 48:5">अऊ ओमन डर के मारे भाग गीन।<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>ओमन उहां कांपे लगिन,</para>
  <para style="q2" vid="PSA 48:6">ओमन ला छेवारी होवत माईलोगन के सहीं पीरा होईस।<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>तेंह ओमन ला तरसीस के पानी जहाजमन सहीं नास कर देय</para>
  <para style="q2" vid="PSA 48:7">याने कि पुरवई हवा ले ओमन ला चकनाचूर कर देय।<verse eid="PSA 48:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>सर्वसक्तिमान यहोवा के सहर म,</para>
  <para style="q2" vid="PSA 48:8">हमर परमेसर के सहर म</para>
  <para style="q1" vid="PSA 48:8">जइसे हमन सुने हन</para>
  <para style="q2" vid="PSA 48:8">जइसे हमन देखे हन:</para>
  <para style="q1" vid="PSA 48:8">परमेसर ह ओला सदाकाल बर</para>
  <para style="q2" vid="PSA 48:8">सुरकछित बनाथे।<verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>हे परमेसर, तोर मंदिर के भीतर</para>
  <para style="q2" vid="PSA 48:9">हमन तोर अब्बड़ मया ऊपर चिंतन-मनन करथन।<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>हे परमेसर, तोर नांव के सहीं,</para>
  <para style="q2" vid="PSA 48:10">तोर परसंसा ह धरती के छोर तक हबरत हे;</para>
  <para style="q2" vid="PSA 48:10">तोर जेवनी हांथ ह धरमीपन ले भरे हवय।<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>तोर नियाय के काम के कारन</para>
  <para style="q2" vid="PSA 48:11">सियोन परबत आनंद मनावत हे,</para>
  <para style="q2" vid="PSA 48:11">अऊ यहूदा के बस्तीमन म खुसी हवय।<verse eid="PSA 48:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>सियोन करा जावव, ओकर चारों कोति चक्कर लगावव,</para>
  <para style="q2" vid="PSA 48:12">ओकर गुम्मटमन के गनती करव।<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>ओकर मजबूत दीवारमन ऊपर बने करके बिचार करव,</para>
  <para style="q2" vid="PSA 48:13">ओकर महलमन ला धियान से देखव,</para>
  <para style="q1" vid="PSA 48:13">ताकि अवइया पीढ़ी के मनखेमन ला</para>
  <para style="q2" vid="PSA 48:13">तुमन ओमन के बारे म बता सकव।<verse eid="PSA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>काबरकि ये परमेसर ह हमर सदाकाल के परमेसर अय;</para>
  <para style="q2" vid="PSA 48:14">ओहीच ह आखिरी तक हमर अगुवई करही।<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="cl">भजन-संहिता 49<note caller="+" style="f"><char style="fr" closed="false">49 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 49:1-20">49:1‑20</ref></char> ला 49:2‑21 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। कोरह के बेटामन के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>हे जम्मो मनखेमन, तुमन ये बात ला सुनव;</para>
  <para style="q2" vid="PSA 49:1">ये संसार म रहइया जम्मो झन सुनव,<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>का ऊंच, का नीच,</para>
  <para style="q2" vid="PSA 49:2">का धनी, का गरीब, जम्मो कान लगाके सुनव:<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>मोर मुहूं ले बुद्धि के बात निकलही;</para>
  <para style="q2" vid="PSA 49:3">मोर हिरदय के मनन-चिंतन ह समझ ले भरे होही।<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>मेंह नीतिबचन कोति अपन कान लगाहूं;</para>
  <para style="q2" vid="PSA 49:4">बीना बजात मेंह जनऊला के बात समझाहूं:<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>जब बिपत्ति के दिन आथे, त मेंह काबर डरंव,</para>
  <para style="q2" vid="PSA 49:5">जब दुस्ट धोखेबाजमन मोला घेर लेथें—<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>ओ मनखे, जेमन अपन धन ऊपर भरोसा रखथें</para>
  <para style="q2" vid="PSA 49:6">अऊ अपन बहुंत संपत्ति ऊपर घमंड करथें?<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>कोनो भी मनखे कोनो आने मनखे के जिनगी के उद्धार नइं कर सकय</para>
  <para style="q2" vid="PSA 49:7">या कोनो भी मनखे परमेसर ला ओकर छुड़ौती के दाम नइं दे सकय—<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>जिनगी के छुड़ौती के दाम ह मंहगा होथे,</para>
  <para style="q2" vid="PSA 49:8">कोनो भी दाम ओकर बर परयाप्त नो हय—<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>कि ओह सदाकाल तक जीयत रहय</para>
  <para style="q2" vid="PSA 49:9">अऊ कबर ला झन देखय।<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>काबरकि जम्मो झन देख सकत हें कि बुद्धिमानमन मरथें,</para>
  <para style="q2" vid="PSA 49:10">अऊ मुरूख अऊ अगियानी मनखेमन घलो</para>
  <para style="q2" vid="PSA 49:10">अपन धन-संपत्ति ला आने बर छोंड़के मर जाथें।<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>ओमन सोचथें कि ओमन के कबर ह सदाकाल तक ओमन के घर बने रहिही,</para>
  <para style="q2" vid="PSA 49:11">पीढ़ी-पीढ़ी तक ओमन के निवास होही,</para>
  <para style="q2" vid="PSA 49:11">काबरकि ओमन अपन भुइयां के नांव अपन नांव म रखथें।<verse eid="PSA 49:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>अपन धन-संपत्ति के बावजूद, मनखे ह हमेसा बने नइं रहय;</para>
  <para style="q2" vid="PSA 49:12">ओह पसु जइसन होथे, जऊन ह नास हो जाथे।<verse eid="PSA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>येह ओमन के दुरभाग्य ए, जेमन अपन ऊपर भरोसा रखथें,</para>
  <para style="q2" vid="PSA 49:13">अऊ ओमन के पाछू चलइया मनखेमन के घलो, जेमन ओमन के बात म सहमती देथें।<verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>ओमन भेड़मन सहीं अंय अऊ ओमन के मरना निस्चित अय;</para>
  <para style="q2" vid="PSA 49:14">मिरतू ह ओमन के चरवाहा होही</para>
  <para style="q2" vid="PSA 49:14">(पर सीधवा मनखे ह बिहनियां ओमन ऊपर जय पाही)।</para>
  <para style="q1" vid="PSA 49:14">ओमन के सुघर महल ले दूरिहा,</para>
  <para style="q2" vid="PSA 49:14">ओमन के देहें ह कबर म सर जाही।<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>पर परमेसर ह मोला मिरतू-लोक ले छोंड़ाही;</para>
  <para style="q2" vid="PSA 49:15">खचित, ओह मोला अपन इहां ले जाही।<verse eid="PSA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>जब आने मन धनी होथें,</para>
  <para style="q2" vid="PSA 49:16">जब ओमन के घर के सोभा बढ़थे, त झन डरव;<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>काबरकि जब ओमन मरहीं, त अपन संग कुछू नइं ले जावंय,</para>
  <para style="q2" vid="PSA 49:17">ओमन के सोभा ह ओमन के संग कबर म नइं जावय।<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>हालाकि जब ओमन जीयत रहिथें, त अपनआप ला आसीसित समझथें—</para>
  <para style="q2" vid="PSA 49:18">अऊ मनखेमन तोर बड़ई करथें जब तेंह उन्नति करथस—<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>ओमन अपन पुरखामन संग मिल जाहीं,</para>
  <para style="q2" vid="PSA 49:19">जेमन फेर कभू जिनगी के अंजोर ला नइं देखंय।<verse eid="PSA 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>ओ मनखे जेमन करा संपत्ति होथे, पर समझे के सक्ति नइं होवय,</para>
  <para style="q2" vid="PSA 49:20">ओमन ओ पसु सहीं होथें, जेमन नास हो जाथें।<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="cl">भजन-संहिता 50</para>
  <para style="d">आसाप के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>सक्तिसाली परमेसर, यहोवा ह</para>
  <para style="q2" vid="PSA 50:1">उदयाचल ले लेके अस्ताचल तक</para>
  <para style="q2" vid="PSA 50:1">धरती के मनखेमन ले गोठियाथे अऊ ओमन ला बलाथे।<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>सियोन ले, जेह अब्बड़ सुघर हे,</para>
  <para style="q2" vid="PSA 50:2">परमेसर के अंजोर चमकत हे।<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>हमर परमेसर ह आथे</para>
  <para style="q2" vid="PSA 50:3">अऊ ओह चुपेचाप नइं रहय;</para>
  <para style="q1" vid="PSA 50:3">ओकर आघू म एक भसम करइया आगी,</para>
  <para style="q2" vid="PSA 50:3">अऊ ओकर चारों कोति एक भयंकर आंधी हवय।<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>ओह अपन मनखेमन के नियाय करे बर</para>
  <para style="q2" vid="PSA 50:4">ऊपर ले अकास, अऊ धरती ला बलाथे:<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>“ये मोर भक्तमन ला मोर करा इकट्ठा करव,</para>
  <para style="q2" vid="PSA 50:5">जेमन बलिदान चघाके मोर संग करार करे हवंय।”<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>अऊ स्वरग ह ओकर धरमीपन के घोसना करत हे,</para>
  <para style="q2" vid="PSA 50:6">काबरकि ओह नियाय के परमेसर अय।<verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“हे मोर मनखेमन, सुनव, अऊ मेंह गोठियाहूं;</para>
  <para style="q2" vid="PSA 50:7">हे इसरायल, मेंह तोर बिरूध गवाही दूहूं:</para>
  <para style="q2" vid="PSA 50:7">मेंह परमेसर अंव, तोर परमेसर।<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>मेंह तोर बलिदान के बारे म या ओ होम-बलिदान के बारे म</para>
  <para style="q2" vid="PSA 50:8">तोर ऊपर दोस नइं लगावंव, जेला हमेसा मोला चढ़ाय जाथे।<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>मोला तोर घर ले बईला</para>
  <para style="q2" vid="PSA 50:9">या तोर बाड़ा ले बोकरा के जरूरत नइं ए,<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>काबरकि जंगल के हर एक पसु मोर अय,</para>
  <para style="q2" vid="PSA 50:10">अऊ हजारों पहाड़ीमन ऊपर चरत जानवर घलो मोरेच अंय।<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>मेंह पहाड़मन के जम्मो चिरईमन ला जानथंव,</para>
  <para style="q2" vid="PSA 50:11">अऊ मैदान के कीड़ा-मकोड़ामन मोरेच अंय।<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>यदि मेंह भूखा होतेंव, त मेंह तोला नइं कहितेंव,</para>
  <para style="q2" vid="PSA 50:12">काबरकि संसार अऊ ओमा के जम्मो चीजमन मोर अंय।<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>का मेंह सांड़मन के मांस खाथंव</para>
  <para style="q2" vid="PSA 50:13">या बोकरामन के लहू पीथंव?<verse eid="PSA 50:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>“परमेसर ला धनबाद रूपी भेंट चघा,</para>
  <para style="q2" vid="PSA 50:14">सर्वोच्च परमेसर बर अपन मन्नतमन ला पूरा कर,<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>संकट के बेरा म मोला पुकार;</para>
  <para style="q2" vid="PSA 50:15">मेंह तोला छुड़ाहूं, अऊ तेंह मोर आदरमान करबे।”<verse eid="PSA 50:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 50:16"/>पर दुस्ट मनखे ला परमेसर ह कहिथे:</para>
  <para style="q1" vid="PSA 50:16">“मोर कानूनमन के पाठ करे के</para>
  <para style="q2" vid="PSA 50:16">या मोर करारमन ला बताय के तोला का अधिकार हवय?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>तेंह तो मोर सिकछा ले घिन करथस</para>
  <para style="q2" vid="PSA 50:17">अऊ मोर बचन ला तुछ समझथस।<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>जब तेंह कोनो चोर ला देखथस, त ओकर संग सामिल हो जाथस;</para>
  <para style="q2" vid="PSA 50:18">तेंह बेभिचारीमन के संग भागी होथस।<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>तोर मुहूं ले बुरई के बात निकलथे</para>
  <para style="q2" vid="PSA 50:19">अऊ तोर जीभ ह छल-कपट के बात करथे।<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>तेंह बईठके अपन भाई के बिरूध गोठियाथस</para>
  <para style="q2" vid="PSA 50:20">अऊ अपन ही सगा भाई के निन्दा करथस।<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>जब तेंह ये काममन ला करय अऊ मेंह चुप रहेंव,</para>
  <para style="q2" vid="PSA 50:21">त तेंह समझे कि मेंह घलो बिलकुल तोर सहीं अंव।</para>
  <para style="q1" vid="PSA 50:21">पर मेंह अब तोर गलतीमन ला बतात हंव</para>
  <para style="q2" vid="PSA 50:21">अऊ तोर आघू म तोर दोसमन ला रखत हंव।<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>“तुमन, जेमन परमेसर ला भुला जाथव, येकर बारे म बिचार करव,</para>
  <para style="q2" vid="PSA 50:22">नइं तो मेंह तुमन ला चीरके कुटा-कुटा कर दूहूं,</para>
  <para style="q2" vid="PSA 50:22">अऊ तुमन ला बचानेवाला कोनो नइं होही:<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>जऊन मन मोला धनबाद-बलिदान चघाथें, ओमन मोर आदर करथें,</para>
  <para style="q2" vid="PSA 50:23">अऊ निरदोस मनखे ला मेंह अपन उद्धार के अनुभव कराहूं।”<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="cl">भजन-संहिता 51<note caller="+" style="f"><char style="fr" closed="false">51 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 51:1-19">51:1‑19</ref></char> ला 51:3‑21 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। दाऊद के एक भजन। दाऊद राजा के बतसेबा के संग बेभिचार करे के बाद जब नातान अगमजानी ह दाऊद करा आईस।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>हे परमेसर, अपन बड़े मया के मुताबिक</para>
  <para style="q2" vid="PSA 51:1">मोर ऊपर दया कर;</para>
  <para style="q1" vid="PSA 51:1">अपन बड़े करूना के मुताबिक</para>
  <para style="q2" vid="PSA 51:1">मोर अपराधमन ला मिटा दे।<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>मोर जम्मो अधरम ला धो डार</para>
  <para style="q2" vid="PSA 51:2">अऊ मोर पाप ले मोला सुध कर।<verse eid="PSA 51:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>काबरकि मेंह अपन अपराध ला जानत हंव,</para>
  <para style="q2" vid="PSA 51:3">अऊ मोर पाप ह हमेसा मोर आघू म रहिथे।<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>मेंह तोर, सिरिप तोर बिरूध म पाप करे हवंव</para>
  <para style="q2" vid="PSA 51:4">अऊ ओहीच काम करे हवंव, जऊन ह तोर नजर म पाप ए;</para>
  <para style="q1" vid="PSA 51:4">एकरसेति तेंह अपन फैसला म सही अस</para>
  <para style="q2" vid="PSA 51:4">अऊ जब नियाय करथस, त सही नियाय करथस।<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>खचित, मेंह जनम ले पापी अंव,</para>
  <para style="q2" vid="PSA 51:5">जब मोर दाई ह मोला गरभ म धरिस, तब ले मेंह पापी अंव।<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>तभो ले तेंह हिरदय के सच्चई ले खुस होथस;</para>
  <para style="q2" vid="PSA 51:6">तेंह मोला ओ गुपत जगह म बुद्धि सिखाय।<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>जूफा<note caller="+" style="f"><char style="fr" closed="false">51:7 </char><char style="fq" closed="false">जूफा </char><char style="ft" closed="false">ह एक छोटे पऊधा ए, जेकर उपयोग पानी छिंचे या खून छिंचे या मनखे ला संस्कारिक रूप म सुध करे म होथे</char></note> पऊधा ले मोला साफ कर, अऊ मेंह साफ हो जाहूं;</para>
  <para style="q2" vid="PSA 51:7">मोला धो, अऊ मेंह बरफ ले घलो जादा सफेद हो जाहूं।<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>मोला आनंद अऊ खुसी सबद सुनन दे;</para>
  <para style="q2" vid="PSA 51:8">जऊन हाड़ामन ला तेंह कुचर दे हस, ओमन आनंद मनावंय।<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>मोर पापमन ले तेंह अपन मुहूं ला छुपा ले</para>
  <para style="q2" vid="PSA 51:9">अऊ मोर जम्मो अपराध ला मिटा दे।<verse eid="PSA 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>हे परमेसर, मोर म एक सुध हिरदय बना,</para>
  <para style="q2" vid="PSA 51:10">अऊ मोर भीतर म नवां किसम ले एक अटल आतमा स्थापित कर।<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>मोला अपन आघू ले झन निकाल</para>
  <para style="q2" vid="PSA 51:11">या अपन पबितर आतमा ला मोर ले अलग झन कर।<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>अपन करे गय उद्धार के आनंद ले मोला फेर भर दे</para>
  <para style="q2" vid="PSA 51:12">मोला संभाले बर तोर बात माने के एक आतमा दे।<verse eid="PSA 51:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>तब मेंह अपराधीमन ला तोर हुकूम के सिकछा दूहूं,</para>
  <para style="q2" vid="PSA 51:13">ताकि पापीमन तोर करा लहुंट आवंय।<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>हे परमेसर, मोला खून बहाय के अपराध ले छुड़ा ले,</para>
  <para style="q2" vid="PSA 51:14">तेंह परमेसर मोर उद्धारकर्ता अस,</para>
  <para style="q2" vid="PSA 51:14">अऊ मेंह तोर धरमीपन के गीत गाहूं।<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>हे परभू, मोर मुहूं ला खोल,</para>
  <para style="q2" vid="PSA 51:15">अऊ मोर मुहूं ह तोर महिमा करही।<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>तेंह बलिदान चघाय ले खुस नइं होवस, नइं तो मेंह येला लानतेंव;</para>
  <para style="q2" vid="PSA 51:16">होम-बलिदान म तोला खुसी नइं होवय।<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>टूटे मन ह परमेसर बर योग्य बलिदान ए;</para>
  <para style="q2" vid="PSA 51:17">एक टूटे अऊ पछतापी मन</para>
  <para style="q2" vid="PSA 51:17">हे परमेसर, तेंह येला तुछ नइं समझस।<verse eid="PSA 51:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>सियोन के उन्नति करे म,</para>
  <para style="q2" vid="PSA 51:18">यरूसलेम सहर के दीवारमन के बनाय जाय म तोला खुसी मिलय।<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>तब तेंह धरमी के बलिदान ले खुस होबे,</para>
  <para style="q2" vid="PSA 51:19">याने कि पूरा होम-बलिदान चघाय ले खुस होबे;</para>
  <para style="q2" vid="PSA 51:19">तब तोर बेदी म बईलामन ला चघाय जाही।<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="cl">भजन-संहिता 52<note caller="+" style="f"><char style="fr" closed="false">52 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 52:1-9">52:1‑9</ref></char> ला 52:3‑11 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। दाऊद के एक <char style="tl">मसकील</char><note caller="+" style="f"><char style="fr" closed="false">52:0 </char><char style="fl" closed="false">संभवतः येह संगीत के एक सबद ए</char></note>। जब एदोमी दोएग ह साऊल करा जाके ओला कहिस: “दाऊद ह अहीमेलेक के घर गे हवय।”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>हे बलवान बीर, बुरई ऊपर काबर घमंड करथस?</para>
  <para style="q2" vid="PSA 52:1">दिन भर काबर घमंड करत रहिथस,</para>
  <para style="q2" vid="PSA 52:1">जबकि तेंह तो परमेसर के नजर म एक कलंक अस?<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>तेंह धोखाधड़ी करथस,</para>
  <para style="q2" vid="PSA 52:2">तोर जीभ ह बिनास के योजना बनाथे;</para>
  <para style="q2" vid="PSA 52:2">येह तो धारवाले एक उस्तरा सहीं अय।<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>तेंह भलई के बदले बुरई ले मया करथस,</para>
  <para style="q2" vid="PSA 52:3">अऊ सच बोले के बदले लबारी मारे ला पसंद करथस।<verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>हे धोखा देवइया जीभ!</para>
  <para style="q2" vid="PSA 52:4">तेंह हर हानि करइया बात ले मया करथस।<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>खचित परमेसर ह तोला हमेसा बर नास कर दीही:</para>
  <para style="q2" vid="PSA 52:5">ओह तोला धरके तोर डेरा ले निकाल दीही;</para>
  <para style="q2" vid="PSA 52:5">ओह तोला जीयत मनखेमन के लोक ले उखान डारही।<verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>धरमी मनखेमन येला देखके डरहीं;</para>
  <para style="q2" vid="PSA 52:6">ओमन ये कहिके तोर ऊपर हंसहीं,<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“इहां ये मनखे हवय</para>
  <para style="q2" vid="PSA 52:7">जऊन ह परमेसर ला अपन मजबूत गढ़ नइं बनाईस</para>
  <para style="q1" vid="PSA 52:7">पर अपन बहुंत धन-संपत्ति ऊपर भरोसा करिस</para>
  <para style="q2" vid="PSA 52:7">अऊ आने मन ला नास करे के दुवारा मजबूत होवत गीस!”<verse eid="PSA 52:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>पर मेंह परमेसर के घर म बढ़त</para>
  <para style="q2" vid="PSA 52:8">एक जैतून के रूख सहीं अंव;</para>
  <para style="q1" vid="PSA 52:8">मेंह हमेसा-हमेसा बर</para>
  <para style="q2" vid="PSA 52:8">परमेसर के अटूट मया ऊपर भरोसा रखथंव।<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>जऊन कुछू तेंह करे हस, ओकर बर मेंह हमेसा</para>
  <para style="q2" vid="PSA 52:9">तोर बिसवासयोग्य मनखेमन के आघू म तोर परसंसा करहूं।</para>
  <para style="q1" vid="PSA 52:9">अऊ मेंह तोर नांव ऊपर आसा रखहूं,</para>
  <para style="q2" vid="PSA 52:9">काबरकि तोर नांव ह बने ए।<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="cl">भजन-संहिता 53<note caller="+" style="f"><char style="fr" closed="false">53 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 53:1-6">53:1‑6</ref></char> ला 53:2‑7 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। <char style="tl">महलत</char><note caller="+" style="f"><char style="fr" closed="false">53:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note> के मुताबिक दाऊद के एक <char style="tl">मसकील</char>।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>मुरूख ह अपन मन म कहिथे,</para>
  <para style="q2" vid="PSA 53:1">“परमेसर नइं ए।”</para>
  <para style="q1" vid="PSA 53:1">ओमन बिगड़ गे हवंय, अऊ ओमन के चालचलन ह निकम्मा ए;</para>
  <para style="q2" vid="PSA 53:1">अइसे कोनो नइं ए, जऊन ह भलई करथे।<verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>परमेसर ह स्वरग ले</para>
  <para style="q2" vid="PSA 53:2">जम्मो मानव-जाति ला ये आसा म देखथे</para>
  <para style="q1" vid="PSA 53:2">कि कोनो समझदार हवय कि नइं,</para>
  <para style="q2" vid="PSA 53:2">कोनो परमेसर के खोज करथे कि नइं।<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>हर मनखे ह भटक गे हवय, जम्मो झन बिगड़ गे हवंय;</para>
  <para style="q2" vid="PSA 53:3">अइसे कोनो नइं ए, जऊन ह भलई करथे,</para>
  <para style="q2" vid="PSA 53:3">एको झन घलो नइं।<verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>का ये जम्मो दुस्ट काम करइयामन कुछू नइं जानंय?</para>
  <para style="b" vid="PSA 53:4"/>
  <para style="q1" vid="PSA 53:4">ओमन मोर मनखेमन ला अइसे खा जाथें, मानो कि रोटी खावत हें;</para>
  <para style="q2" vid="PSA 53:4">ओमन कभू परमेसर के नांव नइं लेवंय।<verse eid="PSA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>जिहां डरे के कोनो बात नइं रहय,</para>
  <para style="q2" vid="PSA 53:5">उहां ओमन डर के मारे घबरा गे हवंय।</para>
  <para style="q1" vid="PSA 53:5">जऊन मन तोर ऊपर हमला करिन, परमेसर ह ओमन के हाड़ामन ला बिखेर दीस;</para>
  <para style="q2" vid="PSA 53:5">तेंह ओमन ला लज्जित करय, काबरकि परमेसर ह ओमन ला तुछ जानिस।<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>बने होतिस कि इसरायल बर उद्धार ह सियोन ले बाहिर आतिस!</para>
  <para style="q2" vid="PSA 53:6">जब परमेसर ह अपन मनखेमन ला पहिले के सहीं कर देथे,</para>
  <para style="q2" vid="PSA 53:6">त याकूब ह आनंद मनावय अऊ इसरायल ह खुस होवय!<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="cl">भजन-संहिता 54<note caller="+" style="f"><char style="fr" closed="false">54 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 54:1-7">54:1‑7</ref></char> ला 54:3‑9 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। तारवाले बाजामन के संग। दाऊद के एक <char style="tl">मसकील</char><note caller="+" style="f"><char style="fr" closed="false">54:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>। जब जीपीमन साऊल करा जाके कहिन, “का दाऊद ह हमर बीच म नइं छिपे हे?”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>हे परमेसर, अपन नांव के दुवारा मोर उद्धार कर;</para>
  <para style="q2" vid="PSA 54:1">अपन सक्ति के दुवारा मोला सही साबित कर।<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>हे परमेसर, मोर पराथना ला सुन;</para>
  <para style="q2" vid="PSA 54:2">मोर मुहूं के बात ऊपर धियान दे।<verse eid="PSA 54:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>घमंडी बईरीमन मोर ऊपर हमला करत हवंय;</para>
  <para style="q2" vid="PSA 54:3">निरदयी मनखेमन मोला मार डारे के कोसिस करत हवंय—</para>
  <para style="q2" vid="PSA 54:3">ओ मनखे, जेमन के मन म परमेसर बर कोनो आदर नइं ए।<verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>खचित परमेसर ह मोर मददगार ए;</para>
  <para style="q2" vid="PSA 54:4">परभू ही मोला संभालथे।<verse eid="PSA 54:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>ओमन के निन्दा होवय, जऊन मन मोर निन्दा करथें;</para>
  <para style="q2" vid="PSA 54:5">हे परमेसर, अपन बिसवासयोग्यता म ओमन ला नास कर दे।<verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>मेंह तोला एक स्वेच्छा-बलिदान चघाहूं;</para>
  <para style="q2" vid="PSA 54:6">हे यहोवा, मेंह तोर नांव के परसंसा करहूं, काबरकि येह बने ए।<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>तेंह मोला मोर जम्मो समस्या ले छुटकारा दे हस,</para>
  <para style="q2" vid="PSA 54:7">अऊ मोर आंखी ह मोर बईरीमन ऊपर बिजय ला देखे हवय।<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="cl">भजन-संहिता 55<note caller="+" style="f"><char style="fr" closed="false">55 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 55:1-23">55:1‑23</ref></char> ला 55:2‑24 गने गे हवय</char></note></para>
  <para style="d">संगीत निरदेसक बर। तारवाले बाजामन के संग। दाऊद के एक <char style="tl">मसकील</char><note caller="+" style="f"><char style="fr" closed="false">55:0 </char><char style="fl" closed="false">सायद संगीत के एक सबद</char></note>।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>हे परमेसर, मोर पराथना ला सुन,</para>
  <para style="q2" vid="PSA 55:1">मोर बिनती ला अनसुना झन कर;<verse eid="PSA 55:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 55:2"/>मोर बात ला सुन अऊ मोला जबाब दे।</para>
  <para style="q1" vid="PSA 55:2">मोर बिचारमन मोला चिंता म डारत हें अऊ मेंह बियाकुल हंव<verse eid="PSA 55:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 55:3"/>काबरकि मोर बईरी ह मोर बिरूध कहत हे,</para>
  <para style="q2" vid="PSA 55:3">अऊ दुस्टमन धमकी देवत हें;</para>
  <para style="q1" vid="PSA 55:3">काबरकि ओमन मोर ऊपर दुख-तकलीफ लानत हें</para>
  <para style="q2" vid="PSA 55:3">अऊ गुस्सा होके मोला उल्टा-सीधा कहत हें।<verse eid="PSA 55:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>मोर हिरदय ह भीतरे-भीतर पीरा म हवय;</para>
  <para style="q2" vid="PSA 55:4">मिरतू के आतंक मोर ऊपर छा गे हवय।<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>डर अऊ कंपकपी मोला घेर ले हवय;</para>
  <para style="q2" vid="PSA 55:5">बहुंत भय के कारन मेंह बियाकुल हो गे हंव।<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>मेंह कहेंव, “कास, मोर एक पंड़की सहीं डेना होतिस!</para>
  <para style="q2" vid="PSA 55:6">त मेंह उड़ जातेंव अऊ अराम करतेंव।<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>मेंह उड़के दूरिहा चले जातेंव</para>
  <para style="q2" vid="PSA 55:7">अऊ निरजन जगह म रहितेंव;<verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>मेंह आंधी अऊ तूफान ले दूरिहा</para>
  <para style="q2" vid="PSA 55:8">जल्दी से अपन सरन-स्थान म चले जातेंव।”<verse eid="PSA 55:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>हे परभू, दुस्टमन ला बिचलित कर दे, ओमन के बात म गड़बड़ी कर दे,</para>
  <para style="q2" vid="PSA 55:9">काबरकि मेंह सहर म हिंसा अऊ झगरा देखत हंव।<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>रात अऊ दिन ओमन सहर के दीवार म चोरी-छुपे घुमथें;</para>
  <para style="q2" vid="PSA 55:10">सहर के भीतर दुस्टता अऊ गाली भरे हवय।<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>सहर म बिनास करइया ताकतमन काम करत हें;</para>
  <para style="q2" vid="PSA 55:11">धमकी अऊ लबारी बात येकर गलीमन ला कभू नइं छोंड़ंय।<verse eid="PSA 55:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>कहूं कोनो बईरी ह मोर बेजत्ती करतिस,</para>
  <para style="q2" vid="PSA 55:12">त मेंह सह लेतेंव;</para>
  <para style="q1" vid="PSA 55:12">कहूं कोनो बईरी ह मोर बिरूध खड़े होतिस,</para>
  <para style="q2" vid="PSA 55:12">त मेंह ओकर ले छिप जातेंव।<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>पर येह तो तें अस, मोर सहीं एक मनखे,</para>
  <para style="q2" vid="PSA 55:13">मोर संगवारी, मोर लंगोटिया संगी,<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>जेकर संग परमेसर के घर म</para>
  <para style="q2" vid="PSA 55:14">एक समय मेंह संगति के आनंद उठात रहेंव,</para>
  <para style="q1" vid="PSA 55:14">जब अराधना करइयामन के बीच</para>
  <para style="q2" vid="PSA 55:14">हमन आवत-जावत रहेंन।<verse eid="PSA 55:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>अचानक मोर बईरीमन के मिरतू हो जावय;</para>
  <para style="q2" vid="PSA 55:15">ओमन मिरतू-लोक म जीयत चले जावंय,</para>
  <para style="q2" vid="PSA 55:15">काबरकि दुस्टमन ला ओमन के बीच रहे बर मिलथे।<verse eid="PSA 55:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>पर जहां तक मोर बात ए, मेंह परमेसर के नांव लेथंव,</para>
  <para style="q2" vid="PSA 55:16">अऊ यहोवा ह मोला बचाथे।<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>सांझ, बिहनियां अऊ मंझन के बेरा</para>
  <para style="q2" vid="PSA 55:17">मेंह ओला दुख म पुकारथंव,</para>
  <para style="q2" vid="PSA 55:17">अऊ ओह मोर बात ला सुनथे।<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>मोर बिरूध करे जावत लड़ई म</para>
  <para style="q2" vid="PSA 55:18">ओह मोला बिगर कोनो हानि के बचा लेथे,</para>
  <para style="q2" vid="PSA 55:18">हालाकि बहुंते जन मोर बिरोध करथें।<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>परमेसर, जऊन ह आदिकाल ले बिराजमान हे,</para>
  <para style="q2" vid="PSA 55:19">जऊन ह नइं बदलय—</para>
  <para style="q1" vid="PSA 55:19">ओह ओमन के सुनही अऊ ओमन ला नम्र करही,</para>
  <para style="q2" vid="PSA 55:19">काबरकि ओमन म परमेसर के भय नइं ए।<verse eid="PSA 55:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>मोर संगवारी ह अपन संगीमन ऊपर हमला करथे;</para>
  <para style="q2" vid="PSA 55:20">ओह अपन करार ला टोरथे।<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>ओकर बातचीत ह मक्खन के सहीं चिक्कन हवय,</para>
  <para style="q2" vid="PSA 55:21">पर ओकर मन म लड़ई के बात रहिथे;</para>
  <para style="q1" vid="PSA 55:21">ओकर बचन ह तेल ले जादा नरम हवय,</para>
  <para style="q2" vid="PSA 55:21">पर ओमन तलवार निकाले सहीं अंय।<verse eid="PSA 55:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>अपन जिम्मेदारी यहोवा ऊपर डार दे</para>
  <para style="q2" vid="PSA 55:22">अऊ ओह तोला संभालही;</para>
  <para style="q1" vid="PSA 55:22">ओह धरमी ला कभू</para>
  <para style="q2" vid="PSA 55:22">डगमगावन नइं देवय।<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>पर हे परमेसर, तें दुस्टमन ला</para>
  <para style="q2" vid="PSA 55:23">बिनास के खंचवा म गिराबे;</para>
  <para style="q1" vid="PSA 55:23">खून के पीयासा अऊ धोखेबाज मनखेमन</para>
  <para style="q2" vid="PSA 55:23">अपन आधा जिनगी घलो नइं जी सकहीं।</para>
  <para style="b" vid="PSA 55:23"/>
  <para style="q1" vid="PSA 55:23">पर जहां तक मोर बात ए, मेंह तोर ऊपर भरोसा करथंव।<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="cl">भजन-संहिता 56<note caller="+" style="f"><char style="fr" closed="false">56 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 56:1-13">56:1‑13</ref></char> ला 56:2‑14 गने गे हवय</char></note></para>
  <para style="d">संगीत निरदेसक बर। दूरिहा के बांज रूख म बईठे पंड़की के एक धुन। दाऊद के एक <char style="tl">मिकताम</char>।<note caller="+" style="f"><char style="fr" closed="false">56:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note> जब पलिस्तीमन दाऊद ला गत म पकड़ ले रिहिन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>हे मोर परमेसर, मोर ऊपर दया कर,</para>
  <para style="q2" vid="PSA 56:1">काबरकि मोर बईरीमन बहुंत पीछा करत हें;</para>
  <para style="q2" vid="PSA 56:1">दिन भर ओमन अपन हमला करे के दबाव बनाथें।<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>मोर बिरोधीमन दिन भर मोर पीछा करथें;</para>
  <para style="q2" vid="PSA 56:2">अपन घमंड म बहुंते झन मोर ऊपर हमला करत हें।<verse eid="PSA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>जब मेंह डर जाथंव, त मेंह तोर ऊपर अपन भरोसा रखथंव।<verse eid="PSA 56:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 56:4"/>परमेसर ऊपर, जेकर बचन के मेंह परसंसा करथंव—</para>
  <para style="q1" vid="PSA 56:4">परमेसर ऊपर मेंह भरोसा रखथंव अऊ मेंह नइं डरंव।</para>
  <para style="q2" vid="PSA 56:4">मरनहार मनखे ह मोर का कर सकत हे?<verse eid="PSA 56:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>दिन भर ओमन मोर बचन ला तोड़थें-मरोड़थें;</para>
  <para style="q2" vid="PSA 56:5">ओमन के जम्मो उपाय मोला बरबाद करे बर रहिथे।<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>ओमन सडयंत्र करथें, ओमन घात म लगे रहिथें,</para>
  <para style="q2" vid="PSA 56:6">ओमन मोर अवई-जवई ऊपर ये आसा म नजर गड़ाय रहिथें,</para>
  <para style="q2" vid="PSA 56:6">कि ओमन मोर परान ले सकंय।<verse eid="PSA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>ओमन के दुस्टता के कारन, ओमन ला बचके झन जावन दे;</para>
  <para style="q2" vid="PSA 56:7">हे परमेसर, अपन कोरोध म, ये मनखेमन ला गिरा दे।<verse eid="PSA 56:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>मोर दुरगति ला लिख ले;</para>
  <para style="q2" vid="PSA 56:8">मोर आंसूमन ला अपन कुप्पी म रख ले—</para>
  <para style="q2" vid="PSA 56:8">का ओमन तोर अभिलेख म नइं लिखे गे हवंय?<verse eid="PSA 56:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>जब मेंह मदद बर पुकारहूं</para>
  <para style="q2" vid="PSA 56:9">त ओमन लहुंटके भागहीं।</para>
  <para style="q2" vid="PSA 56:9">येकर दुवारा जानहूं कि परमेसर ह मोर कोति हवय।<verse eid="PSA 56:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>परमेसर ऊपर, जेकर बचन के मेंह परसंसा करथंव,</para>
  <para style="q2" vid="PSA 56:10">यहोवा ऊपर, जेकर बचन के मेंह परसंसा करथंव—<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>ओही परमेसर ऊपर, मेंह भरोसा रखथंव अऊ मेंह नइं डरंव।</para>
  <para style="q2" vid="PSA 56:11">मनखे ह मोर का कर सकथे?<verse eid="PSA 56:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>हे मोर परमेसर, मेंह तोर बर सपथ खाय हंव;</para>
  <para style="q2" vid="PSA 56:12">मेंह तोला धनबाद-बलिदान चघाहूं।<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>काबरकि तेंह मोला मिरतू ले</para>
  <para style="q2" vid="PSA 56:13">अऊ मोर गोड़मन ला ठोकर खाय ले बचाय हस,</para>
  <para style="q1" vid="PSA 56:13">ताकि मेंह जिनगी के अंजोर म</para>
  <para style="q2" vid="PSA 56:13">परमेसर के आघू म चल सकंव।<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="cl">भजन-संहिता 57<note caller="+" style="f"><char style="fr" closed="false">57 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 57:1-11">57:1‑11</ref></char> ला 57:2‑12 गने गे हवय</char></note></para>
  <para style="d">संगीत निरदेसक बर। “झन नास कर” धुन म दाऊद के एक <char style="tl">मिकताम</char><note caller="+" style="f"><char style="fr" closed="false">57:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>। जब ओह साऊल ले भागके गुफा म छुपे रिहिस।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>हे मोर परमेसर, मोर ऊपर दया कर, मोर ऊपर दया कर,</para>
  <para style="q2" vid="PSA 57:1">काबरकि मेंह तोर करा सरन लेथंव।</para>
  <para style="q1" vid="PSA 57:1">जब तक बिपत्ति ह टर नइं जाही</para>
  <para style="q2" vid="PSA 57:1">मेंह तोर डेनामन के छइहां म सरन लूहूं।<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>मेंह सर्वोच्च परमेसर ला पुकारथंव,</para>
  <para style="q2" vid="PSA 57:2">ओ परमेसर, जऊन ह मोर रकछा करथे।<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>ओह स्वरग ले पठोथे अऊ मोला बचा लेथे,</para>
  <para style="q2" vid="PSA 57:3">अऊ ओमन ला डांटथे, जऊन मन मोर बहुंत पीछा करथें—</para>
  <para style="q2" vid="PSA 57:3">परमेसर ह अपन मया अऊ अपन बिसवासयोग्यता देखाथे।<verse eid="PSA 57:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>मेंह सिंहमन के बीच म हंव;</para>
  <para style="q2" vid="PSA 57:4">मेंह भूखा जानवरमन के बीच म रहे बर मजबूर हंव—</para>
  <para style="q1" vid="PSA 57:4">ओ मनखे, जेमन के दांतमन बरछी अऊ तीर सहीं अंय,</para>
  <para style="q2" vid="PSA 57:4">जेमन के जीभमन धारवाले तलवार सहीं अंय।<verse eid="PSA 57:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>हे परमेसर, तोर महिमा ह स्वरगमन ले घलो ऊपर होवय;</para>
  <para style="q2" vid="PSA 57:5">जम्मो धरती ऊपर तोर महिमा होवय।<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>ओमन मोर गोड़ बर एक जाल बिछाथें—</para>
  <para style="q2" vid="PSA 57:6">दुख म मोर चेहरा ह झुक गे हवय।</para>
  <para style="q1" vid="PSA 57:6">ओमन मोर रसता म एक खंचवा खनिन—</para>
  <para style="q2" vid="PSA 57:6">पर ओमा ओमन खुद गिर गे हवंय।<verse eid="PSA 57:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>हे परमेसर, मोर मन ह अटल हवय,</para>
  <para style="q2" vid="PSA 57:7">मोर मन ह अटल हवय;</para>
  <para style="q2" vid="PSA 57:7">मेंह गाहूं अऊ बाजा बजाहूं।<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>हे मोर आतमा, जाग!</para>
  <para style="q2" vid="PSA 57:8">हे बीना अऊ सारंगी, जागव!</para>
  <para style="q2" vid="PSA 57:8">मेंह बड़े बिहनियां ला जगाहूं।<verse eid="PSA 57:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>हे परभू, मेंह जाति-जाति के मनखेमन के बीच म तोर परसंसा करहूं;</para>
  <para style="q2" vid="PSA 57:9">मेंह मनखेमन के बीच म तोर गीत गाहूं।<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>काबरकि तोर मया ह अतेक महान ए कि ओह स्वरग तक हबरत हे;</para>
  <para style="q2" vid="PSA 57:10">तोर बिसवासयोग्यता ह अकास तक हबरत हे।<verse eid="PSA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>हे परमेसर, तोर महिमा स्वरगमन ले घलो ऊपर होवय;</para>
  <para style="q2" vid="PSA 57:11">जम्मो धरती ऊपर तोर महिमा होवय।<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="cl">भजन-संहिता 58<note caller="+" style="f"><char style="fr" closed="false">58 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 58:1-11">58:1‑11</ref></char> ला 58:2‑12 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। दाऊद के “नास झन कर” धुन म एक <char style="tl">मिकताम</char><note caller="+" style="f"><char style="fr" closed="false">58:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>हे सासन करइयामन, का तुमन सही म नियाय-संगत बात करथव?</para>
  <para style="q2" vid="PSA 58:1">का तुमन मनखेमन के सही नियाय करथव?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>नइं, अपन मन म तुमन अनियाय करे के उपाय करथव,</para>
  <para style="q2" vid="PSA 58:2">अऊ अपन हांथ ले धरती म हिंसा फईलाथव।<verse eid="PSA 58:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>अऊ त अऊ दुस्टमन जनम ले गलत रसता म चलथें;</para>
  <para style="q2" vid="PSA 58:3">गरभ ले ही ओमन लबारी बात फईलात भटक जाथें।<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>ओमन के जहर ह एक सांप के जहर सहीं अय,</para>
  <para style="q2" vid="PSA 58:4">एक नाग सांप के सहीं अय, जऊन ह कि नइं सुनय,<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>अऊ ओह संपेरा के धुन ऊपर धियान नइं देवय,</para>
  <para style="q2" vid="PSA 58:5">ओ संपेरा ह चाहे कतको मोहित करइया धुन देवय।<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>हे परमेसर, ओमन के मुहूं म ही ओमन के दांत ला टोर दे;</para>
  <para style="q2" vid="PSA 58:6">हे यहोवा, ओ सिंहमन के दांत ला जड़ ले ही उखान दे!<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>ओमन ओ पानी के सहीं गायब हो जावंय, जऊन ह बहत-बहत आघू निकल जाथे;</para>
  <para style="q2" vid="PSA 58:7">जब ओमन धनुस तानंय, त ओमन के तीर ह निसाना म झन लगय।<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>ओमन एक घोंघा के सहीं हो जावंय, जऊन ह सरकत-सरकत टघल जाथे,</para>
  <para style="q2" vid="PSA 58:8">ओमन एक मरे जनमे लइका सहीं होवंय, जऊन ह सूरज ला कभू नइं देखय।<verse eid="PSA 58:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>येकर पहिले कि कंटिला-झाड़ी म लगे आगी के आंच ह तोर हांड़ी म लगय—</para>
  <para style="q2" vid="PSA 58:9">चाहे ओमन हरियर होवंय या सूख गे होवंय—ओमन ला बवंडर म उड़ा दिये जाही।<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>जब ओमन ले बदला लिये जाही, त धरमीमन खुस होहीं,</para>
  <para style="q2" vid="PSA 58:10">जब ओमन अपन पांव दुस्टमन के खून म डारहीं।<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>तब मनखेमन कहिहीं,</para>
  <para style="q2" vid="PSA 58:11">“खचित धरमीमन ला अभी घलो ईनाम दिये जाथे;</para>
  <para style="q2" vid="PSA 58:11">खचित एक परमेसर हवय, जऊन ह धरती के नियाय करथे।”<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="cl">भजन-संहिता 59<note caller="+" style="f"><char style="fr" closed="false">59 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 59:1-17">59:1‑17</ref></char> ला 59:2‑18 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। दाऊद के “नास झन कर” धुन म एक <char style="tl">मिकताम</char><note caller="+" style="f"><char style="fr" closed="false">59:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>। जब साऊल ह दाऊद ला मार डारे बर ओकर घर म मनखेमन ला पठोके पहरा बईठाय रिहिस।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>हे परमेसर, मोला मोर बईरीमन ले बचा;</para>
  <para style="q2" vid="PSA 59:1">जऊन मन मोर ऊपर हमला करत हें, ओमन ले मोर रकछा कर।<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>मोला दुस्ट काम करइया मनखेमन ले छोंड़ा</para>
  <para style="q2" vid="PSA 59:2">अऊ मोला ओमन ले बचा, जऊन मन मोर परान लेय बर चाहथें।<verse eid="PSA 59:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>देख, ओमन कइसे मोर घात म लगे हवंय!</para>
  <para style="q2" vid="PSA 59:3">हे यहोवा, मेंह कोनो दोस या पाप नइं करे हंव,</para>
  <para style="q2" vid="PSA 59:3">तभो ले हिंसा करइया मनखेमन मोर बिरूध सडयंत्र करत हें।<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>मेंह कोनो गलती नइं करे हंव, तभो ले ओमन मोर ऊपर हमला करे बर तियार हवंय।</para>
  <para style="q2" vid="PSA 59:4">मोर मदद करे बर उठ; मोर दुरदसा ला देख!<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>हे यहोवा, सर्वसक्तिमान परमेसर,</para>
  <para style="q2" vid="PSA 59:5">तेंह इसरायल के परमेसर अस,</para>
  <para style="q1" vid="PSA 59:5">जम्मो आनजातमन ला दंड देय बर जाग;</para>
  <para style="q2" vid="PSA 59:5">दुस्ट बिसवासघातीमन ऊपर कोनो दया झन देखा।<verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>ओमन कुकुरमन सहीं गुर्रावत</para>
  <para style="q2" vid="PSA 59:6">सांझ के लहुंटथें,</para>
  <para style="q2" vid="PSA 59:6">अऊ छिपके सहर म घुमथें।<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>देख, ओमन अपन मुहूं ले का उछरथें—</para>
  <para style="q2" vid="PSA 59:7">ओमन के मुहूं ले निकले बात म तलवार सहीं धार हवय,</para>
  <para style="q2" vid="PSA 59:7">अऊ ओमन सोचथें, “हमर बात ला कोन सुन सकथे?”<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>पर हे यहोवा, तेंह ओमन ऊपर हांसथस;</para>
  <para style="q2" vid="PSA 59:8">तेंह ओ जम्मो आनजातमन के हंसी उड़ाथस।<verse eid="PSA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>तेंह मोर ताकत अस, मेंह तोर इंतजार म रहिथंव;</para>
  <para style="q2" vid="PSA 59:9">हे परमेसर, तेंह मोर गढ़ अस,<verse eid="PSA 59:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 59:10"/>हे मोर परमेसर, तोर ऊपर मेंह भरोसा करथंव।</para>
  <para style="b" vid="PSA 59:10"/>
  <para style="q1" vid="PSA 59:10">परमेसर ह मोर आघू-आघू जाही</para>
  <para style="q2" vid="PSA 59:10">अऊ जऊन मन मोर निन्दा करथें, ओमन ला घूरके देखे के मोला मऊका दीही।<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>पर हे परभू हमर ढाल,<note caller="+" style="f"><char style="fr" closed="false">59:11 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमपरधान</char></note> ओमन के हतिया झन कर,</para>
  <para style="q2" vid="PSA 59:11">नइं तो मोर मनखेमन भुला जाहीं।</para>
  <para style="q1" vid="PSA 59:11">अपन सक्ति ले ओमन ला उखान दे</para>
  <para style="q2" vid="PSA 59:11">अऊ ओमन ला गिरा दे।<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>ओमन के मुहूं के पाप बर,</para>
  <para style="q2" vid="PSA 59:12">ओमन के ओंठ ले निकले बचन बर,</para>
  <para style="q2" vid="PSA 59:12">ओमन अपन घमंड म पकड़े जावंय।</para>
  <para style="q1" vid="PSA 59:12">ओमन जऊन सराप देथें अऊ लबारी मारथें, ओकर बर<verse eid="PSA 59:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13"/>ओमन ला अपन कोरोध म जलाके नास कर दे,</para>
  <para style="q2" vid="PSA 59:13">ओमन ला अइसे जलाके नास कर कि ओमन पूरा नास हो जावंय।</para>
  <para style="q1" vid="PSA 59:13">तब धरती के छोर तक पता चलही</para>
  <para style="q2" vid="PSA 59:13">कि परमेसर ह याकूब ऊपर सासन करथे।<verse eid="PSA 59:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>ओमन कुकुरमन सहीं गुर्रावत,</para>
  <para style="q2" vid="PSA 59:14">सांझ के लहुंटथें,</para>
  <para style="q2" vid="PSA 59:14">अऊ छिपके सहर म घुमथें।<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>ओमन जेवन बर भटकथें</para>
  <para style="q2" vid="PSA 59:15">अऊ कहूं संतोस नइं होवंय, त कुकुर या भेड़िया सहीं रोथें।<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>पर मेंह तोर ताकत के गुन गाहूं,</para>
  <para style="q2" vid="PSA 59:16">बिहनियां मेंह तोर मया के गीत गाहूं;</para>
  <para style="q1" vid="PSA 59:16">काबरकि तेंह मोर गढ़ अस,</para>
  <para style="q2" vid="PSA 59:16">संकट के बेरा म मोर सरन-स्थान अस।<verse eid="PSA 59:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>तेंह मोर बल अस, मेंह तोर परसंसा के गीत गाथंव;</para>
  <para style="q2" vid="PSA 59:17">हे परमेसर, तेंह मोर गढ़ अस,</para>
  <para style="q2" vid="PSA 59:17">मोर परमेसर, जेकर ऊपर मेंह भरोसा करथंव।<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="cl">भजन-संहिता 60<note caller="+" style="f"><char style="fr" closed="false">60 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 60:1-12">60:1‑12</ref></char> ला 60:3‑14 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। “करार के कुमुदिनी” के धुन म दाऊद के एक <char style="tl">मिकताम</char><note caller="+" style="f"><char style="fr" closed="false">60:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>। सिखाय बर। जब ओह अरम-नहरैम अऊ अरम-सोबा ले लड़िस, अऊ जब योआब ह लहुंटके नून के घाटी म बारह हजार एदोमीमन ला मार गिराईस।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>हे परमेसर, तेंह हमन ला अस्वीकार कर दे हस, अऊ हमर ऊपर बरस पड़े हस:</para>
  <para style="q2" vid="PSA 60:1">तेंह हमर ऊपर गुस्सा करे हस—पर अब हमन ला पहिले सहीं कर दे!<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>तेंह भुइयां ला कंपाय हस अऊ येला फोर दे हस;</para>
  <para style="q2" vid="PSA 60:2">येकर दरारमन ला ठीक कर दे, काबरकि येह कांपत हे।<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>तेंह अपन मनखेमन ला निरासा के दिन देखाय हस;</para>
  <para style="q2" vid="PSA 60:3">तेंह हमन ला अंगूर के मंद दे हस, जेकर ले हमन लड़खड़ाथन।<verse eid="PSA 60:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>पर जऊन मन तोर भय मानथें, ओमन बर तेंह एक झंडा उठाय हस</para>
  <para style="q2" vid="PSA 60:4">ताकि जहाज के आघू म फहराय जावय।<verse eid="PSA 60:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>अपन जेवनी हांथ उठाके हमन ला बचा अऊ हमर मदद कर,</para>
  <para style="q2" vid="PSA 60:5">ताकि जऊन मन तोर ले मया करथें, ओमन छोंड़ाय जावंय।<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>परमेसर ह अपन पबितर-स्थान ले कहे हवय:</para>
  <para style="q2" vid="PSA 60:6">“जीत के खुसी म, मेंह सकेम ला बांट दूहूं</para>
  <para style="q2" vid="PSA 60:6">अऊ सुक्कोत के घाटी ला नापहूं।<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>गिलाद ह मोर ए, अऊ मनस्से ह घलो मोर ए;</para>
  <para style="q2" vid="PSA 60:7">एपरैम ह मोर मुड़ के टोप ए,</para>
  <para style="q2" vid="PSA 60:7">यहूदा ह मोर राजदंड ए।<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>मोआब ह मोर हांथ-मुहूं धोए के बरतन ए,</para>
  <para style="q2" vid="PSA 60:8">एदोम ऊपर मेंह अपन पनही ला उछालहूं;</para>
  <para style="q2" vid="PSA 60:8">पलिस्ती ऊपर मेंह जीत के खुसी म चिचियाहूं।”<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>कोन ह मोला गढ़वाले सहर म लानही?</para>
  <para style="q2" vid="PSA 60:9">कोन ह मोला एदोम देस ले जाही?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>हे परमेसर, का ये तें नो हस, तें जऊन ह कि हमन ला अस्वीकार करे हस</para>
  <para style="q2" vid="PSA 60:10">अऊ अब हमर सेना के संग नइं जावस?<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>बईरीमन के बिरूध हमर मदद कर,</para>
  <para style="q2" vid="PSA 60:11">काबरकि मनखे के दिये मदद ह बेकार ए।<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>परमेसर के मदद ले ही हमन बिजयी होबो,</para>
  <para style="q2" vid="PSA 60:12">अऊ ओह हमर बईरीमन ला कुचर दीही।<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="cl">भजन-संहिता 61<note caller="+" style="f"><char style="fr" closed="false">61 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 61:1-8">61:1‑8</ref></char> ला 61:2‑9 गने गे हवय</char></note></para>
  <para style="d">संगीत निरदेसक बर। तारवाले बाजामन के संग दाऊद के भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>हे परमेसर, मोर पुकार ला सुन;</para>
  <para style="q2" vid="PSA 61:1">मोर पराथना ला सुन।<verse eid="PSA 61:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>धरती के छोर ले मेंह तोला पुकारत हंव,</para>
  <para style="q2" vid="PSA 61:2">तोला पुकारत-पुकारत मोर मन ह दुरबल होवथे;</para>
  <para style="q2" vid="PSA 61:2">मोला ओ चट्टान ऊपर ले जा, जऊन ह मोर ले ऊंच हे।<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>काबरकि तेंह मोर सरन-स्थान ठहिरे हस,</para>
  <para style="q2" vid="PSA 61:3">अऊ बईरीमन के बिरूध एक मजबूत दीवार अस।<verse eid="PSA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>मेंह लालसा करथंव कि तोर डेरा म हमेसा बर रहंव</para>
  <para style="q2" vid="PSA 61:4">अऊ तोर डेनामन के छइहां म सरन लेवंव।<verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>हे परमेसर, तेंह मोर मन्नतमन ला सुने हस;</para>
  <para style="q2" vid="PSA 61:5">तेंह मोला ओमन के कुल-परंपरा ला दे हस; जऊन मन तोर नांव के भय मानथें।<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>राजा के उमर ला बढ़ा,</para>
  <para style="q2" vid="PSA 61:6">पीढ़ी-पीढ़ी तक ओकर उमर ला बढ़ा दे।<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>परमेसर के उपस्थिति म ओह हमेसा सिंघासन म बईठय;</para>
  <para style="q2" vid="PSA 61:7">ओकर रकछा म अपन मया अऊ बिसवासयोग्यता ला बनाय रख।<verse eid="PSA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>तब मेंह हमेसा तोर नांव के परसंसा करहूं</para>
  <para style="q2" vid="PSA 61:8">अऊ दिन-प्रतिदिन अपन मन्नतमन ला पूरा करहूं।<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="cl">भजन-संहिता 62<note caller="+" style="f"><char style="fr" closed="false">62 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 62:1-12">62:1‑12</ref></char> ला 62:2‑13 गने गे हवय</char></note></para>
  <para style="d">संगीत निरदेसक बर। यदूतून राग म दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>सही म मोर जीव ला परमेसर म अराम मिलथे;</para>
  <para style="q2" vid="PSA 62:1">मोर उद्धार ओकर करा ले आथे।<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>सही म ओह मोर चट्टान अऊ मोर उद्धार ए;</para>
  <para style="q2" vid="PSA 62:2">ओह मोर गढ़ ए, मेंह कभू नइं डगमगाहूं।<verse eid="PSA 62:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>कब तक तुमन मोर ऊपर हमला करत रहिहू?</para>
  <para style="q2" vid="PSA 62:3">का तुमन जम्मो झन मोला खाल्हे फटिक दूहू—</para>
  <para style="q2" vid="PSA 62:3">में तो झुके दीवार, गिरत बाड़ा के सहीं अंव?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>खचित ओमन मोला</para>
  <para style="q2" vid="PSA 62:4">मोर ऊंच जगह ले गिराय के इरादा रखथें;</para>
  <para style="q2" vid="PSA 62:4">ओमन लबारी मारे म खुस होथें।</para>
  <para style="q1" vid="PSA 62:4">अपन मुहूं ले ओमन आसीस देथें,</para>
  <para style="q2" vid="PSA 62:4">पर अपन मन म सराप देथें।<verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>हव, मोर जीव ला परमेसर म अराम मिलथे;</para>
  <para style="q2" vid="PSA 62:5">ओकर ऊपर मोर आसा हवय।<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>सही म ओह मोर चट्टान अऊ मोर उद्धार ए;</para>
  <para style="q2" vid="PSA 62:6">ओह मोर गढ़ ए, मेंह नइं डगमगाहूं।<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>मोर उद्धार अऊ मोर आदर परमेसर ऊपर निरभर हवय<note caller="+" style="f"><char style="fr" closed="false">62:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सर्वोच्च परमेसर ह मोर उद्धार अऊ मोर आदर ए</char></note>;</para>
  <para style="q2" vid="PSA 62:7">ओह मोर मजबूत चट्टान, मोर सरन-स्थान ए।<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>हे मनखेमन, ओकर ऊपर हर समय भरोसा रखव;</para>
  <para style="q2" vid="PSA 62:8">ओकर आघू म अपन बात खुले मन से कहव,</para>
  <para style="q2" vid="PSA 62:8">काबरकि परमेसर ह हमर सरन-स्थान ए।<verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>सही म नीच कुल म जनमे मनखेमन सिरिप एक सांस अंय,</para>
  <para style="q2" vid="PSA 62:9">अऊ ऊंच कुल म जनमे मनखेमन सिरिप एक लबारी अंय।</para>
  <para style="q1" vid="PSA 62:9">कहूं ओमन ला तराजू म तऊले जावय, त ओमन के कुछू वजन नइं ए;</para>
  <para style="q2" vid="PSA 62:9">एक संग ओमन सिरिप एक सांस अंय।<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>अनुचित वसूली ऊपर भरोसा झन करव</para>
  <para style="q2" vid="PSA 62:10">या चोरी के चीज म आसा झन रखव;</para>
  <para style="q1" vid="PSA 62:10">हालाकि तुम्हर संपत्ति बढ़थे,</para>
  <para style="q2" vid="PSA 62:10">पर ओमा अपन मन झन लगावव।<verse eid="PSA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>परमेसर ह एक बात कहे हवय,</para>
  <para style="q2" vid="PSA 62:11">दू बात मेंह सुने हवंव:</para>
  <para style="q1" vid="PSA 62:11">“हे परमेसर, सामर्थ ह तोर अय,<verse eid="PSA 62:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12"/>अऊ हे परभू, तोर म अब्बड़ मया हवय”;</para>
  <para style="q1" vid="PSA 62:12">अऊ, “तेंह हर एक जन ला</para>
  <para style="q2" vid="PSA 62:12">ओमन के काम के मुताबिक ईनाम देथस।”<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="cl">भजन-संहिता 63<note caller="+" style="f"><char style="fr" closed="false">63 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 63:1-11">63:1‑11</ref></char> ला 63:2‑12 गने गे हवय</char></note></para>
  <para style="d">दाऊद के एक भजन। जब ओह यहूदा के निरजन जगह म रिहिस।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>हे परमेसर, तेंह मोर परमेसर अस,</para>
  <para style="q2" vid="PSA 63:1">उत्सुक होके मेंह तोला खोजथंव;</para>
  <para style="q1" vid="PSA 63:1">सूखा अऊ झुलसत भुइयां म</para>
  <para style="q2" vid="PSA 63:1">जिहां पानी नइं ए,</para>
  <para style="q1" vid="PSA 63:1">मेंह तोर पीयासा हंव,</para>
  <para style="q2" vid="PSA 63:1">मोर पूरा सरीर तोर संगति के कामना करथे।<verse eid="PSA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>मेंह पबितर-स्थान म तोला देखे हवंव</para>
  <para style="q2" vid="PSA 63:2">अऊ तोर सामर्थ अऊ तोर महिमा ला निहारेंव।<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>काबरकि तोर मया ह जिनगी ले जादा बने अय,</para>
  <para style="q2" vid="PSA 63:3">मोर मुहूं ह तोर महिमा करही।<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>जब तक मेंह जीयत हंव, मेंह तोर परसंसा करहूं,</para>
  <para style="q2" vid="PSA 63:4">अऊ तोर नांव के महिमा म मेंह अपन हांथ उठाहूं।<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>मानो बने जेवन ले मेंह पूरा संतुस्ट होहूं,</para>
  <para style="q2" vid="PSA 63:5">अऊ मेंह मोर मुहूं ले गावत तोर परसंसा करहूं।<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>अपन दसना म मेंह तोला सुरता करथंव;</para>
  <para style="q2" vid="PSA 63:6">रथिया के बेरा मेंह तोर बारे म सोचथंव।<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>काबरकि तेंह मोर मददगार अस,</para>
  <para style="q2" vid="PSA 63:7">मेंह तोर डेना के छइहां म गाथंव।<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>मेंह तोर संग लगे रहिथंव;</para>
  <para style="q2" vid="PSA 63:8">तोर जेवनी हांथ ह मोला संभालथे।<verse eid="PSA 63:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>जऊन मन मोला मार डारे चाहथें, ओमन नास हो जाहीं;</para>
  <para style="q2" vid="PSA 63:9">ओमन धरती के गहरई म दब जाहीं।<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>ओमन तलवार ले मारे जाहीं</para>
  <para style="q2" vid="PSA 63:10">अऊ सियारमन के जेवन बन जाहीं।<verse eid="PSA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>पर राजा ह परमेसर म आनंद मनाही;</para>
  <para style="q2" vid="PSA 63:11">ओ जम्मो जऊन मन परमेसर के सपथ खाथें, ओमन ओकर महिमा करहीं,</para>
  <para style="q2" vid="PSA 63:11">जबकि लबरामन के मुहूं ला बंद करे जाही।<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="cl">भजन-संहिता 64<note caller="+" style="f"><char style="fr" closed="false">64 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 64:1-10">64:1‑10</ref></char> ला 64:2‑11 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>हे मोर परमेसर, जब मेंह अपन सिकायत लेके आथंव, त मोर बात ला सुन;</para>
  <para style="q2" vid="PSA 64:1">बईरीमन के धमकी ले मोर जिनगी ला बचा।<verse eid="PSA 64:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>दुस्टमन के सडयंत्र ले, दुस्ट काम करइयामन के</para>
  <para style="q2" vid="PSA 64:2">योजना ले मोला बचा।<verse eid="PSA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>ओमन तलवार के सहीं अपन जीभ ला तेज करथें</para>
  <para style="q2" vid="PSA 64:3">अऊ घातक तीर के सहीं करू बचन कहिथें।<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>ओमन घात लगाके निरदोस ऊपर तीर चलाथें;</para>
  <para style="q2" vid="PSA 64:4">ओमन बिगर डरे, अचानक तीर चलाथें।<verse eid="PSA 64:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>ओमन दुस्ट योजना बनाय बर एक-दूसर ला उकसाथें,</para>
  <para style="q2" vid="PSA 64:5">ओमन अपन जाल ला छुपाय के बारे म गोठियाथें;</para>
  <para style="q2" vid="PSA 64:5">ओमन कहिथें, “कोन ह येला<note caller="+" style="f"><char style="fr" closed="false">64:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">हमन ला</char></note> देखही?”<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>ओमन अनियाय करे के सडयंत्र रचथें अऊ कहिथें,</para>
  <para style="q2" vid="PSA 64:6">“हमन एकदम सही योजना बनाय हन!”</para>
  <para style="q2" vid="PSA 64:6">सही म मनखे के मन अऊ हिरदय चालबाज अंय।<verse eid="PSA 64:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>पर परमेसर ह ओमन ऊपर अपन तीर चलाही;</para>
  <para style="q2" vid="PSA 64:7">ओमन अचानक घात करे जाहीं।<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>परमेसर ह ओमन के खुद के जीभ ला ओमन के बिरूध कर दीही</para>
  <para style="q2" vid="PSA 64:8">अऊ ओमन के बिनास कर दीही;</para>
  <para style="q2" vid="PSA 64:8">जऊन मन ओमन ला देखहीं, ओ जम्मो झन ओमन ला तुछ जानके अपन मुड़ हलाहीं।<verse eid="PSA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>जम्मो मनखेमन डर जाहीं;</para>
  <para style="q2" vid="PSA 64:9">ओमन परमेसर के काम के बखान करहीं</para>
  <para style="q2" vid="PSA 64:9">अऊ जऊन कुछू ओह करे हवय, ओकर ऊपर बिचार करहीं।<verse eid="PSA 64:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>धरमी जन ह यहोवा म आनंद मनाही</para>
  <para style="q2" vid="PSA 64:10">अऊ ओकर करा सरन लीही;</para>
  <para style="q2" vid="PSA 64:10">ओ जम्मो मनखे, जऊन मन हिरदय ले ईमानदार अंय, ओमन ओकर परसंसा करहीं!<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="cl">भजन-संहिता 65<note caller="+" style="f"><char style="fr" closed="false">65 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 65:1-13">65:1‑13</ref></char> ला 65:2‑14 गने गे हवय</char></note></para>
  <para style="d">संगीत निरदेसक बर। दाऊद के एक भजन। एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>हे हमर परमेसर, सियोन म परसंसा ह तोर बाट जोहथे;</para>
  <para style="q2" vid="PSA 65:1">तोर बर हमर दुवारा करे गे मन्नतमन पूरा करे जाहीं।<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>तें, जऊन ह कि पराथना के जबाब देथस,</para>
  <para style="q2" vid="PSA 65:2">तोर करा जम्मो मनखेमन आहीं।<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>जब हमन बहुंत पाप ले बियाकुल हो जाथन,</para>
  <para style="q2" vid="PSA 65:3">त तेंह हमर अपराधमन ला छेमा करथस।<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>धइन अंय ओमन, जेमन ला तेंह चुनथस</para>
  <para style="q2" vid="PSA 65:4">अऊ अपन अंगना म रहे बर ओमन ला लकठा म लानथस!</para>
  <para style="q1" vid="PSA 65:4">हमन तोर घर के, तोर पबितर मंदिर के</para>
  <para style="q2" vid="PSA 65:4">बने चीजमन ले भर गे हवन।<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>हे परमेसर हमर उद्धार करइया,</para>
  <para style="q2" vid="PSA 65:5">तेंह धरती के छोर अऊ दूरिहा समुंदर म रहइया</para>
  <para style="q1" vid="PSA 65:5">जम्मो झन के आसा अस,</para>
  <para style="q2" vid="PSA 65:5">तेंह हमन ला अद्भूत अऊ धरमी काम करके हमन ला जबाब देथस,<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>तेंह अपनआप ला ताकत ले भरके,</para>
  <para style="q2" vid="PSA 65:6">पहाड़मन ला अपन सामर्थ ले बनाय हस,<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>तेंह समुंदर के गरजन ला,</para>
  <para style="q2" vid="PSA 65:7">समुंदर के लहर के गरजन ला,</para>
  <para style="q2" vid="PSA 65:7">अऊ देस-देस के कोलाहल ला सांत करथस।<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>जम्मो धरती ह भय अऊ तोर अद्भूत काम ले भर गे हवय;</para>
  <para style="q2" vid="PSA 65:8">जिहां तेंह बिहनियां के अंजोर अऊ सांझ के अंधियारा लानथस,</para>
  <para style="q2" vid="PSA 65:8">तेंह आनंद के गीत गवाथस।<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>तेंह भुइयां के खियाल रखथस अऊ ओला पानी ले पलोथस;</para>
  <para style="q2" vid="PSA 65:9">तेंह येला बहुंत उपजाऊ बनाथस।</para>
  <para style="q1" vid="PSA 65:9">परमेसर के पानी के सोतमन पानी ले भरे हवंय</para>
  <para style="q2" vid="PSA 65:9">ताकि मनखेमन ला अनाज मिलय,</para>
  <para style="q2" vid="PSA 65:9">काबरकि तेंह येला अइसे ठहिराय हस।<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>तेंह येकर घारीमन ला भीगोथस अऊ येकर उभारमन ला समतल करथस;</para>
  <para style="q2" vid="PSA 65:10">तेंह येला बारिस के पानी ले नरम करथस अऊ येकर फसल ला आसीस देथस।<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>तेंह बछर ला बहुंत फसल ले भर देथस,</para>
  <para style="q2" vid="PSA 65:11">अऊ बहुंत चीजमन के कारन तोर गाड़ीमन म जगह नइं रहय।<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>निरजन जगह के भुइयांमन कांदी ले भर गे हवंय;</para>
  <para style="q2" vid="PSA 65:12">पहाड़ीमन खुसी के चादर ओढ़े हवंय।<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>चरागनमन पसुमन के झुंड ले भर गे हवंय</para>
  <para style="q2" vid="PSA 65:13">अऊ घाटीमन अनाज ले ढंक गे हवंय;</para>
  <para style="q2" vid="PSA 65:13">ओमन आनंद के मारे जय-जयकार करथें अऊ गीत गाथें।<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="cl">भजन-संहिता 66</para>
  <para style="d">संगीत निरदेसक बर। एक गीत। एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>हे जम्मो धरती के मनखेमन, परमेसर बर आनंद के जय-जयकार करव!<verse eid="PSA 66:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 66:2"/>ओकर नांव के महिमा के गीत गावव;</para>
  <para style="q2" vid="PSA 66:2">महिमा के संग ओकर परसंसा करव।<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>परमेसर ला कहव, “का ही अद्भूत अंय तोर काममन!</para>
  <para style="q2" vid="PSA 66:3">तोर सामर्थ ह अइसे महान हे</para>
  <para style="q2" vid="PSA 66:3">कि तोर बईरीमन तोर आघू म चापलूसी करथें।<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>जम्मो धरती के मनखेमन तोर दंडवत करथें;</para>
  <para style="q2" vid="PSA 66:4">ओमन तोर परसंसा के गीत गाथें,</para>
  <para style="q2" vid="PSA 66:4">ओमन तोर नांव के परसंसा के गीत गाथें।”<verse eid="PSA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>आवव अऊ देखव कि परमेसर ह का करे हवय,</para>
  <para style="q2" vid="PSA 66:5">मानव-जाति बर ओकर अद्भूत काममन!<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>ओह समुंदर ला सूखा भुइयां कर दीस,</para>
  <para style="q2" vid="PSA 66:6">ओमन पैदल नदी के ओ पार चल दीन—</para>
  <para style="q2" vid="PSA 66:6">आवव, ओमा आनंदित होवव।<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>ओह अपन सामर्थ ले सदाकाल बर सासन करथे,</para>
  <para style="q2" vid="PSA 66:7">ओकर आंखीमन जाति-जाति के मनखेमन ला देखत रहिथें—</para>
  <para style="q2" vid="PSA 66:7">ओकर बिरूध बिदरोहीमन झन ठाढ़ होवंय।<verse eid="PSA 66:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>हे जम्मो मनखेमन, हमर परमेसर के परसंसा करव,</para>
  <para style="q2" vid="PSA 66:8">ओकर परसंसा के अवाज सुनई देवय;<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>ओह हमर जिनगी ला बचाय हवय</para>
  <para style="q2" vid="PSA 66:9">अऊ हमर गोड़ ला फिसल जाय ले बचाय हवय।<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>हे परमेसर, तेंह हमन ला परखे हस;</para>
  <para style="q2" vid="PSA 66:10">तेंह हमन ला चांदी के सहीं साफ करे हस।<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>तेंह हमन ला जेल म ले आय</para>
  <para style="q2" vid="PSA 66:11">अऊ हमर पीठ म बोझा डार देय।<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>तेंह मनखेमन ला हमर मुड़ ऊपर सवारी करे बर दे हस;</para>
  <para style="q2" vid="PSA 66:12">हमन आगी अऊ पानी म ले होके गे हवन,</para>
  <para style="q2" vid="PSA 66:12">पर तेंह हमन ला ओ जगह म ले आय, जिहां चीजमन बहुंतायत म हवंय।<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>मेंह तोर मंदिर म होम-बलिदान लेके आहूं</para>
  <para style="q2" vid="PSA 66:13">अऊ तोर बर माने गय अपन मन्नतमन ला पूरा करहूं—<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>ओ मन्नत, जेकर परतिगियां मेंह अपन ओंठ ले करे रहंय अऊ अपन मुहूं ले माने रहंय</para>
  <para style="q2" vid="PSA 66:14">जब मेंह समस्या म पड़े रहंय।<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>मेंह तोला मोटा-ताजा पसु</para>
  <para style="q2" vid="PSA 66:15">अऊ मेढ़ामन के बलिदान चघाहूं;</para>
  <para style="q2" vid="PSA 66:15">मेंह तोला सांड़ अऊ बोकरा चघाहूं।<verse eid="PSA 66:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>ओ जम्मो झन, जऊन मन परमेसर के भय मानथव, आवव अऊ सुनव;</para>
  <para style="q2" vid="PSA 66:16">मेंह तुमन ला बतावत हंव कि ओह मोर बर का करे हवय।<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>मेंह अपन मुहूं ले ओला पुकारेंव;</para>
  <para style="q2" vid="PSA 66:17">मोर ओंठ ले ओकर परसंसा करेंव।<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>कहूं मेंह अपन मन म पाप करे होतेंव,</para>
  <para style="q2" vid="PSA 66:18">त परभू ह मोर बात ला नइं सुनतिस;<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>पर खचित परमेसर ह धियान दे हवय</para>
  <para style="q2" vid="PSA 66:19">अऊ मोर पराथना ला सुने हवय।<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>परमेसर के परसंसा होवय,</para>
  <para style="q2" vid="PSA 66:20">जऊन ह मोर पराथना ला सुनिस</para>
  <para style="q2" vid="PSA 66:20">या अपन मया ला मोर ऊपर ले नइं हटाईस!<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="cl">भजन-संहिता 67<note caller="+" style="f"><char style="fr" closed="false">67 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 67:1-7">67:1‑7</ref></char> ला 67:2‑8 गने गे हवय</char></note></para>
  <para style="d">संगीत निरदेसक बर। तारवाले बाजा के संग। एक भजन। एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>परमेसर ह हमर ऊपर अनुग्रह करय अऊ हमन ला आसीस देवय</para>
  <para style="q2" vid="PSA 67:1">अऊ अपन मुहूं के अंजोर हमर ऊपर चमकावय—<verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>ताकि धरती म तोर ईछा,</para>
  <para style="q2" vid="PSA 67:2">अऊ जम्मो जाति म तोर उद्धार के पता चलय।<verse eid="PSA 67:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>हे परमेसर, मनखेमन तोर परसंसा करंय;</para>
  <para style="q2" vid="PSA 67:3">जम्मो मनखेमन तोर परसंसा करंय।<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>देस-देस के मनखेमन खुसी मनांय अऊ आनंद के गीत गावंय,</para>
  <para style="q2" vid="PSA 67:4">काबरकि तें मनखेमन ऊपर बिगर पखियपात के सासन करथस</para>
  <para style="q2" vid="PSA 67:4">अऊ धरती के देस-देस के मनखेमन के अगुवई करथस।<verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>हे परमेसर, मनखेमन तोर परसंसा करंय;</para>
  <para style="q2" vid="PSA 67:5">जम्मो मनखेमन तोर परसंसा करंय।<verse eid="PSA 67:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>भुइयां ह अपन फसल देथे;</para>
  <para style="q2" vid="PSA 67:6">परमेसर, हमर परमेसर हमन ला आसीस देथे।<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>परमेसर हमन ला अऊ आसीस देवय,</para>
  <para style="q2" vid="PSA 67:7">ताकि धरती के जम्मो छोर तक मनखेमन ओकर भय मानंय।<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="cl">भजन-संहिता 68<note caller="+" style="f"><char style="fr" closed="false">68 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 68:1-35">68:1‑35</ref></char> ला 68:2‑36 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। दाऊद के एक भजन। एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>परमेसर ह उठय, ओकर बईरीमन तितिर-बितिर हो जावंय;</para>
  <para style="q2" vid="PSA 68:1">ओकर बईरीमन ओकर आघू ले भाग जावंय।<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>तें ओमन ला धुआं के सहीं उड़ा दे—</para>
  <para style="q2" vid="PSA 68:2">जइसे मोम ह आगी के आंच ले टघलथे,</para>
  <para style="q2" vid="PSA 68:2">वइसे ही दुस्ट मनखेमन परमेसर के आघू म नास हो जावंय।<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>पर धरमी जन परमेसर के आघू म</para>
  <para style="q2" vid="PSA 68:3">खुस होवंय अऊ आनंद मनावंय;</para>
  <para style="q2" vid="PSA 68:3">ओमन खुसी मनावंय अऊ आनंदित होवंय।<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>परमेसर के गीत गावव, ओकर नांव के परसंसा के गीत गावव,</para>
  <para style="q2" vid="PSA 68:4">ओकर बहुंत परसंसा करव, जऊन ह बादर ऊपर सवारी करथे<note caller="+" style="f"><char style="fr" closed="false">68:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओकर बर रसता तियार करव, जऊन ह निरजन जगह म ले होके जाथे</char></note>;</para>
  <para style="q2" vid="PSA 68:4">ओकर आघू म आनंद मनावव—ओकर नांव यहोवा ए।<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>परमेसर ह अपन पबितर निवास म हवय,</para>
  <para style="q2" vid="PSA 68:5">ओह अनाथमन बर एक ददा अऊ बिधवामन बर एक रकछा करइया ए।<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>परमेसर ह अकेला मनखे ला परिवार म बसाथे,</para>
  <para style="q2" vid="PSA 68:6">ओह कैदीमन ला गीत गवात अगुवई करथे;</para>
  <para style="q2" vid="PSA 68:6">पर बिदरोहीमन सूरज के गरमी ले झुलसत भुइयां म रहिथें।<verse eid="PSA 68:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>हे परमेसर, जब तेंह अपन मनखेमन के आघू ले निकलय,</para>
  <para style="q2" vid="PSA 68:7">जब तेंह निरजन जगह ले होके चलय,<verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>त धरती ह कांपिस, अकास ह बारिस भेजिस,</para>
  <para style="q2" vid="PSA 68:8">परमेसर, सीनय पहाड़ के परमेसर के आघू म,</para>
  <para style="q2" vid="PSA 68:8">परमेसर, इसरायल के परमेसर के आघू म।<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>हे परमेसर, तेंह बहुंत बारिस दे हस;</para>
  <para style="q2" vid="PSA 68:9">तेंह अपन थके-मांदे निज मनखेमन ला तरो-ताजा करे हस।<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>तोर मनखेमन येमा बस गे हवंय,</para>
  <para style="q2" vid="PSA 68:10">अऊ हे परमेसर, अपन उदारता से तेंह गरीबमन ला दे हस।<verse eid="PSA 68:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>परभू ह बचन के घोसना करथे,</para>
  <para style="q2" vid="PSA 68:11">अऊ येला सुनानेवाली माईलोगनमन के एक बड़े सेना हो जाथे:<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>“राजा अऊ सेनामन जल्दबाजी म भागथें;</para>
  <para style="q2" vid="PSA 68:12">माईलोगनमन घर म लूट के सामान ला बांटथें।<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>अऊ त अऊ जब तुमन भेड़साला म सुतथव,</para>
  <para style="q2" vid="PSA 68:13">त मोर पंड़की के डेना म चांदी चढ़ाय जाथे,</para>
  <para style="q2" vid="PSA 68:13">अऊ येकर पांखीमन म चमकत सोन मढ़े जाथे।”<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>जब सर्वसक्तिमान परमेसर ह राजामन ला देस म तितिर-बितिर करिस,</para>
  <para style="q2" vid="PSA 68:14">त येह सलमोन पहाड़ म बरफ गिरे के सहीं रिहिस।<verse eid="PSA 68:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>बासान पहाड़, सानदार पहाड़,</para>
  <para style="q2" vid="PSA 68:15">बासान पहाड़ उबड़-खाबड़ पहाड़,<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>हे उबड़-खाबड़ पहाड़, तेंह ओ पहाड़ ला</para>
  <para style="q2" vid="PSA 68:16">टकटकी लगाके काबर देखत हस, जेला परमेसर ह राज करे बर चुने हे,</para>
  <para style="q2" vid="PSA 68:16">जिहां यहोवा ह खुद सदाकाल बर निवास करही?<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>परमेसर के रथमन बीस हजार</para>
  <para style="q2" vid="PSA 68:17">अऊ हजारों-हजार हवंय;</para>
  <para style="q2" vid="PSA 68:17">परभू ह सीनय पहाड़ ले अपन पबितर-स्थान म आय हवय।<note caller="+" style="f"><char style="fr" closed="false">68:17 </char><char style="ft" closed="false">मूल इबरानी म </char><char style="fq" closed="false">परभू </char><char style="fqa" closed="false">ह पबितरता म ओमन के बीच सीनय म हवय</char></note><verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>जब तेंह ऊंचहा जगह म गय,</para>
  <para style="q2" vid="PSA 68:18">त तेंह अपन संग बहुंत बंधुवामन ला ले गय;</para>
  <para style="q2" vid="PSA 68:18">तोला मनखेमन ले उपहार मिलिस,</para>
  <para style="q1" vid="PSA 68:18">अऊ त अऊ बिदरोहीमन ले घलो उपहार मिलिस—</para>
  <para style="q2" vid="PSA 68:18">कि हे यहोवा परमेसर, तें उहां निवास कर।<verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>परभू, परमेसर हमर उद्धारकर्ता के परसंसा होवय,</para>
  <para style="q2" vid="PSA 68:19">जऊन ह हर दिन हमर बोझा ला उठाथे।<verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>हमर परमेसर ह ओ परमेसर अय, जऊन ह हमन ला बचाथे;</para>
  <para style="q2" vid="PSA 68:20">मिरतू ले बचाव परमपरधान यहोवा ले ही आथे।<verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>खचित परमेसर ह अपन बईरीमन के मुड़ ला कुचरही,</para>
  <para style="q2" vid="PSA 68:21">ओमन के बालवाले मुड़मन ला कुचरही, जऊन मन पाप करत रहिथें।<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>परभू ह कहिथे, “मेंह ओमन ला बासान ले लानहूं;</para>
  <para style="q2" vid="PSA 68:22">मेंह ओमन ला समुंदर के गहरई ले लानहूं,<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>कि तें अपन बईरीमन के खून म चलके जा सकस,</para>
  <para style="q2" vid="PSA 68:23">अऊ तोर कुकुरमन ला ओमन के बांटा खाय बर मिलय।”<verse eid="PSA 68:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>हे परमेसर, तोर जुलूस ला देखे गे हवय,</para>
  <para style="q2" vid="PSA 68:24">ओ जुलूस, जऊन ह मोर परमेसर अऊ मोर राजा के अय अऊ जऊन ह पबितर-स्थान म जावत हे।<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>आघू-आघू गवइयामन अऊ ओमन के पाछू बाजावाले हवंय;</para>
  <para style="q2" vid="PSA 68:25">ओमन के संग जवान माईलोगनमन खंजरी बजात हवंय।<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>बड़े सभा म परमेसर के परसंसा करव;</para>
  <para style="q2" vid="PSA 68:26">इसरायल के सभा म यहोवा के परसंसा करव।<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>बिनयामीन के छोटे गोत्र ह ओमन के अगुवई करत हे,</para>
  <para style="q2" vid="PSA 68:27">उहां यहूदा के राजकुमारमन के बड़े झुंड हवय,</para>
  <para style="q2" vid="PSA 68:27">अऊ उहां जबूलून अऊ नपताली के राजकुमारमन हवंय।<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>हे परमेसर, अपन सामर्थ ला देखा;</para>
  <para style="q2" vid="PSA 68:28">हे हमर परमेसर, हमन ला अपन ताकत देखा, जइसे कि तेंह पहिले करे हस।<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>यरूसलेम म तोर मंदिर के कारन</para>
  <para style="q2" vid="PSA 68:29">राजामन तोर बर भेंट लेके आहीं।<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>नरकट म रहत जंगली पसुमन ला,</para>
  <para style="q2" vid="PSA 68:30">देस-देस के बछरूमन के बीच सांड़मन के झुंड ला डांट-फटकार।</para>
  <para style="q1" vid="PSA 68:30">नम्र होके, ओ जंगली पसुमन चांदी के छड़ लानंय।</para>
  <para style="q2" vid="PSA 68:30">देस-देस के ओ मनखेमन ला तितिर-बितिर कर दे, जऊन मन लड़ई ले खुस होथें।<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>दूतमन मिसर देस ले आहीं;</para>
  <para style="q2" vid="PSA 68:31">कूस<note caller="+" style="f"><char style="fr" closed="false">68:31 </char><char style="ft" closed="false">नील के ऊपरी इलाका</char></note> ह अपनआप ला परमेसर के अधीन कर दीही।<verse eid="PSA 68:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>हे धरती के राजमन, परमेसर के गीत गावव,</para>
  <para style="q2" vid="PSA 68:32">परभू के परसंसा के गीत गावव,<verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>ओकर परसंसा करव, जऊन ह सनातन स्वरग, सबले ऊंच स्वरग म सवारी करथे,</para>
  <para style="q2" vid="PSA 68:33">जऊन ह तेज अवाज म गरजथे।<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>परमेसर के सामर्थ के घोसना करव,</para>
  <para style="q2" vid="PSA 68:34">जेकर वैभव इसरायल ऊपर हवय,</para>
  <para style="q2" vid="PSA 68:34">जेकर सामर्थ स्वरग म हवय।<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>हे परमेसर, तेंह अपन पबितर-स्थान म अद्भूत अस;</para>
  <para style="q2" vid="PSA 68:35">इसरायल के परमेसर ह अपन मनखेमन ला सामर्थ अऊ बल देथे।</para>
  <para style="b" vid="PSA 68:35"/>
  <para style="q1" vid="PSA 68:35">परमेसर के परसंसा होवय!<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="cl">भजन-संहिता 69<note caller="+" style="f"><char style="fr" closed="false">69 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 69:1-36">69:1‑36</ref></char> ला 69:2‑37 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। कुमुदिनी के धुन म दाऊद के गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>हे परमेसर, मोला बचा,</para>
  <para style="q2" vid="PSA 69:1">काबरकि पानी ह मोर घेंच तक आ गे हवय।<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>मेंह चीखला म धंसत जावत हंव,</para>
  <para style="q2" vid="PSA 69:2">जिहां मोर गोड़ टेकाय के जगह नइं ए।</para>
  <para style="q1" vid="PSA 69:2">मेंह गहिरा पानी म आ गे हवंव;</para>
  <para style="q2" vid="PSA 69:2">पानी के बाढ़ म मेंह बुड़त हंव।<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>मेंह मदद बर गोहारत थक गे हंव;</para>
  <para style="q2" vid="PSA 69:3">मोर गला ह सूख गे हवय।</para>
  <para style="q1" vid="PSA 69:3">मोर परमेसर के बाट जोहत,</para>
  <para style="q2" vid="PSA 69:3">मोर आंखीमन कमजोर हो गे हवंय।<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>जऊन मन बिगर कारन के मोर ले घिन करथें,</para>
  <para style="q2" vid="PSA 69:4">ओमन के गनती मोर मुड़ के बाल ले घलो जादा हवय;</para>
  <para style="q1" vid="PSA 69:4">बहुंते जन बिगर कारन के मोर बईरी अंय,</para>
  <para style="q2" vid="PSA 69:4">जऊन मन कि मोला नास करे के फिराक म हवंय।</para>
  <para style="q1" vid="PSA 69:4">जऊन चीज के चोरी मेंह नइं करे हंव,</para>
  <para style="q2" vid="PSA 69:4">ओकर भरपई मोर ले करे जावत हे।<verse eid="PSA 69:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>हे परमेसर, तेंह मोर मुरूखता ला जानत हस;</para>
  <para style="q2" vid="PSA 69:5">मोर अपराध ह तोर ले छिपे नइं हे।<verse eid="PSA 69:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>हे परभू, सर्वसक्तिमान यहोवा,</para>
  <para style="q2" vid="PSA 69:6">जऊन मन तोर ऊपर आसा रखे हवंय</para>
  <para style="q2" vid="PSA 69:6">ओमन ला मोर कारन कलंकित झन होना पड़य;</para>
  <para style="q1" vid="PSA 69:6">हे इसरायल के परमेसर,</para>
  <para style="q2" vid="PSA 69:6">जऊन मन तोर खोज म रहिथें,</para>
  <para style="q2" vid="PSA 69:6">ओमन ला मोर कारन लज्जित झन होना पड़य।<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>काबरकि तोर हित म मेंह अपमान सहत हंव,</para>
  <para style="q2" vid="PSA 69:7">अऊ मोर मुहूं ह सरम के मारे ढंक गे हवय।<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>मेंह अपन खुद के परिवार बर परदेसी हो गे हवंव,</para>
  <para style="q2" vid="PSA 69:8">अपन खुद के भाई-बहिनी बर अजनबी हो गे हवंव;<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>काबरकि तोर घर के धुन ह मोला खावत हे,</para>
  <para style="q2" vid="PSA 69:9">अऊ जऊन मन तोर बेजत्ती करथें, ओमन के बेजत्ती ह मोर ऊपर आवत हे।<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>जब मेंह रोथंव अऊ उपास करथंव,</para>
  <para style="q2" vid="PSA 69:10">त जरूरी ए कि मेंह अपमान सहंव;<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>जब मेंह बोरा के कपड़ा<note caller="+" style="f"><char style="fr" closed="false">69:11 </char><char style="fq" closed="false">बोरा के कपड़ा </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">सोक मनाय के कपड़ा</char></note> पहिरथंव,</para>
  <para style="q2" vid="PSA 69:11">त मनखेमन मोला हंसी के पात्र बना लेथें।<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>जऊन मन सहर के कपाट म बईठथें, ओमन मोर हंसी उड़ाथें,</para>
  <para style="q2" vid="PSA 69:12">अऊ मेंह मतवारमन के गीत बन गे हवंव।<verse eid="PSA 69:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>हे यहोवा, तोर अनुग्रह के बेरा म,</para>
  <para style="q2" vid="PSA 69:13">मेंह तोर ले पराथना करत हंव;</para>
  <para style="q1" vid="PSA 69:13">हे परमेसर, अपन बड़े मया के कारन,</para>
  <para style="q2" vid="PSA 69:13">अपन निस्चित उद्धार के संग मोला जबाब दे।<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>मोला दलदली चीखला ले बचा ले,</para>
  <para style="q2" vid="PSA 69:14">मोला ओमा झन बुड़न दे;</para>
  <para style="q1" vid="PSA 69:14">जऊन मन मोर ले घिन करथें, ओमन ले मोला छोंड़ा,</para>
  <para style="q2" vid="PSA 69:14">मोला गहिरा पानी ले बचा।<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>बाढ़ के पानी म मोला झन बुड़न दे</para>
  <para style="q2" vid="PSA 69:15">या पानी के गहरई म मेंह झन चले जावंव</para>
  <para style="q2" vid="PSA 69:15">या खंचवा म मेंह झन समा जावंव।<verse eid="PSA 69:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>हे यहोवा, अपन मया के भलई के कारन मोला जबाब दे;</para>
  <para style="q2" vid="PSA 69:16">अपन बड़े दया के कारन मोर कोति देख।<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>अपन सेवक ले मुहूं झन मोड़;</para>
  <para style="q2" vid="PSA 69:17">मोला जल्दी करके जबाब दे, काबरकि मेंह संकट म हवंव।<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>मोर लकठा म आके मोला बचा ले;</para>
  <para style="q2" vid="PSA 69:18">मोर बईरीमन के कारन मोला छोंड़ा ले।<verse eid="PSA 69:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>तेंह जानत हस कि मोर कइसे अपमान करे जाथे,</para>
  <para style="q2" vid="PSA 69:19">मोला तुछ समझे जाथे अऊ मोला लज्जित करे जाथे;</para>
  <para style="q2" vid="PSA 69:19">मोर जम्मो बईरीमन तोर आघू म हवंय।<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>अपमान ह मोर हिरदय ला टोर दे हवय</para>
  <para style="q2" vid="PSA 69:20">अऊ मेंह बेसहारा छोंड़ देय गे हवंव;</para>
  <para style="q1" vid="PSA 69:20">मोला सहानुभूति के जरूरत हे, पर सहानुभूति देवइया कोनो नइं एं,</para>
  <para style="q2" vid="PSA 69:20">मोला सांति देवइया के जरूरत हे, पर मोला कोनो नइं मिलिस।<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>ओमन मोर जेवन म पित्त मिला दीन</para>
  <para style="q2" vid="PSA 69:21">अऊ मोर पीयास बुझाय बर मोला सिरका पीये बर दीन।<verse eid="PSA 69:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>ओमन के जेवनार ह ओमन के बिनास के कारन बनय;</para>
  <para style="q2" vid="PSA 69:22">ओमन के संगति करई ह ओमन के फंसे के जाल बन जावय।<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>ओमन के आंखी म अंधियार छा जावय, ताकि ओमन झन देख सकंय,</para>
  <para style="q2" vid="PSA 69:23">अऊ ओमन के कनिहां ह हमेसा बर मुड़ जावय।<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>अपन कोप ला ओमन ऊपर ढार दे;</para>
  <para style="q2" vid="PSA 69:24">तोर भयंकर कोरोध ओमन ऊपर पड़य।<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>ओमन के जगह ह खाली हो जावय;</para>
  <para style="q2" vid="PSA 69:25">ओमन के डेरा म रहइया कोनो झन होवंय।<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>काबरकि ओमन ओ मनखेमन ला सताथें, जेमन ला तेंह घायल करथस</para>
  <para style="q2" vid="PSA 69:26">अऊ जेमन ला तेंह चोट पहुंचाथस, ओमन के पीरा के बारे म गोठियाथें।<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>ओमन के ऊपर भारी दोस लगा;</para>
  <para style="q2" vid="PSA 69:27">ओमन ला तोर उद्धार म भागी झन होवन दे।<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>ओमन के नांव जिनगी के किताब ले मिटा दिये जावंय</para>
  <para style="q2" vid="PSA 69:28">अऊ ओमन के नांव धरमीमन के संग झन लिखे जावय।<verse eid="PSA 69:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>पर जहां तक मोर बात ए, मेंह दुखित अऊ पीड़ित हंव—</para>
  <para style="q2" vid="PSA 69:29">हे परमेसर, तोर उद्धार ह मोला बचावय।<verse eid="PSA 69:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>मेंह गीत गाके परमेसर के नांव के परसंसा करहूं</para>
  <para style="q2" vid="PSA 69:30">अऊ धनबाद के संग ओकर महिमा करहूं।<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>ये बात ले यहोवा ह बईला के बलिदान ले जादा,</para>
  <para style="q2" vid="PSA 69:31">या सींग अऊ खुरवाले बईला के बलिदान ले जादा खुस होही।<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>गरीबमन देखहीं अऊ खुस होहीं—</para>
  <para style="q2" vid="PSA 69:32">तुमन, जेमन कि परमेसर के खोज म रहिथव, तुम्हर मन ह तरो-ताजा रहय!<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>यहोवा ह जरूरतमंद के बात ला सुनथे</para>
  <para style="q2" vid="PSA 69:33">अऊ अपन बंधुवा मनखेमन ला तुछ नइं समझे।<verse eid="PSA 69:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>अकास अऊ धरती ओकर परसंसा करंय,</para>
  <para style="q2" vid="PSA 69:34">समुंदर अऊ ओमा के जम्मो चलत-फिरत जीव घलो परसंसा करंय,<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>काबरकि परमेसर ह सियोन ला बचाही</para>
  <para style="q2" vid="PSA 69:35">अऊ यहूदा के सहरमन ला फेर बनाही।</para>
  <para style="q1" vid="PSA 69:35">मनखेमन उहां बस जाहीं अऊ ओला अधिकार म ले लीहीं;<verse eid="PSA 69:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="PSA 69:36"/>ओकर सेवकमन के लइकामन ओला उत्तराधिकार म पाहीं,</para>
  <para style="q2" vid="PSA 69:36">अऊ जऊन मन ओकर नांव ले मया रखथें, ओमन उहां निवास करहीं।<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="cl">भजन-संहिता 70<note caller="+" style="f"><char style="fr" closed="false">70 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 70:1-5">70:1‑5</ref></char> ला 70:2‑6 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। दाऊद के एक बिनती।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>हे परमेसर, जल्दी करके मोला बचा ले;</para>
  <para style="q2" vid="PSA 70:1">हे यहोवा, मोर मदद करे बर जल्दी आ।<verse eid="PSA 70:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>जऊन मन मोर परान लेय चाहथें</para>
  <para style="q2" vid="PSA 70:2">ओमन लज्जित होवंय अऊ घबरावंय;</para>
  <para style="q1" vid="PSA 70:2">ओ जम्मो, जऊन मन मोर बिनास के ईछा रखथें</para>
  <para style="q2" vid="PSA 70:2">ओमन कलंकित होके पाछू हटंय।<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>जऊन मन मोला ये कहिथें, “अहा! अहा!”</para>
  <para style="q2" vid="PSA 70:3">ओमन लज्जा के मारे वापिस जावंय।<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>पर ओ जम्मो, जऊन मन तोर खोज म रहिथें</para>
  <para style="q2" vid="PSA 70:4">ओमन तोर कारन आनंद मनावंय अऊ खुस होवंय;</para>
  <para style="q1" vid="PSA 70:4">जऊन मन तोर उद्धार के मदद चाहथें, ओमन हमेसा कहंय,</para>
  <para style="q2" vid="PSA 70:4">“यहोवा महान ए!”<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>पर जहां तक मोर बात ए, मेंह गरीब अऊ जरूरतमंद अंव;</para>
  <para style="q2" vid="PSA 70:5">हे परमेसर, मोर करा जल्दी आ।</para>
  <para style="q1" vid="PSA 70:5">तेंह मोर मददगार अऊ मोर छुड़ानेवाला अस;</para>
  <para style="q2" vid="PSA 70:5">हे यहोवा, देरी झन कर।<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="cl">भजन-संहिता 71</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>हे यहोवा, मेंह तोर सरन म हंव;</para>
  <para style="q2" vid="PSA 71:1">मोला कभू लज्जित झन होवन दे।<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>अपन धरमीपन म मोला बचा अऊ छोंड़ा;</para>
  <para style="q2" vid="PSA 71:2">मोर कोति अपन कान लगा अऊ मोर उद्धार कर।<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>मोर सरन के चट्टान बन,</para>
  <para style="q2" vid="PSA 71:3">जिहां में हमेसा जा सकंव;</para>
  <para style="q1" vid="PSA 71:3">मोर उद्धार के हुकूम दे,</para>
  <para style="q2" vid="PSA 71:3">काबरकि तेंह मोर चट्टान अऊ मोर गढ़ अस।<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>हे मोर परमेसर, दुस्टमन के हांथ ले मोला छोंड़ा ले,</para>
  <para style="q2" vid="PSA 71:4">अऊ ओमन के पकड़ ले मोला छुटकारा दे, जऊन मन दुस्ट अऊ निरदयी अंय।<verse eid="PSA 71:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>काबरकि हे परमपरधान यहोवा, तेंह मोर आसा अस,</para>
  <para style="q2" vid="PSA 71:5">मोर लइकापन ले ही मेंह तोर ऊपर भरोसा रखे हंव।<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>जनम ले ही मेंह तोर ऊपर भरोसा रखे हंव;</para>
  <para style="q2" vid="PSA 71:6">तेंह मोला मोर दाई के गरभ ले बाहिर लानय।</para>
  <para style="q2" vid="PSA 71:6">मेंह हमेसा तोर परसंसा करहूं।<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>मेंह बहुंते जन बर एक उदाहरन बन गे हंव;</para>
  <para style="q2" vid="PSA 71:7">तेंह मोर मजबूत सरन-स्थान अस।<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>मोर मुहूं ह तोर परसंसा करत नइं थकय,</para>
  <para style="q2" vid="PSA 71:8">दिन भर तोर वैभव के गुनगान करत रहिथे।<verse eid="PSA 71:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>जब मेंह डोकरा हो जाहूं, त मोला झन छोंड़बे;</para>
  <para style="q2" vid="PSA 71:9">जब मेंह निरबल हो जाहूं, त मोला झन तियागबे।<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>काबरकि मोर बईरीमन मोर बिरूध गोठियाथें;</para>
  <para style="q2" vid="PSA 71:10">जऊन मन मोला मार डारे चाहथें, ओमन एक संग सडयंत्र रचत हें।<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>ओमन कहिथें, “परमेसर ह ओला तियाग दे हवय;</para>
  <para style="q2" vid="PSA 71:11">ओकर पीछा करव अऊ ओला पकड़ लव,</para>
  <para style="q2" vid="PSA 71:11">काबरकि ओला कोनो नइं बचाही।”<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>हे मोर परमेसर, मोर ले दूरिहा झन रह;</para>
  <para style="q2" vid="PSA 71:12">हे परमेसर, मोर मदद करे बर जल्दी आ।<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>मोर ऊपर दोस लगइयामन सरम के मारे नास हो जावंय;</para>
  <para style="q2" vid="PSA 71:13">जऊन मन मोर हानि करे चाहथें,</para>
  <para style="q2" vid="PSA 71:13">ओमन अपमान अऊ कलंक ले भर जावंय।<verse eid="PSA 71:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>जहां तक मोर बात ए, मेंह हमेसा आसा रखहूं;</para>
  <para style="q2" vid="PSA 71:14">मेंह तोर परसंसा जादा अऊ जादा करहूं।<verse eid="PSA 71:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>मेंह अपन मुहूं ले तोर धरमी काम,</para>
  <para style="q2" vid="PSA 71:15">अऊ तोर उद्धार के काम के बखान दिन भर करत रहिहूं—</para>
  <para style="q2" vid="PSA 71:15">हालाकि मेंह नइं जानंव कि ये जम्मो म कइसे संबंध जोड़े जावय।<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>हे परमपरधान यहोवा, मेंह आके तोर बड़े काममन के घोसना करहूं;</para>
  <para style="q2" vid="PSA 71:16">मेंह तोर धरमी काम, सिरिप तोरेच धरमी काम के घोसना करहूं।<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>हे परमेसर, तेंह मोला मोर लइकापन ले सिखोवत आय हस,</para>
  <para style="q2" vid="PSA 71:17">अऊ आज तक मेंह तोर अद्भूत काम के घोसना करत हंव।<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>जब मेंह डोकरा हो जावंव अऊ मोर बालमन पक जावंय,</para>
  <para style="q2" vid="PSA 71:18">तब भी, हे मोर परमेसर, मोला झन छोंड़बे,</para>
  <para style="q1" vid="PSA 71:18">जब तक कि तोर सामर्थ के घोसना अवइया पीढ़ी</para>
  <para style="q2" vid="PSA 71:18">अऊ तोर बड़े काम के घोसना ओ जम्मो झन ला नइं कर दंव, जऊन मन अवइया हें।<verse eid="PSA 71:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>हे परमेसर, तोर धरमीपन ह अकास तक हबरत हे,</para>
  <para style="q2" vid="PSA 71:19">तें, जऊन ह कि बड़े-बड़े काम करे हस।</para>
  <para style="q2" vid="PSA 71:19">हे परमेसर, तोर सहीं कोन हे?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>हालाकि तेंह मोला बहुंत संकट</para>
  <para style="q2" vid="PSA 71:20">अऊ करू चीजमन ला देखाय हस,</para>
  <para style="q2" vid="PSA 71:20">पर तेंह मोर जिनगी ला फेर पहिले सहीं कर देबे;</para>
  <para style="q1" vid="PSA 71:20">धरती के गहरई ले</para>
  <para style="q2" vid="PSA 71:20">तेंह मोला फेर ऊपर ले आबे।<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>तेंह मोर आदरमान ला बढ़ाबे</para>
  <para style="q2" vid="PSA 71:21">अऊ एक बार फेर मोला अराम देबे।<verse eid="PSA 71:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>हे मोर परमेसर, मेंह तोर बिसवासयोग्यता बर</para>
  <para style="q2" vid="PSA 71:22">बीना बजाके तोर परसंसा के गीत गाहूं;</para>
  <para style="q1" vid="PSA 71:22">हे इसरायल के पबितर परमेसर,</para>
  <para style="q2" vid="PSA 71:22">मेंह बीना बजाके तोर परसंसा के गीत गाहूं।<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>मोर मुहूं ह आनंद के मारे चिचियाही</para>
  <para style="q2" vid="PSA 71:23">जब मेंह तोर परसंसा के गीत गाहूं—</para>
  <para style="q2" vid="PSA 71:23">में, जऊन ला कि तेंह छोंड़ाय हस।<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>मेंह दिन भर</para>
  <para style="q2" vid="PSA 71:24">तोर धरमी काम के बखान करहूं,</para>
  <para style="q1" vid="PSA 71:24">काबरकि जऊन मन मोर हानि करे चाहत रिहिन</para>
  <para style="q2" vid="PSA 71:24">ओमन लज्जा अऊ घबराहट म पड़े हवंय।<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="cl">भजन-संहिता 72</para>
  <para style="d">सुलेमान के गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>हे परमेसर, राजा ला नियाय के बात बता,</para>
  <para style="q2" vid="PSA 72:1">राजा के बेटा ला अपन धरमीपन दे।<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>ओह तोर मनखेमन के नियाय धरमीपन ले</para>
  <para style="q2" vid="PSA 72:2">अऊ दुख म परे तोर मनखेमन के नियाय सही-सही करे।<verse eid="PSA 72:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>पहाड़मन ले मनखेमन के उन्नति होवय,</para>
  <para style="q2" vid="PSA 72:3">अऊ पहाड़ीमन ले धरमीपन के फर मिलय।<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>मनखेमन के बीच दुखियारीमन के ओह बचाव करे</para>
  <para style="q2" vid="PSA 72:4">अऊ जरूरतमंद मनखेमन के लइकामन ला बचावय;</para>
  <para style="q2" vid="PSA 72:4">सतानेवालामन ला ओह कुचर दे।<verse eid="PSA 72:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>जब तक सूरज अऊ चंदा हवंय,</para>
  <para style="q2" vid="PSA 72:5">पीढ़ी-पीढ़ी तक ओह बने रहय<note caller="+" style="f"><char style="fr" closed="false">72:5 </char><char style="ft" closed="false">सेप्टाजिन्ट; इबरानी म </char><char style="fqa" closed="false">तोर भय माने जावय</char></note>।<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>ओह कांदी कटे भुइयां म बारिस के होवई,</para>
  <para style="q2" vid="PSA 72:6">अऊ धरती म पानी के फुहार पड़े सहीं होवय।<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>ओकर समय म धरमीमन उन्नति करंय</para>
  <para style="q2" vid="PSA 72:7">अऊ चंदा के रहत तक बहुंतायत ले उन्नति होवय।<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>ओह समुंदर ले समुंदर तक</para>
  <para style="q2" vid="PSA 72:8">अऊ फरात नदी ले लेके धरती के छोर तक राज करे।<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>मरू-भुइयां के जन-जाति के मनखेमन ओकर आघू म माड़ी टेकंय</para>
  <para style="q2" vid="PSA 72:9">अऊ ओकर बईरीमन धुर्रा चाटंय।<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>तरसीस अऊ दूरिहा समुंदर तीर के राजामन</para>
  <para style="q2" vid="PSA 72:10">ओकर बर भेंट लेके आवंय।</para>
  <para style="q1" vid="PSA 72:10">सेबा अऊ सबा के राजामन</para>
  <para style="q2" vid="PSA 72:10">ओला उपहार देवंय।<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>जम्मो राजामन ओला दंडवत करंय</para>
  <para style="q2" vid="PSA 72:11">अऊ जम्मो जाति के मनखेमन ओकर सेवा करंय।<verse eid="PSA 72:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>काबरकि ओ जरूरतमंद, जऊन मन ओला पुकारथें,</para>
  <para style="q2" vid="PSA 72:12">अऊ ओ पीरा म परे मनखे, जऊन मन के मदद करइया कोनो नइं एं, ओमन ला ओह छोंड़ाही।<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>ओह दुरबल अऊ जरूरतमंद ऊपर दया करही</para>
  <para style="q2" vid="PSA 72:13">अऊ जरूरतमंद ला मिरतू ले बचाही।<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>ओह ओमन ला अतियाचार अऊ हिंसा ले बचाही,</para>
  <para style="q2" vid="PSA 72:14">काबरकि ओकर नजर म ओमन के खून<note caller="+" style="f"><char style="fr" closed="false">72:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">जिनगी</char></note> ह कीमती अय।<verse eid="PSA 72:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>ओकर लम्बा उमर होवय!</para>
  <para style="q2" vid="PSA 72:15">सेबा के सोन ओला दिये जावय।</para>
  <para style="q1" vid="PSA 72:15">मनखेमन ओकर बर हमेसा पराथना करंय</para>
  <para style="q2" vid="PSA 72:15">अऊ दिन भर ओला आसीस देवत रहंय।<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>पूरा देस म बहुंतायत से अनाज उपजे;</para>
  <para style="q2" vid="PSA 72:16">पहाड़ीमन के चोटी म येह लहलहावय।</para>
  <para style="q1" vid="PSA 72:16">लबानोन के सहीं फसल म उन्नति होवय</para>
  <para style="q2" vid="PSA 72:16">अऊ भुइयां के कांदी सहीं बढ़य।<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>ओकर नांव ह सदाकाल तक बने रहय;</para>
  <para style="q2" vid="PSA 72:17">जब तक सूरज हवय, तब तक येह बने रहय।</para>
  <para style="b" vid="PSA 72:17"/>
  <para style="q1" vid="PSA 72:17">तब जम्मो जाति के मनखेमन ओकर जरिये आसीस पाहीं,<note caller="+" style="f"><char style="fr" closed="false">72:17 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">आसीस पाय म ओकर नांव लीहीं </char><char style="ft" closed="false">(देखव <char style="xt"><ref loc="GEN 48:20">उत 48:20</ref></char>)</char></note></para>
  <para style="q2" vid="PSA 72:17">अऊ ओमन ओला धइन कहिहीं।<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>यहोवा परमेसर, इसरायल के परमेसर के परसंसा होवय,</para>
  <para style="q2" vid="PSA 72:18">सिरिप ओहीच ह अद्भूत काम करथे।<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>ओकर महिमामय नांव के सदाकाल तक परसंसा होवय;</para>
  <para style="q2" vid="PSA 72:19">जम्मो धरती ह ओकर महिमा ले भर जावय।</para>
  <para style="qc" vid="PSA 72:19">आमीन अऊ आमीन।<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>यिसै के बेटा दाऊद के पराथना इहां खतम होथे।<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">किताब III</para>
  <para style="mr">
    <ref loc="PSA 73-89">भजन-संहिता 73–89</ref></para>
  <para style="cl">भजन-संहिता 73</para>
  <para style="d">आसाप के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>सही म परमेसर ह इसरायल बर,</para>
  <para style="q2" vid="PSA 73:1">याने कि ओमन बर बने अय, जेमन के मन साफ हवय।<verse eid="PSA 73:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>पर जहां तक मोर बात ए, मोर गोड़ ह लगभग फिसल गे रिहिस;</para>
  <para style="q2" vid="PSA 73:2">मेंह गिरनेचवाला रहेंव।<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>मेंह घमंडी मनखे ले डाह करेंव</para>
  <para style="q2" vid="PSA 73:3">जब मेंह दुस्टमन के उन्नति ला देखेंव।<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>ओमन करा कोनो समस्या नइं ए;</para>
  <para style="q2" vid="PSA 73:4">ओमन के सरीर ह स्वस्थ अऊ मजबूत हे।<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>ओमन के ऊपर समान्य मनखे सहीं बोझ नइं ए;</para>
  <para style="q2" vid="PSA 73:5">ओमन ला मनखेमन के बेमारी नइं होवय।<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>एकर कारन घमंड ह ओमन के गला के हार ए;</para>
  <para style="q2" vid="PSA 73:6">हिंसा ह ओमन के कपड़ा सहीं अय।<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>ओमन के कठोर हिरदय ले दुस्ट काम निकलथे<note caller="+" style="f"><char style="fr" closed="false">73:7 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">ओमन के आंखी ह चरबी ले फूले रहिथे</char></note>;</para>
  <para style="q2" vid="PSA 73:7">ओमन के दुस्ट कल्पना के कोनो सीमना नइं ए।<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>ओमन ठट्ठा करथें, अऊ बुरई करे के बात करथें;</para>
  <para style="q2" vid="PSA 73:8">घमंड करके ओमन अतियाचार करे के धमकी देथें।<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>ओमन बड़े डींग मारथें,</para>
  <para style="q2" vid="PSA 73:9">अऊ ओमन धरती ला अधिकार म लेय के बात करथें।<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>एकरसेति ओमन के मनखेमन ओमन करा लहुंट आथें</para>
  <para style="q2" vid="PSA 73:10">अऊ बहुंत पानी पीथें।<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>ओमन कहिथें, “परमेसर ह कइसे जानही?</para>
  <para style="q2" vid="PSA 73:11">का सर्वोच्च परमेसर ह कुछू जानथे?”<verse eid="PSA 73:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>दुस्ट मनखेमन अइसने अंय—</para>
  <para style="q2" vid="PSA 73:12">ओमन हमेसा बेपरवाह रहिथें, ओमन धन इकट्ठा करे म लगे रहिथें।<verse eid="PSA 73:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>ये बात सही ए कि मेंह बेकार म अपन हिरदय ला सुध</para>
  <para style="q2" vid="PSA 73:13">अऊ अपन हांथमन ला निरदोस बनाय रखेंव।<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>दिन भर मेंह दुख सहत रहेंव,</para>
  <para style="q2" vid="PSA 73:14">अऊ हर दिन मोला नवां दंड मिलथे।<verse eid="PSA 73:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>कहूं मेंह वइसने कहे होतेंव,</para>
  <para style="q2" vid="PSA 73:15">त मेंह तोर लइकामन ला धोखा दे होतेंव।<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>जब मेंह ये जम्मो बात ला समझे के कोसिस करेंव,</para>
  <para style="q2" vid="PSA 73:16">त येह मोला बहुंत परेसान करिस<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>जब तक कि मेंह परमेसर के पबितर-स्थान म नइं चले गेंव;</para>
  <para style="q2" vid="PSA 73:17">तब मेंह ओमन के आखिरी परिनाम ला समझेंव।<verse eid="PSA 73:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>खचित तेंह ओमन ला फिसलनेवाला जगह म रखथस;</para>
  <para style="q2" vid="PSA 73:18">तेंह ओमन ला गिराके नास कर देथस।<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>कइसे अचानक ओमन नास हो जाथें,</para>
  <para style="q2" vid="PSA 73:19">आतंक ले पूरा खतम हो जाथें!<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>ओमन जागत मनखे के एक सपना देखे सहीं अंय;</para>
  <para style="q2" vid="PSA 73:20">हे परभू, जब तेंह उठबे,</para>
  <para style="q2" vid="PSA 73:20">त कल्पना के बात सहीं तेंह ओमन ला तुछ समझबे।<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>जब मोर हिरदय ह दुखित रिहिस</para>
  <para style="q2" vid="PSA 73:21">अऊ मोर आतमा ह करू हो गे रिहिस,<verse eid="PSA 73:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22"/>त मेंह निरबुद्धि अऊ अगियानी रहेंव;</para>
  <para style="q2" vid="PSA 73:22">मेंह तोर आघू म एक जंगली पसु रहेंव।<verse eid="PSA 73:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>तभो ले मेंह हमेसा तोर संग हंव;</para>
  <para style="q2" vid="PSA 73:23">तेंह मोर जेवनी हांथ ला धरके मोला थामे रहिथस।<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>तेंह अपन सलाह देके मोर अगुवई करथस,</para>
  <para style="q2" vid="PSA 73:24">अऊ ओकर बाद तेंह मोला महिमा म अपन करा ले लेबे।<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>स्वरग म तोर छोंड़ मोर अऊ कोन हवय?</para>
  <para style="q2" vid="PSA 73:25">अऊ धरती म तोर अलावा मेंह अऊ काकरो ईछा नइं करंव।<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>मोर मांस अऊ मोर हिरदय असफल हो सकथें,</para>
  <para style="q2" vid="PSA 73:26">पर परमेसर ह हमेसा बर</para>
  <para style="q2" vid="PSA 73:26">मोर हिरदय के बल अऊ मोर भाग ए।<verse eid="PSA 73:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>जऊन मन तोर ले दूरिहा हवंय, ओमन नास हो जाहीं;</para>
  <para style="q2" vid="PSA 73:27">तेंह ओ जम्मो झन ला नास कर देथस, जऊन मन तोर बर ईमानदार नइं एं।<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>पर जहां तक मोर बात ए, परमेसर के लकठा म रहई बने बात ए।</para>
  <para style="q2" vid="PSA 73:28">मेंह परमपरधान यहोवा ला अपन सरन-स्थान बनाय हंव;</para>
  <para style="q2" vid="PSA 73:28">मेंह तोर जम्मो काम के बखान करहूं।<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="cl">भजन-संहिता 74</para>
  <para style="d">आसाप के एक <char style="tl">मसकील</char><note caller="+" style="f"><char style="fr" closed="false">74:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>हे परमेसर, तेंह काबर हमन ला हमेसा बर छोंड़ दे हस?</para>
  <para style="q2" vid="PSA 74:1">तोर गुस्सा ह तोर चरागन के भेड़मन के बिरूध काबर सुलगत हे?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>ओ जाति के मनखेमन ला सुरता कर, जेमन ला तेंह बहुंत पहिले बिसाय रहय,</para>
  <para style="q2" vid="PSA 74:2">तोर निज भाग के ओ मनखेमन, जेमन ला तेंह छोंड़ाय रहय—</para>
  <para style="q2" vid="PSA 74:2">सियोन पहाड़, जिहां तेंह निवास करय, ओ जम्मो ला सुरता कर।<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>अपन कदम ला ये अनंतकाल के बिनास के तरफ कर,</para>
  <para style="q2" vid="PSA 74:3">ये जम्मो बिनास, जेला बईरी ह पबितर-स्थान ऊपर लाने हवय।<verse eid="PSA 74:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>तोर बिरोधीमन ओ जगह म गरजत हें, जिहां तेंह हमर ले मुलाकात करे रहय;</para>
  <para style="q2" vid="PSA 74:4">ओमन चिनहां के रूप म अपन झंडा गाड़े हवंय।<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>ओमन अइसने बरताव करिन, जइसने मनखेमन घोर जंगल म</para>
  <para style="q2" vid="PSA 74:5">कुसलता से रूखमन ला टंगिया ले काटथें।<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>ओमन अपन टांगा अऊ टंगिया ले</para>
  <para style="q2" vid="PSA 74:6">नक्कासी करे गे लकड़ी ला चूर-चूर कर दीन।<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>ओमन तोर पबितर-स्थान ला जलाके धुर्रा म मिला दीन;</para>
  <para style="q2" vid="PSA 74:7">जिहां तोर अराधना होथे, ओ जगह ला ओमन असुध कर दीन।<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>ओमन अपन मन म कहिन, “हमन ओमन ला पूरा कुचर देबो!”</para>
  <para style="q2" vid="PSA 74:8">ओमन ओ हर एक जगह ला जला दीन, जिहां देस म परमेसर के अराधना होवत रिहिस।<verse eid="PSA 74:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>हमन ला परमेसर ले कोनो चिनहां नइं दिये जावत हे;</para>
  <para style="q2" vid="PSA 74:9">कोनो अगमजानी नइं बचे हें,</para>
  <para style="q2" vid="PSA 74:9">अऊ हमर म ले कोनो नइं जानय कि अइसने कब तक रहिही।<verse eid="PSA 74:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>हे परमेसर, कब तक बईरी ह तोर ठट्ठा करत रहिही?</para>
  <para style="q2" vid="PSA 74:10">का बईरी ह हमेसा तोर नांव के निन्दा करत रहिही?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>काबर तेंह अपन हांथ ला रोके रहिथस, अपन जेवनी हांथ ला?</para>
  <para style="q2" vid="PSA 74:11">ओला अपन कपड़ा ले बाहिर निकालके बईरीमन के नास कर दे!<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>पर परमेसर ह बहुंत पहिले से मोर राजा ए;</para>
  <para style="q2" vid="PSA 74:12">ओह धरती ऊपर उद्धार के काम करथे।<verse eid="PSA 74:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>येह तें रहय, जऊन ह अपन सक्ति ले समुंदर ला दू भाग कर देय;</para>
  <para style="q2" vid="PSA 74:13">तेंह पानी म बिकराल जन्तु के मुड़ ला फोर डारय।<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>येह तें रहय, जऊन ह लिबयातान<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="fq" closed="false">लिबयातान </char><char style="ft" closed="false">समुंदर के एक </char><char style="fqa" closed="false">बड़े जीव</char></note> के मुड़ ला कुचरके</para>
  <para style="q2" vid="PSA 74:14">ओला जंगली पसुमन ला खाय बर देय दे।<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>येह तें रहय, जऊन ह सोता अऊ झरनामन ला खोलके पानी के धारा बहाय;</para>
  <para style="q2" vid="PSA 74:15">तेंह नदी म हमेसा बहत पानी ला सूखा दे।<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>दिन ह तोर ए, अऊ रथिया ह घलो तोर ए;</para>
  <para style="q2" vid="PSA 74:16">तेंह सूरज अऊ चंदा ला स्थापित करय।<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>येह तें रहय, जऊन ह धरती के जम्मो सीमना ला बांधय;</para>
  <para style="q2" vid="PSA 74:17">धूपकाल अऊ जड़काला ला तेंह ठहिराय।<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>हे यहोवा, सुरता कर कि बईरी ह कइसे तोर ठट्ठा करे हवय,</para>
  <para style="q2" vid="PSA 74:18">मुरूख मनखेमन कइसे तोर नांव के निन्दा करे हवंय।<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>अपन पंड़की के जिनगी ला जंगली पसुमन के हांथ म झन सऊंप दे;</para>
  <para style="q2" vid="PSA 74:19">दुख म पड़े तोर मनखेमन के जिनगी ला हमेसा बर झन भुला दे।<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>अपन करे गय करार के लाज ला रख,</para>
  <para style="q2" vid="PSA 74:20">काबरकि देस के अंधियार जगहमन म बहुंत हिंसा होवत हे।<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>अतियाचार सहनेवाला मनखे ला लज्जा म झन पड़न दे;</para>
  <para style="q2" vid="PSA 74:21">गरीब अऊ जरूरतमंद मनखेमन तोर नांव के परसंसा करंय।<verse eid="PSA 74:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>हे परमेसर, उठ अऊ अपन मामला के बचाव कर;</para>
  <para style="q2" vid="PSA 74:22">सुरता कर कि मुरूखमन दिन भर कइसे तोर ठट्ठा करथें।<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>अपन बिरोधीमन के चिचियाई ला अनदेखा झन कर,</para>
  <para style="q2" vid="PSA 74:23">तोर बईरीमन के कोलाहल, जऊन ह लगातार बढ़त जावत हे।<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="cl">भजन-संहिता 75<note caller="+" style="f"><char style="fr" closed="false">75 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 75:1-10">75:1‑10</ref></char> ला 75:2‑11 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। “नास झन कर” के धुन म आसाप के एक भजन। एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>हे परमेसर, हमन तोर परसंसा करथन,</para>
  <para style="q2" vid="PSA 75:1">हमन तोर परसंसा करथन, काबरकि तोर नांव ह लकठा म हवय;</para>
  <para style="q2" vid="PSA 75:1">मनखेमन तोर अद्भूत काम के बखान करथें।<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>तेंह कहिथस, “ठहिराय गय समय ला मेंह तय करथंव;</para>
  <para style="q2" vid="PSA 75:2">बिगर पखियपात के मेंहीच ह नियाय करथंव।<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>जब धरती अऊ येकर जम्मो मनखेमन कांपथें,</para>
  <para style="q2" vid="PSA 75:3">त मेंहीच येकर खंभामन ला मजबूती से थामे रहिथंव।<verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>घमंडी ला मेंह कहिथंव, ‘अऊ घमंड झन कर,’</para>
  <para style="q2" vid="PSA 75:4">अऊ दुस्टमन ला कहिथंव, ‘अपन सींग<note caller="+" style="f"><char style="fr" closed="false">75:4 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">इहां सक्ति के प्रतीक ए; <char style="xt" link-href="PSA 75:5"><ref loc="PSA 75:5">पद 5</ref></char> अऊ <char style="xt" link-href="PSA 75:10"><ref loc="PSA 75:10">10</ref></char>म घलो</char></note> ला ऊंच झन करव।<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>स्वरग के बिरूध अपन सींग झन उठावव;</para>
  <para style="q2" vid="PSA 75:5">बहुंत ढिठई के बात झन करव।’ ”<verse eid="PSA 75:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>पूरब या पछिम ले या निरजन प्रदेस ले</para>
  <para style="q2" vid="PSA 75:6">कोनो भी मनखे अपनआप ला ऊपर नइं उठा सकय।<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>येह परमेसर ए, जऊन ह नियाय करथे:</para>
  <para style="q2" vid="PSA 75:7">ओह एक झन ला खाल्हे गिरा देथे, त दूसर झन ला ऊपर उठाथे।<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>यहोवा के हांथ म एक कटोरा हवय</para>
  <para style="q2" vid="PSA 75:8">जऊन ह मसाला मिले झागवाला अंगूर के मंद ले भरे हवय;</para>
  <para style="q1" vid="PSA 75:8">ओह येला ढारथे, अऊ धरती के जम्मो दुस्टमन</para>
  <para style="q2" vid="PSA 75:8">कटोरा के खाली होवत तक येला पीथें।<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>जहां तक मोर बात ए, मेंह हमेसा येकर घोसना करहूं;</para>
  <para style="q2" vid="PSA 75:9">मेंह याकूब के परमेसर के परसंसा के गीत गाहूं,<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>जऊन ह कहिथे, “मेंह जम्मो दुस्टमन के सींग ला काट डारहूं,</para>
  <para style="q2" vid="PSA 75:10">पर धरमीमन के सींग ला ऊपर करे जाही।”<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="cl">भजन-संहिता 76<note caller="+" style="f"><char style="fr" closed="false">76 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 76:1-12">76:1‑12</ref></char> ला 76:2‑13 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। तारवाले बाजामन के संग आसाप के एक भजन। एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>यहूदा म परमेसर ह प्रसिद्ध हे;</para>
  <para style="q2" vid="PSA 76:1">इसरायल म ओकर नांव ह महान ए।<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>सालेम<note caller="+" style="f"><char style="fr" closed="false">76:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरूसलेम</char></note> म ओकर डेरा हवय,</para>
  <para style="q2" vid="PSA 76:2">अऊ सियोन म ओकर निवास स्थान।<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>उहां ओह चमचमात तीर, ढाल अऊ तलवार,</para>
  <para style="q2" vid="PSA 76:3">याने कि लड़ई के हथियारमन ला टोर दीस।<note caller="+" style="f"><char style="fr" closed="false">76:3 </char><char style="ft" closed="false">इहां अऊ <char style="xt" link-href="PSA 76:9"><ref loc="PSA 76:9">पद 9</ref></char> के आखिरी म इबरानी म सेला हवय, जेकर सही मतलब मालूम नइं ए</char></note><verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>तेंह अंजोर ले चमकत हस,</para>
  <para style="q2" vid="PSA 76:4">सिकार ले भरे पहाड़मन ले जादा सानदार अस।<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>हिम्मती मनखेमन लूट लिये गीन,</para>
  <para style="q2" vid="PSA 76:5">ओमन अपन मिरतू के नींद म हवंय;</para>
  <para style="q1" vid="PSA 76:5">योद्धामन ले एको झन घलो</para>
  <para style="q2" vid="PSA 76:5">अपन हांथ नइं चला सकंय।<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>हे याकूब के परमेसर, तोर डांट के कारन,</para>
  <para style="q2" vid="PSA 76:6">घोड़ा अऊ रथ दूनों खड़े हवंय।<verse eid="PSA 76:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>येह सिरिप तेंहीच अस, जेकर भय माने जावय।</para>
  <para style="q2" vid="PSA 76:7">जब तेंह गुस्सा करथस, त तोर आघू म कोन ह ठाढ़ हो सकथे?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>स्वरग ले तेंह नियाय के घोसना करय,</para>
  <para style="q2" vid="PSA 76:8">अऊ देस के मनखेमन डरके चुप हो गीन—<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>हे परमेसर, जब तेंह देस के दुख म परे जम्मो मनखेमन के</para>
  <para style="q2" vid="PSA 76:9">नियाय करे बर अऊ ओमन ला बचाय बर उठय।<verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>खचित मानव-जाति के बिरूध तोर कोप ह तोर परसंसा के कारन बनथे,</para>
  <para style="q2" vid="PSA 76:10">अऊ तोर कोप ले बचे मनखेमन काबू म रहिथें।<verse eid="PSA 76:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>यहोवा अपन परमेसर बर मन्नत मानव अऊ ओला पूरा करव;</para>
  <para style="q2" vid="PSA 76:11">आसपास के जम्मो देस के मनखेमन परमेसर करा भेंट लेके आवंय</para>
  <para style="q2" vid="PSA 76:11">जऊन ह भय माने के योग्य अय।<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>ओह सासन करइयामन के उत्साह ला टोर देथे;</para>
  <para style="q2" vid="PSA 76:12">धरती के राजामन ओकर भय मानथें।<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="cl">भजन-संहिता 77<note caller="+" style="f"><char style="fr" closed="false">77 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 77:1-20">77:1‑20</ref></char> ला 77:2‑21 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। यदूतून के राग म आसाप के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>मेंह मदद बर परमेसर ला पुकारेंव;</para>
  <para style="q2" vid="PSA 77:1">मोर बात ला सुने बर मेंह परमेसर ले गोहार पारेंव।<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>जब मेंह तकलीफ म रहेंव, त मेंह परभू ला खोजेंव;</para>
  <para style="q2" vid="PSA 77:2">रथिया बिगर थके हांथ ला बढ़ांय,</para>
  <para style="q2" vid="PSA 77:2">अऊ मोला सांति नइं मिलिस।<verse eid="PSA 77:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>हे परमेसर, मेंह तोला सुरता करेंव अऊ कलहरेंव;</para>
  <para style="q2" vid="PSA 77:3">मेंह चिंतन-मनन करेंव, अऊ मोर आतमा ह दुरबल हो गीस।<verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>तेंह मोर आंखी ला बंद होवन नइं दे;</para>
  <para style="q2" vid="PSA 77:4">मोला गोठियाय म बहुंत तकलीफ होवत रिहिस।<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>मेंह तइहा जमाना के बारे म सोचेंव,</para>
  <para style="q2" vid="PSA 77:5">बहुंत साल पहिले के बारे म;<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>मेंह रथिया अपन गीतमन ला सुरता करेंव।</para>
  <para style="q2" vid="PSA 77:6">मोर मन ह चिंतन-मनन करिस अऊ मोर आतमा ह पुछिस:<verse eid="PSA 77:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“का परभू ह हमेसा बर तियाग दीही?</para>
  <para style="q2" vid="PSA 77:7">का ओह फेर कभू दया नइं देखाही?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>का ओकर अटूट मया ह हमेसा बर खतम हो गीस?</para>
  <para style="q2" vid="PSA 77:8">का ओकर परतिगियां ह हमेसा बर खतम हो गीस?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>का परमेसर ह दयालु होय के बात ला भुला गे हवय?</para>
  <para style="q2" vid="PSA 77:9">का ओह गुस्सा होके अपन करूना ला रोक ले हवय?”<verse eid="PSA 77:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>तब मेंह सोचेंव, “मेंह ये अपील करहूं:</para>
  <para style="q2" vid="PSA 77:10">ओ सालमन म जब सर्वोच्च परमेसर ह अपन जेवनी हांथ ला बढ़ाईस।<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>मेंह यहोवा के काम ला सुरता करहूं;</para>
  <para style="q2" vid="PSA 77:11">हव, मेंह बहुंत पहिले के तोर चमतकार के काममन ला सुरता करहूं।<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>मेंह तोर जम्मो काम ऊपर बिचार करहूं</para>
  <para style="q2" vid="PSA 77:12">अऊ तोर जम्मो बड़े काम ऊपर चिंतन-मनन करहूं।”<verse eid="PSA 77:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>हे परमेसर, तोर रसता ह पबितर ए।</para>
  <para style="q2" vid="PSA 77:13">कोन देवता ह हमर परमेसर के सहीं महान ए?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>तेंह ओ परमेसर अस, जऊन ह चमतकार करथे;</para>
  <para style="q2" vid="PSA 77:14">तेंह मनखेमन के बीच म अपन सामर्थ देखाथस।<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>अपन सक्तिसाली हांथ ले तेंह अपन मनखे,</para>
  <para style="q2" vid="PSA 77:15">याकूब अऊ यूसुफ के संतानमन ला छोंड़ाय।<verse eid="PSA 77:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>हे परमेसर, समुंदर ह तोला देखिस,</para>
  <para style="q2" vid="PSA 77:16">समुंदर ह तोला देखके छटपटाय लगिस;</para>
  <para style="q2" vid="PSA 77:16">समुंदर के गहरई तक उथल-पुथल हो गीस।<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>बादर ले बारिस होय लगिस,</para>
  <para style="q2" vid="PSA 77:17">अकास म गरजन होय लगिस;</para>
  <para style="q2" vid="PSA 77:17">तोर तीरमन आघू-पाछू चले लगिन।<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>तोर गरजन ह बवंडर म सुनई दीस,</para>
  <para style="q2" vid="PSA 77:18">तोर बिजली ह संसार ला अंजोर कर दीस;</para>
  <para style="q2" vid="PSA 77:18">धरती ह थरथराय अऊ कांपे लगिस।<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>तोर रसता ह समुंदर म ले होके गीस,</para>
  <para style="q2" vid="PSA 77:19">तोर डहार ह गहिरा पानी म ले होके गीस,</para>
  <para style="q2" vid="PSA 77:19">हालाकि तोर गोड़ के चिनहांमन नइं दिखिन।<verse eid="PSA 77:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>तेंह मूसा अऊ हारून के दुवारा</para>
  <para style="q2" vid="PSA 77:20">अपन मनखेमन के अगुवई एक झुंड के रूप करे।<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="cl">भजन-संहिता 78</para>
  <para style="d">आसाप के एक <char style="tl">मसकील</char><note caller="+" style="f"><char style="fr" closed="false">78:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद।</char></note>।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>हे मोर मनखेमन, मोर सिकछा ऊपर धियान देवव;</para>
  <para style="q2" vid="PSA 78:1">मोर मुहूं के बात ला सुनव।<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>मेंह अपन बात एक पटंतर म करहूं;</para>
  <para style="q2" vid="PSA 78:2">मेंह गुपत बात, पुराना जमाना के बात बताहूं—<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>ओ बात जेला हमन सुने हन अऊ जान ले हन,</para>
  <para style="q2" vid="PSA 78:3">ओ बात जेला हमर पुरखामन हमन ला बताय हवंय।<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>यहोवा के परसंसा के काम,</para>
  <para style="q2" vid="PSA 78:4">ओकर सामर्थ, अऊ ओकर करे गे अद्भूत काममन ला</para>
  <para style="q1" vid="PSA 78:4">हमन ओमन के संतानमन ले नइं छुपावन;</para>
  <para style="q2" vid="PSA 78:4">हमन अवइया पीढ़ी के मनखेमन ला बताबो।<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>ओह याकूब बर बिधिमन ला ठहिराईस</para>
  <para style="q2" vid="PSA 78:5">अऊ इसरायल म कानून स्थापित करिस,</para>
  <para style="q1" vid="PSA 78:5">जेकर बारे म ओह हमर पुरखामन ला हुकूम दीस</para>
  <para style="q2" vid="PSA 78:5">कि ओमन अपन लइकामन ला ओकर सिकछा देवंय,<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>ताकि अवइया पीढ़ी के मनखेमन ओला जानंय,</para>
  <para style="q2" vid="PSA 78:6">अऊ त अऊ ओ लइकामन घलो जेमन जनम लेवइया हें,</para>
  <para style="q2" vid="PSA 78:6">अऊ बाद म ओमन अपन लइकामन ला सिखोवंय।<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>तब ओमन परमेसर ऊपर अपन भरोसा रखहीं</para>
  <para style="q2" vid="PSA 78:7">अऊ ओमन ओकर काममन ला नइं भूलहीं</para>
  <para style="q2" vid="PSA 78:7">पर ओकर हुकूममन ला मानहीं।<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>ओमन अपन पुरखामन सहीं नइं होहीं—</para>
  <para style="q2" vid="PSA 78:8">जेमन हठीला अऊ बिदरोही रिहिन,</para>
  <para style="q1" vid="PSA 78:8">जेमन के मन म परमेसर के प्रति भक्ति नइं रिहिस,</para>
  <para style="q2" vid="PSA 78:8">जेमन के आतमा ह परमेसर बर बिसवासयोग्य नइं रिहिस।<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>एपरैम के मनखेमन हालाकि धनुस धरे रिहिन,</para>
  <para style="q2" vid="PSA 78:9">पर लड़ई के दिन ओमन वापिस भाग गीन;<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>ओमन परमेसर के करार ला नइं मानिन</para>
  <para style="q2" vid="PSA 78:10">अऊ ओकर कानून के मुताबिक चले बर इनकार करिन।<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>ओमन भुला गीन कि परमेसर ह ओमन बर का करे रिहिस,</para>
  <para style="q2" vid="PSA 78:11">ओ अद्भूत काम, जेला ओह ओमन ला देखाय रिहिस।<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>ओह ओमन के पुरखामन के आघू म मिसर देस के</para>
  <para style="q2" vid="PSA 78:12">सोअन के इलाका म चमतकार के काम करे रिहिस।<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>ओह समुंदर ला दू भाग करके ओमन ला उहां ले निकाले रिहिस;</para>
  <para style="q2" vid="PSA 78:13">ओह पानी ला दीवार सहीं खड़े करवा दे रिहिस।<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>ओह दिन के समय बादर के दुवारा</para>
  <para style="q2" vid="PSA 78:14">अऊ रात भर आगी के अंजोर के दुवारा ओमन के अगुवई करय।<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>ओह उजाड़ जगह म पथरामन ला फोरके</para>
  <para style="q2" vid="PSA 78:15">ओमन ला समुंदर के सहीं बहुंतायत से पानी दीस;<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>ओह उबड़-खाबड़ चट्टान म ले पानी के धारा निकालिस</para>
  <para style="q2" vid="PSA 78:16">अऊ पानी ला नदी के सहीं बहाईस।<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>पर ओमन निरजन जगह म सर्वोच्च परमेसर के बिरूध बिदरोह करत</para>
  <para style="q2" vid="PSA 78:17">लगातार पाप करते रिहिन।<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>ओमन लालायित होके जेवन मांगे के दुवारा</para>
  <para style="q2" vid="PSA 78:18">जानबूझके परमेसर ला परखिन।<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>ओमन परमेसर के बिरूध गोठियाईन;</para>
  <para style="q2" vid="PSA 78:19">ओमन कहिन, “का परमेसर ह सही म</para>
  <para style="q2" vid="PSA 78:19">निरजन जगह म हमन ला जेवन दे सकथे?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>सही म, ओह चट्टान ला मारिस,</para>
  <para style="q2" vid="PSA 78:20">अऊ उहां ले पानी के तेज धारा फूट निकलिस,</para>
  <para style="q2" vid="PSA 78:20">अऊ पानी के धारा ह बहुंतायत ले बहे लगिस,</para>
  <para style="q1" vid="PSA 78:20">पर का ओह हमन ला रोटी घलो दे सकथे?</para>
  <para style="q2" vid="PSA 78:20">का ओह अपन मनखेमन ला मांस के पूरती कर सकथे?”<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>जब यहोवा ह ओमन के बात ला सुनिस, त ओह बहुंत नराज होईस;</para>
  <para style="q2" vid="PSA 78:21">याकूब के बिरूध ओकर आगी ह भड़किस,</para>
  <para style="q2" vid="PSA 78:21">अऊ इसरायल के बिरूध ओकर कोप ह भड़किस,<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>काबरकि ओमन परमेसर ऊपर बिसवास नइं करिन,</para>
  <para style="q2" vid="PSA 78:22">अऊ न ही ओकर छुटकारा देय के ऊपर भरोसा रखिन।<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>तभो ले ओह ऊपर अकास ला हुकूम दीस</para>
  <para style="q2" vid="PSA 78:23">अऊ स्वरग के कपाटमन ला खोल दीस;<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>ओह मनखेमन के खाय बर मन्ना के बारिस करिस,</para>
  <para style="q2" vid="PSA 78:24">ओह ओमन ला स्वरग के अनाज दीस।<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>मनखेमन स्वरगदूतमन के रोटी खावत रिहिन;</para>
  <para style="q2" vid="PSA 78:25">ओह ओमन ला भरपेट जेवन दीस।<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>ओह अकास ले पूरबी हवा चलाईस</para>
  <para style="q2" vid="PSA 78:26">अऊ अपन सामर्थ ले दक्खिनी हवा चलाईस।<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>ओह ओमन बर धुर्रा के सहीं मांस के बारिस करिस,</para>
  <para style="q2" vid="PSA 78:27">समुंदर के बालू सहीं चिरईमन ला पठोईस।<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>ओह ओ चिरईमन ला ओमन के तम्बू के चारों कोति</para>
  <para style="q2" vid="PSA 78:28">ओमन के डेरा के भीतर लानिस।<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>ओमन गला के आवत तक खाईन—</para>
  <para style="q2" vid="PSA 78:29">परमेसर ह ओमन ला ओ दीस, जेकर ओमन लालसा करिन।<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>पर येकर पहिले कि ओमन अपन लालसा करे चीज ले फिरतिन,</para>
  <para style="q2" vid="PSA 78:30">अऊ त अऊ जेवन ह ओमन के मुहूं म ही रिहिस,<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>कि परमेसर के कोरोध ह ओमन के बिरूध भड़किस;</para>
  <para style="q2" vid="PSA 78:31">ओह इसरायल के जवानमन ला काटके गिरावत</para>
  <para style="q2" vid="PSA 78:31">ओमन के बीच के हट्टा-कट्टा मनखेमन ला मार डारिस।<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>अतेक होय के बाद घलो ओमन पाप करते रिहिन;</para>
  <para style="q2" vid="PSA 78:32">ओकर अद्भूत काममन ला देखे के बाद घलो ओमन बिसवास नइं करिन।<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>एकरसेति ओह ओमन के जिनगी के दिनमन ला बेकार म</para>
  <para style="q2" vid="PSA 78:33">अऊ ओमन के सालमन ला आतंक म खतम कर दीस।<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>जब भी परमेसर ह ओमन के हतिया करय, ओमन ओकर खोज करंय;</para>
  <para style="q2" vid="PSA 78:34">ओमन उतावला होके ओकर कोति फेर लहुंटंय।<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>ओमन सुरता करंय कि परमेसर ह ओमन के चट्टान ए,</para>
  <para style="q2" vid="PSA 78:35">ओमन सुरता करंय कि सर्वोच्च परमेसर ह ओमन के छुड़इया ए।<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>पर तब ओमन अपन मुहूं ले ओकर चापलूसी करंय,</para>
  <para style="q2" vid="PSA 78:36">अऊ ओकर ले लबारी मारंय;<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>ओमन के मन ह ओकर बर ईमानदार नइं रिहिस,</para>
  <para style="q2" vid="PSA 78:37">ओमन ओकर करार के प्रति बिसवासयोग्य नइं रिहिन।<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>तभो ले ओह ओमन ऊपर दया करिस;</para>
  <para style="q2" vid="PSA 78:38">ओह ओमन के अपराध ला छेमा करिस</para>
  <para style="q2" vid="PSA 78:38">अऊ ओमन ला नास नइं करिस।</para>
  <para style="q1" vid="PSA 78:38">बार-बार ओह अपन गुस्सा ला रोकिस</para>
  <para style="q2" vid="PSA 78:38">अऊ अपन कोप ला पूरा नइं भड़काईस।<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>ओह सुरता रखिस कि ओमन सिरिप हाड़-मांस के मनखे अंय,</para>
  <para style="q2" vid="PSA 78:39">एक बहत हवा सहीं अंय, जऊन ह लहुंटके नइं आवय।<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>निरजन जगह म ओमन ओकर बिरूध कतेक बार ले बिदरोह करिन</para>
  <para style="q2" vid="PSA 78:40">अऊ उजाड़ जगह म ओला दुखी करिन!<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>बार-बार ओमन परमेसर ला परखिन;</para>
  <para style="q2" vid="PSA 78:41">ओमन इसरायल के पबितर परमेसर ला चिढ़ दिलाईन।<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>ओमन ओकर सामर्थ ला सुरता नइं करिन—</para>
  <para style="q2" vid="PSA 78:42">ओ दिन जब ओह ओमन ला अतियाचारी ले छोंड़ाय रिहिस,<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>ओ दिन जब ओह मिसर देस म अपन चिनहां,</para>
  <para style="q2" vid="PSA 78:43">सोअन के इलाका म अपन अद्भूत काम देखाईस।<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>ओह मिसरीमन के नदी के पानी ला खून म बदल दीस;</para>
  <para style="q2" vid="PSA 78:44">ओमन अपन पानी के सोता ले पानी नइं पी सकिन।<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>ओह ओमन ऊपर मधुमक्खीमन के झुंड पठोईस, जेमन ओमन ला खा गीन,</para>
  <para style="q2" vid="PSA 78:45">अऊ मेचकामन ला पठोईस, जेमन ओमन ला बरबाद कर दीन।<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>ओह ओमन के फसल ला कीरामन ला,</para>
  <para style="q2" vid="PSA 78:46">अऊ ओमन के ऊपज ला फांफामन ला दे दीस।<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>ओह ओमन के अंगूर के नारमन ला करा गिराके</para>
  <para style="q2" vid="PSA 78:47">अऊ ओमन के डूमर रूखमन ला बरफ के संग पानी गिराके नास कर दीस।<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>ओह ओमन के पालतू पसुमन ला करा गिराके,</para>
  <para style="q2" vid="PSA 78:48">अऊ पसु-धन ला बिजली गिराके नास कर दीस।<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>ओह ओमन के बिरूध अपन भारी गुस्सा,</para>
  <para style="q2" vid="PSA 78:49">अपन कोप, कोरोध अऊ बईरता देखाईस—</para>
  <para style="q2" vid="PSA 78:49">येमन नास करइया स्वरगदूतमन के एक दल रिहिन।<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>ओह अपन कोरोध बर एक रसता तियार करिस;</para>
  <para style="q2" vid="PSA 78:50">ओह ओमन ला मिरतू ले नइं बचाईस</para>
  <para style="q2" vid="PSA 78:50">पर ओमन ला महामारी के बस म कर दीस।<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>ओह मिसर देस के जम्मो पहिलांतमन ला मार डारिस,</para>
  <para style="q2" vid="PSA 78:51">जेमन हाम<note caller="+" style="f"><char style="fr" closed="false">78:51 </char><char style="ft" closed="false">हाम ह नूह के एक बेटा रिहिस, जेला मिसरीमन के पुरखा के रूप म जाने जाथे (<char style="xt"><ref loc="GEN 10:6">उत 10:6</ref></char>)</char></note> के डेरामन म मरदानगी के पहिला फर रिहिन।<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>पर ओह अपन मनखेमन ला पसुमन के झुंड सहीं बाहिर निकालिस;</para>
  <para style="q2" vid="PSA 78:52">निरजन जगह म भेड़ के सहीं ओह ओमन के अगुवई करिस।<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>ओह ओमन ला सुरकछित निकालिस, जेकर ले ओमन निडर रिहिन;</para>
  <para style="q2" vid="PSA 78:53">पर ओमन के बईरीमन समुंदर म बुड़ गीन।<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>अऊ ये किसम ले ओह ओमन ला अपन पबितर देस के सीमना,</para>
  <para style="q2" vid="PSA 78:54">ओ पहाड़ी देस म लानिस, जेला ओकर जेवनी हांथ ह लेय रिहिस।<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>ओह ओमन के आघू ले जाति-जाति के मनखेमन ला भगा दीस</para>
  <para style="q2" vid="PSA 78:55">अऊ ओमन के जमीन अपन मनखेमन ला निज भाग के रूप म दे दीस;</para>
  <para style="q2" vid="PSA 78:55">ओह इसरायल के गोत्रमन ला ओमन के घर म बसाईस।<verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>पर ओमन परमेसर के परिछा लीन</para>
  <para style="q2" vid="PSA 78:56">अऊ सर्वोच्च परमेसर के बिरूध बिदरोह करिन;</para>
  <para style="q2" vid="PSA 78:56">ओमन ओकर कानून-बिधिमन ला नइं मानिन।<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>अपन पुरखामन के सहीं ओमन बिसवासघाती अऊ बेईमान निकलिन,</para>
  <para style="q2" vid="PSA 78:57">एक निकम्मा धनुस के सहीं धोखा दीन।<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>ओमन देवतामन बर ऊंच जगहमन ला बनाके ओला गुस्सा दिलाईन;</para>
  <para style="q2" vid="PSA 78:58">ओमन मूरतीमन ला बनाके ओमा जलन पईदा करिन।<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>जब परमेसर ह ओमन के सुनिस, त ओह बहुंत गुस्सा होईस;</para>
  <para style="q2" vid="PSA 78:59">ओह इसरायल ला पूरा तियाग दीस।<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>ओह सीलो सहर के ओ पबितर-तम्बू ला तियाग दीस,</para>
  <para style="q2" vid="PSA 78:60">जेला ओह मनखेमन के बीच खड़े करे रिहिस।<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>ओह अपन ताकत के सन्दूक ला बंधुवई म,</para>
  <para style="q2" vid="PSA 78:61">अऊ अपन सोभा ला बईरीमन के हांथ म दे दीस।<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>ओह अपन मनखेमन ला तलवार ले मरवा दीस;</para>
  <para style="q2" vid="PSA 78:62">ओह अपन निज भाग के मनखेमन ऊपर बहुंत गुस्सा होईस।<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>आगी ह ओमन के जवानमन ला भसम कर दीस,</para>
  <para style="q2" vid="PSA 78:63">अऊ ओमन के जवान छोकरीमन बर कोनो बिहाव के गीत गाय नइं गीस;<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>ओमन के पुरोहितमन तलवार ले मार डारे गीन,</para>
  <para style="q2" vid="PSA 78:64">अऊ ओमन के बिधवामन रोए नइं सकिन।<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>तब परभू ह मानो नींद ले जागिस,</para>
  <para style="q2" vid="PSA 78:65">जइसे कोनो योद्धा ह मंद के मूर्छा ले जागथे।<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>ओह अपन बईरीमन ला मार भगाईस;</para>
  <para style="q2" vid="PSA 78:66">ओह ओमन ला हमेसा बर लज्जित करिस।<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>तब ओह यूसुफ के तम्बू ला तियाग दीस,</para>
  <para style="q2" vid="PSA 78:67">अऊ एपरैम के गोत्र ला नइं चुनिस;<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>पर ओह यहूदा के गोत्र,</para>
  <para style="q2" vid="PSA 78:68">सियोन पहाड़ ला चुन लीस, जेला कि ओह मया करिस।<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>ओह अपन पबितर-स्थान ला ऊंचहा जगह सहीं बनाईस,</para>
  <para style="q2" vid="PSA 78:69">धरती के सहीं बनाईस, जेला ओह हमेसा बर रखिस।<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>ओह अपन सेवक दाऊद ला चुनिस</para>
  <para style="q2" vid="PSA 78:70">अऊ ओला भेड़मन के बाड़ा ले लेय लीस;<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>भेड़ चराय के काम ले दाऊद ला हटाके ओह ले आईस</para>
  <para style="q2" vid="PSA 78:71">ताकि दाऊद ह ओकर मनखे याकूब,</para>
  <para style="q2" vid="PSA 78:71">ओकर निज भाग इसरायल के चरवाहा बनय।<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>अऊ दाऊद ह पूरा ईमानदारी से ओमन के देखरेख करिस;</para>
  <para style="q2" vid="PSA 78:72">अपन कुसल हांथ ले ओह ओमन के अगुवई करिस।<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="cl">भजन-संहिता 79</para>
  <para style="d">आसाप के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>हे परमेसर, आनजातमन तोर निज भाग के ऊपर हमला कर दे हवंय;</para>
  <para style="q2" vid="PSA 79:1">ओमन हमर पबितर मंदिर ला असुध कर दे हवंय,</para>
  <para style="q2" vid="PSA 79:1">ओमन यरूसलेम ला खंडहर बना दे हवंय।<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>ओमन तोर सेवकमन के लासमन ला</para>
  <para style="q2" vid="PSA 79:2">अकास के चिरईमन के जेवन बर</para>
  <para style="q2" vid="PSA 79:2">अऊ तोर खुद के मनखेमन के मांस ला जंगली पसुमन बर छोंड़ दे हवंय।<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>ओमन यरूसलेम के चारों कोति</para>
  <para style="q2" vid="PSA 79:3">खून ला पानी सहीं बहाय हवंय,</para>
  <para style="q2" vid="PSA 79:3">अऊ मरे मनखेमन ला माटी देय बर कोनो नइं ए।<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>हमन हमर परोसीमन बर अनादर के पात्र,</para>
  <para style="q2" vid="PSA 79:4">अऊ हमर आसपास के मनखेमन बर तिरस्कार अऊ हंसी के पात्र बन गे हवन।<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>हे यहोवा, कब तक? का तेंह हमेसा बर कोरोध करते रहिबे?</para>
  <para style="q2" vid="PSA 79:5">कब तक तोर डाह ह आगी सहीं बरत रहिही?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>ओ आनजातमन के ऊपर अपन कोप ला भड़का</para>
  <para style="q2" vid="PSA 79:6">जऊन मन तोला स्वीकार नइं करंय,</para>
  <para style="q1" vid="PSA 79:6">ओ राजमन ऊपर अपन कोप ला भड़का,</para>
  <para style="q2" vid="PSA 79:6">जेमन तोर नांव के गुन नइं गावंय;<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>काबरकि ओमन याकूब ला खा गे हवंय</para>
  <para style="q2" vid="PSA 79:7">अऊ ओकर खुद के देस ला तहस-नहस कर दे हवंय।<verse eid="PSA 79:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>हमर पहिले के पीढ़ी के मनखेमन के पाप के लेखा हमर ले झन ले;</para>
  <para style="q2" vid="PSA 79:8">हमर ऊपर बिगर देरी के दया कर,</para>
  <para style="q2" vid="PSA 79:8">काबरकि हमन बहुंत दुरदसा म हवन।<verse eid="PSA 79:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>हे परमेसर हमर उद्धारकर्ता,</para>
  <para style="q2" vid="PSA 79:9">अपन नांव के महिमा बर हमर मदद कर;</para>
  <para style="q1" vid="PSA 79:9">अपन नांव के हित म</para>
  <para style="q2" vid="PSA 79:9">हमन ला छोंड़ा अऊ हमर पाप ला छेमा कर।<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>आनजात के मनखेमन काबर कहंय,</para>
  <para style="q2" vid="PSA 79:10">“ओमन के परमेसर कहां हवय?”</para>
  <para style="b" vid="PSA 79:10"/>
  <para style="q1" vid="PSA 79:10">हमर देखत म, आनजात के मनखेमन ला बता</para>
  <para style="q2" vid="PSA 79:10">कि तेंह अपन सेवकमन के बहे खून के बदला लेथस।<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>कैदीमन के कराहे के अवाज तोर करा हबरय;</para>
  <para style="q2" vid="PSA 79:11">मिरतू के सजा पाय मनखेमन ला अपन मजबूत हांथ ले संभाल।<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>हे परभू, हमर परोसीमन तोर जऊन अपमान करे हवंय,</para>
  <para style="q2" vid="PSA 79:12">ओकर तेंह ओमन ले सात गुना बदला ले।<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>तब हमन तोर मनखेमन, तोर चरागन के भेड़मन</para>
  <para style="q2" vid="PSA 79:13">हमेसा तोर परसंसा करबो;</para>
  <para style="q1" vid="PSA 79:13">पीढ़ी-पीढ़ी तक</para>
  <para style="q2" vid="PSA 79:13">हमन तोर परसंसा करबो।<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="cl">भजन-संहिता 80<note caller="+" style="f"><char style="fr" closed="false">80 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 80:1-19">80:1‑19</ref></char> ला 8:2‑20 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। “करार के कुमुदिनी” के राग म आसाप के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>हे इसरायल के चरवाहा, तें जऊन ह यूसुफ के अगुवई</para>
  <para style="q2" vid="PSA 80:1">भेड़ के झुंड के सहीं करथस, हमर बात ला सुन।</para>
  <para style="q1" vid="PSA 80:1">तें जऊन ह करूबमन के बीच म बिराजमान हस,<verse eid="PSA 80:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 80:2"/>एपरैम, बिनयामीन अऊ मनस्से के आघू म अपन अंजोर ला चमका।</para>
  <para style="q1" vid="PSA 80:2">अपन ताकत ला जगा;</para>
  <para style="q2" vid="PSA 80:2">आ अऊ हमन ला बचा।<verse eid="PSA 80:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>हे परमेसर, हमन ला फेर पहिले के सहीं कर दे;</para>
  <para style="q2" vid="PSA 80:3">अपन मुहूं के अंजोर हमर ऊपर चमका,</para>
  <para style="q2" vid="PSA 80:3">कि हमर उद्धार हो जावय।<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>हे यहोवा, सर्वसक्तिमान परमेसर,</para>
  <para style="q2" vid="PSA 80:4">तोर मनखेमन के पराथना के बिरूध</para>
  <para style="q2" vid="PSA 80:4">कब तक तोर गुस्सा ह सुलगत रहिही?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>तेंह ओमन ला आंसू के रोटी खवाय हस;</para>
  <para style="q2" vid="PSA 80:5">तेंह ओमन ला कटोरा भर-भरके आंसू पीयाय हस।<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>तेंह हमन ला हमर परोसीमन बर हंसी<note caller="+" style="f"><char style="fr" closed="false">80:6 </char><char style="ft" closed="false">मूल इबरानी अनुवाद; मासोरेटिक म </char><char style="fqa" closed="false">बिबाद </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बिरोध</char></note> के पात्र बना दे हस,</para>
  <para style="q2" vid="PSA 80:6">अऊ हमर बईरीमन हमर हंसी उड़ाथें।<verse eid="PSA 80:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>हे सर्वसक्तिमान परमेसर, हमन ला फेर पहिले सहीं कर दे;</para>
  <para style="q2" vid="PSA 80:7">अपन मुहूं के अंजोर हमर ऊपर चमका,</para>
  <para style="q2" vid="PSA 80:7">कि हमर उद्धार हो जावय।<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>तें मिसर देस ले अंगूर के एक नार लानके लगाय;</para>
  <para style="q2" vid="PSA 80:8">तें आनजातमन ला निकालके ओ अंगूर के नार ला लगाय।<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>येकर बर तेंह भुइयां ला तियार करय,</para>
  <para style="q2" vid="PSA 80:9">अऊ येह जरी पकड़िस अऊ देस म भर गीस।<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>येकर छइहां ले पहाड़मन,</para>
  <para style="q2" vid="PSA 80:10">अऊ येकर डारामन ले बड़े देवदारमन ढंक गीन।<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>येकर डारामन समुंदर तक बढ़ गीन,</para>
  <para style="q2" vid="PSA 80:11">अऊ येकर अंकुरमन नदी तक बगर गीन।<verse eid="PSA 80:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>तेंह काबर येकर दीवार ला गिरा देय,</para>
  <para style="q2" vid="PSA 80:12">जेकर कारन जम्मो डहार रेंगइयामन येकर अंगूर ला टोरथें?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>जंगली सुरामन येला नास करथें,</para>
  <para style="q2" vid="PSA 80:13">अऊ भुइयां के कीरामन येला खाथें।<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>हे सर्वसक्तिमान परमेसर, हमर करा लहुंट आ!</para>
  <para style="q2" vid="PSA 80:14">स्वरग ले निहरके देख!</para>
  <para style="q1" vid="PSA 80:14">ये अंगूर के नार ऊपर धियान दे,<verse eid="PSA 80:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 80:15"/>ओ जरी जेला तोर जेवनी हांथ ह लगाय हवय,</para>
  <para style="q2" vid="PSA 80:15">ओ बेटा<note caller="+" style="f"><char style="fr" closed="false">80:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">डारा (साखा)</char></note> जेला तेंह अपन बर बढ़ाय हस।<verse eid="PSA 80:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>तोर अंगूर के नार ह कट गे हवय, येह आगी ले जर गे हवय;</para>
  <para style="q2" vid="PSA 80:16">तोर डांट-फटकार ले तोर मनखेमन नास होथें।<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>तोर जेवनी हांथ कोति के मनखे ऊपर तोर हांथ रहय,</para>
  <para style="q2" vid="PSA 80:17">मनखे के ओ बेटा, जेला तेंह अपन बर बढ़ाय हस।<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>तब हमन तोर ले दूरिहा नइं जाबो;</para>
  <para style="q2" vid="PSA 80:18">हमन ला पहिले सहीं कर दे, अऊ हमन तोर नांव के गुन गाबो।<verse eid="PSA 80:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>हे यहोवा सर्वसक्तिमान परमेसर, हमन ला फेर पहिले सहीं कर दे;</para>
  <para style="q2" vid="PSA 80:19">अपन मुहूं के अंजोर हमर ऊपर चमका,</para>
  <para style="q2" vid="PSA 80:19">कि हमर उद्धार होवय।<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="cl">भजन-संहिता 81<note caller="+" style="f"><char style="fr" closed="false">81 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 81:1-16">81:1‑16</ref></char> ला 81:2‑17 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। आसाप के <char style="tl">गित्तीथ</char><note caller="+" style="f"><char style="fr" closed="false">81:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note> के मुताबिक।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>परमेसर जऊन ह हमर ताकत ए, ओकर बर आनंद के गीत गावव;</para>
  <para style="q2" vid="PSA 81:1">याकूब के परमेसर बर चिचियाके जय-जयकार करव!<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>बाजा बजाय के सुरू करव, खंजरी बजावव,</para>
  <para style="q2" vid="PSA 81:2">सुरीला बीना अऊ सारंगी बजावव।<verse eid="PSA 81:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>नवां चंदा के दिन, अऊ पून्नी के दिन,</para>
  <para style="q2" vid="PSA 81:3">जब हमर तिहार होथे, तब नरसिंगा फूंकव;<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>येह इसरायल बर एक बिधि,</para>
  <para style="q2" vid="PSA 81:4">अऊ याकूब के परमेसर के एक नियम अय।<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>जब परमेसर ह मिसर देस के बिरूध चलिस,</para>
  <para style="q2" vid="PSA 81:5">त ओह यूसुफ बर येला एक बिधि ठहिराईस।</para>
  <para style="b" vid="PSA 81:5"/>
  <para style="q1" vid="PSA 81:5">मेंह एक अनजान अवाज ला ये कहत सुनेंव:<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>“मेंह ओमन के ऊपर ले बोझा ला हटा देंव;</para>
  <para style="q2" vid="PSA 81:6">टोकरी उठाय के काम ले ओमन ला मुक्त कर देंव।<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>तेंह संकट के बेरा पुकारय अऊ मेंह तोला बचांय,</para>
  <para style="q2" vid="PSA 81:7">मेंह तोला बादर के गरजन ले जबाब देंव;</para>
  <para style="q2" vid="PSA 81:7">मेंह मरीबा के सोता करा तोला परखेंव।<verse eid="PSA 81:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>हे मोर मनखेमन, मोर बात ला सुनव, अऊ मेंह तुमन ला चेताहूं—</para>
  <para style="q2" vid="PSA 81:8">हे इसरायल, यदि तुमन सिरिप मोर सुनहू त!<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>तुमन अपन बीच म कोनो पराया देवता झन रखव;</para>
  <para style="q2" vid="PSA 81:9">तुमन मोला छोंड़ अऊ कोनो देवता के अराधना झन करव।<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>मेंह यहोवा तुम्हर परमेसर अंव,</para>
  <para style="q2" vid="PSA 81:10">जऊन ह तुमन ला मिसर देस ले निकाल लानिस।</para>
  <para style="q1" vid="PSA 81:10">तुमन अपन मुहूं ला पूरा खोलव अऊ मेंह ओला भर दूहूं।<verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>“पर मोर मनखेमन मोर बात ला नइं सुनिन;</para>
  <para style="q2" vid="PSA 81:11">इसरायल ह मोर बात ला नइं मानिस।<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>एकरसेति मेंह ओमन ला ओमन के जिद्दी सुभाव म छोंड़ देंव</para>
  <para style="q2" vid="PSA 81:12">ताकि ओमन अपन मनमानी करंय।<verse eid="PSA 81:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>“कहूं मोर मनखेमन सिरिप मोर बात ला सुने होतिन,</para>
  <para style="q2" vid="PSA 81:13">कहूं इसरायल ह सिरिप मोर रसता म चले होतिस,<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>त बहुंत जल्दी मेंह ओमन के बईरीमन ला दबा दे रहितेंव</para>
  <para style="q2" vid="PSA 81:14">अऊ मोर हांथ ह ओमन के बिरोधीमन ऊपर चले होतिस!<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>जऊन मन यहोवा ले घिन करथें, ओमन ओकर आघू म चापलूसी करहीं,</para>
  <para style="q2" vid="PSA 81:15">अऊ ओमन के सजा ह हमेसा बने रहिही।<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>पर तोला सबले बने गहूं ले बने जेवन मिलही;</para>
  <para style="q2" vid="PSA 81:16">चट्टान के मंधरस ले मेंह तोला भरपूर खवाहूं।”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="cl">भजन-संहिता 82</para>
  <para style="d">आसाप के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>परमेसर के सभा म परमेसर ही सभापति होथे;</para>
  <para style="q2" vid="PSA 82:1">ओह “देवतामन” के बीच म नियाय करथे:<verse eid="PSA 82:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>“तुमन कब तक अनियायीमन के बचाव करते रहिहू</para>
  <para style="q2" vid="PSA 82:2">अऊ दुस्टमन के समरथन करत रहिहू?<verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>दुरबल अऊ अनाथमन के बचाव करव;</para>
  <para style="q2" vid="PSA 82:3">गरीब अऊ दुखीमन के मामला के समरथन करव।<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>दुरबल अऊ जरूरतमंद के बचाव करव;</para>
  <para style="q2" vid="PSA 82:4">दुस्टमन के हांथ ले ओमन ला छोंड़ावव।<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>“ ‘देवतामन’ कुछू नइं जानंय, ओमन कुछू नइं समझंय।</para>
  <para style="q2" vid="PSA 82:5">ओमन अंधियार म चलथें-फिरथें;</para>
  <para style="q2" vid="PSA 82:5">धरती के जम्मो नीवमन हालत हें।<verse eid="PSA 82:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>“मेंह कहेंव, ‘तुमन “ईस्वर” अव;</para>
  <para style="q2" vid="PSA 82:6">तुमन जम्मो सर्वोच्च परमेसर के बेटा अव।’<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>पर तुमन सिरिप मरनहार मनखे सहीं मरहू;</para>
  <para style="q2" vid="PSA 82:7">तुम्हर गिरई<note caller="+" style="f"><char style="fr" closed="false">82:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बिनास</char></note> ह आने सासन करइया सहीं होही।”<verse eid="PSA 82:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>हे परमेसर, उठ, धरती के नियाय कर,</para>
  <para style="q2" vid="PSA 82:8">काबरकि जम्मो जाति के मनखेमन तोर भाग एं।<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="cl">भजन-संहिता 83<note caller="+" style="f"><char style="fr" closed="false">83 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 83:1-18">83:1‑18</ref></char> ला 83:2‑19 गने गे हवय</char></note></para>
  <para style="d">एक गीत। आसाप के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>हे परमेसर, तेंह चुप झन रह;</para>
  <para style="q2" vid="PSA 83:1">अपन कान ला बंद झन कर,</para>
  <para style="q2" vid="PSA 83:1">हे परमेसर, दूरिहा झन रह।<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>देख, तोर बईरीमन कइसे गुर्रावत हें,</para>
  <para style="q2" vid="PSA 83:2">तोर बिरोधीमन कइसे मुड़ उठावत हें।<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>चालबाजी के संग ओमन तोर मनखेमन के बिरूध सडयंत्र करथें;</para>
  <para style="q2" vid="PSA 83:3">ओमन ओ मनखेमन के बिरूध सडयंत्र रचथें, जेमन के बचाव तेंह करथस।<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>ओमन कहिथें, “आवव, हमन ओमन ला एक जाति के रूप म नास कर देवन,</para>
  <para style="q2" vid="PSA 83:4">ताकि इसरायल के नांव ला झन सुरता करे जावय।”<verse eid="PSA 83:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>ओमन एक संग एक मन होके सडयंत्र करथें;</para>
  <para style="q2" vid="PSA 83:5">ओमन तोर बिरूध म एक जुट होथें—<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>ओमन एदोम अऊ इसमायलीमन के तम्बूवाले,</para>
  <para style="q2" vid="PSA 83:6">मोआबी अऊ हगरी,<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>गबाली, अमोनी अऊ अमालेकी,</para>
  <para style="q2" vid="PSA 83:7">पलिस्ती अऊ सूर के मनखेमन संग हवंय।<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>अऊ त अऊ अस्सूरीमन लूत के संतानमन के सक्ति बढ़ाय बर</para>
  <para style="q2" vid="PSA 83:8">ओमन के संग मिल गे हवंय।<verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>ओमन के संग वइसने कर, जइसने तेंह मिदयानीमन के संग,</para>
  <para style="q2" vid="PSA 83:9">अऊ कीसोन नदी म सीसरा अऊ याबीन के संग करे रहय,<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>जऊन मन एनदोर म नास हो गीन</para>
  <para style="q2" vid="PSA 83:10">अऊ भुइयां म गिरे गोबर सहीं हो गीन।<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>ओमन के परभावसाली मनखेमन ला ओरेब अऊ जेब सहीं,</para>
  <para style="q2" vid="PSA 83:11">अऊ ओमन के जम्मो राजकुमारमन ला जेबह अऊ सलमुन्ना सहीं कर दे,<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>जऊन मन कहिन, “आवव, हमन परमेसर के चरागनमन ला</para>
  <para style="q2" vid="PSA 83:12">अपन अधिकार म कर लेवन।”<verse eid="PSA 83:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>हे मोर परमेसर, ओमन ला बवंडर म उड़त धुर्रा,</para>
  <para style="q2" vid="PSA 83:13">हवा म उड़त भूंसा सहीं कर दे।<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>जइसे आगी ह जंगल ला जलाके नास कर देथे</para>
  <para style="q2" vid="PSA 83:14">या एक चिनगारी ह पहाड़मन म आगी लगा देथे,<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>वइसे तेंह अपन आंधी ले ओमन के पीछा कर</para>
  <para style="q2" vid="PSA 83:15">अऊ अपन तूफान ले ओमन ला भयभीत कर।<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>हे यहोवा, ओमन ला अइसने सरमिंदा कर,</para>
  <para style="q2" vid="PSA 83:16">कि ओमन तोर नांव लेवंय।<verse eid="PSA 83:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>ओमन हमेसा बर लज्जित अऊ भयभीत होवंय;</para>
  <para style="q2" vid="PSA 83:17">ओमन कलंकित होके नास हो जावंय।<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>ओमन तोला जानंय, जेकर नांव यहोवा ए—</para>
  <para style="q2" vid="PSA 83:18">ये घलो जानंय कि सिरिप तेंहीच ह जम्मो धरती ऊपर सर्वोच्च परमेसर अस।<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="cl">भजन-संहिता 84<note caller="+" style="f"><char style="fr" closed="false">84 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 84:1-12">84:1‑12</ref></char> ला 84:2‑13 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। <char style="tl">गित्तीथ</char><note caller="+" style="f"><char style="fr" closed="false">84:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note> के राग के मुताबिक कोरह के बेटामन के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>हे सर्वसक्तिमान यहोवा,</para>
  <para style="q2" vid="PSA 84:1">तोर निवास ह बहुंत सुघर हे,<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>मोर जीव ह यहोवा के अंगनामन के लालसा करत</para>
  <para style="q2" vid="PSA 84:2">मूरछित तक हो जाथे;</para>
  <para style="q1" vid="PSA 84:2">मोर तन अऊ मन</para>
  <para style="q2" vid="PSA 84:2">जीयत परमेसर ला पुकारथे।<verse eid="PSA 84:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>हे सर्वसक्तिमान यहोवा, मोर राजा अऊ मोर परमेसर,</para>
  <para style="q2" vid="PSA 84:3">तोर बेदी के लकठा म,</para>
  <para style="q2" vid="PSA 84:3">अऊ त अऊ गौरइया चिरई ह बसेरा करे हवय,</para>
  <para style="q1" vid="PSA 84:3">अऊ अबाबील चिरई ह एक खोंधरा बनाय हवय—</para>
  <para style="q2" vid="PSA 84:3">कि उहां ओह अपन पीलामन ला रख सकय।<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>धइन अंय ओमन, जऊन मन तोर घर म रहिथें;</para>
  <para style="q2" vid="PSA 84:4">ओमन हमेसा तोर परसंसा करत रहिथें।<verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>धइन अंय ओमन, जेमन ला तोर ले ताकत मिलथे,</para>
  <para style="q2" vid="PSA 84:5">जेमन के मन ह तीरथ-यातरा म लगे रहिथे।<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>जब ओमन बाका<note caller="+" style="f"><char style="fr" closed="false">84:6 </char><char style="fq" closed="false">बाका </char><char style="ft" closed="false">याने कि </char><char style="fqa" closed="false">बालसम रूख के घाटी </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">आंसू के घाटी</char></note> के घाटी ले होके जाथें,</para>
  <para style="q2" vid="PSA 84:6">त ओमन ओला पानी के सोत के एक जगह बना देथें;</para>
  <para style="q2" vid="PSA 84:6">सरदकाल के बरसात के पानी घलो येकर तरियामन ला भर देथे।<note caller="+" style="f"><char style="fr" closed="false">84:6 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">आसीस</char></note><verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>ओमन ताकत के ऊपर ताकत पाके तब तक आघू बढ़त रहिथें,</para>
  <para style="q2" vid="PSA 84:7">जब तक कि ओमा के हर एक जन सियोन म परमेसर करा नइं हबर जावय।<verse eid="PSA 84:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>हे यहोवा, सर्वसक्तिमान परमेसर, मोर पराथना ला सुन;</para>
  <para style="q2" vid="PSA 84:8">हे याकूब के परमेसर, मोर बात ला सुन।<verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>हे परमेसर, हमर ढाल ला देख;</para>
  <para style="q2" vid="PSA 84:9">अपन अभिसिक्त जन ऊपर किरपा कर।<verse eid="PSA 84:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>तोर अंगना म के एक दिन ह</para>
  <para style="q2" vid="PSA 84:10">अऊ कहीं के हजार दिन ले जादा बने अय;</para>
  <para style="q1" vid="PSA 84:10">दुस्टमन के डेरा म रहे के बदले</para>
  <para style="q2" vid="PSA 84:10">मेंह मोर परमेसर के घर म दुवारपाल होवई जादा पसंद करहूं।<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>काबरकि यहोवा परमेसर ह सूरज अऊ ढाल ए;</para>
  <para style="q2" vid="PSA 84:11">यहोवा अनुग्रह अऊ सम्मान देथे;</para>
  <para style="q1" vid="PSA 84:11">जऊन मन निरदोस बने रहिथें, ओमन ले</para>
  <para style="q2" vid="PSA 84:11">ओह बने चीजमन ला अलग नइं रखय।<verse eid="PSA 84:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>हे सर्वसक्तिमान यहोवा,</para>
  <para style="q2" vid="PSA 84:12">धइन अय ओ मनखे, जऊन ह तोर ऊपर भरोसा रखथे।<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="cl">भजन-संहिता 85<note caller="+" style="f"><char style="fr" closed="false">85 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 85:1-13">85:1‑13</ref></char> ला 85:2‑14 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर। कोरह के बेटामन के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>हे यहोवा, तेंह अपन देस ऊपर दया देखाय हस;</para>
  <para style="q2" vid="PSA 85:1">तेंह याकूब के दिनमन ला पहिले सहीं बने कर दे हस।<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>तेंह अपन मनखेमन के अपराध ला छेमा करे हस</para>
  <para style="q2" vid="PSA 85:2">अऊ ओमन के पाप ला ढांप दे हस।<verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>तेंह अपन जम्मो कोप ला एक तरफ रख दे हस</para>
  <para style="q2" vid="PSA 85:3">अऊ अपन भयंकर कोरोध ला छोंड़ दे हस।<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>हे परमेसर हमर उद्धारकर्ता, हमन ला फेर पहिले सहीं कर दे,</para>
  <para style="q2" vid="PSA 85:4">अऊ हमर बर तोर नराजगी ला हटा ले।<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>का तेंह सदाकाल बर हमर ऊपर गुस्सा करबे?</para>
  <para style="q2" vid="PSA 85:5">का तेंह अपन गुस्सा ला जम्मो पीढ़ी तक बनाय रखबे?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>का तेंह हमन ला फेर पुनरजीवित नइं करबे,</para>
  <para style="q2" vid="PSA 85:6">कि तोर मनखेमन तोर म आनंद मनावंय?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>हे यहोवा, हमन ला अपन सदा दिन के मया ला देखा,</para>
  <para style="q2" vid="PSA 85:7">अऊ हमन ला अपन उद्धार दे।<verse eid="PSA 85:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>परमेसर यहोवा ह जऊन कुछू कहिथे, ओला मेंह सुनहूं;</para>
  <para style="q2" vid="PSA 85:8">ओह अपन मनखे, अपन बिसवासयोग्य सेवकमन ला सांति देय के वायदा करथे—</para>
  <para style="q2" vid="PSA 85:8">पर ओमन फेर मुरूखता झन करंय।<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>खचित ओकर उद्धार ह ओमन के लकठा म हवय, जऊन मन ओकर भय मानथें,</para>
  <para style="q2" vid="PSA 85:9">कि ओकर महिमा ह हमर देस म रहय।<verse eid="PSA 85:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>मया अऊ ईमानदारी एक संग जूर जाथें;</para>
  <para style="q2" vid="PSA 85:10">धरमीपन अऊ सांति एक-दूसर ला चूमथें।<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>ईमानदारी ह धरती ले निकलथे,</para>
  <para style="q2" vid="PSA 85:11">अऊ धरमीपन ह स्वरग ले खाल्हे देखथे।<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>यहोवा ह वास्तव म ओ चीज ला दीही, जऊन ह बने अय,</para>
  <para style="q2" vid="PSA 85:12">अऊ हमर भुइयां ह येकर फसल दीही।<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>धरमीपन ह ओकर आघू-आघू चलथे</para>
  <para style="q2" vid="PSA 85:13">अऊ ओकर चले बर रसता तियार करथे।<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="cl">भजन-संहिता 86</para>
  <para style="d">दाऊद के एक पराथना।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>हे यहोवा, मोर बिनती ला सुन अऊ मोला जबाब दे,</para>
  <para style="q2" vid="PSA 86:1">काबरकि मेंह गरीब अऊ जरूरतमंद अंव।<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>मोर परान के रकछा कर, काबरकि मेंह तोर बर बिसवासयोग्य हंव;</para>
  <para style="q2" vid="PSA 86:2">अपन सेवक के उद्धार कर, जऊन ह कि तोर ऊपर भरोसा रखथे।</para>
  <para style="q1" vid="PSA 86:2">तेंह मोर परमेसर अस; <verse eid="PSA 86:2"/><verse number="3" style="v" sid="PSA 86:3"/>हे परभू, मोर ऊपर दया कर,</para>
  <para style="q2" vid="PSA 86:3">काबरकि मेंह दिन भर तोला पुकारथंव।<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>हे परभू, अपन सेवक ला आनंदित कर,</para>
  <para style="q2" vid="PSA 86:4">काबरकि मेंह तोर ऊपर भरोसा रखथंव।<verse eid="PSA 86:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>हे परभू, तें छेमा करइया अऊ बने अस,</para>
  <para style="q2" vid="PSA 86:5">जऊन मन तोर नांव लेथें, ओ जम्मो ला तेंह बहुंत मया करथस।<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>हे यहोवा, मोर पराथना ला सुन;</para>
  <para style="q2" vid="PSA 86:6">मोर बात ला सुनके मोर ऊपर दया कर।<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>जब मेंह संकट म रहिथंव, त मेंह तोला पुकारथंव,</para>
  <para style="q2" vid="PSA 86:7">काबरकि तेंह मोला जबाब देथस।<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>हे परभू, देवतामन म तोर सहीं कोनो नइं एं;</para>
  <para style="q2" vid="PSA 86:8">कोनो भी काम के तुलना तोर काम से करे नइं जा सकय।<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>हे परभू, ओ जम्मो जाति के मनखे जेमन ला तेंह बनाय हस,</para>
  <para style="q2" vid="PSA 86:9">ओमन आहीं अऊ तोर आघू म अराधना करहीं;</para>
  <para style="q2" vid="PSA 86:9">ओमन तोर नांव के महिमा करहीं।<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>काबरकि तेंह महान अस अऊ अद्भूत काम करथस;</para>
  <para style="q2" vid="PSA 86:10">सिरिप तेंह परमेसर अस।<verse eid="PSA 86:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>हे यहोवा, अपन रसता मोला देखा,</para>
  <para style="q2" vid="PSA 86:11">ताकि मेंह तोर बिसवासयोग्यता ऊपर भरोसा करंव;</para>
  <para style="q1" vid="PSA 86:11">मोला न भटकनेवाला मन दे,</para>
  <para style="q2" vid="PSA 86:11">ताकि मेंह तोर नांव के भय मानंव।<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>हे परभू मोर परमेसर, मेंह अपन पूरा मन से तोर परसंसा करहूं;</para>
  <para style="q2" vid="PSA 86:12">मेंह तोर नांव के महिमा हमेसा करहूं।<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>काबरकि तेंह मोला अब्बड़ मया करथस;</para>
  <para style="q2" vid="PSA 86:13">तेंह मोला गहरई ले,</para>
  <para style="q2" vid="PSA 86:13">मिरतू-लोक ले बचाय हस।<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>हे परमेसर, घमंडी बिरोधीमन मोर ऊपर हमला करत हें;</para>
  <para style="q2" vid="PSA 86:14">निरदयी मनखेमन मोला मार डारे के कोसिस करत हें—</para>
  <para style="q2" vid="PSA 86:14">ओमन के मन म तोर बर कोनो आदर नइं ए।<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>पर हे परभू, तेंह दयालु अऊ अनुग्रहकारी परमेसर अस,</para>
  <para style="q2" vid="PSA 86:15">देरी से कोप करइया अस, अऊ बहुंत मया अऊ बिसवासयोग्यता ले भरे हस।<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>मोर कोति देख अऊ मोर ऊपर दया कर;</para>
  <para style="q2" vid="PSA 86:16">अपन सेवक कोति ले अपन ताकत ला देखा;</para>
  <para style="q1" vid="PSA 86:16">मोर उद्धार कर, काबरकि मेंह तोर सेवा करथंव</para>
  <para style="q2" vid="PSA 86:16">जइसे कि मोर दाई घलो करिस।<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>अपन भलई के कोनो चिनहां देखा,</para>
  <para style="q2" vid="PSA 86:17">ताकि मोर बईरीमन ओला देखें अऊ सरमिंदा होवंय,</para>
  <para style="q2" vid="PSA 86:17">काबरकि हे यहोवा, तेंह मोर मदद करे हस अऊ मोला सांति दे हस।<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="cl">भजन-संहिता 87</para>
  <para style="d">कोरह के बेटामन के एक भजन। एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>ओह पबितर पहाड़ म अपन सहर के नीव डारे हवय।<verse eid="PSA 87:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2"/>यहोवा ह सियोन के दुवारमन ला</para>
  <para style="q2" vid="PSA 87:2">याकूब के आने जम्मो निवासमन ले जादा मया करथे।<verse eid="PSA 87:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>हे परमेसर के सहर,</para>
  <para style="q2" vid="PSA 87:3">तोर बारे म महिमामय बात कहे जाथे:<verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“जऊन मन मोला मानथें, ओमन के बीच</para>
  <para style="q2" vid="PSA 87:4">मेंह राहाब<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="ft" closed="false">कविता के भासा म मिसर के नांव</char></note> अऊ बेबिलोन के बात ला लिखहूं—</para>
  <para style="q1" vid="PSA 87:4">पलिस्ती, अऊ सूर के संग कूस<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="ft" closed="false">नील के ऊपरी इलाका</char></note> के बात ला घलो लिखहूं—</para>
  <para style="q2" vid="PSA 87:4">अऊ मेंह कहिहूं, ‘येह सियोन म जनमे रिहिस।’ ”<verse eid="PSA 87:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>वास्तव म, सियोन के बारे म ये कहे जाही,</para>
  <para style="q2" vid="PSA 87:5">“येह अऊ ओह ओमा जनमे रिहिन,</para>
  <para style="q2" vid="PSA 87:5">अऊ सर्वोच्च परमेसर ह खुद ओला स्थापित करही।”<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>यहोवा ह मनखेमन के लेखा म लिखही:</para>
  <para style="q2" vid="PSA 87:6">“येह सियोन म जनमे रिहिस।”<verse eid="PSA 87:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>बाजा बजाके ओमन गाहीं,</para>
  <para style="q2" vid="PSA 87:7">“मोर पानी के जम्मो सोतामन तोर म ले निकलथें।”<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="cl">भजन-संहिता 88<note caller="+" style="f"><char style="fr" closed="false">88 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 88:1-18">88:1‑18</ref></char> ला 88:2‑19 गने गे हवय</char></note></para>
  <para style="d">एक गीत। कोरह के बेटामन के एक भजन। संगीत के निरदेसक बर। <char style="tl">महलत लीनत</char><note caller="+" style="f"><char style="fr" closed="false">88:0 </char><char style="fl" closed="false">संभवतः एक राग, “दुख के पीरा”</char></note> के मुताबिक। एजरा के बंस के हेमान के एक <char style="tl">मसकील</char><note caller="+" style="f"><char style="fr" closed="false">88:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>हे यहोवा, तेंह ओ परमेसर अस, जऊन ह मोर उद्धार करथे;</para>
  <para style="q2" vid="PSA 88:1">रात अऊ दिन मेंह तोला पुकारथंव।<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>मोर पराथना ह तोर करा हबरे;</para>
  <para style="q2" vid="PSA 88:2">मोर पुकार कोति अपन कान ला लगा।<verse eid="PSA 88:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>मेंह बहुंत समस्या म पड़े हंव</para>
  <para style="q2" vid="PSA 88:3">अऊ मोर परान ह मिरतू के लकठा म हवय।<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>मोर गनती ओमन म होवथे, जऊन मन कबर म जावथें;</para>
  <para style="q2" vid="PSA 88:4">मेंह एक निरबल मनखे सहीं हो गे हवंव।<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>मोला मरे मनखेमन के संग अलग रखे जावथे,</para>
  <para style="q2" vid="PSA 88:5">जइसे कि मारे गय मनखेमन कबर म पड़े रहिथें,</para>
  <para style="q1" vid="PSA 88:5">जेमन ला तेंह फेर सुरता नइं करस,</para>
  <para style="q2" vid="PSA 88:5">जेमन के तेंह देखरेख नइं करस।<verse eid="PSA 88:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>तेंह मोला सबले खाल्हे के खंचवा,</para>
  <para style="q2" vid="PSA 88:6">सबले जादा अंधियार वाले गहरई म रखे हस।<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>तोर कोप ह मोर ऊपर बहुंत भड़के हवय;</para>
  <para style="q2" vid="PSA 88:7">तेंह मोला अपन जम्मो लहरामन ले बियाकुल कर दे हस।<verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>तेंह मोर सबले घनिस्ट संगीमन ला मोर ले दूरिहा कर दे हस</para>
  <para style="q2" vid="PSA 88:8">अऊ ओमन बर मोला घिनौना बना दे हस।</para>
  <para style="q1" vid="PSA 88:8">मेंह कैद हो गे हंव अऊ भाग नइं सकंव;<verse eid="PSA 88:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 88:9"/>मोर आंखीमन दुख के मारे धुंधला गे हवंय।</para>
  <para style="b" vid="PSA 88:9"/>
  <para style="q1" vid="PSA 88:9">हे यहोवा, मेंह तोला हर दिन पुकारथंव;</para>
  <para style="q2" vid="PSA 88:9">मेंह तोर कोति अपन हांथ पसारथंव।<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>का मरे मनखेमन ला तेंह अपन अद्भूत काम देखाथस?</para>
  <para style="q2" vid="PSA 88:10">का ओमन मरे म ले फेर जी जाथें अऊ तोर परसंसा करथें?<verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>का कबर म तोर मया के,</para>
  <para style="q2" vid="PSA 88:11">अऊ बिनास म तोर बिसवासयोग्यता के घोसना करे जाथे?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>का तोर अद्भूत काम अंधियार के जगह,</para>
  <para style="q2" vid="PSA 88:12">या तोर धरमी काम अपमान के जगह म जाने जाथे?<verse eid="PSA 88:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>पर हे यहोवा, मेंह तोला मदद बर पुकारथंव;</para>
  <para style="q2" vid="PSA 88:13">बिहनियां मोर पराथना ह तोर करा हबरथे।<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>हे यहोवा, तेंह काबर मोला छोंड़ देथस</para>
  <para style="q2" vid="PSA 88:14">अऊ काबर अपन मुहूं ला मोर ले छुपा लेथस?<verse eid="PSA 88:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>मेंह अपन जवानी के समय ले दुख भोगे हंव अऊ मिरतू के लकठा म रहे हंव;</para>
  <para style="q2" vid="PSA 88:15">मेंह तोर आतंक ला सहे हंव अऊ मेंह निरास हंव।<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>तोर कोप ह मोर ऊपर छा गे हवय;</para>
  <para style="q2" vid="PSA 88:16">तोर आतंक ह मोला नास कर दे हवय।<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>दिन भर ओमन बाढ़ के पानी सहीं मोर चारों कोति रहिथें;</para>
  <para style="q2" vid="PSA 88:17">ओमन पूरा-पूरा मोला अपन म समा ले हवंय।<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>तेंह मोर ले मोर संगी अऊ परोसीमन ला लेय ले हस—</para>
  <para style="q2" vid="PSA 88:18">अंधियार ह मोर सबले नजदीकी संगी अय।<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="cl">भजन-संहिता 89<note caller="+" style="f"><char style="fr" closed="false">89 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 89:1-52">89:1‑52</ref></char> ला 89: 2‑53 गने गे हवय</char></note></para>
  <para style="d">एजरा के बंस के एतान के एक <char style="tl">मसकील</char><note caller="+" style="f"><char style="fr" closed="false">89:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>मेंह यहोवा के बड़े मया के हमेसा गीत गाहूं;</para>
  <para style="q2" vid="PSA 89:1">मेंह पीढ़ी-पीढ़ी तक तोर बिसवासयोग्यता के बखान</para>
  <para style="q2" vid="PSA 89:1">अपन मुहूं ले करहूं।<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>मेंह घोसना करहूं कि तोर मया ह हमेसा अटल बने रहिथे,</para>
  <para style="q2" vid="PSA 89:2">तेंह स्वरग म अपन बिसवासयोग्यता ला इस्थिर करे हस।<verse eid="PSA 89:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>तेंह कहय, “मेंह अपन चुने जन के संग एक करार करे हंव,</para>
  <para style="q2" vid="PSA 89:3">मेंह अपन सेवक दाऊद ले कसम खाय हंव,<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘मेंह तोर बंस ला हमेसा बर स्थापित करहूं</para>
  <para style="q2" vid="PSA 89:4">अऊ पीढ़ी-पीढ़ी तक तोर सिंघासन ला अटल बनाय रखहूं।’ ”<verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>हे यहोवा, स्वरग म तोर अद्भूत काम के,</para>
  <para style="q2" vid="PSA 89:5">अऊ पबितर मनखेमन के सभा म तोर बिसवासयोग्यता के परसंसा होथे।<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>काबरकि ऊपर अकास-मंडल म कोन हवय, जेकर तुलना यहोवा ले करे जा सकथे?</para>
  <para style="q2" vid="PSA 89:6">स्वरगीय जीवमन के बीच म यहोवा के सहीं कोन हवय?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>पबितर मनखेमन के परिसद म परमेसर के बहुंत भय माने जाथे;</para>
  <para style="q2" vid="PSA 89:7">ओह अपन चारों कोति रहइया जम्मो झन ले जादा अद्भूत ए।<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>हे यहोवा, सर्वसक्तिमान परमेसर, तोर सहीं कोन हवय?</para>
  <para style="q2" vid="PSA 89:8">हे यहोवा, तेंह सक्तिसाली अस, अऊ तोर बिसवासयोग्यता तोर चारों कोति रहिथे।<verse eid="PSA 89:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>उमड़त समुंदर ऊपर तेंह सासन करथस;</para>
  <para style="q2" vid="PSA 89:9">जब येकर लहरामन उठथें, त तेंह ओमन ला सांत करथस।<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>तेंह राहाब<note caller="+" style="f"><char style="fr" closed="false">89:10 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="JOB 9:13">अयू 9:13</ref>; <ref loc="JOB 26:12">26:12</ref>; <ref loc="ISA 51:9">यसा 51:9</ref></char></char></note> ला मारे गय मनखे सहीं कुचर डारय;</para>
  <para style="q2" vid="PSA 89:10">अपन सक्तिसाली हांथ ले तेंह बईरीमन ला तितिर-बितिर कर दे हस।<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>स्वरगमन तोर अंय, अऊ धरती घलो तोर अय;</para>
  <para style="q2" vid="PSA 89:11">संसार अऊ येमा के जम्मो चीज के नीव तेंह रखे हस।<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>उत्तर अऊ दक्खिन ला तेंह बनाय हस;</para>
  <para style="q2" vid="PSA 89:12">ताबोर अऊ हेरमोन पहाड़ तोर नांव के आनंद के गीत गाथें।<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>तोर बाहां म सक्ति हवय;</para>
  <para style="q2" vid="PSA 89:13">तोर हांथ ह मजबूत हवय, तोर जेवनी हांथ परबल हे।<verse eid="PSA 89:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>धरमीपन अऊ नियाय तोर सिंघासन के नीव अंय;</para>
  <para style="q2" vid="PSA 89:14">मया अऊ बिसवासयोग्यता तोर आघू-आघू चलथें।<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>हे यहोवा, धइन अंय ओमन, जऊन मन तोर जय-जयकार करई सीख गे हवंय,</para>
  <para style="q2" vid="PSA 89:15">जऊन मन तोर उपस्थिति के अंजोर म चलथें।<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>ओमन दिन भर तोर नांव म आनंद मनाथें;</para>
  <para style="q2" vid="PSA 89:16">ओमन तोर धरमीपन के आनंद मनाथें।<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>काबरकि तेंह ओमन के महिमा अऊ बल अस,</para>
  <para style="q2" vid="PSA 89:17">अऊ अपन खुसी ले हमर सींग<note caller="+" style="f"><char style="fr" closed="false">89:17 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">ह इहां बल के प्रतीक ए</char></note> ला ऊपर उठाथस।<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>वास्तव म, हमर ढाल ह यहोवा के अय,</para>
  <para style="q2" vid="PSA 89:18">हमर राजा ह इसरायल के पबितर परमेसर के अय।<verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>एक बार तें एक दरसन म गोठियाय,</para>
  <para style="q2" vid="PSA 89:19">अपन बिसवासयोग्य मनखेमन ला तेंह कहय:</para>
  <para style="q1" vid="PSA 89:19">“मेंह एक योद्धा ला बल दे हवंव;</para>
  <para style="q2" vid="PSA 89:19">मेंह मनखेमन के बीच ले एक जवान ला खड़े करे हवंव।<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>मोला मोर सेवक दाऊद मिल गे हवय;</para>
  <para style="q2" vid="PSA 89:20">अपन पबितर तेल ले मेंह ओकर अभिसेक करे हवंव।<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>मोर हांथ ह ओला बनाय रखही;</para>
  <para style="q2" vid="PSA 89:21">खचित मोर बाहां ह ओला बलवान बनाही।<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>बईरी ह ओला तंग नइं कर सकही;</para>
  <para style="q2" vid="PSA 89:22">दुस्ट ह ओला दुख नइं देय सकही।<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>मेंह ओकर बिरोधीमन ला ओकर आघू म कुचर दूहूं</para>
  <para style="q2" vid="PSA 89:23">अऊ ओकर बईरीमन ला मार डारहूं।<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>मोर न टूटनेवाला मया ओकर संग रहिही,</para>
  <para style="q2" vid="PSA 89:24">अऊ मोर नांव के जरिये ओकर सींग ह ऊपर होही।<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>मेंह समुंदर के ऊपर ओकर हांथ,</para>
  <para style="q2" vid="PSA 89:25">अऊ नदीमन के ऊपर ओकर जेवनी हांथ ला रखहूं।<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>ओह मोला पुकारके कहिही, ‘तेंह मोर ददा,</para>
  <para style="q2" vid="PSA 89:26">मोर परमेसर, मोर उद्धारकर्ता चट्टान अस।’<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>मेंह ओला मोर पहिलांत होय बर ठहिराहूं,</para>
  <para style="q2" vid="PSA 89:27">ओह धरती के राजामन म सबले ऊपर होही।<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>मेंह अपन मया ओकर ऊपर हमेसा बनाय रखहूं,</para>
  <para style="q2" vid="PSA 89:28">अऊ ओकर संग मोर करार ह कभू नइं टूटही।<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>मेंह ओकर बंस ला हमेसा बर स्थापित करहूं,</para>
  <para style="q2" vid="PSA 89:29">अऊ जब तक स्वरग हवय, तब तक ओकर सिंघासन बने रहिही।<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>“कहूं ओकर बेटामन मोर कानून ला तियाग देथें</para>
  <para style="q2" vid="PSA 89:30">अऊ मोर बिधि-बिधान म नइं चलंय,<verse eid="PSA 89:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>कहूं ओमन मोर नियम ला टोरथें,</para>
  <para style="q2" vid="PSA 89:31">अऊ मोर हुकूममन ला नइं मानंय,<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>त मेंह ओमन के पाप के दंड सोंटी ले,</para>
  <para style="q2" vid="PSA 89:32">अऊ ओमन के दुस्टता के दंड कोर्रा ले दूहूं;<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>पर मेंह अपन मया ला ओकर ऊपर ले नइं हटाहूं,</para>
  <para style="q2" vid="PSA 89:33">अऊ न ही कभू मेंह अपन बिसवासयोग्यता ला छोंड़हूं।<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>मेंह अपन करार ला नइं टोरहूं</para>
  <para style="q2" vid="PSA 89:34">या अपन कहे बात ला नइं बदलहूं।<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>जम्मो के सेति एक बार, मेंह अपन पबितरता के सपथ खाय हंव—</para>
  <para style="q2" vid="PSA 89:35">अऊ मेंह दाऊद ले लबारी नइं मारंव—<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>कि ओकर बंस हमेसा चलते रहिही</para>
  <para style="q2" vid="PSA 89:36">अऊ ओकर सिंघासन ह सूरज के सहीं मोर आघू म बने रहिही;<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>येला अकास म बिसवासयोग्य गवाह के रूप म</para>
  <para style="q2" vid="PSA 89:37">चंदा के सहीं हमेसा बर स्थापित करे जाही।”<verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>पर तेंह छोंड़ दे हस, तेंह तिरस्कार करे हस,</para>
  <para style="q2" vid="PSA 89:38">अपन अभिसिक्त जन ऊपर तेंह बहुंत गुस्सा करे हस।<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>तेंह अपन सेवक के संग करे करार ला तियाग दे हस</para>
  <para style="q2" vid="PSA 89:39">अऊ ओकर मुकुट ला धुर्रा म असुध कर दे हस।<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>तेंह ओकर जम्मो दीवार<note caller="+" style="f"><char style="fr" closed="false">89:40 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सहर के दीवार</char></note> ला गिरा दे हस</para>
  <para style="q2" vid="PSA 89:40">अऊ ओकर गढ़मन ला खंडहर बना दे हस।<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>ओ जम्मो, जऊन मन उहां ले होके जाथें, ओमन ओला लूट ले हवंय;</para>
  <para style="q2" vid="PSA 89:41">ओह अपन परोसीमन बर अपमान के चीज बन गे हवय।<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>तेंह ओकर बईरीमन के जेवनी हांथ ला उठाय हस;</para>
  <para style="q2" vid="PSA 89:42">तेंह ओकर जम्मो बईरीमन ला आनंदित करे हस।<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>वास्तव म, तेंह ओकर तलवार के धार ला मोड़ दे हस</para>
  <para style="q2" vid="PSA 89:43">अऊ ओकर लड़ई म ओकर मदद नइं करे हस।<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>तेंह ओकर सोभा के अन्त कर दे हस</para>
  <para style="q2" vid="PSA 89:44">अऊ ओकर सिंघासन ला भुइयां म गिरा दे हस।<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>तेंह ओकर जवानी के दिन ला कम कर दे हस;</para>
  <para style="q2" vid="PSA 89:45">तेंह ओला लज्जा के ओढ़नी ले ढांप दे हस।<verse eid="PSA 89:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>हे यहोवा, कब तक? का तेंह हमेसा बर अपनआप ला छिपा लेबे?</para>
  <para style="q2" vid="PSA 89:46">तोर कोप ह कब तक आगी सहीं बरत रहिही?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>सुरता कर, मोर जिनगी ह कतेक चंचल ए।</para>
  <para style="q2" vid="PSA 89:47">का बेकार म तेंह जम्मो मानव-जाति ला सिरजे हस!<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>अइसने कोन हे, जऊन ह जीयथे अऊ मिरतू ला नइं देखही,</para>
  <para style="q2" vid="PSA 89:48">या कोन ह कबर के सक्ति ले बच सकथे?<verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>हे परभू, तोर पहिले के ओ बड़े मया कहां हवय,</para>
  <para style="q2" vid="PSA 89:49">जेकर संग अपन बिसवासयोग्यता म, तेंह दाऊद ले सपथ खाय रहय?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>हे परभू, सुरता कर, तोर सेवक के कइसे हंसी उड़ाय गे हवय,</para>
  <para style="q2" vid="PSA 89:50">मेंह कइसे जम्मो आनजातमन के ताना ला अपन मन म सहत हंव,<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>हे यहोवा, ओ ताना जेकर दुवारा तोर बईरीमन हंसी उड़ाय हवंय,</para>
  <para style="q2" vid="PSA 89:51">जेकर दुवारा ओमन तोर अभिसिक्त जन के हर कदम म हंसी उड़ाय हवंय।<verse eid="PSA 89:51"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>यहोवा के परसंसा सदा-सर्वदा होवत रहय!</para>
  <para style="qc" vid="PSA 89:52">आमीन अऊ आमीन।<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">किताब IV</para>
  <para style="mr">
    <ref loc="PSA 90-106">भजन-संहिता 90–106</ref></para>
  <para style="cl">भजन-संहिता 90</para>
  <para style="d">परमेसर के जन मूसा के एक पराथना।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>हे परभू, पीढ़ी-पीढ़ी ले</para>
  <para style="q2" vid="PSA 90:1">तेंह हमर निवास स्थान बने हस।<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>येकर पहिले कि पहाड़मन बनिन</para>
  <para style="q2" vid="PSA 90:2">या तेंह जम्मो संसार के रचना करय,</para>
  <para style="q2" vid="PSA 90:2">अनादि ले अनंतकाल तक तेंहीच ह परमेसर अस।<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>तेंह मनखेमन ला ये कहिके वापिस धुर्रा म मिला देथस,</para>
  <para style="q2" vid="PSA 90:3">“हे मरनहार मनखेमन, धुर्रा म लहुंट जावव।”<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>तोर नजर म हजार साल ह अइसन ए</para>
  <para style="q2" vid="PSA 90:4">जइसन कि एक दिन, जऊन ह अभी-अभी बीते हवय,</para>
  <para style="q2" vid="PSA 90:4">या रथिया के एक पहर।<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>तभो ले तेंह मनखेमन ला मिरतू के नींद म बहा ले जाथस—</para>
  <para style="q2" vid="PSA 90:5">ओमन बिहनियां के नवां कांदी सहीं अंय:<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>जऊन ह बिहनियां निकलथे,</para>
  <para style="q2" vid="PSA 90:6">पर सांझ के येह सूखके मुरझा जाथे।<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>हमन ला तोर गुस्सा ह खा जाथे</para>
  <para style="q2" vid="PSA 90:7">अऊ तोर कोरोध ह हमन ला भयभीत करथे।<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>तेंह हमर दुस्टता ला अपन आघू म,</para>
  <para style="q2" vid="PSA 90:8">अऊ हमर गुपत म करे पाप ला अपन अंजोर म रखे हस।<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>हमर जिनगी के जम्मो दिनमन तोर कोप सहत बीत जाथें;</para>
  <para style="q2" vid="PSA 90:9">हमर सालमन बिलाप करत बीतथें।<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>यदि हमर देहें म बल हवय,</para>
  <para style="q2" vid="PSA 90:10">त हमन सत्तर या अस्सी साल जीथन;</para>
  <para style="q1" vid="PSA 90:10">तभो ले हमन जादा समय समस्या अऊ दुख म पड़े रहिथन,</para>
  <para style="q2" vid="PSA 90:10">काबरकि ये समय ह जल्दी बीत जाथे, अऊ हमन खतम हो जाथन।<verse eid="PSA 90:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>कहूं हमन सिरिप तोर कोरोध के सक्ति ला जानतेंन!</para>
  <para style="q2" vid="PSA 90:11">तोर कोप ह ओ भय के सहीं बड़े अय, जऊन ह मनखेमन के मन म तोर बर होथे।<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>हमर दिनमन ला हमन ला गने बर सिखा,</para>
  <para style="q2" vid="PSA 90:12">कि हमन बुद्धिमान हो जावन।<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>हे यहोवा, नरम हो जा! येह कब तक होही?</para>
  <para style="q2" vid="PSA 90:13">अपन सेवकमन ऊपर दया कर।<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>बिहनियां के बेरा, अपन बड़े मया ले हमन ला संतोस कर,</para>
  <para style="q2" vid="PSA 90:14">कि हमन जिनगी भर आनंद अऊ खुसी के गीत गावन।<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>जतेक दिन तक तेंह हमन ला दुख दे हस,</para>
  <para style="q2" vid="PSA 90:15">जतेक साल तक हमन समस्या म पड़े रहेंन, ओतेक समय तक हमन ला खुसी दे।<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>तोर काममन तोर सेवकमन ला,</para>
  <para style="q2" vid="PSA 90:16">अऊ तोर सोभा ह ओमन के लइकामन ऊपर दिखय।<verse eid="PSA 90:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>परभू हमर परमेसर के अनुग्रह<note caller="+" style="f"><char style="fr" closed="false">90:17 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सुघरता</char></note> हमर ऊपर बने रहय;</para>
  <para style="q2" vid="PSA 90:17">हमर बर हमर हांथ के काम ला बनाय रख—</para>
  <para style="q2" vid="PSA 90:17">हव, हमर हांथ के काम ला बनाय रख।<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="cl">भजन-संहिता 91</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>जऊन ह सर्वोच्च परमेसर के सरन म रहिही,</para>
  <para style="q2" vid="PSA 91:1">ओह सर्वसक्तिमान के छइहां म अराम करही।<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>मेंह यहोवा के बारे म कहिहूं, “ओह मोर सरन-स्थान अऊ मोर गढ़ अय।</para>
  <para style="q2" vid="PSA 91:2">मोर परमेसर, जेकर ऊपर मेंह भरोसा करथंव।”<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>खचित ओह तोला</para>
  <para style="q2" vid="PSA 91:3">चिड़ीमार के फंदा</para>
  <para style="q2" vid="PSA 91:3">अऊ घातक महामारी ले बचाही।<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>ओह अपन पांखी के खाल्हे म तोला ढांप लीही,</para>
  <para style="q2" vid="PSA 91:4">अऊ ओकर डेनामन के खाल्हे म तोला सरन मिलही;</para>
  <para style="q2" vid="PSA 91:4">ओकर बिसवासयोग्यता ह तोर ढाल अऊ झिलम होही।<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>रथिया के आतंक ले तोला डर नइं होही,</para>
  <para style="q2" vid="PSA 91:5">न ही ओ तीर ले डरबे, जेला दिनमान छोंड़े जाथे,<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>न ही ओ महामारी ले, जऊन ह छिपके पीछा करथे,</para>
  <para style="q2" vid="PSA 91:6">न ही ओ महारोग ले, जऊन ह दिन-दुपहरी म नास करथे।<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>तोर बाजू म एक हजार,</para>
  <para style="q2" vid="PSA 91:7">अऊ जेवनी हांथ कोति दस हजार गिर सकथें,</para>
  <para style="q2" vid="PSA 91:7">पर येह तोर लकठा म नइं आही।<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>तेंह अपन आंखी ले सिरिप देखत रहिबे</para>
  <para style="q2" vid="PSA 91:8">अऊ दुस्टमन के दंड ला देखबे।<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>कहूं तेंह कहिथस, “यहोवा ह मोर सरन-स्थान ए,”</para>
  <para style="q2" vid="PSA 91:9">अऊ तेंह सर्वोच्च परमेसर ला अपन निवास बनाथस,<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>त तोला कोनो हानि नइं होही,</para>
  <para style="q2" vid="PSA 91:10">अऊ तोर डेरा के लकठा म कोनो बिपत्ति नइं आही।<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>काबरकि ओह तोर बारे म अपन स्वरगदूतमन ला हुकूम दीही</para>
  <para style="q2" vid="PSA 91:11">कि ओमन हर काम म तोर रकछा करंय;<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>ओमन तोला अपन हांथ म उठा लीहीं,</para>
  <para style="q2" vid="PSA 91:12">ताकि तोर गोड़ म पथरा ले चोट झन लगय।<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>तेंह सिंह अऊ नाग सांप ला गोड़ ले कुचरबे;</para>
  <para style="q2" vid="PSA 91:13">तेंह बड़े सिंह अऊ बड़े सांप ला कुचरबे।<verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>यहोवा ह कहिथे, “काबरकि ओह<note caller="+" style="f"><char style="fr" closed="false">91:14 </char><char style="ft" closed="false">संभवतः राजा</char></note> मोर ले मया करथे, मेंह ओला छोंड़ाहूं;</para>
  <para style="q2" vid="PSA 91:14">मेंह ओला बचाहूं, काबरकि ओह मोर नांव ला मानथे।<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>ओह मोला पुकारही, अऊ मेंह ओला जबाब दूहूं;</para>
  <para style="q2" vid="PSA 91:15">संकट के बेरा म मेंह ओकर संग रहिहूं,</para>
  <para style="q2" vid="PSA 91:15">मेंह ओला छोंड़ाहूं अऊ ओला आदर दूहूं।<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>बहुंत उमर देके ओकर मन ला मेंह संतोस करहूं</para>
  <para style="q2" vid="PSA 91:16">अऊ ओला अपन उद्धार के दरसन कराहूं।”<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="cl">भजन-संहिता 92<note caller="+" style="f"><char style="fr" closed="false">92 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 92:1-15">92:1‑15</ref></char> ला 92:2‑16 गने गे हवय</char></note></para>
  <para style="d">एक भजन। बिसराम दिन बर एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>यहोवा के परसंसा करई</para>
  <para style="q2" vid="PSA 92:1">अऊ हे सर्वोच्च परमेसर, तोर नांव म बाजा बजई बने बात ए,<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>बिहनियां तोर मया</para>
  <para style="q2" vid="PSA 92:2">अऊ रथिया तोर बिसवासयोग्यता के घोसना करई,<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>दस तारवाला बाजा</para>
  <para style="q2" vid="PSA 92:3">अऊ बीना के सुघर राग बजई बने बात ए।<verse eid="PSA 92:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>काबरकि हे यहोवा, तेंह अपन काम के दुवारा मोला खुस कर देथस;</para>
  <para style="q2" vid="PSA 92:4">तोर करे गय काम के कारन मेंह आनंद के गीत गाथंव।<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>हे यहोवा, तोर काममन कतेक बड़े हवंय,</para>
  <para style="q2" vid="PSA 92:5">तोर बिचारमन कतेक गंभीर हवंय!<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>अगियानी मनखे येला नइं जानंय,</para>
  <para style="q2" vid="PSA 92:6">मुरूखमन येला नइं समझंय,<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>हालाकि दुस्ट मनखे कांदी के सहीं निकलथें</para>
  <para style="q2" vid="PSA 92:7">अऊ जम्मो दुस्ट काम करइयामन उन्नति करथें,</para>
  <para style="q2" vid="PSA 92:7">पर ओमन हमेसा बर नास हो जाहीं।<verse eid="PSA 92:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>पर हे यहोवा, तोर सदा-सर्वदा बड़ई होथे।<verse eid="PSA 92:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>काबरकि हे यहोवा, खचित तोर बईरीमन,</para>
  <para style="q2" vid="PSA 92:9">खचित तोर बईरीमन नास हो जाहीं;</para>
  <para style="q2" vid="PSA 92:9">जम्मो दुस्ट काम करइयामन तितिर-बितिर हो जाहीं।<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>तेंह मोर सींग<note caller="+" style="f"><char style="fr" closed="false">92:10 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">ह इहां ताकत के प्रतीक अय</char></note> ला जंगली सांड़ के सहीं ऊंच करे हस;</para>
  <para style="q2" vid="PSA 92:10">सुघर तेल ह मोर ऊपर रितोय गे हवय।<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>मोर आंखी ह मोर बईरीमन के पराजय ला देखे हवय,</para>
  <para style="q2" vid="PSA 92:11">मोर कान ह मोर दुस्ट बईरीमन के कोलाहल ला सुने हवय।<verse eid="PSA 92:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>धरमी मनखे ह खजूर के रूख सहीं फूलही-फरही,</para>
  <para style="q2" vid="PSA 92:12">ओमन लबानोन के देवदार सहीं बढ़हीं;<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>यहोवा के घर म रोपे जाके,</para>
  <para style="q2" vid="PSA 92:13">ओमन हमर परमेसर के अंगना म फूलहीं-फरहीं।<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>ओमन बहुंत उमर होय के बाद घलो फर दीहीं,</para>
  <para style="q2" vid="PSA 92:14">ओमन तरो-ताजा अऊ हरियर रहिहीं,<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>अऊ ये घोसना करहीं, “यहोवा ह नियायी अय;</para>
  <para style="q2" vid="PSA 92:15">ओह मोर चट्टान ए, अऊ ओमा कोनो दुस्टता नइं ए।”<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="cl">भजन-संहिता 93</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>यहोवा ह राज करथे, ओह वैभव के कपड़ा पहिरे हवय;</para>
  <para style="q2" vid="PSA 93:1">यहोवा ह वैभव के कपड़ा पहिरे हवय अऊ ताकत ले भरे हवय;</para>
  <para style="q2" vid="PSA 93:1">वास्तव म, संसार ला इस्थिर अऊ सुरकछित बनाय गे हवय।<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>तोर सिंघासन ला अनादिकाल ले स्थापित करे गीस;</para>
  <para style="q2" vid="PSA 93:2">तेंह अनंतकाल ले हस।<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>हे यहोवा, समुंदर के पानी उठे हवय,</para>
  <para style="q2" vid="PSA 93:3">समुंदर के अवाज ह उठे हवय,</para>
  <para style="q2" vid="PSA 93:3">समुंदर के भयंकर लहरामन उठे हवंय।<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>पानी के बड़े लहरामन के गरजन ले घलो सक्तिसाली,</para>
  <para style="q2" vid="PSA 93:4">समुंदर के बड़े लहरामन ले घलो सक्तिसाली—</para>
  <para style="q2" vid="PSA 93:4">ऊंचहा जगह म बिराजमान यहोवा ह सक्तिसाली ए।<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>हे यहोवा, तोर बिधिमन इस्थिर बने रहिथें,</para>
  <para style="q2" vid="PSA 93:5">पबितरता ह तोर घर ला</para>
  <para style="q2" vid="PSA 93:5">जुग-जुग तक सजाय रहिथे।<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="cl">भजन-संहिता 94</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>यहोवा ह बदला लेवइया परमेसर ए।</para>
  <para style="q2" vid="PSA 94:1">हे बदला लेवइया परमेसर, अपन चमक ला देखा।<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>हे धरती के नियाय करइया, उठ;</para>
  <para style="q2" vid="PSA 94:2">घमंडीमन ले ओमन के काम के मुताबिक बदला ले।<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>हे यहोवा, दुस्टमन कब तक,</para>
  <para style="q2" vid="PSA 94:3">ओमन कब तक आनंद मनात रहिहीं?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>ओमन हमेसा घमंड के बात करत रहिथें;</para>
  <para style="q2" vid="PSA 94:4">दुस्ट काम करइया जम्मो झन घमंड ले भरे हवंय।<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>हे यहोवा, ओमन तोर मनखेमन ला कुचरथें;</para>
  <para style="q2" vid="PSA 94:5">ओमन तोर निज भाग के मनखेमन ला सतात हवंय।<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>ओमन बिधवा अऊ परदेसी ला मार डारथें;</para>
  <para style="q2" vid="PSA 94:6">ओमन अनाथमन ला मार डारथें।<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>ओमन कहिथें, “यहोवा ह नइं देखय;</para>
  <para style="q2" vid="PSA 94:7">याकूब के परमेसर ह धियान नइं देवय।”<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>हे मनखेमन के बीच निरबुद्धि मनखेमन, तुमन धियान देवव;</para>
  <para style="q2" vid="PSA 94:8">हे मुरूख मनखेमन, तुमन कब बुद्धिमान बनहू?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>जऊन ह कान ला बनाईस, का ओह खुद नइं सुनय?</para>
  <para style="q2" vid="PSA 94:9">जऊन ह आंखी ला बनाईस, का ओह खुद नइं देखय?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>जऊन ह जाति-जाति के मनखेमन के ताड़ना करथे, का ओह दंड नइं देवय?</para>
  <para style="q2" vid="PSA 94:10">जऊन ह मानव-जाति ला सिखाथे, का ओकर करा गियान के कमी हवय?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>यहोवा ह मनखेमन के जम्मो योजना ला जानथे;</para>
  <para style="q2" vid="PSA 94:11">ओह जानथे कि ओमन बेकार अंय।<verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>हे यहोवा, धइन अय ओ, जेकर तेंह ताड़ना करथस,</para>
  <para style="q2" vid="PSA 94:12">जेला तेंह अपन कानून के बात सिखाथस;<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>समस्या के समय म तेंह ओमन ला तब तक मदद करत रहिथस,</para>
  <para style="q2" vid="PSA 94:13">जब तक कि दुस्टमन बर खंचवा नइं कोड़े जावय।<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>काबरकि यहोवा ह अपन मनखेमन ला नइं तियागही;</para>
  <para style="q2" vid="PSA 94:14">ओह अपन निज भाग ला कभू नइं छोंड़ही।<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>नियाय फेर धरमीपन के आधार म करे जाही,</para>
  <para style="q2" vid="PSA 94:15">अऊ हिरदय के जम्मो सीधवा मनखेमन येकर पाछू चलहीं।<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>दुस्टमन के बिरोध म, मोर बर कोन ठाढ़ होही?</para>
  <para style="q2" vid="PSA 94:16">दुस्ट काम करइयामन के बिरोध म, मोर कोति कोन होही?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>यदि यहोवा ह मोर मदद नइं करे होतिस,</para>
  <para style="q2" vid="PSA 94:17">त मेंह बहुंत जल्दी मिरतू के अधीन म रहितेंव।<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>जब मेंह कहेंव, “मोर गोड़ ह फिसलत हे,”</para>
  <para style="q2" vid="PSA 94:18">त हे यहोवा, तोर अटूट मया ह मोला संभालिस।<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>जब भीतरे-भीतर मेंह बहुंत बियाकुल रहेंव,</para>
  <para style="q2" vid="PSA 94:19">त तोर ढाढ़स ह मोला आनंदित करिस।<verse eid="PSA 94:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>का कोनो दुस्ट सासक ह तोर संग संधि कर सकथे—</para>
  <para style="q2" vid="PSA 94:20">एक अइसने सासक, जऊन ह अपन कानून के दुवारा दुख लानथे?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>दुस्टमन धरमी जन के बिरूध एक संग जूरथें</para>
  <para style="q2" vid="PSA 94:21">अऊ निरदोस ला मिरतू-दंड देथें।<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>पर यहोवा ह मोर गढ़ बन गे हवय,</para>
  <para style="q2" vid="PSA 94:22">अऊ ओह मोर परमेसर, मोर चट्टान ए, जेमा मेंह सरन लेथंव।<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>ओह ओमन ले ओमन के पाप के बदला लीही</para>
  <para style="q2" vid="PSA 94:23">अऊ ओमन के दुस्टता बर ओमन ला नास कर दीही;</para>
  <para style="q2" vid="PSA 94:23">यहोवा हमर परमेसर ह ओमन ला नास करही।<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="cl">भजन-संहिता 95</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>आवव, हमन यहोवा बर आनंद के गीत गावन;</para>
  <para style="q2" vid="PSA 95:1">हमन हमर उद्धार के चट्टान बर जोर से चिचियावन।<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>हमन ओकर आघू म धनबाद के संग आवन</para>
  <para style="q2" vid="PSA 95:2">अऊ बाजा बजाके अऊ गीत गाके ओकर बहुंत परसंसा करन।<verse eid="PSA 95:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>काबरकि यहोवा ह महान परमेसर ए,</para>
  <para style="q2" vid="PSA 95:3">जम्मो देवतामन ऊपर महान राजा ए।<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>ओकर हांथ म धरती के गहरई हवय,</para>
  <para style="q2" vid="PSA 95:4">अऊ पहाड़ के चोटीमन ओकर अंय।<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>समुंदर ह ओकर अय, काबरकि ओह येला बनाय हवय,</para>
  <para style="q2" vid="PSA 95:5">अऊ ओकर हांथमन सूखा भुइयां ला रचे हवंय।<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>आवव, हमन मुड़ नवाके अराधना करन,</para>
  <para style="q2" vid="PSA 95:6">हमन यहोवा हमर सिरजनहार के आघू म माड़ी टेकन;<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>काबरकि ओह हमर परमेसर ए</para>
  <para style="q2" vid="PSA 95:7">अऊ हमन ओकर चरागन के मनखे अन,</para>
  <para style="q2" vid="PSA 95:7">अऊ ओकर देखरेख म रहइया एक झुंड अन।</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q1" vid="PSA 95:7">यदि आज तुमन सिरिप ओकर ये अवाज ला सुनत हव,<verse eid="PSA 95:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8"/>“त अपन हिरदय ला कठोर झन करव, जइसे तुम्हर पुरखामन मरीबा<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">मरीबा </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">झगड़ा</char></note> म करे रिहिन,</para>
  <para style="q2" vid="PSA 95:8">जइसे कि तुमन ओ दिन सुन्ना जगह के मस्सा<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">मस्सा </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">परखई</char></note> म करे रहेव,<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="EXO 17:1-7">निर 17:1‑7</ref>; <ref loc="NUM 20:1-13">गन 20:1‑13</ref>; <ref loc="DEU 6:16">ब्यव 6:16</ref>; <ref loc="DEU 33:8">33:8</ref></char></char></note><verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>जिहां ओमन मोला परखिन;</para>
  <para style="q2" vid="PSA 95:9">ओमन मोला जांचिन, हालाकि ओमन मोर काममन ला देखे रिहिन।<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>चालीस साल तक मेंह ओ पीढ़ी के मनखेमन ले नराज रहेंव;</para>
  <para style="q2" vid="PSA 95:10">मेंह कहेंव, ‘येमन अइसे मनखे अंय, जेमन के मन ह एती-ओती होथे,</para>
  <para style="q2" vid="PSA 95:10">अऊ ओमन मोर रसता ला नइं जानंय।’<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>एकरसेति मेंह कोरोध म कसम खाके कहेंव,</para>
  <para style="q2" vid="PSA 95:11">‘ओमन ओ ठऊर<note caller="+" style="f"><char style="fr" closed="false">95:11 </char><char style="ft" closed="false">परतिगियां के देस, कनान देस</char></note> म कभू नइं जा सकहीं, जिहां मेंह ओमन ला अराम देवइया रहेंव।’ ”<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="cl">भजन-संहिता 96</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>यहोवा बर एक नवां गीत गावव;</para>
  <para style="q2" vid="PSA 96:1">हे धरती के जम्मो मनखेमन, यहोवा बर गावव।<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>यहोवा बर गावव, ओकर नांव के परसंसा करव;</para>
  <para style="q2" vid="PSA 96:2">ओकर उद्धार के सुसमाचार हर दिन सुनात रहव।<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>जाति-जाति के मनखेमन के बीच म ओकर महिमा के,</para>
  <para style="q2" vid="PSA 96:3">अऊ जम्मो मनखेमन के बीच म ओकर अद्भूत काम के बखान करव।<verse eid="PSA 96:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>काबरकि यहोवा ह महान अऊ अति परसंसा के योग्य अय;</para>
  <para style="q2" vid="PSA 96:4">ओह जम्मो देवतामन ले जादा भय के योग्य अय।<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>काबरकि जाति-जाति के जम्मो देवतामन सिरिप मूरती अंय,</para>
  <para style="q2" vid="PSA 96:5">पर यहोवा ह स्वरग ला बनाईस।<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>सोभा अऊ वैभव ओकर आघू म हवय;</para>
  <para style="q2" vid="PSA 96:6">ताकत अऊ महिमा ओकर पबितर-स्थान म हवय।<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>हे जाति-जाति के जम्मो परिवारमन, यहोवा के बखान करव,</para>
  <para style="q2" vid="PSA 96:7">यहोवा के महिमा अऊ बल के बखान करव।<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>यहोवा के नांव के मुताबिक ओकर बखान करव;</para>
  <para style="q2" vid="PSA 96:8">भेंट लेके ओकर अंगना म आवव।<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>पबितरता ले सोभायमान होके यहोवा के अराधना करव;</para>
  <para style="q2" vid="PSA 96:9">हे धरती के जम्मो मनखेमन, ओकर आघू म कांपव।<verse eid="PSA 96:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>जाति-जाति के मनखेमन के बीच म कहव, “यहोवा ह सासन करथे।”</para>
  <para style="q2" vid="PSA 96:10">संसार ला मजबूती से स्थापित करे गे हवय, येला हटाय नइं जा सकय;</para>
  <para style="q2" vid="PSA 96:10">ओह समान रूप से मनखेमन के नियाय करही।<verse eid="PSA 96:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>अकास ह आनंद मनावय, धरती ह खुस होवय;</para>
  <para style="q2" vid="PSA 96:11">समुंदर अऊ ओमा के जम्मो चीजमन गरजंय।<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>भुइयां अऊ ओमा के हर एक चीज बहुंत आनंदित होवंय;</para>
  <para style="q2" vid="PSA 96:12">जंगल के जम्मो रूखमन आनंदित होके गीत गावंय।<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>पूरा सिरिस्टी ह यहोवा के आघू म आनंद मनावय, काबरकि ओह आवथे,</para>
  <para style="q2" vid="PSA 96:13">ओह धरती के नियाय करे बर आवथे।</para>
  <para style="q1" vid="PSA 96:13">ओह धरमीपन ले संसार के</para>
  <para style="q2" vid="PSA 96:13">अऊ अपन बिसवासयोग्यता से मनखेमन के नियाय करही।<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="cl">भजन-संहिता 97</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>यहोवा ह सासन करथे, धरती ह खुस होवय;</para>
  <para style="q2" vid="PSA 97:1">दूरिहा-दूरिहा के समुंदर-तटमन आनंद मनावंय।<verse eid="PSA 97:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>बादर अऊ गहिरा अंधियार ओकर चारों कोति हवय;</para>
  <para style="q2" vid="PSA 97:2">धरमीपन अऊ नियाय ओकर सिंघासन के नीव अंय।<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>आगी ह ओकर आघू-आघू जाथे</para>
  <para style="q2" vid="PSA 97:3">अऊ ओकर बईरीमन ला चारों कोति ले भसम कर देथे।<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>ओकर बिजली ह संसार ला अंजोर कर देथे;</para>
  <para style="q2" vid="PSA 97:4">धरती ह येला देखके कांपथे।<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>पहाड़मन यहोवा के आघू म</para>
  <para style="q2" vid="PSA 97:5">याने कि जम्मो धरती के परभू के आघू म मोम के सहीं टघल जाथें।<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>अकास ह ओकर धरमीपन के बखान करथे,</para>
  <para style="q2" vid="PSA 97:6">अऊ जम्मो मनखेमन ओकर महिमा ला देखथें।<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>ओ जम्मो, जऊन मन बेकार के देवतामन के अराधना करथें,</para>
  <para style="q2" vid="PSA 97:7">अऊ जऊन मन मूरतीमन ऊपर घमंड करथें, ओमन लज्जा म पड़थें;</para>
  <para style="q2" vid="PSA 97:7">हे जम्मो देवतामन, परमेसर के अराधना करव!<verse eid="PSA 97:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>हे यहोवा, तोर नियाय के बात ला सुनके</para>
  <para style="q2" vid="PSA 97:8">सियोन ह आनंदित होथे</para>
  <para style="q2" vid="PSA 97:8">अऊ यहूदा के गांवमन खुस होथें।<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>काबरकि हे यहोवा, तेंह जम्मो धरती के ऊपर सर्वोच्च परमेसर अस;</para>
  <para style="q2" vid="PSA 97:9">तेंह जम्मो देवतामन ले बहुंत ऊपर उठाय गे हस।<verse eid="PSA 97:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>जऊन मन यहोवा ले मया करथें, ओमन बुरई ले घिन करंय,</para>
  <para style="q2" vid="PSA 97:10">काबरकि ओह अपन बिसवासयोग्य जन के परान के रकछा करथे</para>
  <para style="q2" vid="PSA 97:10">अऊ ओमन ला दुस्टमन के हांथ ले बचाथे।<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>अंजोर ह धरमी ऊपर चमकथे</para>
  <para style="q2" vid="PSA 97:11">अऊ ईमानदार मनखे के हिरदय म आनंद रहिथे।<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>हे धरमी मनखेमन, यहोवा म आनंद मनावव,</para>
  <para style="q2" vid="PSA 97:12">अऊ ओकर पबितर नांव के परसंसा करव।<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="cl">भजन-संहिता 98</para>
  <para style="d">एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>यहोवा बर एक नवां गीत गावव,</para>
  <para style="q2" vid="PSA 98:1">काबरकि ओह अद्भूत काम करे हवय;</para>
  <para style="q1" vid="PSA 98:1">ओकर जेवनी हांथ अऊ ओकर पबितर बाहां ह</para>
  <para style="q2" vid="PSA 98:1">ओकर बर उद्धार के काम करे हवय।<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>यहोवा ह जाति-जाति के मनखेमन ला अपन करे गय उद्धार ला बताय हवय</para>
  <para style="q2" vid="PSA 98:2">अऊ ओमन ऊपर अपन धरमीपन ला परगट करे हवय।<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>ओह इसरायल बर अपन मया</para>
  <para style="q2" vid="PSA 98:3">अऊ अपन बिसवासयोग्यता ला सुरता करे हवय;</para>
  <para style="q1" vid="PSA 98:3">धरती के जम्मो छोर तक मनखेमन</para>
  <para style="q2" vid="PSA 98:3">हमर परमेसर के करे गय उद्धार ला देखे हवंय।<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>हे धरती के जम्मो मनखेमन, यहोवा बर आनंद के मारे चिचियावव,</para>
  <para style="q2" vid="PSA 98:4">बाजा बजाके आनंद के गीत जोर-जोर से गावव;<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>बीना बजाके यहोवा के इस्तुति करव,</para>
  <para style="q2" vid="PSA 98:5">बीना बजाके गीत गावत ओकर इस्तुति करव,<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>तुरही अऊ नरसिंगा के ऊंचहा अवाज के संग</para>
  <para style="q2" vid="PSA 98:6">यहोवा, हमर राजा के आघू म आनंद के मारे जय-जयकार करव।<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>समुंदर, अऊ येमा के जम्मो चीज,</para>
  <para style="q2" vid="PSA 98:7">संसार, अऊ येमा रहइया जम्मो चीज जय-जयकार करंय।<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>नदीमन ताली बजावंय,</para>
  <para style="q2" vid="PSA 98:8">पहाड़मन एक संग आनंद के गीत गावंय;<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>ओमन ला यहोवा के आघू म गावन दव,</para>
  <para style="q2" vid="PSA 98:9">काबरकि ओह धरती के नियाय करे बर आथे।</para>
  <para style="q1" vid="PSA 98:9">ओह संसार के नियाय धरमीपन के संग</para>
  <para style="q2" vid="PSA 98:9">अऊ मनखेमन के नियाय बरोबरी के अधार म करही।<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="cl">भजन-संहिता 99</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>यहोवा ह सासन करथे,</para>
  <para style="q2" vid="PSA 99:1">देस-देस के मनखेमन कांपंय;</para>
  <para style="q1" vid="PSA 99:1">ओह करूबमन के बीच सिंघासन म बिराजमान होथे,</para>
  <para style="q2" vid="PSA 99:1">धरती ह डोलय।<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>सियोन म यहोवा ह महान ए;</para>
  <para style="q2" vid="PSA 99:2">ओह जम्मो देसमन के ऊपर उठाय गे हवय।<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>ओमन तोर महान अऊ अद्भूत नांव के परसंसा करंय—</para>
  <para style="q2" vid="PSA 99:3">ओह पबितर अय।<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>राजा ह सक्तिसाली हवय, ओह नियाय ले मया करथे—</para>
  <para style="q2" vid="PSA 99:4">तेंह समानता के इस्‍थापना करे हस;</para>
  <para style="q1" vid="PSA 99:4">याकूब<note caller="+" style="f"><char style="fr" closed="false">99:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">इसरायली समाज</char></note> म तेंह ओ करे हस,</para>
  <para style="q2" vid="PSA 99:4">जऊन ह नियाय-संगत अऊ सही अय।<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>यहोवा हमर परमेसर के बहुंत परसंसा करव</para>
  <para style="q2" vid="PSA 99:5">अऊ ओकर पांव के चउकी करा अराधना करव;</para>
  <para style="q2" vid="PSA 99:5">ओह पबितर ए।<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>मूसा अऊ हारून ओकर पुरोहितमन म रिहिन,</para>
  <para style="q2" vid="PSA 99:6">समूएल ह ओमन के बीच म ले रिहिस, जऊन मन ओकर नांव लेवंय;</para>
  <para style="q1" vid="PSA 99:6">ओमन यहोवा ला पुकारंय</para>
  <para style="q2" vid="PSA 99:6">अऊ ओह ओमन ला जबाब देवय।<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>ओह ओमन ले बादर के खंभा म ले बात करय;</para>
  <para style="q2" vid="PSA 99:7">ओमन ओकर दिये गय नियम अऊ बिधिमन ला मानंय।<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>यहोवा हमर परमेसर,</para>
  <para style="q2" vid="PSA 99:8">तेंह ओमन ला जबाब देय;</para>
  <para style="q1" vid="PSA 99:8">इसरायल बर तेंह छेमा करइया परमेसर रहय,</para>
  <para style="q2" vid="PSA 99:8">हालाकि तेंह ओमन के गलत काम बर दंड देय।<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>परभू हमर परमेसर के बहुंत परसंसा करव</para>
  <para style="q2" vid="PSA 99:9">अऊ ओकर पबितर पहाड़ करा अराधना करव,</para>
  <para style="q2" vid="PSA 99:9">काबरकि यहोवा हमर परमेसर ह पबितर ए।<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="cl">भजन-संहिता 100</para>
  <para style="d">धनबाद अऊ महिमा देय बर एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>हे धरती के जम्मो मनखेमन, यहोवा बर आनंद के मारे चिचियावव।<verse eid="PSA 100:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 100:2"/>खुस होके यहोवा के अराधना करव;</para>
  <para style="q2" vid="PSA 100:2">आनंद के गीत गावत ओकर आघू म आवव।<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>ये बात ला जानव कि यहोवा ही परमेसर अय।</para>
  <para style="q2" vid="PSA 100:3">ओही ह हमन ला बनाय हवय, अऊ हमन ओकरेच अन<note caller="+" style="f"><char style="fr" closed="false">100:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अपन खुद के नो हन</char></note>;</para>
  <para style="q2" vid="PSA 100:3">हमन ओकर मनखे, ओकर चरागन के भेड़ अन।<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>धनबाद करत ओकर कपाट के भीतर</para>
  <para style="q2" vid="PSA 100:4">अऊ परसंसा करत ओकर अंगना म जावव;</para>
  <para style="q2" vid="PSA 100:4">ओला धनबाद देवव अऊ ओकर नांव के महिमा करव।<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>काबरकि यहोवा ह बने अय अऊ ओकर मया हमेसा बने रहिथे;</para>
  <para style="q2" vid="PSA 100:5">ओकर बिसवासयोग्यता ह जम्मो पीढ़ी म बने रहिथे।<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="cl">भजन-संहिता 101</para>
  <para style="d">दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>मेंह तोर मया अऊ नियाय के गीत गाहूं;</para>
  <para style="q2" vid="PSA 101:1">हे यहोवा, मेंह तोर परसंसा के गीत गाहूं।<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>मेंह निरदोस जिनगी जीये बर धियान दूहूं—</para>
  <para style="q2" vid="PSA 101:2">तेंह मोर करा कब आबे?</para>
  <para style="b" vid="PSA 101:2"/>
  <para style="q1" vid="PSA 101:2">मेंह निरदोस हिरदय से</para>
  <para style="q2" vid="PSA 101:2">अपन घर के मामला म बेवहार करहूं।<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>मेंह कोनो दुस्ट काम बर</para>
  <para style="q2" vid="PSA 101:3">मंजूरी नइं दूहूं।</para>
  <para style="b" vid="PSA 101:3"/>
  <para style="q1" vid="PSA 101:3">मेंह बिसवासहीन मनखेमन के काम ले घिन करथंव;</para>
  <para style="q2" vid="PSA 101:3">अइसन काम ले मोर कोनो लेना-देना नइं होही।<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>जिद्दी सुभाव ले मेंह दूर रहिहूं;</para>
  <para style="q2" vid="PSA 101:4">दुस्ट काम ले मोर कोनो लेना-देना नइं होही।<verse eid="PSA 101:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>जऊन कोनो अपन परोसी के पाछू ओकर निन्दा करथे,</para>
  <para style="q2" vid="PSA 101:5">मेंह ओला नास कर दूहूं;</para>
  <para style="q1" vid="PSA 101:5">अहंकार ले भरे आंखीवाले अऊ घमंड ले भरे मनखे ला</para>
  <para style="q2" vid="PSA 101:5">मेंह सहन नइं करहूं।<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>मोर आंखी ह देस म बिसवासयोग्य मनखेमन ऊपर लगे रहिही,</para>
  <para style="q2" vid="PSA 101:6">ताकि ओमन मोर संग रहंय;</para>
  <para style="q1" vid="PSA 101:6">जऊन ह निरदोस जिनगी जीथे,</para>
  <para style="q2" vid="PSA 101:6">ओह मोर सेवा करही।<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>धोखाधड़ी करइया कोनो भी मनखे</para>
  <para style="q2" vid="PSA 101:7">मोर घर म नइं रहिही;</para>
  <para style="q1" vid="PSA 101:7">जऊन ह लबारी मारथे,</para>
  <para style="q2" vid="PSA 101:7">ओह मोर आघू म ठाढ़ नइं हो सकही।<verse eid="PSA 101:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>हर बिहनियां मेंह देस के</para>
  <para style="q2" vid="PSA 101:8">जम्मो दुस्टमन ला नास कर दूहूं;</para>
  <para style="q1" vid="PSA 101:8">यहोवा के सहर ले</para>
  <para style="q2" vid="PSA 101:8">मेंह हर दुस्ट मनखे ला नास कर दूहूं।<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="cl">भजन-संहिता 102<note caller="+" style="f"><char style="fr" closed="false">102 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 102:1-28">102:1‑28</ref></char> ला 102:2‑29 गने गे हवय</char></note></para>
  <para style="d">एक दुखित मनखे के पराथना, जऊन ह कमजोर हो गे हवय अऊ यहोवा के आघू म खुलके अपन मन के दुख ला रखत हे।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>हे यहोवा, मोर पराथना ला सुन;</para>
  <para style="q2" vid="PSA 102:1">मदद बर मोर गोहार ह तोर तक हबरय।<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>जब मेंह दुखित हंव,</para>
  <para style="q2" vid="PSA 102:2">त अपन मुहूं ला मोर ले झन छिपा।</para>
  <para style="q1" vid="PSA 102:2">अपन कान ला मोर कोति कर;</para>
  <para style="q2" vid="PSA 102:2">जब मेंह पुकारंव, जल्दी से मोला जबाब दे।<verse eid="PSA 102:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>काबरकि मोर जिनगी के समय ह धुआं के सहीं खतम होवत हे;</para>
  <para style="q2" vid="PSA 102:3">मोर हाड़ामन दहकत अंगरा सहीं बरत हें।<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>मोर हिरदय म रोग लगे हे अऊ कांदी सहीं मुरझा गे हवय;</para>
  <para style="q2" vid="PSA 102:4">मेंह अपन जेवन जे बर भुला जाथंव।<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>अपन पीरा म मेंह जोर-जोर से कलहरत हंव</para>
  <para style="q2" vid="PSA 102:5">अऊ सूखके चमड़ी अऊ हाड़ा हो गे हवंव।<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>मेंह सुन्ना जगह के एक उल्लू अंव,</para>
  <para style="q2" vid="PSA 102:6">खंडहर म रहइया एक उल्लू सहीं अंव।<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>मेंह पड़े-पड़े जागत रहिथंव; मेंह छानी म</para>
  <para style="q2" vid="PSA 102:7">अकेला बईठे एक चिरई सहीं हो गे हवंव।<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>दिन भर मोर बईरीमन मोला ताना मारत रहिथें;</para>
  <para style="q2" vid="PSA 102:8">जऊन मन मोला ताना मारथें, ओमन मोर नांव के उपयोग सराप दे बर करथें।<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>काबरकि राख ला मेंह खाना के रूप म खाथंव</para>
  <para style="q2" vid="PSA 102:9">अऊ आंसू ला मिलाके पानी पीथंव<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>येह तोर बड़े कोप के कारन होय हवय,</para>
  <para style="q2" vid="PSA 102:10">काबरकि तेंह मोला उठाके अलग फटिक दे हस।<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>मोर उमर ह संझा के ढरत छइहां के सहीं अय;</para>
  <para style="q2" vid="PSA 102:11">मेंह कांदी के सहीं अइला जाथंव।<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>पर हे यहोवा, तेंह सदाकाल बर बिराजमान हस;</para>
  <para style="q2" vid="PSA 102:12">तोर खियाती जम्मो पीढ़ी तक बने रहिथे।<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>तेंह उठबे अऊ सियोन ऊपर दया करबे,</para>
  <para style="q2" vid="PSA 102:13">काबरकि येह ओकर ऊपर किरपा करे के समय ए;</para>
  <para style="q2" vid="PSA 102:13">ठहिराय गे समय ह आ गे हवय।<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>काबरकि ओकर पथरामन तोर सेवकमन बर मयारू अंय;</para>
  <para style="q2" vid="PSA 102:14">ओकर धुर्रा ला ही देखके ओमन के मन म दया के भाव आ जाथे।<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>जाति-जाति के मनखेमन यहोवा के नांव के भय मानहीं,</para>
  <para style="q2" vid="PSA 102:15">धरती के जम्मो राजामन तोर महिमा के आघू म मुड़ नवाहीं।<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>काबरकि यहोवा ह सियोन ला फेर बनाही</para>
  <para style="q2" vid="PSA 102:16">अऊ अपन महिमा म परगट होही।<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>ओह गरीब-लाचार के पराथना के जबाब दीही;</para>
  <para style="q2" vid="PSA 102:17">ओह ओमन के बिनती ला तुछ नइं समझय।<verse eid="PSA 102:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>येला अवइया पीढ़ी के मनखेमन बर लिखे जावय,</para>
  <para style="q2" vid="PSA 102:18">ताकि ओ मनखे, जेमन अभी सिरजे नइं गे हवंय, ओमन यहोवा के इस्तुति करंय:<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>“यहोवा ह अपन ऊंच पबितर-स्थान ले खाल्हे देखिस,</para>
  <para style="q2" vid="PSA 102:19">स्वरग ले ओह धरती ला देखिस,<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>ताकि कैदीमन के कलहरई ला सुनय</para>
  <para style="q2" vid="PSA 102:20">अऊ मिरतू-दंड पाय मनखेमन ला छुड़ावय।”<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>ताकि जब देस-देस अऊ राज-राज के मनखेमन</para>
  <para style="q2" vid="PSA 102:21">यहोवा के अराधना करे बर जूरंय,<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>त सियोन म यहोवा के नांव के घोसना</para>
  <para style="q2" vid="PSA 102:22">अऊ यरूसलेम म ओकर परसंसा होवय।<verse eid="PSA 102:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>मोर जिनगी के यातरा म, ओह मोर बल ला टोर दीस;</para>
  <para style="q2" vid="PSA 102:23">ओह मोर उमर ला घटा दीस।<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>एकरसेति मेंह कहेंव:</para>
  <para style="q1" vid="PSA 102:24">“हे मोर परमेसर, मोर जिनगी के बीच म ले मोला झन उठा ले;</para>
  <para style="q2" vid="PSA 102:24">तोर जिनगी ह तो जम्मो पीढ़ी तक बने रहिथे।<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>सुरूआत म तेंह धरती के नीव रखे,</para>
  <para style="q2" vid="PSA 102:25">अऊ अकास ह तोर हांथ के दुवारा बनाय गे हवय।<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>ओमन तो नास हो जाहीं, पर तेंह बने रहिबे;</para>
  <para style="q2" vid="PSA 102:26">ओमन जम्मो पहिरे के कपड़ा के सहीं जुन्ना हो जाहीं।</para>
  <para style="q1" vid="PSA 102:26">कपड़ा के सहीं तेंह ओमन ला बदल देबे</para>
  <para style="q2" vid="PSA 102:26">अऊ ओमन तियाग दिये जाहीं।<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>पर तेंह वइसनेच के वइसने रहिथस,</para>
  <para style="q2" vid="PSA 102:27">अऊ तोर उमर ह कभू खतम नइं होवय।<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>तोर सेवक के लइकामन तोर आघू म रहिहीं;</para>
  <para style="q2" vid="PSA 102:28">ओमन के संतान तोर आघू म स्थापित करे जाहीं।”<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="cl">भजन-संहिता 103</para>
  <para style="d">दाऊद के भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>हे मोर मन, यहोवा के परसंसा कर;</para>
  <para style="q2" vid="PSA 103:1">अऊ जऊन कुछू मोर म हवय, ओकर पबितर नांव के परसंसा करय।<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>हे मोर मन, यहोवा के परसंसा कर,</para>
  <para style="q2" vid="PSA 103:2">अऊ ओकर कोनो उपकार ला झन भुलाबे—<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>ओह तोर जम्मो पाप ला छेमा करथे</para>
  <para style="q2" vid="PSA 103:3">अऊ तोर जम्मो बेमारी ला चंगा करथे,<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>ओह तोर जिनगी ला नास होय ले बचाथे</para>
  <para style="q2" vid="PSA 103:4">अऊ तोला मया अऊ करूना के मुकुट पहिराथे,<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>ओह बने-बने चीज के दुवारा तोर ईछा ला पूरा करथे</para>
  <para style="q2" vid="PSA 103:5">जेकर ले तोर जवानी ह गिधवा के जवानी सहीं नवां हो जाथे।<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>यहोवा ह जम्मो दुखी मनखेमन बर</para>
  <para style="q2" vid="PSA 103:6">धरमीपन अऊ नियाय के काम करथे।<verse eid="PSA 103:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>ओह मूसा ला अपन रसता</para>
  <para style="q2" vid="PSA 103:7">अऊ इसरायल के मनखेमन ला अपन काम बताईस:<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>यहोवा ह दयालु अऊ अनुग्रहकारी,</para>
  <para style="q2" vid="PSA 103:8">कोरोध करे म धीमा अऊ मया ले भरे हवय।<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>ओह हमेसा दोस नइं लगाही,</para>
  <para style="q2" vid="PSA 103:9">न ही हमेसा बर गुस्सा करही;<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>ओह हमर पाप के मुताबिक हमर ले बरताव नइं करिस</para>
  <para style="q2" vid="PSA 103:10">अऊ न ही हमर अधरम के मुताबिक हमर ले बदला लीस।<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>काबरकि अकास ह धरती ले जतेक ऊपर हे,</para>
  <para style="q2" vid="PSA 103:11">ओतेक ही ओकर मया ह ओमन बर महान ए, जऊन मन ओकर भय मानथें;<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>पूरब ले पछिम ह जतेक दूरिहा हवय,</para>
  <para style="q2" vid="PSA 103:12">ओह हमर अपराध ला ओतेक दूरिहा हमर ले कर दे हवय।<verse eid="PSA 103:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>जइसे एक ददा ह अपन लइकामन ऊपर दया करथे,</para>
  <para style="q2" vid="PSA 103:13">वइसे ही यहोवा ह ओमन ऊपर दया करथे, जऊन मन ओकर भय मानथें;<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>काबरकि ओह जानथे कि हमन कइसे बनाय जाथन,</para>
  <para style="q2" vid="PSA 103:14">ओला सुरता रहिथे कि हमन धुर्रा अन।<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>मनखे के जिनगी ह कांदी सहीं होथे,</para>
  <para style="q2" vid="PSA 103:15">ओमन खेत के फूल सहीं फूलथें;<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>अऊ जब ओकर ऊपर हवा चलथे, त ओह नइं ठहिरय,</para>
  <para style="q2" vid="PSA 103:16">अऊ ओकर जगह ह ओला फेर सुरता नइं रखय।<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>पर अनंतकाल ले अनंतकाल तक</para>
  <para style="q2" vid="PSA 103:17">यहोवा के मया ओकर भय मनइयामन ऊपर,</para>
  <para style="q2" vid="PSA 103:17">अऊ ओकर धरमीपन ओमन के लइकामन के लइकामन ऊपर बने रहिथे—<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>याने कि ओमन ऊपर जऊन मन ओकर करार के पालन करथें</para>
  <para style="q2" vid="PSA 103:18">अऊ ओकर नियम ला माने बर सुरता करथें।<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>यहोवा ह अपन सिंघासन ला स्वरग म स्थापित करे हवय,</para>
  <para style="q2" vid="PSA 103:19">अऊ ओकर राज ह जम्मो सिरिस्टी ऊपर चलथे।<verse eid="PSA 103:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>हे ओकर स्वरगदूतमन, यहोवा के परसंसा करव,</para>
  <para style="q2" vid="PSA 103:20">तुमन, जऊन मन सक्तिसाली अव अऊ ओकर हुकूम ला मानथव,</para>
  <para style="q2" vid="PSA 103:20">तुमन, जऊन मन ओकर बात ला मानथव।<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>हे ओकर जम्मो स्वरग के जीवमन, हे ओकर सेवकमन,</para>
  <para style="q2" vid="PSA 103:21">तुमन जऊन मन ओकर ईछा ला पूरा करथव, यहोवा के परसंसा करव।<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>हे ओकर जम्मो सिरिस्टी, ओकर राज म हर जगह</para>
  <para style="q2" vid="PSA 103:22">यहोवा के परसंसा करव।</para>
  <para style="b" vid="PSA 103:22"/>
  <para style="q1" vid="PSA 103:22">हे मोर मन, यहोवा के परसंसा कर।<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="cl">भजन-संहिता 104</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>हे मोर मन, यहोवा के परसंसा कर।</para>
  <para style="b" vid="PSA 104:1"/>
  <para style="q1" vid="PSA 104:1">हे यहोवा मोर परमेसर, तेंह बहुंत महान अस;</para>
  <para style="q2" vid="PSA 104:1">तेंह सोभा अऊ गौरव के कपड़ा पहिरे हस।<verse eid="PSA 104:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>यहोवा ह अपनआप ला एक कपड़ा के सहीं अंजोर ले लपेटे रहिथे;</para>
  <para style="q2" vid="PSA 104:2">ओह अकास ला एक तम्बू के सहीं तानथे<verse eid="PSA 104:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 104:3"/>अऊ अपन ऊपर के कमरा के मियारमन ला ओमन के पानी म रखथे।</para>
  <para style="q1" vid="PSA 104:3">ओह बादर ला अपन रथ बनाथे</para>
  <para style="q2" vid="PSA 104:3">अऊ हवा के डेना म सवारी करथे।<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>ओह हवा ला अपन संदेसिया<note caller="+" style="f"><char style="fr" closed="false">104:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">स्वरगदूत</char></note></para>
  <para style="q2" vid="PSA 104:4">अऊ आगी के जुवालामन ला अपन सेवक बनाथे।<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>ओह धरती ला ओकर नीव म इस्थिर करथे;</para>
  <para style="q2" vid="PSA 104:5">येला कभू भी हटाय नइं जा सकय।<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>तेंह येला एक कपड़ा ढांपे सहीं गहिरा समुंदर ले ढांप दे हस;</para>
  <para style="q2" vid="PSA 104:6">पानी ह पहाड़मन ले ऊपर ठहर गीस।<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>पर तोर डांटे ले पानी ह भाग गीस,</para>
  <para style="q2" vid="PSA 104:7">तोर गरजन के अवाज ले ओमन उड़िया गीन;<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>ओमन पहाड़मन के ऊपर बहे लगिन,</para>
  <para style="q2" vid="PSA 104:8">ओमन घाटीमन के खाल्हे म गीन,</para>
  <para style="q2" vid="PSA 104:8">ओ जगह जेला तेंह ओमन बर ठहिराय रहय।<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>तेंह एक सीमना तय करय, जेला ओमन लांघ नइं सकंय;</para>
  <para style="q2" vid="PSA 104:9">ओमन फेर कभू धरती ला नइं ढांपहीं।<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>तेंह घाटीमन ले पानी के धारा निकालथस;</para>
  <para style="q2" vid="PSA 104:10">अऊ ये पानी के धारा पहाड़मन के बीच ले बहथे।<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>ओमन भुइयां के जम्मो पसुमन ला पानी देथें;</para>
  <para style="q2" vid="PSA 104:11">जंगली गदहामन अपन पीयास बुझाथें।<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>अकास के चिरईमन पानी के तीर म अपन खोंधरा बनाथें;</para>
  <para style="q2" vid="PSA 104:12">ओमन रूख के डारामन के बीच म गाथें।<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>ओह अपन ऊपरी कमरा ले पहाड़मन ऊपर पानी गिराथे;</para>
  <para style="q2" vid="PSA 104:13">भुइयां ह ओकर काम के फर ले संतुस्ट होथे।<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>ओह पसुमन बर कांदी उगाथे,</para>
  <para style="q2" vid="PSA 104:14">अऊ मनखेमन के लुए-काटे बर पऊधा लगाथे—</para>
  <para style="q2" vid="PSA 104:14">जेकर से धरती ले जेवन के परबंध होथे:<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>अंगूर के मंद, जेह मनखे के मन ला खुसी देथे,</para>
  <para style="q2" vid="PSA 104:15">तेल, जेकर से ओमन के चेहरा ह चमकथे,</para>
  <para style="q2" vid="PSA 104:15">अऊ रोटी, जेह ओमन के जिनगी ला बनाय रखथे।<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>यहोवा के रूखमन ला</para>
  <para style="q2" vid="PSA 104:16">याने कि ओकर लगाय लबानोन के देवदारमन ला बहुंत पानी मिलथे।<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>उहां चिरईमन अपन खोंधरा बनाथें;</para>
  <para style="q2" vid="PSA 104:17">बगुला के घर सनोवर के रूख म होथे।<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>ऊंच पहाड़मन जंगली छेरीमन बर होथें;</para>
  <para style="q2" vid="PSA 104:18">करारदार चट्टानमन बिज्जूमन के सरन-स्थान होथें।<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>ओह अलग-अलग मौसम ला बताय बर चंदा ला बनाईस,</para>
  <para style="q2" vid="PSA 104:19">अऊ सूरज ह जानथे कि कब बुड़ना हे।<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>तेंह अंधियार लानथस, तब रथिया होथे,</para>
  <para style="q2" vid="PSA 104:20">अऊ जम्मो जंगली जानवरमन चुपेचाप निकलथें।<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>सिंहमन अपन सिकार बर गरजथें</para>
  <para style="q2" vid="PSA 104:21">अऊ परमेसर ले अपन आहार मांगथें।<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>सूरज ह निकलथे, अऊ ओमन चुपेचाप चले जाथें;</para>
  <para style="q2" vid="PSA 104:22">ओमन लहुंटके अपन मांद म लेट जाथें।<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>तब मनखेमन अपन-अपन काम म,</para>
  <para style="q2" vid="PSA 104:23">अऊ सांझ होवत तक मेहनत करे बर बाहिर निकलथें।<verse eid="PSA 104:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>हे यहोवा, तोर काममन बहुंते हवंय!</para>
  <para style="q2" vid="PSA 104:24">अपन बुद्धि ले तेंह ओ जम्मो ला बनाय;</para>
  <para style="q2" vid="PSA 104:24">धरती ह तोर जीव-जन्तुमन ले भरे हवय।<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>समुंदर हवय, बहुंत बड़े अऊ लम्बा अऊ चौड़ा,</para>
  <para style="q2" vid="PSA 104:25">गनती के बाहिर जीवमन ले भरे—</para>
  <para style="q2" vid="PSA 104:25">छोटे अऊ बड़े दूनों जीयत चीजमन ले।<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>उहां पानी जहाजमन आथें-जाथें,</para>
  <para style="q2" vid="PSA 104:26">अऊ लिबयातान, जेला तेंह उहां खेले बर बनाय हस।<verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>जम्मो जीवमन तोर कोति ताकथें</para>
  <para style="q2" vid="PSA 104:27">कि समय म ओमन ला ओमन के जेवन मिलय।<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>जब तेंह ओमन ला जेवन देथस,</para>
  <para style="q2" vid="PSA 104:28">त ओमन येला इकट्ठा कर लेथें;</para>
  <para style="q1" vid="PSA 104:28">जब तेंह अपन हांथ खोलथस,</para>
  <para style="q2" vid="PSA 104:28">त ओमन बने चीजमन के दुवारा संतुस्ट होथें।<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>जब तेंह अपन मुहूं ला छिपा लेथस,</para>
  <para style="q2" vid="PSA 104:29">त ओमन भयभीत हो जाथें;</para>
  <para style="q1" vid="PSA 104:29">जब तेंह ओमन के सांस बंद कर देथस,</para>
  <para style="q2" vid="PSA 104:29">त ओमन मर जाथें अऊ माटी म मिल जाथें।<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>जब तेंह अपन आतमा ला भेजथस,</para>
  <para style="q2" vid="PSA 104:30">त ओमन बनाय जाथें,</para>
  <para style="q2" vid="PSA 104:30">अऊ तेंह धरती के रूप ला पहिले सहीं कर देथस।<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>यहोवा के महिमा ह सदाकाल तक बने रहय;</para>
  <para style="q2" vid="PSA 104:31">यहोवा ह अपन काम म आनंदित होवय—<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>जब ओह धरती ला देखथे, त धरती ह कांपथे,</para>
  <para style="q2" vid="PSA 104:32">ओह पहाड़मन ला छूथे, त ओमन ले कुहरा निकलथे।<verse eid="PSA 104:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>मेंह अपन जिनगी भर यहोवा के गीत गाहूं;</para>
  <para style="q2" vid="PSA 104:33">जब तक मेंह जीयत हंव, मेंह अपन परमेसर के परसंसा के गीत गाहूं।<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>जइसे कि मेंह यहोवा म आनंदित रहिथंव,</para>
  <para style="q2" vid="PSA 104:34">त मोर मनन-चिंतन ह ओला खुसी देवय।<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>पर पापीमन धरती ले मिट जावंय</para>
  <para style="q2" vid="PSA 104:35">अऊ दुस्ट मनखेमन खतम हो जावंय।</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">हे मोर मन, यहोवा के परसंसा कर।</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">यहोवा के परसंसा कर।<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="cl">भजन-संहिता 105</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>यहोवा के परसंसा करव, ओकर नांव के घोसना करव;</para>
  <para style="q2" vid="PSA 105:1">जाति-जाति के मनखेमन के बीच म ओकर करे गे काम ला बतावव।<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>ओकर गीत गावव, ओकर परसंसा के गीत गावव;</para>
  <para style="q2" vid="PSA 105:2">ओकर जम्मो अद्भूत काम के बखान करव।<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>ओकर पबितर नांव के महिमा होवय;</para>
  <para style="q2" vid="PSA 105:3">जऊन मन यहोवा के खोज करथें, ओमन के मन आनंदित होवय।<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>यहोवा अऊ ओकर बल के खोज म रहव;</para>
  <para style="q2" vid="PSA 105:4">हमेसा ओकर दरसन के खोज म रहव।<verse eid="PSA 105:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>ओकर करे गे अद्भूत काम,</para>
  <para style="q2" vid="PSA 105:5">ओकर चमतकार, अऊ ओकर दिये गय नियाय ला सुरता करव,<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>हे ओकर सेवक, अब्राहम के संतानमन,</para>
  <para style="q2" vid="PSA 105:6">हे ओकर चुने गय मनखे, याकूब के लइकामन।<verse eid="PSA 105:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>ओह यहोवा हमर परमेसर ए;</para>
  <para style="q2" vid="PSA 105:7">जम्मो धरती म ओकर नियाय हवय।<verse eid="PSA 105:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>ओह अपन करे गे करार,</para>
  <para style="q2" vid="PSA 105:8">हजार पीढ़ी के मनखेमन बर करे गे वायदा,<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>अब्राहम के संग करे गे करार,</para>
  <para style="q2" vid="PSA 105:9">अऊ इसहाक के संग खाय गे सपथ ला सदाकाल बर सुरता रखथे।<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>ओह येला याकूब के संग एक बिधि के रूप म,</para>
  <para style="q2" vid="PSA 105:10">इसरायल के संग हमेसा के एक करार के रूप म ये कहिके मजबूत करिस:<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>“तोला मेंह कनान देस दूहूं,</para>
  <para style="q2" vid="PSA 105:11">एक निज भाग के रूप म तोला ओह मिलही।”<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>जब ओमन गनती म थोरकन ही रिहिन,</para>
  <para style="q2" vid="PSA 105:12">वास्तव म थोरकन रिहिन, अऊ ओ देस म अजनबी रिहिन,<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>ओमन एक जाति ले आने जाति,</para>
  <para style="q2" vid="PSA 105:13">अऊ एक राज ले दूसर राज म भटकत रिहिन।<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>त ओह कोनो ला ओमन ला सताय नइं दीस;</para>
  <para style="q2" vid="PSA 105:14">ओमन के हित म, ओह राजामन ला दबकारिस:<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“मोर अभिसिक्त मनखेमन ला झन छुवव;</para>
  <para style="q2" vid="PSA 105:15">मोर अगमजानीमन के कुछू हानि झन करव।”<verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>ओह ओ देस म अकाल लानिस</para>
  <para style="q2" vid="PSA 105:16">अऊ ओमन के जम्मो भोजन के परबंध करई ला नास कर दीस;<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>अऊ ओह ओमन के आघू एक मनखे यूसुफ ला पठोईस,</para>
  <para style="q2" vid="PSA 105:17">जेला एक गुलाम के रूप म बेच दिये गे रिहिस।<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>ओमन बेड़ी डालके ओकर गोड़ ला चोट पहुंचाईन,</para>
  <para style="q2" vid="PSA 105:18">ओकर गरदन ला लोहा ले जकड़िन,<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>जब तक कि ओकर कहे गे बात पूरा नइं होईस,</para>
  <para style="q2" vid="PSA 105:19">जब तक कि यहोवा के बचन ह ओकर बात ला सही साबित नइं करिस।<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>राजा ह मनखे पठोके ओला छोंड़ दीस,</para>
  <para style="q2" vid="PSA 105:20">मनखेमन के सासक ह ओला मुक्त कर दीस।<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>ओह ओला अपन घर के परधान,</para>
  <para style="q2" vid="PSA 105:21">अऊ अपन जम्मो चीज के ऊपर सासक बनाईस,<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>ताकि ओह ओकर हाकिममन ला अपन ईछा के मुताबिक हुकूम देवय</para>
  <para style="q2" vid="PSA 105:22">अऊ ओकर अगुवामन ला बुद्धि के बात सिखावय।<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>तब इसरायल ह मिसर देस म आईस;</para>
  <para style="q2" vid="PSA 105:23">याकूब ह हाम<note caller="+" style="f"><char style="fr" closed="false">105:23 </char><char style="fq" closed="false">हाम </char><char style="ft" closed="false">ह मिसर देस के एक आने नांव ए</char></note> के देस म एक परदेसी के रूप म रहे लगिस।<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>यहोवा ह अपन मनखेमन ला गनती म बहुंत बढ़ाईस;</para>
  <para style="q2" vid="PSA 105:24">ओह ओमन ला ओमन के बईरीमन बर गनती म बहुंत कर दीस,<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>ओह मिसरीमन के मन ला अइसे कर दीस कि ओमन ओकर मनखेमन ले घिन करे लगिन,</para>
  <para style="q2" vid="PSA 105:25">अऊ ओकर सेवकमन के बिरूध सडयंत्र करे लगिन।<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>ओह अपन सेवक मूसा ला,</para>
  <para style="q2" vid="PSA 105:26">अऊ हारून ला पठोईस, जेमन ला ओह चुने रिहिस।<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>ओमन मिसरीमन के बीच म ओकर अद्भूत चिनहां,</para>
  <para style="q2" vid="PSA 105:27">अऊ हाम के देस म अद्भूत काम देखाईन।<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>ओह अंधियार पठोके देस ला अंधियार कर दीस</para>
  <para style="q2" vid="PSA 105:28">काबरकि ओमन ओकर बचन के पालन नइं करिन।<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>ओह ओमन के पानी ला लहू म बदल दीस,</para>
  <para style="q2" vid="PSA 105:29">जेकर से ओमन के मछरीमन मर गीन।<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>ओमन के देस ह मेचकामन ले भर गीस,</para>
  <para style="q2" vid="PSA 105:30">अऊ ये मेचकामन ओमन के सासकमन के सोए के कमरामन तक चल दीन।<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>ओह हुकूम दीस अऊ ओमन के देस म उड़नेवाला कीरामन के दल,</para>
  <para style="q2" vid="PSA 105:31">अऊ छोटे कीरामन आ गीन।<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>ओह ओमन के बारिस ला करा म बदल दीस,</para>
  <para style="q2" vid="PSA 105:32">अऊ पूरा देस म बिजली चमके लगिस;<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>ओह ओमन के अंगूर के नार अऊ अंजीर के रूखमन ला गिरा दीस</para>
  <para style="q2" vid="PSA 105:33">अऊ ओमन के देस के रूखमन ला चकनाचूर कर दीस।<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>ओह हुकूम दीस, अऊ फांफा,</para>
  <para style="q2" vid="PSA 105:34">अऊ अनगिनत कीरामन आ गीन;<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>ओमन मिसरीमन के देस के जम्मो हरियर चीज,</para>
  <para style="q2" vid="PSA 105:35">अऊ ओमन के भुइयां के ऊपज ला खा डारिन।<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>तब ओह ओमन के देस म जम्मो पहिलांत,</para>
  <para style="q2" vid="PSA 105:36">ओमन के मरदानगी के जम्मो पहिला फर ला मार डारिस।<verse eid="PSA 105:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>ओह सोन अऊ चांदी ले लादके इसरायल ला बाहिर निकाल ले आईस,</para>
  <para style="q2" vid="PSA 105:37">अऊ ओमन के गोत्रमन ले कोनो नइं लड़खड़ाईन।<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>जब ओमन गीन, त मिसर देस के मनखेमन खुस होईन,</para>
  <para style="q2" vid="PSA 105:38">काबरकि ओमन ऊपर इसरायल के भय छा गे रिहिस।<verse eid="PSA 105:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>ओह ढकना के रूप म एक बादर ला फईला दीस,</para>
  <para style="q2" vid="PSA 105:39">अऊ रथिया के बेरा अंजोर देय बर आगी दीस।<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>ओमन मांस के मांग करिन, अऊ ओह ओमन बर बटेर ले आईस;</para>
  <para style="q2" vid="PSA 105:40">ओह ओमन ला स्वरग के रोटी पेट भरके खवाईस।<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>ओह चट्टान ला खोलके ओमा ले पानी बहाईस;</para>
  <para style="q2" vid="PSA 105:41">अऊ येह निरजन भुइयां म नदी सहीं बहे लगिस।<verse eid="PSA 105:41"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>काबरकि ओह अपन सेवक अब्राहम ला दिये गय</para>
  <para style="q2" vid="PSA 105:42">पबितर परतिगियां ला सुरता करिस।<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>ओह अपन मनखेमन ला आनंद के संग,</para>
  <para style="q2" vid="PSA 105:43">अपन चुने गय मनखेमन ला आनंद के जयकार के संग निकाल लानिस;<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>ओह जाति-जाति के मनखेमन के देस ओमन ला दे दीस,</para>
  <para style="q2" vid="PSA 105:44">अऊ जेकर बर आने मन मेहनत करे रिहिन, ओकर ओमन उत्तराधिकारी हो गीन—<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>ताकि ओमन ओकर नियममन के पालन करंय</para>
  <para style="q2" vid="PSA 105:45">अऊ ओकर कानून ला मानंय।</para>
  <para style="b" vid="PSA 105:45"/>
  <para style="q1" vid="PSA 105:45">यहोवा के परसंसा होवय।<note caller="+" style="f"><char style="fr" closed="false">105:45 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">हलिलूयाह</char></note><verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="cl">भजन-संहिता 106</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>यहोवा के परसंसा होवय।</para>
  <para style="b" vid="PSA 106:1"/>
  <para style="q1" vid="PSA 106:1">यहोवा ला धनबाद देवव, काबरकि ओह बने अय;</para>
  <para style="q2" vid="PSA 106:1">ओकर मया हमेसा बने रहिथे।<verse eid="PSA 106:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>कोन ह यहोवा के महान काममन के घोसना कर सकथे</para>
  <para style="q2" vid="PSA 106:2">या कोन ह ओकर परसंसा के पूरा घोसना कर सकथे?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>धइन अंय ओमन, जऊन मन नियाय के संग काम करथें,</para>
  <para style="q2" vid="PSA 106:3">जऊन मन हमेसा ओ काम करथें, जऊन ह सही अय।<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>हे यहोवा, जब तेंह अपन मनखेमन ऊपर किरपा करथस, त मोला सुरता रखबे,</para>
  <para style="q2" vid="PSA 106:4">जब तेंह ओमन के उद्धार करथस, त मोर मदद करबे,<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>ताकि मेंह तोर चुने गय मनखेमन के उन्नति के आनंद उठावंव,</para>
  <para style="q2" vid="PSA 106:5">ताकि तोर मनखेमन के आनंद म भागी हो सकंव</para>
  <para style="q2" vid="PSA 106:5">अऊ परसंसा देय म तोर निज भाग के संग सामिल हो सकंव।<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>हमन हमर पुरखामन सहीं पाप करे हन;</para>
  <para style="q2" vid="PSA 106:6">हमन गलत काम करे हन अऊ दुस्टता करे हन।<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>जब हमर पुरखामन मिसर देस म रिहिन,</para>
  <para style="q2" vid="PSA 106:7">तब ओमन तोर चमतकार के काम ऊपर धियान नइं दीन;</para>
  <para style="q1" vid="PSA 106:7">ओमन तोर बहुंत दया के काममन ला सुरता नइं करिन,</para>
  <para style="q2" vid="PSA 106:7">अऊ ओमन समुंदर, लाल-समुंदर के तीर म बिदरोह करिन।<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>तभो ले ओह अपन नांव के हित म ओमन ला बचाईस,</para>
  <para style="q2" vid="PSA 106:8">अऊ अपन बहुंत सामर्थ ला देखाईस।<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>ओह लाल-समुंदर ला डांटिस, अऊ ओह सूख गीस;</para>
  <para style="q2" vid="PSA 106:9">ओह ओमन ला निरजन जगह म ले जावत सहीं गहरई म ले लेय गीस।<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>ओह ओमन ला बिरोधीमन के हांथ ले बचाईस;</para>
  <para style="q2" vid="PSA 106:10">अऊ ओमन ला बईरीमन के हांथ ले छुड़ाईस।<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>ओमन के बईरीमन पानी म बुड़ गीन;</para>
  <para style="q2" vid="PSA 106:11">ओमा ले एको झन घलो नइं बांचिन।<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>तब ओमन ओकर परतिगियांमन ऊपर बिसवास करिन</para>
  <para style="q2" vid="PSA 106:12">अऊ ओकर परसंसा के गीत गाईन।<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>पर ओमन बहुंत जल्दी ओकर काममन ला भुला गीन</para>
  <para style="q2" vid="PSA 106:13">अऊ ओकर योजना ला जाने बर इंतजार नइं करिन।<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>निरजन जगह म ओमन अपन लालसा ला रखिन;</para>
  <para style="q2" vid="PSA 106:14">सुन्ना जगह म ओमन परमेसर ला परखिन।<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>तब ओह ओमन के मांगे गय चीज ला दीस,</para>
  <para style="q2" vid="PSA 106:15">पर ओमन के बीच म एक बिनास करइया बेमारी भेजिस।<verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>डेरा म ओमन मूसा अऊ ओ हारून ले जलन करिन,</para>
  <para style="q2" vid="PSA 106:16">जऊन ह यहोवा के दुवारा पबितर करे गे रिहिस।<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>धरती ह फटिस अऊ दातान ला लील लीस;</para>
  <para style="q2" vid="PSA 106:17">येह अबीराम के दल ला दफना दीस।<note caller="+" style="f"><char style="fr" closed="false">106:17 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="NUM 16:1-35">गन 16:1‑35</ref></char></char></note><verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>आगी ह ओमन के पाछू चलइयामन के बीच गिरिस;</para>
  <para style="q2" vid="PSA 106:18">आगी ह दुस्टमन ला भसम कर दीस।<verse eid="PSA 106:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>होरेब पहाड़ म ओमन एक बछवा के मूरती बनाईन</para>
  <para style="q2" vid="PSA 106:19">अऊ धातु ले गढ़े एक मूरती के अराधना करिन।<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>ओमन अपन महिमामय परमेसर के बदले</para>
  <para style="q2" vid="PSA 106:20">एक ठन बईला के मूरती ला रखिन, जऊन ह कि घांस चरथे।<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>ओमन ओ परमेसर ला बिसरा दीन, जऊन ह ओमन ला बचाय रिहिस,</para>
  <para style="q2" vid="PSA 106:21">जऊन ह मिसर देस म बड़े-बड़े काम करे रिहिस,<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>हाम के देस म चमतकार</para>
  <para style="q2" vid="PSA 106:22">अऊ लाल-समुंदर के तीर म अद्भूत काम करे रिहिस।<note caller="+" style="f"><char style="fr" closed="false">106:22 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="EXO 32:1-14">निर 32:1‑14</ref></char></char></note><verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>एकरसेति परमेसर ह कहिस कि ओह ओमन ला नास कर दीही—</para>
  <para style="q2" vid="PSA 106:23">का ओकर चुने जन मूसा ह</para>
  <para style="q1" vid="PSA 106:23">ओकर कोप ला ठंडा करे बर अऊ ओमन ला नास होय ले बचाय बर</para>
  <para style="q2" vid="PSA 106:23">ओकर आघू दरार म ठाढ़ नइं होईस।<verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>तब ओमन मनभावन देस ला तुछ समझिन;</para>
  <para style="q2" vid="PSA 106:24">ओमन ओकर परतिगियां ऊपर बिसवास नइं करिन।<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>ओमन अपन तम्बू म कुड़कुड़ाईन</para>
  <para style="q2" vid="PSA 106:25">अऊ यहोवा के बात नइं मानिन।<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>एकरसेति ओह हांथ उठाके कसम खाईस</para>
  <para style="q2" vid="PSA 106:26">कि ओह ओमन ला निरजन जगह म नास कर दीही,<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>ओमन के संतानमन ला जाति-जाति के मनखेमन के बीच म गिरा दीही</para>
  <para style="q2" vid="PSA 106:27">अऊ ओमन ला देसमन म तितिर-बितिर कर दीही।<verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>ओमन बाल-पेओर देवता ला माने लगिन</para>
  <para style="q2" vid="PSA 106:28">अऊ निरजीव देवतामन ला चघाय गे बलिदानमन ला खाय लगिन;<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>ओमन अपन दुस्ट काममन के दुवारा यहोवा के कोरोध ला भड़काईन,</para>
  <para style="q2" vid="PSA 106:29">अऊ ओमन के बीच म एक महामारी फईल गीस।<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>पर पीनहास ह ठाढ़ होईस अऊ ओमन बर बिनती करिस,</para>
  <para style="q2" vid="PSA 106:30">अऊ महामारी ह खतम हो गीस।<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>येह ओकर बर अवइया पीढ़ी-पीढ़ी के मनखेमन बर</para>
  <para style="q2" vid="PSA 106:31">धरमीपन गने गीस।<verse eid="PSA 106:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>मरीबा के पानी के तीर म घलो ओमन यहोवा के कोरोध ला भड़काईन,</para>
  <para style="q2" vid="PSA 106:32">अऊ ओमन के कारन मूसा ऊपर संकट आईस;<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>काबरकि ओमन परमेसर के आतमा के बिरूध बिदरोह करिन,</para>
  <para style="q2" vid="PSA 106:33">अऊ उतावलापन के बात मूसा के मुहूं ले निकलिस।<verse eid="PSA 106:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>जइसे कि यहोवा ह ओमन ला हुकूम दे रिहिस</para>
  <para style="q2" vid="PSA 106:34">ओमन मनखेमन ला नास नइं करिन,<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>पर ओमन आने जाति के मनखेमन ले मिल गीन</para>
  <para style="q2" vid="PSA 106:35">अऊ ओमन के रीति-रिवाज ला अपना लीन।<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>ओमन आने जाति के मूरतीमन के पूजा करिन,</para>
  <para style="q2" vid="PSA 106:36">जऊन ह ओमन बर एक फांदा बन गीस।<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>ओमन अपन बेटा-बेटीमन ला</para>
  <para style="q2" vid="PSA 106:37">झूठ-मूठ के देवतामन ला बलिदान करिन।<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>ओमन अपन निरदोस बेटा-बेटीमन</para>
  <para style="q2" vid="PSA 106:38">के खून बहाईन,</para>
  <para style="q1" vid="PSA 106:38">जेमन ला ओमन कनान के मूरतीमन म बलि चघाईन,</para>
  <para style="q2" vid="PSA 106:38">अऊ ओमन के खून ले देस ह अपबितर हो गीस।<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>ओमन अपन काम के दुवारा अपनआप ला असुध करिन;</para>
  <para style="q2" vid="PSA 106:39">अपन काम के दुवारा अपनआप ले बेभिचार<note caller="+" style="f"><char style="fr" closed="false">106:39 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मूरती-पूजा</char></note> करिन।<verse eid="PSA 106:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>एकरसेति यहोवा ह अपन मनखेमन ले गुस्सा करिस</para>
  <para style="q2" vid="PSA 106:40">अऊ अपन निज भाग ले घिन करे लगिस।<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>ओह ओमन ला आने जाति के मनखेमन के हांथ म कर दीस,</para>
  <para style="q2" vid="PSA 106:41">अऊ ओमन के बईरीमन ओमन के ऊपर राज करिन।<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>ओमन के बईरीमन ओमन ऊपर अतियाचार करिन</para>
  <para style="q2" vid="PSA 106:42">अऊ ओमन ला अपन अधिकार म कर लीन।<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>कतको बार परमेसर ह ओमन ला छोंड़ाईस,</para>
  <para style="q2" vid="PSA 106:43">पर ओमन ओकर बिरूध बिदरोह करिन</para>
  <para style="q2" vid="PSA 106:43">अऊ ओमन पाप म नास होवत गीन।<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>तभो ले ओह ओमन के संकट म ओमन ऊपर धियान दीस</para>
  <para style="q2" vid="PSA 106:44">जब भी ओह ओमन के पुकार ला सुनिस;<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>ओमन के हित म ओह अपन करार ला सुरता करिस</para>
  <para style="q2" vid="PSA 106:45">अऊ अपन बड़े मया के कारन ओह नरम पड़ गीस।<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>जऊन मन ओमन ला बंधुवा बनाय रिहिन,</para>
  <para style="q2" vid="PSA 106:46">ओमन के मन म ओह ओमन बर दया पईदा करिस।<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>हे यहोवा हमर परमेसर, हमन ला बचा,</para>
  <para style="q2" vid="PSA 106:47">अऊ हमन ला जाति-जाति के मनखेमन ले इकट्ठा कर,</para>
  <para style="q1" vid="PSA 106:47">ताकि हमन तोर पबितर नांव ला धनबाद देवन</para>
  <para style="q2" vid="PSA 106:47">अऊ तोर परसंसा म बड़ई करन।<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>यहोवा, इसरायल के परमेसर के परसंसा</para>
  <para style="q2" vid="PSA 106:48">आदिकाल ले अनंतकाल तक होवय।</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">जम्मो मनखेमन कहंय, “आमीन!”</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">यहोवा के परसंसा होवय।<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">किताब V</para>
  <para style="mr">
    <ref loc="PSA 107-150">भजन-संहिता 107–150</ref></para>
  <para style="cl">भजन-संहिता 107</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>यहोवा ला धनबाद देवव, काबरकि ओह बने अय;</para>
  <para style="q2" vid="PSA 107:1">ओकर मया हमेसा बने रहिथे।<verse eid="PSA 107:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>यहोवा के दुवारा छोंड़ाय गय मनखेमन ये बात कहंय—</para>
  <para style="q2" vid="PSA 107:2">जेमन ला ओह बईरीमन के हांथ ले छोंड़ाय हवय,<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>जेमन ला ओह देस-देस ले,</para>
  <para style="q2" vid="PSA 107:3">पूरब अऊ पछिम ले, उत्तर अऊ दक्खिन ले इकट्ठा करे हवय।<note caller="+" style="f"><char style="fr" closed="false">107:3 </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">उत्तर अऊ </char><char style="fqa" closed="false">समुंदर</char></note><verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>कुछू झन निरजन प्रदेस के बेकार जगह म भटकिन,</para>
  <para style="q2" vid="PSA 107:4">ओमन ला कोनो सहर जाय के रसता नइं मिलिस, जिहां ओमन बस जावंय।<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>ओमन भूखन अऊ पीयासन रिहिन,</para>
  <para style="q2" vid="PSA 107:5">अऊ ओमन के जिनगी कम होवत गीस।<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>तब ओमन अपन संकट के बेरा म यहोवा ला पुकारिन,</para>
  <para style="q2" vid="PSA 107:6">अऊ ओह ओमन ला ओमन के संकट ले बचाईस।<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>ओह ओमन ला एक सीधा रसता ले एक सहर म ले गीस</para>
  <para style="q2" vid="PSA 107:7">जिहां ओमन रह सकंय।<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>ओमन यहोवा के अटूट मया अऊ मानव-जाति बर करे गे अद्भूत काम बर</para>
  <para style="q2" vid="PSA 107:8">ओला धनबाद देवंय,<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>काबरकि ओह पीयासन के पीयास बुझाथे</para>
  <para style="q2" vid="PSA 107:9">अऊ भूखन ला बने चीजमन ले संतोस करथे।<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>कुछू मन अंधियार, घोर अंधियार म बईठिन,</para>
  <para style="q2" vid="PSA 107:10">कैदीमन लोहा के संकली म बंधे दुख झेलत रिहिन,<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>काबरकि ओमन परमेसर के हुकूम के बिरूध चलिन</para>
  <para style="q2" vid="PSA 107:11">अऊ सर्वोच्च परमेसर के योजनामन ला तुछ समझिन।<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>एकरसेति ओह ओमन ला बहुंत मेहनत के काम म लगाईस;</para>
  <para style="q2" vid="PSA 107:12">ओमन लड़खड़ाईन, अऊ ओमन के मदद करे बर कोनो नइं रिहिस।<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>तब ओमन अपन संकट के बेरा यहोवा ला पुकारिन,</para>
  <para style="q2" vid="PSA 107:13">अऊ ओह ओमन ला ओमन के संकट ले बचाईस।<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>ओह ओमन ला अंधियार, घिटके अंधियार ले बाहिर निकालिस,</para>
  <para style="q2" vid="PSA 107:14">अऊ ओमन के बेड़ीमन ला टोर डारिस।<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>ओमन यहोवा ला ओकर अटूट मया बर धनबाद देवंय</para>
  <para style="q2" vid="PSA 107:15">अऊ मानव-जाति बर करे गे ओकर अद्भूत काम बर धनबाद देवंय,<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>काबरकि ओह कांसा के दुवारमन ला टोर देथे</para>
  <para style="q2" vid="PSA 107:16">अऊ लोहा के छड़मन ला काट डारथे।<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>कुछू जन अपन बिदरोही काम के कारन मुरूख बन गीन</para>
  <para style="q2" vid="PSA 107:17">अऊ अपन अपराध के कारन दुख म पड़िन।<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>ओमन ला जम्मो किसम के जेवन ले अरूचि हो गीस</para>
  <para style="q2" vid="PSA 107:18">अऊ ओमन मिरतू के दुवार म हबर गीन।<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>तब ओमन अपन संकट म यहोवा ला पुकारिन,</para>
  <para style="q2" vid="PSA 107:19">अऊ ओह ओमन ला ओमन के संकट ले बचाईस।<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>ओह अपन बचन के दुवारा ओमन ला चंगा करिस;</para>
  <para style="q2" vid="PSA 107:20">ओह ओमन ला मरे ले बचाईस।<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>ओमन यहोवा के अटूट मया</para>
  <para style="q2" vid="PSA 107:21">अऊ मानव-जाति बर करे ओकर अद्भूत काम बर ओला धनबाद देवंय।<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>ओमन धनबाद के बलिदान चघावंय</para>
  <para style="q2" vid="PSA 107:22">अऊ आनंद के गीत गाय के दुवारा ओकर काममन ला बतावंय।<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>कुछू मनखेमन पानी जहाज म समुंदर म गीन;</para>
  <para style="q2" vid="PSA 107:23">ओमन समुंदर म होके बेपार करत रिहिन।<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>ओमन यहोवा के काममन ला,</para>
  <para style="q2" vid="PSA 107:24">गहिरा समुंदर म करे गय ओकर अद्भूत काममन ला देखिन।<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>काबरकि ओकर कहे ले आंधी चलिस</para>
  <para style="q2" vid="PSA 107:25">जेकर ले समुंदर म ऊंचहा-ऊंचहा लहरा उठिस।<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>ओमन अकास तक ऊपर उठिन अऊ खाल्हे गहरई तक गीन;</para>
  <para style="q2" vid="PSA 107:26">अपन जोखिम म ओमन के हिम्मत खतम होवत रिहिस।<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>ओमन मतवारमन सहीं चक्कर खावत रिहिन अऊ लड़खड़ावत रिहिन;</para>
  <para style="q2" vid="PSA 107:27">ओमन के बुद्धि काम नइं करत रिहिस।<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>तब ओमन अपन संकट म यहोवा ला पुकारिन,</para>
  <para style="q2" vid="PSA 107:28">अऊ ओह ओमन ला ओमन के संकट ले बाहिर निकालिस।<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>ओह आंधी ला सांत कर दीस;</para>
  <para style="q2" vid="PSA 107:29">समुंदर के लहरामन थम गीन।<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>लहरामन के सांत होय ले ओमन खुस होईन,</para>
  <para style="q2" vid="PSA 107:30">अऊ ओह ओमन ला ओमन के मनचाहा बंदरगाह म ले गीस।<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>ओमन यहोवा ला ओकर अटूट मया</para>
  <para style="q2" vid="PSA 107:31">अऊ मानव-जाति बर करे ओकर अद्भूत काम बर धनबाद देवंय।<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>ओमन मनखेमन के सभा म ओकर नांव ला ऊंचहा करंय</para>
  <para style="q2" vid="PSA 107:32">अऊ अगुवामन के सभा म ओकर परसंसा करंय।<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>उहां रहइया मनखेमन के दुस्टता के कारन</para>
  <para style="q2" vid="PSA 107:33">ओह नदीमन ला निरजन भुइयां,<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>पानी के सोतामन ला सूखा भुइयां,</para>
  <para style="q2" vid="PSA 107:34">अऊ फलदार भुइयां ला नूनवाले बंजर भुइयां म बदल दीस।<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>ओह निरजन भुइयां ला पानी के तरिया</para>
  <para style="q2" vid="PSA 107:35">अऊ सूखा भुइयां ला पानी के बहत सोतामन म बदल दीस;<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>उहां ओह भूखा मनखेमन ला रहे बर लानिस,</para>
  <para style="q2" vid="PSA 107:36">अऊ ओमन एक सहर बनाईन जिहां ओमन रह सकंय।<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>ओमन खेतमन ला बोईन अऊ अंगूर के बारी लगाईन</para>
  <para style="q2" vid="PSA 107:37">जेमा ले बने फसल मिलिस;<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>ओह ओमन ला आसीस दीस अऊ ओमन के संखिया बहुंत हो गीस,</para>
  <para style="q2" vid="PSA 107:38">अऊ ओह ओमन के पसुमन के संखिया ला घलो घटे नइं दीस।<verse eid="PSA 107:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>तब ओमन के संखिया घटे लगिस, अऊ सतावा,</para>
  <para style="q2" vid="PSA 107:39">बिपत्ति अऊ दुख के दुवारा ओमन नम्र करे गीन;<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>जऊन ह परभावसाली मनखेमन के अपमान करथे,</para>
  <para style="q2" vid="PSA 107:40">ओह ओमन ला बिगर रसतावाले जंगली भुइयां म भटकाथे।<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>पर ओह जरूरतमंद मनखेमन ला ओमन के दुख ले निकालथे</para>
  <para style="q2" vid="PSA 107:41">अऊ ओमन के परिवार ला पसुमन के झुंड सहीं बढ़ाथे।<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>सीधवा मनखेमन देखके आनंद मनाथें,</para>
  <para style="q2" vid="PSA 107:42">पर जम्मो दुस्ट मनखेमन अपन मुहूं बंद रखथें।<verse eid="PSA 107:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>जऊन ह बुद्धिमान ए, ओह ये बातमन ऊपर धियान देवय</para>
  <para style="q2" vid="PSA 107:43">अऊ यहोवा के मया के काममन ऊपर बिचार करय।<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="cl">भजन-संहिता 108<note caller="+" style="f"><char style="fr" closed="false">108 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 108:1-13">108:1‑13</ref></char> ला 108:2‑14 गने गे हवय</char></note></para>
  <para style="d">एक गीत। दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>हे परमेसर, मोर मन ह अटल हवय;</para>
  <para style="q2" vid="PSA 108:1">मेंह अपन पूरा आतमा ले गीत गाहूं अऊ बाजा बजाहूं।<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>हे बीना अऊ सारंगी, जागव!</para>
  <para style="q2" vid="PSA 108:2">मेंह बड़े बिहनियां ला जगाहूं।<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>हे यहोवा, मेंह जाति-जाति के मनखेमन के बीच म तोर परसंसा करहूं;</para>
  <para style="q2" vid="PSA 108:3">मेंह मनखेमन के बीच म तोर गीत गाहूं।<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>काबरकि तोर मया ह अतेक महान ए कि ओह स्वरग ले घलो ऊंच हवय;</para>
  <para style="q2" vid="PSA 108:4">तोर बिसवासयोग्यता ह अकास तक हबरत हवय।<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>हे परमेसर, तोर महिमा ह स्वरगमन ले घलो ऊपर होवय;</para>
  <para style="q2" vid="PSA 108:5">तोर महिमा ह जम्मो धरती ऊपर होवय।<verse eid="PSA 108:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>अपन जेवनी हांथ उठाके हमन ला बचा अऊ हमर मदद कर,</para>
  <para style="q2" vid="PSA 108:6">ताकि जऊन मन तोर ले मया करथें, ओमन छोंड़ाय जावंय।<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>परमेसर ह अपन पबितर-स्थान ले कहे हवय:</para>
  <para style="q2" vid="PSA 108:7">“जीत के खुसी म, मेंह सकेम ला बांट दूहूं</para>
  <para style="q2" vid="PSA 108:7">अऊ सुक्कोत के घाटी ला नापहूं।<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>गिलाद ह मोर ए, मनस्से ह घलो मोर ए;</para>
  <para style="q2" vid="PSA 108:8">एपरैम ह मोर मुड़ के टोप ए,</para>
  <para style="q2" vid="PSA 108:8">यहूदा ह मोर राजदंड ए।<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>मोआब ह मोर हांथ-मुहूं धोए के बरतन ए,</para>
  <para style="q2" vid="PSA 108:9">एदोम ऊपर मेंह अपन पनही ला उछालहूं;</para>
  <para style="q2" vid="PSA 108:9">पलिस्ती ऊपर मेंह जीत के खुसी म चिचियाहूं।”<verse eid="PSA 108:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>कोन ह मोला गढ़वाले सहर म लानही?</para>
  <para style="q2" vid="PSA 108:10">कोन ह मोला एदोम देस ले जाही?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>हे परमेसर, का ये तें नो हस, तें जऊन ह हमन ला अस्वीकार करे हस</para>
  <para style="q2" vid="PSA 108:11">अऊ अब हमर सेना के संग नइं जावस?<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>बईरीमन के बिरूध हमर मदद कर,</para>
  <para style="q2" vid="PSA 108:12">काबरकि मनखे के दिये मदद ह बेकार ए।<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>परमेसर के मदद ले ही हमन बिजयी होबो,</para>
  <para style="q2" vid="PSA 108:13">अऊ ओह हमर बईरीमन ला कुचर दीही।<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="cl">भजन-संहिता 109</para>
  <para style="d">संगीत के निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>हे मोर परमेसर, तें जेकर मेंह परसंसा करथंव,</para>
  <para style="q2" vid="PSA 109:1">चुपेचाप झन रह,<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>काबरकि दुस्ट अऊ धोखा देवइया मनखेमन</para>
  <para style="q2" vid="PSA 109:2">मोर बिरूध म गोठियावत हवंय;</para>
  <para style="q2" vid="PSA 109:2">ओमन मोर बिरूध लबारी बात कहत हवंय।<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>घिनौना बचन ले ओमन मोला घेरत हवंय;</para>
  <para style="q2" vid="PSA 109:3">ओमन बिगर कारन के मोर ऊपर हमला करथें।<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>ओमन के संग मेंह संगी के बरताव करंय, पर बदला म ओमन मोर ऊपर दोस लगावत हें,</para>
  <para style="q2" vid="PSA 109:4">पर मेंह पराथना करत रहइया मनखे अंव।<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>ओमन मोर भलई के बदले मोर संग बुरई करथें,</para>
  <para style="q2" vid="PSA 109:5">अऊ संगी बरताव के बदले मोर ले घिन करथें।<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>मोर बईरी के बिरोध करे बर कोनो दुस्ट मनखे ला ठहिरा दे;</para>
  <para style="q2" vid="PSA 109:6">ओकर जेवनी हांथ कोति एक दोस लगइया ठाढ़ होवय।<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>जब ओकर नियाय करे जावय, त ओह अपराधी ठहिरय,</para>
  <para style="q2" vid="PSA 109:7">अऊ पराथनामन ओला दोसी ठहिरावंय।<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>ओकर उमर ह थोरकन दिन के होवय;</para>
  <para style="q2" vid="PSA 109:8">ओकर अगुवई के पद ला कोनो अऊ ले लेवय।<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>ओकर लइकामन अनाथ हो जावंय</para>
  <para style="q2" vid="PSA 109:9">अऊ ओकर घरवाली ह बिधवा हो जावय।<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>ओकर लइकामन एती-ओती घुमत भिखारी हो जावंय;</para>
  <para style="q2" vid="PSA 109:10">ओमन ला ओमन के उजाड़ घर ले भगा दिये जावय।<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>साहूकार ह ओकर जम्मो चीज ला जपत कर ले;</para>
  <para style="q2" vid="PSA 109:11">अजनबीमन ओकर मेहनत के फर ला लूट लेवंय।<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>ओकर ऊपर कोनो दया झन देखावय</para>
  <para style="q2" vid="PSA 109:12">या ओकर अनाथ लइकामन ऊपर तरस झन खावय।<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>ओकर संतानमन खतम हो जावंय,</para>
  <para style="q2" vid="PSA 109:13">अगला पीढ़ी ले ओमन के नामोनिसान मिट जावय।<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>यहोवा के आघू म ओकर पुरखामन के दुस्टता ला लाने जावय;</para>
  <para style="q2" vid="PSA 109:14">ओकर दाई के पाप ला कभू झन मिटाय जावय।<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>ओमन के पापमन यहोवा के आघू म हमेसा बने रहंय,</para>
  <para style="q2" vid="PSA 109:15">ताकि ओह ओमन के नांव धरती ले मिटा देवय।<verse eid="PSA 109:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>काबरकि ओ दुस्ट ह कभू दया करे के बात नइं सोचिस,</para>
  <para style="q2" vid="PSA 109:16">पर गरीब अऊ जरूरतमंद अऊ दुखी मनखेमन ला</para>
  <para style="q2" vid="PSA 109:16">पीछा करके मार डारिस।<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>सराप देवई ओला बहुंत बने लगिस—</para>
  <para style="q2" vid="PSA 109:17">ओ सराप ह लहुंटके ओहीच ला लगय।</para>
  <para style="q1" vid="PSA 109:17">ओला आसीस म कोनो खुसी नइं मिलिस—</para>
  <para style="q2" vid="PSA 109:17">येह ओकर ले बहुंत दूरिहा रहय।<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>सराप देवई ओकर बर कपड़ा पहिरे सहीं हो गीस;</para>
  <para style="q2" vid="PSA 109:18">येह ओकर देहें म पानी हमाय सहीं,</para>
  <para style="q2" vid="PSA 109:18">अऊ ओकर हाड़ामन म तेल सहीं हो गीस।<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>येह ओकर देहें म ओढ़ना ओढ़े सहीं,</para>
  <para style="q2" vid="PSA 109:19">अऊ ओकर कनिहां म हमेसा एक कमरपट्टा बांधे सहीं होवय।<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>मोर ऊपर दोस लगइयामन ला, मोर बुरई करइयामन ला</para>
  <para style="q2" vid="PSA 109:20">यहोवा ले येहीच बदला मिलय।<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>पर हे परमपरधान यहोवा,</para>
  <para style="q2" vid="PSA 109:21">अपन नांव के हित म मोर मदद कर;</para>
  <para style="q2" vid="PSA 109:21">अपन मया के भलई के कारन मोला छुटकारा दे।<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>काबरकि मेंह गरीब अऊ जरूरतमंद अंव,</para>
  <para style="q2" vid="PSA 109:22">अऊ मोर भीतर म मोर हिरदय ला चोट लगे हवय।<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>मेंह सांझ के छइहां सहीं खतम होवत हंव;</para>
  <para style="q2" vid="PSA 109:23">मोला फांफा सहीं झटकार दिये गे हवय।<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>उपास करत मोर माड़ीमन दुरबल होवत हें;</para>
  <para style="q2" vid="PSA 109:24">मोर देहें ह पातर अऊ कमजोर हो गे हवय।<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>मेंह अपन दोस लगइयामन बर हंसी के पात्र हो गे हवंव;</para>
  <para style="q2" vid="PSA 109:25">जब ओमन मोला देखथें, त ओमन अपन मुड़ हलाथें।<verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>हे यहोवा मोर परमेसर, मोर मदद कर;</para>
  <para style="q2" vid="PSA 109:26">अपन अटूट मया के मुताबिक मोर उद्धार कर।<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>ओमन जानंय कि एकर पाछू तोर हांथ हवय,</para>
  <para style="q2" vid="PSA 109:27">अऊ ये कि हे यहोवा, येला तेंह करे हस।<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>जब ओमन सराप देवंय, त तें आसीस दे;</para>
  <para style="q2" vid="PSA 109:28">जऊन मन मोर ऊपर हमला करथें, ओमन सरमिंदा होवंय,</para>
  <para style="q2" vid="PSA 109:28">पर तोर सेवक ह आनंद मनावय।<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>मोर ऊपर दोस लगइयामन ला कलंक के कपड़ा पहिराय जावय</para>
  <para style="q2" vid="PSA 109:29">अऊ ओढ़ना लपेटे सहीं ओमन लज्जा म लपेटे जावंय।<verse eid="PSA 109:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>अपन मुहूं ले मेंह यहोवा के बहुंत धनबाद करहूं;</para>
  <para style="q2" vid="PSA 109:30">अराधना करइयामन के बड़े भीड़ म मेंह ओकर परसंसा करहूं।<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>काबरकि ओह जरूरतमंद के जेवनी हांथ कोति ठाढ़ होथे,</para>
  <para style="q2" vid="PSA 109:31">ताकि ओह ओमन के जिनगी ला ओमन ले बचावय, जेमन ओमन ला अपराधी ठहिराहीं।<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="cl">भजन-संहिता 110</para>
  <para style="d">दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>यहोवा ह मोर परभू ले कहिथे:</para>
  <para style="b" vid="PSA 110:1"/>
  <para style="q1" vid="PSA 110:1">“मोर जेवनी हांथ कोति बईठ</para>
  <para style="q2" vid="PSA 110:1">जब तक कि मेंह तोर बईरीमन ला</para>
  <para style="q2" vid="PSA 110:1">तोर गोड़ रखे के एक चउकी नइं बना देवंव।”<verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>यहोवा ह तोर सक्तिसाली राजदंड ला सियोन ले ये कहिके बढ़ाही,</para>
  <para style="q2" vid="PSA 110:2">“अपन बईरीमन के बीच म सासन कर!”<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>तोर सेना ह तोर लड़ई के दिन म</para>
  <para style="q2" vid="PSA 110:3">अपन ईछा ले तोर संग चलही।</para>
  <para style="q1" vid="PSA 110:3">पबितर सोभा ले सजके तोर जवानमन,</para>
  <para style="q2" vid="PSA 110:3">बिहनियां के गरभ ले निकले ओस</para>
  <para style="q2" vid="PSA 110:3">के सहीं तोर करा आहीं।<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>यहोवा ह कसम खाय हवय</para>
  <para style="q2" vid="PSA 110:4">अऊ ओह अपन मन ला नइं बदलय:</para>
  <para style="q1" vid="PSA 110:4">“तेंह मलकिसिदक के रीति म,</para>
  <para style="q2" vid="PSA 110:4">सदाकाल बर एक पुरोहित अस।”<verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>परभू ह तोर जेवनी हांथ कोति हवय;</para>
  <para style="q2" vid="PSA 110:5">ओह अपन कोप के दिन म राजामन ला कुचर दीही।<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>मरे मनखेमन के ढेर लगाके अऊ जम्मो धरती के सासन करइयामन ला कुचरके</para>
  <para style="q2" vid="PSA 110:6">ओह जाति-जाति के मनखेमन के नियाय करही।<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>डहार म रेंगत ओह<note caller="+" style="f"><char style="fr" closed="false">110:7 </char><char style="ft" closed="false">संभवतः </char><char style="fqa" closed="false">राजा</char></note> झरना के पानी पीही,</para>
  <para style="q2" vid="PSA 110:7">अऊ ये किसम ले अपन मुड़ ला ऊंच करही।<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="cl">भजन-संहिता 111</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>यहोवा के परसंसा करव।<note caller="+" style="f"><char style="fr" closed="false">111:1 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">हलिलूयाह</char></note></para>
  <para style="b" vid="PSA 111:1"/>
  <para style="q1" vid="PSA 111:1">मेंह सीधवा मनखेमन के मंडली म अऊ सभा म</para>
  <para style="q2" vid="PSA 111:1">अपन पूरा मन से यहोवा के परसंसा करहूं।<verse eid="PSA 111:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>यहोवा के काममन महान एं;</para>
  <para style="q2" vid="PSA 111:2">जऊन मन ओ काममन ले खुस होथें, ओमन ओ काममन के ऊपर बिचार करथें।<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>ओकर काममन महिमामय अऊ सानदार अंय,</para>
  <para style="q2" vid="PSA 111:3">अऊ ओकर धरमीपन हमेसा बने रहिथे।<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>ओह अपन अद्भूत काममन के सुरता कराय हवय;</para>
  <para style="q2" vid="PSA 111:4">यहोवा ह अनुग्रहकारी अऊ दयालु अय।<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>ओह ओमन ला जेवन देथे, जेमन ओकर भय मानथें;</para>
  <para style="q2" vid="PSA 111:5">ओह अपन करार ला हमेसा सुरता रखथे।<verse eid="PSA 111:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>ओह दिगर जाति के मनखेमन के भुइयां अपन मनखेमन ला देके</para>
  <para style="q2" vid="PSA 111:6">अपन काम के सक्ति ला देखाय हवय।<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>ओकर हांथ के काममन बिसवासयोग्य अऊ नियाय के अंय;</para>
  <para style="q2" vid="PSA 111:7">ओकर जम्मो नियममन बिसवासयोग्य अंय।<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>ओमन सदा-सर्वदा अटल रहिहीं,</para>
  <para style="q2" vid="PSA 111:8">ये कानूनमन बिसवासयोग्यता अऊ ईमानदारी से बनाय गे हवंय।<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>ओह अपन मनखेमन ला पाप ले छुटकारा दे हवय;</para>
  <para style="q2" vid="PSA 111:9">ओह अपन करार ला हमेसा बर ठहिराय हवय—</para>
  <para style="q2" vid="PSA 111:9">ओकर नांव पबितर अऊ अद्भूत अय।<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>यहोवा के भय मनई बुद्धि के सुरूआत ए;</para>
  <para style="q2" vid="PSA 111:10">ओ जम्मो, जऊन मन ओकर नियममन ला मानथें, ओमन अपन म सही समझ रखथें।</para>
  <para style="q2" vid="PSA 111:10">ओकर महिमा सदाकाल तक होवत रहय।<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="cl">भजन-संहिता 112</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>यहोवा के परसंसा करव।</para>
  <para style="b" vid="PSA 112:1"/>
  <para style="q1" vid="PSA 112:1">धइन अंय ओमन, जऊन मन यहोवा के भय मानथें,</para>
  <para style="q2" vid="PSA 112:1">जऊन मन ओकर हुकूम के पालन करे म बहुंत खुस होथें।<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>ओमन के लइकामन देस म सक्तिसाली होहीं;</para>
  <para style="q2" vid="PSA 112:2">ईमानदार मनखे के पीढ़ी ला आसीस मिलही।<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>ओमन के घर म धन अऊ सम्पन्नता होही,</para>
  <para style="q2" vid="PSA 112:3">अऊ ओमन के धरमीपन ह हमेसा बने रहिही।<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>ईमानदार मनखे बर अंधियार म घलो अंजोर निकलथे,</para>
  <para style="q2" vid="PSA 112:4">ओमन बर घलो, जऊन मन अनुग्रहकारी अऊ दयालु अऊ धरमी अंय।<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>ओमन के भलई होही, जऊन मन उदार मन के अंय अऊ खुले मन से उधार देथें,</para>
  <para style="q2" vid="PSA 112:5">जऊन मन अपन काम म नियाय के बरताव करथें।<verse eid="PSA 112:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>खचित धरमी ह कभू नइं डगमगाही;</para>
  <para style="q2" vid="PSA 112:6">ओमन ला हमेसा सुरता करे जाही।<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>ओमन खराप संदेस सुनके भयभीत नइं होहीं;</para>
  <para style="q2" vid="PSA 112:7">यहोवा ऊपर भरोसा रखत ओमन के हिरदय ह इस्थिर रहिथे।<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>ओमन के हिरदय ह सुरकछित हवय, ओमन ला कोनो किसम के भय नइं होवय;</para>
  <para style="q2" vid="PSA 112:8">आखिरी म ओमन अपन बईरीमन ऊपर बिजयी होके देखहीं।<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>ओमन गरीबमन ला दिल खोलके दान दे हवंय,</para>
  <para style="q2" vid="PSA 112:9">ओमन के धरमीपन ह सदाकाल तक बने रहिथे;</para>
  <para style="q2" vid="PSA 112:9">ओमन के सींग ला<note caller="+" style="f"><char style="fr" closed="false">112:9 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">ह इहां </char><char style="fqa" closed="false">परतिस्ठा </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सम्मान </char><char style="ft" closed="false">के प्रतीक अय</char></note> आदर म ऊंच करे जाही।<verse eid="PSA 112:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>दुस्टमन येला देखके कुढ़हीं,</para>
  <para style="q2" vid="PSA 112:10">ओमन अपन दांत पीसहीं अऊ बरबाद हो जाहीं;</para>
  <para style="q2" vid="PSA 112:10">दुस्टमन के लालसा ह पूरा नइं होही।<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="cl">भजन-संहिता 113</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>यहोवा के परसंसा करव।<note caller="+" style="f"><char style="fr" closed="false">113:1 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">हलिलूयाह</char></note></para>
  <para style="b" vid="PSA 113:1"/>
  <para style="q1" vid="PSA 113:1">हे यहोवा के सेवकमन, तुमन ओकर परसंसा करव;</para>
  <para style="q2" vid="PSA 113:1">यहोवा के नांव के परसंसा करव।<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>यहोवा के नांव के परसंसा होवय,</para>
  <para style="q2" vid="PSA 113:2">अब अऊ हमेसा-हमेसा बर ओकर परसंसा होवय।<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>उदयाचल ले लेके अस्ताचल तक</para>
  <para style="q2" vid="PSA 113:3">यहोवा के परसंसा होवय।<verse eid="PSA 113:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>यहोवा ला जम्मो जाति के ऊपर उठाय जाथे,</para>
  <para style="q2" vid="PSA 113:4">ओकर महिमा अकास ले घलो ऊंच हवय।<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>यहोवा हमर परमेसर सहीं कोन हे,</para>
  <para style="q2" vid="PSA 113:5">जऊन ह कि ऊंच म बिराजमान हवय,<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>जऊन ह झुकके</para>
  <para style="q2" vid="PSA 113:6">अकास अऊ धरती ला देखथे?<verse eid="PSA 113:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>ओह गरीब ला धुर्रा ले उठाथे</para>
  <para style="q2" vid="PSA 113:7">अऊ राख के कुढ़ा ले जरूरतमंद ला ऊपर करथे;<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>ओह ओमन ला हाकिममन के संग,</para>
  <para style="q2" vid="PSA 113:8">अपन मनखेमन के हाकिममन संग बईठाथे।<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>ओह बांझ माईलोगन ला ओकर घर म अइसे बसाथे,</para>
  <para style="q2" vid="PSA 113:9">जइसे लइकामन के खुसी ले भरे एक दाई ला।</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q1" vid="PSA 113:9">यहोवा के परसंसा होवय।<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="cl">भजन-संहिता 114</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>जब इसरायलीमन मिसर देस ले बाहिर निकलिन,</para>
  <para style="q2" vid="PSA 114:1">जब याकूब के बंसजमन आने भासा के मनखेमन के बीच ले बाहिर आईन,<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>तब यहूदा ह परमेसर के पबितर-स्थान,</para>
  <para style="q2" vid="PSA 114:2">अऊ इसरायल ह ओकर राज बन गीस।<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>समुंदर ह देखके भाग गीस,</para>
  <para style="q2" vid="PSA 114:3">यरदन नदी उल्टा दिग म बहे लगिस;<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>पहाड़मन मेढ़ामन सहीं,</para>
  <para style="q2" vid="PSA 114:4">अऊ पहाड़ीमन मेढ़ा-पीलामन सहीं उछले-कूदे लगिन।<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>हे समुंदर, का होईस कि तेंह भाग गय?</para>
  <para style="q2" vid="PSA 114:5">अऊ हे यरदन, तेंह काबर उल्टा बहे लगय?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>हे पहाड़मन, तुमन काबर मेढ़ामन सहीं,</para>
  <para style="q2" vid="PSA 114:6">अऊ हे पहाड़ीमन, तुमन काबर मेढ़ा-पीलामन सहीं उछले-कूदे लगेव?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>हे धरती, परभू के आघू म,</para>
  <para style="q2" vid="PSA 114:7">याकूब के परमेसर के आघू म कांप,<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>जऊन ह चट्टान ला पानी के कुंड,</para>
  <para style="q2" vid="PSA 114:8">अऊ कठोर पथरा ला पानी के सोता म बदल दीस।<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="cl">भजन-संहिता 115</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>हे यहोवा, हमर नइं, हमर नइं</para>
  <para style="q2" vid="PSA 115:1">पर तोर मया अऊ बिसवासयोग्यता के कारन,</para>
  <para style="q2" vid="PSA 115:1">तोर नांव के महिमा होवय।<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>जाति-जाति के मनखेमन काबर कहिथें,</para>
  <para style="q2" vid="PSA 115:2">“ओमन के परमेसर कहां हवय?”<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>हमर परमेसर ह स्वरग म हवय;</para>
  <para style="q2" vid="PSA 115:3">ओला जऊन काम बने लगथे, ओला ओह करथे।<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>पर ओमन के मूरतीमन मनखेमन के</para>
  <para style="q2" vid="PSA 115:4">हांथ के बनाय सोन अऊ चांदी अंय।<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>ओमन के मुहूं तो हवय, पर ओमन गोठियाय नइं सकंय,</para>
  <para style="q2" vid="PSA 115:5">ओमन के आंखी तो हवय, पर देख नइं सकंय।<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>ओमन के कान तो हवय, पर सुन नइं सकंय,</para>
  <para style="q2" vid="PSA 115:6">नाक तो हवय, पर सुंघ नइं सकंय।<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>ओमन के हांथ तो हवय, पर ओमन छू नइं सकंय,</para>
  <para style="q2" vid="PSA 115:7">गोड़ तो हवय, पर ओमन चल नइं सकंय,</para>
  <para style="q2" vid="PSA 115:7">अऊ न ही ओमन अपन गला ले कोनो अवाज निकाल सकंय।<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>येमन ला बनानेवालामन येमन के सहीं हो जाहीं,</para>
  <para style="q2" vid="PSA 115:8">अऊ येमन ऊपर भरोसा रखइया जम्मो झन घलो येमन सहीं हो जाहीं।<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>हे जम्मो इसरायलीमन, यहोवा ऊपर भरोसा रखव—</para>
  <para style="q2" vid="PSA 115:9">ओह तुम्हर मददगार अऊ ढाल ए।<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>हे हारून के घराना, यहोवा ऊपर भरोसा रखव—</para>
  <para style="q2" vid="PSA 115:10">ओह तुम्हर मददगार अऊ ढाल ए।<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>हे यहोवा के भय माननेवालामन, ओकर ऊपर भरोसा रखव—</para>
  <para style="q2" vid="PSA 115:11">ओह तुम्हर मददगार अऊ ढाल ए।<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>यहोवा ह हमन ला सुरता करथे अऊ हमन ला आसीस देथे:</para>
  <para style="q2" vid="PSA 115:12">ओह अपन मनखे इसरायलीमन ला आसीस दीही,</para>
  <para style="q2" vid="PSA 115:12">ओह हारून के घराना ला आसीस दीही,<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>यहोवा ह छोटे अऊ बड़े ओ जम्मो झन ला आसीस दीही,</para>
  <para style="q2" vid="PSA 115:13">जऊन मन ओकर भय मानथें।<verse eid="PSA 115:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>यहोवा ह अइसे करय</para>
  <para style="q2" vid="PSA 115:14">कि तुमन अऊ तुम्हर लइकामन दूनों उन्नति करव।<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>यहोवा, जऊन ह स्वरग अऊ धरती के बनइया ए,</para>
  <para style="q2" vid="PSA 115:15">तुमन ला आसीस देवय।<verse eid="PSA 115:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>सबले ऊंच स्वरग यहोवा के अय,</para>
  <para style="q2" vid="PSA 115:16">पर धरती ला ओह मनखेमन ला दे हवय।<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>ये ओ मरे मनखेमन नो हंय या येमन चुप रहइया जगह म खाल्हे जवइया ओ मनखे नो हंय,</para>
  <para style="q2" vid="PSA 115:17">जऊन मन यहोवा के परसंसा करथें;<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>पर ये हमन अन, जऊन मन यहोवा के परसंसा करथन,</para>
  <para style="q2" vid="PSA 115:18">अब अऊ सदाकाल बर।</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q1" vid="PSA 115:18">यहोवा के परसंसा करव।<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="cl">भजन-संहिता 116</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>मेंह यहोवा ले मया करथंव, काबरकि ओह मोर बात ला सुनिस;</para>
  <para style="q2" vid="PSA 116:1">ओह दया के मोर पुकार ला सुनिस।<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>काबरकि ओह मोर कोति अपन कान लगाईस,</para>
  <para style="q2" vid="PSA 116:2">एकरसेति मेंह अपन जिनगी भर ओला पुकारहूं।<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>मिरतू के डोर म मेंह फंस गेंव,</para>
  <para style="q2" vid="PSA 116:3">कबर के पीरा ह मोर ऊपर आ गीस;</para>
  <para style="q2" vid="PSA 116:3">मेंह दुख अऊ पीरा म पड़े रहेंव।<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>तब मेंह यहोवा के नांव ले पराथना करेंव:</para>
  <para style="q2" vid="PSA 116:4">“हे यहोवा, मोला बचा!”<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>यहोवा ह अनुग्रहकारी अऊ धरमी अय;</para>
  <para style="q2" vid="PSA 116:5">हमर परमेसर ह दया ले भरे हवय।<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>यहोवा ह सीधा-साधा मनखे के रकछा करथे;</para>
  <para style="q2" vid="PSA 116:6">जब मोर बेजत्ती करे गीस, त ओह मोला बचाईस।<verse eid="PSA 116:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>हे मोर परान, अपन बिसराम-स्थान म लहुंट आ,</para>
  <para style="q2" vid="PSA 116:7">काबरकि यहोवा ह तोर भलई करे हवय।<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>हे यहोवा, तेंह मोला मिरतू ले,</para>
  <para style="q2" vid="PSA 116:8">मोर आंखीमन ला आंसू बहाय ले,</para>
  <para style="q2" vid="PSA 116:8">मोर गोड़मन ला ठोकर खाय ले बचाय हस,<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>ताकि मेंह यहोवा के आघू म</para>
  <para style="q2" vid="PSA 116:9">जीयत परानीमन के लोक म चलंव।<verse eid="PSA 116:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>मेंह यहोवा ऊपर भरोसा रखेंव, जब मेंह ये कहेंव,</para>
  <para style="q2" vid="PSA 116:10">“मेंह बहुंत दुखित हंव”;<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>मेंह अपन बेचैनी म कहेंव,</para>
  <para style="q2" vid="PSA 116:11">“जम्मो मनखेमन लबरा अंय।”<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>यहोवा ह जतेक भलई मोर बर करे हवय,</para>
  <para style="q2" vid="PSA 116:12">ओ जम्मो के बदले मेंह ओला का दंव?<verse eid="PSA 116:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>मेंह उद्धार के कटोरा ला ऊपर उठाहूं</para>
  <para style="q2" vid="PSA 116:13">अऊ यहोवा के नांव ला पुकारहूं।<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>यहोवा के जम्मो मनखेमन के आघू म</para>
  <para style="q2" vid="PSA 116:14">मेंह ओकर बर करे गय अपन मन्नत ला पूरा करहूं।<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>यहोवा के बिसवासयोग्य सेवकमन के मिरतू ह</para>
  <para style="q2" vid="PSA 116:15">ओकर नजर म अनमोल अय।<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>हे यहोवा, सही म मेंह तोर सेवक अंव;</para>
  <para style="q2" vid="PSA 116:16">मेंह तोर सेवा वइसे करथंव, जइसे मोर दाई ह करिस;</para>
  <para style="q2" vid="PSA 116:16">तेंह मोला मोर बंधना ले छोंड़ाय हस।<verse eid="PSA 116:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>मेंह तोला धनबाद-बलिदान चघाहूं</para>
  <para style="q2" vid="PSA 116:17">अऊ यहोवा के नांव ले पराथना करहूं।<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>यहोवा के जम्मो मनखेमन के आघू म</para>
  <para style="q2" vid="PSA 116:18">मेंह ओकर बर करे गय अपन मन्नत ला पूरा करहूं।<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>हे यरूसलेम, तोर बीच म,</para>
  <para style="q2" vid="PSA 116:19">यहोवा के घर के अंगनामन म अपन मन्नत ला पूरा करहूं।</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q1" vid="PSA 116:19">यहोवा के परसंसा करव।<note caller="+" style="f" category="dup"><char style="fr" closed="false">116:19 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">हलिलूयाह</char></note><verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="cl">भजन-संहिता 117</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>हे जाति-जाति के जम्मो मनखेमन, यहोवा के परसंसा करव;</para>
  <para style="q2" vid="PSA 117:1">हे जम्मो मनखेमन, ओकर बहुंत परसंसा करव।<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>काबरकि ओह हमन ला बहुंत मया करथे,</para>
  <para style="q2" vid="PSA 117:2">अऊ यहोवा के बिसवासयोग्यता सदाकाल बर बने रहिथे।</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q1" vid="PSA 117:2">यहोवा के परसंसा करव।<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="cl">भजन-संहिता 118</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>यहोवा ला धनबाद देवव, काबरकि ओह बने अय;</para>
  <para style="q2" vid="PSA 118:1">ओकर मया सदाकाल तक बने रहिथे।<verse eid="PSA 118:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>इसरायल ह कहय:</para>
  <para style="q2" vid="PSA 118:2">“ओकर मया सदाकाल तक बने रहिथे।”<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>हारून के घराना ह कहय:</para>
  <para style="q2" vid="PSA 118:3">“ओकर मया सदाकाल तक बने रहिथे।”<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>जऊन मन यहोवा के भय मानथें, ओमन कहंय:</para>
  <para style="q2" vid="PSA 118:4">“ओकर मया सदाकाल तक बने रहिथे।”<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>जब मेंह संकट म रहेंव, त मेंह यहोवा ला पुकारेंव; ओह मोर बात ला सुनिस</para>
  <para style="q2" vid="PSA 118:5">अऊ मोला चौरस जगह म लानके संकट ले उबारिस।<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>यहोवा ह मोर संग हवय; मेंह नइं डरंव।</para>
  <para style="q2" vid="PSA 118:6">मरनहार मनखे ह मोर का कर सकथे?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>यहोवा ह मोर संग हवय; ओह मोर मददगार ए।</para>
  <para style="q2" vid="PSA 118:7">मेंह अपन बईरीमन ऊपर बिजयी नजर ले देखथंव।<verse eid="PSA 118:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>मनखेमन ऊपर भरोसा रखे के बदले</para>
  <para style="q2" vid="PSA 118:8">यहोवा करा सरन लेवई जादा उत्तम ए।<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>परभावसाली मनखेमन ऊपर भरोसा रखे के बदले</para>
  <para style="q2" vid="PSA 118:9">यहोवा करा सरन लेवई जादा उत्तम ए।<verse eid="PSA 118:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>जम्मो जाति के मनखेमन मोला घेर ले रिहिन,</para>
  <para style="q2" vid="PSA 118:10">पर यहोवा के नांव म मेंह ओमन ला नास कर देंव।<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>ओमन मोला चारों कोति ले घेर ले रिहिन,</para>
  <para style="q2" vid="PSA 118:11">पर यहोवा के नांव म मेंह ओमन ला नास कर देंव।<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>ओमन मधुमक्खीमन के झुंड सहीं मोर चारों कोति हो गे रिहिन,</para>
  <para style="q2" vid="PSA 118:12">पर जइसे बरत कंटिली झाड़ी ह तुरते खतम हो जाथे, वइसे ओमन खतम हो गीन;</para>
  <para style="q2" vid="PSA 118:12">यहोवा के नांव म मेंह ओमन ला नास कर देंव।<verse eid="PSA 118:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>मोला पाछू कोति धकेले गीस अऊ मेंह गिरनेचवाला रहेंव,</para>
  <para style="q2" vid="PSA 118:13">पर यहोवा ह मोर मदद करिस।<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>यहोवा ह मोर बल अऊ मोर सुरकछा<note caller="+" style="f"><char style="fr" closed="false">118:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">गीत</char></note> ए;</para>
  <para style="q2" vid="PSA 118:14">ओह मोर उद्धार बन गे हवय।<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>धरमीमन के तम्बू म आनंद</para>
  <para style="q2" vid="PSA 118:15">अऊ जीत के जयघोस होवत हे:</para>
  <para style="q1" vid="PSA 118:15">“यहोवा के जेवनी हांथ ह बड़े-बड़े काम करे हवय!<verse eid="PSA 118:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16"/>यहोवा के जेवनी हांथ ह ऊपर उठे हवय;</para>
  <para style="q2" vid="PSA 118:16">यहोवा के जेवनी हांथ ह बड़े-बड़े काम करे हवय!”<verse eid="PSA 118:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>मेंह नइं मरंव पर जीयत रहिहूं,</para>
  <para style="q2" vid="PSA 118:17">अऊ यहोवा ह जऊन कुछू करे हवय, ओकर घोसना करहूं।<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>यहोवा ह मोर कठोर ताड़ना करे हवय,</para>
  <para style="q2" vid="PSA 118:18">पर ओह मोला मिरतू के बस म नइं करे हवय।<verse eid="PSA 118:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>मोर बर धरमीमन के दुवार ला खोल दव;</para>
  <para style="q2" vid="PSA 118:19">मेंह भीतर जाहूं अऊ यहोवा ला धनबाद दूहूं।<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>येह यहोवा के दुवार ए</para>
  <para style="q2" vid="PSA 118:20">जिहां ले धरमीमन भीतर जावंय।<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>मेंह तोला धनबाद दूहूं, काबरकि तेंह मोर पराथना ला सुने हस;</para>
  <para style="q2" vid="PSA 118:21">तेंह मोर उद्धार बन गे हस।<verse eid="PSA 118:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>जऊन पथरा ला घर के बनइयामन बेकार समझे रिहिन;</para>
  <para style="q2" vid="PSA 118:22">ओह कोना के पथरा बन गे हवय;<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>येह यहोवा के दुवारा होईस,</para>
  <para style="q2" vid="PSA 118:23">अऊ येह हमर नजर म अद्भूत ए।<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>यहोवा ह आज ही के दिन येला करे हवय;</para>
  <para style="q2" vid="PSA 118:24">आवव, आज हमन आनंद अऊ खुसी मनावन।<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>हे यहोवा, हमन ला बचा!</para>
  <para style="q2" vid="PSA 118:25">हे यहोवा, हमन ला सफलता दे!<verse eid="PSA 118:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>धइन ए ओ, जऊन ह यहोवा के नांव म आथे।</para>
  <para style="q2" vid="PSA 118:26">यहोवा के घर ले हमन तोला<note caller="+" style="f"><char style="fr" closed="false">118:26 </char><char style="ft" closed="false">इबरानी म बहुबचन</char></note> आसीस देथन।<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>यहोवा ह परमेसर ए,</para>
  <para style="q2" vid="PSA 118:27">अऊ ओह अपन अंजोर ला हमर ऊपर चमकाय हवय।</para>
  <para style="q1" vid="PSA 118:27">हांथ म रूख के डारामन ला लेके, आनंद के जुलूस म</para>
  <para style="q2" vid="PSA 118:27">बेदी के सींग तक सामिल हो जावव।<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>तेंह मोर परमेसर अस, अऊ मेंह तोर परसंसा करहूं;</para>
  <para style="q2" vid="PSA 118:28">तेंह मोर परमेसर अस, अऊ मेंह तोर बहुंत परसंसा करहूं।<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>यहोवा ला धनबाद देवव, काबरकि ओह बने अय;</para>
  <para style="q2" vid="PSA 118:29">ओकर मया सदाकाल तक बने रहिथे।<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="cl">भजन-संहिता 119<note caller="+" style="f"><char style="fr" closed="false">119 </char><char style="ft" closed="false">येह एक बिसेस भजन ए, जेकर पदमन के हर अनुछेद ह इबरानी भासा के ओहीच अकछर ले सुरू होथे।</char></note></para>
  <para style="qa">א आलेफ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>धइन अंय ओमन, जेमन के चालचलन निरदोस हवय,</para>
  <para style="q2" vid="PSA 119:1">जेमन यहोवा के कानून के मुताबिक चलथें।<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>धइन अंय ओमन, जेमन ओकर बिधि-बिधान म चलथें</para>
  <para style="q2" vid="PSA 119:2">अऊ अपन पूरा मन से ओकर खोज म रहिथें—<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>ओमन कोनो गलत काम नइं करंय</para>
  <para style="q2" vid="PSA 119:3">पर ओकर रसता म चलथें।<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>तेंह नियममन ला बनाय हस</para>
  <para style="q2" vid="PSA 119:4">जेमन के पूरा पालन करे जावय।<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>तोर बिधि-बिधान ला माने म</para>
  <para style="q2" vid="PSA 119:5">मोर चालचलन ह अटल रिहिस!<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>जब मेंह तोर जम्मो हुकूममन ऊपर बिचार करहूं</para>
  <para style="q2" vid="PSA 119:6">त मोला सरमिंदा होय नइं पड़ही।<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>जब मेंह तोर धरमी कानूनमन ला सीखहूं,</para>
  <para style="q2" vid="PSA 119:7">त मेंह तोर सही मन से परसंसा करहूं।<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>मेंह तोर बिधिमन ला मानहूं;</para>
  <para style="q2" vid="PSA 119:8">मोला झन तियाग दे।<verse eid="PSA 119:8"/></para>
  <para style="qa">ב बेथ</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>जवान ह अपन चालचलन ला कइसे सुध रख सकथे?</para>
  <para style="q2" vid="PSA 119:9">तोर बचन के मुताबिक चले के दुवारा।<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>मेंह अपन पूरा मन से तोर खोज म रहिथंव,</para>
  <para style="q2" vid="PSA 119:10">मोला तोर हुकूममन ले भटकन झन दे।<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>मेंह तोर बचन ला अपन हिरदय म रखे हंव</para>
  <para style="q2" vid="PSA 119:11">ताकि मेंह तोर बिरूध पाप झन करंव।<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>हे यहोवा, तोर परसंसा होवय;</para>
  <para style="q2" vid="PSA 119:12">मोला तोर बिधिमन ला सिखा।<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>तोर दिये गय जम्मो कानून ला</para>
  <para style="q2" vid="PSA 119:13">मेंह अपन मुहूं म दोहरात रहिथंव।<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>जइसे कोनो मनखे ह बहुंत धन पाके आनंदित होथे,</para>
  <para style="q2" vid="PSA 119:14">वइसे मेंह तोर नियममन ला पालन करके आनंदित होथंव।<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>मेंह तोर उपदेस ऊपर मनन करथंव</para>
  <para style="q2" vid="PSA 119:15">अऊ तोर बातमन ऊपर बिचार करथंव।<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>मोला तोर बिधि-बिधान ले खुसी होथे;</para>
  <para style="q2" vid="PSA 119:16">मेंह तोर बचन ऊपर धियान दूहूं।<verse eid="PSA 119:16"/></para>
  <para style="qa">ג गीमेल</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>अपन सेवक के भलई कर कि मेंह जीयत रहंव,</para>
  <para style="q2" vid="PSA 119:17">अऊ तोर बचन के पालन करंव।<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>मोर आंखी ला खोल कि मेंह</para>
  <para style="q2" vid="PSA 119:18">तोर कानून के अद्भूत चीजमन ला देख सकंव।<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>मेंह धरती म एक अजनबी अंव;</para>
  <para style="q2" vid="PSA 119:19">अपन हुकूममन ला मोर ले झन छिपा।<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>मोर परान ह तोर कानून के लालसा म</para>
  <para style="q2" vid="PSA 119:20">हर समय बियाकुल होवत हे।<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>तेंह ओ घमंडी मनखेमन ला डांटथस, जऊन मन सरापित अंय,</para>
  <para style="q2" vid="PSA 119:21">जऊन मन तोर हुकूममन ले भटक जाथें।<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>मोर ऊपर लगे ओमन के अपमान अऊ तिरस्कार ला हटा,</para>
  <para style="q2" vid="PSA 119:22">काबरकि मेंह तो नियममन के पालन करथंव।<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>हालाकि सासन करइयामन एक संग बईठके मोर निन्दा करथें,</para>
  <para style="q2" vid="PSA 119:23">पर तोर सेवक ह तोर बिधिमन ऊपर मनन करत रहिही।<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>तोर नियममन ऊपर मेंह खुस होथंव;</para>
  <para style="q2" vid="PSA 119:24">ओमन मोर सलाहकार एं।<verse eid="PSA 119:24"/></para>
  <para style="qa">ד दालेथ</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>मेंह खाल्हे धुर्रा म पड़े हंव;</para>
  <para style="q2" vid="PSA 119:25">अपन बचन के मुताबिक मोला बचाय रख।<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>मेंह तोला अपन चालचलन के लेखा-जोखा देंव अऊ तेंह मोला जबाब देय;</para>
  <para style="q2" vid="PSA 119:26">अपन बिधिमन ला मोला सिखा।<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>तोर उपदेसमन ला समझे के तरीका मोला बता,</para>
  <para style="q2" vid="PSA 119:27">ताकि मेंह तोर अद्भूत काम ऊपर मनन करंव।<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>मोर जीव ह दुख के मारे थक गे हवय;</para>
  <para style="q2" vid="PSA 119:28">अपन बचन के मुताबिक मोला मजबूत कर।<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>धोखा देवइया रसता ले मोला अलग रख;</para>
  <para style="q2" vid="PSA 119:29">मोर ऊपर अनुग्रह कर अऊ मोला तोर कानून सिखा।<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>मेंह सच्चई के रसता ला चुने हवंव;</para>
  <para style="q2" vid="PSA 119:30">मेंह तोर कानून ऊपर अपन मन ला लगाय हवंव।<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>हे यहोवा, मेंह तोर नियम ला मजबूती से थामे हवंव;</para>
  <para style="q2" vid="PSA 119:31">मोला लज्जा म झन पड़न दे।<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>मेंह तोर हुकूममन के रसता म दऊड़त हंव,</para>
  <para style="q2" vid="PSA 119:32">काबरकि तेंह मोर समझ ला बढ़ाय हस।<verse eid="PSA 119:32"/></para>
  <para style="qa">ה हे</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>हे यहोवा, तोर बिधिमन ला पालन करे के तरीका मोला सिखा,</para>
  <para style="q2" vid="PSA 119:33">ताकि आखिरी तक मेंह येकर पालन करंव।<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>मोला समझ दे ताकि मेंह तोर कानून के पालन करंव</para>
  <para style="q2" vid="PSA 119:34">अऊ पूरा हिरदय ले येला मानंव।<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>तोर हुकूममन के रसता म मोला ले चल,</para>
  <para style="q2" vid="PSA 119:35">काबरकि उहां मोला खुसी मिलथे।<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>मोर मन ला सुवारथ के लाभ कोति नइं,</para>
  <para style="q2" vid="PSA 119:36">पर अपन नियम कोति कर।<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>मोर आंखीमन ला बेकार के चीजमन ले हटा दे;</para>
  <para style="q2" vid="PSA 119:37">अपन बचन के मुताबिक मोर जिनगी ला बनाय रख।<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>अपन सेवक ले करे गे परतिगियां ला पूरा कर,</para>
  <para style="q2" vid="PSA 119:38">ताकि तोर भय माने जावय।<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>जऊन कलंक ले मेंह डरत हंव, ओला मोर ले दूरिहा कर दे।</para>
  <para style="q2" vid="PSA 119:39">काबरकि तोर कानूनमन उत्तम अंय।<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>मेंह तोर उपदेसमन के ईछा करथंव;</para>
  <para style="q2" vid="PSA 119:40">अपन धरमीपन म मोर जिनगी ला बनाय रख।<verse eid="PSA 119:40"/></para>
  <para style="qa">ו वाव</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>हे यहोवा, तोर उत्तम मया मोर ऊपर होवय,</para>
  <para style="q2" vid="PSA 119:41">अऊ अपन करे गे वायदा के मुताबिक मोर उद्धार कर;<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>तब में हर ओ मनखे ला जबाब दे सकहूं, जऊन ह मोला ताना मारथे,</para>
  <para style="q2" vid="PSA 119:42">काबरकि मेंह तोर बचन ऊपर भरोसा करथंव।<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>अपन सच्चई के बचन ला मोर मुहूं ले कभू झन हटा,</para>
  <para style="q2" vid="PSA 119:43">काबरकि मेंह तोर कानून ऊपर भरोसा रखे हंव।<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>मेंह हमेसा तोर कानून ला मानहूं,</para>
  <para style="q2" vid="PSA 119:44">सदाकाल तक मानत रहिहूं।<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>मेंह सुतंतर होके चलहूं,</para>
  <para style="q2" vid="PSA 119:45">काबरकि मेंह तोर उपदेसमन ला पा गे हवंव।<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>मेंह राजामन के आघू म तोर नियममन के बारे म गोठियाहूं</para>
  <para style="q2" vid="PSA 119:46">अऊ मोला सरमिंदा होय नइं पड़ही,<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>मेंह तोर हुकूममन ला मानके खुस होथंव,</para>
  <para style="q2" vid="PSA 119:47">काबरकि मेंह ओमन ले मया रखथंव।<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>मेंह तोर हुकूममन कोति हांथ बढ़ाथंव, जेमन ले कि मेंह मया रखथंव,</para>
  <para style="q2" vid="PSA 119:48">ताकि मेंह तोर बिधिमन ऊपर मनन करंव।<verse eid="PSA 119:48"/></para>
  <para style="qa">ז जईन</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>जऊन बात अपन सेवक ला कहे रहय, ओला सुरता रख,</para>
  <para style="q2" vid="PSA 119:49">काबरकि तेंह मोला आसा दे हस।<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>मोर दुख म मोला ये बात ले सांति मिलथे:</para>
  <para style="q2" vid="PSA 119:50">तोर वायदा ह मोर जिनगी ला बनाय रखथे।<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>घमंडी मनखेमन बिगर रोक-टोक के मोर हंसी उड़ाथें,</para>
  <para style="q2" vid="PSA 119:51">पर मेंह तोर कानून ले नइं हटंव।<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>हे यहोवा, मेंह तोर पुराना कानूनमन ला सुरता करथंव,</para>
  <para style="q2" vid="PSA 119:52">अऊ ओमन म मोला सांति मिलथे।<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>जऊन दुस्टमन तोर कानून ला तियाग दे हवंय,</para>
  <para style="q2" vid="PSA 119:53">ओमन के कारन मोला गुस्सा आथे।<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>जिहां भी मेंह रहिथंव,</para>
  <para style="q2" vid="PSA 119:54">तोर बिधिमन मोर गीत के बिसय होथें।<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>हे यहोवा, रथिया मेंह तोर नांव ला सुरता करथंव,</para>
  <para style="q2" vid="PSA 119:55">ताकि मेंह तोर कानून म चल सकंव।<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>येह मोर आदत हो गे हवय:</para>
  <para style="q2" vid="PSA 119:56">मेंह तोर उपदेस के पालन करथंव।<verse eid="PSA 119:56"/></para>
  <para style="qa">ח हेथ</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>हे यहोवा, तेंह मोर भाग अस;</para>
  <para style="q2" vid="PSA 119:57">मेंह तोर बचन ला पालन करे के वायदा करे हंव।<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>मेंह अपन पूरा मन से तोला खोजे हंव;</para>
  <para style="q2" vid="PSA 119:58">अपन वायदा के मुताबिक मोर ऊपर अनुग्रह कर।<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>मेंह अपन चालचलन ऊपर बिचार करे हंव</para>
  <para style="q2" vid="PSA 119:59">अऊ तोर नियममन ला पालन करे बर गोड़ ला आघू बढ़ाय हंव।<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>मेंह तोर हुकूममन ला पालन करे बर</para>
  <para style="q2" vid="PSA 119:60">जल्दी से आघू बढ़हूं, देरी नइं करंव।<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>हालाकि दुस्टमन मोला रस्सी ले बांधथें,</para>
  <para style="q2" vid="PSA 119:61">तभो ले मेंह तोर कानून ला नइं भूलंव।<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>तोर धरमी कानूनमन के सेति</para>
  <para style="q2" vid="PSA 119:62">तोला धनबाद दे बर मेंह आधा रथिया उठहूं।<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>मेंह ओ जम्मो के संगवारी अंव, जऊन मन तोर भय मानथें,</para>
  <para style="q2" vid="PSA 119:63">ओ जम्मो जऊन मन तोर नियम म चलथें।<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>हे यहोवा, धरती ह तोर मया ले भर गे हवय;</para>
  <para style="q2" vid="PSA 119:64">मोला तोर बिधिमन ला सिखा।<verse eid="PSA 119:64"/></para>
  <para style="qa">ט टेथ</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>हे यहोवा, अपन बचन के मुताबिक</para>
  <para style="q2" vid="PSA 119:65">अपन सेवक के भलई कर।<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>मोला गियान अऊ सही नियाय के बात सिखा,</para>
  <para style="q2" vid="PSA 119:66">काबरकि मेंह तोर हुकूममन ऊपर भरोसा करथंव।<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>दुख म पड़े के पहिले मेंह भटक गे रहेंव,</para>
  <para style="q2" vid="PSA 119:67">पर अब मेंह तोर बात ला मानथंव।<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>तेंह बने अस, अऊ जऊन कुछू तेंह करथस, ओह बने अय;</para>
  <para style="q2" vid="PSA 119:68">मोला अपन बिधिमन ला सिखा।<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>हालाकि घमंडी मनखेमन लबारी बात कहिके मोर ऊपर दाग लगाय हवंय,</para>
  <para style="q2" vid="PSA 119:69">पर मेंह अपन पूरा मन से तोर नियममन ला मानथंव।<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>ओमन के हिरदय कठोर अऊ भावनाहीन हो गे हवंय,</para>
  <para style="q2" vid="PSA 119:70">पर मोला तोर कानून म चलके खुसी मिलथे।<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>येह मोर बर बने बात होईस कि मेंह दुख म पड़ेंव</para>
  <para style="q2" vid="PSA 119:71">ताकि मेंह तोर बिधिमन ला सीख सकंव।<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>तोर मुहूं ले निकले कानून ह मोर बर</para>
  <para style="q2" vid="PSA 119:72">सोन अऊ चांदी के हजारों टुकड़ामन ले घलो जादा कीमती ए।<verse eid="PSA 119:72"/></para>
  <para style="qa">י योध</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>तोर हांथ ह मोला बनाईस अऊ मोला रचिस;</para>
  <para style="q2" vid="PSA 119:73">अपन हुकूममन ला सीखे के मोला समझ दे।<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>तोर भय मनइयामन मोला देखके आनंद मनावंय,</para>
  <para style="q2" vid="PSA 119:74">काबरकि मेंह तोर बचन ऊपर अपन आसा रखे हंव।<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>हे यहोवा, मेंह जानत हंव कि तोर कानूनमन धरमी अंय,</para>
  <para style="q2" vid="PSA 119:75">अऊ ये घलो कि सच्चई के मुताबिक तेंह मोला दुख दे हस।<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>अपन सेवक बर करे गे तोर वायदा के मुताबिक</para>
  <para style="q2" vid="PSA 119:76">तोर अटल मया ह मोला सांति देवय।<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>तोर दया मोर ऊपर होवय कि मेंह जीयत रहंव,</para>
  <para style="q2" vid="PSA 119:77">काबरकि तोर कानून ला माने म मोला खुसी मिलथे।<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>बिगर कोनो कारन के मोर संग गलत बरताव करे के कारन दुस्टमन लज्जित होवंय;</para>
  <para style="q2" vid="PSA 119:78">पर मेंह तोर उपदेसमन ऊपर मनन करत रहिहूं।<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>जऊन मन तोर भय मानथें, ओमन मोर कोति आवंय,</para>
  <para style="q2" vid="PSA 119:79">ओमन, जऊन मन तोर नियममन ला समझथें।<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>मेंह पूरा मन से तोर बिधिमन के पालन करंव</para>
  <para style="q2" vid="PSA 119:80">ताकि मोला लज्जित होना झन पड़य।<verse eid="PSA 119:80"/></para>
  <para style="qa">כ काफ</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>मोर परान ह तोर उद्धार के ईछा करत थक जावत हे,</para>
  <para style="q2" vid="PSA 119:81">पर मेंह तोर बचन म अपन आसा रखे हंव।<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>मोर आंखीमन तोर वायदा के पूरा होय के बाट जोहत थक जावत हें;</para>
  <para style="q2" vid="PSA 119:82">मेंह कहिथंव, “तेंह मोला कब सांति देबे?”<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>हालाकि मेंह कुहरा म अंगूर के मंद के एक कुप्पी सहीं अंव,</para>
  <para style="q2" vid="PSA 119:83">तभो ले मेंह तोर बिधिमन ला नइं भूलंव।<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>तोर सेवक ला अऊ कब तक इंतजार करे बर पड़ही?</para>
  <para style="q2" vid="PSA 119:84">तेंह मोला सतानेवालामन ला कब दंड देबे?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>तोर कानून के उल्टा</para>
  <para style="q2" vid="PSA 119:85">घमंडीमन मोला फंसाय बर खंचवा कोड़थें।<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>तोर जम्मो हुकूममन बिसवासयोग्य अंय;</para>
  <para style="q2" vid="PSA 119:86">मोर मदद कर, काबरकि मेंह बिगर कारन के सताय जावत हंव।<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>ओमन मोला धरती ले लगभग मिटा डारे रिहिन,</para>
  <para style="q2" vid="PSA 119:87">पर मेंह तोर उपदेसमन ला नइं छोड़े हंव।<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>तोर अटल मया म मोर जिनगी ला बनाय रख,</para>
  <para style="q2" vid="PSA 119:88">ताकि मेंह तोर मुहूं ले दिये गय नियममन ला मानंव।<verse eid="PSA 119:88"/></para>
  <para style="qa">ל लामेध</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>हे यहोवा, तोर बचन ह सदाकाल बर अय;</para>
  <para style="q2" vid="PSA 119:89">येह अकास म अटल बने रहिथे।<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>तोर बिसवासयोग्यता पीढ़ी दर पीढ़ी बने रहिथे;</para>
  <para style="q2" vid="PSA 119:90">तेंह धरती ला इस्थिर करय, अऊ येह बने रहिथे।<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>तोर कानूनमन आज तक बने हवंय,</para>
  <para style="q2" vid="PSA 119:91">काबरकि जम्मो चीजमन तोर सेवा करथें।<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>कहूं तोर कानून ह मोर खुसी के कारन नइं होतिस,</para>
  <para style="q2" vid="PSA 119:92">त मेंह अपन दुख म नास हो गे रहितेंव।<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>मेंह तोर उपदेसमन ला कभू नइं भूलंव,</para>
  <para style="q2" vid="PSA 119:93">काबरकि ओमन के दुवारा तेंह मोर जिनगी ला बनाय रखे हस।<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>मोला बचा, काबरकि मेंह तोर अंव;</para>
  <para style="q2" vid="PSA 119:94">मेंह तोर उपदेसमन ला खोज ले हंव।<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>दुस्टमन मोला नास करे बर बाट जोहत हें,</para>
  <para style="q2" vid="PSA 119:95">पर मेंह तोर बिधिमन ऊपर बिचार करत रहिहूं।<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>हर सिद्धता म मेंह एक सीमना ला देखथंव,</para>
  <para style="q2" vid="PSA 119:96">पर तोर हुकूममन के कोनो सीमना नइं ए।<verse eid="PSA 119:96"/></para>
  <para style="qa">מ मेम</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>अहा! तोर कानून ले मेंह कइसने मया करथंव!</para>
  <para style="q2" vid="PSA 119:97">दिन भर मेंह येकर ऊपर मनन करत रहिथंव।<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>तोर हुकूममन हमेसा मोर संग हवंय</para>
  <para style="q2" vid="PSA 119:98">अऊ मोर बईरीमन ले मोला जादा बुद्धिमान बनाथें।<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>मोर जम्मो गुरूमन ले मोर म जादा समझ हवय,</para>
  <para style="q2" vid="PSA 119:99">काबरकि मेंह तोर नियममन ऊपर चिंतन-मनन करत रहिथंव।<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>मोर म अगुवामन ले जादा समझ हवय,</para>
  <para style="q2" vid="PSA 119:100">काबरकि मेंह तोर नियममन के पालन करथंव।<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>मेंह अपन गोड़ ला हर एक बुरई के रसता म जाय ले रोके हंव</para>
  <para style="q2" vid="PSA 119:101">ताकि मेंह तोर बचन के पालन कर सकंव।<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>मेंह तोर कानून के पालन करे ले नइं हटे हंव,</para>
  <para style="q2" vid="PSA 119:102">काबरकि तेंह खुद मोला ये कानून ला सिखाय हस।<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>तोर बचनमन मोला बहुंत मीठ लगथें,</para>
  <para style="q2" vid="PSA 119:103">मोर मुहूं म येह मंधरस ले घलो जादा मीठ लगथे!<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>तोर उपदेसमन ले मोला समझ के बात मिलथे;</para>
  <para style="q2" vid="PSA 119:104">एकरसेति मेंह हर गलत रसता ले घिन करथंव।<verse eid="PSA 119:104"/></para>
  <para style="qa">נ नून</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>तोर बचन ह मोर पांव बर दीया,</para>
  <para style="q2" vid="PSA 119:105">अऊ मोर रसता बर अंजोर अय।<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>मेंह कसम खाय हंव अऊ ठान ले हंव,</para>
  <para style="q2" vid="PSA 119:106">कि मेंह तोर धरमी कानूनमन के पालन करहूं।<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>में बहुंत दुख झेले हंव;</para>
  <para style="q2" vid="PSA 119:107">हे यहोवा, अपन बचन के मुताबिक मोर जिनगी ला बनाय रख।<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>हे यहोवा, अपन मन से मोर मुहूं ले निकले परसंसा ला गरहन कर,</para>
  <para style="q2" vid="PSA 119:108">अऊ तोर कानून मोला सिखा।<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>हालाकि मेंह लगातार अपन परान ला अपन हथेली म लेके चलथंव,</para>
  <para style="q2" vid="PSA 119:109">तभो ले मेंह तोर कानून ला नइं भूलंव।<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>दुस्टमन मोर बर एक फंदा लगाय हवंय,</para>
  <para style="q2" vid="PSA 119:110">पर मेंह तोर उपदेसमन ले नइं भटके हंव।<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>तोर बिधिमन सदाकाल बर मोर कुल-परंपरा अंय,</para>
  <para style="q2" vid="PSA 119:111">ओमन मोर हिरदय के आनंद अंय।<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>मोर हिरदय ला आखिरी तक</para>
  <para style="q2" vid="PSA 119:112">तोर बिधि-बिधान म चले बर लगाय हवंव।<verse eid="PSA 119:112"/></para>
  <para style="qa">ס सामेख</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>मेंह दोगला मनखेमन ले घिन करथंव,</para>
  <para style="q2" vid="PSA 119:113">पर मेंह तोर कानून ले मया करथंव।<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>तेंह मोर सरन-स्थान अऊ मोर ढाल अस;</para>
  <para style="q2" vid="PSA 119:114">मेंह तोर बचन म अपन आसा रखे हंव।<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>हे दुस्ट काम करइयामन, मोर ले दूर हटव,</para>
  <para style="q2" vid="PSA 119:115">ताकि मेंह अपन परमेसर के हुकूममन ला मान सकंव!<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>हे मोर परमेसर, अपन वायदा के मुताबिक मोला संभाले रख ताकि मेंह जीयत रहंव;</para>
  <para style="q2" vid="PSA 119:116">मोर आसा ला झन टूटन दे।<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>मोला थाम ले, अऊ मेंह बांचे रहिहूं;</para>
  <para style="q2" vid="PSA 119:117">मेंह हमेसा तोर बिधिमन के आदर करहूं।<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>तेंह ओमन ला गरहन नइं करस, जऊन मन तोर नियम ले भटक जाथें,</para>
  <para style="q2" vid="PSA 119:118">काबरकि ओमन के भरम म पड़े ले कोनो फायदा नइं होवय।<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>धरती के जम्मो दुस्टमन ला तेंह कुड़ा-करकट के सहीं छोंड़ देथस;</para>
  <para style="q2" vid="PSA 119:119">एकरसेति मेंह तोर नियममन ले मया करथंव।<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>तोर डर म मोर देहें ह कांपथे;</para>
  <para style="q2" vid="PSA 119:120">मेंह तोर कानून के भय म रहिथंव।<verse eid="PSA 119:120"/></para>
  <para style="qa">ע अयीन</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>मेंह ओही काम करे हंव, जऊन ह सही अऊ नियाय-संगत अय;</para>
  <para style="q2" vid="PSA 119:121">मोला मोर सतानेवालामन के हांथ म झन छोंड़ दे।<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>अपन सेवक के भलई के बात ला निस्चित कर ले;</para>
  <para style="q2" vid="PSA 119:122">घमंडीमन ला मोर ऊपर अतियाचार झन करन दे।<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>मोर आंखीमन तोर उद्धार के बाट जोहत,</para>
  <para style="q2" vid="PSA 119:123">तोर धरमी वायदा के बाट जोहत थक गे हवंय।<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>अपन मया के मुताबिक तोर सेवक ले बरताव कर</para>
  <para style="q2" vid="PSA 119:124">अऊ मोला तोर नियममन ला सिखा।<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>मेंह तोर सेवक अंव; मोला समझ के आतमा दे</para>
  <para style="q2" vid="PSA 119:125">ताकि मेंह तोर बिधिमन ला समझ सकंव।<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>हे यहोवा, तोर काम करे के समय आ गे हवय;</para>
  <para style="q2" vid="PSA 119:126">तोर कानून ला टोरे जावत हे।<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>काबरकि मेंह तोर हुकूममन ला</para>
  <para style="q2" vid="PSA 119:127">सोन ले जादा, सुध सोन ले घलो जादा मया करथंव,<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>अऊ काबरकि मेंह तोर जम्मो उपदेसमन ला सही मानथंव,</para>
  <para style="q2" vid="PSA 119:128">मेंह हर गलत रसता ले घिन करथंव।<verse eid="PSA 119:128"/></para>
  <para style="qa">פ पे</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>तोर नियममन अद्भूत अंय;</para>
  <para style="q2" vid="PSA 119:129">एकरसेति मेंह ओमन ला मानथंव।<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>तोर बचन के समझ ले अंजोर मिलथे;</para>
  <para style="q2" vid="PSA 119:130">येह सधारन मनखे ला समझ के आतमा देथे।<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>मेंह अपन मुहूं ला खोलथंव अऊ हांफथंव,</para>
  <para style="q2" vid="PSA 119:131">काबरकि मेंह तोर हुकूम बर पीयासन हंव।<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>मोर कोति देख अऊ मोर ऊपर दया कर,</para>
  <para style="q2" vid="PSA 119:132">जइसे कि तेंह हमेसा ओमन ऊपर करथस, जऊन मन तोर नांव ले मया करथें।<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>अपन बचन के मुताबिक मोर गोड़मन ला चले के निरदेस दे;</para>
  <para style="q2" vid="PSA 119:133">मोर ऊपर कोनो पाप के अधिकार झन होवन दे।<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>मोला मनखेमन के अतियाचार ले छोंड़ा ले,</para>
  <para style="q2" vid="PSA 119:134">ताकि मेंह तोर उपदेसमन के पालन करंव।<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>अपन दास ऊपर अपन मुहूं के अंजोर ला चमका</para>
  <para style="q2" vid="PSA 119:135">अऊ मोला अपन बिधिमन ला सिखा।<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>मोर आंखी ले आंसू के धारा बहत हे,</para>
  <para style="q2" vid="PSA 119:136">काबरकि मनखेमन तोर कानून के पालन नइं करत हंय।<verse eid="PSA 119:136"/></para>
  <para style="qa">צ सादे</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>हे यहोवा तेंह धरमी अस,</para>
  <para style="q2" vid="PSA 119:137">अऊ तोर कानूनमन सही अंय।<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>जऊन नियम तेंह बनाय हस, ओमन धरमी अंय;</para>
  <para style="q2" vid="PSA 119:138">ओमन पूरा बिसवासयोग्य अंय।<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>मोर उत्साह ह मोला भसम करत हवय,</para>
  <para style="q2" vid="PSA 119:139">काबरकि मोर बईरीमन तोर बचन के अनदेखा करत हवंय।<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>तोर वायदामन पूरा परखे गे हवंय,</para>
  <para style="q2" vid="PSA 119:140">अऊ तोर सेवक ह ओमन ले मया करथे।<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>हालाकि मेंह नीचा अऊ तुछ समझे जावत हंव,</para>
  <para style="q2" vid="PSA 119:141">तभो ले मेंह तोर उपदेसमन ला नइं भूलंव।<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>तोर धरमीपन ह सदा बने रहिथे</para>
  <para style="q2" vid="PSA 119:142">अऊ तोर कानून ह सच ए।<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>समस्या अऊ दुख मोर ऊपर आय हवय,</para>
  <para style="q2" vid="PSA 119:143">पर तोर हुकूम ह मोला खुसी देथे।<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>तोर नियममन हमेसा सही अंय;</para>
  <para style="q2" vid="PSA 119:144">मोला समझ के आतमा दे कि मेंह जीयत रहंव।<verse eid="PSA 119:144"/></para>
  <para style="qa">ק कौफ</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>हे यहोवा, मेंह अपन पूरा मन से तोला पुकारत हंव; मोला जबाब दे,</para>
  <para style="q2" vid="PSA 119:145">अऊ मेंह तोर बिधिमन ला मानहूं।<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>मेंह तोला पुकारत हंव; मोला बचा</para>
  <para style="q2" vid="PSA 119:146">अऊ मेंह तोर नियममन ला मानहूं।<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>मेंह बिहान होय के पहिले उठथंव अऊ मदद बर गोहारथंव;</para>
  <para style="q2" vid="PSA 119:147">मेंह तोर बचन ऊपर अपन आसा रखे हंव।<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>मोर आंखी ह रथिया के जम्मो पहर खुला रहिथे,</para>
  <para style="q2" vid="PSA 119:148">ताकि मेंह तोर वायदामन ऊपर मनन कर सकंव।<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>अपन मया के मुताबिक मोर बात ला सुन;</para>
  <para style="q2" vid="PSA 119:149">हे यहोवा, अपन कानून के मुताबिक मोर जिनगी ला बनाय रख।<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>जऊन मन दुस्ट योजना बनाथें, ओमन लकठा म हवंय,</para>
  <para style="q2" vid="PSA 119:150">पर ओमन तोर कानून ले बहुंत दूरिहा हवंय।<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>तभो ले हे यहोवा, तेंह मोर लकठा म हस,</para>
  <para style="q2" vid="PSA 119:151">अऊ तोर जम्मो हुकूममन सच अंय।<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>बहुंत पहिले मेंह तोर नियममन ले सीखे रहेंव</para>
  <para style="q2" vid="PSA 119:152">कि तेंह ओमन ला सदाकाल तक बने रहे बर बनाय हस।<verse eid="PSA 119:152"/></para>
  <para style="qa">ר रेस</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>मोर दुख ला देख अऊ येकर ले मोला छोंड़ा,</para>
  <para style="q2" vid="PSA 119:153">काबरकि मेंह तोर कानून ला नइं भूले हंव।<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>मोर मामला के बचाव कर अऊ मोला छोंड़ा;</para>
  <para style="q2" vid="PSA 119:154">अपन वायदा के मुताबिक मोर जिनगी ला बनाय रख।<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>दुस्ट मनखेमन ले उद्धार ह बहुंत दूरिहा हवय,</para>
  <para style="q2" vid="PSA 119:155">काबरकि ओमन तोर बिधिमन ऊपर धियान नइं देवंय।<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>हे यहोवा, तोर दया ह महान ए;</para>
  <para style="q2" vid="PSA 119:156">अपन कानून के मुताबिक मोर जिनगी ला बनाय रख।<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>बईरीमन बहुंत हवंय, जऊन मन मोला सताथें,</para>
  <para style="q2" vid="PSA 119:157">पर मेंह तोर नियममन ला माने ले नइं हटे हंव।<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>मेंह बिसवासहीन मनखेमन ला नफरत के नजर ले देखथंव,</para>
  <para style="q2" vid="PSA 119:158">काबरकि ओमन तोर बचन के पालन नइं करंय।<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>देख, मेंह तोर नियम ले कइसे मया रखथंव;</para>
  <para style="q2" vid="PSA 119:159">हे यहोवा, अपन मया के मुताबिक मोर जिनगी ला बनाय रख।<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>तोर जम्मो बचनमन सच अंय;</para>
  <para style="q2" vid="PSA 119:160">तोर जम्मो धरमी कानूनमन सदाकाल बर अंय।<verse eid="PSA 119:160"/></para>
  <para style="qa">ש सीन</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>सासन करइयामन बिगर कोनो कारन के मोला सताथें,</para>
  <para style="q2" vid="PSA 119:161">पर मोर हिरदय ह तोर बचन के खियाल करके कांपथे।<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>जइसे कोनो बड़े लूट के माल मिले ले खुस होथे,</para>
  <para style="q2" vid="PSA 119:162">वइसे मेंह तोर करे गय वायदामन ले आनंदित होथंव।<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>लबारी बात ले मेंह घिन करथंव अऊ ओला तुछ समझथंव</para>
  <para style="q2" vid="PSA 119:163">पर मेंह तोर कानून ले मया करथंव।<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>तोर धरमी कानून बर</para>
  <para style="q2" vid="PSA 119:164">दिन म सात बार मेंह तोर परसंसा करथंव।<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>जऊन मन तोर कानून ले मया करथें, ओमन ला बहुंत सांति मिलथे,</para>
  <para style="q2" vid="PSA 119:165">अऊ कोनो भी चीज ले ओमन ला ठोकर नइं लगय।<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>हे यहोवा, मेंह तोर उद्धार के इंतजार करथंव,</para>
  <para style="q2" vid="PSA 119:166">अऊ मेंह तोर हुकूममन के पालन करथंव।<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>मेंह तोर नियममन ला मानथंव,</para>
  <para style="q2" vid="PSA 119:167">काबरकि मेंह ओमन ले बहुंत मया करथंव।<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>मेंह तोर नियम अऊ बिधिमन के पालन करथंव,</para>
  <para style="q2" vid="PSA 119:168">काबरकि मोर जम्मो चालचलन ला तेंह जानत हस।<verse eid="PSA 119:168"/></para>
  <para style="qa">ת ताव</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>हे यहोवा, मोर गोहार ह तोर करा हबरे;</para>
  <para style="q2" vid="PSA 119:169">अपन बचन के मुताबिक मोला समझ के आतमा दे।<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>मोर बिनती ह तोर करा हबरे;</para>
  <para style="q2" vid="PSA 119:170">अपन वायदा के मुताबिक मोला छोंड़ा।<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>मोर मुहूं ले बहुंत परसंसा के बात निकले,</para>
  <para style="q2" vid="PSA 119:171">काबरकि तेंह मोला अपन बिधिमन ला सिखाथस।<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>मोर जीभ ह तोर बचन के गीत गावय,</para>
  <para style="q2" vid="PSA 119:172">काबरकि तोर जम्मो हुकूममन धरमी अंय।<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>तोर हांथ ह मोर मदद करे बर तियार रहय,</para>
  <para style="q2" vid="PSA 119:173">काबरकि मेंह तोर उपदेसमन ला अपना ले हंव।<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>हे यहोवा, मेंह तोर ले उद्धार के ईछा करथंव,</para>
  <para style="q2" vid="PSA 119:174">अऊ तोर कानून ला पालन करके मोला खुसी मिलथे।<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>मोला जीयत रहन दे कि मेंह तोर परसंसा करंव,</para>
  <para style="q2" vid="PSA 119:175">अऊ तोर कानूनमन मोला संभाले रहंय।<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>मेंह गंवाय भेड़ सहीं भटक गे हंव।</para>
  <para style="q2" vid="PSA 119:176">अपन सेवक ला खोज,</para>
  <para style="q2" vid="PSA 119:176">काबरकि मेंह तोर हुकूममन ला नइं भूले हंव।<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="cl">भजन-संहिता 120</para>
  <para style="d">आरोहन के एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>मेंह अपन दुख म यहोवा ला पुकारथंव,</para>
  <para style="q2" vid="PSA 120:1">अऊ ओह मोला जबाब देथे।<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>हे यहोवा,</para>
  <para style="q2" vid="PSA 120:2">लबारी मरइया ओंठ</para>
  <para style="q2" vid="PSA 120:2">अऊ धोखा देवइया जीभ ले मोला बचा।<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>हे धोखा देवइया जीभ,</para>
  <para style="q2" vid="PSA 120:3">तोर संग परमेसर ह का करही,</para>
  <para style="q2" vid="PSA 120:3">अऊ येकर अलावा अऊ का होही?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>ओह तोला एक योद्धा के नुकीला तीरमन ले,</para>
  <para style="q2" vid="PSA 120:4">बहरी बनइया झाड़ी के बरत कोइलामन ले सजा दीही।<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>धिक्कार ए मोर ऊपर कि मेंह मेसेक देस म निवास करथंव,</para>
  <para style="q2" vid="PSA 120:5">अऊ ये कि केदार के तम्बूमन के बीच रहिथंव!<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>बहुंत समय तक मेंह ओमन के बीच रहेंव,</para>
  <para style="q2" vid="PSA 120:6">जऊन मन सांति बिलकुल पसंद नइं करंय।<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>मोला सांति बने लगथे;</para>
  <para style="q2" vid="PSA 120:7">पर जब मेंह गोठियाथंव, त ओमन लड़ई करे चाहथें।<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="cl">भजन-संहिता 121</para>
  <para style="d">आरोहन के एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>मेंह अपन आंखी ला पहाड़मन कोति लगाथंव—</para>
  <para style="q2" vid="PSA 121:1">मोर मदद कहां ले आथे?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>मोर मदद ह यहोवा ले आथे,</para>
  <para style="q2" vid="PSA 121:2">जऊन ह अकास अऊ धरती के रचइया ए।<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>ओह तोर पांव ला फिसले बर नइं दीही—</para>
  <para style="q2" vid="PSA 121:3">जऊन ह तोर रखवारी करथे, ओह नइं ऊंघय;<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>वास्तव म, जऊन ह इसरायल के रखवारी करथे,</para>
  <para style="q2" vid="PSA 121:4">ओह न तो ऊंघय अऊ न ही सुतय।<verse eid="PSA 121:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>यहोवा ह तोर रखवारी करथे—</para>
  <para style="q2" vid="PSA 121:5">यहोवा ह तोर जेवनी हांथ कोति बचाव के तोर छइहां ए;<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>न तो दिन के समय सूरज ले</para>
  <para style="q2" vid="PSA 121:6">अऊ न ही रथिया के बेरा चंदा ले तोला कोनो हानि होही।<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>यहोवा ह तोला जम्मो हानि ले बचाही—</para>
  <para style="q2" vid="PSA 121:7">ओह तोर जिनगी के रखवारी करही;<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>यहोवा ह तोर अवई-जवई म</para>
  <para style="q2" vid="PSA 121:8">तोर रकछा अब ले लेके सदाकाल तक करत रहिही।<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="cl">भजन-संहिता 122</para>
  <para style="d">आरोहन के एक गीत। दाऊद के गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>मेंह ओमन के संग आनंद मनाथंव, जऊन मन मोला कहिन,</para>
  <para style="q2" vid="PSA 122:1">“आवव, यहोवा के घर चलबो।”<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>हे यरूसलेम, तोर दुवारमन म</para>
  <para style="q2" vid="PSA 122:2">हमन खड़े हवन।<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>यरूसलेम ला ओ सहर के सहीं बनाय गे हवय,</para>
  <para style="q2" vid="PSA 122:3">जेकर घरमन एक-दूसर ले एक संग जुड़े हवंय।<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>ओही ह ओ जगह ए, जिहां गोत्र-गोत्र के मनखे—</para>
  <para style="q2" vid="PSA 122:4">यहोवा के गोत्र के मनखे</para>
  <para style="q1" vid="PSA 122:4">यहोवा के नांव के परसंसा करे बर जाथें,</para>
  <para style="q2" vid="PSA 122:4">अऊ ये परसंसा के काम इसरायल ला दिये गय नियम के मुताबिक होथे।<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>उहां नियाय बर सिंघासनमन हवंय,</para>
  <para style="q2" vid="PSA 122:5">अऊ ओमन दाऊद के घराना के सिंघासन अंय।<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>यरूसलेम के सांति बर पराथना करव:</para>
  <para style="q2" vid="PSA 122:6">“जऊन मन तोर ले मया करथें, ओमन सुरकछित रहंय।<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>तोर दीवारमन<note caller="+" style="f"><char style="fr" closed="false">122:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">तोर सहर के दीवारमन</char></note> के भीतर म सांति</para>
  <para style="q2" vid="PSA 122:7">अऊ तोर गढ़मन म सुरकछा बने रहय।”<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>अपन परिवार अऊ संगवारीमन के हित म,</para>
  <para style="q2" vid="PSA 122:8">मेंह कहिहूं, “तुमन म सांति रहय।”<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>यहोवा, हमर परमेसर के घर के हित म</para>
  <para style="q2" vid="PSA 122:9">मेंह तुम्हर उन्नति के कोसिस म रहिहूं।<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="cl">भजन-संहिता 123</para>
  <para style="d">आरोहन के एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>मेंह अपन नजर तोर कोति करथंव,</para>
  <para style="q2" vid="PSA 123:1">तोर कोति, जऊन ह स्वरग म बिराजमान हे।<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>जइसे कि दासमन के नजर ह अपन मालिक के हांथ कोति,</para>
  <para style="q2" vid="PSA 123:2">जइसे कि दासी के नजर ह अपन मालकिन के हांथ कोति लगे रहिथे,</para>
  <para style="q1" vid="PSA 123:2">वइसे ही हमर नजर ह यहोवा, हमर परमेसर कोति तब तक लगे रहिथे,</para>
  <para style="q2" vid="PSA 123:2">जब तक कि ओह हमर ऊपर अपन दया नइं देखावय।<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>हे यहोवा, हमर ऊपर दया कर, हमर ऊपर दया कर,</para>
  <para style="q2" vid="PSA 123:3">काबरकि हमन बहुंत अपमान सहे हन।<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>घमंडी मनखेमन हमर</para>
  <para style="q2" vid="PSA 123:4">बहुंत हंसी उड़ाय हवंय,</para>
  <para style="q2" vid="PSA 123:4">घमंडी मनखेमन के हमन घोर अपमान सहे हन।<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="cl">भजन-संहिता 124</para>
  <para style="d">आरोहन के एक गीत। दाऊद के गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>कहूं यहोवा ह हमर कोति नइं होतिस—</para>
  <para style="q2" vid="PSA 124:1">त इसरायल ह कहय—<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>कहूं यहोवा ह हमर कोति नइं होतिस</para>
  <para style="q2" vid="PSA 124:2">जब मनखेमन हमर ऊपर हमला करिन,<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>त ओमन हमन ला जीयत लील ले रहितिन</para>
  <para style="q2" vid="PSA 124:3">जब ओमन के गुस्सा हमर ऊपर भड़किस;<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>बाढ़ के पानी म हमन बुड़ गे रहितेंन,</para>
  <para style="q2" vid="PSA 124:4">पानी के बहाव म हमन बह गे रहितेंन,<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>भयंकर पानी के धारा ह</para>
  <para style="q2" vid="PSA 124:5">हमन ला बहाके ले गे रहितिस।<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>यहोवा के परसंसा होवय,</para>
  <para style="q2" vid="PSA 124:6">जऊन ह हमन ला ओमन के दांत के दुवारा फाड़े जाय ले बचाय हवय।<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>हमन चिड़ीमार के जाल ले बचे</para>
  <para style="q2" vid="PSA 124:7">एक चिरई के सहीं अन;</para>
  <para style="q1" vid="PSA 124:7">जाल ह फट गे हवय,</para>
  <para style="q2" vid="PSA 124:7">अऊ हमन बच गे हवन।<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>हमर मदद यहोवा के नांव म होथे,</para>
  <para style="q2" vid="PSA 124:8">जऊन ह अकास अऊ धरती ला बनाय हवय।<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="cl">भजन-संहिता 125</para>
  <para style="d">आरोहन के एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>जऊन मन यहोवा ऊपर भरोसा रखथें, ओमन सियोन पहाड़ सहीं अंय,</para>
  <para style="q2" vid="PSA 125:1">जेला हलाय नइं जा सकय पर येह सदा अटल बने रहिथे।<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>जइसे कि पहाड़मन यरूसलेम ला चारों कोति ले घेरे हवंय,</para>
  <para style="q2" vid="PSA 125:2">वइसे ही यहोवा ह अपन मनखेमन ला</para>
  <para style="q2" vid="PSA 125:2">अब अऊ सदाकाल तक घेरे रहिथे।<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>दुस्टमन के राजदंड ह धरमीमन ला</para>
  <para style="q2" vid="PSA 125:3">दिये गय भुइयां ऊपर हमेसा बने नइं रहिही,</para>
  <para style="q1" vid="PSA 125:3">काबरकि तब धरमीमन</para>
  <para style="q2" vid="PSA 125:3">अपन हांथ दुस्ट काम करे म लगा सकथें।<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>हे यहोवा, ओमन के भलई कर, जऊन मन सीधवा मनखे अंय,</para>
  <para style="q2" vid="PSA 125:4">ओमन के भलई कर, जेमन के मन ह ईमानदार अय।<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>पर जऊन मन बेईमानी के रसता ला धरथें</para>
  <para style="q2" vid="PSA 125:5">यहोवा ह ओमन ला दुस्टमन के संग निकाल दीही।</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q1" vid="PSA 125:5">इसरायल ला सांति मिलय।<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="cl">भजन-संहिता 126</para>
  <para style="d">आरोहन के एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>जब यहोवा ह सियोन के भाग्य ला फेर पलटिस,<note caller="+" style="f"><char style="fr" closed="false">126:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बंधुवई ले वापिस लानिस</char></note></para>
  <para style="q2" vid="PSA 126:1">त हमन सपना देखइयामन सहीं हो गे रहेंन।<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>तब खुसी के मारे हमन बहुंत हंसेंन,</para>
  <para style="q2" vid="PSA 126:2">हमर मुहूं ले आनंद के गीत निकलत रिहिस।</para>
  <para style="q1" vid="PSA 126:2">तब जाति-जाति के मनखेमन के बीच ये कहे गीस,</para>
  <para style="q2" vid="PSA 126:2">“यहोवा ह ओमन बर बड़े-बड़े काम करे हवय।”<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>यहोवा ह हमर बर बड़े-बड़े काम करे हवय,</para>
  <para style="q2" vid="PSA 126:3">अऊ येकर कारन हमन बहुंत आनंदित हन।<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>हे यहोवा, नेगेव म पानी के सोता सहीं,</para>
  <para style="q2" vid="PSA 126:4">हमर भाग्य ला फेर पलट दे।<note caller="+" style="f"><char style="fr" closed="false">126:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बंधुवई ले वापिस ले आ</char></note><verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>जऊन मन आंसू बहात बोथें,</para>
  <para style="q2" vid="PSA 126:5">ओमन आनंद के गीत गावत फसल ला लूहीं।<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>जऊन मन बीजा ला बोए बर</para>
  <para style="q2" vid="PSA 126:6">रोवत बाहिर निकलथें,</para>
  <para style="q1" vid="PSA 126:6">ओमन फसल के बीड़ा लेके</para>
  <para style="q2" vid="PSA 126:6">आनंद के गीत गावत लहुंटहीं।<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="cl">भजन-संहिता 127</para>
  <para style="d">आरोहन के एक गीत। सुलेमान के गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>यदि घर ला यहोवा ह नइं बनावय,</para>
  <para style="q2" vid="PSA 127:1">त ओकर बनानेवालामन के मेहनत ह बेकार होथे।</para>
  <para style="q1" vid="PSA 127:1">यदि सहर के पहरेदारी यहोवा ह नइं करय,</para>
  <para style="q2" vid="PSA 127:1">त पहरेदारमन के पहरेदारी ह बेकार होथे।<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>तुमन बेकार म बड़े बिहनियां उठथव</para>
  <para style="q2" vid="PSA 127:2">अऊ देर रात तक जागके</para>
  <para style="q1" vid="PSA 127:2">जेवन बर मेहनत करथव—</para>
  <para style="q2" vid="PSA 127:2">काबरकि ओह ओमन ला नींद देथे, जेमन ले ओह मया करथे।<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>लइकामन यहोवा के दुवारा दिये गय भाग होथें,</para>
  <para style="q2" vid="PSA 127:3">लइका ह ओकर कोति ले दिये गय एक ईनाम ए।<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>जइसे एक योद्धा के हांथ म तीरमन होथें,</para>
  <para style="q2" vid="PSA 127:4">वइसे जवानी के समय म जनमे लइकामन होथें।<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>धइन अय ओ मनखे</para>
  <para style="q2" vid="PSA 127:5">जेकर तरकस ह ओमन ले भरे हवय।</para>
  <para style="q1" vid="PSA 127:5">जब ओमन अदालत म अपन बिरोधीमन के सामना करहीं</para>
  <para style="q2" vid="PSA 127:5">त ओमन ला लज्जित होना नइं पड़ही।<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="cl">भजन-संहिता 128</para>
  <para style="d">आरोहन के एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>धइन अंय ओ जम्मो, जऊन मन यहोवा के भय मानथें,</para>
  <para style="q2" vid="PSA 128:1">जऊन मन ओकर हुकूम ला मानत चलथें।<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>तेंह अपन मेहनत के फल खाबे;</para>
  <para style="q2" vid="PSA 128:2">तोला आसीस मिलही अऊ तोर उन्नति होही।<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>तोर घरवाली ह तोर घर के भीतर</para>
  <para style="q2" vid="PSA 128:3">फल देवइया अंगूर के एक नार सहीं होही;</para>
  <para style="q1" vid="PSA 128:3">तोर लइकामन तोर मेज के चारों कोति</para>
  <para style="q2" vid="PSA 128:3">जैतून रूख के निकले अंकुर सहीं होहीं।<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>हव, येह ओ मनखे बर आसीस होही,</para>
  <para style="q2" vid="PSA 128:4">जऊन ह यहोवा के भय मानथे।<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>यहोवा ह सियोन ले तोला आसीस देवय;</para>
  <para style="q2" vid="PSA 128:5">तेंह अपन जिनगी भर</para>
  <para style="q2" vid="PSA 128:5">यरूसलेम के उन्नति देखत रह।<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>अपन लइकामन के लइकामन ला देखे बर जीयत रह—</para>
  <para style="q2" vid="PSA 128:6">इसरायल ला सांति मिलय।<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="cl">भजन-संहिता 129</para>
  <para style="d">आरोहन के एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>इसरायल ह कहय,</para>
  <para style="q2" vid="PSA 129:1">“मोर जवानी के समय ले ओमन मोर ऊपर बहुंत अतियाचार करे हवंय,<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>मोर जवानी के समय ले ओमन मोर ऊपर बहुंत अतियाचार करे हवंय,</para>
  <para style="q2" vid="PSA 129:2">पर ओमन ला मोर ऊपर कभू जीत नइं मिलिस।<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>नांगर चलइयामन मोर पीठ म नांगर चलाय हवंय</para>
  <para style="q2" vid="PSA 129:3">अऊ लम्बा-लम्बा घारी बनाय हवंय।<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>पर यहोवा ह धरमी ए;</para>
  <para style="q2" vid="PSA 129:4">ओह दुस्टमन के डोरी के बंधना ला काटके मोला सुतंतर कर दे हवय।”<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>जऊन मन सियोन ले घिन करथें</para>
  <para style="q2" vid="PSA 129:5">ओमन सरम के मारे लहुंट जावंय।<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>ओमन छानी ऊपर जामे कांदी सहीं होवंय,</para>
  <para style="q2" vid="PSA 129:6">जऊन ह बढ़े के पहिले अइला जाथे;<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>जेला कोनो लुवइया अपन हांथ म नइं धर सकय,</para>
  <para style="q2" vid="PSA 129:7">न ही कोनो ओला अपन हांथ म कुढ़ो सकथे।<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>जऊन मन उहां ले होके जाथें, ओमन ये झन कहंय,</para>
  <para style="q2" vid="PSA 129:8">“यहोवा के आसीस तुम्हर ऊपर होवय;</para>
  <para style="q2" vid="PSA 129:8">हमन तुमन ला यहोवा के नांव म आसीस देवत हन।”<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="cl">भजन-संहिता 130</para>
  <para style="d">आरोहन के एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>हे यहोवा, मेंह निरासा के गहरई म ले तोला पुकारत हंव;<verse eid="PSA 130:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 130:2"/>हे परभू, मोर अवाज ला सुन।</para>
  <para style="q1" vid="PSA 130:2">तोर कानमन दया के मोर गोहार ला</para>
  <para style="q2" vid="PSA 130:2">धियान देके सुनंय।<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>हे यहोवा, यदि तेंह पाप के लेखा-जोखा रखते,</para>
  <para style="q2" vid="PSA 130:3">त हे परभू, कोन ह ठहर सकतिस?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>पर तेंह छेमा करइया अस,</para>
  <para style="q2" vid="PSA 130:4">ताकि हमन आदर सहित तोर सेवा करन।<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>मेंह यहोवा के बाट जोहथंव, मोर जम्मो चीज ओकर बाट जोहत रहिथे,</para>
  <para style="q2" vid="PSA 130:5">अऊ ओकर बचन ऊपर मेंह अपन आसा रखथंव।<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>पहरेदारमन बिहनियां होय के जतेक बाट जोहथें,</para>
  <para style="q2" vid="PSA 130:6">हां, पहरेदारमन बिहनियां होय के जतेक बाट जोहथें,</para>
  <para style="q2" vid="PSA 130:6">ओकर ले जादा मेंह परभू के बाट जोहथंव।<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>हे इसरायल, यहोवा ऊपर अपन आसा रख,</para>
  <para style="q2" vid="PSA 130:7">काबरकि यहोवा म बहुंत मया हवय</para>
  <para style="q2" vid="PSA 130:7">अऊ ओहीच ह पूरा छुटकारा देथे।<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>ओह खुद इसरायलीमन ला</para>
  <para style="q2" vid="PSA 130:8">ओमन के जम्मो पाप ले छुटकारा दीही।<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="cl">भजन-संहिता 131</para>
  <para style="d">आरोहन के एक गीत। दाऊद के गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>हे यहोवा, मोर मन ह घमंडी नो हय,</para>
  <para style="q2" vid="PSA 131:1">न ही मोर आंखीमन घमंड ले चढ़े हवंय;</para>
  <para style="q1" vid="PSA 131:1">जऊन ह बड़े बात ए, या ओ बात जऊन ह मोर बर बहुंत अद्भूत ए,</para>
  <para style="q2" vid="PSA 131:1">अइसन बातमन ले मेंह कोनो मतलब नइं रखंव।<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>पर मेंह अपनआप ला सांत अऊ चुप कर ले हंव,</para>
  <para style="q2" vid="PSA 131:2">मेंह दाई के कोरा म दूध पीके पड़े एक लइका सहीं अंव;</para>
  <para style="q2" vid="PSA 131:2">दूध पीये लइका सहीं मेंह संतुस्ट हंव।<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>हे इसरायल, अब ले लेके सदाकाल तक</para>
  <para style="q2" vid="PSA 131:3">यहोवा ऊपर अपन आसा बनाय रख।<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="cl">भजन-संहिता 132</para>
  <para style="d">आरोहन के एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>हे यहोवा, दाऊद</para>
  <para style="q2" vid="PSA 132:1">अऊ ओकर जम्मो दुरदसा ला सुरता कर।<verse eid="PSA 132:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>ओह यहोवा ले एक कसम खाईस,</para>
  <para style="q2" vid="PSA 132:2">ओह याकूब के सक्तिसाली जन ले वायदा करिस:<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>“मेंह तब तक अपन घर के भीतर नइं जावंव</para>
  <para style="q2" vid="PSA 132:3">या अपन बिस्तर म नइं जावंव,<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>मेंह अपन आंखी म नींद आवन नइं दंव</para>
  <para style="q2" vid="PSA 132:4">या अपन आंखी के पलक म झपकी नइं आवन दंव,<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>जब तक कि मोला यहोवा बर एक जगह,</para>
  <para style="q2" vid="PSA 132:5">याकूब के सक्तिसाली जन बर एक निवास स्थान नइं मिल जाही।”<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>हमन ये बात एपराता म सुने हवन,</para>
  <para style="q2" vid="PSA 132:6">हमन यार<note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="1CH 13:5">1 इति 13:5</ref>, <ref loc="1CH 13:6">6</ref></char></char></note> के मैदान म घलो येला पाय हवन।<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>“आवव, ओकर निवास स्थान म चलन,</para>
  <para style="q2" vid="PSA 132:7">आवव, ओकर पांव के चउकी म ये कहिके अराधना करन,<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>‘हे यहोवा, उठ अऊ अपन बिसराम के जगह म</para>
  <para style="q2" vid="PSA 132:8">अपन सक्ति के सन्दूक के संग आ।<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>तोर पुरोहितमन तोर धरमीपन के कपड़ा पहिरंय;</para>
  <para style="q2" vid="PSA 132:9">तोर बिसवासयोग्य मनखेमन आनंद के गीत गावंय।’ ”<verse eid="PSA 132:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>अपन सेवक दाऊद के हित म,</para>
  <para style="q2" vid="PSA 132:10">अपन अभिसिक्त जन ला झन तियाग।<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>यहोवा ह दाऊद ले एक कसम खाईस,</para>
  <para style="q2" vid="PSA 132:11">एक सच्चा कसम, जेला ओह नइं टोरय:</para>
  <para style="q1" vid="PSA 132:11">“तोर खुद के संतानमन ले एक झन ला</para>
  <para style="q2" vid="PSA 132:11">तोर सिंघासन म बईठाहूं।<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>यदि तोर बेटामन मोर करार ला मानहीं</para>
  <para style="q2" vid="PSA 132:12">अऊ जऊन नियम मेंह सिखाथंव, ओमा चलहीं,</para>
  <para style="q1" vid="PSA 132:12">त ओमन के बेटामन तोर सिंघासन म</para>
  <para style="q2" vid="PSA 132:12">सदाकाल बर बईठत रहिहीं।”<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>काबरकि यहोवा ह सियोन ला चुने हवय,</para>
  <para style="q2" vid="PSA 132:13">ओह ये कहत येला अपन निवास बर पसंद करे हवय,<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“येह सदाकाल बर मोर अराम के जगह ए;</para>
  <para style="q2" vid="PSA 132:14">इहां मेंह बिराजमान होहूं, काबरकि येला मेंह पसंद करे हवंव।<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>मेंह येकर खाय-पीये के चीजमन ला बहुंत आसीस दूहूं;</para>
  <para style="q2" vid="PSA 132:15">येकर गरीब मनखेमन ला मेंह जेवन देके संतुस्ट करहूं।<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>मेंह येकर पुरोहितमन ला उद्धार के कपड़ा पहिराहूं,</para>
  <para style="q2" vid="PSA 132:16">अऊ येकर बिसवासयोग्य मनखेमन हमेसा आनंद के गीत गाहीं।<verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>“इहां मेंह दाऊद बर एक सींग<note caller="+" style="f"><char style="fr" closed="false">132:17 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">एक सक्तिसाली राजा</char></note> ला बढ़ाहूं</para>
  <para style="q2" vid="PSA 132:17">अऊ अपन अभिसिक्त जन बर एक दीया ला मढ़ाहूं।<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>मेंह ओकर बईरीमन ला लज्जा के कपड़ा पहिराहूं,</para>
  <para style="q2" vid="PSA 132:18">पर ओकर मुड़ ला चमकत मुकुट ले सोभायमान करे जाही।”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="cl">भजन-संहिता 133</para>
  <para style="d">आरोहन के एक गीत। दाऊद के गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>येह कतेक बने अऊ खुसी के बात होथे</para>
  <para style="q2" vid="PSA 133:1">जब परमेसर के मनखेमन एकता बनाके एक संग रहिथें!<verse eid="PSA 133:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>येह अइसने ए, मानो कीमती तेल ला मुड़ म डाले गीस,</para>
  <para style="q2" vid="PSA 133:2">जऊन ह दाढ़ी तक बहत हे,</para>
  <para style="q1" vid="PSA 133:2">हव, खाल्हे हारून के दाढ़ी म बहत,</para>
  <para style="q2" vid="PSA 133:2">ओकर कपड़ा के कालर तक पहुंच जाथे।<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>येह ओकर सहीं ए, मानो हेरमोन के ओस ह</para>
  <para style="q2" vid="PSA 133:3">सियोन पहाड़ ऊपर गिरत हे।</para>
  <para style="q1" vid="PSA 133:3">काबरकि ओह ओ जगह ए, जिहां यहोवा ह</para>
  <para style="q2" vid="PSA 133:3">हमेसा बर अपन आसीस अऊ जिनगी देथे।<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="cl">भजन-संहिता 134</para>
  <para style="d">आरोहन के एक गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>हे यहोवा के जम्मो सेवकमन, तुमन जऊन मन रथिया यहोवा के घर म सेवा करथव</para>
  <para style="q2" vid="PSA 134:1">यहोवा के परसंसा करव।<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>पबितर-स्थान म अपन हांथ ला ऊपर उठावव</para>
  <para style="q2" vid="PSA 134:2">अऊ यहोवा के परसंसा करव।<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>यहोवा, जऊन ह अकास अऊ धरती के रचइता ए,</para>
  <para style="q2" vid="PSA 134:3">ओह तुमन ला सियोन ले आसीस देवय।<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="cl">भजन-संहिता 135</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>यहोवा के परसंसा करव।</para>
  <para style="b" vid="PSA 135:1"/>
  <para style="q1" vid="PSA 135:1">यहोवा के नांव के परसंसा करव;</para>
  <para style="q2" vid="PSA 135:1">हे यहोवा के सेवकमन, ओकर परसंसा करव,<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>तुमन, जऊन मन यहोवा के घर म सेवा करथव,</para>
  <para style="q2" vid="PSA 135:2">तुमन, जऊन मन हमर परमेसर के घर के अंगना म सेवा करथव।<verse eid="PSA 135:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>यहोवा के परसंसा करव, काबरकि यहोवा ह बने अय,</para>
  <para style="q2" vid="PSA 135:3">ओकर नांव के परसंसा करव, काबरकि येह मन ला भाथे।<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>यहोवा ह याकूब ला अपन खुद के होय बर चुन ले हवय,</para>
  <para style="q2" vid="PSA 135:4">इसरायल ला अपन कीमती संपत्ति होय बर चुन ले हवय।<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>मेंह जानत हंव कि यहोवा ह महान ए,</para>
  <para style="q2" vid="PSA 135:5">ये घलो कि हमर परभू ह जम्मो देवतामन ले महान ए।<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>यहोवा ला जऊन बात बने लगथे,</para>
  <para style="q2" vid="PSA 135:6">ओह ओला अकास अऊ धरती म,</para>
  <para style="q2" vid="PSA 135:6">समुंदर अऊ ओकर जम्मो गहरई म करथे।<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>ओह धरती के छोर ले बादरमन ला उठाथे;</para>
  <para style="q2" vid="PSA 135:7">ओह बारिस के संग बिजली पठोथे</para>
  <para style="q2" vid="PSA 135:7">अऊ अपन भंडारघर ले हवा ला बाहिर लानथे।<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>ओह मिसर देस के पहिलांत,</para>
  <para style="q2" vid="PSA 135:8">मनखे अऊ पसुमन के पहिलांत ला मार डारिस।<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>हे मिसर देस, ओह तोर बीच म,</para>
  <para style="q2" vid="PSA 135:9">फिरौन अऊ ओकर जम्मो सेवकमन के बिरूध चिनहां अऊ चमतकार देखाईस।<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>ओह कतको जातिमन ला नास कर दीस</para>
  <para style="q2" vid="PSA 135:10">अऊ कतको सक्तिसाली राजामन ला मार डारिस—<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>याने कि अमोरीमन के राजा सीहोन,</para>
  <para style="q2" vid="PSA 135:11">बासान के राजा ओग,</para>
  <para style="q2" vid="PSA 135:11">अऊ कनान के जम्मो राजामन ला—<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>अऊ ओमन के देस ला</para>
  <para style="q2" vid="PSA 135:12">निज भाग के रूप म अपन मनखे इसरायलीमन ला दे दीस।<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>हे यहोवा, तोर नांव सदा बने रहिथे,</para>
  <para style="q2" vid="PSA 135:13">हे यहोवा, तोर खियाती जम्मो पीढ़ी म बने रहिथे।<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>काबरकि यहोवा ह अपन मनखेमन के नियाय करही</para>
  <para style="q2" vid="PSA 135:14">अऊ अपन सेवकमन ऊपर दया देखाही।<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>आनजात के मूरतीमन</para>
  <para style="q2" vid="PSA 135:15">मनखेमन के हांथ के बनाय सोन अऊ चांदी अंय।<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>ओमन के मुहूं तो हवय, पर ओमन गोठियाय नइं सकंय,</para>
  <para style="q2" vid="PSA 135:16">ओमन के आंखी तो हवय, पर देख नइं सकंय।<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>ओमन के कान तो हवय, पर सुन नइं सकंय,</para>
  <para style="q2" vid="PSA 135:17">अऊ न ही ओमन के मुहूं म सांस हवय।<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>येमन ला बनानेवालामन येमन के सहीं हो जाहीं,</para>
  <para style="q2" vid="PSA 135:18">अऊ येमन ऊपर भरोसा रखइया जम्मो झन घलो येमन सहीं हो जाहीं।<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>हे जम्मो इसरायलीमन, यहोवा के परसंसा करव;</para>
  <para style="q2" vid="PSA 135:19">हे हारून के घराना, यहोवा के परसंसा करव;<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>हे लेवी के घराना, यहोवा के परसंसा करव;</para>
  <para style="q2" vid="PSA 135:20">तुमन, जऊन मन ओकर भय मानथव, यहोवा के परसंसा करव।<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>सियोन ले यहोवा के परसंसा होवय,</para>
  <para style="q2" vid="PSA 135:21">ओकर परसंसा होवय, जऊन ह यरूसलेम म निवास करथे।</para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q1" vid="PSA 135:21">यहोवा के परसंसा होवय।<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="cl">भजन-संहिता 136</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>यहोवा ला धनबाद देवव, काबरकि ओह बने अय।</para>
  <para style="qr" vid="PSA 136:1">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>ईस्वरमन के परमेसर ला धनबाद देवव।</para>
  <para style="qr" vid="PSA 136:2">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>परभूमन के परभू ला धनबाद देवव:</para>
  <para style="qr" vid="PSA 136:3">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>ओकर छोंड़ अऊ कोनो बड़े-बड़े अद्भूत काम नइं करंय,</para>
  <para style="qr" vid="PSA 136:4">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>जऊन ह अपन समझ से अकास ला बनाईस,</para>
  <para style="qr" vid="PSA 136:5">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>जऊन ह पानी के ऊपर धरती ला फईला दीस,</para>
  <para style="qr" vid="PSA 136:6">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>जऊन ह बड़े-बड़े अंजोरमन ला बनाईस—</para>
  <para style="qr" vid="PSA 136:7">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>जऊन ह दिन म परभूता करे बर सूरज ला बनाईस,</para>
  <para style="qr" vid="PSA 136:8">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>जऊन ह रथिया ऊपर परभूता करे बर चंदा अऊ तारामन ला बनाईस;</para>
  <para style="qr" vid="PSA 136:9">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>ओला धनबाद देवव, जऊन ह मिसर देस के पहिलऊठामन ला मार डारिस,</para>
  <para style="qr" vid="PSA 136:10">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>अऊ ओमन के बीच ले इसरायलीमन ला निकाल लानिस</para>
  <para style="qr" vid="PSA 136:11">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>सक्तिसाली हांथ अऊ बढ़े हुए बाहां के दुवारा निकाल लानिस;</para>
  <para style="qr" vid="PSA 136:12">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>ओला धनबाद देवव, जऊन ह लाल-समुंदर ला अलग-अलग कर दीस</para>
  <para style="qr" vid="PSA 136:13">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>अऊ इसरायलीमन ला येकर बीच म ले पार करवा दीस,</para>
  <para style="qr" vid="PSA 136:14">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>पर फिरौन अऊ ओकर सेना ला लाल-समुंदर म बुड़ा दीस;</para>
  <para style="qr" vid="PSA 136:15">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>ओला धनबाद देवव, जऊन ह निरजन प्रदेस म अपन मनखेमन के अगुवई करिस;</para>
  <para style="qr" vid="PSA 136:16">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>ओला धनबाद देवव, जऊन ह बड़े-बड़े राजामन ला मार डारिस,</para>
  <para style="qr" vid="PSA 136:17">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>अऊ सक्तिसाली राजामन ला घलो मार डारिस—</para>
  <para style="qr" vid="PSA 136:18">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>याने कि अमोरीमन के राजा सीहोन ला मार डारिस</para>
  <para style="qr" vid="PSA 136:19">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>अऊ बासान के राजा ओग ला मार डारिस—</para>
  <para style="qr" vid="PSA 136:20">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>अऊ ओमन के देस ला निज भाग के रूप म दे दीस,</para>
  <para style="qr" vid="PSA 136:21">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>अपन सेवक इसरायलीमन ला निज भाग के रूप म दे दीस।</para>
  <para style="qr" vid="PSA 136:22">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>ओह हमन ला हमर गिरत दसा म सुरता करिस</para>
  <para style="qr" vid="PSA 136:23">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>अऊ हमन ला हमर बईरीमन ले छोंड़ाईस।</para>
  <para style="qr" vid="PSA 136:24">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>ओह हर एक परानी ला जेवन देथे।</para>
  <para style="qr" vid="PSA 136:25">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>स्वरग के परमेसर ला धनबाद देवव।</para>
  <para style="qr" vid="PSA 136:26">ओकर मया हमेसा बर बने रहिथे।<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="cl">भजन-संहिता 137</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>बेबिलोन देस के नदीमन के तीर म हमन बईठेंन</para>
  <para style="q2" vid="PSA 137:1">अऊ सियोन ला सुरता करके रोए लगेंन।<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>उहां चिनार रूखमन म</para>
  <para style="q2" vid="PSA 137:2">हमन अपन बीना ला टांग देंन,<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>काबरकि जऊन मन हमन ला बंधुवा बनाके ले गे रिहिन,</para>
  <para style="q2" vid="PSA 137:3">ओमन उहां हमन ला गीत गाय बर कहिन,</para>
  <para style="q1" vid="PSA 137:3">हमन ला सतानेवालामन हमन ला आनंद के गीत गाय बर कहिन;</para>
  <para style="q2" vid="PSA 137:3">ओमन कहिन, “हमर बर सियोन के एक गीत गावव!”<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>एक आने देस म</para>
  <para style="q2" vid="PSA 137:4">हमन यहोवा के गीत कइसे गा सकत हन?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>हे यरूसलेम, यदि मेंह तोला भूल जावंव,</para>
  <para style="q2" vid="PSA 137:5">त मोर जेवनी हांथ अपन योग्यता ला भूल जावय।<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>यदि मेंह तोला सुरता नइं करंव,</para>
  <para style="q2" vid="PSA 137:6">यदि मेंह यरूसलेम ला</para>
  <para style="q1" vid="PSA 137:6">अपन सबले बड़े आनंद नइं मानंव,</para>
  <para style="q2" vid="PSA 137:6">त मोर जीभ ह मोर तालू ले चपक जावय।<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>हे यहोवा, सुरता कर कि ओ दिन एदोमीमन का करिन,</para>
  <para style="q2" vid="PSA 137:7">जब यरूसलेम ला गिराय गीस।</para>
  <para style="q1" vid="PSA 137:7">ओमन चिचियाके कहिन, “येला फोरके गिरा दव,</para>
  <para style="q2" vid="PSA 137:7">येला येकर नीव ले गिरा दव!”<note caller="+" style="f"><char style="fr" closed="false">137:7 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="OBA 1:10-14">ओब 10‑14</ref>; <ref loc="EZK 25:12-14">यहे 25:12‑14</ref>; <ref loc="EZK 35:5-9">35:5‑9</ref></char></char></note><verse eid="PSA 137:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>हे बेटी बेबिलोन, तोर बिनास होवय,</para>
  <para style="q2" vid="PSA 137:8">ओ मनखे ह खुस रहय, जऊन ह ओ अतियाचार के मुताबिक</para>
  <para style="q2" vid="PSA 137:8">तोर ले बदला लेथे, जेला तेंह हमर ऊपर करे हस।<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>ओ मनखे ह खुस रहय, जऊन ह तोर लइकामन ला पकड़के</para>
  <para style="q2" vid="PSA 137:9">चट्टान ऊपर पटक देथे।<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="cl">भजन-संहिता 138</para>
  <para style="d">दाऊद के गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>हे यहोवा, मेंह अपन पूरा मन से तोर परसंसा करहूं;</para>
  <para style="q2" vid="PSA 138:1">देवतामन के आघू म मेंह तोर परसंसा के गीत गाहूं।<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>तोर बहुंत मया अऊ तोर बिसवासयोग्यता के कारन</para>
  <para style="q2" vid="PSA 138:2">मेंह तोर पबितर मंदिर कोति मुड़ नवाहूं</para>
  <para style="q2" vid="PSA 138:2">अऊ तोर नांव के परसंसा करहूं,</para>
  <para style="q1" vid="PSA 138:2">काबरकि तेंह अपन पबितर बचन ला</para>
  <para style="q2" vid="PSA 138:2">अऊ अपन महिमा ला सबले ऊपर करे हस।<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>जब मेंह तोला पुकारेंव, त तेंह मोर पराथना के उत्तर देय;</para>
  <para style="q2" vid="PSA 138:3">तेंह मोला बहुंत हिम्मत दे हस।<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>हे यहोवा, जब धरती के जम्मो राजामन तोर बचन ला सुनंय,</para>
  <para style="q2" vid="PSA 138:4">त ओमन तोर परसंसा करंय।<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>ओमन यहोवा के बिधिमन के गीत गावंय,</para>
  <para style="q2" vid="PSA 138:5">काबरकि यहोवा के महिमा ह महान ए।<verse eid="PSA 138:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>हालाकि यहोवा के दरजा बहुंत ऊपर हे, पर ओह नम्र मनखेमन ऊपर दया देखाथे;</para>
  <para style="q2" vid="PSA 138:6">हालाकि ओह बहुंत ऊंचहा हे, पर ओह ओमन ला दूरिहा ले देखथे।<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>हालाकि मेंह समस्या म ले होके जाथंव,</para>
  <para style="q2" vid="PSA 138:7">पर तेंह मोर जिनगी ला बनाय रखथस।</para>
  <para style="q1" vid="PSA 138:7">तेंह मोर बईरीमन के कोरोध के बिरूध अपन हांथ बढ़ाथस;</para>
  <para style="q2" vid="PSA 138:7">अपन जेवनी हांथ के दुवारा तेंह मोला बचाथस।<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>यहोवा ह मोर रकछा करही,</para>
  <para style="q2" vid="PSA 138:8">हे यहोवा, तोर मया ह हमेसा बर बने रहिथे—</para>
  <para style="q2" vid="PSA 138:8">अपन हांथ के काममन ला झन तियाग दे।<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="cl">भजन-संहिता 139</para>
  <para style="d">संगीत निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>हे यहोवा, तेंह मोला जांचे हस,</para>
  <para style="q2" vid="PSA 139:1">अऊ तेंह मोला जानथस।<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>मेंह कब उठथंव अऊ कब बईठथंव, तेंह जानथस,</para>
  <para style="q2" vid="PSA 139:2">तेंह मोर बिचारमन ला दूरिहा ले ही समझ लेथस।<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>तेंह मोर जवई अऊ मोर लेटई ला जानथस;</para>
  <para style="q2" vid="PSA 139:3">तोला मोर जम्मो बात के जानकारी हवय।<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>हे यहोवा, येकर पहिले कि कोनो बात मोर मुहूं म आवय</para>
  <para style="q2" vid="PSA 139:4">तेंह ओला पूरा जानथस।<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>तेंह मोला आघू-पाछू ले घेरे रहिथस,</para>
  <para style="q2" vid="PSA 139:5">अऊ तेंह मोर ऊपर अपन हांथ रखथस।<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>अइसने गियान ह मोर बर बहुंत अद्भूत ए,</para>
  <para style="q2" vid="PSA 139:6">येला पाना मोर बर बहुंत दूरिहा के बात ए।<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>तोर आतमा ले बचके मेंह कहां जा सकथंव?</para>
  <para style="q2" vid="PSA 139:7">तोर आघू ले बचके मेंह कहां भाग सकथंव?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>कहूं मेंह अकास ऊपर जावंव, त तेंह उहां हस;</para>
  <para style="q2" vid="PSA 139:8">कहूं मेंह अपन दसना गहरई म दसावंव, त तेंह उहां हस।<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>कहूं मेंह उठके बड़े बिहनियां के डेना म बईठके दूरिहा चले जावंव,</para>
  <para style="q2" vid="PSA 139:9">कहूं मेंह दूरिहा समुंदर म बस जावंव,<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>त उहां घलो तोर हांथ ह मोर अगुवई करही,</para>
  <para style="q2" vid="PSA 139:10">तोर जेवनी हांथ ह मोला मजबूती से थामे रहिही।<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>कहूं मेंह कहंव, “खचित अंधियार ह मोला छुपा लीही</para>
  <para style="q2" vid="PSA 139:11">अऊ चारों कोति के अंजोर ह रथिया के अंधियार हो जाही,”<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>तभो ले अंधियार ह तोर बर अंधियार नइं होही;</para>
  <para style="q2" vid="PSA 139:12">रथिया ह दिन के सहीं चमकही,</para>
  <para style="q2" vid="PSA 139:12">काबरकि अंधियार ह तोर बर अंजोर सहीं अय।<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>काबरकि तेंह मोर भीतरी भाग ला बनाय हस;</para>
  <para style="q2" vid="PSA 139:13">तेंह मोर दाई के गरभ म मोला एक संग जोड़े हस।<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>मेंह तोर परसंसा करथंव काबरकि मेंह भयानक अऊ अद्भूत रीति से बनाय गे हवंव;</para>
  <para style="q2" vid="PSA 139:14">तोर काममन अद्भूत अंय,</para>
  <para style="q2" vid="PSA 139:14">मेंह ओला बने करके जानथंव।<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>जब मोला गुपत जगह म बनाय गीस,</para>
  <para style="q2" vid="PSA 139:15">जब मोला धरती के गहरई म एक संग बुने गीस,</para>
  <para style="q2" vid="PSA 139:15">त मोर ढांचा ह तोर ले छुपे नइं रिहिस।<verse eid="PSA 139:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16"/>तोर आंखी ह मोर बिगर आकार के देहें ला देखिस;</para>
  <para style="q2" vid="PSA 139:16">मोर देहें के अंग, जऊन मन बनत जावत रिहिन,</para>
  <para style="q2" vid="PSA 139:16">ओमन रचे जाय के पहिले तोर किताब म लिखाय रिहिन।<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>हे परमेसर, तोर बिचारमन मोर बर कतेक कीमती अंय!</para>
  <para style="q2" vid="PSA 139:17">कुल मिलाके ओमन के जोड़ ह कतेक बड़े हे!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>कहूं मेंह ओमन के गनती करंव,</para>
  <para style="q2" vid="PSA 139:18">त ओमन के गनती बालू के कन ले घलो जादा होही—</para>
  <para style="q2" vid="PSA 139:18">जब मेंह जागथंव, तब भी मेंह तोर संग रहिथंव।<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>हे परमेसर, बने होतिस कि तेंह दुस्टमन ला मार डारते!</para>
  <para style="q2" vid="PSA 139:19">हे खून के पीयासा मनखेमन, मोर ले दूरिहा हटव!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>ओमन तोर बारे म बुरई के इरादा से बात करथें;</para>
  <para style="q2" vid="PSA 139:20">तोर बिरोधीमन तोर नांव के गलत उपयोग करथें।<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>हे यहोवा, का मेंह ओमन ले घिन नइं करंव, जऊन मन तोर ले घिन करथें,</para>
  <para style="q2" vid="PSA 139:21">अऊ का ओमन ले घिन नइं करंव, जऊन मन तोर बिरूध बिदरोह करथें?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>मोर करा ओमन बर घिन करे के अलावा अऊ कुछू नइं ए;</para>
  <para style="q2" vid="PSA 139:22">मेंह ओमन ला अपन बईरी समझथंव।<verse eid="PSA 139:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>हे परमेसर, मोला जांचके मोर हिरदय ला जान ले;</para>
  <para style="q2" vid="PSA 139:23">मोला परखके मोर उत्सुक बिचारमन ला जान ले।<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>देख कि कहूं मोर म कोनो खराप चाल तो नइं ए,</para>
  <para style="q2" vid="PSA 139:24">अऊ अनंत के रसता म मोर अगुवई कर।<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="cl">भजन-संहिता 140<note caller="+" style="f"><char style="fr" closed="false">140 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 140:1-13">140:1‑13</ref></char> ला 140:2‑14 गने गे हवय</char></note></para>
  <para style="d">संगीत के निरदेसक बर दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>हे यहोवा, मोला दुस्ट काम करइयामन ले छुड़ा;</para>
  <para style="q2" vid="PSA 140:1">हिंसा करइयामन ले मोला बचा,<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>जऊन मन अपन मन म दुस्ट काम करे के योजना बनाथें</para>
  <para style="q2" vid="PSA 140:2">अऊ हर दिन लड़े बर भड़कावत रहिथें।<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>ओमन के बोलई ह सांप के काटे सहीं अय;</para>
  <para style="q2" vid="PSA 140:3">ओमन के ओंठ म करैत सांप के जहर हवय।<verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>हे यहोवा, दुस्ट मनखेमन के हांथ ले मोर रकछा कर;</para>
  <para style="q2" vid="PSA 140:4">हिंसक मनखेमन ले मोला बचा,</para>
  <para style="q2" vid="PSA 140:4">जऊन मन मोर पांव म चोट पहुंचाय के योजना बनाय हवंय।<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>घमंडी मनखेमन मोला फंसाय बर फांदा छुपाय हवंय;</para>
  <para style="q2" vid="PSA 140:5">ओमन अपन जाल के डोर ला बिछाय हवंय</para>
  <para style="q2" vid="PSA 140:5">अऊ मोर रसता म मोर बर फांदा लगाय हवंय।<verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>मेंह यहोवा ले कहिथंव, “तेंह मोर परमेसर अस।”</para>
  <para style="q2" vid="PSA 140:6">हे यहोवा, दया के मोर पुकार ला सुन।<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>हे परमपरधान यहोवा, तेंह सामर्थी छुड़ानेवाला अस,</para>
  <para style="q2" vid="PSA 140:7">तेंह लड़ई के दिन म मोर मुड़ के ढाल बनथस।<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>हे यहोवा, दुस्टमन के ईछा ला पूरा झन कर;</para>
  <para style="q2" vid="PSA 140:8">ओमन के योजना ला सफल झन होवन दे।<verse eid="PSA 140:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>जऊन मन मोला चारों कोति ले घेरे हवंय अऊ घमंड से मुड़ उठाय हवंय;</para>
  <para style="q2" vid="PSA 140:9">ओमन के मुहूं के दुस्टता के बात ओहीचमन ला खा जावय।<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>बरत कोइला ओमन ऊपर गिरय;</para>
  <para style="q2" vid="PSA 140:10">ओमन ला आगी म झोंके जावय,</para>
  <para style="q2" vid="PSA 140:10">ओमन चीखला ले भरे खंचवा म फटिक दिये जावंय, जिहां ले ओमन कभू उठ नइं सकंय।<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>निन्दा करइयामन देस म स्थापित झन होवंय;</para>
  <para style="q2" vid="PSA 140:11">हिंसा करइयामन ऊपर बिपत्ति पड़य।<verse eid="PSA 140:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>मेंह जानथंव कि यहोवा ह गरीब-दुखीमन के नियाय करथे</para>
  <para style="q2" vid="PSA 140:12">अऊ जरूरतमंद के मामला ला संभालथे।<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>खचित धरमीमन तोर नांव के परसंसा करहीं</para>
  <para style="q2" vid="PSA 140:13">अऊ ईमानदारमन तोर आघू म रहिहीं।<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="cl">भजन-संहिता 141</para>
  <para style="d">दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>हे यहोवा, मेंह तोला पुकारत हंव, मोर करा जल्दी आ;</para>
  <para style="q2" vid="PSA 141:1">जब मेंह तोला पुकारंव, त मोर बात ला सुन।<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>मोर पराथना ह तोर आघू म खुसबूदार धूप के सहीं होवय;</para>
  <para style="q2" vid="PSA 141:2">मोर हांथ के ऊपर उठई सांझ के बलिदान सहीं होवय।<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>हे यहोवा, मोर मुहूं म एक पहरेदार बईठा दे;</para>
  <para style="q2" vid="PSA 141:3">मोर ओंठ रूपी दुवार के रखवारी कर।<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>मोर मन ला दुस्टमन कोति झन लगा</para>
  <para style="q2" vid="PSA 141:4">ताकि मेंह ओ दुस्ट काम करइयामन संग</para>
  <para style="q1" vid="PSA 141:4">ओमन के दुस्ट काम म भाग झन लेवंव;</para>
  <para style="q2" vid="PSA 141:4">मोला ओमन के सुवादवाले जेवन ला झन खावन दे।<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>धरमी जन ह मोला मारय—मोर ऊपर येह एक दया के बात होही;</para>
  <para style="q2" vid="PSA 141:5">ओह मोला डांटय—येह मोर मुड़ म तेल चुपरे सहीं होही।</para>
  <para style="q1" vid="PSA 141:5">मोर मुड़ ह येला इनकार नइं करही,</para>
  <para style="q2" vid="PSA 141:5">काबरकि मोर पराथना ह तब भी दुस्ट काम करइयामन के बिरूध होही।<verse eid="PSA 141:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>ओमन के सासन करइयामन ला खड़े चट्टान म ले फटिक दिये जाही,</para>
  <para style="q2" vid="PSA 141:6">अऊ दुस्ट मनखेमन जान जाहीं कि मोर बातमन सही अंय।<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>ओमन कहिहीं, “जइसे नांगर जोते के बाद माटी ह टूटके बिखर जाथे,</para>
  <para style="q2" vid="PSA 141:7">वइसे ही हमर हाड़ामन ला कबर के मुहूं म बगरा दिये गे हवय।”<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>पर हे परमपरधान यहोवा, मोर आंखी ह तोर ऊपर लगे हवय;</para>
  <para style="q2" vid="PSA 141:8">तोर करा मेंह सरन लेथंव—मोला मिरतू के हांथ म झन दे।<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>मोला दुस्टमन के लगाय गय फांदा ले बचा,</para>
  <para style="q2" vid="PSA 141:9">ओ फांदा जेला ओमन मोर बर लगाय हवंय।<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>दुस्टमन अपन लगाय गय जाल म खुद फंसंय,</para>
  <para style="q2" vid="PSA 141:10">अऊ मेंह सही-सलामत बचके निकल जावंव।<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="cl">भजन-संहिता 142<note caller="+" style="f"><char style="fr" closed="false">142 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="PSA 142:1-7">142:1‑7</ref></char> ला 142:2‑8 गने गे हवय</char></note></para>
  <para style="d">दाऊद के एक <char style="tl">मसकील</char><note caller="+" style="f"><char style="fr" closed="false">142:0 </char><char style="fl" closed="false">संभवतः संगीत के एक सबद</char></note>, जब ओह गुफा म रिहिस। एक पराथना।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>मेंह यहोवा ला ऊंचहा अवाज म पुकारथंव;</para>
  <para style="q2" vid="PSA 142:1">मेंह यहोवा ला दया करे बर जोर से गोहारथंव।<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>मेंह ओकर आघू म अपन सिकायत ला खुलके बताथंव;</para>
  <para style="q2" vid="PSA 142:2">ओकर आघू म मेंह अपन समस्या ला बताथंव।<verse eid="PSA 142:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>जब मोर आतमा ह मोर भीतरे-भीतर बियाकुल होथे,</para>
  <para style="q2" vid="PSA 142:3">तब तेंहीच ह मोर दसा ला देखथस।</para>
  <para style="q1" vid="PSA 142:3">जऊन रसता म मेंह चलथंव, ओ रसता म</para>
  <para style="q2" vid="PSA 142:3">मनखेमन मोर बर फंदा लगाय हवंय।<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>देख, मोर जेवनी कोति कोनो नइं एं;</para>
  <para style="q2" vid="PSA 142:4">मोर कोनो चिंता नइं करंय।</para>
  <para style="q1" vid="PSA 142:4">मोर कोनो सरन-स्थान नइं ए;</para>
  <para style="q2" vid="PSA 142:4">कोनो मोर जिनगी ऊपर धियान नइं देवंय।<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>हे यहोवा, मेंह तोला पुकारत हंव;</para>
  <para style="q2" vid="PSA 142:5">मेंह कहिथंव, “तेंह मोर सरन-स्थान,</para>
  <para style="q2" vid="PSA 142:5">अऊ जीयत परानीमन के देस म मोर भाग अस।”<verse eid="PSA 142:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>मोर पुकार ला सुन,</para>
  <para style="q2" vid="PSA 142:6">काबरकि मेंह बहुंत जरूरत म हवंव;</para>
  <para style="q1" vid="PSA 142:6">जऊन मन मोर पीछा करथें, ओमन ले मोला बचा,</para>
  <para style="q2" vid="PSA 142:6">काबरकि ओमन मोर ले बहुंत ताकतवर अंय।<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>मोला मोर जेल ले छोंड़ा ले,</para>
  <para style="q2" vid="PSA 142:7">ताकि मेंह तोर परसंसा करंव।</para>
  <para style="q1" vid="PSA 142:7">तब मोर ऊपर तोर भलई के कारन</para>
  <para style="q2" vid="PSA 142:7">धरमी मनखेमन मोर चारों कोति जूरहीं।<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="cl">भजन-संहिता 143</para>
  <para style="d">दाऊद के एक भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>हे यहोवा, मोर पराथना ला सुन,</para>
  <para style="q2" vid="PSA 143:1">दया के मोर गोहार ला सुन;</para>
  <para style="q1" vid="PSA 143:1">अपन बिसवासयोग्यता अऊ धरमीपन के कारन</para>
  <para style="q2" vid="PSA 143:1">मोर मदद करे बर आ।<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>अपन सेवक ला नियाय के आघू म झन लान,</para>
  <para style="q2" vid="PSA 143:2">काबरकि कोनो जीयत मनखे तोर आघू म धरमी नो हय।<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>बईरी ह मोर पीछा करथे,</para>
  <para style="q2" vid="PSA 143:3">ओह मोला कुचरके माटी म मिला देथे;</para>
  <para style="q1" vid="PSA 143:3">बहुंत पहिले मरे मनखेमन सहीं</para>
  <para style="q2" vid="PSA 143:3">ओह मोला अंधियार म डार देथे।<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>एकरसेति मोर आतमा ह भीतरे-भीतर बियाकुल होवत हे,</para>
  <para style="q2" vid="PSA 143:4">मोर मन ह भीतरे-भीतर भयभीत हवय।<verse eid="PSA 143:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>मेंह बहुंत पहिले के दिनमन ला सुरता करथंव;</para>
  <para style="q2" vid="PSA 143:5">मेंह तोर जम्मो काम ऊपर मनन-चिंतन करथंव</para>
  <para style="q2" vid="PSA 143:5">अऊ जऊन कुछू तेंह करे हस, ओकर ऊपर बिचार करथंव।<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>मेंह तोर कोति अपन हांथ बढ़ावत हंव;</para>
  <para style="q2" vid="PSA 143:6">मेंह सूखा भुइयां सहीं तोर बर पीयासन हंव।<verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>हे यहोवा, मोला जल्दी जबाब दे;</para>
  <para style="q2" vid="PSA 143:7">मोर आतमा ह दुरबल होवत हे।</para>
  <para style="q1" vid="PSA 143:7">अपन चेहरा ला मोर ले झन छिपा</para>
  <para style="q2" vid="PSA 143:7">नइं तो मेंह ओमन सहीं हो जाहूं, जऊन मन खाल्हे कबर म चले जाथें।<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>बिहनियां ह मोर बर तोर अटूट मया के खबर लानय,</para>
  <para style="q2" vid="PSA 143:8">काबरकि मेंह तोर ऊपर भरोसा करे हवंव।</para>
  <para style="q1" vid="PSA 143:8">मोला ओ डहार देखा, जेमा मोला चलना चाही,</para>
  <para style="q2" vid="PSA 143:8">काबरकि मेंह अपन जिनगी तोला सऊंपत हंव।<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>हे यहोवा, मोला मोर बईरीमन ले बचा,</para>
  <para style="q2" vid="PSA 143:9">काबरकि मेंह अपनआप ला तोर आड़ म छुपावत हंव।<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>तोर ईछा ला पूरा करे के बात मोला सिखा,</para>
  <para style="q2" vid="PSA 143:10">काबरकि तेंह मोर परमेसर अस;</para>
  <para style="q1" vid="PSA 143:10">तोर बने आतमा ह</para>
  <para style="q2" vid="PSA 143:10">मोला समतल भुइयां म ले चलय।<verse eid="PSA 143:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>हे यहोवा, अपन नांव के हित म, मोर जिनगी ला बनाय रख;</para>
  <para style="q2" vid="PSA 143:11">अपन धरमीपन के कारन, मोला समस्या ले बाहिर निकाल।<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>अपन अटूट मया के कारन, मोर बईरीमन के मुहूं ला बंद कर दे;</para>
  <para style="q2" vid="PSA 143:12">मोर जम्मो बिरोधीमन ला नास कर दे,</para>
  <para style="q2" vid="PSA 143:12">काबरकि मेंह तोर सेवक अंव।<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="cl">भजन-संहिता 144</para>
  <para style="d">दाऊद के भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>यहोवा, जऊन ह मोर चट्टान ए, ओकर परसंसा होवय,</para>
  <para style="q2" vid="PSA 144:1">जऊन ह मोर हांथ अऊ मोर अंगरीमन ला</para>
  <para style="q2" vid="PSA 144:1">लड़ई करे बर तियार करथे।<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>ओह मोर मयारू परमेसर अऊ मोर किला,</para>
  <para style="q2" vid="PSA 144:2">मोर मजबूत गढ़ अऊ मोर छुड़ानेवाला,</para>
  <para style="q1" vid="PSA 144:2">मोर ढाल ए, जेमा मेंह सरन लेथंव,</para>
  <para style="q2" vid="PSA 144:2">जऊन ह मनखेमन<note caller="+" style="f"><char style="fr" closed="false">144:2 </char><char style="ft" closed="false">जादा हस्तलिपि म </char><char style="fqa" closed="false">मोर मनखेमन </char><char style="ft" closed="false">लिखाय हवय</char></note> ला मोर अधीन कर देथे।<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>हे यहोवा, मनखेमन का अंय कि तेंह ओमन के खियाल रखथस?</para>
  <para style="q2" vid="PSA 144:3">ओमन सिरिप मरनहार मनखे अंय, जेमन के बारे म तेंह सोचथस।<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>ओमन तो सांस के सहीं अंय;</para>
  <para style="q2" vid="PSA 144:4">ओमन के उमर ह ढरत छइहां सहीं अय।<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>हे यहोवा, अपन स्वरग ला खाल्हे करके उतर आ;</para>
  <para style="q2" vid="PSA 144:5">पहाड़मन ला छू, ताकि ओमन ले धुआं निकलय।<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>बिजली कड़काके बईरी ला तितिर-बितिर कर दे;</para>
  <para style="q2" vid="PSA 144:6">अपन तीर चला अऊ ओमन ला हराके भगा दे।<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>ऊंच स्थान ले अपन हांथ बढ़ा;</para>
  <para style="q2" vid="PSA 144:7">भयंकर पानी ले</para>
  <para style="q1" vid="PSA 144:7">अऊ ओ परदेसीमन के हांथ ले</para>
  <para style="q2" vid="PSA 144:7">मोला छोंड़ा अऊ मोला बचा,<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>जेमन के मुहूं ले बहुंत लबारी बात निकलथे,</para>
  <para style="q2" vid="PSA 144:8">जेमन के जेवनी हांथ ह धोखा के काम करथे।<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>हे मोर परमेसर, मेंह तोर बर एक नवां गीत गाहूं;</para>
  <para style="q2" vid="PSA 144:9">दस तारवाले बीना ला मेंह तोर बर बजाहूं,<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>तें, जऊन ह कि राजामन ला जय देथस,</para>
  <para style="q2" vid="PSA 144:10">जऊन ह कि अपन सेवक दाऊद ला छोंड़ाथस।</para>
  <para style="b" vid="PSA 144:10"/>
  <para style="q3" vid="PSA 144:10">धारवाले तलवार ले मोला बचा;<verse eid="PSA 144:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>परदेसीमन के हांथ ले मोला बचा</para>
  <para style="q2" vid="PSA 144:11">जेमन के मुहूं ले बहुंत लबारी बात निकलथे,</para>
  <para style="q2" vid="PSA 144:11">जेमन के जेवनी हांथ ह धोखा के काम करथे।<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>तब हमर बेटामन अपन जवानी म</para>
  <para style="q2" vid="PSA 144:12">बढ़िया बढ़े हुए पऊधामन सहीं होहीं,</para>
  <para style="q1" vid="PSA 144:12">अऊ हमर बेटीमन ओ खंभामन सहीं होहीं</para>
  <para style="q2" vid="PSA 144:12">जेला महल के सजावट म नक्कासी करे जाथे।<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>हमर कोठारमन हर किसम के</para>
  <para style="q2" vid="PSA 144:13">अनाज ले भरे रहिहीं।</para>
  <para style="q1" vid="PSA 144:13">हमर भेड़मन हमर मैदान म हजार के संखिया,</para>
  <para style="q2" vid="PSA 144:13">दस हजार के संखिया म बढ़हीं;<verse eid="PSA 144:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 144:14"/>हमर बईलामन भारी सामान खींचके ले जाहीं।<note caller="+" style="f"><char style="fr" closed="false">144:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">हमर जाति के सरदार ह अटल बने रहिही</char></note></para>
  <para style="q1" vid="PSA 144:14">दीवार म कोनो किसम के सेंध नइं लगही,</para>
  <para style="q2" vid="PSA 144:14">कोनो बंधुवई म नइं जाही,</para>
  <para style="q2" vid="PSA 144:14">हमर गलीमन म दुख के कोनो अवाज नइं होही।<verse eid="PSA 144:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>धइन अंय ओ मनखेमन, जेमन बर ये बात सही ए;</para>
  <para style="q2" vid="PSA 144:15">धइन अंय ओ मनखेमन, जेमन के परमेसर यहोवा ए।<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="cl">भजन-संहिता 145</para>
  <para style="d">परसंसा के एक भजन। दाऊद के भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>हे मोर परमेसर, मोर राजा, मेंह तोर नांव ला ऊपर करहूं;</para>
  <para style="q2" vid="PSA 145:1">मेंह तोर नांव के परसंसा सदा-सर्वदा करहूं।<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>हर दिन मेंह तोर परसंसा करहूं</para>
  <para style="q2" vid="PSA 145:2">सदा-सर्वदा तोर नांव के इस्तुति करहूं।<verse eid="PSA 145:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>यहोवा ह महान ए अऊ सबले जादा परसंसा के योग्य ए;</para>
  <para style="q2" vid="PSA 145:3">ओकर महानता ला कोनो समझ नइं सकंय।<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>एक पीढ़ी के मनखेमन तोर काम के बारे म आने पीढ़ी के मनखेमन ला बताथें;</para>
  <para style="q2" vid="PSA 145:4">ओमन तोर पराकरम के काम के बारे म बताथें।<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>ओमन तोर वैभव के महिमामय सोभा के बारे म गोठियाथें—</para>
  <para style="q2" vid="PSA 145:5">अऊ मेंह तोर अद्भूत काम ऊपर मनन-चिंतन करहूं।<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>ओमन तोर अद्भूत काममन के सक्ति के चरचा करथें—</para>
  <para style="q2" vid="PSA 145:6">अऊ मेंह तोर बड़े-बड़े काममन के घोसना करहूं।<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>ओमन तोर बहुंत भलई के काम के उत्सव मनाथें</para>
  <para style="q2" vid="PSA 145:7">अऊ आनंद सहित तोर धरमीपन के गीत गाथें।<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>यहोवा ह अनुग्रहकारी अऊ दयालु अय,</para>
  <para style="q2" vid="PSA 145:8">कोरोध करे म धीमा अऊ मया के धनी अय।<verse eid="PSA 145:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>यहोवा ह जम्मो झन बर बने अय;</para>
  <para style="q2" vid="PSA 145:9">ओह अपन बनाय हर चीज ऊपर दया करथे।<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>हे यहोवा, तोर जम्मो काममन के दुवारा तोर परसंसा होथे;</para>
  <para style="q2" vid="PSA 145:10">तोर बिसवासयोग्य मनखेमन तोर बहुंत परसंसा करथें।<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>ओमन तोर राज के महिमा के बारे म बताथें</para>
  <para style="q2" vid="PSA 145:11">अऊ तोर सक्ति के बारे म गोठियाथें,<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>ताकि जम्मो मनखेमन तोर पराकरम के काम</para>
  <para style="q2" vid="PSA 145:12">अऊ तोर राज के महिमामय सोभा के बारे म जानंय।<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>तोर राज ह एक कभू खतम नइं होनेवाला राज ए,</para>
  <para style="q2" vid="PSA 145:13">अऊ तोर परभूता ह जम्मो पीढ़ी म बने रहिथे।</para>
  <para style="b" vid="PSA 145:13"/>
  <para style="q1" vid="PSA 145:13">यहोवा ह अपन जम्मो परतिगियां ला पूरा करे म बिसवासयोग्य अय</para>
  <para style="q2" vid="PSA 145:13">अऊ अपन जम्मो काम म घलो बिसवासयोग्य अय।<note caller="+" style="f"><char style="fr" closed="false">145:13 </char><char style="ft" closed="false">मासोरेटिक मूल-ग्रंथ के बहुंत अकन हस्तलिपि म <char style="xt" link-href="PSA 145:13"><ref loc="PSA 145:13">पद 13</ref></char> के आखिरी के दू पंक्ति नइं ए</char></note><verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>यहोवा ह ओ जम्मो ला संभालथे, जेमन खाल्हे गिरथें</para>
  <para style="q2" vid="PSA 145:14">अऊ जऊन मन खाल्हे झुकथें, ओमन ला ऊपर उठाथे।<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>जम्मो झन के आंखी ह तोर ऊपर लगे रहिथे,</para>
  <para style="q2" vid="PSA 145:15">अऊ तेंह ओमन ला सही समय म ओमन के जेवन देथस।<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>तेंह अपन हांथ खोलके</para>
  <para style="q2" vid="PSA 145:16">जम्मो जीयत परानी के ईछा ला पूरा करथस।<verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>यहोवा ह अपन जम्मो बात म धरमी</para>
  <para style="q2" vid="PSA 145:17">अऊ अपन जम्मो काम म बिसवासयोग्य ए।<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>यहोवा ह ओ जम्मो के लकठा म रहिथे,</para>
  <para style="q2" vid="PSA 145:18">जऊन मन ओला पुकारथें याने कि जऊन मन ओला सच्चई से पुकारथें।<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>ओह ओमन के ईछा ला पूरा करथे, जऊन मन ओकर भय मानथें;</para>
  <para style="q2" vid="PSA 145:19">ओह ओमन के गोहार ला सुनथे अऊ ओमन ला बचाथे।<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>यहोवा ह ओ जम्मो के रखवारी करथे, जऊन मन ओकर ले मया करथें,</para>
  <para style="q2" vid="PSA 145:20">पर जम्मो दुस्टमन ला ओह नास कर दीही।<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>मोर मुहूं ह यहोवा के परसंसा के बात करही।</para>
  <para style="q2" vid="PSA 145:21">हर एक परानी ओकर पबितर नांव के</para>
  <para style="q2" vid="PSA 145:21">सदा-सर्वदा परसंसा करय।<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="cl">भजन-संहिता 146</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>यहोवा के परसंसा करव।</para>
  <para style="b" vid="PSA 146:1"/>
  <para style="q1" vid="PSA 146:1">हे मोर मन, यहोवा के परसंसा कर।<verse eid="PSA 146:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>मेंह जिनगी भर यहोवा के परसंसा करहूं,</para>
  <para style="q2" vid="PSA 146:2">जब तक मेंह जीयत रहिहूं, मेंह अपन परमेसर के परसंसा के गीत गाहूं।<verse eid="PSA 146:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>हाकिममन ऊपर भरोसा झन रखव,</para>
  <para style="q2" vid="PSA 146:3">न ही कोनो मनखे ऊपर, जऊन ह कि रकछा नइं कर सकय।<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>जब ओमन के परान चले जाथे, त ओमन माटी म मिल जाथें;</para>
  <para style="q2" vid="PSA 146:4">ओहीच दिन ओमन के योजना ह खतम हो जाथे।<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>धइन अंय ओमन, जेमन के मददगार याकूब के परमेसर ए,</para>
  <para style="q2" vid="PSA 146:5">जेमन के आसा ह यहोवा ओमन के परमेसर ऊपर रहिथे।<verse eid="PSA 146:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>ओह अकास अऊ धरती, समुंदर,</para>
  <para style="q2" vid="PSA 146:6">अऊ ओमा के जम्मो चीजमन ला रचे हवय—</para>
  <para style="q2" vid="PSA 146:6">ओह हमेसा बिसवासयोग्य बने रहिथे।<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>ओह दुखित-पीड़ितमन के नियाय करथे</para>
  <para style="q2" vid="PSA 146:7">अऊ भूखन मनखेमन ला जेवन देथे।</para>
  <para style="q1" vid="PSA 146:7">यहोवा ह कैदीमन ला छुड़ाथे,<verse eid="PSA 146:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 146:8"/>यहोवा ह अंधरा ला आंखी देथे,</para>
  <para style="q1" vid="PSA 146:8">यहोवा ह ओमन ला ऊपर उठाथे, जऊन मन खाल्हे झुकथें,</para>
  <para style="q2" vid="PSA 146:8">यहोवा ह धरमीमन ले मया करथे।<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>यहोवा ह परदेसीमन के रखवारी करथे</para>
  <para style="q2" vid="PSA 146:9">अऊ अनाथ अऊ बिधवामन ला संभालथे,</para>
  <para style="q2" vid="PSA 146:9">पर ओह दुस्टमन के योजना ला बिगाड़ देथे।<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>यहोवा ह सदा-सर्वदा राज करथे,</para>
  <para style="q2" vid="PSA 146:10">हे सियोन, तोर परमेसर ह पीढ़ी-पीढ़ी तक राज करथे।</para>
  <para style="b" vid="PSA 146:10"/>
  <para style="q1" vid="PSA 146:10">यहोवा के परसंसा करव।<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="cl">भजन-संहिता 147</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>यहोवा के परसंसा करव।</para>
  <para style="b" vid="PSA 147:1"/>
  <para style="q1" vid="PSA 147:1">हमर परमेसर के परसंसा के गीत गवई ह उत्तम बात ए,</para>
  <para style="q2" vid="PSA 147:1">ओकर परसंसा करई ह उत्तम अऊ खुसी के बात ए!<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>यहोवा ह यरूसलेम ला बनाथे;</para>
  <para style="q2" vid="PSA 147:2">ओह इसरायल के बंधुवई म गय मनखेमन ला इकट्ठा करथे।<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>ओह निरास-हतास मनखेमन के दुख ला दूर करथे</para>
  <para style="q2" vid="PSA 147:3">अऊ ओमन के घाव म पट्टी बांधथे।<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>ओह तारामन के संखिया ला निरधारित करथे</para>
  <para style="q2" vid="PSA 147:4">अऊ ओमा के हर एक के नांव रखथे।<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>महान ए हमर परभू अऊ अति सामर्थी ए;</para>
  <para style="q2" vid="PSA 147:5">ओकर समझ के कोनो सीमना नइं ए।<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>यहोवा ह नम्र मनखे ला संभाले रखथे</para>
  <para style="q2" vid="PSA 147:6">पर दुस्ट मनखे ला भुइयां म गिरा देथे।<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>धनबाद के संग यहोवा के परसंसा के गीत गावव;</para>
  <para style="q2" vid="PSA 147:7">हमर परमेसर बर बीना बजावव।<verse eid="PSA 147:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>ओह अकास ला बादरमन ले ढांपथे;</para>
  <para style="q2" vid="PSA 147:8">ओह धरती ऊपर बारिस भेजथे</para>
  <para style="q2" vid="PSA 147:8">अऊ पहाड़ीमन म कांदी उगाथे।<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>ओह पसुमन ला आहार देथे</para>
  <para style="q2" vid="PSA 147:9">अऊ जब कऊआ चिरई के पीलामन चिचियाथें, त ओमन ला चारा खवाथे।<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>ओह घोड़ा के सक्ति ले खुस नइं होवय,</para>
  <para style="q2" vid="PSA 147:10">न ही ओह योद्धा के गोड़मन ले खुस होथे;<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>यहोवा ह ओमन ले खुस होथे, जऊन मन ओकर भय मानथें,</para>
  <para style="q2" vid="PSA 147:11">जऊन मन ओकर अटूट मया ऊपर अपन आसा रखथें।<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>हे यरूसलेम, यहोवा के महिमा कर;</para>
  <para style="q2" vid="PSA 147:12">हे सियोन, अपन परमेसर के परसंसा कर।<verse eid="PSA 147:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>ओह तोर दुवार के खंभामन ला मजबूत करथे</para>
  <para style="q2" vid="PSA 147:13">अऊ तोर भीतर तोर मनखेमन ला आसीस देथे।<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>ओह तोर सीमना म सांति बनाय रखथे</para>
  <para style="q2" vid="PSA 147:14">अऊ सबले उत्तम गहूं के रोटी ले संतुस्ट करथे।<verse eid="PSA 147:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>ओह धरती ऊपर अपन हुकूम भेजथे;</para>
  <para style="q2" vid="PSA 147:15">ओकर बचन बहुंत तेजी से जाथे।<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>ओह बरफ ला ऊन के सहीं फईलाथे</para>
  <para style="q2" vid="PSA 147:16">अऊ पाला ला राख के सहीं बगराथे।<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>ओह पथरा के सहीं करा गिराथे।</para>
  <para style="q2" vid="PSA 147:17">कोन ह ओकर सीत-लहर ला सह सकथे?<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>ओह हुकूम देके ओमन ला टघला देथे;</para>
  <para style="q2" vid="PSA 147:18">ओह ठंडा हवा चलाथे, अऊ पानी बहे लगथे।<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>ओह याकूब ला अपन बात,</para>
  <para style="q2" vid="PSA 147:19">अऊ इसरायल ला अपन कानून अऊ नियम बताय हवय।<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>कोनो आने जाति के मनखेमन बर ओह ये काम नइं करे हवय;</para>
  <para style="q2" vid="PSA 147:20">ओमन ओकर कानून ला नइं जानंय।</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q1" vid="PSA 147:20">यहोवा के परसंसा करव।<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="cl">भजन-संहिता 148</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>यहोवा के परसंसा करव।</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q1" vid="PSA 148:1">स्वरग ले यहोवा के परसंसा करव;</para>
  <para style="q2" vid="PSA 148:1">ऊपर ऊंचहा जगह म ओकर परसंसा करव।<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>हे ओकर जम्मो स्वरगदूतमन ओकर परसंसा करव;</para>
  <para style="q2" vid="PSA 148:2">हे ओकर जम्मो स्वरगीय सेनामन, ओकर परसंसा करव।<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>हे सूरज अऊ चंदा, ओकर परसंसा करव;</para>
  <para style="q2" vid="PSA 148:3">हे जम्मो चमकत तारामन, ओकर परसंसा करव।<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>हे सबले ऊंच अकास,</para>
  <para style="q2" vid="PSA 148:4">अऊ हे अकास के ऊपर के पानी, तुमन ओकर परसंसा करव।<verse eid="PSA 148:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>ओमन यहोवा के नांव के परसंसा करंय,</para>
  <para style="q2" vid="PSA 148:5">काबरकि ओकर हुकूम ले ओमन बनाय गीन,<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>अऊ ओह ओमन ला सदाकाल बर इस्थिर करिस—</para>
  <para style="q2" vid="PSA 148:6">ओह एक आदेस निकालिस, जऊन ह कभू खतम नइं होवय।<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>धरती ले यहोवा के परसंसा करव,</para>
  <para style="q2" vid="PSA 148:7">हे समुंदर के बड़े-बड़े जीव-जन्तुमन अऊ जम्मो समुंदर के गहरई,<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>हे बिजली अऊ करा, बरफ अऊ बादरमन,</para>
  <para style="q2" vid="PSA 148:8">हे ओकर हुकूम मनइया गरेर,<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>हे पहाड़ अऊ जम्मो पहाड़ीमन,</para>
  <para style="q2" vid="PSA 148:9">हे फरवाले रूख अऊ जम्मो देवदार रूखमन,<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>हे जंगली पसु अऊ जम्मो घरेलू-पसुमन,</para>
  <para style="q2" vid="PSA 148:10">हे पेट के बल रेंगइया जीव अऊ उड़इया चिरईमन,<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>हे धरती के राजामन अऊ जाति-जाति के जम्मो मनखेमन,</para>
  <para style="q2" vid="PSA 148:11">हे हाकिम अऊ धरती ऊपर जम्मो सासन करइया मनखेमन,<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>हे जवान मनखे अऊ माईलोगनमन,</para>
  <para style="q2" vid="PSA 148:12">हे सियान मनखे अऊ लइकामन।<verse eid="PSA 148:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>तुमन जम्मो यहोवा के नांव के परसंसा करव,</para>
  <para style="q2" vid="PSA 148:13">काबरकि सिरिप ओकर नांव ही ऊपर करे जाथे;</para>
  <para style="q2" vid="PSA 148:13">ओकर सोभा ह धरती अऊ अकास के ऊपर हवय।<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>अऊ ओह अपन मनखेमन बर एक सींग<note caller="+" style="f"><char style="fr" closed="false">148:14 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">इहां येह ताकत के प्रतीक ए</char></note> खड़े करे हवय,</para>
  <para style="q2" vid="PSA 148:14">जऊन ह कि ओकर जम्मो बिसवासयोग्य सेवकमन के,</para>
  <para style="q2" vid="PSA 148:14">इसरायल के अऊ ओकर दिल के करीब के मनखेमन के परसंसा के बिसय ए।</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q1" vid="PSA 148:14">यहोवा के परसंसा करव।<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="cl">भजन-संहिता 149</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>यहोवा के परसंसा करव।<note caller="+" style="f"><char style="fr" closed="false">149:1 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">हलिलूयाह</char><char style="ft" closed="false">; <char style="xt" link-href="PSA 149:9"><ref loc="PSA 149:9">पद 9</ref></char> म घलो</char></note></para>
  <para style="b" vid="PSA 149:1"/>
  <para style="q1" vid="PSA 149:1">यहोवा बर एक नवां गीत गावव,</para>
  <para style="q2" vid="PSA 149:1">ओकर बिसवासयोग्य मनखेमन के सभा म ओकर परसंसा करव।<verse eid="PSA 149:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>इसरायल ह अपन सिरिस्टीकर्ता म आनंदित होवय;</para>
  <para style="q2" vid="PSA 149:2">सियोन के मनखेमन अपन राजा म खुस होवंय।<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>ओमन नाचत ओकर नांव के परसंसा करंय</para>
  <para style="q2" vid="PSA 149:3">अऊ ओकर बर खंजरी अऊ बीना बजावंय।<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>काबरकि यहोवा ह अपन मनखेमन ले खुस रहिथे;</para>
  <para style="q2" vid="PSA 149:4">ओह नम्र मनखेमन ला जीत के मुकुट पहिराथे।<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>ओकर बिसवासयोग्य मनखेमन ये आदर पाके आनंद मनावंय</para>
  <para style="q2" vid="PSA 149:5">अऊ अपन दसना म आनंद के गीत गावंय।<verse eid="PSA 149:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>ओमन के मुहूं ले परमेसर के परसंसा होवय</para>
  <para style="q2" vid="PSA 149:6">अऊ ओमन के हांथ म दूधारी तलवार रहय,<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>ताकि जाति-जाति के मनखेमन ले ओमन बदला लेवंय</para>
  <para style="q2" vid="PSA 149:7">अऊ मनखेमन ला दंड देवंय,<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>अऊ ओमन के राजामन ला बेड़ी म,</para>
  <para style="q2" vid="PSA 149:8">अऊ ओमन के परभावसाली मनखेमन ला लोहा के संकली म बांधंय,<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>अऊ ओमन के बिरूध दंड के हुकूम ले जावंय—</para>
  <para style="q2" vid="PSA 149:9">येह ओकर जम्मो बिसवासयोग्य मनखेमन के महिमा ए।</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q1" vid="PSA 149:9">यहोवा के परसंसा करव।<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="cl">भजन-संहिता 150</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>यहोवा के परसंसा करव।<note caller="+" style="f"><char style="fr" closed="false">150:1 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">हलिलूयाह </char><char style="ft" closed="false"><char style="xt" link-href="PSA 150:6"><ref loc="PSA 150:6">पद 6</ref></char> म घलो</char></note></para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q1" vid="PSA 150:1">परमेसर के ओकर पबितर-स्थान म परसंसा करव;</para>
  <para style="q2" vid="PSA 150:1">ओकर सक्तिसाली अकास-मंडल म ओकर परसंसा करव।<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>ओकर पराकरम के काम बर ओकर परसंसा करव;</para>
  <para style="q2" vid="PSA 150:2">ओकर अति महानता बर ओकर परसंसा करव।<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>तुरही बजाके ओकर परसंसा करव,</para>
  <para style="q2" vid="PSA 150:3">बीना अऊ सारंगी बजाके ओकर परसंसा करव,<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>खंजरी बजात अऊ नाचत ओकर परसंसा करव,</para>
  <para style="q2" vid="PSA 150:4">तारवाला बाजा अऊ बांसुरी बजात ओकर परसंसा करव,<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>जोर से झांझ बजाके ओकर परसंसा करव,</para>
  <para style="q2" vid="PSA 150:5">मंजीरा के झंकार ले ओकर परसंसा करव।<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>हर एक जीयत परानी ह यहोवा के परसंसा करय।</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q1" vid="PSA 150:6">यहोवा के परसंसा करव।<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
