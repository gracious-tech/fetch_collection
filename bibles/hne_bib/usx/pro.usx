<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">नीतिबचन</para>
  <para style="toc1">नीतिबचन के किताब</para>
  <para style="toc2">नीतिबचन</para>
  <para style="toc3">नीति</para>
  <para style="mt1">नीतिबचन</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="ms1">उदेस्य अऊ बिसय</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />दाऊद के बेटा इसरायल के राजा सुलेमान के नीतिबचन:<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />येमन ला पढ़नेवाला ह बुद्धि अऊ सिकछा पावय;</para>
  <para style="q2" vid="PRO 1:2">अऊ अंतस के बात ला समझय,<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />अऊ बुद्धि के काम, धरमीपन, नियाय,</para>
  <para style="q2" vid="PRO 1:3">अऊ जम्मो झन ला एके नजर ले देखे के सिकछा पावय;<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />येमन ला पढ़नेवाला भोला-भाला मनखे ला बुद्धि,</para>
  <para style="q2" vid="PRO 1:4">अऊ जवान मनखेमन ला गियान अऊ बिबेक मिलय—<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />बुद्धिमान मनखे ह येला सुनके अपन सिकछा ला बढ़ाय,</para>
  <para style="q2" vid="PRO 1:5">अऊ समझदार मनखे अगुवई पावय—<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />ताकि ओमन नीतिबचन अऊ पटंतर ला,</para>
  <para style="q2" vid="PRO 1:6">अऊ बुद्धिमान मनखे के बात अऊ पहेली ला समझंय।<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />यहोवा के भय मनई गियान के सुरूआत ए,</para>
  <para style="q2" vid="PRO 1:7">पर मुरूखमन बुद्धि अऊ सिकछा के बात ला तुछ समझथें।<verse eid="PRO 1:7" /></para>
  <para style="ms1">प्रस्तावना: बुद्धि ला पोटारे बर प्रोत्साहन</para>
  <para style="s1">पापी मनखेमन ला नेवता देय के बिरूध चेतउनी</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />हे मोर बेटा, अपन ददा के सिकछा ला सुन,</para>
  <para style="q2" vid="PRO 1:8">अऊ अपन दाई के सिकछा ला झन छोंड़,<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />काबरकि ओमन तोर मुड़ म सोभा देवइया मुकुट</para>
  <para style="q2" vid="PRO 1:9">अऊ तोर गला म कन्ठमाला सहीं अंय।<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />हे मोर बेटा, यदि पापी मनखेमन तोला बहकाथें,</para>
  <para style="q2" vid="PRO 1:10">त ओमन के बात झन मानबे।<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />यदि ओमन ये कहंय, “हमर संग आ</para>
  <para style="q2" vid="PRO 1:11">कि हमन खून करे के ताक म रहन;</para>
  <para style="q2" vid="PRO 1:11">आ, निरदोसमन ऊपर छुपके घात लगावन;<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />आ, हमन ओमन ला अइसन जीयत अऊ सइघो लील लेवन,</para>
  <para style="q2" vid="PRO 1:12">जइसन कि कबर ह मनखेमन ला लीलथे;<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />हमन ला जम्मो किसम के कीमती चीज मिलही</para>
  <para style="q2" vid="PRO 1:13">अऊ हमन अपन घर ला लूट के सामान ले भर लेबो;<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />हमर संग चिट्ठी डाल;</para>
  <para style="q2" vid="PRO 1:14">हमन जम्मो झन लूट के सामान ला बांटबो”—<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />हे मोर बेटा, ओमन के संग झन जा,</para>
  <para style="q2" vid="PRO 1:15">ओमन के रसता म चले बर अपन गोड़ ला रोक;<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />काबरकि ओमन खराप काम करे बर दऊड़थें,</para>
  <para style="q2" vid="PRO 1:16">अऊ हतिया करे बर उतावला रहिथें।<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />जब जम्मो चिरईमन देखत रहिथें,</para>
  <para style="q2" vid="PRO 1:17">तब ओमन ला फंसाय बर जाल डालना बेकार ए!<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />ये मनखेमन अपनेच हतिया करे के ताक म रहिथें;</para>
  <para style="q2" vid="PRO 1:18">ओमन अपनेच परान के घात म रहिथें!<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />जम्मो लालची मनखेमन के चाल ह अइसनेच होथे;</para>
  <para style="q2" vid="PRO 1:19">ओमन के जिनगी ह लालच के कारन ही खतम हो जाथे।<verse eid="PRO 1:19" /></para>
  <para style="s1">बुद्धि के डांट</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />बुद्धि ह बाहिर म जोर से पुकारत हे,</para>
  <para style="q2" vid="PRO 1:20">ओह सड़क के चौराहा म जोर से कहिथे;<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />दीवार के ऊपर ले ओह चिचियाथे,</para>
  <para style="q2" vid="PRO 1:21">सहर के दुवार<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fq" closed="false">सहर के दुवार </char><char style="ft" closed="false">याने कि </char><char style="fqa" closed="false">येह सहर के भाग रिहिस जिहां सहर के मामलामन ला निपटाय जावय</char></note> म ओह ये कहिथे:<verse eid="PRO 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />“हे भोला-भाला मनखेमन, तुमन कब तक अपन भोलापन ले मया करहू?</para>
  <para style="q2" vid="PRO 1:22">ठट्ठा करइयामन ठट्ठा करई म कब तक खुस रहिहीं</para>
  <para style="q2" vid="PRO 1:22">अऊ मुरूखमन कब तक गियान ले घिन करहीं?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />यदि तुमन मोर दबकार ला सुनके मन फिराहू,</para>
  <para style="q2" vid="PRO 1:23">त मेंह अपन आतमा तुमन ला बहुंतायत से दूहूं;</para>
  <para style="q2" vid="PRO 1:23">मेंह तुमन ला अपन गियान बताहूं।<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />पर जब में तुमन ला बलाएंव, त तुमन नइं सुने चाहेव,</para>
  <para style="q2" vid="PRO 1:24">अऊ जब मेंह अपन हांथ तुम्हर कोति पसारेंव, त कोनो धियान नइं दीन,<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />काबरकि तुमन मोर जम्मो सलाह ला अनसुना करेव</para>
  <para style="q2" vid="PRO 1:25">अऊ मोर डांट ले घलो तुमन ला कुछू फरक नइं पड़िस;<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />एकरसेति, जब तुम्हर ऊपर बिपत्ति पड़ही, त मेंह हंसहूं,</para>
  <para style="q2" vid="PRO 1:26">अऊ जब तुमन संकट म होहू, त मेंह हंसी उड़ाहूं—<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />जब संकट ह गरेर के सहीं तुम्हर ऊपर आही,</para>
  <para style="q2" vid="PRO 1:27">अऊ बिपत्ति ह बवंडर के सहीं आही,</para>
  <para style="q2" vid="PRO 1:27">अऊ दुख अऊ समस्या म तुमन पड़े होहू, त मेंह ठट्ठा करहूं।<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />“तब ओमन मोला बलाहीं, पर में ओमन ला जबाब नइं दूहूं;</para>
  <para style="q2" vid="PRO 1:28">ओमन मोला खोजहीं, पर मोला नइं पाहीं।<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />काबरकि ओमन गियान के बात ले घिन करिन</para>
  <para style="q2" vid="PRO 1:29">अऊ यहोवा के भय माने बर नइं चाहिन।<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />ओमन मोर सलाह ला अनसुना करिन</para>
  <para style="q2" vid="PRO 1:30">अऊ मोर डांट ला तुछ समझिन;<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />एकरसेति, ओमन अपन करनी के फर भोगहीं</para>
  <para style="q2" vid="PRO 1:31">अऊ अपन गोस्टी के कारन दुख ले भर जाहीं।<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />काबरकि सीधा-साधा मनखेमन के मनमानी ले ओहीचमन के नुकसान होही,</para>
  <para style="q2" vid="PRO 1:32">अऊ मुरूखमन के आत्म-संतोस होवई ह ओहीचमन ला नास करही;<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />पर जऊन ह मोर बात ला सुनही, ओह सुरकछित रहिही</para>
  <para style="q2" vid="PRO 1:33">अऊ अराम से रहिही अऊ ओला हानि होय के कोनो डर नइं रहिही।”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">बुद्धि के नीतिगत लाभ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />हे मोर बेटा, यदि तेंह मोर बचन ला गरहन करथस</para>
  <para style="q2" vid="PRO 2:1">अऊ मोर हुकूममन ला अपन हिरदय म रखथस,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />अऊ बुद्धि के बात ला धियान से सुनथस</para>
  <para style="q2" vid="PRO 2:2">अऊ समझदारी के बात म मन लगाथस—<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />वास्तव म, यदि तेंह अंतर-गियान मांगथस</para>
  <para style="q2" vid="PRO 2:3">अऊ समझदारी बर ऊंच अवाज म पुकारथस,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />अऊ तेंह येला अइसने खोजथस, जइसने कोनो चांदी ला खोजथे</para>
  <para style="q2" vid="PRO 2:4">अऊ तेंह येला अइसने खोजथस, जइसने कोनो छुपे खजाना ला खोजथे,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />त तेंह यहोवा के भय ला समझबे</para>
  <para style="q2" vid="PRO 2:5">अऊ परमेसर के गियान ला पाबे।<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />काबरकि यहोवा ह बुद्धि देथे;</para>
  <para style="q2" vid="PRO 2:6">ओह गियान अऊ समझ के बात कहिथे।<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />ओह ईमानदार मनखे ला सफल बनाथे,</para>
  <para style="q2" vid="PRO 2:7">अऊ निरदोस मनखेमन बर ओह ढाल सहीं अय।<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />काबरकि ओह नियाय के रसता म चलइया के पहरेदारी करथे</para>
  <para style="q2" vid="PRO 2:8">अऊ अपन बिसवासयोग्य मनखे के रकछा करथे।<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />तब तेंह समझबे कि कते बात ह सही अऊ नियाय</para>
  <para style="q2" vid="PRO 2:9">अऊ उचित ए—याने कि जम्मो बने बात ला समझबे।<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />काबरकि बुद्धि ह तोर हिरदय म आही,</para>
  <para style="q2" vid="PRO 2:10">अऊ गियान के बात ले तोला सुख मिलही।<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />तोर बिबेक के बात ह तोर रकछा करही,</para>
  <para style="q2" vid="PRO 2:11">अऊ समझदारी के बात ह तोर पहरेदारी करही।<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />बुद्धि ह तोला ओ दुस्ट मनखेमन के चाल ले,</para>
  <para style="q2" vid="PRO 2:12">अऊ दोगला मनखेमन ले बचाही,<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />जऊन मन सही रसता ला छोंड़ दे हवंय</para>
  <para style="q2" vid="PRO 2:13">ताकि अंधियार के रसता म चलंय,<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />जऊन मन गलत काम म खुस होथें</para>
  <para style="q2" vid="PRO 2:14">अऊ बुरई के काम म आनंद मनाथें,<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />जऊन मन टेढ़ा चाल चलथें</para>
  <para style="q2" vid="PRO 2:15">अऊ जऊन मन अपन रसता ले भटक गे हवंय।<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />बुद्धि ह तुमन ला ओ छिनारी माईलोगन,</para>
  <para style="q2" vid="PRO 2:16">अऊ जिद्दी माईलोगन के गुरतूर बोली ले घलो बचाही,<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />जऊन ह अपन जवानी के संगी ला छोंड़ दे हवय</para>
  <para style="q2" vid="PRO 2:17">अऊ परमेसर के आघू म करे गे करार ऊपर धियान नइं दे हवय।<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />खचित ओकर घर ह खाल्हे मिरतू कोति ले जाथे</para>
  <para style="q2" vid="PRO 2:18">अऊ ओकर रसता ह मुरदामन के आतमामन करा जाथे।<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />जऊन मन ओकर करा जाथें, ओमा के कोनो लहुंटके नइं आवंय</para>
  <para style="q2" vid="PRO 2:19">या ओमा के कोनो जिनगी के रसता ला नइं पावंय।<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />ये किसम ले, तेंह भलई के डहार म चलबे</para>
  <para style="q2" vid="PRO 2:20">अऊ धरमीमन के रसता ला पकड़े रहिबे।<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />काबरकि धरमी मनखेमन धरती म बसे रहिहीं,</para>
  <para style="q2" vid="PRO 2:21">अऊ सच्चई के रसता म चलइयामन येमा बने रहिहीं;<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />पर दुस्ट मनखेमन ला धरती ले निकाल दिये जाही,</para>
  <para style="q2" vid="PRO 2:22">अऊ बिसवासघातीमन ला येमा ले उखान दिये जाही।<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">बुद्धि के दुवारा आसीस मिलथे</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />हे मोर बेटा, मोर सिकछा ला झन भुलाबे,</para>
  <para style="q2" vid="PRO 3:1">पर मोर हुकूममन ला अपन हिरदय म रखे रह,<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />काबरकि अइसने करे ले तोर उमर ह बढ़ही</para>
  <para style="q2" vid="PRO 3:2">अऊ तोर जिनगी म सांति आही अऊ तोर उन्नति होही।<verse eid="PRO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />मया अऊ ईमानदारी तोला कभू झन छोंड़ंय;</para>
  <para style="q2" vid="PRO 3:3">ओमन ला अपन घेंच म बांध ले,</para>
  <para style="q2" vid="PRO 3:3">अऊ ओमन ला अपन हिरदय रूपी पटिया म लिख ले।<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />तब तोर ऊपर परमेसर अऊ मनखे दूनों के अनुग्रह होही</para>
  <para style="q2" vid="PRO 3:4">अऊ दूनों के नजर म बने नांव कमाबे।<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />तें अपन समझ के ऊपर भरोसा झन कर,</para>
  <para style="q2" vid="PRO 3:5">पर अपन जम्मो हिरदय ले यहोवा ऊपर भरोसा रख;<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />अपन जम्मो काम ओकर ईछा के मुताबिक कर,</para>
  <para style="q2" vid="PRO 3:6">तब ओह तोर बर सीधा रसता निकालही।<verse eid="PRO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />अपन नजर म बुद्धिमान झन बन;</para>
  <para style="q2" vid="PRO 3:7">यहोवा के भय मान अऊ बुरई ले दूरिहा रह।<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />अइसने करे ले तोर देहें ह भला-चंगा</para>
  <para style="q2" vid="PRO 3:8">अऊ हाड़ामन मजबूत बने रहिहीं।<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />अपन संपत्ति के दुवारा अऊ अपन भुइयां के</para>
  <para style="q2" vid="PRO 3:9">जम्मो पहिली-फसल देय के दुवारा यहोवा के आदरमान कर;<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />तब तोर कोठार ह फसल ले भरे रहिही,</para>
  <para style="q2" vid="PRO 3:10">अऊ तोर टंकीमन नवां अंगूर के मंद ले छलकत रहिहीं।<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />हे मोर बेटा, यहोवा के ताड़ना ला तुछ झन जान,</para>
  <para style="q2" vid="PRO 3:11">अऊ जब ओह तोला डांटय, त ओकर बुरा झन मान,<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />काबरकि यहोवा ह ओमन के ताड़ना करथे, जेमन ले ओह मया करथे,</para>
  <para style="q2" vid="PRO 3:12">जइसने कि ददा ह ओ बेटा ला डांटथे, जेकर ले ओह खुस रहिथे।<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />धइन अंय ओ मनखेमन, जऊन मन बुद्धि पाथें,</para>
  <para style="q2" vid="PRO 3:13">अऊ धइन अंय ओ मनखेमन, जऊन मन समझ पाथें,<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />काबरकि बुद्धि पाना चांदी के पाय ले जादा बने अय</para>
  <para style="q2" vid="PRO 3:14">अऊ ओकर लाभ सोन के लाभ ले घलो जादा होथे।<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />बुद्धि ह मनि ले जादा कीमती अय;</para>
  <para style="q2" vid="PRO 3:15">जेकर तेंह लालसा करथस, ओमा के कोनो चीज के तुलना ओकर संग नइं करे जा सकय।<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />लम्बा उमर ओकर जेवनी हांथ म हवय;</para>
  <para style="q2" vid="PRO 3:16">अऊ ओकर डेरी हांथ म धन अऊ आदरमान हवय।<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />ओकर रसतामन खुसी के रसता अंय,</para>
  <para style="q2" vid="PRO 3:17">अऊ ओकर जम्मो डहारमन सांति के डहार अंय।<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />जऊन मन बुद्धि ला धरे रहिथें, ओमन बर ओह जिनगी के एक रूख अय;</para>
  <para style="q2" vid="PRO 3:18">अऊ जऊन मन ओला मजबूती से धरे रहिथें, ओमन आसीस पाहीं।<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />बुद्धि के दुवारा यहोवा ह धरती ला बनाईस,</para>
  <para style="q2" vid="PRO 3:19">अऊ समझ के दुवारा ओह स्वरगमन ला ओमन के जगह म रखिस;<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />ओकर गियान के दुवारा गहिरा समुंदरमन बंट गीन,</para>
  <para style="q2" vid="PRO 3:20">अऊ बादर ले ओस टपकथे।<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />हे मोर बेटा, बुद्धि अऊ समझ तोर नजर ले झन हटंय,</para>
  <para style="q2" vid="PRO 3:21">सही नियाय अऊ समझदारी ला धरे रह;<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />येमन तोर बर जिनगी होहीं,</para>
  <para style="q2" vid="PRO 3:22">अऊ तोर घेंच के हार बनहीं।<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />तब तेंह अपन डहार म निडर होके चलबे,</para>
  <para style="q2" vid="PRO 3:23">अऊ तोर गोड़ म ठोकर नइं लगही।<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />जब तेंह लेटबे, त तोला डर नइं होही;</para>
  <para style="q2" vid="PRO 3:24">जब तेंह सुतबे, त तोला सुख के नींद आही।<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />अचानक अवइया बिपत्ति ले झन डरबे</para>
  <para style="q2" vid="PRO 3:25">या जब दुस्ट मनखे के नास होथे, त झन डरबे,<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />काबरकि यहोवा ह तोर सहारा होही</para>
  <para style="q2" vid="PRO 3:26">अऊ तोर गोड़ ला फांदा म फंसे ले बचाही।<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />जेमन के भलई करना हे, अऊ यदि तोला ओकर मऊका मिलथे,</para>
  <para style="q2" vid="PRO 3:27">त ओमन के भलई करे ले अपन ला झन रोक।<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />यदि तोर करा देय बर हवय,</para>
  <para style="q2" vid="PRO 3:28">त अपन परोसी ले झन कह कि अभी जा,</para>
  <para style="q2" vid="PRO 3:28">कल फेर आबे, त तोला दूहूं।<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />जब तोर परोसी ह तोर लकठा म भरोसा सहित रहिथे,</para>
  <para style="q2" vid="PRO 3:29">त ओला नुकसान पहुंचाय के युक्ति झन कर।<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />जब कोनो मनखे ह तोर कुछू नुकसान नइं करे हवय,</para>
  <para style="q2" vid="PRO 3:30">त ओकर ऊपर बिगर कोनो कारन के दोस झन लगा।<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />उपदरवी मनखे ले जलन झन रखबे</para>
  <para style="q2" vid="PRO 3:31">अऊ न ही ओकर सहीं चाल चलबे।<verse eid="PRO 3:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />काबरकि कुटिल मनखे ले यहोवा ह बहुंत घिन करथे,</para>
  <para style="q2" vid="PRO 3:32">पर ईमानदार मनखे ऊपर ओह भरोसा करथे।<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />दुस्ट मनखे के घर म यहोवा के सराप,</para>
  <para style="q2" vid="PRO 3:33">पर धरमीमन के घर म ओकर आसीस होथे।<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />घमंडी हंसी उड़इयामन के ओह हंसी उड़ाथे,</para>
  <para style="q2" vid="PRO 3:34">पर नम्र अऊ दुखी मनखेमन ऊपर अनुग्रह करथे।<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />बुद्धिमान मनखेमन आदरमान पाथें,</para>
  <para style="q2" vid="PRO 3:35">पर मुरूखमन के सिरिप अपमान होथे।<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">कोनो भी कीमत म बुद्धि ला ले</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />हे मोर बेटामन, अपन ददा के सिकछा ला सुनव,</para>
  <para style="q2" vid="PRO 4:1">अऊ समझ के बात ला जाने बर मन लगावव।<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />मेंह तुमन ला उत्तम सिकछा देथंव,</para>
  <para style="q2" vid="PRO 4:2">एकरसेति मोर सिकछा ला झन छोंड़व।<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />जब मेंह घलो अपन ददा के बेटा रहेंव,</para>
  <para style="q2" vid="PRO 4:3">सुकुमार, अऊ अपन दाई के दुलारा रहेंव;<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />त मोर ददा ह ये कहिके मोला सिखावय,</para>
  <para style="q2" vid="PRO 4:4">“तोर पूरा मन मोर बचन म लगे रहय;</para>
  <para style="q2" vid="PRO 4:4">मोर हुकूममन ला मान अऊ जीयत रह।<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />तोला बुद्धि मिलय अऊ समझ घलो मिलय;</para>
  <para style="q2" vid="PRO 4:5">मोर बातमन ला झन भुलाबे या ओमन ला झन छोंड़बे।<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />बुद्धि ला झन छोंड़बे, अऊ ओह तोर रकछा करही;</para>
  <para style="q2" vid="PRO 4:6">ओकर ले मया कर, अऊ ओह तोर रखवारी करही।<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />बुद्धि ह सबले उत्तम ए, एकरसेति येला पाय के कोसिस कर,</para>
  <para style="q2" vid="PRO 4:7">अऊ समझ ला पाय बर जम्मो कुछू कर।<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />ओकर बात मान, त ओह तोला ऊपर उठाही;</para>
  <para style="q2" vid="PRO 4:8">ओला धरे रह, अऊ ओह तोर आदर करही।<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />ओह तोर मुड़ ला सोभा देवइया एक माला पहिराही</para>
  <para style="q2" vid="PRO 4:9">अऊ तोला सुघर मुकुट दीही।”<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />हे मोर बेटा, मोर बात ला सुन अऊ ओला मान,</para>
  <para style="q2" vid="PRO 4:10">तब तेंह बहुंत बछर जीयबे।<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />मेंह तोला बुद्धि के रसता बतात हंव,</para>
  <para style="q2" vid="PRO 4:11">अऊ सीधई के डहार म ले जावत हंव।<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />जब तेंह रेंगबे, त कोनो बाधा नइं होही,</para>
  <para style="q2" vid="PRO 4:12">अऊ जब तेंह दऊड़बे, त तोला ठोकर नइं लगही।<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />सिकछा ला मान, ओला झन छोंड़;</para>
  <para style="q2" vid="PRO 4:13">येकर रखवारी कर, काबरकि येह तोर जिनगी अय।<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />दुस्टमन के डहार म झन जाबे,</para>
  <para style="q2" vid="PRO 4:14">अऊ न ही खराप मनखेमन के रसता म चलबे।<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />ओ रसता ले अलग रह, ओमा झन जा;</para>
  <para style="q2" vid="PRO 4:15">ओमा ले हटके अपन रसता म जा।<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />काबरकि दुस्ट मनखेमन जब तक बुरई नइं कर लीहीं, तब तक ओमन ला चैन नइं मिलय;</para>
  <para style="q2" vid="PRO 4:16">जब तक ओमन काकरो ठोकर खाय के कारन नइं बनंय, तब तक ओमन ला नींद नइं आवय।<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />ओमन दुस्टता ले कमाय रोटी ला खाथें</para>
  <para style="q2" vid="PRO 4:17">अऊ लड़ई-झगरा करके लाने अंगूर के मंद ला पीथें।<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />धरमीमन के चाल ह बिहनियां निकलत सूरज सहीं अय,</para>
  <para style="q2" vid="PRO 4:18">जेकर अंजोर ह मंझन होवत तक बढ़त ही रहिथे।<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />पर दुस्टमन के रसता ह भयंकर अंधियार सहीं अय;</para>
  <para style="q2" vid="PRO 4:19">ओमन नइं जानंय कि ओमन का चीज ले ठोकर खाथें।<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />हे मोर बेटा, जऊन बात मेंह कहत हंव, ओकर ऊपर धियान दे,</para>
  <para style="q2" vid="PRO 4:20">अऊ मोर बात ला सुन।<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />ये बातमन ला हर समय सुरता रख;</para>
  <para style="q2" vid="PRO 4:21">येमन ला अपन हिरदय म रख।<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />काबरकि जऊन मन येमन ला पाथें, ओमन ला येमन जिनगी,</para>
  <para style="q2" vid="PRO 4:22">अऊ ओमन के जम्मो सरीर ला चंगई देथें।<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />सबले जादा अपन मन के रखवारी कर,</para>
  <para style="q2" vid="PRO 4:23">काबरकि तोर हर काम तोर मन ले ही निकलके आथे।<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />बेईमानी के बात तोर मुहूं ले झन निकलय,</para>
  <para style="q2" vid="PRO 4:24">अऊ चालबाजी के बात ले दूरिहा रह।<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />तेंह सीधा आघू ला देख,</para>
  <para style="q2" vid="PRO 4:25">अऊ अपन सामने के बात म सीधा धियान लगा।<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />अपन पांव धरे बर डहार ला समतल कर,</para>
  <para style="q2" vid="PRO 4:26">अऊ अपन जम्मो रसता म अटल बने रह।<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />न तो जेवनी, अऊ न ही डेरी अंग मुड़,</para>
  <para style="q2" vid="PRO 4:27">अऊ न ही बुरई के रसता म रेंग।<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">बेभिचार के बिरोध म चेतउनी</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />हे मोर बेटा, मोर बुद्धि के बात ऊपर धियान लगा,</para>
  <para style="q2" vid="PRO 5:1">अऊ मोर समझ के बात ला सुन,<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />ताकि तोर बिबेक ह सही रहय</para>
  <para style="q2" vid="PRO 5:2">अऊ तोर मुहूं ले गियान के बात निकलय।<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />काबरकि छिनारी माईलोगन के मुहूं ले गुरतूर बात निकलथे,</para>
  <para style="q2" vid="PRO 5:3">अऊ ओकर बात ह तेल ले घलो जादा चिकना होथे;<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />पर आखिर म, ओह पित्त के सहीं करू,</para>
  <para style="q2" vid="PRO 5:4">अऊ दूधारी तलवार सहीं चोख होथे।<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />ओकर गोड़मन मिरतू कोति जाथें;</para>
  <para style="q2" vid="PRO 5:5">अऊ ओकर पांवमन सीधा कबर करा ले जाथें।<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />ओह जिनगी के रसता के बारे म बिचार नइं करय;</para>
  <para style="q2" vid="PRO 5:6">ओह एती-ओती भटकथे, पर ओह ये बात ला नइं जानय।<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />एकरसेति, हे मोर बेटामन, मोर बात ला सुनव,</para>
  <para style="q2" vid="PRO 5:7">अऊ जऊन कुछू मेंह कहिथंव, ओला मानव।<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />अइसने छिनारी माईलोगन ले दूरिहा रहव,</para>
  <para style="q2" vid="PRO 5:8">अऊ ओकर घर के लकठा म घलो झन जावव,<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />नइं तो तुम्हर मान-सम्मान दूसरमन करा चल दीही</para>
  <para style="q2" vid="PRO 5:9">अऊ निरदयी मनखे ह तुम्हर परतिस्ठा<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">जिनगी के बछरमन</char></note> ला ले लीही।<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />या अजनबीमन तुम्हर संपत्ति म मजा उड़ाहीं</para>
  <para style="q2" vid="PRO 5:10">अऊ तुम्हर मेहनत ह दूसरमन ला धनवान बनाही;<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />अऊ अपन जिनगी के आखिरी बेरा म,</para>
  <para style="q2" vid="PRO 5:11">जब तुम्हर देहें ह कमजोर हो जाही, त तुमन कलहरहू;<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />अऊ ये कहिहू, “मेंह अनुसासन म काबर नइं रहेंव,</para>
  <para style="q2" vid="PRO 5:12">अऊ दूसर के डांट ला काबर तुछ जानेंव!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />मेंह अपन गुरूमन के बात ला नइं मानेंव</para>
  <para style="q2" vid="PRO 5:13">अऊ अपन सिखोइयामन के बात ला नइं सुनेंव।<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />मेंह तुरते परमेसर के मनखेमन के सभा म</para>
  <para style="q2" vid="PRO 5:14">गंभीर समस्या म रहेंव।”<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />तें अपन ही जलासय,</para>
  <para style="q2" vid="PRO 5:15">अऊ अपन ही कुआं के सोत के पानी पीये कर।<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />का तोर झरना के पानी गलीमन म,</para>
  <para style="q2" vid="PRO 5:16">अऊ पानी के धारा गली के चऊकमन म बहय?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />ओह सिरिप तोरेच रहय,</para>
  <para style="q2" vid="PRO 5:17">अऊ अजनबीमन संग बांटे बर नइं।<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />तोर पानी के सोता आसीसित रहय,</para>
  <para style="q2" vid="PRO 5:18">अऊ तें अपन जवानी के घरवाली संग आनंद मना।<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />ओह तोर बर एक मयारू हिरनी, एक सुघर सांबरनी सहीं होवय—</para>
  <para style="q2" vid="PRO 5:19">ओकर छाती ह तोला हमेसा खुस रखय,</para>
  <para style="q2" vid="PRO 5:19">अऊ तेंह ओकर मया म हमेसा बंधे रह।<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />हे मोर बेटा, आने मनखे के घरवाली के मया म तेंह काबर मोहित होबे?</para>
  <para style="q2" vid="PRO 5:20">अऊ एक छिनार ला अपन छाती ले काबर लगाबे?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />काबरकि तोर चालचलन ला यहोवा ह देखत हवय,</para>
  <para style="q2" vid="PRO 5:21">अऊ ओह तोर जम्मो चालचलन ला परखथे।<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />दुस्ट मनखेमन अपनेच अधरम के काम म फंसथें;</para>
  <para style="q2" vid="PRO 5:22">ओमन अपनेच पाप के बंधन म कसके बंधे रहिथें।<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />ओमन सिकछा के कमी के कारन मर जाहीं,</para>
  <para style="q2" vid="PRO 5:23">अऊ अपनेच मुरूखता के कारन भटक जाहीं।<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">मुरूखता के बिरूध चेतउनी</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />हे मोर बेटा, यदि तेंह अपन परोसी बर जमानत ले हस,</para>
  <para style="q2" vid="PRO 6:1">या कोनो अजनबी बर अपन चीज गिरवी म दे हस,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />तेंह अपन ही बात म फंस गे हस,</para>
  <para style="q2" vid="PRO 6:2">अऊ अपन ही बात म पकड़े गे हस।<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />त हे मोर बेटा, अपनआप ला बंचाय बर अइसे कर,</para>
  <para style="q2" vid="PRO 6:3">जब तेंह अपन परोसी के हांथ म पड़ गे हस:</para>
  <para style="q1" vid="PRO 6:3">त, जा, जल्दी कर,<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">जा </char><char style="fqa" closed="false">अऊ अपनआप ला नम्र कर,</char></note></para>
  <para style="q2" vid="PRO 6:3">अऊ तुरते अपन परोसी ले बिनती कर।<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />जागत रह;</para>
  <para style="q2" vid="PRO 6:4">अपन आंखी म झपकी घलो झन आवन दे।<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />अपनआप ला छुड़ा, जइसे हिरन ह सिकारी के हांथ ले,</para>
  <para style="q2" vid="PRO 6:5">अऊ चिरई ह चिड़ीमार के जाल ले अपनआप ला छुड़ाथे।<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />हे अलाल मनखे, चांटीमन करा जा;</para>
  <para style="q2" vid="PRO 6:6">ओमन के काम ला देख, अऊ बुद्धिमान बन।<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />ओमन ला न तो कोनो हुकूम देवइया होथे,</para>
  <para style="q2" vid="PRO 6:7">न देखरेख करइया, अऊ न ही ओमन ऊपर सासन करइया,<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />तभो ले ओमन धूपकाला म अपन खाना संकेलथें</para>
  <para style="q2" vid="PRO 6:8">अऊ लुवई के बेरा अपन जेवन कुढ़ोथें।<verse eid="PRO 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />हे अलाल मनखे, तेंह कब तक सोवत रहिबे?</para>
  <para style="q2" vid="PRO 6:9">तोर नींद ह कब टूटही?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />थोरकन अऊ नींद, थोरकन अऊ ऊंघासी,</para>
  <para style="q2" vid="PRO 6:10">हांथ म हांथ धरके अऊ थोरकन देर बईठे रहई—<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />अऊ गरीबी ह चोर सहीं,</para>
  <para style="q2" vid="PRO 6:11">अऊ घटी ह हथियार धरे मनखे सहीं तोर ऊपर आ जाही।<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />समस्या खड़े करइया अऊ दुस्ट मनखे ह</para>
  <para style="q2" vid="PRO 6:12">बेईमानी के बात करथे;<verse eid="PRO 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13" />ओह खराप इरादा से आंखी मारथे,</para>
  <para style="q2" vid="PRO 6:13">अपन पांव ले इसारा करथे</para>
  <para style="q2" vid="PRO 6:13">अऊ अपन अंगरी ले घलो इसारा करथे।<verse eid="PRO 6:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14" />ये काम ओह अपन खराप मन ले बुरई के बात ला सोचके करथे;</para>
  <para style="q2" vid="PRO 6:14">ओह हमेसा झगरा करे म लगे रहिथे।<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />एकरसेति, बिपत्ति ह ओकर ऊपर अचानक आ जाही;</para>
  <para style="q2" vid="PRO 6:15">पल भर म, बिगर कोनो बचाव के ओह नास हो जाही।<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16" />छै ठन चीज ला यहोवा ह नापसंद करथे,</para>
  <para style="li2" vid="PRO 6:16">अऊ सात ठन चीज ले ओह घिन करथे:<verse eid="PRO 6:16" /></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17" />घमंड ले भरे आंखी,</para>
  <para style="li3" vid="PRO 6:17">लबारी बात कहइया जीभ,</para>
  <para style="li3" vid="PRO 6:17">निरदोस मनखे के खून बहानेवाला हांथ,<verse eid="PRO 6:17" /></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18" />दुस्टता के बात सोचनेवाला हिरदय,</para>
  <para style="li3" vid="PRO 6:18">खराप काम करे बर तियार रहइया पांव,<verse eid="PRO 6:18" /></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19" />लबरा गवाह, जऊन ह लबारी के ऊपर लबारी मारथे</para>
  <para style="li3" vid="PRO 6:19">अऊ ओ मनखे जऊन ह मनखेमन के बीच म फूट डारथे।<verse eid="PRO 6:19" /></para>
  <para style="s1">बेभिचार के बिरोध म चेतउनी</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />हे मोर बेटा, अपन ददा के हुकूम ला मान</para>
  <para style="q2" vid="PRO 6:20">अऊ अपन दाई के सिकछा ला झन छोंड़।<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />ये बातमन ला हमेसा अपन हिरदय म रख;</para>
  <para style="q2" vid="PRO 6:21">येमन ला अपन घेंच म माला सहीं पहिर ले।<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />जब तेंह रेंगबे, त येमन तोर अगुवई करहीं;</para>
  <para style="q2" vid="PRO 6:22">जब तेंह सुतबे, त येमन तोर रखवारी करहीं;</para>
  <para style="q2" vid="PRO 6:22">अऊ जब तेंह जागबे, त येमन तोर ले गोठियाहीं।<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />काबरकि ये हुकूम ह एक दीया सहीं अय;</para>
  <para style="q2" vid="PRO 6:23">ये सिकछा ह अंजोर सहीं अय,</para>
  <para style="q1" vid="PRO 6:23">अऊ सुधार अऊ निरदेस</para>
  <para style="q2" vid="PRO 6:23">जिनगी के रसता सहीं अंय;<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />येमन तोला परोसी के घरवाली,</para>
  <para style="q2" vid="PRO 6:24">अऊ छिनार माईलोगन के गुरतूर बोली ले बचाथें।<verse eid="PRO 6:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />ओकर सुघरता ला देखके अपन मन म ओकर लालसा झन कर</para>
  <para style="q2" vid="PRO 6:25">अऊ ओकर आंखी के जादू तोला झन मोहय।<verse eid="PRO 6:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />काबरकि एक बेस्या के कीमत एक रोटी हो सकथे,</para>
  <para style="q2" vid="PRO 6:26">पर आने मनखे के घरवाली ह तोर खुद के जिनगी ला लूट लेथे।<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />का अइसे हो सकथे कि कोनो मनखे आगी ला अपन कोरा म रखे</para>
  <para style="q2" vid="PRO 6:27">अऊ ओकर ओनहा ह नइं जरय?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />या का अइसे हो सकथे कि कोनो मनखे आगी म रेंगे</para>
  <para style="q2" vid="PRO 6:28">अऊ ओकर पांव ह नइं झुलसय?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />अइसे ओ मनखे के दसा होथे, जऊन ह आने के घरवाली संग सुतथे;</para>
  <para style="q2" vid="PRO 6:29">जऊन ह अइसे माईलोगन ला छूथे, ओह दंड के भागी होही।<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />जऊन चोर ह अपन पेट के भूख ला मिटाय बर चोरी करथे,</para>
  <para style="q2" vid="PRO 6:30">ओला मनखेमन तुछ नइं समझंय।<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />तभो ले यदि ओह पकड़े जाथे, त ओला सात गुना भरना पड़ही;</para>
  <para style="q2" vid="PRO 6:31">चाहे ओला अपन घर के जम्मो चीज देना पड़य।<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />जऊन ह बेभिचार करथे, ओकर करा बुद्धि नइं ए;</para>
  <para style="q2" vid="PRO 6:32">जऊन ह अइसे करथे, ओह अपनआप ला नास करथे।<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />ओह मार खाथे अऊ अपमानित होथे,</para>
  <para style="q2" vid="PRO 6:33">अऊ ओकर कलंक ह कभू नइं मिटय।<verse eid="PRO 6:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />काबरकि जलन ह घरवाला ला बहुंत गुस्सा देवाथे,</para>
  <para style="q2" vid="PRO 6:34">अऊ बदला लेवत बेरा ओह दया नइं करय।<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />ओह नुकसान के भरपई नइं चाहय;</para>
  <para style="q2" vid="PRO 6:35">ओला जतका भी घूस दे दव, ओह नइं मानय।<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">बेभिचारी माईलोगन के बिरूध चेतउनी</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />हे मोर बेटा, मोर बातमन ला मान</para>
  <para style="q2" vid="PRO 7:1">अऊ मोर हुकूममन ला अपन मन म रखे रह।<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />मोर हुकूममन ला मान, त तेंह जीयत रहिबे;</para>
  <para style="q2" vid="PRO 7:2">मोर सिकछा के मुताबिक अपन जिनगी जी।<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />ओमन ला अपन अंगरीमन म बांध ले,</para>
  <para style="q2" vid="PRO 7:3">अऊ ओमन ला अपन हिरदय के पटिया म लिख ले।<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />बुद्धि ले कह, “तेंह मोर बहिनी अस,”</para>
  <para style="q2" vid="PRO 7:4">अऊ समझ ले कह, “तेंह मोर रिस्तेदार अस।”<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />येमन तोला छिनार माईलोगन ले दूरिहा रखहीं,</para>
  <para style="q2" vid="PRO 7:5">अऊ जिद्दी माईलोगन के गुरतूर बोली ले बचाहीं।<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />मेंह अपन घर के खिड़की के</para>
  <para style="q2" vid="PRO 7:6">जाली म ले खाल्हे देखेंव।<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />मेंह भोला-भाला मनखेमन ला देखेंव,</para>
  <para style="q2" vid="PRO 7:7">अऊ मोर धियान ह जवानमन के बीच म,</para>
  <para style="q2" vid="PRO 7:7">एक निरबुद्धि जवान कोति गीस।<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />ओह ओ माईलोगन के घर के कोना के गली ले होवत,</para>
  <para style="q2" vid="PRO 7:8">ओकर घर डहार जावत रिहिस।<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />ओ बेरा दिन ढर गे रहय अऊ सांझ हो गे रहय,</para>
  <para style="q2" vid="PRO 7:9">अऊ रथिया के अंधियार छा गे रहय।<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />तब एक माईलोगन ओकर ले मिले बर घर ले निकलिस;</para>
  <para style="q2" vid="PRO 7:10">ओकर भेस ह छिनार माईलोगन सहीं रिहिस अऊ ओकर मन म कपट रिहिस।<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />(ओह उदंड अऊ हुकूम नइं माननेवाली रिहिस;</para>
  <para style="q2" vid="PRO 7:11">ओह बहुंत कम अपन घर म रहय;<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />कभू गली म, कभू बजार म,</para>
  <para style="q2" vid="PRO 7:12">त कभू गली के कोना म, ओह मनखेमन के बाट जोहय।)<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />तब ओह ओ जवान ला धरके चूमिस,</para>
  <para style="q2" vid="PRO 7:13">अऊ बिगर लाज-सरम के ओला कहिस,<verse eid="PRO 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“आज में अपन मन्नत ला पूरा करेंव,</para>
  <para style="q2" vid="PRO 7:14">अऊ मोर करा घर म मेल-बलिदान म चघाय खाना हवय।<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />एकरसेति मेंह तोर ले मिले बर आय हवंव;</para>
  <para style="q2" vid="PRO 7:15">मेंह तोला खोजेंव अऊ तोला पा गेंव!<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />मेंह अपन पलंग म</para>
  <para style="q2" vid="PRO 7:16">मिसर देस म बने सन के रंग-बिरंगी चादर दसाय हंव।<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />मेंह अपन पलंग ला</para>
  <para style="q2" vid="PRO 7:17">लोहबान, मुसब्बर अऊ दालचीनी ले सुगंधित करे हवंव।<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />आ, हमन बिहान होवत ले एक-दूसर ले मया करन;</para>
  <para style="q2" vid="PRO 7:18">अऊ मया म हमन आनंद मनावन!<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />काबरकि मोर घरवाला ह घर म नइं ए;</para>
  <para style="q2" vid="PRO 7:19">ओह दूरिहा देस चले गे हवय।<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />ओह अपन संग रूपिया ले भरे थैली ले गे हवय</para>
  <para style="q2" vid="PRO 7:20">अऊ ओह पून्नी के दिन घर लहुंटही।”<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />अइसने बात कहिके, ओह ओ जवान ला बहका लीस;</para>
  <para style="q2" vid="PRO 7:21">अऊ अपन गुरतूर बोली ले ओला मोह लीस।<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />ओ जवान ह तुरते ओकर पाछू हो लीस</para>
  <para style="q2" vid="PRO 7:22">जइसने कि कोनो पसु ह कसाईखाना जाथे,</para>
  <para style="q1" vid="PRO 7:22">या जइसने कि कोनो हिरन<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">मुरूख</char></note> फांदा म फंसे बर जाथे<verse eid="PRO 7:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23" />अऊ ओकर करेजा ला तीर ले बेधे जाथे;</para>
  <para style="q1" vid="PRO 7:23">या ओ जवान ह ओ चिरई सहीं अय, जऊन ह जाल म जाके फंसथे,</para>
  <para style="q2" vid="PRO 7:23">अऊ नइं जानय कि ओमा ओकर परान जाही।<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />अब, हे मोर बेटामन, मोर बात ला सुनव;</para>
  <para style="q2" vid="PRO 7:24">अऊ मोर बात ऊपर धियान दव।<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />तुम्हर मन ह अइसने माईलोगन ऊपर झन लगय,</para>
  <para style="q2" vid="PRO 7:25">या ओकर डहार म तुमन झन भटकव।<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />ओकर फांदा म फंसके बहुंते झन नास हो गे हवंय;</para>
  <para style="q2" vid="PRO 7:26">ओकर दुवारा मारे गे मनखेमन के संखिया बहुंत बड़े हवय।<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />ओकर घर ह मरघटी के रसता ए,</para>
  <para style="q2" vid="PRO 7:27">जऊन ह खाल्हे मिरतू के काल-कोठरी ला जाथे।<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">बुद्धि के बुलावा</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />का बुद्धि ह नइं पुकारय?</para>
  <para style="q2" vid="PRO 8:1">का समझ ह ऊंचहा अवाज म नइं बोलय?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />ओह डहार के तीर, ऊंचहा ठऊर म,</para>
  <para style="q2" vid="PRO 8:2">सड़क के चऊक म खड़े होथे;<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />सहर जाय के रसता, दुवार के बाजू म,</para>
  <para style="q2" vid="PRO 8:3">प्रवेस दुवार करा, ओह चिचियाके कहिथे:<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />“हे मनखेमन, मेंह तुमन ला पुकारत हंव;</para>
  <para style="q2" vid="PRO 8:4">मोर बात ह जम्मो मनखेमन बर अय।<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />तुमन, जऊन मन भोला-भाला अव, बुद्धिमान बनव;</para>
  <para style="q2" vid="PRO 8:5">जऊन मन मुरूख अव, ओमन समझदार बनव।<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />सुनव, मोर करा कहे बर उत्तम बात हवय;</para>
  <para style="q2" vid="PRO 8:6">मेंह सही बात ला कहिथंव।<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />मोर मुहूं ले सच बात निकलथे,</para>
  <para style="q2" vid="PRO 8:7">काबरकि दुस्टता के बात ले मेंह घिन करथंव।<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />मोर मुहूं के जम्मो बात धरमीपन के होथे;</para>
  <para style="q2" vid="PRO 8:8">ओमा कोनो उल्टा या खराप बात नइं रहय।<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />समझनेवाला बर येमन सही अंय;</para>
  <para style="q2" vid="PRO 8:9">अऊ जऊन मन गियान पा गे हवंय, ओमन बर येमन सीधा अंय।<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />चांदी के बदले मोर सिकछा ला चुनव,</para>
  <para style="q2" vid="PRO 8:10">अऊ सुध सोन के बदले मोर गियान ला लव,<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />काबरकि बुद्धि ह मनि ले जादा कीमती अय,</para>
  <para style="q2" vid="PRO 8:11">अऊ कोनो भी मनभावन चीज के तुलना येकर ले नइं करे जा सकय।<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />“में बुद्धि अंव अऊ समझदारी के संग रहिथंव;</para>
  <para style="q2" vid="PRO 8:12">गियान अऊ बिबेक मोर म हवय।<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />यहोवा के भय मनई के मतलब बुरई ले घिन करई अय।</para>
  <para style="q2" vid="PRO 8:13">मेंह घमंड अऊ जिद्दीपन,</para>
  <para style="q2" vid="PRO 8:13">खराप बरताव अऊ बुरई के बात ले घिन करथंव।<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />उत्तम सलाह अऊ सही नियाय मेंह करथंव;</para>
  <para style="q2" vid="PRO 8:14">मोर करा समझ के बात अऊ सामर्थ हवय।<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />मोर दुवारा राजामन राज करथें</para>
  <para style="q2" vid="PRO 8:15">अऊ सासन करइयामन सही फैसला करथें।<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />मोर दुवारा ही सासन करइया,</para>
  <para style="q2" vid="PRO 8:16">अऊ जम्मो हाकिममन सासन करथें।<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />मेंह ओमन ला मया करथंव, जऊन मन मोला मया करथें,</para>
  <para style="q2" vid="PRO 8:17">अऊ जऊन मन मोला खोजथें, ओमन मोला पाथें।<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />धन अऊ आदरमान मोर करा हवय,</para>
  <para style="q2" vid="PRO 8:18">ठहरइया धन अऊ उन्नति घलो मोर करा हवय।<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />मोर फर ह चोखा सोन ले घलो जादा बने अय,</para>
  <para style="q2" vid="PRO 8:19">अऊ जऊन चीज मेंह उतपन करथंव, ओह उत्तम चांदी ले बढ़के होथे।<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />मेंह धरमीपन,</para>
  <para style="q2" vid="PRO 8:20">अऊ नियाय के रसता म चलथंव,<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />ताकि जऊन मन मोर ले मया करथें, ओमन ला उत्तम उत्तराधिकार दंव,</para>
  <para style="q2" vid="PRO 8:21">अऊ ओमन के भंडार ला भर दंव।<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />“यहोवा ह अपन काम के सुरूआत ले,</para>
  <para style="q2" vid="PRO 8:22">अपन पुराना काम के पहिले मोला लानिस;<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />मेंह आदिकाल ले,</para>
  <para style="q2" vid="PRO 8:23">सिरिस्टी ला रचे के पहिले ठहिराय गे हवंव।<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />जब न तो गहिरा समुंदर रिहिस,</para>
  <para style="q2" vid="PRO 8:24">अऊ न ही उमड़त पानी के झरना रिहिस, तब ले मेंह जनमे हवंव।<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />पहाड़ अऊ पहाड़ीमन ला बनाय के पहिले,</para>
  <para style="q2" vid="PRO 8:25">मेंह जनमेंव;<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />येकर पहिले कि परमेसर ह संसार या येकर इलाका,</para>
  <para style="q2" vid="PRO 8:26">या धरती के धुर्रा ला बनातिस।<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />जब ओह अकासमन ला स्थापित करिस, त मेंह उहां रहेंव,</para>
  <para style="q2" vid="PRO 8:27">जब ओह समुंदर अऊ अकास के बीच म सीमना बांधिस,<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />जब ओह ऊपर म बादर ला ठहिराईस</para>
  <para style="q2" vid="PRO 8:28">अऊ गहरई म पानी के सोत बनाईस,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />जब ओह समुंदर के सीमना ला ठहिराईस,</para>
  <para style="q2" vid="PRO 8:29">ताकि पानी ह ओकर हुकूम ला झन टारय,</para>
  <para style="q1" vid="PRO 8:29">अऊ जब ओह धरती के नीव रखिस।<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />तब मेंह हमेसा ओकर संग रहेंव।</para>
  <para style="q1" vid="PRO 8:30">मेंह हर दिन खुसी म मगन रहेंव,</para>
  <para style="q2" vid="PRO 8:30">अऊ हमेसा ओकर आघू म आनंदित रहेंव।<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />मेंह ओकर बसाय जम्मो संसार ले आनंदित रहेंव</para>
  <para style="q2" vid="PRO 8:31">अऊ मनखेमन म रहिके खुस होवत रहेंव।<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />“एकरसेति, अब हे मोर लइकामन, मोर बात ला सुनव;</para>
  <para style="q2" vid="PRO 8:32">धइन अंय ओमन, जऊन मन मोर बताय रसता म चलथें।<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />मोर सिकछा ला सुनव अऊ बुद्धिमान बनव;</para>
  <para style="q2" vid="PRO 8:33">येला तुछ झन जानव।<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />धइन अंय ओमन, जऊन मन मोर गोठ ला सुनथें,</para>
  <para style="q2" vid="PRO 8:34">अऊ मोर कपाट करा हर दिन रखवारी करथें,</para>
  <para style="q2" vid="PRO 8:34">अऊ मोर कपाट के रसता म अगोरत रहिथें।<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />काबरकि जऊन मन मोला पाथें, ओमन जिनगी पाथें</para>
  <para style="q2" vid="PRO 8:35">अऊ यहोवा ओमन ऊपर किरपा करथे।<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />पर जऊन मन मोला पाय म असफल होथें, ओमन अपन के हानि करथें;</para>
  <para style="q2" vid="PRO 8:36">ओ जम्मो जऊन मन मोर ले घिन करथें, ओमन मिरतू ले मया करथें।”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">बुद्धि अऊ मुरूखता के नेवता</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />बुद्धि ह अपन घर बनाईस;</para>
  <para style="q2" vid="PRO 9:1">ओह येकर सात ठन खंभा बनाय हवय।<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />ओह अपन पसु के मांस रांधे हवय अऊ अंगूर के मंद तियार करे हवय;</para>
  <para style="q2" vid="PRO 9:2">अऊ खाना खाय बर अपन मेज म रखे हवय।<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />ओह अपन सेवकमन ला पठोय हवय,</para>
  <para style="q2" vid="PRO 9:3">अऊ ओह सहर के सबले ऊंच जगह ले, ये कहिके बलाथे,<verse eid="PRO 9:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4" />“जऊन मन सीधा-साधा अंय, ओमन मोर घर म आवंय!”</para>
  <para style="q1" vid="PRO 9:4">जऊन मन निरबुद्धि अंय, ओमन ला ओह कहिथे,<verse eid="PRO 9:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5" />“आवव, मोर खाना खावव</para>
  <para style="q2" vid="PRO 9:5">अऊ मोर तियार करे गे अंगूर के मंद ला पीयव।<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />अपन सीधा-साधा रसता ला छोंड़व, त तुमन जीयत रहिहू;</para>
  <para style="q2" vid="PRO 9:6">समझवाले रसता म चलव।”<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />जऊन ह ठट्ठा करइया ला सिकछा देथे, ओकर बेजत्ती होथे;</para>
  <para style="q2" vid="PRO 9:7">जऊन ह दुस्ट मनखे ला डांटथे, ओह गारी खाथे।<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />ठट्ठा करइयामन ला झन डांट, नइं तो ओमन तोर ले घिन करहीं;</para>
  <para style="q2" vid="PRO 9:8">बुद्धिमान मनखेमन ला डांट, त ओमन तोर ले मया करहीं।<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />बुद्धिमान मनखे ला सिकछा दे, त ओमन अऊ बुद्धिमान होहीं;</para>
  <para style="q2" vid="PRO 9:9">धरमीमन ला सिखा, त ओमन अपन गियान ला अऊ बढ़ाहीं।<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />यहोवा के भय मनई बुद्धि के सुरूआत अय,</para>
  <para style="q2" vid="PRO 9:10">पबितर परमेसर ला जानई समझ के बात अय।<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />काबरकि परमेसर के दुवारा तोर उमर बढ़ही,</para>
  <para style="q2" vid="PRO 9:11">अऊ तोर जिनगी म अऊ बछर जोड़े जाही।<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />कहूं तेंह बुद्धिमान अस, त तोर बुद्धि के कारन तोला ईनाम मिलही;</para>
  <para style="q2" vid="PRO 9:12">यदि तेंह ठट्ठा करइया अस, त सिरिप तेंहीच ह दुख भोगबे।<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />मुरूखता ह एक ब्यवस्थाहीन माईलोगन सहीं अय;</para>
  <para style="q2" vid="PRO 9:13">ओह सीधी-साधी अय अऊ कुछू नइं जानय।<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />ओह अपन घर के कपाट करा बईठथे;</para>
  <para style="q2" vid="PRO 9:14">ओह सहर के सबले ऊंच जगह म आसन जमाथे<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />अऊ जऊन मन उहां ले होवत, अपन रसता म सीधा जावत रहिथें,</para>
  <para style="q2" vid="PRO 9:15">ओमन ला ओह चिचियाके कहिथे,<verse eid="PRO 9:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16" />“जऊन मन सीधा-साधा अंय, ओमन मोर घर म आवंय!”</para>
  <para style="q1" vid="PRO 9:16">जऊन मन निरबुद्धि अंय, ओमन ला ओह कहिथे,<verse eid="PRO 9:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17" />“चोराय पानी ह मीठ लगथे;</para>
  <para style="q2" vid="PRO 9:17">चोरी-छुपे खाय खाना ह सुवादिस्ट होथे!”<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />पर ओमन नइं जानंय कि उहां मरे मनखेमन हवंय,</para>
  <para style="q2" vid="PRO 9:18">अऊ ये घलो कि ओकर पहुनामन गहिरा, मिरतू-लोक म हवंय।<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="ms1">सुलेमान राजा के नीतिबचन</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />सुलेमान के नीतिबचन:</para>
  <para style="q1" vid="PRO 10:1">बुद्धिमान बेटा ले ओकर ददा ह खुस होथे,</para>
  <para style="q2" vid="PRO 10:1">पर मुरूख बेटा ह अपन दाई ऊपर दुख लानथे।<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />बेईमानी ले कमाय धन ले लाभ नइं होवय,</para>
  <para style="q2" vid="PRO 10:2">पर मनखे के धरमीपन ह ओला मिरतू ले बचाथे।<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />यहोवा ह धरमी मनखे ला भूखा रहन नइं देवय,</para>
  <para style="q2" vid="PRO 10:3">पर ओह दुस्ट मनखे के ईछा ला पूरा होवन नइं देवय।<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />काम म ढिलई करइया मनखे गरीब हो जाथे,</para>
  <para style="q2" vid="PRO 10:4">पर मेहनती मनखे धनी होथे।<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />गरमी के महिना म जऊन ह फसल ला संकेलथे, ओह बुद्धिमान बेटा ए,</para>
  <para style="q2" vid="PRO 10:5">पर जऊन ह फसल लुवई के बेरा सुतत रहिथे, ओह कलंकित बेटा ए।<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />धरमी मनखे ला बहुंत आसीस मिलथे,</para>
  <para style="q2" vid="PRO 10:6">पर दुस्ट मनखे के मुहूं ले बहुंत हिंसा के बात निकलथे।<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />धरमी के नांव ह आसीस देय म उपयोग होथे,<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="GEN 48:20">उत 48:20</ref></char></char></note></para>
  <para style="q2" vid="PRO 10:7">पर दुस्ट के नांव ह मिट जाथे।<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />बुद्धिमान ह हिरदय म हुकूम ला गरहन करथे,</para>
  <para style="q2" vid="PRO 10:8">पर बकवास करइया मुरूख ह नास हो जाथे।<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />जऊन ह ईमानदारी से चलथे, ओह निडर रहिथे,</para>
  <para style="q2" vid="PRO 10:9">पर जऊन ह बेईमानी के रसता म चलथे, ओकर पोल खुल जाथे।<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />जऊन ह गलत इरादा से आंखी मारथे, ओकर ले दुख मिलथे,</para>
  <para style="q2" vid="PRO 10:10">अऊ बकवास करइया मुरूख ह नास हो जाथे।<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />धरमी मनखे के मुहूं ले जिनगी के बात निकलथे,</para>
  <para style="q2" vid="PRO 10:11">पर दुस्ट मनखे के मुहूं ले हिंसा के बात निकलथे।<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />काकरो ले घिन करई ह झगरा ला सुरू करथे,</para>
  <para style="q2" vid="PRO 10:12">पर मया ह जम्मो गलती ला ढांप देथे।<verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />समझदार मनखे के बातचीत म बुद्धि पाय जाथे,</para>
  <para style="q2" vid="PRO 10:13">पर निरबुद्धि ला लउठी के मार पड़थे।<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />बुद्धिमान ह गियान ला इकट्ठा करथे,</para>
  <para style="q2" vid="PRO 10:14">पर मुरूख ह अपन बात के जरिये बिनास लानथे।<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />धनवानमन के धन ह ओमन के गढ़वाला सहर होथे,</para>
  <para style="q2" vid="PRO 10:15">पर गरीब के गरीबी ह ओकर बिनास के कारन ए।<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />धरमी मनखे के मजदूरी जिनगी अय,</para>
  <para style="q2" vid="PRO 10:16">पर दुस्ट मनखे के कमई पाप अऊ मिरतू अय।<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />जऊन ह अनुसासन ला मानथे, ओह जिनगी के रसता ला देखाथे,</para>
  <para style="q2" vid="PRO 10:17">पर जऊन ह अनुसासन ला नइं मानय, ओह दूसरमन ला गलत रसता म ले जाथे।<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />जऊन ह लबारी मारके बईरता ला छुपाथे</para>
  <para style="q2" vid="PRO 10:18">अऊ दूसर के निन्दा करथे, ओह मुरूख ए।<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />जिहां जादा बात होथे, उहां पाप घलो होथे,</para>
  <para style="q2" vid="PRO 10:19">पर जऊन ह अपन मुहूं म लगाम लगाथे, ओह बुद्धिमान ए।<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />धरमी मनखे के बचन ह उत्तम चांदी सहीं अय,</para>
  <para style="q2" vid="PRO 10:20">पर दुस्ट मनखे के बात बहुंत हल्का होथे।<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />धरमी मनखे के बात ले बहुंते जन के भलई होथे,</para>
  <para style="q2" vid="PRO 10:21">पर मुरूखमन बुद्धि के कमी के कारन मर जाथें।<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />यहोवा के आसीस ले धन मिलथे,</para>
  <para style="q2" vid="PRO 10:22">ओकर संग ओह दुख नइं देवय।<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />मुरूख ला खराप काम करई म खुसी मिलथे,</para>
  <para style="q2" vid="PRO 10:23">पर समझदार मनखे बुद्धि के बात म खुस होथे।<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />जऊन बात ले दुस्ट मनखे ह डरथे, ओहीच बात ओकर संग होही,</para>
  <para style="q2" vid="PRO 10:24">पर धरमी जन के ईछा ला पूरा करे जाही।<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />जब बिपत्ति चले जाथे, त ओकर संग दुस्टमन के घलो अन्त हो जाथे,</para>
  <para style="q2" vid="PRO 10:25">पर धरमीमन सदा इस्थिर बने रहिथें।<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />जइसे दांत बर खट्टई अऊ आंखी बर धुआं होथे,</para>
  <para style="q2" vid="PRO 10:26">वइसे आलसी मनखेमन ओमन बर होथें, जऊन मन ओमन ला पठोथें।<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />यहोवा के भय माने ले मनखे के उमर ह बढ़थे,</para>
  <para style="q2" vid="PRO 10:27">पर दुस्ट मनखे जादा साल तक नइं जीयय।<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />धरमी जन ला आसा रखई म आनंद मिलथे,</para>
  <para style="q2" vid="PRO 10:28">पर दुस्ट मनखे के आसा टूट जाथे।<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />यहोवा के रसता ह निरदोसीमन बर सरन-स्थान ए,</para>
  <para style="q2" vid="PRO 10:29">पर जऊन मन दुस्टता करथें, ओमन बर बिनास के जगह ए।<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />धरमी जन सदा अटल बने रहिही,</para>
  <para style="q2" vid="PRO 10:30">पर दुस्ट मनखे धरती म बने नइं रह सकय।<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />धरमी के मुहूं ले बुद्धि के बात निकलथे,</para>
  <para style="q2" vid="PRO 10:31">पर बेकार बात करइया के मुहूं ला बंद करे जाही।<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />धरमी के मुहूं ले समझदारी के बात निकलथे,</para>
  <para style="q2" vid="PRO 10:32">पर दुस्ट मनखे के मुहूं ले सिरिप बेकार के बात निकलथे।<verse eid="PRO 10:32" /></para>
  <para style="b" />
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />यहोवा ह बेईमानी के तौल ले बहुंत घिन करथे,</para>
  <para style="q2" vid="PRO 11:1">पर सही तौल ले ओह खुस होथे।<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />जब घमंड आथे, त अपमान घलो आथे,</para>
  <para style="q2" vid="PRO 11:2">पर नमरता के संग बुद्धि आथे।<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />ईमानदार मनखेमन ला ओमन के ईमानदारी ह अगुवई करथे,</para>
  <para style="q2" vid="PRO 11:3">पर बिसवासघाती मनखेमन अपन छल-कपट म नास हो जाथें।<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />कोप के बेरा म धन ले कोनो लाभ नइं होवय,</para>
  <para style="q2" vid="PRO 11:4">पर धरमीपन ह मिरतू ले बचाथे।<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />निरदोस मनखेमन के धरमीपन ह ओमन के रसता ला सीधा करथे,</para>
  <para style="q2" vid="PRO 11:5">पर दुस्ट मनखेमन अपन ही दुस्टता म गिर जाथें।<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />ईमानदार मनखेमन के धरमीपन ह ओमन ला बचाथे,</para>
  <para style="q2" vid="PRO 11:6">पर बिसवासघाती मनखेमन अपन ही दुस्ट ईछा म फंसथें।<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />दुस्ट मनखेमन के संग ओमन के आसा घलो टूट जाथे;</para>
  <para style="q2" vid="PRO 11:7">ओमन के सक्ति के जम्मो परतिगियां बेकार हो जाथे।<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />धरमी मनखेमन बिपत्ति ले बचाय जाथें,</para>
  <para style="q2" vid="PRO 11:8">पर ओहीच बिपत्ति दुस्ट मनखे ऊपर पड़थे।<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />भक्तिहीन मनखेमन अपन बात ले अपन परोसी ला नास करथें,</para>
  <para style="q2" vid="PRO 11:9">पर गियान के दुवारा धरमी मनखेमन बच जाथें।<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />जब धरमी मनखेमन उन्नति करथें, त सहर के मनखेमन आनंद मनाथें;</para>
  <para style="q2" vid="PRO 11:10">जब दुस्ट मनखेमन नास होथें, त आनंद के कारन जयकार होथे।<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />धरमी मनखेमन के आसीस ले सहर के उन्नति होथे।</para>
  <para style="q2" vid="PRO 11:11">पर दुस्ट मनखेमन के गोठ ले येह नास होथे।<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />जऊन ह अपन परोसी के हंसी उड़ाथे, ओह निरबुद्धि ए,</para>
  <para style="q2" vid="PRO 11:12">पर समझदार मनखे अपन मुहूं म लगाम लगाथे।<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />लबारी बात ह बिसवास ला टोरथे,</para>
  <para style="q2" vid="PRO 11:13">पर बिसवासयोग्य मनखे ह गुपत के बात ला बनाय रखथे।<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />मार्ग-दरसन के अभाव म देस ह बिपत्ति म पड़थे,</para>
  <para style="q2" vid="PRO 11:14">पर जीत ह बहुंत सलाहकारमन के जरिये मिलथे।<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />जऊन ह अजनबी के जमानत लेथे, ओह दुख उठाथे,</para>
  <para style="q2" vid="PRO 11:15">पर जऊन ह जमानत लेय बर मना करथे, ओह सुखी रहिथे।<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />दयालु माईलोगन ह आदरमान पाथे,</para>
  <para style="q2" vid="PRO 11:16">पर निरदयी आदमी सिरिप धन कमाथे।<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />दयालु मनखेमन अपन बर लाभ कमाथें,</para>
  <para style="q2" vid="PRO 11:17">पर निरदयीमन अपन ऊपर बिनास लानथें।<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />दुस्ट मनखे ह छल-कपट के कमई करथे,</para>
  <para style="q2" vid="PRO 11:18">पर जऊन ह धरमीपन देखाथे, ओह सही म ईनाम पाथे।<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />धरमीमन सही म जिनगी पाथें,</para>
  <para style="q2" vid="PRO 11:19">पर जऊन ह बुरई के पाछू चलथे, ओह मरथे।<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />यहोवा ह हठी मनखे ले घिन करथे,</para>
  <para style="q2" vid="PRO 11:20">पर ओह निरदोस चालचलनवाला मनखे ले खुस होथे।<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />ये बात बर निस्चित रहव: दुस्ट ह जरूर दंड पाही,</para>
  <para style="q2" vid="PRO 11:21">पर जऊन मन धरमी अंय, ओमन छोंड़ दिये जाहीं।<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />जऊन सुघर माईलोगन ह समझदारी नइं देखाय,</para>
  <para style="q2" vid="PRO 11:22">ओह थोथना म सोन के नथ पहिरे सूरा के सहीं अय।<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />धरमीमन के ईछा के अन्त सिरिप भलई म होथे,</para>
  <para style="q2" vid="PRO 11:23">पर दुस्टमन के आसा के अन्त सिरिप कोरोध म होथे।<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />एक मनखे ह दिल खोलके देथे, तभो ले ओकर बढ़ती होथे;</para>
  <para style="q2" vid="PRO 11:24">दूसर मनखे ह देय म कंजूसी करथे, पर ओह गरीब हो जाथे।<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />उदार मनखे के उन्नति होही,</para>
  <para style="q2" vid="PRO 11:25">अऊ जऊन ह दूसर के खियाल रखथे, ओकर खियाल रखे जाही।<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />मनखेमन ओ मनखे ला सराप देथें, जऊन ह अनाज ला दबाके रखे रहिथे,</para>
  <para style="q2" vid="PRO 11:26">पर जऊन ह बेचे के ईछा रखथे, ओकर बर मनखेमन आसीस मांगथें।<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />जऊन ह भलई करे चाहथे, ओकर ऊपर किरपा करे जाथे,</para>
  <para style="q2" vid="PRO 11:27">पर जऊन ह बुरई करे के ईछा रखथे, ओकर ऊपर बुरई आ जाथे।<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />जऊन मन अपन धन ऊपर भरोसा रखथें, ओमन गिरहीं,</para>
  <para style="q2" vid="PRO 11:28">पर धरमी मनखेमन हरियर पान सहीं बढ़हीं।<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />जऊन ह अपन परिवार ला दुख देथे, ओला बांटा म कुछू नइं मिलय,</para>
  <para style="q2" vid="PRO 11:29">अऊ मुरूख ह बुद्धिमान के दास होही।<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />धरमी के परतिफल जिनगी के रूख होथे,</para>
  <para style="q2" vid="PRO 11:30">अऊ जऊन ह बुद्धिमान ए, ओह जिनगी बचाथे।<verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />यदि धरमी मनखे ला ये धरती म ओकर फर मिलथे,</para>
  <para style="q2" vid="PRO 11:31">त भक्तिहीन अऊ पापी ला ओकर परतिफल काबर नइं मिलही!<verse eid="PRO 11:31" /></para>
  <para style="b" />
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />जऊन ह अनुसासन ले मया करथे, ओह गियान ले मया करथे,</para>
  <para style="q2" vid="PRO 12:1">पर जऊन ह सुधरे बर नइं चाहय, ओह मुरूख अय।<verse eid="PRO 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />बने मनखेमन ऊपर यहोवा के किरपा होथे,</para>
  <para style="q2" vid="PRO 12:2">पर दुस्ट उपाय करइयामन ला ओह दोसी ठहिराथे।<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />कोनो दुस्ट काम करे के दुवारा इस्थिर नइं रह सकय,</para>
  <para style="q2" vid="PRO 12:3">पर धरमी मनखे ला कोनो डिगा नइं सकंय।<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />बने चालचलनवाली माईलोगन ह अपन घरवाला के मुकुट ए,</para>
  <para style="q2" vid="PRO 12:4">पर कलंकित माईलोगन ह अपन घरवाला के सरे हाड़ा सहीं अय।<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />धरमीमन के योजना ह सही होथे,</para>
  <para style="q2" vid="PRO 12:5">पर दुस्टमन के सलाह धोखा देवइया होथे।<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />दुस्टमन के बातचीत ह हतिया करे बर घात लगाय के बारे म होथे,</para>
  <para style="q2" vid="PRO 12:6">पर सीधा-साधा मनखे के बातचीत ह ओमन ला बचाथे।<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />दुस्टमन ला नास करे जाथे अऊ ओमन बचे नइं रहंय,</para>
  <para style="q2" vid="PRO 12:7">पर धरमी के घर ह मजबूत बने रहिथे।<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />मनखे के परसंसा ओकर बुद्धि के अनुसार होथे,</para>
  <para style="q2" vid="PRO 12:8">पर बिगड़े बुद्धि के मनखे ह तुछ समझे जाथे।<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />जेकर करा खाय बर खाना तक नइं रहय अऊ अपन बड़ई मारथे</para>
  <para style="q2" vid="PRO 12:9">ओकर ले सेवक रखइया छोटे मनखे ह बने अय।<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />धरमी मनखे अपन पसुमन के घलो चिंता करथे,</para>
  <para style="q2" vid="PRO 12:10">पर दुस्ट मनखे के दया के काम ह घलो निरदयी होथे।<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />जऊन मन अपन खेत ला कमाथें, ओमन करा बहुंत जेवन होही,</para>
  <para style="q2" vid="PRO 12:11">पर जऊन मन सिरिप कल्पना करत रहिथें, ओमन निरबुद्धि अंय।<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />दुस्ट मनखेमन, खराप काम करइया मनखेमन ले सुरकछा के मनसा करथें।</para>
  <para style="q2" vid="PRO 12:12">पर धरमीमन के जरी ह बने रहिथे।<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />खराप मनखेमन अपन खराप गोठ के कारन फंसथें,</para>
  <para style="q2" vid="PRO 12:13">अऊ निरदोस मनखेमन समस्या ले बच जाथें।<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />मनखेमन अपन सुघर गोठ के कारन बने चीज ले भर जाथें,</para>
  <para style="q2" vid="PRO 12:14">अऊ ओमन के हांथ के मेहनत ह ओमन ला ईनाम देवाथे।<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />मुरूखमन ला अपनेच रसता ह सही लगथे,</para>
  <para style="q2" vid="PRO 12:15">पर बुद्धिमान मनखेमन दूसरमन के सलाह ला सुनथें।<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />मुरूखमन तुरते अपन रिस देखाथें,</para>
  <para style="q2" vid="PRO 12:16">पर समझदार मनखेमन अपन बेजत्ती ला धियान नइं देवंय।<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />एक ईमानदार गवाह ह सच बोलथे,</para>
  <para style="q2" vid="PRO 12:17">पर लबरा गवाह ह लबारी मारथे।<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />बिगर सोचे-बिचारे बोलनेवाला के गोठ ह तलवार सहीं चूभथे,</para>
  <para style="q2" vid="PRO 12:18">पर बुद्धिमान मनखे के बात ह दवाई के सहीं बने काम करथे।<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />सच बात ह हमेसा बने रहिथे,</para>
  <para style="q2" vid="PRO 12:19">पर लबरा गोठ सिरिप पल भर के होथे।<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />खराप काम करइयामन के मन म छल-कपट होथे,</para>
  <para style="q2" vid="PRO 12:20">पर जऊन मन सांति के बात करथें, ओमन ला आनंद मिलथे।<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />धरमी ला कोनो हानि नइं होवय,</para>
  <para style="q2" vid="PRO 12:21">पर दुस्ट मनखे ह समस्या ले भरे रहिथे।<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />लबारी बात ले यहोवा बहुंत घिन करथे,</para>
  <para style="q2" vid="PRO 12:22">पर ओह बिसवासयोग्य मनखे ले बहुंत खुस होथे।<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />समझदार मनखेमन अपन गियान ला अपन म रखथें,</para>
  <para style="q2" vid="PRO 12:23">पर मुरूख मनखे ह बिगर सोचे अपन मुरूखता ला बक देथे।<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />मेहनती मनखेमन सासन करथें,</para>
  <para style="q2" vid="PRO 12:24">पर आलसी मनखे ह मजदूरी करे बर बाध्य होथे।<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />मनखे के उतावलापन ह ओकर मन ला उदास कर देथे,</para>
  <para style="q2" vid="PRO 12:25">पर बने बात ले ओह खुस होथे।<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />धरमी मनखे ह धियान देके अपन संगवारी चुनथे,</para>
  <para style="q2" vid="PRO 12:26">पर दुस्ट मनखे के चालचलन ह ओला भटका देथे।<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />आलसी मनखे कोनो काम करे नइं चाहय,</para>
  <para style="q2" vid="PRO 12:27">पर मेहनती मनखे ला अपन मेहनत ले कीमती चीज मिलथे।<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />धरमीपन के रसता म जिनगी हवय,</para>
  <para style="q2" vid="PRO 12:28">अऊ ओ रसता म मिरतू नइं ए।<verse eid="PRO 12:28" /></para>
  <para style="b" />
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />बुद्धिमान बेटा ह अपन ददा के सिकछा म धियान लगाथे,</para>
  <para style="q2" vid="PRO 13:1">पर ठट्ठा करइया ह डांट ला घलो नइं सुनय।<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />मनखेमन अपन बने बात के कारन बने चीजमन के आनंद उठाथें,</para>
  <para style="q2" vid="PRO 13:2">पर बिसवासघाती मनखे के भूख हिंसा करे म मिटथे।<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />जऊन मन अपन मुहूं म लगाम लगाथें, ओमन अपन परान के रकछा करथें,</para>
  <para style="q2" vid="PRO 13:3">पर जऊन मन बिगर सोचे गोठियाथें, ओमन नास हो जाथें।<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />आलसी मनखे के भूख कभू नइं मिटय,</para>
  <para style="q2" vid="PRO 13:4">पर मेहनती मनखे के ईछा पूरा होथे।<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />धरमी मनखे लबरा बात ले घिन करथे,</para>
  <para style="q2" vid="PRO 13:5">पर दुस्ट मनखे अपनआप ला एक दुरगंध के चीज सहीं बना लेथे</para>
  <para style="q2" vid="PRO 13:5">अऊ अपन ऊपर कलंक लगाथे।<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />धरमीपन ह ईमानदार मनखे के रकछा करथे</para>
  <para style="q2" vid="PRO 13:6">पर दुस्टता ह पापी मनखे ला नास कर देथे।<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />एक मनखे अपन ला धनवान जताथे, पर ओकर करा कुछू नइं रहय;</para>
  <para style="q2" vid="PRO 13:7">दूसर ह अपन ला गरीब जताथे, पर ओकर करा बहुंत धन होथे।<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />मनखे के धन ह ओकर जिनगी ला छुड़ा सकथे,</para>
  <para style="q2" vid="PRO 13:8">पर गरीब मनखे ह धमकी भरे डांट के जबाब घलो नइं दे सकय।<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />धरमी मनखे के अंजोर ह बहुंत चमकथे,</para>
  <para style="q2" vid="PRO 13:9">पर दुस्ट मनखे के दीया ह बुता जाथे।<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />घमंड के कारन झगरा होथे,</para>
  <para style="q2" vid="PRO 13:10">पर जऊन मन सलाह लेथें, ओमन म बुद्धि होथे।<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />बेईमानी के पईसा ह खतम हो जाथे,</para>
  <para style="q2" vid="PRO 13:11">पर जऊन ह थोर-थोर करके पईसा जमा करथे, ओ पईसा ह बढ़थे।<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />जब आसा के पूरा होय म देरी होथे, त मन ह बिचलित होथे,</para>
  <para style="q2" vid="PRO 13:12">पर मनसा के पूरा होवई ह जिनगी के रूख सहीं अय।<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />जऊन ह हुकूम ला तुछ समझथे, ओह येकर दाम चुकाही,</para>
  <para style="q2" vid="PRO 13:13">पर जऊन ह हुकूम ला मानथे, ओला ईनाम मिलथे।<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />बुद्धिमान मनखे के सिकछा ह जिनगी के झरना ए,</para>
  <para style="q2" vid="PRO 13:14">जऊन ह मनखे ला मिरतू के फांदा ले बचाथे।<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />सुबुद्धि ले अनुग्रह मिलथे,</para>
  <para style="q2" vid="PRO 13:15">पर बिसवासघातीमन के रसता ह ओमन के बिनास कोति जाथे।<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />जम्मो समझदार मनखे गियान के संग काम करथें।</para>
  <para style="q2" vid="PRO 13:16">पर मुरूखमन अपन मुरूखता देखाथें।<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />दुस्ट संदेसिया ह समस्या म पड़थे,</para>
  <para style="q2" vid="PRO 13:17">पर बिसवासयोग्य संदेसिया ह बने संदेस लेके आथे।<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />जऊन ह अनुसासन ला तुछ समझथे, ओह गरीबी अऊ लज्जा म पड़थे,</para>
  <para style="q2" vid="PRO 13:18">पर जऊन ह डांट ऊपर धियान देथे, ओह आदर पाथे।<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />ईछा के पूरा होवई ह मन ला गुरतूर लगथे,</para>
  <para style="q2" vid="PRO 13:19">पर मुरूख मनखे ह दुस्ट काम ला बिलकुल ही छोंड़े नइं चाहय।<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />बुद्धिमान के संगति कर, त तें घलो बुद्धिमान हो जाबे,</para>
  <para style="q2" vid="PRO 13:20">काबरकि मुरूख के संगी ला हानि उठाना पड़थे।<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />समस्या ह पापीमन के पाछू लगे रहिथे,</para>
  <para style="q2" vid="PRO 13:21">पर धरमीमन ला बने चीज के ईनाम मिलथे।<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />बने मनखे ह अपन नाती-पोतामन बर धन-संपत्ति छोंड़ जाथे,</para>
  <para style="q2" vid="PRO 13:22">पर पापी के संपत्ति धरमी बर रखे जाथे।<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />बंजर भुइयां ह गरीब बर फसल पईदा करथे,</para>
  <para style="q2" vid="PRO 13:23">पर अनियाय ह येला छीन लेथे।<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />जऊन ह अपन लइकामन ला छड़ी ले अनुसासित नइं करय, ओह ओकर बईरी अय।</para>
  <para style="q2" vid="PRO 13:24">पर जऊन ह अपन लइकामन ले मया करथे, ओह ओमन ला अनुसासित घलो करथे।<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />धरमी ह पेट भर खाय ला पाथे,</para>
  <para style="q2" vid="PRO 13:25">पर दुस्ट मनखे ह भूखन ही रहिथे।<verse eid="PRO 13:25" /></para>
  <para style="b" />
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />बुद्धिमान माईलोगन ह अपन घर ला बनाथे,</para>
  <para style="q2" vid="PRO 14:1">पर मुरूख माईलोगन ह अपन खुद के हांथ ले ओला गिरा देथे।<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />जऊन ह यहोवा के भय मानथे, ओह ईमानदारी से चलथे,</para>
  <para style="q2" vid="PRO 14:2">पर जऊन मन ओला तुछ जानथें, ओमन अपन डहार ले भटक गे हवंय।<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />मुरूख ला ओकर घमंड के बात के कारन दंड मिलथे,</para>
  <para style="q2" vid="PRO 14:3">पर बुद्धिमान मनखेमन के बात ह ओमन ला बचाथे।<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />जिहां बईलामन नइं रहंय, त उहां कोटना ह खाली रहिथे,</para>
  <para style="q2" vid="PRO 14:4">पर बईला के ताकत ले बहुंत फसल होथे।<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />ईमानदार गवाह ह धोखा नइं देवय,</para>
  <para style="q2" vid="PRO 14:5">पर लबरा गवाह ह अब्बड़ लबारी मारथे।<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />ठट्ठा करइया ह बुद्धि ला खोजथे, पर नइं पावय,</para>
  <para style="q2" vid="PRO 14:6">पर समझदार मनखे ला आसानी से गियान मिलथे।<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />मुरूख मनखे ले दूरिहा रहव,</para>
  <para style="q2" vid="PRO 14:7">काबरकि तुमन ला ओकर ले गियान के बात नइं मिलय।<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />बुद्धिमान के बुद्धि ह ओला समझ देथे,</para>
  <para style="q2" vid="PRO 14:8">पर मुरूख के मुरूखता ह धोखा ए।<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />मुरूख मनखेमन पाप स्वीकार करई ला ठट्ठा के बात समझथें</para>
  <para style="q2" vid="PRO 14:9">पर समझदार मनखेमन के बीच म सही बिचार पाय जाथे।<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />मन ह अपन खुद के दुख ला जानथे,</para>
  <para style="q2" vid="PRO 14:10">अऊ कोनो आने ह येकर आनंद ला बांट नइं सकय।<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />दुस्ट के घर ह नास करे जाही,</para>
  <para style="q2" vid="PRO 14:11">पर धरमी के घर ह बढ़ही।<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />एक डहार हवय, जऊन ह मनखे ला सही जान पड़थे,</para>
  <para style="q2" vid="PRO 14:12">पर आखिर म येह मिरतू करा ले जाथे।<verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />अइसे हो सकथे कि हंसी के बेरा घलो मन उदास होवय,</para>
  <para style="q2" vid="PRO 14:13">अऊ आनंद मनई के अन्त दुख म होवय।<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />बिसवासहीन मनखे ह अपन काम के पूरा फल भोगही,</para>
  <para style="q2" vid="PRO 14:14">अऊ बने मनखे ह अपन बने काम के ईनाम पाही।<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />सीधवा मनखे ह कोनो भी बात के बिसवास करथे,</para>
  <para style="q2" vid="PRO 14:15">पर समझदार मनखे ह सोच-समझके चलथे।<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />बुद्धिमान मनखे ह यहोवा ले डरथे अऊ बुरई ले दूरिहा रहिथे,</para>
  <para style="q2" vid="PRO 14:16">पर मुरूख ह कोरोधी सुभाव के होथे अऊ तभो ले निडर रहिथे।<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />जऊन ह तुरते गुस्सा होथे, ओह मुरूखता के काम करथे,</para>
  <para style="q2" vid="PRO 14:17">अऊ जऊन ह खराप चाल चलथे, ओकर ले मनखेमन घिन करथें।<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />सीधा-साधा मनखे के भाग म मुरूखता होथे,</para>
  <para style="q2" vid="PRO 14:18">पर समझदार मनखे ला गियान के मुकुट पहिराय जाथे।<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />खराप मनखेमन, बने मनखे के आघू म,</para>
  <para style="q2" vid="PRO 14:19">अऊ दुस्ट मनखेमन धरमी के कपाट म झुकथें।<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />गरीब मनखे ला ओकर परोसीमन घलो छोंड़ देथें,</para>
  <para style="q2" vid="PRO 14:20">पर धनी मनखे के बहुंत संगवारी होथें।<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />जऊन ह अपन परोसी ला तुछ समझथे, ओह पाप करथे,</para>
  <para style="q2" vid="PRO 14:21">पर जऊन ह गरीब ऊपर दया करथे, ओह धइन ए।<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />का जऊन मन दुस्ट युक्ति करथें, ओमन अपन रसता ले नइं भटकंय?</para>
  <para style="q2" vid="PRO 14:22">पर जऊन मन भलई के युक्ति करथें, ओमन ला मया मिलथे अऊ ओमन बिसवासयोग्य होथें।<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />कठिन मेहनत करे ले लाभ होथे,</para>
  <para style="q2" vid="PRO 14:23">पर सिरिप बात करइया ह गरीब हो जाथे।<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />बुद्धिमान के धन ह ओकर मुकुट ए,</para>
  <para style="q2" vid="PRO 14:24">पर मुरूख के मुरूखता ह मुरूखता ही लानथे।<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />एक सच्चा गवाह ह जिनगी बचाथे,</para>
  <para style="q2" vid="PRO 14:25">पर एक लबरा गवाह ह धोखेबाज होथे।<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />जऊन ह यहोवा के भय मानथे, ओकर भरोसा ह मजबूत होथे,</para>
  <para style="q2" vid="PRO 14:26">अऊ ओमन के लइकामन बर येह एक आसरय होही।<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />यहोवा के डर ह जिनगी के झरना ए,</para>
  <para style="q2" vid="PRO 14:27">जऊन ह मनखे ला मिरतू के फांदा ले बचाथे।<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />मनखेमन के बहुंत संखिया ह राजा के महिमा अय,</para>
  <para style="q2" vid="PRO 14:28">पर अधीन म रहइया मनखेमन के बिगर एक राजकुमार ह नास हो जाथे।<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />जऊन ह धीरज धरथे, ओह समझदार अय,</para>
  <para style="q2" vid="PRO 14:29">पर जऊन ह तुरते गुस्सा होथे, ओह मुरूखता करथे।<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />मन म सांति ह देहें ला जिनगी देथे,</para>
  <para style="q2" vid="PRO 14:30">पर मन म जलन रखई ह हाड़ा ला सढ़ा देथे।<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />जऊन ह गरीब ला सताथे, ओह ओकर बनानेवाला<note caller="+" style="f"><char style="fr" closed="false">14:31 </char><char style="ft" closed="false">याने कि </char><char style="fqa" closed="false">परमेसर सिरिस्टीकर्ता</char></note> के अनादर करथे,</para>
  <para style="q2" vid="PRO 14:31">पर जऊन ह गरीब ऊपर दया करथे, ओह परमेसर के आदर करथे।<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />जब बिपत्ति आथे, त दुस्टमन नास हो जाथें,</para>
  <para style="q2" vid="PRO 14:32">पर मिरतू के बेरा घलो धरमी ला परमेसर म सरन मिलथे।<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />समझदार मनखे के मन म बुद्धि ह निवास करथे</para>
  <para style="q2" vid="PRO 14:33">अऊ त अऊ मुरूखमन के बीच म घलो ओह अपनआप ला परगट करथे।<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />धरमीपन ले मनखे के जाति<note caller="+" style="f"><char style="fr" closed="false">14:34 </char><char style="ft" closed="false">याने कि </char><char style="fqa" closed="false">जाति के सम्मान</char></note> के बढ़ती होथे,</para>
  <para style="q2" vid="PRO 14:34">पर पाप ले कोनो भी मनखे<note caller="+" style="f"><char style="fr" closed="false">14:34 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">समाज</char></note> के अपमान होथे।<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />राजा ह बुद्धिमान सेवक ले खुस होथे,</para>
  <para style="q2" vid="PRO 14:35">पर लज्जा के काम करइया सेवक ह राजा के कोरोध ला बढ़ाथे।<verse eid="PRO 14:35" /></para>
  <para style="b" />
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />कोमल जबाब ह गुस्सा ला दूर करथे,</para>
  <para style="q2" vid="PRO 15:1">पर करू बात ह गुस्सा ला बढ़ाथे।<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />बुद्धिमान के बात ह गियान ला बढ़ाथे,</para>
  <para style="q2" vid="PRO 15:2">पर मुरूख के मुहूं ले मुरूखता के ही बात निकलथे।<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />यहोवा ह जम्मो कोति देखथे,</para>
  <para style="q2" vid="PRO 15:3">दुस्ट अऊ बने दूनों मनखे ऊपर ओकर नजर लगे रहिथे।<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />सांति देवइया बात ह जिनगी के रूख ए,</para>
  <para style="q2" vid="PRO 15:4">पर उल्टा-सीधा बात ले आतमा ह दुखी होथे।<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />मुरूख ह दाई-ददा के अनुसासन के तिरस्कार करथे,</para>
  <para style="q2" vid="PRO 15:5">पर जऊन ह अनुसासन ला मानथे, ओह समझदारी देखाथे।<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />धरमी के घर म बड़े धन रहिथे,</para>
  <para style="q2" vid="PRO 15:6">पर दुस्ट के कमई ह बिनास लाथे।<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />बुद्धिमान के मुहूं ले गियान बगरथे,</para>
  <para style="q2" vid="PRO 15:7">पर मुरूखमन के मन ह सही नइं रहय।<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />यहोवा ह दुस्ट के बलिदान ले घिन करथे,</para>
  <para style="q2" vid="PRO 15:8">पर ईमानदार मनखे के पराथना ले परमेसर ह खुस होथे।<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />यहोवा दुस्ट के काम ले घिन करथे,</para>
  <para style="q2" vid="PRO 15:9">पर ओह ओमन ले मया करथे, जऊन मन धरमीपन के काम करथें।<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />जऊन ह सही रसता ला छोंड़ देथे, ओह कठोर अनुसासन के सामना करथे;</para>
  <para style="q2" vid="PRO 15:10">जऊन ह अनुसासन ले घिन करथे, ओह मरही।<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />मिरतू अऊ बिनास यहोवा के आघू म खुले रहिथें—</para>
  <para style="q2" vid="PRO 15:11">त मनखेमन के मन ला कोन पुछय!<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />ठट्ठा करइयामन डांट खाय ले खुस नइं होवंय,</para>
  <para style="q2" vid="PRO 15:12">एकरसेति ओमन बुद्धिमान मनखे ले अलग रहिथें।<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />मन ह खुस रहे ले चेहरा ह घलो खुस दिखथे,</para>
  <para style="q2" vid="PRO 15:13">पर दुखित मन ह आतमा ला निरास करथे।<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />समझदार मनखे ह गियान के खोज म रहिथे,</para>
  <para style="q2" vid="PRO 15:14">पर मुरूख मनखे ह मुरूखता के बात करथे।<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />दुखी मनखे के जम्मो दिनमन दुख ले भरे रहिथें,</para>
  <para style="q2" vid="PRO 15:15">पर जेकर मन ह खुस रहिथे, ओकर बर जम्मो दिन भोज खाय सहीं अय।<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />यहोवा के भय के संग थोरकन धन होवई ह</para>
  <para style="q2" vid="PRO 15:16">समस्या के संग बहुंत धन होवई ले बने अय।<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />मया के घर म थोरकन साग-भाजी के जेवन करई</para>
  <para style="q2" vid="PRO 15:17">बईरता वाले घर म मोटा-ताजा पसु के मांस खवई ले बने अय।<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />तुरते गुस्सा होवइया मनखे ह झगरा करथे,</para>
  <para style="q2" vid="PRO 15:18">पर धीरज वाले मनखे ह झगरा ला सांत करथे।<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />आलसी मनखे के रसता ह कांटा ले रूंधे रहिथे,</para>
  <para style="q2" vid="PRO 15:19">पर सीधा मनखे के रसता ह सुघर सड़क सहीं होथे।<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />बुद्धिमान बेटा ले ददा ह आनंदित होथे,</para>
  <para style="q2" vid="PRO 15:20">पर मुरूख मनखे ह अपन दाई ला तुछ समझथे।<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />मुरूख ला मुरूखता के बात ले आनंद होथे,</para>
  <para style="q2" vid="PRO 15:21">पर समझदार मनखे ह सीधा चाल चलथे।<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />बिगर सलाह के योजना ह सफल नइं होवय,</para>
  <para style="q2" vid="PRO 15:22">पर बहुंत सलाहकारमन के मदद ले ओमन सफल होथें।<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />सही उत्तर देय म मनखे ला आनंद मिलथे—</para>
  <para style="q2" vid="PRO 15:23">अऊ सही समय म कहे गे बात ह बने होथे।<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />बुद्धिमान बर जिनगी के रसता ह ऊपर कोति जाथे,</para>
  <para style="q2" vid="PRO 15:24">अऊ ओला खाल्हे मिरतू के राज म जाय ले बचाथे।<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />यहोवा ह घमंडी के घर ला गिरा देथे,</para>
  <para style="q2" vid="PRO 15:25">पर ओह बिधवा के सीमना ला सही-सलामत रखथे।<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />यहोवा ह दुस्ट के सोच-बिचार ले घिन करथे,</para>
  <para style="q2" vid="PRO 15:26">पर ओकर नजर म अनुग्रह के बचनमन सुखद होथें।<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />लालची मनखेमन अपन परिवार के नास करथें,</para>
  <para style="q2" vid="PRO 15:27">पर जऊन ह घूसखोरी ले घिन करथे, ओह जीयत रहिही।<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />धरमी ह अपन मन म सोच-बिचार करके जबाब देथे,</para>
  <para style="q2" vid="PRO 15:28">पर दुस्ट के मुहूं ले बुरई के बात ही निकलथे।<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />यहोवा ह दुस्ट मनखे ले दूरिहा रहिथे,</para>
  <para style="q2" vid="PRO 15:29">पर ओह धरमी के पराथना ला सुनथे।<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />संदेसिया के आंखी म चमक ह मन ला आनंदित करथे,</para>
  <para style="q2" vid="PRO 15:30">अऊ सुघर संदेस ले हाड़ामन मजबूत होथें।<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />जऊन ह जिनगी देवइया ताड़ना ऊपर धियान देथे,</para>
  <para style="q2" vid="PRO 15:31">ओह बुद्धिमानमन के बीच म निवास करथे।<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />जऊन मन अनुसासन ला नइं मानंय, ओमन अपनआप ला तुछ समझथें,</para>
  <para style="q2" vid="PRO 15:32">पर जऊन ह अनुसासन ऊपर धियान देथे, ओह समझ के बात ला पाथे।<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />बुद्धि के निरदेस ह यहोवा के भय मानना ए,</para>
  <para style="q2" vid="PRO 15:33">अऊ आदर के पहिली नमरता आथे।<verse eid="PRO 15:33" /></para>
  <para style="b" />
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />मनखे ह अपन मन के योजना के बस म रहिथे,</para>
  <para style="q2" vid="PRO 16:1">पर मुहूं के सही जबाब यहोवा करा ले आथे।<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />मनखे के जम्मो चालचलन ओकर नजर म सही जान पड़थे,</para>
  <para style="q2" vid="PRO 16:2">पर मन के उदेस्य ला यहोवा ह जांचथे।<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />अपन जम्मो काम ला यहोवा ला सऊंप दव,</para>
  <para style="q2" vid="PRO 16:3">अऊ ओह तुम्हर योजना ला स्थापित करही।<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />यहोवा ह जम्मो काम एक उदेस्य के संग करथे—</para>
  <para style="q2" vid="PRO 16:4">इहां तक कि दुस्ट ला बिपत्ति के दिन बर रखथे।<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />यहोवा ह मन के जम्मो घमंड के बात ले घिन करथे।</para>
  <para style="q2" vid="PRO 16:5">ये बात निस्चित ए: ओमन दंड पाय बिगर नइं बचंय।<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />मया अऊ बिसवासयोग्यता के दुवारा पाप के पछताप होथे;</para>
  <para style="q2" vid="PRO 16:6">यहोवा के भय माने के दुवारा बुरई ले बचे जाथे।<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />जब यहोवा ह काकरो काम ले खुस होथे,</para>
  <para style="q2" vid="PRO 16:7">त ओह ओकर बईरीमन के घलो ओकर ले मेल-मिलाप कराथे।<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />अनियाय करके बहुंत कमाय ले</para>
  <para style="q2" vid="PRO 16:8">धरमीपन के दुवारा थोरकन कमई ह बने अय।<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />मनखेमन अपन मन म अपन जिनगी जीये के योजना बनाथें,</para>
  <para style="q2" vid="PRO 16:9">पर यहोवा ह ओमन के जिनगी के कदम ला इस्थिर करथे।<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />राजा के मुहूं ले गियान के बात निकलथे,</para>
  <para style="q2" vid="PRO 16:10">अऊ ओह अनियाय के बात नइं करय।<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />ईमानदारी के नाप अऊ तराजू यहोवा के अय;</para>
  <para style="q2" vid="PRO 16:11">थैली के जम्मो वजन ओकर दुवारा बनाय गे हवंय।<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />राजामन गलत काम ले घिन करथें,</para>
  <para style="q2" vid="PRO 16:12">काबरकि सिंघासन ह धरमीपन के जरिये इस्थिर रहिथे।<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />राजामन ईमानदारी के बात म खुस होथें;</para>
  <para style="q2" vid="PRO 16:13">ओमन ओकर बात ऊपर धियान देथें, जऊन ह सही बात गोठियाथे।<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />राजा के गुस्सा ह मिरतू के दूत के सहीं अय,</para>
  <para style="q2" vid="PRO 16:14">पर बुद्धिमान मनखे ह ओला मना लेथे।<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />जब राजा के चेहरा ह खुस दिखथे, येकर मतलब जिनगी अय;</para>
  <para style="q2" vid="PRO 16:15">ओकर किरपा बसन्त समय के बारिस के बादर सहीं अय।<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />बुद्धि ला पाना सोन के पाय ले जादा बने अय,</para>
  <para style="q2" vid="PRO 16:16">अऊ समझ के बात ला जानना, चांदी के पाय ले जादा बने अय।<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />ईमानदार मनखे के रसता ह बुरई ले दूरिहा रहिथे;</para>
  <para style="q2" vid="PRO 16:17">जऊन मन अपन चालचलन ऊपर धियान देथें, ओमन अपन परान ला बचाथें।<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />बिनास के पहिली घमंड,</para>
  <para style="q2" vid="PRO 16:18">अऊ ठोकर खाय के पहिली जिद्दी सुभाव आथे।<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />घमंडी मनखेमन संग लूट के बांटा लेय के बदले</para>
  <para style="q2" vid="PRO 16:19">दुखी मनखेमन के संग नरम सुभाव से रहई बने अय।<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />जऊन ह निरदेस ऊपर धियान देथे, ओह बढ़थे,<note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">जऊन ह समझदारी के बात करथे, ओला बने चीज मिलथे</char></note></para>
  <para style="q2" vid="PRO 16:20">अऊ जऊन ह यहोवा ऊपर भरोसा रखथे, ओह आसीसित होथे।<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />जेकर हिरदय म बुद्धि हवय, ओला समझदार मनखे कहे जाथे,</para>
  <para style="q2" vid="PRO 16:21">अऊ मधुर बचन ह मनखेमन ले बात मनवाथे।<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />समझदार मनखे बर समझदारी ह जिनगी के झरना ए,</para>
  <para style="q2" vid="PRO 16:22">पर मुरूखता ह मुरूख मनखेमन बर दंड लाथे।<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />बुद्धिमान के मन ह ओकर बात ला समझदार बनाथे,</para>
  <para style="q2" vid="PRO 16:23">अऊ ओमन के बात ला मनखेमन मानथें।<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />गुरतूर बोली ह मधुमक्खी के छत्ता सहीं अय,</para>
  <para style="q2" vid="PRO 16:24">जऊन ह मन ला सांति अऊ देहें के हाड़ामन ला मजबूत करथे।<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />एक डहार हवय, जऊन ह मनखे ला सही जान पड़थे,</para>
  <para style="q2" vid="PRO 16:25">पर आखिर म येह मिरतू करा ले जाथे।<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />मेहनती मनखेमन के लालसा ओमन बर काम करथे;</para>
  <para style="q2" vid="PRO 16:26">ओमन के भूख ह ओमन ला उभारथे।<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />दुस्ट मनखे ह बुरई करे के बात सोचथे,</para>
  <para style="q2" vid="PRO 16:27">अऊ ओकर बात ह झुलसा देवई आगी सहीं होथे।<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />जिद्दी मनखे ह झगरा ला बढ़ाथे,</para>
  <para style="q2" vid="PRO 16:28">अऊ कानाफूसी करई या अफवाह फईलई ह नजदीकी संगीमन के बीच फूट डाल देथे।<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />हिंसक मनखे ह अपन परोसी ला बहकाथे</para>
  <para style="q2" vid="PRO 16:29">अऊ ओला बुरई के रसता म ले चलथे।<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />जऊन ह बार-बार आंखी के पलक झपकाथे, ओह सडयंत्र रचथे;</para>
  <para style="q2" vid="PRO 16:30">जऊन ह ओंठ दबाथे, ओह बुरई करथे।<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />पाके चुंदी ह सोभा देवइया मुकुट सहीं अय;</para>
  <para style="q2" vid="PRO 16:31">येह धरमीपन के रसता म चले के दुवारा मिलथे।<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />धीरजवाला मनखे ह एक योद्धा ले बने होथे,</para>
  <para style="q2" vid="PRO 16:32">अऊ मन ला बस म रखई ह सहर ला जीत लेवई ले उत्तम अय।<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />परची ह कोरा म डाले जाथे,</para>
  <para style="q2" vid="PRO 16:33">पर येकर हर एक निरनय ह यहोवा कोति ले होथे।<verse eid="PRO 16:33" /></para>
  <para style="b" />
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />सुख अऊ सांति के संग रोटी के एक कुटा खवई ह</para>
  <para style="q2" vid="PRO 17:1">ओ घर ले बने अय, जिहां जेवनार के संग झगरा होथे।<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />बुद्धिमान सेवक ह कलंक लानेवाला बेटा ऊपर राज करही</para>
  <para style="q2" vid="PRO 17:2">अऊ परिवार के एक झन सहीं पुरखामन के संपत्ति म बांटा पाही।<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />चांदी ला परखे बर कुठाली अऊ सोन ला परखे बर भट्ठी होथे,</para>
  <para style="q2" vid="PRO 17:3">पर मन ला यहोवा परखथे।<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />दुस्ट मनखे ह धोखा देवइया के बात ला सुनथे;</para>
  <para style="q2" vid="PRO 17:4">लबरा मनखे ह नुकसान करइया मनखे के बात ऊपर धियान देथे।<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />जऊन ह गरीब के हंसी उड़ाथे, ओह ओकर बनानेवाला के अपमान करथे;</para>
  <para style="q2" vid="PRO 17:5">जऊन ह काकरो बिपत्ति ऊपर हंसथे, ओह सजा पाही।<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />डोकरा-डोकरीमन के सोभा ओमन के नाती-पोता अंय,</para>
  <para style="q2" vid="PRO 17:6">अऊ लइकामन के घमंड ओमन के दाई-ददा अंय।<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />भक्तिहीन मुरूख के मुहूं ले उत्तम बात ह नइं फबे—</para>
  <para style="q2" vid="PRO 17:7">येकर ले घलो खराप बात ये अय कि सासन करइया ला लबरा बात नइं फबे।<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />घूस देवई ह देवइया के नजर म कोनो ला मोहित करे सहीं अय;</para>
  <para style="q2" vid="PRO 17:8">ओह सोचथे कि ओला हर जगह सफलता मिलही।<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />जऊन ह मया ला बढ़ाथे, ओह अपराध ला भुलाथे,</para>
  <para style="q2" vid="PRO 17:9">पर जऊन ह बात ला दोहराथे, ओह नजदीकी संगीमन के बीच फूट डाल देथे।<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />एक डांट ह समझदार मनखे ऊपर जतेक परभाव डालथे</para>
  <para style="q2" vid="PRO 17:10">एक मुरूख ला सौ कोड़ा मारना घलो ओतेक परभाव नइं डालय।<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />दुस्ट मनखेमन परमेसर के बिरोध म बिदरोह ला बढ़ाथें;</para>
  <para style="q2" vid="PRO 17:11">एकरसेति मिरतू के दूत ला ओमन के बिरूध पठोय जाही।<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />लइका ले बिछड़े कोनो माई भालू ले भेंट होवई ह जादा बने अय,</para>
  <para style="q2" vid="PRO 17:12">येकर बदले कि मुरूखता ले भरे कोनो मुरूख ले मिलई।<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />जऊन ह भलई के बदले बुरई करथे,</para>
  <para style="q2" vid="PRO 17:13">ओकर घर ले बुरई ह कभू नइं जावय।<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />झगरा सुरू करई ह पानी के बांध म छेद करे सहीं अय;</para>
  <para style="q2" vid="PRO 17:14">एकरसेति झगरा बढ़े के पहिली ओ बात ला छोंड़ दव।<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />दोसी ला छोंड़ देवई अऊ निरदोस ला दोसी ठहिरई—</para>
  <para style="q2" vid="PRO 17:15">ये दूनों बात ले यहोवा ह बहुंत घिन करथे।<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />बुद्धि बिसाय बर मुरूखमन के हांथ म काबर पईसा होवय,</para>
  <para style="q2" vid="PRO 17:16">जब ओमन येला नइं समझंय?<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />संगवारी ह हर समय मया करथे,</para>
  <para style="q2" vid="PRO 17:17">अऊ एक भाई ह बिपत्ति के बेरा म काम आथे।<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />जेकर करा बुद्धि नइं ए, ओह सामान ला गिरवी रख देथे</para>
  <para style="q2" vid="PRO 17:18">अऊ परोसी के जमानत लेथे।<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />जऊन ह झगरा ले मया करथे, ओह पाप ले मया करथे;</para>
  <para style="q2" vid="PRO 17:19">जऊन ह ऊंचहा कपाट बनाथे, ओह बिनास ला नेवता देथे।<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />जेकर मन ह टेढ़ा हे, ओह उन्नति नइं करय;</para>
  <para style="q2" vid="PRO 17:20">अऊ गलत बात करइया ह समस्या म पड़थे।<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />मुरूख लइका के होवई ह दुख के कारन होथे;</para>
  <para style="q2" vid="PRO 17:21">भक्तिहीन मुरूख के दाई या ददा ला आनंद नइं मिलय।<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />खुसी ले भरे मन ह बढ़िया दवाई ए,</para>
  <para style="q2" vid="PRO 17:22">पर टूटे मन ह हाड़ा ला सूखा देथे।<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />दुस्ट मनखे ह नियाय ला बिगाड़े बर</para>
  <para style="q2" vid="PRO 17:23">गुपत म घूस लेथे।<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />समझदार मनखे ह बुद्धि ला धियान म रखथे,</para>
  <para style="q2" vid="PRO 17:24">पर मुरूख मनखे के आंखी ह धरती के छोर तक भटकत रहिथे।<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />मुरूख बेटा ले ओकर ददा ह दुखी होथे</para>
  <para style="q2" vid="PRO 17:25">अऊ ओकर जनम देवइया दाई ला तकलीफ होथे।<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />निरदोस ऊपर जुरबाना लगई बने नो हय,</para>
  <para style="q2" vid="PRO 17:26">अऊ खचित ईमानदार करमचारी ला कोर्रा म पीटवाना सही नो हय।<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />जेकर करा गियान होथे, ओह संभलके गोठियाथे,</para>
  <para style="q2" vid="PRO 17:27">अऊ जेकर करा समझ होथे, ओह सांत सुभाव के होथे।<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />अऊ त अऊ यदि मुरूखमन सांत रहंय, त ओमन बुद्धिमान समझे जाथें,</para>
  <para style="q2" vid="PRO 17:28">अऊ यदि ओमन चुप रहंय, त समझदार समझे जाथें।<verse eid="PRO 17:28" /></para>
  <para style="b" />
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />जऊन ह अपनआप ला आने मन ले अलग कर लेथे, ओह अपन खुद के ईछा पूरा करे बर अइसने करथे</para>
  <para style="q2" vid="PRO 18:1">अऊ जम्मो सही नियाय के बिरूध झगरा सुरू करथे।<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />मुरूख के मन ह समझ के बात म नइं लगय</para>
  <para style="q2" vid="PRO 18:2">पर ओला अपन खुद के बात कहे म खुसी मिलथे।<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />जब दुस्टता आथे, त अपमान घलो आथे,</para>
  <para style="q2" vid="PRO 18:3">अऊ लज्जा के संग कलंक आथे।<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />मुहूं के बचन ह गहिरा पानी सहीं अय,</para>
  <para style="q2" vid="PRO 18:4">पर बुद्धि के झरना ह तेज बहत नरवा के सहीं अय।<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />दुस्ट ला बचई</para>
  <para style="q2" vid="PRO 18:5">अऊ निरदोस के नियाय बिगड़ई बने नो हय।<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />मुरूखमन के गोठ ह ओमन ला झगरा म डालथे,</para>
  <para style="q2" vid="PRO 18:6">अऊ ओमन के बात ह ओमन ला मार खाय के लईक बनाथे।<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />मुरूखमन के बिनास ओमन के बात ले होथे,</para>
  <para style="q2" vid="PRO 18:7">अऊ ओमन के गोठ ह ओमन के खुद के जिनगी के फांदा बन जाथे।<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />बकवास करई ह सुवादवाले जेवन सहीं होथे;</para>
  <para style="q2" vid="PRO 18:8">येमन मनखे के भीतर तक चले जाथें।<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />जऊन ह अपन काम म ढीला होथे,</para>
  <para style="q2" vid="PRO 18:9">ओह नास करइया के भाई होथे।<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />यहोवा के नांव ह गढ़वाला महल ए;</para>
  <para style="q2" vid="PRO 18:10">धरमी जन उहां भागके जाथें अऊ सुरकछित रहिथें।<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />धनवानमन के धन ह ओमन के गढ़वाला सहर होथे;</para>
  <para style="q2" vid="PRO 18:11">ओमन के कल्पना म येह नाप के बाहिर बहुंत ऊंच दीवार ए।<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />नास होय के पहिली मनखे के मन ह घमंडी हो जाथे,</para>
  <para style="q2" vid="PRO 18:12">पर आदर पाय के पहिली ओमा नमरता आथे।<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />जऊन ह बात ला सुने के पहिली जबाब देथे,</para>
  <para style="q2" vid="PRO 18:13">ओह मुरूख होथे अऊ ओकर बेजत्ती होथे।<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />मनखे के आतमा ह बेमारी ला सह सकथे,</para>
  <para style="q2" vid="PRO 18:14">पर टूटे मन ला कोन सह सकथे?<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />समझदार मनखे के मन ह गियान पाथे,</para>
  <para style="q2" vid="PRO 18:15">काबरकि बुद्धिमान ह गियान के बात ला खोज लेथे।<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />उपहार ह मनखे बर रसता खोलथे</para>
  <para style="q2" vid="PRO 18:16">अऊ देवइया ला बड़े मनखेमन करा पहुंचाथे।<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />अदालत के मामला म जऊन ह पहिली बोलथे, ओह सही जान पड़थे,</para>
  <para style="q2" vid="PRO 18:17">जब तक कि दूसर ह आके ओकर बात ला जांच नइं लेथे।<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />परची डारे ले झगरा के निपटारा होथे</para>
  <para style="q2" vid="PRO 18:18">अऊ बलवाले बिरोधीमन ला अलग रखथे।<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />गलती करे भाई ला मनाई ह एक गढ़वाले सहर ला जीत लेवई ले कठिन ए;</para>
  <para style="q2" vid="PRO 18:19">झगरा ह महल के छड़ लगे दुवार के सहीं अय।<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />मनखे के पेट ह ओकर मुहूं के बात ले भरथे;</para>
  <para style="q2" vid="PRO 18:20">अपन मुहूं के बने बात के दुवारा ओकर मन ला संतोस मिलथे।<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />मनखे के गोठ म जिनगी अऊ मिरतू के ताकत होथे,</para>
  <para style="q2" vid="PRO 18:21">अऊ जऊन मन येकर ले मया करथें, ओमन येकर फर खाहीं।<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />जऊन ह माईलोगन ले बिहाव करथे, ओह बने चीज पाथे</para>
  <para style="q2" vid="PRO 18:22">अऊ यहोवा के अनुग्रह ओकर ऊपर होथे।<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />गरीब ह दया पाय बर बिनती करथे,</para>
  <para style="q2" vid="PRO 18:23">पर धनी मनखे कठोरता से जबाब देथे।<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />जेकर संगीमन भरोसा के लईक नो हंय, ओह जल्दी नास हो जाथे,</para>
  <para style="q2" vid="PRO 18:24">पर अइसे घलो संगी होथे, जऊन ह भाई ले घलो जादा नजदीक होथे।<verse eid="PRO 18:24" /></para>
  <para style="b" />
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />जऊन गरीब के चालचलन ह सही रहिथे</para>
  <para style="q2" vid="PRO 19:1">ओह ओ मुरूख ले बने अय, जऊन ह उल्टा-सीधा बात कहिथे।<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />बिगर गियान के ईछा करई ह बने नो हय—</para>
  <para style="q2" vid="PRO 19:2">जऊन ह उतावली करथे, ओह रसता ले भटक जाथे।<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />मनखे ला ओकर मुरूखता ह बिनास कोति ले जाथे,</para>
  <para style="q2" vid="PRO 19:3">तभो ले ओकर मन ह यहोवा ऊपर गुस्सा करथे।<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />धनी मनखे के बहुंत संगी बन जाथें,</para>
  <para style="q2" vid="PRO 19:4">पर गरीब मनखे के खास संगी घलो ओला छोंड़ देथे।<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />लबरा गवाह ह दंड पाही,</para>
  <para style="q2" vid="PRO 19:5">अऊ जऊन ह लबारी ऊपर लबारी मारथे, ओह बच नइं सकय।<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />नाना किसम के भोजन ले सासन करइया ह खुस होथे,</para>
  <para style="q2" vid="PRO 19:6">अऊ जऊन ह उपहार देथे, ओकर हर मनखे ह संगी बन जाथे।<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />गरीब मनखे ला ओकर जम्मो रिस्तेदार नापसंद करथें,</para>
  <para style="q2" vid="PRO 19:7">अऊ ओकर संगीमन घलो ओला छोंड़ देथें।</para>
  <para style="q1" vid="PRO 19:7">हालाकि गरीब ह बिनती करत ओमन के पीछा करथे,</para>
  <para style="q2" vid="PRO 19:7">पर ओमन कहीं नइं मिलंय।<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />जऊन ह बुद्धि पाथे, ओह जिनगी ले मया करथे;</para>
  <para style="q2" vid="PRO 19:8">जऊन ह समझ के बात करथे, ओह जल्दी बढ़थे।<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />लबरा गवाह ह दंड पाही,</para>
  <para style="q2" vid="PRO 19:9">अऊ जऊन ह लबारी ऊपर लबारी मारथे, ओह नास होही।<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />मुरूख मनखे ला सुबिधा के जिनगी जीना नइं फबे—</para>
  <para style="q2" vid="PRO 19:10">वइसे ही एक गुलाम के हाकिममन ऊपर राज करई ह अऊ भी नइं फबे।<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />मनखे के बुद्धि ले धीरज आथे;</para>
  <para style="q2" vid="PRO 19:11">अऊ दूसर के गलती ला धियान नइं देवई ओकर सोभा होथे।<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />राजा के गुस्सा ह सिंह के गरजन सहीं होथे,</para>
  <para style="q2" vid="PRO 19:12">पर ओकर किरपा ह कांदी ऊपर ओस के सहीं होथे।<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />मुरूख लइका ह अपन ददा के बिनास के कारन होथे,</para>
  <para style="q2" vid="PRO 19:13">अऊ झगरा करइया घरवाली ह</para>
  <para style="q2" vid="PRO 19:13">लगातार छानी ले चूहत पानी सहीं अय।<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />घर अऊ संपत्ति दाई-ददा ले उत्तराधिकार म मिलथे,</para>
  <para style="q2" vid="PRO 19:14">पर एक बुद्धिमान घरवाली यहोवा करा ले मिलथे।<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />आलसीपन ले भारी नींद आथे,</para>
  <para style="q2" vid="PRO 19:15">अऊ साधनहीन मनखे ह भूखा रहिथे।<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />जऊन ह हुकूम ला मानथे, ओह अपन जिनगी ला बचाथे,</para>
  <para style="q2" vid="PRO 19:16">पर जऊन ह अपन चालचलन के अपमान करथे, ओह मरही।<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />जऊन ह गरीब ऊपर दया करथे, ओह यहोवा ला उधार देथे,</para>
  <para style="q2" vid="PRO 19:17">अऊ यहोवा ह ओला ओकर काम के ईनाम दीही।<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />अपन लइकामन के ताड़ना कर, काबरकि येमा आसा हवय;</para>
  <para style="q2" vid="PRO 19:18">अपन मन म ओमन ला मार डारे के निरनय झन कर।<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />जऊन ह बहुंत गुस्सावाला ए, ओह जरूर दंड पावय;</para>
  <para style="q2" vid="PRO 19:19">काबरकि यदि तेंह ओला बचाथस, त ओला फेर बचाना पड़ही।<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />सलाह ला मान अऊ ताड़ना ला गरहन कर,</para>
  <para style="q2" vid="PRO 19:20">अऊ आखिरी म तोर गनती बुद्धिमानमन के संग होही।<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />मनखे ह अपन मन म बहुंत योजना बनाथे,</para>
  <para style="q2" vid="PRO 19:21">पर येह सिरिप यहोवा के ही उदेस्य अय, जऊन ह पूरा होथे।<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />मनखे ह जेकर ईछा करथे, ओह अटूट मया ए;</para>
  <para style="q2" vid="PRO 19:22">गरीब मनखे ह एक लबरा मनखे ले जादा बने अय।<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />यहोवा के भय मनई ह जिनगी के तरफ ले जाथे;</para>
  <para style="q2" vid="PRO 19:23">तब ओकर भय माननेवाला सुखी रहिथे अऊ ओकर ऊपर समस्या नइं आवय।<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />आलसी मनखे ह अपन हांथ जेवन के थाली म तो डालथे;</para>
  <para style="q2" vid="PRO 19:24">पर ओह हांथ के कऊंरा ला मुहूं तक नइं लानय।<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />ठट्ठा करइया ला कोर्रा म मार, अऊ सीधा मनखे ह समझदारी के बात सीखही;</para>
  <para style="q2" vid="PRO 19:25">समझदार मनखे ला डांट, अऊ ओह गियान पाही।<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />जऊन ह अपन ददा ला लूटथे अऊ अपन दाई ला निकाल देथे,</para>
  <para style="q2" vid="PRO 19:26">ओह ओ लइका अय, जऊन ह लज्जा अऊ कलंक लानथे।<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />हे मोर बेटा, यदि तें सिकछा के बात सुने बर बंद कर देबे,</para>
  <para style="q2" vid="PRO 19:27">त तेंह गियान के बात ले भटक जाबे।<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />भ्रस्ट गवाह ह नियाय ला ठट्ठा म उड़ाथे,</para>
  <para style="q2" vid="PRO 19:28">अऊ दुस्ट के मुहूं ह बुरई के समरथन करथे।<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />ठट्ठा करइयामन ला दंड मिलथे,</para>
  <para style="q2" vid="PRO 19:29">अऊ मुरूखमन के पीठ म मार पड़थे।<verse eid="PRO 19:29" /></para>
  <para style="b" />
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />अंगूर के मंद ह ठट्ठा करवाथे अऊ आने मंद ह झगरा करवाथे;</para>
  <para style="q2" vid="PRO 20:1">जऊन ह येमन ला पीके बहकथे, ओह बुद्धिमान नो हय।<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />एक राजा के गुस्सा ह सेर के गरजन सहीं भय पईदा करथे;</para>
  <para style="q2" vid="PRO 20:2">जऊन मन राजा ऊपर गुस्सा करथें, ओमन अपन परान गंवाथें।<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />जऊन ह झगरा करे ले बचथे, येह ओकर बर आदर के बात अय,</para>
  <para style="q2" vid="PRO 20:3">पर जम्मो मुरूख मनखेमन तुरते झगरा करथें।<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />आलसी मनखेमन समय म खेत नइं जोतंय;</para>
  <para style="q2" vid="PRO 20:4">एकरसेति कटनी के बेरा म ओमन खोजथें, पर ओमन ला कुछू नइं मिलय।<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />मनखे के मन के उदेस्य ह गहिरा पानी के सहीं अय,</para>
  <para style="q2" vid="PRO 20:5">पर समझदार मनखे ओला बाहिर निकाल लेथे।<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />बहुंते जन सही मया करे के दावा करथें,</para>
  <para style="q2" vid="PRO 20:6">पर एक बिसवासयोग्य मनखे कोन पा सकथे?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />धरमी जन निरदोस जिनगी जीथें;</para>
  <para style="q2" vid="PRO 20:7">ओमन के पाछू ओमन के लइकामन आसीसित होथें।<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />जब राजा ह नियाय करे बर अपन सिंघासन म बईठथे,</para>
  <para style="q2" vid="PRO 20:8">त ओह अपन नजर ले पछरके जम्मो बुरई ला तुरते जान लेथे।<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />कोन ह कह सकथे, “मेंह अपन हिरदय ला सुध करे हंव;</para>
  <para style="q2" vid="PRO 20:9">मेंह साफ अऊ बिगर पाप के हंव?”<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />गलत वजन अऊ गलत नाप—</para>
  <para style="q2" vid="PRO 20:10">ये दूनों ले यहोवा घिन करथे।<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />छोटे लइकामन घलो अपन काम के दुवारा जाने जाथें,</para>
  <para style="q2" vid="PRO 20:11">कि ओमन के चालचलन ह सुध अऊ ठीक हवय कि नइं?<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />सुने बर कान अऊ देखे बर आंखी—</para>
  <para style="q2" vid="PRO 20:12">ये दूनों ला यहोवा ह बनाय हवय।<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />नींद ले मया झन कर, नइं तो गरीब हो जाबे;</para>
  <para style="q2" vid="PRO 20:13">जागत रह, त तोर करा खाय बर बहुंत जेवन होही।<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />बिसात बेरा बिसइया ह कहिथे, “येह बने नो हय, येह बने नो हय!”</para>
  <para style="q2" vid="PRO 20:14">पर जब ओह चले जाथे, तब ओह ओ सामान के बड़ई करे लगथे।<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />सोन अऊ बहुंत मंहगी रत्न तो हवंय</para>
  <para style="q2" vid="PRO 20:15">पर गियान के बात कहइया मुहूं ह दुरलभ गहना होथे।<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />ओ मनखे के कपड़ा ला लेय ले, जऊन ह कोनो अजनबी के जिम्मेदारी लेथे;</para>
  <para style="q2" vid="PRO 20:16">यदि ये काम कोनो बाहिरी मनखे बर करे जाथे, त ओ कपड़ा ला गिरवी के रूप म रख।<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />बेईमानी करके कमाय जेवन ह मनखे ला मीठ लगथे,</para>
  <para style="q2" vid="PRO 20:17">पर आखिरी म, ओकर मुहूं ह गोटी ले भर जाथे।<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />सलाह लेय के दुवारा योजना ह सफल होथे;</para>
  <para style="q2" vid="PRO 20:18">एकरसेति यदि तें लड़ई म जाथस, त सलाह लेय कर।<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />बकवास करे ले भरोसा ह टूटथे;</para>
  <para style="q2" vid="PRO 20:19">एकरसेति ओकर ले बचके रह, जऊन ह बहुंत जादा गोठियाथे।<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />यदि कोनो अपन दाई या ददा ला सराप देथे,</para>
  <para style="q2" vid="PRO 20:20">त घोर अंधियार म ओकर दीया ह बुता जाही।<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />जऊन ह अपन उत्तराधिकार ला जल्दबाजी म ले लेथे</para>
  <para style="q2" vid="PRO 20:21">ओह आखिरी म आसीस नइं पावय।<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />अइसे झन कह, “मेंह तोर ये बुरई के बदला लूहूं!”</para>
  <para style="q2" vid="PRO 20:22">यहोवा के बाट जोह, अऊ ओह तोर बर बदला लीही।<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />यहोवा ह गलत वजन ले घिन करथे,</para>
  <para style="q2" vid="PRO 20:23">अऊ बेईमानी के नाप ले ओह खुस नइं होवय।<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />मनखे के पांव ला यहोवा ह रसता देखाथे।</para>
  <para style="q2" vid="PRO 20:24">तब कोनो मनखे अपन रसता ला कइसे समझ सकथे?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />जऊन ह बिगर सोचे-बिचारे कोनो चीज ला समरपित करथे</para>
  <para style="q2" vid="PRO 20:25">अऊ पाछू अपन मन्नत के बारे म बिचार करथे, ओह फांदा म फंसथे।<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />बुद्धिमान राजा ह दुस्टमन ला पछरके निकालथे,</para>
  <para style="q2" vid="PRO 20:26">अऊ ओमन ऊपर दंवरी के चक्का चलाथे।<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />मनखे के आतमा ह<note caller="+" style="f"><char style="fr" closed="false">20:27 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मनखे के बचन ह</char></note> यहोवा के दीया ए</para>
  <para style="q2" vid="PRO 20:27">जऊन ह मनखे के अंतस के बात ला देखाथे।<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />मया अऊ सच्चई राजा ला बनाय रखथे;</para>
  <para style="q2" vid="PRO 20:28">मया के जरिये ओकर सिंघासन ह सुरकछित रहिथे।<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />जवानमन के गौरव ओमन के ताकत ए,</para>
  <para style="q2" vid="PRO 20:29">पर सियानमन के सोभा ओमन के पाके चुंदी ए।<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />मुक्का अऊ चोट खाय ले बुरई ह दूर होथे,</para>
  <para style="q2" vid="PRO 20:30">अऊ मार खाय ले अंतस ह सुध होथे।<verse eid="PRO 20:30" /></para>
  <para style="b" />
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />यहोवा के हांथ म राजा के मन ह पानी के नरवा सहीं अय</para>
  <para style="q2" vid="PRO 21:1">जऊन ला ओह ओ जम्मो मनखे कोति मोड़ देथे, जेमन ले ओह खुस होथे।<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />मनखे ह सोचथे कि ओकर खुद के चालचलन ह सही अय,</para>
  <para style="q2" vid="PRO 21:2">पर यहोवा ह मनखे के मन ला जांचथे।<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />सही अऊ नियाय के काम करई ह</para>
  <para style="q2" vid="PRO 21:3">यहोवा ला बलिदान ले जादा बने लगथे।<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />घमंड ले चढ़े आंखी अऊ घमंडीमन—</para>
  <para style="q2" vid="PRO 21:4">अऊ दुस्ट मनखे के बिगर जोते खेत—ये तीनों ले पाप होथे।<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />मेहनती मनखे के योजना ले लाभ होथे</para>
  <para style="q2" vid="PRO 21:5">पर जल्दबाजी करइया ह गरीब हो जाथे।<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />लबारी मारके कमाय गे धन ह</para>
  <para style="q2" vid="PRO 21:6">तुरते उड़ जानेवाला भाप अऊ मिरतू के फांदा सहीं अय।<verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />दुस्टमन के हिंसक काम ह ओमन ला नास कर दीही,</para>
  <para style="q2" vid="PRO 21:7">काबरकि ओमन सही काम करे बर नइं चाहंय।<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />दोसी मनखे के काम ह टेढ़ा होथे,</para>
  <para style="q2" vid="PRO 21:8">पर निरदोस मनखे के आचरन ह सीधा होथे।<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />झगड़ालू घरवाली के संग घर म रहई के बदले</para>
  <para style="q2" vid="PRO 21:9">छानी के कोनटा म रहई ह बने अय।<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />दुस्ट मनखेमन बुरई करे के लालसा करथें;</para>
  <para style="q2" vid="PRO 21:10">ओमन अपन परोसी ऊपर कोनो दया नइं करंय।<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />जब ठट्ठा करइया ला दंड मिलथे, त सधारन मनखे ह बुद्धि पाथे;</para>
  <para style="q2" vid="PRO 21:11">बुद्धिमान मनखे के बात ला सुनके ओमन गियान पाथें।<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />धरमी जन ह दुस्ट मनखे के घर ऊपर नजर रखथे</para>
  <para style="q2" vid="PRO 21:12">अऊ ओला बिनास म पहुंचा देथे।<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />जऊन ह गरीब के गोहार ला नइं सुनय,</para>
  <para style="q2" vid="PRO 21:13">ओह खुद घलो गोहार पारही, पर ओकर कोनो जबाब नइं मिलही।<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />गुपत म दिये गे भेंट ले गुस्सा ह सांत होथे,</para>
  <para style="q2" vid="PRO 21:14">अऊ छुपाके दिये गे घूस ह भयंकर गुस्सा ला घलो सांत करथे।<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />जब नियाय मिलथे, त येकर से धरमी ह आनंदित होथे</para>
  <para style="q2" vid="PRO 21:15">पर दुस्टमन ऊपर आतंक छा जाथे।<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />जऊन ह समझदारी के रसता ले भटक जाथे,</para>
  <para style="q2" vid="PRO 21:16">ओह मरे मनखेमन के संग ठिकाना पाथे।<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />जऊन ह मऊज-मस्ती ले मया करथे, ओह गरीब हो जाही;</para>
  <para style="q2" vid="PRO 21:17">जऊन ह अंगूर के मंद अऊ जैतून तेल ले मया करथे, ओह कभू धनी नइं होवय।<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />दुस्ट मनखे ह धरमी जन बर छुड़ौती ठहिरथे,</para>
  <para style="q2" vid="PRO 21:18">अऊ बिसवासघाती ह ईमानदार मनखे बर छुड़ौती होथे।<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />झगरा करइया अऊ चिढ़ देवइया घरवाली के संग रहे के बदले</para>
  <para style="q2" vid="PRO 21:19">सुनसान जगह म रहई ह बने ए।<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />बुद्धिमान मनखे ह मनभावन जेवन अऊ जैतून तेल जमा करथे,</para>
  <para style="q2" vid="PRO 21:20">पर मुरूख मनखे ह ओमन ला गटागट खा जाथे।<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />जऊन ह धरमीपन अऊ मया करे म लगे रहिथे,</para>
  <para style="q2" vid="PRO 21:21">ओह जिनगी, धन<note caller="+" style="f"><char style="fr" closed="false">21:21 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">धरमीपन</char></note> अऊ आदर पाथे।<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />बुद्धिमान मनखे ह सूरबीरमन के सहर म चढ़ई करके</para>
  <para style="q2" vid="PRO 21:22">ओमन के गढ़ ला गिरा सकथे, जेमा ओमन भरोसा करथें।<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />जऊन मन अपन मुहूं अऊ जीभ ला बस म रखथें,</para>
  <para style="q2" vid="PRO 21:23">ओमन अपनआप ला बिपत्ति ले बचाथें।<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />घमंडी अऊ जिद्दी मनखे ला “ठट्ठा करइया” कहिथें—</para>
  <para style="q2" vid="PRO 21:24">ओकर बरताव ह घमंड अऊ गुस्सा ले भरे रहिथे।<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />आलसी मनखे के ईछा ह ओला मार डालथे,</para>
  <para style="q2" vid="PRO 21:25">काबरकि ओकर हांथमन काम करे बर नइं चाहंय।<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />दिन भर ओह ईछा करते रहिथे,</para>
  <para style="q2" vid="PRO 21:26">पर धरमी मनखे ह अपन बर बिगर रखे दे देथे।<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />दुस्ट के बलिदान ह घिन के चीज होथे—</para>
  <para style="q2" vid="PRO 21:27">त ओह अऊ कतेक घिन के लईक होही, जब ओह बुरई करे के ईछा से लाथे!<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />लबरा गवाह ह नास होही,</para>
  <para style="q2" vid="PRO 21:28">पर धियान से सुनइया ह सही गवाही दीही।<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />दुस्ट मनखे के मुहूं ह कठोर होथे,</para>
  <para style="q2" vid="PRO 21:29">पर सीधवा मनखे ह अपन चालचलन ऊपर बिचार करथे।<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />अइसे कोनो बुद्धि, समझ या योजना नइं ए,</para>
  <para style="q2" vid="PRO 21:30">जऊन ह यहोवा के बिरोध म सफल होवय।<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />लड़ई के दिन बर घोड़ा ला तो तियार करे जाथे,</para>
  <para style="q2" vid="PRO 21:31">पर जीत यहोवा के दुवारा ही मिलथे।<verse eid="PRO 21:31" /></para>
  <para style="b" />
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />बहुंत संपत्ति होवई ले बने नांव होवई ह उत्तम ए;</para>
  <para style="q2" vid="PRO 22:1">अऊ सोन-चांदी ले आदरमान पाना जादा बने ए।<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />धनी अऊ गरीब म समान्य बात ये अय:</para>
  <para style="q2" vid="PRO 22:2">यहोवा ह दूनों ला बनाय हवय।<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />समझदार मनखे खतरा ला देखके सरन ले लेथे,</para>
  <para style="q2" vid="PRO 22:3">पर सीधा-साधा मनखे ह चलते रहिथे अऊ हानि उठाथे।<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />नमरता ह यहोवा के भय ए;</para>
  <para style="q2" vid="PRO 22:4">येकर मजदूरी धन, आदर अऊ जिनगी होथे।<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />दुस्टमन के रसता म फांदा अऊ संकट होथे,</para>
  <para style="q2" vid="PRO 22:5">पर जऊन मन अपन परान के रकछा करथें, ओमन येमन ले दूरिहा रहिथें।<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />लइकामन ला ओ बात के सिकछा दव, जेमा ओमन ला चलना चाही,</para>
  <para style="q2" vid="PRO 22:6">त बुढ़त काल म घलो ओ रसता ले नइं हटहीं।<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />धनी मनखे ह गरीब मनखे ऊपर राज करथे,</para>
  <para style="q2" vid="PRO 22:7">अऊ उधार लेवइया ह उधार देवइया के गुलाम होथे।<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />जऊन ह अनियाय करथे, ओकर ऊपर बिपत्ति आथे,</para>
  <para style="q2" vid="PRO 22:8">अऊ जऊन लउठी के उपयोग ओह कोरोध म करथे, ओह टोरे जाही।<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />उदार मनखे ह आसीस पाही,</para>
  <para style="q2" vid="PRO 22:9">काबरकि ओह गरीबमन ला अपन जेवन म ले देथे।<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />ठट्ठा करइया ला निकाल दे, त झगरा ह खतम हो जाही;</para>
  <para style="q2" vid="PRO 22:10">बाद-बिबाद अऊ बेजत्ती होवई घलो खतम हो जाही।<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />जऊन ह मन के सुधता ले मया रखथे अऊ जऊन ह अनुग्रह ले भरे बचन कहिथे</para>
  <para style="q2" vid="PRO 22:11">ओकर संगी राजा होथे।<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />यहोवा ह गियानी ऊपर नजर रखके ओकर रकछा करथे,</para>
  <para style="q2" vid="PRO 22:12">पर ओह बिसवासघाती के गोठ ला बिफल कर देथे।<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />आलसी मनखे ह कहिथे, “उहां बाहिर म एक सेर हवय!</para>
  <para style="q2" vid="PRO 22:13">मेंह चऊक म मारे जाहूं!”<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />छिनारी माईलोगन के मुहूं ह एक गहिरा खंचवा सहीं अय;</para>
  <para style="q2" vid="PRO 22:14">ओ मनखे जेकर ले यहोवा ह गुस्सा करथे, ओही ह ओमा गिरथे।<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />मुरूखता ह लइका के मन म गांठ सहीं बंधे रहिथे,</para>
  <para style="q2" vid="PRO 22:15">पर अनुसासन के छड़ी ह येला दूरिहा कर देथे।<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />जऊन ह अपन धन-संपत्ति बढ़ाय बर गरीब ऊपर अतियाचार करथे</para>
  <para style="q2" vid="PRO 22:16">अऊ जऊन ह धनी मनखे ला ईनाम देथे—ओ दूनों गरीब हो जाथें।<verse eid="PRO 22:16" /></para>
  <para style="ms1">बुद्धिमान मनखे के तीस कहावत</para>
  <para style="s2">कहावत 1</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />बुद्धिमान मनखे के बात ऊपर धियान दे अऊ ओमा कान लगा;</para>
  <para style="q2" vid="PRO 22:17">जऊन बात मेंह सिखावत हंव ओला अपन मन म रख,<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />काबरकि जब तेंह येमन ला अपन मन म रखथस</para>
  <para style="q2" vid="PRO 22:18">अऊ ये जम्मो तोर मुहूं ले निकलथें, त येकर ले खुसी होथे।<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />मेंह आज ये बातमन एकरसेति तोला सिखावत हंव,</para>
  <para style="q2" vid="PRO 22:19">ताकि तोर भरोसा यहोवा ऊपर होवय।<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />का मेंह तोर बर तीस कहावतमन ला नइं लिखे हंव,</para>
  <para style="q2" vid="PRO 22:20">सलाह अऊ गियान के कहावत,<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />ये सिखावत कि तें ईमानदार बन अऊ सच बात गोठिया,</para>
  <para style="q2" vid="PRO 22:21">ताकि तेंह वापिस आके ओमन ला सही बात बता सकस,</para>
  <para style="q2" vid="PRO 22:21">जेमन के तेंह सेवा करथस?<verse eid="PRO 22:21" /></para>
  <para style="s2">कहावत 2</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />गरीब ऊपर ये कारन से अंधेर झन करव कि ओह गरीब अय</para>
  <para style="q2" vid="PRO 22:22">अऊ जरूरतमंद ला कचहरी म झन घसीटव,<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />काबरकि यहोवा ह ओमन के मुकदमा लड़ही</para>
  <para style="q2" vid="PRO 22:23">अऊ जिनगी के बलदा जिनगी लीही।<verse eid="PRO 22:23" /></para>
  <para style="s2">कहावत 3</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />गुस्सैल मनखे ला संगी झन बनाबे,</para>
  <para style="q2" vid="PRO 22:24">अऊ जल्दी गुस्सा होवइया के संग संगति झन करबे,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />नइं तो तेंह ओमन के चालचलन ला सीख जाबे</para>
  <para style="q2" vid="PRO 22:25">अऊ अपनआप ला फांदा म फंसा लेबे।<verse eid="PRO 22:25" /></para>
  <para style="s2">कहावत 4</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />अइसने मनखे झन बनबे, जऊन मन गिरवी रखे बर हांथ मिलाथें</para>
  <para style="q2" vid="PRO 22:26">या करजा पटाय बर जमानत लेथें;<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />यदि पटाय बर तोर करा कुछू नइं होही,</para>
  <para style="q2" vid="PRO 22:27">त तोर खाल्हे ले तोर बिस्तर ला छीन लिये जाही।<verse eid="PRO 22:27" /></para>
  <para style="s2">कहावत 5</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />जऊन सीमना ला तोर पुरखामन बांधे हवंय</para>
  <para style="q2" vid="PRO 22:28">ओ पुराना सीमना के पथरा ला झन हटाबे।<verse eid="PRO 22:28" /></para>
  <para style="s2">कहावत 6</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />का तेंह अइसने मनखे ला देखथस, जऊन ह अपन काम म कुसल हवय?</para>
  <para style="q2" vid="PRO 22:29">ओह राजा के आघू म सेवा करही;</para>
  <para style="q2" vid="PRO 22:29">ओह छोटे पदवाले के आघू म सेवा नइं करय।<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">कहावत 7</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />जब तेंह कोनो हाकिम के संग खाय बर बईठबे,</para>
  <para style="q2" vid="PRO 23:1">त ये बात के धियान रखबे कि तोर आघू म का<note caller="+" style="f"><char style="fr" closed="false">23:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कोन</char></note> हवय,<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />यदि तेंह पेटू अस,</para>
  <para style="q2" vid="PRO 23:2">त थोरकन खाके उठ जाबे।<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />ओकर सुवादवाले जेवन के लालसा झन करबे,</para>
  <para style="q2" vid="PRO 23:3">काबरकि ओह धोखा के जेवन अय।<verse eid="PRO 23:3" /></para>
  <para style="s2">कहावत 8</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />धनी होय बर मेहनत झन करबे;</para>
  <para style="q2" vid="PRO 23:4">अपन होसियारी के ऊपर भरोसा झन करबे।<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />एक नजर उठाके धन ला देख, ओह तुरते गायब हो जाथे,</para>
  <para style="q2" vid="PRO 23:5">काबरकि ओमा पंख निकल आथे</para>
  <para style="q2" vid="PRO 23:5">अऊ ओह गिधवा के सहीं अकास म उड़ जाथे।<verse eid="PRO 23:5" /></para>
  <para style="s2">कहावत 9</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />कंजूस मनखे के जेवन झन करबे,</para>
  <para style="q2" vid="PRO 23:6">ओकर सुवादवाले जेवन के लालसा झन करबे<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />काबरकि ओह अइसने मनखे अय</para>
  <para style="q2" vid="PRO 23:7">जऊन ह हमेसा खरचा के बारे म सोचत रहिथे।</para>
  <para style="q1" vid="PRO 23:7">ओह तोला तो कहिथे, “खा अऊ पी,”</para>
  <para style="q2" vid="PRO 23:7">पर ओकर मन तोर म लगे नइं रहय।<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />जऊन थोरकन तेंह खाय हवस, ओला उछर देबे</para>
  <para style="q2" vid="PRO 23:8">अऊ तोर कहे परसंसा के बात ह बेकार होही।<verse eid="PRO 23:8" /></para>
  <para style="s2">कहावत 10</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />मुरूखमन के आघू म झन गोठिया,</para>
  <para style="q2" vid="PRO 23:9">नइं तो ओमन तोर बुद्धि के बात ला तुछ समझहीं।<verse eid="PRO 23:9" /></para>
  <para style="s2">कहावत 11</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />पुराना सीमना के पथरा ला झन हटाबे</para>
  <para style="q2" vid="PRO 23:10">या अनाथ मनखे के खेत ला झन चपलबे,<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />काबरकि ओमन के बचाव करइया<note caller="+" style="f"><char style="fr" closed="false">23:11 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यहोवा</char></note> ह सामर्थी ए;</para>
  <para style="q2" vid="PRO 23:11">ओह तोर बिरूध म ओकर मुकदमा लड़ही।<verse eid="PRO 23:11" /></para>
  <para style="s2">कहावत 12</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />अपन मन ला हुकूम माने बर</para>
  <para style="q2" vid="PRO 23:12">अऊ अपन कान ला गियान के बात सुने म लगा।<verse eid="PRO 23:12" /></para>
  <para style="s2">कहावत 13</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />लइका के ताड़ना करे बर झन छोंड़;</para>
  <para style="q2" vid="PRO 23:13">यदि तेंह ओला छड़ी ले मारबे, त ओह नइं मरय।<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />ओला छड़ी ले मार</para>
  <para style="q2" vid="PRO 23:14">अऊ तेंह ओकर आतमा ला अधोलोक जाय ले बचाबे।<verse eid="PRO 23:14" /></para>
  <para style="s2">कहावत 14</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />हे मोर बेटा, यदि तेंह बुद्धिमान अस,</para>
  <para style="q2" vid="PRO 23:15">त मोर मन ला सही म खुसी होही;<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />जब तेंह सही बात गोठियाबे,</para>
  <para style="q2" vid="PRO 23:16">त मोर अंतर-आतमा ह आनंदित होही।<verse eid="PRO 23:16" /></para>
  <para style="s2">कहावत 15</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />पापी मनखेमन के बारे म जलन झन रखबे,</para>
  <para style="q2" vid="PRO 23:17">पर हमेसा यहोवा के भय मानत रहिबे।<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />खचित तोर बर भविस्य के एक आसा हवय,</para>
  <para style="q2" vid="PRO 23:18">अऊ तोर आसा ह नइं टूटही।<verse eid="PRO 23:18" /></para>
  <para style="s2">कहावत 16</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />हे मोर बेटा, सुन, अऊ बुद्धिमान बन,</para>
  <para style="q2" vid="PRO 23:19">अऊ अपन मन ला सही रसता म लगा:<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />जऊन मन बहुंत जादा मंद पीथें</para>
  <para style="q2" vid="PRO 23:20">या जऊन मन ठूंस-ठूंसके मांस खाथें, ओमन के संग झन जा,<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />काबरकि मतवार अऊ भुक्खड़मन गरीब हो जाथें,</para>
  <para style="q2" vid="PRO 23:21">अऊ नसा म रहे या उंघत रहे के कारन ओमन फटहा-चीरहा कपड़ा म आ जाथें।<verse eid="PRO 23:21" /></para>
  <para style="s2">कहावत 17</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />अपन जनम देवइया ददा के बात ला सुने कर,</para>
  <para style="q2" vid="PRO 23:22">अऊ जब तोर दाई ह डोकरी हो जाथे, त ओला तुछ झन समझबे।<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />सच्चई ला बिसा अऊ येला बेचबे झन—</para>
  <para style="q2" vid="PRO 23:23">बुद्धि, सिकछा अऊ अंतर-गियान ला घलो बिसा ले।<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />धरमी लइका के ददा ह बहुंत आनंदित होथे;</para>
  <para style="q2" vid="PRO 23:24">बुद्धिमान बेटा ला जनम देवइया ददा ह अपन बेटा के कारन आनंदित होथे।<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />तोर ददा अऊ दाई आनंदित होवंय;</para>
  <para style="q2" vid="PRO 23:25">जऊन दाई ह तोला जनम दीस, ओह आनंदित होवय!<verse eid="PRO 23:25" /></para>
  <para style="s2">कहावत 18</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />हे मोर बेटा, अपन हिरदय मोला दे</para>
  <para style="q2" vid="PRO 23:26">अऊ तोर आंखी ह मोर बताय रसता म लगे रहय,<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />काबरकि छिनार माईलोगन ह एक गहिरा खंचवा सहीं अय,</para>
  <para style="q2" vid="PRO 23:27">अऊ जिद्दी घरवाली ह एक संकरा कुआं सहीं अय।<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />ओह एक डाकू के सहीं घात लगाय रहिथे</para>
  <para style="q2" vid="PRO 23:28">अऊ बहुंत मनखेमन ला बिसवासघाती कर देथे।<verse eid="PRO 23:28" /></para>
  <para style="s2">कहावत 19</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />कोन ला हाय लगथे? कोन ह दुख म होथे?</para>
  <para style="q2" vid="PRO 23:29">कोन ह झगरा म फंसे होथे? कोन ह सिकायत करथे?</para>
  <para style="q2" vid="PRO 23:29">कोन ला बिगर कारन के घाव होथे? काकर लाल-लाल आंखी होथे?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />ओमन, जऊन मन बहुंत देर तक मंद पीयत रहिथें,</para>
  <para style="q2" vid="PRO 23:30">जऊन मन मसाला मिले मंद के सुवाद लेथें।<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />जब मंद ह लाल होथे,</para>
  <para style="q2" vid="PRO 23:31">जब येह कटोरा म चमकथे,</para>
  <para style="q2" vid="PRO 23:31">जब येला ढारे जाथे, त येला टकटकी लगाके झन देखबे!<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />आखिरी म येह सांप के सहीं चाबथे</para>
  <para style="q2" vid="PRO 23:32">अऊ येकर जहर ह करैत सांप के सहीं होथे।<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />तेंह अजीब चीजमन ला देखबे,</para>
  <para style="q2" vid="PRO 23:33">अऊ तोर मन ह उल्टा-सीधा बातमन के कल्पना करही।<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />तेंह समुंदर म उठत लहरामन ऊपर सोवइया,</para>
  <para style="q2" vid="PRO 23:34">या पानी जहाज के रस्सी के टीप म लेटनेवाला सहीं होबे।<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />तेंह कहिबे, “ओमन मोला मारथें-पीटथें, पर मोला चोट नइं लगय!</para>
  <para style="q2" vid="PRO 23:35">ओमन मोला मारथें, पर मोला येकर पता नइं चलय!</para>
  <para style="q1" vid="PRO 23:35">मेंह कब जागहूं</para>
  <para style="q2" vid="PRO 23:35">कि में फेर मंद पी सकंव?”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">कहावत 20</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />दुस्ट मनखे के बारे म जलन झन रखबे,</para>
  <para style="q2" vid="PRO 24:1">ओमन के संगति के ईछा झन करबे;<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />काबरकि ओमन हिंसा के बात सोचथें,</para>
  <para style="q2" vid="PRO 24:2">अऊ ओमन समस्या खड़े करे के बात करथें।<verse eid="PRO 24:2" /></para>
  <para style="s2">कहावत 21</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />बुद्धि के दुवारा घर ह बनथे,</para>
  <para style="q2" vid="PRO 24:3">अऊ समझ के जरिये येह इस्थिर होथे;<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />गियान के जरिये येकर कमरामन</para>
  <para style="q2" vid="PRO 24:4">दुरलभ अऊ सुघर खजाना ले भर जाथें।<verse eid="PRO 24:4" /></para>
  <para style="s2">कहावत 22</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />बुद्धिमान ह अपन बड़े सक्ति के जरिये जय पाथे,</para>
  <para style="q2" vid="PRO 24:5">अऊ जेकर करा गियान होथे, ओह अपन ताकत बढ़ाथे।<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />खचित, लड़ई बर तोला सही युक्ति के जरूरत हवय,</para>
  <para style="q2" vid="PRO 24:6">अऊ बिजय बहुंत सलाहकारमन के जरिये मिलथे।<verse eid="PRO 24:6" /></para>
  <para style="s2">कहावत 23</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />बुद्धि ह अतेक ऊपर म हवय कि मुरूख ह ओला पा नइं सकय;</para>
  <para style="q2" vid="PRO 24:7">ओह सभा के दुवार<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सहर के दुवार जिहां मनखेमन सभा करंय</char></note> म कुछू गोठिया नइं सकय।<verse eid="PRO 24:7" /></para>
  <para style="s2">कहावत 24</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />जऊन ह दुस्टता के सडयंत्र रचथे,</para>
  <para style="q2" vid="PRO 24:8">ओह सडयंत्र रचइया के रूप म जाने जाथे।<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />मुरूखता के योजना बनई ह पाप ए,</para>
  <para style="q2" vid="PRO 24:9">अऊ मनखेमन ठट्ठा करइया ले घिन करथें।<verse eid="PRO 24:9" /></para>
  <para style="s2">कहावत 25</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />यदि बिपत्ति के बेरा तेंह लड़खड़ाथस,</para>
  <para style="q2" vid="PRO 24:10">त तोर सक्ति बहुंत कम हवय!<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />जऊन मन ला मार डाले बर ले जावथें, ओमन ला छुड़ा;</para>
  <para style="q2" vid="PRO 24:11">जऊन मन मरे बर लड़खड़ावत जावथें, ओमन ला रोक ले।<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />यदि तेंह कहिथस, “पर हमन येकर बारे म कुछू नइं जानत रहेंन,”</para>
  <para style="q2" vid="PRO 24:12">त का मन के जांचनेवाला<note caller="+" style="f"><char style="fr" closed="false">24:12 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमेसर</char></note> ह येला नइं समझय?</para>
  <para style="q1" vid="PRO 24:12">जऊन ह तोर जिनगी के रखवारी करथे, ओह का येला नइं जानय?</para>
  <para style="q2" vid="PRO 24:12">का ओह हर एक मनखे ला ओकर काम के मुताबिक ओकर परतिफल नइं दीही?<verse eid="PRO 24:12" /></para>
  <para style="s2">कहावत 26</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />हे मोर बेटा, मंधरस ला खा, काबरकि येह बने अय;</para>
  <para style="q2" vid="PRO 24:13">मधु-छत्ता के मंधरस ह सुवाद म मीठ लगथे।<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />ये बात ला घलो जान ले कि बुद्धि ह तोर बर मंधरस के सहीं अय:</para>
  <para style="q2" vid="PRO 24:14">यदि येह तोला मिलथे, त भविस्य म तोर बर एक आसा हवय,</para>
  <para style="q2" vid="PRO 24:14">अऊ तोर आसा ह नइं टूटही।<verse eid="PRO 24:14" /></para>
  <para style="s2">कहावत 27</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />धरमी मनखे के घर के लकठा म एक चोर के सहीं घात झन लगा,</para>
  <para style="q2" vid="PRO 24:15">ओकर निवास ला झन लूट;<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />काबरकि धरमी जन चाहे सात बार ले गिरे, पर ओह फेर उठही,</para>
  <para style="q2" vid="PRO 24:16">पर दुस्ट मनखेमन बिपत्ति आय ले लड़खड़ाथें।<verse eid="PRO 24:16" /></para>
  <para style="s2">कहावत 28</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />जब तोर बईरी ह गिरथे, त खुस झन होबे;</para>
  <para style="q2" vid="PRO 24:17">जब ओह लड़खड़ाथे, त अपन मन म आनंदित झन हो,<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />नइं तो यहोवा ह येला देखही अऊ खुस नइं होही</para>
  <para style="q2" vid="PRO 24:18">अऊ ओह तोर बईरी ऊपर ले अपन कोप ला हटा लीही।<verse eid="PRO 24:18" /></para>
  <para style="s2">कहावत 29</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />कुकरमीमन के कारन झन कुढ़</para>
  <para style="q2" vid="PRO 24:19">या दुस्ट मनखे ले जलन झन रख,<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />काबरकि कुकरमी के कोनो भविस्य नइं ए,</para>
  <para style="q2" vid="PRO 24:20">अऊ दुस्ट मनखे के दीया ह बुता जाही।<verse eid="PRO 24:20" /></para>
  <para style="s2">कहावत 30</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />हे मोर बेटा, यहोवा अऊ राजा के भय मान,</para>
  <para style="q2" vid="PRO 24:21">अऊ बिदरोही करमचारीमन के संग झन जा,<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />काबरकि ओ दूनों ओमन के अचानक बिनास कर दीहीं,</para>
  <para style="q2" vid="PRO 24:22">अऊ कोन जानथे कि ओमन अऊ का बिपत्ति ला सकथें?<verse eid="PRO 24:22" /></para>
  <para style="ms1">बुद्धिमान मनखे के कुछू अऊ कहावत</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />बुद्धिमान मनखे के कहावत ये घलो अंय:</para>
  <para style="q1" vid="PRO 24:23">नियाय म पखियपात करई ह बने नो हय:<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />जऊन ह दोसी मनखे ला कहिथे, “तेंह निरदोस अस,”</para>
  <para style="q2" vid="PRO 24:24">ओला मनखेमन सराप देथें अऊ जाति-जाति के मनखेमन ओकर ले घिन करथें।<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />पर जऊन मन दोसी ला दोसी ठहिराथें, ओमन के भलई होही,</para>
  <para style="q2" vid="PRO 24:25">अऊ ओमन ऊपर बहुंत आसीस होही।<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />एक ईमानदार जबाब ह</para>
  <para style="q2" vid="PRO 24:26">ओंठ ला चूमा देय सहीं अय।<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />अपन बाहिर के काम ला ठीक कर ले</para>
  <para style="q2" vid="PRO 24:27">अऊ अपन खेत ला तियार रख;</para>
  <para style="q2" vid="PRO 24:27">ओकर बाद, अपन घर ला बना।<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />बिगर कारन के, अपन परोसी के बिरूध गवाही झन देबे,</para>
  <para style="q2" vid="PRO 24:28">अऊ अपन बात के दुवारा ओला झन बहकाबे।<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />ये झन कहिबे, “जइसने ओमन मोर संग करे हवंय, वइसने मेंह ओमन के संग करहूं;</para>
  <para style="q2" vid="PRO 24:29">जइसने ओमन करे हवंय, मेंह ओमन ले ओकर बदला लूहूं।”<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />मेंह एक आलसी के खेत ले</para>
  <para style="q2" vid="PRO 24:30">अऊ एक अगियानी के अंगूर के बारी ले होवत गेंव;<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />त देखेंव कि उहां हर जगह कंटिला पऊधामन भर गे हवंय,</para>
  <para style="q2" vid="PRO 24:31">भुइयां ह कांदी ले भर गे हवय,</para>
  <para style="q2" vid="PRO 24:31">अऊ पथरा के बाड़ा ह टूट गे हवय।<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />ओमन ला धियान से देखके, मन म बिचार करेंव</para>
  <para style="q2" vid="PRO 24:32">अऊ जऊन कुछू मेंह देखेंव, ओकर ले एक बात सीखेंव:<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />थोरकन अऊ नींद, थोरकन अऊ ऊंघासी,</para>
  <para style="q2" vid="PRO 24:33">हांथ म हांथ धरके अऊ थोरकन देर बईठे रहई—<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />अऊ गरीबी ह चोर सहीं</para>
  <para style="q2" vid="PRO 24:34">अऊ घटी ह हथियार धरे मनखे सहीं तोर ऊपर आ जाही।<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="ms1">सुलेमान के अऊ नीतिबचन</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />येमन सुलेमान के अऊ नीतिबचन अंय, जऊन ला यहूदा के राजा हिजकियाह के मनखेमन संकेलके रखे हवंय:<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />परमेसर के महिमा कोनो बात ला छुपाके रखे म होथे;</para>
  <para style="q2" vid="PRO 25:2">राजामन के महिमा कोनो बात के पता लगाय म होथे।<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />जइसने अकासमन ऊंच अऊ धरती ह गहिरा हवय,</para>
  <para style="q2" vid="PRO 25:3">वइसने राजा के मन के थाह ला नइं पाय जा सकय।<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />चांदी ले मईल ला हटावव,</para>
  <para style="q2" vid="PRO 25:4">अऊ सुनार ह ओकर ले बने चीज बना सकथे;<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />राजा के आघू ले दुस्ट करमचारीमन ला निकाल दव,</para>
  <para style="q2" vid="PRO 25:5">अऊ ओकर सिंघासन ह धरमीपन के दुवारा बने रहिही।<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />राजा के आघू म अपन बड़ई झन करबे,</para>
  <para style="q2" vid="PRO 25:6">अऊ ओकर बड़े मनखेमन के बीच म अपन जगह के दावा झन करबे;<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />येह जादा बने बात होही कि ओह तोला कहय, “इहां ऊपर आ,”</para>
  <para style="q2" vid="PRO 25:7">येकर बदले कि ओह अपन बड़े मनखेमन के आघू म तोर अपमान करय।</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q1" vid="PRO 25:7">जऊन कुछू तेंह अपन आंखी ले देखे हस<verse eid="PRO 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8" />ओला जल्दबाजी म अदालत झन ले जाबे,</para>
  <para style="q1" vid="PRO 25:8">नइं तो आखिरी म, तेंह का करबे</para>
  <para style="q2" vid="PRO 25:8">जब तोर परोसी ह तोर बेजत्ती करही?<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />यदि तेंह अपन परोसी ला अदालत म ले जाथस,</para>
  <para style="q2" vid="PRO 25:9">त दूसर के भरोसा ला झन टोरबे,<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />नइं तो जऊन ह येला सुनही, ओह तोर निन्दा करही</para>
  <para style="q2" vid="PRO 25:10">अऊ तेंह दोसी गने जाबे।<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />सही बात ला कहई ह</para>
  <para style="q2" vid="PRO 25:11">चांदी के टुकनी म सोन के सेव फर सहीं अय।<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />जइसने कि सोन के कनफूली या सुध सोन के जेवर होथे</para>
  <para style="q2" vid="PRO 25:12">वइसने ही बुद्धिमान नियायधीस के डांट ह सुनइया ला बने लगथे।<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />जइसने फसल लुवई के बेरा बरफ के ठंडा पानी होथे</para>
  <para style="q2" vid="PRO 25:13">वइसने ही बिसवासयोग्य दूत ह अपन भेजइया बर होथे;</para>
  <para style="q2" vid="PRO 25:13">ओह अपन मालिक के आतमा ला ताजा करथे।<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />जइसने बिगर बारिस के बादर अऊ हवा होथे</para>
  <para style="q2" vid="PRO 25:14">वइसने ओह होथे, जऊन ह ओ ईनाम के बड़ई करथे, जेला ओह कभू नइं दीस।<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />धीरज के जरिये एक सासन करइया ला मनाय जा सकथे,</para>
  <para style="q2" vid="PRO 25:15">अऊ नरम बचन ह कठोर मनखे ला घलो नरम कर सकथे।<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />यदि तोला मंधरस मिलथे, त जतेक जरूरत हे, ओतेक खाबे—</para>
  <para style="q2" vid="PRO 25:16">जादा खाबे, त तोला उछरना पड़ही।<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />अपन परोसी के घर म कभू-कभू जाबे—</para>
  <para style="q2" vid="PRO 25:17">ओकर इहां बहुंत जादा जाबे, त ओमन तोर ले घिन करहीं।<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />जऊन ह अपन परोसी के बिरूध म लबरा गवाही देथे,</para>
  <para style="q2" vid="PRO 25:18">ओह गदा या तलवार या नुकीला तीर सहीं अय।<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />बिपत्ति के बेरा बिसवासघाती ऊपर भरोसा करई ह</para>
  <para style="q2" vid="PRO 25:19">टूटहा दांत या खोरवा गोड़ सहीं अय।<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />जइसने जाड़ा के दिन म काकरो कपड़ा ला ले लेवई,</para>
  <para style="q2" vid="PRO 25:20">या काकरो घाव म सिरका रितोई,</para>
  <para style="q2" vid="PRO 25:20">वइसने ही कोनो दुखी मनखे के आघू म गीत गवई होथे।<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />यदि तोर बईरी ह भूखा हवय, त ओला खाय बर जेवन दे;</para>
  <para style="q2" vid="PRO 25:21">यदि ओह पीयासन हवय, त ओला पीये बर पानी दे।<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />अइसने करे ले, ओह लज्जित होही<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अइसने करके तेंह ओकर मुड़ ऊपर लज्जा के बरत कोइला के ढेर लगाबे</char></note></para>
  <para style="q2" vid="PRO 25:22">अऊ यहोवा ह तोला ईनाम दीही।<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />जइसने कि उत्तरी हवा ह बिगर आसा के बारिस लानथे,</para>
  <para style="q2" vid="PRO 25:23">वइसने ही चुगली करई ह मनखे के गुस्सा ला बढ़ाथे।<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />झगरा करइया घरवाली के संग घर म रहई के बदले</para>
  <para style="q2" vid="PRO 25:24">छानी के कोनटा म रहई ह बने अय।<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />जइसने कि थके-हारे मनखे बर ठंडा पानी होथे,</para>
  <para style="q2" vid="PRO 25:25">वइसने ही दूरिहा देस ले आय सुघर संदेस होथे।<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />जइसने कि चीखलावाले झरना या गंदा कुआं होथे,</para>
  <para style="q2" vid="PRO 25:26">वइसने ही ओ धरमी होथे, जऊन ह दुस्ट मनखे के बात मानथे।<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />जादा मंधरस खवई ह बने नो हय,</para>
  <para style="q2" vid="PRO 25:27">जादा गहिरा बात के खोज करई घलो आदर के बात नो हय।<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />जऊन मनखे म संयम के कमी होथे,</para>
  <para style="q2" vid="PRO 25:28">ओह ओ सहर के सहीं होथे, जेकर सुरकछा के दीवारमन ला टोर दिये गे हवय।<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />जइसने कि गरमी के महिना म बरफ गिरई अऊ फसल लुवई के बेरा बारिस होवई ह बने नो हय</para>
  <para style="q2" vid="PRO 26:1">वइसने ही मुरूख मनखे के आदर करई ह बने नो हय।<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />जइसने कि डेना फड़फड़ावत गौरइया या उड़त अबाबील चिरई नइं बईठ सकय,</para>
  <para style="q2" vid="PRO 26:2">वइसने ही बेकार के दिये गे सराप ह नइं लगय।<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />घोड़ा बर चाबुक, गदहा बर लगाम,</para>
  <para style="q2" vid="PRO 26:3">अऊ मुरूखमन के पीठ बर छड़ी अय!<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />कोनो मुरूख ला ओकर मुरूखता के मुताबिक जबाब झन देबे,</para>
  <para style="q2" vid="PRO 26:4">नइं तो तें खुद घलो ओकर सहीं ठहिरबे।<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />मुरूख ला ओकर मुढ़ता के मुताबिक जबाब देबे,</para>
  <para style="q2" vid="PRO 26:5">नइं तो ओह अपन खुद के नजर म बुद्धिमान ठहिरही।<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />कोनो मुरूख के हांथ ले खबर पठोई ह</para>
  <para style="q2" vid="PRO 26:6">अपन गोड़ म टांगा मारई या जहर पीयई सहीं अय।<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />जइसने कि कोनो लंगड़ा के बेकार गोड़ ह होथे</para>
  <para style="q2" vid="PRO 26:7">वइसने ही कोनो मुरूख के मुहूं ले कहावत निकलई होथे।<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />जइसने कि कोनो पट्टा म बंधई पथरा होथे</para>
  <para style="q2" vid="PRO 26:8">वइसने ही कोनो मुरूख ला आदर देवई होथे।<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />जइसने कि कोनो मतवार के हांथ म कंटिली झाड़ी होथे</para>
  <para style="q2" vid="PRO 26:9">वइसने ही कोनो मुरूख के मुहूं ले कहावत निकलई होथे।<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />जइसने कि कोनो धनुसधारी ह बिगर सोचे-समझे चोट पहुंचाथे</para>
  <para style="q2" vid="PRO 26:10">वइसने ही ओह अय, जऊन ह कोनो मुरूख या डहार-रेंगइया ला काम म रखथे।<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />जइसने कि कुकुर ह अपन उछरे चीज ला खाय बर फेर लहुंटके आथे,</para>
  <para style="q2" vid="PRO 26:11">वइसने ही मुरूखमन अपन मुरूखता ला दोहराथें।<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />का तेंह अइसे मनखे ला देखथस, जऊन ह अपन खुद के नजर म बुद्धिमान ए?</para>
  <para style="q2" vid="PRO 26:12">त फेर ओकर ले जादा आसा मुरूख ऊपर रख।<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />आलसी मनखे ह कहिथे, “डहार म सेर हवय,</para>
  <para style="q2" vid="PRO 26:13">एक भयंकर सेर गली म घुमत हवय!”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />जइसने कि कपाट ह अपन कब्जा म घुमथे,</para>
  <para style="q2" vid="PRO 26:14">वइसने ही आलसी मनखे ह अपन खटिया म करवट लेथे।<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />आलसी मनखे ह अपन हांथ जेवन के थाली म तो डालथे;</para>
  <para style="q2" vid="PRO 26:15">पर आलस के मारे, ओह कऊंरा ला मुहूं तक नइं लानय।<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />आलसी मनखे ह अपनआप ला ओ सात मनखे ले घलो बुद्धिमान समझथे,</para>
  <para style="q2" vid="PRO 26:16">जऊन मन समझदारी से जबाब देथें।<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />जइसने कि कोनो मनखे ह भटकत कुकुर ला कान ले धरथे</para>
  <para style="q2" vid="PRO 26:17">वइसने ही ओह अय, जऊन ह आने के झगरा म झंपई होथे।<verse eid="PRO 26:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />जइसने कि पागल मनखे ह</para>
  <para style="q2" vid="PRO 26:18">मिरतू के बरत तीरमन ला छोंड़थे<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />वइसने ही ओह अय, जऊन ह अपन परोसी ला धोखा देथे</para>
  <para style="q2" vid="PRO 26:19">अऊ कहिथे, “मेंह तो मजाक करत रहेंव!”<verse eid="PRO 26:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />जइसने कि बिगर लकरी के आगी ह बुता जाथे;</para>
  <para style="q2" vid="PRO 26:20">वइसने ही बक-बक नइं करे ले झगरा ह खतम हो जाथे।<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />जइसने कि कोइला ह आगी ला बनाय रखथे अऊ लकरी ले आगी बरथे</para>
  <para style="q2" vid="PRO 26:21">वइसने ही झगड़ालू मनखे ह समस्या खड़े करथे।<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />बकवास करई ह सुवादवाले जेवन सहीं होथे;</para>
  <para style="q2" vid="PRO 26:22">येमन मनखे के भीतर तक चले जाथें।<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />जइसने कि चांदी के परत चढ़ाय माटी के बरतन होथे</para>
  <para style="q2" vid="PRO 26:23">वइसने ही बुरई ले भरे मनखे के मयारू बचन होथे।<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />बईरीमन अपन बात के दुवारा सीधवा बनथें,</para>
  <para style="q2" vid="PRO 26:24">पर अपन मन म छल-कपट के बात छुपाके रखथें।<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />हालाकि ओमन खुसी देवइया बात कहिथें, पर ओमन ऊपर बिसवास झन करबे,</para>
  <para style="q2" vid="PRO 26:25">काबरकि ओमन के मन ह सात ठन घिनौना चीज ले भरे रहिथे।<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />ओमन के बईरता ह छल-कपट के कारन छुप जाथे,</para>
  <para style="q2" vid="PRO 26:26">पर ओमन के दुस्टता ह भरे सभा म परगट हो जाही।<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />जऊन ह आने बर खंचवा कोड़थे, ओह खुद ओमा गिरही;</para>
  <para style="q2" vid="PRO 26:27">जऊन ह आने ऊपर पथरा ला ढलंगाथे, ओ पथरा ह वापिस ओकरेच ऊपर ढलंगही।<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />जऊन ह लबारी मारके आने मन ला चोट पहुंचाथे, ओह ओमन ले घिन करथे,</para>
  <para style="q2" vid="PRO 26:28">अऊ चापलूसी करइया ह बिनास के काम करथे।<verse eid="PRO 26:28" /></para>
  <para style="b" />
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />कल के दिन बर घमंड झन कर,</para>
  <para style="q2" vid="PRO 27:1">काबरकि तें नइं जानस कि कल का होही।<verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />आने मन तोर बड़ई करंय तो करंय, पर तें अपन बड़ई झन करबे;</para>
  <para style="q2" vid="PRO 27:2">बाहिरी मनखेमन तोर बड़ई करंय, पर तें खुद झन करबे।<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />पथरा ह भारी अऊ बालू ह एक बोझ होथे,</para>
  <para style="q2" vid="PRO 27:3">पर मुरूख के उकसई ह ये दूनों ले भारी होथे।<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />गुस्सा ह निरदयी ए अऊ उत्तेजना ह बियाकुल कर देथे,</para>
  <para style="q2" vid="PRO 27:4">पर ईरसा के आघू म कोन ठहर सकथे?<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />खुला डांट ह</para>
  <para style="q2" vid="PRO 27:5">छुपे मया ले बने अय।<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />कोनो संगी के चोट पहुंचई के भरोसा करे जा सकथे,</para>
  <para style="q2" vid="PRO 27:6">पर कोनो बईरी के बहुंत चूमा ला घलो भरोसा नइं करे जा सकय।<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />जेकर पेट भरे होथे, ओला मधु-छत्ता के मंधरस घलो बने नइं लगय,</para>
  <para style="q2" vid="PRO 27:7">पर भूखा मनखे ला करू चीज घलो मीठ लगथे।<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />अपन घर ला छोंड़के भागनेवाला ह</para>
  <para style="q2" vid="PRO 27:8">ओ चिरई सहीं होथे, जऊन ह अपन खोंधरा छोंड़के भाग जाथे।<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />इतर अऊ खुसबूदार धूप ह मन ला आनंदित करथे,</para>
  <para style="q2" vid="PRO 27:9">अऊ कोनो संगी के हिरदय ले निकले सलाह ह</para>
  <para style="q2" vid="PRO 27:9">ओकर खुसी ला देखाथे।<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />अपन संगी या अपन परिवारिक संगी ला झन छोंड़बे,</para>
  <para style="q2" vid="PRO 27:10">अऊ अपन बिपत्ति के बेरा अपन रिस्तेदार के घर झन जाबे—</para>
  <para style="q2" vid="PRO 27:10">लकठा म रहइया परोसी ह दूरिहा म रहइया रिस्तेदार ले बने अय।<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />हे मोर बेटा, बुद्धिमान बन अऊ मोर मन ला आनंदित कर;</para>
  <para style="q2" vid="PRO 27:11">तब मेंह ओला जबाब दे सकहूं, जऊन ह मोर अपमान करथे।<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />समझदार मनखे ह खतरा ला देखके सरन ले लेथे,</para>
  <para style="q2" vid="PRO 27:12">पर सीधवा मनखे ह चलते रहिथे अऊ हानि उठाथे।<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />ओ मनखे के कपड़ा ला लेय ले, जऊन ह कोनो अजनबी मनखे के जिम्मेदारी लेथे;</para>
  <para style="q2" vid="PRO 27:13">यदि ये काम कोनो बाहिरी मनखे बर करे जाथे, त ओ कपड़ा ला गिरवी के रूप म रख।<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />यदि कोनो मनखे ह बड़े बिहनियां अपन परोसी ला ऊंचहा अवाज म आसीस देथे,</para>
  <para style="q2" vid="PRO 27:14">त येला एक सराप समझे जाही।<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />झगरा करइया घरवाली ह बारिस के दिन म</para>
  <para style="q2" vid="PRO 27:15">छानी ले लगातार चूहत पानी सहीं अय;<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />ओला रोकई, हवा ला रोकई सहीं</para>
  <para style="q2" vid="PRO 27:16">या हांथ म तेल ला पकड़ई सहीं अय।<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />जइसने कि लोहा ह लोहा ला तेज करथे,</para>
  <para style="q2" vid="PRO 27:17">वइसने ही एक मनखे ह दूसर मनखे ला तेज बनाथे।<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />जऊन ह अंजीर रूख के रखवारी करथे, ओह ओकर फर खाही,</para>
  <para style="q2" vid="PRO 27:18">अऊ जऊन ह अपन मालिक के रकछा करथे, ओकर आदर होही।<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />जइसने कि पानी ह चेहरा के परछाई ला देखाथे,</para>
  <para style="q2" vid="PRO 27:19">वइसने ही मनखे के मन ह ओकर जिनगी ला परगट करथे।<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />मिरतू अऊ बिनास कभू संतोस नइं होवंय,</para>
  <para style="q2" vid="PRO 27:20">अऊ न ही मनखे के आंखी ह संतोस होवय।<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />चांदी ला परखे बर कुठाली अऊ सोन ला परखे बर भट्ठी होथे,</para>
  <para style="q2" vid="PRO 27:21">पर मनखे के परख ओकर परसंसा के दुवारा होथे।<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />चाहे तेंह मुरूख ला ओखली म पीस,</para>
  <para style="q2" vid="PRO 27:22">या ओला लोढ़ा म अनाज सहीं पीस,</para>
  <para style="q2" vid="PRO 27:22">तभो ले तेंह ओकर मुरूखता ला ओकर ले अलग नइं कर सकस।<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />अपन भेड़-बकरी के झुंड के दसा ला बने करके जान ले,</para>
  <para style="q2" vid="PRO 27:23">अपन पसु के झुंड के बने करके धियान रख;<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />काबरकि धन ह हमेसा बर नइं रहय,</para>
  <para style="q2" vid="PRO 27:24">अऊ राज-मुकुट ह पीढ़ी-पीढ़ी तक बने नइं रहय।<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />जब कांदी ला काटके हटाय जाथे, त नवां कांदी निकलथे</para>
  <para style="q2" vid="PRO 27:25">अऊ पहाड़ ले कांदी ला संकेले जाथे,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />भेड़ के पीलामन तोर बर कपड़ा दीहीं,</para>
  <para style="q2" vid="PRO 27:26">अऊ बोकरामन खेत बिसाय बर कीमत दीहीं।<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />तोर करा अपन परिवार के मनखेमन ला पीयाय बर बकरी के बहुंत दूध होही</para>
  <para style="q2" vid="PRO 27:27">अऊ येकर ले तोर सेविकामन के घलो पालन-पोसन होही।<verse eid="PRO 27:27" /></para>
  <para style="b" />
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />दुस्ट मनखेमन तब भी भागथें जब ओमन के पीछा कोनो नइं करत रहय,</para>
  <para style="q2" vid="PRO 28:1">पर धरमी मनखेमन सेर के सहीं साहसी होथें।<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />जब कोनो देस ह बिदरोह करथे, त ओकर ऊपर सासन करइया बहुंत होथें,</para>
  <para style="q2" vid="PRO 28:2">पर समझदार अऊ गियानी सासन करइया ह कानून-ब्यवस्था बनाय रखथे।<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />जऊन सासन करइया ह गरीबमन ऊपर अतियाचार करथे,</para>
  <para style="q2" vid="PRO 28:3">ओह ओ भारी बारिस सहीं अय, जऊन ह फसल ला नास कर देथे।<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />जऊन मन सिकछा ला नइं मानंय, ओमन दुस्ट मनखे के परसंसा करथें,</para>
  <para style="q2" vid="PRO 28:4">पर जऊन मन सिकछा ला मानथें, ओमन दुस्ट मनखे के बिरोध करथें।<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />दुस्ट मनखेमन सही बात ला नइं समझंय,</para>
  <para style="q2" vid="PRO 28:5">पर जऊन मन यहोवा ला खोजथें, ओमन येला पूरा समझथें।<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />उल्टा-सीधा काम करइया धनी मनखे ले</para>
  <para style="q2" vid="PRO 28:6">निरदोस रहइया गरीब मनखे ह बने अय।<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />समझदार बेटा ह सिकछा ऊपर धियान देथे,</para>
  <para style="q2" vid="PRO 28:7">पर पेटू के संगी ह अपन ददा ऊपर कलंक लगाथे।<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />जऊन ह गरीबमन ले लाभ लेके या बियाज लेके अपन धन ला बढ़ाथे</para>
  <para style="q2" vid="PRO 28:8">ओह ओमन बर धन जमा करथे, जऊन मन गरीबमन ऊपर दया करथें।<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />यदि कोनो मनखे ह मोर सिकछा ला अनसुनी करथे,</para>
  <para style="q2" vid="PRO 28:9">त ओकर पराथना घलो घिन समझे जाथे।<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />जऊन ह ईमानदार मनखे ला बुरई के रसता म ले जाथे,</para>
  <para style="q2" vid="PRO 28:10">ओह खुद अपन फांदा म फंसही,</para>
  <para style="q2" vid="PRO 28:10">पर निरदोस मनखे ला बने उत्तराधिकार मिलही।<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />धनी मनखेमन अपन खुद के आंखी म बुद्धिमान होथें;</para>
  <para style="q2" vid="PRO 28:11">पर गरीब अऊ समझदार मनखे ह देखथे कि धनी मनखेमन कतेक बहक गे हवंय।<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />जब धरमी मनखेमन बिजयी होथें, त बहुंत खुसी होथे;</para>
  <para style="q2" vid="PRO 28:12">पर जब दुस्ट मनखेमन सक्तिसाली होय लगथें, त मनखेमन छुप जाथें।<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />जऊन ह अपन पाप ला छुपाथे, ओह नइं बढ़य,</para>
  <para style="q2" vid="PRO 28:13">पर जऊन ह अपन पाप ला मान लेथे अऊ ओमन ला छोंड़ देथे, ओकर ऊपर दया करे जाथे।<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />धइन ए ओ मनखे, जऊन ह हमेसा परमेसर के भय मानथे,</para>
  <para style="q2" vid="PRO 28:14">पर जऊन ह अपन मन ला कठोर कर लेथे, ओह बिपत्ति म पड़थे।<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />जइसने कि गरजत सेर या हमला करइया भालू होथे</para>
  <para style="q2" vid="PRO 28:15">वइसने ही असहाय मनखेमन ऊपर दुस्ट सासन करइया होथे।<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />अतियाचारी सासन करइया ह बलपूर्वक छीन लेथे,</para>
  <para style="q2" vid="PRO 28:16">पर जऊन ह बुरई से कमाय लाभ ले घिन करथे, ओह लम्बा समय तक राज करे के आनंद लीही।<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />जऊन ह हतिया के दोस के पीरा म रहिथे</para>
  <para style="q2" vid="PRO 28:17">ओह कबर म सरन पाही;</para>
  <para style="q2" vid="PRO 28:17">कोनो ओला झन रोकय।<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />जेकर चालचलन ह निरदोस रहिथे, ओह बचाय जाथे,</para>
  <para style="q2" vid="PRO 28:18">पर उल्टा-सीधा काम करइया ह खंचवा म गिरही।<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />जऊन मन अपन खेत ला कमाथें, ओमन करा बहुंत जेवन होही,</para>
  <para style="q2" vid="PRO 28:19">पर जऊन मन सिरिप कल्पना करत रहिथें, ओमन बहुंत गरीब हो जाहीं।<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />बिसवासयोग्य मनखे ला बहुंत आसीस मिलही,</para>
  <para style="q2" vid="PRO 28:20">पर जऊन ह धनी बने बर उतावली करथे, ओह दंड ले नइं बचय।<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />पखियपात करई ह बने नो हय—</para>
  <para style="q2" vid="PRO 28:21">तभो ले रोटी के एक कुटा बर मनखे ह गलती करही।<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />कंजूस मनखे ह धनी बने बर उतावली करथे</para>
  <para style="q2" vid="PRO 28:22">अऊ नइं जानय कि गरीबी ह ओकर बाट जोहत हे।<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />जऊन ह कोनो मनखे ला डांटथे, ओह आखिरी म</para>
  <para style="q2" vid="PRO 28:23">चापलूसी करइया ले जादा मयारू होथे।<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />जऊन ह अपन दाई या ददा ला लूटथे</para>
  <para style="q2" vid="PRO 28:24">अऊ कहिथे, “मेंह गलत नइं करत हंव,”</para>
  <para style="q2" vid="PRO 28:24">ओह नास करइया के सहभागी होथे।<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />लालची मनखे ह झगरा ला बढ़ाथे,</para>
  <para style="q2" vid="PRO 28:25">पर जऊन मन यहोवा ऊपर भरोसा रखथें, ओमन उन्नति करहीं।<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />जऊन मन अपन ऊपर भरोसा रखथें, ओमन मुरूख होथें,</para>
  <para style="q2" vid="PRO 28:26">पर जऊन मन बुद्धि से चलथें, ओमन सुरकछित रहिथें।<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />जऊन मन गरीबमन ला देथें, ओमन ला कुछू चीज के कमी नइं होवय,</para>
  <para style="q2" vid="PRO 28:27">पर जऊन मन गरीबमन ले नजर फेर लेथें, ओमन ला बहुंत सराप मिलथे।<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />जब दुस्ट मनखेमन सक्तिसाली हो जाथें, त मनखेमन छुपे लगथें;</para>
  <para style="q2" vid="PRO 28:28">पर जब दुस्ट मनखेमन नास होथें, त धरमी मनखेमन उन्नति करथें।<verse eid="PRO 28:28" /></para>
  <para style="b" />
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />जऊन ह बार-बार डांटे ले घलो हठी बने रहिथे</para>
  <para style="q2" vid="PRO 29:1">ओह बिगर कोनो उपाय के अचानक नास हो जाही।<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />जब धरमीमन उन्नति करथें, त मनखेमन आनंदित होथें;</para>
  <para style="q2" vid="PRO 29:2">जब दुस्टमन राज करथें, त मनखेमन कलहरथें।<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />जऊन मनखे ह बुद्धि ले मया करथे, ओह अपन ददा ला आनंदित करथे,</para>
  <para style="q2" vid="PRO 29:3">पर बेस्यामन के संगति करइया ह अपन संपत्ति ला उड़ा देथे।<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />नियाय के दुवारा राजा ह देस ला इस्थिर करथे,</para>
  <para style="q2" vid="PRO 29:4">पर जऊन मन घूसखोरी करते रहिथें, ओमन देस ला टोर देथें।<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />जऊन मन अपन परोसीमन के चापलूसी करथें</para>
  <para style="q2" vid="PRO 29:5">ओमन अपन परोसी के गोड़ बर फांदा लगाथें।<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />दुस्ट मनखेमन अपन खुद के पाप म फंसथें,</para>
  <para style="q2" vid="PRO 29:6">पर धरमी मनखेमन आनंद के जय-जयकार करके खुसी मनाथें।<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />धरमी मनखे ह गरीब मनखे के नियाय ऊपर धियान देथे,</para>
  <para style="q2" vid="PRO 29:7">पर दुस्ट मनखे ह ये किसम के चिंता नइं करय।<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />ठट्ठा करइयामन सहर ला उत्तेजित करथें,</para>
  <para style="q2" vid="PRO 29:8">पर बुद्धिमान मनखेमन गुस्सा ला दूर करथें।<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />यदि कोनो बुद्धिमान मनखे ह कोनो मुरूख मनखे के संग अदालत जाथे,</para>
  <para style="q2" vid="PRO 29:9">त मुरूख मनखे ह गुस्सा करथे अऊ मजाक उड़ाथे, अऊ उहां सांति नइं रहय।<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />खून करइया मनखेमन ईमानदार मनखे ले घिन करथें</para>
  <para style="q2" vid="PRO 29:10">अऊ ओमन सीधवा मनखे के परान के खोज म रहिथें।<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />मुरूख मनखेमन अपन गुस्सा ला पूरा परगट करथें,</para>
  <para style="q2" vid="PRO 29:11">पर बुद्धिमान मनखेमन आखिरी म सांति लाथें।<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />यदि कोनो सासन करइया ह लबारी बात ऊपर कान लगाथे,</para>
  <para style="q2" vid="PRO 29:12">त ओकर जम्मो करमचारीमन दुस्ट हो जाथें।<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />गरीब अऊ अतियाचारी मनखे म एक बात समान्य हवय:</para>
  <para style="q2" vid="PRO 29:13">यहोवा ह दूनों के आंखी म रोसनी देथे।<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />यदि कोनो राजा ह गरीब के सही नियाय करथे,</para>
  <para style="q2" vid="PRO 29:14">त ओकर सिंघासन ह सदा बने रहिही।<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />छड़ी अऊ डांट खाय ले बुद्धि मिलथे,</para>
  <para style="q2" vid="PRO 29:15">पर जऊन लइका ला अनुसासित नइं करे जावय, ओह अपन दाई के बेजत्ती के कारन होथे।<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />जब दुस्टमन बढ़थें, त पाप ह घलो बढ़थे,</para>
  <para style="q2" vid="PRO 29:16">पर धरमीमन ओमन के गिरे दसा ला देखहीं।<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />अपन लइकामन ला अनुसासित करव, अऊ ओमन तुमन ला सांति दीहीं;</para>
  <para style="q2" vid="PRO 29:17">ओमन तुम्हर ईछा मुताबिक तुमन ला खुसी दीहीं।<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />जिहां अगम के बारे म दरसन के बात नइं होवय, उहां मनखेमन निरंकुस हो जाथें;</para>
  <para style="q2" vid="PRO 29:18">पर धइन ए ओ, जऊन ह बुद्धि के बात<note caller="+" style="f"><char style="fr" closed="false">29:18 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कानून</char></note> ऊपर धियान देथे।<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />सेवकमन ला सिरिप बात के दुवारा सुधारे नइं जा सकय;</para>
  <para style="q2" vid="PRO 29:19">हालाकि ओमन समझथें, पर ओमन जबाब नइं देवंय।<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />का तेंह अइसने मनखे ला देखथस, जऊन ह उतावली म गोठियाथे?</para>
  <para style="q2" vid="PRO 29:20">ओकर ले जादा कोनो मुरूख ले आसा करे जा सकथे।<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />जऊन सेवक ला ओकर लइकापन ले बहुंत खवाय-पीयाय जाथे,</para>
  <para style="q2" vid="PRO 29:21">ओह आखिरी म ढीठ हो जाथे।<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />गुस्सा करइया मनखे ह झगरा ला बढ़ाथे,</para>
  <para style="q2" vid="PRO 29:22">अऊ तुरते गुस्सा होवइया मनखे ह बहुंत पाप करथे।<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />घमंड ह मनखे ला नीचा देखाथे,</para>
  <para style="q2" vid="PRO 29:23">पर नम्र आतमावाला ह आदर पाथे।<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />चोरमन के सहभागीमन अपन खुद के बईरी होथें;</para>
  <para style="q2" vid="PRO 29:24">ओमन किरिया खाके घलो गवाही नइं देवंय।<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />मनखे के भय ह एक फांदा साबित होथे,</para>
  <para style="q2" vid="PRO 29:25">पर जऊन ह यहोवा ऊपर भरोसा रखथे, ओह सुरकछित रहिथे।<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />बहुंत जन सासन करइया ले भेंट करे बर चाहथें,</para>
  <para style="q2" vid="PRO 29:26">पर मनखे ला नियाय यहोवा ले ही मिलथे।<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />धरमी मनखे ह बेईमान मनखे ले घिन करथे;</para>
  <para style="q2" vid="PRO 29:27">अऊ दुस्ट मनखे ह ईमानदार मनखे ले घिन करथे।<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="ms1">आगूर के कहावत</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />याके के बेटा आगूर के कहावत—एक परभावसाली बचन।</para>
  <para style="q1" vid="PRO 30:1">ये मनखे के बचन ईतीएल अऊ उकाल ला:</para>
  <para style="b" vid="PRO 30:1" />
  <para style="q1" vid="PRO 30:1">हे परमेसर, मेंह थक गे हंव,</para>
  <para style="q2" vid="PRO 30:1">पर मेंह जय पा सकत हंव।<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />खचित मेंह मनखे नइं, सिरिप एक पसु के सहीं अंव;</para>
  <para style="q2" vid="PRO 30:2">मोर करा मनखे के समझ नइं ए।<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />मेंह बुद्धि के बात नइं सीखे हंव,</para>
  <para style="q2" vid="PRO 30:3">अऊ न ही पबितर परमेसर के गियान ला मेंह पाय हंव।<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />कोन ह स्वरग ऊपर जाके खाल्हे उतरिस?</para>
  <para style="q2" vid="PRO 30:4">कोन ह अपन हांथ म हवा ला संकेले हवय?</para>
  <para style="q1" vid="PRO 30:4">कोन ह पानी ला कपड़ा म लपेटे हवय?</para>
  <para style="q2" vid="PRO 30:4">कोन ह धरती के जम्मो छोरमन ला कायम करे हवय?</para>
  <para style="q1" vid="PRO 30:4">ओकर का नांव ए, अऊ ओकर बेटा के का नांव ए?</para>
  <para style="q2" vid="PRO 30:4">खचित तेंह जानत हस!<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />“परमेसर के हर एक बचन बिगर गलती के हवय;</para>
  <para style="q2" vid="PRO 30:5">ओह ओमन बर एक ढाल सहीं अय, जऊन मन ओकर करा सरन लेथें।<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />ओकर बचन म कुछू झन जोड़व,</para>
  <para style="q2" vid="PRO 30:6">नइं तो ओह तोला डांटही अऊ तोला लबरा ठहिराही।<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />“हे यहोवा, मेंह तोर ले दू ठन चीज मांगत हंव;</para>
  <para style="q2" vid="PRO 30:7">मोर मरे के पहिली मोला मना झन कर:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />लबरापन अऊ लबरा गोठ ला मोर ले दूरिहा रख;</para>
  <para style="q2" vid="PRO 30:8">मोला न तो गरीब बना अऊ न ही धनी,</para>
  <para style="q2" vid="PRO 30:8">पर मोला सिरिप हर दिन के जेवन दे।<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />अइसने झन होवय कि मोर करा जादा हो जावय अऊ मेंह तोर अनादर करंव</para>
  <para style="q2" vid="PRO 30:9">अऊ कहंव, ‘यहोवा ह कोन ए?’</para>
  <para style="q1" vid="PRO 30:9">या मेंह गरीब हो जावंव अऊ चोरी करंव,</para>
  <para style="q2" vid="PRO 30:9">अऊ ये किसम ले अपन परमेसर के नांव के अनादर करंव।<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />“कोनो सेवक के निन्दा ओकर मालिक के आघू म झन करबे,</para>
  <para style="q2" vid="PRO 30:10">नइं तो ओह तोला सराप दीही, अऊ तोला येकर कीमत चुकाना पड़ही।<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />“अइसने मनखे हवंय, जऊन मन अपन ददा ला सराप देथें</para>
  <para style="q2" vid="PRO 30:11">अऊ अपन दाई ला आसीस नइं देवंय;<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />अइसने मनखे हवंय, जऊन मन अपन ही नजर म सुध अंय</para>
  <para style="q2" vid="PRO 30:12">पर ओमन के गंदगी साफ नइं होय हवय;<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />अइसने मनखे हवंय, जऊन मन के आंखी ह घमंड ले भरे हवय,</para>
  <para style="q2" vid="PRO 30:13">जऊन मन आने मन ला तुछ नजर ले देखथें;<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />अइसने मनखे हवंय, जऊन मन के दांतमन तलवार सहीं</para>
  <para style="q2" vid="PRO 30:14">अऊ जबड़ामन छुरी सहीं हवंय</para>
  <para style="q1" vid="PRO 30:14">ताकि ओमन गरीबमन ला धरती ले</para>
  <para style="q2" vid="PRO 30:14">अऊ जरूरतमंद मनखेमन ला मानव-जाति ले नास कर देवंय।<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />“जोंक के दू झन बेटी हवंय।</para>
  <para style="q2" vid="PRO 30:15">ओमन चिचियाके कहिथें, ‘दे! दे!’</para>
  <para style="b" vid="PRO 30:15" />
  <para style="li1" vid="PRO 30:15">“तीन ठन चीज हवंय, जऊन मन कभू संतोस नइं होवंय,</para>
  <para style="li2" vid="PRO 30:15">अऊ चार ठन चीज हवंय, जऊन मन कभू नइं कहंय, ‘बस कर!’:<verse eid="PRO 30:15" /></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16" />कबर,</para>
  <para style="li3" vid="PRO 30:16">ठड़गी के कोख,</para>
  <para style="li3" vid="PRO 30:16">भुइयां, जऊन ह पानी ले कभू संतोस नइं होवय,</para>
  <para style="li3" vid="PRO 30:16">अऊ आगी, जऊन ह कभू नइं कहय, ‘परयाप्त!’<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />“ओ आंखी जऊन ह अपन ददा के मजाक उड़ाथे,</para>
  <para style="q2" vid="PRO 30:17">अऊ अपन डोकरी दाई के तिरस्कार करथे,</para>
  <para style="q1" vid="PRO 30:17">ओ आंखी ला घाटी के कऊआमन फोरके निकाल दीहीं,</para>
  <para style="q2" vid="PRO 30:17">अऊ गिधवामन ओला खा लीहीं।<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18" />“तीन चीज हवंय, जेमन मोला बहुंत अद्भूत लगथें,</para>
  <para style="li2" vid="PRO 30:18">अऊ चार चीज हवंय, जेमन ला मेंह नइं समझंव:<verse eid="PRO 30:18" /></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19" />अकास म गिधवा के रसता,</para>
  <para style="li3" vid="PRO 30:19">पथरा म सांप के रसता,</para>
  <para style="li3" vid="PRO 30:19">समुंदर म पानी जहाज के रसता,</para>
  <para style="li3" vid="PRO 30:19">अऊ एक जवान माईलोगन के संग एक मनखे के रसता।<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />“एक छिनार माईलोगन के रसता ये अय:</para>
  <para style="q2" vid="PRO 30:20">ओह खाथे अऊ अपन मुहूं ला पोंछथे</para>
  <para style="q2" vid="PRO 30:20">अऊ कहिथे, ‘मेंह कुछू गलत नइं करे हंव।’<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21" />“तीन चीज के कारन धरती ह कांपथे,</para>
  <para style="li2" vid="PRO 30:21">पर चार चीज हवंय, जेला सहन नइं करे जा सकय:<verse eid="PRO 30:21" /></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22" />एक सेवक, जऊन ह राजा बन जाथे,</para>
  <para style="li3" vid="PRO 30:22">एक भक्तिहीन मुरूख, जऊन ह बहुंत खाय बर पाथे,<verse eid="PRO 30:22" /></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23" />एक तुछ माईलोगन, जऊन ह बिहाव करथे,</para>
  <para style="li3" vid="PRO 30:23">अऊ एक सेविका, जऊन ह अपन मालकिन के जगह ले लेथे।<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24" />“धरती म चार चीज छोटे हवंय,</para>
  <para style="li2" vid="PRO 30:24">तभो ले ओमन बहुंत जादा बुद्धिमान होथें:<verse eid="PRO 30:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25" />चांटीमन कम ताकतवाले जीव होथें,</para>
  <para style="li3" vid="PRO 30:25">तभो ले ओमन अपन जेवन गरमी के महिना म कुढ़ोथें;<verse eid="PRO 30:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26" />बिज्जूमन कम सक्तिवाले जन्तु होथें,</para>
  <para style="li3" vid="PRO 30:26">तभो ले ओमन पथरा के चट्टान म अपन घर बनाथें;<verse eid="PRO 30:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27" />फांफामन के राजा नइं होवय,</para>
  <para style="li3" vid="PRO 30:27">तभो ले ओमन सेना के सहीं कतार बनाके एक संग आघू बढ़थें;<verse eid="PRO 30:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28" />एक छिपकली ला हांथ ले धरे जा सकथे,</para>
  <para style="li3" vid="PRO 30:28">तभो ले येह राजा के महल म पाय जाथे।<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29" />“तीन चीज हवंय, जेमन के चाल ह परभावसाली होथे,</para>
  <para style="li2" vid="PRO 30:29">पर चार चीज हवंय, जेमन के बरताव ह परभावसाली होथे:<verse eid="PRO 30:29" /></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30" />एक सेर, जऊन ह पसुमन म बलवान होथे, ओह काकरो आघू ले डरके नइं हटय;<verse eid="PRO 30:30" /></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31" />एक अकड़के चलइया मुरगा,</para>
  <para style="li3" vid="PRO 30:31">एक बोकरा,</para>
  <para style="li3" vid="PRO 30:31">अऊ एक राजा, जऊन ह बिदरोह ले सुरकछित रहिथे।<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />“यदि तेंह मुरूखता करके अपन बड़ई करथस,</para>
  <para style="q2" vid="PRO 30:32">या यदि तेंह दुस्ट काम करे के योजना बनाय हस,</para>
  <para style="q2" vid="PRO 30:32">त अपन मुहूं ऊपर हांथ रख!<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />काबरकि जइसने दूध ला मथे ले मक्खन बनथे,</para>
  <para style="q2" vid="PRO 30:33">अऊ जइसने नाक ला मरोड़े ले खून निकलथे,</para>
  <para style="q2" vid="PRO 30:33">वइसने ही गुस्सा के भड़के ले झगरा होथे।”<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="ms1">लेमूएल राजा के कहावत</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />लेमूएल राजा के कहावत—एक परभावसाली बचन, जऊन ला ओकर दाई ह ओला सिखोईस।<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />सुन, हे मोर बेटा! सुन, हे मोर कोख के बेटा!</para>
  <para style="q2" vid="PRO 31:2">सुन, हे मोर बेटा, तेंह मोर पराथना के जबाब अस!<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />अपन ताकत<note caller="+" style="f"><char style="fr" closed="false">31:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">धन</char></note> ला माईलोगन ऊपर झन लगा,</para>
  <para style="q2" vid="PRO 31:3">अऊ न ही अपन बल के उपयोग ओमन बर करबे, जऊन मन राजामन ला नास करथें।<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />हे लेमूएल, येह राजामन बर नो हय,</para>
  <para style="q2" vid="PRO 31:4">अंगूर के मंद पीयई राजामन बर ठीक नो हय,</para>
  <para style="q2" vid="PRO 31:4">अऊ न ही सासन करइयामन बर मंद के लालसा करना बने अय,<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />नइं तो ओमन पीके कानून ला भुला जाहीं,</para>
  <para style="q2" vid="PRO 31:5">अऊ जम्मो दुखी मनखेमन के हक ला मारहीं।<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />मंद ह ओमन बर होवय, जऊन मन नास होवथें,</para>
  <para style="q2" vid="PRO 31:6">अऊ अंगूर के मंद ओमन बर अय, जेमन के मन ह उदास हवय!<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />ओमन पीयंय अऊ अपन गरीबी ला भुला जावंय</para>
  <para style="q2" vid="PRO 31:7">अऊ अपन दुख ला सुरता झन करंय।<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />जऊन मन अपन बर नइं गोठिया सकंय, ओमन बर गोठिया,</para>
  <para style="q2" vid="PRO 31:8">ओमन के अधिकार बर, जऊन मन गरीब-अनाथ अंय।<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />गोठिया अऊ सही नियाय कर;</para>
  <para style="q2" vid="PRO 31:9">गरीब अऊ जरूरतमंद मनखेमन के अधिकार के बचाव कर।<verse eid="PRO 31:9" /></para>
  <para style="ms1">उपसंहार: उत्तम चालचलनवाली घरवाली</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />उत्तम चालचलन के घरवाली कोन पा सकथे?</para>
  <para style="q2" vid="PRO 31:10">ओकर कीमत मनि ले घलो बहुंत जादा होथे।<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />ओकर घरवाला ला ओकर ऊपर पूरा भरोसा रहिथे</para>
  <para style="q2" vid="PRO 31:11">अऊ ओला कोनो बने चीज के घटी नइं होवय।<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />ओह अपन जिनगी भर अपन घरवाला बर</para>
  <para style="q2" vid="PRO 31:12">भलई के काम करथे, बुरई के नइं।<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />ओह ऊन अऊ सन छांटथे</para>
  <para style="q2" vid="PRO 31:13">अऊ खुस होके अपन हांथ ले काम करथे।<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />ओह बेपारी जहाज के सहीं</para>
  <para style="q2" vid="PRO 31:14">अपन जेवन दूरिहा ले लानथे।<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />ओह रथिया के रहत उठ जाथे;</para>
  <para style="q2" vid="PRO 31:15">ओह अपन परिवार के जेवन के परबंध करथे</para>
  <para style="q2" vid="PRO 31:15">अऊ अपन सेविकामन ला घलो ओमन के हिस्सा देथे।<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />ओह कोनो खेत ला सोच-बिचार करके बिसाथे;</para>
  <para style="q2" vid="PRO 31:16">ओह अपन कमई ले अंगूर के बारी लगाथे।<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />ओह मेहनत से अपन काम ला जमाथे;</para>
  <para style="q2" vid="PRO 31:17">ओकर हांथमन ओकर काम बर मजबूत होथें।<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />ओह ये बात के धियान रखथे कि ओला ओकर काम-धंधा म लाभ मिलय,</para>
  <para style="q2" vid="PRO 31:18">अऊ रथिया ओकर दीया ह झन बुतावय।<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />ओह अटेरन ला अपन हांथ म धरथे</para>
  <para style="q2" vid="PRO 31:19">अऊ चरखा के धुरा ला अपन अंगरी म पकड़थे।<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />ओह गरीबमन के मदद करे बर अपन हांथ खोलथे</para>
  <para style="q2" vid="PRO 31:20">अऊ जरूरतमंद मनखे बर अपन हांथ बढ़ाथे।<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />जब बरफ गिरथे, त ओला अपन परिवार के चिंता करे के जरूरत नइं रहय;</para>
  <para style="q2" vid="PRO 31:21">काबरकि परिवार के जम्मो झन गरम कपड़ा पहिरे रहिथें।<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />ओह अपन बिस्तर बर चादर बनाथे;</para>
  <para style="q2" vid="PRO 31:22">ओह सुघर सन के बने अऊ बैंगनी कपड़ा पहिरथे।<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />सहर के दुवार<note caller="+" style="f"><char style="fr" closed="false">31:23 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मनखेमन के इकट्ठा होय के जगह</char></note> म ओकर घरवाला के आदर होथे,</para>
  <para style="q2" vid="PRO 31:23">जिहां ओह देस<note caller="+" style="f"><char style="fr" closed="false">31:23 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सहर या इलाका</char></note> के अगुवामन के बीच म बईठथे।<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />ओह सन के कपड़ा बनाके बेचथे,</para>
  <para style="q2" vid="PRO 31:24">अऊ बेपारीमन ला बेचे बर दुपट्टा देथे।<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />ओह बल अऊ सम्मान के पहिरावा पहिरे रहिथे;</para>
  <para style="q2" vid="PRO 31:25">ओह अवइया समय ऊपर हंस सकथे।<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />ओह बुद्धि के संग गोठियाथे,</para>
  <para style="q2" vid="PRO 31:26">अऊ ओकर मुहूं ले सच्चई के सिकछा निकलथे।<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />ओह अपन घर के कामकाज ऊपर नजर रखथे</para>
  <para style="q2" vid="PRO 31:27">अऊ बिगर मेहनत के रोटी नइं खावय।<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />ओकर लइकामन उठके ओला धइन कहिथें;</para>
  <para style="q2" vid="PRO 31:28">ओकर घरवाला घलो ओला आसीसित कहिथे, अऊ ये कहिके ओकर परसंसा करथे:<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />“कतको माईलोगनमन उत्तम काम करथें,</para>
  <para style="q2" vid="PRO 31:29">पर तेंह ओ जम्मो ले बढ़के करथस।”<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />आकरसन ह धोखा देवइया ए अऊ सुन्दरता ह गायब हो जाथे;</para>
  <para style="q2" vid="PRO 31:30">पर जऊन माईलोगन ह यहोवा के भय मानथे, ओकर परसंसा होथे।<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />ओह जऊन काम करे हवय, ओ जम्मो बर ओकर आदर करव,</para>
  <para style="q2" vid="PRO 31:31">अऊ ओकर काम के कारन सहर के दुवार म ओकर परसंसा होवय।<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>