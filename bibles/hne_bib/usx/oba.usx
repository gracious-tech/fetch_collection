<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">ओबदयाह</para>
  <para style="toc1">ओबदयाह के किताब</para>
  <para style="toc2">ओबदयाह</para>
  <para style="toc3">ओब</para>
  <para style="mt1">ओबदयाह</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="s1">ओबदयाह के दरसन</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />ओबदयाह के दरसन।</para>
  <para style="b" vid="OBA 1:1" />
  <para style="b" vid="OBA 1:1" />
  <para style="p" vid="OBA 1:1">एदोम देस के बारे म परमपरधान यहोवा ह ये कहत हे—</para>
  <para style="q1" vid="OBA 1:1">हमन यहोवा ले एक संदेस सुने हन:</para>
  <para style="q2" vid="OBA 1:1">जाति-जाति के मनखेमन ला ये कहे बर एक दूत पठोय गीस,</para>
  <para style="q1" vid="OBA 1:1">“उठव, आवव, हमन ओकर ले लड़ई करे बर जावन।”<verse eid="OBA 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />“देख, मेंह जाति-जाति के बीच म तोला छोटे बना दूहूं;</para>
  <para style="q2" vid="OBA 1:2">तेंह बहुंते तुछ समझे जाबे।<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />तोर मन के घमंड ह तोला धोखा दे हवय,</para>
  <para style="q2" vid="OBA 1:3">तें, जऊन ह चट्टानमन के दरार म रहिथस</para>
  <para style="q2" vid="OBA 1:3">अऊ अपन घर ऊंचहा जगह म बनाथस,</para>
  <para style="q1" vid="OBA 1:3">तें, जऊन ह अपनआप ले कहिथस,</para>
  <para style="q2" vid="OBA 1:3">‘कोन ह मोला खाल्हे भुइयां म ला सकत हे?’<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />हालाकि तें गिधवा के सहीं ऊंचई म उड़ियाथस</para>
  <para style="q2" vid="OBA 1:4">अऊ तारामन के बीच म अपन खोंधरा बनाथस,</para>
  <para style="q2" vid="OBA 1:4">पर उहां ले मेंह तोला खाल्हे ले आहूं,”</para>
  <para style="q2" vid="OBA 1:4">यहोवा ह घोसना करत हे।<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />“यदि चोरमन तोर करा आतिन,</para>
  <para style="q2" vid="OBA 1:5">यदि डाकूमन रथिया आतिन—</para>
  <para style="q1" vid="OBA 1:5">ओहो, तोर कतेक बिनास होनेवाला हे!—</para>
  <para style="q2" vid="OBA 1:5">त का ओमन जतेक चाहतिन ओतेक चोराके नइं ले जातिन?</para>
  <para style="q1" vid="OBA 1:5">यदि अंगूर टोरइयामन तोर करा आतिन,</para>
  <para style="q2" vid="OBA 1:5">त का ओमन कुछू अंगूर ला नइं छोंड़ जातिन?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />पर एसाव ला कइसे लूटे जाही,</para>
  <para style="q2" vid="OBA 1:6">ओकर लुकाय खजाना ला कइसे खोज निकाले गीस!<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />तोर सबो संगी राज के मन तोला सीमना तक भगा दीहीं;</para>
  <para style="q2" vid="OBA 1:7">तोर संगीमन तोला धोखा दीहीं अऊ तोर ऊपर अपन अधिकार कर लीहीं;</para>
  <para style="q1" vid="OBA 1:7">जेमन तोर रोटी खाथें, ओमन तोर बर फांदा लगाहीं,</para>
  <para style="q2" vid="OBA 1:7">पर तेंह ओकर पता नइं पाबे।”<verse eid="OBA 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />यहोवा ह घोसना करत हे, “ओ दिन,</para>
  <para style="q2" vid="OBA 1:8">का मेंह एदोम के बुद्धिमान मनखेमन ला,</para>
  <para style="q2" vid="OBA 1:8">जऊन मन एसाव के पहाड़मन म समझदार अंय, ओमन ला नास नइं करहूं?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />हे तेमान,<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">तेमान </char><char style="ft" closed="false">इहां येह पूरा देस ला देखाथे</char></note> तोर सूरबीरमन डरा जाहीं,</para>
  <para style="q2" vid="OBA 1:9">अऊ एसाव के पहाड़मन म हर एक झन ला</para>
  <para style="q2" vid="OBA 1:9">घात करके काट डारे जाही।<verse eid="OBA 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />तोर भाई याकूब के बिरूध हिंसा के कारन,</para>
  <para style="q2" vid="OBA 1:10">तेंह सरम से भर जाबे;</para>
  <para style="q2" vid="OBA 1:10">तेंह हमेसा बर नास हो जाबे।<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />ओ दिन तें अलग खड़े होके देखत रहय</para>
  <para style="q2" vid="OBA 1:11">जब अजनबीमन ओकर धन-संपत्ति ला छीनके ले गीन</para>
  <para style="q1" vid="OBA 1:11">अऊ परदेसीमन ओकर दुवारी ले घुसरके</para>
  <para style="q2" vid="OBA 1:11">यरूसलेम बर चिट्ठी डारिन,</para>
  <para style="q2" vid="OBA 1:11">तेंह ओमा के एक झन सहीं रहय।<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />तेंह अपन भाई के दुरदसा के समय म</para>
  <para style="q2" vid="OBA 1:12">ओकर ऊपर आनंद झन मनाबे,</para>
  <para style="q1" vid="OBA 1:12">न ही यहूदा के मनखेमन के बिनास के समय म</para>
  <para style="q2" vid="OBA 1:12">ओमन ऊपर आनंदित होबे,</para>
  <para style="q1" vid="OBA 1:12">न ही ओमन के संकट के समय म,</para>
  <para style="q2" vid="OBA 1:12">बहुंत घमंड करबे।<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />मोर मनखेमन के संकट के समय म</para>
  <para style="q2" vid="OBA 1:13">तें ओमन के दुवारमन<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">सहर के दुवारमन</char></note> ले होके आघू झन बढ़बे,</para>
  <para style="q1" vid="OBA 1:13">न ही ओमन के बिपत्ति के समय</para>
  <para style="q2" vid="OBA 1:13">या ओमन के मुसीबत के बेरा ओमन ला खराप नजर से देखबे,</para>
  <para style="q1" vid="OBA 1:13">न ही ओमन के बिपत्ति के समय</para>
  <para style="q2" vid="OBA 1:13">ओमन के संपत्ति ऊपर कब्जा करबे।<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />ओमन के भगोड़ामन ला मार डारे बर</para>
  <para style="q2" vid="OBA 1:14">तेंह चऊकमन म झन अगोरबे</para>
  <para style="q1" vid="OBA 1:14">न ही संकट के समय म ओमन के बांचे मनखेमन ला</para>
  <para style="q2" vid="OBA 1:14">बईरीमन के हांथ म पकड़वाबे।<verse eid="OBA 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />“सबो जाति के मनखेमन बर</para>
  <para style="q2" vid="OBA 1:15">यहोवा के दिन ह लकठा म हवय।</para>
  <para style="q1" vid="OBA 1:15">जइसन तेंह करे हस, वइसन तोर संग घलो करे जाही;</para>
  <para style="q2" vid="OBA 1:15">तोर करे गय दुस्ट काममन तोरेच मुड़ ऊपर आ जाहीं।<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />जइसने तेंह मोर पबितर पहाड़ ऊपर पीये,</para>
  <para style="q2" vid="OBA 1:16">वइसनेच सबो जाति के मनखेमन लगातार पीयत रहिहीं;</para>
  <para style="q1" vid="OBA 1:16">ओमन पीते अऊ पीते रहिहीं</para>
  <para style="q2" vid="OBA 1:16">अऊ अइसन हो जाहीं, जइसन ओमन कभू नइं होय रिहिन।<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />पर सियोन पहाड़ ऊपर छुटकारा होही;</para>
  <para style="q2" vid="OBA 1:17">ओह पबितर होही,</para>
  <para style="q2" vid="OBA 1:17">अऊ याकूब के बंसजमन अपन निज भाग ऊपर अधिकार करहीं।<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />अऊ याकूब के घराना ह एक आगी</para>
  <para style="q2" vid="OBA 1:18">अऊ यूसुफ के घराना ह एक जुवाला सहीं होही;</para>
  <para style="q1" vid="OBA 1:18">एसाव के घराना ह भूंसा सहीं होही,</para>
  <para style="q2" vid="OBA 1:18">अऊ ओमन ओमा आगी लगाके ओला नास कर दीहीं।</para>
  <para style="q1" vid="OBA 1:18">एसाव के घराना के</para>
  <para style="q2" vid="OBA 1:18">कोनो नइं बांचहीं।”</para>
  <para style="q1" vid="OBA 1:18">यहोवा ह कहे हवय।<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />नेगेव के मनखेमन आके</para>
  <para style="q2" vid="OBA 1:19">एसाव के पहाड़मन ऊपर अधिकार कर लीहीं,</para>
  <para style="q1" vid="OBA 1:19">अऊ खाल्हे राज के मनखेमन</para>
  <para style="q2" vid="OBA 1:19">पलिस्तीमन के देस ऊपर अधिकार कर लीहीं।</para>
  <para style="q1" vid="OBA 1:19">ओमन एपरैम अऊ सामरिया के खेतमन ऊपर अधिकार कर लीहीं,</para>
  <para style="q2" vid="OBA 1:19">अऊ बिनयामीनीमन गिलाद ऊपर अधिकार कर लीहीं।<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />कनान म रहइया इसरायली बंधुवामन के ये दल ह</para>
  <para style="q2" vid="OBA 1:20">देस ऊपर सारपत नगर तक अधिकार कर लीही;</para>
  <para style="q1" vid="OBA 1:20">सपाराद म रहइया यरूसलेम के बंधुवामन</para>
  <para style="q2" vid="OBA 1:20">नेगेव के नगरमन ऊपर अधिकार कर लीहीं।<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />छुड़ानेवालामन एसाव के पहाड़मन ऊपर सासन करे बर</para>
  <para style="q2" vid="OBA 1:21">सियोन पहाड़ ऊपर चघहीं।</para>
  <para style="q2" vid="OBA 1:21">अऊ राज ह यहोवा के हो जाही।<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>