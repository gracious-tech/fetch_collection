<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">दानिएल</para>
  <para style="toc1">दानिएल के किताब</para>
  <para style="toc2">दानिएल</para>
  <para style="toc3">दानि</para>
  <para style="mt1">दानिएल</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s1">बेबिलोन म दानिएल ला सिकछा दिये जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />यहूदा प्रदेस के राजा यहोयाकीम के राज के तीसरा बछर म बेबिलोन के राजा नबूकदनेसर ह आईस अऊ यरूसलेम सहर ला घेर लीस। <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" />अऊ परभू ह यहूदा के राजा यहोयाकीम ला परमेसर के मंदिर के कुछू चीजमन के संग नबूकदनेसर के अधीन कर दीस। ये चीजमन ला ओह बेबिलोनिया<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">सिनार</char></note> देस म अपन देवता के मंदिर म ले गीस अऊ ओमन ला अपन देवता के खजाना घर म रख दीस।<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="2CH 36:7">2 इति 36:7</ref></char></char></note><verse eid="DAN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 1:3" />तब राजा ह अपन दरबार के मुखिया अधिकारी असपनाज ला हुकूम दीस कि राज-परिवार अऊ उच्च कुल के कुछू इसरायलीमन ला राजा के सेवा म लाने जावय— <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />येमन अइसन जवान होवंय, जेमन के देहें निरदोस, सुन्दर होवय; ओमन म हर किसम के बात सीखे के योग्यता दिखय; बने जानकार होवंय; बात ला तुरते समझंय, अऊ ओमन म राजा के महल म सेवा करे के योग्यता होवय। राजा ह मुखिया ला हुकूम दीस कि ओह येमन ला बेबिलोनीमन के भासा अऊ साहित्य सिखावय। <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />राजा ह हुकूम दीस कि ओकर खुद के जेवन अऊ मंद म ले ओमन ला हर दिन खाय-पीये बर दिये जावय। ओमन ला तीन बछर तक ट्रेनिंग दिये जावय, अऊ ओकर बाद ओमन ला राजा के सेवा म लाने जावय।<verse eid="DAN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 1:6" />जऊन मन चुने गे रिहिन, ओमन म कुछू यहूदा के बंस के रिहिन: दानिएल, हननयाह, मिसाएल अऊ अजरयाह। <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />मुखिया अधिकारी ह ओमन ला नवां नांव दीस: दानिएल ला बेलतसस्सर, हननयाह ला सदरक, मिसाएल ला मेसक अऊ अजरयाह ला अबेदनगो नांव दीस।<verse eid="DAN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8" />पर दानिएल ह ठान लीस कि ओह राजसाही जेवन अऊ मंद के दुवारा अपनआप ला असुध नइं करही, अऊ ये किसम ले अपनआप ला असुध नइं करे बर ओह मुखिया अधिकारी ले अनुमति मांगिस। <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />परमेसर ह अधिकारी के मन ला अइसने कर दीस कि ओह दानिएल ऊपर दया अऊ सहानुभूति दिखावय, <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />पर अधिकारी ह दानिएल ला कहिस, “मोला अपन परभू राजा के डर हवय, जऊन ह तुम्हर खाय-पीये के चीजमन ला ठहिराय हवय। अइसने झन होवय कि ओह तुमन ला तुम्हर उमर के आने जवानमन ले कमजोर देखय, अऊ तब तुम्हर कारन, राजा ह मोला मार डारय।”<verse eid="DAN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 1:11" />तब दानिएल ह ओ पहरेदार ले कहिस, जऊन ला मुखिया अधिकारी ह दानिएल, हननयाह, मिसाएल अऊ अजरयाह के देखभाल करे बर ठहिराय रिहिस, <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />“किरपा करके तेंह दस दिन तक अपन सेवकमन ला परखके देख: हमन ला खाय-पीये बर सिरिप साकाहारी भोजन अऊ पानी के अलावा कुछू अऊ झन दे। <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />तब हमर देहें ले ओ जवानमन के तुलना करे जावय, जऊन मन राजसाही भोजन खाथें, अऊ ओकर बाद जऊन कुछू तोला दिखय, ओकर मुताबिक अपन सेवकमन संग बरताव कर।” <verse eid="DAN 1:13" /><verse number="14" style="v" sid="DAN 1:14" />पहरेदार ह ओकर बात ला मान लीस अऊ ओह दस दिन तक ओमन ला परखके देखिस।<verse eid="DAN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 1:15" />दस दिन के बाद, ओमन ओ जवानमन ले जादा स्वस्थ अऊ पुस्ट दिखिन, जऊन मन राजसाही भोजन खावत रिहिन। <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />एकरसेति पहरेदार ह ओमन बर ठहिराय उत्तम भोजन अऊ मंद ला हटा लीस अऊ बदले म, ओमन ला साकाहारी भोजन दीस।<verse eid="DAN 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17" />ये चारों जवान ला परमेसर ह जम्मो किसम के साहित्य अऊ विद्या के गियान अऊ समझ दीस। अऊ दानिएल ह जम्मो किसम के दरसन अऊ सपना ला समझ लेवत रिहिस।<verse eid="DAN 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18" />तब जतेक समय बाद, राजा ह ओ जवानमन ला अपन सेवा म लाने बर कहे रिहिस, ओ समय पूरा होय के बाद, मुखिया अधिकारी ह ओमन ला नबूकदनेसर के आघू म लानिस। <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />राजा ह ओ जवानमन ले बातचीत करिस अऊ ओह दानिएल, हननयाह, मिसाएल अऊ अजरयाह के बराबर अऊ कोनो जवान ला नइं पाईस; एकरसेति ओमन राजा के सेवा म चुन लिये गीन। <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />बुद्धि अऊ समझ के हर बात म, राजा ह ओमन ले जतेक सवाल करिस, ओमा ओमन राजा के जम्मो राज के सब जादूगर अऊ टोनहामन ले दस गुना जादा बने पाय गीन।<verse eid="DAN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 1:21" />अऊ दानिएल ह कुसरू राजा के राज के पहिले बछर तक उहां सेवा करते रिहिस।<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s1">नबूकदनेसर के सपना</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />नबूकदनेसर ह अपन राज के दूसरा बछर म सपना देखिस; जेकर ले ओकर मन ह बियाकुल हो गीस अऊ ओह सुते नइं सकिस। <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />एकरसेति राजा ह जादूगर, टोनहा, तांत्रिक अऊ जोतिसीमन<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> ला बलाईस ताकि ओमन आके बतावंय कि राजा ह का सपना देखे हवय। जब ओमन आईन अऊ राजा के आघू म ठाढ़ होईन, <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />त राजा ह ओमन ले कहिस, “मेंह एक सपना देखे हंव, जेह मोला बियाकुल करत हे अऊ मेंह जाने चाहत हंव कि येकर का मतलब ए।”<verse eid="DAN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 2:4" />तब जोतिसीमन राजा ला जबाब दीन, “राजा चिरंजीवी होवय! तेंह अपन सपना अपन सेवकमन ला बता, अऊ हमन ओकर अर्थ बताबो।”<verse eid="DAN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 2:5" />राजा ह जोतिसीमन ला जबाब दीस, “मेंह ये ठान ले हंव: यदि तुमन मोला मोर सपना समेत ओकर अर्थ नइं बताहू, त मेंह तुम्हर कुटा-कुटा कर दूहूं अऊ तुम्हर घरमन ला कचरा के कुढ़ा म बदल दूहूं <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />पर यदि तुमन मोला सपना ला बताके ओकर अर्थ घलो बताथव, त तुमन मोर ले उपहार अऊ ईनाम अऊ बहुंत आदरमान पाहू। एकरसेति तुमन मोला सपना बतावव अऊ ओकर अर्थ घलो बतावव।”<verse eid="DAN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7" />एक बार फेर ओमन कहिन, “राजा ह अपन सपना अपन सेवकमन ला बतावय, अऊ हमन ओकर अर्थ बताबो।”<verse eid="DAN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8" />तब राजा ह जबाब दीस, “मोला निस्चय हो गे हवय कि तुमन समय ला टारे के कोसिस करत हव, काबरकि तुमन समझ गे हव कि मेंह ये ठान ले हंव: <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />यदि तुमन मोला सपना नइं बतात हव, त फेर तुम्हर बर सिरिप एकेच दंड हवय। ये आसा करत कि परिस्थिति ह बदलही, तुमन मोर ले गलत अऊ खराप बात कहे के सडयंत्र रचे हव। एकरसेति अब, तुमन मोला मोर सपना बतावव, अऊ तब मेंह जानहूं कि तुमन मोला ओ सपना के अर्थ घलो बता सकत हव।”<verse eid="DAN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10" />जोतिसीमन राजा ला जबाब दीन, “धरती म अइसने कोनो मनखे नइं ए, जऊन ह राजा के दुवारा कहे गय काम ला कर सकय! पर तभो ले, न तो कोनो बड़े अऊ सक्तिसाली राजा ह कोनो जादूगर या टोनहा या जोतिसी ले कभू ये किसम के कोनो बात पुछे हवय। <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />जऊन बात राजा ह पुछत हे, ओह बहुंत कठिन ए। देवतामन ला छोंड़ अऊ कोनो, राजा ला ये बात नइं बता सकंय, अऊ देवतामन मनखेमन के बीच म नइं रहंय।”<verse eid="DAN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12" />ये बात ला सुनके राजा ह अतेक गुस्सा होईस अऊ कोरोध करिस कि ओह बेबिलोन के जम्मो बुद्धिमान मनखेमन ला मार डारे के हुकूम दे दीस। <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />एकरसेति बुद्धिमान मनखेमन ला मार डारे के आदेस निकाले गीस, अऊ मनखेमन ला दानिएल अऊ ओकर संगीमन के खोज म पठोय गीस ताकि ओमन घलो मार डारे जावंय।<verse eid="DAN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />जब राजा के अंगरछकमन के सेनापति अरयोक, बेबिलोन के बुद्धिमान मनखेमन ला मार डारे बर निकले रिहिस, त दानिएल ह ओकर ले बुद्धिमानी अऊ बने बरताव के संग बात करिस। <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />ओह राजा के अधिकारी ले पुछिस, “राजा ह अइसे कठोर आदेस काबर निकाले हवय?” तब अरयोक ह दानिएल ला जम्मो बात बताईस। <verse eid="DAN 2:15" /><verse number="16" style="v" sid="DAN 2:16" />ये जानके, दानिएल ह राजा करा गीस अऊ कुछू समय देय के मांग करिस, ताकि ओह राजा ला ओकर सपना के अर्थ बता सकय।<verse eid="DAN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 2:17" />तब दानिएल ह अपन घर आईस अऊ ओह अपन संगी हननयाह, मिसाएल अऊ अजरयाह ला ओ जम्मो बात बताईस। <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />ओह ओमन ला उत्साहित करिस कि ओमन स्वरग के परमेसर ले ये रहस्य के बारे म किरपा करे बर बिनती करंय, ताकि ओह अऊ ओकर संगीमन बेबिलोन के बाकि बुद्धिमान मनखेमन के संग झन मार डारे जावंय। <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />रात के बेरा, ओ रहस्य ह एक दरसन के रूप म दानिएल ऊपर परगट होईस। तब दानिएल ह स्वरग के परमेसर के महिमा करिस <verse eid="DAN 2:19" /><verse number="20" style="v" sid="DAN 2:20" />अऊ कहिस:</para>
  <para style="q1" vid="DAN 2:20">“परमेसर के नांव के महिमा सदाकाल तक होवत रहय;</para>
  <para style="q2" vid="DAN 2:20">काबरकि बुद्धि अऊ सक्ति ओकर अय।<verse eid="DAN 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="DAN 2:21" />ओह समय अऊ मौसम ला बदलथे;</para>
  <para style="q2" vid="DAN 2:21">ओह राजामन ला गद्दी ले हटाथे अऊ आने मन ला गद्दी म बईठाथे।</para>
  <para style="q1" vid="DAN 2:21">ओह बुद्धिमान ला बुद्धि</para>
  <para style="q2" vid="DAN 2:21">अऊ समझदार ला गियान देथे।<verse eid="DAN 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="DAN 2:22" />ओह गूढ़ अऊ लुकाय बातमन ला परगट करथे;</para>
  <para style="q2" vid="DAN 2:22">ओह जानथे कि अंधियार म का रखे हवय,</para>
  <para style="q2" vid="DAN 2:22">अऊ अंजोर ह ओकर संग रहिथे।<verse eid="DAN 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="DAN 2:23" />हे मोर पुरखामन के परमेसर, मेंह तोला धनबाद देथंव अऊ तोर परसंसा करथंव:</para>
  <para style="q2" vid="DAN 2:23">तेंह मोला बुद्धि अऊ सक्ति दे हवस,</para>
  <para style="q1" vid="DAN 2:23">तेंह मोला ओ बात बताय हवस, जऊन ला हमन तोर ले पुछे रहेंन,</para>
  <para style="q2" vid="DAN 2:23">तेंह हमन ला राजा के सपना ला बताय हस।”<verse eid="DAN 2:23" /></para>
  <para style="s1">दानिएल ह सपना के अर्थ बताथे</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />तब दानिएल ह अरयोक करा गीस, जऊन ला राजा ह बेबिलोन के बुद्धिमान मनखेमन ला मार डारे बर ठहिराय रिहिस, अऊ ओह अरयोक ले कहिस, “बेबिलोन के बुद्धिमान मनखेमन ला मार डारे के काम ला रोक दे। मोला राजा करा ले चल, अऊ मेंह राजा ला ओकर सपना के अर्थ बताहूं।”<verse eid="DAN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25" />अरयोक ह तुरते दानिएल ला राजा करा ले गीस अऊ राजा ले कहिस, “यहूदा प्रदेस ले बंधुवई म आय मनखेमन के बीच मोला एक मनखे मिले हवय, जेह राजा ला ओकर सपना के अर्थ बता सकथे।”<verse eid="DAN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 2:26" />राजा ह दानिएल ले पुछिस (जऊन ला बेलतसस्सर घलो कहे जावय), “का तेंह मोला बता सकत हस कि मेंह सपना म का देखे हंव अऊ ओकर अर्थ का ए?”<verse eid="DAN 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 2:27" />दानिएल ह जबाब दीस, “राजा ह जऊन रहस्य के बारे म पुछत हे, ओकर बारे म कोनो घलो बुद्धिमान मनखे, जोतिसी, जादूगर या अगम के बात बतानेवाला राजा ला कुछू नइं बता सकंय, <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />पर स्वरग म एक परमेसर हवय, जऊन ह रहस्यमन ला परगट करथे। ओहीच ह राजा नबूकदनेसर ला देखाय हवय कि अवइया दिन म का होवइया हे। जब तेंह अपन बिस्तर म लेटे रहे, तब तेंह जऊन सपना अऊ दरसन देखे, ओमन ये अंय:<verse eid="DAN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 2:29" />“हे महाराज, जब तेंह अपन पलंग म ढलंगे रहे, त तोर मन ह भविस्य म होवइया चीजमन कोति गीस, अऊ रहस्य के परगट करइया ह तोला देखाईस कि भविस्य म का होवइया हे। <verse eid="DAN 2:29" /><verse number="30" style="v" sid="DAN 2:30" />जहां तक मोर बात ए, त ये रहस्य ह मोर ऊपर एकरसेति परगट नइं करे गीस कि मोर करा कोनो अऊ जीयत मनखे ले जादा बुद्धि हवय, पर एकरसेति परगट करे गीस कि महाराज ला ये रहस्य के अर्थ मालूम होवय अऊ तेंह समझ जा कि तोर मन म का आय रिहिस।<verse eid="DAN 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 2:31" />“हे महाराज, तेंह देखे कि तोर आघू म एक ठन बड़े मूरती ठाढ़े रिहिस—एक बहुंत बड़े, चकित करइया मूरती, जऊन ह दिखे म अद्भूत रिहिस। <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />ओ मूरती के मुड़ ह सुध सोन के बने रिहिस, ओकर छाती अऊ बाहांमन चांदी के, ओकर पेट अऊ जांघमन कांसा के, <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />ओकर गोड़मन लोहा के, ओकर पांवमन कुछू लोहा अऊ कुछू पकोय गय माटी के रिहिन। <verse eid="DAN 2:33" /><verse number="34" style="v" sid="DAN 2:34" />जब तेंह देखत रहे, त एक चट्टान ह बिगर कोनो मनखे के कोसिस के अपनआप कटके अलग हो गीस अऊ ओ मूरती के लोहा अऊ माटी के बने पांवमन ला अइसने ठोकर मारिस कि ओमन चकनाचूर हो गीन। <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />तब लोहा, माटी, कांसा, चांदी अऊ सोन—जम्मो टूटके कुटा-कुटा हो गीन अऊ गरमी महिना म कोठार के भूंसा सहीं हो गीन। हवा ह ओमन ला अइसे उड़ाके ले गीस कि ओमन के कोनो छोटे टुकड़ा घलो नइं बचिस। पर जऊन चट्टान ह मूरती ला ठोकर मारे रिहिस, ओ चट्टान ह एक बहुंत बड़े पहाड़ बन गीस अऊ जम्मो धरती म फईल गीस।<verse eid="DAN 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 2:36" />“येह रिहिस तोर सपना, अऊ अब हमन राजा ला ओकर अर्थ बताबो। <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />हे महाराज, तेंह तो राजामन के राजा अस। स्वरग के परमेसर ह तोला राज अऊ सक्ति अऊ बल अऊ महिमा दे हवय; <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />ओह जम्मो मानव-जाति अऊ धरती के पसु अऊ अकास के चिरईमन ला तोर हांथ म कर दे हवय। ओमन जिहां घलो रहिथें, ओह तोला ओ जम्मो के ऊपर सासन करइया बनाय हवय। मूरती के सोन के ओ मुड़ तेंह अस।<verse eid="DAN 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="DAN 2:39" />“तोर बाद, एक आने राज ठाढ़ होही, जऊन ह तोर राज ले कम स्तर के होही। ओकर बाद, एक तीसरा राज के उदय होही, जऊन ह कांसा के सहीं होही, जेकर सासन जम्मो धरती ऊपर होही। <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />आखिरी म, एक चौथा राज होही, जऊन ह लोहा के सहीं मजबूत होही—काबरकि लोहा जम्मो चीज ला टोर देथे अऊ चूर-चूर कर देथे—अऊ जइसे कि लोहा चीजमन ला टोरके कुटा-कुटा कर देथे, वइसे ही ये राज घलो आने जम्मो राजमन ला कुचरके कुटा-कुटा कर दीही। <verse eid="DAN 2:40" /><verse number="41" style="v" sid="DAN 2:41" />जइसे कि तेंह देखे कि पांव अऊ अंगरीमन कुछू सेंके गय माटी अऊ कुछू लोहा के रिहिन, एकरसेति येह हिस्सा म बंटे राज होही, तभो ले येमा कुछू लोहा के सहीं बल होही, जइसे कि तेंह लोहा ला माटी के संग मिले देखे। <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />जइसे कि पांव के अंगरीमन कुछू लोहा अऊ कुछू माटी के रिहिन, एकरसेति ये राज ह कुछू तो मजबूत अऊ कुछू कमजोर होही। <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />अऊ जइसे कि तेंह लोहा ला सेंके गय माटी के संग मिले देखे, वइसे ही मनखेमन के एक मिलावट होही अऊ ओमन म एकता नइं होही, काबरकि लोहा के माटी के संग मेल नइं होवय।<verse eid="DAN 2:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="DAN 2:44" />“ओ राजामन के समय म, स्वरग के परमेसर ह एक अइसने राज ला स्थापित करही, जऊन ह कभू नास नइं होही, अऊ न ही येकर ऊपर कोनो आने ह सासन करही। ये राज ह ओ जम्मो राजमन ला चूर-चूर कर दीही अऊ ओमन के अन्त कर दीही, पर येह खुद सदाकाल तक बने रहिही। <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />येह ओ चट्टान के दरसन के अर्थ अय, जऊन ह मनखेमन के दुवारा नइं, पर अपनआप एक पहाड़ ले कटके अलग होय रिहिस—एक चट्टान, जऊन ह लोहा, कांसा, माटी, चांदी अऊ सोन ला कुटा-कुटा कर दे रिहिस।</para>
  <para style="p" vid="DAN 2:45">“महान परमेसर ह राजा ला देखाय हवय कि भविस्य म का होवइया हे। ये सपना ह सच ए अऊ येकर अर्थ बिसवासयोग्य अय।”<verse eid="DAN 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />तब राजा नबूकदनेसर ह दानिएल के गोड़ खाल्हे गिरके ओला दंडवत करिस अऊ ओला आदर दीस अऊ हुकूम दीस कि दानिएल ला भेंट अऊ खुसबूदार चीज उपहार म दिये जावय। <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />राजा ह दानिएल ला कहिस, “सही म तोर परमेसर ह देवतामन के परमेसर अऊ राजामन के परभू अऊ रहस्यमन ला परगट करइया ए, काबरकि तेंह ये रहस्य ला बताय म योग्य ठहिरे।”<verse eid="DAN 2:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="DAN 2:48" />तब राजा ह दानिएल ला एक ऊंच पद म ठहिराईस अऊ ओला खुले हांथ ले बहुंत अकन ईनाम दीस। राजा ह ओला पूरा बेबिलोन राज के सासक बना दीस अऊ बेबिलोन के जम्मो बुद्धिमान मनखेमन ऊपर ओला अधिकारी ठहिराईस। <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />येकर अलावा, दानिएल के बिनती ले, राजा ह सदरक, मेसक अऊ अबेदनगो ला बेबिलोन राज ऊपर प्रसासक ठहिराईस, पर दानिएल ह खुद राज दरबार म बने रिहिस।<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s1">सोन के मूरती अऊ धधकत भट्ठी</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />राजा नबूकदनेसर ह सोन के एक मूरती बनवाईस, जेकर ऊंचई साठ क्यूबीट अऊ चौड़ई छै क्यूबीट रिहिस,<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">लगभग 90 फीट ऊंचहा अऊ 9 फीट चौड़ा</char></note> अऊ ये मूरती ला ओह बेबिलोन राज के दूरा नांव के मैदान म स्थापित करिस। <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />तब ओह हाकिम, परधान, राजपाल, सलाहकार, खजांची, नियायधीस, जिलाधीस अऊ राज के आने जम्मो अधिकारीमन ला बलाईस कि ओमन ओ मूरती के समरपन समारोह म सामिल होवंय जऊन ला ओह स्थापित करे रिहिस। <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />एकरसेति हाकिम, परधान राजपाल, सलाहकार, खजांची, नियायधीस, जिलाधीस अऊ राज के आने जम्मो अधिकारी ओ मूरती के समरपन समारोह बर जूरिन, जऊन ला राजा नबूकदनेसर ह स्थापित करे रिहिस, अऊ ओ जम्मो झन ओ मूरती के आघू म ठाढ़ होईन।<verse eid="DAN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 3:4" />तब घोसना करइया ह ऊंचहा अवाज म ये घोसना करिस, “हे जाति-जाति अऊ हर भासा के मनखेमन, तुमन ला ये करे के हुकूम दिये जावत हे: <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />जतेक बेरा तुमन नरसिंगा, बांसुरी, सितार, सारंगी, बीना, सहनई अऊ जम्मो किसम के बाजा के अवाज सुनव, त ओहीच बेरा तुमन सीधा गिरके सोन के ओ मूरती के अराधना करव, जऊन ला राजा नबूकदनेसर ह स्थापित करे हवय। <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />जऊन कोनो सीधा गिरके अराधना नइं करही, ओला तुरते धधकत आगी के भट्ठी म डार दिये जाही।”<verse eid="DAN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 3:7" />एकरसेति जब ओमन नरसिंगा, बांसुरी, सितार, सारंगी, बीना अऊ जम्मो किसम के बाजा के अवाज सुनिन, त जम्मो जाति अऊ हर भासा के मनखेमन सीधा गिरके ओ सोन के मूरती के अराधना करिन, जऊन ला राजा नबूकदनेसर ह स्थापित करे रिहिस।<verse eid="DAN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8" />येहीच बेरा कुछू जोतिसीमन<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> आघू आईन अऊ यहूदीमन ऊपर दोस लगाय लगिन। <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />ओमन राजा नबूकदनेसर ला कहिन, “राजा ह चिरंजीवी होवय! <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />तें राजा ह एक हुकूम निकाले हवस कि नरसिंगा, बांसुरी, सितार, सारंगी, बीना, सहनई अऊ जम्मो किसम के बाजा के अवाज सुनते ही हर मनखे सीधा गिरके सोन के मूरती के अराधना करंय, <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />अऊ जऊन कोनो सीधा गिरके अराधना नइं करय, ओला धधकत आगी के भट्ठी म झोंक दिये जावय। <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />पर कुछू यहूदीमन हवंय, जेमन ला तेंह बेबिलोन राज के कामकाज बर ठहिराय हस—सदरक, मेसक अऊ अबेदनगो। हे महाराज, ओमन तोर हुकूम ला नइं माने हें। ओमन न तो तोर देवतामन के सेवा करथें अऊ न ही तोर दुवारा स्थापित सोन के मूरती के अराधना करथें।”<verse eid="DAN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13" />भयंकर गुस्सा होके नबूकदनेसर ह सदरक, मेसक अऊ अबेदनगो ला बलाईस। तब ये तीनों ला राजा करा लाने गीस, <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />अऊ नबूकदनेसर ह ओमन ला कहिस, “हे सदरक, मेसक अऊ अबेदनगो, का येह सच ए कि तुमन मोर देवतामन के सेवा नइं करव या मोर दुवारा स्थापित सोन के मूरती के अराधना नइं करत हव? <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />अब जब तुमन नरसिंगा, बांसुरी, सितार, सारंगी, बीना, सहनई अऊ जम्मो किसम के बाजा के अवाज सुनव, अऊ यदि तुमन सीधा गिरके मोर दुवारा बनाय गय मूरती के अराधना करे बर तियार हव, त बने बात ए। पर यदि तुमन ओकर अराधना नइं करव, त तुमन ला तुरते एक धधकत आगी के भट्ठी म झोंक दिये जाही। तब कोन देवता ह तुमन ला मोर हांथ ले बचाही?”<verse eid="DAN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16" />सदरक, मेसक अऊ अबेदनगो राजा ला जबाब दीन, “हे राजा नबूकदनेसर, ये बिसय म हमन ला तोर आघू म अपनआप के बचाव करे के जरूरत नइं ए। <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />यदि हमन ला धधकत आगी के भट्ठी म फटिक दिये जाथे, त हमर परमेसर, जेकर सेवा हमन करथन, हमन ला येकर ले बचाय के सक्ति रखथे, अऊ हे महाराज, ओह हमन ला तोर हांथ ले घलो बचाही। <verse eid="DAN 3:17" /><verse number="18" style="v" sid="DAN 3:18" />पर यदि ओह हमन ला नइं घलो बचाय, तभो ले, हे महाराज, हमन तोला बता देय चाहत हन कि हमन तोर देवतामन के सेवा नइं करन या तोर दुवारा स्थापित सोन के मूरती के अराधना नइं करन।”<verse eid="DAN 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />तब नबूकदनेसर ह सदरक, मेसक अऊ अबेदनगो ऊपर बहुंत गुस्सा होईस, अऊ ओकर भावना ओमन के प्रति बदल गीस। ओह हुकूम दीस कि भट्ठी ला सधारन ले सात गुना जादा धधकाय जावय, <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />अऊ ओह अपन सेना के सबले बलवान कुछू सैनिकमन ला हुकूम दीस कि सदरक, मेसक अऊ अबेदनगो ला बांधके धधकत भट्ठी म फटिक दिये जाय। <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />एकरसेति ये तीनों ला ओमन के पहिरे लबादा, पजामा, पगड़ी अऊ आने ओनहामन समेत बांधके धधकत भट्ठी म फटिक दिये गीस। <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />राजा के हुकूम ह बहुंत जरूरी रिहिस अऊ भट्ठी ह अतेक गरम रिहिस कि आगी के जुवाला ले ओ सैनिकमन मारे गीन, जऊन मन सदरक, मेसक अऊ अबेदनगो ला भट्ठी करा लेय गे रिहिन, <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />अऊ ये तीनों मनखे कसके बंधाय धधकत आगी के भट्ठी म डार दिये गीन।<verse eid="DAN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24" />तब राजा नबूकदनेसर ह चकित होवत कूदके ठाढ़ हो गीस अऊ अपन सलाहकारमन ले पुछिस, “का ओमन तीन झन मनखे नइं रिहिन, जेमन ला हमन बांधके आगी म फटिके रहेंन?”</para>
  <para style="p" vid="DAN 3:24">ओमन जबाब दीन, “हव, महाराज।”<verse eid="DAN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 3:25" />राजा ह कहिस, “देखव! मेंह आगी के बीच म चार झन मनखे ला चलत देखत हंव; ओमन बंधाय नइं एं अऊ ओमन ला कुछू हानि नइं होय हवय, अऊ चौथा मनखे ह देवतामन के बेटा सहीं दिखत हे।”<verse eid="DAN 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />तब नबूकदनेसर ह धधकत भट्ठी के मुहूं करा गीस अऊ ऊंचहा अवाज म कहिस, “हे सदरक, मेसक अऊ अबेदनगो, सर्वोच्च परमेसर के सेवकमन, बाहिर आ जावव! इहां आवव!”</para>
  <para style="p" vid="DAN 3:26">ये सुनके सदरक, मेसक अऊ अबेदनगो आगी ले बाहिर निकल आईन, <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />अऊ ओमन के चारों कोति हाकिम, परधान, राजपाल अऊ राज सलाहकारमन के भीड़ लग गीस। ओमन देखिन कि ओ तीनों के देहें ला आगी ले कुछू नुकसान नइं होय रिहिस, न ही ओमन के मुड़ के कोनो बाल झुलसे रिहिस; ओमन के ओनहामन घलो नइं जले रिहिन, अऊ ओमन ले जले के कोनो गंध नइं आवत रिहिस।<verse eid="DAN 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28" />तब नबूकदनेसर ह कहिस, “सदरक, मेसक अऊ अबेदनगो के परमेसर के महिमा होवय, जऊन ह अपन स्वरगदूत ला पठोके अपन सेवकमन ला बचाईस! ओमन ओकर ऊपर भरोसा करिन अऊ राजा के हुकूम के परवाह नइं करिन अऊ अपन परान देय बर घलो तियार रिहिन, येकर बनिस्पत कि अपन परमेसर ला छोंड़के कोनो अऊ देवता के सेवा या अराधना करंय। <verse eid="DAN 3:28" /><verse number="29" style="v" sid="DAN 3:29" />एकरसेति मेंह ये हुकूम देवत हंव कि कोनो घलो जाति या भासा के मनखे, यदि सदरक, मेसक अऊ अबेदनगो के परमेसर के बिरूध कुछू कहिथें, त ओमन ला काटके कुटा-कुटा कर दिये जाय अऊ ओमन के घरमन ला कचरा के कुढ़ा बना दिये जाय, काबरकि अइसन कोनो देवता नइं ए, जऊन ह ये किसम ले बचा सकय।”<verse eid="DAN 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 3:30" />तब राजा ह सदरक, मेसक अऊ अबेदनगो ला बेबिलोन राज म अऊ ऊंच पद दीस।<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="s1">नबूकदनेसर के एक रूख के सपना</para>
  <para style="pmo">
    <verse number="1" style="v" sid="DAN 4:1" />राजा नबूकदनेसर के तरफ ले,</para>
  <para style="pmo" vid="DAN 4:1">जम्मो धरती म रहइया जाति-जाति अऊ हर भासा के मनखेमन ला ये बचन:</para>
  <para style="pmo" vid="DAN 4:1">तुमन जम्मो के बहुंत उन्नति होवय!<verse eid="DAN 4:1" /></para>
  <para style="pm">
    <verse number="2" style="v" sid="DAN 4:2" />सर्वोच्च परमेसर के दुवारा मोर बर करे गय ओ अद्भूत चिनहां अऊ अचरज के काम के बारे म तुमन ला बताके मोला खुसी होवत हे।<verse eid="DAN 4:2" /></para>
  <para style="qm1">
    <verse number="3" style="v" sid="DAN 4:3" />कइसे बड़े हवंय ओकर चिनहांमन,</para>
  <para style="qm2" vid="DAN 4:3">कइसे महान हवंय ओकर अद्भूत काम!</para>
  <para style="qm1" vid="DAN 4:3">ओकर राज ह एक सदाकाल के राज अय;</para>
  <para style="qm2" vid="DAN 4:3">ओकर परभूता पीढ़ी-पीढ़ी तक बने रहिथे।<verse eid="DAN 4:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="DAN 4:4" />में, नबूकदनेसर ह अपन महल म संतुस्ट अऊ सम्पन्न रहेंव। <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />मेंह एक सपना देखेंव, जेकर ले मेंह डर्रा गेंव। जब मेंह अपन पलंग म लेटे रहेंव, त जऊन परतिरूप अऊ दरसन मोर मन म आईन, ओमन ले मेंह भयभीत हो गेंव। <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />एकरसेति मेंह हुकूम देंव कि मोर सपना के अर्थ बताय बर बेबिलोन के जम्मो बुद्धिमान मनखेमन ला मोर आघू म लाने जावय। <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />जब जादूगर, टोनहा, जोतिसी<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदी</char></note> अऊ देवीय सक्तिवालामन मोर करा आईन, त मेंह ओमन ला अपन सपना बतांय, पर ओमन मोला ओकर अर्थ नइं बता सकिन। <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />आखिरी म, दानिएल मोर आघू म आईस अऊ मेंह ओला अपन सपना बतांय। (ओकर नांव मोर देवता के नांव ले बेलतसस्सर रखे गे हवय, अऊ पबितर देवतामन के आतमा ओमा हवय।)<verse eid="DAN 4:8" /></para>
  <para style="pm">
    <verse number="9" style="v" sid="DAN 4:9" />मेंह कहेंव, “हे बेलतसस्सर, जादूगरमन के मुखिया, मेंह जानत हंव कि पबितर देवतामन के आतमा ह तोर म हवय, अऊ कोनो घलो रहस्य तोर बर कठिन नो हय। येह मोर सपना अय; मोला येकर अर्थ बता। <verse eid="DAN 4:9" /><verse number="10" style="v" sid="DAN 4:10" />जब मेंह पलंग म लेटे रहेंव, त जऊन दरसनमन ला मेंह देखेंव, ओमन ये अंय: मेंह देखेंव कि धरती के बीच म एक रूख लगे रहय अऊ ओह बहुंत ऊंचा रहय। <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />ओ रूख ह बड़े होके मजबूत हो गीस अऊ ओकर टीप ह अकास ला छुए लगिस; येला धरती के छोर ले घलो देखे जा सकत रिहिस। <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />येकर पानमन सुघर रिहिन, येमा बहुंत अकन फर लगे रिहिस, अऊ येमा जम्मो झन बर जेवन रिहिस। येकर खाल्हे म जंगली पसुमन रहत रिहिन, अऊ चिरईमन येकर डारामन म बसेरा करत रिहिन; येमा ले हर एक जीव-जन्तु ला जेवन मिलत रिहिस।<verse eid="DAN 4:12" /></para>
  <para style="pm">
    <verse number="13" style="v" sid="DAN 4:13" />“पलंग म लेटे मेंह दरसन म देखेंव कि स्वरग ले एक पबितर जन, एक संदेसिया खाल्हे आवत रिहिस। <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />ओह ऊंचहा अवाज म कहिस, ‘रूख ला काट डारव अऊ येकर डारामन ला अलग कर दव; येकर पानमन ला गिरा दव अऊ येकर फर ला बगरा दव। पसुमन येकर खाल्हे ले भाग जावंय अऊ चिरईमन येकर डारामन ले उड़ जावंय। <verse eid="DAN 4:14" /><verse number="15" style="v" sid="DAN 4:15" />पर रूख के ठूंठ अऊ येकर जरीमन ला लोहा अऊ कांसा ले बंधे रहिके जमीन के कांदी ऊपर, भुइयां म रहन दव।</para>
  <para style="pm" vid="DAN 4:15">“ ‘ओला अकास के ओस ले भीगन दव, अऊ ओला धरती के पऊधामन के बीच पसुमन के संग रहन दव। <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />ओकर मन ला बदल दिये जावय अऊ एक मनखे के सहीं ओकर मन झन रहय अऊ सात कालखंड<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बछर</char></note> के खतम होवत तक ओला एक पसु के मन दिये जावय।<verse eid="DAN 4:16" /></para>
  <para style="pm">
    <verse number="17" style="v" sid="DAN 4:17" />“ ‘ये निरनय के घोसना संदेसियामन के दुवारा करे जावत हे, पबितर जनमन ये निरनय के घोसना करथें, ताकि जीयत मनखेमन ये बात ला जानंय कि ओ, जऊन ह सर्वोच्च परमेसर ए, ओही ह धरती ऊपर जम्मो राज म परमपरधान ए अऊ ओह जऊन ला चाहथे, ओला ओ राजमन ला दे देथे अऊ छोटे ले छोटे मनखे ला ओमन के ऊपर ठहिरा देथे।’<verse eid="DAN 4:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="DAN 4:18" />“येह अय ओ सपना, जऊन ला में, राजा नबूकदनेसर ह देखेंव। अब, हे बेलतसस्सर, मोला बता कि येकर अर्थ का ए, काबरकि मोर राज के कोनो घलो बुद्धिमान मनखे मोला येकर अर्थ नइं बता सकंय। पर तेंह बता सकत हस, काबरकि तोर म पबितर देवतामन के आतमा हवय।”<verse eid="DAN 4:18" /></para>
  <para style="s1">दानिएल ह सपना के अर्थ बताथे</para>
  <para style="pm">
    <verse number="19" style="v" sid="DAN 4:19" />तब दानिएल (जऊन ला बेलतसस्सर घलो कहे जावय) कुछू समय बर बहुंत बियाकुल हो गीस, अऊ ओकर बिचारमन ओला भयभीत करिन। एकरसेति राजा ह कहिस, “हे बेलतसस्सर, मोर सपना या येकर अर्थ ले भयभीत झन हो।”</para>
  <para style="pm" vid="DAN 4:19">बेलतसस्सर ह जबाब दीस, “हे मोर परभू, कास, ये सपना सिरिप तोर बईरी अऊ येकर अर्थ तोर बिरोधीमन ऊपर लागू होतिस! <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />ओ रूख जऊन ला तेंह देखे, जऊन ह बड़े होके मजबूत हो गीस, जेकर टीप ह अकास ला छुए लगिस, अऊ जऊन ला जम्मो धरती ले देखे जा सकत रिहिस, <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />जेकर पानमन सुघर अऊ जेमा बहुंत अकन फर लगे रिहिस, जऊन ह जंगली पसुमन ला आसरय देवत रिहिस, अऊ चिरईमन जेकर डारामन म खोंधरा बनात रिहिन— <verse eid="DAN 4:21" /><verse number="22" style="v" sid="DAN 4:22" />हे महाराज, तेंह ओ रूख अस! तेंह बड़े अऊ मजबूत हो गे हवस; तोर महानता अतेक हो गे हवय कि येह अकास ला छुए लगत हे, अऊ तोर राज ह धरती म बहुंत दूर तक फईले हवय।<verse eid="DAN 4:22" /></para>
  <para style="pm">
    <verse number="23" style="v" sid="DAN 4:23" />“हे महाराज, तेंह एक पबितर जन, एक संदेसिया ला स्वरग ले खाल्हे उतरत देखे, जऊन ह ये कहत रिहिस, ‘ये रूख ला काट डारव अऊ येला नास कर दव, पर येकर ठूंठ ला लोहा अऊ कांसा ले बंधाय जमीन के कांदी म रहन दव, अऊ येकर जरीमन ला भुइयां म रहन दव। ओला अकास के ओस ले भीगन दव; ओला जंगली पसुमन के संग रहन दव, जब तक कि ओकर बर सात कालखंड पूरा नइं हो जावय।’<verse eid="DAN 4:23" /></para>
  <para style="pm">
    <verse number="24" style="v" sid="DAN 4:24" />“हे महाराज, येह ओकर अर्थ ए, अऊ येह ओ फैसला ए, जऊन ला सर्वोच्च परमेसर ह मोर मालिक राजा के बिरूध म दिये हवय: <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />तोला मनखेमन के बीच ले भगा दिये जाही अऊ तेंह जंगली पसुमन के संग रहिबे; तेंह बईला के सहीं कांदी खाबे अऊ अकास के ओस ले भीजबे। सात कालखंड के खतम होवत तक तेंह इही हालत म रहिबे, अऊ तब तेंह ये मान लेबे कि धरती म जम्मो राज ऊपर सर्वोच्च परमेसर ही परमपरधान अय अऊ ओह जऊन ला चाहथे, ओला ये राज दे देथे। <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />रूख के ठूंठ ला ओकर जरी समेत छोंड़े के जऊन हुकूम दिये गे हवय, ओकर अर्थ ये अय कि तोला तोर राज लहुंटा दिये जाही, जब तेंह मान लेबे कि स्वरग<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमेसर</char></note> ही सासन करथे। <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />एकरसेति, हे महाराज, खुसी-खुसी मोर सलाह ला मान ले: अपन पापमन ला छोंड़के भलई के काम कर, अऊ दुस्टता ला छोंड़के सताय गय मनखेमन ऊपर दया कर। तब ये हो सकथे कि तोर उन्नति होय लगे।”<verse eid="DAN 4:27" /></para>
  <para style="s1">सपना ह पूरा होथे</para>
  <para style="pm">
    <verse number="28" style="v" sid="DAN 4:28" />ये जम्मो बात राजा नबूकदनेसर के संग होईस। <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />बारह महिना के बाद, जब राजा ह बेबिलोन के राजमहल के छत म टहलत रिहिस, <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />त ओह कहिस, “का येह ओ बड़े बेबिलोन नो हय, जऊन ला मेंह अपन बड़े सक्ति ले साही निवास के रूप म अपन वैभव के महिमा बर बनाय हवंव?”<verse eid="DAN 4:30" /></para>
  <para style="pm">
    <verse number="31" style="v" sid="DAN 4:31" />अभी राजा के मुहूं ले ये बात निकले घलो नइं रिहिस कि स्वरग ले एक अवाज आईस, “हे राजा नबूकदनेसर, तोर बर ये फैसला करे जावत हे। तोर राजकीय अधिकार तोर ले छीन लिये गे हवय। <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />तोला मनखेमन के बीच ले भगा दिये जाही अऊ तेंह जंगली पसुमन के संग रहिबे; तेंह बईला के सहीं कांदी खाबे। तोर इही हालत म, सात कालखंड बीतही अऊ तब तेंह ये मान लेबे कि सर्वोच्च परमेसर ही धरती म जम्मो राज ऊपर परमपरधान अय अऊ ओह जऊन ला चाहथे, ओला ये राजमन ला दे देथे।”<verse eid="DAN 4:32" /></para>
  <para style="pm">
    <verse number="33" style="v" sid="DAN 4:33" />नबूकदनेसर के बारे म जऊन बात कहे गीस, ओह ओहीच बेरा पूरा हो गीस। ओला मनखेमन के बीच ले भगा दिये गीस अऊ ओह बईला सहीं कांदी खाय लगिस। ओकर देहें ह अकास के ओस ले भीजय, इहां तक कि ओकर चुंदी बढ़के गिधवा के पांखी सहीं अऊ ओकर नख चिरई के पंजामन सहीं हो गीन।<verse eid="DAN 4:33" /></para>
  <para style="b" />
  <para style="pm">
    <verse number="34" style="v" sid="DAN 4:34" />ठहिराय समय के आखिरी म, में, नबूकदनेसर ह स्वरग कोति अपन नजर उठांय, अऊ मोर मानसिक हालत फेर पहिले सहीं हो गीस। तब मेंह सर्वोच्च परमेसर के महिमा करेंव; मेंह ओकर आदर अऊ परसंसा करेंव, जऊन ह सदाकाल तक रहिथे।</para>
  <para style="qm1" vid="DAN 4:34">ओकर परभूता ह सदाकाल के परभूता अय;</para>
  <para style="qm2" vid="DAN 4:34">ओकर राज ह पीढ़ी-पीढ़ी तक बने रहिथे।<verse eid="DAN 4:34" /></para>
  <para style="qm1">
    <verse number="35" style="v" sid="DAN 4:35" />धरती के जम्मो मनखेमन के</para>
  <para style="qm2" vid="DAN 4:35">कोनो महत्व नइं ए।</para>
  <para style="qm1" vid="DAN 4:35">ओह जइसे चाहथे</para>
  <para style="qm2" vid="DAN 4:35">वइसे स्वरग के सक्तिमन</para>
  <para style="qm2" vid="DAN 4:35">अऊ धरती के मनखेमन के संग करथे।</para>
  <para style="qm1" vid="DAN 4:35">ओला कोनो रोक नइं सकंय</para>
  <para style="qm2" vid="DAN 4:35">या ओला ये नइं कह सकंय: “तेंह ये का कर डारे?”<verse eid="DAN 4:35" /></para>
  <para style="pm">
    <verse number="36" style="v" sid="DAN 4:36" />जऊन बेरा मोर मानसिक हालत पहिली सहीं होईस, ओहीच बेरा मोर सम्मान अऊ वैभव घलो मोर राज के महिमा बर मोर करा लहुंट आईस। मोर सलाहकार अऊ ऊंच कुल के मनखेमन मोला खोज निकालिन, अऊ मोला फेर मोर सिंघासन म बईठाय गीस अऊ मेंह पहिले ले घलो जादा महान हो गेंव। <verse eid="DAN 4:36" /><verse number="37" style="v" sid="DAN 4:37" />अब में, नबूकदनेसर, स्वरग के राजा के इस्तुति, महिमा अऊ परसंसा करत हंव, काबरकि ओह जऊन कुछू घलो करथे, सही करथे अऊ ओकर जम्मो काम नियाय-संगत होथें। अऊ जऊन मन घमंडी होके चलथें, ओमन ला ओह नम्र बनाय म समर्थ हे।<verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s1">दीवार म लिखई</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />एक दिन राजा बेलसस्सर ह अपन एक हजार परभावसाली मनखेमन ला एक बड़े जेवनार दीस अऊ ओमन के संग मंद पीईस। <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />जब बेलसस्सर ह मंद पीयत रिहिस, तब ओह हुकूम दीस कि जऊन सोन अऊ चांदी के पियाला ओकर ददा<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">पुरखा </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">पहिले के राजा</char></note> नबूकदनेसर ह यरूसलेम के मंदिर ले लाने रिहिस, ओ पियालामन ला लाने जावय, ताकि राजा अऊ ओकर परभावसाली मनखे, ओकर घरवाली, अऊ ओकर रखैलमन मंद पीये बर ओमन के उपयोग करंय। <verse eid="DAN 5:2" /><verse number="3" style="v" sid="DAN 5:3" />एकरसेति यरूसलेम म परमेसर के मंदिर ले निकालके लाने गय सोन के पियालामन लाने गीन, अऊ राजा अऊ ओकर परभावसाली मनखे, ओकर घरवाली अऊ ओकर रखैलमन ओमा मंद पीईन। <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />जब ओमन मंद पीईन, त ओमन सोन अऊ चांदी, कांसा, लोहा, लकड़ी अऊ पथरा के देवतामन के परसंसा करे लगिन।<verse eid="DAN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5" />तब अचानक एक मनखे के हांथ के अंगरीमन परगट होईन अऊ राजमहल म दीवट के लकठा म दीवार के पलस्तर म कुछू लिखे लगिन। लिखत रहय ओ हांथ ऊपर राजा के नजर पड़िस। <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />ओला देखके राजा के चेहरा के रंग उड़ गीस अऊ ओह अतेक डर्रा गीस कि ओकर माड़ीमन ढीला पड़ गीन अऊ कंपई के मारे ओकर माड़ीमन एक-दूसर ले टकराय लगिन।<verse eid="DAN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 5:7" />तब राजा ह तांत्रिक, जोतिसी अऊ देवीय सक्तिवालेमन ला बलाईस अऊ ओह बेबिलोन के ओ बुद्धिमान मनखेमन ले कहिस, “जऊन कोनो ये लिखावट ला पढ़ही अऊ ओकर अर्थ मोला बताही, ओला राजसी ओनहा पहिराय जाही अऊ ओकर घेंच म सोन के माला पहिराय जाही, अऊ ओला राज म तीसरा नम्बर के ऊंच पद के सासक बनाय जाही।”<verse eid="DAN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 5:8" />तब राजा के जम्मो बुद्धिमान मनखेमन आईन, पर ओमन ओ दीवार म लिखे बात ला नइं पढ़ सकिन अऊ न ही ओमन राजा ला ओकर अर्थ बता सकिन। <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />येकर ले राजा बेलसस्सर ह अऊ भयभीत हो गीस अऊ ओकर चेहरा के रंग अऊ उड़ गीस। ओकर परभावसाली मनखेमन परेसान हो गीन।<verse eid="DAN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10" />राजा अऊ ओकर परभावसाली मनखेमन के अवाज ला सुनके, रानी ह भोज के बड़े कमरा म आईस अऊ कहिस, “राजा ह चिरंजीवी होवय! तेंह चिंता झन कर! अऊ तोर चेहरा के रंग झन उड़य! <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />तोर राज म एक अइसने मनखे हवय, जेमा पबितर देवतामन के आतमा रहिथे। तोर ददा के समय म ये मनखे म देवतामन के सहीं समझ-बुझ, बुद्धि अऊ गियान पाय गे रिहिस। तोर ददा, नबूकदनेसर ह ओला जादूगर, तांत्रिक, जोतिसी अऊ देवीय सक्तिवालामन के मुखिया ठहिराय रिहिस। <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />ओह अइसे करिस काबरकि दानिएल नांव के ये मनखे करा, जऊन ला राजा ह बेलतसस्सर नांव ले बलावय, तेज दिमाग अऊ गियान अऊ समझ रिहिस, अऊ ओमा सपनामन के अर्थ बताय के, पहेलीमन ला समझाय के अऊ कठिन समस्यामन के हल निकाले के योग्यता पाय गे रिहिस। एकरसेति दानिएल ला बुलवा ले, अऊ ओह तोला बताही कि लिखावट के का अर्थ अय।”<verse eid="DAN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />तब दानिएल ला राजा के आघू म लाने गीस, अऊ राजा ह ओला कहिस, “का तेंह दानिएल अस, अऊ ओमन ले एक झन अस, जेमन ला मोर ददा, राजा ह यहूदा प्रदेस ले बंधुवई म लाय रिहिस? <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />मेंह सुने हंव कि तोर म देवतामन के आतमा हवय अऊ ये घलो कि तोर म समझ-बुझ, बुद्धि अऊ असधारन गियान हवय। <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />बुद्धिमान मनखे अऊ तांत्रिकमन ला ये लिखावट ला पढ़े अऊ येकर अर्थ बताय बर मोर करा लाय गे रिहिस, पर ओमन येला समझाय नइं सकिन। <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />मेंह सुने हंव कि तोर म अर्थ बताय अऊ कठिन समस्यामन के हल निकाले के योग्यता हवय। यदि तेंह ये लिखावट ला पढ़के येकर अर्थ मोला बता सकबे, त तोला राजसी ओनहा पहिराके तोर घेंच म सोन के माला पहिराय जाही, अऊ तोला राज म तीसरा ऊंच पद के सासक बनाय जाही।”<verse eid="DAN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17" />तब दानिएल ह राजा ला जबाब दीस, “तेंह अपन ईनाममन ला अपन करा रख अऊ अपन पुरस्कार कोनो अऊ ला देय दे। तभो ले, मेंह ये लिखावट ला राजा बर पढ़हूं अऊ ओला येकर अर्थ घलो बताहूं।<verse eid="DAN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 5:18" />“हे महाराज, सर्वोच्च परमेसर ह तोर ददा नबूकदनेसर ला राजपाट, महानता, महिमा अऊ वैभव दीस। <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />काबरकि परमेसर ह ओला ऊंच पद दे रिहिस, एकरसेति जम्मो जाति अऊ हर भासा के मनखेमन तोर ददा ले डरत रिहिन अऊ ओकर भय मानत रिहिन। जेमन ला ओह मार डारे चाहय, ओमन ला ओह मार डारय; जेमन ला ओह छोंड़ देय चाहय, ओमन ला ओह छोंड़ देवय; जेमन ला ओह ऊंच पद देय चाहय, ओमन ला ओह ऊंच पद देवय; अऊ जेमन ला ओह नीचा देखाय चाहय, ओमन ला ओह नीचा देखावय। <verse eid="DAN 5:19" /><verse number="20" style="v" sid="DAN 5:20" />पर जब ओह घमंडी हो गीस अऊ ओकर हिरदय ह घमंड ले कठोर हो गीस, त ओला ओकर राज सिंघासन ले हटा दिये गीस अऊ ओकर मान-सम्मान ले लिये गीस। <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />ओला मनखेमन के बीच ले भगा दिये गीस अऊ ओला एक पसु के मन दिये गीस; ओह जंगली गदहामन के संग रहत रिहिस अऊ बईला के सहीं कांदी खावत रिहिस; अऊ ओकर देहें अकास के ओस ले भीगय; येह तब तक होते रिहिस, जब तक कि ओह ये नइं मान लीस कि धरती म जम्मो राजमन ऊपर सर्वोच्च परमेसर ही परमपरधान अय अऊ ओह जऊन ला चाहथे ओला ओ राजमन ऊपर सासक ठहिराथे।<verse eid="DAN 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 5:22" />“पर हे बेलसस्सर, तेंह ओकर बेटा<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">संतान</char><char style="ft" closed="false">; या </char><char style="fqa" closed="false">उत्तराधिकारी</char></note> अस अऊ अपनआप ला नम्र नइं करे, हालाकि तेंह ये जम्मो बात ला जानत रहे। <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />पर तेंह अपनआप ला स्वरग के परभू ले घलो बड़े बना ले हवस। ओकर मंदिर ले लाने गय पियालामन ला तेंह अपन करा मंगा ले हवस, अऊ तें अऊ तोर परभावसाली मनखेमन, तोर घरवाली अऊ तोर रखैलमन ओमा मंद पीये हव। तेंह चांदी अऊ सोन, कांसा, लोहा, लकड़ी अऊ पथरा के देवतामन के महिमा करे हस, जेमन न तो देख सकंय, न सुन सकंय, अऊ न ही समझ सकंय। पर तेंह ओ परमेसर के आदर नइं करे, जेकर हांथ म तोर जिनगी अऊ तोर जम्मो काम-धाम हवय। <verse eid="DAN 5:23" /><verse number="24" style="v" sid="DAN 5:24" />एकरसेति परमेसर ह ये हांथ ला पठोईस, जेह ये लेख लिखिस।<verse eid="DAN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 5:25" />“येह ओ लेख अय, जऊन ला लिखे गे हवय:</para>
  <para style="pc" vid="DAN 5:25">मने, मने, तकेल, परसीन।<verse eid="DAN 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 5:26" />“ये सबदमन के अर्थ ये किसम ले अय:</para>
  <para style="p" vid="DAN 5:26">“<char style="tl">मने</char>: परमेसर ह तोर राज करे के दिन के गनती कर ले हवय अऊ येकर अन्त आ गे हवय।<verse eid="DAN 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 5:27" />“<char style="tl">तकेल</char>: तेंह तराजू म तऊले जा चुके हवस अऊ तोला हल्का पाय गीस।<verse eid="DAN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 5:28" />“<char style="tl">परसीन</char>: तोर राज ला बांट देय गे हवय अऊ मादी अऊ फारसीमन ला दे दिये गे हवय।”<verse eid="DAN 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 5:29" />तब बेलसस्सर के हुकूम ले, दानिएल ला राजसी ओनहा पहिराय गीस, अऊ ओकर घेंच म सोन के एक माला पहिराय गीस, अऊ राज म तीसरा ऊंच पदवाले सासक के रूप म ओकर घोसना करे गीस।<verse eid="DAN 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 5:30" />ओहीच रथिया, बेबिलोनीमन<note caller="+" style="f"><char style="fr" closed="false">5:30 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> के राजा बेलसस्सर ह मार डारे गीस, <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />अऊ येकर बाद दारा, जऊन ह मादी रिहिस, बासठ बछर के उमर म ओ राज के राजा बनिस।<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s1">दानिएल ह सिंहमन के मांद म</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />दारा ला ये बने लगिस कि ओह 120 परधानमन ला ठहिराय, जऊन मन ओकर जम्मो राज म सासन करंय, <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />अऊ ये जम्मो के ऊपर तीन प्रसासक होवंय, जेमा ले एक झन दानिएल रिहिस। ओ परधानमन ला प्रसासकमन के प्रति जबाबदार बनाय गीस ताकि राजा ला कोनो किसम के हानि झन होवय। <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />दानिएल ह अपन असधारन गुन के कारन प्रसासक अऊ परधानमन के बीच म बहुंत मसहूर रिहिस, एकरसेति राजा ह ओला जम्मो राज के ऊपर सासक बनाय के योजना बनाईस। <verse eid="DAN 6:3" /><verse number="4" style="v" sid="DAN 6:4" />ये कारन, आने प्रसासक अऊ परधानमन सरकारी काम म दानिएल के कामकाज के बिरूध दोस लगाय के अधार खोजे लगिन, पर ओमन अइसे नइं कर सकिन। ओमन ला ओमा कोनो भ्रस्टाचार के बात नइं मिलिस, काबरकि दानिएल ह बिसवासयोग्य रिहिस अऊ ओह न तो भ्रस्टाचारी रिहिस अऊ न ही ओह कोनो काम म असावधानी बरतय। <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />आखिर म, ये मनखेमन कहिन, “ओकर परमेसर के कानून के बिसय ला छोंड़, हमन ला अऊ कोनो घलो बिसय म दानिएल के बिरूध दोस लगाय के अधार नइं मिलय।”<verse eid="DAN 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 6:6" />एकरसेति ये प्रसासक अऊ परधानमन एक दल के रूप म राजा करा गीन अऊ ओमन कहिन: “राजा दारा चिरंजीवी हो! <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />राज के जम्मो साही प्रसासक, मुखिया, परधान, सलाहकार अऊ राजपालमन ये बात ऊपर सहमत होईन कि राजा ह एक राज हुकूम निकालय अऊ ओ हुकूम ला माने बर कहय कि अगले तीस दिन तक कोनो घलो मनखे महाराजा के छोंड़ कोनो अऊ देवता या मनखे-परानी ले पराथना करय, त ओला सिंहमन के मांद म डाल दिये जावय। <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />हे महाराज, अब अइसे हुकूम दे अऊ ओला लिखित म घलो देय ताकि येला बदले झन जा सकय—मादी अऊ फारसीमन के कानून के मुताबिक जऊन ला रद्द नइं करे जा सकय।” <verse eid="DAN 6:8" /><verse number="9" style="v" sid="DAN 6:9" />तब राजा दारा ह ओ हुकूम ला लिखित म कर दीस।<verse eid="DAN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 6:10" />जब दानिएल ला पता चलिस कि अइसे हुकूम निकाले गे हवय, त ओह अपन घर जाके ऊपर के कमरा म गीस, जिहां खिड़कीमन यरूसलेम कोति खुले रहंय। दिन म तीन बार माड़ी टेकके ओह अपन परमेसर ला धनबाद देवत पराथना करिस, जइसे कि ओह पहिले घलो करय। <verse eid="DAN 6:10" /><verse number="11" style="v" sid="DAN 6:11" />तब ये मनखेमन एक दल के रूप म उहां गीन अऊ ओमन दानिएल ला परमेसर ले पराथना करत अऊ मदद मांगत पाईन। <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />एकरसेति ओमन राजा करा गीन अऊ ओला ओकर राज हुकूम के बारे म कहे लगिन: “का तेंह अइसे हुकूम नइं निकाले हवस कि अगले तीस दिन तक कोनो घलो मनखे महाराजा के छोंड़ कोनो अऊ देवता या मनखे-परानी ले पराथना करय, त ओला सिंहमन के मांद म डार दिये जाही?”</para>
  <para style="p" vid="DAN 6:12">राजा ह जबाब दीस, “ये हुकूम त हवय—जऊन ला मादी अऊ फारसीमन के कानून के मुताबिक रद्द नइं करे जा सकय।”<verse eid="DAN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 6:13" />तब ओमन राजा ला कहिन, “दानिएल, जऊन ह यहूदा प्रदेस ले लाने गय बंधुवा मनखेमन ले एक जन अय, हे महाराज, ओह तोर या तोर दुवारा निकाले गय लिखित हुकूम के परवाह नइं करत हे। ओह अभी घलो दिन म तीन बार पराथना करथे।” <verse eid="DAN 6:13" /><verse number="14" style="v" sid="DAN 6:14" />ये बात ला सुनके राजा ह बहुंत उदास होईस; ओह दानिएल ला बचाय बर ठान ले रिहिस अऊ बेर के बुड़त तक ओह दानिएल ला बचाय के हर किसम के कोसिस करिस।<verse eid="DAN 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 6:15" />तब मनखेमन एक दल के रूप म राजा दारा करा गीन अऊ ओला कहिन, “हे महाराज, सुरता रख कि मादी अऊ फारसीमन के कानून के मुताबिक राजा के दुवारा दिये गय कोनो घलो फैसला या राज हुकूम बदले नइं जा सकय।”<verse eid="DAN 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16" />तब राजा ह हुकूम दीस, अऊ ओमन दानिएल ला लानिन अऊ ओला सिंहमन के मांद म डार दीन। राजा ह दानिएल ले कहिस, “तोर परमेसर, जेकर सेवा तेंह ईमानदारी ले करथस, ओह तोला बचावय!”<verse eid="DAN 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 6:17" />एक पथरा ला लानके मांद के मुंहाटी म रख दिये गीस, अऊ राजा अपन खुद के मुहरवाला मुंदरी अऊ अपन परभावसाली मनखेमन के मुंदरी ले ओकर ऊपर मुहर लगा दीस, ताकि दानिएल के हालत म कोनो बदलाव झन करे जा सकय। <verse eid="DAN 6:17" /><verse number="18" style="v" sid="DAN 6:18" />तब राजा ह अपन महल म लहुंट आईस अऊ ओह पूरा रथिया बिगर कुछू खाय अऊ बिगर कुछू मनोरंजन के बिताईस। अऊ ओह सुते नइं सकिस।<verse eid="DAN 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19" />बड़े बिहनियां, राजा ह उठिस अऊ जल्दी करके सिंह के मांद करा गीस। <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />जब ओह मांद के लकठा म आईस, त ओह दुख भरे अवाज म दानिएल ला पुकारिस, “हे दानिएल, जीयत परमेसर के सेवक, का तोर ओ परमेसर ह तोला सिंहमन ले बचाय म समर्थ होईस, जेकर तेंह हमेसा सेवा करथस?”<verse eid="DAN 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 6:21" />तब दानिएल ह जबाब दीस, “राजा चिरंजीवी होवय! <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />मोर परमेसर ह अपन स्वरगदूतमन ला पठोके सिंहमन के मुहूं ला बंद कर दीस। ओमन मोर कुछू हानि नइं करिन, काबरकि मेंह ओकर नजर म निरदोस पाय गेंव। अऊ हे महाराज, न ही मेंह तोर आघू म कोनो गलत काम करे हंव।”<verse eid="DAN 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 6:23" />तब राजा ह बहुंत खुस होईस अऊ ओह हुकूम दीस कि दानिएल ला मांद ले निकाले जावय। अऊ जब दानिएल ला मांद ले तीरके बाहिर निकाले गीस, त ओमा कोनो किसम के चोट के निसान नइं मिलिस, काबरकि ओह अपन परमेसर ऊपर भरोसा रखे रिहिस।<verse eid="DAN 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 6:24" />ओ मनखे, जऊन मन दानिएल ऊपर गलत रूप से दोस लगाय रिहिन, ओमन ला राजा के हुकूम ले लाने गीस, अऊ ओमन ला ओमन के घरवाली अऊ लइकामन सहित सिंह के मांद म डार दिये गीस। अऊ येकर पहिले कि ओमन मांद के तल म हबरतिन, सिंहमन झपटके ओमन ला धर लीन अऊ हाड़ा समेत ओमन ला चबा डारिन।<verse eid="DAN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25" />तब राजा दारा ह जम्मो धरती म जम्मो जाति अऊ भासा के मनखेमन ला ये लिख भिजवाईस:</para>
  <para style="pmo" vid="DAN 6:25">“तुमन जम्मो बहुंत उन्नति करव!<verse eid="DAN 6:25" /></para>
  <para style="pm">
    <verse number="26" style="v" sid="DAN 6:26" />“मेंह ये हुकूम देवत हंव कि मोर राज के हर भाग म, मनखेमन दानिएल के परमेसर के भय मानंय अऊ ओकर भक्ति करंय।</para>
  <para style="qm1" vid="DAN 6:26">“काबरकि ओह जीयत परमेसर अय</para>
  <para style="qm2" vid="DAN 6:26">अऊ ओह सदाकाल तक बने रहिथे;</para>
  <para style="qm1" vid="DAN 6:26">ओकर राज के नास नइं होही,</para>
  <para style="qm2" vid="DAN 6:26">अऊ ओकर परभूता कभू खतम नइं होही।<verse eid="DAN 6:26" /></para>
  <para style="qm1">
    <verse number="27" style="v" sid="DAN 6:27" />ओह छुड़ाथे अऊ ओह बचाथे;</para>
  <para style="qm2" vid="DAN 6:27">ओह स्वरग अऊ धरती म</para>
  <para style="qm2" vid="DAN 6:27">चिनहां अऊ चमतकार देखाथे।</para>
  <para style="qm1" vid="DAN 6:27">ओह दानिएल ला</para>
  <para style="qm2" vid="DAN 6:27">सिंहमन के सक्ति ले बचाय हवय।”<verse eid="DAN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 6:28" />ये किसम ले दानिएल ह दारा अऊ फारस देस के राजा कुसरू<note caller="+" style="f"><char style="fr" closed="false">6:28 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">दारा</char></note> के सासनकाल म उन्नति करिस।<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="s1">दानिएल के चार पसुमन के सपना</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />बेबिलोन के राजा बेलसस्सर के राज के पहिले बछर म, दानिएल जब अपन पलंग म लेटे रिहिस, त ओह एक सपना अऊ मन म दरसन देखिस। ओह अपन सपना के सार बातमन ला लिख लीस।<verse eid="DAN 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 7:2" />दानिएल ह कहिस: “रथिया मेंह अपन दरसन म देखेंव कि अकास के चारों दिग ले महासागर ऊपर हवा चले लगिस। <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" />तब चार बड़े-बड़े पसु समुंदर ले निकलिन, अऊ येमन दिखे म एक-दूसर ले अलग रिहिन।<verse eid="DAN 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 7:4" />“पहिली पसु ह सिंह के सहीं रिहिस, जेकर गिधवा के सहीं डेना रिहिन, मोर देखत म ही ओकर डेनामन ला चीथ डारे गीस अऊ येला भुइयां ले उठाय गीस, जेकर ले येह मनखे के सहीं दू ठन गोड़ म ठाढ़ हो गीस, अऊ ओला एक मनखे के मन दिये गीस।<verse eid="DAN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 7:5" />“अऊ ओकर बाद मेंह दूसरा पसु ला देखेंव, जऊन ह भालू के सहीं दिखत रिहिस। ओला ओकर एक कोति ले उठाय गीस, अऊ ओकर मुहूं म ओकर दांतमन के बीच म तीन ठन पसलीमन रिहिन। ओला कहे गीस, ‘उठ अऊ पेट के भरत ले मांस खा!’<verse eid="DAN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 7:6" />“ओकर बाद, मेंह अपन आघू म एक आने पसु ला देखेंव, जऊन ह चीतवा के सहीं दिखत रिहिस। अऊ ओकर पीठ म चिरई के सहीं चार ठन डेना रिहिन। ये पसु के चार ठन मुड़ रिहिन, अऊ येला सासन करे के अधिकार दिये गीस।<verse eid="DAN 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 7:7" />“ओकर बाद, रथिया मेंह अपन दरसन म एक चौथा पसु ला अपन आघू म देखेंव, जऊन ह भयंकर, डरावना अऊ बहुंत सक्तिसाली रिहिस। येकर बड़े-बड़े लोहा के दांत रिहिन; येह कुचरके अपन सिकार ला खा जावय अऊ बांचे-खुचे ला अपन पांव खाल्हे कुचर डारय। येह पहिली के जम्मो पसुमन ले अलग रिहिस, अऊ येकर दस ठन सींग रिहिन।<verse eid="DAN 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 7:8" />“जब मेंह ये सींगमन के बारे म सोचत रहेंव, तभे मेंह देखेंव कि ओ सींगमन के बीच म ले एक ठन अऊ छोटकन सींग निकलिस; अऊ ये सींग के निकले ले उहां पहिली के तीन ठन सींग अपन जड़ ले उखन गीन। ये छोटे सींग के एक मनखे के सहीं आंखीमन रहंय अऊ एक मुहूं रिहिस जऊन ह घमंड ले भरे बात करत रिहिस।<verse eid="DAN 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9" />“जइसे कि मेंह देखेंव,</para>
  <para style="q1" vid="DAN 7:9">“उहां सिंघासनमन ला रखे गीस,</para>
  <para style="q2" vid="DAN 7:9">अऊ ओ अति प्राचीन<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमेसर</char></note> ह अपन आसन म बईठिस।</para>
  <para style="q1" vid="DAN 7:9">ओकर ओनहा ह बरफ के सहीं सफेद रिहिस;</para>
  <para style="q2" vid="DAN 7:9">ओकर मुड़ के चुंदी ह ऊन के सहीं सफेद रिहिस।</para>
  <para style="q1" vid="DAN 7:9">ओकर सिंघासन ह आगी ले जुवालामय रिहिस,</para>
  <para style="q2" vid="DAN 7:9">अऊ सिंघासन के चक्कामन ले जुवाला निकलत रिहिस।<verse eid="DAN 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="DAN 7:10" />ओकर आघू ले एक आगी के नदी</para>
  <para style="q2" vid="DAN 7:10">निकलके बोहावत रिहिस।</para>
  <para style="q1" vid="DAN 7:10">हजारों-हजार मनखेमन<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">स्वरगदूत</char></note> ओकर सेवा म लगे रिहिन;</para>
  <para style="q2" vid="DAN 7:10">लाखों-करोड़ों मनखेमन<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अनगिनत स्वरगदूत</char></note> ओकर आघू म ठाढ़े रिहिन।</para>
  <para style="q1" vid="DAN 7:10">नियायधीस ह बईठ गीस,</para>
  <para style="q2" vid="DAN 7:10">अऊ किताबमन खोले गीन।<verse eid="DAN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 7:11" />“ओ सींग ह घमंड ले भरे बात करत रिहिस, एकरसेति मेंह ओती लगातार देखत रहेंव। मेंह तब तक देखते रहेंव जब तक कि ओ पसु के बध करके ओकर देहें ला नास नइं कर दिये गीस अऊ धधकत आगी म नइं फटिक दिये गीस। <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />(आने पसुमन के अधिकार ला छीन लिये गे रिहिस, पर एक निरधारित समय तक ओमन ला जीयत रहे के अधिकार दिये गीस।)<verse eid="DAN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13" />“रथिया मेंह अपन दरसन म देखेंव कि मनखे के बेटा सहीं एक झन अकास के बादरमन के संग आवत रिहिस। ओह बहुंत प्राचीन करा आईस अऊ ओला ओकर आघू म लाने गीस। <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" />ओला अधिकार, महिमा अऊ सर्वोच्च सक्ति दिये गीस; जम्मो जाति अऊ हर भासा के मनखेमन ओकर अराधना करिन। ओकर परभूता सदाकाल बर अय, जेकर अन्त कभू नइं होही, अऊ ओकर राज ह अइसन राज अय, जऊन ह कभू नास नइं होही।<verse eid="DAN 7:14" /></para>
  <para style="s1">सपना के अर्थ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />“में, दानिएल ह मन म बहुंत बियाकुल होयेंव, अऊ जऊन दरसन मेंह अपन मन म देखेंव, ओह मोर मन ला बिचलित कर दीस। <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />उहां खड़े मनखेमन म ले एक झन करा मेंह गेंव अऊ ओकर ले ये जम्मो बात के अर्थ पुछेंव।</para>
  <para style="p" vid="DAN 7:16">“ओह ये कहिके मोला ये बातमन के अर्थ बताईस: <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />‘चार बड़े पसुमन चार राजा अंय, जेमन धरती म ठाढ़ होहीं। <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" />पर सर्वोच्च परमेसर के पबितर मनखेमन ला ही राज मिलही अऊ ओमन ओला अपन अधिकार म सदाकाल तक रखहीं—हव, सदाकाल तक।’<verse eid="DAN 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 7:19" />“तब मोर मन म ओ चौथा पसु के अर्थ ला जाने के ईछा होईस, जऊन ह आने जम्मो पसुमन ले अलग रिहिस अऊ जऊन ह अपन लोहा के दांत अऊ कांसा के पंजामन के संग बहुंत डरावना रिहिस—ओ पसु जऊन ह अपन सिकार ला कुचरके खा जावय अऊ बचे भाग ला अपन पांव ले कुचर डारय। <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />मोला ये बातमन के घलो अर्थ जाने के ईछा होईस—ओकर मुड़ के दस ठन सींग अऊ ओ आने सींग, जेकर निकल आय ले, उहां के पहिली के तीन सींग गिर गीन—ये सींग जऊन ह आने सींगमन ले जादा रोबदार दिखत रिहिस अऊ जेकर आंखीमन रिहिन अऊ एक मुहूं घलो रिहिस, जेकर ले ओह घमंड ले भरे बात करय। <verse eid="DAN 7:20" /><verse number="21" style="v" sid="DAN 7:21" />जइसे कि मेंह देखेंव, ये सींग ह पबितर मनखेमन ले लड़ई करत रिहिस अऊ ओमन ला तब तक हरातेच रिहिस, <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />जब तक कि अति प्राचीन ह आके सर्वोच्च परमेसर के पबितर मनखेमन के हित म फैसला नइं दे दीस, अऊ ओ समय आईस, जब ओमन राज ऊपर अधिकार कर लीन।<verse eid="DAN 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23" />“ओह मोला ये अर्थ बताईस: ‘ओ चौथा पसु ह एक चौथा राज अय, जऊन ह धरती म परगट होही। येह आने जम्मो राजमन ले अलग होही अऊ येह जम्मो धरती ला रऊंदत अऊ कुचरत नास कर दीही। <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" />ओ दस ठन सींग दस राजा अंय, जऊन मन ये राज ले आहीं। ओमन के बाद, एक आने राजा आही, जऊन ह पहिली के राजामन ले अलग होही; ओह तीन राजामन ला अपन अधीन म कर लीही। <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" />ओह सर्वोच्च परमेसर के बिरूध बोलही अऊ ओकर पबितर मनखेमन ला सताही अऊ ठहिराय गय समय अऊ कानूनमन ला बदले के कोसिस करही। पबितर मनखेमन ला एक समय, समयमन अऊ आधा समय बर ओकर अधीन करे जाही।<verse eid="DAN 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 7:26" />“ ‘पर नियायधीस ह बईठही, अऊ ओकर सक्ति ओकर ले लेय लिये जाही अऊ ओला हमेसा बर पूरा नास कर दिये जाही। <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" />तब सर्वोच्च परमेसर के पबितर मनखेमन ला धरती के जम्मो राज के परभूता, सक्ति अऊ महानता दे दिये जाही। ओकर राज ह सदाकाल तक बने रहइया राज होही, अऊ जम्मो सासकमन ओकर अराधना करहीं अऊ ओकर बात मानहीं।’<verse eid="DAN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 7:28" />“इहां ओ बिसय के अन्त होथे। में, दानिएल ह अपन बिचारमन ले बहुंत बियाकुल हो गेंव, अऊ मोर चेहरा ह पिंवरा पड़ गीस, पर ये बात ला मेंह अपन मन म ही रखेंव।”<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s1">दानिएल के एक मेढ़ा अऊ एक बोकरा के दरसन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />राजा बेलसस्सर के सासन के तीसरा बछर म, में दानिएल ह पहिले के दरसन के बाद एक अऊ दरसन देखेंव। <verse eid="DAN 8:1" /><verse number="2" style="v" sid="DAN 8:2" />अपन दरसन म, मेंह अपनआप ला एलाम प्रदेस के सूसन सहर के किला म देखेंव, दरसन म, मेंह ऊलई नहर के तीर म रहेंव। <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />मेंह आंखी उठाके देखेंव कि नहर के तीर म एक ठन मेढ़ा खड़े रहय, जेकर दू ठन सींग रिहिन, अऊ ये सींगमन लम्बा रिहिन। येमा ले एक सींग ह दूसर सींग ले बड़े रिहिस अऊ ये बड़े सींग ह बाद म निकले रिहिस। <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />मेंह देखेंव कि ये मेढ़ा ह पछिम अऊ उत्तर अऊ दक्खिन कोति मुड़ ले टक्कर मारत रहय। कोनो घलो पसु ओकर आघू म टिक नइं सकिन, अऊ अइसे कोनो नइं रिहिस, जऊन ह ओकर सक्ति ले बचा सकतिस। ओह जइसे चाहिस, वइसे करिस अऊ बहुंत बड़े हो गीस।<verse eid="DAN 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5" />जब मेंह येकर बारे म सोचत रहेंव, तब मेंह देखेंव कि अचानक एक बोकरा पछिम दिग ले आईस, जेकर आंखीमन के बीच म एक बिसेस सींग रिहिस, अऊ ये बोकरा ह जम्मो धरती ला पार करके भुइयां ला बिगर छुए आय रिहिस <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />ये बोकरा ह ओ दू ठन सींगवाले मेढ़ा कोति आईस, जऊन ला मेंह नहर के तीर म खड़े देखे रहेंव अऊ बहुंत रिस म होके ओ मेढ़ा ला टक्कर मारिस। <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />मेंह देखेंव कि ये बोकरा ह बहुंत गुस्सा होके ओ मेढ़ा ऊपर हमला करिस, अऊ ओला टक्कर मारत ओकर दूनों सींग ला टोर दीस। मेढ़ा म अतेक ताकत नइं रिहिस कि ओह ओ बोकरा के सामना कर सकय; बोकरा ह मेढ़ा ला भुइयां म गिराके ओला कुचर डारिस, अऊ ओकर सक्ति ले मेढ़ा ला कोनो बचा नइं सकिन। <verse eid="DAN 8:7" /><verse number="8" style="v" sid="DAN 8:8" />बोकरा ह बहुंत सक्तिसाली हो गीस, पर ओकर सक्ति के ऊंचई म, ओकर बड़े सींग ह टूट गीस, अऊ ओकर जगह म चार बिसेस सींग निकलके चारों दिग म बढ़न लगिन।<verse eid="DAN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 8:9" />ओमा के एक ले एक ठन अऊ सींग निकलिस, जेकर सुरूआत छोटकन रूप म होईस पर सक्ति म येह दक्खिन, पूरब अऊ सुघर देस कोति बाढ़ गीस। <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" />ओह तब तक बाढ़तेच रिहिस जब तक कि अकास के सेनामन करा नइं हबर गीस, अऊ ओह तारामन के कुछू सेना ला खाल्हे धरती ऊपर फटिक दीस अऊ ओमन ला कुचर डारिस। <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />ओह अपनआप ला यहोवा के सेना के सेनापति के सहीं बड़े बना लीस; ओह यहोवा ला चघाय जवइया रोज के बलिदान ला लूट लीस, अऊ ओकर पबितर-स्थान ला खाल्हे फेंकवा दीस। <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />बिदरोह के कारन, यहोवा के मनखेमन<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सेना</char></note> अऊ हर दिन के बलिदान ओला दे दिये गीन। ओह जऊन कुछू घलो करिस, ओमा ओकर बढ़ती होवत गीस, अऊ सच्चई ला भुइयां ऊपर फटिक दिये गीस।<verse eid="DAN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 8:13" />तब मेंह एक पबितर जन ला बोलत सुनेंव, फेर एक आने पबितर जन ह पहिलेवाले ले पुछिस, “दरसन ला पूरा होय बर कतेक समय लगही—ओ दरसन, जेमा हर दिन के बलिदान, बिदरोह जऊन ह उजाड़ के कारन बनथे, पबितर-स्थान के समरपन अऊ यहोवा के मनखेमन ला गोड़ खाल्हे रऊंदे जवई देखाय गे हवय?”<verse eid="DAN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 8:14" />ओह मोला कहिस, “येला पूरा होय म 2,300 बिहान अऊ सांझ लगही; तब पबितर-स्थान ला फेर सुध करे जाही।”<verse eid="DAN 8:14" /></para>
  <para style="s1">दरसन के अर्थ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />जब में, दानिएल ह दरसन ला देखके, येला समझे के कोसिस करत रहेंव, तभे मेंह देखेंव कि मोर आघू म एक जन खड़े होईस, जऊन ह एक मनखे के सहीं दिखत रहय। <verse eid="DAN 8:15" /><verse number="16" style="v" sid="DAN 8:16" />अऊ मेंह ऊलई नहर ले एक झन मनखे के अवाज ला सुनेंव, जऊन ह पुकारके कहत रहय, “हे जिब्राएल, ये मनखे ला ओ दरसन के अर्थ बता।”<verse eid="DAN 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 8:17" />जब ओह ओ जगह के लकठा म आईस, जिहां मेंह खड़े रहेंव, त मेंह डर गेंव अऊ मुहूं के भार गिरेंव। तब ओ मनखे ह मोला कहिस, “हे मनखे के बेटा, ये बात ला समझ ले कि ये दरसन ह अन्त के समय के बारे म अय।”<verse eid="DAN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 8:18" />जब ओह मोर ले गोठियावत रिहिस, तब मेंह भुइयां कोति अपन चेहरा करे पड़े रहेंव अऊ गहिरा नींद म रहेंव। तब ओह मोला छुईस अऊ मोला मोर गोड़ म ठाढ़ कर दीस।<verse eid="DAN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 8:19" />ओह कहिस, “मेंह तोला ओ बातमन ला बतइया हंव, जऊन ह बाद म कोप<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमेसर के कोप</char></note> के समय होही, काबरकि ये दरसन ह ठहिराय गय अन्त के समय के बारे म अय। <verse eid="DAN 8:19" /><verse number="20" style="v" sid="DAN 8:20" />जऊन दू सींगवाला मेढ़ा तेंह देखे, ओह मादै अऊ फारसी राजामन ला देखाथे। <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />ओ रूखा बालवाला बोकरा ह यूनान के राजा ए, अऊ ओकर आंखीमन के बीच के ओ बड़े सींग ह पहिला राजा ए। <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />ओ चार ठन सींग, जऊन मन एक टूटे सींग के जगह म निकलिन, ओमन ओ चार राजमन ला देखाथें, जऊन मन ओहीच देस ले निकलहीं, पर ओमन के सक्ति पहिले के राज सहीं नइं होही।<verse eid="DAN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 8:23" />“ओमन के सासन के बाद के समय म, जब बिदरोहीमन अपन पूरा बुरई के काम म होहीं, तब भयानक दिखइया एक राजा के उदय होही, जऊन ह सडयंत्र करे म माहिर होही। <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />ओह बहुंत सक्तिसाली हो जाही, पर अपन खुद के सक्ति ले नइं। ओह भयंकर बिनास करही अऊ जऊन कुछू घलो ओह करही, ओमा ओह सफल होही। ओह ओमन ला नास करही, जऊन मन सक्तिसाली, पबितर मनखे अंय। <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />ओह बढ़े बर छल-परपंच करही, अऊ ओह अपनआप ला बहुंत बड़े समझही। जब ओमन सुरकछित महसूस करत होहीं, तभे ओह बहुंते जन ला नास कर दीही अऊ राजकुमारमन के राजकुमार के बिरूध ठाढ़ होही। तभो ले ओह नास करे जाही, पर कोनो मानव सक्ति के दुवारा नइं।<verse eid="DAN 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 8:26" />“सांझ अऊ बिहनियां के जऊन दरसन तोला दिये गे हवय, ओह सच अय, पर तेंह ये दरसन ला गुपत म रख, काबरकि येह बहुंत आघू के अगम के बारे म अय।”<verse eid="DAN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 8:27" />में, दानिएल ह लस्त पड़ गे रहेंव। मेंह थकके बहुंत दिन तक पड़े रहेंव। फेर मेंह उठेंव अऊ राजा के कामकाज म लग गेंव। मेंह दरसन ले डरा गे रहेंव; येह समझ के बाहिर के बात रिहिस।<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="s1">दानिएल के पराथना</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />(मादी बंस के) छयर्स के बेटा दारा ला बेबिलोनीमन<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> के राज के सासक बनाय गे रिहिस। <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" />ओकर राज के पहिला बछर म, में, दानिएल ह यरमियाह अगमजानी ला दिये गय यहोवा के बचन के मुताबिक ओकर पबितर बचन ले ये समझ गेंव कि यरूसलेम ह सत्तर बछर तक निरजन बने रहिही। <verse eid="DAN 9:2" /><verse number="3" style="v" sid="DAN 9:3" />एकरसेति मेंह बोरा के ओनहा पहिरे, राख चुपरे, उपास करत परभू परमेसर ले गिड़गिड़ाके पराथना अऊ बिनती करेंव।<verse eid="DAN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 9:4" />मेंह यहोवा, अपन परमेसर ले ये किसम ले पराथना करेंव अऊ अपन पापमन ला मान लेंव:</para>
  <para style="pm" vid="DAN 9:4">“हे परभू, महान अऊ अद्भूत परमेसर, तेंह ओमन के संग अपन मया के करार ला बनाय रखथस, जऊन मन तोर ले मया करथें अऊ तोर हुकूममन ला मानथें, <verse eid="DAN 9:4" /><verse number="5" style="v" sid="DAN 9:5" />हमन पाप करे हन अऊ गलत काम करे हन। हमन दुस्ट काम करके बिदरोह करे हन; हमन तोर हुकूम अऊ कानूनमन ले दूरिहा चल दे हन। <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />हमन तोर ओ सेवक अगमजानीमन के बात ला नइं सुनेंन, जेमन तोर नांव ले हमर राजा, हमर हाकिम अऊ हमर पुरखा, अऊ देस के जम्मो मनखेमन ले बात करिन।<verse eid="DAN 9:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="DAN 9:7" />“हे परभू, तेंह धरमी अस, पर आज हमन बहुंत सरमिंदा हवन—यहूदा के मनखे अऊ यरूसलेम के रहइया अऊ जम्मो इसरायली, जऊन मन लकठा या दूरिहा म हवंय, तोर बर बिसवासयोग्य नइं ठहिरे के कारन तेंह ओमन ला जम्मो देस म तितिर-बितिर कर दे हस। <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />हे यहोवा, हमन अऊ हमर राजा, हमर हाकिम अऊ हमर पुरखामन बहुंत सरमिंदा हवंय, काबरकि हमन तोर बिरूध म पाप करे हन। <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />हालाकि हमन तोर बिरूध बिदरोह करे हन, तभो ले हे परभू हमर परमेसर, तेंह दयालु अऊ छेमा करइया अस; <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />हमन यहोवा हमर परमेसर के बात ला नइं माने हन या ओ कानूनमन के पालन नइं करे हन, जऊन ला ओह अपन सेवक अगमजानीमन के जरिये हमन ला देय रिहिस। <verse eid="DAN 9:10" /><verse number="11" style="v" sid="DAN 9:11" />जम्मो इसरायल ह तोर कानून के उलंघन करे हवय अऊ तोर बातमन ला माने के बदले, ओमन ले दूरिहा हो गे हवय।</para>
  <para style="pm" vid="DAN 9:11">“एकरसेति परमेसर के सेवक, मूसा के कानून म लिखे सराप अऊ ठहिराय गे दंड हमर ऊपर डार देय गे हवय, काबरकि हमन तोर बिरूध पाप करे हवन। <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />तेंह हमर ऊपर बड़े बिपत्ति लानके हमर अऊ हमर सासकमन के बिरूध कहे गय बचन ला पूरा करे हस। जम्मो धरती म अइसने बिपत्ति अऊ कहूं नइं पड़िस, जइसने बिपत्ति यरूसलेम म पड़े हवय। <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />जइसे कि मूसा के कानून म लिखे हवय, ये जम्मो बिपत्ति हमर ऊपर आय हवय, तभो ले हमन न तो यहोवा हमर परमेसर के अनुग्रह पाय के कोसिस करेंन, अऊ न ही अपन पापमन ला छोंड़के तोर सच्चई ऊपर धियान दे हवन। <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />एकरसेति यहोवा हमर ऊपर बिपत्ति लाय म नइं हिचकिचाईस, काबरकि यहोवा हमर परमेसर जऊन कुछू घलो करथे, ओ जम्मो बात म ओह धरमीपन देखाथे; तभो ले हमन ओकर बात ला नइं मानेंन।<verse eid="DAN 9:14" /></para>
  <para style="pm">
    <verse number="15" style="v" sid="DAN 9:15" />“अब, हे परभू हमर परमेसर, जऊन ह अपन सक्तिसाली हांथ ले अपन मनखेमन ला मिसर देस ले निकाल लाने अऊ अपन बर एक नांव बनाय, जऊन ह आज तक बने हवय, पर हमन पाप करे हवन, हमन गलत काम करे हवन। <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />हे परभू, तें अपन जम्मो धरमी काम ला धियान म रखत, अपन कोरोध अऊ कोप ला यरूसलेम सहर ले दूरिहा रख, जऊन ह कि तोर सहर अऊ तोर पबितर पहाड़ी ए। हमर पाप अऊ हमर पुरखामन के अपराध ह यरूसलेम अऊ तोर मनखेमन ला ओ जम्मो झन के आघू म अनादर के चीज बना दे हवय, जऊन मन हमर आसपास म रहिथें।<verse eid="DAN 9:16" /></para>
  <para style="pm">
    <verse number="17" style="v" sid="DAN 9:17" />“अब, हे हमर परमेसर, अपन सेवक के पराथना अऊ बिनती ला सुन। हे परभू, अपन हित म, अपन सुनसान पड़े पबितर-स्थान ऊपर किरपा कर। <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />हे हमर परमेसर, कान लगाके सुन अऊ आंखी उघारके ओ सहर<note caller="+" style="f"><char style="fr" closed="false">9:18 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरूसलेम</char></note> के सुन्नापन ला देख, जऊन ह तोर नांव ले जाने जाथे। हमन एकरसेति बिनती नइं करत हवन कि हमन धरमी अन, पर एकरसेति कि तेंह बड़े दयालु अस। <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />हे परभू, सुन! हे परभू, छेमा कर! हे परभू, सुन अऊ जऊन कुछू करना हे, ओला कर! अपन ही हित म, हे मोर परमेसर, देरी झन कर, काबरकि तोर सहर अऊ तोर मनखेमन तोर नांव ले जाने जाथें।”<verse eid="DAN 9:19" /></para>
  <para style="s1">सत्तर “सात”</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20" />जब मेंह अपन पाप अऊ अपन इसरायली मनखेमन के पाप ला मानत गोठियावत रहेंव अऊ पराथना करत रहेंव अऊ यहोवा मोर परमेसर करा ओकर पबितर पहाड़ी बर बिनती करत रहेंव— <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />जब मेंह पराथना म ही रहेंव, त ओ मनखे जिब्राएल, जऊन ला मेंह पहिले दरसन म देखे रहेंव, सांझ के बलिदान के बेरा तेजी से उड़ियावत मोर करा आईस। <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />ओह निरदेस देके मोला कहिस, “हे दानिएल, अब मेंह तोला अन्तर-दिरिस्टी अऊ समझे के सक्ति देय बर आय हंव। <verse eid="DAN 9:22" /><verse number="23" style="v" sid="DAN 9:23" />जतेक जल्दी तेंह पराथना करे के सुरू करे, तभे एक हुकूम दिये गीस, जऊन ला मेंह तोला बताय बर आय हंव, काबरकि तेंह बहुंत आदरनीय मनखे अस। एकरसेति ये बातमन ऊपर बिचार कर अऊ दरसन ला समझ ले:<verse eid="DAN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 9:24" />“तुम्हर मनखे अऊ तुम्हर पबितर सहर<note caller="+" style="f" category="dup"><char style="fr" closed="false">9:24 </char><char style="ft" closed="false">यरूसलेम</char></note> बर सत्तर ‘सात’ के आदेस देय गे हवय कि ओमन अपराध करई छोंड़ देवंय, पाप ला खतम कर देवंय, बुरई बर पछताप करंय, अपनआप म धरमीपन लानंय, दरसन अऊ अगमबानी के बात म मुहर लगाय जावय अऊ महा पबितर स्थान के अभिसेक करे जावय।<verse eid="DAN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 9:25" />“ये बात ला जानव अऊ समझ लव: यरूसलेम के फेर स्थापना अऊ पुनरनिरमान बर बचन के निकले के समय ले लेके अभिसिक्त जन तक, याने कि सासक के आवत तक सात<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सात हप्ता</char></note> ‘सात’ अऊ बासठ<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बासठ हप्ता</char></note> ‘सात’ के समय ठहिराय गे हवय। येकर पुनरनिरमान, गलीमन अऊ एक खाई के संग होही, पर येह कठिन समय म होही। <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />बासठ ‘सात’ के बाद अभिसिक्त जन ह मार डारे जाही अऊ कुछू नइं होही। सासन करइया के मनखेमन आहीं अऊ सहर अऊ पबितर-स्थान ला नास कर दीहीं। एक बाढ़ के सहीं अन्त आ जाही: आखिरी तक लड़ई होवत रहिही, अऊ उजाड़ करे के निरनय करे जा चुके हवय। <verse eid="DAN 9:26" /><verse number="27" style="v" sid="DAN 9:27" />ओह बहुंते जन के संग एक ‘सात’<note caller="+" style="f"><char style="fr" closed="false">9:27 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">हप्ता</char></note> बर एक करार के पुस्टि करही। ‘सात’ के बीच म ही, ओह बलिदान अऊ भेंट चघाय के अन्त कर दीही। अऊ मंदिर म एक नफरत के चीज ला स्थापित करही, जऊन ह उजाड़ के कारन बनही। येह तब तक होवत रहिही, जब तक कि ठहिराय गे समय के आखिरी म ओकर ऊपर बिनास ला नइं उंडेल दिये जाही।”<verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s1">दानिएल के एक मनखे के दरसन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />फारस के राजा कुसरू के सासनकाल के तीसरा बछर म दानिएल (जऊन ला बेलतसस्सर कहे जावय) ऊपर एक संदेस परगट करे गीस। ये संदेस ह सच रिहिस अऊ येकर संबंध एक बड़े लड़ई ले रिहिस। संदेस के समझ ह ओकर करा एक दरसन म आईस।<verse eid="DAN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 10:2" />ओ समय, में, दानिएल ह तीन हप्ता तक दुख मनावत रहेंव। <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />जब तक तीन हप्ता पूरा नइं हो गीस, तब तक में कोनो मनपसंद जेवन नइं करेंव; न मांस खांय, न मंद ला मुहूं म लगांय, अऊ न ही कोनो किसम के सुघरता के मलहम लगांय।<verse eid="DAN 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 10:4" />साल के पहिला महिना के चौबीसवां दिन, जब मेंह महान नदी तिगरीस के तीर म खड़े रहेंव, <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />त मेंह देखेंव कि उहां एक मनखे मलमल के ओनहा पहिरे, अपन कनिहां म उफाज देस के सुध सोन के पट्टा बांधे खड़े रहय। <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />ओकर देहें ह फिरोजा के सहीं, ओकर चेहरा बिजली सहीं, ओकर आंखीमन बरत मसाल सहीं, ओकर बाहां अऊ गोड़मन चमकत कांसा के किरन सहीं, अऊ ओकर अवाज मनखेमन के एक भीड़ के अवाज सहीं रहय।<verse eid="DAN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 10:7" />सिरिप में, दानिएल ह ओ दरसन ला देखेंव; जऊन मन मोर संग रिहिन, ओमन येला नइं देखिन, पर ओमन ऊपर अइसे भय छा गीस कि ओमन भागके लुका गीन। <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />एकरसेति मेंह एके झन बांचे रहेंव, अऊ ये बड़े दरसन ला एकटक देखतेच रहेंव; मोर म कुछू ताकत नइं रिहिस, मोर चेहरा ह एकदम उदास हो गीस अऊ मेंह निसहाय हो गेंव। <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />तब मेंह ओला कहत सुनेंव, अऊ जब में ओकर बात ला सुनेंव, त मेंह मुहूं के भार गिरके भारी नींद म पड़ गेंव।<verse eid="DAN 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 10:10" />तब एक झन के हांथ ह मोला छुईस अऊ मोर कांपत देहें ला मोर हांथ अऊ माड़ीमन म ठाढ़ कर दीस। <verse eid="DAN 10:10" /><verse number="11" style="v" sid="DAN 10:11" />ओह कहिस, “हे दानिएल, तें जो बहुंत आदरनीय मनखे अस, ओ बातमन ऊपर धियान देके बिचार कर, जऊन ला मेंह तोला बतानेचवाला हंव, अऊ अब तेंह ठाढ़ हो जा, काबरकि मोला तोर करा पठोय गे हवय।” अऊ जब ओह मोला ये बात कहिस, त मेंह कांपत ठाढ़ हो गेंव।<verse eid="DAN 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 10:12" />तब ओह मोला ये घलो कहिस, “हे दानिएल, झन डर। पहिली ही दिन ले, जब तेंह अपन मन ला समझ के बात ऊपर अऊ अपन परमेसर के आघू म अपनआप ला नम्र करे म लगाय, तब ले तोर बातमन ला सुने गीस, अऊ ओकरे जबाब के रूप म, मेंह इहां आय हवंव। <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />तब फारसी राज के राजकुमार ह इक्कीस दिन तक मोर सामना करिस। तब मुखिया राजकुमारमन ले एक, मिकाएल ह मोर मदद करे बर आईस, काबरकि मोला उहां फारस के राजा करा रोक लिये गे रिहिस। <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />अब मेंह तोला ओ बातमन ला बताय बर आय हवंव, जऊन ह अवइया समय म तुम्हर मनखेमन के संग होवइया हवय, काबरकि ये दरसन के संबंध अवइया एक समय ले हवय।”<verse eid="DAN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 10:15" />जब ओह मोला ये कहत रिहिस, त मेंह भुइयां कोति चेहरा झुकाके खड़े रहेंव अऊ मुक्का हो गेंव। <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />तब एक झन, जऊन ह एक मनखे<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मनखे के हांथ</char></note> के सहीं दिखत रहय, मोर ओंठ ला छुईस, अऊ मोर मुहूं ह खुल गीस अऊ मेंह बात करे लगेंव। मेंह ओला कहेंव, जऊन ह मोर आघू म खड़े रिहिस, “हे मोर परभू, ओ दरसन के कारन मेंह पीरा ले भर गे हंव, अऊ मोला बहुंत कमजोरी लगत हे। <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />हे मोर परभू, में, तोर सेवक, तोर ले कइसे बात कर सकत हंव? मोर म कुछू ताकत नइं ए अऊ मेंह बड़े मुसकिल से सांस ले सकत हंव।”<verse eid="DAN 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18" />तब ओ, जऊन ह एक मनखे के सहीं दिखत रिहिस, मोला फेर छुईस अऊ मोला ताकत दीस। <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />ओह कहिस, “झन डर, तेंह बहुंत आदरनीय मनखे अस, तोला सांति मिलय! अब मजबूत रह; मजबूत रह।”</para>
  <para style="p" vid="DAN 10:19">जब ओह मोर ले गोठियाईस, त मोला ताकत मिलिस अऊ मेंह ओला कहेंव, “हे मोर परभू, गोठिया, काबरकि तेंह मोला ताकत दे हस।”<verse eid="DAN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 10:20" />एकरसेति ओह कहिस, “का तेंह जानत हस कि मेंह तोर करा काबर आय हंव? बहुंत जल्दी मेंह फारस के राजकुमार के बिरूध लड़ई करे बर लहुंटके चल दूहूं, अऊ जब मेंह जाहूं, तब यूनान के राजकुमार ह आही; <verse eid="DAN 10:20" /><verse number="21" style="v" sid="DAN 10:21" />पर पहिली मेंह तोला बताहूं कि सच्चई के किताब म का लिखे हवय। (तुम्हर राजकुमार, मिकाएल ला छोंड़ अऊ कोनो घलो येमन ले लड़े बर मोर मदद नइं करंय।<verse eid="DAN 10:21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="nb">
    <verse number="1" style="v" sid="DAN 11:1" />अऊ मादी बंस के राजा दारा के सासनकाल के पहिले बछर म, मेंह ओकर मदद करे बर अऊ ओकर बचाव करे बर ठाढ़ होंय।)<verse eid="DAN 11:1" /></para>
  <para style="s1">दक्खिन अऊ उत्तर के राजा</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2" />“अब, मेंह तोला सच बात बतावत हंव: फारस म तीन अऊ राजामन होहीं, अऊ ओकर बाद एक चौथा राजा घलो होही, जऊन ह आने जम्मो राजामन ले बहुंत अधिक धनी होही। जब ओह अपन धन ले सक्ति पा लीही, तब ओह जम्मो झन ला यूनान के राज के बिरूध भड़काही। <verse eid="DAN 11:2" /><verse number="3" style="v" sid="DAN 11:3" />तब एक सक्तिसाली राजा के उदय होही, जऊन ह बड़े सक्ति ले राज करही अऊ ओह अपन मन मुताबिक करही। <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />ओकर उदय होय के बाद, ओकर राज ह टूट जाही अऊ चारों दिग म बंट जाही। येह ओकर संतानमन करा नइं जाही, अऊ न ही ओकर सक्ति ओ राज के ऊपर होही, काबरकि ओकर राज ला ओकर ले लूटके आने मन ला दे दिये जाही।<verse eid="DAN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5" />“दक्खिन के राजा ह सक्तिसाली हो जाही, पर ओकर ही एक सेनापति ह ओकर ले घलो जादा सक्तिसाली हो जाही अऊ अपन खुद के राज ऊपर बड़े सक्ति ले सासन करही। <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />कुछू बछर के बाद, ओमन सहयोगी हो जाहीं। दक्खिन के राजा के बेटी ह उत्तर के राजा करा एक संधि करे बर जाही, पर ओकर करा ओकर राज के सक्ति नइं रहिही, अऊ उत्तर के राजा अऊ ओकर सक्ति घलो नइं बांचही। ओ दिनमन म, दक्खिन के राजा के बेटी ला अऊ संग म ओकर साही रकछक अऊ ओकर ददा<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">लइका</char></note> अऊ ओकर मदद करइया ला धोखा दिये जाही।<verse eid="DAN 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 11:7" />“ओकर परिवार के एक जन ह ओकर जगह लेय बर ठाढ़ होही। ओह उत्तर के राजा के सेना ऊपर चढ़ई करही अऊ ओकर किला म घुसर जाही; ओह ओमन ले लड़ही अऊ बिजयी होही। <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />ओह ओमन के देवतामन ला, ओमन के धातु के मूरतीमन ला अऊ ओमन के सोन अऊ चांदी के कीमती चीजमन ला घलो जपत कर लीही अऊ अपन संग मिसर देस ले जाही। कुछू बछर तक, ओह उत्तर के राजा ला एके झन छोंड़ दीही। <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />तब उत्तर के राजा ह दक्खिन के राजा के राज ऊपर चढ़ई करही, पर अपन ही देस ला फेर लहुंट जाही। <verse eid="DAN 11:9" /><verse number="10" style="v" sid="DAN 11:10" />ओकर बेटामन लड़ई के तियारी करहीं अऊ एक बड़े सेना इकट्ठा करहीं, जऊन ह न रोके जा सकनेवाला बाढ़ सहीं तेजी ले आघू बढ़ही अऊ लड़ई ला ओकर किला तक ले जाहीं।<verse eid="DAN 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 11:11" />“तब दक्खिन के राजा कोरोधित होके आघू बढ़ही अऊ उत्तर के राजा ले लड़ई करही; उत्तर के राजा ह एक बड़े सेना खड़े करही, पर ओह हार जाही। <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />जब ये बड़े सेना ला ले लिये जाही, तब दक्खिन के राजा ह घमंड ले भर जाही अऊ कतको हजार मनखेमन ला मार डारही, तभो ले ओह बिजयी बने नइं रह सकही। <verse eid="DAN 11:12" /><verse number="13" style="v" sid="DAN 11:13" />काबरकि उत्तर के राजा ह एक आने सेना खड़े कर लीही, जऊन ह ओकर पहिले के सेना ले बड़े होही; अऊ बहुंत बछर के बाद, पूरा तियारी करके, ओह एक बड़े सेना ला लेके आघू बढ़ही।<verse eid="DAN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 11:14" />“ओ दिनमन म, बहुंते झन दक्खिन के राजा के बिरूध खड़े होहीं। तुम्हर अपन मनखेमन के बीच म, जऊन मन हिंसक सुभाव के अंय, ओमन बिदरोह करहीं, ताकि दरसन ह पूरा होवय, पर ओमन ला सफलता नइं मिलही। <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />तब उत्तर के राजा ह आके सैनिकमन के घेरा डालही अऊ एक किलावाले सहर ऊपर कब्जा कर लीही। दक्खिन के सेना म बिरोध करे के सक्ति नइं होही; अऊ त अऊ ओमन के सबले बने सैनिक दल करा घलो सामना करे के सक्ति नइं होही। <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />हमला करइया ह जइसे चाहही, वइसे करही; ओकर सामना कोनो नइं कर सकहीं। ओह अपनआप ला ओ सुघर देस म स्थापित करही अऊ ओकर करा ओला नास करे के सक्ति होही। <verse eid="DAN 11:16" /><verse number="17" style="v" sid="DAN 11:17" />ओह अपन जम्मो राज के सक्ति के संग आय के ठान लीही अऊ ओह दक्खिन के राजा के संग एक संधि करही। अऊ ओकर राज ला जीते बर ओ राजा ला अपन एक बेटी बिहाव म दीही, पर ओकर योजना ह सफल नइं होही या ओकर ले ओला कोनो मदद नइं मिलही। <verse eid="DAN 11:17" /><verse number="18" style="v" sid="DAN 11:18" />तब ओह अपन धियान समुंदर तीर म लगाही अऊ ओमा ले कतको ला अपन अधिकार म ले लीही, पर एक सेनापति ह ओकर अहंकार के अन्त कर दीही अऊ ओकर अहंकार के मुताबिक ओकर ले बदला लीही। <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />येकर बाद, ओह अपन ही देस के किलामन कोति लहुंटही, पर ओह लड़खड़ाके गिर जाही अऊ ओकर नामोनिसान मिट जाही।<verse eid="DAN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20" />“तब जऊन ह ओकर जगह लीही, ओह राज वैभव ला बनाय रखे बर एक लगान इकट्ठा करइया ला पठोही। पर कुछू बछर के भीतर, ओह नास हो जाही, पर ओकर बिनास कोरोध या लड़ई म नइं होही।<verse eid="DAN 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21" />“ओकर जगह ला लेवइया ह एक तुछ मनखे होही, जऊन ला राजबंस ले आदर नइं मिले होही। जब मनखेमन अपनआप ला सुरकछित महसूस करत होहीं, तभे ओह राज ऊपर हमला करही, अऊ ओह सडयंत्र करके ओला अपन कब्जा म कर लीही। <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />तब एक बड़े सेना ओकर आघू म खतम हो जाही; येला अऊ करार के एक राजकुमार दूनों ला नास कर दिये जाही। <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />ओ राजकुमार के संग एक समझौता करे के बाद, ओह छल-कपट के संग काम करही, अऊ सिरिप थोरकन मनखेमन के संग ओह सक्तिसाली हो जाही। <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />जब सबले धनी राजमन सुरकछित महसूस करत होहीं, तभे ओह ओमन ऊपर हमला करही अऊ अइसन सफल होही, जइसन न तो ओकर बाप-ददा अऊ न ही ओकर पुरखामन कभू होईन। ओह लूटे अऊ छीने गय चीज अऊ संपत्ति ला अपन अनुयायीमन के बीच बांट दीही। ओह किलामन ला जीते बर सडयंत्र करही—पर सिरिप कुछू समय बर।<verse eid="DAN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 11:25" />“एक बड़े सेना लेके ओह दक्खिन के राजा के बिरूध अपन सक्ति अऊ साहस के उपयोग करही। दक्खिन के राजा घलो एक बड़े अऊ बहुंत सक्तिसाली सेना लेके लड़ई करही, पर ओकर बिरूध रचे गय सडयंत्र के कारन, ओह ठहर नइं सकही। <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />जऊन मन राजा के दुवारा दिये जेवन करंय, ओमन ही ओला नास करे के कोसिस करहीं; ओकर सेना ला भगा दिये जाही, अऊ बहुंते जन लड़ई म मारे जाहीं। <verse eid="DAN 11:26" /><verse number="27" style="v" sid="DAN 11:27" />दूनों राजा खराप मनसा ले एक ही मेज म बईठहीं अऊ एक-दूसर ले झूठ बोलहीं, जेकर ले कोनो फायदा नइं होही, काबरकि ठहिराय गे समय म अन्त आ जाही। <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />उत्तर के राजा ह बहुंत संपत्ति के संग अपन देस ला लहुंट जाही, पर ओकर मन ह पबितर करार के बिरूध लगे रहिही। ओह येकर बिरूध कार्यवाही करही अऊ तब ओह अपन देस लहुंट जाही।<verse eid="DAN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29" />“ठहिराय गे समय म, ओह फेर दक्खिन ऊपर हमला करही, पर ये समय परिनाम ह पहिले ले अलग होही। <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />पछिमी समुंदर तीर के पानी जहाजमन ओकर बिरोध करहीं, अऊ ओह हिम्मत हार जाही। तब ओह लहुंटही अऊ पबितर करार के बिरूध अपन गुस्सा निकालही। ओह लहुंटही अऊ ओमन ऊपर किरपा करही, जऊन मन पबितर करार ला छोंड़ दीहीं।<verse eid="DAN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 11:31" />“हथियार धरे ओकर सेनामन मंदिर के किला ला अपबितर करे बर आघू बढ़हीं अऊ हर दिन चढ़ाय जवइया बलिदान ला बंद कर दीहीं। तब ओमन घिन जिनिस के स्थापना करहीं, जऊन ह उजाड़ के कारन बनथे। <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />चापलूसी करके ओह ओमन ला भ्रस्ट करही, जऊन मन करार ला टोर दिये होहीं, पर जऊन मनखेमन अपन परमेसर ला जानथें, ओमन ओकर जोरदार बिरोध करहीं।<verse eid="DAN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 11:33" />“जऊन मन बुद्धिमान अंय, ओमन बहुंते ला समझाहीं, हालाकि कुछू समय बर, ओमन तलवार ले मारे जाहीं या जला दिये जाहीं या पकड़ लिये जाहीं या लूट लिये जाहीं। <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />जब ओमन गिरहीं, त ओमन ला बहुंत कम मदद मिलही, अऊ बहुंत मनखे, जऊन मन ईमानदार नो हंय, ओमन संग सामिल हो जाहीं। <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />बुद्धिमान मनखेमन ले कुछू झन लड़खड़ाहीं, ताकि अन्त के बेरा आवत तक ओमन ला साफ, सुध अऊ दाग रहित करे जा सकय, काबरकि ठहिराय गे समय म ही अन्त होही।<verse eid="DAN 11:35" /></para>
  <para style="s1">राजा, जऊन ह अपनआप ला बड़े बनाथे</para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36" />“राजा ह अपन मन मुताबिक करही। ओह अपनआप ला जम्मो देवतामन ले ऊंच अऊ बड़े बनाही अऊ देवतामन के परमेसर के बिरूध अइसन बात कहिही, जऊन ह कभू नइं सुने गे होही। ओह तब तक सफल होही, जब तक कि कोप के समय ह पूरा नइं हो जाही, काबरकि जऊन बात ठहिराय गे हवय, ओह जरूर पूरा होही। <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />ओह न तो अपन पुरखामन के देवतामन के कुछू आदर करही अऊ न ही ओह माईलोगनमन के ईछा के चिंता करही, अऊ न ही ओह कोनो देवता के आदर करही, पर ओह अपनआप ला ओ जम्मो ले ऊपर करही। <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />ओमन के बदले, ओह किलामन के एक देवता के आदर करही; एक अइसन देवता, जऊन ला ओकर पुरखामन घलो नइं जानत रिहिन। ओह ओ देवता के आदर सोन, चांदी, कीमती रत्न अऊ मंहगा उपहारमन के दुवारा करही। <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />ओह एक परदेसी देवता के मदद ले सबले सक्तिसाली गढ़मन ऊपर हमला करही अऊ ओमन के बहुंत आदर करही, जऊन मन ओला स्वीकार करहीं। ओह ओमन ला बहुंते मनखेमन ऊपर सासक ठहिराही अऊ एक दाम लेके भुइयां ला बांट दीही।<verse eid="DAN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40" />“अन्त के बेरा म, दक्खिन के राजा ह ओला लड़ई म लगाय रखही, अऊ उत्तर के राजा घलो रथ, घुड़सवार अऊ पानी जहाजमन के एक बड़े बेड़ा के संग ओकर ऊपर हमला करही। ओह बहुंते देस ऊपर हमला करही अऊ बाढ़ के पानी के सहीं ओमन ले होवत निकल जाही। <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />ओह सुघर देस ऊपर घलो हमला करही। बहुंत देसमन के अन्त हो जाही, पर एदोम अऊ मोआब देस ला अऊ अमोन के अगुवामन ला ओकर हांथ ले बचाय जाही। <verse eid="DAN 11:41" /><verse number="42" style="v" sid="DAN 11:42" />ओह बहुंते देस म अपन सक्ति ला फईलाही; मिसर देस घलो नइं बचही। <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />ओह मिसर देस के सोन अऊ चांदी के खजाना अऊ जम्मो कीमती चीजमन ला अपन बस म कर लीही, अऊ लिबिया अऊ कूस देस के मनखेमन ओकर अधीन हो जाहीं। <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />पर पूरब अऊ उत्तर दिग ले अवइया खबर ला सुनके ओह चिंतित हो जाही, अऊ बहुंत गुस्सा होके ओह बहुंते जन ला नास करे अऊ ओमन के नामोनिसान मिटाय बर निकल जाही। <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />ओह अपन राजकीय तम्बू समुंदर के बीच सुघर पबितर पहाड़ ऊपर ठाढ़ करही। तभो ले ओकर अन्त हो जाही, अऊ कोनो ओकर मदद नइं करहीं।<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="s1">अन्त के बेरा</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />“ओ बेरा मिकाएल, महान राजकुमार के उदय होही, जऊन ह तुम्हर मनखेमन ला बचाथे। तब अइसन बिपत्ति के समय होही, जइसन कि जातिमन के सुरू होय के समय ले लेके अब तक कभू नइं होय होही। पर ओ समय तुम्हर मनखेमन ले हर ओ मनखे ह बचाय जाही, जेकर नांव ह किताब<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="EXO 32:32-33">निर 32:32‑33</ref>; <ref loc="PSA 69:28">भजन 69:28</ref></char></char></note> म लिखे पाय जाही। <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />मरे मन के जनसमूह, जेमन ला भुइयां म दफनाय गे हवय, ओमन जी उठहीं: कुछू तो सदाकाल के जिनगी बर, अऊ आने मन सरमिंदा होय अऊ सदाकाल के अपमान बर। <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />जऊन मन बुद्धिमान अंय, ओमन अकास के अंजोर सहीं चमकहीं, अऊ जऊन मन बहुंते जन ला धरमीपन कोति ले जाथें, ओमन तारामन सहीं हमेसा चमकत रहिहीं। <verse eid="DAN 12:3" /><verse number="4" style="v" sid="DAN 12:4" />पर हे दानिएल, तें अन्त के बेरा के आवत तक ये किताब के बातमन ऊपर मुहर लगाके येला बंद रख। बहुंते जन गियान बढ़ाय बर एती-ओती जाहीं।”<verse eid="DAN 12:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5" />तब में, दानिएल ह देखेंव कि उहां अऊ दू झन मनखे खड़े रहंय, एक झन ह नदी के ये तीर म अऊ दूसर ह नदी के ओ तीर म। <verse eid="DAN 12:5" /><verse number="6" style="v" sid="DAN 12:6" />ओमा ले एक झन ह मलमल के ओनहा पहिरे ओ मनखे ला कहिस, जऊन ह नदी के पानी के ऊपर रिहिस, “येकर पहिले कि ये चकित करइया बातमन पूरा होवंय, अऊ कतेक समय लगही?”<verse eid="DAN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 12:7" />ओ मनखे जऊन ह मलमल के ओनहा पहिरे रिहिस अऊ नदी के पानी के ऊपर रिहिस, ओह अपन जेवनी हांथ अऊ अपन डेरी हांथ अकास कोति उठाईस अऊ मेंह सुनेंव कि ओह हमेसा जीयत रहइया के कसम खाके कहत रहय, “येह एक समय, समयमन अऊ आधा समय बर होही।<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">एक </char><char style="fqa" closed="false">बछर, दू बछर अऊ आधा बछर</char></note> जब आखिर म पबितर मनखेमन के सक्ति ह खतम कर दिये जाही, तब ये जम्मो बात पूरा हो जाही।”<verse eid="DAN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8" />मेंह ये बात ला सुनेंव, पर नइं समझेंव। एकरसेति मेंह पुछेंव, “हे मोर मालिक, ये जम्मो बात के परिनाम का होही?”<verse eid="DAN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 12:9" />ओह जबाब दीस, “हे दानिएल, तेंह जा, काबरकि अन्त के बेरा के आवत तक, ये बातमन ऊपर मुहर लगाके येमन ला बंद कर दिये गे हवय। <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />बहुंत मनखेमन सुध, दाग रहित अऊ साफ करे जाहीं; पर जऊन मन दुस्ट अंय, ओमन दुस्टता करत रहिहीं। दुस्टमन ले कोनो ये बातमन ला नइं समझहीं, पर जऊन मन बुद्धिमान अंय, ओमन समझहीं।<verse eid="DAN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 12:11" />“जब ले हर दिन के बलिदान ला बंद कर दिये जाही अऊ उजाड़ करइया घिनित चीज ला स्थापित करे जाही, तब ले 1,290 दिन के समय होही। <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />धइन ए ओ, जऊन ह इंतजार करथे अऊ 1,335 दिन के आखिरी तक पहुंचथे।<verse eid="DAN 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 12:13" />“जहां तक तोर सवाल ए, तें अन्त के आवत तक अपन रसता म जा। तेंह अराम करबे, अऊ तब दिनमन के अन्त के बेरा, तेंह अपन बर ठहिराय उत्तराधिकार ला पाय बर ठाढ़ होबे।”<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>