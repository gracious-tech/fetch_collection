<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">2 तीमुथियुस</para>
  <para style="toc1">तीमुथियुस के नांव पौलुस के दूसरा चिट्ठी</para>
  <para style="toc2">2 तीमुथियुस</para>
  <para style="toc3">2 तीमु</para>
  <para style="mt1">तीमुथियुस</para>
  <para style="mt2">के नांव पौलुस के दूसरा चिट्ठी</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="po">
    <verse number="1" style="v" sid="2TI 1:1" />में पौलुस, ओ जिनगी के वायदा के मुताबिक, जऊन ह मसीह यीसू म हवय, परमेसर के ईछा ले मसीह यीसू के प्रेरित अंव,<verse eid="2TI 1:1" /></para>
  <para style="po">
    <verse number="2" style="v" sid="2TI 1:2" />ये चिट्ठी मोर मयारू बेटा तीमुथियुस ला लिखत हंव:</para>
  <para style="po" vid="2TI 1:2">परमेसर ददा अऊ हमर परभू मसीह यीसू के तरफ ले तोला अनुग्रह, दया अऊ सांति मिलत रहय।<verse eid="2TI 1:2" /></para>
  <para style="s1">धनबाद अऊ उत्साह</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />मेंह हमेसा तोला रात अऊ दिन अपन पराथना म सुरता करत, परमेसर के धनबाद करथंव, जेकर सेवा मेंह साफ मन ले करथंव जइसने कि मोर पुरखामन घलो करत रिहिन। <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />तोर आंखी के आंसू ला सुरता करके, मेंह तोला देखे के ईछा करथंव, ताकि मेंह आनंद ले भर जावंव। <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />मेंह तोर निस्कपट बिसवास ला सुरता करथंव, जऊन ह कि पहिली तोर ममा दाई लोइस अऊ तोर दाई यूनीके म रिहिस, अऊ मोला भरोसा हवय कि एहीच बिसवास तोर म घलो हवय।<verse eid="2TI 1:5" /></para>
  <para style="s1">पौलुस अऊ सुघर संदेस बर निस्ठा के अपील</para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6" />एकर कारन मेंह तोला सुरता करावत हंव कि परमेसर के ओ बरदान के उपयोग जादा से जादा कर, जऊन ह तोला मोर हांथ रखे के जरिये मिले रिहिस। <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />काबरकि परमेसर ह हमन ला डर के आतमा नइं, पर ओह सामर्थ, मया अऊ संयम बरते के आतमा दे हवय। <verse eid="2TI 1:7" /><verse number="8" style="v" sid="2TI 1:8" />एकरसेति, हमर परभू के गवाही दे बर झन लजा अऊ न मोर बर लजा, जऊन ह परभू खातिर कैदी अंव। पर परमेसर के सामर्थ के दुवारा सुघर संदेस बर दुख उठाय म मोर संग हो ले। <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />परमेसर ह हमर उद्धार करे हवय अऊ हमन ला एक पबितर जिनगी जीये बर बलाय हवय। परमेसर ह येला हमर बने करम के कारन नइं, पर ओह येला अपन उदेस्य अऊ अनुग्रह के कारन करे हवय। ओह ये अनुग्रह ला समय के सुरू होय के पहिली ले मसीह यीसू के जरिये हमन ला दे हवय, <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />पर ये अनुग्रह अब हमर उद्धार करइया मसीह यीसू के आय के दुवारा परगट होय हवय। ओह मिरतू के सक्ति ला नास करिस, अऊ सुघर संदेस के दुवारा जिनगी अऊ अमर जिनगी ला अंजोर म लानिस। <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" />मेंह एही सुघर संदेस के परचारक, प्रेरित अऊ गुरू ठहिराय गे हवंव। <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />एकर कारन मेंह ये दुख सहत हवंव। पर मेंह नइं लजावंव काबरकि मेंह जानथंव कि काकर ऊपर मेंह बिसवास रखे हवंव अऊ मेंह ये निस्चय जानत हंव कि ओह ओ चीज के रखवारी कर सकथे, जऊन ला मेंह ओकर आय के दिन तक ओला सऊंपे हवंव।<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />ओ बने बात, जऊन ला मेंह तोला सिखोय हवंव, ओला अपन जिनगी म एक नमूना के रूप म ले अऊ संगे-संग मसीह यीसू के बिसवास अऊ मया म बने रह। <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />ओ बने चीजमन के रखवारी कर, जऊन ह तोला सऊंपे गे हवय। ये बने चीजमन के रखवारी पबितर आतमा के मदद ले कर, जऊन ह कि हमन म रहिथे।<verse eid="2TI 1:14" /></para>
  <para style="s1">बेईमानी अऊ वफादारी के उदाहरन</para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />तेंह जानथस कि एसिया प्रदेस म जम्मो झन मोला छोंड़ दे हवंय, ओमन म फूगिलुस अऊ हिरमुगिनेस घलो हवंय।<verse eid="2TI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16" />उनेसिफुरूस के परिवार ऊपर परभू दया करय, काबरकि ओह अकसर मोर मदद करे हवय अऊ ओह मोर जेल म रहे के कारन नइं लजाईस। <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />पर जब ओह रोम सहर म आईस, त ओह मोला तब तक खोजते रिहिस, जब तक कि ओह मोला नइं पा गीस। <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />परभू करय कि परभू के आय के दिन ओकर ऊपर परभू के दया होवय। तेंह येला बने करके जानथस कि ओह इफिसुस म मोर कतेक जादा मदद करिस।<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />एकरसेति, हे मोर बेटा, ओ अनुग्रह म मजबूत हो जा, जऊन ह मसीह यीसू म हवय। <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />जऊन बातमन ला, मेंह तोला कतको गवाहमन के आघू म कहे हवंव, ओ बातमन ला बिसवासयोग्य मनखेमन ला सऊंप दे, जऊन मन आने मन ला घलो सिखोय म काबिल हवंय। <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />मसीह यीसू के एक बने सैनिक के सहीं, हमर संग दुख सहे कर। <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />एक सैनिक ह सेवा करत आम आदमी के रोज के जिनगी के मामला म दखल नइं देवय, पर ओह अपन हुकूम देवइया अधिकारी ला खुस करे चाहथे। <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />ओही किसम ले, जब एक खिलाड़ी ह खेल-कूद म भाग लेथे, त ओला तब तक ईनाम नइं मिलय, जब तक कि ओह खेल के नियम के मुताबिक नइं खेलय। <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />कठोर मेहनत करइया किसान ला फसल के बांटा पहिली मिलना चाही। <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />जऊन बात मेंह कहत हंव, ओकर बारे म सोच-बिचार कर, काबरकि परभू ह जम्मो चीज ला समझे म तोर मदद करही।<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />यीसू मसीह ला सुरता कर, जऊन ह मरे म ले जी उठिस अऊ जऊन ह दाऊद राजा के बंस के रिहिस। येह मोर सुघर संदेस ए, जेकर परचार मेंह करत हंव, <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />अऊ एकरे कारन मेंह दुख उठावत हंव, इहां तक कि एक अपराधी के सहीं मेंह जेल म हवंव। पर परमेसर के बचन ह सुतंतर हवय। <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />एकरसेति, मेंह चुने मनखेमन खातिर हर चीज ला सहत हवंव कि ओमन घलो सदाकाल के महिमा के संग ओ उद्धार ला पावंय, जऊन ह मसीह यीसू के जरिये मिलथे।<verse eid="2TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11" />ये कहावत ह बिलकुल सही ए:</para>
  <para style="q1" vid="2TI 2:11">यदि हमन ओकर संग मरथन,</para>
  <para style="q2" vid="2TI 2:11">त हमन ओकर संग जीयबो घलो;<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />यदि हमन दुख सहथन,</para>
  <para style="q2" vid="2TI 2:12">त हमन ओकर संग राज घलो करबो।</para>
  <para style="q1" vid="2TI 2:12">यदि हमन ओकर इनकार करथन,</para>
  <para style="q2" vid="2TI 2:12">त ओह घलो हमर इनकार करही;<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />यदि हमन बिसवास के लईक नइं रहन,</para>
  <para style="q2" vid="2TI 2:13">तभो ले ओह बिसवास के लईक रहिही,</para>
  <para style="q2" vid="2TI 2:13">काबरकि ओह अपन बात ले कभू नइं मुकरय।<verse eid="2TI 2:13" /></para>
  <para style="s1">परमेसर के बने सेवक</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />मनखेमन ला ये बातमन के सुरता करावत रह, अऊ परमेसर के आघू म ओमन ला चेतउनी दे कि ओमन कोनो बचन के बारे म झगरा झन करंय, जेकर ले कोनो फायदा नइं होवय, बल्कि येह सुनइयामन के बिनास होय के कारन बनथे। <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />अपनआप ला परमेसर के गरहन करे लईक अऊ अइसन काम करइया बनाय के कोसिस कर, जऊन ला लजाय के जरूरत नइं होवय अऊ जऊन ह सत के बचन ला सही ढंग ले बताथे। <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />अभक्ति अऊ मुरूखता के बातचीत ले दूरिहा रहे कर, काबरकि जऊन मन अइसने बातचीत म सामिल होथें, ओमन परमेसर ले अऊ दूरिहा होवत जाथें। <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />ओमन के सिकछा ह सरहा घाव सहीं बगरत जाथे। हुमिनयुस अऊ फिलेतुस इही मन ले अंय <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />अऊ येमन सत के बचन ले दूरिहा हो गे हवंय। येमन कहिथें कि मरे मनखेमन के जी उठई त पहिले ही हो चुके हवय अऊ अइसने कहिके, येमन कुछू मनखेमन के बिसवास ला नास कर देथें। <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />पर परमेसर के पक्का नीव ह मजबूत हवय अऊ ओमा ये बचन के मुहर लगे हवय: “परभू ह अपन मनखेमन ला जानथे” अऊ “हर ओ मनखे, जऊन ह परभू ऊपर बिसवास करथे, ओह बुरई ले दूरिहा रहय।”<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />एक बड़े घर म सिरिप सोन अऊ चांदी के ही नइं, पर उहां कठवा अऊ माटी के बरतन घलो रहिथें, कुछू बरतन बिसेस उपयोग खातिर अऊ कुछू बरतन सधारन उपयोग खातिर। <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />यदि कोनो अपनआप ला ये जम्मो बुरई ले दूरिहा रखही, त ओह खास काम म उपयोग होही अऊ पबितर होही अऊ ओह अपन मालिक के काम आही अऊ कोनो भी बने काम करे बर तियार रहिही।<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />तेंह जवानी के वासना ले दूरिहा रह, अऊ जऊन मन साफ मन ले परभू के नांव लेथें, ओमन संग धरमीपन, बिसवास, मया अऊ सांति के साधना म लगे रह। <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />पर मुरूखता अऊ अगियानता के बहस ले दूरिहा रह, काबरकि तेंह जानथस, एकर ले झगरा होथे। <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />परभू के सेवक ला झगरहा नइं होना चाही, पर ओला हर एक के ऊपर दया करइया, सिखोय म माहिर अऊ सहनसील होना चाही। <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />ओह अपन बिरोधीमन ला ये आसा म नमरता ले समझावय कि परमेसर ह ओमन ला मन-फिराय के मऊका दीही अऊ ओमन सच ला जानहीं, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />अऊ तब ओमन अपन चेत म आके, ओ सैतान के फांदा ले बचहीं, जऊन ह अपन ईछा पूरा करे बर ओमन ला पकड़े हवय।<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s1">आखिरी दिन म अभक्ति</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />ये बात ला जान ले कि संसार के आखिरी दिनमन म कठिन समय आही। <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />मनखेमन अपनआप ले अऊ पईसा ले मया करइया, डींगमार, घमंडी, गाली-गलौच करइया, दाई-ददा के कहना नइं मनइया, गुन नइं चिनहइया, अपबितर, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />बिगर मया के, छेमा नइं करइया, निन्दा करइया, असंयमी, निरदयी, भलई के बईरी, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />बिसवासघात करइया, उतावला, अभिमानी अऊ परमेसर ले नइं, पर भोग-बिलास ले मया करइया होहीं। <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />ओमन भक्ति के भेस धरहीं, पर एकर सामर्थ ला नइं मानहीं। अइसने मनखेमन ले दूरिहा रहे कर।<verse eid="2TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6" />ओमन अइसने मनखे अंय, जऊन मन घर म कलेचुप घुसरथें अऊ ओ छिछोरी माईलोगनमन ला बस म कर लेथें, जऊन मन पाप ले दबे अऊ जम्मो किसम के वासना के बस म हवंय। <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />ये माईलोगनमन हमेसा सीखत तो रहिथें, पर सच्चई के पहिचान कभू नइं कर सकंय। <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />जइसने यन्नेस अऊ यम्ब्रेस, मूसा के बिरोध करिन, वइसने ये मनखेमन घलो सच्चई के बिरोध करथें। येमन अइसने मनखे अंय, जेमन के दिमाग ह खराप हो गे हवय अऊ येमन बिसवास ला छोंड़ दे हवंय। <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />पर येमन जादा आघू नइं जा सकंय, काबरकि जम्मो झन ओमन के मुरूखता ला जान लीहीं, जइसने कि मूसा के बिरोधीमन संग होय रिहिस।<verse eid="2TI 3:9" /></para>
  <para style="s1">पौलुस के तीमुथियुस ला निरदेस</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />पर तेंह मोर जम्मो उपदेस, मोर चालचलन, मोर उदेस्य, बिसवास, धीरज, मया, सहनसीलता, <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />सताय जवई अऊ मोर दुख उठई ला जानथस। तेंह जानथस कि अंताकिया, इकुनियुम अऊ लुस्त्रा सहर म, मेंह कतेक दुख-तकलीफ सहे हवंव। पर परभू ह मोला ओ जम्मो ले बचाईस। <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />येह सच ए कि जऊन ह मसीह यीसू म भक्ति के जिनगी जीये चाहथे, ओला सताय जाही। <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />जबकि दुस्ट मनखे अऊ धोखेबाजमन धोखा देवत अऊ खुदे धोखा खावत अऊ बिगड़त जाहीं। <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />पर तेंह जऊन बातमन ला सीखे अऊ अटल बिसवास करे हवस, ओमा मजबूत होवत जा, काबरकि तेंह ओमन ला जानथस, जेमन ले तेंह ये बातमन ला सीखे हवस, <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />अऊ सुरता रख कि कइसने लइकापन ले, तेंह परमेसर के पबितर बचन ला जाने हवस, जऊन ह तोला मसीह यीसू म बिसवास के दुवारा, उद्धार पाय खातिर सिकछा दे सकथे। <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />परमेसर के जम्मो बचन ह परमेसर के परेरना ले लिखे गे हवय अऊ येह उपदेस देय बर, गलती म डांटे बर, सुधारे बर अऊ धरमीपन के सिकछा देय बर उपयोगी ए, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />ताकि परमेसर के जन ह सिद्ध बनय अऊ हर बने काम बर पूरा तियार हो सकय।<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />परमेसर ला हाजिर जानके अऊ मसीह यीसू ला हाजिर जानके, जऊन ह जीयत अऊ मरे मन के नियाय करही, अऊ मसीह के परगट होय अऊ ओकर राज करे के संबंध म, मेंह तोला ये जिम्मा देवत हंव: <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />तेंह बचन के परचार कर; समय अऊ बेसमय तियार रहे कर। बड़े धीरज अऊ सही सिकछा के संग मनखेमन ला समझा, डांट अऊ उत्साहित कर। <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />काबरकि अइसने समय आही, जब मनखेमन सही सिकछा ला नइं सुनहीं अऊ अपन ईछा ला पूरा करहीं। ओमन अपन बर अइसने गुरूमन ला बलाहीं, जऊन मन ओमन के ईछा के मुताबिक सिकछा दीहीं। <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />ओमन सच बात ला नइं सुनहीं पर कथा-कहानी म अपन मन लगाहीं। <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />पर तेंह ये जम्मो बात म सचेत रहे कर; दुख ला सहे कर, सुघर संदेस के परचार कर, अऊ परमेसर के सेवक के रूप म अपन जम्मो सेवा ला कर।<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />मेंह पहिले से ही पेय-बलिदान के सहीं ढारे जावत हंव, अऊ मोर मरे के बेरा आ गे हवय। <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />मेंह अपन परभू बर बने लड़ई लड़े हवंव। मेंह अपन दऊड़ ला पूरा कर ले हवंव। मेंह परभू ऊपर बिसवास रखे हवंव। <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />मोर बर धरमीपन के ओ मुकुट रखे हवय, जऊन ला धरमी नियायी परभू ह मोला नियाय के दिन दीही, अऊ सिरिप मोला ही नइं, पर ओ जम्मो झन ला घलो दीही, जऊन मन लालसा से ओकर परगट होय के बाट जोहथें।<verse eid="2TI 4:8" /></para>
  <para style="s1">आखिरी बचन</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />मोर करा जल्दी आय के कोसिस कर, <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />काबरकि अब देमास ह ये संसार के मया म पड़के मोला छोंड़ दे हवय अऊ ओह थिस्सलुनीके सहर चले गे हवय। क्रेसकेंस ह गलातिया अऊ तीतुस ह दलमतिया चले गे हवय। <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />सिरिप लूका ह मोर संग हवय। मरकुस ला लेके मोर करा आ, काबरकि ओह परभू के सेवा म मोर बहुंत मदद करथे। <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />तुखिकुस ला मेंह इफिसुस सहर पठोय हवंव। <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />जब तेंह आबे, त जऊन कोट ला मेंह त्रोआस म करपुस के इहां छोंड़ आय रहेंव, ओला अऊ किताबमन ला घलो, खास करके चमड़ा के बने किताब ला लेके आबे।<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />धातु के काम करइया सिकन्दर ह मोर बहुंत नुकसान करे हवय। परभू ह ओकर करम के बदला ओला दीही। <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />तेंह घलो ओकर ले सचेत रहे कर, काबरकि ओह हमर संदेस के बहुंत बिरोध करे हवय।<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />अदालत म, जब मेंह पहिली बार अपन सफई पेस करत रहेंव, तब कोनो मोर संग नइं दीस, जम्मो झन मोला छोंड़ दे रिहिन। अइसने होवय कि परमेसर ह ये बात ला ओमन के बिरोध म झन लेवय। <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />पर परभू ह मोर मदद करिस अऊ मोला बल दीस ताकि मोर दुवारा संदेस के पूरा परचार होवय अऊ जम्मो आनजातमन येला सुनंय। मेंह सिंह के मुहूं ले बचाय गे हवंव। <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />परभू ह मोला जम्मो बुरई के काम ले बचाही अऊ अपन स्वरगीय राज म मोला सही-सलामत ले जाही। ओकर महिमा जुग-जुग होवत रहय। आमीन।<verse eid="2TI 4:18" /></para>
  <para style="b" />
  <para style="s1">आखिरी जोहार</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />प्रिसकिल्ला अऊ अक्विला ला अऊ उनेसिफुरूस के घराना के मनखेमन ला मोर जोहार कहि देबे।<verse eid="2TI 4:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="2TI 4:20" />इरासतुस ह कुरिन्थुस सहर म रूक गीस अऊ मेंह त्रुफिमुस ला मिलेतुस म छोंड़ दे हवंव, काबरकि ओह बेमार हवय। <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />जड़काला आय के पहिली, तेंह इहां आय के कोसिस कर।</para>
  <para style="b" vid="2TI 4:21" />
  <para style="p" vid="2TI 4:21">यूबूलुस ह तोला जोहार कहत हे, अऊ वइसने ही पुदेंस, लीनुस, क्लौदिया अऊ जम्मो भाईमन तोला जोहार कहत हवंय।<verse eid="2TI 4:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />परभू तोर आतमा के संग रहय। तोर ऊपर परमेसर के अनुग्रह होवत रहय।<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>