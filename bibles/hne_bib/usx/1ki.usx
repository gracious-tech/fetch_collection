<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1KI" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">1 राजा</para>
  <para style="toc1">राजामन के पहिला किताब</para>
  <para style="toc2">1 राजा</para>
  <para style="toc3">1 राजा</para>
  <para style="mt1">राजामन</para>
  <para style="mt2">के पहिला किताब</para>
  <chapter number="1" style="c" sid="1KI 1"/>
  <para style="s1">अदोनियाह ह अपनआप ला राजा घोसित करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 1:1"/>जब दाऊद राजा ह बहुंत डोकरा हो गीस, त ओला ओनहा ओढ़ाय ले घलो ओकर देहें ह गरम नइं होवत रिहिस। <verse eid="1KI 1:1"/><verse number="2" style="v" sid="1KI 1:2"/>एकरसेति ओकर सेवकमन ओला कहिन, “हमन एक जवान कुंवारी लड़की खोजथन, जऊन ह राजा के सेवा करय अऊ ओकर देखभाल करय। ओह ओकर बाजू म लेटय, ताकि हमर परभू राजा ला गरमी लगय।”<verse eid="1KI 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 1:3"/>तब ओमन जम्मो इसरायल देस म एक सुघर जवान माईलोगन के खोज करिन अऊ ओमन ला अबीसग नांव के एक सुनेमवासी लड़की मिलिस, अऊ ओमन ओला राजा करा ले आईन। <verse eid="1KI 1:3"/><verse number="4" style="v" sid="1KI 1:4"/>ओ माईलोगन ह अब्बड़ सुघर रहय; ओह राजा के देखभाल करय अऊ ओकर बाजू म ठाढ़े रहय, पर राजा के सारीरिक संबंध ओकर संग नइं रिहिस।<verse eid="1KI 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 1:5"/>तब अदोनियाह, जेकर दाई के नांव हगीत रिहिस, अपनआप ला आघू करके कहिस, “मेंह राजा बनहूं।” अऊ ओह रथ अऊ घोड़ामन<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सारथीमन</char></note> ला तियार करिस अऊ अपन आघू-आघू दऊड़े बर पचास मनखे रखिस। <verse eid="1KI 1:5"/><verse number="6" style="v" sid="1KI 1:6"/>(ओकर ददा ह ओला ये कहिके कभू नइं डांटे रिहिस, “तेंह अइसने काम काबर करथस।” ओह बहुंत सुन्दर घलो रिहिस अऊ अबसालोम के बाद ओकर जनम होय रिहिस।)<verse eid="1KI 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 1:7"/>अदोनियाह ह सरूयाह के बेटा योआब अऊ अबियातार पुरोहित ले बातचीत करिस, अऊ ओमन ओकर समरथन करिन। <verse eid="1KI 1:7"/><verse number="8" style="v" sid="1KI 1:8"/>पर सादोक पुरोहित, यहोयादा के बेटा बनायाह, नातान अगमजानी, सिमी अऊ रेई अऊ दाऊद के बिसेस पहरेदार, अदोनियाह के समरथन नइं करिन।<verse eid="1KI 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 1:9"/>अदोनियाह ह तब एन-रोगेल के लकठा म जोहेलेत नांव के पथरा करा भेड़, पसु अऊ मोटहा बछरूमन के बलिदान करिस। ओह अपन जम्मो भाई राजा के बेटामन ला, अऊ यहूदा के जम्मो राज-करमचारीमन ला बलाईस। <verse eid="1KI 1:9"/><verse number="10" style="v" sid="1KI 1:10"/>पर ओह नातान अगमजानी, बनायाह, बिसेस पहरेदार अऊ अपन भाई सुलेमान ला नइं बलाईस।<verse eid="1KI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 1:11"/>तब नातान ह सुलेमान के दाई बतसेबा ले पुछिस, “का तेंह सुने हस कि हगीत के बेटा अदोनियाह ह राजा बन गे हवय अऊ हमर परभू दाऊद येकर बारे म कुछू नइं जानत हे? <verse eid="1KI 1:11"/><verse number="12" style="v" sid="1KI 1:12"/>एकरसेति, अब मेंह तोला सलाह देवत हंव कि तेंह कइसे अपन अऊ अपन बेटा सुलेमान के परान बचा सकत हस। <verse eid="1KI 1:12"/><verse number="13" style="v" sid="1KI 1:13"/>तेंह दाऊद राजा करा जा अऊ ओला अइसने कह, ‘हे मोर मालिक! हे राजा! का तेंह अपन दासी मोर ले कसम खाके ये नइं कहे रहय: “तोर बेटा सुलेमान ह मोर बाद राजा होही, अऊ ओह मोर सिंघासन म बईठही”? त फेर अदोनियाह ह काबर राजा बन गे हवय?’ <verse eid="1KI 1:13"/><verse number="14" style="v" sid="1KI 1:14"/>जब तेंह उहां राजा ले अइसने गोठियावत रहिबे, तभे मेंह आहूं अऊ तोर बात के समरथन करहूं।”<verse eid="1KI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 1:15"/>तब बतसेबा ह डोकरा राजा ला देखे बर ओकर कमरा म गीस, जिहां सुनेम के अबीसग ह ओकर सेवा-टहल करत रिहिस। <verse eid="1KI 1:15"/><verse number="16" style="v" sid="1KI 1:16"/>बतसेबा ह खाल्हे झुकके राजा ला दंडवत करिस।</para>
  <para style="p" vid="1KI 1:16">राजा ह पुछिस, “तेंह का चाहत हस?”<verse eid="1KI 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 1:17"/>ओह कहिस, “हे मोर परभू, तेंह खुद यहोवा तोर परमेसर के कसम खाके अपन दासी ले कहे रहय: ‘तोर बेटा सुलेमान ह मोर बाद राजा होही, अऊ ओह मोर सिंघासन म बईठही।’ <verse eid="1KI 1:17"/><verse number="18" style="v" sid="1KI 1:18"/>पर अब अदोनियाह ह राजा बन गे हवय, अऊ तें, हे मोर मालिक राजा, येकर बारे म नइं जानत हस। <verse eid="1KI 1:18"/><verse number="19" style="v" sid="1KI 1:19"/>ओह अब्बड़ पसु, मोटहा बछरू अऊ भेड़मन के बलिदान करे हवय, अऊ राजा के जम्मो बेटा, अबियातार पुरोहित अऊ सेना के सेनापति योआब ला बलाय हवय, पर ओह तोर सेवक सुलेमान ला नइं बलाईस। <verse eid="1KI 1:19"/><verse number="20" style="v" sid="1KI 1:20"/>हे मोर परभू! हे राजा! जम्मो इसरायल के आंखी तोर कोति ये जाने बर लगे हवय कि मोर परभू राजा के बाद ओकर सिंघासन म कोन ह बईठही। <verse eid="1KI 1:20"/><verse number="21" style="v" sid="1KI 1:21"/>नइं तो जब मोर मालिक राजा ह अपन पुरखामन के संग हमेसा बर सो जाही, त मोर अऊ मोर बेटा सुलेमान के संग अपराधी के सहीं बरताव करे जाही।”<verse eid="1KI 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 1:22"/>जब बतसेबा ह राजा ले गोठियावत रिहिस, तभे नातान अगमजानी घलो आ गीस। <verse eid="1KI 1:22"/><verse number="23" style="v" sid="1KI 1:23"/>अऊ राजा ला बताय गीस, “नातान अगमजानी ह आय हवय।” तब ओह राजा करा गीस, अऊ मुहूं के बल भुइयां म गिरके राजा ला दंडवत करिस।<verse eid="1KI 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 1:24"/>नातान ह कहिस, “हे मोर मालिक राजा! का तेंह घोसना करे हवस कि अदोनियाह ह तोर बाद राजा होही, अऊ ओह तोर सिंघासन म बईठही? <verse eid="1KI 1:24"/><verse number="25" style="v" sid="1KI 1:25"/>आज ओह खाल्हे म जाके अब्बड़ अकन पसु, मोटहा बछरू अऊ भेड़मन के बलिदान करे हवय। ओह राजा के जम्मो बेटा, सेना के सेनापति अऊ अबियातार पुरोहित ला बलाय हवय। अभी ओमन ओकर संग खावत अऊ पीयत हवंय अऊ ये कहत हवंय, ‘राजा अदोनियाह चिरंजीव रहय।’ <verse eid="1KI 1:25"/><verse number="26" style="v" sid="1KI 1:26"/>पर तोर दास मोला, अऊ सादोक पुरोहित, अऊ यहोयादा के बेटा बनायाह, अऊ तोर दास सुलेमान ला ओह नइं बलाय हवय। <verse eid="1KI 1:26"/><verse number="27" style="v" sid="1KI 1:27"/>का ये काम मोर मालिक राजा कोति ले अपन दासमन ला बिगर बताय होय हवय कि मोर मालिक राजा के बाद ओकर सिंघासन म कोन बईठही।”<verse eid="1KI 1:27"/></para>
  <para style="s1">दाऊद ह सुलेमान ला राजा बनाथे</para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 1:28"/>तब दाऊद राजा ह कहिस, “बतसेबा ला मोर करा बलावव।” तब ओह राजा करा आईस अऊ ओकर आघू म ठाढ़ हो गीस।<verse eid="1KI 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 1:29"/>राजा ह तब ये कसम खाईस, “यहोवा के जिनगी के कसम, जऊन ह मोला हर बिपत्ति ले बचाय हवय, <verse eid="1KI 1:29"/><verse number="30" style="v" sid="1KI 1:30"/>मेंह जऊन बात तोर ले यहोवा, इसरायल के परमेसर के कसम खाके कहे हवंव, ओला आज ही पूरा करहूं: तोर बेटा सुलेमान ह मोर बाद राजा होही, अऊ ओह मोर बाद सिंघासन म मोर जगह म बईठही।”<verse eid="1KI 1:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 1:31"/>तब बतसेबा ह राजा के आघू म मुहूं-भरसा होके ओला सास्टांग दंडवत करिस, अऊ कहिस, “मोर परभू राजा दाऊद ह सदा जीयत रहय!”<verse eid="1KI 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 1:32"/>तब दाऊद राजा ह कहिस, “सादोक पुरोहित, नातान अगमजानी अऊ यहोयादा के बेटा बनायाह ला मोर करा बलाके लान।” अऊ जब ओमन राजा करा आईन, <verse eid="1KI 1:32"/><verse number="33" style="v" sid="1KI 1:33"/>त ओह ओमन ले कहिस: “अपन परभू के सेवकमन ला अपन संग लेवव अऊ मोर बेटा सुलेमान ला मोर अपन खुद के खच्चर म चघावव अऊ ओला खाल्हे गीहोन म ले जावव। <verse eid="1KI 1:33"/><verse number="34" style="v" sid="1KI 1:34"/>अऊ उहां सादोक पुरोहित अऊ नातान अगमजानी, इसरायल के राजा के रूप म ओकर अभिसेक करंय। तब तुरही फूंकके चिचियाके कहव, ‘राजा सुलेमान चिरंजीव रहय!’ <verse eid="1KI 1:34"/><verse number="35" style="v" sid="1KI 1:35"/>तब तुमन ओकर संग ऊपर जावव, अऊ ओह आके मोर सिंघासन म बईठे अऊ मोर जगह म राज करय। मेंह ओला इसरायल अऊ यहूदा ऊपर सासन करइया ठहिराय हंव।”<verse eid="1KI 1:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 1:36"/>तब यहोयादा के बेटा बनायाह ह कहिस, “आमीन! यहोवा, मोर मालिक, राजा के परमेसर घलो अइसने ही घोसना करय। <verse eid="1KI 1:36"/><verse number="37" style="v" sid="1KI 1:37"/>जइसने यहोवा ह मोर मालिक, राजा के संग रिहिस, वइसने ही ओह सुलेमान के संग घलो रहय अऊ ओकर राज ला मोर मालिक, राजा दाऊद के राज ले घलो अधिक बढ़ावय!”<verse eid="1KI 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 1:38"/>तब सादोक पुरोहित, नातान अगमजानी, यहोयादा के बेटा बनायाह, करेती अऊ पलेतीमन खाल्हे गीन अऊ सुलेमान ला राजा दाऊद के खच्चर म चघाईन, अऊ ओला गीहोन म ले गीन। <verse eid="1KI 1:38"/><verse number="39" style="v" sid="1KI 1:39"/>तब सादोक पुरोहित ह पबितर तम्बू ले तेल ले भरे सींग ला लीस अऊ सुलेमान के अभिसेक करिस। तब ओमन तुरही फूंकिन अऊ जम्मो मनखे चिचियाके कहिन, “राजा सुलेमान चिरंजीव रहय!” <verse eid="1KI 1:39"/><verse number="40" style="v" sid="1KI 1:40"/>अऊ जम्मो मनखेमन बांसुरी बजावत अऊ अइसने आनंद मनावत ओकर पाछू-पाछू ऊपर गीन कि अवाज के मारे धरती घलो कांपे लगिस।<verse eid="1KI 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 1:41"/>जब अदोनियाह अऊ ओकर जम्मो पहुनामन अपन खाना खवई खतम करनेवाला ही रिहिन कि ओमन ये अवाज सुनिन। तुरही के अवाज ला सुनके, योआब ह पुछिस, “सहर म ये जम्मो कोलाहल के का मतलब ए?”<verse eid="1KI 1:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1KI 1:42"/>जब ओह अइसने गोठियावत रिहिस, तभे अबियातार पुरोहित के बेटा योनातन आईस। अदोनियाह ह ओकर ले कहिस, “भीतर आ। तेंह एक बने मनखे अस, अऊ तेंह जरूर कोनो बने संदेस लाने होबे।”<verse eid="1KI 1:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1KI 1:43"/>योनातन ह जबाब दीस, “बिलकुल ही नइं! हमर परभू राजा दाऊद ह सुलेमान ला राजा बना दे हवय। <verse eid="1KI 1:43"/><verse number="44" style="v" sid="1KI 1:44"/>अऊ राजा ह सादोक पुरोहित, नातान अगमजानी, यहोयादा के बेटा बनायाह, करेती अऊ पलेतीमन ला ओकर संग पठोय हवय, अऊ ओमन ओला राजा के खच्चर म चघाय हवंय, <verse eid="1KI 1:44"/><verse number="45" style="v" sid="1KI 1:45"/>अऊ सादोक पुरोहित अऊ नातान अगमजानी गीहोन म राजा के रूप म ओकर अभिसेक करे हवंय। उहां ले ओमन खुसी मनावत ऊपर गे हवंय, सहर म येकर कोलाहल मचे हे, जेकर अवाज तुमन सुनत हवव। <verse eid="1KI 1:45"/><verse number="46" style="v" sid="1KI 1:46"/>अऊ सुलेमान ह राज सिंघासन म अपन जगह ले लेय हवय। <verse eid="1KI 1:46"/><verse number="47" style="v" sid="1KI 1:47"/>राज-करमचारीमन घलो हमर परभू राजा दाऊद करा आके ये कहिके बधाई देवत हंय, ‘तोर परमेसर ह सुलेमान के नांव ला तोर नांव ले घलो महान करय अऊ ओकर राज ला तोर राज ले घलो अधिक बढ़ावय!’ अऊ राजा ह अपन पलंग म भक्ति म दंडवत करिस <verse eid="1KI 1:47"/><verse number="48" style="v" sid="1KI 1:48"/>अऊ कहिस, ‘ओ यहोवा, इसरायल के परमेसर के महिमा होवय, जऊन ह आज मोर देखत म एक उत्तराधिकारी ला मोर सिंघासन म बईठाय हवय।’ ”<verse eid="1KI 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="1KI 1:49"/>ये सुनके, अदोनियाह के जम्मो पहुनामन घबराके उहां ले उठिन अऊ अपन-अपन रद्दा म चल दीन। <verse eid="1KI 1:49"/><verse number="50" style="v" sid="1KI 1:50"/>पर अदोनियाह ह सुलेमान के डर के मारे उठिस, अऊ जाके बेदी के सींगमन ला पकड़ लीस। <verse eid="1KI 1:50"/><verse number="51" style="v" sid="1KI 1:51"/>तब सुलेमान ला ये बताय गीस, “अदोनियाह ह राजा सुलेमान ले डरत हवय अऊ बेदी के सींगमन ला ये कहिके पकड़ ले हवय, ‘राजा सुलेमान ह आज मोर ले कसम खावय कि ओह अपन दास ला तलवार ले नइं मार डारही।’ ”<verse eid="1KI 1:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="1KI 1:52"/>सुलेमान ह जबाब दीस, “यदि ओह अपनआप ला सही साबित करथे, त ओकर बाल भी बांका नइं होही; पर यदि ओमा बुरई पाय जाथे, तो ओह मारे जाही।” <verse eid="1KI 1:52"/><verse number="53" style="v" sid="1KI 1:53"/>तब राजा सुलेमान ह कुछू आदमीमन ला पठोईस, अऊ ओमन ओला बेदी ले खाल्हे ले आईन। अऊ अदोनियाह ह आईस अऊ झुकके राजा सुलेमान ला दंडवत करिस, अऊ सुलेमान ह ओला कहिस, “अपन घर चले जा।”<verse eid="1KI 1:53"/></para>
  <chapter eid="1KI 1"/>
  <chapter number="2" style="c" sid="1KI 2"/>
  <para style="s1">दाऊद के अधिकार सुलेमान ला</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 2:1"/>जब दाऊद के मरे के बेरा ह लकठा म आईस, त ओह अपन बेटा सुलेमान ला ये कहिके अधिकार दीस:<verse eid="1KI 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 2:2"/>“मेंह जम्मो संसार के रीति के मुताबिक जवइया हंव, एकरसेति तेंह मजबूत होके एक मनखे के सहीं काम कर, <verse eid="1KI 2:2"/><verse number="3" style="v" sid="1KI 2:3"/>अऊ जऊन कुछू यहोवा तोर परमेसर चाहथे, ओला मान: ओकर ईछा के मुताबिक चल, अऊ जइसने मूसा के कानून म लिखे हवय वइसने ही ओकर रीति-बिधि अऊ हुकूम, ओकर कानून अऊ नियममन ला मान। तेंह ये जम्मो ला माने कर, ताकि तोर हर काम अऊ तोला हर जगह म सफलता मिलय <verse eid="1KI 2:3"/><verse number="4" style="v" sid="1KI 2:4"/>अऊ यहोवा ह मोर ले करे ये वायदा ला पूरा करय: ‘यदि तोर संतानमन अपन चालचलन ला सही रखहीं, अऊ यदि ओमन अपन पूरा मन अऊ परान के संग म मोर आघू म सच्चई म चलहीं, त इसरायल के सिंघासन म बईठे बर तोर खानदान म उत्तराधिकारी के कभू कमी नइं होही।’<verse eid="1KI 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 2:5"/>“तेंह खुद जानत हस कि सरूयाह के बेटा योआब ह मोर संग का करिस—याने कि नेर के बेटा अबनेर अऊ येतेर के बेटा अमासा, इसरायल के ये दूनों सेनापतिमन के संग ओह का करिस। ओह ओमन ला मार डारिस, अऊ सांति के समय म लड़ई के बेरा सहीं खून बहाईस अऊ ओ खून ले अपन कनिहां के कमरबंध अऊ अपन गोड़ के पनहीमन म दाग लगाईस। <verse eid="1KI 2:5"/><verse number="6" style="v" sid="1KI 2:6"/>अपन बुद्धि के मुताबिक ओकर संग बरताव कर, पर ओ पक्का चुंदीवाला ला सांति से मरन झन देबे।<verse eid="1KI 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 2:7"/>“पर गिलाद के बरजिलै के बेटामन ऊपर दया करबे अऊ ओमन तोर मेज म खाना खवइया होवंय, काबरकि जब मेंह तोर भाई अबसालोम ले भागत रहेंव, त ओमन मोर साथ दे रिहिन।<verse eid="1KI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 2:8"/>“अऊ सुन, तोर संग बहूरीम के बिनयामीनी गेरा के बेटा सिमी हवय, जऊन ह मोला ओ दिन कठोर सराप देय रिहिस जब मेंह महनैम ला जावत रहेंव। पर जब ओह मोर ले भेंट करे बर यरदन मेर आईस, त मेंह ओकर ले यहोवा के किरिया खाके कहे रहेंव: ‘मेंह तोला तलवार ले नइं मारंव।’ <verse eid="1KI 2:8"/><verse number="9" style="v" sid="1KI 2:9"/>पर अब तेंह ओला निरदोस झन ठहिराबे। तेंह एक बुद्धिमान मनखे अस; तोला पता होही कि ओकर संग का करना हे। ओ पक्का चुंदीवाला के खून बहाके ओला मार डारबे।”<verse eid="1KI 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 2:10"/>तब दाऊद ह अपन पुरखामन के संग सुत गीस अऊ ओला दाऊद के सहर म माटी दिये गीस। <verse eid="1KI 2:10"/><verse number="11" style="v" sid="1KI 2:11"/>ओह इसरायल ऊपर चालीस साल तक राज करिस—सात साल हेबरोन सहर म अऊ तैंतीस साल यरूसलेम सहर म। <verse eid="1KI 2:11"/><verse number="12" style="v" sid="1KI 2:12"/>तब सुलेमान ह अपन ददा दाऊद के सिंघासन म बईठिस, अऊ ओकर राज ह मजबूत होवत गीस।<verse eid="1KI 2:12"/></para>
  <para style="s1">सुलेमान के राज स्थापित होईस</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 2:13"/>तब हगीत के बेटा अदोनियाह ह सुलेमान के दाई बतसेबा करा गीस। बतसेबा ह ओकर ले पुछिस, “का तेंह मितानभाव ले आय हस?”</para>
  <para style="p" vid="1KI 2:13">ओह जबाब दीस, “हव, मितानभाव ले!” <verse eid="1KI 2:13"/><verse number="14" style="v" sid="1KI 2:14"/>फेर ओह कहिस, “मोला तोर से कुछू कहना हे।”</para>
  <para style="p" vid="1KI 2:14">बतसेबा ह कहिस, “तेंह कह सकत हस!”<verse eid="1KI 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 2:15"/>त ओह कहिस, “जइसे कि तेंह जानत हस कि राज ह मोर हो गे रिहिस। जम्मो इसरायल ह मोला अपन राजा के रूप म देखत रिहिस। पर चीजमन बदल गीन, अऊ अब राज ह मोर भाई के हो गे हवय, काबरकि येह यहोवा कोति ले ओला मिले हवय। <verse eid="1KI 2:15"/><verse number="16" style="v" sid="1KI 2:16"/>एकरसेति अब मेंह तोर ले एक बिनती करत हंव। मोला इनकार झन करबे।”</para>
  <para style="p" vid="1KI 2:16">बतसेबा ह कहिस, “अपन बिनती ला बता।”<verse eid="1KI 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 2:17"/>ओह कहिस, “राजा सुलेमान ह तोर बात ला नइं काटही—एकरसेति ओकर ले पुछ कि ओह मोला सुनेमिन अबीसग ला मोर घरवाली के रूप म देवय।”<verse eid="1KI 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 2:18"/>बतसेबा ह कहिस, “बने बात ए, मेंह तोर बर राजा ले बात करहूं।”<verse eid="1KI 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 2:19"/>जब बतसेबा ह अदोनियाह के बारे म राजा सुलेमान करा गोठियाय बर गीस, त राजा ह ओकर ले भेंट करे बर उठिस, अऊ झुकके ओला दंडवत करिस अऊ तब ओह अपन सिंघासन म बईठ गीस। राजा ह अपन दाई बर घलो एक सिंघासन रखवा दीस, अऊ ओकर दाई ह ओकर जेवनी हांथ कोति बईठ गीस।<verse eid="1KI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 2:20"/>तब राजा के दाई ह कहिस, “मेंह तोर ले एक छोटे बिनती करे चाहत हंव, मोला इनकार झन करबे।”</para>
  <para style="p" vid="1KI 2:20">राजा ह कहिस, “हे मोर दाई, का बिनती करे चाहत हस? मेंह तोला इनकार नइं करंव।”<verse eid="1KI 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 2:21"/>ओह कहिस, “सुनेमिन अबीसग ह तोर भाई अदोनियाह ला बिहाव म दिये जावय।”<verse eid="1KI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 2:22"/>राजा सुलेमान ह अपन दाई ला जबाब दीस, “तेंह अदोनियाह बर सुनेमिन अबीसग ला ही काबर मांगत हस? तेंह ओकर बर राज ला घलो मांग सकत हस, काबरकि ओह तो मोर बड़े भाई अय—हव, सिरिप ओकर बर ही काबर! अबियातार पुरोहित अऊ सरूयाह के बेटा योआब बर घलो मांग!”<verse eid="1KI 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 2:23"/>तब राजा सुलेमान ह यहोवा के कसम खाके कहिस: “यदि अदोनियाह ह ये बिनती बर मार डारे नइं जावय, त परमेसर ह मोर ले बहुंत कठोरता से बरताव करय! <verse eid="1KI 2:23"/><verse number="24" style="v" sid="1KI 2:24"/>अऊ अब यहोवा के जिनगी के कसम—जऊन ह मोला मोर ददा दाऊद के सिंघासन म बने करके स्थापित करे हवय अऊ अपन वायदा के मुताबिक मोर बर एक राजबंस कायम करे हवय—आज ही अदोनियाह ह मार डारे जाही।” <verse eid="1KI 2:24"/><verse number="25" style="v" sid="1KI 2:25"/>एकरसेति राजा सुलेमान ह यहोयादा के बेटा बनायाह ला हुकूम दीस अऊ ओह गीस अऊ अदोनियाह ऊपर घात करके ओला मार डारिस।<verse eid="1KI 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 2:26"/>अबियातार पुरोहित ला राजा ह कहिस, “अनातोत नगर म अपन भुइयां म जा। तेंह मार डारे जाय के लईक अस, पर मेंह तोला अभी नइं मारंव, काबरकि तें मोर ददा दाऊद के आघू म परमपरधान यहोवा के सन्दूक ला उठाय करत रहय अऊ मोर ददा के जम्मो दुख म तेंह ओकर संग रहय।” <verse eid="1KI 2:26"/><verse number="27" style="v" sid="1KI 2:27"/>सुलेमान ह अबियातार ला पुरोहित पद ले उतार दीस, ये किसम ले जऊन बचन यहोवा ह एली के बंस के बारे म सीलो म कहे रिहिस, ओह पूरा होईस।<verse eid="1KI 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 2:28"/>जब ये खबर योआब करा हबरिस, जऊन ह अबसालोम के संग तो नइं, पर अदोनियाह के संग साजिस रचे रिहिस, तब ओह यहोवा के तम्बू म भाग के गीस अऊ बेदी के सींगमन ला धर लीस। <verse eid="1KI 2:28"/><verse number="29" style="v" sid="1KI 2:29"/>राजा सुलेमान ला बताय गीस कि योआब ह यहोवा के तम्बू म भाग गे हवय अऊ बेदी के बाजू म हवय। तब सुलेमान ह यहोयादा के बेटा बनायाह ला हुकूम दीस, “जा अऊ ओला मार डार!”<verse eid="1KI 2:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 2:30"/>तब बनायाह ह यहोवा के तम्बू भीतर गीस अऊ योआब ला कहिस, “राजा के हुकूम अय कि बाहिर निकल आ!”</para>
  <para style="p" vid="1KI 2:30">पर ओह जबाब दीस, “नइं, मेंह इहां मरहूं।”</para>
  <para style="p" vid="1KI 2:30">बनायाह ह ये बात के सूचना राजा ला दीस, “योआब ह मोला अइसने जबाब दे हवय।”<verse eid="1KI 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 2:31"/>तब राजा ह बनायाह ला हुकूम दीस, “ओकर कहे के मुताबिक ओला मार डार। ओला मारके माटी देय दे, अऊ अइसने करके योआब के दुवारा बहाय निरदोसमन के खून के दोस ले मोला अऊ मोर जम्मो परिवार ला बरी कर। <verse eid="1KI 2:31"/><verse number="32" style="v" sid="1KI 2:32"/>जऊन खून, ओह बहाय रिहिस, यहोवा ह ओकर बदला लीही, काबरकि मोर ददा दाऊद के बिगर जाने, ओह दू झन मनखे ऊपर हमला करिस अऊ ओमन ला तलवार ले मार डारिस। ओ दूनों मनखे—नेर के बेटा अबनेर, इसरायल के सेना के सेनापति, अऊ येतेर के बेटा अमासा यहूदा के सेना के सेनापति रिहिन। ये दूनों झन योआब ले जादा बने अऊ धरमी मनखे रिहिन। <verse eid="1KI 2:32"/><verse number="33" style="v" sid="1KI 2:33"/>येमन के खून के दोस ह योआब अऊ ओकर संतान के मुड़ म सदाकाल तक बने रहय। पर दाऊद अऊ ओकर संतान, ओकर घर अऊ ओकर सिंघासन ऊपर यहोवा के सांति सदाकाल तक बने रहय।”<verse eid="1KI 2:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 2:34"/>एकरसेति यहोयादा के बेटा बनायाह ह जाके योआब ला मार डारिस, अऊ ओला देहात इलाका म ओकर घर म माटी दिये गीस। <verse eid="1KI 2:34"/><verse number="35" style="v" sid="1KI 2:35"/>तब राजा सुलेमान ह योआब के जगह म यहोयादा के बेटा बनायाह ला सेना के सेनापति ठहिराईस अऊ अबियातार के जगह म सादोक पुरोहित ला ठहिराईस।<verse eid="1KI 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 2:36"/>तब राजा ह सिमी ला बुलवाईस अऊ ओला कहिस, “तें यरूसलेम म अपन बर एक घर बना अऊ उहां रह, पर उहां ले बाहिर कोनो अऊ जगह ला झन जाबे। <verse eid="1KI 2:36"/><verse number="37" style="v" sid="1KI 2:37"/>तें ये बात ला पक्का जान ले कि जऊन दिन तेंह निकलके किदरोन घाटी के ओ पार जाबे, त ओहीच दिन, तेंह जरूर मार डारे जाबे; तोर खून के दोस तोरेच मुड़ ऊपर होही।”<verse eid="1KI 2:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 2:38"/>सिमी ह राजा ला जबाब दीस, “तेंह बने बात कहे हस। जइसने मोर मालिक, राजा ह कहे हवय, तोर सेवक ह वइसने ही करही।” अऊ सिमी ह बहुंत समय तक यरूसलेम म रिहिस।<verse eid="1KI 2:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 2:39"/>पर तीन साल के बाद, सिमी के दू झन गुलाम माका के बेटा आकीस करा भाग गीन, जऊन ह गत नगर के राजा रिहिस, अऊ सिमी ला ये बात बताय गीस, “तोर गुलाममन गत म हवंय।” <verse eid="1KI 2:39"/><verse number="40" style="v" sid="1KI 2:40"/>ये सुनके सिमी ह अपन गदहा ऊपर काठी कसिस अऊ अपन गुलाममन ला खोजे बर गत म आकीस करा गीस। ये किसम ले सिमी ह निकलके गीस अऊ अपन गुलाममन ला गत ले वापिस ले आईस।<verse eid="1KI 2:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 2:41"/>जब सुलेमान ला बताय गीस कि सिमी ह यरूसलेम ले गत गे रिहिस अऊ फेर वापिस आ गे हवय, <verse eid="1KI 2:41"/><verse number="42" style="v" sid="1KI 2:42"/>त ओह सिमी ला बुलवाईस अऊ ओला कहिस, “का मेंह तोला यहोवा के कसम खवाके ये चेतउनी नइं दे रहेंव, ‘तें ये बात पक्का जान ले कि जऊन दिन तेंह निकलके कोनो अऊ जगह ला जाबे, त तेंह जरूर मार डारे जाबे’? अऊ ओ समय तेंह मोला कहे रहय, ‘तेंह बने बात कहे हस। मेंह येला मानहूं।’ <verse eid="1KI 2:42"/><verse number="43" style="v" sid="1KI 2:43"/>त फेर तेंह यहोवा के खाय कसम ला काबर टोरय अऊ मोर दिये हुकूम ला नइं मानय?”<verse eid="1KI 2:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="1KI 2:44"/>राजा ह सिमी ला ये घलो कहिस, “तेंह खुद अपन मन म ओ जम्मो गलत काम ला जानत हस, जऊन ला तेंह मोर ददा दाऊद के बिरूध करे हवस। अब यहोवा ह तोर गलत काम के बदला तोर ले लीही। <verse eid="1KI 2:44"/><verse number="45" style="v" sid="1KI 2:45"/>पर राजा सुलेमान ह आसीस पाही, अऊ दाऊद के सिंघासन ह यहोवा के आघू म सदा मजबूत बने रहिही।”<verse eid="1KI 2:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="1KI 2:46"/>तब राजा ह यहोयादा के बेटा बनायाह ला हुकूम दीस, अऊ ओह बाहिर म जाके सिमी ला अइसने मारिस कि ओह मर गीस।</para>
  <para style="p" vid="1KI 2:46">ये किसम ले सुलेमान के हांथ म राज ह स्थापित होईस।<verse eid="1KI 2:46"/></para>
  <chapter eid="1KI 2"/>
  <chapter number="3" style="c" sid="1KI 3"/>
  <para style="s1">सुलेमान ह बुद्धि मांगथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 3:1"/>सुलेमान ह मिसर के राजा फिरौन के संग एक संधि करके ओकर बेटी ले बिहाव कर लीस। ओह ओला लानके दाऊद के सहर म तब तक रखिस, जब तक कि ओह अपन महल अऊ यहोवा के मंदिर अऊ यरूसलेम के चारों कोति दीवार नइं बनवा लीस। <verse eid="1KI 3:1"/><verse number="2" style="v" sid="1KI 3:2"/>मनखेमन अभी तक ले ऊंचहा जगहमन म बलिदान करत रिहिन, काबरकि ओ समय तक यहोवा के नांव म कोनो मंदिर नइं बने रिहिस। <verse eid="1KI 3:2"/><verse number="3" style="v" sid="1KI 3:3"/>सुलेमान ह अपन ददा दाऊद के बताय बिधिमन म चले के दुवारा यहोवा बर अपन मया देखाईस, पर ओह ऊंचहा जगहमन म बलि चघाय अऊ धूप जलाय करत रिहिस।<verse eid="1KI 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 3:4"/>राजा ह गिबोन सहर ला बलि चघाय बर गीस, काबरकि ओह सबले जादा महत्व के ऊंच जगह रिहिस, अऊ सुलेमान ह उहां बेदी म एक हजार होम-बलिदान करिस। <verse eid="1KI 3:4"/><verse number="5" style="v" sid="1KI 3:5"/>गिबोन म यहोवा ह रथिया सपना म सुलेमान करा परगट होईस, अऊ परमेसर ह कहिस, “जऊन भी चीज तेंह चाहत हस, मांग अऊ मेंह तोला दूहूं।”<verse eid="1KI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 3:6"/>सुलेमान ह जबाब दीस, “तेंह अपन सेवक, मोर ददा दाऊद ऊपर बहुंत दया करे हवस, काबरकि ओह तोर बर बिसवासयोग्य रिहिस अऊ मन म धरमी अऊ ईमानदार रिहिस। तेंह अभी घलो ओकर ऊपर बहुंत दया करे हवस अऊ ओला ओकर सिंघासन म बईठे बर एक बेटा देय हवस, जऊन ह आज ओमा बिराजे हवय।<verse eid="1KI 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 3:7"/>“अब हे यहोवा, मोर परमेसर, तेंह अपन सेवक ला मोर ददा दाऊद के जगह म राजा बनाय हवस। पर मेंह तो एक छोटे लइका सहीं अंव अऊ नइं जानंव कि मेंह अपन काम ला कइसे करंव। <verse eid="1KI 3:7"/><verse number="8" style="v" sid="1KI 3:8"/>तोर सेवक ह इहां तोर चुने हुए मनखेमन के बीच म हवय, अऊ येमन अतेक जादा हवंय कि येमन के गनती करे नइं जा सकय। <verse eid="1KI 3:8"/><verse number="9" style="v" sid="1KI 3:9"/>एकरसेति तोर मनखेमन ऊपर राज करे बर, अऊ सही अऊ गलत ला परखे बर, तेंह अपन सेवक ला समझे के सक्ति दे। काबरकि कोन एकर लईक हवय कि तोर ये अब्बड़ मनखेमन ऊपर राज कर सकय?”<verse eid="1KI 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 3:10"/>ये बात ले परभू ह खुस होईस कि सुलेमान ह अइसने बरदान मांगे हवय। <verse eid="1KI 3:10"/><verse number="11" style="v" sid="1KI 3:11"/>एकरसेति परमेसर ह ओला कहिस, “जब तेंह ये बरदान मांगे हस अऊ न तो लम्बा उमर, न धन-संपत्ति अऊ न ही अपन बईरीमन के मिरतू मांगे हस, पर नियाय करे बर समझे के सक्ति मांगे हस, <verse eid="1KI 3:11"/><verse number="12" style="v" sid="1KI 3:12"/>त जऊन कुछू तेंह मांगे हस, मेंह ओला पूरा करहूं। मेंह तोला एक बुद्धिमान अऊ समझवाला मन दूहूं, ताकि तोर सहीं न तो तोर ले पहिले कोनो कभू होईस, अऊ न ही तोर बाद कोनो कभू होही। <verse eid="1KI 3:12"/><verse number="13" style="v" sid="1KI 3:13"/>येकर अलावा मेंह तोला ओ चीज घलो दूहूं, जेला तेंह नइं मांगे हस—धन अऊ आदरमान दूनों—ताकि तोर जिनगी भर तोर सहीं अऊ कोनो राजा नइं होही। <verse eid="1KI 3:13"/><verse number="14" style="v" sid="1KI 3:14"/>अऊ यदि तेंह मोर हुकूममन ला मानत चलत रहिबे अऊ अपन ददा दाऊद के सहीं मोर बिधि अऊ हुकूममन के पालन करबे, त मेंह तोर उमर ला घलो बढ़ाहूं।” <verse eid="1KI 3:14"/><verse number="15" style="v" sid="1KI 3:15"/>तब सुलेमान ह जाग गीस—अऊ ओह समझ गीस कि येह एक सपना रिहिस।</para>
  <para style="p" vid="1KI 3:15">तब ओह यरूसलेम लहुंट गीस, अऊ परभू के करार के सन्दूक के आघू म ठाढ़ होईस अऊ होम-बलिदान अऊ मेल-बलिदान करिस। तब ओह अपन जम्मो करमचारीमन बर एक भोज करिस।<verse eid="1KI 3:15"/></para>
  <para style="s1">बुद्धिमानी से राज करई</para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 3:16"/>एक बार दू झन बेस्या राजा करा आके ओकर आघू म ठाढ़ होईन। <verse eid="1KI 3:16"/><verse number="17" style="v" sid="1KI 3:17"/>ओमा के एक झन कहिस, “हे मोर मालिक! में अऊ ये माईलोगन, हमन दूनों एकेच घर म रहिथन, अऊ येकर संग म रहत मोला एक लइका होईस। <verse eid="1KI 3:17"/><verse number="18" style="v" sid="1KI 3:18"/>मोर लइका होय के तीन दिन के बाद, ये माईलोगन ला घलो एक लइका होईस। हमन अकेला रहेंन; हमर दूनों के छोंड़ घर म अऊ कोनो नइं रिहिस।<verse eid="1KI 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 3:19"/>“रथिया ये माईलोगन के बेटा ह येकर खाल्हे म दबके मर गीस। <verse eid="1KI 3:19"/><verse number="20" style="v" sid="1KI 3:20"/>जब में, तोर सेविका ह सोवत रहेंव, तब येह आधा रथिया उठिस, अऊ मोर बाजू ले मोर बेटा ला लेके अपन छाती म रखिस अऊ अपन मरे बेटा ला मोर छाती म रख दीस। <verse eid="1KI 3:20"/><verse number="21" style="v" sid="1KI 3:21"/>बिहनियां, जब में अपन बेटा ला दूध पीयाय बर उठेंव, त देखेंव कि ओह मर गे रहय! पर जब मेंह बिहनियां के अंजोर म धियान से देखेंव, त जानेंव कि येह मोर जनमाय बेटा नो हय।”<verse eid="1KI 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 3:22"/>तब दूसर माईलोगन ह कहिस, “नइं! जीयत लइका ह मोर बेटा अय; मरे लइका ह तोर बेटा अय।”</para>
  <para style="p" vid="1KI 3:22">पर पहिली माईलोगन ह जोर देके कहिस, “नइं! मरे लइका ह तोर अय; अऊ जीयत लइका ह मोर अय।” ये किसम ले ओमन राजा के आघू म बहस करे लगिन।<verse eid="1KI 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 3:23"/>राजा ह कहिस, “एक झन ह कहत हे, ‘मोर बेटा ह जीयत हवय अऊ तोर बेटा ह मर गे हवय,’ जबकि दूसर झन ह कहत हे, ‘नइं! तोर बेटा ह मर गे हवय अऊ मोर ह जीयत हवय।’ ”<verse eid="1KI 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 3:24"/>तब राजा ह कहिस, “मोर करा एक ठन तलवार लानव।” एकरसेति एक तलवार राजा करा लाने गीस। <verse eid="1KI 3:24"/><verse number="25" style="v" sid="1KI 3:25"/>तब राजा ह हुकूम दीस, “जीयत लइका ला काटके दू कुटा कर दव अऊ आधा एक झन ला अऊ आधा दूसर झन ला दे दव।”<verse eid="1KI 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 3:26"/>तब ओ माईलोगन जेकर बेटा जीयत रिहिस, ओकर मन ह अपन बेटा के मया ले भर आईस अऊ ओह राजा ले कहिस, “हे मोर मालिक! जीयत लइका ला ओला देय दे! लइका ला झन मार!”</para>
  <para style="p" vid="1KI 3:26">पर दूसर माईलोगन ह कहिस, “ओ लइका ह न तो तोर होवय अऊ न ही मोर। काटके ओकर दू कुटा कर दव!”<verse eid="1KI 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 3:27"/>तब राजा ह अपन ये फैसला सुनाईस, “पहिली माईलोगन ला जीयत लइका दे दव। लइका ला झन मारव; काबरकि ओह लइका के दाई अय।”<verse eid="1KI 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 3:28"/>जब जम्मो इसरायलीमन राजा के दिये फैसला ला सुनिन, त ओमन राजा के भय मानके ओकर आदर करिन, काबरकि ओमन देखिन कि ओकर करा नियाय करे बर परमेसर के दिये बुद्धि हवय।<verse eid="1KI 3:28"/></para>
  <chapter eid="1KI 3"/>
  <chapter number="4" style="c" sid="1KI 4"/>
  <para style="s1">सुलेमान के करमचारी अऊ राजपालमन</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 4:1"/>राजा सुलेमान ह जम्मो इसरायल ऊपर राज करिस।<verse eid="1KI 4:1"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="2" style="v" sid="1KI 4:2"/>अऊ येमन ओकर परधान करमचारी रिहिन:</para>
  <para style="b" vid="1KI 4:2"/>
  <para style="li1" vid="1KI 4:2">सादोक के बेटा अजरयाह—पुरोहित;<verse eid="1KI 4:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1KI 4:3"/>सीसा के बेटा एलीहोरेप अऊ अहियाह—सचिव;</para>
  <para style="li1" vid="1KI 4:3">अहीलूद के बेटा यहोसापात—इतिहास के लिखइया;<verse eid="1KI 4:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1KI 4:4"/>यहोयादा के बेटा बनायाह—परधान सेनापति;</para>
  <para style="li1" vid="1KI 4:4">सादोक अऊ अबियातार—पुरोहित;<verse eid="1KI 4:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1KI 4:5"/>नातान के बेटा अजरयाह—जिला राजपालमन के ऊपर मुखिया;</para>
  <para style="li1" vid="1KI 4:5">अऊ नातान के बेटा जाबूद—एक पुरोहित अऊ राजा के सलाहकार;<verse eid="1KI 4:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1KI 4:6"/>अहीसार—महल के अधिकारी;</para>
  <para style="li1" vid="1KI 4:6">अब्दा के बेटा अदोनीराम—बंधुवा बनिहारमन के ऊपर मुखिया।<verse eid="1KI 4:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="1KI 4:7"/>जम्मो इसरायल म सुलेमान के बारह जिला राजपाल रिहिन, जऊन मन राजा अऊ राज-घराना बर जेवन के परबंध करत रिहिन। हर एक राजपाल ह साल म ठहिराय एक महिना के जेवन के परबंध करय।<verse eid="1KI 4:7"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="8" style="v" sid="1KI 4:8"/>राजपालमन के नांव ये रिहिस:</para>
  <para style="b" vid="1KI 4:8"/>
  <para style="li1" vid="1KI 4:8">बेन-हूर—एपरैम के पहाड़ी इलाका म;<verse eid="1KI 4:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1KI 4:9"/>बेन-देकर—माकस, सालबीम, बेत-सेमेस अऊ एलोन-बेतानन म;<verse eid="1KI 4:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1KI 4:10"/>बेन-हेसेद—अरूब्बोत म (सोको अऊ हेपेर के जम्मो देस ओकर रिहिन);<verse eid="1KI 4:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1KI 4:11"/>बेन-अबीनादाब—नपोत-दोर म (येह सुलेमान के बेटी तापत ले बिहाव करे रिहिस);<verse eid="1KI 4:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1KI 4:12"/>अहीलूद के बेटा बाना—तानाक, मगिद्दो अऊ बेत-सान के ओ जम्मो देस म रिहिस, जऊन ह सारतान के बाद अऊ यिजरेल के खाल्हे, बेत-सान अऊ आबेल-महोला ले लेके योकमाम के ओ पार तक रिहिस;<verse eid="1KI 4:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1KI 4:13"/>बेन-गेबेर—रामोत-गिलाद म (गिलाद म मनस्से के बेटा याईर के गांवमन ओकर रिहिन, अऊ संग म बासान के अरगोब के इलाका अऊ कांसा दुवार के डंडामन के संग बड़े दीवारवाले साठ ठन सहर घलो ओकर रिहिन);<verse eid="1KI 4:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1KI 4:14"/>इद्दो के बेटा अहीनादाब—महनैम सहर म;<verse eid="1KI 4:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1KI 4:15"/>अहीमास—नपताली म (येह सुलेमान के बेटी बासमत ले बिहाव करे रिहिस);<verse eid="1KI 4:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1KI 4:16"/>हूसै के बेटा बाना—आसेर अऊ आलोत म;<verse eid="1KI 4:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1KI 4:17"/>पारूह के बेटा यहोसापात—इस्साकार के इलाका म;<verse eid="1KI 4:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1KI 4:18"/>एला के बेटा सिमी—बिनयामीन म;<verse eid="1KI 4:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1KI 4:19"/>ऊरी के बेटा गेबेर—गिलाद म (अमोरीमन के राजा सीहोन के देस अऊ बासान के राजा ओग के देस)। ये जिला के सिरिप ओहीच ह राजपाल रिहिस।<verse eid="1KI 4:19"/></para>
  <para style="s1">सुलेमान के एक दिन के जेवन</para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 4:20"/>यहूदा अऊ इसरायल के मनखेमन समुंदर तीर के बालू के सहीं अनगिनत रिहिन; ओमन खावत-पीयत रिहिन अऊ खुस रिहिन। <verse eid="1KI 4:20"/><verse number="21" style="v" sid="1KI 4:21"/>अऊ सुलेमान ह फरात नदी अऊ पलिस्तीमन के देस ले लेके मिसर के सीमना तक जम्मो राज म सासन करत रिहिस। ये देसमन सुलेमान ला ओकर जिनगी भर राजकीय लगान दीन अऊ ओकर अधीन रिहिन।<verse eid="1KI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 4:22"/>सुलेमान अऊ ओकर परिवार के एक दिन के रसोई तीस कोर<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">लगभग साढ़े 5 टन</char></note> बढ़िया पीसान, साठ कोर<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">लगभग 11 टन</char></note> मैदा, <verse eid="1KI 4:22"/><verse number="23" style="v" sid="1KI 4:23"/>कोठार म रखके खवाय गे दस ठन बईला, मैदान म चराय गे बीस ठन पसु अऊ एक सौ भेड़-बकरी अऊ संग म हिरन, चिकारा, सांबर अऊ मनपसंद चिरई। <verse eid="1KI 4:23"/><verse number="24" style="v" sid="1KI 4:24"/>काबरकि ओह फरात नदी के पछिम के जम्मो राज, तिपसह सहर ले लेके गाजा सहर तक राज करत रिहिस, अऊ ओकर चारों कोति सांति रिहिस। <verse eid="1KI 4:24"/><verse number="25" style="v" sid="1KI 4:25"/>सुलेमान के जिनगी भर, दान सहर ले लेके बेरसेबा सहर तक, यहूदा अऊ इसरायल के मनखेमन अपन-अपन अंगूर अऊ अंजीर खाके निडर रहत रिहिन।<verse eid="1KI 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 4:26"/>सुलेमान करा रथ के घोड़ामन बर चार<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">कुछू हस्तलिपि म </char><char style="fqa" closed="false">चालीस हजार</char></note> हजार घुड़साल के कोठरी, अऊ बारह हजार घोड़ा रिहिन।<verse eid="1KI 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 4:27"/>जिला के राजपालमन अपन-अपन ठहिराय महिना म, राजा सुलेमान अऊ ओकर मेज म खवइया जम्मो मनखे बर जेवन के परबंध करंय। ओमन ये बात के धियान रखंय कि कोनो चीज के कमी झन होवय। <verse eid="1KI 4:27"/><verse number="28" style="v" sid="1KI 4:28"/>ओमन रथ के घोड़ा अऊ आने घोड़ामन बर घलो अपन बर ठहिराय जौ अऊ पैंरा के भाग सही जगह म लानंय।<verse eid="1KI 4:28"/></para>
  <para style="s1">सुलेमान के बुद्धि</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 4:29"/>परमेसर ह सुलेमान ला बहुंत बुद्धि अऊ अंतर-गियान दीस, अऊ ओकर समझ ला अइसने बढ़ाईस, जइसने समुंदर तीर के बालू, जऊन ला कि नापे नइं जा सकय। <verse eid="1KI 4:29"/><verse number="30" style="v" sid="1KI 4:30"/>सुलेमान के बुद्धि ह पूरब देस के जम्मो मनखे अऊ मिसर देस के जम्मो मनखेमन के बुद्धि ले घलो बढ़के रिहिस। <verse eid="1KI 4:30"/><verse number="31" style="v" sid="1KI 4:31"/>ओह जम्मो मनखेमन ले बढ़के बुद्धिमान रिहिस; एतान एजराही अऊ माहोल के बेटा हेमान, कलकोल अऊ दरदा ले घलो जादा बुद्धिमान रिहिस। अऊ ओकर कीरति ह आसपास के जम्मो देस म फईल गीस। <verse eid="1KI 4:31"/><verse number="32" style="v" sid="1KI 4:32"/>ओह तीन हजार नीतिबचन कहिस, अऊ ओकर एक हजार पांच गीत घलो हवंय। <verse eid="1KI 4:32"/><verse number="33" style="v" sid="1KI 4:33"/>ओह रूख-रईमन के बारे म गोठियाईस—लबानोन के देवदार रूख ले लेके दीवारमन म उगइया जूफा तक के चरचा करिस। ओह पसु अऊ चिरई, पेट के भार रेंगइया जन्तु अऊ मछरीमन के बारे म घलो कहिस। <verse eid="1KI 4:33"/><verse number="34" style="v" sid="1KI 4:34"/>जम्मो देस के मनखेमन सुलेमान के बुद्धि के बात सुने बर आवत रिहिन—संसार के जम्मो राजा, जऊन मन ओकर बुद्धि के बारे म सुने रिहिन, अपन मनखेमन ला सुलेमान के बुद्धि के बात सुने बर पठोत रिहिन।<verse eid="1KI 4:34"/></para>
  <chapter eid="1KI 4"/>
  <chapter number="5" style="c" sid="1KI 5"/>
  <para style="s1">मंदिर बनाय के तियारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 5:1"/>जब सूर सहर के राजा हीराम ह ये सुनिस कि सुलेमान ला ओकर ददा दाऊद के जगह म राजा बनाय गे हवय, त ओह अपन दूत ला सुलेमान करा पठोईस, काबरकि दाऊद के संग ओकर हमेसा संगवारी के नाता रिहिस। <verse eid="1KI 5:1"/><verse number="2" style="v" sid="1KI 5:2"/>सुलेमान ह वापिस हीराम करा ये संदेस पठोईस:<verse eid="1KI 5:2"/></para>
  <para style="pm">
    <verse number="3" style="v" sid="1KI 5:3"/>“तेंह तो जानत हस कि मोर ददा दाऊद ह यहोवा ओकर परमेसर के नांव के एक मंदिर नइं बनवा सकिस काबरकि ओह चारों कोति लड़ई म तब तक उलझे रिहिस, जब तक कि यहोवा ह ओकर बईरीमन ला ओकर गोड़ खाल्हे नइं कर दीस। <verse eid="1KI 5:3"/><verse number="4" style="v" sid="1KI 5:4"/>पर अब यहोवा मोर परमेसर ह मोला चारों कोति ले बिसराम दे हवय, अऊ अब न तो कोनो बिरोधी हवय, अऊ न ही कोनो बिपत्ति दिखत हे। <verse eid="1KI 5:4"/><verse number="5" style="v" sid="1KI 5:5"/>एकरसेति मेंह यहोवा अपन परमेसर के नांव के एक मंदिर बनाय चाहत हंव, जइसे कि यहोवा ह मोर ददा दाऊद ले कहे रिहिस, ‘तोर ओ बेटा ह मोर नांव के मंदिर बनाही, जेला मेंह तोर जगह म सिंघासन म बईठाहूं।’<verse eid="1KI 5:5"/></para>
  <para style="pm">
    <verse number="6" style="v" sid="1KI 5:6"/>“एकरसेति अब तेंह हुकूम दे कि मोर बर लबानोन के देवदार रूख काटे जावंय। मोर आदमीमन तोर आदमीमन के संग काम करहीं, अऊ जऊन कुछू भी बनी, तेंह अपन मनखेमन बर ठहिराबे, ओला मेंह दूहूं। तेंह तो जानत हस कि सीदोनीमन के सहीं कठवा काटे के जानकार मनखे हमर करा एको झन नइं एं।”<verse eid="1KI 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 5:7"/>जब हीराम ह सुलेमान के संदेस ला सुनिस, त ओह अब्बड़ खुस होईस अऊ कहिस, “आज यहोवा के महिमा होवय, काबरकि ओह दाऊद ला ओ बड़े जाति ऊपर राज करे बर एक बुद्धिमान बेटा दे हवय।”<verse eid="1KI 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 5:8"/>तब हीराम ह सुलेमान करा ये खबर पठोईस:</para>
  <para style="pm" vid="1KI 5:8">“मोला तोर संदेस ह मिल गे हवय अऊ तोर ईछा के मुताबिक मेंह तोला देवदार अऊ सनोवर के कठवा दूहूं। <verse eid="1KI 5:8"/><verse number="9" style="v" sid="1KI 5:9"/>मोर आदमीमन कठवा ला लबानोन ले भूमध्य सागर तक लानहीं, अऊ मेंह ओमन के बेड़ा बनवाके, समुंदर के रसता ले ओ जगह म भिजवा दूहूं, जिहां तें कहिबे। उहां मेंह ओमन ला खोलके अलग-अलग कर दूहूं, तब तें ओमन ला ले जा सकत हस। अऊ तेंह मोर राज-परिवार बर जेवन देय के दुवारा मोर ईछा ला पूरा करबे।”<verse eid="1KI 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 5:10"/>ये किसम ले हीराम ह सुलेमान के ईछा के मुताबिक ओला देवदार अऊ सनोवर के कठवा देवन लगिस, <verse eid="1KI 5:10"/><verse number="11" style="v" sid="1KI 5:11"/>अऊ सुलेमान ह हीराम के परिवार के खाय बर ओला बीस हजार कोर<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">लगभग 3,600 टन</char></note> गहूं अऊ बीस हजार बत<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">लगभग 4,40,000लीटर</char></note> पेरे गय जैतून तेल दीस। सुलेमान ह हीराम करा हर साल अइसने जेवन पठोईस। <verse eid="1KI 5:11"/><verse number="12" style="v" sid="1KI 5:12"/>यहोवा ह अपन वायदा के मुताबिक सुलेमान ला बुद्धि दीस। हीराम अऊ सुलेमान के बीच म सांति के नाता बने रिहिस अऊ ओ दूनों झन आपस म एक करार घलो करिन।<verse eid="1KI 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 5:13"/>राजा सुलेमान ह जम्मो इसरायल ले तीस हजार मनखेमन ला जरूरी बनिहार के रूप म लगाईस। <verse eid="1KI 5:13"/><verse number="14" style="v" sid="1KI 5:14"/>ओह ओमन के दस-दस हजार के दल बनाईस अऊ हर दल ला पारी-पारी करके महिना म लबानोन पठोय करत रिहिस अऊ ओमन एक महिना लबानोन म अऊ दू महिना घर म रहे करत रिहिन। अदोनीराम ह ये जरूरी बनिहारमन के अधिकारी रिहिस। <verse eid="1KI 5:14"/><verse number="15" style="v" sid="1KI 5:15"/>सुलेमान करा पहाड़ी म सत्तर हजार बोझा ढोवइया बनिहार अऊ अस्सी हजार पथरा कटइया मनखेमन रिहिन, <verse eid="1KI 5:15"/><verse number="16" style="v" sid="1KI 5:16"/>येमन ला छोंड़के सुलेमान करा तीन हजार तीन सौ<note caller="+" style="f"><char style="fr" closed="false">5:16 </char><char style="ft" closed="false">कुछू हस्तलिपि म (देखव <char style="xt"><ref loc="2CH 2:2">2 इति 2:2</ref>, <ref loc="2CH 2:18">18</ref></char>) </char><char style="fqa" closed="false">तीन हजार छै सौ</char></note> बनिहारमन के अधिकारी रिहिन, जऊन मन ओ काम के देखरेख करंय अऊ बनिहारमन ला काम बतावंय। <verse eid="1KI 5:16"/><verse number="17" style="v" sid="1KI 5:17"/>राजा के हुकूम ले ओमन बड़े-बड़े कीमती पथरा ला खदान ले निकालत रिहिन, ताकि गढ़े गय पथरामन ला मंदिर के नीव म डाले जा सकय। <verse eid="1KI 5:17"/><verse number="18" style="v" sid="1KI 5:18"/>ये किसम ले, सुलेमान अऊ हीराम के कारीगरमन अऊ गबाल के बनिहारमन मंदिर बनाय बर लकड़ी अऊ पथरामन ला काटिन अऊ तियार करिन।<verse eid="1KI 5:18"/></para>
  <chapter eid="1KI 5"/>
  <chapter number="6" style="c" sid="1KI 6"/>
  <para style="s1">सुलेमान ह मंदिर बनाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 6:1"/>इसरायलीमन के मिसर देस ले निकले के चार सौ अस्सीवां साल के बाद, जऊन ह कि सुलेमान के इसरायल ऊपर राज करे के चौथा साल रिहिस, जीव के महिना म, जऊन ला दूसरा महिना घलो कहे जावय, सुलेमान ह यहोवा के मंदिर ला बनाय के काम सुरू करिस।<verse eid="1KI 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 6:2"/>जऊन मंदिर, राजा सुलेमान ह यहोवा बर बनाईस, ओह साठ क्यूबीट लम्बा, बीस क्यूबीट चौड़ा अऊ तीस क्यूबीट ऊंचा रिहिस।<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">लगभग 90 फीट लम्बा, 30 फीट चौड़ा अऊ 45 फीट ऊंचहा</char></note> <verse eid="1KI 6:2"/><verse number="3" style="v" sid="1KI 6:3"/>मंदिर के सबले बड़े कमरा के आघू म जऊन मंडप रिहिस, ओकर लम्बई मंदिर के चौड़ई के बरोबर, याने कि बीस क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">लगभग 30 फीट</char></note> रिहिस, अऊ मंदिर के आघू म मंडप ह दस क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">लगभग 15 फीट</char></note> निकले रिहिस। <verse eid="1KI 6:3"/><verse number="4" style="v" sid="1KI 6:4"/>ओह मंदिर के दीवारमन म ऊंचई म संकरा खिड़कीमन ला बनाईस। <verse eid="1KI 6:4"/><verse number="5" style="v" sid="1KI 6:5"/>सबले बड़े कमरा अऊ भीतरी पबितर-स्थान के दीवारमन के सामने, ओह भवन के चारों कोति एक परिसर बनाईस, जेकर किनारे म कमरामन रहंय। <verse eid="1KI 6:5"/><verse number="6" style="v" sid="1KI 6:6"/>सबले खाल्हे वाले मंजिल के चौड़ई पांच क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">लगभग साढ़े सात फीट</char></note>, बीच वाले मंजिल के छै क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">लगभग 9 फीट</char></note> अऊ तीसर मंजिल के चौड़ई सात क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">लगभग 11 फीट</char></note> रिहिस। ओह मंदिर के बाहिर चारों कोति निकले हुए चीज बनाईस, ताकि मंदिर के दीवार म कोनो घलो चीज जोड़े झन जा सकय।<verse eid="1KI 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 6:7"/>मंदिर के बनाय म, सिरिप खदान म गढ़े गय पथरामन के उपयोग करे गीस, अऊ मंदिर बने के बेरा, कोनो हथौड़ा, छैनी या अऊ कोनो किसम के लोहा के औजार के अवाज मंदिर इलाका म सुनई नइं दीस।<verse eid="1KI 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 6:8"/>खाल्हे<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">बीच वाले</char></note> के मंजिल म जाय बर मंदिर के दक्खिन कोति कपाट रिहिस; बीच के मंजिल म जाय बर एक सीढ़ी रिहिस अऊ उहां ले तीसरा मंजिल म जाय बर घलो सीढ़ी रिहिस। <verse eid="1KI 6:8"/><verse number="9" style="v" sid="1KI 6:9"/>ओह छानी म बड़े अऊ लम्बा लकड़ीमन के संग देवदार के तखतामन ला लगाईस, अऊ मंदिर के काम ला पूरा करिस। <verse eid="1KI 6:9"/><verse number="10" style="v" sid="1KI 6:10"/>अऊ ओह पूरा मंदिर के किनारे कमरामन ला बनवाईस। हर कमरा के ऊंचई पांच क्यूबीट रिहिस, अऊ ये कमरामन मंदिर ले देवदार के लकड़ी ले जुड़े रिहिन।<verse eid="1KI 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 6:11"/>तब यहोवा के ये बचन सुलेमान करा आईस: <verse eid="1KI 6:11"/><verse number="12" style="v" sid="1KI 6:12"/>“जइसने कि तेंह ये मंदिर ला बनावत हस, यदि तेंह मोर बिधि, कानून अऊ हुकूममन के मुताबिक चलके ओमन के पालन करबे, त जऊन वायदा मेंह तोर ददा दाऊद ले करे रहेंव, ओला मेंह तोर जरिये पूरा करहूं। <verse eid="1KI 6:12"/><verse number="13" style="v" sid="1KI 6:13"/>अऊ मेंह इसरायलीमन के बीच म निवास करहूं अऊ अपन इसरायली मनखेमन ला नइं छोंड़हूं।”<verse eid="1KI 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 6:14"/>सुलेमान ह मंदिर बनाय के काम ला पूरा करिस। <verse eid="1KI 6:14"/><verse number="15" style="v" sid="1KI 6:15"/>ओह मंदिर के भीतरी दीवारमन ला देवदार के तखतामन ले मंदिर के फर्स अऊ छानी ला जोड़िस, अऊ मंदिर के फर्स ला सनोवर के तखता ले बनाईस। <verse eid="1KI 6:15"/><verse number="16" style="v" sid="1KI 6:16"/>ओह मंदिर के भीतर पाछू कोति फर्स ले लेके छानी तक देवदार के तखता लगाके बीस क्यूबीट के एक भीतरी पबितर-स्थान बनाईस; येला महा पबितर स्थान कहे जावय। <verse eid="1KI 6:16"/><verse number="17" style="v" sid="1KI 6:17"/>ये कोठरी के आघू म जऊन मुख्य बड़े कमरा रिहिस, ओह चालीस क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">लगभग 60 फीट</char></note> लम्बा रिहिस। <verse eid="1KI 6:17"/><verse number="18" style="v" sid="1KI 6:18"/>मंदिर के भीतर ह देवदार लकरी के बने रिहिस अऊ लकरी म लौकी अऊ खिले फूलमन के चित्र बनाय गे रिहिस, उहां जम्मो चीज देवदार लकरी के रिहिस; कोनो चीज पथरा के नइं रिहिस।<verse eid="1KI 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 6:19"/>ओह मंदिर म भीतरी पबितर-स्थान ला तियार करिस ताकि उहां यहोवा के करार के सन्दूक ला रखे जा सकय। <verse eid="1KI 6:19"/><verse number="20" style="v" sid="1KI 6:20"/>ओ भीतरी पबितर-स्थान ह बीस क्यूबीट लम्बा, बीस क्यूबीट चौड़ा अऊ बीस क्यूबीट ऊंचा रिहिस। ओह भीतर ला सुध सोन ले मढ़वाईस अऊ ओह देवदार के बेदी ला घलो मढ़वाईस। <verse eid="1KI 6:20"/><verse number="21" style="v" sid="1KI 6:21"/>सुलेमान ह मंदिर के भीतर ला सुध सोन ले मढ़वाईस, अऊ ओह सोन के जंजीर ला भीतरी पबितर-स्थान के सामने एक तरफ ले दूसर तरफ तक बढ़ाईस; जऊन ह सोन ले मढ़े गे रिहिस। <verse eid="1KI 6:21"/><verse number="22" style="v" sid="1KI 6:22"/>ओह पूरा भीतर के भाग ला सोन ले मढ़वाईस। ओह भीतरी पबितर-स्थान के बेदी ला घलो सोन ले मढ़वाईस।<verse eid="1KI 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 6:23"/>भीतरी पबितर-स्थान बर, ओह जैतून लकड़ी के एक जोड़ा करूब बनाईस, अऊ ओमा के हर एक के ऊंचई दस-दस क्यूबीट रिहिस। <verse eid="1KI 6:23"/><verse number="24" style="v" sid="1KI 6:24"/>पहिली करूब के एक डेना ह पांच क्यूबीट लम्बा, अऊ दूसर डेना ह पांच क्यूबीट लम्बा रिहिस—एक डेना के सिरा ले लेके दूसर डेना के सिरा तक लम्बई दस क्यूबीट रिहिस। <verse eid="1KI 6:24"/><verse number="25" style="v" sid="1KI 6:25"/>दूसर करूब के नाप घलो दस क्यूबीट के रिहिस; दूनों करूब एकेच आकार अऊ बनावट के रिहिन। <verse eid="1KI 6:25"/><verse number="26" style="v" sid="1KI 6:26"/>हर एक करूब के ऊंचई दस क्यूबीट के रिहिस। <verse eid="1KI 6:26"/><verse number="27" style="v" sid="1KI 6:27"/>ओह करूबमन ला मंदिर के सबले भीतर के कमरा म रखिस, अऊ करूबमन के डेनामन फईले रहंय। एक करूब के एक डेना ह एक दीवार ला, जबकि दूसर करूब के डेना ह दूसर दीवार ला छूवत रहय, अऊ दूनों करूब के डेनामन भवन के मांझा म एक-दूसर ले छूवत रिहिन। <verse eid="1KI 6:27"/><verse number="28" style="v" sid="1KI 6:28"/>ओह करूबमन ला सोन ले मढ़वाईस।<verse eid="1KI 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 6:29"/>मंदिर के चारों कोति दीवारमन म, दूनों भीतरी अऊ बाहिरी कमरामन म, ओह करूब, खजूर के रूख अऊ खिले फूल खनवाके बनवाईस। <verse eid="1KI 6:29"/><verse number="30" style="v" sid="1KI 6:30"/>ओह मंदिर के दूनों भीतरी अऊ बाहिरी कमरामन के फर्समन ला सोन ले मढ़वाईस।<verse eid="1KI 6:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 6:31"/>भीतरी पबितर-स्थान के प्रवेस दुवार बर, ओह जैतून लकड़ी के बने कपाटमन ला बनवाईस, जेमन आकार म पबितर-स्थान के चौड़ई के पांचवां भाग रिहिन। <verse eid="1KI 6:31"/><verse number="32" style="v" sid="1KI 6:32"/>अऊ दू ठन जैतून लकड़ी के कपाट म, ओह करूब, खजूर के रूख अऊ खिले फूल खनवाके बनवाईस, अऊ करूब अऊ खजूर के रूखमन के ऊपर म हथौड़ी ले पीटे सोन मढ़वाईस। <verse eid="1KI 6:32"/><verse number="33" style="v" sid="1KI 6:33"/>ओही किसम ले, ओह मुख्य बड़े कमरा के प्रवेस दुवार बर जैतून लकड़ी के चौखट बनवाईस, जेमन के आकार बड़े कमरा के चौड़ई के चौथा भाग रिहिन। <verse eid="1KI 6:33"/><verse number="34" style="v" sid="1KI 6:34"/>ओह सनोवर के कठवा के घलो दू ठन कपाट बनवाईस, अऊ ये दूनों कपाट म दू-दू ठन पान मुड़े हुए बनाय गे रिहिन। <verse eid="1KI 6:34"/><verse number="35" style="v" sid="1KI 6:35"/>ओह ओमन म घलो करूब, खजूर के रूख अऊ खिले फूल खनवाके बनवाईस अऊ ओमन के ऊपर खनवाय भाग म सही ढंग म हथौड़ी ले पीटे सोन मढ़वाईस।<verse eid="1KI 6:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 6:36"/>अऊ ओह भीतर के अंगना ला गढ़े गय पथरामन के तीन परत, अऊ एक परत सुघर देवदार रूख के बल्लीमन ले बनाईस।<verse eid="1KI 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 6:37"/>चौथा बछर के जीव नांव के महिना म, यहोवा के मंदिर के नीव रखे गीस। <verse eid="1KI 6:37"/><verse number="38" style="v" sid="1KI 6:38"/>अऊ गियारहवां बछर के बूल<note caller="+" style="f"><char style="fr" closed="false">6:38 </char><char style="ft" closed="false">येह एक कनानी महिना ए, जेमा अक्टूबर के आधा अऊ नवम्बर महिना के आधा दिनमन आथें</char></note> नांव के आठवां महिना म, पूरा मंदिर के काम ह दिये गय निरदेस के मुताबिक पूरा हो गीस। सुलेमान ला ये मंदिर बनाय म सात बछर लगिस।<verse eid="1KI 6:38"/></para>
  <chapter eid="1KI 6"/>
  <chapter number="7" style="c" sid="1KI 7"/>
  <para style="s1">सुलेमान ह अपन महल बनाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 7:1"/>सुलेमान ह अपन महल घलो बनाईस, अऊ ओला बनाय म तेरह बछर लगिस। <verse eid="1KI 7:1"/><verse number="2" style="v" sid="1KI 7:2"/>ओह लबानोन के जंगल नांव के महल बनाईस, जेकर लम्बई सौ क्यूबीट, चौड़ई पचास क्यूबीट अऊ ऊंचई तीस क्यूबीट के रिहिस;<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">लगभग 150 फीट लम्बा, 75 फीट चौड़ा अऊ 45 फीट ऊंचहा</char></note> ओह देवदार के खंभामन के चार कतार म बनिस अऊ खंभामन ला सुघर देवदार के कड़ीमन संभाले रिहिन। <verse eid="1KI 7:2"/><verse number="3" style="v" sid="1KI 7:3"/>येकर छानी ला देवदार लकरी के संग कड़ीमन के ऊपर खंभामन के सहारा म बनाय गीस; उहां पैंतालीस ठन कड़ी रिहिन अऊ येमन एक कतार म पंदरह ठन रिहिन। <verse eid="1KI 7:3"/><verse number="4" style="v" sid="1KI 7:4"/>येकर खिड़कीमन, ऊपर म तीन समूह म रिहिन अऊ येमन एक-दूसर के आमने-सामने रिहिन। <verse eid="1KI 7:4"/><verse number="5" style="v" sid="1KI 7:5"/>जम्मो कपाटमन के चौखटमन चौकोर रिहिन; येमन सामने कोति तीन समूह म रिहिन अऊ येमन एक-दूसर के आमने-सामने रिहिन।<verse eid="1KI 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 7:6"/>ओह एक ठन ओसारा घलो बनाईस, जेकर लम्बई पचास क्यूबीट अऊ चौड़ई तीस क्यूबीट के रिहिस।<note caller="+" style="f"><char style="fr" closed="false">7:6 </char><char style="ft" closed="false">लगभग 75 फीट लम्बा अऊ 45 फीट चौड़ा</char></note> येकर आघू म एक मंडप रिहिस, अऊ ओकर आघू म खंभामन रहंय अऊ ऊपर म छानी बने रहय।<verse eid="1KI 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 7:7"/>फेर ओह सिंघासन के बड़े कमरा याने कि नियाय के बड़े कमरा ला नियाय करे बर बनाईस, अऊ येमा फर्स ले लेके छत तक देवदार के कठवा के तखताबंदी करवाईस। <verse eid="1KI 7:7"/><verse number="8" style="v" sid="1KI 7:8"/>अऊ जऊन महल म ओह रहइया रिहिस, दूरिहा पाछू म ओहीच ढंग के बनावट रिहिस। सुलेमान ह ये बड़े कमरा सहीं एक महल फिरौन के बेटी बर घलो बनाईस, जेकर ले ओह बिहाव करे रिहिस।<verse eid="1KI 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 7:9"/>ये जम्मो घर, बाहिर ले लेके बड़े अंगना तक अऊ नीव ले लेके छानी के कोना तक, उच्च कोटी के गढ़े गय पथरामन ले बने रिहिस, जेमन के भीतरी अऊ बाहिरी सतह ह चिकना रहय। <verse eid="1KI 7:9"/><verse number="10" style="v" sid="1KI 7:10"/>येमन के नीव म उच्च कोटी के बड़े-बड़े पथरामन ला डाले गे रिहिस, जेमा कुछू पथरा दस क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false">लगभग 15 फीट</char></note> अऊ कुछू पथरा आठ क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false">लगभग 12 फीट</char></note> के रिहिन। <verse eid="1KI 7:10"/><verse number="11" style="v" sid="1KI 7:11"/>ऊपर म उच्च कोटी के गढ़े गय पथरा, अऊ देवदार के कठवा के कड़ीमन रिहिन। <verse eid="1KI 7:11"/><verse number="12" style="v" sid="1KI 7:12"/>बड़े अंगना ह गढ़े गय पथरा के तीन परत अऊ सुघर देवदार के कड़ीमन के एक परत के दीवार ले चारों कोति ले घिरे रिहिस, जइसने कि यहोवा के मंदिर के भीतरी अंगना ह येकर मंडप सहित घिरे रिहिस।<verse eid="1KI 7:12"/></para>
  <para style="s1">मंदिर के सजावट</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 7:13"/>राजा सुलेमान ह सूर सहर के हूराम ला बुलवाईस। <verse eid="1KI 7:13"/><verse number="14" style="v" sid="1KI 7:14"/>हूराम के दाई ह नपताली के गोत्र के एक बिधवा रिहिस अऊ ओकर ददा ह सूर देस के निवासी रिहिस अऊ कांसा के बढ़िया कारीगर रिहिस। हूराम ह कांसा के जम्मो किसम के काम करे म बुद्धिमान, समझदार अऊ गियानी रिहिस। ओह राजा सुलेमान करा आईस अऊ ओला दिये गय जम्मो काम ला करिस।<verse eid="1KI 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 7:15"/>ओह कांसा ला ढारके अठारह-अठारह क्यूबीट ऊंच अऊ बारह-बारह क्यूबीट गोलई के दू ठन खंभा बनाईस।<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="ft" closed="false">27 फीट ऊंच अऊ 18 फीट गोलई</char></note> <verse eid="1KI 7:15"/><verse number="16" style="v" sid="1KI 7:16"/>ओह खंभा के मुड़ म लगाय बर कांसा ढारके दू ठन कंगनी घलो बनाईस; एक-एक कंगनी के ऊंचई पांच-पांच क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">लगभग 7 1⁄2 फीट</char></note> रिहिस। <verse eid="1KI 7:16"/><verse number="17" style="v" sid="1KI 7:17"/>खंभामन के मुड़ ऊपर कंगनीमन सात-सात ठन गुंथे गय संकली ले सजे रहंय। <verse eid="1KI 7:17"/><verse number="18" style="v" sid="1KI 7:18"/>खंभामन के ऊपर कंगनीमन ला सजाय बर, ओह गुंथे गय संकलीमन के चारों कोति अनारमन के दू-दू ठन कतार बनाईस। ओह हर कंगनी म अइसने करिस। <verse eid="1KI 7:18"/><verse number="19" style="v" sid="1KI 7:19"/>मंडप के खंभामन के मुड़ ऊपर कंगनीमन कुमुदिनी फूल के आकार के रहंय, अऊ येमन के ऊंचई चार-चार क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">7:19 </char><char style="ft" closed="false">लगभग 6 फीट</char></note> के रहय। <verse eid="1KI 7:19"/><verse number="20" style="v" sid="1KI 7:20"/>दूनों खंभा के कंगनीमन म, कटोरा आकार वाले भाग के ऊपर, संकली के बाद दू सौ अनार चारों कोति कतार म बने रहंय। <verse eid="1KI 7:20"/><verse number="21" style="v" sid="1KI 7:21"/>ओह खंभामन ला मंदिर के मंडप म सीधा ठाढ़ करिस। दक्खिन कोति के खंभा के नांव ओह याकीन रखिस अऊ उत्तर कोति के खंभा के नांव बोअज रखिस। <verse eid="1KI 7:21"/><verse number="22" style="v" sid="1KI 7:22"/>कंगनीमन के मुड़ ह कुमुदिनी फूल के आकार म रिहिस। अऊ ये किसम ले खंभामन म काम ह पूरा होईस।<verse eid="1KI 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 7:23"/>ओह ढाले गय धातु ले एक बड़े हौज बनाईस, जऊन ह आकार म गोल रिहिस, ओकर बियास ह दस क्यूबीट अऊ ऊंचई पांच क्यूबीट रिहिस। येकर कुल घेरा के नाप तीस क्यूबीट रिहिस। <verse eid="1KI 7:23"/><verse number="24" style="v" sid="1KI 7:24"/>गोल घेरा के खाल्हे म एक-एक क्यूबीट म दस-दस ठन लौकी बने रहंय। लौकीमन ला हौज के संग दू कतार म एके ठन कुटा म ढालके बनाय गे रिहिस।<verse eid="1KI 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 7:25"/>हौज ला बारह ठन बनाय गे बईलामन ऊपर रखे गे रिहिस, जेमा के तीन ठन के मुहूं उत्तर कोति, तीन के मुहूं पछिम कोति, तीन के मुहूं दक्खिन कोति, अऊ तीन के मुहूं पूरब कोति रिहिस। हौज ला ओमन के ऊपर मढ़ाय गे रिहिस, अऊ ओमन के पाछू के भागमन हौज के मांझा कोति रहंय। <verse eid="1KI 7:25"/><verse number="26" style="v" sid="1KI 7:26"/>येकर मोटई लगभग तीन ईंच रिहिस, अऊ ओकर किनारा ह कटोरा के किनारा असन, खिले कुमुदिनी फूल सहीं रिहिस। ओमा दू हजार बत<note caller="+" style="f"><char style="fr" closed="false">7:26 </char><char style="ft" closed="false">लगभग 44,000 लीटर</char></note> पानी हमात रिहिस।<verse eid="1KI 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 7:27"/>ओह कांसा के दस ठन ठेला घलो बनाईस, हर एक ठेला के लम्बई चार क्यूबीट, चौड़ई घलो चार क्यूबीट अऊ ऊंचई तीन क्यूबीट के रहय।<note caller="+" style="f"><char style="fr" closed="false">7:27 </char><char style="ft" closed="false">लगभग 6 फीट लम्बा अऊ चौड़ा अऊ 4 1⁄2 फीट ऊंचहा</char></note> <verse eid="1KI 7:27"/><verse number="28" style="v" sid="1KI 7:28"/>ओ ठेलामन ला ये किसम ले बनाय गीस: ओमन के तखतामन रिहिन, अऊ तखतामन ढांचामन म फंसाय गे रिहिन। <verse eid="1KI 7:28"/><verse number="29" style="v" sid="1KI 7:29"/>ये तखतामन म सेर, बईला अऊ करूब बने रिहिन—अऊ ढांचामन म घलो ये चित्र बने रिहिन। सेर अऊ बईलामन के ऊपर अऊ खाल्हे हथौड़ा ले बनाय गे झालरमन रिहिन। <verse eid="1KI 7:29"/><verse number="30" style="v" sid="1KI 7:30"/>हर एक ठेला म कांसा के चार-चार पहिया अऊ कांसा के धुरीमन रिहिन, अऊ हर एक ठेला म एक-एक ठन हौदी रहय, जऊन ह चार ठन आधार म टिके रहय अऊ येकर हर किनारे म झालरमन लगे रहंय। <verse eid="1KI 7:30"/><verse number="31" style="v" sid="1KI 7:31"/>ठेला के भीतर भाग म एक खुला जगह रहय, जेकर गोलाकार ढांचा ह एक क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">7:31 </char><char style="ft" closed="false">लगभग 18 ईंच</char></note> गहिरा रहय। ये खुला भाग ह गोलाकार रहय अऊ येकर मुहूं के नाप ह डेड़ क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">7:31 </char><char style="ft" closed="false">लगभग सवा दू फीट</char></note> के रहय। ये खुला भाग के चारों कोति नक्कासी करे गे रहय। ठेलामन के तखतामन गोलाकार न होके चौकोर रिहिन। <verse eid="1KI 7:31"/><verse number="32" style="v" sid="1KI 7:32"/>चारों पहियामन तखतामन के खाल्हे म रिहिन, अऊ पहियामन के धुरीमन ठेला ले जुड़े रिहिन। हर एक पहिया के ऊंचई डेड़-डेड़ क्यूबीट के रिहिस। <verse eid="1KI 7:32"/><verse number="33" style="v" sid="1KI 7:33"/>पहियामन के बनावट ह रथ के पहियामन सहीं रिहिस; धुरी, चकरी, आरा, अऊ नाभमन जम्मो के जम्मो ढाले गय धातु के बने रिहिन।<verse eid="1KI 7:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 7:34"/>हर एक ठेला के चारों कोना म एक-एक ठन मुठिया रिहिस, अऊ ये मुठियामन ठेला ले निकले हुए रिहिन। <verse eid="1KI 7:34"/><verse number="35" style="v" sid="1KI 7:35"/>ठेला के टीप म आधा क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">7:35 </char><char style="ft" closed="false">लगभग 9 ईंच</char></note> गहरई के एक गोलाकार तस्मा रिहिस। आधार अऊ तखतामन ठेला के टीप ले जुड़े हुए रिहिन। <verse eid="1KI 7:35"/><verse number="36" style="v" sid="1KI 7:36"/>ओह आधार अऊ तखतामन के ऊपर जम्मो जगह करूब, सेर अऊ खजूर के रूख खनके बनाईस, अऊ चारों कोति झालर घलो बनाईस। <verse eid="1KI 7:36"/><verse number="37" style="v" sid="1KI 7:37"/>ये किसम ले ओह दस ठन ठेलामन ला बनाईस। ओ जम्मो ठेलामन एकेच सांचा एकेच आकार के रिहिन अऊ दिखे म घलो एक सहीं रिहिन।<verse eid="1KI 7:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 7:38"/>ओह तब कांसा के दस ठन हौदी बनाईस। हर एक हौदी म चालीस-चालीस बत<note caller="+" style="f"><char style="fr" closed="false">7:38 </char><char style="ft" closed="false">लगभग 880 लीटर</char></note> पानी हमात रिहिस अऊ ओमन एक कोति ले दूसर कोति चार-चार क्यूबीट के रिहिन, अऊ ये हौदीमन दसों ठेला म एक-एक ठन रिहिन। <verse eid="1KI 7:38"/><verse number="39" style="v" sid="1KI 7:39"/>ओह पांच ठन ठेला ला मंदिर के दक्खिन कोति अऊ पांच ठन ला उत्तर कोति रखिस। ओह हौज ला दक्खिन कोति, मंदिर के दक्खिन-पूरबी कोना म रखिस। <verse eid="1KI 7:39"/><verse number="40" style="v" sid="1KI 7:40"/>ओह बरतन अऊ बेलचा अऊ छिंचे बर कटोरामन ला घलो बनाईस।</para>
  <para style="p" vid="1KI 7:40">ये किसम ले हूराम ह राजा सुलेमान के दुवारा दिये गय काम ला यहोवा के मंदिर म पूरा करिस।<verse eid="1KI 7:40"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="41" style="v" sid="1KI 7:41"/>दू ठन खंभामन;</para>
  <para style="li1" vid="1KI 7:41">खंभामन के टीप म कटोरा के आकार के दू ठन कंगनी;</para>
  <para style="li1" vid="1KI 7:41">खंभामन के टीप म कटोरा के आकार के दूनों कंगनीमन ला सजाय बर दू ठन जाली;<verse eid="1KI 7:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1KI 7:42"/>दूनों जाली बर चार सौ अनार (खंभामन के टीप म कटोरा के आकार के कंगनीमन ला सजाय बर हर एक जाली म ये अनारमन दू ठन कतार म रहंय);<verse eid="1KI 7:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1KI 7:43"/>दस ठन खुरामन अऊ ओमन के दस ठन तसला;<verse eid="1KI 7:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1KI 7:44"/>हौज अऊ ओकर खाल्हे म बारह ठन बईला;<verse eid="1KI 7:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1KI 7:45"/>बरतन, बेलचा अऊ छिंचनेवाला कटोरामन।</para>
  <para style="b" vid="1KI 7:45"/>
  <para style="p" vid="1KI 7:45">ये जम्मो चीज, जेमन ला हूराम ह यहोवा के मंदिर बर राजा सुलेमान के हुकूम ले बनाईस, येमन चमकदार कांसा के बने रिहिन। <verse eid="1KI 7:45"/><verse number="46" style="v" sid="1KI 7:46"/>राजा ह ओमन ला यरदन के मैदान म सुक्कोत अऊ सारतान के बीच चिक्कन माटी के सांचा ले ढलवाय रिहिस। <verse eid="1KI 7:46"/><verse number="47" style="v" sid="1KI 7:47"/>अब्बड़ सामान होय के कारन सुलेमान ह ये चीजमन ला नइं तऊलिस; कांसा के वजन कतेक रिहिस, पता नइं चलिस।<verse eid="1KI 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="1KI 7:48"/>सुलेमान ह ओ जम्मो सजावट के चीजमन ला घलो बनवाईस, जेमन यहोवा के मंदिर म रिहिन:</para>
  <para style="b" vid="1KI 7:48"/>
  <para style="li1" vid="1KI 7:48">सोन के बेदी;</para>
  <para style="li1" vid="1KI 7:48">सोन के ओ मेज, जेमा भेंट के रोटी रखे जावय;<verse eid="1KI 7:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="1KI 7:49"/>अऊ सुध सोन के दीवटमन (भीतरी पबितर-स्थान के आघू म, पांच ठन जेवनी कोति अऊ पांच ठन डेरी कोति);</para>
  <para style="li1" vid="1KI 7:49">सोन के फूलवाला काम अऊ दीया अऊ चिमटामन;<verse eid="1KI 7:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="1KI 7:50"/>सुध सोन के तसला, बाती ला काटे बर कतरनी, छिंचे के कटोरामन, बरतन अऊ धूपदानीमन;</para>
  <para style="li1" vid="1KI 7:50">अऊ मंदिर के सबले भीतर के कमरा, महा पबितर स्थान के कपाटमन बर सोन के कब्जा, अऊ मंदिर के मुख्य सभा मंडप के कपाटमन बर घलो सोन के कब्जा।<verse eid="1KI 7:50"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="51" style="v" sid="1KI 7:51"/>जब राजा सुलेमान ह यहोवा के मंदिर के जम्मो बुता ला पूरा कर डारिस, तब ओह ओ चीजमन ला लानिस, जेमन ला ओकर ददा दाऊद ह अरपन करे रिहिस—ओमा सोन अऊ चांदी अऊ सजावट के चीजमन रिहिन—अऊ ओह ओमन ला यहोवा के मंदिर के खजाना म रखिस।<verse eid="1KI 7:51"/></para>
  <chapter eid="1KI 7"/>
  <chapter number="8" style="c" sid="1KI 8"/>
  <para style="s1">करार के सन्दूक ला मंदिर म लाने गीस</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 8:1"/>तब राजा सुलेमान ह इसरायल के अगुवामन ला, गोत्रमन के जम्मो मुखियामन ला अऊ इसरायली परिवारमन के मुखियामन ला यरूसलेम म अपन करा बलाईस कि ओमन यहोवा के करार के सन्दूक ला सियोन ले याने कि दाऊद के सहर ले लेय आवंय। <verse eid="1KI 8:1"/><verse number="2" style="v" sid="1KI 8:2"/>एकरसेति जम्मो इसरायलीमन एतानीम<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">सितम्बर अऊ अक्टूबर महिना के आधा-आधा समय आथें</char></note> नांव के सातवां महिना म तिहार के बेरा म राजा सुलेमान करा जूरिन।<verse eid="1KI 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 8:3"/>जब इसरायल के जम्मो अगुवामन आ गीन, त पुरोहितमन सन्दूक ला उठाईन, <verse eid="1KI 8:3"/><verse number="4" style="v" sid="1KI 8:4"/>अऊ ओमन यहोवा के करार के सन्दूक अऊ मिलापवाला तम्बू अऊ ओमा के जम्मो पबितर चीजमन ला ऊपर ले आईन। पुरोहित अऊ लेवीमन ओमन ला उठाके लानिन, <verse eid="1KI 8:4"/><verse number="5" style="v" sid="1KI 8:5"/>अऊ राजा सुलेमान अऊ जम्मो इसरायली सभा, जऊन मन ओकर करा जूरे रिहिन, ओमन सन्दूक के आघू म होके अतेक भेड़ अऊ पसुमन ला बलि करत रिहिन कि ओमन के हिसाब या गनती नइं करे जा सकिस।<verse eid="1KI 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 8:6"/>तब पुरोहितमन यहोवा के करार के सन्दूक ला ओकर जगह म याने कि मंदिर के भीतरी पबितर-स्थान, महा पबितर स्थान म लानिन, अऊ ओला करूबमन के डेना के खाल्हे म मढ़ा दीन। <verse eid="1KI 8:6"/><verse number="7" style="v" sid="1KI 8:7"/>करूबमन अपन डेनामन ला सन्दूक के ऊपर फईलाय रिहिन अऊ सन्दूक अऊ ओकर बोहे के डंडामन ला छाया करत रिहिन। <verse eid="1KI 8:7"/><verse number="8" style="v" sid="1KI 8:8"/>ये डंडामन अतेक लम्बा रिहिन कि ओमन के छोरमन ला भीतरी पबितर-स्थान के सामने पबितर स्थान ले देखे जा सकत रिहिस, पर ओमन ला पबितर स्थान के बाहिर ले नइं देखे जा सकत रिहिस; अऊ ओमन आज भी उहेंच हवंय। <verse eid="1KI 8:8"/><verse number="9" style="v" sid="1KI 8:9"/>सन्दूक म सिरिप ओ दू ठन पथरा के पटिया के छोंड़ अऊ कुछू नइं रिहिस, जेला मूसा ह होरेब पहाड़ ऊपर येमा रखे रिहिस, जिहां इसरायलीमन के मिसर देस ले बाहिर निकले के बाद, यहोवा ह ओमन के संग एक करार करे रिहिस।<verse eid="1KI 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 8:10"/>जब पुरोहितमन पबितर स्थान ले बाहिर निकल गीन, तब यहोवा के मंदिर ह बादर ले भर गीस। <verse eid="1KI 8:10"/><verse number="11" style="v" sid="1KI 8:11"/>अऊ पुरोहितमन बादर के कारन अपन सेवा नइं देय सकिन, काबरकि यहोवा के महिमा ले ओकर मंदिर ह भर गे रिहिस।<verse eid="1KI 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 8:12"/>तब सुलेमान ह कहिस, “यहोवा ह कहे हवय कि ओह करिया बादर म निवास करही; <verse eid="1KI 8:12"/><verse number="13" style="v" sid="1KI 8:13"/>मेंह सही म तोर बर एक सानदार मंदिर बनाय हंव; तोर हमेसा रहे बर निवास के एक ठन जगह।”<verse eid="1KI 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 8:14"/>जब इसरायल के जम्मो सभा ह उहां ठाढ़े रिहिस, त राजा ह ओमन कोति मुहूं करके ओमन ला आसीरबाद दीस। <verse eid="1KI 8:14"/><verse number="15" style="v" sid="1KI 8:15"/>तब ओह कहिस:</para>
  <para style="pm" vid="1KI 8:15">“यहोवा, इसरायल के परमेसर के महिमा होवय, जऊन ह मोर ददा दाऊद के संग अपन मुहूं ले करे गय वायदा ला अपन हांथ ले पूरा करे हवय। काबरकि ओह कहिस, <verse eid="1KI 8:15"/><verse number="16" style="v" sid="1KI 8:16"/>‘जऊन दिन ले मेंह अपन इसरायली मनखेमन ला मिसर ले निकालके लानंय, तब ले मेंह इसरायल के कोनो गोत्र के एको ठन सहर ला एक मंदिर बनाय बर नइं चुने हवंव कि उहां मोर नांव होवय, पर मेंह दाऊद ला अपन इसरायली मनखेमन ऊपर राज करे बर चुने हवंव।’<verse eid="1KI 8:16"/></para>
  <para style="pm">
    <verse number="17" style="v" sid="1KI 8:17"/>“मोर ददा दाऊद के मन म ये बात रिहिस कि ओह इसरायल के परमेसर, यहोवा के नांव खातिर एक मंदिर बनावय। <verse eid="1KI 8:17"/><verse number="18" style="v" sid="1KI 8:18"/>पर यहोवा ह मोर ददा दाऊद ला कहिस, ‘मोर नांव खातिर अपन मन म, एक मंदिर बनवाय के ईछा करके, तेंह बने करे हवस। <verse eid="1KI 8:18"/><verse number="19" style="v" sid="1KI 8:19"/>तभो ले, तेंह ओ मनखे नो हस, जऊन ह ओ मंदिर ला बनाही, पर तोर बेटा, तोर खुद के मांस अऊ लहू—ओही ह मोर नांव बर मंदिर बनवाही।’<verse eid="1KI 8:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="1KI 8:20"/>“यहोवा ह अपन करे गय वायदा ला पूरा करे हवय: मेंह अपन ददा दाऊद के जगह म राजा बने हंव अऊ अब यहोवा के वायदा के मुताबिक मेंह इसरायल के सिंघासन म बईठे हवंव, अऊ मेंह यहोवा, इसरायल के परमेसर के नांव खातिर मंदिर ला बनाय हवंव। <verse eid="1KI 8:20"/><verse number="21" style="v" sid="1KI 8:21"/>मेंह उहां सन्दूक बर एक जगह ठहिराय हवंव, जेमा यहोवा के ओ करार हवय, जेला ओह हमर पुरखामन ले तब करे रिहिस, जब ओह ओमन ला मिसर देस ले निकालके लानिस।”<verse eid="1KI 8:21"/></para>
  <para style="s1">सुलेमान के समरपन के पराथना</para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 8:22"/>तब सुलेमान ह इसरायल के जम्मो सभा के आघू म यहोवा के बेदी के आघू म ठाढ़ होईस, अऊ अपन हांथ ला स्वरग कोति उठाईस <verse eid="1KI 8:22"/><verse number="23" style="v" sid="1KI 8:23"/>अऊ कहिस:</para>
  <para style="pm" vid="1KI 8:23">“हे यहोवा, इसरायल के परमेसर! ऊपर स्वरग म, अऊ खाल्हे धरती म तोर असन कोनो परमेसर नइं एं—तेंह अपन ओ सेवकमन संग करे मया के करार ला पूरा करथस, जेमन पूरा मन से तोर रसता म बने रहिथें। <verse eid="1KI 8:23"/><verse number="24" style="v" sid="1KI 8:24"/>तेंह अपन सेवक मोर ददा दाऊद ले करे ओ वायदा ला बनाय रखे हस, जेला तेंह अपन मुहूं ले बोलके करे रहय अऊ अपन हांथ ले ओला पूरा करे हस—जइसने कि येह आज हवय।<verse eid="1KI 8:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="1KI 8:25"/>“अब हे यहोवा, इसरायल के परमेसर! अपन सेवक मोर ददा दाऊद ले करे गय ओ वायदा ला बनाय रख, जब तेंह कहय, ‘मोर आघू म इसरायल के सिंघासन म बईठे बर तोला उत्तराधिकारी के कमी कभू नइं होवय, यदि सिरिप तोर संतानमन अपन जम्मो काम ला धियान देके बिसवासयोग्यता के संग करंय, जइसे कि तेंह करे हस।’ <verse eid="1KI 8:25"/><verse number="26" style="v" sid="1KI 8:26"/>अऊ अब, हे इसरायल के परमेसर! तोर ओ बचन, जेकर वायदा तेंह अपन सेवक मोर ददा दाऊद ले करे रहय, ओला सच होवन दे।<verse eid="1KI 8:26"/></para>
  <para style="pm">
    <verse number="27" style="v" sid="1KI 8:27"/>“पर का सही म परमेसर ह धरती म निवास करही? स्वरगमन, अऊ त अऊ सबले ऊंच स्वरग घलो तोला धारन नइं कर सकंय। फेर मोर बनाय ये मंदिर तो बहुंत छोटे हे! <verse eid="1KI 8:27"/><verse number="28" style="v" sid="1KI 8:28"/>तभो ले, हे यहोवा, मोर परमेसर! अपन सेवक के पराथना अऊ दया के ओकर बिनती ऊपर धियान दे। मोर रोवई अऊ ओ पराथना ला सुन, जेला आज तोर सेवक ह तोर आघू म करत हवय। <verse eid="1KI 8:28"/><verse number="29" style="v" sid="1KI 8:29"/>तोर आंखीमन रात अऊ दिन ये मंदिर कोति लगे रहंय, ये जगह जेकर बारे म तेंह कहे हस, ‘मोर नांव ह उहां रहिही,’ ताकि तेंह ओ पराथना ला सुनबे, जेला तोर सेवक ये जगह कोति मुहूं करके करथे। <verse eid="1KI 8:29"/><verse number="30" style="v" sid="1KI 8:30"/>अपन सेवक अऊ अपन मनखे इसरायलीमन के बिनती ला सुन, जब ओमन ये जगह कोति मुहूं करके पराथना करथें। स्वरग ले, अपन निवास के जगह ले सुन, अऊ जब तें सुनथस, त ओमन ला छेमा कर।<verse eid="1KI 8:30"/></para>
  <para style="pm">
    <verse number="31" style="v" sid="1KI 8:31"/>“जब कोनो अपन परोसी के बिरूध कोनो अपराध करय अऊ ओला किरिया खाय के जरूरत पड़य अऊ ओह आके ये मंदिर म तोर बेदी के आघू म किरिया खावय, <verse eid="1KI 8:31"/><verse number="32" style="v" sid="1KI 8:32"/>त तेंह स्वरग ले सुनके, अपन सेवकमन के बीच म नियाय करबे। अपराधी के काम ला ओकर मुड़ म लानके ओला सजा देबे, अऊ निरदोस के ओकर निरदोसता के मुताबिक नियाय करबे।<verse eid="1KI 8:32"/></para>
  <para style="pm">
    <verse number="33" style="v" sid="1KI 8:33"/>“जब तोर इसरायली मनखेमन तोर बिरूध पाप करे के कारन, अपन कोनो बईरी ले हार जावंय, अऊ जब ओमन तोर कोति फेर लहुंटंय अऊ ये मंदिर म तोर ले पराथना अऊ बिनती करत, तोर नांव के परसंसा करंय, <verse eid="1KI 8:33"/><verse number="34" style="v" sid="1KI 8:34"/>तब स्वरग ले सुनबे अऊ अपन इसरायली मनखेमन के पाप ला छेमा करबे अऊ ओमन ला ओ देस म लहुंटाके ले आबे, जेला तेंह ओमन के पुरखामन ला देय हस।<verse eid="1KI 8:34"/></para>
  <para style="pm">
    <verse number="35" style="v" sid="1KI 8:35"/>“तोर मनखेमन के तोर बिरूध पाप करे के कारन, जब अकास ह बंद हो जावय अऊ बरसा नइं होवय, अइसने बेरा म जब ओमन ये जगह कोति होके पराथना करंय अऊ तोर नांव के परसंसा करंय अऊ अपन पाप ले मन फिरावंय, काबरकि तेंह ओमन ला दुख म डाले हस, <verse eid="1KI 8:35"/><verse number="36" style="v" sid="1KI 8:36"/>तब स्वरग ले सुनके अपन सेवक, अपन इसरायली मनखेमन के पाप ला छेमा करबे। ओमन ला जीये के सही रसता सिखाबे, अऊ ओ देस म बारिस भेजबे, जेला तेंह अपन मनखेमन ला उत्तराधिकार म देय हस।<verse eid="1KI 8:36"/></para>
  <para style="pm">
    <verse number="37" style="v" sid="1KI 8:37"/>“जब देस म अकाल या महामारी आवय, या फसल म रोग या फफूंदी, टिड्डी या फांफामन लगंय, या जब कोनो बईरी ओमन ला ओमन के कोनो सहर म घेर लेवय, याने कोनो भी बिपत्ति या बेमारी आवय, <verse eid="1KI 8:37"/><verse number="38" style="v" sid="1KI 8:38"/>अऊ जब तोर इसरायली मनखेमन के बीच म ले कोनो ओमन के मन के पीरा ला जानके, ये मंदिर कोति अपन हांथ ला फईलाके पराथना या बिनती करय— <verse eid="1KI 8:38"/><verse number="39" style="v" sid="1KI 8:39"/>त तेंह अपन निवास स्वरग ले सुनके छेमा करबे; हर एक के संग ओमन के काम के मुताबिक बरताव करबे, तेंह ओमन के मन के बात ला जानथस (काबरकि सिरिप तेंहीच ह हर एक मनखे के मन ला जानथस), <verse eid="1KI 8:39"/><verse number="40" style="v" sid="1KI 8:40"/>ताकि जऊन देस ला तेंह हमर पुरखामन ला देय हवस, ओ देस म रहत ओमन हर समय तोर भय मानंय।<verse eid="1KI 8:40"/></para>
  <para style="pm">
    <verse number="41" style="v" sid="1KI 8:41"/>“जहां तक परदेसी के बात ए, जऊन ह तोर इसरायली मनखेमन के बीच म के नो हय, पर ओह तोर नांव ला सुनके दूरिहा देस ले आय हवय— <verse eid="1KI 8:41"/><verse number="42" style="v" sid="1KI 8:42"/>काबरकि परदेसीमन तोर बड़े नांव अऊ बलवंत हांथ अऊ तोर बड़े काम के बारे म सुनहीं—जब ओमन आवंय अऊ ये मंदिर कोति मुहूं करके पराथना करंय, <verse eid="1KI 8:42"/><verse number="43" style="v" sid="1KI 8:43"/>त तेंह स्वरग, अपन निवास स्थान ले सुनबे। जऊन कुछू ओ परदेसी तोर ले मांगय, ओला पूरा करबे, ताकि धरती के जम्मो मनखे तोर नांव ला जानंय अऊ तोर भय मानंय, जइसे कि तोर खुद के इसरायली मनखेमन करथें, अऊ ओमन जानंय कि ये घर ला मेंह तोर नांव बर बनाय हवंव।<verse eid="1KI 8:43"/></para>
  <para style="pm">
    <verse number="44" style="v" sid="1KI 8:44"/>“जब तेंह अपन मनखेमन ला ओमन के बईरीमन के बिरूध म लड़े बर जिहां कहीं भी पठोथस, अऊ जब ओमन यहोवा करा तोर चुने ये सहर अऊ तोर नांव बर मोर बनाय ये मंदिर कोति होके पराथना करंय, <verse eid="1KI 8:44"/><verse number="45" style="v" sid="1KI 8:45"/>तब तेंह स्वरग ले ओमन के पराथना अऊ बिनती ला सुनबे, अऊ ओमन ला संभालबे।<verse eid="1KI 8:45"/></para>
  <para style="pm">
    <verse number="46" style="v" sid="1KI 8:46"/>“जब ओमन तोर बिरूध पाप करंय—काबरकि कोनो भी अइसन नइं ए जऊन ह पाप नइं करय—अऊ तेंह ओमन ऊपर गुस्सा होके ओमन ला ओमन के बईरीमन के हांथ म कर देवस, जऊन मन ओमन ला बंदी बनाके बहुंत दूरिहा या लकठा म अपन देस म ले जावंय; <verse eid="1KI 8:46"/><verse number="47" style="v" sid="1KI 8:47"/>अऊ यदि तोर मनखेमन ओ बंदी बनाय गे देस म अपन मन ला बदलंय, अऊ पछताप करंय अऊ बंदी बनाय गय देस म तोर ले बिनती करके कहंय, ‘हमन पाप करे हवन, हमन गलती करे हवन, हमन दुस्टता के काम करे हवन’; <verse eid="1KI 8:47"/><verse number="48" style="v" sid="1KI 8:48"/>अऊ यदि ओमन अपन ओ बईरीमन के देस म, जऊन मन ओमन ला बंदी बनाके ले गे हवंय, अपन पूरा मन अऊ आतमा ले तोर कोति फिरंय, अऊ ओमन के पुरखामन ला तोर दिये देस कोति, तोर चुने सहर कोति अऊ तोर नांव खातिर मोर बनाय ये मंदिर कोति होके तोर ले पराथना करंय; <verse eid="1KI 8:48"/><verse number="49" style="v" sid="1KI 8:49"/>त तेंह स्वरग अपन निवास स्थान ले ओमन के पराथना अऊ ओमन के बिनती ला सुनबे, अऊ ओमन ला संभालबे। <verse eid="1KI 8:49"/><verse number="50" style="v" sid="1KI 8:50"/>अऊ अपन ओ मनखेमन ला छेमा करबे, जऊन मन तोर बिरूध म पाप करे हवंय; ओ जम्मो अपराध ला छेमा करबे, जेला ओमन तोर बिरूध म करे हवंय, अऊ ओमन ला बंधुवई म ले जवइयामन के मन म ओमन बर दया पईदा करबे। <verse eid="1KI 8:50"/><verse number="51" style="v" sid="1KI 8:51"/>काबरकि ओमन तोर मनखे अऊ तोर निज भाग अंय, जेमन ला तेंह मिसर देस ले, ओ लोहा पिघलइया भट्ठी ले बाहिर निकालके लानय।<verse eid="1KI 8:51"/></para>
  <para style="pm">
    <verse number="52" style="v" sid="1KI 8:52"/>“तोर आंखी तोर सेवक के बिनती अऊ तोर इसरायली मनखेमन कोति लगे रहय, अऊ जब भी ओमन तोर ले गोहारंय, तें ओमन के सुनबे। <verse eid="1KI 8:52"/><verse number="53" style="v" sid="1KI 8:53"/>काबरकि तेंह ओमन ला संसार के जम्मो जाति ले, अपन निज भाग होय बर अलग करे हवस, जइसने कि हे परमपरधान यहोवा, तेंह अपन सेवक मूसा के जरिये कहे रहय, जब तेंह हमर पुरखामन ला मिसर देस ले निकालके लानय।”<verse eid="1KI 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="1KI 8:54"/>जब सुलेमान ह यहोवा ले ये जम्मो पराथना अऊ बिनती कर चुकिस, तब ओह यहोवा के बेदी के आघू ले उठिस, जिहां ओह माड़ी टेकके अकास कोति अपन हांथमन ला फईलाय रिहिस। <verse eid="1KI 8:54"/><verse number="55" style="v" sid="1KI 8:55"/>ओह ठाढ़ होईस अऊ इसरायल के जम्मो सभा ला ऊंचहा अवाज म ये कहिके आसीस दीस:<verse eid="1KI 8:55"/></para>
  <para style="pm">
    <verse number="56" style="v" sid="1KI 8:56"/>“यहोवा के महिमा होवय, जऊन ह अपन वायदा के मुताबिक अपन इसरायली मनखेमन ला बिसराम देय हवय। ओह अपन सेवक मूसा के जरिये जऊन बने वायदामन ला करे रिहिस, ओमा के एको ठन घलो नइं छूटिस। <verse eid="1KI 8:56"/><verse number="57" style="v" sid="1KI 8:57"/>यहोवा हमर परमेसर ह हमर संग रहे, जइसने कि ओह हमर पुरखामन के संग रिहिस; ओह हमन ला कभू झन छोंड़े अऊ कभू झन तियागे। <verse eid="1KI 8:57"/><verse number="58" style="v" sid="1KI 8:58"/>ओह हमर मन ला अपन कोति करय, ताकि हमन ओकर हुकूम के मुताबिक चलन अऊ जऊन हुकूम, बिधि अऊ कानून ओह हमर पुरखामन ला देय रिहिस, ओकर हमन पालन करन। <verse eid="1KI 8:58"/><verse number="59" style="v" sid="1KI 8:59"/>अऊ मोर ये बातमन, जेला मेंह यहोवा के आघू म पराथना के रूप म रखे हवंव, रात अऊ दिन यहोवा हमर परमेसर के लकठा म रहंय, ताकि हर एक दिन के जरूरत के मुताबिक, ओह अपन सेवक अऊ अपन इसरायली मनखेमन के मांग ला पूरा करय, <verse eid="1KI 8:59"/><verse number="60" style="v" sid="1KI 8:60"/>अऊ धरती के जम्मो मनखेमन जानंय कि यहोवा ही परमेसर अय अऊ कोनो दूसर परमेसर नइं ए। <verse eid="1KI 8:60"/><verse number="61" style="v" sid="1KI 8:61"/>अऊ ओकर बिधिमन म चले अऊ ओकर हुकूममन ला माने बर तुम्हर मन ह यहोवा हमर परमेसर कोति पूरा लगे रहय, जइसे कि अभी तुमन करत हव।”<verse eid="1KI 8:61"/></para>
  <para style="s1">मंदिर के समरपन</para>
  <para style="p">
    <verse number="62" style="v" sid="1KI 8:62"/>तब राजा अऊ ओकर संग जम्मो इसरायली मनखेमन यहोवा के आघू म बलिदान चघाईन। <verse eid="1KI 8:62"/><verse number="63" style="v" sid="1KI 8:63"/>सुलेमान ह यहोवा ला मेल-बलिदान चघाईस: बाईस हजार पसु अऊ एक लाख बीस हजार भेड़ अऊ बकरी। ये किसम ले राजा अऊ जम्मो इसरायलीमन यहोवा के मंदिर के समरपन करिन।<verse eid="1KI 8:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="1KI 8:64"/>ओहीच दिन राजा ह यहोवा के मंदिर के आघू के अंगना के मांझा वाले भाग के अभिसेक करिस, अऊ उहां ओह होम-बलिदान, अन्न-बलिदान अऊ मेल-बलिदान के चरबी ला चघाईस, काबरकि जऊन कांसा के बेदी यहोवा के आघू म रिहिस, ओह होम-बलिदान, अन्न-बलिदान अऊ मेल-बलिदान के चरबी ला रखे बर बहुंत छोटे रिहिस।<verse eid="1KI 8:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="1KI 8:65"/>तब ओ बेरा, सुलेमान ह तिहार मनाईस, अऊ ओकर संग जम्मो इसरायलीमन घलो मनाईन—उहां एक बड़े सभा जूरे रिहिस अऊ सभा म लेबो-हमात सहर ले लेके मिसर के नरवा तक के मनखेमन रिहिन। ओमन सात दिन अऊ सात दिन अऊ, याने कि कुल चौदह दिन यहोवा हमर परमेसर के आघू म ये तिहार मनाईन। <verse eid="1KI 8:65"/><verse number="66" style="v" sid="1KI 8:66"/>ओकर दूसर दिन, ओह मनखेमन ला बिदा करिस। मनखेमन राजा ला आसीस दीन अऊ ओ जम्मो बने काम, जऊन ला यहोवा ह अपन सेवक दाऊद अऊ अपन इसरायली मनखेमन बर करे रिहिस, ओकर बर ओमन आनंदित अऊ मगन होके अपन-अपन घर चल दीन।<verse eid="1KI 8:66"/></para>
  <chapter eid="1KI 8"/>
  <chapter number="9" style="c" sid="1KI 9"/>
  <para style="s1">यहोवा ह सुलेमान करा परगट होथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 9:1"/>जब सुलेमान ह यहोवा के मंदिर अऊ राजमहल ला बना चुकिस, अऊ ओकर जऊन कुछू करे के ईछा रिहिस, ओला पूरा कर डारिस, <verse eid="1KI 9:1"/><verse number="2" style="v" sid="1KI 9:2"/>त यहोवा ह जइसे गिबोन सहर म ओकर करा परगट होय रिहिस, वइसे ओह दूसर बार सुलेमान करा परगट होईस। <verse eid="1KI 9:2"/><verse number="3" style="v" sid="1KI 9:3"/>यहोवा ह ओला कहिस:</para>
  <para style="pm" vid="1KI 9:3">“जऊन पराथना अऊ बिनती तेंह मोर आघू म करे हवस, ओला मेंह सुने हवंव; ये मंदिर जऊन ला तेंह बनाय हवस, मेंह अपन नांव उहां सदाकाल बर रखे के दुवारा ओकर अभिसेक करे हंव। मोर आंखी अऊ मोर मन ह हमेसा उहां लगे रहिही।<verse eid="1KI 9:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="1KI 9:4"/>“जहां तक तोर बात ए, यदि तेंह अपन ददा दाऊद के सहीं, मन के सीधई अऊ सच्चई के संग मोर आघू म बिसवासयोग्यता से चलबे, अऊ मोर दिये जम्मो हुकूम ला मानबे अऊ मोर बिधि अऊ कानूनमन के पालन करबे, <verse eid="1KI 9:4"/><verse number="5" style="v" sid="1KI 9:5"/>त मेंह तोर राज सिंघासन ला इसरायल के ऊपर सदाकाल बर स्थिर करहूं, जइसने कि मेंह तोर ददा दाऊद ले वायदा करके ये कहे रहेंव, ‘इसरायल के सिंघासन म बईठे बर, तोर बंस म उत्तराधिकारी के कमी कभू नइं होही’<verse eid="1KI 9:5"/></para>
  <para style="pm">
    <verse number="6" style="v" sid="1KI 9:6"/>“पर यदि तें या तोर संतानमन मोर पाछू चलई छोंड़ देथें अऊ जऊन हुकूम अऊ बिधिमन ला मेंह तोला देय हवंव, ओला नइं मानंय अऊ जाके आने देवतामन के सेवा अऊ ओमन के अराधना करंय, <verse eid="1KI 9:6"/><verse number="7" style="v" sid="1KI 9:7"/>त फेर मेंह इसरायल ला ये देस ले निकाल दूहूं, जेला मेंह ओमन ला देय हवंव, अऊ मेंह ये मंदिर ला अस्वीकार करहूं, जेला मेंह अपन नांव खातिर पबितर करे हवंव। इसरायल ह तब जम्मो झन के बीच म एक कहावत अऊ ठट्ठा के चीज बन जाही। <verse eid="1KI 9:7"/><verse number="8" style="v" sid="1KI 9:8"/>ये मंदिर ह पथरामन के कुढ़हा हो जाही। अऊ ओ जम्मो, जेमन इहां ले होके जाहीं, ओमन अचरज करहीं अऊ हंसी उड़ाके कहिहीं, ‘यहोवा ह ये देस अऊ ये मंदिर ला अइसने काबर करे हवय?’ <verse eid="1KI 9:8"/><verse number="9" style="v" sid="1KI 9:9"/>तब मनखेमन जबाब दीहीं, ‘काबरकि ओमन यहोवा अपन परमेसर ला तियाग दे हवंय, जऊन ह ओमन के पुरखामन ला मिसर देस ले निकालके लानिस। ओमन आने देवतामन ला अपनाके ओमन के अराधना अऊ सेवा करत हवंय—एकरसेति यहोवा ह ये जम्मो बिपत्ति ओमन ऊपर लाने हवय।’ ”<verse eid="1KI 9:9"/></para>
  <para style="s1">सुलेमान के अऊ दूसर काम</para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 9:10"/>बीसवां बछर के आखिर म, ये दौरान सुलेमान ह ये दू ठन भवन बनाईस—यहोवा के मंदिर अऊ राजमहल— <verse eid="1KI 9:10"/><verse number="11" style="v" sid="1KI 9:11"/>राजा सुलेमान ह सूर के राजा हीराम ला गलील म बीस ठन नगर दीस, काबरकि हीराम ह सुलेमान ला ओकर मन के मुताबिक देवदार अऊ सनोवर के लकरी अऊ सोन देय रिहिस। <verse eid="1KI 9:11"/><verse number="12" style="v" sid="1KI 9:12"/>पर जब हीराम ह सूर ले जाके ओ नगरमन ला देखिस, जेमन ला सुलेमान ह ओला देय रिहिस, त ओमन ला देखके हीराम ह खुस नइं होईस। <verse eid="1KI 9:12"/><verse number="13" style="v" sid="1KI 9:13"/>ओह सुलेमान ले पुछिस, “हे मोर भाई, ये का किसम के नगर तेंह मोला देय हवस?” अऊ ओह ओमन के नांव काबूल<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="fq" closed="false">काबूल </char><char style="ft" closed="false">इबरानी के </char><char style="fqa" closed="false">बेकार </char><char style="ft" closed="false">सबद सहीं लगथे</char></note> देस रखिस, अऊ येहीच नांव आज के दिन तक पड़े हवय। <verse eid="1KI 9:13"/><verse number="14" style="v" sid="1KI 9:14"/>फेर हीराम ह राजा करा 120 टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">लगभग साढ़े चार टन</char></note> सोन पठोय रिहिस।<verse eid="1KI 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 9:15"/>राजा सुलेमान ह यहोवा के मंदिर, अपन महल, घरमन के पंक्ति, अऊ यरूसलेम, अऊ हासोर, मगिद्दो अऊ गेजेर नगरमन के दीवार ला बनाय बर जऊन बंधुवा बनिहारमन ला अनिवार्य रूप म रखे रिहिस, ओमन के लेखा ये अय। <verse eid="1KI 9:15"/><verse number="16" style="v" sid="1KI 9:16"/>(मिसर के राजा फिरौन ह गेजेर ऊपर हमला करके ओला कब्जा कर ले रिहिस अऊ ओह ओमा आगी लगा दे रिहिस। ओह ओ नगर म रहइया कनानीमन ला मार डारिस अऊ तब ओह ओला अपन बेटी, सुलेमान के घरवाली ला एक बिहाव भेंट के रूप म दे दीस। <verse eid="1KI 9:16"/><verse number="17" style="v" sid="1KI 9:17"/>अऊ सुलेमान ह गेजेर ला फेर बनाईस।) ओह अपन देस के भीतर खाल्हे के बेत-होरोन, <verse eid="1KI 9:17"/><verse number="18" style="v" sid="1KI 9:18"/>बालात अऊ सुन्ना जगह म तदमोर<note caller="+" style="f"><char style="fr" closed="false">9:18 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">तामार </char><char style="ft" closed="false">घलो कहे जा सकथे</char></note> ला बनाईस, <verse eid="1KI 9:18"/><verse number="19" style="v" sid="1KI 9:19"/>अऊ संग म सुलेमान ह अपन जम्मो भंडारवाले सहर अऊ अपन रथ अऊ अपन घोड़ामन<note caller="+" style="f"><char style="fr" closed="false">9:19 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सारथीमन</char></note> बर नगरमन ला बनाईस—ओह यरूसलेम म, लबानोन म अऊ अपन जम्मो राज म, जऊन कुछू बनाय चाहत रिहिस, ओ जम्मो ला ओह बनाईस।<verse eid="1KI 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 9:20"/>तभो ले अमोरी, हित्ती, परिज्जी, हिब्बी अऊ यबूसीमन के कुछू मनखेमन बांच गे रिहिन (ये मनखेमन इसरायली नइं रिहिन)। <verse eid="1KI 9:20"/><verse number="21" style="v" sid="1KI 9:21"/>देस म बचे ये जम्मो मनखेमन के संतान, जेमन ला इसरायलीमन पूरा नास नइं कर सकिन—ओमन ला सुलेमान ह अनिवार्य रूप से सेवा करे बर बंधुवा बनिहार बना दीस, अऊ आज तक ओमन वइसनेच हवंय। <verse eid="1KI 9:21"/><verse number="22" style="v" sid="1KI 9:22"/>पर सुलेमान ह इसरायलीमन ले कोनो ला गुलाम नइं बनाईस; ओमन ओकर सैनिक, ओकर सरकारी करमचारी, ओकर अधिकारी, ओकर कप्तान, अऊ ओकर रथ अऊ सारथीमन के सेनापति रिहिन। <verse eid="1KI 9:22"/><verse number="23" style="v" sid="1KI 9:23"/>ओमन सुलेमान के काम-योजनामन के मुखिया अधिकारीमन घलो रिहिन; 550 अधिकारी, जऊन मन काम करइयामन के काम ला देखंय।<verse eid="1KI 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 9:24"/>जब फिरौन के बेटी ह दाऊद के सहर ले ओ महल म आ गीस, जेला सुलेमान ह ओकर बर बनाय रिहिस, तब सुलेमान ह घरमन के पंक्ति ला बनाईस।<verse eid="1KI 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 9:25"/>सुलेमान ह जऊन बेदी ला यहोवा बर बनाय रिहिस, ओ बेदी म ओह हर साल तीन बार होम-बलिदान अऊ मेल-बलिदान चघात रिहिस, अऊ बलिदान के संग, ओह यहोवा के आघू म धूप घलो जलाय करत रिहिस, अऊ ये किसम ले, ओह मंदिर बर अपन जबाबदेही ला पूरा करत रिहिस।<verse eid="1KI 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 9:26"/>राजा सुलेमान ह एसियोन-गेबेर नगर म पानी जहाजमन ला घलो बनाईस; एसियोन-गेबेर ह एदोम देस म, लाल-समुंदर के तट म एलात के लकठा म हवय। <verse eid="1KI 9:26"/><verse number="27" style="v" sid="1KI 9:27"/>अऊ हीराम ह अपन ओ मनखेमन ला पठोईस, जऊन मन नाविक रिहिन अऊ समुंदर के जानकार रिहिन—ताकि ओमन सुलेमान के मनखेमन संग जहाजी-बेड़ा म काम करंय। <verse eid="1KI 9:27"/><verse number="28" style="v" sid="1KI 9:28"/>ओमन जहाज म ओपीर गीन अऊ उहां ले वापिस 420 टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">9:28 </char><char style="ft" closed="false">लगभग 16 टन</char></note> सोन लानके राजा सुलेमान ला दे दीन।<verse eid="1KI 9:28"/></para>
  <chapter eid="1KI 9"/>
  <chapter number="10" style="c" sid="1KI 10"/>
  <para style="s1">सेबा के रानी सुलेमान ले भेंट करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 10:1"/>जब सेबा के रानी ह सुलेमान के जस अऊ यहोवा के संग ओकर संबंध के बारे म सुनिस, त ओह सुलेमान ला परखे बर कठिन-कठिन सवाल लेके आईस। <verse eid="1KI 10:1"/><verse number="2" style="v" sid="1KI 10:2"/>ओह एक बड़े दल के संग ऊंटमन म मसाला, बहुंत अकन सोन, अऊ कीमती रत्नमन ला लादके यरूसलेम म हबरिस—ओह सुलेमान मेर आईस अऊ अपन मन म जऊन बात रिहिस, ओ जम्मो के बारे ओकर ले गोठियाईस। <verse eid="1KI 10:2"/><verse number="3" style="v" sid="1KI 10:3"/>सुलेमान ह ओकर जम्मो सवाल के जबाब दीस; कोनो भी बात राजा बर अइसे कठिन नइं रिहिस कि ओह ओला नइं समझा सकय। <verse eid="1KI 10:3"/><verse number="4" style="v" sid="1KI 10:4"/>जब सेबा के रानी ह सुलेमान के जम्मो बुद्धि अऊ ओकर बनाय महल, <verse eid="1KI 10:4"/><verse number="5" style="v" sid="1KI 10:5"/>ओकर मेज के जेवन, ओकर करमचारीमन के बईठना, पोसाक पहिरे सेवकमन के सेवा करई, ओकर पीयानेवालामन, अऊ यहोवा के मंदिर म ओकर दुवारा चघाय गे होम-बलिदान ला देखिस, त ओह चकित हो गीस।<verse eid="1KI 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 10:6"/>ओह राजा ले कहिस, “जऊन बात, मेंह अपन देस म तोर काम अऊ तोर बुद्धि के बारे म सुने रहेंव, ओह सही अय। <verse eid="1KI 10:6"/><verse number="7" style="v" sid="1KI 10:7"/>पर ये बातमन ऊपर मोला बिसवास नइं होईस, जब तक कि मेंह खुद आके अपन आंखी ले नइं देख लेंव। वास्तव म, मोला तो आधा घलो बात नइं बताय गे रिहिस; जऊन बात मेंह सुने रहेंव, ओकर ले कहीं बढ़के तोर करा बुद्धि अऊ संपत्ति हवय। <verse eid="1KI 10:7"/><verse number="8" style="v" sid="1KI 10:8"/>तोर मनखेमन कतेक खुस होहीं! तोर करमचारीमन कतेक खुस होहीं, जऊन मन लगातार तोर आघू म ठाढ़े रहिके तोर बुद्धि के गोठ ला सुनथें! <verse eid="1KI 10:8"/><verse number="9" style="v" sid="1KI 10:9"/>यहोवा तोर परमेसर के परसंसा होवय, जऊन ह तोर ले खुस होके तोला इसरायल के सिंघासन म बईठाय हवय। इसरायल बर यहोवा के अनंत मया के कारन, ओह तोला राजा बनाय हवय, ताकि तेंह नियाय अऊ धरमीपन ला बनाय रख।”<verse eid="1KI 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 10:10"/>अऊ ओह राजा ला 120 टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false">लगभग साढ़े 4 टन</char></note> सोन, अब्बड़ अकन मसाला, अऊ कीमती रत्न दीस। अतेक मसाला फेर कभू नइं आईस, जतेक कि सेबा के रानी ह राजा सुलेमान ला दीस।<verse eid="1KI 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 10:11"/>(हीराम के जहाजमन घलो ओपीर ले सोन लानिन; अऊ उहां ले ओमन जहाज म अब्बड़ अकन चंदन के लकरी अऊ कीमती पथरा घलो लानिन। <verse eid="1KI 10:11"/><verse number="12" style="v" sid="1KI 10:12"/>राजा ह चंदन के लकरी ले यहोवा के मंदिर अऊ राजमहल बर खंभा अऊ संगीतकारमन बर बीना अऊ सारंगी बनवाईस। ओ दिन के बाद, अतेक जादा चंदन के लकरी न तो फेर कभू मंगाय गीस, अऊ न ही देखे गीस।)<verse eid="1KI 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 10:13"/>राजा सुलेमान ह सेबा के रानी ला अपन साही उदारता से देय के अलावा ओह रानी ला ओ सब दीस, जेकर ईछा रानी ह करिस अऊ मांगिस। तब रानी ह अपन सेवकमन के संग अपन देस लहुंट गीस।<verse eid="1KI 10:13"/></para>
  <para style="s1">सुलेमान के सोभा</para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 10:14"/>सुलेमान ला हर साल 666 टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="ft" closed="false">लगभग 25 टन</char></note> सोन मिलत रिहिस, <verse eid="1KI 10:14"/><verse number="15" style="v" sid="1KI 10:15"/>येकर अलावा ओला सौदागर अऊ बेपारीमन ले अऊ अरब देस के जम्मो राजा ले, अऊ अपन राज के राजपालमन ले मालगुजारी घलो मिलत रिहिस।<verse eid="1KI 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 10:16"/>राजा सुलेमान ह गढ़े गय सोन ले दू सौ बड़े ढाल बनवाईस; हर एक ढाल म छै-छै सौ सेकेल<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">लगभग 6.9 किलोग्राम (<char style="xt" link-href="1KI 10:29"><ref loc="1KI 10:29">पद 29</ref></char> म घलो)</char></note> सोन लगिस। <verse eid="1KI 10:16"/><verse number="17" style="v" sid="1KI 10:17"/>ओह गढ़े गय सोन के तीन सौ छोटे ढाल घलो बनाईस; जेमा के हर एक ढाल म तीन-तीन मीना<note caller="+" style="f"><char style="fr" closed="false">10:17 </char><char style="ft" closed="false">लगभग 1.7 किलोग्राम</char></note> सोन लगिस। राजा ह ओमन ला लबानोन के जंगल के महल म रख दीस।<verse eid="1KI 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 10:18"/>तब राजा ह हाथी-दांत ले ढंके एक बड़े सिंघासन बनवाईस, अऊ ओला सुध सोन ले मढ़वाईस। <verse eid="1KI 10:18"/><verse number="19" style="v" sid="1KI 10:19"/>ओ सिंघासन के छै ठन पायदान रिहिस; अऊ सिंघासन के पाछू के भाग के टीप ह गोलाकार रिहिस। आसन के दूनों कोति हांथ रखे के हत्था लगे रहय, अऊ दूनों हत्था के बाजू म एक-एक ठन सेर ठाढ़े स्थिति म बनाय गे रहंय। <verse eid="1KI 10:19"/><verse number="20" style="v" sid="1KI 10:20"/>बारह ठन सेर छै ठन पायदानमन म खड़े रिहिन, हर एक पायदान के दूनों छोर म एक-एक ठन। कोनो आने राज म अइसने सिंघासन कभू नइं बनाय गे रिहिस। <verse eid="1KI 10:20"/><verse number="21" style="v" sid="1KI 10:21"/>राजा सुलेमान के पीये के जम्मो पियालामन सोन के रिहिन, अऊ लबानोन के जंगल के महल म जम्मो बरतन सुध सोन के रिहिन। कुछू भी चीज चांदी के नइं बने रिहिस, काबरकि सुलेमान के समय म, चांदी के जादा कीमत नइं रिहिस। <verse eid="1KI 10:21"/><verse number="22" style="v" sid="1KI 10:22"/>समुंदर म हीराम के जहाजमन के संग, राजा के घलो एक ब्यवसायिक जहाजी-बेड़ा<note caller="+" style="f"><char style="fr" closed="false">10:22 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">तरसीस के जहाजमन</char></note> रिहिस। हर तीन बछर म ये जहाजी-बेड़ा ह एक बार सोन, चांदी अऊ हाथी-दांत ले बने सामान, अऊ बिगर पुंछीवाला बेंदरा अऊ आने किसम के बेंदरामन ला लेके लहुंटय।<verse eid="1KI 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 10:23"/>राजा सुलेमान ह धन अऊ बुद्धि म धरती के आने जम्मो राजामन ले बढ़के रिहिस। <verse eid="1KI 10:23"/><verse number="24" style="v" sid="1KI 10:24"/>जम्मो संसार के मनखेमन सुलेमान के ओ बुद्धि के बात ला सुने के ताक म रहंय, जेला परमेसर ह ओकर मन म डाले रिहिस। <verse eid="1KI 10:24"/><verse number="25" style="v" sid="1KI 10:25"/>हर एक बछर, ओकर करा अवइयामन भेंट लेके आवंय—सोन अऊ चांदी के सामान, ओनहा, हथियार अऊ मसाला, अऊ घोड़ा अऊ खच्चरमन।<verse eid="1KI 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 10:26"/>सुलेमान ह रथ अऊ घोड़ामन ला संकेले रिहिस; ओकर मेर चौदह सौ रथ अऊ बारह हजार घोड़ामन रिहिन, जऊन ला ओह रथ के नगरमन म, अऊ अपन संग यरूसलेम म घलो रखय। <verse eid="1KI 10:26"/><verse number="27" style="v" sid="1KI 10:27"/>राजा ह यरूसलेम म चांदी ला पथरा के असन सधारन, अऊ देवदार लकड़ी ला खाल्हे पहाड़ी के डूमर रूख असन बहुंत अकन कर दीस। <verse eid="1KI 10:27"/><verse number="28" style="v" sid="1KI 10:28"/>सुलेमान के घोड़ामन ला मिसर देस ले अऊ कू<note caller="+" style="f"><char style="fr" closed="false">10:28 </char><char style="ft" closed="false">संभवतः </char><char style="fqa" closed="false">किलिकिया</char></note> ले मंगाय जावत रिहिस—राजा के बेपारीमन ओमन ला ओ समय ठहिराय दाम म कू ले बिसावंय। <verse eid="1KI 10:28"/><verse number="29" style="v" sid="1KI 10:29"/>ओमन मिसर देस ले एक ठन रथ ला चांदी के छै सौ सेकेल, अऊ एक ठन घोड़ा ला चांदी के डेड़ सौ सेकेल म मंगावत रिहिन। राजा के बेपारीमन ओमन ला हित्ती अऊ अरामीमन के जम्मो राजामन ला घलो पठोवत रिहिन।<verse eid="1KI 10:29"/></para>
  <chapter eid="1KI 10"/>
  <chapter number="11" style="c" sid="1KI 11"/>
  <para style="s1">सुलेमान के घरवालीमन</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 11:1"/>फेर राजा सुलेमान ह फिरौन के बेटी के अलावा अऊ कतको परदेसी माईलोगनमन ले मया करिस—जेमा मोआबी, अमोनी, एदोमी, सीदोनी, अऊ हित्ती माईलोगनमन रिहिन। <verse eid="1KI 11:1"/><verse number="2" style="v" sid="1KI 11:2"/>ओमन ओ जाति के रिहिन, जेकर बारे म यहोवा ह इसरायलीमन ला कहे रिहिस, “तुमन ओमन के संग सादी-बिहाव झन करहू, काबरकि ओमन खचित तुम्हर मन ला अपन देवतामन के कोति कर लीहीं।” तभो ले सुलेमान ह ओमन के मया म मगन हो गीस। <verse eid="1KI 11:2"/><verse number="3" style="v" sid="1KI 11:3"/>राज-परिवार म जनमे, ओकर सात सौ घरवाली अऊ तीन सौ रखैल रिहिन, अऊ ओकर घरवालीमन ओकर मन ला परमेसर ले दूरिहा कर दीन। <verse eid="1KI 11:3"/><verse number="4" style="v" sid="1KI 11:4"/>जब सुलेमान के उमर बढ़त गीस, तब ओकर घरवालीमन ओकर मन ला आने देवतामन कोति कर लीन, अऊ जइसने ओकर ददा दाऊद के मन ह पूरा यहोवा ऊपर लगे रिहिस, वइसने ओकर मन ह यहोवा ओकर परमेसर ऊपर पूरा नइं लगे रिहिस। <verse eid="1KI 11:4"/><verse number="5" style="v" sid="1KI 11:5"/>ओह सीदोनीमन के असतोरेत नांव के देवी, अऊ अमोनीमन के मोलेक नांव के घिनित देवता के पाछू चलिस। <verse eid="1KI 11:5"/><verse number="6" style="v" sid="1KI 11:6"/>ये किसम ले सुलेमान ह यहोवा के नजर म खराप काम करिस; ओह अपन ददा दाऊद के सहीं पूरा यहोवा के पाछू नइं चलिस।<verse eid="1KI 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 11:7"/>तब सुलेमान ह यरूसलेम के पूरब दिग के एक पठार म मोआब के घिनित देवता कमोस बर, अऊ अमोनीमन के घिनित देवता मोलेक बर एक ऊंचहा जगह बनाईस। <verse eid="1KI 11:7"/><verse number="8" style="v" sid="1KI 11:8"/>ओह अपन ओ जम्मो परदेसी घरवालीमन बर घलो अइसने करिस, जेमन अपन-अपन देवता बर धूप जलावंय अऊ बलिदान चघावंय।<verse eid="1KI 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 11:9"/>यहोवा ह सुलेमान ऊपर गुस्सा होईस, काबरकि ओकर मन ह ओ यहोवा, इसरायल के परमेसर ले दूरिहा हट गे रिहिस, जऊन ह ओला दू बार दरसन देय रिहिस। <verse eid="1KI 11:9"/><verse number="10" style="v" sid="1KI 11:10"/>हालाकि ओह सुलेमान ला आने देवतामन के पाछू चले बर मना करे रिहिस, तभो ले सुलेमान ह यहोवा के हुकूम ला नइं मानिस। <verse eid="1KI 11:10"/><verse number="11" style="v" sid="1KI 11:11"/>एकरसेति यहोवा ह सुलेमान ला कहिस, “जब तोर अइसने मन हवय, अऊ तेंह मोर ओ करार अऊ बिधिमन ला नइं माने हवस, जेला माने के हुकूम मेंह दे रहेंव, त ये खातिर, मेंह खचित तोर ले राज ला छीनके तोर एक अधिकारी ला दे दूहूं। <verse eid="1KI 11:11"/><verse number="12" style="v" sid="1KI 11:12"/>तभो ले तोर ददा दाऊद के कारन, तोर जिनगी रहत तक, मेंह अइसने नइं करंव; पर तोर बेटा के हांथ ले राज ला छीन लूहूं। <verse eid="1KI 11:12"/><verse number="13" style="v" sid="1KI 11:13"/>मेंह पूरा राज ला तो ओकर हांथ ले नइं छीनंव, पर मोर सेवक दाऊद के कारन, अऊ मोर चुने यरूसलेम के कारन, मेंह तोर बेटा के हांथ म एक गोत्र ला छोंड़ दूहूं।”<verse eid="1KI 11:13"/></para>
  <para style="s1">सुलेमान के बईरीमन</para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 11:14"/>तब यहोवा ह एदोमी हदद ला सुलेमान के एक बईरी बना दीस; हदद ह एदोम के राजबंस के रिहिस। <verse eid="1KI 11:14"/><verse number="15" style="v" sid="1KI 11:15"/>पहिले जब दाऊद ह एदोम के संग लड़ई करत रिहिस, तब सेना के सेनापति योआब ह मरे मनखेमन ला माटी देय बर गे रिहिस, अऊ ओह एदोम म जम्मो मनखेमन ला मार डारिस <verse eid="1KI 11:15"/><verse number="16" style="v" sid="1KI 11:16"/>योआब अऊ जम्मो इसरायलीमन उहां छै महिना रूकिन, जब तक कि ओमन एदोम म जम्मो मनखेमन के नास नइं कर दीन। <verse eid="1KI 11:16"/><verse number="17" style="v" sid="1KI 11:17"/>पर हदद ह ओ समय सिरिप एक छोटे लड़का रिहिस, अऊ ओह कुछू ओ एदोमी करमचारीमन संग मिसर देस भाग गीस, जऊन मन ओकर ददा के सेवा करे रिहिन। <verse eid="1KI 11:17"/><verse number="18" style="v" sid="1KI 11:18"/>ओमन मिदयान ले निकलिन अऊ पारान म आईन। तब पारान ले मनखेमन ला अपन संग लेके, ओमन मिसर म फिरौन राजा करा गीन, जऊन ह हदद ला एक घर अऊ भुइयां दीस अऊ ओला खाना घलो दीस।<verse eid="1KI 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 11:19"/>फिरौन ह हदद ले अतेक खुस होईस कि ओह ओला अपन घरवाली, रानी तहपनेस के एक बहिनी ला बिहाव म दे दीस। <verse eid="1KI 11:19"/><verse number="20" style="v" sid="1KI 11:20"/>तहपनेस के बहिनी ला ओकर कोति ले एक बेटा होईस, जेकर नांव गनूबत रिहिस, जेला तहपनेस ह राजमहल म पालिस-पोसिस। उहां महल म, गनूबत ह फिरौन के लइकामन संग रहत रिहिस।<verse eid="1KI 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 11:21"/>जब हदद ह मिसर म रहत रिहिस, त ओह ये सुनिस कि दाऊद ह अपन पुरखामन के संग सुत गीस अऊ सेना के सेनापति योआब घलो मर गे हवय। तब हदद ह फिरौन ले कहिस, “मोला हुकूम दे कि मेंह अपन देस ला जावंव।”<verse eid="1KI 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 11:22"/>फिरौन ह पुछिस, “तोला इहां का चीज के कमी हवय कि तेंह अपन देस ला जाय चाहथस?”</para>
  <para style="p" vid="1KI 11:22">हदद ह जबाब दीस, “कुछू भी नइं, पर मोला जावन दे!”<verse eid="1KI 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 11:23"/>अऊ परमेसर ह सुलेमान के एक अऊ बईरी कर दीस, याने कि एलयादा के बेटा रजोन ला, जऊन ह अपन मालिक सोबा के राजा हददेजेर करा ले भाग गे रिहिस। <verse eid="1KI 11:23"/><verse number="24" style="v" sid="1KI 11:24"/>जब दाऊद ह सोबा के सेना ला नास कर दीस, त रजोन ह अपन करा मनखेमन के एक दल जमा करिस अऊ ओमन के अगुवा बन गीस; ओमन दमिस्क चल दीन अऊ उहां रहिके अधिकार जमा लीन। <verse eid="1KI 11:24"/><verse number="25" style="v" sid="1KI 11:25"/>हदद ह जऊन समस्या खड़े करे रिहिस, ओकर अलावा रजोन ह सुलेमान के जिनगी भर इसरायल के बईरी बने रिहिस। ये किसम ले रजोन ह अराम म राज करिस अऊ इसरायल के बईरी बने रिहिस।<verse eid="1KI 11:25"/></para>
  <para style="s1">यरोबाम ह सुलेमान के बिरूध बिदरोह करथे</para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 11:26"/>नबात के बेटा, यरोबाम घलो राजा के बिरूध बिदरोह करिस। ओह सरेदा के रहइया एक एपरैमी रिहिस अऊ ओह सुलेमान के एक करमचारी रिहिस, अऊ ओह सरूआह नांव के एक बिधवा के बेटा रिहिस।<verse eid="1KI 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 11:27"/>ओकर राजा के बिरूध बिदरोह करे के, ये कारन रिहिस: सुलेमान ह घरमन के मिल्लो ला बनाय रिहिस अऊ अपन ददा दाऊद के सहर के दीवार के दरार ला बंद कर दे रिहिस। <verse eid="1KI 11:27"/><verse number="28" style="v" sid="1KI 11:28"/>यरोबाम ह एक बहुंत योग्य मनखे रिहिस, अऊ जब सुलेमान ह ओ जवान ला देखिस कि ओह कतेक बने तरीका से काम ला करथे, त ओह ओला यूसुफ के गोत्र के जम्मो काम ऊपर मुखिया ठहिरा दीस।<verse eid="1KI 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 11:29"/>ओही बेरा यरोबाम यरूसलेम ले निकलके जावत रिहिस कि तभे सीलो के अगमजानी, अहियाह एक नवां कपड़ा पहिरे, ओला रसता म मिलिस। ओ दूनों ओ गांव के इलाका म अकेला रिहिन, <verse eid="1KI 11:29"/><verse number="30" style="v" sid="1KI 11:30"/>अऊ अहियाह ह अपन पहिरे नवां कपड़ा ला लीस अऊ ओला चीरके बारह टुकड़ा कर दीस। <verse eid="1KI 11:30"/><verse number="31" style="v" sid="1KI 11:31"/>तब ओह यरोबाम ला कहिस, “दस ठन टुकड़ा ला अपन बर लेय ले, काबरकि यहोवा, इसरायल के परमेसर ह ये कहत हवय, ‘देख, मेंह सुलेमान के हांथ ले राज ला छीनके, दस ठन गोत्र ला तोर हांथ म कर देवत हंव। <verse eid="1KI 11:31"/><verse number="32" style="v" sid="1KI 11:32"/>पर मोर सेवक दाऊद के कारन अऊ यरूसलेम सहर के कारन, जऊन ला मेंह इसरायल के जम्मो गोत्र म ले चुने हवंव, ओकर करा एक गोत्र बने रहिही। <verse eid="1KI 11:32"/><verse number="33" style="v" sid="1KI 11:33"/>मेंह अइसने करहूं काबरकि ओमन मोला तियागके सीदोनीमन के देवी असतोरेत अऊ मोआबीमन के देवता कमोस, अऊ अमोनीमन के देवता मोलेक ला अराधना करत हवंय, अऊ मोर रसता म नइं चलिन, अऊ जऊन ह मोर नजर म सही अय, ओला नइं करिन, अऊ न ही मोर बिधि अऊ कानूनमन ला मानिन, जइसने कि सुलेमान के ददा, दाऊद ह मानिस।<verse eid="1KI 11:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 11:34"/>“ ‘पर मेंह सुलेमान के हांथ ले जम्मो राज ला नइं लेवंव; मोर चुने सेवक दाऊद, जऊन ह मोर हुकूम अऊ बिधिमन ला मानिस, ओकर कारन, मेंह सुलेमान ला ओकर जिनगी भर सासन करइया ठहिराय हंव। <verse eid="1KI 11:34"/><verse number="35" style="v" sid="1KI 11:35"/>मेंह ओकर बेटा के हांथ ले राज ला ले लूहूं अऊ तोला दस गोत्रमन ला दूहूं। <verse eid="1KI 11:35"/><verse number="36" style="v" sid="1KI 11:36"/>ओकर बेटा ला मेंह एक गोत्र दूहूं, ताकि यरूसलेम सहर, जेला मेंह अपन नांव रखे बर चुने हवंव, उहां मोर सेवक दाऊद के एक दीया हमेसा मोर आघू म रहय। <verse eid="1KI 11:36"/><verse number="37" style="v" sid="1KI 11:37"/>पर जहां तक तोर बात ए, तोला मेंह लूहूं, अऊ तेंह अपन पूरा मन के मुताबिक राज करबे; तेंह इसरायल के ऊपर राजा होबे। <verse eid="1KI 11:37"/><verse number="38" style="v" sid="1KI 11:38"/>यदि तेंह मोर सेवक दाऊद के सहीं मोर जम्मो हुकूममन ला मानबे अऊ मोर रसता म चलबे, अऊ मोर बिधि अऊ हुकूममन ला माने के दुवारा, मोर नजर म सही काम करबे, त मेंह तोर संग रहिहूं। जइसने मेंह दाऊद बर ठहरनेवाला एक राज-घराना बनाय हवंव, वइसने तोर बर एक राज-घराना बनाहूं अऊ तोर हांथ म इसरायल ला दे दूहूं। <verse eid="1KI 11:38"/><verse number="39" style="v" sid="1KI 11:39"/>ये पाप के खातिर, मेंह दाऊद के संतानमन ला दुख दूहूं, पर सदाकाल बर नइं।’ ”<verse eid="1KI 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 11:40"/>सुलेमान ह यरोबाम ला मार डारे के कोसिस करिस, पर यरोबाम ह मिसर के राजा सीसक करा भाग गीस, अऊ सुलेमान के मिरतू तक उहां रिहिस।<verse eid="1KI 11:40"/></para>
  <para style="s1">सुलेमान के मऊत</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 11:41"/>सुलेमान के राज के आने घटनामन—जऊन कुछू ओह करिस अऊ ओकर बुद्धि के काम—ओ जम्मो बात सुलेमान के इतिहास के किताब म लिखे गे हवय। <verse eid="1KI 11:41"/><verse number="42" style="v" sid="1KI 11:42"/>सुलेमान ह यरूसलेम म जम्मो इसरायल ऊपर चालीस साल तक राज करिस। <verse eid="1KI 11:42"/><verse number="43" style="v" sid="1KI 11:43"/>तब ओह अपन पुरखामन संग हमेसा बर सुत गीस अऊ ओला ओकर ददा दाऊद के सहर म माटी दिये गीस। अऊ ओकर बेटा, रहूबियाम ह ओकर जगह म राजा बनिस।<verse eid="1KI 11:43"/></para>
  <chapter eid="1KI 11"/>
  <chapter number="12" style="c" sid="1KI 12"/>
  <para style="s1">इसरायल ह रहूबियाम के बिरूध बिदरोह करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 12:1"/>रहूबियाम ह सकेम सहर गीस, काबरकि जम्मो इसरायलीमन ओला राजा बनाय बर उहां गे रिहिन। <verse eid="1KI 12:1"/><verse number="2" style="v" sid="1KI 12:2"/>जब नबात के बेटा यरोबाम ह येला सुनिस (ओह अभी भी मिसर देस म रिहिस, जिहां ओह राजा सुलेमान के डर म भागके गे रिहिस), त ओह मिसर ले लहुंट आईस। <verse eid="1KI 12:2"/><verse number="3" style="v" sid="1KI 12:3"/>अऊ ओमन यरोबाम ला बलाय बर पठोईन, अऊ ओह अऊ इसरायल के जम्मो सभा रहूबियाम मेर गीन अऊ ओकर ले कहिन: <verse eid="1KI 12:3"/><verse number="4" style="v" sid="1KI 12:4"/>“तोर ददा ह हमर ऊपर एक भारी बोझा डाले रिहिस, पर अब तें हमर ऊपर डाले ओकर कठोर काम अऊ भारी बोझा ला हल्का कर, अऊ हमन तोर सेवा करबो।”<verse eid="1KI 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 12:5"/>रहूबियाम ह जबाब दीस, “अभी तो तुमन जावव, अऊ तब तीन दिन के बाद मोर करा लहुंटके आवव।” तब मनखेमन चल दीन।<verse eid="1KI 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 12:6"/>तब राजा रहूबियाम ह ओ अगुवामन ले सलाह लीस, जेमन ओकर ददा सुलेमान के जिनगी भर सेवा करे रिहिन। ओह ओमन ले पुछिस, “तुम्हर का सलाह ए? ये मनखेमन ला का जबाब देना चाही?”<verse eid="1KI 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 12:7"/>ओमन जबाब दीन, “यदि तें आज ये मनखेमन के सेवक बनके येमन के सेवा करबे अऊ अपन जबाब म बने बात कहिबे, त ओमन हमेसा तोर सेवक बने रहिहीं।”<verse eid="1KI 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 12:8"/>पर रहूबियाम ह अगुवामन के सलाह ला नइं मानिस अऊ ओ जवानमन ले सलाह लीस, जेमन ओकर संग बड़े होय रिहिन, अऊ ओकर सेवा करत रिहिन। <verse eid="1KI 12:8"/><verse number="9" style="v" sid="1KI 12:9"/>ओह ओमन ले पुछिस, “तुम्हर का सलाह ए? हमन ला ये मनखेमन ला कइसे जबाब देना चाही, जेमन मोर ले ये कहत हें, ‘जऊन बोझा तोर ददा ह हमर ऊपर डाले हवय, ओला हल्का कर’?”<verse eid="1KI 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 12:10"/>ओकर संग बाढ़े जवान मनखेमन ओला जबाब दीन, “ये मनखेमन तोला कहे हवंय, ‘तोर ददा ह हमर ऊपर भारी बोझा डाले हवय, पर तें हमर बोझा ला हल्का कर।’ अब तें ओमन ला अइसने कह, ‘मोर छोटे अंगरी ह मोर ददा के कनिहां ले मोट हवय। <verse eid="1KI 12:10"/><verse number="11" style="v" sid="1KI 12:11"/>मोर ददा ह तुम्हर ऊपर जऊन भारी बोझा डाले हवय, ओला मेंह अऊ भारी करहूं। मोर ददा ह तो तुमन ला कोर्रा म पीटवाईस, पर मेंह तुमन ला बिच्छूमन ले कटवाहूं।’ ”<verse eid="1KI 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 12:12"/>तीन दिन के बाद, यरोबाम अऊ जम्मो मनखेमन रहूबियाम करा वापिस आईन, जइसे कि राजा ह कहे रिहिस, “तीन दिन म मोर मेर वापिस आवव।” <verse eid="1KI 12:12"/><verse number="13" style="v" sid="1KI 12:13"/>राजा ह मनखेमन ला कठोर मन से जबाब दीस। अगुवामन के सलाह ला नइं मानके, <verse eid="1KI 12:13"/><verse number="14" style="v" sid="1KI 12:14"/>ओह जवानमन के सलाह ला मानिस अऊ कहिस, “मोर ददा ह तुम्हर बोझा ला भारी कर दीस; मेंह येला अऊ भारी करहूं। मोर ददा ह तो तुमन ला कोर्रा म पीटवाईस, पर मेंह तुमन ला बिच्छूमन ले कटवाहूं।” <verse eid="1KI 12:14"/><verse number="15" style="v" sid="1KI 12:15"/>ये किसम ले राजा ह मनखेमन के बात ला नइं सुनिस; काबरकि ये घटना ह यहोवा कोति ले ओ बचन ला पूरा करे बर होईस, जेला यहोवा ह सीलोवासी, अहियाह अगमजानी के दुवारा नबात के बेटा यरोबाम ले कहे रिहिस।<verse eid="1KI 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 12:16"/>जब जम्मो इसरायलीमन देखिन कि राजा ह ओमन के बात ला सुने ले इनकार कर दीस, तब ओमन राजा ला जबाब दीन:</para>
  <para style="q1" vid="1KI 12:16">“दाऊद म हमर का बांटा हवय,</para>
  <para style="q2" vid="1KI 12:16">यिसै के बेटा म हमर का भाग हवय?</para>
  <para style="q1" vid="1KI 12:16">हे इसरायलीमन! अपन-अपन तम्बू म चले जावव,</para>
  <para style="q2" vid="1KI 12:16">हे दाऊद! अपन खुद के घर ला संभाल।”</para>
  <para style="m" vid="1KI 12:16">तब इसरायलीमन अपन-अपन घर चल दीन। <verse eid="1KI 12:16"/><verse number="17" style="v" sid="1KI 12:17"/>पर ओ इसरायली, जेमन यहूदा के नगरमन म रहत रिहिन, ओमन ऊपर रहूबियाम ह राज करते रिहिस।<verse eid="1KI 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 12:18"/>राजा रहूबियाम ह अदोनीराम<note caller="+" style="f"><char style="fr" closed="false">12:18 </char><char style="ft" closed="false">अदोराम (देखव <char style="xt"><ref loc="1KI 4:6">4:6</ref></char> अऊ <char style="xt"><ref loc="1KI 5:14">5:14</ref></char>) ला घलो</char></note> ला भेजिस, जऊन ह बंधुवा मजदूरमन ऊपर मुखिया रिहिस, पर जम्मो इसरायलीमन ओकर ऊपर पथरवाह करके ओला मार डारिन। पर राजा रहूबियाम ह कोनो किसम ले अपन रथ म चघिस अऊ बचके यरूसलेम भाग गीस। <verse eid="1KI 12:18"/><verse number="19" style="v" sid="1KI 12:19"/>ये किसम ले, इसरायलीमन आज तक ले दाऊद के घराना के बिरूध बिदरोह करत हें।<verse eid="1KI 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 12:20"/>जब जम्मो इसरायलीमन ये सुनिन कि यरोबाम ह लहुंटके आ गे हवय, त ओमन ओला सभा म बलाईन अऊ ओला जम्मो इसरायल ऊपर राजा बनाईन। अऊ सिरिप यहूदा के गोत्र ही दाऊद के घराना के संग बने रिहिस।<verse eid="1KI 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 12:21"/>जब रहूबियाम ह यरूसलेम हबरिस, त ओह जम्मो यहूदा अऊ बिनयामीन के गोत्र ले एक लाख अस्सी हजार काबिल जवानमन ला संकेलिस कि ओमन इसरायल के बिरूध लड़े बर जावंय अऊ ओ राज ला सुलेमान के बेटा रहूबियाम के अधीन फेर कर देवंय।<verse eid="1KI 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 12:22"/>पर परमेसर के जन समायाह करा परमेसर के ये बचन आईस: <verse eid="1KI 12:22"/><verse number="23" style="v" sid="1KI 12:23"/>“यहूदा के राजा सुलेमान के बेटा रहूबियाम ले, जम्मो यहूदा अऊ बिनयामीन ले, अऊ बाकि मनखेमन ले कह, <verse eid="1KI 12:23"/><verse number="24" style="v" sid="1KI 12:24"/>‘यहोवा ह ये कहत हे: अपन भाई इसरायलीमन के बिरूध म लड़े बर झन जावव। तुमन जम्मो झन अपन-अपन घर जावव, काबरकि येला मेंह करत हंव।’ ” ओमन यहोवा के बचन के पालन करिन अऊ अपन-अपन घर चल दीन, जइसने कि यहोवा ह ओमन ला हुकूम दे रिहिस।<verse eid="1KI 12:24"/></para>
  <para style="s1">बेतेल अऊ दान म सोन के बछरू</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 12:25"/>तब यरोबाम ह एपरैम के पहाड़ी देस म सकेम नगर ला किलाबंदी करिस अऊ उहां रहे लगिस। फेर उहां ले ओह निकलके गीस अऊ पनिएल नगर ला बनाईस।<verse eid="1KI 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 12:26"/>यरोबाम ह अपन मन म सोचिस, “अब सायद राज ह दाऊद के घराना के फेर हो जाही। <verse eid="1KI 12:26"/><verse number="27" style="v" sid="1KI 12:27"/>यदि ये मनखेमन यरूसलेम म यहोवा के मंदिर म बलिदान चघाय बर जाथें, त ओमन के देसभक्ति ह ओमन के मालिक, यहूदा के राजा रहूबियाम कोति फेर हो जाही, अऊ ओमन मोला मारके राजा रहूबियाम करा फेर लहुंट जाहीं।”<verse eid="1KI 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 12:28"/>एकरसेति, राजा ह सलाह लेके सोन के दू ठन बछवा के मूरती बनाईस अऊ मनखेमन ला कहिस, “यरूसलेम जवई तुम्हर बर बहुंत कठिन अय। एकरसेति, हे इसरायलीमन, येमन तुम्हर देवता अंय, जऊन मन तुमन ला मिसर देस ले निकालके लानिन।” <verse eid="1KI 12:28"/><verse number="29" style="v" sid="1KI 12:29"/>ओह एक ठन बछरू ला बेतेल नगर, अऊ दूसर ला दान नगर म स्थापित करिस। <verse eid="1KI 12:29"/><verse number="30" style="v" sid="1KI 12:30"/>अऊ ये बात ह एक पाप होईस; मनखेमन एक बछरू के अराधना करे बर बेतेल अऊ दूसर बछरू के अराधना करे बर, दान तक घलो जावन लगिन।<verse eid="1KI 12:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 12:31"/>यरोबाम ह ऊंचहा जगहमन म देव-स्थल बनाईस अऊ जम्मो किसम के मनखेमन ले पुरोहित ठहिराईस, हालाकि ओमन लेवी के बंस के नइं रिहिन। <verse eid="1KI 12:31"/><verse number="32" style="v" sid="1KI 12:32"/>जइसने यहूदा म तिहार मनाय जावय, वइसने ओह आठवां महिना के पंदहरवां दिन म एक तिहार मनाय बर ठहिराईस, अऊ बेदी म बलिदान चघाईस। ये काम, ओह बेतेल म, अपन बनाय बछवा के मूरतीमन ला बलिदान चघाके करिस। अऊ बेतेल म, ओह अपन बनाय ऊंचहा जगहमन म पुरोहित घलो ठहिराईस। <verse eid="1KI 12:32"/><verse number="33" style="v" sid="1KI 12:33"/>अपन खुद के चुने आठवां महिना के पंदहरवां दिन म, ओह बेतेल म अपन बनाय बेदी म बलिदान चघाईस। ये किसम ले, ओह इसरायलीमन बर एक तिहार ठहिराईस अऊ बलिदान चघाय बर ऊपर बेदी मेर गीस।<verse eid="1KI 12:33"/></para>
  <chapter eid="1KI 12"/>
  <chapter number="13" style="c" sid="1KI 13"/>
  <para style="s1">यहूदा ले परमेसर के आदमी</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 13:1"/>एक दिन जब यरोबाम ह बेदी मेर एक बलिदान चघाय बर ठाढ़े रिहिस, तब यहोवा के बचन पाके, परमेसर के एक आदमी यहूदा ले बेतेल आईस। <verse eid="1KI 13:1"/><verse number="2" style="v" sid="1KI 13:2"/>ओ मनखे ह यहोवा के बचन पाके, बेदी के बिरूध चिचियाके कहिस: “हे बेदी, हे बेदी! यहोवा ह ये कहिथे: ‘दाऊद के घराना म योसियाह नांव के एक बेटा जनम लीही। तोर ऊपर, ओह ऊंचहा जगहमन के ओ पुरोहितमन ला बलिदान करही, जऊन मन इहां बलिदान करथें, अऊ मनखेमन के हाड़ामन ला तोर ऊपर जलाय जाही।’ ” <verse eid="1KI 13:2"/><verse number="3" style="v" sid="1KI 13:3"/>अऊ ओहीच दिन, परमेसर के ओ मनखे ह ये कहिके एक चिनहां दीस: “येह ओ चिनहां ए, जेला यहोवा ह दे हवय: बेदी ह फटके दू भाग हो जाही अऊ येकर ऊपर के राख ला गिराय जाही।”<verse eid="1KI 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 13:4"/>जब राजा यरोबाम ह सुनिस कि परमेसर के मनखे ह बेतेल म बेदी के बिरूध चिचियाके का कहे हवय, त ओह बेदी ले अपन हांथ बढ़ाके कहिस, “ओला धर लेवव!” पर जऊन हांथ ला ओह ओ मनखे कोति बढ़ाय रिहिस, ओ हांथ ह सूख गीस अऊ ओह ओला वापिस खींच नइं सकिस। <verse eid="1KI 13:4"/><verse number="5" style="v" sid="1KI 13:5"/>अऊ बेदी ह फट गीस, अऊ ओकर राख ह गिर गीस; ये किसम ले ओ चिनहां ह पूरा होईस, जऊन ला परमेसर के मनखे ह यहोवा के बचन ला पाके कहे रिहिस।<verse eid="1KI 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 13:6"/>तब राजा ह परमेसर के मनखे ले कहिस, “यहोवा अपन परमेसर ला मना अऊ मोर बर पराथना कर कि मोर हांथ ह पहिले के सहीं हो जावय!” तब परमेसर के मनखे ह यहोवा ला मनाईस अऊ राजा के हांथ ह ठीक पहिले के सहीं हो गीस।<verse eid="1KI 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 13:7"/>राजा ह परमेसर के मनखे ला कहिस, “में चाहत हंव कि मोर संग घर चलके जेवन कर, अऊ मेंह तोला ईनाम घलो दूहूं।”<verse eid="1KI 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 13:8"/>पर परमेसर के मनखे ह राजा ला जबाब दीस, “चाहे तें मोला अपन आधा संपत्ति घलो दे, तभो ले मेंह तोर संग नइं जावंव, अऊ न ही इहां रोटी खावंव अऊ पानी पीयंव। <verse eid="1KI 13:8"/><verse number="9" style="v" sid="1KI 13:9"/>काबरकि यहोवा के बचन के दुवारा मोला ये हुकूम मिले हवय: ‘तेंह न तो रोटी खाबे अऊ न ही पानी पीबे अऊ न ही ओ डहार ले लहुंटबे, जेमा ले आय हवस।’ ” <verse eid="1KI 13:9"/><verse number="10" style="v" sid="1KI 13:10"/>एकरसेति ओह आने डहार म गीस अऊ ओ डहार ले नइं लहुंटिस, जेमा ले ओह बेतेल आय रिहिस।<verse eid="1KI 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 13:11"/>बेतेल म एक डोकरा अगमजानी रहत रिहिस, जेकर बेटामन आके ओला ओ जम्मो बात बताईन, जेला परमेसर के ओ मनखे ह ओ दिन बेतेल म करे रिहिस; अऊ जऊन बात परमेसर के मनखे ह राजा ले कहे रिहिस, ओला घलो ओमन अपन ददा ला बताईन। <verse eid="1KI 13:11"/><verse number="12" style="v" sid="1KI 13:12"/>ओमन के ददा ह ओमन ले पुछिस, “ओह कते रसता म गीस?” अऊ ओकर बेटामन ओला देखाईन कि यहूदा ले आय परमेसर के ओ मनखे ह कते रसता म गीस। <verse eid="1KI 13:12"/><verse number="13" style="v" sid="1KI 13:13"/>तब ओह अपन बेटामन ले कहिस, “मोर बर गदहा म काठी बांधव।” अऊ जब ओमन गदहा म काठी बांध लीन, त ओह ओमा चघिस <verse eid="1KI 13:13"/><verse number="14" style="v" sid="1KI 13:14"/>अऊ परमेसर के मनखे के पाछू गीस। ओह परमेसर के मनखे ला एक बलूत रूख के खाल्हे बईठे पाईस अऊ ओकर ले पुछिस, “का तेंह परमेसर के ओ मनखे अस, जऊन ह यहूदा ले आय रिहिस?”</para>
  <para style="p" vid="1KI 13:14">ओह कहिस, “हव, मेंह अंव।”<verse eid="1KI 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 13:15"/>तब ओ अगमजानी ह ओकर ले कहिस, “मोर संग चलके मोर घर म जेवन कर।”<verse eid="1KI 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 13:16"/>परमेसर के मनखे ह कहिस, “मेंह लहुंटके तोर संग नइं जा सकंव, अऊ न ही मेंह ये जगह म तोर संग रोटी खा सकंव या पानी पी सकंव। <verse eid="1KI 13:16"/><verse number="17" style="v" sid="1KI 13:17"/>यहोवा के बचन के दुवारा मोला ये बताय गे हवय: ‘उहां तेंह न तो रोटी खाबे, न ही पानी पीबे अऊ न ही ओ रसता ले लहुंटबे, जऊन रसता ले तेंह आबे।’ ”<verse eid="1KI 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 13:18"/>ओ डोकरा अगमजानी ह जबाब दीस, “तोर सहीं मेंह घलो एक अगमजानी अंव। अऊ एक स्वरगदूत ह यहोवा के बचन के दुवारा मोला कहिस, ‘ओला अपन संग अपन घर वापिस ले आ ताकि ओह रोटी खावय अऊ पानी पीयय।’ ” (पर ओह ओकर ले लबारी मारत रिहिस।) <verse eid="1KI 13:18"/><verse number="19" style="v" sid="1KI 13:19"/>एकरसेति परमेसर के मनखे ह ओ डोकरा के संग लहुंट गीस अऊ ओकर घर म खाईस अऊ पीईस।<verse eid="1KI 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 13:20"/>जब ओमन खाना खाय के मेज म बईठे ही रिहिन, त यहोवा के बचन ओ डोकरा अगमजानी मेर आईस, जऊन ह ओला लहुंटाके लाने रिहिस। <verse eid="1KI 13:20"/><verse number="21" style="v" sid="1KI 13:21"/>ओह यहूदा ले आय परमेसर के ओ मनखे ला चिचियाके ये कहिस, “यहोवा ह ये कहत हे: ‘तेंह यहोवा के बचन ला धियान नइं दे हस अऊ जऊन हुकूम यहोवा तोर परमेसर ह तोला देय रिहिस, ओला नइं माने हस। <verse eid="1KI 13:21"/><verse number="22" style="v" sid="1KI 13:22"/>तेंह ओ जगह म वापिस आके रोटी खाय अऊ पानी पीये हस, जिहां परमेसर ह तोला खाय अऊ पीये बर मना करे रिहिस। एकरसेति तोला तोर पुरखामन के मरघटी म माटी नइं दिये जाही।’ ”<verse eid="1KI 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 13:23"/>जब परमेसर के मनखे ह खा-पी चुकिस, त जऊन अगमजानी ह ओला वापिस लाने रिहिस, ओह ओकर बर ओकर गदहा म काठी बांधिस। <verse eid="1KI 13:23"/><verse number="24" style="v" sid="1KI 13:24"/>जब परमेसर के मनखे ह जावत रिहिस, त रसता म ओला एक सेर मिलिस अऊ सेर ह ओला मार डारिस, अऊ ओकर लास ह रसता म पड़े रहय, अऊ गदहा अऊ सेर ओ लास के बाजू म ठाढ़े रहंय। <verse eid="1KI 13:24"/><verse number="25" style="v" sid="1KI 13:25"/>कुछू मनखेमन ओती ले होवत जावत रिहिन, त ओमन देखिन कि लास ह उहां पड़े हवय, अऊ सेर ह लास के बाजू म ठाढ़े हवय, तब ओमन ओ सहर म जाके बताईन, जिहां ओ डोकरा अगमजानी रहत रिहिस।<verse eid="1KI 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 13:26"/>जब ओ अगमजानी, जऊन ह ओला रसता ले लहुंटाके लाने रिहिस, ये बात ला सुनिस, त ओह कहिस, “येह परमेसर के ओ मनखे अय, जऊन ह यहोवा के बचन ला धियान नइं दीस। एकरसेति यहोवा ह ओला सेर के हवाले कर दीस; अऊ सेर ह ओला चीरके मार डारिस, जइसने कि यहोवा के बचन ह ओला चेतउनी दे रिहिस।”<verse eid="1KI 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 13:27"/>तब ओ अगमजानी ह अपन बेटामन ले कहिस, “मोर बर गदहा म काठी बांधव,” अऊ ओमन काठी बांधिन। <verse eid="1KI 13:27"/><verse number="28" style="v" sid="1KI 13:28"/>तब ओह बाहिर गीस अऊ देखिस कि लास ह रसता म पड़े रहय, अऊ गदहा अऊ सेर ओ लास के बाजू म ठाढ़े रहंय। सेर ह न तो लास ला खाय रिहिस अऊ न ही गदहा ला फाड़े रिहिस। <verse eid="1KI 13:28"/><verse number="29" style="v" sid="1KI 13:29"/>तब ओ सियान अगमजानी ह परमेसर के मनखे के लास ला उठाके गदहा के ऊपर रखिस, अऊ ओकर बर सोक मनाय बर अऊ ओला माटी देय बर अपन सहर म ले आईस। <verse eid="1KI 13:29"/><verse number="30" style="v" sid="1KI 13:30"/>तब ओह ओ लास ला अपन खुद के कबर म रखिस, अऊ ओमन ओकर बर सोक मनाईन अऊ कहिन, “हाय, मोर भाई!”<verse eid="1KI 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 13:31"/>ओला माटी देय के बाद, ओ अगमजानी ह अपन बेटामन ले कहिस, “जब में मर जाहूं, त मोला ओ कबर म माटी देवव, जेमा परमेसर के ओ मनखे ला माटी देय गे हवय; मोर हाड़ामन ला ओकर हाड़ामन के बाजू म रखव। <verse eid="1KI 13:31"/><verse number="32" style="v" sid="1KI 13:32"/>काबरकि जऊन संदेस, ओह यहोवा के बचन के दुवारा बेतेल के बेदी के बिरूध अऊ सामरिया के नगरमन के ऊंचहा जगहमन के जम्मो देवालय के बिरूध दे रिहिस, ओह जरूर पूरा होही।”<verse eid="1KI 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 13:33"/>येकर बाद घलो, यरोबाम ह अपन दुस्ट काममन ला नइं छोंड़िस, पर एक बार फेर, ओह जम्मो किसम के मनखेमन ला ऊंचहा जगहमन के पुरोहित ठहिराईस। जऊन कोनो भी पुरोहित बने बर चाहिस, यरोबाम ह ओकर संस्कार ऊंचहा जगहमन बर कर देवत रिहिस। <verse eid="1KI 13:33"/><verse number="34" style="v" sid="1KI 13:34"/>येह यरोबाम के घर के पाप ठहिरिस, अऊ येकरे कारन ओकर पतन होईस अऊ ओह धरती ऊपर ले नास हो गीस।<verse eid="1KI 13:34"/></para>
  <chapter eid="1KI 13"/>
  <chapter number="14" style="c" sid="1KI 14"/>
  <para style="s1">यरोबाम के बिरूध म अहियाह के अगमबानी</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 14:1"/>ओ बेरा म यरोबाम के बेटा अबियाह ह बेमार हो गीस, <verse eid="1KI 14:1"/><verse number="2" style="v" sid="1KI 14:2"/>तब यरोबाम ह अपन घरवाली ला कहिस, “जा अऊ अपन भेस ला अइसने बदल ले कि तोला कोनो यरोबाम के घरवाली के रूप म झन चिन सकंय। तब सीलो सहर ला चले जाबे। उहां अहियाह अगमजानी हवय, जऊन ह मोर ले कहे रिहिस कि मेंह ये मनखेमन के राजा बनहूं। <verse eid="1KI 14:2"/><verse number="3" style="v" sid="1KI 14:3"/>अपन संग दस ठन रोटी, कुछू केक अऊ एक कुप्पी सहद ले, अऊ ओकर मेर जा। ओह तोला बताही कि लड़का के का होही।” <verse eid="1KI 14:3"/><verse number="4" style="v" sid="1KI 14:4"/>जइसने यरोबाम ह कहिस, ओकर घरवाली ह वइसनेच करिस अऊ सीलो म अहियाह के घर गीस।</para>
  <para style="p" vid="1KI 14:4">अहियाह ह देखे नइं सकत रिहिस; ओकर उमर होय के कारन, ओकर नजर ह कमजोर हो गे रिहिस। <verse eid="1KI 14:4"/><verse number="5" style="v" sid="1KI 14:5"/>पर यहोवा ह अहियाह ला ये बता दे रिहिस, “यरोबाम के घरवाली अपन बेटा के बारे म पुछे बर तोर करा आवत हे, काबरकि ओह बेमार हवय, अऊ तेंह ओकर ले ये-ये बात कहिबे। जब इहां आही, त ओह अइसने देखाही, जइसने ओह कोनो अऊ अय।”<verse eid="1KI 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 14:6"/>एकरसेति जब अहियाह ह कपाट करा आवत ओकर गोड़ के अवाज ला सुनिस, त ओह कहिस, “हे यरोबाम के घरवाली, भीतर आ। तेंह काबर ये भेस बदले हस? तोला बताय बर, मोला खराप संदेस मिले हवय। <verse eid="1KI 14:6"/><verse number="7" style="v" sid="1KI 14:7"/>जा अऊ यरोबाम ला बता कि यहोवा, इसरायल के परमेसर ह ये कहिथे: ‘मेंह तोला मनखेमन के बीच ले उठांय अऊ अपन मनखे इसरायलीमन ऊपर सासन करइया ठहिरांय। <verse eid="1KI 14:7"/><verse number="8" style="v" sid="1KI 14:8"/>मेंह दाऊद के घराना ले राज ला छीनके तोला दे देंव, पर तेंह मोर सेवक दाऊद के सहीं नइं ठहिरय, जऊन ह मोर हुकूममन ला मानिस अऊ अपन पूरा मन से मोर पाछू चलिस, अऊ सिरिप ओही काम करिस, जऊन ह मोर नजर म सही अय। <verse eid="1KI 14:8"/><verse number="9" style="v" sid="1KI 14:9"/>तेंह ओ जम्मो ले जादा दुस्ट काम करे हवस, जऊन मन तोर ले पहिले रिहिन। तेंह अपन बर धातु के आने देवता अऊ मूरतीमन ला बना ले हस; तेंह मोर गुस्सा ला भड़काय हस अऊ मोर कोति ले अपन मुहूं फेर ले हस।<verse eid="1KI 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 14:10"/>“ ‘येकरे कारन, मेंह यरोबाम के घराना ऊपर बिपत्ति लानहूं। मेंह इसरायल म यरोबाम के हर एक आदमी ला नास कर दूहूं—चाहे गुलाम होवय या सुतंतर। मेंह यरोबाम के घराना ला अइसने जला दूहूं, जइसने कोनो गोबर ला पूरा खतम होवत तक जलाथे। <verse eid="1KI 14:10"/><verse number="11" style="v" sid="1KI 14:11"/>यरोबाम के घराना के जऊन मन सहर म मरहीं, ओमन ला कुकुरमन खाहीं, अऊ जऊन मन मैदान म मरहीं, ओमन ला चिरईमन खा जाहीं। काबरकि यहोवा ह ये कहे हवय!’<verse eid="1KI 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 14:12"/>“जहां तक तोर बात ए, तेंह घर वापिस जा। जब तें अपन सहर के भीतर गोड़ रखबे, त ओ छोकरा ह मर जाही। <verse eid="1KI 14:12"/><verse number="13" style="v" sid="1KI 14:13"/>जम्मो इसरायलीमन ओकर बर सोक मनाहीं अऊ ओला माटी दीहीं। ओह यरोबाम के घराना के सिरिप एके झन होही, जऊन ला माटी दिये जाही, काबरकि यरोबाम के घराना म सिरिप ओहीच ह एके झन हवय, जऊन म यहोवा, इसरायल के परमेसर ह कुछू बने चीज पाय हवय।<verse eid="1KI 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 14:14"/>“यहोवा ह इसरायल ऊपर अपन बर एक अइसने राजा ठाढ़ करही, जऊन ह यरोबाम के परिवार ला नास कर दीही। अऊ अब येकर सुरूआत घलो हो चुके हवय। <verse eid="1KI 14:14"/><verse number="15" style="v" sid="1KI 14:15"/>अऊ यहोवा इसरायल ला अइसने मारही, जइसने पानी म नरकट के पऊधा हलाय जाथे। ओह इसरायल ला ये बने भुइयां ले उखान दीही, जेला ओह ओमन के पुरखामन ला देय रिहिस अऊ ओमन ला फरात नदी के ओ पार तितिर-बितिर कर दीही, काबरकि ओमन असेरा देवी के खंभा बनाके यहोवा के गुस्सा ला भड़काय हवंय। <verse eid="1KI 14:15"/><verse number="16" style="v" sid="1KI 14:16"/>अऊ ओ पाप, जऊन ला यरोबाम ह करिस अऊ इसरायल ले करवाईस, ओकर कारन यहोवा इसरायल ला तियाग दीही।”<verse eid="1KI 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 14:17"/>तब यरोबाम के घरवाली ह उठिस अऊ उहां ले तिरसा सहर चल दीस। जइसने ही ओह घर के कपाट म गोड़ रखिस, ओ छोकरा ह मर गीस। <verse eid="1KI 14:17"/><verse number="18" style="v" sid="1KI 14:18"/>ओमन ओला माटी दीन, अऊ जम्मो इसरायल ओकर बर सोक मनाईस, जइसने कि यहोवा ह अपन सेवक अहियाह अगमजानी के जरिये कहे रिहिस।<verse eid="1KI 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 14:19"/>यरोबाम के सासन के आने घटना, ओकर लड़ई अऊ ओह कइसने सासन करिस—ये जम्मो बात इसरायल के राजामन के इतिहास के किताब म लिखाय हवय। <verse eid="1KI 14:19"/><verse number="20" style="v" sid="1KI 14:20"/>यरोबाम ह बाईस साल तक राज करिस अऊ तब अपन पुरखामन संग हमेसा बर सुत गीस अऊ नादाब नांव के ओकर बेटा ह ओकर जगह म राजा होईस।<verse eid="1KI 14:20"/></para>
  <para style="s1">यहूदा के राजा रहूबियाम</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 14:21"/>सुलेमान के बेटा, रहूबियाम ह यहूदा के राजा रिहिस। ओह इकतालीस बछर के रिहिस, जब ओह राजा बनिस, अऊ ओह यरूसलेम सहर म सतरह साल ले राज करिस, ओ सहर जेला यहोवा ह इसरायल के जम्मो गोत्र म ले अपन नांव रखे बर चुने रिहिस। ओकर दाई के नांव नामा रिहिस; ओह एक अमोनी माईलोगन रिहिस।<verse eid="1KI 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 14:22"/>यहूदीमन यहोवा के नजर म दुस्ट काम करिन। अपन पुरखामन ले घलो जादा पाप करके ओमन परमेसर के जलन रखइया कोरोध ला अऊ भड़काईन। <verse eid="1KI 14:22"/><verse number="23" style="v" sid="1KI 14:23"/>ओमन जम्मो ऊंचहा पठार अऊ छइहां देवइया रूखमन के खाल्हे म, अपन बर ऊंचहा जगह, पबितर पथरा अऊ असेरा के खंभा बना लीन। <verse eid="1KI 14:23"/><verse number="24" style="v" sid="1KI 14:24"/>अऊ त अऊ उहां देस म पुरूस बेस्यामन घलो देवालय म रिहिन; मनखेमन ओ जातिमन के जम्मो घिनौना काम करत रिहिन, जेमन ला यहोवा ह इसरायलीमन के आघू ले निकाल देय रिहिस।<verse eid="1KI 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 14:25"/>राजा रहूबियाम के राज के पांचवां साल म, मिसर के राजा सीसक ह यरूसलेम ऊपर हमला करिस, <verse eid="1KI 14:25"/><verse number="26" style="v" sid="1KI 14:26"/>अऊ ओह यहोवा के मंदिर के खजाना अऊ राजमहल के खजाना ला उठाके ले गीस। ओह सबो चीज ला ले गीस, जेमा सुलेमान के बनाय सोन के जम्मो ढालमन घलो रिहिन। <verse eid="1KI 14:26"/><verse number="27" style="v" sid="1KI 14:27"/>एकरसेति राजा रहूबियाम ह ओमन के बदला म कांसा के ढालमन ला बनवाईस अऊ ये ढालमन ला पहरेदारमन के ओ सेनापतिमन ला सऊंप दीस, जेमन राजमहल के प्रवेस दुवार म पहरेदारी करत रिहिन। <verse eid="1KI 14:27"/><verse number="28" style="v" sid="1KI 14:28"/>जब भी राजा ह यहोवा के मंदिर म जावय, तब पहरेदारमन ढालमन ला धरके चलंय, अऊ ओकर बाद ओमन ओ ढालमन ला पहरेदारमन के कमरा म लहुंटा देवंय।<verse eid="1KI 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 14:29"/>रहूबियाम के सासन के आने घटना, अऊ जऊन कुछू ओह करिस, ओ जम्मो बात यहूदा के राजामन के इतिहास के किताब म लिखाय हवय? <verse eid="1KI 14:29"/><verse number="30" style="v" sid="1KI 14:30"/>रहूबियाम अऊ यरोबाम के बीच म हमेसा लड़ई होवत रिहिस। <verse eid="1KI 14:30"/><verse number="31" style="v" sid="1KI 14:31"/>अऊ रहूबियाम ह अपन पुरखामन संग हमेसा बर सुत गीस अऊ ओला ओमन के संग दाऊद के सहर म माटी देय गीस। ओकर दाई के नांव नामा रिहिस, जऊन ह एक अमोनी माईलोगन रिहिस। अऊ ओकर बेटा अबियाह<note caller="+" style="f"><char style="fr" closed="false">14:31 </char><char style="ft" closed="false">जादा इबरानी हस्तलिपि म (देखव <char style="xt"><ref loc="2CH 12:16">2 इति 12:16</ref></char>) </char><char style="fqa" closed="false">अबियाम</char></note> ओकर जगह म राजा बनिस।<verse eid="1KI 14:31"/></para>
  <chapter eid="1KI 14"/>
  <chapter number="15" style="c" sid="1KI 15"/>
  <para style="s1">यहूदा के राजा अबियाह</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 15:1"/>नबात के बेटा, यरोबाम के राज के अठारहवां साल म अबियाह ह यहूदा के राजा बनिस, <verse eid="1KI 15:1"/><verse number="2" style="v" sid="1KI 15:2"/>अऊ ओह तीन साल तक यरूसलेम म राज करिस। ओकर दाई के नांव माका रिहिस, जऊन ह अबसालोम के बेटी रिहिस।<verse eid="1KI 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 15:3"/>ओह ओ जम्मो पाप करिस, जऊन ला ओकर ददा ह ओकर पहिले करे रिहिस; ओकर मन ह यहोवा अपन परमेसर कोति अपन पुरखा दाऊद के सहीं पूरा नइं लगे रिहिस। <verse eid="1KI 15:3"/><verse number="4" style="v" sid="1KI 15:4"/>तभो ले दाऊद के खातिर, यहोवा ओकर परमेसर ह यरूसलेम म ओला एक दीया दीस, याने कि ओकर बेटा ला ओकर बाद राजा ठहिराईस अऊ यरूसलेम ला मजबूत करिस। <verse eid="1KI 15:4"/><verse number="5" style="v" sid="1KI 15:5"/>काबरकि दाऊद ह ओ जम्मो काम करिस, जऊन ह यहोवा के नजर म सही रिहिस अऊ सिरिप हित्ती उरियाह के मामला ला छोंड़के, ओह अपन जिनगी भर यहोवा के कोनो हुकूम ला नइं टोरिस।<verse eid="1KI 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 15:6"/>अबियाह<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">जादा इबरानी हस्तलिपि म </char><char style="fqa" closed="false">रहूबियाम</char></note> के जिनगी भर, ओकर अऊ यरोबाम के बीच लड़ई चलते रिहिस। <verse eid="1KI 15:6"/><verse number="7" style="v" sid="1KI 15:7"/>अबियाह के सासन के आने घटनामन अऊ जऊन कुछू ओह करिस, ओ जम्मो काम यहूदा के राजामन के इतिहास के किताब म लिखाय हवय। अऊ अबियाह अऊ यरोबाम के बीच लड़ई होते रिहिस। <verse eid="1KI 15:7"/><verse number="8" style="v" sid="1KI 15:8"/>अऊ अबियाह ह अपन पुरखामन संग हमेसा बर सुत गीस अऊ ओला दाऊद के सहर म माटी देय गीस। अऊ ओकर बेटा आसा ह ओकर जगह म राजा बनिस।<verse eid="1KI 15:8"/></para>
  <para style="s1">यहूदा के राजा आसा</para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 15:9"/>इसरायल के राजा यरोबाम के राज के बीसवां साल म, आसा ह यहूदा के राजा बनिस, <verse eid="1KI 15:9"/><verse number="10" style="v" sid="1KI 15:10"/>अऊ ओह यरूसलेम म इकतालीस साल तक राज करिस। ओकर दादी के नांव माका रिहिस, जऊन ह अबसालोम के बेटी रिहिस।<verse eid="1KI 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 15:11"/>आसा ह अपन पुरखा दाऊद के सहीं ओ काम करिस, जऊन ह यहोवा के नजर म सही रिहिस। <verse eid="1KI 15:11"/><verse number="12" style="v" sid="1KI 15:12"/>ओह देवालय के पुरूस बेस्यामन ला देस ले निकाल दीस अऊ जतेक मूरती ओकर पुरखामन बनाय रिहिन, ओ जम्मो ला ओह हटा दीस। <verse eid="1KI 15:12"/><verse number="13" style="v" sid="1KI 15:13"/>अऊ त अऊ ओह अपन दादी माका ला राज-माता के पद ले हटा दीस, काबरकि माका ह असेरा के अराधना करे बर एक घिनौना मूरती बनाय रिहिस। आसा ह ओला काट डारिस अऊ ओला किदरोन घाटी म जला दीस। <verse eid="1KI 15:13"/><verse number="14" style="v" sid="1KI 15:14"/>हालाकि आसा ह ऊंचहा जगहमन ला नइं हटाईस, तभो ले ओकर मन ह पूरा जिनगी भर यहोवा बर समरपित रिहिस। <verse eid="1KI 15:14"/><verse number="15" style="v" sid="1KI 15:15"/>जऊन सोन, चांदी अऊ सामानमन ला, ओ अऊ ओकर ददा अरपन करे रिहिन, ओ जम्मो ला ओह यहोवा के मंदिर म ले आईस।<verse eid="1KI 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 15:16"/>आसा अऊ इसरायल के राजा बासा के बीच ओमन के सासन करत तक लड़ई होते रिहिस। <verse eid="1KI 15:16"/><verse number="17" style="v" sid="1KI 15:17"/>इसरायल के राजा बासा ह यहूदा के बिरूध गीस अऊ रामा नगर के किलाबंदी करिस, ताकि यहूदा के राजा आसा के इलाका ले न तो कोनो निकल सकंय अऊ न ही कोनो ओकर राज म जा सकंय।<verse eid="1KI 15:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 15:18"/>तब आसा ह जम्मो सोन अऊ चांदी ला लीस, जऊन ह यहोवा के मंदिर अऊ ओकर महल के खजानामन म बांचे रिहिस, अऊ ओला अपन करमचारीमन के हांथ म सऊंप दीस अऊ ओमन ला अराम के राजा बेन-हदद करा पठोईस, जऊन ह हेज्योन के पोता अऊ तबरिम्मोन के बेटा रिहिस अऊ दमिस्क सहर म सासन करत रिहिस। <verse eid="1KI 15:18"/><verse number="19" style="v" sid="1KI 15:19"/>ओह कहिस, “जइसने मोर ददा अऊ तोर ददा के बीच म करार होय रिहिस, वइसनेच मोर अऊ तोर बीच म घलो करार होवय। देख, मेंह तोर मेर सोन अऊ चांदी के भेंट पठोवत हंव। एकरसेति तें इसरायल के राजा बासा के संग अपन करार ला टोर दे, ताकि ओह मोर करा ले पाछू हट जाय।”<verse eid="1KI 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 15:20"/>बेन-हदद ह राजा आसा के बात ला मान लीस अऊ अपन सेना के सेनापतिमन ला इसरायल के नगरमन के बिरूध भेजिस। ओह इयोन, दान, आबेल-बेत-माका अऊ नपताली ला मिलाके जम्मो किन्नेरेत ला जीत लीस। <verse eid="1KI 15:20"/><verse number="21" style="v" sid="1KI 15:21"/>जब बासा ह ये बात ला सुनिस, त ओह रामा सहर ला बनाय के काम ला रोक दीस अऊ तिरसा सहर चले गीस। <verse eid="1KI 15:21"/><verse number="22" style="v" sid="1KI 15:22"/>तब राजा आसा ह जम्मो यहूदा म ये हुकूम दीस—अऊ कोनो ला ये हुकूम ले छूट नइं रिहिस—अऊ ओमन रामा ले ओ पथरा अऊ इमारती लकड़ीमन ला ले गीन, जेमन के उपयोग बासा ह उहां करत रिहिस। येमन ले राजा आसा ह बिनयामीन के गेबा अऊ संग म मिसपा सहरमन ला घलो बनाईस।<verse eid="1KI 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 15:23"/>आसा के सासन के आने जम्मो घटना, ओकर जम्मो काम, जऊन कुछू ओह करिस अऊ जऊन सहरमन ला ओह बनाईस, ये जम्मो बात यहूदा के राजामन के इतिहास के किताब म लिखाय हवय। पर ओकर डोकरा होय के बाद ओकर गोड़मन म बेमारी हो गीस। <verse eid="1KI 15:23"/><verse number="24" style="v" sid="1KI 15:24"/>तब आसा अपन पुरखामन संग हमेसा बर सुत गीस अऊ ओला ओमन के संग ओकर पुरखा दाऊद के सहर म माटी दिये गीस। अऊ ओकर बेटा यहोसापात ओकर जगह म राजा होईस।<verse eid="1KI 15:24"/></para>
  <para style="s1">इसरायल के राजा नादाब</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 15:25"/>यहूदा के राजा आसा के राज के दूसर साल म यरोबाम के बेटा नादाब ह इसरायल के राजा बनिस, अऊ ओह इसरायल ऊपर दू बछर तक राज करिस। <verse eid="1KI 15:25"/><verse number="26" style="v" sid="1KI 15:26"/>ओह यहोवा के नजर म दुस्ट काम करिस अऊ अपन ददा के रसता म चलत ओहीच पाप करिस, जऊन ला ओकर ददा ह इसरायल ले करवाय रिहिस।<verse eid="1KI 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 15:27"/>जब नादाब अऊ जम्मो इसरायलीमन पलिस्तीमन के एक नगर, गिब्बतोन ला घेरे रिहिन, तब इस्साकार के गोत्र के अहियाह के बेटा, बासा ह नादाब के बिरूध गोस्टी करिस, अऊ ओला गिब्बतोन म मार डारिस। <verse eid="1KI 15:27"/><verse number="28" style="v" sid="1KI 15:28"/>यहूदा के राजा आसा के तीसरा साल म, बासा ह नादाब ला मार डारिस अऊ ओकर जगह म राजा बन गीस।<verse eid="1KI 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 15:29"/>राजा बनते ही, बासा ह यरोबाम के पूरा परिवार ला मार डारिस। ओह यरोबाम के घराना के एको झन ला घलो जीयत नइं छोंड़िस, पर ओ जम्मो झन ला नास कर दीस, अऊ येह यहोवा के ओ बचन के मुताबिक होईस, जऊन ला परमेसर ह अपन सेवक सीलो के अहियाह के जरिये कहे रिहिस। <verse eid="1KI 15:29"/><verse number="30" style="v" sid="1KI 15:30"/>येह एकर खातिर होईस, काबरकि यरोबाम ह पाप करिस अऊ इसरायल ले घलो पाप करवाईस, अऊ अइसने करके, ओह यहोवा, इसरायल के परमेसर के गुस्सा ला भड़काईस।<verse eid="1KI 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 15:31"/>नादाब के सासन के आने घटनामन, अऊ जऊन कुछू ओह करिस, ओ जम्मो बात इसरायल के राजामन के इतिहास के किताब म लिखाय हवय। <verse eid="1KI 15:31"/><verse number="32" style="v" sid="1KI 15:32"/>आसा अऊ इसरायल के राजा बासा के बीच ओमन के सासन करत तक लड़ई होते रिहिस।<verse eid="1KI 15:32"/></para>
  <para style="s1">इसरायल के राजा बासा</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 15:33"/>यहूदा के राजा आसा के राज के तीसरा साल म अहियाह के बेटा बासा ह तिरसा म जम्मो इसरायल ऊपर राजा बनिस, अऊ ओह चौबीस साल तक राज करिस। <verse eid="1KI 15:33"/><verse number="34" style="v" sid="1KI 15:34"/>यरोबाम के रसता म चलत, ओह यहोवा के नजर म दुस्ट काम करिस, अऊ ओहीच पाप करिस, जेला यरोबाम ह इसरायल ले करवाय रिहिस।<verse eid="1KI 15:34"/></para>
  <chapter eid="1KI 15"/>
  <chapter number="16" style="c" sid="1KI 16"/>
  <para style="p">
    <verse number="1" style="v" sid="1KI 16:1"/>तब बासा के बिसय म यहोवा के ये बचन हनानी के बेटा येहू मेर आईस: <verse eid="1KI 16:1"/><verse number="2" style="v" sid="1KI 16:2"/>“मेंह तोला माटी ले उठाके अपन इसरायली मनखेमन ऊपर सासन करइया ठहिरांय, पर तेंह यरोबाम के रसता म चलके मोर इसरायली मनखेमन ले पाप करवाय अऊ ओमन के पाप के दुवारा मोर गुस्सा ला भड़काय। <verse eid="1KI 16:2"/><verse number="3" style="v" sid="1KI 16:3"/>एकरसेति, मेंह बासा अऊ ओकर घराना ला नास कर दूहूं, अऊ मेंह तोर घराना ला नबात के बेटा यरोबाम के सहीं कर दूहूं। <verse eid="1KI 16:3"/><verse number="4" style="v" sid="1KI 16:4"/>बासा के घर के जऊन मन सहर म मरहीं, ओमन ला कुकुरमन खा जाहीं, अऊ ओकर जऊन मनखेमन खुले जगह म मरहीं, ओमन ला चिरईमन खा जाहीं।”<verse eid="1KI 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 16:5"/>बासा के सासन के आने घटनामन, जऊन कुछू ओह करिस अऊ ओकर काम, ये जम्मो बात इसरायल के राजामन के इतिहास के किताब म लिखाय हवय। <verse eid="1KI 16:5"/><verse number="6" style="v" sid="1KI 16:6"/>आखिरी म बासा ह अपन पुरखामन संग हमेसा बर सुत गीस अऊ तिरसा म ओला माटी दिये गीस। अऊ ओकर बेटा एला ओकर जगह म राजा होईस।<verse eid="1KI 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 16:7"/>हनानी के बेटा अगमजानी येहू के जरिये यहोवा के अऊ भी बचन, बासा अऊ ओकर घराना के बिरूध म आईस, काबरकि ओह यहोवा के नजर म बहुंत दुस्ट काम करे रिहिस, अऊ अपन काम के दुवारा ओकर गुस्सा ला भड़काय रिहिस, अऊ ओह यरोबाम के घराना सहीं हो गे रिहिस—अऊ येकर खातिर घलो कि बासा ह यरोबाम के घराना ला नास कर दे रिहिस।<verse eid="1KI 16:7"/></para>
  <para style="s1">इसरायल के राजा एला</para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 16:8"/>यहूदा के राजा आसा के राज के छब्बीसवां साल म, बासा के बेटा एला इसरायल के राजा बनिस, अऊ ओह तिरसा म दू साल तक राज करिस।<verse eid="1KI 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 16:9"/>जिमरी नांव के राजा एला के एक करमचारी, जऊन ह राजा के आधा रथमन के मुखिया रिहिस; ओह राजा के बिरूध गोस्टी करिस। ओतेक बेरा, एला ह तिरसा म महल के परधान अरसा के घर म मंद पीके मतवाला हो गे रहय। <verse eid="1KI 16:9"/><verse number="10" style="v" sid="1KI 16:10"/>तब जिमरी ह भीतर आईस अऊ एला ऊपर वार करके ओला मार डारिस, अऊ ओकर जगह म राजा बन गीस। येह यहूदा के राजा आसा के राज के सत्ताईसवां साल म होईस।<verse eid="1KI 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 16:11"/>ओह राज करे के सुरू करते अऊ सिंघासन म बईठते ही बासा के जम्मो परिवार ला मार डारिस। ओह ओकर परिवार के एको झन पुरूस ला नइं छोंड़िस, अऊ त अऊ ओह ओकर रिस्तेदार अऊ संगीमन के एको पुरूस ला घलो जीयत नइं छोंड़िस। <verse eid="1KI 16:11"/><verse number="12" style="v" sid="1KI 16:12"/>ये किसम ले यहोवा के ओ बचन के मुताबिक, जऊन ला ओह येहू अगमजानी के जरिये बासा के बिरूध कहे रिहिस, जिमरी ह बासा के जम्मो परिवार ला नास कर दीस— <verse eid="1KI 16:12"/><verse number="13" style="v" sid="1KI 16:13"/>काबरकि बासा अऊ ओकर बेटा एला बहुंत पाप करे रिहिन अऊ इसरायल ले घलो करवाय रिहिन अऊ ओमन अपन बेकार के मूरतीमन के दुवारा यहोवा, इसरायल के परमेसर के गुस्सा ला भड़काय रिहिन।<verse eid="1KI 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 16:14"/>एला के सासन के आने घटनामन, अऊ जऊन कुछू ओह करिस, ओ जम्मो बात इसरायल के राजामन के इतिहास के किताब म लिखाय हवय।<verse eid="1KI 16:14"/></para>
  <para style="s1">इसरायल के राजा जिमरी</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 16:15"/>यहूदा के राजा आसा के राज के सत्ताईसवां साल म जिमरी ह तिरसा म सात दिन तक राज करिस। सेना के मनखेमन एक पलिस्ती नगर, गिब्बतोन के लकठा म डेरा डाले रहंय। <verse eid="1KI 16:15"/><verse number="16" style="v" sid="1KI 16:16"/>जब सिविर म इसरायली मनखेमन सुनिन कि जिमरी ह राजा के बिरूध गोस्टी करके ओला मार डारे हवय, त ओहीच दिन ओमन उहां सिविर म सेना के सेनापति ओमरी ला इसरायल के राजा घोसित कर दीन। <verse eid="1KI 16:16"/><verse number="17" style="v" sid="1KI 16:17"/>तब ओमरी अऊ ओकर संग के जम्मो इसरायलीमन गिब्बतोन ले हट गीन अऊ तिरसा ला घेर लीन। <verse eid="1KI 16:17"/><verse number="18" style="v" sid="1KI 16:18"/>जब जिमरी ह देखिस कि सहर ला ले लिये गे हवय, त ओह राजमहल के किला भीतर गीस अऊ महल म अपन चारों कोति आगी लगा लीस, अऊ जरके मर गीस, <verse eid="1KI 16:18"/><verse number="19" style="v" sid="1KI 16:19"/>येह एकरसेति होईस, काबरकि ओह बहुंत पाप करे रिहिस, अऊ यहोवा के नजर म दुस्ट काम करके यरोबाम के रसता म चले रिहिस अऊ यरोबाम के सहीं पाप करके इसरायल ले घलो पाप करवाईस।<verse eid="1KI 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 16:20"/>जिमरी के सासन के आने घटनामन, अऊ जऊन बिदरोह, ओह करिस, ओ जम्मो बातमन इसरायल के राजामन के इतिहास के किताब म लिखाय हवय।<verse eid="1KI 16:20"/></para>
  <para style="s1">इसरायल के राजा ओमरी</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 16:21"/>तब इसरायली मनखेमन दू भाग म बंट गीन; आधा मनखेमन गीनत के बेटा तिबनी ला राजा बनाय बर समरथन करिन, त आधा मनखे ओमरी के समरथन करिन। <verse eid="1KI 16:21"/><verse number="22" style="v" sid="1KI 16:22"/>पर ओमरी के समरथकमन गीनत के बेटा तिबनी के समरथकमन ले जादा ताकतवर रिहिन। एकरसेति तिबनी ह मारे गीस अऊ ओमरी ह राजा बनिस।<verse eid="1KI 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 16:23"/>यहूदा के राजा आसा के राज के इकतीसवां साल म, ओमरी ह इसरायल के राजा बनिस, अऊ ओह बारह साल तक राज करिस, जेमा के छै साल ओकर राज ह तिरसा ऊपर रिहिस। <verse eid="1KI 16:23"/><verse number="24" style="v" sid="1KI 16:24"/>ओह सेमेर ले सामरिया के पहाड़ी ला दू टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">लगभग 68 किलोग्राम</char></note> चांदी म बिसाईस अऊ ओ पहाड़ी ऊपर एक सहर बसाईस; अऊ अपन बसाय ओ सहर के नांव पहाड़ी के पहिले के मालिक सेमेर के नांव म सामरिया रखिस।<verse eid="1KI 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 16:25"/>पर ओमरी ह यहोवा के नजर म दुस्ट काम करिस अऊ ओ जम्मो राजामन ले घलो जादा पाप करिस, जऊन मन ओकर पहिले रिहिन। <verse eid="1KI 16:25"/><verse number="26" style="v" sid="1KI 16:26"/>ओह पूरा नबात के बेटा यरोबाम के रसता म चलिस, अऊ ओहीच पाप करिस, जेला यरोबाम ह इसरायली मनखेमन ले करवाय रिहिस, अऊ ये किसम ले, ओमन अपन बेकार के मूरतीमन के दुवारा यहोवा, इसरायल के परमेसर के गुस्सा ला भड़काईन।<verse eid="1KI 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 16:27"/>ओमरी के सासन के आने घटनामन, जऊन कुछू ओह करिस अऊ ओकर काम, ये जम्मो बात इसरायल के राजामन के इतिहास के किताब म लिखाय हवय। <verse eid="1KI 16:27"/><verse number="28" style="v" sid="1KI 16:28"/>ओमरी ह अपन पुरखामन के संग हमेसा बर सुत गीस अऊ ओला सामरिया म माटी दिये गीस। अऊ ओकर बेटा अहाब ह ओकर जगह म राजा होईस।<verse eid="1KI 16:28"/></para>
  <para style="s1">अहाब ह इसरायल के राजा बनथे</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 16:29"/>यहूदा के राजा आसा के राज के अड़तीसवां साल म ओमरी के बेटा, अहाब ह इसरायल के राजा बनिस, अऊ इसरायल ऊपर सामरिया म बाईस बरस तक राज करिस। <verse eid="1KI 16:29"/><verse number="30" style="v" sid="1KI 16:30"/>ओमरी के बेटा, अहाब ह यहोवा के नजर म ओकर पहिले के जम्मो राजामन ले जादा दुस्ट काम करिस। <verse eid="1KI 16:30"/><verse number="31" style="v" sid="1KI 16:31"/>न सिरिप ओह नबात के बेटा यरोबाम के सहीं पाप करई ला मामूली बात समझिस, पर ओह सीदोनीमन के राजा एतबाल के बेटी, ईजेबेल ले बिहाव घलो कर लीस, अऊ बाल देवता के सेवा सुरू करके ओकर अराधना करिस। <verse eid="1KI 16:31"/><verse number="32" style="v" sid="1KI 16:32"/>ओह बाल के एक मंदिर सामरिया म बनाके, ओमा बाल बर एक बेदी बनाईस। <verse eid="1KI 16:32"/><verse number="33" style="v" sid="1KI 16:33"/>अहाब ह एक असेरा के खंभा घलो बनाईस अऊ अपन पहिले के जम्मो इसरायली राजामन ले अऊ जादा पाप करके यहोवा, इसरायल के परमेसर के गुस्सा ला भड़काईस।<verse eid="1KI 16:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 16:34"/>अहाब के समय म, बेतेल के रहइया हीएल ह यरीहो ला फेर बनाईस; जब ओह ओकर नीव डारिस, त ओकर पहिलांत बेटा अबीराम ह मर गीस, अऊ जब ओह ओकर दुवारमन ला ठाढ़ करिस, त ओकर सबले छोटे बेटा सगूब ह मर गीस, अऊ येह यहोवा के ओ बचन के मुताबिक होईस, जऊन ला ओह नून के बेटा यहोसू के दुवारा कहे रिहिस।<verse eid="1KI 16:34"/></para>
  <chapter eid="1KI 16"/>
  <chapter number="17" style="c" sid="1KI 17"/>
  <para style="s1">अगमजानी एलियाह ह एक बड़े अकाल के घोसना करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 17:1"/>गिलाद म तिसबे नगर के रहइया, एलियाह तिसबी ह राजा अहाब ला कहिस, “ओ यहोवा, इसरायल के परमेसर के कसम, जेकर सेवा मेंह करथंव, अवइया कुछू साल म मोर कहे बिगर, न तो ओस गिरही अऊ न ही पानी बरसही।”<verse eid="1KI 17:1"/></para>
  <para style="s1">एलियाह ला कऊआ चिरईमन के दुवारा जेवन मिलथे</para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 17:2"/>तब यहोवा के ये बचन एलियाह करा आईस: <verse eid="1KI 17:2"/><verse number="3" style="v" sid="1KI 17:3"/>“ये जगह ला छोंड़ अऊ पूरब दिग म जा अऊ करीत नांव के घाटी म छुप जा, जऊन ह यरदन के पूरब म हवय। <verse eid="1KI 17:3"/><verse number="4" style="v" sid="1KI 17:4"/>तें नरवा के पानी ला पीबे, अऊ मेंह कऊआमन ला हुकूम दे हवंव कि ओमन तोर बर उहां जेवन लानहीं।”<verse eid="1KI 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 17:5"/>यहोवा के कहे बचन के मुताबिक ओह करिस। ओह यरदन के पूरब कोति, करीत नांव के घाटी म गीस अऊ उहां रहे लगिस। <verse eid="1KI 17:5"/><verse number="6" style="v" sid="1KI 17:6"/>कऊआमन बिहनियां अऊ सांझ के बेरा ओकर बर रोटी अऊ मांस लानंय, अऊ ओह नरवा के पानी ला पीयय।<verse eid="1KI 17:6"/></para>
  <para style="s1">एलियाह अऊ सारपत के बिधवा</para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 17:7"/>पानी नइं गिरे के कारन, कुछू समय के बाद, नरवा ह सूख गीस। <verse eid="1KI 17:7"/><verse number="8" style="v" sid="1KI 17:8"/>तब यहोवा के ये बचन एलियाह करा आईस: <verse eid="1KI 17:8"/><verse number="9" style="v" sid="1KI 17:9"/>“सीदोन इलाका के सारपत नगर म तुरते जा अऊ उहां रह। मेंह उहां के एक बिधवा ला तोला खवाय बर हुकूम दे हवंव।” <verse eid="1KI 17:9"/><verse number="10" style="v" sid="1KI 17:10"/>एकरसेति ओह सारपत गीस। जब ओह नगर के दुवार मेर आईस, त ओह देखिस कि उहां एक बिधवा ह लकड़ी बीनत रहय। ओह ओला बलाके कहिस, “का तेंह कोनो बरतन म मोर पीये बर थोरकन पानी लानबे?” <verse eid="1KI 17:10"/><verse number="11" style="v" sid="1KI 17:11"/>जब ओह पानी लेय बर जावत रिहिस, त एलियाह ह ओला पुकारके कहिस, “अऊ मोर बर रोटी के एक ठन टुकड़ा घलो लेवत आबे।”<verse eid="1KI 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 17:12"/>ओ बिधवा ह कहिस, “यहोवा तोर परमेसर के जिनगी के कसम, मोर करा कोनो रोटी नइं ए—एक घड़ा म सिरिप मुट्ठी भर पीसान अऊ एक कुप्पी म थोरकन तेल हवय। मेंह कुछू लकड़ी बीनत हंव, ताकि येला घर ले जाके मोर अऊ मोर बेटा बर खाना पकावंव, अऊ हमन ओला खावन अऊ मर जावन।”<verse eid="1KI 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 17:13"/>एलियाह ह ओला कहिस, “झन डर। घर जा अऊ जइसने तेंह अभी कहय, वइसने कर। पर पहिले मोर बर ओ पीसान ले एक ठन छोटे रोटी बनाके मोर करा लान, अऊ ओकर बाद, अपन अऊ अपन बेटा बर कुछू बना। <verse eid="1KI 17:13"/><verse number="14" style="v" sid="1KI 17:14"/>काबरकि यहोवा, इसरायल के परमेसर ये कहत हे: ‘जब तक यहोवा ह भुइयां म पानी नइं बरसाही, तब तक न तो ओ घड़ा के पीसान सिराही, अऊ न ही ओ कुप्पी के तेल घटही।’ ”<verse eid="1KI 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 17:15"/>तब ओह चले गीस, अऊ एलियाह के कहे बचन के मुताबिक करिस। अऊ एलियाह अऊ ओ माईलोगन अऊ ओकर परिवार बर हर दिन जेवन के परबंध होवय। <verse eid="1KI 17:15"/><verse number="16" style="v" sid="1KI 17:16"/>काबरकि न तो घड़ा के पीसान ह सिराईस, अऊ न ही कुप्पी के तेल ह घटिस, जइसने कि यहोवा ह एलियाह के दुवारा कहे रिहिस।<verse eid="1KI 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 17:17"/>कुछू समय के बाद, घर के मालकिन ओ बिधवा के बेटा ह बेमार हो गीस। ओकर बेमारी बढ़ते अऊ बढ़ते गीस, अऊ आखिरी म ओकर सांस लेवई बंद हो गीस। <verse eid="1KI 17:17"/><verse number="18" style="v" sid="1KI 17:18"/>तब ओ माईलोगन ह एलियाह ले कहिस, “हे परमेसर के जन! तोर मन म मोर बिरोध म का हवय? का तेंह मोला मोर पाप के सुरता कराय बर अऊ मोर बेटा ला मारे बर आय हवस?”<verse eid="1KI 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 17:19"/>एलियाह ह ओला जबाब दीस, “अपन बेटा ला मोला दे।” तब ओह माईलोगन के कोरा ले ओकर बेटा ला ले लीस अऊ ओला लेके ऊपर के कमरा म गीस, जिहां ओह खुद रहत रिहिस, अऊ ओला अपन खटिया म लेटा दीस। <verse eid="1KI 17:19"/><verse number="20" style="v" sid="1KI 17:20"/>तब ओह गोहार पारके यहोवा ला कहिस, “हे यहोवा मोर परमेसर! ये बिधवा, जेकर इहां मेंह ठहिरे हंव, ओकर बेटा ला मारके, का तेंह ये बिधवा ऊपर घलो बिपत्ति लाने हस?” <verse eid="1KI 17:20"/><verse number="21" style="v" sid="1KI 17:21"/>तब ओह ओ छोकरा ऊपर तीन बार पसर गीस अऊ यहोवा ला गोहार पारके कहिस, “हे यहोवा मोर परमेसर! ये छोकरा के परान येमा फेर डाल दे।”<verse eid="1KI 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 17:22"/>एलियाह के ये गोहार ला यहोवा ह सुनिस, अऊ ओ छोकरा के परान ओमा फेर आ गीस अऊ ओह जी उठिस। <verse eid="1KI 17:22"/><verse number="23" style="v" sid="1KI 17:23"/>तब एलियाह ओ लइका ला कमरा ले खाल्हे घर म ले गीस, अऊ ओह लइका ला ओकर दाई के हांथ म सऊंपके कहिस, “देख, तोर बेटा ह जीयत हवय!”<verse eid="1KI 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 17:24"/>तब ओ माईलोगन ह एलियाह ले कहिस, “अब मेंह जान गे हंव कि तेंह परमेसर के जन अस अऊ तोर मुहूं ले निकले यहोवा के बचन म सच्चई हवय।”<verse eid="1KI 17:24"/></para>
  <chapter eid="1KI 17"/>
  <chapter number="18" style="c" sid="1KI 18"/>
  <para style="s1">एलियाह अऊ ओबदयाह</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 18:1"/>बहुंत समय के बाद, तीसरा साल म, यहोवा के ये बचन एलियाह करा आईस: “जा अऊ अपनआप ला अहाब ला देखा, अऊ मेंह भुइयां म पानी बरसाहूं।” <verse eid="1KI 18:1"/><verse number="2" style="v" sid="1KI 18:2"/>तब एलियाह अपनआप ला देखाय बर अहाब करा गीस।</para>
  <para style="p" vid="1KI 18:2">ओ बेरा म, सामरिया म भारी अकाल पड़े रहय, <verse eid="1KI 18:2"/><verse number="3" style="v" sid="1KI 18:3"/>अऊ अहाब ह अपन महल के अधिकारी ओबदयाह ला बलाय रहय। (ओबदयाह ह यहोवा के बड़े भक्त रिहिस। <verse eid="1KI 18:3"/><verse number="4" style="v" sid="1KI 18:4"/>जब ईजेबेल ह यहोवा के अगमजानीमन ला नास करत रिहिस, तब ओबदयाह ह एक सौ अगमजानीमन ला लेके ओमन के पचास-पचास दू ठन दल बनाईस अऊ ओमन ला दू ठन खोड़रा म छुपा दे रिहिस, अऊ ओमन बर जेवन अऊ पानी के परबंध घलो करे रिहिस।) <verse eid="1KI 18:4"/><verse number="5" style="v" sid="1KI 18:5"/>अहाब ह ओबदयाह ला कहे रिहिस, “देस के जम्मो सोता अऊ घाटीमन ला जाके देख। सायद हमन ला घोड़ा अऊ खच्चरमन ला बंचाय बर कुछू कांदी मिल जाय अऊ हमन ला हमर कोनो पसु ला मारना झन पड़य।” <verse eid="1KI 18:5"/><verse number="6" style="v" sid="1KI 18:6"/>एकरसेति ओमन देस म जाय बर देस के इलाका ला बांट लीन; अहाब ह एक दिग म गीस, त ओबदयाह ह दूसर दिग म।<verse eid="1KI 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 18:7"/>जब ओबदयाह ह जावत रिहिस, त रसता म ओला एलियाह मिलिस। ओबदयाह ह ओला चिन डारिस अऊ भुइयां म झुकके ओला दंडवत करिस, अऊ कहिस, “हे मोर मालिक, एलियाह, का सही म, ये तें अस?”<verse eid="1KI 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 18:8"/>ओह जबाब दीस, “हव मेंह अंव। जा अऊ अपन मालिक ला बता, ‘एलियाह ह इहां हवय।’ ”<verse eid="1KI 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 18:9"/>ओबदयाह ह कहिस, “मेंह का पाप करे हंव कि तेंह अपन सेवक ला मार डारे बर, अहाब के हांथ म कर देय चाहथस? <verse eid="1KI 18:9"/><verse number="10" style="v" sid="1KI 18:10"/>यहोवा तोर परमेसर के जिनगी के कसम, कोनो अइसन देस या राज नइं ए, जिहां मोर मालिक ह तोला खोजे बर मनखेमन ला नइं पठोय होही। अऊ जब भी कोनो देस या राज के मनखेमन कहंय कि तेंह उहां नइं अस, त मोर मालिक ओमन ले किरिया खवाके कहवाय कि ओमन ला तें नइं मिलय। <verse eid="1KI 18:10"/><verse number="11" style="v" sid="1KI 18:11"/>अऊ तेंह मोला कहत हस कि जाके मेंह अपन मालिक ले कहंव, ‘एलियाह ह इहां हवय।’ <verse eid="1KI 18:11"/><verse number="12" style="v" sid="1KI 18:12"/>अऊ जइसने ही मेंह तोर करा ले चले जाहूं, वइसने ही यहोवा के आतमा तोला न जाने कहां उठाके ले जाही। यदि मेंह जाके अहाब ला बतावंव अऊ ओला तेंह नइं मिलबे, त ओह मोला मार डारही। तभो ले, में तोर सेवक अपन लइकापन ले यहोवा के भय मानत आय हवंव। <verse eid="1KI 18:12"/><verse number="13" style="v" sid="1KI 18:13"/>हे मोर मालिक, का तेंह ये बात नइं सुने हस कि जब ईजेबेल ह यहोवा के अगमजानीमन ला नास करत रिहिस, त मेंह का करेंव? मेंह यहोवा के एक सौ अगमजानीमन ला लेंव अऊ ओमन के पचास-पचास के दू ठन दल करके, ओमन ला दू ठन खोड़रा म छुपा दे रहेंव, अऊ ओमन के जेवन अऊ पानी के परबंध घलो करेंव। <verse eid="1KI 18:13"/><verse number="14" style="v" sid="1KI 18:14"/>अऊ तेंह मोला कहत हस कि जाके मेंह अपन मालिक ले कहंव, ‘एलियाह ह इहां हवय।’ ओह मोला मार डारही!”<verse eid="1KI 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 18:15"/>एलियाह ह कहिस, “सर्वसक्तिमान यहोवा, जेकर सेवा मेंह करथंव, ओकर जिनगी के कसम, आज ही मेंह अपनआप ला अहाब ला देखाहूं।”<verse eid="1KI 18:15"/></para>
  <para style="s1">करमेल पहाड़ म एलियाह</para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 18:16"/>तब ओबदयाह ह अहाब करा गीस अऊ ओला बताईस, अऊ अहाब ह एलियाह ले मिले बर गीस। <verse eid="1KI 18:16"/><verse number="17" style="v" sid="1KI 18:17"/>जब ओह एलियाह ला देखिस, त ओह ओला कहिस, “का तेंह ओ मनखे अस, हे इसरायल बर समस्या खड़े करनेवाला?”<verse eid="1KI 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 18:18"/>एलियाह ह जबाब दीस, “मेंह इसरायल बर समस्या नइं खड़े करे हवंव, पर तें अऊ तोर ददा के परिवार ह समस्या खड़े करे हवय। तेंह यहोवा के हुकूम मानना छोंड़ दे हस अऊ बाल देवतामन के पाछू चलत हस। <verse eid="1KI 18:18"/><verse number="19" style="v" sid="1KI 18:19"/>अब तें जम्मो इसरायल के मनखेमन करा खबर भेज कि ओमन आके मोर ले करमेल पहाड़ ऊपर मिलंय। अऊ बाल के साढ़े चार सौ अगमजानी अऊ असेरा के चार सौ अगमजानीमन ला लेके आ, जऊन मन ईजेबेल के मेज म खाथें।”<verse eid="1KI 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 18:20"/>तब अहाब ह जम्मो इसरायल म खबर पठोईस, अऊ अगमजानीमन ला करमेल पहाड़ म इकट्ठा करिस। <verse eid="1KI 18:20"/><verse number="21" style="v" sid="1KI 18:21"/>एलियाह ह मनखेमन के आघू म आके कहिस, “तुमन कब तक दू ठन बिचार के बीच म डोलत रहिहू? यदि यहोवा ह परमेसर अय, त ओकर पाछू चलव; पर यदि बाल ह परमेसर अय, त ओकर पाछू हो लेवव।”</para>
  <para style="p" vid="1KI 18:21">पर मनखेमन कुछू नइं कहिन।<verse eid="1KI 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 18:22"/>तब एलियाह ह ओमन ला कहिस, “यहोवा के अगमजानीमन ले सिरिप मेंह एके झन बांचे हंव, पर बाल करा साढ़े चार सौ अगमजानी हवंय। <verse eid="1KI 18:22"/><verse number="23" style="v" sid="1KI 18:23"/>हमर बर दू ठन सांड़ लानव। बाल के अगमजानीमन ओमा के एक ठन ला चुनंय, अऊ ओला कुटा-कुटा काटके कठवा ऊपर रखंय पर ओमा आगी झन लगावंय। मेंह आने सांड़ ला तियार करके ओला कठवा ऊपर रखहूं पर ओमा आगी नइं लगाहूं। <verse eid="1KI 18:23"/><verse number="24" style="v" sid="1KI 18:24"/>तब तुमन अपन देवता ले पराथना करहू, अऊ मेंह यहोवा ले पराथना करहूं। अऊ जऊन देवता ह आगी गिराके जबाब दीही—ओही ह परमेसर अय।”</para>
  <para style="p" vid="1KI 18:24">तब जम्मो मनखेमन कहिन, “तेंह बने बात कहे हस।”<verse eid="1KI 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 18:25"/>एलियाह ह बाल के अगमजानीमन ला कहिस, “पहिले तुमन एक सांड़ ला चुनव अऊ ओला तियार करव, काबरकि तुमन बहुंत झन हवव। अपन देवता ले पराथना करव, पर आगी झन लगावव।” <verse eid="1KI 18:25"/><verse number="26" style="v" sid="1KI 18:26"/>तब ओमन ओ सांड़ ला लीन, जऊन ह ओमन ला दिये गे रिहिस अऊ ओला तियार करिन।</para>
  <para style="p" vid="1KI 18:26">तब ओमन बिहनियां ले लेके मंझनियां तक ये कहिके बाल ले चिचियाके पराथना करिन, “हे बाल, हमन ला जबाब दे!” पर ओमन ला कोनो जबाब नइं मिलिस; कोनो जबाब नइं दीन। अऊ ओमन अपन बनाय बेदी के चारों कोति नाचे लगिन।<verse eid="1KI 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 18:27"/>मंझन के बेरा, एलियाह ह ये कहिके ओमन ला ताना मारे लगिस, “अऊ जोर से चिचियावव! खचित, ओह एक देवता अय; सायद ओह बहुंत सोच-बिचार करत होही, या ब्यस्त होही, या यातरा करत होही। हो सकत हे, ओह सोवत होही अऊ ओला जगाय के जरूरत हे।” <verse eid="1KI 18:27"/><verse number="28" style="v" sid="1KI 18:28"/>अऊ ओमन अऊ चिचियाय लगिन अऊ अपन रीति-रिवाज के मुताबिक अपनआप ला तलवार अऊ बरछीमन ले तब तक घायल करे लगिन, जब तक कि ओमन के लहू नइं निकले लगिस। <verse eid="1KI 18:28"/><verse number="29" style="v" sid="1KI 18:29"/>आधा दिन बीत गीस, फेर ओमन संझा बलिदान के बेरा होवत तक पागल सहीं अगमबानी करते रिहिन। पर ओमन ला कोनो जबाब नइं मिलिस, कोनो जबाब नइं दीन, कोनो धियान नइं दीन।<verse eid="1KI 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 18:30"/>तब एलियाह ह जम्मो मनखेमन ला कहिस, “इहां, मोर करा आवव।” अऊ ओमन ओकर करा आईन, अऊ ओह यहोवा के बेदी ला मरम्मत करिस, जऊन ला कि टोरके गिरा दिये गे रिहिस। <verse eid="1KI 18:30"/><verse number="31" style="v" sid="1KI 18:31"/>तब एलियाह बारह ठन पथरा लीस, याने कि याकूब म ले आय बारह गोत्र म ले हर एक बर एक-एक ठन पथरा लीस; याकूब ला यहोवा ह कहे रिहिस, “तोर नांव इसरायल होही।” <verse eid="1KI 18:31"/><verse number="32" style="v" sid="1KI 18:32"/>ओ पथरामन ले एलियाह ह यहोवा के नांव म एक बेदी बनाईस, अऊ ओकर चारों कोति अतेक बड़े एक खंचवा कोड़िस कि ओमा दू सेआ<note caller="+" style="f"><char style="fr" closed="false">18:32 </char><char style="ft" closed="false">लगभग 11 किलोग्राम</char></note> बीजा आ सके। <verse eid="1KI 18:32"/><verse number="33" style="v" sid="1KI 18:33"/>तब ओह बेदी म कठवा ला सजाईस, सांड़ ला कुटा-कुटा करके काटिस अऊ ओ कुटामन ला कठवा ऊपर मढ़ा दीस। तब ओह मनखेमन ला कहिस, “चार ठन बड़े घड़ा म पानी भर देवव अऊ ओ पानी ला बलिदान अऊ कठवा ऊपर ढार देवव।”<verse eid="1KI 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 18:34"/>तब ओह कहिस, “वइसनेच फेर करव,” अऊ मनखेमन फेर वइसनेच करिन।</para>
  <para style="p" vid="1KI 18:34">ओह कहिस, “तीसरा बार अइसनेच फेर करव,” अऊ मनखेमन तीसरा बार घलो वइसनेच करिन। <verse eid="1KI 18:34"/><verse number="35" style="v" sid="1KI 18:35"/>पानी ह बेदी के चारों कोति बोहा गीस अऊ खंचवा ह पानी ले भर गीस।<verse eid="1KI 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 18:36"/>सांझ के बलिदान चघाय के बेरा, एलियाह अगमजानी ह आघू बढ़िस अऊ पराथना करिस, “हे यहोवा, अब्राहम, इसहाक अऊ इसरायल के परमेसर! आज तें येला परगट कर दे कि इसरायल म तें ही परमेसर अस, अऊ मेंह तोर सेवक अंव अऊ ये जम्मो काम तोर हुकूम ले करे हंव। <verse eid="1KI 18:36"/><verse number="37" style="v" sid="1KI 18:37"/>मोला जबाब दे, हे यहोवा, मोला जबाब दे, ताकि ये मनखेमन जानंय कि हे यहोवा, तें ही परमेसर अस, अऊ तें ही ओमन के मन ला फेर बदलत हस।”<verse eid="1KI 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 18:38"/>तब यहोवा के आगी ह अकास ले गिरिस अऊ बलिदान, कठवा, पथरा अऊ माटी ला जलाके भसम कर दीस, अऊ खंचवा के पानी ला घलो सूखा दीस।<verse eid="1KI 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 18:39"/>येला देखके, जम्मो मनखेमन मुहूं के भार गिरिन अऊ चिचियाके कहिन, “यहोवा ही परमेसर अय! यहोवा ही परमेसर अय।”<verse eid="1KI 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 18:40"/>तब एलियाह ह ओमन ला हुकूम दीस, “बाल के अगमजानीमन ला धर लेवव। ओमन ले एको झन घलो भागन झन पावय!” तब मनखेमन ओमन ला धर लीन, अऊ एलियाह ह ओमन ला खाल्हे कीसोन घाटी म ले आईस अऊ उहां ओमन ला मार डारिस।<verse eid="1KI 18:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 18:41"/>फेर एलियाह ह अहाब ला कहिस, “जा, खा अऊ पी, काबरकि भारी बारिस के अवाज सुनई देवत हे।” <verse eid="1KI 18:41"/><verse number="42" style="v" sid="1KI 18:42"/>तब अहाब ह खाय-पीये बर चल दीस, पर एलियाह ह करमेल पहाड़ के टीप म चघिस, अऊ भुइयां म झुकके अपन मुहूं ला दूनों माड़ी के बीच म करिस।<verse eid="1KI 18:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1KI 18:43"/>फेर ओह अपन सेवक ला कहिस, “जा अऊ समुंदर कोति देख।” तब ओह ऊपर जाके देखिस।</para>
  <para style="p" vid="1KI 18:43">सेवक ह आके कहिस, “उहां तो कुछू नइं ए।”</para>
  <para style="p" vid="1KI 18:43">एलियाह ह सात बार ले कहिस, “वापिस जा।”<verse eid="1KI 18:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="1KI 18:44"/>सातवां बार, सेवक ह आके कहिस, “समुंदर म ले मनखे के हांथ सहीं एक छोटे बादर उठत हवय।”</para>
  <para style="p" vid="1KI 18:44">तब एलियाह ह कहिस, “जा अऊ अहाब ले कह, ‘येकर पहिले कि बारिस ह तोला रोकय, जल्दी से अपन रथ म चघ अऊ खाल्हे चले जा।’ ”<verse eid="1KI 18:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1KI 18:45"/>थोरकन देर म, अकास ह बादर के कारन करिया होय लगिस, आंधी चले लगिस अऊ भारी बारिस सुरू हो गीस अऊ अहाब ह सवार होके यिजरेल सहर ला चल दीस। <verse eid="1KI 18:45"/><verse number="46" style="v" sid="1KI 18:46"/>यहोवा के सक्ति एलियाह ऊपर उतरिस, अऊ ओह अपन कपड़ा ला अपन कमरपट्टा म खोंचके अहाब के पहिले यिजरेल तक दऊड़त चले गीस।<verse eid="1KI 18:46"/></para>
  <chapter eid="1KI 18"/>
  <chapter number="19" style="c" sid="1KI 19"/>
  <para style="s1">एलियाह होरेब पहाड़ ऊपर भाग जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 19:1"/>राजा अहाब ह ईजेबेल ला ओ जम्मो बात बताईस, जऊन ला एलियाह ह करे रिहिस अऊ कइसने ओह जम्मो अगमजानीमन ला तलवार ले मार डारे रिहिस। <verse eid="1KI 19:1"/><verse number="2" style="v" sid="1KI 19:2"/>तब ईजेबेल ह एलियाह करा ये कहे बर दूत पठोईस, “यदि मेंह कल अतेक बेरा तक तोर परान ओ अगमजानीमन सहीं नइं कर दूहूं, त देवतामन मोर संग वइसने करंय, फेर ओकर ले घलो जादा करंय।”<verse eid="1KI 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 19:3"/>ये सुनके एलियाह ह डर गीस<note caller="+" style="f"><char style="fr" closed="false">19:3 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">एलियाह ह </char><char style="fqa" closed="false">देखिस</char></note> अऊ अपन परान बंचाय बर भागिस। जब ओह यहूदा के बेरसेबा सहर म हबरिस, त उहां ओह अपन सेवक ला छोंड़ दीस। <verse eid="1KI 19:3"/><verse number="4" style="v" sid="1KI 19:4"/>पर ओह खुद आघू सुनसान जगह म एक दिन के रसता चलिस। ओह एक झाऊ के झाड़ी करा आके ओकर खाल्हे म बईठ गीस अऊ ये कहिके पराथना म अपन मिरतू मांगे लगिस, “हे यहोवा, बहुंत हो गे; अब मोर परान लेय ले, काबरकि मेंह अपन पुरखामन ले बने नो हंव।” <verse eid="1KI 19:4"/><verse number="5" style="v" sid="1KI 19:5"/>तब ओह ओ झाड़ी खाल्हे लेट गीस अऊ सुत भुलाईस।</para>
  <para style="p" vid="1KI 19:5">तुरते एक स्वरगदूत ह ओला छुईस अऊ कहिस, “उठ अऊ खा।” <verse eid="1KI 19:5"/><verse number="6" style="v" sid="1KI 19:6"/>ओह चारों कोति अपन नजर घुमाके देखिस, त ओला अपन मुड़ करा कोइला के अंगरा म चुरे कुछू रोटी, अऊ पानी ले भरे एक सुराही दिखिस। तब ओह खाईस अऊ पीईस अऊ फेर लेट गीस।<verse eid="1KI 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 19:7"/>यहोवा के स्वरगदूत ह दूसर बार आईस अऊ ओला छूके कहिस, “उठ अऊ खा, काबरकि तोला बहुंत लम्बा यातरा करना हे।” <verse eid="1KI 19:7"/><verse number="8" style="v" sid="1KI 19:8"/>तब ओह उठके खाईस अऊ पीईस। खाना खाय ले ओला ताकत मिलिस अऊ ओह चालीस दिन अऊ चालीस रात रेंगत-रेंगत परमेसर के पहाड़ होरेब करा हबरिस। <verse eid="1KI 19:8"/><verse number="9" style="v" sid="1KI 19:9"/>उहां ओह एक खोड़रा म गीस अऊ उहां रथिया काटिस।</para>
  <para style="s1" vid="1KI 19:9">यहोवा ह एलियाह ला दरसन देथे</para>
  <para style="p" vid="1KI 19:9">अऊ यहोवा के बचन ह एलियाह करा आईस: “हे एलियाह, तेंह इहां का करत हस?”<verse eid="1KI 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 19:10"/>ओह जबाब दीस, “मेंह यहोवा सर्वसक्तिमान परमेसर बर बहुंत उत्साही हंव। इसरायलीमन तोर करार ला नइं माने हवंय, तोर बेदीमन ला गिरा दे हवंय, अऊ तोर अगमजानीमन ला तलवार ले घात करे हवंय। सिरिप मेंह एके झन बांचे हवंव, अऊ अब ओमन मोला घलो मार डारे के कोसिस करत हवंय।”<verse eid="1KI 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 19:11"/>यहोवा ह कहिस, “बाहिर निकलके, यहोवा के आघू म पहाड़ ऊपर ठाढ़ हो जा, काबरकि यहोवा ह उहां ले होके जवइया हे।”</para>
  <para style="p" vid="1KI 19:11">तब यहोवा के आघू म एक बड़े भयंकर आंधी ह पहाड़मन ला फोर दीस अऊ चट्टानमन ला टोर दीस, पर यहोवा ह ओ आंधी म नइं रिहिस। आंधी के बाद, एक भुइंडोल होईस, पर यहोवा ह ओ भुइंडोल म घलो नइं रिहिस। <verse eid="1KI 19:11"/><verse number="12" style="v" sid="1KI 19:12"/>भुइंडोल के बाद, आगी ह आईस, पर यहोवा ओ आगी म नइं रिहिस। अऊ आगी के बाद, एक धीमा कानाफूसी के अवाज सुनई दीस। <verse eid="1KI 19:12"/><verse number="13" style="v" sid="1KI 19:13"/>जब एलियाह ह येला सुनिस, त ओह अपन कपड़ा ला अपन मुहूं ऊपर ढांप लीस अऊ बाहिर निकलके खोड़रा के मुंहाटी म ठाढ़ हो गीस।</para>
  <para style="p" vid="1KI 19:13">तब ओला ये बात सुनई दीस, “हे एलियाह, तेंह इहां का करत हस?”<verse eid="1KI 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 19:14"/>ओह जबाब दीस, “मेंह यहोवा सर्वसक्तिमान परमेसर बर बहुंत उत्साही हंव। इसरायलीमन तोर करार ला नइं माने हवंय, तोर बेदीमन ला गिरा दे हवंय, अऊ तोर अगमजानीमन ला तलवार ले घात करे हवंय। सिरिप मेंह एके झन बांचे हवंव, अऊ अब ओमन मोला घलो मार डारे के कोसिस करत हवंय।”<verse eid="1KI 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 19:15"/>यहोवा ह ओला कहिस, “जऊन रसता म आय रहय, ओहीच रसता म लहुंट जा, अऊ दमिस्क सहर के सुनसान जगह म जा। जब तें उहां हबरबे, त हजाएल ला अराम के राजा होय बर अभिसेक करबे। <verse eid="1KI 19:15"/><verse number="16" style="v" sid="1KI 19:16"/>अऊ निमसी के बेटा येहू ला इसरायल के राजा होय बर, अऊ तोर जगह म अगमजानी होय बर आबेल-महोला नगर के सापात के बेटा एलीसा के अभिसेक करबे। <verse eid="1KI 19:16"/><verse number="17" style="v" sid="1KI 19:17"/>हजाएल के तलवार ले जऊन कोनो भी बच जाही, ओला येहू ह मार डारही, अऊ जऊन कोनो येहू के तलवार ले बच जाही, ओला एलीसा ह मार डारही। <verse eid="1KI 19:17"/><verse number="18" style="v" sid="1KI 19:18"/>तभो ले मेंह इसरायल म सात हजार मनखे ला बंचाके रखे हंव—ये जम्मो ओमन अंय, जेमन न तो बाल के आघू म माड़ी टेके हवंय, अऊ न ही अपन मुहूं ले ओला चूमे हवंय।”<verse eid="1KI 19:18"/></para>
  <para style="s1">एलीसा के बुलाहट</para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 19:19"/>तब एलियाह ह उहां ले चल दीस, अऊ ओला सापात के बेटा एलीसा मिलिस, जऊन ह बारह जोड़ी बईलामन ले नांगर जोतत रहय, अऊ ओह खुद बारहवां जोड़ी ला हांकत रहय। एलियाह ह ओकर मेर जाके ओकर ऊपर अपन कपड़ा ला डाल दीस। <verse eid="1KI 19:19"/><verse number="20" style="v" sid="1KI 19:20"/>तब एलीसा ह अपन बईलामन ला छोंड़के एलियाह के पाछू दऊड़िस अऊ कहे लगिस, “मोला जाके मोर दाई अऊ ददा ला चूमन दे अऊ बिदा लेवन दे, अऊ तब मेंह तोर संग चलहूं।”</para>
  <para style="p" vid="1KI 19:20">एलियाह ह कहिस, “लहुंट जा, मेंह तोर का करे हवंव?”<verse eid="1KI 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 19:21"/>तब एलीसा ह ओला छोंड़के वापिस चल दीस। अऊ अपन बईलामन के जोड़ी ला लेके पूज दीस। ओह नांगर जोते के सामान ला जलाके मांस ला पकाईस अऊ ओला मनखेमन ला खाय बर दीस, अऊ ओमन खाईन। तब ओह एलियाह के पाछू चले बर गीस अऊ ओकर सेवक बन गीस।<verse eid="1KI 19:21"/></para>
  <chapter eid="1KI 19"/>
  <chapter number="20" style="c" sid="1KI 20"/>
  <para style="s1">बेन-हदद सामरिया ऊपर हमला करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 20:1"/>अराम के राजा बेन-हदद ह अपन जम्मो सेना ला संकेलिस। ओकर संग म अऊ बत्तीस राजामन अपन घोड़ा अऊ रथ सहित गीन; ओमन के संग जाके ओह सामरिया ला घेर लीस अऊ ओकर ऊपर हमला करिस। <verse eid="1KI 20:1"/><verse number="2" style="v" sid="1KI 20:2"/>ओह सहर म इसरायल के राजा अहाब करा दूतमन ला ये कहे बर पठोईस, “बेन-हदद ह ये कहत हे: <verse eid="1KI 20:2"/><verse number="3" style="v" sid="1KI 20:3"/>‘तोर सोन अऊ चांदी ह मोर अय, अऊ तोर सबले बने घरवालीमन अऊ लइकामन घलो मोर अंय।’ ”<verse eid="1KI 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 20:4"/>इसरायल के राजा ह ओकर करा ये कहे बर पठोईस, “हे मोर मालिक राजा! तोर कहे मुताबिक में तोर अंव अऊ मोर जम्मो चीज घलो तोर अंय।”<verse eid="1KI 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 20:5"/>दूतमन वापिस आके इसरायल के राजा ले कहिन, “बेन-हदद ह ये कहत हे: ‘मेंह खबर पठोय रहेंव कि तें अपन सोन अऊ चांदी, अपन घरवाली अऊ लइकामन ला मोला दे। <verse eid="1KI 20:5"/><verse number="6" style="v" sid="1KI 20:6"/>पर कल अतेक बेरा, मेंह अपन करमचारीमन ला पठोहूं अऊ ओमन तोर महल अऊ तोर करमचारीमन के घर के जांच-पड़ताल करहीं, अऊ ओमन तोर जम्मो कीमती सामान ला जपती करके अपन संग ले आहीं।’ ”<verse eid="1KI 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 20:7"/>तब इसरायल के राजा ह अपन देस के जम्मो अगुवामन ला बलाके कहिस, “देखव, ये मनखे ह कइसे समस्या खड़े करे के ताक म हवय! जब ओह मोर घरवालीमन अऊ मोर लइकामन, मोर सोन अऊ चांदी के मांग करिस, त मेंह इनकार नइं करेंव।”<verse eid="1KI 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 20:8"/>तब जम्मो अगुवा अऊ मनखेमन जबाब दीन, “बेन-हदद के बात ला झन सुन या ओकर मांग ला झन मान।”<verse eid="1KI 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 20:9"/>तब राजा ह बेन-हदद के दूतमन ला जबाब दीस, “मोर मालिक राजा ला जाके कहव, ‘जऊन कुछू तेंह पहिले अपन सेवक ले मांग करे रहे, ओ जम्मो ला मेंह पूरा करहूं, पर तोर ये मांग ला मेंह पूरा नइं कर सकंव।’ ” दूतमन वापिस जाके बेन-हदद ला ये संदेस सुनाईन।<verse eid="1KI 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 20:10"/>तब बेन-हदद ह अहाब करा एक आने संदेस पठोईस, “यदि सामरिया म अतेक धुर्रा बांचे हवय कि मोर जम्मो मनखेमन ला एक-एक मुट्ठी मिल जावय, त देवतामन मोर संग कठोरता से बेवहार करंय।”<verse eid="1KI 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 20:11"/>इसरायल के राजा ह जबाब देवत खबर पठोईस, “ओकर ले कहव, ‘जऊन ह अपन हथियार बांधथे, ओला ओकर सहीं घमंड नइं करना चाही, जऊन ह ओ हथियार ला उतारथे।’ ”<verse eid="1KI 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 20:12"/>जब ये संदेस बेन-हदद ला दिये गीस, त ओ समय, ओह अऊ राजामन अपन डेरामन म पीयत रिहिन, अऊ ओह अपन मनखेमन ला हुकूम दीस: “हमला करे बर तियारी करव।” तब ओमन सहर ऊपर हमला करे बर तियारी करिन।<verse eid="1KI 20:12"/></para>
  <para style="s1">अहाब ह बेन-हदद ला हराथे</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 20:13"/>ये बीच म, एक अगमजानी ह इसरायल के राजा अहाब करा आके कहिस, “यहोवा ह ये कहत हे: ‘का तेंह ये बहुंत बड़े सेना ला देखत हस? येला आज ही मेंह तोर हांथ म कर दूहूं, अऊ तब तें जान लेबे कि मेंह यहोवा अंव।’ ”<verse eid="1KI 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 20:14"/>अहाब ह पुछिस, “पर येला कोन ह करही?”</para>
  <para style="p" vid="1KI 20:14">अगमजानी ह जबाब दीस, “यहोवा ह ये कहत हे: ‘इलाका के सेनापतिमन के अधीन छोटे अधिकारीमन येला करहीं।’ ”</para>
  <para style="p" vid="1KI 20:14">फेर ओह पुछिस, “अऊ लड़ई के सुरूआत कोन ह करही?”</para>
  <para style="p" vid="1KI 20:14">ओ अगमजानी ह जबाब दीस, “तेंह करबे।”<verse eid="1KI 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 20:15"/>एकरसेति अहाब ह इलाका के सेनापतिमन के अधीन दू सौ बत्तीस छोटे अधिकारीमन ला बलाईस। तब ओह बाकि बचे सात हजार इसरायली मनखेमन ला इकट्ठा करिस। <verse eid="1KI 20:15"/><verse number="16" style="v" sid="1KI 20:16"/>ओमन मंझन के बेरा म निकलिन, अऊ ओ समय, बेन-हदद अऊ ओकर संग के बत्तीस राजामन अपन डेरामन म मंद पीके मतवाला होवत रहंय। <verse eid="1KI 20:16"/><verse number="17" style="v" sid="1KI 20:17"/>इलाका के सेनापतिमन के अधीन छोटे अधिकारीमन पहिले निकलिन।</para>
  <para style="p" vid="1KI 20:17">बेन-हदद ह संदेस लाने बर सैनिकमन ला पठोय रिहिस, अऊ ओमन आके कहिन, “सामरिया ले मनखेमन आघू बढ़त हवंय।”<verse eid="1KI 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 20:18"/>ओह हुकूम दीस, “यदि ओमन मेल-मिलाप करे बर निकले हवंय, त ओमन ला जिंदा पकड़के ले आवव; यदि ओमन लड़ई करे बर निकले हवंय, तब भी ओमन ला जिंदा पकड़के ले आवव।”<verse eid="1KI 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 20:19"/>छोटे अधिकारीमन इलाका के सेनापतिमन के अधीन सहर ले निकलिन अऊ ओमन के पाछू सेना के सिपाहीमन रहंय <verse eid="1KI 20:19"/><verse number="20" style="v" sid="1KI 20:20"/>अऊ ओमा के हर एक जन अपन बिरोधी ला मार डारिस। येला देखके, अरामीमन भागे लगिन, अऊ इसरायलीमन ओमन के पीछा करिन। पर अराम के राजा बेन-हदद ह घोड़ा म चघके अपन कुछू घुड़सवारमन संग बचके भाग गीस। <verse eid="1KI 20:20"/><verse number="21" style="v" sid="1KI 20:21"/>तब इसरायल के राजा ह आघू बढ़के घोड़ा अऊ रथमन ला अधिकार म कर लीस अऊ अरामीमन के भारी नुकसान करिस।<verse eid="1KI 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 20:22"/>ओकर बाद, ओ अगमजानी ह इसरायल के राजा करा आके कहिस, “अपन स्थिति ला मजबूत कर अऊ देख कि का करना जरूरी ए, काबरकि नवां साल के लगत ही अराम के राजा ह फेर तोर ऊपर हमला करही।”<verse eid="1KI 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 20:23"/>ये बीच म, अराम के राजा के करमचारीमन ओला ये सलाह दीन, “ओ मनखेमन के देवतामन पहाड़ी देवता अंय, एकर खातिर ओमन हमर ऊपर भारी पड़िन। पर यदि हमन ओमन ले मैदान म लड़बो, त निस्चय ही, हमन ओमन ऊपर भारी पड़बो। <verse eid="1KI 20:23"/><verse number="24" style="v" sid="1KI 20:24"/>अइसने कर: जम्मो राजामन के अधिकार ला छीन ले अऊ ओमन के जगह म आने अधिकारीमन ला ठहिरा दे। <verse eid="1KI 20:24"/><verse number="25" style="v" sid="1KI 20:25"/>अऊ जऊन सेना ला तेंह गंवा दे हस, वइसने फेर एक ठन सेना तियार कर—घोड़ा के बदला म घोड़ा अऊ रथ के बदला म रथ—ताकि हमन मैदान म इसरायल ले लड़ सकन। तब निस्चय ही, हमन ओमन ऊपर भारी पड़बो।” ओह ओमन के बात ला मानिस अऊ वइसनेच करिस।<verse eid="1KI 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 20:26"/>नवां साल के लगत ही बेन-हदद ह अरामी सेना ला इकट्ठा करिस अऊ इसरायल ले लड़े बर अपेक सहर ला गीस। <verse eid="1KI 20:26"/><verse number="27" style="v" sid="1KI 20:27"/>जब इसरायलीमन ला घलो इकट्ठा करे गीस अऊ ओमन ला भोजन-पानी दिये गीस, त ओमन अरामीमन के सामना करे बर निकलिन। इसरायलीमन छेरीमन के दू ठन छोटे झुंड सहीं ओमन के आघू म डेरा डाले रिहिन, जबकि अरामीमन मैदान म भर गे रिहिन।<verse eid="1KI 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 20:28"/>तब परमेसर के जन ह इसरायल के राजा करा आईस अऊ कहिस, “यहोवा ह ये कहत हे: ‘अरामीमन सोचथें कि यहोवा ह पहाड़ी देवता अय अऊ घाटीमन के देवता नो हय, एकरे कारन, मेंह ओ बड़े सेना ला तोर हांथ म कर दूहूं, अऊ तब तुमन जानहू कि मेंह यहोवा अंव।’ ”<verse eid="1KI 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 20:29"/>सात दिन तक, ओमन एक-दूसर के आघू म डेरा डाले रिहिन, अऊ सातवां दिन लड़ई सुरू होईस। अऊ इसरायलीमन एक दिन म, अरामीमन के एक लाख पैदल सेना ला मार डारिन। <verse eid="1KI 20:29"/><verse number="30" style="v" sid="1KI 20:30"/>बाकि बचे अरामी सेना ह बचके अपेक सहर ला भाग गीस, जिहां सहर के दीवार गिरे ले ओमा के सत्ताईस हजार मनखे दबके मर गीन। अऊ बेन-हदद ह सहर ला भाग गीस अऊ जाके एक ठन भीतरी कमरा म लुका गीस।<verse eid="1KI 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 20:31"/>तब ओकर करमचारीमन ओला कहिन, “देख, हमन सुने हवन कि इसरायल के राजामन दयालु होथें, एकरसेति, हमन कनिहां म टाट के कपड़ा अऊ मुड़ म रस्सी लपेटके इसरायल के राजा करा चलन। हो सकथे कि ओह तोर परान झन लेवय।”<verse eid="1KI 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 20:32"/>तब अपन कनिहां म टाट के कपड़ा पहिरके अऊ मुड़ म रस्सी बांधके, ओमन इसरायल के राजा करा गीन अऊ कहिन, “तोर सेवक बेन-हदद ह कहत हे, ‘किरपा करके मोला जीयत रहन दे।’ ”</para>
  <para style="p" vid="1KI 20:32">राजा ह जबाब दीस, “का ओह अभी तक ले जीयत हवय? ओह तो मोर भाई अय।”<verse eid="1KI 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 20:33"/>ओ मनखेमन येला बने बात समझके तुरते ओकर बात के ये जबाब दीन, “हव, तोर भाई बेन-हदद।”</para>
  <para style="p" vid="1KI 20:33">राजा ह कहिस, “जाके ओला ले आवव।” जब बेन-हदद ह निकलके आईस, त अहाब ह ओला अपन रथ म चघा लीस।<verse eid="1KI 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 20:34"/>तब बेन-हदद ह ओला कहिस, “जऊन सहरमन ला मोर ददा ह तोर ददा ले छीन ले रिहिस, ओमन ला मेंह तोला वापिस कर दूहूं, अऊ जइसने मोर ददा ह सामरिया म हाट-बजार बनाय रिहिस, वइसने तेंह अपन खुद के हाट-बजार दमिस्क म बना सकत हस।”</para>
  <para style="p" vid="1KI 20:34">अहाब ह कहिस, “एक करार के अधार म, मेंह तोला छोंड़ दूहूं।” तब ओह बेन-हदद संग एक करार करिस, अऊ ओला जावन दीस।<verse eid="1KI 20:34"/></para>
  <para style="s1">एक अगमजानी ह अहाब ला दोसी ठहिराथे</para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 20:35"/>यहोवा ले बचन पाके, अगमजानीमन के दल के एक जन ह अपन संगी ला कहिस, “अपन हथियार ले मोला मार।” पर ओकर संगी ह इनकार करिस।<verse eid="1KI 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 20:36"/>तब पहिले अगमजानी ह कहिस, “काबरकि तेंह यहोवा के बात ला नइं माने, एकरसेति जइसने ही तेंह मोर करा ले जाबे, एक सिंह ह तोला मार डारही।” अऊ जब ओ मनखे ह चले गीस, त डहार म ओला एक सिंह मिलिस अऊ ओला मार डारिस।<verse eid="1KI 20:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 20:37"/>ओ अगमजानी ला एक आने मनखे मिलिस, ओला घलो कहिस, “मोला मार।” अऊ ओ मनखे ह अगमजानी ला मारिस अऊ ओला घायल कर दीस। <verse eid="1KI 20:37"/><verse number="38" style="v" sid="1KI 20:38"/>तब ओ अगमजानी चले गीस अऊ सड़क के तीर म ठाढ़ होके राजा के बाट जोहे लगिस। ओह अपन पगड़ी ले अपन आंखीमन ला ढांपके अपन भेस ला छुपा ले रहय। <verse eid="1KI 20:38"/><verse number="39" style="v" sid="1KI 20:39"/>जब राजा ह उहां ले होके जावत रिहिस, त ओ अगमजानी ह ओला पुकारके कहिस, “जब तोर सेवक ह लड़ई के इलाका म गे रिहिस, त एक मनखे ह एक कैदी ला लेके मोर करा आईस अऊ कहिस, ‘ये मनखे के रखवारी कर। यदि ये मनखे कहीं चले जाही, त ओकर परान के बदले म तोर परान ले लिये जाही, या फेर तोला एक टेलेन्ट<note caller="+" style="f"><char style="fr" closed="false">20:39 </char><char style="ft" closed="false">लगभग 34 किलोग्राम</char></note> चांदी देय ला पड़ही।’ <verse eid="1KI 20:39"/><verse number="40" style="v" sid="1KI 20:40"/>ओकर बाद, जब तोर सेवक ह एती-ओती बुता म फंस गीस, त ओ मनखे ह गायब हो गीस।”</para>
  <para style="p" vid="1KI 20:40">इसरायल के राजा ह कहिस, “तोर अइसने ही नियाय होही; तेंह खुद येकर निरनय करे हवस।”<verse eid="1KI 20:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 20:41"/>तब अगमजानी ह तुरते अपन आंखीमन ले पगड़ी ला हटाईस, अऊ इसरायल के राजा ह ओला एक अगमजानी के रूप म चिन डारिस। <verse eid="1KI 20:41"/><verse number="42" style="v" sid="1KI 20:42"/>तब ओ अगमजानी ह राजा ला कहिस, “यहोवा ह ये कहत हे: ‘तेंह एक अइसने मनखे ला छोंड़ दे हस, जेकर बारे म मेंह ठान ले रहेंव कि ओह मरय। एकरसेति अब ओकर परान के बदले तोर परान जाही अऊ ओकर मनखेमन के बदले तोर मनखेमन।’ ” <verse eid="1KI 20:42"/><verse number="43" style="v" sid="1KI 20:43"/>तब उदास अऊ गुस्सा होके, इसरायल के राजा ह सामरिया के अपन महल म चले गीस।<verse eid="1KI 20:43"/></para>
  <chapter eid="1KI 20"/>
  <chapter number="21" style="c" sid="1KI 21"/>
  <para style="s1">नाबोत के अंगूर के बारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 21:1"/>कुछू समय के बाद, नाबोत नांव के एक यिजरेली के एक अंगूर के बारी के संबंध म एक घटना होईस। ओ अंगूर के बारी ह यिजरेल म सामरिया के राजा अहाब के महल के लकठा म रहय। <verse eid="1KI 21:1"/><verse number="2" style="v" sid="1KI 21:2"/>अहाब ह नाबोत ला कहिस, “तोर अंगूर के बारी ह मोर महल के लकठा म हवय, त तें ओला मोला देय दे कि मेंह ओकर उपयोग साग-भाजी के बारी के रूप म करंव। ओकर बदले म, मेंह तोला ओकर ले जादा बने एक अंगूर के बारी दूहूं या यदि तें चाहबे, त जो भी ओकर कीमत होही, मेंह तोला ओकर दाम चुका दूहूं।”<verse eid="1KI 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 21:3"/>पर नाबोत ह जबाब दीस, “यहोवा ह झन करय कि मेंह अपन पुरखामन के संपत्ति ला देवंव।”<verse eid="1KI 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 21:4"/>यिजरेली नाबोत के ये बात के कारन कि मेंह अपन पुरखामन के संपत्ति तोला नइं देवंव, अहाब ह उदास अऊ नराज होके अपन घर चल दीस, अऊ उदास मन से अपन बिस्तर म लेट गीस अऊ जेवन करे बर मना कर दीस।<verse eid="1KI 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 21:5"/>तब ओकर घरवाली ईजेबेल ह ओकर करा आके पुछिस, “तेंह काबर अतेक उदास हवस? तेंह काबर नइं खावत हस?”<verse eid="1KI 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 21:6"/>राजा ह ओला कहिस, “कारन ये अय कि मेंह यिजरेली नाबोत ला कहेंव, ‘तोर अंगूर के बारी ला मोर करा बेच दे; या यदि तें चाहबे, त मेंह तोला ओकर बदले म एक आने अंगूर के बारी दूहूं।’ पर ओह कहिस, ‘मेंह अपन अंगूर के बारी तोला नइं दंव।’ ”<verse eid="1KI 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 21:7"/>राजा के घरवाली ईजेबेल ह कहिस, “का तेंह इसरायल ऊपर राज करथस कि नइं? उठ अऊ खाना खा! खुसी मना। यिजरेली नाबोत के अंगूर के बारी मेंह तोला देवाहूं।”<verse eid="1KI 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 21:8"/>तब ईजेबेल ह अहाब के नांव ले चिट्ठी लिखके ओमा ओकर मुहर लगाईस, अऊ चिट्ठीमन ला ओ अगुवा अऊ परभावसाली मनखेमन करा पठोईस, जऊन मन ओही सहर म नाबोत के संग रहत रिहिन। <verse eid="1KI 21:8"/><verse number="9" style="v" sid="1KI 21:9"/>ओ चिट्ठीमन म, ओह ये लिखे रहय:</para>
  <para style="pm" vid="1KI 21:9">“एक दिन के उपास रखे के घोसना करव अऊ नाबोत ला मनखेमन के बीच एक खास जगह म बईठावव। <verse eid="1KI 21:9"/><verse number="10" style="v" sid="1KI 21:10"/>पर दू झन दुस्ट मनखे ला ओकर आघू म बईठावव, जऊन मन नाबोत ऊपर ये दोस लगावंय कि ओह परमेसर अऊ राजा दूनों के निन्दा करे हवय। तब ओला बाहिर ले जावव अऊ पथरवाह करके ओला मार डारव।”<verse eid="1KI 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 21:11"/>ईजेबेल ह नाबोत के सहर म रहइया अगुवा अऊ परभावसाली मनखेमन ला चिट्ठी म लिखके जइसने हुकूम दे रिहिस, ओमन वइसने ही करिन। <verse eid="1KI 21:11"/><verse number="12" style="v" sid="1KI 21:12"/>ओमन उपास रखे के घोसना करिन अऊ नाबोत ला मनखेमन के बीच एक खास जगह म बईठाईन। <verse eid="1KI 21:12"/><verse number="13" style="v" sid="1KI 21:13"/>तब दू झन दुस्ट मनखे आके ओकर आघू म बईठ गीन अऊ ओमन ये कहिके मनखेमन के आघू म नाबोत ऊपर दोस लगाईन, “नाबोत ह परमेसर अऊ राजा दूनों के निन्दा करे हवय।” एकरे कारन, ओमन ओला सहर के बाहिर ले गीन अऊ पथरवाह करके ओला मार डारिन। <verse eid="1KI 21:13"/><verse number="14" style="v" sid="1KI 21:14"/>तब ओमन ईजेबेल करा ये खबर पठोईन: “नाबोत ला पथरवाह करके मार डारे गे हवय।”<verse eid="1KI 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 21:15"/>जइसने ही ईजेबेल ह ये सुनिस कि नाबोत ला पथरवाह करके मार डारे गे हवय, त ओह अहाब ले कहिस, “उठ अऊ यिजरेली नाबोत के ओ अंगूर के बारी ला अपन कब्जा म लेय ले, जेला ओह तोला बेचे बर इनकार करे रिहिस। नाबोत ह अब जीयत नइं ए, पर ओह मर गे हवय।” <verse eid="1KI 21:15"/><verse number="16" style="v" sid="1KI 21:16"/>जब अहाब ह सुनिस कि नाबोत ह मर गे हवय, त ओह उठिस अऊ नाबोत के अंगूर के बारी ला अपन कब्जा म लेय बर खाल्हे गीस।<verse eid="1KI 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 21:17"/>तब यहोवा के ये बचन तिसबी एलियाह करा आईस: <verse eid="1KI 21:17"/><verse number="18" style="v" sid="1KI 21:18"/>“इसरायल के राजा अहाब करा मिले बर खाल्हे जा, जऊन ह सामरिया म राज करथे। ओह अभी नाबोत के अंगूर के बारी म हवय, अऊ ओह ओला अपन कब्जा म लेय बर उहां गे हवय। <verse eid="1KI 21:18"/><verse number="19" style="v" sid="1KI 21:19"/>ओला ये कह, ‘यहोवा ह ये कहत हे: का तेंह एक मनखे के हतिया करके ओकर संपत्ति ला कब्जा नइं कर ले हस?’ फेर ओला ये घलो कह, ‘यहोवा ह ये कहत हे: जऊन जगह म कुकुरमन नाबोत के लहू ला चाटिन, ओही जगह म कुकुरमन तोर लहू ला घलो चाटहीं—हव, तोर लहू!’ ”<verse eid="1KI 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 21:20"/>एलियाह ला देखके अहाब ह कहिस, “हे मोर बईरी! तेंह मोला खोज लेय!”</para>
  <para style="p" vid="1KI 21:20">एलियाह ह जबाब दीस, “हव, मेंह तोला खोज लेंव, काबरकि यहोवा के नजर म दुस्ट काम करे बर तेंह अपनआप ला बेच दे हवस। <verse eid="1KI 21:20"/><verse number="21" style="v" sid="1KI 21:21"/>परमेसर ह कहत हे, ‘मेंह तोर ऊपर बिपत्ति लानेवाला हंव। मेंह तोर संतानमन के नामोनिसान मिटा दूहूं अऊ इसरायल म अहाब के घर के एक-एक छोकरा अऊ पुरूस ला नास कर दूहूं—चाहे ओह गुलाम हो या सुतंतर मनखे। <verse eid="1KI 21:21"/><verse number="22" style="v" sid="1KI 21:22"/>मेंह तोर घराना ला नबात के बेटा यरोबाम, अऊ अहियाह के बेटा बासा के सहीं कर दूहूं, काबरकि तेंह मोर गुस्सा ला भड़काय हस अऊ इसरायल ले पाप करवाय हस।’<verse eid="1KI 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 21:23"/>“अऊ ईजेबेल के बारे म घलो यहोवा ह कहत हे: ‘यिजरेल के दीवार के भीतर, कुकुरमन ईजेबेल ला खा डारहीं।’<verse eid="1KI 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 21:24"/>“अहाब के जऊन मनखेमन सहर म मरहीं, ओमन ला कुकुरमन खा डारहीं, अऊ जऊन मन मैदान म मरहीं, ओमन ला अकास के चिरईमन खा जाहीं।”<verse eid="1KI 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 21:25"/>(अहाब के सहीं अऊ कोनो नइं रिहिस, जऊन ह अपन घरवाली ईजेबेल के उकसाय म आके, यहोवा के नजर म दुस्ट काम करे बर अपनआप ला बेच दीस। <verse eid="1KI 21:25"/><verse number="26" style="v" sid="1KI 21:26"/>ओह मूरतीमन के पाछू जाके सबले जादा नीच काम करिस, जइसने कि ओ अमोरीमन करे रिहिन, जेमन ला यहोवा ह इसरायलीमन के आघू ले निकाल दे रिहिस।)<verse eid="1KI 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 21:27"/>जब अहाब ह ये बात ला सुनिस, त ओह अपन ओनहा ला चीरिस, अऊ टाट के कपड़ा पहिरके उपास करिस। ओह टाट के कपड़ा म सोये लगिस अऊ नम्र मन से एती-ओती जाय लगिस।<verse eid="1KI 21:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 21:28"/>तब यहोवा के ये बचन तिसबी एलियाह करा आईस: <verse eid="1KI 21:28"/><verse number="29" style="v" sid="1KI 21:29"/>“का तेंह धियान दे हवस कि अहाब ह कइसे मोर आघू म नम्र बन गे हवय? काबरकि ओह अपनआप ला नम्र कर ले हवय, एकरसेति मेंह ये बिपत्ति ला ओकर जीयत भर नइं लानंव, पर मेंह येला ओकर बेटा के दिन म ओकर घराना ऊपर लानहूं।”<verse eid="1KI 21:29"/></para>
  <chapter eid="1KI 21"/>
  <chapter number="22" style="c" sid="1KI 22"/>
  <para style="s1">मीकायाह अहाब के बिरूध अगमबानी करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 22:1"/>तीन बछर तक अरामी अऊ इसरायलीमन के बीच म लड़ई नइं होईस। <verse eid="1KI 22:1"/><verse number="2" style="v" sid="1KI 22:2"/>पर तीसरा बछर यहूदा के राजा यहोसापात इसरायल के राजा ला देखे बर गीस। <verse eid="1KI 22:2"/><verse number="3" style="v" sid="1KI 22:3"/>इसरायल के राजा ह अपन करमचारीमन ला कहे रिहिस, “का तुमन नइं जानत हव कि रामोत-गिलाद ह हमर अय अऊ तभो ले ओला हमन अराम के राजा के हांथ ले वापिस लेय बर कुछू नइं करत हन?”<verse eid="1KI 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 22:4"/>एकरसेति ओह यहोसापात ले पुछिस, “का तेंह मोर संग रामोत-गिलाद के बिरूध लड़े बर जाबे?”</para>
  <para style="p" vid="1KI 22:4">यहोसापात ह इसरायल के राजा ला जबाब दीस, “मेंह घलो तोर असन अंव, मोर मनखेमन तोर मनखेमन असन अंय, मोर घोड़ामन तोर घोड़ामन असन अंय।” <verse eid="1KI 22:4"/><verse number="5" style="v" sid="1KI 22:5"/>पर यहोसापात ह इसरायल के राजा ला ये घलो कहिस, “पहिले यहोवा के ईछा ला मालूम कर ले।”<verse eid="1KI 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 22:6"/>तब इसरायल के राजा ह अगमजानीमन ला इकट्ठा करिस—ओमन करीब चार सौ आदमी रिहिन—अऊ राजा ह ओमन ले पुछिस, “का मेंह रामोत-गिलाद के बिरूध लड़ई करे बर जावंव, या फेर रूक जावंव?”</para>
  <para style="p" vid="1KI 22:6">ओमन जबाब दीन, “जा, काबरकि परभू ह ओला राजा के हांथ म कर दीही।”<verse eid="1KI 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 22:7"/>पर यहोसापात ह पुछिस, “का इहां यहोवा के कोनो अगमजानी नइं अंय, जेकर ले हमन पुछताछ कर सकन?”<verse eid="1KI 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 22:8"/>इसरायल के राजा ह यहोसापात ला जबाब दीस, “इहां अभी भी एक अगमजानी हवय, जेकर जरिये हमन यहोवा ले पुछताछ कर सकत हन? पर मेंह ओकर ले घिन करथंव, काबरकि ओह कभू भी मोर बारे म कोनो बने बात के अगमबानी नइं करय, पर हमेसा खराप बात ही कहिथे। ओह यिमला के बेटा मीकायाह ए।”</para>
  <para style="p" vid="1KI 22:8">यहोसापात ह कहिस, “राजा ला अइसन बात नइं कहना चाही।”<verse eid="1KI 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 22:9"/>तब इसरायल के राजा ह अपन एक करमचारी ला बलाके कहिस, “यिमला के बेटा मीकायाह ला अभीचे लेके आवव।”<verse eid="1KI 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 22:10"/>इसरायल के राजा अऊ यहूदा के राजा यहोसापात अपन राजसी कपड़ा पहिरे सामरिया के प्रवेस दुवार के बगल म एक कोठार म अपन सिंघासन म बईठे रहंय अऊ जम्मो अगमजानीमन ओमन के आघू म अगमबानी करत रहंय। <verse eid="1KI 22:10"/><verse number="11" style="v" sid="1KI 22:11"/>कनाना के बेटा सिदकियाह ह लोहा के सींग बनाय रिहिस अऊ ओह घोसना करिस, “यहोवा ह ये कहत हे: ‘ये सींगमन ले तुमन अरामीमन ला अइसन मारहू, कि जब तक ओमन नास नइं हो जाहीं।’ ”<verse eid="1KI 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 22:12"/>आने जम्मो अगमजानीमन घलो येहीच अगमबानी करत रिहिन। ओमन कहिन, “रामोत-गिलाद ऊपर हमला करव अऊ जीत जावव, काबरकि यहोवा ह ओला राजा के हांथ म कर दीही।”<verse eid="1KI 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 22:13"/>जऊन संदेसिया ह मीकायाह ला बलाय बर गे रिहिस, ओह ओकर ले कहिस, “देख, आने अगमजानीमन बिगर कोनो आपत्ति के राजा बर सफलता के अगमबानी करत हवंय। तोर बात ह घलो ओमन के बात ले मेल खावय, अऊ तें राजा के हित म गोठियाबे।”<verse eid="1KI 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 22:14"/>पर मीकायाह ह कहिस, “यहोवा के जिनगी के सपथ, मेंह ओला सिरिप ओही बात बताहूं, जेला यहोवा ह मोला कहिही।”<verse eid="1KI 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 22:15"/>जब मीकायाह ह उहां हबरिस, त राजा ह ओकर ले पुछिस, “हे मीकायाह! का हमन रामोत-गिलाद के बिरूध लड़ई करे बर जावन, या नइं?”</para>
  <para style="p" vid="1KI 22:15">ओह जबाब दीस, “हमला करव अऊ जीत जावव, काबरकि यहोवा ह ओला राजा के हांथ म कर दीही।”<verse eid="1KI 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 22:16"/>राजा ह ओला कहिस, “मेंह तोला कतेक बार कसम खवावंव कि तें यहोवा के नांव म मोला सिरिप सच्चई के छोंड़ अऊ कुछू बात झन बता?”<verse eid="1KI 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 22:17"/>तब मीकायाह ह जबाब दीस, “मेंह जम्मो इसरायल ला पहाड़ीमन म बिगर चरवाहा के बगरे भेड़मन सहीं देखेंव, अऊ यहोवा ह कहिस, ‘ये मनखेमन के कोनो मालिक नइं एं। हर एक जन सांति से अपन घर जावय।’ ”<verse eid="1KI 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 22:18"/>तब इसरायल के राजा ह यहोसापात ला कहिस, “का मेंह तोला नइं कहे रहेंव कि ओह मोर बारे म कभू बने अगमबानी नइं करय, पर सिरिप खराप बात कहिथे?”<verse eid="1KI 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 22:19"/>तब मीकायाह ह आगे कहिस, “एकरसेति यहोवा के बचन ला सुनव: मेंह यहोवा ला अपन सिंघासन म बईठे अऊ ओकर संग स्वरग के जम्मो भीड़ ला ओकर जेवनी अऊ डेरी कोति खड़े देखेंव। <verse eid="1KI 22:19"/><verse number="20" style="v" sid="1KI 22:20"/>अऊ यहोवा ह कहिस, ‘कोन ह अहाब ला रामोत-गिलाद ऊपर हमला करे बर अऊ उहां जाके मरे बर बहकाही?’</para>
  <para style="p" vid="1KI 22:20">“कोनो ह कुछू सलाह दीस, त कोनो ह कुछू अऊ। <verse eid="1KI 22:20"/><verse number="21" style="v" sid="1KI 22:21"/>आखिर म, एक आतमा आघू म आके यहोवा के आघू म ठाढ़ होईस अऊ कहिस, ‘मेंह ओला बहकाहूं।’<verse eid="1KI 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 22:22"/>“यहोवा ह पुछिस, ‘कोन किसम ले?’</para>
  <para style="p" vid="1KI 22:22">“ओ आतमा ह कहिस, ‘मेंह बाहिर जाहूं अऊ ओकर जम्मो अगमजानीमन के मुहूं म एक धोखा देवइया आतमा बनहूं।’</para>
  <para style="p" vid="1KI 22:22">“यहोवा ह कहिस, ‘तेंह ओला बहकाय म सफल होबे, जा अऊ येला कर।’<verse eid="1KI 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 22:23"/>“एकरसेति, अब यहोवा ह तोर ये जम्मो अगमजानीमन के मुहूं म एक धोखा देवइया आतमा डाल दे हवय। यहोवा ह तोर बिनास के हुकूम दे हवय।”<verse eid="1KI 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 22:24"/>तब कनाना के बेटा सिदकियाह ह ऊपर मीकायाह करा गीस अऊ ओकर गाल म थपरा मारके पुछिस, “कते रसता ले आतमा ह यहोवा करा ले गीस, जब ओह तोर ले गोठियाय बर मोर ले निकलके गीस?”<verse eid="1KI 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 22:25"/>मीकायाह ह जबाब दीस, “तोला ओ दिन ये बात के पता चलही, जब तेंह लुकाय बर एक भीतरी कमरा म जाबे।”<verse eid="1KI 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 22:26"/>तब इसरायल के राजा ह हुकूम दीस, “मीकायाह ला ले जावव अऊ ओला सहर के हाकिम आमोन अऊ राजा के बेटा योआस करा वापिस भेज दव <verse eid="1KI 22:26"/><verse number="27" style="v" sid="1KI 22:27"/>अऊ ओमन ले कहव, ‘राजा ह ये कहत हे: ये मनखे ला जेल म डाल दव अऊ जब तक मेंह सही-सलामत वापिस नइं लहुंटंव, तब तक येला रोटी अऊ पानी के छोंड़ अऊ कुछू झन दव।’ ”<verse eid="1KI 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 22:28"/>पर मीकायाह ह घोसना करिस, “यदि तेंह सही-सलामत लहुंटके आ जाबे, त फेर यहोवा ह मोर जरिये बात नइं करे हवय।” तब ओह ये घलो कहिस, “तुमन, जम्मो मनखेमन! मोर बात ला धियान म रखव!”<verse eid="1KI 22:28"/></para>
  <para style="s1">रामोत-गिलाद म अहाब ह मारे जाथे</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 22:29"/>तब इसरायल के राजा अऊ यहूदा के राजा यहोसापात, ऊपर रामोत-गिलाद गीन। <verse eid="1KI 22:29"/><verse number="30" style="v" sid="1KI 22:30"/>इसरायल के राजा ह यहोसापात ला कहिस, “मेंह भेस बदलके लड़ई म जाहूं, पर तें अपन राजसी पहिरावा पहिरबे।” तब इसरायल के राजा ह अपन भेस ला बदल लीस अऊ लड़ई म गीस।<verse eid="1KI 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 22:31"/>अराम के राजा ह अपन रथ के बत्तीस सेनापतिमन ला हुकूम देय रिहिस, “इसरायल के राजा के छोंड़, अऊ कोनो छोटे या बड़े मनखे ले लड़ई झन करहू।” <verse eid="1KI 22:31"/><verse number="32" style="v" sid="1KI 22:32"/>जब रथ के सेनापतिमन यहोसापात ला देखिन, त ओमन सोचिन, “खचित, येह इसरायल के राजा अय।” एकरसेति ओमन ओकर ऊपर हमला करे बर मुड़िन, पर जब यहोसापात ह चिचियाईस, <verse eid="1KI 22:32"/><verse number="33" style="v" sid="1KI 22:33"/>त रथ के सेनापतिमन देखिन कि ओह इसरायल के राजा नो हय, अऊ तब ओमन ओकर पीछा करई छोंड़ दीन।<verse eid="1KI 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 22:34"/>पर कोनो मनखे ह बिगर सोचे-बिचारे अपन तीर ला चला दीस अऊ ओ तीर ह इसरायल के राजा के हथियार के बीच भाग म लगिस। तब राजा ह अपन रथ के सारथी ला कहिस, “मेंह घायल हो गे हवंव। रथ ला एती-ओती ले घुमाके मोला लड़ई ले बाहिर निकाल।” <verse eid="1KI 22:34"/><verse number="35" style="v" sid="1KI 22:35"/>ओ पूरा दिन भयंकर लड़ई होते रिहिस अऊ राजा अहाब ह अपन रथ के सहारा म अरामीमन कोति मुहूं करके ठाढ़े रिहिस। ओकर घाव के खून ह रथ के फर्स म बहत रहय अऊ ओहीच दिन सांझ के बेरा, ओह मर गीस। <verse eid="1KI 22:35"/><verse number="36" style="v" sid="1KI 22:36"/>जब सूरज बुड़त रिहिस, त जम्मो सेना म ये पुकार होईस, “हर एक मनखे अपन-अपन सहर अऊ अपन-अपन देस ला लहुंट जावय!”<verse eid="1KI 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 22:37"/>राजा ह मर गीस, त ओकर लास ला सामरिया म लाय गीस, अऊ उहां ओला माटी दिये गीस। <verse eid="1KI 22:37"/><verse number="38" style="v" sid="1KI 22:38"/>मनखेमन सामरिया म ओ रथ ला धोईन (जिहां बेस्यामन नहावंय), अऊ कुकुरमन ओकर लहू ला चाटिन, जइसने कि यहोवा के बचन के दुवारा कहे गे रिहिस।<verse eid="1KI 22:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 22:39"/>अहाब के सासन के आने घटनामन, ओकर जम्मो काम, जऊन महल ओह बनाईस अऊ हाथी-दांत ले सजाईस, अऊ सहरमन के किलाबंदी करई—ये जम्मो बात इसरायल के राजामन के इतिहास के किताब म लिखाय हवय। <verse eid="1KI 22:39"/><verse number="40" style="v" sid="1KI 22:40"/>अहाब अपन पुरखामन के संग हमेसा बर सुत गीस अऊ ओकर बेटा अहजयाह ओकर जगह म राजा होईस।<verse eid="1KI 22:40"/></para>
  <para style="s1">यहूदा के राजा यहोसापात</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 22:41"/>इसरायल के राजा अहाब के राज के चौथा साल म आसा के बेटा यहोसापात ह यहूदा के राजा बनिस। <verse eid="1KI 22:41"/><verse number="42" style="v" sid="1KI 22:42"/>जब यहोसापात ह राजा बनिस, त ओह पैंतीस साल के रिहिस, अऊ ओह पच्चीस साल तक यरूसलेम म राज करिस। ओकर दाई के नांव अजूबा रिहिस, जऊन ह सिलही के बेटी रिहिस। <verse eid="1KI 22:42"/><verse number="43" style="v" sid="1KI 22:43"/>ओह हर काम म अपन ददा आसा के रसता म चलिस अऊ ओमन ले नइं हटिस; ओह ओही काम करिस, जऊन ह यहोवा के नजर म सही रिहिस। तभो ले, ऊंचहा जगहमन हटाय नइं गीन, अऊ मनखेमन उहां बलिदान चघाय अऊ धूप जलाय के काम करते रिहिन। <verse eid="1KI 22:43"/><verse number="44" style="v" sid="1KI 22:44"/>यहोसापात ह इसरायल के राजा संग सांति घलो बनाय रखिस।<verse eid="1KI 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1KI 22:45"/>यहोसापात के सासन के आने घटनामन, जऊन काम ओह करिस अऊ ओकर सैनिक छमता—ये जम्मो बात यहूदा के राजामन के इतिहास के किताब म लिखाय हवय? <verse eid="1KI 22:45"/><verse number="46" style="v" sid="1KI 22:46"/>ओह मंदिर के ओ पुरूस बेस्यामन ला नास कर दीस, जऊन मन ओकर ददा आसा के सासन के बाद घलो उहां बांच गे रिहिन। <verse eid="1KI 22:46"/><verse number="47" style="v" sid="1KI 22:47"/>तब एदोम म कोनो राजा नइं रिहिस; एक प्रदेस के राजपाल ह राज-काज चलात रिहिस।<verse eid="1KI 22:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="1KI 22:48"/>यहोसापात ह ओपीर जाके सोन लाने बर एक बेपारी जहाजी-बेड़ा बनवाईस, पर ओ जहाजमन कभू नइं जा सकिन—ओमन एसियोन-गेबेर म टूट गीन। <verse eid="1KI 22:48"/><verse number="49" style="v" sid="1KI 22:49"/>ओ बेरा अहाब के बेटा अहजयाह ह यहोसापात ले कहिस, “मोर नाविकमन ला तोर नाविकमन के संग जहाज म जावन दे,” पर यहोसापात ह इनकार करिस।<verse eid="1KI 22:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1KI 22:50"/>तब यहोसापात ह अपन पुरखामन संग हमेसा बर सुत गीस अऊ ओला ओमन के संग, ओकर पुरखा दाऊद के सहर म माटी दिये गीस। अऊ ओकर बेटा यहोराम ओकर जगह म राजा बनिस।<verse eid="1KI 22:50"/></para>
  <para style="s1">इसरायल के राजा अहजयाह</para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 22:51"/>यहूदा के राजा यहोसापात के राज के सतरहवां बछर म, अहाब के बेटा अहजयाह, सामरिया म इसरायल के राजा बनिस, अऊ ओह दू बछर तक इसरायल ऊपर राज करिस। <verse eid="1KI 22:51"/><verse number="52" style="v" sid="1KI 22:52"/>ओह यहोवा के नजर म दुस्ट काम करिस, काबरकि ओह अपन दाई अऊ ददा के रसता म चलिस अऊ नबात के बेटा यरोबाम के रसता म घलो चलिस, जऊन ह इसरायल ले पाप करवाय रिहिस। <verse eid="1KI 22:52"/><verse number="53" style="v" sid="1KI 22:53"/>जइसने ओकर ददा ह करे रिहिस, वइसने अहजयाह ह घलो बाल के सेवा अऊ अराधना करिस अऊ यहोवा, इसरायल के परमेसर के गुस्सा ला भड़काईस।<verse eid="1KI 22:53"/></para>
  <chapter eid="1KI 22"/>
</usx>
