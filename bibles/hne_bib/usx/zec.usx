<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEC" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">जकरयाह</para>
  <para style="toc1">जकरयाह के किताब</para>
  <para style="toc2">जकरयाह</para>
  <para style="toc3">जकर</para>
  <para style="mt1">जकरयाह</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="ZEC 1" />
  <para style="s1">यहोवा करा वापिस लहुंटे बर बुलावा</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 1:1" />राजा दारा के राज के दूसर बछर के आठवां महिना म यहोवा के ये बचन बेरेकियाह के बेटा अऊ इद्दो के पोता जकरयाह अगमजानी करा आईस:<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="EZR 4:24">एज 4:24</ref></char>, <char style="xt"><ref loc="ZEC 5:1">5:1</ref></char> ला</char></note><verse eid="ZEC 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEC 1:2" />“यहोवा ह तोर पुरखामन ले बहुंत कोरोधित रिहिस। <verse eid="ZEC 1:2" /><verse number="3" style="v" sid="ZEC 1:3" />एकरसेति मनखेमन ला बता: सर्वसक्तिमान यहोवा ह ये कहत हे: ‘मोर करा लहुंट आवव,’ सर्वसक्तिमान यहोवा ह घोसना करत हे, ‘त मेंह घलो तुम्हर करा लहुंट आहूं,’ सर्वसक्तिमान यहोवा ह कहत हे। <verse eid="ZEC 1:3" /><verse number="4" style="v" sid="ZEC 1:4" />अपन पुरखामन कस झन बनव, जेमन ला पहिले के अगमजानीमन घोसना करके बताय रिहिन: सर्वसक्तिमान यहोवा ह ये कहत हे: ‘अपन खराप चालचलन अऊ अपन खराप काममन ला छोंड़ देवव।’ पर ओमन न तो मोर बात ला सुनिन अऊ न ही मोर कोति धियान दीन, यहोवा ह घोसना करत हे। <verse eid="ZEC 1:4" /><verse number="5" style="v" sid="ZEC 1:5" />तुम्हर पुरखामन अब कहां हवंय? अऊ अगमजानीमन, का ओमन सदाकाल बर जीयत हवंय? <verse eid="ZEC 1:5" /><verse number="6" style="v" sid="ZEC 1:6" />पर मोर बचन अऊ मोर कानून, जेला मेंह अपन सेवक अगमजानीमन ला दे रहेंव, का ओमन तुम्हर पुरखामन के मिरतू के बाद घलो बने नइं हवंय?</para>
  <para style="p" vid="ZEC 1:6">“तब ओमन पछताप करिन अऊ कहिन, ‘सर्वसक्तिमान यहोवा ह ठीक वइसने ही करे हवय जइसने कि हमर चालचलन अऊ हमर काममन के कारन हमर संग करे जाना चाही, जइसे कि ओह करे के ठाने रिहिस।’ ”<verse eid="ZEC 1:6" /></para>
  <para style="s1">मेंहदी रूखमन के बीच म मनखे</para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 1:7" />राजा दारा के राज के दूसरा साल के गियारहवां महिना याने कि सेबात महिना के चौबीसवां दिन यहोवा के ये बचन बेरेकियाह के बेटा अऊ इद्दो के पोता जकरयाह अगमजानी करा पहुंचिस।<verse eid="ZEC 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 1:8" />रथिया मेंह एक दरसन देखेंव कि मोर आघू म लाल घोड़ा म बईठे एक मनखे रिहिस। ओह घाटी म मेंहदी के रूखमन के बीच म खड़े रिहिस, अऊ ओकर पाछू लाल, भुरवा अऊ सादा रंग के घोड़ामन रिहिन।<verse eid="ZEC 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 1:9" />तब मेंह पुछेंव, “हे मोर परभू, येमन का अंय?”</para>
  <para style="p" vid="ZEC 1:9">जऊन स्वरगदूत ह मोर ले गोठियावत रिहिस, ओह जबाब दीस, “मेंह तोला देखाहूं कि येमन का अंय।”<verse eid="ZEC 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 1:10" />तब जऊन मनखे ह मेंहदी के रूखमन के बीच खड़े रिहिस, ओह कहिस, “येमन ओ अंय, जेमन ला यहोवा ह जम्मो धरती म पठोय हवय।”<verse eid="ZEC 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 1:11" />अऊ ओमन यहोवा के ओ स्वरगदूत ला बताईन जऊन ह मेंहदी के रूखमन के बीच म खड़े रिहिस, “हमन जम्मो धरती म गे रहेंन अऊ देखेंन कि जम्मो धरती म अराम अऊ सांति हवय।”<verse eid="ZEC 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 1:12" />तब यहोवा के स्वरगदूत ह कहिस, “हे सर्वसक्तिमान यहोवा, तेंह यरूसलेम अऊ यहूदा के सहरमन ऊपर पिछले सत्तर साल ले कोरोधित हवस, कब तक तेंह येमन ऊपर दया नइं करबे?” <verse eid="ZEC 1:12" /><verse number="13" style="v" sid="ZEC 1:13" />तब यहोवा ह ओ स्वरगदूत ला, जऊन ह मोर ले गोठियावत रिहिस, दया अऊ सांति के बचन कहिस।<verse eid="ZEC 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 1:14" />तब ओ स्वरगदूत जऊन ह मोर ले गोठियावत रिहिस, ओह कहिस, “ये बातमन के घोसना कर: सर्वसक्तिमान यहोवा ये कहत हे: ‘यरूसलेम अऊ सियोन बर मोर अब्बड़ जलन हवय, <verse eid="ZEC 1:14" /><verse number="15" style="v" sid="ZEC 1:15" />अऊ में ओ जातिमन ले बहुंत कोरोधित हवंव, जऊन मन अराम म हवंय। पहिली मेंह थोरकन कोरोधित रहेंव, पर ओमन खुदे अपन सजा ला बढ़ा ले हवंय।’<verse eid="ZEC 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ZEC 1:16" />“एकरसेति यहोवा ह ये कहत हे: ‘मेंह दया करे बर यरूसलेम लहुंटहूं, अऊ उहां मोर घर ला फेर बनाय जाही। अऊ यरूसलेम के ऊपर नापे के डोरी ला खींचे जाही,’ सर्वसक्तिमान यहोवा ह घोसना करत हे।”<verse eid="ZEC 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ZEC 1:17" />“ये घलो घोसना कर: सर्वसक्तिमान यहोवा ह ये कहत हे: ‘मोर नगरमन फेर उत्तम चीजमन ले भर जाहीं, अऊ यहोवा ह फेर सियोन ला सांति दीही अऊ यरूसलेम ला चुन लीही।’ ”<verse eid="ZEC 1:17" /></para>
  <para style="s1">चार ठन सींग अऊ चार सिल्पकार</para>
  <para style="p">
    <verse number="18" style="v" sid="ZEC 1:18" />तब मेंह देखेंव, अऊ उहां मोर आघू म पसु के चार ठन सींग रिहिन। <verse eid="ZEC 1:18" /><verse number="19" style="v" sid="ZEC 1:19" />त मेंह ओ स्वरगदूत जऊन ह मोर ले गोठियावत रिहिस, ओकर ले पुछेंव, “येमन का अंय?”</para>
  <para style="p" vid="ZEC 1:19">ओह मोला जबाब दीस, “येमन ओ सींग अंय, जेमन यहूदा, इसरायल अऊ यरूसलेम ला तितिर-बितिर कर दे हवंय।”<verse eid="ZEC 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 1:20" />तब यहोवा ह मोला चार सिल्पकारमन ला देखाईस। <verse eid="ZEC 1:20" /><verse number="21" style="v" sid="ZEC 1:21" />त मेंह पुछेंव, “येमन का करे बर आय हवंय?”</para>
  <para style="p" vid="ZEC 1:21">ओह जबाब दीस, “येमन ओ सींग अंय जेमन यहूदा ला तितिर-बितिर कर दे हवंय ताकि कोनो अपन मुड़ झन उठा सकय, पर ये सिल्पकारमन ओमन ला डराय बर अऊ ओ जातिमन के ये सींगमन ला काट डारे बर आय हवंय, जेमन यहूदा देस के बिरोध म ओकर मनखेमन ला तितिर-बितिर करे बर अपन सींग उठाय हवंय।”<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="ZEC 1:18-21">1:18‑21</ref></char> ला 2:1‑4 गने गे हवय</char></note><verse eid="ZEC 1:21" /></para>
  <chapter eid="ZEC 1" />
  <chapter number="2" style="c" sid="ZEC 2" />
  <para style="s1">नापे के डोरी के संग एक मनखे</para>
  <para style="p">
    <note caller="+" style="f">
      <char style="fr" closed="false">2 </char>
      <char style="ft" closed="false">इबरानी म <char style="xt"><ref loc="ZEC 2:1-13">2:1‑13</ref></char> ला 2:5‑17 गने गे हवय</char>
    </note> <verse number="1" style="v" sid="ZEC 2:1" />तब मेंह अपन आघू म एक मनखे ला देखेंव, जऊन ह अपन हांथ म नापे के डोरी ला धरे रिहिस। <verse eid="ZEC 2:1" /><verse number="2" style="v" sid="ZEC 2:2" />तब मेंह ओकर ले पुछेंव, “तेंह कहां जावत हस?”</para>
  <para style="p" vid="ZEC 2:2">ओह मोला जबाब दीस, “मेंह यरूसलेम ला नापे बर जावत हंव ताकि पता चलय कि ओकर लम्बई अऊ चौड़ई कतेक हवय।”<verse eid="ZEC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 2:3" />जब मोर ले बात करइया स्वरगदूत ह जाय लगिस, त एक आने स्वरगदूत ओकर ले मिले बर आईस <verse eid="ZEC 2:3" /><verse number="4" style="v" sid="ZEC 2:4" />अऊ ओकर ले कहिस: “दऊड़के जा अऊ ओ जवान ले कह, ‘मनखे अऊ पसुमन के बहुंतायत के कारन, यरूसलेम ह बिगर दीवार के सहर हो जाही। <verse eid="ZEC 2:4" /><verse number="5" style="v" sid="ZEC 2:5" />अऊ मेंह खुद येकर चारों कोति आगी के दीवार बन जाहूं,’ यहोवा ह घोसना करत हे, ‘अऊ ओकर भीतर म मेंह ओकर महिमा होहूं।’<verse eid="ZEC 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 2:6" />“आवव! आवव! उत्तर के देस ले भाग जावव,” यहोवा ह घोसना करत हे, “काबरकि मेंह तुमन ला अकास के चारों दिग के हवा म तितिर-बितिर कर दे हंव,” यहोवा ह घोसना करत हे।<verse eid="ZEC 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 2:7" />“हे सियोन! आ, तें जऊन ह बेटी बेबिलोन म रहिथस, बचके भाग निकल!” <verse eid="ZEC 2:7" /><verse number="8" style="v" sid="ZEC 2:8" />काबरकि सर्वसक्तिमान यहोवा ह ये कहत हे: “महिमामय परमेसर ह मोला ओ जातिमन के बिरूध म पठोय हवय, जऊन मन तुमन ला लूट ले हवंय—काबरकि जऊन ह तुमन ला छूथे, ओह ओकर<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यहोवा के</char></note> आंखी के पुतली ला छूथे— <verse eid="ZEC 2:8" /><verse number="9" style="v" sid="ZEC 2:9" />मेंह खचित ओमन के बिरूध अपन हांथ उठाहूं ताकि ओमन के गुलाममन ओमन ला लूटंय। तब तुमन जानहू कि सर्वसक्तिमान यहोवा ह मोला पठोय हवय।<verse eid="ZEC 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 2:10" />“हे बेटी सियोन, चिचिया अऊ आनंद मना। काबरकि मेंह आके तोर बीच म निवास करहूं,” यहोवा ह घोसना करत हे। <verse eid="ZEC 2:10" /><verse number="11" style="v" sid="ZEC 2:11" />“ओ दिन बहुंत अकन जातिमन यहोवा के संग मिल जाहीं अऊ मोर मनखे बन जाहीं। मेंह तोर बीच म निवास करहूं अऊ तेंह जान जाबे कि सर्वसक्तिमान यहोवा ह मोला तोर करा पठोय हवय। <verse eid="ZEC 2:11" /><verse number="12" style="v" sid="ZEC 2:12" />यहोवा ह पबितर देस म यहूदा ला अपन भाग के रूप म ले लीही अऊ यरूसलेम ला फेर चुन लीही। <verse eid="ZEC 2:12" /><verse number="13" style="v" sid="ZEC 2:13" />हे जम्मो मनखेमन, यहोवा के आघू म सांत रहव, काबरकि ओह खुद अपन पबितर निवास ले ठाढ़ होय हवय।”<verse eid="ZEC 2:13" /></para>
  <chapter eid="ZEC 2" />
  <chapter number="3" style="c" sid="ZEC 3" />
  <para style="s1">महा पुरोहित बर साफ पहिरावा</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 3:1" />तब ओह मोला देखाईस कि महा पुरोहित यहोसू ह यहोवा के स्वरगदूत के आघू म ठाढ़े हवय, अऊ सैतान<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">सैतान </char><char style="ft" closed="false">सबद के मतलब होथे </char><char style="fqa" closed="false">बईरी</char></note> ह स्वरगदूत के जेवनी कोति यहोसू ऊपर दोस लगाय बर खड़े हवय। <verse eid="ZEC 3:1" /><verse number="2" style="v" sid="ZEC 3:2" />यहोवा ह सैतान ले कहिस, “हे सैतान, यहोवा ह तोला घुड़के! यहोवा, जऊन ह यरूसलेम ला चुन ले हवय, तोला घुड़के! का ये मनखे ह आगी ले निकाले गय बरत लुठी सहीं नो हय?”<verse eid="ZEC 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 3:3" />ओ समय यहोसू ह स्वरगदूत के आघू म मईला कपड़ा पहिरे खड़े रिहिस। <verse eid="ZEC 3:3" /><verse number="4" style="v" sid="ZEC 3:4" />तब स्वरगदूत ह ओमन ले कहिस, जेमन ओकर आघू म खड़े रिहिन, “ओकर मईला कपड़ामन ला उतार दव।”</para>
  <para style="p" vid="ZEC 3:4">तब ओह यहोसू ला कहिस, “देख, मेंह तोर पाप ला दूरिहा कर दे हवंव, अऊ मेंह तोला सुघर कपड़ा पहिराहूं।”<verse eid="ZEC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 3:5" />तब मेंह कहेंव, “ओकर मुड़ ऊपर एक ठन साफ पागा रखव।” त ओमन ओकर मुड़ म एक ठन साफ पागा रखिन अऊ ओला ओनहा पहिराईन, अऊ यहोवा के स्वरगदूत ह ओकर करा ठाढ़े रिहिस।<verse eid="ZEC 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 3:6" />ओकर बाद यहोवा के स्वरगदूत ह यहोसू ला ये जिम्मेदारी दीस: <verse eid="ZEC 3:6" /><verse number="7" style="v" sid="ZEC 3:7" />“सर्वसक्तिमान यहोवा ह ये कहत हे: ‘यदि तेंह मोर हुकूममन ला मानबे अऊ मोर बिधिमन म चलबे, त तेंह मोर भवन ऊपर राज करबे अऊ मोर अंगनामन म तोर अधिकार होही, अऊ मेंह तोला ये मनखेमन के बीच म जगह दूहूं, जऊन मन इहां खड़े हवंय।<verse eid="ZEC 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 3:8" />“ ‘हे महा पुरोहित यहोसू, सुन, तें अऊ तोर आघू म बईठे तोर सहकरमीमन, तुमन जम्मो, अवइया चीजमन के प्रतीक अव: मेंह अपन सेवक, मोर डंगाली ला लानेवाला हंव। <verse eid="ZEC 3:8" /><verse number="9" style="v" sid="ZEC 3:9" />ओ पथरा ला देखव, जेला मेंह यहोसू के आघू म रखे हंव! ओ एके ठन पथरा म सात ठन आंखी हवंय, अऊ मेंह ओमा खोदके एक लेख लिखहूं,’ सर्वसक्तिमान यहोवा ह कहत हे, ‘अऊ मेंह एकेच दिन म ये देस के पाप ला हटा दूहूं।<verse eid="ZEC 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 3:10" />“ ‘ओ दिन, तुमन म ले हर एक झन अपन परोसी ला अपन अंगूर के नार अऊ अंजीर रूख के खाल्हे म बईठे बर बलाहू,’ सर्वसक्तिमान यहोवा ह घोसना करत हे।”<verse eid="ZEC 3:10" /></para>
  <chapter eid="ZEC 3" />
  <chapter number="4" style="c" sid="ZEC 4" />
  <para style="s1">सोन के दीवट अऊ दू ठन जैतून के रूख</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 4:1" />तब ओ स्वरगदूत जऊन ह मोर ले बात करे रिहिस, लहुंट आईस अऊ मोला अइसने जगाईस, जइसने कोनो ला नींद ले जगाय जाथे। <verse eid="ZEC 4:1" /><verse number="2" style="v" sid="ZEC 4:2" />ओह मोर ले पुछिस, “तोला का दिखत हे?”</para>
  <para style="p" vid="ZEC 4:2">मेंह जबाब देंव, “मोला एक ठन सुध सोन के दीवट दिखत हे, जेकर टीप म एक ठन कटोरा हवय, जेमा सात ठन दीया हवंय, अऊ दीयामन ऊपर बाती बर सात-सात ठन नाली हवंय। <verse eid="ZEC 4:2" /><verse number="3" style="v" sid="ZEC 4:3" />दीवट करा दू ठन जैतून के रूख घलो हवंय, एक ठन रूख कटोरा के जेवनी कोति अऊ दूसर रूख ओकर डेरी कोति।”<verse eid="ZEC 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 4:4" />जऊन स्वरगदूत ह मोर ले गोठियावत रिहिस, मेंह ओकर ले पुछेंव, “हे मोर परभू, येमन का अंय?”<verse eid="ZEC 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 4:5" />ओह जबाब दीस, “का तेंह नइं जानस कि येमन का अंय?”</para>
  <para style="p" vid="ZEC 4:5">मेंह कहेंव, “हे मोर परभू, नइं।”<verse eid="ZEC 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 4:6" />त फेर ओह मोला कहिस, “येह जरूब्बाबेल बर यहोवा के बचन अय: ‘न तो बल ले, न सक्ति ले, पर मोर आतमा के दुवारा,’ सर्वसक्तिमान यहोवा ह कहत हे।<verse eid="ZEC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 4:7" />“हे बड़े पहाड़, तेंह का अस? जरूब्बाबेल के आघू म तेंह समतल मैदान बन जाबे। तब ओह चोटी के पथरा ला ये चिचियाय बर ले आही, ‘परमेसर येला आसीस देवय! परमेसर येला आसीस देवय!’ ”<verse eid="ZEC 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 4:8" />तब यहोवा के बचन मोर करा आईस: <verse eid="ZEC 4:8" /><verse number="9" style="v" sid="ZEC 4:9" />“जरूब्बाबेल ह अपन हांथ ले ये मंदिर के नीव डारे हे; अऊ ओकरे हांथमन ये काम ला पूरा घलो करहीं। तब तेंह जान लेबे कि सर्वसक्तिमान यहोवा ह मोला तोर करा पठोय हवय।<verse eid="ZEC 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 4:10" />“छोटे बातमन के दिन ला कोन ह तुछ समझे के हिम्मत करथे, जबकि यहोवा के सात ठन आंखी, जऊन मन धरती के जम्मो कोति देखत रहिथें, आनंद मनाहीं, जब ओमन ये देखहीं कि चुने गय चोटी के पथरा ह जरूब्बाबेल के हांथ म हवय?”<verse eid="ZEC 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 4:11" />तब मेंह स्वरगदूत ले पुछेंव, “ये जैतून के दू ठन रूख के का मतलब अय, जऊन मन दीवट के जेवनी अऊ डेरी कोति हवंय?”<verse eid="ZEC 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 4:12" />मेंह ओकर ले फेर पुछेंव, “जैतून के ये दू ठन डंगालीमन का अंय, जऊन मन सोन के दू ठन ओ नलीमन के बाजू म हवंय जेमन सुनहरा तेल ढारथें?”<verse eid="ZEC 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 4:13" />स्वरगदूत ह जबाब दीस, “का तेंह नइं जानस कि येमन का अंय?”</para>
  <para style="p" vid="ZEC 4:13">मेंह कहेंव, “हे मोर परभू, नइं।”<verse eid="ZEC 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 4:14" />तब ओह कहिस, “ये दूनों ओ अंय, जेमन ला पूरा धरती के परभू के सेवा करे बर अभिसेक करे गे हवय।”<verse eid="ZEC 4:14" /></para>
  <chapter eid="ZEC 4" />
  <chapter number="5" style="c" sid="ZEC 5" />
  <para style="s1">उड़त चामपट्टी</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 5:1" />मेंह फेर देखेंव, अऊ मोर आघू म उड़त एक चामपट्टी रिहिस।<verse eid="ZEC 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEC 5:2" />स्वरगदूत ह मोर ले पुछिस, “तोला का दिखत हे?”</para>
  <para style="p" vid="ZEC 5:2">मेंह जबाब देंव, “मोला उड़त एक चामपट्टी दिखत हवय, जऊन ह बीस क्यूबीट लम्बा अऊ दस क्यूबीट चौड़ा हवय।<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">लगभग 30 फीट लम्बा अऊ 15 फीट चौड़ा</char></note>”<verse eid="ZEC 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 5:3" />तब ओह मोला कहिस, “ये चामपट्टी म ओ सराप लिखे हवय, जऊन ह जम्मो देस ऊपर लगही; काबरकि ये चामपट्टी के एक तरफ जऊन बात लिखे हवय, ओकर मुताबिक हर एक चोर ला निकाल दिये जाही, अऊ ये चामपट्टी के दूसर तरफ जऊन बात लिखे हवय, ओकर मुताबिक हर ओ मनखे जऊन ह लबारी कसम खाथे, ओला घलो निकाल दिये जाही। <verse eid="ZEC 5:3" /><verse number="4" style="v" sid="ZEC 5:4" />सर्वसक्तिमान यहोवा ह घोसना करत हे, ‘मेंह ये सराप ला भेजहूं, अऊ येह हर चोर के घर म अऊ मोर नांव म लबारी कसम खवइया हर मनखे के घर म जाही। येह ओ घर म बने रहिही अऊ ओला ओकर लकरी अऊ पथरामन समेत पूरा नास कर दीही।’ ”<verse eid="ZEC 5:4" /></para>
  <para style="s1">एक ठन टुकनी म माईलोगन</para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 5:5" />तब ओ स्वरगदूत जऊन ह मोर ले गोठियावत रिहिस, आघू आके मोर ले कहे लगिस, “ऊपर देख कि उहां का परगट होवत हे।”<verse eid="ZEC 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 5:6" />मेंह पुछेंव, “येह का अय?”</para>
  <para style="p" vid="ZEC 5:6">ओह जबाब दीस, “येह एक टुकनी अय।” अऊ ओह ये घलो कहिस, “येह पूरा देस के मनखेमन के पाप अय।”<verse eid="ZEC 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 5:7" />तब सीसा के ढकना ला उठाय गीस, अऊ उहां टुकनी म एक माईलोगन बईठे रिहिस! <verse eid="ZEC 5:7" /><verse number="8" style="v" sid="ZEC 5:8" />तब स्वरगदूत ह कहिस, “येह दुस्टता अय,” अऊ ओह ओ माईलोगन ला टुकनी म वापिस ढकेल दीस अऊ सीसा के ढकना ला टुकनी ऊपर ढांप दीस।<verse eid="ZEC 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 5:9" />तब मेंह ऊपर देखेंव—अऊ उहां मोर आघू म दू झन माईलोगन रिहिन, जेमन अपन डेनामन ले हवा म उड़ियात रिहिन! ओमन के डेना ह एक सारस चिरई सहीं रहय, अऊ ओमन ओ टुकनी ला अकास अऊ धरती के बीच म उठा लीन।<verse eid="ZEC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 5:10" />तब ओ स्वरगदूत जऊन ह मोर ले गोठियावत रिहिस, ओकर ले मेंह पुछेंव, “ओमन ओ टुकनी ला कहां ले जावत हें?”<verse eid="ZEC 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 5:11" />ओह जबाब दीस, “बेबिलोनिया<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">सिनार</char></note> देस ला, जिहां ओमन येकर बर एक घर बनाहीं। जब घर ह बन जाही, त टुकनी ला उहां ओकर जगह म रख दिये जाही।”<verse eid="ZEC 5:11" /></para>
  <chapter eid="ZEC 5" />
  <chapter number="6" style="c" sid="ZEC 6" />
  <para style="s1">चार ठन रथ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 6:1" />तब मेंह फेर ऊपर देखेंव, अऊ मोर आघू म चार ठन रथ दू पहाड़मन के बीच म ले निकलके आवत रिहिन, अऊ ये पहाड़मन कांसा धातु के रिहिन। <verse eid="ZEC 6:1" /><verse number="2" style="v" sid="ZEC 6:2" />पहिला रथ म लाल घोड़ा, दूसर म करिया, <verse eid="ZEC 6:2" /><verse number="3" style="v" sid="ZEC 6:3" />तीसर म सफेद अऊ चऊथा म चितकबरा घोड़ामन रिहिन—जम्मो के जम्मो ताकतवर रिहिन। <verse eid="ZEC 6:3" /><verse number="4" style="v" sid="ZEC 6:4" />मोर ले जऊन स्वरगदूत ह गोठियावत रिहिस, ओकर ले मेंह पुछेंव, “हे मोर परभू, येमन का अंय?”<verse eid="ZEC 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 6:5" />स्वरगदूत ह मोला जबाब दीस, “येमन स्वरग के ओ चार आतमा अंय, जऊन मन जम्मो संसार के परभू के आघू म ठाढ़ रहिथें अऊ अब ओकर आघू ले बाहिर जावत हें। <verse eid="ZEC 6:5" /><verse number="6" style="v" sid="ZEC 6:6" />जऊन रथ म करिया रंग के घोड़ामन हवंय, ओह उत्तर दिग के देस ला जावत हे अऊ जऊन म सफेद रंग के घोड़ामन हवंय, ओह पछिम कोति, अऊ जऊन म चितकबरा घोड़ामन हवंय, ओह दक्खिन कोति जावत हे।”<verse eid="ZEC 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 6:7" />जब ये ताकतवर घोड़ामन बाहिर निकलिन, त ओमन जम्मो धरती म जाय बर अधीर होवत रिहिन। अऊ ओह कहिस, “जम्मो धरती म जावव!” एकरसेति ओमन धरती के जम्मो अंग गीन।<verse eid="ZEC 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 6:8" />तब ओह मोला बलाके कहिस, “देख, जऊन मन उत्तर के देस कोति गे हवंय, ओमन उत्तर के देस म मोर आतमा ला सांति दे हवंय।”<verse eid="ZEC 6:8" /></para>
  <para style="s1">यहोसू बर एक मुकुट</para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 6:9" />यहोवा के बचन ह मोर करा आईस: <verse eid="ZEC 6:9" /><verse number="10" style="v" sid="ZEC 6:10" />“बेबिलोन ले बंधुवई ले लहुंटे ये मनखे हेल्दै, तोबियाह अऊ यदायाह ले सोन अऊ चांदी लेय ले अऊ ओहीच दिन सपनयाह के बेटा योसियाह के घर जा। <verse eid="ZEC 6:10" /><verse number="11" style="v" sid="ZEC 6:11" />सोन अऊ चांदी ला लेके एक मुकुट बना, अऊ ओ मुकुट ला योसादाक के बेटा महा पुरोहित यहोसू के मुड़ म रख। <verse eid="ZEC 6:11" /><verse number="12" style="v" sid="ZEC 6:12" />ओला बता कि सर्वसक्तिमान यहोवा ह ये कहत हे: ‘येह ओ मनखे ए, जेकर नांव डंगाली अय, अऊ ओह अपन ही जगह ले डंगाली निकालके यहोवा के मंदिर ला बनाही।<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="ISA 4:2">यसा 4:2</ref></char></char></note> <verse eid="ZEC 6:12" /><verse number="13" style="v" sid="ZEC 6:13" />येह ओ अय, जऊन ह यहोवा के मंदिर ला बनाही, अऊ ओला महिमा दिये जाही अऊ अपन सिंघासन म बईठके राज करही। अऊ ओह<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">उहां</char></note> अपन सिंघासन म एक पुरोहित होही अऊ ओ दूनों के बीच आपस म समझ-बुझ होही।’ <verse eid="ZEC 6:13" /><verse number="14" style="v" sid="ZEC 6:14" />यहोवा के मंदिर म मुकुट ला यादगारी के एक चिनहां के रूप म हेल्दै,<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">हेलेम</char></note> तोबियाह, यदायाह अऊ सपनयाह के बेटा हेन<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अनुग्रहकारी मनखे</char></note> ला दिये जाही। <verse eid="ZEC 6:14" /><verse number="15" style="v" sid="ZEC 6:15" />जेमन दूरिहा म हवंय, ओमन आहीं अऊ यहोवा के मंदिर बनाय म मदद करहीं, अऊ तेंह जानबे कि सर्वसक्तिमान यहोवा ह मोला तोर करा पठोय हवय। अऊ येह तभे होही, जब तेंह यहोवा अपन परमेसर के हुकूममन ला मन लगाके मानबे।”<verse eid="ZEC 6:15" /></para>
  <chapter eid="ZEC 6" />
  <chapter number="7" style="c" sid="ZEC 7" />
  <para style="s1">नियाय अऊ दया, उपास नइं</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 7:1" />दारा राजा के राज के चऊथा साल के नवां महिना याने कि किसलेव महिना के चऊथा दिन यहोवा के ये बचन जकरयाह करा आईस। <verse eid="ZEC 7:1" /><verse number="2" style="v" sid="ZEC 7:2" />बेतेल के मनखेमन यहोवा ले बिनती करे बर अऊ ये पुछे बर सरेसेर अऊ रेगेम-मेलेक अऊ ओमन के संगीमन ला <verse eid="ZEC 7:2" /><verse number="3" style="v" sid="ZEC 7:3" />सर्वसक्तिमान यहोवा के घर के पुरोहित अऊ अगमजानीमन करा पठोईन, “का हमन पांचवां महिना म सोक अऊ उपास करन, जइसने कि हमन कतको साल ले करत आवत हन?”<verse eid="ZEC 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 7:4" />तब सर्वसक्तिमान यहोवा के ये बचन मोर करा आईस: <verse eid="ZEC 7:4" /><verse number="5" style="v" sid="ZEC 7:5" />“देस के जम्मो मनखे अऊ पुरोहितमन ले पुछ, ‘जब तुमन पांचवां अऊ सातवां महिना म पिछले सत्तर साल तक उपास अऊ बिलाप करत रहेव, त का सही म तुमन मोर बर ही उपास करेव? <verse eid="ZEC 7:5" /><verse number="6" style="v" sid="ZEC 7:6" />अऊ जब तुमन खावत-पीयत रहेव, त का ये सब सिरिप अपन खाय-पीये बर नइं करत रहेव? <verse eid="ZEC 7:6" /><verse number="7" style="v" sid="ZEC 7:7" />का येमन यहोवा के बचन नो हंय, जेकर घोसना ओह पहिले के अगमजानीमन के जरिये करे रिहिस, जब यरूसलेम अऊ ओकर आसपास के नगरमन सांति म रिहिन अऊ उन्नत रिहिन, अऊ नेगेव<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">दक्खिन के इलाका</char></note> अऊ पछिम के खाल्हे के देसमन बस गे रिहिन?’ ”<verse eid="ZEC 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 7:8" />अऊ यहोवा के ये बचन ह जकरयाह करा फेर आईस: <verse eid="ZEC 7:8" /><verse number="9" style="v" sid="ZEC 7:9" />“सर्वसक्तिमान यहोवा ह ये कहिस: ‘सही के नियाय करव; एक-दूसर के ऊपर दया देखावव अऊ तरस खावव। <verse eid="ZEC 7:9" /><verse number="10" style="v" sid="ZEC 7:10" />बिधवा या अनाथ, परदेसी या गरीब ऊपर अतियाचार झन करव। एक-दूसर के बिरूध सडयंत्र झन करव।’<verse eid="ZEC 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 7:11" />“पर ओमन ये बात ऊपर कोनो धियान नइं दीन; ढीठ होके ओमन अपन मुहूं फेर लीन अऊ अपन कानमन ला बंद कर लीन। <verse eid="ZEC 7:11" /><verse number="12" style="v" sid="ZEC 7:12" />ओमन अपन हिरदय ला चकमक पथरा सहीं कठोर बना लीन अऊ कानून के बात या सर्वसक्तिमान यहोवा के ओ बचन ला नइं सुनिन, जेला ओह अपन आतमा के दुवारा पहिले के अगमजानीमन के जरिये पठोय रिहिस। एकरसेति सर्वसक्तिमान यहोवा बहुंत गुस्सा होईस।<verse eid="ZEC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 7:13" />“ ‘जब मेंह पुकारेंव, त ओमन नइं सुनिन; एकरसेति जब ओमन मोला पुकारहीं, त मेंह घलो ओमन के नइं सुनंव,’ सर्वसक्तिमान यहोवा ह कहत हे। <verse eid="ZEC 7:13" /><verse number="14" style="v" sid="ZEC 7:14" />‘मेंह एक बवंडर ले ओमन ला जाति-जाति के मनखेमन के बीच म तितिर-बितिर कर देंव, जिहां ओमन अजनबी रिहिन। जऊन देस ला ओमन अपन पाछू छोंड़ आईन, ओह अइसे उजाड़ पड़े रिहिस कि ओमा ले होके कोनो नइं जावंय। ये किसम ले ओमन ओ खुसहाल देस ला उजाड़ दीन।’ ”<verse eid="ZEC 7:14" /></para>
  <chapter eid="ZEC 7" />
  <chapter number="8" style="c" sid="ZEC 8" />
  <para style="s1">यहोवा ह यरूसलेम ला आसीस देय के वायदा करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 8:1" />सर्वसक्तिमान यहोवा के बचन ह मोर करा आईस।<verse eid="ZEC 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEC 8:2" />सर्वसक्तिमान यहोवा ह ये कहत हे: “सियोन बर मोला अब्बड़ जलन होवत हे; मेंह ओकर बर जलन ले जरत हंव।”<verse eid="ZEC 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 8:3" />यहोवा ह ये कहत हे: “मेंह वापिस सियोन जाहूं अऊ यरूसलेम म निवास करहूं। तब यरूसलेम ला बिसवासयोग्य सहर कहे जाही, अऊ सर्वसक्तिमान यहोवा के पहाड़ ला पबितर पहाड़ कहे जाही।”<verse eid="ZEC 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 8:4" />सर्वसक्तिमान यहोवा ह ये कहत हे: “एक बार फेर यरूसलेम के गलीमन म डोकरा अऊ डोकरीमन बईठहीं अऊ बहुंत उमर होय के कारन हर एक के हांथ म लउठी होही। <verse eid="ZEC 8:4" /><verse number="5" style="v" sid="ZEC 8:5" />सहर के गलीमन उहां खेलत बाबू-नोनीमन ले भरे होहीं।”<verse eid="ZEC 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 8:6" />सर्वसक्तिमान यहोवा ह ये कहत हे: “ओ समय मनखेमन के बांचेमन ला ये अद्भूत लग सकथे, पर का येह मोला अद्भूत लगही?” सर्वसक्तिमान यहोवा ह घोसना करत हे।<verse eid="ZEC 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 8:7" />सर्वसक्तिमान यहोवा ह ये कहत हे: “मेंह अपन मनखेमन ला पूरब अऊ पछिम के देसमन ले बचाहूं। <verse eid="ZEC 8:7" /><verse number="8" style="v" sid="ZEC 8:8" />मेंह ओमन ला यरूसलेम म रहे बर वापिस ले आहूं; ओमन मोर मनखे होहीं, अऊ मेंह ओमन के परमेसर के रूप म ओमन बर बिसवासयोग्य अऊ धरमी ठहिरहूं।”<verse eid="ZEC 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 8:9" />सर्वसक्तिमान यहोवा ह ये कहत हे: “अब तुमन ये बात ला सुनव, ‘तुम्हर हांथमन मजबूत रहंय ताकि मंदिर ला बनाय जा सकय।’ ये बात ओ अगमजानीमन के दुवारा घलो कहे गे हवय, जऊन मन सर्वसक्तिमान यहोवा के घर के नीव डाले के बेरा उहां रिहिन। <verse eid="ZEC 8:9" /><verse number="10" style="v" sid="ZEC 8:10" />ओ समय के पहिले न तो मनखेमन ला बनी मिलत रिहिस अऊ न ही पसुमन बर भाड़ा। अपन बईरीमन के कारन, कोनो घलो अपन काम-धंधा म सांत मन से नइं जाय सकत रिहिन, काबरकि मेंह ओमन ला एक-दूसर के बिरूध कर दे रहेंव। <verse eid="ZEC 8:10" /><verse number="11" style="v" sid="ZEC 8:11" />पर अब मेंह येमन के बांचे मनखेमन ले वइसने बरताव नइं करंव, जइसने कि पहिले करत रहेंव,” सर्वसक्तिमान यहोवा ह घोसना करत हे।<verse eid="ZEC 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 8:12" />“बीजा ह बने ढंग ले बढ़ही, अंगूर के नार म फर लगही, भुइयां म फसल होही, अऊ अकास ले ओस<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बारिस</char></note> पड़ही। मेंह ये जम्मो चीज येमन के बांचे मनखेमन ला एक उत्तराधिकार के रूप म दूहूं। <verse eid="ZEC 8:12" /><verse number="13" style="v" sid="ZEC 8:13" />जइसे कि हे यहूदा अऊ इसरायल, तुमन जाति-जाति के मनखेमन के बीच एक सराप बन गे हवव, त मेंह तुमन ला बचाहूं, अऊ तुमन एक आसीस के कारन बनहू। झन डरव, पर तुम्हर हांथ मजबूत बने रहय।”<verse eid="ZEC 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 8:14" />सर्वसक्तिमान यहोवा ह ये कहत हे: “जब तुम्हर पुरखामन मोला कोरोधित करे रिहिन, त जइसने मेंह तुम्हर ऊपर बिपत्ति लाने अऊ दया नइं करे बर ठान ले रहेंव,” सर्वसक्तिमान यहोवा ह कहत हे, <verse eid="ZEC 8:14" /><verse number="15" style="v" sid="ZEC 8:15" />“वइसने ही अब मेंह यरूसलेम अऊ यहूदा ऊपर फेर भलई करे बर ठान ले हवंव। झन डरव। <verse eid="ZEC 8:15" /><verse number="16" style="v" sid="ZEC 8:16" />येमन ओ बात अंय, जेला तुमन ला करना हे: एक-दूसर के संग सच बोलव, अऊ अपन अदालतमन म सच अऊ सही निरनय लेय करव; <verse eid="ZEC 8:16" /><verse number="17" style="v" sid="ZEC 8:17" />एक-दूसर के बिरूध दुस्ट चाल झन चलव, अऊ लबरा कसम झन खावव। काबरकि मेंह ये जम्मो बात ले घिन करथंव,” यहोवा ह घोसना करत हे।<verse eid="ZEC 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ZEC 8:18" />सर्वसक्तिमान यहोवा के ये बचन ह मोर करा आईस।<verse eid="ZEC 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ZEC 8:19" />सर्वसक्तिमान यहोवा ह ये कहत हे: “चऊथा, पांचवां, सातवां अऊ दसवां महिना के उपास ह यहूदा के मनखेमन बर आनंद अऊ खुसी के समय अऊ खुसी के तिहार हो जाही। एकरसेति सच अऊ सांति ले मया करव।”<verse eid="ZEC 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 8:20" />सर्वसक्तिमान यहोवा ह ये कहत हे: “बहुंते मनखे अऊ कतको सहरमन के रहइयामन आहीं, <verse eid="ZEC 8:20" /><verse number="21" style="v" sid="ZEC 8:21" />अऊ एक सहर के रहइयामन दूसर सहर म जाके कहिहीं, ‘आवव, यहोवा ले बिनती करे बर तुरते चलन अऊ सर्वसक्तिमान यहोवा के खोज करन। मेंह खुद जावत हंव।’ <verse eid="ZEC 8:21" /><verse number="22" style="v" sid="ZEC 8:22" />अऊ बहुंते मनखे अऊ सक्तिसाली जातिमन के मनखेमन सर्वसक्तिमान यहोवा ला खोजे अऊ ओकर ले बिनती करे बर यरूसलेम आहीं।”<verse eid="ZEC 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ZEC 8:23" />सर्वसक्तिमान यहोवा ह ये कहत हे: “ओ दिनमन म जम्मो भासा अऊ जातिमन ले दस मनखेमन एक यहूदी मनखे ला ओकर कपड़ा के छोर ला पकड़के कहिहीं, ‘हमन तोर संग जाबो, काबरकि हमन ये सुने हन कि परमेसर ह तोर संग हवय।’ ”<verse eid="ZEC 8:23" /></para>
  <chapter eid="ZEC 8" />
  <chapter number="9" style="c" sid="ZEC 9" />
  <para style="s1">इसरायल के बईरीमन ला दंड</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 9:1" />एक अगमबानी:</para>
  <para style="q1" vid="ZEC 9:1">हद्राक देस के बिरूध यहोवा के ये बचन अय</para>
  <para style="q2" vid="ZEC 9:1">अऊ येकर परभाव दमिस्क सहर ऊपर पड़ही—</para>
  <para style="q1" vid="ZEC 9:1">काबरकि जम्मो मनखे अऊ इसरायल के जम्मो गोत्र के नजर</para>
  <para style="q2" vid="ZEC 9:1">यहोवा ऊपर हवय—<verse eid="ZEC 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEC 9:2" />अऊ येकर सीमना ले लगे देस हमात ऊपर लगे हवय,</para>
  <para style="q2" vid="ZEC 9:2">अऊ सूर अऊ सीदोन ऊपर घलो लगे हवय, हालाकि ओमन बहुंत जानकार अंय।<verse eid="ZEC 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEC 9:3" />सूर ह अपन बर एक मजबूत गढ़ बनाय हवय;</para>
  <para style="q2" vid="ZEC 9:3">ओह चांदी ला धुर्रा सहीं,</para>
  <para style="q2" vid="ZEC 9:3">अऊ सोन ला गली के चीखला सहीं कुढ़ोय हवय।<verse eid="ZEC 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEC 9:4" />पर परभू ह ओकर जम्मो चीजमन ला ले लीही</para>
  <para style="q2" vid="ZEC 9:4">अऊ ओकर सक्ति ला समुंदर म नास कर दीही,</para>
  <para style="q2" vid="ZEC 9:4">अऊ सहर ह आगी म जलके नास हो जाही।<verse eid="ZEC 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEC 9:5" />अस्कलोन सहर ह येला देखके डरही;</para>
  <para style="q2" vid="ZEC 9:5">गाजा सहर ह बहुंत तकलीफ म पड़के छटपटाही,</para>
  <para style="q2" vid="ZEC 9:5">अऊ एहीच हालत एकरोन सहर के घलो होही, काबरकि ओकर आसा ह खतम हो जाही।</para>
  <para style="q1" vid="ZEC 9:5">गाजा ह अपन राजा ला गंवा दीही</para>
  <para style="q2" vid="ZEC 9:5">अऊ अस्कलोन ला तियाग दिये जाही।<verse eid="ZEC 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEC 9:6" />एक दोगला जाति के मनखेमन असदोद सहर ऊपर अधिकार कर लीहीं,</para>
  <para style="q2" vid="ZEC 9:6">अऊ मेंह पलिस्तीमन के घमंड ला टोर दूहूं।<verse eid="ZEC 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEC 9:7" />मेंह ओमन के मुहूं ले खून,</para>
  <para style="q2" vid="ZEC 9:7">अऊ ओमन के दांतमन के बीच म छोंड़े गय जेवन ला ले लूहूं।</para>
  <para style="q1" vid="ZEC 9:7">तब ओमन, जऊन मन बच जाहीं, ओमन हमर परमेसर के हो जाहीं</para>
  <para style="q2" vid="ZEC 9:7">अऊ यहूदा म एक गोत्र बन जाहीं,</para>
  <para style="q2" vid="ZEC 9:7">अऊ एकरोन ह यबूसीमन सहीं हो जाही।<verse eid="ZEC 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEC 9:8" />पर मेंह अपन मंदिर ला लुटेरामन ले बचाय बर</para>
  <para style="q2" vid="ZEC 9:8">ओकर पहरेदारी म डेरा डालहूं।</para>
  <para style="q1" vid="ZEC 9:8">कोनो घलो अतियाचारी फेर कभू मोर मनखेमन ऊपर अधिकार नइं कर सकहीं,</para>
  <para style="q2" vid="ZEC 9:8">काबरकि अब मेंह पहरेदारी करत हंव।<verse eid="ZEC 9:8" /></para>
  <para style="s1">सियोन के राजा के अवई</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEC 9:9" />हे बेटी सियोन, बहुंत आनंद मना!</para>
  <para style="q2" vid="ZEC 9:9">हे बेटी यरूसलेम, जय-जयकार कर!</para>
  <para style="q1" vid="ZEC 9:9">देखव, तुम्हर राजा ह तुम्हर करा आवत हे,</para>
  <para style="q2" vid="ZEC 9:9">ओह धरमी अऊ बिजयी होके,</para>
  <para style="q1" vid="ZEC 9:9">बिनम्र अऊ एक गदहा ऊपर,</para>
  <para style="q2" vid="ZEC 9:9">एक बछेड़ा ऊपर, गदही के एक बछेड़ा ऊपर सवारी करे हवय।<verse eid="ZEC 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEC 9:10" />मेंह एपरैम ले रथमन ला</para>
  <para style="q2" vid="ZEC 9:10">अऊ यरूसलेम ले लड़ई के घोड़ामन ला ले लूहूं,</para>
  <para style="q2" vid="ZEC 9:10">अऊ लड़ई के धनुसमन ला टोर दिये जाही।</para>
  <para style="q1" vid="ZEC 9:10">तब ओह जाति-जाति के मनखेमन के बीच म सांति के घोसना करही।</para>
  <para style="q2" vid="ZEC 9:10">ओकर राज ह एक समुंदर ले लेके दूसर समुंदर तक</para>
  <para style="q2" vid="ZEC 9:10">अऊ नदी<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">फरात नदी</char></note> ले लेके धरती के छोर तक बगरही।<verse eid="ZEC 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEC 9:11" />जहां तक तुम्हर बात अय, तुम्हर संग मोर करार के लहू के कारन,</para>
  <para style="q2" vid="ZEC 9:11">मेंह तुम्हर कैदीमन ला ओ सूखा खंचवा ले बाहिर निकाल दूहूं।<verse eid="ZEC 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEC 9:12" />हे आसा लगाय कैदीमन, अपन गढ़ म लहुंट आवव;</para>
  <para style="q2" vid="ZEC 9:12">अभी घलो मेंह घोसना करत हंव कि मेंह तुमन ला दू गुना लहुंटा दूहूं।<verse eid="ZEC 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEC 9:13" />मेंह यहूदा ला अपन धनुस सहीं मोड़हूं</para>
  <para style="q2" vid="ZEC 9:13">अऊ एपरैम ले येला भर दूहूं।</para>
  <para style="q1" vid="ZEC 9:13">हे सियोन, मेंह तोर बेटामन ला</para>
  <para style="q2" vid="ZEC 9:13">यूनान के बेटामन के बिरूध भड़काहूं,</para>
  <para style="q2" vid="ZEC 9:13">अऊ तोला योद्धा के तलवार सहीं कर दूहूं।<verse eid="ZEC 9:13" /></para>
  <para style="s1">यहोवा परगट होही</para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEC 9:14" />तब यहोवा ह ओमन ऊपर परगट होही;</para>
  <para style="q2" vid="ZEC 9:14">अऊ ओकर तीर ह बिजली सहीं चमकही।</para>
  <para style="q1" vid="ZEC 9:14">परमपरधान यहोवा ह तुरही फूंकही;</para>
  <para style="q2" vid="ZEC 9:14">ओह दक्खिन के आंधी म होके चलही,<verse eid="ZEC 9:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="ZEC 9:15" />अऊ सर्वसक्तिमान यहोवा ओमन के रकछा करही।</para>
  <para style="q1" vid="ZEC 9:15">ओमन नास कर दीहीं</para>
  <para style="q2" vid="ZEC 9:15">अऊ गोफन के पथरामन के दुवारा जयवंत होहीं।</para>
  <para style="q1" vid="ZEC 9:15">ओमन पीहीं अऊ अइसने हल्ला करहीं जइसने मनखे मंद पीके करथें;</para>
  <para style="q2" vid="ZEC 9:15">ओमन ओ कटोरा सहीं भर जाहीं</para>
  <para style="q2" vid="ZEC 9:15">जेकर उपयोग बेदी के कोनटामन म छिंचे बर करे जाथे।<verse eid="ZEC 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEC 9:16" />जइसन एक चरवाहा ह अपन झुंड ला बचाथे</para>
  <para style="q2" vid="ZEC 9:16">वइसन ही यहोवा ओमन के परमेसर ह ओ दिन अपन मनखेमन ला बचाही।</para>
  <para style="q1" vid="ZEC 9:16">ओमन ओकर देस म अइसने चमकहीं</para>
  <para style="q2" vid="ZEC 9:16">जइसने मुकुट म लगे रत्नमन चमकथें।<verse eid="ZEC 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEC 9:17" />कतेक जादा मन ला भानेवाला अऊ सुघर होहीं ओमन!</para>
  <para style="q2" vid="ZEC 9:17">जवान छोकरामन अनाज खाके,</para>
  <para style="q2" vid="ZEC 9:17">अऊ मुटियारी छोकरीमन नवां अंगूर के मंद पीके मजबूत हो जाहीं।<verse eid="ZEC 9:17" /></para>
  <chapter eid="ZEC 9" />
  <chapter number="10" style="c" sid="ZEC 10" />
  <para style="s1">यहोवा ह यहूदा के देखरेख करही</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEC 10:1" />यहोवा ले बिनती करव कि ओह बसन्त रितु म बारिस पठोवय;</para>
  <para style="q2" vid="ZEC 10:1">येह यहोवा ही अय, जऊन ह बादर गरजाथे अऊ गरेर लाथे।</para>
  <para style="q1" vid="ZEC 10:1">ओह जम्मो मनखे ला बारिस देथे,</para>
  <para style="q2" vid="ZEC 10:1">अऊ हर एक झन बर खेत म पऊधा उपजाथे।<verse eid="ZEC 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEC 10:2" />मूरतीमन धोखा देवइया बात कहिथें,</para>
  <para style="q2" vid="ZEC 10:2">अऊ सकुन-बिचार करइयामन लबारी दरसन देखथें;</para>
  <para style="q1" vid="ZEC 10:2">ओमन लबारी सपना के बारे म बताथें,</para>
  <para style="q2" vid="ZEC 10:2">अऊ ओमन बेकार म सांतवना देथें।</para>
  <para style="q1" vid="ZEC 10:2">एकरसेति चरवाहा के कमी के कारन दुखी होके</para>
  <para style="q2" vid="ZEC 10:2">मनखेमन भेड़ सहीं भटकथें।<verse eid="ZEC 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ZEC 10:3" />“मोर कोरोध ह चरवाहामन ऊपर भड़कथे,</para>
  <para style="q2" vid="ZEC 10:3">अऊ मेंह अगुवामन ला दंड दूहूं;</para>
  <para style="q1" vid="ZEC 10:3">काबरकि सर्वसक्तिमान यहोवा ह अपन झुंड</para>
  <para style="q2" vid="ZEC 10:3">यहूदा के मनखेमन के देखरेख करही,</para>
  <para style="q2" vid="ZEC 10:3">अऊ ओह ओमन ला लड़ई म घमंड करइया घोड़ा सहीं बनाही।<verse eid="ZEC 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEC 10:4" />यहूदा ले कोना के पथरा आही,</para>
  <para style="q2" vid="ZEC 10:4">ओकर ले तम्बू के खूंटी,</para>
  <para style="q1" vid="ZEC 10:4">ओकर ले लड़ई के धनुस,</para>
  <para style="q2" vid="ZEC 10:4">अऊ ओकर ले ही हर एक सासन करइया आहीं।<verse eid="ZEC 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEC 10:5" />ओमन एक संग लड़ई म ओ योद्धामन सहीं होहीं,</para>
  <para style="q2" vid="ZEC 10:5">जऊन मन गली के चीखला म अपन बईरीमन ला गोड़ ले कुचरथें।</para>
  <para style="q1" vid="ZEC 10:5">ओमन लड़हीं काबरकि यहोवा ओमन के संग हवय,</para>
  <para style="q2" vid="ZEC 10:5">अऊ ओमन बईरीमन के घुड़सवारमन ला सरमिंदा करहीं।<verse eid="ZEC 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ZEC 10:6" />“मेंह यहूदा के मनखेमन ला मजबूत करहूं</para>
  <para style="q2" vid="ZEC 10:6">अऊ यूसुफ के गोत्र ला बचाहूं।</para>
  <para style="q1" vid="ZEC 10:6">ओमन बर अपन करूना के कारन</para>
  <para style="q2" vid="ZEC 10:6">मेंह ओमन ला पहिले के सहीं बने स्थिति म ले आहूं।</para>
  <para style="q1" vid="ZEC 10:6">ओमन अइसे हो जाहीं</para>
  <para style="q2" vid="ZEC 10:6">मानो मेंह ओमन ला कभू तियागे ही नइं रहेंव,</para>
  <para style="q1" vid="ZEC 10:6">काबरकि मेंह ओमन के परमेसर यहोवा अंव</para>
  <para style="q2" vid="ZEC 10:6">अऊ मेंह ओमन ला जबाब दूहूं।<verse eid="ZEC 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEC 10:7" />एपरैमीमन योद्धा सहीं हो जाहीं,</para>
  <para style="q2" vid="ZEC 10:7">अऊ ओमन के मन ह अइसे खुस होही, जइसे मंद पीये ले होथे।</para>
  <para style="q1" vid="ZEC 10:7">ओमन के लइकामन येला देखके आनंदित होहीं;</para>
  <para style="q2" vid="ZEC 10:7">अऊ ओमन के मन ह यहोवा म आनंदित होही।<verse eid="ZEC 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEC 10:8" />मेंह ओमन ला इसारा करहूं</para>
  <para style="q2" vid="ZEC 10:8">अऊ भीतर इकट्ठा करहूं।</para>
  <para style="q1" vid="ZEC 10:8">खचित मेंह ओमन ला छोंड़ाहूं;</para>
  <para style="q2" vid="ZEC 10:8">ओमन पहिली सहीं अनगिनत हो जाहीं।<verse eid="ZEC 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEC 10:9" />हालाकि मेंह ओमन ला मनखेमन के बीच म तितिर-बितिर कर दे हंव,</para>
  <para style="q2" vid="ZEC 10:9">तभो ले ओ दूरिहा के देसमन म ओमन मोला सुरता करहीं।</para>
  <para style="q1" vid="ZEC 10:9">उहां ओमन अऊ ओमन के संतान बांचे रहिहीं,</para>
  <para style="q2" vid="ZEC 10:9">अऊ ओमन लहुंट आहीं।<verse eid="ZEC 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEC 10:10" />मेंह ओमन ला मिसर देस ले वापिस लहुंटा लाहूं</para>
  <para style="q2" vid="ZEC 10:10">अऊ ओमन ला अस्सूर देस ले इकट्ठा करहूं।</para>
  <para style="q1" vid="ZEC 10:10">मेंह ओमन ला गिलाद अऊ लबानोन के इलाका म ले आहूं,</para>
  <para style="q2" vid="ZEC 10:10">अऊ ओमन ला अतेक बढ़ाहूं कि उहां ओमन बर परयाप्त जगह नइं होही।<verse eid="ZEC 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEC 10:11" />ओमन समस्या के समुंदर म ले होके जाहीं,</para>
  <para style="q2" vid="ZEC 10:11">उमड़त समुंदर ला सांत कर दिये जाही</para>
  <para style="q2" vid="ZEC 10:11">अऊ नील नदी के जम्मो गहिरा पानी ह सूखा जाही।</para>
  <para style="q1" vid="ZEC 10:11">अस्सूर देस के मनखेमन के घमंड ला टोर दिये जाही</para>
  <para style="q2" vid="ZEC 10:11">अऊ मिसर देस के राजदंड ह चले जाही।<verse eid="ZEC 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEC 10:12" />मेंह ओमन के बिसवास ला यहोवा ऊपर मजबूत करहूं</para>
  <para style="q2" vid="ZEC 10:12">अऊ ओकर नांव म ओमन सुरकछित रहिहीं,”</para>
  <para style="q2" vid="ZEC 10:12">यहोवा ह घोसना करत हे।<verse eid="ZEC 10:12" /></para>
  <para style="b" />
  <chapter eid="ZEC 10" />
  <chapter number="11" style="c" sid="ZEC 11" />
  <para style="q1">
    <verse number="1" style="v" sid="ZEC 11:1" />हे लबानोन, अपन कपाटमन ला खोल,</para>
  <para style="q2" vid="ZEC 11:1">ताकि आगी ह तोर देवदार के रूखमन ला नास कर देवय!<verse eid="ZEC 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEC 11:2" />हे सनोवर के रूखमन, बिलाप करव, काबरकि देवदार के रूख ह गिर गे हवय;</para>
  <para style="q2" vid="ZEC 11:2">सानदार रूखमन नास हो गे हवंय!</para>
  <para style="q1" vid="ZEC 11:2">हे बासान के बलूत रूखमन, बिलाप करव;</para>
  <para style="q2" vid="ZEC 11:2">काबरकि घना जंगल ला काट डारे गे हवय!<verse eid="ZEC 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEC 11:3" />चरवाहामन के बिलाप ला सुनव;</para>
  <para style="q2" vid="ZEC 11:3">ओमन के हरियर चरागनमन नास हो गे हवंय!</para>
  <para style="q1" vid="ZEC 11:3">सिंहमन के गरजई ला सुनव;</para>
  <para style="q2" vid="ZEC 11:3">यरदन नदी के रसवाला झाड़ीमन नास हो गीन!<verse eid="ZEC 11:3" /></para>
  <para style="s1">दू झन चरवाहा</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 11:4" />यहोवा, मोर परमेसर ह ये कहत हे: “काटे बर चिनहां करे गे पसुमन के झुंड के रखवारी करव। <verse eid="ZEC 11:4" /><verse number="5" style="v" sid="ZEC 11:5" />ओमन ला बिसोईयामन काटथें अऊ ओमन ला कोनो सजा नइं मिलय। जऊन मन ओमन ला बेचथें, ओमन कहिथें, ‘यहोवा के इस्तुति होवय, मेंह धनी हो गे हंव!’ ओमन के खुद के चरवाहामन ओमन ऊपर दया नइं करंय। <verse eid="ZEC 11:5" /><verse number="6" style="v" sid="ZEC 11:6" />मेंह अब ये देस के मनखेमन ऊपर दया नइं करंव,” यहोवा ह घोसना करत हे। “मेंह हर एक ला ओमन के परोसी अऊ ओमन के राजा के बस म कर दूहूं। ओमन ये देस ला नास कर दीहीं, अऊ मेंह कोनो ला ओमन के हांथ ले नइं बचावंव।”<verse eid="ZEC 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 11:7" />एकरसेति मेंह काटे बर चिनहां करे गे पसुमन के झुंड के रखवारी करेंव, खास करके झुंड के ओ पसुमन के जेमन ऊपर अतियाचार करे जावत रिहिस। तब मेंह दू ठन लउठी लेंव अऊ ओमा ले एक ठन के नांव अनुग्रह अऊ दूसर के नांव एकता रखेंव, अऊ में झुंड के देखरेख करे लगेंव। <verse eid="ZEC 11:7" /><verse number="8" style="v" sid="ZEC 11:8" />ओकर बाद मेंह एक महिना म ही तीन झन चरवाहामन ला काम ले हटा देंव।</para>
  <para style="p" vid="ZEC 11:8">ओ झुंड ह मोर ले बहुंत घिन करे लगिस, अऊ मेंह ओमन ले असकटा गेंव <verse eid="ZEC 11:8" /><verse number="9" style="v" sid="ZEC 11:9" />अऊ कहेंव, “मेंह अब तुम्हर चरवाहा नइं रहंव। जऊन मन मरत हें ओमन मरंय, अऊ जऊन मन नास होवत हें ओमन नास होवंय, अऊ जऊन मन बच जाथें ओमन एक-दूसर के मांस खावंय।”<verse eid="ZEC 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 11:10" />तब ओ करार जेला मेंह जम्मो जाति के मनखेमन के संग बांधे रहेंव, ओला टोरत मेंह अपन अनुग्रह नांव के लउठी ला टोर देंव। <verse eid="ZEC 11:10" /><verse number="11" style="v" sid="ZEC 11:11" />ओ करार ला ओहीच दिन टोर दिये गीस, अऊ झुंड के सताय गे जऊन पसुमन मोर कोति देखत रिहिन, ओमन जान डारिन कि येह यहोवा के बचन रिहिस।<verse eid="ZEC 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 11:12" />तब मेंह ओमन ले कहेंव, “कहूं तुमन ला ये बने लगे, त मोला मोर बनी दे दव; पर कहूं नइं देय चाहत हव, त झन दव।” तब ओमन मोर बनी के तीस चांदी के टुकड़ा मोला दीन।<verse eid="ZEC 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 11:13" />अऊ यहोवा ह मोला कहिस, “ये बनी ला कुम्हार के आघू म फटिक दे”—ओ बढ़िया दाम जेला ओमन मोर बर ठहिराय हवंय! एकरसेति मेंह चांदी के ओ तीस टुकड़ामन ला लेंव अऊ यहोवा के घर म कुम्हार के आघू म फटिक देंव।<verse eid="ZEC 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 11:14" />तब मेंह यहूदा अऊ इसरायल के बीच परिवार के संबंध ला टोरत, एकता नांव के अपन दूसर लउठी ला टोर देंव।<verse eid="ZEC 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ZEC 11:15" />तब यहोवा ह मोला कहिस, “एक मुरूख चरवाहा के चीजमन ला फेर लेय ले। <verse eid="ZEC 11:15" /><verse number="16" style="v" sid="ZEC 11:16" />काबरकि मेंह ये देस म एक अइसन चरवाहा ठहिरानेवाला हंव, जऊन ह गंवायमन के चिंता नइं करही, न जवानमन ला खोजही, न घायलमन ला चंगा करही, न ही तंदरूस्तमन ला खवाही, पर ओह बने भेड़मन के मांस ला खाही अऊ ओमन के खुरमन ला फोर दीही।<verse eid="ZEC 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEC 11:17" />“ओ बेकार चरवाहा ऊपर हाय,</para>
  <para style="q2" vid="ZEC 11:17">जऊन ह पसु के झुंड ला छोंड़के भाग जाथे!</para>
  <para style="q1" vid="ZEC 11:17">अइसन होवय कि ओकर बाहां अऊ ओकर जेवनी आंखी म तलवार चले!</para>
  <para style="q2" vid="ZEC 11:17">ओकर बाहां ह पूरा सूख जावय,</para>
  <para style="q2" vid="ZEC 11:17">अऊ ओह अपन जेवनी आंखी ले पूरा अंधरा हो जावय!”<verse eid="ZEC 11:17" /></para>
  <chapter eid="ZEC 11" />
  <chapter number="12" style="c" sid="ZEC 12" />
  <para style="s1">यरूसलेम के बईरीमन ला नास करे जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 12:1" />एक अगमबानी: इसरायल के बारे म यहोवा के बचन।</para>
  <para style="b" vid="ZEC 12:1" />
  <para style="p" vid="ZEC 12:1">यहोवा, जऊन ह अकास ला फईलाथे, जऊन ह धरती के नीव रखथे, अऊ जऊन ह मनखे के भीतर मनखे के आतमा ला बनाथे, ओह ये घोसना करत हे: <verse eid="ZEC 12:1" /><verse number="2" style="v" sid="ZEC 12:2" />“मेंह यरूसलेम ला एक अइसन कटोरा बनइया हंव, जऊन ह यरूसलेम सहर के आसपास के मनखेमन ला लड़खड़ा दीही। यहूदा अऊ संगे-संग यरूसलेम ला घलो घेर लिये जाही। <verse eid="ZEC 12:2" /><verse number="3" style="v" sid="ZEC 12:3" />ओ दिन, जब धरती के जम्मो जातिमन यरूसलेम के बिरूध म जूरहीं, त मेंह ओला जम्मो जातिमन बर एक ठन न हटनेवाला चट्टान बना दूहूं। ओ जम्मो जऊन मन ओला हटाय के कोसिस करहीं, ओमन अपनआप ला घायल करहीं। <verse eid="ZEC 12:3" /><verse number="4" style="v" sid="ZEC 12:4" />ओ दिन, मेंह हर एक घोड़ा ला आतंकित करहूं अऊ ओमा सवार मनखे के मति ला भ्रस्ट कर दूहूं,” यहोवा ह घोसना करत हे। “मेंह यहूदा के मनखेमन ऊपर किरपा-दिरिस्टी रखहूं, पर मेंह आनजातमन के जम्मो घोड़ामन ला अंधरा कर दूहूं। <verse eid="ZEC 12:4" /><verse number="5" style="v" sid="ZEC 12:5" />तब यहूदा के बंस के मनखेमन अपन मन म कहिहीं, ‘यरूसलेम के मनखेमन बलवान अंय, काबरकि सर्वसक्तिमान यहोवा ह ओमन के परमेसर अय।’<verse eid="ZEC 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 12:6" />“ओ दिन, मेंह यहूदा के बंस ला लकरी के कुढ़ा म आगी के एक भट्ठा सहीं, बीड़ामन के बीच बरत एक मसाल सहीं बना दूहूं। ओमन अपन जेवनी अऊ डेरी, आसपास के जम्मो कोति के मनखेमन ला भसम कर दीहीं, पर यरूसलेम ह अपन जगह म अडिग बने रहिही।<verse eid="ZEC 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 12:7" />“यहोवा ह पहिली यहूदा म रहइयामन ला बचाही, ताकि दाऊद के घराना अऊ यरूसलेम के निवासीमन के आदरमान यहूदा ले बढ़के झन होवय। <verse eid="ZEC 12:7" /><verse number="8" style="v" sid="ZEC 12:8" />ओ दिन खुद यहोवा यरूसलेम म रहइयामन के रकछा करही, जेकर ले ओमा के सबले दुरबल घलो दाऊद सहीं सक्तिसाली हो जाही, अऊ दाऊद के घराना ह परमेसर सहीं, ओमन के आघू-आघू चलइया यहोवा के स्वरगदूत सहीं हो जाही। <verse eid="ZEC 12:8" /><verse number="9" style="v" sid="ZEC 12:9" />ओ दिन, मेंह ओ जम्मो जातिमन ला नास करे बर निकलहूं, जऊन मन यरूसलेम ऊपर हमला करथें।<verse eid="ZEC 12:9" /></para>
  <para style="s1">जेला ओमन छेदिन-बेधिन ओकर बर बिलाप करई</para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 12:10" />“अऊ मेंह दाऊद के घराना अऊ यरूसलेम के निवासीमन ऊपर किरपा अऊ बिनती करइया एक आतमा उंडेलहूं। ओमन मोर कोति देखहीं, जेला ओमन छेदे-बेधे हवंय, अऊ ओमन ओकर बर वइसने बिलाप करहीं, जइसने कोनो अपन एके झन लइका बर करथे, अऊ ओमन ओकर बर अइसने दुखी होहीं, जइसने कोनो अपन पहिलांत के मरे म दुखी होथे। <verse eid="ZEC 12:10" /><verse number="11" style="v" sid="ZEC 12:11" />ओ दिन यरूसलेम म अइसे भयंकर बिलाप होही, जइसे हदद-रिम्मोन ह मगिद्दो के मैदान म बिलाप करे रिहिस। <verse eid="ZEC 12:11" /><verse number="12" style="v" sid="ZEC 12:12" />जम्मो देस ह सोक मनाही, हर एक गोत्र खुद, हर एक जन अपन घरवाली संग: दाऊद के घराना के गोत्र के मनखे अऊ ओमन के घरवालीमन, नातान के घराना के गोत्र के मनखे अऊ ओमन के घरवालीमन, <verse eid="ZEC 12:12" /><verse number="13" style="v" sid="ZEC 12:13" />लेवी के घराना के गोत्र के मनखे अऊ ओमन के घरवालीमन, सिमी के गोत्र के मनखे अऊ ओमन के घरवालीमन, <verse eid="ZEC 12:13" /><verse number="14" style="v" sid="ZEC 12:14" />अऊ बांचे जम्मो गोत्र के मनखे अऊ ओमन के घरवालीमन सोक मनाहीं।<verse eid="ZEC 12:14" /></para>
  <chapter eid="ZEC 12" />
  <chapter number="13" style="c" sid="ZEC 13" />
  <para style="s1">पाप ले सुध करई</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 13:1" />“ओ दिन दाऊद के घराना अऊ यरूसलेम के निवासीमन ला ओमन के पाप अऊ असुधता ले सुध करे बर एक सोता फूटही।<verse eid="ZEC 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEC 13:2" />“ओ दिन, मेंह देस ले जम्मो मूरतीमन के नांव ला मिटा दूहूं, अऊ ओमन ला फेर कभू सुरता नइं करे जाही।” सर्वसक्तिमान यहोवा ह ये घोसना करत हे। “मेंह देस ले अगमजानीमन ला अऊ असुधता के आतमा ला निकाल दूहूं। <verse eid="ZEC 13:2" /><verse number="3" style="v" sid="ZEC 13:3" />अऊ तभो ले कहूं कोनो अगमबानी करे, त ओला जनम देवइया ओकर दाई-ददा ओला कहिहीं, ‘जरूरी अय कि तें मर जा, काबरकि तेंह यहोवा के नांव म लबरा बात कहे हस।’ तब ओकर खुद के दाई-ददामन ओ अगमबानी करइया ला तलवार ले मार डारहीं।<verse eid="ZEC 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 13:4" />“ओ दिन हर एक अगमजानी ह अपन अगम के दरसन बर सरमिंदा होही। ओमन मनखेमन ला धोखा देय बर चुंदी ले बने अगमजानीमन के कपड़ा नइं पहिरहीं। <verse eid="ZEC 13:4" /><verse number="5" style="v" sid="ZEC 13:5" />पर हर एक ह कहिही, ‘मेंह अगमजानी नो हंव। मेंह एक किसान अंव; मेंह अपन जवानी ले ही खेत-खार ले अपन जिनगी चलात आय हंव।’ <verse eid="ZEC 13:5" /><verse number="6" style="v" sid="ZEC 13:6" />कहूं कोनो ओकर ले पुछय, ‘तोर देहें म ये घावमन कइसे हवंय?’ त ओह जबाब दीही, ‘मोर संगीमन के घर म मोला ये चोट लगे हवय।’ ”<verse eid="ZEC 13:6" /></para>
  <para style="s1">चरवाहा ह मारे गीस, भेड़मन तितिर-बितिर होईन</para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEC 13:7" />यहोवा ह कहिथे, “हे तलवार, उठ, मोर चरवाहा के बिरूध चल,</para>
  <para style="q2" vid="ZEC 13:7">ओ मनखे के बिरूध जऊन ह मोर घनिस्ट मनखे अय!”</para>
  <para style="q2" vid="ZEC 13:7">सर्वसक्तिमान यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="ZEC 13:7">“चरवाहा ऊपर तलवार चला,</para>
  <para style="q2" vid="ZEC 13:7">अऊ भेड़मन तितिर-बितिर हो जाहीं,</para>
  <para style="q2" vid="ZEC 13:7">अऊ मेंह लइकामन के बिरूध अपन हांथ उठाहूं।”<verse eid="ZEC 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEC 13:8" />यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="ZEC 13:8">“जम्मो देस म दू-तिहाई मनखेमन ला तलवार चलाके मार डारे जाही;</para>
  <para style="q2" vid="ZEC 13:8">तभो ले एक तिहाई मनखेमन ओमा बांचे रहिहीं।<verse eid="ZEC 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEC 13:9" />ये एक तिहाई मनखेमन ला मेंह आगी म डार दूहूं;</para>
  <para style="q2" vid="ZEC 13:9">मेंह ओमन ला चांदी सहीं सुध करहूं</para>
  <para style="q2" vid="ZEC 13:9">अऊ ओमन ला अइसे परखहूं, जइसे सोन ला परखे जाथे।</para>
  <para style="q1" vid="ZEC 13:9">ओमन मोर नांव लेके पुकारहीं</para>
  <para style="q2" vid="ZEC 13:9">अऊ मेंह ओमन के सुनहूं;</para>
  <para style="q1" vid="ZEC 13:9">मेंह कहिहूं, ‘ओमन मोर मनखे अंय,’</para>
  <para style="q2" vid="ZEC 13:9">अऊ ओमन कहिहीं, ‘यहोवा ह हमर परमेसर अय।’ ”<verse eid="ZEC 13:9" /></para>
  <chapter eid="ZEC 13" />
  <chapter number="14" style="c" sid="ZEC 14" />
  <para style="s1">यहोवा ह आके राज करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 14:1" />हे यरूसलेम, यहोवा के एक अइसने दिन अवइया हे, जब तुम्हर संपत्ति ला लूट लिये जाही अऊ तुम्हर अपन घेरा के भीतर ही बांट लिये जाही।<verse eid="ZEC 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEC 14:2" />मेंह जम्मो जाति के मनखेमन ला यरूसलेम के बिरूध लड़ई करे बर इकट्ठा करहूं; सहर ऊपर अधिकार कर लिये जाही, घर-दुवारमन लूट लिये जाहीं, अऊ माईलोगनमन के इज्जत लूट लिये जाही। सहर के आधा मनखेमन बंधुवई म चल दीहीं, पर बांचे मनखेमन सहर म ही रहिहीं। <verse eid="ZEC 14:2" /><verse number="3" style="v" sid="ZEC 14:3" />तब यहोवा ह निकलके ओ जातिमन के बिरूध अइसे लड़ही, जइसे ओह लड़ई के दिन लड़थे। <verse eid="ZEC 14:3" /><verse number="4" style="v" sid="ZEC 14:4" />ओ दिन यहोवा ह यरूसलेम के पूरब म जैतून पहाड़ ऊपर जाके ठाढ़ होही, अऊ जैतून पहाड़ ह पूरब अऊ पछिम दू भाग म बंट जाही अऊ मांझा म एक बड़े घाटी बन जाही, जेकर ले आधा पहाड़ उत्तर कोति अऊ आधा पहाड़ दक्खिन कोति हट जाही। <verse eid="ZEC 14:4" /><verse number="5" style="v" sid="ZEC 14:5" />तब तेंह मोर ये पहाड़ के घाटी ले होके भागबे, काबरकि ये घाटी ह आसेल तक फईले होही। तेंह अइसे भागबे, जइसे तेंह यहूदा के राजा उजियाह के दिन म आय भुइंडोल के समय म भागे रहय।<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="AMO 1:1">आमो 1:1</ref></char></char></note> तब यहोवा मोर परमेसर ह जम्मो पबितर मनखेमन संग आही।<verse eid="ZEC 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 14:6" />ओ दिन न तो सूरज के अंजोर होही अऊ न ही ठंडा, पर कुहरा ले भरे अंधियार होही। <verse eid="ZEC 14:6" /><verse number="7" style="v" sid="ZEC 14:7" />ओह एक अलग दिन होही—एक अइसे दिन जेला सिरिप यहोवा ही जानथे—दिन अऊ रथिया के बीच कोनो अंतर नइं होही। जब सांझ होही, तब अंजोर होही।<verse eid="ZEC 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 14:8" />ओ दिन जिनगी के पानी ह यरूसलेम ले बहके निकलही, येमा के आधा पानी पूरब के मिरतू सागर कोति अऊ आधा पानी पछिम के भूमध्य सागर कोति बहही, अऊ येह धूपकाला अऊ संगे-संग जड़काला म घलो बहते रहिही।<verse eid="ZEC 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 14:9" />जम्मो धरती ऊपर यहोवा ही राजा होही। ओ दिन एक ही यहोवा होही, अऊ सिरिप ओकरे ही नांव होही।<verse eid="ZEC 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 14:10" />जम्मो भुइयां, गेबा सहर ले लेके यरूसलेम के दक्खिन म रिम्मोन नगर तक अराबाह के सहीं हो जाही। पर बिनयामीन दुवार ले लेके पहिले दुवार के जगह तक, कोना के दुवार तक, अऊ हनानेल के मीनार ले लेके राजसाही अंगूर के रसकुंडमन तक यरूसलेम ला ऊंचा करे जाही, अऊ येह अपन जगह म बने रहिही। <verse eid="ZEC 14:10" /><verse number="11" style="v" sid="ZEC 14:11" />मनखेमन आके उहां बसहीं; अऊ येला फेर कभू नास नइं करे जाही। यरूसलेम सुरकछित रहिही।<verse eid="ZEC 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 14:12" />ओ जातिमन, जऊन मन यरूसलेम ले लड़ई करिन, ओ जम्मो ऊपर यहोवा अइसन महामारी लानही कि जब ओमन अपन गोड़ म ठाढ़े रहिहीं, त ओमन के मांस ह सड़ जाही, ओमन के आंखीमन ओमन के गोलक म ही सड़ जाहीं, अऊ ओमन के जीभमन ओमन के मुहूं म ही सड़ जाहीं। <verse eid="ZEC 14:12" /><verse number="13" style="v" sid="ZEC 14:13" />ओ दिन यहोवा के दुवारा मनखेमन म बड़े आतंक के संग घबराहट फईलही। ओमन एक-दूसर ला हांथ से पकड़ लीहीं अऊ एक-दूसर ऊपर हमला करहीं। <verse eid="ZEC 14:13" /><verse number="14" style="v" sid="ZEC 14:14" />यहूदा घलो आके यरूसलेम म लड़ही। आसपास के जम्मो जाति के संपत्ति ला इकट्ठा करे जाही—जेमा बहुंत अकन सोन, चांदी अऊ कपड़ा होही। <verse eid="ZEC 14:14" /><verse number="15" style="v" sid="ZEC 14:15" />अइसने ही किसम के एक महामारी घोड़ा, खच्चर, ऊंट, गदहा अऊ ओ डेरामन के जम्मो पसुमन ऊपर आही।<verse eid="ZEC 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ZEC 14:16" />तब ओ जम्मो जाति के मनखे, जेमन यरूसलेम ऊपर हमला करे रिहिन, ओमा के बांचे मनखेमन हर साल यरूसलेम जाके राजा, सर्वसक्तिमान यहोवा के अराधना करहीं, अऊ पबितर-तम्बूमन के तिहार मनाहीं। <verse eid="ZEC 14:16" /><verse number="17" style="v" sid="ZEC 14:17" />यदि धरती के मनखेमन ले कोनो मनखे राजा, सर्वसक्तिमान यहोवा के अराधना करे बर यरूसलेम नइं जाही, त ओमन के इहां बारिस नइं होही। <verse eid="ZEC 14:17" /><verse number="18" style="v" sid="ZEC 14:18" />कहूं मिसर के मनखेमन अराधना म भाग लेय बर नइं जाहीं, त ओमन के इहां घलो बारिस नइं होही। यहोवा ओमन ऊपर ओ महामारी लानही, जेला ओह ओ जातिमन ऊपर लानथे, जऊन मन पबितर-तम्बूमन के तिहार मनाय बर नइं जावंय। <verse eid="ZEC 14:18" /><verse number="19" style="v" sid="ZEC 14:19" />येह मिसर देस के मनखेमन के सजा अऊ ओ जम्मो जातिमन के सजा होही, जेमन पबितर-तम्बूमन के तिहार मनाय बर नइं जावंय।<verse eid="ZEC 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 14:20" />ओ दिन घोड़ामन के गरदन म लटके घंटीमन म ये सबद खोदके लिखाय होही, “यहोवा बर पबितर,” अऊ यहोवा के घर म खाना पकाय के बरतनमन बेदी के आघू म रखे पबितर कटोरामन सहीं होहीं। <verse eid="ZEC 14:20" /><verse number="21" style="v" sid="ZEC 14:21" />यरूसलेम अऊ यहूदा म हर एक बरतन सर्वसक्तिमान यहोवा बर पबितर होही, अऊ ओ जम्मो जऊन मन बलि चघाय बर आहीं, ओमन ओ बरतनमन ले कुछू बरतन ला लीहीं अऊ ओमा खाना पकाहीं। अऊ ओ दिन सर्वसक्तिमान यहोवा के घर म फेर कभू कोनो कनानी<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बेपारी</char></note> नइं होही।<verse eid="ZEC 14:21" /></para>
  <chapter eid="ZEC 14" />
</usx>