<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JER" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">यरमियाह</para>
  <para style="toc1">यरमियाह के किताब</para>
  <para style="toc2">यरमियाह</para>
  <para style="toc3">यर</para>
  <para style="mt1">यरमियाह</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="JER 1" />
  <para style="p">
    <verse number="1" style="v" sid="JER 1:1" />हिलकियाह के बेटा यरमियाह, जऊन ह बिनयामीन के देस म अनातोत छेत्र के पुरोहितमन ले एक झन रिहिस ओकर ये बचन अय। <verse eid="JER 1:1" /><verse number="2" style="v" sid="JER 1:2" />यहोवा के बचन ह यरमियाह करा आमोन के बेटा, यहूदा के राजा योसियाह के सासन के तेरहवां साल म आईस, <verse eid="JER 1:2" /><verse number="3" style="v" sid="JER 1:3" />अऊ एकर बाद योसियाह के बेटा यहूदा के राजा यहोयाकीम के सासन के जरिये, येह योसियाह के बेटा यहूदा के राजा सिदकियाह के सासन के गियारहवां साल के पांचवां महिना तक आईस, जब यरूसलेम के मनखेमन बंधुवई म गीन।<verse eid="JER 1:3" /></para>
  <para style="b" />
  <para style="s1">यरमियाह के बुलावा</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 1:4" />यहोवा के ये बचन मोर करा, ये कहत आईस,<verse eid="JER 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 1:5" />“गरभ म रचे के पहिले ही मेंह तोला जानत रहेंव<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">चुन ले हंव</char></note>,</para>
  <para style="q2" vid="JER 1:5">तोर जनम के पहिले ही मेंह तोला अलग करे हंव;</para>
  <para style="q2" vid="JER 1:5">मेंह तोला देस-देसमन बर अगमजानी ठहिराय हंव।”<verse eid="JER 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 1:6" />तब मेंह कहेंव, “आह, हे परमपरधान यहोवा, मेंह नइं जानंव कि कइसे गोठियावंव; मेंह अभी बहुंत छोटे हंव।”<verse eid="JER 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 1:7" />पर यहोवा ह मोला कहिस, “झन कह, ‘मेंह उमर म बहुंत छोटे हंव।’ तोला ओ जम्मो झन करा जाना हे, जेमन करा मेंह तोला पठोहूं अऊ जऊन हुकूम मेंह तोला दूहूं, ओला बता। <verse eid="JER 1:7" /><verse number="8" style="v" sid="JER 1:8" />ओमन ले झन डरबे, काबरकि मेंह तोर संग हवंव अऊ मेंह तोला बचाहूं,” यहोवा ह ये घोसना करत हे।<verse eid="JER 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 1:9" />तब यहोवा ह अपन हांथ ला बढ़ाके मोर मुहूं ला छुईस अऊ मोला कहिस, “मेंह अपन बचन ला तोर मुहूं म डाल दे हंव। <verse eid="JER 1:9" /><verse number="10" style="v" sid="JER 1:10" />सुन, मेंह आज तोला देसमन अऊ राजमन ऊपर ठहिरावत हंव कि तें ओमन ला उखानके गिरा दे, ओमन ला नास करके फटिक दे, ओमन ला बना अऊ बसा दे।”<verse eid="JER 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 1:11" />तब यहोवा के ये बचन मोर करा आईस: “हे यरमियाह, तोला का दिखत हवय?”</para>
  <para style="p" vid="JER 1:11">मेंह कहेंव, “मोला बादाम के एक रूख के डारा ह दिखत हवय।”<verse eid="JER 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 1:12" />तब यहोवा ह मोला कहिस, “तोला सही दिखत हवय, काबरकि मेंह ये देखे बर धियान लगाय हंव कि मोर बचन ह पूरा होवय।”<verse eid="JER 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 1:13" />तब यहोवा के बचन ह मोर करा फेर आईस: “तोला का दिखत हवय?”</para>
  <para style="p" vid="JER 1:13">मेंह जबाब देंव, “मोला डबकत एक बरतन दिखत हवय, जेह उत्तर दिग ले हमर कोति झुकत हवय।”<verse eid="JER 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 1:14" />तब यहोवा ह मोला कहिस, “ये देस म रहइया जम्मो झन ऊपर उत्तर दिग ले बिपत्ति डाले जाही। <verse eid="JER 1:14" /><verse number="15" style="v" sid="JER 1:15" />मेंह उत्तर दिग के राजमन के मनखेमन ला बलानेचवाला हंव,” यहोवा ह ये घोसना करत हे।</para>
  <para style="q1" vid="JER 1:15">“ओमन के राजामन आहीं अऊ यरूसलेम के कपाट के प्रवेस दुवार म</para>
  <para style="q2" vid="JER 1:15">अपन सिंघासन लगाहीं;</para>
  <para style="q1" vid="JER 1:15">ओमन ओकर चारों कोति के जम्मो दीवारमन के बिरूध</para>
  <para style="q2" vid="JER 1:15">अऊ यहूदा के जम्मो नगरमन के बिरूध आहीं।<verse eid="JER 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 1:16" />मेंह अपन मनखेमन ऊपर नियाय के हुकूम दूहूं</para>
  <para style="q2" vid="JER 1:16">काबरकि ओमन मोला तियागके,</para>
  <para style="q1" vid="JER 1:16">आने देवतामन बर धूप जलाके</para>
  <para style="q2" vid="JER 1:16">अऊ अपन हांथ ले बनाय मूरतीमन के अराधना करके दुस्टता करे हवंय।<verse eid="JER 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 1:17" />“एकरसेति तेंह तियार हो जा! उठ अऊ जऊन बात के हुकूम मेंह तोला देवत हंव, ओला ओमन ला सुना। ओमन ले झन डर, नइं तो मेंह तोला ओमन के आघू म डरवा दूहूं। <verse eid="JER 1:17" /><verse number="18" style="v" sid="JER 1:18" />आज मेंह तोला ये जम्मो देस के बिरूध—यहूदा के राजामन, येकर करमचारी, येकर पुरोहित अऊ देस के मनखेमन के बिरूध ठाढ़ होय बर एक किलाबंद सहर, एक लोहा के खंभा, अऊ एक कांसा के दीवार बनाय हवंव। <verse eid="JER 1:18" /><verse number="19" style="v" sid="JER 1:19" />देस के मनखेमन तोर बिरूध म लड़हीं, पर तोला जीत नइं सकहीं, काबरकि मेंह तोर संग हवंव अऊ मेंह तोला बचाहूं,” यहोवा ह ये घोसना करत हे।<verse eid="JER 1:19" /></para>
  <chapter eid="JER 1" />
  <chapter number="2" style="c" sid="JER 2" />
  <para style="s1">इसरायल ह परमेसर ला तियाग देथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 2:1" />यहोवा के ये बचन मोर करा आईस: <verse eid="JER 2:1" /><verse number="2" style="v" sid="JER 2:2" />“जा अऊ यरूसलेम के सुनत म घोसना कर:</para>
  <para style="b" vid="JER 2:2" />
  <para style="p" vid="JER 2:2">“यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 2:2">“ ‘तोर जवानी के समरपन ला मेंह सुरता करथंव,</para>
  <para style="q2" vid="JER 2:2">कि कइसे तेंह एक दुलहिन सहीं मोला मया करे</para>
  <para style="q1" vid="JER 2:2">अऊ सुनसान जगह ले,</para>
  <para style="q2" vid="JER 2:2">ओ भुइयां तक मोर पाछू आय, जिहां बीजा नइं बोय गे रिहिस।<verse eid="JER 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 2:3" />इसरायल ह यहोवा बर पबितर,</para>
  <para style="q2" vid="JER 2:3">अऊ ओकर लुवई के पहिली ऊपज रिहिस;</para>
  <para style="q1" vid="JER 2:3">ओ जम्मो जऊन मन ओला नास करिन, ओमन दोसी ठहिराय गीन,</para>
  <para style="q2" vid="JER 2:3">अऊ ओमन ऊपर बिपत्ति पड़िस,’ ”</para>
  <para style="q2" vid="JER 2:3">यहोवा ह घोसना करत हे।<verse eid="JER 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JER 2:4" />हे याकूब के संतानमन, हे इसरायल के बंस के मनखेमन,</para>
  <para style="q2" vid="JER 2:4">यहोवा के बचन ला सुनव।<verse eid="JER 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 2:5" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 2:5">“तुम्हर पुरखामन मोर म का गलती पाईन,</para>
  <para style="q2" vid="JER 2:5">कि ओमन मोर ले बहुंत दूरिहा चल दीन?</para>
  <para style="q1" vid="JER 2:5">ओमन बेकार के मूरतीमन के पाछू हो लीन</para>
  <para style="q2" vid="JER 2:5">अऊ खुद ही बेकार हो गीन।<verse eid="JER 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 2:6" />ओमन ये नइं पुछिन, ‘यहोवा ह कहां हवय,</para>
  <para style="q2" vid="JER 2:6">जऊन ह हमन ला बंजर सुनसान जगह म ले होवत,</para>
  <para style="q1" vid="JER 2:6">मरू-भुइयां अऊ पहाड़ी देस म ले होवत,</para>
  <para style="q2" vid="JER 2:6">एक सूखा अऊ बिरबिट अंधियार के देस म ले होवत,</para>
  <para style="q1" vid="JER 2:6">एक अइसने देस जिहां कोनो नइं जावंय अऊ जिहां कोनो नइं रहंय,</para>
  <para style="q2" vid="JER 2:6">उहां ले होवत, मिसर देस ले निकाल ले आईस?’<verse eid="JER 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 2:7" />मेंह तुमन ला ये उपजाऊ देस म ले आनेंव</para>
  <para style="q2" vid="JER 2:7">ताकि तुमन येकर फर अऊ बने चीजमन के आनंद उठावव।</para>
  <para style="q1" vid="JER 2:7">पर तुमन आके मोर देस ला असुध करेव</para>
  <para style="q2" vid="JER 2:7">अऊ मोर ये निज भाग ला घिनित कर दे हव।<verse eid="JER 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 2:8" />पुरोहितमन घलो नइं पुछिन,</para>
  <para style="q2" vid="JER 2:8">‘यहोवा कहां हवय?’</para>
  <para style="q1" vid="JER 2:8">जऊन मन मोर कानून ला सिखाथें, ओमन मोला नइं जानंय;</para>
  <para style="q2" vid="JER 2:8">अगुवामन मोर बिरोध म बिदरोह करिन।</para>
  <para style="q1" vid="JER 2:8">अगमजानीमन बेकार के मूरतीमन के पाछू चलत,</para>
  <para style="q2" vid="JER 2:8">बाल देवता के नांव ले अगमबानी करिन।<verse eid="JER 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JER 2:9" />“एकरसेति मेंह तुम्हर ऊपर फेर दोस लगाथंव,”</para>
  <para style="q2" vid="JER 2:9">यहोवा ह ये घोसना करत हे।</para>
  <para style="q2" vid="JER 2:9">“अऊ मेंह तुम्हर लइकामन के लइकामन ऊपर दोस लगाहूं।<verse eid="JER 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 2:10" />कित्ती के समुंदर तीर के ओ पार जावव अऊ देखव,</para>
  <para style="q2" vid="JER 2:10">केदार देस म दूत पठोवव अऊ धियान से देखव;</para>
  <para style="q2" vid="JER 2:10">देखव, यदि अइसने काम कभू उहां होय हवय:<verse eid="JER 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 2:11" />का कोनो देस ह अपन देवतामन ला बदले हवय?</para>
  <para style="q2" vid="JER 2:11">(जबकि ओमन देवता ही नो हें।)</para>
  <para style="q1" vid="JER 2:11">पर मोर मनखेमन अपन महिमामय परमेसर ला</para>
  <para style="q2" vid="JER 2:11">बेकार के मूरतीमन ले बदल ले हवंय।<verse eid="JER 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 2:12" />हे अकासमन, येला देखके डरव,</para>
  <para style="q2" vid="JER 2:12">अऊ अब्बड़ डर से कांपव,”</para>
  <para style="q2" vid="JER 2:12">यहोवा ह ये घोसना करत हे।<verse eid="JER 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 2:13" />“मोर मनखेमन दू ठन पाप करे हवंय:</para>
  <para style="q1" vid="JER 2:13">ओमन मोला, जीयत पानी के सोता ला,</para>
  <para style="q2" vid="JER 2:13">तियाग दे हवंय,</para>
  <para style="q1" vid="JER 2:13">अऊ अपन खुद के कुंडमन ला खन ले हवंय,</para>
  <para style="q2" vid="JER 2:13">अइसने टूटे कुंडमन, जेमा पानी नइं ठहिरय।<verse eid="JER 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 2:14" />का इसरायल एक सेवक अय, जनम ले एक गुलाम अय?</para>
  <para style="q2" vid="JER 2:14">त फेर ओह काबर लूट के सामान बन गे हवय?<verse eid="JER 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 2:15" />सिंहमन गरजे हवंय;</para>
  <para style="q2" vid="JER 2:15">ओमन ओकर ऊपर गुर्राय हवंय।</para>
  <para style="q1" vid="JER 2:15">ओमन ओकर देस ला उजाड़ दे हवंय;</para>
  <para style="q2" vid="JER 2:15">ओकर नगरमन ला जलाय अऊ तियागे गे हवय।<verse eid="JER 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 2:16" />मेमफीस अऊ तहपनहेस सहर के मनखेमन घलो</para>
  <para style="q2" vid="JER 2:16">तोर खोपड़ी ला फोर दे हवंय।<verse eid="JER 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 2:17" />जब यहोवा तोर परमेसर ह तोला रसता म ले चलिस,</para>
  <para style="q2" vid="JER 2:17">त ओला तियागके,</para>
  <para style="q2" vid="JER 2:17">का तें ये बिपत्ति अपन ऊपर खुद नइं लाने हस?<verse eid="JER 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 2:18" />अब नील<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">इबरानी म <char style="tl">सीहोर</char>; येह नील नदी के एक साखा ए</char></note> नदी के पानी पीये बर</para>
  <para style="q2" vid="JER 2:18">मिसर देस ला काबर जाना?</para>
  <para style="q1" vid="JER 2:18">अऊ फरात नदी के पानी पीये बर</para>
  <para style="q2" vid="JER 2:18">अस्सूर देस म काबर जाना?<verse eid="JER 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 2:19" />तोर दुस्टता ह तोला दंड दीही;</para>
  <para style="q2" vid="JER 2:19">तोर पुराना जिनगी म वापिस जवई ह तोला दबकारही।</para>
  <para style="q1" vid="JER 2:19">सोच-बिचार कर अऊ जान ले</para>
  <para style="q2" vid="JER 2:19">कि ये कतेक दुस्ट अऊ करू बात अय</para>
  <para style="q1" vid="JER 2:19">जब तेंह यहोवा अपन परमेसर ला तियाग देवत हस</para>
  <para style="q2" vid="JER 2:19">अऊ मोर भय नइं मानस,”</para>
  <para style="q2" vid="JER 2:19">परभू यहोवा सर्वसक्तिमान ह ये घोसना करत हे।<verse eid="JER 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 2:20" />“बहुंत पहिले तेंह अपन जुड़ा ला टोर डारे</para>
  <para style="q2" vid="JER 2:20">अऊ अपन बंधन ला टोर डारे;</para>
  <para style="q2" vid="JER 2:20">तेंह कहय, ‘मेंह तोर सेवा नइं करंव!’</para>
  <para style="q1" vid="JER 2:20">वास्तव म, जम्मो ऊंच पहाड़ ऊपर</para>
  <para style="q2" vid="JER 2:20">अऊ जम्मो छइहांवाले रूख के खाल्हे म</para>
  <para style="q2" vid="JER 2:20">तेंह एक बेस्या जइसे लेटे रहय।<verse eid="JER 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 2:21" />मेंह तोला अपन पसंद के अंगूर,</para>
  <para style="q2" vid="JER 2:21">बने अऊ मजबूत डंगाली म ले लगाय रहेंव।</para>
  <para style="q1" vid="JER 2:21">त फेर तेंह मोर बिरूध होके</para>
  <para style="q2" vid="JER 2:21">एक खराप अऊ जंगली अंगूर के नार म कइसे बदल गय?<verse eid="JER 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 2:22" />हालाकि तेंह अपनआप ला साबुन ले धोथस</para>
  <para style="q2" vid="JER 2:22">अऊ बहुंत अकन सफई के पाउडर के उपयोग करथस,</para>
  <para style="q2" vid="JER 2:22">तभो ले तोर पाप के दाग ह मोर आघू म हवय,”</para>
  <para style="q2" vid="JER 2:22">परमपरधान यहोवा ह ये घोसना करत हे।<verse eid="JER 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 2:23" />“तेंह कइसे कह सकथस, ‘मेंह असुध नइं होय हंव;</para>
  <para style="q2" vid="JER 2:23">मेंह बाल देवतामन के पाछू नइं गे हंव’?</para>
  <para style="q1" vid="JER 2:23">देख, घाटी म तेंह कइसने बरताव करे हस;</para>
  <para style="q2" vid="JER 2:23">सोच-बिचार कर कि तेंह का करे हस।</para>
  <para style="q1" vid="JER 2:23">तेंह एक तेज भगइया ऊंटनी अस</para>
  <para style="q2" vid="JER 2:23">अऊ एती-ओती भागत रहिथस,<verse eid="JER 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 2:24" />तेंह सुन्ना जगह म जाय के आदि एक जंगली गदही अस,</para>
  <para style="q2" vid="JER 2:24">जऊन ह अपन लालसा म हवा ला सुंघत रहिथे—</para>
  <para style="q2" vid="JER 2:24">ओकर गरमी के बेरा, ओला कोन ह काबू म कर सकथे?</para>
  <para style="q1" vid="JER 2:24">जऊन गदहामन ओकर पीछा करथें, ओमन अपनआप ला झन थकावंय;</para>
  <para style="q2" vid="JER 2:24">काबरकि मिलन के बेरा, ओमन ओला पा जाहीं।<verse eid="JER 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 2:25" />जब तक तेंह खाली गोड़ नइं अस अऊ तोर गला ह नइं सूखाय हे,</para>
  <para style="q2" vid="JER 2:25">तब तक झन दऊड़।</para>
  <para style="q1" vid="JER 2:25">पर तेंह कहय, ‘येह बेकार अय!</para>
  <para style="q2" vid="JER 2:25">मेंह परदेसी देवतामन ले मया करथंव,</para>
  <para style="q2" vid="JER 2:25">अऊ मेंह ओमन के पाछू जरूर जाहूं।’<verse eid="JER 2:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="JER 2:26" />“जइसने कि चोर ह पकड़े जाय ले कलंकित होथे,</para>
  <para style="q2" vid="JER 2:26">वइसने ही इसरायल के मनखेमन कलंकित होवत हें—</para>
  <para style="q1" vid="JER 2:26">ओमन, ओमन के राजामन अऊ ओमन के हाकिममन,</para>
  <para style="q2" vid="JER 2:26">ओमन के पुरोहितमन अऊ ओमन के अगमजानीमन।<verse eid="JER 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 2:27" />ओमन कठवा ला कहिथें, ‘तेंह मोर ददा अस,’</para>
  <para style="q2" vid="JER 2:27">अऊ पथरा ला कहिथें, ‘तेंह मोला जनमाय हस।’</para>
  <para style="q1" vid="JER 2:27">ओमन मोर कोति ले अपन मुहूं नइं,</para>
  <para style="q2" vid="JER 2:27">पर पीठ ला फेर ले हवंय;</para>
  <para style="q1" vid="JER 2:27">तभो ले, जब ओमन समस्या म पड़थें, त ओमन कहिथें,</para>
  <para style="q2" vid="JER 2:27">‘आ अऊ हमन ला बचा!’<verse eid="JER 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 2:28" />त ओ देवतामन कहां हवंय, जेमन ला तुमन अपन बर बनाय हवव?</para>
  <para style="q2" vid="JER 2:28">जब तुमन समस्या म पड़े हव,</para>
  <para style="q2" vid="JER 2:28">यदि ओमन तुमन ला बचा सकथें, त आवंय अऊ बचावंय!</para>
  <para style="q1" vid="JER 2:28">काबरकि, हे यहूदा, तोर करा अतेक देवतामन हवंय,</para>
  <para style="q2" vid="JER 2:28">जतेक कि तोर नगरमन हवंय।<verse eid="JER 2:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JER 2:29" />“तुमन मोर ऊपर काबर दोस लगाथव?</para>
  <para style="q2" vid="JER 2:29">तुमन जम्मो झन मोर बिरोध म बिदरोह करे हवव,”</para>
  <para style="q2" vid="JER 2:29">यहोवा ह ये घोसना करत हे।<verse eid="JER 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 2:30" />“मेंह बेकार म तुम्हर मनखेमन ला दंड देंव;</para>
  <para style="q2" vid="JER 2:30">दंड देय के बाद घलो ओमन नइं सुधरिन।</para>
  <para style="q1" vid="JER 2:30">एक भूखा सिंह सहीं</para>
  <para style="q2" vid="JER 2:30">तुमन अपन अगमजानीमन ला अपन तलवार ले फार डाले हव।<verse eid="JER 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 2:31" />“ये पीढ़ी के मनखेमन, तुमन यहोवा के बचन म धियान देवव:</para>
  <para style="q1" vid="JER 2:31">“का मेंह इसरायल बर एक सुन्ना जगह</para>
  <para style="q2" vid="JER 2:31">या एक बिरबिट अंधियार के देस हो गे हवंव?</para>
  <para style="q1" vid="JER 2:31">मोर मनखेमन काबर कहिथें, ‘हमन एती-ओती जाय बर सुतंतर हन;</para>
  <para style="q2" vid="JER 2:31">हमन तोर करा अऊ नइं आवन’?<verse eid="JER 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 2:32" />का एक जवान माईलोगन ह अपन जेवर,</para>
  <para style="q2" vid="JER 2:32">या एक दुलहिन ह अपन बिहाव के सिंगार ला भुलाथे?</para>
  <para style="q1" vid="JER 2:32">तभो ले, मोर मनखेमन मोला</para>
  <para style="q2" vid="JER 2:32">बहुंत समय ले भुला गे हवंय।<verse eid="JER 2:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 2:33" />मया लगाय बर तेंह कइसे बने चाल चलथस!</para>
  <para style="q2" vid="JER 2:33">इहां तक कि खराप ले खराप माईलोगन घलो तोर चाल ले सीख सकत हें।<verse eid="JER 2:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 2:34" />तोर कपड़ा म,</para>
  <para style="q2" vid="JER 2:34">निरदोस अऊ गरीब मनखेमन के खून के चिनहां पाय जाथे,</para>
  <para style="q2" vid="JER 2:34">हालाकि तें ओमन ला सेंध लगात नइं पकड़े।</para>
  <para style="q1" vid="JER 2:34">तभो ले ये जम्मो के होवत घलो<verse eid="JER 2:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="JER 2:35" />तेंह कहिथस, ‘मेंह निरदोस अंव;</para>
  <para style="q2" vid="JER 2:35">ओह मोर ऊपर गुस्सा नइं ए।’</para>
  <para style="q1" vid="JER 2:35">पर, मेंह तोला दंड दूहूं</para>
  <para style="q2" vid="JER 2:35">काबरकि तेंह कहिथस, ‘मेंह पाप नइं करे हंव।’<verse eid="JER 2:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 2:36" />अपन चालचलन ला बदलके,</para>
  <para style="q2" vid="JER 2:36">अतेक दूरिहा काबर जावत हस?</para>
  <para style="q1" vid="JER 2:36">जइसने तेंह अस्सूरी मनखेमन ले निरास होय रहय,</para>
  <para style="q2" vid="JER 2:36">वइसने मिसर के मनखेमन ले घलो होबे।<verse eid="JER 2:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 2:37" />निरासा म अपन मुड़ ला हांथ म धरे</para>
  <para style="q2" vid="JER 2:37">तेंह घलो ओ जगह ला छोंड़ देबे,</para>
  <para style="q1" vid="JER 2:37">काबरकि जेमन ऊपर तेंह भरोसा करथस, ओमन ला यहोवा ह अस्वीकार करे हवय;</para>
  <para style="q2" vid="JER 2:37">ओमन ले तोला मदद नइं मिलय।”<verse eid="JER 2:37" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="JER 2" />
  <chapter number="3" style="c" sid="JER 3" />
  <para style="q1">
    <verse number="1" style="v" sid="JER 3:1" />“यदि कोनो मनखे ह अपन घरवाली ला तियाग देथे</para>
  <para style="q2" vid="JER 3:1">अऊ ओ माईलोगन ह ओला छोंड़के आने आदमी ले बिहाव कर लेथे,</para>
  <para style="q1" vid="JER 3:1">त का ओ पहिला आदमी ला ओ माईलोगन करा फेर वापिस जाना चाही?</para>
  <para style="q2" vid="JER 3:1">का ओ देस ह पूरा असुध नइं हो जाही?</para>
  <para style="q1" vid="JER 3:1">पर तेंह कतको मयारूमन संग एक बेस्या सहीं रहे हस—</para>
  <para style="q2" vid="JER 3:1">त फेर, का अब तेंह मोर करा लहुंटके आबे?”</para>
  <para style="q2" vid="JER 3:1">यहोवा ह ये घोसना करत हे।<verse eid="JER 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 3:2" />“बंजर टीलामन कोति आंखी उठाके देख।</para>
  <para style="q2" vid="JER 3:2">कोनो अइसने जगह हवय, जिहां तेंह कुकरम नइं करे हस?</para>
  <para style="q1" vid="JER 3:2">तेंह सड़क-तीर म अइसने बईठके मयारूमन के बाट जोहय,</para>
  <para style="q2" vid="JER 3:2">जइसने एक घुमंतू मनखे ह सुन्ना जगह म बईठे रहिथे।</para>
  <para style="q1" vid="JER 3:2">तेंह अपन बेभिचार अऊ दुस्टता के काम ले</para>
  <para style="q2" vid="JER 3:2">देस ला असुध कर दे हस।<verse eid="JER 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 3:3" />एकरसेति, बरसात ला रोक दे गे हवय,</para>
  <para style="q2" vid="JER 3:3">अऊ बसन्त रितु के बारिस नइं होईस।</para>
  <para style="q1" vid="JER 3:3">तभो ले, तेंह एक बेस्या सहीं दिखत हस;</para>
  <para style="q2" vid="JER 3:3">तोर म सरम नांव के चीज ही नइं ए।<verse eid="JER 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 3:4" />का तेंह अभी मोला ये कहिके नइं बलाय:</para>
  <para style="q2" vid="JER 3:4">‘हे मोर ददा, हे मोर जवानी के संगी,<verse eid="JER 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 3:5" />का तेंह हमेसा गुस्सा करत रहिबे?</para>
  <para style="q2" vid="JER 3:5">का तोर कोरोध ह सदाकाल तक बने रहिही?’</para>
  <para style="q1" vid="JER 3:5">तेंह अइसने गोठियाथस,</para>
  <para style="q2" vid="JER 3:5">पर तेंह ओ जम्मो दुस्ट काम करथस, जेला तेंह कर सकथस।”<verse eid="JER 3:5" /></para>
  <para style="s1">बिसवासघाती इसरायल</para>
  <para style="p">
    <verse number="6" style="v" sid="JER 3:6" />योसियाह राजा के सासन के समय, यहोवा ह मोला कहिस, “का तेंह देखे हस कि बिसवासहीन इसरायल ह का करे हवय? ओह जम्मो ऊंच पहाड़ अऊ जम्मो छायादार रूखमन के खाल्हे म जाके बेभिचार करे हवय। <verse eid="JER 3:6" /><verse number="7" style="v" sid="JER 3:7" />मेंह सोचत रहेंव कि ये जम्मो काम करे बाद, ओह मोर करा लहुंटके आ जाही पर ओह नइं आईस, अऊ ओकर बेईमान बहिनी यहूदा ह येला देखिस हे। <verse eid="JER 3:7" /><verse number="8" style="v" sid="JER 3:8" />मेंह बिसवासहीन इसरायल ला ओकर जम्मो बेभिचार के कारन, ओला तियाग पतर देके भगा दे हंव। तभो ले, मेंह देखेंव कि ओकर बेईमान बहिनी यहूदा म कोनो डर नइं रिहिस; ओह घलो बाहिर जाके बेभिचार करिस। <verse eid="JER 3:8" /><verse number="9" style="v" sid="JER 3:9" />काबरकि इसरायल के छिनारीपन ह ओकर बर नानकून बात रिहिस, एकरसेति ओह देस ला असुध करिस अऊ पथरा अऊ कठवा के संग बेभिचार करिस। <verse eid="JER 3:9" /><verse number="10" style="v" sid="JER 3:10" />ये जम्मो होय के बावजूद, ओकर बेईमान बहिनी यहूदा ह अपन पूरा मन से मोर करा नइं लहुंटिस, पर लहुंटे के सिरिप दिखावा करिस,” यहोवा ह ये घोसना करत हे।<verse eid="JER 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 3:11" />यहोवा ह मोला कहिस, “बिसवासहीन इसरायल ह बिसवासघाती यहूदा ले जादा धरमी अय। <verse eid="JER 3:11" /><verse number="12" style="v" sid="JER 3:12" />जा अऊ उत्तर दिग म ये संदेस के घोसना कर:</para>
  <para style="q1" vid="JER 3:12">“ ‘हे बिसवासहीन इसरायल, लहुंट आ,’ यहोवा ह ये घोसना करत हे,</para>
  <para style="q2" vid="JER 3:12">‘मेंह तोर ऊपर अब गुस्सा नइं करंव,</para>
  <para style="q1" vid="JER 3:12">काबरकि मेंह बिसवासयोग्य अंव,’ यहोवा ह ये घोसना करत हे,</para>
  <para style="q2" vid="JER 3:12">‘मेंह सदाकाल बर गुस्सा नइं होवंव।<verse eid="JER 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 3:13" />सिरिप अपन दोस ला मान ले—</para>
  <para style="q2" vid="JER 3:13">तेंह यहोवा अपन परमेसर के बिरूध बिदरोह करे हस,</para>
  <para style="q1" vid="JER 3:13">तेंह जम्मो छायादार रूखमन के खाल्हे</para>
  <para style="q2" vid="JER 3:13">बिदेसी देवतामन बर अपन मया देखाय हस,</para>
  <para style="q2" vid="JER 3:13">अऊ मोर बात ला नइं माने हस,’ ”</para>
  <para style="q2" vid="JER 3:13">यहोवा ह ये घोसना करत हे।<verse eid="JER 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 3:14" />“हे बिसवासहीन मनखेमन मोर करा लहुंट आवव,” यहोवा ह ये घोसना करत हे, “काबरकि मेंह तुम्हर घरवाला अंव। मेंह तुमन ला चुनहूं—एक नगर ले एक झन अऊ एक बंस ले दू झन—अऊ तुमन ला सियोन म लानहूं। <verse eid="JER 3:14" /><verse number="15" style="v" sid="JER 3:15" />तब मेंह अपन मन मुताबिक तुमन ला चरवाहा दूहूं, जऊन मन गियान अऊ समझ के संग तुम्हर अगुवई करहीं। <verse eid="JER 3:15" /><verse number="16" style="v" sid="JER 3:16" />ओ दिनमन म, जब तुम्हर गनती ह देस म बढ़ जाही,” यहोवा ह ये घोसना करत हे, “मनखेमन फेर ये नइं कहिहीं, ‘यहोवा के करार के सन्दूक।’ ये बात ह ओमन के मन म कभू नइं आही या येला ओमन कभू सुरता नइं करहीं; ओकर कमी महसूस नइं होही, अऊ न ही दूसरा बनाय जाही। <verse eid="JER 3:16" /><verse number="17" style="v" sid="JER 3:17" />ओ बेरा म, ओमन यरूसलेम ला यहोवा के सिंघासन कहिहीं, अऊ जम्मो जाति के मनखेमन यहोवा के नांव ला आदर देय बर यरूसलेम म जूरहीं। ओमन अपन पापी हिरदय के ढीठपन के पाछू फेर नइं चलहीं। <verse eid="JER 3:17" /><verse number="18" style="v" sid="JER 3:18" />ओ दिनमन म, यहूदा के मनखेमन इसरायल के मनखेमन संग मिल जाहीं, अऊ ओमन एक संग उत्तर दिग के एक देस ले ओ देस म आहीं, जेला मेंह तुम्हर पुरखामन ला एक उत्तराधिकार के रूप म देय रहेंव।<verse eid="JER 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 3:19" />“मेंह खुद कहेंव,</para>
  <para style="q1" vid="JER 3:19">“ ‘कतेक खुसी से मेंह तोला अपन लइकामन सहीं समझके</para>
  <para style="q2" vid="JER 3:19">तोला एक मनभावन देस दे हंव,</para>
  <para style="q2" vid="JER 3:19">जऊन ह कि कोनो भी देस के सबले सुघर उत्तराधिकार अय।’</para>
  <para style="q1" vid="JER 3:19">मेंह सोचेंव कि तेंह मोला ‘ददा’ कहिबे</para>
  <para style="q2" vid="JER 3:19">अऊ मुहूं फेरके दूरिहा नइं जाबे।<verse eid="JER 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 3:20" />पर जइसने ओ माईलोगन, जऊन ह अपन घरवाला संग बिसवासघात करथे,</para>
  <para style="q2" vid="JER 3:20">वइसने ही, हे इसरायल, तेंह घलो मोर संग बिसवासघात करे हस,”</para>
  <para style="q2" vid="JER 3:20">यहोवा ह ये घोसना करत हे।<verse eid="JER 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 3:21" />बंजर टीलामन ले एक अवाज आवथे,</para>
  <para style="q2" vid="JER 3:21">इसरायली मनखेमन के रोये अऊ गोहारे के अवाज सुनई देवत हे,</para>
  <para style="q1" vid="JER 3:21">काबरकि ओमन अपन सही रसता ला छोंड़ दे हवंय</para>
  <para style="q2" vid="JER 3:21">अऊ यहोवा अपन परमेसर ला भुला गे हवंय।<verse eid="JER 3:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JER 3:22" />“हे बिसवासहीन मनखेमन, लहुंट आवव;</para>
  <para style="q2" vid="JER 3:22">मेंह तुम्हर भटकई ला सुधार दूहूं।”</para>
  <para style="b" vid="JER 3:22" />
  <para style="q1" vid="JER 3:22">“हव, हमन तोर करा आबो,</para>
  <para style="q2" vid="JER 3:22">काबरकि तेंह यहोवा हमर परमेसर अस।<verse eid="JER 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 3:23" />सच म पहाड़ी अऊ पहाड़मन म</para>
  <para style="q2" vid="JER 3:23">मूरती-पूजा के कोलाहल ह एक धोखा अय;</para>
  <para style="q1" vid="JER 3:23">निस्चय ही यहोवा हमर परमेसर म</para>
  <para style="q2" vid="JER 3:23">इसरायल के उद्धार हवय।<verse eid="JER 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 3:24" />हमर जवानी के समय ले ओ कलंकित देवतामन</para>
  <para style="q2" vid="JER 3:24">हमर पुरखामन के कमई के फर ला—</para>
  <para style="q1" vid="JER 3:24">ओमन के भेड़-बकरी, गाय-बईला,</para>
  <para style="q2" vid="JER 3:24">अऊ बेटा-बेटीमन ला खा डारे हवंय।<verse eid="JER 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 3:25" />आवव, हमन लज्जित होके लेट जावन,</para>
  <para style="q2" vid="JER 3:25">अऊ हमर कलंक ह हमन ला ढांप लेवय।</para>
  <para style="q1" vid="JER 3:25">काबरकि हमर पुरखामन अऊ हमन घलो</para>
  <para style="q2" vid="JER 3:25">यहोवा हमर परमेसर के बिरूध पाप करे हन;</para>
  <para style="q1" vid="JER 3:25">हमर जवानी के समय ले लेके आज तक</para>
  <para style="q2" vid="JER 3:25">हमन यहोवा हमर परमेसर के बात ला नइं माने हन।”<verse eid="JER 3:25" /></para>
  <para style="b" />
  <chapter eid="JER 3" />
  <chapter number="4" style="c" sid="JER 4" />
  <para style="q1">
    <verse number="1" style="v" sid="JER 4:1" />“हे इसरायल, यदि तें लहुंटके आबे,</para>
  <para style="q2" vid="JER 4:1">त मोर करा लहुंटके आ,”</para>
  <para style="q2" vid="JER 4:1">यहोवा ह ये घोसना करत हे।</para>
  <para style="q1" vid="JER 4:1">“यदि तेंह अपन घिनौना मूरतीमन ला मोर नजर ले दूरिहा हटाबे</para>
  <para style="q2" vid="JER 4:1">अऊ सही रसता ले नइं भटकबे,<verse eid="JER 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 4:2" />अऊ यदि सच्चई, नियाय अऊ धरमीपन म</para>
  <para style="q2" vid="JER 4:2">तें ये किरिया खाबे, ‘यहोवा के जिनगी के सपथ,’</para>
  <para style="q1" vid="JER 4:2">त देस-देस के मनखेमन ओकर दुवारा आसीस पाहीं</para>
  <para style="q2" vid="JER 4:2">अऊ यहोवा म ओमन घमंड करहीं।”<verse eid="JER 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 4:3" />यहोवा ह यहूदा अऊ यरूसलेम के मनखेमन ला ये कहत हे:</para>
  <para style="q1" vid="JER 4:3">“अपन बंजर भुइयां ला जोतव</para>
  <para style="q2" vid="JER 4:3">अऊ कंटिली झाड़ीमन के बीच बीजा झन बोवव।<verse eid="JER 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 4:4" />हे यहूदा के मनखे अऊ यरूसलेम के निवासीमन,</para>
  <para style="q2" vid="JER 4:4">यहोवा बर अपन खतना करव,</para>
  <para style="q2" vid="JER 4:4">अपन मन के खतना करव,</para>
  <para style="q1" vid="JER 4:4">नइं तो तुम्हर दुस्ट काममन के कारन</para>
  <para style="q2" vid="JER 4:4">मोर गुस्सा ह भड़कही अऊ आगी सहीं बरही—</para>
  <para style="q2" vid="JER 4:4">अइसने बरही कि ओला कोनो बुता नइं सकहीं।<verse eid="JER 4:4" /></para>
  <para style="s1">उत्तर दिग ले बिपत्ति</para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 4:5" />“यहूदा अऊ यरूसलेम म घोसना करके कहव:</para>
  <para style="q2" vid="JER 4:5">‘देस के जम्मो अंग तुरही बजावव!’</para>
  <para style="q1" vid="JER 4:5">चिचियाके ये कहव:</para>
  <para style="q2" vid="JER 4:5">‘एक संग जूरव!</para>
  <para style="q2" vid="JER 4:5">आवव, हमन गढ़वाले सहरमन म भाग जावन!’<verse eid="JER 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 4:6" />सियोन जाय बर झंडा ला ऊंचा करव!</para>
  <para style="q2" vid="JER 4:6">बिगर देरी करे सुरकछित जगह म भाग जावव!</para>
  <para style="q1" vid="JER 4:6">काबरकि मेंह उत्तर दिग ले बिपत्ति,</para>
  <para style="q2" vid="JER 4:6">अऊ भयंकर सतियानास लानेवाला हंव।”<verse eid="JER 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 4:7" />एक सिंह ह अपन मांद ले निकले हवय;</para>
  <para style="q2" vid="JER 4:7">देस-देस के मनखेमन ला नास करइया ह निकले हवय।</para>
  <para style="q1" vid="JER 4:7">ओह तुम्हर देस ला बरबाद करे बर</para>
  <para style="q2" vid="JER 4:7">अपन जगह ले निकले हवय।</para>
  <para style="q1" vid="JER 4:7">तुम्हर नगरमन नास हो जाहीं</para>
  <para style="q2" vid="JER 4:7">अऊ उहां कोनो रहनेवाला नइं होहीं।<verse eid="JER 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 4:8" />एकरसेति बोरा के ओनहा ला पहिर लव,</para>
  <para style="q2" vid="JER 4:8">रोवव अऊ बिलाप करव,</para>
  <para style="q1" vid="JER 4:8">काबरकि यहोवा के भयंकर कोरोध ह</para>
  <para style="q2" vid="JER 4:8">हमर ऊपर ले नइं टरे हे।<verse eid="JER 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JER 4:9" />यहोवा ह ये घोसना करत हे,</para>
  <para style="q2" vid="JER 4:9">“ओ दिन म, राजा अऊ करमचारीमन हतास हो जाहीं,</para>
  <para style="q1" vid="JER 4:9">पुरोहितमन अब्बड़ डरा जाहीं,</para>
  <para style="q2" vid="JER 4:9">अऊ अगमजानीमन भयभीत होहीं।”<verse eid="JER 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 4:10" />तब मेंह कहेंव, “हाय, हे परमपरधान यहोवा! तेंह ये मनखेमन अऊ यरूसलेम ला ये कहिके कइसे पूरा धोखा देय हवस, ‘तुमन ला सांति मिलही,’ जबकि तलवार ह हमर घेंच म रखे हवय!”<verse eid="JER 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 4:11" />ओ बखत ये मनखेमन ला अऊ यरूसलेम ला बताय जाही, “सुन्ना जगह के बंजर टीलामन ले मोर मनखेमन कोति एक झुलसा देवइया हवा चलही, पर येह पछरे बर या साफ करे बर नइं होही; <verse eid="JER 4:11" /><verse number="12" style="v" sid="JER 4:12" />ये हवा ह जादा सक्तिसाली होही, जेह मोर करा ले आथे। अब मेंह ओमन के बिरूध दंड के घोसना करत हंव।”<verse eid="JER 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 4:13" />देखव! ओह बादरमन सहीं आघू बढ़थे,</para>
  <para style="q2" vid="JER 4:13">ओकर रथमन बवंडर सहीं आथें,</para>
  <para style="q1" vid="JER 4:13">ओकर घोड़ामन गिधवा चिरईमन ले घलो जादा तेज भागथें।</para>
  <para style="q2" vid="JER 4:13">हमर ऊपर हाय! हमन नास होवत हन!<verse eid="JER 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 4:14" />हे यरूसलेम, अपन हिरदय ले बुरई ला धो अऊ तोर उद्धार होवय।</para>
  <para style="q2" vid="JER 4:14">तेंह कब तक अपन मन म खराप बिचार रखे रहिबे?<verse eid="JER 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 4:15" />दान सहर ले एक अवाज सुनई देवत हे,</para>
  <para style="q2" vid="JER 4:15">एपरैम के पहाड़मन ले बिपत्ति के घोसना होवत हे।<verse eid="JER 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 4:16" />“जाति-जाति के मनखेमन ला ये बतावव,</para>
  <para style="q2" vid="JER 4:16">यरूसलेम के बारे म घोसना करव:</para>
  <para style="q1" vid="JER 4:16">‘यहूदा के सहरमन के बिरूध लड़ई बर ललकारत,</para>
  <para style="q2" vid="JER 4:16">दूरिहा देस ले हमला करइया एक सेना आवत हे।<verse eid="JER 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 4:17" />ओमन खेत के रखवारमन सहीं यहूदा ला घेरत हवंय,</para>
  <para style="q2" vid="JER 4:17">काबरकि ओह मोर बिरूध बिदरोह करे हवय,’ ”</para>
  <para style="q2" vid="JER 4:17">यहोवा ह ये घोसना करत हे।<verse eid="JER 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 4:18" />“तोर बरताव अऊ तोर काममन के कारन</para>
  <para style="q2" vid="JER 4:18">ये बिपत्ति तोर ऊपर आय हवय।</para>
  <para style="q1" vid="JER 4:18">येह तोर सजा ए।</para>
  <para style="q2" vid="JER 4:18">येह कतेक दुखदाई ए!</para>
  <para style="q2" vid="JER 4:18">येह कइसे हिरदय ला छेदत हवय!”<verse eid="JER 4:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 4:19" />आह, मोर पीरा, मोर पीरा!</para>
  <para style="q2" vid="JER 4:19">मेंह पीरा म तड़फत हंव।</para>
  <para style="q1" vid="JER 4:19">आह, मोर मन के पीरा!</para>
  <para style="q2" vid="JER 4:19">मोर हिरदय ह भीतरे-भीतर कुटा-कुटा होवथे,</para>
  <para style="q2" vid="JER 4:19">मेंह चुप नइं रह सकंव।</para>
  <para style="q1" vid="JER 4:19">काबरकि मेंह तुरही के अवाज ला सुने हंव;</para>
  <para style="q2" vid="JER 4:19">मेंह लड़ई के ललकार ला सुने हंव।<verse eid="JER 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 4:20" />बिपत्ति ऊपर बिपत्ति आवत हे;</para>
  <para style="q2" vid="JER 4:20">जम्मो देस ह नास हो गे हवय।</para>
  <para style="q1" vid="JER 4:20">मोर तम्बूमन अऊ मोर डेरामन</para>
  <para style="q2" vid="JER 4:20">एक पल म नास हो गीन।<verse eid="JER 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 4:21" />कब तक ले, मोला लड़ई के झंडा ला देखना पड़ही</para>
  <para style="q2" vid="JER 4:21">अऊ तुरही के अवाज ला सुनना पड़ही?<verse eid="JER 4:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JER 4:22" />“मोर मनखेमन मुरूख अंय;</para>
  <para style="q2" vid="JER 4:22">ओमन मोला नइं जानंय।</para>
  <para style="q1" vid="JER 4:22">ओमन निरबुद्धि लइका अंय;</para>
  <para style="q2" vid="JER 4:22">ओमन करा समझ नइं ए।</para>
  <para style="q1" vid="JER 4:22">ओमन बुरई के काम करे म निपुन अंय;</para>
  <para style="q2" vid="JER 4:22">ओमन भलई करे नइं जानंय।”<verse eid="JER 4:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JER 4:23" />मेंह धरती ला देखेंव,</para>
  <para style="q2" vid="JER 4:23">अऊ येह बेडौल अऊ सुनसान परे रिहिस;</para>
  <para style="q1" vid="JER 4:23">अऊ अकास ला देखेंव,</para>
  <para style="q2" vid="JER 4:23">अऊ ओमा अंजोर नइं रिहिस।<verse eid="JER 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 4:24" />मेंह पहाड़मन ला देखेंव,</para>
  <para style="q2" vid="JER 4:24">अऊ ओमन कांपत रिहिन;</para>
  <para style="q2" vid="JER 4:24">अऊ जम्मो पहाड़ीमन डोलत रिहिन।<verse eid="JER 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 4:25" />मेंह देखेंव, अऊ उहां कोनो मनखे नइं रिहिन;</para>
  <para style="q2" vid="JER 4:25">अकास के जम्मो चिरईमन उड़िहा गे रिहिन।<verse eid="JER 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 4:26" />मेंह देखेंव, यहोवा के आघू, ओकर भयंकर कोरोध के कारन,</para>
  <para style="q2" vid="JER 4:26">फलदार देस ह सुन्ना हो गे हवय;</para>
  <para style="q2" vid="JER 4:26">येकर जम्मो नगरमन खंडहर हो गे हवंय।<verse eid="JER 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 4:27" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 4:27">“जम्मो देस ह उजर जाही,</para>
  <para style="q2" vid="JER 4:27">हालाकि मेंह येला पूरा नास नइं करहूं।<verse eid="JER 4:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 4:28" />एकरसेति धरती ह बिलाप करही</para>
  <para style="q2" vid="JER 4:28">अऊ ऊपर अकासमन अंधियार हो जाहीं,</para>
  <para style="q1" vid="JER 4:28">काबरकि मेंह कहे हवंव अऊ दया नइं देखावंव,</para>
  <para style="q2" vid="JER 4:28">मेंह फैसला कर ले हंव अऊ अपन बात ले नइं फिरंव।”<verse eid="JER 4:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JER 4:29" />घुड़सवार अऊ धनुसधारीमन के अवाज ला सुनके</para>
  <para style="q2" vid="JER 4:29">हर नगर के मनखेमन भाग जाथें।</para>
  <para style="q1" vid="JER 4:29">कुछू मनखे झाड़ीमन म चले जाथें;</para>
  <para style="q2" vid="JER 4:29">अऊ कुछू मनखेमन, ऊपर चट्टानमन के बीच म चल देथें।</para>
  <para style="q1" vid="JER 4:29">जम्मो नगरमन निरजन हो जाथें;</para>
  <para style="q2" vid="JER 4:29">ओमन म कोनो नइं रहंय।<verse eid="JER 4:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="JER 4:30" />हे नास होय जन, तेंह का करत हस?</para>
  <para style="q2" vid="JER 4:30">चमकीला लाल रंग के कपड़ा</para>
  <para style="q2" vid="JER 4:30">अऊ सोन के जेवर काबर पहिरे हस?</para>
  <para style="q1" vid="JER 4:30">अपन आंखी म काजर काबर आंजे हस?</para>
  <para style="q2" vid="JER 4:30">तेंह बेकार म अपनआप ला सजाय हस।</para>
  <para style="q1" vid="JER 4:30">तोर मयारूमन तोला तुछ समझथें;</para>
  <para style="q2" vid="JER 4:30">ओमन तोला मार डारे चाहत हें।<verse eid="JER 4:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JER 4:31" />मेंह एक अइसने कराहे के अवाज सुनत हंव, जइसे कोनो माईलोगन ह लइका जनमत हे</para>
  <para style="q2" vid="JER 4:31">जइसे कोनो माईलोगन ह अपन पहिलांत लइका ला जनमे के बेरा कराहथे—</para>
  <para style="q1" vid="JER 4:31">येह सियोन के बेटी के अवाज ए, जेकर सांस ह फूलत हे,</para>
  <para style="q2" vid="JER 4:31">अऊ अपन हांथमन ला फईलाके ये कहत हे,</para>
  <para style="q1" vid="JER 4:31">“हाय! मेंह बेहोस होवत हंव;</para>
  <para style="q2" vid="JER 4:31">मोर जिनगी ला हतियारामन के हांथ म दे दिये गे हवय।”<verse eid="JER 4:31" /></para>
  <chapter eid="JER 4" />
  <chapter number="5" style="c" sid="JER 5" />
  <para style="s1">एको झन घलो धरमी नइं</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 5:1" />“ऊपर अऊ खाल्हे यरूसलेम के गलीमन म जावव,</para>
  <para style="q2" vid="JER 5:1">चारों कोति देखव अऊ बिचार करव,</para>
  <para style="q2" vid="JER 5:1">ओकर चऊकमन म खोजव।</para>
  <para style="q1" vid="JER 5:1">यदि एक जन भी तुमन ला अइसने मिल जाय,</para>
  <para style="q2" vid="JER 5:1">जऊन ह ईमानदारी से काम करथे अऊ सच्चई के खोजी अय,</para>
  <para style="q2" vid="JER 5:1">त मेंह ये सहर ला छेमा कर दूहूं।<verse eid="JER 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 5:2" />हालाकि ओमन कहिथें, ‘यहोवा के जिनगी के कसम,’</para>
  <para style="q2" vid="JER 5:2">अभी भी ओमन झूठा कसम खावत हंय।”<verse eid="JER 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JER 5:3" />हे यहोवा, का तोर नजर सच्चई ऊपर नइं रहय?</para>
  <para style="q2" vid="JER 5:3">तेंह ओमन ला मारे, पर ओमन ला पीरा नइं होईस;</para>
  <para style="q2" vid="JER 5:3">तेंह ओमन ला कुचरे, पर ओमन नइं सुधरिन।</para>
  <para style="q1" vid="JER 5:3">ओमन अपन चेहरा ला पथरा ले घलो जादा कठोर कर लीन</para>
  <para style="q2" vid="JER 5:3">अऊ पछताप करे ले इनकार करिन।<verse eid="JER 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 5:4" />मेंह सोचेंव, “येमन सिरिप गरीब अंय;</para>
  <para style="q2" vid="JER 5:4">येमन मुरूख अंय,</para>
  <para style="q1" vid="JER 5:4">काबरकि येमन यहोवा के रद्दा ला,</para>
  <para style="q2" vid="JER 5:4">अऊ अपन परमेसर के जरूरत ला नइं जानंय।<verse eid="JER 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 5:5" />एकरसेति मेंह अगुवामन करा जाके</para>
  <para style="q2" vid="JER 5:5">ओमन ले बात करहूं;</para>
  <para style="q1" vid="JER 5:5">खचित ओमन यहोवा के रद्दा</para>
  <para style="q2" vid="JER 5:5">अऊ अपन परमेसर के जरूरत ला जानथें।”</para>
  <para style="q1" vid="JER 5:5">पर एक मन होके, ओमन घलो जुड़ा ला</para>
  <para style="q2" vid="JER 5:5">अऊ करार ला टोर दे रिहिन।<verse eid="JER 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 5:6" />येकरे कारन जंगल के सिंह ह ओमन ऊपर हमला करही,</para>
  <para style="q2" vid="JER 5:6">निरजन जगह के एक भेड़िया ह ओमन के नास कर दीही,</para>
  <para style="q1" vid="JER 5:6">एक चीतवा ह ओमन के नगरमन के लकठा म घात लगाय रहिही</para>
  <para style="q2" vid="JER 5:6">ताकि यदि कोनो जोखिम उठाके बाहिर निकले, त फारके ओला कुटा-कुटा कर दे,</para>
  <para style="q1" vid="JER 5:6">काबरकि ओमन के बिदरोह ह बहुंत अय</para>
  <para style="q2" vid="JER 5:6">अऊ ओमन के पाछू पलटई भी बहुंत।<verse eid="JER 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 5:7" />“मेंह तुमन ला काबर छेमा करंव?</para>
  <para style="q2" vid="JER 5:7">तुम्हर लइकामन मोला तियाग दे हवंय</para>
  <para style="q2" vid="JER 5:7">अऊ ओ देवतामन के किरिया खाय हवंय, जेमन देवता नो हंय।</para>
  <para style="q1" vid="JER 5:7">मेंह ओमन के जम्मो जरूरत ला पूरा करेंव,</para>
  <para style="q2" vid="JER 5:7">तभो ले, ओमन बेभिचार करिन</para>
  <para style="q2" vid="JER 5:7">अऊ बेस्यामन के घरमन म भीड़ के भीड़ जावत रिहिन।<verse eid="JER 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 5:8" />ओमन बने खवाय-पीयाय, वासना से भरे घोड़ामन सहीं अंय,</para>
  <para style="q2" vid="JER 5:8">ओमा के हर एक जन आने मनखे के घरवाली बर हिनहिनावत रहिथें।<verse eid="JER 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 5:9" />का मेंह ये काम बर ओमन ला सजा नइं देवंव?”</para>
  <para style="q2" vid="JER 5:9">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 5:9">का मेंह अइसने जाति ले</para>
  <para style="q2" vid="JER 5:9">खुद बदला नइं लंव?<verse eid="JER 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 5:10" />“ओमन के अंगूर के बारीमन म जा अऊ ओमन ला नास कर दे,</para>
  <para style="q2" vid="JER 5:10">पर ओमन ला पूरा नास झन कर।</para>
  <para style="q1" vid="JER 5:10">ओकर डालीमन ला काटके अलग कर दे,</para>
  <para style="q2" vid="JER 5:10">काबरकि ये मनखेमन यहोवा के नो हंय।<verse eid="JER 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 5:11" />इसरायल के मनखे अऊ यहूदा के मनखेमन</para>
  <para style="q2" vid="JER 5:11">मोर संग बहुंत बिसवासघात करे हवंय,”</para>
  <para style="q2" vid="JER 5:11">यहोवा ह ये घोसना करत हे।<verse eid="JER 5:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JER 5:12" />ओमन यहोवा के बारे म लबारी बात कहे हवंय;</para>
  <para style="q2" vid="JER 5:12">ओमन कहिन, “ओह कुछू नइं करही!</para>
  <para style="q1" vid="JER 5:12">हमर कुछू हानि नइं होही;</para>
  <para style="q2" vid="JER 5:12">हमन न तो कभू तलवार ले मारे जाबो अऊ न ही हमर इहां अकाल पड़ही।<verse eid="JER 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 5:13" />अगमजानीमन हवा सहीं अंय</para>
  <para style="q2" vid="JER 5:13">अऊ ओमन म परमेसर के बचन नइं ए;</para>
  <para style="q2" vid="JER 5:13">ओमन जो बात कहिथें, ओमन संग वइसने करे जावय।”<verse eid="JER 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 5:14" />एकरसेति यहोवा सर्वसक्तिमान परमेसर ह ये कहत हे:</para>
  <para style="q1" vid="JER 5:14">“काबरकि ये मनखेमन ये बचन कहे हवंय,</para>
  <para style="q2" vid="JER 5:14">मेंह अपन बचन ला तोर मुहूं म आगी</para>
  <para style="q2" vid="JER 5:14">अऊ ये मनखेमन ला कठवा सहीं बना दूहूं, अऊ येह ओमन ला भसम कर दीही।”<verse eid="JER 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 5:15" />यहोवा ह ये घोसना करत हे, “हे इसरायल के मनखेमन,</para>
  <para style="q2" vid="JER 5:15">मेंह तुम्हर बिरूध म दूरिहा ले एक अइसने देस ला लानत हंव—</para>
  <para style="q1" vid="JER 5:15">जऊन ह एक पुराना अऊ बने रहनेवाला देस ए,</para>
  <para style="q2" vid="JER 5:15">अइसने मनखे, जेमन के भासा ला तुमन नइं जानव,</para>
  <para style="q2" vid="JER 5:15">अऊ ओमन के बोली ला तुमन नइं समझव।<verse eid="JER 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 5:16" />ओमन के तरकसमन एक खुला कबर सहीं अंय;</para>
  <para style="q2" vid="JER 5:16">ओमा के जम्मो झन सूरबीर अंय।<verse eid="JER 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 5:17" />ओमन तुम्हर फसल अऊ तुम्हर जेवन ला खा जाहीं,</para>
  <para style="q2" vid="JER 5:17">ओमन तुम्हर बेटा-बेटीमन ला खा जाहीं;</para>
  <para style="q1" vid="JER 5:17">ओमन तुम्हर भेंड़-बकरी अऊ गाय-बईलामन ला खा जाहीं,</para>
  <para style="q2" vid="JER 5:17">ओमन तुम्हर अंगूर के नार अऊ अंजीर के रूखमन ला खा जाहीं।</para>
  <para style="q1" vid="JER 5:17">ओमन तलवार ले ओ गढ़वाले सहरमन ला नास कर दीहीं,</para>
  <para style="q2" vid="JER 5:17">जेमा तुमन भरोसा रखथव।”<verse eid="JER 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 5:18" />यहोवा ह ये घोसना करत हे, “तभो ले ओ दिनमन म घलो, मेंह तुमन ला पूरा नास नइं करंव। <verse eid="JER 5:18" /><verse number="19" style="v" sid="JER 5:19" />अऊ जब मनखेमन पुछहीं, ‘यहोवा हमर परमेसर ह हमन ले ये जम्मो काम काबर करे हवय?’ तब तें ओमन ला बताबे, ‘जइसने कि तुमन मोला तियाग दे हवव अऊ अपन खुद के देस म आने देवतामन के सेवा करे हवव, वइसने ही अब तुमन परदेस म परदेसीमन के सेवा करहू।’<verse eid="JER 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 5:20" />“येला याकूब के संतानमन ला घोसना करके बतावव</para>
  <para style="q2" vid="JER 5:20">अऊ यहूदा म ये परचार करव:<verse eid="JER 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 5:21" />हे मुरूख अऊ निरबुद्धि मनखेमन, ये बात ला सुनव,</para>
  <para style="q2" vid="JER 5:21">तुमन करा आंखी हवय पर नइं देखव,</para>
  <para style="q2" vid="JER 5:21">तुमन करा कान हवय पर नइं सुनव:<verse eid="JER 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 5:22" />का तुमन ला मोर डर नइं ए?”</para>
  <para style="q2" vid="JER 5:22">यहोवा ह ये घोसना करत हे।</para>
  <para style="q2" vid="JER 5:22">“का तुमन मोर आघू म नइं थरथरावव?</para>
  <para style="q1" vid="JER 5:22">मेंह बालू ला समुंदर के सीमना ठहिरांय,</para>
  <para style="q2" vid="JER 5:22">येह सदाकाल बर एक सीमना अय, जेला समुंदर ह नाहक नइं सकय।</para>
  <para style="q1" vid="JER 5:22">पानी के लहरामन ओकर ऊपर आ सकत हें, पर ओमन ओला जीत नइं सकंय;</para>
  <para style="q2" vid="JER 5:22">ओमन गरज सकत हें, पर ओमन ओला पार नइं कर सकंय।<verse eid="JER 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 5:23" />पर ये मनखेमन करा जिद्दी अऊ बिदरोही हिरदय हवय;</para>
  <para style="q2" vid="JER 5:23">ओमन अलग होके दूरिहा चल दे हवंय।<verse eid="JER 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 5:24" />ओमन अपनआप ला ये नइं कहंय,</para>
  <para style="q2" vid="JER 5:24">‘आवव, हमन ओ यहोवा हमर परमेसर के भय मानन,</para>
  <para style="q1" vid="JER 5:24">जऊन ह समय म, सरद अऊ बसन्त रितु के बारिस देथे,</para>
  <para style="q2" vid="JER 5:24">जऊन ह फसल कटई के नियमित हप्तामन के भरोसा देवाथे।’<verse eid="JER 5:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 5:25" />तुमन के गलत काममन, येमन ला दूरिहा कर दे हवंय;</para>
  <para style="q2" vid="JER 5:25">तुमन के पाप ही के कारन, तुम्हर भलई नइं होवय।<verse eid="JER 5:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="JER 5:26" />“मोर मनखेमन के बीच म दुस्ट मनखेमन हवंय</para>
  <para style="q2" vid="JER 5:26">जऊन मन अइसने ताक म रहिथें जइसने चिरई मरइयामन रहिथें</para>
  <para style="q2" vid="JER 5:26">अऊ येमन ओमन सहीं अंय, जऊन मन मनखेमन ला पकड़े बर फांदा लगाथें।<verse eid="JER 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 5:27" />चिरईमन ले भरे पिंजरामन सहीं,</para>
  <para style="q2" vid="JER 5:27">ओमन के घर ह छल-कपट ले भरे रहिथे;</para>
  <para style="q1" vid="JER 5:27">ओमन धनवान अऊ बलवान हो गे हवंय<verse eid="JER 5:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="JER 5:28" />अऊ ओमन मोटहा अऊ चिकना हो गे हवंय।</para>
  <para style="q1" vid="JER 5:28">ओमन के दुस्ट काममन के कोनो सीमना नइं ए;</para>
  <para style="q2" vid="JER 5:28">ओमन नियाय के परवाह नइं करंय।</para>
  <para style="q1" vid="JER 5:28">ओमन अनाथमन के नियाय नइं चुकावंय;</para>
  <para style="q2" vid="JER 5:28">ओमन गरीबमन के हक के बचाव नइं करंय।<verse eid="JER 5:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 5:29" />का मेंह ओमन ला ये बातमन के सजा नइं दंव?”</para>
  <para style="q2" vid="JER 5:29">यहोवा ह ये घोसना करत हे।</para>
  <para style="q1" vid="JER 5:29">“का मेंह अइसने जाति ले</para>
  <para style="q2" vid="JER 5:29">खुद बदला नइं लंव?”<verse eid="JER 5:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="JER 5:30" />एक भयंकर अऊ चोट देवइया बात</para>
  <para style="q2" vid="JER 5:30">देस म होय हवय:<verse eid="JER 5:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 5:31" />अगमजानीमन झूठ-मूठ के अगमबानी करथें,</para>
  <para style="q2" vid="JER 5:31">पुरोहितमन अपन खुद के अधिकार ले हुकूम चलाथें,</para>
  <para style="q1" vid="JER 5:31">अऊ मोर मनखेमन ला ये बात बहुंत बने लगथे।</para>
  <para style="q2" vid="JER 5:31">पर अन्त के बेरा म तुमन का करहू?<verse eid="JER 5:31" /></para>
  <chapter eid="JER 5" />
  <chapter number="6" style="c" sid="JER 6" />
  <para style="s1">यरूसलेम म सेना के घेराव</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 6:1" />“हे बिनयामीन गोत्र के मनखेमन, अपन सुरकछा बर भागव!</para>
  <para style="q2" vid="JER 6:1">यरूसलेम ले भागव!</para>
  <para style="q1" vid="JER 6:1">तकोआ सहर म तुरही फूंकव!</para>
  <para style="q2" vid="JER 6:1">बेत-हकेरेम नगर म संकेत देवव!</para>
  <para style="q1" vid="JER 6:1">काबरकि उत्तर दिग ले बिपत्ति,</para>
  <para style="q2" vid="JER 6:1">बल्कि भयंकर बिनास आही सहीं लगत हे।<verse eid="JER 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 6:2" />मेंह सियोन के, बहुंत सुघर</para>
  <para style="q2" vid="JER 6:2">अऊ नाजुक बेटी ला नास कर दूहूं।<verse eid="JER 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 6:3" />चरवाहामन अपन भेड़-बकरीमन संग ओकर बिरूध आहीं;</para>
  <para style="q2" vid="JER 6:3">ओमन अपन तम्बू ओकर चारों कोति गड़ियाहीं,</para>
  <para style="q2" vid="JER 6:3">अऊ हर एक झन अपन खुद के भाग म चराहीं।”<verse eid="JER 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JER 6:4" />“ओकर बिरूध लड़ई के तियारी करव!</para>
  <para style="q2" vid="JER 6:4">उठव, हमन मंझन के बेरा हमला करबो!</para>
  <para style="q1" vid="JER 6:4">पर, हाय, दिन के अंजोर ह कम होवत जावत हे,</para>
  <para style="q2" vid="JER 6:4">अऊ संझा के परछाई ह लम्बा होवत जावत हे।<verse eid="JER 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 6:5" />एकरसेति उठव, हमन रथिया के बेरा हमला करबो</para>
  <para style="q2" vid="JER 6:5">अऊ ओकर किलामन ला गिरा देबो!”<verse eid="JER 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 6:6" />सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 6:6">“रूखमन ला काटव</para>
  <para style="q2" vid="JER 6:6">अऊ यरूसलेम के बिरूध घेराबंदी के टीला बनावव।</para>
  <para style="q1" vid="JER 6:6">ये सहर ला सजा जरूर मिलना चाही;</para>
  <para style="q2" vid="JER 6:6">येह अतियाचार ले भर गे हवय।<verse eid="JER 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 6:7" />जइसने कुआं म ले पानी निकलथे,</para>
  <para style="q2" vid="JER 6:7">वइसने ही यरूसलेम ले बुरई निकलथे।</para>
  <para style="q1" vid="JER 6:7">हिंसा अऊ बिनास के बात ओमा सुनई देवत रहिथे;</para>
  <para style="q2" vid="JER 6:7">ओकर बेमारी अऊ घावमन हमेसा मोर आघू म हवंय।<verse eid="JER 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 6:8" />हे यरूसलेम, चेत जा,</para>
  <para style="q2" vid="JER 6:8">नइं तो, मेंह तोर ले मुहूं मोड़के दूरिहा चल दूहूं</para>
  <para style="q1" vid="JER 6:8">अऊ तोर भुइयां ला उजाड़ दूहूं</para>
  <para style="q2" vid="JER 6:8">ताकि येमा कोनो झन रह सकंय।”<verse eid="JER 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 6:9" />सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 6:9">“ओमन ला इसरायल के बचे भाग ला</para>
  <para style="q2" vid="JER 6:9">अंगूर के नार म बांचे अंगूर सहीं बटोरन दव;</para>
  <para style="q1" vid="JER 6:9">जइसने कोनो अंगूरमन ला संकेलथे,</para>
  <para style="q2" vid="JER 6:9">वइसने अपन हांथ ला डारामन ऊपर फेर बढ़ा।”<verse eid="JER 6:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 6:10" />मेंह काकर ले बात करंव अऊ चेतावंव?</para>
  <para style="q2" vid="JER 6:10">कोन ह मोर बात ला सुनही?</para>
  <para style="q1" vid="JER 6:10">ओमन के कान ह बंद हो गे हवय</para>
  <para style="q2" vid="JER 6:10">एकरसेति ओमन सुन नइं सकंय।</para>
  <para style="q1" vid="JER 6:10">यहोवा के बचन ह ओमन ला बने नइं लगय;</para>
  <para style="q2" vid="JER 6:10">येमा ओमन ला खुसी नइं मिलय।<verse eid="JER 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 6:11" />पर मेंह यहोवा के कोरोध ले भर गे हवंव,</para>
  <para style="q2" vid="JER 6:11">अऊ मेंह येला भीतर नइं धरे सकंव।</para>
  <para style="b" vid="JER 6:11" />
  <para style="q1" vid="JER 6:11">“गली म येला लइकामन ऊपर</para>
  <para style="q2" vid="JER 6:11">अऊ एक संग जूरे जवानमन ऊपर ढार दे;</para>
  <para style="q1" vid="JER 6:11">घरवाला अऊ घरवाली दूनों अऊ डोकरामन</para>
  <para style="q2" vid="JER 6:11">जेमन के उमर हो गे हवय, ओमन येमा धरे जाहीं।<verse eid="JER 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 6:12" />ओ मनखेमन के खेत-खार अऊ ओमन के घरवाली सहित</para>
  <para style="q2" vid="JER 6:12">ओमन के घर ला आने मन ला दे दिये जाही,</para>
  <para style="q1" vid="JER 6:12">जब मेंह अपन हांथ ला ओमन के बिरूध बढ़ाहूं</para>
  <para style="q2" vid="JER 6:12">जऊन मन ये देस म रहिथें,”</para>
  <para style="q2" vid="JER 6:12">यहोवा ह ये घोसना करत हे।<verse eid="JER 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 6:13" />“छोटे ले लेके बड़े तक,</para>
  <para style="q2" vid="JER 6:13">जम्मो के जम्मो अनाज के लालची अंय;</para>
  <para style="q1" vid="JER 6:13">अगमजानी अऊ पुरोहितमन घलो वइसने</para>
  <para style="q2" vid="JER 6:13">जम्मो के जम्मो धोखाधड़ी करथें।<verse eid="JER 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 6:14" />ओमन मोर मनखेमन के घावमन म अइसे पट्टी बांधथें</para>
  <para style="q2" vid="JER 6:14">मानो ओमा जादा चोट नइं लगे रिहिस।</para>
  <para style="q1" vid="JER 6:14">ओमन कहिथें, ‘सांति हे, सांति हे,’</para>
  <para style="q2" vid="JER 6:14">जबकि उहां सांति नइं ए।<verse eid="JER 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 6:15" />का ओमन अपन घिनौना बरताव बर सरमिंदा हवंय?</para>
  <para style="q2" vid="JER 6:15">नइं, ओमन बिलकुल ही सरमिंदा नइं एं;</para>
  <para style="q2" vid="JER 6:15">ओमन सरमिंदा होवई जानंय ही नइं।</para>
  <para style="q1" vid="JER 6:15">एकरसेति ओमन गिरे मनखेमन के बीच म गिरहीं;</para>
  <para style="q2" vid="JER 6:15">ओमन गिराय जाहीं, जब मेंह ओमन ला सजा दूहूं,”</para>
  <para style="q2" vid="JER 6:15">यहोवा ह कहत हे।<verse eid="JER 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 6:16" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 6:16">“सड़क के चऊकमन म ठाढ़ होवव अऊ देखव;</para>
  <para style="q2" vid="JER 6:16">पुराना रसता के बारे म पुछव,</para>
  <para style="q1" vid="JER 6:16">पुछव कि बने रसता कहां हवय, अऊ ओही म रेंगव,</para>
  <para style="q2" vid="JER 6:16">अऊ तुमन ला अपन मन म सांति मिलही।</para>
  <para style="q2" vid="JER 6:16">पर तुमन कहेव, ‘हमन येमा नइं रेंगन।’<verse eid="JER 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 6:17" />मेंह तुम्हर बर पहरेदारमन ला बईठाके कहेंव,</para>
  <para style="q2" vid="JER 6:17">‘तुरही के अवाज ला सुनव!’</para>
  <para style="q2" vid="JER 6:17">पर तुमन कहेव, ‘हमन नइं सुनन।’<verse eid="JER 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 6:18" />एकरसेति, हे जाति-जाति के मनखेमन, सुनव;</para>
  <para style="q2" vid="JER 6:18">तुमन, जऊन मन गवाह अव,</para>
  <para style="q2" vid="JER 6:18">धियान देवव कि ओमन के का होही।<verse eid="JER 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 6:19" />हे धरती, सुन:</para>
  <para style="q2" vid="JER 6:19">मेंह ये मनखेमन ऊपर ओ बिपत्ति लानत हंव,</para>
  <para style="q2" vid="JER 6:19">जऊन ह ओमन के योजना के फर अय,</para>
  <para style="q1" vid="JER 6:19">काबरकि येमन मोर बात ला नइं सुनिन</para>
  <para style="q2" vid="JER 6:19">अऊ मोर कानून के इनकार करिन।<verse eid="JER 6:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 6:20" />सेबा के सुगंध या दूरिहा देस ले आय मीठ तेजपान ऊपर</para>
  <para style="q2" vid="JER 6:20">मेंह का धियान दंव?</para>
  <para style="q1" vid="JER 6:20">तुम्हर होम-बलिदानमन गरहन करे लईक नो हंय;</para>
  <para style="q2" vid="JER 6:20">तुम्हर बलिदानमन ले मोला खुसी नइं होवय।”<verse eid="JER 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 6:21" />येकर कारन यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 6:21">“मेंह ये मनखेमन के आघू म बाधा डालहूं।</para>
  <para style="q2" vid="JER 6:21">दाई-ददा अऊ लइकामन, परोसी अऊ संगवारीमन,</para>
  <para style="q2" vid="JER 6:21">ओकर ऊपर ठोकर खाके नास होहीं।”<verse eid="JER 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 6:22" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 6:22">“देखव, उत्तर दिग के देस ले</para>
  <para style="q2" vid="JER 6:22">एक सेना आवत हे;</para>
  <para style="q1" vid="JER 6:22">धरती के छोर ले</para>
  <para style="q2" vid="JER 6:22">एक बड़े जाति ला उभारे जावत हे।<verse eid="JER 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 6:23" />ओमन धनुस अऊ बरछी धरे हवंय;</para>
  <para style="q2" vid="JER 6:23">ओमन कठोर अंय अऊ दया नइं देखावंय।</para>
  <para style="q1" vid="JER 6:23">जब ओमन अपन घोड़ामन ऊपर सवार होथें</para>
  <para style="q2" vid="JER 6:23">त ओमन गरजत समुंदर सहीं अवाज करथें;</para>
  <para style="q1" vid="JER 6:23">हे बेटी सियोन,<note caller="+" style="f"><char style="fr" closed="false">6:23 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरूसलेम के मनखेमन</char></note> ओमन तोर ऊपर हमला करे बर</para>
  <para style="q2" vid="JER 6:23">लड़ई म कतार बांधे मनखेमन सहीं आथें।”<verse eid="JER 6:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JER 6:24" />हमन ओमन के बारे म खबर सुने हन,</para>
  <para style="q2" vid="JER 6:24">अऊ हमर हांथमन ढीला पड़ गे हवंय।</para>
  <para style="q1" vid="JER 6:24">पीरा ह हमन ला अइसने जकड़े हवय,</para>
  <para style="q2" vid="JER 6:24">जइसने छेवारी होवत माईलोगन ला पीरा होथे।<verse eid="JER 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 6:25" />बाहिर मैदान कोति झन जावव,</para>
  <para style="q2" vid="JER 6:25">या सड़कमन म झन रेंगव,</para>
  <para style="q1" vid="JER 6:25">काबरकि बईरी करा तलवार हवय,</para>
  <para style="q2" vid="JER 6:25">अऊ चारों कोति आतंक छाय हवय।<verse eid="JER 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 6:26" />हे मोर मनखेमन, बोरा के कपड़ा पहिरव,</para>
  <para style="q2" vid="JER 6:26">अऊ राख म लोटव;</para>
  <para style="q1" vid="JER 6:26">जइसने एकलऊता बेटा के मरे ले बिलाप होथे</para>
  <para style="q2" vid="JER 6:26">वइसने कलप-कलपके बिलाप करव,</para>
  <para style="q1" vid="JER 6:26">काबरकि नास करइया ह</para>
  <para style="q2" vid="JER 6:26">अचानक हमर ऊपर आ जाही।<verse eid="JER 6:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JER 6:27" />“मेंह तोला धातु के परखनेवाला</para>
  <para style="q2" vid="JER 6:27">अऊ मोर मनखेमन ला खदान के धातु बनाय हंव,</para>
  <para style="q1" vid="JER 6:27">ताकि तें धियान दे</para>
  <para style="q2" vid="JER 6:27">अऊ ओमन के चालचलन ला परख।<verse eid="JER 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 6:28" />ओमन जम्मो कठोर बिदरोही हो गे हवंय,</para>
  <para style="q2" vid="JER 6:28">अऊ निन्दा करत हवंय।</para>
  <para style="q1" vid="JER 6:28">ओमन कांसा अऊ लोहा सहीं हो गे हवंय;</para>
  <para style="q2" vid="JER 6:28">ओमन जम्मो झन खराप आचरन करथें।<verse eid="JER 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 6:29" />धूकनी ह सीसा ला आगी म जलाय बर</para>
  <para style="q2" vid="JER 6:29">जोर से धूकथे,</para>
  <para style="q1" vid="JER 6:29">पर सुध करई ह बेकार हो जावत हे;</para>
  <para style="q2" vid="JER 6:29">काबरकि दुस्ट मनखेमन पछताप नइं करिन।<verse eid="JER 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 6:30" />ओमन ला नकली चांदी कहे जाथे,</para>
  <para style="q2" vid="JER 6:30">काबरकि यहोवा ह ओमन ला अस्वीकार करे हवय।”<verse eid="JER 6:30" /></para>
  <chapter eid="JER 6" />
  <chapter number="7" style="c" sid="JER 7" />
  <para style="s1">लबारी धरम ह बेकार ए</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 7:1" />यहोवा कोति ले ये बचन यरमियाह करा आईस: <verse eid="JER 7:1" /><verse number="2" style="v" sid="JER 7:2" />“यहोवा के घर के दुवार म ठाढ़ हो जा अऊ उहां ये संदेस के घोसना कर:</para>
  <para style="p" vid="JER 7:2">“ ‘हे यहूदा के जम्मो मनखेमन, जऊन मन यहोवा के अराधना करे बर ये दुवारमन ले आथव, यहोवा के ये बचन ला सुनव। <verse eid="JER 7:2" /><verse number="3" style="v" sid="JER 7:3" />सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: अपन चालचलन अऊ अपन काममन ला सुधारव, तब मेंह तुमन ला ये जगह म रहे बर दूहूं। <verse eid="JER 7:3" /><verse number="4" style="v" sid="JER 7:4" />धोखा देवइया बचन म भरोसा करके ये झन कहव, “येह यहोवा के मंदिर अय, यहोवा के मंदिर, यहोवा के मंदिर!” <verse eid="JER 7:4" /><verse number="5" style="v" sid="JER 7:5" />यदि तुमन सही म अपन चालचलन अऊ काममन ला बदलथव अऊ एक-दूसर के संग सही बरताव करथव, <verse eid="JER 7:5" /><verse number="6" style="v" sid="JER 7:6" />यदि तुमन परदेसी, अनाथ या बिधवा ऊपर अतियाचार नइं करव अऊ ये जगह म निरदोस के हतिया नइं करव, अऊ यदि अपन खुद के हानि करे बर आने देवतामन के पाछू नइं चलव, <verse eid="JER 7:6" /><verse number="7" style="v" sid="JER 7:7" />त मेंह तुमन ला ये जगह म, ये देस म रहे बर दूहूं, जऊन ला कि मेंह तुम्हर पुरखामन ला सदाकाल बर दे हवंव। <verse eid="JER 7:7" /><verse number="8" style="v" sid="JER 7:8" />पर देखव, तुमन ओ धोखा देवइया बचन ऊपर भरोसा करत हव, जेकर कोनो मतलब नइं ए।<verse eid="JER 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 7:9" />“ ‘का तुमन चोरी अऊ हतिया करहू, बेभिचार अऊ लबारी गवाही दूहू, बाल देवता बर धूप जलाहू अऊ आने देवतामन के पाछू चलहू, जेमन ला तुमन नइं जानव, <verse eid="JER 7:9" /><verse number="10" style="v" sid="JER 7:10" />अऊ तब ये घर, जऊन म कि मोर नांव हवय, तुमन येमा आके मोर आघू म ठाढ़ होहू अऊ ये कहिहू, “हमन सुरकछित हवन”—ये जम्मो घिनौना काम करे बर सुरकछित हवन? <verse eid="JER 7:10" /><verse number="11" style="v" sid="JER 7:11" />ये घर, जेमा मोर नांव हवय, का येह तुम्हर बर डाकूमन के गुफा हो गे हवय? पर मेंह देखत आवत हंव! यहोवा ह घोसना करत हे।<verse eid="JER 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 7:12" />“ ‘अब सीलो नगर म ओ जगह म जावव, जिहां पहिली मेंह मोर नांव बर एक निवास बनाय रहेंव, अऊ देखव कि मेंह अपन मनखे इसरायल के दुस्टता के कारन ओ निवास के का दसा कर दे हंव। <verse eid="JER 7:12" /><verse number="13" style="v" sid="JER 7:13" />यहोवा ह घोसना करत हे, जब तुमन ये जम्मो काम करत रहेव, त मेंह तुमन ला बार-बार कहेंव, पर तुमन नइं सुनेव; मेंह तुमन ला बलांय, पर तुमन जबाब नइं देव। <verse eid="JER 7:13" /><verse number="14" style="v" sid="JER 7:14" />एकरसेति ये घर, जेमा मोर नांव हवय, ये मंदिर, जेमा तुमन भरोसा करथव, ये जगह, जेला मेंह तुमन ला अऊ तुम्हर पुरखामन ला देय रहेंव, येकर दसा घलो मेंह सीलो के सहीं कर दूहूं। <verse eid="JER 7:14" /><verse number="15" style="v" sid="JER 7:15" />जइसने कि मेंह तुम्हर जम्मो संगी इसरायली, एपरैम के मनखेमन संग करे रहेंव, वइसने ही मेंह तुमन ला अपन आघू ले धक्का देके निकाल दूहूं।’<verse eid="JER 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 7:16" />“एकरसेति ये मनखेमन बर तेंह पराथना झन कर अऊ न ही येमन बर कोनो बिनती या निबेदन कर; मोर करा येमन के तरफ ले झन गोठिया, काबरकि मेंह तोर बात ला नइं सुनंव। <verse eid="JER 7:16" /><verse number="17" style="v" sid="JER 7:17" />का तेंह नइं देखत हस कि ये मनखेमन यहूदा के नगरमन म अऊ यरूसलेम के गलीमन म का करत हवंय? <verse eid="JER 7:17" /><verse number="18" style="v" sid="JER 7:18" />लइकामन कठवा संकेलथें, ददामन आगी सुलगाथें, अऊ माईलोगनमन पीसान गुंथके स्वरग के रानी ला चघाय बर रोटी बनाथें। ओमन मोर गुस्सा ला भड़काय बर आने देवतामन बर पेय-बलिदान देथें। <verse eid="JER 7:18" /><verse number="19" style="v" sid="JER 7:19" />पर का ओमन मोला ही भड़कावथें? यहोवा ह घोसना करत हे। का ओमन बेसरम होके अपनआप के ही हानि नइं करत हें?<verse eid="JER 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 7:20" />“ ‘एकरसेति परमपरधान यहोवा ह ये कहत हे: मोर गुस्सा अऊ मोर कोप ह ये जगह के ऊपर भड़कही—मनखे अऊ पसु ऊपर, मैदान के रूखमन ऊपर अऊ तुम्हर भुइयां के फसल ऊपर—अऊ ये गुस्सा अऊ कोप के आगी ह जलते रहिही अऊ नइं बुताही।<verse eid="JER 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 7:21" />“ ‘सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: जावव अऊ अपन होम-बलिदानमन ला अपन आने बलिदानमन संग मिलावव अऊ मांस ला खुद खावव! <verse eid="JER 7:21" /><verse number="22" style="v" sid="JER 7:22" />काबरकि जब मेंह तुम्हर पुरखामन ला मिसर देस ले बाहिर लानेंव अऊ ओमन ले बात करेंव, त मेंह ओमन ला होम-बलिदान अऊ बलिदानमन के बारे म हुकूम नइं दे रहेंव, <verse eid="JER 7:22" /><verse number="23" style="v" sid="JER 7:23" />पर मेंह ओमन ला ये हुकूम देय रहेंव: मोर बात ला मानव, तब मेंह तुम्हर परमेसर होहूं अऊ तुमन मोर मनखे होहू। मोर दिये गय जम्मो हुकूम के पालन करव, ताकि तुम्हर भलई होवय। <verse eid="JER 7:23" /><verse number="24" style="v" sid="JER 7:24" />पर ओमन मोर बात ला नइं सुनिन अऊ धियान नइं दीन; येकर बदले, ओमन अपन दुस्ट हिरदय के जिद्दी सुभाव म चलिन। ओमन पाछू हट गीन अऊ आघू नइं बढ़िन। <verse eid="JER 7:24" /><verse number="25" style="v" sid="JER 7:25" />जऊन समय ले तुम्हर पुरखामन मिसर देस ला छोंड़िन, बार-बार मेंह अपन सेवक अगमजानीमन ला तुम्हर करा पठोंय। <verse eid="JER 7:25" /><verse number="26" style="v" sid="JER 7:26" />पर ओमन मोर बात ला नइं सुनिन अऊ धियान नइं दीन। ओमन हठी रिहिन अऊ अपन पुरखामन ले बढ़के दुस्ट काम करिन।’<verse eid="JER 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 7:27" />“जब तेंह ओमन ला ये जम्मो बात बताबे, त ओमन तोर बात ला नइं सुनहीं; जब तेंह ओमन ला बलाबे, त ओमन जबाब नइं दीहीं। <verse eid="JER 7:27" /><verse number="28" style="v" sid="JER 7:28" />एकरसेति ओमन ले कह, ‘येह ओ जाति ए, जऊन ह यहोवा अपन परमेसर के बात ला नइं माने हे या अपन गलत काममन ला नइं छोंड़े हे। सच्चई ह मर गे हवय; येह ओमन के मुहूं ले गायब हो गे हवय।<verse eid="JER 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 7:29" />“ ‘अपन चुंदी ला काट अऊ दूरिहा म फटिक दे; बंजर टीला म चघके बिलाप कर, काबरकि यहोवा ह ये पीढ़ी के मनखेमन ला अस्वीकार करे हवय, ओमन ला तियाग दे हवय; ओमन ओकर कोप के भागी अंय।<verse eid="JER 7:29" /></para>
  <para style="s1">हतिया के घाटी</para>
  <para style="p">
    <verse number="30" style="v" sid="JER 7:30" />“ ‘यहूदा के मनखेमन मोर नजर म दुस्ट काम करे हवंय, यहोवा ह घोसना करत हे। ओमन ओ घर म घिनौना मूरतीमन ला रखे हवंय, जेमा मोर नांव हवय; अइसने करके ओमन ओ घर ला असुध कर दे हवंय। <verse eid="JER 7:30" /><verse number="31" style="v" sid="JER 7:31" />ओमन बेन-हिन्नोम के घाटी म अपन बेटा अऊ बेटीमन ला आगी म जलाय बर तोपेत के ऊंचहा जगहमन ला बनाय हवंय—जेकर हुकूम मेंह कभू नइं दे रहेंव अऊ न ही ये बात कभू मोर मन म आईस। <verse eid="JER 7:31" /><verse number="32" style="v" sid="JER 7:32" />एकरसेति सचेत रहव, ओ दिनमन आवत हें, यहोवा ह ये घोसना करत हे, जब मनखेमन येला तोपेत या बेन-हिन्नोम के घाटी नइं कहिहीं, पर येला हतिया के घाटी कहिहीं, काबरकि ओमन तोपेत म अतेक मनखेमन ला माटी दीहीं कि उहां जगह ही नइं बचही। <verse eid="JER 7:32" /><verse number="33" style="v" sid="JER 7:33" />तब ये मनखेमन के लासमन चिरई अऊ जंगली पसुमन के जेवन होहीं, अऊ ओमन ला भगानेवाला कोनो नइं होहीं। <verse eid="JER 7:33" /><verse number="34" style="v" sid="JER 7:34" />मेंह यहूदा के नगरमन म अऊ यरूसलेम के गलीमन म आनंद अऊ खुसी के अवाज अऊ दूल्हा अऊ दुलहिन के अवाज ला खतम कर दूहूं, काबरकि देस ह उजाड़ हो जाही।<verse eid="JER 7:34" /></para>
  <chapter eid="JER 7" />
  <chapter number="8" style="c" sid="JER 8" />
  <para style="p">
    <verse number="1" style="v" sid="JER 8:1" />“ ‘यहोवा ह ये घोसना करत हे: ओ बेरा, यहूदा के राजा अऊ करमचारीमन के हाड़ा, पुरोहित अऊ अगमजानीमन के हाड़ा, अऊ यरूसलेम के मनखेमन के हाड़ा ला ओमन के कबरमन ले निकाले जाही। <verse eid="JER 8:1" /><verse number="2" style="v" sid="JER 8:2" />ओमन ला सूरज, चंदा अऊ अकास के जम्मो तारामन के आघू म रखे जाही; काबरकि ओ मनखेमन ये चीजमन ले मया करिन, येमन के सेवा करिन, येमन के पाछू चलिन, येमन के सलाह लीन अऊ येमन के अराधना करिन। ये हाड़ामन ला न तो संकेले जाही, न तो येमन ला गाड़े जाही, पर येमन भुइयां म सूखा गोबर सहीं पड़े रहिहीं। <verse eid="JER 8:2" /><verse number="3" style="v" sid="JER 8:3" />जिहां कहूं भी मेंह येमन ला भगाहूं, उहां ये दुस्ट जाति के बांचे जम्मो मनखेमन जीयत रहे के बदले मरना पसंद करहीं, सर्वसक्तिमान यहोवा ह घोसना करत हे।’<verse eid="JER 8:3" /></para>
  <para style="s1">पाप अऊ सजा</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 8:4" />“ओमन ला कह, ‘यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 8:4">“ ‘जब मनखेमन गिरथें, त का ओमन फेर नइं उठंय?</para>
  <para style="q2" vid="JER 8:4">जब कोनो मुहूं मोड़के चल देथे, त का ओह फेर नइं लहुंटय?<verse eid="JER 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 8:5" />त फेर ये मनखेमन काबर मुहूं मोड़के चल दे हवंय?</para>
  <para style="q2" vid="JER 8:5">काबर यरूसलेम ह हमेसा मुहूं मोड़के चल देथे?</para>
  <para style="q1" vid="JER 8:5">ओमन धोखा देते रहिथें;</para>
  <para style="q2" vid="JER 8:5">ओमन लहुंटे नइं चाहंय।<verse eid="JER 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 8:6" />मेंह धियान देके ओमन के बात ला सुने हंव,</para>
  <para style="q2" vid="JER 8:6">पर ओमन सही बात ला नइं कहंय।</para>
  <para style="q1" vid="JER 8:6">ओमा के कोनो भी अपन दुस्टता ले नइं पछतांय,</para>
  <para style="q2" vid="JER 8:6">पर ये कहिथें, “मेंह का करे हंव?”</para>
  <para style="q1" vid="JER 8:6">जइसने घोड़ा ह लड़ई म हमला करथे,</para>
  <para style="q2" vid="JER 8:6">वइसने ही येमा के हर एक झन अपन हिसाब से चलथे।<verse eid="JER 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 8:7" />इहां तक कि अकास के सारस चिरई ह</para>
  <para style="q2" vid="JER 8:7">अपन ठहिराय समय ला जानथे,</para>
  <para style="q1" vid="JER 8:7">अऊ पंड़की, सूपाबेनी अऊ तूती चिरई घलो</para>
  <para style="q2" vid="JER 8:7">आने जगह जाय के सही बेरा ला जानथें।</para>
  <para style="q1" vid="JER 8:7">पर मोर मनखेमन यहोवा के</para>
  <para style="q2" vid="JER 8:7">नियममन ला नइं जानंय।<verse eid="JER 8:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JER 8:8" />“ ‘तुमन कइसे कह सकत हव, “हमन बुद्धिमान अन,</para>
  <para style="q2" vid="JER 8:8">काबरकि हमर करा यहोवा के कानून हवय,”</para>
  <para style="q1" vid="JER 8:8">जबकि असल म, कानून के गुरूमन लबारी बात लिखके</para>
  <para style="q2" vid="JER 8:8">येकर गलत तरीका से उपयोग करे हवंय?<verse eid="JER 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 8:9" />बुद्धिमान मनखेमन लज्जित होहीं;</para>
  <para style="q2" vid="JER 8:9">ओमन डराहीं अऊ पकड़े जाहीं।</para>
  <para style="q1" vid="JER 8:9">जब ओमन यहोवा के बचन ला नइं माने हवंय,</para>
  <para style="q2" vid="JER 8:9">त ओमन करा का किसम के बुद्धि हवय?<verse eid="JER 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 8:10" />ये कारन से मेंह ओमन के घरवालीमन ला आने मनखेमन ला</para>
  <para style="q2" vid="JER 8:10">अऊ ओमन के खेतमन ला नवां मालिकमन ला दे दूहूं।</para>
  <para style="q1" vid="JER 8:10">छोटे ले लेके बड़े तक,</para>
  <para style="q2" vid="JER 8:10">जम्मो के जम्मो अनाज के लालची अंय;</para>
  <para style="q1" vid="JER 8:10">अगमजानी अऊ पुरोहितमन घलो वइसने</para>
  <para style="q2" vid="JER 8:10">जम्मो के जम्मो धोखाधड़ी करथें।<verse eid="JER 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 8:11" />ओमन मोर मनखेमन के घावमन म अइसे पट्टी बांधथें</para>
  <para style="q2" vid="JER 8:11">मानो ओमा जादा चोट नइं लगे रिहिस।</para>
  <para style="q1" vid="JER 8:11">ओमन कहिथें, “सांति हे, सांति हे,”</para>
  <para style="q2" vid="JER 8:11">जबकि उहां सांति नइं ए।<verse eid="JER 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 8:12" />का ओमन अपन घिनौना बरताव बर सरमिंदा हवंय?</para>
  <para style="q2" vid="JER 8:12">नइं, ओमन बिलकुल ही सरमिंदा नइं एं।</para>
  <para style="q2" vid="JER 8:12">ओमन सरमिंदा होवई जानंय ही नइं।</para>
  <para style="q1" vid="JER 8:12">एकरसेति ओमन गिरे मनखेमन के बीच म गिरहीं;</para>
  <para style="q2" vid="JER 8:12">ओमन गिराय जाहीं, जब ओमन ला सजा मिलही,</para>
  <para style="q2" vid="JER 8:12">यहोवा ह कहत हे।<verse eid="JER 8:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 8:13" />“ ‘मेंह ओमन के फसल ला ले लूहूं,</para>
  <para style="q2" vid="JER 8:13">यहोवा ह घोसना करत हे।</para>
  <para style="q2" vid="JER 8:13">अंगूर के नार म अंगूर नइं होही।</para>
  <para style="q1" vid="JER 8:13">अंजीर के रूख म अंजीर नइं होही,</para>
  <para style="q2" vid="JER 8:13">अऊ ओमन के पानमन सूखा जाहीं।</para>
  <para style="q1" vid="JER 8:13">जऊन कुछू मेंह ओमन ला देय हवंव,</para>
  <para style="q2" vid="JER 8:13">ओह ओमन ले, लेय लिये जाही।’ ”<verse eid="JER 8:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 8:14" />हमन इहां काबर बईठे हवन?</para>
  <para style="q2" vid="JER 8:14">इकट्ठा हो जावव!</para>
  <para style="q1" vid="JER 8:14">आवव, हमन किलाबंदीवाले सहरमन म भाग चलन</para>
  <para style="q2" vid="JER 8:14">अऊ उहां नास हो जावन!</para>
  <para style="q1" vid="JER 8:14">काबरकि यहोवा हमर परमेसर ह हमन ला नास करे बर ठाने हे</para>
  <para style="q2" vid="JER 8:14">अऊ हमन ला जहर-पानी पीये बर दे हवय,</para>
  <para style="q2" vid="JER 8:14">काबरकि हमन यहोवा के बिरूध पाप करे हवन।<verse eid="JER 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 8:15" />हमन सांति के आसा करत रहेंन</para>
  <para style="q2" vid="JER 8:15">पर कुछू बने बात नइं होईस,</para>
  <para style="q1" vid="JER 8:15">हमन चंगई के आसा करत रहेंन</para>
  <para style="q2" vid="JER 8:15">पर उहां सिरिप आतंक ही आतंक हवय।<verse eid="JER 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 8:16" />बईरी के घोड़ामन के हिनहिनाय के अवाज</para>
  <para style="q2" vid="JER 8:16">दान सहर ले सुनई पड़त हे;</para>
  <para style="q1" vid="JER 8:16">ओमन के बिगर बधिया करे गे घोड़ामन के हिनहिनाय के अवाज ले</para>
  <para style="q2" vid="JER 8:16">जम्मो देस ह कांपत हे।</para>
  <para style="q1" vid="JER 8:16">ओमन देस अऊ येमा के हर चीज,</para>
  <para style="q2" vid="JER 8:16">सहर अऊ उहां रहइया जम्मो झन ला</para>
  <para style="q2" vid="JER 8:16">नास करे बर आय हवंय।<verse eid="JER 8:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 8:17" />“देखव, मेंह तुम्हर बीच म अइसने जहरिला सांपमन ला पठोहूं,</para>
  <para style="q2" vid="JER 8:17">ओ जहरिला सांपमन, जऊन मन ला बस म नइं करे जा सकय,</para>
  <para style="q2" vid="JER 8:17">अऊ ओमन तुमन ला डसहीं,”</para>
  <para style="q2" vid="JER 8:17">यहोवा ह घोसना करत हे।<verse eid="JER 8:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 8:18" />तेंह दुख म मोला सांति देवइया अस,</para>
  <para style="q2" vid="JER 8:18">मोर हिरदय ह मोर भीतर म दुरबल हो गे हवय।<verse eid="JER 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 8:19" />मोर मनखेमन के चिचियाय के अवाज ला</para>
  <para style="q2" vid="JER 8:19">दूरिहा के देस ले सुनव:</para>
  <para style="q1" vid="JER 8:19">“का यहोवा ह सियोन म नइं ए?</para>
  <para style="q2" vid="JER 8:19">का सियोन के राजा ह अब उहां नइं ए?”</para>
  <para style="b" vid="JER 8:19" />
  <para style="q1" vid="JER 8:19">“ओमन काबर मोर गुस्सा ला अपन मूरती</para>
  <para style="q2" vid="JER 8:19">अऊ परदेस के बेकार मूरतीमन के दुवारा भड़काय हवंय?”<verse eid="JER 8:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 8:20" />“फसल लुये के समय ह बीत गीस,</para>
  <para style="q2" vid="JER 8:20">गरमी ह खतम हो गीस,</para>
  <para style="q2" vid="JER 8:20">अऊ हमर उद्धार नइं होईस।”<verse eid="JER 8:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 8:21" />जब मोर मनखेमन कुचरे जाथें, त महूं घलो कुचरे जाथंव;</para>
  <para style="q2" vid="JER 8:21">मेंह सोकित हंव, अऊ मोर मन म डर हमा गे हवय।<verse eid="JER 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 8:22" />का गिलाद देस म कुछू मलहम नइं ए?</para>
  <para style="q2" vid="JER 8:22">का उहां कोनो बईद नइं एं?</para>
  <para style="q1" vid="JER 8:22">त फेर मोर मनखेमन के घाव ह</para>
  <para style="q2" vid="JER 8:22">काबर चंगा नइं होवत हे?<verse eid="JER 8:22" /></para>
  <chapter eid="JER 8" />
  <chapter number="9" style="c" sid="JER 9" />
  <para style="q1">
    <verse number="1" style="v" sid="JER 9:1" />आह, बने होतिस कि मोर मुड़ ह पानी के सोता</para>
  <para style="q2" vid="JER 9:1">अऊ मोर आंखीमन आंसूमन के सोता होतिन!</para>
  <para style="q1" vid="JER 9:1">मेंह रात अऊ दिन</para>
  <para style="q2" vid="JER 9:1">अपन मारे गय मनखेमन बर रोतेंव।<verse eid="JER 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 9:2" />आह, बने होतिस कि डहार रेंगइयामन बर</para>
  <para style="q2" vid="JER 9:2">मोर करा मरू-भुइयां म ठहिरे के एक जगह होतिस,</para>
  <para style="q1" vid="JER 9:2">ताकि मेंह अपन मनखेमन ला छोंड़के</para>
  <para style="q2" vid="JER 9:2">ओमन ले दूरिहा चल देतेंव;</para>
  <para style="q1" vid="JER 9:2">काबरकि ओमन जम्मो बेभिचारी अंय,</para>
  <para style="q2" vid="JER 9:2">बिसवासघाती मनखेमन के एक भीड़ अंय।<verse eid="JER 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JER 9:3" />“ओमन अपन जीभ ला धनुस म चघाय तीर सहीं</para>
  <para style="q2" vid="JER 9:3">लबारी मारे बर तियार रहिथें;</para>
  <para style="q1" vid="JER 9:3">ओमन सच्चई के दुवारा</para>
  <para style="q2" vid="JER 9:3">देस म जय नइं पावंय।</para>
  <para style="q1" vid="JER 9:3">ओमन एक पाप ले दूसर पाप करते रहिथें;</para>
  <para style="q2" vid="JER 9:3">ओमन मोला नइं चिनहंय,”</para>
  <para style="q2" vid="JER 9:3">यहोवा ह घोसना करत हे।<verse eid="JER 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 9:4" />“अपन संगीमन ले सचेत रहव;</para>
  <para style="q2" vid="JER 9:4">अपन बंस के कोनो मनखे ऊपर भरोसा झन करव।</para>
  <para style="q1" vid="JER 9:4">काबरकि ओमा के हर एक झन एक धोखा देवइया,</para>
  <para style="q2" vid="JER 9:4">अऊ हर एक परोसी एक निंदा-करइया ए।<verse eid="JER 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 9:5" />संगी ह संगी ला धोखा देथे,</para>
  <para style="q2" vid="JER 9:5">अऊ सच बात कोनो नइं कहंय।</para>
  <para style="q1" vid="JER 9:5">ओमन अपन जीभ ला लबारी मारे बर सिखोय हवंय;</para>
  <para style="q2" vid="JER 9:5">ओमन पाप कर-करके अपनआप ला थकात हें।<verse eid="JER 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 9:6" />तेंह<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">याने कि </char><char style="fqa" closed="false">यरमियाह</char></note> छल-कपट के बीच म रहिथस;</para>
  <para style="q2" vid="JER 9:6">अपन छल-कपट म, ओमन मोला चिनहे बर इनकार करथें,”</para>
  <para style="q2" vid="JER 9:6">यहोवा ह घोसना करत हे।<verse eid="JER 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 9:7" />एकरसेति सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 9:7">“देखव, मेंह ओमन ला तिपोके सुध करहूं अऊ परखहूं,</para>
  <para style="q2" vid="JER 9:7">काबरकि मोर मनखेमन के पाप के कारन</para>
  <para style="q2" vid="JER 9:7">मेंह अऊ का कर सकत हंव?<verse eid="JER 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 9:8" />ओमन के जीभ ह मिरतू के तीर सहीं अय;</para>
  <para style="q2" vid="JER 9:8">येह छल-कपट के बात करथे।</para>
  <para style="q1" vid="JER 9:8">अपन मुहूं ले ओमन अपन परोसीमन ले बड़े मया के संग गोठियाथें,</para>
  <para style="q2" vid="JER 9:8">पर ओमन अपन मन म अपन परोसीमन ला फंसाय के बात सोचथें।<verse eid="JER 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 9:9" />का मेंह अइसने बात बर ओमन ला सजा नइं दंव?”</para>
  <para style="q2" vid="JER 9:9">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 9:9">“का मेंह अइसने जाति ले</para>
  <para style="q2" vid="JER 9:9">खुद बदला नइं लंव?”<verse eid="JER 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 9:10" />मेंह पहाड़मन बर रोहूं अऊ बिलाप करहूं</para>
  <para style="q2" vid="JER 9:10">अऊ जंगल के चरागनमन के बारे म बिलाप के गीत गाहूं।</para>
  <para style="q1" vid="JER 9:10">ओमन उजाड़ पड़े हवंय अऊ उहां कोनो नइं जावंय,</para>
  <para style="q2" vid="JER 9:10">अऊ उहां गरूवा-बईलामन के नरियाय के अवाज सुनई नइं पड़य।</para>
  <para style="q1" vid="JER 9:10">जम्मो चिरईमन भाग गे हवंय</para>
  <para style="q2" vid="JER 9:10">अऊ पसुमन चले गे हवंय।<verse eid="JER 9:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 9:11" />“मेंह यरूसलेम ला एक खंडहर,</para>
  <para style="q2" vid="JER 9:11">सियारमन के एक डेरा बना दूहूं;</para>
  <para style="q1" vid="JER 9:11">अऊ मेंह यहूदा के नगरमन ला अइसने उजाड़ दूहूं</para>
  <para style="q2" vid="JER 9:11">कि उहां कोनो नइं रह सकहीं।”<verse eid="JER 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 9:12" />कोन ह अतेक बुद्धिमान ए कि येला समझय? यहोवा ह कोन ला बताय हवय कि ओह येला समझा सकय? देस के काबर बिनास हो गे हवय अऊ मरू-भुइयां सहीं उजाड़ पड़े हवय कि येला कोनो पार नइं कर सकंय?<verse eid="JER 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 9:13" />यहोवा ह कहिस, “येह एकर कारन होईस काबरकि ओमन मोर ओ कानून ला तियाग दे हवंय, जऊन ला मेंह ओमन के आघू रखे रहेंव; ओमन न तो मोर बात मानिन अऊ न ही मोर कानून के मुताबिक चलिन। <verse eid="JER 9:13" /><verse number="14" style="v" sid="JER 9:14" />एकर बदला, ओमन अपन मन के जिद्दी सुभाव के मुताबिक चलिन; ओमन बाल देवतामन के पाछू चलिन, जइसने कि ओमन के पुरखामन ओमन ला सिखाय रिहिन।” <verse eid="JER 9:14" /><verse number="15" style="v" sid="JER 9:15" />एकरसेति सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: “सुनव, मेंह ये मनखेमन ला करू जेवन खवाहूं अऊ जहरिला पानी पीयाहूं। <verse eid="JER 9:15" /><verse number="16" style="v" sid="JER 9:16" />मेंह ओमन ला अइसने देसमन के बीच म तितिर-बितिर कर दूहूं, जेला न तो ओमन अऊ न ही ओमन के पुरखामन जानत रिहिन, अऊ जब तक मेंह ओमन के अन्त नइं कर दूहूं, तब तक मेंह तलवार लेके ओमन के पाछू पड़े रहिहूं।”<verse eid="JER 9:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="JER 9:17" />सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 9:17">“अब सोच-बिचार करव! बिलाप करइया माईलोगनमन ला बलावव;</para>
  <para style="q2" vid="JER 9:17">ओमा के सबले जादा कुसल माईलोगन ला बलावव।<verse eid="JER 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 9:18" />ओमन जल्दी आवंय</para>
  <para style="q2" vid="JER 9:18">अऊ हमर बर तब तक बिलाप करंय</para>
  <para style="q1" vid="JER 9:18">जब तक कि हमर आंखीमन ले आंसू नइं निकलय</para>
  <para style="q2" vid="JER 9:18">अऊ हमर आंखी के पलकमन ले पानी बहे नइं लगय।<verse eid="JER 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 9:19" />सियोन ले बिलाप करे के अवाज सुनई देवत हे:</para>
  <para style="q2" vid="JER 9:19">‘हमन कतेक नास हो गेंन!</para>
  <para style="q2" vid="JER 9:19">हमन कतेक बड़े लज्जा म पड़ेंन!</para>
  <para style="q1" vid="JER 9:19">जरूरी ए कि हमन हमर देस ला छोंड़ देवन</para>
  <para style="q2" vid="JER 9:19">काबरकि हमर घरमन ला गिरा दिये गे हवय।’ ”<verse eid="JER 9:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 9:20" />एकरसेति, हे माईलोगनमन, यहोवा के ये बचन ला सुनव;</para>
  <para style="q2" vid="JER 9:20">ओकर मुहूं के बचन ला कान लगाके सुनव।</para>
  <para style="q1" vid="JER 9:20">अपन बेटीमन ला बिलाप करे बर सिखावव;</para>
  <para style="q2" vid="JER 9:20">एक-दूसर ला एक बिलाप के गीत सिखावव।<verse eid="JER 9:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 9:21" />मिरतू ह हमर खिड़कीमन ले होके भीतर आ गे हवय</para>
  <para style="q2" vid="JER 9:21">अऊ हमर गढ़मन म घुस गे हवय;</para>
  <para style="q1" vid="JER 9:21">येह लइकामन ला गलीमन ले</para>
  <para style="q2" vid="JER 9:21">अऊ जवानमन ला चऊक ले मिटा दे हवय।<verse eid="JER 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 9:22" />तेंह कह, “यहोवा ह ये घोसना करत हे:</para>
  <para style="q1" vid="JER 9:22">“ ‘मनखेमन के लासमन अइसने पड़े रहिहीं,</para>
  <para style="q2" vid="JER 9:22">जइसने खुला मैदान म गोबर,</para>
  <para style="q1" vid="JER 9:22">अऊ फसल लुवइया के पाछू लुये गय फसल,</para>
  <para style="q2" vid="JER 9:22">जेला कोनो संकेलनेवाला नइं रहंय।’ ”<verse eid="JER 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 9:23" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 9:23">“बुद्धिमान ह अपन बुद्धि ऊपर घमंड झन करय</para>
  <para style="q2" vid="JER 9:23">या बलवान ह अपन बल ऊपर घमंड झन करय</para>
  <para style="q2" vid="JER 9:23">या धनवान ह अपन धन ऊपर घमंड झन करय,<verse eid="JER 9:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 9:24" />पर जऊन ह घमंड करथे, ओह ये बात म घमंड करय:</para>
  <para style="q2" vid="JER 9:24">कि ओमन करा मोला जाने के समझ हवय,</para>
  <para style="q1" vid="JER 9:24">कि में ही ओ यहोवा अंव, जऊन ह धरती म</para>
  <para style="q2" vid="JER 9:24">दया, नियाय अऊ धरमीपन के काम करथंव,</para>
  <para style="q2" vid="JER 9:24">काबरकि इही बातमन म मेंह खुस होथंव,”</para>
  <para style="q2" vid="JER 9:24">यहोवा ह घोसना करत हे।<verse eid="JER 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 9:25" />“ओ दिनमन आवत हें,” यहोवा ह घोसना करत हे, “जब मेंह ओ जम्मो झन ला सजा दूहूं, जेमन के खतना सिरिप देहें म होय हवय— <verse eid="JER 9:25" /><verse number="26" style="v" sid="JER 9:26" />याने कि मिसर, यहूदा, एदोम, अमोन, मोआब के मनखे अऊ ओ जम्मो जऊन मन दूरिहा म सुनसान जगह म रहिथें। काबरकि ये जम्मो जातिमन सही म खतनारहित अंय, अऊ त अऊ इसरायल के जम्मो घराना ह घलो मन म खतनारहित अय।”<verse eid="JER 9:26" /></para>
  <chapter eid="JER 9" />
  <chapter number="10" style="c" sid="JER 10" />
  <para style="s1">परमेसर अऊ मूरतीमन</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 10:1" />हे इसरायल के मनखेमन, यहोवा ह तुमन ले का कहत हे, ओला सुनव। <verse eid="JER 10:1" /><verse number="2" style="v" sid="JER 10:2" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 10:2">“आने देसमन के चालचलन ला झन सीखव</para>
  <para style="q2" vid="JER 10:2">या अकास म चिनहांमन ला देखके आतंकित झन होवव,</para>
  <para style="q2" vid="JER 10:2">हालाकि आने देस के मनखेमन ओमन के दुवारा आतंकित होथें।<verse eid="JER 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 10:3" />काबरकि मनखेमन के रीति-रिवाजमन बेकार अंय;</para>
  <para style="q2" vid="JER 10:3">ओमन जंगल ले एक रूख ला काटथें,</para>
  <para style="q2" vid="JER 10:3">अऊ कारीगर ह बिंधना ले ओला आकार देथे।<verse eid="JER 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 10:4" />ओमन ओला सोन अऊ चांदी ले सजाथें;</para>
  <para style="q2" vid="JER 10:4">ओमन ओला हथौड़ी ले खीला ठोंकके मजबूत करथें</para>
  <para style="q2" vid="JER 10:4">ताकि ओह झन हालय-डोलय।<verse eid="JER 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 10:5" />खीरा के खेत म ठाढ़े पुतला<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false">चिरईमन ला डराय के पुतला</char></note> सहीं,</para>
  <para style="q2" vid="JER 10:5">ओमन के मूरतीमन गोठियाय नइं सकंय;</para>
  <para style="q1" vid="JER 10:5">ओमन ला उठाके ले जाय ला पड़थे</para>
  <para style="q2" vid="JER 10:5">काबरकि ओमन रेंग नइं सकंय।</para>
  <para style="q1" vid="JER 10:5">ओमन ले झन डरव;</para>
  <para style="q2" vid="JER 10:5">ओमन कोनो हानि नइं कर सकंय</para>
  <para style="q2" vid="JER 10:5">न ही ओमन कोनो भलई कर सकंय।”<verse eid="JER 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 10:6" />हे यहोवा, तोर सहीं कोनो नइं एं;</para>
  <para style="q2" vid="JER 10:6">तेंह महान अस,</para>
  <para style="q2" vid="JER 10:6">अऊ तोर नांव ह ताकत म बहुंत बड़े अय।<verse eid="JER 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 10:7" />हे जम्मो जातिमन के राजा,</para>
  <para style="q2" vid="JER 10:7">तोर ले कोन नइं डरही?</para>
  <para style="q2" vid="JER 10:7">तें ही येकर लईक अस।</para>
  <para style="q1" vid="JER 10:7">जातिमन के जम्मो बुद्धिमान अगुवामन के बीच म</para>
  <para style="q2" vid="JER 10:7">अऊ ओमन के जम्मो राजमन म,</para>
  <para style="q2" vid="JER 10:7">तोर सहीं कोनो नइं एं।<verse eid="JER 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JER 10:8" />ओमन जम्मो निरबुद्धि अऊ मुरूख अंय;</para>
  <para style="q2" vid="JER 10:8">ओमन बेकार के कठवा के मूरतीमन के दुवारा सिखाय जाथें।<verse eid="JER 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 10:9" />पीटे गय चांदी ह तरसीस ले</para>
  <para style="q2" vid="JER 10:9">अऊ उफाज ले सोन लाय जाथे।</para>
  <para style="q1" vid="JER 10:9">जऊन चीज ला कारीगर अऊ सुनार बनाथें,</para>
  <para style="q2" vid="JER 10:9">ओला नीला अऊ बैंगनी रंग के ओनहा पहिराय जाथे—</para>
  <para style="q2" vid="JER 10:9">जम्मो चीजमन कुसल कारीगरमन के दुवारा बनाय गे रहिथें।<verse eid="JER 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 10:10" />पर यहोवा ही सच्चा परमेसर अय;</para>
  <para style="q2" vid="JER 10:10">ओह जीयत परमेसर अऊ सदाकाल के राजा अय।</para>
  <para style="q1" vid="JER 10:10">जब ओह गुस्सा करथे, त धरती ह कांपथे;</para>
  <para style="q2" vid="JER 10:10">जाति-जाति के मनखेमन ओकर कोप ला सह नइं सकंय।<verse eid="JER 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 10:11" />“ओमन ला ये कह: ‘ये देवता, जेमन धरती अऊ अकासमन ला नइं बनाईन, येमन धरती ले अऊ अकासमन के खाल्हे ले नास हो जाहीं।’ ”<verse eid="JER 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 10:12" />पर परमेसर ह धरती ला अपन सामर्थ ले बनाईस;</para>
  <para style="q2" vid="JER 10:12">ओह अपन बुद्धि ले संसार के नीव रखिस</para>
  <para style="q2" vid="JER 10:12">अऊ अपन समझ के दुवारा अकासमन ला तानिस।<verse eid="JER 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 10:13" />जब ओह गरजथे, त अकासमन म पानी ह गरजथे,</para>
  <para style="q2" vid="JER 10:13">ओह धरती के छोर ले बादरमन ला उठाथे।</para>
  <para style="q1" vid="JER 10:13">ओह बारिस के संग बिजली चमकाथे</para>
  <para style="q2" vid="JER 10:13">अऊ अपन भंडारघर ले हवा चलाथे।<verse eid="JER 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 10:14" />हर एक जन निरबुद्धि अऊ बिगर गियान के हवय;</para>
  <para style="q2" vid="JER 10:14">हर एक सुनार ह अपन बनाय मूरतीमन के कारन लज्जित हवय।</para>
  <para style="q1" vid="JER 10:14">जऊन मूरतीमन ला ओह बनाथे, ओमन एक धोखा अंय;</para>
  <para style="q2" vid="JER 10:14">ओमन म सांस ही नइं ए।<verse eid="JER 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 10:15" />ओ मूरतीमन बेकार अऊ हंसी उड़ाय के चीज अंय;</para>
  <para style="q2" vid="JER 10:15">जब ओमन के फैसला होही, त ओमन नास हो जाहीं।<verse eid="JER 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 10:16" />ओ, जऊन ह याकूब के भाग ए, ओह तो येमन सहीं नो हय,</para>
  <para style="q2" vid="JER 10:16">काबरकि ओह जम्मो चीजमन के बनानेवाला अय,</para>
  <para style="q1" vid="JER 10:16">इसरायल, ओकर उत्तराधिकार के मनखेमन घलो ओमा आथें—</para>
  <para style="q2" vid="JER 10:16">ओकर नांव सर्वसक्तिमान यहोवा अय।<verse eid="JER 10:16" /></para>
  <para style="s1">अवइया बिनास</para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 10:17" />तुमन, जेमन बईरी के घेराबंदी म रहत हव,</para>
  <para style="q2" vid="JER 10:17">ये देस ला छोंड़के जाय के तियारी म अपन सामानमन ला संकेल लव।<verse eid="JER 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 10:18" />काबरकि यहोवा ह ये कहत हे:</para>
  <para style="q2" vid="JER 10:18">“अब, मेंह ओमन ला जोर से फटिकहूं</para>
  <para style="q2" vid="JER 10:18">जऊन मन ये देस म रहिथें;</para>
  <para style="q1" vid="JER 10:18">मेंह ओमन ऊपर संकट लानहूं</para>
  <para style="q2" vid="JER 10:18">ताकि ओमन पकड़े जावंय।”<verse eid="JER 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 10:19" />मोला लगे चोट के कारन मोर ऊपर हाय!</para>
  <para style="q2" vid="JER 10:19">मोर घाव ह ठीक नइं होवय!</para>
  <para style="q1" vid="JER 10:19">तभो ले मेंह अपनआप ला कहेंव,</para>
  <para style="q2" vid="JER 10:19">“येह तो मोर बेमारी अय, अऊ येला मोला सहना पड़ही।”<verse eid="JER 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 10:20" />मोर तम्बू ह नास हो गीस;</para>
  <para style="q2" vid="JER 10:20">येकर जम्मो रस्सीमन टूट गीन।</para>
  <para style="q1" vid="JER 10:20">मोर लइकामन मोर करा ले चल दीन अऊ ओमन अब नइं अंय;</para>
  <para style="q2" vid="JER 10:20">अब मोर तम्बू ला गाड़े बर</para>
  <para style="q2" vid="JER 10:20">या मोर निवास ला ठीक करे बर कोनो नइं बचे हवंय।<verse eid="JER 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 10:21" />चरवाहामन निरबुद्धि अंय</para>
  <para style="q2" vid="JER 10:21">अऊ ओमन यहोवा ले नइं पुछंय;</para>
  <para style="q1" vid="JER 10:21">एकरसेति ओमन के उन्नति नइं होवय</para>
  <para style="q2" vid="JER 10:21">अऊ ओमन के जम्मो पसुमन तितिर-बितिर हो जाथें।<verse eid="JER 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 10:22" />सुन! समाचार ह आवत हे—</para>
  <para style="q2" vid="JER 10:22">उत्तर दिग के देस ले एक बड़े कोलाहल सुनई देवत हे!</para>
  <para style="q1" vid="JER 10:22">येह यहूदा के नगरमन ला उजाड़ दीही</para>
  <para style="q2" vid="JER 10:22">ओमन ला सियारमन के डेरा बना दीही।<verse eid="JER 10:22" /></para>
  <para style="s1">यरमियाह के पराथना</para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 10:23" />हे यहोवा, मेंह जानत हंव कि मनखे के जिनगी ह ओमन के खुद के नो हय;</para>
  <para style="q2" vid="JER 10:23">येह ओमन के काम नो हय कि ओमन अपन मन के मुताबिक चलंय।<verse eid="JER 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 10:24" />हे यहोवा, मोर ताड़ना कर, पर सिरिप नियाय से—</para>
  <para style="q2" vid="JER 10:24">गुस्सा होके नइं,</para>
  <para style="q2" vid="JER 10:24">नइं तो, तेंह मोर नास कर देबे।<verse eid="JER 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 10:25" />ओ देसमन ऊपर अपन गुस्सा उतार</para>
  <para style="q2" vid="JER 10:25">जऊन मन तोला गरहन नइं करंय,</para>
  <para style="q2" vid="JER 10:25">अऊ जऊन मनखेमन तोर नांव के महिमा नइं करंय।</para>
  <para style="q1" vid="JER 10:25">काबरकि ओमन याकूब ला खतम कर दे हवंय;</para>
  <para style="q2" vid="JER 10:25">ओमन ओला पूरा खतम कर दे हवंय</para>
  <para style="q2" vid="JER 10:25">अऊ ओकर देस ला नास कर दे हवंय।<verse eid="JER 10:25" /></para>
  <chapter eid="JER 10" />
  <chapter number="11" style="c" sid="JER 11" />
  <para style="s1">करार ह टूट जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 11:1" />यहोवा कोति ले ये बचन यरमियाह करा आईस: <verse eid="JER 11:1" /><verse number="2" style="v" sid="JER 11:2" />“ये करार के नियममन ला सुन अऊ येमन ला यहूदा के मनखे अऊ यरूसलेम म रहइया मनखेमन ला बता। <verse eid="JER 11:2" /><verse number="3" style="v" sid="JER 11:3" />ओमन ला बता कि यहोवा, इसरायल के परमेसर ह ये कहत हे: ‘सरापित ए ओ मनखे, जऊन ह ये करार के नियममन ला नइं मानय— <verse eid="JER 11:3" /><verse number="4" style="v" sid="JER 11:4" />जेला माने के हुकूम मेंह तुम्हर पुरखामन ला दे रहेंव, जब मेंह ओमन ला मिसर देस ले, लोहा पीघलाय के भट्ठी ले निकालके लाने रहेंव।’ मेंह कहेंव, ‘मोर बात मानव अऊ ओ जम्मो काम करव, जेकर हुकूम मेंह देवत हंव, अऊ तुमन मोर मनखे होहू, अऊ मेंह तुम्हर परमेसर होहूं। <verse eid="JER 11:4" /><verse number="5" style="v" sid="JER 11:5" />तब मेंह ओ किरिया ला पूरा करहूं, जऊन ला मेंह तुम्हर पुरखामन ले खाय रहेंव कि मेंह ओमन ला एक अइसने देस<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">बहुंत उपजाऊ देस</char></note> दूहूं, जेमा दूध अऊ मंधरस के धारा बोहाथे’—येह ओ देस अय, जेमा आज तुम्हर अधिकार हे।”</para>
  <para style="p" vid="JER 11:5">मेंह जबाब देंव, “हे यहोवा, अइसने ही होवय।”<verse eid="JER 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 11:6" />तब यहोवा ह मोला कहिस, “यहूदा के नगरमन म अऊ यरूसलेम के गलीमन म ये जम्मो बात के परचार कर: ‘ये करार के नियममन ला सुनव अऊ ओकर मुताबिक चलव। <verse eid="JER 11:6" /><verse number="7" style="v" sid="JER 11:7" />जब ले मेंह तुम्हर पुरखामन ला मिसर देस ले निकालके लानेंव, तब ले लेके आज तक, मेंह ओमन ला घेरी-बेरी चेतउनी देके कहेंव, “मोर बात ला मानव।” <verse eid="JER 11:7" /><verse number="8" style="v" sid="JER 11:8" />पर ओमन मोर बात ला नइं सुनिन अऊ धियान नइं दीन; ओकर बदले, ओमन अपन दुस्ट हिरदय के जिद्दी सुभाव म चलिन। एकरसेति मेंह ओमन के ऊपर ओ करार के जम्मो सराप ला लानेंव, जेला माने के हुकूम मेंह ओमन ला देय रहेंव, पर ओमन नइं मानिन।’ ”<verse eid="JER 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 11:9" />तब यहोवा ह मोला ये घलो कहिस, “यहूदा के अऊ यरूसलेम म रहइया मनखेमन के बीच म एक साजिस चलत हे। <verse eid="JER 11:9" /><verse number="10" style="v" sid="JER 11:10" />ओमन अपन ओ पुरखामन के पाप कोति लहुंट गे हवंय, जऊन मन मोर बात ला सुने ले इनकार करिन। ओमन आने देवतामन के सेवा करे बर ओमन के पाछू चले गे हवंय। इसरायल अऊ यहूदा दूनों मोर ओ करार ला टोर दे हवंय, जेला मेंह ओमन के पुरखामन के संग करे रहेंव। <verse eid="JER 11:10" /><verse number="11" style="v" sid="JER 11:11" />एकरसेति, यहोवा ह ये कहत हे: ‘मेंह ओमन ऊपर अइसने बिपत्ति लानहूं, जेकर ले ओमन बच नइं सकंय। हालाकि ओमन आके मोर करा रोहीं, पर मेंह ओमन के नइं सुनहूं। <verse eid="JER 11:11" /><verse number="12" style="v" sid="JER 11:12" />यहूदा के नगरमन के मनखे अऊ यरूसलेम के मनखेमन जाके ओ देवतामन करा रोहीं, जेमन बर ओमन धूप जलाथें, पर ओ देवतामन बिपत्ति के बेरा ओमन के कुछू मदद नइं करहीं। <verse eid="JER 11:12" /><verse number="13" style="v" sid="JER 11:13" />हे यहूदा के मनखेमन, जतेक तुम्हर नगरमन हवंय, ओतेक ही तुम्हर देवतामन हवंय; अऊ जतेक यरूसलेम के गलीमन हवंय, ओतेक तुमन ओ कलंकित बाल देवता के आघू म धूप जलाय बर बेदीमन ला बनाय हवव।’<verse eid="JER 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 11:14" />“एकरसेति, हे यरमियाह, ये मनखेमन बर पराथना झन कर या येमन बर कोनो बिनती या निबेदन झन कर, काबरकि अपन दुख के बेरा म, जब येमन मोला पुकारहीं, त मेंह येमन के नइं सुनंव।<verse eid="JER 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 11:15" />“मोर मयारू ह मोर मंदिर म का करत हे</para>
  <para style="q2" vid="JER 11:15">ओह कतको आने मन संग मिलके अपन दुस्ट योजना ला पूरा करत हे?</para>
  <para style="q2" vid="JER 11:15">का पबितर करे गे मांस ह तोर सजा ला दूरिहा कर सकथे?</para>
  <para style="q1" vid="JER 11:15">जब तेंह दुस्टता करे म लगे रहिथस,</para>
  <para style="q2" vid="JER 11:15">तभे तेंह खुस होथस।”<verse eid="JER 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JER 11:16" />यहोवा ह तोला</para>
  <para style="q2" vid="JER 11:16">एक हरियर, सुघर फरवाला जैतून रूख कहे रिहिस।</para>
  <para style="q1" vid="JER 11:16">पर एक भयंकर आंधी के गरजन के संग,</para>
  <para style="q2" vid="JER 11:16">ओह येमा आगी लगा दीही,</para>
  <para style="q2" vid="JER 11:16">अऊ येकर डारामन ला टोर दिये जाही।<verse eid="JER 11:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="JER 11:17" />सर्वसक्तिमान यहोवा, जऊन ह तोला लगाईस, ओह तोर ऊपर बिपत्ति लाने के फैसला करे हवय, काबरकि इसरायल अऊ यहूदा के मनखेमन दुस्ट काम करे हवंय अऊ बाल देवता बर धूप जलाके मोर गुस्सा ला भड़काय हवंय।<verse eid="JER 11:17" /></para>
  <para style="s1">यरमियाह के बिरूध म साजिस</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 11:18" />यहोवा ह ओमन के साजिस ला मोर करा परगट करिस, एकरसेति मेंह येला जान डारेंव, काबरकि ओ बेरा, ओह मोला देखाईस कि ओमन का करत रिहिन। <verse eid="JER 11:18" /><verse number="19" style="v" sid="JER 11:19" />मेंह बध होवइया एक सीधा-साधा मेढ़ा-पीला सहीं रहेंव; मेंह नइं जानत रहेंव कि ओमन ये कहिके मोर बिरूध म साजिस करे रिहिन,</para>
  <para style="q1" vid="JER 11:19">“आवव, हमन ओ रूख ला ओकर फर समेत नास कर देवन;</para>
  <para style="q2" vid="JER 11:19">आवव, हमन ओला जीयतमन के बीच ले काट देवन,</para>
  <para style="q2" vid="JER 11:19">ताकि ओकर नांव ला अऊ सुरता झन करे जावय।”<verse eid="JER 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 11:20" />पर, हे सर्वसक्तिमान यहोवा, तें, जऊन ह सच्चई से नियाय करथस</para>
  <para style="q2" vid="JER 11:20">अऊ हिरदय अऊ मन ला परखथस,</para>
  <para style="q1" vid="JER 11:20">तेंह मोला देखा कि तेंह ओमन ले बदला लेथस,</para>
  <para style="q2" vid="JER 11:20">काबरकि मेंह अपन मामला ला तोर हांथ म छोंड़ दे हवंव।<verse eid="JER 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 11:21" />एकरसेति यहोवा ह अनातोत नगर के ओ मनखेमन के बारे म कहत हे, जऊन मन ये कहिके तोला मार डारे के धमकी देवत हें, “यहोवा के नांव म अगमबानी झन कर, नइं तो तेंह हमर हांथ ले मारे जाबे”— <verse eid="JER 11:21" /><verse number="22" style="v" sid="JER 11:22" />एकरसेति सर्वसक्तिमान यहोवा ह ये कहत हे: “मेंह ओमन ला सजा दूहूं। ओमन के जवान मनखेमन तलवार ले मारे जाहीं, अऊ ओमन के बेटा-बेटीमन अकाल के कारन मरहीं। <verse eid="JER 11:22" /><verse number="23" style="v" sid="JER 11:23" />ओमा के एको झन घलो नइं बांचहीं, काबरकि मेंह ओमन के सजा के बछर म अनातोत के मनखेमन ऊपर बिपत्ति लानहूं।”<verse eid="JER 11:23" /></para>
  <chapter eid="JER 11" />
  <chapter number="12" style="c" sid="JER 12" />
  <para style="s1">यरमियाह के सिकायत</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 12:1" />हे यहोवा, जब भी मेंह अपन मामला तोर आघू म लानथंव;</para>
  <para style="q2" vid="JER 12:1">तेंह हमेसा धरमी ठहिरथस।</para>
  <para style="q1" vid="JER 12:1">तभो ले मेंह तोर संग तोर नियाय के बारे म गोठियाहूं:</para>
  <para style="q2" vid="JER 12:1">दुस्टमन के काम ह काबर बढ़थे?</para>
  <para style="q2" vid="JER 12:1">काबर बेईमान मनखेमन सुख म रहिथें?<verse eid="JER 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 12:2" />तेंह ओमन ला रोपे हस, ओमन जरी धरे हवंय;</para>
  <para style="q2" vid="JER 12:2">ओमन बढ़थें अऊ फरथें।</para>
  <para style="q1" vid="JER 12:2">ओमन के मुहूं म हमेसा तोर नांव हवय</para>
  <para style="q2" vid="JER 12:2">पर तेंह ओमन के मन ले दूरिहा हस।<verse eid="JER 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 12:3" />तभो ले, हे यहोवा, तेंह मोला जानत हस;</para>
  <para style="q2" vid="JER 12:3">तेंह मोला देखथस अऊ तोर बारे म मोर बिचार ला परखथस।</para>
  <para style="q1" vid="JER 12:3">जइसने भेड़ ला काटे बर ले जाथें, वइसने ओमन ला खींचके ले जा!</para>
  <para style="q2" vid="JER 12:3">बध के दिन बर ओमन ला अलग रख!<verse eid="JER 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 12:4" />कब तक देस म सूखा पड़े रहिही</para>
  <para style="q2" vid="JER 12:4">अऊ जम्मो मैदान के घांस ह सूखाय रहिही?</para>
  <para style="q1" vid="JER 12:4">काबरकि जऊन मन येमा रहिथें, ओमन दुस्ट अंय,</para>
  <para style="q2" vid="JER 12:4">एकरसेति पसु अऊ चिरईमन नास हो गीन।</para>
  <para style="q1" vid="JER 12:4">तभो ले मनखेमन कहत हें,</para>
  <para style="q2" vid="JER 12:4">“हमर का होही, ओह<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">परमेसर</char></note> येला नइं देखही।”<verse eid="JER 12:4" /></para>
  <para style="s1">परमेसर के जबाब</para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 12:5" />“यदि तेंह मनखेमन के संग दऊड़े हस</para>
  <para style="q2" vid="JER 12:5">अऊ ओमन तोला थका दे हवंय,</para>
  <para style="q2" vid="JER 12:5">त फेर तेंह घोड़ामन के संग कइसे मुकाबला करबे?</para>
  <para style="q1" vid="JER 12:5">यदि तेंह सांति के ये देस म लड़खड़ावत हस,</para>
  <para style="q2" vid="JER 12:5">त फेर यरदन नदी के झाड़ीमन के बीच म कइसे करबे?<verse eid="JER 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 12:6" />तोर रिस्तेदार, तोर खुद के परिवार के मनखेमन घलो</para>
  <para style="q2" vid="JER 12:6">तोला धोखा देय हवंय;</para>
  <para style="q2" vid="JER 12:6">ओमन तोर बिरूध म बहुंत चिचियाय हवंय।</para>
  <para style="q1" vid="JER 12:6">एकरसेति यदि ओमन तोर बारे म बने गोठियाथें,</para>
  <para style="q2" vid="JER 12:6">तभो ले ओमन ऊपर भरोसा झन करबे।<verse eid="JER 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 12:7" />“मेंह अपन घर ला तियाग दूहूं,</para>
  <para style="q2" vid="JER 12:7">अपन उत्तराधिकार<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">चुने जाति</char></note> ला छोंड़ दूहूं;</para>
  <para style="q1" vid="JER 12:7">मेंह जऊन ला मया करथंव</para>
  <para style="q2" vid="JER 12:7">ओला ओकर बईरीमन के हांथ म कर दूहूं।<verse eid="JER 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 12:8" />मोर उत्तराधिकार ह मोर बर</para>
  <para style="q2" vid="JER 12:8">जंगल के एक सेर सहीं हो गे हवय।</para>
  <para style="q1" vid="JER 12:8">ओह मोर ऊपर गरजथे;</para>
  <para style="q2" vid="JER 12:8">एकरसेति मेंह ओकर ले घिन करथंव।<verse eid="JER 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 12:9" />का मोर उत्तराधिकार ह मोर बर</para>
  <para style="q2" vid="JER 12:9">धब्बावाले सिकार के चिरई सहीं नइं हो गे हवय</para>
  <para style="q2" vid="JER 12:9">जऊन ला आने सिकारी चिरईमन घेरके हमला करथें?</para>
  <para style="q1" vid="JER 12:9">जावव अऊ जम्मो जंगली पसुमन ला इकट्ठा करव;</para>
  <para style="q2" vid="JER 12:9">ओमन ला लानव कि खा जावंय।<verse eid="JER 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 12:10" />बहुंत चरवाहामन मोर अंगूर के बारी ला नास कर दीहीं</para>
  <para style="q2" vid="JER 12:10">अऊ मोर बारी ला कुचर दीहीं;</para>
  <para style="q1" vid="JER 12:10">ओमन मोर बने बारी ला</para>
  <para style="q2" vid="JER 12:10">उजारके बेकार कर दीहीं।<verse eid="JER 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 12:11" />ओला मोर आघू म</para>
  <para style="q2" vid="JER 12:11">बेकार, सूखा अऊ उजाड़ कर दिये जाही;</para>
  <para style="q1" vid="JER 12:11">जम्मो देस ह बेकार पड़े रहिही</para>
  <para style="q2" vid="JER 12:11">काबरकि ओकर देखरेख करइया कोनो नइं एं।<verse eid="JER 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 12:12" />सुन्ना जगह के जम्मो बेकार टीलामन ऊपर</para>
  <para style="q2" vid="JER 12:12">नास करइयामन जूरहीं,</para>
  <para style="q1" vid="JER 12:12">काबरकि यहोवा के तलवार ह</para>
  <para style="q2" vid="JER 12:12">देस के एक छोर ले लेके दूसर छोर तक मारही;</para>
  <para style="q2" vid="JER 12:12">कोनो सुरकछित नइं रहिहीं।<verse eid="JER 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 12:13" />ओमन गहूं तो बोहीं पर कांटामन ला लूहीं;</para>
  <para style="q2" vid="JER 12:13">ओमन काम करके अपनआप ला थकाहीं, पर ओमन ला कुछू नइं मिलही।</para>
  <para style="q1" vid="JER 12:13">यहोवा के भयंकर गुस्सा के कारन</para>
  <para style="q2" vid="JER 12:13">ओमन अपन कटनी के बिसय म लज्जित होहीं।”<verse eid="JER 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 12:14" />यहोवा ह ये कहत हे: “जहां तक मोर ओ जम्मो दुस्ट परोसीमन के बात ए, जऊन मन मोर इसरायली मनखेमन ला दिये उत्तराधिकार ऊपर कब्जा करत हें, ओमन ला मेंह ओमन के देस ले उखान दूहूं अऊ मेंह यहूदा के मनखेमन ला घलो ओमन के बीच म ले उखान दूहूं। <verse eid="JER 12:14" /><verse number="15" style="v" sid="JER 12:15" />पर ओमन ला उखाने के बाद, मेंह ओमन ऊपर दया करहूं अऊ ओमा ले हर एक झन ला ओमन के उत्तराधिकार के जगह अऊ ओमन के देस म फेर वापिस लानहूं। <verse eid="JER 12:15" /><verse number="16" style="v" sid="JER 12:16" />अऊ यदि ओमन मोर मनखेमन के चाल ला बने करके सीखंय अऊ ये कहिके मोर ही नांव के किरिया खावंय, ‘यहोवा के जिनगी के कसम’—जइसे कि एक बार, ओमन मोर मनखेमन ला बाल देवता के किरिया खाय बर सिखोय रिहिन—तब ओमन ला मोर मनखेमन के बीच म बसाय जाही। <verse eid="JER 12:16" /><verse number="17" style="v" sid="JER 12:17" />पर यदि ओमा के कोनो जाति ह नइं सुनही, त फेर मेंह ओला पूरा उखानके नास कर दूहूं,” यहोवा ह ये घोसना करत हे।<verse eid="JER 12:17" /></para>
  <chapter eid="JER 12" />
  <chapter number="13" style="c" sid="JER 13" />
  <para style="s1">सन के बने पट्टा</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 13:1" />यहोवा ह मोर ले ये कहिस: “जा अऊ सन के एक पट्टा बिसा अऊ ओला अपन कनिहां म बांध ले, पर ओला पानी म झन छुआबे।” <verse eid="JER 13:1" /><verse number="2" style="v" sid="JER 13:2" />तब यहोवा के कहे मुताबिक मेंह एक पट्टा बिसोंय अऊ ओला अपन कनिहां म बांध लेंव।<verse eid="JER 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 13:3" />तब यहोवा के ये बचन दूसर बार मोर मेर आईस: <verse eid="JER 13:3" /><verse number="4" style="v" sid="JER 13:4" />“जऊन पट्टा ला तेंह बिसाके अपन कनिहां म बांधे हस, ओला ले अऊ फरात नदी म जाके उहां चट्टानमन के दरार म लुका दे।” <verse eid="JER 13:4" /><verse number="5" style="v" sid="JER 13:5" />तब यहोवा के कहे मुताबिक मेंह जाके ओला फरात नदी म लुका देंव।<verse eid="JER 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 13:6" />बहुंत दिन के बाद, यहोवा ह मोला कहिस, “अब फरात नदी म जा अऊ ओ पट्टा ला लेय ले, जऊन ला मेंह तोला उहां लुकाय बर कहे रहेंव।” <verse eid="JER 13:6" /><verse number="7" style="v" sid="JER 13:7" />तब मेंह फरात नदी करा गेंव अऊ पट्टा ला खनके उहां ले निकाल लेंव, जिहां मेंह ओला लुकाय रहेंव, पर अब ओह खराप होके पूरा बेकार हो गे रहय।<verse eid="JER 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 13:8" />तब यहोवा के ये बचन मोर करा आईस: <verse eid="JER 13:8" /><verse number="9" style="v" sid="JER 13:9" />“यहोवा ह ये कहत हे: ‘इही किसम ले, मेंह यहूदीमन के घमंड अऊ यरूसलेम के बड़े घमंड ला नास कर दूहूं। <verse eid="JER 13:9" /><verse number="10" style="v" sid="JER 13:10" />ये दुस्ट मनखे, जेमन मोर बात ला सुने ले इनकार करथें, जेमन अपन मन के जिद्दी सुभाव म चलथें अऊ आने देवतामन के सेवा अऊ अराधना करे बर ओमन के पाछू चलथें; ओमन ये पट्टा सहीं हो जाहीं—पूरा बेकार! <verse eid="JER 13:10" /><verse number="11" style="v" sid="JER 13:11" />काबरकि जइसने एक पट्टा ह कनिहां के चारों कोति बांधे जाथे, वइसने ही मेंह इसरायल के जम्मो मनखे अऊ यहूदा के जम्मो मनखेमन ला अपन म बांधेंव कि ओमन मोर कीरति अऊ परसंसा अऊ आदर बर मोर मनखे होवंय। पर ओमन नइं सुनिन,’ यहोवा ह ये घोसना करत हे।<verse eid="JER 13:11" /></para>
  <para style="s1">अंगूर के मंद रखे के चाम के थैली</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 13:12" />“एकरसेति तें ओमन ला कह: ‘यहोवा, इसरायल के परमेसर ह ये कहत हे: अंगूर के मंद रखे के हर एक चाम के थैली ह अंगूर के मंद ले भरे जावय।’ अऊ यदि ओमन तोर ले कहंय, ‘का हमन नइं जानन कि अंगूर के मंद रखे के हर एक चाम के थैली ला अंगूर के मंद ले भर दिये जाना चाही?’ <verse eid="JER 13:12" /><verse number="13" style="v" sid="JER 13:13" />तब ओमन ला कह, ‘यहोवा ह ये कहत हे: ये देस म रहइया जम्मो झन ला, मेंह मतवारपन ले भर देनेवाला हंव—येमा दाऊद के सिंघासन म बईठइया राजामन, पुरोहितमन, अगमजानीमन अऊ यरूसलेम म रहइया जम्मो मनखेमन होहीं। <verse eid="JER 13:13" /><verse number="14" style="v" sid="JER 13:14" />मेंह ओमन ला एक-दूसर ले टकराके कुटा-कुटा कर दूहूं; दाई-ददा अऊ लइकामन ला एक समान, यहोवा ह घोसना करत हे। ओमन ला नास करे म, मेंह कोनो दया या किरपा या सहानुभूति नइं देखाहूं।’ ”<verse eid="JER 13:14" /></para>
  <para style="s1">बंधुवई के धमकी</para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 13:15" />सुनव अऊ धियान देवव,</para>
  <para style="q2" vid="JER 13:15">जिद्दी झन बनव,</para>
  <para style="q2" vid="JER 13:15">काबरकि यहोवा ह कहे हवय।<verse eid="JER 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 13:16" />यहोवा अपन परमेसर ला महिमा देवव,</para>
  <para style="q2" vid="JER 13:16">एकर पहिली कि ओह अंधियार ला लानय,</para>
  <para style="q1" vid="JER 13:16">एकर पहिली कि तुम्हर गोड़ ह</para>
  <para style="q2" vid="JER 13:16">अंधियार वाले पहाड़ी म ठोकर खावय।</para>
  <para style="q1" vid="JER 13:16">तुमन अंजोर के आसा करथव,</para>
  <para style="q2" vid="JER 13:16">पर ओह ओला बिरबिट अंधियार कर दीही</para>
  <para style="q2" vid="JER 13:16">अऊ ओला घोर अंधियार म बदल दीही।<verse eid="JER 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 13:17" />यदि तुमन नइं सुनहू,</para>
  <para style="q2" vid="JER 13:17">त तुम्हर घमंड के कारन</para>
  <para style="q2" vid="JER 13:17">मेंह मने-मन रोहूं;</para>
  <para style="q1" vid="JER 13:17">मेंह अतेक जादा रोहूं</para>
  <para style="q2" vid="JER 13:17">कि मोर आंखीमन ले आंसू बहे लगही,</para>
  <para style="q2" vid="JER 13:17">काबरकि यहोवा के झुंड ला बंधुवई म ले जाय जाही।<verse eid="JER 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 13:18" />राजा अऊ राज-माता ला कह,</para>
  <para style="q2" vid="JER 13:18">“अपन सिंघासनमन ले खाल्हे उतरव,</para>
  <para style="q1" vid="JER 13:18">काबरकि तुम्हर सोभा देवइया मुकुटमन</para>
  <para style="q2" vid="JER 13:18">तुम्हर मुड़ीमन ले गिर जाहीं।”<verse eid="JER 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 13:19" />नेगेव के सहरमन बंद हो जाहीं,</para>
  <para style="q2" vid="JER 13:19">अऊ ओमन ला खोले बर कोनो नइं होहीं।</para>
  <para style="q1" vid="JER 13:19">जम्मो यहूदा ला बंधुवई म ले जाय जाही,</para>
  <para style="q2" vid="JER 13:19">ओमन पूरा बंधुवई म चल दीहीं।<verse eid="JER 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 13:20" />आंखी उठाके ओमन ला देख</para>
  <para style="q2" vid="JER 13:20">जऊन मन उत्तर दिग ले आवत हें।</para>
  <para style="q1" vid="JER 13:20">ओ झुंड कहां हवय, जऊन ह तोला सऊंपे गे रिहिस,</para>
  <para style="q2" vid="JER 13:20">ओ भेड़मन, जेमन ऊपर तेंह घमंड करत रहय?<verse eid="JER 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 13:21" />तेंह का कहिबे, जब यहोवा ह तोर ऊपर ओमन ला मुखिया ठहिरा दीही,</para>
  <para style="q2" vid="JER 13:21">जऊन मन ला तेंह अपन बिसेस संगवारी बनाय रहय?</para>
  <para style="q1" vid="JER 13:21">त का पीरा ह एक छेवारी माईलोगन के पीरा सहीं</para>
  <para style="q2" vid="JER 13:21">तोला नइं जकड़ लीही?<verse eid="JER 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 13:22" />यदि तेंह अपनआप ले पुछथस,</para>
  <para style="q2" vid="JER 13:22">“अइसने मोर संग काबर होईस?”—</para>
  <para style="q1" vid="JER 13:22">काबरकि तोर बहुंत पाप के कारन</para>
  <para style="q2" vid="JER 13:22">तोर लंहगा ला चीरे गे हवय</para>
  <para style="q2" vid="JER 13:22">अऊ तोर देहें के दुरगति करे गे हवय।<verse eid="JER 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 13:23" />का कोनो इथोपीयन<note caller="+" style="f"><char style="fr" closed="false">13:23 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">कूसी </char><char style="ft" closed="false">(संभवतः ऊपरी नील नदी के इलाका के एक मनखे)</char></note> अपन चाम ला</para>
  <para style="q2" vid="JER 13:23">या कोनो चीतवा ह अपन धब्बामन ला बदल सकत हे?</para>
  <para style="q1" vid="JER 13:23">वइसने तेंह घलो भलई के काम नइं कर सकस</para>
  <para style="q2" vid="JER 13:23">काबरकि बुरई के काम करे के तोर आदत हो गे हवय।<verse eid="JER 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JER 13:24" />“मेंह भूंसा सहीं तोला बगरा दूहूं</para>
  <para style="q2" vid="JER 13:24">जऊन ह कि सुन्ना जगह के हवा ले उड़ियाथे।<verse eid="JER 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 13:25" />येह तोर हिस्सा ए,</para>
  <para style="q2" vid="JER 13:25">ओ भाग, जेला मेंह तोर बर ठहिराय हंव,” यहोवा ह ये घोसना करत हे,</para>
  <para style="q1" vid="JER 13:25">“काबरकि तेंह मोला भुला गे हवस</para>
  <para style="q2" vid="JER 13:25">अऊ लबरा देवतामन ऊपर भरोसा करे हवस।<verse eid="JER 13:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 13:26" />एकरसेति मेंह तोर लंहगा ला तोर मुहूं तक उठा दूहूं</para>
  <para style="q2" vid="JER 13:26">ताकि तोर लज्जा ला देखे जा सकय—<verse eid="JER 13:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 13:27" />तोर बेभिचार अऊ वासना के अवाज,</para>
  <para style="q2" vid="JER 13:27">तोर निरलज बेस्यापन ला देखे जा सकय!</para>
  <para style="q1" vid="JER 13:27">मेंह पहाड़ीमन ऊपर अऊ मैदानमन म</para>
  <para style="q2" vid="JER 13:27">तोर घिनित काममन ला देखे हंव।</para>
  <para style="q1" vid="JER 13:27">हे यरूसलेम, तोर ऊपर हाय!</para>
  <para style="q2" vid="JER 13:27">तेंह कब तक असुध रहिबे?”<verse eid="JER 13:27" /></para>
  <chapter eid="JER 13" />
  <chapter number="14" style="c" sid="JER 14" />
  <para style="s1">सूखा, अकाल, तलवार</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 14:1" />सूखा पड़े के बिसय म, यहोवा के ये बचन यरमियाह करा आईस:<verse eid="JER 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 14:2" />“यहूदा ह बिलाप करत हे,</para>
  <para style="q2" vid="JER 14:2">ओकर नगरमन तड़फत हें;</para>
  <para style="q1" vid="JER 14:2">ओमन देस बर सोक मनावत हें,</para>
  <para style="q2" vid="JER 14:2">अऊ यरूसलेम ले चिचियाय के अवाज उठत हे।<verse eid="JER 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 14:3" />बड़े मनखेमन अपन सेवकमन ला पानी बर पठोथें;</para>
  <para style="q2" vid="JER 14:3">ओमन तरिया म जाथें</para>
  <para style="q2" vid="JER 14:3">ओमन ला पानी नइं मिलय।</para>
  <para style="q1" vid="JER 14:3">ओमन अपन खाली बरतन लेके लहुंटथें;</para>
  <para style="q2" vid="JER 14:3">डराके अऊ निरास होके,</para>
  <para style="q2" vid="JER 14:3">ओमन अपन मुड़ ला ढांप लेथें।<verse eid="JER 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 14:4" />भुइयां ह फाट गे हवय</para>
  <para style="q2" vid="JER 14:4">काबरकि देस म पानी नइं बरसत हे;</para>
  <para style="q1" vid="JER 14:4">किसानमन डरा गे हवंय</para>
  <para style="q2" vid="JER 14:4">अऊ अपन मुड़मन ला ढांप लेवत हें।<verse eid="JER 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 14:5" />अऊ त अऊ हिरनी ह मैदान म</para>
  <para style="q2" vid="JER 14:5">अपन नवां जनमे लइका ला छोंड़ देवत हे</para>
  <para style="q2" vid="JER 14:5">काबरकि उहां कांदी नइं ए।<verse eid="JER 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 14:6" />जंगली गदहामन बंजर टीलामन म ठाढ़े हवंय</para>
  <para style="q2" vid="JER 14:6">अऊ सियार सहीं हांफत हवंय;</para>
  <para style="q1" vid="JER 14:6">जेवन के कमी के कारन</para>
  <para style="q2" vid="JER 14:6">ओमन के आंखी ले नइं दिखत हे।”<verse eid="JER 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 14:7" />हालाकि हमर पापमन हमर बिरूध म गवाही देवत हवंय,</para>
  <para style="q2" vid="JER 14:7">तभो ले, हे यहोवा, अपन नांव के हित म कुछू कर।</para>
  <para style="q1" vid="JER 14:7">काबरकि हमन अकसर बिदरोह करे हवन;</para>
  <para style="q2" vid="JER 14:7">हमन तोर बिरूध म पाप करे हवन।<verse eid="JER 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 14:8" />तें, जऊन ह कि इसरायल के आसा अस,</para>
  <para style="q2" vid="JER 14:8">संकट के बेरा म ओकर बचानेवाला अस,</para>
  <para style="q1" vid="JER 14:8">तेंह काबर ये देस म अजनबी सहीं हवस,</para>
  <para style="q2" vid="JER 14:8">एक राहगीर सहीं जऊन ह सिरिप एक रात रूकथे?<verse eid="JER 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 14:9" />तेंह काबर एक अचम्भो करे मनखे सहीं हो गे हस,</para>
  <para style="q2" vid="JER 14:9">एक अइसने योद्धा, जऊन म कोनो ला बचाय बर सक्ति नइं ए?</para>
  <para style="q1" vid="JER 14:9">हे यहोवा, तेंह हमर बीच म हवस,</para>
  <para style="q2" vid="JER 14:9">अऊ हमर करा तोर नांव हवय;</para>
  <para style="q2" vid="JER 14:9">एकरसेति हमन ला झन तियाग दे!<verse eid="JER 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 14:10" />यहोवा ह ये मनखेमन के बारे म ये कहत हे:</para>
  <para style="q1" vid="JER 14:10">“येमन ला एती-ओती भटकई बने लगथे;</para>
  <para style="q2" vid="JER 14:10">येमन कुकरम करे बर अपन गोड़ ला नइं रोकंय।</para>
  <para style="q1" vid="JER 14:10">एकरसेति यहोवा ह येमन ला गरहन नइं करय;</para>
  <para style="q2" vid="JER 14:10">ओह अब येमन के दुस्टता ला सुरता करही</para>
  <para style="q2" vid="JER 14:10">अऊ ओमन के पाप के सजा ओमन ला दीही।”<verse eid="JER 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 14:11" />तब यहोवा ह मोला कहिस, “ये मनखेमन के भलई बर पराथना झन कर। <verse eid="JER 14:11" /><verse number="12" style="v" sid="JER 14:12" />चाहे ओमन उपास घलो करंय, तभो ले मेंह ओमन के पुकार ला नइं सुनहूं; चाहे ओमन होम-बलिदान अऊ अन्न-बलिदान चघावंय, तभो ले मेंह ओमन ला गरहन नइं करहूं। पर मेंह ओमन ला तलवार, अकाल अऊ महामारी ले नास करहूं।”<verse eid="JER 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 14:13" />पर मेंह कहेंव, “हाय, हे परमपरधान यहोवा! अगमजानीमन ओमन ला कहत रहिथें, ‘तुम्हर ऊपर न तो तलवार चलही अऊ न ही अकाल पड़ही। वास्तव म, मेंह तुमन ला ये जगह म सदा के सांति दूहूं।’ ”<verse eid="JER 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 14:14" />तब यहोवा ह मोला कहिस, “ये अगमजानीमन मोर नांव म लबारी अगमबानी करत हवंय। मेंह ओमन ला नइं पठोय हंव अऊ न तो ओमन ला ठहिराय हंव अऊ न ही ओमन ले गोठियाय हंव। ओमन तुमन ले अपन खुद के मन के लबारी दरसन, सकुन, मूरती-पूजा अऊ भरम के अगमबानी करत हवंय। <verse eid="JER 14:14" /><verse number="15" style="v" sid="JER 14:15" />एकरसेति, जऊन अगमजानीमन मोर नांव म अगमबानी करत हवंय, ओमन के बारे म यहोवा ह ये कहत हे: मेंह ओमन ला नइं पठोय हवंव, तभो ले ओमन कहत हवंय, ‘ये देस म न तो तलवार चलही, अऊ न ही अकाल पड़ही।’ ओही अगमजानीमन ही तलवार अऊ अकाल के दुवारा नास होहीं। <verse eid="JER 14:15" /><verse number="16" style="v" sid="JER 14:16" />अऊ जऊन मनखेमन बर ओमन अगमबानी करत हवंय, ओमन ला अकाल अऊ तलवार के कारन बाहिर यरूसलेम के गलीमन म फटिक दिये जाही। ओमन ला, ओमन के घरवालीमन ला अऊ ओमन के बेटा-बेटीमन ला उहां माटी देय बर कोनो नइं होहीं। ओमन के बुरई के मुताबिक, मेंह ओमन ऊपर बिपत्ति लानहूं।<verse eid="JER 14:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="JER 14:17" />“तें ओमन ले ये बात कह:</para>
  <para style="q1" vid="JER 14:17">“ ‘मोर आंखीमन ले रात अऊ दिन</para>
  <para style="q2" vid="JER 14:17">बिगर रूके आंसू बहते रहय;</para>
  <para style="q1" vid="JER 14:17">काबरकि कुंवारी बेटी, मोर मनखेमन ला</para>
  <para style="q2" vid="JER 14:17">भारी चोट लगे हवय,</para>
  <para style="q2" vid="JER 14:17">ओमन कुचरे गे हवंय।<verse eid="JER 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 14:18" />यदि मेंह मैदानी भाग म जाथंव,</para>
  <para style="q2" vid="JER 14:18">त मेंह ओमन ला देखथंव, जऊन मन तलवार ले मारे गे हवंय;</para>
  <para style="q1" vid="JER 14:18">यदि मेंह सहर म जाथंव,</para>
  <para style="q2" vid="JER 14:18">त अकाल ले नास होय चीजमन ला देखथंव।</para>
  <para style="q1" vid="JER 14:18">अगमजानी अऊ पुरोहित दूनों</para>
  <para style="q2" vid="JER 14:18">एक अइसने देस म चले गे हवंय, जेला ओमन नइं जानंय।’ ”<verse eid="JER 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 14:19" />हे यहोवा, का तेंह यहूदा ला पूरा इनकार कर दे हस?</para>
  <para style="q2" vid="JER 14:19">का तेंह सियोन ला तुछ समझथस?</para>
  <para style="q1" vid="JER 14:19">तेंह काबर हमन ला अइसने पीरा दे हवस</para>
  <para style="q2" vid="JER 14:19">कि हमन चंगा नइं हो सकन?</para>
  <para style="q1" vid="JER 14:19">हमन सांति के आसा करेंन</para>
  <para style="q2" vid="JER 14:19">पर हमर कुछू भलई नइं होईस,</para>
  <para style="q1" vid="JER 14:19">हमन बने समय के आसा करत रहेंन</para>
  <para style="q2" vid="JER 14:19">पर सिरिप आतंक ही मिलिस।<verse eid="JER 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 14:20" />हे यहोवा, हमन अपन दुस्टता,</para>
  <para style="q2" vid="JER 14:20">अऊ अपन पुरखामन के अपराध ला मान लेवत हन;</para>
  <para style="q2" vid="JER 14:20">हमन सही म, तोर बिरूध म पाप करे हन।<verse eid="JER 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 14:21" />अपन नांव के हित म, हमन ला तुछ झन जान;</para>
  <para style="q2" vid="JER 14:21">अपन महिमामय सिंघासन के अपमान झन कर।</para>
  <para style="q1" vid="JER 14:21">हमर संग करे अपन करार ला सुरता कर</para>
  <para style="q2" vid="JER 14:21">अऊ ओला झन टोर।<verse eid="JER 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 14:22" />का जातिमन के बेकार मूरतीमन बरसात कर सकत हें?</para>
  <para style="q2" vid="JER 14:22">का अकास ह खुद पानी के झड़ी लगा सकत हे?</para>
  <para style="q1" vid="JER 14:22">नइं, पर हे यहोवा, हमर परमेसर, सिरिप तेंह ये सब करथस?</para>
  <para style="q2" vid="JER 14:22">एकरसेति तोर ऊपर हमर आसा हवय,</para>
  <para style="q2" vid="JER 14:22">काबरकि ये जम्मो काम, सिरिप तें ही करथस।<verse eid="JER 14:22" /></para>
  <chapter eid="JER 14" />
  <chapter number="15" style="c" sid="JER 15" />
  <para style="p">
    <verse number="1" style="v" sid="JER 15:1" />तब यहोवा ह मोला कहिस: “अऊ त अऊ यदि मूसा अऊ समूएल घलो मोर आघू म बिनती करत ठाढ़ होतिन, तब भी मोर मन ह ये मनखेमन कोति नइं फिरतिस। येमन ला मोर आघू ले निकाल दे! ओमन ला जावन दे! <verse eid="JER 15:1" /><verse number="2" style="v" sid="JER 15:2" />अऊ यदि ओमन तोर ले पुछथें, ‘हमन कहां जाबो?’ त ओमन ला बता, ‘यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 15:2">“ ‘जेमन बर मरना लिखे हवय, ओमन मर जावंय;</para>
  <para style="q1" vid="JER 15:2">जऊन मन ला तलवार ले मरना हे, ओमन तलवार ले मरंय;</para>
  <para style="q1" vid="JER 15:2">जऊन मन ला भूख ले मरना हे, ओमन भूख ले मरंय;</para>
  <para style="q1" vid="JER 15:2">जऊन मन ला बंधुवई म जाना हे, ओमन बंधुवई म चले जावंय।’<verse eid="JER 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 15:3" />“मेंह ओमन के बिरूध म चार किसम के बिनास करइयामन ला पठोहूं,” यहोवा ह ये घोसना करत हे, “मार डारे बर तलवार, घिल्लाके ले जाय बर कुकुर, अऊ चीथ खाय बर अऊ नास करे बर चिरई अऊ जंगली पसु। <verse eid="JER 15:3" /><verse number="4" style="v" sid="JER 15:4" />हिजकियाह के बेटा, यहूदा के राजा मनस्से ह जऊन दुस्ट काम यरूसलेम म करे हवय, ओकर कारन मेंह ओमन ला धरती के जम्मो राजमन म घिनौना कर दूहूं।<verse eid="JER 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 15:5" />“हे यरूसलेम, तोर ऊपर कोन ह दया करही?</para>
  <para style="q2" vid="JER 15:5">तोर बर कोन ह सोक मनाही?</para>
  <para style="q2" vid="JER 15:5">कोन ह रूकके तोर हालचाल पुछही?<verse eid="JER 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 15:6" />तेंह मोला अस्वीकार करे हस,”</para>
  <para style="q2" vid="JER 15:6">यहोवा ह ये घोसना करत हे।</para>
  <para style="q2" vid="JER 15:6">“तेंह मोर ले अऊ पाछू हटत जावत हस।</para>
  <para style="q1" vid="JER 15:6">एकरसेति मेंह हांथ बढ़ाके तोला नास कर दूहूं;</para>
  <para style="q2" vid="JER 15:6">मेंह तरस खा-खाके थक गे हंव।<verse eid="JER 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 15:7" />मेंह ओमन ला देस के सहर के दुवारमन म</para>
  <para style="q2" vid="JER 15:7">सूपा ले पछरहूं।</para>
  <para style="q1" vid="JER 15:7">मेंह अपन मनखेमन ऊपर मिरतू-सोक अऊ बिनास लानहूं,</para>
  <para style="q2" vid="JER 15:7">काबरकि ओमन अपन चालचलन ला नइं बदले हवंय।<verse eid="JER 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 15:8" />मेंह ओमन के बिधवामन के गनती ला</para>
  <para style="q2" vid="JER 15:8">समुंदर के बालू ले घलो जादा कर दूहूं।</para>
  <para style="q1" vid="JER 15:8">दिन के मंझन के बेरा, मेंह एक नास करइया ला</para>
  <para style="q2" vid="JER 15:8">जवानमन के दाईमन के बिरूध लानहूं;</para>
  <para style="q1" vid="JER 15:8">अचानक मेंह ओमन ऊपर</para>
  <para style="q2" vid="JER 15:8">पीरा अऊ आतंक लानहूं।<verse eid="JER 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 15:9" />सात झन के दाई ह दुरबल हो जाही</para>
  <para style="q2" vid="JER 15:9">अऊ अपन आखिरी सांस लीही।</para>
  <para style="q1" vid="JER 15:9">दिन के रहत ही ओकर सूरज ह बुड़ जाही;</para>
  <para style="q2" vid="JER 15:9">ओह कलंकित अऊ अपमानित होही।</para>
  <para style="q1" vid="JER 15:9">जऊन मनखेमन बच गे होहीं, ओमन ला</para>
  <para style="q2" vid="JER 15:9">मेंह ओमन के बईरीमन के आघू म तलवार ले मरवाहूं,”</para>
  <para style="q2" vid="JER 15:9">यहोवा ह ये घोसना करत हे।<verse eid="JER 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 15:10" />हाय, हे मोर दाई, कि तेंह मोला जनमाय,</para>
  <para style="q2" vid="JER 15:10">एक अइसने मनखे, जेकर संग पूरा देस बिबाद अऊ झगरा करत हे!</para>
  <para style="q1" vid="JER 15:10">मेंह न तो उधार दे हंव अऊ न ही उधार ले हंव,</para>
  <para style="q2" vid="JER 15:10">तभो ले जम्मो झन मोला कोसत हवंय।<verse eid="JER 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 15:11" />यहोवा ह कहिस,</para>
  <para style="q1" vid="JER 15:11">“खचित मेंह तोला भलई बर छोंड़ दूहूं;</para>
  <para style="q2" vid="JER 15:11">खचित मेंह बिपत्ति अऊ दुख के बेरा म</para>
  <para style="q2" vid="JER 15:11">तोर बईरीमन ला तोर ले बिनती करवाहूं।<verse eid="JER 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JER 15:12" />“का कोनो मनखे ह लोहा ला टोर सकत हे—</para>
  <para style="q2" vid="JER 15:12">उत्तर दिग के लोहा—या तांबा ला?<verse eid="JER 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 15:13" />“अपन जम्मो देस म</para>
  <para style="q2" vid="JER 15:13">तोर जम्मो पाप के कारन,</para>
  <para style="q1" vid="JER 15:13">मेंह तोर धन-संपत्ति अऊ खजाना ला</para>
  <para style="q2" vid="JER 15:13">बिगर कोनो दाम के लूट म दे दूहूं।<verse eid="JER 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 15:14" />एक अइसने देस म, जेला तेंह नइं जानस</para>
  <para style="q2" vid="JER 15:14">मेंह तोला तोर बईरीमन के गुलाम बना दूहूं,</para>
  <para style="q1" vid="JER 15:14">काबरकि मोर गुस्सा के आगी ह भड़कही</para>
  <para style="q2" vid="JER 15:14">अऊ येह तोला जलाही।”<verse eid="JER 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 15:15" />हे यहोवा, तेंह समझथस;</para>
  <para style="q2" vid="JER 15:15">मोला सुरता कर अऊ मोर खियाल रख।</para>
  <para style="q2" vid="JER 15:15">मोर सतानेवालामन ले मोर बदला ले।</para>
  <para style="q1" vid="JER 15:15">तेंह धीरज धरइया अस—मोला दूरिहा झन कर;</para>
  <para style="q2" vid="JER 15:15">सोच कि तोर खातिर मेंह कइसे निन्दा सहे हवंव।<verse eid="JER 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 15:16" />जब तोर बचन ह आईस, त मेंह ओला अपन मन म रखेंव;</para>
  <para style="q2" vid="JER 15:16">अऊ ओकर ले आनंदित अऊ खुस रहेंव,</para>
  <para style="q1" vid="JER 15:16">काबरकि, हे यहोवा सर्वसक्तिमान परमेसर,</para>
  <para style="q2" vid="JER 15:16">मेंह तोर नांव ले जाने जाथंव।<verse eid="JER 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 15:17" />मेंह कभू मऊज-मस्ती करइयामन संग नइं बईठेंव,</para>
  <para style="q2" vid="JER 15:17">अऊ ओमन संग कभू खुसी नइं मनायेंव;</para>
  <para style="q1" vid="JER 15:17">मेंह अकेला बईठेंव, काबरकि तोर हांथ मोर ऊपर रिहिस</para>
  <para style="q2" vid="JER 15:17">अऊ तेंह मोला गुस्सा ले भर दे रहय।<verse eid="JER 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 15:18" />मोर पीरा ह काबर खतम नइं होवय</para>
  <para style="q2" vid="JER 15:18">अऊ मोर घाव ह काबर दुख देवत हे अऊ बने नइं होवय?</para>
  <para style="q1" vid="JER 15:18">तेंह मोर बर एक धोखा देवइया छोटे झरना सहीं अस,</para>
  <para style="q2" vid="JER 15:18">ओ झरना जऊन ह सूखा जाथे।<verse eid="JER 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 15:19" />एकरसेति यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 15:19">“यदि तेंह पछताप करबे, त मेंह तोला पहिले सहीं बने कर दूहूं</para>
  <para style="q2" vid="JER 15:19">ताकि तें मोर सेवा कर सकस;</para>
  <para style="q1" vid="JER 15:19">यदि तेंह बेकार के बात नइं, पर सही बात कहिबे,</para>
  <para style="q2" vid="JER 15:19">त तेंह मोर तरफ ले गोठियानेवाला होबे।</para>
  <para style="q1" vid="JER 15:19">ये मनखेमन तोर कोति फिरंय,</para>
  <para style="q2" vid="JER 15:19">पर तें ओमन कोति बिलकुल झन फिरबे।<verse eid="JER 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 15:20" />मेंह तोला ये मनखेमन बर एक दीवार बना दूहूं,</para>
  <para style="q2" vid="JER 15:20">कांसा के एक गढ़वाला दीवार;</para>
  <para style="q1" vid="JER 15:20">ओमन तोर बिरूध म लड़हीं</para>
  <para style="q2" vid="JER 15:20">पर तोला जीत नइं सकहीं,</para>
  <para style="q1" vid="JER 15:20">काबरकि तोला छोंड़ाय अऊ बचाय बर</para>
  <para style="q2" vid="JER 15:20">मेंह तोर संग हवंव,”</para>
  <para style="q2" vid="JER 15:20">यहोवा ह ये घोसना करत हे।<verse eid="JER 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 15:21" />“मेंह तोला दुस्ट मनखेमन के हांथ ले बचाहूं</para>
  <para style="q2" vid="JER 15:21">अऊ निरदयी मनखेमन के पकड़ ले छोंड़ाहूं।”<verse eid="JER 15:21" /></para>
  <chapter eid="JER 15" />
  <chapter number="16" style="c" sid="JER 16" />
  <para style="s1">बिपत्ति के दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 16:1" />तब यहोवा के ये बचन फेर मोर करा आईस: <verse eid="JER 16:1" /><verse number="2" style="v" sid="JER 16:2" />“ये जगह म, तेंह बिहाव झन करबे अऊ इहां तोर बेटा-बेटी झन जनमाबे।” <verse eid="JER 16:2" /><verse number="3" style="v" sid="JER 16:3" />काबरकि जऊन बेटा-बेटीमन ये देस म जनमहीं अऊ जऊन दाई-ददामन ओमन ला जनमाहीं, ओमन के बारे म यहोवा ह ये कहत हे: <verse eid="JER 16:3" /><verse number="4" style="v" sid="JER 16:4" />“ओमन जान-लेवा बेमारीमन ले मरहीं। ओमन बर कोनो सोक नइं मनाहीं अऊ न ही ओमन ला माटी दिये जाही, पर ओमन सूखाय गोबर सहीं भुइयां म पड़े रहिहीं। ओमन तलवार अऊ अकाल ले मारे जाहीं, अऊ ओमन के लासमन चिरई अऊ जंगली पसुमन के जेवन होहीं।”<verse eid="JER 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 16:5" />काबरकि यहोवा ह ये कहत हे: “जऊन घर म मिरतू-भोज होवत हे, ओ घर म झन जा; उहां सोक मनाय बर या सहानुभूति देखाय बर झन जा, काबरकि मेंह ये मनखेमन ले अपन आसीस, अपन मया अऊ अपन दया ला लेय ले हंव,” यहोवा ह ये घोसना करत हे। <verse eid="JER 16:5" /><verse number="6" style="v" sid="JER 16:6" />“छोटे अऊ बड़े दूनों मनखे ये देस म मरहीं। ओमन ला न तो माटी दिये जाही अऊ न ही ओमन बर सोक मनाय जाही, अऊ मरे मनखे बर दुख परगट करे बर कोनो अपनआप ला नइं काटहीं अऊ न ही मुड़ मुड़ाहीं। <verse eid="JER 16:6" /><verse number="7" style="v" sid="JER 16:7" />मरे मनखे बर जऊन ह सोक मनाही, ओला अराम देय बर कोनो जेवन नइं दीहीं—अऊ त अऊ काकरो दाई या ददा के मरे म घलो—अऊ न ही सोक मनइयामन ला सांति देय बर, कोनो कुछू पीये बर दीहीं।<verse eid="JER 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 16:8" />“अऊ जऊन घर म भोज होवथे, उहां झन जाबे अऊ उहां बईठके झन खाबे-पीबे। <verse eid="JER 16:8" /><verse number="9" style="v" sid="JER 16:9" />काबरकि सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: तोर देखत म अऊ तोर दिन म ही, मेंह आनंद अऊ खुसी के अवाज अऊ दूल्हा अऊ दुलहिन के अवाज ला ये जगह म खतम कर दूहूं।<verse eid="JER 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 16:10" />“जब तेंह ये मनखेमन ला ये जम्मो बात कहिबे अऊ ओमन तोर ले पुछहीं, ‘यहोवा ह हमर ऊपर अइसने बड़े बिपत्ति के हुकूम काबर देय हवय? हमन का गलत करे हवन? हमन यहोवा हमर परमेसर के बिरूध म का पाप करे हन?’ <verse eid="JER 16:10" /><verse number="11" style="v" sid="JER 16:11" />तब तें ओमन ला कह, यहोवा ह ये घोसना करत हे: ‘काबरकि तुम्हर पुरखामन मोला तियाग दीन, अऊ आने देवतामन के पाछू चलिन अऊ ओमन के सेवा अऊ अराधना करिन। ओमन मोला तियाग दीन अऊ मोर कानून के पालन नइं करिन। <verse eid="JER 16:11" /><verse number="12" style="v" sid="JER 16:12" />पर तुमन तुम्हर पुरखामन ले घलो जादा दुस्टता के काम करे हवव। देखव, तुमन मोर हुकूम माने के बदले, कइसे अपन दुस्टता के जिद्दी सुभाव म चलत हवव। <verse eid="JER 16:12" /><verse number="13" style="v" sid="JER 16:13" />एकरसेति मेंह तुमन ला ये देस ले उखानके एक अइसने देस म फेंक दूहूं, जेला न तो तुमन जानत हव अऊ न ही तुम्हर पुरखामन जानत रिहिन, अऊ उहां तुमन रात अऊ दिन आने देवतामन के सेवा करहू, काबरकि मेंह तुम्हर ऊपर कुछू किरपा नइं करहूं।’<verse eid="JER 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 16:14" />“जइसन भी हो, अइसने दिनमन आवत हें,” यहोवा ह घोसना करत हे, “जब ये फेर नइं कहे जाही, ‘ओ यहोवा के जिनगी के कसम, जऊन ह इसरायलीमन ला मिसर देस ले निकालके ले आईस,’ <verse eid="JER 16:14" /><verse number="15" style="v" sid="JER 16:15" />पर ये कहे जाही, ‘ओ यहोवा के जिनगी के कसम, जऊन ह इसरायलीमन ला उत्तर के देस ले अऊ ओ जम्मो देसमन ले निकालके ले आईस, जिहां ओह ओमन ला बंधुवा कर दे रिहिस।’ काबरकि मेंह ओमन ला ओ देस म लहुंटाके ले आहूं, जऊन ला मेंह ओमन के पुरखामन ला देय रहेंव।<verse eid="JER 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 16:16" />“यहोवा ह ये घोसना करत हे: पर अब मेंह बहुंत मछुआरमन ला बुलवाहूं, अऊ ओमन ये मनखेमन ला पकड़ लीहीं। ओकर बाद मेंह बहुंत सिकारीमन ला बुलवाहूं, अऊ ओमन ये मनखेमन ला हर पहाड़ अऊ पठार अऊ चट्टानमन के दरारमन म खोजहीं। <verse eid="JER 16:16" /><verse number="17" style="v" sid="JER 16:17" />मोर आंखीमन ओमन के जम्मो चालचलन ला देखत हवंय; ओमन मोर ले लुकाय नइं एं, अऊ न ही ओमन के पाप ह मोर नजर ले लुकाय हवय। <verse eid="JER 16:17" /><verse number="18" style="v" sid="JER 16:18" />मेंह ओमन के अधरम अऊ पाप के दू गुना सजा दूहूं, काबरकि ओमन मोर देस ला अपन निरजीव बेकार चीजमन ले असुध कर दे हवंय अऊ मोर निज भाग ला अपन घिनौना मूरतीमन ले भर दे हवंय।”<verse eid="JER 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 16:19" />हे यहोवा, हे मोर ताकत अऊ मजबूत गढ़,</para>
  <para style="q2" vid="JER 16:19">संकट के बेरा म मोला सरन देवइया,</para>
  <para style="q1" vid="JER 16:19">जाति-जाति के मनखेमन धरती के छोर ले</para>
  <para style="q2" vid="JER 16:19">तोर करा आहीं अऊ कहिहीं,</para>
  <para style="q1" vid="JER 16:19">“हमर पुरखामन जुच्छा के देवतामन ला रखे रिहिन,</para>
  <para style="q2" vid="JER 16:19">ओमन बेकार के मूरतीमन रिहिन अऊ ओमन के दुवारा हमर पुरखामन के कुछू भलई नइं होईस।<verse eid="JER 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 16:20" />का मनखेमन अपन खुद के देवतामन ला बनाथें?</para>
  <para style="q2" vid="JER 16:20">हव, पर ओमन देवता नो हंय!”<verse eid="JER 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 16:21" />“एकरसेति मेंह ओमन ला सिखाहूं—</para>
  <para style="q2" vid="JER 16:21">ये बेरा मेंह ओमन ला</para>
  <para style="q2" vid="JER 16:21">अपन बल अऊ ताकत ला देखाहूं।</para>
  <para style="q1" vid="JER 16:21">तब ओमन जानहीं</para>
  <para style="q2" vid="JER 16:21">कि मोर नांव यहोवा अय।”<verse eid="JER 16:21" /></para>
  <para style="b" />
  <chapter eid="JER 16" />
  <chapter number="17" style="c" sid="JER 17" />
  <para style="q1">
    <verse number="1" style="v" sid="JER 17:1" />“यहूदा के पाप ह लोहा के कलम,</para>
  <para style="q2" vid="JER 17:1">अऊ चकमक पथरा के छोर ले,</para>
  <para style="q1" vid="JER 17:1">ओमन के हिरदय रूपी पटिया</para>
  <para style="q2" vid="JER 17:1">अऊ ओमन के बेदीमन के सींगमन म लिखे गे हवय।<verse eid="JER 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 17:2" />अऊ त अऊ ओमन के लइकामन</para>
  <para style="q2" vid="JER 17:2">ओमन के ओ बेदीमन ला अऊ असेरा देवी के खंभामन ला सुरता करथें</para>
  <para style="q1" vid="JER 17:2">जऊन मन फईले हुए रूखमन के बाजू</para>
  <para style="q2" vid="JER 17:2">अऊ ऊंचहा पठारमन ऊपर हवंय।<verse eid="JER 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 17:3" />जम्मो जगह म तोर पाप के कारन,</para>
  <para style="q2" vid="JER 17:3">देस म मोर पहाड़,</para>
  <para style="q1" vid="JER 17:3">अऊ तोर धन-संपत्ति अऊ तोर जम्मो खजाना ला,</para>
  <para style="q2" vid="JER 17:3">तोर ऊंचहा जगहमन सहित,</para>
  <para style="q2" vid="JER 17:3">मेंह लूट म तोर बईरीमन ला दे दूहूं।<verse eid="JER 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 17:4" />अपन खुद के गलती के कारन</para>
  <para style="q2" vid="JER 17:4">तेंह ओ उत्तराधिकार ला गंवा देबे, जऊन ला मेंह तोला देय रहेंव।</para>
  <para style="q1" vid="JER 17:4">मेंह एक अनजान देस म</para>
  <para style="q2" vid="JER 17:4">तोला तोर बईरीमन के गुलाम बना दूहूं,</para>
  <para style="q1" vid="JER 17:4">काबरकि तेंह मोर गुस्सा रूपी आगी ला भड़काय हस,</para>
  <para style="q2" vid="JER 17:4">अऊ येह हमेसा बरत रहिही।”<verse eid="JER 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 17:5" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 17:5">“सरापित ए ओ मनखे, जऊन ह मनखे ऊपर भरोसा करथे,</para>
  <para style="q2" vid="JER 17:5">जऊन ह मनखे के सहारा लेथे</para>
  <para style="q2" vid="JER 17:5">अऊ जेकर मन ह यहोवा ले भटक जाथे।<verse eid="JER 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 17:6" />ओ मनखे ह बंजर भुइयां के झाड़ी सहीं होही;</para>
  <para style="q2" vid="JER 17:6">अऊ जब उन्नति के समय आही, त ओह ओला नइं देख सकही।</para>
  <para style="q1" vid="JER 17:6">ओह सुन्ना जगह म गरमी ले झुलसत भुइयां म निवास करही,</para>
  <para style="q2" vid="JER 17:6">अइसने नूनचूर भुइयां म निवास करही, जिहां कोनो नइं रहंय।<verse eid="JER 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 17:7" />“धइन ए ओ मनखे, जऊन ह यहोवा ऊपर भरोसा करथे,</para>
  <para style="q2" vid="JER 17:7">जेकर भरोसा परमेसर ऊपर हवय।<verse eid="JER 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 17:8" />ओह पानी के तीर म लगे रूख के सहीं होही</para>
  <para style="q2" vid="JER 17:8">जेकर जरीमन पानी के सोत म फईले रहिथें।</para>
  <para style="q1" vid="JER 17:8">जब घाम होथे, त येह नइं डरय;</para>
  <para style="q2" vid="JER 17:8">येकर पानमन हमेसा हरियर रहिथें।</para>
  <para style="q1" vid="JER 17:8">साल भर के दुकाल म घलो येह चिंता नइं करय</para>
  <para style="q2" vid="JER 17:8">अऊ समय म फरे ले नइं चुकय।”<verse eid="JER 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JER 17:9" />मन ह जम्मो चीजमन ले जादा धोखा देवइया अय</para>
  <para style="q2" vid="JER 17:9">अऊ येकर ईलाज नइं ए।</para>
  <para style="q2" vid="JER 17:9">येला कोन समझ सकथे?<verse eid="JER 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 17:10" />“में यहोवा ह मन ला खोजथंव</para>
  <para style="q2" vid="JER 17:10">अऊ दिमाग ला जांचथंव,</para>
  <para style="q1" vid="JER 17:10">ताकि हर एक मनखे ला ओकर चालचलन के मुताबिक,</para>
  <para style="q2" vid="JER 17:10">अऊ ओकर काम के मुताबिक ईनाम देवंव।”<verse eid="JER 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 17:11" />जइसने तीतर ह आने चिरई के देय गार ला सेथे</para>
  <para style="q2" vid="JER 17:11">वइसने ओमन होथें, जऊन मन अनियाय करके धन कमाथें।</para>
  <para style="q1" vid="JER 17:11">जब ओमन के आधा जिनगी खतम हो जाथे, त ओमन के धन ह ओमन ला छोंड़ देथे,</para>
  <para style="q2" vid="JER 17:11">अऊ आखिरी म ओमन मुरूख साबित होथें।<verse eid="JER 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JER 17:12" />सुरू ले ऊपर उठाय गे एक महिमामय सिंघासन ह,</para>
  <para style="q2" vid="JER 17:12">हमर पबितर-स्थान के जगह अय।<verse eid="JER 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 17:13" />हे यहोवा, तेंह इसरायल के आसा अस;</para>
  <para style="q2" vid="JER 17:13">जऊन मन तोला तियाग देथें, ओमन लज्जित होहीं।</para>
  <para style="q1" vid="JER 17:13">जऊन मन तोर ले मुहूं फेर लेथें, ओमन के नांव धुर्रा म लिखे जाही</para>
  <para style="q2" vid="JER 17:13">काबरकि ओमन ओ यहोवा ला तियाग दे हवंय,</para>
  <para style="q2" vid="JER 17:13">जऊन ह जीयत पानी के सोता अय।<verse eid="JER 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 17:14" />हे यहोवा, मोला चंगा कर, त मेंह चंगा हो जाहूं;</para>
  <para style="q2" vid="JER 17:14">मोला बचा, त मेंह बच जाहूं,</para>
  <para style="q2" vid="JER 17:14">काबरकि मेंह सिरिप तोर ही महिमा करथंव।<verse eid="JER 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 17:15" />ओमन मोला कहिते रहिथें,</para>
  <para style="q2" vid="JER 17:15">“यहोवा के बचन कहां हवय?</para>
  <para style="q2" vid="JER 17:15">ओह अभी पूरा होवय!”<verse eid="JER 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 17:16" />तोर चरवाहा बने ले मेंह मुहूं नइं मोड़े हंव;</para>
  <para style="q2" vid="JER 17:16">तेंह जानत हस कि मेंह निरासा के दिन के ईछा नइं करे हंव।</para>
  <para style="q2" vid="JER 17:16">मोर मुहूं ले जऊन बात निकलथे, ओला तेंह जानत हस।<verse eid="JER 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 17:17" />मोर बर एक आतंक झन बन;</para>
  <para style="q2" vid="JER 17:17">बिपत्ति के दिन म तेंह मोला सरन देवइया अस।<verse eid="JER 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 17:18" />मोला सतानेवालामन लज्जित होवंय,</para>
  <para style="q2" vid="JER 17:18">पर मोला लज्जित होय ले बचा;</para>
  <para style="q1" vid="JER 17:18">मोला सतानेवालामन भयभीत होवंय,</para>
  <para style="q2" vid="JER 17:18">पर मोला भयभीत होय ले बचा।</para>
  <para style="q1" vid="JER 17:18">ओमन ऊपर दू गुना बिपत्ति लान;</para>
  <para style="q2" vid="JER 17:18">ओमन ला चकनाचूर कर दे।<verse eid="JER 17:18" /></para>
  <para style="s1">बिसराम दिन ला पबितर मनई</para>
  <para style="p">
    <verse number="19" style="v" sid="JER 17:19" />यहोवा ह मोला ये कहिस: “जा अऊ मनखेमन<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सेना</char></note> के प्रवेस बर जऊन दुवार हे, उहां ठाढ़ हो जा, जिहां ले यहूदा के राजामन भीतर-बाहिर आथें-जाथें; यरूसलेम के आने जम्मो दुवारमन करा घलो ठाढ़ हो जा, <verse eid="JER 17:19" /><verse number="20" style="v" sid="JER 17:20" />अऊ ओमन ले कह, ‘हे यहूदा के राजामन अऊ जम्मो यहूदीमन अऊ यरूसलेम के जम्मो रहइयामन, जऊन मन ये दुवारमन ले आथव, यहोवा के बचन ला सुनव। <verse eid="JER 17:20" /><verse number="21" style="v" sid="JER 17:21" />यहोवा ह ये कहत हे: सावधान रहव, बिसराम के दिन कोनो बोझा ला झन उठावव या कोनो बोझा यरूसलेम के दुवारमन ले झन लानव। <verse eid="JER 17:21" /><verse number="22" style="v" sid="JER 17:22" />बिसराम के दिन अपन घर ले कोनो बोझा ला बाहिर झन लानव या कोनो काम झन करव, पर जइसने कि मेंह तुम्हर पुरखामन ला हुकूम देय रहेंव, बिसराम के दिन ला पबितर माने करव। <verse eid="JER 17:22" /><verse number="23" style="v" sid="JER 17:23" />तभो ले ओमन नइं सुनिन या धियान नइं दीन; ओमन हठी रिहिन अऊ ताड़ना देय ले घलो बात ला नइं सुनिन या नइं मानिन। <verse eid="JER 17:23" /><verse number="24" style="v" sid="JER 17:24" />पर यदि तुमन सावधानी से मोर बात ला मानव, यहोवा ह ये घोसना करत हे, अऊ बिसराम के दिन ये सहर के दुवारमन ले कोनो बोझा ला झन लानव, पर बिसराम के दिन ला कोनो काम नइं करे के दुवारा पबितर मानव, <verse eid="JER 17:24" /><verse number="25" style="v" sid="JER 17:25" />तब ओ राजा, जऊन मन दाऊद के सिंघासन म बईठहीं, ओमन अपन करमचारीमन संग ये सहर के दुवारमन ले आहीं। ओमन अऊ ओमन के करमचारीमन रथ अऊ घोड़ामन म सवार होके आहीं, अऊ ओमन के संग यहूदा के मनखे अऊ यरूसलेम के रहइया मनखेमन घलो आहीं, अऊ ये यरूसलेम सहर म मनखेमन हमेसा बसे रहिहीं। <verse eid="JER 17:25" /><verse number="26" style="v" sid="JER 17:26" />मनखेमन यहूदा के नगरमन ले अऊ यरूसलेम के आसपास के गांवमन ले, बिनयामीन के छेत्र अऊ पछिम के पहाड़ी छेत्र ले, पहाड़ी देस अऊ नेगेव<note caller="+" style="f"><char style="fr" closed="false">17:26 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">दक्खिनी यहूदा</char></note> ले, होम-बलिदान अऊ बलिदान, अन्न-बलिदान अऊ लोहबान, अऊ धनबाद-बलिदान लेके यहोवा के घर म आहीं। <verse eid="JER 17:26" /><verse number="27" style="v" sid="JER 17:27" />पर यदि तुमन मोर बात ला नइं मानहू अऊ बिसराम के दिन यरूसलेम के दुवारमन ले कोनो बोझा उठाके आय के दुवारा बिसराम के दिन ला अपबितर करहू, त फेर मेंह यरूसलेम के कपाटमन म अइसने आगी लगाहूं, जऊन ह नइं बुताही अऊ यरूसलेम के महलमन ला जलाके भसम कर दीही।’ ”<verse eid="JER 17:27" /></para>
  <chapter eid="JER 17" />
  <chapter number="18" style="c" sid="JER 18" />
  <para style="s1">यरमियाह ह कुम्हार के घर म</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 18:1" />यहोवा कोति ले ये बचन यरमियाह करा आईस: <verse eid="JER 18:1" /><verse number="2" style="v" sid="JER 18:2" />“खाल्हे कुम्हार के घर म जा, अऊ उहां मेंह तोला अपन संदेस दूहूं।” <verse eid="JER 18:2" /><verse number="3" style="v" sid="JER 18:3" />एकरसेति मेंह कुम्हार के घर गेंव, अऊ मेंह ओला चाक म काम करत देखेंव। <verse eid="JER 18:3" /><verse number="4" style="v" sid="JER 18:4" />पर जऊन माटी के बरतन ओह बनावत रिहिस, ओह ओकर हांथ म बिगड़ गीस; त ओला जइसने बने लगिस, वइसने ओह ओ माटी ला आने बरतन के आकार दे दीस।<verse eid="JER 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 18:5" />तब यहोवा के ये बचन मोर करा आईस। <verse eid="JER 18:5" /><verse number="6" style="v" sid="JER 18:6" />ओह कहिस, “हे इसरायल के मनखेमन, जइसने ये कुम्हार ह करत हे, का मेंह घलो तुम्हर संग वइसने नइं कर सकत हंव?” यहोवा ह घोसना करत हे। “हे इसरायल, जइसने कुम्हार के हांथ म माटी हवय, वइसने तेंह घलो मोर हांथ म हस। <verse eid="JER 18:6" /><verse number="7" style="v" sid="JER 18:7" />यदि कोनो भी समय, मेंह घोसना करथंव कि कोनो जाति या राज ला उखान दिये जावय, गिरा दिये जावय अऊ नास कर दिये जावय, <verse eid="JER 18:7" /><verse number="8" style="v" sid="JER 18:8" />अऊ यदि ओ देस के मनखेमन पाप ले पछताप करथें, जेला मेंह चेतउनी दे रहेंव, तब मेंह धीरज धरहूं अऊ जऊन बिपत्ति मेंह ओमन ऊपर लाने के ठाने रहेंव, ओला नइं लानहूं, <verse eid="JER 18:8" /><verse number="9" style="v" sid="JER 18:9" />अऊ यदि आने समय म, मेंह घोसना करथंव कि कोनो जाति या राज ला बनाय जावय अऊ जगाय जावय, <verse eid="JER 18:9" /><verse number="10" style="v" sid="JER 18:10" />अऊ यदि ओ जाति मोर नजर म पाप करथे अऊ मोर बात ला नइं मानय, तब मेंह जऊन भलई करे के इरादा ओमन बर करे रहेंव, ओकर बारे म फेर बिचार करहूं।<verse eid="JER 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 18:11" />“एकरसेति अब तें यहूदा अऊ यरूसलेम के मनखेमन ला कह, ‘यहोवा ह ये कहत हे: देखव! मेंह तुम्हर बर एक बिपत्ति तियार करत हंव अऊ तुम्हर बिरूध म एक योजना बनात हंव। एकरसेति तुमन ले हर एक जन अपन खराप चालचलन ले फिरव अऊ अपन चालचलन अऊ काममन ला सुधारव।’ <verse eid="JER 18:11" /><verse number="12" style="v" sid="JER 18:12" />पर ओमन जबाब दीहीं, ‘अइसने नइं होवय। हमन अपन ही चालचलन म चलते रहिबो; हमन जम्मो अपन पापी हिरदय के जिद म बने रहिबो।’ ”<verse eid="JER 18:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="JER 18:13" />ये खातिर यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 18:13">“जाति-जाति के मनखेमन ले पुछव:</para>
  <para style="q2" vid="JER 18:13">अइसने बात कोनो कभू सुने हवय?</para>
  <para style="q1" vid="JER 18:13">एक सबले खराप काम</para>
  <para style="q2" vid="JER 18:13">कुंवारी इसरायल<note caller="+" style="f"><char style="fr" closed="false">18:13 </char><char style="ft" closed="false">याने कि </char><char style="fqa" closed="false">इसरायल के मनखेमन</char></note> ह करे हवय।<verse eid="JER 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 18:14" />का लबानोन के बरफ ह</para>
  <para style="q2" vid="JER 18:14">कभू येकर पथरीला-ढालमन ले गायब होथे?</para>
  <para style="q1" vid="JER 18:14">दूरिहा के सोतमन ले येकर ठंडा पानी</para>
  <para style="q2" vid="JER 18:14">के बहना कभू बंद होथे?<verse eid="JER 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 18:15" />तभो ले मोर मनखेमन मोला भुला गे हवंय;</para>
  <para style="q2" vid="JER 18:15">ओमन ओ बेकार के मूरतीमन बर धूप जलाथें,</para>
  <para style="q1" vid="JER 18:15">जऊन मन ओ पुराना जमाना के रसतामन म,</para>
  <para style="q2" vid="JER 18:15">ओमन के ठोकर के कारन बनथें।</para>
  <para style="q1" vid="JER 18:15">ओ मूरतीमन ओमन ला ओ आने रसतामन म चले बर मजबूर करथें,</para>
  <para style="q2" vid="JER 18:15">जऊन रसता ह बने नइं ए।<verse eid="JER 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 18:16" />ओमन के देस ह निरजन हो जाही,</para>
  <para style="q2" vid="JER 18:16">अऊ ओकर ले हमेसा घिन करे जाही;</para>
  <para style="q1" vid="JER 18:16">ओ जम्मो, जऊन मन उहां ले होके जाहीं, ओमन डराहीं,</para>
  <para style="q2" vid="JER 18:16">अऊ अचम्भो करके अपन मुड़ ला हलाहीं।<verse eid="JER 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 18:17" />पूरब के हवा सहीं,</para>
  <para style="q2" vid="JER 18:17">मेंह ओमन ला ओमन के बईरीमन के आघू म तितिर-बितिर कर दूहूं;</para>
  <para style="q1" vid="JER 18:17">ओमन के बिपत्ति के दिन म,</para>
  <para style="q2" vid="JER 18:17">मेंह ओमन ला अपन मुहूं नइं, पर अपन पीठ देखाहूं।”<verse eid="JER 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 18:18" />तब मनखेमन एक-दूसर ला कहिन, “आवव, यरमियाह के बिरूध उपाय करन; काबरकि न तो पुरोहित के दुवारा कानून के सिकछा, न ही बुद्धिमान के सलाह, न ही अगमजानीमन ले बचन ह बंद होही। एकरसेति आवव, हमन अपन बात के दुवारा ओकर ऊपर हमला करन अऊ ओकर कोनो बात ऊपर धियान झन देवन।”<verse eid="JER 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 18:19" />हे यहोवा, मोर बात ला सुन;</para>
  <para style="q2" vid="JER 18:19">मोर ऊपर दोस लगानेवालामन का कहत हें, ओला सुन!<verse eid="JER 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 18:20" />का भलई के बदले बुरई करे जावय?</para>
  <para style="q2" vid="JER 18:20">तभो ले ओमन मोर बर खंचवा कोड़े हवंय।</para>
  <para style="q1" vid="JER 18:20">सुरता कर कि मेंह तोर आघू म ठाढ़ होके</para>
  <para style="q2" vid="JER 18:20">ओमन बर गोठियाय हंव</para>
  <para style="q2" vid="JER 18:20">ताकि तोर गुस्सा ह ओमन ऊपर ले उतर जावय।<verse eid="JER 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 18:21" />एकरसेति ओमन के लइकामन ला अकाल ला देय दे;</para>
  <para style="q2" vid="JER 18:21">ओमन ला तलवार ले कटके मरे बर देय दे।</para>
  <para style="q1" vid="JER 18:21">ओमन के घरवालीमन बिगर लइका के रहंय अऊ बिधवा हो जावंय;</para>
  <para style="q2" vid="JER 18:21">ओमन के मनखेमन मर जावंय,</para>
  <para style="q2" vid="JER 18:21">ओमन के जवानमन लड़ई म तलवार ले मारे जावंय।<verse eid="JER 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 18:22" />जब तें ओमन ऊपर अचानक हमला करइयामन ला लानबे,</para>
  <para style="q2" vid="JER 18:22">त ओमन के घरमन ले रोये के अवाज सुनई देवय,</para>
  <para style="q1" vid="JER 18:22">काबरकि ओमन मोला पकड़े बर एक खंचवा कोड़े हवंय</para>
  <para style="q2" vid="JER 18:22">अऊ मोला फंसाय बर फांदा लगाय हवंय।<verse eid="JER 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 18:23" />पर हे यहोवा, ओमन मोला मार डारे बर</para>
  <para style="q2" vid="JER 18:23">जऊन उपायमन ला करे हवंय, ओ जम्मो ला तेंह जानत हस।</para>
  <para style="q1" vid="JER 18:23">ओमन के अपराध ला छेमा झन करबे</para>
  <para style="q2" vid="JER 18:23">या ओमन के पाप ला अपन नजर ले झन हटाबे।</para>
  <para style="q1" vid="JER 18:23">ओमन ला तोर आघू ले उखानके फटिक दिये जावय;</para>
  <para style="q2" vid="JER 18:23">अपन गुस्सा के बेरा म ओमन के लेखा ले।<verse eid="JER 18:23" /></para>
  <chapter eid="JER 18" />
  <chapter number="19" style="c" sid="JER 19" />
  <para style="p">
    <verse number="1" style="v" sid="JER 19:1" />यहोवा ह ये कहत हे: “जा अऊ कुम्हार ले माटी के एक ठन सुराही बिसा ले। अपन संग म मनखेमन के अऊ पुरोहितमन के कुछू अगुवामन ला लेय ले <verse eid="JER 19:1" /><verse number="2" style="v" sid="JER 19:2" />अऊ पोटसर्ड दुवार के लकठा म बेन-हिन्नोम के घाटी करा जा अऊ जऊन बचन मेंह तोला कहत हंव, ओकर परचार कर, <verse eid="JER 19:2" /><verse number="3" style="v" sid="JER 19:3" />अऊ कह, ‘हे यहूदा के राजामन अऊ यरूसलेम के मनखेमन, यहोवा के बचन ला सुनव, सर्वसक्तिमान यहोवा, इसरायल के परमेसर, ये कहत हे: सुनव! ये जगह म मेंह एक बिपत्ति लानेवाला हंव, जेला सुनके मनखेमन म सनसनी फईल जाही। <verse eid="JER 19:3" /><verse number="4" style="v" sid="JER 19:4" />काबरकि ओमन मोला तियाग दे हवंय अऊ येला आने देवतामन के जगह बना दे हवंय; ओमन येमा ओ देवतामन बर धूप जलाय हवंय, जेला न तो ओमन, न ही ओमन के पुरखामन अऊ न ही यहूदा के राजामन कभू जानत रिहिन, अऊ ओमन ये जगह ला निरदोसमन के खून ले भर दे हवंय। <verse eid="JER 19:4" /><verse number="5" style="v" sid="JER 19:5" />ओमन बाल देवता के ऊंचहा जगहमन ला बनाय हवंय, ताकि ओमन अपन लइकामन ला बाल देवता बर बलिदान के रूप म आगी म जलावंय—जेकर हुकूम मेंह नइं दे रहेंव या ओकर चरचा नइं करे रहेंव अऊ न ही ये बात मोर मन म कभू आईस। <verse eid="JER 19:5" /><verse number="6" style="v" sid="JER 19:6" />एकरसेति यहोवा ह ये घोसना करत हे, सचेत रहव, ओ दिनमन आवत हें, जब मनखेमन ये जगह ला तोपेत या बेन-हिन्नोम के घाटी नइं कहिहीं, पर हतिया के घाटी कहिहीं।<verse eid="JER 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 19:7" />“ ‘ये जगह म मेंह यहूदा अऊ यरूसलेम के योजनामन ला बेकार कर दूहूं। मेंह ओमन ला ओमन के बईरीमन के आघू म ओ मनखेमन के हांथ ले तलवार ले मरवाहूं, जऊन मन ओमन ला मार डारे चाहत हें, अऊ मेंह ओमन के लासमन ला जेवन के रूप म चिरई अऊ जंगली पसुमन ला दे दूहूं। <verse eid="JER 19:7" /><verse number="8" style="v" sid="JER 19:8" />मेंह ये सहर ला बरबाद कर दूहूं अऊ येला डर अऊ ठट्ठा के चीज बना दूहूं; ओ जम्मो, जऊन मन इहां ले होके जाहीं, ओमन येकर बिपत्ति ला देखके डरहीं अऊ येकर हंसी उड़ाहीं। <verse eid="JER 19:8" /><verse number="9" style="v" sid="JER 19:9" />मेंह ओमन ला ओमन के बेटा अऊ बेटीमन के मांस खवाहूं, अऊ ओमन एक-दूसर के मांस खाहीं, काबरकि ओमन के बईरीमन ओमन ला नास करे बर ओमन के बिरूध सैनिकमन के दुवारा घेराबंदी करवाहीं।’<verse eid="JER 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 19:10" />“तब तें ओ सुराही ला ओ मनखेमन के देखत म फोर देबे, जऊन मन तोर संग म जाहीं, <verse eid="JER 19:10" /><verse number="11" style="v" sid="JER 19:11" />अऊ ओमन ले कहिबे, ‘सर्वसक्तिमान यहोवा ह ये कहत हे: जइसने ये कुम्हार के सुराही अऊ येला फेर बनाय नइं जा सकय, वइसने मेंह ये देस अऊ ये सहर ला कुटा-कुटा कर दूहूं। तोपेत म ओमन अतेक मनखेमन ला माटी दीहीं कि उहां माटी देय बर अऊ जगह ही नइं बचही। <verse eid="JER 19:11" /><verse number="12" style="v" sid="JER 19:12" />ये जगह के संग अऊ जऊन मन इहां रहिथें, ओमन के संग मेंह अइसने ही करहूं, यहोवा ह ये घोसना करत हे। मेंह ये सहर ला तोपेत के सहीं कर दूहूं। <verse eid="JER 19:12" /><verse number="13" style="v" sid="JER 19:13" />यरूसलेम के घर अऊ यहूदा के राजामन के महलमन ला, ये जगह तोपेत के सहीं असुध करे जाही—ओ जम्मो घर जिहां मनखेमन छानी म अकास के जम्मो देवतामन बर धूप जलाय रिहिन अऊ आने देवतामन बर पेय-बलिदान देय रिहिन।’ ”<verse eid="JER 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 19:14" />तब यरमियाह ह तोपेत ले लहुंटिस, जिहां यहोवा ह ओला अगमबानी करे बर पठोय रिहिस, अऊ यहोवा के मंदिर के अंगना म ठाढ़ हो गीस अऊ जम्मो मनखेमन ला कहिस, <verse eid="JER 19:14" /><verse number="15" style="v" sid="JER 19:15" />“सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: ‘सुनव! मेंह ये सहर अऊ येकर चारों कोति के जम्मो गांवमन म हर ओ बिपत्ति लानहूं, जेकर घोसना मेंह ओमन के बिरूध म करे हवंव, काबरकि ओमन हठी अंय अऊ मोर बचन ला नइं सुनंय।’ ”<verse eid="JER 19:15" /></para>
  <chapter eid="JER 19" />
  <chapter number="20" style="c" sid="JER 20" />
  <para style="s1">यरमियाह अऊ पसहूर</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 20:1" />इम्मेर के बेटा पसहूर पुरोहित ह यहोवा के मंदिर के परधान अधिकारी रिहिस, जब ओह यरमियाह ला ये अगमबानी करत सुनिस, <verse eid="JER 20:1" /><verse number="2" style="v" sid="JER 20:2" />त पसहूर ह यरमियाह अगमजानी ला पीटवाईस अऊ ओकर गोड़ म बेड़ी लगाके ओला यहोवा के मंदिर म बिनयामीन के ऊपरी दुवार मेर रख दीस। <verse eid="JER 20:2" /><verse number="3" style="v" sid="JER 20:3" />ओकर दूसर दिन, जब पसहूर ह यरमियाह ला बेड़ी म ले छोंड़िस, त यरमियाह ह ओला कहिस, “यहोवा ह तोर नांव पसहूर नइं, पर जम्मो कोति के आतंक रखे हे। <verse eid="JER 20:3" /><verse number="4" style="v" sid="JER 20:4" />काबरकि यहोवा ह ये कहत हे: ‘मेंह तोला तोर बर अऊ तोर जम्मो संगवारीमन बर आतंक के कारन बनाहूं; तेंह खुद अपन आंखी ले देखबे कि ओमन ला ओमन के बईरीमन तलवार ले मार डारहीं। मेंह जम्मो यहूदीमन ला बेबिलोन के राजा के हांथ म कर दूहूं; ओह ओमन ला बंदी बनाके बेबिलोन ले जाही या ओमन ला तलवार ले मार डारही। <verse eid="JER 20:4" /><verse number="5" style="v" sid="JER 20:5" />मेंह ये सहर यरूसलेम के जम्मो धन-संपत्ति ला ओमन के बईरीमन के हांथ म कर दूहूं—येकर जम्मो कमई, येकर जम्मो कीमती सामान अऊ यहूदा के राजामन के जम्मो खजाना। ओमन ये जम्मो चीज ला लूट लीहीं अऊ येमन ला बेबिलोन ले जाहीं। <verse eid="JER 20:5" /><verse number="6" style="v" sid="JER 20:6" />अऊ हे पसहूर, तें अऊ, जऊन मन तोर घर म रहिथें, जम्मो के जम्मो बेबिलोन ला बंधुवई म चले जाहीं। तें अऊ तोर जम्मो संगवारी, जेमन ले तेंह झूठा अगमबानी करे हस, तुमन जम्मो के जम्मो उहां मरहू अऊ उहां तुमन ला माटी दिये जाही।’ ”<verse eid="JER 20:6" /></para>
  <para style="s1">यरमियाह के सिकायत</para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 20:7" />हे यहोवा, तेंह मोला धोखा दे हस,<note caller="+" style="f"><char style="fr" closed="false">20:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मनाय हस</char></note> अऊ मेंह धोखा खा गेंव;<note caller="+" style="f"><char style="fr" closed="false">20:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मान गेंव</char></note></para>
  <para style="q2" vid="JER 20:7">तेंह मोला हराय अऊ मोर ऊपर जय पाय हस।</para>
  <para style="q1" vid="JER 20:7">दिन भर मोर हंसी उड़ाय जावत हे;</para>
  <para style="q2" vid="JER 20:7">जम्मो झन मोर ठट्ठा करत हें।<verse eid="JER 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 20:8" />जब भी मेंह गोठियाथंव,</para>
  <para style="q2" vid="JER 20:8">मेंह चिचियाके हिंसा अऊ बिनास के घोसना करथंव।</para>
  <para style="q1" vid="JER 20:8">एकरसेति यहोवा के बचन ह दिन भर</para>
  <para style="q2" vid="JER 20:8">मोर ऊपर निन्दा अऊ कलंक लाने हवय।<verse eid="JER 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 20:9" />पर यदि में कहंव, “मेंह ओकर बचन के चरचा नइं करंव</para>
  <para style="q2" vid="JER 20:9">या ओकर नांव म अऊ नइं गोठियावंव,”</para>
  <para style="q1" vid="JER 20:9">त ओकर बचन ह मोर हिरदय म एक आगी सहीं अय,</para>
  <para style="q2" vid="JER 20:9">अइसने आगी जऊन ह मोर हाड़ामन म बंद हवय।</para>
  <para style="q1" vid="JER 20:9">मेंह येला अपन म रोकत-रोकत थक गे हंव;</para>
  <para style="q2" vid="JER 20:9">वास्तव म, में अब येला रोक नइं सकंव।<verse eid="JER 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 20:10" />मेंह बहुंत कानाफूसी के बात सुनत हंव,</para>
  <para style="q2" vid="JER 20:10">“हर तरफ आतंक!</para>
  <para style="q2" vid="JER 20:10">ओकर निन्दा करव! आवव, हमन ओकर निन्दा करन!”</para>
  <para style="q1" vid="JER 20:10">मोर जम्मो संगवारीमन ये कहत</para>
  <para style="q2" vid="JER 20:10">मोर ठोकर खाय के इंतजार करत हें,</para>
  <para style="q1" vid="JER 20:10">“सायद ओह धोखा खाही;</para>
  <para style="q2" vid="JER 20:10">तब हमन ओकर ऊपर जय पाबो</para>
  <para style="q2" vid="JER 20:10">अऊ ओकर ले अपन बदला लेबो।”<verse eid="JER 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 20:11" />पर यहोवा ह मोर संग एक सक्तिसाली योद्धा सहीं हवय;</para>
  <para style="q2" vid="JER 20:11">एकरसेति मोला सतानेवालामन गिर जाहीं अऊ जय नइं पावंय।</para>
  <para style="q1" vid="JER 20:11">ओमन असफल होहीं अऊ बहुंत लज्जित होहीं;</para>
  <para style="q2" vid="JER 20:11">ओमन के अपमान ह कभू भुलाय नइं जाही।<verse eid="JER 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 20:12" />हे सर्वसक्तिमान यहोवा, हे धरमीमन ला परखनेवाला</para>
  <para style="q2" vid="JER 20:12">अऊ हिरदय अऊ मन ला जांचनेवाला,</para>
  <para style="q1" vid="JER 20:12">ओमन ले जऊन बदला तेंह लेबे, ओला मोला देखन दे,</para>
  <para style="q2" vid="JER 20:12">काबरकि मेंह अपन मामला तोर ऊपर छोंड़ दे हंव।<verse eid="JER 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 20:13" />यहोवा बर गावव!</para>
  <para style="q2" vid="JER 20:13">यहोवा के परसंसा करव!</para>
  <para style="q1" vid="JER 20:13">ओह जरूरतमंद मनखे के जिनगी ला</para>
  <para style="q2" vid="JER 20:13">दुस्टमन के हांथ ले बचाथे।<verse eid="JER 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 20:14" />सरापित होवय ओ दिन, जऊन दिन मेंह जनमें!</para>
  <para style="q2" vid="JER 20:14">ओ दिन ह आसीसित झन होवय, जऊन दिन मोर दाई ह मोला जनम दीस!<verse eid="JER 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 20:15" />सरापित होवय ओ मनखे, जऊन ह ये कहिके</para>
  <para style="q2" vid="JER 20:15">मोर ददा ला खुसी के खबर दीस,</para>
  <para style="q2" vid="JER 20:15">“तोर एक लइका जनमे हे—एक बेटा!”<verse eid="JER 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 20:16" />ओ मनखे के दसा ह ओ नगर के सहीं होवय,</para>
  <para style="q2" vid="JER 20:16">जऊन ला यहोवा ह बिगर दया के नास कर दीस।</para>
  <para style="q1" vid="JER 20:16">ओला बिहनियां बिलाप करे के</para>
  <para style="q2" vid="JER 20:16">अऊ मंझनियां लड़ई के ललकार के अवाज सुनई देवय।<verse eid="JER 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 20:17" />काबरकि ओह मोला गरभ ही म नइं मार डारिस,</para>
  <para style="q2" vid="JER 20:17">मोर दाई के गरभ ह मोर कबर सहीं होतिस,</para>
  <para style="q2" vid="JER 20:17">अऊ ओकर गरभ ह हमेसा बर फईले रहितिस।<verse eid="JER 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 20:18" />मेंह काबर समस्या अऊ दुख देखे बर</para>
  <para style="q2" vid="JER 20:18">अऊ अपन जिनगी के दिनमन ला</para>
  <para style="q2" vid="JER 20:18">लज्जा म बिताय बर जनमेंव?<verse eid="JER 20:18" /></para>
  <chapter eid="JER 20" />
  <chapter number="21" style="c" sid="JER 21" />
  <para style="s1">परमेसर ह सिदकियाह के बिनती ला अस्वीकार करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 21:1" />ये बचन यहोवा करा ले यरमियाह करा तब आईस, जब सिदकियाह राजा ह ओकर करा मलकियाह के बेटा पसहूर अऊ मासेयाह पुरोहित के बेटा सपनयाह ला पठोईस। ओमन कहिन: <verse eid="JER 21:1" /><verse number="2" style="v" sid="JER 21:2" />“हमर बर यहोवा ले पुछ, काबरकि बेबिलोन के राजा नबूकदनेसर ह हमर ऊपर हमला करत हवय। सायद यहोवा ह पहिले के सहीं हमर बर अचरज के काम करय अऊ नबूकदनेसर ह हमर करा ले चले जावय।”<verse eid="JER 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 21:3" />पर यरमियाह ह ओमन ला जबाब दीस, “तुमन सिदकियाह ला कहव, <verse eid="JER 21:3" /><verse number="4" style="v" sid="JER 21:4" />‘यहोवा, इसरायल के परमेसर ह ये कहत हे: लड़ई के जऊन हथियार तुम्हर हांथ म हवय, जेकर उपयोग तुमन बेबिलोन के राजा अऊ सहर के दीवार के बाहिर घेरा डाले बेबिलोन के मनखेमन के बिरूध करत हव, ओही हथियारमन ला मेंह तुम्हर बिरूध करनेवाला हंव। अऊ मेंह ओ मनखेमन ला ये सहर के भीतर इकट्ठा करहूं। <verse eid="JER 21:4" /><verse number="5" style="v" sid="JER 21:5" />मेंह खुद हांथ बढ़ाके अऊ सक्तिसाली ताकतवर भुजा ले भयंकर गुस्सा अऊ कोरोध म तुम्हर बिरूध लड़हूं। <verse eid="JER 21:5" /><verse number="6" style="v" sid="JER 21:6" />मेंह ये सहर म रहइया जम्मो मनखे अऊ पसुमन ला मार डारहूं; ओमन एक भयंकर महामारी म मरहीं। <verse eid="JER 21:6" /><verse number="7" style="v" sid="JER 21:7" />ओकर बाद, यहोवा ह घोसना करत हे, यहूदा के राजा सिदकियाह, ओकर करमचारीमन अऊ ओ मनखे, जऊन मन ये सहर म महामारी, तलवार अऊ अकाल ले बांच जाहीं, ओ जम्मो ला में बेबिलोन के राजा नबूकदनेसर अऊ ओमन के बईरीमन के हांथ म कर दूहूं, जऊन मन कि ओमन ला मार डारे चाहत हें। ओह ओमन ला तलवार ले मार डारही; ओह ओमन ऊपर कोनो दया या किरपा या सहानुभूति नइं देखाही।’<verse eid="JER 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 21:8" />“मनखेमन ला ये घलो कह, ‘यहोवा ह ये कहत हे: देखव, मेंह तुम्हर आघू म जिनगी के रद्दा अऊ मिरतू के रद्दा घलो बतावत हंव। <verse eid="JER 21:8" /><verse number="9" style="v" sid="JER 21:9" />जऊन कोनो भी ये सहर म रहिही, ओह तलवार, अकाल या महामारी ले मरही। पर जऊन कोनो भी जाके ओ बेबिलोन के रहइयामन करा समरपन कर दीही, जऊन मन कि तुमन ला घेरे हवंय, त ओकर परान ह बच जाही अऊ ओह जीयत रहिही। <verse eid="JER 21:9" /><verse number="10" style="v" sid="JER 21:10" />मेंह ये सहर के भलई नइं पर हानि करे के ठान ले हंव, यहोवा ह घोसना करत हे। येला बेबिलोन के राजा के हांथ म कर दिये जाही, अऊ ओह येला आगी लगाके नास कर दीही।’<verse eid="JER 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 21:11" />“तभो ले यहूदा के राज-परिवार के मनखेमन ला कह, ‘यहोवा के बचन ला सुनव। <verse eid="JER 21:11" /><verse number="12" style="v" sid="JER 21:12" />हे दाऊद के संतानमन, यहोवा ह तुमन ला ये कहत हे:</para>
  <para style="q1" vid="JER 21:12">“ ‘हर बिहनियां नियाय करव;</para>
  <para style="q2" vid="JER 21:12">जऊन ला लूटे गे हवय, ओला</para>
  <para style="q2" vid="JER 21:12">दुख देवइया के हांथ ले बचावव,</para>
  <para style="q1" vid="JER 21:12">नइं तो जऊन दुस्ट काम तुमन करे हवव, ओकर कारन</para>
  <para style="q2" vid="JER 21:12">मोर गुस्सा ह भड़कही अऊ आगी सहीं बरही—</para>
  <para style="q2" vid="JER 21:12">अइसने आगी, जऊन ला कोनो बुता नइं सकंय।<verse eid="JER 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 21:13" />हे यरूसलेम के मनखेमन, जेमन ये घाटी के ऊपर</para>
  <para style="q2" vid="JER 21:13">चट्टान के पठार म रहिथव,</para>
  <para style="q2" vid="JER 21:13">मेंह तुम्हर बिरूध हंव, यहोवा ह घोसना करत हे—</para>
  <para style="q1" vid="JER 21:13">तुमन ये कहिथव, “हमर बिरूध कोन आ सकथे?</para>
  <para style="q2" vid="JER 21:13">हमर निवास के भीतर कोन जा सकथे?”<verse eid="JER 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 21:14" />मेंह तुम्हर काम के मुताबिक तुमन ला सजा दूहूं,</para>
  <para style="q2" vid="JER 21:14">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 21:14">मेंह तुम्हर जंगलमन म आगी लगा दूहूं</para>
  <para style="q2" vid="JER 21:14">जऊन ह तुम्हर चारों कोति के जम्मो चीज ला भसम कर दीही।’ ”<verse eid="JER 21:14" /></para>
  <chapter eid="JER 21" />
  <chapter number="22" style="c" sid="JER 22" />
  <para style="s1">दुस्ट राजामन के बिरूध म दंड</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 22:1" />यहोवा ह ये कहत हे: “खाल्हे म यहूदा के राजा के महल करा जा अऊ उहां ये संदेस के घोसना कर: <verse eid="JER 22:1" /><verse number="2" style="v" sid="JER 22:2" />‘दाऊद के सिंघासन म बईठनेवाला, हे यहूदा के राजा, तें, तोर करमचारी अऊ तोर मनखे, जऊन मन ये दुवारमन ले होके आथें, यहोवा के बचन ला सुनव। <verse eid="JER 22:2" /><verse number="3" style="v" sid="JER 22:3" />यहोवा ह ये कहत हे: जऊन काम सही अऊ बने अय, ओला करव। जऊन ला लूट लिये गे हवय, ओला दुख देवइया के हांथ ले बचावव। कोनो परदेसी, अनाथ या बिधवा के बिरूध कोनो गलत काम या हिंसा झन करव, अऊ ये जगह म निरदोस के खून झन बहावव। <verse eid="JER 22:3" /><verse number="4" style="v" sid="JER 22:4" />काबरकि यदि तुमन धियान से ये हुकूममन ला मानहू, त दाऊद के सिंघासन म बईठइया राजामन रथ अऊ घोड़ामन म सवार होके ये महल के दुवारमन म होके आहीं अऊ ओमन के करमचारी अऊ मनखेमन घलो ओमन के संग होहीं। <verse eid="JER 22:4" /><verse number="5" style="v" sid="JER 22:5" />पर यदि तुमन ये हुकूममन ला नइं मानहू, त यहोवा ह घोसना करत हे, मेंह खुद के कसम खाके कहत हंव कि ये महल ह उजड़ जाही।’ ”<verse eid="JER 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 22:6" />काबरकि यहोवा ह यहूदा के राजा के महल के बारे म ये कहत हे:</para>
  <para style="q1" vid="JER 22:6">“हालाकि तेंह मोर बर गिलाद देस सहीं,</para>
  <para style="q2" vid="JER 22:6">अऊ लबानोन के चोटी सहीं अस,</para>
  <para style="q1" vid="JER 22:6">पर मेंह तोला बंजर भुइयां सहीं,</para>
  <para style="q2" vid="JER 22:6">अऊ निरजन नगरमन सहीं कर दूहूं।<verse eid="JER 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 22:7" />मेंह तोर बिरूध म नास करइयामन ला पठोहूं,</para>
  <para style="q2" vid="JER 22:7">ओमा के हर एक जन करा हथियार होही,</para>
  <para style="q1" vid="JER 22:7">अऊ ओमन तोर सुघर देवदार रूख के गोलामन ला काटहीं</para>
  <para style="q2" vid="JER 22:7">अऊ ओमन ला आगी म झोंक दीहीं।<verse eid="JER 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 22:8" />“जाति-जाति के मनखेमन ये सहर म ले होके जाहीं अऊ एक-दूसर ले पुछहीं, ‘यहोवा ह ये महान सहर ला अइसने काबर कर दे हवय?’ <verse eid="JER 22:8" /><verse number="9" style="v" sid="JER 22:9" />तब ओकर ये जबाब दिये जाही: ‘काबरकि ओमन यहोवा अपन परमेसर के करार ला टोर दे हवंय अऊ आने देवतामन के अराधना अऊ सेवा करे हवंय।’ ”<verse eid="JER 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 22:10" />मरे राजा बर झन रोवव या ओकर मरे ले सोकित झन होवव;</para>
  <para style="q2" vid="JER 22:10">पर येकर बदले, ओकर बर फूट-फूटके रोवव, जऊन ह बंधुवई म चल दे हवय,</para>
  <para style="q1" vid="JER 22:10">काबरकि ओह फेर लहुंटके कभू नइं आही</para>
  <para style="q2" vid="JER 22:10">अऊ न ही अपन जनम भुइयां ला फेर देखही।<verse eid="JER 22:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="JER 22:11" />यहूदा के राजा योसियाह के बेटा सल्लूम, जऊन ह अपन ददा योसियाह के जगह म राजा बनिस अऊ ये जगह ले चल दे हवय, ओकर बारे म यहोवा ह ये कहत हे: “ओह फेर कभू लहुंटके नइं आही। <verse eid="JER 22:11" /><verse number="12" style="v" sid="JER 22:12" />ओह ओ जगह म मरही, जिहां ओला कैदी बनाके ले गे हवंय; ओह ये देस ला फेर कभू देखन नइं पाही।”<verse eid="JER 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 22:13" />“ओकर ऊपर हाय, जऊन ह अपन महल ला अधरम,</para>
  <para style="q2" vid="JER 22:13">अऊ अपन ऊपर के कमरामन ला अनियाय करके बनाथे,</para>
  <para style="q1" vid="JER 22:13">अऊ अपन खुद के मनखेमन ले बेगारी म काम कराथे,</para>
  <para style="q2" vid="JER 22:13">अऊ ओमन ला ओमन के बनी नइं देवय।<verse eid="JER 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 22:14" />ओह कहिथे, ‘मेंह अपन बर एक बड़े महल बनाहूं,</para>
  <para style="q2" vid="JER 22:14">जेकर ऊपर म बड़े-बड़े कमरामन होहीं।’</para>
  <para style="q1" vid="JER 22:14">एकरसेति ओह येमा बड़े-बड़े खिड़की लगाथे,</para>
  <para style="q2" vid="JER 22:14">अऊ येमा देवदार रूख के तखतामन ला लगाथे</para>
  <para style="q2" vid="JER 22:14">अऊ येला लाल रंग ले सजाथे।<verse eid="JER 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 22:15" />“का तोर करा जादा से जादा देवदार के कठवा होवई ह</para>
  <para style="q2" vid="JER 22:15">तोला एक राजा बनाथे?</para>
  <para style="q1" vid="JER 22:15">का तोर ददा करा खाय-पीये के चीज नइं रिहिस?</para>
  <para style="q2" vid="JER 22:15">ओह धरम अऊ नियाय के काम करिस,</para>
  <para style="q2" vid="JER 22:15">एकरसेति ओह सुख से जिनगी बिताईस।<verse eid="JER 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 22:16" />ओह गरीब अऊ दीन-हीन मनखेमन के बचाव करिस,</para>
  <para style="q2" vid="JER 22:16">एकरसेति ओकर संग जम्मो चीज सही होईस।</para>
  <para style="q1" vid="JER 22:16">का येह मोर गियान म रखे के बात नो हय?”</para>
  <para style="q2" vid="JER 22:16">यहोवा ह ये घोसना करत हे।<verse eid="JER 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 22:17" />“पर तोर आंखी अऊ तोर मन ह</para>
  <para style="q2" vid="JER 22:17">सिरिप अधरम के कमई,</para>
  <para style="q1" vid="JER 22:17">निरदोसमन के खून बहई</para>
  <para style="q2" vid="JER 22:17">अऊ अतियाचार अऊ लूट-पाट करई म लगे रहिथे।”<verse eid="JER 22:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="JER 22:18" />एकरसेति योसियाह के बेटा यहूदा के राजा यहोयाकीम के बारे म यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 22:18">“मनखेमन ओकर बर ये कहिके बिलाप नइं करहीं:</para>
  <para style="q2" vid="JER 22:18">‘हाय, हे मोर भाई! हाय, हे मोर बहिनी!’</para>
  <para style="q1" vid="JER 22:18">मनखेमन ओकर बर ये कहिके बिलाप नइं करहीं:</para>
  <para style="q2" vid="JER 22:18">‘हाय, हे मोर मालिक! हाय, हे ओकर सोभा!’<verse eid="JER 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 22:19" />ओला एक गदहा के सहीं माटी दिये जाही—</para>
  <para style="q2" vid="JER 22:19">ओला यरूसलेम के दुवारमन के बाहिर</para>
  <para style="q2" vid="JER 22:19">घसीटके फटिक दिये जाही।”<verse eid="JER 22:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 22:20" />“ऊपर लबानोन म जा अऊ रो,</para>
  <para style="q2" vid="JER 22:20">तोर अवाज ह बासान म सुनई देवय,</para>
  <para style="q1" vid="JER 22:20">अबारीम पहाड़ म जाके रो,</para>
  <para style="q2" vid="JER 22:20">काबरकि तोर जम्मो संगीमन नास हो गे हवंय।<verse eid="JER 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 22:21" />तोर सुख के बेरा म, मेंह तोला चेताय रहेंव,</para>
  <para style="q2" vid="JER 22:21">पर तेंह कहय, ‘मेंह नइं सुनंव!’</para>
  <para style="q1" vid="JER 22:21">तोर जवानी के समय ले तोर चालचलन अइसनेच हवय;</para>
  <para style="q2" vid="JER 22:21">तेंह मोर बात नइं माने हस।<verse eid="JER 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 22:22" />हवा ह तोर जम्मो चरवाहामन ला उड़ाके ले जाही,</para>
  <para style="q2" vid="JER 22:22">अऊ तोर संगीमन बंधुवई म चल दीहीं।</para>
  <para style="q1" vid="JER 22:22">तब तेंह अपन जम्मो दुस्ट काम के कारन</para>
  <para style="q2" vid="JER 22:22">लज्जित अऊ अपमानित होबे।<verse eid="JER 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 22:23" />तें, जऊन ह लबानोन<note caller="+" style="f"><char style="fr" closed="false">22:23 </char><char style="ft" closed="false">यरूसलेम के महल (see <char style="xt"><ref loc="1KI 7:2">1 राजा 7:2</ref></char>)</char></note> म रहिथस,</para>
  <para style="q2" vid="JER 22:23">जेमन देवदार के भवनमन म रहिथव,</para>
  <para style="q1" vid="JER 22:23">जब तोर ऊपर दुख आही,</para>
  <para style="q2" vid="JER 22:23">लइका जनमे के सहीं पीरा होही, त तेंह कइसने कराहबे!”<verse eid="JER 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 22:24" />यहोवा ह ये घोसना करत हे, “मोर जिनगी के कसम, हे यहूदा के राजा, यहोयाकीम के बेटा यहोयाकीन! चाहे यदि तेंह मोर जेवनी हांथ के मुहरवाला मुंदरी घलो होते, तभो ले मेंह तोला उतारके फटिक देतेंव। <verse eid="JER 22:24" /><verse number="25" style="v" sid="JER 22:25" />जऊन मन तोला मार डारे चाहत हें, मेंह तोला ओमन के हांथ म कर दूहूं, जेमन ले तेंह डरथस—याने कि बेबिलोन के राजा नबूकदनेसर अऊ बेबिलोन के रहइयामन के हांथ म कर दूहूं। <verse eid="JER 22:25" /><verse number="26" style="v" sid="JER 22:26" />मेंह तोला अऊ तोला जनम देवइया दाई ला एक आने देस म फटिक दूहूं, जिहां न तो तें जनमे रहय अऊ न ही तोर दाई, अऊ उहां तुमन दूनों मर जाहू। <verse eid="JER 22:26" /><verse number="27" style="v" sid="JER 22:27" />जऊन देस म तुमन लहुंटे के ईछा करत हव, ओ देस म तुमन कभू लहुंटे नइं पाहू।”<verse eid="JER 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 22:28" />का ये मनखे यहोयाकीन ह एक तुछ, टूटहा बरतन अय,</para>
  <para style="q2" vid="JER 22:28">एक अइसने चीज, जेला कोनो पसंद नइं करंय?</para>
  <para style="q1" vid="JER 22:28">ओ अऊ ओकर लइकामन, काबर एक अइसने देस म</para>
  <para style="q2" vid="JER 22:28">फटिक दिये जाहीं, जेला ओमन नइं जानंय?<verse eid="JER 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 22:29" />हे देस के मनखे, देस के मनखे, देस के मनखे,</para>
  <para style="q2" vid="JER 22:29">यहोवा के बचन ला सुनव!<verse eid="JER 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 22:30" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 22:30">“ये मनखे ला एक निरबंस के रूप म लिखव,</para>
  <para style="q2" vid="JER 22:30">एक अइसने मनखे, जऊन ह अपन जिनगी भर उन्नति नइं करही,</para>
  <para style="q1" vid="JER 22:30">काबरकि ओकर कोनो भी संतान उन्नति नइं करहीं,</para>
  <para style="q2" vid="JER 22:30">ओकर कोनो भी संतान दाऊद के सिंघासन म नइं बईठहीं</para>
  <para style="q2" vid="JER 22:30">या कभू यहूदा म राज नइं करहीं।”<verse eid="JER 22:30" /></para>
  <chapter eid="JER 22" />
  <chapter number="23" style="c" sid="JER 23" />
  <para style="s1">धरमी डंगाली</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 23:1" />“ओ चरवाहामन<note caller="+" style="f"><char style="fr" closed="false">23:1 </char><char style="ft" closed="false">संभवतः इसरायल के अगुवामन</char></note> ऊपर हाय, जऊन मन मोर चराई के भेड़मन ला नास करत हें अऊ तितिर-बितिर करत हें!” यहोवा ह ये घोसना करत हे। <verse eid="JER 23:1" /><verse number="2" style="v" sid="JER 23:2" />एकरसेति यहोवा, इसरायल के परमेसर ह मोर मनखेमन के देखरेख करइया चरवाहामन ला ये कहत हे: “तुमन मोर झुंड ला तितिर-बितिर कर दे हव अऊ ओमन ला भगा दे हव अऊ ओमन के देखरेख नइं करे हव, एकरसेति तुम्हर दुस्ट काम के कारन, मेंह तुमन ला सजा दूहूं,” यहोवा ह ये घोसना करत हे। <verse eid="JER 23:2" /><verse number="3" style="v" sid="JER 23:3" />“ओ जम्मो देस, जिहां मेंह अपन झुंड ला भगा दे रहेंव, ओ देसमन ले मेंह खुद ओमन के बांचे भाग ला इकट्ठा करहूं अऊ ओमन ला ओमन के चराई म वापिस लानहूं, जिहां ओमन फूलहीं-फरहीं अऊ गनती म बढ़हीं। <verse eid="JER 23:3" /><verse number="4" style="v" sid="JER 23:4" />मेंह ओमन बर चरवाहामन ला ठहिराहूं, जेमन ओमन के देखरेख करहीं अऊ ओमन न तो फेर डरहीं या भय खाहीं अऊ न ही ओमा ले कोनो गंवाही,” यहोवा ह ये घोसना करत हे।<verse eid="JER 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 23:5" />“ओ दिनमन आवत हें,” यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="JER 23:5">“जब मेंह दाऊद बर एक धरमी मनखे ला बढ़ाहूं,</para>
  <para style="q1" vid="JER 23:5">ओह एक राजा होही, जऊन ह बुद्धिमानी से राज करही</para>
  <para style="q2" vid="JER 23:5">अऊ देस म नियाय अऊ धरम के काम ला करही।<verse eid="JER 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 23:6" />ओकर दिनमन म यहूदा के मनखेमन ला बंचाय जाही</para>
  <para style="q2" vid="JER 23:6">अऊ इसरायली मनखेमन सुरकछित बसे रहिहीं।</para>
  <para style="q1" vid="JER 23:6">ओला ये नांव के दुवारा पुकारे जाही:</para>
  <para style="q2" vid="JER 23:6">यहोवा हमर धरमी उद्धारकर्ता।<verse eid="JER 23:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="JER 23:7" />“एकरसेति देखव, ओ दिनमन आवत हें,” यहोवा ह घोसना करत हे, “जब मनखेमन फेर नइं कहिहीं, ‘यहोवा के जिनगी के कसम, जऊन ह इसरायलीमन ला मिसर देस ले निकाल लानिस,’ <verse eid="JER 23:7" /><verse number="8" style="v" sid="JER 23:8" />पर ओमन ये कहिहीं, ‘यहोवा के जिनगी के कसम, जऊन ह उत्तर के देस ले अऊ ओ जम्मो देस ले इसरायल के संतानमन ला ले आईस, जिहां ओमन ला भगा दे रिहिस।’ तब ओमन अपन खुद के देस म रहिहीं।”<verse eid="JER 23:8" /></para>
  <para style="s1">लबरा अगमजानीमन</para>
  <para style="p">
    <verse number="9" style="v" sid="JER 23:9" />अगमजानीमन के बारे म:</para>
  <para style="q1" vid="JER 23:9">मोर हिरदय ह मोर भीतरे-भीतर टूटत हे;</para>
  <para style="q2" vid="JER 23:9">मोर जम्मो हाड़ामन कांपत हें।</para>
  <para style="q1" vid="JER 23:9">मेंह एक मतवार मनखे सहीं अंव,</para>
  <para style="q2" vid="JER 23:9">एक बलवान मनखे सहीं, जेकर ऊपर मंद के नसा छा गे हवय।</para>
  <para style="q1" vid="JER 23:9">एकर कारन ए यहोवा</para>
  <para style="q2" vid="JER 23:9">अऊ ओकर पबितर बचन।<verse eid="JER 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 23:10" />ये देस ह बेभिचारीमन ले भरे हवय;</para>
  <para style="q2" vid="JER 23:10">सराप पड़े के कारन,<note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ये चीजमन के कारन</char></note> ये देस ह सूखा पड़े हे</para>
  <para style="q2" vid="JER 23:10">अऊ सुन्ना जगह के चराईमन सूख गे हवंय।</para>
  <para style="q1" vid="JER 23:10">अगमजानीमन दुस्टता के जिनगी जीयथें</para>
  <para style="q2" vid="JER 23:10">अऊ अपन ताकत के उपयोग अनियाय के काम म करत हें।<verse eid="JER 23:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 23:11" />“अगमजानी अऊ पुरोहित दूनों परमेसर ला छोंड़ दे हवंय;</para>
  <para style="q2" vid="JER 23:11">अऊ त अऊ मेंह अपन मंदिर म ओमन के दुस्टता ला देखथंव,”</para>
  <para style="q2" vid="JER 23:11">यहोवा ह घोसना करत हे।<verse eid="JER 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 23:12" />“ये खातिर ओमन के रसता म फिसलन होही;</para>
  <para style="q2" vid="JER 23:12">ओमन ला अंधियार म डाल दिये जाही</para>
  <para style="q2" vid="JER 23:12">अऊ उहां ओमन गिरहीं।</para>
  <para style="q1" vid="JER 23:12">जऊन बछर ओमन ला सजा दिये जाही</para>
  <para style="q2" vid="JER 23:12">ओ बछर, मेंह ओमन ऊपर बिपत्ति लानहूं,”</para>
  <para style="q2" vid="JER 23:12">यहोवा ह घोसना करत हे।<verse eid="JER 23:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 23:13" />“सामरिया के अगमजानीमन के बीच म</para>
  <para style="q2" vid="JER 23:13">मेंह ये खराप चीज देखेंव:</para>
  <para style="q1" vid="JER 23:13">ओमन बाल देवता के नांव म अगमबानी करिन</para>
  <para style="q2" vid="JER 23:13">अऊ मोर इसरायली मनखेमन ला डहार ले भटका दीन।<verse eid="JER 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 23:14" />अऊ यरूसलेम के अगमजानीमन के बीच म</para>
  <para style="q2" vid="JER 23:14">मेंह कुछू भयंकर चीज देखे हंव:</para>
  <para style="q2" vid="JER 23:14">ओमन बेभिचार करथें अऊ पाखंडी जिनगी जीथें।</para>
  <para style="q1" vid="JER 23:14">ओमन दुस्टमन के हांथ ला मजबूत करथें,</para>
  <para style="q2" vid="JER 23:14">जेकर कारन ओमा के एको जन भी अपन दुस्टता ला नइं छोंड़य।</para>
  <para style="q1" vid="JER 23:14">ओमन मोर बर सदोम के मनखे सहीं अंय;</para>
  <para style="q2" vid="JER 23:14">अऊ यरूसलेम के मनखेमन अमोरा के मनखेमन सहीं अंय।”<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">(देखव <char style="xt"><ref loc="GEN 19:24-25">उत 19:24‑25</ref></char>)</char></note><verse eid="JER 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 23:15" />ये खातिर सर्वसक्तिमान यहोवा ह अगमजानीमन के बारे म ये कहत हे:</para>
  <para style="q1" vid="JER 23:15">“मेंह ओमन ला करू जेवन खवाहूं</para>
  <para style="q2" vid="JER 23:15">अऊ जहरवाला पानी पीयाहूं,</para>
  <para style="q1" vid="JER 23:15">काबरकि यरूसलेम के अगमजानीमन ले</para>
  <para style="q2" vid="JER 23:15">अभक्ति ह जम्मो देस म फईल गे हवय।”<verse eid="JER 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 23:16" />सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 23:16">“अगमजानीमन तुमन ले जऊन अगमबानी करत हें, ओला झन सुनव;</para>
  <para style="q2" vid="JER 23:16">ओमन तुमन ला लबारी के बात ले भर दीहीं।</para>
  <para style="q1" vid="JER 23:16">ओमन यहोवा के मुहूं ले नइं,</para>
  <para style="q2" vid="JER 23:16">पर अपन ही मन से दरसन के बात ला गोठियाथें।<verse eid="JER 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 23:17" />जऊन मनखेमन मोला तुछ समझथें, ओमन ला येमन कहत रहिथें,</para>
  <para style="q2" vid="JER 23:17">‘यहोवा ह कहत हे: तुमन ला सांति मिलही।’</para>
  <para style="q1" vid="JER 23:17">अऊ ओ जम्मो, जऊन मन अपन हठी मन के मुताबिक चलथें</para>
  <para style="q2" vid="JER 23:17">ओमन ला येमन कहिथें, ‘तुम्हर कोनो हानि नइं होवय।’<verse eid="JER 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 23:18" />पर येमा के कोन ह यहोवा के बचन ला देखे या सुने बर</para>
  <para style="q2" vid="JER 23:18">ओकर सभा म ठाढ़ होय हवय?</para>
  <para style="q2" vid="JER 23:18">कोन ह ओकर बचन ला सुने अऊ धियान दे हवय?<verse eid="JER 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 23:19" />देखव, यहोवा के आंधी ह</para>
  <para style="q2" vid="JER 23:19">कोरोध म फट जाही,</para>
  <para style="q1" vid="JER 23:19">एक बवंडर ह दुस्टमन के मुड़ ऊपर</para>
  <para style="q2" vid="JER 23:19">घुमत आवत हे।<verse eid="JER 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 23:20" />जब तक यहोवा ह</para>
  <para style="q2" vid="JER 23:20">अपन हिरदय के उदेस्य ला पूरा नइं कर लीही,</para>
  <para style="q2" vid="JER 23:20">तब तक ओकर गुस्सा ह सांत नइं होवय।</para>
  <para style="q1" vid="JER 23:20">अवइया दिनमन म</para>
  <para style="q2" vid="JER 23:20">तेंह ये बात ला साफ-साफ समझबे।<verse eid="JER 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 23:21" />मेंह ये अगमजानीमन ला नइं पठोय हंव,</para>
  <para style="q2" vid="JER 23:21">तभो ले ओमन अपन संदेस बताय बर दऊड़त गे हवंय;</para>
  <para style="q1" vid="JER 23:21">मेंह ओमन ले नइं गोठियाय हंव,</para>
  <para style="q2" vid="JER 23:21">तभो ले ओमन अगमबानी करे हवंय।<verse eid="JER 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 23:22" />पर यदि ओमन मोर सिकछा म चले होतिन,</para>
  <para style="q2" vid="JER 23:22">त ओमन मोर मनखेमन ला मोर बचन सुनाय रहितिन</para>
  <para style="q1" vid="JER 23:22">अऊ मोर मनखेमन ला ओमन के खराप चालचलन</para>
  <para style="q2" vid="JER 23:22">अऊ ओमन के दुस्ट काममन ले बंचा ले होतिन।<verse eid="JER 23:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JER 23:23" />“का मेंह सिरिप लकठा रहे म ही परमेसर अंव,”</para>
  <para style="q2" vid="JER 23:23">यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="JER 23:23">“अऊ दूरिहा रहे म परमेसर नो हंव?<verse eid="JER 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 23:24" />गुपत जगह म कोन ह छुप सकथे</para>
  <para style="q2" vid="JER 23:24">कि मेंह ओला नइं देख सकंव?”</para>
  <para style="q2" vid="JER 23:24">यहोवा ह ये घोसना करत हे।</para>
  <para style="q1" vid="JER 23:24">“का मेंह स्वरग अऊ धरती ला भरा-पूरा नइं रखंव?”</para>
  <para style="q2" vid="JER 23:24">यहोवा ह घोसना करत हे।<verse eid="JER 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 23:25" />“मेंह अगमजानीमन के गोठ ला सुने हंव, जऊन मन मोर नांव म ये कहिके लबारी अगमबानी करथें, ‘मेंह एक सपना देखे हंव! मेंह एक सपना देखे हंव!’ <verse eid="JER 23:25" /><verse number="26" style="v" sid="JER 23:26" />ये लबरा अगमजानीमन अपन ही मन के भरम ला अगमबानी करके कहिथें; येमन के मन म येह कब तक चलत रहिही? <verse eid="JER 23:26" /><verse number="27" style="v" sid="JER 23:27" />ओमन सोचथें कि ओमन जऊन सपना के बात एक-दूसर ला बताथें, ओला सुनके मोर मनखेमन मोर नांव ला भुला जाहीं, जइसने कि ओमन के पुरखामन बाल देवता के अराधना करके मोर नांव ला भुला गे रिहिन। <verse eid="JER 23:27" /><verse number="28" style="v" sid="JER 23:28" />जऊन अगमजानी ह सपना देखे हवय, ओह अपन सपना ला बतावय, पर जेकर करा मोर बचन हवय, ओह ओ बचन ला ईमानदारी से सुनावय। काबरकि भूंसा अऊ अनाज के दाना के का मेल?” यहोवा ह ये घोसना करत हे। <verse eid="JER 23:28" /><verse number="29" style="v" sid="JER 23:29" />“का मोर बचन ह आगी सहीं नो हय,” यहोवा ह घोसना करत हे, “अऊ का ओह हथौड़ा सहीं नो हय, जऊन ह चट्टान ला कुटा-कुटा कर देथे?<verse eid="JER 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 23:30" />“एकरसेति” यहोवा ह घोसना करत हे, “मेंह ओ अगमजानीमन के बिरूध हंव, जऊन मन मोर बचन समझके एक-दूसर के बचन ला चोरा लेथें।” <verse eid="JER 23:30" /><verse number="31" style="v" sid="JER 23:31" />यहोवा ह घोसना करत हे, “हव, मेंह ओ अगमजानीमन के बिरूध हंव, जऊन मन अपन खुद के बात कहिथें अऊ तभो ले ये बताथें, ‘यहोवा ह घोसना करत हे।’ <verse eid="JER 23:31" /><verse number="32" style="v" sid="JER 23:32" />सच म, मेंह ओमन के बिरूध हंव, जऊन मन झूठा सपना के अगमबानी करथें,” यहोवा ह ये घोसना करत हे। “मेंह ओमन ला न तो पठोय हंव अऊ न ही ठहिराय हंव, तभो ले ओमन मोर मनखेमन के आघू म अगमबानी करथें अऊ बेकार के अपन लबारी बात ले मोर मनखेमन ला भरमाथें। ओमन ले मोर मनखेमन ला कोनो फायदा नइं होवय,” यहोवा ह घोसना करत हे।<verse eid="JER 23:32" /></para>
  <para style="s1">लबरा अगमबानी</para>
  <para style="p">
    <verse number="33" style="v" sid="JER 23:33" />“जब ये मनखे, या कोनो अगमजानी या कोनो पुरोहित तुम्हर ले पुछथे, ‘यहोवा ले का संदेस मिले हवय?’ त ओमन ला कह, ‘का संदेस?’ यहोवा ह ये घोसना करत हे, ‘मेंह तुमन ला तियाग दूहूं।’ <verse eid="JER 23:33" /><verse number="34" style="v" sid="JER 23:34" />यदि कोनो अगमजानी या कोनो पुरोहित या कोनो अऊ दावा करथे, ‘यहोवा ले ये संदेस आय हवय,’ त मेंह ओमन ला अऊ ओमन के घराना ला सजा दूहूं। <verse eid="JER 23:34" /><verse number="35" style="v" sid="JER 23:35" />तुमन ले हर एक जन अपन संगी अऊ आने इसरायलीमन ले ये बात कहिते रहिथे: ‘यहोवा ह का जबाब दे हवय?’ या ‘यहोवा ह का कहे हवय?’ <verse eid="JER 23:35" /><verse number="36" style="v" sid="JER 23:36" />पर तुमन ये झन कहव ‘यहोवा करा ले आय एक संदेस,’ काबरकि हर एक के बचन ह ओकर खुद के संदेस होथे। ये किसम ले तुमन जीयत परमेसर, यहोवा, हमर सर्वसक्तिमान परमेसर के बचन ला तोड़-मरोड़ के कहिथव। <verse eid="JER 23:36" /><verse number="37" style="v" sid="JER 23:37" />तुमन अगमजानी ले अइसने पुछत रहव: ‘यहोवा ह तोला का जबाब दे हवय?’ या ‘यहोवा ह का कहे हवय?’ <verse eid="JER 23:37" /><verse number="38" style="v" sid="JER 23:38" />हालाकि तुमन दावा करथव, ‘यहोवा ले ये संदेस आय हवय,’ यहोवा ह ये कहत हे: तुमन ये बचनमन के उपयोग करेव, ‘यहोवा ले ये संदेस आय हवय,’ हालाकि मेंह तुमन ला कहे हंव कि तुमन अइसने दावा झन करव, ‘यहोवा ले ये संदेस आय हवय।’ <verse eid="JER 23:38" /><verse number="39" style="v" sid="JER 23:39" />एकरसेति, मेंह ये सहर सहित तुमन ला बिलकुल ही भुला जाहूं अऊ अपन आघू ले निकाल दूहूं, जेला कि मेंह तुमन अऊ तुम्हर पुरखामन ला देय हंव। <verse eid="JER 23:39" /><verse number="40" style="v" sid="JER 23:40" />मेंह तुम्हर ऊपर कभू खतम न होनेवाला कलंक लानहूं—कभू खतम न होनेवाला लज्जा, जेला कभू भुलाय नइं जाही।”<verse eid="JER 23:40" /></para>
  <chapter eid="JER 23" />
  <chapter number="24" style="c" sid="JER 24" />
  <para style="s1">अंजीर फर के दू ठन टुकना</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 24:1" />जब बेबिलोन के राजा नबूकदनेसर ह यहोयाकीम के बेटा, यहूदा के राजा यहोयाकीन<note caller="+" style="f"><char style="fr" closed="false">24:1 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">यकुन्याह, </char><char style="ft" closed="false">जऊन ह </char><char style="fq" closed="false">यहोयाकीन </char><char style="ft" closed="false">के एक आने नांव ए</char></note> ला अऊ यहूदा के करमचारी, कुसल बनिहार अऊ कारीगरमन ला यरूसलेम ले बेबिलोन बंधुवई म ले गीस, त ओकर बाद यहोवा ह मोला ओकर मंदिर के आघू म रखे अंजीर फर ले भरे दू ठन टुकना देखाईस। <verse eid="JER 24:1" /><verse number="2" style="v" sid="JER 24:2" />एक टुकना म तो पहिले से पके बने अंजीर रहय; पर दूसर टुकना म बहुंत खराप अंजीर रहय, अतेक खराप कि ओमन खाय के लईक नइं रिहिन।<verse eid="JER 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 24:3" />तब यहोवा ह मोर ले पुछिस, “हे यरमियाह, तोला का दिखत हे?”</para>
  <para style="p" vid="JER 24:3">मेंह जबाब देंव, “अंजीर, बने अंजीरमन बहुंत बढ़िया हवंय, पर खराप अंजीरमन अतेक खराप कि ओमन ला खाय नइं जा सकय।”<verse eid="JER 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 24:4" />तब यहोवा के ये बचन मोर करा आईस: <verse eid="JER 24:4" /><verse number="5" style="v" sid="JER 24:5" />“यहोवा, इसरायल के परमेसर ह ये कहत हे: ‘ये बने अंजीरमन सहीं, मेंह यहूदा ले बंधुवई म गय ओ मनखेमन ला बने समझथंव, जेमन ला मेंह ये जगह ले बेबिलोन देस पठोय हंव। <verse eid="JER 24:5" /><verse number="6" style="v" sid="JER 24:6" />मेंह देखहूं कि ओमन के भलई होवय, अऊ ओमन ला ये देस म वापिस ले आहूं। मेंह ओमन ला बढ़ाहूं अऊ ओमन ला नास नइं करहूं; मेंह ओमन ला लगाहूं अऊ ओमन ला नइं उखानहूं। <verse eid="JER 24:6" /><verse number="7" style="v" sid="JER 24:7" />मेंह ओमन के मन ला अइसने कर दूहूं कि ओमन मोला जानहीं कि मेंह यहोवा अंव। ओमन मोर मनखे होहीं अऊ मेंह ओमन के परमेसर होहूं, काबरकि ओमन मोर करा अपन पूरा मन ले लहुंटहीं।<verse eid="JER 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 24:8" />“ ‘पर यहोवा ह कहत हे, ओ खराप अंजीरमन सहीं, जेमन अतेक खराप हवंय कि खाय नइं जा सकंय, मेंह यहूदा के राजा सिदकियाह, ओकर करमचारी अऊ यरूसलेम के बांचे मनखेमन ले बरताव करहूं, चाहे ओमन ये देस म रहंय या मिसर देस म रहंय। <verse eid="JER 24:8" /><verse number="9" style="v" sid="JER 24:9" />जिहां भी मेंह ओमन ला भगाहूं, उहां ओमन ला घिनित अऊ धरती के जम्मो राज बर अप्रिय, एक अपमान अऊ एक कहावत, एक सराप अऊ हंसी के एक चीज बना दूहूं। <verse eid="JER 24:9" /><verse number="10" style="v" sid="JER 24:10" />जऊन देस मेंह ओमन ला अऊ ओमन के पुरखामन ला देय हंव, जब तक ओमन ओ देस ले नास नइं हो जाहीं, तब तक मेंह ओमन के बिरूध तलवार चलाहूं, अऊ ओमन ऊपर अकाल अऊ महामारी लानहूं।’ ”<verse eid="JER 24:10" /></para>
  <chapter eid="JER 24" />
  <chapter number="25" style="c" sid="JER 25" />
  <para style="s1">सत्तर साल के बंधुवई</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 25:1" />योसियाह के बेटा यहूदा के राजा यहोयाकीम के राज के चौथा साल म, जऊन ह बेबिलोन के राजा नबूकदनेसर के राज के पहिला साल रिहिस, यहोवा के जऊन बचन यरमियाह अगमजानी करा आईस, <verse eid="JER 25:1" /><verse number="2" style="v" sid="JER 25:2" />ओला यरमियाह अगमजानी ह यहूदा के जम्मो मनखे अऊ यरूसलेम म रहइया जम्मो मनखे ला बताईस: <verse eid="JER 25:2" /><verse number="3" style="v" sid="JER 25:3" />आमोन के बेटा यहूदा के राजा योसियाह के राज के तेरहवां साल ले लेके आज तक—याने कि तेईस साल ले यहोवा के बचन ह मोर करा आय हवय अऊ मेंह ओ बचन तुमन ला बार-बार बताय हंव, पर तुमन नइं सुनेव।<verse eid="JER 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 25:4" />अऊ हालाकि यहोवा ह तुम्हर करा अपन जम्मो सेवक अगमजानीमन ला बार-बार पठोय हवय, पर तुमन ओमन के नइं सुनेव या कोनो धियान नइं दे हव। <verse eid="JER 25:4" /><verse number="5" style="v" sid="JER 25:5" />ओमन कहिन, “तुमन ले हर एक जन अपन खराप चालचलन अऊ अपन दुस्ट काममन ला छोंड़व, तब तुमन ये देस म रह सकत हव, जेला कि यहोवा ह तुमन ला अऊ तुम्हर पुरखामन ला सदाकाल बर देय हवय। <verse eid="JER 25:5" /><verse number="6" style="v" sid="JER 25:6" />आने देवतामन के सेवा अऊ अराधना करे बर ओमन के पाछू झन जावव; अऊ अपन हांथ के बनाय चीजमन के दुवारा मोर गुस्सा ला झन भड़कावव। तब मेंह तुम्हर कुछू हानि नइं करहूं।”<verse eid="JER 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 25:7" />यहोवा ह घोसना करत हे, “पर तुमन मोर बात ला नइं सुनेव, अऊ अपन हांथ के बनाय चीजमन के दुवारा मोर गुस्सा ला भड़काय हव, अऊ तुमन अपन हानि करे हव।”<verse eid="JER 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 25:8" />एकरसेति सर्वसक्तिमान यहोवा ह ये कहत हे: “काबरकि तुमन मोर बचन ला नइं सुनेव, <verse eid="JER 25:8" /><verse number="9" style="v" sid="JER 25:9" />मेंह उत्तर दिग के जम्मो मनखे अऊ अपन सेवक बेबिलोन के राजा नबूकदनेसर ला बुलवाहूं,” यहोवा ह घोसना करत हे, “अऊ मेंह ओमन ला ये देस अऊ येमा रहइया मनखे अऊ येकर आसपास के जम्मो जाति के मनखेमन के बिरूध म लानहूं। मेंह ओमन के सतियानास करके ओमन ला आतंक अऊ हंसी के चीज बना दूहूं, अऊ सदाकाल बर उजाड़ दूहूं। <verse eid="JER 25:9" /><verse number="10" style="v" sid="JER 25:10" />मेंह ओमन के खुसी अऊ आनंद के अवाज, दूल्हा अऊ दुलहिन के अवाज, चक्की के अवाज ला छीन लूहूं अऊ ओमन के दीया के अंजोर ला घलो छीन लूहूं। <verse eid="JER 25:10" /><verse number="11" style="v" sid="JER 25:11" />ये जम्मो देस उजाड़ अऊ बेकार हो जाही, अऊ ये जाति के मनखे अऊ आसपास के जाति के मनखेमन सत्तर साल तक बेबिलोन के राजा के सेवा करहीं।<verse eid="JER 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 25:12" />“पर जब सत्तर साल पूरा हो जाही, तब मेंह बेबिलोन के राजा अऊ ओकर देस अऊ उहां रहइया मनखेमन ला ओमन के अपराध के सजा दूहूं,” यहोवा ह घोसना करत हे, “अऊ ओ देस ला सदाकाल बर उजाड़ दूहूं। <verse eid="JER 25:12" /><verse number="13" style="v" sid="JER 25:13" />मेंह ओ देस ऊपर ओ जम्मो चीज ला लानहूं, जेला मेंह ओकर बिरूध म कहे हवंव, ओ जम्मो बात, जऊन ह ये किताब म लिखे हवय अऊ यरमियाह के दुवारा जम्मो जातिमन के बिरूध अगमबानी करे गे हवय। <verse eid="JER 25:13" /><verse number="14" style="v" sid="JER 25:14" />बेबिलोनीमन खुद कतको जाति के मनखे अऊ बड़े राजामन के गुलामी करहीं; मेंह ओमन के बरताव अऊ ओमन के हांथ के काम के मुताबिक ओमन ले बदला लूहूं।”<verse eid="JER 25:14" /></para>
  <para style="s1">परमेसर के कोरोध के कटोरा</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 25:15" />यहोवा, इसरायल के परमेसर ह मोर ले ये कहिस: “मोर कोरोध के मंद ले भरे ये कटोरा ला मोर हांथ ले लेय ले अऊ ओ जम्मो जाति के मनखेमन ला येला पीया, जेमन करा मेंह तोला पठोवत हंव। <verse eid="JER 25:15" /><verse number="16" style="v" sid="JER 25:16" />जब ओमन ओला पीहीं, त ओ तलवार के कारन, जेला मेंह ओमन के बीच म पठोहूं, ओमन लड़खड़ाहीं अऊ पागल हो जाहीं।” <verse eid="JER 25:16" /><verse number="17" style="v" sid="JER 25:17" />एकरसेति मेंह यहोवा के हांथ ले ओ कटोरा ला लेंव अऊ जम्मो जाति के मनखेमन ला पीया देंव, जेमन करा यहोवा ह मोला पठोईस:<verse eid="JER 25:17" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="18" style="v" sid="JER 25:18" />यरूसलेम अऊ यहूदा के नगरमन ला, येकर राजामन अऊ अधिकारीमन ला पीयांय, ताकि ओमन उजड़ जावंय अऊ ओमन आतंक अऊ हंसी के चीज बन जावंय, अऊ ओमन सरापित हो जावंय—जइसने कि ओमन आज तक हवंय;<verse eid="JER 25:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="JER 25:19" />फिरौन मिसर देस के राजा, ओकर सेवक, ओकर अधिकारी अऊ ओकर जम्मो मनखेमन, <verse eid="JER 25:19" /><verse number="20" style="v" sid="JER 25:20" />अऊ उहां के जम्मो परदेसी मनखेमन ला;</para>
  <para style="li1" vid="JER 25:20">ऊज देस के जम्मो राजामन ला;</para>
  <para style="li1" vid="JER 25:20">पलिस्तीमन के जम्मो राजामन ला (अस्कलोन, गाजा, एकरोन के राजामन अऊ असदोद म बचे मनखेमन);<verse eid="JER 25:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="JER 25:21" />एदोमी, मोआबी अऊ अमोनीमन ला;<verse eid="JER 25:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="JER 25:22" />सूर अऊ सीदोन के जम्मो राजामन ला;</para>
  <para style="li1" vid="JER 25:22">समुंदर के पार समुंदर तीर के राजामन ला;<verse eid="JER 25:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="JER 25:23" />ददानी, तेमाई, बूजीमन अऊ ओ जम्मो ला, जऊन मन दूरिहा जगह म रिहिन<note caller="+" style="f"><char style="fr" closed="false">25:23 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">जऊन मन अपन माथा के बाल ला कतर लेथें</char></note>;<verse eid="JER 25:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="JER 25:24" />अरब के जम्मो राजामन अऊ सुन्ना जगह म रहइया परदेसी मनखेमन के जम्मो राजामन ला;<verse eid="JER 25:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="JER 25:25" />जिमरी, एलाम अऊ मादै के जम्मो राजामन ला;<verse eid="JER 25:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="JER 25:26" />अऊ उत्तर दिग के जम्मो राजामन ला, का लकठा अऊ का दूरिहा, एक के बाद एक—धरती के ऊपर जम्मो राज के मनखेमन ला पीया देंव।</para>
  <para style="li1" vid="JER 25:26">अऊ ये जम्मो के बाद, सेसक के राजा घलो येला पीही।<verse eid="JER 25:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="JER 25:27" />“तब ओमन ला कह, ‘सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: पीयव, मतवार हो जावव अऊ उछर डारव, अऊ अइसने गिरव कि फेर कभू झन उठव, काबरकि मेंह तुम्हर बीच म तलवार चलाहूं।’ <verse eid="JER 25:27" /><verse number="28" style="v" sid="JER 25:28" />पर यदि ओमन तोर हांथ ले ये कटोरा लेके पीये ले इनकार करहीं, त ओमन ला कह, ‘सर्वसक्तिमान यहोवा ह ये कहत हे: तुमन ला पीना जरूरी अय! <verse eid="JER 25:28" /><verse number="29" style="v" sid="JER 25:29" />देखव, जऊन सहर<note caller="+" style="f"><char style="fr" closed="false">25:29 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरूसलेम</char></note> ह मोर नांव ले जाने जाथे, ओ सहर म, मेंह बिपत्ति लाने के सुरू करत हंव, त का तुमन सचमुच सजा ले बच जाहू? तुमन सजा ले नइं बचव, काबरकि मेंह धरती म रहइया जम्मो के ऊपर तलवार चलानेवाला हंव, सर्वसक्तिमान यहोवा ह घोसना करत हे।’<verse eid="JER 25:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 25:30" />“अब ये जम्मो बात के अगमबानी ओमन के बिरूध म कर अऊ ओमन ला कह:</para>
  <para style="q1" vid="JER 25:30">“ ‘यहोवा ह ऊंच जगह ले गरजही;</para>
  <para style="q2" vid="JER 25:30">ओह अपन पबितर निवास ले अपन बात ला कहिही</para>
  <para style="q2" vid="JER 25:30">अऊ अपन भुइयां के बिरूध जोर से गरजही।</para>
  <para style="q1" vid="JER 25:30">ओह ओमन सहीं चिचियाही, जेमन अंगूर ला गोड़ ले रऊंदथें,</para>
  <para style="q2" vid="JER 25:30">ओह धरती ऊपर रहइया जम्मो मनखेमन के बिरूध चिचियाही।<verse eid="JER 25:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 25:31" />कोलाहल के अवाज धरती के छोर तक सुनई दीही,</para>
  <para style="q2" vid="JER 25:31">काबरकि यहोवा ह जम्मो जाति के मनखेमन के बिरूध दोस लगाही;</para>
  <para style="q1" vid="JER 25:31">ओह जम्मो मनखेमन के नियाय करही</para>
  <para style="q2" vid="JER 25:31">अऊ दुस्ट मनखेमन ला तलवार ले मारही।’ ”</para>
  <para style="q2" vid="JER 25:31">यहोवा ह घोसना करत हे।<verse eid="JER 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 25:32" />सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 25:32">“देखव! बिपत्ति ह</para>
  <para style="q2" vid="JER 25:32">एक जात ले दूसर जात म फईलत हे;</para>
  <para style="q1" vid="JER 25:32">एक भयंकर तूफान ह</para>
  <para style="q2" vid="JER 25:32">धरती के छोर ले उठत हे।”<verse eid="JER 25:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="JER 25:33" />ओ बेरा, हर एक जगह म मनखेमन यहोवा के दुवारा मारे जाहीं—धरती के एक छोर ले लेके दूसर छोर तक। ओमन बर कोनो बिलाप नइं करहीं, अऊ न ही ओमन के लास ला संकेले जाही अऊ न ही माटी दिये जाही, पर ओमन के लासमन भुइयां म खातू सहीं पड़े रहिहीं।<verse eid="JER 25:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 25:34" />हे चरवाहामन, रोवव अऊ बिलाप करव;</para>
  <para style="q2" vid="JER 25:34">हे झुंड के अगुवामन, धुर्रा म लोटव।</para>
  <para style="q1" vid="JER 25:34">काबरकि तुम्हर कतल होय के बेरा ह आ गे हवय;</para>
  <para style="q2" vid="JER 25:34">जइसने सुघर बरतनमन गिरके टूट जाथें, वइसने तुमन गिरके टूट जाहू।<verse eid="JER 25:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 25:35" />चरवाहामन ला भागे के कोनो जगह नइं मिलही,</para>
  <para style="q2" vid="JER 25:35">झुंड के अगुवामन बर बचके जाय बर कोनो जगह नइं होही।<verse eid="JER 25:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 25:36" />चरवाहामन के रोवई,</para>
  <para style="q2" vid="JER 25:36">अऊ झुंड के अगुवामन के बिलाप करई ला सुनव,</para>
  <para style="q2" vid="JER 25:36">काबरकि यहोवा ह ओमन के चराई के जगह ला नास करत हे।<verse eid="JER 25:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 25:37" />यहोवा के भयंकर कोरोध के कारन</para>
  <para style="q2" vid="JER 25:37">सांत चराई के जगह ह बेकार हो जाही।<verse eid="JER 25:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 25:38" />एक सेर के सहीं यहोवा ह अपन मांद ला छोंड़ दीही,</para>
  <para style="q2" vid="JER 25:38">अतियाचार करइया के तलवार के कारन</para>
  <para style="q1" vid="JER 25:38">अऊ यहोवा के भयंकर कोरोध के कारन</para>
  <para style="q2" vid="JER 25:38">ओमन के देस ह उजड़ जाही।<verse eid="JER 25:38" /></para>
  <chapter eid="JER 25" />
  <chapter number="26" style="c" sid="JER 26" />
  <para style="s1">यरमियाह ला मार डारे के धमकी मिलथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 26:1" />योसियाह के बेटा यहूदा के राजा यहोयाकीम के राज के सुरू म, यहोवा ले ये बचन आईस: <verse eid="JER 26:1" /><verse number="2" style="v" sid="JER 26:2" />“यहोवा ह ये कहत हे: यहोवा के घर के अंगना म ठाढ़ हो अऊ यहूदा के नगरमन के ओ जम्मो मनखे, जऊन मन यहोवा के घर म अराधना करे बर आथें, ओमन ला कह। ओमन ला ओ बात कह, जेकर हुकूम मेंह तोला देवत हंव; एको ठन बात ला घलो झन छोंड़बे। <verse eid="JER 26:2" /><verse number="3" style="v" sid="JER 26:3" />सायद ओमन तोर बात ला सुनंय अऊ हर एक जन अपन दुस्ट चालचलन ला छोंड़ दे। तब मेंह सांत होहूं अऊ ओमन ऊपर ओ बिपत्ति नइं लानहूं, जेकर योजना मेंह ओमन के दुस्ट काममन के कारन बनात रहेंव। <verse eid="JER 26:3" /><verse number="4" style="v" sid="JER 26:4" />ओमन ला कह, ‘यहोवा ह ये कहत हे: यदि तुमन मोर बात ला नइं सुनहू अऊ मोर कानून म नइं चलहू, जेला मेंह तुम्हर आघू म रखे हवंव, <verse eid="JER 26:4" /><verse number="5" style="v" sid="JER 26:5" />अऊ यदि तुमन मोर ओ सेवक अगमजानीमन के बचन ला नइं सुनहू, जेमन ला मेंह तुम्हर करा बार-बार पठोय हंव (हालाकि तुमन नइं सुने हव), <verse eid="JER 26:5" /><verse number="6" style="v" sid="JER 26:6" />त फेर मेंह ये घर ला सीलो नगर के सहीं उजाड़ दूहूं अऊ ये सहर ला धरती के जम्मो जाति के मनखेमन के बीच म सरापित कर दूहूं।’ ”<verse eid="JER 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 26:7" />जब यरमियाह ह यहोवा के घर म ये बातमन ला कहिस, त पुरोहित, अगमजानी अऊ जम्मो मनखेमन सुनिन। <verse eid="JER 26:7" /><verse number="8" style="v" sid="JER 26:8" />जब यरमियाह ह मनखेमन ला ओ जम्मो बात बता चुकिस, जेला कहे के हुकूम यहोवा ह ओला देय रिहिस, ओकर बाद तुरते पुरोहित, अगमजानी अऊ जम्मो मनखेमन ओला पकड़ लीन अऊ कहिन, “तोर मरना जरूरी अय! <verse eid="JER 26:8" /><verse number="9" style="v" sid="JER 26:9" />तेंह काबर यहोवा के नांव म ये अगमबानी करत हस कि ये घर ह सीलो के सहीं हो जाही अऊ ये सहर ह उजड़ जाही अऊ येला तियाग दिये जाही?” अऊ यहोवा के घर म, यरमियाह के चारों कोति जम्मो मनखेमन के भीड़ लग गीस।<verse eid="JER 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 26:10" />जब यहूदा के करमचारीमन ये बात सुनिन, त ओमन राजमहल ले यहोवा के घर म गीन अऊ यहोवा के घर के नवां दुवार के मुंहटा म अपन-अपन जगह ले लीन। <verse eid="JER 26:10" /><verse number="11" style="v" sid="JER 26:11" />तब पुरोहित अऊ अगमजानीमन करमचारी अऊ जम्मो मनखेमन ला कहिन, “ये मनखे ला मिरतू-दंड के सजा मिलना चाही, काबरकि ये मनखे ह ये सहर के बिरूध अगमबानी करे हवय, अऊ ये बात ला तुमन घलो अपन कान ले सुने हवव।”<verse eid="JER 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 26:12" />तब यरमियाह ह जम्मो करमचारी अऊ जम्मो मनखेमन ला कहिस: “जऊन बात तुमन सुनेव, ओला यहोवा ही मोला ये भवन अऊ ये सहर के बिरूध अगमबानी के रूप म कहे बर पठोय हवय। <verse eid="JER 26:12" /><verse number="13" style="v" sid="JER 26:13" />एकरसेति अब तुमन अपन चालचलन अऊ अपन काम ला सुधारव अऊ यहोवा अपन परमेसर के बात ला मानव। तब यहोवा ह नरम होही अऊ ओ बिपत्ति नइं लानही, जेकर घोसना ओह तुम्हर बिरूध करे हवय। <verse eid="JER 26:13" /><verse number="14" style="v" sid="JER 26:14" />जहां तक मोर बात ए, मेंह तुम्हर हांथ म हवंव; जऊन कुछू तुमन ला सही अऊ बने लगय, मोर संग ओही करव। <verse eid="JER 26:14" /><verse number="15" style="v" sid="JER 26:15" />पर ये बात जरूर जान लव कि यदि तुमन मोला मार डारहू, त फेर तुमन अऊ ये सहर अऊ येमा रहइया मनखेमन एक निरदोस मनखे के खून करे के दोसी ठहिरहू; काबरकि सही म यहोवा ह मोला तुम्हर करा पठोय हवय कि मेंह ये जम्मो बात तुमन ला सुनावंव।”<verse eid="JER 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 26:16" />तब करमचारीमन अऊ जम्मो मनखेमन पुरोहित अऊ अगमजानीमन ले कहिन, “ये मनखे ला मिरतू-दंड नइं मिलना चाही, काबरकि ओह यहोवा हमर परमेसर के नांव म हमन ले गोठियाय हवय।”<verse eid="JER 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 26:17" />तब देस के कुछू अगुवामन आघू आईन अऊ मनखेमन के जम्मो सभा ला कहिन, <verse eid="JER 26:17" /><verse number="18" style="v" sid="JER 26:18" />“यहूदा के राजा हिजकियाह के समय म मोरेसेत नगर के मीका ह अगमबानी करिस। ओह यहूदा के जम्मो मनखेमन ले कहिस, ‘सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 26:18">“ ‘सियोन ला कोनो खेत के सहीं जोते जाही,</para>
  <para style="q2" vid="JER 26:18">यरूसलेम ह गोटी-पथरामन के कुढ़ा हो जाही,</para>
  <para style="q2" vid="JER 26:18">अऊ मंदिर के पहाड़ी ह झाड़ीमन ले भरके एक टीला बन जाही।’<note caller="+" style="f"><char style="fr" closed="false">26:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="MIC 3:12">मीका 3:12</ref></char></char></note><verse eid="JER 26:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="JER 26:19" />का यहूदा के राजा हिजकियाह या यहूदा के कोनो अऊ ओला मरवा दीन? का हिजकियाह ह यहोवा ले नइं डरिस अऊ ओकर ले दया के आसा नइं करिस? अऊ का यहोवा ह दया नइं देखाईस अऊ ओ बिपत्ति, जेला ओह ओमन ऊपर लाने के घोसना करे रिहिस, ओला लानिस? हमन अपन ऊपर एक भयंकर बिपत्ति लानेवाला हन!”<verse eid="JER 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 26:20" />(फेर किरयत-यारीम नगर के समायाह के बेटा उरियाह एक आने मनखे रिहिस, जऊन ह यहोवा के नांव म अगमबानी करिस; ओह घलो ये सहर अऊ ये देस के बिरूध म वइसने ही अगमबानी करिस, जइसने यरमियाह ह करे हवय। <verse eid="JER 26:20" /><verse number="21" style="v" sid="JER 26:21" />जब यहोयाकीम राजा अऊ ओकर जम्मो अधिकारी अऊ करमचारीमन ओकर बचन ला सुनिन, त राजा ह ओला मरवाय बर ठान लीस। पर उरियाह ह ये बात ला सुनके डर के मारे मिसर देस भाग गीस। <verse eid="JER 26:21" /><verse number="22" style="v" sid="JER 26:22" />तब यहोयाकीम राजा ह अकबोर के बेटा एलनातान ला कुछू अऊ मनखेमन के संग मिसर देस पठोईस। <verse eid="JER 26:22" /><verse number="23" style="v" sid="JER 26:23" />ओमन उरियाह ला मिसर देस ले निकालके यहोयाकीम राजा करा ले आईन, अऊ ओह उरियाह ला तलवार ले मरवाके ओकर लास ला सधारन मनखेमन के मरघटी म फेंकवा दीस।)<verse eid="JER 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 26:24" />पर, सापान के बेटा अहीकाम ह यरमियाह के मदद करिस, अऊ एकरसेति ओला मार डारे बर मनखेमन के हांथ म नइं दिये गीस।<verse eid="JER 26:24" /></para>
  <chapter eid="JER 26" />
  <chapter number="27" style="c" sid="JER 27" />
  <para style="s1">यहूदा ह नबूकदनेसर के सेवा करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 27:1" />योसियाह के बेटा, यहूदा के राजा सिदकियाह के राज के सुरू म, यहोवा ले ये बचन यरमियाह करा आईस। <verse eid="JER 27:1" /><verse number="2" style="v" sid="JER 27:2" />यहोवा ह मोला ये कहिस: “डोरी अऊ लकरी के एक जुड़ा बना अऊ ओला अपन घेंच म रख। <verse eid="JER 27:2" /><verse number="3" style="v" sid="JER 27:3" />तब एदोम, मोआब, अमोन, सूर अऊ सीदोन के राजामन करा, ओ दूतमन के जरिये खबर पठो, जऊन मन यहूदा के राजा सिदकियाह करा यरूसलेम आय हवंय। <verse eid="JER 27:3" /><verse number="4" style="v" sid="JER 27:4" />ओ दूतमन ला ओमन के मालिकमन बर ये कहिके एक संदेस दे, ‘सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: अपन-अपन मालिक ले ये कहव: <verse eid="JER 27:4" /><verse number="5" style="v" sid="JER 27:5" />मेंह अपन बड़े सामर्थ अऊ लमाय भुजा ले धरती अऊ येकर मनखे अऊ येमा रहइया पसुमन ला बनाय हंव, अऊ जेकर ले में खुस होथंव, ओला मेंह येमन ला देथंव। <verse eid="JER 27:5" /><verse number="6" style="v" sid="JER 27:6" />अब मेंह तुम्हर जम्मो देसमन ला अपन सेवक, बेबिलोन के राजा नबूकदनेसर के हांथ म दे दूहूं; अऊ त अऊ मेंह जंगली पसुमन ला घलो ओकर अधीन कर दूहूं। <verse eid="JER 27:6" /><verse number="7" style="v" sid="JER 27:7" />जम्मो जाति के मनखेमन ओकर अऊ ओकर बेटा अऊ ओकर पोता के सेवा तब तक करहीं, जब तक कि ओकर खुद के देस के समय नइं आ जाही; तब बहुंते जाति के मनखेमन अऊ बड़े राजामन ओला अपन अधीन कर लीहीं।<verse eid="JER 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 27:8" />“ ‘ “पर यदि कोनो जाति या राज ह बेबिलोन के राजा नबूकदनेसर के सेवा नइं करही या ओकर जुड़ा ला अपन गरदन म नइं लीही, त मेंह ओ जाति ला तलवार, अकाल अऊ महामारी के सजा तब तक देवत रहिहूं, जब तक कि मेंह ओ जाति ला ओकर हांथ के दुवारा नास नइं कर दूहूं, यहोवा ह घोसना करत हे। <verse eid="JER 27:8" /><verse number="9" style="v" sid="JER 27:9" />एकरसेति तुमन अपन अगमजानीमन अऊ अपन सकुन-बिचार करइयामन, तुम्हर सपना के अर्थ बतइयामन, अपन टोनहामन या अपन जादूगरमन के बात ला झन सुनव, जऊन मन तुमन ला कहिथें, ‘तुमन ला बेबिलोन के राजा के सेवा करना नइं पड़य।’ <verse eid="JER 27:9" /><verse number="10" style="v" sid="JER 27:10" />ओमन तुमन ले लबारी अगमबानी करथें, जेकर ले तुमन अपन-अपन देस ले दूरिहा हटा दिये जाहू; मेंह तुमन ला निकाल दूहूं अऊ तुमन नास हो जाहू। <verse eid="JER 27:10" /><verse number="11" style="v" sid="JER 27:11" />पर जऊन जाति के मनखेमन बेबिलोन के राजा के जुड़ा ला अपन गरदन म लीहीं अऊ ओकर सेवा करहीं, त मेंह ओ जाति के मनखेमन ला ओहीचमन के देस म रहन दूहूं, ताकि ओमन उहां खेती करंय अऊ उहां बसे रहंय, यहोवा ह घोसना करत हे।” ’ ”<verse eid="JER 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 27:12" />यहूदा के राजा सिदकियाह ला घलो मेंह येहीच संदेस दे हंव। मेंह कहेंव, “बेबिलोन के राजा के जुड़ा ला अपन गरदन म लेय ले; ओकर अऊ ओकर मनखेमन के सेवा कर, त तेंह जीयत रहिबे। <verse eid="JER 27:12" /><verse number="13" style="v" sid="JER 27:13" />जऊन जाति के मनखेमन बेबिलोन के राजा के सेवा नइं करहीं, ओमन ला यहोवा ह धमकी दे हवय कि ओमन तलवार, अकाल अऊ महामारी ले मारे जाहीं; त फेर तें अऊ तोर मनखेमन काबर मरे चाहथव? <verse eid="JER 27:13" /><verse number="14" style="v" sid="JER 27:14" />ओ अगमजानीमन के बात ला झन सुन, जऊन मन तोला ये कहिथें, ‘तोला बेबिलोन के राजा के सेवा करना नइं पड़य,’ काबरकि ओमन तोर ले लबारी गोठ कहत हवंय। <verse eid="JER 27:14" /><verse number="15" style="v" sid="JER 27:15" />‘मेंह ओमन ला नइं पठोय हवंव,’ यहोवा ह घोसना करत हे। ‘ओमन मोर नांव म लबारी अगमबानी करत हवंय। एकरसेति, मेंह तोला देस ले निकाल दूहूं अऊ तें अऊ ओ अगमजानी, जऊन मन तोर करा अगमबानी करथें, तुमन जम्मो के जम्मो नास हो जाहू।’ ”<verse eid="JER 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 27:16" />तब मेंह पुरोहितमन ला अऊ ये जम्मो मनखेमन ला कहेंव, “यहोवा ह ये कहत हे: ओ अगमजानीमन के बात ला झन सुनव, जऊन मन ये कहिथें, ‘अब बहुंत जल्दी, बेबिलोन ले यहोवा के भवन के सामानमन ला वापिस लाने जाही।’ ओमन तुम्हर ले लबारी अगमबानी करत हवंय। <verse eid="JER 27:16" /><verse number="17" style="v" sid="JER 27:17" />ओमन के बात ला झन सुनव। बेबिलोन के राजा के सेवा करव, त तुमन जीयत रहिहू। ये सहर ह काबर बरबाद होवय? <verse eid="JER 27:17" /><verse number="18" style="v" sid="JER 27:18" />यदि ओमन अगमजानी अंय अऊ ओमन करा यहोवा के बचन हवय, त ओमन सर्वसक्तिमान यहोवा ले बिनती करंय कि जऊन सामान यहोवा के भवन म अऊ यहूदा के राजा के महल म अऊ यरूसलेम म बांचे हवय, ओमन ला बेबिलोन झन ले जाय जावय। <verse eid="JER 27:18" /><verse number="19" style="v" sid="JER 27:19" />काबरकि सर्वसक्तिमान यहोवा ह ये कहत हवय कि जऊन खंभामन, कांसा के टंकी, खसकानेवाला गोड़ा अऊ आने सामान ये सहर म बांचे हवंय, <verse eid="JER 27:19" /><verse number="20" style="v" sid="JER 27:20" />जेमन ला बेबिलोन के राजा नबूकदनेसर ह ओ बेरा नइं ले गीस, जब ओह यहोयाकीम के बेटा, यहूदा के राजा यहोयाकीन ला अऊ यहूदा अऊ यरूसलेम के जम्मो परभावसाली मनखेमन ला बंदी बनाके यरूसलेम ले बेबिलोन ले गे रिहिस—हव, <verse eid="JER 27:20" /><verse number="21" style="v" sid="JER 27:21" />जऊन चीजमन यहोवा के भवन म अऊ यहूदा के राजा के महल म अऊ यरूसलेम म बांचे हवंय, ओमन के बारे म सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: <verse eid="JER 27:21" /><verse number="22" style="v" sid="JER 27:22" />‘ओ चीजमन ला बेबिलोन पहुंचाय जाही अऊ ओमन उहां तब तक रहिहीं, जब तक कि मेंह ओमन के सुधि लेय बर नइं आ जावंव,’ यहोवा ह घोसना करत हे। ‘तब मेंह ओमन ला वापिस लानहूं अऊ ये जगह म फेर रख दूहूं।’ ”<verse eid="JER 27:22" /></para>
  <chapter eid="JER 27" />
  <chapter number="28" style="c" sid="JER 28" />
  <para style="s1">लबरा अगमजानी हननयाह</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 28:1" />ओहीच साल, यहूदा के राजा सिदकियाह के राज के चौथा साल के पांचवां महिना म, अजूर के बेटा हननयाह अगमजानी, जऊन ह गिबोन नगर के रहइया रिहिस, ओह यहोवा के भवन म पुरोहितमन अऊ जम्मो मनखेमन के आघू म मोर ले कहिस: <verse eid="JER 28:1" /><verse number="2" style="v" sid="JER 28:2" />“सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: ‘मेंह बेबिलोन के राजा के जुड़ा<note caller="+" style="f"><char style="fr" closed="false">28:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ताकत</char></note> ला टोर दूहूं। <verse eid="JER 28:2" /><verse number="3" style="v" sid="JER 28:3" />यहोवा के भवन के जतेक सामान बेबिलोन के राजा नबूकदनेसर ये जगह ले हटाके बेबिलोन ले गे रिहिस, ओ जम्मो ला मेंह दू साल के भीतर ये जगह म वापिस ले आहूं। <verse eid="JER 28:3" /><verse number="4" style="v" sid="JER 28:4" />मेंह यहोयाकीम के बेटा, यहूदा के राजा यहोयाकीन अऊ यहूदा के ओ आने जम्मो बंदीमन ला घलो ये जगह म वापिस ले आहूं, जऊन मन बेबिलोन चले गे हवंय, काबरकि मेंह बेबिलोन के राजा के जुड़ा ला टोर दूहूं,’ ” यहोवा ह घोसना करत हे।<verse eid="JER 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 28:5" />तब यरमियाह अगमजानी ह हननयाह अगमजानी ला पुरोहितमन अऊ ओ जम्मो मनखेमन के आघू म जबाब दीस, जऊन मन यहोवा के भवन म ठाढ़े रिहिन। <verse eid="JER 28:5" /><verse number="6" style="v" sid="JER 28:6" />यरमियाह ह कहिस, “आमीन! यहोवा ह अइसने ही करय! यहोवा के भवन के चीजमन ला अऊ जम्मो बंदीमन ला बेबिलोन ले ये जगह म वापिस लानके, यहोवा ह तोर अगमबानी के कहे बात ला पूरा करय। <verse eid="JER 28:6" /><verse number="7" style="v" sid="JER 28:7" />तभो ले, जऊन बात मेंह तोर सुनत अऊ जम्मो मनखेमन के सुनत म कहत हंव, ओला सुन: <verse eid="JER 28:7" /><verse number="8" style="v" sid="JER 28:8" />सुरू ले, जऊन अगमजानीमन तोर अऊ मोर ले पहिले होवत आय हवंय, ओमन कतको देस अऊ बड़े-बड़े राजमन के बिरूध म लड़ई, बिपत्ति अऊ महामारी के अगमबानी करे हवंय। <verse eid="JER 28:8" /><verse number="9" style="v" sid="JER 28:9" />पर जऊन अगमजानी ह सांति के बिसय म अगमबानी करथे, त ओकर पहिचान यहोवा के दुवारा पठोय सही अगमजानी के रूप म तभे होही, जब ओकर अगमबानी के बचन ह पूरा होही।”<verse eid="JER 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 28:10" />तब हननयाह अगमजानी ह यरमियाह अगमजानी के गरदन म रखे जुड़ा ला लीस अऊ ओला टोर दीस, <verse eid="JER 28:10" /><verse number="11" style="v" sid="JER 28:11" />अऊ ओह जम्मो मनखेमन के आघू म कहिस, “यहोवा ह ये कहत हे: ‘येही किसम ले मेंह दू साल के भीतर बेबिलोन के राजा नबूकदनेसर के जम्मो जाति के मनखेमन के गरदन म रखे जुड़ा ला लेके टोर दूहूं।’ ” तब यरमियाह अगमजानी ह अपन डहार चल दीस।<verse eid="JER 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 28:12" />जब हननयाह अगमजानी ह यरमियाह अगमजानी के गरदन ले जुड़ा ला लेके टोर दीस, त ओकर बाद यहोवा के ये बचन यरमियाह करा आईस: <verse eid="JER 28:12" /><verse number="13" style="v" sid="JER 28:13" />“जाके हननयाह ला कह, ‘यहोवा ह ये कहत हे: तेंह कठवा के जुड़ा ला तो टोर देय, पर येकर जगह म तोला लोहा के एक जुड़ा मिलही। <verse eid="JER 28:13" /><verse number="14" style="v" sid="JER 28:14" />सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: मेंह ये जम्मो जाति के मनखेमन के गरदन म लोहा के एक जुड़ा रखहूं, ताकि ओमन बेबिलोन के राजा नबूकदनेसर के सेवा करंय, अऊ ओमन ओकर सेवा करहीं। अऊ त अऊ मेंह ओला जंगली पसुमन ऊपर घलो अधिकार दूहूं।’ ”<verse eid="JER 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 28:15" />तब यरमियाह अगमजानी ह हननयाह अगमजानी ला ये घलो कहिस, “हे हननयाह, सुन! यहोवा ह तोला नइं पठोय हवय, तभो ले तेंह ये मनखेमन ला अपन लबारी बात ऊपर भरोसा करवा दे हस। <verse eid="JER 28:15" /><verse number="16" style="v" sid="JER 28:16" />एकरसेति यहोवा ह ये कहत हे: ‘मेंह तोला ये धरती ले मिटानेवाला हंव। येहीच साल, तेंह मर जाबे, काबरकि तेंह यहोवा के बिरूध बिदरोह के बात करे हस।’ ”<verse eid="JER 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 28:17" />अऊ ओहीच साल के सातवां महिना म, हननयाह अगमजानी ह मर गीस।<verse eid="JER 28:17" /></para>
  <chapter eid="JER 28" />
  <chapter number="29" style="c" sid="JER 29" />
  <para style="s1">बंधुवई म गे मनखेमन बर एक चिट्ठी</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 29:1" />यरमियाह अगमजानी ह यरूसलेम ले ये किसम के चिट्ठी बंदीमन म बांचे अगुवामन ला अऊ पुरोहितमन, अगमजानीमन अऊ आने ओ जम्मो मनखेमन ला पठोईस, जेमन ला नबूकदनेसर ह यरूसलेम ले बेबिलोन बंदी बनाके ले गे रिहिस। <verse eid="JER 29:1" /><verse number="2" style="v" sid="JER 29:2" />(ये चिट्ठी तब पठोय गे रिहिस, जब यहोयाकीन राजा अऊ राज-माता, दरबार के करमचारी, अऊ यहूदा अऊ यरूसलेम के अगुवा, कुसल बनिहार अऊ कारीगरमन यरूसलेम ले बंधुवई म चले गे रिहिन।) <verse eid="JER 29:2" /><verse number="3" style="v" sid="JER 29:3" />ये चिट्ठी सापान के बेटा एलासा अऊ हिलकियाह के बेटा गमरयाह के हांथ म पठोय गीस, जेमन ला यहूदा के राजा सिदकियाह ह नबूकदनेसर राजा करा बेबिलोन पठोईस। चिट्ठी म ये लिखाय रिहिस:<verse eid="JER 29:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="JER 29:4" />ओ जम्मो मनखे, जेमन ला यहोवा ह यरूसलेम ले बेबिलोन बंदी बनाके ले गे हवय, ओमन ला सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: <verse eid="JER 29:4" /><verse number="5" style="v" sid="JER 29:5" />“घर बनाके ओमा बस जावव; बारी लगावव अऊ ओमा जऊन कुछू उपजथे, ओला खावव। <verse eid="JER 29:5" /><verse number="6" style="v" sid="JER 29:6" />सादी-बिहाव करके बेटा-बेटी जनमावव; अपन बेटामन के बिहाव करके ओमन बर घरवाली लानव अऊ अपन बेटीमन के बिहाव करव, ताकि ओमन के घलो बेटा-बेटी होवंय। उहां गनती म घटव झन, पर बढ़त जावव। <verse eid="JER 29:6" /><verse number="7" style="v" sid="JER 29:7" />जऊन सहर म, मेंह तुमन ला बंदी बनाके ले गे हवंव, ओ सहर म सांति अऊ ओकर उन्नति के कोसिस करव। ओकर बर यहोवा ले पराथना करव, काबरकि यदि ओ सहर के उन्नति होही, त तुम्हर घलो उन्नति होही।” <verse eid="JER 29:7" /><verse number="8" style="v" sid="JER 29:8" />हव, सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: “तुम्हर बीच के अगमजानी अऊ सकुन-बिचार करइयामन तुमन ला धोखा झन देवंय। ओमन जऊन सपना देखथें, ओ सपना के बातमन ला झन सुनव। <verse eid="JER 29:8" /><verse number="9" style="v" sid="JER 29:9" />ओमन मोर नांव म तुम्हर ले लबारी अगमबानी करथें। मेंह ओमन ला नइं पठोय हंव,” यहोवा ह घोसना करत हे।<verse eid="JER 29:9" /></para>
  <para style="pm">
    <verse number="10" style="v" sid="JER 29:10" />यहोवा ह ये कहत हे: “जब बेबिलोन के सत्तर साल पूरा हो जाही, त मेंह तुम्हर करा आहूं अऊ तुमन ला ये जगह म लहुंटा लाने के अपन करे गय बने वायदा ला पूरा करहूं। <verse eid="JER 29:10" /><verse number="11" style="v" sid="JER 29:11" />काबरकि तुम्हर बर मोर जऊन योजना हवय, ओला मेंह जानत हंव,” यहोवा ह घोसना करत हे, “तुम्हर नुकसान करे के नइं पर तुम्हर उन्नति के योजना, तुमन ला आसा अऊ एक भविस्य देय के योजना। <verse eid="JER 29:11" /><verse number="12" style="v" sid="JER 29:12" />तब तुमन मोला बलाहू अऊ आके मोर ले पराथना करहू, अऊ मेंह तुम्हर सुनहूं। <verse eid="JER 29:12" /><verse number="13" style="v" sid="JER 29:13" />तुमन मोला खोजहू अऊ मोला पाहू, जब तुमन मोला अपन पूरा मन से खोजहू। <verse eid="JER 29:13" /><verse number="14" style="v" sid="JER 29:14" />मेंह तुमन ला मिल जाहूं,” यहोवा ह घोसना करत हे, “अऊ तुमन ला बंधुवई ले लहुंटा लानहूं। मेंह तुमन ला ओ जम्मो जाति अऊ जगहमन ले इकट्ठा करहूं, जिहां मेंह तुमन ला निकाल दे हवंव,” यहोवा ह घोसना करत हे, “अऊ तुमन ला ओ जगह म लहुंटाके ले आहूं, जिहां ले मेंह तुमन ला बंधुवई म ले गे रहेंव।”<verse eid="JER 29:14" /></para>
  <para style="pm">
    <verse number="15" style="v" sid="JER 29:15" />तुमन कह सकत हव, “यहोवा ह हमर बर बेबिलोन म अगमजानी खड़े करे हवय,” <verse eid="JER 29:15" /><verse number="16" style="v" sid="JER 29:16" />पर ओ राजा, जऊन ह दाऊद के सिंघासन म बईठथे अऊ ओ जम्मो मनखे, जऊन मन ये सहर म हवंय, तुम्हर संगी मनखे, जऊन मन तुम्हर संग बंधुवई म नइं गीन, ओ जम्मो ले यहोवा ह ये कहत हे— <verse eid="JER 29:16" /><verse number="17" style="v" sid="JER 29:17" />हव, सर्वसक्तिमान यहोवा ह ये कहत हे: “मेंह ओमन के बिरूध तलवार, अकाल अऊ महामारी पठोहूं अऊ मेंह ओमन ला अइसने खराप अंजीर फर सहीं कर दूहूं, जेमन ला खाय नइं जा सकय। <verse eid="JER 29:17" /><verse number="18" style="v" sid="JER 29:18" />मेंह तलवार, अकाल अऊ महामारी लेके ओमन के पीछा करहूं अऊ ओमन ला धरती के जम्मो राज बर घिन करे के चीज बना दूहूं अऊ ओ जम्मो जातिमन के बीच म, जिहां मेंह ओमन ला खदेड़हूं, ओमन एक सरापित अऊ भय करे के चीज, कलंकित अऊ तिरस्कार करे के चीज होहीं। <verse eid="JER 29:18" /><verse number="19" style="v" sid="JER 29:19" />काबरकि ओमन मोर बात ला नइं सुने हवंय,” यहोवा ह घोसना करत हे, “ओ बात जेला मेंह अपन सेवक अगमजानीमन के दुवारा ओमन ला बार-बार कहेंव। अऊ तुमन बंधुवई म गे मनखेमन घलो नइं सुनेव,” यहोवा ह घोसना करत हे।<verse eid="JER 29:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="JER 29:20" />“एकरसेति हे जम्मो बंधुवई म गे मनखेमन, जेमन ला मेंह यरूसलेम ले बेबिलोन पठो देय हंव, तुमन यहोवा के बचन ला सुनव। <verse eid="JER 29:20" /><verse number="21" style="v" sid="JER 29:21" />कोलायाह के बेटा अहाब अऊ मासेयाह के बेटा सिदकियाह, जेमन मोर नांव म तुम्हर ले लबारी अगमबानी करत हवंय, ओमन के बारे म सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: मेंह ओमन ला बेबिलोन के राजा नबूकदनेसर के हांथ म कर दूहूं, अऊ ओह ओमन ला तुम्हर आंखी के आघू म मार डारही। <verse eid="JER 29:21" /><verse number="22" style="v" sid="JER 29:22" />ओमन के कारन, यहूदा ले बंधुवई म बेबिलोन गय जम्मो मनखेमन ये सराप के उपयोग करहीं: ‘यहोवा ह तोर संग ओ सिदकियाह अऊ अहाब सहीं बरताव करय, जेमन ला बेबिलोन के राजा ह आगी म जला दीस।’ <verse eid="JER 29:22" /><verse number="23" style="v" sid="JER 29:23" />काबरकि ओमन इसरायलीमन के बीच म बहुंते खराप काम करे हवंय; ओमन अपन परोसीमन के घरवाली संग बेभिचार करे हवंय, अऊ मोर नांव म, ओमन लबारी मारे हवंय—जेकर अधिकार मेंह नइं देय रहेंव। मेंह येला जानत हंव अऊ मेंह येकर गवाह अंव,” यहोवा ह घोसना करत हे।<verse eid="JER 29:23" /></para>
  <para style="s1">समायाह ला संदेस</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 29:24" />नेहेलामी समायाह ला ये कह, <verse eid="JER 29:24" /><verse number="25" style="v" sid="JER 29:25" />“सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: यरूसलेम म रहइया जम्मो मनखेमन ला, मासेयाह के बेटा सपनयाह पुरोहित ला, अऊ आने जम्मो पुरोहितमन ला, तेंह अपन ही नांव म चिट्ठी पठोय हस। तेंह सपनयाह ला कहय, <verse eid="JER 29:25" /><verse number="26" style="v" sid="JER 29:26" />‘यहोवा ह यहोयादा पुरोहित के जगह म तोला यहोवा के भवन के अधिकारी होय बर पुरोहित ठहिराय हे ताकि तें हर ओ पागल मनखे, जऊन ह अगमजानी के सहीं बरताव करथे, ओकर गोड़ म बेड़ी अऊ गरदन म लोहा के पट्टा डार। <verse eid="JER 29:26" /><verse number="27" style="v" sid="JER 29:27" />एकरसेति अनातोत नगर के यरमियाह, जऊन ह तुम्हर बीच म एक अगमजानी जइसन रहिथे, ओला तेंह काबर नइं दबकारे? <verse eid="JER 29:27" /><verse number="28" style="v" sid="JER 29:28" />ओह हमर करा बेबिलोन म ये संदेस पठोय हवय: तुमन बंधुवई म बहुंत समय तक रहिहू। एकरसेति घर बनावव अऊ बस जावव; बारी लगावव अऊ ओमा जऊन कुछू उपजथे, ओला खावव।’ ”<verse eid="JER 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 29:29" />ये चिट्ठी ला सपनयाह पुरोहित ह यरमियाह अगमजानी ला पढ़के सुनाईस। <verse eid="JER 29:29" /><verse number="30" style="v" sid="JER 29:30" />तब यहोवा के ये बचन यरमियाह करा आईस: <verse eid="JER 29:30" /><verse number="31" style="v" sid="JER 29:31" />“जम्मो बंधुवा मनखेमन करा ये संदेस पठो: ‘यहोवा ह नेहेलामी समायाह के बारे म ये कहत हे: काबरकि समायाह ह तुमन ले अगमबानी करे हवय हालाकि मेंह ओला नइं पठोय रहेंव, अऊ तुमन ला लबारी बात ऊपर भरोसा करे बर उकसाय हवय, <verse eid="JER 29:31" /><verse number="32" style="v" sid="JER 29:32" />एकरसेति यहोवा ह ये कहत हे: खचित मेंह नेहेलामी समायाह अऊ ओकर संतानमन ला सजा दूहूं। ये मनखेमन के बीच म, ओकर घर के कोनो नइं बचहीं, अऊ न ही ओह ओ बने चीजमन ला देखन पाही, जेला मेंह अपन मनखेमन बर करहूं, यहोवा ह घोसना करत हे, काबरकि ओह मोर बिरूध बिदरोह के परचार करे हवय।’ ”<verse eid="JER 29:32" /></para>
  <chapter eid="JER 29" />
  <chapter number="30" style="c" sid="JER 30" />
  <para style="s1">इसरायल के बंधुवई ले वापसी</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 30:1" />यहोवा कोति ले ये बचन यरमियाह करा आईस: <verse eid="JER 30:1" /><verse number="2" style="v" sid="JER 30:2" />“यहोवा, इसरायल के परमेसर ह ये कहत हे: ‘जऊन बात मेंह तोर ले कहे हवंव, ओ जम्मो ला एक ठन किताब म लिख ले। <verse eid="JER 30:2" /><verse number="3" style="v" sid="JER 30:3" />ओ दिनमन आवत हें,’ यहोवा ह घोसना करत हे, ‘जब मेंह अपन इसरायली अऊ यहूदी मनखेमन ला बंधुवई ले वापिस लानहूं अऊ जऊन देस मेंह ओमन के पुरखामन ला अधिकार करे बर देय रहेंव, ओ देस म, मेंह ओमन ला फेर बसाहूं,’ यहोवा ह कहत हे।”<verse eid="JER 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 30:4" />जऊन बचन यहोवा ह इसरायली अऊ यहूदीमन के बारे म कहिस, ओमन ये अंय: <verse eid="JER 30:4" /><verse number="5" style="v" sid="JER 30:5" />“यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 30:5">“ ‘भय के मारे रोये के अवाज सुनई देवत हे—</para>
  <para style="q2" vid="JER 30:5">सांति नइं, पर आतंक के अवाज।<verse eid="JER 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 30:6" />पुछव अऊ देखव:</para>
  <para style="q2" vid="JER 30:6">का कोनो आदमी ह लइका ला जनम दे सकथे?</para>
  <para style="q1" vid="JER 30:6">त फेर मेंह काबर देखत हंव कि हर एक बलवान मनखे ह</para>
  <para style="q2" vid="JER 30:6">छेवारी होवइया माईलोगन सहीं अपन हांथ ला अपन पेट म रखे हवय,</para>
  <para style="q2" vid="JER 30:6">हर एक चेहरा मरे सहीं पीला हो गे हवय?<verse eid="JER 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 30:7" />ओह दिन ह कतेक भयंकर होही!</para>
  <para style="q2" vid="JER 30:7">ओ दिन सहीं अऊ कोनो दिन नइं होही।</para>
  <para style="q1" vid="JER 30:7">याकूब बर, ओह संकट के बेरा होही,</para>
  <para style="q2" vid="JER 30:7">पर ओला ओमा ले बचाय जाही।<verse eid="JER 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JER 30:8" />“ ‘ओ दिन,’ सर्वसक्तिमान यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="JER 30:8">‘मेंह ओमन के गरदन के जुड़ा ला उतारके टोर दूहूं</para>
  <para style="q1" vid="JER 30:8">अऊ ओमन के बंधना ला कुटा-कुटा कर दूहूं;</para>
  <para style="q2" vid="JER 30:8">अऊ परदेसीमन ओमन ला फेर गुलाम नइं बनाहीं।<verse eid="JER 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 30:9" />पर ओमन यहोवा अपन परमेसर</para>
  <para style="q2" vid="JER 30:9">अऊ अपन राजा दाऊद के सेवा करहीं,</para>
  <para style="q2" vid="JER 30:9">जेला मेंह ओमन बर ठाढ़ करहूं।<verse eid="JER 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 30:10" />“ ‘एकरसेति, हे मोर सेवक याकूब, झन डर;</para>
  <para style="q2" vid="JER 30:10">हे इसरायल, भयभीत झन हो,’</para>
  <para style="q2" vid="JER 30:10">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 30:10">‘खचित, मेंह तोला दूरिहा जगह ले,</para>
  <para style="q2" vid="JER 30:10">अऊ तोर संतानमन ला बंधुवई के देस ले छुड़ाके लानहूं।</para>
  <para style="q1" vid="JER 30:10">याकूब ह फेर सांति अऊ सुरकछा म रहिही,</para>
  <para style="q2" vid="JER 30:10">अऊ कोनो ओला डरा नइं सकहीं।<verse eid="JER 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 30:11" />मेंह तोर संग हवंव अऊ मेंह तोला बचाहूं,’</para>
  <para style="q2" vid="JER 30:11">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 30:11">‘हालाकि जऊन जातिमन के बीच म, मेंह तुमन ला तितिर-बितिर कर दे हवंव</para>
  <para style="q2" vid="JER 30:11">ओ जम्मो जाति ला मेंह पूरा नास कर दूहूं,</para>
  <para style="q2" vid="JER 30:11">पर मेंह तुमन ला पूरा नास नइं करंव।</para>
  <para style="q1" vid="JER 30:11">मेंह तुम्हर ताड़ना करहूं, पर सिरिप एक सीमना के भीतर;</para>
  <para style="q2" vid="JER 30:11">मेंह तुमन ला बिगर ताड़ना के पूरा नइं छोड़ंव।’<verse eid="JER 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 30:12" />“यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 30:12">“ ‘तोर घाव ह नइं भरय,</para>
  <para style="q2" vid="JER 30:12">अऊ तोला लगे चोट ह ठीक नइं होवय।<verse eid="JER 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 30:13" />तोर मामला ला लड़े बर कोनो नइं ए,</para>
  <para style="q2" vid="JER 30:13">तोर घाव के कोनो ईलाज नइं ए,</para>
  <para style="q2" vid="JER 30:13">तोर बर कोनो चंगई नइं ए।<verse eid="JER 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 30:14" />तोर जम्मो संगवारीमन तोला भुला गे हवंय;</para>
  <para style="q2" vid="JER 30:14">ओमन तोर कोनो चिंता नइं करंय।</para>
  <para style="q1" vid="JER 30:14">एक बईरी ह जइसने मारथे, वइसने मेंह तोला मारे हंव</para>
  <para style="q2" vid="JER 30:14">अऊ एक निरदयी ह जइसने सजा देथे, वइसने मेंह तोला सजा दे हंव,</para>
  <para style="q1" vid="JER 30:14">काबरकि तोर अपराध ह बहुंत बड़े हे</para>
  <para style="q2" vid="JER 30:14">अऊ तोर पापमन बहुंत अकन हवंय।<verse eid="JER 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 30:15" />अपन घाव अऊ ओ पीरा ऊपर काबर रोवत हस,</para>
  <para style="q2" vid="JER 30:15">जेकर कोनो ईलाज नइं ए?</para>
  <para style="q1" vid="JER 30:15">तोर बड़े अपराध अऊ बहुंते पाप के कारन</para>
  <para style="q2" vid="JER 30:15">मेंह तोर संग अइसने करे हवंव।<verse eid="JER 30:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JER 30:16" />“ ‘पर ओ जम्मो, जऊन मन तोला खावत हें, ओमन खुद खा लिये जाहीं;</para>
  <para style="q2" vid="JER 30:16">तोर जम्मो बईरीमन बंधुवई म चल दीहीं।</para>
  <para style="q1" vid="JER 30:16">जऊन मन तोला लूटत हें, ओमन खुद लूटे जाहीं;</para>
  <para style="q2" vid="JER 30:16">ओ जम्मो, जऊन मन तोला लूटत हें, ओमन ला मेंह लूटहूं।<verse eid="JER 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 30:17" />पर मेंह तोला फेर भला-चंगा करहूं</para>
  <para style="q2" vid="JER 30:17">अऊ तोर घावमन ला ठीक कर दूहूं,’ यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="JER 30:17">‘काबरकि तोला जाति ले निकाले गे मनखे कहे जाथे,</para>
  <para style="q2" vid="JER 30:17">येह सियोन ए, जेकर चिंता कोनो नइं करंय।’<verse eid="JER 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 30:18" />“यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 30:18">“ ‘मेंह याकूब के तम्बूमन ला फेर बसाहूं</para>
  <para style="q2" vid="JER 30:18">अऊ ओकर निवासमन ऊपर दया देखाहूं;</para>
  <para style="q1" vid="JER 30:18">सहर ला अपन ही खंडहर ऊपर फेर बनाय जाही,</para>
  <para style="q2" vid="JER 30:18">अऊ महल ह अपन ही जगह म फेर ठाढ़ होही।<verse eid="JER 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 30:19" />ओमन ले धनबाद के गीत</para>
  <para style="q2" vid="JER 30:19">अऊ आनंद मनाय के अवाज आही।</para>
  <para style="q1" vid="JER 30:19">मेंह ओमन के गनती ला बढ़ाहूं,</para>
  <para style="q2" vid="JER 30:19">अऊ ओमन नइं घटहीं;</para>
  <para style="q1" vid="JER 30:19">मेंह ओमन के आदरमान बढ़ाहूं,</para>
  <para style="q2" vid="JER 30:19">अऊ ओमन तुछ-नीच नइं समझे जाहीं।<verse eid="JER 30:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 30:20" />ओमन के लइकामन पुराना जमाना के सहीं होहीं,</para>
  <para style="q2" vid="JER 30:20">अऊ ओमन के समाज ह मोर आघू म स्थापित होही;</para>
  <para style="q2" vid="JER 30:20">जऊन मन ओमन ला सताथें, ओ जम्मो ला मेंह सजा दूहूं।<verse eid="JER 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 30:21" />ओमन के अगुवा ओमन के बीच म ले ही एक झन होही;</para>
  <para style="q2" vid="JER 30:21">ओमन ऊपर राज-करइया घलो ओमन के बीच ले ही होही।</para>
  <para style="q1" vid="JER 30:21">मेंह ओला लकठा म लानहूं अऊ ओह मोर लकठा म आही—</para>
  <para style="q2" vid="JER 30:21">काबरकि कोन ए ओ, जऊन ह मोर लकठा म</para>
  <para style="q2" vid="JER 30:21">आय बर अपनआप ला दे दीही?’</para>
  <para style="q2" vid="JER 30:21">यहोवा ह घोसना करत हे।<verse eid="JER 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 30:22" />‘ये किसम ले तुमन मोर मनखे होहू,</para>
  <para style="q2" vid="JER 30:22">अऊ मेंह तुम्हर परमेसर ठहिरहूं।’ ”<verse eid="JER 30:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JER 30:23" />देखव, यहोवा के कहर ह</para>
  <para style="q2" vid="JER 30:23">गुस्सा के कारन भड़क जाही,</para>
  <para style="q1" vid="JER 30:23">एक भयंकर आंधी ह दुस्टमन के</para>
  <para style="q2" vid="JER 30:23">मुड़ ऊपर किंदरत हवय।<verse eid="JER 30:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 30:24" />जब तक यहोवा ह</para>
  <para style="q2" vid="JER 30:24">अपन हिरदय के उदेस्य ला पूरा नइं कर लीही</para>
  <para style="q2" vid="JER 30:24">तब तक ओकर भड़के गुस्सा ह सांत नइं होही।</para>
  <para style="q1" vid="JER 30:24">अवइया दिन म</para>
  <para style="q2" vid="JER 30:24">तुमन ये बात ला समझहू।<verse eid="JER 30:24" /></para>
  <chapter eid="JER 30" />
  <chapter number="31" style="c" sid="JER 31" />
  <para style="p">
    <verse number="1" style="v" sid="JER 31:1" />यहोवा ह घोसना करत हे, “ओ समय म, मेंह जम्मो इसरायली परिवारमन के परमेसर होहूं, अऊ ओमन मोर मनखे होहीं।”<verse eid="JER 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 31:2" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 31:2">“जऊन मनखेमन तलवार ले बच जाथें</para>
  <para style="q2" vid="JER 31:2">ओमन ऊपर सुन्ना जगह म दया करे जाही;</para>
  <para style="q2" vid="JER 31:2">मेंह इसरायल ला अराम देय बर आहूं।”<verse eid="JER 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 31:3" />यहोवा ह बहुंत पहिले हमर करा परगट होके कहिस:</para>
  <para style="q1" vid="JER 31:3">“मेंह तुमन ला सदा बने रहइया मया करे हवंव;</para>
  <para style="q2" vid="JER 31:3">मेंह तुमन ऊपर हमेसा दया देखाय हवंव।<verse eid="JER 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 31:4" />मेंह तुमन ला फेर बनाहूं,</para>
  <para style="q2" vid="JER 31:4">अऊ हे कुंवारी इसरायल! तेंह फेर से बनाय जाबे।</para>
  <para style="q1" vid="JER 31:4">तेंह फेर अपन डफली ला लेबे</para>
  <para style="q2" vid="JER 31:4">अऊ आनंद सहित नाचे बर बाहिर निकलबे।<verse eid="JER 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 31:5" />तेंह सामरिया के पहाड़ीमन म</para>
  <para style="q2" vid="JER 31:5">अंगूर के बारीमन ला फेर लगाबे;</para>
  <para style="q1" vid="JER 31:5">किसानमन ओमन ला लगाहीं</para>
  <para style="q2" vid="JER 31:5">अऊ ओमन के फर के आनंद उठाहीं।<verse eid="JER 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 31:6" />एक अइसने दिन आही, जब रखवारमन</para>
  <para style="q2" vid="JER 31:6">एपरैम के पठारमन ले चिचियाके कहिहीं,</para>
  <para style="q1" vid="JER 31:6">‘आवव, हमन सियोन ऊपर,</para>
  <para style="q2" vid="JER 31:6">यहोवा हमर परमेसर करा जाबो।’ ”<verse eid="JER 31:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 31:7" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 31:7">“याकूब बर आनंद के गीत गावव;</para>
  <para style="q2" vid="JER 31:7">सबले ऊंच जाति बर चिचियावव।</para>
  <para style="q1" vid="JER 31:7">परसंसा के बातमन सुनावव, अऊ कहव,</para>
  <para style="q2" vid="JER 31:7">‘हे यहोवा, अपन मनखे,</para>
  <para style="q2" vid="JER 31:7">इसरायल के बांचे भाग ला बचा।’<verse eid="JER 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 31:8" />देखव, मेंह ओमन ला उत्तर दिग के देस ले लेय आहूं</para>
  <para style="q2" vid="JER 31:8">अऊ धरती के छोर ले ओमन ला संकेलहूं।</para>
  <para style="q1" vid="JER 31:8">ओमन के बीच म अंधरा, खोरवा,</para>
  <para style="q2" vid="JER 31:8">देहें बोहे दाई अऊ लइका जनमइया माईलोगनमन होहीं;</para>
  <para style="q2" vid="JER 31:8">मनखेमन के एक बड़े भीड़ ह लहुंटके आही।<verse eid="JER 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 31:9" />ओमन रोवत आहीं;</para>
  <para style="q2" vid="JER 31:9">जब मेंह ओमन ला लानहूं, त ओमन पराथना करहीं।</para>
  <para style="q1" vid="JER 31:9">मेंह ओमन ला पानी के सोता के तीर म ले</para>
  <para style="q2" vid="JER 31:9">समतल रसता म ले जाहूं, जिहां ओमन ठोकर नइं खाहीं,</para>
  <para style="q1" vid="JER 31:9">काबरकि मेंह इसरायल के ददा अंव</para>
  <para style="q2" vid="JER 31:9">अऊ एपरैम ह मोर पहिली जनमे बेटा अय।<verse eid="JER 31:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 31:10" />“हे जाति-जाति के मनखेमन, यहोवा के बचन ला सुनव;</para>
  <para style="q2" vid="JER 31:10">दूरिहा-दूरिहा के समुंदर तीर के देसमन म येकर परचार करव:</para>
  <para style="q1" vid="JER 31:10">कहव, ‘जऊन ह इसरायलीमन ला तितिर-बितिर करे हवय, ओहीच ह ओमन ला संकेलही</para>
  <para style="q2" vid="JER 31:10">अऊ ओमन के अइसने खियाल रखही, जइसने एक चरवाहा ह अपन झुंड के खियाल रखथे।’<verse eid="JER 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 31:11" />काबरकि यहोवा ह याकूब ला छुड़ा लीही</para>
  <para style="q2" vid="JER 31:11">अऊ ओमन ला ओ बईरीमन के हांथ ले छुटकारा दीही, जऊन मन ओमन ले जादा बलवान हवंय।<verse eid="JER 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 31:12" />ओमन आहीं अऊ सियोन के ऊंचहा जगहमन म आनंद के मारे चिचियाहीं;</para>
  <para style="q2" vid="JER 31:12">ओमन यहोवा के उदारता ला देखके आनंद मनाहीं—</para>
  <para style="q1" vid="JER 31:12">ओमन करा अनाज, नवां अंगूर के मंद अऊ जैतून तेल,</para>
  <para style="q2" vid="JER 31:12">भेड़-बकरी अऊ गाय-बईलामन के बछरूमन होहीं।</para>
  <para style="q1" vid="JER 31:12">ओमन बने करके पानी पलोय बारी सहीं होहीं,</para>
  <para style="q2" vid="JER 31:12">अऊ ओमन फेर कभू उदास नइं होहीं।<verse eid="JER 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 31:13" />तब जवान माईलोगनमन नाचहीं अऊ खुसी मनाहीं,</para>
  <para style="q2" vid="JER 31:13">जवान मनखे अऊ डोकरामन घलो।</para>
  <para style="q1" vid="JER 31:13">मेंह ओमन के सोक ला खुसी म बदल दूहूं;</para>
  <para style="q2" vid="JER 31:13">मेंह सोक के बदले ओमन ला सांति अऊ आनंद दूहूं।<verse eid="JER 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 31:14" />मेंह पुरोहितमन ला बहुंतायत से देके ओमन ला संतोस कर दूहूं,</para>
  <para style="q2" vid="JER 31:14">अऊ मोर मनखेमन मोर उदारता से दिये चीजमन ले भर जाहीं,”</para>
  <para style="q2" vid="JER 31:14">यहोवा ह घोसना करत हे।<verse eid="JER 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 31:15" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 31:15">“रामा सहर म रोये</para>
  <para style="q2" vid="JER 31:15">अऊ बहुंते बिलाप करे के अवाज सुनई देवथे।</para>
  <para style="q1" vid="JER 31:15">राहेल ह अपन लइकामन खातिर रोवत हे</para>
  <para style="q2" vid="JER 31:15">अऊ ओह नइं चाहत रिहिस कि कोनो ओला सांतवना देवंय,</para>
  <para style="q2" vid="JER 31:15">काबरकि ओकर लइकामन मर गे हवंय।”<verse eid="JER 31:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 31:16" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 31:16">“तेंह रोना बंद कर</para>
  <para style="q2" vid="JER 31:16">अऊ अपन आंसू झन बहा,</para>
  <para style="q1" vid="JER 31:16">काबरकि तोला मेहनत के फर मिलही,”</para>
  <para style="q2" vid="JER 31:16">यहोवा ह घोसना करत हे।</para>
  <para style="q2" vid="JER 31:16">“ओमन बईरीमन के देस ले लहुंट आहीं।<verse eid="JER 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 31:17" />एकरसेति तोर संतानमन बर आसा हवय,”</para>
  <para style="q2" vid="JER 31:17">यहोवा ह घोसना करत हे।</para>
  <para style="q2" vid="JER 31:17">“तोर लइकामन अपन देस म लहुंट आहीं।<verse eid="JER 31:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 31:18" />“मेंह सही म एपरैम ला ये बिलाप करत सुने हवंव:</para>
  <para style="q2" vid="JER 31:18">‘तेंह एक उदंड बछरू के सहीं मोर ताड़ना करे हस,</para>
  <para style="q2" vid="JER 31:18">अऊ मोला सजा मिले हवय।</para>
  <para style="q1" vid="JER 31:18">मोला पहिले के सहीं कर दे, अऊ मेंह वापिस आहूं,</para>
  <para style="q2" vid="JER 31:18">काबरकि तेंह यहोवा मोर परमेसर अस।<verse eid="JER 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 31:19" />भटक जाय के बाद,</para>
  <para style="q2" vid="JER 31:19">मेंह पछताप करेंव;</para>
  <para style="q1" vid="JER 31:19">समझ म आय के बाद,</para>
  <para style="q2" vid="JER 31:19">मेंह अपन छाती पीटेंव।</para>
  <para style="q1" vid="JER 31:19">मेंह सरमिंदा होयेंव अऊ दीन-हीन करे गेंव</para>
  <para style="q2" vid="JER 31:19">काबरकि मोर म अपन जवानी के कलंक रिहिस।’<verse eid="JER 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 31:20" />का एपरैम ह मोर मयारू बेटा नो हय,</para>
  <para style="q2" vid="JER 31:20">जेला देखके मेंह खुसी ले भर जाथंव?</para>
  <para style="q1" vid="JER 31:20">हालाकि मेंह अकसर ओकर बिरूध गोठियाथंव,</para>
  <para style="q2" vid="JER 31:20">तभो ले मेंह ओला अभी घलो सुरता करथंव।</para>
  <para style="q1" vid="JER 31:20">एकरसेति मोर मन ह ओकर ऊपर लगे रहिथे;</para>
  <para style="q2" vid="JER 31:20">मोर मन म ओकर बर बहुंत दया हवय,”</para>
  <para style="q2" vid="JER 31:20">यहोवा ह घोसना करत हे।<verse eid="JER 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 31:21" />“हे कुंवारी इसरायल, सड़क के चिनहांमन ला ठीक कर;</para>
  <para style="q2" vid="JER 31:21">डहार देखइया खंभामन ला गाड़।</para>
  <para style="q1" vid="JER 31:21">जऊन सड़क म तेंह जाथस,</para>
  <para style="q2" vid="JER 31:21">ओ राजमार्ग ला धियान म रख।</para>
  <para style="q1" vid="JER 31:21">तेंह लहुंट आ,</para>
  <para style="q2" vid="JER 31:21">अपन नगरमन म लहुंट आ।<verse eid="JER 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 31:22" />हे बेईमान बेटी इसरायल,</para>
  <para style="q2" vid="JER 31:22">तेंह कब तक भटकत रहिबे?</para>
  <para style="q1" vid="JER 31:22">यहोवा ह धरती म एक नवां चीज बनाही—</para>
  <para style="q2" vid="JER 31:22">माईलोगन ह आदमी करा लहुंट आही।”<note caller="+" style="f"><char style="fr" closed="false">31:22 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">रकछा करही</char></note><verse eid="JER 31:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 31:23" />सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: “जब मेंह ओमन ला बंधुवई ले वापिस लानहूं, तब यहूदा देस अऊ येकर नगरमन के मनखेमन एक बार फेर ये बात कहिहीं: ‘हे सम्पन्न सहर, हे पबितर पहाड़, यहोवा ह तोला आसीस देवय।’ <verse eid="JER 31:23" /><verse number="24" style="v" sid="JER 31:24" />यहूदा अऊ येकर जम्मो नगरमन म मनखेमन एक संग रहिहीं—किसानमन अऊ ओ मनखे, जऊन मन अपन पसु के झुंड के संग एक जगह ले आने जगह जावत रहिथें। <verse eid="JER 31:24" /><verse number="25" style="v" sid="JER 31:25" />मेंह थके मनखेमन ला ताजा अऊ दुरबल मनखेमन ला संतुस्ट करहूं।”<verse eid="JER 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 31:26" />अतका म मेंह जाग गेंव अऊ चारों कोति देखेंव। मोर नींद ह मोला बने लगिस।<verse eid="JER 31:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 31:27" />यहोवा ह घोसना करत हे, “ओ दिनमन आवत हें, जब मेंह इसरायल अऊ यहूदा के राजमन ला मनखे अऊ पसु दूनों के संतान सहित बढ़ाहूं। <verse eid="JER 31:27" /><verse number="28" style="v" sid="JER 31:28" />जइसने कि मेंह ओमन ला उखाने म अऊ गिराय म, अऊ फटिकके नास करे म अऊ बिपत्ति लाने म नजर रखेंव, वइसने ही मेंह ओमन ला बनाय म अऊ बढ़ाय म नजर रखहूं,” यहोवा ह घोसना करत हे। <verse eid="JER 31:28" /><verse number="29" style="v" sid="JER 31:29" />“ओ दिनमन म मनखेमन ये नइं कहिहीं,</para>
  <para style="q1" vid="JER 31:29">“ ‘दाई-ददामन तो खट्टा अंगूर खाईन,</para>
  <para style="q2" vid="JER 31:29">अऊ दांत खट्टा होईस लइकामन के।’<verse eid="JER 31:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="JER 31:30" />येकर उल्टा, हर एक मनखे ह ओकर खुद के पाप के कारन मरही; जऊन ह खट्टा अंगूर खाही—ओकर खुद के दांत ह खट्टा होही।<verse eid="JER 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 31:31" />“ओ दिनमन आवत हें,” यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="JER 31:31">“जब मेंह इसरायल के मनखेमन संग</para>
  <para style="q1" vid="JER 31:31">अऊ यहूदा के मनखेमन संग</para>
  <para style="q2" vid="JER 31:31">एक नवां करार करहूं।<verse eid="JER 31:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 31:32" />येह ओ करार सहीं नइं होही,</para>
  <para style="q2" vid="JER 31:32">जेला मेंह ओमन के पुरखामन संग करे रहेंव</para>
  <para style="q1" vid="JER 31:32">जब मेंह ओमन के हांथ धरके</para>
  <para style="q2" vid="JER 31:32">ओमन ला मिसर देस ले निकाल लानेंव,</para>
  <para style="q1" vid="JER 31:32">काबरकि ओमन मोर करार ला टोर दीन,</para>
  <para style="q2" vid="JER 31:32">हालाकि मेंह ओमन के घरवाला रहेंव,”<note caller="+" style="f"><char style="fr" closed="false">31:32 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मालिक रहेंव</char></note></para>
  <para style="q2" vid="JER 31:32">यहोवा ह घोसना करत हे।<verse eid="JER 31:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 31:33" />“ओ समय के बाद, मेंह इसरायल के मनखेमन संग</para>
  <para style="q2" vid="JER 31:33">ये करार करहूं,” यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 31:33">“मेंह अपन कानून ला ओमन के मन म डालहूं</para>
  <para style="q2" vid="JER 31:33">अऊ येला ओमन के हिरदय म लिखहूं।</para>
  <para style="q1" vid="JER 31:33">मेंह ओमन के परमेसर होहूं,</para>
  <para style="q2" vid="JER 31:33">अऊ ओमन मोर मनखे होहीं।<verse eid="JER 31:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 31:34" />ओमन अपन परोसी ला फेर ये कभू नइं सिखोहीं,</para>
  <para style="q2" vid="JER 31:34">या एक-दूसर ला ये नइं कहिहीं, ‘यहोवा ला जानव,’</para>
  <para style="q1" vid="JER 31:34">काबरकि छोटे ले लेके बड़े तक,</para>
  <para style="q2" vid="JER 31:34">ओ जम्मो झन मोला जानहीं,”</para>
  <para style="q2" vid="JER 31:34">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 31:34">“काबरकि मेंह ओमन के अधरम ला छेमा करहूं</para>
  <para style="q2" vid="JER 31:34">अऊ ओमन के पाप ला फेर सुरता नइं करहूं।”<verse eid="JER 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JER 31:35" />यहोवा ह ये कहत हे,</para>
  <para style="q1" vid="JER 31:35">जऊन ह दिन म अंजोर देय बर</para>
  <para style="q2" vid="JER 31:35">सूरज ला ठहिराथे,</para>
  <para style="q1" vid="JER 31:35">जऊन ह रथिया अंजोर देय बर</para>
  <para style="q2" vid="JER 31:35">चंदा अऊ तारामन ला ठहिराथे,</para>
  <para style="q1" vid="JER 31:35">जऊन ह समुंदर ला हलाथे</para>
  <para style="q2" vid="JER 31:35">ताकि येकर लहरामन गरजें—</para>
  <para style="q2" vid="JER 31:35">ओकर नांव सर्वसक्तिमान यहोवा अय:<verse eid="JER 31:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 31:36" />“यदि ये नियममन मोर आघू ले हट जावंय,”</para>
  <para style="q2" vid="JER 31:36">यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="JER 31:36">“त का इसरायल ह कभू एक देस के रूप म</para>
  <para style="q2" vid="JER 31:36">मोर आघू ले मिट जाही।”<verse eid="JER 31:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JER 31:37" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 31:37">“यदि ऊपर अकास ला नापे जा सकतिस</para>
  <para style="q2" vid="JER 31:37">अऊ खाल्हे धरती के नीव के पता लगाय जा सकतिस</para>
  <para style="q1" vid="JER 31:37">त मेंह इसरायल के जम्मो संतान ला</para>
  <para style="q2" vid="JER 31:37">ओमन के जम्मो पापमन के कारन तियाग देतेंव,”</para>
  <para style="q2" vid="JER 31:37">यहोवा ह घोसना करत हे।<verse eid="JER 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JER 31:38" />“ओ दिनमन आवत हें,” यहोवा ह घोसना करत हे, “जब ये सहर ह हनानेल के ऊंच महल ले लेके कोना के दीवार तक मोर बर फेर बनाय जाही। <verse eid="JER 31:38" /><verse number="39" style="v" sid="JER 31:39" />नापे के लकीर ह उहां ले आघू बढ़के सीधा गारेब के पहाड़ी तक जाही अऊ तब मुड़के गोआ तक आही। <verse eid="JER 31:39" /><verse number="40" style="v" sid="JER 31:40" />ओ जम्मो घाटी जिहां लासमन ला अऊ राख ला फटिक दिये जाथे, अऊ पूरब म घोड़ा दुवार के कोना तक किदरोन घाटी के जम्मो समतल भुइयां यहोवा बर पबितर ठहिरही। ओ सहर ला फेर कभू उखाने या गिराय नइं जाही।”<verse eid="JER 31:40" /></para>
  <chapter eid="JER 31" />
  <chapter number="32" style="c" sid="JER 32" />
  <para style="s1">यरमियाह ह एक खेत बिसाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 32:1" />यहूदा के राजा सिदकियाह के राज के दसवां साल म, जऊन ह नबूकदनेसर के राज के अठारहवां साल रिहिस, यहोवा के ये बचन यरमियाह करा आईस। <verse eid="JER 32:1" /><verse number="2" style="v" sid="JER 32:2" />ओ समय, बेबिलोन के राजा के सेना ह यरूसलेम ला घेर ले रिहिस, अऊ यरमियाह अगमजानी ला यहूदा के राजमहल म पहरेदार के अंगना म बंदी बनाय गे रिहिस।<verse eid="JER 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 32:3" />यहूदा के राजा सिदकियाह ह ये कहिके ओला बंदी बनाय रिहिस, “तेंह अइसने अगमबानी काबर करथस? तेंह कहिथस, ‘यहोवा ह ये कहत हे: मेंह ये सहर ला बेबिलोन के राजा के हांथ म देवइया हंव, अऊ ओह येकर ऊपर कब्जा कर लीही। <verse eid="JER 32:3" /><verse number="4" style="v" sid="JER 32:4" />यहूदा के राजा सिदकियाह ह बेबिलोन के मनखेमन के हांथ ले नइं बचही, पर खचित ओला बेबिलोन के राजा के हांथ म दे दिये जाही, अऊ बेबिलोन के राजा ह ओकर संग आमने-सामने गोठियाही अऊ ओला अपन खुद के आंखी ले देखही। <verse eid="JER 32:4" /><verse number="5" style="v" sid="JER 32:5" />ओह सिदकियाह ला बेबिलोन ले जाही, जिहां ओह तब तक रहिही, जब तक कि मेंह ओकर सुधि नइं लूहूं, यहोवा ह घोसना करत हे। यदि तुमन बेबिलोन के मनखेमन ले लड़हू, त तुमन ओमन ला जीत नइं सकहू।’ ”<verse eid="JER 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 32:6" />यरमियाह ह कहिस, “यहोवा के बचन ह मोर करा आईस: <verse eid="JER 32:6" /><verse number="7" style="v" sid="JER 32:7" />देख, तोर कका सल्लूम के बेटा हनमेल तोर करा आही अऊ ये कहिही, ‘मोर जऊन खेत अनातोत नगर म हवय, ओला बिसा ले, काबरकि नजदीकी रिस्तेदार के रूप म येला बिसाय के अधिकार अऊ जिम्मेदारी तोर अय।’<verse eid="JER 32:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 32:8" />“तब यहोवा के कहे मुताबिक मोर कका के बेटा हनमेल ह पहरेदार के अंगना म मोर करा आईस अऊ कहिस, ‘मोर जऊन खेत बिनयामीन के देस के अनातोत म हवय, ओला बिसा ले, काबरकि येला छुड़ाय अऊ येकर ऊपर कब्जा करे के अधिकार तोर अय, एकरसेति येला अपन बर बिसा ले।’</para>
  <para style="p" vid="JER 32:8">“मेंह जानत रहेंव कि येह यहोवा के बचन रिहिस; <verse eid="JER 32:8" /><verse number="9" style="v" sid="JER 32:9" />एकरसेति मेंह ओ अनातोत म के खेत ला अपन चचेरा-भाई हनमेल ले बिसा लेंव अऊ ओकर कीमत के रूप म ओला चांदी के सतरह सेकेल<note caller="+" style="f"><char style="fr" closed="false">32:9 </char><char style="ft" closed="false">लगभग 200 ग्राम</char></note> तऊलके दे देंव। <verse eid="JER 32:9" /><verse number="10" style="v" sid="JER 32:10" />मेंह ओ खेत के खरीदीनामा म दसखत करके मुहर लगांय; गवाहमन के दसखत करवांय, अऊ चांदी ला तराजू म तऊलके ओला दे देंव। <verse eid="JER 32:10" /><verse number="11" style="v" sid="JER 32:11" />तब मेंह खरीदीनामा के ओ कागज ला लेंव, जेमा नियम अऊ सर्त लिखाय रिहिन अऊ मुहर लगे रिहिस अऊ संग म ओला घलो लेंव, जेमा मुहर नइं लगे रिहिस— <verse eid="JER 32:11" /><verse number="12" style="v" sid="JER 32:12" />अऊ ये कागजमन ला अपन चचेरा-भाई हनमेल अऊ ओ गवाह, जेमन कागज म दसखत करे रिहिन अऊ ओ जम्मो यहूदी, जेमन पहरेदार के अंगना म बईठे रिहिन, ओ जम्मो के आघू म महसेयाह के पोता, नेरियाह के बेटा बारूक ला सऊंप देंव।<verse eid="JER 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 32:13" />“ओ जम्मो के आघू म मेंह बारूक ला ये निरदेस देंव: <verse eid="JER 32:13" /><verse number="14" style="v" sid="JER 32:14" />‘सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: खरीदीनामा के मुहर लगे अऊ मुहर नइं लगे—ये दूनों कागजमन ला ले अऊ माटी के बरतन म रख, ताकि येमन बहुंत समय तक सही-सलामत रहंय। <verse eid="JER 32:14" /><verse number="15" style="v" sid="JER 32:15" />काबरकि सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: ये देस म घर, खेत अऊ अंगूर के बारीमन फेर बिसाय जाहीं।’<verse eid="JER 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 32:16" />“खरीदीनामा के कागजमन ला नेरियाह के बेटा बारूक ला देय के बाद, मेंह यहोवा ले ये पराथना करेंव:<verse eid="JER 32:16" /></para>
  <para style="pm">
    <verse number="17" style="v" sid="JER 32:17" />“हे परमपरधान यहोवा, तेंह अपन बड़े सामर्थ अऊ बढ़ाय भुजा के दुवारा अकास अऊ धरती ला बनाय हस। तोर बर कोनो भी काम कठिन नो हय। <verse eid="JER 32:17" /><verse number="18" style="v" sid="JER 32:18" />तेंह हजारों मनखे ला अपन मया देखाथस, पर दाई-ददामन के पाप के दंड ओमन के बाद ओमन के लइकामन ला घलो देथस। महान अऊ सक्तिमान परमेसर, जेकर नांव सर्वसक्तिमान यहोवा अय, <verse eid="JER 32:18" /><verse number="19" style="v" sid="JER 32:19" />तोर उदेस्यमन महान अंय अऊ तोर काममन बड़े अंय। तोर आंखीमन मानव-जाति के चालचलन ऊपर लगे रहिथे; तेंह हर एक मनखे ला ओकर चालचलन अऊ ओकर करम के मुताबिक ईनाम देथस। <verse eid="JER 32:19" /><verse number="20" style="v" sid="JER 32:20" />तेंह मिसर देस म चिनहां अऊ चमतकार देखाय अऊ आज तक इसरायल म अऊ जम्मो मानव-जाति के बीच म चिनहां अऊ चमतकार देखावत हस, अऊ तोर कीरति आज तक फईले हवय। <verse eid="JER 32:20" /><verse number="21" style="v" sid="JER 32:21" />तेंह अपन मनखे इसरायलीमन ला चिनहां अऊ चमतकार के संग, एक सक्तिसाली हांथ अऊ बढ़े भुजा के दुवारा अऊ बड़े आतंक के संग मिसर देस ले निकाल लानय। <verse eid="JER 32:21" /><verse number="22" style="v" sid="JER 32:22" />तेंह ये देस ओमन ला देय, जेला देय के किरिया तेंह ओमन के पुरखामन के संग खाय रहय, एक देस जिहां दूध अऊ मंधरस के धारा बहथे। <verse eid="JER 32:22" /><verse number="23" style="v" sid="JER 32:23" />ओमन आईन अऊ येला अपन अधिकार म ले लीन, पर ओमन तोर बात नइं मानिन या तोर कानून के मुताबिक नइं चलिन; ओमन ओ काम नइं करिन, जेला करे के हुकूम तेंह ओमन ला दे रहय। एकरसेति तेंह ओमन ऊपर ये जम्मो बिपत्ति लानय।<verse eid="JER 32:23" /></para>
  <para style="pm">
    <verse number="24" style="v" sid="JER 32:24" />“देख, सहर ऊपर कब्जा करे बर कइसे घेराबंदी के ढलानमन बनाय गे हवंय। तलवार, अकाल अऊ महामारी के कारन, सहर ला बेबिलोन के ओ मनखेमन के हांथ म दे दिये जाही, जऊन मन हमला करत हवंय। जऊन बात तेंह कहे रहय, ओह होवत हे, जइसे कि तेंह देखत हस। <verse eid="JER 32:24" /><verse number="25" style="v" sid="JER 32:25" />अऊ हालाकि सहर ला बेबिलोन के मनखेमन के हांथ म दे दिये जाही, तभो ले, हे परमपरधान यहोवा, तेंह मोला कहिथस, ‘चांदी देके खेत ला बिसा ले अऊ कागज म गवाहमन के दसखत लेय ले।’ ”<verse eid="JER 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 32:26" />तब यहोवा के ये बचन यरमियाह करा आईस: <verse eid="JER 32:26" /><verse number="27" style="v" sid="JER 32:27" />“मेंह जम्मो मानव-जाति के परमेसर, यहोवा अंव। का कोनो घलो काम मोर बर बहुंत कठिन अय? <verse eid="JER 32:27" /><verse number="28" style="v" sid="JER 32:28" />एकरसेति यहोवा ह ये कहत हे: मेंह ये सहर ला बेबिलोन के मनखे अऊ बेबिलोन के राजा नबूकदनेसर के हांथ म देवइया हंव, जऊन ह येमा कब्जा कर लीही। <verse eid="JER 32:28" /><verse number="29" style="v" sid="JER 32:29" />बेबिलोन के जऊन मनखेमन ये सहर ऊपर हमला करत हवंय, ओमन ये सहर म आहीं अऊ येमा आगी लगा दीहीं; ओमन सहर ला अऊ सहर के ओ घरमन ला जला दीहीं, जिहां मनखेमन छानी म बाल देवता बर धूप जलाके अऊ आने देवतामन बर पेय-बलिदान चढ़ाके मोर गुस्सा ला भड़काय हवंय।<verse eid="JER 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 32:30" />“इसरायल अऊ यहूदा के मनखेमन अपन जवानी के समय ले मोर नजर म सिरिप दुस्टता के काम करे हवंय; वास्तव म, इसरायल के मनखेमन अपन हांथ ले बनाय चीजमन के दुवारा मोर गुस्सा ला भड़काय के छोंड़ अऊ कुछू नइं करे हवंय, यहोवा ह घोसना करत हे। <verse eid="JER 32:30" /><verse number="31" style="v" sid="JER 32:31" />जऊन दिन ये सहर बसाय गीस, तब ले लेके आज तक, ये सहर ह मोर गुस्सा अऊ कोप ला भड़काय के काम करे हवय, एकरसेति मेंह येला अपन आघू ले हटा दूहूं। <verse eid="JER 32:31" /><verse number="32" style="v" sid="JER 32:32" />इसरायल अऊ यहूदा के मनखेमन ओमन के राजा अऊ करमचारीमन, ओमन के पुरोहित अऊ अगमजानीमन, यहूदा के मनखे अऊ यरूसलेम म रहइया मनखे, जम्मो के जम्मो दुस्टता के काम करके मोर गुस्सा ला भड़काय हवंय। <verse eid="JER 32:32" /><verse number="33" style="v" sid="JER 32:33" />ओमन मोर कोति अपन मुहूं नइं, पर अपन पीठ ला कर दे हवंय; हालाकि मेंह ओमन ला बार-बार सिखांय, पर ओमन मोर बात ला नइं सुनिन या ओकर मुताबिक नइं चलिन। <verse eid="JER 32:33" /><verse number="34" style="v" sid="JER 32:34" />ओ घर जऊन ह मोर कहाथे, ओमा ओमन अपन बेकार के मूरतीमन ला मढ़ाईन अऊ मोर घर ला असुध करिन। <verse eid="JER 32:34" /><verse number="35" style="v" sid="JER 32:35" />ओमन अपन बेटा अऊ बेटीमन ला मोलेक देवता ला बलिदान करे बर बेन-हिन्नोम के घाटी म बाल देवता बर ऊंच-ऊंच जगहमन ला बनाईन, हालाकि येकर हुकूम मेंह कभू नइं देय रहेंव—अऊ न ही ये बात कभू मोर मन म आईस—कि ओमन अइसने घिनौना काम करंय अऊ ये किसम ले यहूदी मनखेमन ले पाप करावंय।<verse eid="JER 32:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 32:36" />“तेंह ये सहर के बारे म कहत हस, ‘तलवार, अकाल अऊ महामारी के दुवारा येला बेबिलोन के राजा के हांथ म दे दिये जाही’; पर यहोवा, इसरायल के परमेसर ह ये कहत हे: <verse eid="JER 32:36" /><verse number="37" style="v" sid="JER 32:37" />खचित, मेंह ओमन ला ओ जम्मो देस ले इकट्ठा करहूं, जिहां मेंह अपन बहुंत गुस्सा अऊ भयंकर कोप के कारन ओमन ला निकाल दे रहेंव; मेंह ओमन ला ये जगह म लहुंटाके ले आहूं अऊ ओमन निडर होके रहिहीं। <verse eid="JER 32:37" /><verse number="38" style="v" sid="JER 32:38" />ओमन मोर मनखे होहीं, अऊ मेंह ओमन के परमेसर होहूं। <verse eid="JER 32:38" /><verse number="39" style="v" sid="JER 32:39" />मेंह ओमन ला एक ही मन अऊ एक ही चालचलन दूहूं, ताकि ओमन हमेसा मोर भय मानंय अऊ ओमन के जिनगी अऊ ओमन के बाद ओमन के लइकामन के जिनगी घलो सही-सलामत बितय। <verse eid="JER 32:39" /><verse number="40" style="v" sid="JER 32:40" />मेंह ओमन के संग सदा बने रहइया एक करार करहूं; मेंह ओमन के भलई करई कभू नइं छोंड़हूं, अऊ मेंह ओमन ला मोर भय माने बर उत्साहित करहूं, ताकि ओमन कभू मोर ले अलग झन होवंय। <verse eid="JER 32:40" /><verse number="41" style="v" sid="JER 32:41" />मेंह ओमन के भलई करके आनंदित होहूं, अऊ सही म, मेंह अपन पूरा मन अऊ आतमा सहित ओमन ला ये देस म बसाहूं।<verse eid="JER 32:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JER 32:42" />“यहोवा ह ये कहत हे: जइसने मेंह ये मनखेमन ऊपर ये जम्मो बड़े बिपत्ति लाने हवंव, वइसने ही मेंह ओमन ला ओ जम्मो खुसी दूहूं, जेकर वायदा मेंह ओमन ले करे रहेंव। <verse eid="JER 32:42" /><verse number="43" style="v" sid="JER 32:43" />एक बार फेर ये देस के भुइयां के दसा ह सुधरही, जेकर बारे म तुमन कहिथव, ‘येह बिगर मनखे या पसु के एक उजाड़ भुइयां ए, काबरकि येला बेबिलोन के मनखेमन के हांथ म दे दिये गे हवय।’ <verse eid="JER 32:43" /><verse number="44" style="v" sid="JER 32:44" />बिनयामीन के इलाका म, यरूसलेम के चारों कोति के गांवमन म, यहूदा के नगरमन म अऊ पहाड़ी देस, पछिम के खाल्हे के देस अऊ नेगेव के नगरमन म खेतमन ला चांदी देके फेर बिसाय जाही, अऊ लेन-देन के कागज म दसखत करे जाही, ओमा मुहर लगाय जाही अऊ गवाहमन होहीं, काबरकि मेंह ओमन के दिन ला बदलहूं, यहोवा ह घोसना करत हे।”<verse eid="JER 32:44" /></para>
  <chapter eid="JER 32" />
  <chapter number="33" style="c" sid="JER 33" />
  <para style="s1">पहिली के दसा म लाय के वायदा</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 33:1" />जब यरमियाह ह पहरेदार के अंगना म बंद रिहिस, त यहोवा के बचन दूसर बार ओकर मेर आईस: <verse eid="JER 33:1" /><verse number="2" style="v" sid="JER 33:2" />“जऊन ह धरती ला बनाईस, यहोवा जऊन ह येला रूप दीस अऊ येला इस्थिर करिस—ओकर नांव यहोवा अय; ओह ये कहत हे: <verse eid="JER 33:2" /><verse number="3" style="v" sid="JER 33:3" />‘मोर ले पराथना कर अऊ मेंह तोला जबाब दूहूं अऊ तोला बड़े-बड़े अऊ कठिन बात बताहूं, जेमन ला तेंह नइं जानस।’ <verse eid="JER 33:3" /><verse number="4" style="v" sid="JER 33:4" />ये सहर के घर अऊ यहूदा के राजमहलमन एकरसेति गिराय गे हवंय ताकि बेबिलोन के मनखेमन के संग लड़ई म, येमन के उपयोग सैनिकमन के घेरा अऊ तलवार के बिरूध करे जा सकय; ये घर अऊ राजमहलमन के बारे म यहोवा, इसरायल के परमेसर ह ये कहत हे: <verse eid="JER 33:4" /><verse number="5" style="v" sid="JER 33:5" />‘मेंह अपन गुस्सा अऊ कोप म आके ये सहर के मनखेमन ला मारहूं, अऊ सहर ह मनखेमन के लास ले भर जाही। काबरकि ये सहर के मनखेमन के दुस्टता के कारन, मेंह ये सहर ले अपन मुहूं ला फेर लूहूं।<verse eid="JER 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 33:6" />“ ‘तभो ले, मेंह ये सहर के ईलाज करहूं अऊ येमा चंगई लानहूं; मेंह अपन मनखेमन ला चंगा करहूं अऊ ओमन अपार सांति अऊ सुरकछा के आनंद उठाहीं। <verse eid="JER 33:6" /><verse number="7" style="v" sid="JER 33:7" />मेंह यहूदा अऊ इसरायल के मनखेमन ला बंधुवई ले वापिस लानहूं अऊ ओमन ला पहिले के सहीं फेर बसा दूहूं। <verse eid="JER 33:7" /><verse number="8" style="v" sid="JER 33:8" />ओमन जतेक पाप मोर बिरूध करे हवंय, ओ जम्मो पाप ले मेंह ओमन ला सुध करहूं अऊ मोर बिरूध म करे गे बिदरोह के ओमन के जम्मो पाप ला छेमा करहूं। <verse eid="JER 33:8" /><verse number="9" style="v" sid="JER 33:9" />तब धरती के देसमन, ये सहर बर करे गे मोर भलई के काम के बारे म सुनहीं अऊ मेंह ओ जम्मो देस के आघू म ये सहर म खियाती, आनंद, परसंसा अऊ आदर लानहूं; अऊ जऊन बढ़ती अऊ सांति मेंह ये सहर ला दूहूं, ओला देखके ओ देस के मनखेमन डरहीं अऊ डर के मारे कांपहीं।’<verse eid="JER 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 33:10" />“यहोवा ह ये कहत हे: ‘तेंह ये जगह के बारे म कहिथस, “येह बिगर मनखे या पसु के एक उजाड़ जगह अय।” हालाकि यहूदा देस के नगर अऊ यरूसलेम के गलीमन सुनसान पड़े हवंय, अऊ येमा न तो कोनो मनखे अऊ न ही कोनो पसु रहत हें, तभो ले उहां एक बार फेर <verse eid="JER 33:10" /><verse number="11" style="v" sid="JER 33:11" />आनंद अऊ खुसी के अवाज, दूल्हा अऊ दुलहिन के अवाज, अऊ जऊन मन यहोवा के घर म धनबाद के बलिदान लानथें, ओमन के अवाज ये कहत सुनई दीही,</para>
  <para style="q1" vid="JER 33:11">“सर्वसक्तिमान यहोवा ला धनबाद देवव,</para>
  <para style="q2" vid="JER 33:11">काबरकि यहोवा ह बने अय;</para>
  <para style="q2" vid="JER 33:11">ओकर मया सदाकाल तक बने रहिथे।”</para>
  <para style="m" vid="JER 33:11">काबरकि मेंह ये देस के दसा ला पहिले के सहीं बने कर दूहूं, यहोवा ह कहत हे।<verse eid="JER 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 33:12" />“सर्वसक्तिमान यहोवा ह ये कहत हे: ‘ये जगह, जऊन ह उजाड़ अऊ बिगर मनखे या पसु के हवय—येकर जम्मो नगर म चरवाहामन के भेड़-बकरी के झुंड बर अराम करे के फेर चरागनमन होहीं। <verse eid="JER 33:12" /><verse number="13" style="v" sid="JER 33:13" />पहाड़ी देस, पछिम के खाल्हे पहाड़ी देस अऊ नेगेव के नगरमन म, बिनयामीन के इलाका म, यरूसलेम के चारों कोति के गांवमन म अऊ यहूदा के नगरमन म भेड़-बकरी के झुंडमन फेर ओकर करा आहीं, जऊन ह ओमन के गनती करथे,’ यहोवा ह कहत हे।<verse eid="JER 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 33:14" />“ ‘ओ दिनमन आवत हें,’ यहोवा ह घोसना करत हे, ‘जब मेंह इसरायल अऊ यहूदा के मनखेमन ले करे गे बने वायदा ला पूरा करहूं।<verse eid="JER 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 33:15" />“ ‘ओ दिनमन म अऊ ओ बेरा म</para>
  <para style="q2" vid="JER 33:15">मेंह दाऊद के बंस म एक धरमी डंगाल<note caller="+" style="f"><char style="fr" closed="false">33:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">संतान</char></note> के पीका ला ठाढ़ करहूं;</para>
  <para style="q2" vid="JER 33:15">ओह ये देस म नियाय के काम अऊ सही काम करही।<verse eid="JER 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 33:16" />ओ दिनमन म यहूदा के मनखेमन ला बंचाय जाही</para>
  <para style="q2" vid="JER 33:16">अऊ यरूसलेम के मनखेमन सुरकछित बसे रहिहीं।</para>
  <para style="q1" vid="JER 33:16">ओला ये नांव के दुवारा पुकारे जाही:</para>
  <para style="q2" vid="JER 33:16">यहोवा हमर धरमी उद्धारकर्ता।’<verse eid="JER 33:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="JER 33:17" />काबरकि यहोवा ह ये कहत हे: ‘दाऊद के बंस म ले इसरायल के सिंघासन म बईठनेवाला हर समय कोनो न कोनो होहीं, <verse eid="JER 33:17" /><verse number="18" style="v" sid="JER 33:18" />अऊ लेवीय पुरोहितमन के बंस म ले मोर आघू म होम-बलिदान, अन्न-बलिदान अऊ आने बलिदान चघाय बर हर समय कोनो न कोनो होहीं।’ ”<verse eid="JER 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 33:19" />यहोवा के ये बचन यरमियाह मेर आईस: <verse eid="JER 33:19" /><verse number="20" style="v" sid="JER 33:20" />“यहोवा ह ये कहत हे: ‘मेंह दिन अऊ रात के बारे म करार करे हंव; यदि तुमन ये करार ला टोर दे हव, ताकि दिन अऊ रात अपन ठहिराय समय म झन होवंय, <verse eid="JER 33:20" /><verse number="21" style="v" sid="JER 33:21" />त फेर मोर सेवक दाऊद के संग करे मोर करार—अऊ मोर आघू म सेवा करइया लेवी पुरोहितमन के संग करे मोर करार ला टोरे जा सकत हे अऊ दाऊद ले ओकर सिंघासन म राज-करइया फेर ओकर कोनो संतान नइं होहीं। <verse eid="JER 33:21" /><verse number="22" style="v" sid="JER 33:22" />जइसने अकास के तारामन ला गने नइं जा सकय अऊ न ही समुंदर तीर के बालू ला नापे जा सकय, वइसने ही मेंह अपन सेवक दाऊद के संतान अऊ मोर आघू म सेवा करइया ओ लेवीमन ला बढ़ाहूं कि ओमन गने नइं जा सकहीं।’ ”<verse eid="JER 33:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 33:23" />यहोवा के ये बचन यरमियाह मेर आईस: <verse eid="JER 33:23" /><verse number="24" style="v" sid="JER 33:24" />“का तेंह धियान नइं देय कि ये मनखेमन का कहत हवंय, ‘जऊन दू ठन राज<note caller="+" style="f"><char style="fr" closed="false">33:24 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">दू ठन परिवार, याने कि इसरायल अऊ यहूदा</char></note> ला यहोवा ह चुने रिहिस, ओ दूनों राज ला ओह अब तियाग दे हवय’? एकरसेति ओमन मोर मनखेमन ला तुछ समझथें अऊ ओमन के एक जाति के रूप म आदर नइं करंय। <verse eid="JER 33:24" /><verse number="25" style="v" sid="JER 33:25" />यहोवा ह ये कहत हे: ‘यदि दिन अऊ रात के बारे म मेंह अपन करार नइं करे हंव अऊ अकास अऊ धरती के नियममन ला मेंह नइं ठहिराय हंव, <verse eid="JER 33:25" /><verse number="26" style="v" sid="JER 33:26" />तब मेंह याकूब के संतानमन ला अऊ मोर सेवक दाऊद ला तियाग दूहूं अऊ ओकर कोनो बेटा ला अब्राहम, इसहाक अऊ याकूब के संतानमन ऊपर राज करे बर नइं चुनहूं। पर मेंह ओमन के तकदीर ला फेर बदलहूं अऊ ओमन ऊपर दया देखाहूं।’ ”<verse eid="JER 33:26" /></para>
  <chapter eid="JER 33" />
  <chapter number="34" style="c" sid="JER 34" />
  <para style="s1">सिदकियाह ला चेतउनी</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 34:1" />जब बेबिलोन के राजा नबूकदनेसर अऊ ओकर जम्मो सेना अऊ ओ जम्मो राज अऊ मनखे, जेमन ऊपर ओह सासन करत रिहिस, ओ जम्मो के जम्मो यरूसलेम अऊ येकर चारों कोति के नगरमन ले लड़त रिहिन, त यहोवा के ये बचन यरमियाह मेर आईस: <verse eid="JER 34:1" /><verse number="2" style="v" sid="JER 34:2" />“यहोवा, इसरायल के परमेसर ह ये कहत हे: यहूदा के राजा सिदकियाह करा जा अऊ ओला कह, ‘यहोवा ह ये कहत हे: मेंह ये सहर ला बेबिलोन के राजा के हांथ म देनेचवाला हंव, अऊ ओह येला जला दीही। <verse eid="JER 34:2" /><verse number="3" style="v" sid="JER 34:3" />तेंह ओकर हांथ ले नइं बच सकस पर येह पक्का ए कि तेंह पकड़े जाबे अऊ तोला ओकर हांथ म कर दिये जाही। तेंह खुद अपन आंखी ले बेबिलोन के राजा ला देखबे, अऊ ओह तोर ले आमने-सामने गोठियाही। अऊ तेंह बंधुवई म बेबिलोन जाबे।<verse eid="JER 34:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 34:4" />“ ‘तभो ले, हे यहूदा के राजा सिदकियाह, यहोवा ह जऊन वायदा तोर ले करत हे, ओला सुन। यहोवा ह तोर बारे म ये कहत हे: तेंह तलवार ले मारे नइं जावस। <verse eid="JER 34:4" /><verse number="5" style="v" sid="JER 34:5" />तेंह सांति से मरबे। अऊ जइसने मनखेमन तोर पहिले सासन करइया राजामन के आदर म ओमन के चिता म आगी बारे रिहिन, वइसने ही मनखेमन तोर आदर म आगी बारहीं अऊ ये कहिके सोक मनाहीं, “हाय हे मोर मालिक!” मेंह खुद ये वायदा करत हंव, यहोवा ह घोसना करत हे।’ ”<verse eid="JER 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 34:6" />तब यरमियाह अगमजानी ह ये जम्मो बात यहूदा के राजा सिदकियाह ला यरूसलेम म ओ बेरा कहिस, <verse eid="JER 34:6" /><verse number="7" style="v" sid="JER 34:7" />जब बेबिलोन के राजा के सेना ह यरूसलेम ले अऊ यहूदा के आने बांचे सहर—लाकीस अऊ अजेका ले लड़त रिहिस। यहूदा प्रदेस म सिरिप ये दूनों ही गढ़वाले सहर बांचे रिहिन।<verse eid="JER 34:7" /></para>
  <para style="s1">गुलाममन बर सुतंतरता</para>
  <para style="p">
    <verse number="8" style="v" sid="JER 34:8" />यहोवा के ये बचन यरमियाह करा ओ बेरा आईस, जब सिदकियाह राजा ह यरूसलेम म जम्मो मनखेमन संग ये करार कर लीस कि गुलाममन ला सुतंतर करे के घोसना करे जावय। <verse eid="JER 34:8" /><verse number="9" style="v" sid="JER 34:9" />हर एक जन अपन-अपन इबरानी गुलाम, चाहे आदमी हो या माईलोगन दूनों ला सुतंतर कर देवय; अपन कोनो इबरानी संगी ला बंधुवा के रूप म नइं रखना हे। <verse eid="JER 34:9" /><verse number="10" style="v" sid="JER 34:10" />तब जम्मो करमचारी अऊ मनखेमन ये करार ऊपर सहमती देखाईन कि ओमन अपन-अपन गुलाम, चाहे आदमी हो या माईलोगन दूनों ला सुतंतर कर दीहीं अऊ ओमन ला फेर बंधुवा के रूप म नइं रखहीं। ओमन राजी होईन, अऊ ओमन ला सुतंतर कर दीन। <verse eid="JER 34:10" /><verse number="11" style="v" sid="JER 34:11" />पर येकर बाद ओमन मुकर गीन अऊ जऊन गुलाममन ला ओमन सुतंतर कर दे रिहिन, ओमन ला वापिस लेके फेर गुलाम बना लीन।<verse eid="JER 34:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 34:12" />तब यहोवा के ये बचन यरमियाह मेर आईस: <verse eid="JER 34:12" /><verse number="13" style="v" sid="JER 34:13" />“यहोवा, इसरायल के परमेसर ह ये कहत हे: जब मेंह तुम्हर पुरखामन ला गुलामी के देस याने कि मिसर देस ले निकालके लानेंव, त मेंह ओमन के संग ये कहिके एक करार करेंव, <verse eid="JER 34:13" /><verse number="14" style="v" sid="JER 34:14" />‘हर सातवां साल म, तुमन ओ संगी इबरीमन ला सुतंतर कर देवव, जऊन मन अपनआप ला तुम्हर हांथ म बेच दे हवंय। जब ओमन तुम्हर छै साल तक सेवा कर लेथें, त तुमन ओमन ला सुतंतर करके जावन देवव।’<note caller="+" style="f"><char style="fr" closed="false">34:14 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 15:12">ब्यव 15:12</ref></char></char></note> पर तुम्हर पुरखामन मोर बात ला नइं सुनिन या मोर बात ला धियान नइं दीन। <verse eid="JER 34:14" /><verse number="15" style="v" sid="JER 34:15" />हाल ही म, तुमन पछताप करे रहेव अऊ ओ काम ला करेव, जऊन ह मोर नजर म बने अय: तुमन ले हर एक जन अपन खुद के मनखेमन के सुतंतरता के घोसना करेव। अऊ त अऊ जऊन घर ला मोर कहे जाथे, ओ घर म मोर आघू म तुमन एक करार घलो करेव। <verse eid="JER 34:15" /><verse number="16" style="v" sid="JER 34:16" />पर अब तुमन ओ बात ले मुकर गे हव अऊ मोर नांव ला अपबितर करे हव; तुमन ले हर एक जन ओ नर अऊ नारी गुलाममन ला वापिस लेय ले हव, जेमन ला तुमन सुतंतर कर दे रहेव कि ओमन अपन-अपन ईछा के मुताबिक जिहां चाहंय, उहां जावंय। तुमन ओमन ला फेर तुम्हर गुलाम बने बर दबाव डाले हवव।<verse eid="JER 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 34:17" />“एकरसेति यहोवा ह ये कहत हे: तुमन मोर बात नइं माने हव; तुमन अपन खुद के मनखेमन के सुतंतरता के घोसना नइं करे हव, एकरसेति मेंह अब तुम्हर बर ‘सुतंतरता’ के घोसना करत हंव, यहोवा के ये बचन अय—अइसने ‘सुतंतरता’ कि तुमन तलवार, महामारी अऊ अकाल के सामना करहू। मेंह तुमन ला अइसने कर दूहूं कि धरती के जम्मो राजमन तुम्हर ले घिन करहीं। <verse eid="JER 34:17" /><verse number="18" style="v" sid="JER 34:18" />जऊन मनखेमन मोर करार ला टोर दे हवंय अऊ मोर आघू म करे गे करार के बात ला पूरा नइं करे हवंय, ओमन के संग, मेंह ओ बछरू सहीं बरताव करहूं, जेला मनखेमन दू भाग कर दीन अऊ तब ओकर दूनों कुटा के बीच म ले रेंगिन। <verse eid="JER 34:18" /><verse number="19" style="v" sid="JER 34:19" />यहूदा अऊ यरूसलेम के अगुवा, अदालत के करमचारी, पुरोहित अऊ देस के ओ जम्मो मनखे, जऊन मन बछरू के कुटा के बीच म ले रेंगिन, <verse eid="JER 34:19" /><verse number="20" style="v" sid="JER 34:20" />ओमन ला मेंह ओमन के बईरीमन के हांथ म कर दूहूं, जेमन ओमन ला मार डारे चाहत हें। ओमन के लासमन चिरई अऊ जंगली पसुमन के जेवन हो जाहीं।<verse eid="JER 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 34:21" />“मेंह यहूदा के राजा सिदकियाह अऊ ओकर करमचारीमन ला ओमन के बईरीमन के हांथ म कर दूहूं, जेमन ओमन ला मार डारे चाहत हें, याने कि मेंह ओमन ला बेबिलोन के ओ राजा के सेना के हांथ म कर दूहूं, जऊन ह तुम्हर करा ले हट गे हवय। <verse eid="JER 34:21" /><verse number="22" style="v" sid="JER 34:22" />यहोवा ह घोसना करत हे, मेंह हुकूम देवइया हंव अऊ मेंह ओमन ला ये सहर म वापिस ले आहूं। ओमन येकर बिरूध लड़हीं, अऊ येला लेके येमा आगी लगा दीहीं। अऊ मेंह यहूदा के नगरमन ला अइसने उजाड़ दूहूं कि उहां कोनो नइं रह सकहीं।”<verse eid="JER 34:22" /></para>
  <chapter eid="JER 34" />
  <chapter number="35" style="c" sid="JER 35" />
  <para style="s1">रेकाब के बंसज</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 35:1" />योसियाह के बेटा यहूदा के राजा यहोयाकीम के राज म यहोवा के ये बचन यरमियाह करा आईस: <verse eid="JER 35:1" /><verse number="2" style="v" sid="JER 35:2" />“रेकाबी परिवार म जा अऊ ओमन ला यहोवा के घर के बाजू के एक कमरा म आय बर नेवता दे अऊ ओमन ला पीये बर अंगूर के मंद दे।”<verse eid="JER 35:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 35:3" />तब मेंह हबसिनयाह के पोता यरमियाह के बेटा याजनयाह ला, अऊ ओकर भाईमन ला अऊ जम्मो बेटामन ला, याने कि रेकाबीमन के जम्मो परिवार ला बलाय बर गेंव। <verse eid="JER 35:3" /><verse number="4" style="v" sid="JER 35:4" />मेंह ओमन ला यहोवा के घर म, परमेसर के जन यिगदलयाह के बेटा हानान, जऊन ह परमेसर के एक जन रिहिस, ओकर बेटामन के कमरा म ले आनेंव। येह करमचारीमन के कमरा के बाजू म अऊ सल्लूम के बेटा, दुवारपाल मासेयाह के कमरा के ऊपर रिहिस। <verse eid="JER 35:4" /><verse number="5" style="v" sid="JER 35:5" />तब मेंह रेकाबीमन के आघू म अंगूर के मंद ले भरे घघरी अऊ कटोरामन ला रखके कहेंव, “थोरकन मंद पी लव।”<verse eid="JER 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 35:6" />पर ओमन कहिन, “हमन मंद नइं पीयन, काबरकि रेकाब के बेटा, हमर पुरखा यहोनादाब<note caller="+" style="f"><char style="fr" closed="false">35:6 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">योनादाब</char></note> ह हमन ला ये हुकूम देय रिहिस, ‘न तो तुमन अऊ न ही तुम्हर संतानमन कभू मंद पीहू। <verse eid="JER 35:6" /><verse number="7" style="v" sid="JER 35:7" />तुमन कभू घर घलो झन बनाहू, न बीज बोवव अऊ न ही अंगूर के बारी लगावव, तुम्हर करा ये चीजमन कभू झन होवय, पर तुमन हमेसा तम्बूमन म रहव। तब तुमन ओ देस म लम्बा समय तक रहन पाहू, जिहां तुमन घुमंतू जाति के रूप म रहत हवव।’ <verse eid="JER 35:7" /><verse number="8" style="v" sid="JER 35:8" />हमन रेकाब के बेटा हमर पुरखा यहोनादाब के ओ जम्मो बात ला माने हवन, जेकर हुकूम ओह देय रिहिस। न तो हमन, न ही हमर घरवाली अऊ न ही हमर बेटा-बेटीमन कभू मंद पीये हवन, <verse eid="JER 35:8" /><verse number="9" style="v" sid="JER 35:9" />अऊ न ही कभू घर बनाय हवन अऊ न ही अंगूर के बारी, खेत या अनाज बोये हवन। <verse eid="JER 35:9" /><verse number="10" style="v" sid="JER 35:10" />हमन तम्बूमन म रहे हवन अऊ हमन हमर पुरखा यहोनादाब के दिये हुकूम के हर एक बात ला माने हवन। <verse eid="JER 35:10" /><verse number="11" style="v" sid="JER 35:11" />पर जब बेबिलोन के राजा नबूकदनेसर ये देस ऊपर चढ़ई करिस, त हमन कहेंन, ‘आवव, बेबिलोनी<note caller="+" style="f"><char style="fr" closed="false">35:11 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदी</char></note> अऊ अरामीमन के सेना ले बांचे बर, हमन यरूसलेम जावन।’ ये खातिर हमन यरूसलेम म रहत हन।”<verse eid="JER 35:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 35:12" />तब यहोवा के बचन ये कहत यरमियाह मेर आईस: <verse eid="JER 35:12" /><verse number="13" style="v" sid="JER 35:13" />“सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: जा अऊ यहूदा देस के मनखे अऊ यरूसलेम सहर म रहइया मनखेमन ला कह, ‘का तुमन सबक नइं सीखहू अऊ मोर बात ला नइं मानहू?’ यहोवा ह घोसना करत हे। <verse eid="JER 35:13" /><verse number="14" style="v" sid="JER 35:14" />‘रेकाब के बेटा यहोनादाब ह अपन संतानमन ला हुकूम दीस कि ओमन मंद झन पीयंय अऊ ओमन ये हुकूम ला मानिन। आज तक ओमन मंद नइं पीयंय, काबरकि ओमन अपन पुरखा के हुकूम ला मानत हें; पर मेंह तुमन ला बार-बार कहे हंव, तभो ले तुमन मोर बात नइं माने हव। <verse eid="JER 35:14" /><verse number="15" style="v" sid="JER 35:15" />बार-बार मेंह अपन जम्मो सेवक अऊ अगमजानीमन ला तुम्हर करा पठोंय। ओमन कहिन, “तुमन ले हर एक जन अपन दुस्ट चालचलन ले फिरव, अऊ अपन चालचलन ला सुधारव; आने देवतामन के सेवा करे बर ओमन के पाछू झन जावव। तब तुमन ये देस म रहे बर पाहू, जेला मेंह तुमन अऊ तुम्हर पुरखामन ला देय हवंव।” पर तुमन मोर बात ला धियान नइं देव अऊ न ही मोर बात ला सुनेव। <verse eid="JER 35:15" /><verse number="16" style="v" sid="JER 35:16" />रेकाब के बेटा यहोनादाब के संतानमन अपन पुरखा के दिये हुकूम ला मानिन, पर ये मनखेमन मोर बात नइं मानिन।’<verse eid="JER 35:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 35:17" />“एकरसेति यहोवा सर्वसक्तिमान परमेसर, इसरायल के परमेसर ह ये कहत हे: ‘सुनव! यहूदा ऊपर अऊ यरूसलेम सहर म रहइया जम्मो मनखे ऊपर, मेंह ओ जम्मो बिपत्ति लानेवाला हंव, जेकर घोसना मेंह ओमन के बिरूध करे हवंव। काबरकि मेंह ओमन ले बात करेंव, पर ओमन नइं सुनिन; मेंह ओमन ला बलांय, पर ओमन जबाब नइं दीन।’ ”<verse eid="JER 35:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 35:18" />तब यरमियाह ह रेकाबीमन के परिवार ला कहिस, “सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: ‘तुमन अपन पुरखा यहोनादाब के हुकूम ला माने हव अऊ ओकर जम्मो निरदेस के पालन करे हव अऊ हर ओ काम करे हव, जेकर हुकूम ओह देय रिहिस।’ <verse eid="JER 35:18" /><verse number="19" style="v" sid="JER 35:19" />एकरसेति सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: ‘रेकाब के बेटा यहोनादाब के संतान म हमेसा कोनो न कोनो अइसने आदमी होही, जऊन ह मोर सेवा करही।’ ”<verse eid="JER 35:19" /></para>
  <chapter eid="JER 35" />
  <chapter number="36" style="c" sid="JER 36" />
  <para style="s1">यहोयाकीम ह यरमियाह के किताब ला जला देथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 36:1" />योसियाह के बेटा यहूदा के राजा यहोयाकीम के राज के चौथा साल म यहोवा के ये बचन यरमियाह मेर आईस: <verse eid="JER 36:1" /><verse number="2" style="v" sid="JER 36:2" />“चामपट्टी के एक खाली किताब ले अऊ इसरायल, यहूदा अऊ आने जम्मो जातिमन के बारे म, जतेक बात मेंह तोर ले योसियाह के राज के समय ले लेके आज तक कहे हवंव, ओ जम्मो ला ओ किताब म लिख ले। <verse eid="JER 36:2" /><verse number="3" style="v" sid="JER 36:3" />हो सकथे, जब यहूदा के मनखेमन ओ जम्मो बिपत्ति के बारे म सुनंय, जेला मेंह ओमन ऊपर लाने के योजना बनात हंव, त ओमन अपन खराप चालचलन ले मन फिरांय; तब मेंह ओमन के अधरम अऊ पाप ला छेमा करहूं।”<verse eid="JER 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 36:4" />एकरसेति यरमियाह ह नेरियाह के बेटा बारूक ला बलाईस, अऊ यरमियाह ह यहोवा के कहे जम्मो बात बारूक ला बतात गीस अऊ बारूक ह ओ बातमन ला ओ खाली किताब म लिख लीस। <verse eid="JER 36:4" /><verse number="5" style="v" sid="JER 36:5" />तब यरमियाह ह बारूक ला कहिस, “मोर ऊपर तो परतिबंध लगे हवय; मोला यहोवा के मंदिर म जाय के अनुमति नइं ए। <verse eid="JER 36:5" /><verse number="6" style="v" sid="JER 36:6" />एकरसेति एक उपास के दिन, तें यहोवा के घर म जा अऊ ये किताब म लिखे यहोवा के ओ बचन मनखेमन ला सुना, जेला तेंह मोर कहे मुताबिक लिखे हवस। यहूदा के ओ जम्मो मनखे, जऊन मन अपन-अपन नगर ले उहां आथें, ओमन ला ये किताब के बात ला पढ़के सुना। <verse eid="JER 36:6" /><verse number="7" style="v" sid="JER 36:7" />हो सकथे, ओमन यहोवा के आघू म बिनती करंय अऊ हर एक जन अपन-अपन खराप चालचलन ले मन फिरांय। काबरकि जऊन गुस्सा अऊ कोप के घोसना यहोवा ह ये मनखेमन के बिरूध म करे हवय, ओह बहुंत जादा अय।”<verse eid="JER 36:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 36:8" />नेरियाह के बेटा बारूक ह ओ जम्मो काम करिस, जेला यरमियाह अगमजानी ह ओला करे बर कहे रिहिस; यहोवा के मंदिर म, ओह ओ किताब म लिखे यहोवा के बचन ला पढ़के सुनाईस। <verse eid="JER 36:8" /><verse number="9" style="v" sid="JER 36:9" />योसियाह के बेटा यहूदा के राजा यहोयाकीम के राज के पांचवां साल के नौवां महिना म, यरूसलेम के जम्मो मनखे अऊ यहूदा के नगरमन ले आय मनखेमन बर यहोवा के आघू म उपास करे के घोसना करे गीस। <verse eid="JER 36:9" /><verse number="10" style="v" sid="JER 36:10" />सापान के बेटा गमरयाह ह सचिव रिहिस; ओकर कमरा ह मंदिर के नवां कपाट के प्रवेस दुवार करा ऊपर के अंगना म रिहिस; बारूक ह ओ कमरा ले यहोवा के मंदिर म जम्मो मनखेमन ला किताब म लिखे यरमियाह के बचन ला पढ़के सुनाईस।<verse eid="JER 36:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 36:11" />जब सापान के नाती, गमरयाह के बेटा मीकायाह ह किताब म लिखे यहोवा के जम्मो बचन ला सुनिस, <verse eid="JER 36:11" /><verse number="12" style="v" sid="JER 36:12" />त ओह राजमहल म खाल्हे सचिव के कमरा म गीस, जिहां जम्मो करमचारीमन बईठे रहंय: एलीसामा सचिव, समायाह के बेटा दलायाह, अकबोर के बेटा एलनातान, सापान के बेटा गमरयाह, हननयाह के बेटा सिदकियाह अऊ आने जम्मो करमचारी। <verse eid="JER 36:12" /><verse number="13" style="v" sid="JER 36:13" />मीकायाह ह ओ जम्मो बात ओमन ला बताईस, जेला ओह सुने रिहिस, जब बारूक ह किताब म ले पढ़के मनखेमन ला सुनाईस। <verse eid="JER 36:13" /><verse number="14" style="v" sid="JER 36:14" />ये बात ला सुनके, जम्मो करमचारीमन येहूदी ला, जऊन ह नतनयाह के बेटा, सेलेमियाह के पोता अऊ कूसी के परपोता रिहिस, बारूक करा ये कहे बर पठोईन, “जऊन किताब म ले तेंह मनखेमन ला पढ़के सुनाय हस, ओ किताब ला लेके आ जा।” एकरसेति नेरियाह के बेटा बारूक ह ओ किताब ला अपन हांथ म धरके ओमन करा आईस। <verse eid="JER 36:14" /><verse number="15" style="v" sid="JER 36:15" />तब ओमन ओला कहिन, “बईठ जा अऊ हमन ला ये किताब म ले पढ़के सुना।”</para>
  <para style="p" vid="JER 36:15">तब बारूक ह ओमन ला किताब ला पढ़के सुना दीस। <verse eid="JER 36:15" /><verse number="16" style="v" sid="JER 36:16" />जब ओमन ये जम्मो बात ला सुनिन, त ओमन डर म, एक-दूसर ला देखिन अऊ बारूक ला कहिन, “हमर बर जरूरी अय कि हमन ये जम्मो बात राजा ला बतावन।” <verse eid="JER 36:16" /><verse number="17" style="v" sid="JER 36:17" />तब ओमन बारूक ले पुछिन, “हमन ला बता कि तेंह ये जम्मो बात ला कइसे लिखय? का यरमियाह ह ये बातमन ला कहत गीस?”<verse eid="JER 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 36:18" />बारूक ह जबाब दीस, “हव, ओह ये जम्मो बात मोला कहत गीस, अऊ मेंह येला चाम के किताब म सियाही ले लिखत गेंव।”<verse eid="JER 36:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 36:19" />तब अधिकारीमन बारूक ला कहिन, “तें अऊ यरमियाह जावव अऊ छिप जावव। कोनो ला झन बतावव कि तुमन कहां हव।”<verse eid="JER 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 36:20" />तब अधिकारीमन चाम के किताब ला एलीसामा सचिव के कमरा म रख दीन अऊ राजा करा अंगना म जाके ओ जम्मो बात ओला बताईन। <verse eid="JER 36:20" /><verse number="21" style="v" sid="JER 36:21" />तब राजा ह येहूदी ला चाम के किताब लाने बर पठोईस, अऊ येहूदी ह किताब ला एलीसामा सचिव के कमरा ले लानिस अऊ ओला राजा अऊ ओकर बाजू म खड़े जम्मो अधिकारीमन ला पढ़के सुनाईस। <verse eid="JER 36:21" /><verse number="22" style="v" sid="JER 36:22" />येह नौवां महिना रिहिस अऊ राजा ह जड़काला के घर म बईठे रहय अऊ ओकर आघू म आगी तापे के चूल्हा बरत रहय। <verse eid="JER 36:22" /><verse number="23" style="v" sid="JER 36:23" />जब भी येहूदी ह तीन या चार पन्ना पढ़ डारय, त राजा ह ओ पन्नामन ला एक लेखक के चाकू ले काट देय अऊ ओमन ला आगी तापे के चूल्हा म फटिक देय; ओह तब तक अइसने करिस, जब तक कि जम्मो किताब ह चूल्हा के आगी म जर नइं गीस। <verse eid="JER 36:23" /><verse number="24" style="v" sid="JER 36:24" />पर राजा अऊ ओकर जम्मो सेवक, जऊन मन ये बात ला सुनिन, ओमन म न तो कोनो डर के बात दिखिस अऊ न ही ओमन दुखित होके अपन ओनहा ला चीरिन। <verse eid="JER 36:24" /><verse number="25" style="v" sid="JER 36:25" />हालाकि एलनातान, दलायाह अऊ गमरयाह, राजा ले बिनती करिन कि किताब ला झन जलावय, पर ओह ओमन के एको ठन बात नइं सुनिस। <verse eid="JER 36:25" /><verse number="26" style="v" sid="JER 36:26" />येकर उल्टा, राजा ह अपन एक बेटा यरहमेल अऊ अजरीएल के बेटा सरायाह अऊ अबदेल के बेटा सेलेमियाह ला हुकूम दीस कि ओमन बारूक लेखक अऊ यरमियाह अगमजानी ला बंदी बना लेवंय। पर यहोवा ह ओमन ला छिपा दे रिहिस।<verse eid="JER 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 36:27" />जब राजा ह ओ किताब ला जला दीस, जेमा बारूक ह यरमियाह के बताय बात ला लिखे रिहिस, तब यहोवा के ये बचन यरमियाह मेर आईस: <verse eid="JER 36:27" /><verse number="28" style="v" sid="JER 36:28" />“एक ठन अऊ चामपट्टी ले अऊ ओमा ओ जम्मो बात ला लिख, जऊन ह पहिली चाम के किताब म रिहिस अऊ जेला यहूदा के राजा यहोयाकीम ह जला दीस। <verse eid="JER 36:28" /><verse number="29" style="v" sid="JER 36:29" />अऊ यहूदा के राजा यहोयाकीम ला ये घलो कह, ‘यहोवा ह ये कहत हे: तेंह ओ किताब ला जला देय अऊ कहय, “तेंह ओमा काबर लिखे कि बेबिलोन के राजा जरूर आही अऊ ये देस ला नास कर दीही अऊ इहां ले मनखे अऊ पसु दूनों के नामोनिसान मिटा दीही?” <verse eid="JER 36:29" /><verse number="30" style="v" sid="JER 36:30" />एकरसेति यहोवा ह यहूदा के राजा यहोयाकीम के बारे म ये कहत हे: दाऊद के सिंघासन म बईठे बर ओकर कोनो संतान नइं होहीं; ओकर लास ला बाहिर अइसे फटिक दिये जाही कि ओह दिन के घाम अऊ रथिया के सीत म पड़े रहिही। <verse eid="JER 36:30" /><verse number="31" style="v" sid="JER 36:31" />मेंह ओला अऊ ओकर लइकामन ला अऊ ओकर सेवकमन ला ओमन के अधरम के सजा दूहूं; मेंह ओमन ऊपर अऊ यरूसलेम म रहइया मनखेमन ऊपर अऊ यहूदा के मनखेमन ऊपर ओ जम्मो बिपत्ति लानहूं, जेकर घोसना मेंह ओमन के बिरूध करे हवंव, काबरकि ओमन मोर बात ला नइं सुनिन।’ ”<verse eid="JER 36:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 36:32" />तब यरमियाह ह एक आने चाम के खाली किताब लीस अऊ ओला नेरियाह के बेटा बारूक लेखक ला दीस, अऊ यरमियाह के कहे मुताबिक बारूक ह येमा ओ पहिली चाम के किताब के जम्मो बात ला फेर लिखिस, जेला यहूदा के राजा यहोयाकीम ह आगी म जला दे रिहिस। अऊ येमा पहिले के सहीं अऊ कतको बातमन ला जोड़ दिये गीस।<verse eid="JER 36:32" /></para>
  <chapter eid="JER 36" />
  <chapter number="37" style="c" sid="JER 37" />
  <para style="s1">यरमियाह जेल म</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 37:1" />यहोयाकीम के बेटा यहोयाकीन के जगह म योसियाह के बेटा सिदकियाह ह राज करन लगिस, काबरकि बेबिलोन के राजा नबूकदनेसर ह सिदकियाह ला यहूदा देस के राजा बनाईस। <verse eid="JER 37:1" /><verse number="2" style="v" sid="JER 37:2" />पर न तो ओह, न ही ओकर करमचारीमन अऊ न ही देस के मनखेमन यहोवा के ओ बचन ऊपर धियान दीन, जेला ओह यरमियाह अगमजानी के जरिये कहे रिहिस।<verse eid="JER 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 37:3" />तभो ले, सिदकियाह राजा ह सेलेमियाह के बेटा यहूकल अऊ मासेयाह के बेटा सपनयाह पुरोहित ला यरमियाह अगमजानी करा ये कहे बर पठोईस, “यहोवा हमर परमेसर ले हमर बर पराथना कर।”<verse eid="JER 37:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 37:4" />ओ बेरा म यरमियाह ला जेल म नइं डारे गे रिहिस, अऊ ओह मनखेमन के बीच म बिगर रोक-टोक के आवत-जावत रिहिस। <verse eid="JER 37:4" /><verse number="5" style="v" sid="JER 37:5" />ओ समय फिरौन के सेना ह मिसर ले निकले रिहिस, अऊ बेबिलोन के सेना<note caller="+" style="f"><char style="fr" closed="false">37:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन </char><char style="ft" closed="false"><char style="xt" link-href="JER 37:8"><ref loc="JER 37:8">पद 8</ref></char>, <char style="xt" link-href="JER 37:9"><ref loc="JER 37:9">9</ref></char>, <char style="xt" link-href="JER 37:13"><ref loc="JER 37:13">13</ref></char> अऊ <char style="xt" link-href="JER 37:14"><ref loc="JER 37:14">14</ref></char> म घलो</char></note> ह यरूसलेम ला घेरत रिहिस, पर जब ओमन फिरौन के सेना के बारे म सुनिन, त ओमन यरूसलेम ले हट गीन।<verse eid="JER 37:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 37:6" />तब यहोवा के ये बचन यरमियाह अगमजानी मेर आईस: <verse eid="JER 37:6" /><verse number="7" style="v" sid="JER 37:7" />“यहोवा इसरायल के परमेसर ह ये कहत हे: यहूदा के राजा जऊन ह तोला मोर करा पठोय हे ओला कह, ‘फिरौन के जऊन सेना तोर मदद करे बर निकले हवय, ओह अपन देस मिसर ला वापिस चल दीही। <verse eid="JER 37:7" /><verse number="8" style="v" sid="JER 37:8" />तब बेबिलोन के मनखेमन वापिस आके ये सहर ऊपर हमला करहीं; ओमन येकर ऊपर कब्जा कर लीहीं अऊ येला जलाके फूंक दीहीं।’<verse eid="JER 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 37:9" />“यहोवा ह ये कहत हे: ये सोचके अपनआप ला धोखा झन देवव, ‘बेबिलोन के मनखेमन हमन ला जरूर छोंड़ दीहीं।’ पर ओमन नइं छोंड़ंय! <verse eid="JER 37:9" /><verse number="10" style="v" sid="JER 37:10" />अऊ त अऊ यदि तुमन बेबिलोन के ओ जम्मो सेना ला हरा घलो देथव, जऊन ह तुम्हर ऊपर हमला करत हे अऊ ओमन के सिरिप घायल मनखेमन ओमन के तम्बू म बांचे होहीं, त ओमन बाहिर निकलहीं अऊ ये सहर ला जलाके फूंक दीहीं।”<verse eid="JER 37:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 37:11" />जब बेबिलोन के सेना ह फिरौन के सेना के कारन यरूसलेम ले वापिस चल दीस, <verse eid="JER 37:11" /><verse number="12" style="v" sid="JER 37:12" />तब यरमियाह ह सहर ला छोंड़के बिनयामीन के राज म जाय बर निकलिस, ताकि ओह उहां मनखेमन के बीच म संपत्ति के अपन बांटा लेवय। <verse eid="JER 37:12" /><verse number="13" style="v" sid="JER 37:13" />पर जब ओह बिनयामीन दुवार करा हबरिस, त उहां इरियाह नांव के पहरेदारमन के मुखिया रिहिस, जऊन ह सेलेमियाह के बेटा अऊ हननयाह के पोता रिहिस; ओह यरमियाह अगमजानी ला बंदी बनाके कहिस, “तेंह बेबिलोन के मनखेमन करा जावत हस!”<verse eid="JER 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 37:14" />तब यरमियाह ह कहिस, “येह सच नो हय! मेंह बेबिलोन के मनखेमन करा नइं जावत हंव।” पर इरियाह ह ओकर बात ला बिसवास नइं करिस; अऊ ओह यरमियाह ला बंदी बनाके करमचारीमन करा ले आईस। <verse eid="JER 37:14" /><verse number="15" style="v" sid="JER 37:15" />ओमन यरमियाह ऊपर गुस्सा होईन अऊ ओला पीटवाके योनातन सचिव के ओ घर म बंदी बनाके डलवा दीन, जेला ओमन जेल बना दे रिहिन।<verse eid="JER 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 37:16" />यरमियाह ला तलघर के एक गुम्मट सहीं कमरा म रखे गीस, जिहां ओह बहुंत समय तक रिहिस। <verse eid="JER 37:16" /><verse number="17" style="v" sid="JER 37:17" />तब सिदकियाह राजा ह ओकर करा मनखे पठोके ओला महल म ले आईस अऊ ओला एकांत म पुछिस, “का यहोवा ले कोनो संदेस हवय?”</para>
  <para style="p" vid="JER 37:17">यरमियाह ह कहिस, “हव,” “तोला बेबिलोन के राजा के हांथ म सऊंप दिये जाही।”<verse eid="JER 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 37:18" />तब यरमियाह ह सिदकियाह राजा ला कहिस, “मेंह तोर या तोर करमचारीमन के या ये मनखेमन के बिरूध म का अपराध करे हंव कि तेंह मोला जेल म डाल दे हस? <verse eid="JER 37:18" /><verse number="19" style="v" sid="JER 37:19" />तोर ओ अगमजानीमन कहां हवंय, जऊन मन तोर ले ये अगमबानी करे रिहिन, ‘बेबिलोन के राजा ह तोर ऊपर या ये देस ऊपर हमला नइं करही’? <verse eid="JER 37:19" /><verse number="20" style="v" sid="JER 37:20" />पर अब, हे मोर मालिक, हे राजा, मोर बात ला सुन। मेंह तोर ले बिनती करत हंव: मोला योनातन सचिव के घर म वापिस झन भेज, नइं तो मेंह उहां मर जाहूं।”<verse eid="JER 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 37:21" />तब राजा सिदकियाह ह हुकूम दीस कि यरमियाह ला पहरेदार के अंगना म रखे जावय अऊ ओला हर दिन रोटीवालामन के गली ले एक रोटी तब तक दिये जावय, जब तक कि सहर के जम्मो रोटी सिरा नइं जावय। तब ले यरमियाह ह पहरेदार के अंगना म रहे लगिस।<verse eid="JER 37:21" /></para>
  <chapter eid="JER 37" />
  <chapter number="38" style="c" sid="JER 38" />
  <para style="s1">यरमियाह ला एक कुआं म डाल दिये जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 38:1" />एक दिन मतान के बेटा सपतयाह, पसहूर के बेटा गदलयाह, सेलेमियाह के बेटा यूकल अऊ मलकियाह के बेटा पसहूर, यरमियाह के ये बात ला सुनिन, जेला ओह जम्मो मनखेमन ला कहत रिहिस, <verse eid="JER 38:1" /><verse number="2" style="v" sid="JER 38:2" />“यहोवा ह ये कहत हे: ‘जऊन कोनो ये सहर म रहिही, ओह तलवार, अकाल या महामारी ले मारे जाही; पर जऊन ह बेबिलोन के मनखेमन करा जाही, ओह जीयत रहिही। ओकर परान ह बांच जाही, अऊ जीयत रहिही।’ <verse eid="JER 38:2" /><verse number="3" style="v" sid="JER 38:3" />अऊ यहोवा ह ये कहत हे: ‘खचित ये सहर ला बेबिलोन के राजा के सेना के हांथ म कर दिये जाही अऊ राजा ह येकर ऊपर कब्जा कर लीही।’ ”<verse eid="JER 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 38:4" />तब करमचारीमन राजा ले कहिन, “ये मनखे ला मार डालना चाही, काबरकि ये मनखे ह ये सहर म बांचे सैनिक अऊ जम्मो मनखेमन ला जऊन बात कहत हे, ओकर ले ओमन निरास होवत हें। ये मनखे ह मनखेमन के भलई नइं पर बुरई चाहत हे।”<verse eid="JER 38:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 38:5" />राजा सिदकियाह ह जबाब दीस, “ओह तुम्हर हांथ म हवय; राजा तुम्हर बिरोध म कुछू नइं करय।”<verse eid="JER 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 38:6" />एकरसेति ओमन यरमियाह ला लीन अऊ ओला राजा के बेटा मलकियाह के कुआं म डाल दीन, जऊन ह पहरेदार के अंगना म रहय। ओमन यरमियाह ला रस्सी के दुवारा कुआं म उतार दीन; ओ कुआं म पानी नइं रिहिस, सिरिप चीखला रिहिस, अऊ यरमियाह ह चीखला म बुड़े लगिस।<verse eid="JER 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 38:7" />पर एबेद-मेलेक, एक कूसी मनखे, जऊन ह राजमहल म एक करमचारी<note caller="+" style="f"><char style="fr" closed="false">38:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कोचिया </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">हिजड़ा</char></note> रिहिस, ये सुनिस कि ओमन यरमियाह ला कुआं म डाल दे हवंय। जब राजा ह बिनयामीन दुवार मेर बईठे रिहिस, <verse eid="JER 38:7" /><verse number="8" style="v" sid="JER 38:8" />त एबेद-मेलेक ह महल ले निकलके राजा करा गीस, अऊ ओला कहिस, <verse eid="JER 38:8" /><verse number="9" style="v" sid="JER 38:9" />“हे मोर मालिक, हे राजा, ओ मनखेमन यरमियाह अगमजानी के संग जऊन कुछू भी करे हवंय, बहुंत दुस्टता के काम करे हवंय। ओमन ओला एक कुआं म फटिक दे हवंय, जिहां ओह भूख के मारे मर जाही, काबरकि सहर म खाय बर कोनो रोटी नइं बचे हवय।”<verse eid="JER 38:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 38:10" />तब राजा ह एबेद-मेलेक कूसी ला हुकूम दीस, “इहां ले तीस मनखे अपन संग ले अऊ यरमियाह अगमजानी ला ओ कुआं ले निकाल ले, येकर पहिले कि ओह मर जावय।”<verse eid="JER 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 38:11" />एकरसेति एबेद-मेलेक मनखेमन ला अपन संग लीस अऊ महल म खजाना के खाल्हे एक कमरा म गीस। ओह उहां ले कुछू फटा-पुराना कपड़ा अऊ चेंदरी लीस अऊ ओमन ला रस्सीमन के दुवारा कुआं म यरमियाह करा उतार दीस। <verse eid="JER 38:11" /><verse number="12" style="v" sid="JER 38:12" />तब एबेद-मेलेक कूसी ह यरमियाह ले कहिस, “ये फटा-पुराना कपड़ा अऊ चेंदरीमन ला अपन खंखोरीमन म गद्दी के सहीं रस्सी के ऊपर रख ले।” यरमियाह ह वइसने करिस, <verse eid="JER 38:12" /><verse number="13" style="v" sid="JER 38:13" />अऊ ओमन यरमियाह ला रस्सी ले ऊपर खींचिन अऊ ओला कुआं ले बाहिर निकाल लीन। अऊ यरमियाह ह पहरेदार के अंगना म रहे लगिस।<verse eid="JER 38:13" /></para>
  <para style="s1">सिदकियाह ह फेर यरमियाह ले सवाल करथे</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 38:14" />तब राजा सिदकियाह ह यरमियाह अगमजानी ला बलाय बर मनखे पठोईस अऊ ओला यहोवा के मंदिर के तीसर प्रवेस दुवार करा लानके ओकर ले कहिस, “मेंह तोर ले कुछू पुछे चाहत हंव,” “मोर ले कोनो बात झन छुपाबे।”<verse eid="JER 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 38:15" />यरमियाह ह सिदकियाह ला कहिस, “यदि मेंह तोला कोनो जबाब दूहूं, त का तेंह मोला मार नइं डारबे? यदि मेंह तोला सलाह दूहूं घलो, तभो ले तेंह मोर बात ला नइं मानबे।”<verse eid="JER 38:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 38:16" />पर राजा सिदकियाह ह अकेला म यरमियाह ले ये कसम खाईस, “यहोवा, जऊन ह हमन ला सांस दे हवय, ओकर जिनगी के कसम, न तो मेंह तोला मरवा डालहूं अऊ न ही मेंह तोला ओ मनखेमन के हांथ म सऊंपहूं, जऊन मन तोला मार डाले चाहत हें।”<verse eid="JER 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 38:17" />तब यरमियाह ह सिदकियाह ले कहिस, “यहोवा सर्वसक्तिमान परमेसर, इसरायल के परमेसर ह ये कहत हे: ‘यदि तेंह अपनआप ला बेबिलोन के राजा के अधिकारीमन के हांथ म कर देबे, त तोर परान ह बच जाही अऊ ये सहर ला जलाय नइं जाही; अऊ तें अऊ तोर परिवार जीयत रहिही। <verse eid="JER 38:17" /><verse number="18" style="v" sid="JER 38:18" />पर कहूं तेंह अपनआप ला बेबिलोन के राजा के अधिकारीमन के हांथ म नइं करबे, त ये सहर ला बेबिलोन के मनखेमन के हांथ म कर दिये जाही अऊ ओमन येला जला दीहीं; अऊ तेंह खुद ओमन के हांथ ले बच नइं सकबे।’ ”<verse eid="JER 38:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 38:19" />राजा सिदकियाह ह यरमियाह ले कहिस, “जऊन यहूदी मनखेमन बेबिलोन के मनखेमन करा गे हवंय, ओमन ले मेंह डरावत हंव, काबरकि बेबिलोन के मनखेमन मोला ओमन के हांथ म दे सकत हें अऊ ओमन मोर ले गलत बरताव करहीं।”<verse eid="JER 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 38:20" />यरमियाह ह कहिस, “बेबिलोन के मनखेमन तोला ओमन के हांथ म नइं देवंय; जऊन कुछू मेंह तोर ले कहत हंव, वइसने करके यहोवा के बात ला मान। तब तोर भलई होही, अऊ तोर परान ह बच जाही। <verse eid="JER 38:20" /><verse number="21" style="v" sid="JER 38:21" />पर यदि तेंह अपनआप ला ओमन ला नइं सऊंपबे, त जऊन बात यहोवा ह मोला बताय हवय, ओह ये अय: <verse eid="JER 38:21" /><verse number="22" style="v" sid="JER 38:22" />यहूदा के राजा के महल म, जतेक माईलोगन बचे हवंय, ओमन ला बेबिलोन के राजा के करमचारीमन करा लाने जाही, अऊ ओ माईलोगनमन तोर ले कहिहीं:</para>
  <para style="q1" vid="JER 38:22">“ ‘तोर भरोसा के संगवारीमन</para>
  <para style="q2" vid="JER 38:22">तोला बहकाईन अऊ ओमन सफल होईन।</para>
  <para style="q1" vid="JER 38:22">तोर गोड़मन चीखला म धंस गीन;</para>
  <para style="q2" vid="JER 38:22">तोर संगवारीमन तोला छोंड़ दे हवंय।’<verse eid="JER 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 38:23" />“तोर जम्मो घरवाली अऊ लइकामन ला बेबिलोन के मनखेमन करा लाने जाही। तेंह खुद ओमन के हांथ ले नइं बांचबे अऊ तेंह बेबिलोन के राजा के दुवारा बंदी बना लिये जाबे; अऊ ये सहर ला जला दिये जाही।”<verse eid="JER 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 38:24" />तब सिदकियाह ह यरमियाह ला कहिस, “कोनो ला हमर ये बातचीत के बारे म झन बताबे, नइं तो तेंह मार डाले जाबे। <verse eid="JER 38:24" /><verse number="25" style="v" sid="JER 38:25" />यदि करमचारीमन ये पता पाथें कि मेंह तोर ले बातचीत करे हंव, अऊ ओमन तोर करा आके पुछथें, ‘हमन ला बता कि तेंह राजा ला का कहय अऊ राजा ह तोला का कहिस; हमन ले कोनो बात झन छिपा, नइं तो हमन तोला मार डालबो,’ <verse eid="JER 38:25" /><verse number="26" style="v" sid="JER 38:26" />तब तेंह ओमन ले कहिबे, ‘मेंह राजा ले बिनती करत रहेंव कि मोला योनातन के घर म मरे बर वापिस झन पठो।’ ”<verse eid="JER 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 38:27" />तब जम्मो करमचारीमन यरमियाह करा आईन अऊ ओकर ले पुछिन, अऊ जइसने राजा ह ओला हुकूम देय रिहिस, वइसने ही ओह ओमन ला जबाब दीस। एकरसेति ओमन ओला अऊ कुछू नइं कहिन, काबरकि राजा के संग ओकर बातचीत ला कोनो नइं सुने रिहिन।<verse eid="JER 38:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 38:28" />अऊ यरमियाह ह पहरेदार के अंगना म तब तक रिहिस, जब तक कि यरूसलेम सहर ऊपर कब्जा नइं कर लिये गीस।</para>
  <para style="s1" vid="JER 38:28">यरूसलेम के पतन</para>
  <para style="p" vid="JER 38:28">ये किसम ले यरूसलेम ला ले लिये गीस:<verse eid="JER 38:28" /></para>
  <chapter eid="JER 38" />
  <chapter number="39" style="c" sid="JER 39" />
  <para style="nb">
    <verse number="1" style="v" sid="JER 39:1" />यहूदा के राजा सिदकियाह के राज के नौवां साल के दसवां महिना म, बेबिलोन के राजा नबूकदनेसर ह अपन जम्मो सेना के संग यरूसलेम के बिरूध लड़ई करे बर निकलिस अऊ ओला घेर लीस। <verse eid="JER 39:1" /><verse number="2" style="v" sid="JER 39:2" />अऊ सिदकियाह के राज के गियारहवां साल के चौथा महिना के नौवां दिन सहर के दीवार ला टोर दिये गीस। <verse eid="JER 39:2" /><verse number="3" style="v" sid="JER 39:3" />तब बेबिलोन के जम्मो अधिकारी अऊ करमचारीमन आईन अऊ मांझा दुवार म अपन-अपन जगह म बईठ गीन। ओमा नेरगल-सरेसेर जऊन ह समगर के रिहिस, अऊ नबो-सरसकीम जऊन ह एक मुखिया अधिकारी रिहिस, नेरगल-सरेसेर जऊन ह एक उच्च अधिकारी रिहिस अऊ बेबिलोन के राजा के आने जम्मो करमचारीमन रिहिन। <verse eid="JER 39:3" /><verse number="4" style="v" sid="JER 39:4" />जब यहूदा के राजा सिदकियाह अऊ जम्मो सैनिकमन ओमन ला देखिन, त ओमन भाग गीन; ओमन रथियाच राजा के बारी के रद्दा ले, दूनों दीवार के बीच बने दुवार म ले होके सहर ले निकल गीन, अऊ अराबा<note caller="+" style="f"><char style="fr" closed="false">39:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरदन घाटी</char></note> के रसता ला धरिन।<verse eid="JER 39:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 39:5" />पर बेबिलोन के सेना ह ओमन के पीछा करिस अऊ सिदकियाह ला यरीहो के मैदान म पकड़ लीस। ओमन ओला बेबिलोन के राजा नबूकदनेसर करा हमात देस के रिबला सहर म ले गीन, जिहां ओह सिदकियाह ला सजा के हुकूम दीस। <verse eid="JER 39:5" /><verse number="6" style="v" sid="JER 39:6" />उहां रिबला म, बेबिलोन के राजा ह सिदकियाह के बेटामन ला ओकर आंखी के आघू म मार डारिस अऊ यहूदा के जम्मो परभावसाली मनखेमन ला घलो मार डारिस। <verse eid="JER 39:6" /><verse number="7" style="v" sid="JER 39:7" />तब ओह सिदकियाह के आंखी ला निकाल दीस अऊ ओला बेबिलोन ले जाय बर कांसा के बेड़ीमन म जकड़वा दीस।<verse eid="JER 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 39:8" />बेबिलोन के मनखेमन<note caller="+" style="f"><char style="fr" closed="false">39:8 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> राजमहल अऊ मनखेमन के घरमन म आगी लगाके जला दीन अऊ यरूसलेम के दीवार ला टोरके गिरा दीन। <verse eid="JER 39:8" /><verse number="9" style="v" sid="JER 39:9" />तब महाराजा के पहरेदारमन के सेनापति नबूजरदान ह सहर म बांचे मनखे अऊ जऊन मन ओकर करा भागके आ गे रिहिन ओमन ला, अऊ बाकि मनखेमन ला बंदी बनाके बेबिलोन ले गीस। <verse eid="JER 39:9" /><verse number="10" style="v" sid="JER 39:10" />पर अइसने गरीब मनखे, जेमन करा कुछू नइं रिहिस, ओमन ला पहरेदारमन के सेनापति नबूजरदान ह यहूदा देस म छोंड़ दीस; अऊ ओ बेरा, ओह ओमन ला अंगूर के बारी अऊ खेतमन ला दे दीस।<verse eid="JER 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 39:11" />बेबिलोन के राजा नबूकदनेसर ह महाराजा के पहरेदारमन के सेनापति नबूजरदान ला यरमियाह के बारे म ये हुकूम देय रिहिस: <verse eid="JER 39:11" /><verse number="12" style="v" sid="JER 39:12" />“ओला ले जा अऊ ओकर देखभाल कर; ओकर कुछू हानि झन करबे, पर जइसने ओह तोर ले कहिथे, वइसने ही ओकर संग बरताव करबे।” <verse eid="JER 39:12" /><verse number="13" style="v" sid="JER 39:13" />एकरसेति पहरेदारमन के सेनापति नबूजरदान, एक मुखिया अधिकारी नबूसजबान, एक उच्च अधिकारी नेरगल-सरेसेर अऊ बेबिलोन के राजा के आने जम्मो अधिकारीमन, <verse eid="JER 39:13" /><verse number="14" style="v" sid="JER 39:14" />मनखेमन ला पठोके यरमियाह ला पहरेदार के अंगना ले लेय आईन अऊ ओमन यरमियाह ला गदलयाह, जऊन ह अहीकाम के बेटा अऊ सापान के पोता रिहिस, ओकर हांथ म सऊंप दीन, ताकि ओह यरमियाह ला ओकर घर वापिस ले जावय। तब ओह अपन मनखेमन के बीच रहे लगिस।<verse eid="JER 39:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 39:15" />जब यरमियाह ह पहरेदार के अंगना म कैद रिहिस, तब यहोवा के ये बचन ओकर करा आईस: <verse eid="JER 39:15" /><verse number="16" style="v" sid="JER 39:16" />“जा अऊ एबेद-मेलेक कूसी<note caller="+" style="f"><char style="fr" closed="false">39:16 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">इथोपीयन</char></note> ले कह, ‘सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: मेंह ये सहर के बिरूध कहे मोर बात ला पूरा करनेवाला हंव—बिपत्ति के बात, उन्नति के नइं। ओ बेरा, ओमन तोर आंखी के आघू म पूरा होहीं। <verse eid="JER 39:16" /><verse number="17" style="v" sid="JER 39:17" />पर ओ बेरा, मेंह तोला बचाहूं, यहोवा ह घोसना करत हे; जऊन मनखेमन ले तेंह डरथस, ओमन के हांथ म तोला नइं सऊंपे जाही। <verse eid="JER 39:17" /><verse number="18" style="v" sid="JER 39:18" />मेंह तोला बचाहूं; तेंह तलवार ले नइं मारे जाबे पर तोर परान ह बच जाही, काबरकि तेंह मोर ऊपर भरोसा करे हस, यहोवा ह घोसना करत हे।’ ”<verse eid="JER 39:18" /></para>
  <chapter eid="JER 39" />
  <chapter number="40" style="c" sid="JER 40" />
  <para style="s1">यरमियाह ला छोंड़ दिये जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 40:1" />जब महाराजा के पहरेदारमन के सेनापति नबूजरदान ह यरमियाह ला यरूसलेम अऊ यहूदा के ओ जम्मो बंदीमन के बीच हथकड़ी म बंधे पाईस, जेमन ला बंधुवई म बेबिलोन लिये जावत रिहिस, त ओह यरमियाह ला रामा नगर म छोंड़ दीस। ओ समय यहोवा के बचन यरमियाह करा आईस। <verse eid="JER 40:1" /><verse number="2" style="v" sid="JER 40:2" />जब पहरेदारमन के सेनापति ला यरमियाह मिलिस, त ओह यरमियाह ला कहिस, “यहोवा तोर परमेसर ह ये जगह म ये बिपत्ति लाने के फैसला करे रिहिस। <verse eid="JER 40:2" /><verse number="3" style="v" sid="JER 40:3" />अऊ अब यहोवा ह ओ बिपत्ति ला लाने हवय; ओह वइसने ही करे हवय, जइसने कि ओह कहे रिहिस। ये जम्मो बात होईस, काबरकि तुमन यहोवा के बिरूध म पाप करेव अऊ ओकर हुकूम ला नइं मानेव। <verse eid="JER 40:3" /><verse number="4" style="v" sid="JER 40:4" />पर आज मेंह तोला तोर ये हथकड़ी ले सुतंतर करत हंव। यदि तोला बने लगे, त आ मोर संग बेबिलोन चल, अऊ मेंह तोर देखभाल करहूं; पर यदि तेंह नइं चाहत हस, त झन आ। देख, पूरा देस तोर आघू म पड़े हवय; जिहां भी तोला बने लगथे, उहां चले जा।” <verse eid="JER 40:4" /><verse number="5" style="v" sid="JER 40:5" />पर येकर पहिले कि यरमियाह ह जाय बर मुड़तिस, नबूजरदान ह ये घलो कहिस, “अहीकाम के बेटा अऊ सापान के पोता गदलयाह करा वापिस चले जा, जेला बेबिलोन के राजा ह यहूदा के नगरमन ऊपर अधिकारी ठहिराय हवय, अऊ ओकर संग मनखेमन के बीच म रह, या जिहां कहूं तोला बने लगथे, उहां चले जा।”</para>
  <para style="p" vid="JER 40:5">तब सेनापति ह ओला जेवन के सामान अऊ एक उपहार दीस अऊ ओला बिदा करिस। <verse eid="JER 40:5" /><verse number="6" style="v" sid="JER 40:6" />तब यरमियाह ह मिसपा म अहीकाम के बेटा गदलयाह करा गीस अऊ उहां ओकर संग ओ मनखेमन के बीच रहे लगिस, जेमन ला ओ देस म छोंड़ दिये गे रिहिस।<verse eid="JER 40:6" /></para>
  <para style="s1">गदलयाह ला मार डारे जाथे</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 40:7" />जब सेना के जम्मो अधिकारी अऊ ओमन के मनखे, जऊन मन अभी घलो खुला देहात म रहत रिहिन, ओमन सुनिन कि बेबिलोन के राजा ह अहीकाम के बेटा गदलयाह ला देस के राजपाल ठहिराय हवय अऊ ओला ओ आदमी, माईलोगन अऊ लइकामन ऊपर अधिकारी ठहिराय गे हवय, जऊन मन देस म सबले गरीब अंय अऊ जेमन ला बंधुवा के रूप म बेबिलोन नइं ले जाय गीस, <verse eid="JER 40:7" /><verse number="8" style="v" sid="JER 40:8" />त ओमन मिसपा म गदलयाह करा आईन—ओमा नतनयाह के बेटा इसमायल, कारेह के बेटा योहानान अऊ योनातन, तनहूमेत के बेटा सरायाह, नतोपाती एपै के बेटामन, अऊ माकाती के बेटा याजनयाह, अऊ ओमन के मनखेमन रिहिन। <verse eid="JER 40:8" /><verse number="9" style="v" sid="JER 40:9" />अहीकाम के बेटा अऊ सापान के पोता गदलयाह ह ओमन अऊ ओमन के मनखेमन ला बिसवास दिलाय बर कसम खाके कहिस, “बेबिलोन के मनखेमन के सेवा करे बर झन डरव; देस म बस जावव अऊ बेबिलोन के राजा के सेवा करव, तब तुम्हर भलई होही। <verse eid="JER 40:9" /><verse number="10" style="v" sid="JER 40:10" />मेंह खुद मिसपा म रहिके ओ बेबिलोन के मनखेमन के आघू म तुम्हर बात रखहूं, जऊन मन हमर इहां आहीं; पर तुमन अंगूर के मंद, घाम महिना के फर अऊ जैतून तेल के फसल उपजावव, अऊ ओमन ला संकेलके अपन बरतनमन म रखव, अऊ जऊन नगरमन ला तुमन लेय ले हव, ओमा बसे रहव।”<verse eid="JER 40:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 40:11" />जब मोआब, अमोन, एदोम अऊ आने जम्मो देस म रहइया जम्मो झन सुनिन कि बेबिलोन के राजा ह यहूदा म कुछू मनखेमन ला छोंड़ दे हवय अऊ ओमन ऊपर अहीकाम के बेटा अऊ सापान के पोता गदलयाह ला राजपाल ठहिराय हवय, <verse eid="JER 40:11" /><verse number="12" style="v" sid="JER 40:12" />त तितिर-बितिर होके रहइया ओ जम्मो देस ले जम्मो यहूदीमन लहुंटके यहूदा देस के मिसपा नगर म गदलयाह करा आईन। अऊ अब्बड़ अकन अंगूर के मंद अऊ घाम महिना के फर उपजाईन।<verse eid="JER 40:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 40:13" />तब कारेह के बेटा योहानान अऊ अभी घलो खुला देहात म रहइया जम्मो सेना के अधिकारीमन मिसपा म गदलयाह करा आईन <verse eid="JER 40:13" /><verse number="14" style="v" sid="JER 40:14" />अऊ ओला कहिन, “का तेंह नइं जानत हस कि अमोनीमन के राजा बालीस ह नतनयाह के बेटा इसमायल ला तोला मार डारे बर पठोय हवय?” पर अहीकाम के बेटा गदलयाह ह ओमन के बात के बिसवास नइं करिस।<verse eid="JER 40:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 40:15" />तब कारेह के बेटा योहानान ह गदलयाह ला मिसपा म चुपेचाप कहिस, “मोला जाके नतनयाह के बेटा इसमायल ला मार डारन दे, अऊ कोनो ये बात ला नइं जानही। ओह काबर तोर परान लेवय अऊ तोर चारों कोति जूरे जम्मो यहूदीमन तितिर-बितिर हो जावंय अऊ यहूदा के बांचे मनखेमन काबर नास हो जावंय?”<verse eid="JER 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 40:16" />पर अहीकाम के बेटा गदलयाह ह कारेह के बेटा योहानान ला कहिस, “अइसने काम झन कर! तेंह जऊन बात, इसमायल के बारे म कहत हस, ओह सच नो हय।”<verse eid="JER 40:16" /></para>
  <chapter eid="JER 40" />
  <chapter number="41" style="c" sid="JER 41" />
  <para style="p">
    <verse number="1" style="v" sid="JER 41:1" />ओ साल के सातवां महिना म अइसने होईस कि नतनयाह के बेटा अऊ एलीसामा के पोता इसमायल, जऊन ह राजबंस के रिहिस अऊ राजा के अधिकारीमन ले एक झन रिहिस; ओह दस झन मनखे ला संग म लेके अहीकाम के बेटा गदलयाह करा मिसपा म आईस। जब ओमन उहां एक संग जेवन करत रिहिन, <verse eid="JER 41:1" /><verse number="2" style="v" sid="JER 41:2" />तब नतनयाह के बेटा इसमायल अऊ ओकर संग के दस झन उठिन अऊ अहीकाम के बेटा अऊ सापान के पोता गदलयाह ला तलवार ले मार डारिन, जेला बेबिलोन के राजा ह देस के राजपाल ठहिराय रिहिस। <verse eid="JER 41:2" /><verse number="3" style="v" sid="JER 41:3" />इसमायल ह गदलयाह के संग जतेक यहूदी मिसपा म रिहिन, ओ जम्मो ला मार डारिस, संगे-संग ओह बेबिलोन के ओ सैनिकमन ला घलो मार डारिस, जऊन मन उहां रिहिन।<verse eid="JER 41:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 41:4" />गदलयाह के मार डारे जाय के दूसर दिन, ये बात ला कोनो मनखे के जाने के पहिली, <verse eid="JER 41:4" /><verse number="5" style="v" sid="JER 41:5" />सकेम, सीलो अऊ सामरिया सहर ले अस्सी मनखे दाढ़ी मुड़ाके, अपन कपड़ा चीरके अऊ अपन देहें म चोट लगाके संग म अन्न-बलिदान अऊ धूप लेके यहोवा के घर म आईन। <verse eid="JER 41:5" /><verse number="6" style="v" sid="JER 41:6" />तब नतनयाह के बेटा इसमायल ह ओमन ले मिले बर मिसपा ले बाहिर निकलिस, अऊ ओह जावत बेरा रोवत रिहिस। जब ओह ओमन ले मिलिस, त कहिस, “अहीकाम के बेटा गदलयाह करा चलव।” <verse eid="JER 41:6" /><verse number="7" style="v" sid="JER 41:7" />जब ओमन नगर म आईन, त नतनयाह के बेटा इसमायल अऊ ओकर संग के मनखेमन ओमन ला मार डारिन अऊ ओमन ला एक कुआं म फटिक दीन। <verse eid="JER 41:7" /><verse number="8" style="v" sid="JER 41:8" />पर ओमन ले बांचे दस झन इसमायल ला कहिन, “हमर हतिया झन कर! हमर करा गहूं, जौ, जैतून तेल अऊ मंधरस हवय, जेला हमन एक ठन खेत म छिपा दे हन।” एकरसेति इसमायल ह ओमन ला छोंड़ दीस अऊ आने मन के संग ओमन ला नइं मारिस। <verse eid="JER 41:8" /><verse number="9" style="v" sid="JER 41:9" />जऊन कुआं म इसमायल ह मनखेमन ला मारके ओमन के जम्मो लास अऊ संग म गदलयाह के लास ला घलो फटिक देय रिहिस, ओ कुआं ला राजा आसा ह इसरायल के राजा बासा के बिरूध सुरकछा के एक भाग के रूप म खनवाय रिहिस। ओ कुआं ला नतनयाह के बेटा इसमायल ह लासमन ले भर दीस।<verse eid="JER 41:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 41:10" />तब इसमायल ह मिसपा म बांचे जम्मो मनखेमन ला बंदी बना लीस—ओमा राजा के बेटीमन अऊ उहां छोंड़ दिये गय ओ जम्मो मनखे रिहिन, जेमन के ऊपर महाराजा के पहरेदारमन के सेनापति नबूजरदान ह अहीकाम के बेटा गदलयाह ला राजपाल ठहिराय रिहिस। ओ जम्मो ला नतनयाह के बेटा इसमायल ह बंदी बना लीस अऊ अमोनीमन करा जाय बर निकलिस।<verse eid="JER 41:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 41:11" />जब कारेह के बेटा योहानान अऊ ओकर संग के सेना के जम्मो अधिकारीमन नतनयाह के बेटा इसमायल के जम्मो अपराध के बारे म सुनिन, <verse eid="JER 41:11" /><verse number="12" style="v" sid="JER 41:12" />त ओमन अपन जम्मो मनखेमन ला लीन अऊ नतनयाह के बेटा इसमायल ले लड़े बर गीन। अऊ ओमन ओला गिबोन के बड़े तरिया करा पाईन। <verse eid="JER 41:12" /><verse number="13" style="v" sid="JER 41:13" />जब कारेह के बेटा योहानान अऊ ओकर संग के सेना के जम्मो अधिकारीमन ला, इसमायल के संग के जम्मो मनखेमन देखिन, त ओमन खुस होईन। <verse eid="JER 41:13" /><verse number="14" style="v" sid="JER 41:14" />ओ जम्मो मनखे, जेमन ला इसमायल ह मिसपा ले बंदी बनाके लानत रिहिस, ओ जम्मो झन पलटके कारेह के बेटा योहानान करा चल दीन। <verse eid="JER 41:14" /><verse number="15" style="v" sid="JER 41:15" />पर नतनयाह के बेटा इसमायल अऊ ओकर आठ झन मनखे योहानान के हांथ ले बांचके अमोनीमन करा भाग गीन।<verse eid="JER 41:15" /></para>
  <para style="s1">मिसर देस भगई</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 41:16" />तब कारेह के बेटा योहानान अऊ ओकर संग के सेना के जम्मो अधिकारीमन मिसपा के बांचे ओ जम्मो मनखेमन ला लेके चल दीन, जेमन ला योहानान ह नतनयाह के बेटा इसमायल के हांथ ले बंचाय रिहिस, जब इसमायल ह अहीकाम के बेटा गदलयाह के हतिया कर दे रिहिस—ओमा गिबोन म बंचाय सैनिक, माईलोगन, लइका अऊ अदालत के करमचारीमन रिहिन। <verse eid="JER 41:16" /><verse number="17" style="v" sid="JER 41:17" />ओमन मिसर देस जाय बर चलत गीन, पर ओमन बेबिलोनीमन ले बचे बर बैतलहम के लकठा म गेरूत-किमहाम करा रूक गीन। <verse eid="JER 41:17" /><verse number="18" style="v" sid="JER 41:18" />ओमन बेबिलोन के मनखेमन ले डरत रिहिन, काबरकि नतनयाह के बेटा इसमायल ह अहीकाम के बेटा गदलयाह ला मार डारे रिहिस, जेला बेबिलोन के राजा ह देस के ऊपर राजपाल ठहिराय रिहिस।<verse eid="JER 41:18" /></para>
  <chapter eid="JER 41" />
  <chapter number="42" style="c" sid="JER 42" />
  <para style="p">
    <verse number="1" style="v" sid="JER 42:1" />तब कारेह के बेटा योहानान, होसायाह के बेटा याजनयाह अऊ आने जम्मो सैनिक अधिकारीमन, अऊ छोटे ले लेके बड़े परभावसाली जम्मो मनखेमन <verse eid="JER 42:1" /><verse number="2" style="v" sid="JER 42:2" />यरमियाह अगमजानी करा आके ओला कहिन, “हमर बिनती ला सुन अऊ यहोवा अपन परमेसर ले ये जम्मो बांचे मनखेमन बर पराथना कर। काबरकि जइसे कि अब तेंह देखत हस, हालाकि एक समय म हमन अब्बड़ झन रहेंन, पर अब थोरकन झन बांचे हन। <verse eid="JER 42:2" /><verse number="3" style="v" sid="JER 42:3" />पराथना कर कि यहोवा तोर परमेसर ह हमन ला बतावय कि हमन कहां जावन अऊ का करन?”<verse eid="JER 42:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 42:4" />यरमियाह अगमजानी ह ओमन ला कहिस, “मेंह तुम्हर बात ला सुन ले हंव; तुम्हर बिनती के मुताबिक जरूर, मेंह यहोवा तुम्हर परमेसर ले पराथना करहूं; अऊ जऊन कुछू भी यहोवा ह कहिथे, ओ जम्मो बात मेंह तुमन ला बताहूं अऊ मेंह तुमन ले कोनो बात नइं छुपावंव।”<verse eid="JER 42:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 42:5" />तब ओमन यरमियाह ले कहिन, “यदि यहोवा तोर परमेसर ह तोर दुवारा हमन ला कुछू कहिथे अऊ हमन ओकर मुताबिक नइं करबो, त यहोवा ह हमर बिरूध सच्चा अऊ बिसवासयोग्य गवाह ठहिरय। <verse eid="JER 42:5" /><verse number="6" style="v" sid="JER 42:6" />चाहे ओह हमर हित म होवय या अहित म, हमन यहोवा हमर परमेसर के बात ला मानबो, जेकर करा हमन तोला पठोवत हन, ताकि हमर संग भलई होवय, काबरकि हमन यहोवा हमर परमेसर के बात ला मानबो।”<verse eid="JER 42:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 42:7" />दस दिन के बाद, यहोवा के बचन यरमियाह करा आईस। <verse eid="JER 42:7" /><verse number="8" style="v" sid="JER 42:8" />तब ओह कारेह के बेटा योहानान अऊ ओकर संग के आने जम्मो सैनिक अधिकारी अऊ छोटे ले लेके बड़े जम्मो मनखेमन ला एक संग बलाईस, <verse eid="JER 42:8" /><verse number="9" style="v" sid="JER 42:9" />अऊ ओह ओमन ला कहिस, “यहोवा, इसरायल के परमेसर, जेकर करा तुमन मोला अपन बिनती करे बर पठोय रहेव, ओह ये कहत हे: <verse eid="JER 42:9" /><verse number="10" style="v" sid="JER 42:10" />‘यदि तुमन ये देस म रहिहू, त मेंह तुमन ला बनाहूं, नास नइं करंव, तुमन ला बसाहूं, उसालंव नइं, काबरकि जऊन बिपत्ति मेंह तुम्हर ऊपर लाने हवंव, ओकर बारे म मेंह नरम पड़त हंव। <verse eid="JER 42:10" /><verse number="11" style="v" sid="JER 42:11" />बेबिलोन के राजा ले तुमन झन डरव, जेकर ले अभी तुमन डरत हव। ओकर ले झन डरव, यहोवा ह घोसना करत हे, काबरकि मेंह तुम्हर संग हवंव अऊ तुमन ला बचाहूं अऊ तुमन ला ओकर हांथ ले छोंड़ाहू। <verse eid="JER 42:11" /><verse number="12" style="v" sid="JER 42:12" />मेंह तुम्हर ऊपर दया करहूं, त ओह घलो तुम्हर ऊपर दया करही अऊ तुमन ला तुम्हर देस म फेर बसा दीही।’<verse eid="JER 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 42:13" />“तभो ले यदि तुमन ये कहव, ‘हमन ये देस म नइं रहन,’ अऊ ये किसम ले यहोवा अपन परमेसर के बात ला नइं मानव, <verse eid="JER 42:13" /><verse number="14" style="v" sid="JER 42:14" />अऊ यदि तुमन कहव, ‘नइं, हमन तो मिसर देस जाके उहां रहिबो, जिहां हमन न तो लड़ई देखबो, न ही तुरही के अवाज सुनबो अऊ न ही हमन ला जेवन के कमी होही,’ <verse eid="JER 42:14" /><verse number="15" style="v" sid="JER 42:15" />त फेर हे बांचे यहूदीमन, यहोवा के बचन ला सुनव। सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: ‘यदि तुमन मिसर देस जाय बर ठान ले हव अऊ उहां जाके रहे बर चाहत हव, <verse eid="JER 42:15" /><verse number="16" style="v" sid="JER 42:16" />त फेर अइसने होही कि जऊन तलवार ले तुमन डरत हव, ओही ह उहां तुम्हर ऊपर आ जाही, अऊ जऊन अकाल के डर तुमन ला हवय, ओह मिसर म तुम्हर पीछा नइं छोंड़ही, अऊ उहां तुमन मर जाहू। <verse eid="JER 42:16" /><verse number="17" style="v" sid="JER 42:17" />वास्तव म, ओ जम्मो मनखे, जऊन मन मिसर देस जाके उहां रहे के ठान ले हवंय, ओमन तलवार, अकाल अऊ महामारी ले मरहीं; जऊन बिपत्ति मेंह ओमन ऊपर लानहूं, ओमा ले एको झन घलो नइं बांचहीं।’ <verse eid="JER 42:17" /><verse number="18" style="v" sid="JER 42:18" />सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: ‘जइसने मोर गुस्सा अऊ कोप ह ओमन ऊपर भड़किस, जऊन मन यरूसलेम म रहत रिहिन, वइसने ही मोर कोप ह तुमन ऊपर भड़कही, जऊन मन मिसर देस जाहू। तुमन एक सराप के पात्र, बहुंत घिन करे के, एक सराप के पात्र अऊ निन्दा करे के चीज होहू; तुमन ये जगह ला फेर कभू नइं देखहू।’<verse eid="JER 42:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 42:19" />“हे यहूदा के बांचे मनखेमन, यहोवा ह तुमन ला कहे हवय, ‘मिसर देस झन जावव।’ येला जरूर जान लव: मेंह आज तुमन ला चेतावत हंव <verse eid="JER 42:19" /><verse number="20" style="v" sid="JER 42:20" />काबरकि तुमन एक बड़े गलती करेव, जब तुमन मोला ये कहिके यहोवा अपन परमेसर करा पठोय रहेव, ‘हमर बर यहोवा हमर परमेसर ले पराथना कर; अऊ जऊन कुछू ओह कहिथे, ओ जम्मो बात हमन ला बता अऊ हमन वइसने करबो।’ <verse eid="JER 42:20" /><verse number="21" style="v" sid="JER 42:21" />मेंह आज तुमन ला बता चुके हंव, पर जऊन कुछू यहोवा तुम्हर परमेसर ह तुमन ला कहे बर मोला पठोय हवय, ओला तुमन नइं माने हव। <verse eid="JER 42:21" /><verse number="22" style="v" sid="JER 42:22" />एकरसेति अब, तुमन ये जरूर जान लव: जऊन जगह म जाके तुमन रहे चाहत हव, उहां तुमन तलवार, अकाल अऊ महामारी ले मारे जाहू।”<verse eid="JER 42:22" /></para>
  <chapter eid="JER 42" />
  <chapter number="43" style="c" sid="JER 43" />
  <para style="p">
    <verse number="1" style="v" sid="JER 43:1" />जब यरमियाह ह मनखेमन ला ओमन के परमेसर यहोवा के ओ जम्मो बात कह चुकिस, जेला कहे बर यहोवा ह ओला ओमन करा पठोय रिहिस, <verse eid="JER 43:1" /><verse number="2" style="v" sid="JER 43:2" />तब होसायाह के बेटा अजरयाह अऊ कारेह के बेटा योहानान अऊ जम्मो घमंडी मनखेमन यरमियाह ला कहिन, “तेंह झूठ बोलत हस! यहोवा हमर परमेसर ह तोला ये कहे बर नइं पठोय हवय, ‘तुमन मिसर देस म रहे बर झन जावव।’ <verse eid="JER 43:2" /><verse number="3" style="v" sid="JER 43:3" />पर नेरियाह के बेटा बारूक ह तोला हमर बिरूध म उकसावत हे कि हमन बेबिलोन के मनखेमन के हांथ म कर दिये जावन, ताकि ओमन हमन ला मार डारंय या हमन ला बंदी बनाके बेबिलोन ले जावंय।”<verse eid="JER 43:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 43:4" />एकरसेति कारेह के बेटा योहानान अऊ सेना के जम्मो अधिकारी अऊ जम्मो मनखेमन यहोवा के ये हुकूम ला नइं मानिन कि ओमन यहूदा के देस म ही रहंय। <verse eid="JER 43:4" /><verse number="5" style="v" sid="JER 43:5" />येकर बदले कारेह के बेटा योहानान अऊ सेना के जम्मो अधिकारीमन यहूदा के बांचे ओ जम्मो मनखेमन ला ले गीन, जऊन मन पहिली आनजात के बीच म बगर गे रिहिन, पर बाद म लहुंटके आईन अऊ यहूदा देस म रहत रिहिन। <verse eid="JER 43:5" /><verse number="6" style="v" sid="JER 43:6" />ओमन ओ जम्मो मनखे, माईलोगन, लइका अऊ राजा के बेटीमन ला घलो ले गीन, जेमन ला महाराजा के पहरेदारमन के सेनापति नबूजरदान ह अहीकाम के बेटा अऊ सापान के पोता गदलयाह संग छोंड़ दे रिहिस। अऊ ओमन यरमियाह अगमजानी अऊ नेरियाह के बेटा बारूक ला घलो अपन संग म ले गीन, <verse eid="JER 43:6" /><verse number="7" style="v" sid="JER 43:7" />अऊ ओमन यहोवा के हुकूम ला नइं मानके मिसर देस म तहपनहेस नगर तक चल दीन।<verse eid="JER 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 43:8" />तब तहपनहेस म, यहोवा के ये बचन यरमियाह करा आईस: <verse eid="JER 43:8" /><verse number="9" style="v" sid="JER 43:9" />“यहूदीमन के देखत म, कुछू बड़े पथरामन ला ले अऊ ओ पथरामन ला ईंटा के बने पैदल चले के ओ रसता म माटी म गाड़ दे, जऊन ह तहपनहेस म फिरौन के महल के प्रवेस दुवार करा हवय, <verse eid="JER 43:9" /><verse number="10" style="v" sid="JER 43:10" />अऊ तब यहूदीमन ला कह, ‘सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: देखव, मेंह अपन सेवक बेबिलोन के राजा नबूकदनेसर ला बुलवाहूं, अऊ मेंह ओकर सिंघासन ला ये पथरामन के ऊपर म लगाहूं, जऊन ला मेंह इहां गाड़े हंव; अऊ ओह अपन राज-मंडप ला ओमन ऊपर तानही। <verse eid="JER 43:10" /><verse number="11" style="v" sid="JER 43:11" />ओह आही अऊ मिसर देस ऊपर हमला करही, अऊ जेमन ला मरना होही, ओमन मारे जाहीं, जेमन ला बंधुवई म जाना होही, ओमन बंधुवई म जाहीं, अऊ जेमन ला तलवार ले मरना होही, ओमन तलवार ले मारे जाहीं। <verse eid="JER 43:11" /><verse number="12" style="v" sid="JER 43:12" />ओह मिसर देस के देवतामन के मंदिर म आगी लगा दीही; ओह ओमन के मंदिरमन ला जला दीही अऊ ओमन के देवतामन ला बंधुवई म ले जाही। जइसने एक चरवाहा ह अपन ओनहा ला जूहां ले साफ करके धरथे, वइसने ही ओह मिसर देस ला साफ करके चले जाही। <verse eid="JER 43:12" /><verse number="13" style="v" sid="JER 43:13" />उहां मिसर देस के सूरज<note caller="+" style="f"><char style="fr" closed="false">43:13 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">हिलियापुलिस म</char></note> के मंदिर म, ओह पबितर खंभामन ला गिरा दीही अऊ मिसर के देवतामन के मंदिरमन म आगी लगाके जला दीही।’ ”<verse eid="JER 43:13" /></para>
  <chapter eid="JER 43" />
  <chapter number="44" style="c" sid="JER 44" />
  <para style="s1">मूरती-पूजा के कारन बिपत्ति</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 44:1" />मिसर देस के खाल्हे भाग—मिगदोल, तहपनहेस अऊ मेमफीस नगर—अऊ ऊपरी मिसर देस म जऊन यहूदीमन रहत रिहिन, ओ जम्मो के बारे म यरमियाह करा ये बचन आईस: <verse eid="JER 44:1" /><verse number="2" style="v" sid="JER 44:2" />“सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: तुमन ओ बड़े बिपत्ति ला देखेव, जेला मेंह यरूसलेम अऊ यहूदा के जम्मो नगरमन म लानेंव। आज ओमन निरजन अऊ खंडहर हो गे हवंय <verse eid="JER 44:2" /><verse number="3" style="v" sid="JER 44:3" />काबरकि ओमन दुस्टता के काम करिन। ओमन मोर गुस्सा भड़काय बर आने देवतामन के आघू म धूप जलाईन अऊ ओमन के अराधना करिन, जेमन ला न तो ओमन, न ही तुमन अऊ न ही तुम्हर पुरखामन जानत रिहिन। <verse eid="JER 44:3" /><verse number="4" style="v" sid="JER 44:4" />बार-बार मेंह अपन सेवक अगमजानीमन ला ये कहे बर ओमन करा पठोंय, ‘ये घिनित काम झन करव, जेकर ले मेंह घिन करथंव!’ <verse eid="JER 44:4" /><verse number="5" style="v" sid="JER 44:5" />पर ओमन नइं सुनिन अऊ धियान नइं दीन; ओमन अपन दुस्टता के काम ला नइं छोंड़िन या आने देवतामन के आघू म धूप जलाय बर बंद नइं करिन। <verse eid="JER 44:5" /><verse number="6" style="v" sid="JER 44:6" />ये खातिर मोर भयंकर कोरोध ह यहूदा के नगरमन म अऊ यरूसलेम के गलीमन म भड़किस अऊ ओमन ला उजाड़के नास कर दीस, जइसने कि ओमन आज हवंय।<verse eid="JER 44:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 44:7" />“अब यहोवा सर्वसक्तिमान परमेसर, इसरायल के परमेसर ह ये कहत हे: मनखे, माईलोगन, लइका अऊ दूध पीयत लइका, तुमन जम्मो के जम्मो यहूदा ले अलग होके काबर अइसने भयंकर बिपत्ति अपन ऊपर लानत हव, अऊ ये किसम ले तुम्हर कोनो बंस नइं बचही? <verse eid="JER 44:7" /><verse number="8" style="v" sid="JER 44:8" />मिसर देस, जिहां तुमन रहे बर आय हवव, काबर इहां तुमन अपन काम के दुवारा, याने कि आने देवतामन बर धूप जलाके मोर गुस्सा ला भड़कावत हव? तुमन अपनआप ला नास कर डारहू अऊ धरती म जम्मो जातिमन के बीच म अपनआप ला सरापित अऊ एक कलंक के पात्र बनाहू। <verse eid="JER 44:8" /><verse number="9" style="v" sid="JER 44:9" />का तुमन ओ दुस्टता के काममन ला भुला गे हव, जेला तुम्हर पुरखामन अऊ यहूदा के राजा अऊ रानीमन करे रिहिन, अऊ ओ दुस्टता के काम, जेला तुमन अऊ तुम्हर घरवालीमन यहूदा देस अऊ यरूसलेम के गलीमन म करत रिहिन? <verse eid="JER 44:9" /><verse number="10" style="v" sid="JER 44:10" />आज के दिन तक ओमन अपनआप ला नम्र नइं करे हवंय या आदर नइं देखावत हें, अऊ न ही ओमन ओ कानून अऊ बिधिमन ऊपर चलत हवंय, जेला मेंह तुम्हर अऊ तुम्हर पुरखामन बर ठहिराय हंव।<verse eid="JER 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 44:11" />“एकरसेति सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: मेंह ठान ले हंव कि मेंह तुम्हर ऊपर बिपत्ति लानहूं अऊ जम्मो यहूदा ला नास कर दूहूं। <verse eid="JER 44:11" /><verse number="12" style="v" sid="JER 44:12" />मेंह यहूदा के ओ बांचे मनखेमन ला ले लूहूं, जऊन मन मिसर देस जाके उहां रहे बर ठान ले रिहिन। ओ जम्मो झन मिसर देस म नास हो जाहीं; ओमन तलवार ले मारे जाहीं या फेर अकाल के कारन मर जाहीं। छोटे ले लेके बड़े तक, ओमन जम्मो के जम्मो तलवार या अकाल ले मारे जाहीं। ओमन सरापित अऊ बहुंत घिन के पात्र हो जाहीं, एक सराप अऊ कलंक के पात्र। <verse eid="JER 44:12" /><verse number="13" style="v" sid="JER 44:13" />जइसने मेंह यरूसलेम ला दंड देय रहेंव, वइसने ही मेंह ओमन ला तलवार, अकाल अऊ महामारी ले दंड दूहूं, जेमन मिसर देस म रहत हवंय। <verse eid="JER 44:13" /><verse number="14" style="v" sid="JER 44:14" />यहूदा के ओ बांचे मनखे, जऊन मन मिसर देस म रहे बर गे हवंय, ओमा के कोनो घलो यहूदा देस ला लहुंटे बर नइं बांचहीं, जिहां ओमन लहुंटके आके रहे के ईछा करथें; सिरिप कुछू भगोड़ामन के छोंड़ एको झन भी लहुंटन नइं पाहीं।”<verse eid="JER 44:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 44:15" />तब ओ जम्मो यहूदी, जऊन मन जानत रिहिन कि ओमन के घरवालीमन आने देवतामन बर धूप जलाथें, अऊ ओ जम्मो माईलोगन, जऊन मन उहां रिहिन—एक बड़े सभा—अऊ ओ जम्मो मनखे, जऊन मन खाल्हे अऊ ऊपरी मिसर म रहत रिहिन, ओ जम्मो यरमियाह ला कहिन, <verse eid="JER 44:15" /><verse number="16" style="v" sid="JER 44:16" />“जऊन बचन तेंह हमन ला यहोवा के नांव म कहे हवस, ओला हमन नइं सुनन! <verse eid="JER 44:16" /><verse number="17" style="v" sid="JER 44:17" />हमन ओ हर एक काम ला जरूर करबो, जेला हमन कहे हवन कि हमन करबो: हमन स्वरग के रानी नांव के देवी बर धूप जलाबो अऊ ओला पेय-बलिदान चघाबो जइसने कि हमन अऊ हमर पुरखामन, हमर राजामन अऊ हमर करमचारीमन यहूदा के नगरमन म अऊ यरूसलेम के गलीमन म करत रिहिन। ओ बेरा हमर करा बहुंत जेवन रिहिस अऊ बने रहत रहेंन अऊ हमर कुछू नुकसान नइं होवत रिहिस। <verse eid="JER 44:17" /><verse number="18" style="v" sid="JER 44:18" />पर जब ले हमन स्वरग के रानी बर धूप जलाना अऊ ओकर बर पेय-बलिदान चघाना बंद कर दे हवन, तब ले हमर करा कुछू नइं ए अऊ हमन तलवार अऊ अकाल ले नास होवत हन।”<verse eid="JER 44:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 44:19" />माईलोगनमन ये घलो कहिन, “जब हमन स्वरग के रानी बर धूप जलात रहेंन अऊ ओला पेय-बलिदान चघावत रहेंन, त का हमर घरवालामन के बिगर जानत हमन स्वरग के रानी के मूरती के परभाव म होके रोटी बनात रहेंन अऊ ओला पेय-बलिदान चघावत रहेंन?”<verse eid="JER 44:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 44:20" />तब यरमियाह ह आदमी अऊ माईलोगन, जऊन मन ओला जबाब देवत रिहिन, ओ जम्मो मनखे ला कहिस, <verse eid="JER 44:20" /><verse number="21" style="v" sid="JER 44:21" />“तुमन अऊ तुम्हर पुरखामन, तुम्हर राजामन अऊ तुम्हर करमचारीमन अऊ देस के मनखेमन यहूदा देस के नगरमन म अऊ यरूसलेम के गलीमन म जऊन धूप जलावत रिहिन, का ओला यहोवा ह सुरता नइं करिस अऊ ओ बात ह ओकर धियान म नइं आईस? <verse eid="JER 44:21" /><verse number="22" style="v" sid="JER 44:22" />जब यहोवा ह तुम्हर दुस्ट अऊ घिनित काममन ला सहन नइं कर सकिस, त तुम्हर देस ह सरापित हो गीस अऊ येह उजड़के निरजन हो गीस, जइसने कि येह आज हवय। <verse eid="JER 44:22" /><verse number="23" style="v" sid="JER 44:23" />काबरकि तुमन धूप जलाय हव अऊ यहोवा के बिरूध म पाप करे हव अऊ ओकर बात ला नइं माने हव या ओकर कानून या बिधि या ओकर सर्त के पालन नइं करे हव, येकर खातिर ये बिपत्ति ह तुम्हर ऊपर पड़े हवय, जइसने कि तुमन अब देखत हव।”<verse eid="JER 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 44:24" />तब यरमियाह ह जम्मो मनखे अऊ माईलोगनमन ला कहिस, “हे मिसर देस म रहइया यहूदा के जम्मो मनखेमन, यहोवा के बचन ला सुनव। <verse eid="JER 44:24" /><verse number="25" style="v" sid="JER 44:25" />सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे: तुमन अऊ तुम्हर घरवालीमन ओ काम ला करे हवव, जेला करे के तुमन वायदा करे रहेव, ‘स्वरग के रानी बर धूप जलाय अऊ ओला पेय-बलिदान चघाय के जऊन वायदा हमन करे हवन, ओला हमन जरूर पूरा करबो।’</para>
  <para style="p" vid="JER 44:25">“तब तुमन जावव, अपन वायदा के मुताबिक करव! अपन सपथ ला पूरा करव! <verse eid="JER 44:25" /><verse number="26" style="v" sid="JER 44:26" />पर हे मिसर देस म रहइया जम्मो यहूदीमन, तुमन यहोवा के बचन ला सुनव: ‘मेंह अपन बड़े नांव के किरिया खावत हंव,’ यहोवा ह कहत हे, ‘मिसर देस म कहीं भी रहइया कोनो भी यहूदी फेर कभू मोर नांव नइं लीहीं या ये किरिया नइं खाहीं, “परमपरधान यहोवा के जिनगी के कसम।” <verse eid="JER 44:26" /><verse number="27" style="v" sid="JER 44:27" />काबरकि मेंह ओमन के भलई नइं, पर नुकसान करे के फिराक म हवंव; मिसर देस म रहइया यहूदीमन तलवार अऊ अकाल के दुवारा मारे जाहीं, जब तक कि ओमन के पूरा सतियानास नइं हो जाही। <verse eid="JER 44:27" /><verse number="28" style="v" sid="JER 44:28" />जऊन मन तलवार ले बांचके मिसर देस ले लहुंटके यहूदा देस म आहीं, ओमन बहुंत थोरकन ही होहीं। तब मिसर देस म रहे बर आय यहूदा के बांचे ओ जम्मो मनखेमन जान लीहीं कि काकर बात ह सच होही—मोर या ओमन के।<verse eid="JER 44:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 44:29" />“ ‘तुम्हर बर ये चिनहां होही कि मेंह तुमन ला ये जगह म सजा दूहूं,’ यहोवा ह घोसना करत हे, ‘ताकि तुमन जान लूहू कि तुम्हर नुकसान करे के मोर धमकी ह सही म सच होही।’ <verse eid="JER 44:29" /><verse number="30" style="v" sid="JER 44:30" />यहोवा ह ये कहत हे: ‘जइसने मेंह यहूदा के राजा सिदकियाह ला ओकर बईरी बेबिलोन के राजा नबूकदनेसर के हांथ म कर दे रहेंव, जऊन ह ओला मार डारे चाहत रिहिस, वइसने ही मेंह मिसर के राजा फिरौन होपरा ला ओकर बईरीमन के हांथ म कर दूहूं, जऊन मन ओला मार डारे चाहत हें।’ ”<verse eid="JER 44:30" /></para>
  <chapter eid="JER 44" />
  <chapter number="45" style="c" sid="JER 45" />
  <para style="s1">बारूक बर एक संदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 45:1" />योसियाह के बेटा यहूदा के राजा यहोयाकीम के राज के चौथा साल म, जब नेरियाह के बेटा बारूक ह यरमियाह अगमजानी के कहे बातमन ला किताब म लिख लीस, त यरमियाह ह बारूक ला ये कहिस: <verse eid="JER 45:1" /><verse number="2" style="v" sid="JER 45:2" />“हे बारूक, यहोवा, इसरायल के परमेसर ह तोला ये कहत हे: <verse eid="JER 45:2" /><verse number="3" style="v" sid="JER 45:3" />तेंह कहय, ‘हाय मोर ऊपर! यहोवा ह मोर दुख म अऊ दुख दे हवय; मेंह कराहत-कराहत टूट गे हंव अऊ मोला कुछू अराम नइं ए।’ <verse eid="JER 45:3" /><verse number="4" style="v" sid="JER 45:4" />पर यहोवा ह मोला कहे हवय कि मेंह तोला कहंव, ‘यहोवा ह ये कहत हे: पूरा देस म, जेमन ला मेंह बनाय हंव, ओमन ला गिरा दूहूं अऊ जेमन ला मेंह लगाय हंव, ओमन ला उखान दूहूं। <verse eid="JER 45:4" /><verse number="5" style="v" sid="JER 45:5" />त फेर का तें अपन बर बड़े चीजमन के खोज म रहिबे? ओमन के खोज म झन रह। काबरकि मेंह जम्मो मनखे ऊपर बिपत्ति लानहूं, यहोवा ह घोसना करत हे, पर जिहां कहीं भी तेंह जाबे, मेंह तोर परान ला बचाहूं।’ ”<verse eid="JER 45:5" /></para>
  <chapter eid="JER 45" />
  <chapter number="46" style="c" sid="JER 46" />
  <para style="s1">मिसर देस के बारे म संदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 46:1" />जाति-जाति के मनखेमन के बारे म, यहोवा के ये बचन यरमियाह अगमजानी करा आईस:<verse eid="JER 46:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="JER 46:2" />मिसर के बिसय:</para>
  <para style="b" vid="JER 46:2" />
  <para style="p" vid="JER 46:2">येह मिसर के राजा फिरौन नको के सेना के बिरूध म संदेस ए, जेला बेबिलोन के राजा नबूकदनेसर ह योसियाह के बेटा यहूदा के राजा यहोयाकीम के राज के चौथा साल म फरात नदी करा कर्कमीस सहर म हराईस:<verse eid="JER 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 46:3" />“अपन बड़े अऊ छोटे दूनों ढालमन ला तियार करव,</para>
  <para style="q2" vid="JER 46:3">अऊ लड़ई बर आघू बढ़व।<verse eid="JER 46:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 46:4" />घोड़ामन ला तियार करव,</para>
  <para style="q2" vid="JER 46:4">बने घोड़ामन ऊपर सवार होवव!</para>
  <para style="q1" vid="JER 46:4">टोपा पहिरके</para>
  <para style="q2" vid="JER 46:4">अपन जगह म ठाढ़ हो जावव!</para>
  <para style="q1" vid="JER 46:4">भालामन ला धार करव,</para>
  <para style="q2" vid="JER 46:4">अपन हथियारमन ला बांध लव!<verse eid="JER 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 46:5" />मेंह का देखत हंव?</para>
  <para style="q2" vid="JER 46:5">ओमन डर गे हवंय,</para>
  <para style="q1" vid="JER 46:5">ओमन पाछू हटत हें,</para>
  <para style="q2" vid="JER 46:5">ओमन के सैनिकमन हारत हें।</para>
  <para style="q1" vid="JER 46:5">ओमन बिगर पाछू देखे</para>
  <para style="q2" vid="JER 46:5">जल्दबाजी म भागत हें,</para>
  <para style="q2" vid="JER 46:5">अऊ चारों कोति आतंक छा गे हवय,” यहोवा ह घोसना करत हे।<verse eid="JER 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 46:6" />“तेज भागनेवाला ह भाग नइं सकय</para>
  <para style="q2" vid="JER 46:6">न ही बलवान मनखे ह बच सकय।</para>
  <para style="q1" vid="JER 46:6">उत्तर दिग म, फरात नदी के तीर म</para>
  <para style="q2" vid="JER 46:6">ओमन ठोकर खाथें अऊ गिर जाथें।<verse eid="JER 46:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 46:7" />“येह कोन ए, जऊन ह नील नदी सहीं,</para>
  <para style="q2" vid="JER 46:7">उमड़त पानी के नदीमन सहीं बढ़त हे?<verse eid="JER 46:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 46:8" />मिसर देस ह नील नदी सहीं,</para>
  <para style="q2" vid="JER 46:8">उमड़त पानी के नदीमन सहीं बढ़त हे।</para>
  <para style="q1" vid="JER 46:8">ओह कहिथे, ‘मेंह बढ़हूं अऊ धरती ऊपर छा जाहूं;</para>
  <para style="q2" vid="JER 46:8">मेंह सहरमन ला ओमन म रहइया मनखेमन सहित नास कर दूहूं।’<verse eid="JER 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 46:9" />हे घुड़सवारमन, हमला करव!</para>
  <para style="q2" vid="JER 46:9">हे सारथीमन, तेजी से रथ चलावव!</para>
  <para style="q1" vid="JER 46:9">हे ढाल धरइया कूस<note caller="+" style="f"><char style="fr" closed="false">46:9 </char><char style="ft" closed="false">नील नदी के ऊपरी इलाका</char></note> अऊ पूत के सैनिकमन,</para>
  <para style="q2" vid="JER 46:9">हे धनुसधारी लूदी के सैनिकमन, आघू बढ़व।<verse eid="JER 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 46:10" />पर ओ दिन ह परभू, सर्वसक्तिमान यहोवा के अय—</para>
  <para style="q2" vid="JER 46:10">एक बदला लेय के दिन, जेमा ओह ओकर बिरूध लड़त बईरीमन ले बदला लीही।</para>
  <para style="q1" vid="JER 46:10">तलवार ह अपन संतोस होवत तक,</para>
  <para style="q2" vid="JER 46:10">अऊ खून ले अपन पीयास बुझावत तक मनखेमन ला मारही।</para>
  <para style="q1" vid="JER 46:10">काबरकि उत्तर के देस म फरात नदी के तीर म,</para>
  <para style="q2" vid="JER 46:10">परभू, सर्वसक्तिमान यहोवा ह बलिदान करही।<verse eid="JER 46:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 46:11" />“हे कुंवारी बेटी मिसर,</para>
  <para style="q2" vid="JER 46:11">गिलाद ला जाके मलहम लेय ले।</para>
  <para style="q1" vid="JER 46:11">तेंह फालतू म कतको किसम के दवाई लेथस;</para>
  <para style="q2" vid="JER 46:11">ओमा तेंह बने नइं होवस।<verse eid="JER 46:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 46:12" />जाति-जाति के मनखेमन तोर बेजत्ती के बारे म सुनहीं;</para>
  <para style="q2" vid="JER 46:12">तोर रोवई ह धरती म जम्मो कोति सुनई दीही।</para>
  <para style="q1" vid="JER 46:12">एक सैनिक ह दूसर सैनिक ऊपर ठोकर खाही;</para>
  <para style="q2" vid="JER 46:12">अऊ ओ दूनों एक संग गिरहीं।”<verse eid="JER 46:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 46:13" />बेबिलोन के राजा नबूकदनेसर के आय के अऊ मिसर देस ऊपर हमला करे के बारे म यहोवा ह यरमियाह अगमजानी ला ये बात कहिस:<verse eid="JER 46:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 46:14" />“मिसर देस म ये घोसना कर, अऊ मिगदोल सहर म ये बात के घोसना कर;</para>
  <para style="q2" vid="JER 46:14">मेमफीस अऊ तहपनहेस सहर म घलो ये बात के घोसना कर:</para>
  <para style="q1" vid="JER 46:14">‘अपन जगह लेवव अऊ तियार हो जावव,</para>
  <para style="q2" vid="JER 46:14">काबरकि तुम्हर चारों कोति के मनखेमन तलवार ले मारे जाहीं।’<verse eid="JER 46:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 46:15" />तुम्हर सैनिकमन काबर नीचा करे जावंय?</para>
  <para style="q2" vid="JER 46:15">ओमन सामना नइं कर सकंय, काबरकि यहोवा ह ओमन ला नीचा देखाही।<verse eid="JER 46:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 46:16" />ओमन बार-बार ठोकर खाहीं;</para>
  <para style="q2" vid="JER 46:16">ओमन एक-दूसर ऊपर गिरहीं।</para>
  <para style="q1" vid="JER 46:16">ओमन कहिहीं, ‘उठव, हमन अतियाचार करइया के तलवार ले दूरिहा,</para>
  <para style="q2" vid="JER 46:16">अपन मनखेमन करा अऊ अपन जनम भुइयां म</para>
  <para style="q2" vid="JER 46:16">वापिस लहुंट जावन।’<verse eid="JER 46:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 46:17" />उहां ओमन चिचियाके कहिहीं,</para>
  <para style="q2" vid="JER 46:17">‘मिसर के राजा फिरौन ह सिरिप एक भारी कोलाहल ए;</para>
  <para style="q2" vid="JER 46:17">ओह अपन मऊका ला गंवा दे हवय।’<verse eid="JER 46:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 46:18" />“राजा, जेकर नांव सर्वसक्तिमान यहोवा अय,</para>
  <para style="q2" vid="JER 46:18">ओह घोसना करत हे, मोर जिनगी के कसम,</para>
  <para style="q1" vid="JER 46:18">एक जन आही, जऊन ह पहाड़मन के बीच म ताबोर सहीं,</para>
  <para style="q2" vid="JER 46:18">अऊ समुंदर के तीर म करमेल सहीं अय।<verse eid="JER 46:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 46:19" />हे मिसर म रहइयामन,</para>
  <para style="q2" vid="JER 46:19">बंधुवई म जाय बर अपन सामानमन ला बांध लेवव,</para>
  <para style="q1" vid="JER 46:19">काबरकि मेमफीस ह उजाड़ हो जाही</para>
  <para style="q2" vid="JER 46:19">अऊ बिगर कोनो निवासी के बेकार हो जाही।<verse eid="JER 46:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 46:20" />“मिसर ह एक सुघर बछिया सहीं अय,</para>
  <para style="q2" vid="JER 46:20">पर उत्तर दिग ले ओकर बिरूध म</para>
  <para style="q2" vid="JER 46:20">पसुमन ला काटनेवाला एक कीरा आवत हे।<verse eid="JER 46:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 46:21" />ओकर संग के धन के लालची मनखेमन</para>
  <para style="q2" vid="JER 46:21">मोटा-ताजा बछवा सहीं अंय।</para>
  <para style="q1" vid="JER 46:21">ओमन घलो मुहूं मोड़के भागहीं,</para>
  <para style="q2" vid="JER 46:21">ओमन सामना नइं कर सकहीं,</para>
  <para style="q1" vid="JER 46:21">काबरकि ओमन के बिपत्ति के दिन,</para>
  <para style="q2" vid="JER 46:21">अऊ सजा पाय के बेरा ह आवत हे।<verse eid="JER 46:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 46:22" />मिसर देस ह भागत सांप के सहीं फुफकारही</para>
  <para style="q2" vid="JER 46:22">जइसे कि बईरी ह बल के संग आघू बढ़थे;</para>
  <para style="q1" vid="JER 46:22">ओमन ओकर बिरूध म टंगिया धरके आहीं,</para>
  <para style="q2" vid="JER 46:22">जइसने कि मनखेमन रूख ला काटे बर आथें।<verse eid="JER 46:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 46:23" />ओमन ओकर जंगल ला काट डारहीं,” यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="JER 46:23">“हालाकि ओह घना जंगल होही।</para>
  <para style="q1" vid="JER 46:23">ओमन फांफामन ले घलो जादा संखिया म हवंय।</para>
  <para style="q2" vid="JER 46:23">ओमन के गनती नइं करे जा सकय।<verse eid="JER 46:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 46:24" />बेटी मिसर के बेजत्ती होही,</para>
  <para style="q2" vid="JER 46:24">ओला उत्तर दिग के मनखेमन के हांथ म दे दिये जाही।”<verse eid="JER 46:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 46:25" />सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह कहत हे: “मेंह थेबेस के देवता आमोन, फिरौन, मिसर देस अऊ ओकर जम्मो देवता अऊ राजा, अऊ फिरौन ऊपर भरोसा करइयामन ला दंड देनेचवाला हंव। <verse eid="JER 46:25" /><verse number="26" style="v" sid="JER 46:26" />मेंह ओमन ला बेबिलोन के राजा नबूकदनेसर अऊ ओकर अधिकारीमन के हांथ म कर दूहूं, जऊन मन ओमन ला मार डारे चाहत हें। तभो ले बाद म, जब समय ह गुजरही, त मनखेमन ला फेर मिसर म बसाय जाही,” यहोवा ह घोसना करत हे।<verse eid="JER 46:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 46:27" />“हे मोर सेवक याकूब, झन डर;</para>
  <para style="q2" vid="JER 46:27">हे इसरायल, भयभीत झन हो।</para>
  <para style="q1" vid="JER 46:27">मेंह तोला दूरिहा जगह ले</para>
  <para style="q2" vid="JER 46:27">अऊ तोर संतानमन ला ओमन के बंधुवई के देस ले जरूर बचाहूं।</para>
  <para style="q1" vid="JER 46:27">याकूब ला फेर सांति अऊ सुरकछा मिलही,</para>
  <para style="q2" vid="JER 46:27">अऊ कोनो ओला नइं डराय सकहीं।<verse eid="JER 46:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 46:28" />हे मोर सेवक याकूब, झन डर,</para>
  <para style="q2" vid="JER 46:28">काबरकि मेंह तोर संग हवंव,”</para>
  <para style="q2" vid="JER 46:28">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 46:28">“हालाकि मेंह ओ जम्मो जाति के मनखेमन ला पूरा नास कर दूहूं,</para>
  <para style="q2" vid="JER 46:28">जेमन के बीच म मेंह तुमन ला तितिर-बितिर कर दे हवंव,</para>
  <para style="q2" vid="JER 46:28">पर मेंह तुमन ला पूरा नास नइं करंव।</para>
  <para style="q1" vid="JER 46:28">मेंह तुमन ला सजा दूहूं, पर सिरिप एक सीमना के भीतर;</para>
  <para style="q2" vid="JER 46:28">मेंह तुमन ला बिगर सजा के पूरा नइं छोंड़ दंव।”<verse eid="JER 46:28" /></para>
  <chapter eid="JER 46" />
  <chapter number="47" style="c" sid="JER 47" />
  <para style="s1">पलिस्तीमन के बारे म संदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 47:1" />फिरौन<note caller="+" style="f"><char style="fr" closed="false">47:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मिसर के राजा</char></note> दुवारा गाजा सहर ऊपर हमला करे के पहिली, यरमियाह अगमजानी करा पलिस्तीमन के बारे म यहोवा के ये बचन आईस:<verse eid="JER 47:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="JER 47:2" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 47:2">“देख, उत्तर दिग म पानी ह कइसे बढ़त हे;</para>
  <para style="q2" vid="JER 47:2">ओह उछरत बोहाय लगही।</para>
  <para style="q1" vid="JER 47:2">ओह देस अऊ ओमा के जम्मो चीज ला डुबो दीही,</para>
  <para style="q2" vid="JER 47:2">नगरमन ला अऊ ओमा रहइया जम्मो झन ला डुबो दीही।</para>
  <para style="q1" vid="JER 47:2">मनखेमन चिचियाहीं;</para>
  <para style="q2" vid="JER 47:2">देस म रहइया जम्मो झन बिलाप करहीं<verse eid="JER 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 47:3" />सरपट भागत मजबूत घोड़ामन के खुर के अवाज सुनके,</para>
  <para style="q2" vid="JER 47:3">बईरी के रथमन के अवाज सुनके</para>
  <para style="q2" vid="JER 47:3">अऊ ओमन के चक्का के गड़गड़ाहट के अवाज सुनके।</para>
  <para style="q1" vid="JER 47:3">दाई-ददामन अपन लइकामन के मदद करे बर नइं मुड़हीं;</para>
  <para style="q2" vid="JER 47:3">ओमन के हांथमन अपंग हो जाहीं।<verse eid="JER 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 47:4" />काबरकि जम्मो पलिस्तीमन ला नास करे के</para>
  <para style="q2" vid="JER 47:4">अऊ ओ जम्मो बांचे मनखे</para>
  <para style="q1" vid="JER 47:4">जऊन मन सूर अऊ सीदोन सहर के मदद कर सकत रिहिन,</para>
  <para style="q2" vid="JER 47:4">ओमन ला हटाय के दिन आ गे हवय।</para>
  <para style="q1" vid="JER 47:4">काबरकि यहोवा ह कपतोर<note caller="+" style="f"><char style="fr" closed="false">47:4 </char><char style="ft" closed="false">याने कि, क्रेते</char></note> के समुंदर तीर के</para>
  <para style="q2" vid="JER 47:4">बांचे पलिस्तीमन ला नास करनेचवाला हे।<verse eid="JER 47:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 47:5" />गाजा सहर के मनखेमन सोक म अपन मुड़ मुड़ाहीं;</para>
  <para style="q2" vid="JER 47:5">अस्कलोन के मनखेमन ला चुप करा दिये जाही।</para>
  <para style="q1" vid="JER 47:5">हे समतल जगह म बांचे मनखेमन,</para>
  <para style="q2" vid="JER 47:5">तुमन कब तक अपनआप ला चीरत रहिहू?<verse eid="JER 47:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 47:6" />“ ‘आह, हे यहोवा के तलवार,</para>
  <para style="q2" vid="JER 47:6">तेंह कब सांत होबे?</para>
  <para style="q1" vid="JER 47:6">अपन मियान म लहुंट जा;</para>
  <para style="q2" vid="JER 47:6">सांत हो अऊ थम जा।’<verse eid="JER 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 47:7" />पर येह कइसे सांत हो सकथे</para>
  <para style="q2" vid="JER 47:7">जब यहोवा ह येला हुकूम दे हवय,</para>
  <para style="q1" vid="JER 47:7">जब ओह अस्कलोन अऊ समुंदर तीर ऊपर</para>
  <para style="q2" vid="JER 47:7">हमला करे के हुकूम दे हवय?”<verse eid="JER 47:7" /></para>
  <chapter eid="JER 47" />
  <chapter number="48" style="c" sid="JER 48" />
  <para style="s1">मोआब के बारे म संदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 48:1" />मोआब देस के बारे म:</para>
  <para style="b" vid="JER 48:1" />
  <para style="p" vid="JER 48:1">सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे:</para>
  <para style="q1" vid="JER 48:1">“नबो ऊपर हाय, काबरकि येह नास हो जाही।</para>
  <para style="q2" vid="JER 48:1">किरयातैम ह कलंकित होही अऊ ओकर ऊपर कब्जा कर लिये जाही;</para>
  <para style="q2" vid="JER 48:1">मजबूत गढ़ ह कलंकित होही अऊ बिखर जाही।<verse eid="JER 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 48:2" />अब मोआब के परसंसा नइं होही;</para>
  <para style="q2" vid="JER 48:2">हेसबोन सहर म मनखेमन ओकर नुकसान करे के योजना बनाहीं:</para>
  <para style="q2" vid="JER 48:2">‘आवव, हमन ओ देस के अन्त कर देवन।’</para>
  <para style="q1" vid="JER 48:2">हे मदमेन<note caller="+" style="f"><char style="fr" closed="false">48:2 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मोआबी नगर</char></note> के मनखेमन, तुमन ला घलो सांत कर दिये जाही;</para>
  <para style="q2" vid="JER 48:2">तलवार ह तुम्हर पीछा करही।<verse eid="JER 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 48:3" />होरोनैम ले दुख के कारन रोये के अवाज आही,</para>
  <para style="q2" vid="JER 48:3">बड़े बिनास अऊ दुख के अवाज सुनई दीही।<verse eid="JER 48:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 48:4" />मोआब के सतियानास हो जाही;</para>
  <para style="q2" vid="JER 48:4">ओकर छोटे लइकामन चिचियाहीं।<verse eid="JER 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 48:5" />ओमन लूहीत करा पहाड़ी ऊपर चघहीं,</para>
  <para style="q2" vid="JER 48:5">अऊ ओमन अब्बड़ रोवत ऊपर जाहीं;</para>
  <para style="q1" vid="JER 48:5">होरोनैम के खाल्हे के रसता म बिनास के कारन दुख के चिचियाहट सुनई देवत हे।<verse eid="JER 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 48:6" />भागव! अपन परान बचाय बर भागव;</para>
  <para style="q2" vid="JER 48:6">सुनसान जगह म एक झाड़ी के सहीं हो जावव।<verse eid="JER 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 48:7" />काबरकि तुमन अपन काम अऊ धन ऊपर भरोसा रखथव,</para>
  <para style="q2" vid="JER 48:7">ये खातिर तुमन ला घलो बंदी बना लिये जाही,</para>
  <para style="q1" vid="JER 48:7">कमोस देवता ह अपन पुरोहितमन</para>
  <para style="q2" vid="JER 48:7">अऊ अधिकारीमन के संग बंधुवई म जाही।<verse eid="JER 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 48:8" />बिनास करइया ह हर एक नगर ऊपर चढ़ई करही,</para>
  <para style="q2" vid="JER 48:8">अऊ कोनो नगर नइं बांचही।</para>
  <para style="q1" vid="JER 48:8">घाटी ह नास हो जाही</para>
  <para style="q2" vid="JER 48:8">अऊ पहाड़ी ह सतियानास हो जाही,</para>
  <para style="q2" vid="JER 48:8">काबरकि यहोवा ह कहे हवय।<verse eid="JER 48:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 48:9" />मोआब के ऊपर नून डाल दे,</para>
  <para style="q2" vid="JER 48:9">काबरकि ओह उजाड़ हो जाही;</para>
  <para style="q1" vid="JER 48:9">ओकर नगरमन निरजन हो जाहीं,</para>
  <para style="q2" vid="JER 48:9">ओमन म कोनो नइं रहिहीं।<verse eid="JER 48:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 48:10" />“सरापित होवय ओह, जऊन ह यहोवा के काम ला अलाली म करथे!</para>
  <para style="q2" vid="JER 48:10">सरापित होवय ओह, जऊन ह अपन तलवार ला खून बहाय ले रोकथे!<verse eid="JER 48:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 48:11" />“जइसने अंगूर के मंद ह एक बरतन ले दूसर बरतन म ढारे नइं जाय ले</para>
  <para style="q2" vid="JER 48:11">ओह लद्दी होके खाल्हे म जमके अराम से रहिथे,</para>
  <para style="q1" vid="JER 48:11">वइसने मोआब ह जवानी ले अराम से रहत हवय,</para>
  <para style="q2" vid="JER 48:11">ओह बंधुवई म नइं गे हवय।</para>
  <para style="q1" vid="JER 48:11">एकरसेति ओकर सुवाद ह जस के तस हवय,</para>
  <para style="q2" vid="JER 48:11">अऊ ओकर खुसबू ह नइं बदले हवय।<verse eid="JER 48:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 48:12" />पर समय आवत हे,” यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="JER 48:12">“जब मेंह मनखेमन ला पठोहूं, जऊन मन घघरीमन ले ढारथें,</para>
  <para style="q2" vid="JER 48:12">अऊ ओमन ओला ढार दीहीं;</para>
  <para style="q1" vid="JER 48:12">ओमन ओकर घघरीमन ला खाली कर दीहीं</para>
  <para style="q2" vid="JER 48:12">अऊ ओकर बरतनमन ला फोर दीहीं।<verse eid="JER 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 48:13" />तब मोआब के मनखेमन अपन कमोस देवता ले लज्जित होहीं,</para>
  <para style="q2" vid="JER 48:13">जइसने इसरायल के मनखेमन लज्जित होईन</para>
  <para style="q2" vid="JER 48:13">जब ओमन बेतेल ऊपर भरोसा करिन।<verse eid="JER 48:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 48:14" />“तुमन कइसे कह सकत हव, ‘हमन योद्धा,</para>
  <para style="q2" vid="JER 48:14">लड़ई म बीर मनखे अन’?<verse eid="JER 48:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 48:15" />मोआब ह नास करे जाही अऊ ओकर नगरमन ऊपर चढ़ई करे जाही;</para>
  <para style="q2" vid="JER 48:15">ओकर सबले बने जवानमन मारे जाय बर खाल्हे जाहीं,”</para>
  <para style="q2" vid="JER 48:15">राजा ह घोसना करत हे, जेकर नांव सर्वसक्तिमान यहोवा अय।<verse eid="JER 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 48:16" />“मोआब के गिरई ह लकठा म हवय;</para>
  <para style="q2" vid="JER 48:16">ओकर ऊपर संकट बहुंत जल्दी आही।<verse eid="JER 48:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 48:17" />ओकर आसपास के जम्मो रहइया,</para>
  <para style="q2" vid="JER 48:17">अऊ ओकर कीरति ला जाननेवाले जम्मो झन ओकर बर बिलाप करव;</para>
  <para style="q1" vid="JER 48:17">कहव, ‘सक्तिसाली राजदंड ह कइसे टूट गीस,</para>
  <para style="q2" vid="JER 48:17">महिमामय लउठी ह कइसे टूट गीस!’<verse eid="JER 48:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 48:18" />“हे दीबोन बेटी के रहइयामन,</para>
  <para style="q2" vid="JER 48:18">अपन महिमा ला छोंड़व</para>
  <para style="q2" vid="JER 48:18">अऊ सूखा भुइयां म बईठव,</para>
  <para style="q1" vid="JER 48:18">काबरकि जऊन ह मोआब ला नास करथे</para>
  <para style="q2" vid="JER 48:18">ओह तुम्हर बिरूध आही</para>
  <para style="q2" vid="JER 48:18">अऊ तुम्हर किलाबंदीवाले सहरमन ला नास कर दीही।<verse eid="JER 48:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 48:19" />हे अरोएर नगर के रहइयामन,</para>
  <para style="q2" vid="JER 48:19">सड़क-तीर म ठाढ़ होके देखव।</para>
  <para style="q1" vid="JER 48:19">जऊन मनखेमन भागत हें अऊ जऊन माईलोगनमन बचके निकलत हें,</para>
  <para style="q2" vid="JER 48:19">ओमन ले पुछव, ‘का होय हवय?’<verse eid="JER 48:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 48:20" />मोआब ह कलंकित होईस, काबरकि ओह कुटा-कुटा हो गीस।</para>
  <para style="q2" vid="JER 48:20">सोक मनावव अऊ चिचियाके रोवव!</para>
  <para style="q1" vid="JER 48:20">अरनोन म घोसना करव</para>
  <para style="q2" vid="JER 48:20">कि मोआब ह नास हो गीस।<verse eid="JER 48:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 48:21" />पठारी भुइयां ऊपर नियाय आ गे हवय—</para>
  <para style="q2" vid="JER 48:21">होलोन, यहस अऊ मेपात ऊपर,<verse eid="JER 48:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="JER 48:22" />दीबोन, नबो अऊ बेत-दिबलातैम ऊपर,<verse eid="JER 48:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="JER 48:23" />किरयातैम, बेत-गामूल अऊ बेत-मोन ऊपर,<verse eid="JER 48:23" /></para>
  <para style="q2">
    <verse number="24" style="v" sid="JER 48:24" />करियोत, बोसरा ऊपर—</para>
  <para style="q2" vid="JER 48:24">लकठा अऊ दूरिहा, मोआब के जम्मो नगरमन ऊपर नियाय आ गे हवय।<verse eid="JER 48:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 48:25" />मोआब के सींग<note caller="+" style="f"><char style="fr" closed="false">48:25 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">इहां ताकत के प्रतीक अय</char></note> ह कटके अलग हो गीस;</para>
  <para style="q2" vid="JER 48:25">ओकर बाहां ह टूट गीस,”</para>
  <para style="q2" vid="JER 48:25">यहोवा ह घोसना करत हे।<verse eid="JER 48:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="JER 48:26" />“ओला मतवार कर दव,</para>
  <para style="q2" vid="JER 48:26">काबरकि ओह यहोवा के परवाह नइं करे हवय।</para>
  <para style="q1" vid="JER 48:26">मोआब ला अपन उल्टी म लोटन दव;</para>
  <para style="q2" vid="JER 48:26">ओला हंसी के चीज होवन दव।<verse eid="JER 48:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 48:27" />का इसरायल ह तुम्हर हंसी उड़ाय के चीज नइं रिहिस?</para>
  <para style="q2" vid="JER 48:27">का ओह चोरमन के बीच म पकड़े गे रिहिस,</para>
  <para style="q1" vid="JER 48:27">कि जब भी तेंह ओकर चरचा करथस</para>
  <para style="q2" vid="JER 48:27">त अपमान म, तेंह अपन मुड़ हलाथस?<verse eid="JER 48:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 48:28" />हे मोआब के रहइयामन,</para>
  <para style="q2" vid="JER 48:28">अपन नगरमन ला छोंड़के चट्टानमन के बीच म रहव।</para>
  <para style="q1" vid="JER 48:28">ओ पंड़की चिरई सहीं बनव</para>
  <para style="q2" vid="JER 48:28">जऊन ह गुफा के मुहूं म अपन खोंधरा बनाथे।<verse eid="JER 48:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JER 48:29" />“हमन मोआब के घमंड के बारे म सुने हन—</para>
  <para style="q2" vid="JER 48:29">कतेक जादा ओह घमंडी ए!</para>
  <para style="q1" vid="JER 48:29">हमन ओकर तिरस्कार, ओकर घमंड, ओकर अभिमान</para>
  <para style="q2" vid="JER 48:29">अऊ ओकर मन के अहंकार के बारे म सुने हन।<verse eid="JER 48:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 48:30" />मेंह ओकर तिरस्कार ला जानत हंव, पर येह बेकार ए,” यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="JER 48:30">“अऊ ओकर अहंकार से कुछू नइं मिलय।<verse eid="JER 48:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 48:31" />ये खातिर मेंह मोआब बर बिलाप करथंव,</para>
  <para style="q2" vid="JER 48:31">जम्मो मोआब बर मेंह रोवत हंव,</para>
  <para style="q2" vid="JER 48:31">कीर-हरेसेत सहर के मनखेमन बर मेंह बिलाप करथंव।<verse eid="JER 48:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 48:32" />हे सिबमा सहर के अंगूर के नारमन,</para>
  <para style="q2" vid="JER 48:32">मेंह तुम्हर बर रोथंव, जइसने कि याजेर ह रोथे।</para>
  <para style="q1" vid="JER 48:32">तोर डारामन समुंदर<note caller="+" style="f"><char style="fr" closed="false">48:32 </char><char style="ft" closed="false">संभवतः मिरतू समुंदर</char></note> तक बगर गे हवंय;</para>
  <para style="q2" vid="JER 48:32">ओमन याजेर सहर तक हबर गे हवंय।</para>
  <para style="q1" vid="JER 48:32">नास करइया ह तोर पाके फर</para>
  <para style="q2" vid="JER 48:32">अऊ अंगूरमन ऊपर गिर गे हवय।<verse eid="JER 48:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 48:33" />मोआब के फर के बारी अऊ खेतमन ले</para>
  <para style="q2" vid="JER 48:33">आनंद अऊ खुसी ह चले गे हवय।</para>
  <para style="q1" vid="JER 48:33">मेंह अंगूर के रसकुंडमन ले अंगूर के मंद बहे ला बंद कर दे हंव;</para>
  <para style="q2" vid="JER 48:33">कोनो ओमन ला आनंद के अवाज सहित अपन गोड़ ले नइं कुचरंय।</para>
  <para style="q1" vid="JER 48:33">हालाकि उहां अवाज होवथे,</para>
  <para style="q2" vid="JER 48:33">पर ओह आनंद के अवाज नो हय।<verse eid="JER 48:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JER 48:34" />“ओमन के रोये के अवाज ह</para>
  <para style="q2" vid="JER 48:34">हेसबोन ले एलाले अऊ यहस नगर तक,</para>
  <para style="q1" vid="JER 48:34">अऊ सोअर नगर ले होरोनैम अऊ एगलत-सलीसिया तक सुनई देवत हे,</para>
  <para style="q2" vid="JER 48:34">काबरकि निमरीम सोता के पानी घलो सुख गे हवय।<verse eid="JER 48:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 48:35" />जऊन मन ऊंच जगहमन म बलिदान चघाथें</para>
  <para style="q2" vid="JER 48:35">अऊ अपन देवतामन बर धूप जलाथें”</para>
  <para style="q2" vid="JER 48:35">ओमन के मेंह मोआब म अन्त कर दूहूं, यहोवा ह घोसना करत हे।<verse eid="JER 48:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 48:36" />“एकरसेति मोआब बर मोर मन ह बांसुरी के अवाज सहीं सोक करत हे;</para>
  <para style="q2" vid="JER 48:36">येह कीर-हरेसेत के मनखेमन बर बांसुरी के अवाज सहीं सोक करत हे।</para>
  <para style="q2" vid="JER 48:36">जऊन धन ओमन कमाय रिहिन, ओह खतम हो गीस।<verse eid="JER 48:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 48:37" />हर एक मुड़ ह मुड़ाय हवय</para>
  <para style="q2" vid="JER 48:37">अऊ हर एक दाढ़ी कटा ले हवय;</para>
  <para style="q1" vid="JER 48:37">हर हांथ म तलवार के चोट हवय</para>
  <para style="q2" vid="JER 48:37">अऊ हर कनिहां म बोरा के कपड़ा लपटाय हवय।<verse eid="JER 48:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 48:38" />मोआब के जम्मो घर के छानीमन म</para>
  <para style="q2" vid="JER 48:38">अऊ चौराहामन म</para>
  <para style="q1" vid="JER 48:38">सिरिप रोवई-पीटई होवत हे,</para>
  <para style="q2" vid="JER 48:38">काबरकि मेंह मोआब ला ओ बरतन सहीं टोर दे हंव,</para>
  <para style="q2" vid="JER 48:38">जेला कोनो पसंद नइं करंय,” यहोवा ह घोसना करत हे।<verse eid="JER 48:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="JER 48:39" />“ओह कइसे चकनाचूर हो गीस! ओमन कइसे बिलाप करत हें!</para>
  <para style="q2" vid="JER 48:39">मोआब ह लज्जा म, कइसे अपन पीठ दिखावत हवय!</para>
  <para style="q1" vid="JER 48:39">मोआब ह अपन चारों कोति के जम्मो मनखे बर</para>
  <para style="q2" vid="JER 48:39">एक हंसी के चीज, अऊ बहुंत भय के कारन हो गे हवय।”<verse eid="JER 48:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JER 48:40" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 48:40">“देखव! एक गिधवा ह मोआब ऊपर अपन डेना फईलाके</para>
  <para style="q2" vid="JER 48:40">खाल्हे कोति झपट्टा मारत हे।<verse eid="JER 48:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="JER 48:41" />करियोत सहर ऊपर कब्जा कर लिये जाही</para>
  <para style="q2" vid="JER 48:41">अऊ मजबूत गढ़मन ला ले लिये जाही।</para>
  <para style="q1" vid="JER 48:41">ओ दिन मोआब के योद्धामन के मन ह</para>
  <para style="q2" vid="JER 48:41">छेवारी होवत माईलोगन के मन सहीं हो जाही।<verse eid="JER 48:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 48:42" />मोआब ह एक देस के रूप म नास हो जाही</para>
  <para style="q2" vid="JER 48:42">काबरकि ओह यहोवा के परवाह नइं करे हवय।<verse eid="JER 48:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 48:43" />हे मोआब के मनखेमन,</para>
  <para style="q2" vid="JER 48:43">आतंक अऊ खंचवा अऊ फांदा तुम्हर डहार देखत हें,”</para>
  <para style="q2" vid="JER 48:43">यहोवा ह घोसना करत हे।<verse eid="JER 48:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 48:44" />“जऊन कोनो डराके भागही</para>
  <para style="q2" vid="JER 48:44">ओह खंचवा म गिरही,</para>
  <para style="q1" vid="JER 48:44">जऊन कोनो खंचवा म ले निकलके आही</para>
  <para style="q2" vid="JER 48:44">ओह फांदा म फंसही;</para>
  <para style="q1" vid="JER 48:44">काबरकि मेंह मोआब ऊपर</para>
  <para style="q2" vid="JER 48:44">ओकर दंड के समय ला लानहूं,”</para>
  <para style="q2" vid="JER 48:44">यहोवा ह घोसना करत हे।<verse eid="JER 48:44" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="45" style="v" sid="JER 48:45" />“हेसबोन सहर के सरन म आके</para>
  <para style="q2" vid="JER 48:45">भगोड़ा मनखेमन कोनो मदद नइं पावंय,</para>
  <para style="q1" vid="JER 48:45">काबरकि हेसबोन ले आगी,</para>
  <para style="q2" vid="JER 48:45">अऊ सीहोन के बीच ले आगी के एक जुवाला निकले हवय;</para>
  <para style="q1" vid="JER 48:45">येह मोआब के माथामन ला,</para>
  <para style="q2" vid="JER 48:45">अऊ बक-बक करइया घमंडीमन के खोपड़ी ला जला दीही।<verse eid="JER 48:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 48:46" />हे मोआब, तोर ऊपर हाय!</para>
  <para style="q2" vid="JER 48:46">कमोस के मनखेमन नास होवथें;</para>
  <para style="q1" vid="JER 48:46">तोर बेटामन बंधुवई म जावत हें,</para>
  <para style="q2" vid="JER 48:46">अऊ तोर बेटीमन कैद करे जावत हें।<verse eid="JER 48:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="JER 48:47" />“तभो ले अवइया समय म,</para>
  <para style="q2" vid="JER 48:47">मेंह मोआब के बने दिनमन ला फेर लानहूं,”</para>
  <para style="q2" vid="JER 48:47">यहोवा ह घोसना करत हे।</para>
  <para style="p" vid="JER 48:47">मोआब के दंड ह इहां खतम होईस।<verse eid="JER 48:47" /></para>
  <para style="b" />
  <chapter eid="JER 48" />
  <chapter number="49" style="c" sid="JER 49" />
  <para style="s1">अमोन के बारे म संदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 49:1" />अमोनीमन के बारे म:</para>
  <para style="b" vid="JER 49:1" />
  <para style="p" vid="JER 49:1">यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 49:1">“का इसरायल के बेटामन<note caller="+" style="f"><char style="fr" closed="false">49:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">संतानमन</char></note> नइं एं?</para>
  <para style="q2" vid="JER 49:1">का इसरायल के कोनो वारिस नइं एं?</para>
  <para style="q1" vid="JER 49:1">त फेर काबर मोलेक<note caller="+" style="f"><char style="fr" closed="false">49:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओमन के राजा</char><char style="ft" closed="false">; <char style="xt" link-href="JER 49:3"><ref loc="JER 49:3">पद 3</ref></char> म घलो</char></note> ह गाद देस ऊपर अधिकार कर ले हवय?</para>
  <para style="q2" vid="JER 49:1">ओकर मनखेमन येकर नगरमन म काबर रहत हें?<verse eid="JER 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 49:2" />पर ओ दिनमन आवत हें,” यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="JER 49:2">“जब मेंह अमोनीमन के रब्बा नगर के बिरूध</para>
  <para style="q2" vid="JER 49:2">लड़ई के ललकार करहूं;</para>
  <para style="q1" vid="JER 49:2">येह उजड़के खंडहर हो जाही,</para>
  <para style="q2" vid="JER 49:2">अऊ येकर आसपास के गांवमन म आगी लगा दिये जाही।</para>
  <para style="q1" vid="JER 49:2">तब इसरायलीमन ओमन ला निकाल दीहीं,</para>
  <para style="q2" vid="JER 49:2">जऊन मन ओमन ला निकाले रिहिन,”</para>
  <para style="q2" vid="JER 49:2">यहोवा ह कहत हे।<verse eid="JER 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 49:3" />“हे हेसबोन, बिलाप कर, काबरकि अई नगर ह नास हो गीस!</para>
  <para style="q2" vid="JER 49:3">हे रब्बा के रहइयामन, रोवव!</para>
  <para style="q1" vid="JER 49:3">बोरा के कपड़ा पहिरव अऊ सोक मनावव;</para>
  <para style="q2" vid="JER 49:3">दीवार के भीतर एती-ओती भागव,</para>
  <para style="q1" vid="JER 49:3">काबरकि मोलेक ह अपन पुरोहित</para>
  <para style="q2" vid="JER 49:3">अऊ करमचारीमन संग बंधुवई म जाही।<verse eid="JER 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 49:4" />तेंह अपन घाटीमन ऊपर,</para>
  <para style="q2" vid="JER 49:4">ओ बहुंत फर देवइया घाटीमन ऊपर काबर घमंड करत हस?</para>
  <para style="q1" vid="JER 49:4">हे बेईमान बेटी अमोन,</para>
  <para style="q2" vid="JER 49:4">तेंह अपन धन ऊपर भरोसा करके कहिथस,</para>
  <para style="q2" vid="JER 49:4">‘कोन ह मोर ऊपर हमला करही?’<verse eid="JER 49:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 49:5" />तोर चारों कोति रहइया मनखेमन ले</para>
  <para style="q2" vid="JER 49:5">मेंह तोर ऊपर आतंक लानहूं,”</para>
  <para style="q2" vid="JER 49:5">परभू, सर्वसक्तिमान यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 49:5">तुमन के हर एक जन ला निकाल दिये जाही,</para>
  <para style="q2" vid="JER 49:5">अऊ कोनो ओ निकाले गय मनखेमन ला जगह नइं दीही।<verse eid="JER 49:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 49:6" />“तभो ले बाद म, मेंह अमोनीमन के दिन ला लहुंटाके लानहूं,”</para>
  <para style="q2" vid="JER 49:6">यहोवा ह घोसना करत हे।<verse eid="JER 49:6" /></para>
  <para style="s1">एदोम के बारे म संदेस</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 49:7" />एदोम के बारे म:</para>
  <para style="b" vid="JER 49:7" />
  <para style="p" vid="JER 49:7">सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 49:7">“का तेमान म अब कुछू बुद्धि नइं ए?</para>
  <para style="q2" vid="JER 49:7">का बुद्धिमानमन के सलाह ह खतम हो गीस?</para>
  <para style="q2" vid="JER 49:7">का ओमन के बुद्धि ह नास हो गीस?<verse eid="JER 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 49:8" />हे ददान के रहइयामन,</para>
  <para style="q2" vid="JER 49:8">लहुंटके भागव, गुफा के भीतरी भागमन म छुप जावव,</para>
  <para style="q1" vid="JER 49:8">काबरकि जब मेंह एसाव ला सजा दूहूं,</para>
  <para style="q2" vid="JER 49:8">तब मेंह ओकर ऊपर बिपत्ति लानहूं।<verse eid="JER 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 49:9" />यदि अंगूर टोरइयामन तोर करा आतिन,</para>
  <para style="q2" vid="JER 49:9">त का ओमन कुछू अंगूर ला नइं छोंड़ जातिन?</para>
  <para style="q1" vid="JER 49:9">यदि चोरमन रथिया आतिन,</para>
  <para style="q2" vid="JER 49:9">त का ओमन जतेक चाहतिन, ओतेक चोराके नइं ले जातिन?<verse eid="JER 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 49:10" />पर मेंह एसाव ला नंगरा कर दूहूं;</para>
  <para style="q2" vid="JER 49:10">मेंह ओकर छुपे के जगहमन ला उघरा कर दूहूं,</para>
  <para style="q2" vid="JER 49:10">ताकि ओह अपनआप ला छुपा झन सकय।</para>
  <para style="q1" vid="JER 49:10">ओकर हथियार धरे मनखेमन नास हो गीन,</para>
  <para style="q2" vid="JER 49:10">ओकर संग के मन अऊ परोसीमन घलो नास हो गीन,</para>
  <para style="q2" vid="JER 49:10">एकरसेति ये कहे बर कोनो नइं एं,<verse eid="JER 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 49:11" />‘अपन अनाथ लइकामन ला छोंड़ जावव; मेंह ओमन ला जीयत रखहूं।</para>
  <para style="q2" vid="JER 49:11">तुम्हर बिधवामन घलो मोर ऊपर भरोसा कर सकथें।’ ”<verse eid="JER 49:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 49:12" />यहोवा ह ये कहत हे: “यदि जऊन मन कटोरा म ले पीये के लईक नो हंय, त ओमन येला जरूर पीयें, तेंह बिगर दंड पाय काबर जाबे? तेंह बिगर दंड पाय नइं जा सकबे, पर तोला येला पीना पड़ही। <verse eid="JER 49:12" /><verse number="13" style="v" sid="JER 49:13" />यहोवा ह घोसना करत हे, मेंह अपन कसम खावत हंव,” “कि बोसरा सहर ह एक उजाड़ अऊ एक सराप, एक आतंक अऊ निन्दा के चीज हो जाही; अऊ येकर जम्मो नगरमन सदाकाल बर उजाड़ हो जाहीं।”<verse eid="JER 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 49:14" />मेंह यहोवा ले एक संदेस सुने हंव;</para>
  <para style="q2" vid="JER 49:14">जाति-जाति के मनखेमन ला ये कहे बर एक दूत पठोय गीस,</para>
  <para style="q1" vid="JER 49:14">“येकर ऊपर हमला करे बर तुमन एक संग जूरव!</para>
  <para style="q2" vid="JER 49:14">लड़ई करे बर उठव!”<verse eid="JER 49:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 49:15" />“अब मेंह जाति-जाति के बीच म तोला छोटे बना दूहूं,</para>
  <para style="q2" vid="JER 49:15">अऊ मनखेमन तोला तुछ जानहीं।<verse eid="JER 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 49:16" />हे चट्टानमन के दरार म रहइयामन,</para>
  <para style="q2" vid="JER 49:16">हे पहाड़ी के चोटी ऊपर अधिकार करइयामन,</para>
  <para style="q1" vid="JER 49:16">तुम्हर बढ़े हुए आतंक अऊ तुम्हर मन के घमंड ह</para>
  <para style="q2" vid="JER 49:16">तुमन ला धोखा देय हवय।</para>
  <para style="q1" vid="JER 49:16">चाहे तुमन अपन खोंधरा गिधवा के सहीं ऊंच जगह म बनावव,</para>
  <para style="q2" vid="JER 49:16">तभो ले मेंह तुमन ला उहां ले खाल्हे ले आहूं,”</para>
  <para style="q2" vid="JER 49:16">यहोवा ह घोसना करत हे।<verse eid="JER 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 49:17" />“एदोम ह एक बहुंत घिन करे के चीज हो जाही;</para>
  <para style="q2" vid="JER 49:17">ओकर जम्मो घाव के कारन</para>
  <para style="q2" vid="JER 49:17">जऊन मन ओकर लकठा ले जाहीं, ओमन डरहीं अऊ येकर हंसी उड़ाहीं।<verse eid="JER 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 49:18" />यहोवा ह कहत हे, जइसने सदोम अऊ अमोरा ला</para>
  <para style="q2" vid="JER 49:18">ओमन के आसपास के नगरमन सहित नास कर दिये गे रिहिस,”</para>
  <para style="q1" vid="JER 49:18">“वइसने ही उहां कोनो नइं रहिहीं;</para>
  <para style="q2" vid="JER 49:18">येमा कोनो मनखे निवास नइं करहीं।<verse eid="JER 49:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 49:19" />“जइसने यरदन के झाड़ीमन ले</para>
  <para style="q2" vid="JER 49:19">कोनो सिंह ह निकलके बने चरागन म आथे,</para>
  <para style="q1" vid="JER 49:19">वइसने ही मेंह एदोम के मनखेमन ला ओमन के देस ले तुरते भगा दूहूं।</para>
  <para style="q2" vid="JER 49:19">ओ चुने हुए कोन ए, जेला मेंह ये काम बर ठहिरावंव?</para>
  <para style="q1" vid="JER 49:19">मोर सहीं कोन हे अऊ कोन ह मोला चुनौती दे सकथे?</para>
  <para style="q2" vid="JER 49:19">अऊ कोन चरवाहा ह मोर सामना कर सकथे?”<verse eid="JER 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 49:20" />एकरसेति, सुनव कि यहोवा ह एदोम के बिरूध का योजना बनाय हवय,</para>
  <para style="q2" vid="JER 49:20">अऊ तेमान म रहइयामन के बिरूध ओह का करे के ठाने हवय:</para>
  <para style="q1" vid="JER 49:20">पसु के झुंड के पीलामन ला घसीटके अलग करे जाही;</para>
  <para style="q2" vid="JER 49:20">ओमन के चरागन ह ओमन के डर के कारन होही।<verse eid="JER 49:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 49:21" />ओमन के गिरे के अवाज ले धरती ह कांपही;</para>
  <para style="q2" vid="JER 49:21">ओमन के रोये के अवाज ह लाल-समुंदर तक सुनई दीही।<verse eid="JER 49:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 49:22" />देखव! एक गिधवा ह ऊपर उड़के खाल्हे झपट्टा मारही,</para>
  <para style="q2" vid="JER 49:22">अऊ बोसरा ऊपर अपन डेनामन ला फईलाही।</para>
  <para style="q1" vid="JER 49:22">ओ दिन एदोम के सूरबीरमन के मन ह</para>
  <para style="q2" vid="JER 49:22">छेवारी होवत माईलोगन के मन सहीं होही।<verse eid="JER 49:22" /></para>
  <para style="s1">दमिस्क के बारे म संदेस</para>
  <para style="p">
    <verse number="23" style="v" sid="JER 49:23" />दमिस्क के बारे म:</para>
  <para style="q1" vid="JER 49:23">“हमात अऊ अरपाद सहर डर गीन,</para>
  <para style="q2" vid="JER 49:23">काबरकि ओमन खराप समाचार सुने हवंय।</para>
  <para style="q1" vid="JER 49:23">ओमन के मन ह टूट गे हवय,</para>
  <para style="q2" vid="JER 49:23">अऊ ओमन के मन अस्थिर समुंदर सहीं असांत हवय।<verse eid="JER 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 49:24" />दमिस्क ह दुरबल हो गे हवय,</para>
  <para style="q2" vid="JER 49:24">ओह भागे बर मुड़े हवय</para>
  <para style="q2" vid="JER 49:24">अऊ डर ह ओला जकड़ ले हवय;</para>
  <para style="q1" vid="JER 49:24">मन के असांति अऊ पीरा ह ओला जकड़े हवय,</para>
  <para style="q2" vid="JER 49:24">ओ पीरा ह छेवारी होवत माईलोगन के पीरा सहीं अय।<verse eid="JER 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 49:25" />ओ नगर, जेमा मेंह खुस होथंव,</para>
  <para style="q2" vid="JER 49:25">ओ खियातीवाला सहर ला काबर तियागे नइं गे हवय?<verse eid="JER 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 49:26" />सचमुच, ओकर जवानमन गलीमन म गिरहीं;</para>
  <para style="q2" vid="JER 49:26">ओ दिन ओकर जम्मो सैनिकमन के बोलती बंद हो जाही,”</para>
  <para style="q2" vid="JER 49:26">सर्वसक्तिमान यहोवा ह घोसना करत हे।<verse eid="JER 49:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 49:27" />“मेंह दमिस्क के दीवारमन म आगी लगा दूहूं;</para>
  <para style="q2" vid="JER 49:27">येह बेन-हदद के किलामन ला भसम कर दीही।”<verse eid="JER 49:27" /></para>
  <para style="s1">केदार अऊ हासोर के बारे म संदेस</para>
  <para style="p">
    <verse number="28" style="v" sid="JER 49:28" />केदार गोत्र अऊ हासोर के राजमन के बारे म, जेकर ऊपर बेबिलोन के राजा नबूकदनेसर ह हमला करिस:</para>
  <para style="b" vid="JER 49:28" />
  <para style="p" vid="JER 49:28">यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 49:28">“उठव, अऊ केदार ऊपर हमला करव</para>
  <para style="q2" vid="JER 49:28">अऊ पूरब के मनखेमन के नास कर देवव।<verse eid="JER 49:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 49:29" />ओमन के तम्बू अऊ ओमन के पसु के झुंडमन ला ले लिये जाही;</para>
  <para style="q2" vid="JER 49:29">ओमन के डेरा ला ओमन के जम्मो सामान</para>
  <para style="q2" vid="JER 49:29">अऊ ऊंटमन सहित ले लिये जाही।</para>
  <para style="q1" vid="JER 49:29">मनखेमन ओमन ऊपर चिचियाहीं,</para>
  <para style="q2" vid="JER 49:29">‘चारों कोति आतंक ही आतंक!’<verse eid="JER 49:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="JER 49:30" />“हे हासोर के रहइयामन, तुरते भागव!</para>
  <para style="q2" vid="JER 49:30">गुफामन के भीतर म रहव,”</para>
  <para style="q2" vid="JER 49:30">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 49:30">“बेबिलोन के राजा नबूकदनेसर ह तुम्हर बिरूध साजिस करे हवय;</para>
  <para style="q2" vid="JER 49:30">ओह तुम्हर बिरूध एक योजना बनाय हवय।<verse eid="JER 49:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JER 49:31" />“उठव अऊ अराम से रहइया ओ जाति के ऊपर हमला करव,</para>
  <para style="q2" vid="JER 49:31">जऊन ह निडर रहत हे,”</para>
  <para style="q2" vid="JER 49:31">यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="JER 49:31">“ओ जाति जेकर न कपाट हवय न घेरा;</para>
  <para style="q2" vid="JER 49:31">येकर मनखेमन खतरा ले दूरिहा रहिथें।<verse eid="JER 49:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 49:32" />ओमन के ऊंटमन ला लूट लिये जाही,</para>
  <para style="q2" vid="JER 49:32">अऊ ओमन के बड़े पसु के झुंड ह लड़ई म नास हो जाही।</para>
  <para style="q1" vid="JER 49:32">जऊन मन दूरिहा जगह म रहिथें, मेंह ओमन ला उड़ाके तितिर-बितिर कर दूहूं</para>
  <para style="q2" vid="JER 49:32">अऊ चारों कोति ले ओमन ऊपर बिपत्ति लानहूं,”</para>
  <para style="q2" vid="JER 49:32">यहोवा ह घोसना करत हे।<verse eid="JER 49:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 49:33" />“हासोर ह सियारमन के डेरा बनके,</para>
  <para style="q2" vid="JER 49:33">हमेसा बर उजाड़ हो जाही।</para>
  <para style="q1" vid="JER 49:33">उहां कोनो नइं रहिहीं;</para>
  <para style="q2" vid="JER 49:33">ओमा कोनो मनखे निवास नइं करहीं।”<verse eid="JER 49:33" /></para>
  <para style="s1">एलाम के बारे म संदेस</para>
  <para style="p">
    <verse number="34" style="v" sid="JER 49:34" />यहूदा के राजा सिदकियाह के राज के सुरूआत म, यहोवा के ये बचन यरमियाह अगमजानी करा एलाम देस के बारे म आईस:<verse eid="JER 49:34" /></para>
  <para style="b" />
  <para style="p">
    <verse number="35" style="v" sid="JER 49:35" />सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 49:35">“देख, मेंह एलाम के धनुस ला टोरहूं,</para>
  <para style="q2" vid="JER 49:35">जऊन ह कि ओकर सक्ति के खास चीज अय।<verse eid="JER 49:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 49:36" />मेंह अकास के चारों दिग ले</para>
  <para style="q2" vid="JER 49:36">एलाम के बिरूध म चार ठन आंधी लानहूं;</para>
  <para style="q1" vid="JER 49:36">मेंह ओमन ला चारों आंधी म तितिर-बितिर कर दूहूं,</para>
  <para style="q2" vid="JER 49:36">अऊ अइसने कोनो जाति के मनखे नइं होहीं</para>
  <para style="q2" vid="JER 49:36">जिहां एलामी मनखेमन भाग के नइं जाहीं।<verse eid="JER 49:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 49:37" />मेंह एलाम ला ओमन के बईरीमन के आघू म,</para>
  <para style="q2" vid="JER 49:37">अऊ ओमन के परान के खोजीमन के आघू म चकनाचूर कर दूहूं;</para>
  <para style="q1" vid="JER 49:37">मेंह अपन भयंकर गुस्सा म,</para>
  <para style="q2" vid="JER 49:37">ओमन ऊपर बिपत्ति लानहूं,”</para>
  <para style="q2" vid="JER 49:37">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 49:37">“मेंह तलवार लेके ओमन के पीछा तब तक करहूं</para>
  <para style="q2" vid="JER 49:37">जब तक कि मेंह ओमन के अन्त नइं कर दूहूं।<verse eid="JER 49:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 49:38" />मेंह एलाम म अपन सिंघासन रखहूं</para>
  <para style="q2" vid="JER 49:38">अऊ ओकर राजा अऊ करमचारीमन ला नास कर दूहूं,”</para>
  <para style="q2" vid="JER 49:38">यहोवा ह घोसना करत हे।<verse eid="JER 49:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="JER 49:39" />“तभो ले अवइया समय म,</para>
  <para style="q2" vid="JER 49:39">एलाम के बने दिनमन ला फेर लानहूं,”</para>
  <para style="q2" vid="JER 49:39">यहोवा ह घोसना करत हे।<verse eid="JER 49:39" /></para>
  <chapter eid="JER 49" />
  <chapter number="50" style="c" sid="JER 50" />
  <para style="s1">बेबिलोन के बारे म संदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 50:1" />बेबिलोन सहर अऊ बेबिलोनीमन<note caller="+" style="f"><char style="fr" closed="false">50:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीमन</char></note> के देस के बारे म यहोवा ह यरमियाह अगमजानी के जरिये ये बचन कहिस:<verse eid="JER 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 50:2" />“जाति-जाति के मनखेमन के बीच म बतावव अऊ घोसना करव,</para>
  <para style="q2" vid="JER 50:2">झंडा उठाके येकर घोसना करव;</para>
  <para style="q2" vid="JER 50:2">कुछू झन छुपावव, पर कहव,</para>
  <para style="q1" vid="JER 50:2">‘बेबिलोन ला ले लिये जाही;</para>
  <para style="q2" vid="JER 50:2">बेल के बेजत्ती होही,</para>
  <para style="q2" vid="JER 50:2">मरोदक ह आतंकित होईस।</para>
  <para style="q1" vid="JER 50:2">ओकर मूरतीमन के बेजत्ती होही</para>
  <para style="q2" vid="JER 50:2">अऊ ओकर मूरतीमन आतंकित होईन।’<verse eid="JER 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 50:3" />उत्तर दिग ले एक जाति ह ओकर ऊपर हमला करही</para>
  <para style="q2" vid="JER 50:3">अऊ ओकर देस ला उजाड़ दीही।</para>
  <para style="q1" vid="JER 50:3">ओमा कोनो नइं रहिहीं;</para>
  <para style="q2" vid="JER 50:3">मनखे अऊ पसु दूनों भाग जाहीं।<verse eid="JER 50:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JER 50:4" />“ओ दिनमन म, ओ समय म,” यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="JER 50:4">“इसरायल के मनखेमन अऊ यहूदा के मनखेमन एक संग</para>
  <para style="q2" vid="JER 50:4">रोवत यहोवा अपन परमेसर के खोज म जाहीं।<verse eid="JER 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 50:5" />ओमन सियोन के रसता ला पुछहीं</para>
  <para style="q2" vid="JER 50:5">अऊ ओ रसता कोति अपन मुहूं कर लीहीं।</para>
  <para style="q1" vid="JER 50:5">ओमन आहीं अऊ अपनआप ला यहोवा के संग</para>
  <para style="q2" vid="JER 50:5">सदाकाल के करार म बांध लीहीं</para>
  <para style="q2" vid="JER 50:5">जऊन ला बिसराय नइं जाही।<verse eid="JER 50:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 50:6" />“मोर मनखेमन गंवाय भेड़ अंय;</para>
  <para style="q2" vid="JER 50:6">ओमन के चरवाहामन ओमन ला रसता ले भटका दे हवंय</para>
  <para style="q2" vid="JER 50:6">जेकर कारन ओमन पहाड़मन म एती-ओती घुमत हें।</para>
  <para style="q1" vid="JER 50:6">ओमन पहाड़ अऊ पठार ऊपर घुमत हवंय</para>
  <para style="q2" vid="JER 50:6">अऊ अपन अराम करे के जगह ला भुला गे हवंय।<verse eid="JER 50:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 50:7" />जऊन कोनो भी ओमन ला पाईस, ओह ओमन ला खा लीस;</para>
  <para style="q2" vid="JER 50:7">ओमन के बईरीमन कहिन, ‘हमन दोसी नो हन,</para>
  <para style="q1" vid="JER 50:7">काबरकि ओमन यहोवा के बिरूध म पाप करिन, जऊन ह कि ओमन के हरा-भरा चरागन ए,</para>
  <para style="q2" vid="JER 50:7">यहोवा, ओमन के पुरखामन के आसा ए।’<verse eid="JER 50:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JER 50:8" />“बेबिलोन ले बाहिर भागव;</para>
  <para style="q2" vid="JER 50:8">बेबिलोनी मनखेमन के देस ला छोंड़व,</para>
  <para style="q2" vid="JER 50:8">अऊ ओ बोकरामन सहीं बनव, जऊन मन झुंड के अगुवई करथें।<verse eid="JER 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 50:9" />काबरकि मेंह उत्तर के देस ले बड़े जातिमन के एक दल ला उभारहूं</para>
  <para style="q2" vid="JER 50:9">अऊ ओ दल ला बेबिलोन के बिरूध लानहूं।</para>
  <para style="q1" vid="JER 50:9">ओमन बेबिलोन के बिरूध म कतार बांधहीं,</para>
  <para style="q2" vid="JER 50:9">अऊ उत्तर दिग ले ओकर ऊपर कब्जा करे जाही।</para>
  <para style="q1" vid="JER 50:9">ओमन के तीरमन कुसल योद्धामन सहीं होहीं,</para>
  <para style="q2" vid="JER 50:9">जेमन कि खाली नइं लहुंटंय।<verse eid="JER 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 50:10" />ये किसम ले बेबिलोनिया<note caller="+" style="f"><char style="fr" closed="false">50:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीया</char></note> ला लूटे जाही;</para>
  <para style="q2" vid="JER 50:10">ओ जम्मो जऊन मन ओला लूटहीं, ओमन संतुस्ट हो जाहीं,”</para>
  <para style="q2" vid="JER 50:10">यहोवा ह घोसना करत हे।<verse eid="JER 50:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 50:11" />“हे मोर भाग ला लूटनेवालामन,</para>
  <para style="q2" vid="JER 50:11">काबरकि तुमन आनंद मनाथव अऊ खुस हव,</para>
  <para style="q1" vid="JER 50:11">अऊ एक अनाज कुटत बछिया के सहीं उदकत</para>
  <para style="q2" vid="JER 50:11">अऊ ताकतवर घोड़ामन के सहीं हिनहिनावत हव,<verse eid="JER 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 50:12" />तुम्हर दाई ह बहुंत लज्जित होही;</para>
  <para style="q2" vid="JER 50:12">जऊन ह तुमन ला जनम दीस, ओह कलंकित होही।</para>
  <para style="q1" vid="JER 50:12">ओह जम्मो जाति म सबले छोटे होही—</para>
  <para style="q2" vid="JER 50:12">ओह एक निरजन, सूखा देस अऊ मरू-भुइयां सहीं होही।<verse eid="JER 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 50:13" />यहोवा के गुस्सा के कारन, ओमा कोनो नइं बसहीं</para>
  <para style="q2" vid="JER 50:13">पर ओह पूरा उजाड़ हो जाही।</para>
  <para style="q1" vid="JER 50:13">जऊन मन बेबिलोन ले होवत जाहीं, ओमन भयभीत होहीं;</para>
  <para style="q2" vid="JER 50:13">ओकर जम्मो दुख के कारन ओकर हंसी उड़ाहीं।<verse eid="JER 50:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 50:14" />“हे जम्मो धनुसधारीमन,</para>
  <para style="q2" vid="JER 50:14">बेबिलोन के चारों कोति ओकर बिरूध म कतार बांध लव।</para>
  <para style="q1" vid="JER 50:14">ओकर ऊपर तीर चलावव! कोनो तीर ला बचाके झन रखव,</para>
  <para style="q2" vid="JER 50:14">काबरकि ओह यहोवा के बिरूध म पाप करे हवय।<verse eid="JER 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 50:15" />चारों कोति ले ओकर ऊपर तीर चलावव!</para>
  <para style="q1" vid="JER 50:15">ओह हार मानत हे, ओकर मीनारमन गिरत हें,</para>
  <para style="q2" vid="JER 50:15">ओकर दीवारमन गिराय जावत हें।</para>
  <para style="q1" vid="JER 50:15">काबरकि यहोवा ह ओकर ले बदला लेवत हे,</para>
  <para style="q2" vid="JER 50:15">त तुमन घलो ओकर ले बदला लेवव;</para>
  <para style="q2" vid="JER 50:15">ओकर संग वइसने करव, जइसने ओह आने मन संग करे हवय।<verse eid="JER 50:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 50:16" />बेबिलोन ले बीज बोवइया ला अलग कर दव,</para>
  <para style="q2" vid="JER 50:16">अऊ लुवई के बेरा फसल लुवइया ला ओकर हंसिया ले अलग कर दव।</para>
  <para style="q1" vid="JER 50:16">अतियाचारी के तलवार के डर के कारन</para>
  <para style="q2" vid="JER 50:16">हर एक जन अपन-अपन मनखेमन करा लहुंट जावय,</para>
  <para style="q2" vid="JER 50:16">अऊ हर एक जन अपन-अपन देस ला भाग जावय।<verse eid="JER 50:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 50:17" />“इसरायल ह तितिर-बितिर करे गे एक झुंड ए,</para>
  <para style="q2" vid="JER 50:17">जेला सिंहमन भगा दे हवंय।</para>
  <para style="q1" vid="JER 50:17">सबले पहिले ओमन ला खानेवाला</para>
  <para style="q2" vid="JER 50:17">अस्सूर के राजा ए;</para>
  <para style="q1" vid="JER 50:17">सबले आखिरी म ओमन के हाड़ामन ला टोरनेवाला</para>
  <para style="q2" vid="JER 50:17">बेबिलोन के राजा नबूकदनेसर ए।”<verse eid="JER 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 50:18" />ये खातिर सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे:</para>
  <para style="q1" vid="JER 50:18">“जइसने मेंह अस्सूर के राजा ला सजा दे हंव,</para>
  <para style="q2" vid="JER 50:18">वइसने मेंह बेबिलोन के राजा अऊ ओकर देस ला सजा दूहूं।<verse eid="JER 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 50:19" />पर मेंह इसरायल के मनखेमन ला फेर ओमन के चराई म लहुंटाके लानहूं,</para>
  <para style="q2" vid="JER 50:19">अऊ ओमन करमेल पहाड़ अऊ बासान के इलाका म चरहीं;</para>
  <para style="q1" vid="JER 50:19">एपरैम अऊ गिलाद के पहाड़ीमन म</para>
  <para style="q2" vid="JER 50:19">ओमन भरपेट खाय बर पाहीं।<verse eid="JER 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 50:20" />ओ दिनमन म, ओ समय म,” यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="JER 50:20">“इसरायल के अपराध ला खोजे जाही,</para>
  <para style="q2" vid="JER 50:20">पर ओमा कोनो अपराध नइं मिलही,</para>
  <para style="q1" vid="JER 50:20">अऊ यहूदा के पाप ला घलो खोजे जाही,</para>
  <para style="q2" vid="JER 50:20">पर ओमा कोनो अपराध नइं मिलही,</para>
  <para style="q2" vid="JER 50:20">काबरकि जेमन ला मेंह बचाहूं, ओमन के पाप ला छेमा कर दूहूं।<verse eid="JER 50:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 50:21" />“मरातैम देस अऊ पकोद म रहइया मनखेमन ऊपर</para>
  <para style="q2" vid="JER 50:21">तेंह हमला कर।</para>
  <para style="q1" vid="JER 50:21">ओमन के पीछा कर, मार डार अऊ ओमन ला पूरा नास कर दे,”</para>
  <para style="q2" vid="JER 50:21">यहोवा ह घोसना करत हे।</para>
  <para style="q2" vid="JER 50:21">“हर ओ काम कर, जेकर हुकूम मेंह तोला दे हवंव।<verse eid="JER 50:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 50:22" />ओ देस म लड़ई के अवाज,</para>
  <para style="q2" vid="JER 50:22">बड़े बिनास के अवाज होवत हे!<verse eid="JER 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 50:23" />जम्मो धरती के हथौड़ा ह</para>
  <para style="q2" vid="JER 50:23">कइसे टूटके कुटा-कुटा हो गे हवय!</para>
  <para style="q1" vid="JER 50:23">बेबिलोन ह जाति-जाति के मनखेमन के बीच म</para>
  <para style="q2" vid="JER 50:23">कइसे उजाड़ हो गे हवय!<verse eid="JER 50:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 50:24" />हे बेबिलोन, मेंह तोर बर एक फांदा लगाय हंव,</para>
  <para style="q2" vid="JER 50:24">अऊ येकर पहिली कि तें ओला जानते, तेंह ओमा फंस गेय;</para>
  <para style="q1" vid="JER 50:24">तोला खोजके पकड़ लिये गीस,</para>
  <para style="q2" vid="JER 50:24">काबरकि तें यहोवा के बिरोध करे।<verse eid="JER 50:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 50:25" />यहोवा ह अपन हथियारमन के घर ला खोल दे हवय,</para>
  <para style="q2" vid="JER 50:25">अऊ अपन कोरोध के हथियारमन ला बाहिर निकाले हवय,</para>
  <para style="q1" vid="JER 50:25">काबरकि परमपरधान यहोवा सर्वसक्तिमान ला</para>
  <para style="q2" vid="JER 50:25">बेबिलोनीमन के देस म एक काम करना हे।<verse eid="JER 50:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 50:26" />दूरिहा ले ओकर बिरूध म आवव।</para>
  <para style="q2" vid="JER 50:26">ओकर अन्न के भंडारमन ला टोरके खोल दव;</para>
  <para style="q2" vid="JER 50:26">अनाज के ढेर सहीं ओला कुढ़ो दव।</para>
  <para style="q1" vid="JER 50:26">ओकर पूरा सतियानास कर दव,</para>
  <para style="q2" vid="JER 50:26">अऊ ओकर कुछू ला घलो बचाके झन रखव।<verse eid="JER 50:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 50:27" />ओकर जम्मो जवान बईलामन ला मार डारव;</para>
  <para style="q2" vid="JER 50:27">ओमन ला काटे बर खाल्हे जावन दव!</para>
  <para style="q1" vid="JER 50:27">ओमन ऊपर हाय! काबरकि ओमन के दिन ह आ गे हवय,</para>
  <para style="q2" vid="JER 50:27">ओमन के सजा पाय के समय ह आ गे हवय।<verse eid="JER 50:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 50:28" />सियोन म घोसना होवत हे;</para>
  <para style="q2" vid="JER 50:28">बेबिलोन के भगोड़ा अऊ सरनार्थीमन के बात ला सुनव</para>
  <para style="q1" vid="JER 50:28">यहोवा हमर परमेसर ह</para>
  <para style="q2" vid="JER 50:28">कइसे अपन मंदिर के बदला ले हवय।<verse eid="JER 50:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JER 50:29" />“धनुसधारीमन ला बेबिलोन के बिरूध म लड़े बर बलावव,</para>
  <para style="q2" vid="JER 50:29">ओ जम्मो झन ला बलावव, जऊन मन धनुस चलाथें।</para>
  <para style="q1" vid="JER 50:29">ओकर चारों कोति डेरा डालव;</para>
  <para style="q2" vid="JER 50:29">कोनो बचके झन भागन पावंय।</para>
  <para style="q1" vid="JER 50:29">ओकर काममन के बदला ओला देवव;</para>
  <para style="q2" vid="JER 50:29">ओकर संग वइसने करव, जइसने ओह करे हवय।</para>
  <para style="q1" vid="JER 50:29">काबरकि ओह यहोवा,</para>
  <para style="q2" vid="JER 50:29">इसरायल के पबितर परमेसर ला ललकारे हवय।<verse eid="JER 50:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 50:30" />ये खातिर ओकर जवानमन गलीमन म गिरहीं;</para>
  <para style="q2" vid="JER 50:30">ओ दिन ओकर जम्मो सैनिकमन के बोलती बंद हो जाही,”</para>
  <para style="q2" vid="JER 50:30">यहोवा ह घोसना करत हे।<verse eid="JER 50:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 50:31" />“हे ढीठ देख, मेंह तोर बिरूध हंव,”</para>
  <para style="q2" vid="JER 50:31">परभू सर्वसक्तिमान यहोवा ह घोसना करत हे,</para>
  <para style="q1" vid="JER 50:31">“काबरकि तोर दिन ह आ गे हवय,</para>
  <para style="q2" vid="JER 50:31">तोर सजा पाय के समय ह आ गे हवय।<verse eid="JER 50:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 50:32" />ढीठ ह ठोकर खाके गिरही</para>
  <para style="q2" vid="JER 50:32">अऊ कोनो ओला उठे म मदद नइं करहीं;</para>
  <para style="q1" vid="JER 50:32">मेंह ओकर नगरमन म आगी लगाहूं,</para>
  <para style="q2" vid="JER 50:32">जऊन ह ओकर चारों कोति के जम्मो झन ला भसम कर दीही।”<verse eid="JER 50:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 50:33" />सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 50:33">“इसरायल के मनखेमन सताय जावत हें,</para>
  <para style="q2" vid="JER 50:33">अऊ यहूदा के मनखेमन घलो सताय जावत हें।</para>
  <para style="q1" vid="JER 50:33">ओमन के जम्मो पकड़नेवालामन ओमन ला कसके पकड़े हवंय,</para>
  <para style="q2" vid="JER 50:33">अऊ ओमन ला जावन नइं देवत हें।<verse eid="JER 50:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 50:34" />पर ओमन के छुड़इया ह बलवान ए;</para>
  <para style="q2" vid="JER 50:34">सर्वसक्तिमान यहोवा ओकर नांव ए।</para>
  <para style="q1" vid="JER 50:34">ओह ओमन के मुकदमा ला बने करके लड़ही</para>
  <para style="q2" vid="JER 50:34">ताकि ओह ओमन के देस म सांति लानय</para>
  <para style="q2" vid="JER 50:34">पर बेबिलोन म रहइयामन ऊपर असांति।<verse eid="JER 50:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="JER 50:35" />“बेबिलोन के मनखेमन के बिरूध म तलवार चलही!”</para>
  <para style="q2" vid="JER 50:35">यहोवा ह घोसना करत हे—</para>
  <para style="q1" vid="JER 50:35">“जऊन मन बेबिलोन म रहिथें, ओमन के बिरूध म</para>
  <para style="q2" vid="JER 50:35">अऊ ओकर करमचारी अऊ बुद्धिमान मनखेमन के बिरूध म तलवार चलही!<verse eid="JER 50:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 50:36" />ओकर लबरा अगमजानीमन के बिरूध म तलवार चलही!</para>
  <para style="q2" vid="JER 50:36">ओमन मुरूख बन जाहीं।</para>
  <para style="q1" vid="JER 50:36">ओकर योद्धामन के बिरूध म तलवार चलही!</para>
  <para style="q2" vid="JER 50:36">ओमन आतंक ले भर जाहीं।<verse eid="JER 50:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 50:37" />ओकर घोड़ा अऊ रथमन के बिरूध म</para>
  <para style="q2" vid="JER 50:37">अऊ ओकरे दरजा के जम्मो बिदेसीमन के बिरूध म तलवार चलही!</para>
  <para style="q2" vid="JER 50:37">ओमन दुरबल हो जाहीं।</para>
  <para style="q1" vid="JER 50:37">ओकर खजानामन के बिरूध म तलवार चलही!</para>
  <para style="q2" vid="JER 50:37">ओमन ला लूट लिये जाही।<verse eid="JER 50:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 50:38" />ओकर तरियामन म सूखा पड़ही!</para>
  <para style="q2" vid="JER 50:38">ओमन सूखा जाहीं।</para>
  <para style="q1" vid="JER 50:38">काबरकि येह मूरतीमन ले भरे देस अय,</para>
  <para style="q2" vid="JER 50:38">अऊ मूरतीमन आतंक ले पगला जाहीं।<verse eid="JER 50:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="JER 50:39" />“एकरसेति मरू-भुइयां के जन्तु अऊ हुंर्रामन उहां रहिहीं,</para>
  <para style="q2" vid="JER 50:39">अऊ उहां उल्लू घलो निवास करही।</para>
  <para style="q1" vid="JER 50:39">उहां फेर कोनो मनखे निवास नइं करहीं</para>
  <para style="q2" vid="JER 50:39">या पीढ़ी-पीढ़ी तक उहां कोनो नइं रहिहीं।<verse eid="JER 50:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 50:40" />यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="JER 50:40">जइसने मेंह सदोम अऊ अमोरा ला</para>
  <para style="q2" vid="JER 50:40">ओमन के आसपास के नगरमन सहित उखान फेंकें,”</para>
  <para style="q1" vid="JER 50:40">“वइसने ही उहां कोनो नइं रहिहीं;</para>
  <para style="q2" vid="JER 50:40">येमा कोनो मनखे निवास नइं करहीं।<verse eid="JER 50:40" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="JER 50:41" />“देखव! उत्तर दिग ले एक सेना आवत हे;</para>
  <para style="q2" vid="JER 50:41">धरती के छोर ले एक बड़े जाति</para>
  <para style="q2" vid="JER 50:41">अऊ बहुंते राजामन ला उभारे जावत हे।<verse eid="JER 50:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 50:42" />ओमन धनुस अऊ बरछी धरे हवंय;</para>
  <para style="q2" vid="JER 50:42">ओमन कठोर अऊ निरदयी अंय।</para>
  <para style="q1" vid="JER 50:42">जब ओमन अपन घोड़ामन ऊपर सवार होथें,</para>
  <para style="q2" vid="JER 50:42">त ओमन गरजत समुंदर सहीं अवाज करथें;</para>
  <para style="q1" vid="JER 50:42">हे बेटी बेबिलोन, ओमन तोर ऊपर हमला करे बर</para>
  <para style="q2" vid="JER 50:42">लड़ई म कतार बांधे मनखेमन सहीं आथें।<verse eid="JER 50:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 50:43" />बेबिलोन के राजा ह ओमन के बारे म खबर सुने हवय,</para>
  <para style="q2" vid="JER 50:43">अऊ ओकर हांथमन ढीला पड़ गे हवंय।</para>
  <para style="q1" vid="JER 50:43">पीरा ह ओला अइसने जकड़े हवय,</para>
  <para style="q2" vid="JER 50:43">जइसने छेवारी होवत माईलोगन ला पीरा होथे<verse eid="JER 50:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 50:44" />जइसने यरदन के झाड़ीमन ले कोनो सिंह ह</para>
  <para style="q2" vid="JER 50:44">निकलके बने चरागन म आथे,</para>
  <para style="q1" vid="JER 50:44">वइसने ही मेंह बेबिलोन के मनखेमन ला ओमन के देस ले तुरते भगा दूहूं।</para>
  <para style="q2" vid="JER 50:44">ओ चुने हुए कोन ए, जेला मेंह ये काम बर ठहिरावंव?</para>
  <para style="q1" vid="JER 50:44">मोर सहीं कोन हे अऊ कोन ह मोला चुनौती दे सकथे?</para>
  <para style="q2" vid="JER 50:44">अऊ कोन चरवाहा ह मोर सामना कर सकथे?”<verse eid="JER 50:44" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="45" style="v" sid="JER 50:45" />एकरसेति, सुनव कि यहोवा ह बेबिलोन के बिरूध का योजना बनाय हवय,</para>
  <para style="q2" vid="JER 50:45">अऊ बेबिलोनीमन के देस के बिरूध ओह का करे के ठाने हवय:</para>
  <para style="q1" vid="JER 50:45">पसु के झुंड के पीलामन ला घसीटके अलग करे जाही;</para>
  <para style="q2" vid="JER 50:45">ओमन के चरागन ह ओमन के डर के कारन होही।<verse eid="JER 50:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 50:46" />बेबिलोन ला कब्जा करे के अवाज ले धरती ह कांपही;</para>
  <para style="q2" vid="JER 50:46">येकर रोये के अवाज जाति-जाति के मनखेमन के बीच म सुनई पड़ही।<verse eid="JER 50:46" /></para>
  <chapter eid="JER 50" />
  <chapter number="51" style="c" sid="JER 51" />
  <para style="p">
    <verse number="1" style="v" sid="JER 51:1" />यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 51:1">“देखव, मेंह बेबिलोन अऊ लेब-कामै के मनखेमन के बिरूध म</para>
  <para style="q2" vid="JER 51:1">एक नास करइया आतमा ला भड़काहूं।<verse eid="JER 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 51:2" />मेंह बेबिलोन म परदेसीमन ला पठोहूं ओला पछरे बर</para>
  <para style="q2" vid="JER 51:2">ताकि ओमन ओला पछरें अऊ ओ देस ला बरबाद करें;</para>
  <para style="q1" vid="JER 51:2">ओकर बिपत्ति के दिन म</para>
  <para style="q2" vid="JER 51:2">ओमन चारों कोति ले ओकर बिरोध करहीं।<verse eid="JER 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 51:3" />धनुसधारी ला ओकर धनुस तियार करन झन दव,</para>
  <para style="q2" vid="JER 51:3">अऊ न ही ओला अपन हथियार ला बांधन दव।</para>
  <para style="q1" vid="JER 51:3">ओकर जवानमन ला झन छोंड़व;</para>
  <para style="q2" vid="JER 51:3">ओकर सेना ला पूरा नास कर दव।<verse eid="JER 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 51:4" />ओमन बेबिलोन के गलीमन म,</para>
  <para style="q2" vid="JER 51:4">भयंकर रूप से घायल मरे परे होहीं।<verse eid="JER 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 51:5" />काबरकि इसरायल अऊ यहूदा के देस ह</para>
  <para style="q2" vid="JER 51:5">ओमन के परमेसर, सर्वसक्तिमान यहोवा के दुवारा तियागे नइं गे हवय,</para>
  <para style="q1" vid="JER 51:5">हालाकि ओमन के देस<note caller="+" style="f"><char style="fr" closed="false">51:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बेबिलोनीमन के देस</char></note> ह</para>
  <para style="q2" vid="JER 51:5">इसरायल के पबितर परमेसर के नजर म अपराध ले भरे हवय।<verse eid="JER 51:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 51:6" />“बेबिलोन ले भागव!</para>
  <para style="q2" vid="JER 51:6">अपन परान बचाय बर भागव!</para>
  <para style="q2" vid="JER 51:6">ओकर पाप के कारन नास झन होवव।</para>
  <para style="q1" vid="JER 51:6">येह यहोवा के बदला लेय के बेरा अय;</para>
  <para style="q2" vid="JER 51:6">ओकर अधरम के मुताबिक ओला बदला दीही।<verse eid="JER 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 51:7" />बेबिलोन ह यहोवा के हांथ म एक सोन के कटोरा रिहिस;</para>
  <para style="q2" vid="JER 51:7">ओ कटोरा म ले पीके जम्मो धरती के मनखेमन मतवाला होवत रिहिन।</para>
  <para style="q1" vid="JER 51:7">जाति-जाति के मनखेमन ओकर मंद ला पीईन;</para>
  <para style="q2" vid="JER 51:7">ये खातिर ओमन अब पगला गे हवंय।<verse eid="JER 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 51:8" />बेबिलोन ह अचानक गिरही अऊ टूट जाही।</para>
  <para style="q2" vid="JER 51:8">ओकर बर बिलाप करव!</para>
  <para style="q1" vid="JER 51:8">ओकर घाव बर मलहम लानव;</para>
  <para style="q2" vid="JER 51:8">सायद ओह बने हो जावय।<verse eid="JER 51:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JER 51:9" />“ ‘हमन बेबिलोन ला बने करतेंन,</para>
  <para style="q2" vid="JER 51:9">पर ओह बने नइं हो सकय।</para>
  <para style="q1" vid="JER 51:9">आवव, हमन ओला छोंड़के अपन-अपन देस ला चले जावन,</para>
  <para style="q2" vid="JER 51:9">काबरकि ओला दंड देय के फैसला अकास तक हबरत हे,</para>
  <para style="q2" vid="JER 51:9">येह ऊंच स्वरग तक चले गे हवय।’<verse eid="JER 51:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 51:10" />“ ‘यहोवा ह हमन ला सही ठहिराय हे;</para>
  <para style="q2" vid="JER 51:10">एकरसेति आवव, हमन सियोन म बतावन</para>
  <para style="q2" vid="JER 51:10">कि यहोवा हमर परमेसर ह का करे हवय।’<verse eid="JER 51:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 51:11" />“तीरमन ला धार करव,</para>
  <para style="q2" vid="JER 51:11">ढालमन ला ले लव!</para>
  <para style="q1" vid="JER 51:11">यहोवा ह मादी के राजामन ला उभारे हवय,</para>
  <para style="q2" vid="JER 51:11">काबरकि ओकर उदेस्य ह बेबिलोन ला नास करे के हवय।</para>
  <para style="q1" vid="JER 51:11">यहोवा ह बदला लीही,</para>
  <para style="q2" vid="JER 51:11">ओह अपन मंदिर के बदला लीही।<verse eid="JER 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 51:12" />बेबिलोन के दीवार के बिरूध म एक झंडा ठाढ़ करव!</para>
  <para style="q2" vid="JER 51:12">पहरेदार के सक्ति बढ़ावव,</para>
  <para style="q1" vid="JER 51:12">पहरेदारमन ला पहरा देय बर बईठावव,</para>
  <para style="q2" vid="JER 51:12">घात लगाय के तियारी करव!</para>
  <para style="q1" vid="JER 51:12">काबरकि यहोवा ह बेबिलोन के बिरूध म फैसला देके,</para>
  <para style="q2" vid="JER 51:12">अपन उदेस्य ला पूरा करही।<verse eid="JER 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 51:13" />हे पानी के तीर म बसे</para>
  <para style="q2" vid="JER 51:13">अऊ धन-संपत्ति बनाके धनवान हो गय मनखेमन,</para>
  <para style="q1" vid="JER 51:13">तुम्हर अन्त ह आ गे हवय,</para>
  <para style="q2" vid="JER 51:13">तुम्हर नास होय के समय आ गे हवय।<verse eid="JER 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 51:14" />सर्वसक्तिमान यहोवा ह अपन खुद के कसम खाय हवय:</para>
  <para style="q2" vid="JER 51:14">फांफामन के दल सहीं, मेंह खचित तोला सैनिक दलमन ले भर दूहूं,</para>
  <para style="q2" vid="JER 51:14">अऊ ओमन तोर ऊपर बिजय के नारा लगाहीं।<verse eid="JER 51:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 51:15" />“ओह अपन सामर्थ ले धरती ला बनाईस;</para>
  <para style="q2" vid="JER 51:15">ओह अपन बुद्धि ले संसार के नीव रखिस</para>
  <para style="q2" vid="JER 51:15">अऊ अपन समझ के दुवारा अकासमन ला तानिस।<verse eid="JER 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 51:16" />जब ओह गरजथे, त अकासमन म पानी ह गरजथे;</para>
  <para style="q2" vid="JER 51:16">ओह धरती के छोर ले बादरमन ला उठाथे।</para>
  <para style="q1" vid="JER 51:16">ओह बारिस के संग बिजली चमकाथे</para>
  <para style="q2" vid="JER 51:16">अऊ अपन भंडारघर ले हवा चलाथे।<verse eid="JER 51:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 51:17" />“हर एक जन निरबुद्धि अऊ बिगर गियान के हवय;</para>
  <para style="q2" vid="JER 51:17">हर एक सुनार ह अपन बनाय मूरतीमन के कारन लज्जित हवय।</para>
  <para style="q1" vid="JER 51:17">जऊन मूरतीमन ला ओह बनाथे, ओमन एक धोखा अंय;</para>
  <para style="q2" vid="JER 51:17">ओमन म सांस ही नइं ए।<verse eid="JER 51:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 51:18" />ओ मूरतीमन बेकार अऊ हंसी उड़ाय के चीज अंय;</para>
  <para style="q2" vid="JER 51:18">जब ओमन के फैसला होही, त ओमन नास हो जाहीं।<verse eid="JER 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 51:19" />पर ओ, जऊन ह याकूब के भाग ए, ओह येमन सहीं नो हय,</para>
  <para style="q2" vid="JER 51:19">काबरकि ओह तो जम्मो चीजमन के बनानेवाला अय,</para>
  <para style="q1" vid="JER 51:19">ओकर उत्तराधिकार के मनखेमन घलो ओमा आथें—</para>
  <para style="q2" vid="JER 51:19">ओकर नांव सर्वसक्तिमान यहोवा अय।<verse eid="JER 51:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 51:20" />“तेंह मोर लड़ई के गदा,</para>
  <para style="q2" vid="JER 51:20">अऊ लड़ई करे बर मोर हथियार अस—</para>
  <para style="q1" vid="JER 51:20">तोर दुवारा मेंह जाति-जाति के मनखेमन ला कुटा-कुटा कर देथंव,</para>
  <para style="q2" vid="JER 51:20">तोर दुवारा राजमन ला नास कर देथंव,<verse eid="JER 51:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 51:21" />तोर दुवारा मेंह घोड़ा अऊ ओकर सवार ला कुटा-कुटा कर देथंव,</para>
  <para style="q2" vid="JER 51:21">तोर दुवारा मेंह रथ अऊ ओकर सारथी ला कुटा-कुटा कर देथंव,<verse eid="JER 51:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 51:22" />तोर दुवारा मेंह आदमी अऊ माईलोगन ला कुटा-कुटा कर देथंव,</para>
  <para style="q2" vid="JER 51:22">तोर दुवारा मेंह सियान अऊ लइका ला कुटा-कुटा कर देथंव,</para>
  <para style="q2" vid="JER 51:22">तोर दुवारा मेंह जवान मनखे अऊ जवान छोकरी ला कुटा-कुटा कर देथंव,<verse eid="JER 51:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 51:23" />तोर दुवारा मेंह चरवाहा अऊ ओकर झुंड ला कुटा-कुटा कर देथंव,</para>
  <para style="q2" vid="JER 51:23">तोर दुवारा मेंह किसान अऊ ओकर बईलामन ला कुटा-कुटा कर देथंव,</para>
  <para style="q2" vid="JER 51:23">तोर दुवारा ही मेंह राजपाल अऊ करमचारीमन ला घलो कुटा-कुटा कर देथंव।<verse eid="JER 51:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 51:24" />“तुम्हर आंखी के आघू म मेंह बेबिलोन अऊ बेबिलोनिया<note caller="+" style="f"><char style="fr" closed="false">51:24 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कसदीया</char></note> म रहइया जम्मो झन ला, ओमन के ओ जम्मो गलत काम के बदला दूहूं, जेला ओमन सियोन म करे हवंय,” यहोवा ह घोसना करत हे।<verse eid="JER 51:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 51:25" />“हे नास करइया पहाड़, तें जऊन ह जम्मो धरती ला</para>
  <para style="q2" vid="JER 51:25">नास करथस, मेंह तोर बिरूध म हंव,”</para>
  <para style="q2" vid="JER 51:25">यहोवा ह घोसना करत हे।</para>
  <para style="q1" vid="JER 51:25">“मेंह तोर बिरूध म अपन हांथ बढ़ाहूं,</para>
  <para style="q2" vid="JER 51:25">अऊ तोला खड़े चट्टान म ले लुड़का दूहूं,</para>
  <para style="q2" vid="JER 51:25">अऊ तोला एक जले हुए पहाड़ बना दूहूं।<verse eid="JER 51:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 51:26" />घर के कोना के पथरा बनाय बर तोर म ले कोनो पथरा नइं लिये जाही,</para>
  <para style="q2" vid="JER 51:26">न ही घर के नीव डाले बर तोर म ले कोनो पथरा लिये जाही,</para>
  <para style="q2" vid="JER 51:26">काबरकि तेंह हमेसा बर उजाड़ हो जाबे,” यहोवा ह घोसना करत हे।<verse eid="JER 51:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JER 51:27" />“देस म चेतउनी के एक झंडा ठाढ़ करव!</para>
  <para style="q2" vid="JER 51:27">जाति-जाति के मनखेमन के बीच म तुरही बजावव!</para>
  <para style="q1" vid="JER 51:27">ओकर बिरूध म जाति-जाति के मनखेमन ला लड़ई बर तियार करव;</para>
  <para style="q2" vid="JER 51:27">ओकर बिरूध म ये राजमन ला बलावव:</para>
  <para style="q2" vid="JER 51:27">अरारात, मिन्नी अऊ असकनज।</para>
  <para style="q1" vid="JER 51:27">ओकर बिरूध म एक सेनापति ठहिरावव;</para>
  <para style="q2" vid="JER 51:27">फांफामन के दल सहीं घोड़ामन ला ऊपर पठोवव।<verse eid="JER 51:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 51:28" />ओकर बिरूध म जाति-जाति के मनखेमन ला तियार करव—</para>
  <para style="q2" vid="JER 51:28">मादी के राजामन ला,</para>
  <para style="q1" vid="JER 51:28">ओमन के राजपाल अऊ ओमन के जम्मो करमचारी,</para>
  <para style="q2" vid="JER 51:28">अऊ ओ जम्मो देस के मनखेमन ला बलावव, जिहां ओमन सासन करथें।<verse eid="JER 51:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 51:29" />देस ह कांपत अऊ पीरा के मारे छटपटावत हे,</para>
  <para style="q2" vid="JER 51:29">काबरकि बेबिलोन के बिरूध यहोवा के उदेस्य ह पूरा होवत हे—</para>
  <para style="q1" vid="JER 51:29">बेबिलोन के देस ला उजाड़े जावत हे</para>
  <para style="q2" vid="JER 51:29">ताकि उहां कोनो झन रहंय।<verse eid="JER 51:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 51:30" />बेबिलोन के योद्धामन लड़े बर बंद कर दे हवंय;</para>
  <para style="q2" vid="JER 51:30">ओमन अपन गढ़मन के भीतर रहत हें।</para>
  <para style="q1" vid="JER 51:30">ओमन म अऊ ताकत नइं ए;</para>
  <para style="q2" vid="JER 51:30">ओमन दुरबल हो गे हवंय।</para>
  <para style="q1" vid="JER 51:30">ओकर निवासमन म आगी लगे हवय;</para>
  <para style="q2" vid="JER 51:30">ओकर कपाटमन के बेड़ीमन टूट गे हवंय।<verse eid="JER 51:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 51:31" />एक दूत ह दूसर दूत के पाछू</para>
  <para style="q2" vid="JER 51:31">अऊ एक संदेसिया ह दूसर संदेसिया के पाछू</para>
  <para style="q1" vid="JER 51:31">बेबिलोन के राजा ला ये समाचार देय बर जाथें</para>
  <para style="q2" vid="JER 51:31">कि ओकर पूरा सहर ला कब्जा कर लिये गे हवय,<verse eid="JER 51:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 51:32" />नदी पार करे के जगहमन ऊपर कब्जा कर लिये गे हवय,</para>
  <para style="q2" vid="JER 51:32">कछार-भुइयां म आगी लगा दिये गे हवय,</para>
  <para style="q2" vid="JER 51:32">अऊ सैनिकमन आतंकित हवंय।”<verse eid="JER 51:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 51:33" />सर्वसक्तिमान यहोवा, इसरायल के परमेसर ह ये कहत हे:</para>
  <para style="q1" vid="JER 51:33">“बेटी बेबिलोन ह कुचरे जाय के बेरा म</para>
  <para style="q2" vid="JER 51:33">एक कोठार सहीं अय;</para>
  <para style="q2" vid="JER 51:33">ओकर कटई के बेरा ह जल्दी आही।”<verse eid="JER 51:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JER 51:34" />“बेबिलोन के राजा नबूकदनेसर ह हमन ला खा डारे हवय,</para>
  <para style="q2" vid="JER 51:34">ओह हमन ला असमंजस म डार दे हवय,</para>
  <para style="q2" vid="JER 51:34">ओह हमन ला एक खाली बरतन सहीं कर दे हवय।</para>
  <para style="q1" vid="JER 51:34">सांप सहीं ओह हमन ला लील डारे हवय</para>
  <para style="q2" vid="JER 51:34">अऊ हमन ला खाके अपन पेट भर ले हवय,</para>
  <para style="q2" vid="JER 51:34">अऊ तब ओह हमन ला उछर दे हवय।<verse eid="JER 51:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 51:35" />जऊन चोट हमर देहें म देय गे हवय, ओ चोट बेबिलोन ला मिलय,”</para>
  <para style="q2" vid="JER 51:35">सियोन के रहइयामन कहिथें।</para>
  <para style="q1" vid="JER 51:35">“हमर खून के दोस ओमन ऊपर लगे, जऊन मन बेबिलोनिया म रहिथें,”</para>
  <para style="q2" vid="JER 51:35">यरूसलेम ह कहिथे।<verse eid="JER 51:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 51:36" />एकरसेति यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 51:36">“देख, मेंह तोर मुकदमा लड़हूं</para>
  <para style="q2" vid="JER 51:36">अऊ तोर बदला लूहूं;</para>
  <para style="q1" vid="JER 51:36">मेंह ओकर समुंदर</para>
  <para style="q2" vid="JER 51:36">अऊ ओकर सोतामन ला सूखा दूहूं।<verse eid="JER 51:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 51:37" />बेबिलोन ह एक खंडहर,</para>
  <para style="q2" vid="JER 51:37">अऊ सियारमन के एक डेरा,</para>
  <para style="q1" vid="JER 51:37">डर अऊ अपमान करे के चीज,</para>
  <para style="q2" vid="JER 51:37">अऊ एक अइसने जगह हो जाही, जिहां कोनो नइं रहिहीं।<verse eid="JER 51:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 51:38" />जम्मो बेबिलोनीमन जवान सिंहमन सहीं गरजथें,</para>
  <para style="q2" vid="JER 51:38">ओमन सिंह के पीलामन सहीं गुर्राथें।<verse eid="JER 51:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="JER 51:39" />पर जब ओमन उतावला होथें,</para>
  <para style="q2" vid="JER 51:39">तब मेंह ओमन बर एक भोज तियार करके दूहूं</para>
  <para style="q2" vid="JER 51:39">अऊ ओमन ला मतवाला कर दूहूं,</para>
  <para style="q1" vid="JER 51:39">ताकि ओमन हंसके चिचियावंय—</para>
  <para style="q2" vid="JER 51:39">अऊ तब हमेसा बर सो जावंय अऊ कभू झन उठंय,”</para>
  <para style="q2" vid="JER 51:39">यहोवा ह घोसना करत हे।<verse eid="JER 51:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 51:40" />“जइसे मेढ़ा-पीलामन ला,</para>
  <para style="q2" vid="JER 51:40">मेढ़ामन अऊ बोकरामन ला मारे बर लाय जाथे,</para>
  <para style="q2" vid="JER 51:40">वइसे मेंह ओमन ला खाल्हे लानहूं।<verse eid="JER 51:40" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="JER 51:41" />“सेसक<note caller="+" style="f"><char style="fr" closed="false">51:41 </char><char style="fq" closed="false">सेसक </char><char style="ft" closed="false">येह </char><char style="fqa" closed="false">बेबिलोन </char><char style="ft" closed="false">के नांव घलो अय</char></note> ह कइसे पकड़े जाही,</para>
  <para style="q2" vid="JER 51:41">जम्मो धरती के घमंड ह खतम हो जाही!</para>
  <para style="q1" vid="JER 51:41">बेबिलोन ह जाति-जाति के बीच ले</para>
  <para style="q2" vid="JER 51:41">कइसे उजड़ जाही!<verse eid="JER 51:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 51:42" />समुंदर ह बेबिलोन ऊपर आ जाही;</para>
  <para style="q2" vid="JER 51:42">येकर गरजत लहरामन म ओह बुड़ जाही।<verse eid="JER 51:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 51:43" />ओकर नगरमन उजड़ जाहीं,</para>
  <para style="q2" vid="JER 51:43">एक सूखा अऊ मरू-भुइयां हो जाहीं,</para>
  <para style="q1" vid="JER 51:43">एक अइसने देस, जिहां कोनो नइं रहंय,</para>
  <para style="q2" vid="JER 51:43">अऊ जेमा ले होके कोनो बाट नइं रेंगय।<verse eid="JER 51:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 51:44" />मेंह बेबिलोन म बेल देवता ला दंड दूहूं</para>
  <para style="q2" vid="JER 51:44">अऊ जऊन कुछू ओह निगल गे हवय, ओला ओकर ले उछरवाहूं।</para>
  <para style="q1" vid="JER 51:44">जाति-जाति के मनखेमन ओकर कोति अऊ नइं जाहीं।</para>
  <para style="q2" vid="JER 51:44">अऊ बेबिलोन के दीवार ह गिर जाही।<verse eid="JER 51:44" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="45" style="v" sid="JER 51:45" />“हे मोर मनखेमन, उहां ले बाहिर निकलव!</para>
  <para style="q2" vid="JER 51:45">अपन परान बचाके भागव!</para>
  <para style="q2" vid="JER 51:45">यहोवा के भयंकर कोरोध ले भागव।<verse eid="JER 51:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 51:46" />जब देस म झूठा खबर फईलथे,</para>
  <para style="q2" vid="JER 51:46">त झन घबरावव या झन डरव;</para>
  <para style="q1" vid="JER 51:46">एक साल एक झूठा खबर आथे, त आने साल दूसरा झूठा खबर,</para>
  <para style="q2" vid="JER 51:46">देस म हिंसा के झूठा खबर</para>
  <para style="q2" vid="JER 51:46">अऊ एक सासक के बिरूध दूसर सासक के झूठा खबर उड़ही।<verse eid="JER 51:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="JER 51:47" />काबरकि ओ समय ह जरूर आही</para>
  <para style="q2" vid="JER 51:47">जब मेंह बेबिलोन के मूरतीमन ला सजा दूहूं;</para>
  <para style="q1" vid="JER 51:47">ओकर पूरा देस ह कलंकित होही</para>
  <para style="q2" vid="JER 51:47">अऊ ओकर जम्मो मारे गय मनखेमन ओकरे भीतर म परे होहीं।<verse eid="JER 51:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="JER 51:48" />तब स्वरग अऊ धरती अऊ जऊन कुछू ओमा हवंय,</para>
  <para style="q2" vid="JER 51:48">ओमन आनंद के मारे बेबिलोन ऊपर चिचियाहीं,</para>
  <para style="q1" vid="JER 51:48">काबरकि उत्तर दिग ले</para>
  <para style="q2" vid="JER 51:48">नास करइया ह ओकर ऊपर हमला करही,”</para>
  <para style="q2" vid="JER 51:48">यहोवा ह घोसना करत हे।<verse eid="JER 51:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="JER 51:49" />“जइसने बेबिलोन के कारन</para>
  <para style="q2" vid="JER 51:49">जम्मो धरती म मनखेमन मारके गिराय गीन,</para>
  <para style="q1" vid="JER 51:49">वइसने ही इसरायल के मनखेमन के हतिया के कारन,</para>
  <para style="q2" vid="JER 51:49">जरूरी अय कि बेबिलोन के मनखेमन मारके गिराय जावंय।<verse eid="JER 51:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="JER 51:50" />हे तलवार ले बांचे मनखेमन,</para>
  <para style="q2" vid="JER 51:50">भागव अऊ उहां ठहिरे झन रहव!</para>
  <para style="q1" vid="JER 51:50">दूरिहा देस म यहोवा ला सुरता करव,</para>
  <para style="q2" vid="JER 51:50">अऊ यरूसलेम ला घलो सुरता करव।”<verse eid="JER 51:50" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="51" style="v" sid="JER 51:51" />“हमन कलंकित होवत हन,</para>
  <para style="q2" vid="JER 51:51">काबरकि हमर बेजत्ती करे गे हवय</para>
  <para style="q2" vid="JER 51:51">अऊ लज्जा से हमर चेहरामन ढंक गे हवंय,</para>
  <para style="q1" vid="JER 51:51">काबरकि परदेसीमन यहोवा के घर के</para>
  <para style="q2" vid="JER 51:51">पबितर जगहमन म घुस गे हवंय।”<verse eid="JER 51:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="JER 51:52" />“पर अइसन दिनमन आवत हें,” यहोवा ह घोसना करत हे,</para>
  <para style="q2" vid="JER 51:52">“जब मेंह ओकर मूरतीमन ला दंड दूहूं,</para>
  <para style="q1" vid="JER 51:52">अऊ ओकर जम्मो देस म</para>
  <para style="q2" vid="JER 51:52">मनखेमन घायल होके कराहत रहिहीं।<verse eid="JER 51:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="JER 51:53" />चाहे बेबिलोन ह अकास तक ऊंचहा हो जावय</para>
  <para style="q2" vid="JER 51:53">अऊ अपन ऊंचहा गढ़ ला किलाबंदी कर लेवय,</para>
  <para style="q2" vid="JER 51:53">तभो ले मेंह ओकर बिरूध म नास करइयामन ला पठोहूं,”</para>
  <para style="q2" vid="JER 51:53">यहोवा ह घोसना करत हे।<verse eid="JER 51:53" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="54" style="v" sid="JER 51:54" />“बेबिलोन ले रोये के अवाज आवत हे,</para>
  <para style="q2" vid="JER 51:54">बेबिलोनीमन के देस ले बड़े बिनास के अवाज आवत हे।<verse eid="JER 51:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="JER 51:55" />यहोवा ह बेबिलोन ला नास कर दीही;</para>
  <para style="q2" vid="JER 51:55">ओह ओकर बड़े कोलाहल ला बंद कर दीही।</para>
  <para style="q1" vid="JER 51:55">बईरीमन के लहरामन, समुंदर सहीं भयंकर होहीं;</para>
  <para style="q2" vid="JER 51:55">ओमन के अवाज के गरजन ह फेर सुनई दीही।<verse eid="JER 51:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="JER 51:56" />एक नास करइया ह बेबिलोन के बिरूध आही;</para>
  <para style="q2" vid="JER 51:56">ओकर योद्धामन पकड़ लिये जाहीं,</para>
  <para style="q2" vid="JER 51:56">अऊ ओमन के धनुसमन ला टोर दिये जाही।</para>
  <para style="q1" vid="JER 51:56">काबरकि यहोवा ह बदला लेवइया परमेसर अय;</para>
  <para style="q2" vid="JER 51:56">ओह पूरा बदला लीही।<verse eid="JER 51:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="JER 51:57" />मेंह ओकर करमचारी अऊ बुद्धिमान मनखेमन ला,</para>
  <para style="q2" vid="JER 51:57">अऊ संग म ओकर राजपाल, अधिकारी अऊ योद्धामन ला अइसन मतवार कर दूहूं</para>
  <para style="q1" vid="JER 51:57">कि ओमन हमेसा बर सो जाहीं अऊ फेर नइं जागहीं,”</para>
  <para style="q2" vid="JER 51:57">राजा ह घोसना करत हे, जेकर नांव सर्वसक्तिमान यहोवा अय।<verse eid="JER 51:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JER 51:58" />सर्वसक्तिमान यहोवा ह ये कहत हे:</para>
  <para style="q1" vid="JER 51:58">“बेबिलोन के मोटा दीवार ला नीव ले गिराय जाही</para>
  <para style="q2" vid="JER 51:58">अऊ ओकर ऊंचहा दुवारमन म आगी लगाय जाही;</para>
  <para style="q1" vid="JER 51:58">मनखेमन बेकार म अपनआप ला थकाहीं,</para>
  <para style="q2" vid="JER 51:58">जाति-जाति के मनखेमन के मेहनत ह आगी बर सिरिप लकरी के सहीं होही।”<verse eid="JER 51:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JER 51:59" />यहूदा के राजा सिदकियाह के राज के चौथा साल म, जब ओकर संग सरायाह ह बेबिलोन गीस, जऊन ह नेरियाह के बेटा महसेयाह के पोता अऊ राजभवन के अधिकारी घलो रिहिस, तब ओला यरमियाह अगमजानी ह ये संदेस दीस। <verse eid="JER 51:59" /><verse number="60" style="v" sid="JER 51:60" />यरमियाह ह ओ जम्मो बिपत्तिमन ला एक किताब म लिख ले रिहिस, जऊन ह बेबिलोन ऊपर पड़नेवाला रिहिस—बेबिलोन के बारे म ओ जम्मो बात लिखे गे रिहिस। <verse eid="JER 51:60" /><verse number="61" style="v" sid="JER 51:61" />यरमियाह ह सरायाह ला कहिस, “जब तें बेबिलोन म हबरबे, त जरूरी अय कि तें ये जम्मो बचन ला जोर से पढ़बे। <verse eid="JER 51:61" /><verse number="62" style="v" sid="JER 51:62" />तब कहिबे, ‘हे यहोवा, तेंह कहे हस कि तें ये जगह ला अइसने नास कर देबे कि येमा न तो मनखे अऊ न ही पसुमन रहिहीं; येह हमेसा बर उजाड़ हो जाही।’ <verse eid="JER 51:62" /><verse number="63" style="v" sid="JER 51:63" />जब तें ये किताब ला पढ़ लेबे, तब येमा एक पथरा ला बांधके येला फरात नदी म फटिक देबे, <verse eid="JER 51:63" /><verse number="64" style="v" sid="JER 51:64" />अऊ तब कहिबे, ‘जऊन बिपत्ति मेंह बेबिलोन ऊपर लानहूं, ओकर कारन येही किसम ले बेबिलोन ह बुड़ जाही अऊ फेर कभू नइं उठही। अऊ ओकर मनखेमन गिरहीं।’ ”</para>
  <para style="b" vid="JER 51:64" />
  <para style="b" vid="JER 51:64" />
  <para style="p" vid="JER 51:64">यरमियाह के बचन इहां खतम होथे।<verse eid="JER 51:64" /></para>
  <chapter eid="JER 51" />
  <chapter number="52" style="c" sid="JER 52" />
  <para style="s1">यरूसलेम के गिरई</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 52:1" />सिदकियाह ह इक्कीस साल के रिहिस, जब ओह राजा बनिस, अऊ ओह यरूसलेम म गियारह साल तक राज करिस। ओकर दाई के नांव हमूतल रिहिस, जऊन ह यरमियाह के बेटी रिहिस; हमूतल ह लिबना सहर के रिहिस। <verse eid="JER 52:1" /><verse number="2" style="v" sid="JER 52:2" />सिदकियाह ह यहोवा के नजर म दुस्ट काम करिस, जइसने यहोयाकीम ह करे रिहिस। <verse eid="JER 52:2" /><verse number="3" style="v" sid="JER 52:3" />यहोवा के गुस्सा के कारन यरूसलेम अऊ यहूदा ऊपर ये जम्मो बात होईस, अऊ आखिर म यहोवा ह ओमन ला अपन आघू ले भगा दीस।</para>
  <para style="p" vid="JER 52:3">सिदकियाह ह बेबिलोन के राजा के बिरूध बिदरोह करिस।<verse eid="JER 52:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 52:4" />एकरसेति सिदकियाह के राज के नौवां साल के दसवां महिना के दसवां दिन, बेबिलोन के राजा नबूकदनेसर ह अपन जम्मो सेना के संग यरूसलेम के बिरूध लड़ई करे बर निकलिस। ओमन सहर के बाहिर डेरा डालिन अऊ सहर ला चारों कोति ले घेर लीन। <verse eid="JER 52:4" /><verse number="5" style="v" sid="JER 52:5" />सहर म ये घेराबंदी सिदकियाह राजा के गियारहवां साल तक रिहिस।<verse eid="JER 52:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 52:6" />चौथा महिना के नौवां दिन ले सहर म अकाल के असर अतेक भयंकर हो गीस कि मनखेमन बर खाय बर कुछू नइं रिहिस। <verse eid="JER 52:6" /><verse number="7" style="v" sid="JER 52:7" />तब सहर के दीवार ला टोर दिये गीस, अऊ पूरा सेना ह रथिया राजा के बारी के लकठा म, दू ठन दीवार के बीच बने दुवार ले भाग गीस, हालाकि बेबिलोनीमन सहर ला घेरे रिहिन। ओमन अराबा<note caller="+" style="f"><char style="fr" closed="false">52:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">यरदन घाटी</char></note> कोति भागिन, <verse eid="JER 52:7" /><verse number="8" style="v" sid="JER 52:8" />पर बेबिलोनी सेना ह सिदकियाह राजा के पीछा करिस अऊ यरीहो के मैदान म ओकर करा हबर गीस। राजा के जम्मो सैनिकमन ओकर ले अलग होके तितिर-बितिर हो गीन, <verse eid="JER 52:8" /><verse number="9" style="v" sid="JER 52:9" />अऊ राजा ला पकड़ लिये गीस।</para>
  <para style="p" vid="JER 52:9">ओला हमात देस के रिबला सहर म बेबिलोन के राजा करा लाने गीस, जिहां ओला सजा सुनाय गीस। <verse eid="JER 52:9" /><verse number="10" style="v" sid="JER 52:10" />उहां रिबला म, बेबिलोन के राजा ह सिदकियाह के बेटामन ला ओकर आंखी के आघू म मार डारिस; ओह यहूदा के जम्मो करमचारीमन ला घलो मार डारिस। <verse eid="JER 52:10" /><verse number="11" style="v" sid="JER 52:11" />तब बेबिलोन के राजा ह सिदकियाह के आंखीमन ला निकाल दीस अऊ ओला कांसा के बेड़ीमन म जकड़के बेबिलोन ले गीस, जिहां ओह सिदकियाह ला ओकर मिरतू के दिन तक जेल म रखिस।<verse eid="JER 52:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 52:12" />नबूजरदान ह बेबिलोन के राजा के सेवा करय अऊ ओह साही पहरेदारमन के सेनापति रिहिस; ओह बेबिलोन के राजा नबूकदनेसर के राज के उन्नीसवां साल के पांचवां महिना के दसवां दिन यरूसलेम आईस। <verse eid="JER 52:12" /><verse number="13" style="v" sid="JER 52:13" />नबूजरदान ह यहोवा के मंदिर, राजमहल अऊ यरूसलेम के जम्मो घरमन म आगी लगा दीस। हर एक बड़े भवन ला ओह जला दीस। <verse eid="JER 52:13" /><verse number="14" style="v" sid="JER 52:14" />साही पहरेदारमन के सेनापति के अगुवई म, बेबिलोनीमन के जम्मो सेना ह यरूसलेम के चारों कोति के जम्मो दीवारमन ला गिरा दीस। <verse eid="JER 52:14" /><verse number="15" style="v" sid="JER 52:15" />पहरेदारमन के सेनापति नबूजरदान ह सबले गरीब कुछू मनखे अऊ सहर म बचे मनखेमन ला, बाकि बचे कारीगरमन अऊ जऊन मनखेमन बेबिलोन के राजा ला छोंड़ दे रिहिन, ओ जम्मो ला बंधुवा करके ले गीस। <verse eid="JER 52:15" /><verse number="16" style="v" sid="JER 52:16" />पर नबूजरदान ह देस म बाकि बचे बहुंत गरीब मनखेमन ला अंगूर के बारी अऊ खेतमन म काम करे बर छोंड़ दीस।<verse eid="JER 52:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 52:17" />बेबिलोनीमन यहोवा के मंदिर के कांसा के खंभामन ला, सरकनेवाला सहारामन ला अऊ कांसा के हौज ला टोर दीन अऊ ओमन जम्मो कांसा ला बेबिलोन ले गीन। <verse eid="JER 52:17" /><verse number="18" style="v" sid="JER 52:18" />ओमन हंड़िया, बेलचा, दीया के बाती ला कतरे के कतरनी, छिंचनेवाला कटोरा, बरतन अऊ मंदिर के सेवा म उपयोग होवइया जम्मो कांसा के चीजमन ला ले गीन। <verse eid="JER 52:18" /><verse number="19" style="v" sid="JER 52:19" />घमेला, धूपदान, छिंचे के कटोरा, हंड़िया, दीवट, बरतन अऊ पेय-बलिदान म उपयोग होइवया कटोरामन—ओ चीज, जेमन सुध सोन या चांदी के बने रिहिन, ओ जम्मो ला साही पहरेदारमन के सेनापति ह ले गीस।<verse eid="JER 52:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 52:20" />दू ठन खंभा के कांसा, हौज अऊ येकर खाल्हे के कांसा के बारह बईला, अऊ सरकनेवाला सहारामन, जेमन ला सुलेमान राजा ह यहोवा के मंदिर बर बनवाय रिहिस, ओ जम्मो ह अतेक जादा रिहिस कि ओमन ला तऊले नइं जा सकिस। <verse eid="JER 52:20" /><verse number="21" style="v" sid="JER 52:21" />हर एक खंभा के ऊंचई अठारह क्यूबीट अऊ बारह क्यूबीट के गोलई<note caller="+" style="f"><char style="fr" closed="false">52:21 </char><char style="ft" closed="false">लगभग 27 फीट ऊंचा अऊ 18 फीट गोलई</char></note> म रिहिस; हर एक के मोटई ह चार अंगरी<note caller="+" style="f"><char style="fr" closed="false">52:21 </char><char style="ft" closed="false">लगभग 3 ईंच</char></note> के रिहिस, अऊ ओमन खोखला रिहिन। <verse eid="JER 52:21" /><verse number="22" style="v" sid="JER 52:22" />एक खंभा के ऊपर कांसा के बने सिरा ह पांच क्यूबीट ऊंच रिहिस अऊ ओकर ऊपर चारों कोति कांसा के जाली अऊ अनार बनाके सजाय गे रिहिस। आने खंभा घलो अनारमन सहित वइसने ही बने रिहिस। <verse eid="JER 52:22" /><verse number="23" style="v" sid="JER 52:23" />बाजूमन म छियानबे ठन अनार बने रिहिन; जाली के ऊपर चारों कोति कुल एक सौ अनार बने रिहिन।<verse eid="JER 52:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 52:24" />पहरेदारमन के सेनापति ह मुखिया पुरोहित सरायाह, पद म ओकर बाद वाला पुरोहित सपनयाह अऊ तीन झन दुवारपाल ला कैदी के रूप म ले गीस। <verse eid="JER 52:24" /><verse number="25" style="v" sid="JER 52:25" />अऊ सहर म जऊन मन बांचे रिहिन, ओमा के सैनिकमन के मुखिया, अऊ सात साही सलाहकार ला ओह ले गीस। ओह ओ सचिव ला घलो ले गीस, जऊन ह देस के मनखेमन के जरूरी सैनिक सेवा भरती के मुखिया अधिकारी रिहिस, ओमा के साठ झन सहर म मिलिन। <verse eid="JER 52:25" /><verse number="26" style="v" sid="JER 52:26" />पहरेदारमन के सेनापति नबूजरदान ओ जम्मो झन ला लीस अऊ ओमन ला रिबला म बेबिलोन के राजा करा लानिस। <verse eid="JER 52:26" /><verse number="27" style="v" sid="JER 52:27" />उहां हमात देस के रिबला म, राजा ह ओमन ला मरवा दीस।</para>
  <para style="p" vid="JER 52:27">ये किसम ले यहूदा ह अपन देस ले दूर बंधुवई म चल दीस।<verse eid="JER 52:27" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="28" style="v" sid="JER 52:28" />येह ओ मनखेमन के गनती ए, जेमन ला नबूकदनेसर ह बंधुवई म ले गीस:</para>
  <para style="b" vid="JER 52:28" />
  <para style="li1" vid="JER 52:28">ओकर राज के सातवां साल म,</para>
  <para style="li2" vid="JER 52:28">3,023 यहूदी;<verse eid="JER 52:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="JER 52:29" />अपन राज के अठारहवां साल म,</para>
  <para style="li2" vid="JER 52:29">नबूकदनेसर ह यरूसलेम ले 832 मनखेमन ला बंधुवा करके ले गीस;<verse eid="JER 52:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="JER 52:30" />फेर नबूकदनेसर के राज के तेईसवां साल म,</para>
  <para style="li2" vid="JER 52:30">राजा के पहरेदारमन के सेनापति नबूजरदान ह 745 यहूदी मनखे ला बंधुवई म ले गीस।</para>
  <para style="b" vid="JER 52:30" />
  <para style="lf" vid="JER 52:30">जम्मो ला मिलाके 4,600 मनखे होईन।<verse eid="JER 52:30" /></para>
  <para style="s1">यहोयाकीन ला छोंड़ दिये जाथे</para>
  <para style="p">
    <verse number="31" style="v" sid="JER 52:31" />यहूदा के राजा यहोयाकीन के बंधुवई के सैंतीसवां साल म, जब एवील-मरोदक ह बेबिलोन के राजा बनिस, त बारहवां महिना के पच्चीसवां दिन, ओह यहूदा के राजा यहोयाकीन ला छोंड़ दीस अऊ ओला जेल ले मुक्त कर दीस। <verse eid="JER 52:31" /><verse number="32" style="v" sid="JER 52:32" />अऊ ओह ओकर संग मया ले बात करिस अऊ ओला ओ राजामन ले एक ऊंच आदर के पद दीस, जेमन ओकर संग बेबिलोन म रिहिन। <verse eid="JER 52:32" /><verse number="33" style="v" sid="JER 52:33" />एकरसेति यहोयाकीन ह अपन जेल के कपड़ा ला उतार लीस अऊ जिनगी भर हर दिन राजा के मेज म जेवन करिस। <verse eid="JER 52:33" /><verse number="34" style="v" sid="JER 52:34" />अऊ हर दिन के खरचा बर बेबिलोन के राजा ह यहोयाकीन बर एक भत्ता ठहिराय रिहिस, जऊन ह ओला ओकर मिरतू के दिन तक जिनगी भर मिलिस।<verse eid="JER 52:34" /></para>
  <chapter eid="JER 52" />
</usx>