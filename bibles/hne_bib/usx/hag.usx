<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAG" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">हाग्गै</para>
  <para style="toc1">हाग्गै के किताब</para>
  <para style="toc2">हाग्गै</para>
  <para style="toc3">हाग्गै</para>
  <para style="mt1">हाग्गै</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="HAG 1" />
  <para style="s1">यहोवा के भवन ला बनाय बर बुलावा</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 1:1" />दारा राजा के सासनकाल के दूसर साल के छठवां महिना के पहिली दिन, यहोवा के ये बचन, हाग्गै अगमजानी के दुवारा, सालतीएल के बेटा जरूब्बाबेल करा, जऊन ह यहूदा के राजपाल रिहिस, अऊ योसादाक के बेटा यहोसू महा पुरोहित करा पहुंचिस:<verse eid="HAG 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HAG 1:2" />सर्वसक्तिमान यहोवा ह ये कहत हे: “ये मनखेमन कहिथें, ‘यहोवा के भवन ला फेर बनाय के समय अभी नइं आय हवय।’ ”<verse eid="HAG 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HAG 1:3" />तब यहोवा के बचन हाग्गै अगमजानी के दुवारा आईस: <verse eid="HAG 1:3" /><verse number="4" style="v" sid="HAG 1:4" />“का ये समय ए कि तुमन खुद अपन बढ़िया घर म रहव, अऊ ये घर ह उजार परे रहय?”<verse eid="HAG 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HAG 1:5" />अब सर्वसक्तिमान यहोवा ह ये कहत हे: “अपन चालचलन ऊपर सही धियान देवव। <verse eid="HAG 1:5" /><verse number="6" style="v" sid="HAG 1:6" />तुमन बहुंते बोय रहेव, पर कम फसल मिलिस। तुमन खाथव, पर तुम्हर पेट कभू नइं भरय। तुमन पीथव, पर तुम्हर पीयास कभू नइं बुझय। तुमन ओनहा पहिरथव, पर ओकर ले तुमन ला गरमी नइं मिलय। तुमन मजदूरी कमाथव, पर येह कइसन खरचा हो जाथे, तुमन ला पता नइं चलय।”<verse eid="HAG 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HAG 1:7" />सर्वसक्तिमान यहोवा ह ये कहत हे: “अपन चालचलन ऊपर सही धियान देवव। <verse eid="HAG 1:7" /><verse number="8" style="v" sid="HAG 1:8" />ऊपर पहाड़मन म जावव अऊ इमारती लकरी खाल्हे लानके मोर भवन ला बनावव, ताकि येकर से मोला खुसी मिलय अऊ मोर आदर होवय,” यहोवा ह कहत हे। <verse eid="HAG 1:8" /><verse number="9" style="v" sid="HAG 1:9" />“तुमन बहुंत फसल पाय के आसा करत रहेव, पर थोरकन ही मिलिस। अऊ जब तुमन ओला घर लेके आयेव, त मेंह ओला उड़ा देंव। काबर?” सर्वसक्तिमान यहोवा ह घोसना करत हे। “काबरकि मोर भवन ह उजार परे हवय, अऊ तुमन म ले हर एक झन अपन-अपन घर म ब्यस्त हवव। <verse eid="HAG 1:9" /><verse number="10" style="v" sid="HAG 1:10" />एकरसेति, तुम्हर कारन ही अकास ह ओस गिरई अऊ धरती ह अनाज उपजई ला बंद कर दे हवय। <verse eid="HAG 1:10" /><verse number="11" style="v" sid="HAG 1:11" />मेंह हुकूम दे हंव कि खेत अऊ पहाड़मन म, अनाज, नवां अंगूर के मंद, जैतून तेल म अऊ भुइयां के हर एक ऊपज म, मनखे अऊ घरेलू-पसुमन म, अऊ तुम्हर हांथ के जम्मो मेहनत म अकाल पड़य।”<verse eid="HAG 1:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="HAG 1:12" />तब सालतीएल के बेटा जरूब्बाबेल, योसादाक के बेटा यहोसू महा पुरोहित, अऊ जम्मो बांचे मनखेमन<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बंधुवई ले लहुंटे जम्मो मनखेमन</char></note> यहोवा, अपन परमेसर के गोठ अऊ हाग्गै अगमजानी के संदेस के पालन करिन, काबरकि यहोवा ओमन के परमेसर ह ओला भेजे रिहिस। अऊ मनखेमन यहोवा के भय मानिन।<verse eid="HAG 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 1:13" />तब यहोवा के संदेसिया, हाग्गै ह मनखेमन ला यहोवा के ये संदेस दीस: “मेंह तुम्हर संग हवंव,” यहोवा ह घोसना करत हे। <verse eid="HAG 1:13" /><verse number="14" style="v" sid="HAG 1:14" />तब यहोवा ह सालतीएल के बेटा जरूब्बाबेल के आतमा ला, जऊन ह यहूदा के राजपाल रिहिस, अऊ योसादाक के बेटा यहोसू महा पुरोहित के आतमा ला, अऊ जम्मो बांचे मनखेमन के आतमा ला उभारिस। ओमन आईन अऊ सर्वसक्तिमान यहोवा, अपन परमेसर के भवन ला फेर बनाय के सुरू करिन, <verse eid="HAG 1:14" /><verse number="15" style="v" sid="HAG 1:15" />ये काम छठवां महिना के चौबीसवां दिन सुरू होईस।</para>
  <para style="s1" vid="HAG 1:15">नवां भवन के परतिगियां करे गय महिमा</para>
  <para style="p" vid="HAG 1:15">राजा दारा के सासनकाल के दूसर बछर म,<verse eid="HAG 1:15" /></para>
  <chapter eid="HAG 1" />
  <chapter number="2" style="c" sid="HAG 2" />
  <para style="nb">
    <verse number="1" style="v" sid="HAG 2:1" />सातवां महिना के इक्कीसवां दिन, यहोवा के बचन ह हाग्गै अगमजानी के दुवारा पहुंचिस: <verse eid="HAG 2:1" /><verse number="2" style="v" sid="HAG 2:2" />“सालतीएल के बेटा, यहूदा के राजपाल जरूब्बाबेल, अऊ योसादाक<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">यहोसादाक </char><char style="ft" closed="false">जऊन ह </char><char style="fq" closed="false">योसादाक </char><char style="ft" closed="false">के एक आने नांव ए</char></note> के बेटा यहोसू महा पुरोहित, अऊ जम्मो बांचे मनखेमन ले गोठिया। ओमन ले पुछ, <verse eid="HAG 2:2" /><verse number="3" style="v" sid="HAG 2:3" />‘तुमन म ले अब कोन बांचे हवय, जऊन ह ये भवन ला येकर पहिली के महिमा म देखे हवय? अब येह तुमन ला का दसा म दिखत हवय? का तुमन ला ये नइं लगत हे कि येमा अब कुछू नइं रही गे हवय? <verse eid="HAG 2:3" /><verse number="4" style="v" sid="HAG 2:4" />पर अब, हे जरूब्बाबेल, मजबूत बन,’ यहोवा ह घोसना करत हे। ‘हे योसादाक के बेटा यहोसू महा पुरोहित, मजबूत बन। हे देस के जम्मो मनखेमन, मजबूत बनव,’ यहोवा ह घोसना करत हे, ‘अऊ काम करव। काबरकि मेंह तुम्हर संग हवंव,’ सर्वसक्तिमान यहोवा ह घोसना करत हे। <verse eid="HAG 2:4" /><verse number="5" style="v" sid="HAG 2:5" />‘जब मिसर देस ले तुमन निकले रहेव, तब मेंह तुमन ले ये करार करे रहेंव। अऊ मोर आतमा ह तुम्हर बीच म हवय। तुमन झन डरव।’<verse eid="HAG 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAG 2:6" />“सर्वसक्तिमान यहोवा ह ये कहत हे: ‘थोरकन समय बाद, एक बार फेर मेंह अकास अऊ धरती, समुंदर अऊ सूखा भुइयां ला कंपाहूं। <verse eid="HAG 2:6" /><verse number="7" style="v" sid="HAG 2:7" />मेंह जम्मो देसमन ला कंपाहूं, अऊ जम्मो जाति के मनखेमन के ईछा ह पूरा होही, अऊ मेंह ये भवन ला महिमा ले भर दूहूं,’ सर्वसक्तिमान यहोवा ह कहत हे। <verse eid="HAG 2:7" /><verse number="8" style="v" sid="HAG 2:8" />‘चांदी ह मोर अय अऊ सोन ह घलो मोर अय,’ सर्वसक्तिमान यहोवा ह घोसना करत हे। <verse eid="HAG 2:8" /><verse number="9" style="v" sid="HAG 2:9" />‘ये अभी के भवन के महिमा ह पहिले भवन के महिमा ले बढ़के होही,’ सर्वसक्तिमान यहोवा ह कहत हे। ‘अऊ ये जगह म मेंह सांति दूहूं,’ सर्वसक्तिमान यहोवा ह घोसना करत हे।”<verse eid="HAG 2:9" /></para>
  <para style="s1">असुध मनखेमन बर आसीस</para>
  <para style="p">
    <verse number="10" style="v" sid="HAG 2:10" />राजा दारा के सासनकाल के दूसर साल के नौवां महिना के चौबीसवां दिन, यहोवा के बचन हाग्गै अगमजानी करा पहुंचिस: <verse eid="HAG 2:10" /><verse number="11" style="v" sid="HAG 2:11" />“सर्वसक्तिमान यहोवा ह ये कहत हे: ‘पुरोहितमन ले पुछ कि कानून ह का कहिथे: <verse eid="HAG 2:11" /><verse number="12" style="v" sid="HAG 2:12" />यदि कोनो मनखे अपन ओढ़ना म लपेटके पबितर मांस ले जाथे, अऊ ओ ओढ़ना ले कोनो रोटी या खाना, कुछू अंगूर के मंद, जैतून तेल या कोनो आने जेवन छू जाथे, त का ओ चीज घलो पबितर हो जाही?’ ”</para>
  <para style="p" vid="HAG 2:12">पुरोहितमन जबाब दीन, “नइं।”<verse eid="HAG 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 2:13" />तब हाग्गै ह पुछिस, “कोनो लास ला छुए के सेति यदि कोनो मनखे ह असुध हवय, अऊ ओह येमा के कोनो चीज ला छू लेथे, त का ओ चीज घलो असुध हो जाही?”</para>
  <para style="p" vid="HAG 2:13">पुरोहितमन जबाब दीन, “हव, ओह असुध हो जाही।”<verse eid="HAG 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HAG 2:14" />तब हाग्गै ह कहिस, “ ‘मोर नजर म ये मनखेमन अऊ ये जाति घलो अइसनेच अंय,’ यहोवा ह घोसना करत हे। ‘जऊन कुछू ओमन करथें अऊ जऊन कुछू ओमन उहां चघाथें, ओह असुध अय।<verse eid="HAG 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HAG 2:15" />“ ‘अब धियान देके आज ले ये बात ऊपर बिचार करव—सोच-बिचार करव कि पहिले चीजमन कइसे रिहिन, जब यहोवा के मंदिर म एक पथरा ऊपर दूसर पथरा नइं रखे गे रिहिस। <verse eid="HAG 2:15" /><verse number="16" style="v" sid="HAG 2:16" />ओ समय, जब कोनो बीस नाप<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">लगभग 200 किलोग्राम</char></note> अनाज के ढेर के आसा म आवय, त ओला सिरिप दस नाप<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">लगभग 100 किलोग्राम</char></note> ही मिले। जब कोनो अंगूर के मंद के कुंड ले पचास नाप<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">लगभग 100 लीटर</char></note> मंद लेय बर जावय, त उहां ओला सिरिप बीस<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">लगभग 40 लीटर</char></note> ही मिले। <verse eid="HAG 2:16" /><verse number="17" style="v" sid="HAG 2:17" />मेंह तुम्हर जम्मो खेती के काम म सूखा अऊ गेरूई रोग लानेंव अऊ फसल ऊपर करा गिरायेंव, तभो ले तुमन मोर मेर लहुंटके नइं आयेव,’ यहोवा ह घोसना करत हे। <verse eid="HAG 2:17" /><verse number="18" style="v" sid="HAG 2:18" />‘आज ले, नौवां महिना के ये चौबीसवां दिन ले ओ दिन के बारे म धियान देके सोच-बिचार करव, जब यहोवा के मंदिर के नीव डारे गे रिहिस। धियान देके सोच-बिचार करव: <verse eid="HAG 2:18" /><verse number="19" style="v" sid="HAG 2:19" />का अभी तक ले कोनो बीजा ह कोठार म परे हवय? अभी तक ले अंगूर के नार, अंजीर के रूख, अनार के रूख अऊ जैतून के रूख म फर नइं लगे हवंय।</para>
  <para style="p" vid="HAG 2:19">“ ‘पर आज ले में तुमन ला आसीस दूहूं।’ ”<verse eid="HAG 2:19" /></para>
  <para style="s1">जरूब्बाबेल, यहोवा के मुहरवाला मुंदरी</para>
  <para style="p">
    <verse number="20" style="v" sid="HAG 2:20" />ओही महिना के चौबीसवां दिन, दूसर बार यहोवा के बचन हाग्गै करा आईस: <verse eid="HAG 2:20" /><verse number="21" style="v" sid="HAG 2:21" />“यहूदा के राजपाल जरूब्बाबेल ला कह कि मेंह अकास अऊ धरती ला कंपाहूं। <verse eid="HAG 2:21" /><verse number="22" style="v" sid="HAG 2:22" />मेंह राज सिंघासनमन ला उलट दूहूं अऊ बिदेसी राजमन के सक्ति ला चकनाचूर कर दूहूं। मेंह रथ अऊ ओमन के सारथीमन ला पटक दूहूं; घोड़ामन सहित ओमन के घुड़सवारमन एक-दूसर के तलवार ले मारे जाहीं।<verse eid="HAG 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HAG 2:23" />“ ‘ओ दिन,’ सर्वसक्तिमान यहोवा ह घोसना करत हे, ‘हे सालतीएल के बेटा मोर सेवक जरूब्बाबेल, मेंह तोला लूहूं,’ यहोवा ह घोसना करत हे, ‘अऊ मेंह तोला अपन मुहरवाला मुंदरी सहीं बना दूहूं, काबरकि मेंह तोला चुने हवंव,’ सर्वसक्तिमान यहोवा ह घोसना करत हे।”<verse eid="HAG 2:23" /></para>
  <chapter eid="HAG 2" />
</usx>