<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">इफिसुस</para>
  <para style="toc1">इफिसुस के कलीसिया ला पौलुस के चिट्ठी</para>
  <para style="toc2">इफिसुस</para>
  <para style="toc3">इफि</para>
  <para style="mt1">इफिसुस</para>
  <para style="mt2">के कलीसिया ला पौलुस के चिट्ठी</para>
  <chapter number="1" style="c" sid="EPH 1"/>
  <para style="po">
    <verse number="1" style="v" sid="EPH 1:1"/>में, पौलुस जऊन ह कि परमेसर के ईछा ले मसीह यीसू के एक प्रेरित अंव,</para>
  <para style="po" vid="EPH 1:1">इफिसुस सहर के परमेसर के ओ संतमन ला ये चिट्ठी लिखत हंव, जऊन मन मसीह यीसू म बिसवासयोग्य मनखे अंय:<verse eid="EPH 1:1"/></para>
  <para style="po">
    <verse number="2" style="v" sid="EPH 1:2"/>तुमन ला, हमर ददा परमेसर अऊ परभू यीसू मसीह ले अनुग्रह अऊ सांति मिलय।<verse eid="EPH 1:2"/></para>
  <para style="s1">मसीह म आतमिक आसीस</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3"/>परमेसर अऊ हमर परभू यीसू मसीह के ददा के परसंसा होवय, जऊन ह हमन ला स्वरगीय ठऊर म मसीह म हर एक आतमिक आसीस दे हवय। <verse eid="EPH 1:3"/><verse number="4" style="v" sid="EPH 1:4"/>काबरकि परमेसर ह हमन ला संसार ला रचे के पहिली मसीह म चुन लीस कि हमन ओकर नजर म पबितर अऊ निरदोस ठहिरन। <verse eid="EPH 1:4"/><verse number="5" style="v" sid="EPH 1:5"/>अपन खुसी अऊ ईछा मुताबिक, मया म, ओह पहिलेच ले ये फैसला करे रिहिस कि हमन यीसू मसीह के दुवारा ओकर बेटा बनबो, <verse eid="EPH 1:5"/><verse number="6" style="v" sid="EPH 1:6"/>ताकि ओकर महिमामय अनुग्रह के परसंसा होवय, जेला ओह अपन मयारू बेटा म हमन ला मुफत म दे हवय। <verse eid="EPH 1:6"/><verse number="7" style="v" sid="EPH 1:7"/>यीसू मसीह म हमन ला ओकर लहू के दुवारा पाप ले मुक्ति मिलिस—याने कि पाप के छेमा परमेसर के बहुंतायत अनुग्रह के मुताबिक होईस, <verse eid="EPH 1:7"/><verse number="8" style="v" sid="EPH 1:8"/>जऊन ला ओह जम्मो बुद्धि अऊ समझ सहित हमर ऊपर बहुंतायत ले खरचा करिस। <verse eid="EPH 1:8"/><verse number="9" style="v" sid="EPH 1:9"/>अऊ ओह अपन ईछा के भेद ला, अपन सुमति के मुताबिक हमन ला बताईस; जऊन ला ओह मसीह म ठान ले रिहिस। <verse eid="EPH 1:9"/><verse number="10" style="v" sid="EPH 1:10"/>ताकि जब समय ह पूरा होही, त परमेसर ह अपन ये योजना ला पूरा करही—याने कि ओह स्वरग म अऊ धरती म जम्मो चीजमन ला एक संग एके झन मसीह के अधिकार म कर दीही।<verse eid="EPH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11"/>परमेसर के योजना के मुताबिक, येह पहिली ले फैसला करे गे हवय कि ओमा हमन घलो चुने गे हवन। ओह हर एक चीज ला अपन ईछा के उदेस्य के संग पूरा करथे, <verse eid="EPH 1:11"/><verse number="12" style="v" sid="EPH 1:12"/>ताकि हमन जऊन मन कि पहिली मसीह ऊपर आसा रखे रहेंन, ओकर महिमा के इस्तुति के कारन बनन। <verse eid="EPH 1:12"/><verse number="13" style="v" sid="EPH 1:13"/>अऊ तुमन घलो मसीह म मिलाय गे रहेव, जब तुमन सत के बचन ला सुनेव, जऊन ह उद्धार के सुघर संदेस अय। ओमा, जब तुमन बिसवास करेव, त परतिगियां करे गय पबितर आतमा के मुहर तुमन म लगिस। <verse eid="EPH 1:13"/><verse number="14" style="v" sid="EPH 1:14"/>अऊ ये पबितर आतमा ह हमर उत्तराधिकारी बने के गारंटी ए, जब तक कि परमेसर ह ओमन ला जऊन मन ओकर संपत्ति अंय, पाप ले मुक्ति नइं दे देवय, जेकर ले ओकर महिमा के इस्तुति होवय।<verse eid="EPH 1:14"/></para>
  <para style="s1">धनबाद अऊ पराथना</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15"/>एकरसेति, जब ले मेंह परभू यीसू म तुम्हर बिसवास के बारे अऊ जम्मो संतमन बर तुम्हर मया के बारे म सुने हवंव, <verse eid="EPH 1:15"/><verse number="16" style="v" sid="EPH 1:16"/>तब ले मेंह तुमन ला अपन पराथना म सुरता करत, तुम्हर बर धनबाद देवई बंद नइं करे हवंव। <verse eid="EPH 1:16"/><verse number="17" style="v" sid="EPH 1:17"/>मेंह हमेसा बिनती करथंव कि हमर परभू यीसू मसीह के परमेसर, महिमामय ददा ह तुमन ला बुद्धि अऊ आतमिक परकासन के आतमा देवय, ताकि तुमन ओला अऊ बने करके जानव। <verse eid="EPH 1:17"/><verse number="18" style="v" sid="EPH 1:18"/>मेंह ये घलो पराथना करथंव कि तुम्हर हिरदय के आंखीमन अंजोर होवंय, ताकि तुमन ओ आसा ला जानव, जेकर बर ओह तुमन ला बलाय हवय अऊ ये घलो जानव कि संतमन म ओकर उत्तराधिकार के महिमा के धन का अय, <verse eid="EPH 1:18"/><verse number="19" style="v" sid="EPH 1:19"/>अऊ हमन बर जऊन मन कि बिसवास करथन, ओकर अतुलनीय महान सक्ति का अय। ओ सक्ति ह ओकर सक्तिसाली बल के सहीं अय, जऊन ह काम करत हवय, <verse eid="EPH 1:19"/><verse number="20" style="v" sid="EPH 1:20"/>जेकर उपयोग ओह तब करिस, जब ओह मसीह ला मरे म ले जियाईस अऊ ओला स्वरगीय ठऊर म अपन जेवनी हांथ कोति बईठाईस। <verse eid="EPH 1:20"/><verse number="21" style="v" sid="EPH 1:21"/>मसीह ह जम्मो नियम, अधिकार, सक्ति अऊ परभूता के बहुंत ऊपर हवय अऊ ओह ओ हर एक नांव के ऊपर हवय, जऊन ला कि ये समय या अवइया समय म दिये जा सकथे। <verse eid="EPH 1:21"/><verse number="22" style="v" sid="EPH 1:22"/>अऊ परमेसर ह जम्मो चीजमन ला ओकर गोड़ खाल्हे कर दीस अऊ ओला जम्मो चीजमन के ऊपर कलीसिया बर मुखिया ठहिराईस, <verse eid="EPH 1:22"/><verse number="23" style="v" sid="EPH 1:23"/>अऊ ये कलीसिया ह ओकर देहें अय अऊ येह ओकर परिपूर्नता अय, जऊन ह हर एक चीज ला हर किसम ले पूरा करथे।<verse eid="EPH 1:23"/></para>
  <chapter eid="EPH 1"/>
  <chapter number="2" style="c" sid="EPH 2"/>
  <para style="s1">मसीह म जिनगी</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1"/>पहिली तुमन अपन अपराध अऊ पाप के कारन मर गे रहेव। <verse eid="EPH 2:1"/><verse number="2" style="v" sid="EPH 2:2"/>ये अपराध अऊ पाप म रहत, तुमन ये संसार के रीति अऊ सैतान के पाछू चलत रहेव, जऊन ह अकास के सासन करइया ए अऊ येह ओ आतमा अय, जऊन ह अब ओमन म काम करथे, जऊन मन परमेसर के हुकूम नइं मानंय। <verse eid="EPH 2:2"/><verse number="3" style="v" sid="EPH 2:3"/>हमन जम्मो झन एक समय येमन के बीच, हमर देहें के लालसा म दिन बितावत रहेंन अऊ देहें अऊ मन के ईछा ला पूरा करत रहेंन, अऊ ये किसम ले बाकि मानव-जाति सहीं, सुभाव ले कोरोध के संतान रहेंन। <verse eid="EPH 2:3"/><verse number="4" style="v" sid="EPH 2:4"/>पर परमेसर जऊन ह कि दया के धनी अय, हमर बर अपन बड़े मया के कारन, <verse eid="EPH 2:4"/><verse number="5" style="v" sid="EPH 2:5"/>ओह हमन ला मसीह के संग जियाईस, जब हमन अपराध म मर गे रहेंन—अनुग्रह के दुवारा तुम्हर उद्धार होईस। <verse eid="EPH 2:5"/><verse number="6" style="v" sid="EPH 2:6"/>अऊ परमेसर ह हमन ला मसीह के संग जियाईस अऊ मसीह यीसू म स्वरगीय राज म हमन ला ओकर संग बईठाईस, <verse eid="EPH 2:6"/><verse number="7" style="v" sid="EPH 2:7"/>ताकि अवइया समय म, ओह अपन अनुग्रह के असीम धन ला देखावय, जऊन ला ओह अपन दया ले मसीह यीसू म हमर ऊपर परगट करिस। <verse eid="EPH 2:7"/><verse number="8" style="v" sid="EPH 2:8"/>काबरकि अनुग्रह ले, बिसवास के दुवारा, तुम्हर उद्धार होईस। अऊ येह तुम्हर अपन कोति ले नइं, फेर येह परमेसर के दान ए। <verse eid="EPH 2:8"/><verse number="9" style="v" sid="EPH 2:9"/>अऊ येह मनखे के करम करे के कारन नो हय, ताकि कोनो घमंड झन करंय। <verse eid="EPH 2:9"/><verse number="10" style="v" sid="EPH 2:10"/>काबरकि परमेसर ह हमन ला बनाईस अऊ मसीह यीसू म ओ बने करम करे बर गढ़िस, जऊन ला परमेसर ह पहिली ले हमर बर तियार करे हवय कि हमन ओ काममन ला करन।<verse eid="EPH 2:10"/></para>
  <para style="s1">मसीह म जम्मो झन एक अन</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11"/>एकरसेति, सुरता रखव कि तुमन जनम ले आनजात अव। अऊ जऊन मन अपनआप ला खतना वाले कहिथें (ओमन के खतना, देहें म मनखेमन के हांथ ले करे गीस), ओमन तुमन ला बिगर खतना वाले कहिथें— <verse eid="EPH 2:11"/><verse number="12" style="v" sid="EPH 2:12"/>सुरता रखव, ओ समय तुमन बिगर मसीह के अऊ परमेसर के मनखे इसरायलीमन ले अलग रहेव अऊ परतिगियां के करार ले अनजान रहेव, अऊ बिगर आसा के अऊ संसार म बिगर परमेसर के रहेव। <verse eid="EPH 2:12"/><verse number="13" style="v" sid="EPH 2:13"/>मसीह यीसू म, तुमन एक समय बहुंत दूरिहा रहेव, पर अब मसीह के लहू के दुवारा तुमन लकठा म लाय गे हवव।<verse eid="EPH 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14"/>काबरकि मसीह ह खुद हमर सांति ए अऊ ओह यहूदी अऊ आनजातमन के बीच बईरता के ओ दीवार ला नास कर दे हवय, जऊन ह ओमन ला अलग कर दे रिहिस अऊ ओह दूनों दल ला एक कर दे हवय। <verse eid="EPH 2:14"/><verse number="15" style="v" sid="EPH 2:15"/>मसीह ह अपन देहें म यहूदी कानून ला, हुकूम अऊ नियम सहित खतम कर दीस, ताकि ये दूनों जाति म ले ओह अपन खुद म एक नवां मनखे बनावय अऊ ये किसम ले सांति के इस्‍थापना करय। <verse eid="EPH 2:15"/><verse number="16" style="v" sid="EPH 2:16"/>कुरूस म अपन मिरतू के दुवारा, मसीह ह ओमन के बईरता ला नास करिस अऊ ये किसम ले एक देहें म, ओह दूनों दल के मेल-मिलाप परमेसर करा कुरूस के दुवारा कराईस। <verse eid="EPH 2:16"/><verse number="17" style="v" sid="EPH 2:17"/>मसीह ह आईस अऊ तुमन ला जऊन मन बहुंत दूरिहा रहेव अऊ ओमन ला जऊन मन लकठा म रिहिन, दूनों ला सांति के परचार करिस। <verse eid="EPH 2:17"/><verse number="18" style="v" sid="EPH 2:18"/>काबरकि मसीह के दुवारा, हमन यहूदी अऊ आनजात, दूनों पबितर आतमा के जरिये परमेसर ददा करा आ सकथन।<verse eid="EPH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19"/>एकरसेति, तुमन अब परदेसी अऊ अजनबी नो हव, पर तुमन परमेसर के मनखेमन संग रहइया अऊ परमेसर के परिवार के सदस्य अव। <verse eid="EPH 2:19"/><verse number="20" style="v" sid="EPH 2:20"/>अऊ तुमन प्रेरित अऊ अगमजानीमन के नीव के ऊपर बनाय गे हवव, जेकर कोना के पथरा खुद मसीह यीसू अय। <verse eid="EPH 2:20"/><verse number="21" style="v" sid="EPH 2:21"/>ओमा जम्मो भवन ह एक संग जुड़े हवय अऊ परभू म एक पबितर मंदिर के रूप म बाढ़त जावत हवय। <verse eid="EPH 2:21"/><verse number="22" style="v" sid="EPH 2:22"/>अऊ ओमा तुमन घलो एक संग एक घर के रूप म बनाय जावत हवव, जऊन म परमेसर ह अपन आतमा म होके रहिथे।<verse eid="EPH 2:22"/></para>
  <chapter eid="EPH 2"/>
  <chapter number="3" style="c" sid="EPH 3"/>
  <para style="s1">पौलुस परचारक आनजातमन बर</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1"/>एकरे कारन, में पौलुस, तुम आनजातमन के हित म मसीह यीसू के कैदी अंव।<verse eid="EPH 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 3:2"/>तुमन परमेसर के ओ अनुग्रह के काम के बारे म जरूर सुने हवव, जऊन ला परमेसर ह तुम्हर बर मोला करे बर दे हवय। <verse eid="EPH 3:2"/><verse number="3" style="v" sid="EPH 3:3"/>अऊ ओ काम ये अय कि परमेसर ह अपन भेद ला परगट करिस अऊ मोला बताईस, जइसने कि मेंह पहिली थोरकन लिखे हवंव। <verse eid="EPH 3:3"/><verse number="4" style="v" sid="EPH 3:4"/>जब तुमन येला पढ़हू, तब तुमन मसीह के भेद के बारे म मोर गियान ला समझहू, <verse eid="EPH 3:4"/><verse number="5" style="v" sid="EPH 3:5"/>जऊन ला आने पीढ़ी के मनखेमन ला नइं बताय गीस, जइसने येह अब पबितर आतमा के दुवारा परमेसर के पबितर प्रेरित अऊ अगमजानीमन ऊपर परगट करे गे हवय। <verse eid="EPH 3:5"/><verse number="6" style="v" sid="EPH 3:6"/>अऊ भेद ह ये अय—कि आनजातमन, सुघर संदेस के दुवारा इसरायलीमन के संग वारिस, एकेच देहें के अंग अऊ मसीह यीसू म परतिगियां के भागी अंय।<verse eid="EPH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7"/>मेंह ये सुघर संदेस के सेवक, परमेसर के अनुग्रह के दान के दुवारा बने हवंव, जऊन ला कि ओकर सामर्थ के परभाव के दुवारा मोला दिये गीस। <verse eid="EPH 3:7"/><verse number="8" style="v" sid="EPH 3:8"/>हालाकि मेंह परमेसर के जम्मो पबितर मनखे म सबले छोटे अंव, तभो ले ये अनुग्रह मोला दिये गीस कि मेंह आनजातमन ला मसीह के अगम धन के परचार करंव, <verse eid="EPH 3:8"/><verse number="9" style="v" sid="EPH 3:9"/>अऊ येला अइसने साफ-साफ बतावंव कि हर एक झन ये भेद के बात ला देख सकंय, जऊन ह कि जम्मो चीज के गढ़इया परमेसर म जुग-जुग ले लुकाय रिहिस। <verse eid="EPH 3:9"/><verse number="10" style="v" sid="EPH 3:10"/>ताकि अब कलीसिया के दुवारा परमेसर के नाना किसम के बुद्धि ला ओ सासन करइया अऊ अधिकारीमन ला बताय जावय, जऊन मन स्वरगीय जगह म हवंय। <verse eid="EPH 3:10"/><verse number="11" style="v" sid="EPH 3:11"/>येह ओकर सदाकाल के मनसा के मुताबिक रिहिस, जऊन ला ओह हमर परभू मसीह यीसू म पूरा करिस। <verse eid="EPH 3:11"/><verse number="12" style="v" sid="EPH 3:12"/>अऊ मसीह म हमर संगति अऊ मसीह म हमर बिसवास के दुवारा, हमन निधड़क अऊ भरोसा के संग परमेसर करा आ सकथन। <verse eid="EPH 3:12"/><verse number="13" style="v" sid="EPH 3:13"/>एकरसेति, मेंह तुम्हर ले बिनती करत हंव कि जऊन दुख-तकलीफ तुम्हर बर मेंह सहथंव, ओकर कारन तुमन हिम्मत झन हारव। येह तुम्हर महिमा अय।<verse eid="EPH 3:13"/></para>
  <para style="s1">इफिसीमन बर पराथना</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14"/>एकरे कारन मेंह ददा परमेसर के आघू म माड़ी टेकथंव, <verse eid="EPH 3:14"/><verse number="15" style="v" sid="EPH 3:15"/>जेकर ले स्वरग म अऊ धरती ऊपर, बिसवासीमन के हर एक घराना के नांव रखे जाथे। <verse eid="EPH 3:15"/><verse number="16" style="v" sid="EPH 3:16"/>मेंह पराथना करथंव कि अपन महिमा के धन के मुताबिक, ओह तुम्हर अंतस ला अपन आतमा के दुवारा, सामर्थ के संग मजबूत करय, <verse eid="EPH 3:16"/><verse number="17" style="v" sid="EPH 3:17"/>ताकि मसीह ह तुम्हर हिरदय म बिसवास के दुवारा रहय। अऊ मेंह पराथना करथंव कि तुमन मया म जरी पकड़त अऊ बढ़त जावव, <verse eid="EPH 3:17"/><verse number="18" style="v" sid="EPH 3:18"/>ताकि संतमन संग तुम्हर करा घलो समझे के ये सक्ति होवय कि मसीह के मया ह कतेक लम्बा अऊ चाकर अऊ ऊंचहा अऊ गहिरा अय, <verse eid="EPH 3:18"/><verse number="19" style="v" sid="EPH 3:19"/>अऊ तुमन जान सकव कि मसीह के मया ह हमर गियान ले बढ़के होथे, ताकि तुमन परमेसर के जम्मो भरपूरी ले भर जावव।<verse eid="EPH 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20"/>अब ओ, जऊन ह अइसने सामर्थी अय कि हमन जतकी मांगथन या सोचथन, ओकर ले घलो बहुंत जादा कर सकथे, अऊ येह ओकर ओ सामर्थ के मुताबिक होथे, जऊन ह हमन म काम करथे। <verse eid="EPH 3:20"/><verse number="21" style="v" sid="EPH 3:21"/>ओकर महिमा, कलीसिया म अऊ मसीह यीसू म पीढ़ी दर पीढ़ी, जुग-जुग होवत रहय। आमीन।<verse eid="EPH 3:21"/></para>
  <chapter eid="EPH 3"/>
  <chapter number="4" style="c" sid="EPH 4"/>
  <para style="s1">कलीसिया म एकता</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1"/>तब परभू खातिर एक कैदी के रूप म, मेंह तुमन ले बिनती करथंव कि ओ बुलावा के लईक जिनगी जीयव, जेकर बर तुमन बलाय गे हवव। <verse eid="EPH 4:1"/><verse number="2" style="v" sid="EPH 4:2"/>पूरा दीन अऊ नम्र बनव अऊ धीर धरके मया म एक-दूसर के सह लेवव। <verse eid="EPH 4:2"/><verse number="3" style="v" sid="EPH 4:3"/>सांति के बंधन म बंधाके पबितर आतमा के एकता ला बनाय रखे के पूरा कोसिस करव। <verse eid="EPH 4:3"/><verse number="4" style="v" sid="EPH 4:4"/>एक देहें अऊ एक पबितर आतमा हवय, जइसने कि एके आसा हवय, जेकर बर परमेसर ह तुमन ला बलाय हवय। <verse eid="EPH 4:4"/><verse number="5" style="v" sid="EPH 4:5"/>एक परभू, एक बिसवास अऊ एक बतिसमा अय। <verse eid="EPH 4:5"/><verse number="6" style="v" sid="EPH 4:6"/>अऊ जम्मो झन के एके परमेसर अऊ ददा अय, जऊन ह जम्मो के ऊपर अऊ जम्मो के बीच म अऊ जम्मो म हवय।<verse eid="EPH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7"/>मसीह के ईछा के मुताबिक, हमन ले हर एक झन ला अनुग्रह दिये गे हवय। <verse eid="EPH 4:7"/><verse number="8" style="v" sid="EPH 4:8"/>एकरसेति परमेसर के बचन ह कहिथे:</para>
  <para style="q1" vid="EPH 4:8">“जब ओह ऊंचहा जगह म गीस,</para>
  <para style="q2" vid="EPH 4:8">ओह अपन संग बहुंत बंधुवामन ला ले गीस</para>
  <para style="q2" vid="EPH 4:8">अऊ मनखेमन ला बरदान दीस।”<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 68:18">भजन 68:18</ref></char></char></note><verse eid="EPH 4:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9"/>(ओह ऊपर चघिस—एकर मतलब होथे कि ओह पहिली, धरती के खाल्हे भागमन म उतरिस। <verse eid="EPH 4:9"/><verse number="10" style="v" sid="EPH 4:10"/>जऊन ह खाल्हे उतरिस, येह ओहीच अय, जऊन ह अकासमन ले घलो बहुंत ऊपर चघिस, ताकि जम्मो संसार ला अपन उपस्थिति ले भर देवय।) <verse eid="EPH 4:10"/><verse number="11" style="v" sid="EPH 4:11"/>येह ओ अय, जऊन ह कुछू झन ला प्रेरित, कुछू झन ला अगमजानी, कुछू झन ला सुघर संदेस के परचारक अऊ कुछू झन ला पास्टर अऊ गुरूजी होय के बरदान दीस, <verse eid="EPH 4:11"/><verse number="12" style="v" sid="EPH 4:12"/>ताकि परमेसर के मनखेमन सेवा के काम खातिर तियार करे जावंय अऊ मसीह के देहें<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">कलीसिया</char></note> ह बढ़त जावय, <verse eid="EPH 4:12"/><verse number="13" style="v" sid="EPH 4:13"/>जब तक कि हमन जम्मो झन बिसवास म अऊ परमेसर के बेटा के गियान म एक सहीं नइं होवन, अऊ परिपक्व मनखे बनके ओ पूरा सिद्धता ला नइं पा लेवन, जऊन ह मसीह म पाय जाथे।<verse eid="EPH 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14"/>तब हमन लइकामन सहीं नइं रहिबो, जऊन मन मनखेमन के धूर्तता अऊ चतुरई के दुवारा ओमन के धोखा देवइया योजना म पड़ जाथें अऊ ओमन के उपदेस के झोंका ले डावांडोल होके एती-ओती बहकाय जाथें। <verse eid="EPH 4:14"/><verse number="15" style="v" sid="EPH 4:15"/>पर मया म सच ला गोठियाबो अऊ हमन जम्मो बात म, ओमा बाढ़त जाबो जऊन ह मुड़<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मुखिया</char></note> अय याने कि मसीह। <verse eid="EPH 4:15"/><verse number="16" style="v" sid="EPH 4:16"/>अऊ ओकर ले जम्मो देहें जुड़े रहिथे, अऊ ओमा हर एक जोड़ के दुवारा जम्मो देहें ह एक संग बंधे रहिथे; अऊ जब हर भाग ह अपन काम करथे, त येह अपनआप मया म बढ़त अऊ बनत जाथे।<verse eid="EPH 4:16"/></para>
  <para style="s1">अंजोर के लइकामन सहीं जिनगी बितई</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17"/>एकरसेति, मेंह तुमन ला कहत हंव अऊ परभू म जोर देवत हंव कि जइसने आनजातमन अपन मन के बेकार सोच म चलथें, वइसने तुमन बिलकुल झन चलव। <verse eid="EPH 4:17"/><verse number="18" style="v" sid="EPH 4:18"/>ओमन के मन ह अंधियार म हवय। ओमन अपन हिरदय ला कठोर कर ले हवंय, जेकर कारन ओमन म अगियानता हवय अऊ अगियानता के कारन ओमन परमेसर के जिनगी ले अलग हो गे हवंय। <verse eid="EPH 4:18"/><verse number="19" style="v" sid="EPH 4:19"/>ओमन ला कोनो सरम नइं ए, ओमन अपनआप ला दुराचार के काम बर दे देय हवंय, ताकि हर किसम के असुध काम म हमेसा देहें के वासना म बने रहंय।<verse eid="EPH 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20"/>पर तुमन मसीह के अइसने सिकछा नइं पाय हवव। <verse eid="EPH 4:20"/><verse number="21" style="v" sid="EPH 4:21"/>तुमन सही रूप म, ओकर सुने हवव अऊ ओ सच्चई के सिकछा पाय हवव, जऊन ह यीसू म हवय। <verse eid="EPH 4:21"/><verse number="22" style="v" sid="EPH 4:22"/>एकरसेति अपन पुराना चालचलन ला छोंड़ देवव, जऊन ह तुम्हर पहिली के जिनगी ले संबंध रखथे अऊ अपन धोखा देवइया लालसा के दुवारा बिगड़त जाथे; <verse eid="EPH 4:22"/><verse number="23" style="v" sid="EPH 4:23"/>अऊ अपन मन के आतमा म नवां बन जावव; <verse eid="EPH 4:23"/><verse number="24" style="v" sid="EPH 4:24"/>अऊ नवां चालचलन ला धर लेवव, जऊन ह सही के धरमीपन अऊ पबितरता म, परमेसर के सरूप म सिरजे गे हवय।<verse eid="EPH 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25"/>एकरसेति, लबारी गोठियाय ला छोंड़ देवव अऊ तुमन ले हर एक झन अपन परोसी ले सच गोठियावय, काबरकि हमन जम्मो झन एके देहें के सदस्य अन। <verse eid="EPH 4:25"/><verse number="26" style="v" sid="EPH 4:26"/>गुस्सा त करव, फेर पाप झन करव;<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 4:4">भजन 4:4</ref></char></char></note> सूरज के बुड़त के पहिली अपन गुस्सा ला थूक देवव। <verse eid="EPH 4:26"/><verse number="27" style="v" sid="EPH 4:27"/>अऊ सैतान ला कोनो मऊका झन देवव। <verse eid="EPH 4:27"/><verse number="28" style="v" sid="EPH 4:28"/>जऊन ह चोरी करथे, ओह अब चोरी झन करय, पर ईमानदारी के काम म अपन हांथ ले मेहनत करय; ताकि जऊन मन ला जरूरत हवय, ओमन ला देय बर ओकर करा कुछू रहय।<verse eid="EPH 4:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29"/>तुम्हर मुहूं ले कोनो खराप बात झन निकलय, पर सिरिप ओहीच बात निकलय, जऊन ह जरूरत के मुताबिक आने मन के बढ़ती म मददगार होथे, ताकि जऊन मन सुनंय, ओमन ला एकर ले फायदा होवय। <verse eid="EPH 4:29"/><verse number="30" style="v" sid="EPH 4:30"/>अऊ परमेसर के पबितर आतमा ला उदास झन करव, जेकर दुवारा तुम्हर ऊपर ओ दिन बर मुहर लगे हवय, जब पाप ले मुक्ति होही। <verse eid="EPH 4:30"/><verse number="31" style="v" sid="EPH 4:31"/>जम्मो किसम के करू बात, रोस, गुस्सा, कलह, निन्दा अऊ जम्मो किसम के बईरता ला छोंड़ देवव। <verse eid="EPH 4:31"/><verse number="32" style="v" sid="EPH 4:32"/>एक-दूसर के ऊपर दया अऊ किरपा करव, अऊ जइसने परमेसर ह मसीह म तुमन ला छेमा करिस, वइसने तुमन घलो एक-दूसर ला छेमा करव।<verse eid="EPH 4:32"/></para>
  <chapter eid="EPH 4"/>
  <chapter number="5" style="c" sid="EPH 5"/>
  <para style="nb">
    <verse number="1" style="v" sid="EPH 5:1"/>एकरसेति, मयारू लइकामन सहीं परमेसर के अनुसरन करव, <verse eid="EPH 5:1"/><verse number="2" style="v" sid="EPH 5:2"/>अऊ मया के जिनगी जीयव, जइसने मसीह ह हमन ला मया करिस अऊ अपनआप ला हमर बर महकत भेंट अऊ बलिदान के रूप म परमेसर ला दे दीस।<verse eid="EPH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3"/>पर तुम्हर बीच म छिनारी या कोनो किसम के असुध बात या लालच के चरचा तक झन होवय, काबरकि ये बातमन परमेसर के पबितर मनखेमन बर उचित नो हंय। <verse eid="EPH 5:3"/><verse number="4" style="v" sid="EPH 5:4"/>अऊ तुम्हर बीच म न खराप बात, न मुरूखता के बात अऊ न खराप हंसी-ठट्ठा होवय, काबरकि ये बातमन तुम्हर बर ठीक नो हंय, पर तुम्हर बीच म धनबाद के बात होवय। <verse eid="EPH 5:4"/><verse number="5" style="v" sid="EPH 5:5"/>तुमन ये निस्चित जानव कि जऊन ह छिनार, असुध या लालची मनखे अय, ओह एक मूरती-पूजा करइया के सहीं अय अऊ अइसने मनखे बर मसीह के अऊ परमेसर के राज म कोनो भाग नइं ए। <verse eid="EPH 5:5"/><verse number="6" style="v" sid="EPH 5:6"/>कोनो तुमन ला बेकार के बात करके धोखा झन देवय, काबरकि अइसने बात के कारन परमेसर के परकोप ओमन ऊपर भड़कथे, जऊन मन ओकर बात नइं मानंय। <verse eid="EPH 5:6"/><verse number="7" style="v" sid="EPH 5:7"/>एकरसेति, ओमन के संग कोनो नाता झन रखव।<verse eid="EPH 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 5:8"/>काबरकि एक समय रिहिस, जब तुमन अंधियार म रहेव, पर अब तुमन परभू के चेला बने के कारन अंजोर म हवव। एकरसेति अंजोर के संतान सहीं जिनगी बितावव, <verse eid="EPH 5:8"/><verse number="9" style="v" sid="EPH 5:9"/>(काबरकि जिहां अंजोर हवय, उहां जम्मो किसम के भलई, धरमीपन अऊ सच्चई होथे) <verse eid="EPH 5:9"/><verse number="10" style="v" sid="EPH 5:10"/>अऊ ये पता लगावव कि परभू ह कोन बात ले खुस होथे। <verse eid="EPH 5:10"/><verse number="11" style="v" sid="EPH 5:11"/>अंधियार के बेकार के काम म भागी झन होवव; फेर ओमन के खरापी ला परगट करव। <verse eid="EPH 5:11"/><verse number="12" style="v" sid="EPH 5:12"/>काबरकि जऊन काम ओमन गुपत म करथें, ओकर बारे म चरचा करई घलो सरम के बात अय। <verse eid="EPH 5:12"/><verse number="13" style="v" sid="EPH 5:13"/>पर हर ओ चीज जऊन ह अंजोर के दुवारा परगट करे जाथे, ओह दिखे लगथे—अऊ हर ओ चीज जेला अंजोर करे जाथे, ओह एक अंजोर बन जाथे। <verse eid="EPH 5:13"/><verse number="14" style="v" sid="EPH 5:14"/>एकरे कारन, ये कहे गे हवय:</para>
  <para style="q1" vid="EPH 5:14">“हे सोवइया, जाग,</para>
  <para style="q2" vid="EPH 5:14">मरे मन ले जी उठ,</para>
  <para style="q2" vid="EPH 5:14">अऊ मसीह ह तोर ऊपर चमकन लगही।”<verse eid="EPH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15"/>एकरसेति बहुंत सचेत रहव कि तुमन जिनगी म कइसने चलत हव—मुरूख मनखे सहीं नइं, पर बुद्धिमानमन सहीं चलव। <verse eid="EPH 5:15"/><verse number="16" style="v" sid="EPH 5:16"/>तुमन ला मिले हर मऊका के जादा से जादा फायदा उठावव, काबरकि समय ह खराप हवय। <verse eid="EPH 5:16"/><verse number="17" style="v" sid="EPH 5:17"/>एकरसेति, मुरूख झन बनव, पर जानव कि परभू के मनसा का हवय। <verse eid="EPH 5:17"/><verse number="18" style="v" sid="EPH 5:18"/>मंद पीके मतवार झन बनव, काबरकि एकर ले बहुंत खराप काममन होथें। एकर बदले अपनआप ला पबितर आतमा ले भर लेवव। <verse eid="EPH 5:18"/><verse number="19" style="v" sid="EPH 5:19"/>एक-दूसर ले परमेसर के भजन, इस्तुति अऊ आतमिक गीत के संग गोठियावव। परभू बर अपन जम्मो हिरदय ले गावव अऊ बजावव। <verse eid="EPH 5:19"/><verse number="20" style="v" sid="EPH 5:20"/>अऊ हमेसा, हर एक बात बर, हमर परभू यीसू मसीह के नांव म परमेसर ददा ला धनबाद देवव।<verse eid="EPH 5:20"/></para>
  <para style="s1">घरवाला अऊ घरवाली</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21"/>मसीह के आदर म, एक-दूसर के अधीन रहव।<verse eid="EPH 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22"/>हे घरवालीमन, अपन-अपन घरवाला के अधीन रहव, जइसने कि परभू के अधीन रहिथव। <verse eid="EPH 5:22"/><verse number="23" style="v" sid="EPH 5:23"/>काबरकि घरवाला ह घरवाली के मुड़ अय, जइसने मसीह ह कलीसिया के मुड़ अय। कलीसिया ह ओकर देहें अऊ ओह कलीसिया के उद्धार करइया ए। <verse eid="EPH 5:23"/><verse number="24" style="v" sid="EPH 5:24"/>जइसने कलीसिया ह मसीह के अधीन रहिथे, वइसने घरवालीमन घलो हर एक बात म अपन घरवालामन के अधीन रहंय।<verse eid="EPH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25"/>हे घरवालामन, अपन-अपन घरवाली ला मया करव, जइसने मसीह ह कलीसिया ला मया करिस अऊ अपनआप ला ओकर बर दे दीस, <verse eid="EPH 5:25"/><verse number="26" style="v" sid="EPH 5:26"/>ताकि बचन के परचार के जरिये ओला पानी म धोके साफ करय अऊ ओला पबितर बनावय; <verse eid="EPH 5:26"/><verse number="27" style="v" sid="EPH 5:27"/>अऊ ओला एक अइसने महिमामय कलीसिया के रूप म अपनआप ला पेस करय, जऊन म न कोनो दाग, न झुर्री, न कोनो आने दोस रहय। पर ओह पबितर अऊ निरदोस होवय। <verse eid="EPH 5:27"/><verse number="28" style="v" sid="EPH 5:28"/>एही किसम ले घरवालामन बर उचित ए कि अपन-अपन घरवालीमन ले अपन खुद के देहें सहीं मया करंय। जऊन ह अपन घरवाली ले मया करथे, ओह अपनआप ले मया करथे। <verse eid="EPH 5:28"/><verse number="29" style="v" sid="EPH 5:29"/>कोनो मनखे अपन खुद के देहें ले घिन नइं करय, पर ओह ओकर पालन-पोसन करथे अऊ देखरेख करथे, जइसने कि मसीह ह कलीसिया के संग करथे; <verse eid="EPH 5:29"/><verse number="30" style="v" sid="EPH 5:30"/>काबरकि हमन ओकर देहें के अंग अन। <verse eid="EPH 5:30"/><verse number="31" style="v" sid="EPH 5:31"/>“एकरे कारन मरद ह अपन दाई-ददा ले अलग होके अपन घरवाली संग मिले रहिही। अऊ ओ दूनों एक तन होहीं।”<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">उत 2:24</ref></char></char></note> <verse eid="EPH 5:31"/><verse number="32" style="v" sid="EPH 5:32"/>येह एक बड़े भेद के बात अय—पर मेंह मसीह अऊ कलीसिया के बारे म कहत हवंव। <verse eid="EPH 5:32"/><verse number="33" style="v" sid="EPH 5:33"/>पर जइसने घलो होवय, तुमन ले हर एक झन अपन घरवाली ला अपन सहीं मया करय, अऊ घरवाली ह अपन घरवाला के आदरमान करय।<verse eid="EPH 5:33"/></para>
  <chapter eid="EPH 5"/>
  <chapter number="6" style="c" sid="EPH 6"/>
  <para style="s1">दाई-ददा अऊ लइकामन</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1"/>हे लइकामन हो, परभू म अपन दाई-ददा के बात मानव, काबरकि येह उचित अय। <verse eid="EPH 6:1"/><verse number="2" style="v" sid="EPH 6:2"/>“अपन दाई अऊ ददा के आदर करव”, जऊन ह एक परतिगियां के संग पहिली हुकूम ए, <verse eid="EPH 6:2"/><verse number="3" style="v" sid="EPH 6:3"/>“ताकि तुम्हर भलई होवय अऊ तुमन धरती म बहुंत दिन तक जीयत रहव।”<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 5:16">ब्यव 5:16</ref></char></char></note><verse eid="EPH 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4"/>हे ददामन<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">दाई-ददामन</char></note> हो, अपन लइकामन ला गुस्सा झन दिलावव, पर परभू के अनुसासन अऊ सिकछा के मुताबिक ओमन के पालन-पोसन करव।<verse eid="EPH 6:4"/></para>
  <para style="s1">मालिक अऊ गुलाम</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5"/>हे गुलाममन हो, जइसने तुमन मसीह के बात मानथव, वइसने आदर, भय, अऊ निस्कपट हिरदय ले अपन संसारिक मालिकमन के बात ला मानव। <verse eid="EPH 6:5"/><verse number="6" style="v" sid="EPH 6:6"/>जब ओमन तुमन ला देखत रहिथें, त सिरिप ओमन के दिल जीते बर ही ओमन के बात नइं मानव, पर मसीह के गुलाम सहीं अपन हिरदय ले परमेसर के ईछा म चलव। <verse eid="EPH 6:6"/><verse number="7" style="v" sid="EPH 6:7"/>पूरा हिरदय ले सेवा करव, ये समझके कि तुमन मनखेमन के नइं, पर परभू के सेवा करत हव, <verse eid="EPH 6:7"/><verse number="8" style="v" sid="EPH 6:8"/>काबरकि तुमन जानथव कि हर एक झन चाहे ओह गुलाम होवय या सुतंतर मनखे, जऊन भलई के काम ओह करथे, परभू ह ओला ओकर ईनाम दीही।<verse eid="EPH 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9"/>हे मालिकमन हो, ओहीच किसम ले तुमन अपन गुलाममन संग बरताव करव। ओमन ला झन डरावव-धमकावव, काबरकि तुमन जानथव कि ओमन के मालिक अऊ तुम्हर मालिक ओहीच अय, जऊन ह स्वरग म हवय, अऊ ओह काकरो संग पखियपात नइं करय।<verse eid="EPH 6:9"/></para>
  <para style="s1">परमेसर के हथियार</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10"/>आखिरी बात ये अय कि परभू म अऊ ओकर बड़े सामर्थ के परभाव म मजबूत बनव। <verse eid="EPH 6:10"/><verse number="11" style="v" sid="EPH 6:11"/>परमेसर के जम्मो हथियार ला बांध लेवव ताकि तुमन सैतान के छल-कपट के मुकाबला कर सकव। <verse eid="EPH 6:11"/><verse number="12" style="v" sid="EPH 6:12"/>काबरकि हमर लड़ई हाड़ा अऊ मांस ले बने मनखे के बिरोध म नो हय, पर हमर लड़ई ह ये अंधियार संसार के सासन करइयामन ले, अधिकारीमन ले अऊ अंधियार संसार के सक्तिमन के बिरोध म अय अऊ हमर लड़ई ह अकास म सैतान के आतमिक सेनामन के बिरोध म अय। <verse eid="EPH 6:12"/><verse number="13" style="v" sid="EPH 6:13"/>एकरसेति, परमेसर के जम्मो हथियार ले लव ताकि जब सैतान ह हमला करय, त तुमन अपन जगह म मजबूत ठाढ़े रह सकव, अऊ मजबूत ठाढ़े रहे बर जम्मो चीज करे के बाद, <verse eid="EPH 6:13"/><verse number="14" style="v" sid="EPH 6:14"/>सच के कमरपट्टा ले अपन कनिहां ला कस लेवव। धरमीपन के झिलम पहिर लेवव, <verse eid="EPH 6:14"/><verse number="15" style="v" sid="EPH 6:15"/>अऊ अपन गोड़मन म सांति के सुघर संदेस के तियारी के पनही पहिर लव। <verse eid="EPH 6:15"/><verse number="16" style="v" sid="EPH 6:16"/>ये जम्मो चीज के अलावा बिसवास के ढाल ले लव, जेकर ले तुमन ओ दुस्ट के जम्मो अगनी बान ला बुझा सकव। <verse eid="EPH 6:16"/><verse number="17" style="v" sid="EPH 6:17"/>उद्धार के टोप अऊ आतमा के तलवार जऊन ह कि परमेसर के बचन ए, ले लव।<verse eid="EPH 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 6:18"/>जम्मो किसम के पराथना अऊ बिनती के संग हर समय आतमा म पराथना करव। मन म येला रखके सचेत रहव अऊ जम्मो संत मनखेमन बर हमेसा पराथना करत रहव। <verse eid="EPH 6:18"/><verse number="19" style="v" sid="EPH 6:19"/>मोर बर घलो पराथना करव कि जब भी मेंह गोठियावंव, परमेसर ह मोला बचन देवय, ताकि निडर होके मेंह सुघर संदेस के भेद ला खोलके बता सकंव, <verse eid="EPH 6:19"/><verse number="20" style="v" sid="EPH 6:20"/>जेकर खातिर मेंह कैद म, एक राजदूत अंव। पराथना करव कि मेंह ये बात ला निधड़क बोलंव, जइसने कि मोला करना चाही।<verse eid="EPH 6:20"/></para>
  <para style="b"/>
  <para style="s1">आखिरी जोहार</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21"/>तुखिकुस ह हमर मयारू भाई अऊ परभू म बिसवासयोग्य सेवक ए। ओह तुमन ला हर एक बात बताही ताकि तुमन घलो जान लेवव कि मेंह कइसने हवंव अऊ का करत हवंव। <verse eid="EPH 6:21"/><verse number="22" style="v" sid="EPH 6:22"/>मेंह ओला तुम्हर करा एकर खातिर पठोवत हवंव कि तुमन जान लेवव कि हमन कइसने हवन अऊ ये घलो कि ओह तुमन के हिरदय ला उत्साहित करय।<verse eid="EPH 6:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23"/>परमेसर ददा अऊ परभू यीसू मसीह कोति ले भाईमन ला सांति अऊ बिसवास के संग मया मिलय।<verse eid="EPH 6:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="EPH 6:24"/>ओ जम्मो झन ला अनुग्रह मिलय, जऊन मन हमर परभू यीसू मसीह ले अइसने मया करथें, जऊन ह कभू खतम नइं होवय।<verse eid="EPH 6:24"/></para>
  <chapter eid="EPH 6"/>
</usx>
