<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  
  <para style="h">उतपत्ती</para>
  <para style="toc1">उतपत्ती के किताब</para>
  <para style="toc2">उतपत्ती</para>
  <para style="toc3">उत</para>
  <para style="mt1">उतपत्ती</para>
  <para style="mt2">के किताब</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s1">सुरूआत</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />सुरू<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">सुरू </char><char style="ft" closed="false">मतलब </char><char style="fqa" closed="false">सिरिस्टी के सुरूआत म</char></note> म परमेसर ह अकास अऊ धरती ला रचिस। <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />अऊ धरती ह बेडौल अऊ सुनसान परे रिहिस, अऊ गहिरा पानी के ऊपर अंधियार रिहिस, अऊ परमेसर के आतमा पानी के ऊपर किंदरत रिहिस।<verse eid="GEN 1:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3" />अऊ परमेसर ह कहिस, “अंजोर हो,” त अंजोर हो गीस। <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />परमेसर ह अंजोर ला देखिस कि येह बने हे, अऊ ओह अंजोर ला अंधियार ले अलग करिस। <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />परमेसर ह अंजोर ला “दिन,” अऊ अंधियार ला “रात” कहिस। अऊ सांझ होईस, फेर बिहान पहा गीस—ये किसम ले पहिला दिन हो गीस।<verse eid="GEN 1:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />फेर परमेसर ह कहिस, “पानी के बीच म एक अइसने अंतर होवय कि पानी ह पानी ले अलग हो जावय।” <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />तब परमेसर ह अकास-मंडल बनाईस अऊ अकास-मंडल के खाल्हे के पानी ला एकर ऊपर के पानी ले अलग कर दीस। अऊ वइसने हो गीस। <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />परमेसर ह ओ अकास-मंडल ला “अकास” कहिस। अऊ सांझ होईस, फेर बिहान पहा गीस—ये किसम ले दूसर दिन हो गीस।<verse eid="GEN 1:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />फेर परमेसर ह कहिस, “अकास के खाल्हे के पानी ह एके जगह म माढ़ जावय, अऊ सूखा भुइयां दिखय।” अऊ वइसने हो गीस। <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />परमेसर ह सूखा भुइयां ला “धरती” कहिस, अऊ जऊन पानी माढ़ गीस, ओला ओह “समुंदर” कहिस, अऊ परमेसर ह देखिस कि येह बढ़िया हे।<verse eid="GEN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 1:11" />फेर परमेसर ह कहिस, “धरती म हरियर घांस, बीजावाले पऊधा अऊ फर देवइया रूख, अऊ रूख के फर म अपन-अपन किसम के मुताबिक बीजा होवय।” अऊ वइसने हो गीस। <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />ये किसम ले धरती म हरियर घांस, अऊ पऊधा, जेमा ओमन के जाति के मुताबिक बीजा होथे, अऊ फरवाला रूख, जेमा ओमन के जाति के मुताबिक बीजा होथे, ये जम्मो हो गीन। अऊ परमेसर ह देखिस कि येह बढ़िया हे। <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />अऊ सांझ होईस, फेर बिहान पहा गीस—ये किसम ले तीसर दिन हो गीस।<verse eid="GEN 1:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />फेर परमेसर ह कहिस, “दिन ला रात ले अलग करे बर अकास-मंडल म अंजोरमन होवंय, अऊ ओमन पबितर समय, अऊ दिन अऊ बछरमन ला जाने बर चिनहां के रूप म काम करंय, <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />अऊ धरती ऊपर अंजोर देय बर ओमन अकास-मंडल म अंजोर बन जावंय।” अऊ वइसने हो गीस। <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />परमेसर ह दू ठन बड़े अंजोर बनाईस—ओमा के बड़े अंजोर ला दिन ऊपर परभूता करे बर अऊ छोटे अंजोर ला रात ऊपर परभूता करे बर बनाईस। ओह तारामन ला घलो बनाईस। <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />परमेसर ह ओमन ला अकास-मंडल म एकर बर रखिस कि ओमन धरती ऊपर अंजोर देवंय, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />दिन अऊ रात ऊपर परभूता करंय, अऊ अंजोर ला अंधियार ले अलग करंय। अऊ परमेसर ह देखिस कि येह बढ़िया हे। <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />अऊ सांझ होईस, फेर बिहान पहा गीस—ये किसम ले चौथा दिन हो गीस।<verse eid="GEN 1:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />फेर परमेसर ह कहिस, “पानी ह जीयत जन्तुमन ले भर जावय, अऊ चिरईमन धरती के ऊपर अकास म उड़ंय।” <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />परमेसर ह समुंदर के बड़े-बड़े जीव-जन्तुमन ला बनाईस, अऊ जाति-जाति के ओ जम्मो जीयत चीजमन ला बनाईस जेमन ले पानी भर गीस अऊ ओमन पानी म चलंय-फिरंय, अऊ किसम-किसम के पंखवाले चिरईमन ला घलो बनाईस। अऊ परमेसर ह देखिस कि येह बढ़िया हे। <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />परमेसर ह ओमन ला आसीस दीस अऊ कहिस, “फूलव-फरव; गनती म बाढ़व अऊ समुंदर के पानी म भर जावव, अऊ चिरईमन धरती ऊपर बहुंत हो जावंय।” <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />अऊ सांझ होईस, फेर बिहान पहा गीस—ये किसम ले पांचवां दिन हो गीस।<verse eid="GEN 1:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />फेर परमेसर ह कहिस, “धरती म किसम-किसम के जीयत परानी होवंय: याने कि घरेलू-पसु, अऊ भुइयां म रेंगइया जन्तु अऊ बन पसु, हर एक अपन जाति-जाति के मुताबिक होवंय।” अऊ वइसने ही हो गीस। <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />परमेसर ह किसम-किसम के बन पसु, किसम-किसम के घरेलू-पसु, अऊ भुइयां ऊपर रेंगइया किसम-किसम के जम्मो जन्तुमन ला बनाईस। अऊ परमेसर ह देखिस कि येह बढ़िया हे।<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />तब परमेसर ह कहिस, “हमन मनखे ला अपन सरूप, अपन समानता म बनावन, ताकि ओमन समुंदर के मछरी, अकास के चिरई अऊ घरेलू-पसु अऊ जम्मो बन पसु अऊ भुइयां म रेंगइया जम्मो जीव-जन्तु ऊपर अधिकार रखंय।”<verse eid="GEN 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />तब परमेसर ह मनखे ला अपन खुद के सरूप म बनाईस,</para>
  <para style="q2" vid="GEN 1:27">अपन ही सरूप म परमेसर ह ओमन ला बनाईस;</para>
  <para style="q2" vid="GEN 1:27">नर अऊ नारी करके ओह ओमन ला बनाईस।<verse eid="GEN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 1:28" />अऊ परमेसर ह ओमन ला आसीस दीस अऊ ओमन ला कहिस, “फूलव-फरव अऊ गनती म बढ़व; धरती म भर जावव, अऊ येला अपन बस म कर लेवव। समुंदर के मछरी अऊ अकास के चिरई अऊ भुइयां ऊपर रेंगइया जम्मो जीव-जन्तुमन ऊपर अधिकार रखव।”<verse eid="GEN 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 1:29" />तब परमेसर ह ओमन ला कहिस, “सुनव, धरती के जम्मो बीजावाले पऊधा अऊ जम्मो रूख, जऊन म बीजावाले फर होथें, ओ सबो ला मेंह तुमन ला देवत हंव। ओमन तुम्हर जेवन बर अंय। <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />अऊ धरती के जम्मो पसु अऊ अकास के जम्मो चिरई अऊ भुइयां ऊपर रेंगइया जम्मो जीव-जन्तु—जेमन म जिनगी के सांस हवय—मेंह जम्मो हरियर-हरियर पऊधा ला जेवन बर देवत हंव।” अऊ वइसने ही हो गीस।<verse eid="GEN 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 1:31" />तब परमेसर ह अपन बनाय जम्मो चीज ला देखिस, अऊ येह बहुंत बढ़िया रिहिस। अऊ सांझ होईस, फेर बिहान पहा गीस—ये किसम ले छठवां दिन हो गीस।<verse eid="GEN 1:31" /></para>
  <para style="b" />
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />ये किसम ले अकास अऊ धरती अऊ ओमा के जम्मो चीज के बनई पूरा हो गीस।<verse eid="GEN 2:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="GEN 2:2" />परमेसर ह अपन काम, जेला ओह करत रिहिस, सातवां दिन म पूरा करिस अऊ ओह अपन जम्मो काम ले सातवां दिन बिसराम करिस। <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />तब परमेसर ह सातवां दिन ला आसीस दीस अऊ येला पबितर ठहिराईस, काबरकि ओ दिन ओह अपन सिरिस्टी के जम्मो बुता ले बिसराम करिस।<verse eid="GEN 2:3" /></para>
  <para style="s1">आदम अऊ हवा</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />अकास अऊ धरती के बिबरन ये अय जब ओमन रचे गीन, मतलब कि जब यहोवा परमेसर ह अकास अऊ धरती ला बनाईस।<verse eid="GEN 2:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="GEN 2:5" />तब धरती<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">भुइयां</char></note> म न तो कोनो झाड़ी उगे रिहिन, अऊ न ही कोनो पऊधा निकले रिहिन, काबरकि यहोवा परमेसर ह धरती म पानी नइं बरसाय रिहिस, अऊ भुइयां म खेती करे बर कोनो नइं रिहिन, <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />पर कुहरा<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओस</char></note> धरती ले उठत रिहिस, जेकर ले जम्मो भुइयां पानी ले पलत रिहिस। <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />तब यहोवा परमेसर ह भुइयां के माटी ले एक मनखे<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">मनखे </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">आदम</char></note> ला रचिस, अऊ ओकर नाक म जिनगी के सांस फूंक दीस, अऊ मनखे ह जीयत परानी बन गीस।<verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />अऊ यहोवा परमेसर ह पूरब कोति अदन<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">अदन ह ओ इलाका के नांव ए जिहां बगीचा रिहिस</char></note> म एक बगीचा लगाईस, अऊ उहां ओ मनखे जेला ओह रचे रिहिस, रख दीस। <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />अऊ यहोवा परमेसर ह भुइयां म जम्मो किसम के रूख, जो देखे म मनोहर अऊ जेकर फर खाय म बने लगथे, उगाईस, अऊ बगीचा के मांझा म जिनगी के रूख अऊ भला अऊ बुरा के गियान के रूख ला घलो लगाईस।<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />ओ बगीचा ला पलोय बर, एक नदी अदन ले बहत रिहिस अऊ उहां ले आघू जाके ओह चार धारा म बंट गीस। <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />पहिली धारा के नांव पीसोन ए; येह हवीला नांव के पूरा देस ला, जिहां सोन मिलथे, घेरे हवय। <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />(ओ देस के सोन चोखा होथे; उहां खुसबूदार धूप अऊ गोमेदक घलो मिलथे।) <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />दूसर नदी के नांव गीहोन ए; येह कूस<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">संभवतः आज के इराक देस</char></note> नांव के पूरा देस ला घेरे हवय। <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />अऊ तीसर नदी के नांव तिगरीस ए; येह अस्सूर के पूरब कोति बोहाथे। अऊ चौथा नदी के नांव फरात ए।<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />तब यहोवा परमेसर ह मनखे ला लेके अदन के बगीचा म रख दीस कि ओह ओमा काम करय अऊ ओकर देखभाल करय। <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />अऊ यहोवा परमेसर ह मनखे ला ये हुकूम दीस, “तें बगीचा के कोनो घलो रूख के फर बिगर रोक-टोक के खा सकत हस, <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />पर भला अऊ बुरा के गियान के जऊन रूख हवय, ओकर फर तें कभू झन खाबे, काबरकि जब तें ओकर फर ला खाबे, त निस्चित रूप से तेंह मर जाबे।”<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />फेर यहोवा परमेसर ह कहिस, “मनखे के अकेला रहई बने नो हय। में ओकर बर एक अइसन मददगार बनाहूं, जऊन ह ओकर ले मेल खावय।”<verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19" />यहोवा परमेसर ह भुइयां ले जम्मो जाति के पसुमन ला अऊ अकास के जम्मो चिरईमन ला बनाय रिहिस अऊ ये देखे बर ओमन ला मनखे करा लानिस कि ओह ओमन के का-का नांव रखथे; अऊ जऊन-जऊन नांव लेके जीयत परानीमन ला मनखे ह बलाईस, ओह ओमन के नांव हो गीस। <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />ये किसम ले मनखे ह जम्मो घरेलू-पसुमन के, अकास के चिरईमन के अऊ जम्मो बन पसुमन के नांव रखिस।</para>
  <para style="p" vid="GEN 2:20">पर आदम<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">आदमी</char></note> बर कोनो अइसने सहायक नइं मिलिस, जेकर संग ओकर मेल खावय। <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />एकरसेति यहोवा परमेसर ह आदम ला भारी नींद म डार दीस; अऊ जब ओह सुतत रिहिस, तब परमेसर ह आदम के एक पसली निकालके ओकर जगह म मांस भर दीस। <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />तब यहोवा परमेसर ह आदम ले निकाले ओ पसली<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">भाग</char></note> म ले एक माईलोगन बनाईस, अऊ ओला आदम करा ले आईस।<verse eid="GEN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23" />तब आदम ह कहिस,</para>
  <para style="q1" vid="GEN 2:23">“अब येह मोर हाड़ा म के हाड़ा</para>
  <para style="q2" vid="GEN 2:23">अऊ मोर मांस म के मांस अय;</para>
  <para style="q1" vid="GEN 2:23">एकरसेति येला ‘नारी’ कहे जाही,</para>
  <para style="q2" vid="GEN 2:23">काबरकि येह नर म ले निकाले गे हवय।”<verse eid="GEN 2:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="GEN 2:24" />एकरे कारन आदमी ह अपन दाई-ददा ला छोंड़के अपन घरवाली संग मिले रहिही, अऊ ओ दूनों एक तन होहीं।<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />आदम अऊ ओकर घरवाली दूनों नंगरा रिहिन, पर ओमन लजात नइं रिहिन।<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s1">मनखे के पाप म गिरई</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />यहोवा परमेसर ह जतेक बन पसु बनाय रिहिस, ओ सब म सांप ह जादा धूर्त रिहिस। ओह माईलोगन ले पुछिस, “का परमेसर ह सही म कहे हवय, ‘तुमन ये बगीचा के कोनो रूख के फर ला झन खाहू’?”<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />माईलोगन ह सांप ला जबाब दीस, “हमन ये बगीचा के रूखमन के फर खा सकत हन, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />पर जऊन रूख ह बगीचा के मांझा म हवय, ओकर फर के बारे म परमेसर ह कहे हवय कि न तो तुमन ओला खावव अऊ न ही ओला छुवव, नइं तो तुमन मर जाहू।”<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />तब सांप ह माईलोगन ला कहिस, “तुमन निस्चय नइं मरव। <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />बरन परमेसर खुद जानत हे कि जऊन दिन तुमन ये फर ला खाहू, ओहीच दिन तुम्हर आंखी ह उघर जाही, अऊ तुमन भला अऊ बुरा के गियान पाके परमेसर के सहीं हो जाहू।”<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />त जब माईलोगन ह देखिस कि रूख के फर ह खाय बर बढ़िया अऊ देखे म मनभाऊ, अऊ बुद्धि देय बर पसंद के लईक हे, त ओह ओमा ले कुछू ला टोरके खाईस, अऊ कुछू अपन घरवाला ला घलो दीस, जऊन ह ओकर संग रिहिस, अऊ ओह घलो खाईस। <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />तब ओ दूनों के आंखी उघर गीस, अऊ ओमन ला महसूस होईस कि ओमन नंगरा हवंय; एकरे बर ओमन अंजीर के पानमन ला जोड़-जोड़के अपन बर ढपनी बना लीन।<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />तब यहोवा परमेसर, जऊन ह दिन के ठंडा समय बगीचा म घुमय, ओकर अवाज ओमन ला सुनई दीस। तब आदम अऊ ओकर घरवाली बगीचा के रूखमन के बीच म यहोवा परमेसर ले लुका गीन। <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />पर यहोवा परमेसर ह हांक पारके आदम ला पुछिस, “तें कहां हस?”<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />ओह जबाब दीस, “में बारी म तोर अवाज ला सुनके डर गेंव, काबरकि में नंगरा रहेंव; एकरसेति में लुका गेंव।”<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />परमेसर ह कहिस, “तोला कोन कहिस कि तें नंगरा हस? जऊन रूख के फर खाय बर मेंह तोला मना करे रहेंव, का तेंह ओकर फर ला खाय हस?”<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />आदम ह कहिस, “जऊन माईलोगन ला तेंह मोर संग रहे बर देय हस—ओही ह ओ रूख के फर मोला खाय बर दीस अऊ मेंह ओला खांय।”<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />तब यहोवा परमेसर ह माईलोगन ले कहिस, “ये तें का करे हस?”</para>
  <para style="p" vid="GEN 3:13">माईलोगन ह जबाब दीस, “सांप ह मोला बहका दीस, त मेंह खांय।”<verse eid="GEN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />तब यहोवा परमेसर ह सांप ला कहिस, “काबरकि तेंह अइसने करे हस,</para>
  <para style="q1" vid="GEN 3:14">“एकरसेति तें जम्मो घरेलू-पसु,</para>
  <para style="q2" vid="GEN 3:14">अऊ जम्मो बन पसु ले जादा सरापित अस!</para>
  <para style="q1" vid="GEN 3:14">तेंह पेट के बल म रेंगबे,</para>
  <para style="q2" vid="GEN 3:14">अऊ तेंह जिनगी भर</para>
  <para style="q2" vid="GEN 3:14">माटी खावत रहिबे।<verse eid="GEN 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15" />अऊ मेंह तोर अऊ ये माईलोगन के बीच म,</para>
  <para style="q2" vid="GEN 3:15">अऊ तोर बंस<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बीजा</char></note> अऊ एकर बंस के बीच म,</para>
  <para style="q2" vid="GEN 3:15">बईरता उपजाहूं,</para>
  <para style="q1" vid="GEN 3:15">ओह तोर मुड़ ला कुचरही,</para>
  <para style="q2" vid="GEN 3:15">अऊ तें ओकर एड़ी ला डसबे।”<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />फेर माईलोगन ला ओह कहिस,</para>
  <para style="q1" vid="GEN 3:16">“में तोर गरभवती होय के समय के पीरा ला अब्बड़ बढ़ाहूं;</para>
  <para style="q2" vid="GEN 3:16">अऊ छेवारी होय के समय, तेंह पीरा सहके लइका जनमाबे।</para>
  <para style="q1" vid="GEN 3:16">तोर लालसा तोर घरवाला बर होही</para>
  <para style="q2" vid="GEN 3:16">अऊ ओह तोर ऊपर परभूता करही।”<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />अऊ आदम ला ओह कहिस, “काबरकि तेंह अपन घरवाली के बात ला माने, अऊ जऊन रूख के बिसय म मेंह तोला हुकूम देय रहेंव कि तें ओकर फर ला झन खाबे, ओला तेंह खाय हस।</para>
  <para style="q1" vid="GEN 3:17">“भुइयां ह तोर कारन सरापित हे;</para>
  <para style="q2" vid="GEN 3:17">तें एकर ऊपज अपन जिनगी भर</para>
  <para style="q2" vid="GEN 3:17">दुख के संग खाय पाबे।<verse eid="GEN 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18" />अऊ येह तोर बर कांटा अऊ कंटिला पऊधा उपजाही,</para>
  <para style="q2" vid="GEN 3:18">अऊ तें खेत के ऊपज ला खाबे।<verse eid="GEN 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19" />अऊ अपन माथा के पसीना के कमई</para>
  <para style="q2" vid="GEN 3:19">तेंह खाय पाबे,</para>
  <para style="q1" vid="GEN 3:19">अऊ आखिर म माटी म मिल जाबे;</para>
  <para style="q2" vid="GEN 3:19">काबरकि तोला ओही म ले लिये गे हवय,</para>
  <para style="q1" vid="GEN 3:19">तें तो माटी ही अस,</para>
  <para style="q2" vid="GEN 3:19">अऊ माटी म ही फेर मिल जाबे।”<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />आदम ह अपन घरवाली के नांव हवा<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="fq" closed="false">हवा </char><char style="ft" closed="false">संभवतः येकर अर्थ होथे </char><char style="fqa" closed="false">जिनगी या जीयत</char></note> रखिस, काबरकि जम्मो जीयत मनखेमन के ओही ह दाई होईस।<verse eid="GEN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21" />अऊ यहोवा परमेसर ह आदम अऊ ओकर घरवाली बर चमड़ा के पहिरावा बनाके ओमन ला पहिरा दीस। <verse eid="GEN 3:21" /><verse number="22" style="v" sid="GEN 3:22" />फेर यहोवा परमेसर ह कहिस, “मनखे ह भला अऊ बुरा के गियान पाके अब हमर म के एक झन सहीं हो गे हवय। एकरसेति अब अइसने झन होवय कि ओह हांथ लमाके जिनगी के रूख के फर ला घलो टोरके खा लेवय अऊ सदाकाल तक जीयत रहय।” <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />एकरसेति यहोवा परमेसर ह ओला अदन के बगीचा ले निकाल दीस कि ओह ओ भुइयां म काम करय, जेमा ले ओह बनाय गे रिहिस। <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />आदम ला निकाले के बाद, ओह जिनगी के रूख के रसता के रखवारी करे बर, अदन के बगीचा के पूरब दिग म करूबमन ला अऊ चारों कोति किंदरनेवाला आगी के तलवार ला घलो रख दीस।<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s1">कैन अऊ हाबिल</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />जब आदम ह अपन घरवाली हवा संग सुतिस, त ओह आसरा म होके कैन<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fq" closed="false">कैन </char><char style="ft" closed="false">इबरानी म एकर मतलब होथे </char><char style="fqa" closed="false">लानिस </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">पाईस</char></note> ला जनम दीस अऊ कहिस, “मेंह यहोवा के मदद ले एक झन पुरूस पाय हंव।” <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />बाद म ओह ओकर भाई हाबिल ला जनम दीस।</para>
  <para style="p" vid="GEN 4:2">हाबिल ह भेड़-बकरी के चरवाहा बन गीस, अऊ कैन ह खेती-बारी करत रिहिस। <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />कुछू दिन के बाद, कैन ह यहोवा करा भुइयां के कुछू फर चढ़ावा के रूप म लानिस। <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />अऊ हाबिल घलो अपन भेड़-बकरी के कुछू पहिलांतमन ला लानिस अऊ ओमन के चरबी ला चढ़ावा के रूप म चघाईस। यहोवा ह हाबिल अऊ ओकर चढ़ावा ला तो गरहन करिस, <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />पर कैन अऊ ओकर भेंट ला गरहन नइं करिस। एकरसेति कैन ह अब्बड़ गुस्सा होईस अऊ ओकर चेहरा ह उतर गीस।<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />तब यहोवा ह कैन ले पुछिस, “तेंह काबर गुस्सा होवत हस? तोर मुहूं ह काबर उतरे हवय? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />जऊन ह सही ए, यदि तेंह ओला करते, त का तोर भेंट ह गरहन नइं होतिस? पर जऊन ह सही ए, यदि तेंह ओला नइं करस, त पाप ह तोर दुवारी म ठाढ़े हवय; ओकर लालसा तोला पाय बर होही, पर तोला ओकर ऊपर जय पाना जरूरी ए।”<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />एक दिन कैन ह अपन भाई हाबिल ला कहिस, “चल हमन खेत डहार जाबो।” जब ओमन खेत म रिहिन, त कैन ह अपन भाई हाबिल ऊपर हमला करके ओला मार डारिस।<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />तब यहोवा ह कैन ले पुछिस, “तोर भाई हाबिल कहां हे?”</para>
  <para style="p" vid="GEN 4:9">त कैन जबाब दीस, “में नइं जानंव; का मेंह अपन भाई के रखवार अंव?”<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />यहोवा ह कहिस, “तेंह का करे हस? सुन! तोर भाई के लहू ह भुइयां ले मोला नरियावथे। <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />अब तेंह एक सराप के अधीन हस अऊ ओ भुइयां ले निकाले जावत हस, जऊन ह तोर भाई के लहू तोर हांथ ले पीये बर अपन मुहूं फारिस। <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />जब तेंह भुइयां म खेती करबे, त ओह अब तोला अपन फसल नइं देवय। तेंह धरती म बियाकुल होके इहां-उहां भटकत रहिबे।”<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />तब कैन ह यहोवा ला कहिस, “मोर सजा ह मोर सहे के बाहिर ए। <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />आज तेंह मोला ये भुइयां म ले निकालत हस, अऊ मेंह तोर नजर के आड़ म हो जाहूं; अऊ धरती म अस्थिर होके इहां-उहां भटकत रहिहूं, अऊ जऊन कोनो मोला पाही, ओह मोला मार डारही।”<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />पर यहोवा ह ओला कहिस, “अइसने नइं होवय; जऊन कोनो कैन ला मारही, ओकर ले सात गुना बदला लेय जाही।” तब यहोवा ह कैन बर एक चिनहां ठहिरा दीस ताकि कोनो मनखे कैन ला पाके ओकर हतिया झन कर देवय। <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />तब कैन ह यहोवा के आघू ले चल दीस अऊ नोद<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="fq" closed="false">नोद </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">भटकनेवाला</char></note> नांव के देस म, जेह अदन के पूरब कोति हवय, रहे लगिस।<verse eid="GEN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />जब कैन अपन घरवाली संग सुतिस, तब ओकर घरवाली ह आसरा म होईस अऊ ओह हनोक ला जनम दीस। कैन ह तब एक सहर बसावत रिहिस, अऊ ओह ओ सहर के नांव अपन बेटा के नांव म हनोक रखिस। <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />हनोक ले ईराद जनमिस, अऊ ईराद ह महूयाएल के ददा रिहिस, अऊ महूयाएल ह मतूसाएल के ददा रिहिस, अऊ मतूसाएल ह लेमेक के ददा रिहिस।<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />लेमेक ह दू झन माईलोगन ले बिहाव करिस, जेमा के एक झन के नांव आदा, अऊ दूसर के सिल्ला रिहिस। <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />आदा ह याबाल ला जनमिस; याबाल ह ओमन के पुरखा रिहिस जऊन मन तम्बू म रहिथें अऊ पसु-पालन करथें। <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />ओकर भाई के नांव यूबाल रिहिस; जऊन ह जम्मो किसम के सितार अऊ बंसी बजइयामन के पुरखा रिहिस। <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />सिल्ला घलो तूबल-कैन नांव के एक बेटा ला जनमिस; जऊन ह कांसा अऊ लोहा ढारके औजार बनइया<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">जऊन ह </char><char style="fqa" closed="false">जम्मो काम करइयामन ला सिखोईस</char></note> होईस। तूबल-कैन के बहिनी के नांव नामा रिहिस।<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />लेमेक ह अपन घरवालीमन ला कहिस,</para>
  <para style="q1" vid="GEN 4:23">“हे आदा अऊ सिल्ला, मोर गोठ ला सुनव;</para>
  <para style="q2" vid="GEN 4:23">हे लेमेक के घरवालीमन, मोर बात ऊपर कान लगावव।</para>
  <para style="q1" vid="GEN 4:23">मेंह एक मनखे ला, जेह मोला चोट पहुंचाय रिहिस, मार डारेंव।</para>
  <para style="q2" vid="GEN 4:23">एक जवान, जऊन ह मोला घायल करे रिहिस।<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />यदि कैन के बदला सात गुना लेय जाथे,</para>
  <para style="q2" vid="GEN 4:24">त लेमेक के सतहत्तर गुना लेय जाही।”<verse eid="GEN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />आदम फेर अपन घरवाली संग सुतिस, अऊ ओकर घरवाली ह एक बेटा ला जनम दीस अऊ ओकर नांव ये कहिके सेत<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="fq" closed="false">सेत </char><char style="ft" closed="false">के मतलब संभवतः </char><char style="fqa" closed="false">दान होथे</char></note> रखिस, “परमेसर ह मोला हाबिल के बदला म, जेला कैन ह मार डारिस, एक अऊ बेटा दे हवय।” <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />बाद म, सेत के घलो एक बेटा होईस; ओह ओकर नांव एनोस रखिस।</para>
  <para style="p" vid="GEN 4:26">ओही बेरा ले मनखेमन यहोवा ले पराथना<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">घोसना</char></note> करे के सुरू करिन।<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s1">आदम ले लेके नूह तक</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />येह आदम के खानदान के लिखित बिबरन अय।</para>
  <para style="b" vid="GEN 5:1" />
  <para style="p" vid="GEN 5:1">जब परमेसर ह मनखे ला बनाईस, त ओह अपन ही सरूप म ओला बनाईस। <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />ओह ओमन ला नर अऊ नारी करके बनाईस अऊ ओमन ला आसीस दीस, अऊ ओमन के बनाय के दिन ओकर नांव “मनखे-जात”<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">आदम</char></note> रखिस।<verse eid="GEN 5:2" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="3" style="v" sid="GEN 5:3" />जब आदम ह 130 बछर के होईस, त ओकर एक बेटा ओकर समानता अऊ ओकर सरूप म जनमिस। ओह ओकर नांव सेत रखिस। <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />सेत के जनमे के बाद, आदम ह 800 बछर जीयत रिहिस, अऊ ओकर अऊ घलो बेटा-बेटी होईन। <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />ये किसम ले आदम के कुल उमर 930 बछर होईस, अऊ तब ओह मर गीस।<verse eid="GEN 5:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 5:6" />जब सेत 105 बछर के होईस, त ओह एनोस के ददा<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="fq" closed="false">ददा </char><char style="ft" closed="false">के मतलब हो सकथे </char><char style="fqa" closed="false">पुरखा</char></note> होईस। <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />एनोस के जनम के बाद, सेत ह 807 बछर तक जीयत रिहिस, अऊ ओकर अऊ बेटा-बेटी होईन। <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />ये किसम ले सेत के कुल उमर 912 बछर होईस, अऊ तब ओह मर गीस।<verse eid="GEN 5:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="GEN 5:9" />जब एनोस 90 बछर के होईस, तब ओकर ले केनान के जनम होईस। <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />केनान के जनम के बाद, एनोस 815 बछर तक जीयत रिहिस, अऊ ओकर अऊ घलो बेटा-बेटी होईन। <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />ये किसम ले एनोस के कुल उमर 905 बछर होईस, अऊ तब ओह मर गीस।<verse eid="GEN 5:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 5:12" />जब केनान 70 बछर के होईस, त ओकर ले महललेल के जनम होईस। <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />महललेल के जनम के बाद, केनान 840 बछर तक जीयत रिहिस, अऊ ओकर अऊ घलो बेटा-बेटी होईन। <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />ये किसम ले केनान के कुल उमर 910 बछर होईस, अऊ तब ओह मर गीस।<verse eid="GEN 5:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 5:15" />जब महललेल 65 बछर के होईस, त ओकर ले येरेद के जनम होईस। <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />येरेद के जनम के बाद, महललेल 830 बछर तक जीयत रिहिस, अऊ ओकर अऊ घलो बेटा-बेटी होईन। <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />ये किसम ले महललेल के कुल उमर 895 बछर होईस, अऊ तब ओह मर गीस।<verse eid="GEN 5:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 5:18" />जब येरेद 162 बछर के होईस, त ओकर ले हनोक के जनम होईस। <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />हनोक के जनम के बाद, येरेद 800 बछर तक जीयत रिहिस, अऊ ओकर अऊ भी बेटा-बेटी होईन। <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />ये किसम ले येरेद के कुल उमर 962 बछर होईस, अऊ तब ओह मर गीस।<verse eid="GEN 5:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="GEN 5:21" />जब हनोक 65 बछर के होईस, त ओकर ले मतूसेलह के जनम होईस। <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />मतूसेलह के जनम के बाद, हनोक 300 बछर तक परमेसर के संग-संग चलिस, अऊ ओकर अऊ भी बेटा-बेटी होईन। <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />ये किसम ले हनोक के कुल उमर 365 बछर होईस। <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />हनोक ह ईमानदारी से परमेसर के संग चलिस; तब ओह गायब हो गीस, काबरकि परमेसर ह ओला उठा लीस।<verse eid="GEN 5:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 5:25" />जब मतूसेलह 187 बछर के होईस, त ओकर ले लेमेक के जनम होईस। <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />लेमेक के जनम के बाद, मतूसेलह 782 बछर जीयत रिहिस, अऊ ओकर अऊ भी बेटा-बेटी होईन। <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />ये किसम ले मतूसेलह के कुल उमर 969 बछर होईस, अऊ तब ओह मर गीस।<verse eid="GEN 5:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="GEN 5:28" />जब लेमेक 182 बछर के होईस, त ओकर ले एक बेटा होईस। <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />ओह ओकर नांव ए कहिके नूह<note caller="+" style="f"><char style="fr" closed="false">5:29 </char><char style="fq" closed="false">नूह </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">दिलासा </char><char style="ft" closed="false">सबद के सहीं अवाज लगथे</char></note> रखिस, “यहोवा ह धरती ला जऊन सराप दे हे, ओकर बारे म, ये बाबू-पीला ह हमर काम म अऊ जऊन कठोर मेहनत हमन करथन, ओमा हमन ला सांति दीही।” <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />नूह के जनम के बाद, लेमेक 595 बछर तक जीयत रिहिस, अऊ ओकर अऊ बेटा-बेटी जनमिन। <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />ये किसम ले लेमेक के कुल उमर 777 बछर होईस, अऊ तब ओह मर गीस।<verse eid="GEN 5:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="GEN 5:32" />जब नूह 500 बछर के होईस, त ओकर ले सेम, हाम अऊ येपेत के जनम होईस।<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s1">संसार म बुरई</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />जब मनखेमन धरती म गनती म बाढ़े लगिन अऊ ओमन के बेटीमन जनमिन, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />त परमेसर के बेटामन<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">परमेसर के बेटामन </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">स्वरगदूतमन</char><char style="ft" closed="false">; <char style="xt"><ref loc="JOB 1:6">अयू 1:6</ref>; <ref loc="JOB 2:1">2:1</ref></char>; <char style="xt"><ref loc="PSA 29:1">भजन 29:1</ref>; <ref loc="PSA 89:6">89:6</ref></char>; <char style="xt"><ref loc="DAN 3:25">दानि 3:25</ref></char> <char style="xt"><ref loc="2PE 2:4-5">2 पत 2:4‑5</ref></char>; <char style="xt"><ref loc="JUD 1:6">यहू 6</ref></char></char></note> देखिन कि मनखे के बेटीमन सुघर हें अऊ ओमन जे-जे ला पसंद करिन, तेमन ले बिहाव कर लीन। <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />तब यहोवा ह कहिस, “मोर आतमा ह मनखे संग सदाकाल बर नइं रहय, काबरकि मनखे ह अमर नो हय; ओमन के उमर एक सौ बीस बछर होही।”<verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />ओ समय धरती म नेफिलीम<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="fq" closed="false">नेफिलीम </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">दानव </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बड़े अऊ सक्तिसाली मनखेमन</char></note> रहत रिहिन, अऊ एकर पाछू जब परमेसर के बेटामन मनखे के बेटीमन संग संबंध बनाईन, त ओमन के मेल से जऊन लइका जनमिन, ओमन ओ समय सूरबीर अऊ जाने-माने मनखे रिहिन।<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />यहोवा ह देखिस कि मनखेमन के बुरई धरती म बहुंत बढ़ गे हवय, अऊ ओमन के हिरदय के जम्मो बिचार ह हर समय सिरिप बुरई के ही होथे। <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />त यहोवा ह धरती म मनखे ला बनाके पछताईस, अऊ अपन मन म बहुंत दुखी होईस। <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />एकरसेति यहोवा ह कहिस, “मेंह मनखे ला, जेला मेंह बनाय हंव, धरती म ले नास कर दूहूं—अऊ ओमन के संग पसु, चिरई अऊ भुइयां म रेंगइया जन्तु, ओ जम्मो ला नास कर दूहूं—काबरकि मेंह ओमन ला बनाके पछतात हंव।” <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />पर यहोवा के दया-दिरिस्टी नूह ऊपर बने रिहिस।<verse eid="GEN 6:8" /></para>
  <para style="s1">नूह अऊ जल परलय</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />नूह अऊ ओकर परिवार के बिबरन ये अय।</para>
  <para style="b" vid="GEN 6:9" />
  <para style="p" vid="GEN 6:9">नूह एक धरमी अऊ अपन समय के मनखेमन म निरदोस रिहिस, अऊ ओह ईमानदारी से परमेसर के संग चलिस। <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />नूह के तीन झन बेटा रिहिन: सेम, हाम अऊ येपेत।<verse eid="GEN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11" />ओ समय धरती ह परमेसर के नजर म खराप हो गे रिहिस अऊ हिंसा ले भर गे रिहिस। <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />परमेसर ह देखिस कि धरती ह बहुंत खराप हो गे हे, काबरकि धरती के जम्मो मनखेमन अपन चालचलन ला बिगाड़ ले रहंय। <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />एकरसेति परमेसर ह नूह ला कहिस, “मेंह जम्मो मनखे के अन्त करइया हंव, काबरकि ओमन के कारन धरती ह हिंसा ले भर गे हवय। मेंह निस्चित रूप से ओमन ला धरती समेत नास करइया हंव। <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />एकरसेति तें गोपेर रूख के लकरी के एक पानी जहाज बना ले; ओकर भीतर म खोलीमन ला बनाबे, अऊ ओकर भीतर-बाहिर राल लगा देबे। <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />तें ओला अइसने बनाबे: जहाज ला तीन सौ क्यूबीट लम्बा, पचास क्यूबीट चाकर अऊ तीस क्यूबीट ऊंच बनाबे।<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">लगभग 135 मीटर लम्बा, 23 मीटर चाकर अऊ 14 मीटर ऊंच</char></note> <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />जहाज के एक छत बनाबे अऊ छत खाल्हे एक क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">लगभग 18 ईंच या लगभग 45 सेन्टीमीटर</char></note> ऊंच खिड़की जहाज के चारों कोति बनाबे। जहाज के बाजू म एक कपाट रखबे अऊ जहाज ला तीन तल्ला बनाबे। <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />काबरकि देख, में धरती म जल-परलय करके जम्मो चीज ला जेमन म जिनगी के सांस हवय, अकास के तरी ले नास करइया हंव। धरती ऊपर जऊन कुछू हवय, सबो चीज नास हो जाहीं। <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />पर मेंह तोर संग करार करहूं, अऊ तेंह जहाज के भीतर जाबे—तोर बेटामन अऊ तोर घरवाली अऊ तोर बेटामन के घरवालीमन घलो तोर संग जहाज के भीतर जाहीं। <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />अऊ जम्मो जीयत परानी म ले, तें हर एक जाति के दू-दू ठन याने कि एक नर अऊ एक मादा ला जहाज भीतर लानबे अऊ ओमन ला अपन संग जीयत रखबे। <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />हर किसम के चिरई, हर किसम के पसु अऊ भुइयां म रेंगइया हर किसम के जीव म के दू-दू ठन तोर करा जीयत रहे बर आहीं। <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />तें आनि-बानि के खाय के जिनिस जेला खाय जाथे, अपन करा जमा कर लेबे, जऊन ह तोर अऊ ओमन के जेवन बर होही।”<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />परमेसर के हुकूम के मुताबिक नूह हर चीज ला करिस।<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />तब यहोवा ह नूह ला कहिस, “तें अपन पूरा घराना समेत जहाज म जा, काबरकि मेंह ये पीढ़ी के मनखे म तोला अपन नजर म धरमी पाय हंव। <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />हर किसम के सुध पसु म ले, तें सात-सात जोड़ी याने कि नर अऊ मादा ले, पर हर किसम के असुध पसु म ले एक-एक जोड़ी याने कि नर अऊ मादा ले, <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />अऊ हर किसम के चिरई म ले घलो सात-सात जोड़ी याने कि नर अऊ मादा ले ताकि ओमन के बंस बांचके जम्मो धरती म बने रहंय। <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />सात दिन के बाद, मेंह धरती म चालीस दिन अऊ चालीस रात तक बरसा करहूं, अऊ मेंह जम्मो जीयत परानीमन ला धरती म ले नास कर दूहूं, जेमन ला मेंह बनाय हवंव।”<verse eid="GEN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5" />अऊ जइसे यहोवा ह हुकूम देय रिहिस, ओकरे मुताबिक नूह जम्मो चीज ला करिस।<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />नूह के उमर छै सौ साल रिहिस, जब धरती ऊपर जल-परलय आईस। <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />नूह ह अपन बेटा, घरवाली अऊ बहुमन के संग जल-परलय ले बांचे बर जहाज भीतर गीस। <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />सुध अऊ असुध दूनों किसम के पसु, चिरई अऊ भुइयां म रेंगइया जम्मो जन्तु म ले एक-एक जोड़ी <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />याने कि नर अऊ मादा, नूह करा आईन अऊ जहाज भीतर गीन, जइसने कि परमेसर ह नूह ला हुकूम दे रिहिस। <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />अऊ सात दिन के बाद, जल-परलय धरती म होय लगिस।<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />नूह के जिनगी के छै सौवां साल के दूसरा महिना के सतरहवां दिन गहिरा समुंदर के सोतामन फूट गीन अऊ अकास के पानी के झरोखामन घलो खुल गीन। <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />अऊ चालीस दिन अऊ चालीस रात तक धरती म लगातार बरसा होते रिहिस।<verse eid="GEN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 7:13" />ठीक ओही दिन नूह अपन बेटा सेम, हाम, येपेत अऊ अपन घरवाली अऊ तीनों बहुमन संग जहाज भीतर गीस। <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />ओमन के संग हर किसम के जंगली पसु, हर किसम के घरेलू-पसु, हर किसम के धरती ऊपर रेंगइया जन्तु, अऊ हर किसम के उड़इया चिरईमन के एक-एक जोड़ी जहाज म गीन। <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />जम्मो परानी जेमा जिनगी के सांस रिहिस, ओमा के एक-एक जोड़ी नूह करा आईन अऊ जहाज भीतर गीन। <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />जऊन पसुमन भीतर जावत रिहिन, ओमा हर किसम के जीव-जन्तु के नर अऊ मादा रिहिन जइसने कि परमेसर ह नूह ला हुकूम दे रिहिस। तब यहोवा ह नूह के भीतर जाय के बाद जहाज के कपाट ला बंद कर दीस।<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />धरती म चालीस दिन तक पानी के परलय होते रिहिस, अऊ जइसे-जइसे पानी बढ़त गीस, वइसे-वइसे जहाज ह धरती ले ऊपर उठत गीस। <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />पानी बढ़त-बढ़त धरती ऊपर बहुंत हो गे अऊ जहाज पानी ऊपर तउंरे लगिस। <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />पानी ह धरती ऊपर अतेक भर गीस कि धरती के जम्मो बड़े-बड़े पहाड़ घलो बुड़ गीन। <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />पानी ह अऊ बढ़के पहाड़मन के ऊपर पंदरह क्यूबीट<note caller="+" style="f"><char style="fr" closed="false">7:20 </char><char style="ft" closed="false">लगभग 23 फीट</char></note> ले घलो जादा भर गीस। <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />भुइयां म रहइया जम्मो जीव—चिरई, घरेलू-पसु, जंगली पसु, धरती के जम्मो उड़नेवाला जीव, अऊ जम्मो मनखे नास हो गीन। <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />सूखा भुइयां म रहइया हर ओ चीज जऊन म जिनगी के सांस रिहिस, ओ जम्मो के जम्मो मर गीन। <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />धरती के ऊपर जम्मो जीयत चीज के नास हो गीस; मनखे अऊ पसु अऊ भुइयां म रेंगइया जीव अऊ चिरई जम्मो के जम्मो धरती ले मर मिटिन। सिरिप नूह अऊ जतेक झन ओकर संग जहाज म रिहिन, ओमन बांचिन।<verse eid="GEN 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 7:24" />अऊ पानी धरती ऊपर एक सौ पचास दिन तक भरे रिहिस।<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />अऊ परमेसर ह नूह अऊ जतेक जंगली पसु अऊ घरेलू-पसु ओकर संग जहाज म रिहिन, ओ जम्मो के सुधि लीस, अऊ परमेसर ह धरती ऊपर हवा बहाईस, अऊ पानी अंटाय लगिस। <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />अब गहिरा समुंदर के सोता अऊ अकास के पानी के झरोखामन बंद कर दिये गीन, अऊ अकास ले पानी गिरे के बंद हो गीस। <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />अऊ पानी ह धरती ले लगातार कम होवत गीस। एक सौ पचास दिन के बाद पानी ह कम होय लगिस; <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />अऊ साल के सातवां महिना के सतरहवां दिन जहाज ह अरारात नांव के पहाड़ म टेक गीस। <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />पानी ह दसवां महिना तक अंटात गीस, अऊ दसवां महिना के पहिला दिन पहाड़ के चोटीमन दिखे लगिन।<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />ओकर चालीस दिन के बाद नूह ह अपन बनाय जहाज के एक खिड़की ला खोलिस <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />अऊ एक ठन कऊआ ला उड़ा दीस, अऊ जब तक पानी ह धरती ऊपर ले नइं सूखा गीस, ओ कऊआ ह धरती ऊपर एती-ओती उड़ते रिहिस। <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />तब ओह एक ठन पंड़की ला ये देखे बर उड़िया दीस कि पानी धरती ऊपर ले अंटाईस कि नइं। <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />पर ओ पंड़की ला बईठे बर कोनो ठिकाना नइं मिलिस, काबरकि जम्मो धरती ह पानी ले भरे रिहिस, एकरसेति ओह लहुंटके नूह करा जहाज म आ गीस। तब नूह ह हांथ लमाके ओला वापिस अपन करा जहाज म ले आईस। <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />तब ओह सात दिन तक ठहिरके ओ पंड़की ला जहाज ले फेर उड़िया दीस। <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />जब ओ पंड़की ह सांझकुन नूह करा लहुंटके आईस, त ओह देखिस कि पंड़की के चोंच म जैतून के एक नवां पान हवय! तब नूह ह जान डारिस कि पानी धरती ऊपर ले अंटा गे हे। <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />ओह सात दिन अऊ ठहिरके ओ पंड़की ला फेर उड़िया दीस, पर ये समय ओह फेर लहुंटके नूह करा नइं आईस।<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />नूह के उमर के छै सौ एक बछर के पहिला महिना के पहिला दिन, पानी ह धरती ऊपर ले सूखा गीस। नूह ह तब जहाज के छानी ला खोल दीस अऊ देखिस कि धरती ह सूखा गे हे। <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />दूसर महिना के सत्ताईसवां दिन धरती ह पूरा सूखा गीस।<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />तब परमेसर ह नूह ला कहिस, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“तें अपन घरवाली, बेटा, अऊ बहुमन के संग जहाज ले निकल आ। <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />चिरई, पसु, अऊ जम्मो किसम के धरती ऊपर रेंगइया जन्तुमन ला घलो अपन संग निकालके ले आ ताकि धरती ऊपर ओमन बहुंत फूलंय-फरंय अऊ धरती म ओमन के गनती बढ़य।”<verse eid="GEN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18" />तब नूह, अपन बेटा, घरवाली अऊ बहुमन संग निकल आईस। <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />जम्मो पसु अऊ भुइयां म रेंगइया जम्मो जन्तु, अऊ जम्मो चिरई अऊ जम्मो जीव-जन्तु, जऊन मन धरती म रेंगथें-बुलथें, अपन जाति-जाति के मुताबिक जहाज ले निकल आईन।<verse eid="GEN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />तब नूह ह यहोवा बर एक बेदी बनाईस, अऊ जम्मो सुध पसु अऊ जम्मो सुध चिरई म ले थोर-थोर लेके बेदी ऊपर होम-बलिदान करिस। <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />यहोवा ह सुख-देवइया सुगंध ला सुंघके अपन मन म कहिस: “मनखे के कारन, में फेर कभू भुइयां ला सराप नइं दंव, हालाकि मनखे के लइकापन ले जऊन भी बिचार ओकर मन म आथे, ओह खराप ही होथे। पर जइसने मेंह जम्मो जीवमन ला नास करे हंव, वइसने अऊ फेर कभू नइं करंव।<verse eid="GEN 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22" />“अब ले जब तक धरती ह रहिही,</para>
  <para style="q1" vid="GEN 8:22">तब तक बीजा बोय अऊ लुये के समय,</para>
  <para style="q1" vid="GEN 8:22">जाड़ा अऊ गरमी,</para>
  <para style="q1" vid="GEN 8:22">धूपकाला अऊ जड़काला,</para>
  <para style="q1" vid="GEN 8:22">दिन अऊ रात</para>
  <para style="q1" vid="GEN 8:22">लगातार होवत रहिहीं।”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s1">नूह संग परमेसर के करार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />फेर परमेसर ह नूह अऊ ओकर बेटामन ला आसीस दीस अऊ ओमन ला कहिस, “फूलव-फरव अऊ गनती म बढ़व अऊ धरती म भर जावव। <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />तुम्हर डर अऊ भय धरती के जम्मो पसु, अऊ अकास के जम्मो चिरई, अऊ भुइयां म रेंगइया जम्मो जीव, अऊ समुंदर के जम्मो मछरीमन ऊपर बने रहय; ये जम्मो ला तुम्हर बस म करे जावथे। <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />जम्मो जीयत अऊ रेंगइया जन्तुमन तुम्हर खाय बर हवंय। जइसने मेंह तुमन ला हरियर पऊधा दे रहेंव, वइसने मेंह अब तुमन ला हर चीज देवत हंव।<verse eid="GEN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 9:4" />“पर मांस ला तुमन परान सहित याने कि लहू समेत झन खाहू। <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />अऊ मेंह तुम्हर लहू याने कि परान के जरूर बदला लूहूं। मेंह जम्मो पसुमन ले बदला लूहूं। अऊ हर एक मनखे ले घलो मेंह दूसर मनखे के परान के बदला लूहूं।<verse eid="GEN 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 9:6" />“जऊन कोनो मनखे के लहू बहाही,</para>
  <para style="q2" vid="GEN 9:6">ओकर लहू मनखे के दुवारा बहाय जाही;</para>
  <para style="q1" vid="GEN 9:6">काबरकि परमेसर ह मनखे ला</para>
  <para style="q2" vid="GEN 9:6">अपनेच सरूप म बनाय हवय।<verse eid="GEN 9:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="GEN 9:7" />अऊ तुमन फूलव-फरव अऊ गनती म बढ़व; धरती ऊपर बहुंत बढ़व अऊ येमा भर जावव।”<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />फेर परमेसर ह नूह अऊ ओकर बेटामन ला कहिस, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“सुनव, में अब तुम्हर संग अऊ तुम्हर पाछू तुम्हर होवइया संतानमन संग करार करत हंव; <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />अऊ जम्मो जीयत परानी जेमन तुम्हर संग हवंय—चिरई, घरेलू-पसु अऊ जम्मो जंगली पसु, अऊ धरती ऊपर जम्मो जीयत परानी, जऊन मन तुम्हर संग जहाज ले निकले हवंय, ओमन संग घलो। <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />में तुम्हर संग अपन ये करार करत हंव: फेर कभू जम्मो परानी जल-परलय ले नास नइं होवंय; फेर कभू धरती ला नास करे बर जल-परलय नइं होवय।”<verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />फेर परमेसर ह कहिस, “जऊन करार मेंह तुम्हर अऊ जतेक जीयत परानी तुम्हर संग हवंय, ओ सबो के संग करत हंव, येह अवइया तुम्हर जम्मो पीढ़ी बर होही अऊ ओकर ये चिनहां होही: <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />मेंह बादर म अपन मेघ-धनुस रखे हवंव, अऊ येह मोर अऊ धरती के बीच म करार के चिनहां होही। <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />जब भी में धरती ऊपर बादर लानंव अऊ बादर म मेघ-धनुस दिखय, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />त मेंह जऊन करार तुम्हर अऊ जम्मो किसम के जीयत परानीमन संग करे हंव, ओला में सुरता करहूं। फेर कभू अइसन जल-परलय जम्मो परानी के बिनास बर नइं होवय। <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />जब भी बादर म मेघ-धनुस दिखही, त मेंह ओला देखके ओ सदाकाल के करार ला सुरता करहूं, जऊन ला परमेसर अऊ धरती के जम्मो किसम के जीयत परानीमन के बीच करे गे हवय।”<verse eid="GEN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17" />फेर परमेसर ह नूह ले कहिस, “जऊन करार मेंह धरती के जम्मो परानीमन संग करे हंव, ओकर ये चिनहां अय।”<verse eid="GEN 9:17" /></para>
  <para style="s1">नूह के बेटामन</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />नूह के बेटा, जेमन जहाज ले निकलिन, ओमन के नांव सेम, हाम अऊ येपेत रिहिस। (हाम ह कनान के ददा रिहिस।) <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />येमन नूह के तीन बेटा रिहिन, अऊ येमन के संतानमन जम्मो धरती म बगर गीन।<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />नूह ह भुइयां ले जुड़े मनखे रिहिस अऊ ओह अंगूर के एक बारी लगाईस। <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />एक दिन ओह अंगूर के मंद ला पीके मतवार हो गीस, अऊ अपन तम्बू के भीतर नंगरा पड़े रिहिस। <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />तब कनान के ददा, हाम ह अपन ददा ला नंगरा देखिस अऊ बाहिर आके अपन दूनों भाईमन ला बताईस। <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />तब सेम अऊ येपेत एक कपड़ा लेके अपन खांधा म रखिन अऊ उल्टा रेंगत अपन ददा के नंगरा देहें ला ढांप दीन। ओमन अपन मुहूं ला आने कोति करे रिहिन ताकि ओमन अपन ददा ला नंगरा झन देखंय।<verse eid="GEN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24" />जब नूह के नसा उतरिस, त ओह जान डारिस कि ओकर सबले छोटे बेटा ह ओकर संग का करे हे। <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />एकरसेति ओह कहिस,</para>
  <para style="q1" vid="GEN 9:25">“कनान ला सराप लगय!</para>
  <para style="q2" vid="GEN 9:25">ओह अपन भाईमन के</para>
  <para style="q2" vid="GEN 9:25">दास म सबले छोटे दास होवय।”<verse eid="GEN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26" />ओह ये घलो कहिस,</para>
  <para style="q1" vid="GEN 9:26">“सेम के परमेसर यहोवा के महिमा होवय!</para>
  <para style="q2" vid="GEN 9:26">कनान ह सेम के दास होवय।<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />परमेसर ह येपेत<note caller="+" style="f"><char style="fr" closed="false">9:27 </char><char style="fq" closed="false">येपेत </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">फईलई।</char></note> के इलाका ला बढ़ाय;</para>
  <para style="q2" vid="GEN 9:27">येपेत ह सेम के तम्बू म रहय</para>
  <para style="q2" vid="GEN 9:27">अऊ कनान ह येपेत के गुलाम बनय।”<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />जल-परलय के बाद नूह 350 बछर जीईस। <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />ये किसम ले नूह के कुल उमर 950 बछर होईस, अऊ तब ओह मर गीस।<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s1">देस अऊ जातिमन के बिबरन</para>
  <para style="lh">
    <verse number="1" style="v" sid="GEN 10:1" />येह नूह के बेटा सेम, हाम अऊ येपेत के बंसावली अय। जल-परलय के बाद ओमन के ये बेटामन जनमिन।<verse eid="GEN 10:1" /></para>
  <para style="s2">येपेत के संतान</para>
  <para style="li1">
    <verse number="2" style="v" sid="GEN 10:2" />येपेत के बेटामन<note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="fq" closed="false">बेटामन </char><char style="ft" closed="false">एकर मतलब </char><char style="fqa" closed="false">बंसज </char><char style="ft" closed="false">घलो हो सकथे। <char style="xt" link-href="GEN 10:3"><ref loc="GEN 10:3">पद 3</ref></char>, <char style="xt" link-href="GEN 10:4"><ref loc="GEN 10:4">4</ref></char>, <char style="xt" link-href="GEN 10:6"><ref loc="GEN 10:6">6</ref></char>, <char style="xt" link-href="GEN 10:7"><ref loc="GEN 10:7">7</ref></char>, <char style="xt" link-href="GEN 10:20‑23"><ref loc="GEN 10:20">20‑23</ref></char>, <char style="xt" link-href="GEN 10:29"><ref loc="GEN 10:29">29</ref></char> अऊ <char style="xt" link-href="GEN 10:31"><ref loc="GEN 10:31">31</ref></char> म घलो</char></note>:</para>
  <para style="li2" vid="GEN 10:2">गोमेर, मागोग, मादै, यावान, तूबल, मेसेक अऊ तीरास होईन।<verse eid="GEN 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 10:3" />गोमेर के बेटामन:</para>
  <para style="li2" vid="GEN 10:3">असकनज, रीपत अऊ तोगरमा होईन।<verse eid="GEN 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="GEN 10:4" />यावान के बेटामन:</para>
  <para style="li2" vid="GEN 10:4">एलीसाह, तरसीस, कित्ती अऊ रोदानीमन होईन। <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />(येमन ले समुंदर तीर के मनखेमन अपन-अपन छेत्र म अपन गोत्र, अपन जाति अऊ अपन भासा के मुताबिक अलग-अलग हो गीन।)<verse eid="GEN 10:5" /></para>
  <para style="s2">हाम के संतान</para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 10:6" />हाम के बेटामन:</para>
  <para style="li2" vid="GEN 10:6">कूस, मिसर, पूत अऊ कनान होईन।<verse eid="GEN 10:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="GEN 10:7" />कूस के बेटामन:</para>
  <para style="li2" vid="GEN 10:7">सबा, हवीला, सबता, रामा, अऊ सबतका होईन।</para>
  <para style="li1" vid="GEN 10:7">रामा के बेटामन:</para>
  <para style="li2" vid="GEN 10:7">सेबा अऊ ददान होईन।<verse eid="GEN 10:7" /></para>
  <para style="lf">
    <verse number="8" style="v" sid="GEN 10:8" />कूस ह निमरोद के ददा<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="fq" closed="false">ददा </char><char style="ft" closed="false">एकर मतलब </char><char style="fqa" closed="false">पुरखा </char><char style="ft" closed="false">घलो हो सकथे; <char style="xt" link-href="GEN 10:13"><ref loc="GEN 10:13">पद 13</ref></char>, <char style="xt" link-href="GEN 10:15"><ref loc="GEN 10:15">15</ref></char>, <char style="xt" link-href="GEN 10:24"><ref loc="GEN 10:24">24</ref></char> अऊ <char style="xt" link-href="GEN 10:26"><ref loc="GEN 10:26">26</ref></char></char></note> रिहिस; निमरोद ह धरती म पहिला बड़े बीर होईस। <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />ओह यहोवा के नजर म एक बड़े सिकारी रिहिस; एकर खातिर ये कहे जाथे, “निमरोद के सहीं, यहोवा के नजर म एक बड़े सिकारी।” <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />ओकर राज के पहिली केन्द्रमन सिनार<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false">याने कि, बेबिलोनिया</char></note> देस म बेबिलोन, ऊरूक, अक्कद अऊ कलने रिहिन। <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />ओ देस ले, ओह निकलके अस्सूर देस म गीस, अऊ उहां नीनवे, रहोबोत-ईर अऊ कालह सहर बसाईस, <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />अऊ नीनवे अऊ कालह के बीच म रेसेन सहर बसाईस—जऊन ह बड़े सहर अय।<verse eid="GEN 10:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 10:13" />मिसर ह</para>
  <para style="li2" vid="GEN 10:13">लूदी, अनामी, लहाबी, नपतूही, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />अऊ पतरूसी, कसलूही (जेकर ले पलिस्तीमन आईन) अऊ कपतोरी मनखेमन के ददा रिहिस।<verse eid="GEN 10:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 10:15" />कनान के बड़े बेटा</para>
  <para style="li2" vid="GEN 10:15">सीदोन रिहिस,<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सीदोनीमन के पुरखा</char></note> तेकर पाछू हित्ती, <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />यबूसी, अमोरी, गिरगासी, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />हिब्बी, अरकी, सीनी, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />अरवदी, समारी अऊ हमातीमन घलो होईन।</para>
  <para style="li2" vid="GEN 10:18">(बाद म कनानी कुल के मनखेमन बगर गीन <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />अऊ कनानीमन के सीमना ह सीदोन ले लेके गरार के तरफ गाजा तक, अऊ फेर सदोम, अमोरा, अदमा अऊ सबोईम के तरफ लासा तक होईस।)<verse eid="GEN 10:19" /></para>
  <para style="lf">
    <verse number="20" style="v" sid="GEN 10:20" />येमन हाम के बंसज रिहिन, अऊ येमन अपन गोत्र अऊ भासा के मुताबिक अपन-अपन इलाका अऊ जाति म अलग हो गीन।<verse eid="GEN 10:20" /></para>
  <para style="s2">सेम के संतान</para>
  <para style="lh">
    <verse number="21" style="v" sid="GEN 10:21" />सेम जऊन ह येपेत के बड़े भाई रिहिस, ओकर घलो बेटामन होईन, अऊ सेम ह जम्मो एबेर बंस के पुरखा रिहिस।<verse eid="GEN 10:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 10:22" />सेम के बेटामन:</para>
  <para style="li2" vid="GEN 10:22">एलाम, अस्सूर, अर्पछद, लूद अऊ अराम होईन।<verse eid="GEN 10:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 10:23" />अराम के बेटामन:</para>
  <para style="li2" vid="GEN 10:23">ऊस, हूल, गेतेर अऊ मेसेक<note caller="+" style="f"><char style="fr" closed="false">10:23 </char><char style="ft" closed="false">देखव सेप्टाजिन्ट अऊ <char style="xt"><ref loc="1CH 1:17">1 इति 1:17</ref></char>; इबरानी म </char><char style="fqa" closed="false">मस</char></note> होईन।<verse eid="GEN 10:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 10:24" />अर्पछद ह सेलह के ददा</para>
  <para style="li2" vid="GEN 10:24">अऊ सेलह ह एबेर के ददा रिहिस।<verse eid="GEN 10:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 10:25" />एबेर के दू झन बेटा होईन:</para>
  <para style="li2" vid="GEN 10:25">एक के नांव पेलेग<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="fq" closed="false">पेलेग </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">बंटवारा</char></note> रखे गीस, काबरकि ओकर समय म धरती ह बंट गीस; ओकर भाई के नांव योकतान रिहिस।<verse eid="GEN 10:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 10:26" />योकतान के बेटामन</para>
  <para style="li2" vid="GEN 10:26">अलमोदाद, सेलेप, हसरमावेत, येरह <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />हदोराम, ऊजाल, दिकला, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ओबाल, अबीमाएल, सेबा, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />ओपीर, हवीला अऊ योबाब रिहिन। ये जम्मो योकतान के बेटा रिहिन।<verse eid="GEN 10:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="GEN 10:30" />(ओ जगह जिहां येमन रहत रिहिन, ओह पूरब दिग के पहाड़ी देस म मेसा ले लेके सपारा तक फईले रिहिस।)<verse eid="GEN 10:30" /></para>
  <para style="lf">
    <verse number="31" style="v" sid="GEN 10:31" />येमन सेम के बंसज रिहिन, अऊ येमन अपन गोत्र अऊ भासा के मुताबिक अपन-अपन छेत्र अऊ जाति म अलग हो गीन।<verse eid="GEN 10:31" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="32" style="v" sid="GEN 10:32" />अपन-अपन संतान अऊ जाति के मुताबिक, येमन नूह के बेटामन के बंसज अंय। जल-परलय के बाद, जाति-जाति के मनखेमन येमन ले निकलके धरती म बगर गीन।<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s1">बेबिलोन के मीनार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />जम्मो धरती म एके ठन भासा अऊ एके किसम के बोली रिहिस। <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />ओ समय जब मनखेमन पूरब दिग कोति जावत रिहिन, त ओमन ला सिनार देस म एक मैदान मिलिस अऊ उहां ओमन बस गीन।<verse eid="GEN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3" />तब ओमन एक-दूसर ला कहिन, “आवव, हमन ईंटा बना-बनाके ओला आगी म बने करके पकावन।” ओमन पथरा के बदला ईंटा अऊ चूना के गारा के बदला डामर के उपयोग करिन। <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />फेर ओमन कहिन, “आवव, हमन अपन बर एक सहर अऊ एक मीनार बनावन, जेकर चोटी अकास तक हबरे, ताकि हमर नांव होवय; नइं तो हमन ला जम्मो धरती ऊपर बगरे बर पड़ही।”<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />जब मनखेमन सहर अऊ मीनार बनाय लगिन, त यहोवा ह ओ सहर अऊ मीनार ला देखे बर खाल्हे उतर आईस। <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />अऊ यहोवा ह कहिस, “ये जम्मो झन एकेच दल अंय, अऊ येमन के भासा घलो एके ठन अय, अऊ येमन ये काम ला सुरू कर डारे हें; अब येमन जऊन कुछू भी बनाय के योजना करहीं, येमन बर कुछू भी असंभव नइं होही। <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />एकरसेति आवव, हमन उतरके येमन के भासा म गड़बड़ी कर देवन ताकि येमन एक-दूसर के बात ला झन समझंय।”<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />अइसने करके यहोवा ह ओमन ला उहां ले जम्मो धरती ऊपर बगरा दीस, अऊ ओमन ओ सहर ला बनाना छोंड़ दीन। <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />एकरे बर ओ सहर के नांव बेबिलोन<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fq" closed="false">बेबिलोन </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">गड़बड़ी</char></note> पड़िस—काबरकि उहां यहोवा ह जम्मो धरती के भासा म गड़बड़ी करिस, अऊ उहां ले यहोवा ह मनखेमन ला धरती के जम्मो जगह बगरा दीस।<verse eid="GEN 11:9" /></para>
  <para style="s1">सेम ले लेके अब्राम तक</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />सेम के परिवार के बिबरन ये अय।</para>
  <para style="b" vid="GEN 11:10" />
  <para style="li1" vid="GEN 11:10">जल-परलय के दू बछर के पाछू, जब सेम ह 100 बछर के होईस, त ओह अर्पछद के ददा<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="fq" closed="false">ददा </char><char style="ft" closed="false">के मतलब </char><char style="fqa" closed="false">पुरखा हो सकथे</char></note> होईस। <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />अर्पछद के जनम के पाछू, सेम ह 500 बछर जीयत रिहिस अऊ ओकर अऊ भी बेटा-बेटीमन होईन।<verse eid="GEN 11:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 11:12" />जब अर्पछद 35 बछर के होईस, त ओकर ले सेलह के जनम होईस। <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />अऊ सेलह के जनम के पाछू, अर्पछद ह 403 बछर अऊ जीयत रिहिस अऊ ओकर अऊ भी बेटा-बेटीमन होईन।<verse eid="GEN 11:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 11:14" />जब सेलह 30 बछर के होईस, त ओकर ले एबेर के जनम होईस। <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />अऊ एबेर के जनम के पाछू, सेलह ह 403 बछर अऊ जीयत रिहिस अऊ ओकर अऊ भी बेटा-बेटीमन होईन।<verse eid="GEN 11:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="GEN 11:16" />जब एबेर 34 बछर के होईस, त ओकर ले पेलेग के जनम होईस। <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />अऊ पेलेग के जनम के पाछू, एबेर 430 बछर अऊ जीयत रिहिस अऊ ओकर अऊ भी बेटा-बेटीमन होईन।<verse eid="GEN 11:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 11:18" />जब पेलेग 30 बछर के होईस, त ओकर ले रू के जनम होईस। <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />अऊ रू के जनम के पाछू, पेलेग 209 बछर अऊ जीयत रिहिस अऊ ओकर अऊ बेटा-बेटीमन होईन।<verse eid="GEN 11:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="GEN 11:20" />जब रू 32 बछर के होईस, त ओकर ले सरूग के जनम होईस। <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />अऊ सरूग के जनम के पाछू, रू 207 बछर अऊ जीयत रिहिस अऊ ओकर अऊ बेटा-बेटीमन होईन।<verse eid="GEN 11:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 11:22" />जब सरूग 30 बछर के होईस, त ओकर ले नाहोर के जनम होईस। <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />अऊ नाहोर के जनम के पाछू, सरूग 200 बछर अऊ जीयत रिहिस अऊ ओकर अऊ बेटा-बेटीमन होईन।<verse eid="GEN 11:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 11:24" />जब नाहोर 29 बछर के होईस, त ओकर ले तेरह के जनम होईस। <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />अऊ तेरह के जनम के पाछू, नाहोर 119 बछर अऊ जीयत रिहिस अऊ ओकर अऊ बेटा-बेटीमन होईन।<verse eid="GEN 11:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 11:26" />जब तेरह 70 बछर के होईस, त ओकर ले अब्राम, नाहोर अऊ हारान के जनम होईस।<verse eid="GEN 11:26" /></para>
  <para style="s1">अब्राम के परिवार</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />तेरह के परिवार के बिबरन ये अय।</para>
  <para style="b" vid="GEN 11:27" />
  <para style="p" vid="GEN 11:27">तेरह ले अब्राम, नाहोर अऊ हारान के जनम होईस। अऊ हारान ले लूत के जनम होईस। <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />हारान अपन ददा तेरह के जीते जी कसदीमन के ऊर नांव के नगर म, जऊन ह ओकर जनम भुइयां रिहिस, मर गीस। <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />अब्राम अऊ नाहोर दूनों झन बिहाव कर लीन। अब्राम के घरवाली के नांव सारै, अऊ नाहोर के घरवाली के नांव मिलका रिहिस; ओह हारान के बेटी रिहिस, जऊन ह मिलका अऊ यिसका दूनों के ददा रिहिस। <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />सारै के कोनो बाल-बच्चा नइं रिहिन, काबरकि ओला कभू गरभ नइं ठहिरिस।<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />तेरह अपन बेटा अब्राम, अपन पोता लूत, जेह हारान के बेटा रिहिस, अऊ अपन बहू सारै, जेह ओकर बेटा अब्राम के घरवाली रिहिस, ये जम्मो झन ला लेके कसदीमन के ऊर नगर ले कनान देस जाय बर निकलिस। पर जब ओमन हारान नांव के देस म आईन, त उहेंच रहे लगिन।<verse eid="GEN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32" />तेरह 205 बछर जीईस, अऊ ओह हारान देस म मर गीस।<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s1">अब्राम ला परमेसर के बुलावा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />यहोवा ह अब्राम ला कहिस, “अपन देस, अपन मनखे अऊ अपन ददा के परिवार ला छोंड़के ओ देस म चले जा, जेला मेंह तोला देखाहूं।<verse eid="GEN 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />“मेंह तोर ले एक बड़े जाति बनाहूं</para>
  <para style="q2" vid="GEN 12:2">अऊ मेंह तोला आसीस दूहूं;</para>
  <para style="q1" vid="GEN 12:2">मेंह तोर नांव ला बहुंत बड़े करहूं</para>
  <para style="q2" vid="GEN 12:2">अऊ तेंह आसीस के कारन होबे।<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />जऊन मन तोला आसीस दीहीं, ओमन ला में आसीस दूहूं</para>
  <para style="q2" vid="GEN 12:3">अऊ जऊन ह तोला सराप दीही, ओला मेंह सराप दूहूं;</para>
  <para style="q1" vid="GEN 12:3">अऊ ये धरती के जम्मो मनखेमन</para>
  <para style="q2" vid="GEN 12:3">तोर जरिये आसीस पाहीं।”<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मनखेमन आसीस देय म तोर नांव के उपयोग करहीं </char><char style="ft" closed="false">(देखव <char style="xt"><ref loc="GEN 48:20">48:20</ref></char>)</char></note><verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />यहोवा के ये बचन के मुताबिक अब्राम ह चल पड़िस; अऊ ओकर संग लूत घलो गीस। अब्राम ह पचहत्तर बछर के रिहिस, जब ओह हारान देस ले निकलिस। <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />अब्राम अपन घरवाली सारै, अपन भतीजा लूत, जऊन धन ओमन जमा करे रिहिन अऊ जऊन मनखेमन ला ओमन हारान म पाय रिहिन, ओ सबो ला लेके कनान देस जाय बर निकलिस अऊ ओमन कनान देस म आ गीन।<verse eid="GEN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 12:6" />ओ देस म ले होवत अब्राम ह सकेम म मोरे के बड़े रूख तक गीस। ओ समय ओ देस म कनानीमन रहत रिहिन। <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />तब यहोवा ह अब्राम ला दरसन देके कहिस, “तोर संतान ला में ये देस दूहूं।” एकरसेति ओह उहां यहोवा बर, जऊन ह ओला दरसन दे रिहिस, एक बेदी बनाईस।<verse eid="GEN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 12:8" />फेर उहां ले चलके ओह ओ पहाड़ करा आईस, जऊन ह बेतेल के पूरब कोति हवय, अऊ उहां ओह अपन तम्बू गाड़िस, जेकर पछिम कोति बेतेल अऊ पूरब कोति अई नगर हवय। उहां घलो ओह यहोवा बर एक ठन बेदी बनाईस अऊ यहोवा के अराधना करिस।<verse eid="GEN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 12:9" />तब अब्राम उहां ले निकलके नेगेव कोति चल दीस।<verse eid="GEN 12:9" /></para>
  <para style="s1">मिसर देस म अब्राम</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />कनान देस म अकाल पड़िस, एकर कारन अब्राम ह खाल्हे कोति मिसर देस म चल दीस अऊ उहां कुछू समय तक रिहिस, काबरकि देस म भयंकर अकाल रिहिस। <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />जब ओह मिसर देस म हबरनेचवाला रिहिस, त ओह अपन घरवाली सारै ला कहिस, “सुन, मेंह जानत हंव कि तें एक सुघर नारी अस। <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />जब मिसर देस के मनखेमन तोला देखहीं, त कहिहीं, ‘येह ओकर घरवाली अय।’ तब ओमन मोला तो मार डारहीं, पर तोला छोंड़ दीहीं। <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />एकरसेति ये कहिबे कि तें मोर बहिनी अस, ताकि तोर कारन मोर संग बने बरताव होवय अऊ मोर परान ह तोर कारन बच जावय।”<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />जब अब्राम मिसर म आईस, त मिसर देस के मनखेमन देखिन कि सारै ह बहुंत सुघर हे। <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />अऊ जब फिरौन<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">येह राजा के नांव नो हय पर येह मिसर देस के राजा के उपाधि ए</char></note> के अधिकारीमन ओला देखिन, त फिरौन के आघू म ओकर बड़ई करिन, एकरसेति सारै ला फिरौन के महल म लाय गीस। <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />फिरौन ह ओकर कारन से अब्राम के संग बने बरताव करिस, अऊ अब्राम ला भेड़-बकरी, गरूवा-बईला, गदहा-गदही अऊ दास-दासी, अऊ ऊंट मिलिस।<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />पर यहोवा ह फिरौन अऊ ओकर परिवार ऊपर अब्राम के घरवाली सारै के कारन बड़े-बड़े बेमारी लानिस। <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />तब फिरौन ह अब्राम ला बलाके कहिस, “तेंह मोर संग ये का करे हस? तें मोला काबर नइं बताय कि ओह तोर घरवाली ए? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />तेंह काबर कहे कि ओह तोर बहिनी ए? एकरसेति मेंह ओला अपन घरवाली बनाय बर ले गे रहेंव। पर अब अपन घरवाली ला ले अऊ इहां ले चले जा!” <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />तब फिरौन ह अपन मनखेमन ला अब्राम के बारे म हुकूम दीस, अऊ ओमन ओला अऊ ओकर घरवाली ला, ओकर जम्मो धन-संपत्ति सहित बिदा कर दीन।<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s1">अब्राम अऊ लूत के अलग होवई</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />तब अब्राम अपन घरवाली अऊ अपन जम्मो संपत्ति ला लेके मिसर देस ले नेगेव<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">कनान के दक्खिन के भाग</char></note> गीस, अऊ लूत घलो ओकर संग म गीस। <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />अब्राम ह घरेलू-पसु अऊ सोन अऊ चांदी म अब्बड़ धनी हो गे रिहिस।<verse eid="GEN 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 13:3" />नेगेव ले चलके जगह-जगह होवत ओह बेतेल के लकठा म हबरिस, बेतेल अऊ अई नगर के बीच म, जिहां पहिली ओह अपन तम्बू ठाढ़ करे रिहिस <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />अऊ जिहां ओह पहिली बार बेदी बनाय रिहिस, उहां अब्राम ह यहोवा के अराधना करिस।<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />लूत, जऊन ह अब्राम संग चलत रिहिस, ओकर करा घलो भेड़-बकरी, गरूवा-बईला अऊ तम्बू रिहिस। <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />पर ओ जगह ह ओ दूनों ला नइं पूरत रिहिस। काबरकि ओमन के धन-संपत्ति अतकी जादा हो गे रिहिस कि ओमन एक संग रह नइं सकिन। <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />अब्राम अऊ लूत के चरवाहामन के बीच म झगरा होय लगिस। ओ समय कनानी अऊ परिज्जीमन घलो ओ देस म रहत रिहिन।<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />तब अब्राम ह लूत ला कहिस, “मोर अऊ तोर बीच, या मोर चरवाहा अऊ तोर चरवाहामन के बीच झगरा झन होवय, काबरकि हमन नजदीकी रिस्तेदार अन। <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />का पूरा देस तोर आघू म नइं ए? एकर खातिर मोर ले अलग हो जा। यदि तें डेरी कोति जाबे, त में जेवनी कोति जाहूं, अऊ यदि तें जेवनी कोति जाबे, त में डेरी कोति जाहूं।”<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />तब लूत ह चारों कोति देखिस कि सोअर कोति यरदन नदी के मैदान ह यहोवा के बगीचा अऊ मिसर देस सहीं पानी ले बने सिंचाय हवय। (येह ओ समय के बात ए, जब यहोवा ह सदोम अऊ अमोरा ला नास नइं करे रिहिस।) <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />एकरसेति लूत ह अपन बर यरदन के पूरा मैदान ला चुनके पूरब कोति गीस। अऊ ओ दूनों एक-दूसर ले अलग हो गीन: <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />अब्राम ह कनान देस म रह गीस, जबकि लूत ह ओ मैदान के सहरमन म रहे लगिस अऊ अपन तम्बू सदोम के लकठा म ठाढ़ करिस। <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />सदोम के मनखेमन दुस्ट रिहिन अऊ यहोवा के बिरूध बहुंत पाप करत रिहिन।<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />जब लूत ह अब्राम ले अलग हो गीस, तब यहोवा ह अब्राम ला कहिस, “जिहां तेंह ठाढ़े हस, उहां ले आंखी उठाके उत्तर, दक्खिन, पूरब अऊ पछिम चारों कोति देख। <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />काबरकि जतेक भुइयां तोला दिखत हे, ओ सब ला मेंह तोला अऊ तोर संतान<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">बीजा </char><char style="ft" closed="false"><char style="xt" link-href="GEN 13:16"><ref loc="GEN 13:16">पद 16</ref></char> म घलो</char></note> ला सदाकाल बर दूहूं। <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />अऊ में तोर बंस के मनखेमन ला धरती के धुर्रा के कन सहीं बहुंत करहूं, ताकि यदि कोनो धरती के धुर्रा ला गने सकही, त फेर ओह तोर संतानमन ला घलो गने सकही। <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />उठ, अऊ ये देस के लम्बई अऊ चौड़ई म जतकी रेंग सकथस रेंग, काबरकि में येला तोला देवत हंव।”<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />एकरसेति अब्राम ह हेबरोन म ममरे के बड़े रूखमन के लकठा म रहे बर गीस अऊ उहां अपन तम्बू ठाढ़ करिस। अऊ उहां यहोवा बर एक ठन बेदी बनाईस।<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s1">अब्राम ह लूत ला बचाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />ओ समय जब सिनार<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">बेबिलोनिया; <char style="xt" link-href="GEN 14:9"><ref loc="GEN 14:9">पद 9</ref></char> म घलो</char></note> के राजा अमरापेल, एल्लासार के राजा अरयोक, एलाम के राजा कदोरलाओमेर अऊ गोयीम के राजा तिदाल रिहिस, <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />त ये राजामन सदोम के राजा बेरा, अमोरा के राजा बिरसा, अदमा के राजा सिनाब, सबोईम के राजा सेमेबेर अऊ बेला के राजा (जऊन ला सोअर कहे जाथे) के बिरूध लड़ई करिन। <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />ये पांचों राजामन सिद्दीम नांव के घाटी म (जऊन ला मिरतू सागर घाटी कहे जाथे) जूरिन। <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />काबरकि बारह बछर तक येमन कदोरलाओमेर के अधीन रिहिन, पर तेरहवां बछर म येमन ओकर बिरूध बिदरोह करिन।<verse eid="GEN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 14:5" />चौदहवां बछर म कदोरलाओमेर अऊ ओकर संगी राजामन एक संग आईन अऊ असतरोत-करनेम म रपाईमन, हाम म जूजीमन, साबे-किरयातैम म एमीमन <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />अऊ सेईर के पहाड़ी म होरीमन ऊपर चढ़ई करिन अऊ ओमन ला हरावत-हरावत मरू-भुइयां के लकठा म एल-पारान तक हबर गीन। <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />तब उहां ले ओमन लहुंटके एन-मिसपात (जऊन ला कादेस कहे जाथे) म आईन, अऊ ओमन अमालेकीमन के जम्मो देस ला अऊ संग म ओ अमोरीमन ला घलो जीत लीन, जेमन हससोन-तामार म रहत रिहिन।<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />तब सदोम के राजा, अमोरा के राजा, अदमा के राजा, सबोईम के राजा अऊ बेला के राजा (जऊन ला सोअर कहे जाथे) निकलिन अऊ सिद्दीम नांव के घाटी म <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />एलाम के राजा कदोरलाओमेर, गोयीम के राजा तिदाल, सिनार के राजा अमरापेल अऊ एल्लासार के राजा अरयोक के बिरूध म लड़ई करे बर ठाढ़ होईन—चार राजामन पांच राजामन के बिरूध म रहंय। <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />सिद्दीम के घाटी ह डामर के खंचवामन ले भर गे रिहिस, अऊ जब सदोम अऊ अमोरा के राजामन भागिन, त कुछू मनखेमन ओ खंचवामन म गिरिन अऊ बांचे मनखेमन पहाड़ी ऊपर भाग गीन। <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />तब ओ चारों राजा सदोम अऊ अमोरा के जम्मो सामान अऊ खाय के चीजमन ला लूटके चल दीन। <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />ओमन अब्राम के भतीजा लूत, जऊन ह सदोम म रहत रिहिस, ओला अऊ ओकर धन-संपत्ति ला घलो अपन संग ले गीन।<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />तब एक मनखे जऊन ह भागके बांच गे रिहिस, ओह जाके इबरी अब्राम ला ये बात बताईस। अब्राम तो अमोरी ममरे जऊन ह एसकोल अऊ आनेर के एक भाई<note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">रिस्तेदार</char><char style="ft" closed="false">; या </char><char style="fqa" closed="false">एक संगी</char></note> रिहिस, ओकर बड़े रूखमन के लकठा म रहत रिहिस; येमन के संबंध अब्राम के संग संगवारी के सहीं रिहिस। <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />जब अब्राम सुनिस कि ओकर भतीजा ला बंधुवई म ले गे हवंय, त ओह 318 लड़ई करे बर सिखोय मनखेमन ला, जेमन ओकर परिवार म जनमे रिहिन, लीस अऊ दान नगर तक ओमन के पीछा करिस। <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />रथिया के बेरा अब्राम ह ओमन ऊपर हमला करे बर अपन मनखेमन के अलग-अलग दल बनाईस अऊ दमिस्क सहर के उत्तर म होबा तक ओमन के पीछा करिस, अऊ ओमन ला हराईस। <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />अऊ ओह जम्मो सामान ला, अऊ अपन भतीजा लूत अऊ ओकर धन-संपत्ति ला, अऊ माईलोगन अऊ दूसर मनखेमन ला छोंड़ाके ले आईस।<verse eid="GEN 14:16" /></para>
  <para style="s1">अब्राम ला मलकिसिदक के आसीस</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />जब अब्राम ह कदोरलाओमेर अऊ ओकर संगी राजामन ला हराके लहुंटत रिहिस, तब सदोम के राजा ह साबे नांव के घाटी म (जेला राजा के घाटी घलो कहे जाथे) अब्राम के संग भेंट करे बर आईस।<verse eid="GEN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 14:18" />तब सालेम<note caller="+" style="f"><char style="fr" closed="false">14:18 </char><char style="ft" closed="false">बाद म येला </char><char style="fqa" closed="false">यरूसलेम </char><char style="ft" closed="false">कहे गीस; <char style="xt"><ref loc="PSA 76:2">भजन 76:2</ref></char></char></note> के राजा मलकिसिदक रोटी अऊ अंगूर के मंद लेके आईस। ओह सर्वोच्च परमेसर के पुरोहित रिहिस, <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />अऊ ओह ये कहिके अब्राम ला आसीस दीस,</para>
  <para style="q1" vid="GEN 14:19">“सर्वोच्च परमेसर ले, जऊन ह अकास अऊ धरती के रचइता ए,</para>
  <para style="q2" vid="GEN 14:19">तोला आसीस मिलय।<verse eid="GEN 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20" />अऊ सर्वोच्च परमेसर के महिमा होवय,</para>
  <para style="q2" vid="GEN 14:20">जऊन ह तोर बईरीमन ला तोर बस म कर दीस।”</para>
  <para style="m" vid="GEN 14:20">तब अब्राम ह ओला हर एक चीज के दसवां भाग दीस।<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />तब सदोम के राजा ह अब्राम ला कहिस, “मनखेमन ला तें मोला दे अऊ धन ला तें अपन बर रख।”<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />पर अब्राम ह सदोम के राजा ला कहिस, “यहोवा, सर्वोच्च परमेसर जऊन ह अकास अऊ धरती के रचइता ए, ओकर करा मेंह हांथ उठाके किरिया खाय हंव <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />कि जऊन चीज तोर अय, ओमा ले में कुछू नइं लेवंव, न एक ठन सूंत, न जूता के एक बंधना घलो, ताकि तें ये कभू झन कहे सकस, ‘मेंह अब्राम ला धनी बनांय।’ <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />पर जऊन कुछू मोर मनखेमन खा ले हवंय अऊ ओमन के बांटा, जऊन मन मोर संग गे रिहिन याने कि आनेर, एसकोल अऊ ममरे के बांटा, में तोला नइं लहुंटांव। ओमन ला अपन बांटा रखन दे।”<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s1">अब्राम संग यहोवा के करार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />एकर पाछू, यहोवा के ये बचन दरसन के दुवारा अब्राम करा आईस:</para>
  <para style="q1" vid="GEN 15:1">“हे अब्राम, झन डर।</para>
  <para style="q2" vid="GEN 15:1">मेंह तोर ढाल</para>
  <para style="q2" vid="GEN 15:1">अऊ तोर बड़े ईनाम अंव।<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">तोर ईनाम ह बड़े होही</char></note>”<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />पर अब्राम ह कहिस, “हे परमपरधान यहोवा, तें मोला का दे सकथस, जब में बिन लइका के हंव अऊ मोर घर के वारिस दमिस्क के एलिएजेर होही?” <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />अऊ अब्राम ह कहिस, “मोला तो तें कोनो लइका नइं दे हस; एकरसेति मोर परिवार म एक दास ह मोर वारिस होही।”<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />तब यहोवा के ये बचन ओकर करा आईस, “ये मनखे ह तोर वारिस नइं होवय, पर तोर खुद के मांस अऊ लहू ले जनमे बेटा ही तोर वारिस होही।” <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />ओह ओला बाहिर ले जाके कहिस, “आंखी उठाके अकास कोति देख अऊ ये तारामन ला गन—का तें येमन ला गन सकथस?” फेर ओह ओला कहिस, “तोर संतान ह अइसने होही।”<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />अब्राम ह यहोवा ऊपर बिसवास करिस, अऊ परमेसर ह येला अब्राम बर धरमीपन के बात मानिस।<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />परमेसर ह अब्राम ला ये घलो कहिस, “में ओही यहोवा अंव, जऊन ह तोला कसदीमन के ऊर नगर ले बाहिर लानेंव ताकि तोला ये देस ऊपर अधिकार देवंव।”<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />पर अब्राम ह कहिस, “हे परमपरधान यहोवा, में येला कइसे जानंव कि मेंह ये देस के ऊपर अधिकार रखहूं?”<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />त यहोवा ह ओला कहिस, “मोर बर तीन-तीन बछर के एक बछिया, एक बोकरा अऊ एक मेढ़ा लान अऊ संग म एक पंड़की अऊ एक परेवा के पीला लान।”<verse eid="GEN 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10" />अब्राम ये जम्मो ला ओकर करा लानिस, अऊ ओमन के दू-दू कुटा करके ओ कुटामन ला एक-दूसर के आघू म मढ़ा दीस, पर चिरईमन ला ओह दू कुटा नइं करिस। <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />तब ओ मुरदामन ऊपर मांसाहारी चिरईमन झपटिन, पर अब्राम ओमन ला हंकाल दीस।<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />जब बेर ह बुड़त रिहिस, त अब्राम ह भारी नींद म सो गीस, अऊ भारी अऊ भयानक अंधियार ओकर ऊपर छा गीस। <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />तब यहोवा ह अब्राम ला कहिस, “ये बात ला निस्चय जान ले कि तोर संतानमन आने देस म चार सौ साल तक परदेसी होहीं अऊ उहां ओमन गुलाम बनाय जाहीं अऊ ओमन के ऊपर अतियाचार करे जाही। <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />पर जऊन देस के ओमन गुलाम के रूप म सेवा करहीं, ओ देस ला में दंड दूहूं, अऊ ओकर बाद ओमन उहां ले अब्बड़ धन लेके निकल आहीं। <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />पर, तें सांति से अपन पुरखामन संग मिल जाबे अऊ बने डोकरा होय के बाद तोला माटी मिलही। <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />पर चौथा पीढ़ी म, तोर संतानमन इहां फेर वापिस आहीं, काबरकि अमोरीमन के पाप के घड़ा ह अब तक नइं भरे हवय।”<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />जब बेर ह बुड़ गीस अऊ अंधियार छा गीस, तब एक अंगीठी म, जेमा ले धुआं उठत रहय, एक बरत मसाल दिखिस अऊ ओ मसाल मांस के कुटामन के बीच म ले निकल गीस। <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />ओ दिन यहोवा ह अब्राम के संग एक करार करिस अऊ कहिस, “मिसर के नरवा<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">मिसर के नदी</char></note> ले लेके फरात नांव के बड़े नदी तक— <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />याने कि केनी, कनिज्जी, कदमोनी, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />हित्ती, परिज्जी, रपाई, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />अमोरी, कनानी, गिरगासी अऊ यबूसीमन के देस ला में तोर संतानमन ला देवत हंव।”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s1">हाजिरा अऊ सारै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />अब्राम के घरवाली सारै के कोनो संतान नइं रिहिस। पर ओकर हाजिरा नांव के एक झन मिसर देस के दासी रिहिस; <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />एकरसेति सारै ह अब्राम ला कहिस, “देख, यहोवा ह मोर कोख ला बंद कर दे हवय, एकरसेति तें मोर दासी के संग सुत; हो सकत हे कि ओकर दुवारा मोर परिवार आघू बढ़य।”</para>
  <para style="p" vid="GEN 16:2">सारै के ये बात ला अब्राम मान लीस। <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />अब्राम ला कनान देस म रहत दस साल होय के बाद ओकर घरवाली सारै ह अपन मिसर के दासी हाजिरा ला अपन घरवाला अब्राम के घरवाली होय बर दे दीस। <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />ओह हाजिरा संग सुतिस, तब हाजिरा ह आसरा म हो गीस।</para>
  <para style="p" vid="GEN 16:4">जब ओह जानिस कि ओह आसरा म हवय, त ओह अपन मालकिन ला तुछ समझे लगिस। <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />तब सारै ह अब्राम ला कहिस, “मोर संग जऊन अनियाय होवथे, ओकर जिम्मेदार तें अस। में तो अपन दासी ला तोर हांथ म दे देंव, पर जब ओह ये जानिस कि ओह आसरा म हवय, त ओह मोला तुछ समझत हे। एकर बर यहोवा तोर अऊ मोर नियाय करय।”<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />अब्राम ह सारै ला कहिस, “देख, तोर दासी ह तोर हांथ<note caller="+" style="f"><char style="fr" closed="false">16:6 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">अधिकार</char></note> म हवय; जइसने तोला बने लगय, वइसने ओकर संग कर।” तब सारै ह हाजिरा ला दुख देय लगिस। एकरसेति ओह ओकर करा ले भाग गीस।<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />यहोवा के स्वरगदूत ह ओला सुनसान जगह म सूर के रसता म पानी के एक सोता करा पाईस। <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />अऊ ओह कहिस, “हे सारै के दासी, हाजिरा, तें कहां ले आवत हस, अऊ कहां जावत हस?”</para>
  <para style="p" vid="GEN 16:8">ओह जबाब दीस, “मेंह अपन मालकिन सारै करा ले भागके आय हंव।”<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />तब यहोवा के स्वरगदूत ह ओला कहिस, “अपन मालकिन करा लहुंट जा अऊ ओकर बस म रह।” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />यहोवा के स्वरगदूत ह ओला ये घलो कहिस, “मेंह तोर संतान ला अब्बड़ बढ़ाहूं, इहां तक कि ओमन के गनती करई मुसकिल हो जाही।”<verse eid="GEN 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 16:11" />यहोवा के स्वरगदूत ह ओला ये घलो कहिस:</para>
  <para style="q1" vid="GEN 16:11">“देख, तें आसरा म हस</para>
  <para style="q2" vid="GEN 16:11">अऊ तें एक बेटा ला जनम देबे।</para>
  <para style="q1" vid="GEN 16:11">तें ओकर नांव इसमायल<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="fq" closed="false">इसमायल </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">परमेसर सुनथे</char></note> रखबे,</para>
  <para style="q2" vid="GEN 16:11">काबरकि यहोवा ह तोर दुख के बात ला सुन ले हवय।<verse eid="GEN 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12" />ओह एक जंगली गदहा के सुभाव के मनखे होही;</para>
  <para style="q2" vid="GEN 16:12">ओकर हांथ जम्मो झन के बिरूध उठही</para>
  <para style="q2" vid="GEN 16:12">अऊ जम्मो झन के हांथ ओकर बिरूध उठही,</para>
  <para style="q1" vid="GEN 16:12">अऊ ओह अपन जम्मो भाई-बंधुमन संग</para>
  <para style="q2" vid="GEN 16:12">बईरता के संग जिनगी जीही।”<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />तब हाजिरा ह यहोवा के ये नांव रखिस, जऊन ह ओकर ले बात करे रिहिस: “तेंह ओ परमेसर अस, जऊन ह मोला देखथस,” काबरकि ओह कहिस, “मेंह अब ओला देख डारे हंव जऊन ह मोला देखथे।” <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />एकरे कारन ओ कुआं के नांव बेर-लहाय-रोई<note caller="+" style="f"><char style="fr" closed="false">16:14 </char><char style="fq" closed="false">बेर-लहाय-रोई </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">मोला देखइया जीयत परमेसर के कुआं</char></note> परिस, येह अभी घलो कादेस अऊ बेरेद के बीच म हवय।<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />हाजिरा ला अब्राम के दुवारा एक बेटा होईस, अऊ अब्राम ओ बेटा के नांव इसमायल रखिस, जेला हाजिरा जनम दीस। <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />जब हाजिरा ह अब्राम के दुवारा इसमायल ला जनम दीस, ओ समय अब्राम छियासी बछर के रिहिस।<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s1">खतना के करार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />जब अब्राम ह निनानबे बछर के होईस, त यहोवा ह ओला दरसन देके कहिस, “में सर्वसक्तिमान<note caller="+" style="f"><char style="fr" closed="false">17:1 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">एल-सद्दाई</char></note> परमेसर अंव; बिसवासयोग्यता के साथ मोर संग चल अऊ निरदोस बने रह। <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />त में तोर अऊ मोर बीच म अपन करार करहूं अऊ तोर बंस ला अब्बड़ बढ़ाहूं।”<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />तब अब्राम ह मुहूं के बल गिरके ओला दंडवत करिस, अऊ परमेसर ह ओला कहिस, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“देख, तोर संग मोर करार ये अय: तेंह बहुंते जाति के मनखेमन के ददा होबे। <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />एकर बर अब ले तोर नांव अब्राम<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="fq" closed="false">अब्राम </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">बहुंत परसंसा के योग्य ददा</char></note> नइं रहय, पर तोर नांव अब्राहम<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="fq" closed="false">अब्राहम </char><char style="ft" closed="false">संभवतः एकर मतलब होथे </char><char style="fqa" closed="false">अब्बड़ झन के ददा</char></note> होही; काबरकि मेंह तोला बहुंते जाति के मनखेमन के ददा ठहिराय हंव। <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />मेंह तोला बहुंत फलवंत करहूं; मेंह तोर ले जाति-जाति के मनखे बनाहूं अऊ तोर बंस म राजामन जनमहीं। <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />में तोर संग अऊ तोर पाछू तोर अवइया पीढ़ी-पीढ़ी के संतान संग सदाकाल के ये करार करहूं कि में तोर अऊ तोर पाछू तोर संतानमन के घलो परमेसर होहूं। <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />मेंह तोर अऊ तोर पाछू तोर संतानमन के अधिकार म, ये जम्मो कनान देस, जिहां तेंह अभी परदेसी होके रहिथस, सदाकाल बर दे दूहूं; अऊ मेंह ओमन के परमेसर होहूं।”<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />फेर परमेसर ह अब्राहम ला कहिस, “ये जरूरी ए कि तहूं घलो मोर करार के पालन कर, तें अऊ तोर पाछू अवइया तोर पीढ़ी-पीढ़ी के संतानमन घलो ये करार के पालन करंय। <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />तोर संग बांधे गय करार, जेला तोला अऊ तोर पाछू तोर संतानमन ला माने बर पड़ही, ओ ये अय: तुम्हर बीच म हर पुरूस के खतना करे जावय। <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />तुमन अपन-अपन खतना करवा लव, अऊ येह मोर अऊ तुम्हर बीच म करे गय करार के चिनहां होही। <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />पीढ़ी-पीढ़ी तक सिरिप तोर बंस के मनखे ही नइं, पर जेमन तोर घर म जनमे हें या जेमन ला कोनो परदेसी करा ले बिसाय गे हवय—जेमन तोर संतान नो हंय, अइसन जम्मो पुरूस के ओमन के जनमे के आठवां दिन म खतना करे जावय। <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />जऊन मन तोर घर म जनमे हवंय या फेर रूपिया देके बिसाय गे हवंय, ओमन के जरूर खतना करे जावय। मोर करार, जेकर चिनहां तोर देहें म होही, येह एक सदाकाल के करार होही। <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />कोनो बिगर खतना के पुरूस, जेकर चमड़ी के खतना नइं करे गे हवय, ओह अपन मनखेमन के बीच म ले अलग करे जाही, काबरकि ओह मोर करार ला टोरे हवय।”<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />फेर परमेसर ह अब्राहम ला कहिस, “तोर जऊन घरवाली सारै हवय, तेला अब तें सारै झन कहिबे; ओकर नांव सारा होही। <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />में ओला आसीस दूहूं, अऊ तोला ओकर दुवारा एक बेटा दूहूं; अऊ मेंह ओला अइसन आसीस दूहूं कि ओह जाति-जाति के मनखेमन के मूल महतारी होही, अऊ ओकर ले मनखेमन के राजामन आहीं।”<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />तब अब्राहम ह मुहूं के बल भुइयां म गिरिस; ओह हंसिस अऊ अपन मन म कहिस, “का सौ बछर के मनखे के घलो संतान पईदा होही? का सारा, जऊन ह नब्बे बछर के अय, एक लइका ला जनमही?” <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />अऊ अब्राहम ह परमेसर ला कहिस, “सिरिप इसमायल ह तोर आसीस म बने रहय, येह मोर बर बहुंत अय।”<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />तब परमेसर ह कहिस, “सही म, तोर घरवाली सारा ले तोर दुवारा एक बेटा होही, अऊ तें ओकर नांव इसहाक<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="fq" closed="false">इसहाक </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">ओह हंसथे</char></note> रखबे। में ओकर संग अइसन करार करहूं, जऊन ह ओकर बाद ओकर बंस बर घलो सदाकाल बर होही। <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />इसमायल के बिसय म घलो, में तोर बिनती ला सुने हंव: में ओला घलो आसीस दूहूं; में ओला फलवंत करहूं अऊ ओकर संतान ला बहुंत बढ़ाहूं। ओकर ले बारह सासन करइया पईदा होहीं अऊ में ओकर ले एक बड़े जाति बनाहूं। <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />पर में अपन करार इसहाक संग करहूं, जऊन ह अगले साल इही समय म, सारा ले तोर दुवारा जनमही।” <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />जब परमेसर ह अब्राहम के संग गोठिया लीस, तब ओह ओकर करा ले चल दीस।<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />तब अब्राहम ओहीच दिन अपन बेटा इसमायल अऊ ओकर घर म जनमे जम्मो पुरूस या ओकर घर म रहइया बिसाय गे जम्मो पुरूस ला लीस अऊ परमेसर के कहे मुताबिक ओमन के खतना करिस। <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />जब अब्राहम के खतना होईस, तब ओह निनानबे बछर के रिहिस, <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />अऊ जब ओकर बेटा इसमायल के खतना होईस, तब ओह तेरह बछर के रिहिस। <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />अब्राहम अऊ ओकर बेटा इसमायल दूनों के खतना एके दिन म होईस। <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />अऊ ओकर घर म जतेक पुरूस रिहिन, जेमन ओकर घर म जनमे रिहिन या जेमन परदेसीमन के हांथ ले बिसाय गे रिहिन, ओ जम्मो पुरूस के खतना ओकर संग होईस।<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s1">भेंट करइया तीन झन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />अब्राहम ह ममरे के बड़े रूखमन के लकठा म, घाम के बेरा अपन तम्बू के दुवारी म बईठे रिहिस, तब यहोवा ह ओकर करा परगट होईस। <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />ओह आंखी उठाके देखिस, त तीन झन पुरूस लकठा म ठाढ़े रहंय। जब ओह ओमन ला देखिस, त ओह ओमन ले भेंट करे बर तम्बू के दुवारी ले दऊड़िस अऊ भुइयां म झुकके ओमन ला दंडवत करिस।<verse eid="GEN 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 18:3" />ओह कहिस, “हे परभू, यदि मोर ऊपर तुम्हर दया-दिरिस्टी हवय, त अपन दास करा ले झन जावव। <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />मेंह थोरकन पानी लेके आवत हंव, अऊ तब तुमन अपन गोड़ ला धोके ये रूख खाल्हे म सुसतावव। <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />मेंह तुम्हर बर कुछू खाय बर लानत हंव ताकि ओला खाके तुमन तरो-ताजा होवव अऊ तब आघू अपन रसता म जावव—काबरकि तुमन अपन दास करा आय हवव।”</para>
  <para style="p" vid="GEN 18:5">त ओमन कहिन, “येह बने बात ए; तेंह जइसने कहय, वइसने कर।”<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />तब अब्राहम ह तुरते तम्बू म सारा करा गीस अऊ कहिस, “जल्दी कर, तीन सेआ<note caller="+" style="f"><char style="fr" closed="false">18:6 </char><char style="ft" closed="false">करीब 16 किलोग्राम</char></note> बढ़िया पीसान ले अऊ ओला गुंथके कुछू रोटी बना।”<verse eid="GEN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7" />तब अब्राहम ह दऊड़के अपन गरूवा-बईला के झुंड म गीस अऊ एक बढ़िया, नरम बछवा ला छांटके अपन दास ला दीस, जऊन ह जाके जल्दी से ओला पकाईस। <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />अब्राहम ह तब कुछू दही अऊ दूध अऊ ओ रांधे गय बछवा के मांस ला ओमन के आघू म परोस दीस। जब ओमन खावत रिहिन, त ओह ओमन के लकठा म रूख खाल्हे म ठाढ़े रिहिस।<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />ओमन ओला पुछिन, “तोर घरवाली सारा कहां हवय?”</para>
  <para style="p" vid="GEN 18:9">ओह कहिस, “ओह तो तम्बू भीतर हवय।”<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />त ओमा के एक झन ह कहिस, “में अगले साल इही समय म तोर करा फेर आहूं, अऊ तोर घरवाली सारा के एक बेटा होही।”</para>
  <para style="p" vid="GEN 18:10">सारा तम्बू के दुवारी म अब्राहम के पाछू कोति रहिके ये बात ला सुनत रिहिस। <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />अब्राहम अऊ सारा दूनों बहुंत डोकरा-डोकरी हो गे रिहिन, अऊ सारा के माहवारी भी बंद हो गे रिहिस। <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />एकरसेति सारा ह मन म हंसके कहे लगिस, “में तो डोकरी हो गे हंव अऊ मोर घरवाला घलो डोकरा हो गे हे, त का मोला ये सुख मिलही?”<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />तब यहोवा ह अब्राहम ला कहिस, “सारा अइसन कहिके काबर हंसिस, ‘में अब अतकी डोकरी हो गे हंव अऊ का सही म मोर एक बेटा होही?’ <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />का यहोवा बर कोनो काम कठिन ए? मेंह अगले साल ठहिराय समय म तोर करा फेर आहूं, अऊ सारा के एक बेटा होही।”<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />तब सारा डर के मारे ये कहिके अपन बात ले मुकर गीस, “में नइं हंसे रहंय।”</para>
  <para style="p" vid="GEN 18:15">पर ओह कहिस, “नइं, तें हंसे तो रहय।”<verse eid="GEN 18:15" /></para>
  <para style="s1">सदोम बर अब्राहम के बिनती</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />जब ओ मनखेमन उहां ले जाय बर उठिन, त ओमन खाल्हे सदोम नगर कोति देखिन, अऊ अब्राहम ह ओमन ला बिदा करे बर ओमन संग गीस। <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />तब यहोवा ह कहिस, “अभी में जो करइया हंव, का ओला मेंह अब्राहम ले छुपाके रखंव? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />अब्राहम ले सही म एक बड़े अऊ सक्तिसाली जाति पईदा होही, अऊ धरती के जम्मो जाति के मनखेमन ओकर जरिये आसीस पाहीं। <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />काबरकि मेंह ओला चुने हंव कि ओह अपन बाद अपन बेटा अऊ परिवार के मनखेमन ला हुकूम दीही कि ओमन सही अऊ नियाय के काम करे के दुवारा यहोवा के रसता म अटल बने रहंय, ताकि यहोवा ह जऊन परतिगियां अब्राहम ले करे हवय, ओला पूरा करय।”<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />फेर यहोवा ह कहिस, “सदोम अऊ अमोरा नगरमन के बिरूध नरियाई ह बहुंत बढ़ गे हवय अऊ ओमन के पाप ह बहुंत दुखदाई हो गे हवय, <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />एकरसेति में उतरके देखहूं कि ओमन के बिरूध जऊन नरियाई मोर कान म हबरे हे, ओकर मुताबिक ओमन के काम वइसने खराप हवय कि नइं। यदि नइं, त में ओला जान डारहूं।”<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />तब ओमा के दू झन उहां ले लहुंटके सदोम कोति जाय लगिन; पर अब्राहम ह यहोवा के आघू म ठाढ़े रिहिस। <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />तब अब्राहम ओकर करा जाके कहिस: “का तें दुस्टमन के संग म धरमीमन ला घलो नास करबे? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />सायद ओ नगर म पचास धरमी मनखे होवंय, त का तें सही म ओ जगह ला नास कर देबे, अऊ ओ पचास धरमी जन के कारन ओला नइं छोंड़बे? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />अइसन काम करई तोर ले दूरिहा रहय—कि दुस्ट के संग धरमी ला घलो मार डार अऊ धरमी अऊ दुस्ट दूनों के एके दसा होवय। अइसन काम तोर ले झन होवय! का जम्मो धरती के नियायी ह सही नियाय नइं करही?”<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />यहोवा ह कहिस, “यदि मोला सदोम सहर म पचास धरमी मिलहीं, त ओमन के कारन ओ जम्मो जगह ला छोंड़ दूहूं।”<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />तब अब्राहम ह फेर कहिस, “हे परभू, देख, में तो माटी अऊ राख सहीं अंव, तभो ले में हिम्मत करके तोर से गोठियावत हंव। <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />यदि ओ पचास धरमी म पांच कम रहंय, त का तें पांच धरमी के कम होय के कारन ओ पूरा सहर ला नास कर देबे?”</para>
  <para style="p" vid="GEN 18:28">ओह कहिस, “यदि उहां मोला पैंतालीस भी मिलहीं, त में ओला नास नइं करंव।”<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />एक बार फेर अब्राहम ह परमेसर ला कहिस, “यदि उहां सिरिप चालीस धरमी मिलंय त?”</para>
  <para style="p" vid="GEN 18:29">ओह कहिस, “में चालीस के कारन भी अइसने नइं करंव।”<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />तब अब्राहम ह कहिस, “हे परभू, नराज झन हो, पर मोला कुछू अऊ कहन दे। यदि उहां सिरिप तीस धरमी मिलंय त?”</para>
  <para style="p" vid="GEN 18:30">ओह ये जबाब दीस, “यदि मोला उहां तीस भी मिलंय, त में अइसने नइं करंव।”<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />फेर अब्राहम ह कहिस, “हे परभू, देख, में हिम्मत करके तोर ले गोठियावत हंव; यदि उहां सिरिप बीस धरमी मिलंय त?”</para>
  <para style="p" vid="GEN 18:31">ओह कहिस, “त फेर में बीस के कारन ओकर नास नइं करंव।”<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />तब अब्राहम ह कहिस, “हे परभू नराज झन हो, पर मोला सिरिप एक बार अऊ कहन दे। यदि उहां दस झन धरमी मिलंय त?”</para>
  <para style="p" vid="GEN 18:32">ओह जबाब दीस, “त फेर दस झन के कारन ओकर नास नइं करंव।”<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />जब यहोवा ह अब्राहम ले गोठिया लीस, तब ओह उहां ले चले गीस, अऊ अब्राहम अपन घर लहुंट गीस।<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s1">सदोम अऊ अमोरा के बिनास</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />सांझकुन दू झन स्वरगदूतमन सदोम करा आईन, अऊ लूत ह सदोम के कपाट करा बईठे रिहिस। जब ओह ओमन ला देखिस, त ओह ओमन ले भेंट करे बर उठिस अऊ मुहूं के भार भुइयां म झुकके दंडवत करिस अऊ कहिस, <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />“हे मोर परभूमन, अपन दास के घर म आवव, अऊ अपन गोड़ धोके रात भर अराम करव अऊ तब बड़े बिहनियां उठके अपन डहार म चले जावव।”</para>
  <para style="p" vid="GEN 19:2">ओमन कहिन, “नइं, हमन चऊक म ही रथिया बिताबो।”<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />पर ओह बहुंत बिनती करके ओमन ला मनाईस, एकरसेति ओमन ओकर संग ओकर घर म आईन। ओह ओमन बर जेवन तियार करिस, अऊ बिगर खमीर के रोटी बनाके ओमन ला खवाईस। <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />ओमन के सुते के पहिली सदोम सहर के जम्मो पुरूसमन आके—जवान ले लेके सियान तक लूत के घर ला घेर लीन; <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />अऊ ओमन लूत ला चिचियाके कहिन, “जऊन मनखेमन आज रथिया तोर करा आय हें, ओमन कहां हवंय? ओमन ला हमर करा बाहिर ले आ कि हमन ओमन संग भोग करन।”<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />तब लूत ह ओमन ले मिले बर घर ले बाहिर निकलिस अऊ कपाट ला बंद करके <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />ओमन ला कहिस, “हे मोर भाईमन, अइसने गंदा काम झन करव। <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />देखव, मोर दू झन बेटीमन हें, जेमन कभू कोनो पुरूस के संग नइं सुते हें। मेंह ओमन ला बाहिर तुम्हर करा ले आवत हंव, अऊ तुमन ला जइसने बने लगय, वइसने ओमन के संग करव। पर ये मनखेमन संग कुछू झन करव; काबरकि येमन मोर छानी के तरी म आय हवंय।”<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />ओमन कहिन, “हमर रसता ले हट जा। ये मनखे ह एक परदेसी के रूप म इहां आय रिहिस, पर अब नियायी बनत हे! हमन तोर संग ओमन ले घलो जादा खराप बरताव करबो।” अऊ ओमन लूत ऊपर दबाव डारे लगिन अऊ कपाट ला टोरे बर आघू बढ़िन।<verse eid="GEN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 19:10" />पर ओ पहुनामन हांथ लमाके लूत ला अपन करा घर के भीतर खींच लीन अऊ कपाट ला बंद कर दीन। <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />तब ओमन का छोटे का बड़े, जम्मो मनखे ला, जेमन घर के दुवारी म रिहिन, अंधरा कर दीन, एकरसेति ओमन कपाट ला खोजे नइं सकिन।<verse eid="GEN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />तब ओ दूनों पहुनामन लूत ले पुछिन, “इहां तोर अऊ कोनो हवंय—दामाद, बेटा-बेटीमन, या अऊ कोनो ये सहर म तोर हवंय? त ओ जम्मो झन ला लेके इहां ले निकल जा, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />काबरकि हमन ये जगह ला नास करइया हन। यहोवा करा ये जगह के मनखेमन के बिरूध नरियाई अतेक जादा हो गय हे कि ओह हमन ला एकर सतियानास करे बर पठोय हे।”<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />एकरसेति, लूत ह निकलके अपन दामादमन ला, जेमन संग ओकर बेटीमन के मंगनी हो गे रहय, कहिस, “जल्दी करव अऊ ये जगह ले निकलव; काबरकि यहोवा ह ये सहर ला नास करइया हे!” पर ओकर दामादमन सोचिन कि ओह ठट्ठा करत हे।<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />जब बिहान पहात रिहिस, त स्वरगदूतमन लूत ला कहिन, “जल्दी कर! अपन घरवाली अऊ अपन दूनों बेटी ला, जेमन इहां हवंय, अपन संग ले जा, नइं तो तुमन घलो ये सहर के दंड म नास हो जाहू।”<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />पर ओह झिझकत रिहिस, एकरसेति ओ पहुनामन ओकर अऊ ओकर घरवाली अऊ ओकर दूनों बेटीमन के हांथ ला धरिन अऊ सही-सलामत ओमन ला सहर के बाहिर ले गीन, काबरकि यहोवा के दया ओमन के ऊपर रिहिस। <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />जब ओमन ला बाहिर निकाल लीन, त ओमन ले एक झन ह कहिस, “अपन परान लेके भागव! पाछू पलटके झन देखहू, अऊ मैदान म कहूं मेर झन रूकहू! ओ पहाड़ ऊपर भाग जावव, नइं तो तुमन घलो नास हो जाहू!”<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />पर लूत ह ओमन ला कहिस, “हे मोर परभू, अइसन झन करव। <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />देख, तोर दास ऊपर तोर दया-दिरिस्टी होय हवय, अऊ तेंह मोर जिनगी ला बचाके मोर ऊपर अब्बड़ दया करे हस। पर में ओ पहाड़ ऊपर नइं जा सकंव; ये बिपत्ति ह मोर ऊपर आ जाही, अऊ में मर जाहूं। <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />देख, ओ नगर ह बहुंत लकठा म हवय अऊ मेंह उहां भाग सकत हंव, अऊ ओह छोटे घलो हवय। मोला उहां भाग जावन दे—का ओह बहुंत छोटे नगर नो हय? तब मोर परान ह बच जाही।”<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />ओह लूत ला कहिस, “ठीक हे, मेंह तोर ये बिनती ला घलो मानत हंव; जऊन नगर के बारे म तेंह कहत हस, ओला में नास नइं करंव। <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />पर जल्दी करके उहां भाग जा, काबरकि जब तक तेंह उहां नइं हबरबे, तब तक में कुछू नइं कर सकंव।” (एकरे बर ओ नगर ला सोअर<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="fq" closed="false">सोअर </char><char style="ft" closed="false">येकर मतलब होथे </char><char style="fqa" closed="false">छोटे</char></note> कहे गीस।)<verse eid="GEN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />जब लूत ह सोअर नगर म हबरिस, त बेर ह धरती ऊपर उग गे रिहिस। <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />तब यहोवा ह अपन कोति ले सदोम अऊ अमोरा म अकास ले बरत गंधक बरसाईस। <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />ये किसम ले, ओह ओ सहरमन ला अऊ ओ जम्मो मैदान ला अऊ सहर म रहइया जम्मो मनखेमन ला—अऊ भुइयां के घांस-पूस अऊ रूख-रई जम्मो ला नास कर दीस। <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />पर लूत के घरवाली ह पाछू कोति मुड़के देखिस, अऊ ओह नून के खंभा बन गीस।<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />दूसर दिन बड़े बिहनियां अब्राहम उठके ओ ठऊर म गीस, जिहां ओह यहोवा के आघू म ठाढ़े रिहिस। <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />ओह खाल्हे सदोम अऊ अमोरा अऊ ओ मैदान के जम्मो भुइयां कोति देखिस, त ओह का देखिस कि ओ जम्मो जगह ले धधकत भट्ठी ले निकलत धुआं सहीं घना धुआं उठत रहय।<verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />अऊ जब परमेसर ह ओ मैदान के सहरमन ला नास करिस, त ओह अब्राहम ला सुरता करिस, अऊ ओह उहां रहइया लूत ला ओ संकट ले बचा लीस, जऊन ह ओ सहरमन ला उलट-पलट दीस।<verse eid="GEN 19:29" /></para>
  <para style="s1">लूत अऊ ओकर बेटीमन</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />लूत अऊ ओकर दूनों बेटीमन सोअर ला छोंड़ दीन अऊ पहाड़ ऊपर रहे लगिन, काबरकि लूत ह सोअर म रहे बर डरत रिहिस। ओह अऊ ओकर दूनों बेटी गुफा म रहत रिहिन। <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />एक दिन बड़की बेटी ह छोटकी ला कहिस, “हमर ददा त डोकरा हो गे हे, अऊ इहां आसपास म अइसन कोनो पुरूस नइं ए, जऊन ह संसार के रीति के मुताबिक हमन ला लइका दे सकय। <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />एकरसेति आ, हमन अपन ददा ला मंद पीयाके ओकर संग सुतन अऊ अपन ददा के दुवारा अपन परिवार के बंस ला बंचावन।”<verse eid="GEN 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33" />त ओमन ओहीच दिन रथिया अपन ददा ला मंद पीयाईन, अऊ तब बड़की बेटी जाके अपन ददा संग सुतिस, पर ओकर ददा ह नइं जानिस कि ओह कब ओकर संग लेटिस अऊ कब ओह उठ गीस।<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />ओकर दूसर दिन बड़की ह छोटकी बहिनी ला कहिस, “देख, कल रथिया मेंह अपन ददा संग सुतें। आ, आज रथिया हमन ओला फेर मंद पीयाबो, अऊ तब तें जाके ओकर संग सुतबे ताकि हमन अपन ददा के दुवारा अपन परिवार के बंस ला बचा सकन।” <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />एकरसेति ओमन ओ दिन घलो रथिया अपन ददा ला मंद पीयाईन अऊ छोटकी बेटी जाके अपन ददा संग सुतिस, अऊ फेर ओकर ददा ह नइं पता पाईस कि ओह कब ओकर संग लेटिस अऊ कब ओह उठ गीस।<verse eid="GEN 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36" />ये किसम ले लूत के दूनों बेटी अपन ददा कोति ले आसरा म हो गीन। <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />बड़की बेटी के एक बेटा होईस, अऊ ओह ओकर नांव मोआब<note caller="+" style="f"><char style="fr" closed="false">19:37 </char><char style="fq" closed="false">मोआब </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">ददा ले</char></note> रखिस; ओह आज तक के मोआबीमन के जनमदाता होईस। <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />अऊ छोटकी के घलो एक बेटा होईस, अऊ ओह ओकर नांव बेन-अम्मी<note caller="+" style="f"><char style="fr" closed="false">19:38 </char><char style="fq" closed="false">बेन-अम्मी </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">मोर ददा के मनखेमन के बेटा</char></note> रखिस; ओह आज तक के अमोनीमन के जनमदाता होईस।<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s1">अब्राहम अऊ अबीमेलेक</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />फेर अब्राहम उहां ले निकलके नेगेव<note caller="+" style="f"><char style="fr" closed="false">20:1 </char><char style="ft" closed="false">कनान के दक्खिन के भाग</char></note> के छेत्र म आईस अऊ कादेस अऊ सूर के बीच म रहे लगिस। कुछू समय तक ओह गरार नगर म ठहिरिस, <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />अऊ उहां अब्राहम ह अपन घरवाली सारा के बारे म कहिस, “ओह मोर बहिनी अय।” एकरसेति गरार के राजा अबीमेलेक ह दूत पठोके सारा ला अपन करा बला लीस।<verse eid="GEN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 20:3" />पर रथिया परमेसर ह सपना म अबीमेलेक करा आके कहिस, “सुन, तेंह मर जाबे, काबरकि जऊन माईलोगन ला तेंह रख ले हस; ओह एक बिहाता माईलोगन अय।”<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />पर अबीमेलेक ओकर करा नइं गे रिहिस, एकर बर ओह कहिस, “हे परभू, का तें एक निरदोस जाति ला मार डारबे? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />का ओह खुद मोला नइं कहिस कि ओह मोर बहिनी अय? अऊ ओ नारी ह घलो खुद नइं कहिस कि ओह मोर भाई अय? में तो अपन सुध बिबेक अऊ निरदोस हांथ ले ये काम ला करे हंव।”<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />तब परमेसर ह ओला सपना म कहिस, “हव, में भी जानत हंव कि सुध बिबेक से तेंह ये काम ला करे हस, अऊ एकरसेति मेंह तोला मोर बिरूध म पाप करे बर रोकके रखे हंव। एकरे कारन मेंह तोला ओला छुए नइं देंव। <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />अब ओ मनखे के घरवाली ला लहुंटा दे, काबरकि ओह एक अगमजानी अय, अऊ ओह तोर बर पराथना करही अऊ तें जीयत रहिबे। पर यदि तें ओला नइं लहुंटाबे, त जान ले कि तें अऊ तोर जतेक मनखे हें, ओ सब के सब मर जाहीं।”<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />दूसर दिन बड़े बिहनियां अबीमेलेक अपन जम्मो करमचारीमन ला बलाईस, अऊ जब ओह ओमन ला ओ जम्मो बात बताईस, त ओमन बहुंत डरा गीन। <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />तब अबीमेलेक ह अब्राहम ला बलाके कहिस, तेंह हमर संग ये का करे हस? मेंह तोर का बिगाड़ेंव कि तें मोर अऊ मोर राज ऊपर अइसने बड़े दोस डाल दे हस। तेंह मोर संग ओ काम करे हस, जऊन ह उचित नो हय। <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />फेर अबीमेलेक ह अब्राहम ले पुछिस, “तेंह का समझके अइसन काम करय?”<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />अब्राहम ह कहिस, “मेंह ये सोचेंव कि ये ठऊर म परमेसर के डर-भय नइं होही, अऊ मनखेमन मोर घरवाली के कारन मोला मार डारहीं। <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />एकर छोंड़, सही म ओह मोर बहिनी अय, मोर ददा के बेटी, हालाकि ओह मोर दाई के बेटी नो हय; अऊ फेर ओह मोर घरवाली बन गीस <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />अऊ जब परमेसर ह मोला मोर ददा के घर ला छोंड़के निकले के हुकूम दीस, त में ओला कहेंव, ‘तें ये किसम ले अपन मया मोर बर देखा सकथस: जिहां-जिहां हमन जाबो, उहां-उहां तें मोर बारे म कहिबे, “ये मोर भाई अय।” ’ ”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />तब अबीमेलेक ह भेड़-बकरी, गरूवा-बईला ला, अऊ दास-दासीमन ला लेके अब्राहम ला दीस अऊ ओकर घरवाली सारा ला घलो ओला लहुंटा दीस। <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />अऊ अबीमेलेक ह कहिस, “देख, मोर देस तोर आघू म हवय; जिहां तोला बने लगय, उहां रह।”<verse eid="GEN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16" />सारा ला ओह कहिस, “देख, में तोर भाई ला एक हजार सेकेल<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">करीब 12 किलोग्राम</char></note> चांदी देवत हंव। तोर बिरूध जऊन अपराध मेंह करे हंव, तोर संग के मनखेमन के आघू म, येह ओकर भरपई ए; तोर संग पूरा नियाय करे जावथे।”<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />तब अब्राहम ह परमेसर ले पराथना करिस, अऊ परमेसर ह अबीमेलेक, ओकर घरवाली अऊ ओकर दासीमन ला चंगा करिस कि ओमन फेर लइका जनमे लगंय, <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />काबरकि यहोवा ह अब्राहम के घरवाली सारा के कारन अबीमेलेक के घर के जम्मो माईलोगनमन के कोख ला बंद कर दे रिहिस।<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s1">इसहाक के जनम</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />यहोवा ह सारा के ऊपर अनुग्रह करिस जइसने कि ओह कहे रिहिस, अऊ ओह सारा बर वइसने करिस जइसने कि ओह परतिगियां करे रिहिस। <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />सारा ह अब्राहम ले गरभ म होईस अऊ ओकर बुढ़ापा म, ओही ठहिराय समय म परमेसर के परतिगियां के मुताबिक ओह एक बेटा जनमिस। <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />अब्राहम अपन ओ बेटा के नांव इसहाक<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="fq" closed="false">इसहाक </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">ओह हंसथे</char></note> रखिस, जेला सारा ह जनम दीस। <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />जब ओकर बेटा इसहाक ह आठ दिन के होईस, त अब्राहम ह परमेसर के हुकूम के मुताबिक ओकर खतना करिस। <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />अब्राहम ह एक सौ बछर के रिहिस, जब ओकर बेटा इसहाक के जनम होईस।<verse eid="GEN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6" />सारा ह कहिस, “परमेसर ह मोला खुसी दे हवय, अऊ जऊन कोनो भी एकर बारे म सुनही, ओह खुस होके हंसही।” <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />फेर ओह ये घलो कहिस, “का कोनो कभू अब्राहम ले ये कहे सकत रिहिन कि सारा ह लइकामन ला दूध पीयाही? पर देखव, मेंह ओकर बुढ़त काल म ओकर एक बेटा ला जनम दे हवंव।”<verse eid="GEN 21:7" /></para>
  <para style="s1">हाजिरा अऊ इसमायल के निकलई</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />ओ लइका ह बढ़त गीस अऊ ओकर दूध छोंड़ाय गीस, अऊ इसहाक के दूध छोंड़ाय के दिन अब्राहम ह एक बड़े भोज करिस। <verse eid="GEN 21:8" /><verse number="9" style="v" sid="GEN 21:9" />पर बाद म सारा ह देखिस कि मिसरी हाजिरा के बेटा, जऊन ह अब्राहम दुवारा जनमे रिहिस, ओकर हंसी उड़ात रिहिस, <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />त ओह अब्राहम ला कहिस, “ये गुलाम माईलोगन अऊ ओकर बेटा ला निकाल दे, काबरकि ये माईलोगन के बेटा ह मोर बेटा इसहाक के संग कभू हिस्सा नइं पावय।”<verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />ये बात अब्राहम ला बहुंत खराप लगिस, काबरकि ये बात ओकर बेटा के बारे म रिहिस। <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />पर परमेसर ह अब्राहम ला कहिस, “ओ लइका अऊ अपन दासी के बारे म दुखी झन हो। जऊन बात सारा ह तोला कहत हे, ओला मान, काबरकि इसहाक के जरिये तोर बंस ह चलही। <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />मेंह दासी के बेटा ले घलो एक जाति बनाहूं, काबरकि ओह तोर संतान अय।”<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />ओकर दूसर दिन बड़े बिहनियां अब्राहम ह उठके कुछू जेवन अऊ पानी ले भरे चमड़ा के थैली लीस अऊ हाजिरा ला दीस। ओह जेवन अऊ पानी के थैली ला हाजिरा के कंधा म रखिस अऊ ओला अऊ ओकर बेटा ला बिदा करिस। ओह अपन रसता म चल दीस अऊ बेरसेबा के सुन्ना जगह म भटकत रिहिस।<verse eid="GEN 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 21:15" />जब चाम के थैली के पानी सिरा गीस, तब ओह अपन बेटा ला एक झाड़ी तरी म छोंड़ दीस। <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />अऊ तब अपन खुद तीर चलाय भर के दूरिहा म गीस अऊ ये सोचके बईठ गीस, “में अपन बेटा के मरना नइं देख सकंव।” अऊ ओह उहां बईठके रोवन लगिस।<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />परमेसर ह ओ छोकरा के रोये के अवाज ला सुनिस, अऊ परमेसर के स्वरगदूत ह स्वरग ले नरियाके हाजिरा ला कहिस, “हे हाजिरा, का बात ए? झन डर; जऊन करा तोर बेटा हवय, उहां ले ओकर रोये के अवाज ह परमेसर करा हबरे हवय। <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />उठ अऊ अपन बेटा ला अपन हांथ म उठा, काबरकि में ओकर दुवारा एक बड़े जाति बनाहूं।”<verse eid="GEN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 21:19" />तब परमेसर ह ओकर आंखी ला उघार दीस अऊ ओला एक ठन पानी के कुआं दिखिस, तब ओह जाके थैली म पानी भरिस अऊ लइका ला पीयाईस।<verse eid="GEN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20" />परमेसर ह ओ लइका संग रिहिस, जब ओह बढ़े लगिस। ओह सुन्ना जगह म रहत एक धनुस चलइया बन गीस। <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />जब ओह पारान के सुन्ना जगह म रहत रिहिस, त ओकर दाई ह ओकर बर मिसर देस ले एक घरवाली लानिस।<verse eid="GEN 21:21" /></para>
  <para style="s1">अब्राहम अऊ अबीमेलेक म समझौता</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />ओ समय म, अबीमेलेक अऊ ओकर सेनापति पीकोल अब्राहम ला कहिन, “जऊन कुछू तें करथस, ओमा परमेसर तोर संग रहिथे। <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />एकरसेति, अब मोर संग इहां परमेसर के आघू म किरिया खा कि तें न तो मोर संग, न मोर लइकामन संग अऊ न ही मोर अवइया संतान संग कोनो छल करबे। पर जइसन दया मेंह तोला देखाय हवंव, वइसन ही दया तें मोर अऊ ये देस ऊपर देखाबे, जिहां तेंह अभी एक परदेसी के रूप म रहत हस।”<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />अब्राहम ह कहिस, “में किरिया खावत हंव।”<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />तब अब्राहम ह अबीमेलेक ले एक कुआं के बारे म सिकायत करिस, जेला अबीमेलेक के दासमन जबरन लेय ले रिहिन। <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />पर अबीमेलेक ह कहिस, “में नइं जानंव कि कोन ह ये काम ला करिस। तें मोला नइं बताय, अऊ आज मोला ये बात के पता चलत हे।”<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />तब अब्राहम ह भेड़-बकरी अऊ गरूवा-बईला लानिस अऊ अबीमेलेक ला दीस, अऊ ओ दूनों झन आपस म करार करिन। <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />अब्राहम ह सात ठन मेढ़ा-पीला ला झुंड ले अलग रखिस, <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />त अबीमेलेक ह अब्राहम ले पुछिस, “ये सात ठन मेढ़ा-पीला, जेमन ला तें अलग रखे हस, तेकर का मतलब अय?”<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />ओह कहिस, “ये सात ठन मेढ़ा-पीला ला ये बात के साखी जानके मोर हांथ ले लेय ले कि मेंह ये कुआं ला खने हंव।”<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />ओ दूनों झन ओ ठऊर म आपस म किरिया खाईन, एकर कारन ओ जगह के नांव बेरसेबा<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="fqa" closed="false">सात के कुआं </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">किरिया के कुआं</char></note> परिस।<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />बेरसेबा म करार करे के बाद, अबीमेलेक अऊ ओकर सेना के सेनापति पीकोल पलिस्तीन देस ला लहुंट गीन। <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />अब्राहम ह बेरसेबा म एक झाऊ के रूख लगाईस अऊ उहां यहोवा ले, जेह सनातन परमेसर<note caller="+" style="f"><char style="fr" closed="false">21:33 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">एल-ओलाम</char></note> अय, अराधना करिस। <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />अब्राहम ह पलिस्तीन देस म बहुंत साल तक एक परदेसी के रूप म रिहिस।<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s1">अब्राहम के परिछा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />कुछू समय बाद, परमेसर ह अब्राहम के परिछा लीस। ओह अब्राहम ला कहिस, “हे अब्राहम!”</para>
  <para style="p" vid="GEN 22:1">अब्राहम ह कहिस, “में इहां हंव।”<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />तब परमेसर ह कहिस, “अपन बेटा याने अपन एकलऊता बेटा इसहाक ला, जेला तें मया करथस, अपन संग लेके मोरियाह छेत्र म जा। उहां ओला एक पहाड़ ऊपर होम-बलिदान करके चघा, जेला में तोला देखाहूं।”<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />अब्राहम बड़े बिहनियां उठिस अऊ अपन गदहा ऊपर सामान लादिस। ओह अपन संग म दू झन सेवक अऊ अपन बेटा इसहाक ला लीस। जब ओह होम-बलिदान बर लकरी फोर लीस, त ओह ओ जगह बर रवाना होईस, जेकर बारे म परमेसर ह ओला बताय रिहिस। <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />तीसर दिन अब्राहम ह आंखी उठाके ओ जगह ला दूरिहा ले देखिस, <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />अऊ ओह अपन सेवकमन ला कहिस, “गदहा के संग इहां ठाढ़े रहव; ये लड़का अऊ में उहां जावत हन। हमन अराधना करके तुम्हर करा लहुंट आबो।”<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />तब अब्राहम ह होम-बलिदान बर लकरी ला लीस अऊ अपन बेटा इसहाक के कंधा म रखिस, अऊ अपन खुद आगी अऊ छुरी ला धरिस। जब ओ दूनों एक संग जावत रिहिन, <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />त इसहाक ह अपन ददा अब्राहम ला कहिस, “हे ददा?”</para>
  <para style="p" vid="GEN 22:7">अब्राहम ह कहिस, “का बात ए, बेटा?”</para>
  <para style="p" vid="GEN 22:7">त इसहाक ह कहिस, “देख, आगी अऊ लकरी तो हमर करा हवय, पर होम-बलिदान बर मेढ़ा-पीला कहां हे?”<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />अब्राहम ह कहिस, “होम-बलिदान बर मेढ़ा-पीला के उपाय परमेसर ह खुद करही, बेटा।” अऊ ओ दूनों संगे-संग आघू बढ़त गीन।<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />जब ओमन ओ जगह म हबरिन, जेकर बारे म परमेसर ह ओला बताय रिहिस, तब अब्राहम ह उहां एक बेदी बनाके ओकर ऊपर लकरी ला छांट-छांटके रखिस, अऊ अपन बेटा इसहाक ला बांधके बेदी के लकरी ऊपर लेटा दीस। <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />तब ओह अपन बेटा ला बलि करे बर अपन हांथ म छुरी ला धरिस। <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />पर यहोवा के स्वरगदूत ह स्वरग ले ओला नरियाके कहिस, “हे अब्राहम! हे अब्राहम!”</para>
  <para style="p" vid="GEN 22:11">ओह कहिस, “में इहां हंव।”<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />परमेसर के दूत ह कहिस, “ओ लड़का ऊपर हांथ झन बढ़ा; ओला कुछू झन कर। अब में जानत हंव कि तें परमेसर के भय मानथस, काबरकि तें मोर बर अपन बेटा याने अपन एकलऊता बेटा ला घलो नइं छोंड़े।”<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />तब अब्राहम ह आंखी उठाके देखिस, त ओकर पाछू म एक मेढ़ा रहय, जेकर सींग झाड़ी म फंसे रहय। अब्राहम ह जाके ओ मेढ़ा ला लानिस अऊ अपन बेटा के बदला म, ओला होम-बलिदान के रूप म चघाईस। <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />एकरसेति अब्राहम ओ जगह के नांव, “यहोवा ह दीही” रखिस। अऊ आज घलो ये कहे जाथे, “यहोवा के पहाड़ ऊपर परबंध होही।”<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />यहोवा के स्वरगदूत ह दूसर बेर स्वरग ले अब्राहम ला नरियाके कहिस, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />“यहोवा के ये बचन अय कि में अपनेच ही किरिया खावत हंव कि तें जो ये काम करे कि अपन बेटा याने अपन एकलऊता बेटा ला घलो नइं छोंड़य, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />एकर कारन मेंह तोला जरूर आसीस दूहूं अऊ तोर संतानमन ला अकास के तारामन अऊ समुंदर तीर के बालू सहीं अनगिनत करहूं। तोर संतानमन अपन बईरीमन के सहरमन ला अपन अधिकार म ले लीहीं, <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />अऊ तोर संतान के जरिये धरती के जम्मो जाति के मनखेमन आसीस पाहीं, काबरकि तें मोर बात ला माने हस।”<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />तब अब्राहम अपन सेवकमन करा लहुंट आईस अऊ ओमन एक संग बेरसेबा गीन। अऊ अब्राहम ह बेरसेबा म रहत रिहिस।<verse eid="GEN 22:19" /></para>
  <para style="s1">नाहोर के बेटामन</para>
  <para style="li1">
    <verse number="20" style="v" sid="GEN 22:20" />कुछू समय के बाद, अब्राहम ला ये संदेस मिलिस, “मिलका ह घलो दाई बने हे; ओह तोर भाई नाहोर कोति ले लइकामन ला जनमे हे।<verse eid="GEN 22:20" /></para>
  <para style="li2">
    <verse number="21" style="v" sid="GEN 22:21" />ओकर बड़खा बेटा ऊस अऊ ओकर भाई बूज,</para>
  <para style="li2" vid="GEN 22:21">कमूएल (जऊन ह अराम के ददा होईस),<verse eid="GEN 22:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="GEN 22:22" />केसेद, हजो, पिलदास, यिदलाप अऊ बतूएल।”<verse eid="GEN 22:22" /></para>
  <para style="li3">
    <verse number="23" style="v" sid="GEN 22:23" />ये आठों बेटामन ला मिलका ह अब्राहम के भाई नाहोर कोति ले जनम दीस।</para>
  <para style="lf" vid="GEN 22:23">अऊ बतूएल ह रिबका के ददा होईस।<verse eid="GEN 22:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="GEN 22:24" />नाहोर के रूमा नांव के एक रखैल रिहिस;</para>
  <para style="li2" vid="GEN 22:24">जेकर ले तेबह, गहम, तहस अऊ माका पईदा होईन।<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s1">सारा के मऊत</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />सारा ह एक सौ सत्ताईस बछर के रिहिस, <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />तब ओह कनान देस के किरयत-अरबा (जेला हेबरोन कहे जाथे) म मर गीस। एकरसेति अब्राहम ह सारा बर सोक मनाय अऊ रोये बर गीस।<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />तब अब्राहम ह अपन घरवाली के लास के बाजू म ठाढ़ होके हित्तीमन ला कहिस, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“मेंह तुम्हर बीच म एक परदेसी अऊ अजनबी अंव। मोला इहां मरघटी बर कुछू जमीन बिक्री म देवव ताकि में अपन मनखेमन के लास ला माटी दे सकंव।”<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />तब हित्तीमन अब्राहम ला कहिन, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“हे महोदय, हमर बात ला सुन। तेंह हमर बीच म एक बड़े आदमी अस। हमर कबर म ले, जेह तोला बने लगय, ओमा अपन घरवाली के लास ला माटी दे। तोला अपन मनखे के लास ला माटी देय बर हमन म ले कोनो भी अपन कबर देय बर तोला मना नइं करय।”<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />तब अब्राहम उठके ठाढ़ होईस अऊ ओ देस के मनखे हित्तीमन के आघू म मुड़ नवाके कहिस, <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />“यदि तुम्हर मन हवय कि इहां में अपन घरवाली ला माटी देवंव, त मोर बात ला सुनव अऊ मोर कोति ले सोहर के बेटा एपरोन ले बिनती करव <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />कि ओह अपन मकपेला के गुफा, जेह ओकर नांव म हे अऊ येह ओकर भुइयां के छोर म हवय, ओकर पूरा दाम लेके मोला बेच देवय कि ओह तुम्हर बीच म मोर अऊ मोर मनखेमन बर मरघटी होवय।”<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />एपरोन हित्ती ह अपन मनखेमन के बीच म बईठे रिहिस अऊ ओ जम्मो हित्ती, जऊन मन ओकर नगर के कपाट करा आय रिहिन, ओमन के सुनत म ओह अब्राहम ला कहिस, <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />“हे मोर परभू, अइसन नइं, मोर बात ला सुन; ओ भुइयां ला में तोला देवत हंव, अऊ ओमा जऊन गुफा हवय, ओला घलो तोला देवत हंव। मेंह येला अपन मनखेमन के आघू म तोला देवत हंव। तें अपन मनखे के लास ला उहां माटी दे।”<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />तब अब्राहम ह ओ देस के मनखेमन के आघू म फेर मुड़ नवाईस <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />अऊ ओमन के सुनत म एपरोन ला कहिस, “यदि तोर अइसन मन हे, त मोर बात ला सुन। ओ भुइयां के जऊन दाम हे, तेला मेंह दूहूं। ओला तें मोर करा ले लेय ले, ताकि में अपन मनखे के लास ला उहां माटी दे सकंव।”<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />एपरोन ह अब्राहम ला जबाब दीस, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“हे मोर परभू, मोर बात ला सुन; ओ भुइयां के दाम तो चार सौ सेकेल<note caller="+" style="f"><char style="fr" closed="false">23:15 </char><char style="ft" closed="false">लगभग 4.6 किलोग्राम चांदी</char></note> हवय, पर तोर अऊ मोर बीच म येह कुछू नो हय। अपन मनखे के लास ला उहां माटी दे।”<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />अब्राहम ह एपरोन के बात ला मानके ओला ओतकी चांदी तऊलके दे दीस, जतकी ओह हित्तीमन के सुनत म कहे रिहिस, याने कि चार सौ सेकेल, जऊन ह ओ समय बेपारीमन म चलत रिहिस।<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />ये किसम ले एपरोन के भुइयां, जऊन ह ममरे के लकठा म मकपेला म रिहिस—ओ भुइयां अऊ गुफा, अऊ ओ जम्मो रूख जऊन मन ओ भुइयां के सीमना म आवत रिहिन, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />ओ जम्मो संपत्ति, ओ सबो हित्ती, जऊन मन सहर के कपाट करा आय रिहिन, ओमन के आघू म अब्राहम के हक म पक्का हो गीस। <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />ओकर बाद अब्राहम ह अपन घरवाली सारा के लास ला मकपेला के भुइयां के गुफा म माटी दीस, जऊन ह ममरे के, याने कि हेबरोन के लकठा म कनान देस म हवय। <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />ये किसम ले ओ भुइयां ह गुफा समेत हित्तीमन कोति ले मरघटी बर अब्राहम के अधिकार म पक्का हो गीस।<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s1">इसहाक अऊ रिबका</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />अब्राहम अब बहुंत डोकरा हो गे रिहिस, अऊ यहोवा ह ओला सब बात म आसीस दे रिहिस। <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />अब्राहम ह अपन पुराना सेवक ला, जऊन ह ओकर जम्मो धन-दौलत ऊपर मुखिया रिहिस, कहिस, “अपन हांथ ला मोर जांघ के तरी म रख,<note caller="+" style="f"><char style="fr" closed="false">24:2 </char><char style="ft" closed="false">कसम खाय के बेरा एक प्रतिकात्मक चिनहां</char></note> <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />अऊ मोर ले यहोवा, जऊन ह अकास अऊ धरती के परमेसर ए, ओकर ये बात के किरिया खा कि तें कनानीमन के बेटीमन ले, जेमन के बीच म मेंह रहिथंव, कोनो ला मोर बेटा के घरवाली बनाके नइं लानबे, <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />पर तें मोर देस अऊ मोरेच रिस्तेदारमन करा जाके, मोर बेटा इसहाक बर एक घरवाली लानबे।”<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />तब दास ह ओकर ले पुछिस, “मान ले ओ नोनी के मन ह मोर संग ये देस म आय के नइं होही, त का मोला तोर बेटा ला ओ देस म ले जाय बर पड़ही, जिहां ले तें आय हस?”<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />अब्राहम ह ओला कहिस, “ये बात के धियान रहय कि मोर बेटा ला उहां कभू झन ले जाबे। <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />यहोवा, जऊन ह स्वरग के परमेसर ए, ओह मोला मोर ददा के घर ले अऊ मोर जनम भुइयां ले बाहिर लानिस अऊ मोर ले गोठियाईस अऊ कसम खाके मोर ले ये परतिगियां करिस, ‘में ये देस तोर संतान ला दूहूं,’ त ओहीच ह अपन स्वरगदूत ला तोर आघू-आघू पठोही कि तें मोर बेटा बर उहां ले एक घरवाली ले आन। <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />पर यदि ओ नोनी-पीला ह तोर संग नइं आय चाहही, तब तो तें मोर ये किरिया से छूट जाबे; पर मोर बेटा ला उहां झन ले जाबे।” <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />तब ओ दास ह अपन मालिक अब्राहम के जांघ के तरी म अपन हांथ रखके ये बिसय म ओकर ले किरिया खाईस।<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />तब ओ दास ह अपन मालिक के दस ठन ऊंट ला लीस अऊ ओमा अपन मालिक के जम्मो किसम के बने चीजमन ला जोरके अरम-नहरैम<note caller="+" style="f"><char style="fr" closed="false">24:10 </char><char style="ft" closed="false">याने कि, उत्तर-पछिम मेसोपोटामिया</char></note> जाय बर निकलिस अऊ ओह नाहोर के नगर करा हबरिस। <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />ओह ऊंटमन ला नगर के बाहिर कुआं के लकठा म बईठाईस। ओ सांझ के बेरा रहय, अऊ ओ समय म माईलोगनमन पानी भरे बर आवंय।<verse eid="GEN 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12" />तब ओह ये पराथना करन लगिस, “हे यहोवा, मोर मालिक अब्राहम के परमेसर, आज तें मोर काम ला सफल कर अऊ मोर मालिक अब्राहम ऊपर दया कर। <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />देख, में पानी के ये सोता के बाजू म ठाढ़े हंव, अऊ नगर के मनखेमन के बेटीमन पानी भरे बर निकलके आवत हें। <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />एकरसेति अइसन होवन दे कि जऊन जवान नोनी ला में ये कहंव, ‘अपन घघरी ला मोर कोति नवा कि में पानी पी सकंव,’ अऊ ओह कहय, ‘ले पी ले, अऊ में तोर ऊंटमन ला घलो पानी पीयाहूं’—त ओही ह ओ जवान छोकरी होवय, जेला तेंह अपन दास इसहाक बर ठहिराय हस। एकर दुवारा, मेंह जान डारहूं कि तेंह मोर मालिक ऊपर दया करे हस।”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />एकर पहिली कि ओकर पराथना खतम होतिस, रिबका ह अपन कंधा म घघरी बोहके आईस, जऊन ह अब्राहम के भाई नाहोर के घरवाली मिलका के बेटा बतूएल के बेटी रिहिस। <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />ओह बहुंत सुन्दर अऊ कुंवारी रिहिस, अऊ कोनो पुरूस के संग नइं सुते रिहिस। ओह पानी के सोता करा उतरिस अऊ अपन घघरी ला भरके फेर ऊपर आईस।<verse eid="GEN 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 24:17" />तब ओ दास ह जल्दी करके ओकर ले भेंट करे बर गीस अऊ कहिस, “किरपा करके अपन घघरी म ले मोला थोरकन पानी पीया दे।”<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />ओह कहिस, “हे मोर परभू, ले, पी ले,” अऊ ओह जल्दी से घघरी ला उतारके हांथ म धरे-धरे ओला पीया दीस।<verse eid="GEN 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 24:19" />जब ओह ओला पानी पीया डारिस, तब कहिस, “में तोर ऊंटमन बर घलो तब तक पानी भर-भरके लानहूं, जब तक ओमन पी नइं डारहीं।” <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />तब ओह तुरते अपन घघरी के पानी ला कोटना म ढारके फेर कुआं म पानी भरे बर दऊड़िस अऊ ओकर जम्मो ऊंटमन बर पानी भर दीस। <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />ओ मनखे ह ओकर कोति चुपेचाप धियान से देखत, ये जाने के कोसिस करत रिहिस कि यहोवा ह ओकर काम ला सफल करिस हे कि नइं।<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />जब ऊंटमन पानी पी डारिन, तब ओ मनखे ह एक बेका<note caller="+" style="f"><char style="fr" closed="false">24:22 </char><char style="ft" closed="false">लगभग 6 ग्राम</char></note> सोन के नकफुली निकालके ओला दीस, अऊ दस सेकेल<note caller="+" style="f"><char style="fr" closed="false">24:22 </char><char style="ft" closed="false">करीब 115 ग्राम</char></note> सोन के दू ठन कंगन ओकर हांथ म पहिरा दीस; <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />अऊ पुछिस, “तें काकर बेटी अस? मोला बता, का तोर ददा के घर म हमर बर रथिया ठहिरे बर जगह हवय?”<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />ओह जबाब दीस, “में तो नाहोर के घरवाली मिलका के जनमाय बेटा बतूएल के बेटी अंव।” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />फेर ओह ओला कहिस, “हमर घर म पैंरा अऊ चारा बहुंत हवय, अऊ रात बिताय बर जगह घलो हवय।”<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />तब ओ मनखे ह मुड़ नवाके यहोवा के अराधना करिस <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />अऊ कहिस, “यहोवा, मोर मालिक अब्राहम के परमेसर के महिमा होवय, जऊन ह अपन दया अऊ सच्चई ला मोर मालिक ऊपर ले नइं हटाईस। यहोवा ह मोला सही रसता म लेके मोला मोर मालिक के भाई-बंधुमन के घर म पहुंचा दीस।”<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />तब ओ जवान नोनी ह दऊड़के गीस अऊ अपन दाई के घर के मनखेमन ला ये बात बताईस। <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />रिबका के भाई लाबान ह तुरते दऊड़के ओ मनखे करा कुआं म गीस। <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />जब ओकर नजर अपन बहिनी के नकफुली अऊ हांथ म पहिरे कंगन म परिस, अऊ ओकर ये बात ला सुनिस कि ओ मनखे ह रिबका ला का कहे रिहिस, त ओह तुरते ओ मनखे करा गीस, जऊन ह कुआं के तीर म ऊंटमन करा ठाढ़े रहय। <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />लाबान ह कहिस, “हे यहोवा कोति ले आसीसित मनखे, मोर संग आ। तें काबर इहां बाहिर म ठाढ़े हस? मेंह तोर बर घर ला तियार करे हंव, अऊ ऊंटमन बर घलो जगह तियार करे हंव।”<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />त ओ मनखे ह घर म गीस, अऊ ऊंटमन के काठी खोलके ओमन ला चारा-पानी दिये गीस, अऊ ओकर अऊ ओकर संगीमन के गोड़ धोय बर पानी लाने गीस। <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />तब ओला खाना परोसे गीस, पर ओह कहिस, “में जब तक अपन आय के कारन नइं बता दंव, तब तक कुछू नइं खावंव।”</para>
  <para style="p" vid="GEN 24:33">लाबान ह कहिस, “त फेर बता।”<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />तब ओह कहिस, “में तो अब्राहम के दास अंव। <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />यहोवा ह मोर मालिक ला अब्बड़ आसीस दे हवय, अऊ ओह धनी मनखे हो गय हे। परमेसर ह ओला भेड़-बकरी, गाय-बईला, सोन-चांदी, दास-दासी, ऊंट अऊ गदहामन दे हवय। <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />मोर मालिक के घरवाली सारा ह अपन बुढ़त काल म ओकर बर एक बेटा जनमाय हे, अऊ ओ बेटा ला अब्राहम ह अपन सबो कुछू दे देय हवय। <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />अऊ मोर मालिक ह मोला किरिया खवाके ये कहिस, ‘तें कनानीमन के बेटीमन ले, जेमन के देस म मेंह रहिथंव, कोनो ला मोर बेटा के घरवाली बनाके झन लानबे, <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />पर मोर ददा के परिवार अऊ मोर अपन गोत्र म जा अऊ मोर बेटा बर एक घरवाली लान।’<verse eid="GEN 24:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 24:39" />“तब में अपन मालिक ले पुछेंव, ‘मान ले ओ नोनी ह मोर संग नइं आही त?’<verse eid="GEN 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 24:40" />“मोर मालिक ह मोला कहिस, ‘यहोवा जेकर पाछू में ईमानदारी से चलत आय हंव, ओह तोर संग अपन स्वरगदूत ला भेजके तोर यातरा ला सफल करही, अऊ तें मोर गोत्र अऊ मोर ददा के परिवार ले मोर बेटा बर एक घरवाली लाय सकबे। <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />तेंह मोर किरिया ले तभे छूटबे, जब तें मोर गोत्र के मनखेमन करा जाबे, अऊ ओमन यदि तोला अपन नोनी ला देय म इनकार करहीं, त तें मोर ये किरिया ले छूट जाबे।’<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />“जब में आज ओ पानी के सोता करा आयेंव त पराथना करेंव, ‘हे यहोवा, मोर मालिक अब्राहम के परमेसर, यदि तें मोर यातरा ला सफल करथस, <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />त देख, में पानी के ये सोता के बाजू म ठाढ़े हंव। यदि कोनो जवान छोकरी पानी भरे बर आवय, अऊ में ओला कहंव, “मोला अपन घघरी म ले थोरकन पानी पीया,” <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />अऊ यदि ओह मोला कहय, “ले, पी ले, अऊ में तोर ऊंटमन ला घलो पानी पीयाहूं,” त ओहीच ह ओ नोनी होवय, जेला यहोवा ह मोर मालिक के बेटा बर ठहिराय हवय।’<verse eid="GEN 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 24:45" />“एकर पहिली कि मेंह अपन मन म करत पराथना ला खतम करतेंव, रिबका ह अपन कंधा म घघरी बोहके आईस, अऊ ओह खाल्हे सोता करा जाके पानी भरे लगिस, त में ओला कहेंव, ‘मोला पानी पीया दे ओ।’<verse eid="GEN 24:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 24:46" />“अऊ ओह तुरते अपन घघरी ला कंधा ले उतारके कहिस, ‘ले, पी ले, अऊ में तोर ऊंटमन ला घलो पीयाहूं।’ त मेंह पानी पीयेंव, अऊ ओह ऊंटमन ला घलो पानी पीयाईस।<verse eid="GEN 24:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 24:47" />“तब मेंह ओला पुछेंव, ‘तेंह काकर बेटी अस?’</para>
  <para style="p" vid="GEN 24:47">“ओह कहिस, ‘में तो नाहोर के घरवाली मिलका के जनमाय बेटा बतूएल के बेटी अंव।’</para>
  <para style="p" vid="GEN 24:47">“तब मेंह ओकर नाक म नकफुली अऊ ओकर हांथ म कंगन पहिरा देंव। <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />फेर में मुड़ नवाके यहोवा के दंडवत करेंव। मेंह यहोवा, मोर मालिक अब्राहम के परमेसर के महिमा करेंव, काबरकि ओह मोला सही रसता म लानिस कि में अपन मालिक के बेटा बर ओकर भाई के नतनीन ला लान सकंव। <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />एकरसेति अब, यदि तुमन मोर मालिक बर दया अऊ ईमानदारी देखाय चाहत हव, त मोला बतावव; अऊ यदि नइं चाहत हव, त ओला घलो बतावव, ताकि में जान सकंव कि मोला कोन कोति जाना हे।”<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />तब लाबान अऊ बतूएल जबाब दीन, “येह यहोवा कोति ले होईसे; एकरसेति हमन तोला न हां कहे सकन, न ना कहे सकन। <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />देख, रिबका इहां हवय; ओला ले जा अऊ ओह यहोवा के बचन के मुताबिक तोर मालिक के बेटा के घरवाली हो जावय।”<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />ओमन के ये बात ला सुनके, अब्राहम के दास ह भुइयां म मुड़ नवाके यहोवा ला दंडवत करिस। <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />तब ओ दास ह सोन अऊ चांदी के जेवर अऊ कपड़ा निकालके रिबका ला दीस; अऊ ओकर भाई अऊ दाई ला घलो ओह मंहगा-मंहगा चीज भेंट म दीस। <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />तब ओ अऊ ओकर संग के मनखेमन खाईन-पीईन अऊ उहां रथिया अराम करिन।</para>
  <para style="p" vid="GEN 24:54">जब ओमन दूसर दिन बिहनियां सोके उठिन, त ओह कहिस, “मोला मोर मालिक करा जाय बर बिदा करव।”<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />पर रिबका के भाई अऊ दाई कहिन, “नोनी ला हमर करा कुछू दिन, याने कि कम से कम दस दिन अऊ रहन दे; तब तें ओला ले जाबे।”<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />पर ओह ओमन ला कहिस, “यहोवा ह मोर यातरा ला सफल करिस हे, एकरसेति मोला झन रोकव। अब मोला बिदा करव कि में अपन मालिक करा जावंव।”<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />तब ओमन कहिन, “हमन नोनी ला बलाके एकर बारे म पुछथन।” <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />तब ओमन रिबका ला बलाके पुछिन, “का तें ये मनखे संग जाबे?”</para>
  <para style="p" vid="GEN 24:58">ओह कहिस, “हव, में जाहूं।”<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />तब ओमन अपन बहिनी रिबका अऊ ओकर धाई अऊ अब्राहम के दास अऊ ओकर संग के मनखेमन ला बिदा करिन। <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />अऊ ओमन रिबका ला आसीरबाद देके कहिन,</para>
  <para style="q1" vid="GEN 24:60">“हे हमर बहिनी, तोर संतानमन</para>
  <para style="q2" vid="GEN 24:60">हजारों लाखों के संखिया म होवंय;</para>
  <para style="q1" vid="GEN 24:60">तोर संतान के मनखेमन अपन बईरीमन के</para>
  <para style="q2" vid="GEN 24:60">सहरमन ला अपन अधिकार म करंय।”<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />तब रिबका अऊ ओकर सेविकामन तियार होके ऊंट के ऊपर चघिन अऊ ओ मनखे के संग चल दीन। ये किसम ले ओ दास ह रिबका ला लेके चल दीस।<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />इसहाक ह बेर-लहाय-रोई ले लहुंटके आय रिहिस, अऊ नेगेव देस म रहत रिहिस। <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />एक दिन सांझ के बेरा ओह मैदान म मनन-चिंतन करे बर निकले रिहिस, अऊ जब ओह आंखी उठाके देखिस, त का देखिस कि ऊंटमन आवत रहंय। <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />रिबका ह घलो आंखी उठाके इसहाक ला देखिस, अऊ ओह अपन ऊंट ऊपर ले उतरिस, <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />अऊ दास ले पुछिस, “जऊन मनखे मैदान ले हमर करा भेंट करे बर आवथे, ओह कोन अय?”</para>
  <para style="p" vid="GEN 24:65">ओ दास ह जबाब दीस, “ओह तो मोर मालिक अय।” तब रिबका ह अपन घूंघट लेके अपनआप ला ढांप लीस।<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />दास ह इसहाक ला अपन यातरा के पूरा कहानी बताईस। <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />तब इसहाक ह रिबका ला अपन दाई सारा के तम्बू म ले आईस, अऊ ओकर संग बिहाव करिस। ये किसम ले रिबका ह ओकर घरवाली बनिस, अऊ इसहाक ह ओला मया करिस; अऊ इसहाक ला अपन दाई के मऊत के पाछू सांति मिलिस।<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s1">अब्राहम के मिरतू</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />अब्राहम ह एक झन अऊ माईलोगन ला अपन घरवाली बनाय रिहिस, जेकर नांव कतूरा रिहिस। <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />ओकर ले जिमरान, योकसान, मदान, मिदयान, यिसबाक अऊ सूह जनमिन। <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />योकसान ले सेबा अऊ ददान पईदा होईन; अऊ ददान के संतान अस्सूरी, लतूसी अऊ लुम्मीमन रिहिन। <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />मिदयान के एपा, एपेर, हनोक, अबीदा अऊ एलदा नांव के बेटामन होईन। ये जम्मो कतूरा के संतान रिहिन।<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />इसहाक ला अब्राहम ह अपन जम्मो कुछू ला दे दीस। <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />पर अपन रखैलीमन के बेटामन ला कुछू भेंट देके अपन जीते जी अपन बेटा इसहाक करा ले ओमन ला दूरिहा पूरब देस म पठो दीस।<verse eid="GEN 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />अब्राहम के कुल उमर एक सौ पचहत्तर बछर के होईस। <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />तब अब्राहम के पूरा बुढ़ापा म परान छूट गीस; ओह पूरा उमर के एक डोकरा रिहिस; अऊ ओह मरे के बाद अपन पुरखामन संग जा मिलिस। <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />ओकर बेटा इसहाक अऊ इसमायल ओला हित्ती सोहर के बेटा एपरोन के भुइयां म, ममरे के लकठा म जऊन मकपेला के गुफा रिहिस, ओमा माटी दीन, <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />याने कि जऊन भुइयां ला अब्राहम ह हित्तीमन<note caller="+" style="f"><char style="fr" closed="false">25:10 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">हेथ के संतानमन</char></note> करा ले बिसाय रिहिस; ओही म अब्राहम ला ओकर घरवाली सारा के संग माटी दीन। <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />अब्राहम के मरे के बाद, परमेसर ह ओकर बेटा इसहाक ला आसीस दीस, जऊन ह ओ बेरा बेर-लहाय-रोई के लकठा म रहत रिहिस।<verse eid="GEN 25:11" /></para>
  <para style="s1">इसमायल के संतान</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />अब्राहम के बेटा इसमायल, जऊन ह सारा के दासी, हाजिरा मिसरी ले जनमे रिहिस, ओकर ये बंसावली अय।<verse eid="GEN 25:12" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="13" style="v" sid="GEN 25:13" />इसमायल के बेटामन के नांव ओमन के जनम के मुताबिक ये अय:</para>
  <para style="b" vid="GEN 25:13" />
  <para style="li1" vid="GEN 25:13">इसमायल के बड़े बेटा नबायोत,</para>
  <para style="li1" vid="GEN 25:13">तब केदार, अदबेल, मिबसाम,<verse eid="GEN 25:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 25:14" />मिस्मा, दूमा, मस्सा,<verse eid="GEN 25:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 25:15" />हदद, तेमा, यतूर,</para>
  <para style="li1" vid="GEN 25:15">नापीस अऊ केदमा।<verse eid="GEN 25:15" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="16" style="v" sid="GEN 25:16" />इसमायल के बेटा येमन रिहिन, अऊ ओमन के बसावट अऊ छावनीमन के मुताबिक ये बारह जाति के परधानमन के नांव अय।<verse eid="GEN 25:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="GEN 25:17" />इसमायल के कुल उमर एक सौ सैंतीस बछर होईस। तब ओह मर गीस अऊ अपन मनखेमन संग मिल गीस। <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />ओकर संतानमन हवीला ले लेके सूर के छेत्र म बस गीन, जेह मिसर देस के पूरबी सीमना के लकठा म, अस्सूर के रसता म हवय। ओमन अपन जम्मो गोत्र के भाई-बंधुमन के बईरी के सहीं रहत रिहिन।<verse eid="GEN 25:18" /></para>
  <para style="s1">याकूब अऊ एसाव</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />अब्राहम के बेटा इसहाक के परिवार के बिबरन ये अय।</para>
  <para style="b" vid="GEN 25:19" />
  <para style="p" vid="GEN 25:19">अब्राहम ले इसहाक जनम लीस, <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />अऊ इसहाक चालीस बछर के रिहिस, जब ओह रिबका ले बिहाव करिस, जऊन ह पदन-अराम के निवासी, अरामी बतूएल के बेटी अऊ अरामी लाबान के बहिनी रिहिस।<verse eid="GEN 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 25:21" />इसहाक के घरवाली बांझ रिहिस, एकरसेति ओह अपन घरवाली बर यहोवा ले पराथना करिस अऊ यहोवा ह ओकर पराथना ला सुनिस, अऊ ओकर घरवाली रिबका ला गरभ ठहिरिस। <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />लइकामन ओकर गरभ म एक-दूसर ला धक्का देय लगिन, त ओह कहिस, “मोर संग अइसन काबर होवथे?” एकरसेति ओह यहोवा ले पुछे बर गीस।<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />तब यहोवा ह ओला कहिस,</para>
  <para style="q1" vid="GEN 25:23">“तोर गरभ म दू ठन जाति हवंय,</para>
  <para style="q2" vid="GEN 25:23">अऊ तोर म ले दू किसम के मनखेमन निकलके अलग-अलग होहीं;</para>
  <para style="q1" vid="GEN 25:23">एक दल के मनखेमन दूसर मनखेमन ले जादा बलवान होहीं,</para>
  <para style="q2" vid="GEN 25:23">अऊ बड़खा बेटा ह छोटे के सेवा करही।”<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />जब रिबका के छेवारी होय के समय आईस, त पता चलिस कि ओकर गरभ म जुड़वां लइका हवंय। <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />जऊन ह पहिली जनमिस, ओह लाल रिहिस, अऊ ओकर जम्मो देहें ह बाल से भरे रिहिस; एकरसेति ओकर नांव एसाव<note caller="+" style="f"><char style="fr" closed="false">25:25 </char><char style="fq" closed="false">एसाव </char><char style="ft" closed="false">येकर मतलब हो सकथे </char><char style="fqa" closed="false">बाल या रूआंवाला</char></note> रखे गीस। <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />एकर बाद, ओकर भाई अपन हांथ ले एसाव के एड़ी धरके पईदा होईस; एकरसेति ओकर नांव याकूब<note caller="+" style="f"><char style="fr" closed="false">25:26 </char><char style="fq" closed="false">याकूब </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">ओह एड़ी पकड़थे, </char><char style="ft" closed="false">एक इबरानी मुहावरा जेकर मतलब होथे </char><char style="fqa" closed="false">ओह धोखा देथे</char></note> रखे गीस। जब रिबका ह ये लइकामन ला जनमिस, तब इसहाक साठ साल के रिहिस।<verse eid="GEN 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />ओ लड़कामन बढ़त गीन, अऊ एसाव ह खुला भुइयां म रहइया, एक चतुर सिकारी हो गीस, पर याकूब ह तम्बू के बीच घर म रहिके संतुस्ट रहय। <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />इसहाक ह सिकार के मांस ला खाना पसंद करय, एकरसेति ओह एसाव ले मया करय, पर रिबका ह याकूब ला मया करय।<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />एक दिन जब याकूब ह कुछू रांधत रिहिस, त एसाव ह खुला मैदान कोति ले आईस अऊ ओला बहुंत भूख लगत रहय। <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />त ओह याकूब ला कहिस, “जऊन लाल चीज ला तेंह रांधत हस, जल्दी करके ओमा के कुछू मोला दे, काबरकि मोला बहुंत भूख लगत हे!” (एकरसेति ओला एदोम<note caller="+" style="f"><char style="fr" closed="false">25:30 </char><char style="fq" closed="false">एदोम </char><char style="ft" closed="false">के मतलब होथे </char><char style="fq" closed="false">लाल</char></note> घलो कहे जावय।)<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />याकूब ह कहिस, “पहिले तें अपन पहिलऊठा के अधिकार मोर करा बेच दे।”<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />एसाव ह कहिस, “देख, में तो मरइया हंव, त पहिलऊठा के अधिकार ले मोला का फायदा?”<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />पर याकूब ह कहिस, “पहिले तें मोर करा किरिया खा।” त ओह किरिया खाके याकूब करा अपन पहिलऊठा के अधिकार ला बेच दीस।<verse eid="GEN 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34" />तब याकूब ह एसाव ला कुछू रोटी अऊ रंधाय दाल दीस। ओह खाईस-पीईस अऊ उठके चल दीस।</para>
  <para style="p" vid="GEN 25:34">ये किसम ले, एसाव ह अपन पहिलऊठा के अधिकार ला तुछ जानिस।<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s1">इसहाक अऊ अबीमेलेक</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />कुछू समय के बाद, ओ देस म अकाल परिस, एकरे बर इसहाक ह पलिस्तीमन के राजा अबीमेलेक करा गरार म गीस। ये ओ अकाल ले अलग रिहिस, जऊन ह अब्राहम के समय म परे रिहिस। <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />गरार म यहोवा ह इसहाक ला दरसन देके कहिस, “मिसर देस म झन जा; मेंह तोला जऊन देस म रहे बर कहथंव, ओही देस म रह। <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />तें ये देस म कुछू समय तक रह, अऊ में तोर संग रहिहूं अऊ तोला आसीस दूहूं। ये पूरा देस में तोला अऊ तोर संतानमन ला दूहूं; ये किसम ले जऊन किरिया में तोर ददा अब्राहम करा खाय रहेंव, ओला पूरा करहूं। <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />में तोर संतानमन ला अकास के तारामन सहीं अनगिनत करहूं अऊ ओमन ला ये जम्मो देस ला दूहूं, अऊ तोर संतान के जरिये धरती के जम्मो जाति के मनखेमन आसीस पाहीं,<note caller="+" style="f"><char style="fr" closed="false">26:4 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">अऊ </char><char style="fqa" closed="false">धरती के जम्मो जाति के मनखेमन आसीस पाय बर तोर संतान के नांव के उपयोग करहीं</char></note> <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />काबरकि अब्राहम ह मोर बात मानिस, अऊ जऊन हुकूम, नियम अऊ निरदेस, में ओला दे रहेंव, ओ जम्मो के पालन करिस।” <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />एकरे बर इसहाक ह गरार म रह गीस।<verse eid="GEN 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7" />जब ओ ठऊर के मनखेमन ओकर घरवाली के बारे म ओकर ले पुछिन, त ओह कहिस, “ओह मोर बहिनी अय।” काबरकि ओह ये सोचके डरत रिहिस कि यदि में ओला अपन घरवाली कहिहूं, त इहां के मनखेमन रिबका के कारन मोला मार डारहीं, काबरकि ओह सुन्दर हवय।<verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />जब ओला उहां रहत बहुंत दिन बीत गीस, तब एक दिन पलिस्तीमन के राजा अबीमेलेक ह खिड़की ले झांकके देखिस कि इसहाक ह अपन घरवाली रिबका के संग प्रेमालाप करत हे। <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />तब अबीमेलेक ह इसहाक ला बलाके कहिस, “ओह सही म तोर घरवाली अय! फेर तें काबर ओला अपन बहिनी कहय?”</para>
  <para style="p" vid="GEN 26:9">इसहाक ह जबाब दीस, “मेंह सोचेंव कि ओकर कारन मोला अपन परान गंवाना पड़ सकत हे।”<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />तब अबीमेलेक ह कहिस, “तेंह हमर संग ये का करे हस? अइसन म तो कोनो भी मनखे तोर घरवाली संग आसानी से कुकरम कर सकत रिहिस, अऊ तें हमन ला पाप म फंसाते।”<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />एकर कारन अबीमेलेक ह जम्मो मनखेमन ला हुकूम दीस, “जऊन ह भी ओ मनखे अऊ ओकर घरवाली संग गलत बेवहार करही, ओह खचित मार डारे जाही।”<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />फेर इसहाक ह ओ देस म खेती करिस, अऊ ओही बछर म सौ गुना फर पाईस, काबरकि यहोवा ह ओला आसीस दीस। <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />अऊ ओह धनी हो गीस, अऊ ओकर धन लगातार बढ़त गीस अऊ ओह बहुंत धनी हो गीस। <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />जब ओकर बहुंत भेड़-बकरी, गरूवा-बईला, अऊ नौकर-चाकर हो गीन; तब पलिस्तीमन ओकर ले जलन करे लगिन। <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />एकर कारन जतेक कुआंमन ला ओकर ददा के सेवकमन ओकर ददा अब्राहम के जीते जी खने रिहिन, ओला पलिस्तीमन माटी पाटके बंद कर दीन।<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />तब अबीमेलेक ह इसहाक ला कहिस, “हमर पास ले चले जा, काबरकि तें हमन ले बहुंत बलवान हो गे हस।”<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />एकरे बर इसहाक उहां ले चल दीस अऊ गरार के घाटी म अपन तम्बू ठाढ़ करके उहां रहे लगिस। <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />तब जऊन कुआंमन ला ओकर ददा के समय खने गे रिहिस, अऊ अब्राहम के मरे के पाछू पलिस्तीमन पाट दे रिहिन, ओमन ला इसहाक ह फेर खनवाईस, अऊ ओमन के ओहीच नांव रखिस, जे नांव ओकर ददा ह रखे रिहिस।<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />फेर इसहाक के दासमन घाटी म खोदई करिन अऊ उहां ओमन ला ताजा पानी के एक ठन कुआं मिलिस। <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />पर गरार के चरवाहामन इसहाक के चरवाहामन संग झगरा करिन अऊ ओमन कहिन, “ये पानी हमर अय।” एकरे बर ओह ओ कुआं के नांव एसेक<note caller="+" style="f"><char style="fr" closed="false">26:20 </char><char style="fq" closed="false">एसेक </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">झगरा</char></note> रखिस; काबरकि ओमन ओकर संग झगरा करे रिहिन। <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />तब ओमन आने कुआं खनिन, पर ओमन ओकर बर घलो झगरा करिन; एकरे बर ओह ओकर नांव सितनाह<note caller="+" style="f"><char style="fr" closed="false">26:21 </char><char style="fq" closed="false">सितनाह </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">बिरोध</char></note> रखिस। <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />तब ओह उहां ले निकलके एक अऊ कुआं खनवाईस, अऊ ओकर बर उहां कोनो झगरा नइं करिन। ओह ओकर नांव ये कहिके रहोबोत<note caller="+" style="f"><char style="fr" closed="false">26:22 </char><char style="fq" closed="false">रहोबोत </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">ठऊर</char></note> रखिस, “अब यहोवा ह हमन ला बहुंत जगह दे हवय अऊ हमन ये देस म फूलबो-फरबो।”<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />उहां ले इसहाक ह बेरसेबा चल दीस। <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />ओ रथिया यहोवा ह ओला दरसन देके कहिस, “मेंह तोर ददा अब्राहम के परमेसर अंव। झन डर, काबरकि मेंह तोर संग हवंव; में अपन दास अब्राहम ले करे परतिगियां के कारन तोला आसीस दूहूं अऊ तोर संतानमन के गनती ला बढ़ाहूं।”<verse eid="GEN 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25" />तब इसहाक ह उहां एक ठन बेदी बनाईस अऊ यहोवा के अराधना करिस। उहां ओह अपन तम्बू ठाढ़ करिस, अऊ उहां ओकर दासमन एक ठन कुआं खनिन।<verse eid="GEN 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />ये बीच म, अबीमेलेक ह अपन सलाहकार अहुज्जत अऊ अपन सेना के सेनापति पीकोल के संग गरार ले इसहाक करा आईस, <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />त इसहाक ह ओमन ले पुछिस, “तुमन मोर ले बईरता करके मोला अपन बीच ले निकाल दे रहेव, अब मोर करा काबर आय हवव?”<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />ओमन जबाब दीन, “हमन सच म देख डारेंन कि यहोवा ह तोर संग रहिथे; एकरे बर हमन सोचेंन कि हमर बीच म किरिया खाके करार होना चाही—हमर अऊ तोर बीच म। आ, हमर संग करार कर <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />कि तेंह हमर कोनो हानि नइं करबे, जइसन कि हमन तोर कोनो हानि नइं करेंन, पर तोर संग हमेसा बने बरताव करेंन अऊ तोला सांति से बिदा करेंन। अऊ अब तें यहोवा के दुवारा आसीसित अस।”<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />तब इसहाक ह ओमन बर एक भोज करिस अऊ ओमन खाईन-पीईन। <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />दूसर दिन बड़े बिहनियां ओ मनखेमन एक-दूसर ले किरिया खाईन। तब इसहाक ह ओमन ला बिदा करिस, अऊ ओमन सांति से उहां ले चल दीन।<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />ओही दिन इसहाक के दासमन आके ओ खने गय कुआं के बारे बताईन। ओमन कहिन, “हमन ला पानी मिल गे हवय।” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />तब ओह ओकर नांव सिबा<note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="fq" closed="false">सिबा </char><char style="ft" closed="false">के मतलब हो सकथे </char><char style="fqa" closed="false">किरिया </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सात</char></note> रखिस, अऊ आज तक ओ नगर के नांव बेरसेबा<note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="fq" closed="false">बेरसेबा </char><char style="ft" closed="false">के मतलब हो सकथे </char><char style="fqa" closed="false">किरिया के कुआं </char><char style="ft" closed="false">अऊ </char><char style="fqa" closed="false">सात के कुआं</char></note> परे हे।<verse eid="GEN 26:33" /></para>
  <para style="s1">याकूब ह एसाव के आसीस ला ले लेथे</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />जब एसाव ह चालीस बछर के होईस, त ओह हित्ती बेरी के बेटी यूदीत, अऊ हित्ती एलोन के बेटी बासमत ले बिहाव कर लीस। <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />ओमन इसहाक अऊ रिबका के दुख के कारन रिहिन।<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />जब इसहाक ह डोकरा हो गीस अऊ ओकर आंखी ह अतेक कमजोर हो गीस कि ओला दिखना ही बंद हो गीस, तब ओह अपन बड़खा बेटा एसाव ला बलाके कहिस, “हे बेटा।”</para>
  <para style="p" vid="GEN 27:1">ओह कहिस, “में इहां हंव।”<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />इसहाक ह कहिस, “सुन, में तो डोकरा हो गे हंव अऊ नइं जानंव कि कब मर जाहूं। <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />एकरसेति, अब तें अपन साज-सामान—तीर-धनुस लेके खुले मैदान म जा, अऊ मोर बर कोनो जंगली पसु सिकार करके लान, <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />अऊ मोर मन के लईक सुवादवाला जेवन बनाके मोर करा लान कि में ओला खाके मरे के पहिली तोला आसीस देवंव।”<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />जब इसहाक ह अपन बेटा एसाव ले गोठियावत रिहिस, त ओ बात ला रिबका ह सुनत रिहिस। जब एसाव ह सिकार करे बर खुला मैदान म चल दीस, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />त रिबका ह अपन बेटा याकूब ला कहिस, “देख, मेंह तोर ददा ला तोर भईया एसाव ले ये कहत सुने हंव, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />‘तें मोर बर सिकार करके लान अऊ सुवादवाला जेवन बना कि में मरे के पहिली ओला खाके तोला यहोवा के आघू म आसीस देवंव।’ <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />एकरसेति, हे मोर बेटा, धियान से सुन अऊ मोर बात ला मान: <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />पसुमन के झुंड म जाके दू ठन बने-बने बोकरा-पीला ले आन कि में तोर ददा बर ओकर मन के लईक सुवादवाला जेवन बनावंव। <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />तब तें ओला अपन ददा करा ले जाबे कि ओह ओला खाके मरे के पहिली तोला आसीस देवय।”<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />याकूब ह अपन दाई रिबका ला कहिस, “देख, मोर भईया एसाव तो रूआंवाला मनखे अय, पर में तो बिन रूआं के अंव। <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />कहूं मोर ददा मोला छूही, तब का होही? में तो ओकर नजर म धोखा देवइया हो जाहूं अऊ आसीस के बदला म मोला सराप मिलही।”<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />ओकर दाई ह ओला कहिस, “हे मोर बेटा, सराप तोला नइं, मोला मिलय। में जऊन बात कहत हंव, ओला कर; जा अऊ बोकरामन ला मोर करा ले आन।”<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />तब याकूब ह जाके बोकरामन ला अपन दाई करा ले आईस, अऊ ओकर दाई ह ओकर ददा के मन के लईक सुवादवाला जेवन बना दीस। <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />तब रिबका ह अपन बड़खा बेटा एसाव के सबले सुन्दर कपड़ा ला लीस, जऊन ह कि ओकर करा घर म रिहिस अऊ ओला लेके अपन छोटे बेटा याकूब ला पहिरा दीस। <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />अऊ ओह बोकरा के खाल ला लेके याकूब के हांथमन म अऊ ओकर चिकना घेंच म लपेट दीस। <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />तब ओह सुवादवाला जेवन अऊ अपन बनाय रोटी ला अपन बेटा याकूब के हांथ म धरा दीस।<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />याकूब ह अपन ददा करा गीस अऊ कहिस, “हे मोर ददा।”</para>
  <para style="p" vid="GEN 27:18">ओकर ददा ह कहिस, “हव, मोर बेटा, तेंह कोन अस?”<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />याकूब ह अपन ददा ला कहिस, “मेंह तोर बड़खा बेटा एसाव अंव। जइसे तेंह मोला कहे रहय, वइसे मेंह करे हंव। बईठ जा अऊ मोर दुवारा सिकार करके लाने गे मांस ला खा अऊ मोला आसीस दे।”<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />इसहाक ह अपन बेटा ले पुछिस, “येह तोला अतकी जल्दी कइसे मिल गीस, बेटा?”</para>
  <para style="p" vid="GEN 27:20">ओह जबाब दीस, “यहोवा तोर परमेसर ह मोला सफल करिस।”<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />तब इसहाक ह याकूब ला कहिस, “मोर लकठा म आ कि में तोला छुवंव, मोर बेटा, अऊ जानंव कि तें सही म मोर बेटा एसाव अस कि नइं।”<verse eid="GEN 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22" />याकूब ह अपन ददा इसहाक के लकठा म गीस; तब इसहाक ह ओला छुईस अऊ कहिस, “अवाज तो याकूब के अवाज अय, पर हांथमन एसाव के हांथ अंय।” <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />इसहाक ह याकूब ला नइं चिन्हिस, काबरकि ओकर हांथमन ओकर भईया एसाव के सहीं रूआंदार रिहिन; एकर बर इसहाक ह ओला आसीस देय के सुरू करिस। <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />अऊ ओह पुछिस, “का सही म, तें मोर बेटा एसाव अस?”</para>
  <para style="p" vid="GEN 27:24">ओह कहिस, “हव, में अंव।”<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />तब इसहाक ह कहिस, “हे मोर बेटा, सिकार के मांस ला मोर करा ले आ कि में ओला खावंव अऊ तोला अपन आसीस देवंव।”</para>
  <para style="p" vid="GEN 27:25">ओह मांस ला इसहाक करा ले आईस अऊ ओह खाईस; अऊ याकूब ह ओकर करा अंगूर के मंद घलो लानिस अऊ ओह खाईस-पीईस। <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />तब ओकर ददा इसहाक ह ओला कहिस, “हे मोर बेटा, इहां आ अऊ मोला चूम।”<verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />याकूब ह ओकर करा गीस अऊ ओला चूमिस। जब इसहाक ह ओकर कपड़ा के गंध पाईस, त ओला आसीस दीस अऊ कहिस,</para>
  <para style="q1" vid="GEN 27:27">“अहा, मोर बेटा के सुगंध ह</para>
  <para style="q2" vid="GEN 27:27">अइसन खेत के सुगंध सहीं अय</para>
  <para style="q2" vid="GEN 27:27">जऊन ला यहोवा ह आसीस दे हवय।<verse eid="GEN 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28" />परमेसर तोला अकास ले ओस</para>
  <para style="q2" vid="GEN 27:28">अऊ धरती के उत्तम चीज—</para>
  <para style="q2" vid="GEN 27:28">बहुंत अकन अनाज अऊ अंगूर के नवां मंद देवय।<verse eid="GEN 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29" />जाति-जाति के मनखेमन तोर सेवा करंय</para>
  <para style="q2" vid="GEN 27:29">अऊ मनखेमन तोला झुकके दंडवत करंय।</para>
  <para style="q1" vid="GEN 27:29">तें अपन भाईमन के सुवामी हो जा,</para>
  <para style="q2" vid="GEN 27:29">अऊ तोर दाई के बेटामन तोला दंडवत करंय।</para>
  <para style="q1" vid="GEN 27:29">जऊन मन तोला सराप देवंय, ओमन खुद सराप पावंय</para>
  <para style="q2" vid="GEN 27:29">अऊ जऊन मन तोला आसीस देवंय, ओमन आसीस पावंय।”<verse eid="GEN 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />जब इसहाक ह याकूब ला आसीस दे चुकिस, अऊ याकूब ह अपन ददा इसहाक करा ले निकले ही रिहिस कि ओकर भाई एसाव ह सिकार करके घर आ गीस। <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />ओह घलो सुवादवाला जेवन बनाके अपन ददा करा लानिस अऊ कहिस, “हे मोर ददा, बईठ जा अऊ मोर दुवारा सिकार करके लाने गे मांस ला खा अऊ मोला अपन आसीस दे।”<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />ओकर ददा इसहाक ह ओकर ले पुछिस, “तें कोन अस?”</para>
  <para style="p" vid="GEN 27:32">ओह कहिस, “मेंह तोर बड़खा बेटा एसाव अंव।”<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />इसहाक ह बहुंत थरथरात कहिस, “फेर ओह कोन रिहिस, जेह सिकार करके मोर करा लानिस? अभी तोर आय के पहिली ही ओ सिकार के मांस ला में खायेंव अऊ ओला आसीस देंव—अऊ सही म ओला आसीस मिलही।”<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />अपन ददा के ये गोठ सुनके एसाव ह दुख के मारे नरियाके अऊ फूट-फूटके रोईस अऊ अपन ददा ला कहिस, “हे मोर ददा, मोला आसीस दे—मोला घलो आसीस दे!”<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />पर ओह कहिस, “तोर भाई धोखा से आईस अऊ तोर आसीस ला ले लीस।”<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />एसाव ह कहिस, “का ओकर नांव याकूब<note caller="+" style="f"><char style="fr" closed="false">27:36 </char><char style="fq" closed="false">याकूब </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">ओह एड़ी ला धरथे</char><char style="ft" closed="false">, इबरानी म एक मुहावरा, जेकर मतलब होथे </char><char style="fqa" closed="false">ओह फायदा उठाथे </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">ओह धोखा देथे</char></note> सही नइं रखे गे हे? येह दूसर बार ए, ओह मोर ले फायदा उठाय हवय: ओह मोर पहिलऊठा के अधिकार ला ले लीस, अऊ अब ओह मोर आसीस ला घलो ले गीस!” तब ओह अपन ददा ले पुछिस, “का तेंह मोर बर कोनो आसीस नइं रखे हस?”<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />इसहाक ह एसाव ला जबाब दीस, “मेंह ओला तोर ऊपर सुवामी ठहिराय हंव अऊ ओकर जम्मो रिस्तेदार ला ओकर सेवक बनाय हंव, अऊ मेंह ओला अनाज अऊ अंगूर के नवां मंद ले आसीसित करे हंव। अब हे मोर बेटा, में तोर बर का कर सकत हंव?”<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />एसाव ह अपन ददा ला कहिस, “हे मोर ददा, का तोर करा सिरिप एके ठन आसीस हवय? हे मोर ददा, मोला घलो आसीस दे!” तब एसाव चिचिया-चिचियाके रोईस।<verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />ओकर ददा इसहाक ह ओला जबाब दीस,</para>
  <para style="q1" vid="GEN 27:39">“तोर निवास ह धरती के</para>
  <para style="q2" vid="GEN 27:39">उपजाऊ भुइयां ले दूरिहा होही,</para>
  <para style="q2" vid="GEN 27:39">ऊपर के अकास के ओस ओमा नइं पड़ही।<verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />तेंह तलवार के बल म जिनगी जीबे</para>
  <para style="q2" vid="GEN 27:40">अऊ तेंह अपन भाई के सेवा करबे।</para>
  <para style="q1" vid="GEN 27:40">पर जब तेंह बियाकुल हो जाबे,</para>
  <para style="q2" vid="GEN 27:40">त तेंह ओकर सेवा करई</para>
  <para style="q2" vid="GEN 27:40">छोंड़ देबे।”<verse eid="GEN 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />एसाव ह ओ आसीस के कारन याकूब बर बईरता के भावना रखय, जऊन ला ओकर ददा ह याकूब ला देय रिहिस। ओह अपन मन म कहिस, “मोर ददा के मरे के दिन ह लकठा म हे; तब में अपन भाई याकूब ला मार डारहूं।”<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />जब रिबका ला ओकर बड़खा बेटा एसाव के ये बात बताय गीस, त ओह अपन छोटे बेटा याकूब ला बलाके कहिस, “सुन, तोर भईया एसाव ह बदला लेय बर तोला मार डारे के योजना बनावत हे। <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />एकरसेति हे मोर बेटा, मोर बात ला मान: तुरते मोर भाई लाबान करा हारान नगर म भाग जा। <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />अऊ कुछू समय तक ओकरे संग रह, जब तक कि तोर भईया के गुस्सा नइं उतर जावय। <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />जब तोर भईया के गुस्सा ह खतम हो जाही अऊ जऊन काम तेंह ओकर बिरूध करे हवस, ओला भुला जाही, तब में तोला खबर भिजवाके उहां ले बला लूहूं। अइसन झन हो कि एके दिन म, में तुमन दूनों झन ला गंवा दंव।”<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />तब रिबका ह इसहाक ला कहिस, “ये हित्ती माईलोगनमन के कारन, में अपन जिनगी ले असकटा गे हंव। यदि याकूब ह ये देस के कोनो माईलोगन ला याने कि ये हित्ती माईलोगनमन ले कोनो ला अपन घरवाली बना लेथे, त फेर मोर जीये के कोनो मतलब नइं होही।”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />एकरसेति इसहाक ह याकूब ला बलाके आसीस दीस, अऊ ओला हुकूम दीस: “तें कोनो कनानी छोकरी ले बिहाव झन करबे। <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />तें तुरते पदन-अराम<note caller="+" style="f"><char style="fr" closed="false">28:2 </char><char style="ft" closed="false">उत्तर-पछिम मेसोपोटामिया; <char style="xt" link-href="GEN 28:5"><ref loc="GEN 28:5">पद 5</ref></char>, <char style="xt" link-href="GEN 28:6"><ref loc="GEN 28:6">6</ref></char> अऊ <char style="xt" link-href="GEN 28:7"><ref loc="GEN 28:7">7</ref></char> म घलो</char></note> म, अपन नाना बतूएल के घर जा। उहां तोर ममा लाबान के कोनो बेटी ले बिहाव कर ले। <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />सर्वसक्तिमान परमेसर ह तोला आसीस देवय अऊ तोला फूलाय-फलाय अऊ तोर गनती ला बढ़ाय, जब तक कि तें मनखेमन के एक समाज नइं बन जावस। <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />ओह अब्राहम ले करे गे परतिगियां के आसीस तोला अऊ तोर बंस ला देवय, ताकि तें ये देस के मालिक बन जा, जिहां अभी तें एक परदेसी के रूप म रहिथस, अऊ जेला परमेसर ह अब्राहम ला दे रिहिस।” <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />तब इसहाक ह याकूब ला बिदा करिस, अऊ ओह पदन-अराम म अरामी बतूएल के बेटा लाबान के घर गीस। लाबान ह याकूब अऊ एसाव के दाई रिबका के भाई रिहिस।<verse eid="GEN 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />जब एसाव ला ये पता चलिस कि इसहाक ह याकूब ला आसीस दे हवय अऊ ओला पदन-अराम पठोय हवय कि ओह उहां बिहाव करय, अऊ ओला आसीस देके ये हुकूम दे हवय, “तें कोनो कनानी माईलोगन ले बिहाव झन करबे,” <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />अऊ याकूब ह अपन दाई-ददा के बात मानके पदन-अराम ला चल दे हवय। <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />तब एसाव महसूस करिस कि कनानी छोकरीमन ओकर ददा इसहाक ला कतेक नापसंद रिहिन; <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />एकरसेति ओह अब्राहम के बेटा इसमायल करा गीस, अऊ इसमायल के बेटी महलत ले बिहाव कर लीस, जऊन ह कि नबायोत के बहिनी रिहिस। एसाव के अऊ घलो घरवाली रिहिन।<verse eid="GEN 28:9" /></para>
  <para style="s1">याकूब के बेतेल म सपना देखई</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />याकूब ह बेरसेबा ला छोंड़के हारान जाय बर निकलिस। <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />जब ओह एक जगह म हबरिस, त उहां रात काटे बर रूकिस काबरकि बेर बुड़ गे रहय। उहां एक पथरा ला लेके अपन मुड़ खाल्हे तकिया के रूप म रखिस अऊ सुत गीस। <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />ओह सपना म देखिस कि एक सीढ़ी धरती म ठाढ़े हे अऊ ओकर दूसर छोर ह स्वरग तक हबरत हे, अऊ परमेसर के स्वरगदूतमन ओमा चघत-उतरत हवंय। <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />ओकर ऊपर म यहोवा ह ठाढ़ होके कहत हे: “में यहोवा, तोर दादा अब्राहम के परमेसर अऊ तोर ददा इसहाक के परमेसर अंव। जऊन भुइयां म तेंह सुते हस, ओला में तोला अऊ तोर बंस ला दूहूं। <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />तोर संतानमन भुइयां के धुर्रा सहीं अनगिनत होहीं, अऊ ओमन पछिम, पूरब, उत्तर, दक्खिन, चारों कोति बगर जाहीं। धरती के जम्मो मनखेमन तोर अऊ तोर संतान के जरिये आसीस पाहीं। <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />सुन, में तोर संग हवंव अऊ जिहां कहूं तें जाबे, में तोर रकछा करहूं, अऊ मेंह तोला ये देस म लहुंटाके लानहूं। मेंह तोर ले जऊन परतिगियां करे हंव, जब तक ओला पूरा नइं कर लूहूं, तब तक में तोला नइं छोड़ंव।”<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />जब याकूब ह नींद ले जागिस, त ओह सोचिस, “सही म, ये ठऊर म यहोवा हवय, अऊ में ये बात ला नइं जानत रहेंव।” <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />ओह डर के मारे कहिस, “ये ठऊर ह कतेक बढ़िया हवय! येह परमेसर के घर के छोंड़ अऊ कुछू नइं हो सकय; येह स्वरग के कपाट अय।”<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />बड़े बिहनियां याकूब ह ओ पथरा ला लीस, जऊन ला ओह अपन मुड़ के खाल्हे तकिया के रूप म रखे रिहिस अऊ ओला खंभा के रूप म ठाढ़ करिस अऊ ओकर टीप म तेल रितो दीस। <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />ओह ओ ठऊर के नांव बेतेल<note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="fq" closed="false">बेतेल </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">परमेसर के घर</char></note> रखिस, हालाकि ओ सहर के नांव लूज रिहिस।<verse eid="GEN 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20" />तब याकूब ह ये मन्नत मानके कहिस, “यदि परमेसर ह मोर संग रहिही अऊ ये यातरा म मोर रकछा करही अऊ मोला खाय बर रोटी अऊ पहिरे बर कपड़ा दीही <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />अऊ में अपन ददा के घर म सही-सलामत लहुंटके आहूं, त यहोवा ह मोर परमेसर ठहिरही <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />अऊ ये पथरा जेला मेंह खंभा के रूप म ठाढ़ करे हवंव, परमेसर के घर होही, अऊ जऊन कुछू तें मोला देबे, ओ जम्मो के दसवां हिस्सा में तोला दूहूं।”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s1">याकूब पदन-अराम म आथे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />तब याकूब ह अपन यातरा म आघू बढ़िस अऊ पूरब दिग के मनखेमन के देस म आईस। <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />उहां ओह मैदान म एक कुआं देखिस, जेकर लकठा म भेड़-बकरीमन के तीन झुंड बईठे रहंय, काबरकि ओमन ला ओ कुआं ले पानी पीयाय जावय। कुआं के मुहूं के ऊपर के पथरा ह बहुंत बड़े रिहिस। <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />जब जम्मो झुंड ह उहां जमा होवय, त चरवाहामन कुआं के मुहूं ले पथरा ला हटाके भेड़-बकरीमन ला पानी पीयावंय, अऊ तब ओमन पथरा ला फेर कुआं के मुहूं ऊपर जइसन के तइसन मढ़ा दें।<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />याकूब ह चरवाहामन ला पुछिस, “हे भाईमन, तुमन कहां के अव?”</para>
  <para style="p" vid="GEN 29:4">ओमन जबाब दीन, “हमन हारान के अन।”<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />तब ओह ओमन ले पुछिस, “का तुमन नाहोर के पोता लाबान ला जानथव?”</para>
  <para style="p" vid="GEN 29:5">ओमन जबाब दीन, “हव, हमन ओला जानथन।”<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />तब याकूब ह ओमन ले पुछिस, “का ओह बने हवय?”</para>
  <para style="p" vid="GEN 29:6">ओमन कहिन, “हव, ओह बने हवय, अऊ देख, ओकर बेटी राहेल ह भेड़मन ला लेके आवत हे।”<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />ओह कहिस, “देखव, अभी तो दिन बहुंत हे; अभी पसुमन के जूरे के बेरा नइं होय हे। भेड़मन ला पानी पीयावव अऊ फेर ले जाके चरावव।”<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />ओमन कहिन, “हमन अइसन नइं कर सकन; जब जम्मो झुंड ह जूरही अऊ पथरा ह कुआं के मुहूं ले टारे जाही, तब हमन भेड़मन ला पानी पीयाबो।”<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />जब ओह ओमन ले गोठियावत रिहिस, तभे राहेल ह अपन ददा के भेड़मन ला लेके आईस, काबरकि ओह पसु चराय के बुता करय। <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />जब याकूब ह अपन ममा लाबान के बेटी राहेल, अऊ अपन ममा के भेड़मन ला देखिस, त ओह उहां जाके कुआं के मुहूं ले पथरा ला टार दीस अऊ अपन ममा के भेड़मन ला पानी पीयाईस। <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />तब याकूब ह राहेल ला चूमिस अऊ चिचिया-चिचियाके रोये लगिस। <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />ओह राहेल ला बता दे रिहिस कि ओह ओकर फुफेरा भाई ए, याने कि ओकर फूफू रिबका के बेटा ए। एकरसेति राहेल ह दऊड़के गीस अऊ अपन ददा ला बताईस।<verse eid="GEN 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13" />अपन भांचा याकूब के खबर पाते ही, लाबान तुरते ओकर संग भेंट करे बर गीस। ओह ओला पोटारके चूमिस अऊ ओला अपन घर ले आईस, अऊ उहां याकूब ओला अपन जम्मो बात बताईस। <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />तब लाबान ह ओला कहिस, “तें तो मोर खुद के मांस अऊ लहू अस।”</para>
  <para style="s1" vid="GEN 29:14">याकूब ह लिआ अऊ राहेल ले बिहाव करथे</para>
  <para style="p" vid="GEN 29:14">याकूब के लाबान संग एक महिना रहे के बाद, <verse eid="GEN 29:14" /><verse number="15" style="v" sid="GEN 29:15" />लाबान ह ओला कहिस, “रिस्तेदार अस तभो ले तोला सोझे म बुता कराना मोला बने नइं लगय, त मोला बता कि बुता करे के बदला म में तोला का देवंव?”<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />लाबान के दू झन बेटी रिहिन; बड़की के नांव लिआ अऊ छोटकी के नांव राहेल रिहिस। <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />लिआ के आंखीमन कमजोर रिहिन, पर राहेल ह रूपवती अऊ सुघर रिहिस। <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />याकूब ह राहेल ले मया करय, एकरसेति ओह कहिस, “में तोर छोटे बेटी राहेल बर सात बछर तोर काम करहूं।”<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />लाबान ह कहिस, “ये बने बात अय कि ओला कोनो अऊ मनखे ला देय के बदले तोला देवंव। इहां मोर संग रह।” <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />याकूब सात बछर तक राहेल ला पाय बर सेवा करिस, पर ये सात बछर ह ओला सिरिप कुछू दिन सहीं लगिस काबरकि ओह राहेल ले मया करय।<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />तब याकूब ह लाबान ला कहिस, “मोर घरवाली ला मोला दे। मोर समय ह पूरा हो गीस, अऊ अब मेंह ओकर मेर जाय चाहत हंव।”<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />तब लाबान ह उहां के जम्मो मनखे ला इकट्ठा करिस अऊ ओमन ला एक भोज दीस। <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />पर जब सांझ होईस, त ओह अंधियार के बेरा अपन बेटी लिआ ला याकूब करा लानिस, अऊ याकूब ओकर संग संबंध बनाईस। <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />लाबान ह अपन बेटी लिआ के दासी होय बर अपन दासी जिलपा ला दीस।<verse eid="GEN 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 29:25" />जब बिहान होईस, तब पता चलिस कि ये तो लिआ ए। एकरसेति याकूब ह लाबान ला कहिस, “तें मोर संग ये का करे हस? का में तोर सेवा राहेल बर नइं करेंव? तें मोला काबर धोखा दे हस?”<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />लाबान ह जबाब दीस, “हमर इहां अइसन रीति नइं ए कि बड़की बेटी के रहत छोटकी बेटी के बिहाव करन। <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />बेटी के बिहाव उत्सव के ये हप्ता ला पूरा कर; फेर हमन छोटकी ला घलो तोला देबो, तेकर बर तोला अऊ सात साल मोर काम करना पड़ही।”<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />तब याकूब ह वइसनेच करिस। ओह लिआ के संग हप्ता पूरा करिस, अऊ तब लाबान ह ओला अपन बेटी राहेल ला घलो दीस कि ओह ओकर घरवाली होवय। <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />लाबान ह अपन बेटी राहेल के दासी होय बर अपन दासी बिलहा ला दीस। <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />याकूब ह राहेल ले घलो संबंध बनाईस, अऊ ओकर मया लिआ ले जादा राहेल बर रहय। अऊ ओह लाबान बर अऊ सात बछर काम करिस।<verse eid="GEN 29:30" /></para>
  <para style="s1">याकूब के लइकामन</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />जब यहोवा ह देखिस कि लिआ ह मया नइं पावत हे, त ओह ओला गरभ ठहिरे के आसीस दीस, पर राहेल बांझ रहय। <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />लिआ ह आसरा म होईस अऊ एक बेटा ला जनमिस। ओह ये कहिके ओकर नांव रूबेन<note caller="+" style="f"><char style="fr" closed="false">29:32 </char><char style="fq" closed="false">रूबेन </char><char style="ft" closed="false">येकर मतलब होथे </char><char style="fqa" closed="false">देखव, एक बेटा</char></note> रखिस, “यहोवा ह मोर दुख कोति धियान दे हवय। अब मोर घरवाला ह खचित मोला मया करही।”<verse eid="GEN 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33" />ओह फेर आसरा म होईस, अऊ ओकर फेर एक बेटा होईस, त ओह कहिस, “काबरकि यहोवा ह सुनिस कि मोला मया नइं मिलत हे, तेकर खातिर ओह मोला ये बेटा घलो दीस।” अऊ ओह ओकर नांव सिमोन<note caller="+" style="f"><char style="fr" closed="false">29:33 </char><char style="fq" closed="false">सिमोन </char><char style="ft" closed="false">संभवतः येकर मतलब होथे </char><char style="fqa" closed="false">सुनइया</char></note> रखिस।<verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />ओह फेर आसरा म होईस, अऊ ओकर फेर एक बेटा होईस, त ओह कहिस, “अब मोर घरवाला ह मोला मिल जाही, काबरकि ओकर दुवारा मोर तीन बेटा होईन।” एकरसेति ओकर नांव लेवी<note caller="+" style="f"><char style="fr" closed="false">29:34 </char><char style="fq" closed="false">लेवी </char><char style="ft" closed="false">इबरानी म येकर मतलब हो सकथे </char><char style="fqa" closed="false">लगाव</char></note> रखे गीस।<verse eid="GEN 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35" />ओह फेर आसरा म होईस, अऊ ओकर एक अऊ बेटा होईस, त ओह कहिस, “अब के बार में यहोवा के परसंसा करहूं।” एकरसेति ओह ओकर नांव यहूदा<note caller="+" style="f"><char style="fr" closed="false">29:35 </char><char style="fq" closed="false">यहूदा </char><char style="ft" closed="false">सायद इबरानी म येकर मतलब होथे </char><char style="fqa" closed="false">इस्तुति</char></note> रखिस। तब कुछू समय तक ओला लइका नइं होईस।<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />जब राहेल ह देखिस कि याकूब कोति ले ओला कोनो लइका नइं होवथे, त ओह अपन बहिनी ले जलन करे लगिस। ओह याकूब ला कहिस, “मोला लइका दे, नइं तो में मर जाहूं।”<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />याकूब ह राहेल ऊपर गुस्सा होके कहिस, “का में परमेसर अंव? तोर कोख ला तो ओही ह बंद रखे हवय।”<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />तब राहेल ह कहिस, “ये दे मोर दासी बिलहा इहां हवय। ओकर ले संबंध बना ताकि ओह मोर बर लइका जनमे अऊ में घलो ओकर जरिये एक परिवार बनावंव।”<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />त ओह अपन दासी बिलहा ला ओकर घरवाली होय बर दीस। याकूब ओकर करा गीस, <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />अऊ बिलहा ह आसरा म होईस अऊ याकूब ले ओला एक बेटा होईस। <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />तब राहेल ह कहिस, “परमेसर ह मोर नियाय करे हवय; ओह मोर बिनती ला सुनके मोला एक बेटा दे हवय।” एकर कारन ओह ओकर नांव दान<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="fq" closed="false">दान </char><char style="ft" closed="false">इहां येकर मतलब होथे </char><char style="fqa" closed="false">ओह </char><char style="fq" closed="false">नियाय करे हवय</char></note> रखिस।<verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />राहेल के दासी बिलहा फेर आसरा म होईस अऊ याकूब ले ओकर एक अऊ बेटा होईस। <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />तब राहेल ह कहिस, “मोर बहिनी के संग मोर बहुंत संघर्स होईस, अऊ में जीत गेंव।” त ओह ओकर नांव नपताली<note caller="+" style="f"><char style="fr" closed="false">30:8 </char><char style="fq" closed="false">नपताली </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">मोर </char><char style="fq" closed="false">संघर्स</char></note> रखिस।<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />जब लिआ देखिस कि अब ओकर लइका नइं होवथे, त ओह अपन दासी जिलपा ला याकूब के घरवाली होय बर दीस। <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />अऊ लिआ के दासी जिलपा ले याकूब के एक बेटा होईस। <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />तब लिआ ह कहिस, “कतेक बढ़िया किस्मत!” त ओह ओकर नांव गाद<note caller="+" style="f"><char style="fr" closed="false">30:11 </char><char style="fq" closed="false">गाद </char><char style="ft" closed="false">के मतलब हो सकथे </char><char style="fqa" closed="false">बने भाग्य </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">दल</char></note> रखिस।<verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />लिआ के दासी जिलपा के याकूब ले एक अऊ बेटा होईस। <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />तब लिआ ह कहिस, “में बहुंत खुस हंव! माईलोगनमन मोला धइन कहिहीं।” त ओह ओकर नांव आसेर<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="fq" closed="false">आसेर </char><char style="ft" closed="false">के मतलब होथे </char><char style="fq" closed="false">खुस</char></note> रखिस।<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />गहूं लुवई के समय, रूबेन ला मैदान म कुछू दूदा फर<note caller="+" style="f"><char style="fr" closed="false">30:14 </char><char style="ft" closed="false">अइसे समझे जाथे कि येह सारीरिक संबंध बर </char><char style="fqa" closed="false">उत्तेजित </char><char style="ft" closed="false">करथे अऊ माईलोगन ला गरभवती होय म मदद करथे</char></note> मिलिस, जेला ओह अपन दाई लिआ करा ले गीस। तब राहेल ह लिआ ला कहिस, “तोर बेटा के दूदा फर म ले कुछू महूं ला दे।”<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />पर लिआ ह ओला कहिस, “तेंह जो मोर घरवाला ला लेय ले हस; का येह छोटे बात अय? अऊ अब मोर बेटा के दूदा फर ला घलो लेय चाहत हस?”</para>
  <para style="p" vid="GEN 30:15">राहेल ह कहिस, “ठीक हे, तोर बेटा के दूदा फर के बदला म, आज रथिया हमर घरवाला ह तोर करा सुतही।”<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />सांझकुन जब याकूब ह खेत ले आईस, त लिआ ह ओकर ले भेंट करे बर गीस अऊ ओला कहिस, “तोला मोर करा आय बर पड़ही, काबरकि मेंह अपन बेटा के दूदा फर के बदला म तोला लेय ले हंव।” त याकूब ह ओ रथिया ओकर संग सुतिस।<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />परमेसर ह लिआ के सुनिस, अऊ ओह आसरा म होके याकूब बर पांचवां बेटा जनमिस। <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />तब लिआ ह कहिस, “में जो अपन दासी ला अपन घरवाला ला देंव, एकरे बर परमेसर ह मोला ईनाम दे हवय।” त ओह ओकर नांव इस्साकार<note caller="+" style="f"><char style="fr" closed="false">30:18 </char><char style="fq" closed="false">इस्साकार </char><char style="ft" closed="false">इबरानी म येकर मतलब हो सकथे </char><char style="fq" closed="false">ईनाम</char></note> रखिस।<verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />लिआ फेर आसरा म होईस अऊ याकूब ले ओकर छठवां बेटा जनमिस। <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />तब लिआ ह कहिस, “परमेसर ह मोला बढ़िया ईनाम दे हवय। अब के बार मोर आदमी मोर संग आदर के बरताव करही, काबरकि मेंह ओकर दुवारा छै बेटा जनमे हंव।” त ओह ओकर नांव जबूलून<note caller="+" style="f"><char style="fr" closed="false">30:20 </char><char style="fq" closed="false">जबूलून </char><char style="ft" closed="false">संभवतः येकर मतलब होथे </char><char style="fqa" closed="false">सम्मान</char></note> रखिस।<verse eid="GEN 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21" />कुछू समय के बाद, ओकर एक झन बेटी घलो होईस अऊ ओह ओकर नांव दीना रखिस।<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />तब परमेसर ह राहेल के घलो सुधि लीस; ओह ओकर गरभ ठहिरे के आसीस दीस। <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />ओह आसरा म होईस अऊ एक बेटा जनमिस अऊ कहिस, “परमेसर ह मोर बेजत्ती ला दूर करे हवय।” <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />ओह ये कहिके अपन बेटा के नांव यूसुफ<note caller="+" style="f"><char style="fr" closed="false">30:24 </char><char style="fq" closed="false">यूसुफ </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">ओह जोड़य</char></note> रखिस, “यहोवा मोला एक अऊ बेटा देवय।”<verse eid="GEN 30:24" /></para>
  <para style="s1">याकूब के पसुमन के गनती म बढ़ती</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />जब राहेल ह यूसुफ ला जनमिस, त याकूब ह लाबान ला कहिस, “मोला बिदा कर कि में अपन देस वापिस जा सकंव। <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />मोर घरवाली अऊ मोर लइकामन ला मोला दे, जेमन बर में तोर सेवा करे हंव ताकि में इहां ले चले जावंव। तें तो जानत हस कि मेंह तोर कतेक सेवा करे हंव।”<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />पर लाबान ह ओला कहिस, “यदि तोर नजर म में दया पाय के लईक हंव, त रूक जा। काबरकि मेंह अनुभव ले जान डारे हंव कि यहोवा ह तोर कारन से मोला आसीस दे हवय।” <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />फेर ओह कहिस, “तें अपन बनी बता अऊ में तोला तोर बनी दूहूं।”<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />याकूब ह ओला कहिस, “तेंह जानत हस कि मेंह तोर कइसन सेवा करे हंव अऊ तोर पसुमन मोर देखरेख म कइसन बढ़िन हें। <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />मोर आय के पहिली ओमन थोरकन रिहिन, अऊ अब कतेक बढ़ गे हवंय, अऊ जिहां कहूं मेंह हांथ लगांय, यहोवा ह तोला अब्बड़ आसीस दीस। पर अब, में अपन परिवार बर कब कुछू करहूं?”<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />ओह पुछिस, “में तोला का देवंव?”</para>
  <para style="p" vid="GEN 30:31">याकूब ह कहिस, “तें मोला कुछू झन दे; पर यदि तें मोर बर एक काम करबे, त में फेर तोर भेड़-बकरी ला चराहूं अऊ ओमन के देखरेख करहूं: <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />मोला आज तोर जम्मो भेड़-बकरी के बीच म ले होके जावन दे, अऊ जऊन भेड़मन धारीवाले या चितकबरी हवंय, अऊ जऊन मेढ़ामन करिया हवंय अऊ जऊन छेरीमन धारीवाले अऊ चितकबरी हवंय, ओमन ला अलग करन दे। ओमन मोर मजदूरी होहीं। <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />अऊ अवइया समय म मोर ईमानदारी के सबूत ये होही कि जऊन मजदूरी तेंह मोला दे हस; जब तें ओकर जांच करबे; त यदि कोनो बकरी धारीवाले या चितकबरी नइं होही या कोनो मेढ़ा-पीला करिया रंग के नइं होही, त ओह चोरी के समझे जाही।”<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />लाबान ह कहिस, “में राजी हंव। तोर कहे के मुताबिक होवय।” <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />ओहीच दिन ओह जम्मो धारीवाले अऊ धब्बावाले बोकरा, अऊ जम्मो धारीवाली अऊ धब्बावाली बकरी (सफेद धब्बावाली) अऊ जम्मो करिया मेढ़ा-पीलामन ला अलग करके अपन बेटामन के देखरेख म कर दीस। <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />तब ओह अपन अऊ याकूब के बीच म तीन दिन के यातरा के दूरी बना लीस, अऊ याकूब ह लाबान के बाकि भेड़-बकरीमन ला चराय लगिस।<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />तब याकूब ह चिनार, बादाम, अऊ अरमोन रूख के हरियर-हरियर छड़ी लेके ओकर छिलका ला जगह-जगह छिलके धारीदार बना दीस, जेकर से ओ छड़ीमन के सफेदी ह दिखे लगिस। <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />तब छिलाय छड़ीमन ला पानी पीये के जम्मो कोटना म अइसे रखिस कि जब भेड़-बकरीमन पानी पीये बर आवंय, त ओमन सीधा भेड़-बकरीमन के आघू म रहंय। जब भेड़-बकरीमन गाभिन होय के समय पानी पीये बर आईन, <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />त ओमन छड़ीमन के आघू म समागम करिन अऊ गाभिन होके भेड़-बकरीमन धारीवाला या चित्तीवाला या चितकबरा पीला जनमे लगिन। <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />याकूब ह मेढ़ा-पीलामन ला अलग-अलग करिस, पर बाकि बचे भेड़-बकरीमन के मुहूं ला लाबान के चित्तीवाले अऊ करिया भेड़-बकरीमन कोति कर दीस। ये किसम ले ओह अपन भेड़-बकरीमन के अलग झुंड बनाईस अऊ ओमन ला लाबान के भेड़-बकरीमन संग मिले नइं दीस। <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />जब भी मजबूत भेड़-बकरीमन के गाभिन होय के समय होवय, त याकूब ह ओ छड़ीमन ला कोटना म ओमन के आघू म ठाढ़ कर देवय, जेकर से ओमन छड़ीमन के लकठा म गाभिन होवंय, <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />पर जब कमजोर भेड़-बकरीमन गाभिन होवंय, त ओह ओमन ला छड़ीमन के आघू म नइं रखय। ये कारन से कमजोर पसुमन लाबान के होईन अऊ मजबूत पसुमन याकूब के हो गीन। <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />अइसन करके याकूब ह भारी धनवान हो गीस। ओकर खुद के अब्बड़ भेड़-बकरी, अऊ दास-दासी, अऊ ऊंट, अऊ गदहामन हो गीन।<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s1">याकूब के लाबान करा ले भगई</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />लाबान के बेटामन के ये बात याकूब के सुने म आईस, “याकूब ह हमर ददा के जम्मो चीज ला लेय ले हे, अऊ हमर ददा के धन के कारन ओह ये जम्मो धन-संपत्ति कमाय हे।” <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />अऊ याकूब ह धियान दीस कि लाबान के बरताव ह ओकर बर पहिले सहीं नइं ए।<verse eid="GEN 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3" />तब यहोवा ह याकूब ला कहिस, “तेंह अपन पुरखा अऊ अपन रिस्तेदारमन के देस म लहुंट जा, अऊ मेंह तोर संग रहिहूं।”<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />एकरसेति याकूब ह राहेल अऊ लिआ ला बाहिर मैदान म आय बर खबर भिजवाईस जिहां ओकर भेड़-बकरीमन रहंय। <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />ओह ओमन ला कहिस, “में देखत हंव कि तुम्हर ददा के बरताव ह मोर बर पहिले सहीं नइं ए, पर मोर ददा के परमेसर ह मोर संग हवय। <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />तुमन जानत हव कि में तुम्हर ददा के सेवा पूरा मेहनत से करे हंव, <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />तभो ले तुम्हर ददा ह दस बार मोर बनी ला बदलके मोर ले छल-कपट करिस। पर परमेसर ह ओला मोर हानि करे बर नइं दीस। <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />जब ओह कहिस, ‘चित्तीवाला बोकरामन तोर मजदूरी होहीं,’ त जम्मो भेड़-बकरीमन चित्तीवाला जनमे लगिन; अऊ जब ओह कहिस, ‘धारीवालामन तोर मजदूरी होहीं,’ त जम्मो भेड़-बकरीमन धारीवाला जनमे लगिन। <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />अइसन करके परमेसर ह तोर ददा के पसुमन ला लेके मोला दे हवय।<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />“भेड़-बकरी के गाभिन होय के समय म एक बार मेंह सपना म देखेंव कि जऊन बोकरामन बकरी ऊपर चघत हवंय, ओमन धारीवाला, चित्तीवाला या चितकबरा हवंय। <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />तब परमेसर के स्वरगदूत ह सपना म मोला कहिस, ‘हे याकूब।’ में कहेंव, ‘में इहां हंव।’ <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />अऊ ओह कहिस, ‘आंखी उठाके देख कि ओ जम्मो बोकरा, जेमन बकरीमन ऊपर चघत हवंय, ओमन धारीवाला, चित्तीवाला या चितकबरा हवंय, काबरकि में ओ जम्मो चीज ला देखे हवंव, जऊन ला लाबान तोर संग करत हवय। <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />में ओ बेतेल के परमेसर अंव, जिहां तें एक खंभा के अभिसेक करे रहय, अऊ मोर मन्नत माने रहय। अब तें ये देस ला तुरते छोंड़ अऊ अपन जनम भुइयां ला लहुंट जा।’ ”<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />तब राहेल अऊ लिआ कहिन, “का हमर ददा के संपत्ति म अब भी हमर कुछू बांटा या हिस्सा बांचे हवय? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />का ओह हमन ला परदेसी नइं समझत हे? ओह सिरिप हमन ला बेचे ही नइं ए, पर हमर बदले दिये गय रूपिया ला खा डारिस हे। <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />सही म, ओ जम्मो धन जऊन ला परमेसर ह हमर ददा ले लेय लीस, ओ हमर अऊ हमर लइकामन के अय। एकरसेति जइसन परमेसर ह तोला कहे हवय, वइसने कर।”<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />तब याकूब ह अपन लइका अऊ घरवालीमन ला ऊंट म चघाईस, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />अऊ जतेक पसु अऊ सामान ओह पदन-अराम म कमाय रिहिस, ओ जम्मो ला अपन आघू म रवाना करके, अपन ददा इसहाक करा कनान देस जाय बर निकलिस।<verse eid="GEN 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 31:19" />जब लाबान ह अपन भेड़मन के ऊन कतरे बर गे रिहिस, त राहेल ह अपन ददा के घर-देवतामन ला चोरा लीस। <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />याकूब ह लाबान अरामी करा ले चोरी से चले गीस; ओला नइं बताईस कि ओह भागके जावत हे। <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />ओह अपन जम्मो कुछू ला लेके भागिस, अऊ फरात नदी ला पार करके गिलाद के पहाड़ी देस कोति गीस।<verse eid="GEN 31:21" /></para>
  <para style="s1">लाबान ह याकूब के पीछा करथे</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />तीसर दिन लाबान ला खबर मिलिस कि याकूब ह भाग गे हवय। <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />अपन रिस्तेदारमन ला लेके, ओह सात दिन तक याकूब के पीछा करिस अऊ गिलाद के पहाड़ी देस म ओकर करा हबरिस। <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />पर परमेसर ह रथिया सपना म आके अरामी लाबान ला कहिस, “सावधान रह! तें याकूब ला न तो भला कहिबे, न बुरा।”<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />जब लाबान ह याकूब करा हबरिस, तब याकूब ह गिलाद के पहाड़ी देस म अपन तम्बू गाड़े रिहिस, अऊ लाबान ह घलो अपन रिस्तेदारमन संग उहां अपन तम्बू गाड़िस। <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />तब लाबान ह याकूब ला कहिस, “तेंह ये का करे हस? तेंह मोला धोखा दे हस, अऊ मोर बेटीमन ला अइसने लाने हस, जइसने लड़ई के समय दूसरमन ला बंदी बनाके लानथें। <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />तेंह काबर चुपेचाप भागके मोला धोखा देय? तेंह मोला काबर नइं बताय, नइं तो में तोला आनंद के संग गावत अऊ मिरदंग अऊ बीना बजावत बिदा करे रहितेंव? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />तेंह तो मोला अपन नाती-नतनीन अऊ बेटीमन ला चूमे तक नइं देय? तेंह गंवारी करे हस। <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />तोला नुकसान पहुंचाय के ताकत मोर करा हवय, पर बीते रथिया, तोर ददा के परमेसर ह मोला कहिसे, ‘सावधान रह! तें याकूब ला न तो भला कहिबे, न बुरा।’ <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />तें अपन ददा के घर के मोह के कारन चले आय। पर तें मोर देवतामन ला काबर चोराके ले आने हस?”<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />याकूब ह लाबान ला जबाब दीस, “में ये सोचके डरा गे रहेंव कि कहूं तें अपन बेटीमन ला मोर ले जबरदस्ती झन छीन ले। <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />पर जेकर मेर तें अपन देवतामन ला पाबे, ओ जीयत नइं बांचय। मोर रिस्तेदारमन के आघू म, तें खुद देख ले, कहूं तोर कोनो चीज मोर करा हवय त; यदि हवय, त ओला लेय ले।” याकूब ह नइं जानत रिहिस कि राहेल ह देवतामन ला चोराके ले आने हे।<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />एकरसेति लाबान ह याकूब के तम्बू अऊ लिआ के तम्बू अऊ दू झन दासीमन के तम्बूमन म गीस, पर ओला कुछू नइं मिलिस। लिआ के तम्बू म ले निकलके, ओह राहेल के तम्बू म गीस। <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />राहेल ह घर-देवतामन ला लेके अपन ऊंट के काठी के भीतर म रखे रिहिस अऊ ओकर ऊपर बईठ गे रिहिस। लाबान ह ओकर जम्मो तम्बू म खोजिस पर ओला कुछू नइं मिलिस।<verse eid="GEN 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35" />राहेल ह अपन ददा ला कहिस, “हे मोर परभू, गुस्सा झन कर कि में तोर आघू म ठाढ़ नइं हो सकेंव; काबरकि मोला माहवारी होवत हे।” ओह खोजिस पर ओला घर-देवतामन नइं मिलिन।<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />तब याकूब ह गुस्सा होके लाबान ले बिबाद करे लगिस अऊ लाबान ले पुछिस, “मोर का दोस ए?” में तोर का गलत करे हंव कि तें मोर पीछा करत आय हस? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />तें मोर जम्मो सामान ला खोजके देख डारे; इहां तोला अपन घर के सामान म ले का चीज मिलिस? कुछू पाय हस, त ओला तोर अऊ मोर रिस्तेदारमन के आघू म रख, अऊ ओमन ला हमन दूनों के नियाय करन दे।<verse eid="GEN 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 31:38" />“मेंह तोर संग बीस बछर तक रहेंव; अऊ ये दौरान न तो तोर भेड़-बकरीमन के गरभ गिरिस, न कभू में तोर झुंड के मेढ़ा के मांस खायेंव। <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />तोर जऊन पसुमन ला हिंसक पसुमन मार डारिन, ओमन ला में तोर करा नइं लानेंव; ओकर हानि में खुद उठांय। कोनो चीज, चाहे दिन के चोरी जाय या रथिया, तें ओकर भरती मोर ले मांगे। <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />मोर तो ये दसा रिहिस: दिन के समय घाम ले अऊ रथिया ठंड के मारे मरत रहेंव, अऊ नींद ह मोर आंखी ले कोसों दूर रिहिस। <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />मेंह ये दसा म तोर घर म बीस बछर तक रहेंव। में चौदह बछर तक तोर दूनों बेटी बर अऊ छै बछर तक तोर भेड़-बकरीमन बर सेवा करेंव, अऊ तें मोर मजदूरी ला दस बार बदले हस। <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />कहूं मोर ददा के परमेसर, याने कि अब्राहम के परमेसर, जेकर भय इसहाक घलो मानथे, कहूं ओह मोर संग नइं होतिस, त खचित तें मोला जुच्छा हांथ पठो दे रहितय। पर परमेसर ह मोर दुख अऊ मोर हांथ के मेहनत ला देखे हवय, अऊ बीते रथिया ओह तोला डांटिस।”<verse eid="GEN 31:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />लाबान ह याकूब ला कहिस, “ये माईलोगनमन तो मोर बेटी अंय, अऊ ये लइकामन मोर लइका अंय, अऊ ये भेड़-बकरीमन भी मोर अंय। जऊन कुछू तेंह देखत हस, ओ जम्मो मोर अंय। पर अब में मोर ये बेटीमन के का कर सकत हंव, या येमन के दुवारा जनमे लइकामन के का कर सकत हंव? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />अब आ, हमन एक करार करन, तें अऊ में, अऊ येह हमर बीच म एक गवाही के काम करय।”<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />तब याकूब ह एक पथरा लीस अऊ ओला एक खंभा के रूप म ठाढ़ करिस। <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />ओह अपन रिस्तेदारमन ला कहिस, “कुछू पथरा संकेलव।” त ओमन पथरा संकेलके कुढ़ो दीन, अऊ ओही कुढ़ा मेर जेवन करिन। <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />ओ कुढ़ा के नांव लाबान ह यजर-सहादुथा, पर याकूब ह गलीद<note caller="+" style="f"><char style="fr" closed="false">31:47 </char><char style="ft" closed="false">अरामिक म </char><char style="fq" closed="false">यजर-सहादुथा </char><char style="ft" closed="false">अऊ इबरानी म </char><char style="fq" closed="false">गलीद </char><char style="ft" closed="false">दूनों सबद के मतलब होथे </char><char style="fqa" closed="false">गवाही के कुढ़ा</char></note> रखिस।<verse eid="GEN 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="GEN 31:48" />लाबान ह कहिस, “ये कुढ़ा ह आज तोर अऊ मोर बीच म एक गवाही ए।” एकरसेति ओला गलीद कहे गीस। <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />येला मिसपा<note caller="+" style="f"><char style="fr" closed="false">31:49 </char><char style="fq" closed="false">मिसपा </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">निगरानी करे के मीनार</char></note> घलो कहे गीस, काबरकि ओह कहिस, “जब हमन एक-दूसर ले अलग हो जाबो, त यहोवा के नजर तोर अऊ मोर ऊपर रहय। <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />यदि तें मोर बेटीमन ला दुख देबे या मोर बेटीमन के छोंड़ अऊ कोनो ला घरवाली बना लेबे, हालाकि हमर संग कोनो मनखे नइं ए, त सुरता रख कि परमेसर ह तोर अऊ मोर बीच म गवाह हे।”<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />लाबान ह याकूब ला ये घलो कहिस, “ये कुढ़ा ह इहां हवय, अऊ ये खंभा ला में तोर अऊ मोर बीच म ठाढ़ करे हंव। <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />ये कुढ़ा अऊ ये खंभा दूनों ये बात के गवाह रहंय कि तोर नुकसान करे के बिचार ले, न तो में ये कुढ़ा ला नाहकके तोर तरफ आहूं, अऊ न ही मोर नुकसान करे के बिचार ले, तें ये कुढ़ा या खंभा ला नाहकके मोर तरफ आबे। <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />अब्राहम अऊ नाहोर अऊ ओकर ददा के परमेसर ह हमन दूनों के बीच नियाय करय।”</para>
  <para style="p" vid="GEN 31:53">तब याकूब ह अपन ददा इसहाक के भय के नांव म किरिया खाईस। <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />अऊ ओह उहां पहाड़ ऊपर एक बलि चघाईस अऊ अपन रिस्तेदारमन ला जेवन करे बर बलाईस। जेवन करके ओमन उहां रात बिताईन।<verse eid="GEN 31:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55" />ओकर दूसर दिन बड़े बिहनियां लाबान ह उठके अपन नाती-नतनीन अऊ बेटीमन ला चूमिस अऊ ओमन ला आसीस दीस। तब ओह ओमन ला छोंड़के अपन घर लहुंट गीस।<note caller="+" style="f"><char style="fr" closed="false">31:55 </char><char style="ft" closed="false">इबरानी म ये पद ला <char style="xt"><ref loc="GEN 32:1">32:1</ref></char> गने गे हवय</char></note><verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s1">याकूब ह एसाव ले भेंट करे के तियारी करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />याकूब ह घलो अपन डहार धरिस, अऊ परमेसर के स्वरगदूतमन ओकर ले मिलिन। <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />जब याकूब ह ओमन ला देखिस, त ओह कहिस, “येह तो परमेसर के डेरा अय!” एकरसेति ओह ओ जगह के नांव महनैम<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="fq" closed="false">महनैम </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">दू ठन डेरा</char></note> रखिस।<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />याकूब ह सेईर देस याने कि एदोम के देस म, अपन भईया एसाव करा अपन आघू दूतमन ला पठोईस। <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />ओह ओमन ला ये हुकूम दीस, “मोर मालिक एसाव ला तुमन ये कहिहू: ‘तोर दास याकूब ह अइसन कहिथे, मेंह लाबान के संग रहत रहेंव अऊ अब तक उहां रहेंव। <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />मोर करा गरूवा-बईला अऊ गदहा, भेंड़-बकरी, अऊ दास-दासीमन हवंय। में अपन परभू करा एकर खातिर खबर पठोत हंव कि तोर दया-मया मोर ऊपर होवय।’ ”<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />जब ओ दूतमन याकूब करा लहुंटके आईन, त ओमन कहिन, “हमन तोर भईया एसाव करा गे रहेंन, अऊ ओह तोर करा भेंट करे बर आवत हे, अऊ चार सौ मनखे ओकर संग आवत हंय।”<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />याकूब ह अब्बड़ डरा गीस अऊ चिंतित होके ओह अपन मनखेमन ला दू ठन दल म बांट दीस, अऊ वइसने गरूवा-बईला, भेड़-बकरी अऊ ऊंटमन ला घलो दू ठन दल म बांट दीस। <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />ओह सोचिस, “यदि एसाव ह आके एक दल ला मारही, त सायद दूसर दल ह बांच जाही।”<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />तब याकूब ह पराथना करिस, “हे मोर दादा अब्राहम के परमेसर, मोर ददा इसहाक के परमेसर, यहोवा, तेंह तो मोला कहे रहय, ‘अपन देस अऊ अपन रिस्तेदारमन करा लहुंट जा, अऊ मेंह तोला बढ़ाहूं,’ <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />तेंह ओ जम्मो दया अऊ किरपा मोर ऊपर करे हस, में ओकर लईक नो हंव। जब में ये यरदन नदी ला पार करेंव, त मोर करा सिरिप मोर छड़ी रिहिस, पर अब मोर करा दू ठन दल हवय। <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />में बिनती करत हंव कि मोला मोर भईया एसाव के हांथ ले बंचा, काबरकि मोला डर हवय कि ओह आके मोर ऊपर, अऊ लइकामन सहित दाईमन ऊपर घलो हमला करही। <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />पर तेंह कहे रहय, ‘मेंह सही म तोला बढ़ाहूं अऊ तोर संतान ला समुंदर के बालू के सहीं करहूं, जऊन ला गने नइं जा सकय।’ ”<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />ओह ओ रथिया उहां काटिस, अऊ जऊन कुछू ओकर करा रिहिस, ओमा ले ओह अपन भईया एसाव ला देय बर ये भेंट ला छांटके निकालिस: <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />याने कि दू सौ बकरी अऊ बीस ठन बोकरा, दू सौ भेड़ी अऊ बीस ठन मेढ़ा, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />तीस ठन माई ऊंट ओमन के पीला सहित, चालीस ठन गाय अऊ दस ठन बईला, अऊ बीस ठन गदही अऊ दस ठन गदहा। <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />ओह येमन ला दल-दल करके अपन दासमन ला सऊंप दीस अऊ ओमन ला कहिस, “मोर आघू-आघू चलव, अऊ हर एक दल के बीच म कुछू जगह रखव।”<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />जऊन ह सबले आघू के दल म रिहिस, ओला ओह ये हुकूम दीस: “जब मोर भईया एसाव तोर ले मिलही अऊ पुछही, ‘तें काकर दास अस, अऊ कहां जावत हस, अऊ तोर आघू म ये जो जम्मो जानवर जावत हंय, ओमन काकर अंय?’ <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />तब तें ये कहिबे, ‘येमन तोर दास याकूब के अंय। हे मोर मालिक एसाव, येमन तोर बर एक भेंट के रूप म भेजे गे हवंय, अऊ ओह खुद हमर पाछू-पाछू आवत हवय।’ ”<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />याकूब ह दूसर, तीसर अऊ ओ जम्मो झन ला घलो ये हुकूम दीस, जेमन जानवर के दलमन के पाछू-पाछू चलत रिहिन: “जब तुमन एसाव ले मिलहू, त तुमन घलो अइसनेच कहिहू। <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />अऊ ये जरूर कहिहू, ‘तोर दास याकूब ह हमर पाछू-पाछू आवत हे।’ ” काबरकि ओह ये सोचिस, “ये भेंटमन ला आघू भेजके, मेंह ओकर गुस्सा ला सांत कर लूहूं; अऊ बाद म, जब में ओकर ले मिलहूं, त सायद ओह मोला स्वीकार कर ले।” <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />एकरसेति याकूब के मनखेमन भेंट ला आघू लेके गीन, पर ओह खुद डेरा म ओ रथिया काटिस।<verse eid="GEN 32:21" /></para>
  <para style="s1">याकूब ह परमेसर के संग कुस्ती लड़थे</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />ओ रथिया याकूब उठिस अऊ अपन दूनों घरवाली, अपन दूनों दासी अऊ अपन गियारह बेटामन ला लीस अऊ यब्बोक नदी के घाट के ओ पार हो गीस। <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />ओह ओमन ला नदी नहकाय के बाद, अपन जम्मो चीज ला घलो ओ पार भेजवा दीस। <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />याकूब ह एके झन उहां रह गीस, अऊ एक मनखे ह आके बिहान पहात तक ओकर संग कुस्ती लड़िस। <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />जब ओ मनखे ह देखिस कि ओह याकूब ला नइं जीत सकत हे, त ओह याकूब के जांघ के हाड़ा के जोड़ ला छुईस, तब कुस्ती लड़त याकूब के जांघ के हाड़ा ह चढ़ गीस। <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />तब ओ मनखे ह कहिस, “मोला जावन दे, काबरकि बिहान पहा गे हवय।”</para>
  <para style="p" vid="GEN 32:26">पर याकूब ह कहिस, “जब तक तें मोला आसीस नइं देबे, तब तक में तोला जावन नइं दंव।”<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />ओ मनखे ह ओकर ले पुछिस, “तोर का नांव ए?”</para>
  <para style="p" vid="GEN 32:27">ओह जबाब दीस, “याकूब।”<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />तब ओ मनखे ह कहिस, “तोर नांव अब याकूब नइं, पर इसरायल<note caller="+" style="f"><char style="fr" closed="false">32:28 </char><char style="fq" closed="false">इसरायल </char><char style="ft" closed="false">संभवतः येकर मतलब होथे </char><char style="fqa" closed="false">ओह परमेसर संग लड़थे</char></note> होही, काबरकि तें परमेसर अऊ मनखेमन संग कुस्ती लड़े हस अऊ जीते हस।”<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />याकूब ह कहिस, “किरपा करके मोला अपन नांव बता।”</para>
  <para style="p" vid="GEN 32:29">पर ओह कहिस, “तेंह मोर नांव काबर पुछत हस?” तब ओह ओला उहां आसीरबाद दीस।<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />एकरसेति याकूब ह ये कहिके ओ जगह के नांव पनिएल<note caller="+" style="f"><char style="fr" closed="false">32:30 </char><char style="fq" closed="false">पनिएल </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">परमेसर के चेहरा</char></note> रखिस, “परमेसर ला आमने-सामने देखके घलो मोर परान ह बांच गीस।”<verse eid="GEN 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 32:31" />जब ओह पनिएल ले जावत रिहिस, तब बेर निकल गे रिहिस, अऊ ओह जांघ के हाड़ा के कारन खोरवात रिहिस। <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />एकरसेति आज घलो इसरायलीमन जांघ के हाड़ा ला जोड़नेवाला नस ला नइं खावंय, काबरकि ओ मनखे ह याकूब के जांघ के जोड़ के नस के लकठा ला छुये रिहिस।<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s1">याकूब ह एसाव ले भेंट करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />याकूब ह नजर उठाके देखिस कि एसाव चार सौ मनखेमन संग चले आवत हे; एकरसेति ओह लइकामन ला लिआ, राहेल अऊ दूनों दासीमन के बीच म बांट दीस। <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />ओह सबले आघू म दूनों दासी अऊ ओमन के लइकामन ला, ओकर बाद लिआ अऊ ओकर लइकामन ला, अऊ सब के पाछू म राहेल अऊ यूसुफ ला रखिस। <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />ओह खुद आघू-आघू चलिस अऊ जब ओह अपन भईया करा हबरिस, त सात बार भुइयां म गिरके दंडवत करिस।<verse eid="GEN 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4" />पर एसाव ह याकूब संग भेंट करे बर दऊड़िस अऊ ओला छाती ले लगा लीस; ओह ओला बाहां म पोटारके चूमिस। अऊ ओ दूनों रोईन। <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />तब एसाव ह माईलोगन अऊ लइकामन ला देखिस अऊ पुछिस, “तोर संग येमन कोन अंय?”</para>
  <para style="p" vid="GEN 33:5">याकूब ह जबाब दीस, “येमन तोर सेवक के लइकामन अंय, जेमन ला परमेसर ह अनुग्रह करके दे हवय।”<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />तब दासी अऊ ओमन के लइकामन हबरिन अऊ आके दंडवत करिन। <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />फेर लिआ अऊ ओकर लइकामन आईन अऊ दंडवत करिन। सबले आखिरी म यूसुफ अऊ राहेल आईन, अऊ ओमन घलो दंडवत करिन।<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />एसाव ह पुछिस, “ये जो गाय-बईला अऊ भेड़-बकरी के दलमन रसता म मोला मिलिन, एकर का मतलब ए?”</para>
  <para style="p" vid="GEN 33:8">ओह कहिस, “हे मोर मालिक, ये जम्मो चीज एकरसेति अय कि तोर दया मोर ऊपर होवय।”<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />पर एसाव ह कहिस, “हे मोर भाई, मोर करा पहिले ही बहुंत हवय। जऊन कुछू तोर करा हवय, ओह तोरेच रहय।”<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />याकूब ह कहिस, “नइं, नइं! यदि तोर दया मोर ऊपर हवय, त मोर ये भेंट ला गरहन कर। काबरकि तोर चेहरा देखई ह परमेसर के चेहरा देखे सहीं अय, अऊ तेंह मोला खुसी से गरहन करे हस। <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />तोर करा जऊन भेंट लाय गे हे, ओला गरहन कर, काबरकि परमेसर ह मोर ऊपर अनुग्रह करे हवय अऊ मोर करा मोर जरूरत के जम्मो चीज हवय।” अऊ जब याकूब ह बहुंत बिनती करिस, त एसाव ह ओ भेंट ला गरहन कर लीस।<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />फेर एसाव ह कहिस, “आ, अब हमन चलन; में तोर संग चलहूं।”<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />पर याकूब ह ओला कहिस, “हे मोर मालिक, तेंह जानत हस कि मोर संग नान-नान लइकामन हवंय अऊ ओ भेड़ अऊ गायमन के देखभाल करना जरूरी ए, जऊन मन अपन लइकामन ला दूध पीयावत हें। यदि येमन एक दिन भी जादा खेदे जाहीं, त जम्मो के जम्मो पसु मर जाहीं। <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />एकरसेति मोर मालिक ह अपन सेवक के आघू चलय, अऊ मेंह ये पसु जऊन मन मोर आघू म रेंगत हवंय, ओमन के मुताबिक अऊ लइकामन के रेंगई के मुताबिक धीरे-धीरे चलहूं, अऊ सेईर म अपन मालिक करा हबरहूं।”<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />एसाव ह कहिस, “त मोर कुछू मनखेमन ला तोर संग छोंड़ देवत हंव।”</para>
  <para style="p" vid="GEN 33:15">याकूब ह कहिस, “पर अइसने काबर करबे? सिरिप मोर मालिक के दया मोर ऊपर बने रहय, अतकेच ह बहुंत ए।”<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />तब एसाव ह ओही दिन वापिस सेईर जाय बर निकलिस। <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />पर याकूब ह उहां ले सुक्कोत गीस, अऊ उहां अपन बर एक घर अऊ अपन पसुमन बर कोठा बनाईस। एकरसेति ओ जगह के नांव सुक्कोत<note caller="+" style="f"><char style="fr" closed="false">33:17 </char><char style="fq" closed="false">सुक्कोत </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">आसरय</char></note> परिस।<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />याकूब ह पदन-अराम<note caller="+" style="f"><char style="fr" closed="false">33:18 </char><char style="ft" closed="false">याने कि, उत्तर-पछिम मेसोपोटामिया</char></note> ले आय के बाद, कनान के सकेम सहर म सही-सलामत हबरिस अऊ सहर के लकठा म अपन डेरा ठाढ़ करिस। <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />भुइयां के जऊन भाग म, ओह तम्बू गाड़े रिहिस, ओला ओह सकेम के ददा, हमोर के बेटामन के हांथ ले एक सौ चांदी के टुकड़ा म बिसाय रिहिस। <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />उहां ओह एक बेदी बनाईस अऊ ओकर नांव एल-एलोहे-इसरायल<note caller="+" style="f"><char style="fr" closed="false">33:20 </char><char style="fq" closed="false">एल-एलोहे-इसरायल </char><char style="ft" closed="false">के मतलब हो सकथे </char><char style="fqa" closed="false">एल इसरायल के परमेसर ए </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सक्तिसाली ए इसरायल के परमेसर</char></note> रखिस।<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s1">दीना अऊ सकेमीमन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />एक दिन लिआ के बेटी, दीना जेह याकूब ले जनमे रिहिस, ओ देस के छोकरीमन संग भेंट करे बर निकलिस। <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />जब ओ इलाका के हाकिम, हिब्बी हमोर के बेटा सकेम ह ओला देखिस, त ओह ओला ले जाके ओकर संग कुकरम करिस। <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />ओकर दिल ह याकूब के बेटी दीना म लग गीस; ओह ओ जवान छोकरी ले मया करिस अऊ ओकर ले गुरतूर बात करिस। <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />अऊ सकेम ह अपन ददा हमोर ला कहिस, “ये छोकरी ला मोर घरवाली के रूप म लान दे।”<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />जब याकूब ह सुनिस कि ओकर बेटी दीना ह असुध हो गे हे; त ओ समय ओकर बेटामन ओकर पसुमन संग मैदान म रिहिन; एकरसेति ओह ओमन के घर आवत तक, एकर बारे म कुछू नइं करिस।<verse eid="GEN 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />तब सकेम के ददा हमोर ह निकलके याकूब करा बातचीत करे बर आईस। <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />इही बीच म, जइसने ही याकूब के बेटामन ये बात ला सुनिन, त ओमन मैदान ले घर आ गीन। ओमन ला ये बात ला सुनके धक्का लगिस अऊ ओमन बहुंत गुस्सा हो गीन, काबरकि सकेम ह याकूब के बेटी संग कुकरम करके इसरायल के घराना ले गंवारी के काम करे रिहिस—एक अइसने काम, जेला नइं करना रिहिस।<verse eid="GEN 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8" />पर हमोर ह ओमन ला कहिस, “मोर बेटा सकेम ह तोर बेटी ऊपर दिल लगा बईठे हे। किरपा करके अपन बेटी ला मोर बेटा के घरवाली के रूप म देय दे। <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />हमर संग सादी-बिहाव करव; अपन बेटीमन ला हमन ला दव अऊ हमर बेटीमन ला अपन बर लव। <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />तुमन हमर बीच म रह सकत हव; ये देस ह तुम्हर बर खुला हवय। इहां रहव; काम-धंधा करव, अऊ अपन बर इहां संपत्ति बनावव।”<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />तब सकेम ह दीना के ददा अऊ भाईमन ला कहिस, “मोर ऊपर तुमन दया करव, अऊ जऊन कुछू भी तुमन बोलहू, मेंह दूहूं। <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />दुलहिन के जो भी दाम बोलहू, मेंह दूहूं अऊ जतेक बड़े भेंट तुमन पसंद करव, मेंह लानहूं, अऊ जऊन कुछू घलो कहव, मेंह दूहूं। पर ओ जवान छोकरी ला मोर घरवाली होय बर मोला दव।”<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />काबरकि ओमन के बहिनी दीना ह असुध हो गे रिहिस, याकूब के बेटामन सकेम अऊ ओकर ददा हमोर ला छल करके जबाब दीन। <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />ओमन कहिन, “हमन अइसन काम नइं कर सकन; हमन अइसने मनखे ला हमर बहिनी नइं दे सकन, जेकर खतना नइं होय हवय। येह हमर ऊपर एक कलंक होही। <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />हमन तुम्हर संग सिरिप एक सर्त म सहमत होबो अऊ ओ ये अय कि तुम्हर जम्मो पुरूसमन खतना करवाके हमर सहीं हो जावंय। <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />तब हमन अपन बेटीमन ला तुमन ला बिहाव म देबो अऊ तुम्हर बेटीमन ला अपन बर बिहाव म लेबो। हमन तुम्हर बीच म रहिबो अऊ तुम्हर संग एक जात के मनखे हो जाबो। <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />पर यदि तुमन अपन खतना करवाय बर राजी नइं होहू, त हमन अपन बहिनी ला लेके इहां ले चले जाबो।”<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />ओमन के ये बात हमोर अऊ ओकर बेटा सकेम ला बने लगिस। <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />सकेम ह अपन ददा के जम्मो घराना म सबले जादा नामी रिहिस, अऊ ओमन के कहे काम ला करे बर ओह देरी नइं करिस, काबरकि ओह याकूब के बेटी ला अब्बड़ चाहत रिहिस। <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />एकरसेति हमोर अऊ ओकर बेटा सकेम अपन सहर के कपाट करा जाके सहर के मनखेमन ला अइसने समझाय लगिन, <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />“ओ मनखेमन हमर संग संगवारी के रूप म रहे चाहथें; ओमन ला हमर देस म रहिके लेन-देन करन देवन; ये देस म ओमन बर बहुंत जगह हवय। हमन ओमन के बेटीमन ले बिहाव कर सकत हन अऊ ओमन हमर बेटीमन ले बिहाव कर सकथें। <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />पर ओमन सिरिप एक सर्त म हमर संग एक मनखे के रूप म रहे बर तियार हवंय, अऊ ओ ये अय कि ओमन के सहीं हमर जम्मो आदमीमन के खतना होवय। <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />का ओमन के भेड़-बकरी, गाय-बईला, ओमन के धन-संपत्ति अऊ ओमन के जम्मो आने पसुमन हमर नइं हो जाहीं? एकरसेति आवव, हमन ओमन के बात ला मान लेवन, त ओमन हमर संग रहिहीं।”<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />ओ जम्मो मनखे, जऊन मन सहर के कपाट ले बाहिर निकले रिहिन, ओमन हमोर अऊ ओकर बेटा सकेम के बात ला मान लीन, अऊ सहर म हर आदमी के खतना करे गीस।<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />तीन दिन के बाद, जब ओ जम्मो झन पीरा म रिहिन, तब सिमोन अऊ लेवी, याकूब के दू झन बेटा, जेमन दीना के भाई रिहिन, अपन-अपन तलवार लेके सहर के मनखेमन के बिगर जानत हमला कर दीन अऊ जम्मो आदमीमन ला मार डारिन। <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />ओमन हमोर अऊ ओकर बेटा सकेम ला तलवार ले मार डारिन अऊ दीना ला सकेम के घर ले, ले गीन। <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />याकूब के बेटामन लासमन के ऊपर होवत आईन अऊ ओ सहर ला लूट लीन, जिहां ओमन के बहिनी ला असुध करे गे रिहिस। <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />ओमन भेड़-बकरी अऊ गाय-बईला अऊ गदहा अऊ सहर अऊ मैदान के ओमन के जम्मो चीज ला लूट लीन। <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />ओमन उहां के जम्मो संपत्ति अऊ जम्मो माईलोगन अऊ लइकामन ला ले गीन, अऊ उहां के हर घर के सामान ला घलो लूटके ले गीन।<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />तब याकूब ह सिमोन अऊ लेवी ला कहिस, “तुमन ये देस के निवासी कनानी अऊ परिज्जीमन के मन म मोर बर घिन पईदा करे हव, अऊ मोला तुमन संकट म डार दे हव। हमन गनती म थोरकन मनखे हन, अऊ यदि ओमन एक संग आहीं अऊ मोर ऊपर चढ़ई कर दीहीं, त में अऊ मोर घराना नास हो जाही।”<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />पर ओमन कहिन, “का ओला हमर बहिनी संग एक बेस्या के सहीं बरताव करना सही रिहिस?”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s1">याकूब ह बेतेल लहुंटथे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />तब परमेसर ह याकूब ला कहिस, “इहां ले निकलके बेतेल म जा अऊ उहां बस जा, अऊ उहां परमेसर बर एक बेदी बना, जऊन ह तोला ओ समय दरसन दीस, जब तें अपन भाई एसाव ले डरके भागत रहय।”<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />तब याकूब ह अपन घराना अऊ अपन संग के जम्मो झन ला कहिस, “तुमन जऊन पराय देवतामन ला अपन संग रखे हव, ओमन ला निकाल फेंकव, अऊ अपनआप ला सुध करव अऊ अपन कपड़ामन ला बदल डारव। <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />तब आवव, हमन इहां ले निकलके बेतेल जाबो; उहां में परमेसर बर एक ठन बेदी बनाहूं, जऊन ह संकट के दिन म मोर बात सुनिस अऊ जिहां घलो में गेंव, ओह मोर संग म रिहिस।” <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />एकरसेति ओमन अपन जम्मो पराय देवता अऊ अपन कान के कुंडलमन ला याकूब ला दे दीन, अऊ ओह ओ जम्मो ला सकेम म बलूत रूख के खाल्हे म गड़िया दीस। <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />तब ओमन आघू बढ़िन, अऊ ओमन के चारों कोति के नगरमन के निवासी के मन म परमेसर के डर हमा गीस, जेकर कारन कोनो ओमन के पीछा नइं करिन।<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />याकूब अऊ ओकर संग के जम्मो मनखेमन कनान देस के लूज नगर म आईन। लूज ला बेतेल घलो कहे जाथे। <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />उहां ओह एक ठन बेदी बनाईस, अऊ ओ जगह के नांव एल बेतेल<note caller="+" style="f"><char style="fr" closed="false">35:7 </char><char style="fq" closed="false">एल बेतेल </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">बेतेल के परमेसर</char></note> रखिस, काबरकि येह ओ जगह रिहिस, जिहां परमेसर ह ओकर करा परगट होईस, जब ओह अपन भईया के डर ले भागत रिहिस।<verse eid="GEN 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8" />रिबका के धाई दबोरा ह मर गीस, अऊ ओला बेतेल के बाहिर बलूत रूख के खाल्हे म माटी दिये गीस। एकरसेति ओ रूख के नांव अल्लोन-बकूत<note caller="+" style="f"><char style="fr" closed="false">35:8 </char><char style="fq" closed="false">अल्लोन-बकूत </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">रोवइया बांझ रूख</char></note> रखे गीस।<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />याकूब के पदन-अराम ले लहुंटे के बाद, परमेसर ह ओला फेर दरसन देके आसीस दीस। <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />परमेसर ह ओला कहिस, “तोर नांव याकूब<note caller="+" style="f"><char style="fr" closed="false">35:10 </char><char style="fq" closed="false">याकूब </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">ओह एड़ी ला धरथे </char><char style="ft" closed="false">इबरानी भासा के मुहावरा म येकर मतलब होथे </char><char style="fqa" closed="false">ओह धोखा देथे</char></note> ए, पर अब ले तोला याकूब नइं कहे जाय; तोर नांव इसरायल<note caller="+" style="f"><char style="fr" closed="false">35:10 </char><char style="fq" closed="false">इसरायल </char><char style="ft" closed="false">संभवतः येकर मतलब होथे </char><char style="fqa" closed="false">ओह परमेसर के संग लड़थे</char></note> होही।” अऊ परमेसर ह ओकर नांव इसरायल रखिस।<verse eid="GEN 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11" />फेर परमेसर ह ओला कहिस, “में सर्वसक्तिमान<note caller="+" style="f"><char style="fr" closed="false">35:11 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">एल-सद्दाई</char></note> परमेसर अंव; तें फूल-फर अऊ गनती म बढ़। तोर ले एक जाति अऊ जातिमन के एक समुदाय बनही, अऊ तोर बंस म राजामन पईदा होहीं। <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />जऊन देस मेंह अब्राहम अऊ इसहाक ला दे रहेंव, ओला में तोला घलो देवत हंव, अऊ तोर पाछू ये देस तोर बंसमन ला घलो दूहूं।” <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />तब परमेसर जिहां याकूब ले बात करत रिहिस, उहां ले ऊपर चल दीस।<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />जऊन जगह म परमेसर ह याकूब ले बात करे रिहिस, उहां याकूब ह पथरा के एक खंभा ठाढ़ करिस, अऊ ओह ओकर ऊपर पेय-बलिदान के चढ़ावा चघाके तेल घलो डारिस। <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />जऊन मेर परमेसर ह याकूब ले बात करिस, ओ जगह के नांव याकूब ह बेतेल<note caller="+" style="f"><char style="fr" closed="false">35:15 </char><char style="fq" closed="false">बेतेल </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">परमेसर के घर</char></note> रखिस।<verse eid="GEN 35:15" /></para>
  <para style="s1">राहेल अऊ इसहाक के मऊत</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />तब ओमन बेतेल ले आघू बढ़िन। जब ओमन एपराता सहर ले थोरकन दूरिहा म रिहिन, तभे राहेल ला छेवारी होय के बहुंत पीरा होय लगिस। <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />अऊ जब ओला भारी पीरा होय लगिस, तब धाई ह ओला कहिस, “निरास झन हो, काबरकि तोर फेर एक बेटा होय हवय।” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />राहेल के मरे के घरी आ गीस, पर परान छूटत-छूटत ओह अपन बेटा के नांव बेन-ओनी<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="fq" closed="false">बेन-ओनी </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">मोर दुख के बेटा</char></note> रखिस। पर ओकर ददा ह ओकर नांव बिनयामीन<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="fq" closed="false">बिनयामीन </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">मोर जेवनी हांथ के बेटा</char></note> रखिस।<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />ये किसम ले राहेल के मऊत हो गीस अऊ एपराता याने कि बैतलहम के डहार म ओला माटी देय गीस। <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />याकूब ह ओकर कबर ऊपर एक खंभा ठाढ़ करिस, अऊ आज तक ओ खंभा ह राहेल के कबर के चिनहां ए।<verse eid="GEN 35:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21" />इसरायल ह फेर आघू बढ़िस अऊ मिग्दल-एदेर के बाहिर अपन तम्बू ठाढ़ करिस। <verse eid="GEN 35:21" /><verse number="22" style="v" sid="GEN 35:22" />जब इसरायल ह ओ छेत्र म रहत रिहिस, तब एक दिन रूबेन ह जाके अपन ददा के रखैल बिलहा संग कुकरम करिस, अऊ ये बात इसरायल ला पता चल गीस।</para>
  <para style="b" vid="GEN 35:22" />
  <para style="lh" vid="GEN 35:22">याकूब के बारह बेटा रिहिन:<verse eid="GEN 35:22" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="23" style="v" sid="GEN 35:23" />ओमा ले लिआ के बेटा येमन रिहिन:</para>
  <para style="li2" vid="GEN 35:23">याकूब के बड़े बेटा रूबेन,</para>
  <para style="li2" vid="GEN 35:23">फेर सिमोन, लेवी, यहूदा, इस्साकार अऊ जबूलून।<verse eid="GEN 35:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 35:24" />अऊ राहेल के बेटा येमन रिहिन:</para>
  <para style="li2" vid="GEN 35:24">यूसुफ अऊ बिनयामीन।<verse eid="GEN 35:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 35:25" />अऊ राहेल के दासी बिलहा के बेटा येमन रिहिन:</para>
  <para style="li2" vid="GEN 35:25">दान अऊ नपताली।<verse eid="GEN 35:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 35:26" />अऊ लिआ के दासी जिलपा के बेटा येमन रिहिन:</para>
  <para style="li2" vid="GEN 35:26">गाद अऊ आसेर।</para>
  <para style="b" vid="GEN 35:26" />
  <para style="lf" vid="GEN 35:26">येमन याकूब के बेटा रिहिन, जेमन ओकर ले पदन-अराम म जनमिन।<verse eid="GEN 35:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />याकूब अपन ददा इसहाक के घर ममरे म आईस, जऊन ह किरयत-अरबा याने कि हेबरोन के लकठा म हवय; ममरे म अब्राहम अऊ इसहाक परदेसी होके रहे रिहिन। <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />इसहाक के उमर एक सौ अस्सी बछर के होईस। <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />तब ओह आखिरी सांस लीस अऊ मर गीस अऊ डोकरा अऊ पूरा उमर के होके अपन पुरखामन संग जा मिलिस। अऊ ओकर बेटा एसाव अऊ याकूब ओला माटी दीन।<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s1">एसाव के संतानमन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />एसाव जेला एदोम घलो कहे जाथे, ओकर परिवार के बिबरन ये अय।<verse eid="GEN 36:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="GEN 36:2" />एसाव ह कनानी माईलोगनमन ले बिहाव करे रिहिस: याने कि हित्ती एलोन के बेटी आदा, अऊ अना के बेटी ओहोलीबामा, जऊन ह हिब्बी सिबोन के नतनीन रिहिस। <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />अऊ ओह इसमायल के बेटी बासमत ले घलो बिहाव करे रिहिस, जऊन ह नबायोत के बहिनी रिहिस।<verse eid="GEN 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 36:4" />एसाव के घरवाली आदा ह एलीपज ला, अऊ बासमत ह रूएल ला जनम दीस। <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />अऊ ओहोलीबामा ह यूस, यालाम अऊ कोरह ला जनम दीस। एसाव के ये बेटामन कनान देस म पईदा होईन।<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />एसाव ह अपन घरवाली अऊ बेटा-बेटी अऊ घर के जम्मो मनखेमन, अऊ अपन भेड़-बकरी अऊ गाय-बईला अऊ जम्मो दूसर पसुमन अऊ कनान देस म कमाय जम्मो संपत्ति ला लीस, अऊ अपन भाई याकूब करा ले एक-दूसर देस म चल दीस। <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />काबरकि ओमन के धन-संपत्ति अतेक हो गे रिहिस कि ओमन एक संग नइं रहे सकिन; ओमन करा अतेक पसु हो गे रिहिन कि जिहां ओमन रहत रिहिन, उहां ओमन के चारा-पानी के परबंध नइं हो सकत रिहिस। <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />एकरसेति एसाव याने कि एदोम ह सेईर नांव के पहाड़ी देस म रहे लगिस।<verse eid="GEN 36:8" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="9" style="v" sid="GEN 36:9" />सेईर नांव के पहाड़ी देस म रहइया एदोमीमन के पुरखा एसाव के बंसावली ये अय।<verse eid="GEN 36:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="GEN 36:10" />एसाव के बेटामन के नांव ये अय:</para>
  <para style="li2" vid="GEN 36:10">एसाव के घरवाली आदा के बेटा एलीपज, अऊ एसाव के घरवाली बासमत के बेटा रूएल।<verse eid="GEN 36:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 36:11" />एलीपज के बेटामन:</para>
  <para style="li2" vid="GEN 36:11">तेमान, ओमार, सपो, गाताम अऊ कनज। <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />एसाव के बेटा एलीपज के तिमना नांव के एक रखैल रिहिस, जेह एलीपज कोति ले अमालेक ला जनम दीस। एसाव के घरवाली आदा के नाती येमन होईन।<verse eid="GEN 36:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 36:13" />रूएल के बेटामन:</para>
  <para style="li2" vid="GEN 36:13">नहत, जेरह, सम्मा, अऊ मिज्जा। एसाव के घरवाली बासमत के नाती येमन होईन।<verse eid="GEN 36:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 36:14" />एसाव के घरवाली ओहोलीबामा, जऊन ह अना के बेटी अऊ सिबोन के नतनीन रिहिस, ओह एसाव कोति ले ये बेटामन ला जनम दीस:</para>
  <para style="li2" vid="GEN 36:14">यूस, यालाम अऊ कोरह।<verse eid="GEN 36:14" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="15" style="v" sid="GEN 36:15" />एसाव के बंस म येमन मुखिया होईन:</para>
  <para style="li1" vid="GEN 36:15">एसाव के पहिलांत बेटा एलीपज के बेटामन:</para>
  <para style="li2" vid="GEN 36:15">मुखियामन—तेमान, ओमार, सपो, कनज, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />कोरह, गाताम अऊ अमालेक। एलीपज के बंस म ले, एदोम देस म येमन मुखिया होईन अऊ येमन आदा के नाती रिहिन।<verse eid="GEN 36:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 36:17" />एसाव के बेटा रूएल के बेटामन:</para>
  <para style="li2" vid="GEN 36:17">मुखियामन—नहत, जेरह, सम्मा, मिज्जा। रूएल के बंस म ले, एदोम देस म येमन मुखिया होईन अऊ येमन एसाव के घरवाली बासमत के नाती रिहिन।<verse eid="GEN 36:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 36:18" />एसाव के घरवाली ओहोलीबामा के बेटामन:</para>
  <para style="li2" vid="GEN 36:18">मुखियामन—यूस, यालाम, कोरह। एसाव के घरवाली ओहोलीबामा, जेह अना के बेटी रिहिस, ओकर बंस म येमन मुखिया होईन।<verse eid="GEN 36:18" /></para>
  <para style="lf">
    <verse number="19" style="v" sid="GEN 36:19" />एसाव याने कि एदोम के बेटामन येमन रिहिन, अऊ येमन ओमन के मुखिया रिहिन।<verse eid="GEN 36:19" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="20" style="v" sid="GEN 36:20" />सेईर, जऊन ह होरी जाति के रिहिस, ओकर ये बेटामन ओ इलाका म रहत रिहिन:</para>
  <para style="li2" vid="GEN 36:20">लोतान, सोबाल, सिबोन, अना, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />दीसोन, एसेर अऊ दीसान। एदोम देस म, सेईर के येमन ही होरी जाति के मुखिया होईन।<verse eid="GEN 36:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 36:22" />लोतान के बेटामन:</para>
  <para style="li2" vid="GEN 36:22">होरी अऊ होमाम।<note caller="+" style="f"><char style="fr" closed="false">36:22 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">हेमाम </char><char style="ft" closed="false">येह </char><char style="fq" closed="false">होमाम </char><char style="ft" closed="false">के आने नांव ए (देखव <char style="xt"><ref loc="1CH 1:39">1 इति 1:39</ref>)</char></char></note> तिमना ह लोतान के बहिनी रिहिस।<verse eid="GEN 36:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 36:23" />सोबाल के बेटामन:</para>
  <para style="li2" vid="GEN 36:23">आलवान, मानहत, एबाल, सपो अऊ ओनाम।<verse eid="GEN 36:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 36:24" />सिबोन के बेटामन:</para>
  <para style="li2" vid="GEN 36:24">अय्या अऊ अना। येह ओही अना अय, जेला सुन्ना जगह म अपन ददा सिबोन के गदहामन ला चरात बेरा गरम पानी के झरना मिलिस।<verse eid="GEN 36:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 36:25" />अना के लइकामन:</para>
  <para style="li2" vid="GEN 36:25">अना के दीसोन<note caller="+" style="f"><char style="fr" closed="false">36:25 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">दीसान </char><char style="ft" closed="false">जऊन ह </char><char style="fq" closed="false">दीसोन </char><char style="ft" closed="false">के आने नांव ए</char></note> नांव के बेटा अऊ ओहोलीबामा नांव के बेटी होईस।<verse eid="GEN 36:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 36:26" />दीसोन के बेटामन:</para>
  <para style="li2" vid="GEN 36:26">हेमदान, एसबान, यितरान अऊ करान।<verse eid="GEN 36:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="GEN 36:27" />एसेर के बेटामन:</para>
  <para style="li2" vid="GEN 36:27">बिलहान, जाबान अऊ अकान।<verse eid="GEN 36:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="GEN 36:28" />दीसान के बेटामन:</para>
  <para style="li2" vid="GEN 36:28">ऊस अऊ अरान।<verse eid="GEN 36:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="GEN 36:29" />होरी जाति के मुखिया येमन होईन:</para>
  <para style="li2" vid="GEN 36:29">लोतान, सोबाल, सिबोन, अना, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />दीसोन, एसेर, दीसान।</para>
  <para style="lf" vid="GEN 36:30">सेईर के देस म, अपन दल के मुताबिक येमन होरी जाति के मुखिया रिहिन।<verse eid="GEN 36:30" /></para>
  <para style="s1">एदोम के राजामन</para>
  <para style="lh">
    <verse number="31" style="v" sid="GEN 36:31" />कोनो इसरायली राजा के एदोम म राज करे के पहिली, येमन ओ राजा रिहिन, जेमन एदोम म राज करिन:<verse eid="GEN 36:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="GEN 36:32" />बेओर के बेटा बेला ह एदोम के राजा बनिस। ओकर सहर के नांव दिनहाबा रखे गीस।<verse eid="GEN 36:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="GEN 36:33" />बेला के मरे के बाद, बोसरा के रहइया जेरह के बेटा योबाब ओकर जगह म राजा बनिस।<verse eid="GEN 36:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="GEN 36:34" />योबाब के मरे के बाद, तेमानीमन के देस के हूसाम ओकर जगह म राजा होईस।<verse eid="GEN 36:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="GEN 36:35" />जब हूसाम ह मर गीस, त बदद के बेटा हदद ह ओकर जगह म राजा होईस: येह ओही अय, जऊन ह मोआब के देस म मिदयानीमन ला हराईस। ओकर सहर के नांव अबीत रखे गीस।<verse eid="GEN 36:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="GEN 36:36" />हदद के मरे के बाद, मसरेका नगर के रहइया समला ह ओकर जगह म राजा होईस।<verse eid="GEN 36:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="GEN 36:37" />जब समला ह मर गीस, त साऊल ह ओकर जगह म राजा होईस, जेह नदी के तीर म बसे रहोबोत नगर के रिहिस।<verse eid="GEN 36:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="GEN 36:38" />साऊल के मरे के बाद, अकबोर के बेटा बाल-हानान ओकर जगह म राजा होईस।<verse eid="GEN 36:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="GEN 36:39" />अकबोर के बेटा बाल-हानान के मरे के बाद, ओकर जगह म हदद राजा होईस। ओकर सहर के नांव पाऊ रखे गीस, अऊ ओकर घरवाली के नांव महेतबेल रिहिस, जऊन ह मतरेद के बेटी अऊ मे-जाहब के नतनीन रिहिस।<verse eid="GEN 36:39" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="40" style="v" sid="GEN 36:40" />अपन कुल अऊ इलाका के मुताबिक एसाव के बंस के मुखियामन के नांव ये रिहिस:</para>
  <para style="li1" vid="GEN 36:40">तिमना, अलबा, यतेत,<verse eid="GEN 36:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="GEN 36:41" />ओहोलीबामा, एला, पीनोन,<verse eid="GEN 36:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="GEN 36:42" />कनज, तेमान, मिबसार,<verse eid="GEN 36:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="GEN 36:43" />मगदीएल अऊ ईराम।</para>
  <para style="lf" vid="GEN 36:43">देस म कब्जा करे के बाद, अपन-अपन जगह के मुताबिक येमन एदोम के मुखिया रिहिन।</para>
  <para style="b" vid="GEN 36:43" />
  <para style="lf" vid="GEN 36:43">येह एसाव के बंसावली अय, जेह एदोमीमन के पुरखा अय।<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s1">यूसुफ के सपना</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />याकूब तो कनान देस म रहत रिहिस, जिहां ओकर ददा रहत रिहिस।<verse eid="GEN 37:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2" />याकूब के परिवार के बिबरन ये अय।</para>
  <para style="b" vid="GEN 37:2" />
  <para style="p" vid="GEN 37:2">यूसुफ सतरह बछर के एक जवान रिहिस अऊ अपन भाईमन संग भेड़-बकरी चरात रिहिस; ओकर ये भाईमन ओकर ददा के घरवाली बिलहा अऊ जिलपा के बेटामन रिहिन; अऊ यूसुफ ह अपन भाईमन के खराप काम के खबर अपन ददा ला बताय करय।<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />इसरायल ह यूसुफ ला अपन जम्मो दूसर बेटामन ले जादा मया करय, काबरकि ओह ओकर बुढ़त काल म जनमे रिहिस; अऊ इसरायल ह ओकर बर एक रंग-बिरंगा अंगरखा बनाय रिहिस। <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />जब ओकर भाईमन देखिन कि ओमन के ददा ह ओ जम्मो झन ले जादा यूसुफ ले मया करथे, त ओमन ओकर ले नफरत करे लगिन अऊ ओकर ले ठीक से बात घलो नइं करत रिहिन।<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />यूसुफ ह एक सपना देखिस, अऊ जब ओकर बारे म, ओह अपन भाईमन ला बताईस, त ओमन ओकर ले अऊ नफरत करे लगिन। <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />ओह ओमन ला कहिस, “जऊन सपना मेंह देखे हंव, ओला सुनव: <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />हमन खेत म अनाज के बीड़ा बांधत रहेंन, त मेंह देखेंव कि मोर बीड़ा ह उठके ठाढ़ हो गीस, जबकि तुम्हर बीड़ामन मोर बीड़ा के चारों कोति जूर गीन अऊ ओला दंडवत करिन।”<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />ओकर भाईमन ओला कहिन, “का तेंह हमर ऊपर राज करे के इरादा करत हस? का तेंह सही म हमर ऊपर राज करबे?” यूसुफ के सपना अऊ ओह जऊन कुछू कहिस, ओकर कारन ओमन ओकर ले अऊ जादा नफरत करे लगिन।<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />तब ओह एक ठन अऊ सपना देखिस, अऊ अपन भाईमन ला ये सपना के बारे म घलो बताईस। ओह कहिस, “सुनव, मेंह एक अऊ सपना देखे हंव, अऊ ये बखत सूरज अऊ चंदा अऊ गियारह तारामन मोला दंडवत करत रिहिन।”<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />जब ओह अपन सपना के बारे म अपन भाईमन ला अऊ फेर अपन ददा ला बताईस, त ओकर ददा ह ओला घुड़कके कहिस, “ये का सपना तेंह देखे हस? का सच म, तोर दाई अऊ में अऊ तोर भाईमन आबो अऊ तोर आघू म भुइयां म गिरके तोला दंडवत करबो?” <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />ओकर भाईमन ओकर ले जलन करे लगिन, पर ओकर ददा ह ये बात ला अपन मन म रखिस।<verse eid="GEN 37:11" /></para>
  <para style="s1">यूसुफ ला ओकर भाईमन बेच देथें</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />यूसुफ के भाईमन अपन ददा के भेड़-बकरीमन ला चराय बर सकेम के लकठा म गे रिहिन, <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />तब इसरायल ह यूसुफ ला कहिस, “जइसे कि तेंह जानथस, तोर भाईमन सकेम के लकठा म भेड़-बकरी चरावत हंय। एकरसेति आ, में तोला ओमन करा पठोहूं।”</para>
  <para style="p" vid="GEN 37:13">त ओह जबाब दीस, “बने बात ए।”<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />तब इसरायल ह ओला कहिस, “जा अऊ देख कि तोर भाई अऊ भेड़-बकरीमन कइसन हवंय, अऊ आके मोला ओमन के खबर बता।” तब ओह ओला हेबरोन के घाटी म ले पठोईस।</para>
  <para style="p" vid="GEN 37:14">जब यूसुफ ह सकेम हबरिस, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />त एक मनखे ह ओला मैदान म एती-ओती भटकत देखके ओकर ले पुछिस, “तेंह का खोजत हस?”<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />ओह कहिस, “मेंह अपन भाईमन ला खोजत हंव। का तें मोला बता सकत हस कि ओमन अपन भेड़-बकरीमन ला कहां चरात हवंय?”<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />ओ मनखे ह जबाब दीस, “ओमन इहां ले चल दीन हंय, अऊ मेंह ओमन ला ये कहत सुने हंव, ‘आवव, हमन दोतान जाबो।’ ”</para>
  <para style="p" vid="GEN 37:17">एकरसेति यूसुफ अपन भाईमन के पाछू गीस, अऊ ओमन ला दोतान के लकठा म पाईस। <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />एकर पहिली कि ओह अपन भाईमन करा हबरतिस, ओकर भाईमन ओला दूरिहा ले आवत देख डारिन, अऊ ओला मार डारे के उपाय करिन।<verse eid="GEN 37:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 37:19" />ओमन आपस म कहे लगिन, “देखव, ओ सपना देखइया आवत हे। <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />आवव, हमन ओला मारके कोनो खंचवा म फटिक दन अऊ ये कहन कि कोनो हिंसक पसु ओला मारके खा लीस। तब हमन देखबो कि ओकर सपना के का होथे।”<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />जब रूबेन ह ये बात ला सुनिस, त ओह ओला ओमन के हांथ ले बंचाय के बिचार करिस अऊ कहिस, “हमन ओकर परान नइं लेवन; <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />लहू झन बहावव। ओला इहां सुन्ना जगह के ये खंचवा म फटिक दव, पर ओकर ऊपर हांथ झन उठावव।” रूबेन ह ओला ओमन के हांथ ले बचाके अपन ददा करा वापिस लाने चाहत रिहिस।<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />एकरसेति जब यूसुफ अपन भाईमन करा हबरिस, तब ओमन ओकर रंग-बिरंगा अंगरखा ला उतार लीन, जेला ओह पहिरे रिहिस, <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />अऊ ओमन ओला लेके खंचवा म फटिक दीन; ओ खंचवा ह खाली रिहिस अऊ ओमा पानी नइं रिहिस।<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />जब ओमन रोटी खाय बर बईठिन, त देखिन कि इसमायलीमन के एक दल ह गिलाद ले आवत रहय। ओमन के ऊंटमन ऊपर मसाला, मलहम अऊ गंधरस लदाय रहय, अऊ ओमन ओला लेके मिसर देस जावत रिहिन।<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />तब यहूदा ह अपन भाईमन ला कहिस, “अपन भाई ला मारके ओकर खून ला छुपाय ले हमन ला का फायदा होही? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />आवव, हमन ओला इसमायलीमन के हांथ म बेच देवन अऊ अपन हांथ ओकर ऊपर झन उठावन; काबरकि ओह हमर भाई, हमर अपन मांस अऊ खून अय।” अऊ ओकर भाईमन ओकर बात ला मान लीन।<verse eid="GEN 37:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 37:28" />एकरसेति जब मिदयानी बेपारीमन ओमन के लकठा म हबरिन, त यूसुफ के भाईमन ओला खंचवा ले बाहिर निकालिन अऊ इसमायलीमन के हांथ म चांदी के बीस सेकेल<note caller="+" style="f"><char style="fr" closed="false">37:28 </char><char style="ft" closed="false">लगभग 230 ग्राम</char></note> म बेच दीन, अऊ ओमन यूसुफ ला मिसर देस ले गीन।<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />जब रूबेन ह खंचवा करा लहुंटिस अऊ देखिस कि यूसुफ ह उहां नइं ए, त दुखी होके ओह अपन ओनहा ला चीरिस, <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />अऊ अपन भाईमन करा वापिस जाके कहिस, “छोकरा तो उहां नइं ए! अब में कहां जावंव?”<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />तब ओमन यूसुफ के अंगरखा ला लीन, अऊ एक ठन बोकरा ला मारके ओकर लहू म ओला बोर दीन। <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />ओमन ओ रंग-बिरंगा अंगरखा ला अपन ददा करा वापिस ले जाके कहिन, “येह हमन ला मिले हे। तेंह जांचके देख ले कि येह तोर बेटा के अय कि नइं।”<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />ओह ओला चिन डारिस अऊ कहिस, “येह तो मोर बेटा के अंगरखा ए! कोनो हिंसक पसु ह ओला मारके खा डारिस। सही म, यूसुफ के कुटा-कुटा कर दे गे हवय।”<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />तब याकूब ह दुख म अपन ओनहा ला चीरिस, बोरा ला पहिरिस अऊ अपन बेटा बर अब्बड़ दिन ले दुख मनाईस। <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />ओकर जम्मो बेटा-बेटीमन ओला सांति देय बर आईन, पर ओला सांति नइं मिलिस। ओह कहिस, “नइं, मेंह तब तक दुख मनात रहिहूं, जब तक में अपन बेटा करा कबर म माटी नइं पा जावंव।” ये किसम ले ओकर ददा ह ओकर बर रोते रिहिस।<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />ये बीच म, मिदयानीमन यूसुफ ला मिसर देस ले जाके पोतीफर के हांथ म बेच दीन। पोतीफर ह फिरौन राजा के एक हाकिम याने कि राजा के अंगरछकमन के मुखिया रिहिस।<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s1">यहूदा अऊ तामार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />ओ समय अइसन होईस कि यहूदा ह अपन भाईमन करा ले चल दीस अऊ हीरा नांव के अदुल्लाम गांव के रहइया मनखे करा रहे लगिस। <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />उहां यहूदा ह सूआ नांव के कनानी मनखे के बेटी ला देखिस; अऊ ओकर ले बिहाव करके ओकर संग सुतिस। <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />ओह आसरा म होके एक बेटा ला जनम दीस, जेकर नांव एर रखे गीस। <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />ओह फेर आसरा म होईस अऊ एक बेटा ला जनम दीस अऊ ओह ओकर नांव ओनान रखिस। <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />ओह एक अऊ बेटा ला जनमिस, जेकर नांव सेलह रखे गीस। जऊन समय एकर जनम होईस, ओ समय यहूदा ह कजीब म रहत रिहिस।<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />यहूदा ह तामार नांव के एक माईलोगन ले अपन बड़े बेटा एर के बिहाव कर दीस। <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />पर यहूदा के बड़े बेटा एर ह यहोवा के नजर म दुस्ट मनखे रिहिस; एकरसेति यहोवा ह ओला मार डारिस।<verse eid="GEN 38:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8" />तब यहूदा ह ओनान ला कहिस, “अपन भौजी संग सुत अऊ ओकर संग देवर के धरम पूरा करके अपन भाई बर संतान पईदा कर।” <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />पर ओनान जानत रिहिस कि जऊन संतान जनमही, ओह ओकर नइं होवय; एकरसेति ओह जब भी अपन भौजी संग सुते, त अपन बीर्य ला ओह भुइयां म गिरा दे, ताकि ओकर भाई के नांव ले कोनो संतान झन होवय। <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />जऊन कुछू ओह करत रिहिस, ओह यहोवा के नजर म दुस्टता के काम रिहिस, एकरसेति यहोवा ह ओला घलो मार डारिस।<verse eid="GEN 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11" />तब यहूदा ह ये सोचके कि कहूं सेलह ह घलो अपन भाईमन सहीं मर न जावय, अपन बहू तामार ले कहिस, “जब तक मोर बेटा सेलह जवान नइं हो जावय, तब तक तें अपन ददा के घर म बिधवा के रूप म रह।” एकरसेति तामार ह अपन ददा के घर म जाके रहे लगिस।<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />बहुंत समय के बाद, यहूदा के घरवाली याने कि सूआ के बेटी मर गीस। जब यहूदा ह दुख ला भुला गीस, त ओह अपन भेड़ के ऊन कतरइयामन करा तिमना नगर गीस, अऊ संग म अपन संगी अदुल्लाम के रहइया हीरा ला घलो ले गीस।<verse eid="GEN 38:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13" />जब तामार ला ये खबर मिलिस, “तोर ससुर ह अपन भेड़मन के ऊन कतरे बर तिमना जावथे।” <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />त ओह अपन बिधवा के पहिरावा ला उतारिस अऊ घूंघट डारके अपन ला ढांप लीस, अऊ एनैम नगर के कपाट करा जाके बईठ गीस, जेह तिमना के डहार म हवय। काबरकि ओह देख डारे रिहिस कि सेलह ह जवान हो गे हवय, पर ओला ओकर घरवाला बने बर नइं दिये गे हवय।<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />जब यहूदा ह ओला देखिस, त ओह ओला बेस्या समझिस, काबरकि ओह अपन मुहूं ला ढांपे रिहिस। <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />ये बिगर जाने कि ओह ओकर बहू अय, यहूदा ह ओकर करा सड़क-तीर म गीस अऊ ओला कहिस, “आ, मोला तोर संग सुतन दे।”</para>
  <para style="p" vid="GEN 38:16">ओह पुछिस, “तोर संग सुते के बदले, तें मोला का देबे?”<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />ओह कहिस, “में अपन छेरी के झुंड म ले एक ठन छेरी-पीला तोर मेर पठो दूहूं।”</para>
  <para style="p" vid="GEN 38:17">तब ओह पुछिस, “ओला भेजत तक, का तेंह मोला गिरवी के रूप म कुछू देबे?”<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />यहूदा ह कहिस, “गिरवी के रूप म, तोला में का दंव?”</para>
  <para style="p" vid="GEN 38:18">ओह जबाब दीस, “तोर मुहर अऊ एकर डोरी, अऊ अपन हांथ म धरे लउठी।” तब ओह ओ चीजमन ला ओला दे दीस अऊ ओकर संग सुतिस, अऊ ओह ओकर कोति ले आसरा म होईस। <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />उहां ले जाय के बाद, ओह अपन घूंघट ला उतार दीस अऊ फेर अपन बिधवा के ओनहा ला पहिर लीस।<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />ये बीच म, यहूदा ह अदुल्लाम के रहइया, अपन संगी के हांथ म एक ठन छेरी-पीला पठो दीस, ताकि ओह ओ माईलोगन ले ओकर गिरवी रखे चीजमन ला ले आवय, पर ओला ओ माईलोगन नइं मिलिस। <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />ओह उहां रहइया मनखेमन ले पुछिस, “ओ मंदिर के बेस्या कहां हवय, जऊन ह एनैम के सड़क-तीर म बईठे रिहिस?”</para>
  <para style="p" vid="GEN 38:21">ओमन कहिन, “इहां कोनो मंदिर के बेस्या नइं रिहिस।”<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />एकरसेति ओह यहूदा करा वापिस जाके कहिस, “मोला ओह नइं मिलिस; अऊ उहां रहइया मनखेमन कहिन, ‘इहां कोनो मंदिर के बेस्या नइं रिहिस।’ ”<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />तब यहूदा ह कहिस, “ओला ओ चीजमन ला रखन दे, नइं तो हमर हंसी उड़ाय जाही। मेंह तो ये छेरी-पीला ला ओकर करा पठोय रहेंव, पर ओह तोला नइं मिलिस।”<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />करीब तीन महिना के बाद, यहूदा ला ये बताय गीस, “तोर बहू तामार ह बेभिचार करे हवय, अऊ ओकर कारन से ओह आसरा म हवय।”</para>
  <para style="p" vid="GEN 38:24">यहूदा ह कहिस, “ओला बाहिर लानव अऊ जलाके ओला मार डारव!”<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />जब ओला बाहिर लाने जावत रिहिस, त ओह अपन ससुर करा ये खबर पठोईस, “जऊन मनखे के ये चीजमन अंय, ओकरे कोति ले मेंह आसरा म हंव,” ओह ये घलो कहे रिहिस, “देख अऊ चिन ले कि ये मुहर अऊ डोरी अऊ लउठी काकर अंय।”<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />यहूदा ह ओ चीजमन ला चिन डारिस अऊ कहिस, “ओह तो मोर ले कम दोसी अय, काबरकि मेंह ओकर बिहाव अपन बेटा सेलह के संग नइं करेंव।” अऊ ओह ओकर संग फेर कभू नइं सुतिस।<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />जब ओकर छेवारी होय के बेरा आईस, त पता चलिस कि ओकर कोख म जुड़वां लइकामन हवंय। <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />जब ओह छेवारी होवत रिहिस, त एक लइका के हांथ ह बाहिर आईस; एकरसेति धाय ह लाल सुत लेके ओ लइका के कलई म बांध दीस अऊ कहिस, “येह पहिली जनमिस।” <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />पर जब ओ लइका ह अपन हांथ ला भीतर तीर लीस, त ओकर भाई ह जनमिस, तब ओ धाय ह कहिस, “ये किसम ले, तेंह जबरदस्ती निकल आय!” अऊ ओकर नांव पेरेस<note caller="+" style="f"><char style="fr" closed="false">38:29 </char><char style="fq" closed="false">पेरेस </char><char style="ft" closed="false">के मतलब होथे </char><char style="fqa" closed="false">जबरन निकलई</char></note> रखे गीस। <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />तब ओकर भाई, जेकर कलई म सिन्दूरी सूंत बंधाय रिहिस, जनमिस। अऊ ओकर नांव जेरह<note caller="+" style="f"><char style="fr" closed="false">38:30 </char><char style="fq" closed="false">जेरह </char><char style="ft" closed="false">के मतलब होथे </char><char style="fq" closed="false">सिन्दूरी </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">चमकीला</char></note> रखे गीस।<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s1">यूसुफ अऊ पोतीफर के घरवाली</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />जब यूसुफ ला मिसर देस म लाय गीस, त पोतीफर नांव के एक मिसरी, जेह फिरौन के एक हाकिम याने कि अंगरछकमन के मुखिया रिहिस, ओला ओ इसमायलीमन करा ले बिसा लीस, जेमन ओला उहां लाने रिहिन।<verse eid="GEN 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2" />यूसुफ ह अपन मिसरी मालिक के घर म रहत रिहिस, अऊ यहोवा ह ओकर संग रिहिस, एकरसेति ओह उन्नति करत गीस। <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />जब यूसुफ के मालिक ह देखिस कि यहोवा ओकर संग रहिथे अऊ जऊन काम ओह करथे, यहोवा ह ओमा ओला सफल करथे, <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />त ओकर किरपा के नजर यूसुफ ऊपर होईस अऊ यूसुफ ला ओकर सेवा-टहल करे बर ठहिराय गीस। पोतीफर ह ओला अपन घर के जिम्मा देके अपन जम्मो चीज ला ओकर भरोसा म छोंड़ दीस। <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />जब ले ओह अपन घर के जिम्मा अऊ अपन सबो चीज ला ओकर भरोसा म कर दीस, तब ले यहोवा ह यूसुफ के कारन ओ मिसरी के घर म आसीस देय लगिस। पोतीफर के जम्मो चीज म, ओकर घर अऊ खेत दूनों म यहोवा के आसीस होय लगिस। <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />एकरसेति पोतीफर ह अपन जम्मो चीज ला यूसुफ के देखरेख म कर दीस, इहां तक कि यूसुफ के कारन अपन खाय के रोटी के छोंड़, ओह अपन कोनो चीज के फिकर नइं करत रिहिस।</para>
  <para style="p" vid="GEN 39:6">यूसुफ ह सुन्दर अऊ ओकर कद-काठी बहुंत बढ़िया रिहिस, <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />कुछू समय के बाद, ओकर मालिक के घरवाली ह यूसुफ ऊपर नजर लगाईस अऊ कहिस, “आ, मोर संग सुत!”<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />पर ओह इनकार करके अपन मालिक के घरवाली ला कहिस, “जम्मो चीज ला मोर जिम्मा म देके, मोर मालिक ह घर म कोनो चीज के फिकर नइं करय; जऊन कुछू ओकर हवय, ओ जम्मो ला मोर भरोसा म छोंड़ दे हवय। <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />ये घर म मोर ले बड़े कोनो नइं ए। ओह तोला छोंड़, अपन करा अऊ कुछू नइं रखे हे, काबरकि तें ओकर घरवाली अस। तब में अइसन दुस्ट काम करके परमेसर के बिरूध म कइसे पाप कर सकथंव?” <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />अऊ हालाकि ओह रोज-रोज यूसुफ ले बात करय, पर यूसुफ ह ओकर संग सुते बर इनकार करय, अऊ त अऊ ओकर संग रहे बर घलो नइं चाहय।<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />एक दिन अइसन होईस कि यूसुफ ह अपन काम-धाम करे बर घर भीतर गीस, अऊ घर के कोनो सेवक भीतर म नइं रिहिन। <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />तब ओ माईलोगन ह ओकर ओनहा ला धरके कहिस, “मोर संग सुत!” पर ओह अपन ओनहा ला ओकर हांथ म छोंड़के घर के बाहिर भाग गीस।<verse eid="GEN 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13" />जब ओ माईलोगन ह ये देखिस कि ओह अपन ओनहा ला ओकर हांथ म छोंड़के घर के बाहिर भाग गे हे, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />त ओह अपन घर के सेवकमन ला बलाके कहिस, “देखव, ओ इबरी मनखे ला मसखरी करे बर इहां लाने गे हवय! ओह तो इहां मोर संग सुते के मतलब से भीतर आय रिहिस, पर में जोर से नरियांय। <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />मदद खातिर जब ओह मोर नरियाई ला सुनिस, त ओह अपन ओनहा ला मोर करा छोंड़के घर के बाहिर भाग गीस।”<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />ओह ओकर ओनहा ला ओकर मालिक के घर आवत तक अपन करा रखे रिहिस। <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />जब ओह आईस, त ओला ये कहानी बताईस, “ओ इबरी दास, जेला तें हमर करा लाने हस, ओह मोर करा मसखरी करे बर आय रिहिस। <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />पर जब में मदद खातिर नरियांय, त ओह अपन ओनहा मोर करा छोंड़के घर के बाहिर भाग गीस।”<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />जब ओकर मालिक ह अपन घरवाली के ये बातमन ला सुनिस, “तोर दास ह मोर संग अइसन बेवहार करे हवय।” त ओह गुस्सा के मारे भड़क गीस। <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />यूसुफ के मालिक ह ओला पकड़के जेलखाना म डार दीस, जिहां राजा के कैदीमन बंद रिहिन।</para>
  <para style="p" vid="GEN 39:20">पर जब यूसुफ ह जेलखाना म रिहिस, <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />त यहोवा ह ओकर संग रिहिस। ओह ओकर ऊपर दया करिस, जेकर कारन जेलखाना के दरोगा के किरपा यूसुफ ऊपर होईस। <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />एकरसेति जेलखाना के दरोगा ह यूसुफ ला उहां जम्मो कैदीमन के मुखिया बना दीस, अऊ जऊन काम-बुता उहां करे जावत रिहिस, ओकर जिम्मेदारी घलो यूसुफ ला दे दीस। <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />यूसुफ के देखरेख म जऊन कुछू रिहिस, ओमा के कोनो बात के फिकर दरोगा ला नइं रिहिस, काबरकि यहोवा ह यूसुफ के संग रिहिस अऊ जऊन कुछू यूसुफ ह करय, ओ जम्मो म ओला सफल करत रिहिस।<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s1">पीयानेवाला अऊ पकानेवाला</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />कुछू समय बाद, अइसन होईस कि मिसर के राजा के पीयानेवाला अऊ जेवन पकानेवाला अपन मालिक, राजा के बिरूध म कुछू अपराध करिन। <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />फिरौन ह अपन ओ दूनों हाकिम याने कि पीयानेवालामन के मुखिया अऊ रंधइयामन के मुखिया ऊपर नराज होईस, <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />अऊ ओमन ला पकड़के अंगरछकमन के मुखिया के घर के ओही जेलखाना म डलवा दीस, जिहां यूसुफ कैदी रिहिस। <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />तब अंगरछकमन के मुखिया ह ओमन ला यूसुफ के हांथ म सऊंप दीस, अऊ ओह ओमन के देखरेख करे लगिस।</para>
  <para style="p" vid="GEN 40:4">ओमन के कुछू समय तक जेलखाना म रहे के बाद, <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />ओमा के दूनों मनखे—मिसर के राजा के पीयानेवाला अऊ रंधइया, जेमन जेलखाना म बंद रिहिन—एके रात म सपना देखिन, अऊ हर सपना के अलग-अलग मतलब रिहिस।<verse eid="GEN 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 40:6" />बिहनियां जब यूसुफ ओमन करा आईस, त देखिस कि ओमन उदास हवंय। <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />एकरसेति फिरौन के ओ अधिकारीमन ला, जेमन ओकर संग ओकर मालिक के घर<note caller="+" style="f"><char style="fr" closed="false">40:7 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">जेलखाना</char></note> म बंद रिहिन, यूसुफ ह पुछिस, “आज तुम्हर मुहूं काबर उतरे हवय?”<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />ओमन जबाब दीन, “हमन दूनों झन सपना देखे हन, अऊ ओकर अर्थ बतानेवाला कोनो नइं ए।”</para>
  <para style="p" vid="GEN 40:8">यूसुफ ह ओमन ला कहिस, “का सपना के अर्थ बतानेवाला परमेसर नो हय? मोला अपन-अपन सपना बतावव।”<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />तब पीयानेवालामन के मुखिया ह अपन सपना यूसुफ ला अइसन बताय लगिस, “मेंह सपना म देखेंव कि मोर आघू म एक अंगूर के नार हे, <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />अऊ ओ अंगूर के नार म तीन ठन डंगाली हवंय। जतकी जल्दी ओमा कली फूटिस, ओमा फूल लगिस, अऊ गुच्छामन म अंगूरमन पाक गीन। <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />फिरौन राजा के कटोरा ह मोर हांथ म रिहिस, अऊ मेंह ओ अंगूरमन ला लेके फिरौन राजा के कटोरा म निचोंय अऊ कटोरा ला ओकर हांथ म दे देंव।”<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />यूसुफ ह ओला कहिस, “एकर मतलब ये अय—तीन डंगालीमन के अर्थ तीन दिन अय। <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />अब ले तीन दिन के भीतर फिरौन राजा ह तोला जेलखाना ले निकलवाही अऊ तोला तोर पद मिल जाही, अऊ तें फिरौन राजा के कटोरा ओकर हांथ म देबे, जइसने कि पहिली तें करत रहय, जब तें ओकर पीयानेवाला रहय। <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />पर जब तोर संग सब ठीक हो जाही, त मोला सुरता करबे अऊ मोर ऊपर दया देखाबे; मोर बारे म फिरौन राजा ला बताबे अऊ ये जेलखाना ले मोला बाहिर निकालबे। <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />असल म, मोला इबरीमन के देस ले जबरदस्ती लाय गे हवय, अऊ इहां घलो मेंह अइसन कुछू काम नइं करे हंव कि मोला ये जेलखाना म डारे जावय।”<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />जब रंधइयामन के मुखिया ह देखिस कि यूसुफ ह सपना के बने अर्थ बताय हवय, त ओह यूसुफ ला कहिस, “मेंह घलो एक सपना देखे हंव: मेंह देखेंव कि मोर मुड़ ऊपर रोटी के तीन ठन टुकनी हवंय। <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />सबले ऊपर के टुकनी म फिरौन राजा बर जम्मो किसम के चुरे-पाके चीजमन हवंय, पर चिरईमन मोर मुड़ म के टुकनी म ले ओ चीजमन ला खावत हवंय।”<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />यूसुफ ह कहिस, “एकर मतलब ये अय: तीन ठन टुकनी के मतलब तीन दिन अय। <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />अब ले तीन दिन के भीतर फिरौन राजा ह तोर मुड़ ला कटवाके तोर देहें ला एक ठन खंभा ऊपर टंगवा दीही। अऊ चिरईमन तोर मांस ला खाहीं।”<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />तीसर दिन फिरौन राजा के जनम दिन रिहिस, अऊ ओह अपन जम्मो करमचारीमन ला एक जेवनार दीस। ओह अपन करमचारीमन के आघू म पीयानेवालामन के मुखिया अऊ रंधइयामन के मुखिया ला जेलखाना ले बाहिर निकलवाईस। <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />ओह पीयानेवालामन के मुखिया ला फेर ओकर पद दे दीस, ताकि ओह फिरौन राजा के हांथ म कटोरा देवय— <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />पर रंधइयामन के मुखिया ला ओह सूली म टंगवा दीस, जइसने कि यूसुफ ह ओमन ला सपना के अर्थ बताय रिहिस।<verse eid="GEN 40:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 40:23" />तभो ले, पीयानेवालामन के मुखिया ह यूसुफ ला सुरता नइं करिस; ओह ओला भुला गीस।<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s1">फिरौन राजा के सपना</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />जब पूरा दू बछर हो गीस, त फिरौन राजा एक सपना देखिस: ओह नील नदी के तीर म ठाढ़े रिहिस, <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />अऊ ओ नदी म ले सात ठन सुन्दर अऊ मोट-मोट गाय निकलके कछार के कांदी ला चरे लगिन। <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />ओमन के बाद, सात ठन आने कुरूप अऊ कमजोर गाय नील नदी ले निकलिन अऊ नदी के तीर म ठाढ़े दूसर गायमन के बाजू म ठाढ़ हो गीन। <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />अऊ जऊन गायमन कुरूप अऊ कमजोर रिहिन, ओमन ओ सात ठन सुन्दर अऊ मोट-मोट गायमन ला खा डारिन। तब फिरौन ह नींद ले जाग गीस।<verse eid="GEN 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5" />ओह फेर सुत गीस अऊ एक आने सपना देखिस: एक ही डंठल म ले सात ठन मोट अऊ बने बीजा के पीकमन निकलिन। <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />ओमन के बाद, सात ठन अऊ बीजा के पीकमन निकलिन, जेमन पातर अऊ पूरब दिग के हवा ले मुरझा गे रिहिन। <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />ओ बीजा के पातर पीकमन ओ सातों मोट अऊ दाना ले भरे पीकमन ला लील डारिन। तब फिरौन ह जाग गीस; येह एक सपना रिहिस।<verse eid="GEN 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8" />बिहनियां फिरौन के मन ह बियाकुल हो गीस, एकरसेति ओह मिसर के जम्मो जादूगर अऊ पंडितमन ला बुलवाईस, अऊ ओमन ला अपन दूनों सपना ला बताईस, पर कोनो घलो ओला ओ सपनामन के अर्थ नइं बता सकिन।<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />तब पीयानेवालामन के मुखिया ह फिरौन ला कहिस, “आज में अपन गलती ला सुरता करत हंव। <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />जब फिरौन ह अपन सेवकमन ले नराज रिहिस, अऊ ओह मोला अऊ रंधइयामन के मुखिया ला अंगरछकमन के मुखिया के घर म कैद करके रखे रिहिस। <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />तब हमन दूनों झन एके रथिया एक-एक सपना देखेंन, अऊ हर सपना के अपन म अलग अर्थ रिहिस। <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />उहां हमर संग एक इबरी जवान रिहिस, जऊन ह अंगरछकमन के मुखिया के सेवक रिहिस। हमन ओला अपन-अपन सपना बतायेंन, अऊ ओह हमर सपनामन के अर्थ हमन ला बताईस; हमन के एक-एक के सपना के अर्थ ओह बता दीस। <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />अऊ जइसने-जइसने अर्थ ओह हमन ला बताय रिहिस, एकदम वइसनेच होईस घलो: मोला मोर पद फेर मिल गीस, पर रंधइयामन के मुखिया ला सूली ऊपर लटका दिये गीस।”<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />तब फिरौन ह यूसुफ ला बलाय बर पठोईस, अऊ ओला तुरते जेलखाना ले बाहिर निकाले गीस, अऊ ओह चुंदी कटवाके अऊ कपड़ा बदलके फिरौन के आघू म आईस।<verse eid="GEN 41:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 41:15" />फिरौन ह यूसुफ ला कहिस, “मेंह एक सपना देखे हंव, अऊ कोनो ओकर अर्थ नइं बता सकत हें। पर मेंह तोर बारे म सुने हवंव कि तें सपना ला सुनके ओकर अर्थ बता देथस।”<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />यूसुफ ह फिरौन ला जबाब दीस, “में ये नइं कर सकंव, पर परमेसर ह फिरौन ला ओकर ईछा के जबाब दीही।”<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />तब फिरौन ह यूसुफ ला कहिस, “में अपन सपना म नील नदी के तीर म ठाढ़े रहेंव। <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />तब नदी म ले सात ठन मोट-मोट अऊ सुन्दर गाय निकलिन अऊ कछार के कांदी ला चरे लगिन। <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />ओमन के बाद, सात ठन गाय अऊ निकलिन, जेमन दुरबल, बहुंत कुरूप अऊ पातर रिहिन। मेंह पूरा मिसर देस म अइसन कुरूप गाय कभू नइं देखे रहेंव। <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />ये पातर अऊ कुरूप गायमन ओ पहिली के सात ठन मोट-मोट गायमन ला खा डारिन। <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />पर ओमन ला खाय के बाद घलो कोनो ये नइं कह सकत रिहिन कि ओमन अइसन करे हवंय, काबरकि ओमन पहिली के सहीं जस के तस कुरूप दिखत रिहिन। तब में जाग गेंव।<verse eid="GEN 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22" />“फेर में दूसर सपना म देखेंव कि एक ही डंठल म सात ठन बने-बने अऊ बीजा ले भरे पीकमन निकलिन। <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />ओमन के बाद, अऊ सात ठन पीक निकलिन, जेमन कमजोर अऊ पातर अऊ पूरब के हवा ले मुरझा गे रिहिन। <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />बीजा के ये पातर पीकमन ओ बने सात ठन पीकमन ला लील डारिन। मेंह येला जादूगरमन ला बतांय, पर ओमा के कोनो मोला ओकर अर्थ नइं बता सकिन।”<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />तब यूसुफ ह फिरौन ला कहिस, “फिरौन के सपनामन एके ठन अऊ ओहीच अंय। परमेसर जऊन काम करे बर चाहत हवय, ओला ओह फिरौन ऊपर परगट करे हवय। <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />ओ सात बने गायमन सात बछर अंय, अऊ ओ बीजा के सात ठन बने पीकमन घलो सात बछर अंय; येह एके ठन अऊ ओहीच सपना अय। <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />जऊन सात ठन पातर अऊ कुरूप गायमन निकलिन, अऊ जऊन सात ठन बेकार अऊ पूरब के हवा ले मुरझाय पीकमन निकलिन: ओमन अकाल के सात बछर अंय।<verse eid="GEN 41:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28" />“येह ओही बात अय, जेला में फिरौन ला बता डारे हंव: परमेसर जऊन काम करनेवाला हे, ओला ओह फिरौन ला देखाय हवय। <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />सुन, जम्मो मिसर देस म सात बछर तो अब्बड़ ऊपज होही। <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />पर ओकर पाछू, सात बछर अकाल पड़ही, अऊ मिसर देस के मनखेमन ओ जम्मो बने ऊपज ला भुला जाहीं, अऊ अकाल ले देस ह नास हो जाही। <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />ओ अब्बड़ ऊपज ला कोनो सुरता नइं करही, काबरकि ओकर बाद जऊन अकाल पड़ही, ओह बहुंत भयंकर होही। <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />फिरौन ला ये जो सपना दू किसम ले देखाय गीस, एकर कारन ये अय कि ये बात परमेसर कोति ले ठहिराय जा चुके हवय अऊ परमेसर ह येला जल्दी पूरा करही।<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />“एकरसेति अब फिरौन ह कोनो समझदार अऊ बुद्धिमान मनखे ला खोजके ओला मिसर देस ऊपर मुखिया ठहिराय। <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />फिरौन ह देस भर म अधिकारीमन ला ठहिराय, जेमन सुकाल के सात बछर रहत तक मिसर देस के मनखेमन ले ऊपज के पांचवां भाग ला लेवंय। <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />ओमन अवइया बने समय म जम्मो खाय-पीये के चीज ला संकेलंय, अऊ फिरौन के अधिकार ले सहरमन म अनाज ला जमा करंय, ताकि खाय बर भोजन-बस्तु रहय। <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />ये भोजन-बस्तु ला देस बर बचाके रखे जावय, ताकि मिसर देस ऊपर अवइया अकाल के ओ सात बछर के समय एकर उपयोग करे जा सकय, अऊ देस ह अकाल ले नास झन होवय।”<verse eid="GEN 41:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />ये बात फिरौन अऊ ओकर जम्मो करमचारीमन ला बने लगिस। <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />एकरसेति फिरौन ह अपन करमचारीमन ला कहिस, “का हमन ला ये मनखे सहीं कोनो मिल सकत हे, जेमा परमेसर के आतमा रहिथे?”<verse eid="GEN 41:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39" />तब फिरौन ह यूसुफ ला कहिस, “जब परमेसर ह तोला ये जम्मो बात बताय हवय, त तोर सहीं समझदार अऊ बुद्धिमान मनखे अऊ कोनो नइं एं। <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />एकरसेति तेंह मोर महल के मुखिया होबे, अऊ मोर जम्मो मनखेमन तोर हुकूम ला मानहीं। सिरिप सिंघासन के आदर के कारन मेंह तोर ले बड़े रहिहूं।”<verse eid="GEN 41:40" /></para>
  <para style="s1">यूसुफ, मिसर के अधिकारी</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41" />फेर फिरौन ह यूसुफ ले कहिस, “देख, में तोला पूरा मिसर देस ऊपर अधिकारी ठहिरात हंव।” <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />तब फिरौन ह अपन अंगरी ले मुहरवाला मुंदरी निकालके यूसुफ के अंगरी म पहिरा दीस। ओह ओला सुघर मलमल के ओनहा पहिराईस अऊ ओकर गला म सोन के माला पहिरा दीस। <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />ओह ओला अपन बाद दूसर अधिकारी के रूप म रथ म चघाईस, अऊ मनखेमन ओकर आघू-आघू चिचियाके ये कहत रिहिन, “ओला दंडवत करव!” ये किसम ले, ओह ओला मिसर के जम्मो देस के ऊपर अधिकारी बना दीस।<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />तब फिरौन ह यूसुफ ला कहिस, “फिरौन तो में अंव, पर जम्मो मिसर देस म कोनो घलो तोर हुकूम के बिना कुछू नइं कर सकंय।” <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />फिरौन ह यूसुफ के नांव सापनत-पानेह रखिस अऊ ओन<note caller="+" style="f"><char style="fr" closed="false">41:45 </char><char style="ft" closed="false">हिलियापुलिस; देखव <char style="xt" link-href="GEN 41:50"><ref loc="GEN 41:50">पद 50</ref></char></char></note> नगर के पुरोहित पोतीपेरा के बेटी आसनत ले ओकर बिहाव करवा दीस। अऊ यूसुफ जम्मो मिसर देस म दउरा करिस।<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />जब यूसुफ ह मिसर के राजा फिरौन के सेवा म आईस, त ओह तीस बछर के रिहिस। अऊ यूसुफ ह फिरौन करा ले जाके जम्मो मिसर देस म दउरा करिस। <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />सुकाल के सातों बछर अब्बड़ फसल होईस। <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />यूसुफ ह मिसर देस म सुकाल के ओ सातों बछर म जम्मो किसम के जेवन के चीज-वस्तु ला संकेलिस अऊ सहरमन म रखत गीस। हर सहर के चारों कोति के खेत म पईदा होय खाय-पीये के चीज ला ओह ओहीच सहर म जमा करत गीस। <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />अइसन करके यूसुफ ह अनाज ला समुंदर के बालू सहीं भारी तदाद म जमा कर लीस; अनाज अतकी जादा हो गीस कि ओह ओकर हिसाब रखे बर छोंड़ दीस, काबरकि येह गनती के बाहिर हो गीस।<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />अकाल परे के पहिली, यूसुफ के दू झन बेटा, ओन सहर के पुरोहित पोतीपेरा के बेटी आसनत ले होईन। <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />यूसुफ ह अपन बड़े बेटा के नांव ये कहिके मनस्से<note caller="+" style="f"><char style="fr" closed="false">41:51 </char><char style="fq" closed="false">मनस्से </char><char style="ft" closed="false">सायद इबरानी म </char><char style="fqa" closed="false">भूल जवई</char></note> रखिस, “परमेसर ह मोर ले मोर जम्मो दुख अऊ मोर ददा के जम्मो घराना ला भुला दीस हे।” <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />दूसर बेटा के नांव ओह ये कहिके एपरैम<note caller="+" style="f"><char style="fr" closed="false">41:52 </char><char style="fq" closed="false">एपरैम </char><char style="ft" closed="false">सायद इबरानी म </char><char style="fq" closed="false">फलवंत</char></note> रखिस, “मोर दुख भोगे के देस म परमेसर ह मोला फलवंत करे हे।”<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />मिसर देस म सुकाल के सात बछर सिरा गीस, <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />अऊ यूसुफ के कहे मुताबिक सात बछर के अकाल सुरू हो गीस। दूसर जम्मो देसमन म घलो अकाल परिस, पर पूरा मिसर देस म खाय के चीज-वस्तु रिहिस। <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />जब पूरा मिसर देस अकाल के चपेट म आईस, त मनखेमन फिरौन ले नरिया-नरियाके खाय बर मांगे लगिन। तब फिरौन ह जम्मो मिसरीमन ला कहिस, “यूसुफ करा जावव अऊ जऊन कुछू ओह तुमन ला कहिथे, वइसने करव।”<verse eid="GEN 41:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56" />जब अकाल ह जम्मो देस म फईल गीस, त यूसुफ ह जम्मो गोदाममन ला खोल दीस अऊ मिसरीमन ला अनाज बेचे लगिस, काबरकि जम्मो मिसर देस म भयंकर अकाल परे रिहिस। <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />अऊ जम्मो संसार के मनखेमन मिसर देस म यूसुफ करा अनाज बिसाय बर आय लगिन, काबरकि जम्मो जगह भयंकर अकाल परे रिहिस।<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s1">यूसुफ के भाईमन के मिसर देस जवई</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />जब याकूब ला पता चलिस कि मिसर देस म अनाज हवय, त ओह अपन बेटामन ला कहिस, “तुमन काबर सिरिप एक-दूसर ला देखत हवव?” <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />फेर ओह कहिस, “मेंह सुने हंव कि मिसर म अनाज हवय। तुमन उहां जावव अऊ हमर बर कुछू अनाज बिसाके लानव, ताकि हमन झन मरन, पर जीयत रहन।”<verse eid="GEN 42:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3" />तब यूसुफ के दस भाईमन अनाज बिसाय बर मिसर गीन। <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />पर याकूब ह यूसुफ के भाई बिनयामीन ला ओमन के संग नइं पठोईस, काबरकि ओह डरात रिहिस कि बिनयामीन ऊपर बिपत्ति आ सकत हे। <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />ये किसम ले जऊन मन अनाज बिसाय बर गीन, ओमन म इसरायल के बेटामन घलो गीन, काबरकि कनान देस म घलो अकाल परे रिहिस।<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />यूसुफ ह मिसर देस के राजपाल रिहिस, अऊ ओह ओ देस के जम्मो झन ला अनाज बेचत रिहिस। एकरसेति जब यूसुफ के भाईमन आईन, त ओमन भुइयां म मुहूं के भार गिरके ओला दंडवत करिन। <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />यूसुफ ह अपन भाईमन ला देखत ही ओमन ला चिन डारिस, पर ओह अनजान बने रिहिस अऊ ओमन ले कड़ई से पुछिस, “तुमन कहां ले आय हव?”</para>
  <para style="p" vid="GEN 42:7">ओमन कहिन, “हमन कनान देस ले अनाज बिसाय बर आय हन।”<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />हालाकि यूसुफ अपन भाईमन ला चिन डारिस, पर ओमन ओला नइं चिन्हिन। <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />तब ओह ओमन के बारे म देखे अपन सपना ला सुरता करिस अऊ ओमन ला कहे लगिस, “तुमन भेदिया अव! तुमन ये देखे बर आय हव कि हमर देस म कते करा पहरेदारी नइं होवत हे।”<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />ओमन जबाब दीन, “नइं, नइं, हे हमर मालिक, तोर सेवकमन भोजन-बस्तु बिसाय बर आय हवंय। <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />हमन जम्मो झन एके मनखे के बेटा अन। तोर सेवकमन ईमानदार मनखे अंय, भेदिया नो हंय।”<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />ओह ओमन ला कहिस, “नइं! तुमन ये देखे बर आय हव कि हमर देस म कते करा पहरेदारी नइं होवत हे।”<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />पर ओमन कहिन, “तोर सेवकमन बारह भाई रिहिन, अऊ जम्मो झन कनान देस म रहइया एके मनखे के बेटा अंय। सबले छोटे ह अभी हमर ददा करा हवय, अऊ एक झन ह काल कर डारिस।”<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />यूसुफ ह ओमन ला कहिस, “मेंह तुमन ला कह डारे हंव कि तुमन भेदिया अव! <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />अऊ तुम्हर ये किसम ले जांच होही: फिरौन के जिनगी के कसम, जब तक तुम्हर छोटे भाई ह इहां नइं आ जाही, तुमन इहां ले नइं जा सकव। <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />तुमन अपन म ले एक झन ला पठोवव कि ओह तुम्हर भाई ला लेके आवय; बाकि तुमन इहां कैद म रहिहू, ये किसम ले तुम्हर बात ह परखे जाही कि तुमन सच कहत हव कि नइं। यदि तुम्हर बात ह सच नइं होही, त फिरौन के जिनगी के कसम, तुमन सच म भेदिया अव!” <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />अऊ ओह ओमन ला तीन दिन तक कैद म रखिस।<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />तीसर दिन यूसुफ ह ओमन ला कहिस, “एक काम करव, त जीयत रहिहू, काबरकि में परमेसर के भय मानथंव: <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />यदि तुमन ईमानदार मनखे अव, त तुम्हर भाईमन ले एक झन इहां जेलखाना म रूके, अऊ बाकि झन अपन परिवार के मनखेमन के भूख मिटाय बर अनाज ले जावव। <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />पर तुमन अपन सबले छोटे भाई ला मोर करा ले आवव, ताकि तुम्हर बात ला सच साबित करे जा सकय, अऊ तुमन झन मारे जावव।” तब ओमन वइसनेच करिन।<verse eid="GEN 42:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21" />ओमन एक-दूसर ला कहिन, “सच म, हमन अपन भाई के कारन दंड पावत हन। हमन देखे रहेंन कि ओह कतेक दुखी रिहिस, जब ओह हमर ले अपन जिनगी बर बिनती करत रिहिस, पर हमन नइं सुनेंन; एकरसेति ये बिपत ह हमर ऊपर परे हवय।”<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />रूबेन ह कहिस, “का में तुमन ला नइं कहे रहेंव कि छोकरा के बिरूध म पाप झन करव? पर तुमन नइं सुनेव! अब हमन ला ओकर लहू के हिसाब देना पड़ही।” <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />ओमन नइं जानत रिहिन कि यूसुफ ह ओमन के बात ला समझत हवय, काबरकि ओमन के संग गोठियाय बर यूसुफ ह एक दुभासिया के उपयोग करत रिहिस।<verse eid="GEN 42:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 42:24" />तब ओह ओमन करा ले हट गीस अऊ रोये लगिस, पर ओह फेर वापिस आईस अऊ ओमन ले फेर बात करिस। ओह ओमन ले सिमोन ला लीस अऊ ओमन के आघू म ओला बांधके कैदी बना लीस।<verse eid="GEN 42:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />तब यूसुफ ह हुकूम दीस कि ओमन के बोरामन ला अनाज ले भर देवव अऊ हर एक झन के बोरा म ओकर रूपिया ला घलो रख देवव, अऊ रसता बर ओमन ला भोजन-पानी दे देवव। ओमन बर अइसने ही करे गीस। <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />तब ओमन अपन गदहामन ऊपर अनाज लादके उहां ले चल दीन।<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />रसता म ओमन एक जगह रात बिताय बर रूकिन, त ओमन के एक झन ह अपन गदहा ला चारा देय बर अपन बोरा ला खोलिस, त ओह देखिस कि ओकर रूपिया ह अनाज के ऊपर म रहय। <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />तब ओह अपन भाईमन ला कहिस, “मोर रूपिया तो लहुंटा दे गे हवय; देखव, येह मोर बोरा म हवय।”</para>
  <para style="p" vid="GEN 42:28">तब ओमन के जी म जी नइं रिहिस अऊ ओमन डर के मारे एक-दूसर कोति देखके कांपे लगिन अऊ कहिन, “परमेसर ह हमर संग ये का करे हवय?”<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />जब ओमन कनान देस म अपन ददा याकूब करा आईन, त जऊन कुछू ओमन के संग होय रिहिस, ओ जम्मो बात ओला बताईन। ओमन कहिन, <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />“जऊन मनखे ह ओ देस के हाकिम अय, ओह हमन ले बहुंत कड़ई से बात करिस अऊ हमर ले अइसन बरताव करिस, जइसन कि हमन ओकर देस के भेद लेवत रहेंन। <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />पर हमन ओला कहेंन, ‘हमन ईमानदार मनखे अन; हमन भेदिया नो हन। <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />हमन बारह भाई, जम्मो एके ददा के बेटा अन। एक भाई ह काल कर डारिस, अऊ सबले छोटे ह अभी कनान देस म हमर ददा करा हवय।’<verse eid="GEN 42:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 42:33" />“तब ओ मनखे, जऊन ह ओ देस के हाकिम अय, हमन ला कहिस, ‘ये किसम ले मोला मालूम हो जाही कि तुमन ईमानदार मनखे अव कि नइं: तुमन अपन म ले एक भाई ला मोर करा छोंड़ जावव, अऊ अपन परिवार के मनखेमन के भूख मिटाय बर भोजन-बस्तु लेके जावव। <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />पर अपन छोटे भाई ला मोर करा लेके आवव, तब मेंह जानहूं कि तुमन भेदिया नइं, पर ईमानदार मनखे अव। तब में तुम्हर भाई तुमन ला सऊंप दूहूं, अऊ तुमन ये देस म लेन-देन कर सकहू।’ ”<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />जब ओमन अपन-अपन बोरा म ले अनाज निकाले लगिन, त देखिन कि हर एक के रूपिया के थैली ओकर बोरा म हवय! जब ओमन अऊ ओमन के ददा ह रूपिया के थैलीमन ला देखिन, त ओमन बहुंत डरा गीन। <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />तब ओमन के ददा याकूब ह ओमन ला कहिस, “तुमन मोर ले मोर लइकामन ला छीन ले हव। यूसुफ तो नइं ए अऊ सिमोन घलो नइं ए, अऊ अब तुमन बिनयामीन ला घलो ले जाय चाहत हव। ये जम्मो बिपत्ति मोर ऊपर आ गे हवय।”<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />तब रूबेन ह अपन ददा ला कहिस, “यदि में ओला तोर करा वापिस नइं लानहूं, त तें मोर दूनों बेटा ला मार डारबे। तें ओला मोर हांथ म सऊंप दे, अऊ में ओला वापिस लेके आहूं।”<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />पर याकूब ह कहिस, “मोर बेटा ह तोर संग उहां नइं जावय; ओकर भाई ह मर चुके हे अऊ ओह एके झन बांचे हवय। जिहां तुमन जावत हव, यदि डहार म ओकर ऊपर कोनो बिपत पड़थे, त तुमन के कारन, मेंह ये बुढ़ापा म दुख म मर जाहूं।”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s1">मिसर देस के दूसरइया यातरा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />कनान देस म अभी घलो अकाल ह बहुंत भयंकर रिहिस। <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />जब मिसर ले लाने जम्मो अनाज सिरा गीस, त याकूब ह अपन बेटामन ला कहिस, “मिसर देस वापिस जावव अऊ हमर बर थोरकून अऊ अनाज बिसाके लानव।”<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />तब यहूदा ह ओला कहिस, “ओ मनखे ह हमन ला चेताके कहे रिहिस, ‘यदि तुम्हर भाई तुम्हर संग नइं आही, त फेर तुमन मोर आघू म नइं आ सकव।’ <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />यदि तें हमर भाई ला हमर संग पठोबे, त हमन जाबो अऊ तोर बर अनाज बिसाबो। <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />पर यदि तें ओला नइं पठोबे, त हमन नइं जावन, काबरकि ओ मनखे ह हमन ला कहिसे, ‘यदि तुम्हर भाई तुम्हर संग नइं आही, त फेर तुमन मोर आघू म नइं आ सकव।’ ”<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />तब इसरायल ह पुछिस, “तुमन ओ मनखे ला ये बताके कि तुम्हर एक झन अऊ भाई हवय, काबर मोर ऊपर ये समस्या लानेव?”<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />ओमन जबाब दीन, “ओ मनखे ह बड़े सावधानी से हमर अऊ परिवार के बारे म अइसने सवाल पुछिस, ‘का तुम्हर ददा ह अब तक जीयत हवय? का तुम्हर अऊ भाई हवय?’ तब हमन सधारन रूप म ओकर सवाल के जबाब देंन। हमन कइसे जान सकत रहेंन कि ओह ये कहिही, ‘अपन भाई ला इहां ले आवव’?”<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />तब यहूदा ह अपन ददा इसरायल ला कहिस, “ओ छोकरा ला मोर संग म पठो दे अऊ हमन तुरते चले जाबो, ताकि हमन अऊ तें अऊ हमर लइकामन जीयत रहंय अऊ मरंय झन। <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />में खुद ओकर सुरकछा के जमानत अंव; तेंह मोला ओकर बर जिम्मेदार ठहिरा सकथस। यदि में ओला तोर करा लानके इहां तोर आघू म ठाढ़ नइं कर देवंव, त मोर जिनगी भर, में तोर अपराधी ठहिरहूं। <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />यदि हमन देरी नइं करतेंन, त अभी तक दू बार जाके लहुंट आय रहितेंन।”<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />तब ओमन के ददा इसरायल ह ओमन ला कहिस, “यदि येह जरूरी अय, त अइसने करव: ये देस के सबले बने चीजमन ले थोर-थोर अपन बोरा म रखव अऊ ओ मनखे बर भेंट के रूप म ले जावव—जइसे कि थोरकन मलहम अऊ थोरकन मंधरस, कुछू मसाला अऊ गंधरस, कुछू पिसता अऊ बादाम। <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />अपन-अपन संग म दू गुना रूपिया ले जावव; काबरकि जऊन रूपिया तुम्हर बोरामन के मुहूं म रख दिये गे रिहिस, ओला लहुंटाना जरूरी अय। सायद गलती से अइसने होय होही। <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />अपन भाई ला घलो ले लव अऊ ओ मनखे करा तुरते वापिस जावव। <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />अऊ सर्वसक्तिमान परमेसर ह ओ मनखे ला तुम्हर ऊपर दयालु करय, ताकि ओह तुम्हर दूसर भाई अऊ बिनयामीन ला तुम्हर संग वापिस आवन दे। यदि में बिगर बंस के हो जावंव, त हो जावंव।”<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />तब ओ मनखेमन ओ भेंट अऊ दू गुना रूपिया, अऊ बिनयामीन ला संग म लेके चल दीन, अऊ मिसर म हबरके यूसुफ के आघू म ठाढ़ होईन। <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />जब यूसुफ ह बिनयामीन ला ओमन के संग देखिस, त ओह अपन घर के देखरेख करइया ला कहिस, “ये मनखेमन ला मोर घर म ले जा, अऊ एक पसु मारके जेवन तियार कर; काबरकि येमन मंझनियां मोर संग जेवन करहीं।”<verse eid="GEN 43:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17" />ओ मनखे ह यूसुफ के कहे मुताबिक करिस अऊ ओ मनखेमन ला यूसुफ के घर ले गीस। <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />जब ओमन ला यूसुफ के घर म लाने गीस, त ओमन डरा गीन। ओमन सोचिन, “जऊन रूपिया पहिली बखत हमर बोरामन म लहुंटा दिये गे रिहिस, ओकरे कारन हमन ला इहां लाने गे हवय। ओह हमर ऊपर हमला करके हमन ला अपन बस म करे चाहत हे अऊ हमन ला गुलाम के रूप म पकड़के हमर गदहामन ला लेय चाहत हे।”<verse eid="GEN 43:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19" />एकरसेति ओमन यूसुफ के घर के देखरेख करइया करा गीन अऊ घर के कपाट करा ओकर ले ये कहे लगिन, <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />“हे हमर मालिक, हमन ला छेमा कर; हमन पहिली बार इहां अनाज बिसाय बर आय रहेंन। <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />पर वापिस जावत बेरा, जब एक जगह रात बिताय बर रूकेंन अऊ अपन-अपन बोरा ला खोलेंन, त का देखेंन कि हर एक के पूरा-पूरा पईसा ओकर बोरा के मुहूं म धराय रहय। एकरसेति हमन ओला अपन संग लेके आय हन। <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />हमन अपन संग अऊ रूपिया अनाज बिसाय बर लाने हन। हमन नइं जानन कि हमर रूपिया ला हमर बोरा म कोन रखे रिहिस।”<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />घर के देखरेख करइया ह कहिस, “कोनो बात नइं ए; झन डरव। तुम्हर परमेसर, जऊन ह तुम्हर ददा के घलो परमेसर अय, ओही ह तुम्हर बोरा म तुमन ला धन दे हवय; तुम्हर रूपिया तो मोला मिल गे हवय।” तब ओह सिमोन ला निकालके ओमन करा ले आईस।<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />तब ओ सेवक ह ओ मनखेमन ला यूसुफ के घर भीतर ले आईस, अऊ गोड़ धोय बर ओमन ला पानी दीस अऊ ओमन के गदहामन बर चारा दीस। <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />ये सुनके कि आज हमन ला इहां जेवन करना हे, ओमन यूसुफ के आय के समय, याने कि मंझनियां तक, अपन-अपन भेंट ला तियार करके रखिन।<verse eid="GEN 43:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26" />जब यूसुफ ह घर म आईस, त ओमन घर के भीतर लाय अपन भेंट यूसुफ ला दीन, अऊ भुइयां म गिरके ओला दंडवत करिन। <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />ओह ओमन के हालचाल पुछिस अऊ कहिस, “तुम्हर सियान ददा कइसने हवय, जेकर बारे म तुमन मोला बताय रहेव? का ओह अभी घलो जीयत हवय?”<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />ओमन कहिन, “हव, तोर सेवक, हमर ददा ह अभी घलो जीयत हवय अऊ बने हवय।” अऊ ओमन मुड़ नवाके ओला दंडवत करिन।<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />जब ओह आंखी उठाके अपन भाई बिनयामीन ला देखिस, जऊन ह ओकर खुद के दाई के बेटा रिहिस, त ओह पुछिस, “का येह तुम्हर सबले छोटे भाई अय, जेकर बारे म तुमन मोला बताय रहेव?” अऊ ओह कहिस, “हे मोर बेटा, परमेसर तोर ऊपर अनुग्रह करय।” <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />अपन भाई ला देखके यूसुफ के आंखी भर आईस, अऊ रोये बर सुन्ना जगह देखे लगिस। ओह अपन निजी कमरा म गीस अऊ उहां रोये लगिस।<verse eid="GEN 43:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31" />अपन मुहूं ला धोये के बाद, ओह बाहिर निकलिस अऊ अपनआप ला सांत करके कहिस, “जेवन परोसव।”<verse eid="GEN 43:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32" />तब ओमन ओकर बर अलग, ओकर भाईमन बर अलग, अऊ जऊन मिसरी मनखेमन ओकर संग खावत रिहिन, ओमन बर घलो अलग जेवन परोसिन, काबरकि मिसरी मनखेमन इबरी मनखेमन संग जेवन नइं करंय; ओमन बर अइसन करई ह घिन के बात रिहिस। <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />यूसुफ के भाईमन ला ओकर आघू म ओमन के उमर के हिसाब से बईठाय गे रिहिस, पहिले बड़खा, फेर ओकर बाद वालामन अऊ आखिरी म सबले छोटे; अऊ ओमन चकित होके एक-दूसर ला देखे लगिन। <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />तब यूसुफ के मेज म ले ओमन ला भोजन-बस्तु परोसे गीस, पर बिनयामीन ला ओकर भाईमन ले पांच गुना जादा भोजन-बस्तु परोसे गीस। ओमन यूसुफ के संग खुलके खाईन-पीईन।<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s1">एक ठन बोरा म एक ठन चांदी के कटोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />तब यूसुफ ह अपन घर के देखरेख करइया ला ये हुकूम दीस: “ये मनखेमन जतेक जादा भोजन-बस्तु अपन बोरा म ले जा सकथें, ओतेक जादा भरव, अऊ हर एक के रूपिया ला ओमन के बोरा के मुहूं म रख देवव। <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />तब मोर चांदी के कटोरा ला सबले छोटे के बोरा के मुहूं म ओकर अनाज के रूपिया के संग रख देवव।” अऊ ओह वइसने करिस, जइसने यूसुफ ह कहिस।<verse eid="GEN 44:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3" />बिहनियां होते ही, ओ मनखेमन ला ओमन के गदहामन के सहित बिदा करे गीस। <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />ओमन सहर ले जादा दूरिहा नइं गे होहीं जब यूसुफ ह अपन घर के देखरेख करइया ला कहिस, “तुरते ओ मनखेमन के पीछा कर, अऊ जब ओमन तुमन ला मिल जाहीं, त ओमन ला कह, ‘तुमन भलई के बदला म बुरई काबर करे हव? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />का येह ओ कटोरा नो हय, जेमा मोर मालिक पीथे अऊ अगम के बात कहे बर घलो एकर उपयोग करथे? तुमन एक दुस्ट काम करे हव।’ ”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />जब ओला ओमन मिल गीन, त ओह ओमन ले वइसनेच कहिस। <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />पर ओमन ओला कहिन, “हे हमर मालिक, तें अइसन बात काबर कहत हस? अइसने काम करई तोर सेवकमन ले दूरिहा रहय! <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />देख, इहां तक कि जऊन रूपिया हमन ला हमर बोरामन के मुहूं के भीतर म मिले रिहिस, ओला हमन कनान देस ले तोर करा वापिस ले आयेंन, त फेर तोर मालिक के घर ले चांदी या सोन, हमन काबर चोराबो? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />यदि तोर दासमन ले जेकर करा घलो ओ चीज निकलही, ओह मार डारे जाही; अऊ बाकि हमन, हे हमर मालिक, तोर गुलाम हो जाबो।”<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />ओह कहिस, “तब, ठीक हे। तुम्हर कहे मुताबिक होवय। जेकर करा ओ चीज निकलही, ओह मोर दास हो जाही; अऊ बाकि तुमन दोस मुक्त हो जाहू।”<verse eid="GEN 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11" />ओमन जल्दी-जल्दी अपन-अपन बोरा ला भुइयां म उतारके ओला खोले लगिन। <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />तब यूसुफ के घर के देखरेख करइया ह खोजे लगिस; ओह सबले बड़े के बोरा ले सुरू करके सबले छोटे के बोरा म खतम करिस। अऊ कटोरा ह बिनयामीन के बोरा म मिलिस। <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />येला देखके ओमन अपन-अपन ओनहा ला चीरिन। तब ओमन जम्मो झन अपन-अपन गदहा ऊपर बोरा लादके सहर म वापिस आईन।<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />जब यहूदा अऊ ओकर भाईमन आईन, त यूसुफ ह घरेच म रिहिस, अऊ ओमन ओकर आघू म भुइयां म गिरिन। <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />यूसुफ ह ओमन ला कहिस, “तुमन ये कइसन काम करे हव? का तुमन ये नइं जानत हव कि मोर सहीं मनखे ह अगम के बात कहे के दुवारा चीज के पता लगा सकथे?”<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />“हमन हमर मालिक ला का कह सकत हन?” यहूदा ह कहिस। “हमन का कह सकत हन? हमन कइसे अपनआप ला निरदोस साबित करन? परमेसर ह तोर सेवकमन के अपराध ला देखा दे हे। अब हमन हमर मालिक के गुलाम अन—हमन खुद अऊ ओह घलो, जेकर करा कटोरा मिले हवय।”<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />पर यूसुफ ह कहिस, “अइसन करई मोर ले दूरिहा रहय! जेकर करा कटोरा निकले हवय, सिरिप ओहीच ह मोर दास होही। बाकि के तुमन सांति से अपन ददा करा वापिस जावव।”<verse eid="GEN 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />तब यहूदा ओकर करा जाके कहे लगिस, “हे मोर मालिक, अपन सेवक ला छेमा कर; मोला एक बात कहन दे। तोर गुस्सा तोर सेवक ऊपर झन भड़के, काबरकि तें तो फिरौन के बरोबर अस। <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />हे मोर परभू, तेंह अपन सेवकमन ले पुछे रहय, ‘का तुम्हर ददा या भाई हवय?’ <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />अऊ हमन जबाब देय रहेंन, ‘हव, हमर डोकरा ददा हवय, अऊ ओकर बुढ़त काल म जनमे एक बेटा हवय। ओकर भाई ह मर गीस, अऊ अब ओह अपन दाई के एके झन बेटा बांचे हवय, अऊ ओकर ददा ह ओकर ले मया करथे।’<verse eid="GEN 44:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 44:21" />“तब तें अपन सेवकमन ला कहे, ‘ओला मोर करा ले आवव ताकि मेंह खुदे ओला देख सकंव।’ <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />अऊ हे मोर मालिक, हमन कहेंन, ‘ओ लड़का ह अपन ददा ला नइं छोंड़ सकय; नइं तो ओकर ददा ह मर जाही।’ <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />पर तें अपन सेवकमन ला कहे, ‘यदि तुम्हर छोटे भाई तुम्हर संग नइं आही, त फेर तुमन मोर आघू म नइं आ सकव।’ <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />जब हमन तोर सेवक हमर ददा करा गेंन, त हे मोर परभू, जऊन कुछू तेंह कहे रहे, हमन ओला बतायेंन।<verse eid="GEN 44:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 44:25" />“तब हमर ददा ह कहिस, ‘वापिस जावव अऊ थोरकून अऊ भोजन-बस्तु बिसाके लानव।’ <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />पर हमन कहेंन, ‘हमन नइं जा सकन। हां, यदि हमर छोटे भाई हमर संग होही; त हमन जाबो। यदि हमर छोटे भाई हमर संग नइं होही, त हमन ओ मनखे के आघू म नइं जा सकन।’<verse eid="GEN 44:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 44:27" />“तब तोर सेवक मोर ददा ह हमन ला कहिस, ‘तुमन तो जानत हव कि मोर घरवाली दू झन बेटा जनमे रिहिस। <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />ओमा ले एक झन तो मोर ले दूरिहा चले गीस, अऊ मेंह सोचेंव, “निस्चय ही ओला पसुमन चीर डारे होहीं।” अऊ तब ले ओला, में नइं देखे हंव। <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />यदि तुमन येला घलो मोर आंखी ले दूरिहा ले जाथव, अऊ कोनो बिपत एकर ऊपर पड़थे, त तुम्हर कारन, में ये बुढ़ापा के समय दुख म मर जाहूं।’<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />“एकरसेति, तोर सेवक मोर ददा करा जब में वापिस जाहूं, अऊ यदि ये लड़का हमर संग म नइं होही, अऊ जब मोर ददा, जेकर परान ये लड़का म लटके रहिथे, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />देखही कि लड़का ह उहां नइं ए, त ओह मर जाही। तोर सेवकमन के कारन, हमर ददा ह बुढ़ापा म दुख म मर जाही। <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />तोर सेवक ह मोर ददा ला ये कहिके लड़का के सुरकछा के जमानत ले हवय, ‘यदि में येला तोर करा वापिस नइं लानहूं, त मोर जिनगी भर, में तोर अपराधी ठहिरहूं!’<verse eid="GEN 44:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 44:33" />“एकरसेति, हे मोर मालिक, किरपा करके तोर सेवक ला ये लड़का के बदला म तोर गुलाम के रूप म इहां रहन दे, अऊ ये लड़का ला अपन भाईमन संग वापिस जावन दे। <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />यदि ये लड़का ह मोर संग नइं जाही, त में कइसे अपन ददा करा वापिस जा सकथंव? नइं! मोला अपन ददा ऊपर अवइया दुख ला झन देखन दे।”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s1">यूसुफ ह अपनआप ला परगट करथे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />तब यूसुफ ह अपन जम्मो सेवकमन के आघू म अपनआप ला नइं रोक सकिस, अऊ चिचियाके कहिस, “इहां के जम्मो मनखे बाहिर चले जावव!” अपन भाईमन के आघू म अपनआप ला परगट करे के बेरा उहां यूसुफ के संग अऊ कोनो नइं रिहिन। <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />अऊ ओह चिचिया-चिचियाके रोय लगिस, जेला मिसरीमन सुनिन, अऊ फिरौन के घर के मन ला घलो एकर खबर मिलिस।<verse eid="GEN 45:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3" />यूसुफ ह अपन भाईमन ला कहिस, “में यूसुफ अंव! का मोर ददा अभी तक ले जीयत हवय?” पर ओकर भाईमन ओला जबाब नइं दे सकिन, काबरकि ओमन ओकर आघू म घबरा गे रिहिन।<verse eid="GEN 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4" />तब यूसुफ ह अपन भाईमन ला कहिस, “मोर लकठा म आवव।” जब ओमन ओकर लकठा म आईन, त ओह कहिस, “मेंह तुम्हर भाई यूसुफ अंव, जेला तुमन मिसर अवइयामन के हांथ म बेच दे रहेव। <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />अब तुमन दुखी झन होवव, अऊ मोला इहां बेच देय के कारन, अपनआप ले गुस्सा झन होवव, काबरकि परमेसर ह परान बचाय बर मोला तुम्हर आघू इहां पठो दीस। <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />दू बछर हो गे, ये देस म अकाल परे हवय, अऊ अवइया पांच साल तक अइसने ही होही—न तो नांगर चलही अऊ न ही फसल लुये जाही। <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />पर परमेसर ह मोला तुम्हर आघू ये खातिर पठोईस कि ओह तुम्हर बर तुम्हर एक भाग ला बंचाके रखय अऊ एक बड़े छुटकारा के दुवारा तुम्हर जिनगी ला बचावय।<verse eid="GEN 45:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 45:8" />“एकरसेति, मोला इहां पठोइया तुमन नइं, पर परमेसर अय। ओही ह मोला फिरौन के ददा सहीं अऊ ओकर जम्मो घर के मालिक अऊ जम्मो मिसर देस ऊपर सासन करइया ठहिराय हवय। <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />अब तुमन जल्दी करके मोर ददा करा जावव अऊ ओला कहव, ‘तोर बेटा यूसुफ ह अइसन कहत हे: परमेसर ह मोला जम्मो मिसर देस के मालिक बनाय हे। तें बिगर देरी करे मोर करा चले आ। <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />तें गोसेन के इलाका म रहिबे—तें, तोर लइकामन अऊ नाती-पोतामन, तोर भेड़-बकरी अऊ गाय-बईला, अऊ जऊन कुछू तोर करा हवय, ओ जम्मो सहित मोर लकठा म रहिबे। <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />अकाल के जऊन पांच बछर अऊ होही, ओमा में उहां तोर पालन-पोसन करहूं। अइसन झन होवय कि तें अऊ तोर घराना अऊ तोर करा जऊन मन हवंय, ओमन भूखन मरंय।’<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />“तुमन खुद अपन आंखी ले देख सकत हव, अऊ मोर भाई बिनयामीन घलो देख सकत हे कि में जो तुम्हर ले गोठियावत हंव, सही म यूसुफ अंव। <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />ओ जम्मो आदरमान, जऊन ह मोर करा मिसर देस म हवय अऊ जऊन कुछू तुमन देखे हव, ओ जम्मो बात मोर ददा ला बतावव। अऊ तुरते मोर ददा ला इहां ले आवव।”<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />तब ओह अपन भाई बिनयामीन ला पोटारके रोईस, अऊ बिनयामीन घलो रोवत ओला पोटार लीस। <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />अऊ यूसुफ ह अपन जम्मो भाईमन ला चूमके रोईस। एकर बाद ओकर भाईमन ओकर संग गोठियाय लगिन।<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />जब ये खबर फिरौन के महल म पहुंचिस कि यूसुफ के भाईमन आय हवंय, त फिरौन अऊ ओकर जम्मो करमचारीमन खुस होईन। <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />फिरौन ह यूसुफ ला कहिस, “अपन भाईमन ले कह कि ओमन अइसन करंय: ‘अपन पसुमन ऊपर सामान लादके कनान देस वापिस चले जावंय, <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />अऊ अपन ददा अऊ अपन घर के मनखेमन ला लेके मोर करा आवंय। मेंह मिसर देस के सबले बने भुइयां तुमन ला दूहूं अऊ तुमन ला देस के उत्तम से उत्तम चीज खाय बर मिलही।’<verse eid="GEN 45:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19" />“तोला ये घलो हुकूम दिये जावत हे कि तें ओमन ला बता कि ओमन अइसन करंय: ‘मिसर देस ले कुछू गाड़ी अपन लइका अऊ घरवाली अऊ तोर ददा बर ले जावंय, अऊ ओमन ला लेके आवंय। <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />अपन सामान के चिंता झन करंय, काबरकि मिसर म सबले बने चीजमन तुम्हर होही।’ ”<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />इसरायल के बेटामन वइसने ही करिन। यूसुफ ह फिरौन के हुकूम के मुताबिक ओमन ला गाड़ी दीस, अऊ रसता बर ओमन ला भोजन-बस्तु घलो दीस। <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />ओमा के हर एक झन ला ओह एक-एक जोड़ा ओनहा दीस, पर बिनयामीन ला ओह तीन सौ चांदी के सेकेल<note caller="+" style="f"><char style="fr" closed="false">45:22 </char><char style="ft" closed="false">लगभग साढ़े तीन किलोग्राम</char></note> अऊ पांच जोड़ा ओनहा दीस। <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />अऊ अपन ददा बर ओह ये सामान पठोईस: मिसर देस के सबले बने चीजमन ले लदाय दस ठन गदहा, अऊ अनाज अऊ रोटी अऊ ओकर ददा के रसता बर आने भोजन-बस्तु ले लदाय दस ठन गदही। <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />तब ओह अपन भाईमन ला बिदा करिस, अऊ जब ओमन जावत रिहिन, त ओह ओमन ला कहिस, “डहार म झगरा झन करिहव!”<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />मिसर ले निकलके, ओमन कनान देस म अपन ददा याकूब करा आईन। <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />ओमन ओला ये बताईन, “यूसुफ अभी तक ले जीयत हे! अऊ जम्मो मिसर देस म ओही ह राज करत हे।” ये सुनके, याकूब ह हक्का-बक्का हो गीस; ओह ओमन के बात ला बिसवास नइं करिस। <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />पर जब ओमन ओ जम्मो बात ओला बताईन, जेला यूसुफ ह ओमन ले कहे रिहिस, अऊ जब ओह ओ गाड़ीमन ला देखिस, जेला यूसुफ ह ओला लाने बर पठोय रिहिस, तब ओमन के ददा याकूब के मन ह सांत होईस। <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />अऊ इसरायल ह कहिस, “मोला बिसवास हो गे हे! मोर बेटा यूसुफ ह अभी तक जीयत हे। एकर पहिली कि में मर जावंव, मेंह जाके ओला देखहूं।”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s1">याकूब मिसर देस जाथे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />तब इसरायल ह अपन जम्मो संपत्ति लेके निकलिस, अऊ जब ओह बेरसेबा म हबरिस, त उहां ओह अपन ददा इसहाक के परमेसर ला बलिदान चघाईस।<verse eid="GEN 46:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 46:2" />अऊ परमेसर ह रथिया इसरायल ला दरसन म कहिस, “हे याकूब! हे याकूब!”</para>
  <para style="p" vid="GEN 46:2">ओह कहिस, “में इहां हंव।”<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />परमेसर ह कहिस, “में परमेसर अंव, तोर ददा के परमेसर। तें मिसर देस जाय बर झन डरा, काबरकि में उहां तोर ले एक बड़े जाति बनाहूं। <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />मेंह तोर संग म मिसर जाहूं, अऊ निस्चित रूप से, में उहां ले तोला फेर वापिस ले आनहूं। अऊ यूसुफ ह अपन हांथ ले तोर आंखीमन ला बंद करही।”<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />तब याकूब बेरसेबा ले चल दीस, अऊ इसरायल के बेटामन अपन ददा याकूब अऊ अपन लइकामन ला अऊ अपन घरवालीमन ला ओ गाड़ीमन म चघाके चल दीन, जेला फिरौन ह ओमन ला लाने बर पठोय रिहिस। <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />ये किसम ले, याकूब अऊ ओकर संतानमन अपन भेड़-बकरी, गाय-बईला, अऊ कनान म कमाय अपन जम्मो धन-दौलत ला लेके मिसर देस गीन। <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />याकूब ह अपन संग अपन बेटा-बेटी, पोता-पोती, याने अपन जम्मो संतान ला मिसर म ले आईस।<verse eid="GEN 46:7" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="8" style="v" sid="GEN 46:8" />इसरायल (याकूब अऊ ओकर संतान) के बेटामन के नांव ये अय, जऊन मन ओकर संग मिसर देस गीन:</para>
  <para style="b" vid="GEN 46:8" />
  <para style="li1" vid="GEN 46:8">याकूब के बड़खा बेटा रूबेन।<verse eid="GEN 46:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="GEN 46:9" />रूबेन के बेटामन:</para>
  <para style="li2" vid="GEN 46:9">हनोक, पल्लू, हेसरोन अऊ करमी।<verse eid="GEN 46:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 46:10" />सिमोन के बेटामन:</para>
  <para style="li2" vid="GEN 46:10">यमूएल, यामीन, ओहद, याकीन, सोहर अऊ कनानी माईलोगन ले जनमे साऊल।<verse eid="GEN 46:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 46:11" />लेवी के बेटामन:</para>
  <para style="li2" vid="GEN 46:11">गेरसोन, कहात अऊ मरारी।<verse eid="GEN 46:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 46:12" />यहूदा के बेटामन:</para>
  <para style="li2" vid="GEN 46:12">एर, ओनान, सेलह, पेरेस अऊ जेरह (पर एर अऊ ओनान कनान देस म ही मर गे रिहिन)।</para>
  <para style="li2" vid="GEN 46:12">पेरेस के बेटामन:</para>
  <para style="li3" vid="GEN 46:12">हेसरोन अऊ हामूल।<verse eid="GEN 46:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 46:13" />इस्साकार के बेटामन:</para>
  <para style="li2" vid="GEN 46:13">तोला, पुआ, यसूब<note caller="+" style="f"><char style="fr" closed="false">46:13 </char><char style="ft" closed="false">समारीतान पेन्टाटूक अऊ कुछू सेप्टाजिन्ट हस्तलिपि म </char><char style="fqa" closed="false">यासूब </char><char style="ft" closed="false">देखव <char style="xt"><ref loc="NUM 26:24">गन 26:24</ref></char> अऊ <char style="xt"><ref loc="1CH 7:1">1 इति 7:1</ref></char></char></note> अऊ सिमरोन।<verse eid="GEN 46:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 46:14" />जबूलून के बेटामन:</para>
  <para style="li2" vid="GEN 46:14">सेरेद, एलोन अऊ यहलेल।<verse eid="GEN 46:14" /></para>
  <para style="lf">
    <verse number="15" style="v" sid="GEN 46:15" />येमन याकूब के घरवाली लिआ ले पदन-अराम<note caller="+" style="f"><char style="fr" closed="false">46:15 </char><char style="ft" closed="false">याने कि, उत्तर-पछिम मेसोपोटामिया</char></note> म जनमे बेटामन रिहिन। ओकर दीना नांव के एक बेटी घलो रिहिस। ओकर ये बेटा अऊ बेटीमन कुल तैंतीस झन रिहिन।<verse eid="GEN 46:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="GEN 46:16" />गाद के बेटामन:</para>
  <para style="li2" vid="GEN 46:16">सिफियोन, हाग्गी, सूनी, एसबोन, एरी, अरोदी अऊ अरेली।<verse eid="GEN 46:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 46:17" />आसेर के बेटामन:</para>
  <para style="li2" vid="GEN 46:17">यिमना, इसवा, इसवी, बरीया। ओमन के बहिनी के नांव सेरह रिहिस।</para>
  <para style="li2" vid="GEN 46:17">बरीया के बेटामन:</para>
  <para style="li3" vid="GEN 46:17">हेबेर अऊ मलकीएल।<verse eid="GEN 46:17" /></para>
  <para style="lf">
    <verse number="18" style="v" sid="GEN 46:18" />येमन याकूब कोति ले जिलपा ले जनमे लइकामन रिहिन, जेला लाबान ह अपन बेटी लिआ ला दासी के रूप म देय रिहिस। येमन कुल सोलह झन रिहिन।<verse eid="GEN 46:18" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="19" style="v" sid="GEN 46:19" />याकूब के घरवाली राहेल के बेटामन:</para>
  <para style="li2" vid="GEN 46:19">यूसुफ अऊ बिनयामीन।<verse eid="GEN 46:19" /></para>
  <para style="li3">
    <verse number="20" style="v" sid="GEN 46:20" />मिसर देस म, ओन<note caller="+" style="f"><char style="fr" closed="false">46:20 </char><char style="ft" closed="false">याने कि, हिलियापुलिस</char></note> के पुरोहित पोतीपेरा के बेटी आसनत ले यूसुफ के दू झन बेटा होईन—मनस्से अऊ एपरैम।<verse eid="GEN 46:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="GEN 46:21" />बिनयामीन के बेटामन:</para>
  <para style="li2" vid="GEN 46:21">बेला, बेकेर, असबेल, गेरा, नामान, एही, रोस, मुप्पीम, हुप्पीम अऊ अर्द।<verse eid="GEN 46:21" /></para>
  <para style="lf">
    <verse number="22" style="v" sid="GEN 46:22" />येमन याकूब के घरवाली राहेल ले जनमे बेटामन रिहिन। येमन कुल चौदह झन रिहिन।<verse eid="GEN 46:22" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="23" style="v" sid="GEN 46:23" />दान के बेटा:</para>
  <para style="li2" vid="GEN 46:23">हूसीम।<verse eid="GEN 46:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 46:24" />नपताली के बेटामन:</para>
  <para style="li2" vid="GEN 46:24">यहसेल, गूनी, येसेर अऊ सिल्लेम।<verse eid="GEN 46:24" /></para>
  <para style="lf">
    <verse number="25" style="v" sid="GEN 46:25" />येमन याकूब कोति ले बिलहा ले जनमे बेटामन रिहिन, जेला लाबान ह अपन बेटी राहेल ला दासी के रूप म देय रिहिस। येमन कुल सात झन रिहिन।<verse eid="GEN 46:25" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="26" style="v" sid="GEN 46:26" />ओ जम्मो, जऊन मन याकूब के संग मिसर म गीन अऊ ओकर खुद के बंस रिहिन—ओमन कुल छियासठ झन रिहिन अऊ येमा ओकर बहुमन ला नइं गने गे रिहिस। <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />यूसुफ के दू झन बेटा मिसर म जनमिन; येमन अऊ याकूब के घराना के जऊन मनखेमन मिसर म गीन, ओ जम्मो मिलाके कुल सत्तर<note caller="+" style="f"><char style="fr" closed="false">46:27 </char><char style="ft" closed="false">सेप्टाजिन्ट हस्तलिपि म </char><char style="fqa" closed="false">पचहत्तर</char></note> झन रिहिन।<verse eid="GEN 46:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />याकूब ह यहूदा ला अपन आघू यूसुफ करा पठोईस कि ओह ओकर ले गोसेन के डहार के पता करय। जब ओमन गोसेन के इलाका म आईन, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />तब यूसुफ ह अपन रथ फंदवाके अपन ददा इसरायल ले भेंट करे बर गोसेन गीस। जब ओह अपन ददा करा हबरिस, त ओला पोटारके बहुंत देर तक रोईस।<verse eid="GEN 46:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30" />इसरायल ह यूसुफ ला कहिस, “में अब मरे बर तियार हंव, काबरकि में खुद देख चुकेंव कि तें जीयत हस।”<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />तब यूसुफ ह अपन भाईमन ला अऊ अपन ददा के घर के मनखेमन ला कहिस, “मेंह जाके फिरौन ले गोठियाहूं अऊ ओला बताहूं, ‘मोर भाईमन अऊ मोर ददा के घर के मनखे, जेमन कनान देस म रहत रिहिन, ओमन मोर करा आ गे हवंय। <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />ओमन चरवाहा अंय; ओमन पसु-पालन करथें, अऊ ओमन अपन संग अपन भेड़-बकरी, गाय-बईला अऊ अपन जम्मो सामान लेके आय हवंय।’ <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />जब फिरौन ह तुमन ला बलाके पुछही, ‘तुमन का धंधा करथव?’ <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />तब तुमन ये कहिहू, ‘तोर सेवकमन लइकापन ले लेके आज तक पसु-पालन करत आय हन, अऊ हमर पुरखामन घलो अइसने ही करत रिहिन।’ तब तुमन ला गोसेन के इलाका म रहे बर मिलही, काबरकि मिसरीमन जम्मो चरवाहामन ले घिन करथें।”<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />यूसुफ ह फिरौन करा जाके ये समाचार दीस, “मोर ददा अऊ भाईमन अपन भेड़-बकरी, गाय-बईला अऊ अपन जम्मो सामान सहित कनान देस ले आ गे हवंय अऊ अभी ओमन गोसेन म हवंय।” <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />ओह अपन भाईमन ले पांच झन ला चुनिस अऊ ओमन ला फिरौन करा लानिस।<verse eid="GEN 47:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3" />फिरौन ह ओकर भाईमन ले पुछिस, “तुमन के का धंधा अय?”</para>
  <para style="p" vid="GEN 47:3">ओमन फिरौन ला कहिन, “तोर सेवकमन चरवाहा अंय, अऊ हमर पुरखामन घलो चरवाहा रिहिन।” <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />ओमन ओला ये घलो कहिन, “हमन इहां कुछू समय तक रहे बर आय हन, काबरकि कनान म भारी अकाल परे हे अऊ तोर सेवकमन के पसु बर कुछू चारा नइं बचे हे। एकरसेति, किरपा करके अपन सेवकमन ला गोसेन म रहे के हुकूम दे।”<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />फिरौन ह यूसुफ ला कहिस, “तोर ददा अऊ तोर भाईमन तोर करा आय हवंय, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />अऊ मिसर देस तोर आघू म हवय; ये देस के सबले बने भाग म अपन ददा अऊ अपन भाईमन ला बसा दे, याने कि ओमन ला गोसेन म ही रहन दे। अऊ यदि तें जानत हस कि ओमा के कोनो म बिसेस योग्यता हवय, त ओला मोर पसुमन के ऊपर मुखिया ठहिरा दे।”<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />तब यूसुफ ह अपन ददा याकूब ला फिरौन करा लेके आईस। जब याकूब ह फिरौन ला आसीस दे डारिस, <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />तब फिरौन ह याकूब ले पुछिस, “तोला कतेक साल होवथे?”<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />याकूब ह फिरौन ला कहिस, “मेंह एक सौ तीस बछर परदेसी होके अपन जिनगी जी डारे हंव। मोर जिनगी के उमर ह थोरकून रिहिस अऊ कठिन रिहिस अऊ मोर पुरखामन परदेसी होके जतेक बछर तक जीयत रिहिन, में ओतेक बछर के नइं होय हंव।” <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />तब याकूब ह फिरौन ला आसीस देके ओकर आघू ले चल दीस।<verse eid="GEN 47:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11" />तब यूसुफ ह अपन ददा अऊ अपन भाईमन ला मिसर देस म बसा दीस, अऊ फिरौन के हुकूम के मुताबिक देस के सबले बने भाग, याने कि रामसेस नांव के जिला म ओमन ला जमीन दीस। <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />यूसुफ ह अपन ददा ला अऊ अपन भाईमन ला अऊ अपन ददा के घर के जम्मो मनखेमन ला ओमन के लइकामन के गनती के मुताबिक भोजन-बस्तु घलो दीस।<verse eid="GEN 47:12" /></para>
  <para style="s1">यूसुफ अऊ अकाल</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />ओ जम्मो देस म खाय बर कुछू नइं रिहिस, काबरकि बहुंत भारी अकाल परे रिहिस; मिसर अऊ कनान म बहुंत कठिन समय रिहिस। <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />मिसर अऊ कनान के मनखेमन जऊन रूपिया-पईसा देके अनाज बिसात रिहिन, ओ जम्मो रूपिया ला यूसुफ ह जमा करके फिरौन के महल म ले आवत रिहिस। <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />जब मिसर अऊ कनान देस के मनखेमन के रूपिया ह सिरा गीस, त मिसर के जम्मो मनखेमन यूसुफ करा आईन अऊ कहिन, “हमन ला भोजन-बस्तु दे। का तोर रहत ले हमन मर जाबो? हमर जम्मो पईसा सिरा गे।”<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />यूसुफ ह कहिस, “यदि रूपिया नइं ए, त अपन पसुमन ला लानव, अऊ में ओकर बदला म तुमन ला भोजन-बस्तु दूहूं, काबरकि तुम्हर पईसा ह सिरा गे हे।” <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />एकरसेति ओमन अपन पसुमन ला यूसुफ करा लाय लगिन, अऊ ओह ओमन ला ओमन के घोड़ा, भेड़-बकरी, गाय-बईला अऊ गदहामन के बदला म भोजन-बस्तु देय लगिस। ओ साल ओह ओमन के जम्मो पसुमन के बदला म भोजन-बस्तु देके ओमन के पालन-पोसन करिस।<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />ओ बछर तो अइसने कट गीस, तब अगले साल ओमन ओकर करा आके कहिन, “हमन अपन मालिक ले ये बात ला छिपा नइं सकन कि हमर रूपिया-पईसा खतम हो गे अऊ हमर पसुमन तोर हो गे हंय; अब हमर मालिक के आघू म हमर करा हमर देहें अऊ जमीन के छोंड़ अऊ कुछू नइं बांचे हे। <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />हमन तोर देखत म काबर मर जावन, अऊ हमर जमीन ह काबर उजाड़ हो जावय? हमन ला अऊ हमर जमीन ला भोजन-बस्तु के बदला म बिसा ले, अऊ हमन अपन जमीन सहित फिरौन के गुलामी म रहिबो। हमन ला बीजा दे कि हमन जीयत रहन अऊ मरन झन, अऊ जमीन ह उजाड़ झन होवय।”<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />तब यूसुफ ह मिसर के जम्मो जमीन ला फिरौन बर बिसा लीस। मिसर के जम्मो मनखेमन अपन जमीन बेच दीन, काबरकि उहां भयंकर अकाल परे रिहिस। जम्मो जमीन ह फिरौन के हो गीस, <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />अऊ यूसुफ ह मनखेमन ला मिसर देस के एक छोर ले लेके दूसर छोर तक गुलाम बना दीस।<note caller="+" style="f"><char style="fr" closed="false">47:21 </char><char style="ft" closed="false">समारीतान पेन्टाटूक अऊ सेप्टाजिन्ट (वल्गेट ला घलो देखव); मासोरेटिक अनुवाद </char><char style="fq" closed="false">अऊ </char><char style="fqa" closed="false">ओह मनखेमन ला सहर म ले आईस</char></note> <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />पर ओह पुरोहितमन के जमीन ला नइं बिसाईस, काबरकि ओमन ला फिरौन कोति ले नियम के मुताबिक बांटा मिलत रिहिस अऊ फिरौन के दुवारा दिये गय बांटा म ओमन बर परयाप्त भोजन के परबंध रिहिस। एकरसेति ओमन अपन जमीन नइं बेचिन।<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />यूसुफ ह मनखेमन ला कहिस, “सुनव, मेंह आज तुमन ला अऊ तुम्हर जमीन ला फिरौन बर बिसा ले हंव; देखव, तुमन बर इहां बीजा हवय; येला लेवव अऊ भुइयां म बोवव। <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />पर जब फसल होथे, त ओकर पांचवां हिस्सा फिरौन ला देवव। बाकि के चार हिस्सा तुम्हर होही, जेला तुमन खेत म बोये बर अऊ अपन अऊ अपन घर के मनखे अऊ लइकामन के खाय बर उपयोग करव।”<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />ओमन कहिन, “तेंह हमर जिनगी ला बंचाय हस; हमर परभू के किरपा के नजर हमर ऊपर बने रहय; हमन फिरौन के गुलामी म रहिबो।”<verse eid="GEN 47:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26" />ये किसम ले, यूसुफ ह मिसर के जमीन के बारे म येला कानून के रूप म कर दीस, जऊन ह आज तक लागू हवय कि फसल के पांचवां हिस्सा फिरौन के अय। सिरिप पुरोहितमन के जमीन ह फिरौन के नइं होईस।<verse eid="GEN 47:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />इसरायलीमन मिसर देस के गोसेन के इलाका म बस गीन। ओमन उहां धन-संपत्ति कमाईन अऊ फूलिन-फरिन अऊ गनती म बहुंत बढ़ गीन।<verse eid="GEN 47:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28" />याकूब ह मिसर देस म सतरह बछर तक जीयत रिहिस, अऊ ओकर जिनगी के कुल उमर एक सौ सैंतालीस बछर होईस। <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />जब इसरायल के मरे के समय ह लकठा आईस, तब ओह अपन बेटा यूसुफ ला बुलवाईस अऊ ओला कहिस, “यदि तोर किरपा मोर ऊपर हवय, त अपन हांथ ला मोर जांघ के तरी म रख अऊ परतिगियां कर कि तें मोर ऊपर किरपा करके सच्चई से ये काम ला करबे। मोला मिसर म माटी झन देबे, <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />पर जब में अपन पुरखामन के सहीं मर जावंव, त मोला मिसर ले बाहिर ले जाबे अऊ उहां माटी देबे, जिहां मोर पुरखामन ला माटी दे गे हवय।”</para>
  <para style="p" vid="GEN 47:30">तब यूसुफ ह कहिस, “में तोर बचन के मुताबिक करहूं।”<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />फेर याकूब ह कहिस, “मोर ले किरिया खा।” तब यूसुफ ह ओकर ले किरिया खाईस, अऊ इसरायल ह अपन लउठी के मुठ के ऊपर निहरके परमेसर के अराधना करिस।<note caller="+" style="f"><char style="fr" closed="false">47:31 </char><char style="ft" closed="false">या </char><char style="fq" closed="false">इसरायल </char><char style="fqa" closed="false">ह अपन बिस्तर के मुड़सरिया तरफ झुक गीस</char></note><verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s1">मनस्से अऊ एपरैम</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />कुछू समय के बाद, यूसुफ ला ये बताय गीस, “तोर ददा ह बेमार हे।” तब ओह अपन दूनों बेटा मनस्से अऊ एपरैम ला अपन संग लेके ओकर करा गीस। <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />जब याकूब ला बताय गीस, “तोर बेटा यूसुफ ह तोर करा आय हवय,” त इसरायल ह अपनआप ला संभालके बिस्तर म बईठ गीस।<verse eid="GEN 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3" />याकूब ह यूसुफ ला कहिस, “सर्वसक्तिमान<note caller="+" style="f"><char style="fr" closed="false">48:3 </char><char style="ft" closed="false">इबरानी म </char><char style="fqa" closed="false">एल-सद्दाई</char></note> परमेसर ह कनान देस के लूज नगर म मोला दरसन दीस, अऊ उहां ओह मोला आसीस दीस, <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />अऊ कहिस, ‘देख, में तोला फलवंत करहूं अऊ गनती म तोला बढ़ाहूं। मेंह तोला मनखेमन के एक समाज बनाहूं, अऊ तोर पाछू तोर संतानमन ला ये देस सदाकाल बर दे दूहूं।’<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />“अब, तोर दूनों बेटा, जऊन मन मिसर म मोर आय के पहिली जनमे हवंय, ओमन मोर गने जाहीं; जइसने कि रूबेन अऊ सिमोन मोर अंय, वइसने ही मनस्से अऊ एपरैम घलो मोर होहीं। <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />ओमन के बाद, तोर कोनो लइका जनमथें, त ओमन तोर होहीं; पर अपन बंटवारा म, ओमन अपन भाईमन के नांव म गने जाहीं। <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />जब में पदन<note caller="+" style="f"><char style="fr" closed="false">48:7 </char><char style="ft" closed="false">पदन-अराम या उत्तर-पछिम मेसोपोटामिया</char></note> ले वापिस आवत रहेंव, त मोर बर दुख के बात ये होईस कि डहार म ही एपराता हबरे के थोरकून पहिले, राहेल ह कनान देस म मर गीस। एकरसेति मेंह ओला उहां एपराता (बैतलहम) जाय के डहार तीर म माटी दे देंव।”<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />जब इसरायल ह यूसुफ के बेटामन ला देखिस, त ओह पुछिस, “येमन कोन एं?”<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />यूसुफ ह अपन ददा ला कहिस, “ये मोर बेटामन अंय, जेमन ला परमेसर ह मोला इहां दे हवय।”</para>
  <para style="p" vid="GEN 48:9">तब इसरायल ह कहिस, “ओमन ला मोर करा लान कि में ओमन ला आसीस देवंव।”<verse eid="GEN 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10" />इसरायल के आंखीमन बुढ़ापा के कारन धुंधला गे रिहिन, अऊ ओला बहुंत कम दिखत रिहिस। एकरसेति यूसुफ अपन बेटामन ला ओकर लकठा म ले आईस, अऊ ओकर ददा ह ओमन ला चूमिस अऊ ओमन ला पोटार लीस।<verse eid="GEN 48:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 48:11" />तब इसरायल ह यूसुफ ला कहिस, “में कभू आसा नइं करे रहेंव कि में तोर चेहरा फेर देखहूं, पर देख, परमेसर ह मोला तोर लइकामन ला घलो देखाईस।”<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />तब यूसुफ ह अपन बेटामन ला इसरायल के माड़ीमन के बीच ले हटाईस अऊ अपन मुहूं के भार गिरके दंडवत करिस। <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />अऊ यूसुफ ह ओ दूनों ला लीस, अऊ एपरैम ला अपन जेवनी कोति, याने कि इसरायल के डेरी हांथ कोति अऊ मनस्से ला अपन डेरी कोति, याने कि इसरायल के जेवनी हांथ कोति रखिस, अऊ ओमन ला इसरायल के लकठा म लानिस। <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />पर इसरायल ह अपन जेवनी हांथ बढ़ाके एपरैम के मुड़ ऊपर रखिस, हालाकि ओह छोटे रिहिस, अऊ अपन डेरी हांथ बढ़ाके मनस्से के मुड़ ऊपर रख दीस, हालाकि मनस्से ह पहिले जनमे रिहिस।<verse eid="GEN 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15" />तब ओह यूसुफ ला आसीस दीस अऊ कहिस,</para>
  <para style="q1" vid="GEN 48:15">“परमेसर जेकर आघू म मोर बाप-ददा</para>
  <para style="q2" vid="GEN 48:15">अब्राहम अऊ इसहाक सच्चई से चलिन,</para>
  <para style="q1" vid="GEN 48:15">ओ परमेसर, जऊन ह मोर जनम ले लेके</para>
  <para style="q2" vid="GEN 48:15">आज तक मोर चरवाहा बने हे,<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />ओ स्वरगदूत, जऊन ह मोला जम्मो बुरई ले बचाय हे</para>
  <para style="q2" vid="GEN 48:16">—ओही ह ये लड़कामन ला आसीस देवय।</para>
  <para style="q1" vid="GEN 48:16">येमन मोर नांव अऊ मोर बाप-ददा</para>
  <para style="q2" vid="GEN 48:16">अब्राहम अऊ इसहाक के नांव से जाने जावंय,</para>
  <para style="q1" vid="GEN 48:16">अऊ येमन धरती ऊपर</para>
  <para style="q2" vid="GEN 48:16">गनती म बहुंत बढ़ंय।”<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />जब यूसुफ ह देखिस कि ओकर ददा ह अपन जेवनी हांथ एपरैम के मुड़ ऊपर रखे हे, त ये बात ओला खराप लगिस; एकरसेति ओह अपन ददा के जेवनी हांथ ला ये बिचार से धरिस कि ओला एपरैम के मुड़ ले हटाके मनस्से के मुड़ ऊपर रखय। <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />अऊ यूसुफ ह अपन ददा ला कहिस, “नइं, हे ददा, येह पहिले जनमे हे; अपन जेवनी हांथ ला एकर मुड़ ऊपर रख।”<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />पर ओकर ददा ह मना करिस अऊ कहिस, “में जानत हंव, मोर बेटा, में जानत हंव। एकर दुवारा घलो मनखेमन के एक समाज बनही, अऊ येह घलो महान होही। तभो ले एकर छोटे भाई एकर ले जादा महान होही, अऊ ओकर बंस ह कतको जाति के मनखेमन के एक झुंड हो जाही।” <verse eid="GEN 48:19" /><verse number="20" style="v" sid="GEN 48:20" />ओ दिन, ओह ओमन ला आसीस दीस अऊ कहिस,</para>
  <para style="q1" vid="GEN 48:20">“तोर नांव म इसरायल ह अइसन आसीस दीही:</para>
  <para style="q2" vid="GEN 48:20">‘परमेसर तोला एपरैम अऊ मनस्से के सहीं बनाय।’ ”</para>
  <para style="m" vid="GEN 48:20">ये किसम ले ओह एपरैम ला मनस्से के पहिले रखिस।<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />तब इसरायल ह यूसुफ ला कहिस, “देख, में तो मरनेवाला हंव, पर परमेसर ह तुमन के संग रहिही, अऊ तुमन ला तुम्हर पुरखामन के देस म वापिस ले जाही। <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />अऊ मेंह तोला तोर भाईमन ले एक ठन जादा पहाड़ी जमीन<note caller="+" style="f"><char style="fr" closed="false">48:22 </char><char style="fq" closed="false">पहाड़ी जमीन </char><char style="ft" closed="false">इबरानी म सकेम नांव के जगह सहीं</char></note> देवत हंव, जेला मेंह अमोरीमन ले अपन तलवार अऊ धनुस के बल म ले रहेंव।”<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s1">याकूब अपन बेटामन ला आसीस देथे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />तब याकूब ह अपन बेटामन ला बलाके कहिस: “ये मेर जूरव ताकि में तुमन ला बता सकंव कि अवइया दिन म तुम्हर ऊपर का होवइया हे।<verse eid="GEN 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />“हे याकूब के बेटामन, ये मेर जूरव अऊ सुनव;</para>
  <para style="q2" vid="GEN 49:2">अपन ददा इसरायल के बात ला सुनव।<verse eid="GEN 49:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />“रूबेन, तें मोर पहिले जनमे बेटा अस,</para>
  <para style="q2" vid="GEN 49:3">तें मोर सक्ति अऊ मोर ताकत के पहिली फर अस,</para>
  <para style="q2" vid="GEN 49:3">तें आदर के लईक, अऊ ताकत म उत्तम अस।<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />तें जो पानी के लहरा सहीं उफननेवाला अस, तें अब उत्तम नइं ठहिरबे,</para>
  <para style="q2" vid="GEN 49:4">काबरकि तें अपन ददा के बिछौना ऊपर चघे,</para>
  <para style="q2" vid="GEN 49:4">मोर खटिया ऊपर चघे अऊ ओला असुध करे।<note caller="+" style="f"><char style="fr" closed="false">49:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 35:22">उत 35:22</ref></char></char></note><verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />“सिमोन अऊ लेवी तो भाई-भाई अंय—</para>
  <para style="q2" vid="GEN 49:5">ओमन के तलवारमन हिंसा करे के हथियार अंय।<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />मोला ओमन के सभा म झन जाना पड़य,</para>
  <para style="q2" vid="GEN 49:6">मोला ओमन के संगत म झन रहना पड़य,</para>
  <para style="q1" vid="GEN 49:6">काबरकि ओमन अपन कोप म मनखेमन ला मार डारे हवंय</para>
  <para style="q2" vid="GEN 49:6">अऊ अपन खुसी बर बईलामन ला खोरवा कर दे हवंय।<note caller="+" style="f"><char style="fr" closed="false">49:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 34:26">उत 34:26</ref></char></char></note><verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />धिक्कार ए ओमन के कोप ला, जेह भयंकर रिहिस,</para>
  <para style="q2" vid="GEN 49:7">अऊ ओमन के कोरोध ला, जेह बहुंत निरदयी रिहिस!</para>
  <para style="q1" vid="GEN 49:7">मेंह ओमन ला याकूब म फईला दूहूं</para>
  <para style="q2" vid="GEN 49:7">अऊ इसरायल म तितिर-बितिर कर दूहूं।<verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />“हे यहूदा,<note caller="+" style="f"><char style="fr" closed="false">49:8 </char><char style="fq" closed="false">यहूदा </char><char style="ft" closed="false">सायद इबरानी म </char><char style="fqa" closed="false">परसंसा</char></note> तोर भाईमन तोर परसंसा करहीं;</para>
  <para style="q2" vid="GEN 49:8">तोर हांथ ह तोर बईरी के घेंच म होही;</para>
  <para style="q2" vid="GEN 49:8">तोर ददा के बेटामन तोला दंडवत करहीं।<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />हे यहूदा, तेंह सेर के पीला अस;</para>
  <para style="q2" vid="GEN 49:9">हे मोर बेटा, तें सिकार करके लहुंटे हस।</para>
  <para style="q1" vid="GEN 49:9">सेर के सहीं, ओह बरताव करके बईठ जाथे,</para>
  <para style="q2" vid="GEN 49:9">सेरनी के सहीं—कोन ह ओला छेड़े के हिम्मत करथे।<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />राजदंड ह यहूदा करा ले नइं जावय,</para>
  <para style="q2" vid="GEN 49:10">अऊ न ही सासन करइया के छड़ी ह ओकर बंस ले अलग होही,</para>
  <para style="q1" vid="GEN 49:10">जब तक कि ओह<note caller="+" style="f"><char style="fr" closed="false">49:10 </char><char style="ft" closed="false">अवइया मसीह के बारे अगमबानी हो सकथे</char></note> नइं आ जाही, जेकर ये चीजमन अंय</para>
  <para style="q2" vid="GEN 49:10">अऊ जाति-जाति के मनखेमन ओकर बस म नइं हो जाहीं।<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />ओह अपन गदहा ला अंगूर के नार म,</para>
  <para style="q2" vid="GEN 49:11">अऊ अपन गदहा के पीला ला उत्तम नार म बांधही;</para>
  <para style="q1" vid="GEN 49:11">ओह अपन ओनहा ला अंगूर के मंद म,</para>
  <para style="q2" vid="GEN 49:11">अऊ अपन पहिरावा ला अंगूर के रस म धोही।<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />ओकर आंखीमन अंगूर के मंद ले जादा गहिरा रंग,</para>
  <para style="q2" vid="GEN 49:12">अऊ ओकर दांतमन दूध ले जादा सफेद होहीं।<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />“जबूलून ह समुंदर के तीर म निवास करही</para>
  <para style="q2" vid="GEN 49:13">अऊ पानी जहाजमन बर बंदरगाह के काम करही;</para>
  <para style="q2" vid="GEN 49:13">ओकर सीमना ह सीदोन कोति बढ़ही।<verse eid="GEN 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />“इस्साकार एक बलवान गदहा अय,</para>
  <para style="q2" vid="GEN 49:14">जेह भेड़मन के भेड़साला म ढलंगे रहिथे।<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />जब ओह देखथे कि ओकर सुसताय के जगह ह कतेक बने हे</para>
  <para style="q2" vid="GEN 49:15">अऊ ओकर जमीन ह कतेक मनोहर हे,</para>
  <para style="q1" vid="GEN 49:15">त ओह बोझा ला लेय बर अपन कंधा ला नवाथे</para>
  <para style="q2" vid="GEN 49:15">अऊ बंधुवा मजदूर बन जाथे।<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />“दान<note caller="+" style="f"><char style="fr" closed="false">49:16 </char><char style="fq" closed="false">दान </char><char style="ft" closed="false">इहां येकर मतलब ए </char><char style="fqa" closed="false">ओह नियाय देथे</char></note> ह इसरायल के एक गोत्र के रूप म</para>
  <para style="q2" vid="GEN 49:16">अपन मनखेमन के नियाय करही।<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />दान ह सड़क के तीर म एक सांप,</para>
  <para style="q2" vid="GEN 49:17">रसता के तीर म एक जहरिला सांप सहीं होही,</para>
  <para style="q1" vid="GEN 49:17">जेह घोड़ा के एड़ी ला डसथे,</para>
  <para style="q2" vid="GEN 49:17">जेकर ले ओकर सवार ह पाछू कोति गिरथे।<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />“हे यहोवा, में तोर दुवारा छुटकारा पाय के बाट जोहत हंव।<verse eid="GEN 49:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />“गाद<note caller="+" style="f"><char style="fr" closed="false">49:19 </char><char style="fq" closed="false">गाद </char><char style="ft" closed="false">इबरानी म </char><char style="fq" closed="false">हमला करइया</char></note> के ऊपर हमला करइयामन के एक दल ह चढ़ई तो करही,</para>
  <para style="q2" vid="GEN 49:19">पर ओह ओमन के पाछू कोति ले ओमन ऊपर हमला करही।<verse eid="GEN 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />“आसेर के भोजन-बस्तु ह उत्तम होही;</para>
  <para style="q1" vid="GEN 49:20">अऊ ओह एक राजा के पसंद के सुवादवाला भोजन देय करही।<verse eid="GEN 49:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />“नपताली ह खुले म घुमनेवाला एक हिरनी सहीं अय,</para>
  <para style="q2" vid="GEN 49:21">जऊन ह सुघर पीला जनथे।<verse eid="GEN 49:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />“यूसुफ एक फलवंत अंगूर के नार सहीं ए,</para>
  <para style="q2" vid="GEN 49:22">ओह एक झरना के लकठा म एक फलवंत अंगूर के नार सहीं ए,</para>
  <para style="q2" vid="GEN 49:22">जेकर डालीमन भीथी ऊपर चघके बगर जाथें।<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />धनुसधारीमन दुखी होके ओकर ऊपर हमला करिन;</para>
  <para style="q2" vid="GEN 49:23">अऊ बईरता करके ओकर ऊपर तीर चलाईन।<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />पर ओकर धनुस इस्थिर रिहिस,</para>
  <para style="q2" vid="GEN 49:24">याकूब के सक्तिसाली परमेसर के हांथ के कारन,</para>
  <para style="q1" vid="GEN 49:24">ओ चरवाहा, इसरायल के चट्टान के कारन,</para>
  <para style="q2" vid="GEN 49:24">ओकर बाहांमन फुरतिला होईन,<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />काबरकि तोर ददा के परमेसर ह तोर मदद करथे,</para>
  <para style="q2" vid="GEN 49:25">काबरकि सर्वसक्तिमान ह तोला आसीस देथे,</para>
  <para style="q1" vid="GEN 49:25">ये आसीस ह अकास के ऊपर के अय,</para>
  <para style="q2" vid="GEN 49:25">ये आसीस ह गहिरा झरना के खाल्हे के अय,</para>
  <para style="q2" vid="GEN 49:25">अऊ ये आसीस ह छाती अऊ गरभ के आसीस अय।<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />तोर ददा के आसीसमन</para>
  <para style="q2" vid="GEN 49:26">पुराना पहाड़मन के आसीस ले,</para>
  <para style="q2" vid="GEN 49:26">पुराना पहाड़ीमन के दान ले घलो बड़े अंय।</para>
  <para style="q1" vid="GEN 49:26">ये जम्मो आसीस यूसुफ के मुड़ म आवय,</para>
  <para style="q2" vid="GEN 49:26">जऊन ह अपन भाईमन ले अलग होके राजा बन गीस, ओकर ललाट म आवय।<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />“बिनयामीन ह एक भूखा भेड़िया सहीं अय;</para>
  <para style="q2" vid="GEN 49:27">बिहनियां ओह सिकार ला मन भरके खाथे,</para>
  <para style="q2" vid="GEN 49:27">अऊ सांझ के लूट के सामान ला बांट लेथे।”<verse eid="GEN 49:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />ये जम्मो इसरायल के बारह गोत्र अंय, अऊ ये ओ बातमन अंय, जेला ओमन के ददा ह ओमन ले कहिस जब ओह ओमन ला आसीस दीस; जइसने हर एक बर उचित रिहिस, वइसने ओह ओमन ला आसीस दीस।<verse eid="GEN 49:28" /></para>
  <para style="s1">याकूब के मऊत</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />तब याकूब ह ओमन ला हुकूम दीस: “बहुंत जल्दी मेंह मरके अपन पुरखामन संग मिलनेचवाला हंव। मोला हित्ती एपरोन के खेत के गुफा म मोर पुरखामन संग माटी दूहू, <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />याने कि ओ गुफा म जेह कनान देस म ममरे के लकठा म मकपेला के खेत म हवय, जेला अब्राहम ह हित्ती एपरोन ले खेत सहित एकरसेति बिसाय रिहिस कि ओला मरघटी बनावय। <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />उहां अब्राहम अऊ ओकर घरवाली सारा ला माटी देय गे रिहिस; उहां इसहाक अऊ ओकर घरवाली रिबका ला माटी देय गे रिहिस; अऊ उहां लिआ ला घलो माटी दे हंव। <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />ओ खेत अऊ ओमा के गुफा ला हित्तीमन ले बिसाय गे रिहिस।”<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />जब याकूब ह अपन बेटामन ला हुकूम दे डारिस, त ओह अपन गोड़ ला खटिया ऊपर करके अपन परान ला छोंड़ दीस अऊ अपन पुरखामन संग जा मिलिस।<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />यूसुफ अपन ददा ला पोटारके रोईस अऊ ओला चूमिस। <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />तब यूसुफ ह अपन अधीन सेवा करइया बईदमन ला हुकूम दीस कि ओमन ओकर ददा इसरायल के लास म सुगंधित लेपन लगांय। तब बईदमन ओकर लास म सुगंधित रसायन लगा दीन। <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />ओमन पूरा चालीस दिन तक सुगंधित रसायन लगाईन, काबरकि कोनो लास म सुगंधित रसायन लगाय बर अतेक दिन के जरूरत परय। अऊ मिसरी मनखेमन ओकर बर सत्तर दिन तक बिलाप करिन।<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />जब बिलाप करे के दिन पूरा हो गीस, तब यूसुफ ह फिरौन के घर के मनखेमन ला कहिस, “यदि तुम्हर किरपा मोर ऊपर हवय, त मोर कोति ले फिरौन ले बात करव। ओला कहव, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />‘मोर ददा ह मोर ले किरिया खवाके कहे रिहिस, “देख, में मरनेचवाला हंव; मोला ओ कबर म माटी देबे, जेला मेंह अपन बर कनान देस म खनवाय हंव।” एकरसेति अब मोला उहां जाके मोर ददा ला माटी देवन दे; ओकर बाद, में वापिस आ जाहूं।’ ”<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />फिरौन ह कहिस, “जा अऊ अपन ददा के खवाय किरिया के मुताबिक ओला माटी दे।”<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />तब यूसुफ ह अपन ददा ला माटी दे बर गीस। फिरौन के जम्मो करमचारी याने कि ओकर घर के सम्मानित मनखे अऊ मिसर देस के जम्मो सम्मानित मनखेमन ओकर संग गीन, <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />संग म यूसुफ के घर के जम्मो झन अऊ ओकर भाईमन अऊ ओकर ददा के घर के जम्मो मनखेमन घलो गीन। सिरिप ओमन के लइका अऊ भेड़-बकरी अऊ गाय-बईलामन गोसेन के इलाका म छूट गीन। <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />रथ अऊ घुड़सवारमन<note caller="+" style="f"><char style="fr" closed="false">50:9 </char><char style="ft" closed="false">या </char><char style="fqa" closed="false">सारथीमन</char></note> घलो ओकर संग म गीन। येह मनखेमन के एक बड़े दल रिहिस।<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />जब ओमन यरदन नदी के लकठा म, आताद के कोठार करा हबरिन, त ओमन उहां दुख ले भरे भारी बिलाप करे लगिन; अऊ उहां यूसुफ ह अपन ददा बर सात दिन तक सोक मनाईस। <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />जब ओ कनानी, जऊन मन उहां रहत रिहिन, आताद के कोठार करा बिलाप करत देखिन, त ओमन कहिन, “येह मिसरीमन के दुख ले भरे गंभीर बिलाप ए।” ओकरे कारन यरदन नदी के लकठा म ओ जगह के नांव आबेल-मिसरैम<note caller="+" style="f"><char style="fr" closed="false">50:11 </char><char style="fq" closed="false">आबेल-मिसरैम </char><char style="ft" closed="false">के मतलब होथे </char><char style="fq" closed="false">मिसरीमन </char><char style="fqa" closed="false">के </char><char style="fq" closed="false">बिलाप</char></note> परिस।<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />इसरायल के बेटामन ठीक वइसने करिन, जइसने ओह ओमन ला हुकूम दे रिहिस: <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />याने कि ओमन ओला कनान देस म ले गीन अऊ ममरे के लकठा म, मकपेला के खेत के ओ गुफा म ओला माटी दीन, जेला अब्राहम ह हित्ती एपरोन ले खेत समेत एकरसेति बिसाय रिहिस कि ओह ओमन के मरघटी होवय। <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />अपन ददा ला माटी देय के बाद, यूसुफ ह मिसर देस लहुंट गीस, अऊ ओकर संग ओकर भाई अऊ ओ जम्मो झन, जेमन ओकर ददा ला माटी देय बर गे रिहिन, ओ जम्मो मनखे घलो मिसर देस लहुंट गीन।<verse eid="GEN 50:14" /></para>
  <para style="s1">यूसुफ ह अपन भाईमन ला फेर बिसवास देवाथे</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />जब यूसुफ के भाईमन देखिन कि ओमन के ददा मर गे हे, तब ओमन कहे लगिन, “यदि यूसुफ के मन म हमर बर बईरता होही, अऊ जतेक खराप काम हमन ओकर संग करे रहेंन, ओह ओकर बदला लीही, त का करबो।” <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />एकरसेति ओमन यूसुफ करा ये खबर भेजिन, “तोर ददा ह मरे के पहिली हमन ला ये हुकूम दे रिहिस, <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />‘तुमन यूसुफ ला अइसने कहिहू: मेंह कहत हंव कि तोर संग गलत बरताव करके तोर भाईमन तोर बिरूध म जऊन पाप अऊ अपराध करे रिहिन, ओकर बर तें ओमन ला छेमा कर।’ अब किरपा करके अपन ददा के परमेसर के सेवकमन के पाप ला छेमा कर।” ओमन के ये बात ला सुनके यूसुफ रो डारिस।<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />ओकर बाद, ओकर भाईमन आईन अऊ ओकर आघू म गिरके कहिन, “देख, हमन तोर गुलाम अन।”<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />पर यूसुफ ह ओमन ला कहिस, “झन डरावव। का में परमेसर के जगह म हंव? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />तुम्हर इरादा मोर संग हानि करे के रिहिस, पर परमेसर ह एकर दुवारा भलई करे के बिचार करिस, जऊन ह अब बहुंते झन के जिनगी बचाय के दुवारा पूरा होवत हे। <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />एकरसेति, अब झन डरावव। मेंह तुम्हर अऊ तुम्हर लइकामन के पालन-पोसन करहूं।” अऊ ओह ओमन ला फेर बिसवास देवाईस अऊ ओमन के संग बने ढंग से गोठियाईस।<verse eid="GEN 50:21" /></para>
  <para style="s1">यूसुफ के मऊत</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />यूसुफ अपन ददा के जम्मो घराना समेत मिसर म रहत रिहिस। ओह एक सौ दस बछर जीईस <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />अऊ तीसर पीढ़ी तक एपरैम के लइकामन ला देखे पाईस। मनस्से के बेटा, माकीर के लइकामन घलो जनम के बाद यूसुफ के कोरा म रखे गीन।<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />तब यूसुफ ह अपन भाईमन ला कहिस, “में तो मरनेचवाला हंव। पर परमेसर जरूर तुम्हर मदद करही अऊ तुमन ला ये देस ले निकालके ओ देस म ले जाही, जेकर परतिगियां ओह किरिया खाके अब्राहम, इसहाक अऊ याकूब ले करे रिहिस।” <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />अऊ यूसुफ ह इसरायलीमन ला किरिया खवाईस अऊ कहिस, “परमेसर जरूर तुम्हर मदद करे बर आही, अऊ तब तुमन मोर हाड़ामन ला ये जगह ले ओ देस म जरूर ले जावव।”<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />ये किसम ले यूसुफ ह एक सौ दस बछर के उमर म मर गीस। अऊ ओमन ओकर लास म सुगंधित लेपन लगाईन, अऊ ओला मिसर म मुरदा रखे के एक सन्दूक म रख दीन।<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>