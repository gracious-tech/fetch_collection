<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Biblica® Open Chhattisgarhi Contemporary Version</book>
  <para style="h">यहूदा</para>
  <para style="toc1">यहूदा के चिट्ठी</para>
  <para style="toc2">यहूदा</para>
  <para style="toc3">यहू</para>
  <para style="mt1">यहूदा</para>
  <para style="mt2">के चिट्ठी</para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="po">
    <verse number="1" style="v" sid="JUD 1:1"/>ये चिट्ठी ह यीसू मसीह के सेवक अऊ याकूब के भाई यहूदा के तरफ ले,</para>
  <para style="po" vid="JUD 1:1">ओमन ला लिखे जावत हे, जऊन मन परमेसर के दुवारा बलाय गे हवंय, जऊन मन परमेसर ददा के मयारू अंय अऊ जऊन मन यीसू मसीह खातिर रखे गे हवंय:<verse eid="JUD 1:1"/></para>
  <para style="po">
    <verse number="2" style="v" sid="JUD 1:2"/>तुमन ला परमेसर के दया, सांति अऊ मया बहुंतायत ले मिलय।<verse eid="JUD 1:2"/></para>
  <para style="s1">अधरमीमन के पाप अऊ ओमन के बिनास</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>हे मयारू संगीमन हो, हालाकि मेंह तुमन ला उद्धार के बारे म लिखे बर बहुंत उत्सुक रहेंव, जऊन म हमन सहभागी हवन, पर मेंह ये जरूरी समझेंव कि तुमन ला लिखंव अऊ बिनती करंव कि तुमन ओ बिसवास खातिर पूरा मेहनत करव, जऊन ला परमेसर ह अपन पबितर मनखेमन ला जम्मो के सेति एकेच बार म दे हवय। <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>काबरकि कुछू मनखेमन गुपत रूप ले तुमन म आके मिल गे हवंय, जऊन मन के दंड के हुकूम बहुंत पहिली ले लिखे गे हवय। ओमन अधरमी मनखे अंय। ओमन हमर परमेसर के अनुग्रह ला दुराचार म बदल देथें अऊ हमर एकेच परमपरधान परभू यीसू मसीह के इनकार करथें।<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>हालाकि तुमन ये जम्मो बात ला पहिली ले जानत हव, पर मेंह सुरता कराय चाहत हंव कि परभू<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">कुछू सुरू के हस्तलिपि म </char><char style="fqa" closed="false">यीसू </char><char style="ft" closed="false">लिखाय हवय</char></note> ह अपन मनखेमन ला मिसर देस ले एक बार छोंड़ाईस, पर बाद म ओमन ला नास कर दीस, जऊन मन बिसवास नइं करिन। <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>अऊ ओ स्वरगदूत, जऊन मन अपन अधिकार के सीमना म नइं रिहिन अऊ स्वरग म अपन खुद के घर ला तियाग दीन—ओमन ला परमेसर ह नियाय के महान दिन खातिर अंधियार म, सदाकाल के बेड़ी म बांधके रखे हवय। <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>एही किसम ले सदोम, अमोरा अऊ आसपास के सहर के मनखेमन अपनआप ला छिनारी काम अऊ खराप चालचलन म लगाईन। येमन ओमन बर एक नमूना ठहिरिन, जऊन मन सदाकाल के आगी के सजा भोगत हवंय।<verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>ओहीच किसम ले, ये मनखेमन सपना म अपन खुद के देहें ला असुध करथें; परमेसर के परभूता के इनकार करथें, अऊ स्वरगीय जीवमन ला बदनाम करथें। <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>अऊ त अऊ परधान स्वरगदूत मिकाएल ह जब सैतान के संग अगमजानी मूसा के लास के बारे म बिवाद करत रिहिस, त ओह सैतान ऊपर बदनामी के दोस लगाय के हिम्मत नइं करिस, पर ये कहिस, “परभू ह तोला दबकारय।” <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>पर ये मनखेमन, जऊन बातमन ला नइं समझंय, ओकर बारे म खराप गोठ गोठियाथें, अऊ जऊन बातमन ला, येमन जंगली पसुमन के सहीं सरल रूप म जानथें, ओहीच बातमन येमन ला नास कर दीहीं।<verse eid="JUD 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JUD 1:11"/>येमन ऊपर हाय! काबरकि येमन कैन के डहार म चलथें; येमन फायदा खातिर, बिलाम के सहीं गलती करथें; येमन कोरह के सहीं बिदरोह करथें, अऊ ओकरे सहीं नास हो जाथें।<verse eid="JUD 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12"/>ये मनखेमन तुम्हर मया के जेवनार म गंदगी के सहीं अंय, येमन तुम्हर संग बेसरम सहीं खाथें-पीथें अऊ सिरिप अपनआप के खियाल रखथें। येमन बिगर पानी के बादर अंय, जऊन ला हवा उड़ा ले जाथे। येमन पतझड़ के ओ रूख सहीं अंय, जऊन म फर नइं लगय अऊ उखाने जाथें अऊ दूबारा मर जाथें। <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>येमन समुंदर के भयानक लहरा सहीं अंय, जऊन मन अपन लाज के फेन ला निकालथें। येमन किंदरत तारामन सहीं अंय, जेमन खातिर परमेसर ह सदाकाल बर घोर अंधियार ठहिराय हवय।<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>हनोक, जऊन ह आदम के सातवां पीढ़ी के रिहिस, ये मनखेमन के बारे म ये अगमबानी करे रिहिस, “देखव, परभू ह हजारों-हजार अपन पबितर स्वरगदूतमन संग आवत हवय <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>ताकि हर एक के नियाय करय, अऊ ओ जम्मो अधरमीमन ला दोसी ठहिराय, जऊन मन कुकरम करके अधरम के काम करे हवंय, अऊ परमेसर के बिरोध म ओ जम्मो कठोर बचन, ये अधरमी पापीमन कहे हवंय।” <verse eid="JUD 1:15"/><verse number="16" style="v" sid="JUD 1:16"/>ये मनखेमन कुड़कुड़ावत अऊ आने ऊपर दोस लगावत रहिथें; येमन अपन खुद के खराप ईछा के मुताबिक चलथें; येमन अपन खुद के बड़ई मारथें अऊ अपन खुद के फायदा बर दूसर के चापलूसी करथें।<verse eid="JUD 1:16"/></para>
  <para style="s1">बिसवास म बने रहव</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>पर, हे मयारू संगवारीमन हो, तुमन ओ बातमन ला सुरता करव, जऊन ला हमर परभू यीसू मसीह के प्रेरितमन तुमन ला पहिली कहे रिहिन। <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>ओमन तुमन ला कहे रिहिन, “आखिरी समय म, ठट्ठा करइयामन होहीं, जऊन मन अपन खुद के खराप ईछा के मुताबिक चलहीं।” <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>येमन ओ मनखे अंय, जऊन मन तुम्हर बीच म फूट डारथें; येमन अपन संसारिक ईछा के मुताबिक चलथें अऊ येमन करा पबितर आतमा नइं ए।<verse eid="JUD 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20"/>पर हे मयारू संगवारीमन, तुमन अपनआप ला अपन परम पबितर बिसवास म बढ़ावव, अऊ पबितर आतमा के सामर्थ म पराथना करव। <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>अपनआप ला परमेसर के मया म बनाय रखव, अऊ हमर परभू यीसू मसीह के दया के बाट जोहत रहव, जऊन ह तुमन ला परमेसर के संग सदाकाल के जिनगी दीही।<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>जऊन मन बचन ऊपर संका करथें, ओमन ऊपर दया करव; <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>आने मन ला लबरा गुरूमन के सिकछा ले बचावव, जइसने तुमन कोनो ला आगी ले खींचके बचाथव; भय के संग आने मन ऊपर दया करव; पर ओ मनखेमन के ओ ओनहा ले घलो घिन करव, जऊन म ओमन के पापी सरीर के दाग लगे हवय।<verse eid="JUD 1:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>अब जऊन ह तुमन ला गिरे ले बचा सकथे अऊ तुमन ला निरदोस अऊ बड़े आनंद के संग ओकर महिमा ला देखा सकथे— <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>ओहीच एके परमेसर, हमर उद्धार करइया के महिमा, गौरव, पराकरम अऊ अधिकार, हमर परभू यीसू मसीह के जरिये सनातन काल, अब अऊ सदाकाल तक होवत रहय। आमीन।<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
