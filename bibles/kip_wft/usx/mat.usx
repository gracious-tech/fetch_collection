<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Sheshi Kham</book>
  <para style="h">मत्ती</para>
  <para style="toc3">मत्ती</para>
  <para style="toc2">मत्ती</para>
  <para style="toc1">मत्तीले आसरन्या चान्याथाई</para>
  <para style="mt2">मत्तीले लेखेको चान्याथाई</para>
  <para style="mt1">मत्तीले आसरन्या चान्याथाई</para>
  <para style="imt">किटापल आशई</para>
  <para style="ip">मत्तीलं अनुसार छार नियामला चान्याथाईल चार किटापयाङ मध्य ईका तोलोअ हो, जोले येशु ख्रीस्टल जिबनल बर्नन ढोवा। ना सोगलैजन “चान्याथाई” ऐढासिया, जोल अर्थ चान्याथाई हो। ना किटापयाङ येशु आसिऊ छिन्ट मत्ती, मर्कुसं, लूका सनर यहुन्नाङन सरसिन्या लेऊ। बिद्वानयाङजन मत्तीलं अनुसार चान्याथाई खक सरसिस्यु लेऊ ऐलेन्या ठ्याक्कै मिति थाह माल्दी, तर ईका सक्या: ख्रीस्टल जरम छ्योअछ्योअ ६० बर्स छिन्टा छेन हो। सनर ईका काङ सरसिऊ हो ऐलेन्या पो थाह माल्दी, तर भ्याईले अनुमान ढोरा कि आका प्यालेस्टाइनलं सनर सक्या यरुशलेम सहरल बै सरसिन्या लेऊ। सरन्या मत्ती ज्या, जो येशुले ङासिइ ताहन्ते ऐआलेऊ हादेए कर उठाइन्या रु लेऊ। ओलजन लेबील मिनले बै शईसिया। मत्ती बारं प्रेरितयाङ मध्य तोलोअ हो ओटन ओले यहूदी परीन्याङल नाल्ट आसरस्योवाङ। पुरानो नियामला पबित्रशास्त्रलं ६० तन भ्याई सन्दर्भयाङ्ङन ईका छरलङ्गै रङौ दुदुसिया। नकाले येशु ख्रीस्ट परमेस्वरलं छेल्सिन्या मुक्तिदाता हो ऐलेस्यु पानौ आरोकौ, बारेल भबिस्यबानी ढास्यु लेसिऊ। मत्तीले बै परमेस्वरलं राज्यल बारेल तबर आसरौ। यहूदीयाङै ख्रीस्ट राजनितिक राज्यल रय ताइन्या आसा रांढोव। मत्तीले परमेस्वरलं आध्यात्मिक राज्यल बर्नन ढास्यु नका बिस्वासजन चुनौति यांऔ नाल्ट भ्याई साबधान आअपनाहौ। मत्तीलं अनुसार छार नियाम चान्याथाई सुरु ढाऔ नाल्ट ईका चान्या किटाप हो दानाङभन्या इकाल सोगलै सन्दर्भयाङ पुरानो नियामला लेरा। इकाले नेंलोअ नियामयाङजन जुरिवा। बिद्वानयाङै आका सल्ला बै यांस्यु लेरा कि मत्तीले मोशाल किटापयाङ मन्जै नक्कल ढाऔ आरोअज्यान्या ताहौ ढुदुवा, जो पुरानो नियामला पैला पास किटापयाङ हो। येशुल डान्डाता सिक्छ्या <char style="xt"><ref loc="MAT 5-7">५—७</ref> </char>जन परमेस्वरले मोशाजन ब्यबस्था आया:न्यासं दान्जिऊ दुदुसिया। <char style="xt"><ref loc="DEU 19-23">ब्यबस्था १९—२३</ref></char></para>
  <para style="iot">रुप रेखा:</para>
  <para style="io1">येशु ख्रीस्टल जरम सनर ओलं सेवाकाईल सुरुवाटल बारेल पानौयन चान्याथाई सुरु ढोवा। मत्तीलं अध्याय <char style="ior"><ref loc="MAT 1-4">१—४</ref> </char></para>
  <para style="io1">मत्तीले छुट्टै अध्यायल येशुलं सेवाकाई सनर ओलं तबर सिक्छ्याङल बर्नन ढोवा। <char style="ior"><ref loc="MAT 5-25">५—२५</ref> </char></para>
  <para style="io1">मत्तीलं आखिरीत खन्ड येशुल सिइ सनर पुनरुत्थानत ओलं सेवाकाईल झेनन्याल बारेत हो। <char style="ior"><ref loc="MAT 26-28">२६—२८</ref> </char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">येशुल बङशवाल</para>
  <para style="r">
    <ref loc="LUK 3:23-38">लूका ३:२३-३८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />आका अब्राहामल ज़ा दाऊदल ज़ा येशु ख्रीस्टल बङशावलील टिप्पनी हो। <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />अब्राहाम इसहाकलं बौ लेऊ। इसहाक याकूबल बौ लेऊ। याकूब यहूदा सनर नकाल आदाज्यू भाईयाङल बौ लेऊ। <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />यहूदा सनर फारेसलं बौ जाहेर लेऊ, न्याअमा तामार लेऊ, फारेस हेस्रोनल बौ, हेस्रोन आरामल बौ, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />आराम अम्मीनादाबल बौ अम्मीनादाब नहशोनल बौ नहशोन सल्मोनल बौ,<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="RUT 4:19-20">रुथ ४:१९-२०</ref></char></note> <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />सल्मोन बोअजल बौ आअमा राहाब लेऊ, ओबेदल बौ। ओबेदल आअमा रुथ लेऊ, ओबेद यिशैल बौ, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />यिशै दाऊद रयल बौ लेऊ, दाऊद सोलोमनल बौ लेऊ, ओटन सोलोमनल आअमा उरियाहल मेएमा लेऊ।<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2SA 12:24">२शमूयल १२:२४</ref></char></note> <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />सोलोमन रहबामल बौ, रहबाम अबियाल बौ, अबिया आसालं बौ, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />आसा यहोशापातल बौ, यहोशापात यहोरामल बौ, यहोराम उज्जियाहल बौ, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />उज्जियाह योतामल बौ, योताम आहाजल बौ, आहाज हिजकियाल बौ, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />हिजकिया मनश्शेलं बौ, मनश्शे अम्मोनल बौ, अम्मोन योसियाहल बौ, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />योसियाह, यकोनियास सनर आभाईयाङल बौ लेऊ जब नकाङ बेबिलोनल यहूदीयाङजन बन्दी जाएस्यु रालाङौ ओइ बेला जर्मिस्यु लेवाङ।<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">२राजा २४:१४-१५</ref>; <ref loc="2CH 36:10">२इतिहास ३६:१०</ref>; <ref loc="JER 27:20">यर्मिया २७:२०</ref></char></note> <verse eid="MAT 1:11" /><verse number="12" style="v" sid="MAT 1:12" />शालतिएलल आबौ यकोनियास बेबिलोनल बन्दी जाएस्यु रालाङौल छिन्ट समन लिज्याऔ, शालतिएल यरुबाबेलल बौ, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />यरुबाबेल अबिउदल बौ, अबिउद एल्याकिमल बौ, एल्याकिम आजोरल बौ, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />आजोर सादोकल बौ, सादोक आखिमल बौ, आखिम एलिउदल बौ, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />एलिउद एलाजारल बौ, एलाजार मतानलं बौ, मतान याकूबल बौ, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />ईकाइ याकूब ज्या योसेफल बौ, जोल आमेएमा मरियम हो, ईकाइ मरियमङन्ज येशुल जन्म ताइस्यु लेऊ, जोजन ख्रीस्ट<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">ख्रीस्ट=अबिसिक्त</char></note> ऐढासिऊ। <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />नैताइस्यु अब्राहामतन दाऊद समन चौध पुस्ता ताइवाङ, सनर दाऊदल पालाक बेबिलोनल राहुलिसिऊ समन चौध पुस्ता, ओटन बेबिलोनल बन्दी रालेऊकन ख्रीस्टल पाला समन चौध पुस्ता ताइस्यु लेवाङ।<verse eid="MAT 1:17" /></para>
  <para style="s">येशु ख्रीस्टल जरम</para>
  <para style="r">
    <ref loc="LUK 2:1-7">लूका २:१-७</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />येशुल जन्म ऐटाइन्या किसिमले ताहौ, कि येशुल आमा मरियमजन योसेफल कुईत वाङस्यु लेवाङ, तर नकानेल नेंब्याहा आमाताहौ हादेए मरियम पबित्र आत्माङन गुरभ्यानि आताइन्या रा:सनौ।<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="LUK 1:17">लूका १:१७</ref></char></note> <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />तर मरियमलं आयो योसेफ धार्मिक रु आताहौकाले मरियमजन लाजल मापराइन्या बिचार ढास्यु नाजन गोप्यलै राइन्या यिङ आढोव। <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />तर जब योसेफले ईका छेन यिङज्याऊ, आमङल परमप्रभुल दुत रंनस्यु ओलजन ऐआढोव, “ऐ, योसेफ दाऊदल ज़ा, न मेएमा मरियमजन अपनाइस्यु नझिम लाङन्या ताछ्यातन, दानाङभन्या नकाल गर्बल लिज्यान्या पबित्र आत्माङन्ता हो। <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />नकाले तोलोअ ज़ा जर्माइवा, ओटन नङ ओलं मिन येशु नाएस्योना दानाङभन्या येशुले आरुयाङजन रा: पापतन बचाइन्या लेया।”<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="PSA 46:1">भजनसङ्ग्रह ४६:१</ref>; <ref loc="LUK 1:31">लूका १:३१</ref> </char></note><verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />परमप्रभुले अगमबक्ताङन आछ्योङन्या बचन पुरा ताहौ नाल्टैज ईका सोगलै ताहौ हो,<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="ISA 7:14">यशैया ७:१४</ref></char></note> <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“ब्याएते, कनन्या गुरभ्यानि ताइन्यालेया ओटन नाले तोलोअ ज़ा जर्माइन्यालेया ओटन ओलं मिन इम्मानुएल नाएन्या लेसिया,” जोल अर्थ हो “परमेस्वर गे सकाए।”<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">यशैया ७:१४</ref></char></note> <verse eid="MAT 1:23" /><verse number="24" style="v" sid="MAT 1:24" />जब योसेफ म्वाईस्यु सन्सिऊ तब परमप्रभुल दुतले ओलजन आपानस्यान्या अनुसार नाले मरियमजन आमेएमाल हिसापत झिमल आहोनौ। <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />मरियमले ज़ा आमाजर्माहौ समन योसेफ नका सकाए मारुउदा जब छिन्ट ज़ा जर्मिऊ तब योसेफले ओलं मिन येशु आनाटौ।<note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">लूका २:२१</ref></char></note><verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">पुर्बङन ज्योतिसयाङ येशुजन ब्याएरावाङ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />हेरोद रयल पालाक यहूदिया प्रदेसला बेथलेहेम सहरल येशु जर्मिया पाइना, पुर्ब देसङन ज्योतिसीयाङ यरुशलेम सहरल ताप्‌रावाङ, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />ओटन ऐलेस्यु रांगिन्वाङ “यहूदीयाङल रय ताइस्यु जर्मिस्यु काङ लिज्याऔ? दानाङभन्या गे ओलं हरवए पुर्बङन पलिईस्यु आरांज्यान्या गेरङयिउ ओटन ओजन ढोक गे योरायिउ।”<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="NUM 24:17">गन्ती २४:१७</ref></char></note><verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />जब ईका थएवापाइना हेरोद रय भ्याईज आतिऊ, ओटन नका सकाए सोगल यरुशलेम सहरला रुयाङ बै आतिवाङ। <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />ओटन नकाले सोगलै मुख्या पुजाउरोयाङ सनर जन्ताङल शास्त्रीयाङजन आदुउवाङ, ओटन ख्रीस्टल जन्म काङ ताइन्यारैस लेस्यु ग्यानगिन आढोवाङ।<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />ओयाङै नकाजन ऐराढोव, यहूदियाला बेथलेहेम सहर। दानाङभन्या अगमबक्ताङ्ङन ऐटाइन्या सरसिन्या लेया:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“ऐ बेथलेहेम, ‘यहूदा प्रदेसला नङ्गर’</para>
  <para style="q2" vid="MAT 2:6">नङ यहूदाला शासकयाङ खार्ल काङ्काईतन बै क्याइसिन्या मालेन्दी,</para>
  <para style="q1" vid="MAT 2:6">दानाङभन्या नङ्ङन तोलोअ शासक पलिईस्यु रांन्यालेया,</para>
  <para style="q2" vid="MAT 2:6">ओले इस्राएलला ङा रुयाङजन डोऱ्याहौरा।”<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">मीका ५:२</ref></char></note><verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />तब हेरोदले पुर्बङन रांन्या ज्योतिसीयाङजन गोप्यल खुल्स्यु हरवए ख्वाएबेला रंनौ, ना नकाङल्योङन पत्ता आलाहौ। <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />नकाले ओयाङजन ऐढास्यु बेथलेहेमल आपरिङवाङ, “हिन्चिते, ओटन चान्यासं नका बालअजन रोअचिते। नकाजन डोएच्योकन ङाजन पानस्याङच्यो, ओटन ङा बै हिनस्यु नाजन ढोक योंङा।”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />तब रयल छेन थएस्यु नकाङ रा:यम लागिवाङ। जो हरवए नकाङै पुर्ब देए रांरङौ, नका हरवए नकाङल हा-हा हिनौ ओटन बालअ आलन्या पोल ताप्‌रा पाइनाई ना हरवए नलै अद्दिउ। <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />जब ओयाङै ना हरवए रांरङौ, तब नकाङ भ्याई आनन्द ताइवाङ।<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="LUK 2:20">लूका २:२०</ref></char></note> <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />ओटन झिम भितरलं रा:हिनौक नकाङै बालअ येशुजन आअमा मरियम सकाए आलिज्यान्या रा:रङौ, ओटन गोम लेस्यु येशुजन ढोक रा:योव। तब झिली पलाअस्यु येशुजन सुन, आस्युउनमन्या धुप सनर मुर्रल<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">मुर्र = तकिसिमला कोमिफेरा राढान्या सिङल रस जो धर्मल हिसापत चलाइसिया नका धुप, सेन्ट,</char></note> भिटी रांचराहौ।<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />ओटन हेरोद ल्योङ वलस्यु ताहिनच्यो ऐलेन्या रा: मङलं चेताउनी डोएस्यु नकाङ छुट्टै यम ताइस्यु रा: देसलं वल्वाङ।<verse eid="MAT 2:12" /></para>
  <para style="s">मिस्र देसदेए राहिनन्या</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />नकाङ रांहिनौ छिन्ट परमप्रभुल तोलोअ दुत योसेफल मङलं रंनौ, ओटन ओले ऐआढोव, “ऐ, सोन्ते इङन्या बालअ सनर आअमाजन लाङस्यु मिस्र देसदेए ढोङचिते, ओटन जब समन ङा मापानस्यान तब समन नङै चुङचिते। दानाङभन्या हेरोदले बालअजन सटौ नाल्ट रोअज्याऔ।”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />ओटन योसेफ सोस्यु बालअ सनर आअमाजन ओलसं लाङस्यु ओइ रिउ मिस्र देसलं हिन्वाङ, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />ओटन हेरोद आमासिऊ समन नङै चुङवाङ। अगमबक्ताङ्ङन परमप्रभुले आपानन्या बचन ऐलेस्यु पुरा ताहा, “ङा ङाज़ाजन मिस्र देसङन ङाखुल्ङु।”<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">होशे ११:१</ref></char></note><verse eid="MAT 2:15" /></para>
  <para style="s">हेरोदले बालअयाङजन सटौ आपरिङन्या</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />तब ज्योतिसीयाङै ओलजन धोखा रायांन्या हेरोदले आसनौ, ओटन नका रिईले चिरिऊ ताहौ। ओटन ज्योतिसीयाङ रापानन्या बेला अनुसार बेथलेहेम सनर नका पो भितरला नें बर्सतन वान्देएङा सोगलै बालअयाङजन सटौ आपरिङवाङ।<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />ऐलेस्यु यर्मिया अगमबक्ताले आपानन्या बचन पुरा ताहौ।<verse eid="MAT 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 2:18" />“रामाल तोलोअ ग़ा थहौ, जोरसै आव्‌रन्या सनर आतिइस चिचच्याइस्यु, राहेल आलुलल्याङल नाल्ट आव्‌रज्यान्या, सानत्वना नकाले आमासुइकारिऊ, दानाङभन्या नकाल लुलल्याङ आब मालज्यादुरा।”<note caller="-" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">यर्मिया ३१:१५</ref></char></note><verse eid="MAT 2:18" /></para>
  <para style="s">मिस्र देसङन रावलन्या</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />हेरोद आसिऊ छिन्ट, परमप्रभुल तोलोअ स्वर्गदुत योसेफल मङलं मिस्रल रंनौ, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />ओटन ऐआढोव, “सोन्ते, बालअ सनर आअमाजन इस्राएल देसलं लाङस्यु हिनन्ते, दानाङभन्या जोयाङै बालअल परान होनौ रारोकौ नकाङ सिदुरा।”<note caller="-" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="EXO 4:20">प्रस्थान ४:२०</ref></char></note><verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />योसेफ सोस्यु बालअ सनर आअमाजन ओलसं रएस्यु इस्राएल देसलं वलस्यु रांवाङ।<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />तर जब ईका आथटौ कि यहूदियाल अर्खिलाउसले आबौ हेरोदल पोल राज्य चलाइज्याऊ नैताइस्यु योसेफ ओदेए हिनन्या छ्याटौ, ओटन मङलं चेताउनी डोएस्यु नकाङ गालील प्रदेसलं हिन्वाङ। <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />नकाङ नासरत ऐढासिन्या सहरल हिनस्यु चुङवाङ। ऐलेस्यु अगमबक्ताङ रांछ्योङन्या बचन पुरा ताहौ: “ओजन नासरी ऐढान्या लेसिया।”<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="ISA 11:1">यशैया ११:१</ref>; <ref loc="ISA 4:2">४:२</ref>; <ref loc="ISA 42:6">४२:६</ref>; <ref loc="MRK 1:24">मर्कुस १:२४</ref>; <ref loc="LUK 2:39">लूका २:३९</ref>; <ref loc="JHN 1:45">यहुन्ना १:४५</ref></char></note><verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">बप्तिस्मा-यांन्या यहुन्नाल प्रचार</para>
  <para style="r">
    <ref loc="MRK 1:1-8">मर्कुस १:१-८</ref>; <ref loc="LUK 3:1-18">लूका ३:१-१८</ref>; <ref loc="JHN 1:19-28">यहुन्ना १:१९-२८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />नकाए बेला बप्तिस्मा यांन्या यहुन्ना यहूदिया प्रदेसला हरहरताइन्या पोल रा:औ, ओटन ऐलेस्यु प्रचार ढाऔ तअसिऊ, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />“ओले ऐआढोवाङ, पस्चाताप ढोचिते, दानाङभन्या स्वर्गला राज्य नेराकै रा:स्यु लेया।”<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">मत्ती ४:१७</ref>; <ref loc="MRK 1:15">मर्कुस १:१५</ref></char></note> <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />आका नकाई ज्या, जोल बारेङन यशैया अगमबक्ताङन ऐटाइन्या पानस्यु लेसिऊ:</para>
  <para style="q" vid="MAT 3:3">“हरहरताइन्या पोल तोलोअ कलिऊन्याल ग़ा,</para>
  <para style="q" vid="MAT 3:3">‘परमप्रभुल यम तयार जाएचिते,</para>
  <para style="q" vid="MAT 3:3">ओलं नाल्ट जेयिङ सोझा जाएचिते’।”<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यशैया ४०:३</ref></char></note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />यहुन्नाले ऊटल भूत्लाल क्वा क्वाएसिन्या ढोवा, ओटन आकम्बरत छालाल पिटी पोअसिया। नकाले सोलो<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">कोस्योअ=सोलो</char></note> सनर बनमह ज्यान्या ढोवा।<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">२राजा १:८</ref></char></note> <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />यरुशलेम सहर सनर यहूदिया भरि, ओटन यर्दन भईल नावङजिऊला स्वाट्टै रुयाङ नका ल्योङ रांवाङ, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />ओटन रा: पाप सुइकार ढास्यु यर्दन भईल नका ल्योङन बप्तिस्मा होनौ तअसिवाङ।<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />तर जब यहुन्नाले फरिसीयाङ सनर सदुकीयाङ मध्य तबर जनाले बप्तिस्मा होन्ङालेस्यु राराज्यान्या आरङवाङ तब ओयाङजन ऐआढोवाङ, “ऐ डाङल पुङयाङ, रांङालेन्या परमेस्वरलं रिईतन बचिच्यालेस्यु जेजन काङ्काले चेताउनी आयांचिऊ?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">मत्ती १२:३४</ref>; <ref loc="MAT 23:33">२३:३३</ref></char></note> <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />नैताइस्यु जे पस्चाताप ढास्यु सुवाइसिन्या जाए शशैचिते। <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />अब्राहाम जै गे बौ ज्या ऐलेस्यु जे जेल ऐतालेच्यो। दानाङभन्या ङा जेजन ऐढाच्या, परमेस्वरले आका लुङयाङतन, अब्राहामल नाल्ट सन्तान सिर्जाहौ ढुदुवा।<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">यहुन्ना ८:३३</ref></char></note> <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />आकैज रवा सिङल रिंनल परीस्यु लेया। नैताइस्यु चान्या शई माशशैन्या सोगलै टुङजन पलस्यु ढलाइसिया, ओटन मील क्याइसिया।”<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">मत्ती ७:१९</ref></char></note> <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />“ङाता जेजन पस्चातापल नाल्ट रीले बप्तिस्मा यांच्या, तर ङाछिन्ट रांन्या ङातन अझै सक्तिशाली लेया, ङा ओलं जुता वुरन्या लायकला मालेङदी। ओले जेजन पबित्र आत्मा सनर मीले बप्तिस्मा यांन्या लेया। <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />ओलं च्यापन्या नाङ्गला आकुईतै लेया, ओटन ओले आखलाए पुरै सफा ढान्यालेन्या, ओटन आमि पलीमा धन्सारल दुउन्यालेया, तर पुलजन खकै मासिन्या मील हिपन्यालेया।”<verse eid="MAT 3:12" /></para>
  <para style="s">येशुल बप्तिस्मा</para>
  <para style="r">
    <ref loc="MRK 1:9-11">मर्कुस १:९-११</ref>; <ref loc="LUK 3:21-22">लूका ३:२१-२२</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />नवाए बेला येशु गालीलङन यर्दन भईल यहुन्ना ल्योङ बप्तिस्मा होन्‌रांऔ। <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />तर यहुन्नाले येशुजन ऐलेस्यु रुकिऊ आरोकौ दानाङ नङ ङाल्योङ रांन, “बरु ङादी नल्योङन बप्तिस्मा होनन्या आबस्यक लेऊ?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />तर येशुले नाजन ऐआढोव, “आकअल नाल्ट ऐज ग्याताइत्या, दानाङभन्या गे सोगलैले ऐलेस्युजै परमेस्वरलं इच्छ्याला काम पुरा ढान्याताहा, ऐढोवा पाइना” बल्ल यहुन्ना भनौ। <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />ओटन येशुले बप्तिस्मा हिनस्यु रीलन आपलिहौ चोएटै, स्वर्ग फएसिऊ, ओटन ओले आयर्त परमेस्वरलं आत्माजन कचिकुरमन्जै आलाइरांज्यान्या आरङौ।<verse eid="MAT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 3:17" />तब स्वर्गतन ऐआलन्या ग़ा थहौ, “ईका ङायिङ्का ज़ा हो, जोश ङा भ्याई खुशी लेङा।”<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="GEN 22:2">उत्पत्ति २२:२</ref>; <ref loc="PSA 2:7">भजनसङ्ग्रह २:७</ref>; <ref loc="ISA 42:1">यशैया ४२:१</ref>; <ref loc="MAT 12:18">मत्ती १२:१८</ref>; <ref loc="MAT 17:5">१७:५</ref>; <ref loc="MRK 1:11">मर्कुस १:११</ref>; <ref loc="LUK 9:35">लूका ९:३५</ref></char></note><verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">येशुल परिक्छ्या</para>
  <para style="r">
    <ref loc="MRK 1:12-13">मर्कुस १:१२-१३</ref>; <ref loc="LUK 4:1-13">लूका ४:१-१३</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />तब येशुजन पबित्र आत्माले दियाबलसङन परिक्छ्या ढाऔ नाल्ट हरहरताइन्या पोल आलाङौ।<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">हिब्रू २:१८</ref>; <ref loc="HEB 4:15">४:१५</ref></char></note> <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />ओटन चालिस दिन, चालिस रिउ समन बर्त चुङापाइना येशु करेव।<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">प्रस्थान ३४:२८</ref></char></note> <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />तब सैतान आल्योङ रा:स्यु ऐआढोव, “यदि नङ परमेस्वरलं ज़ा ताहनकन ईका लुङयाङजन भरेई ताइचिते ऐलेस्यु आग्या योंवरते।”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />तर येशुले जबाक आयोव, “सरसिन्या लेया, ‘रु भरेईले याएज माङडी, तर परमेस्वरलं याह्‌लन पलिईन्या सोगल बचनले जिङदा लिज्याया’।”<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ब्यबस्था ८:३</ref></char></note><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />तब दियाबलसले येशुजन पबित्र सहर यरुशलेमला सोगलैतन झेनन्या मन्दिरलं यर्त लाङस्यु आसच्यानौ।<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="LUK 4:9">लूका ४:९</ref></char></note><verse eid="MAT 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 4:6" />ओटन ऐआढोव, “नङ परमेस्वरलं ज़ा ताहनकन, आटन मित जोकन्ते, दानाङभन्या ऐटाइन्या सरसिन्या लेया। ‘परमेस्वरले आदुतयाङजन आग्या योंवरा, ओटन नकाङै नङजन राकुई-कुईतै थामिनरा, ओटन नखङ लुङत ढुईसिऊ मायोरदी’।”<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">भजनसङ्ग्रह ९१:११-१२</ref></char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />येशुले नकाजन ऐआढोव, “तर सरसिन्या लेया, ‘नङ परमप्रभु नमी परमेस्वरलं परिक्छ्या ताढो’।”<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">ब्यबस्था ६:१६</ref></char></note><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />फरि येशुजन दियाबलसले तोलोअ झेनन्या डान्डात लाङस्यु सङ्सारला सोगलै राज्ययाङ सनर नकाङल सक्तियाङ ओलजन आथनस्यौ। <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />नकाले ऐआढोव, “यदि नङ ङाजन घुन्डा टिकिस्यु धोक यांङकन, ङा नका सोगलै जन्तु नङजन ऐयाना।”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />तब येशुले नकाजन ऐआढोव, “ऐ सैतान, नङ लोए ताहन्ते, दानाङभन्या सरसिन्या लेया, कि ‘नङ परमप्रभु न परमेस्वरजन धोक यों, ओटन ओलं सेवा ढो’।”<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ब्यबस्था ६:१३</ref></char></note><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />तब दियाबलसले येशुजन राइस्यु हिनौ, ओटन स्वर्गदुतयाङ रा:स्यु आसेवा ढाऔ तअसिवाङ।<verse eid="MAT 4:11" /></para>
  <para style="s">येशुले गालीललन आकाम सुरु आढोव</para>
  <para style="r">
    <ref loc="MRK 1:14-15">मर्कुस १:१४-१५</ref>; <ref loc="LUK 4:14-15">लूका ४:१४-१५</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />बप्तिस्मा यांन्या यहुन्ना हुलिसिदा ऐलेन्या थएस्यु, येशु गालील प्रदेस देए हिनौ।<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">मत्ती १४:३</ref>; <ref loc="MRK 6:17">मर्कुस ६:१७</ref>; <ref loc="LUK 3:19-20">लूका ३:१९-२०</ref></char></note> <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />ओटन नासरतलं माचुङस्यु गालील दहल वङला जबुलुन सनर नप्ताली इलाकाल, लेन्या कफर्नहुम सहरल चुङनाऊ।<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">यहुन्ना २:१२</ref></char></note> <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />यशैया अगमबक्ताले आपानन्या बचन ऐलेस्यु पुरा ताहौ।<verse eid="MAT 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 4:15" />“जबुलुनला मलुउ सनर नप्तालीला मलुउ यर्दन भईल हुदिन्ता यम, गैरयहूदीयाङ चुङन्या पो गालील,<note caller="-" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">यशैया ९:१-२</ref></char></note><verse eid="MAT 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MAT 4:16" />चिऊन्याल चुङन्या रुयाङै तोलोअ घिन्या ज्योति रङस्यु लेरा।</para>
  <para style="q" vid="MAT 4:16">सिइकालल जिरिऊला पोल चुङन्याङयर्त तोलोअ ज्योति चम्काईस्यु लेसिया।”<verse eid="MAT 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="MAT 4:17" />नवाए बेलाकन येशुले ऐलेस्यु प्रचार ढाऔ तअसिऊ “पस्चाताप ढोचिते, दानाङभन्या स्वर्गल राज्य नेराकै ताप्‌रा:स्यु लेया।”<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">मत्ती ३:२</ref></char></note><verse eid="MAT 4:17" /></para>
  <para style="s">येशुले चारगोटा ङा:स्या कोलोअन्याङजन आखुलन्या</para>
  <para style="r">
    <ref loc="MRK 1:16-20">मर्कुस १:१६-२०</ref>; <ref loc="LUK 5:1-11">लूका ५:१-११</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />गालील-दह वङवङ आबाज्याऔक येशुले पत्रुस ऐराढान्या सिमोन सनर आभाई अन्द्रियास, दुईभाईनेंजन दहल जाल नेंहोरज्यान्या आरङौने। दानाङभन्या नकाने ङा:स्या कोलोअज्याऊने। <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />येशुले नकानेजन आढोवने, “ङा छिन्ट लागिचिन्ते, ओटन ङा झेनजन रुयाङ कोलोअन्या जाएचिना।” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />तब नकाने ओचोएटै जालयाङ राइनिइस्यु आछिन्ट लागिऊने।<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />ओटन नलन राहिनज्याऔक येशुले छुट्टै दुईभाई, अथाबा जब्दियाल ज़ानें याकूब सनर नकाल आभाई यहुन्नाजन नेंबौ जब्दियास डोङ्गाल जाल नेंपएज्यान्या आरङौने, ओटन ओले नकानेजन आखुलौने। <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />तब ओचोएटै डोङ्गा सनर नें बौजन नकाने बनाएस्यु येशुल छिन्ट लागिऊने।<verse eid="MAT 4:22" /></para>
  <para style="s">गालीलल येशुल सेवाकाई</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />जब येशुले परमेस्वरलं राज्यल चान्याथाई प्रचार ढास्यु-ढास्यु यहूदीयाङ बैठअझिम जिऊल सिक्छ्या ह्युउकौयन, सनर रुयाङत लेन्या स्वाट्टै किसिमला नाएबोर सनर बुलला हूर सबेलौयन सोगल गालील प्रदेस भरिल दुलिऊ।<note caller="-" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">मत्ती ९:३५</ref>; <ref loc="MRK 1:39">मर्कुस १:३९</ref></char></note> <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />तब सिरियाभरि ओलं बाए फैलिऊ, ओटन तबर खालला नाएबोरले स्या हूरस्यु हलाअ ताइन्याङ, भूत लागिन्याङ, सनर चरिफाई लागिन्याङ, लुलाङ, सोगलैजन रुयाङै आल्योङ राहोनौ। ओले नकाङजन आसबेल्वाङ। <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />ओटन गालील प्रदेस, डेकापोलिस, यरुशलेम सहर, यहूदिया सनर यर्दन भई हुदिन्ता रुयाङल घिन्या हुल येशुल छिनछिन रांज्यावाङ।<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">डान्डाला उपदेश</para>
  <para style="r">
    <ref loc="MRK 1:16-20">मर्कुस १:१६-२०</ref>; <ref loc="LUK 5:1-11">लूका ५:१-११</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />येशुले रुयाङ हुलजन रङस्यु डान्डातं वूमौ, ओटन ओङै चुङापाइना आ सिइयाङ आल्योङ रांवाङ। <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />ओटन ओले नकाङजन ह्युउकौ तअसिऊ।<verse eid="MAT 5:2" /></para>
  <para style="s">मछ्यु हेसाङन्या</para>
  <para style="r">
    <ref loc="LUK 6:20-23">लूका ६:२०-२३</ref></para>
  <para style="q">
    <verse number="3" style="v" sid="MAT 5:3" />“बअचाऔ आत्माल गरिब लेन्याङ, स्वर्गल राज्य नकाङल ज्या।”<verse eid="MAT 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAT 5:4" />बअचाऔ आतिइ ढान्याङ, दानाङभन्या नकाङै सानत्वना ढोएन्यालेरा।<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="ISA 62:2">यशैया ६२:२</ref></char></note><verse eid="MAT 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 5:5" />बअचाऔ नम्रयाङ, दानाङभन्या नकाङै पिरथ्बीला अढिकार डोएन्यालेरा।<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">भजनसङ्ग्रह ३७:११</ref></char></note><verse eid="MAT 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 5:6" />बअचाऔ परमेस्वरलं इच्छ्याला कामल नाल्ट करेन्या सनर ओइन्याङ, दानाङभन्या नकाङ पटिपन्न ताइन्यालेरा।<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1-2">यशैया ५५:१-२</ref>; <ref loc="DEU 24:21">ब्यबस्था २४:२१</ref></char></note><verse eid="MAT 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAT 5:7" />बअचाऔ दयालुयाङ, दानाङभन्या नकाङै परमेस्वरङन दया डोएन्यालेरा।<verse eid="MAT 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 5:8" />बअचान्याङ चोखा यिङ वालाङ, दानाङभन्या नकाङै परमेस्वरजन रङन्या लेरा।<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 24:3-4">भजनसङ्ग्रह २४:३-४</ref></char></note><verse eid="MAT 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 5:9" />बअचावाङ जो शान्तिल काम ढान्याङ, दानाङभन्या नकाङ परमेस्वरलं सन्तान ऐढासिरा।<verse eid="MAT 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 5:10" />बअचाऔ सत्यल नाल्ट सटाइस्युनीर, दानाङभन्या स्वर्गला राज्य नकाङल ज्या।<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">१पत्रूस ३:१४</ref></char></note><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“बअचाऔ जे, जब रुयाङै ङा कारनले जे बाए ढान्यालेरा ओटन सटाइचिरा, ओटन ग्वारस्यु छ्योङस्यु जे बिरोदत सोगलै खालला माचान्या छेन छ्योङन्या लेरा।<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">१पत्रूस ४:१४</ref></char></note> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />तब हेसाङचिते, ओटन भ्याई आनन्द ताइचिते, दानाङभन्या स्वर्गल जे इनाम घिन्या लेया। दानाङभन्या ऐलेस्यु जै जेतन हाका अगमबक्ताङजन नकाङै रा:सटाईवाङ।”<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">२इतिहास ३६:१६</ref>; <ref loc="DEU 2:8">ब्यबस्था २:८</ref>; <ref loc="ACT 7:52">प्रेरित ७:५२</ref> </char></note><verse eid="MAT 5:12" /></para>
  <para style="s">सापिऊ सनर ज्योति</para>
  <para style="r">
    <ref loc="MRK 9:50">मर्कुस ९:५०</ref>; <ref loc="LUK 14:34-35">लूका १४:३४-३५</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />येशुले ऐआढोवाङ, “जे पिरथ्बीला सापिऊयाङ हो, तर सापिऊल ढार हिन्दा भन्या नकाजन फरि नैले सापिऊढारन्या जाएसिका? नका ता पाखाल क्याइन्या सनर रुयाङ खङले सिऊन्या बाहेक अपुर नैज कामला माताइदी।”<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="MRK 9:50">मर्कुस ९:५०</ref>; <ref loc="LUK 14:34-35">लूका १४:३४-३५</ref></char></note><verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />“जे सङ्सारला बत्तियाङ हो। डान्डात सचुन्सिन्या सहर मोअसिऊ माढुदुऊदी।”<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">यहुन्ना ८:१२</ref>; <ref loc="JHN 9:5">९:५</ref></char></note> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />रुयाङै बत्ति बलाइस्यु पाथीले ता माकपरदी, तर झेनन्या दियात नाएरा, ओटन झिमल लिज्यान्या सोगलै नाल्ट नकाले रंनन्या जाएवा।<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">मर्कुस ४:२१</ref>; <ref loc="LUK 8:16">लूका ८:१६</ref>; <ref loc="LUK 11:33">११:३३</ref></char></note> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />ऐलेस्युजै रुयाङल सामन्दी जे ज्योति ग्याचम्कित्या, ओटन नकाङै स्वर्गल लिज्यान्या जे बौल महिमा ग्याढोरत्या।<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">१पत्रूस २:१२</ref></char></note><verse eid="MAT 5:16" /></para>
  <para style="s">ब्यबस्थालं बारे आह्युउन्या</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />येशुले ऐलेऊ, “जे ङाजन मोशाल ब्यबस्था अथाबा अगमबक्ताङजन माएरा:औ ऐलेन्या तायिङ्ङच्यो। ङा माएन्या माङडी, बरु पुरा ङाजाएराङु हो।”<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ROM 10:4">रोमी १०:४</ref></char></note> <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />ङा जेजन मछ्यु ऐढाच्या, जब समन स्वर्ग सनर पिरथ्बी बिलिस्यु माहिन, तब ब्यबस्थाला सोगलै छेन पुरा आमाताहौ समन काङ्काई किसिमले त अछेर या त थोप्ला<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">थोप्ला=.</char></note> बै मिटीसिन्या माल्दी।<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">लूका १६:१७</ref></char></note> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />जोले ब्यबस्थाला आग्याङ मध्य सोगलैतन इङन्याजन मिचिस्यु, रुयाङजन बै नैलेव ह्युउकौर, नका स्वर्गला राज्यल सोगलैतन इङन्या ठहरिया। तर आग्या ओल बै मानिन्या सनर अपुऱ्याङजन बै मानिन्या ह्युउकौर, नका स्वर्गला राज्यल घिन्या ठहरिन्यालेया। <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />नैताइस्यु ङा जेजन ऐढाच्या, यदि जेढान्या सत्यल काम ब्यबस्थाला शास्त्रीयाङ सनर फरिसीयाङतन भ्या माताइदा भन्या जे कैलेस्यु बै स्वर्ग राज्यल पसिन्या माल्चिदी।<verse eid="MAT 5:20" /></para>
  <para style="s">रिईल बारेल आह्युउन्या</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“जे थएस्युई नाएच्या, ऐकन्ता रुयाङजन ऐढास्यु नाएसिवाङ, ‘नङ हत्या ताढो, जोले हत्या ढोव,’ नका सजायल लायकला ताइन्यालेया।<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">प्रस्थान २०:१३</ref>; <ref loc="DEU 5:17">ब्यबस्था ५:१७</ref></char></note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />तर ङा जेजन ऐढाच्या, जो आदाज्यूभाईस आयिङचो नका सजाय डोएन्या लायकला ताहा, ओटन जोले आदाज्यूभाईल अपमान ढोव नका घिन्या कचहरील बखिन्या लेया। तर जोले आदाज्यू भाईजन ‘नङ मुर्ख’ ऐढोव, नका नरगला मीलं परिन्या खतराल लेया।” <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />“नैताइस्यु जे बेदील भिटी चराइङा जेलेऊक यदि जे भाईल बिरोदत जे यिङल कोबाअ लेऊ लेस्यु यांका राकन भन्या, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />जे भिटी नक बेदील लेऊक नाएचिते, ओटन हिनस्यु हादेए जे दाज्यूभाईसकाए मिलिचिते, ओटन छिन्ट रा:स्यु जे भिटी चराइचिते।”<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />“जेमि बादीसं अदालत जेहिनौ हादेए यमलै मिलिचिते, मानकन्ता बादीले जेजन नियादिसलं कुईत सुम्पिचिवा ओटन नकाले अढिकारील कुईत जिम्मा योंवा, ओटन पुलिसयाङै जेजन झ्यालखानाल झोअचिरा। <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />मछ्यु, ङा जेजन पानस्याच्या, जे त-त रुप्या चुक्ता जेमाजाटौ समन जे नलन उम्किऊ माढुदुचिदी।”<verse eid="MAT 5:26" /></para>
  <para style="s">ब्यबिचारल बारे आह्युउन्या</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“जे ऐटाइन्या थएस्यु जेल्चिऊ, ‘नङ ब्यबिचार ताढो’।”<note caller="-" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">प्रस्थान २०:१४</ref>; <ref loc="DEU 5:18">ब्यबस्था ५:१८</ref></char></note><verse eid="MAT 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 5:28" />तर ङा जेजन ऐढाच्या, जोले काङ्काब मेएमाङजन माचान्या इच्छ्याले खिमौ, नकाले हादेएजै आयिङल नकासं ब्यबिचार आढान्या ताहा। <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />यदि न दाइन्या म्युउले नङजन पाप ढाऔ परिङनुकन नकाजन कलअस्यु क्याइते, दानाङभन्या स्वाट्टै नबुल नरगल क्याइसिऊ भन्या बरु नबुल लन तोलोअ गवाइन्या न नाल्ट चान्या ताहा।<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">मत्ती १८:९</ref>; <ref loc="MRK 9:47">मर्कुस ९:४७</ref></char></note> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />न दाइन्या कुईले नङजन पाप ढाऔ परिङदुन्वा भन्या नकाजन पलस्यु क्याइते। दानाङभन्या सोगल न बुल नरगल आहिनौ भन्या बरु नमी अङ्गयाङ मध्य तोलोअ गवाइन्या न नाल्ट चान्या ताहा।<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">मत्ती १८:८</ref>; <ref loc="MRK 9:43">मर्कुस ९:४३</ref></char></note><verse eid="MAT 5:30" /></para>
  <para style="s">भाअसिइलं बारेल आह्युउन्या</para>
  <para style="r">
    <ref loc="MAT 19:9">मत्ती १९:९</ref>; <ref loc="MRK 10:11-12">मर्कुस १०:११-12</ref>; <ref loc="LUK 16:18">लूका १६:१८</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“ऐटाइन्या बै पानस्यु नाएसिया। कि ‘जोले आमेएमाजन राहौ, ओले नकाजन भरपाई सरस्यु ग्यायोंवत्या’।”<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ब्यबस्था २४:१-४</ref>; <ref loc="MAT 19:7">मत्ती १९:७</ref>; <ref loc="MRK 10:4">मर्कुस १०:४</ref></char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />तर ङा जेजन ऐढाच्या, जोले आमेएमाजन ब्यबिचारल कारन बाहेक अपुर कारनले राहौ। ओले नाजन ब्यबिचारिनी जाएवा, ओटन जोले आराइन्या मेएमास ब्याहा ढोव, नकाले ब्यबिचार ढोवा।<note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">मत्ती १९:९</ref>; <ref loc="MRK 10:11-12">मर्कुस १०:११-१२</ref>; <ref loc="LUK 16:18">लूका १६:१८</ref>; <ref loc="1CO 7:10-11">१कोरिन्थी ७:१०-११</ref></char></note><verse eid="MAT 5:32" /></para>
  <para style="s">किऱ्याल बारेल आह्युउन्या</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“फरि जे थएस्युई लेच्या, कि ऐका पालाला रुयाङजन पानस्यासिवाङ, ‘नङ ग्वारस्यु किऱ्या ताज्यो, तर परमप्रभुल नाल्ट नढान्या बाचा पुरा ढोचिते’।”<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">लेवी १९:१२</ref>; <ref loc="NUM 30:2">गन्ती ३०:२</ref>; <ref loc="DEU 23:21">ब्यबस्था २३:२१</ref></char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />तर ङा जेजन ऐढाच्या, स्वर्गल मिनतन किऱ्या ताज्योच्यो, दानाङभन्या नका परमेस्वरलं सिहासन हो।<note caller="-" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">याकूब ५:१२</ref>; <ref loc="ISA 66:1">यशैया ६६:१</ref>; <ref loc="MAT 23:22">मत्ती २३:२२</ref></char></note> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />न त पिरथ्बील, दानाङभन्या नका ओलं खङबाङ हो, न त यरुशलेमल, दानाङभन्या नका माहा रयल सहर हो।<note caller="-" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">यशैया ६६:१</ref>; <ref loc="PSA 48:2">भजनसङ्ग्रह ४८:२</ref></char></note> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />“जे ङएल किऱ्या ताज्योच्यो, दानाङभन्या जे तसऱ्या चेम पलन्या या मोलन्या माजाएदुचिडी। <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />जे जेछ्योङन्या छेन ‘ओज्या, ताहकन ओज्या’ माङडी ताहकन माङडी, याएज ग्याताइत्या नकातन भ्या ता दुस्टङन रांया।”<verse eid="MAT 5:37" /></para>
  <para style="s">पालो होलन्या बारे आह्युउन्या</para>
  <para style="r">
    <ref loc="LUK 6:26-36">लूका ६:२६-३६</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />जे थएस्यु मालेचिच्यो, “ऐलेस्यु नाएसिऊ ‘म्युउल पालोत म्युउ,’ ओटन ह्वाल पालोत ह्वा।”<note caller="-" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">प्रस्थान २१:२४</ref>; <ref loc="LEV 24:20">लेवी २४:२०</ref>; <ref loc="DEU 19:21">ब्यबस्था १९:२१</ref></char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />तर ङा जेजन ऐढाच्या, दुस्टलं याह्‌त तालागिच्यो। जोले जेदाइन्या बङ्गरा चर्काहौ, नकाजन छुट्टै बङ्गरा बै थुङस्योचिते। <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />यदि जो रुले जे दौरा लाङन्या जिग्राइ ढास्यु अदालतल मुद्दा झोकौकन, नकाजन जे खाइटो बै योंचिते। <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />यदि काङ्काङै जेजन त किलो मिटर बान्या कर लाइचिऊकन, ओसकाए नें किलोमिटर हिनस्योचिते। <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />जेसकाए नीन्याङजन योंचिरते, ओटन जेसकाए साहूरिन रोअन्याजन अहअ ताढोचिर।<verse eid="MAT 5:42" /></para>
  <para style="s">शत्तुरयाङजन मया ढोचिरते</para>
  <para style="r">
    <ref loc="LUK 6:27-28">लूका ६:२७-२८</ref>,<ref loc="LUK 6:32-36">३२-३६</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“जे ऐटाइन्या थएस्यु जेल्चिऊ, ‘जे जे डेराबाराजन प्रेम ढोचिरते, ओटन जे शत्तुरयाङजन सज्युचिरते।’<note caller="-" style="x"><char style="xo" closed="false">5:43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेवी १९:१८</ref></char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />तर ङा जेजन ऐढाच्या, जे शत्तुरयाङजन प्रेम ढोचिरते, ओटन जेजन सटाइन्याङल नाल्ट प्रार्थना ढोचिते, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />ओटन जे स्वर्गल लिज्यान्या जे बौल ज़ायाङ ताइन्यालेच्या। ओले घुर्बीयाङ सनर सज्जनयाङ नेंलोअझन्जै नमिउल मुन योंवरा, ओटन सोझा सनर पापी नेंलोअजन नम्वाई योंवरा।”<note caller="-" style="x"><char style="xo" closed="false">5:45 </char><char style="xt" closed="false"><ref loc="LEV 4:10">लेवी ४:१०</ref></char></note> <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />दानाङभन्या यदि जेजन प्रेम ढान्याङजन याएज प्रेम, ढोदुच्या भन्या जे नैल इनाम जेडोएचिऊका? नैति तिरो उठाइन्याङ बै नैजै मालेवाङ का? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />नैताइस्यु जे बिस्वासीयाङजन याएज जडौ ढोदुच्या भन्या अपुऱ्याङतन बढि नैति जेढोचिऊ का? ओक्या गैरयहूदीयाङै बै नैजै मालेवाङ का? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />नैताइस्यु जोमनलेस्यु स्वर्गल लिज्यान्या जे बौ सिद्द लेऊ, जे बै नामन्जै सिद्द ताहौपरिया।<note caller="-" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">लेवी १९:२</ref>; <ref loc="DEU 18:13">ब्यबस्था १८:१३</ref></char></note><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">दान यांन्या बारेल आह्युउन्या</para>
  <para style="r">
    <ref loc="LUK 11:2-4">लूका ११:२-४</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“होस सकाए चुङचिते, जे रुयाङजन धार्मिकताला काम ताढोच्यो। मानकन्ता स्वर्गल लिज्यान्या जे बौङन जे नैज इनाम माडोएचिदी।”<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="MAT 23:5">मत्ती २३:५</ref></char></note> <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />“नैताइस्यु जब जे दान योंच्यो, तब आलेऊक तुरही<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">तुरही = रङल भोङकर</char></note> ताटपच्यो, जोमनलेस्यु घुर्बीयाङै यहूदीयाङ आराधना झिमजिऊल सनर यम जिऊल रुयाङ्ङन प्रसम्सा डोटौ नाल्ट ढोरा। मछ्यु ङा जेजन पानस्याच्या, नकाङै रांमि इनाम डोएस्युई लेरा।” <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />तर जब नङ दान योंन, न दाइन्या कुईले नै ढाज्याऔ ना दाबऱ्या कुईले तासनौत्या। <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />न दान गुप्तल ग्याताइत्या, ओटन गुप्तल रङन्या न बौले नङजन इनाम यांन्वा।<verse eid="MAT 6:4" /></para>
  <para style="s">प्रार्थनाल बारेल आह्युउन्या</para>
  <para style="r">
    <ref loc="LUK 11:2-4">लूका ११:२-४</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“जब नङ प्रार्थना ढोच्यो तब घुर्बीयाङमन ताटाइच्यो, दानाङभन्या नकाङ आराधना झिमजिऊल सनर द्वाहादोबाटा जिऊल रुयाङै ग्यारङरत्या ऐलेस्यु च्याङस्यु प्रार्थना ढान्या निज्युरा। मछ्यु, ङा जेजन ऐढाच्या, नकाङ रांमि इनाम डोएदुरा।<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">लूका १८:१०-१४</ref></char></note> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />तर जब नङ प्रार्थना ढोन, न कोठा भितरलं पसिन्ते, ओटन झलाप रूफ्स्यु स्वर्गला लिज्यान्या न बौ परमेस्वरजन प्रार्थना ढोते, गुप्तल रङन्या न बौले नङजन इनाम यांन्वा। <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />ओटन प्रार्थना जेढाऔक गैरयहूदीयाङमन दाङजै गनगन तालेच्यो दानाङभन्या तबर शब्दल छ्योङौक नकाङल थएसिया ऐलेन्या नकाङ यिङरा।<note caller="-" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="LEV 7:14">लेवी ७:१४</ref></char></note> <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />नैताइस्यु नकाङमन ताटाइच्यो, दानाङभन्या जे बौसकाए जेनीऊ हादेए जेजन नै-नै चाहिऊ। ना स्वर्गला जे बौले ऐसन्वा।<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />“तर जे ऐलेस्यु प्रार्थना ढोचिते,</para>
  <para style="q" vid="MAT 6:9">‘औ, स्वर्गल लिज्यान्या गे बौ,</para>
  <para style="q" vid="MAT 6:9">नमिन पबित्र ग्यामानिसित्या।<verse eid="MAT 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 6:10" />न राज्य ग्यारांत्या। नइच्छ्या स्वर्गल जोमनताइन्या ले, नामन्ज ईका पिरथ्बील पुरा ग्याताइत्या।<verse eid="MAT 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAT 6:11" />गेजन आछिम दिनभरिका गे जेए यासिन्ते।<verse eid="MAT 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MAT 6:12" />गे अपराद छेमा ढास्यासिन्ते, जोमनलेस्यु गे गेअपरादीयाङजन छेमा ढास्यु गेलेयिउ।<verse eid="MAT 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MAT 6:13" />गेजन परिक्छ्याल परिऊ तायासिन, तर दुस्टङन छुताइसिन्ते दानाङभन्या राज्य, पराक्रम सनर महिमा सदाईज नमीई ज्या, आमेन’।”<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />दानाङभन्या जे रुयाङल अपराद छेमा ढोच्योकन, स्वर्गल लिज्यान्या जे बौले बै जेजन छेमा यांचिवा।<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MRK 11:25-26">मर्कुस ११:२५-२६</ref> </char></note> <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />तर जे रुयाङल अपराद छेमा माढोच्योकन, स्वर्गल लेन्या जेबौले जे अपराद छेमा ढान्यामाल्दी।<verse eid="MAT 6:15" /></para>
  <para style="s">बर्तल बारे आह्युउन्या</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“जब जे बर्त चुङच्यो, तब घुर्बीयाङमन झुङखरिन्या अनवार ताथनच्यो। दानाङभन्या नकाङ रुयाङजन थनौ नाल्ट रांअनवार मोल जाएस्यु बर्त चुङरा। ङा मछ्यु जेजन ऐढाच्या, नकाङ रांमि इनाम डोएस्युई लेरा। <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />तर जे बर्त जेचुङौक जे हां हुरचिते, ओटन जे ङएल तीइ ठिइचिते। <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />नैताइस्यु जे बर्त जेचुङौक रुयाङ ग्यारङरत्या ऐलेस्यु माङडी, तर गुप्तल लिज्यान्या जे बौले ग्यारङौत्या, ओटन गुप्तल रङन्या जेबौले जेजन इनाम यांचिवा।<verse eid="MAT 6:18" /></para>
  <para style="s">स्वर्गला सम्पति</para>
  <para style="r">
    <ref loc="LUK 12:33-34">लूका १२:३३-३४</ref>; <ref loc="LUK 16:13">१६:१३</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“जे नाल्ट पिरथ्बील धन-सम्पत ताबोरच्यो, जोल लुइयाङ सनर खयले ना कैरा ओटन जोल गोएयाङै झिम पाअस्यु नका कुरा।”<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">याकूब ५:२-३</ref></char></note><verse eid="MAT 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 6:20" />तर जे नाल्ट स्वर्गल धन-सम्पत बोरचिते, जोङ लुइयाङ या खयले माकैदुरदी, सनर गोएले बै झिम पाअस्यु माकुदुरदी।<note caller="-" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">याकूब ५:२-३</ref></char></note> <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />दानाङभन्या जोङ जे धन लिज्या, जे यिङ बै ओङै लिज्याया।<verse eid="MAT 6:21" /></para>
  <para style="s">बुलल ज्योति</para>
  <para style="r">
    <ref loc="LUK 11:34-36">लूका ११:३४-३६</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“म्युउ बुलल बत्ति हो। नैताइस्यु यदि न म्युउ स्वस्थ लेकन, सोगलै न बुल रंनन्या ताहा। <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />तर न म्युउ अस्वस्थ लेकन, सोगलै न बुल चिऊन्या ताहा। नैताइस्यु न भितरलं लेन्या रंनन्या च्युककन, नका चिऊन्या ख्वाए छ्याइला ताहौ!<verse eid="MAT 6:23" /></para>
  <para style="s">परमेस्वर सनर धनसम्पत</para>
  <para style="r">
    <ref loc="LUK 16:13">लूका १६:१३</ref>; <ref loc="LUK 12:22-31">१२:२२-३१</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“काङ्काईले नेंलोअ साहूल सेवा ढाऔ माढुदुऊदी। दानाङभन्या नाले तोलोअजन सज्युवा ओटन छुट्टैजन निज्युवा। अथाबा नाले तोलोअदेए भक्ति नाएवा, ओटन छुट्टैजन नाले सज्युन्यालेया। जे परमेस्वर सनर धनल सेवा ढाऔ माढुदुचिदी।” <verse eid="MAT 6:24" /><verse number="25" style="v" sid="MAT 6:25" />“नैताइस्यु ङा जेजन ऐढाच्या, ‘गे नै ज्योई नै ओइ ऐलेस्यु जे परानल नाल्ट सनर बुलजन नै क्वाटै ऐलेस्यु नाल नाल्ट जे ताआतिच्यो।’ ओक्या परान ज्यान्या जन्तुतन ओटन बुल क्वायाङतन घिन्या मालेऊ का?” <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />नमता बायाङजन ब्याएचिरते। नकाङै न त धूर वाइर, न अन खानन्या धोर न भोखरलं दुउर, तर स्वर्गला जे बौले नकाङजन यांहौरा। जे ओक्या नकाङतन तबर यएला जेमाल्चिऊ का? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />जे मध्य काङ्काले आतिस्यु जिबनल आयु तचिइठक्क बै चहौ आढुदुऊ? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />“ओटन जे दानाङ क्वाल नाल्ट आतिइ ढोच्यो? बाङला लिली वोईयाङजन खिम्चिरते, नकाङ कडाई बढिवाङ।” नकाङै न परिस्रम धोर न धागा खलर। <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />तर ङा जेजन ऐढाच्या, सोलोमन रय आमि सोगलै सक्तियाङत वोईयाङ मध्य तोलोअ याएथक्क बै सुवाइसिन्या माताइदा।<note caller="-" style="x"><char style="xo" closed="false">6:29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">१राजा १०:४-७</ref>; <ref loc="2CH 9:3-6">२इतिहास ९:३-६</ref></char></note> <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />आछिम लेन्या ओटन घालाअ भुबराल क्याइसिन्या छीजन परमेस्वरले ऐलेस्यु आक्वाटौ भन्या, ऐ अल्पबिस्वासीयाङ, नैति ओले जेजन तबर क्वा माक्वाएचिवा का?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />“नैताइस्यु ‘नै ज्योई?’ ओटन ‘नै ओइ?’ सनर ‘नै क्वाएसिई?’ ऐलेस्यु आतिइ ताढोच्यो। <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />दानाङभन्या गैरयहूदीयाङ ईका सोगलै जन्तु रोअरा, ओटन स्वर्गल लेन्या जे बौले जेजन ईका सोगल जन्तु मायोअज्याऔ ऐलेस्यु ऐसन्वा। <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />तर पैला परमेस्वरलं राज्य सनर धार्मिकता रोअचिते, ओटन ईका सोगलै जन्तु जे नाल्ट चैन्या लेसिया।<note caller="-" style="x"><char style="xo" closed="false">6:33 </char><char style="xt" closed="false"><ref loc="LUK 12:31">लूका १२:३१</ref></char></note> <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />नैताइस्यु घालाअका आतिइ ताढोच्यो, दानाङभन्या घालाअका दिनले आआतिइ ओलजै ढोवा। आछिमका दुख आछिमकाल नाल्ट तबर लेया।<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">अपुऱ्याङल निया माढान्या</para>
  <para style="r">
    <ref loc="LUK 6:37-38">लूका ६:३७-३८</ref>; <ref loc="LUK 6:41-42">६:४१-४२</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“जे अपुऱ्याङल निया ताढोच्यो, ओटन जेमि बै निया माढासिदी। <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />दानाङभन्या जोमनलेस्यु जे अपुऱ्याङल निया ढोच्यो, ओमनलेस्युजै जे बै निया ढास्युनीच्या। जो मानले जे मानच्यो, नैलेस्युजै जे नाल्ट बै मानन्या लेसिया।”<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">मर्कुस ४:२४</ref> </char></note><verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />दानाङ नङ नभाईल म्युउला धुलोल खाअ रङज्यान, नङ नम्युउल आलिज्यान्या मोन्दाअकने मासनन्दी? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />अथाबा नम्युउल मोन्दाअ लिज्याकन नङ कैलेस्यु नभाईजन ऐढाऔ ढुदुन, ङाजन नम्युउला धुलोल खाअ हाटौ यांङते।<verse eid="MAT 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 7:5" />ऐ घुर्बी, हादेए नङ नम्युउलन मोन्दाअ हाएते, ओटन नङ नभाईल म्युउला धुलोल खाअ हाटौ नाल्ट बल्ल नङ चान्यासं रङौ ढुदुना। <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />“जो पबित्र लेऊ ना कांयाङजन तायोंचिर। जे मोटीयाङ वोअयाङ राहांल ताक्याइस्योचिर, मानकन्ता नकाङै रांखङले सिउरा ओटन वलस्यु जेजन धारीचिरा।”<verse eid="MAT 7:6" /></para>
  <para style="s">परमेस्वरसं नीचिते, रोअचिते, ध्वांध्वां जाएचिते</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“नीच्योकन जेजन यांन्यालेसिया, रोअच्योकन डोएन्यालेच्या, ध्वांध्वां जाएच्योकन जे नाल्ट झलाप फएन्यालेसिया।<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="MAT 2">२</ref> </char></note> <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />दानाङभन्या जोले नी, ओजन यांसिया, जोले रोंकौ, ओले डोएवा, जोले ध्वांध्वां जाटौ, नकाल नाल्ट झलाप फएन्यालेसिया।” <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />“जेमध्य काङ्का रु ताह, आज़ाले भरेई आनीउक नकाजन लुङ यांन्या?” <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />ओटन ङा:स्या आनीउक नकाजन डाङ योंवा? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />नैताइस्यु जे दुस्ट ताइस्यु बै जे ज़ायाङजन चान्या जन्तु यांऔ सनच्योकन, स्वर्गत लेन्या जे बौले ओलसं नीन्याङजन ख्वाए भ्याई जाएस्यु चान्या जन्तु कैलेस्यु आमायोवाङ।<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="LUK 11:13">लूका ११:१३</ref></char></note> <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />रुयाङै जेस जोमनताइन्या ब्यबहार ग्याढोरत्या ऐलेन्या चाहिच्यो, जे बै नकाङसं ओमनटाइन्याई ब्यबहार ढोचिते, दानाङभन्या आका जै मोशाल ब्यबस्था सनर अगमबक्ताङल मुख्या सिक्छ्याल साराम्स हो।<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="LUK 6:31">लूका ६:३१</ref> </char></note><verse eid="MAT 7:12" /></para>
  <para style="s">साङरो झलाप</para>
  <para style="r">
    <ref loc="LUK 13:24">लूका १३:२४</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“साङरो झलापलन भितरलं पसिचिते, दानाङभन्या बिनाशल सतापन्या झलाप वाङन्या सनर यम सजिलो ताहा, आकालन भितरलं पसिन्या रुयाङ तबर ताइरा।” <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />दानाङभन्या जिबनल सतापन्या झलाप साङरो ताहा, ओटन यम अक्कऱ्या ताहा, जोले जिबनल सतापवा, ओटन ना डोएन्याङ थोरै ताइरा।<verse eid="MAT 7:14" /></para>
  <para style="s">टुङ सनर नकाल शई</para>
  <para style="r">
    <ref loc="LUK 6:43-44">लूका ६:४३-४४</ref>; <ref loc="LUK 13:25-27">१३:२५-२७</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“ग्वारवा अगमबक्ताङतन होसियार ताइचिते, जेजन रङस्यु जेल्योङ रांन्यालेरा, नकाङ बाहेरङन खिमौक भेडाङमन ताइन्याई ताइरा, भितरङन बअछ्याईला फ्याऊयाङमन ताइरा।” <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />जे नकाङल राज़ाएतन शईन्या लेच्या। ओक्या ज़ुल टुङतन अङ्गुर अथाबा धातन ड्यूल शई टिउसिऊका? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />नैलेस्यु स्वाट्टै चान्या टुङले चान्याई शई शशैवा। तर माचान्या टुङले माचान्याई शई शशैवा। <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />चान्या टुङले माचान्या शई शशहौ माढुदुऊदी, न त माचान्या टुङले चान्या शई शशहौ ढुदुऊ। <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />चान्या शई माशशैन्या सोगल टुङ पलसिया, ओटन मील झोअसिया।<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">मत्ती ३:१०</ref>; <ref loc="LUK 3:9">लूका ३:९</ref> </char></note> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />नैताइस्यु ग्वारवा अगमबक्ताङजन नकाङल कामङन शईन्यालेच्या।<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 12:33">मत्ती १२:३३</ref></char></note><verse eid="MAT 7:20" /></para>
  <para style="s">ङा नङजन खकै शईस्यु ङामालेनु</para>
  <para style="r">
    <ref loc="LUK 13:25-27">लूका १३:२५-२७</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“ङाजन प्रभु, प्रभु लेन्याङ सोगलै स्वर्गल राज्यल पसिऊ डोएन्या मालेरदी। तर ङामि परमेस्वर बौल इच्छा मानिन्या रुयाङ याएज स्वर्गला राज्यल पसिऊ ढुदुरा। <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />ना छिम्क भ्याईले ङाजन ऐढाङरा, प्रभु, प्रभु नैति गे न मिनङन भबिस्यबानी गेमाछ्योङयिउ का? नमिनङन भूतयाङ गेमाधपाइयिउ का? ओटन नमिनङन अपुर अचम्मला काम गेमाढोयिउ का? <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />ओटन ‘ङा नकाङजन चान्यासकाए ऐढोङरा, ङा जेजन खकैज माशईचिदी। ए माचान्या काम ढान्याङ ङातन लोए ताइचिते।’<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">भजनसङ्ग्रह ६:८</ref></char></note><verse eid="MAT 7:23" /></para>
  <para style="s">नेंलोअ झिम जाएन्याङ</para>
  <para style="r">
    <ref loc="LUK 6:47-49">लूका ६:४७-४९</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“नैताइस्यु जोले ङा ईका बचन थटौ, ओटन पालन ढोव, ङा तोलोअ बुद्दिमान रु सकाए दान्जिङा, जोले आझिम चमलयर्त आजाटौ। <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />ओटन जब नम वाऔ, ओटन भलं रांऔ, ओटन आन्ढी आढोव, ओटन ना झिमल यर्त ठुकिसिऊ, ओटन बै ना झिम मावङदा। दानाङभन्या ना चमलयर्त सचुन्सिन्या लेऊ।”<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />जोले ईका ङा बचन थएस्यु बै मामानिऊ, नकाजन तोलोअ मुर्खी रुसकाए दान्जिसिया, जोले आझिम बाल्वाल यर्त आजाटौ। <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />जब नम वाऔ, ओटन भलं रांऔ, ओटन घूईका आढोव ओटन ना झिमल यर्त ठुकिसिऊ, ओटन ना झिम ढलिऊ, ओटन नकाल घिन्या नोक्सान ताहौ।<verse eid="MAT 7:27" /></para>
  <para style="s">येशुल अढिकार</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />येशुले ईका छेन पान्वापाइना रुयाङल हुल ओलं सिक्छ्या थएस्यु छक्कै परिवाङ।<note caller="-" style="x"><char style="xo" closed="false">7:28 </char><char style="xt" closed="false"><ref loc="MRK 1:22">मर्कुस १:२२</ref>; <ref loc="LUK 4:32">लूका ४:३२</ref></char></note> <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />दानाङभन्या ओले नकाङल शास्त्रीयाङमन लेस्यु माङडी, तर अढिकार लेन्या रुमन लेस्यु आह्युउवाङ।<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">कोरलागिन्याजन आसबेलन्या</para>
  <para style="r">
    <ref loc="MRK 1:40-45">मर्कुस १:४०-४५</ref>; <ref loc="LUK 5:12-16">लूका ५:१२-१६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />येशु डान्डातन लाहा पाइना घिन्या हुल आछिन्ट लागिऊ। <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />तोलोअ कोर लागिन्या आल्योङ रांऔ, ओटन आहाक घुन्डा टिकिस्यु ऐआढोव, “औ प्रभु, नङ चाहिनकन ङाजन सबेलौ ऐदुदुना।” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />येशुले आकुई पसारस्यु नकाजन आछुउ, ओटन ऐलेऊ, “ङा इच्छ्या ऐढोङा, नङ बेलन्ते।” ओचोएटै नकाल कोर बेलौ। <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />तब येशुले नकाजन ऐआढोव। “काङ्काईजन तापानस्यौर। तर नङ हिनस्यु पुजाउरो ल्योङ थनसिन्ते, ओटन मोशाल आग्या अनुसारला भिटी चराइते, ओटन रुयाङ साची ग्याताहनत्या।”<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">लेवी १४:१-३२</ref></char></note><verse eid="MAT 8:4" /></para>
  <para style="s">येशुले रोमी कप्तानल नोक्करजन आसबेलन्या</para>
  <para style="r">
    <ref loc="LUK 7:1-10">लूका ७:१-१०</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />जब येशु कफर्नहुम सहरल हिनौ तोलोअ कप्तान आल्योङ रा:स्यु बिन्ति ढास्यु। नकाले ऐलेऊ, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“औ प्रभु, ङा नोक्कर लुला ताइस्यु भ्याईज दुख डोएस्यु झिमलै थाला परीस्यु लेया।”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />येशुले कप्तानजन ऐआढोव, “ङा रा:स्यु नकाजन सबेल्ङा।”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />तर कप्तानले ऐलेऊ, “औ प्रभु, ङाझिमल नङजन स्वागत ढान्या लायकला ङा मालेङदी, तर नङ बचन याएज छ्योङस्याङते, ओटन ङा नोक्कर बेलन्यालेया। <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />दानाङभन्या ङा बै अढिकारीयाङल न्युउल लिज्याङा, ओटन ङा न्युउल सिपाइयाङ लेरा, ओटन ङा तोलोअजन ‘हिनन्ते’ ऐढोङा, ओटन ना हिना, ओटन छुट्टैजन ‘रांन्ते’ ऐढोङा ओटन ना रांया। ङा सेवाऱ्याजन ऐटाइन्या ढोते, ऐढोङा, ओटन नकाले ना ढोवा।”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />नकाल छेन थएस्यु येशुले अचम्म आमानिउ! ओटन आछिनछिन रांन्याङजन ऐआढोवाङ, ङा मछ्यु, जेजन ऐढाच्या, इस्राएललं बै आवाए घिन्या बिस्वास ङा डोएस्यु मालेङदी। <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />ङा जेजन ऐढाच्या, पुर्ब सनर पच्छिमङन तबर जना रांन्या लेरा, ओटन अब्राहाम, इसहाक सनर याकूबस स्वर्गला राज्यल भोसलं चुङन्या लेरा।<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">लूका १३:२९</ref></char></note> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />तर इस्राएल राज्यला सन्तान बाहेरला चिऊन्याल क्याइसिरा। नङं रुयाङ व्अरन्या लेरा ओटन ह्वा ज़िङ कैन्यालेरा।<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 22:13">मत्ती २२:१३</ref>; <ref loc="MAT 25:30">२५:३०</ref>; <ref loc="LUK 13:28">लूका १३:२८</ref></char></note> <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />तब येशुले कप्तानजन ऐआढोव, “हिनन्ते, नङ जोमनताइन्या बिस्वास नढोनु, नङजन ओमनजै ग्याताईत्या।” तब नका नोक्कर नवाए बेलाई बेलौ।<verse eid="MAT 8:13" /></para>
  <para style="s">येशुले तबर रुयाङजन आसबेल्वाङ</para>
  <para style="r">
    <ref loc="MRK 1:19-34">मर्कुस १:१९-३४</ref>; <ref loc="LUK 4:38-41">लूका ४:३८-४१</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />येशु पत्रुसलं झिमल रायापाइना नकाल माइज्यू नाएबोरले थलिस्यु चारपाईत आवङज्यान्या आरङौ। <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />ओले नाल कुई आछुस्यौ, ओटन नकाजन नाएबोरले आराहौ। ओटन नकाले सोस्यु आसेवा ढाऔ तअसिऊ। <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />जब ओइ ताहौ, तब आल्योङ नकाङै तबर जना दुस्टआत्मा लागिन्याङ राहोन्वाङ। ओटन ओले बचनङन जै दुस्टआत्माङजन आपलिइवाङ। ओटन नाएबोरन्याङ ज्वाए लेवाङ नका सोगलैजन आसबेल्वाङ। <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />यशैया अगमबक्ताले आछ्योङन्या अगमबानी पुरा ताहौ नाल्ट ऐताहौ। “ओले ओलजै गेमि दुर्बलताङ आलाङौ, ओटन गेमि नाएबोरयाङ सिमस्यु आलाङौ”<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">यशैया ५३:४</ref>; <ref loc="1PE 2:24">१पत्रूस २:२४</ref></char></note><verse eid="MAT 8:17" /></para>
  <para style="s">येशुल सिइ ताहौ रोअन्याङ</para>
  <para style="r">
    <ref loc="LUK 9:57-62">लूका ९:५७-६२</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />जब येशुले आनावङल घिन्या रुयाङ हुल आरङवाङ, ओले आ सिइयाङजन दहल हूत हिनन्या आग्या आयोवाङ। <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />तोलोअ शास्त्री आल्योङ रांऔ, ओटन ओलजन ऐआढोव “औ गुरु ज्यू, नङ जोङ हिनन्, ङा बै न छिनछिन हिन्ङा।”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />येशुले नकाजन ऐआढोव, “भुकन्याङल पुउयाङ लेरा, ओटन नमता बायाङल रा:सिप लेया, तर रुल ज़ाल नाल्टता ङए ढल्काइन्या पो बै माल्दी।” <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />ओलं सिइयाङ मध्य छुट्टै तोलोअले ऐलेऊ, “प्रभु ङाजन पहेला ङा बौजन रींन्नाऔ यांङते।”<note caller="-" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="1KI 19:20-21">१राजा १९:२०-२१</ref></char></note> <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />तर येशुले नाजन ऐआढोव, “नङ ङाछिनछिन रांन्ते, स्यौऱ्याङै रा:स्यौऱ्याजन रांईज ग्यारीनरत्या।”<verse eid="MAT 8:22" /></para>
  <para style="s">येशुले आन्ढीजन आसदिङौ</para>
  <para style="r">
    <ref loc="MRK 4:35-41">मर्कुस ४:३५-४१</ref>; <ref loc="LUK 8:22-25">लूका ८:२२-२५</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />येशु डोङ्गाल चरियापाइना सिइयाङ आछिनछिन हिन्वाङ। <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />अभिलच्याङन दहल घिन्या आन्ढी लागिऊ, ओटन छालले डोङ्गाजन टुपौ तअसिऊ। तर नवाए बेला येशु म्वाईज्याऔ। <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />सिइयाङ रा:स्यु ओलजन ऐलेस्यु रासोचटौ, “बचाइसिन्ते प्रभु! गे दुबिङा लेदुया।”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />येशुले नकाङजन ऐआढोवाङ, “ऐ, अल्पबिस्वासी रुयाङ, जे दानाङ छ्याएज्याच्यो?” तब सोस्यु ओले आन्ढी सनर दहजन आहकारिउ, ओटन आन्ढी शान्त ताहौ। <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />“आका कैताइन्या रु रैस, दानाङभन्या आन्ढी सनर दहले बै इकाल पानन्या मानिरा रैस” ऐलेस्यु नका रुयाङ अचम्मै ताइवाङ।<verse eid="MAT 8:27" /></para>
  <para style="s">दुस्टआत्मा लागिन्या नेंलोअ रुनें</para>
  <para style="r">
    <ref loc="MRK 5:20">मर्कुस ५:२०</ref>; <ref loc="LUK 8:26-39">लूका ८:२६-३९</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />जब येशु दहल हुदिफन्ट गदरिनीयाङल प्रदेसलं रांऔ, तब दुस्टआत्मा लागिन्या नेंलोअ रुनें ऊईलन नेराज्याऔक ओलसं डोएसिऊने। नकाने आवाए छ्याइला लेऊने, कि काङ्काई बै नलन रांऔ हिनौ माढुदुज्यावाङ। <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />नकाने ऐलेस्यु चिचच्याहौने, “औ परमेस्वरलं ज़ा, नङ घेनङन नै नरोअनु? नैति नङ घोन बेला आमाताहौङन घेनजन सजाय नयांरासिनु?”<note caller="-" style="x"><char style="xo" closed="false">8:29 </char><char style="xt" closed="false"><ref loc="LUK 4:34">लूका ४:३४</ref></char></note> <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />नकानेतन तचिइ लोएत वोअयाङल तोलोअ घिन्या बगाल लाज्यावाङ। <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />दुस्टआत्माङै ओलजन ऐढास्यु बिन्ति रांढोव, “यदि नङ गेजन पलिइसिनकन, गेजन वोअयाङल बगालल परिङसिन्ते।” <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />ओटन येशुले नकाङजन ऐआढोवाङ, “हिन्चिते।” तब नकाङ पलिईस्यु वोअयाङल पसिवाङ, ओटन वोअल सोगलै बगाल ओरलालन हुर्रिस्यु, दहला रील बुदिस्यु सिवाङ। <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />वोअयाङ छाज्यान्याङ ढोङस्यु सहरल हिन्वाङ ओटन ना दुस्टआत्मा लागिन्यानेजन कैताहौ सोगल रापानस्योवाङ। <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />तब सोगल इलाकाला रुयाङ येशु सकाए डोएसिरावाङ, ओटन ओलजन रङस्यु रुयाङै नकाङल पोलन हिनन्ते ऐलेस्यु ओलजन बिन्ति रांढोव।<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">येशुले लुलाजन आसबेलौ</para>
  <para style="r">
    <ref loc="MRK 2:1-12">मर्कुस २:१-१२</ref>; <ref loc="LUK 5:17-26">लूका ५:१७-२६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />येशु ओलं छिन्ट डोङ्गाल चरिस्यु दह हुदिन्त हिनौ, ओटन आसहरलं रांऔ। <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />ओटन रुयाङै चारपाईत वङज्यान्या तोलोअ लुलाजन आल्योङ राहोनौ। येशु नकाङल बिस्वास रङस्यु लुलाजन ऐआढोव, “ऐ ज़ा, साहस ढोते। न पाप छेमा ताइदा।” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />ब्यबस्थाला शास्त्रीयाङ मध्य<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="ft" closed="false">शास्त्री = कानुनी लेखापदी ढान्या</char></note> ख्वाएले रारांल ऐलेवाङ, “इकाले परमेस्वरलं अपमान ढाज्याया।” <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />येशुले नकाङल बिचार सनस्यु ऐआढोवाङ, “जे दानाङ जे यिङल माचान्या बिचार ढाज्याच्यो? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />नैताहकन कै ढान्या सजिलो लेऊ, ‘न पाप छेमा ताइदा’ ऐलेन्या सन् ‘सोन्ते ओटन बान्ते’ ऐढान्या? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />तर रुल ज़ाल पिरथ्बील पाप छेमा ढान्या अढिकार लेया ऐलेस्यु जे सनौ ढुदुचिते।” तब ओले ना लुलाजन ऐआढोव, “सोन्ते, न चारपाई वुरते, ओटन नझिम देए हिनन्ते।” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />ओटन ना सोव, ओटन आझिमदेए लागिऊ। <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />जब रुयाङल हुलले ईका रांरङौ, तब नकाङ छ्याएछ्याए ताइवाङ, ओटन रुयाङजन ऐटाइन्या सक्ति आयांऔकाले परमेस्वरलं प्रसम्सा रांढोव।<verse eid="MAT 9:8" /></para>
  <para style="s">येशुले मत्तीजन आखुलन्या</para>
  <para style="r">
    <ref loc="MRK 2:13-17">मर्कुस २:१३-१७</ref>; <ref loc="LUK 5:27-32">लूका ५:२७-३२</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />येशु नङंन आहिनज्याऔक मत्ती ऐराढान्या तोलोअ रुजन तिरो उठाइन्या अड्डाल आचुङज्यान्या आरङौ, ओटन नकाजन ऐआढोव, “ङा छिन्ट लागिन्ते।” ना च्याङौ ओटन ओलं छिन्ट लागिऊ।<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />येशु मत्तीलं झिमल ज्यान्या आज्याज्याऔक, तबर जना तिरो उठाइन्याङ सनर बिरोद ढान्याङ रा:स्यु ओल सनर आसिइयाङसं ज्यान्या लेस्यु चुङवाङ।<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">लूका १५:१-२</ref></char></note> <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />जब फरिसीयाङ ना रांरङौ, तब ओलं सिइयाङजन रांगिन्वाङ, “दानाङ जे गुर तिरो उठाइन्याङ सनर पापीयाङस ज्यौ?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />ईका थएस्यु येशुले ऐआढोवाङ, “नाएमाबोरन्याङजन गुनील आबस्यक माल्दी, तर रोगियाङजन लेया। <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />तर हिनस्यु इकाल अर्थ नैति जे ह्युउसिचिते, ‘ङा बलि माचाहिङडी, दया चाहिङा।’ दानाङभन्या ङा सोझाङजन माङडी, तर पापीयाङजन ङाखुलराङु हो।”<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAT 12:7">मत्ती १२:७</ref>; <ref loc="HOS 6:6">होशे ६:६</ref></char></note><verse eid="MAT 9:13" /></para>
  <para style="s">बर्तल बारे रांगिनन्या</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />तब बप्तिस्मा यांन्या यहुन्नाल सिइयाङ आल्योङ रा:स्यु रांगिनौ, “दानाङ गे सनर फरिसीयाङ बर्त चुङै, तर न सिइयाङ बर्त माचुङर?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />येशुले नकाङजन ऐआढोवाङ, “जैकसमन दुलाहा जन्तियाङसं कोठाल लिज्या, नैति नकाङ शोक रामनाहौ का? तर ना दिन रांन्यालेया जब दुलाहा नकाङ्ङन लाङसी, तब नकाङ बर्त चुङन्या लेरा।<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“तर काङ्काईले पुरानो क्वात छार क्वाल टालाले मापएरदी। दानाङभन्या छार टालाले पुरानोजन झन्जै भ्या चिइवा। <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />तर काङ्काईले पुरानो छालाल मशकलं छार अङ्गुरल रस मानाटौदी, मानकन्ता मशक पाअसिस्यु यिईस्यु खेमा। तर छार अङ्गुरल रसजन छारजै छालाल मशकलं नाएसिकन, नेंलोअजै जोगिन्या।”<verse eid="MAT 9:17" /></para>
  <para style="s">सिन्या किटी सनर नाएबोरन्या मेएमा नेंबेलन्या</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />जब येशुले नकाङजन ईका छेन पानस्याज्याऔ, तब बैठअझिमला तोलोअ शासक रांऔ, ओटन ओलजन धोक यांस्यु ऐआढोव, “औ गुरु मेएमा ङाज़ा भाबाअ सिस्यु लेऊ, नङ रा:स्यु नकाल यर्त नकुई नाएते, ओटन नका बान्चिन्या लेया।”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />येशु सोस्यु च्याङस्यु आसिइयाङसं शासकलं छिनछिन हिनौ। <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />नवाए बेला बारं बर्सकन जी बगिन्या बेथा लेन्या तोलोअ मेएमा छिन्ङन रा:स्यु ओलं क्वाल टुप्पा आछुउ।<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="MAT 14:36">मत्ती १४:३६</ref></char></note> <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />दानाङभन्या नकाले आयिङयिङल यिङसिस्यु ऐलिज्याऊ, “इकाल क्वा याएज छुङकन बै ङा ऐबेल्ङा।” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />येशुले फरअ वलस्यु आब्याटौक ना मेएमाजन आरङौ, ओटन ऐआढोव, “ऐ ज़ा, साहस ढोते, न बिस्वासले नङजन सबेल्दुन्वा।” ना मेएमा नवाए बेलाई बेलौ।<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />ओटन जब येशु शासकलं झिमल ताप्‌रा:औ, ओले बाङसुली तपन्याङ सनर रुयाङ हुलले चिचच्याबास रालज्यान्या आरङवाङ। <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />येशुले नकाङजन ऐआढोवाङ, “जे बाहेर हिन्चिते, दानाङभन्या किटी सिस्यु माल्दी, रुउज्याऔ दी।” ऐआलेऊक नकाङ शाईवाङ। <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />रुयाङजन बाहेर देए पलिटौरा पाइना ओलं भितरलं पसिऊ, ओटन ना किटील कुई आकोलोकौ, ओटन ना जरू सोव। <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />तब ईका छेनल बाए ना देसभरि फैलिऊ।<verse eid="MAT 9:26" /></para>
  <para style="s">येशुले नेंलोअ अन्ढलाने आसबेलौने</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />येशु नङंन आहिनज्याऔक नेंलोअ अन्ढलानेले “ऐ दाऊदल ज़ा, घेनजन दया ढासिन्ते” ऐलेस्यु कलिकौयन आछिनछिन लागिऊने। <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />ओ झिमल पसियापाइना ना अन्ढलाने आल्योङ रांऔने। ओटन येशु नकानेजन ऐआढोवने, “ङा आका ऐढुदुङा ऐलेस्यु झेन बिस्वास माढोचिनच्यो?” नकाने ओलजन ऐनेढोव, “औ, प्रभु।” <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />तब येशुले नकानेल म्युउ छुस्यास्यु ऐआढोवने, “झेन बिस्वास अनुसार झेनजन नैजै ग्याताइत्या।” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />ओटन नकानेल म्युउ रंनौ। येशुले ऐढास्यु नकानेजन कडा चेताउनी आयोवने, “ईका छेन काङ्काईले तासनरत्या।” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />तर नकाने हिनौने, ओटन नका देसला इलाकाभरि आबाए नेंफैलाहौ।<verse eid="MAT 9:31" /></para>
  <para style="s">येशुले लाताजन आसबेलन्या</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />जब ओयाङ पलिईस्यु हिनज्यावाङ, तब दुस्टआत्मा लागिन्या तोलोअ छ्योङौ माढुदुन्या रुजन येशु ल्योङ होन्सिऊ। <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />भूत पलिइवापाइना नका लाटा छ्योङौ। ओटन “इस्राएलतं ऐटाइन्या खकै मारङसिदी” ऐलेस्यु रुयाङ हुल अचम्मै ताइवाङ। <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />तर फरिसीयाङ ऐलेऊ तअसिवाङ, “दुस्टआत्माङलं खसमङन्जै नकाले दुस्टआत्माङ पलिटौरा।”<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">मत्ती १०:२५</ref>; <ref loc="MAT 12:24">१२:२४</ref>; <ref loc="MRK 3:22">मर्कुस ३:२२</ref>; <ref loc="LUK 11:25">लूका ११:२५</ref></char></note><verse eid="MAT 9:34" /></para>
  <para style="s">येशुले रुयाङजन दया ढोवरा</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />येशु सोगल सहरल सनर नङ्गरल यहूदीयाङल आराधना झिमजिऊल सिक्छ्या यांऔयन, परमेस्वरलं राज्यल चान्याथाई प्रचार ढाऔयन सनर सोगलै किसिमला नाएबोर सनर दुर्बलताङ सबेलौयन बाज्याऔ।<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">मत्ती ४:२३</ref>; <ref loc="MRK 1:39">मर्कुस १:३९</ref>; <ref loc="LUK 4:44">लूका ४:४४</ref></char></note> <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />तर रुयाङल हुलजन रङस्यु येशुल यिङ नकाङ नाल्ट दयाले भरिसिऊ। दानाङभन्या नकाङ बिनाग्वालाला भेडाङमन्जै हलाअ सनर बाठए ताइस्यु लेवाङ।<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">गन्ती २७:१७</ref>; <ref loc="1KI 22:17">१राजा २२:१७</ref>; <ref loc="2CH 18:16">२इतिहास १८:१६</ref>; <ref loc="EZK 34:5">इजकिएल ३४:५</ref>; <ref loc="MRK 6:34">मर्कुस ६:३४</ref></char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />तब ओले आ सिइयाङजन ऐआढोवाङ, “बाली ता खाटखाट जै लेया, तर कामदारयाङ भन्या थोरैज लेरा।<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="LUK 10:2">लूका १०:२</ref></char></note> <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />नैताइस्यु बाली खानौ नाल्ट खेएल न कामदारयाङ परिङस्यासिन ऐलेस्यु प्रभुजन प्रार्थना ढोचिते।”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">येशुले आपरिङन्या बारं प्रेरितयाङ</para>
  <para style="r">
    <ref loc="MRK 3:13-19">मर्कुस ३:१३-१९</ref>; <ref loc="MRK 6:7-13">६:७-१३</ref>; <ref loc="MRK 13:9-13">१३:९-१३</ref>; <ref loc="LUK 6:12-16">लूका ६:१२-१६</ref>; <ref loc="LUK 9:1-6">९:१-६</ref>; <ref loc="LUK 12:2-9">१२:२-९</ref>; <ref loc="LUK 21:12-17">२१:१२-१७</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />येशुले बारं गोटा सिइयाङजन खुल्स्यु अशुद्दआत्माङ पलिईन्या सनर सोगलै किसिमला नाएबोर सनर दुर्बलताजन सबेलन्या अढिकार आयोवाङ। <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />बारं प्रेरितयाङल मिन आकाई ज्या, पैला पत्रुस ऐढासिन्या सिमोन सनर नकाल भाई अन्द्रियास, जब्दियाल ज़ा याकूब सनर नकाल भाई यहुन्ना, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />फिलिप सनर बारथोलोमाइ, थोमा सनर तिरो उठाइन्या मत्ती, अल्फयसलं ज़ा याकूब ओटन थेदियस, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />सिमोन कनानी सनर यहूदा इस्करियोत, जोले येशुजन कोलोकौ आपरिङौ।<verse eid="MAT 10:4" /></para>
  <para style="s">बारं सिइयाङल सेवाकाई</para>
  <para style="r">
    <ref loc="MRK 6:7-13">मर्कुस ६:७-१३</ref>; <ref loc="LUK 9:1-6">लूका ९:१-६</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />येशुले नका बारं गोटा सिइयाङजन आदेस यांस्यु आपरिङवाङ, “गैरयहूदीयाङल खार्ल ताहिनच्यो, अथाबा सामरीयाङल सहरल तापसिच्यो।”<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="JER 50:6">यर्मिया ५०:६</ref></char></note> <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />तर इस्राएल जातिला मांन्या भेडाङ ल्योङ हिन्चिते। <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />स्वर्गलं राज्य नेराकै ताप्‌रा:स्यु लेया, ऐलेस्यु प्रचार ढोचिते।<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">लूका १०:४-१२</ref></char></note> <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />नाएबोरन्याङजन सबेल्चिरते, सिन्याङजन जिङदा जाएचिरते, कोर लागिन्याङजन चोखा जाएचिरते, भूतयाङ पलिइचिरते। जे डाङज जेडोएचिऊ, डाङजै योंचिरते। <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />जे झेलील सुन, चान्दी सनर ताम्बाल पैसा तावुरच्यो, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />जेबाऔक झ्योला, नें जोर दौरा, जुता, झुई तालाङच्यो। दानाङभन्या कामदारले आज्यान्या डोटौज परिया।<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">१कोरिन्थी ९:१४</ref>; <ref loc="1TI 5:18">१तिमोथी ५:१८</ref></char></note><verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />“जो सहर या नङ्गरल जे पसिच्यो, नल काङ्का लायकला लेऊ ऐलेस्यु रोअचिते, ओटन नलन बिदा जेमाताहौ समन नलै चुङज्याचिते।” <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />नका झिम भितरलं जेपसिऊक जडौ ढोचिरते। <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />यदि नका झिमला रुयाङै जेजन स्वागत ढाचिरकन नका झिमल शान्ति ग्यारांत्या। तर नला रुयाङै जे जडौ माहोलरकन, शान्ति जेल्यौदेए वलस्यु ग्यारांत्या। <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />यदि काङ्काङै जेजन स्वागत माढाचिरकन या जे छेन माथएदुरा भन्या, ना झिमलन अथाबा सहरलन जेपलिहौक जेखङला धुलो हरस्योचिरते।<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">प्रेरित १३:५१</ref></char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />ङा जेजन, मछ्यु ऐढाच्या, नियाल दिनक ना सहरल दशातन बरु सदोम सनर गमोराल दशा भ्याई मासहिदुन्या ताहा।<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">मत्ती ११:२४</ref>; <ref loc="GEN 19:24-28">उत्पत्ति १९:२४-२८</ref></char></note><verse eid="MAT 10:15" /></para>
  <para style="s">रांङालेन्या दुख</para>
  <para style="r">
    <ref loc="MRK 13:9-13">मर्कुस १३:९-१३</ref>; <ref loc="LUK 21:12-17">लूका २१:१२-१७</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“ब्याएचिते, ङा जेजन फ्याऊयाङ खार्ल भेडाङमन परिङज्याच्या, नैताइस्यु जे डाङमन चलाक सनर कचिकुरमन सोझा ताइचिते।<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">लूका १०:३</ref></char></note> <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />तर रुयाङतन होसियार ताइचिते, दानाङभन्या नकाङै जेजन अदालतल सुम्पिचिरा, ओटन यहूदीयाङल आराधना झिमजिऊल जेजन कोर्ला राइस्याचिरा।”<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">मर्कुस १३:९-११</ref>; <ref loc="LUK 12:11">लूका १२:११</ref>; <ref loc="LUK 12">१२</ref>; <ref loc="LUK 21:12-15">२१:१२-१५</ref></char></note> <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />ङागर्दाले जेजन हाकिमयाङ सनर रययाङै सामन्दी सच्यानन्यालेरा, ओटन नकाङ सनर गैरयहूदीयाङल नाल्ट साची ताइन्यालेच्या। <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />तर जब नकाङै जेजन कोलोकौपरिङचिर, तब जे नै छ्योङै ऐलेस्यु ताआतिच्यो। दानाङभन्या जे नै छ्योङौ परिन्या, नवाए बेला जेजन पानस्यासिया। <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />दानाङभन्या जे जेईज छ्योङन्या माताइचिदी, तर जे बौल आत्मा जेल्योङन छ्योङन्या लेया। <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />“दाज्यूभाईले दाज्यूभाईजन सटौ नाल्ट जिम्मालाइरा, बौले ज़ायाङजन, ओटन ज़ायाङ बौ आमाङल बिरोदत च्याङन्या लेरा ओटन नकाङजन सटौ परिङन्या लेरा।”<note caller="-" style="x"><char style="xo" closed="false">10:21 </char><char style="xt" closed="false"><ref loc="MRK 13:12">मर्कुस १३:१२</ref>; <ref loc="LUK 21:16">लूका २१:१६</ref></char></note> <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />ङा मिनले गर्दा जे सोगलैङन सज्युस्युनीच्या। तर जो छिन्ट समन तनस्यु लिज्या, नकाईल उद्दार ताहा।<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">मत्ती २४:९</ref>; <ref loc="MRK 13:13">मर्कुस १३:१३</ref>; <ref loc="LUK 21:17">लूका २१:१७</ref>; <ref loc="MAT 24:13">मत्ती २४:१३</ref>; <ref loc="MRK 13:13">मर्कुस १३:१३</ref></char></note> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />जब नकाङै जेजन तोलोअ सहरल सटाइचिर तब छुट्टै सहरल ढोङचिते। दानाङभन्या मछ्यु ङा जेजन ऐढाच्या, रु ल ज़ा आमाराऔ हादेए जे इस्राएल सहरला जे डुलिस्यु खेमन्या माल्चिदी।<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“सिइ गुरतन सनर नोक्कर साहूतन घिन्या माताइदी।”<note caller="-" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">लूका ६:४०</ref>; <ref loc="JHN 13:16">यहुन्ना १३:१६</ref>; <ref loc="JHN 15:20">१५:२०</ref></char></note> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />सिइ आगुरमन सनर नोक्कर साहूमनताइन्या पक्काई ज्या। यदि नकाङै झिमला साहूझन्ज बालजिबुल ऐढोरकन, आजाहानयाङजन ख्वाए भ्याई रांढोव होला?<note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">मत्ती ९:३४</ref>; <ref loc="MAT 12:24">१२:२४</ref>; <ref loc="MRK 3:22">मर्कुस ३:२२</ref>; <ref loc="LUK 11:15">लूका ११:१५</ref> </char></note><verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“नैताइस्यु नकाङ रङस्यु ताछ्याएच्यो। दानाङभन्या कप्स्यु मारंनन्या सनर मोअस्यु थाह माताइन्या नैज माल्दी।”<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">मर्कुस ४:२२</ref>; <ref loc="LUK 8:17">लूका ८:१७</ref></char></note> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />ङा जेजन चिऊन्याल जो पानस्याच्यो, ना जे रंनन्याल पानस्योचिरते, ओटन जे गोप्यल जेथएन्या, झिमल धूरीतन प्रचार ढोचिते। <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />नकाङसं ताछ्याएच्यो, जोले बुलजन सएर, तर आत्माजन सटौ माढुदुरदी। बरु आत्मा सनर बुल नेंलोअजन नरगल नास जाएन्या परमेस्वरजन रङस्यु छ्याएचिते। <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />नैति त पैसालं नेंलोअ भिङ्गुऱ्या मायहौने? नकाने मध्य तोलोअ बै जे बौल इच्छ्याबिना नामल तेइन्यामाल्नेदी। <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />जे ङएला स्वाट्टै चेमसऱ्या बै गनिस्यु नाएसिया।<note caller="-" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="LUK 12:7">लूका १२:७</ref></char></note> <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />नैताइस्यु ताछ्याएच्यो, जे तबर भिङ्गुऱ्याङतन भ्याई करन्या लेच्या।<verse eid="MAT 10:31" /></para>
  <para style="s">ख्रीस्टजन मानिन्या सनर मामानिन्या</para>
  <para style="r">
    <ref loc="LUK 12:8-9">लूका १२:८-९</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“नैताइस्यु जोले रुयाङ हार्मै ङाजन निज्याङु, ङा बै नकाजन स्वर्गल लिज्यान्या ङा बौल लेऊक मानिन्यालेङा। <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />तर जो-जोले ङाजन रुयाङल हार्मै मामानिङु, ङा बै नकाजन स्वर्गल लिज्यान्या ङा बौल लेऊक मामानिङदी।”<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">२तिमोथी २:१२</ref></char></note><verse eid="MAT 10:33" /></para>
  <para style="s">शान्ति माङडी तरवाल</para>
  <para style="r">
    <ref loc="LUK 12:51-53">लूका १२:५१-५३</ref>; <ref loc="LUK 14:24-27">१४:२४-२७</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“ङा पिरथ्बील शान्ति होनन्या ङारांङु, ऐलेस्यु तायिङच्यो। शान्ति होनन्या माङडी, तर तरवाल चलाइन्या ङारांङु हो। <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />दानाङभन्या ङा रुजन आबौल बिरोदत, सनर मेएमाज़ाजन आअमाल बिरोदत, ओटन ब्वाहारीजन फुबुल बिरोदत ङाजाएराङु हो।”<note caller="-" style="x"><char style="xo" closed="false">10:35 </char><char style="xt" closed="false"><ref loc="MIC 7:6">मीका ७:६</ref></char></note> <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />रुल शत्तुर नकाल आझिमलाइज ताइन्यालेरा। <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />“जोले ङातन भ्याई आबौ या आअमाजन प्रेम ढोव, ना ङा सिइ ताइन्या लायकला माताइदी। जोले ङा भन्या भ्याई ल्हेपाज़ा या मेएमाज़ाजन प्रेम ढोव, ना ङा सिइ ताइन्या लायकला माताइदी।” <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />जो आक्रूस वुरस्यु ङाछिन्ट मालागि, ना ङा लायकला माताइदी।<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:17">मत्ती १६:१७</ref>; <ref loc="MRK 8:34">मर्कुस ८:३४</ref>; <ref loc="LUK 9:23">लूका ९:२३</ref></char></note> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />जोले आपरान जोगाहौ, नाले आत्मा गवाइवा, ओटन ङा नाल्ट आपरान गवाइन्याले जिबन डोएवा।<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">मत्ती १६:२५</ref>; <ref loc="MRK 8:35">मर्कुस ८:३५</ref>; <ref loc="LUK 9:24">लूका ९:२४</ref>; <ref loc="LUK 17:33">१७:३३</ref>; <ref loc="JHN 12:25">यहुन्ना १२:२५</ref></char></note><verse eid="MAT 10:39" /></para>
  <para style="s">इनाम</para>
  <para style="r">
    <ref loc="MRK 9:41">मर्कुस ९:४१</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“जेजन ग्रहन ढान्याले ङाजन ग्रहन ढाङवा, ओटन ङाजन ग्रहन ढान्याले ङाजन परिङन्याजन बै ग्रहन ढोवा।<note caller="-" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="LUK 10:16">लूका १०:१६</ref>; <ref loc="JHN 13:20">यहुन्ना १३:२०</ref>; <ref loc="MRK 9:37">मर्कुस ९:३७</ref>; <ref loc="LUK 9:48">लूका ९:४८</ref></char></note> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />जोले अगमबक्ताजन अगमबक्ता लेस्यु स्वागत ढोव नकाले इनाम डोएवा, ओटन जोले धर्मि रुजन धर्मि लेस्यु स्वागत ढोव, नकाले इनाम डोएन्यालेया। <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />जोले आका इङन्याङ मध्य तोलोअजन ङा सिइ यिङस्यु त खुरी चिसो री ओव योंव, ङा मछ्यु जेजन ऐढाच्या, कि नकाले आइनाम ऐजै गवाइन्यामाल्दी।”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">येशु सनर बप्तिस्मा यांन्या यहुन्ना</para>
  <para style="r">
    <ref loc="LUK 7:18-35">लूका ७:१८-३५</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />जब येशुले बारैं गोटा सिइयाङजन थाकौरा पाइना ओल नका पो राइस्यु, ओलं नेराजिऊला सहरजिऊल ह्युउन्या सनर चान्याथाई प्रचार ढाऔ नाल्ट हिनौ। <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />बप्तिस्मा यांन्या यहुन्नाले येशु ख्रीस्टल कामल बाएबिइ झ्यालखानाल आथटौ, ओटन सिइयाङजन नका ल्योङ ईका छेन गिननाऔ आपरिङवाङ, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />नकाङै रा:स्यु येशुजन रांगिनौ “नैति यहुन्नाले आपानन्या अनुसार गेजन मुक्ति यांन्यावाला नङज, सन् गे छुट्टैजन वुटै?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />येशुले नकाङजन ऐआढोवाङ, “जे जेथएन्या सनर जेरङन्या छेन यहुन्नाजन पानस्योचिते, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />अन्ढलाङै नजर डोएरा, ओटन लुलाङ बारा। कोर लागिन्याङ चोखा जाएस्युनाएसिरा। ना भैराङ थटौ ढुदुन्या ताइस्युलेरा। सिन्याङ जिङदा ताइस्यु सोस्यु लेरा, ओटन गरिबयाङजन चान्याथाई प्रचार ढाज्यासिया।<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">यशैया ३५:५-६</ref>; <ref loc="ISA 61:1">६१:१</ref></char></note> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />नका बअचान्या रु हो जोले ङाजन सङ्का माढाङुदी।”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />यहुन्नाल सिइयाङ राहिनज्याऔक येशुले रुयाङ हुलजन आबारेङन ऐआढोवाङ, “जब जे यहुन्नाजन खिमौ नाल्ट हरहर पोल जेहिन्चिऊ तब जे नै जेरङचिऊ? नैति घूईकाले आहल्लाइज्यान्या चलजन?” <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />वन नै जेखिम्नाचिऊ वन? नैति चान्या क्वा क्वाएसिन्या रुजन जेखिम्नाचिऊ? चान्या क्वा क्वाएसिन्याङ ता रययाङल दरबारलदी चुङर। <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />“जे दानाङ हिनच्योवन? नैति अगमबक्ताङजन खिमौ नाल्ट? ङा जेजन ऐढाच्या अगमबक्ताङतन बै घिन्या रुजन। <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />यहुन्ना नका रु हो, जोल बारेल पबित्रशास्त्रलं सरसिज्याऔ, ‘खिम्चिते, ङा ङादुतजन जे हा-हा परिङ्ङा, जोले जे हार्मै जे यम तयार जाएवा।’”<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">मलाकी ३:१</ref></char></note> <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />ङा मछ्यु, जेजन पानस्याच्या, मेएमाङन जर्मिन्याङ्ङन बप्तिस्मा-यांन्या यहुन्नातन घिन्या अपुर काङ्काई ताइस्यु माल्दी। तर बै स्वर्गला राज्यल जो सोगलैतन इङन्या ले, ना ईका तन घिन्या हो।<verse eid="MAT 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 11:12" />बप्तिस्मा यांन्या यहुन्नाल प्रचारल बेलाकन आकअ समन स्वर्गल राज्य चोएसै हादेए बदिस्यु लेया, ओटन बलल्याङै नकाजन जोरसकाए कोलोअरा।<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="LUK 16:16">लूका १६:१६</ref></char></note> <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />दानाङभन्या यहुन्नाल पालासमन मोशा अगमबक्ताल ब्यबस्था सनर स्वर्ग राज्यल बारेल सोगल भबिस्यबानी ढास्युलेरा। <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />जे नकाङ रापानन्या छेन कोनच्योकन नकाङै रांया ऐरालन्या एलिया आकाई ज्या।<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">मलाकी ४:५</ref>; <ref loc="MAT 17:10-13">मत्ती १७:१०-१३</ref>; <ref loc="MRK 9:11-13">मर्कुस ९:११-१३</ref></char></note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />जोल थएन्या ना ले, नकाले ग्याथटौत्या। <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />“ङा ईका पुस्ताला रुयाङजन नैस दान्जिङर? ईका ता बजारल रेएसिन्या इङइङन्या लुलल्याङ बराबर ज्या, जोयाङै रांमि न्हाएयाङजन खुल्स्यु ऐढोरा, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />‘गे जे नाल्ट बाङसुली गेतपयिउ, तर जे मास्यांदुच्या। गे दुखला रेए गेरेएसियिउ, तर जे सोक मामनाईदुच्या।’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />दानाङभन्या यहुन्ना ज्यास्यु सनर ओस्यु मारा:दा, ओटन नकाङ ओजन भूत लागिदा ऐराढोव। <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />जब रुल ज़ा ज्यास्यु सनर ओस्यु रांऔ, ओटन नकाङ ऐढोरा, ‘खिम्चिते, हापस्या, मंङवा, तिरो उठाइन्याङ सनर पापीयाङल न्हाए ज्या!’ परमेस्वरलं बुद्दि ठिकै ज्या, ऐलेन्या छेन नकाल कामयाङतन आशई ताइन्यालेया।”<verse eid="MAT 11:19" /></para>
  <para style="s">अबिस्वासी सहरयाङ</para>
  <para style="r">
    <ref loc="LUK 10:13-15">लूका १०:१३-१५</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />येशुले जो-जो सहरल भ्याई अचम्मला कामयाङ आढोव, तर नला रुयाङै पस्चाताप रांमाढाऔकाले ओले नकाङजन आसज्याअवाङ। <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“आक्याई खोराजीन, आक्याई नङ बेथसेदा! दानाङभन्या जेल्योङ ढासिन्या अचम्मला कामयाङ टुरोस सनर सीदोनल ढासिन्या ताहकन, नकाङै ऐकैज भोङग्रा क्वाएसिस्यु सनर धुलिइ ठिइसिस्यु पस्चाताप ढान्या लेवाङ।<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">यशैया २३:१-१८</ref>; <ref loc="EZK 26:1-21">इजकिएल २६:१-२१</ref>; <ref loc="JOL 3:4-8">योएल ३:४-८</ref>; <ref loc="AMO 1:9-10">आमोस १:९-१०</ref>; <ref loc="ZEC 9:2-4">जकरिया ९:२-४</ref> </char></note> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />तर ङा जेजन ऐढाच्या, नियाल दिन छिम्क जेतन टुरोस सनर सीदोनल हालत भ्याई सहिउतारका ताइन्यालेया। <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />ऐ, कफर्नहुम, ओक्या नङ नम समन छेन्सिना का? नङ पतालसमन सतेइसिना। दानाङभन्या नल्योङ ढासिन्या अचम्मला कामयाङ सदोमल ढासिन्या ताहकन ना आछिम समन लिज्यान्या लेऊ।<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">यशैया १४:१३-१५</ref>; <ref loc="GEN 19:24-28">उत्पत्ति १९:२४-२८</ref></char></note> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />तर ङा नङजन ऐढाना, नियाल दिनक न दशातन ता सदोम सहरल दशा भ्याई सहिउतारका ताइन्यालेया।”<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">मत्ती १०:१५</ref>; <ref loc="LUK 10:12">लूका १०:१२</ref></char></note><verse eid="MAT 11:24" /></para>
  <para style="s">ङाल्योङ रांचिते ओटन नानसिचिते</para>
  <para style="r">
    <ref loc="LUK 10:21-22">लूका १०:२१-२२</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />नवाए बेला येशुले ऐलेऊ, “औ बौ, स्वर्ग सनर पिरथ्बीला प्रभु, ङा नङजन धन्याबाद यांना, दानाङभन्या नङ ईका छेन बाठोयाङ सनर बुद्दिमान सितछित रुयाङतन गोप्य नाएस्यु, बालअयाङजन ना नठनस्योनवाङ।” <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />औ ओज्या, बौ, दानाङभन्या नङजन ईकाइ चान्या लागिऊ।<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“ङा बौले स्वाट्टै जन्तु ङाजन यांस्यु नाटङवा। नैताइस्यु बौ बाहेक ज़ाजन काङ्काईले मासहौदी, नामन्जै ज़ाले बाहेक बौजन काङ्काईले मासहौदी, नैताइस्यु नकाङ बै ऐशईरा, जोजन ज़ाले बौ थनन्या इच्छ्या ढोव।”<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="JHN 3:35">यहुन्ना ३:३५</ref>; <ref loc="JHN 1:18">१:१८</ref>; <ref loc="JHN 10:15">१०:१५</ref></char></note> <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />“ऐ सोगल थाकिन्याङ सनर वुरले आहराइन्याङ, ङाल्योङ रांचिते, ङा जेजन नानसिऊ यांच्या। <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />ङा कुम जेयर्त नाएचिते, ओटन ङासकाए ह्युउसिचिते, दानाङभन्या ङा नरम सनर दयालु यिङला लेङा, ओटन जे जेआत्माल नानसिऊ डोएन्यालेच्या।<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JER 6:16">यर्मिया ६:१६</ref></char></note> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />दानाङभन्या ङा कुम सजला लेया, ओटन ङा वुर बुङन्या लेया।”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">शबाथल बारे रांगिनन्या</para>
  <para style="r">
    <ref loc="MRK 2:23-28">मर्कुस २:२३-२८</ref>; <ref loc="MRK 3:1-6">३:१-६</ref>; <ref loc="LUK 6:1-11">लूका ६:१-११</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />नका बेला येशु सनर आ सिइयाङ शबाथ<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">सबाथ=नानसिन्या दिन</char></note> छिम्क अन लेन्या खेएलन ताइस्यु राहिनज्याऔक। करेस्यु लेवाङ ओटन पलीमाल बाला पलेटौयन हामौ तअसिवाङ।<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ब्यबस्था २३:२५</ref></char></note> <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />तर फरिसीयाङै आका रङस्यु ओलजन ऐराढोव, “खिम्ते न सिइयाङ शबाथ छिम्क जो ढान्या ठिक माले ओइ ढाज्यारा।”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />तर येशुले नकाङजन जबाक आयोवाङ, “दाऊद सनर आन्हाएयाङ राकरेज्याऔक नै रांढोव, नैति जे परीस्यु जेमाल्चिऊ?<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">१शमूयल २१:१-६</ref></char></note> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />दाऊदले कैलेस्यु परमेस्वरलं झिम भितरलं पसिस्यु चराइसिन्या पबित्र भरेई ओल सनर आन्हाएयाङै रांकयौ? जो भरेई कैन्या ब्यबस्थाला नियाम अनुसार पुजाउरोयाङजन याएज कैन्या अनुमति लेऊ।<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">लेवी २४:९</ref></char></note> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />अथाबा नैति ब्यबस्थालं नियाम परीस्यु जेमाल्चिऊ, कैलेस्यु शबाथल पुजाउरोयाङै मन्दिरलं ब्यबस्थाजन भङ्ग रांजाटौ, ओटन बै दोस मालन्या ताइरा?<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">गन्ती २८:९-१०</ref></char></note> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />तर ङा जेजन ऐढाच्या, आल मन्दिरतन बै घिन्या तोलोअ लिज्याया। <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />तर पबित्रशास्त्रले ऐलेया ‘ङा बलि माचिहिङडी,’ दया चाहिङा ऐङालन्याल अर्थ नैति ना जे जेसनन्या ताहकन जे निर्दोसयाङजन दोस लाइन्यामाल्चिदी।<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">मत्ती ९:१३</ref>; <ref loc="HOS 6:6">होशे ६:६</ref> </char></note> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />दानाङभन्या रुल ज़ा शबाथ दिनल बै प्रभु ज्या।”<verse eid="MAT 12:8" /></para>
  <para style="s">येशुले आकुई राङन्या रुजन आसबेलौ</para>
  <para style="r">
    <ref loc="MRK 3:1-6">मर्कुस ३:१-६</ref>; <ref loc="LUK 6:6-11">लूका ६:६-११</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />नङंन पलिईस्यु येशु नकाङल बैठअझिमल हिनौ। <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />नल तोलोअ आकुई राङन्या रु लिज्याऔ। फरिसीयाङ दोस लाइन्या यिङले ओलजन रांगिनौ, “नैति शबाथ छिम्क काङ्काङजन सबेलन्या ठिक लेऊ?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />येशुले नकाङजन आढोवाङ, “जे मध्य तोलोअ जोल भेडा लेऊ, ओटन शबाथ छिम्क ना भेडा खादाल तेहकन, नैति जे नकाजन कोलोअस्यु पाखाल जेमापलिईचिऊ का?<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">लूका १४:५</ref></char></note> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />भेडातन रु ख्वाए भ्याई येएला लेऊ? नैताइस्यु ब्यबस्था अनुसार शबाथ छिम्क तोलोअले छुट्टैजन भलाई ढान्या चान्याई ताहा।” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />तब ओले ना रुजन ऐआढोव, “न कुई पसारते।” नकाले कुई आपसारिऊ, ओटन ना कुई छुट्टै मन्जै ताइदा। <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />तर फरिसीयाङ बाहेर हिनस्यु इकाजन कैलेस्यु सएन्या लेस्यु ओलं बिरोदत सल्ला ढाऔ तअसिवाङ।<verse eid="MAT 12:14" /></para>
  <para style="s">परमेस्वरले आछेलन्या सेबक</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />तब ना छेन सनस्यु येशु नलन हिनौ, ओटन तबर जना नाएबोरन्याङ आछिनछिन लागिवाङ, ओटन ओले नकाङ सोगलैजन आसबेल्वाङ। <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />तर इकाल बारेल ङा काङ्का आका काङ्काईजन तापानस्योचिर ऐलेस्यु नकाङजन आथाअवाङ। <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />परमेस्वरले आपानन्या बचन यशैया अगमबक्ताङन पुरा ग्याताइत्या लेस्यु ऐताहौ। <verse eid="MAT 12:17" /><verse number="18" style="v" sid="MAT 12:18" />“खिम्चिते ङा ङाछेलन्या ङायिङ्का सेबक लेया, जोजन ङा मया ङाढोङु, ङा ङाआत्मा नका ल्योङ परिङ्ङा, ओटन नकाले गैरयहूदीयाङ खार्ल नियाल प्रचार ढान्यालेया।<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">यशैया ४२:१-४</ref></char></note> <verse eid="MAT 12:18" /><verse number="19" style="v" sid="MAT 12:19" />नका न त यिसी, न भ्याई कलिऊक, न त काङ्काईले नकाल ग़ा द्वाहा जिऊल थएर। <verse eid="MAT 12:19" /><verse number="20" style="v" sid="MAT 12:20" />पाअन्या सरा नकाले कलाएन्या माल्दा, ओटन ज़ुइ-ज़ुइ लिज्यान्या लसए नकाले सएन्यामाल्दी, ओटन आसापङा नियाल झ्योङ समन सतापन्यालेया। <verse eid="MAT 12:20" /><verse number="21" style="v" sid="MAT 12:21" />नकालै मिनत गैरयहूदीयाङ आस नाएन्या लेरा।”<verse eid="MAT 12:21" /></para>
  <para style="s">येशु सनर बालजिबुल</para>
  <para style="r">
    <ref loc="MRK 3:20-30">मर्कुस ३:२०-३०</ref>; <ref loc="LUK 6:43-45">लूका ६:४३-४५</ref>; <ref loc="LUK 11:14-23">११:१४-२३</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />तब येशु ल्योङ तोलोअ भूत लागिन्या रु जो अन्ढला सनर लाटा लेऊ। ओले नकाजन आसबेलौ, आवाए समन कि, ना लाटा रु छ्योङन्या सनर रङौ तअसिऊ। <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />ओटन सोगल रुयाङ हुलले अचम्म मानिस्यु ऐलेवाङ, “नैति ईका दाऊदल सन्तान जै का?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />तर आका थएस्यु फरिसीयाङै ऐलेवाङ, “ईका रुले भूतल खसम बालजिबुलङन याएज भूतयाङजन पलिटौरा।”<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="MAT 9:34">मत्ती ९:३४</ref>; <ref loc="MAT 10:25">१०:२५</ref></char></note><verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />तर येशुले नकाङल यिङला बिचार सनस्यु नकाङजन ऐआढोवाङ, “रारांल पाअस्यु सोगल राज्य हरहर जाएन्यालेसिया, ओटन सोगल झिम सनर सहरल रारांल भर्काइसिइ ताहकन तनन्या मालरदी।” <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />यदि सैतानले सैतानजन पलिटौकन, ना आमिई बिरोदत भाअभाअ ताहा, ओटन नैताहकन नकाल राज्य कैलेस्यु तनौ ढुदुऊ? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />यदि ङा बालजिबुलङन भूतयाङ धपाहङरकन, जे ज़ायाङै काङ्काङन रापलिइवाङ वन? नैताइस्यु नकाङ जै जेमि नियादिस ताइन्यालेया। <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />तर यदि ङा परमेस्वरलं आत्माङन भूतयाङ धपाहङ कन परमेस्वरलं राज्य जेल्योङ रा:स्युईलेया। <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />हादेए “बलल्या रुजन मापोअस्यु नकाल झिम भितरलं पसिस्यु काङ्काले नकाल धनसम्पत लाङस्यु हिनौ आढुदुऊ?” ना बलल्या रुजन पोकौकन याएज नकाल झिम लुटिऊ ढुदुवा। <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />“जो ङा सकाए माले नका ङा बिरोदल लेया, ओटन जोले ङा सकाए मादुकौ नकाले सेरासेट्ट जाएवा।<note caller="-" style="x"><char style="xo" closed="false">12:30 </char><char style="xt" closed="false"><ref loc="MRK 9:40">मर्कुस ९:४०</ref></char></note> <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />नैताइस्यु ङा जेजन पानस्याच्या, रुयाङै राढान्या सोगल पाप सनर ईस्वर-निन्दा छेमा ताहा, तर पबित्र आत्माल बिरोदत ढासिन्या निन्दा छेमा ताइन्यामाल्दी। <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />काङ्काङै रुल ज़ाल बिरोदल कोबाअ पान्दा भन्या नकाजन छेमा ताहा, तर काङ्काङै पबित्र आत्माल बिरोदत छ्योङरकन नकाङजन ईका जिबनल सनर रांन्या जिबनल बै छेमा ताइन्यामाल्दी।<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">लूका १२:१०</ref></char></note><verse eid="MAT 12:32" /></para>
  <para style="s">टुङ सनर शई</para>
  <para style="r">
    <ref loc="LUK 6:43-45">लूका ६:४३-४५</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“कि टुङजन चान्या जाएचिते, ओटन नकाल शई चान्याई ताहा। कि टुङजन माचान्या जाएच्योकन शई बै माचान्याई ताहा। दानाङभन्या शईङन जै टुङ शईसिया।<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="MAT 7:20">मत्ती ७:२०</ref>; <ref loc="LUK 6:44">लूका ६:४४</ref></char></note> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />ऐ डाङल पुङयाङ! जे जेईज घुर्बी लेच्या, ओटन कढाई चान्या छेन छ्योङौ ढुदुच्यो? दानाङभन्या यिङ भितरलं लेन्या छेनयाङ जै याह्‌लन पलिइरा।<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्ती ३:७</ref>; <ref loc="MAT 23:33">२३:३३</ref>; <ref loc="LUK 3:7">लूका ३:७</ref>; <ref loc="MAT 15:18">मत्ती १५:१८</ref>; <ref loc="LUK 6:45">लूका ६:४५</ref></char></note> <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />चान्या रुले आभितरल लेन्या चान्या जन्तुलन चान्याई पलिइवा, तर घुर्बी रुले आल्योङ लेन्या कपटङन्जै कपट जन्तुजै पलिइवा। <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />ङा जेजन ऐढाच्या, जो रुयाङै बेकारला छेन छ्योङर, नियाल छिम्क नकाङै नकाल लेखा यांन्याताहा। <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />दानाङभन्या जे बचनले जे निर्दोस ठहरिन्या लेच्या, ओटन जे बचनले जे दोसी ठहरिन्या लेच्या।”<verse eid="MAT 12:37" /></para>
  <para style="s">योना चिन्न</para>
  <para style="r">
    <ref loc="MRK 8:11-12">मर्कुस ८:११-१२</ref>; <ref loc="LUK 11:29-32">लूका ११:२९-३२</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />तब शास्त्रीयाङ सनर फरिसीयाङ मध्य काङ्का-काङ्काङै येशुजन ऐराढोव, “गुरुज्यू, गे नङ्ङन तोलोअ चिन्न ब्याएन्या गेलेयिउ।”<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">मत्ती १६:१</ref>; <ref loc="MRK 8:11">मर्कुस ८:११</ref>; <ref loc="LUK 11:16">लूका ११:१६</ref></char></note><verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />येशुले नकाङजन जबाक आयोवाङ, “ईका जुगला पुस्ताङ ख्वाए दुस्ट सनर ब्यबिचारी लेवाङ, ओले ऐलेऊ जे ङासं चिन्न नीच्या। माङडी जेजन अगमबक्ता योनाल चिन्न याएज यांन्यालेसिया।<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">मत्ती १६:४</ref>; <ref loc="MRK 8:12">मर्कुस ८:१२</ref></char></note> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />दानाङभन्या जोमनलेस्यु योना घिन्या ङा:स्याल भन्दिउल तिन दिन सनर तिन रिउ लिज्याऔ, नैलेस्यु जै रुल ज़ा बै पिरथ्बील गर्भल तिन दिन सनर तिन रिउ लिज्याया।<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="JHN 1:17">यहुन्ना १:१७</ref></char></note> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />निनबेला रुयाङ परमेस्वरलं नियाल दिन छिम्क ईका पुस्ता सकाए च्याङन्या लेरा, ओटन आकाङजन दोसी ठहराइन्या लेरा, दानाङभन्या नकाङै योनाल प्रचारत पस्चाताप रांढोव, तर खिम्चिते, योनातन घिन्या आल तोलोअ लेया।<note caller="-" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JHN 3:5">यहुन्ना ३:५</ref> </char></note> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />नियाल दिन छिम्क दच्छिनला माहारयनी आका पुस्तासं च्याङन्या लेया, ओटन इकाजन दोसी ठहऱ्याइन्या लेया, दानाङभन्या रय सोलोमनल बुद्दिला छेन थटौ नाल्ट ओ पिरथ्बील हुङन्ता वङ्ङन रा:स्यु लेऊ। तर खिम्चिते, रय सोलोमनतन घिन्या आल तोलोअ लेया।<note caller="-" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">१राजा १०:१-१०</ref>; <ref loc="2CH 9:1-12">२इतिहास ९:१-१२</ref></char></note><verse eid="MAT 12:42" /></para>
  <para style="s">दुस्टआत्मा आवलन्या</para>
  <para style="r">
    <ref loc="LUK 11:24-26">लूका ११:२४-२६</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“जब अशुद्दआत्मा रुतन पलिईस्यु हिन, तब नानसिङा लेस्यु फोएन्या पो रोंकौयन डुलिस्यु बारिया, तर नकाले काङै माडोटौदी। <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />तब नकाले ऐलेया, ‘जोङन ङा पलिईस्यु ङारांङु, ङा ओइ झिमल वलस्यु हिन्ङा।’ ना वलस्यु आरांऔक नाले झिम ढाङ्गिल सनर सिइस्यु सजाईसिन्या डोएवा। <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />तब ना हिना ओटन ओलतन अझै साट वटा दुस्टआत्मा ओलसं होनौरा, ओटन भितरलं पसिस्यु नकाङ ओलै बाई चुङरा, ओटन नका रुल छिन्टा दशा हाकातन झनभ्याई माचान्या ताहा। ईका दुस्ट पुस्ताजन बै नैजै ताइन्यालेया।”<verse eid="MAT 12:45" /></para>
  <para style="s">येशुल आअमा सनर आभाईयाङ</para>
  <para style="r">
    <ref loc="MRK 3:31-35">मर्कुस ३:३१-३५</ref>; <ref loc="LUK 8:19-21">लूका ८:१९-२१</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />येशु रुयाङस आछ्योङज्याऔक, आअमा सनर आभाईयाङ पाखाल च्याङज्यास्यु, तोलोअजन छ्योङया लेस्यु थाई रांपरिङौ। <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />तब तोलोअले येशुजन ऐआढोव, “खिम्ते, नाअमा सनर नभाईयाङ पाखाल च्याङज्यारा, ओटन नङसं छ्योङौ रोअज्यावाङ।” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />तर ओलसं छ्योङन्याजन येशुले ऐआढोव, “ङाअमा काङ्का हो? ङा भाईयाङ काङ्काङ हो?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />तब आ सिइयाङ ल्यौदेए आकुईसै पएस्यु येशुले ऐआढोव, “खिम्ते ङाअमा सनर ङा भाईयाङ। <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />दानाङभन्या जोजोले स्वर्गल लिज्यान्या ङा बौल इच्छ्या पालन ढोर, नकाङ ज्या ङा भाई बैनाङ ओटन ङाअमाङ।”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">धूर वाइन्याल आहान</para>
  <para style="r">
    <ref loc="MRK 4:1-12">मर्कुस ४:१-१२</ref>; <ref loc="LUK 8:4-10">लूका ८:४-१०</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />येशु ओछिम्कै झिमलन पलिईस्यु दहल वङल सिक्छ्या यांऔ तअसिऊ। <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />ओटन आवाए घिन्या रुयाङ हुल येशुल नेरा रांवाङ, कि ओल डोङ्गाल वूमस्यु चुङौ, ओटन भ्याई रुयाङ दहल वङल च्याङवाङ।<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">लूका ५:१-३</ref></char></note> <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />ओले नकाङजन तबर आहानङन आपानस्योवाङ। ओले ऐआढोवाङ, “तयोअ धूर वाइन्या रु धूर वाइङा लेस्यु हिनौ। <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />ओटन धूर आवाहौक काङ्का यमदेए परिवाङ, ओटन बायाङ रा:स्यु रांज्योव। <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />काङ्का धूर चम लेन्या पोल परिवाङ, जोल व्मल ज़िङ भ्या मालस्यु छिटै परिइवाङ। <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />तर जब घाम रा:स्यु चर्किऊ तब नकाङ वोईलिवाङ, ओटन रारिंन आमाफैलिउकाले राङवाङ। <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />काङ्का धूरयाङ ज़ुयाङ खार्ल परिवाङ, ओटन ज़ुयाङ बदिस्यु ओटन नकाङजन राछ्याप्वाङ। <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />काङ्का धूर चान्या येङल परिवाङ, ओटन काङ्काङ सय, काङ्काङ साठी, काङ्काङ तिस गुना शई रांयोव।”<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />ओटन येशुले ऐलेऊ, “जोलं ना: ले, नकाले ग्याठटौत्या।”<verse eid="MAT 13:9" /></para>
  <para style="s">आहानले पानौ आरोअन्या</para>
  <para style="r">
    <ref loc="MRK 4:10-12">मर्कुस ४:१०-१२</ref>; <ref loc="LUK 8:9-10">लूका ८:९-१०</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />ओटन सिइयाङ रा:स्यु येशुजन ऐरादोव “नङ दानाङ नकाङसं आहानङन छ्योङन?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />येशुले नकाङजन जबाक आयोवाङ, “जेजनता स्वर्गल राज्यला रहस्यल ग्यान यांस्यु नाएसिया, तर नकाङजन यांस्यु माल्सिदी।” <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />दानाङभन्या जोश ले, नकाजन अझै यांसिया, अझै खाटखाट ताइन्यालेया। तर जोश माले, नकाल लेन्या बै नाल्योङन न्हानन्यालेसिया। <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />नैताइस्यु नकाङसं ङा आहानङन छ्योङ्ङा, “दानाङभन्या नकाङ ब्याएन्या ता ऐब्याएरा, तर मारङरदी, थएन्या ता ऐथएरा, तर थएस्यु माबुझिरदी।” <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />यशैयाल अगमबानी नकाङल्योङन पुरा ताइस्यु लेया, “थएन्या ता जे ऐथएच्या, तर खकै माबुजिचिदी, ब्याएन्या ता ऐब्याएच्या, तर खकै मारङचिदी।<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यशैया ६:९-१०</ref></char></note> <verse eid="MAT 13:14" /><verse number="15" style="v" sid="MAT 13:15" />दानाङभन्या ईका रुयाङै यिङ अल्सि ताइस्यु लेया, ओटन नकाङल ना भैरा ताइस्यु लेया, ओटन नकाङ म्युउ बन्द ताइस्यु लेया, मानकन्ता नकाङै रङदुरा होला, नाले ठएदुरा होला, रायिङले बुझिदुरा होला, सनर वल्दुराहोला, ओटन ङा नकाङजन सबेल्दुङरा होला। <verse eid="MAT 13:15" /><verse number="16" style="v" sid="MAT 13:16" />तर बअचान्या जे म्युउ हो, दानाङभन्या नकाने रङन्या। ओटन जे नानेले थएन्या।<note caller="-" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="LUK 10:23">लूका १०:२३</ref> </char></note> <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />ङा जेजन मछ्यु ऐढाच्या, जे जेरङन्या छेन भ्याई अगमबक्ताङै सनर धर्मिजनयाङै खिमन्या भ्याई यिङ रांढोव, तर मारङदुरा, ओटन जे थएन्या छेन भ्याई थएन्या यिङ रांढोव, तर माथएदुरा।<verse eid="MAT 13:17" /></para>
  <para style="s">धूर वाइन्या आहानल अर्थ आपानस्यान्या</para>
  <para style="r">
    <ref loc="MRK 4:13-20">मर्कुस ४:१३-२०</ref>; <ref loc="LUK 8:11-15">लूका ८:११-१५</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“धूर वाइन्या आहानल अर्थ थएचिते। <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />जब रुयाङै स्वर्ग राज्यला बचन थएर, तब दुस्टआत्मा रा:स्यु रायिङल वाइसिन्या धूर न्हानस्यु लाङवा ओटन नकाङ माबुजिरदी। यमदेए परिन्या धूरयाङ नकाङ ज्या। <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />चम लेन्या येङल वाइसिन्या धूर नाइ ज्या, जोले बचन आथटौ चोएटै हेसाङस्यु ओबजाक्कै आयिङले सुइकार ढोवा। <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />तर नकाले आरिंन आमालाहौकाले ना तचिइठक्क याएज तन्वा, ओटन बचनल कारनले दुख अथाबा सटावट आरांऔ चोएटै ना छिनदेए हाएसिया। <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />ज़ुयाङ खार्ल वाइसिन्या धूर नकाई ज्या, जोयाङै रांजिबनल बचन थएरा, तर ईका सङ्सारलं आतिइ सनर धन-सम्पतल छलले बचनजन बाढा योंवा, ओटन नकाङ माशईरदी। <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />तर चान्या येङल वाइसिन्या धूर नकाई ज्या, जोले बचन थएस्यु बुजिवा, ओटन मछ्युजै शई शशैवा। नकाले आवाइन्या धूरतन सय गुना, साठी गुना, तिस गुना शशैवा।”<verse eid="MAT 13:23" /></para>
  <para style="s">साम्बाअल आहान</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />येशुले फरि नकाङजन छुट्टै आहान आसथएवाङ, “स्वर्गल राज्य तोलोअ रुमन ताइन्या हो, जोले चान्या खेएल धूर आवाहौ।” <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />तर सोगल रुयाङ रारुउज्याऔक ओलं आशत्तुर रांऔ, ओटन पलीमाल आखार-खार्ल साम्बाअल धूर वाइस्यु हिनौ। <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />जब पलीमाल बिरवा परिइस्यु घिस्यु सहौ तअसिऊ, तब साम्बाअल टुङ बै रंनौ तअसिऊ। <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />“नका साहूल आनोक्करयाङ रा:स्यु ओलजन ऐराढोव, ‘औ सायब, नैति नङ नखेएल चान्या धूर नवाइनु माङडी का?’ नल साम्बाअ काङन रांऔ?” <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />नका झिमला साहूले नकाङजन ऐआढोवाङ, “काङ्का शत्तुरले नैआजाटौ। नोक्करयाङै ओलजन ऐराढोव, ‘गे हिनस्यु नका साम्बाअयाङ’ भोअया?” <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />“तर नकाले आढोवाङ, ‘नै तालेच्यो, मानकन्ता जे साम्बाअ जेभोकौक पलीमा समेत ऐभोअच्यो।’ <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />अन दुकौ बेला समन नेंलोअझन्जै तचोएकै घिऊ योंचिते। अन दुकौ बेला खानन्याङजन ङा ऐलेस्यु थाकङरा, ‘हादेए साम्बाअ भोअस्यु मील हिपौ नाल्ट मुठा पोअचिते, तर पलीमाजन ङा धन्सारल नाएचिते’।”<verse eid="MAT 13:30" /></para>
  <para style="s">काथ्याल धूरल आहान</para>
  <para style="r">
    <ref loc="MRK 4:30-34">मर्कुस ४:३०-३४</ref>; <ref loc="LUK 13:18-21">लूका १३:१८-२१</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />येशुले नकाङजन छुट्टै आहानङन आपानस्योवाङ, “स्वर्गला राज्य काथ्याल जाए मनताइन्या हो, जो तोलोअ रुले लाङस्यु आयेङल आवाहौ। <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />ना सोगल धूरयाङतन इङन्या ताहा, तर जब नका बदिना, तब नका सोगलै ङनयाङतन घिन्या टुङ ताहा। ओटन नमत भुरन्या बायाङ रा:स्यु नकाल हाङ्गात रा:सिप जाएरा।” <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />येशुले रुयाङ हुलजन आहानङन आपानस्योवाङ, “स्वर्गल राज्य सोडा मनताइन्या हो, तोलोअ काङ्का मेएमाले तिस किलोग्राम मढमल भामवा, ओटन ना सोगल सोडाले फुल्लिस्यु ठिक्कै आमाटाहौ समन नाजन तपोईल आनाटौ।” <verse eid="MAT 13:33" /><verse number="34" style="v" sid="MAT 13:34" />येशुले ईका सोगल छेन रुयाङजन आहानङन आपानस्योवाङ। बिना आहान ओले नकाङजन नैज बै मापानस्योदुऊरा। <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />अगमबक्ताङ्ङन पान्सिन्या बचन ऐलेस्यु पुरा ताहौ “ङा ङायाह्‌ले आहानङन छ्योङ्ङा, सङ्सारला उत्पटीतन मोअस्यु नाएसिन्या छेन ङा पानन्या लेङा।”<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">भजनसङ्ग्रह ७८:२</ref> </char></note><verse eid="MAT 13:35" /></para>
  <para style="s">येशुले साम्बाअल आहानल अर्थ आपानन्या</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />तब येशुले रुयाङ हुलजन बनाएस्यु झिम भितरलं हिनौ, ओटन सिइयाङ आल्योङ रा:स्यु ऐराढोव, “खेएला साम्बाअल बारेल नपानन्या आहानल अर्थ गेजन पानस्यासिन्ते।”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />येशुले नकाङजन जबाक आयोवाङ, “चान्या धूर वाइन्या रुल ज़ा हो। <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />खेए सङ्सार हो। चान्यावाला धूर राज्यल सन्तान हो, ओटन साम्बाअ दुस्टआत्मालं ज़ा हो।” <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />ओटन साम्बाअ लाइन्या शत्तुर दियाबलस हो। अनल समायकने जुगल अन्त हो। अन दुउन्याङ स्वर्गदुतयाङ हो। <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />“जोमनलेस्यु साम्बाअ भोअस्यु मीले भसम जाएसि, जुगल आसापट नैज ताइन्या लेया। <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />नकाछिम्क रुल ज़ाले आस्वर्गदुतयाङ परिङन्या लेया, ओटन पाप ढाऔ परिङन्या रु सनर दुस्ट काम ढान्या ईका राज्यभरिला सोगलै रुयाङजन दुउन्या लेरा, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />ओटन ओयाङजन मील भुबराल क्याइन्यालेरा। नल रुयाङ व्‌रन्यालेरा ओटन रांह्वाजिङ कैन्यालेरा। <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />तब धर्मि रुयाङ रांबौल राज्यला नमिउमन चम्किन्यालेरा, जोल नां ले, ओले ग्याथटौत्या।<verse eid="MAT 13:43" /></para>
  <para style="s">री:नसिन्या धनल आहान</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“स्वर्गला राज्य तोलोअ खेएल मोअसिन्या धनमन ताइन्या हो, जो तोलोअ रुले ओलसं लेन्या सोगलै यएस्यु, तपाला नका खेए लङवा ओटन आनन्दै ताइस्यु हिना।<verse eid="MAT 13:44" /></para>
  <para style="s">मोटील आहान</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“फरि स्वर्गला राज्य चान्या मोटीयाङ रोअन्या तोलोअ बैपारीमन ताइन्या ज्या। <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />नकाले तोलोअ बअकरन्या मोटी डोएवापाइना हिनस्यु आल्योङ लिज्यान्या सोगल जन्तु यएस्यु नका मोटी आलङौ।<verse eid="MAT 13:46" /></para>
  <para style="s">जालल आहान</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“स्वर्गला राज्य तोलोअ जाल मनताइन्या हो, जो रुयाङै रहल होर्रा ओटन तबर खाल्ला ङा:स्याङ परिरा।<note caller="-" style="x"><char style="xo" closed="false">13:47 </char><char style="xt" closed="false"><ref loc="JHN 4:44">यहुन्ना ४:४४</ref></char></note> <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />ओटन जालल ङा:स्याङ फाङ ताहापाइनाई रुयाङै नकाजन आवङल सेलस्यु हाएरा, ओटन चुङस्यु चान्या चान्याभरिजन जायाङल छेल्स्यु दुउरा, ओटन माचान्याङजन बाहेर देए क्याइरा। <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />जुगल आसापट नैज ताइन्यालेया, स्वर्गदुतयाङै रा:स्यु घुर्बीयाङजन धर्मियाङ खार्लन छेल्स्यु क्याइन्यालेरा, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />ओटन नकाङजन मील भुबराल क्याइन्यालेरा। ओलं रुयाङ व्‌रन्यालेरा ओटन रांह्वाजिङ कैन्यालेरा।”<verse eid="MAT 13:50" /></para>
  <para style="s">छार सनर पुरानो सत्य</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />येशुले सिइयाङजन आगिन्वाङ, “नैति जे ईका सोगलै छेन जेबुजिदुचिऊ?” नकाङै ओलजन जबाक रांयोव, “बुजिदुया।” <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />तब येशुले नकाङजन ऐआढोवाङ, “नैताइस्यु स्वर्गला राज्यल सिक्छ्या डोएन्या सोगलै शास्त्री तोलोअ झिमला खसममन ताइन्या हो, जोले आमि धन्सारलन छार सनर पुरानो बअकरन्या समानयाङ पाखाल पलिइवा।”<verse eid="MAT 13:52" /></para>
  <para style="s">नासरतलं येशुजन रामाकोनन्या</para>
  <para style="r">
    <ref loc="MRK 6:1-6">मर्कुस ६:१-६</ref>; <ref loc="LUK 4:16-30">लूका ४:१६-३०</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />ईका आहानयाङ ह्युउस्यु खेम्वापाइना येशु नलन हिनौ। <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />ओटन येशु आमिई सहरल रा:स्यु नकाङल आराधना झिमल नकाङजन ऐटाइन्या सिक्छ्या आयोवाङ, कि नकाङ अचम्म ताइस्यु नकाङै ऐलेवाङ, “इकाजन ऐटाइन्या बुद्दि सनर अचम्मला काम ढान्या सक्तियाङ काङन आडोटौ? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />नैति ईका सिकर्मील ज़ा माङडी का? नैति आकाल आअमाल मिन मरियम, ओटन आभाईयाङ याकूब, योसेफ, सिमोन सनर यहूदा माङडीका? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />नैति इकाल दिदीबैनाङ सोगल गेसकाएज मालज्यावाङ का? फरि आकाले ईका सोगल काङन आडोटौ ऐलेस्यु?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />येशुसं नकाङ रारिऊ उठिऊ। ओटन ओले नकाङजन ऐआढोवाङ, “अगमबक्ताजन आमिईज देसलं सनर आझिमल बाहेक अपुर सोगलै पोल आदर ढोरा।” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />ओटन नकाङल अबिस्वासले गर्दा येशुले नल सक्तिला कामयाङ तबर माढोदा।<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">बप्तिस्मा यांन्या यहुन्नाल सिइकाल</para>
  <para style="r">
    <ref loc="MRK 6:14-29">मर्कुस ६:१४-२९</ref>; <ref loc="LUK 9:7-9">लूका ९:७-९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />नवाए बेला गालील प्रदेसला शासक हेरोदले येशुल बाए आथटौ। <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />नाले आमि नोक्करयाङजन ऐआढोवाङ, “नका बप्तिस्मा यांन्या यहुन्ना ज्या। नका सिस्यु जिङदा ताइस्यु लेया। नैताइस्यु सक्तिला ईका कामयाङ ओलङन ताइज्याऔ।” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />दानाङभन्या हेरोदले आभाई, फिलिपल मेएमा हेरोदियासल कारनले यहुन्नाजन कोलोअस्यु पोअस्यु झ्यालखानाल झोअस्यु आनाटौ।<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">लूका ३:१९-२०</ref>; <ref loc="MAT 4:12">मत्ती ४:१२</ref></char></note> <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />यहुन्नाले हेरोदजन ऐढास्यु आनाटौ, “ब्यबस्थालं अनुसार नकाजन नङ नमेएमामन जाएस्यु नाएन्या ठिक माल्दी।”<note caller="-" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">लेवी १८:१६</ref>; <ref loc="LEV 20:21">२०:२१</ref></char></note> <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />ऐआढाऔकाले हेरोदले ओलजन सएन्या यिङ आढोव, तर रुयाङ रङस्यु नका छ्याटौ, दानाङभन्या नकाङै येशुजन अगमबक्ता मानिज्यावाङ। <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />तर जब हेरोदल आजर्मिन्या दिन रांऔ, तब हेरोदियासल मेएमाज़ाले नकाङ खार्ल स्यास्यु हेरोदजन भ्याई खुशी आजाटौ। <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />नैताइस्यु हेरोदले नाजन जो जन्तु नीकन बै यांन्या बाचा आढोव। <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />तर नकाले आअमाले आह्युउन्या अनुसार ऐआढोव, “बप्तिस्मा यांन्या यहुन्नाल ङए ङाजन ईका थालल यांङते।” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />ओटन रय आतिज्याकन बै आमि बाचा अनुसार पाहुनाङल नाल्ट नकाले सिपाइयाङजन नैताइन्याई ढान्या हुकुम आयोवाङ, <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />ओटन जब हेरोदले सिपाइयाङजन झ्यालखानाल हिनस्यु यहुन्नाल ङए पलस्यु होन्चिते ऐलेस्यु आपरिङवाङ। <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />तब नकाल ङए थालल होनस्यु नका मेएमालुलजन रांयोव, ओटन नकाले ना आअमाजन आयोव। <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />ओलं छिन्ट यहुन्नाल सिइयाङ रा:स्यु नकाल सिन्या बुल लाङस्यु री:ननिइस्यु, हिन्वाङ ओटन नकाङै येशुजन थाई रांयोव।<verse eid="MAT 14:12" /></para>
  <para style="s">येशुले पास हजार रुयाङजन आयांइवाङ</para>
  <para style="r">
    <ref loc="MRK 6:30-44">मर्कुस ६:३०-४४</ref>; <ref loc="LUK 9:10-14">लूका ९:१०-१४</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />जब येशुले ईका आठटौ ओल डोङ्गा चरिस्यु नङंन अलक्कै बाठएका पोल हिनौ। आका थएस्यु रुल हुल सहरलन पाइदल जै ओलजन रापछ्याहौ। <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />येशु आवङल तापापाइना नका घिन्या रुयाङल हुलजन रङस्यु भ्याई यीङताए आमानिवाङ, ओटन नकाङल नाएबोरन्याङजन आसबेल्वाङ। <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />ओइ ताहापाइनाई येशुल सिइयाङ आल्योङ रा:स्यु ऐराढोव, “आका पोल काङ्काई रु माल्दी नमझ्याङा लेदा। आकाङजन बिदा योंवरते, ओटन इकाङै नङ्गरल हिनस्यु रांनाल्ट ज्यान्या जन्तु ग्यालङरत्या।” <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />तर येशुले नकाङजन ऐआढोवाङ, “नकाङ हिनन्या आबस्यक माल्दी। जे जै इकाङजन ज्याऔ योंचिरते।” <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />नकाङै येशुजन ऐराढोव, “इल गेसकाए पास पाटा भरेई सनर नेंलोअ ङा:स्या जाई लिज्याया।”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />तब येशुले ऐलेऊ, “नका सोगल ङाल्योङ होन्चिते।” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />ओटन येशुले रुयाङजन छील चुङन्या हकुम आयोवाङ, ओटन नका पास पाटा भरेई सनर नेंलोअ ङा:स्या छेन्स्यु नमदेए खिमस्यु परमेस्वरजन धन्याबाद आयोव, ओटन भरेईजन कलाएस्यु सिइयाङजन आयोवाङ, ओटन सिइयाङै रुयाङजन रांयोवाङ। <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />नकाङ सोगलैले ज्यास्यु पटिपन्न ताइवाङ, ओटन सिइयाङै येलन्या बारं घोनफाङ रादुकौ। <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />मेएमाङ सनर लुलयाङ बाहेक ज्यान्याङ याएज जम्मा पास हजार ल्हेपाङ लेवाङ।<verse eid="MAT 14:21" /></para>
  <para style="s">येशु रीयर्त आबान्या</para>
  <para style="r">
    <ref loc="MRK 6:45-56">मर्कुस ६:४५-५६</ref>; <ref loc="JHN 6:15-21">यहुन्ना ६:१५-२१</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />येशुले यांहौरा पाइना सिइयाङजन डोङ्गाल चराइस्यु दहल हुदिफन्ट छिटो हिन्चिते लेस्यु आपरिङवाङ, ओटन ओवाए बेलाई रुयाङजन बिदा आयोवाङ। <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />रुयाङजन बिदा योंवरा पाइना प्रार्थना ढाऔ नाल्ट डान्डात वूमौ। ओटन ओइ आताहौक ओल नङं आबाठए लिज्याऔ। <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />तर डोङ्गा नकाए बेला समन दहल वङतन भ्याई लोए हिनस्यु लेऊ। ओटन उलत्या आन्ढी आढाऔकाले डोङ्गा रील छालले हल्याङहल्याङ लिज्याऔ। <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />छकाल्या तिन बजेकन छ बजेदेए येशु दहला रीयर्त बास्युकने सिइयाङल्योङ रांऔ। <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />जब सिइयाङै येशुजन दहला रीयर्त आबाज्यान्या रांरङौ, तब छ्याएस्यु ऐलेवाङ, “इकाता भूत दी कान्देए!” ऐलेस्यु नकाङ राछ्याहै चिचच्याइवाङ। <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />तर येशुले ओचोएटै नकाङजन ऐआढोवाङ, “ताआतिच्यो हिम्मत ढोचिते, ङा दी ताछ्याएच्यो।” <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />पत्रुसले येशुजन ऐआढोव, “औ प्रभु, मछ्यु नङजै ताहनकन, ङाजन नल्योङ री यर्त बास्यु रांन्या आग्या यांङते।” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />येशुले ऐआढोव, “रांन्ते” पत्रुस डोङ्गातन लांइस्यु तब पत्रुस येशु ल्योङ हिनौ नाल्ट री यर्त बाऔ तअसिऊ। <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />तर आन्ढी जोरसै आढाज्यान्या सनस्यु छ्याटौ, ओटन जब रीले डुबिङाई लेयापाइना नाले चिचच्याइस्यु ऐलेऊ, “औ प्रभु ङाजन बचाहङते।”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />तब येशुले ओचोएटै आकुई पारिस्यु नाजन आकोलोकौ, ओटन नकाजन आढोव “ऐ अल्पबिस्वासी<note caller="+" style="f"><char style="fr" closed="false">14:31 </char><char style="ft" closed="false">अल्पबिस्वासी=आधा बिस्वास</char></note>, दानाङ सङ्का ढोन?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />जब नकाने डोङ्गाल चुङौने तब आन्ढी थामिसिऊ। <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />डोङ्गाल लिज्यान्याङै येशुजन ढोक यांस्यु ऐराढोव, “नङ मछ्युजै परमेस्वरलं ज़ा ज्या।”<verse eid="MAT 14:33" /></para>
  <para style="s">येशुले गनेसरेतलं रुयाङजन आसबेल्वाङ</para>
  <para style="r">
    <ref loc="MRK 6:53-56">मर्कुस ६:५३-५६</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />येशु सनर आ सिइयाङ दहजन कटाइस्यु गनेसरेतला पोल ताप्‌रावाङ। <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />ओटन जब नका पोला रुयाङै येशुजन रांशहौ, तब नकाङै हुङा आङा सोगल इलाकाल थाई रांपरिङौ। ओटन सोगल नाएबोरन्या रारुयाङजन आल्योङ राहोन्वाङ। <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />नकाङै आक्वाल टुप्पा याएज छुऊ डोटैकनबै बेलौ डोएयाहोला ऐलेस्यु येशुजन बिन्ति रांढोव, ओटन ज्वाएले रांछुऊ नकाङ बेल्वाङ।<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">पुर्खाङल सिक्छ्या</para>
  <para style="r">
    <ref loc="MRK 7:1-13">मर्कुस ७:१-१३</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />जब यरुशलेमङन ख्वाएयाए शास्त्रीयाङ सनर फरिसीयाङ येशु ल्योङ रांवाङ, तब नकाङै ओलजन रांगिनौ, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“न सिइयाङै रापुर्खाङ रांमानिन्या चलन दानाङ मामानिर? नकाङै ज्याऔ हादेए राकुई माहुररंदी।”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />येशुले नकाङजन ऐआढोवाङ, “जे परमेस्वरलं आग्या पालन माढास्यु, दानाङ जे चलनत लागिज्याच्यो? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />दानाङभन्या परमेस्वरले ऐलेया, ‘जे बौ सनर जेअमाल आदर ढोचिते, ओटन जेबौ या जेअमाल बिरोदत जोले सराप छेन छ्योङ, नका पक्का सएस्युनीन्या लायकला ताहा।’<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">प्रस्थान २०:१२</ref>; <ref loc="EXO 21:17">२१:१७</ref>; <ref loc="DEU 5:16">ब्यबस्था ५:१६</ref>; <ref loc="LEV 20:9">लेवी २०:९</ref></char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />तर जे ऐलेच्या, जोले आबौ या आअमाजन ऐढोव, कि ‘झेन ङाल्योङन जो डोटौ नरोअनु, ना परमेस्वरजन चराइसिदा।’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />ओले ङा बौल आदर ढान्या माताइदी ऐलेस्यु आमि पुर्खाङल चलनले गर्दा परमेस्वरलं बचनजन बिकामला आठहऱ्याहौ। <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />ऐ, घुर्बीयाङ, यशैयाले जे बारेल सत्य भबिस्यबानी आढोव, <verse eid="MAT 15:7" /><verse number="8" style="v" sid="MAT 15:8" />‘आका रुयाङै ङाजन याह्‌ले याएजै मान नाएस्याङरा, तर नकाङल यिङ ङातन लोए लेया।<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ISA 29:13">यशैया २९:१३</ref></char></note> <verse eid="MAT 15:8" /><verse number="9" style="v" sid="MAT 15:9" />नकाङ डाङजै ङा प्रसम्सा ढाऔजाएसिरा, तर नकाङल सिक्छ्या रुयाङ राह्युउन्या बिधि याएज ज्या।’”<verse eid="MAT 15:9" /></para>
  <para style="s">नै जन्तुले रुजन अशुद्द जाटौ</para>
  <para style="r">
    <ref loc="MRK 7:14-23">मर्कुस ७:१४-२३</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />येशुले तबर रुयाङजन आलेऊदेए आखुल्वाङ ओटन नकाङजन ऐआढोवाङ, “थएचिते ओटन बुजिचिते। <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />जो रुल याह् भितरलं पसि, नकाले रुजन अशुद्द माजाटौडी। तर जो याह्‌लन बाहेर पलिह, नकाले रुजन अशुद्द जाएवा।”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />ओलं छिन्ट सिइयाङ रा:स्यु येशुजन ऐराढोव, “नैति नङजन थाह मालेच्यो? फरिसीयाङ न छेन थएस्यु रायिङचोज्याया।”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />तर येशुले आढोवाङ, “स्वर्गल लिज्यान्या ङा बौले आमालाइन्या सोगलै टुङजन भोअन्यालेसिया। <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />नकाङजन राइचिरते, दानाङभन्या नकाङ अन्ढला अगवाङ हो। अन्ढलाले अन्ढलाजन डोऱ्याइदा भन्या, नकाने नेंलोअजै खाल्टाल परिन्या।”<note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">लूका ६:३९</ref></char></note><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />पत्रुसले ओलजन ऐआढोव, “गेजन ईका आहानल अर्थ पानस्यासिन्ते।”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />येशुले ऐलेऊ, “नैति जे अझ बै जेमाबुजिचिऊ? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />रुल याह्‌लन जो भन्दिउल पसि, बुललन बाहेर देए ओइज पलिहा ऐलेस्यु जे जेमासन्चिऊ? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />तर जो छेनयाङ याह्‌लन बाहेर देए पलिइर, नकाङ यिङलन पलिइरा ओटन नकाङज रुजन अशुद्द जाएरा।<note caller="-" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">मत्ती १२:३४</ref></char></note> <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />दानाङभन्या रुयाङल यिङलन जै सुइटैन्या, हत्या, मेएमा फिरिन्या<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="ft" closed="false">ब्याहा ढाऔ हादेए</char></note>, ब्यबिचार, कुन्या, ग्वारवा साची सनर बाएयाङ बाहेर देए पलिइरा। <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />ऐटाइन्या छेनले रुजन अशुद्द जाएवा। तर कुई माहुरस्यु ज्याऔकाले ओलजन अशुद्द माजाटौडी।”<verse eid="MAT 15:20" /></para>
  <para style="s">कनानी मेएमाल बिस्वास</para>
  <para style="r">
    <ref loc="MRK 7:24-30">मर्कुस ७:२४-३०</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />तब येशु नलन पलिईस्यु टुरोस सनर सीदोनला इलाकादेए हिनौ। <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />नका इलाकालन तोलोअ कनानी मेएमा रा:स्यु कलिऊस्यु ऐलेऊ, “औ प्रभु, दाऊदल ज़ा, ङाजन दया ढाङते। ङाज़ाजन दुस्टआत्माले भ्याई दुख यांज्याऔ।” <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />येशुले नकाजन नैज जबाक मायोदा। आ सिइयाङ रा:स्यु ओलजन बिन्ति रांढोव, “इकाजन परिङते, दानाङभन्या नका व्‌रस्युव्‌रस्यु गेछिनछिन रांज्याया।”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />येशुले ऐआढोवाङ, “ङाजन इस्राएलला मांन्या भेडाङलं नाल्ट परिङसिऊ हो।” <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />तर नका मेएमा रा:स्यु आहाक घुन्डा टिकिस्यु ऐआढोव, “औ प्रभु, ङाजन व्टङते।”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />येशुले ऐलेऊ, “लुलल्याङल भरेई होनस्यु कांयाङजन क्याइस्यान्या ठिक माल्दी।” <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />नका गैरयहूदी मेएमाले ऐलेऊ, “औ प्रभु, तर कांयाङ बै ता रांखसमलं देस्कतन तेइन्या भरेईल चोइलाङ कैरा सा।”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />तब येशुले नकाजन जबाक आयोव, “ऐ स्त्री, न बिस्वास घिन्या लेऊरैस। नङ इच्छ्या नढान्या मन्जै ग्याताइत्या।” नकाल मेएमा आज़ा नवाए बेलाई बेल्दा।<verse eid="MAT 15:28" /></para>
  <para style="s">येशुले तबर रुयाङजन आसबेल्वाङ</para>
  <para style="r">
    <ref loc="MRK 8:1-10">मर्कुस ८:१-१०</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />येशु नलन पलिईस्यु गालील दहल आवङवङ ताइस्यु हिनौ, ओटन डान्डाल वूमस्यु ओलै चुङौ। <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />तब बअ-बअघिन्या रुयाङल हुल आल्योङ रांवाङ, ओटन नकाङै राहोनन्या दुन्डा, लुला, अन्ढला, लाटा सनर अपुर तबरजन आवङल रानाएवाङ, ओटन येशुले नकाङजन आसबेल्वाङ। <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />आवाए समन कि, लाताङ छ्योङवाङ, लुलाङ बेल्वाङ, दुन्डाङ बावाङ, ओटन अन्ढलाङल म्युउयाङ आफएसिन्या, रङस्यु रुयाङ छक्कै परिवाङ, ओटन नकाङै इस्राएलला परमेस्वरलं महिमा रांढोव।<verse eid="MAT 15:31" /></para>
  <para style="s">येशुले छुट्टै घिन्या रुयाङ हुलजन आयांइन्या</para>
  <para style="r">
    <ref loc="MRK 8:1-10">मर्कुस ८:१-१०</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />तब येशुले आ सिइयाङजन आल्योङ खुल्सिऊ ऐआढोवाङ, “ङा ईका रुयाङजन यीङताए मानिङरा दानाङभन्या इकाङ ङासकाए रालज्यान्या तिन दिन ताइदा ओटन इकाङ सकाए ज्यान्या नैज माल्दी। इकाङजन करेटै परिङन्या ङा मापरिङ्ङरदी। मानकन्ता इकाङ यमलै बिहोस ताइरा।” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />ओलजन आसिइयाङै ऐराढोव, “आवाए घिन्या रुयाङ हुलजन यांऔ नाल्ट ईका नैजमालन्या पोल नवाए धरअसा भरेई गे काङन होनै?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />येशुले नकाङजन ऐआढोवाङ, “जेसकाए ख्वाए गोटा भरेई लेऊ?” नकाङै ऐलेवाङ, साट पाटा भरेई सनर इङइङन्या ङा:स्या।<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />येशुले रुयाङ हुलजन नामल चुङन्या आग्या आयोवाङ। <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />ओले नका साट पाटा भरेई सनर ङा:स्या होनस्यु परमेस्वरजन धन्याबाद योंवापाइना कलाएस्यु आ सिइयाङजन आयोवाङ, ओटन आसिइयाङै रुयाङजन रांयोवाङ। <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />नकाङ सोगलैले कैस्यु वाङवाङ। ओटन येलन्या चोइलाङ नकाङै साट घोन रादुकौ। <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />मेएमाङ सनर लुलल्याङ बाहेक कैन्याङ चार हजार ल्हेपाङ लेवाङ। <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />जब रुयाङ हुलजन यांहौरा पाइना बिदा आयोवाङ, तब ओल डोङ्गात चरिस्यु मगादानलं इलाकादेए हिनौ।<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">चिन्न सनर अचम्मला काम ढास्यु थन्ते राढान्या</para>
  <para style="r">
    <ref loc="MRK 8:11-13">मर्कुस ८:११-१३</ref>; <ref loc="LUK 12:54-56">लूका १२:५४-५६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />फरिसीयाङ सनर सदुकीयाङ रांवाङ, ओटन येशुजन अल्चिऊ नाल्ट स्वर्गला तोलोअ चिन्न थनस्यासिन ऐलेस्यु नीवाङ।<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="MAT 12:38">मत्ती १२:३८</ref>; <ref loc="LUK 11:16">लूका ११:१६</ref></char></note> <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />तर ओले नकाङजन जबाक आयोवाङ, “जब ओइ ताहापाइना जे ऐलेच्या, ‘ईका मौसम सफा लेया, दानाङभन्या नम घ्यामज्याऔ।’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />छकाल्या ऐलेच्या, ‘नम घ्यामज्याया ओटन बादलले कप्स्यु नाएवा, आछिम आन्ढी रांन्यालेया।’ जे नमल अबस्था खिमस्यु लाअ कैताहौ, छुटाहौ सनच्या तर समायल चिन्नल अर्थ पानौ माढुदुचिदी। <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />येशुले नकाङजन ऐआढोवाङ, दुस्ट सनर ब्यबिचारी पुस्ताले चिन्न रोअवा, तर नकाङजन योनाल चिन्नतन अपुर नैज चिन्न मायासिदी।” ऐलेस्यु बनाएस्यु हिनौ।<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">मत्ती १२:३९</ref>; <ref loc="LUK 11:29">लूका ११:२९</ref></char></note><verse eid="MAT 16:4" /></para>
  <para style="s">सदुकीयाङ सनर फरिसीयाङ सोडा</para>
  <para style="r">
    <ref loc="MRK 8:14-21">मर्कुस ८:१४-२१</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />येशु सिइयाङ सकाए दहल हुदिफन्ट राटापौक नकाङै भरेई होनन्या राम्योकौ रैस। <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />ओटन येशुले नकाङजन ऐआढोवाङ, “ध्यान ढोच्यो, फरिसीयाङ सनर सदुकीयाङल सोडातन होसियार ताइच्यो।”<note caller="-" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">लूका १२:१</ref></char></note> <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />नकाङ रारांल छ्योङौ तअसिवाङ, “गे भरेई माहोन्दुया, नैताइस्यु ओले नैलिज्याऔ।” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />येशुले ईका सनस्यु ऐआढोवाङ, “ऐ, अल्पबिस्वासीयाङ! गेसं भरेई माल्दी ऐलेस्यु दानाङ जे जेल छ्योङज्याच्यो? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />नैति जे अझ बै जेमाबुजिचिऊ? ङा पास हजार रुयाङ नाल्ट पास गोटा भरेई ङाकलाटौक जे ख्वाए घोन जेदुउचिऊ जेजन यांका मालेऊ?<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">मत्ती १४:१७-२१</ref></char></note> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />ओटन चार हजार रुयाङल नाल्ट साट पाटा भरेई ङाकलाटौक, जे ख्वाए घोन जेदुउचिऊ?<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">मत्ती १५:३४-३८</ref></char></note> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />ङा जेसकाए भरेईल बारेल ङाछ्योङज्याङु माङडी ऐलेस्यु जे दानाङ माबुजिच्यो? जे फरिसी सनर सदुकीयाङल सोडातन होसियार ताइचिते।” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />तब नकाङै सोडावाला भरेईल बारे माङडी रैस, नका ता फरिसी सनर सदुकीयाङ सिक्छ्यातन होसियार ताइच्यो ऐलेऊदी रैस लेस्यु राबुजिऊ।<verse eid="MAT 16:12" /></para>
  <para style="s">येशुल बारेङन पत्रुसलं घोसना</para>
  <para style="r">
    <ref loc="MRK 8:27-30">मर्कुस ८:२७-३०</ref>; <ref loc="LUK 9:18-21">लूका ९:१८-२१</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />जब येशु कैसरिया फिलिप्पीला इलाकाल रायापाइना, ओले सिइयाङजन आगिन्वाङ, “रुयाङै रुल ज़ाजन काङ्का ऐढाज्यावाङ होला?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />नकाङै जबाक रांयोव, “काङ्काङै बप्तिस्मा यांन्या यहुन्ना, काङ्काङै एलिया, ओटन काङ्काङै यर्मिया या अगमबक्ताङ मध्य तोलोअ काङ्कावाला ताहौ, ऐलिज्यारा।”<note caller="-" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="MAT 14:1">मत्ती १४:१</ref>; <ref loc="MAT 2">२</ref>; <ref loc="MRK 6:14">मर्कुस ६:१४</ref>; <ref loc="MRK 15">१५</ref>; <ref loc="LUK 9:7">लूका ९:७</ref>; <ref loc="LUK 8">८</ref></char></note> <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />ओले नकाङजन आगिन्वाङ, “जे नै कैजेल्चिऊ वन, ङा काङ्का?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />सिमोन पत्रुसले जबाक आयोव, “नङ जिङदा परमेस्वरलं ज़ा ख्रीस्ट हो।”<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">यहुन्ना ६:६८-६९</ref></char></note><verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />येशुले नकाजन ऐआढोव, “यहुन्नाल ज़ा सिमोन, नङ बअचान्याई लेना। दानाङभन्या रुल स्या सनर जीङन नङजन आका थनसिन्या माङडी, तर स्वर्गल लिज्यान्या ङा बौले आथननु हो। <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />आब ङा नङजन ऐढाना, कि नङ पत्रुस ज्या। ङा ङामि मन्डली ईका चमयर्त सच्यानन्यालेङा, ओटन नरगला झलापयाङ नकातन झ्योङौ माडोएरदी। <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />ङा नङजन स्वर्गला राज्यला चाबियाङ यांन्या लेङा। जो नङ पिरथ्बील पोकनकन, ना स्वर्गल पोअन्यालेसिया, ओटन पिरथ्बील नङ जो पलाकन, ना स्वर्गल पलाअन्या लेसिया।”<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">मत्ती १८:१८</ref>; <ref loc="JHN 20:23">यहुन्ना २०:२३</ref></char></note> <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />येशुले नका ख्रीस्ट जै ज्या, ऐलेस्यु काङ्काईजन तापानस्योचिर ऐलेस्यु, आ सिइयाङजन कडा आदेस आयोवाङ।<verse eid="MAT 16:20" /></para>
  <para style="s">येशुले क्रूसतं आसिन्या बारेल भबिस्यबानी आपानन्या</para>
  <para style="r">
    <ref loc="MRK 8:31">मर्कुस ८:३१</ref>; <ref loc="MRK 9:1">९:१</ref>; <ref loc="LUK 9:22-27">लूका ९:२२-२७</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />येशु यरुशलेमल हिनस्यु, ह्युउन्या गुरयाङ, मुख्या पुजाउरोयाङ सनर शास्त्रीयाङ्ङन भ्याई दुख भुगिन्यालेङा, ओटन सएस्यु निन्यालेङा, सनर तिन दिनक जिङदा ताइस्यु सोन्यालेङा, ऐलेस्यु आ सिइयाङजन नवाए बेलाकन्ज पानस्याऔ तअसिऊ। <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />पत्रुसले येशुजन तपोईदेए लाङस्यु आहप्काहौ, “परमेस्वरले ऐ ग्यालत्या, प्रभु, नयर्त खकै ऐताटाइत्या।”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />तर वलस्यु ओले पत्रुसजन ऐआढोव, “ऐ सैतान, ङा लेऊकन ढोङन्ते, नङ ङा नाल्ट बाढा हो। दानाङभन्या नङ परमेस्वरलं छेनत माङडी, तर रुयाङल छेनत यिङ लाइना।” <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />तब येशुले आ सिइयाङजन ऐआढोवाङ, “जोले ङा छिन्ट रांन्या यिङ ढोव, नकाले ओलझन्जै तामानिऊत्या ओटन आक्रूस वुरस्यु ङाछिन्ट ग्यालागित्या।<note caller="-" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">मत्ती १०:३८</ref>; <ref loc="LUK 14:27">लूका १४:२७</ref></char></note> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />दानाङभन्या जोले आपरान जोगाहौ रोंकौ, ओले नका गवाइवा, तर जोले आपरान ङा नाल्ट गवाहौ, नकाले ना डोएन्यालेया।<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती १०:३९</ref>; <ref loc="LUK 17:33">लूका १७:३३</ref>; <ref loc="JHN 12:25">यहुन्ना १२:२५</ref></char></note> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />सोगल सङ्सार डोएस्युकने बै आपरान गवाहौकन, रुजन नैति कोबाअ फाइदा ताहौ का? अथाबा रुले आपरानल पोल नै यांऔ आढुदुऊ का? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />दानाङभन्या रुल ज़ा आबौल महिमात आमि स्वर्गदुतयाङ सकाए रांन्यालेया, ओटन नकाए बेला नाले स्वाट्टै रुयाङजन नकाङल काम अनुसार ध्यारी योंवरा।<note caller="-" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्ती २५:३१</ref>; <ref loc="PSA 62:12">भजनसङ्ग्रह ६२:१२</ref>; <ref loc="ROM 2:5">रोमी २:५</ref></char></note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />ङा जेजन मछ्यु ऐढाच्या, इल च्याङज्यान्याङ मध्य ख्वाएयाएले रुल ज़ाजन आराज्यल आरांज्यान्या रांमारङौ समन सिइकाल मादाररदी।”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">येशुल अनवार आफिरिसिन्या</para>
  <para style="r">
    <ref loc="MRK 9:2-13">मर्कुस ९:२-१३</ref>; <ref loc="LUK 9:28-36">लूका ९:२८-३६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />ओलं छ दिन छिन्ट येशुले पत्रुस, याकूब सनर नकाल आभाई यहुन्नाजन ओलसं रांबाठए तोलोअ झेनन्या डान्डात आलाङवाङ।<note caller="-" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">२पत्रूस १:१७-१८</ref>; <ref loc="MAT 3:17">मत्ती ३:१७</ref></char></note> <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />ओटन नकाङल हार्मै येशुल अनवार फिरिसिऊ ओटन आक्वा नमिउमन तरवर चम्किऊ, <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />ओटन येशु सकाए मोशा सनर एलिया नेंछ्योङज्यान्या रांरङौ। <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />पत्रुसले येशुजन ऐआढोव, “औ प्रभु, गे आल चुङन्या ठिक लेया। यदि न इच्छ्या लेकन ङा इल तिनगोटा चुङन्या छाप्रा जाएङा, तोलोअ न नाल्ट, तोलोअ मोशाल नाल्ट ओटन तोलोअ एलियाल नाल्ट।” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />नका आछ्योङज्याऔ आछ्योङज्याऔकै, पलन्या बादलले नकाङजन आकपवाङ, ओटन नका बादललन तोलोअ ग़ा थहौ, “ईका ङायिङ्का ज़ा हो, ङा इकास भ्याई ङाहेसाङ्‌ङु, इकाल छेन थएचिते।”<note caller="-" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">उत्पत्ति २२:२</ref>; <ref loc="DEU 18:15">ब्यबस्था १८:१५</ref>; <ref loc="PSA 2:7">भजनसङ्ग्रह २:७</ref>; <ref loc="ISA 42:1">यशैया ४२:१</ref>; <ref loc="MAT 3:17">मत्ती ३:१७</ref>; <ref loc="MAT 12:18">१२:१८</ref>; <ref loc="MRK 1:11">मर्कुस १:११</ref>; <ref loc="LUK 3:22">लूका ३:२२</ref> </char></note> <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />जब सिइयाङै नका ग़ा राथटौ, तब नकाङ भ्याई छ्याएस्यु नामल फलुपसिवाङ। <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />तर येशुले नकाङजन छुस्यु ऐआढोवाङ, “सोचिते, ताछ्याएच्यो।” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />जब नकाङै राम्युउ रांखिमौ, तब येशु बाहेक अपुर काङ्काईजन मारङदुरा। <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />जब ओयाङ डान्डालन लांइज्यावाङ, येशुले नकाङजन आग्या आयोवाङ, “जब समन रुल ज़ा सिन्यातन जिङदा ताइस्यु मासो, तब समन जे ईका दर्शनल छेन काङ्काईजन तापानस्योचिर।” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />ओटन आसिइयाङै येशुजन ऐलेस्यु रांगिनौ, “वन दानाङ शास्त्रीयाङै हादेए एलिया रांन्यालेया ऐलेर?”<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">मलाकी ४:५</ref></char></note><verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />येशुले नकाङजन ऐआढोवाङ, “एलिया मछ्युजै रांया ओटन नकाले फरि सोगलै छेन सुढारन्यालेया। <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />तर ङा जेजन ऐढाच्या, ‘एलिया हादेए जै रा:स्यु लेया, ओटन रुयाङै नकाजन रामाशहौ, तर नकाजन नकाङै कोबाअमन रांढोव। नैलेस्यु जै रुल ज़ाले बै नकाङल कुईतन दुख भुगिऊपरिया।’”<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">मत्ती ११:१४</ref></char></note><verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />तब ओले बप्तिस्मा यांन्या यहुन्नाल बारेल पानज्याऔ रैस ऐलेस्यु सिइयाङै राबुजिऊ।<verse eid="MAT 17:13" /></para>
  <para style="s">येशुले भूत लागिन्या केटाजन आसबेलौ</para>
  <para style="r">
    <ref loc="MRK 9:14-29">मर्कुस ९:१४-२९</ref>; <ref loc="LUK 9:37-43">लूका ९:३७-४३</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />जब येशु सनर आ सिइयाङ रुयाङ हुल लेन्या पोल ताप्‌रांरापाइना तोलोअ रुले आल्योङ रा:स्यु घुन्डा टेकिस्यु ऐलेऊ, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“औ प्रभु, ङा ज़ाजन दया ढोते, दानाङभन्या नका चरिफाई लागिस्यु बअ दुख डोएज्याऊ। नका खयाङ्क मील परिया, खयाङ्क रील बुदिया। <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />ङा नकाजन न सिइयाङल्योङ ङाहोन्ङु, तर नकाङै सबेलौ रांमाढुदुऊ।”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />तब येशुले आढोवाङ, “ऐ अल्प बिस्वासीयाङ सनर भ्रस्ट पुस्ताङ, खक समन ङा जेसकाए लिज्याङ का? ङा जेजन खक समन सहिच्यो? नकाजन अदेए ङालेऊदेए होन्चिते।” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />जब नाजन येशुल ल्योङ राहोनौ, तब नकात लेन्या भूतजन आहकारिउ ओटन नका केटातन पलिईस्यु हिनौ, ओटन नका ओचोएटै बेलौ। <verse eid="MAT 17:18" /><verse number="19" style="v" sid="MAT 17:19" />जब आसिइयाङै येशुजन आबाठएक रा:स्यु ऐराढोव, “गे दानाङ नकाजन पलिटौ माढुदुई?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />येशुले नकाङजन ऐआढोवाङ, “जेमि अबिस्वासलं कारनले हो। ङा मछ्यु जेजन ऐढाच्या, कि जेल्योङ तोलोअ काथ्याल जाए यांयन्या जे बिस्वास आलन्याताहकन आका डान्डाजन ‘आटन हटिन्ते’ ऐढोच्योकन नका हटिन्यालेया। ओटन जे नाल्ट नैज असम्भब ताइन्यामाल्दी।<note caller="-" style="x"><char style="xo" closed="false">17:20 </char><char style="xt" closed="false"><ref loc="MAT 21:21">मत्ती २१:२१</ref>; <ref loc="MRK 11:23">मर्कुस ११:२३</ref>; <ref loc="1CO 13:2">१कोरिन्थी १३:२</ref></char></note> <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />नैताइस्यु ऐटाइन्या किसिमला भूत ता प्रार्थना सनर बर्त बिना मापलिईदी।”<verse eid="MAT 17:21" /></para>
  <para style="s">येशुले आसिन्या बारेल नेंपाला आपानन्या</para>
  <para style="r">
    <ref loc="MRK 9:30-32">मर्कुस ९:३०-३२</ref>; <ref loc="LUK 9:43-45">लूका ९:४३-४५</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />येशु सनर आ सिइयाङ गालील प्रदेसलं रादुउसिऊक ओले नकाङजन ऐआढोवाङ, “रुल ज़ा रुयाङल कुईत सुम्पिन्यालेसिया। <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />ओटन नकाङै ओजन सएन्यालेरा, ओटन तिन दिन छिम्क ओ जिङदा ताइस्यु सोन्यालेया।” ओटन सिइयाङ भ्याईज दुखी ताइवाङ।<verse eid="MAT 17:23" /></para>
  <para style="s">येशु ख्रीस्टले आराधना झिमल तिरो यांन्या बारेल आह्युउन्या</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />जब येशु सनर आ सिइयाङ कफर्नहुमलं रांवाङ, आराधना झिमल तिरो उठाइन्याङै पत्रुस ल्योङ रा:स्यु ऐलेवाङ, “नैति जे गुरुले तिरो आमाफोकौ?”<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">प्रस्थान ३०:१३</ref>; <ref loc="EXO 38:26">३८:२६</ref></char></note><verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />पत्रुसले ऐलेऊ, “औ ऐफोअवा।” पत्रुस झिमल पसियापाइना येशुले नकाजन हादेए ऐआढोव, “सिमोन, न बिचार नैलेव? पिरथ्बीला रययाङै तिरो अथाबा तिरो काङ्का ल्योङन रांउठाहौ? रा: ज़ायाङल्योङन सन् अपुऱ्याङ ल्योङन?” <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />पत्रुसले जबाक आयोव, “अपुऱ्याङ ल्योङन,” येशुले नकाजन ऐआढोव, “नै ताहकन ज़ायाङले ता छुट ऐडोएर रैस। <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />तर रुयाङ गेसं रायिङताचोत्या ऐलेन्या यिङस्यु दहल हिनस्यु बल्छी होर्ते, ओटन पैला परिन्या ङा:स्या होनस्यु। नकाल याह् नफटौक तोलोअ चान्दील सिक्का डोएना। ओटन ना रएस्यु न नाल्ट सनर ङा नाल्ट नकाङजन तिरो योंवरते।”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">सोगलैतन घिन्या काङ्का</para>
  <para style="r">
    <ref loc="MRK 9:33-37">मर्कुस ९:३३-३७</ref>,<ref loc="MRK 9:42-48">४२-४८</ref>; <ref loc="LUK 9:46-48">लूका ९:४६-४८</ref>; <ref loc="LUK 17:1-2">१७:१-२</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />नाइ बेला सिइयाङ येशु ल्योङ रा:स्यु रांगिनौ, “स्वर्गला राज्यल सोगलैतन घिन्या काङ्का?”<note caller="-" style="x"><char style="xo" closed="false">18:1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">लूका २२:२४</ref></char></note><verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />येशुले तोलोअ इङन्या लुलजन नेराक खुल्स्यु नकाङल खार्ल आसच्यानौ, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />ओटन ऐआढोवाङ, “ङा मछ्यु जेजन ऐढाच्या, यिङ फिरिसिस्यु जे इङन्या लुलल्याङमन माताइदुच्या भन्या खकै स्वर्गला राज्यल पसिन्या माल्चिदी।<note caller="-" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">मर्कुस १०:१५</ref>; <ref loc="LUK 18:17">लूका १८:१७</ref></char></note> <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />नैताइस्यु जोले ईका इङन्या लुलमन ओलझन्जै नरम जाटौ, नका स्वर्गला राज्यल सोगलैतन घिन्या ताइन्यालेया। <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />जोले ङा मिनङन तोलोअ ऐटाइन्या लुलजन ग्रहन ढोव, ओले ङाजन ग्रहन ढाङवा।”<verse eid="MAT 18:5" /></para>
  <para style="s">पापल परिनाम</para>
  <para style="r">
    <ref loc="MRK 9:42-48">मर्कुस ९:४२-४८</ref>; <ref loc="LUK 17:1-2">लूका १७:१-२</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />“तर जोले ङाजन बिस्वास ढान्या आका इङन्याङ मध्य तोलोअजन पाप ढाऔ परिङौ, बरु नाल ढेङल बडाक्कन्या लुङल चाखी पोअस्यु नकाजन घोलोमन्या समुन्दरल बुदाइन्या ठिक लेया।” <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />आक्याई आका सङ्सार! “पाप ढाऔ परिङन्या परिक्छ्या ता ऐराया, तर आक्याई, ना जो रुतन पाप ढाऔ परिङन्या बाढा रा:!” <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />जे कुई या जे खङले जेजन पाप ढाऔ परिङचिऊ कन नाजन पलस्यु क्याइचिते। नेंलोअ कुई या नेंलोअ खङसकाए अनन्तल मील क्याइसिऊभन्या ता बरु लुला या दुन्डा ताइस्यु जिबनल पसिन्या जे नाल्ट चान्या ताहा।<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">मत्ती ५:३०</ref></char></note> <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />जे म्युउले जेजन पाप ढाऔ परिङचिऊकन नकाजन कलअस्यु क्याइचिते। नेंलोअ म्युउसं नरगला मील हिनौ भन्याता बरु तोलोअ म्युउसं जिबनल पसिन्या जे नाल्ट ठिक लेया।<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">मत्ती ५:२९</ref></char></note><verse eid="MAT 18:9" /></para>
  <para style="s">मांन्या भेडालं आहान</para>
  <para style="r">
    <ref loc="LUK 15:3-7">लूका १५:३-७</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“होसियार ताइचिते, जे ईका इङन्याङ मध्य तोलोअजन बै हेलाइ ताढोच्यो। दानाङभन्या ङा जेजन ऐढाच्या, स्वर्गदुतयाङै ङा बौल दर्शन स्वर्गल सदाईज ढाज्यारा। <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />दानाङभन्या रुल ज़ा मांन्याङजन बचाइ रांऔ हो।”<note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">लूका १९:१०</ref></char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />“जे बिचार नैलेव? तोलोअ रुल सय गोटा भेडाङ मध्य तोलोअ बिस्किस्यु हिनकन, ओले उनानसय वटाजन बनाएस्यु डान्डा घैरा जिऊल ना बिस्किस्यु हिनन्या तोलोअजन मारोअनाऔ का? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />ङा मछ्यु जेजन ऐढाच्या, यदि ओले नाजन डोएदा भन्या, बिस्किस्यु माहिनन्या ना उनानसय भेडाङभन्या तोलोअल नाल्ट नका भ्याई हेसाङन्यालेया। <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />नामन्जै स्वर्गल लिज्यान्या जे बौल इच्छ्या बै ऐटाइन्याई लेया, कि ईका इईङन्याङ मध्य तोलोअ बै नास ताटाइरत्या।”<verse eid="MAT 18:14" /></para>
  <para style="s">पाप ढान्या दाज्यूभाई या दिदीबैना</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“यदि न दाज्यूभाई या न दिदीबैनाले न बिरोदत पाप ढोदा भन्या, हिनस्यु झेन नेंलोअयाएज झेनलेऊक नकाल दोस थनस्यो। नकाले न छेन थएदा भन्या, न दाज्यूभाई या न दिदीबैना नमी ताइदा।<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">लूका १७:३</ref></char></note> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />तर नकाले माथएदा भन्या ओलसं तोलोअ या नेंलोअजन लाङ ओटन नेंलोअ अथाबा तिन जना साचीयाङ्ङन सोगलै छेन पक्का ग्याताइत्या।”<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">ब्यबस्था १९:१५</ref></char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />यदि ओले नकाङल छेन थटौ माभन्दा भन्या, मन्डलीयाङजन पानस्योचिरते। नकाले मन्डलीला छेन बै माथएदा भन्या, नका न नाल्ट गैरयहूदीयाङ सनर तिरो उठाइन्यामन्जै ग्याताइत्या। <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />“ङा मछ्यु जेजन ऐढाच्या, जे पिरथ्बील जो पोअच्यो, नका स्वर्गत पोअन्यालेसिया। ओटन जे पिरथ्बील जो पलाअच्यो नका स्वर्गत पलाअन्या लेसिया।”<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">मत्ती १६:१९</ref>; <ref loc="JHN 20:23">यहुन्ना २०:२३</ref></char></note> <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />“ङा मछ्यु फरि जेजन पानस्याच्या, पिरथ्बील जेमध्य नेंलोअ जो छेनत सहमति ताइस्यु कोबाअ नीदुच्या भन्या, ना स्वर्गला ङा बौङन जे नाल्ट ताइन्यालेया, <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />दानाङभन्या जोङ नेंलोअ या तिनगोटा ङा मिनत दुउसिर, ओङ ङा नकाङल खार्ल ताइङा।”<verse eid="MAT 18:20" /></para>
  <para style="s">छेमा मायान्या नोक्करल आहान</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />पत्रुस येशुल ल्योङ रा:स्यु ऐलेऊ, “औ प्रभु, ङा भाईले ख्वाए पाला ङा बिरोदत पाप आढोव, नैति ङा नकाजन साट पाला समन छेमा यांन्या रों?”<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="LUK 17:3">लूका १७:३</ref>; <ref loc="LUK 4">४</ref></char></note><verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />येशुले नाजन ऐआढोव, “ङा नङजन ऐढाना, साट पाला माङडी, तर सहत्तर गुना साट पाला।” <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />नैताइस्यु स्वर्गला राज्य तोलोअ रय सकाए मानौ दुदुसिया, जोले आनोक्करयाङ सकाए हिसाप होनन्या बिचार आढोव। <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />जब ओले हिसाप नीऊ तअसिऊ, दस हजार सुनल सिक्का लोई लाङन्या, तोलोअजन आल्योङ राहोनौ। <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />तर नका रुले नैजमालस्यु फोकौ माढुदुवा पाइना नकाल साहूले नकाजन आमेएमा सनर आज़ायाङ ओटन आमि सोगल जन्तु यएस्यु लोई फोअन्या आदेस आयोव। <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />“तब ना नोक्करले घुन्डा टिकिस्यु नकाजन ढोक या:स्यु ऐलेऊ तअसिऊ, ‘साहू ज्यू, ङाजन दया ढाङते, ङा सोगलै ङालोई चुक्ता जाएस्याना।’” <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />तब नका नोक्करलं साहूले यीङताए मानिस्यु नाजन आराहौ, ओटन नकालं लोई मनआमारिस्यौ।<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“तर नका नोक्कर ओलन पलिईस्यु आहिनज्याऔक आन्हाएयाङ मध्य तोलोअ नोक्करस डोएसिऊ, जोले नकाल त सय चान्दील सिक्का लोई लाङस्यु आनाटौ। नकाले नाजन आभोङक्राल कोलोअस्यु ऐआढोव, ‘नलोई फोअते।’” <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />“तर नकाल न्हाए नोक्करले निऊरिस्यु नाजन बिन्ति आढोव, ‘ङाजन दया ढास्यु वुइते,’ ङा नमी सोगलै फोअङा।” <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />“तर नकाले माभनस्यु, ना हिनौ ओटन नवाएजा माङडी नकाले लोई आमाफोकौ समन नकाजन झ्यालखानाल आझोकौ। <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />नकाल आन्हाए नोक्करयाङै ईका सोगलै रांरङौ ओटन नकाङ भ्याईज दुखी ताइवाङ। नकाङै हिनस्यु रा:साहूजन ईका स्वाट्टै घटना रापानस्यौ। ” <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />“तब साहूले नका नोक्करजन आल्योङ खुल्स्यु ऐआढोव, ऐ बिकामी नोक्कर, नङ ङाजन बिन्ति नढाङनु, ओटन ङा नङजन नलोईन्या मनङामारिस्यानु।” <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />ङा नङजन जोमनलेस्यु दया ङाढानु, नङ बै न न्हाए नोक्करजन दया ढाऔ मापरिऊ? <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />तब नकाल साहूले भ्याई आयिङचोस्यु नाजन सोगल आलोईन्या आमाफोकौ समन सजाई यांन्या सिपाइयाङल कुईत जिम्मा आयोवाङ। <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />ओटन येशुले निस्कर्स आपलिटौ “जे बै जेदाज्यूभाई या जेदिदीबैनाजन जेयिङ्ङन्ज छेमा मायोचिरकन, स्वर्गल लिज्यान्या ङा बौले बै जेजन नैताइन्या ब्यबहार ढान्यालेया।”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">येशुले भाअसिन्या बारेल आह्युउन्या</para>
  <para style="r">
    <ref loc="MRK 10:1-12">मर्कुस १०:१-१२</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />येशुले ईका छेन छ्योङा पाइना गालील प्रदेसङन यर्दन भईल हुदिफन्ट यहूदा इलाकादेए हिनौ। <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />ओटन बअघिन्या रुयाङल हुल आछिनछिन रांवाङ, ओटन ओले ओङा रुयाङजन आसबेल्वाङ। <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" />काङ्काकाङ्का फरिसीयाङ आल्योङ रा:स्यु फसाहौ नाल्ट ओलजन रांगिनौ, “नैति पबित्रशास्त्रलं अनुसार काङ्काई बै ल्हेपाले बिनाकारन आमेएमा सकाए भाअसिन्या ठिक लेऊ?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />तर येशुले ऐआढोवाङ, “नैति जे परीस्यु जेमालेचिऊ, कि स्रिस्टीकर्ताले नकानेजन सुरुतजै ल्हेपा सनर मेएमा आजाटौने,<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">उत्पत्ति १:२७</ref>; <ref loc="GEN 5:2">५:२</ref></char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />ओटन परमेस्वरले ऐलेऊ, ‘नैताइस्यु रुले आबौ सनर आअमाजन राइस्यु आमेएमास मिलिज्याया, ओटन नका नेंलोअनें तोलोअजै बुल ताइन्यालेन्या।’<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">उत्पत्ति २:२४</ref></char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />नकाने आब नेंलोअ माङडी, तर तोलोअजै बुल ताइन्या। नैताइस्यु परमेस्वरले जोजन बोलोङ आजुरिऊ, नाजन काङ्काई रुले ताछुटाहौत्या।”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />फरिसीयाङै येशुजन रांगिनौ, “मोशाले दानाङ मेएमाजन भरपाई सरस्यु राइन्या आग्या योंव?”<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ब्यबस्था २४:१-४</ref>; <ref loc="MAT 5:31">मत्ती ५:३१</ref></char></note><verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />येशुले नकाङजन ऐआढोवाङ, “चिमत्या जे यिङले गर्दा मोशाले जेजन मेएमा राइन्या अनुमति जेजन आयांचिऊ हो। तर सुरुत ऐटाइन्या मालेऊ। <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />ङा जेजन ऐढाच्या, जोले ब्यबिचारल कारन बाहेक आमेएमाजन राइस्यु छुट्टैसं ब्याहा ढोव, नकाले ब्यबिचार ढोवा।”<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्ती ५:३२</ref>; <ref loc="1CO 7:10-11">१कोरिन्थी ७:१०-११</ref>; <ref loc="MRK 10:11-12">मर्कुस १०:११-१२</ref></char></note> <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />सिइयाङै ओलजन ऐराढोव, “ज्या-योल ऐटाइन्याई सम्बन्द आताहौ भन्याता, ब्याहा माढान्याई चान्या ताहा।”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />येशुले नकाङजन जबाक आयोवाङ, “कोबाअले ईका बचन ग्रहन ढाऔ माढुदुरदी, जोजन ईका यांस्यु लेसिऊ ओयाङ याएजै ढुदुरा। <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />दानाङभन्या काङ्काङ राजर्मिऊकन्जै मिहिरी<note caller="+" style="f"><char style="fr" closed="false">19:12 </char><char style="ft" closed="false">मिहिरी = मिहिरी</char></note> ताइरा, ख्वाएयाएकने रुयाङै राजाएन्या मिहिरी ताइरा। ख्वाएयाएकने रांईझन्ज स्वर्गला राज्यल नाल्ट मिहिरी ताइरा। जोले ईका ग्रहन ढाऔढुदुऊ, नकाले ना ग्रहन ग्याढोउत्या।”<verse eid="MAT 19:12" /></para>
  <para style="s">येशुले इङन्या लुलल्याङजन आशिर्बाद आयांन्या</para>
  <para style="r">
    <ref loc="MRK 10:13-16">मर्कुस १०:१३-१६</ref>; <ref loc="LUK 18:15-17">लूका १८:१५-१७</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />येशुले लुलल्याङयर्त आकुई नाएस्यु प्रार्थना ग्याढोस्यौरत्या लेस्यु रुयाङै आल्योङ नकाङजन राहोन्वाङ। ओटन आसिइयाङै ना रुयाङजन राहप्काईवाङ। <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />तर येशुले ऐआढोवाङ, “लुलल्याङजन ङाल्योङ रांऔ योंचिरते, नकाङजन तारुखिचिर। दानाङभन्या स्वर्गला राज्य ऐटाइन्याङलै ज्या।” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />ओटन ओले लुलल्याङयर्त आकुईले छुस्यु आशिर्बाद यांस्यु ओलं नलन हिनौ।<verse eid="MAT 19:15" /></para>
  <para style="s">धापा साहू रु</para>
  <para style="r">
    <ref loc="MRK 10:17-31">मर्कुस १०:१७-३१</ref>; <ref loc="LUK 18:18-30">लूका १८:१८-३०</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />तोलोअ रुले येशु ल्योङ रा:स्यु ऐलेऊ, “औ गुरु, ङा अनन्त जिबन डोटौ नाल्ट कैताइन्या चान्या काम ढान्या ताहौ?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />येशुले नकाजन ऐआढोव, “नैति चान्या नाल बारेल दानाङ नङ ङाजन गिनज्याङ? चान्या ता तोलोअ याएजै लेया। तर नङ जिबन डोएन्या यिङ ढोनकन, आग्याङ पालन ढोते।” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />नकाले ओलजन ऐआढोव, “काङ्का वाला?” येशुले ऐआढोव, “नङ हत्या ताढो, नङ ब्यबिचार ताढो, नङ ताकु, नङ ग्वारस्यु ताछ्योङन।<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">प्रस्थान २०:१३-१६</ref>; <ref loc="DEU 5:17-20">ब्यबस्था ५:१७-२०</ref></char></note> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />न बौ नाअमाङ मान नाए, ओटन न डेराबाराजन नङजन मन मया ढोवर।”<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">प्रस्थान २०:१२</ref>; <ref loc="DEU 5:16">ब्यबस्था ५:१६</ref>; <ref loc="LEV 19:18">लेवी १९:१८</ref></char></note> <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />ना धापा रुले ओलजन ऐआढोव, “ईका सोगल ङा ता मानिस्यु लेङा। आब ङासं नैति कमि लेऊ?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />येशुले नकाजन ऐआढोव, “नङ परमेस्वरलं सामन्दी चान्या ताहौ रोंकनकन, हिनस्यु नङसं लेन्या सम्पति यएस्यु गरिबयाङजन योंवरते, ओटन रा: स्यु ङा छिन्ट लागिन्ते, ओटन नङ स्वर्गल धन डोएन्यालेना।” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />जब नका धापा रुले ईका छेन थएवापाइना, तब नकाले दुख मानिस्यु हिनौ, दानाङभन्या नका ल्योङ तबर धनसम्पत लेऊ। <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />ओटन येशुले आ सिइयाङजन ऐआढोवाङ, “ङा मछ्यु, जेजन ऐढाच्या, स्वर्गला राज्यल धनी रुयाङजन पसिन्या गारो ताइन्यालेया। <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />फरि ङा जेजन ऐढाच्या, धनी रुयाङजन परमेस्वरलं राज्य भितरलं पसिन्यातन ता बरु ऊटजन व्पल नायलन छिरिन्या सजिलो ताहा।”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />सिइयाङै ईका थएस्यु भ्याई अचम्म मानिस्यु रांगिनौ, “नैताहकन काङ्काले उद्दार डोटौ ढुदुऊ का?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />येशुले नकाङ लेऊदेए ब्याएस्यु ऐआढोवाङ, “रुयाङल नाल्ट ईका असम्भब लेया, तर परमेस्वरलं नाल्ट सोगलै छेन सम्भब लेया।” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />तब पत्रुसले ओलजन ऐआढोव, “खिम्ते, गे सोगलै जन्तु राइस्यु नछिनछिन लागिज्याया। गे नै गेडोएयिउ वन?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />येशुले नकाङजन ऐआढोवाङ, “मछ्यु ङा जेजन ऐढाच्या, जे जो ङाछिन्ट लागिस्यु जेल्चिऊ, सोगलै छार स्रिस्टीक जब रुल ज़ा आमि महिमालं सिहासनत चुङ, तब जे बै बारं सिहासनत चुङन्या लेच्या, ओटन इस्राएलला बारं कुललयर्त सोगलै निया ढान्यालेच्या।<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्ती २५:३१</ref>; <ref loc="LUK 22:30">लूका २२:३०</ref> </char></note> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />ज्वाएले ङा मिनल कारनले आझिम, आदाज्यूभाई, आदिदीबैना अथाबा बौ या आमा, ज़ायाङ, येङखेए राइस्यु नाटौ, नाले सय गुना डोएन्यालेया, ओटन अनन्त जिबनल अढिकार डोएवा। <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />तर जो भ्याई हादेए लेर नकाङ छिन्ट ताइन्यालेरा, ओटन छिनदेए लिज्यान्याङ हादेए ताइन्यालेरा।”<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्ती २०:१६</ref>; <ref loc="LUK 13:30">लूका १३:३०</ref></char></note><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">अङ्गुर बारील काम ढान्याङल आहान</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“स्वर्गला राज्य तोलोअ येङल खसममन हो, जो छकाल्या घलज आमि अङ्गुरल बारील कामदारयाङजन ध्यारील काम लाहौ नाल्ट बाहेर पलिहौ।” <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />कामदारयाङल तयोअका ध्यारी तोलोअ चान्दील सिक्का यांन्या छेन पक्का जाएस्यु ओले नकाङजन आअङ्गुर बारील आपरिङवाङ। <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />“जब छकाल्याका नौ बजे बाहेर पलिहौ, ओले अपुऱ्याङजन द्वाहात बिनाकाम राच्याङज्यान्या आरङवाङ, <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />ओटन ओले नकाङजन ऐआढोवाङ, ‘जे बै अङ्गुर बारील हिन्चिते, ओटन ज्वाए ठिक ले, ङा जेजन यांच्या।’” <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />नैताइस्यु नकाङ हिन्वाङ, “फरि नकाले बारं बजे सनर तिन बजेदेए बाहेर पलिईस्यु नैज लेऊ। <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />नकाले पास बजे बाहेर आपलिहौक अपुऱ्याङजन राच्याङज्यान्या आडोएवाङ, ओटन नकाङजन आढोवाङ, ‘जे दानाङ इल दिनभरि बिनाकाम च्याङज्याच्यो?’”<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />“नकाङै ओजन ऐराढोव, ‘काङ्काईले गेजन कामल मालाईयिउदी नैताइस्यु।’ ओले नकाङजन ऐआढोवाङ, ‘जे बै अङ्गुर बारील हिन्चिते ओटन काम ढोचिते।’” <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />“जब ओई ताहौ, तब अङ्गुर बारील खसमले आबैदारजन ऐआढोव, ‘कामदारयाङजन खुल्स्यु छिन्ट रांन्याङतन रएस्यु हादेए रांन्याङजन रां ध्यारी यौंरते।’”<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">लेवी १९:१३</ref>; <ref loc="DEU 24:15">ब्यबस्था २४:१५</ref></char></note> <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />पास बजे कामल लागिन्याङ रांवाङ, ओटन नकाङ सोगलैले पुरा तयोअका ध्यारी रांडोटौ। <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />जब हादेए कामत लागिन्याङ रांवाङ, तब नकाङै भ्याई डोएया ऐलेन्या बिचार रांढोव, तर नकाङ सोगलैले तयोअका ध्यारी रांडोटौ। <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />डोटौ परिन्या ध्यारी डोएरा पाइना येङल खसमलं बिरोदत नकाङ गनगन लेऊ तअसिवाङ। <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />“नकाङै ऐलेऊ तअसिवाङ, ‘ईका छिन्ङाङ त घन्टा याएज काम रांढोव, तर नङ नकाङजन गे दिनभरि बअ दुख डोएन्याङ सनर चर्को घाम सहिन्याङमन नजातनवाङ।’” <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />“तर साहूले नकाङ मध्य तोलोअजन जबाक आयोव, ‘ऐ न्हाए, ङा नयर्त नैज अनिया ढास्यु मालेङदी। नैति नङ ङासं पुरा तयोअका ध्यारील काम ढान्या कबुल नमाढोनु?’ <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />नङ नडोएन्या ध्यारी लाङस्यु न हिनन्ते। आका छिन्ङाङजन बै नङजन ङायान्यायाए जै योंङरा। <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />ङामि ज्वाए ले, नका ङा ङाचाहिन्या अनुसार ढाऔ ङामाढुदुङु का? ङा भलाई ङाढाऊक नैकाम न म्युउ तुउज्याऊ का?” <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />“नैताइस्यु छिन्ङाङ हादेए ताइन्यालेरा ओटन हादेएङाङ छिन्ङ ताइन्यालेरा।”<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">मत्ती १९:३०</ref>; <ref loc="MRK 10:31">मर्कुस १०:३१</ref>; <ref loc="LUK 13:30">लूका १३:३०</ref> </char></note><verse eid="MAT 20:16" /></para>
  <para style="s">येशुले सिइकालल बारेल तिन पालाक आपानन्या</para>
  <para style="r">
    <ref loc="MRK 10:32-34">मर्कुस १०:३२-३४</ref>; <ref loc="LUK 18:31-34">लूका १८:३१-३४</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />यरुशलेम देए राहिनज्याऔक येशुले बारं जना आ सिइयाङजन अलक्कै लाङस्यु यमल नकाङजन ऐआढोवाङ, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“गे यरुशलेम देए गेहिनज्यायिउ। आब ङा रुल ज़ाजन मुख्या पुजाउरोयाङ सनर शास्त्रीयाङल कुईत सुम्पिङरा, ओटन नकाङै ङाजन सएन्या दन्डल दोसी ठहऱ्याहङरा। <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />ङाजन गिलल्याहङरा, कोर्ला लाहङरा, ओटन नकाङै क्रूसतं केपौ नाल्ट ङाजन गैरयहूदीयाङल कुईत सुम्पिङरा, ओटन तिन दिनक ङा जिङदा ताइस्यु सोन्यालेङा।”<verse eid="MAT 20:19" /></para>
  <para style="s">तोलोअ आमाल बिन्ति</para>
  <para style="r">
    <ref loc="MRK 10:35-45">मर्कुस १०:३५-४५</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />जब्दियाल मेएमाले नेंलोअ ल्हेपाज़ानेंजन ओलसं होनस्यु येशुल हाक घुन्डा टिकिस्यु बिन्ति आढोव। <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />येशुले नकाजन आगिनौ, “नङ नै नचाहिनु?” नकाले ओलजन ऐआढोव, “आग्या ढोते ओटन न राज्यल, ईका नेंलोअ ङाज़ानें मध्य तोलोअ नदाइन्याङन, ओटन छुट्टै नदाबऱ्या कुईङन चुङौ ग्याडोएनेत्या।” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />तर येशुले जबाक आयोवाङ, “जे नै जेनीज्याचिऊ ना मासन्चिदी। ङा जो कटौरा ओङा ङालज्याङु, नैति ना जे ओव जेढुदुचिऊ?” नकाङै ऐराढोव, “ऐढुदुया।” <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />तब येशुले ऐआढोवाङ, “ङा कटौरा जे ऐओदुच्या, तर ङादाइन्या सनर ङादाबऱ्याङन चुङौ यांन्या छेन ङा कुईत माल्दी। ईका पो नकाङल हो, जोल नाल्ट ङा बौले तयार जाएस्युलेऊ।” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />आका थएस्यु दसगोटा सिइयाङस ना दुईभाईसं रायिङचोव। <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />येशुले सोगलैजन आलेऊदेए खुल्स्यु ऐआढोवाङ, “जेजन थाहै लेया, कि गैरयहूदीयाङल शासकयाङै नकाङयर्त निरङकुस शासन ढोरा, ओटन घि-घिन्या हाकिमयाङै नकाङयर्त अढिकार जमाइरा।<note caller="-" style="x"><char style="xo" closed="false">20:25 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">लूका २२:२५-२६</ref></char></note> <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />जे खार्ल ऐताटाइत्या, तर जोले जेतन घिन्या ताहौ रोंकौ, नका जे सेवाऱ्या ताइन्या ताहा।<note caller="-" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्ती २३:११</ref>; <ref loc="MRK 9:35">मर्कुस ९:३५</ref>; <ref loc="LUK 22:26">लूका २२:२६</ref></char></note> <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />जोले जेमध्य हादेए ताहौ रोंकौ, ना जे सेवाऱ्या ताइन्या ताहा, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />जोमनलेस्यु रुल ज़ा बै सेवा डोटौ नाल्ट माङडी, तर सेवा ढान्या सनर तबर रुयाङल जिबनल छुटकाराल येएल नाल्ट परान याराऔ।”<verse eid="MAT 20:28" /></para>
  <para style="s">येशुले नेंलोअ अन्ढलानेजन आसबेलौने</para>
  <para style="r">
    <ref loc="MRK 10:46-52">मर्कुस १०:४६-५२</ref>; <ref loc="LUK 18:35-43">लूका १८:३५-४३</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />येशु सनर आ सिइयाङ यरीहोङन राहिनज्याऔक, तोलोअ घिन्या रुयाङल हुल ओयाङल छिन्ट लागिवाङ। <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />यमल वङल चुङज्यान्या नेंलोअ अन्ढलाने येशु नका यम हिनज्याऔ, ऐरालज्यान्या नेंथटौ ओटन ऐलेस्यु कलिकौने, “औ प्रभु, दाऊदल ज़ा, घेनजन दया ढासिन्ते।” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />रुयाङै नानेजन छपक्कै दिङचिन्ते लेस्यु राहप्काहौ, तर नकाने ऐलेस्यु चोएसै कलिकौने, “औ प्रभु, दाऊदल ज़ा घेनजन दया ढासिन्ते।” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />तब येशु अदिउ ओटन नकानेजन खुल्स्यु ऐआढोवने, “झेन नै झेनचाहिचिनु? ङा झेन नाल्ट नै ढास्याचिन?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />नकानेले ओलजन ऐनेढोव, “औ प्रभु, घोन म्युउ फएस्यासिन्ते।” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />येशुले यीङताए मानिस्यु नानेल म्युउ आछुस्यौने ओटन ओचोएटै नकानेले नेंरङौ ओटन आछिन्ट लागिऊने।<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">येशुल झ्योङ यरुशलेमला बए</para>
  <para style="r">
    <ref loc="MRK 11:1-11">मर्कुस ११:१-११</ref>; <ref loc="LUK 19:28-40">लूका १९:२८-४०</ref>; <ref loc="JHN 12:12-19">यहुन्ना १२:१२-१९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />जब येशु सनर आ सिइयाङ यरुशलेमल नेराका जैतुन डान्डाला बेथफागेल ताप्‌रावाङ, तब येशुले नेलोअ सिइनेजन ऐढास्यु आपरिङौने, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />“झेन नकाजिऊका नङ्गरल हिनचिन्ते। ओलं झेनटापौ चोएटै तोलोअ गडाहा सनर नाल पुङ नेसुरसिज्यान्या डोएनाङचिना। ओटन नानेजन पलाअस्यु ङाल्योङ होनचिन्ते। <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />काङ्काङै झेनजन कैयाए ढाचिनरकन, ‘प्रभुजन ईका चाहिज्याऔ’ ऐढोचिन्‌र ओटन नकाले ओभजाक्कै ना परिङन्या लेया।” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />अगमबक्ताङ्ङन पान्सिन्या बचन ऐताइस्यु पुरा ग्याताइत्या लेस्यु ऐताहौ हो, <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />“सियोनल मेएमाज़ाजन ऐढोचिन्ते, खिम्ते, न रय जो बअनरम लेया, गडाहा सनर तोलोअ गडाहाल पुङयर्त सवार ताइस्यु नल्योङ रांज्याऔ।”<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">जकरिया ९:९</ref> </char></note> <verse eid="MAT 21:5" /><verse number="6" style="v" sid="MAT 21:6" />तब सिइने हिनौने, ओटन येशुले आपरिमन्या अनुसार नकाने नेंढोव। <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />नकानेले गडाहा सनर नकाल पुङ नेंहोनौ, ओटन नकायर्त नेंक्वायाङ नेंठुङौ, ओटन येशु नकायर्त चुङौ। <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />हुलला भ्याउयाएले रांक्वा यमल रांठुङौ, ओटन अपुऱ्याङै सिङल हाङ्गाङ पलस्यु यमल रांठुङौ। <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />येशुल हाङन सनर छिन्ङन बाज्यान्या हुललन भ्याउयाएले ऐलेस्यु कलिऊवाङ, “दाऊदल ज़ाजन होसन्ना! बअचान्या हो, जो परमप्रभुल मिनतन रांज्याऔ! परमधामल होसन्ना!”<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">भजनसङ्ग्रह ११८:२५-२६</ref></char></note><verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />जब येशु यरुशलेमल पसिऊ, सोगल सहरल हलचल मच्चिऊ। ओटन रुयाङै गिनौ तअसिवाङ, “ईका काङ्का रैस?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />हुलला रुयाङै जबाक रांयोवाङ, “ईका गालील प्रदेसला नासरतङन रांन्या अगमबक्ता येशु दी।”<verse eid="MAT 21:11" /></para>
  <para style="s">येशु मन्दिरलं हिनौ</para>
  <para style="r">
    <ref loc="MRK 11:15-19">मर्कुस ११:१५-१९</ref>; <ref loc="LUK 19:45-48">लूका १९:४५-४८</ref>; <ref loc="JHN 2:13-22">यहुन्ना २:१३-२२</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />येशु मन्दिरलं हिनौ। ओटन ओले मन्दिरलं लङन्या, यएन्या सोगलैजन आचाहारवाङ, ओटन पैसा फिरिन्याङल डेस्क, सनर परेवा यएन्याङल खोर आपल्ताइस्योवाङ। <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />ओले नकाङजन ऐआढोवाङ, “ईका पबित्रशास्त्रलं सरसिन्या लेया, ‘ङा झिम प्रार्थनाल झिम ऐढान्या लेसिया।’ तर जे इकाजन गोएयाङल अड्डा जाएस्यु नाएच्या।”<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">यशैया ५६:७</ref>; <ref loc="JER 7:11">यर्मिया ७:११</ref></char></note> <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />नका मन्दिरलं अन्ढलाङ सनर लुलाङ येशु ल्योङ रांवाङ, ओटन ओले नकाङजन आसबेल्वाङ। <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />तर जब मुख्या पुजाउरोयाङ सनर शास्त्रीयाङ येशुले आढान्या अचम्मला काम रांरङौ, ओटन लुलल्याङै मन्दिरलं “दाऊदल ज़ाजन होसन्ना” लेस्यु राचिचच्याइन्या राथटौ, तब नकाङ रायिङचोव, <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />ओटन नकाङै येशुजन ऐराढोव, “नठएज्यानु, इकाङै नै पानज्यावाङ?” तब येशुले नकाङजन ऐआढोवाङ, “औ ऐथएज्याङा। नैति जे परीस्यु जेमाल्चिऊ, ‘लुलल्याङ सनर नुन ओन्या बालअयाङल याह्‌लन नङ पुरा प्रसम्सा पलिईस्यु नाएना?’”<note caller="-" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">भजनसङ्ग्रह ८:२</ref></char></note><verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />तब येशुले नकाङजन यरुशलेम सहरलन पलिईस्यु हिनौ, ओटन बेथानिया हिनस्यु नङं तरिऊ चुङौ।<verse eid="MAT 21:17" /></para>
  <para style="s">येशुले ड्यूल टुङजन आसरापिन्या</para>
  <para style="r">
    <ref loc="MRK 11:12-14">मर्कुस ११:१२-१४</ref>,<ref loc="MRK 11:20-24">२०-२४</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />तयोअका छकाल्याई यरुशलेम सहरदेए आवलज्याऔक येशु करेव। <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />यमल वङक ओले तोलोअ ड्यूल टुङ आरङौ। ओटन नका टुङ लेऊक रांऔ, तर नकाल ल्हापटा बाहेक अपुर नैज मारङदा। तब नकाजन आढोव, “आब आटनपार नङत खकै शई तासैईत्या” ओटन ना ड्यूल टुङ ओचोएटै राङौ। <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />नका रङस्यु आ सिइयाङ अचम्म मानिस्यु ऐलेवाङ, “ईका ड्यूल टुङ कडाई ओचोएटै राङौ?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />येशुले नकाङजन ऐआढोवाङ, “ङा मछ्यु जेजन ऐढाच्या, यदि जेल्योङ बिस्वास लेकन सनर खकै सङ्का माढोच्योकन, ड्यूल टुङजन जोमन जाएसिऊ नवाए याएज माङडी, तर ईका डान्डाजन बै ‘भोइस्यु समुन्दरल तेहन्ते’ ऐढोच्योकन नैजै ताइन्यालेया।<note caller="-" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">मत्ती १७:२०</ref>; <ref loc="1CO 13:2">१कोरिन्थी १३:२</ref></char></note> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />यदि बिस्वास ढास्यु प्रार्थनाल जो नीच्यो ना जे डोएन्यालेच्या।”<verse eid="MAT 21:22" /></para>
  <para style="s">येशुल अधिकारत सङ्का</para>
  <para style="r">
    <ref loc="MRK 11:27-33">मर्कुस ११:२७-३३</ref>; <ref loc="LUK 20:1-8">लूका २०:१-८</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />येशु मन्दिरलं पसिऊ, ओटन सिक्छ्या आयांज्याऔक मुख्या पुजाउरोयाङ सनर जनताङल सेरयाङ आल्योङ रांवाङ, ओटन ऐराढोव, “नै अधिकारले नङ आका कामयाङ नढाज्यानु, ओटन काङ्काले नङजन ईका अढिकार आयानु?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />येशुले नकाङजन जबाक आयोवाङ, “ङा बै जेजन तोलोअ छेन गिनच्या। ङाजन नाल उत्तर यांङच्योकन, ङा नै अढिकारले ईका काम ङाढोङु, नका जेजन पानस्याच्या। <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />यहुन्नाल बप्तिस्मा काङ्काङन ताहौ? स्वर्गला परमेस्वरङन सन् रुयाङ्ङन?” नकाङ रारांल ऐलेस्यु छ्योङौ तअसिवाङ, “गे स्वर्गला परमेस्वरङन ऐलेऊक, इकाले ‘ओमनटाहकन जे नकाजन दानाङ बिस्वास माढोच्यो?’ ऐढाइवा। <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />यदि रुयाङ्ङन ऐलेऊक, गेजन रुयाङल छ्याइ लेया। दानाङभन्या सोगलैले यहुन्नाजन अगमबक्ता मानिरा।” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />नैताइस्यु नकाङै ओलजन जबाक रांयोव, “गे मासनैदी।” येशुले नकाङजन आढोवाङ, “ङा बै नै अढिकारले ईका काम ङाढाज्याङु, नका जेजन मापानस्याचिदी।”<verse eid="MAT 21:27" /></para>
  <para style="s">नेंलोअ ल्हेपाज़ानेंल आहान</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“जे कैताइन्या बिचार जेढोचिऊ? तोलोअ रुल नेंलोअ ल्हेपाज़ानें लेऊने। ओले सेरवालाजन रा:स्यु ऐआढोव, ‘ज़ा, हिनस्यु आछिम अङ्गुर बारील काम ढोते।’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />नकाले जबाक आयोव, ‘ङा माहिनङदी।’ तर ओलं छिन्ट पस्ताइस्यु हिनौ।” <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />“नकाल छिन्ट बौ छुट्टै आज़ा ल्योङ हिनस्यु नैज आढोव, ओटन नाले जबाक आयोव, हो ‘ङा हिन्ङा ऐलेऊ।’ तर ना माहिन्दा। <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />आब नका नेंलोअनेंतन काङ्का वालाले नेंबौल छेन नेंमानिऊ?” नकाङै जबाक रांयोव, “सेरवालाले।” येशुले नकाङजन ऐआढोवाङ, “ङा मछ्यु जेजन ऐढाच्या, तिरो उठाइन्याङ सनर बेशस्याङ जेतन हादेए परमेस्वरलं राज्यल पसिऊ डोएरा। <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />दानाङभन्या बप्तिस्मा यांन्या यहुन्ना जेल्योङ धार्मिकताल यम ठनराऔ, ओटन जे नकाजन बिस्वास माढुदुच्या। तर तिरो उठाइन्याङ सनर बेशस्याङै नकाजन बिस्वास रांढोव। जे नका रङस्यु बै पस्चाताप माढुदुच्या ओटन नकायर्त बिस्वास माढुदुच्या।”<note caller="-" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">लूका ३:१२</ref>; <ref loc="LUK 7:29-30">७:२९-३०</ref></char></note><verse eid="MAT 21:32" /></para>
  <para style="s">अङ्गुरल बारी अढिया होनन्याङल आहान</para>
  <para style="r">
    <ref loc="MRK 12:1-12">मर्कुस १२:१-१२</ref>; <ref loc="LUK 20:9-19">लूका २०:९-१९</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />“येशुले आढोवाङ, तोलोअ छुट्टै आहान थएचिते। तोलोअ किसानी लेऊ, ओले तोलोअ अङ्गुरल बारी आलाहौ, ओटन नकाले हुङआङन बार कराप्स्यु, ओलं खादा किस्यु तोलोअ अङ्गुर प्योअन्या कोंल आजाटौ, ओटन तोलोअ यिउबाइ बै आजाटौ। ओटन अढिया वालाङजन ठेक्काल यांस्यु ओल परदेस देए हिनौ।”<note caller="-" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">यशैया ५:१-२</ref></char></note> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />जब शई ट्युकौ बेला नेरा ताइरा:औ, तब नकाले आनोक्करयाङजन अढियावालाङ ल्योङ शैल बठा चिनाऔ आपरिङवाङ।<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />“तर अढियाढान्याङै नकाल नोक्करयाङजन कोलोअस्यु तोलोअजन राटुपौ, छुट्टैजन रासटौ, ओटन तोलोअजन लुङले राटुपौ। <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />फरि नकाले हाकाङतन भ्याई नोक्करयाङजन आपरिङवाङ, ओटन नकाङै नकाङसं बै नैताइन्याईज ब्यहोरा रांढोव। <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />‘ङा ज़ा झनता नकाङै ऐमानिरा होला’ ऐलेन्या यिङस्यु, आसापट ओले आज़ाजन नकाङ ल्योङ आपरिङौ।” <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />“तर अढियाढान्याङै आज़ाजन रङस्यु रारांल ऐलेवाङ, ‘ईका ता हकदार दी। रांचिते, इकाजन सएया, ओटन इकाल हक गेकुईत होन्‌या’।” <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />तब नकाङै ओजन राकोलोकौ ओटन अङ्गुरल बारीलन घिसारस्यु बाहेर देए लाङस्यु रासटौ। <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />“येशुले ऐआढोवाङ, जब अङ्गुर बारील खसम रांऔ, तब नकाले नका अढिया वालाङजन कै आढोवाङ होला?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />नकाङै ओलजन ऐराढोव, “ओले नका दुस्टयाङजन सटौरा, ओटन अङ्गुरल बारी छुट्टै अढियाढान्याङजन ठेक्काल यांन्या लेया, जोयाङै ओलजन शैल बठा समायत बुझाईन्या लेरा।”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />येशुले नकाङजन आढोवाङ, “नैति जे पबित्रशास्त्रला बचन खकै जेमापरीचिऊ? ‘जो लुङजन झिम कुर्मियाङै बिकामला रांजाटौ नकाई कोनाअता सुरलुङ ताहौ, ईका परमप्रभुङन ताइन्या हो, ओटन गे नजरत ईका अचम्मला लेया।’<note caller="-" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">भजनसङ्ग्रह ११८:२२-२३</ref></char></note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“नैताइस्यु ङा जेजन ऐढाच्या, परमेस्वरलं राज्य जेल्योङन न्हानन्या लेसिया, ओटन तोलोअ ऐटाइन्या जातिजन यांन्यालेसिया, जोले नकाल शई शशैवा। <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />ईका लुङयर्त टेईन्या पाअ-पाअ ताइन्यालेया, तर जोलयर्त नका लुङ टेह, आकाले नकाजन हेएन्या लेया।”<note caller="-" style="x"><char style="xo" closed="false">21:44 </char><char style="xt" closed="false"><ref loc="LUK 20:18">लूका २०:१८</ref></char></note> <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />जब मुख्या पुजाउरोयाङ सनर फरिसीयाङै येशुल आहान राथटौ, तब इकाले गे बारेलै छ्योङज्याऔ रैस ऐलेस्यु राबुजिऊ। <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />नैताइस्यु नकाङै येशुजन कोलोकौ रारोकौ, तर नकाङ हुलजन रङस्यु छ्याएवाङ, दानाङभन्या रुयाङै ओलजन ईका तोलोअ अगमबक्ता हो ऐलेस्यु मानिज्यावाङ।<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">ब्याहा-भोसलं आहान</para>
  <para style="r">
    <ref loc="LUK 14:15-24">लूका १४:१५-२४</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />येशुले फरि आहानङन नकाङजन ऐआढोवाङ, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“स्वर्गल राज्यजन तोलोअ रय सकाए मानौ दुदुसिया, जोले आमि ल्हेपाज़ाल ब्याहा-भोस तयार आजाटौ, <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />ओटन भोसलं थाई परिङसिन्या रुयाङजन खुल्चिरते ऐलेस्यु आमि नोक्करयाङजन आपरिङवाङ, तर ओयाङ मारांदुरा।” <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />फरि नकाले अपुर नोक्करयाङजन ऐढास्यु आपरिङवाङ, “थाई परिङसिन्या रुयाङजन ऐढोचिरते, ब्याएचिते ङा ङामि भोस तयार जाएस्यु लेङा, ङा यीङयाङ सनर निखार पशुयाङजन पलस्यु नाएसिया, ओटन सोगलै जन्तु ठिक्कै ताइस्युलेया ब्याहा भोसलं रांचिते।” <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />तर नकाङै नैज वास्ता माढास्यु काङ्काङ रा: खेएबारीदेए, छुट्टैयाङ रा: बैपार देए लागिवाङ। <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />अपुऱ्याङै नकाल नोक्करयाङजन कोलोअस्यु राटुपवाङ ओटन नकाङजन दुर्ब्यब्यहार ढास्यु रासएवाङ। <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />तब रय आयिङचोव, ओटन आसिपाइयाङजन परिङस्यु ना साइढवाङजन सएस्यु, ओटन नकाङल सहर आहिपस्योवाङ। <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />“तब नकाले आनोक्करयाङजन ऐआढोवाङ, ‘ब्याहा-भोस तयार लेया, तर खुल्सिन्याङ मासुवाइन्या लेवाङ। <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />नैताइस्यु जे द्वाहादोबाटाल हिन्चिते, ओटन ज्वाएजन डोएच्यो नकाङजन ब्याहा-भोसलं खुलचिरते।’” <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />तब ना नोक्करयाङै द्वाहादोबाटाल हिनस्यु राडोएन्या भरियाङजन, चान्या सनर माचान्या सोगलैजन, रांखुल्वाङ, ओटन ब्याहा झिमल रुयाङ फाङताइवाङ। <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />“तर जब रयले पाहुनाङजन भितर पसिस्यु आखिम्नाऔक, नाले तोलोअ रुले ब्याहाला क्वा आमाक्वाइसिन्या आरङौ। <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />ओले नकाजन आगिनौ, ‘ऐ न्हाए, ब्याहाला क्वा माक्वाएसिस्यु नङ कढाई भितरलं नरानु?’ नकाले नैज माछ्योङदा।” <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />“तब रयले सेवाऱ्याङजन आढोवाङ, ‘नकाल खङ-कुई पोअस्यु नकाजन बाहेरङा चिऊन्याल क्याइचिते, ओङ व्‌रा ओटन ह्वा ज़िङ कैवा।’<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्ती ८:१२</ref>; <ref loc="MAT 25:30">२५:३०</ref>; <ref loc="LUK 13:28">लूका १३:२८</ref></char></note> <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />आसापट येशुले ऐलेऊ, दानाङभन्या खुल्सिन्याङ भ्याई लेरा, तर छेल्सिन्याङ थोरैजाइ लेरा।”<note caller="-" style="x"><char style="xo" closed="false">22:14 </char><char style="xt" closed="false"><ref loc="2CH 8:3">२इतिहास ८:३</ref></char></note><verse eid="MAT 22:14" /></para>
  <para style="s">कर फोअन्या बारेल रांगिनन्या</para>
  <para style="r">
    <ref loc="MRK 12:13-17">मर्कुस १२:१३-१७</ref>; <ref loc="LUK 20:20-26">लूका २०:२०-२६</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />तब फरिसीयाङ हिनस्यु ओलजन आछेनतै कैलेस्यु फसाहै ऐलेस्यु सल्ला रांढोव। <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />ओलं छिन्ट नकाङै सिइयाङजन हेरोदी बगालला रुयाङस आल्योङ रांपरिङौ। ओटन नकाङै ऐराढोव, “औ गुरुज्यू, गे ऐसन्या, नङ इमानदार लेना, ओटन परमेस्वरलं यम सत्यसैज ह्युउकनरा, नङ काङ्काईल छ्याइ मामानिन्दी, दानाङभन्या नङ रुयाङल हां खिमस्यु काम माढोन्दी। <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />आब गेजन ईका पानस्यासिन्ते, नैताहकन न बिचार नैलेव। कैसरजन<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">रोमी सम्राटजन कैसर ऐढासिया</char></note> तिरो फोअन्या ठिक लेऊ सन् मालेऊ?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />तर येशुले नकाङल कपटाई सनस्यु ऐआढोवाङ, “घुर्बीयाङ, जे ङाजन दानाङ बिचार ज्याङच्यो? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />ङाजन तिरो फोअन्या सिक्का थनस्याङचिते।” नकाङै येशु ल्योङ तोलोअ सिक्का राहोनौ। <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ओटन येशुले नकाङजन आगिन्वाङ, “ईका सुरुप काङ्काल?, ओटन काङ्काल मिन खुपिसिज्याऔ?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />नकाङै येशुजन ऐराढोव, “कैसरलं<note caller="+" style="f"><char style="fr" closed="false">22:21 </char><char style="ft" closed="false">रय = कैसर</char></note>।” तब येशुले नकाङजन ऐआढोवाङ, “नैताइस्यु जो कैसरलं हो, नका कैसरजन योंचिते, ओटन जो परमेस्वरलं हो, ना परमेस्वरजन योंचिते।” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />ओटन आछेन थएस्यु नकाङ छक्कै ताइवाङ, ओटन ओलजन यमल राइनिइस्यु हिन्वाङ।<verse eid="MAT 22:22" /></para>
  <para style="s">सिन्याङतन पुनरुत्थानल बारेल रांगिनन्या</para>
  <para style="r">
    <ref loc="MRK 12:18-27">मर्कुस १२:१८-२७</ref>; <ref loc="LUK 20:27-40">लूका २०:२७-४०</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />ओइछिम्क सदुकीयाङ सिन्याङ पुनरुत्थान माताइरदी ऐलेस्यु येशु ल्योङ रा:स्यु दाबि रांढोव,<note caller="-" style="x"><char style="xo" closed="false">22:23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">प्रेरित २३:८</ref></char></note> <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“नकाङै ऐलेवाङ, औ गुरुज्यू, मोशाले ऐलेस्यु लेया, जो रु दाज्यू निसन्तान ताइस्यु सी, नकाल भाईले आदाज्यूल मेएमा ब्याहा ढास्यु आदाज्यूल नाल्ट सन्तान नाटौपरिया।<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ब्यबस्था २५:५</ref></char></note> <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />गे आल साट भाई लेवाङ। जेठाले ब्याहा आढाऔ छिन्ट नका निसन्तान सिऊ ओटन नकाल आभाईयाङ ऐलेस्यु ब्याहा रांढोव। <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />नैलेस्युजै फरि माईलाले ओटन साईलाले, नैलेस्यु साटै वटाङस नैज ताहौ। <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />नकाङ सोगलै रासिऊ छिन्ट नका मेएमा बै सिऊ। <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />नैताइस्यु सिन्याङ पुनरुत्थान आताहौक नका काङ्काल ना मेएमा ताहौ? दानाङभन्या नका सोगलैल मेएमा ताइस्युलेया।”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />येशुले नकाङजन जबाक आयोवाङ, “जे भरमल परीस्यु लेच्या, दानाङभन्या जे पबित्रशास्त्र सनर परमेस्वरलं सक्ति मासन्चिदी। <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />तर सिन्याङल पुनरुत्थानक रुयाङै ब्याहा माढोरदी, दानाङभन्या नकाङ स्वर्गला स्वर्गदुतयाङमन्जै ताइरा। <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />तर सिन्याङै पुनरुत्थानल बारेल परमेस्वरले जेजन नैआपानस्याचिऊ, नैति जे पबित्रशास्त्रला बचन परीस्यु जेमाल्चिऊ? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘ङा अब्राहामल परमेस्वर, इसहाकलं परमेस्वर सनर याकूबल परमेस्वर हो।’ परमेस्वर सिन्याङल परमेस्वर माङडी, तर जिङदाङल परमेस्वर हो।”<note caller="-" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">प्रस्थान ३:६</ref></char></note> <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />ईका थएस्यु रुयाङल हुल ओलं ग्यानत छक्कै परिवाङ।<verse eid="MAT 22:33" /></para>
  <para style="s">सोगलैतन घिन्या आग्या</para>
  <para style="r">
    <ref loc="MRK 12:28-34">मर्कुस १२:२८-३४</ref>; <ref loc="LUK 10:25-28">लूका १०:२५-२८</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />येशुले सदुकीयाङजन छपक्कै आसदिङवाङ ऐलेन्या थएस्यु फरिसीयाङ आल्योङ दुउसिवाङ। <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />नकाङ मध्य तोलोअ ब्यबस्थाला शास्त्रीले ओलजन बिचारन्या यिङले आगिनौ,<note caller="-" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लूका १०:२५-२८</ref></char></note> <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“औ गुरुज्यू, मोशाल ब्यबस्थालं घिन्या आग्या काङ्कावाला हो?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />येशुले नकाजन ऐआढोव, “नङ परमप्रभु न परमेस्वरजन सोगलै नयिङले, सनर सोगलै नपरानले, ओटन सोगल यादले प्रेम ढोते।<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">ब्यबस्था ६:५</ref></char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />सोगलैतन घिन्या सनर पैला आग्या ईकाइ ज्या। <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />छुट्टै बै ऐटाइन्या लेया, ‘नङ नडेराबाराजन नङझन्ज मन प्रेम ढोवरते।’<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेवी १९:१८</ref></char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />मोशाल ब्यबस्था सनर अगमबक्ताङल सिक्छ्याल आधार जै आका नेंलोअ आग्याने हो।”<note caller="-" style="x"><char style="xo" closed="false">22:40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लूका १०:२५-२८</ref></char></note><verse eid="MAT 22:40" /></para>
  <para style="s">ख्रीस्ट काङ्काल ज़ा?</para>
  <para style="r">
    <ref loc="MRK 12:35-37">मर्कुस १२:३५-३७</ref>; <ref loc="LUK 20:41-44">लूका २०:४१-४४</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />जब फरिसीयाङ दुउसिस्यु लेवाङ, तब येशुले नकाङजन आगिन्वाङ, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“ख्रीस्टल बारेल जे नै जेयिङचिऊ? नका काङ्काल ज़ा हो?” नकाङै ओलजन ऐराढोव, “दाऊदल ज़ा।” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />येशुले नकाङजन आगिन्वाङ, “नैताहकन दाऊदले परमेस्वरलं आत्माङन प्रेरना डोएस्यु नकाजन कैलेस्यु प्रभु ऐलेस्यु पुकारिऊ? ओले ऐलेऊ, <verse eid="MAT 22:43" /><verse number="44" style="v" sid="MAT 22:44" />‘परमप्रभुले ङा प्रभुजन ऐआढोव, नङ ङा दाइन्या कुईङन चुङनते, जब समन ङा न शत्तुरयाङजन नखङ बाङल माजातङर।’”<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजनसङ्ग्रह ११०:१</ref></char></note> <verse eid="MAT 22:44" /><verse number="45" style="v" sid="MAT 22:45" />यदि दाऊदले ओजन प्रभु ऐढोवकन, नका कैलेस्यु ओलं ज़ा ताहौ वन? <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />तर काङ्काईले त आखर छ्योङौ रांमाढुदुऊ। ओ छिम्कन काङ्काईले ओलजन गिनन्या रामाआन्तिदुऊ।<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">ब्यबस्थाला शास्त्रीयाङ सनर फरिसीयाङजन चेताउनी</para>
  <para style="r">
    <ref loc="MRK 12:38-40">मर्कुस १२:३८-४०</ref>; <ref loc="LUK 11:39-52">लूका ११:३९-५२</ref>; <ref loc="LUK 20:45-47">२०:४५-४७</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />तब येशुले रुयाङल हुलजन सनर आ सिइयाङजन ऐआढोवाङ, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“ब्यबस्थाला शास्त्रीयाङ सनर फरिसीयाङ मोशाल पोत चुङरा। <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />तर जे ध्यानसं लेच्यो, नकाङ रापानन्या छेन ध्यानसं थएच्यो, तर नकाङै राढान्यामन ताइन्या काम ताढोच्यो, दानाङभन्या नकाङै अर्थ ता ऐयोरा, तर रा: जिबनल नका अनुसार माढोरदी। <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />नकाङै ब्यबस्था नियामल यिईन्या सनर वुरौ जै माढुदुसिन्या वुर पोअस्यु रुयाङल येपत नाएस्योरा। तर राकने ना तोलोअ कुईसैले बै छेन्ङालेस्यु माछुरडी।” <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />“तर नकाङै सोगल काम रुयाङजन थनौ नाल्ट ढोरा। दानाङभन्या नकाङ रा: चान्दा सनर नारीत ब्यबस्था-पत्र जनै घिन्या जाएरा, ओटन रा: क्वाल झुम्काङ सल्होएरा,<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">मत्ती ६:१</ref>; <ref loc="DEU 6:8">ब्यबस्था ६:८</ref>; <ref loc="NUM 15:38">गन्ती १५:३८</ref></char></note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />भोसजिऊलं चान्या सम्मान डोएन्या पो सनर आराधना झिमजिऊल मुख्या पदयाङ निज्युरा, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />नकाङ रुयाङै बजार जिऊल गुरु राढान्या सनर जडौ राढान्या निज्युरा।” <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />“तर जेजन काङ्काईले ‘गुरुज्यू’ ताढाचिऊत्या, दानाङभन्या जे गुरु तोलोअजाई लेया, ओटन जे सोगलै दाज्यूभाईयाङ हो। <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />जे पिरथ्बील काङ्काईजन गे बौ ऐताढोच्यो, दानाङभन्या स्वर्गल जे बौ तोलोअजाई लेया। <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />जेजन काङ्काईले ‘गुरुज्यू’ ताढाचिऊत्या, दानाङभन्या जे तोलोअ याएजै गुरु ख्रीस्ट हो। <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />जेमध्य जो सोगलैतन घिन्या ले, ना जे सेवाऱ्या ताइन्यालेया।<note caller="-" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">मत्ती २०:२६-२७</ref>; <ref loc="MRK 9:35">मर्कुस ९:३५</ref>; <ref loc="MRK 10:43-44">१०:४३-४४</ref>; <ref loc="LUK 22:26">लूका २२:२६</ref></char></note> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />जोले ओलझन्ज घिन्या जाटौ, ना इङन्या जाएसिया, ओटन जोले ओलजन सइङौ, नकाजन घिन्या जाएन्यालेसिया।”<note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">लूका १४:११</ref>; <ref loc="LUK 18:18">१८:१८</ref></char></note><verse eid="MAT 23:12" /></para>
  <para style="s">येशुले नकाङल कपट आमानिजिउ</para>
  <para style="r">
    <ref loc="MRK 12:40">मर्कुस १२:४०</ref>; <ref loc="LUK 11:39">लूका ११:३९</ref>,<ref loc="LUK 11:44-52">४४-५२</ref>; <ref loc="LUK 20:47">२०:४७</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“ऐ घुर्बीयाङ, शास्त्रीयाङ सनर फरिसीयाङ आक्याई! दानाङभन्या जे रुयाङलं सामन्दी स्वर्गला राज्यलं झलाप बन्द जेजाएचिऊ। न त जे पसिच्यो, न पसिऊ रोअन्याङजन रूफ्स्योचिरा।” <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />“ऐ घुर्बीयाङ, शास्त्रीयाङ सनर फरिसीयाङ, जे आक्याई! दानाङभन्या जे बिदवाङल झिमबन ज्योस्योचिरा, ओटन ल्होन्या-ल्होन्या प्रार्थना ढाऔ जाएसिच्या। नैताइस्यु जे अपुऱ्याङतन भ्याई सजाई डोएन्यालेच्या।”<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“ऐ घुर्बीयाङ, जे शास्त्रीयाङ सनर फरिसीयाङ, जे आक्याई! दानाङभन्या जे तोलोअजन जे पक्छेल होन्ङालेस्यु समुन्दर सनर नाम भरि चाहारच्या, ओटन नका जे सल्लात रायापाइना नकाजन नरगल जेतन डबल सजाय डोएन्या लायकला जाएच्या।” <verse eid="MAT 23:15" /><verse number="16" style="v" sid="MAT 23:16" />“आक्याई अन्ढला अगवाङ, जे ऐलेच्या ‘काङ्काङै मन्दिरलं किऱ्या ज्योरकन कैज माताइदी, तर मन्दिरला सुनल किऱ्या ज्योरकन ना बाचाले पोअन्यालेया।’” <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />“मुर्ख सनर अन्ढलाङ, काङ्कावाला घिऊ? सुन सन् सुनजन पबित्र जाएन्या मन्दिर? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />‘यदि काङ्काङै बेदील किऱ्या रांज्योवक कैइज माताइरदी, तर नकायर्त नाएसिन्या भिटीलं किऱ्या रांज्योवक बाचाले पोअसिरा ऐलेच्योकन।’” <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />ऐ अन्ढलाङ, काङ्कावाला घिऊ? भिटी सन् भिटीजन पबित्र जाएन्या बेदी? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />नैताइस्यु बेदील किऱ्या ज्यान्याले बेदील सनर नालयर्ता सोगलै जन्तुल किऱ्या ज्योवा। <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />मन्दिरलं किऱ्या ज्यान्याले मन्दिर सनर नाभितरल चुङन्या परमेस्वरलं किऱ्या ज्योवा। <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />स्वर्गल किऱ्या ज्यान्याले सिहासनल यर्त बिराजमान ताइन्या परमेस्वरलं किऱ्या ज्योवा।<note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">यशैया ६६:१</ref>; <ref loc="MAT 5:34">मत्ती ५:३४</ref></char></note> <verse eid="MAT 23:22" /><verse number="23" style="v" sid="MAT 23:23" />“ऐ घुर्बी, शास्त्रीयाङ सनर फरिसीयाङ, जे आक्याई! दानाङभन्या जे बासमटी सनर स्वोप ओटन जीराल दसाम्स योंच्या, तर ब्यबस्थाला गम्भिर छेनल बारेल, अथाबा निया, सनर दया ओटन बिस्वासलं हेलचार ढास्युलेच्या। जे दसाम्स यांन्या काम ढाऔपरिन्या हो, ओटन ना घटलागिन्या छेनजन हेलचार माढाऔ परिन्या हो।<note caller="-" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">लेवी २७:३०</ref></char></note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />अन्ढला अगवाङ, जे भुसना छेलच्या, तर ऊटजन व्आलच्या।”<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“ऐ घुर्बी, शास्त्रीयाङ सनर फरिसीयाङ, जे आक्याई! दानाङभन्या जे कटौरा सनर थालल बाहेरङन सिलच्या, तर भितरङन कने ना लोब सनर छलकपटले भरिसिन्या ताइच्या। <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />ऐ अन्ढला फरिसीयाङ, पैला कटौरा सनर थालल भितरङन सफा ढोचिते, ओटन नकाल बाहेरङन बै सफा जाएचिते।”<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“ऐ घुर्बी, शास्त्रीयाङ सनर फरिसीयाङ, जे आक्याई! दानाङभन्या जे ऱ्हाएले सेप्सिन्या ऊईयाङ मनताइन्या लेच्या, जो बाहेरङनकने चान्या रंनरा, तर भितरङनकने सिन्या रुयाङल रूईयाङ सनर सोगल किसिमला स्युउनमले भरिसिन्या लेच्या।”<note caller="-" style="x"><char style="xo" closed="false">23:27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">प्रेरित २३:३</ref></char></note> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />जे बै नामन्जै बाहेरङन कने रुयाङल हाल धर्मि रंनच्या, तर भितरङन कपट सनर पापले भरिसिन्या लेच्या।<verse eid="MAT 23:28" /></para>
  <para style="s">येशुले नकाङल सजाईल भबिस्यबानी आढान्या</para>
  <para style="r">
    <ref loc="LUK 11:47-51">लूका ११:४७-५१</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“ऐ घुर्बी, शास्त्रीयाङ सनर फरिसीयाङ, आक्याई जे! दानाङभन्या जे अगमबक्ताङल ऊईयाङ जाएच्या, ओटन सोझाङल पाछाअजन सजाईच्या, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />ओटन जे ऐलेच्या, ‘गे पुर्खाङ बेलाक गेलन्याताहकन ता गे अगमबक्ताङल जी बगाहौक ओयाङसं सामेल माताहै होला।’” <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />नैताइस्यु जे अगमबक्ताङल हत्या ढान्याङलै सन्तानयाङ ज्या ऐलेन्या जेईज बयन यांज्याच्या। <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />जे पुर्खाङै राढान्या काम पुरा ढोचिते। <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />“ऐ डाङयाङ सनर डाङल पुङयाङ, जे नरगला सजायतन कढाई बचिच्यो?<note caller="-" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्ती ३:७</ref>; <ref loc="MAT 12:34">१२:३४</ref>; <ref loc="LUK 3:7">लूका ३:७</ref></char></note> <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />नैताइस्यु ङा जेल्योङ अगमबक्ताङ, सनर बुद्दिमान रुयाङ ओटन शास्त्रीयाङ परिङ्ङरा। नकाङ मध्य ख्वाएजन सएन्यालेच्या ओटन क्रूसतं केपन्यालेच्या, ओटन ख्वाए याङजन जेमि बैठअझिम कोर्ला लाइचिरा, ओटन सहर-सहर जिऊल सटाइचिरा। <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />पिरथ्बील बगाइसिन्या स्वाट्टै सोझाजन्ताल जी-निर्दोस हाबिलल जी तन रएस्यु बेरेक्याहल ल्हेपाज़ा जकरियाल जी समन, जोजन जे मन्दिर अथाबा बेदील खार्ल जेसएचिऊ, ना दोस जे ङएटै परिन्या लेया।<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">उत्पत्ति ४:८</ref>; <ref loc="2CH 24:20-21">२इतिहास २४:२०-२१</ref></char></note> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />ङा मछ्युजै, जेजन ऐढाच्या, ईका स्वाट्टै छेन ईका बेलाका पुस्ता यर्त परिरान्या लेया।<verse eid="MAT 23:36" /></para>
  <para style="s">यरुशलेमत येशुल प्रेम</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“ऐ, यरुशलेम, ऐ, यरुशलेम, नङ अगमबक्ताङजन सतनरा ओटन परमेस्वरले नङजन आपरिङसिन्या दुतयाङजन लुङले तुपनरा! जोमनलेस्यु बामाअले आबाचिपयाङजन आकरनीउल दुकौर, ओमनलेस्यु ङा बै तबर पाला न लुलल्याङजन दुउन्या इच्छ्या ङाढोङु, तर नङ माभन्दुना। <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />खिम्चिते, जे झिम धाङ्गिल बनाएन्या लेसिया।<note caller="-" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="JER 22:5">यर्मिया २२:५</ref></char></note> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />दानाङभन्या ङा जेजन ऐढाच्या, ‘परमप्रभुल मिनतन रांन्या धन्याला ज्या’ जेमालेऊ समन जे ङाजन रङन्या माल्चिदी।”<note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">भजनसङ्ग्रह ११८:२६</ref></char></note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">येशुले आराधनाल बिनाशल भबिस्यबानी आढान्या</para>
  <para style="r">
    <ref loc="MRK 13:1-37">मर्कुस १३:१-३७</ref>; <ref loc="LUK 21:5-38">लूका २१:५-३८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />ओलं छिन्ट येशु मन्दिरलन पलिईस्यु आहिनज्याऔक आसिइयाङै ओलजन आराधना झिमयाङ थनस्यान्या लेस्यु आनेराक रांवाङ। <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />तर “ओले नकाङजन ऐआढोवाङ, ‘जे ईका सोगल ऐरङच्या, माङ का?’ ङा जेजन मछ्यु ऐढाच्या, इलं तोलोअ लुङयर्त छुट्टै लुङ लिज्यान्या माल्दी, सोगलै थाएस्यु क्याइन्यालेसिया।”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />येशु जैतुन डान्डाल आचुङज्याऔक आ सिइयाङ रांबाठए आल्योङ रा:स्यु रांगिनौ, “गेजन पानस्यासिन्ते, आका छेन खक ताइङालिज्याऔ, ओटन न आगमन सनर आका जुगल आसापटा चिन्न नैति ताहौ होला?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />तब येशुले नकाङजन जबाक आयोवाङ, “होसियार ताइचिते, काङ्काङै जेजन भरमल ताप्‌राइचिरत्या। <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />दानाङभन्या तबर जना ङा मिनतन ‘ङा ख्रीस्ट ज्या’ ऐलेस्यु रांन्यालेरा, ओटन तबर झन बहकाइन्या लेरा। <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />जे नेराल खप्सिन्याङ सनर लोएङ खप्सिन्याङलं हल्ला थएन्यालेच्या। तर ताछ्याएच्यो, दानाङभन्या ईका ताइन्या आबस्यक जै लेया, तर नवाए बेलाकै खेमन्या माल्दी। <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />दानाङभन्या जातिल बिरोदत जाति, ओटन राज्यल बिरोदत राज्य च्याङन्या लेया, ओटन पोइ-पोइल अनिकाल सनर भुईचाल रांन्यालेया। <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />तर ईका ता सोगल जत्कालल सुरु याएज ज्या।”<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />तब नकाङै जेजन सज्युन्यालेचिरा ओटन सङ्कस्टल नाल्ट सुम्पिचिरा, ओटन ओटन ङा मिनल कारनले सोगलै जातियाङै सएन्यालेचिरा।<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ती १०:२२</ref></char></note> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />नवाए बेला तबरले रा: बिस्वास राइस्यु तोलोअले तोलोअजन धोखा यांन्या लेरा ओटन रारांल सज्युसिरा। <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />तबर ग्वारवा अगमबक्ताङ च्याङन्या लेरा, ओटन तबर रुयाङजन बहकाइन्या लेरा। <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />छलकपट आबदिऊ कारनले तबरल प्रेम सेलाइन्यालेया <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />तर छिन्ट समन तनस्यु लिज्यान्याजन बचाइन्या लेसिया।<note caller="-" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ती १०:२२</ref></char></note> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />ओटन राज्यल ईका चान्याथाई सोगल सङ्सारला सोगलै जातियाङल साचील नाल्ट प्रचार ढान्या लेसिया, नकाल छिन्ट खेमन्यालेया।<verse eid="MAT 24:14" /></para>
  <para style="s">हिपहिपलागिन्या</para>
  <para style="r">
    <ref loc="MRK 13:14-23">मर्कुस १३:१४-२३</ref>; <ref loc="LUK 21:20-24">लूका २१:२०-२४</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />नैताइस्यु जब जे दानिएल अगमबक्ताङन छ्योङसिन्या बिनाशकारी सज्युसिन्या जन्तुजन पबित्र पोल आच्याङज्यान्या रङच्या जोल बारेल दानिएल अगमबक्ताले आपानौ (जोले परी नकाले ग्याबुजिऊत्या),<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानियल ९:२७</ref>; <ref loc="DAN 11:31">११:३१</ref>; <ref loc="DAN 12:11">१२:११</ref></char></note> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />तब यहूदियाल लिज्यान्याङ डान्डा देए ग्याढोङरत्या। <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />झिमल मैराअत लिज्यान्याङ समान पलिटौ नाल्ट वान्ल तालाइरत्या।<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लूका १७:३१</ref></char></note> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />जोयाङ खेएल लिज्यार ओयाङ वलस्यु रा: खाइटो ताचिनरांरत्या। <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />थयहय! नका दिनल ख्वाए छ्याइलागिया गुरभ्यानियाङ, सनर नुन ओइज्यान्याङजन। <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />तर हिउदाक या शबाथ छिम्क जे ढोङन्या ताटाइत्या ऐलेस्यु परमेस्वरसं प्रार्थना ढोचिते। <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />दानाङभन्या नका बेला ऐटाइन्या माहासङ्कस्ट ताइन्यालेया, जो जगतल सुरुकन आकअ समन ताइस्यु माल्दी, न त फरि खकै ताइन्या ले।<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="DAN 12:1">दानियल १२:१</ref>; <ref loc="REV 7:14">प्रकाश ७:१४</ref></char></note> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />यदि नका दिन परमेस्वरले माघटाइसिन्या ताहकन काङ्काई रु माबानचिन्या लेवाङ, तर छेल्सिन्याङलं नाल्ट ना दिन घटाइन्या लेसिया। <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />“तब नवाए बेला जेजन काङ्काङै ‘खिम्चिते, ख्रीस्ट इङ लिज्याऔ, या नङं लिज्याऔ’ ऐलेरकन बिस्वास ताढोच्यो। <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />दानाङभन्या ग्वारवा बिस्वासीयाङ, सनर ग्वारवा अगमबक्ताङ च्याङन्या लेरा, ओटन राढुदुउ समन छेल्सिन्याङजन बै बहकाहौ नाल्ट बडा-बडा अचम्मला कामयाङ ढास्यु थनन्यालेरा। <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />यांका नाएच्यो, नैताइस्यु थएचिते ङा जेजन हाकन्जै पानस्याज्याच्या।”<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />“यदि नकाङै जेजन ‘खिम्चिते, नका हरहरताइन्या-पोल लिज्याया’ ऐलेरकन बाहेरल पलिईस्यु ताहिनच्यो। ओटन ‘ब्याएचिते, ओ भितरलं कोठाल मोअसिस्यु लिज्याऔ’ ऐलेरकन बै बिस्वास ताढोच्यो।”<note caller="-" style="x"><char style="xo" closed="false">24:26 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">लूका १७:२३-२४</ref></char></note> <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />दानाङभन्या जोमनलेस्यु पुर्बङन बिजौलि चम्किस्यु पछिम समनजै रंनन्या ताह, रुल ज़ाल आगमन ओमनलेस्युई जै ताइन्यालेया। <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />दानाङभन्या जोल सिना लिज्या, गिद्दयाङ बै ओलै दुउसिरा।<note caller="-" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">लूका १७:३७</ref></char></note><verse eid="MAT 24:28" /></para>
  <para style="s">रुल ज़ाल आगमन</para>
  <para style="r">
    <ref loc="MRK 13:24-27">मर्कुस १३:२४-२७</ref>; <ref loc="LUK 21:25-28">लूका २१:२५-२८</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />नका दुखला दिनल छिन्ठक्कै, नम्युउ चिऊन्या लेया, ओटन ह्यावए होएन्या माल्दी, सनर हरवएयाङ नमतन तेइन्यालेरा, अथाबा नमता सक्तियाङ हल्लाइन्या लेसिया।<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">यशैया १३:१०</ref>; <ref loc="ISA 34:4">३४:४</ref>; <ref loc="JOL 2:10-31">योएल २:१०-३१</ref>; <ref loc="JOL 3:15">३:१५</ref>; <ref loc="EZK 32:7">इजकिएल ३२:७</ref>; <ref loc="REV 6:12-13">प्रकाश ६:१२-१३</ref> </char></note> <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />तब ओवाए बेला रुल ज़ाल चिन्न नमत रंनन्या लेया, ओटन पिरथ्बीला सोगल जातियाङ व्‌रन्या चिचच्याइन्या लेरा, ओटन नकाङै रुल ज़ाजन नमता बादलसकाए सक्ति ओटन घिन्या महिमासकाए आरांज्यान्या रङन्या लेरा।<note caller="-" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानियल ७:१३</ref>; <ref loc="ZEC 12:10-14">जकरिया १२:१०-१४</ref>; <ref loc="REV 1:7">प्रकाश १:७</ref></char></note> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />ओले आमि स्वर्गदुतयाङजन तुरहील घिन्या ग़ा सकाए परिङौरा, ओटन नकाङै नमल तवङ्ङन छुट्टै वङ समन चारै दिसाङन ओले आछेलन्याङजन दुउन्या लेरा।<verse eid="MAT 24:31" /></para>
  <para style="s">ड्यूल टुङतन ह्युउसिन्या</para>
  <para style="r">
    <ref loc="MRK 13:28-31">मर्कुस १३:२८-३१</ref>; <ref loc="LUK 21:29-33">लूका २१:२९-३३</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“तर ड्यूल टुङतन तोलोअ सिक्छ्या ह्युउसिचिते, जब नकाल हाङ्गाङ पिङपिङ सनर नारनार ताइर, ओटन टुङले ल्हापटा फेरिऊ, तब जे घाम साहा राढारैस लेस्यु सनच्या। <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />ओटन जब जे ईका स्वाट्टै छेन आताइरान्या रङच्यो, तब ओ बेला झलाप नेराकै लिज्याया ऐलेस्यु सन्चिते। <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />ङा जेजन मछ्यु ऐढाच्या, कि जब समन ईका सोगलै पुरा माताह, ना बेला समन ईका पुस्तालं अन्त ताइन्यामाल्दी। <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />स्वर्ग सनर पिरथ्बी टलिस्यु हिना, तर ङा बचन खकै टलिस्यु हिनन्यामाल्दी।”<verse eid="MAT 24:35" /></para>
  <para style="s">नका दिनला समाय काङ्काईले मासनौदी</para>
  <para style="r">
    <ref loc="MRK 13:32-37">मर्कुस १३:३२-३७</ref>; <ref loc="LUK 17:26-30">लूका १७:२६-३०</ref>,<ref loc="LUK 17:34-36">३४-३६</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“तर नका दिन सनर नका बेलाल बारेल न त स्वर्गला दुतयाङै, न ज़ाले तर परमेस्वर बौले बाहेक काङ्काईले मासनौदी। <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />रुल ज़ाल आगमन नोआल दिनमन जै ताइन्यालेया।<note caller="-" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">उत्पत्ति ६:५-८</ref></char></note> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />दानाङभन्या जोमनलेस्यु जलप्रलय हादेए नोआ जहास भितरलं आपसिन्या दिन समन, रुयाङ रांज्याज्यान्या, रांओज्यान्या सनर ब्याहाभोस ढाज्यावाङ, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />ओटन जलप्रलय रा:स्यु स्वाट्टैजन बगाइस्यु आमालाङौ समन नकाङ रा:मासनौ। नामन्जै रुल ज़ाल आगमन बै नैज ताइन्यालेया।<note caller="-" style="x"><char style="xo" closed="false">24:39 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">उत्पत्ति ७:६-२४</ref></char></note> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />नका बेला नेंलोअ खेएल काम नेंढाज्याऔक, तोलोअजन लाङन्यालेसिया, ओटन छुट्टैजन बनाएन्यालेसिया। <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />नेंलोअ मेएमाने चाखी नेंहेएज्यान्या ताहा, ओटन तोलोअजन लाङन्यालेसिया, छुट्टैजन बनाएन्यालेसिया।”<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />“नैताइस्यु सनसिस्यु लिज्याच्यो, दानाङभन्या खकाछिम जे प्रभु रांङालिज्याऔ, ना जे मासन्चिदी। <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />तर आका सनच्यो, कि झिमल खसमले गोए रिउल ईका बेला रांया ऐलेस्यु आसन्न्या ताहकन, सनर ना आसन्सिज्यान्या ताहकन आझिम पाकौ मायोव होला।<note caller="-" style="x"><char style="xo" closed="false">24:43 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">लूका १२:३९-४०</ref></char></note> <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />नैताइस्यु जे बै तयार लिज्याच्यो, दानाङभन्या रुल ज़ा मायिङसिन्या बेला रांन्यालेया।<verse eid="MAT 24:44" /></para>
  <para style="s">बिस्वासी सनर अबिस्वासी नोक्कर</para>
  <para style="r">
    <ref loc="LUK 12:41-48">लूका १२:४१-४८</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“बुद्दिमान बिस्वासी नोक्कर काङ्का लेऊ, जोजन नकाल साहूले अपुर आनोक्करयाङजन ठिक-ठिक समायत ज्यान्या योंवर ऐलेस्यु आपरिमौ? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />नका नोक्कर बअचान्या हो, जो साहू आरांऔक इमानदारसं काम आढाज्यान्या डोएरिइवा। <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />ङा जेजन मछ्यु ऐढाच्या, साहूले नकाजन आमि इमानदारीले गर्दा स्वाट्टै सम्पतियर्त जिम्मा यांन्या लेया। <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />तर यदि नका दुस्ट नोक्करले ‘ङा साहू ढिलो रांया’ ऐलेन्या आयिङल यिङस्यु, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />ओटन मंङवाङ सकाए ज्यास्यु ओस्यु सनर ओलसं काम ढान्या नोक्करयाङजन टुपन्या ढोदाभन्या, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />ना नोक्करल साहू तयोअ आमायिङन्या दिन छिम्क रांया ऐलेस्यु नकाले मासनज्यादी। <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />ओटन साहूले नकाजन घिन्या सजायल नाल्ट घुर्बीयाङल खार्ल क्याइसिया, जोल रुयाङ व्‌रन्यालेरा ओटन ह्वा ज़िङ कैन्यालेरा।”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">दस कनन्याङलं आहान</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“नका बेला स्वर्गला राज्य दस कनन्याङस दान्जिऊ दुदुसिया। नकाङै अपङ्गी रा: बत्ति होनस्यु दुलाहासं डोएसिया लेस्यु पलिइवाङ।<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">लूका १२:३५</ref></char></note> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />नकाङ मध्य पास गोटाङ निर्बुद्दि सनर पास गोटाङ बुद्दिमती लेवाङ। <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />दानाङभन्या जब निर्बुद्दियाङै रा: बत्ति ता रालाङौ, तर नकाङै रा:सामा तीइ मालाङदुरा। <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />तर बुद्दिमतीयाङै रा: बत्ति सकाए तीइल जा बै रालाङौ। <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />दुलाहाले ढिलो आढाऔक नकाङ सोगलै मिऊरुइले लठ्ठै ताइस्यु म्वाईवाङ।” <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />“तर आधारिउल ‘खिम्चिते दुलाहासं डोएसिराचिते ऐलेन्या ग़ा थहौ’।”<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />“तब नका सोगलै कनन्याङ सोवाङ, ओटन अपङ्गी रा: बत्ति रादुउज्याऔक। <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />निर्बुद्दि कनन्याङै बुद्दिमतीयाङजन ऐराढोव, ‘गेजन तचिठक्क जे तीइ यांसिन्ते, दानाङभन्या गे बत्ति ता सिङाई लेदा।’” <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />“तर बुद्दिमतीयाङै बुद्दिमतीयाङजन ऐराढोव, ‘गे सनर झेन नेंलोअजन योअन्यायाए तीइ माल्दी, बरु दोकानदाऱ्या ल्योङ हिन्चिते ओटन जे नाल्ट लङचिते।’” <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />नैताइस्यु मुर्खयाङ तीइ लङनावाङ जब नकाङ हिन्वाङ दुलाहा ताप्‌रा:औ, पास गोटा दुउसिस्यु लिज्यान्याङ ओलसं भितरला ब्याहा भोसलं पसिवाङ तब झलाप रूफ्सिऊ।<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />“छिन्ट ना अपुर कनन्याङ ढिलो रांवाङ ओटन ऐलेऊ तअसिवाङ, ‘प्रभु, प्रभु, गे पसिया झलाप फएस्यासिन्ते!’<note caller="-" style="x"><char style="xo" closed="false">25:11 </char><char style="xt" closed="false"><ref loc="LUK 13:25">लूका १३:२५</ref></char></note> <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />तर नकाले जबाक यांस्यु ऐआढोवाङ, ‘मछ्यु ङा, जेजन ऐढाच्या, कि ङा जेजन माशईचिदी।’” <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />“नैताइस्यु येशुले ऐलेऊ सन्सिस्यु लिज्याचिते, दानाङभन्या ना दिन सनर ना बेला ख्वाए बेला रा: जे मासन्चिदी।”<verse eid="MAT 25:13" /></para>
  <para style="s">तिनगोटा सेबकयाङल आहान</para>
  <para style="r">
    <ref loc="LUK 19:11-27">लूका १९:११-२७</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />नका बेला “स्वर्ग राज्य ऐटाइन्या लेया, तोलोअ रु जोले परदेस हिन्ङाआल्यौक आनोक्करयाङजन खुल्स्यु आधन-पैसालं जिम्मा आयोवाङ।<note caller="-" style="x"><char style="xo" closed="false">25:14 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">लूका १९:११-२७</ref></char></note> <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />ओले नकाङजन रांमि छेमता अनुसार तोलोअजन पास हजार सुनल सिक्का, छुट्टैजन नें हजार सुनल सिक्का ओटन छुट्टैजन त हजार सुनल सिक्का यांनिइस्यु ओल परदेस देए हिनौ।” <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />तब पास सुनल सिक्का लाङन्याले हटपट हिनस्यु नकाले ब्यापार ढास्यु अपुर पास गोटा सिक्का आकमाहौ। <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />नैलेस्युई नेंलोअ सिक्का लाङन्याले बै अपुर नेंलोअ आकमाहौ। <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />तर तोलोअ सिक्का लाङन्याले हिनस्यु नामल वोस्यु आ साहूल धन मोअस्यु आनाटौ।<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“तबर समाय छिन्ट ना नोक्करयाङल साहू रांऔ, ओटन नकाङसं हिसाप नीऊ। <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />तब पास सुनल सिक्का लाङन्या नोक्करले अपुर पास हजार सिक्का होनस्यु आहाक रा:स्यु ऐआढोव, ‘साहू ज्यू, नङ ङाजन पास हजार सिक्काल जिम्मा नयांङनु। खिम्तेवन, ङा अपुर पास हजार सिक्का ङाकमाइङु।’” <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />“साहूले नकाजन ऐआढोव, ‘स्याबास, चान्या सनर बिस्वास लायकला नोक्कर! नङ तचिइठक्क छेनत बिस्वास लायकला नताइनु, आब ङा नङजन तबर छेनल जिम्मा यांना। नङ नसाहूलं आनन्दत सहभागि ताहन्ते।’” <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />“नें हजार सिक्का लाङन्याले बै रा:स्यु ऐलेऊ, ‘साहू ज्यू, नङ ङाजन नें हजार सिक्का नयांङनु। ब्याएते, ङा अपुर नें हजार सिक्का ङाकमाइङु।’”<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />“नकाल साहूले नकाजन ऐआढोव, ‘स्याबास, चान्या सनर बिस्वास लायकला नोक्कर, नङ तचिइठक्क छेनत बिस्वास लायक नताइनु, आब ङा नङजन तबर छेनल जिम्मा यांना। नङ नसाहूलं आनन्दत सहभागि ताहन्ते।’” <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />“तोलोअ सुनल सिक्का लाङन्याले बै रा:स्यु ऐलेऊ, ‘साहू ज्यू, मावाइसिन्या येङलन खानन्या सनर माच्यापसिन्या पोलन दुउन्या नङ कठोर रु हो, ईका ङाजन थाहैलेऊ ज्या। <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />नैताइस्यु ङा ङाछ्याएङु, ओटन हिनस्यु न सिक्का ङा व्मजिङल मोअस्यु ङानाएङु। खिम्ते, न सिक्का।’” <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />“नकाल साहूले नकाजन जबाक आयोव, ‘ऐ घुर्बी, अल्सि नोक्कर, मावाइसिन्या पोलन खान्वा, ओटन माच्यापसिन्या पोलन दुउवा ऐलेस्यु नङ नसन्न्या ताहकन, <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />नङ ङा धन साहूल्योङ नाटौ परिन्या, ओटाहकन ङा रा:स्यु ङाधन ब्यास समेत होल्ङा होला। <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />नैताइस्यु नका ल्योङन नका तोलोअ सिक्का न्हानचिते, ओटन जोल्योङ दसगोटा सिक्का लिज्या ओजन योंचिते। <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />दानाङभन्या जोसकाए ले नकाजन अपुर बै यांन्यालेसिया, ओटन ओसकाए खाटखाट ताइन्यालेया। तर जोसकाए माले नका ल्योङन लिज्यान्या बै न्हानसिया।<note caller="-" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्ती १३:१२</ref>; <ref loc="MRK 4:25">मर्कुस ४:२५</ref>; <ref loc="LUK 8:18">लूका ८:१८</ref></char></note> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />नका बिकामी नोक्करजन बाहेरला चिऊन्याल क्याइचिते, जोल रुयाङ व्‌रन्यालेरा ओटन ह्वा ज़िङ कैन्यालेरा।’”<note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्ती ८:१२</ref>; <ref loc="MAT 22:13">२२:१३</ref>; <ref loc="LUK 13:28">लूका १३:२८</ref></char></note><verse eid="MAT 25:30" /></para>
  <para style="s">आखिरी निया</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“जब रुल ज़ा सोगलै स्वर्गदुतयाङ सकाए आमहिमात रा:, तब ओ आमहिमामय सिहासनत चुङन्या लेया।<note caller="-" style="x"><char style="xo" closed="false">25:31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">मत्ती १६:२७</ref>; <ref loc="MAT 19:28">१९:२८</ref></char></note> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />ओटन ओलं सामन्दी पिरथ्बीला सोगल रुयाङ दुउसिन्या लेरा, ओटन जोमनलेस्यु ग्वालाले भेडा सनर बाख्राजन छुटाहौ, ओमनलेस्युजै ओले नकाङजन तोलोअजन छुट्टैतन अलक जाएन्यालेया। <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />ओले भेडाङजन आदाइन्या देए सनर बाख्राङजन दाबऱ्या देए नाएन्या लेया।”<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />“तब रयले आदाइन्या देएङाङजन ऐढान्या लेया, ‘रांचिते, ङा बौ बअचान्या हो! सङ्सारलं उत्पटीतन जे नाल्ट तयार जाएसिन्या राज्यजन अढिकार ढोचिते। <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />दानाङभन्या ङा ङाकरेऊक, जे ङाजन ज्यान्या जेयाङचिऊ। ङा री ङाओहौक जे ङाजन री ओव जेयाङचिऊ। ङा परदेसी ङाल्ङु, जे ङाजन बाई जेयाङचिऊ।<note caller="-" style="x"><char style="xo" closed="false">25:35 </char><char style="xt" closed="false"><ref loc="LEV 7:32-36">लेवी ७:३२-३६</ref></char></note> <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />जब बिनाक्वा ङाल्ङु, जे ङाजन क्वा जेक्वाटङचिऊ। नाएबोरस्यु ङाल्ङु, जे ङाजन जेखिमराङचिऊ। कैदल ङालेङु, जे ङाल्योङ जेरांचिऊ।’” <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />“तब धर्मियाङै ओलजन जबाक यांन्या लेरा, ‘औ प्रभु, खक गे नङजन नकरेन्या गेरङसिनु, ओटन ज्यान्या गेया:सिनु? अथाबा नओइन्या गेरङसिनु, ओटन ओव गेया:सिनु? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />खक गे नङजन परदेसी गेरङसिनु, ओटन नङजन गेझिमल बाई गेया:सिनु? अथाबा बिनाक्वा गेरङसिनु ओटन क्वा गेक्वाएसिनु? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />ओटन खक गे नङजन ननाएबोरन्या अथाबा कैदी गेरङसिनु, ओटन नल्योङ गेडोएसिरायिउ?’”<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />“तब रयले नकाङजन जबाक आयोवाङ, ‘ङा मछ्यु, जेजन ऐढाच्या, जे आका ङा भाईयाङ मध्य सोगलैभन्या इङन्याङतन तोलोअजन ज्वाए सम्भार जेढोचिऊ, ना जे ङाजन जै जेढाङन्या हो।’”<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“नकाल छिन्ट ओले दाबऱ्याङनता रुयाङजन ऐढोरा, ‘सरापित रुयाङ! ङातन लोए ताइचिते, ओटन दियाबलस सनर नाल दुतयाङल नाल्ट तयार जाएसिन्या अनन्तल मील हिन्चिते। <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />दानाङभन्या ङा करेस्यु ङाल्ङु, जे ङाजन ज्यान्या मायांदुङच्या। री ओइस्यु ङाल्ङु, जे ङाजन री ओव जेमायाङचिऊ। <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />ङा परदेसी ङालेङु, जे झिमल ङाजन बाई मायांदुङच्या। बिनाक्वा ङाल्ङु ओटन जे ङाजन क्वा माक्वाएदुङच्या, ङानाए बोरस्यु कैदल ङालज्याऔक जे ङाजन माखिमरादुङच्या।’”<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />“नकाङ बै ऐलेस्यु जबाक यांन्या लेरा, ‘प्रभु, खक गे नङजन नकरेन्या सनर री नओइन्या गेरङसिनु, परदेसी सनर बिनाक्वा अथाबा नाएबोरन्या गेरङसिनु, अथाबा कैदल गेरङसिनु, ओटन न सेवा गेमाढोयिउ?’” <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />“तब ओले नकाङजन जबाक यांन्या लेया, ‘ङा मछ्यु, जेजन ऐढाच्या, आका सोगलैतन इङन्याङ मध्य तोलोअजन ज्वाए जे सम्भार जेमाढोचिऊ, ना ङाजन जेमाढाङचिऊ हो।’” <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />“तब इकाङ अनन्त सजाईल भागेदार ताइन्यालेरा, तर धर्मियाङ अनन्त जिबनल पसिन्या लेरा।”<note caller="-" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">दानियल १२:२</ref></char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">येशुल बिरोदत सड्यन्त्र</para>
  <para style="r">
    <ref loc="MRK 14:1-2">मर्कुस १४:१-२</ref>; <ref loc="LUK 22:1-2">लूका २२:१-२</ref>; <ref loc="JHN 11:45-53">यहुन्ना ११:४५-५३</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />येशुले ईका सोगलै छेन आपानस्याऔ छिन्ट आ सिइयाङजन ऐआढोवाङ, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“जे ऐसनच्या, आबका नेंयोअ छिन्ट निस्तार<note caller="+" style="f"><char style="fr" closed="false">26:2 </char><char style="ft" closed="false">(उनध्यालि-उभ्याली) =निस्तार पर्ब मोशाले मिस्र देसङन इस्राएलीयाङजन स्वर्गदुत जेजन बिपत्तितन ग्याबचाइचिरत्या</char></note>-पर्ब रांन्यालेया, ओटन रुल ज़ा क्रूसतं केप्सिऊ नाल्ट कोलोअसिन्यालेया।”<note caller="-" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">प्रस्थान १२:१-२७</ref></char></note> <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />तब कैयाफा मिनला प्रधान पुजाउरोल दरबारल मुख्या पुजाउरोयाङ सनर सेरयाङ दुउसिवाङ। <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />ओटन नकाङै येशुजन कढाई झुकाइस्यु कोलोअस्यु सएन्या सल्ला रांढोव। <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />तर नकाङै ऐलेवाङ, “पर्बल बेलाक सएन्यामाङदी। मानकन्ता रुयाङल खैलाबैला ऐताह।”<verse eid="MAT 26:5" /></para>
  <para style="s">येशुले बेथानियाल अबिसेकलं तीइ ङएल आठिइन्या</para>
  <para style="r">
    <ref loc="MRK 14:3-9">मर्कुस १४:३-९</ref>; <ref loc="JHN 12:1-8">यहुन्ना १२:१-८</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />येशु बेथानियाला सिमोन कुरील झिमल आलिज्याऔक, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />तोलोअ मेएमा<note caller="+" style="f"><char style="fr" closed="false">26:7 </char><char style="ft" closed="false">ईका मेएमा=लाजरसं सनर मार्थाल दिदी मरियम हो</char></note> सिङ्गमरमरल तोलोअ चुन्थिल<note caller="+" style="f"><char style="fr" closed="false">26:7 </char><char style="ft" closed="false">लुङल चुन्थि</char></note> बअकरन्या अत्तर होनस्यु येशु ल्योङ रांऔ, ओटन ओले ज्यान्यालेस्यु आचुङज्याऔक नकाले ना आङएल आटुईस्यौ।<note caller="-" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">लूका ७:३७-३८</ref></char></note> <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />ओटन ना रङस्यु सिइयाङ रायिङचोस्यु, ऐलेवाङ, “नैकाम आवाए खेर नजाएनु? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />दानाङभन्या ईका अत्तर भ्याई येएल यईन्या लेऊ इकाजन यएस्यु नका रुप्या गरिबयाङजन यांऔ दुदुसिया।”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />तर येशुले नका सनस्यु नकाङजन ऐआढोवाङ, “जे ईका मेएमाजन दानाङ दोस लाइज्याच्यो? इकाले ता ङा नाल्ट चान्या काम ढास्यु लेया। <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />दानाङभन्या गरिबयाङ ता जेसकाए दिनकाई लिज्यारा। तर ङा ता जेसकाए सदाई मालिज्याङदी।<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ब्यबस्था १५:११</ref></char></note> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />इकाले ङाकलाङल ईका अत्तर टुईस्यु रींनौ नाल्ट ङाजन तयार आजाएङु हो। <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />ङा जेजन मछ्यु ऐढाच्या, स्वाट्टै सङ्सारलं आका चान्याथाई जोङ प्रचार ढासी, ईका मेएमाले आढान्या काम नकाल यांकाल नाल्ट चर्चा ढान्यालेसिरा।”<verse eid="MAT 26:13" /></para>
  <para style="s">यहूदाले येशुजन धोखा आयांन्या</para>
  <para style="r">
    <ref loc="MRK 14:10-11">मर्कुस १४:१०-११</ref>; <ref loc="LUK 22:3-6">लूका २२:३-६</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />तब बारं गोटा सिइयाङ मध्य तोलोअ यहूदा इस्करियोत ऐढासिन्या मुख्या पुजाउरोयाङ ल्योङ हिनौ, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />ओटन नकाले ऐआढोवाङ, “यदि ङा येशुजन जे कुईत सकोलोकङकन, ङाजन नै यांङच्यो?” नकाङै ओलजन नका कामल नाल्ट चान्दील तिस सिक्का रांयोव।<note caller="-" style="x"><char style="xo" closed="false">26:15 </char><char style="xt" closed="false"><ref loc="ZEC 11:12">जकरिया ११:१२</ref></char></note> <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />नवाए बेलाकन यहूदाले येशुजन कोलोअन्या मौका रोंकौ तअसिऊ।<verse eid="MAT 26:16" /></para>
  <para style="s">येशुले आसिइयाङसं निस्तार भोस आज्यान्या</para>
  <para style="r">
    <ref loc="MRK 14:12-26">मर्कुस १४:१२-२६</ref>; <ref loc="LUK 22:7-23">लूका २२:७-२३</ref>; <ref loc="JHN 13:21-30">यहुन्ना १३:२१-३०</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />आब अखमिरी भरेईल पर्बल पैला दिन आसिइयाङै येशु ल्योङ रा:स्यु ऐलेवाङ, “न नाल्ट निस्तार-पर्बल भोस ज्यान्या बन्दबस्त गे काङ ढोई?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />ओले ऐआढोवाङ, “बजारल तोलोअ रु ल्योङ हिन्चिते, ओटन नकाजन ऐढोचिते, ‘गुरुज्यूले ऐलेऊ, ङा बेला नेरा रांदा। ङा सिइयाङस न झिमल निस्तार-पर्ब मानिङा।’”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />तब येशुल आदेस अनुसार आ सिइयाङ हिन्वाङ ओटन नकाङै निस्तार-पर्बल बन्दबस्त रांढोव।<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />ओइ ताहापाइना येशु बारं गोटा आसिइयाङसं ज्याऔ नाल्ट चुङौ। <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />जब ओलं सनर आ सिइयाङ ज्याज्यावाङ तब नवाए बेला येशुले ऐलेऊ, “ङा जेजन मछ्यु ऐढाच्या, जेमध्य तोलोअले ङाजन शत्तुरयाङल कुईत कोलोकौ परिङन्या लेया।” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />तब नकाङ भ्याईज दुखी ताइस्यु स्वाट्टैले तो-तोलोअङन गिनौ तअसिवाङ, “प्रभु, ङा ता माङडी?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />ओटन येशुले ऐआढोवाङ, “जोले ङासकाए थालल भरेई छोएज्याऊ, नकाले ङाजन कोलोकौपरिङन्या लेया।<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजनसङ्ग्रह ४१:९</ref></char></note> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />ओलं बारेल पबित्रशास्त्रलं आसरसिन्या अनुसार रुल ज़ा ता हिनन्याई लेया। तर आक्याई ना रु, जोङन रुल ज़ा कोलोअसि। नका रु ता माजर्मिऊ भन्या आ नाल्ट चान्या ताइन्यालेऊ।”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />तब येशुजन कोलोकौपरिङन्या यहूदाले आगिनौ, “गुरुज्यू, नैति ङा ओइज रों?” येशुले नकाजन ऐआढोव, “नङ नङजै ऐलिज्याना।”<verse eid="MAT 26:25" /></para>
  <para style="s">प्रभु भोस</para>
  <para style="r">
    <ref loc="MRK 14:22-26">मर्कुस १४:२२-२६</ref>; <ref loc="LUK 22:14-20">लूका २२:१४-२०</ref>; <ref loc="1CO 11:23-25">१कोरिन्थी ११:२३-२५</ref></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />नकाङै भोस रांज्याज्याऔ बेला येशुले भरेई आहोनौ ओटन आशिर्बाद योंवापाइना ओले ना आकलाटौ ओटन सिइयाङजन आयोवाङ ओटन ऐआढोवाङ, “हअ कैचिते, ईका ङा बुल हो।”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />तब कटौरा बै होनस्यु परमेस्वरजन धन्याबाद यांस्यु ओले नकाङजन ऐलेस्यु आयोवाङ, “जे सोगलैले इकालन ओचिते। <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />दानाङभन्या आका छार बाचाल ङा जी हो, जो तबरल पापल छेमाल नाल्ट बगाइसिया।<note caller="-" style="x"><char style="xo" closed="false">26:28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">प्रस्थान २४:८</ref>; <ref loc="JER 31:31-34">यर्मिया ३१:३१-३४</ref></char></note> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />तर ङा जेजन ऐढाच्या, कि अङ्गुरल ईका शईतन ङा तब समन ओन्या मालेङदी, जब समन ङा बौल राज्यल जेसकाए छार रस माओङ।”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />येशु सनर आ सिइयाङ तोलोअ भजन रेएसिरा पाइना पलिईस्यु जैतुन डान्डा देए हिन्वाङ।<verse eid="MAT 26:30" /></para>
  <para style="s">येशुले पत्रुसलं बारेङन भबिस्यबानी आढान्या</para>
  <para style="r">
    <ref loc="MRK 14:27-31">मर्कुस १४:२७-३१</ref>; <ref loc="LUK 22:31-34">लूका २२:३१-३४</ref>; <ref loc="JHN 13:36-38">यहुन्ना १३:३६-३८</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />तब येशुले नकाङजन ऐआढोवाङ, “आछिम रिउल ङागर्दाले जे छिनदेए हटिन्यालेच्या। दानाङभन्या ईका पबित्रशास्त्रलं ऐटाइन्या सरसिन्या लेया, ‘परमेस्वरले ग्वालाजन सएन्यालेया, ओटन बगालला भेडाङ हुदेएअदेए तत्तर बित्तर ताइन्यालेरा।’<note caller="-" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">जकरिया १३:७</ref></char></note> <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />तर ङा सिस्यु जिङदा ताइङापाइना जेतन हादेए गालील इलाकाल हिन्ङा।”<note caller="-" style="x"><char style="xo" closed="false">26:32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ती २८:१६</ref></char></note><verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />पत्रुसले येशुजन जबाक आयोव, “न कारनले सोगलै छिन्देए हाएसिरकन बै ङा खकै नङजन माराहन्दी।”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />येशुले नकाजन ऐआढोव, “ङा मछ्यु, नङजन ऐढाना, आछिम रिउल भाल्या आकोव हादेए नङ ङाजन तिन पाला मासहङदी ऐलेस्यु राहङना।”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />पत्रुसले ओलजन ऐआढोव, “ङा नङसं सिऊज परिकन्बै ङा नङजन राइन्या मालेङदी।” अपुर सोगलै सिइयाङ बै नैज रांढोव।<verse eid="MAT 26:35" /></para>
  <para style="s">गेतसमनी बारील येशुल प्रार्थना</para>
  <para style="r">
    <ref loc="MRK 14:32-42">मर्कुस १४:३२-४२</ref>; <ref loc="LUK 22:39-46">लूका २२:३९-४६</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />तब येशु गेतसमनी राढान्या बारील नकाङसं हिनौ, ओटन सिइयाङजन आढोवाङ, “जे आलै चुङचिते, ङा हुकठक्क हिनस्यु प्रार्थना ढोङा।” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />ओटन ओलसं पत्रुस सनर जब्दियाल नेंलोअ आज़ाने आलाङौने ओटन ओल भ्याई सोकले सनर आतिऊ तअसिऊ। <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />तब ओले नकाङजन आढोवाङ, “ङा भ्याई आतिस्यु सिङालेन्यामन ताइज्याङा। जे आलै चुङज्याचिते, ओटन ङासै सन्सिज्याचिते।” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />ओटन ओल हुदिन्क ठक्क हिनस्यु घुन्डा टेकिस्यु प्रार्थना ढाऔ तअसिऊ, “औ ङा बौ, ताहौ ढुदुउकन आका दुखल कटौरा ङातन हताइस्याङते, तर बै ङा इच्छ्या अनुसार माङडी, नङ इच्छ्या नढाऔमन ग्याताइत्या।” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />जब वलस्यु आसिइयाङ ल्योङ आरांऔक नकाङजन रांम्वाईज्यान्या आडोएरिइवाङ, ओटन पत्रुसजन ऐआढोव, “नैति जे ङासं त घन्टा बै सनसिज्याऔ जेमाढुदुचिऊ? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />सनसिस्यु लिज्याचिते, प्रार्थना ढोचिते, ओटन परिक्छ्याल तापरिच्यो। आत्मा ता तयारज लेया, तर बुल दुर्बल लेया।”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />फरि छुट्टैपाला हिनस्यु येशुले प्रार्थना ढाऔ तअसिऊ, “औ ङा बौ, ङा ईका दुखल कटौरा माओस्युई माताहकन नमीई इच्छ्या पुरा ग्याताईत्या।” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />फरि आरांऔक नकाङजन रांम्वाईज्यान्या आडोएरिइवाङ, दानाङभन्या नकाङ मिऊरुइले लठ्ठै ताइस्यु लेवाङ।<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />नैताइस्यु येशुले नकाङजन फरि बनाएस्यु, हिनस्यु फरि नकाई छेन दोहोऱ्याइस्यु तिस्रा पाला प्रार्थना आढोव। <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />तब सिइयाङ ल्योङ रा:स्यु ओले नकाङजन ऐआढोवाङ, “जे अझ बै जेरुउज्याचिऊ ओटन जेनानसिज्याचिऊ? खिम्चिते, समाय नेराक ताप्‌रा:स्यु लेया। रुल ज़ा पापीयाङल कुईत परिङा लेदा। <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />सोचिते, हिन्‌या। खिम्चिते ङाजन कोलोअन्या रु नेराकै लिज्याया।”<verse eid="MAT 26:46" /></para>
  <para style="s">येशुजन राकोलोअन्या</para>
  <para style="r">
    <ref loc="MRK 14:43-50">मर्कुस १४:४३-५०</ref>; <ref loc="LUK 22:47-53">लूका २२:४७-५३</ref>; <ref loc="JHN 18:3-12">यहुन्ना १८:३-१२</ref></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />येशु आछ्योङज्याऔ बेलाकै, बारं जना मध्यला तोलोअ, अथाबा यहूदा ऐढासिन्या सिइ रांऔ। नका सकाए मुख्या पुजाउरोयाङ सनर जन्ताङल नेताङै रापरिङन्या तोलोअ घिन्या हुल तरवाल सनर झुई छेन्स्यु रांवाङ। <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />ओलजन कोलोकौपरिङन्याले नकाङजन तोलोअ चिन्न यांस्यु आनाएवाङ, “ङा जो रुजन म्वाहङ, नकाई ज्या, ओजन कोलोअच्यो।”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />ओचोएटै येशु ल्योङ हिनस्यु नकाले ऐआढोव, “औ गुरु, जडौ!” ओटन नकाले येशुजन आम्वाहौ।<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />येशुले नकाजन ऐआढोव, “ऐ न्हाए, नङ जो नढारानु, ना परेए ढोते।” तब नकाङै हाक रा:स्यु येशुजन राकोलोकौ। <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />येशु सकाए लिज्यान्या मध्य तोलोअले आतरवाल आहाटौ, ओटन मुख्या पुजाउरोल सेवाऱ्याजन आराइस्याऔक, नकाल नां आछटकाइस्योव। <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />तब येशुले नकाजन ऐआढोव, “न तरवाल आसिपलं झोअते, दानाङभन्या जोयाङै तरवाल चलाइर, ओयाङ सोगलै तरवाललेई सएन्या लेसिरा। <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />नङ नै नयिङनु, नैति ङा ङा बौजन गोहारिऊ ङामाढुदुङु, ओले ङा नाल्ट बारं पल्टनतन भ्या स्वर्गदुतयाङ ओचोएटै आमापरिदुउ का? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />तर नैताहकन ईका छेन ऐलेस्यु ताहौजपरिया ऐलेस्यु पबित्रशास्त्रलं सरसिन्या छेन कढाई पुरा ताह?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />नकाई बेला येशुले रुयाङल हुलजन ऐआढोवाङ, “जे ङाजन दानाङ गोएयाङल बिरोदत रांऔमन तरवाल सनर झुईयाङ होनस्यु कोलोअ राच्यो? ङा दिनकाई मन्दिरलं चुङस्यु सिक्छ्या यांज्याङा, तर जे ऐकता ङाजन माकोलोअदुङच्या।<note caller="-" style="x"><char style="xo" closed="false">26:55 </char><char style="xt" closed="false"><ref loc="LUK 19:47">लूका १९:४७</ref>; <ref loc="LUK 21:37">२१:३७</ref></char></note> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />तर पबित्रशास्त्र अनुसार अगमबक्ताङल बचन पुरा ग्याताईत्या लेस्यु ईका सोगलै ताइरा:औ हो।” तब सोगलै सिइयाङ येशुजन बनाएस्यु ढोङवाङ।<verse eid="MAT 26:56" /></para>
  <para style="s">महासभालं सामन्दी येशु</para>
  <para style="r">
    <ref loc="MRK 14:53-65">मर्कुस १४:५३-६५</ref>; <ref loc="LUK 22:54-55">लूका २२:५४-५५</ref>,<ref loc="LUK 22:63-71">६३-७१</ref>; <ref loc="JHN 18:13-14">यहुन्ना १८:१३-१४</ref>,<ref loc="JHN 18:19-24">१९-२४</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />येशुजन कोलोअन्याङै ओलजन प्रधान पुजाउरो कैयाफा ल्योङ रालाङौ। नङं शास्त्रीयाङ सनर नेताङ दुउसिस्यु लेवाङ। <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />तर पत्रुस लोएङन्जै प्रधान पुजाउरोल झिमल ठरबाङ समन जै येशुल छिनछिन लागिऊ, ओटन आब कैताइन्या होला, ना ब्याटौ नाल्ट भितरलं पसिस्यु पाल्याङ सकाए चुङौ। <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />आब मुख्या पुजाउरो सनर सोगलै महासभाले येशुजन सएन्या सजाई यांऔज परिया लेस्यु आमि बिरोदत ग्वारस्यु आरोप लाहौ नाल्ट साचीयाङ रोंकौ तअसिवाङ। <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />ओलं भ्याई ग्वारस्यु आरोप लाइन्याङ रांवाङ, तर नकाङै नैज प्रमान माडोएदुरा। आसापट नेंलोअ साचीने हाक रांऔने, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />ओटन ऐलेऊने, “ईका रुले ‘ङा परमेस्वरलं मन्दिर थाएस्यु आकाजन तिन दिनक निब्जाहौ ढुदुङा’ ऐलेऊ।”<note caller="-" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">यहुन्ना २:१९</ref></char></note><verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />तब प्रधान पुजाउरोले च्याङस्यु येशुजन आगिनौ, “नैति नङ नैज जबाक मायोना? ईका रुयाङै न बिरोदत रायांन्या बयन नैति हो?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />तर येशु छपक्कै दिङज्याऔ। प्रधान पुजाउरोले ओलजन ऐआढोव, “जिङदा परमेस्वरलं मिनत किऱ्या ज्यास्यु, गेजन पानस्यासिन्ते, नैति नङ परमेस्वरलं ज़ा ख्रीस्ट रों?”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />येशुले नकाजन ऐआढोव, “नङजै ऐलिज्याना। फरि बै ङा जेजन ऐढाच्या, आबकन जे रुल ज़ाजन सर्बसक्तिमान परमेस्वरलं दाइन्या कुईङन आचुङज्यान्या, सनर नमता बादलल आरांज्यान्या रङन्या लेच्या।”<note caller="-" style="x"><char style="xo" closed="false">26:64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानियल ७:१३</ref></char></note><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />तब प्रधान पुजाउरोले आक्वा चिइस्यु ऐलेऊ, “इकाले ता ईस्वरलं-बिरोदत छ्योङदा। आब गेजन अपुर साचीयाङल नैज आबस्यक मापरिदी? आकअ इकाले ईस्वरलं-बिरोदत आछ्योङन्या ता जे थएदुच्या।”<note caller="-" style="x"><char style="xo" closed="false">26:65 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवी २४:१६</ref></char></note><verse eid="MAT 26:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 26:66" />पान्चिते जे बिचार नै लेऊ? नकाङै जबाक रांयोव, “आका अपरादि ता परान झोअस्यान्या लायकला लेया।”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />तब नकाङै आहांल ठिल्स्यास्यु ओलजन गुस्सा रा:राइस्योव, ओटन काङ्का-काङ्काङै ऐलेस्यु लप्टा रा:राइस्योव,<note caller="-" style="x"><char style="xo" closed="false">26:67 </char><char style="xt" closed="false"><ref loc="ISA 50:6">यशैया ५०:६</ref></char></note> <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />“औ ख्रीस्ट, लंह नङ अगमबक्ता ताहकन पान्ते! नङजन तुपन्या काङ्का?”<verse eid="MAT 26:68" /></para>
  <para style="s">पत्रुसले येशुजन आराइन्या</para>
  <para style="r">
    <ref loc="MRK 14:66-72">मर्कुस १४:६६-७२</ref>; <ref loc="LUK 22:56-62">लूका २२:५६-६२</ref>; <ref loc="JHN 18:15-18">यहुन्ना १८:१५-१८</ref>,<ref loc="JHN 18:25-27">२५-२७</ref></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />पत्रुस बाहेर ठरबाङल आचुङज्याऔक। तोलोअ नोक्कर्निले आल्यौक रा:स्यु ऐआढोव, “नङ बै गालीलल-चुङन्या येशुसं नलिज्यानु ऱ्वाए?”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />तर पत्रुसले ओयाङ सोगलैल सामन्दी माभनस्यु ऐलेऊ, “नङ नै नपानज्यानु, ङा मासनङदी।” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />नका बाहेर पलिईन्या झलाप ल्योङ आहिनौक छुट्टैले नकाजन आरङौ, ओटन ओलं लिज्यान्याङजन ऐआढोवाङ, “ईका रु बै नासरी येशु सकाए जै लिज्याऔ।”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />नकाले फरि बाचा ढास्यु माभनौ, “ङा नका रुजन मासहङदी।”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />तचिइ छिनठक्क ओक जिऊक लिज्यान्याङ बै नेराक रा:स्यु पत्रुसजन ऐराढोव, “मछ्यु, नङ बै नकाङ मध्यला तोलोअ ज्या, दानाङभन्या न छेनलेई नङजन आशई जाएज्यान्वा।”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />तब पत्रुसले ओलझन्जै थलस्यु ऐलेऊ, “ङा नका रुजन सहौजै मासहङदी ऐलेस्यु परमेस्वर मिनत किऱ्या ज्याऔ तअसिऊ।” ओटन ओचोएटै भाल्या कोव। <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />तब येशुले “भाल्या आकोव हादेए नङ ङाजन तिन पाला राहङना।” ऐआढान्या छेन पत्रुसले आयिङौ, ओटन बाहेरङ हिनस्यु भ्याई व्आंव्आं लेस्यु व्‌रौ।<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">येशुजन पिलातस ल्योङ रालाङौ</para>
  <para style="r">
    <ref loc="LUK 23:1-5">लूका २३:१-५</ref>; <ref loc="JHN 18:28-38">यहुन्ना १८:२८-३८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />छकाल्या घलज, सोगल मुख्या पुजाउरोयाङ सनर जन्ताङल नेताङै येशुजन सएन्या सजाय यांन्या लेस्यु ओलं बिरोदत सड्यन्त्र रांढोव। <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />ओटन नकाङै येशुजन साङ्गलले पोअस्यु रालाङौ, ओटन हाकिम पिलातस ल्योङ राबुझाहौ।<verse eid="MAT 27:2" /></para>
  <para style="s">यहूदा आसिन्या</para>
  <para style="r">
    <ref loc="ACT 1:18-19">प्रेरित १:१८-१९</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />तब येशुजन कोलोकौपरिङन्या यहूदाले ओलजन सजाय आताइन्या रङस्यु पस्ताहौ, ओटन मुख्या पुजाउरोयाङ सनर नेताङजन चान्दील तिस सिक्का होलस्यानाऔ,<note caller="-" style="x"><char style="xo" closed="false">27:3 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">प्रेरित १:१८-१९</ref></char></note> <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />ओटन नकाले ऐआढोवाङ, “ङा निर्दोस रुजन धोखा यांस्यु पाप ढोदुङा।” तर नकाङै ऐराढोव, “गेजन नै मतलब? नङजै सन्ते।”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />तब नकाले चान्दील नका सिक्काङ मन्दिरलं क्याइनिइस्यु हिनौ, ओटन केप्सिस्यु आत्महत्या आढोव। <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />तर मुख्या पुजाउरोयाङै चान्दील नका सिक्काङ चिनास्यु ऐलेवाङ, “ईका आराधना झिमला ढुकुटील नाएन्या ठिक माङडी, दानाङभन्या ईका जील येए हो।” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />नकाङै रारांल सल्ला ढास्यु ना पैसाले परदेसीयाङ रींनन्या कुमाल्याल येङ रालङौ। <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />नका येङ आछिम समन बै लिज्याया जोजन जील येङ ऐढासिया।<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />तब यर्मिया अगमबक्ताले आपानन्या छेन ऐलेस्यु पुरा ताहौ, “नकाङै ओ चान्दील तिस सिक्का राहोनौ, नकाई येएल हिसापत, जो येए इस्राएललं ज़ायाङै नकाल रुल नाल्ट राटुकिऊ,<note caller="-" style="x"><char style="xo" closed="false">27:9 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">जकरिया ११:१२-१३</ref></char></note> <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />ओटन परमप्रभुले ङाजन आदेस आयांन्या अनुसार कुमाल्याल येङ नकाङै रालङौ।”<verse eid="MAT 27:10" /></para>
  <para style="s">पिलातसले येशुजन आगिनौ</para>
  <para style="r">
    <ref loc="MRK 15:2-5">मर्कुस १५:२-५</ref>; <ref loc="LUK 23:3-5">लूका २३:३-५</ref>; <ref loc="JHN 18:33-38">यहुन्ना १८:३३-३८</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />येशुजन रोमला घिन्या हाकिमल हाक सच्यानसिऊ, ओटन नकाले ऐलेस्यु आगिनौ, “नैति नङ यहूदीयाङल रय रों?” येशुले ऐआढोव, “नङजै ऐलिज्याना।” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />ओटन मुख्या पुजाउरोयाङ सनर नेताङै येशुजन दोस रांलाहौ, तर ओले नैज जबाक मायोढुऊरा। <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />तब पिलातसले ऐआढोव, “न बिरोदल नकाङै गोटागोटा छेनल बयन यांज्यारा, नैति नङ नमाठएनु?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />तर येशुले नकाजन तोलोअ बै आरोपल जबाक मायोदा। नैताइस्यु हाकिम ईका छेनत भ्याई हलाअ ताहौ।<verse eid="MAT 27:14" /></para>
  <para style="s">येशुजन सएन्या सजायल फैसला</para>
  <para style="r">
    <ref loc="MRK 15:6-15">मर्कुस १५:६-१५</ref>; <ref loc="LUK 23:13-25">लूका २३:१३-२५</ref>; <ref loc="JHN 18:39">यहुन्ना १८:३९</ref>; <ref loc="JHN 19:16">१९:१६</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />रोमी शासक हाकिमले निस्तार-पर्ब छिम्क रुयाङ हुलले आचाहिन्या अनुसार तोलोअ कैदीजन राइस्यान्या चलन लेऊ। <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />नवाए बेला नल येशु सकाए बारब्बा मिनला तोलोअ मिनथइन्या कैदी बै लिज्याऔ। <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />जब रुयाङ दुउसिवाङ, पिलातसले नकाङजन आगिन्वाङ, “जे नै जेचाहिचिऊ? ङा जे नाल्ट काङ्काजन राहङ? बारब्बा सन् ख्रीस्ट ऐढासिन्या येशुजन?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />दानाङभन्या नकाङै येशुजन खिईले नैराजाटौ ऐलेन्या पिलातसले सनस्यु लेऊ।<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />तब नियाल आसनतं आचुङज्याऔक पिलातसल मेएमाले ऐलेस्यु थाई आपरिङौ, “नका धर्मि रुजन कैज ताढो, दानाङभन्या आछिम ङामङल नकाल कारनले ङा भ्याई दुख ङाडोएङु।”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />तर मुख्या पुजाउरोयाङ सनर नेताङै बारब्बाजन राइन्या सनर येशुजन सएन्या सजाए यांन्या माग ढान्या लेस्यु रुयाङजन रामच्चाइवाङ। <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />तर रोमी शासकले फरि नकाङजन आगिन्वाङ, “ङा जे नाल्ट ईका नेंलोअ मध्य काङ्काजन राहङ ऐलेन्या जेचाहिचिऊ?” नकाङै मच्चाईस्यु ऐराढोव, “बारब्बाजन।”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />पिलातसले नकाङजन ऐआढोवाङ, “तब ङा ख्रीस्ट ऐढासिन्या येशुजन कैढोङवन?” नकाङ स्वाट्टैले जबाक रांयोव, “नकाजन क्रूसतं केपचिते।”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />पिलातसले आगिन्वाङ, “दानाङ? नकाले नैति अपराद आढोव का?” तर नकाङ झनज भ्याईज जोरसै ऐलेस्यु कलिऊवाङ, “नकाजन क्रूसतं केपचिते।” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />जब पिलातसले ओलजन बचाइन्या नैज उपाय आमारङौ, भ्याई खैलाबैलादी मच्चिकान्देए ऐलेन्या छ्याहै बरु नकाले री होनस्यु रुयाङल हुलल सामन्दी आकुई हुरस्यु ऐलेऊ, “जे जेईज सन्चिते, ङा ईका रुल जीतन निर्दोस लेङा।”<note caller="-" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="DEU 21:6-9">ब्यबस्था २१:६-९</ref></char></note><verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />ओला सोगल रुयाङै जबाक रांयोव, “नकाजन सएसिन्या जील दोस गे सन्तानयाङयर्त ग्यापरित्या ऐलेरापाइना।” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />पिलातसले नकाङल नाल्ट बारब्बाजन आराइस्योवाङ, ओटन येशुजन कोर्ला स्वापस्यु सिपाइयाङ कुईत सुम्पिस्यु क्रूसतं केपौ आपरिङवाङ।<verse eid="MAT 27:26" /></para>
  <para style="s">सिपाइयाङ येशुजन रांगिलल्याइन्या</para>
  <para style="r">
    <ref loc="MRK 15:16-20">मर्कुस १५:१६-२०</ref>; <ref loc="JHN 19:2-3">यहुन्ना १९:२-३</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />तब पिलातसल सिपाइयाङै येशुजन शासकलं दरबारल रालाङौ, ओटन सोगल पल्टनजन ओलं चारवरङन दुउसिवाङ। <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />नकाङै ओलं क्वा फिरस्यु ओलजन धुङल्याइन्या क्वा रांक्वाटौ। <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />नकाङै ज़ुल मुकुट लएस्यु आङएत राजाएस्यौ, ओटन दाइन्या आकुईत सरा रांयोव, ओटन आहाक घुन्डा टिकिस्यु ओलजन ऐलेस्यु गिलल्याहौ तअसिवाङ, “औ यहूदीयाङल रय, जडौ, लेस्यु तबर बान्चिन रांढोव।” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />तब नकाङै ओलजन रांठिलौ, ओटन नकाई सरा न्हानस्यु आङएत रा:स्वापस्यौ। <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />नकाङै आक्वा फिरस्यु, रांगिलल्याहौ ओटन छिन्ट आक्वाईज क्वाएस्यु ओलजन क्रूसतं राकेपनाङौ।<verse eid="MAT 27:31" /></para>
  <para style="s">येशु क्रूसतं</para>
  <para style="r">
    <ref loc="MRK 15:21-32">मर्कुस १५:२१-३२</ref>; <ref loc="LUK 23:26-43">लूका २३:२६-४३</ref>; <ref loc="JHN 19:17-27">यहुन्ना १९:१७-२७</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />नकाङ राहिनज्याऔक कुरेनी सहरला तोलोअ सिमोन मिनला रुसकाए डोएसिवाङ, ओटन नकाङै ओजन येशुल क्रूस वुरन्या कर रांलाहौ। <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />जब नकाङ गलगथा ऐढासिन्या पोल तापवाङ, जोल अर्थ “खप्परल पो” <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />तब नकाङै येशुजन काअ बराएसिन्या अङ्गुरल रस ओव रांपरिङौ, तर ओले नका दारस्यु माओदा।<note caller="-" style="x"><char style="xo" closed="false">27:34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">भजनसङ्ग्रह ६९:२१</ref></char></note> <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />नकाङै येशुजन क्रूसतं केपरापाइना, चिठ्ठा झोअस्यु ओलं क्वायाङ रारांल राभाकौ।<note caller="-" style="x"><char style="xo" closed="false">27:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">भजनसङ्ग्रह २२:१८</ref></char></note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />तब नकाङै ओलै चुङस्यु ओलजन वुटौ तअसिवाङ। <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />येशु, यहूदीयाङल रय “नकाङै आबिरोदत ऐटान्या दोस-पत्र आङएल टङ्ङन राचप्काइस्यौ।” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />ओलसं नेंलोअ गोएनेंजन बै क्रूसतं केप्स्यु रांनाटौ, तोलोअ आमि दाइन्याङन ओटन छुट्टै दाबऱ्याङन।<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />नका यमलन बान्याङै रां ढेङ फन्दाइस्यु ओलजन रांगिलल्याहौ,<note caller="-" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">भजनसङ्ग्रह २२:७</ref>; <ref loc="PSA 109:25">१०९:२५</ref></char></note> <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />ओटन ऐराढोव, “ऐ मन्दिर थाएस्यु तिन दिनक निब्जाइन्या, नङ परमेस्वरलं ज़ा ताहनकन, क्रूसतन वान्ल लांइस्यु रांन्ते, ओटन नङझन्जै बचाइते।”<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">मत्ती २६:६१</ref>; <ref loc="JHN 2:19">यहुन्ना २:१९</ref></char></note><verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />मुख्या पुजाउरोयाङै बै शास्त्रीयाङ सनर सेरयाङ सकाए बोलोङ ओलजन रांगिलल्याहौ, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“इकाले अपुऱ्याङजन आबचाहौ, तर ओलझन्जै बचाहौ माढुदुज्यादी। आब क्रूसतन लांइस्यु वान्ल ग्यारांत्या, ओटन याएज गे ईका इस्राएलला रय ज्या लेस्यु। बल्ल बिस्वास ढोया। <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />इकाले परमेस्वरतं भरोसा ढोवकन। परमेस्वरले इकाजन निज्यास्यु ओले इकाजन आकै छुटकारा ग्यायोंवत्या, दानाङभन्या इकाले ‘ङा परमेस्वरलं ज़ा ज्या,’ ऐलेऊ।”<note caller="-" style="x"><char style="xo" closed="false">27:43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">भजनसङ्ग्रह २२:८</ref></char></note><verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />ओटन ओलसं क्रूसतं केप्सिन्या नका गोएनेंले बै ऐलेस्युई आमि अपमान नेंढोव।<verse eid="MAT 27:44" /></para>
  <para style="s">येशु आसिन्या</para>
  <para style="r">
    <ref loc="MRK 15:33-41">मर्कुस १५:३३-४१</ref>; <ref loc="LUK 23:44-49">लूका २३:४४-४९</ref>; <ref loc="JHN 19:28-30">यहुन्ना १९:२८-३०</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />लाअका याएबेलाकन तिन बजे समन नका सोगलै देसलं च्युकौ। <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />लाअका तिन बजेदेए येशु ऐलेस्यु घिन्या ग़ाले कलिकौ, “इलोई<note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false">आरामिक भासा</char></note>, इलोई, लामा सबखथनी?” अथाबा, “औ ङा परमेस्वर, औ ङा परमेस्वर, नङ ङाजन दानाङ राहङ?”<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">भजनसङ्ग्रह २२:१</ref></char></note> <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />नल च्याङज्यान्याङ मध्य ख्वाएयाएले ईका थएस्यु ऐलेवाङ, “ईका रुले एलियाजन खुलज्याऔ ताहाहोला।” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />नकाङ मध्य तोलोअले चोएनास्यु ओचोएटै तोलोअ रुवा<note caller="+" style="f"><char style="fr" closed="false">27:48 </char><char style="ft" closed="false">रुवा = स्पन्ज</char></note> होनस्यु सरात<note caller="+" style="f"><char style="fr" closed="false">27:48 </char><char style="ft" closed="false">सरा=निङगालो</char></note> पोअस्यु सिर्काल<note caller="+" style="f"><char style="fr" closed="false">27:48 </char><char style="ft" closed="false">सिर्का = कान्या रस अथाबा काअ भामसिन्या</char></note> बुदाइस्यु ओव रांपरिङौ।<note caller="-" style="x"><char style="xo" closed="false">27:48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">भजनसङ्ग्रह ६९:२१</ref></char></note><verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />तर अपुऱ्याङै ऐलेवाङ, “राइचिते ब्याएन्या, एलिया इकाजन बचाइन्या रांऔ सन्?” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />येशु फरि बै घिन्या ग़ाले कलिऊस्यु आपरान आराहौ। <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />नवाए बेला मन्दिर पर्दा टुप्पातन आटुङ समन नेभा ताइस्यु चिहौ, ओटन रनबन वुकौ तअसिऊ, ओटन चमयाङ बै पाकौ तअसिवाङ।<note caller="-" style="x"><char style="xo" closed="false">27:51 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">प्रस्थान २६:३१-३३</ref></char></note> <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />ऊईयाङ फएसिवाङ, ओटन तबर सिन्याङ प्रभुल पबित्र रुयाङ जो जिङदा ताइस्यु सोवाङ, <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />ओटन नकाङ ऊईजिऊलन पलिइवाङ, ओटन सिन्याङतन येशुल पुनरुत्थान आताहौ छिन्ट नकाङ पबित्र सहरल पसिवाङ, ओटन भ्याई ल्योङ रंन्वाङ।<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />कप्तान सनर येशुजन वुइज्यान्याङै जब भुईचाल सनर ओलं ताइज्यान्या घटना रांरङौ, तब भ्याईज छ्याएस्यु नकाङै ऐलेवाङ, “मछ्युजै, ईका ता परमेस्वरलं ज़ा रैस।”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />नल गालीलङन रांन्या तबर मेएमाङ बै लेवाङ, नकाङै लोएतन नका स्वाट्टै ब्याएज्यावाङ। नकाङ ओलं सेवा ढाऔयन गालीलङन येशुल छिनछिन रांवाङ।<note caller="-" style="x"><char style="xo" closed="false">27:55 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">लूका ८:२-३</ref></char></note> <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />नकाङ मध्य मरियम मग्दलिनी, सनर याकूब ओटन योसेफल आमा मरियम, ओटन जब्दियाल आज़ानेल आमा बै लेऊ।<verse eid="MAT 27:56" /></para>
  <para style="s">येशुजन रारीनन्या</para>
  <para style="r">
    <ref loc="MRK 15:42-47">मर्कुस १५:४२-४७</ref>; <ref loc="LUK 23:50-56">लूका २३:५०-५६</ref>; <ref loc="JHN 19:38-42">यहुन्ना १९:३८-४२</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />ओइ ताहापाइना अरिमाथिया सहरला योसेफ मिनला तोलोअ साहू रु रांऔ। नका ओल बै येशुल सिइ हो। <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />योसेफले पिलातस ल्योङ हिनस्यु येशुल सिन्या बुल नीऊ, ओटन पिलातसले ओलजन यांन्या हुकुम आयोवाङ। <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />योसेफले सिन्या बुल होनस्यु सफा मलमललं क्वाले आमलिङौ, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />ओटन नकाले चमजन खुलिस्यु आजाएन्या आमिईज छार ऊईल आनाटौ, ओटन ऊईल याह्‌त तोलोअ घिन्या लुङ गरकाइस्यास्यु हिनौ। <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />ऊईल लेऊक मरियम मग्दलिनी सनर छुट्टै मरियम बै चुङज्याऊने।<verse eid="MAT 27:61" /></para>
  <para style="s">ऊईल चौकिदारयाङ</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />तयोअका छिम्क, अथाबा तयारील दिनल हाकाछिम, मुख्या पुजाउरोयाङ सनर फरिसीयाङ पिलातस ल्योङ हिन्वाङ, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />ओटन ओजन ऐराढोव, “सायब, गे यांका ऐढाज्याया, कि नका ठकले जिङदा आलेऊक, ‘तिन दिन छिन्ट ङा फरि सोन्यालेङा’ ऐलेस्यु लेऊ।<note caller="-" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">मत्ती १६:२१</ref>; <ref loc="MAT 17:23">१७:२३</ref>; <ref loc="MAT 20:19">२०:१९</ref>; <ref loc="MRK 8:31">मर्कुस ८:३१</ref>; <ref loc="MRK 9:31">९:३१</ref>; <ref loc="MRK 10:33">१०:३३</ref>; <ref loc="LUK 9:22">लूका ९:२२</ref>; <ref loc="LUK 18:31-33">१८:३१-३३</ref></char></note> <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />नैताइस्यु तिस्रा दिन समन ना ऊईजन जोगाहौ नाल्ट हुकुम यांसिन्ते, मानकन्ता नकाल सिइयाङै रा:स्यु ना कुस्यु लाङरा कर, ‘आका ता सिन्याङतन जिङदा ताइस्यु सिदा’ ऐलेस्यु रुयाङजन ऐढान्या लेरा, ओटन नका छिन्ङ ताइन्या धोखा हादेएङातन अझै माचान्या ताइन्यालेया।”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />पिलातसले नकाङजन ऐआढोवाङ, “जेमियाङज वुइन्याङ लिज्यारा। हिन्चिते, जे जेढुदुऊ समन जोगाइस्यु नाएचिते।”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />तब नकाङ हिनस्यु लुङत छाप रांलाहौ, ओटन चौकिदारयाङ खटाइस्यु ऊईजन जोगाइस्यु रांनाटौ।<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">येशु जिङदा आसोन्या</para>
  <para style="r">
    <ref loc="MRK 16:1-11">मर्कुस १६:१-११</ref>; <ref loc="LUK 24:1-12">लूका २४:१-१२</ref>; <ref loc="JHN 20:1-18">यहुन्ना २०:१-१८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />हप्ताल छिन्ट, शबाथल पैला दिन छकाल्या मिरमिर आताहौक मरियम मग्दलिनी सनर छुट्टै मरियम ऊई खिम रांऔने। <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />तब घिन्या भुईचाल रांऔ, दानाङभन्या परमप्रभुल तोलोअ दुत स्वर्गतन वान्ल लाहौ, ओटन ऊईला लुङ हताइस्यु नकाल यर्त चुङौ। <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />नकाल अनवार बिजौलिमन्जै सनर पैइरन पम मनताइन्या पलन्या लेऊ। <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />नाल छ्याहै ना सिपाइयाङ करिङकरिङ वुउवाङ, ओटन सिऊ बराबर ताइवाङ।<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />तर स्वर्गदुतले मेएमानेजन ऐढोवने, “झेन ताछ्याएचिन, दानाङभन्या ङा ऐसन्ङा, झेन क्रूसतं केप्सिन्या येशुजन झेनरोअज्याचिनु। <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />ओ आल माल्दी, दानाङभन्या ओले आपानन्या अनुसार ओलं सिन्या बुल जिङदा ताइस्यु सोडा। राचिन्ते, ओलजन रानाएन्या पोल खिम्चिन्ते। <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />तब परेए हिनस्यु आ सिइयाङजन थाई योंचिनरते, कि येशु सिस्यु जिङदा ताइस्यु सोस्युलेया। ओ झेन हादेए गालीलल हिनज्याऔ। ओलजन नङं रङन्या लेचिना। खिम्चिन्ते, ङा झेनजन ङापानस्यान्या छेन यिङसिचिन्ते।” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />ओटन नकाने छ्याएस्यु ओचोएटै ऊईलन पलिहौने, ओटन आनन्द सकाए सिइयाङजन थाई यांन्या चोटौने। <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />येशु नकानेसं झुकाउन्या डोएस्यु ऐआढोवने, “शान्ति!” नकाने आनेराक हिनस्यु आखङ कोलोअस्यु ओलजन ढोक नेयोव। <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />तब येशुले नकानेजन ऐआढोवने, “ताछ्याएचिन, हिनस्यु ङा भाईयाङजन गालीललं हिन्चिते ऐढोचिन्‌रते, नकाङै ङाजन ओङ रङन्या लेरा।”<verse eid="MAT 28:10" /></para>
  <para style="s">सिपाइयाङल थाई</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />जब ना मेएमाने यमल हिनज्याऔने, सिपाइयाङै बजारल हिनस्यु मुख्या पुजाउरोयाङजन नङ आघतिन्या घटनाल बारेङन थाई रापानस्योवाङ। <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />जब मुख्या पुजाउरोयाङ सेर नेताङस दुउसिवाङ, तब नकाङै सल्ला ढास्यु, सिपाइयाङजन तबर रुप्या रांयोवाङ, ओटन ऐराढोवाङ। <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />“जे ऐलेच्यो, कि ‘गे गेम्वाईज्याऔक नकाल सिइयाङ रा:स्यु नकाजन कुस्यु लाङदुरारैस।’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />ओटन किगर्दाङ रोमी हाकिमल आनांल ईका छेन तापकन, गे ओलजन सभनस्यु जेजन जोगाइसिना।”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />तब सिपाइयाङै नका रुप्या राहोनौ, ओटन राह्युउन्या अनुसार राढाऔकाले यहूदीयाङ ल्योङ आछिमका दिन समन ईकाइ छेन फैलिस्यु लेया।<verse eid="MAT 28:15" /></para>
  <para style="s">माहान आदेस</para>
  <para style="r">
    <ref loc="MRK 16:14-18">मर्कुस १६:१४-१८</ref>; <ref loc="LUK 24:36-49">लूका २४:३६-४९</ref>; <ref loc="JHN 20:19-23">यहुन्ना २०:१९-२३</ref>; <ref loc="ACT 1:6-8">प्रेरित १:६-८</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />नका एघारैं गोटा सिइयाङ गालील प्रदेसलं नका डान्डात हिन्वाङ, जोङ येशुले हिन्चिते लेस्यु आपरिङवाङ।<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="MAT 26:32">मत्ती २६:३२</ref>; <ref loc="MRK 14:28">मर्कुस १४:२८</ref></char></note> <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />सिइयाङै ओलजन रङस्यु ढोक रा:योव, तर ख्वाएले सङ्का राढोव। <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />तब येशु नकाङल्योङ रा:स्यु ऐआढोवाङ, “स्वर्ग सनर पिरथ्बीला सोगल अढिकार ङाजन यासिन्या लेया। <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />नैताइस्यु हिन्चिते, ओटन सोगलै देसला जातियाङजन सिइ जाएचिरते, बौ सनर ज़ा ओटन पबित्र आत्माल मिनत नकाङजन बप्तिस्मा योंचिरते,<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">प्रेरित १:८</ref></char></note> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />ङा जेजन आग्या ङायान्या सोगलै छेन मानिन्या नकाङजन ह्युउचिरते। खिम्चिते, ङा जुगल आसाप समन सदाई जेस लिज्याङा।”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>