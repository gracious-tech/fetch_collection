<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Sheshi Kham</book>
  <para style="h">यहुन्ना</para>
  <para style="toc3">यहुन्ना</para>
  <para style="toc2">यहुन्ना</para>
  <para style="toc1">यहुन्नाले आसरन्या चान्याथाई</para>
  <para style="mt1">यहुन्नाले लेखेको चान्याथाई</para>
  <para style="mt2">यहुन्नाले आसरन्या चान्याथाई</para>
  <para style="imt">किटापल आशई</para>
  <para style="ip">यहुन्नाल चान्याथाई अनुसार छार नियामला चार गोटा किटापयाङ मध्य ईका तोलोअ हो। जोले येशु ख्रीस्टल जिबनजन पान्वा। नकाङ मध्य सोगलैजन “चान्याथाई” ऐढासिया जोल अर्थ “चान्याथाई” हो। नकाङ मत्ती, मर्कुसं, लूका सनर यहुन्नाङन येशु आसिऊ छिन्ट रा:सरौ, यहुन्नाल अनुसार ईका चान्याथाई लगभग ख्रीस्टल जन्म आटाहौल ९० बर्स छिन्ट प्रेरित यहुन्नाले आसरौ हो। किटाप सरन्या यहुन्ना ज्या ऐमालेकन बै सरन्या शैली १ यहुन्ना, २ यहुन्ना ओटन ३ यहुन्नाल अछेरयाङस मिलिन्या लेया। ख्वाएयाए ऐका सरन्याङै नका बेला यहुन्नाजन एफिसस सहरल नाएस्यु लेवाङ नैताइस्यु ईका किटाप एफिससलं सरसिन्या ताहौ ढुदुवा। यहुन्नाले प्रस्टै सकाए ईका किटापल मुख्या उदश्य रुयाङजन येशु जै ख्रीस्ट जिङदा परमेस्वरलं ज़ा हो, ऐलेन्या बिस्वास ढास्यु गे ओलं मिनतन जिबन डोटौ ढुदुया। ईका किटाप यहूदी, सनर गैरहूदी परिन्याल नाल्ट सरसिऊ हो। यहुन्नाल चान्याथाई अपुर तिन गोटा चान्याथाईतन तबर फरक लेया। ओले येशुले आढान्या चमत्कारयाङत ध्यान आलाहौ। ओटन ओलं आहानयाङल बारेङन तबर मासरदा। येशुल बप्तिस्मा सनर हरहर ताइन्या पोल प्रलोबन मनताइन्या अपुर मुख्या घटनाङ बै ईका चान्याथाईल सरसिस्यु मालरदी।</para>
  <para style="iot">रुप रेखा:</para>
  <para style="io1">यहुन्नाले चान्याथाई सुरु ढोवा। अध्याय <char style="ior"><ref loc="JHN 1:1-18">१:१-१८</ref></char></para>
  <para style="io1">ओलं छिन्ट यहुन्नाले येशुले आढान्या चमत्कारयाङ <char style="ior"><ref loc="JHN 1:19">१:१९</ref>; <ref loc="JHN 12:50">१२:५०</ref> </char></para>
  <para style="io1">ओलं छिन्ट ओले येशुले जिबनल तबर घटनाङ पानस्यु नाएवा, जो ओ आसिन्या सनर पुनरुत्थानङ तापा <char style="ior"><ref loc="JHN 13:1">१३:१</ref>; <ref loc="JHN 20:31">२०:३१</ref> </char></para>
  <para style="io1">यहुन्नाले अध्याय २१ ल चान्याथाईल अनत्य जाएवा, जब येशु सिन्याङ्ङन बौरिस्यु सोया पाइना रुयाङ ल्यौक रंनौ। ओटन ओलं छिन्ट किटाप सरसिन्याल उदश्य आपानौ।</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">बचन बुलल मन्जै रंनन्या ताहौ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />सुरुत बचन लेऊ, बचन परमेस्वर सकाए लेऊ, ओटन बचन परमेस्वरज लेऊ। <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />ओ सुरुक परमेस्वर सकाए लेऊ। <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />सोगलै जन्तु ओलङन बनिऊ, ओटन सोगल जन्तु ओल बिना नैज माबनिदा। <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />ओसै जिबन<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">रुल आयु</char></note> लेऊ, ओटन नकाई जिबन रुयाङल ज्योति लेऊ। <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />ना ज्योति चिऊन्याल चम्किऊ, तर चिऊन्या नकायर्त झ्योङस्यु माल्दी।<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />परमेस्वरले आपरिङन्या तोलोअ थाई पानन्या रु लेऊ, जोल मिन यहुन्ना लेऊ।<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="MAT 3:1">मत्ती ३:१</ref>; <ref loc="MRK 1:4">मर्कुस १:४</ref>; <ref loc="LUK 3:1-2">लूका ३:१-२</ref> </char></note> <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />नका ओ ज्योतिल बारेल बयन यांऔ नाल्ट बयन ताइस्यु रांऔ, कि सोगल रुयाङ ओलङन बिस्वास ग्याढोरत्या। <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />नका ओलजै ना ज्योति माङडी, तर ना ज्योतिल बयन याराऔ। <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />नका ज्योति सत्य लेऊ, ईका ज्योति सङ्सारलं रांज्याया ओटन सोगल रुयाङत चम्किया। <verse eid="JHN 1:9" /><verse number="10" style="v" sid="JHN 1:10" />ओ सङ्सारलै लिज्याऔ, सङ्सार ओलङन्ज बनिऊ, ताहकन्बै सङ्सारले ओलजन माशैदा। <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />ओलं आरुयाङ ल्योङै रांऔ, तर ओलं आरुयाङै ओलजन ग्रहन माढोदुरा। <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />तर ज्वाएले ओलजन ग्रहन रांढोव, ओटन आ मिनतं बिस्वास रांढोव, ओले नकाङजन परमेस्वरलं सन्तान ताइन्या अढिकार आयोवाङ। <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />नकाङ जीङन, न बुलल इच्छ्याङन सनर काङ्काई रुल इच्छ्याङन माङडी तर परमेस्वरतन जर्मिन्याङ ताइरा।<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />ओटन बचन बुलत रंनन्या ताहौ, ओटन अनुग्रह सनर सत्यताले पुरा ताइस्यु गेखार्ल बाई चुङौ। गे ओलं महिमा गेरङयिउ, जो महिमा बौल ज़ाल मनताइन्या गे गेडोएयिउ। <verse eid="JHN 1:14" /><verse number="15" style="v" sid="JHN 1:15" />यहुन्नाले ओलं बारेल बयन आयांज्याऔक घिन्या ग़ाले ऐलेऊ, “ओ नकाई रु ज्या, जोल बारेल ङा ङापान्ङु ‘ङाछिन्ट रांन्या ङातन हर्त लेया, दानाङभन्या ओ ङाजर्मिऊ हादेएजै लेऊ।’”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />ओलं अनुग्रहल पुर्नताङन गे तोलोअ अनुग्रहल यर्त गे सोगलैले छुट्टै अनुग्रह डोएस्यु लेया। <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />दानाङभन्या ब्यबस्था मोशाङन यांसिऊ, अनुग्रह सनर सत्यता येशु ख्रीस्टङन रांऔ, <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />परमेस्वरजन काङ्काईले खकै रङस्यु मालरदी। दानाङभन्या तोलोअ याएज बौल घोनल चुङन्या ज़ाले ओलजन थनस्यु नाएवा।<verse eid="JHN 1:18" /></para>
  <para style="s">बप्तिस्मा यांन्या यहुन्नाल गवाइ</para>
  <para style="r">
    <ref loc="MAT 3:1-12">मत्ती ३:१-१२</ref>; <ref loc="MRK 1:1-8">मर्कुस १:१-८</ref>; <ref loc="LUK 3:1-18">लूका ३:१-१८</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />जब ख्वाएयाए यरुशलेमला यहूदी अढिकारीयाङै पुजाउरोयाङ सनर लेबीयाङजन यहुन्ना ल्योङ “नङ काङ्का?” ऐलेस्यु गिनौ नाल्ट रापरिङवाङ, <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />नकाले ङा “ख्रीस्ट माङडी, ऐलेस्यु ओज्या ऐमाल्दा।” <verse eid="JHN 1:20" /><verse number="21" style="v" sid="JHN 1:21" />तब नकाङै यहुन्नाजन रांगिनौ, “वन नैति नङ एलिया रों?” नकाले ऐलेऊ “ङा माङडी।” “नैति नङ ना अगमबक्ता रों?” नकाले जबाक आयोवाङ, “माङडी।”<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="MIC 4:5">मीका ४:५</ref>; <ref loc="DEU 18:15">ब्यबस्था १८:१५</ref>,<ref loc="DEU 18:18">१८</ref>; <ref loc="ISA 48:10-11">यशैया ४८:१०-११</ref></char></note> <verse eid="JHN 1:21" /><verse number="22" style="v" sid="JHN 1:22" />नकाङै यहुन्नाजन ऐराढोव, “फरि नङ काङ्का वन? गेजन पानस्यासिन्ते, ओटन गेजन परिङन्याङजन गे पानस्याऔ ग्याढुदुयित्या नङ नबारेल नैपानन्?” <verse eid="JHN 1:22" /><verse number="23" style="v" sid="JHN 1:23" />यहुन्नाले जबाक आयोवाङ, “यशैया अगमबक्ताले आपानौमन, ‘परमप्रभुल यम सोझा जाएचिते’ ऐलेस्यु हरहर ताइन्या पोल कलिऊन्या तोलोअ रुल ग़ा ङाई ज्या।”<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यशैया ४०:३</ref> </char></note> <verse eid="JHN 1:23" /><verse number="24" style="v" sid="JHN 1:24" />नकाङजन फरिसीयाङै रापरिङवाङ। <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />ओटन नकाङै यहुन्नाजन रांगिनौ “नङ ख्रीस्ट बै माङडी, एलिया बै माङडी, ना अगमबक्ता बै माताहन्कन, दानाङ नङ रुयाङजन बप्तिस्मा योंनर वन?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />यहुन्नाले नकाङजन जबाक आयोवाङ, “ङा ता रीले याएज बप्तिस्मा योंङरा, तर जे खार्ल तोलोअ च्याङस्यु लेया, जोजन जे माशईचिदी। <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />ङा छिन्ट रांन्या ओइज ज्या। जोल ङा जुताल टना पलाअन्या लायकला मालेङदी।” <verse eid="JHN 1:27" /><verse number="28" style="v" sid="JHN 1:28" />ईका छेन यर्दन भई हुदिन्त बेथानियाल ताइस्यु लेऊ, जोङ यहुन्नाले बप्तिस्मा यांज्याऔ।<verse eid="JHN 1:28" /></para>
  <para style="s">परमेस्वरलं थुमा</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />तयोअका छिम्क यहुन्नाले येशुजन आलेऊदेए आरांज्यान्या रङस्यु ऐलेऊ “खिम्चिते सङ्सारला पाप सिमस्यु लाङन्या परमेस्वरलं थुमा!<note caller="-" style="x"><char style="xo" closed="false">1:29 </char><char style="xt" closed="false"><ref loc="1PE 1:19">१पत्रूस १:१९</ref>; <ref loc="ISA 53:7">यशैया ५३:७</ref> </char></note> <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />ईका ओइ ज्या, जोल बारेल ङापानस्याचिऊ, ‘ङाछिन्ट तोलोअ रु रांया, जो ङातन हर्त लेया दानाङभन्या ओ ङातन हादेएजै लेऊ।’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />ङा ङाईज ओजन शईस्यु ङामालेङु, तर ओलजन इस्राएलीयाङै ग्याशईरत्या ऐलेस्यु ङा रीले बप्तिस्मा यांस्यु-यांस्यु ङारांङु।” <verse eid="JHN 1:31" /><verse number="32" style="v" sid="JHN 1:32" />यहुन्नाले ऐलेस्यु बयन आयोव, “ङा पबित्र आत्माजन कचिकुरल भेसतं स्वर्गङन लांइस्यु येशुल यर्त आचुङन्या ङारङ्ङु। <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />ङा ओजन शईस्यु ङामालेङु, तर जोले ङाजन रीले बप्तिस्मा योंवर लेस्यु आपरिङ्ङु ओलेईज ङाजन ऐआढाङु, ‘जोल यर्त नङ पबित्र आत्मा आलाइज्यान्या सनर आचुङज्यान्या रङन, पबित्र आत्माले बप्तिस्मा यांन्या ओइज ज्या।’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />ङा रङस्यु लेङा, ओटन बयन यांस्यु लेङा, कि परमेस्वरलं ज़ा ओइज ज्या।”<note caller="-" style="x"><char style="xo" closed="false">1:34 </char><char style="xt" closed="false"><ref loc="PSA 2:7">भजनसङ्ग्रह २:७</ref></char></note><verse eid="JHN 1:34" /></para>
  <para style="s">येशुल पहेला सिइयाङ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />फरि छुट्टै दिन छिम्क यहुन्ना नेलोअ सिइने सकाए च्याङज्याऔ। <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />यहुन्नाले येशुजन आहिनज्यान्या रङस्यु ऐलेऊ, “खिम्चिन्ते, परमेस्वरलं थुमा!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />यहुन्नाले आछ्योङन्या छेन थएस्यु ना नेलोअ सिइने येशुल छिनछिन लागिऊने। <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />येशुले वलस्यु आब्याटौक, नकाने छिनछिन नेराज्यान्या रङस्यु नकानेजन आगिनौने, “झेन नैति झेनरोअचिनु?” नकानेले ओलजन ऐनेढोव, “रब्बी (जोल अर्थ गुरुज्यू), नङ काङ नचुङनु?” <verse eid="JHN 1:38" /><verse number="39" style="v" sid="JHN 1:39" />ओले नकानेजन ऐआढोवने, “राचिन्ते ओटन झेन रङन्या लेचिना।” नकाने हिनौने, ओटन येशु आचुङन्या पो नेंरङौ, नकाने ना छिम्क ओलसंज बाए चुङौने, दानाङभन्या लगभग ओईका चार बजिस्यु लेऊ।<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />यहुन्नाले आपानन्या छेन थएस्यु येशुजन पछ्याइन्या ना नेंलोअ मध्य तोलोअ सिमोन पत्रुसलं आभाई अन्द्रियास लेऊ। <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />अन्द्रियास हादेए आभाई सिमोनसकाए डोएसिऊ, ओटन नकाजन ऐआढोव “घोन मसीहजन डोएस्यु लेच्या (जोल अर्थ, ख्रीस्ट) हो।”<note caller="-" style="x"><char style="xo" closed="false">1:41 </char><char style="xt" closed="false"><ref loc="JHN 4:25">यहुन्ना ४:२५</ref></char></note> <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />अन्द्रियासले सिमोनजन येशु ल्योङ आहोनौ। येशुले नकाजन आब्याटौ ओटन ऐआढोव, “नङ ईका यहुन्नाल ज़ा सिमोन ज्या, नङ केफास (जोल अर्थ, लुङ) ऐढासिया।”<verse eid="JHN 1:42" /></para>
  <para style="s">फिलिप सनर नथानेलनेजन येशुले आखुलौने</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />छिन्का छिम्क येशुले गालील प्रदेसलं हिनन्या पक्का आजाटौ। ओटन फिलिपजन डोएस्यु येशुले ऐआढोव, “ङा छिन्ट बान्ते।” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />अन्द्रियास सनर पत्रुस मनताइन्या फिलिप बै बेथसेदा बजारलाइज लेऊ। <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />फिलिपले नथानेलजन डोएस्यु ऐआढोव, जोल बारेल मोशाल ब्यबस्था सनर अगमबक्ताङै बै सरस्यु लेरा, योसेफल ज़ा नासरतला येशुजन घोन डोएस्यु लेच्या।<note caller="-" style="x"><char style="xo" closed="false">1:45 </char><char style="xt" closed="false"><ref loc="MAT 21:11">मत्ती २१:११</ref></char></note> <verse eid="JHN 1:45" /><verse number="46" style="v" sid="JHN 1:46" />नथानेलले नाजन आगिनौ, “नैति नासरतङन कोबाअ चान्या छेन रांऔ आढुदुऊ का?” फिलिपले नाजन जबाक आयोव, “रा:स्यु खिम्ते।” <verse eid="JHN 1:46" /><verse number="47" style="v" sid="JHN 1:47" />येशुले नथानेलजन आल्योङ आरांज्यान्या रङस्यु नकाल बारेल आपानौ, “तोलोअ पक्का इस्राएलीजन खिम्चिते, जोसकाए नैज कैफट माल्दी?” <verse eid="JHN 1:47" /><verse number="48" style="v" sid="JHN 1:48" />नथानेलले आगिनौ, “नङ ङाजन कैलेस्यु नशईनु?” येशुले नकाजन जबाक यांस्यु ऐआढोव “फिलिपले नङजन आखुलौ हादेए, ड्यूल टुङल ङा नङजन ङारङनु।” <verse eid="JHN 1:48" /><verse number="49" style="v" sid="JHN 1:49" />नथानेलले येशुजन ऐआढोव, “रब्बी, नङ परमेस्वरलं ज़ाई ज्या, सनर नङ इस्राएलला रय ज्या।” <verse eid="JHN 1:49" /><verse number="50" style="v" sid="JHN 1:50" />येशुले नकाजन जबाक यांस्यु ऐआढोव, “ङा नङजन ड्यूल टुङल ङारङनु ऐ नलेऊकाले, नङ बिस्वास नढोनु? नङ इकातन अझै घिन्या छेनयाङ रङना।”<note caller="-" style="x"><char style="xo" closed="false">1:50 </char><char style="xt" closed="false"><ref loc="JHN 11:40">यहुन्ना ११:४०</ref></char></note> <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />ओटन येशुले नकाङजन ऐआढोवाङ, “मछ्यु ङा जेजन ऐढाच्या, जे स्वर्ग आफएसिन्या सनर परमेस्वरलं दुतयाङ रुल ज़ाल फलाअङन हर्देए रांवूमज्यान्या सनर वान्देए रालाइज्यान्या रङच्या।”<note caller="-" style="x"><char style="xo" closed="false">1:51 </char><char style="xt" closed="false"><ref loc="GEN 28:12">उत्पत्ति २८:१२</ref></char></note><verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">काना सहरल ब्याहा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />तिस्रा दिन छिम्क गालील प्रदेसला काना<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">ईका लगभग १५ मायिल तिबेरियाल उत्तर पछिमदेए सनर ६ मायिल नासरतलं उत्तर पुर्ब देए तोलोअ इङन्या ठक्क बजार लेऊ।</char></note> सहरल तोलोअ ब्याहा लेऊ। येशुल आअमा मरियम ओलं लिज्याऔ। <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />येशु सनर आसिइयाङजन बै ब्याहाल रांखुल्वाङ। <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />अङ्गुरल रस आखेमौ छिन्ट, येशुल आअमाले ओलजन ऐआढोव, “नकाङ ल्योङ अङ्गुरल रस खेम्दा<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">अङ्गुर नुम्सिन्या माल्दी ईका थाह माल्दी कि मरियमले दानाङ येशुजन ऐआढोव। इकाल मतलब ईका प्रमानित ताहा कि ओलजन बिस्वास लेऊ कि येशु अभाबल परिपुर्न जाएन्या सक्छेम लेऊ।</char></note>।” <verse eid="JHN 2:3" /><verse number="4" style="v" sid="JHN 2:4" />येशुले आअमाजन ऐआढोव, “औ स्त्री, ङा नै ढान्याताहौ ङाजन ऐताढाङ। ङा बेला<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">इकाल मतलब अचम्मला काम ढान्या बेला माराऔ माङडी, कि रुयाङ री ओइन्या बेलाक अचम्मला काम रङन्या सनर बिस्वास ढान्या बेला माराऔ हो।</char></note> अझै मारांडी।” <verse eid="JHN 2:4" /><verse number="5" style="v" sid="JHN 2:5" />ओलं आअमाले काम ढान्याङजन ऐआढोवाङ, “जे नकाले आपरिमन्या अनुसार ढोचिते।” <verse eid="JHN 2:5" /><verse number="6" style="v" sid="JHN 2:6" />आब यहूदीयाङल चोखाइन्या चलन अनुसार नल छ्योअ त सय लितर सुनन्या लुङल छ गोटा घारीयाङ नाएसिन्या लेऊ।<verse eid="JHN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7" />येशुले नोक्करयाङजन ऐआढोवाङ, “घारीयाङ री ले आयां समन फाङजाएचिते।” नकाङै घारील आयां समन रीले फाङ रांजाटौ। <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />येशुले नकाङजन ऐआढोवाङ, “तचिठक्क री वापस्यु ब्याहाला मुख्या सेर ल्योङ लाङस्योचिते।” नकाङै ना रा:लाङस्यौ। <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />ब्याहाला सेरले ना री आदारौ, जो आब अङ्गुर रस ताइस्यु लेऊ। ना, काङन राहोनौ नाजन थाहै माताइदा, तर री रेंपन्याङजन याएज थाह लेऊ। तर ब्याहाला मुख्या सेरले दुलाहाजन खुल्स्यु ऐआढोव। <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />“ख्वाए रुयाङै हादेए चान्या अङ्गुर नुम्सिन्या पारिरा ओटन रुयाङै तबर रांओव छिन्ट माचान्या अङ्गुर नुम्सिन्या योंरा। नङ ता अझ समन चान्याई अङ्गुरल रस नुम्सिन्या नाएस्यु नल्‌नुरैस।” <verse eid="JHN 2:10" /><verse number="11" style="v" sid="JHN 2:11" />ओले अचम्मला कामयाङ ङन ईका पहेला अचम्मला कामयाङ येशुले गालील प्रदेसला काना सहरल आढोव। ऐलेस्यु ओले आमहिमा आथनौ, ओटन आसिइयाङै ओजन बिस्वास रांढोव। <verse eid="JHN 2:11" /><verse number="12" style="v" sid="JHN 2:12" />ओलं छिन्ट येशु, आअमा, आभाईयाङ सनर आसिइयाङसं कफर्नहुमलं हिन्वाङ, ओटन तचिइ दिन समन नलै चुङवाङ।<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 4:13">मत्ती ४:१३</ref></char></note><verse eid="JHN 2:12" /></para>
  <para style="s">येशु यरुशलेम मन्दिरलं हिनौ</para>
  <para style="r">
    <ref loc="MAT 21:12-13">मत्ती २१:१२-१३</ref>; <ref loc="MRK 11:15-17">मर्कुस ११:१५-१७</ref>; <ref loc="LUK 19:45">लूका १९:४५</ref>,<ref loc="LUK 19:46">४६</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />यहूदीयाङल निस्तार<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">इस्राएलीयाङ मिस्र देसलन रापलिहौ छिम्क रांमानिन्या पर्ब=निस्तार चाड</char></note>-पर्ब नेराक रा:स्यु लेऊ, ओटन येशु यरुशलेम मन्दिरलं हिनौ।<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">प्रस्थान १२:१-२७</ref></char></note> <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />येशुले मन्दिरलं यीङयाङ, शान्ढाङ सनर कचिकुरयाङ लङन्या यएन्याङ सनर रुप्या फिरिन्याङजन राचुङज्यान्या आडोएवाङ। <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />ओटन तोलोअ छिङल कोर्ला जाएस्यु येशुले यीङयाङ, शान्ढाङ, सोगलैजन मन्दिरलन आचाहारवाङ, ओटन नकाङल देस्क पल्ताइस्यु बागस फलुपस्यास्यु रुप्या फिरिन्याङल रुप्या आग्वाएस्योवाङ। <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />परेवा यएन्याङजन येशुले ऐआढोवाङ, “इलन ईका सोगलै लाङस्यु हिन्चिते। ङा बौल झिमजन बैपारल झिम ताजाएच्यो।” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />नवाए बेला आसिइयाङै पबित्रशास्त्रलं सरसिन्या छेन यांका रांढोव, “औ परमेस्वर नझिमल नाल्ट जोशले ङाजन हिप्जिया।”<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="PSA 69:9">भजनसङ्ग्रह ६९:९</ref></char></note> <verse eid="JHN 2:17" /><verse number="18" style="v" sid="JHN 2:18" />यहूदी अढिकारीयाङै ऐलेस्यु रांगिनौ, “नङजन ईका काम ढान्या नै अढिकार लेऊ, नैति नङ अचम्मला काम ढाऔ नढुदुनु?” <verse eid="JHN 2:18" /><verse number="19" style="v" sid="JHN 2:19" />येशुले ओयाङजन जबाक आयोवाङ, “ईका मन्दिरजन थाएचिते, ओटन ङा तिन दिनक इकाजन सच्यान्ङा।”<note caller="-" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="MAT 26:61">मत्ती २६:६१</ref>; <ref loc="MAT 27:40">२७:४०</ref>; <ref loc="MRK 14:58">मर्कुस १४:५८</ref>; <ref loc="MRK 15:29">१५:२९</ref></char></note> <verse eid="JHN 2:19" /><verse number="20" style="v" sid="JHN 2:20" />तब यहूदीयाङै ऐराढोव, “ईका मन्दिर निब्जाइन्याता छेयालिस बर्स लागिऊ, ओटन ओक्या नङ ईका तिन दिनक ऐयाङ सच्यानौ ढुदुना का?” <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />तर जो मन्दिरलं बारेल येशुले आपानौ, ना आबुलल बाए हो। <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />जब येशुले सिस्यु जिङदा ताइस्यु सोङा लेस्यु आपानन्या छेन आ सिइयाङ यांका रांढोव, तब नकाङै पबित्रशास्त्रलं यर्त सनर येशुले आछ्योङन्या बचनत बिस्वास रांढोव।<verse eid="JHN 2:22" /></para>
  <para style="s">येशुले रुल यिङ सन्वा</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />जब येशु निस्तार-पर्बल भोसलं बेला यरुशलेम सहरल लिज्याऔ, तब ओले आढान्या अचम्मला काम रङस्यु तबरले आ मिनङन बिस्वास रांढोव। <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />तर येशुले नकाङल भर मामानिदा, दानाङभन्या ओलं सोगलैजन सहौरा। <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />रु नैति ऐलेस्यु, येशुजन रुल बारेङन काङ्काईले बयन यांन्या आबस्यक माल्दी, दानाङभन्या रुल यिङल नैति लेऊ, ना येशुले ओलजै सन्वा।<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">निकोदेमस सनर येशु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />फरिसीयाङ मध्य निकोदेमस मिनला तोलोअ रु यहूदीयाङल आराधना झिमला अगवा लेऊ। <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />तयोअ रिउल नका येशु ल्योङ रा:स्यु ऐआढोव, “गुरुज्यू, गे ऐसन्या। नङ परमेस्वर ङन रांन्या गुरु ज्या, दानाङभन्या परमेस्वरसं बोलोङ मालेन्कन ईका नङ नढान्या अचम्मला कामयाङ काङ्काईले ढाऔ माढुदुऊदी।” <verse eid="JHN 3:2" /><verse number="3" style="v" sid="JHN 3:3" />येशुले नकाजन जबाक आयोव, “मछ्यु ङा नङजन ऐढाना,<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">निकोदेमसजन बिस्वास त अझै बलल्या जाटौ आरोकौ</char></note> यदि काङ्काङ छार ताइस्यु फरि माजर्मिरकन नकाङै परमेस्वरलं राज्य रङौ माढुदुरदी।” <verse eid="JHN 3:3" /><verse number="4" style="v" sid="JHN 3:4" />निकोदेमसले येशुजन ऐआढोव, “रु शेरस्यु कैलेस्यु फरि जर्मिऊ ढुदुऊका? नैति ना आअमाल गर्बल फरि तपाला पसिस्यु जर्मिऊ ढुदुवा का?”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />येशुले जबाक आयोव, “मछ्यु ङा नङजन ऐढाना, काङ्काङ री सनर आत्माङन माजर्मिकन<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">री सनर आत्माङन जर्मिचिते “री” इल छरलङ्गै “बप्तिस्मा” जन थनन्या ढोवा।</char></note> परमेस्वरलं राज्यल पसिऊ माढुदुऊदी। <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />बुललन जर्मिन्या बुल ज्या, ओटन आत्माङन जर्मिन्या आत्मा ज्या। <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />ङा नङजन छार ताइस्यु जर्मिन्याताहा ऐङालेऊक अचम्म तामानि। <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />घूईका जोदेए ङप्सी ओदेएजै उदिया। नङ घूईकाल ग़ा ऐठएना, तर ना काङन रांऔ, ओटन कान्देए हिनौ ना मासनन्दी। आत्माङन जर्मिन्या सोगलै रुयाङ नैज ताइरा।”<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="ECC 11:5">उपदेशक ११:५</ref></char></note> <verse eid="JHN 3:8" /><verse number="9" style="v" sid="JHN 3:9" />निकोदेमसले येशुजन आगिनौ, “नै कढाई ताहौ आढुदुऊ?” <verse eid="JHN 3:9" /><verse number="10" style="v" sid="JHN 3:10" />येशुले नाजन जबाक आयोव, “नङ इस्राएलला मानिसिन्या गुरु ताइस्यु बै ईका छेन नमासन्नु?” <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />मछ्यु ङा नङजन ऐढाना, गे जो सनई नाइ पान्या, ओटन गे जो रङस्यु गेलेयिउ नाइ बयन योंया, तर जे गे बयन माकोन्चिदी। <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />ङा जेजन पिरथ्बीला छेन ङापानस्याचिऊ ओटन बै जे बिस्वास माढोचिदी, ओटन जेजन स्वर्गला छेन पानस्याच्योकन कढाई बिस्वास ढोच्यो? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />ओटन स्वर्गत हिनस्यु लांइस्यु रांन्या रुल ज़ा बाहेक अपुर काङ्काई माल्दी।<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="JHN 6:38">यहुन्ना ६:३८</ref></char></note> <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />जोमनलेस्यु मोशाले हरहर ताइन्या पोल डाङजन आछेनौ, नैलेस्युजै रुल ज़ा, बै छेन्सिन्या लेया,<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="JHN 8:28">यहुन्ना ८:२८</ref>; <ref loc="NUM 21:9">गन्ती २१:९</ref></char></note> <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />ओटन जोले ओजन बिस्वास ढोव, ओले अनन्त जिबन डोएवा। <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />“दानाङभन्या परमेस्वरले सङ्सारजन ऐटाइन्या प्रेम आढोव, कि ओले आमि तोलोअ याएज ज़ा आयोव, ताकि ओजन बिस्वास ढान्या काङ्काई बै नास ताटाइत्या, तर नकाले अनन्त जिबन ग्याडोटौत्या। <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />दानाङभन्या परमेस्वरले सङ्सारजन निया ढान्या ऐलेस्यु रुल ज़ाजन सङ्सारलं आपरिङौ माङडी, तर सङ्सारले ओल्योङन उद्दार ग्याडोटौत्या ऐलेस्यु आपरिङौ हो। <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />जोले ओलं यर्त बिस्वास माढोव, नका हादेए जै नियाल परीस्यु लेया, तर बिस्वास ढान्या नियाल मापरिदी, दानाङभन्या नाले तोलोअ परमेस्वरलं ज़ाल मिनतन याएज बिस्वास ढास्यु लेया।<note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="JHN 5:10">यहुन्ना ५:१०</ref></char></note> <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />निर्नय आकाई ज्या ज्योति सङ्सारलं रा:स्यु लेया, तर रुयाङै ज्योतिल भन्या बरु च्युऊन्याजन रांनिजिऊ, दानाङभन्या नकाङल काम माचान्या लेऊ। <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />दानाङभन्या माचान्या काम ढान्या सोगलैले ज्योतिजन सज्युरा, ओटन ज्योतित मारारदी, मानकन्ता नकाङल कामयाङ रंनन्या लेरा। <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />सत्यङन बान्चिन्या रु ज्योतित रांया, ओटन नैताइस्यु नाले आढान्या कामयाङ परमेस्वरङन ढासिन्या ज्या ऐलेन्या छरलङ्गै रंना।”<verse eid="JHN 3:21" /></para>
  <para style="s">येशु सनर यहुन्ना</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />ओलं छिन्ट येशु सनर आ सिइयाङ यहूदिया प्रदेसलं हिन्वाङ, ओटन नङ नकाङ सकाए तचिइ दिन लिज्यास्यु बप्तिस्मा आयोवाङ। <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />यहुन्नाले बै सालीमल वङ्क एनोनल<note caller="+" style="f"><char style="fr" closed="false">3:23 </char><char style="ft" closed="false">“इनोन” या “ऐनोन” शब्दल अर्थ “तोलोअ रुका” </char></note> बप्तिस्मा यांज्याऔ, दानाङभन्या नङ री खाटखाट लेऊ। नाबेला नल रुयाङ रांज्यारा ओटन ओले नल बप्तिस्मा यांज्याऔ। <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />यहुन्ना नवाए बेला समन कैदल परीस्यु मालेऊ।<note caller="-" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="MAT 14:3">मत्ती १४:३</ref>; <ref loc="MRK 6:17">मर्कुस ६:१७</ref>; <ref loc="LUK 3:19-20">लूका ३:१९-२०</ref></char></note><verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />नाइ बेला यहुन्नाल सिइयाङ तोलोअ यहूदीसकाए चोखाइसिन्यालं बारेल यिसीइ ताहौ। <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />आल्योङ रा:स्यु नकाङै यहुन्नाजन ऐराढोव, “गुरु यर्दनल पुर्ब हूत जो नङसं लिज्याऔ, जोल बारेङन नङ बयन नयोनु, ब्याएते, ओले बप्तिस्मा योंज्याया, ओटन सोगलै ओ लेऊ देए हिनज्यारा।” <verse eid="JHN 3:26" /><verse number="27" style="v" sid="JHN 3:27" />यहुन्नाले नकाङजन जबाक आयोवाङ, “जब समन स्वर्गङन रुजन मायासी तब समन नाले नैज छेन डोटौ माढुदुऊदी। <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />‘ङा ख्रीस्ट माङडी, तर ङा ओटन हादेए ङापरिङसिङु हो’ ऐलेन्या ङामि बयन जे जै यांज्याच्या।<note caller="-" style="x"><char style="xo" closed="false">3:28 </char><char style="xt" closed="false"><ref loc="JHN 1:20">यहुन्ना १:२०</ref>; <ref loc="MAL 3:1">मलाकी ३:१</ref></char></note> <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />जोसकाए दुलही ले, दुलाहा ओइ ज्या। दुलाहाल न्हाए नाइ ज्या जो आलेऊक च्याङज्या, ओलं ग़ा थएस्यु भ्याई आनन्दै ताहा। नैताइस्यु ङामि ईका आनन्द आब पुरा ताइस्यु लेया। <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />आब ओ बदिन्या, ओटन ङा घटिन्या आबस्यक लेया।<verse eid="JHN 3:30" /></para>
  <para style="s">येशु स्वर्गङन रांऔ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />“हर्तन रांन्या सोगलैतन महान लेया। पिरथ्बीलन ताइन्या पिरथ्बीलाई ज्या, ओटन पिरथ्बीलाई छेन छ्योङा। स्वर्गङन रांन्या सोगलैतन महान लेया।<note caller="-" style="x"><char style="xo" closed="false">3:31 </char><char style="xt" closed="false"><ref loc="JHN 8:23">यहुन्ना ८:२३</ref></char></note> <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />ओले जो रङौ सनर थटौ, नाइ बयन योंवा, तर आमि बयन काङ्काईले ग्रहन माढोरदी। <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />जोले नकाल गवाइ ग्रहन ढोव, ओले परमेस्वर सत्य लेया, ऐलेन्या छेनल प्रमान योंवा। <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />दानाङभन्या जोजन परमेस्वरले आपरिङौ, नकाले परमेस्वरलै ग़ा छ्योङा दानाङभन्या परमेस्वरले असिमित<note caller="+" style="f"><char style="fr" closed="false">3:34 </char><char style="ft" closed="false">आवाए ऐलेस्यु माटोकिदुसिन्या </char></note> पबित्र आत्मा योंवा। <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />बौले आज़ाजन प्रेम ढोवा, ओटन सोगलै जन्तु ओलै कुईत सुम्पिस्यु नाएवा।<note caller="-" style="x"><char style="xo" closed="false">3:35 </char><char style="xt" closed="false"><ref loc="MAT 11:27">मत्ती ११:२७</ref>; <ref loc="LUK 10:22">लूका १०:२२</ref></char></note> <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />जोले ज़ाल यर्त बिस्वास ढोव, नकाले अनन्त जिबन डोएस्यु लेया। जोले परमेस्वरलं ज़ाल आग्या मामानिऊ नकाल जिबन माल्दी, तर परमेस्वरलं रिई नकायर्त लिज्याया।”<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">येशु सनर सामरी मेएमा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />यहुन्नातन भ्या येशुले आ सिइयाङ भ्याई आजाएज्यान्या सनर बप्तिस्मा बै यांज्याऔ ऐलेन्या फरिसीयाङै राथटौ। <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />(खासल येशुले ओलजै माङडी, तर सिइयाङै बप्तिस्मा रांयोवाङ।) <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />जब येशुले ईका आथटौ, ओलं यहूदियाङन फरि गालील वलस्यु रांऔ। <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />ओलं सामरीयाला यम ताइस्यु हिनन्या ताहा। <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />ओटन ओ सामरीयाला सुखार ऐराढान्या सहरल ताप्‌रा:औ, ईका सहर याकूबले आज़ा योसेफजन आयांन्या पोल नेराकै परिया।<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="GEN 33:19">उत्पत्ति ३३:१९</ref>; <ref loc="JOS 24:32">यहोशू २४:३२</ref></char></note> <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />ओलं याकूबल भिगोरेई लेऊ। येशु बाकंबाकं थाकिस्यु नका भिगोरेईल वङल आचुङज्याऔक। छ्योअ लाअ ताइस्यु लेऊ।<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />ओटन नवाए बेला तोलोअ सामरी मेएमा नल री रेंपरांऔ, येशुले नका मेएमाजन ऐआढोव, “ङाजन री ओव यांङते।” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />नवाए बेला येशुल सिइयाङै सहरल ज्यान्या जन्तु लङनास्यु लेवाङ।<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />तब सामरी मेएमाले येशुजन ऐआढोव, “नङ यहूदी ताइस्यु बै ङा सामरी मेएमाल कुईतन कढाई री ओन?” (यहूदीयाङ सामरीयाङस नैज सम्बन्द मानाएरदी।)<note caller="-" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="EZR 4:1-5">एज्रा ४:१-५</ref>; <ref loc="NEH 4:1-2">नहेम्याह ४:१-२</ref></char></note><verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />येशुले नकाजन ऐआढोव, “नङ परमेस्वरलं बरदान ओटन नङसं री नीन्या रुजन नशईन्या ताहकन नङ नका ल्योङ नीना होला, ओटन नकाले नङजन जिङदा री<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">जिबन मारुकिसिन्या बान्या री </char></note> यांन्वा होला।” <verse eid="JHN 4:10" /><verse number="11" style="v" sid="JHN 4:11" />नका मेएमाले येशुजन ऐआढोव “ओहो गुरु, नङसं री क्योअन्या जा चोखाइ माल्दी, ओटन भिगोरेई बै भ्याई घोलोमन्या लेया। ओटन नङ काङन ना जिङदा री होनन्? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />नैति नङ गे शाखा याकूबतन घिन्या नल्‌नु? ओले गेजन ईका भिगोरेई आजाएस्यायिउ, ओटन ओलं ओलजै, आदरसन्तान सनर आहार भैसाङ, आभेडा बाख्राङ सोगलै जन्तुले ईकाइ भिगोरेईल री राऔ।” <verse eid="JHN 4:12" /><verse number="13" style="v" sid="JHN 4:13" />येशुले नकाजन जबाक आयोव, “ईका री ओन्या स्वाट्टै रुयाङ फरि ओइन्या लेरा, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />तर जोले ङा ङायान्या री ओव, नका खकै ओइन्या माल्दी। ङा जो री नाजन योंङ, ना नकाल अनन्त जिबनल नाल्ट परिइज्यान्या रील मुलमन ताइन्यालेया!”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />ना मेएमाले ओलजन ऐआढोव, “औ गुरु, ङाजन नाइ री यांङते, ओटन ङा री ताओहङत्या, ओटन इल री रेंप रांन्या ताटाइत्या।” <verse eid="JHN 4:15" /><verse number="16" style="v" sid="JHN 4:16" />येशुले नाजन ऐआढोव, “हिनन्ते, नयोजन खुल्स्यु आङ होन्ते।” <verse eid="JHN 4:16" /><verse number="17" style="v" sid="JHN 4:17" />नका मेएमाले ऐलेऊ, “ङा यो माल्दी।” येशुले नाजन ऐआढोव, “ङा यो माल्दी ऐलेस्यु ठिकै नपान्नु ज्या, <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />दानाङभन्या नमी पास गोटा नयो ताइस्यु लेरा, ओटन जो आकअ नङसं लिज्याऔ, ना ब नयो माङडी। नङ ईका सत्य नछ्योङनु।”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />ओटन नका मेएमाले येशुजन ऐआढोव, “औ, नङ अगमबक्ता ज्या ऐलेस्यु ङा ऐसन्ङा। <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />ओटन गे पुर्खाङै ईका डान्डाल परमेस्वरलं आराधना रांढोव, ओटन जे यहूदीयाङ ऐलेच्या, कि परमेस्वरलं आराधना ढान्या पो यरुशलेम ज्या।”<note caller="-" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="DEU 11:29">ब्यबस्था ११:२९</ref></char></note><verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />येशुले नाजन ऐआढोव, “ऐ मेएमा, ङाजन बिस्वास ढाङते, ना बेला रांज्याया, जब जे न त ईका डान्डाल, न यरुशलेमल बौल आराधना ढान्यालेच्यो। <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />जे सामरीयाङ जो आराधना ढोच्यो, ना मासन्चिदी। गे जो आराधना धोई ना गे ऐसन्या दानाङभन्या मुक्ति ता यहूदियाङन रांया।<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="ISA 2:3">यशैया २:३</ref></char></note> <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />तर ना बेला रांज्याया ओ बेला आकाई ज्या, जब मछ्युका आराधना ढान्याङै बौजन आत्मा सनर सत्यतात आराधना धोर। दानाङभन्या ऐटाइन्याई आराधना ढान्या आराधकयाङ झन्जै बौले रोंकौरा। <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />परमेस्वर आत्मा हो, ओटन ओलं आराधना ढान्याङै आत्मा सनर सत्यतात आराधना ढान्या ताहा।” <verse eid="JHN 4:24" /><verse number="25" style="v" sid="JHN 4:25" />नका मेएमाले येशुजन ऐआढोव, “ङा ऐसन्ङा, कि मसीह रांन्यालेया (जोजन ख्रीस्ट ऐढासिया), ओटन जब ओ रां तब ओले गेजन सोगलै छेन पानस्याइवा।” <verse eid="JHN 4:25" /><verse number="26" style="v" sid="JHN 4:26" />येशुले नाजन ऐआढोव, “नङसं छ्योङन्या, ङा ओइ ज्या।” <verse eid="JHN 4:26" /><verse number="27" style="v" sid="JHN 4:27" />नवाए बेलाई आ सिइयाङ सहरङन वलस्यु रांवाङ, ओटन ओलं तोलोअ मेएमासकाए आछ्योङज्यान्या रङस्यु अचम्म ताइवाङ। तर नकाङ काङ्काईले ओलजन रामागिन्दुऊ, “नङ नै नरोअनु?” अथाबा “नङ ना मेएमासकाए दानाङ छ्योङज्यान?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />तब ना मेएमाले आगाग्री बनाएस्यु नङ्गर देए हिनौ, ओटन नाले रुयाङजन ऐआढोवाङ, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“रांचिते, तोलोअ रुजन खिम्चिते, जोले ङा ङाढान्या सोगलै काम ङाजन आपानस्याङु। नका ख्रीस्ट ता माङडी?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />तब रुयाङ सहरलन पलिईस्यु येशु ल्योङ हिन्वाङ। <verse eid="JHN 4:30" /><verse number="31" style="v" sid="JHN 4:31" />नवाए बेला सिइयाङै ओलजन ऐढास्यु बिन्ति रांढोव, “रब्बी, कोबाअ ज्यान्या ज्योते।” <verse eid="JHN 4:31" /><verse number="32" style="v" sid="JHN 4:32" />तर येशुले नकाङजन ऐआढोवाङ, “ङासं ज्याऔ नाल्ट ऐटाइन्या ज्यान्या जन्तु लेया, जो जे मासन्चिदी।” <verse eid="JHN 4:32" /><verse number="33" style="v" sid="JHN 4:33" />नैताइस्यु आसिइयाङै रारांल गिन्सिवाङ, “काङ्काङै आकाजन ज्यान्या जन्तु राहोनस्यौ सन् नैति?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />येशुले नकाङजन ऐआढोवाङ, “ङाजन परिङन्याल इच्छ्या अनुसार ढान्या, सनर बौले ङाजन आयांन्या काम पुरा ढान्या जै ङा जेए हो। <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />नैति जे ऐजेमाल्चिऊ, ‘अझै मीनन्या चार मैना बाङ्की लिज्याया, तर ङा जेजन ऐढाच्या, जे जेयेङदेए ब्याएचिते, आब बाली खानन्या बेला रांदा?’ बाली मीन्दा नैताइस्यु खानौ नाल्ट तयार ताइचिते। <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />जोले अन दुकौ नकाले ध्यारी डोएवा, ओटन अनन्त जिबनल नाल्ट जाए दुउवा, ओटन वाइन्याङ सनर दुउन्याङ तचोएकै हेसाङरा। <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />दानाङभन्या ‘तोलोअले वाइवा, ओटन छुट्टैले खान्वा,’ ऐलेन्या बचन इकातै सत्य ताहा।<note caller="-" style="x"><char style="xo" closed="false">4:37 </char><char style="xt" closed="false"><ref loc="MIC 6:15">मीका ६:१५</ref></char></note> <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />ङा जेजन ओङ खानौ ङापरिङचिऊ, जोङ जे परिस्रम ढास्युई माल्चिदी अपुऱ्याङै परिस्रम ढास्यु लेरा, ओटन नकाङल परिस्रमला जाए जे डोएस्यु लेच्या।”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />“ङा जो ङाढोङु येशुले ङाजन सोगलै आपानस्याङु” ऐआलन्या नका मेएमाल बयनले गर्दा नका सहरला सामरीयाङ मध्य तबरले येशुल यर्त बिस्वास रांढोव। <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />नैताइस्यु जब सामरीयाङ आल्योङ रांवाङ, तब नकाङै येशुजन गेसकाए चुङनते लेस्यु बिन्ति रांढोव, ओटन ओ नेंयोअ नङ चुङौ।<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />ओटन येशुल बचनल कारनले अपुर बै भ्याईले ओजन बिस्वास रांढोव। <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />रुयाङै ना सामरी मेएमाजन ऐराढोव, “आब नङ नपानन्या छेनले गर्दा गे बिस्वास गेढोयिउ माङडी, तर गे गेईज गेथएन्या कारनले मछ्यु येशु सङ्सारला मुक्तिदाता रैस लेस्यु गे गेसन्यिउ।”<verse eid="JHN 4:42" /></para>
  <para style="s">येशुले तोलोअ अढिकारील ज़ाजन आसबेलन्या</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />सामरील नेंयोअ आचुङौ छिन्ट येशु नङंन पलिईस्यु गालीलल हिनौ। <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />(येशुले ओलजै, बयन आयोव, कि ज्योङ ज्योङमिई देसलं काङ्काई अगमबक्ताल आदर माताइदी।)<note caller="-" style="x"><char style="xo" closed="false">4:44 </char><char style="xt" closed="false"><ref loc="MAT 13:57">मत्ती १३:५७</ref>; <ref loc="MRK 6:4">मर्कुस ६:४</ref>; <ref loc="LUK 4:24">लूका ४:२४</ref></char></note> <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />जब ओ गालीलल रांऔ, तब येशुले यरुशलेमला निस्तार पर्बल बेलाक जो हादेए ढास्यु लेऊ, ना सोगल काम रांरङौकाले गालीलीयाङै येशुजन स्वागत रांढोव, दानाङभन्या नकाङ बै पर्बल हिनस्यु लेवाङ।<note caller="-" style="x"><char style="xo" closed="false">4:45 </char><char style="xt" closed="false"><ref loc="JHN 2:23">यहुन्ना २:२३</ref></char></note><verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />ओलं छिन्ट येशु फरि गालीलला काना सहरल रांऔ, जोङ येशुले रीजन अङ्गुर रस आजाटौ। कफर्नहुमलं तोलोअ घिन्या हाकिम लेऊ, जोल ल्हेपाज़ा आनाएबोरस्यु लेऊ।<note caller="-" style="x"><char style="xo" closed="false">4:46 </char><char style="xt" closed="false"><ref loc="JHN 2:1-11">यहुन्ना २:१-११</ref></char></note> <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />येशु यहूदियालन गालीलल रा:स्यु लेऊ, ऐलेन्या थएस्यु नका येशु ल्योङ हिनौ, ओटन नकाले ङाज़ाजन रा:स्यु सबेलस्याङते ऐलेस्यु येशुजन कफर्नहुम हिनन्या लेस्यु बिन्ति आढोव, दानाङभन्या नकाल ल्हेपाज़ा सिङाई लिज्याऔ। <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />येशुले नकाजन ऐआढोव, जे छक्कै ताइन्या सनर अचम्मला कामयाङ जेमारङौ समन काङन बै बिस्वास ढान्या माल्चिदी।<note caller="-" style="x"><char style="xo" closed="false">4:48 </char><char style="xt" closed="false"><ref loc="DAN 4:2">दानियल ४:२</ref></char></note> <verse eid="JHN 4:48" /><verse number="49" style="v" sid="JHN 4:49" />ना घिन्या हाकिमले येशुजन ऐआढोव, “औ, ङाज़ा आमासिऊ हादेए जै ङासं रांन्ते।” <verse eid="JHN 4:49" /><verse number="50" style="v" sid="JHN 4:50" />येशुले नाजन ऐआढोव, “हिनन्ते, नज़ा जिङदाइ लिज्याया।” येशुले नकाजन आपानन्या बचन ना रुले बिस्वास आढोव, ओटन आयम लागिऊ। <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />ओटन ना आहिनज्याऔक यमलै नकाल नोक्करयाङै नास डोएस्यु नज़ा बान्चिदा ऐलेस्यु रापानस्यौ।<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />ओटन नकाले बान्दाङजन नका ख्वाए बेलाकन बेलौ तअसिऊ ऐलेस्यु आगिन्वाङ, नकाङै ऐराढोव, “ज्योलाअ लाअका एक बजेकन नाजन नाएबोरले आराहौ।” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />येशुले ङाजन “न ल्हेपाज़ा बान्चिदा” ऐआढान्या बेलाकन ज्यारैस ऐलेस्यु आबौले आसनौ। ओटन ओल सनर आझिमलाङ सोगलैले बिस्वास रांढोव। <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />यहूदियालन गालीलल रा:स्यु येशुले आढान्या नका दोस्रा अचम्मला काम ताहौ।<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">पोखराअला रीले राबेलन्या</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />ओलं छिन्ट यहूदीयाङल पर्ब लेऊ, ओटन येशु यरुशलेमल हिनौ। <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />यरुशलेमल भेडा-झलापल नेराक पास गोटा थपल्याअ लेन्या तोलोअ पोखराअल री लेऊ, जोजन हिब्रू छिन्ङन बेथस्दा ऐढासिया। <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />ओलं सोगल किसिमला नाएबोरन्याङ, अथाबा अन्ढलाङ, दुन्डाङ, लुलाङ वङज्यावाङ। <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />नकाङ ख्वाए बेला री हुरलुक ले ऐलेस्यु वुइज्यावाङ। दानाङभन्या परमप्रभुल तोलोअ दुतले बेला-बेलाक पोखराअल लांइस्यु री हल्लाइवा, ओटन री छल्किया पाइना जो हादेए रीजिङल पसि, जोमनताइन्या नाएबोर लेकन बै ऐबेल। <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />ओलं तोलोअ अर्तिस बर्सकन आनाएबोरन्या रु लिज्याऔ। <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />येशुले नका लुलाजन ओलं आवङज्यान्या आरङौ, ओटन ल्होन्या समायतन ना आका दशात लिज्याऔ रैस, ऐलेन्या सनस्यु येशुले नकाजन ऐआढोव, “नैति नङ बेलौ नरोअनु?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />लुलाले येशुजन ऐआढोव, “औ, ज्वाएबेला री छल्कि ङाजन रीजिङल लाङन्या काङ्काई ङा रु माल्दी, ङा ङाहिनज्याऔक ङाहादेए छुट्टै रु रील ऐहिन।”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />येशुले नाजन ऐआढोव, “सोन्ते, नतान छेन्ते, ओटन बान्ते।” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />ओचोएटै ना रु बेलस्यु, आतान छेन्स्यु बाऔ। ना दिन शबाथ दिन लेऊ। <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />ऐताइस्यु येशुले आसबेलन्या कारन ना रुजन यहूदीयाङै ऐराढोव, “आछिम ता शबाथल दिन दी नङ तान वुरन्या माताइदी।”<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="NEH 13:19">नहेम्याह १३:१९</ref>; <ref loc="JER 17:21">यर्मिया १७:२१</ref></char></note><verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />लुलाले नकाङजन जबाक आयोवाङ, “जोले ङाजन आसबेल्ङु ओइलेज ऐआढाङु, ‘न तान वुरस्यु बान्ते।’” <verse eid="JHN 5:11" /><verse number="12" style="v" sid="JHN 5:12" />नकाङै नाजन रांगिनौ, “नङजन तान वुरस्यु बान्ते, ऐढान्या रु काङ्का?” <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />तर ना बेलन्या रुले ओ काङ्का ऐलेस्यु माशैदा, दानाङभन्या ना पोल रुयाङ हुल रालिज्याऔकाले येशु ओलन आहिनन्याई मासन्दा। <verse eid="JHN 5:13" /><verse number="14" style="v" sid="JHN 5:14" />छिन्ट येशुले नकाजन मन्दिरलं डोएस्यु ऐआढोव, “खिम्ते, नङ बेलस्यु लेना। फरि पाप ताढो, दानाङभन्या नयर्त अझ भ्याई माचान्या ताटाइरात्या।”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />बल्ल ओलं छिन्ट ङाजन सबेलन्या ता येशुदी रैस ऐलेस्यु, नका रुले हिनस्यु यहूदी अढिकारीयाङजन आपानस्योवाङ। <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />नैताइस्यु यहूदीयाङै येशुजन सताइज्यावाङ, दानाङभन्या येशुले ईका काम शबाथ-छिम्क आढोव। <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />तब येशुले नकाङजन ऐआढोवाङ, “ङा बौले सदाई काम ढाज्याया, ओटन ङा बै काम ढाज्याङा।” <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />नैताइस्यु यहूदी अढिकारीयाङै येशुजन सएन्या लेस्यु भ्याईज जोर रांढोव, दानाङभन्या येशुले शबाथ-छिम्का नियाम याएज भङ्ग आढोव माङडी, तर ओलझन्जै परमेस्वरलं बराबर ङप्सिस्यु ओले परमेस्वरजन ङा बौ ऐलेस्यु लेऊ।<verse eid="JHN 5:18" /></para>
  <para style="s">ज़ाल अढिकार</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />येशुले नकाङजन ऐआढोवाङ, “मछ्युजै, ङा जेजन ऐढाच्या, ज़ाले ओलजै नैज ढाऔ माढुदुऊदी, तर बौले जो आढान्या रङौ नकाई याएज ढोवा, दानाङभन्या बौले जो ढोव, ज़ाले नाइज ढोवा। <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />दानाङभन्या बौले आज़ाजन प्रेम ढोवा, ओटन ओले ओलजै आडोएज्यान्या सोगलै काम आज़ाजन थनस्योवा। इकातन महान काम ओले आज़ाजन थनन्यालेया, ओटन जे अचम्म ताइन्यालेच्या। <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />दानाङभन्या जोमनलेस्यु बौले सिन्याङजन जिङदा जाटौर ओटन नकाङजन जिबन योंवर, नैलेस्युज ज़ाले बै जोजन इच्छ्या ढोव, नकाजन जिबन योंवा। <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />दानाङभन्या बौले काङ्काईल निया माढोवदी, तर सोगलै निया ढान्या काम आज़ाजन यांस्यु नाएवा, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />जोमनलेस्यु नकाङै बौल आदर रांढोव। नैलेस्युजै सोगलैले ज़ाल आदर ग्याढोरत्या, ज़ाल आदर माढान्याले ओलजन परिङन्या बौल बै आदर माढोरदी।” <verse eid="JHN 5:23" /><verse number="24" style="v" sid="JHN 5:24" />“मछ्यु, ङा जेजन ऐढाच्या, जोले ङा बचन थटौ ओटन ङाजन परिङन्याल यर्त बिस्वास ढोव, नका सकाए अनन्त जिबन लेया। ना नियाल मारांडी, तर सिइकालतन नका जिबनल रा:स्यु लेया। <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />ङा जेजन मछ्यु, ऐढाच्या, नका बेला रांदा, ओटन ना बेला आकै ज्या, जब सिन्याङै परमेस्वरलं ज़ाल ग़ा थएर, ओटन थएन्याङ बान्चिन्या लेरा। <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />दानाङभन्या जोमनलेस्यु बौ ओलसै जिबनल ले, ओमनलेस्युज बौले आज़ाजन बै आल्योङै जिबनल स्रोट ताइन्या अढिकार यांस्यु नाएवा। <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />ओटन ङाजन ङा बौले नियाल निर्नय ढान्या अढिकार यांस्यु नाटङवा, दानाङभन्या ङा रुल ज़ा हो। <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />ईकात अचम्म तामानिच्यो, दानाङभन्या बेला रांज्याया, जब ऊईल लिज्यान्याङ सोगलैले ओलं ग़ा थएन्या लेरा, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />ओटन ऊईलन बाहेर पलिईस्यु रारां सुकर्म ढान्याङ जिबन पुनरुत्थानल नाल्ट, सनर कुकर्म ढान्याङ सजायल आग्या पुनरुत्थानल नाल्ट जिङदा सोन्यालेरा।”<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="DAN 12:2">दानियल १२:२</ref></char></note><verse eid="JHN 5:29" /></para>
  <para style="s">येशुल गवाइ</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />“ङा ङाईज नैज ढाऔ माढुदुङदी। जो ङा परमेस्वरङन थटङ, ङा नैताइन्याई निया ढोङा, सनर ङा निया ठिक ठहरिया, दानाङभन्या ङा इच्छ्या मारोकङदी, तर ङाजन परिङन्याल इच्छ्या पुरा ढाऔ चाहिङा।”<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“यदि ङा ङाबारेल बयन योंङकन ङा गवाइ सत्य माताइदी। <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />ङा बारेल बयन यांन्या तोलोअ छुट्टै लेया, ओटन ङा ऐसन्ङा, कि ङा बारेल ओले जो गवाइ योंव, ना बयन सत्य ज्या।” <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />“जे यहुन्ना ल्योङ गिनौ जेपरिङचिऊ, ओटन नकाले सत्यल बयन यांस्यु लेया।<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">यहुन्ना १:१९-२७</ref>; <ref loc="JHN 3:27-30">३:२७-३०</ref></char></note> <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />ङा रुल बयन ग्रहन माढोङदी, तर जे उद्दार ग्याताइत्या ऐलेस्यु ईका छेन ङापानज्याङु। <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />यहुन्ना भलाङन्या सनर चम्किन्या बत्ति लेऊ, ओटन जे ओत तचिइ समाय आनन्द मनाइन्या राजि जेताइचिऊ।” <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />“तर ङासकाए जो बयन ले, ना यहुन्नातन घिन्या लेया। दानाङभन्या जो कामयाङ पुरा ढाऔ नाल्ट बौले ङाजन यांस्युलेया, ङा ना काम ढाज्याङा, ओटन नकाले ङा बारेल बयन यांज्याया, कि बौले ङाजन आपरिङ्ङु हो।” <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />ङाजन परिङन्या बौले ओलजै ङा बारेल बयन यांस्यु लेया। आमि ग़ा जे खकै थएस्यु मालेचिदी, ओटन आ अनवार खकै मारङचिदी।<note caller="-" style="x"><char style="xo" closed="false">5:37 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती ३:१७</ref>; <ref loc="MRK 1:11">मर्कुस १:११</ref>; <ref loc="LUK 3:22">लूका ३:२२</ref></char></note> <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />सनर ओलं बचन जेल्योङ मारहिदी, दानाङभन्या जोजन ओले आपरिङौ, जे ओजन बिस्वास माढोचिदी। <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />दानाङभन्या जे ईका यिङसिस्यु पबित्रशास्त्रलं अनन्त जिबन डोएसिया ऐलेस्यु रोअच्या। ङा बारेल बयन यांन्या नाइ पबित्रशास्त्र ज्या। <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />ओटन बै जे जिबन डोटौ नाल्ट ङाल्योङ रांऔ मारोअचिदी।<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“ङा रुयाङल प्रसम्सा ग्रहन माढोङदी, <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />तर ङा ऐसन्ङा कि जे कैताइन्या किसिमला रुयाङ हो, ओटन ङा ऐसन्ङा जे यिङल परमेस्वरलं नाल्ट नैज प्रेम माल्दी। <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />ङा ङा बौल मिनतन रा:स्यु लेङा, तर जे ङाजन ग्रहन माढाङचिदी। छुट्टै जो आ मिनङन रां ओजन जे ग्रहन ढान्यालेच्या।” <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />जे कैलेस्यु बिस्वास ढाऔ ढुदुच्यो, जब कि जे तोलोअले छुट्टैङन जे सम्मान रोअच्या, तर ना सम्मानल खेदा मापरिचिदी, जो तोलोअ याएज परमेस्वरङन डोएसिइ? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />“ईका तायिङसिच्यो, कि ङा बौ लेऊक जेजन दोस लाइच्या। जेजन दोस लाइन्या ता मोशा दी, जोल्योङन जे आस जेढोचिऊ। <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />दानाङभन्या जे मोशाजन बिस्वास जेढान्या ताहकन ङाजन बै बिस्वास ढान्याजेल्चिऊ, दानाङभन्या ओले ङा बारेल सरस्यु आनाटौ। <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />तर जे नकाले आसरन्या छेनयाङ बिस्वास माढोच्योकन, ङा छेन कैलेस्यु बिस्वास ढोच्यो?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">येशुले पास हजारजन आयांइन्या</para>
  <para style="r">
    <ref loc="MAT 14:13-21">मत्ती १४:१३-२१</ref>; <ref loc="MRK 6:30-44">मर्कुस ६:३०-४४</ref>; <ref loc="LUK 9:10-17">लूका ९:१०-१७</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />आका छेनल छिन्ट येशु गालील लेऊका तिबेरियास समुन्दरल हुदिफन हिनौ। <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />ओटन तोलोअ घिन्या हुल येशुल छिन्ट लागिऊ, दानाङभन्या येशुले रोगियाङलयर्त आढान्या अचम्मला कामयाङ नकाङै रांरङौ। <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />येशु डान्डाल हिनौ, ओटन आसिइयाङसं ओङ चुङौ। <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />यहूदीयाङल निस्तार-पर्बल बेला नेरा लेऊ। <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />तब येशुले आमि चारवरदेए आखिमौक तोलोअ घिन्या हुल आलेऊदेए राराज्यान्या रङस्यु फिलिपजन ऐआढोव, “इकाङजन यांहौ नाल्ट गे भरेई काङ लङई?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />येशुले नाजन बिचारस्यु ऐआढोव, दानाङभन्या ओलं जो ढोङा लिज्याऔ, ना ओलजन थाह लेऊ।<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />फिलिपले ओलजन जबाक आयोव, “सोगलैजन तचिचिइ यांसिरकन बै नें सय चान्दील सिक्काल भरेईले नकाङजन योअन्यामाल्दी।” <verse eid="JHN 6:7" /><verse number="8" style="v" sid="JHN 6:8" />येशुल सिइयाङ्ङन तोलोअ, सिमोन पत्रुसलं भाई अन्द्रियासले ऐलेऊ, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“आल तोलोअ केटा लिज्याऔ, नासकाए तामल पास गोटा भरेई सनर नेंलोअ ङा:स्या लिज्याऔ। तर आवाए पुरैल नाल्ट नवाएले नै योक का?” <verse eid="JHN 6:9" /><verse number="10" style="v" sid="JHN 6:10" />येशुले नकाङजन ऐआढोवाङ, “रुयाङजन चुङौ परिङरचिते।” ना पोल भ्याई छी लेऊ। ओटन ओलं छ्योअ पास हजार ल्हेपाङ चुङवाङ। <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />तब येशुले भरेई आहोनौ, ओटन परमेस्वरजन धन्याबाद आयोव ओटन चुङन्याङजन राभाअस्योवाङ, ओटन नैलेस्युई ङा:स्या बै राभाअस्योवाङ नकाङै राचाहिन्या याए रांकयौ। <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />ओटन जब नकाङै भन्दिउ भरि वाङस्यु रांकयौ, येशुले आसिइयाङजन ऐआढोवाङ, यलन्या “आकलाए दुउचिते, ओटन नैज खेर ताटाइत्या।” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />नकाङ कैस्यु रा:सयलन्या ना तामल पास गोटा भरेईल टुक्राङ रादुकौक बारं घोन फाङताहौ। <verse eid="JHN 6:13" /><verse number="14" style="v" sid="JHN 6:14" />ऐताइस्यु येशुले आढान्या आका अचम्मला काम रङस्यु नका रुयाङै ऐलेवाङ, “सङ्सारलं रांन्या अगमबक्ता मछ्यु आकाई ज्या रैस।”<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MAT 21:11">मत्ती २१:११</ref></char></note> <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />नकाङ रा:स्यु ङाजन जबरजस्ति लाङस्यु रय जाटौ रोअज्यावाङ, ऐलेन्या सनस्यु येशु फरि आबाठए डान्डाल हिनौ।<verse eid="JHN 6:15" /></para>
  <para style="s">येशु रील यर्त आबान्या</para>
  <para style="r">
    <ref loc="MAT 14:22-33">मत्ती १४:२२-३३</ref>; <ref loc="MRK 6:45-52">मर्कुस ६:४५-५२</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />ओई ताहापाइना येशुल सिइयाङ समुन्दर ल्योङ हिन्वाङ। <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />ओटन डोङ्गात चरिस्यु नकाङ समुन्दरल हुदिफन कफर्नहुम देए हिन्ङा लेवाङ। नवाए बेला नमचिउस्यु लेऊ, ओटन येशु अझ समन नकाङल्योङ रा:स्यु मालेऊ। <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />ओटन घिन्या आन्ढी आढाऔकाले, समुन्दरल छाल उर्लिऊ तअसिऊ। <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />पास-छ किलोमिटर डोङ्गा हादेए आहिनौ छिन्ट नकाङै येशुजन समुन्दरलयर्त बास्यु डोङ्गाल नेरा आरांज्यान्या रांरङौ, ओटन नकाङ छ्याएवाङ। <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />तर येशुले नकाङजन ऐआढोवाङ, “ङा दी, ताछ्याएच्यो।” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />नकाङै ओलजन हेसाङस्यु डोङ्गाल रासचुनौ, ओटन नकाङ राहिनज्यान्या पोल डोङ्गा ओचोएटै ताप्‌रा:औ।<verse eid="JHN 6:21" /></para>
  <para style="s">रुयाङै येशुजन रारोअन्या</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />समुन्दरल हुदिफन लिज्यान्या रुयाङ हुलले छिन्का छिम्क ओलं तोलोअ याएज डोङ्गा रांरङौ। ओटन येशु नका डोङ्गाल चरिस्यु माहिन्दा, तर आ सिइयाङ याएज हिनस्युलेवाङ। <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />तब तिबेरियासङन अपुर डोङ्गाङ ना पोल नेरा रांवाङ, जोङ प्रभुले धन्याबाद आचराहौ ओटन नकाङै भरेई रांकयौ। <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />येशु सनर आ सिइयाङ ओलं रामालन्या सनस्यु ना रुयाङ येशुजन रोंकौयन डोङ्गाल चरिस्यु कफर्नहुमलं हिन्वाङ।<verse eid="JHN 6:24" /></para>
  <para style="s">येशु जिबनल भरेई</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />रुयाङै येशुजन समुन्दरल हुदिफन्ट डोएस्यु ओलजन रांगिनौ, “रब्बी, नङ खक नरानु?” <verse eid="JHN 6:25" /><verse number="26" style="v" sid="JHN 6:26" />येशुले नकाङजन जबाक यांस्यु ऐआढोवाङ, “मछ्यु ङा जेजन ऐढाच्या जे अचम्मला कामयाङ ङाढान्या रङस्यु माङडी, तर भरेई वाङस्यु जेकयौकाले ङाजन जेरोकङचिऊ। <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />नस्ट ताइन्या जेएल नाल्ट परिस्रम ताढोच्यो, तर अनन्त जिबन समन लिज्यान्या ज्यान्या जन्तुल नाल्ट परिस्रम ढोचिते, जो रुल ज़ाले जेजन यांचिवा। दानाङभन्या परमेस्वर बौले येशुल यर्त छाप लाइस्यु नाएवा।”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />ओयाङै येशुजन ऐराढोव, परमेस्वरले आचाहिन्या काम ढाऔ नाल्ट गे नै धोई। <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />येशुले नकाङजन ऐआढोवाङ, “परमेस्वरलं काम ईकाइ ज्या जोझन ओले आपरिङौ ओजन बिस्वास ढोचिते।” <verse eid="JHN 6:29" /><verse number="30" style="v" sid="JHN 6:30" />नैताइस्यु नकाङै ओलजन ऐराढोव, “नङ नै अचम्मला काम थनन्, गे नका ब्याएया, ओटन नङजन बिस्वास ढासिना? नङ नै ढोन? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />गे शाखापुर्खाङै हरहर ताइन्या पोल मन्न रांज्योव, जोमनलेस्यु पबित्रशास्त्रलं सरसिज्याऔ, ‘ओले नकाङजन ज्याऔ नाल्ट स्वर्गङन भरेई आयोवाङ’।”<note caller="-" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="EXO 16:4-15">प्रस्थान १६:४-१५</ref>; <ref loc="PSA 78:24">भजनसङ्ग्रह ७८:२४</ref></char></note><verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />येशुले नकाङजन ऐआढोवाङ, “ङा जेजन मछ्यु ऐढाच्या, स्वर्गङन भरेई यांन्या मोशा माङडी,” तर “जेजन स्वर्गङन मछ्युका भरेई यांन्या ङा बौ हो। <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />दानाङभन्या परमेस्वरलं भरेई नकाई ज्या, जो स्वर्गङन लांइस्यु रांया, ओटन सङ्सारजन जिबन योंवा।” <verse eid="JHN 6:33" /><verse number="34" style="v" sid="JHN 6:34" />ओयाङै येशुजन ऐराढोव, “प्रभु, गेजन सदाई ईका भरेई यांसिन्ते।” <verse eid="JHN 6:34" /><verse number="35" style="v" sid="JHN 6:35" />येशुले नकाङजन ऐआढोवाङ, “जिबनल भरेई ङाई ज्या। ङाल्योङ रांन्या करेन्या माल्दी ओटन ङाजन बिस्वास ढान्या खकै री ओइन्या माल्दी। <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />तर ङा जेजन ऐढास्युई लेङा, ङाजन जे रङस्युई नाटङच्या, ओटन फरि बै बिस्वास माढाङचिदी। <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />बौले ङाजन आयांन्याङ सोगलै ङाल्योङ रारां, ओटन ङाल्योङ रांन्याङजन ङा कैलेस्यु बै माराहङरदी। <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />ङामिइ इच्छ्या पुरा ढान्याल नाल्ट ङा स्वर्गलन ङालाइराङु माङडी, तर ङाजन परिङन्याल इच्छ्या पुरा ढाऔ नाल्टै ङारांङु। <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />ओटन ङाजन परिङन्याल इच्छ्या ईकाइ ज्या, कि ओले ङाजन आयांन्याङ मध्य काङ्काईजन बै तागवाहङरत्या, तर नकाङजन आखिरी दिनल जिङदा ग्याजाटङत्या। <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />दानाङभन्या ङा बौल इच्छ्या ईकाइ ज्या, कि ज़ाजन खिमन्या सनर ओजन बिस्वास ढान्या सोगलैले अनन्त जिबन ग्याडोटौत्या ओटन ङा नकाङजन आखिरी दिनल जिङदा जाएन्यालेङा।”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />यहूदीयाङ येशुल बिरोदत गनगन लेऊ तअसिवाङ, दानाङभन्या येशुले ऐआढोवाङ, “स्वर्गङन लांइस्युरांन्या भरेई ङाई ज्या।” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />नकाङै ऐलेवाङ, “नैति ईका योसेफल आज़ा, येशु माङडी का? इकाल बौ सनर आअमाजन गे गेमासंईयिउ का? आकअ इकाले कढाई ‘ङा स्वर्गलन लांइस्यु ङारांङु’ ऐलिज्याऔ?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />येशुले नकाङजन जबाक आयोवाङ, “जेजेलं तागनगनाइच्यो। <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />ङाजन परिङन्या बौले माच्योङौरकन काङ्काई ङाल्योङ रांऔ माढुदुरदी, ओटन ङा नकाङजन आखिरी दिनल जिङदा जातङरा। <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />‘ओटन नकाङ सोगलैजन परमेस्वरङन ह्युउसिरा’ ऐलेस्यु अगमबक्ताङल किटापल सरसिस्यु लेया। जोले बौङन थटौ सनर ह्युउसी ना ङाल्योङ रांया।<note caller="-" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="ISA 54:13">यशैया ५४:१३</ref></char></note> <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />बौजन काङ्काई रुले रङस्यु माल्दी, ओले याएजै रङस्यु लेया, जो परमेस्वरङन रा:स्यु ले ओलेई बौजन रङस्यु लेया। <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />मछ्यु ङा जेजन ऐढाच्या, जोले बिस्वास ढोव, नासकाए अनन्त जिबन लेया। <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />ङा जिबनल भरेई हो। <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />जे शाखापुर्खाङै हरहर ताइन्या पोल मन्न रांज्योव ओटन बै नकाङ सिस्यु हिन्वाङ। <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />तर स्वर्गङन लांइस्यु रांन्या भरेई आकाई ज्या, जोले कयौ ना मासिदी। <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />स्वर्गङन लांइस्युरांन्या जिङदा भरेई ङाईज ज्या। काङ्काङै आका भरेई कैदुराभन्या नकाङ सदाई बान्चिन्या लेरा। ओटन जो भरेई ङा सङ्सारला रुयाङल जिबनल नाल्ट योंङा, ना ङा बुल हो।”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />तब यहूदीयाङ रारां छ्योङौ लागिवाङ, “ईका रुले गेजन कढाई आबुल कयौ यांऔ ढुदुऊ?” <verse eid="JHN 6:52" /><verse number="53" style="v" sid="JHN 6:53" />येशुले नकाङजन ऐआढोवाङ, “मछ्यु, ङा जेजन ऐढाच्या, जे रुल ज़ाल बुल माकैच्योकन सनर आजी माओच्योकन, जेस जिबन माताइदी। <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />ङा बुल कैन्या सनर ङा जी ओन्यास अनन्त जिबन लेया, ओटन आखिरी दिनल ङा नकाङजन जिङदा जातङरा। <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />दानाङभन्या ङा बुल मछ्यु कैन्या जन्तु हो, ओटन ङाजी बै मछ्युजै ओन्या जन्तु हो। <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />ङा बुल कैन्या, सनर ङा जी ओन्या ङासकाए लिज्याया, ओटन ङा नकासं लिज्याङा। <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />जोमनलेस्यु जिङदा बौले ङाजन आपरिङ्ङु, ओटन ङा बौल कारनले बान्चिङा, नैलेस्युई ङाजन कैन्या बै ङागर्दाले बान्चिया। <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />जो भरेई स्वर्गङन लांइस्यु रांऔ, ओ नैताइन्या माङडी, जो पुर्खाङै रांकयौ ओटन बै ओयाङ सिस्यु हिन्वाङ। आका भरेई कैन्या सदाईज बान्चिन्यालेया।” <verse eid="JHN 6:58" /><verse number="59" style="v" sid="JHN 6:59" />येशुले ईका छेन कफर्नहुमला यहूदीयाङ आराधना झिमल सिक्छ्या आयांऔक आपानौ।<verse eid="JHN 6:59" /></para>
  <para style="s">अनन्त जिबनल बचन</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />येशुल सिइयाङै ईका राथटौछिन्ट भ्याउयाएले ऐलेवाङ, “ईका बचन कडाई लेया, काङ्काले थटौ ढुदुऊ का?” <verse eid="JHN 6:60" /><verse number="61" style="v" sid="JHN 6:61" />तर सिइयाङ ईका बारेल गनगन लिज्यावाङ ऐलेन्या सनस्यु येशुले नकाङजन ऐआढोवाङ, “नैति ईका छेन जे नाल्ट ठोकरल कारन ताइज्याऔ? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />जे रुल ज़ा हादेए जोङ लिज्याऔ, ओ हर्देए आहिनज्यान्या रङच्योकन कैताह वन? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />जिबन यांन्या परमेस्वरलं आत्मा हो, बुलङन नैज फाइदा माताइदी। जो बचन ङा जेसकाए ङाछ्योङ्ङु, ना आत्मा सनर जिबन हो। <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />तर जे मध्यङन ख्वाए जेल्चिऊ, जोले ङाजन बिस्वास माढाङरदी।” दानाङभन्या बिस्वास माढान्या नैयाङ सनर ओलजन धोखा यांन्या काङ्का ताइन्या लेऊ, ऐलेस्यु येशुजन सुरुकन्ज थाह लेऊ। <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />ओटन ओले ऐलेऊ, “नैताइस्यु जब समन बौले अनुमति मायोव तब समन काङ्काई रु ङाल्योङ रांऔ माढुदुऊदी।”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />नैताइस्यु येशुल सिइयाङ मध्य तबर जना छिन्देए हाएसिवाङ, ओटन ओलसं बान्या राराहौ। <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />येशुले बारं सिइयाङजन ऐआढोवाङ, “नैति जे ङाजन राइस्यु हिनौ जेरोअचिऊ?” <verse eid="JHN 6:67" /><verse number="68" style="v" sid="JHN 6:68" />सिमोन पत्रुसले जबाक आयोव, “औ प्रभु, नल्योङ अनन्त जिबनल बचन लेया ओटन गे नङजन राइस्यु काङ्का ल्योङ हिनई? <note caller="-" style="x"><char style="xo" closed="false">6:68 </char><char style="xt" closed="false"><ref loc="MAT 16:16">मत्ती १६:१६</ref>; <ref loc="MRK 8:29">मर्कुस ८:२९</ref>; <ref loc="LUK 9:20">लूका ९:२०</ref></char></note> <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />ओटन गे बिस्वास ढास्यु लेया, ओटन सनस्युई लेया, कि नङ जिङदा परमेस्वरलं पबित्र ज़ा येशु ज्या।” <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />येशुले नकाङजन जबाक आयोवाङ, “नैति ङा ङाईज जे बारं गोटाङजन ङाछेलन्या माङडी का? ओटन जे मध्यङन तोलोअ दियाबलस हो।” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />येशुले सिमोन इस्करियोतलं ज़ा यहूदाल बारेल आपानौ, दानाङभन्या बारं गोटा मध्यलन तोलोअ याएज ताइस्यु बै नकाले येशुजन धोखा योंङालिज्याऔ।<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">येशु सनर आभाईयाङ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />ओलं छिन्ट येशु गालीलल बारिज्याऔ, तर ओलं यहूदिया हिनौ माचाहिदा, दानाङभन्या यहूदी अढिकारीयाङ ओलजन सएन्या दाउत लेवाङ। <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />आब यहूदीयाङल छाप्रा-बाईपोल पर्ब नेरा लेऊ।<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="LEV 23:34">लेवी २३:३४</ref>; <ref loc="DEU 16:13">ब्यबस्था १६:१३</ref></char></note> <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />नैताइस्यु येशुल भाईयाङै ओलजन ऐराढोव, “ईका पो राइस्यु यहूदिया हिनन्ते, ओटन नङ नढाज्यान्या काम नसिइयाङै बै ग्यारङरत्या। <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />जो रुले मान डोटौ रोंकौ, नाले गोप्यल काम माढोवदी। नङ आका कामयाङ ढोनकन नङझन्जै सङ्सारलं थन्ते।” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />दानाङभन्या आभाईयाङ बै ओजन बिस्वास माढोरदी। <verse eid="JHN 7:5" /><verse number="6" style="v" sid="JHN 7:6" />येशुले नकाङजन ऐआढोवाङ, “ङामि चान्या समाय अझ रा:स्यु माल्दी, तर जे नाल्ट ता सोगलै समाय चान्याई लेया। <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />जेजन सङ्सारले सज्युउ माढुदुऊदी, तर ङाजन ता सज्युङरा, दानाङभन्या सङ्सारला बारेल नाल कामयाङ दुस्ट लेवाङ, ऐलेस्यु ङा बयन योंङा। <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />आका पर्बल जे हिन्चिते। ङा ईका पर्बल माहिनङदी, दानाङभन्या ङा समाय अझ पुरा ताइस्यु माल्दी।” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />नकाङजन ऐढास्यु येशु गालीललै लिज्याऔ।<verse eid="JHN 7:9" /></para>
  <para style="s">छाप्रा पर्बल येशु</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />तर पर्ब छिम्क भाईयाङ हिन्‌रा पाइना येशु बै थनसिस्यु माङडी, तर गोप्यल हिनौ। <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />पर्बल यहूदी अढिकारीयाङै येशुजन रोअज्यावाङ, ओटन “येशु काङ लिज्याऔ?” ऐलेस्यु गिनज्यावाङ।<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />रुयाङ हुलल खार्ल आबारेल चर्चा ताहौ लागिऊ। काङ्काङै ऐलिज्यावाङ, “ओ चान्या लेया।” फरि अपुऱ्याङै ऐलिज्यावाङ, “माङडी, इकाले रुयाङजन भरमल पराइज्याऔ।” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />तर यहूदी अढिकारीयाङल छ्याइले येशुल बारे काङ्काई खुल्लमखुल्ला माछ्योङदुरा।<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />पर्बल खार्ल येशु यरुशलेम मन्दिर भितर हिनस्यु सिक्छ्या ह्युउकौ तअसिऊ।<verse eid="JHN 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 7:15" />यहूदी अढिकारीयाङ अचम्म ताइस्यु ऐराढोव, “नैज मापरीस्यु इकाले कढाई आवाए बिद्या आडोटौ।” <verse eid="JHN 7:15" /><verse number="16" style="v" sid="JHN 7:16" />तब येशुले जबाक यांस्यु नकाङजन ऐआढोवाङ, “ङा सिक्छ्या ङामिइ माङडी, तर परमेस्वरङन्ता हो, जोले ङाजन आपरिङ्ङु। <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />यदि काङ्का रुयाङै परमेस्वरलं इच्छ्या पालन धोरकन, ङासिक्छ्या परमेस्वर ङन्ताङन, सन् ङा तरफङन ऐलेस्यु नकाङै सनन्यालेरा। <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />जोले आतरफङन छ्योङ, ओले सम्मान रोअवा, तर जोले ओलजन परिङन्याल सम्मान रोंकौ, ना सत्य लेया, सनर नका ल्योङ छल माल्दी। <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />ओक्या मोशाले जेजन ब्यबस्था आमायांचिऊ? तर जे काङ्काईले ना ब्यबस्था पालन माढोचिदी। जे दानाङ ङाजन सएन्या कोशिस ढाज्याच्यो?” <verse eid="JHN 7:19" /><verse number="20" style="v" sid="JHN 7:20" />रुयाङै जबाक रांयोव, “नङ दुस्टआत्मा लागिस्यु नल्‌नु। नङजन काङ्काले सटौ रोअज्याऔ?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />येशुले जबाक यांस्यु नकाङजन ऐआढोवाङ, “ङा तोलोअ अचम्मला काम ङाढोङु, ओटन जे सोगलै इकातं अचम्म जेमानिचिऊ। <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />मोशाले जेजन खटनाल नियाम आयांचिऊ, (तब बै ना मोशाल तरफङन ता माङडी, तर जे पुर्खाङन हो), ओटन बै फरि शबाथ-छिम्क जे ल्हेपाङल खटना ढोचिरा।<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="GEN 17:10-13">उत्पत्ति १७:१०-१३</ref>; <ref loc="LEV 12:3">लेवी १२:३</ref></char></note> <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />यदि जोले मोशाल ब्यबस्था भङ्ग ताटाइत्या लेस्यु, शबाथ-दिन छिम्क खटना ढोवकन, ङाजन तोलोअ रु शबाथ-दिन छिम्क आसबेलौ ऐलेस्यु, जे ङासकाए जेयिङ चोन्या?<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="JHN 5:9">यहुन्ना ५:९</ref></char></note> <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />अनवार खिमस्यु निया ताढोच्यो, तर ठिकसं निया ढोचिते।”<note caller="-" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="ISA 11:3">यशैया ११:३</ref>; <ref loc="JHN 8:15">यहुन्ना ८:१५</ref></char></note><verse eid="JHN 7:24" /></para>
  <para style="s">नैति नका येशुका रों</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />यरुशलेमला ख्वाएयाए रुयाङै ऐलेवाङ, “नैति ईका नकाई माङडी, जोजन यहूदी अढिकारीयाङै सटौ रारोकौ? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />खिम्चिते, ईका ता खुल्लमखुल्ला छ्योङज्याया, तर नकाङ इकाजन गाएगुइ माढोरदी! नैति आका जै ख्रीस्ट ज्या ऐलेस्यु यहूदी अढिकारीयाङ मछ्यु रा:सन्दुऊ। <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />तर जब ख्रीस्ट रंनौ, ईका रु काङन रांऔ। काङा हो ऐलेस्यु काङ्काईले मासनरडी।”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />तब येशु यरुशलेम मन्दिरलं आह्युउज्याऔक, ओले बअजोरसै छ्योङौ, “जे ङाजन जेसहङचिऊ, ओटन ङा काङन ङारांङु, ना बै ऐसनच्या, ङा ङामिइ इच्छ्याले ङारांन्या माङडी, तर जोले ङाजन आपरिङ्ङु ओ सत्य लेया। जे ओजन माशईचिदी, <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />तर ङा बौजन ऐशईङा, दानाङभन्या ङा आल्योङन ङारांङु, ओटन ओइले ङाजन आपरिङ्ङु।” <verse eid="JHN 7:29" /><verse number="30" style="v" sid="JHN 7:30" />आवाए छ्योङापाइना नकाङै येशुजन कोलोकौ रारोकौ, तर काङ्काईले आयर्त कुई माझोअदुरा, दानाङभन्या ओलं समाय अझ रा:स्युमालेऊ। <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />तर हुलला भ्याई रुयाङै ओजन बिस्वास रांढोव। नकाङै ऐलेवाङ, “जब ख्रीस्ट रां, तब ओले इकाले आढान्या अचम्मला कामतन भ्याई अचम्मला काम ढोवाहोला का?”<verse eid="JHN 7:31" /></para>
  <para style="s">येशुजन कोलोकौ नाल्ट सिपाइयाङजन रापरिङवाङ</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />हुलले येशुल बारेल चर्चा राढाज्यान्या फरिसीयाङै राथटौ। तब मुख्या पुजाउरोयाङ सनर फरिसीयाङै ओलजन कोलोकौ नाल्ट सिपाइयाङजन रापरिङवाङ। <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />येशुले नकाङजन ऐआढोवाङ, “अझ तचिइ छिन्ङ समन ङा जेस लिज्याङा, ओलं छिन्ट ङा ङाजन परिङन्या ल्योङ हिन्ङा। <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />जे ङाजन रोअन्या लेच्या, तर माडोटङचिदी, ओटन जोङ ङा लेङ, ओङ जे रांऔ माढुदुचिदी।”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />तब यहूदी अढिकारीयाङै रारांल ऐलेवाङ, “ईका काङ हिनन्या आन्तिज्याऔ, ओटन गे आकाजन गेमाडोएयिउ? सन् आका ग्रीकयाङल<note caller="+" style="f"><char style="fr" closed="false">7:35 </char><char style="ft" closed="false">यूनानी=ग्रीक ऐढासिन्या छ्योङन्या रुयाङल भासा सनर पोल मिन</char></note> सहरल तत्तर-बित्तर ताइस्यु चुङज्यान्या यहूदीयाङ ल्योङ हिनस्यु ग्रीकयाङजन ह्युउकौ रोअज्याऔ? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />आकाले आछ्योङन्या ईका नैति रैस? ‘जे ङाजन रोअच्या तर माडोएचिदी, ओटन ङा जोङ लेङ जे ओङ रांऔ माढुदुचिदी?’”<verse eid="JHN 7:36" /></para>
  <para style="s">जिबन यांन्या रील मुल</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />आब पर्बल छिन्का छिम्क, अथाबा पर्बल मुख्या दिन छिम्क, च्याङस्यु येशुले घिन्या ग़ाले ऐआढोवाङ, “यदि जो ओ ना ङाल्योङ ग्यारांत्या ओटन ग्याओवत्या।<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="LEV 23:36">लेवी २३:३६</ref></char></note> <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />जोले ङाजन बिस्वास ढोव, पबित्रशास्त्रले आपानन्या अनुसार ‘नकाल यिङलन जिङदा रील भईयाङ बगिस्यु पलिईन्या लेरा।’”<note caller="-" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EZK 47:1">इजकिएल ४७:१</ref>; <ref loc="ZEC 14:8">जकरिया १४:८</ref></char></note> <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />तर ईका छेन येशुले पबित्र आत्माल बारेल आपानौ, जो पबित्र आत्मा यर्त बिस्वास ढान्याङै डोएङा लिज्यावाङ। दानाङभन्या पबित्र आत्मा आकअ समन यांस्यु माल्सिदी, दानाङभन्या येशु नाबेला समन महिमालं नाल्ट माछेन्सिऊ।<verse eid="JHN 7:39" /></para>
  <para style="s">रुयाङ खार्ल यिसीइ</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />ईका छेन थएन्या काङ्का-काङ्का रुयाङै ऐलेवाङ, “ईका ता मछ्युकाई अगमबक्ता ज्या।”<note caller="-" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="MAT 21:11">मत्ती २१:११</ref></char></note> <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />अपुऱ्याङै ऐलेवाङ “ईका ख्रीस्ट ज्या।” तर काङ्का-काङ्काङै ऐलेवाङ, “नैति ख्रीस्ट गालीलङन रांया का? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />नैति पबित्रशास्त्रले पानस्यु मालेऊ, कि ख्रीस्ट दाऊदल बङशङन सनर दाऊदलै बेथलेहेम सहरङन रांया?”<note caller="-" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="MIC 5:2">मीका ५:२</ref>; <ref loc="2SA 7:12">२शमूयल ७:१२</ref></char></note> <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />ऐताइस्यु रुयाङ रारां येशुल कारनले भाअसिवाङ। <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />नकाङ मध्य ख्वाएले येशुजन कोलोकौ रारोकौ, तर आयर्त काङ्काईले बै हात रांमाझोअदुऊ।<verse eid="JHN 7:44" /></para>
  <para style="s">यहूदी अढिकारीयाङल अबिस्वास</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />तब सिपाइयाङ सनर मुख्या पुजाउरोयाङ, फरिसीयाङ ल्योङ रांवाङ। नकाङै इकाङजन ऐराढोवाङ “जे येशुजन दानाङ माहोनच्यो?” <verse eid="JHN 7:45" /><verse number="46" style="v" sid="JHN 7:46" />पाल्याङै जबाक रांयोव, “ईका रुले मनताइन्या ता काङ्काई रुले खकै माछ्योङदा!” <verse eid="JHN 7:46" /><verse number="47" style="v" sid="JHN 7:47" />फरिसीयाङै नकाङजन ऐराढोवाङ, “जेजन बै राबहकाइचिऊ सन् नैति? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />नैति यहूदी अढिकारीयाङ अथाबा फरिसीयाङ मध्य काङ्काङै ओजन बिस्वास ढास्यु लेवाङ? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />तर जोले मोशाल ब्यबस्था मासनौ, ना परमेस्वरङन स्रापित हो।”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />नकाङ मध्य तोलोअ निकोदेमस मिनला फरिसी, जो हाक तपाला येशु ल्योङ रा:स्यु लेऊ, नकाले ऐलेऊ,<note caller="-" style="x"><char style="xo" closed="false">7:50 </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">यहुन्ना ३:१-२</ref></char></note> <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“नैति गे ब्यबस्थालं हादेए रुल गवाइ नकाले नैआढोव ना माथएस्युईज, नका सजायल लायकला ठहराइवा का?” <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />नकाङै ओजन जबाक रांयोव, “नैति नङ बै गालीलला रु हो? पबित्रशास्त्र रोअस्यु खिम्ते, ओटन नङ रङना, कि गालीलङन अगमबक्ता पलिईस्यु मारांडी।” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />तब सोगल रुयाङ राझिम-राझिमदेए हिन्वाङ।<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">ब्यबिचारत कोलोअसिन्या मेएमा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />तर येशु जैतुन डान्डात हिनौ। <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />ओलं छकाल्याई यरुशलेम मन्दिर देए वलौ, ओटन सोगलै रुयाङ आल्योङ रांवाङ ओटन चुङौ, ओटन नकाङजन आह्युउवाङ। <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />शास्त्रीयाङ सनर फरिसीयाङै तोलोअ मेएमाजन ब्यबिचार आढाज्याऔक कोलोअस्यु राहोनौ, ओटन नाजन रुयाङ खार्ल रा:सच्यानौ। <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />नकाङै येशुजन ऐराढोव, “औ गुरु, ईका मेएमाले ब्यबिचार आढोवका गेकोलोअयिउ। <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />ब्यबस्थालं नियाम अनुसार मोशाले गेजन ऐटाइन्या मेएमाजन लुङले टुपन्या आग्या यांस्यु नाटैवा। इकाल बारेल नङ नै पानन्?”<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="LEV 20:10">लेवी २०:१०</ref>; <ref loc="DEU 22:22-24">ब्यबस्था २२:२२-२४</ref></char></note><verse eid="JHN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 8:6" />तर नकाङै येशुजन बिचारौ नाल्ट सनर आयर्त दोस लाहौ ढुदुसिऊसन लेस्यु ऐराढोव। येशुले गोम लेस्यु नामल कुईसैले आसरौ। <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />तर नकाङै च्याङस्यु येशुजन रांगिनौ, तब येशुले च्याङस्यु नकाङजन ऐआढोवाङ, “जेङन जो चोखा ले, नकाईले ना मेएमाजन हादेए लुङले ग्यातुपौत्या।” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />ओटन फरि बै गोम लेस्यु येशुले नामल कुईसैले आसरौ। <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />तर जब नकाङै ईका राथटौ, तब सेरयाङ्ङन सुरु ढास्यु लुलल्याङ समन तो-तोलोअ ङन हिन्वाङ ओटन येशु नका मेएमासकाए आबाठए लिज्याऔ, ओटन ना मेएमा आहाक च्याङज्याऊ।<verse eid="JHN 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 8:10" />येशुले नका मेएमाजन ब्याएस्यु ऐआढोव, “ऐ मेएमा, नकाङ कान्देए हिन्वाङ? नैति काङ्काईले नङजन सजाय रांमायानू?” <verse eid="JHN 8:10" /><verse number="11" style="v" sid="JHN 8:11" />नकाले ऐलेऊ, “प्रभु, काङ्काईले मायांदुङरा।” येशुले ऐआढोव, “ङा बै नङजन सजाय मायान्दी। हिनन्ते, फरि पाप ताढो।”<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">ईका बचन यहुन्ना २१:२४; लूका २१:३८; यहुन्ना ७:३६ ल बै लेया।</char></note><verse eid="JHN 8:11" /></para>
  <para style="s">येशु सङ्सारला ज्योति</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />येशुले फरिसीयाङजन आढोवाङ, “ङा सङ्सारला ज्योति हो। जो ङाछिन्ट बा नका चिऊन्याल मालिज्यादी, तर नकाले जिबनल ज्योति डोएन्यालेया।”<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 5:14">मत्ती ५:१४</ref>; <ref loc="JHN 9:5">यहुन्ना ९:५</ref></char></note><verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />तब फरिसीयाङै येशुजन ऐराढोव, “नङ नबारेल बयन नयांज्यानु। न गवाइ सत्य माठहरिदी।”<note caller="-" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="JHN 5:31">यहुन्ना ५:३१</ref></char></note><verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />येशुले जबाक आयोवाङ, “ङा ङामिइज बारेल बयन योंङा, ओटन बै ङा बयन सत्य लेया। ङा ऐसन्ङा, कि ङा काङन ङारांङु, ओटन ङा कान्देए ङाहिनज्याङु। तर जे मासन्चिदी, ङा काङन ङारांङु, या ङा कान्देए ङाहिनज्याङु। <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />जे मनवाल नजरले निया ढोच्या। ङा काङ्काईल निया माढोङदी। <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />ङा निया ढोङ्कन बै, ङा निया सत्य ठहरिया। दानाङभन्या निया ढान्या ङा ङाबाठए मालेङदी, तर ङा सनर ङाजन परिङन्या बौ लेच्या। <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />जे ब्यबस्थालं बै नेंलोअ रुनेंल बयन सत्य ठहरिया ऐलेस्यु सरसिस्यु लिज्याया।<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="DEU 19:15">ब्यबस्था १९:१५</ref></char></note> <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />ङाबारेल ङा ङाईज बयन योंङा, ओटन ङाजन परिङन्या बौले ङाबारेल बयन योंवा।” <verse eid="JHN 8:18" /><verse number="19" style="v" sid="JHN 8:19" />नकाङै येशुजन ऐराढोव, “न बौ काङ लिज्याऔ?” येशुले जबाक आयोवाङ, “जे न त ङाजन सहङच्यो न ङा बौजन। जे ङाजन जेशईन्या ताहकन ङा बौजन बै शईदुच्याहोला।”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />ईका छेन येशुले यरुशलेम मन्दिरलं सिक्छ्या आयांज्याऔक भिटी चराइन्या बेदील लेऊक ऐलेऊ। ओटन काङ्काईले ओलजन माकोलोदुरा, दानाङभन्या येशुल बेला अझै ताइस्यु मालेऊ।<verse eid="JHN 8:20" /></para>
  <para style="s">ङा जोङ हिनङ जे ओङ हिनौ माढुदुचिदी</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />येशुले फरि नकाङजन ऐआढोवाङ, “ङा ङाहिनौ छिन्ट जे ङाजन रोंकङच्या, ओटन जे पापले सिच्या। जोङ ङा हिनङ, जे ओङ रांऔ माढुदुचिदी।”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />नैताइस्यु यहूदी अढिकारीयाङै ऐराढोव, “ईकाले आत्महत्या ढोङा लेऊसन नैति? दानाङभन्या इकाले ‘जोङं ङा हिनङ, जे ओङ हिनौ माढुदुचिदी’ ऐलिज्याऔ।”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />ओटन येशुले नकाङजन ऐआढोवाङ, “जे मिङाङ हो। ङा हर्ङा हो। जे ईका सङ्सारलाङ हो। ङा ईका सङ्सारला माङडी। <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />ङा जेजन ऐङाढाचिऊ, जे जेपापलेई सिन्यालेच्या, दानाङभन्या ङा ओइज ज्या ऐलेस्यु जे बिस्वास माढोच्योकन जे पापलेई सिन्यालेच्या।”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />ओयाङै येशुजन रांगिनौ, “नङ काङ्का वन?” येशुले नकाङजन ऐआढोवाङ, “ङा ओइज ज्या, जो ङा जेजन सुरुकन्जै पानस्याज्याच्या। <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />ङा जे बारेङन पानन्या सनर निया ढान्या भ्याई लेया। तर ङाजन परिङन्या सत्य लेया, ओटन ओल्योङन ङा जो ङा थएङु नाइज छेन ङा सङ्सारजन पानस्योङा।,”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />येशुले बौल बारेल आपानौ हो, ऐलेस्यु ओयाङै माबुजिदुरा। <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />ऐताइस्यु येशुले ऐलेऊ, “जब जे रुल ज़ाजन हर्देए छेनच्यो, ङा ओइज ज्या लेस्यु जे सनन्यालेच्या, ओटन ङा ङामिइ अढिकारङन नैज माढोङदी, तर बौले आह्युउन्या छेनयाङ छ्योङा लेस्यु सनन्यालेच्या। <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />ङाजन परिङन्या ङाईसं लिज्याया। ओले ङाजन ङाबाठए राइस्यु मानाएङुदी, दानाङभन्या ङा सदाई ओलजन खुशी जाएन्या काम ढोङा।” <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />येशुल छेन थएन्याङ भ्याईले ओलजन बिस्वास रांढोव।<verse eid="JHN 8:30" /></para>
  <para style="s">सत्यले जेजन स्वतन्त्र जाएचिवा</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />येशुले ओलं बिस्वास ढान्या यहूदीयाङजन ऐआढोवाङ, “जे ङा बचनत लिज्याच्योकन जे मछ्यु ङा सिइयाङ ज्या। <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />तब जे सत्य नैति ना सनच्या, ओटन सत्यले जेजन स्वतन्त्र जाएचिवा।”<note caller="-" style="x"><char style="xo" closed="false">8:32 </char><char style="xt" closed="false"><ref loc="1CH 4:38">१इतिहास ४:३८</ref></char></note><verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />नकाङै ओलजन जबाक रांयोव, “गे अब्राहामल सन्तानयाङ हो, ओटन आकअ समन काङ्काईल सेवाऱ्या ताइस्यु मालेईदी। ‘जे स्वतन्त्र ताइन्यालेच्या’ ऐलेस्यु नङ कढाई ऐनलज्यानु?”<note caller="-" style="x"><char style="xo" closed="false">8:33 </char><char style="xt" closed="false"><ref loc="MAT 3:9">मत्ती ३:९</ref>; <ref loc="LUK 3:8">लूका ३:८</ref></char></note><verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />येशुले नकाङजन जबाक आयोवाङ, “ङा जेजन मछ्यु ऐढाच्या, पाप ढान्या सोगल पापल सेवाऱ्या ज्या। <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />सेवाऱ्या ता सदाईज झिमल मालिज्यादी, तर ज़ा ता सदाईज झिमलै लिजिया।<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="GAL 4:30">गलाती ४:३०</ref></char></note> <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />नैताइस्यु ज़ाले जेजन स्वतन्त्र जाएचिऊकन जे पक्का बै स्वतन्त्र ऐताइच्या। <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />ङा ऐसन्ङा, जे अब्राहामल सन्तानयाङ ज्या। तर जे ङाजन सटौ रोअज्याच्या, दानाङभन्या ङा बचनले जेल्योङ पोइज माडोटौदी। <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />ङा बौल्योङन जो ङारङ्ङु, ङा नाइ पानङा। ओटन जे बै जो जेबौल्योङन जेथएचिऊ, नाइ ढोच्या।” <verse eid="JHN 8:38" /><verse number="39" style="v" sid="JHN 8:39" />नकाङै ओलजन ऐराढोव, “गे बौ ता अब्राहाम ज्या,” येशुले नकाङजन ऐआढोवाङ, जे अब्राहामल सन्तान ताइच्योकन अब्राहामले जो काम ढोव, “जे बै ओइज काम ढोदुच्याहोला। <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />ङा परमेस्वरङन ङा थएन्या सत्य छेन जेजन पानस्याज्याच्या, तर आकअ जे ङाजन सटौ रोअज्याच्या। अब्राहामले ऐटाइन्या काम माढोडा। <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />जे बौले जो आढोव जे नकाई काम ढोच्या।” नकाङै येशुजन ऐराढोव, “गे ब्यबिचारङन जर्मिन्याङ माङडी! गे बौ तोलोअजै ज्या, ओ परमेस्वर हो।”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />येशुले नकाङजन ऐआढोवाङ, “परमेस्वर जे बौ ताहकन्ता जे ङाजन प्रेम ढाङच्याहोला, दानाङभन्या ङा परमेस्वरङन ङारांङु। ङा ङामि इच्छ्याले ङारांन्या माङडी, तर ओले ङाजन आपरिङ्ङु हो। <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />जे ङापानन्या दानाङ माबुजिच्यो? दानाङभन्या जे ङा बचन थटौ माढुदुचिदी। <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />जे बौ दियाबलसजै ज्या। ओटन ऐकाता जे बौल इच्छ्या पुरा ढान्या जे यिङ लेया। ना ता सुरुकन्ज साइढवा लेऊ, ओटन सत्यस नकाजन नैज मतलब माल्दी। दानाङभन्या नका सकाए नैज सत्य माल्दी। जब नाले ग्वारस्यु छ्योङौ, नकाले आबानि अनुसार छ्योङा, दानाङभन्या ना ग्वारवा हो, ओटन ग्वारवाल बौ हो।<note caller="-" style="x"><char style="xo" closed="false">8:44 </char><char style="xt" closed="false"><ref loc="ACT 13:10">प्रेरित १३:१०</ref></char></note> <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />तर ङा सत्य छ्योङ्ङा, नैताइस्यु जे ङाजन बिस्वास माढाङचिदी। <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />जेमध्यलन ङाजन नङ पापल दोसी नल्‌नु ऐलेस्यु काङ्काले प्रमानित जाटौ जेढुदुचिऊ? यदि ङा सत्य छ्योङ्ङकन, जे ङाजन दानाङ बिस्वास माढोच्योवन? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />जो परमेस्वरलं तरफङन रां, नकाले परमेस्वरलं बचन थएवा। जे परमेस्वरलं माङडी, नैताइस्यु माथएचिदी।”<verse eid="JHN 8:47" /></para>
  <para style="s">येशु सनर अब्राहाम</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />यहूदीयाङै येशुजन जबाक रांयोव, “नैति आका गे छेन ठिक माङडी, कि नङ सामरी ज्या, ओटन नङजन दुस्टआत्मा लागिस्यु लेऊ?” <verse eid="JHN 8:48" /><verse number="49" style="v" sid="JHN 8:49" />येशुले जबाक आयोवाङ, “ङा दुस्टआत्मा लागिस्यु मालेङदी, तर ङा ङामि बौल आदर ढोङा, सनर जे ङामि आदर माढोचिदी। <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />तर ङा ङामिइज महिमा मारोकङदी, तोलोअ लेया जोले महिमा रोअवा ओटन निया ढोवा। <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />ङा जेजन मछ्यु ऐढाच्या, यदि जोले ङा बचन पालन ढोव नका खकै सिन्यामाल्दी।”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />यहूदीयाङै येशुजन ऐराढोव, “आब गेजन थाह ताइदा कि नङ पक्का दुस्टआत्मा नलागिनुज्या। अब्राहाम सिऊ, ओटन अगमबक्ताङ बै सिवाङ, तर नङ ऐलिज्याना, कि ‘जोले ङा बचन पालन ढोव, नकाले खकै सिन्या डारन्या माल्दी।’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />नैति गे शाखा अब्राहामतन नङ घिन्या रों? ओ ता सिदा, ओटन अगमबक्ताङ बै सिदुरा। नङकने नङझन्जै ङा काङ्का ऐलेस्यु दाबि ढाज्याना?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />येशुले जबाक आयोवाङ, “यदि ङा ङामिइज महिमा ढोङ्कन ङामहिमा दाङजै ताहा। ङाजन महिमा यांन्या ङा बौज लेया, जोजन जे ‘गे परमेस्वर’ ऐजेढोचिऊ। <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />जे ओजन माशईचिदी, ङा ओजन शईङा। ङा ओजन मासहङदी ऐलेदुङा भन्या जेमन्जै ग्वारवा ताइङा। तर ङा ओजन ऐशईङा, ओटन नैताइस्यु ओलं बचन पालन ढोङा। <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />जे शाखा अब्राहाम ङा दिन रङौ नाल्ट टेकाटेक ताइस्यु लेऊ, ओटन नकाले रङस्यु हेसाङौ।” <verse eid="JHN 8:56" /><verse number="57" style="v" sid="JHN 8:57" />नैताइस्यु यहूदीयाङै येशुजन ऐराढोव, “नङ अझै पचास बर्स योअस्यु मालेन्दी, नैति नङ अब्राहामजन रङस्यु नल्‌नु?” <verse eid="JHN 8:57" /><verse number="58" style="v" sid="JHN 8:58" />येशुले नकाङजन ऐआढोवाङ, “मछ्यु ङा जेजन ऐढाच्या, अब्राहाम आजर्मिऊ हादेएजै ङा ङाल्ङु।” <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />तब नकाङै ओलजन टुपङा लेस्यु लुङ रात्युकौ, तर येशु मोअसिस्यु मन्दिरलन बाहेर पलिईस्युहिनौ।<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">येशुले जर्मिऊकन्ता अन्ढलाजन आसबेलौ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />जब येशु बाऔयन आढाज्याऔक तोलोअ आजर्मिऊ कन्ज अन्ढला रुजन आरङौ, <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />आसिइयाङै ओजन रांगिनौ, “रब्बी, काङ्काले पाप आढोव, इकाले सन् इकाल आमा-बौले, ओटन ईका अन्ढला ताइस्यु जर्मिऊ?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />येशुले जबाक आयोवाङ, “न त इकाले पाप आढोव न इकाल आअमा-बौले, तर ऐताइस्यु अन्ढला ताहौ कि ईका रुल जिबनतन परमेस्वरलं सक्तिल काम ग्यारंनत्या। <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />ङाजन परिङन्याल कामयाङ गे लाअकैज ढान्याताहौ। रिउ ताहकन काङ्काईले काम ढाऔ माढुदुरदी। <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />जब समन ङा सङ्सारलं लिज्याङ, तब समन ङा सङ्सारला ज्योति हो?”<note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="MAT 5:14">मत्ती ५:१४</ref>; <ref loc="JHN 8:12">यहुन्ना ८:१२</ref></char></note><verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />येशुले ईका छेन पानस्यु नामल आठिलौ, ओटन ठिलले व्म चरिन्या जाएस्यु नकाल म्युउल आठिइस्याङु। <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />ओटन येशुले नकाजन ऐआढोव, “हिनन्ते सिलोआमला पोखराअल हुर्ते” (सिलोआमल अर्थ हो, परिङसिन्या) नकाले हिनस्यु आहुरौ, ओटन रङन्या ताइस्यु वलौ।<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="ISA 35:5">यशैया ३५:५</ref></char></note> <verse eid="JHN 9:7" /><verse number="8" style="v" sid="JHN 9:8" />नकाल आडेरालाङ सनर नकाजन बया आनीन्या रङन्याङै ऐलेवाङ, “नैति ईका रु चुङस्यु बया नीन्या रु ईकाइ माङडी?” <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />काङ्का-काङ्काङै ऐलेवाङ “ईका नकाई ज्या।” अपुऱ्याङै ऐलेवाङ, “माङडी, ईका नका मनताइन्याई रंना।” नकाले ऐलेऊ, “ङा नकाई रु ज्या।” <verse eid="JHN 9:9" /><verse number="10" style="v" sid="JHN 9:10" />तब नकाङै ओजन रांगिनौ, “नङ कढाई नरङनु वन?” <verse eid="JHN 9:10" /><verse number="11" style="v" sid="JHN 9:11" />नकाले जबाक आयोवाङ, “येशु ऐढासिन्या तोलोअ रुले व्मजन चरिन्या जाएस्यु ङा म्युउल आठिइस्याङु, ओटन ‘सिलोआमल हिनस्यु हुर्ते आढाङु।’ ओटन हिनस्यु ङाहूरङु, ओटन ङा रङन्या ङाताइङु।” <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />नकाङै ओजन ऐराढोव, “नका काङ लिज्याऔ वन?” नकाले ऐआढोवाङ, “ङा मासनङदी।”<verse eid="JHN 9:12" /></para>
  <para style="s">फरिसीयाङ्ङन अन्ढलाजन आबेलन्याल बारेल ग्यानगिन</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />हादेए नका अन्ढला रुजन नकाङै फरिसीयाङ ल्योङ राहोनौ। <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />जो दिन येशुले व्म चरिन्या जाएस्यु नकाल म्युउ आफएस्योव ना शबाथ-दिन लेऊ। <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />फरिसीयाङै नकाजन रांगिनौ, “नङ कैलेस्यु रङन्या नताइनु?” नकाले ओयाङजन ऐआढोवाङ, “ओले ङा म्युउल चरिन्या व्मले आसेपस्याङु का, ङाहूरङु ओटन रङन्या ङाताइङु।”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />फरिसीयाङ्ङन काङ्का-काङ्काङै ऐलेवाङ, “ना रु परमेस्वरङन रांन्या माङडी, दानाङभन्या नकाले शबाथ-दिन पालन माढोडा।” तर अपुऱ्याङै ऐलेवाङ, “कढाई पापी रुले ऐटाइन्या अचम्मला कामयाङ ढाऔ ढुदुऊ?” ओटन नकाङल खार्ल भाअसिइ ताहौ।<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />तब नकाङै ना अन्ढलाजन फरि रांगिनौ, “ओले न म्युउ फएस्यादुन्वा रैस, आब ओलं बारेल नङ नै पानन्?” नकाले ऐआढोवाङ, “ओ तोलोअ अगमबक्ता हो।”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />नजर डोएन्या रुले आअमा-आबौजन खुल्स्यु मागिनौसमन यहूदी अढिकारीयाङै ईका अन्ढला लेऊ, ओटन रङन्या ताहौ ऐलेस्यु बिस्वास रांमाढोव। <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />तब नकाङै आबौ आअमानेजन रांगिनौ, “नैति ईका झेन ज़ा आ म्युउ मारङन्याई जर्मिऊ ऐझेनलेचिनु? आब कढाई रङौ ढुदुन्या ताहौ?” <verse eid="JHN 9:19" /><verse number="20" style="v" sid="JHN 9:20" />नकाल आमा-बौनेले नकाङजन ऐनेढोवाङ, “घोन ऐसनच्या ईका घोन ज़ा ज्या, ओटन अन्ढलाई जर्मिस्यु लेऊ। <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />तर घोन ईका कैलेस्यु रङन्या ताहौ ऐलेन्या मासन्चिदी, अथाबा इकाल म्युउ काङ्काले आफएस्योव, ना बै घोन मासन्चिदी। इकाल उमेर योअदा, इकाजन जै गिन्चिते। आबारेङन नका ओलजै छ्योङा।” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />नकाल आमा-बौने यहूदी अढिकारीयाङजन रङस्यु छ्याटौने। दानाङभन्या यदि काङ्काङै येशुजन ख्रीस्ट ऐलेस्यु सुइकार ढोरकन, नकानेजन यहूदी आराधना झिमलन पलिईन्याने। ऐलेस्यु यहूदी अढिकारीयाङल सल्ला हादेए जै ताइस्यु लेऊ। <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />नैताइस्यु नकाल आमा-बौनेले ऐनेढोवाङ, “इकाल उमेर योअदा, इकाझन्ज गिन्चिते।”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />तब नकाङै ना अन्ढलाजन नेंपाला खुल्स्यु ऐराढोव, “परमेस्वरलं महिमा योंते। गे ऐसन्या ईका रु पापी हो।” <verse eid="JHN 9:24" /><verse number="25" style="v" sid="JHN 9:25" />नकाले जबाक आयोवाङ, “ओ पापी लेऊसन मालेऊ ङा मासनङदी। तोलोअ याएजै छेन सन्ङा कि ङा पहेला अन्ढला ङाल्ङु तर आकअ ऐरङदुङा।” <verse eid="JHN 9:25" /><verse number="26" style="v" sid="JHN 9:26" />तब नकाङै नाजन ऐराढोव, “ओले नङजन कै आजाएनु? नाले कढाई नम्युउ आफएस्यानू?” <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />“नकाले ओयाङजन जबाक आयोवाङ, ङा जेजन हादेएजै पानस्याचिऊ, तर जे माथएदुच्या। आब फरि दानाङ थटौ रोअच्यो? जे बै ओलं सिइयाङ ताहौ जेरोअचिऊ सन् नैति?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />ओयाङै नाजन सज्याअस्यु ऐराढोव, “नङडी ओलं आ सिइ का, तर गे ता मोशाल सिइयाङ हो। <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />गेजन थाई लेया, मोशा सकाए परमेस्वर छ्योङस्यु लेऊ, तर गे मासनैदी ईका रु काङन रांऔ।” <verse eid="JHN 9:29" /><verse number="30" style="v" sid="JHN 9:30" />नका रुले जबाक यांस्यु नकाङजन आढोवाङ, “कैताइन्या अचम्मला छेन! ओ काङन रांऔ जे मासन्चिऊ, तर ङा म्युउ ओलेई आफएस्याङु ज्या। <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />गे ऐसन्या कि परमेस्वर पापीयाङल छेन माथएस्यौरडी, तर परमेस्वरसं छ्याएन्याङ सनर ओलं इच्छ्या पालन ढान्या रुयाङल छेन परमेस्वरले थएस्यौरा।<note caller="-" style="x"><char style="xo" closed="false">9:31 </char><char style="xt" closed="false"><ref loc="PRO 15:29">हितोपदेश १५:२९</ref></char></note> <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />सङ्सारलं सुरु आताहौकन ऐटाइन्या जर्मिऊकन्ज अन्ढलाल म्युउ काङ्काईले आफएन्या छेन खकै माथएसिदा। <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />यदि नका रु परमेस्वरङन आमारांन्या ताहकन ओले नैज ढाऔ माढुदुऊदीहोला।” <verse eid="JHN 9:33" /><verse number="34" style="v" sid="JHN 9:34" />नकाङै नाजन जबाक यांस्यु ऐराढोव, “नङ ता ऐजै पापल नजर्मिनु, ओटन नैति नङ गेजन ह्युउकौ नरोअनु?” ऐलेस्यु नकाङै नाजन यहूदीयाङल आराधना झिम बाहेर देए रापलिटौ।<verse eid="JHN 9:34" /></para>
  <para style="s">आत्मिक अन्ढला</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />ओयाङै नाजन पाखाल रापलिटौ ऐलेन्या येशुले आठटौ, ओटन नाजन डोएस्यु ऐआढोव, “नैति नङ रुल ज़ाजन बिस्वास नढोनु?” <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />नकाले जबाक यांस्यु ऐलेऊ, “औ प्रभु, ओ काङ्का हो? ङा ओजन बिस्वास ऐढोङा?” <verse eid="JHN 9:36" /><verse number="37" style="v" sid="JHN 9:37" />येशुले नाजन ऐआढोव, “नङ ओजन ऐरङज्याना, सनर नङसं छ्योङज्यान्या ङा ओइ ज्या।” <verse eid="JHN 9:37" /><verse number="38" style="v" sid="JHN 9:38" />तब नकाले ऐलेऊ, “औ प्रभु, ङा बिस्वास ऐढोङा।” ओटन नाले येशुजन ढोक आयोव। <verse eid="JHN 9:38" /><verse number="39" style="v" sid="JHN 9:39" />ओटन येशुले ऐआढोव, “ङा नियालं नाल्ट ईका सङ्सारलं ङारा:ङु हो, जोकि मारङन्याङै ग्यारङरत्या ओटन रङन्याङ अन्ढला ग्याताइरत्या।” <verse eid="JHN 9:39" /><verse number="40" style="v" sid="JHN 9:40" />ईका छेन थएस्यु आलेऊक लिज्यान्या फरिसीयाङ्ङन काङ्का-काङ्काङै येशुजन ऐराढोव, “नैति गे बै अन्ढलाङ वन?” <verse eid="JHN 9:40" /><verse number="41" style="v" sid="JHN 9:41" />येशुले नकाङजन ऐआढोवाङ, “जे अन्ढला जेताइन्या ताहकन पापल दोसी ताइन्या जेमाल्चिऊ, तर जे ‘गे ऐरङया’ ऐलेन्या जिग्राइ ढोच्या, नैताइस्यु जे अझ बै दोसी लेच्या।”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">ग्वालाल आहान</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />“येशुले ऐलेऊ ङा मछ्यु, जेजन ऐढाच्या, जो भेडालं गोठल झलाप तन भितर मापसी, तर छुट्टैङन वूमस्यु पसि, नका गोए सनर डाका हो, <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />तर झलाप तन भितरलं पसिन्या भेडाङलं चान्या ग्वाला हो। <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />पाल्याले आ नाल्ट झलाप फएस्योवा, ओटन भेडाङै आग़ा थएरा, ओटन ओले आभेडाङ मिन पानस्यु-पानस्यु खुलौरा, ओटन नकाङजन पाखाल लाङौरा। <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />जब नकाले सोगलै आभेडाङजन पाखाल पलिटौर, तब नकाङल रां-रां बाया ओटन भेडाङै ओलजन पछ्याइरा, दानाङभन्या नकाङै आग़ा शईरा। <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />तर माशईसिन्या रुजन नकाङ मापछ्याइरदी, बरु नका ल्योङन ढोङरा। दानाङभन्या माशईसिन्या रुल ग़ा नकाङै माशईरदी।” <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />येशुले नकाङजन ईका आहान आपानस्योवाङ, तर ओले नकाङजन आछ्योङस्यान्या छेन नकाङै माबुजिदुरा।<verse eid="JHN 10:6" /></para>
  <para style="s">येशु चान्या ग्वाला</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />येशुले फरि नकाङजन ऐआढोवाङ, ङा जेजन मछ्यु, ऐढाच्या, भेडाङलं झलाप ङाई ज्या। <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />ङातन हादेए रांन्या सोगलै गोएयाङ सनर डाङ्काङ हो, तर भेडाङै नकाङल छेन माथएदुरा।<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="JER 23:1">यर्मिया २३:१</ref>; <ref loc="JHN 10:27">यहुन्ना १०:२७</ref></char></note> <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />झलाप ङाई ज्या, जो रु ङाल्योङन भितरलं पसि ना जोगाइसिया, ओटन बाहेर भितर लेन्या ढोवा, ओटन खर्कल<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="ft" closed="false">बान्जा=खर्क</char></note> लाऔ डोएवा।<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="PSA 118:20">भजनसङ्ग्रह ११८:२०</ref></char></note> <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />“गोए ता कुन्या सनर सएन्या ओटन नास जाएङा लेस्यु रांया। ङा ता नकाङै जिबन ग्याडोएरत्या, ओटन ना तबर ग्याडोएरत्या ऐटाइन्या यिङस्यु ङारांङु हो।”<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />ङा चान्या ग्वाला हो। चान्या ग्वालाले आभेडाङल नाल्ट आपरान अर्पिवा।<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="PSA 23:1">भजनसङ्ग्रह २३:१</ref>; <ref loc="ISA 40:11">यशैया ४०:११</ref>; <ref loc="EZK 34:15">इजकिएल ३४:१५</ref></char></note> <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />भाराला रु ता भेडाङलं रांमिइ ग्वालाङमन माताइदी। नकाले ता फ्याऊ आरांन्या रङस्यु भेडाङजन राइस्यु ना ढोङा, ओटन फ्याऊले भेडाङजन गनज्याइस्यु लाङौरा, ओटन तत्तर-बित्तर जाटौरा। <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />ना ढोङा, दानाङभन्या ना भाराल रु हो, नकाले भेडालं नैज मतलब माढोवदी।<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14" />“ङा चान्या ग्वाला हो, ङा ङा भेडाङजन सहङरा, ङा ङा भेडाङै ङाजन ऐसहङरा। <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />जोमनलेस्यु बौले ङाजन सहौ, ङा बै बौजन शईङा, ओटन ङा भेडाङलं नाल्ट ङा जिबन अर्पन ढोङा।”<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:27">मत्ती ११:२७</ref>; <ref loc="LUK 10:22">लूका १०:२२</ref></char></note> <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />“ङामि अपुर भेडाङ लेरा, जो ईका गोठलाङ माङडी। नकाङजन बै ङा होनन्या ताइज्याया ओटन नकाङै ङा ग़ा थएरा ओटन नकाङ तोलोअजै बगाल ताइन्यालेरा, ओटन तोलोअजै ग्वाला ताइन्यालेया।<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="ISA 56:8">यशैया ५६:८</ref>; <ref loc="EZK 34:23">इजकिएल ३४:२३</ref>; <ref loc="EZK 37:24">३७:२४</ref></char></note> <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />बौले ङाजन ऐताइस्यु प्रेम ढाङवा, दानाङभन्या ङा ङाजिबन फरि होलन्या यिङले अर्पन ढोङा। <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />काङ्काईले ङाल्योङन ङा परान होनौ माढुदुऊदी, तर ङा ङामि इच्छ्याले ङामि परान अर्पन ढोङा। ङा परान अर्पन ढान्या अढिकार ङाईसं लेया, ओटन फरि होलन्या अढिकार बै ङासं लेया। ईका आग्या ङा ङा बौ ल्योङन डोएस्यु लेङा।” <verse eid="JHN 10:18" /><verse number="19" style="v" sid="JHN 10:19" />ईका बचनल कारनले यहूदीयाङ खार्ल फरि भाअसिइ ताहौ। <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />नकाङ मध्य भ्याईले ऐलिज्यावाङ, “इकाजन दुस्टआत्मा लागिस्यु लेया। ओटन ईका पुलज्याऔ। जे इकाल छेन दानाङ थएच्यो?” <verse eid="JHN 10:20" /><verse number="21" style="v" sid="JHN 10:21" />अपुऱ्याङै ऐलेवाङ, “दुस्टआत्मा लागिन्या रुल छेन ऐमाताइदी। नैति दुस्टआत्माले अन्ढलाङ म्युउ फटौ आढुदुऊ का?”<verse eid="JHN 10:21" /></para>
  <para style="s">येशुजन रामामानिउ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />यरुशलेमला मन्दिरजन परमेस्वरतं समर्पन ढान्या पर्ब रा:स्यु लेऊ, ईका हिउदाका समाय लेऊ। <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />येशु मन्दिर भितर सोलोमनल पटाहाल<note caller="+" style="f"><char style="fr" closed="false">10:23 </char><char style="ft" closed="false">पटाहा=दलान</char></note> हुदेएअदेए लेरिऊ। <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />यहूदीयाङै ओलं चारवरङन दुउसिस्यु रांगिनौ, “खक समन नङ गे यिङ दोधारल नाएसिन? नङ ख्रीस्ट ताहनकन गेजन प्रस्टै पानस्यासिन्ते।”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />येशुले नकाङजन जबाक आयोवाङ, “ङा जेजन पानस्यादुच्या, तर जे बिस्वास माढोचिदी। ङा बौल मिनतन जो काम ढोङ, ओइले ङामि बयन योंवा। <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />तर जे बिस्वास माढोचिदी, दानाङभन्या जे ङा भेडाङ मध्यला माङडी।” <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />“ङामि भेडाङजन ङा सहङरा, ओटन नकाङै ङा ग़ा थएरा, ओटन ङाछिनछिन रारां। <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />नकाङजन ङा अनन्त जिबन योंङरा, ओटन नकाङ खकै नस्ट माताइरदी, ओटन काङ्काईले नकाङजन ङाकुईतन न्हानस्यु लाङौ माढुदुऊदी। <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />ङा बौले ङाजन ना आयांङु, ओ सोगलैतन घिन्या लेया, बौल कुईतन काङ्काईले नकाङजन न्हानस्यु लाङन्यामाल्दी। <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />बौ सनर ङा तोलोअ ज्या।”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />यहूदीयाङै ईका छेन थएस्यु येशुजन टुपङा लेस्यु फरि लुङ रात्युकौ। <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />येशुले नकाङजन ऐआढोवाङ “ङा जेजन ङामि बौल्योङन भ्याई चान्या काम ङा थन्ङु, ना मध्य काङ्का कामल कारनले जे ङाजन लुङले टुपौ जेरोअचिऊ?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />यहूदीयाङै ओलजन जबाक रांयोव, “गे नङजन चान्या कामल नाल्ट लुङले मातुप्सिन्दी, तर नङ रु ताइस्यु बै नङझन्जै परमेस्वरसं नमानौकाले सनर ईस्वरलं बाए नढाऔकाले तुपौ गेरोअसिनु हो।”<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवी २४:१६</ref></char></note><verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />येशुले नकाङजन जबाक आयोवाङ, नैति जेमि ब्यबस्थालं ऐटाइन्या सरसिन्या मालेऊ, “ङा ऐङाल्ङु, जे देउताङ हो?”<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="PSA 82:6">भजनसङ्ग्रह ८२:६</ref></char></note> <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />“पबित्रशास्त्रले आपानन्या गे ऐसन्या बचन सदाईल नाल्ट सत्य ज्या, तर ना छेन भङ्ग माताइदी। ओटन ब्यबस्थाले नका रुयाङजन देउताङ ऐआढोवाङ, जोयाङजन परमेस्वरङन थाई यांसिवाङ। <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />बौले ङाजन छेल्स्यु ईका सङ्सारलं आपरिङ्ङु, ‘ङा परमेस्वरलं ज़ा हो’ ऐङालेऊक कैलेस्यु परमेस्वरलं बिरोद ताहौ? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />यदि ङा बौले जो चाहि ना काम ङा माढोङकन ङाजन बिस्वास ताढोच्यो। <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />तर ङा बौल काम ढाज्याङा ओटन बै जे ङाजन बिस्वास माढाङच्योकन ईका कामयाङत बिस्वास ढोचिते, ओटन जे सनच्या ओटन बुजिच्या, कि बौ ङात लिज्याया, ओटन ङा बौत लिज्याङा।”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />नका यहूदीयाङै येशुजन फरि कोलोकौ रारोकौ, तर ओलं नकाङल कुईतन फुत्किस्यु हिनौ। <verse eid="JHN 10:39" /><verse number="40" style="v" sid="JHN 10:40" />ओटन येशु फरि यर्दन भईल हुदिन्त हिनस्यु नका पोल चुङौ, जोङ यहुन्नाले हादेए बप्तिस्मा आयोवाङ।<note caller="-" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="JHN 1:28">यहुन्ना १:२८</ref></char></note> <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />तबर रुयाङ आल्योङ रांऔ तअसिवाङ, ओटन नकाङै ऐलेवाङ, यहुन्नाले नैज अचम्मला कामयाङ माढोडा, तर इकाले ता ढोदा, इकाल बारेल “यहुन्नाले जो छेन आपानौ ना मछ्युज्या रैस।” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />ओटन नङ तबर रुयाङै येशुजन बिस्वास रांढोव।<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">लाजरसं आसिन्या</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />लाजरसं मिनला तोलोअ रु आनाएबोरस्यु लेऊ। नका मरियम सनर नकाल आदिदी मार्था बेथानिया नङ्गरला लेऊने।<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="LUK 10:38-39">लूका १०:३८-३९</ref></char></note> <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />येशु प्रभुजन अत्तर ठिइस्यु आखङल आचेमले सिइस्यान्या मरियम ईकाइ ज्या। इकालै भाई लाजरसं आनाएबोरस्यु लेऊ।<note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="JHN 12:3">यहुन्ना १२:३</ref></char></note> <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />आका नेंलोअ दिदीनेंले येशु ल्योङ ऐलेस्यु थाई नेंपरिङौ, “औ प्रभु, जोजन नङ मया नढोनु, नका आनाएबोरज्याया।”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />तर आका थएस्यु येशुले ऐलेऊ, “ईका नाएबोरले सिइल मासतापौदी, तर ईका परमेस्वरलं ज़ाल महिमालं नाल्ट हो।” <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />येशुले मार्था, नकाल बैना मरियम सनर लाजरसजन मया ढोवरा, <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />ताहकन बै लाजरसं आनाएबोरज्याऔ ऐलेन्या थएस्यु येशु जोङ लिज्याऔ, ओङ अझ नेंयोअ समन चुङौ। <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />नकाल छिन्ट येशुले सिइयाङजन ऐआढोवाङ, “दे, आब गे फरि यहूदिया वलस्यु हिन्‌या।” <verse eid="JHN 11:7" /><verse number="8" style="v" sid="JHN 11:8" />सिइयाङै ओलजन ऐराढोव, “औ प्रभु,<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false">रब्बी=प्रभु</char></note> भाबाअ यहूदीयाङै नङजन लुङले टुपौ रोअज्यावाङ, ओटन नैति फरि नङ नङै हिन्ना?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />येशुले जबाक आयोवाङ, “नैति लाअ बारं घन्टा माताहौ का? लाअक बारिन्याङ माढुइरदी, दानाङभन्या नकाङै ईका सङ्सारला ज्योति रङरा, <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />तर रिउल डुलिन्याङ धूइसिरा, दानाङभन्या नका रुयाङ ल्योङ रंनन्या माल्दी।” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />ओलं छिन्ट येशुले नकाङजन ऐआढोवाङ, “गे न्हाए लाजरसं मिऊरुइल परीस्यु लेऊ, तर नकाजन मिऊरुइतन सचोटौ नाल्ट ङा नङ हिन्ङा।” <verse eid="JHN 11:11" /><verse number="12" style="v" sid="JHN 11:12" />सिइयाङै ओलजन ऐराढोव, “अं प्रभु, नका मिऊरुइल परीस्यु लेकन नका ऐबेला।”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />येशुले नकाल आसिन्या बारेल आपानज्याऔक, तर नकाङ मछ्यु मिऊरुइल बारेल पानज्याऔ ऐलेस्यु रायिङौ। <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />येशुले नकाङजन प्रस्टै आपानस्योवाङ, “लाजरसं सिस्यु लेया। <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />जे बिस्वास ढोच्या ऐलेस्यु जे नाल्ट ङा नङ ङामालेऊकाले खुशी लेङा। जोमनलेस्यु बै गे नका ल्योङ हिन्‌या।”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />तब दिदुमस ऐढासिन्या थोमाले आन्हाए सिइयाङजन ऐआढोवाङ, “दे, गे बै हिन्‌या, ओटन येशुसजै सिया।”<verse eid="JHN 11:16" /></para>
  <para style="s">येशु पुनरुत्थान सनर जिबन</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />येशु बेथानिया आतापराऔक, लाजरसजन ऊईल रानाएन्या चार दिन ताइस्यु लेऊ। <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />बेथानिया यरुशलेमतन छ्योअ तिन किलोमिटर लोए लेऊ। <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />तबर यहूदीयाङ मार्था सनर मरियमजन नेंभाईल बारेल नकानेजन सानत्वना यांन्या रा:स्यु लेवाङ।<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />येशु आरांज्यान्या थएस्यु मार्था ओङ हिनौ, ओटन ओसं डोएसिऊ। तर मरियम झिमलै चुङज्याऊ। <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />तब मार्थाले येशुजन ऐआढोव, “औ प्रभु, नङ इलै नलिज्यान्या ताहकन ङा भाई मासिदीहोला। <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />तर आब ङा बै सन्दुङा, नङ परमेस्वर सकाए जो नीन, नङजन ऐयान्वा।”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />येशुले नकाजन ऐआढोव, “न भाई फरि जिङदा ताइन्यालेया।”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />मार्थाले येशुजन ऐआढोव, “ङा ऐसन्ङा, कि ना आखिरी दिनल पुनरुत्थानल फरि जिङदा ताइस्यु सोया।”<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="ACT 24:15">प्रेरित २४:१५</ref></char></note><verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />येशुले नकाजन ऐआढोव, “पुनरुत्थान सनर जिबन ङाई ज्या। जोले ङाजन बिस्वास ढोव ना सिकन बै बान्चिन्यालेया। <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />ओटन जिङदाङ सनर ङाजन बिस्वास ढान्या जोबै खकैज सिन्यामाल्दी। नैति नङ ईका बिस्वास माढोनच्यो?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />नकाले येशुजन ऐआढोव, “औ प्रभु, ङा बिस्वास ऐढोङा, नङ सङ्सारलं रांन्या ख्रीस्ट, परमेस्वरलं ज़ा हो।”<verse eid="JHN 11:27" /></para>
  <para style="s">येशु व्‌रौ</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />आवाए छ्योङस्यु मार्था हिनौ, ओटन आबैना मरियमजन खुल्स्यु सटक्कै आपानस्योव, “गुरु आङ तापरादा, ओटन नङजन खुलज्याऔ।” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />ईका थएस्यु मरियम ओचोएटै च्याङस्यु येशु ल्योङ हिनौ। <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />येशुजन मार्थाले जोङ आडोटौ ओलै लिज्याऔ, येशु नाबेला समन नङ्गरल ताप्‌रा:स्यु मालेऊ। <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />झिमल नकाजन सानत्वना यारान्या यहूदीयाङै मरियम ओचोएटै च्याङस्यु पाखाल आहिनन्या रङस्यु, ना ऊईल व्‌रनाऔ ऐलेन्या यिङस्यु, नकाल छिनछिन हिन्वाङ।<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />जब मरियम येशु आलिज्यान्या पोल रायापाइना येशुजन रङस्यु, ऐलेस्यु नाले ओलं खङत धोक आयोव, “औ प्रभु, नङ इल नलिज्यान्या ताहकन ङा भाई मासिदीहोला।” <verse eid="JHN 11:32" /><verse number="33" style="v" sid="JHN 11:33" />जब येशुले नाजन आव्‌रज्यान्या सनर नास रांन्या यहूदीयाङ बै राव्‌रज्यान्या आरङवाङ, तब येशुल यिङ भ्याई निरास ताहौ ओटन भ्याई दुखीत ताहौ। <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />येशुले नकाङजन आगिन्वाङ, “जे नाजन काङ जेरीन्चिऊ?” नकाङै ओलजन ऐराढोव, “औ प्रभु रा:स्यु खिम्ते।” <verse eid="JHN 11:34" /><verse number="35" style="v" sid="JHN 11:35" />येशु व्‌रौ। <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />नैताइस्यु यहूदीयाङै ऐलेवाङ, “खिम्चिते, येशुले नाजन ख्वाए मया आढोव।” <verse eid="JHN 11:36" /><verse number="37" style="v" sid="JHN 11:37" />तर नकाङ मध्य काङ्काङै ऐलेवाङ, “नैति इकाले अन्ढलाल म्युउ ता आफएस्योव नका रुजन बै सिन्यातन बचाहौ माढुदुवा का?”<verse eid="JHN 11:37" /></para>
  <para style="s">येशुले लाजरसजन जिङदा आजाएन्या</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />तब येशु फरि भ्याई निरास ताइस्यु ऊई ल्योङ हिनौ। नका ऊई तोलोअ पुउल लेऊ। नकाल याह् तोलोअ लुङले कप्सिज्याऔ। <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />येशुले ऐआढोवाङ, “लुङ हताइचिते।” सिन्या रुल दिदी मार्थाले येशुजन ऐआढोव, “प्रभु, आवाए बेला समन ता ना आस्युउनमङा लेदा होला, दानाङभन्या ना आसिन्या चार दिन ताइदा।” <verse eid="JHN 11:39" /><verse number="40" style="v" sid="JHN 11:40" />येशुले नकाजन ऐआढोव, “नैति ङा नङजन ऐङामाढानु, ‘नङ बिस्वास ढोनकन परमेस्वरलं महिमा रङन्या लेना?’” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />नकाङै लुङ रांहटाहौ। ओटन येशुले नमदेए खिमस्यु ऐलेऊ, “औ बौ, ङा नङजन धन्याबाद यांना, दानाङभन्या नङ ङा बिन्ति नठएनु। <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />ङाजन थाह ऐलेया, कि नङ ङा बिन्ति सदाई थएना। तर इल च्याङज्यान्या हुलल नाल्ट ङा ईका ङापान्ङु, ताकि नङ ङाजन नपरिङनु ऐलेस्यु नकाङै बिस्वास ग्याढोरत्या।” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />ओटन ईका छेन पान्वापाइना येशु बअजोरसै कलिकौ, “लाजरसं, पाखाल पलिईस्यु रांन्ते।” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />ना सिन्या रुल खङ-कुई पट्टीले पोअसिन्या सनर अनवार क्वाले मलिङसिन्याई बाहेर पलिईस्यु रांऔ। येशुले नकाङजन ऐआढोवाङ, “नकाल बन्दन पलाअस्योचिते, ओटन नकाजन हिनौयोचिते।”<verse eid="JHN 11:44" /></para>
  <para style="s">येशुल बिरोदत सड्यन्त्र</para>
  <para style="r">
    <ref loc="MAT 26:1-5">मत्ती २६:१-५</ref>; <ref loc="MRK 14:1-2">मर्कुस १४:१-२</ref>; <ref loc="LUK 22:1-2">लूका २२:१-२</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />मरियम ल्योङ रांन्या तबर यहूदीयाङै येशुले आढान्या काम रङस्यु ओजन बिस्वास रांढोव। <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />तर नकाङ मध्य काङ्का-काङ्काङ फरिसीयाङ ल्योङ हिन्वाङ, ओटन येशुले आढान्या कामयाङ रापानस्योवाङ। <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />तब मुख्या पुजाउरोयाङ सनर फरिसीयाङै महासभाला सदस्ययाङजन रांखुलौ ओटन नकाङजन ऐराढोवाङ, “आब गे कैलेई? दानाङभन्या ईका रुले ता तबर अचम्मला कामयाङ ढाज्याया। <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />इकाजन दाङज राहैकन सोगलैले इकाजन बिस्वास ढोरा, ओटन रोमी अढिकारीयाङै रा:स्यु गे मन्दिर सनर गेमि नेंलोअ देसझन्ज नस्ट जाटैरा।”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />तर नकाङ मध्य तोलोअ, कैयाफा, जो ना बर्सला प्रधान पुजाउरो लेऊ, ओले नकाङजन ऐआढोवाङ, “जे नैज बै मासन्चिदी! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />सोगल देस नस्ट आटाहौ भन्या बरु जनताल नाल्ट तोलोअ रु आसिन्याई चान्या ताहा, ऐलेस्यु जे माबुजिचिऊ।” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />ईका छेन नकाले आतरफङन आपानन्या माङडी, तर नका बर्सला प्रधान पुजाउरो आताहौकाले देसलं नाल्ट येशु सिन्याई ताहा ऐलेन्या भबिस्यबानी आढोव। <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />देसलं नाल्ट याएज नकाले ईका आपानौ माङडी, तर तत्तर-बित्तर ताइन्या परमेस्वरलं सन्तानयाङजन तचोएकै दुकौ नाल्ट ईका आपानौ हो।<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />नैताइस्युईज नाछिम्कन यहूदी अढिकारीयाङै येशुजन सएन्या योजना रांजाटौ। <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />नैताइस्यु येशु फरि यहूदीयाङल खार्ल खुल्लमखुल्ला माबारिऊ, तर नलन हरहर ताइन्या-पोल नेराक लेन्या एफ्राइम ऐढासिन्या बजारल हिनौ, ओटन नल सिइयाङसकाए लिज्याऔ। <verse eid="JHN 11:54" /><verse number="55" style="v" sid="JHN 11:55" />यहूदीयाङल निस्तार-पर्ब रांङालिज्याऔ, ओटन नङ्गरलन तबर जना रां-रां चोख्याइसिन्या ऐलेस्यु निस्तार-पर्बल सुरु आमाताहौ हादेए यरुशलेम हिन्वाङ।<note caller="-" style="x"><char style="xo" closed="false">11:55 </char><char style="xt" closed="false"><ref loc="2CH 30:17">२इतिहास ३०:१७</ref></char></note> <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />तब नकाङै येशुजन रारोकौ, ओटन नकाङ मन्दिरलं राच्याङज्याऔक रारां छ्योङौ तअसिवाङ, “जेजन कैताहौ जेदारचिऊ, नैति नका पर्बल मारांया का?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />मुख्या पुजाउरोयाङ सनर फरिसीयाङै येशुजन कोलोअन्या गेलेयिउ ना काङ लिज्याऔ, काङ्काङै सनच्योकन थाई पानच्यो ऐलेस्यु आग्या रांयोवाङ।<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">बेथानियाल येशुल अबिसेक</para>
  <para style="r">
    <ref loc="MAT 26:6-13">मत्ती २६:६-१३</ref>; <ref loc="MRK 14:3-9">मर्कुस १४:३-९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />येशु निस्तार-पर्बल छ दिनहादेए बेथानियाल रांऔ। लाजरसलं आझिमलै लिज्याऔ, जोजन येशुले सिन्यातन जिङदा आजाटौ। <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />नकाङै येशुल नाल्ट नङ ओईका ज्यान्या तयार रांजाटौ। मार्थाले सेवा-ब्याएबिई आढोव, ओटन लाजरसकने ओलसैज ज्योङा लेस्यु चुङन्याङ मध्य तोलोअ लेऊ। <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />तब मरियमले आधा लितर याए करन्या जटामसीलं आस्युउनमन्या अत्तर हिनस्यु येशुल खङल आठिइस्यौ, ओटन ओलं खङ आचेमले आसिइस्यौ, ओटन अत्तर झिमभरि आस्युउनमौ।<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">लूका ७:३७-३८</ref></char></note><verse eid="JHN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4" />तर येशुल तोलोअ सिइ यहूदा जो बिस्वासघाटी इस्करियोतले ऐलेऊ, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“ईका अत्तर तिन सय चान्दील सिक्काल यएस्यु नकाल रकम गरिबयाङजन यांसिरकन माताहौ?” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />तर नकाले गरिबयाङल मछ्यु यिङस्यु ऐलेऊ माङडी, कि ना गोए हो, दानाङभन्या पैसालं हुइ नकालेई नाएवा, ओटन नलन्जै कुन्या आढोव।<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />तब येशुले ऐलेऊ, “इकाजन कैज ताढोच्यो, ङाजन रींनन्या-दिनल नाल्ट आकाजन ना नाएस्युनाटौ योंचिते। <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />दानाङभन्या गरिबयाङ सदाई जेसकाए लिज्यारा, तर ङा ता सदाई जेसकाए मालिज्याङदी।”<note caller="-" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ब्यबस्था १५:११</ref>; <ref loc="MRK 14:7">मर्कुस १४:७</ref></char></note><verse eid="JHN 12:8" /></para>
  <para style="s">लाजरसलं बिरोदत सड्यन्त्र</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />यहूदीयाङल तोलोअ घिन्या हुलले येशु नङ लिज्याऔ ऐलेन्या आसनौ, ओटन येशुल नाल्ट याएज माङडी, तर ओले सिन्यातन जिङदा आजाएन्या लाजरसजन बै खिमन्या लेस्यु नकाङ रा:स्यु लेवाङ। <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />ओटन मुख्या पुजाउरोयाङै लाजरसजन बै सएन्या योजना रांजाटौ। <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />दानाङभन्या नाले गर्दा यहूदीयाङ मध्य तबर जना भाअसिस्यु येशुजन बिस्वास ढाऔ तअसिवाङ।<verse eid="JHN 12:11" /></para>
  <para style="s">येशु यरुशलेमल पसिऊ</para>
  <para style="r">
    <ref loc="MAT 21:1-11">मत्ती २१:१-११</ref>; <ref loc="MRK 11:1-11">मर्कुस ११:१-११</ref>; <ref loc="LUK 19:28-40">लूका १९:२८-४०</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />तयोअका छिम्क निस्तार पर्बल रांन्या घिन्या हुलयाङै येशु यरुशलेमल रांज्याऔ ऐलेन्या राथटौ, <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />ओटन रुयाङ खजुरल हाङ्गाङ हिनस्यु येशुजन स्वागत ढान्या जयजयकार लेस्यु पलिइवाङ, “होसन्ना! बअचान्या परमप्रभुल मिनत रांन्या इस्राएलला रय!”<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">भजनसङ्ग्रह ११८:२५-२६</ref></char></note><verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />ओटन पबित्रशास्त्रलं आसरस्याऔमन तोलोअ गडाहाल पुङ डोएस्यु येशु नका यर्त चरीउ, जोमनताइन्या सरसिज्याऔ, <verse eid="JHN 12:14" /><verse number="15" style="v" sid="JHN 12:15" />“सियोनल मेएमा ज़ा, ताछ्यातन। खिम्ते न रय गडाहाल पुङ त सवार ताइस्यु रांज्याया।”<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">जकरिया ९:९</ref></char></note><verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />पबित्रशास्त्रलं सरसिन्या आका छेनयाङ येशुल सिइयाङै हादेए माबुजिदुरा। तर येशुल महिमा ताहापाइना ईका छेन ओलं बारेल सरसिस्यु लेऊ, ओटन आका काम ओलं नाल्ट नकाङै रांढोव हो, ऐलेन्या नकाङै रायिङौ।<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />येशुले लाजरसजन ऊईलन खुल्स्यु सिइतन जिङदा आजाटौक ओलसं लिज्यान्या हुलला रुयाङै आबयन यांऔवन्जै रांढोव। <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />ओले ऐटाइन्या अचम्मला कामयाङ आढोव ऐलेन्या राथटौकाले हुलले ओलजन डोएनास्यु लेवाङ। <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />तब फरिसीयाङै तोलोअले-तोलोअजन ऐढाऔ तअसिवाङ, “खिम्चिते, जेङन नैज ताइन्या माङडी। मारङच्या, सङ्सारज नकाल छिन्ट लागिदा!”<verse eid="JHN 12:19" /></para>
  <para style="s">ख्वाए यूनानीयाङै येशुजन रारोकौ</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />पर्बल आराधना ढानान्याङ मध्य काङ्का-काङ्काङ ग्रीकयाङ बै लेवाङ। <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />नकाङ गालीलला बेथसेदालं चुङन्या फिलिप ल्योङ रा:स्यु ऐलेस्यु बिन्ति रांढोव, “औ, गे येशुल दर्शन ढान्या गेलेयिउ।”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />फिलिपले हिनस्यु अन्द्रियासजन ऐआढोव, ओटन अन्द्रियास सनर फिलिपने हिनस्यु येशुजन नेपानस्योव। <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />येशुले नकानेजन जबाक आयोवने, “रुल ज़ा महिमित ताइन्या समाय तापरादा। <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />ङा झेनजन मछ्यु ऐढाचिना, पलीमाल गेडा व्मल परीस्यु मासिकन ना तोलोअजै लिज्याया। तर नका सिकन नाले तबर शई शशैवा। <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />आपरानल मोह ढान्याले ना गवाइवा, तर आपरानजन ईका सङ्सारलं तुच्छ ठहऱ्याइन्याले अनन्त जिबनल नाल्ट ना सम्भारस्यु नाएवा।<note caller="-" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती १०:३९</ref>; <ref loc="MAT 16:25">१६:२५</ref>; <ref loc="MRK 8:35">मर्कुस ८:३५</ref>; <ref loc="LUK 9:24">लूका ९:२४</ref>; <ref loc="LUK 17:33">१७:३३</ref></char></note> <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />जोले ङा सेवा ढोव, नकाले ङाजन ग्यापछ्याइङुत्या ओटन ङा जोङ लेङ, ङा सेबक बै नङै ताहा। काङ्काङै ङा सेवा धोरकन बौले नकाल कदर ढोवा।”<verse eid="JHN 12:26" /></para>
  <para style="s">येशुले आसिन्या बारेल आपानन्या</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“आब ङा परान आतिइले छटपटी ज्याया, ओटन ङा नै पानङ? ‘औ बौ, ङाजन ईका बेलाकन जोगाहङते?’ माङडी, ईकाइ कारनले आका समाय ङायर्त तारांत्या। <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />औ बौ, नमीई मिनल महिमा ढोते।” तब स्वर्गङन ऐटाइन्या तोलोअ ग़ा रांऔ, “ङा न महिमा ढास्युई लेङा, ओटन फरि बै ढोङा।” <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />नल च्याङज्यान्या हुलले आका थएस्यु ऐलेवाङ, “ईका बादल आगर्जिन्या दी!” अपुऱ्याङै ऐलेवाङ, “स्वर्गदुत ओलसं छ्योङज्याऔ दी!”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />येशुले नकाङजन जबाक आयोवाङ, “ईका बचन ङा नाल्ट माङडी, तर जे नाल्ट हो। <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />आब ईका सङ्सारलं निया ताहा। ईका सङ्सारला शासक पाखाल क्याइसिया। <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />ओटन जब ङा पिरथ्बीलन छेन्सिङ, ङा सोगलै रुजन ङाल्यौदेए च्योङ्ङरा।” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />नका कैताइस्यु सिन्या हो, ना सङ्केट थनन्यालेङा लेस्यु ओले ऐआढोवाङ। <verse eid="JHN 12:33" /><verse number="34" style="v" sid="JHN 12:34" />हुलले ओलजन रांगिनौ, “येशु, सदाईजै लिजिया ऐलेन्या ब्यबस्था नियाम अनुसार गे थएस्यु गेलेयिउ। नङ कैलेस्यु पानौ नढुदुनु, रुल ज़ा छेन्सिऊजै परिया लेस्यु? ईका रुल ज़ा ऐढासिन्या काङ्का?”<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="PSA 110:4">भजनसङ्ग्रह ११०:४</ref>; <ref loc="ISA 9:7">यशैया ९:७</ref>; <ref loc="EZK 37:25">इजकिएल ३७:२५</ref>; <ref loc="DAN 7:14">दानियल ७:१४</ref></char></note><verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />येशुले नकाङजन ऐआढोवाङ, “अझै तचिइ बेला समन ज्योति जेसकाए ऐलिजिया। जेसकाए ज्योति आलिज्याऔ समन बारिचिते, ताकि जे चिऊन्याल तापरिच्यो। काङ्काङ चिऊन्याल बारिरकन, नकाङै गे काङ गेहिनज्यायिउ लेस्यु मासनरदी। <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />जैकसमन ज्योति जेसकाए ले, ऐक समन ज्योतित बिस्वास ढोचिते, ओटन जे ज्योतिल सन्तान ताइचिते।” ईका बचन पान्वापाइना, येशु नङंन हिनौ, ओटन नकाङतन मोअसिऊ।<verse eid="JHN 12:36" /></para>
  <para style="s">रुयाङल अबिस्वास</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />येशुले नकाङल लेऊक आवाए अचम्मला कामयाङ आढोव, ओटन बै नकाङै ओलजन बिस्वास माढोदुरा। <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />ईका आबस्यक लेया, कि यशैया भबिस्यबक्तालं बचन पुरा ग्याताइत्या “औ परमप्रभु, गे थाईत काङ्काले बिस्वास आढोव? ओटन परमप्रभुल बाहुबल काङ्काजन थनसिऊ?”<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="ISA 53:1">यशैया ५३:१</ref></char></note> <verse eid="JHN 12:38" /><verse number="39" style="v" sid="JHN 12:39" />नैताइस्यु नकाङै बिस्वास ढाऔ रांमाढुदुऊ, दानाङभन्या यशैयाले फरि ऐलेऊ, <verse eid="JHN 12:39" /><verse number="40" style="v" sid="JHN 12:40" />“परमेस्वरले नकाङल म्युउ बन्द जाएस्यु आनाएस्योवाङ, ओटन नकाङल यिङ कठोर जाएस्यु आनाएस्योवाङ, नैलेस्युजै नकाङ राम्युउले तारङरत्या, ओटन रायिङले ताबुजिरत्या, मानकन्ता नकाङ वल्‌रा ओटन ङा नकाङजन सबेलन्या ताहा।”<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="ISA 6:10">यशैया ६:१०</ref></char></note><verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />यशैयाले ईका छेन आपानौ, दानाङभन्या नकाले प्रभुल महिमा आरङौ, ओटन ओलं बारेल आपानौ।<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />तर फरि बै यहूदी अढिकारी मध्यलन तबरले येशुजन बिस्वास रांढोव, तर फरिसीयाङ छ्याइले गर्दा, सनर नकाङै यहूदीयाङ आराधना झिम पलिइरा ऐलेन्या छ्याइले ना सुइकार माढोदुरा। <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />दानाङभन्या नकाङ परमेस्वरलं प्रसम्सालं भन्या रुल प्रसम्सा भ्या रांनिजिऊ।<verse eid="JHN 12:43" /></para>
  <para style="s">येशुल बचनङन निया</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />येशुले घिन्या ग़ाले ऐलेऊ, “ङाजन बिस्वास ढान्याले ङाजन माङडी, तर ङाजन परिङन्या परमेस्वरजन बिस्वास ढोवा। <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />जोले ङाजन रङ्ङु, नकाले ङाजन परिङन्याजन रङवा। <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />ङा सङ्सारलं ज्योति ताइस्यु ङारांङु, जोले ङाजन बिस्वास ढाङु नका चिऊन्याल मालिज्यादी।” <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />“काङ्काङै ङा छेन थएस्यु, ओटन ना पालन माढोरकन, ङा नकाल निया माढोङदी दानाङभन्या ङा सङ्सारलं निया ढान्या ङारांङु माङडी, तर सङ्सारजन जोगाइन्या ङारांङु हो। <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />ङाजन माकोनन्या सनर ङा थाई थएस्यु ग्रहन माढान्याल नाल्ट तोलोअ नियादिस लेया। जो बचन ङा ङाछ्योङ्ङु नकालेई आसापटा दिनल नकाले निया ढोवा। <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />दानाङभन्या ङा ङा तरफङन्ज माछ्योङ्ङडी, तर ङा नै पानौ परिन्या हो, सनर नै छ्योङौ मापरिन्या हो, ङाजन परिङन्या बौले ओलजै ङाजन आग्या यांस्युनाटङवा। <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />ङा ऐसन्ङा, कि ओलं आग्या अनन्त जिबन हो। नैताइस्यु ङा जो छ्योङ्ङ, बौले ङाजन आपानस्यान्या अनुसार छ्योङ्ङा।”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">येशुले आसिइयाङलं खङ आहुरौ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />निस्तार-पर्बल हादेए ईका सङ्सारलन बिदा ताइस्यु बौल्योङ हिनन्या ङा बेला तापरादा ऐलेन्या येशुले आसनौ, ओटन सङ्सारलं आमि भरियाङजन मया ढास्यु परमेस्वरले नकाङजन आखिरी समन मया आढोवाङ।<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />ओईका बेला येशु सनर आ सिइयाङ ज्याऔ बेला दियाबलसले सिमोनल आज़ा यहूदा इस्करियोतलं आयिङल कोलोकौ परिङन्या बिचार हादेएज आझोअस्यौ। <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />बौले सोगलै ओलं कुईत यांस्यु लेया, ओटन ओलं परमेस्वरङन रांऔ हो, ओटन परमेस्वर लेऊदेए ङाहिनज्याङु ऐलेन्या छेन येशुले सनस्युलेऊ। <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />ओटन येशु ज्यास्यु सोव, ओटन बाहेऱ्या क्वा तपोईदेए नाएस्यु, तोलोअ ताऊल्या आकम्बरल आमलिङौ। <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />तब ओले पराटल री आटुहौ, ओटन आसिइयाङलं खङ हुरस्याऔ तअसिऊ, ओलं आमलिङसिन्या ताऊल्याले नकाङल खङ सिटौ तअसिऊ। <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />जब ओलं सिमोन पत्रुस ल्योङ रांऔ, नकाले ओलजन ऐआढोव, “औ प्रभु, नङ नैति ङा खङ हुरस्याङना?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />येशुले नकाजन जबाक आयोव, “ङा नैति ङाढाज्याङु नङ आकअ मासनन्दी तचिइ छिन्ट बुजिना।” <verse eid="JHN 13:7" /><verse number="8" style="v" sid="JHN 13:8" />पत्रुसले ओलजन ऐआढोव, “नङ ङा खङ खकै हुरन्यामालेन्दी।” येशुले नकाजन जबाक आयोव, “ङा माहुरनकन नङ ङासिइ माताइदुन्दी।” <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />सिमोन पत्रुसले ओलजन ऐआढोव, “औ प्रभु, ङाखङ याएज माङडी, तर ङाकुई सनर ङए समेत हुरस्याङते।” <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />येशुले नकाजन ऐआढोव, “हुरसिन्या रुजन आखङ बाहेक अपुर नैज हुरस्यान्या माताइदी, ना चोखाइ लेया। ओटन जे चोखा लेच्या, तर सोगलै ता माङडी।” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />दानाङभन्या येशुले बिस्वासघाट ढान्याजन शईस्युआनाटौ। नैताइस्यु ओले ऐलेऊ, “जे सोगलै चोखा माल्चिदी।” <verse eid="JHN 13:11" /><verse number="12" style="v" sid="JHN 13:12" />येशुले नकाङल खङ हुरस्यौरा पाइना बाहेऱ्या क्वा क्वाएसिस्यु चुङौ, ओटन नकाङजन ऐआढोवाङ, “ङा जे नाल्ट नैङाढोङु नैति जे जेसन्चिऊ?<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="LUK 22:27">लूका २२:२७</ref></char></note> <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />जे ङाजन ‘गुरु सनर प्रभु’ ऐढाङच्या, आका जे ठिकै जेल्चिऊ, दानाङभन्या ङा ओइ ज्या। <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />जोमनलेस्यु ङा जे प्रभु सनर जे गुरु ताइस्यु बै ङा जे खङ ङाहूरस्याचिऊ आब जे बै तोलोअले-छुट्टैल खङ हुरौपरिया, <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />दानाङभन्या ङा जेजन तोलोअ उदाहरन ङायाचिऊ, ओटन जो ङा जे नाल्ट ङाढोङु, जे बै नाइज ढोचिते। <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />ङा जेजन मछ्यु ऐढाच्या, सेवाऱ्या आ साहूतन घिन्या माताइदी, ओटन थाई लाङन्या थाई परिङन्यातन घिन्या माताइदी।<note caller="-" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ती १०:२४</ref>; <ref loc="LUK 6:40">लूका ६:४०</ref>; <ref loc="JHN 15:20">यहुन्ना १५:२०</ref></char></note> <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />यदि जे सत्य छेन सनच्योकन सनर ना ढोच्योकन जे बअचान्या ताइच्या।”<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“ङा जे सोगलैल बारेल ङापानज्याङु माङडी, ङा जोजन ङाछेल्ङु नाजन ङा ऐशईङा। तर पबित्रशास्त्र पुरा ग्याताइत्या लेस्यु ईका ताहौ, कि ‘ङामिइज भरेई कैन्याले ङाजन लाट्ट आराहौ।’”<note caller="-" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजनसङ्ग्रह ४१:९</ref></char></note> <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />“ऐआताहौ हादेए आकैज ङा जेजन ऐढाच्या, ताकि जब नैताइरा, ङा ओइ जै ज्या ऐलेस्यु जेजन बिस्वास ग्याताइत्या।<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="JHN 14:29">यहुन्ना १४:२९</ref></char></note> <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />मछ्यु ङा जेजन ऐढाच्या, ‘जोजन ङा परिङ्ङ, ओजन ग्रहन ढान्याले ङाजन ग्रहन ढाङवा, ओटन ङाजन ग्रहन ढान्याले ङाजन परिङन्याजन ग्रहन ढोवा’।”<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्ती १०:४०</ref>; <ref loc="MRK 9:37">मर्कुस ९:३७</ref>; <ref loc="LUK 9:48">लूका ९:४८</ref>; <ref loc="LUK 10:16">१०:१६</ref></char></note><verse eid="JHN 13:20" /></para>
  <para style="s">येशुजन बिस्वासघाट ढान्याल बारेल भबिस्यबानी</para>
  <para style="r">
    <ref loc="MAT 26:20-25">मत्ती २६:२०-२५</ref>; <ref loc="MRK 14:17-21">मर्कुस १४:१७-२१</ref>; <ref loc="LUK 22:21-23">लूका २२:२१-२३</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />आका छेन आपानौ छिन्ट येशुल यिङ छटपट ताहौ ओटन ओले बयन यांस्यु ऐलेऊ, “मछ्यु ङा जेजन ऐढाच्या, जेमध्यलन तोलोअले ङाजन शत्तुरयाङजन कोलोकौ परिङौरा।” <verse eid="JHN 13:21" /><verse number="22" style="v" sid="JHN 13:22" />येशुले काङ्काल बारेल छ्योङज्याऔ ऐलेस्यु रामाखटाइदुऊ ओटन सिइयाङै तोलोअले छुट्टैजन खिम्सिवाङ। <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />ओलं आ सिइयाङ मध्य येशुले प्रेम आढान्या सिइआ लेऊदेए घेएसिज्याऔ। <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />तब सिमोन पत्रुसले यहुन्नाजन सयान ढास्यु आगिनौ, “येशुले ईका काङ्काल बारेल छ्योङज्याऔ नाजन गिन्ते वन?” <verse eid="JHN 13:24" /><verse number="25" style="v" sid="JHN 13:25" />यहुन्नाले आघेएसिज्याऔकै येशुजन आगिनौ, “प्रभु, ना काङ्का?” <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />येशुले जबाक आयोव, “जोजन ङा भरेईल कलाए छोएस्यु योंङ, ना नकाई ज्या।” तब ओले भरेईल कलाए आछोटौ, ओटन हाएस्यु ना सिमोनल ज़ा यहूदा इस्करियोतजन आयोव। <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />भरेईल कलाए आचिनौ छिन्ट सैतान नालं भितरलं पसिऊ। तब येशुले ऐआढोव, “नङजन जो ढान्या ताइज्याऔ, ना परेए ढोते।” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />तर येशुले दानाङ नाजन ऐढोव लेस्यु, ज्योङा लेस्यु चुङज्यान्याङ काङ्काईले बै माबुजिदुरा। <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />दानाङभन्या काङ्का काङ्काङै ईका रायिङौ, कि यहूदास पैसालं हुइ लिज्याऔ, ओटन येशुले नाजन पर्बल नाल्ट चाहिन्या समान ग्यालङौत्या, अथाबा नकाले गरिबयाङजन कोबाअ ग्यायौरत्या ऐलेऊ। <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />तब भरेईल कलाए चिन्वापाइनाई यहूदा इस्करियोत ओचोएटै पाखादेए पलिहौ नवाए बेला रिउ ताइस्यु लेऊ।<verse eid="JHN 13:30" /></para>
  <para style="s">येशु पत्रुस आमाभनन्या बारेल भबिस्यबानी</para>
  <para style="r">
    <ref loc="MAT 26:31-35">मत्ती २६:३१-३५</ref>; <ref loc="MRK 14:27-31">मर्कुस १४:२७-३१</ref>; <ref loc="LUK 22:31-34">लूका २२:३१-३४</ref></para>
  <para style="s">छार आग्या</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />जब यहूदा पाखादेए हिनौ तब येशुले ऐलेऊ, आब ङा रुल ज़ा महिमित ताइस्यु लेङा, ओटन परमेस्वर ङात महिमित ताइस्यु लेया। <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />यदि परमेस्वर ज़ात महिमित ताइस्यु लेकन परमेस्वरले ओलझन्जै महिमित जाएवा, ओटन ओचोएटै रुल ज़ात थन्वा। <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />“ऐ ङा लुलल्याङ, ङा तचिइ बेला समन जेसै लिज्याङा! ओटन जोमनलेस्यु ङा यहूदी अढिकारीयाङजन ङापानस्योङवाङ, आब ङा जेजन बै पानस्याच्या, ‘जोङ ङा हिनङ, नङ जे रांऔ माढुदुचिदी नैताइस्यु जे ङाजन रोंकङच्या।’”<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="JHN 7:34">यहुन्ना ७:३४</ref></char></note> <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />“नैताइस्यु ङा जेजन तोलोअ छार आग्या यांच्या जे तोलोअले-तोलोअजन प्रेम ढोचिते। जेजन ङा जोमनलेस्यु प्रेम ङाढाचिऊ, जे बै तोलोअले-छुट्टैजन नैलेस्युई प्रेम ढोचिते।<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="JHN 15:12-17">यहुन्ना १५:१२-१७</ref>; <ref loc="1JN 3:23">१यहुन्ना ३:२३</ref>; <ref loc="2JN 1:5">२यहुन्ना ५</ref></char></note> <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />यदि जे तोलोअले-छुट्टैजन प्रेम ढोच्योकन, इकातन्जै सोगलै रुयाङै जेजन ङा सिइयाङ लेस्यु शईन्यालेचिरा।”<verse eid="JHN 13:35" /></para>
  <para style="s">पत्रुसले आमामानिन्या बारेल येशुल भबिस्यबानी</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />सिमोन पत्रुसले येशुजन ऐआढोव, “औ प्रभु नङ कान्देए नहिनज्यानु?” येशुले जबाक आयोव, “ङा जोदेए ङाहिनज्याङु, जे आकअ ङाजन पछ्याहौ माढुदुचिदी, तर छिन्ट जे ङाजन पछ्याइन्या लेच्या।” <verse eid="JHN 13:36" /><verse number="37" style="v" sid="JHN 13:37" />पत्रुसले ओलजन ऐआढोव, “औ प्रभु, ङा दानाङ नङजन पछ्याहौ माढुदुङ? न नाल्ट ङा ङा परान बै योंङा।” <verse eid="JHN 13:37" /><verse number="38" style="v" sid="JHN 13:38" />येशुले जबाक आयोव, “नैति नङ नपरान ङा नाल्ट योंना? मछ्यु ङा नङजन ऐढाना, नङ ङाजन तिन पाला इन्कार नमाढाऔ समन भाल्या कोन्यामाल्दी।”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">येशु बौल ल्योङ हिनन्या यम</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />येशुले आसिइयाङजन ऐआढोवाङ, “जे यिङ छटपटी ताटाइत्या। जे परमेस्वरतं बिस्वास ढोच्योकन, ङाजन बै बिस्वास ढाङचिते। <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />नङ ङा बौल झिमल चुङन्या पो खाटखाट लेया, नैताइस्यु ङा जे नाल्ट पो तयार जाएन्या ङाहिनज्याङु। ईका छेन मछ्यु माताहकन, ङा जेजन ऐमाढाचिदी। <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />ओटन ङा हिनस्यु जे नाल्ट पो तयार जाएस्यु रांङा, ओटन जेजन ङासकाए लाङच्या, ओटन ङा जोङ लिज्याङ, जे बै नङै लिज्याच्या। <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />जोङ ङा हिनज्याङा, जे नका यम ऐसनच्या।”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />थोमाले येशुजन ऐआढोव, “औ प्रभु, नङ कान्देए नहिनज्यानु, गे मासनइदी, ओटन यम गे कैलेस्यु सनै?” <verse eid="JHN 14:5" /><verse number="6" style="v" sid="JHN 14:6" />येशुले नकाजन ऐआढोव, “यम, सत्य सनर जिबन ङाई ज्या। ङाङन बाहेक काङ्काई बै बौल्योङ रांऔ माढुदुऊदी। <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />जे ङाजन जेशईन्या ताहकन, ङा बौजन बै शईच्या होला। आबकन ओजन शईच्या, सनर ओजन रङदुच्या।” <verse eid="JHN 14:7" /><verse number="8" style="v" sid="JHN 14:8" />फिलिपले ओलजन आढोव, “औ प्रभु, गेजन बौ थनस्यासिन्ते। आवाए लेकन्ता गेजन ऐयोका।” <verse eid="JHN 14:8" /><verse number="9" style="v" sid="JHN 14:9" />येशुले नाजन ऐआढोव, “फिलिप, आवाए समन ङा जेसकाए लिज्याङा, ओटन बै नङ ङाजन नमासहङनु? जोले ङाजन रङस्युले, नकाले बौजन रङस्यु लेया। नङ कैलेस्यु ऐनल्नु, ‘गेजन बौ थनस्यासिन्ते?’ <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />ङा बौसै लिज्याङा, ओटन बौ ङासै लिज्याया ऐलेस्यु नैति नङ बिस्वास नमाढोनु? जो छेन ङा जेजन पानस्याच्यो, नका ङा ङामिइ अढिकारतन ङाछ्योङ्ङु माङडी, तर ङात बाए ढान्या बौले आकाम ढोवा। <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />ङाजन बिस्वास ढाङचिते, कि ङा बौसै लिज्याङा, ओटन बौ ङासै लिज्याया। मानकन ईका कामयाङलै कारन बिस्वास ढाङचिते।” <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />“ङा जेजन मछ्यु ऐढाच्या, जोले ङाजन बिस्वास ढाङु, नकाले ङा ङाढान्या काम बै ढोवा, ओटन नकातन घिन्या काम बै ढान्यालेया, दानाङभन्या ङा बौ लेऊदेए ङाहिनज्याङु। <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />जे ङा मिनतन जो नीच्योकन बै ज़ाङन बौल महिमा ग्याताइत्या ऐलेस्युई ङा ना ढोङा। <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />जे ङा मिनतन जो जन्तु नीच्योकन ङा ढास्याच्या।<verse eid="JHN 14:14" /></para>
  <para style="s">पबित्र आत्माल बाचा</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“जे ङाजन मया ढाङच्योकन ङा आग्या बै पालन ऐढोच्या। <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />ओटन ङा बौजन बिन्ति ढोङा, ओटन ओले जेजन तोलोअ छुट्टै सल्लाकार यांचिवा, ओटन ओ जेसकाए सदाईज लिजिया।” <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />ओ सत्य आत्मा हो, जोजन सङ्सारले ग्रहन ढाऔ माढुदुऊदी, दानाङभन्या सङ्सारले ओजन न त रङौ न सहौ। जे याएजै ओजन शईन्यालेच्या, दानाङभन्या ओ जेसकाए बाए ढोवा, ओटन ओ जेसकाए जै लिज्याया।<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />“ङा जेजन टोक्या माबनाएचिदी। ङा फरि जेल्योङ रांन्यालेङा। <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />आब तचिइ छिन्ङन सङ्सारले ङाजन खकै रङन्या माल्दी, तर जे ङाजन रङन्या लेच्या। ङा जिङदा ङाताहौकाले, जे बै जिङदा लिज्याच्या। <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />नका छिम्क जे सनन्यालेच्या, कि ङा बौसै लिज्याङा, ओटन जे ङा सकाए, ओटन ङा जेस लेङा।”<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />“ङाजन मया ढान्या नकाई ज्या जोसकाए ङा आग्या ले, ओटन नकाले ना पालन ढोव। ओटन ङाजन मया ढान्याजन ङा बौले नाजन मया ढोवा। ओटन ङा बै नाजन मया ढान्यालेङा, ओटन ङा नका ल्योङ रंनन्या लेङा।”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />यहूदा (इस्करियोत माङडी) तर छुट्टै यहूदाले येशुजन ऐआढोव, “प्रभु, नङ नै नपान्नु, नङ नङझन्जै गेत सथन्ना, ओटन सङ्सारजन माङडी?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />येशुले नाजन जबाक यांस्यु ऐआढोव, “जोले ङाजन प्रेम ढाङु, नकाले ङा बचन पालन ढोवा, ओटन ङा बौले नाजन प्रेम ढान्यालेया, ओटन घोन नका ल्योङ रांच्या, ओटन नका ल्योङ बाए ढोच्या। <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />ङाजन प्रेम माढान्याले ङा बचन पालन माढोवदी। जो बचन जे थएच्यो, ना बचन ङामि माङडी, तर ङाजन परिङन्या बौल हो।”<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />ईका छेन जेसकाए ङालिज्याऔकै ङा जेजन पानस्याज्याच्या। <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />तर सल्लाकार, अथाबा पबित्र आत्मा, जोजन बौले ङा मिनतन परिङन्या लेया, ओले जेजन सोगलै छेन ह्युउचिवा, ओटन ङा जेजन ङापानस्यान्या सोगलै छेनयाङ जेजन यिङौ परिङचिवा।<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />ङा जेसकाए शान्ति बनाएङा। ङा ङामि शान्ति जेजन यांच्या। सङ्सारले आयांन्या मनताइन्या ङा जेजन मायांचिदी। जे यिङ छटपटी ताटाइत्या सनर हिपहिप ताटाइत्या। <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />“ङा जेजन ङाहिनज्याङु, सनर फरि जेल्योङ रांङा, ऐङालन्या जे थएदुच्या। जे ङाजन प्रेम जेढान्या ताहकन ङा बौलेऊदेए ङाहिनज्याङु ऐङालन्या थएस्यु जे हेसाङदुच्याहोला, दानाङभन्या बौ ङातन माहान लेया। <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />आब ईका आताहौ हादेएजै ङा जेजन पानस्यादुच्या, ओटन जब ईका ताइरा जे बिस्वास ढाऔ ढुदुचिते। <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />ङा जेसकाए आब तबर माछ्योङ्ङडी, दानाङभन्या ईका सङ्सारला शासक रांज्याया। नकाल ङायर्त नैज सक्ति माल्दी। <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />तर ङा बौजन प्रेम ढोङा, ओटन जोमनताइन्या बौले ङाजन आग्या यांस्यु आनाएङु, नाइ अनुसार ढोङा ऐलेस्यु सङ्सारले ग्यासनौत्या। सोचिते गे ईका पालन बाया।”<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">अङ्गुर टुङ सनर हाङ्गाङ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“ङा मछ्युका अङ्गुर टुङ ङा हो, ओटन ङा बौ किसान लेया। <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />ओटन ङात लेन्या सोगल हाङ्गा जोले जाए माशशहौ ओले नकाजन छेल्वा ओटन शई शशैन्या सोगल हाङ्गाजन झन्जै भ्याई शई ग्याशैत्या लेस्यु ओले छान्टिवा। <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />ङा जेजन ङापानस्यान्या बचनले जे हादेए जै चोखा ताइस्यु लेच्या। <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />जे ङात लिज्याचिते, ओटन ङा जेत लिज्याङा। जोमनलेस्यु अङ्गुर टुङत आहाङ्गा मालिज्याकन नकाले ओलजै शई शशहौ माढुदुऊदी, नैताइस्यु जे बै ङात मालेच्योकन माढुदुचिदी।”<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“ङा अङ्गुर टुङ हो, जेकने हाङ्गाङ हो। यदि काङ्काई ङात लिज्यादा भन्या, सनर ङा नकात लिज्यादुङा भन्या, नकाले तबर शई शशैवा, दानाङभन्या ङातन बाठए ताइस्यु जे नैज ढाऔ माढुदुचिदी। <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />काङ्काई रु ङात मालज्यादा भन्या, नका हाङ्गामन बाहेर मिल्काइसिया, ओटन ना ऐराङ। नैताइन्या हाङ्गाङ रुयाङै दुउरा ओटन मील क्याइरा, ओटन नकाङ हिप्सिरा। <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />जे ङात लिज्यादुच्या भन्या, सनर ङा बचन जेल्योङ लिज्यादा भन्या, जेजन जो इच्छ्या लागि नीचिते, ओटन ना जे नाल्ट ढान्यालेसिया। <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />जे तबर शई शशैस्यु ङा सिइयाङ ज्या ऐलेन्या प्रमानित जाएच्योकन आकातै ङा बौल महिमा ताइन्यालेया।”<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />“बौले जोमनलेस्यु ङाजन प्रेम आढाङु, ङा बै जेजन प्रेम ढास्यु लेङा। जे ङा प्रेमत लिज्याचिते। <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />यदि ङा आग्या पालन ढोच्योकन जे ङा प्रेमत लिज्याच्या, जोमनलेस्यु ङा बौल आग्या पालन ङाढोङु, ओटन ओलं प्रेमतै लिज्याङा।”<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />ङा ईका छेन जेजन आकाई कारन ङापानस्याचिऊ, कि ङामि आनन्द जेत ग्यालिज्यात्या, ओटन जेमि आनन्द परिपुर्न ग्याताइत्या।<verse eid="JHN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 15:12" />ङा आग्या ईकाइ ज्या, कि ङा जेजन जोमनलेस्यु प्रेम ङाढाचिऊ, जे बै तोलोअले-छुट्टैजन नैलेस्युजै प्रेम ढोचिते।<note caller="+" style="f"><char style="fr" closed="false">15:12 </char><char style="ft" closed="false">यहुन्ना १३:३४; १५:१७; १यहुन्ना ३:२३; २यहुन्ना ५</char></note> <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />ज्योङ न्हाएयाङल नाल्ट ज्योङ परान अर्पन ढाऔ भन्या प्रेम ढान्या याए घिन्या अपुर नैज माताइदी। <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />ङा जेजन जो आग्या यांच्यो, जे नका पालन ढोच्योकन, जे ङा न्हाएयाङ ज्या। <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />आबकन ङा जेजन नोक्कर ऐमाढाचिदी, दानाङभन्या नकाल साहूले नै आढोव नोक्करले मासनौदी। तर ङा जेजन न्हाए ऐढादुच्या, दानाङभन्या जो ङा बौल्योङन ङा थएङु, ङा ना सोगलै जेजन पानस्युई लेङा। <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />ङाजन जे जेमाछेलङचिऊ, तर ङा जेजन ङाछेल्चिऊ ओटन जेजन ङाखटाइचिऊ, कि जे हिन्चिते, ओटन शई शशैचिते, ओटन जे शई ग्यालिज्यात्या। नैताइस्यु जे बौसकाए ङा मिनत जो नीच्यो, ओले जेजन नाइज यांन्या लेया। <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />ङा जेजन प्रेम ढाच्या, कि जे तोलोअले छुट्टैजन प्रेम ढोचिते, लेस्यु आग्या ङा यांच्या।<verse eid="JHN 15:17" /></para>
  <para style="s">सङ्सारलं सुजिइ</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“यदि सङ्सारले जेजन सज्युचिरकन, जे सन्चिते कि जेजन सज्युउ हादेए नकाले ङाजन आसज्युङु हो। <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />यदि जे ईका सङ्सारला ताइच्योकन सङ्सारले जेजन आरु यिङस्यु प्रेम ढाचिवा होला। तर जे ईका सङ्सारलाङ माङडी। जेजन ङा सङ्सारलन ङाछेल्चिऊ, नैताइस्यु सङ्सारले जेजन सज्युचिवा। <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />ङा जेजन ङापानस्यान्या बचन यांका नाएच्यो, ‘सेवाऱ्या झिमल साहूतन घिन्या माताइदी।’ नकाङै ङाजन सताहङरकन जेजन बै सताइन्यालेरा। नकाङै ङा बचन पालन धोरकन जे बचन बै पालन ढोरा।<note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ती १०:२४</ref>; <ref loc="LUK 6:40">लूका ६:४०</ref>; <ref loc="JHN 13:16">यहुन्ना १३:१६</ref></char></note> <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />तर नकाङै ईका सोगल छेन ङा मिनल कारनले जेजन ढाचिरा, दानाङभन्या नकाङै ङाजन परिङन्याजन माशईरदी। <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />ङामारांन्या ताहकन सनर नकाङजन ङामापानस्यान्या ताहकन नकाङ पापल दोसी माताइरदी होला, तर आब ता रांमि पापल नाल्ट नकाङ सकाए नैज बाहाना माल्दी। <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />जोले ङाजन सज्युङु, नकाले ङा बौजन बै सज्युवा। <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />यदि अपुर काङ्काईले रांमाढान्या काम ङा नकाङल खार्ल ङामाढान्या ताहकन नकाङ पापल दोसी माताइन्याङ हो। तर आब नकाङै ङाजन सनर ङा बौ नेंलोअझन्जै रङस्यु लेरा ओटन सज्युन्यालेरा। <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />तर, ब्यबस्थाला नियामल सरसिन्या ईका बचन पुरा ताहौ नाल्ट ईका ताहौ हो, ‘नकाङै ङाजन बिनाशब्दै रासज्युङु।’”<note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 35:19">भजनसङ्ग्रह ३५:१९</ref>; <ref loc="PSA 69:4">६९:४</ref></char></note><verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“जब सल्लाकार रां, जो ङा बौल तरफङन जेल्योङ परिङन्या लेङा, अथाबा सत्यला आत्मा, जो बौङन रांज्याऔ, ओले जै ङा बारेल बयन यांन्या लेया। <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />जे सुरुकन्जै ङासं जेलेऊकाले, जे बै ङा साचीयाङ हो।”<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“ङा जेजन नैताइस्यु ऐङाढाचिऊ, कि जे बिस्वास ताराइच्यो लेस्यु, ईका छेन जेजन ङापानस्याचिऊ हो। <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />नकाङै जेजन आराधना झिमलन पलिईन्या लेचिरा। बास्तपलं ऐटाइन्या बेला रांज्याया, जब जेजन सएन्याले परमेस्वरलं सेवा ङाढाज्याङु ऐलेन्या यिङवा। <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />नकाङै ईका काम ढान्या लेरा, दानाङभन्या नकाङै बौजन शईस्यु मालेरदी, ओटन ङाजन बै मासहङरदी। <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />तर ईका छेन ङा जेजन पानस्यादुच्या, कि जब ना बेला रां, तब जेजन ङा नैति ङापानस्याचिऊ नका जेजन याद ताइन्यालेया। पहेला ङा जेजन ईका छेन मापानस्यादुच्या, दानाङभन्या ङा जेसै ङालज्याङु।”<verse eid="JHN 16:4" /></para>
  <para style="s">पबित्र आत्माल काम</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />“ङा आब ङाजन परिङन्या लेऊदेए ङाहिनज्याङु, तर ‘नङ काङ नहिनज्यानु?’ ऐलेस्यु जे काङ्काईले ङाजन मागिन्दुङच्या। <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />ओटन बै ङा जेजन ईका छेन ङापानन्या कारन जेयिङ आतिज्याया। <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />ताहकन बै ङा जेजन सत्य छेन पानस्याच्या, ङा हिनङ्कन्ज जे नाल्ट चान्या ताहा। दानाङभन्या ङा माहिनङ्कन, सल्लाकार जेल्योङ रांन्यामाल्दी। तर ङा हिनङ्कन ओजन जेल्योङ परिङ्ङा। <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />ओटन जब ओ रां सत्यले निया बेला सङ्सारजन पाप दोसी ठहराइन्यालेया। <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />नकाङ ङाजन बिस्वास माढाङरदी, नैताइस्यु पापले गलत ठहरिवाङ, <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />जे सत्यताल बारेल गलत यिङच्या, ङा बौ लेऊदेए हिन्ङा, ओटन ङाजन फरि मारङ्ङचिदी। <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />दानाङभन्या सजाय यांन्या आग्याल बारेल ईका सङ्सारला शासकजन पैलाईज दोसी ठहराइस्युई लेया।”<note caller="-" style="x"><char style="xo" closed="false">16:11 </char><char style="xt" closed="false"><ref loc="JHN 12:31">यहुन्ना १२:३१</ref></char></note><verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />“ङा जेजन अझै भ्याई छेन पानस्यान्या ताइज्याया, तर आकअ जे नका छेन सहिउ माढुदुचिदी। <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />जब ओ, सत्यल आत्मा अथाबा पबित्र आत्मा रां, तब ओले जेजन सोगलै सत्यताल डोऱ्याइचिवा। ओ आतरफङन छ्योङन्या माल्दी। ओले जो थटौ, नकाई छ्योङन्या लेया, ओटन ताइरांन्या छेनयाङ जेजन मुइन्या लेया। <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />ओले ङा महिमा ढान्यालेया, दानाङभन्या जो ङामि हो, ना ङाल्योङन हिनस्यु जेजन नाइ मुइन्या लेया। <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />जो बौ सकाए ले, ना ङामिइ ज्या। नैताइस्यु ङा पानङा, जो ङामि हो ना ङा हिनस्यु यांच्या, ओटन पबित्र आत्माङन जेजन पानस्याच्या।”<verse eid="JHN 16:15" /></para>
  <para style="s">दुख सनर सुख</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“तचिइ छिन्ट जे ङाजन फरि रङन्या माल्चिदी, ओटन ओलं छिन्ट ङाजन फरि रङन्या लेच्या।”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />तब येशुल काङ्का-काङ्का सिइयाङै रारांल ऐलिज्यावाङ, “येशुले गेजन ईका नै आपानस्यायिउ? ‘तचिइ छिन्ट जे ङाजन रङन्या माल्चिदी, ओटन फरि तचिइ छिन्ट जे ङाजन रङन्या लेच्या,’ ओटन ‘दानाङभन्या ङा बौ ल्यौदेए हिनज्याङा।’” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />नकाङै ऐलेवाङ, “ओले ‘तचिइ छिन्ट’ ओमनआलन्या नैति? ओले नै आपानौ नकाल अर्थ नैति गे मासन्दुया।”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />सिइयाङै ङाजन गिनन्या इच्छ्या ढाज्यावाङ ऐलेन्या येशुजन थाह ताहौ, ओटन ओले ऐलेऊ, “तचिइ छिन्ट जे ङाजन रङन्या माल्चिदी, ओटन तचिइ छिन्ट ङाजन रङन्या लेच्या ऐङालन्या छेनल अर्थ नैति ईका बारेल नैति जे बहस जेढाज्याचिऊ। <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />मछ्यु ङा जेजन ऐढाच्या, जे व्‌रस्यु हिकंहिकं लेच्या, तर सङ्सार हेसाङा। जे आतिन्या लेच्या, तर जे आतिइ आनन्दल फिरिसिन्या लेया। <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />लुल जर्माइन्या बेला मेएमाले दुख डोएवा, दानाङभन्या नकाल बेला रा:स्यु लेया, तर जब नकाले लुल जर्माहौ, तब नाजन आस्याहूरलं यांका माताइदी दानाङभन्या सङ्सारलं तोलोअ लुलल जरम ताहौ ऐलेन्या छेनत नका हेसाङा।<note caller="-" style="x"><char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="ISA 26:17">यशैया २६:१७</ref>; <ref loc="MIC 4:9">मीका ४:९</ref></char></note> <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />ऐलेस्युजै आकअ जेजन आतिइभुतिइ ताहा, तर ङा फरि जेजन खिमन्या लेङा, ओटन जेयिङ आनन्दै ताहा। ओटन काङ्काले जेमि आनन्द जेल्योङन न्हानन्यामाल्दी। <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />जब नका दिन रांया, जे ङाजन नैज बै गिनन्या माल्चिदी। मछ्यु ङा जेजन ऐढाच्या, जे ङा मिनत बौसकाए जो नीच्यो, ओले ना जेजन यांन्याई लेया। <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />आकअ समन जे ङा मिनतन नैज नीस्यु माल्चिदी। नीचिते, ओटन जे डोएन्यालेच्या। ऐलेस्युजै जे आनन्द पुरा ग्याताइत्या।”<verse eid="JHN 16:24" /></para>
  <para style="s">सङ्सारतन आझ्योङन्या</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“ईका छेन जेजन ङा आहानङन पानस्याच्या। तर बेला रांज्याया, जब ङा जेसकाए फरि आहानङन छ्योङन्या मालेङदी, तर बौल बारेङन जेजन प्रस्टै पानन्यालेङा। <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />ना छिम्क जे ङा मिनतन नीन्या लेच्या। ङा जे नाल्ट बौसकाए बिन्ति ढास्याच्या ऐलेस्यु जेजन ऐमाढाचिदी, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />दानाङभन्या बौले ओलजै जेजन मया ढाचिवा, ओटन जे ङाजन मया धाङच्या, ओटन ङाजन परमेस्वरलं तरफङन रांऔ ऐलेस्यु बिस्वास जेढाङचिऊ। <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />ङा बौ ल्योङन ङारांङु, ओटन सङ्सारलं रा:स्यु ङाल्ङु, ओटन फरि ङा सङ्सारजन राइस्यु बौलेऊदेए हिनज्याङा।”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />येशुल सिइयाङै ऐलेवाङ, “आब नङ प्रस्टै छ्योङज्याना, आहानङन माङडी। <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />आब गे बुजिदुया, नङ सोगलै छेन सन्ना, ओटन नङ काङ्काईजन गिनन्या आबस्यक माल्दी। गे नैताइस्युई बिस्वास गेढोयिउ, कि नङ परमेस्वरङन नरानु हो।”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />येशुले नकाङजन जबाक आयोवाङ, “नैति जे आब बिस्वास ढोच्या?<note caller="-" style="x"><char style="xo" closed="false">16:31 </char><char style="xt" closed="false"><ref loc="JHN 8:29">यहुन्ना ८:२९</ref></char></note> <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />ब्याएचिते, बास्तपलं बेला तापरादा, जब जे सेरासेट्ट ताइस्यु जे झिमलै हिनच्या ओटन ङाजन ङाबाठए बनाटङच्या। ताहकन बै ङा ङाबाठए मालेङदी, दानाङभन्या ङासकाए बौ लिज्याया। <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />ङा जेजन ईका छेन नैताइस्यु ङापानस्याचिऊ, कि ङात जेजन शान्ति ग्याताइत्या। सङ्सारलं जेजन दुख ताइन्यालेया, तर साहस ढोचिते, ङा सङ्सारजन झ्योङस्यु लेङा।”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">येशुले आ सिइयाङ नाल्ट प्रार्थना आढोव</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />ईका आपानौ छिन्ट येशुले आ म्युउ स्वर्गदेए खिमस्यु ऐलेऊ, “औ बौ, समाय तापरादा, न ज़ाल महिमा सथन्ते। ओटन ज़ाले न महिमा ग्याथनौत्या। <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />दानाङभन्या नङ ओजन सोगलै रुयर्त अढिकार यांस्यु लेना, ताकि नङ ओजन नयांन्या सोगलै रुयाङजन ओले अनन्त जिबन ग्यायौरत्या। <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />आब अनन्त जिबन अर्थ ईकाइ ज्या, कि नकाङै नङ तोलोअयाएज सत्य परमेस्वरजन ग्याशईरत्या, ओटन नङ नपरिङन्या येशु ख्रीस्टजन ग्याशईरत्या। <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />जो काम नङ ङाजन नयांङनु, ना पुरा ढास्यु नङजन ङा पिरथ्बील न महिमा ङाढोङु। <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />औ बौ, आब सङ्सारला स्रिस्टी आताहौ हादेए न सामन्दी जो ङा महिमा लेऊ, नैकाईले न उपस्थितिलं ङाजन महिमित जातङते।”<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“सङ्सारलं जो रुयाङ नङ ङाजन नयांङनु, नकाङजन न मिनजन ङा थनसिस्यु लेङा। नकाङ नमीई लेवाङ, ओटन नङ नकाङ ङाजन नयांङनु, ओटन नकाङै नमी बचन पालन ढाज्यारा। <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />नकाङजन आब थाह ऐलेया, कि नङ ङाजन नयांन्या सोगलै छेन नल्योङन रांऔ ज्या। <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />दानाङभन्या जो बचन नङ ङाजन नयांङनु, ङा नकाङजन यांस्यु लेङा, ओटन नकाङै ना ग्रहन ढास्यु लेरा। ङा नल्योङन ङारांङु ऐलेन्या नकाङै मछ्युजै सनस्यु लेरा, ओटन नङ ङाजन नपरिङनु ज्या ऐलेस्यु नकाङै बिस्वास ढास्यु लेरा।”<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />ङा नकाङल नाल्ट प्रार्थना ढोङा, सङ्सारलं नाल्ट ङा प्रार्थना माढोङदी, तर नकाङल नाल्ट, जोजोरुयाङ नङ ङाजन नयांङनु। दानाङभन्या नकाङ नमियाङ ज्या। <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />ङामि जो ले सोगलै नमीईज ज्या, ओटन नमी जो ले ओ ङामिइज ज्या। ङा महिमा नकाङ्ङन रंनौ। <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />“ङा फरि सङ्सारलं मालिज्याङदी,” तर इकाङ ता सङ्सारलै लिज्यारा। ङा नल्योङ रांज्याङा। पबित्र बौ, नङ ङाजन नयांङन्या नमिनत नकाङजन सुरक्छित नाटौरते, ओटन घेनमन्जै नकाङ बै तोलोअ ग्याताइरत्या। <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />जब समन ङा नकाङ सकाए ङाल्ङु, नङ ङाजन नयांन्या सक्तिशाली मिनतन नकाङजन सुरक्छित ङानाटङवाङ। नकाङल रक्छ्या ङाढोङु। ओटन नकाङ्ङन बिनाशल ज़ा बाहेक अपुर काङ्काई नस्ट माताइदा, दानाङभन्या पबित्रशास्त्र पुरा ताइन्या आबस्यक लेऊ।<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजनसङ्ग्रह ४१:९</ref>; <ref loc="JHN 13:18">यहुन्ना १३:१८</ref>; <ref loc="JHN 18:9">१८:९</ref></char></note> <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />“तर आब ङा नल्योङ रांज्याङा। सङ्सारलं ङाल्यौक ईका छेन ङा छ्योङ्ङा, कि नकाङल्योङ ङायिङलं आनन्दले पुरा ग्याताइत्या। <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />ङा नकाङजन नबचन ङायोङवाङ, तर सङ्सारले नकाङजन आसज्युवाङ, दानाङभन्या नकाङ सङ्सारलाङ माङडी, जोमनलेस्यु ङा सङ्सारला माङडी। <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />नङ नकाङजन सङ्सारलन लाङौरते ऐलेस्यु ङा प्रार्थना माढोङदी, तर नकाङजन दुस्टतन सुरक्छित नाटौरते। <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />जोमनलेस्यु ङा ईका सङ्सारला माङडी, ओमनलेस्युजै नकाङ बै ईका सङ्सारलाङ माङडी। <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />नकाङजन सत्य सनर पबित्र कामल नाल्ट रांईझन्ज समर्पित ग्याजाएरत्या, जो नमी बचन सत्य लेया। <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />जोमनलेस्यु नङ ङाजन सङ्सारलं नपरिङनु, ङा बै नकाङजन सङ्सारलं परिङस्यु लेङा। <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />नकाङल नाल्ट ङा ङाईझन्ज पबित्र जाएङा, ताकि नकाङ बै सत्यताले पबित्र ग्याताइरत्या।<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“ङा इकाङ नाल्ट याएज प्रार्थना माढोङदी, तर इकाङ थाईतन ङाजन बिस्वास ढान्याङल नाल्ट बै प्रार्थना ढोङा, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />कि नकाङ सोगलै तोलोअ ग्याताइरत्या। औ बौ, जोमनलेस्यु नङ ङासं नलिज्यानु, ओटन ङा नङत, नैलेस्युई नकाङ बै गेसकाए ग्यालेरत्या। ओटन नङ ङाजन नपरिङनु ऐलेस्यु सङ्सारले बिस्वास ग्याढोउत्या। <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />जो महिमा नङ ङाजन नयांङनु, ङा नकाङजन यांस्यु नाटङरा, ताकि जोमनलेस्यु गे तोलोअ गेताइयिउ नकाङ बै ओमनलेस्युई तोलोअ ग्याताइरत्या। <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />ङा नकाङत, सनर नङ ङात, ओटन नकाङ बअबनाई तोलोअ ग्याताइरत्या, ओटन नङ ङाजन नपरिङन्या, सनर ङाजन प्रेम नढान्यामन नङ नकाङजन बै प्रेम नढोन्वाङ ऐलेस्यु सङ्सारले ग्यासनौत्या।<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />“बौ, ङा इच्छ्या ढोङा, कि नङ ङाजन नयांन्या रुयाङ ङा जोङ लेङ ङासै ग्यालिज्यारत्या, ओटन ङा महिमा ग्यारङरत्या, जो महिमा, सङ्सारलं स्रिस्टी ताहौ हादेएजै ङाजन प्रेम नढाऔकाले नङ ङाजन यांस्यु नल्‌नु।” <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />“धार्मिक बौ, सङ्सारले नङजन माशईदुन्वा, तर नङजन ङा ऐशईना, ओटन नङ ङाजन नपरिङनु ज्या ऐलेस्यु इकाङै ऐसनज्यारा। <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />ङा नमिन इकाङ ल्योङ ङासथन्ङु, ओटन नमिन इकाङ ल्योङ सथनज्याङा, ताकि जो प्रेम नङ ङाजन नढाङनु, नका प्रेम नकाङल्योङ ग्यालत्या, ओटन ङा नकाङल्योङ ग्यालिज्याङत्या।”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">येशु आकोलोसिन्या</para>
  <para style="r">
    <ref loc="MAT 26:47-56">मत्ती २६:४७-५६</ref>; <ref loc="MRK 14:43-50">मर्कुस १४:४३-५०</ref>; <ref loc="LUK 22:47-53">लूका २२:४७-५३</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />येशुले प्रार्थना आढाऔ छिन्ट आसिइयाङसं किद्रोन खोल्सा हुदिफन हिनौ, नङ तोलोअ बारी लेऊ ओटन आसिइयाङसं ओलं हिन्वाङ। <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />ओलजन कोलोअन्या यहूदाले बै नका पो शईस्यु लेऊ, दानाङभन्या येशु सनर आ सिइयाङ तबर पाला ओलं हिनस्युलेवाङ। <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />तब कजम्तिइ, भाङ सनर हतियारयाङ होनन्या सिपाइयाङल त बगाल सनर मुख्या पुजाउरो सनर फरिसीयाङै रापरिङन्या पाल्याङजन हिनस्यु यहूदा बारील रांऔ। <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />तब आयर्त परिरान्या सोगल छेन सनस्यु येशु हाङन रांऔ, ओटन नकाङजन ऐआढोवाङ, “जे काङ्काजन जेरोअज्याचिऊ?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />नकाङै ओजन ऐराढोव, “नासरतला येशुजन।” येशुले नकाङजन ऐआढोवाङ, “ङा ओइ ज्या।” आब ओलजन कोलोअन्या यहूदा बै नकाङसै च्याङज्याऊ। <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />जब येशुले नकाङजन ऐआढोवाङ, “ङा ओइ ज्या” ऐलेऊ, तब नकाङ छिन्देए हाएसिवाङ, ओटन नामल पाइवाङ। <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />फरि नकाङजन आगिन्वाङ, “जे काङ्काजन जेरोअज्याचिऊ?” नकाङै ऐलेवाङ “नासरतला येशुजन।” <verse eid="JHN 18:7" /><verse number="8" style="v" sid="JHN 18:8" />येशुले जबाक आयोवाङ, “ङा जेजन ऐढादुच्या, कि ङा ओइ ज्या। नैताइस्यु यदि जे ङाजन रोअज्याङच्योकन ईका रुयाङजन हिनौ योंचिरते।” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />“नङ ङाजन नयांन्याङ्ङन तोलोअजन बै ङा मागवाइदुङरा” ओले ऐआलन्या बचन पुरा ग्याताइत्या ऐलेस्यु ईका ताहौ।<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />सिमोन, पत्रुसले ओलसं लिज्यान्या तरवाल हाएस्यु मुख्या पुजाउरोल सेवाऱ्याजन आराइस्याऔक नकाल दाइन्या ना च्वाट्टै आपलस्यौ। नका सेवाऱ्याल मिन हो माल्खस। <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />येशुले पत्रुसजन ऐआढोव, “तरवाल सिपल झोअते। नैति बौले ङाजन आयांन्या कटौरा ङा माओङा?”<note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="MAT 26:39">मत्ती २६:३९</ref>; <ref loc="MRK 14:36">मर्कुस १४:३६</ref>; <ref loc="LUK 22:42">लूका २२:४२</ref></char></note><verse eid="JHN 18:11" /></para>
  <para style="s">येशु हन्नासल लेऊक</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />“नालछिन्ट रोमी पाल्याङल बगाल, नकाङल कप्तान, सनर यहूदी अढिकारीयाङल पाल्याङै येशुजन राकोलोकौ, ओटन ओलजन रांपोकौ। <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />हादेए नकाङै ओलजन हन्नासल्योङ रालाङौ, जो नका साल्ला प्रधान पुजाउरो कैयाफाल मामा लेऊ। <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />ईकाइ कैयाफा ज्या, जोले ‘जनताल नाल्ट तोलोअ रु आसिन्याई चान्या लेया’ ऐलेस्यु यहूदी अढिकारीयाङजन सल्ला यांस्यु आनाएवाङ।”<note caller="-" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="JHN 11:49-50">यहुन्ना ११:४९-५०</ref></char></note><verse eid="JHN 18:14" /></para>
  <para style="s">पत्रुसले येशुजन इन्कार आढान्या</para>
  <para style="r">
    <ref loc="MAT 26:69-70">मत्ती २६:६९-७०</ref>; <ref loc="MRK 14:66-68">मर्कुस १४:६६-६८</ref>; <ref loc="LUK 22:55-57">लूका २२:५५-५७</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />सिमोन पत्रुस सनर येशुल छुट्टै तोलोअ सिइ येशुल छिन्ट लागिऊ। ना छुट्टै सिइ प्रधान पुजाउरोल नशईन्या लेऊ, ओटन येशु सकाएजै प्रधान पुजाउरोल ठरबाङल हिनौ। <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />तर पत्रुस पाखाङ झलापत च्याङज्याऊका। जो प्रधान पुजाउरोले नशईन्या छुट्टैवाला सिइ, पाखाल पलिईस्यु झलापल चुङन्या किटीजन खुलौपरिङस्यु पत्रुसजन भितर आहोनौ। <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />तब झलापत चुङन्या नका किटीले पत्रुसजन ऐआढोव, “नैति नङ बै ईका रुल सिइयाङ्ङन तोलोअ माङडी का?” पत्रुसले ऐआढोव, “ङा माङडी” <verse eid="JHN 18:17" /><verse number="18" style="v" sid="JHN 18:18" />नङ नोक्करयाङ सनर पाल्याङ भलाङज्यान्या मी मुनसिस्यु च्याङज्यावाङ, दानाङभन्या झिमज्याऔ। ओटन पत्रुस बै नकाङसं च्याङस्यु मी मुनसिऊ तअसिऊ।<verse eid="JHN 18:18" /></para>
  <para style="s">येशुजन प्रधान पुजाउरोयाङ्ङन ग्यानगिन</para>
  <para style="r">
    <ref loc="MAT 26:59-66">मत्ती २६:५९-६६</ref>; <ref loc="MRK 14:55-64">मर्कुस १४:५५-६४</ref>; <ref loc="LUK 22:66-71">लूका २२:६६-७१</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />आब प्रधान पुजाउरोल येशुजन आ सिइयाङ सनर आसिछ्यालं बारेल आगिनौ। <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />येशुले नकाजन जबाक आयोव, “ङा सङ्सारलं सोगलैजन प्रस्टै पानस्युलेङा। ङा सदाईज आराधना झिमजिऊल सनर मन्दिर जिऊल सिक्छ्या यांज्याङा, जोल सोगल यहूदीयाङ दुउसिरा। ङा गोप्यल नैज पानस्यु मालेङदी। <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />ङाजन दानाङ गिनज्याङ? ङा नकाङजन कैङाढोङवाङ ना थएन्याङझन्जै गिनौरते। ङा ङापानन्या छेनयाङ इकाङजन थाहै लेया।”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />येशुले ईका छेन आपानौक नेराक च्याङज्यान्याङ पाल्याङ्ङन तोलोअले ऐलेस्यु येशुजन आलपत्याहौ, “नैति प्रधान पुजाउरोजन ऐलेस्यु जबाक योंना?”<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="LUK 5:1">लूका ५:१</ref>; <ref loc="LUK 22:63">लूका २२:६३</ref></char></note> <verse eid="JHN 18:22" /><verse number="23" style="v" sid="JHN 18:23" />येशुले नकाजन ऐआढोव, “ङा गलत बयन ङायान्या ताहकन नकाल प्रमान यांङते, तर यदि ङा ठिकै ङापानन्या ताहकन ङाजन दानाङ टुपङ?” <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />तब हन्नासले ओलजन पोअसिज्यान्याईज प्रधान पुजाउरो कैयाफा ल्योङ आपरिङौ।<verse eid="JHN 18:24" /></para>
  <para style="s">पत्रुसलं नेंपाला सनर तिस्रा चोए इन्कार</para>
  <para style="r">
    <ref loc="MAT 26:71-75">मत्ती २६:७१-७५</ref>; <ref loc="MRK 14:69-72">मर्कुस १४:६९-७२</ref>; <ref loc="LUK 22:58-62">लूका २२:५८-6२</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />सिमोन पत्रुस च्याङस्यु मी मुनसिज्याऔ। नकाङै नकाजन ऐराढोव, “नैति नकाल सिइयाङ्ङन तोलोअ नङ बै माङडी?” नकाले माभनस्यु ऐआढोवाङ, “ङा माङडी।” <verse eid="JHN 18:25" /><verse number="26" style="v" sid="JHN 18:26" />प्रधान पुजाउरोल सेवाऱ्याङ मध्य तोलोअ, जोल नालनाठाल नां पत्रुसले आपलस्यौ, नकाले आगिनौ, “नैति नङजन ङा नकासं बारील ङामारङनु का?” <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />तब फरि पत्रुसले इन्कार आढोव। ओटन ओचोएटै भाल्या कोव।<verse eid="JHN 18:27" /></para>
  <para style="s">पिलातसल सामन्दी येशु</para>
  <para style="r">
    <ref loc="MAT 27:1-2">मत्ती २७:१-२</ref>; <ref loc="MRK 15:1-5">मर्कुस १५:१-५</ref>; <ref loc="LUK 23:1-5">लूका २३:१-५</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />तब नकाङै येशुजन कैयाफाल झिमलन महल लेऊदेए आलाङौ। नवाए बेला छकाल्यादेए हो। जुठुउ परीस्यु निस्तार-पर्बल ज्यान्या ज्याऔ माढोतैदी ऐलेन्या, छ्याइले नकाङ महल भितरलं मापसिवाङ। <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />ऐताइस्यु नकाङल्योङ पाखा पलिईस्यु पिलातसले ऐआढोवाङ, “ईका रुल बिरोदत नैकाम दोस लाइच्यो?” <verse eid="JHN 18:29" /><verse number="30" style="v" sid="JHN 18:30" />यहूदी अढिकारीयाङै ऐलेवाङ, “यदि ईका रु अपरादि माताहकन गे इकाजन नल्योङ मासुम्पिइदी।”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />पिलातसले यहूदी अढिकारीयाङजन ऐआढोवाङ, “जे इकाजन लाङचिते, ओटन जे जेमिई ब्यबस्था अनुसार इकाल निया ढोचिते।” यहूदी अढिकारीयाङै ओलजन ऐराढोव, काङ्काई रुजन म्रित्युदन्ड यांन्या अढिकार गेसं माल्दी। <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />येशुल काल कैताइन्या रीतिले ताइन्या नकाल सङ्केट यांस्यु ओले आपानन्या बचन पुरा ग्याताइत्या ऐलेस्यु ऐताहौ।<note caller="-" style="x"><char style="xo" closed="false">18:32 </char><char style="xt" closed="false"><ref loc="JHN 3:14">यहुन्ना ३:१४</ref>; <ref loc="JHN 12:32">१२:३२</ref></char></note> <verse eid="JHN 18:32" /><verse number="33" style="v" sid="JHN 18:33" />पिलातस फरि महल भितरलं पसिऊ, ओटन नकाले येशुजन खुल्स्यु ऐआढोव, “नैति नङ यहूदीयाङल रय रों?” <verse eid="JHN 18:33" /><verse number="34" style="v" sid="JHN 18:34" />येशुले जबाक आयोव, “नङजै ऐलिज्याना, सन् ङाबारेङन नङजन अपुर काङ्काङै रापानस्यानु?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />पिलातसले जबाक आयोव, “नैति ङाक्या यहूदी का? नरुयाङ सनर मुख्या पुजाउरोयाङै नङजन ङाकुईत रा:सुम्पिनु। नङ नै नढोनु?” <verse eid="JHN 18:35" /><verse number="36" style="v" sid="JHN 18:36" />येशुले जबाक आयोव, “ङा राज्य ईका सङ्सारला माङडी ङा राज्य ईका सङ्सारलं आलन्या ताहकन्ता ङा सेबकयाङ ङा नाल्ट खप्सिदुरा होला, ओटन ङा यहूदीयाङ कुईत परिन्या मालेङदी। तर ङा राज्य ईका सङ्सारलं माङडी।” <verse eid="JHN 18:36" /><verse number="37" style="v" sid="JHN 18:37" />पिलातसले ओलजन आगिनौ, “नै नङ रय ज वन?” येशुले जबाक आयोव, “ङाजन नङजै रय ऐढाङज्याना। इकालै नाल्ट ङा ङाजर्मिङु हो, ओटन इकालै नाल्ट सत्यल बयन यांन्या ङा ईका सङ्सारलं ङारांङु हो। सोगल जो सत्यल पक्छेल ले, नकाले ङा ग़ा थएवा।”<note caller="-" style="x"><char style="xo" closed="false">18:37 </char><char style="xt" closed="false"><ref loc="1JN 4:6">१यहुन्ना ४:६</ref></char></note> <verse eid="JHN 18:37" /><verse number="38" style="v" sid="JHN 18:38" />पिलातसले ओलजन आगिनौ, “सत्य नैति?” छेन छ्योङस्यु ओलं यहूदी अढिकारीयाङ ल्योङ पाखा पलिईस्यु हिनौ, ओटन नकाङजन ऐआढोवाङ, ङा इकाल नैज दोस माडोटङदी।<verse eid="JHN 18:38" /></para>
  <para style="s">येशुजन म्रित्युदन्डल आग्या</para>
  <para style="r">
    <ref loc="MAT 15:27">मत्ती १५:२७</ref>; <ref loc="MRK 6:20">मर्कुस ६:२०</ref>; <ref loc="LUK 23:13-25">लूका २३:१३-२५</ref></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />“निस्तार-पर्बक बेलाक जे नाल्ट तोलोअजन राइस्यान्या जेचलन लेया। कि यहूदीयाङल रयजन राहङ सन् कैजेल्चिऊ?” <verse eid="JHN 18:39" /><verse number="40" style="v" sid="JHN 18:40" />तर नकाङ फरि ऐलेस्यु कलिऊवाङ, “इकाजन माङडी, बारब्बाजन।” बारब्बा डाङ्का लेऊ।<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />तब पिलातसले येशुजन लाङस्यु कोर्ला लाहौ आपरिङवाङ। <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />ओटन सिपाइयाङै ज़ुल मुकुट लएस्यु ओलं ङएट रांजाटौ, ओलजन धुङल्याइन्या रङला क्वा रांक्वाटौ, <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />ओटन येशु ल्योङ रा:स्यु ऐराढोव, “जडौ, यहूदीयाङल रय!” ओटन नकाङै ओलजन रालप्ट्याहौ। <verse eid="JHN 19:3" /><verse number="4" style="v" sid="JHN 19:4" />फरि पाखाल पलिईस्यु पिलातसले नकाङजन ऐआढोवाङ, “खिम्चिते, ङा इकाजन जेल्योङ पाखाल ङाहोनज्याङु, ओटन जेजन आका पानस्याऔ ङारोअङु, इकाल नैज दोस माडोटङदी।” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />तब ज़ुल मुकुट सनर धुङल्या<note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false">धुङल्या रङ=बैजनी रङ</char></note> रङला क्वा क्वाएसिन्या येशु पाखाल रांऔ, ओटन पिलातसले नकाङजन ऐआढोवाङ, “खिम्चिते, ईका रुजन!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />जब मुख्या पुजाउरोयाङ सनर पाल्याङै येशुजन रांरङौ, नकाङ ऐलेस्यु चिचच्याहौ तअसिवाङ, “नकाजन क्रूसतं केपचिते, नकाजन क्रूसतं केपचिते, पिलातसले ऐलेऊ, ङा इकाल नैज दोस माडोटङदी!” <verse eid="JHN 19:6" /><verse number="7" style="v" sid="JHN 19:7" />यहूदी अढिकारीयाङै पिलातसजन जबाक रांयोव, “गेमि तोलोअ ब्यबस्थाला नियाम लेया, ओटन नका ब्यबस्थाला अनुसार ईका सिऊजपरिया, दानाङभन्या इकाले ओलझन्जै परमेस्वरलं ज़ा ऐलेन्या जिग्राइ ढाज्याया।”<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवी २४:१६</ref></char></note><verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />ईका छेन थएस्यु पिलातस झन्जै छ्याटौ। <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />ओटन फरि येशुजन महल भितरलं लाङस्यु आगिनौ, “नङ काङा हो?” तर येशुले नकाजन नैज जबाक मायोडा। <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />ऐताइस्यु पिलातसले ओलजन ऐआढोव, “नैति नङ ङासकाए माछ्योङना? नङजन राइन्या अढिकार ङासं लेया, ओटन नङजन क्रूसतं केपन्या अढिकार बै ङासकाए लेया ऐलेन्या नङजन थाह मालेऊ?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />येशुले जबाक आयोव, “नङजन परमेस्वरङन मायासिकन ङाजन नमी नैज अढिकार माताइन्यालेऊ। नैताइस्यु ङाजन नकुईत सुम्पिन्या अझै भ्याई पापल दोसी लेया।” <verse eid="JHN 19:11" /><verse number="12" style="v" sid="JHN 19:12" />नकाल छिन्ट पिलातसले येशुजन राइन्या भ्याई जोर आढोव। तर यहूदी अढिकारीयाङ ऐलेस्यु कलिऊवाङ, “यदि नङ ईका रुजन रांनकन नङ कैसरलं न्हाए माङडी। नाले ओलजै ङा रय ज्या ऐलेस्यु जिग्राइ ढास्यु कैसरलं बिरोदत च्याङज्याया।”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />पिलातसले ईका छेन थएस्यु येशुजन पाखाल आहोनौ, ओटन ओ “लुङल पाटी” ऐढासिन्या पोल (जोजन हिब्रूङन गब्बथा ऐढासिया) निया ढान्या पोत चुङौ। <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />नका समाय निस्तार-पर्बल तयारील दिन लेऊ। लाअका छ्योअ बारं बजिस्यु लेऊ। पिलातसले यहूदी अढिकारीयाङजन आढोवाङ, “खिम्चिते, जे रय!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />तर नकाङ ऐलेस्यु चिचच्याइवाङ, “नाजन सएचिते, सएचिते, लाङस्यु क्रूसतं केपचिते!” पिलातसले नकाङजन आगिन्वाङ, “नैति ङा जे रयजन क्रूसतं केपन्या।” मुख्या पुजाउरोयाङै जबाक रांयोव, “कैसर बाहेक अपुर काङ्काई गे रय माल्दी।” <verse eid="JHN 19:15" /><verse number="16" style="v" sid="JHN 19:16" />तब नकाले येशुजन क्रूसतं केपौ नाल्ट नकाङल कुईत आसुम्पिऊ। ओटन सिपाइयाङै येशुल जिम्मा राहोनौ।<verse eid="JHN 19:16" /></para>
  <para style="s">येशुजन क्रूसतं राकेपौ</para>
  <para style="r">
    <ref loc="MAT 27:32-44">मत्ती २७:३२-४४</ref>; <ref loc="MRK 15:21-32">मर्कुस १५:२१-३२</ref>; <ref loc="LUK 23:26-43">लूका २३:२६-४३</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />येशुले आक्रूस ओलजै वुरस्यु खप्पऱ्या ऐढासिन्या पोल हिनौ, जोजन हिब्रूङन गलगथा ऐढासिया। <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />नल नकाङै येशुजन क्रूसतं राकेपौ ओटन ओलसं अपुर नेंलोअ रुनेंजन बै राकेपौ, तोलोअजन आङन सनर छुट्टैजन हुङन ओटन खार्ल येशुजन। <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />पिलातसले तोलोअ दोस पाटी बै आसरौ, ओटन क्रूसतं राचप्काहौ। नकाल ईकाइ सरसिज्याऔ, “नासरतला येशु, यहूदीयाङल रय।” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />आब तबर यहूदीयाङै ईका दोस-पाटी परिवाङ, दानाङभन्या येशुजन क्रूसतं राकेपन्या पो सहरल नेराकै लेऊ। ईका हिब्रू, ल्याटिन सनर ग्रीक छिन्ङन सरसिस्यु लेऊ। <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />यहूदी अढिकारीयाङल मुख्या पुजाउरोयाङै पिलातसजन ऐराढोव, “यहूदीयाङल रय, ऐलेन्या माङडी तर ईकाले ङा यहूदीयाङल रय ज्या ऐलेऊ लेस्यु सरते।” <verse eid="JHN 19:21" /><verse number="22" style="v" sid="JHN 19:22" />पिलातसले जबाक आयोवाङ, “ङा जो ङासरङु, ओ सरदुङा।”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />जब सिपाइयाङै येशुजन क्रूसतं राकेपौ, तब नकाङै येशुल क्वा हिनस्यु सोगलै सिपाइजन त-त बठा ताइन्या हिसापत चार भाअ रांजाटौ। आमि बाहेऱ्या क्वा बै राहोनौ, तर ना क्वा मारुफ्सिन्या हरङन वान्ङ समन रअसिन्या थानजै लेऊ। <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />ईका कारनले नकाङै रारांल ऐलेवाङ, “ईका क्वा चिइन्या माङडी, बरु गे इकाजन चिठ्ठा झोअया ओटन काङ्काजन परिऊ।” पबित्रशास्त्रलं सरसिन्या बचन पुरा ग्याताइत्या ऐलेस्यु जै ऐताहौ। “तब नकाङै बाहेऱ्या ङा क्वा रारांल चिठ्ठा राझोकौ।”<note caller="-" style="x"><char style="xo" closed="false">19:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">भजनसङ्ग्रह २२:१८</ref></char></note><verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />ओटन नका पाल्याङै नैताइन्या काम राढाज्याऔक, येशुल क्रूसल नेराक आअमा, सनर आअमाल बैना, क्लोपासलं मेएमा मरियम सनर मरियम मग्दलिनीने च्याङस्यु ब्याएज्यावाङ। <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />जब येशुले आअमा सनर ओलं मया आढान्या सिइ नेराकै नेंच्याङज्यान्या आरङौने, तब येशुले आअमाजन ऐआढोव, “ऐ ज़ामा, खिम्ते, न ज़ा!” <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />तब नका सिइजन बै येशुले ऐआढोव, “खिम्ते, नाअमा!” नवाए बेलाकै नका सिइले मरियमजन आझिमल आराइनाङौ।<verse eid="JHN 19:27" /></para>
  <para style="s">येशुल सिइकाल</para>
  <para style="r">
    <ref loc="MAT 27:45-56">मत्ती २७:४५-५६</ref>; <ref loc="MRK 15:33-41">मर्कुस १५:३३-४१</ref>; <ref loc="LUK 23:44-49">लूका २३:४४-४९</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />येशुले आब सोगलै छेन खेम्दा ऐलेन्या सनस्यु पबित्रशास्त्र पुरा ग्याताइत्या ऐलेऊ, “ङा री ङाओइज्याङु।”<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="PSA 22:15">भजनसङ्ग्रह २२:१५</ref>; <ref loc="PSA 69:21">६९:२१</ref></char></note> <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />ओक तोलोअ जाल तफाङ अङ्गुरल रस नाएसिज्याऔ। ओटन तोलोअ वारल<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="ft" closed="false">सिर्का=कान्या रस, स्पन्ज=रुवा, हिसप=वार</char></note> टुप्पात रुवा पोअस्यु फाङताइज्यान्या कान्या रस येशुल याह्‌ल नकाङै राझोअस्योव। <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />जब कान्या रस आओव, तब येशुले ऐलेऊ, “आब खेम्दा,” ओटन आङए बेनजाएस्यु आपरान आराहौ।<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="LUK 23:46">लूका २३:४६</ref>; <ref loc="MRK 15:37">मर्कुस १५:३७</ref></char></note><verse eid="JHN 19:30" /></para>
  <para style="s">येशुल कोखाल भालाले रारुपिन्या</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />नका छिम्क तयारील दिन लेऊ। नैताइस्यु यहूदी अढिकारीयाङै शबाथत, (खास ईका सबाथल जो महत्वला लेऊ) सिन्याङ बुल क्रूसतं तालज्यारत्या ऐलेस्यु पिलातसजन बिन्ति रांढोव, ओटन नकाङल खङ कलाएस्यु नकाङल बुल ग्यालाङरत्या लेस्यु नीवाङ। <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />तब पाल्याङ रा:स्यु ओलसं क्रूसतं केप्सिन्यानेलं खङ राकलाटौ, हादेए तोलोअल, ओलं छिन्ट छुट्टैल। <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />जब नकाङ येशु ल्योङ रांवाङ, तर ओलं हादेए जै सिदा रैस, ऐलेस्यु रांरङौ, ओटन आखङ माकलाएरदी। <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />तर पाल्याङ्ङन तोलोअले आकोखाल भालाले आघोचच्याहौ, ओटन ओचोएटै जी सनर री पलिहौ। <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />जे बै बिस्वास ढाऔ ढुदुचिते ऐलेस्यु ईका रङन्याले गवाइ आयांन्या हो ओटन ओलं बयन सत्य लेया, ओटन सत्य छ्योङ्ङा ऐलेस्यु ओलं ऐसन्वा। <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />“नकाल नैज रूई माकलादी” ऐलेन्या पबित्रशास्त्रला बचन पुरा ग्याताइत्या ऐलेस्यु ईका छेन ताइरा:औ।<note caller="-" style="x"><char style="xo" closed="false">19:36 </char><char style="xt" closed="false"><ref loc="EXO 12:46">प्रस्थान १२:४६</ref>; <ref loc="NUM 9:12">गन्ती ९:१२</ref>; <ref loc="PSA 34:20">भजनसङ्ग्रह ३४:२०</ref></char></note> <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />ओटन फरि छुट्टै पन्डाल पबित्रशास्त्र पान्वा, “जोजन नकाङै घोचच्याइस्यु लेवाङ, नकाङै ओजन खिमन्या लेरा।”<note caller="-" style="x"><char style="xo" closed="false">19:37 </char><char style="xt" closed="false"><ref loc="ZEC 12:10">जकरिया १२:१०</ref>; <ref loc="REV 1:7">प्रकाश १:७</ref></char></note><verse eid="JHN 19:37" /></para>
  <para style="s">येशुजन रींनन्या काम</para>
  <para style="r">
    <ref loc="MAT 27:57-61">मत्ती २७:५७-६१</ref>; <ref loc="MRK 15:42-47">मर्कुस १५:४२-४७</ref>; <ref loc="LUK 23:50-56">लूका २३:५०-५६</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />नकाल छिन्ट अरिमाथियाला योसेफ, जो यहूदीयाङल छ्याइले गर्दा गोप्यल याएज येशुल सिइ लेऊ, नकाले पिलातसजन येशुल सिन्या बुल लाङौ ग्याडोटङत्या ऐलेस्यु बिन्ति आढोव, पिलातसले अनुमति योंवापाइना। तब नकाले रा:स्यु येशुल सिन्या बुल आलाङौ। <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />ओटन हादेए आल्योङ रिउल रांन्या निकोदेमस बै छ्योअ तिस किलो मुर्र<note caller="+" style="f"><char style="fr" closed="false">19:39 </char><char style="ft" closed="false">मुर्र=सेन्ट</char></note> सनर एलवा<note caller="+" style="f"><char style="fr" closed="false">19:39 </char><char style="ft" closed="false">एलवा=घिऊकुमारी</char></note> भामसिन्या द्रब्य<note caller="+" style="f"><char style="fr" closed="false">19:39 </char><char style="ft" closed="false">द्रब्य=चान्या स्युउ नमन्या तीइ</char></note> हिनस्यु नल रांऔ।<note caller="-" style="x"><char style="xo" closed="false">19:39 </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">यहुन्ना ३:१-२</ref></char></note> <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />ऐलेस्युई येशुल बुल यहूदीयाङल चलन अनुसार रींनन्या कामल नाल्ट आस्युउनमन्या द्रब्यस गजनाल<note caller="+" style="f"><char style="fr" closed="false">19:40 </char><char style="ft" closed="false">गजनाल क्वा=सुति, मलमल</char></note> क्वात रांपोकौ। <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />ओलजन क्रूसतं राकेपन्या पोल तोलोअ बारी लेऊ। नका बारील खकैज काङ्काईजन रांमानाएन्या तोलोअ छार ऊई लेऊ। <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />दानाङभन्या नाछिम्क यहूदीयाङल तयारील दिन लेऊ, ओटन ना ऊई बै नेराकै लेऊ, ओटन नकाङै येशुजन नकाई ऊईल रांनाटौ।<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">धाङ्गिल ऊई</para>
  <para style="r">
    <ref loc="MAT 28:1-8">मत्ती २८:१-८</ref>; <ref loc="MRK 16:1-8">मर्कुस १६:१-८</ref>; <ref loc="LUK 24:1-12">लूका २४:१-१२</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />हप्ताल पहेला दिन छकाल्या च्याअच्याअ च्युऊच्युऊकै मरियम मग्दलिनी ऊईल रांऔ, ओटन नकाले लुङ ऊईलन आहाएसिन्या आरङौ। <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />नका सिमोन पत्रुस सनर येशुले मया आढान्या छुट्टै सिइल्योङ चोएस्यु हिनौ, ओटन नकानेजन आपानस्यौने, “नकानेले ऐलेऊने प्रभुजन ऊईलन पाखाल लाङस्यु, ओजन काङ रांनाटौ, ना घोन मासन्चिदी।” <verse eid="JHN 20:2" /><verse number="3" style="v" sid="JHN 20:3" />तब पत्रुस सनर छुट्टै सिइ पाखाल पलिईस्यु ऊई लेऊदेए हिनौने। <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />ना नेंलोअनें बोलोङबोलोङजै चोटौने, तर छुट्टै सिइ पत्रुसजन उछटत्याइस्यु ऊईल हाल ताप्‌रा:औ। <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />ऊईल भितरलं गोम लेस्यु आब्याटौक, नकाले हाक मलिङसिन्या पाटलो सुतिल क्वायाङ याएज राबोर्सिज्यान्या आरङौ, तर नका भितर मापसिडा। <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />सिमोन पत्रुस नकाल छिनछिन रांऔ, ओटन ऊई भितरलं पसिऊ, ओटन नकाले बै मलमलले बिरिसिन्या क्वायाङ याएज दाङज आवङज्यान्या आरङौ। <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />ओलं आङएल पोअसिन्या रूमाल मलमललं क्वायाङसं मालज्याऔ, तर अलक्कै तपोईत पत्याइस्यु नाएसिन्या लेऊ। <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />तब ऊईल हादेए तापरांन्या छुट्टै सिइ बै भितर पसिऊ, ओटन ना रङस्यु नकाले बिस्वास आढोव। <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />दानाङभन्या नकाङै येशु सिन्यातन जिङदा ताइस्यु सोवपरिया ऐलेन्या पबित्रशास्त्रला बचन अझ समन बुजिस्यु मालेवाङ।<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="PSA 16:10">भजनसङ्ग्रह १६:१०</ref></char></note> <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />नालछिन्ट येशुल सिइयाङ राझिमदेए वल्वाङ।<verse eid="JHN 20:10" /></para>
  <para style="s">येशुजन मरियम मग्दलिनीले आरङन्या</para>
  <para style="r">
    <ref loc="MAT 28:9-10">मत्ती २८:९-१०</ref>; <ref loc="MRK 16:9-11">मर्कुस १६:९-११</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />तर मरियम ऊई पाखाल च्याङस्यु व्‌रज्याऔ। नकाले व्‌रस्यु-व्‌रस्यु ऊई लेऊदेए गोम लेस्यु आखिमौ, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />ओटन जोङ येशुल सिन्या बुल नाएसिऊ, ओलं पालन्या क्वा क्वाएसिन्या नेंलोअ स्वर्गदुतने, तोलोअ ङए ल्योङ छुट्टै खङ ल्योङ नेंचुङज्यान्या आरङौने। <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />नकानेले मरियमजन ऐनेढोव, “औ मेएमा, दानाङ व्‌रज्यान?” नकाले ओनेजन ऐआढोवने, “नकाङै ङा प्रभुजन लाङदुरा रैस, ओटन ओजन काङ रांनाटौ, ङा मासनङदी।”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />नका छ्योङस्यु आछिन्देए आवलौक, नकाले येशुजन आच्याङज्यान्या आरङौ, तर येशुजै ज्या ऐलेस्यु आमासहौ। <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />येशुले नकाजन ऐआढोव, “ऐ मेएमा, नङ दानाङ व्‌रन? काङ्काजन नरोअनु?” नकाले येशुजन बारील माली यिङस्यु आढोव, “औ, नङ ओजन आलन रांलाङन्या ताहकन, काङ रांनाटौ ङाजन पानस्याङते, ओटन ङा ओजन लाङ्ङा।”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />येशुले नकाजन ऐआढोव, “मरियम!” नकाले वलस्यु ओजन हिब्रूल ऐआढोव, “रब्बोनि,” अथाबा “औ गुरु ज्यू!”<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />येशुले नकाजन ऐआढोव, “ङाजन ताछुङ, दानाङभन्या ङा आकअ समन बौल्योङ हिनस्यु मालेङदी। तर ङा भाईयाङ ल्योङ हिनस्यु नकाङजन पानस्योवरते, ‘ङा बौ सनर जे बौ, ओटन ङा परमेस्वर सनर जे परमेस्वर ल्योङ ङाहिनज्याङु।’”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />मरियम मग्दलिनी ओङ हिनस्युकने, सिइयाङजन आसथएवाङ, “ङा प्रभुजन ङारङ्ङु।” ओटन येशुले आपानन्या छेन नकाङजन आपानस्योवाङ।<verse eid="JHN 20:18" /></para>
  <para style="s">येशु सिइयाङ ल्योङ रंनौ</para>
  <para style="r">
    <ref loc="MAT 28:16-20">मत्ती २८:१६-२०</ref>; <ref loc="MRK 16:14-18">मर्कुस १६:१४-१८</ref>; <ref loc="LUK 24:36-49">लूका २४:३६-४९</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />नकाई दिन, अथाबा हप्ताल पहेला दिनल ओईक, जब यहूदीयाङल छ्याहै सिइयाङ झलापयाङ रूफ्स्यु भितरलं चुङज्यावाङ, येशु रा:स्यु नकाङल खार्ल च्याङौ, ओटन नकाङजन ऐआढोवाङ, “जेजन शान्ति!” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />आवाए पानस्यु ओले नकाङजन आकुई सनर कोखा बै आठनस्योवाङ। प्रभुजन रङस्यु सिइयाङ भ्याई हेसाङवाङ। <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />तब येशुले फरि नकाङजन ऐआढोवाङ, “जेजन शान्ति! जोमनलेस्यु बौले ङाजन आपरिङ्ङु, नैलेस्युई ङा बै जेजन परिङच्या।” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />ओटन आवाए पानस्यु येशुले नकाङयर्त सअ मुइस्यु ऐलेऊ, “पबित्र आत्माजन ग्रहन ढोचिते। <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />जो रुयाङल पाप जे छेमा ढोच्यो, नकाङजन छेमा ताहा, ओटन जोल पाप जे छेमा माढोच्यो नका छेमा ताइन्या माल्दी।”<note caller="-" style="x"><char style="xo" closed="false">20:23 </char><char style="xt" closed="false"><ref loc="MAT 16:19">मत्ती १६:१९</ref>; <ref loc="MAT 18:18">१८:१८</ref></char></note><verse eid="JHN 20:23" /></para>
  <para style="s">येशु सनर थोमा</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />येशु आरांऔक बारं गोटाङन तोलोअ, दिदुमस ऐराढान्या थोमा, ओयाङसं मालेऊ। <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />नैताइस्यु अपुर सिइयाङै नकाजन ऐराढोव, “गे प्रभुजन गेरङयिउ।” तर नकाले ओयाङजन ऐआढोवाङ, “जब समन ङा ओलं कुईला खिलल घ्वाङ मारङ्ङ, सनर खिलल घ्वाङल ङाकुईसै माझोकङ, ओटन ओलं कोखाल ङाकुई माझोकङ, तब समन ङा बिस्वास ढान्यामालेङदी।”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />त हप्ता छिन्ट आ सिइयाङ फरि झिम भितरलं लिज्यावाङ। थोमा बै नकाङसं लिज्याऔ। झलापयाङ रूफ्सिज्याऔ, तर येशु भितर पसिऊ, ओटन खार्ल च्याङस्यु ऐलेऊ, “जेजन शान्ति।” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />तब येशुले थोमाजन ऐआढोव, “नकुईसै इल नाएते, ओटन ङाकुईयाङ खिम्ते। नकुई हिनस्यु ङाकोखाल झोअते, तर बिस्वास ढोते तर सङ्का ताढो।” <verse eid="JHN 20:27" /><verse number="28" style="v" sid="JHN 20:28" />थोमाले ओजन ऐआढोव, “ङा प्रभु सनर ङा परमेस्वर!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />येशुले नकाजन ऐआढोव, “नङ ङाजन नरङन्या कारनले ङाजन बिस्वास नढाङनु? बअचान्याङ नकाङ, जोले ङाजन रङस्यु मालरदी, ओटन बै बिस्वास ढाङरा।”<verse eid="JHN 20:29" /></para>
  <para style="s">ईका किटापल उदश्य</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />येशुले अपुर भ्याई अचम्मला कामयाङ आ सिइयाङ हार्मै आढोव, जो ईका किटापल मासरसिज्यादी। <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />तर आका सरसिज्याया, कि नङ येशु परमेस्वरलं ज़ा ख्रीस्ट ज्या, ऐलेस्यु बिस्वास ढोचिते ओटन ओलं मिनता बिस्वासङन ओलं जेजन जिबन ग्याडोएचित्या।<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">येशु साट जना सिइयाङ ल्योङ आरंनन्या</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />नकाल छिन्ट सिइयाङ ल्योङ तिबेरियास समुन्दरल लेऊल येशुले फरि आ सिइयाङ ल्योङ रंनौ। फिरि बै ओलझन्जै ऐलेस्यु आथनौ। <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />सिमोन पत्रुस, दिदुमस ऐढासिन्या थोमा, गालीलला काना सहरला नथानेल, ओटन जब्दियाल नेंलोअ ल्हेपाज़ानें सनर आसिइयाङ्‌ङन अपुर नेंलोअनें बोलोङ लेवाङ। <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />सिमोन पत्रुसले नकाङजन ऐआढोवाङ, “ङा ङा:स्या ङासएनाज्याङु।” सिइयाङै ओलजन ऐराढोव, “गे बै नङसं रांया।” नकाङ हिनस्यु डोङ्गाल चरीवाङ, तर ना रिउ नकाङै नैज माकोलोदुरा।<note caller="-" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="LUK 5:5">लूका ५:५</ref></char></note> <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />छकाल्या ताइङा आलिज्याऔक, येशु आवङल च्याङौ। तर सिइयाङै नका येशु जै ज्या ऐलेस्यु माशईदुरा। <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />येशुले नकाङजन ऐआढोवाङ, “बालअयाङ, जेसकाए ङा:स्या ख्वाए लेऊ?” नकाङै ओजन जबाक रांयोव, “माल्दी।”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />ओले नकाङजन ऐआढोवाङ, “जाल डोङ्गाल दाइन्यादेए होरचिते, ओटन डोएचिरा।” तब नकाङै जाल राहोरौ, ओटन ङा:स्यायाङ वुरले गर्दा नकाङै जाल च्योङौ रांमाढुदुऊ।<note caller="-" style="x"><char style="xo" closed="false">21:6 </char><char style="xt" closed="false"><ref loc="LUK 5:6">लूका ५:६</ref></char></note> <verse eid="JHN 21:6" /><verse number="7" style="v" sid="JHN 21:7" />येशुले मया आढान्या सिइले पत्रुसजन ऐआढोव, “नका ता प्रभुदी रैस।” “नका ता प्रभु रैस” ऐआलन्या थएस्यु सिमोन पत्रुसले आमि बाहेरङन्ता क्वा कम्बरत आमलिङौ, दानाङभन्या नकाले आक्वा फिरस्यु लेऊ, ओटन रील जोकौ। <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />अपुर सिइयाङ डोङ्गालै चुङस्यु ङा:स्या लेन्या जाल च्योङस्यु च्योङस्यु रांज्यावाङ। नकाङ आवङतन लोए मालेरदी, छ्योअ सय मिटर याए त लेवाङ। <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />जब नकाङ आवङल लाइवाङ, तब नकाङै फिलङ्गाल भुबराल ङा:स्या सनर भरेई हिप्सिज्यान्या रांरङौ। <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />येशुले नकाङजन ऐआढोवाङ, “जे भाबाअ जेकोलोअन्या ङा:स्यातन तचियाए होन्चिते।” <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />तब सिमोन पत्रुस डोङ्गाल चरिस्यु तसय तिरपन्न गोटा घिन्या-घिन्या ङा:स्याले फाङताइन्या जाल पाखाल च्योङस्यु आहोनौ, तर आवाए भ्याई लेस्यु बै जाल माचिइदा। <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />येशुले नकाङजन ऐआढोवाङ, “रा:स्यु कैचिते।” सिइयाङ मध्य काङ्काईले बै “नङ काङ्का?” ऐलेस्यु गिनन्या रामाआन्तिदुऊ, दानाङभन्या नकाङै ईका प्रभु ज्या ऐलेस्यु सनस्यु लेवाङ। <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />येशु रांऔ ओटन भरेई हिनस्यु नकाङजन आयोवाङ, ओटन नैलेस्युई ङा:स्या बै आयोवाङ। <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />सिन्यातन जिङदा ताइस्यु आच्याङौ छिन्ट येशु आ सिइयाङ ल्योङ आरंनन्या ईका तिस्रा पाला हो।<verse eid="JHN 21:14" /></para>
  <para style="s">येशु सनर पत्रुस</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />जब नकाङै ङा:स्या सनर भरेई कैस्यु रांखेमौ, तब येशुले सिमोन पत्रुसजन ऐआढोव, “यहुन्नाल ज़ा सिमोन, नैति नङ ङाजन इकाङतन भ्याई प्रेम नढाङनु?” नकाले ओजन ऐआढोव, “औ प्रभु, नङ ऐसन्ना, ङा नङजन प्रेम ऐढाना लेस्यु।” येशुले नकाजन ऐआढोव, “ङा पाठाङजन यांहौरते।” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />येशुले फरि छिन्का पाला नकाजन ऐआढोव, “यहुन्नाल ज़ा सिमोन, नैति नङ ङाजन प्रेम नढाङनु?” नकाले ओजन ऐआढोव, “औ प्रभु, नङ ऐसन्ना, ङा नङजन प्रेम ऐढाना लेस्यु।” ओले नकाजन ऐआढोव, “ङा भेडाङजन ब्याएबिई ढोवरते।” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />येशुले नकाजन तिस्रा पाला ऐआढोव, “यहुन्नाल ज़ा सिमोन, नैति नङ ङाजन प्रेम नढाङनु।” पत्रुसले दुख आमानिउ, दानाङभन्या ओले तिस्रा पाला नकाजन “नैति नङ ङाजन प्रेम नढाङनु?” ऐआढोव। ओटन नकाले ओलजन ऐआढोव, “प्रभु नङ सोगलै छेन ऐसन्ना। ङा नङजन प्रेम ऐढाना ऐलेस्यु नङजन थाहै लेया।” येशुले नकाजन ऐआढोव, “ङा भेडाङजन यांहौरते। <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />मछ्यु, ङा नङजन ऐढाना, जब नङ धापा नल्‌नु नङ नङजै तेरछ्या नपोअनु, ओटन जोदेए नइच्छ्या लागि ओदेए नहिन्नु। तर जब नङ सेरन, तब नङ नकुई पसारन्या लेना, ओटन अपुऱ्याङै नतेरछ्या पोअस्यान्या लेरा, ओटन नङ जोङ हिनहिन माङप्सिन नङ लाङसिना।” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />कैताइन्या किसिमला सिइकालङन नकाले परमेस्वरलं महिमा ढान्यालेऊ, नका सङ्केट ढास्यु ओले ईका आपानौ। आवाए पानस्यु येशुले पत्रुसजन ऐआढोव, “ङा छिन्ट लागिन्ते।”<verse eid="JHN 21:19" /></para>
  <para style="s">येशु सनर छुट्टै आ सिइ</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />पत्रुसले छिन्देए वलस्यु आब्याटौक येशुले प्रेम आढान्या सिइ छिनछिन आरांज्यान्या आरङौ। इकाले जै ओईका ज्यान्या बेलाल ओलं छातिउल घेएसिस्यु, “प्रभु नङजन कोलोकौ परिङन्या काङ्का?” ऐलेस्यु गिन्स्युलेऊ।<note caller="-" style="x"><char style="xo" closed="false">21:20 </char><char style="xt" closed="false"><ref loc="JHN 13:25">यहुन्ना १३:२५</ref></char></note> <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />नकाजन रङस्यु पत्रुसले येशुजन ऐआढोव, “प्रभु इकाजन कै ताहौ होला?” <verse eid="JHN 21:21" /><verse number="22" style="v" sid="JHN 21:22" />येशुले पत्रुसजन ऐआढोव, “ङा ङामाराऔ समन नकाले ग्यावुइज्यात्या, ऐलेन्या ङा इच्छ्या लेकन बै नङजन नैति कैताहौका? नङ ङा छिन्ट लागिन्ते।” <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />नैताइस्यु ना सिइ मासिदी ऐलेन्या छेन बिस्वासी भाईयाङ खार्ल फैलिऊ। येशुले नका मासिदी ऐढास्यु मालेऊ, तर “ङा ङामाराऔ समन नकाले ग्यावुइज्यात्या ऐलेन्या ङा इच्छ्या लेकन बै नङजन नैति?” ऐढास्यु लेऊ। <verse eid="JHN 21:23" /><verse number="24" style="v" sid="JHN 21:24" />आका नाइज सिइ ज्या, जोले ईका छेनल बारेल बयन योंवरा, ओटन ईका छेन सरस्यु नाएवा, ओटन गे ऐसन्या कि नकाल गवाइ सत्य लेया।<verse eid="JHN 21:24" /></para>
  <para style="s">आसाप</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />येशुले अपुर बै तबर काम आढोव, नकाङ मध्य सोगलैल बारेङन सरन्या ताहकन, ङाजन ऐटाइन्या लागिया कि, नकाल बारेल सरसिन्या किटापयाङ सङ्सारभरि बै सुनन्या माल्दी।<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>