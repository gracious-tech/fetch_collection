<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Sheshi Kham</book>
  <para style="h">मर्कुसं</para>
  <para style="toc1">मर्कुसले आसरन्या चान्याथाई</para>
  <para style="toc2">मर्कुसं</para>
  <para style="toc3">मर्कुसं</para>
  <para style="mt1">मर्कुसले लेखेको चान्याथाई</para>
  <para style="mt2">मर्कुसले आसरन्या चान्याथाई</para>
  <para style="imt">किटाप शईन्या</para>
  <para style="ip">मर्कुसले आसरन्या छार नियामला चार गोटा किटापङन आका तोलोअ हो, जोले येशु ख्रीस्टल जिबनजन बर्नन ढोवा। नकाङ सोगलैजन “चान्याथाई ऐढासिया, जोल अर्थ छार छेन हो, नकाङ मत्ती, मर्कुसं, लूका, सनर यहुन्नाङन येशु आसिऊ छिन्ट रा:सरन्या हो।” मर्कुसं अनुसार चारगोटा चान्याथाईतन मर्कुसलं किटाप सोगलैतन तुनन्या लेया। ईका बै ख्रीस्ट आजर्मिऊ छिन्ट ५५/६५ ल खार्ल सोगलै चान्याथाईयाङ तन हादेए सरसिन्या मानिसिया। तबर बिद्वानयाङै बिस्वास ढोरा कि ईका रोमला रोमन इसाईयाङजन प्रोत्साहनलं नाल्ट आसरन्या हो। मर्कुसजन यहुन्ना मर्कुसं बै ऐढास्यु शईसिया। ओलं बारनाबासलं नेराका सनर प्रेरित पावलनेजन व्एन्या रु हो, तर नकाले डुलिङा लेस्यु आन्तिन्या राइवापाइनाई आप्रतिस्ठात चोएपरिस्यु लेऊ, <char style="xt"><ref loc="ACT 13:13">प्रेरित १३:१३</ref></char> छिन्ट मर्कुसं बारनाबास सकाए फरि दुलिऊ <char style="xt"><ref loc="ACT 15:37-39">प्रेरित १५:३७-३९</ref></char> मर्कुसं पत्रुसलं बअमिलिन्या न्हाएल दर्जात बै मान्यता यांसिन्या लेया मर्कुसले येशुल जिबनल नेराकन आमारङौ। शास्त्रत बिद्वानयाङै बिस्वास ढोरा कि मर्कुसले पत्रुसलं तबर गवाइ सरन्या आढोव ओटन मर्कुसलं अनुसार चान्याथाईल आधार ज्या। चान्याथाई मर्कुसले छिन्ङा बेलाल सिइमन सनर येशुल सिक्छ्यालै आढ्यान लेऊ।</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">मर्कुसले दुख सनर कस्टल थाह योंवा। अध्याय <char style="ior"><ref loc="MRK 1:1-13">१:१-१३</ref> </char></para>
  <para style="io1">नालं छिन्ट मर्कुसले येशु गालीललं आलिज्याऔक ओलं आसेवाला कामल चर्चा ढोवा, अध्याय <char style="ior"><ref loc="MRK 1:14-8:21">१:१४—८:२१</ref> </char></para>
  <para style="io1">नकाल छिन्ट मर्कुसले येशु यरुशलेमल आबारिन्या बारेल पान्वा। अध्याय <char style="ior"><ref loc="MRK 8:22">८:२२</ref>; <ref loc="MRK 10:52">१०:५२</ref> </char></para>
  <para style="io1">मर्कुसले येशु आसिन्या सनर फरि आबान्चिन्या समन यरुशलेम सहरल येशुल पालाका बारेङन सरसिऊ नाएवा। अध्याय <char style="ior"><ref loc="MRK 11:1">११:१</ref>; <ref loc="MRK 16:8">१६:८</ref> </char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">बप्तिस्मा यांन्या यहुन्नाले यम तयार जाएवा,</para>
  <para style="r">
    <ref loc="MAT 3:1-12">मत्ती ३:१-१२</ref>; <ref loc="LUK 3:1-18">लूका ३:१-१८</ref>; <ref loc="JHN 1:19-28">यहुन्ना १:१९-२८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />परमेस्वरलं ज़ा येशु ख्रीस्टल चान्याथाईल, सुरुवाट। <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />यशैया अगमबक्ताल किटापल ऐटाइन्या सरसिन्या लेऊ, “थएचिते, ङा ङामि स्वर्गदुतजन जेहाजेहा परिङ्ङा, नाले जेयम तयार जाएवा।”<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">मलाकी ३:१</ref></char></note> <verse eid="MRK 1:2" /><verse number="3" style="v" sid="MRK 1:3" />“हरहर ताइन्या पोल तोलोअ कलिऊन्याल ग़ा, ‘परमप्रभुल यम तयार जाएचिते, ओलं यमयाङ सोझा जाएचिते।’”<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यशैया ४०:३</ref></char></note><verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />ओटन रुयाङजन प्रचार ढाऔयन यहुन्नाले ऐआढोवाङ, पाप छेमाल नाल्ट पस्चातापल बप्तिस्मा होन्चिते। <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />सोगल यहूदिया प्रदेस सनर यरुशलेम सहरला सोगल रुयाङ यहुन्ना ल्योङ रांवाङ। नकाङै राढान्या पापल नाल्ट पस्चाताप रांढोव ओटन यहुन्ना ल्योङन यर्दन भईल<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">यर्दन भईल पछिम एशियाल म्रित सागरल बगिज्यान्या २५१ किलोमिटर (१५६ मायिल) ल्होन्या भई हो।</char></note> बप्तिस्मा राहोनौ।<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />यहुन्नाले ऊटल भूत्लाल रअसिन्या क्वा क्वाएसिस्यु लेऊ, ओटन आकम्बरल छालाल पिटी पोअवा। नाले सोलो कोस्योअ सनर बनमह ज्योवा।<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">२राजा १:८</ref>; <ref loc="MAT 3:4">मत्ती ३:४</ref></char></note> <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />यहुन्नाले ऐलेस्यु रुयाङ ल्योङ प्रचार आढोव, “जो ङाछिन्ट तोलोअ रु रांन्या लेया, ओ ङातन सक्तिशाली लेया। ङा गोम लेस्यु ओलं जुताल तना पलाअन्या लायकला मालेङदी। <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />ङा ता जेजन रीले बप्तिस्मा यांच्या, तर ओलेता जेजन पबित्र आत्माले बप्तिस्मा यांचिवा।”<verse eid="MRK 1:8" /></para>
  <para style="s">येशुल बप्तिस्मा सनर आअल्चिन्या</para>
  <para style="r">
    <ref loc="MAT 3:13">मत्ती ३:१३</ref>; <ref loc="MAT 4:1-11">४:१-११</ref>; <ref loc="LUK 3:21-22">लूका ३:२१-२२</ref>; <ref loc="LUK 4:1-13">४:१-१३</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />तचिइ दिन छिन्ट येशु गालील प्रदेसला नासरतङन रांऔ। ओटन यहुन्ना ल्योङन यर्दन भईल बप्तिस्मा आहोनौ। <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />जब येशु रीलन बाहेर पलिहौ, तब ओचोएटै स्वर्ग आफएसिन्या सनर पबित्र आत्माजन कचिकुरल अनवारमन आयर्त आलाइरांन्या आरङौ। <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />नमतन ऐलेन्या ग़ा थहौ, “नङ ङा निज्युन्या ज़ा हो, नङसं ङा भ्याई हेसाङस्यु लेङा।”<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">उत्पत्ति २२:२</ref>; <ref loc="PSA 2:7">भजनसङ्ग्रह २:७</ref>; <ref loc="ISA 42:1">यशैया ४२:१</ref>; <ref loc="MAT 3:17">मत्ती ३:१७</ref>; <ref loc="MRK 9:7">मर्कुस ९:७</ref>; <ref loc="LUK 3:22">लूका ३:२२</ref></char></note><verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />तब पबित्र आत्माले येशुजन ओचोएटै हरहर ताइन्या पोल आलाङौ। <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />ओङ येशु चालिस दिन समन लिज्याऔ, सैतानले येशुजन परिक्छ्या ढाज्याऔ, ओटन ओलं बनला जनावरयाङसं लिज्याऔ, ओटन स्वर्गदुतयाङै आसेवा रांढोव।<verse eid="MRK 1:13" /></para>
  <para style="s">येशुले चार गोटा जलाहारीयाङजन आखुल्वाङ</para>
  <para style="r">
    <ref loc="MAT 4:12-22">मत्ती ४:१२-२२</ref>; <ref loc="LUK 4:14-15">लूका ४:१४-१५</ref>; <ref loc="LUK 5:1-11">५:१-११</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />यहुन्ना कोलोअसिया पाइनाई येशुले गालील प्रदेसलं रा:स्यु, परमेस्वरलं चान्याथाई प्रचार आढोव। <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />ओले ऐलेऊ कि “समाय पुरा ताइस्यु लेया, परमेस्वरलं राज्य नेराक ताप‌रादा<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">परमेस्वरलं राज्यला चान्याथाई प्रचार ढान्या सनर ओलं राज्यल थनन्या नाल्ट छेलन्या समाय रा:स्यु लेया। </char></note>, पस्चाताप ढोचिते ओटन चान्याथाईल बिस्वास ढोचिते।”<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">मत्ती ३:२</ref></char></note><verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />येशु गालील प्रदेसला समुन्दरल<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">गालीलला ईका समुन्दर इस्राएललं उत्तर-पुर्बङन यर्दन हाल चिराल लेया।</char></note> आवङवङ ताइस्यु आहिनज्याऔक, ओले सिमोन सनर आभाई अन्द्रियासजन समुन्दरल जाल नेंहोरज्यान्या आरङौने, दानाङभन्या नकाने जलाहारी लेऊने। <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />येशुले नकानेजन ऐआढोवने “ङाछिन्ट राचिन्ते, ङा झेनजन परमेस्वरलं राज्यल रुयाङजन कढाई होनन्या ना ह्युउचिना।” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />नानेले ओचोएटै नें जालजन राइस्यु, येशुल छिन्ट लागिऊने। <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />ओटन तचिइ हुदिन्देए रांहिनौक, येशुले जब्दियाल आज़ाने याकूब सनर यहुन्नाजन डोङ्गाल चुङस्यु जाल नेंपएज्यान्या आरङौने। <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />येशुले ओचोएटै आखुलौने ओटन नकानेले नेंबौ जब्दियाजन ध्यारी ढान्याङसं डोङ्गाल बनाएस्यु ओलं छिन्ट लागिऊने।<verse eid="MRK 1:20" /></para>
  <para style="s">दुस्टआत्माले भरिसिन्या रु,</para>
  <para style="r">
    <ref loc="LUK 4:32-37">लूका ४:३२-३७</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />येशु सनर आ सिइयाङ कफर्नहुम सहरल रांवाङ, ओटन शबाथ दिनल तयोअका छिम्क यहूदीयाङ आराधना झिमल<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">सिनागोग=यहूदीयाङ दुउसिन्या झिम</char></note> हिनस्यु ओचोएटै ओले सिक्छ्या यांऔ तअसिऊ। <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />जो जोले ओलं सिक्छ्या राथटौ नकाङ अचम्म ताइवाङ, दानाङभन्या ओले नकाङजन शास्त्रीयाङमन माङडी तर अढिकार डोटौ जोरसं आह्युउवाङ।<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">मत्ती ७:२८-२९</ref></char></note><verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />नकाए बेला नका यहूदीयाङ आराधना झिमल तोलोअ रु लेऊ, जोल्योङ दुस्टआत्मा लेऊ, ओटन ओ भ्याई जोर जोरसै चिचच्याइज्याऔ। <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“औ नासरतला येशु, गे ङन नै नचाहिनु? नैति नङ गेजन नस्ट नजाएरानु? ङा नङजन ऐशईना, नङ परमेस्वरलं पबित्र रु ज्या।”<note caller="-" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="PSA 16:10">भजनसङ्ग्रह १६:१०</ref>; <ref loc="ISA 41:14-16">यशैया ४१:१४-१६</ref>; <ref loc="ISA 20">२०</ref>; <ref loc="ACT 3:14">प्रेरित ३:१४</ref></char></note><verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />येशुले नाजन ऐलेस्यु आसज्याकौ, “छपक्कै दिङन्ते, ओटन नका ल्योङन बाहेर देए पलिहन्ते।” <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />नका रुजन लछार पछार जाएस्यु ना दुस्टआत्मा चोएसै कलिऊस्यु नका रु ल्योङन पलिईस्यु हिनौ।<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />ओटन सोगल अचम्म रामानिऊ कि नकाङ ऐलेस्यु रारां छ्योङौ तअसिवाङ, “इकाता छार सिक्छ्या दी रैस। इकाले ता घिन्या अढिकार सकाए दुस्टआत्माङजन आग्या दी योंवर, ओटन नकाङै इकाल आग्या मानिरा रैस।” <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />तब ओचोएटै येशुल मिन गालीलला हुङआङा सोगलै पोल फैलिऊ।<verse eid="MRK 1:28" /></para>
  <para style="s">येशुले तबर रुयाङजन आसबेल्वाङ</para>
  <para style="r">
    <ref loc="MAT 8:14-17">मत्ती ८:१४-१७</ref>; <ref loc="LUK 4:38-41">लूका ४:३८-४१</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />येशु सनर आ सिइयाङ ओचोएटै आराधना झिमलन पलिईस्यु याकूब सनर यहुन्नासकाए सिमोन सनर अन्द्रियासलं झिमल रांवाङ। <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />सिमोनल माइज्यू आनाएबोरले थलिस्यु रुउज्याऔ, ओटन नाल बारेल ओचोएटै येशुजन रापानस्यौ। <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />ओटन येशु नकाल नेराक रा:स्यु जब नकाल आकुई कोलोअस्यु नकाजन आसचोटौ, तब ना नाएबोरतन बेलौ, ओटन नकाले येशुल सेवा ढाऔ तअसिऊ।<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />ओईका बेला जब नम्युउ बुदिउ, रुयाङै सोगलै नाएबोरन्याङ ओटन ओयाङ जो जोल दुस्टआत्मा लागिन्याङजन येशु ल्योङ राहोन्वाङ। <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />ओटन सोगल बजारला रुयाङ, झिमल मासुनस्यु झलाप वङ समन लेवाङ। <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />नकाङै दुस्टआत्माङन भ्याई दुख डोएज्यावाङ, ओटन तबर किसिमला नाएबोरन्याङजन येशुले आसबेल्वाङ, नैताइस्यु दुस्टआत्माङजन छ्योङौ आमायोवाङ, दानाङभन्या ओलजन नकाङै शईस्युलेवाङ।<verse eid="MRK 1:34" /></para>
  <para style="s">गालीलल येशुल प्रचार</para>
  <para style="r">
    <ref loc="LUK 4:42-44">लूका ४:४२-४४</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />छकाल्या “नम आमारनौ हादेए सोस्यु येशु आबाठएक पोल हिनौ, ओटन ओङ प्रार्थना ढाऔ तअसिऊ। <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />तर सिमोन सनर आन्हाएयाङ येशुजन रोअन्या लेस्यु बाहेर पलिइवाङ। <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />ओटन जब येशुजन रांडोटौ, तब नकाङै ऐराढोव, सोगलैले नङजन रोअज्यारा।”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />तब येशुले नकाङजन ऐआढोवाङ, “रांचिते गे नेराजिऊला नङ्गरल हिन्‌या, ओटन नङं बै ङा प्रचार ढोङा, दानाङभन्या ङा इकाल नाल्टै ङारांङु हो।” <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />ओटन गालीलला सोगल आराधना झिमल हिनस्यु प्रचार आढोव ओटन दुस्टआत्माङजन पलिईस्यु येशु नलन हिनौ।<note caller="-" style="x"><char style="xo" closed="false">1:39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">मत्ती ४:२३</ref>; <ref loc="MAT 9:35">९:३५</ref> </char></note><verse eid="MRK 1:39" /></para>
  <para style="s">येशुले तोलोअ कुरीजन आसबेलन्या</para>
  <para style="r">
    <ref loc="MAT 8:1-4">मत्ती ८:१-४</ref>; <ref loc="LUK 5:12-16">लूका ५:१२-१६</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />ओटन तोलोअ कुरी येशु ल्योङ रांऔ, ओटन ओलं सामन्दी घुन्डा टिकिस्यु बिन्ति आढोव “नङ इच्छ्या ढोनकन ङाजन सबेलौ ढुदुना।”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />येशुले दया मानिस्यु कुई आपारिउ ओटन नकाजन छुस्यु ऐआढोव, “ङा ऐढाना नङ बेलन्ते।” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />नवाए बेलाईज नाल कोर बेलौ, ओटन ना बेल्दा। <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />तब येशुले नाजन कडा आग्या यांस्यु ओचोएटै आपरिङौ, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />ओटन नाजन ऐआढोव, “खिम्ते, नङ काङ्काईजन तापानस्यौर, तर नङजै हिनस्यु पुजाउरो ल्योङ थनसिन्ते, ओटन नङ नबेलन्या रुयाङल प्रमानल नाल्ट मोशाले आपानन्या अनुसार भिटी चराइते, जो रुयाङल नाल्ट साची ग्याताइत्या।”<note caller="-" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">लेवी १४:१-३२</ref></char></note> <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />तर नकाले बाहेर रा:स्यु खुलमखुल्ला प्रचार ढाऔ तअसिऊ, ओटन येशु फरि खुलमखुल्ला बजारल थनसिस्यु हिनौ माढुदुडा, तर आबाठए पोल लिज्याऔ। ओटन रुयाङ चारवरङन आल्योङ दुउसिवाङ।<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">येशुले तोलोअ लुलाजन आसबेलन्या</para>
  <para style="r">
    <ref loc="MAT 9:1-8">मत्ती ९:१-८</ref>; <ref loc="LUK 5:17-26">लूका ५:१७-२६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />तचिइ दिन छिन्ट येशु फरि कफर्नहुम वलस्यु रांऔ, ओटन रुयाङ ऐटाइन्या राथटौ कि नका झिमलै लिज्याया। <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />ओटन आवाए भ्याई रुयाङ दुउसिवाङ कि, नका रुयाङ ना झिमल चुङन्या पो बै माताइदा, ऐताइस्यु ना रुयाङ झलापल वङ समन लेवाङ, ओटन येशुले नकाङजन परमेस्वरलं बचन आसथएवाङ। <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />ओटन चार गोटाले रावुरन्या तोलोअ लुला रोगिजन येशुल लेऊक राहोनौ। <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />तर जब ना रुयाङल हुलले गर्दा येशुल नेराक हिनौ रांमाढुदुऊ, नैताइस्यु नकाङै नाझिमल छाना येशुल सोझा फलाअतन खुलिस्यु, ओलन्जै लुला रोगिजन आचारपाई सकाएज वान्ल रांल्हाटौ। <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />येशुले नकाङल बिस्वास रङस्यु नका लुला रोगिजन ऐआढोव, “ऐ, ज़ा नपाप छेमा ताइदा।” <verse eid="MRK 2:5" /><verse number="6" style="v" sid="MRK 2:6" />तर नङं ख्वाएयाए शास्त्रीयाङ चुङज्यावाङ, ओटन नकाङ रायिङल ऐटाइन्या यिङज्यावाङ, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“ईका रु दानाङ ऐलेस्यु छ्योङ? ईका ता ईस्वरलं बिरोद ढाज्याऔदी, सिरिप तोलोअ परमेस्वरले बाहेक अपुर काङ्का रुले पाप छेमा ढाऔ आढुदुऊ?”<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ISA 43:25">यशैया ४३:२५</ref></char></note><verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />ओटन नकाङ रारांल ऐलेस्यु बिचार ढाज्यावाङ, ऐलेन्या येशुल आत्माले ओचोएटै आसनौ ओटन नकाङजन ऐआढोवाङ, “दानाङ जे जेयिङलन ऐटाइन्या बिचार ढाज्याच्यो? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />लुला रोगिजन ‘नपाप छेमा ताइदा’ ऐढोङ सन्, ‘सोन्ते, नमी चारपाई छेन्स्यु बान्ते’ ऐढोङ, काङ्का सजिलो लेऊ? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />ङा जेजन प्रमान यांच्या, तर रुल ज़ाजन पिरथ्बील पाप छेमा ढान्या अढिकार लेया, लेस्यु जे सन्चिते।” तब येशुले ना लुला रोगिजन ऐआढोव, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“ङा नङजन ऐढाना, सोन्ते नमी चारपाई छेन्ते, ओटन नझिम देए हिनन्ते।” <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />ना सोव, ओटन ओचोएटै चारपाई छेन्स्यु सोगलै सामन्दी हिनौ। आवाए समन कि, सोगलै अचम्म ताइस्यु, ऐलेऊ तअसिवाङ, कि “गे ऐटाइन्या ता खकै मारङैदी” ऐलेस्यु नकाङै परमेस्वरलं महिमा रांढोव।<verse eid="MRK 2:12" /></para>
  <para style="s">येशुले लेबीजन आखुलन्या</para>
  <para style="r">
    <ref loc="MAT 9:9-13">मत्ती ९:९-१३</ref>; <ref loc="LUK 5:27-32">लूका ५:२७-३२</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />येशु फरि तपाला गालीलला समुन्दर वङल हिनौ। ओटन रुयाङल तोलोअ घिन्या हुल आल्योङ रांवाङ, ओटन येशुले नकाङजन छार सिक्छ्या यांऔ तअसिऊ। <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />नालछिन्ट आहिनज्याऔक येशुले अल्फयसलं ज़ा लेबीजन तिरो उठाइन्या अड्डाल आचुङज्यान्या आरङौ, ओटन नकाजन ऐआढोव, “ङाछिन्ट लागिन्ते।” नका च्याङस्यु येशुल छिन्ट बाऔ।<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />येशु लेबील<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">लेबी=मत्ती</char></note> झिमल ज्यान्या ज्योङा लेस्यु चुङौ, ओटन भ्याई तिरो उठाइन्या भ्याईयाङ सनर पापीयाङ बै येशु सनर आ सिइयाङ सकाए ज्योङा लेस्यु चुङवाङ, तर नकाङ भ्याई लेवाङ, ओटन येशुल छिनछिन रा:स्यु लेवाङ। <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />शास्त्रीयाङ सनर फरिसीयाङै येशुजन पापीयाङ सनर तिरो उठाइन्याङ सकाए आज्याज्यान्या रांरङौ, ओटन नकाङै सिइयाङजन ऐराढोव, “दानाङ कर उठाइन्याङ सनर पापीयाङ सकाए चुङस्यु ज्योज्याऔज्या?” <verse eid="MRK 2:16" /><verse number="17" style="v" sid="MRK 2:17" />ईका थएस्यु येशुले नकाङजन ऐआढोवाङ, “नाएमाबोरन्याङजन गुनील आबस्यक माल्दी, तर रोगियाङजन याएज लेया। ङा सोझाङजन माङडी तर पापीयाङजन ङाखुलराङु।”<verse eid="MRK 2:17" /></para>
  <para style="s">बर्तल बारे रांगिनन्या</para>
  <para style="r">
    <ref loc="MAT 9:14-17">मत्ती ९:१४-१७</ref>; <ref loc="LUK 5:33-39">लूका ५:३३-३९</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />यहुन्नाल सिइयाङ सनर फरिसीयाङ बर्त चुङरा अथाबा रुयाङै रा:स्यु येशुजन रांगिनौ, “यहुन्नाल सिइयाङ सनर फरिसीयाङ बर्त चुङरा, तर न सिइयाङ दानाङ बर्त माचुङर?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />येशुले नकाङजन ऐआढोवाङ, “नैति जब ब्याहा ताह दुलाहा नकाङसं कोठाल आलिज्याऔ समन दुलाहाल जन्तियाङ बर्त चुङवाङ का? ज्वाए बेला समन दुलाहा रा:सं बोलोङ लिज्या, तब समन नकाङ बर्त माचुङरडी। <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />तर ना बेला रांया, जब दुलाहाजन नकाङ्ङन बाठए ताह, तब नका बेला नकाङ बर्त चुङरा।”<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />काङ्काङै पुरानो क्वाल छार टाला माझोअरदी, मानकन्ता पएसिन्या क्वा झन चिहा, अथाबा छार पुरानोतन भ्याई चिहा, ओटन माचान्या रंना। <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />ओटन छार अङ्गुरल रसजन पुरानो छालाल मशकलं माझोअरदी, मानकन्ता अङ्गुरल रसले मशकजन पाअवा, ओटन अङ्गुर रस सनर मशक नेंलोअजै नस्ट ताइन्या, तर छार अङ्गुर रस छार मशकलैज झोअसिया।<verse eid="MRK 2:22" /></para>
  <para style="s">शबाथ-दिनल बारे रांगिनन्या</para>
  <para style="r">
    <ref loc="MAT 12:1-14">मत्ती १२:१-१४</ref>; <ref loc="LUK 6:1-11">लूका ६:१-११</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />येशु शबाथ छिम्क अन लेन्या खेएलन आसिइयाङसं हिनज्यावाङ, ओटन रांबाज्याऔ बाज्याऔकै सिइयाङै अनल बाला चिटौ तअसिवाङ।<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 12:1-8">१२:१-८</ref>; <ref loc="LUK 6:1-5">लूका ६:१-५</ref></char></note> <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />ईका रङस्यु फरिसीयाङै येशुजन ऐराढोव, “ब्याएते न सिइयाङ शबाथ-छिम्क ईका ब्यबस्थालं बिरोदत ऐटाइन्या काम दानाङ धोर? कि जो ठिक माले।”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />येशुले नकाङजन आढोवाङ “जब दाऊद सनर ओलसं लिज्यान्याङ ज्यान्या मालस्यु करेवाङ, ओटन। तब दाऊदले नै आढोव? नैति जे खकैज जेमापरीचिऊ?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">१शमूयल २१:१-६</ref></char></note> <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />मुख्या पुजाउरो अबियाथारल पालाल दाऊद परमेस्वरलं आराधना झिमल हिनौ, ओटन परमेस्वरजन चराइसिन्या भरेई आकयौ, ओटन दाऊदले सोगल आन्हाएयाङजन बै आयोवाङ, जो पुजाउरोयाङ बाहेक ब्यबस्थाला नियाम अनुसार अपुऱ्याङ कैन्या माताइदी”<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">लेवी २४:९</ref></char></note> <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />ओटन नकाङजन ऐआढोवाङ, “शबाथ-छिम्क भलाईल नाल्ट ताहौ, रु नानसिन्या दिनल नाल्ट माङडी। <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />नैताइस्यु रुल ज़ा शबाथ दिनल बै प्रभु ज्या।”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">येशुले आकुई राङन्या रुजन आसबेलौ</para>
  <para style="r">
    <ref loc="MAT 12:9-14">मत्ती १२:९-१४</ref>; <ref loc="LUK 6:6-11">लूका ६:६-११</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />फरि येशु आराधना झिमल हिनौ। नल आकुई राङन्या तोलोअ रु लेऊ। <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />किगर्दाङ शबाथ-छिम्क येशुले नाजन आसबेलौ सन् आमासबेलौ लेस्यु, येशुजन दोस लाहौ नाल्ट रुयाङ काङ्काङ आचेवाल लिज्यावाङ। <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />तब ओले आकुई राङन्या वाला रुजन ऐआढोव, “रुयाङ खार्ल च्याङनते।” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />ओले नकाङजन ऐआढोवाङ, ब्यबस्थाला नियाम अनुसार “शबाथ-छिम्क भलाई ढान्या ठिक लेऊसन? माचान्या ढान्या, परान जोगाइन्या सन् नास जाएन्या?” नै ठिक लेऊ? तर नकाङ छपक्कै दिङवाङ।<verse eid="MRK 3:4" /></para>
  <para style="r">
    <ref loc="LUK 14:3">लूका १४:३</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />नकाङ यिङला कठोरताले गर्दा दुख मानिस्यु नकाङजन आयिङ चोस्यु चारवर आखिमौ, ओटन नका रुजन ऐआढोव, “न कुई पसारते” नकाले आकुई आपसारिऊ ओटन नाल कुई बेल्दा। <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />तब फरिसीयाङ आराधना झिमलन पलिईस्यु पाखाल हिन्वाङ, ओटन येशुजन सटौ नाल्ट ओचोएटै हेरोदीयाङ सकाए सल्ला ढाऔ तअसिवाङ।<verse eid="MRK 3:6" /></para>
  <para style="s">(समुन्दर वङल रुयाङल हुल)</para>
  <para style="r">
    <ref loc="MAT 12:1-16">मत्ती १२:१-१६</ref>; <ref loc="LUK 6:10-19">लूका ६:१०-१९</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />नाल छिन्ट येशु आ सिइयाङ सकाए समुन्दर वङल हिन्वाङ, गालील प्रदेस सनर यहूदाला पोलन, रुयाङल घिन्या हुल येशुल छिन्ट लागिवाङ। <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />यरुशलेम सहरङन, इदुमिआला, यर्दन भईल पुर्बङन टुरोस सनर सीदोनल नावङला पोलन सोगल रुयाङल घिन्या हुल येशु ल्योङ रांवाङ, ओटन नकाङै थएस्यु रांनाटौ कि नाले अचम्मला काम ढाज्याऔ। <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />हुलले ङाजन तामिचिङरत्या ऐलेस्यु येशुले आ सिइयाङजन आ नाल्ट तोलोअ इङन्या डोङ्गा तयार जाटौ आपरिङवाङ।<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MRK 4:1">मर्कुस ४:१</ref>; <ref loc="LUK 5:1-3">लूका ५:१-३</ref></char></note> <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />येशुले तबर रुयाङजन आसबेलौकाले, रोगियाङ सोगलैले ओलजन छुङा लेस्यु रांहिनौक थुईसिवाङ। <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />जब दुस्टआत्मायाङै ओलजन रङर, तब आहाक गोम लेस्यु ऐलेस्यु कलिऊरा, “कि नङ परमेस्वरलं ज़ा ज्या।”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />तर येशुले दुस्टआत्माङजन कडा चेताउनी आयोवाङ, कि ङा काङ्का ऐलेस्यु तापानच्यो।<verse eid="MRK 3:12" /></para>
  <para style="s">येशुले आछेलन्या बारंगोटा सिइयाङ</para>
  <para style="r">
    <ref loc="MAT 10:1-4">मत्ती १०:१-४</ref>; <ref loc="LUK 6:12-16">लूका ६:१२-१६</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />नकाल छिन्ट येशु डान्डाल वूमौ, ओटन येशुले आचाहिन्या भरिजन आखुल्वाङ, ओटन नकाङ येशु ल्योङ रांवाङ। <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />ओटन येशुले बारं सिइयाङजन आछेल्वाङ, ओटन नकाङजन प्रेरित मिन आनाएस्योवाङ, ओटन नकाङजन आढोवाङ, जे ङासै लिज्यान्याल नाल्ट सनर ङा जेजन परमेस्वरलं चान्याथाई प्रचार ढाऔ नाल्ट ङाछेल्चिऊ, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />ओटन नकाङजन दुस्टआत्माङजन पलिईन्या “अढिकार बै आयोवाङ।” <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />नका बारं प्रेरितयाङ इकाङ हो सिमोन, जोल मिन येशुले पत्रुस आनाटौ। <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />जब्दियाल ज़ा याकूब सनर याकूबल भाई यहुन्ना। ओले नकानेलोअजन बोअनर्गेश अथाबा “गर्जनल ज़ानें” ओमनलेन्या मिन आयोवने। <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />अन्द्रियास, फिलिप, बारथोलोमाइ, मत्ती, थोमा, अल्फयसलं आज़ा याकूब, सनर थेदियस, सिमोन कनानी, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />ओटन यहूदा इस्करियोत जोले येशुजन धोखा यांस्यु कोलोकौ आपरिङौ।<verse eid="MRK 3:19" /></para>
  <para style="s">येशु सनर बालजिबुल</para>
  <para style="r">
    <ref loc="MAT 12:22-32">मत्ती १२:२२-३२</ref>; <ref loc="LUK 11:14-22">लूका ११:१४-२२</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />तब येशु फरि झिमदेए हिनौ। नल फरि तपाला आवाए घिन्या रुयाङ हुल दुउसिवाङ, कि येशुले ज्यान्या ज्यावनाम बै माडोएदा। <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />जब येशुल जाहानयाङै ईका राथटौ तब ओलजन लाङन्या लेस्युकने नकाङ झिमलन पलिइवाङ, दानाङभन्या रुयाङै येशुल यिङ आथअल माल्दी ऐलेवाङ। <verse eid="MRK 3:21" /><verse number="22" style="v" sid="MRK 3:22" />ब्यबस्थाला ख्वाएयाए शास्त्रीयाङ जो यरुशलेम सहरङन रा:स्यु लेवाङ, नकाङै ऐलेवाङ, “नकात बालजिबुल भूत लेया, ओटन भूतयाङल खसमलं बलले ज भूतयाङजन पलिटौरा।”<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 9:34">मत्ती ९:३४</ref>; <ref loc="MAT 10:25">१०:२५</ref></char></note> <verse eid="MRK 3:22" /><verse number="23" style="v" sid="MRK 3:23" />तर नकाङजन आल्योङ खुल्स्यु आहानङन छ्योङौ तअसिऊ, “सैतानले कैलेस्यु सैतानजन पलिटौ ढुदुऊ?” <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />यदि काङ्का राज्ययाङ रारां बिरोद ढास्यु च्याङदुरा भन्या नका राज्यले कैलेस्यु बोलोङ लिज्याऔ ढुदुऊका। <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />ओटन यदि काङ्का झिमल बै रारांल मामिलिरकन नका झिमल बै तनस्यु लिज्याऔ माढुदुरदी। <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />ओटन यदि सैतानले सैतानले बिरोदत च्याङस्यु मामिलिरकन ओयाङ बै टनौ माढुदुरदी, तर नकाङ बाठए-बाठए ताइस्युई मांरा।<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />जो कोबाअले बलल्या रुल झिमल पसिस्यु नकाल धनसम्पत लुटिऊ माढुदुऊदी। नैताइस्यु जब समन नाले पहेला नकाले नका बलल्याजन मापोकौ। तब समन नाले झिम लुटिऊ माढुदुऊदी।<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“ङा जेजन मछ्यु ऐढाच्या, सोगलै रुयाङल पाप सनर ईस्वर बिरोदल छेमा ढान्यालेसिया, <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />तर पबित्र आत्माल बिरोदत यदि बाए ढोच्योकन ना खकै बै छेमा ढान्यामाल्सिदी। मानकन्ता नका अनन्त पापल अपरादि ठहराइसिया।”<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">लूका १२:१०</ref></char></note> <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />येशुले ईका बचन ऐलेस्यु छ्योङौ, ओटन ना शास्त्रीयाङै “नका ल्योङ अशुद्दआत्मा लेऊ” ऐलेस्यु नकाङै ऐलेवाङ।<verse eid="MRK 3:30" /></para>
  <para style="s">येशुल आअमा सनर आभाईयाङ</para>
  <para style="r">
    <ref loc="MAT 12:46-50">मत्ती १२:४६-५०</ref>; <ref loc="LUK 8:19-21">लूका ८:१९-२१</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />तब येशुल आअमा सनर आभाईयाङ नल रांवाङ, ओटन बाहेरलै च्याङस्यु ओलजन खुलौ रांपरिङौ। <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />रुयाङल हुल येशुल नावङल, चुङज्यावाङ ओटन नकाङै येशुजन ऐराढोव, “खिम्ते, नाअमा सनर नभाईयाङ पाखाल नङजन रोअज्यावाङ।” <verse eid="MRK 3:32" /><verse number="33" style="v" sid="MRK 3:33" />येशुले नकाङजन जबाक आयोवाङ, “ङाअमा सनर ङा भाईयाङ काङ्काङ?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />ओटन ओले चारवर खिमस्यु ऐआढोव, “ब्याएचिते, इकाङ ज्या ङाअमा सनर ङा भाईयाङ। <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />दानाङभन्या जोले परमेस्वरलं इच्छ्या पालन ढोव नकाङज ज्या ङा भाईयाङ सनर ङा बैनाङ ओटन ङाअमाङ ज्या?”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">धूर वाइन्याल आहान</para>
  <para style="r">
    <ref loc="MAT 13:1-23">मत्ती १३:१-२३</ref>; <ref loc="LUK 8:4-15">लूका ८:४-१५</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />येशुले फरि समुन्दरल वङल सिक्छ्या यांऔ तअसिऊ। चारवरङन रुल हुल आवाए घिन्या ताहौ कि, येशु समुन्दरल लिज्यान्या तोलोअ डोङ्गाल वूमौ, ओटन अपुर सोगलै रुयाङ नामलै च्याङज्यावाङ।<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">लूका ५:१-३</ref></char></note> <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />ओटन येशुले नकाङजन आहानङन भ्याई छेन आह्युउवाङ। आसिक्छ्याङन ओले ऐआढोवाङ, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“थएचिते! ब्याएचिते, तोलोअ धूर वाइन्या रु वाहौ नाल्ट पलिहौ। <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />ओटन ओले धूर आवाहौक काङ्का धूर यमल वङल परिऊ, ओटन बनबायाङ रा:स्यु रांज्योव। <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />काङ्का धूर लुङलेन्या पोल परिऊ, जोल नाले भ्याई व्म माडोएदा ओटन व्म आमाडोटौकाले छिटो परिटौ। <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />ओटन जब भ्याई घाम चर्किस्यु वुईलिउ, ओटन रिंन आमाकोलोकौकाले राङौ। <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />ओटन काङ्का धूर ज़ुयाङ खार्ल परिऊ। ओटन जङ्गलले आछ्यापौ, ओटन ना माशैदा। <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />तर काङ्का धूरयाङ चान्या येङल तेइवाङ, ओटन नका परिइवाङ, ओटन घिस्यु सैईवाङ, ओटन काङ्का तिस गुना, काङ्का साठी गुना ओटन काङ्का सय गुना सैईवाङ।” <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />तब येशुले ऐलेऊ, “जोल थएन्या ना ले नकाले ग्याथटौत्या।”<verse eid="MRK 4:9" /></para>
  <para style="s">आहानल अर्थ</para>
  <para style="r">
    <ref loc="MAT 13:10-17">मत्ती १३:१०-१७</ref>; <ref loc="LUK 8:9-10">लूका ८:९-१०</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />जब येशु आबाठए लिज्याऔ, तब जो-जो रुयाङै ईका राथटौ, आ सिइयाङ ल्योङ हिन्वाङ, ओटन ओयाङै ईका आहानल अर्थ रांगिन्वाङ। <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />येशुले नकाङजन ऐआढोवाङ, “परमेस्वरलं राज्यल अर्थ जेजन यांस्युई लेसिया, तर बाहेरला वालाङ नाल्ट सोगलै छेन आहानयाङ ङन्ज पान्सिया। <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />नैताइस्यु नकाङ ब्याएन्या ता ऐब्याएरा तर नकाङ मारङरदी, थएन्या ता ऐथएरा तर माबुजिरदी। ऐग्याटाईत्या कि नकाङ परमेस्वरलं लेऊदेए ग्यावलरते ओटन नकाङल पाप छेमा ढान्या लेसिया।”<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यशैया ६:९-१०</ref></char></note><verse eid="MRK 4:12" /></para>
  <para style="s">धूर वाइन्या आहानल अर्थ आपानस्यान्या</para>
  <para style="r">
    <ref loc="MAT 13:18-23">मत्ती १३:१८-२३</ref>; <ref loc="LUK 8:11-15">लूका ८:११-१५</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />फरि येशुले नकाङजन ऐआढोवाङ, “जे ईका आहानल अर्थ माबुजिच्योकन? फरि अपुर आहानयाङल अर्थ कैलेस्यु बुजिच्यो का? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />धूर वाइन्या वालाले परमेस्वरलं बचन वाइवा। <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />काङ्का रुयाङ ना धूर मनताइन्या लेरा। जो यमल वङल परिवाङ, नकाङै जोमनताइन्या सिक्छ्या थएरकन बै सैतान ओचोएटै रा:स्यु जो बचन नकाल वाइसिऊ ना बचन ऐलाङौ। <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />नैलेस्युजै जो लुङैलुङलेन्या पोल वाइसिऊ, ईका नकाङ ज्या, जो बचन थएस्यु ओबजाक्कै हेसाङस्यु ग्रहन ढोरा। <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />तर नकाङल भितरलं रारिंन आमाफैलिउकाले नकाङ टचिइ दिनजाई तनरा, ओलं छिन्ट बचनल कारन खान्या या दुख राकन, नकाङ ओचोएटै ढोङरा। <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />ज़ुयाङ खार्ल वाइसिन्या धूरयाङ नकाङ ज्या, जोले बचन ता ऐथएरा, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />तर ईका जिबनल सङ्सारला आतिइ सनर धनसम्पतलं मयामोह सनर अपुर लोब ढास्यु बचनजन माएरा। ओटन नकाङ फलिफाप माताइरदी। <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />ओटन जोयाङ चान्या येङल वाइसिवाङ हो, नकाङ बचन थएरा, ओटन ग्रहन ढोरा, ओटन शई बै शशैरा, काङ्काङै तिस गुना, काङ्काङै साठी गुना ओटन काङ्काङै सय गुना।”<verse eid="MRK 4:20" /></para>
  <para style="s">दिया यर्त बत्ति</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />येशुले नकाङजन ऐआढोवाङ, “नैति काङ्काङै बत्ति बलाइस्यु पाथीबाङल या चारपाईन्युउल नाएङालेस्यु भितरलं रालाङौका? नैति दियालं यर्त मानाएसिऊ का?<note caller="-" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">मत्ती ५:१५</ref>; <ref loc="LUK 11:33">लूका ११:३३</ref></char></note> <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />जो जन्तु मोअसिज्या, नका सोगल पाखालै थनन्या लेसिया, ओटन जो जन्तु कप्सी ना मोअसिऊ माढुदुऊदी।<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">मत्ती १०:२६</ref>; <ref loc="LUK 12:2">लूका १२:२</ref></char></note> <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />यदि जोल थएन्या नाले नकाले ग्याथटौत्या।” <verse eid="MRK 4:23" /><verse number="24" style="v" sid="MRK 4:24" />येशुले नकाङजन फरि ऐआढोवाङ “जे जो थएच्यो, नकात ध्यान योंचिते। दानाङभन्या ज्वाए मानस्यु जे योंचिर जे ओवाए डोएच्या। ओटन जेजन ओटन बै भ्याई यांन्यालेसिया।<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="MAT 7:2">मत्ती ७:२</ref>; <ref loc="LUK 6:38">लूका ६:३८</ref></char></note> <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />दानाङभन्या जोसकाए ले नकाजन अपुर बै यांन्यालेसिया, तर जोल्योङ माले, नका ल्योङन लेकन बै न्हानसिया।”<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्ती १३:१२</ref>; <ref loc="MAT 25:29">२५:२९</ref>; <ref loc="LUK 19:26">लूका १९:२६</ref></char></note><verse eid="MRK 4:25" /></para>
  <para style="s">फैलिन्या धूरल आहान</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />येशुले ऐलेऊ “परमेस्वरलं राज्य ऐटाइन्या हो कि काङ्का तोलोअ रुले येङल धूर आवाहौमन, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />ओटन ना रिउल रुक कन्बै, सन्सिज्याकन्बै लाअ रिउ ना धूर तुसाहा ओटन घिया, तर ना कढाई घिऊ नाजन थाहै माताइदी। <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />येङले ओलजै सपरिइवा, पहेला तुसाइस्यु आडाला, ओलं छिन्ट बाला, तब बालाल पुरै जाए सहा। <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />तर जब आजाए मीन तब नाले हस्याले खानौ तअसिया, दानाङभन्या अन दुउन्या बेला ताइदा।”<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="JER 3:13">यर्मिया ३:१३</ref></char></note><verse eid="MRK 4:29" /></para>
  <para style="s">काथ्याल धूरल आहान</para>
  <para style="r">
    <ref loc="MAT 13:31-32">मत्ती १३:३१-३२</ref>; <ref loc="LUK 13:18-19">लूका १३:१८-१९</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />येशुले फरि ऐलेऊ, “परमेस्वरलं राज्य नैस तुलना ढान्या? अथाबा नै आहानङन इकाल वाऱ्याइसं पानन्या? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />नका काथ्याल जाए मनताइन्याई लेया जब येङल वाइसी। तब ना यिङला सोगलै धूरयाङतन इङन्या ताहकन बै, <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />जब नका वाइसी, तब ना घिया, ओटन सोगलै इङन्याङतन ना घिन्या ताहा, ओटन नकाले घिघिन्या हाङ्गाङ पलिइवा, ओटन नमता बनबायाङै नकाल छिरिउल बाईचुङन्या सनर रा:सिप जाएरा।” <verse eid="MRK 4:32" /><verse number="33" style="v" sid="MRK 4:33" />नकाङै ज्वाए बुजिऊ राढुदुउ येशुले ऐटाइन्या तबर आहानयाङ पानस्यु, नकाङजन बचन आसथएवाङ। <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />बिना आहान येशु नकाङसं माछ्योङदा, तर आ सिइयाङजन ओलं राबाठएक सोगलै अर्थ आपानस्योवाङ।<verse eid="MRK 4:34" /></para>
  <para style="s">येशुले आन्ढीजन आसदिङौ</para>
  <para style="r">
    <ref loc="MAT 8:23-27">मत्ती ८:२३-२७</ref>; <ref loc="LUK 8:22-25">लूका ८:२२-२५</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />ओछिम्क ओइ ताहापाइनाई येशुले सिइयाङजन आढोवाङ, “रांचिते, गे समुन्दरल हुदिफन्ट हिनन्या।” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />ओटन हुलसकाए बिदा होन्‌वा पाइना, येशु जो डोङ्गाल चुङज्याऊ, नकालै ओलजन आसिइयाङै रा:सकाए रालाङौ। ओटन अपुर डोङ्गाङबै रा:सकाए लेवाङ। <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />ओटन ओचोएटै नल घिन्या आन्ढी कोखा आढोव, ओटन रील छालयाङ डोङ्गाल पछरिऊ तअसिऊ, आवाए समन कि डोङ्गाल री फाङताइङा लेदा। <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />येशु ओलजै डोङ्गाल छिन्ङन्ता पोल तोलोअ वूम नाएस्यु आम्वाईज्याऔक, नकाङै ओलजन ऐढास्यु रासोचटौ, “औ गुरुज्यू, गे सिङा गेलन्या नैति नङजन आतिइ मालेव रों?” <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />तब येशु सन्सिऊ ओटन आन्ढीजन आहप्काहौ, ओटन समुन्दरल छालयाङजन ऐआढोव, “शान्त ताहन्ते! दिङन्ते!” ओटन आन्ढी थामिसिऊ ओटन भ्याई हेसाङवाङ। <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />येशुले नकाङजन आढोवाङ, “जे दानाङ आवाए छ्याएच्यो? जेल्योङ अझ बै बिस्वास मालेऊ?” <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />तर नकाङ भ्याईज छ्याएवाङ ओटन रारां छ्योङौ लागिवाङ, “ईका काङ्का? आन्ढी सनर समुन्दरले बै इकाल परीम मानिज्याऔने।”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">येशुले भूत लागिन्या रुजन आसबेलन्या</para>
  <para style="r">
    <ref loc="MAT 8:28-34">मत्ती ८:२८-३४</ref>; <ref loc="LUK 8:26-39">लूका ८:२६-३९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ओटन येशु सनर आ सिइयाङ समुन्दरल हुदिफन्ट गेरासेनस मलुउलं रांवाङ। <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />येशु डोङ्गालन ओचोएटै बाहेर पलिहौ, ओटन सिन्या रुयाङल ऊईलन तोलोअ अशुद्दआत्मा लेन्या रु येशुसं डोएसिऊ। <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />नका ऊईजिऊलै चुङज्याया। ओटन काङ्काईले नाजन साङ्गलले समेत पोअस्यु नाटौ माढुदुरदी। <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />दानाङभन्या नकाजन तबर पाला हटकरी सनर साङ्गलले पोअसिऊ, ओटन बै नकाले साङ्गल चेईस्यु कलाए-कलाए आजाटौ, काङ्काईले नकाजन कायम जाटौ माढुदुज्यारदी। <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />नका सदाई लाअ रिउ ऊईजिऊल सनर डान्डा जिऊल कलिकौयन ओटन ओलं ओलझन्जै लुङले टुप्सिस्यु घाइत्या जाएवा। <verse eid="MRK 5:5" /><verse number="6" style="v" sid="MRK 5:6" />ओटन जब नाले येशुजन लोएतन आरङौ, तब चोएस्यु रा:औ, ओटन येशुजन घुन्डा टिकिस्यु ढोक आयोव। <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />ओटन घिन्या ग़ाले चिचच्याइस्यु ऐलेऊ, “औ, सर्बोच्च परमेस्वरलं ज़ा येशु ङाजन नङसं नै काम? नङ ङाङन नै नचाहिनु? परमेस्वरलं मिनतन ङा नङजन बिन्ति ढाना नङ ङाजन दुख तायाङ।” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />(दानाङभन्या येशुले नकाजन ऐआढोव, “ऐ अशुद्दआत्मा नका तन पलिईस्यु हिनन्ते”) <verse eid="MRK 5:8" /><verse number="9" style="v" sid="MRK 5:9" />ओटन येशुले नकाजन आगिनौ, “न मिन नैति?” नकाले येशुजन आढोव, “ङा मिन ता फौज दी, दानाङभन्या गे भ्याई लेई।” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />ओटन दुस्टआत्माङै येशुजन पालै पाला बिन्ति रांढोव, गेजन ईका पोलन तापलिइसिन। <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />नला नेराका डान्डाल वोअयाङल तोलोअ घिन्या बगाल लाज्यावाङ। <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />ओटन नका दुस्टआत्माङै ऐलेस्यु येशुजन बिन्ति रांढोव, “गेजन वोअयाङल ल्योङ हिनौ यांसिन्ते, ओटन गे नकाङल जिङल पसिया।” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />तब येशुले नकाङजन हिनन्या अनुमति आयोवाङ, ओटन ना दुस्टआत्माङ बाहेर पलिईस्यु वोअयाङ जिङल पसिवाङ, ओटन छ्योअ नेहजार वोअयाङल बगाल ओरलालन हुर्रिस्यु समुन्दरल तेइवाङ ओटन बुदिस्यु सिवाङ। <verse eid="MRK 5:13" /><verse number="14" style="v" sid="MRK 5:14" />नका वोअयाङ छान्या वालाङ ढोङस्यु, बजार सनर नङ्गरल हिनस्यु रांपानौ। ओटन ईका नैति ताहौ, ना ब्याटौ नाल्ट रुयाङ नल रांवाङ। <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />तब नकाङ येशु ल्योङ रांवाङ, ओटन जो रु ल्योङ दुस्टआत्माङ लागिन्याङै ओजन रांरङौ, ओटन ना रु बेलस्यु चान्या ताइस्यु क्वा क्वाएसिस्यु आचुङज्यान्या रङस्यु नकाङ छ्याएवाङ। <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />ओटन जो जोले ईका घटना रांरङौ, नकाङै जोल्योङ दुस्टआत्माङ लागिन्याङ, ओटन वोअयाङल हालत नैताइस्यु लेव नकाङजन रा:सथएवाङ। <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />ओटन नकाङ येशुजन बिन्ति ढाऔ तअसिवाङ, कि गे पोलन हिनन्ते। <verse eid="MRK 5:17" /><verse number="18" style="v" sid="MRK 5:18" />येशु डोङ्गाल पसिङा आलेऊक, नका दुस्टआत्मा लागिन्या रुले बिन्ति आढोव, “ङाजन नङसं हिनौ यांङते।” <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />तर येशुले नाजन माभनस्योदा, तब नाजन ऐआढोव, “नङ नझिम हिनस्यु न रुयाङ सनर नन्हाएयाङजन प्रभुले न नाल्ट नैति घिन्या काम आढोव ओटन नङजन आठनस्यान्या, घिन्या दयाल बारे नन्हाएयाङजन पानस्योवरते।” <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />तब नका डेकापोलिस<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">देकापोलिस ऐराढान्या शब्दल अर्थ १० सहर बराबर</char></note> सहर हिनौ, ओटन येशुले आ नाल्ट आढान्या घिन्या अचम्मला कामल बारेङन नला सोगल पोल प्रचार आढोव ओटन रुयाङ अचम्मै ताइवाङ।<verse eid="MRK 5:20" /></para>
  <para style="s">याईरसल मेएमा आज़ा सनर रोगि मेएमा</para>
  <para style="r">
    <ref loc="MAT 9:18-26">मत्ती ९:१८-२६</ref>; <ref loc="LUK 8:40-56">लूका ८:४०-५६</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />फरि जब येशु डोङ्गालन समुन्दरल हुदिफन्ट हिनौ, तब तोलोअ बअघिन्या रुयाङ हुल हुङआङन दुउसिवाङ, ओलं समुन्दरल वङलै लिज्याऔ। <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />आराधना झिमला शासकयाङ मध्य तोलोअ याईरस मिनला रु आल्योङ रांऔ, ओटन येशुजन रङस्यु आखङल फलुप्सिऊ, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />ओटन ऐलेस्यु भ्याई बिन्ति आढोव, “ङामि इङन्या मेएमा ज़ा सिङाईलिज्याव, नैताइस्यु रा:स्यु नकाल यर्त नकुई नाएते, ओटन ना बेलस्यु जिङदा ग्याताइत्या।” <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />तब येशु नका सकाए हिनौ। तोलोअ घिन्या रुयाङ हुल आछिन्ट लागिऊ, ओटन, रुयाङ आल्योङ रांङालेस्यु थुईसिस्यु वङवाङ। <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />ओटन बारं बर्स हाकन्ज जी बगिन्या वाला तोलोअ मेएमा नल लिज्याऔ। <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />ओटन नाले तबर गुनीयाङ कुईतन घिन्या लेन्यामालन्या दुख आडोटौ ओटन आमि सोगल धनसम्पत खर्च ढास्यु बै नका माबेल्दा तर नका झन्जै माचान्या गतिल हिनस्यु लेऊ। <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />नकाले येशुल चान्याथाई थएस्यु आनाटौ, ओटन ओ रुयाङ हुलल छिन्ङन रा:स्यु येशुल क्वा आछुउ। <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />दानाङभन्या नकाले आयिङ आयिङल ऐलेऊ, “यदि ङा नकाल क्वा, याएज छुङकन बै ऐबेल्ङा।”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />ओटन ओबजाक्कै नका मेएमाल जी बगिन्या रुकिसिऊ, ओटन आबुलला रोग आबेलन्या नकाले आसनौ। <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />येशुले ओचोएटै आसक्ति बाहेर आपलिइन्या सनस्यु हुलल लेऊदेए वलस्यु रुयाङजन आगिन्वाङ, “काङ्काले ङाक्वा आछुउ?” <verse eid="MRK 5:30" /><verse number="31" style="v" sid="MRK 5:31" />ओटन आसिइयाङै येशुजन ऐराढोव, “रुयाङ रारां राथुइसिज्यान्या ता नङ ऐरङज्याना, ओटन बै नङ ऐलिज्याना कि काङ्काले ङाजन आछुङु?” <verse eid="MRK 5:31" /><verse number="32" style="v" sid="MRK 5:32" />तर ङाजन छुन्या वाला काङ्का रैस, लेस्यु येशुले चारवरदेए आखिमौ। <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />तब ना मेएमाले ओलजन कैताइस्यु लेऊ ना सनस्यु, आछ्याहै वुउस्यु-वुउस्यु रांऔ ओटन येशुल लेऊक घुन्डा टिकिस्यु जो ताइस्यु लेऊ सोगल सत्य छेन आपानस्योव। <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />तब येशुले नाजन ऐआढोव, “ऐ ज़ा, नबिस्वासले नङजन आसबेल्नु, शान्त सकाए हिनन्ते न नाएबोर बेल्दा।” <verse eid="MRK 5:34" /><verse number="35" style="v" sid="MRK 5:35" />येशुले आछ्योङज्याऔक, यहूदीयाङ शासकलं झिमलन रुयाङ अथाबा थाई पानन्यावालाङ रा:स्यु ऐलेवाङ, “न ज़ा ता सिदा। आब गुरजन अपुर नैकाम दुख नजाएज्यानु?” <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />तर नकाङै रांछ्योङज्यान्या छेनदेए ध्यान मायास्यु येशुले आराधना झिमला याईरसजन ऐआढोव, “ताछ्यातन, बिस्वास याएज ढोते।”<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />ओटन येशुले पत्रुस, याकूब, सनर याकूबल आभाई यहुन्नाजन बाहेक अपुर काङ्काईजन बै यहूदीयाङ आराधना झिमल ओलसं रांन्या अनुमति मायोदुऊरा। <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />ओयाङ आराधना झिमला शासकलं झिमल तापवाङ ओटन भ्याई रुयाङ राव्‌रज्यान्या सनर राचिचच्याइज्यान्या रांरङवाङ। <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />तब भितरलं हिनस्यु येशुले नकाङजन ऐआढोवाङ, “जे दानाङ हल्ला मच्चाईज्याच्यो ओटन दानाङ व्‌रच्यो? लुल सिस्यु माल्दी, तर नका रुउस्यु लेऊ।” <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />नकाङ येशुल छेन थएस्यु साहौ तअसिवाङ। तब ओले नकाङ सोगलैजन पाखाल आपलिइवाङ ओटन लुलल बौ सनर आअमा ओटन ओलसं लिज्यान्या आ सिइयाङजन ओलसं लाङस्यु जोङ लुल लिज्याऔ, ओङ हिन्वाङ। <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />ओटन लुलल कुई कोलोअस्यु ओले नकाजन ऐआढोव, “तालिता कुमी,” जोल अर्थ हो, “ऐ लुल ङा नङजन ऐढाना सोन्ते।” <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />ओटन ओचोएटै लुल सोव, ओटन बावतअसिऊ। ना लुल बारं बर्सला लेऊ। ओटन नवाए बेला नकाङ अचम्मै ताइवाङ। <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />येशुले नकाङजन ऐआढोवाङ, ईका काङ्काईजन थाह ताटाइत्या ऐलेस्यु कडा आग्या आयोवाङ। ओटन नकाङजन ऐआढोवाङ, लुलजन कोबाअ ज्यान्या योंचिते।<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">नासरतलं येशुजन इन्कार</para>
  <para style="r">
    <ref loc="MAT 13:53-58">मत्ती १३:५३-५८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />येशु सनर आ सिइयाङ बै ओलसंज नलन पलिईस्यु आनङ्गरलै वलस्यु रांवाङ। <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />शबाथ छिम्क ओले आराधना झिमल सिक्छ्या यांऔ तअसिऊ। थएन्या वालाङ अचम्म ताइवाङ, ओटन ऐलेवाङ, “इकाले काङन सोगलै ग्यान आडोटौ? इकाजन यांसिन्या ईका ग्यान कैताइन्या रैस? इकाल कुईले आढान्या कामयाङ ख्वाए सक्तिशाली लेवाङ? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />नैति ईका नकाई कुर्मि माङडीका? आका मरियमलं ज़ा, ओटन याकूब, योसेफ, यहूदा सनर सिमोनयाङ रांदाज्यू माङडीका? नैति आल बैनाङ गेसकाए मालिज्यावाङ्का?” ओटन येशुजन नकाङै बिस्वास रांमाढोव।<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />येशुले नकाङजन ऐआढोवाङ, “अगमबक्ताजन आझिमल सनर आदेसल ओटन आनाटागोटाङ्ङन बाहेक अपुर काङै अपमान माताइदी।”<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JHN 4:44">यहुन्ना ४:४४</ref></char></note><verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />ओटन येशुले नङं काङ्का-काङ्का नाएबोरन्याङ यर्त आकुई नाएस्यु सक्तिशाली कामङन नकाङजन आसबेल्वाङ, अपुर नैज ढाऔ माढोदुडा। <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />नकाङल अबिस्वास रङस्यु येशु छक्कै परिऊ। ओटन हुङआङा नङ्गर जिऊल हिनस्यु सिक्छ्या यांऔयन हिनौ।<verse eid="MRK 6:6" /></para>
  <para style="s">येशुले बारं सिइयाङजन आपरिङन्या</para>
  <para style="r">
    <ref loc="MAT 10:1">मत्ती १०:१</ref>,<ref loc="MAT 10:5-15">५-१५</ref>; <ref loc="LUK 9:1-6">लूका ९:१-६</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />येशुले बारं सिइयाङजन आल्योङ आखुल्वाङ, ओटन नकाङजन नें-नेंलोअ जाएस्यु आपरिङवाङ। ओटन नकाङजन दुस्टआत्माङ यर्त अढिकार बै आयोवाङ। <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />नकाङजन ऐटाइन्या आग्या आयोवाङ, “यमल नाल्ट जेस नैज बै तावुरच्यो, न त भरेई, न जन, न खल्तीइल रुप्या, तर जेस जम्मा तोलोअ झुई याएज छेनच्यो।<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">लूका १०:४-११</ref></char></note> <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />जुता जाएसिच्यो, तर अपुर भ्या क्वा तावुरच्यो।” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />ओले नकाङजन ऐआढोवाङ, “जब काङ्काङल झिमल पसिच्यो, ना नङ्गरलन बिदा जेमानीऊ समन, नलै चुङज्याचिते। <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />यदि जो पोल जेमि स्वागत माताह, सनर रुयाङै जे बचन थएन्या यिङ ऐज माढोरकन, ना पोलन जेपलिहौक नकाङल बिरोदत साचील नाल्ट जेपाइटलाला धुलो हरस्योचिरते, जो कि ना नकाङ नाल्ट चेताउनी ग्याताइत्या ओटन परमेस्वरले नकाङल निया ग्याढोउत्या।”<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">प्रेरित १३:५१</ref></char></note><verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />ओटन नकाङ पलिईस्यु हिन्वाङ, ओटन अपुर रुयाङजन पापङन पस्चातापल नाल्ट प्रचार ढाऔ तअसिवाङ। <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />नकाङै तबर दुस्टआत्माजन रापलिइवाङ, ओटन भ्याई नाएबोरन्याङजन तीइ ठिइस्यु रा:सबेल्वाङ।<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">याकूब ५:१४</ref></char></note><verse eid="MRK 6:13" /></para>
  <para style="s">बप्तिस्मा यांन्या यहुन्नाजन रासएन्या</para>
  <para style="r">
    <ref loc="MAT 14:1-12">मत्ती १४:१-१२</ref>; <ref loc="LUK 9:7-9">लूका ९:७-९</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />हेरोद रयले येशुल बाए थएस्यु लेऊ, दानाङभन्या ओलं मिन भ्याई प्रचार ताइस्यु लेऊ, ख्वाएले ऐलेवाङ, “बप्तिस्मा यांन्या वाला यहुन्ना सिस्यु जिङदा ताइदा रैस, नैताइस्यु ता नकाङ्ङन ऐटाइन्या सक्तिला कामयाङ ताइज्याया।”<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MAT 16:14">मत्ती १६:१४</ref>; <ref loc="MRK 8:28">मर्कुस ८:२८</ref>; <ref loc="LUK 9:19">लूका ९:१९</ref></char></note> <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />काङ्काङै ऐलेवाङ, “ईका एलिया ज्या।” ओटन फरि अपुऱ्याङै ऐलेवाङ “ईकाता हाका बेलाका अगमबक्ताङ्ङन तोलोअ अगमबक्ता ज्या।” <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />जब हेरोदले ईका आठटौ, तब नकाले ऐलेऊ, “यहुन्ना, ङा जोल ङए पलौ ङापरिङ्ङु, नकाई जिङदा ताइदा रैस।” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />दानाङभन्या हेरोदले आभाई फिलिपल मेएमा हेरोदियासल नाल्ट यहुन्नाजन कोलोकौ परिङस्यु नाजन पोअस्यु झ्यालखानाल झोअस्यु आनाटौ, दानाङभन्या नाले हेरोदियासजन ब्याहा ढास्यु लेऊ।<note caller="-" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">लूका ३:१९-२०</ref></char></note> <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />दानाङभन्या यहुन्नाले हेरोदजन ऐढास्यु लेऊ, “न भाईल मेएमाजन ब्याहा ढास्यु नाएना नङ ईका नढान्या काम नियानिसापस मेल माज्योडा।” <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />नैताइस्यु हेरोदियासले नकाल यर्त आयिङल इक नाएस्यु आनाटौ, ओटन नाजन सटौ आरोकौ, तर ओलजै सटौ माढुदुज्यादी। <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />दानाङभन्या हेरोदले यहुन्नाजन तोलोअ धर्मात्मा सनर पबित्र रु यिङस्यु नकाजन रङस्यु छ्याएस्यु, नकाजन जोगाइस्यु नाएस्यु लेऊ। यहुन्नाल सिक्छ्या आथटौक नका भ्याईज आतिस्यु हलाअ ताहा, ओटन बै भ्याई हेसाङसिस्यु थएज्याया। <verse eid="MRK 6:20" /><verse number="21" style="v" sid="MRK 6:21" />तर नका बेला रांऔ, जब हेरोदले आजर्मिऊ दिन छिम्क आमि मुख्या मन्त्रीयाङ, अढिकारीयाङ सनर गालील प्रदेसला खास-खास रुयाङजन घिन्याई भोस आयोवाङ। <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />नवाए बेला जब हेरोदियासल मेएमाज़ा भितर रा:स्यु स्याऔ, तब नाले हेरोद सनर नकाल खास पाहुनाङजन स्यास्यु खुशी आजाएवाङ। ओटन रयले ना किटीजन ऐआढोव, “नङ जो नीङानल्नु ओइज नीन्ते ङा नङजन ऐयाना।” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />फरि हेरोदले किऱ्या ज्यास्यु ना किटीजन ऐआढोव “नङ ङा ल्योङ जो नीन ङा तपाअ राज्य समन बै यांन्या।” <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />ओटन पाखाल हिनस्यु आअमाजन आगिनौ, “ङा नैति नीङ?” तब आअमाले ऐआढोव, “बप्तिस्मा यांन्या यहुन्नाल ङए।” <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />नका ओचोएटै भितरलं रय ल्योङ हिनौ, ओटन ऐलेस्यु नीऊ, “ङा इच्छ्या ईका लेऊ कि नङ आकैज ङाजन बप्तिस्मा यांन्या यहुन्नाल ङए थालल यांङते।” <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />ओटन रय भ्याईज दुखी ताहौ, तर नकाले भोसलं आखुलन्या खास आपाहुनाङ लेऊक बाचा आढाऔकाले नका किटीजन आयांन्या बचन सतेहौ आमाढुदुऊ। <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />रयले ओचोएटै तोलोअ सिपाइजन परिङस्यु यहुन्नाल ङए पलस्यु होनन्या हुकुम आयोव। ओटन नकाले झ्यालखानाल हिनस्यु यहुन्नाल ङए आपलौ, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />ओटन थालल हिनस्यु किटीजन आयोव, किटीले आअमाजन आयोव। <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />यहुन्नाल आसिइयाङै जब ईका छेन राथटौ तब नकाङ रा:स्यु यहुन्नाल सिन्या बुलजन छेन्स्यु ऊईल लाङस्यु रारीनौ।<verse eid="MRK 6:29" /></para>
  <para style="s">येशुले घिन्या रुल हुलजन आयांइन्या</para>
  <para style="r">
    <ref loc="MAT 14:13-21">मत्ती १४:१३-२१</ref>; <ref loc="LUK 9:10-17">लूका ९:१०-१७</ref>; <ref loc="JHN 6:6-13">यहुन्ना ६:६-१३</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />ओटन जब येशुल प्रेरितयाङ नङ्गरलन वलस्यु रांवाङ, तब ओलसं डोएसिवाङ ओटन जो-जो रांढोव, सनर ह्युउसिवाङ ना ओलजन सोगल रापानस्यौ। <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />येशुले नकाङजन ऐआढोवाङ, “जे ङा सकाए अलक्कै पोल रांचिते, ओटन तचिइ थाकिस्युलेच्या नानसिचिते।” दानाङभन्या नल रांऔयन हिनौयन ढान्या रुयाङ तबर लेवाङ, ओटन नकाङजन ज्यान्या नाम बै माल्दी। <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />ओटन ओयाङ डोङ्गाल चरिस्यु, बाठए शान्त पोल अलक्कै हिन्वाङ।<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />ओटन भ्याई रुयाङै ओयाङजन राहिनज्यान्या रङस्यु रांशहौ, ओटन सोगल बजारङन दुउसिस्यु पाइदल चोएवाङ ओटन ओजन बनाएस्यु जन हादेएजै नकाङ तापवाङ। <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />जब रां समुन्दर वङल लाइवाङ तब येशुले तोलोअ घिन्या हुलजन आरङौ, ओटन ओले नकाङजन यीङताए आमानिवाङ। दानाङभन्या नकाङ ग्वाला बिनाला भेडाङ मनताइन्या लेवाङ। ओटन येशुले नकाङजन तबर छेनयाङ ह्युउकौ तअसिऊ।<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="2CH 18:16">२इतिहास १८:१६</ref>; <ref loc="1KI 22:16-18">१राजा २२:१६-१८</ref></char></note> <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />ओटन जब भ्याई अदलाअ ताहौ, तब आ सिइयाङ आल्योङ रा:स्यु ऐलेऊ तअसिवाङ, “ईका अलक्कै पो लेया, ओटन आब ओइ ताइदा। <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />नकाङजन बिदा योंवरते ओटन नकाङै चारवरङा नङ्गर जिऊल सनर डेराबाराल हिनस्यु रांनाल्ट कोबाअ ज्यान्या ग्यालङरत्या।” <verse eid="MRK 6:36" /><verse number="37" style="v" sid="MRK 6:37" />तर येशुले जबाक आयोवाङ, “जेईज नकाङजन कोबाअ ज्यान्या योंचिरते।” नकाङै ओजन ऐराढोव “नैति गे हिनस्यु नें सय चान्दील ध्याअले<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">दिनार=सिक्का=चान्दील ध्याअ</char></note> भरेई लाङस्यु नकाङजन ज्यान्या यांन्याङ?” <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />येशुले नकाङजन आढोवाङ, “जे सकाए ख्वाए गोटा भरेई लेऊ? हिनस्यु ब्याएचिते।” ओटन ब्याएबिई ढास्यु ऐलेवाङ, “पास गोटा भरेई सनर नेंलोअ ङा:स्या।”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />ओटन येशुले सोगलैजन बाङला पिङन्या छील यर्ल बगाल बगाल ताइस्यु चुङन्या हुकुम आयोवाङ। <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />नकाङ सय-सय सनर पचास-पचासला बगाल ताइस्यु चुङवाङ। <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />येशुले ना पास गोटा भरेई सनर नेंलोअ ङा:स्या आहोनौ, ओटन नमदेए खिमस्यु धन्याबाद आयोव, ओटन ना भरेई कलाएस्यु आ सिइयाङ आयोवाङ, ओटन सिइयाङै नकाङजन राभाअस्योवाङ, ओटन ना नेंलोअ ङा:स्या बै राभाअस्योवाङ। <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />ओटन सोगलैले रांकयौ ओटन पटिपन्न ताइवाङ। <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />ओटन रांकयौ छिन्ङ आसिइयाङै रा:सयलन्या भरेईल कलाए सनर ख्वाए ङा:स्या बारं घोन फाङ रादुकौ। <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />भरेई कैन्या ल्हेपाङ पास हजार लेवाङ।<verse eid="MRK 6:44" /></para>
  <para style="s">येशु रीलयर्त आबान्या</para>
  <para style="r">
    <ref loc="MAT 14:22-36">मत्ती १४:२२-३६</ref>; <ref loc="JHN 6:16-21">यहुन्ना ६:१६-२१</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />ओटन येशुले आ सिइयाङजन डोङ्गाल चराइस्यु हुदिफन बेथसेदालं ङा तन हादेए हिन्चिते लेस्यु आपरिङवाङ, ओटन नवाए बेला ओलं रुयाङ हुलजन बिदा आयोवाङ।<verse eid="MRK 6:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 6:46" />नकाङ सकाए भाअसिया पाइनाई ओलं डान्डाल प्रार्थना धानाव। <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />जब ओइ आताहौक डोङ्गा, समुन्दरल यिङल लिज्याऔ, नवाए बेला येशु आबाठए पाखालै लिज्याऔ। <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />आसिइयाङै डोङ्गा राचलाइज्याऔक भ्याई दुख राडोएज्यान्या येशुले आरङौ, दानाङभन्या घूईका नकाङल उलत्यादेए ढाज्याव। छकाल्या ताहौ भन्या हादेए रिउला तिन बजे नका समुन्दरल यर्तन बास्यु नेराक रांऔ, ओटन नकाङजन बनाएस्यु हादेए हिन्ङा लेऊ, <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />नकाङै ओलजन समुन्दरल यर्त आबाज्यान्या रङस्यु आका ता भूत दी कान्देए, ऐलेस्यु नकाङ चिचच्याइवाङ। <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />दानाङभन्या ओलजन रङस्यु सोगलै छ्याएस्यु लेवाङ। तब ओचोएटै येशुले नकाङजन ऐआढोवाङ, “गाएगुइ ताछ्याएच्यो ङा दी।” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />ओटन येशु नकाङ रांलन्या डोङ्गाल चरिस्यु भितरलं रांऔ, ओटन घूईका शान्त ताहौ। ओटन नकाङ भ्याई अचम्म ताइवाङ, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />दानाङभन्या नकाङै पास हजार रुयाङल भरेईल बारेङन छेन रामाबुजिऊ, तर नकाङल यिङ कठोर ताइस्यु लेऊ।<verse eid="MRK 6:52" /></para>
  <para style="s">येशुले गनेसरेतला रोगियाङजन आसबेलन्या</para>
  <para style="r">
    <ref loc="MAT 14:34-36">मत्ती १४:३४-३६</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />येशु सनर आ सिइयाङ समुन्दरल हुदिफन उतरिस्यु गनेसरेतलं तापवाङ, ओटन नकाङै डोङ्गा आवङल रांपोकौ।<verse eid="MRK 6:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MRK 6:54" />जब डोङ्गातन पलिइवाङ तब ओबजाक्कै रुयाङै येशुजन रांशहौ, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />ओटन नावङजिऊला सोगलै नङ्गरलन ताइस्यु चोएस्यु हिन्वाङ, ओटन जोङ येशु लिज्याऔ, लेस्यु राथटौ नङाई पोल रुयाङै रानाएबोरन्याङजन रा:तानसै होनौ तअसिवाङ। <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />ओटन जोङ-जोङ ना नङ्गर, बजार, या डेराबारा ज्युउल हिन, रुयाङै नाएबोरन्याङजन बजार ज्युउल रानाएवाङ, ओटन येशुल क्वाल वङ याएज छुऊ ग्याडोएसित्या लेस्यु नकाङै बिन्ति ढाज्यावाङ, ओटन ज्वाएले ओलजन रांछुऊ नकाङ सोगलै बेल्वाङ।<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">सेरयाङल सिक्छ्या</para>
  <para style="r">
    <ref loc="MAT 15:1-20">मत्ती १५:१-२०</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />यरुशलेमङन रांन्या वाला ख्वाए फरिसीयाङ सनर शास्त्रीयाङ येशु ल्योङ चारवरङन दुउसिवाङ। <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />येशुल ख्वाएयाए आसिइयाङै यहूदीयाङल परम्परा अनुसार जुठुउ अथाबा राकुई, माहुरस्युई भरेई राकैज्यान्या रांरङौ। <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />दानाङभन्या फरिसीयाङ सनर स्वाट्टै यहूदीयाङ ऐकन्ता चलनजन मानिस्यु जब समन चान्यासै कुई माहुररं तब समन ज्यान्या माज्योरदी। <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />ओटन बजारङन जो होन्‌रकन बै कुई माहुरसिस्यु माज्योरदी, ओटन ऐटाइन्या भ्याई परम्परा मानिरा, खुरी, फुरसला, कासालं ताम्बाल, जायाङ मान्जिन्या चलन। <verse eid="MRK 7:4" /><verse number="5" style="v" sid="MRK 7:5" />ऐताइस्यु फरिसीयाङ सनर शास्त्रीयाङै येशुजन रांगिनौ, न सिइयाङ रां शाखापुर्खाङै रांमानिन्या चलन दानाङ मामानिर, तर जुठुउ कुईले ज्योज्यारा।<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:6 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 29:13">यशैया २९:१३</ref>
      </char>
    </note>तब नकाङजन येशुले ऐआढोवाङ, “यशैया भबिस्यबक्ताले जे घुर्बीयाङल बारेङन ठिक ऐलेस्यु भबिस्यबानी आढोव, जोमनताइन्या सरसिस्यु ले। ‘ईका रुयाङै याह्‌ले ता आदर ऐढोरा, तर नकाङ यिङ ङातन लोए लेया। (यशैया २९:१३) <verse eid="MRK 7:6" /><verse number="7" style="v" sid="MRK 7:7" />नकाङ दाङजै ङामि आराधना ढोरा, तर नकाङल सिक्छ्या रुयाङै राह्युउन्या मेसा याएज ज्या।’ <verse eid="MRK 7:7" /><verse number="8" style="v" sid="MRK 7:8" />दानाङभन्या परमेस्वरलं आग्याजन राइस्यु रुयाङल चलन मानिरा।” <verse eid="MRK 7:8" /><verse number="9" style="v" sid="MRK 7:9" />येशुले नकाङजन ऐआढोवाङ, “जे जेमी चलन मानिउ नाल्ट, परमेस्वरलं ‘आग्याजन ख्वाए माचान्यासं जेतारिचिऊ।’ <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />दानाङभन्या मोशाले ब्यबस्था अनुसार ऐलेऊ, जेअमा-जेबौयाङजन आदर ढोचिते ओटन जोले आमा-बौल बिरोद ढास्यु माचान्या छेन छ्योङ, नाजन पक्का सएन्याई ताहा।<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">प्रस्थान २०:१२</ref>; <ref loc="DEU 5:16">ब्यबस्था ५:१६</ref>; <ref loc="EXO 21:17">प्रस्थान २१:१७</ref>; <ref loc="LEV 20:9">लेवी २०:९</ref></char></note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />तर जे ऐलेच्या, कि यदि काङ्काङै आबौ या आअमासं ऐले। जो-ज्वाए नङजन ङा ङाव्एनु नका बलि ज्या (नकाल अर्थ ना परमेस्वरजन चराहौमन) ज्या, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />नैताहकन नाजन आअमा या आबौल नाल्ट फरि नैज सेवा ढाऔ मायोचिदी। <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />ऐलेस्यु जे ढास्यु जेरांन्या, चलनङजन कायम नाएस्यु परमेस्वरलं बचनदेए यिङ मायोचिदी। ओटन ऐटाइन्याई कामयाङ ढोच्या।”<verse eid="MRK 7:13" /></para>
  <para style="s">रुजन जुठुउ जाएन्या छेन</para>
  <para style="r">
    <ref loc="MAT 15:10-20">मत्ती १५:१०-२०</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />तब येशुले रुयाङल हुलजन आल्योङ खुल्स्यु नकाङजन ऐआढोवाङ, “जे सोगलैले ङा छेन थएचिते ओटन बुजिचिते। <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />ऐटाइन्या नैज जन्तु माल्दी बाहेरलन भितर पसिस्यु जो रुल भितर कोलोअस्यु अशुद्द जाएन्या, तर रुङन बाहेर पलिईन्या छेनलेईज रुजन अशुद्द जाएवा। <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />जोलं थएन्या ना ले नकाले ग्याथटौत्या।”<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">ईका पदला बचन काङ्का-काङ्का ग्रीक हस्तलिपिल जाई डोएसिया</char></note> <verse eid="MRK 7:16" /><verse number="17" style="v" sid="MRK 7:17" />जब ओले रुयाङजन बनाएस्यु झिमल रांऔ, तब आसिइयाङै ईका आहानल बारेङन रांगिनौ। <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />येशुले नकाङजन ऐआढोवाङ, “नैति जे अझ बै जेमाबुजिचिऊ?” जो बाहेरलन रुल भितरलं पसि नाले रुजन जुठुउ माजाटौडी।<verse eid="MRK 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 7:19" />दानाङभन्या ना आयिङल माङडी, तर भन्दिउल हिना, ओटन बुललन बाहेर पलिहा। नैति जे जेमासन्चिऊ, (येशुले सोगलै ज्यान्या जन्तुजन चोखा ज्या ऐलेस्यु आपानस्योवाङ।)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />ओटन येशुले ऐलेऊ रु ल्योङन जो पाखाल पलिह नकाईले रुजन जुठुउ जाएवा। <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />दानाङभन्या भितरङा, अथाबा रुल यिङलन माचान्या बिचार, ब्यबिचार, कुन्या, सएन्या, छुट्टै मेएमा खिमन्या, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />लाबि, घुर्बी, छलिन्या, छडवा, खिई, बाएढान्या, गिलल्याइन्या, घमन्डी, मुर्खी ऐटाइन्याङ पलिइरा। <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />ईका सोगलै माचान्या छेनयाङ भितरङन पलिइरा, ओटन रुजन जुठुउ जाएरा।<verse eid="MRK 7:23" /></para>
  <para style="s">सिरिया-फोनिकेला मेएमाल बिस्वास</para>
  <para style="r">
    <ref loc="MAT 15:21-28">मत्ती १५:२१-२८</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />फरि येशु नङंन सोस्यु टुरोस सनर सिदोनल सान्ढल हिनस्यु, तोलोअ झिमल पसिऊ। ओटन ईका छेन काङ्काईले तासनरत्या ऐलेऊ, तर ओलजै मोअसिऊ माढुदुडा। <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />ना बेला तोलोअ मेएमाले आबारेङन थएस्यु आनाटौ, ओटन नका रा:स्यु येशुल खङल धोक आयोव, दानाङभन्या नकाल मेएमाआज़ाल ल्योङ दुस्टआत्मा लेऊ। <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />ना ग्रीक मेएमा ओटन सिरियाल फोनिकेला पोल जर्मिन्या हो, नाले येशु सकाए ऐलेस्यु बिन्ति आढोव, कि मेएमा ङाज़ा ल्योङन दुस्टआत्मा पलिइस्योते। <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />येशुले नाजन जबाक आयोव, “पहेला लुलल्याङजन वाङौ योंवरते, दानाङभन्या ईका ठिक माङडी लुलल्याङ भरेई न्हानस्यु कांयाङजन क्याइस्यान्या ठिक माङडी।” <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />तर नकाले येशुजन ऐआढोव, “औ, प्रभु, तर कांयाङै बै ता लुलल्याङै टेबल न्युउ रा:सतेईन्या टुक्राङ कैरा सा।” <verse eid="MRK 7:28" /><verse number="29" style="v" sid="MRK 7:29" />येशुले नकाजन ऐआढोव, “नङ ऐनलेऊकाले ज नझिम हिनन्ते। न ज़ा ल्योङन भूत पलिईस्यु हिन्दा।” <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />जब ना आझिमदेए हिनौ, आज़ा चारपाई त आरुउज्यान्या आडोएनाङौ, ओटन नका ल्योङन भूत पलिईस्यु हिनस्यु लेऊ।<verse eid="MRK 7:30" /></para>
  <para style="s">येशुले भैरा सनर या माछ्योङन्या रुनेंजन आसबेलन्या</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />टुरोसला पोलन पलिईस्यु येशु सीदोनलन ताइस्यु डेकापोलिस<note caller="+" style="f"><char style="fr" closed="false">7:31 </char><char style="ft" closed="false">देकापोलिस=१०सहर बराबरला पो</char></note> सहरला सान्ढल खार्लन ताइस्यु गालील समुन्दर हिनौ। <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />रुयाङै नङं तोलोअ भैरा सनर तोलोअ माछ्योङन्या वाला रुनेंजन येशु ल्योङ राहोनौ, ओटन ओयाङै नकानेल यर्त कुई नाएस्योवनेते, लेस्यु ओलजन बिन्ति रांढोव। <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />येशुले नकानेजन हुललन अलक्कै पोल लाङस्यु भैरालं नांल कुईसैले आछुउ ओटन ओलं छिन्क माछ्योङन्या वालाल ल्हेल ठिल्स्यु आछुउ। <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />ओटन नमदेए खिमस्यु ल्होन्या सअ हिनस्यु नाजन आढोव, “इफ्फाता,”<note caller="+" style="f"><char style="fr" closed="false">7:34 </char><char style="ft" closed="false">इफ्फाता=फएसिन्ते=आरामि भासा</char></note> इकाल अर्थ “फएसिन्ते।” <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />ओटन नवाए बेलाई नकाल ना थहौ, ओटन नकाल ल्हेल बन्दन पलाअसिऊ, ओटन नका फत्कारस्यु छ्योङौ तअसिऊ। <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />“तब येशुले ऐलेऊ, ईका काङ्काईजन तापानस्योचिनर” ओमनलेस्यु येशुले नकानेजन आठाकौने। तर ओले ज्वाए तापान्चिन ऐआढोवने, जन भ्याई प्रचार ढाऔ तअसिऊने। <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />रुयाङ भ्याई अचम्म ताइवाङ, ओटन पानौ तअसिवाङ, “इकाले जो आढोव चान्याई आढोव, ओटन नाले भैराजन थएन्या सनर माछ्योङन्याजन छ्योङन्या सक्ति आयोवने।”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">येशुले चार हजारजन आयांइवाङ</para>
  <para style="r">
    <ref loc="MAT 15:29-39">मत्ती १५:२९-३९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />नका दिनल फरि तोलोअ घिन्या हुल दुउसिवाङ, तर नकाङसं ज्यान्या जन्तु नैज मालेव। तब येशुले आ सिइयाङजन आल्योङ खुल्स्यु ऐआढोवाङ, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“ङाजन ईका हुलल यर्त दया रांऔ, दानाङभन्या इकाङ ङासकाए रालज्यान्या आछिम तिन दिन ताइदा, ओटन इकाङ ल्योङ ज्यान्या नैज माल्दी। <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />ओटन यदि इकाङजन करेटै झिम परिङ्ङरकन थाकिस्यु यमलै बिहोस ताइरा, दानाङभन्या इकाङ तन काङ्का-काङ्काङ लोएङन रा:स्युलेरा।”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />आसिइयाङै ओलजन जबाक रांयोव, “आका काङ्काई मालन्या पोल आवाए भरेई काङन होनै, ओटन आकाङ वाङर?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />येशुले रांजन आगिन्वाङ, “जेल्योङ ख्वाए गोटा भरेई लिज्याऔ?” ओयाङै ऐलेवाङ, “साट पाटा भरेई” <verse eid="MRK 8:5" /><verse number="6" style="v" sid="MRK 8:6" />ओटन येशुले हुलजन नामल चुङन्या हुकुम आयोवाङ, ओटन ओले साट पाटा भरेई आकुईत हिनस्यु धन्याबाद यांस्यु आकलाटौ, ओटन आसिइयाङजन यांस्यु ऐआढोवाङ, कि नकाङल हाल नाएस्योचिरते। ओटन नकाङै रुयाङल हाल रानाएस्योवाङ। <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />ओटन सिइयाङ ल्योङ इङइङन्या ङा:स्यायाङ तचिइ ठक्क लेऊ, ओटन धन्याबाद यांस्यु ओ बै नकाङल हाल नाएन्या आग्या आयोवाङ। <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />ओटन रुयाङ कैस्यु वाङवाङ, ओटन कैस्यु रा:सयलन्या कलाएयाङ साट वटा घोनल फाङ रासिमौ। <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />नङं छ्योअछ्योअ चार हजार ल्हेपाङ लेवाङ। <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />नकाङजन बिदा यांस्यु, ओटन रां आसिइयाङसं डोङ्गाल चरिस्यु दलमनुथाला जिल्लाल हिन्वाङ।<verse eid="MRK 8:10" /></para>
  <para style="s">फरिसीयाङै अचम्मला कामयाङ रानिंन्या</para>
  <para style="r">
    <ref loc="MAT 16:1-4">मत्ती १६:१-४</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />फरिसीयाङ येशु ल्योङ रा: स्यु ओलसं छ्योङौ तअसिवाङ ओटन ओलजन अल्चिऊ नाल्ट ओलसं स्वर्गला तोलोअ अचम्मला कामयाङ नीवाङ।<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">मत्ती १२:३८</ref>; <ref loc="LUK 11:16">लूका ११:१६</ref></char></note> <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />आआत्मालन ल्होन्या सअ पलिईस्यु येशुले ऐआढोवाङ, “आका पुस्ताले दानाङ अचम्मला कामयाङ रोंकौ? मछ्यु ङा जेजन पानस्याच्या ईका पुस्ताजन नैज अचम्मला कामयाङ यांन्यामालेसिदी।”<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">मत्ती १२:३९</ref>; <ref loc="LUK 11:29">लूका ११:२९</ref></char></note> <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />ओटन ओले बिदा यांस्यु डोङ्गाल चरीउ ओटन हुदिफन्ट हिनौ।<verse eid="MRK 8:13" /></para>
  <para style="s">फरिसीयाङ सनर हेरोदल सोडा</para>
  <para style="r">
    <ref loc="MAT 16:5-12">मत्ती १६:५-१२</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />येशुल सिइयाङै रा:सं भरेई होनन्या राम्योकौ, ओटन डोङ्गाल नकाङसं जम्मा तोलोअ याएज भरेई लेऊ। <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />येशुले आसिइयाङजन ऐलेस्यु चेताउनी आयोवाङ, “ब्याएचिते, जे फरिसीयाङलं सोडा सनर हेरोदल सोडातन जोगाइसिच्यो।”<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">लूका १२:१</ref></char></note><verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />नकाङ रारांल बिचार ढास्यु पानौ तअसिवाङ, गे सकाए ता भरेई माल्दी, नैताइस्युकने नाले ईका छेन छ्योङज्याऔ ताहाहोला। <verse eid="MRK 8:16" /><verse number="17" style="v" sid="MRK 8:17" />तब येशुले ओयाङल यिङला छेन सनस्यु ऐआढोवाङ, “गे सकाए भरेई माल्दी? ओमनलेस्यु दानाङ जे छ्योङज्याच्यो? नैति जे अझ बै जेमारङचिऊ? ओटन जेमाबुजिचिऊ? नैति जे यिङ जरन्या ताइस्यु लेऊ। <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />येशुले आसिइयाङजन ऐआढोवाङ, जे म्युउ लेस्यु बै दानाङ मारङच्यो? ना लेस्यु बै दानाङ माथएच्यो? नैति जे दानाङ यांका माढोच्यो?<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">यर्मिया ५:२१</ref>; <ref loc="EZK 12:2">इजकिएल १२:२</ref>; <ref loc="MRK 4:12">मर्कुस ४:१२</ref> </char></note> <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />जब ङा भरेई पास हजारल नाल्ट ङाकलाएङु, कि जे आकलाए ख्वाए घोन फाङ जेसिम्चिऊ?” नकाङै ओलजन रांढोव, “बारं घोन।”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“ओटन जब चार हजार रुयाङ नाल्ट ङा साट पाटा भरेई ङाकलाएङु, ओटन ख्वाए घोन फाङ जेढुदुचिऊ?” नकाङै ओलजन रांढोव, “साट घोन।”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />येशुले नकाङजन ऐआढोवाङ, “ओटन नैति जे अझ बै जेमाबुजिचिऊ।”<verse eid="MRK 8:21" /></para>
  <para style="s">बेथसेदालं येशुले मारङन्या रुजन आसबेलौ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />नाल छिन्ट नकाङ बेथसेदा रांवाङ, ओटन रुयाङै तोलोअ मारङन्याजन येशु ल्योङ राहोनौ, ओटन नकाजन छुते ऐलेस्यु बिन्ति रांढोव। <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />तब येशुले ना मारङन्याल कुई कोलोअस्यु नङ्गरलन बाहेर आहोनौ, ओटन नकाल म्युउल ठिल्स्यु नकाल यर्त आकुई नाएस्यु नाजन आगिनौ, “नैति नङ कोबाअ नरङनु?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />ओटन नकाले यादेए खिमस्यु ऐलेऊ, “ङा रुयाङजन ङारङ्ङु नकाङ सिङयाङ मनताइन्या रांबाज्यान्या रङज्याङा।” <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />ओटन येशुले फरि नकाल म्युउल कुई आनाटौ, ओटन नाले चान्यासं आखिमौ, ओटन सोगलै जन्तु छरलङ्गै रङौ तअसिऊ। <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />तब येशुले नकाजन ऐढास्यु झिम आपरिङौ, ईका नङ्गर भितर ताहिनन्।<verse eid="MRK 8:26" /></para>
  <para style="s">येशुल बारे पत्रुसले ऐआलन्या</para>
  <para style="r">
    <ref loc="MAT 16:13-16">मत्ती १६:१३-१६</ref>; <ref loc="LUK 9:18-21">लूका ९:१८-२१</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />येशु सनर आ सिइयाङ कैसरिया नेराका फिलिप्पीला नङ्गर देए राहिनज्याऔक, ओले यमल आसिइयाङजन ऐलेस्यु आगिन्वाङ, “रुयाङ नै रांपानौ, ङा काङ्का?” <verse eid="MRK 8:27" /><verse number="28" style="v" sid="MRK 8:28" />नकाङै जबाक रांयोव, “नकाङ तन काङ्काङै ऐलेवाङ, ‘बप्तिस्मा यांन्या यहुन्ना।’ काङ्काङै एलिया ओटन अपुर अगमबक्ताङ मध्य तोलोअ।”<note caller="-" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 6:14-15">मर्कुस ६:१४-१५</ref>; <ref loc="LUK 9:7-8">लूका ९:७-८</ref></char></note> <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />तब येशुले रांजन आगिन्वाङ, “तर जे नै जेपान्चिऊ वन, ङा काङ्का?” पत्रुसले जबाक यांस्यु येशुजन ऐआढोव “नङ ख्रीस्ट नल्‌नु।” <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />तब येशुले नकाङजन आबारेङन काङ्काईजन नैज मापानन्या आग्या आयोवाङ।<verse eid="MRK 8:30" /></para>
  <para style="s">येशुले आसिन्या भबिस्यबानी आढोव</para>
  <para style="r">
    <ref loc="MAT 16:21-28">मत्ती १६:२१-२८</ref>; <ref loc="LUK 9:22-26">लूका ९:२२-२६</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />“तब येशुले ह्युउन्या सुरु आढोव, रुल ज़ाल आबस्यक लेया, ओले दानाङ दुख वुरौ, ओटन यहूदी नेताङ, मुख्या पुजाउरोयाङ, सनर शास्त्रीयाङ ओलजन बिकामला यिङस्यु सएरा,” ओटन ना तिन दिन छिन्ट बान्चिस्यु सोया। <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />ऐलेस्यु येशुले ईका छेन छरलङ्गै आपानौ। तर ईका थएस्यु पत्रुसले ओलजन तपोईदेए लाङस्यु आसज्याकौ। <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />तर येशुले वलस्यु आ सिइयाङ लेऊदेए आखिमौ, ओटन पत्रुसजन सज्याअस्यु ऐआढोव, “ऐ सैतान, ङा सामन्दीतन लोए ताहन्ते दानाङभन्या न यिङ परमेस्वर लेऊदेए माल्दी, तर न यिङ रुयाङ लेऊदेए नजाएनु।” <verse eid="MRK 8:33" /><verse number="34" style="v" sid="MRK 8:34" />तब येशुले आसिइयाङसं हुलजन आलेऊदेए खुल्स्यु नकाङजन ऐआढोवाङ, “काङ्का रु ङाछिन्ट रारां ङप्सिकन ओले ओलजन जै, तामानिऊत्या, ओटन आक्रूस वुरस्यु ङाछिन्ट ग्यालागित्या।<note caller="-" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">मत्ती १०:३८</ref>; <ref loc="LUK 14:27">लूका १४:२७</ref>; <ref loc="JHN 6:68-69">यहुन्ना ६:६८-६९</ref>; <ref loc="JHN 8:34">८:३४</ref> </char></note> <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />दानाङभन्या जोले आपरान जोगाहौ रोंकौ नकाले ना गवाइवा, तर जोले ङामि सनर चान्याथाईल नाल्ट आपरान गवाहौ, ना ओले बचाइवा।<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती १०:३९</ref>; <ref loc="LUK 17:33">लूका १७:३३</ref>; <ref loc="JHN 12:25">यहुन्ना १२:२५</ref></char></note> <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />दानाङभन्या रुले सोगलै जगत डोटौकन बै आपरान गवाहौ कन ओलजन नै फाइदा ताहौका? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />अथाबा रुले आपरानल पोत नैति यांऔ आढुदुऊका, <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />यदि जो काङ्काईबै ईका ब्यबिचारी पापी पुस्ताङलं खार्ल ङा सनर ङा छेन त जो लाजह, रुल ज़ा बै आबौल महिमा त पबित्र दुतयाङसं रांन्या बेलाक नकाङजन रङस्यु लाजहा।”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />ओटन येशुले नकाङजन ऐआढोवाङ “ङा मछ्यु, जेजन ऐढाच्या, इल ज्वाए च्याङज्यावाङ, इकाङ तन काङ्का-काङ्का ऐटाइन्या लेरा कि, जोले परमेस्वरलं राज्य सक्ति सकाए आरांज्यान्या मारङौ, तब समन सिन्याल स्वाद मादारौदी।”<verse eid="MRK 9:1" /></para>
  <para style="s">येशुल बर्न आफिरिसिन्या</para>
  <para style="r">
    <ref loc="MAT 17:1-13">मत्ती १७:१-१३</ref>; <ref loc="LUK 9:28-36">लूका ९:२८-३६</ref></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />नकाल छ दिन छिन्ट येशुले पत्रुस, याकूब सनर यहुन्नाजन हिनस्यु तोलोअ झेनन्या डान्डाल ओलसं आलाङौने। नङं ओयाङ रांबाठए लिज्यावाङ, ओटन नकाङल हार्मै येशुल बर्न फिरिसिऊ।<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">२पत्रूस १:१७-१८</ref> </char></note> <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />ओटन नकाल क्वा आवाए भ्याई तरवर ताहौ, कि पिरथ्बील काङ्काई बै धोबीले क्वाजन ऐलेस्यु चेईस्यु पालन्या माजाएदुउडी। <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />तब नका आसिइयाङै एलिया सनर मोशा ओटन येशुसं रांछ्योङज्यान्या रांरङौ। <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />पत्रुसले येशुजन ऐआढोव, “औ गुरुज्यू, गे इल गेलन्या चान्या ताहौ। गे इलै लिज्याऔ नाल्ट तिनगोटा छाप्रा जाएया, तोलोअ न नाल्ट, तोलोअ मोशाल नाल्ट ओटन तोलोअ एलियाल नाल्ट।” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />पत्रुसले नै छ्योङ्ङ ऐलेस्यु यिङौ आमाढुदुऊ, दानाङभन्या नकाङ भ्याई छ्याएस्यु लेवाङ। <verse eid="MRK 9:6" /><verse number="7" style="v" sid="MRK 9:7" />ओटन तोलोअ बादल रा:स्यु नकाङजन आथोअवाङ, ओटन बादललन तोलोअ ऐटाइन्या ग़ा थहौ, “ईका ङानिज्युन्या ङाज़ा ज्या, इकाल छेन थएचिते।”<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती ३:१७</ref>; <ref loc="MRK 1:11">मर्कुस १:११</ref>; <ref loc="LUK 3:22">लूका ३:२२</ref> </char></note> <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />ओटन नकाङै चारवरदेए रांखिमौक रा:सकाए येशु बाहेक अपुर काङ्काईजन मारङदुरा।<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />डान्डालन रालाइज्याऔ बेलाक येशुले नकाङजन ऐआढोवाङ, “जब समन रुल ज़ा सिन्याङ तन बान्चिस्यु मासोव, तब समन जो रङच्यो ना काङ्काईजन तापानस्योच्यो लेस्यु आपरिङवाङ।”<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />नकाङै ईका छेन यांका रांनाटौ, तर नकाङ रारांल छ्योङौ लागिवाङ, “सिन्याङ तन बान्चिस्यु सोन्याल अर्थ नैति रैस।” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />ओटन नकाङै ओलजन ऐलेस्यु रांगिनौ, “पहेला एलिया रांऔजै परिया, ऐलेस्यु ब्यबस्थाला शास्त्रीयाङ दानाङ ऐलेर?”<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MIC 4:5">मीका ४:५</ref>; <ref loc="MRK 11:14">मर्कुस ११:१४</ref></char></note><verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />येशुले जबाक आयोवाङ, “पबित्र शास्त्रल सरसिन्या लेया, कि एलिया मछ्यु हादेए रा:स्यु सोगल सुढारवा, तर रुल ज़ाल बारेल आका दानाङ सरसी कि नकाले भ्याई दुख डोएवा, ओटन क्याइसिन्या गनिसिया? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />तर ङा जेजन ऐढाच्या कि, एलिया ता रांदा, ओटन नकाल बारेल जो पबित्र शास्त्रल सरसिन्या अनुसार नकाङै ओलसं जोमन लेऊ राचाहिऊ, ओमन्जै लेवाङ।”<verse eid="MRK 9:13" /></para>
  <para style="s">दुस्टआत्मा लागिन्या केटाजन येशुले आसबेलन्या</para>
  <para style="r">
    <ref loc="MAT 17:14-21">मत्ती १७:१४-२१</ref>; <ref loc="LUK 9:37-43">लूका ९:३७-४३</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />जब येशु अपुर आ सिइयाङ ल्योङ आरांऔक, नकाङजन चारवरङन बअघिन्या रुयाङ हुलले रांघिरिज्यान्या सनर शास्त्रीयाङ नकाङ सकाए ताकानतोकन रालज्यान्या आरङवाङ। <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />ओटन सोगलै हुलले येशुजन रांरङौ, चोएटै भ्याईजै अचम्म रामानिऊ, ओटन चोएस्यु ओलजन धोक रांयोव। <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />येशुले सिइयाङजन आगिन्वाङ, “जे नकाङसं नै जेछ्योङज्याचिऊ?” <verse eid="MRK 9:16" /><verse number="17" style="v" sid="MRK 9:17" />हुललन तोलोअले ओलजन जबाक आयोव, “औ गुरुज्यू, ङामि ल्हेपा ज़ा जोल्योङ लाटा आत्मा लागिस्युलेऊ, नैताइस्यु ङा नल्योङ ङाहोन्ङु। <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />जब नकाले ङा ज़ाजन कोलोकौ, तब नामल पछारवा, ओटन आयांलन फुई पलिईस्यु, आह्वा ज़िङ कैवा, नका कग्रक्कै ताहा।<note caller="+" style="f"><char style="fr" closed="false">9:18 </char><char style="ft" closed="false">कग्रक्कै=कग्रक्कै </char></note> ङा न सिइयाङजन पलिइस्योचिते लेस्यु धोक ङायोङवाङ, तर नकाङै पलिटौ माढोदुरा।” <verse eid="MRK 9:18" /><verse number="19" style="v" sid="MRK 9:19" />ओटन ईका थएस्यु येशुले नकाङजन आढोवाङ, “ऐ, अबिस्वासी रुयाङ, ङा खक समन जे सकाए लिज्याङ्का? ओटन जेजन खसाअ सहिन्या? नकाजन ङा ल्योङ होन्चिते।” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />नकाङै ना केटाजन आल्योङ राहोनौ, ओटन नकाले येशुजन आरङौ चोएटै ना दुस्ट आत्माले नाजन फटेफटे जाएस्यु नकाजन नामल आपछारिउ, ओटन आयांलन फुई पलिईस्यु फुटीफुटी लेऊ तअसिऊ। <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />येशुले नकाल आबौजन आगिनौ, “खकन इकाजन ऐ ताहौ?” नकाले ऐलेऊ, “आलुल योअकन्जै, <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />इकाजन सएन्याल नाल्ट, नका दुस्ट आत्माले इकाजन खयाङ्क मील सनर खयाङ्क रील क्याइवा। तर यदि नङ कोबाअ ढाऔ ढुदुनकन, गे यर्त दया ढास्यु गेजन व्एसिन्ते।” <verse eid="MRK 9:22" /><verse number="23" style="v" sid="MRK 9:23" />येशुले नाजन ऐआढोव, “‘यदि नङ ढाऔ ढुदुनकन!’ ऐलेस्यु ईका नै नपान्नु? बिस्वास ढान्या वालाङ नाल्टता सोगलै छेन सम्भब लेया।” <verse eid="MRK 9:23" /><verse number="24" style="v" sid="MRK 9:24" />तब केटाल बौले आव्‌रकलिउसं ऐलेऊ, “ङा बिस्वास ऐढोङा, तर ङा अबिस्वासत ङाजन व्टङते।” <verse eid="MRK 9:24" /><verse number="25" style="v" sid="MRK 9:25" />तब हुल तचोएकै चोएस्यु रारांन्या आरङौ, ओटन येशुले दुस्टआत्माजन ऐलेस्यु आहप्काहौ, “ऐ, लाटा सनर भैरा आत्मा, ङा नङजन आग्या यांना, नकातन पलिईस्यु हिनन्ते, ओटन फरि खकै नकाल भितर तापसिन।” <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />ओटन ना केटाजन भ्याई जै चिचच्याइस्यु लछार पछार जाएस्यु पलिहौ, ओटन ना बालअ सिन्याङमन ताहौ, आङ समन कि भ्याउयाएले ऐलेऊ तअसिवाङ कि आका ता सिदा। <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />तर येशुले नकाल कुई कोलोअस्यु नाजन जरुक्कै आछेनौ, ओटन ना सोव। <verse eid="MRK 9:27" /><verse number="28" style="v" sid="MRK 9:28" />ओटन जब येशु नका झिमल हिनौ, तब आमि सिइयाङै आबाठएक ओलजन ऐलेस्यु रांगिनौ, “गे नकाजन दानाङ पलिटौ माढुदुई?” <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />येशुले नकाङजन ऐआढोवाङ, “ईका वाला दुस्ट आत्मा पलिटौ नाल्ट बिना बर्तसका प्रार्थनाले माढुदुचिदी।”<verse eid="MRK 9:29" /></para>
  <para style="s">येशुले नेंपाला आसिन्या बारेल आपानन्या</para>
  <para style="r">
    <ref loc="MAT 17:22-23">मत्ती १७:२२-२३</ref>; <ref loc="LUK 9:43-45">लूका ९:४३-४५</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />येशु सनर आ सिइयाङ नङंन पलिईस्यु नकाङ गालील ताइस्यु हिन्वाङ। ईका छेन काङ्काईले तासनरत्या ओलं इच्छ्या लेऊ, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />दानाङभन्या ओले आसिइयाङजन सिक्छ्या यांऔयन ढाज्याऔ। येशुले नकाङजन ऐआढोवाङ, “ङा रुल ज़ा हो रुयाङल कुईत पारिङरा ओटन रुयाङै ङाजन सएन्यालेरा, ओटन ङासिऊल तिन दिनक ङा बान्चिस्यु सोन्यालेङा।” <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />तर येशुले जो छ्योङौ, ना नकाङै माबुजिदुरा, ओटन गिनन्याल नाल्ट बै नकाङ छ्याएस्यु लेवाङ।<verse eid="MRK 9:32" /></para>
  <para style="s">सोगलैतन घिन्या काङ्का?</para>
  <para style="r">
    <ref loc="MAT 18:1-5">मत्ती १८:१-५</ref>; <ref loc="LUK 9:46-48">लूका ९:४६-४८</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />ओयाङ कफर्नहुमलं रांवाङ, ओटन झिमल रा:स्यु येशुले नकाङजन आगिन्वाङ, “जे यमल नैति छेन जेछ्योङज्याचिऊ।”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />तर नकाङ छपक्कै दिङवाङ, दानाङभन्या यमल नकाङै ईका छेन छ्योङवाङ कि “गेतन घिन्या काङ्का?”<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">लूका २२:२४</ref></char></note> <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />तब येशुले चुङस्यु, बारैं वटाजन आखुल्वाङ, ओटन नकाङजन ऐआढोवाङ, “तर यदि काङ्का रु हादेए ताहौ रोंकौकन तब ना सोगलै तन छिन्ट ताहा, सनर सोगलैल सेबक ताहौजपरिया।”<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">मत्ती २०:२६-२७</ref>; <ref loc="MAT 23:11">२३:११</ref>; <ref loc="MRK 10:43-44">मर्कुस १०:४३-४४</ref>; <ref loc="LUK 22:26">लूका २२:२६</ref></char></note> <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />ओटन तोलोअ इङन्या लुलजन खार्ल आसच्यानौ, ओटन नाजन घोनल हिनस्यु येशुले नकाङजन ऐआढोवाङ, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“जोले ईका इङन्या लुलमन काङ्का तोलोअ जन ङा मिनङन ग्रहन ढोव, नाले ङाजन ग्रहन ढोवा, ओटन जोले ङाजन ग्रहन ढोव, नकाले ङाजन माङडी, तर ङाजन परिङन्या वालाजन ग्रहन ढोवा।”<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्ती १०:४०</ref>; <ref loc="LUK 10:16">लूका १०:१६</ref>; <ref loc="JHN 13:20">यहुन्ना १३:२०</ref></char></note><verse eid="MRK 9:37" /></para>
  <para style="s">जो गे बिरोदल माले ना गेसै लेया</para>
  <para style="r">
    <ref loc="LUK 9:49-50">लूका ९:४९-५०</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />यहुन्नाले येशुजन ऐआढोव, “औ गुरुज्यू, तोलोअ रुले न मिनतन दुस्टआत्माङजन आपलिइज्यान्या गेरङयिउ, गे नकाजन नैलेव मायोदुया, दानाङभन्या ना गे बगालला रु माङडी।” <verse eid="MRK 9:38" /><verse number="39" style="v" sid="MRK 9:39" />येशुले ऐआढोवाङ, “नाजन तारुखिच्यो, दानाङभन्या जोले ङा मिनङन सक्तिला काम ढोव, छिन्ट ङा मिनङन ओचोएटै नकाले माचान्या काम माढोऊदी।” <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />दानाङभन्या जो गे बिरोदल माले, ना गे पक्छेलै लेया।<note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">मत्ती १२:३०</ref>; <ref loc="LUK 11:23">लूका ११:२३</ref> </char></note> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />ङा जेजन मछ्यु ऐढाच्या, कि जे येशुलै ज्या, ऐलेस्यु जोले जेजन त खुरी री ओव यांचिऊ नकाले पक्का आपुरस्कार गवाइन्या माल्दी।<note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">मत्ती १०:४२</ref></char></note><verse eid="MRK 9:41" /></para>
  <para style="s">अल्चिन्याजन चेताउनी</para>
  <para style="r">
    <ref loc="MAT 18:6-9">मत्ती १८:६-९</ref>; <ref loc="LUK 17:1-2">लूका १७:१-२</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“ओटन जोले ङाजन बिस्वास ढान्या वाला ईका इङन्याङ ङन तोलोअजन दुख योंव, नकाल नाल्ट ता बरु तोलोअ घिन्या लुङल चाखी नकाल ढेङत केप्स्यास्यु नाजन समुन्दरल क्याइन्याई चान्या लेया। <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />यदि नकुईले नङजन बिस्वासतं चोए यांनुकन नाजन पल्ते। नेंलोअ कुई लेस्यु बै नरगला खकै मासिन्या मील हिनौ भन्या थुत्या ताइस्यु जिबन डोएन्या न नाल्ट चान्या ज्या।<note caller="-" style="x"><char style="xo" closed="false">9:43 </char><char style="xt" closed="false"><ref loc="MAT 5:30">मत्ती ५:३०</ref> </char></note> <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />नरगल ता न लुइयाङ सिर, न मीज सी। <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />ओटन न खङले नङजन बिस्वासतं दुख यांनुकन नाजन पल्ते ओटन नेंलोअ खङ लेस्यु नरगल क्याइसिऊ भन्या ता दुन्डा ताइस्यु जिबन डोएन्या न नाल्ट चान्या ज्या। <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />नरगल न लुइयाङ सिर, न मीज सी। <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />यदि नम्युउले नङजन धोखा यांनुकन नाजन हाएस्यु क्याइते। नेंलोअ म्युउ लेस्यु बै नरगल क्याइस्यु नीऊ भन्या ता तोलोअ म्युउ सकाए परमेस्वरलं राज्यल पसिन्या न नाल्ट ठिक लेया।<note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">मत्ती ५:२९</ref> </char></note> <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />नरगल न लुइयाङ सिर, न मी जै सी।”<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">यशैया ६६:२४</ref></char></note><verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />दानाङभन्या सोगलैजन मीले चोखा जाएसिया जोमनलेस्यु बलिदानला सापिऊ चोखा जाएसिऊ। <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" />“सापिऊ चान्या ज्या, तर यदि सापिऊल ढार हिनकन फरि ना जे कैलेस्यु सापिऊढार जाएच्यो? जे-जेल सापिऊ मन न्हाए जाएस्यु नाएचिते। जे जेल सापिऊ नाएचिते, ओटन जे शान्तिसं लिज्याचिते।”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">येशुले जोरापाराङ भाअसिइ बारे आह्युउन्या</para>
  <para style="r">
    <ref loc="MAT 19:1-9">मत्ती १९:१-९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />फरि येशुले कफर्नहुमङन यहूदाला पो सनर यर्दन भईल अदिफन्ट रांऔ, ओटन रुयाङ हुल आल्योङ दुउसिवाङ, ओटन आचलन अनुसार नकाङजन सिक्छ्या यांऔ तअसिऊ। <verse eid="MRK 10:1" /><verse number="2" style="v" sid="MRK 10:2" />फरिसीयाङ आल्योङ रा:स्यु ओलजन अल्चिस्यु रांगिनौ, नैति काङ्का ल्हेपाले आमेएमाजन ब्यबस्थालं नियाम अनुसार राइन्या ठिक लेऊ? <verse eid="MRK 10:2" /><verse number="3" style="v" sid="MRK 10:3" />येशुले नकाङजन जबाक यांस्यु ऐआढोवाङ, “मोशाले जेजन नैति ढोचिते आढाचिऊ, अथाबा आग्या सरस्यु आयांचिऊ?” <verse eid="MRK 10:3" /><verse number="4" style="v" sid="MRK 10:4" />नकाङै ऐराढोव, “तोलोअ राइन्या कागस सरस्यु आमेएमाजन राहौ ढुदुवा, ऐलेस्यु मोशाले आग्या यांसिऊ नाएवा।”<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ब्यबस्था २४:१-४</ref>; <ref loc="MAT 5:31">मत्ती ५:३१</ref></char></note><verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />तर येशुले नकाङजन आढोवाङ, “चिमत्या जे यिङले गर्दा मोशाले ईका आग्या सरसिऊ आयांचिऊ। <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />पबित्र शास्त्रल सरसिन्या लेया, स्रिस्टील सुरुकन्ज परमेस्वरले नकानेजन ल्हेपा सनर मेएमा आजाटौने।<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">उत्पत्ति १:२७</ref>; <ref loc="GEN 5:2">उत्पत्ति ५:२</ref> </char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />ऐताइस्यु रुले आबौ सनर आअमाजन राइस्यु आमेएमास मिलिस्युई लिज्याया,<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="GEN 2:24">उत्पत्ति २:२४</ref></char></note> <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />ओटन ना नेंलोअ तोलोअ बुलमन्जै ताइन्या।स ऐताइस्यु आब इकाने नेंलोअ माङडी, तोलोअ जै बुल ज्या। <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />ऐताइस्यु परमेस्वरले जोजन तचोएकै आजोऱ्याहौने, नकानेजन काङ्काई रुले ताछुत्याहौनेत्या।” <verse eid="MRK 10:9" /><verse number="10" style="v" sid="MRK 10:10" />झिमल रारां पाइनाई सिइयाङै फरि ईका बारेल येशुजन रांगिनौ। <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />येशुले नकाङजन ऐआढोवाङ, “जोले आमेएमाजन राइस्यु छुट्टै सकाए ब्याहा ढोव, नकाले ओलं बिरोद त ब्यबिचार ढोवा।<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्ती ५:३२</ref>; <ref loc="1CO 7:10-11">१कोरिन्थी ७:१०-११</ref></char></note> <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />ओटन यदि आमेएमाले आयोजन राइस्यु छुट्टैसं ब्याहा ढोव कन नाले बै ब्यबिचार आढोव ज्या।”<verse eid="MRK 10:12" /></para>
  <para style="s">येशुले लुलल्याङजन आशिर्बाद आयोवाङ</para>
  <para style="r">
    <ref loc="MAT 19:13-15">मत्ती १९:१३-१५</ref>; <ref loc="LUK 18:15-17">लूका १८:१५-१७</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />ख्वाए रुयाङै इङन्या लुलल्याङजन येशुले रांयर्त आकुई नाएस्यु आशिर्बाद ग्यायौरत्या ऐलेस्यु आल्योङ राहोनौ, तर सिइयाङै नकाङजन राहप्काहौ। <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />तर ना रङस्यु येशुल रिउ उठिऊ, ओटन नकाङजन आढोवाङ, “इङन्या लुलल्याङजन ङाल्योङ रांऔ योंचिरते, नकाङजन तारुखिचिर, दानाङभन्या परमेस्वरलं राज्य ऐटाइन्याङ लै ज्या। <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />ङा जेजन मछ्यु ऐढाच्या, जोले परमेस्वरलं राज्यजन तोलोअ इङन्या बालअलेमन ग्रहन माढोव, नका खकै नका भितरलं पसिऊ माढुदुऊदी।”<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">मत्ती १८:३</ref></char></note> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />ओटन येशुले नका लुलल्याङजन घोनल हिनस्यु रांयर्त आकुई नाएस्यु आर्शिबाद आयोवाङ।<verse eid="MRK 10:16" /></para>
  <para style="s">तोलोअ धापा साहू रु सनर स्वर्गला राज्य</para>
  <para style="r">
    <ref loc="MAT 19:16-30">मत्ती १९:१६-३०</ref>; <ref loc="LUK 18:18-30">लूका १८:१८-३०</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />येशु यमल आबाज्याऔक, सामन्दी तोलोअ रु चोएस्यु रांऔ, ओटन आहाक घुन्डा टिकिस्यु नाले आगिनौ, “औ, चान्या गुरु, अनन्त जिबन डोटौ नाल्ट नै ढान्या ताहौ।” <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />येशुले नाजन ऐआढोव, “नङ दानाङ ङाजन चान्या गुरु ऐढाङ? तोलोअ याएज परमेस्वर बाहेक अपुर काङ्काई चान्या माल्दी। <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />नङ आग्याङ ता ऐसन्ना, हत्या ताढो, ब्यबिचार ताढो, ताकु, ग्वारस्यु साचीबयन तायों, जालझेल ताढो, न बौ सनर नअमाजन आदर ढोवनेते।”<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="DEU 5:20">ब्यबस्था ५:२०</ref>; <ref loc="EXO 20:12">प्रस्थान २०:१२</ref>; <ref loc="DEU 5:16">ब्यबस्था ५:१६</ref></char></note><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />ओटन नकाले येशुजन ऐआढोव, “औ गुरुज्यू, आका सोगलै ता ङा ङा धापा ङालेऊकन्जै मानिउयन ढास्यु ङारांङु हो।” <verse eid="MRK 10:20" /><verse number="21" style="v" sid="MRK 10:21" />येशुले नका यर्त नजर लाइस्यु, नकाजन प्रेम आढोव, “नङजन अझ तोलोअ छेनल कमि लेऊ। हिनन्ते ओटन नमी ज्वाए धनसम्पत लेऊ, नका सोगलै यएस्यु गरिबयाङजन योंवरते, ओटन नङजन स्वर्गला धन यांन्या लेसिया। ओटन रा:स्यु ङा छिन्ट लागिन्ते।” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />तर ईका छेनले नकाल भेसतं च्याऊऱ्याचिऊरि ताहौ, ओटन नाले दुख मानिस्यु हिनौ, दानाङभन्या नका सकाए भ्याई धन-सम्पत लेऊ। <verse eid="MRK 10:22" /><verse number="23" style="v" sid="MRK 10:23" />ओटन येशुले चारवर ब्याएस्यु आसिइयाङजन ऐआढोवाङ, “धनत भरमानिन्या साहूयाङजन परमेस्वरलं राज्यल हिनन्या ख्वाए खाव।” <verse eid="MRK 10:23" /><verse number="24" style="v" sid="MRK 10:24" />येशुले आपानन्या ईका छेनत आसिइयाङै अचम्म रामानिऊ। तर ओले नकाङजन ऐआढोवाङ, “ऐ लुलल्याङ, परमेस्वरलं राज्यल पसिन्या ख्वाए खाव। <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />साहू रुजन परमेस्वरलं राज्य भितर पसिऊ भन्या ता बरु व्पल नाईल ऊट पसिन्या सजिलो लेया।” <verse eid="MRK 10:25" /><verse number="26" style="v" sid="MRK 10:26" />येशुल आ सिइयाङ भ्याई अचम्म ताइवाङ, ओटन रारांल ऐलेवाङ, “ना ताहकन्ता काङ्का बान्चिऊ ढुदुऊ।” <verse eid="MRK 10:26" /><verse number="27" style="v" sid="MRK 10:27" />येशुले नकाङजन खिमस्यु ऐलेऊ, “रुयाङल नाल्ट ता आका अचम्मलाइ लेया, तर परमेस्वरलं नाल्ट माल्दी दानाङभन्या परमेस्वरलं नाल्ट सोगलै छेन सम्भब लेया।” <verse eid="MRK 10:27" /><verse number="28" style="v" sid="MRK 10:28" />पत्रुसले ओलजन ऐआढोव, “खिम्ते, गे सोगलै जन्तु राइस्यु, नछिन्ट लागिस्यु लेया।” <verse eid="MRK 10:28" /><verse number="29" style="v" sid="MRK 10:29" />येशुले ओमनलेऊ, “मछ्यु ङा जेजन ऐढाच्या, कि ऐटाइन्या काङ्काई माल्दी जोले ङा नाल्ट सनर चान्याथाईल होटै झिम या दाज्यूभाई या दिदीबैनाङ या आमा-बौ या लुलल्याङ ओटन येङखेए राहौ, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />ओटन आकाई बेला नाले भ्याईज डोएवा, ना सय गुना तबर झिम दाज्यू भाईयाङ, दिदीबैनाङ, आमा-बौयाङ, ज़ायाङ, सनर येङखेए ओटन नकाले ओसकाएज दुख बै भोघिवा, ओटन रांन्या वाला दिनल नकाले अनन्त जिबन डोएवा। <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />ओटन भ्याई जोयाङ हादेए लिज्यार, नकाङ छिन्ट ताइन्यालेरा, ओटन जो छिन्ट ताइज्यार, नकाङ हादेए ताइन्यालेरा।”<note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्ती २०:१६</ref>; <ref loc="MRK 13:30">मर्कुस १३:३०</ref> </char></note><verse eid="MRK 10:31" /></para>
  <para style="s">येशुले ओलं आसिन्या बारेल तिनपाला आछ्योङन्या</para>
  <para style="r">
    <ref loc="MAT 20:17-34">मत्ती २०:१७-३४</ref>; <ref loc="LUK 14:31-33">लूका १४:३१-३३</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />येशुल सिइयाङ यरुशलेम हिनन्या यमल लिज्यावाङ, ओटन येशु नकाङल हा-हा हिनज्याऔ। आ सिइयाङ अचम्मै ताइवाङ, ओटन अपुर छिन्ङन राज्यान्याङ छ्याएवाङ। तब ओले बारं आसिइयाङजन आलेऊदेए होन्सिऊ आयर्त रांन्या वाला छेन ओयाङजन आसथएवाङ। <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />येशुले आसिइयाङजन ऐआढोवाङ, “थएचिते, गे यरुशलेम सहरदेए गेहिनज्यायिउ। नङ ङाजन मुख्या पुजाउरोयाङ सनर शास्त्रीयाङ गैरयहूदीयाङल<note caller="+" style="f"><char style="fr" closed="false">10:33 </char><char style="ft" closed="false">गैरयहूदी=अबिस्वासी </char></note> कुईत जिम्मा यांन्या लेरा, ओटन नकाङै ङाजन सिन्या सजाय यांन्या लेरा। <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />नकाङै ङाजन गिलल्याहङरा, ओटन ङाजन ठिलङरा, ङाजन कोर्लाले स्वापङरा, ओटन ङाजन सतङरा। ओटन तिन दिन छिम्क ङा फरि बान्चिस्यु सोन्यालेङा।”<verse eid="MRK 10:34" /></para>
  <para style="s">याकूब सनर यहुन्नाल बिन्ति</para>
  <para style="r">
    <ref loc="MAT 20:20-28">मत्ती २०:२०-२८</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />जब्दियाल नेंलोअ आज़ाने, याकूब सनर यहुन्ना येशु ल्योङ रा:स्यु ऐलेऊने, “गुरुज्यू, घोन नङसं जो नीच्यो ना नङ घोन नाल्ट ढास्यासिन्ते ऐलेन्या घेनमि इच्छ्या लेऊ।”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />येशुले नकानेजन आगिनौने, “झेन नाल्ट ङा नै ढोङ झेन नै झेनचाहिचिनु?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />नकानेले जबाक नेंयोव, “नमी राज्यल नमहिमाला मुकुट सकाए नचुङौक, घोन घेनरोअचिऊ कि घोन तन तोलोअजन नदाइन्याङन ओटन तोलोअजन नदाबऱ्याङन चुङौ नाल्ट मन्जुरी यांसिन्ते।”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />तर येशुले नकानेजन ऐआढोवने, “झेन नै झेननीचिनु, ना झेन मासन्चिन्दी। नैति ङा जो खुरीलन ओङा ङालज्याङु, नलन झेन ओव झेनढुदुचिनु? अथाबा जो सिन्या बप्तिस्मा ङा होन्ङा ङालज्याङु, नैति झेन ना बप्तिस्मा होनौ झेनढुदुचिनु?”<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">लूका १२:५०</ref></char></note><verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />नकानेले ओलजन ऐनेढोव, “घोन ऐढुदुच्या,” येशुले नकानेजन आढोवने, “जो खुरील ङा ओङ, ना झेन बै ओचिना, ओटन जो बप्तिस्मा ङा ङाहोन्ङु। ना बप्तिस्मा झेन होन्चिना। <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />तर ङामि दाइन्या ङन सनर ङा दाबऱ्या ङन सचुनन्या ता ङा माङडी, इकाता जोल नाल्ट तयार ताइस्यु ले, ओलं नाल्ट जाई परमेस्वरले तयार जाएस्यु नाएवा।”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />ईका थएस्युकने दसगोटाई सिइयाङ याकूब सनर यहुन्ना सकाए रायिङचोव। <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" /><note caller="+" style="f"><char style="fr" closed="false">10:42 </char><char style="ft" closed="false">लूका २२:२५,२६गैरयहूदी=गैरयहूदी</char></note> ओटन येशुले नकानेजन आल्योङ खुल्स्यु ऐआढोवाङ, “जेजन थाहै लेया कि गैरयहूदीयाङयर्त शासक ढान्याङै नकाङयर्त अढिकार चलाइरा, ओटन अगवाङस पुरा अढिकार लेया। <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />जे भितरलं ऐताहौ मापरिऊ, जे तन जोले घिन्या ताइन्या यिङ ढोव, ना जेमि सेवाऱ्या ताहा।<note caller="-" style="x"><char style="xo" closed="false">10:43 </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्ती २३:११</ref>; <ref loc="MRK 9:35">मर्कुस ९:३५</ref>; <ref loc="LUK 22:26">लूका २२:२६</ref></char></note> <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />ओटन जे जोले हादेए ताइन्या यिङ ढोव, नका सोगलैल सेवाऱ्या ताइन्या लेया। <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />दानाङभन्या ङा रुयाङ ल्योङन सेवा डोएन्याल नाल्ट माङडी, तर सेवा ढान्याल नाल्ट ङारांङु हो, ओटन भ्याई रुयाङल छुटकाराल नाल्ट ङा बलिल येए पुरा जाटौ नाल्ट ङा परान ङायाराङु।”<verse eid="MRK 10:45" /></para>
  <para style="s">येशुले म्युउ मारंनन्या बारतिमैजन आसबेलन्या</para>
  <para style="r">
    <ref loc="MAT 20:29-34">मत्ती २०:२९-३४</ref>; <ref loc="LUK 18:35-43">लूका १८:३५-४३</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />येशु सनर आ सिइयाङ यरीहोल रांवाङ, ओटन रुयाङल घिन्या हुल सकाए यरीहोङन रापलिइज्याऔक तिमैल ज़ा बारतिमै, तोलोअ मारङन्या बयानीन्या यमवङल बया नीज्याव। <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />जब नकाले ओ नासरतला येशु ज्या ऐरालज्यान्या आठटौ, तब जोरसै कलिऊस्यु ऐलेऊ तअसिऊ “औ येशु, दाऊदल ज़ा, ङाजन दया ढाङते।”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />तब भ्याईले नकाजन सज्याअस्यु छपक्कै दिङन्ते रांढोव। तर नकाजन अझै जोरसं कलिकौ तअसिऊ, “औ दाऊदल ज़ा, ङाजन दया ढाङते।”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />तब येशु ठअ अदिउ ओटन ऐआढोवाङ, “नकाजन खुल्चिते।” ओटन नकाङै ना मारङन्याजन ऐलेस्यु रांखुलौ, “गाएगुइ तालेन सोन्ते येशुले नङजन खुलज्याऔ।”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />ओटन नकाले आमि बाहेऱ्या खाइटो क्याइस्यु ना जरू सोव ओटन येशुल ल्योङ रांऔ।<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />येशुले नकाजन ऐआढोव, “नङ नै नरोअनु, ङा न नाल्ट नै ढोङ? ना मारङन्या रुले ऐलेऊ, औ रब्बी, ङा रङौ ग्याडोटङत्या।”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />ओटन येशुले नकाजन ऐआढोव, “न यमल बान्ते। न बिस्वासले नङजन सबेल्दुन्वा।” ओटन ओचोएटै नकाले आरङौ ओटन यमल येशुल छिनछिन बाऔ तअसिऊ।<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">यरुशलेम सहरल येशु आरांन्या</para>
  <para style="r">
    <ref loc="MAT 21:1-11">मत्ती २१:१-११</ref>; <ref loc="LUK 19:28-40">लूका १९:२८-४०</ref>; <ref loc="JHN 12:12-19">यहुन्ना १२:१२-१९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />जब येशु सनर आ सिइयाङ यरुशलेम सहरल नेरा जैतुन डान्डाल वङल बेथफागे सनर बेथानियाला पोल रांवाङ, तब येशुले आ सिइयाङ तन नेंलोअजन ऐढास्यु आपरिङौने, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />ओटन ओयाङजन ऐआढोवाङ, “झेन सामन्दीला नङ्गरल हिन्चिन्ते ओटन झेन बाज्याऔ बाज्याऔकै आकअ समन काङ्काई रु आमाचरिन्या तोलोअ गडाहाल पुङ डोएचिना। नाजन पलाअस्यु आङ होन्चिन्ते। <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />काङ्का रुयाङै झेनजन ‘दानाङ पलाअज्याचिन?’ ऐढाचिनरकन, ‘प्रभुजन इकाल आबस्यक लेऊ, ओटन नाजन छिटैज होलस्यासिना ऐढोचिन्ते।’” <verse eid="MRK 11:3" /><verse number="4" style="v" sid="MRK 11:4" />तब नकाने हिनौने, ओटन झिमल पाखाङा झलापल लेऊक सुरसिज्यान्या गडाहाल पुङ नेंडोटौ, ओटन नकाजन पलाअङा नेंलिज्याऊक। <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />नल च्याङज्यान्याङ तन काङ्का-काङ्काङै नकानेजन रांगिनौ, “गडाहाल पुङजन दानाङ पलाअस्यु नै ढोङा झेनलेचिनु?” <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />येशुले ओनेजन जोमन आढोवने, ओनेले ओमनजै नेंढोव, ओटन नानेजन पलाकौ रांयोव। <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />नकानेले गडाहाल पुङजन येशुल ल्योङ नेंहोनौ, ओटन नें क्वा नकाल यर्त नेंनाटौ, ओटन येशु नकाल यर्त चुङौ। <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />येशुजन सम्मान ढाऔ नाल्ट तबर रुयाङै रांक्वायाङ यमल राथुङौ, ओटन अपुऱ्याङै बाङलन हाङ्गा पलस्यु स्याऊला राथुङौ। <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />ओटन ओलं हा-हा बान्या वालाङ सनर छिनछिन-छिनछिन रांन्या वालाङै ऐलेस्यु जयजयकार लेवाङ, “होसन्ना बअचान्या ना जो परमप्रभुल मिनतन रांन्याजन!<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">भजनसङ्ग्रह ११८:२५-२६</ref></char></note> <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />बअचान्या ग्याताइत्या, गे शाखा दाऊदल ना रांन्या वाला राज्य, परमधामल होसन्ना!” <verse eid="MRK 11:10" /><verse number="11" style="v" sid="MRK 11:11" />येशु यरुशलेम सहरल रा:स्यु मन्दिर भितरलं पसिऊ। ओटन ओले हुङा आङा सोगलै जन्तुदेए ब्याएबिई आढाज्याऔक कुबिला आताहौकाले, बारैं गोटा सिइयाङजन ओलसं लाङस्यु बेथानिया हिनौ।<verse eid="MRK 11:11" /></para>
  <para style="s">येशुले ड्यूजन सराप आयांन्या</para>
  <para style="r">
    <ref loc="MAT 21:12-17">मत्ती २१:१२-१७</ref>; <ref loc="LUK 19:45-47">लूका १९:४५-४७</ref>; <ref loc="JHN 2:13-16">यहुन्ना २:१३-१६</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />छिन्काछिम येशु आ सिइयाङसं बेथानियाङन राराज्याऔ बेला येशु करेव। <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />ओटन लोएतन ल्हापटा कै ल्हापटा लेन्या तोलोअ ड्यूल टुङ रङस्यु किगर्दाङ नकाल किगर्दाङ आजाए डोएसिऊसन लेन्या यिङस्यु हिनौ, तर नङं तापा पाइना येशुले ड्यूलटुङल ल्हापटायाङ बाहेक अपुर नैज माडोएदा, दानाङभन्या नकाए बेला शैन्या साहा माङडी। <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />तब येशुले ड्यूल टुङजन ऐआढोव, “आब आटनपार काङ्काईले नजाए ताज्योरत्या।” ओटन ईका आपानौ बेला आसिइयाङै राथटौ।<verse eid="MRK 11:14" /></para>
  <para style="s">येशु मन्दिरलं आहिनन्या</para>
  <para style="r">
    <ref loc="MAT 21:12-17">मत्ती २१:१२-१७</ref>; <ref loc="LUK 19:45-48">लूका १९:४५-४८</ref>; <ref loc="JHN 2:13-22">यहुन्ना २:१३-२२</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />ओटन यरुशलेम सहरल ताप्‌रा पाइनाई येशु मन्दिर भितरलं हिनौ, ओटन मन्दिरलं लङन्यावालाङ यएन्या वालाङजन पाखाल आपलिइवाङ ओटन रुप्या होनन्या यांन्या वालाङल देस्कयाङ सनर परेवा यएन्याङल चुङन्या चुन<note caller="+" style="f"><char style="fr" closed="false">11:15 </char><char style="ft" closed="false">टेबल=देस्क; </char></note> आपल्ताइस्योवाङ। <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />ओले काङ्काईजन बै नैज जन्तु मन्दिरलन लाङस्यु हिनौ मायोदुऊरा। <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />ओटन ओले सिक्छ्या आयांज्याऔक ऐलेऊ, “नैति पबित्र शास्त्रल ऐटाइन्या मासरसिज्याऔ, ङा झिमजन सोगल सङ्सारला जातियाङल नाल्ट प्रार्थनाल झिम कहलाइसिया? तर जे ता इकाजन गोएयाङ डाङ्काङल अड्डा जाएस्यु नाएच्या।”<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">यशैया ५६:७</ref>; <ref loc="JER 7:11">यर्मिया ७:११</ref>; <ref loc="LUK 19:46">लूका १९:४६</ref></char></note><verse eid="MRK 11:17" /></para>
  <para style="s">येशु आराधना झिमल हिनौ</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />ओटन मुख्या पुजाउरो सनर शास्त्रीयाङै ईका थएस्यु येशुजन कैलेस्यु नस्ट जाटै लेस्यु दाउ रोंकौ तअसिवाङ। दानाङभन्या नकाङ ओलसं छ्याएवाङ, दानाङभन्या सोगल हुल ओलं सिक्छ्यात अचम्म ताइस्यु लेवाङ। <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />ओइ आताहौ पाइना येशु सनर आ सिइयाङ यरुशलेम सहरलन बाहेर हिन्वाङ।<verse eid="MRK 11:19" /></para>
  <para style="s">राङन्या ड्यूल टुङ्ङन छेन ह्युउसिन्या</para>
  <para style="r">
    <ref loc="MAT 21:18-22">मत्ती २१:१८-२२</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />तयोअका छिम्क छकाल्या ओङंन पहेलाकाई यम ताइस्यु हिनज्यावाङ, ओयाङै नका ड्यूल टुङजन रिंनङन जै पुरै आराङज्यान्या रांरङौ। <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />ओटन पत्रुसजन हाका छिम्का छेन यांका रांऔ, ओटन नाले येशुजन आपानस्योव, “औ गुरु<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">रब्बी=गुरु </char></note>, खिम्ते नङ सराप नयांन्या ड्यूल टुङ ता राङदा रैस।”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />येशुले सिइयाङजन जबाक यांस्यु ऐआढोवाङ “परमेस्वरतं बिस्वास नाएचिते। <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />ङा जेजन मछ्यु ऐढाच्या, यदि काङ्काङै रायिङल सङ्का माढास्यु ङायिङन्या पुरा ऐताहा लेस्यु बिस्वास ढास्यु ईका डान्डाजन ‘भोइस्यु नङ समुन्दरल तेहन्ते’ ऐढोवकन, नकाल नाल्ट नैज ताइन्यालेया।<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">मत्ती १७:२०</ref>; <ref loc="1CO 13:2">१कोरिन्थी १३:२</ref></char></note> <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />ऐताइस्यु ङा जेजन ऐढाच्या, प्रार्थनात जो नीच्यो ना डोएस्यु लेच्या, ऐलेन्या बिस्वास नाएचिते, ओटन ना जेमिई ताहा। <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />जब जे प्रार्थना ढान्याल नाल्ट च्याङच्यो, तब काङ्काङै बिरोदल जेमि कोबाअ छेन लेकन छेमा नीचिते, ताकि स्वर्गल लिज्यान्या वाला जे बौले जेअपराद छेमा ग्याढोउत्या।<note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="MAT 6:14-15">मत्ती ६:१४-१५</ref></char></note> <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" /><note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">ईका बचन ग्रीक हस्तलिपिल जाई सरसिन्या लेया</char></note>तर जे छेमा माढोच्योकन स्वर्गला लिज्यान्या जे बौले बै जे अपरादयाङ छेमा ढान्यामाल्दी।”<verse eid="MRK 11:26" /></para>
  <para style="s">येशुल अधिकारल बारे गिन्</para>
  <para style="r">
    <ref loc="MAT 21:23-27">मत्ती २१:२३-२७</ref>; <ref loc="LUK 20:1-8">लूका २०:१-८</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />येशु सनर आ सिइयाङ फरि यरुशलेम सहरल रांवाङ। ओटन येशु मन्दिरलं हुदेए अदेए आबाज्याऔक मुख्या पुजाउरोयाङ, सनर शास्त्रीयाङ, ओटन आल्योङ रांवाङ। <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />नकाङै येशुजन रांगिनौ, “नङ ईका काम नै अधिकारले नढोनु? ईका काम ढाऔ नाल्ट नङजन काङ्काले अढिकार आयानु?” <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />येशुले नकाङजन ऐआढोवाङ, “ङा जेजन तोलोअ गिनच्या, ओटन जे नकाल उत्तर यिङचिते, ङा नैति अढिकारले ईका काम ङाढोङु, ना जेजन पानस्याच्या। <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />यहुन्नाल बप्तिस्मा सुरुक स्वर्गङन ताहौ, सन् रुल तरफङन ताहौ, ङाजन जबाक यांङचिते।”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />तब नकाङ रारांल ऐलेस्यु छ्योङौ तअसिवाङ, “यदि ‘स्वर्गङन’ ऐलेईकन नाले गेजन ऐढाइवा, नैताहकन यहुन्नाजन बिस्वास दानाङ माढोच्योवन। <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />ओटन यदि गे ‘रुङन’ ऐलेईकन” रुयाङलै छ्याइ लेया। दानाङभन्या सोगलै सनस्युईलेरा, यहुन्ना मछ्युकाई अगमबक्ता ज्या लेस्यु। <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />तब नकाङ येशुजन जबाक यांस्यु ऐलेवाङ, “गे मासनैदी।” येशुले नकाङजन ऐआढोवाङ, “ङा बै नै अढिकारङन ईका काम ङाढोङु, ना जेजन मापानस्याचिदी।”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">अढिया वालाङ सनर अङ्गुर बारील आहान</para>
  <para style="r">
    <ref loc="MAT 21:33-46">मत्ती २१:३३-४६</ref>; <ref loc="LUK 20:9-12">लूका २०:९-१२</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />येशुले आसिइयाङजन आहानङन ऐआढोवाङ, “तोलोअ रु ले अङ्गुरल बिरवा लाइस्यु नकाल चारवरङन बार आकरापौ, ओटन कोंलल खाल्टा आवोऊ। ओटन यिउबाइ जाएस्यु नकाले अङ्गुरल बारी काङ्का अढिया वालाङजन आयोवाङ, ओटन ओलं बाहेर प्रदेस देए लागिऊ।”<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">यशैया ५:१-२</ref></char></note> <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />बाली मीनन्या बेलाक नाले नका अढिया वालाङ्ङन तचियाए आजाएल बठा होनौ नाल्ट तोलोअ आमि सेवाऱ्याङ आपरिङौ। <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />तर नकाङै नका नोक्करजन कोलोअस्यु राटुपौ ओटन धाङ्गिल कुई रांपरिङौ। <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />फरि ना खसमले नकाङ ल्योङ तोलोअ सेवाऱ्याजन आपरिङौ, तर अढियावालाङै नकाल ङएट रातुप्‌स्योव ओटन नाल बिज्यात रांढोव। <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />खसमले फरि बै छुट्टैजन आपरिङौ, तर नकाङै ओजन बै रासटौ, ओटन अपुर तबर नोक्करयाङजन आपरिङवाङ, तर नकाङै ख्वाएजन रातुप्वाङ, ओटन ख्वाएजन रासएवाङ। <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />“आब तोलोअजाई बाङ्की लिज्याऔ नकाल आ ङानिज्युन्या ज़ा। ‘नकाङै ङाज़ाझन्टा आदर ऐढोरा’ ऐलेस्यु सोगलै आसापट नकाले ओइजन नकाङल्योङ आपरिङौ।”<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />“तर ना अढियावालाङ रारांल ऐलेवाङ, ‘ईका ता हकदार दी। रांचिते, गे इकाजन सएन्या, ओटन हक गेमिइ ताहा।’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />ओटन नकाङै नाजन कोलोअस्यु रासटौ, ओटन अङ्गुरल बारीलन बाहेर देए रांक्याहौ।” <verse eid="MRK 12:8" /><verse number="9" style="v" sid="MRK 12:9" />येशुले आसिइयाङजन आगिन्वाङ, “तब अङ्गुर बारील साहूले नै कैलेऊ? नका रांया, ओटन ना अढिया वालाङजन नस्ट जाटौरा, ओटन अङ्गुरल बारी अपुर छुट्टै अढिया वालाङजन योंवरा। <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />नैति जे पबित्रशास्त्रलं ईका बचन जेमापरीचिऊ? ‘जो लुङजन झिम जाएन्याङै बिकामला राठहऱ्याहौ नकाईज सुरल ङएटा लुङ ताहौ,<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">भजनसङ्ग्रह ११८:२२-२३</ref></char></note> <verse eid="MRK 12:10" /><verse number="11" style="v" sid="MRK 12:11" />ईका परमप्रभुङन ताहौ हो, ओटन गे नजरत ईका अचम्मलाइ लेया।’”<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="PSA 118:23">भजनसङ्ग्रह ११८:२३</ref></char></note> <verse eid="MRK 12:11" /><verse number="12" style="v" sid="MRK 12:12" />नालछिन्ट यहूदी अगवाङै येशुजन कोलोकौ रारोकौ, दानाङभन्या नकाङ सनस्यु लेवाङ कि आहान ओले ओयाङलै बिरोद त छ्योङज्याऔ ऐलेस्यु रायिङौ, नैताइस्यु ओयाङै बुजिन्याता राबुजिऊ। तर नकाङ रुयाङ हुल लेऊक राछ्याटौकाले ओलजन राइस्यु हिन्वाङ।<verse eid="MRK 12:12" /></para>
  <para style="s">तिरो फोअन्या बारेल गिन्</para>
  <para style="r">
    <ref loc="MAT 22:15-22">मत्ती २२:१५-२२</ref>; <ref loc="LUK 20:20-26">लूका २०:२०-२६</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />छिन्ट येशुजन छिन्ङन फसाहौ नाल्ट नकाङै फरिसीयाङ सनर हेरोदीयाङ तन ख्वाए रुयाङजन आल्योङ रापरिङवाङ। <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" /><note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">कैसर=रय</char></note> नकाङै रा:स्यु येशुजन रांढोव, “औ गुरुज्यू, गे ऐसन्या, नङ सत्य लेना, ओटन काङ्काईल वास्ता माढोन्दी। दानाङभन्या नङ हा खिमस्यु काम माढोन्दी, तर परमेस्वरलं सत्य यम ह्युउना। पानस्यासिन्ते कैसरजन तिरो यांन्या ठिक लेऊ, सन् मालेव, गे तिरो योईसन मायोई?” <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />येशुले नकाङल कपट सनस्यु नकाङजन आढोवाङ, “जे दानाङ ङाजन फसाहौ रोअज्याच्यो? तोलोअ चान्दील ध्याअ होनस्यु ङाजन खिमौ यिङचिते।” <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />नकाङै तोलोअ चान्दील ध्याअ राहोनौ। येशुले नकाङजन ऐआढोवाङ, “ईका सुरुप सनर मिन काङ्काल?” नकाङै ओजन ऐराढोव, “कैसरलं।” <verse eid="MRK 12:16" /><verse number="17" style="v" sid="MRK 12:17" />तब येशुले नकाङजन ऐआढोवाङ, “कैसरलं लेकन, कैसरझन्ज योंचिते, ओटन जो परमेस्वरले परमेस्वर झन्ज योंचिते।” तब नकाङै आछेन थएस्यु अचम्म ताइवाङ।<verse eid="MRK 12:17" /></para>
  <para style="s">सिन्यातन पुनरुत्थान कढाई ताह</para>
  <para style="r">
    <ref loc="MAT 22:23-33">मत्ती २२:२३-३३</ref>; <ref loc="LUK 20:27-38">लूका २०:२७-३८</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />फरि ख्वाएयाए अबिस्वासी सदुकीयाङ येशु ल्योङ रांवाङ, ओटन सिस्यु पुनरुत्थान माताइच्यो ऐलेस्यु ओलजन रांगिनौ,<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">प्रेरित २३:८</ref></char></note> <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“औ गुरुज्यू, मोशाले गेजन सरस्युई यांस्यु नाएवा, कि काङ्काङै दाज्यू बिना सन्तान सिऊ ओटन नका मेएमाजन आमिईज भाईले ब्याहा ढास्यु आदाज्यूल नाल्ट सन्तान नाएन्याई ताहा।”<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ब्यबस्था २५:५</ref></char></note> <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />“तोलोअ जाहानल साट भाई लेवाङ। ओयाङ तन जेठाले तोलोअ मेएमा ब्याहा आढोव, ओटन ना बिना सन्तान ताइस्युई सिदा। <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />आब माईला आभाईले ना मेएमाजन ब्याहा आढोव, ओटन ना बै बिना सन्तान ताइस्युई सिदा, ओटन साईलाल बै नैजै ताहौ। <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />ओटन साट जनाई भाईल सन्तान माताइदुरा। सोगल रासिऊ छिन्ट नका मेएमा बै सिदा। <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />आब सिन्याङ पुनरुत्थान राटाहौ बेला नका साट जनातन ना काङ्का वालाल मेएमा ताहौ? दानाङभन्या नकाङ साटै भाईले नकासं ब्याहा ढास्यु नाएरा।” <verse eid="MRK 12:23" /><verse number="24" style="v" sid="MRK 12:24" />येशुले नकाङजन आढोवाङ, “जे अन्टातोल जेपरिन्या नैताइस्यु माङडी का, जे न त पबित्रशास्त्रजन सनच्यो, न त परमेस्वरलं सक्तिजै सनच्यो? <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />दानाङभन्या जब नकाङ सिन्याङ ङन बान्चिस्यु सोर। तब नकाङ न त ब्याहा धोर, न त नकाङल ब्याहा ताह तर नकाङ स्वर्गला दुतयाङ मन्जै ताइरा। <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />सिन्याङ जिङदा ताइस्यु सोन्याल बारेल नैति जे मोशाल ब्यबस्थाला किटापल जेमा परिचिऊ? कि कैलेस्यु पथरक्यांल बारेङन सरसिन्या पन्डाल मोशाजन ऐआढोव, ‘ङा अब्राहामल परमेस्वर, इसहाकलं परमेस्वर सनर याकूबल परमेस्वर ज्या।’<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">प्रस्थान ३:६</ref></char></note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />परमेस्वर ता सिन्याङल परमेस्वर माङडी, तर जिङदाङल परमेस्वर हो। जे भ्याई भरमल जेपरिचिऊ।”<verse eid="MRK 12:27" /></para>
  <para style="s">सोगलै भन्या घिन्या आग्या</para>
  <para style="r">
    <ref loc="MAT 22:34-40">मत्ती २२:३४-४०</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />शास्त्रीयाङ तन तोलोअ रांऔ, ओटन नकाङ रारांल रांछ्योङज्यान्या आठटौ। येशुले रुयाङजन चान्यासै जबाक आयांज्यान्या, थएस्यु नकाले येशुजन आगिनौ, “ईका सोगल आग्याङ ङन घिन्या काङ्का हो?”<note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लूका १०:२५-२८</ref></char></note><verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />“येशुले जबाक आयोवाङ, सोगलैभन्या घिन्या आग्या ईका ज्या, ‘ऐ इस्राएल थएचिते, परमप्रभु गेमि परमेस्वर तोलोअ जै परमप्रभु ज्या।<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">ब्यबस्था ६:४-५</ref></char></note> <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />नङ परमप्रभु न परमेस्वरजन, नमी सोगलै यिङले, नमी सोगलै परानले, ओटन नमी सोगलै सक्तिले प्रेम ढोते।’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />ओटन छुट्टै आग्या आकाई ज्या, ‘नङ नमी डेराबारालाङजन नङ मन्जै प्रेम ढोवरते।’ इकातन घिन्या छुट्टै आग्या माल्दी।”<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 11:18">लेवी ११:१८</ref></char></note><verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />नका शास्त्रीले येशुजन आढोव, “औ गुरुज्यू, नङ भ्याई सत्य छ्योङना, कि परमेस्वर तोलोअ जै लेया, ओटन छुट्टै अपुर काङ्काई परमेस्वर माल्दी।<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">ब्यबस्था ४:३५</ref></char></note> <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />नैताइस्यु नङ न परमेस्वरजन सोगलै यिङले, सोगलै यादले, सोगलै बर्गतले प्रेम ढोते, ओटन डेराबारालाङजन नङमन ज प्रेम ढोते ओटन सोगलै पशु बलि सनर अपुर बलियाङतन बै भ्याई चान्या हो।”<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">होशे ६:६</ref></char></note> <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" />नकाले यिङसिस्यु जबाक आयांन्या रङस्यु येशुले नकाजन ऐआढोव, “नङ परमेस्वरलं राज्यतन लोएङ मालेन्दी।” नका बेलाकन ओलजन गिनन्या काङ्काईल हिकमत माताइदा।<verse eid="MRK 12:34" /></para>
  <para style="s">ख्रीस्ट बारेल रांगिनन्या</para>
  <para style="r">
    <ref loc="MAT 22:41-46">मत्ती २२:४१-४६</ref>; <ref loc="MAT 23:1-36">२३:१-३६</ref>; <ref loc="LUK 20:41-47">लूका २०:४१-४७</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />ओटन मन्दिरलं आह्युउज्याऔक येशुले ऐलेऊ, “ख्रीस्ट कैलेस्यु दाऊदल ज़ा ताहौ? ऐलेस्यु ब्यबस्याला शास्त्रीयाङै ऐलेवाङ? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />दानाङभन्या दाऊदले ओलजै पबित्र आत्माङन ऐलेस्यु लेया परमप्रभुले ङा प्रभुजन ऐआढोव, ‘नङ ङा दाइन्याङन चुङनते, जब समन ङा नशत्तुरयाङजन नखङ पाईटला न्युउल मानातङ।’<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजनसङ्ग्रह ११०:१</ref></char></note> <verse eid="MRK 12:36" /><verse number="37" style="v" sid="MRK 12:37" />जब दाऊदले ओलं ओलझन्जै ‘प्रभु’ ऐलेऊ, ओटन काङन ओलं आज़ा ताहौ?” ओटन नङा घिन्या हुलले ओलं बचन हेसाङस्यु राथटौ।<verse eid="MRK 12:37" /></para>
  <para style="s">येशुले शास्त्रीयाङ बिरोदत चेताउनी आयांन्या</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />ओटन येशुले सिक्छ्या आयांज्याऔक ऐलेऊ, “शास्त्रीयाङ्ङन होसियार ताइचिते नकाङ ल्होन्या क्वा क्वाएसिस्यु हुदेएअदेए डुलिन्या सनर बजारल रुयाङै धोक रायांन्या चाहिरा, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />अथाबा यहूदी आराधना झिमल घिन्या-घिन्या मान सनर भोस ज्युउल घिन्या-घिन्या मान डोएन्या निज्युरा। <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />नकाङ बिदवाङल झिम लुटिरा, तर थनन्याल नाल्ट ल्होन्या-ल्होन्या प्रार्थना ढोरा। ऐटाइन्या रुयाङै भ्याई दन्डसजाय डोएरा।”<verse eid="MRK 12:40" /></para>
  <para style="s">बिदवा मेएमाल भिटी</para>
  <para style="r">
    <ref loc="LUK 21:1-4">लूका २१:१-४</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />ओटन येशु मन्दिरलं भिटी चराइन्या बेला ओक चुङस्यु खिमज्याऊ, कि मन्दिरलं कैलेस्यु भिटी रांयोव, ओटन भ्याई साहूयाङै तबर राझोकौ। <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />ओटन तोलोअ गरिब बिदवा मेएमाले रा:स्यु ताम्बाल नेंलोअ छिनछिन्या आचराहौ। ना तपैसा बराबरला लेऊ। <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />आसिइयाङजन आल्योङ खुल्स्यु ओले नकाङजन ऐआढोवाङ, “मछ्यु ङा जेजन ऐढाच्या, भिटीलं जाल चराइन्या वालाङ तन ईका गरिब बिदवा मेएमाले सोगलैतन भ्याई आचराहौ। <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />दानाङभन्या सोगलैले रांमि धन भ्याईलन रांचराहौ, तर ईका मेएमाले अभाबङन बै जो ज्वाए आमि लेऊ, ओ सोगलै आजिबीकाईज चराइदा।”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">येशुले मन्दिर बिनाशल बारेल भबिस्यबानी</para>
  <para style="r">
    <ref loc="MAT 24:1-51">मत्ती २४:१-५१</ref>; <ref loc="LUK 2:5-36">लूका २:५-३६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />जब येशु मन्दिरलन पलिईज्या, तब ओलं सिइयाङ तन तोलोअले येशुजन ऐआढोव, “औ गुरु खिम्ते, ख्वाए घिघिन्या लुङयाङ सनर ख्वाए घिन्या झिमयाङ।” <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />येशुले नकाङजन ऐआढोवाङ, “नैति जे ईका घिघिन्या झिमयाङ जेरङचिऊ, नल तोलोअ लुङल यर्त छुट्टै लुङ मालज्यादी, तर सोगलैजन थाएन्या लेसिया।”<verse eid="MRK 13:2" /></para>
  <para style="s">दुख सनर सटावट</para>
  <para style="r">
    <ref loc="MAT 24:3-14">मत्ती २४:३-१४</ref>; <ref loc="LUK 21:7-19">लूका २१:७-१९</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />ओटन येशु मन्दिरलं प्रार्थना ढास्यु जैतुन डान्डाल सामन्दी आचुङज्याऔक, पत्रुस, याकूब, यहुन्ना सनर अन्द्रियास रांबाठए हिनस्यु ओलजन रांगिनौ, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“गेजन पानस्यासिन्ते, कि ईका घटनाङ खक ताइन्या वाला लेवाङ? ओटन ईका सोगल छेन पुरा ताइन्याल नाल्ट नैति अचम्मला कामयाङ ताइन्या लेऊ?” <verse eid="MRK 13:4" /><verse number="5" style="v" sid="MRK 13:5" />येशुले नकाङजन ऐआढोवाङ, “होससकाए लिज्याचिते, काङ्काईले जेजन ताग्वारचिरत्या। <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />तबर रुयाङ ङा मिनत ‘ङा ओइज ज्या’ ऐलेस्यु रारां, ओटन नकाङ तबर रुयाङजन ग्वारस्यु छ्योङरा। <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />जब जे यिसिन्याङ सनर खप्सिन्याङलं हल्ला थएच्यो तब ताछ्याएच्यो, ऐटाइन्या घटनाङ ताइन्या आबस्यक जै लेया। तर आखिरी दिन रांङाई लिज्याया। <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />दानाङभन्या जातिल बिरोदत जाति, सनर देसलं बिरोदत देस राज्यल बिरोदत राज्य खप्सिरा। सोगल पोल भुईचाल हिनन्यालेया, ओटन अनिकाल ताहा। ईका ता मेएमाङजन जतकाल दुख सुरु आताइरावमन ज्या।” <verse eid="MRK 13:8" /><verse number="9" style="v" sid="MRK 13:9" />“जे जेबारेल होसस लिज्याचिते, नकाङै जेजन अदालत ज्युउल लाङचिरा। जेजन आराधना झिमजिऊल टुपचिरा। ओटन हाकिमयाङ सनर रययाङल सामन्दी ङा कारनले जेजन गवाइ यांन्याल नाल्ट जेजन सच्यानन्या लेचिरा।”<note caller="-" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">मत्ती १०:१७-२०</ref>; <ref loc="LUK 12:11-12">लूका १२:११-१२</ref></char></note> <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />तर अनत्य ताइङा आलेऊ हादेए सोगलै जातियाङजन चान्याथाई प्रचार ढान्या लेसिया। <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />जब रुयाङै जेजन कोलोअस्यु लाङस्यु मुद्दा झोअस्याचिर, तब नै छ्योङन्या होला ऐलेस्यु हादेएज ताआतिच्यो। तर नका बेला जो जेजन यांसि, नकाई छ्योङचिते, दानाङभन्या छ्योङन्या वाला जे माङडी, तर पबित्र आत्माईज लेया। <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />“तोलोअ भाईले छुट्टै भाईजन सएन्याल नाल्ट सुम्पिरा, ओटन नामन जै बौले आज़ाजन। ओटन ज़ायाङै आमा बौयाङल बिरोद त च्याङन्या लेरा ओटन नकाङजन सटौ परिङरा। <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />ओटन ङा मिनल कारन जेजन सोगलैले हेलाइ ढास्यु घिनाइचिरा, तर जो छिन्ङै समन सनस्युई लिज्या नकाईजन जोगाइसिया।”<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ती १०:२२</ref></char></note><verse eid="MRK 13:13" /></para>
  <para style="s">माहा दुखल बेला</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />जब जे बिनाश जाएन्या ढरघिन्ला जन्तुजन जोङ मालेऊ परिन्या नङै आच्याङन्या रङच्या। (परीन्याले ग्याबुजिऊत्या), तब जो यहूदियाल लिज्यान्याङ डान्डा देए ग्याढोङरत्या।<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानियल ९:२७</ref>; <ref loc="DAN 11:31">११:३१</ref>; <ref loc="DAN 12:11">१२:११</ref></char></note><verse eid="MRK 13:14" /></para>
  <para style="r">
    <ref loc="LUK 17:31">लूका १७:३१</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 13:15" />झिमल मैराअ त लिज्यान्या, वान्लं तालाइत्या न त आझिमलन कोबाअ पलिइन्याल नाल्ट भितरलं पसि।<note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लूका १७:३१</ref></char></note> <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />ओटन जो खेएल लिज्या, नकाले आखाइटो चिनाङा लेस्यु झिमदेए तावलत्या। <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />तर नका दिनल थयहय, गुरभ्यानियाङ सनर नुन ओएसिज्यान्या ज़ाअमाङजन! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />नैताइस्यु परमेस्वरतं प्रार्थना ढोचिते, नका हिउदाक ताटाइत्या ऐलेस्यु। <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />तयोअ ऐटाइन्या लेया जो कि खकै मायिङसिन्या घटना ताइन्यालेया, परमेस्वरले सुरु स्रिस्टीतन आकअ समन न ऐताइस्यु ले, न त खकै ताइन्या ले।<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">दानियल १२:१</ref>; <ref loc="REV 7:14">प्रकाश ७:१४</ref></char></note> <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />यदि परमेस्वरले नका दिनयाङ आमाघटाइन्या ताहकन, काङ्काई परानी बै बान्चिऊ माढुदुऊदी, तर जोजन ओले आछेल्वाङ नकाङल गर्दा नका दिनयाङ आघटाइवाङ। <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />“नवाए बेला काङ्काङै जेजन ‘खिम्चिते, ख्रीस्ट आङं लिज्याऔ’ या ‘नङं लिज्याऔ’ ऐलेरकन जे बिस्वास ताढोच्यो। <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />दानाङभन्या ग्वारवा बिस्वासीयाङ सनर ग्वारवा अगमबक्ताङ च्याङन्या लेरा, ओटन राढुदुउ समन, परमेस्वरले आछेलन्याङजन भरमित जाटौ, नाल्ट नकाङै अचम्मला कामयाङ सनर अचम्मला कामयाङ थनन्यालेरा। <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />तर जे जोगाइस्यु लेचिते। ङा जेजन सोगलै छेन हाकन्जै पानस्याज्याच्या।”<verse eid="MRK 13:23" /></para>
  <para style="s">रुल ज़ा रांन्या</para>
  <para style="r">
    <ref loc="MAT 24:24">मत्ती २४:२४</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“तर ना दुखल बेला लाअक नम्युउ बै काईकाई चिऊन्या ताहा, ओटन ह्यावएले होएन्या मायौदी,<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">यशैया १३:१०</ref>; <ref loc="EZK 32:7">इजकिएल ३२:७</ref>; <ref loc="JOL 2:10-31">योएल २:१०-३१</ref>; <ref loc="JOL 3:15">३:१५</ref>; <ref loc="REV 6:12">प्रकाश ६:१२</ref></char></note> <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />ओटन नमतन हरवएयाङ तेइरा ओटन नमत सक्तियाङ हल्लिरा। <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />ओटन नका बेला रुयाङै रुल ज़ाजन सक्ति सनर महिमा सकाए बादलल आरांज्यान्या रङरा।<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानियल ७:१३</ref>; <ref loc="REV 1:7">प्रकाश १:७</ref></char></note> <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />तब परमेस्वरले स्वर्गदुतयाङजन परिङौरा ओटन पिरथ्बील आवङ ङन नमल आवङ समन चार दिसाङन ओलं आछेलन्या रुयाङजन दुकौरा।<verse eid="MRK 13:27" /></para>
  <para style="s">ड्यूल टुङल आहान</para>
  <para style="r">
    <ref loc="MAT 24:32-35">मत्ती २४:३२-३५</ref>; <ref loc="LUK 21:29-33">लूका २१:२९-३३</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“ड्यूल टुङतन तोलोअ आहान ह्युउसिचिते, नकाल आहाङ्गा बालअ ताइस्यु ल्हापटा पलिहौ तअसिया पाइना घाम साहा नेरा रांज्याया रैस, ऐलेस्यु जे सनन्या लेच्या। <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />ऐलेस्यु जै जे, जब ईका घटनाङ राटाइज्यान्या रङच्यो, तब ना नेराकै लेया, झलापल लेऊकै लिज्याया ऐलेस्यु सन्चिते। <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />मछ्यु ङा जेजन पानस्याच्या, जब ईका सोगल छेन ताइन्या माले तब समन ईका बेलाका पुस्ताङ सिन्या मालेरदी। <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />स्वर्ग सनर पिरथ्बी मास्युहिना, तर ङा बचन खकै मांन्यामाल्दी।”<verse eid="MRK 13:31" /></para>
  <para style="s">ना दिन ना बखत काङ्काईले मासनौदी</para>
  <para style="r">
    <ref loc="MAT 24:36">मत्ती २४:३६</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“तर नका दिन सनर नका बेलाल बारेङन काङ्काईले मासनौदी, सिरिप बौले जाई सन्वा, न त स्वर्गला दुतयाङै न ज़ा ले।<note caller="-" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">मत्ती २४:३६</ref></char></note> <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />नैताइस्यु जोगाइस्यु लेचिते, सन्सिस्यु चुङचिते, प्रार्थना ढोचिते, दानाङभन्या नका बेला खक रांन्या हो, नका जे मासन्चिदी। <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />ईका ता तोलोअ रुले आमि नोक्करयाङजन झिमला सोगल काम सनर अढिकार सकाए जिम्मा यांस्यु पाल्याङजन मारुउन्या आग्या यांस्यु परदेस देए आहिनौमन ज्या।”<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">लूका १२:३६-३८</ref></char></note> <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />“ऐताइस्यु जे बै होसस लेचिते, दानाङभन्या झिमल खसम ओईक, या आधा रिउल, या भाल्या आकोव बेला या छकाल्या, खक रांन्या हो, ना जे मासन्चिदी। <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />मानकन्ता ना ख्वाएबेला आरांऔक नकाले जेजन जेम्वाइज्यान्या डोएरिइचिवा। <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />जो ङा ऐलेङ, ना सोगलैजन पानस्याच्या, सन्सिज्याचिते।”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">येशुजन सएन्या सड्यन्त्र</para>
  <para style="r">
    <ref loc="MAT 26:1-16">मत्ती २६:१-१६</ref>; <ref loc="LUK 22:1-6">लूका २२:१-६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />इकाल नेंयोअ छिन्ट निस्तार सनर मासोदाला भरेईल पर्ब लेऊ। मुख्या पुजाउरोयाङ सनर शास्त्रीयाङ येशुजन कोलोअस्यु झुकाइस्यु सएन्या मौका रोअज्यावाङ। <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />नकाङै ऐलेवाङ, “पर्बल बेलाक माङडी, मानकन्ता रुयाङ हल्ला मच्चाईरा।”<note caller="-" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">प्रस्थान १२:१-२७</ref></char></note><verse eid="MRK 14:2" /></para>
  <para style="s">बेथानियाल येशुल अबिसेक</para>
  <para style="r">
    <ref loc="LUK 7:37-38">लूका ७:३७-३८</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />येशु बेथानियाला सिमोन कोर लागिन्याल झिमल याए ज्याव नाल्ट चुङज्याव, ओटन तोलोअ मेएमा चोखा चान्या जटामसीलं बअकरन्या अत्तर तल्किन्या लुङल शिसा हिनस्यु रांऔ, ओटन नका हिनस्यु सिऊनमन्या अत्तर येशुल ङएल तुईस्यु अबिसेक आढोव।<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">लूका ७:३७-३८</ref></char></note> <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />तर काङ्का-काङ्काङ रारिऊ उठिस्यु रारांल ऐलेऊ तअसिवाङ, “ईका तिइजन दानाङ ऐलेस्यु खेर जाएज्या? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />दानाङभन्या ईका अत्तरजन तिन सय चान्दील ध्याअ तन बै भ्याई तबरल यएस्यु गरिबयाङजन भाकौ दुदुसिया।” नैताइस्यु नकाङै नामेएमाजन रासज्याकौ। <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />तर येशुले नकाङजन ऐआढोवाङ, “राइचिते, जे इकाजन दानाङ हलाअ जाएज्याच्यो? ईका मेएमा ले ङाजन तीइ ठिइस्यु चान्या काम आढोव। <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />दानाङभन्या गरिबयाङ सदाई ज जे सकाए लिज्यारा, ओटन जोजन ज्वाए बेला इच्छ्या लागि नवाए बेला भलाई ढाऔ ढुदुच्या, तर ङा ता सदाई जे सकाए मालेङदी।<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ब्यबस्था १५:११</ref></char></note> <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />ईका मेएमाले जो ढाऔ आढुदुऊ ओइज आढोव। इकाले ङाबुलजन रींनौ हादेए अत्तरले ठिइस्यु तयार आजाएङु। <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />ङा जेजन मछ्यु ऐढाच्या, सोगल जगतल जोङ-जोङ ईका चान्याथाई प्रचार ताह, नङं ईका मेएमाले जो आढोव, इकाल याद ढान्या लेसिया।”<verse eid="MRK 14:9" /></para>
  <para style="s">यहूदाले येशुजन धोखा आयांन्या</para>
  <para style="r">
    <ref loc="MAT 26:17-25">मत्ती २६:१७-२५</ref>; <ref loc="LUK 22:7-14">लूका २२:७-१४</ref>; <ref loc="JHN 13:21-30">यहुन्ना १३:२१-३०</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />नवाए बेला बारं सिइयाङ तन तोलोअ यहूदा इस्करियोतले, येशुजन कोलोकौ परिङ्ङा लेस्यु मुख्या पुजाउरोयाङ ल्योङ हिनौ। <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />ओयाङ ईका थएस्यु हेसाङवाङ, ओटन नकाजन पैसा यांन्या बाचा रांढोव, ओटन येशुजन कैलेस्यु कोलोअन्या ऐलेस्यु नकाङै मौका रोंकौ तअसिवाङ।<verse eid="MRK 14:11" /></para>
  <para style="s">येशु सनर आसिइयाङसं निस्तार पर्बल भोस आज्यान्या</para>
  <para style="r">
    <ref loc="MAT 26:17-36">मत्ती २६:१७-३६</ref>; <ref loc="LUK 22:7-23">लूका २२:७-२३</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />बिनासोडाला भरेईल पर्बल छिम्क, जब नकाङ निस्तार-पर्बल थुमा बलि चराइराज्यावाङ, ओटन येशुल आसिइयाङै येशुजन रांगिनौ, “नमी इच्छ्या नैति लेऊ? गे काङ हिनस्यु न नाल्ट निस्तार पर्बल भोस तयार जातई?”<note caller="-" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="EXO 12:6">प्रस्थान १२:६</ref>; <ref loc="EXO 12:15">प्रस्थान १२:१५</ref></char></note><verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />ओटन येशुले आ सिइयाङ मध्य नेंलोअजन ऐलेस्यु आपरिङौने, “सहरल हिन्चिन्ते ओटन गाग्रील री छेन्स्यु लाङन्या वाला तोलोअ रुले झेनसं डोएचिन्वा, ओटन झेन ओलं छिन्ट लागिचिन्ते। <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />नका रु जो झिमल हिनौ झिमला खसमजन ऐढोचिन्ते, ‘गुरुज्यूले ऐलेऊ ङासिइयाङ सकाए निस्तार-पर्बल भोस ज्यान्याल नाल्ट, ङामि पाहुनाङ कोठा काङ लेऊ?’” <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />ओटन नकाले झेनजन सजाईस्यु तयार जाएसिन्या टङटाल्ला तोलोअ घिन्या कोठा थनस्याचिन्वा ओटन नङं जे गे नाल्ट भोस तयार जाएचिते। <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />तब ना आ सिइने सहरल पसिऊने, ओटन येशुले नेंजन आपानस्योवका मन्जै ना रु सकाए डोएसिऊने, ओटन नकाङै निस्तार पर्बल भोस तयार रांजाटौ। <verse eid="MRK 14:16" /><verse number="17" style="v" sid="MRK 14:17" />ओईका बेला येशु आमि बारं गोटा सिइयाङस रांऔ। <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />ओयाङ चुङस्यु रांज्याज्याऔ बेला येशुले ऐलेऊ, “मछ्यु ङा जेजन पानस्याच्या, जे तन ङा सकाए ज्याज्यान्या वाला तोलोअले ङाजन शत्तुरयाङल कुईत कोलोकौ परिङवा।”<note caller="-" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजनसङ्ग्रह ४१:९</ref></char></note> <verse eid="MRK 14:18" /><verse number="19" style="v" sid="MRK 14:19" />ओटन आ सिइयाङ दुखी ताइस्यु पालो पालोस ऐलेवाङ, “नैति नका ङा रों?” ऐलेस्यु गिनौ तअसिवाङ।<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />येशुले नकाङसं ऐलेऊ, “बारं गोटातन तोलोअ। जोले ङासं थालल भरेई छोएज्याऔ। <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />दानाङभन्या पबित्र शास्त्रल सरसिन्या अनुसार ङा रुल ज़ा हो, तर थयहय जोले ङाजन शत्तुरयाङ ल्योङ कोलोकौ परिङस्यु सटौ आपरिङ्ङु, ङा ख्वाए दुख डोएन्यालेङा। नका रु ता आजर्मिन्याल भन्याता आमाजर्मिन्याई जाति लेऊ।”<verse eid="MRK 14:21" /></para>
  <para style="s">प्रभु सिइयाङ सकाए भोस</para>
  <para style="r">
    <ref loc="MAT 26:26-30">मत्ती २६:२६-३०</ref>; <ref loc="LUK 22:14-20">लूका २२:१४-२०</ref>; <ref loc="1CO 11:23-25">१कोरिन्थी ११:२३-२५</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />ओयाङ रांज्याज्याऔक येशुले तोलोअ भरेई हिनस्यु, धन्याबाद आयोव, ओटन आकलाटौ ओटन आसिइयाङजन आयांज्याऔक ऐआढोवाङ, “हअ ईका ङा बुल हो।” <verse eid="MRK 14:22" /><verse number="23" style="v" sid="MRK 14:23" />ओटन खुरी हिनस्यु धन्याबाद आयांऔ छिन्ट येशुले आसिइयाङजन आयोवाङ, ओटन नकाङ नकालन सोगलैले रांओव। <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />ओटन येशुले ऐलेऊ, “ईका छार बाचाला ङा जी हो, जो पापीयाङल पाप छेमा नाल्ट बगाइङा ङालन्या छार बाचाला प्रमान हो।<note caller="-" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="EXO 24:8">प्रस्थान २४:८</ref>; <ref loc="JER 31:31-34">यर्मिया ३१:३१-३४</ref></char></note> <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />ङा जेजन मछ्यु ऐढाच्या, ङा अङ्गुरल रसङन नका दिन समन माओङदी, जब समन परमेस्वरलं राज्यल ईका छार ताइस्यु माओङ।” <verse eid="MRK 14:25" /><verse number="26" style="v" sid="MRK 14:26" />ओटन तोलोअ भजन रेएसिस्यु ओयाङ पलिईस्यु जैतुन डान्डा देए हिन्वाङ।<verse eid="MRK 14:26" /></para>
  <para style="s">येशुले पत्रुसलं भबिस्यबानी आढान्या</para>
  <para style="r">
    <ref loc="MAT 26:31-35">मत्ती २६:३१-३५</ref>; <ref loc="LUK 22:31-34">लूका २२:३१-३४</ref>; <ref loc="JHN 13:36-38">यहुन्ना १३:३६-३८</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />येशुले आसिइयाङजन ऐआढोवाङ, “जे सोगलै छिन्देए हतिच्या, दानाङभन्या ऐटाइन्या पबित्र शास्त्रल सरसिन्या लेऊ, ङा ग्वालाजन सतङरा, ओटन भेडाङ हुदेए अदेए तत्तर बित्तर ताइन्यालेरा।<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">जकरिया १३:७</ref></char></note> <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />तर ङा जिङदा ताइस्यु सोङा पाइना जे हादेए जै ङा गालील हिन्ङा।”<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ती २८:१६</ref></char></note> <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />पत्रुसले येशुजन ऐआढोव, “यदि सोगलैले नङजन राहन्‌रकन बै ङा नङजन राइन्या मालेन्दी।”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />तब येशुले नकाजन ऐआढोव, “मछ्यु जै, ङा नङजन ऐढाना, आछिमकाई रिउल भाल्या नेंपाला आकोव हादेए नङ ङाजन तिन पाला मासहङदी<note caller="+" style="f"><char style="fr" closed="false">14:30 </char><char style="ft" closed="false">इन्कार=माभनन्या</char></note> ऐलेना।”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />तर पत्रुसले येशुजन ऐआढोव, “ङा नङजन मासहन्दी खकै मालेङदी, बरु नङ सकाए ङा सिऊज परिकन बै ङा नङजन राइन्या मालेङदी।” ओटन नकाङ सोगलैले नैज लेवाङ।<verse eid="MRK 14:31" /></para>
  <para style="s">गेतसमनील येशुल प्रार्थना</para>
  <para style="r">
    <ref loc="MAT 26:36-46">मत्ती २६:३६-४६</ref>; <ref loc="LUK 22:39-46">लूका २२:३९-४६</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />नकाल छिन्ट ओयाङ गेतसमनी मिनला पोल हिन्वाङ, ओटन येशुले आसिइयाङजन ऐआढोवाङ, “ङा प्रार्थना ङाढाज्याव समन जे इङै चुङज्याचिते।” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />तब येशुले पत्रुस, याकूब सनर यहुन्नाजन ओलसं आलाङवाङ ओटन भ्याईजै अन्टातोल सनर म्यालमेल ताहौ। <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />ओटन येशुले नकाङजन आढोवाङ, “ङा आतिइले भ्याई सिऊसमन्जै हलाअ ताइदुङा, जे इलै चुङज्याचिते ओटन सन्सिज्याच्यो।” <verse eid="MRK 14:34" /><verse number="35" style="v" sid="MRK 14:35" />तचिइ हुदिन्क हिनस्यु ओले नामल गोम लेस्यु प्रार्थना ढाऔ तअसिऊ, यदि ताहौ ढुदुउकन आका समाय ओल्योङन ग्याटलित्या ऐलेस्यु प्रार्थना आढोव। <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />ओटन येशुले ऐलेऊ, “बौ<note caller="+" style="f"><char style="fr" closed="false">14:36 </char><char style="ft" closed="false">बौ</char></note> न नाल्ट सोगलै छेन सम्भब लेया। ईका दुखल खुरी ङाल्योङन हताइस्याङते। तब बै ङा इच्छ्याङन माङडी, न इच्छ्याङन ग्याताइत्या।”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />येशु फरि आरांऔक नकाङजन रारुउज्यान्या आडोएरिइवाङ ओटन पत्रुसजन ऐआढोव, “सिमोन, नैति नङ नरुउज्यानु? नैति तघन्टा बै सनसिज्याऔ नमाढुदुनु? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />सन्सिस्यु लिज्याचिते, ओटन प्रार्थना ढोचिते, ओटन जे परिक्छ्याल तापरिच्यो। आत्मा ता तयार लेया, तर बुल कमजोर लेया।”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />येशु फरि हिनौ ओटन नाइ छेन दोहोऱ्याइस्यु प्रार्थना आढोव। <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />येशु फरि आरांऔक आसिइयाङजन रारुउज्यान्याई आडोएवाङ, दानाङभन्या नकाङल मिऊरुइले झुलामाला ताइवाङ, ओटन नकाङ येशुजन नै जबाक यांन्या हो। ना रा:मासनौ।<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />येशु फरि बै तिन पालाक रांऔ, ओटन आसिइयाङजन ऐआढोवाङ, “नैति जे अझ बै जेरुउज्याचिऊ ओटन जे नानसिज्याचिऊ? आब बेला ताइदा खिम्चिते, रुल ज़ा पापीयाङल कुई त कोलोअसिन्या वाला लेया। <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />सोचिते, बाचिते। ब्याएचिते, ङाजन कोलोअन्या वाला नेराकै ताप्‌रा:स्यु लिज्याया।”<verse eid="MRK 14:42" /></para>
  <para style="s">येशुजन राकोलोअन्या</para>
  <para style="r">
    <ref loc="MAT 26:46-56">मत्ती २६:४६-५६</ref>; <ref loc="LUK 22:47-53">लूका २२:४७-५३</ref>; <ref loc="JHN 18:3-11">यहुन्ना १८:३-११</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />येशु आछ्योङज्याऔक बारं सिइयाङ मध्यलन तोलोअ यहूदा मिनला आ सिइ ओचोएटै ओक रंनौ। ओटन मुख्या पुजाउरोयाङ, सनर शास्त्रीयाङ जनताङल नेताङै रापरिङन्या तबगाल तरवाल सनर झुई हिनस्यु ओलसं नल रांवाङ। <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />येशुजन कोलोकौ परिङन्या बिमानिले ऐटाइन्या तोलोअ सयान यांस्यु आनाएवाङ, “जोजन ङा, म्वाहङ नका रु ओइ ज्या, नकाजन कोलोअचिते ओटन खार्ल झोअस्यु लाङचिते।”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />ओटन सोझै येशु ल्योङ हिनस्यु यहूदाले ऐलेऊ, “औ बौ,” ऐलेस्यु येशुजन आम्वाहौ। <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />तब नकाङै येशुजन राकोलोकौ ओटन रांपोकौ। <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />नल नेराक च्याङन्याङ तन तोलोअ वालाले तरवाल सेलस्यु प्रधान पुजाउरोल सेवाऱ्याजन आराइस्योव, ओटन नकाल ना च्वाट्टै आपलस्यौ। <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />येशुले नकाङजन आढोवाङ, “नैति जे ङाजन तोलोअ गोएजन कोलोअन्यामन तरवाल सनर झुई समेत होनस्यु जेरांचिऊ? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />दिनकाईज मन्दिरलं ङाह्युउज्याऊक ङा जे सकाए जै लिज्याङा, ओटन जे ङाजन मापोअदुङच्या। तर पबित्रशास्त्रलं बचन पुरा ग्याताइत्या।”<note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">लूका १९:४७</ref>; <ref loc="LUK 21:37">२१:३७</ref></char></note> <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />ओटन सोगलै सिइयाङ येशुजन राइस्यु ढोङस्यु हिन्दुरा।<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />ओटन आकलाङजन तोलोअ सुतिल क्वाले याएज मलिङसिन्या तोलोअ धापा ओलं छिन्ट लागिऊ, नकाङै ना धापाजन राकोलोकौ। <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />तर नकाले आखाइटो बनाएस्यु क्वा मालन्या ढोङौ।<verse eid="MRK 14:52" /></para>
  <para style="s">येशु महासभालं लेऊल</para>
  <para style="r">
    <ref loc="MAT 26:57-68">मत्ती २६:५७-६८</ref>; <ref loc="LUK 22:66-71">लूका २२:६६-७१</ref>; <ref loc="JHN 18:13-14">यहुन्ना १८:१३-१४</ref>; <ref loc="JHN 19:24">१९:२४</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />तब येशुजन प्रधान पुजाउरो ल्योङ रालाङौ। ओटन नङं सोगलै मुख्या पुजाउरोयाङ, सोझा अगवाङ सनर शास्त्रीयाङ दुउसिस्यु लेवाङ। <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />पत्रुस लोएङन मुख्या पुजाउरोल ठरबाङ भितर येशुल छिनछिन लागिऊ, ओटन नङ सिपाइयाङ सकाए चुङस्यु नका मी मुनसिऊ तअसिऊ। <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />आब मुख्या पुजाउरो सनर सोगलै महासभाले येशुजन सएन्याल नाल्ट ओलं बिरोदत दोसलं प्रमान रारोकौ, तर नैज माडोएदुरा। <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />भ्याई रुयाङै येशुल बिरोदत ग्वारस्यु बयन रांयोव। तर नकाङै रायांन्या बयनले मामिलिदा। <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />काङ्का-काङ्काङ सोस्यु येशुल बिरोदत ऐलेस्यु ग्वारस्यु बयन रांयोव, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“इकाले आपानन्या गे गेथएयिउ, ‘रुल कुईले जाएसिन्या आका मन्दिर ङा थाएङा, ओटन ङा छुट्टै मन्दिर तिन दिनक बिना कुतै निब्जाइङा।’”<note caller="-" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">यहुन्ना २:१९</ref></char></note> <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />तर नकाङल बयन तोलोअ जै माताइदा। <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />तब प्रधान पुजाउरोयाङै खार्ल च्याङस्यु येशुजन रांगिनौ, “नङ दानाङ नैज छेन माहोलन? खिम्ते इकाङ न बिरोदल बयन रायांन्या नैति?” <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />तर येशु छपक्कै दिङज्याऔ, ओटन नैज बै जबाक मायोदुऊरा। फरि प्रधान पुजाउरोले येशुजन आगिनौ, “नैति नङ परमधन्यल ज़ा ख्रीस्ट रों?” <verse eid="MRK 14:61" /><verse number="62" style="v" sid="MRK 14:62" />येशुले जबाक आयोव, “औ ङाई ज्या, ओटन जे रुल ज़ाजन सर्बसक्तिमानल दाइन्या घोनत आचुङज्यान्या सनर नमता बादलयाङ सकाए आरांज्यान्या रङच्या।”<note caller="-" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानियल ७:१३</ref></char></note> <verse eid="MRK 14:62" /><verse number="63" style="v" sid="MRK 14:63" />तब प्रधान पुजाउरोले आक्वा चेईस्यु ऐलेऊ, “आब गेजन अपुर साचीयाङ नैकाम परिऊका? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />जे ईस्वर बाए ता थएदुच्या। जेमि नै बिचार लेऊ?” ओटन नकाङ सोगलैले येशुजन सएन्या सजायल दवलला राठहऱ्याहौ।<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवी २४:१६</ref></char></note> <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />नकाजन काङ्का-काङ्काङै रांठिलौ, ओटन आहां कप्स्यास्यु लप्टा राइस्यास्यु ऐराढोव “पान्ते काङ्काले आटुप्नू” ओलं छिन्ट पाल्याङै ओलजन राजिम्मात हिनस्यु मुट्किले राटुपौ।<verse eid="MRK 14:65" /></para>
  <para style="s">पत्रुसले येशुजन आराइन्या</para>
  <para style="r">
    <ref loc="MAT 26:69-75">मत्ती २६:६९-७५</ref>; <ref loc="LUK 22:56-62">लूका २२:५६-६२</ref>; <ref loc="JHN 18:15-18">यहुन्ना १८:१५-१८</ref>,<ref loc="JHN 18:25-27">२५-२७</ref></para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />पत्रुस वान्ल ठरबाङल लिज्याऔ, प्रधान पुजाउरोल नोक्कर्नियाङ तन तोलोअ नङ रांऔ, <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />ओटन पत्रुसजन मी आमुन्सिज्यान्या रङस्यु नकाजन एकसोऱ्या ब्याएस्यु ऐलेऊ, “नङ बै येशु नासरी सकाए नलिज्यानु ज्या।” <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />तर नकाले ऐलेस्यु माभनौ, “नङ नै नपानज्यानु न सनङ न बुजिङ।” ओटन नका पाखाङन्ता मुल झलाप देए हिनौ। ओटन भाल्या कोव। <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />नल च्याङज्यान्या रुयाङजन नोक्कर्निले ऐआढोवाङ, “ईका ता नकाङ मध्यला तोलोअ हो।” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />तर पत्रुसले फरि माभनौ, ओटन तचिइ छिन्ठक्क पत्रुसले नेंपाला आराहौ, तर तचिइ छिन्ट ओलं जिऊला च्याङज्यान्या रुयाङै फरि रांगिनौ, “नङ पक्का नकाङ भितरला तोलोअ ज्या, दानाङभन्या नङ गालीली बै ज्या।” <verse eid="MRK 14:70" /><verse number="71" style="v" sid="MRK 14:71" />ओटन पत्रुसले किऱ्या ज्यास्यु ऐलेऊ तअसिऊ, “जोल बारेङन जे जेपानज्याचिऊ, नका रुजन ङा मासहङदी।” <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />ओटन ओचोएटै नेंपाला भाल्या कोव, ओटन येशुले ऐआढान्या छेन पत्रुसले आयिङौ, “भाल्या नेंपाला आकोव हादेए नङ ङाजन तिन पाला राहङना।” ओटन ना छेन यिङसिस्यु नका धरधर व्‌रौ।<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">पिलातसले येशुजन आगिनौ</para>
  <para style="r">
    <ref loc="MAT 27:1">मत्ती २७:१</ref>; <ref loc="MAT 2:11-14">२:११-१४</ref>; <ref loc="LUK 23:2-5">लूका २३:२-५</ref>; <ref loc="JHN 18:28-38">यहुन्ना १८:२८-३८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />छकाल्या आताहौ चोएटै मुख्या पुजाउरोयाङ, सोझा अगवाङ शास्त्रीयाङ ओटन सोगलै महासभाले रारां सल्ला ढास्यु येशुजन पोअस्यु रालाङौ, ओटन पिलातसजन जिम्मा रांयोव। <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />पिलातसले येशुजन आगिनौ, “नैति नङ यहूदीयाङल रय रों?” ओले नकाजन जबाक आयोव, “नङजै रय ऐढाज्याङना।” <verse eid="MRK 15:2" /><verse number="3" style="v" sid="MRK 15:3" />मुख्या पुजाउरोयाङै येशुजन भ्याई छिन्ङन दोस रांलाहौ। <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />पिलातसले ओलजन फरि बै आगिनौ, “नैति नङ सकाए नैज जबाक मालेव? ब्याएते, न बिरोद त नकाङै ख्वाए छिन्ङन दोस रालाइज्यानु।” <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />तर येशुले फरि नैज जबाक मायोडा, आवाए समन कि पिलातस बै हलाअ ताइदा।<verse eid="MRK 15:5" /></para>
  <para style="s">येशुजन सएन्या सजाय रायांन्या</para>
  <para style="r">
    <ref loc="MAT 27:15-26">मत्ती २७:१५-२६</ref>; <ref loc="LUK 23:13-25">लूका २३:१३-२५</ref>; <ref loc="JHN 18:39">यहुन्ना १८:३९</ref>; <ref loc="JHN 19:16">१९:१६</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />ओ बेला पिलातसल चलन अनुसार बर्सकं त पाला निस्तार<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">निस्तार पर्ब=अन आमीनौका पर्ब</char></note>-पर्बल बेलाक पिलातसले रुयाङल निई अनुसार तोलोअ कैदीजन ओयाङल नाल्ट राइस्योउरा। <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />बिद्रोहल बेलाक हत्या ढान्या बिरोदीयाङ कैदल लेवाङ। जोयाङ तन बारब्बा मिनला तोलोअ रु नल लिज्याऔ। <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />रुयाङल हुल नङ रा:स्यु, पिलातसजन गे चलन अनुसार गे नाल्ट ढास्यासिन ऐलेस्यु बिन्ति ढाऔ तअसिवाङ। <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />पिलातसले ऐलेस्यु नकाङजन आगिन्वाङ, “नैति ङा जे नाल्ट यहूदीयाङल रयजन ग्याराहौत्या लेन्या जेचाहिचिऊ रों?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />दानाङभन्या रिईल गर्दा मुख्या पुजाउरोयाङै येशुजन कोलोकौ रांपरिङौ ज्या, ऐलेन्या पिलातसले चान्यासै सनस्युआनाटौ। <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />मुख्या पुजाउरोयाङै येशुजन माङडी, तर बारब्बाजन गे नाल्ट राइते ऐलेस्यु रुयाङल हुलजन रामच्चाहौ। <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />पिलातसले फरि ओयाङजन आगिन्वाङ, “नैताहकन जोजन जे यहूदीयाङल रय ऐजेल्चिऊ, तब ओजन ङा कै ढोङवन?” <verse eid="MRK 15:12" /><verse number="13" style="v" sid="MRK 15:13" />नकाङ फरि कलिऊस्यु ऐलेवाङ, “नकाजन क्रूसतं केपचिते।” <verse eid="MRK 15:13" /><verse number="14" style="v" sid="MRK 15:14" />पिलातसले ओयाङजन ऐआढोवाङ, “दानाङ? नकाले नैति अपराद आढोव का?” ओटन नकाङ झन्जै जोरसै कलिऊस्यु ऐलेवाङ, “नकाजन क्रूसतं केपचिते।” <verse eid="MRK 15:14" /><verse number="15" style="v" sid="MRK 15:15" />ओटन पिलातसले हुलजन सन्तुस्टी जाएन्या इच्छ्याले नकाङल नाल्ट बारब्बाजन आराहौ, ओटन येशुजन कोर्ला लाइस्यु क्रूसतं केपौ आपरिङवाङ।<verse eid="MRK 15:15" /></para>
  <para style="s">सिपाइयाङै येशुल अपमान राढान्या</para>
  <para style="r">
    <ref loc="MAT 27:27-31">मत्ती २७:२७-३१</ref>; <ref loc="JHN 19:2-3">यहुन्ना १९:२-३</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />सिपाइयाङै येशुजन राजपालल दरबारल ठरबाङ भितरलं राहोनौ, जोजन प्रेटोरियन बै ऐढोरा, ओटन नकाङै पुरै सेनाङल बगालजन बै रांखुल्वाङ। <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />ओटन नका रुयाङै येशुजन <note caller="+" style="f"><char style="fr" closed="false">15:17 </char><char style="ft" closed="false">ढुङल्याइन्या=ढुङल्याइन्या</char></note>ढुङल्याइन्या रङला क्वा रा:क्वाटौ, ओटन ज़ुईज़ु लेन्या मुकुट लएस्यु आङएत रा:जाटौ, <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />ओटन “यहूदीयाङल रयजन जय” ओमनलेऊयन नकाङै गिलल्याइस्यु, येशुजन तबर जुगजुगल नाल्ट लिज्यान्ते लेस्यु ढोक रा:योव। <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />ओटन नकाङै येशुजन ओलं ङएट सराले स्वापौयन ओलजन रा:ठिलौ, ओटन घुन्डा टिकिस्यु ओलजन ढोक रा:योव। <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />ओटन येशुजन रा:गिलल्याहौ छिन्ट नकाङै ढुङल्याइन्या क्वा रा:फिरस्यौ, ओटन आक्वाईज रा:क्वाटौ। ओलं छिन्ट नकाङै येशुजन क्रूसतं केपौ नाल्ट पाखाङ रा:लाङौ।<verse eid="MRK 15:20" /></para>
  <para style="s">येशुजन क्रूसतं राकेपौ</para>
  <para style="r">
    <ref loc="MAT 27:32-44">मत्ती २७:३२-४४</ref>; <ref loc="LUK 23:33-43">लूका २३:३३-४३</ref>; <ref loc="JHN 19:16-27">यहुन्ना १९:१६-२७</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />सिमोन जो अलेक्जेन्डर सनर रुफसल बौ हो, ओटन नका कुरेनील लिज्यान्या वाला हो, जो नङ्गरलन सहरदेए आहिनज्याऔक सेनाङै नाजन जबरजस्ति कोलोअस्यु येशुल क्रूस वुरौ रांपरिङौ।<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">रोमी १६:१३</ref></char></note> <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />नाल छिन्ट नकाङै येशुजन गलगथाला पोल राहोनौ गलगथाल मतलब खप्परल पो। <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />ओटन नकाङै येशुजन आस्युउनम बराएसिन्या अङ्गुर रस रांयोव। तर येशुले ना ग्रहन माढोदा। <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />ओयाङै येशुजन क्रूसतं राकेपौ। ओटन काङ्काले आक्वाल कैताइन्या बठा डोएन्या लेस्यु ना पक्का जाएन्याल नाल्ट चिठ्ठा झोअस्यु ओलं क्वायाङ राभाकौ।<note caller="-" style="x"><char style="xo" closed="false">15:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">भजनसङ्ग्रह २२:१८</ref></char></note> <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />नकाङै येशुजन क्रूसतं राकेपौ बेला छकाल्याका नौ बजिस्यु लेऊ। <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />ओलं दोस पत्रल “यहूदीयाङल रय” ओमनलेन्या सरसिन्या लेऊ। <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />नकाङै येशु सकाए नेंलोअ गोएनेजन बै क्रूसतं राकेपौ ओटन तोलोअजन येशुल दाइन्याङन, छुट्टैजन आदाबऱ्याङन।<note caller="-" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="ISA 53:12">यशैया ५३:१२</ref></char></note> <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />पबित्र शास्त्रल बचन ऐलेस्यु पुरा ताहौ, “येशु अपरादियाङ बराबर गनिसिऊ।”<verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />नकन हिनन्या रुयाङै राढेङ हल्लाइस्यु ऐलेस्यु येशुजन रांगिलल्याहौ, “ओ! स्वाई मन्दिर थएस्यु तिन दिनक निब्जाइन्या वाला,<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">भजनसङ्ग्रह २२:७</ref>; <ref loc="PSA 109:25">१०९:२५</ref>; <ref loc="MRK 14:58">मर्कुस १४:५८</ref>; <ref loc="JHN 2:19">यहुन्ना २:१९</ref></char></note> <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />क्रूसतन लांइस्यु रांन्ते, ओटन नङ नङझन्जै जोगाइते।” <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />नैलेस्युजै मुख्या पुजाउरोयाङ बै शास्त्रीयाङस ऐलेस्यु रारांल येशुल गिलल्याइन्या रांढोव, “इकाले अपुऱ्याङजन आबचाइवाङ, तर ओलं ओलझन्जै जोगाहौ माढुदुडा। <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />नङ मछ्यु ख्रीस्ट, इस्राएलला रय ताहकन, आब क्रूसतन लांइस्यु रांन्ते ओटन नङजन रङस्यु गे बिस्वास ढोया।” ओलसं क्रूसतं केप्सिज्यान्यानेले बै ओलजन नेंगिलल्याहौ।<verse eid="MRK 15:32" /></para>
  <para style="s">येशु आसिन्या</para>
  <para style="r">
    <ref loc="MAT 26:45-56">मत्ती २६:४५-५६</ref>; <ref loc="LUK 23:44-49">लूका २३:४४-४९</ref>; <ref loc="JHN 19:28-30">यहुन्ना १९:२८-३०</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />बारं बजेतन तिन बजे समन सोगलै देसजन च्युऊन्याले आकपौ। <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />तिन बजेदेए ऐलेस्यु येशु घिन्या ग़ाले कलिकौ, “इलोई इलोई, लामा सबखथनी?” जोल अर्थ हो, “औ ङा परमेस्वर, औ ङा परमेस्वर, नङ ङाजन दानाङ राहङ?”<note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">भजनसङ्ग्रह २२:१</ref></char></note><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />नावङ ज्युउल च्याङज्यान्या वालाङ तन काङ्का-काङ्का रुयाङै ईका थएस्यु ऐलेवाङ, “खिम्चिते, इकाले एलियाजन खुलज्याऔ।” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />ओटन तोलोअले चोएस्यु हिनस्यु तोलोअ रुवाल अङ्गुरल रस पुरै आबुदाहौ ओटन सरात<note caller="+" style="f"><char style="fr" closed="false">15:36 </char><char style="ft" closed="false">स्पन्ज=रुवा; अङ्गुरल रस=सिरन्या अङ्गुर रस; चल्=चल्</char></note> नाएस्यु येशुजन आओटौ, “ब्याए या, किगर्दाङ एलिया नकाजन क्रूसतन ल्हाएरांऔ सन्।”<note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">भजनसङ्ग्रह ६९:२१</ref></char></note> <verse eid="MRK 15:36" /><verse number="37" style="v" sid="MRK 15:37" />तब येशुले घिन्या ग़ा पलिईस्यु परान आराहौ। <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />ओटन मन्दिरलं पर्दा टुप्पाङन वान्ङ समन चेईस्यु नें भाअ ताहौ।<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">प्रस्थान २६:३१-३३</ref></char></note> <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />येशुले ऐलेस्यु परान आराइन्या रङस्यु आलेऊक च्याङज्यान्या सिपाइयाङल कप्तानले ऐलेऊ, “पक्का ईका रु परमेस्वरलं ज़ा लेऊरैस।” <verse eid="MRK 15:39" /><verse number="40" style="v" sid="MRK 15:40" />नल लोएतन ब्याएन्या वाला ख्वाएयाए मेएमाङ बै लेवाङ। नकाङ तन मरियम मग्दलिनी ओटन इङन्या याकूब सनर योसेफल आमा मरियम ओटन सलोमी लेवाङ।<note caller="-" style="x"><char style="xo" closed="false">15:40 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">लूका ८:२-३</ref></char></note> <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />जब येशु गालीलल आलिज्याऔक, नका सोगल मेएमाङ, आछिन्ट रांवाङ, ओटन ओलं सेवा ढाज्यावाङ, अपुऱ्याङ बै भ्याई मेएमाङ ओलसं यरुशलेम सहरल रा:स्यु लेवाङ।<verse eid="MRK 15:41" /></para>
  <para style="s">येशुजन रारीनन्या</para>
  <para style="r">
    <ref loc="MAT 26:56-61">मत्ती २६:५६-६१</ref>; <ref loc="LUK 23:50-56">लूका २३:५०-५६</ref>; <ref loc="JHN 19:38-42">यहुन्ना १९:३८-४२</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />जब ओइ ताहौ, तयारील दिन लेऊ, जो नानसिन्या-दिनल तयोअ पहेला लेऊ। <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />महासभाला मानिसिन्या सदस्य अरिमाथियाला योसेफ, जोले परमेस्वरलं आराज्यला छेनल यम वुइज्याव, नकाले हिकमत सकाए पिलातस ल्योङ हिनस्यु येशुल बुल नीऊ। <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />येशु हादेए जै आसिन्या थएस्यु पिलातस हलाअ ताहौ, ओटन सिपाइयाङल कप्तानजन आल्योङ खुल्स्यु आगिनौ, नैति येशु आसिन्या ख्वाए बेला ताहौ। <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />येशु सिया पाइना पिलातसले सिपाइयाङल कप्तानङन बुजिस्यु येशुल सिन्या बुल योसेफजन आसुम्पिऊ। <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />ओटन योसेफले मलमललं क्वा आलङौ, ओटन येशुजन क्रूसतन वान्ल ल्हाएस्यु पालन्या क्वाले आमलिङौ, ओटन चम खुलिस्यु आजाएन्या तोलोअ ऊईल आनाटौ। नकाल छिन्ट ऊईल याह्‌ल नकाले तोलोअ घिन्या लुङले आकपौ। <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />मरियम मग्दलिनी ओटन योसेफल आमा मरियमने येशुजन नाएसिन्या पो रङस्यु लेऊने।<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">येशुल पुनरुत्थान</para>
  <para style="r">
    <ref loc="MAT 28:1-8">मत्ती २८:१-८</ref>; <ref loc="LUK 24:1-12">लूका २४:१-१२</ref>; <ref loc="JHN 20:1-10">यहुन्ना २०:१-१०</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />शबाथ दिनल छिन्काछिम मरियम मग्दलिनी सनर याकूबल आमा मरियम ओटन सलोमीले आस्युउनमन्या तीइ<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="ft" closed="false">चान्यास्युनमन्या=आस्युउनमन्या; द्रब्य=तखाल्या तीइ</char></note> येशुल कलाङल थिटौ नाल्ट नेंहोनौ। <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />हप्ताल पहेला दिन छकाल्याई घाम आपलिहौ छिन्ट नकाङ ऊई लेन्या पोल हिन्वाङ। <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />ओटन नकाङै रारांल छ्योङवाङ, “गे नाल्ट ऊईला झलापता घिन्या लुङ काङ्काले हताइस्यायिउ?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />ओटन नकाङै यादेए रांखिमौक ऊईला ना लुङ हताइसिन्या रांरङौ। ना लुङ बअघिन्या लेऊ। <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />ओटन ऊईल भितर रापसिऊक नकाङै पालन्या क्वा क्वाएसिन्या तोलोअ धापा रुजन दाइन्याङन आचुङज्यान्या रांरङौ, ओटन नकाङ अचम्म ताइवाङ। <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />ओले नकाङजन आपानस्योवाङ, “अचम्म तामानिच्यो, जे नासरतला येशुजन जेरोअज्याचिऊ ज्या, जो क्रूस त राकेपौ। ओ जिङदा ताइस्यु सोस्यु लेया। ओ आल माल्दी। ओजन नाएसिन्या पो आकाई ज्या। <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />हिन्चिते, ओटन ओलं सिइयाङ सनर पत्रुसजन पानस्योचिरते, कि ओ जे हा-हा गालील हिनज्याऔ। ओले जेजन आपानस्यान्या अनुसार जे ओजन नङ रङच्या।”<note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">मत्ती २६:३२</ref>; <ref loc="MRK 14:28">मर्कुस १४:२८</ref></char></note> <verse eid="MRK 16:7" /><verse number="8" style="v" sid="MRK 16:8" />नका मरियम मग्दलिनी सनर याकूबल आमा मरियम ओटन सलोमीयाङ अचम्म ताइस्यु राछ्याहै वुउस्यु येशुल ऊईलन पलिईस्यु चोएवाङ, ओटन नकाङै काङ्काईजन नैज मापानस्योदुरा। दानाङभन्या नकाङ छ्याएस्यु लेवाङ।<verse eid="MRK 16:8" /></para>
  <para style="s">मरियम सनर मग्दलिनी नें येशुल दर्शन नेंडोटौ</para>
  <para style="r">
    <ref loc="MAT 28:9-20">मत्ती २८:९-२०</ref>; <ref loc="LUK 24:13-53">लूका २४:१३-५३</ref>; <ref loc="JHN 20:1-23">यहुन्ना २०:१-२३</ref>; <ref loc="ACT 1:9-20">प्रेरित १:९-२०</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />हप्ताल पहेला दिन छकाल्या आताहौ पाइनाई ओ बान्चिस्यु सोस्यु पहेला मरियम मग्दलिनी जोल्योङन ओले साट वटा दुस्टआत्माङ आपलिइवाङ, नका ल्योङ थनसिऊ। <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />मरियमले हिनस्यु येशुल आसिइयाङजन सनर अपुर रुयाङजन ईका थाई आयोवाङ। नवाए बेला सिइयाङ रां सोगलै हारमानिस्यु व्‌रज्यावाङ। <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />तर जब येशु जिङदा ताहौ ओटन मरियम ल्योङ रंनौ ऐलेन्या छेन राथटौ, तब नकाङै बिस्वास रांमाढोव।<verse eid="MRK 16:11" /></para>
  <para style="s">येशुजन नेलोअ आ सिइने नेरङन्या</para>
  <para style="r">
    <ref loc="LUK 24:13-35">लूका २४:१३-३५</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />नाल छिन्ट नेंलोअ आ सिइने नङ्गर देए नेंहिनज्याऔ बेलाक नकाने ल्योङ येशु छुट्टै भेसतं त डोएसिऊ। <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />ओटन नकाने वलस्यु हिनस्यु अपुर सिइयाङजन नेपानस्योवाङ। तर ओयाङै नकानेल छेन बै बिस्वास माढोदुरा।<verse eid="MRK 16:13" /></para>
  <para style="s">येशु एघारगोटा सिइयाङ ल्योङ आरंनन्या</para>
  <para style="r">
    <ref loc="MAT 28:16-20">मत्ती २८:१६-२०</ref>; <ref loc="LUK 24:36-49">लूका २४:३६-४९</ref>; <ref loc="JHN 20:19-23">यहुन्ना २०:१९-२३</ref>; <ref loc="ACT 1:6-8">प्रेरित १:६-८</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />ओलं छिन्ट येशु एघारगोटा आ सिइयाङ ल्योङ ज्यान्या ज्योङा लेस्यु राचुङज्याऔ बेलाक थनसिऊ। ओटन नकाङल अबिस्वास सनर रायिङला चिमत्याई नाल्ट ओले नकाङजन आसज्याअवाङ। दानाङभन्या ओ सिन्यातन जिङदा ताइस्यु आसोव छिन्ट ओलजन रङन्या वालाङल छेन नकाङै बिस्वास रांमाढोव। <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />ओटन येशुले नकाङजन ऐआढोवाङ, “सोगलै सङ्सारलं हिनस्यु सोगलै स्रिस्टीजन प्रचार ढोचिते।<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">प्रेरित १:८</ref></char></note> <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />बिस्वास ढान्या वालाङ सनर बप्तिस्मा होनन्या वालाङै उद्दार डोएरा, तर बिस्वास माढान्या वालाङ दोसी ठहराइसिरा। <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />ओटन बिस्वास ढान्या वालाङसकाए ईका अचम्मला कामयाङ ताइरा ङा मिनङन नकाङै दुस्टआत्माङजन पलिइरा, छार छेनल छ्योङरा, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />नकाङ डाङयाङ कोलोअरा ओटन बिइ लेन्या जो जन्तु बै ओरकन नकाङल नैज नोक्सान माढोवदी। नकाङै नाएबोरन्याङ यर्त राकुई नाएरा ओटन नकाङ बेलरा।”<verse eid="MRK 16:18" /></para>
  <para style="s">येशु स्वर्गदेए हिनौ</para>
  <para style="r">
    <ref loc="LUK 24:50-53">लूका २४:५०-५३</ref>; <ref loc="ACT 1:9-11">प्रेरित १:९-११</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />तब ऐलेस्यु नकाङसं आछ्योङौ छिन्ठक्क प्रभु येशु स्वर्गदेए हिनौ, ओटन परमेस्वरलं दाइन्याङन सर्बोच्चल बिराजमान ताहौ।<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">प्रेरित १:९-११</ref> </char></note> <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />ओटन नका आसिइयाङै हिनस्यु सोगलै पोल बचन प्रचार रांढोव। ओटन प्रभुले नकाङ सकाए अचम्मला कामङन अचम्मला काम ढाऔयन ढाज्याव, ओटन ईका बचन प्रचार सत्य ज्या ऐलेस्यु प्रमानित आजाटौ। आमेन।<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>