<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Sheshi Kham</book>
  <para style="h">फिलेमोन</para>
  <para style="toc3">फिलेमोन</para>
  <para style="toc2">फिलेमोन</para>
  <para style="toc1">फिलेमोनजन पावललं चिठी</para>
  <para style="mt1">फिलेमोनलाई पावलको चिठी</para>
  <para style="mt2">फिलेमोनजन पावललं चिठी</para>
  <para style="imt">किटापल आशई</para>
  <para style="ip">फिलेमोनल किटाप प्रेरिततन तुनन्या सरसिन्या लेऊ। <char style="xt"><ref loc="PHM 1:1">१:१</ref></char> पावल कैदल आलिज्याऔक ईका आसरौ, जोल अर्थ ईका हो कि ओले रोमङ सरस्यु लेऊ। यदि ओ रोमल आलिज्यान्या ताहकन ईका ख्रीस्ट आजर्मिऊल छ्योअ ६१ बर्स छिन्ट सरसिन्या लेऊ, जो ओले मन्डलीयाङजन आसरस्यान्या बेला हो। ओले ईका चिठी फिलेमोन मिनला रुजन आसरस्यौ। फिलेमोन मन्डलीला सदस्य सनर सेबक खसम बै लेऊ। पावलले फिलेमोन ल्योङन ढोङन्या आनोक्कर ओनेसिमसजन सजाय मायान्या सन् लेस्यु गिनौ नाल्ट चिठी आसरौ। रोमी कानुन अनुसार फिलेमोनले ओनेसिमसजन सएन्या दन्ड यांन्या अढिकार लेऊ। ओनेसिमसजन इसाई भाईल हिसापत अपनाइन्या लेस्यु फिलेमोनजन सभनौ नाल्ट पावलले मयामोहला छेनपानयाङ आचलाहौ, ओटन ओनेसिमसजन पावलसैज सेवा ढान्या अनुमति यांन्या बै सल्ला योंवा। <char style="xt"><ref loc="PHM 1:13-14">१:१३-१४</ref> </char></para>
  <para style="iot">रुप रेखा:</para>
  <para style="io1">पावलले फिलेमोनजन अभिबादन ढोवा। <char style="ior"><ref loc="PHM 1:1-3">१:१-३</ref></char></para>
  <para style="io1">ओलं छिन्ट पावलले ओनेसिमसलं तरफङन फिलेमोनजन इसाई भाईल हिसापत अपनाइन्या ऐलेस्यु गिन्वा। <char style="ior"><ref loc="PHM 1:4-21">१:४-२१</ref> </char></para>
  <para style="io1">पावलले भ्रमन ढान्या आमि बिचार नाएवा ओटन अभिबादन परिङस्यु खेमा। <char style="ior"><ref loc="PHM 1:22-25">१:२२-२५</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />येशु ख्रीस्टल कैदी पावल सनर गे भाई तिमोथीङन, सनर गेसकाए काम ढान्यावाला न्हाए फिलेमोन। <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />गे बैना अप्फिया सनर गे न्हाए सिपाइ अर्खिप्पस, ओटन नझिमला मन्डलीयाङजन<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="COL 4:17">कलस्सी ४:१७</ref></char></note> <verse eid="PHM 1:2" /><verse number="3" style="v" sid="PHM 1:3" />गे बौ परमेस्वर सनर प्रभु येशु ख्रीस्टङन जेजन अनुग्रह ओटन शान्ति!<verse eid="PHM 1:3" /></para>
  <para style="s">फिलेमोनल प्रेम सनर बिस्वास</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />ङा भाई फिलेमोन जब ङा प्रार्थनात नङजन यिङन तब ङा ङामि परमेस्वरजन सदाई धन्याबाद योंङा, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />दानाङभन्या प्रभु येशुता न बिस्वासलं बारेल सनर बिस्वासीयाङत नढान्या प्रेमल बारेङन जब ङा थटङ, <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />तब ङा प्रार्थना ढोङा कि न बिस्वासलं सहभागिताले ख्रीस्टतं लेन्या गेमि सोगलै चान्या छेनल ग्यानत बदिऊ ग्याढुदुनत्या। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />ऐ ङा भाई, न प्रेमङन ङा तबर खुशी सनर उत्साह डोएस्यु लेङा, दानाङभन्या नङ्ङन परमेस्वरलं रुयाङल यिङ फरि आनन्दले भरिसिस्यु ताजा ताइस्यु लेया।<verse eid="PHM 1:7" /></para>
  <para style="s">ओनेसिमसलं नाल्ट पावलल बिन्ति</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />नङ नै ढाऔपरिन्या हो, नका आग्या ख्रीस्टङन यांन्या ङामि हिकमत लेकन बै, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />ङा छोपा पावल येशु ख्रीस्टल तोलोअ कैदी, आकअ बरु प्रेमल नाल्ट ङा नङजन बिन्ति ढाऔ ङारोअङु, <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />ङा ङाज़ा ओनेसिमसलं नाल्ट बिन्ति ढाना, जोल नाल्ट ङा कैदल ङालज्याऔक आत्मिक बौ ताइस्यु ङाल्ङु।<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="COL 4:9">कलस्सी ४:९</ref></char></note> <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />नका पैला न नाल्ट बिकामला लेऊ, तर आकअ न नाल्ट सनर ङा नाल्ट काम लागिन्या ताइस्यु लेया। <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />जो ङा यिङलाई टुक्रा हो, ङा नाजन नल्योङ होलस्यु ङापरिङज्याङु। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />नाजन ङासैज नाएन्या खुशी ङाल्ङु, दानाङभन्या चान्याथाईल नाल्ट बन्दी ङाताइज्याऊ बेलाक न पालोल नकाले ङा सेवा ढाऔ आढुदुऊ, <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />तर न अनुमति बिना ङा नैज माढोङदी, ताकि न भलाईल नाल्ट करले ढासिन्या ताटाइत्या, तर नङ नइच्छ्याले नढान्या ग्याताइत्या। <verse eid="PHM 1:14" /><verse number="15" style="v" sid="PHM 1:15" />सक्या नङतन ओनेसिमस थोरै समायल नाल्ट अलक ताइस्यु लेऊ, कि नका सदाईल नाल्ट नङसं चुङौ ग्याडोटौत्या। <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />आबकन नोक्करमन माङडी, तर नोक्करतन भ्या, न्हाए भाईमन्जै, खासगरि ङा नाल्ट, तर झन भ्याई बुलत सनर प्रभुत समेत, न नाल्ट बै।<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />नैताइस्यु यदि नङ नङ मन्जै ङाजन यिङ्ङकन नकाजन ङामन्जै सुइकार ढोते। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />यदि नकाले नङजन कोबाअ माचान्या ढास्युलेकन बै, अथाबा कोबाअ छेनत नका रिनी लेकन, ना ङा हिसापत नाएस्याङते। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />ङा पावल, ङा कुईलेई ईका सरज्याङा। ना रिंन ङाईज फोअङा। नङजन पानस्याज्यान्या माताइदी होला, कि ङा नाल्ट बै नङ ङामि रिनी लेना। <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />ऐ भाई, नल्योङन प्रभुत कोबाअ फाइदा ग्याडोटङत्या ऐलेऊ ङारोअङु। ख्रीस्टतं ङायिङजन फरि खुशी जाएस्याङते। <verse eid="PHM 1:20" /><verse number="21" style="v" sid="PHM 1:21" />न आग्या पालनत भरोसा नाएस्यु ङा ङानीन्यातन झन भ्याई ढान्यालेना ऐलेन्या यिङस्यु ङा नङजन ईका ङासरस्याज्यानु। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />ओटन ङा नाल्ट तोलोअ चुङन्या पाहुना-कोठा तयार जाएस्यु नाएस्याङ, दानाङभन्या न प्रार्थनाले ङा बै नल्योङ रांऔ ङाडोएङुसन ऐलेन्या परमेस्वरतं आस ढोङा।<verse eid="PHM 1:22" /></para>
  <para style="s">आखिरी अभिबादन</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />येशु ख्रीस्टतं ङा न्हाए कैदी इपाफ्रासले नङजन अभिबादन परिङस्यु लेया।<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="COL 1:7">कलस्सी १:७</ref>; <ref loc="COL 4:12">४:१२</ref></char></note> <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />नामन्जै ङाजन व्एन्या मर्कुसं, अरिस्तार्खस, डेमास सनर लूकाले बै।<note caller="-" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेरित १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref>; <ref loc="ACT 19:29">१९:२९</ref>; <ref loc="ACT 27:2">२७:२</ref>; <ref loc="COL 4:10">कलस्सी ४:१०</ref>,<ref loc="COL 4:14">१४</ref>; <ref loc="2TI 4:10-11">२तिमोथी ४:१०-११</ref></char></note> <verse eid="PHM 1:24" /><verse number="25" style="v" sid="PHM 1:25" />प्रभु येशु ख्रीस्टल अनुग्रह जेमि आत्मात ग्यालिज्यात्या।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>