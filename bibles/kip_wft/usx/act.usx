<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Sheshi Kham</book>
  <para style="h">प्रेरित</para>
  <para style="toc3">प्रेरित</para>
  <para style="toc2">प्रेरित</para>
  <para style="toc1">प्रेरितयाङै काम</para>
  <para style="mt1">प्रेरितहरुका काम</para>
  <para style="mt2">प्रेरितयाङै काम</para>
  <para style="imt">किटापल आशई</para>
  <para style="ip">प्रेरितयाङल कामल किटाप मन्डलीलं सुरुवाटल सिलिउ हो। ओटन कैलेस्यु ईका यरुशलेमङन यहूदिया, सामरीया, सनर नलन बाहेर फैलिऊ, थ्याक्कै नैलेस्युजै जोमनलेस्यु येशुले ओलं सिइयाङजन स्वर्गल हिनौहादेए पानस्युलेऊ। <char style="xt"><ref loc="ACT 1:8">१:८</ref></char> ईका लूकाङन सरसिस्युलेव। जोले लूकाल अनुसार चान्याथाई सरस्युआनाटौ। ओ तोलोअ डाक्टर लेऊ। ओटन ओले सहि सनर सत्य बिबरनयाङ टिउन्या भ्याई सजकता आअपनाहौ। ओले आमि चान्याथाई सनर प्रेरितयाङल कामल किटाप थियोफिलसजन सम्बोदन ढास्यु लेऊ। जो तोलोअ ग्रीक लेऊ, तर ईका किटापयाङ ताहौ ढुदुवा ग्रीक सनर यहूदी नेंलोअझन्जै बोलोङ जाएन्या इसाई समुदायल नाल्ट सरसिन्या लेऊ।<char style="xt"><ref loc="ACT 1:1">१:१</ref></char> प्रेरितयाङल काम ताहौ ढुदुवा येशुल जन्म आताहौ छिन्ट ६०-६४ ई.बी. बर्सलं खार्ल सरसिन्या लेऊ, दानाङभन्या ईका किटाप पावलल कैदलन रिहाई आताहौ हादेए खेमा। लूका प्रेरित पावल सकाए बास्यु लेऊ, ओटन ताहौ ढुदुवा ओले प्रेरितयाङल कामल किटाप एन्टिओखियाल चुङस्यु आसरन्या लेऊ, प्रेरितयाङल काम लूकाल चान्याथाई लगातार ताइज्यान्या हो। ओटन येशु स्वर्गत आहिनन्या घटनाङन सुरु ताहा। लूकाले आसरन्या उदश्य ताहौ ढुदुवा ओलं चान्याथाईमन ताइन्याई लेऊ। ओले थियोफिलस सनर बदिन्या इसाईयाङलं बगालजन ओयाङै राह्युउसिन्या छेन सत्य आताइन्यात पक्का ताहौ नाल्ट आसरौ। ओटन नकाई येशु जिबन सनर इसाईलं माठोसं सहि बिबरन आसरौ। प्रेरितयाङल कामले गेजन सुरुला मन्डलीलं उदाहरन योंवा। ओटन येशुत बिस्वासलं जिबन कैताइन्या रंनौ ऐलेन्या छेन थन्वा। प्रेरितयाङल उदाहरनले गेजन अपुऱ्याङ समन चान्याथाईल थाई सतापन्या पबित्र आत्मात भरपरिसिन्या ह्युउवा।</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">पैला पबित्र आत्मा सिइयाङत रांया ओटन मन्डली सुरु ताहौ तअसिया। <char style="ior"><ref loc="ACT 1:1-8:1">१:१—८:१</ref> </char></para>
  <para style="io1">ओलं छिन्ट मन्डलीले सटावट भोघिवा ओटन यरुशलेम बाहेरल फैलिऊ तअसिया। <char style="ior"><ref loc="ACT 8:2-12:23">८:२—१२:२३</ref> </char></para>
  <para style="io1">पावल पैला लक्छेल हिना। <char style="ior"><ref loc="ACT 12:24-14:28">१२:२४—१४:२८</ref> </char></para>
  <para style="io1">ओलं छिन्ट छार बिस्वासीयाङजन नै नीन्या ताहौ, ऐलेन्या निर्नय ढाऔ नाल्ट यरुशलेमल चुङा। <char style="ior"><ref loc="ACT 15:1-35">१५:१-३५</ref> </char></para>
  <para style="io1">पावल नेंपालाका लक्छेल हिना। <char style="ior"><ref loc="ACT 15:36-18:22">१५:३६—१८:२२</ref></char></para>
  <para style="io1">ओलं छिन्ट तिनपाला हिना। <char style="ior"><ref loc="ACT 18:23-20:38">१८:२३—२०:३८</ref> </char></para>
  <para style="io1">पावल यरुशलेमल कोलोअसिऊ। <char style="ior"><ref loc="ACT 21-26">२१—२६</ref></char></para>
  <para style="io1">आसापट ओलजन रोम परिङसिया। <char style="ior"><ref loc="ACT 27-28">२७—२८</ref></char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">पबित्र आत्माल बाचा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />ङानिज्युन्या थियोफिलस, ङामि पहेला किटापल ङा नका सोगल छेनयाङ बारेल सरस्युलेङा। जो येशुले आकाम सुरु आढान्या बेलाकन आढान्या सनर आह्युउन्या लेऊ<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="LUK 1:1-4">लूका १:१-४</ref></char></note> <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />ओलजै आछेलन्या प्रेरितयाङजन येशुले पबित्र आत्माङन आग्या योंवरा पाइना, ओलं स्वर्गत छेन्स्यु आलाङसिऊ छिम समनका छेन ईका किटापल सरसिज्याया। <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />येशुले ओल दुख आभुगिउ छिन्ट, भ्याई मागनिदुसिन्या प्रमानयाङ नकाङै हाकै ओले ओलजन जै जिङदा साबित आजाटौ। चालिस दिन समन तबर पाला नकाङल्योङ रंनौ, ओटन परमेस्वरलं राज्यल बारेल नकाङजन आपानस्योवाङ। <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />नकाङसं ज्योङा लेस्यु राचुङौक येशुले नकाङजन ऐटाइन्या आपरिमवाङ, “जे यरुशलेमङन कान्देए ताहिनच्यो, तर बौले आढान्या बाचाल यमवुईचिते। ईका बारेङन जे ङाल्योङन थएस्युई लेच्या।<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 24:49">लूका २४:४९</ref></char></note> <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />दानाङभन्या यहुन्नाले ता रीले बप्तिस्मा आयोव तर आबका थोरै दिनक पबित्र आत्माङन जे बप्तिस्मा डोएच्या।”<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">मत्ती ३:११</ref>; <ref loc="MRK 1:8">मर्कुस १:८</ref>; <ref loc="LUK 3:16">लूका ३:१६</ref>; <ref loc="JHN 1:33">यहुन्ना १:३३</ref></char></note><verse eid="ACT 1:5" /></para>
  <para style="s">येशुजन स्वर्गदेए लाङसिऊ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />नैताइस्यु जब प्रेरितयाङ दुउसिवाङ, तब नकाङै येशुजन रांगिनौ, “औ प्रभु, नैति नङ ईकाइ बेला इस्राएल राज्यजन फरि जाएन्यालेया?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />येशुले नकाङजन ऐआढोवाङ, “नका बेला या नकाछिम सनन्या बौले आ अढिकारङन आटुकिन्या समायजन सनन्याल काम जेमि माङडी। <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />तर पबित्र आत्मा जेल्योङ रायापाइनाई जे सक्ति डोएन्यालेच्या,<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">मत्ती २८:१९</ref>; <ref loc="MRK 16:15">मर्कुस १६:१५</ref>; <ref loc="LUK 24:47-48">लूका २४:४७-४८</ref></char></note> ओटन जे यरुशलेमल, ओटन सोगलै यहूदियाल, ओटन सामरीयाल सनर पिरथ्बील आवङ समन ङा साची ताइन्यालेच्या।” <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />ईका पान्वापाइना, नका ओयाङै रांखिमज्याऔ रांखिमज्याऔकै स्वर्गदेए छेन्सिऊ, ओटन बादलल ओलं नकाङल नजरतन माऔ।<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">मर्कुस १६:१९</ref>; <ref loc="LUK 24:50-51">लूका २४:५०-५१</ref></char></note> <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />जब नका हिनौ, ओटन बै नकाङल नजर नमदेए लेऊ, तब पालन्या क्वा क्वाएसिन्या नेंलोअ रुनें झुकाउन्या नकाङ ल्योङ रा:स्यु च्याङौने। <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />ओटन ऐलेऊ तअसिऊने, “औ गालीलला रुयाङ, दानाङ नमदेए खिमस्युकने च्याङज्याच्यो? नकाई येशु, जो जेलेऊकन्ज स्वर्गदेए हिनौ, आकअ जोमनलेस्यु जे ओजन स्वर्गदेए आहिनन्या जेरङचिऊ, नैलेस्युजै ओ फरि रांया।”<verse eid="ACT 1:11" /></para>
  <para style="s">यहूदाल उत्तराधिकार</para>
  <para style="r">
    <ref loc="MAT 27:3-10">मत्ती २७:३-१०</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />तब प्रेरितयाङ जैतुन ऐराढान्या डान्डालन यरुशलेम वोल्वाङ। यरुशलेम सहरङन नका डान्डा छ्योअछ्योअ तकिलोमिटर याए लोए लेऊ। <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />सहर भितरलं पसिरा पाइना नकाङ टङटालत रा:चुङन्या कोठालं वूम्वाङ। नकाङ पत्रुस, यहुन्ना, याकूब, अन्द्रियास, फिलिप सनर थोमा बारथोलोमाइ ओटन मत्ती, अल्फयसलं ज़ा याकूब सनर बअचासोसं बिस्वास ढान्या सिमोन सनर याकूबल ज़ा यहूदा लेवाङ।<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">मत्ती १०:२-४</ref>; <ref loc="MRK 3:16-19">मर्कुस ३:१६-१९</ref>; <ref loc="LUK 6:14-16">लूका ६:१४-१६</ref></char></note><verse eid="ACT 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 1:14" />ख्वाए मेएमाङ सनर येशुल आमा मरियम सनर ओलं भाईयाङ सकाए प्रेरितयाङ सोगलै तोलोअ यिङला ताइस्यु लगातार प्रार्थना ढाज्यावाङ।<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />नका दिनल भाईयाङल खार्ल पत्रुस च्याङौ ओटन (ईका रुयाङल बगाल छ्योअछ्योअ तसय बिस लेवाङ), ओटन ऐआढोवाङ, <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />“ऐ बिस्वासी भाई बैनाङ, पबित्रशास्त्रलं बचन पुरा ताहौ परिया, जो सत्य बचन येशुजन कोलोअन्याङल अगवा यहूदाल बारेङन दाऊदल याह्‌लन हाकन्जै पबित्र आत्माले छ्योङस्यु लेऊ।<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजनसङ्ग्रह ४१:९</ref></char></note> <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />दानाङभन्या यहूदाल गनिइ गेसकाए ताइस्यु लेऊ। ओटन आकाई सेवाल नकाले बठा डोएस्यु लेऊ।”<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />नका यहूदाले कैफट ढास्यु आकमाइन्या रुप्याले तोलोअ येङ आलङौ, ओटन उभिन्ड्या ताइस्यु तेहौ ओटन आभन्दिउ पाकौ, ओटन नकाल सोगलै आटअ भन्दिउ सोगलै पलिहौ।<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="MAT 27:3-7">मत्ती २७:३-७</ref> </char></note> <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />ईका छेन यरुशलेमला चुङन्याङ सोगलैजन थाह ताहौ। नका येङल मिन नकाङै राभासाल आखेल्दाल नाएसिऊ अथाबा जील खेए।<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />“दानाङभन्या पत्रुसले ऐलेऊ, भजनसङग्रहलं किटापल सरसिज्याया,<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 69:25">भजनसङ्ग्रह ६९:२५</ref>; <ref loc="PSA 109:8">१०९:८</ref></char></note> ‘नकाल बाई पो खालि ग्याताइत्या ओटन आचुङन्या पोल काङ्काई तालरत्या ओटन नकाल पदाधिकार छुट्टैले ग्यालाङौत्या।’ <verse eid="ACT 1:20" /><verse number="21" style="v" sid="ACT 1:21" />जोमनलेस्यु गे प्रभु येशु गेखार्ल लेऊ गे ओलं साचील हिसापत गेसकाए बोलोङ ताहौपरिया, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />ओ नकाङ मध्यलन तोलोअ ताहौ परिया, जो गे बगालल ना पुरा समाय गेसं लेऊ, प्रभु येशु गेसकाए आबारिऊ बेलाकन सुरु ताइस्यु जब यहुन्नाले बप्तिस्मा सनर आमि चान्याथाई प्रचार आढोव, जो पुनरुत्थान समन जब येशु गेल्यौकन स्वर्गदेए लाङसिऊ।”<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />नकाङै नेंलोअ रु सच्यानौ जो बारसाबास ऐराढान्या योसेफ, जोल मछ्युका मिन युस्तस लेऊ, ओटन मतियासलं मिन प्रस्ताब आढोव। <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />नकाङै ऐलेस्यु प्रार्थना रांढोव, “सोगलै रुयाङल यिङला छेन सनन्या प्रभु, ईका नेंलोअ मध्य काङ्काजन छेल्स्यु नल्‌नु ना गेजन थनस्यासिन्ते, <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />ओटन ना ईका सेवा सनर प्रेरितल कामल पसिऊ ग्याढुदुऊत्या, जो सेवाङन यहूदा भत्किस्यु आपोलै सिऊ।” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />ओटन नकाङै ना नेंलोअनेंल खार्ल चिठ्ठा राझोकौ, ओटन मतियासलं मिनत परिऊ, ओटन एघार प्रेरितयाङस नका बै गनिसिऊ।<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">पेन्तिकोसलं पबित्र आत्मा आरांन्या</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />जब पेन्तिकोसलं दिन रांऔ, तब नका सोगल बिस्वासीयाङ तपोईल दुउसिस्यु लेवाङ।<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">लेवी २३:१५-२१</ref>; <ref loc="DEU 16:9-11">ब्यबस्था १६:९-११</ref></char></note> <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />ओटन स्वर्गङन झुकाउन्या घिन्या आन्ढील मुल्का मनताइन्या तोलोअ ग़ा रांऔ, ओटन नकाङ राचुङज्यान्या सोगलै झिमभरि थहौ। <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />मील ल्हे मनताइन्या नकाङल्योङ रंनौ, ओटन भाअ भाअ ताइस्यु नकाङ सोगलैलयर्त चुङवाङ। <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />ओटन नकाङ सोगलै पबित्र आत्माले भरिसिवाङ, ओटन पबित्र आत्माले नकाङजन आयांन्या अनुसार नकाङ अपुर छिन्ङन छ्योङौ तअसिवाङ। <verse eid="ACT 2:4" /><verse number="5" style="v" sid="ACT 2:5" />स्वर्गल बाङल लेन्या सोगल देसलन ईस्वरभक्त यहूदीयाङ नका बेला यरुशलेमल लेवाङ। <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />तब ईका ग़ा थएस्यु तबर रुयाङ दुउसिवाङ। ओटन नकाङ छक्कै ताइवाङ, दानाङभन्या सोगलैले रारां छेनत रांछ्योङज्यान्या राथटौ। <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />नकाङ सोगलै हलाअ ताइवाङ, ओटन अचम्म मानिस्यु ऐलेऊ तअसिवाङ “नैति आका छ्योङन्याङ सोगलै गालीललाङ माङडीका? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />तब नकाङै ऐलेवाङ, कढाई सोगलैले गे छिन्ङन रांछ्योङन्या गेथएयिउ? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />गे इल पार्थियाङ, मादीयाङ सनर एलामीयाङ ओटन मेसोपोटामियालाङ, यहूदियालाङ, कापाडोकियालाङ, पोन्टस सनर एशियाला बासिन्दाङ लिज्याया। <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />ओटन फ्रिगिया, पामफिलिया, मिस्र सनर कुरेनील परिन्या लिबियाला ख्वाएयाए पो ज्युउल सनर रोमङन रांन्या यहूदी सनर यहूदीमत मानिन्याङ नेंलोअ गेलेयिउ, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />क्रेटला बासिन्दाङ सनर अरबीयाङ बै गेलेयिउ, ओटन गे गेछेनङन परमेस्वरलं महान कामयाङल चर्चा नकाङ राढाज्यान्या गेथएज्यायिउ।” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />नकाङ सोगलै अचम्मै ताइवाङ ओटन अक्कमक्क परीस्यु तोलोअले तोलोअजन ऐढाऔ तअसिवाङ “ईकालं अर्थ नैति?”<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />तर अपुऱ्याङै ऐलेस्यु रा:साई जाएस्यु ऐलेवाङ, “नका बिस्वासीयाङ छार रक्सिले मंङस्यु लेरा।”<verse eid="ACT 2:13" /></para>
  <para style="s">पत्रुसले आह्युउवाङ</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />तर पत्रुसले एघार सिइयाङस च्याङस्यु घिन्या ग़ाले हुलयाङजन ऐआढोवाङ, ऐ यहूदियाला रुयाङ, सनर यरुशलेमला सोगलै चुङन्याङ जेजन ईका छेन थाह ग्याताइत्या, नैताइस्यु ङा छेन थएचिते। <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />दानाङभन्या जे जेलेऊकामन आकाङ मामङज्यारदी, दानाङभन्या आकअ छकाल्याका नौ याएज बजिस्यु लेया। <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />तर योएल अगमबक्ताङन पान्सिन्या छेन आकाई ज्या,<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />आसापटा दिनयाङल ऐटाइन्या लेया ओमनलेस्यु परमेस्वरले ऐलेऊ,</para>
  <para style="q2" vid="ACT 2:17">ङा सोगल रुयाङत ङाआत्मा नाएङा,</para>
  <para style="q1" vid="ACT 2:17">ओटन जेमि ल्हेपाज़ायाङ, सनर जे मेएमा ज़ायाङै भबिस्यबानी छ्योङन्या लेरा,</para>
  <para style="q2" vid="ACT 2:17">ओटन जे जवानयाङै दर्शन रङन्या लेरा,</para>
  <para style="q2" vid="ACT 2:17">ओटन जे सेरयाङ मङ दर्शन रङन्या लेरा।<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />औ, ङा ङानोक्कर नोक्करनियाङ यर्त ना दिनल ङाआत्मा झोअस्योङरा,</para>
  <para style="q2" vid="ACT 2:18">ओटन नकाङ भबिस्यबानी छ्योङरा।<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />ङा हर्त नमत अचम्मला काम</para>
  <para style="q2" vid="ACT 2:19">सनर वान्ल पिरथ्बील अचम्मला कामयाङ ठनन्या लेङा,</para>
  <para style="q1" vid="ACT 2:19">अथाबा जी, मी सनर मीकुईल मुल्का।<verse eid="ACT 2:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="ACT 2:20" />परमप्रभुल महानता</para>
  <para style="q2" vid="ACT 2:20">सनर गौरबला दिन आरांऔ हादेए नम्युउ चिऊन्याल</para>
  <para style="q2" vid="ACT 2:20">सनर ह्यावए जीत फिरिसिन्या लेया।<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />ओटन जोले प्रभुल मिन पुकारिऊ,</para>
  <para style="q2" vid="ACT 2:21">नकाले उद्दार डोएवा।<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />“ऐ, इस्राएलला रुयाङ आका छेन थएचिते, नासरतला येशु तोलोअ ऐटाइन्या रु हो, जोले जे खार्ल सक्तिशाली कामयाङ सनर अचम्मला काम ढास्यु जे सामन्दी प्रमानित आजाटौ। जेजन थाहै लेया कि आका कामयाङ परमेस्वरले येशुङन आढोव। <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />आमिई योजना अनुसार परमेस्वरले पैलाई पक्का आठहराइन्या नकाई येशुजन पापी रुयाङ कुईत आसुम्पिऊ, जोजन जे क्रूसतं केप्स्यु जेसएचिऊ।<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">मत्ती २७:३५</ref>; <ref loc="MRK 15:24">मर्कुस १५:२४</ref>; <ref loc="LUK 23:33">लूका २३:३३</ref>; <ref loc="JHN 19:18">यहुन्ना १९:१८</ref></char></note> <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />दानाङभन्या परमेस्वरले सिइकालला हूरतन छुटकारा यांस्यु जिङदा आजाटौ। दानाङभन्या ओलं सिइकालल न्युउल लिज्यान्या असम्भब लेऊ।<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5-6">मत्ती २८:५-६</ref>; <ref loc="MRK 16:6">मर्कुस १६:६</ref>; <ref loc="LUK 24:5">लूका २४:५</ref></char></note> <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />दानाङभन्या दाऊदले येशुल बारेल ऐलेया,<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="PSA 16:8-11">भजनसङ्ग्रह १६:८-११</ref></char></note> ‘ङा प्रभुजन सदाई ङासामन्डी ङारङ्ङु, दानाङभन्या अलमल ताटाहङत्या लेस्यु ओ ङा दाइन्याङन लिज्याया।’”<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />नैताइस्यु ङामि यिङ हेसाङा</para>
  <para style="q2" vid="ACT 2:26">ओटन ङामि याह् आनन्दस छ्योङा।</para>
  <para style="q1" vid="ACT 2:26">नैताइस्यु ङा बुल बै</para>
  <para style="q2" vid="ACT 2:26">आसतं बान्चिन्या लेया।<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />दानाङभन्या नङ ङा परानजन पतालल राइन्यामालेन्दी,</para>
  <para style="q2" vid="ACT 2:27">न त नङ नमी पबित्रजनल बुल चिऊयोन।<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />नङ ङाजन ङाजिबनला यमयाङ नपानस्याङनु,</para>
  <para style="q2" vid="ACT 2:28">नङ ङाजन नल्योङन शान्ति सनर आनन्दले परिपुर्न जातङना।<note caller="-" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="PSA 16:8-11">भजनसङ्ग्रह १६:८-११</ref></char></note><verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />ऐ इस्राएली भाईबैनाङ, गेमि पुर्खा रय दाऊदल बारेल ङा जेजन प्रस्टै पानौ ढुदुङा, कि ओ सिऊ ओटन री:नसिऊ, ओटन आछिमका दिन समन ओलं ऊई ऐलिजिया। <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />नैताइस्यु दाऊद तोलोअ अगमबक्ता आताहौकाले, नाले सनस्युआनाटौ कि परमेस्वरले बाचा ढास्यु लेऊ, कि आमिई सन्तानङन परमेस्वरले दाऊदजन आसिहासनतं आसुचुनौ।<note caller="-" style="x"><char style="xo" closed="false">2:30 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">२शमूयल ७:१२-१३</ref>; <ref loc="PSA 132:11">भजनसङ्ग्रह १३२:११</ref></char></note> <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />आका रांन्या छेन रङस्यु</para>
  <para style="q1" vid="ACT 2:31">ओले ख्रीस्टल पुनरुत्थानल बारेल आपानौ,</para>
  <para style="q2" vid="ACT 2:31">कि ओजन सिन्याङल राज्यल माबनाएसिदा न ओलं बुल अलक रङस्यु।<verse eid="ACT 2:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="ACT 2:32" />परमेस्वरले आकाई येशुजन जिङदा आजाटौ, ओटन ईका छेनल गे सोगलै साची लेया। <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />नका परमेस्वरलं दाइन्या कुईत महिमित ताइस्यु ओले बौङन बाचा ढासिन्या पबित्र आत्मा आडोटौ, ओटन आकअ जे जेरङज्यान्या सनर जेथएज्यान्या छेन बाहेरत आथनौ। <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />दानाङभन्या दाऊद ता स्वर्गत मावूम्दा, तर ओले ओलजै ऐलेऊ,</para>
  <para style="q1" vid="ACT 2:34">परमप्रभुले ङामि प्रभुजन ऐआढोव,</para>
  <para style="q2" vid="ACT 2:34">नङ ङामि दाइन्या कुईङन चुङनते,<verse eid="ACT 2:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 2:35" />जब समन ङा जे शत्तुरयाङजन जे खङ न्युउ माजातङर।<note caller="-" style="x"><char style="xo" closed="false">2:35 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजनसङ्ग्रह ११०:१</ref></char></note><verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“नैताइस्यु इस्राएललं सोगलै जाहानले ईका पक्का सकाए ग्यासनरत्या, कि जो येशुजन जे क्रूसतं जेकेपचिऊ, परमेस्वरले ओजन प्रभु सनर ख्रीस्ट आजाटौ।”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />आका छेन थएस्यु नकाङल यिङ चहचह ताहौ, ओटन पत्रुस सनर अपुर प्रेरितयाङजन नकाङै ऐराढोव, “ऐ भाईबैनाङ, गे कैलेन्या ताहौ?”<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />पत्रुसले नकाङजन आढोवाङ, “पस्चाताप ढोचिते, ओटन जे पाप छेमाल नाल्ट येशु ख्रीस्टल मिनङन जे सोगलैले बप्तिस्मा होन्चिते, ओटन जे पबित्र आत्माल बरदान डोएच्या। <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />दानाङभन्या ईका बाचा जे नाल्ट, जे सन्तानल नाल्ट, सनर लोए-लोएङा लिज्यान्याङ सोगलै नाल्ट हो, सोगलै जोजन प्रभु गेमि परमेस्वरले खुलौरा।”<note caller="-" style="x"><char style="xo" closed="false">2:39 </char><char style="xt" closed="false"><ref loc="JOL 2:32">योएल २:३२</ref></char></note><verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />पत्रुसले नकाङजन अर्थ आयोवाङ, ओटन अपुर तबर छेनयाङ्ङन चेताउनी आयोवाङ, “ईका पापी रुयाङत रांन्या सजायतन जे जोगाइसिच्यो ऐआढोवाङ।”<note caller="-" style="x"><char style="xo" closed="false">2:40 </char><char style="xt" closed="false"><ref loc="DEU 32:5">ब्यबस्था ३२:५</ref>; <ref loc="PSA 78:8">भजनसङ्ग्रह ७८:८</ref></char></note> <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />तब जोजोले पत्रुसलं छेन ग्रहन ढास्यु नकाङै बप्तिस्मा राहोनौ, ओटन नकाई दिनछिम छ्योअ तिन हजार रुयाङ बगालल चैइसिवाङ।<verse eid="ACT 2:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />ओटन नकाङ प्रेरितयाङल सिक्छ्या डोटौ नाल्ट सङ्गति ढान्या सनर भरेई कलाएन्या ओटन प्रार्थनाल भक्तिसकाए लागिज्यावाङ।<verse eid="ACT 2:42" /></para>
  <para style="s">बिस्वासीयाङलं जिबन</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />ओटन सोगलैल यिङल छ्याइ पसिऊ, ओटन प्रेरितयाङ्ङन भ्याई घिन्या अचम्मला कामयाङ सनर भ्या अचम्मला कामयाङ ताइवाङ। <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />ओटन सोगलै बिस्वासीयाङ बोलोङ चुङस्यु, नकाङ सोगलै जन्तु सअतन लेऊ।<note caller="-" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">प्रेरित ४:३२-३५</ref></char></note> <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />नकाङै रांमि येङखेए सनर धनसम्पत यएस्यु जोजन जो जन्तुल अभाब परिऊ, नका ओयाङ सोगलैजन भाअस्यान्या रांढोव। <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />ओटन नकाङ तोलोअ यिङला ताइस्यु यरुशलेम मन्दिरलं तचोएकै दुउसिरा ओटन झिम-झिमल भरेई कलाएरा, ओटन नकाङ खुशी सकाए चोखा यिङले मिलिस्यु ज्योरा, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />ओटन परमेस्वरलं प्रसम्सा ढाऔयन, सनर सोगलै बिस्वासीयाङ चान्या मौका डोएस्यु चुङरा। उद्दार डोएन्याङजन प्रभुले दिनकाई नकाङल बगालत आचैस्योवाङ।<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">येशुले तोलोअ अपाङ्गजन आसबेलन्या</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />तयोअ पत्रुस सनर यहुन्ना लाअका तिन बजे प्रार्थनाल बेलाक मन्दिरलं हिनज्याऔने। <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />मन्दिर भितरलं पसिन्याङस बया नीस्यु बिन्ति आढोव, आजर्मिऊ कन्ज तोलोअ दुन्डाजन रुयाङ वुरस्यु लाङरा, ओटन दिनकाई मन्दिरलं सुन्दर मिन लेन्या झलापल ल्यौक नाएस्योरा। <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />पत्रुस सनर यहुन्ना मन्दिरलं भितरलं पसिङा नेंलिज्यान्या रङस्यु ना दुन्डाले बया यांङचिन्ते ऐलेस्यु बिन्ति आढोव। <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />पत्रुसले यहुन्ना सकाए नकाजन एखौऱ्या खिमस्यु ऐआढोव, “घेनल्यौदेए खिम्ते।” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />नकाने ल्योङन कोबाअ डोएन्या आस ढास्यु नकाले नेंलेऊदेए आब्याटौ।<verse eid="ACT 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 3:6" />तब पत्रुसले ऐआढोव, “ङासं चान्दी सनर सुन माल्दी, तर जो ङासं ले, नकाई ङा नङजन यांना, नासरतला येशु ख्रीस्टल मिनतन नङ च्याङस्यु बान्ते।” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />पत्रुसले दुन्डाल दाइन्या कुई कोलोअस्यु नकाजन आसचोटौ, ओटन ओचोएटै नकाल आखङला गुलिगान्ठाल तागत रांऔ। <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />ओटन नका जरू सोस्यु च्याङौ ओटन बाऔ तअसिऊ, ओटन बाऔयन उफ्रिऊयन सनर परमेस्वरलं सुति ढाऔयन नकानेसं मन्दिरलं पसिऊ। <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />जब सोगल रुयाङयाङै नकाजन आबाज्यान्या सनर परमेस्वरलं प्रसम्सा आढाज्यान्या रांरङौ। <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />तब रुयाङै नकाजन मन्दिरला चान्या झलापल वङ्क चुङस्यु बया नीन्या ईका ज्या लेस्यु रांशहौ, ओटन नकाल यर्त आताइन्या घटना रङस्यु नकाङ अचम्मै ताइवाङ।<verse eid="ACT 3:10" /></para>
  <para style="s">मन्दिरलं पत्रुसलं सिक्छ्या</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />नका रु पत्रुस सनर यहुन्नानेंल छिनछिन आबारिन्या रङस्यु सोगल रुयाङ भ्याई अचम्म मानिस्यु सोलोमन मिनला पटाहाल तचोएकै नकाङल्योङ चोएस्यु रांवाङ। <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />जब पत्रुसले ईका आरङौ “ऐ इस्राएलला रुयाङ, ईका छेनत जे नैकाम अचम्म जेमानिचिऊ? अथाबा गे घेनमिइज सक्ति या भक्तिङन इकाजन बान्या घेनजाएन्याङमन लेस्यु दानाङ खिमज्याच्यो? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />अब्राहाम, इसहाक सनर याकूबल परमेस्वर, गे शाखाल परमेस्वरले आमि सेबक येशुजन महिमित आजाटौ, जोजन जे कोलोकौ जेपरिङचिऊ, ओटन पिलातसले ओजन राइन्या निर्नय आढाऔक बै जे ओजन आहार्मै जेमाभन्चिऊ।<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 3:15">प्रस्थान ३:१५</ref></char></note> <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />तर जे पबित्र सनर धर्मि येशुजन असुइकार ढास्यु तोलोअ साइढवाजन राइन्या माग जेढोचिऊ,<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">मत्ती २७:१५-२३</ref>; <ref loc="MRK 15:6-14">मर्कुस १५:६-१४</ref>; <ref loc="LUK 23:13-23">लूका २३:१३-२३</ref>; <ref loc="JHN 19:12-18">यहुन्ना १९:१२-१८</ref></char></note> <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />ओटन जिबन कर्ताजन जे जेसएचिऊ जोजन परमेस्वरले सिइकालतन जिङदा आजाटौ, गे इकाल साची लेया। <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />येशुल मिनतन ढासिन्या बिस्वासले सनर ओलै मिनले जे जेरङन्या सनर जेशईन्या ईका रुजन बलल्या आजाटौ। ओल्योङन डोएसिन्या बिस्वासले ईका रुजन जे सोगलैल लेऊक बअबनाई आसबेलौ।”<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“ओटन ऐ इस्राएली भाईयाङ सनर बैनाङ, ङाजन थाहै लेया कि जे अन्जानत नै जेल्चिऊ, ओटन जेमि शासकयाङै बै नैताइन्याई रांढोव। <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />परमेस्वरलं ख्रीस्टले ओलजै दुख भोघिन्याई ताहा ऐलेस्यु सोगलै अगमबक्ताङल याह्‌लन रांछ्योङन्या अगमबानी ओले ऐलेस्यु पुरा आढोव। <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />नैताइस्यु पस्चाताप ढोचिते ओटन परमप्रभु लेऊदेए वल्चिते, कि जे पाप छेमा ग्याताइत्या, ओटन परमप्रभुल ल्योङन आनन्दल बेला रांन्यालेया, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />प्रभुङन आत्मिक सामर्थला बेला रांन्यालेया, सनर ओले पैलाई जे नाल्ट आछेलन्या येशुजन परिङन्या लेया। <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />परमेस्वरले ऐका कालखन्डकन्ज आमि पबित्र अगमबक्ताङल याह्‌लन आछ्योङन्या सोगलै जन्तुल फरि ताइन्या बेला आमाराऔ समन येशु स्वर्गल अबस्य लिज्यावपरिया। <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />मोशाले ऐलेस्यु लेऊ, ‘परमप्रभु परमेस्वरले ङाजन आसच्यानौमन जे दाज्यू भाईयाङ सनर दिदीबैनाङ खार्लन तोलोअ अगमबक्ता जे नाल्ट सच्यानस्याचिवा। ओले जेजन जो पानस्याचिऊ ना सोगलै छेन जे थटौ परिया।<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="DEU 18:15">ब्यबस्था १८:१५</ref>; <ref loc="DEU 18">१८</ref></char></note> <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />ऐटाइन्या लेया, कि परमेस्वरले ना अगमबक्ताङल छेन माथएन्या सोगलै परानीयाङजन रुयाङतन अलक जाटौरा ओटन नकाङ नस्ट ताइन्यालेरा।’”<note caller="-" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="DEU 18:19">ब्यबस्था १८:१९</ref></char></note><verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />“शमुएलतन रएस्यु नकाल छिन्टा सोगलै अगमबक्ताङ ज्वाएले छ्योङस्यु लेवाङ, ना सोगलैले आकाई दिनयाङल मुइस्यु लेरा। <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />ओटन जे नका अगमबक्ताङल सनर नकाई योजनाला सन्तानयाङ ज्या, जो बाचा परमेस्वरले जेमि शाखा अब्राहामस ऐलेस्यु आढोव, ‘नमी सन्तानत सनर पिरथ्बीला सोगलै जाहानले आशिर्बाद डोएन्यालेरा।’<note caller="-" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="GEN 22:18">उत्पत्ति २२:१८</ref> </char></note> <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />जे स्वाट्टैजन जेमि दुस्टताङन होलस्यु जेजन आशिर्बाद योङालेस्यु परमेस्वरले आसेबकजन आसच्यानौ ओटन सोगलै हादेए जेल्योङ आपरिङौ।”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">यहूदीयाङै घिन्या अदालतल लेऊक पत्रुस सनर यहुन्ना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />पत्रुस सनर यहुन्ना रुयाङस नेंछ्योङज्याऊक, पुजाउरोयाङ सनर मन्दिरला कप्तान ओटन सदुकीयाङ बै नकाने ल्योङ रांवाङ। <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />“प्रेरितयाङै जनताङजन ह्युउकौयन, येशुत सिन्या रुयाङ पुनरुत्थान ताइरा ऐराढोवकाले ओयाङ भ्या बिचलित ताइवाङ।” <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />तब ओयाङै नकानेजन राकोलोकौ, ओटन तयोअका छिम समन कैदल रांनाटौ, दानाङभन्या नवाए बेला ओइ ताइस्यु लेऊ। <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />तर बचन थएन्याङ मध्य तबर रुयाङै बिस्वास रांढोव, ओटन नकाङल बगाल बदिस्यु छ्योअ पास हजार ताइवाङ।<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />तयोअछिम्क नकाङल शासकयाङ ओटन अगवाङ सनर शास्त्रीयाङ यरुशलेमल दुउसिस्यु लिज्यावाङ। <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />मुख्या पुजाउरो हन्नास, कैयाफा, यहुन्ना, अलेक्जेन्डर सनर मुख्या पुजाउरोल जाहानयाङ जम्मै नल लिज्यावाङ। <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />नकाङै पत्रुस सनर यहुन्नाजन खार्ल सच्यानस्यु रांगिनौ, “नै सक्तिङन अथाबा काङ्काल मिनत झेन ईका झेनढोचिनु।”<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />तब पबित्र आत्माले भरिसिस्यु पत्रुसले नकाङजन ऐआढोवाङ, “ऐ रुयाङल शासकयाङ सनर अगवाङ, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />आछिम गे तोलोअ दुन्डा रुत तोलोअ चान्या काम गेढान्या बारेल ना नैति उपायले बेलौ ऐलेस्यु गिन्सिन्कन, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />जे सोगलैजन सनर इस्राएलला सोगल रुयाङजन थाह ग्याताइत्या, कि जो क्रूसतं जे केपन्या सनर परमेस्वरले सिन्यातन जिङदा आजाएन्या, ओइ नासरतला येशु ख्रीस्टल मिनता सक्तितन ईका रु जेल्यौकै बेलस्यु च्याङज्याया। <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />‘येशु नका तोलोअ ऐटाइन्या लुङ हो, जोल बारेल पबित्र शास्त्रल ऐटाइन्या सरसिज्याया, कि जो लुङजन जे कुर्मियाङै जेक्याइचिऊ नाजै आकअ ङएटा सुरलुङ ताइस्यु लेया।’<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="PSA 118:22">भजनसङ्ग्रह ११८:२२</ref>; <ref loc="DAN 2:34-35">दानियल २:३४-३५</ref></char></note> <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />अपुर काङ्काईत मुक्ति माल्दी, दानाङभन्या गे मुक्ति डोटौ नाल्ट नमत न्युउला रुयाङजन छुट्टै नैज मिन यांस्यु माल्सिदी।”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />जब नकाङै पत्रुस सनर यहुन्नाल साहस रांरङौ, ओटन इकाने अनपर सनर सोझा रुनें रैस ऐलेस्यु रा:सनौ, तब नकाङ छक्कै परिवाङ, ओटन इकाने येशु सकाए लिज्याऔने लेस्यु नकाङै रा:सनौ। <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />जब आसबेलन्या रुजन इकानेसं आच्याङज्यान्या रांरङौ, तब नकानेल बिपक्छेल नकाङ नैज छ्योङौ रांमाढुदुऊ। <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />ऐताइस्यु नकानेजन यहूदीयाङै घिन्या अदालतङन बाहेर हिनन्या आग्या यांस्यु नकाङै ऐलेस्यु रारांल छ्योङवाङ, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />“इकानेजन आब गे कैढान्याने? दानाङभन्या मछ्युजै इकानेतन तोलोअ अचम्मला काम ताइस्यु लेया ऐलेन्या यरुशलेमल चुङन्या जम्मैजन थाह ताइस्यु लेया, ओटन गे अहअ लेऊ माढुदुइदी। <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />तर ईका छेन जनताङ ल्योङ ताफैलित्या लेस्यु ‘फरि येशुल मिनतन काङ्काई रु सकाए झेन नैज ताछ्योङचिन’ ऐढान्याने रांचिते गे इकानेजन चेताउनी यांन्याई ताहा।”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />ओटन नकानेजन खुल्स्यु “आबकन येशुल मिनङन ताछ्योङचिन ओटन नैज सिक्छ्या तायोंचिन” ऐलेस्यु नकाङै आग्या रांयोव।<verse eid="ACT 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 4:19" />तर पत्रुस सनर यहुन्नानेंले नकाङजन जबाक नेंयोवाङ, “परमेस्वरलं बचन थटौभन्या जे छेन थएन्या परमेस्वरलं नजर त ठिक लेऊसन मालेऊ, जे जेईज निर्नय ढोचिते। <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />दानाङभन्या घोन घेनरङन्या सनर घेनथएन्या छेनयाङ घोन माछ्योङस्युकने ढुदुउज माढुदुचिदी।”<verse eid="ACT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21" />नकाङै सजाय यांन्या नैज उपाय मालस्यु नकानेजन अझ भ्याई धम्काईस्यु राराहौ, दानाङभन्या जो घटना घटिस्यु लेऊ नकाल नाल्ट सोगल रुयाङै परमेस्वरलं प्रसम्सा ढाज्यावाङ। <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />दानाङभन्या जो रु अचम्मला कामङन बेलन्या ताइस्यु लेऊ, नकाल उमेर चालिस बर्सतन यादेए लेऊ।<verse eid="ACT 4:22" /></para>
  <para style="s">बिस्वासीयाङलं प्रार्थना</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />ओटन नलन छुटकारा डोएस्यु पत्रुस सनर यहुन्नानेंले नेंन्हाएयाङ ल्योङ रांऔने, ओटन मुख्या पुजाउरोयाङ सनर सेरयाङै रांछ्योङन्या सोगलै छेन ओयाङजन नेपानस्योवाङ। <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />जब बिस्वासीयाङै ईका राथटौ, तब नकाङ तचोएकै परमेस्वर लेऊदेए घिन्या ग़ाले कलिऊस्यु ऐलेवाङ, “अं प्रभु, जोले स्वर्ग, पिरथ्बी, समुन्दर सनर नल लेन्या सोगल खाल्ला जन्तु स्रिस्टी नजाएनु,<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="EXO 20:11">प्रस्थान २०:११</ref>; <ref loc="NEH 9:6">नहेम्याह ९:६</ref>; <ref loc="PSA 146:6">भजनसङ्ग्रह १४६:६</ref></char></note> <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />जोले पबित्र आत्माङन आसेबक गे शाखा दाऊदल याह्‌लन ऐलेऊ,<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="PSA 2:1-2">भजनसङ्ग्रह २:१-२</ref></char></note> ‘गैरयहूदीयाङ दानाङ रायिङचो, ओटन रुयाङै माताइन्या छेनयाङ दानाङ यिङन्या धोर?<verse eid="ACT 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 4:26" />परमप्रभुल बिरोदल सनर ओलं अबिसिक्त जनल बिरोदल पिरथ्बीला रययाङ च्याङवाङ,</para>
  <para style="q" vid="ACT 4:26">ओटन शासकयाङ तचोएकै जम्मा ताइवाङ।’<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="PSA 2:1-2">भजनसङ्ग्रह २:१-२</ref></char></note><verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />दानाङभन्या मछ्यु नङ अबिसेक नढान्या, पबित्र नसेबक येशुल बिरोदत हेरोद सनर पन्तियस पिलातस नेंलोअनें ओटन गैरयहूदीयाङ सनर इस्राएलीयाङ सकाए ईकाइ सहरल दुउसिस्यु लेवाङ।<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="MAT 27:1-2">मत्ती २७:१-२</ref>; <ref loc="MRK 15:1">मर्कुस १५:१</ref>; <ref loc="LUK 23:1">लूका २३:१</ref>; <ref loc="JHN 18:28-29">यहुन्ना १८:२८-२९</ref>; <ref loc="ISA 61:1">यशैया ६१:१</ref></char></note> <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />नकाई ढाऔ नाल्ट नमी सक्तिङन सनर नयोजना अनुसार हाकन्जै ठहराइस्यु नल्‌नु। <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />आब औ परमप्रभु, नकाङल धम्कीयर्त नजर लाइते, ओटन नमी सेवाऱ्याङजन पुरा साहस सकाए न बचन छ्योङौ योंवरते, <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />ओटन सबेलौ नाल्ट नङ न कुई फैलाइते, न पबित्र सेबक येशुल मिनङन अचम्मला अचम्मला कामयाङ सनर कामयाङ ग्याताइरत्या।”<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />नकाङै प्रार्थना ढास्यु खेम्‌रापाइनाई नकाङ रादुउसिन्या पोल थरंर ताहौ, ओटन नकाङ सोगल पबित्र आत्माले भरपुर ताइवाङ, ओटन नकाङै साहस सकाए परमेस्वरलं बचन छ्योङवाङ।<verse eid="ACT 4:31" /></para>
  <para style="s">बिस्वासीयाङै रा:सम्पत सअता रांजाटौ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />ओटन बिस्वास ढान्याङल बगाल सोगलै तोलोअ यिङ सनर तोलोअ आत्माला ताइस्यु लेवाङ, ओटन नकाङ मध्य काङ्काईले बै आसम्पतलं नैज जन्तु ईका ङामि ज्या ऐमाल्दा, तर नकाङल सोगलै जन्तु सअता लेऊ।<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="ACT 2:44-45">प्रेरित २:४४-४५</ref></char></note> <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />नका प्रेरितयाङै भ्याई सक्तिसकाए प्रभु येशुल पुनरुत्थानल साची यांज्यावाङ, ओटन नकाङ सोगलैयर्त परमेस्वरलं घिन्या अनुग्रह लिज्याऔ। <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />नकाङ मध्य काङ्काईजन नैज छेनल अभाब मापरिडा, दानाङभन्या ज्वाए येङखेए या झिमबन लेऊ ना खसमयाङै यएस्यु नकाल येए प्रेरितयाङ ल्योङ होनन्याढोरा, <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />नका प्रेरितयाङल हाक नाएरा, ओटन जोजन जो जन्तुल अभाब ताह, ना नकाङजन भाअस्यौरा।<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />आब साइप्रस देसला लेबी कुलला योसेफ, जोजन प्रेरितयाङै बारनाबास ऐलेस्यु मिन रानाएस्योव (जोल अर्थ उत्साहलं ज़ा हो), <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />ईकाइ योसेफले आयेङ आयटौ ओटन ना रकम हिनस्यु प्रेरितयाङल हाक आनाएस्योवाङ।<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">हननिया सनर सफीरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />हननिया मिनला तोलोअ रु सनर आमेएमा सफीराले तकलाए नेंयेङ नेंयटौ, <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />ओटन येङल येएतन आमेएमाले आपानन्या अनुसार तचियाए बठा नेसकाए नेंनाटौ, ओटन अपुर बठा हिनस्यु प्रेरितयाङल हाक आनाटौ। <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />तर पत्रुसले ऐलेऊ, “ऐ हननिया, पबित्र आत्मास दानाङ ग्वारस्यु छ्योङन सनर यिङ झेनयएन्या येएतन झेन तबठा मोअन्या छेन कैलेस्यु सैतानले झेन यिङल आझोअस्यानु? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />नका यिङ आमायेहौ समन नैति नका झेनमि माताइज्याऔका? ओटन ना झेनमायटौ हादेए नैति नका झेन अढिकारलै मालज्याऔका? ऐटाइन्या काम ढान्या बिचार झेनयिङल कढाई रांऔ? झेन रुजन माङडी तर परमेस्वरजन जै ग्वारस्यु नाएचिना।” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />आका छेन थएस्यु हननिया नामल वङौ ओटन नाले आपरान आराहौ। नका थएन्याङ सोगलैल छ्याइ पसिऊ। <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />तब जवानयाङै च्याङस्यु नकाजन क्वाले मलिङस्यु बाहेर देए छेन्स्यु रालाङौ, ओटन रारीनौ।<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />नल जो ताइस्युलेऊ ना मासनस्युई छ्योअ तिन घन्टा छिन्ट नकाल आमेएमा बै भितरलं रांऔ। <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />ओटन पत्रुसले नाजन आगिनौ, “ङाजन पानस्याङते, झेन येङ नवाएलै झेनयएचिनु?” ओटन नकाले ऐलेऊ, “औ नवाएलै ज्या।”<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />तर पत्रुसले नकाजन ऐआढोव, “झेन कढाई सल्ला ढास्यु प्रभुल आत्माजन झेनअल्चिनु? थएते, नयोजन रींनन्याङ खिम्ते झलापतै लिज्यारा, ओटन नकाङै नङजन वुरस्यु पाखादेए लाङनरा।”<verse eid="ACT 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10" />ओटन ओचोएटै सफीरा ओलं खङ ल्यौक वङौ ओटन परान आराहौ। जब जवानयाङ भितर रांवाङ, नकाजन आसिन्या रङस्यु पाखाल वुरस्यु रालाङौ, ओटन नकाल आयोल नेराक रारीनौ। <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />सोगलै मन्डली यर्त सनर ईका छेन थएन्याङ सोगलैयर्त घिन्या छ्याइ परिऊ।<verse eid="ACT 5:11" /></para>
  <para style="s">अचम्म सनर हलाअताइन्या कामयाङ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />आब प्रेरितयाङ्ङन तबर अचम्मला सनर हलाअताइन्या कामयाङ रुयाङल खार्ल ताइवाङ, ओटन नकाङ सोगलै तोलोअ यिङला ताइस्यु सोलोमनल पटाहाल तचोएकै दुउसिन्या ढोरा। <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />तर अपुऱ्याङ मध्य काङ्काईल बै नकाङसं मिलिरान्या हिकमत माताइदा, ताहकन बै रुयाङै नकाङजन सम्मान रांढोव। <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />प्रभुत बिस्वास ढान्या ल्हेपाङ सनर मेएमाङ नेंलोअलै हुलझन्जै भ्याई चैइसिऊ तअसिवाङ, <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />इङ समन कि रुयाङै डोहा-डोहाल नाएबोरन्याङजन राहोन्वाङ, ओटन पत्रुस आरांऔक नकाल आजिरिउ याएज ताहकन बै नकाङ मध्य काङ्का-काङ्काङयर्त ग्यापरित्या लेस्यु तान सनर चारपाईयाङल नकाङजन सएप्‌स्यु रानाएवाङ। <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />ओटन यरुशलेमल हुङाआङा सहरलन बै तबर रुयाङै नाएबोरन्याङ सनर अशुद्दआत्माले आसताइन्याङजन राहोन्वाङ ओटन नकाङ सोगलै बेल्वाङ।<verse eid="ACT 5:16" /></para>
  <para style="s">प्रेरितयाङजन रा:सटाईन्या</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />मुख्या पुजाउरोयाङ सनर नकाङसं लिज्यान्याङ सोगलै जो सदुकी पत्तिला लेवाङ खिई ढास्यु प्रेरितयाङल बिरोदत च्याङवाङ, <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />ओटन प्रेरितयाङजन कोलोअस्यु सरकारी झ्यालखानाल राझोकौ। <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />तर प्रभुल तोलोअ स्वर्गदुतले रिउल झ्यालखानाला झलापयाङ आफएस्योवाङ, ओटन नकाङजन पाखाल हिनस्यु ऐआढोवाङ, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“हिन्चिते ओटन मन्दिरलं च्याङस्यु ईका छार जिबनला सोगलै थाई रुयाङजन सथएचिरते।” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />प्रेरितयाङै ईका थएरापाइना छकाल्याई मन्दिर भितरलं पसिस्यु सिक्छ्या यांऔ तअसिवाङ। तर मुख्या पुजाउरो सनर आन्हाएयाङ रांवाङ, ओटन यहूदीयाङै घिन्या अदालत अथाबा इस्राएलीयाङलं पुरै आराधना झिमला रुयाङजन रांखुल्वाङ, ओटन प्रेरितयाङजन झ्यालखानालन होन्चिते ऐलेस्यु आदेस यांस्यु रापरिङवाङ। <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />तर यहूदी अढिकारीयाङ नङ राटापौक नकाङै ओयाङजन झ्यालखानाल रांमाडोटौकाले वलस्यु रा:स्यु थाई रांयोवाङ, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“गे झ्यालखानाल जोगाइस्युई ताल गेलाइयिउ सनर वुइन्याङ झलाप तै राच्याङज्यान्या गेरङयिउ, तर झलाप गेफटौक भितरलं काङ्काईजन माडोएदुयो।” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />जब मन्दिरला कप्तान सनर मुख्या पुजाउरोयाङै आका थाई थएस्यु हलाअ ताइवाङ, तब ईका सोगलैल नतिजा नैति ताइन्या होला ऐलेस्यु नकाङ प्रेरितयाङ बारेङन अलमल्ल परिवाङ। <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />तर काङ्का तोलोअले नकाङजन रा:स्यु आपानस्योवाङ, “खिम्चिते, जे जो रुयाङजन झ्यालखानाल जेनाएचिवाङ नकाङ मन्दिरलं च्याङस्यु रुयाङजन सिक्छ्या यांज्यारा।” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />तब अढिकारीयाङ सकाए कप्तान हिनस्यु नकाङजन बलजफत माढास्युईज राहोन्वाङ, दानाङभन्या रुयाङै अढिकारीयाङ सनर कप्तानयाङजन लुङले टुपरा ऐलेस्यु छ्याएवाङ।<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />नकाङै प्रेरितयाङजन हिनस्यु यहूदीयाङै घिन्या अदालतल हाक रा:सच्यान्वाङ, ओटन मुख्या पुजाउरोयाङै नकाङजन रांगिन्वाङ, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />“गे जेजन नका मिनङन नैज सिक्छ्या मायान्या कडा आग्या गेया:सिनु, तर जे सिक्छ्याले सोगल यरुशलेमल भरिस्यु खेम्दा, ओटन येशुल जी बगिइल दोस गेयर्त होनौ जेरोअचिऊ।”<note caller="-" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">मत्ती २७:२५</ref></char></note> <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />तर पत्रुस सनर अपुर प्रेरितयाङै ऐलेवाङ, “गे रुयाङल माङडी तर परमेस्वरलं आग्या पालन ढान्याईजै ताहा। <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />गे पुर्खाङल परमेस्वरले येशुजन सिन्यातन जिङदा आजाटौ, जोजन जे सिङत खिलथुकिस्यु केप्स्यु जेसएचिऊ।<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="DEU 21:22-23">ब्यबस्था २१:२२-२३</ref></char></note> <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />परमेस्वरले इस्राएललं पस्चातापल नाल्ट सनर नकाङल पापल छेमा यांन्या वाला येशुजन रय सनर मुक्तिदाता ठहऱ्याइस्युकने आदाइन्या घोनले हर्त आजाटौ।<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="LUK 24:47">लूका २४:४७</ref></char></note> <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />ईका सोगलै छेनल गे साची लेया, ओटन नैताइस्युई पबित्र आत्मा बै, परमेस्वरले जोले आ आग्या पालन धोर नकाङजन यांस्यु आनाएवाङ।”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />तर जब यहूदीयाङै घिन्या अदालतला सदस्याङै ईका राथटौ, तब आवाए रारिऊ उठिऊ, कि नकाङै प्रेरितयाङजन सटौजै रारोकौ। <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />तर ब्यबस्थाला भाबनयाङ सनर जनताङ्ङन मानिसिन्या गमलिएल मिनला फरिसीले महासभालं च्याङस्यु प्रेरितयाङजन तचोए बाहेर देए हिनन्या लेस्यु आदेस आयोवाङ, <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />ओटन गमलिएलले महासभाला रुयाङजन ऐआढोवाङ, “ऐ इस्राएलीयाङ, ईका रुयाङजन जे जो ढान्या जेआन्तिज्याचिऊ, नकात होसियार ताइचिते। <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />दानाङभन्या आकअ याएज माङडी हाक बै थुदासले ङा काङ्का ऐलेन्या जिग्राइ आढोव ओटन छ्योअ चार सय रुयाङ नकाल छिन्ट लागिवाङ। नका सएसिऊ, ओटन नकाल छिन्ट लागिन्याङ सोगलै सेरासेट्ट ताइवाङ ओटन सोगलै असफल ताइवाङ। <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />ईका रुल छिन्ट जनगननाल बेला गालीलला यहूदा ऐराढान्या च्याङौ, ओटन ख्वाएयाए रुयाङजन आलेऊदेए आच्योङवाङ। ना बै नस्ट ताइदा, ओटन नकाजन मानिन्याङ हुदेएअदेए सेरासेट्ट ताइस्यु असफल ताइवाङ। <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />ओटन आका मामलाल ङा जेजन ऐढाच्या, कि ईका रुयाङत अलक्कै चुङचिते, ओटन इकाङजन राइचिरते, दानाङभन्या इकाङल आका योजना अथाबा आका काम रुयाङ्ङन ताहकन ना ओलजै मिटीसिया। <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />तर यदि आका परमेस्वरङन्ता हो भन्या जे इकाङजन रुकिऊ माढुदुचिदी। मानकन्ता जे परमेस्वरलं बिरोदल जेच्याङन्या ठहरिच्या।”<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />तब नकाङै थुदासलं सल्ला रामानिऊ। ओटन नकाङै प्रेरितयाङजन महासभा भितरलं खुल्स्यु रातुप्वाङ, ओटन “येशुलं मिनङन ताछ्योङच्यो” ऐलेन्या आग्या यांस्यु नकाङजन राराइवाङ। <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />जब प्रेरितयाङै आराधना झिम राराहौ, नकाङ हेसाङस्यु आनन्द ताइवाङ दानाङभन्या परमेस्वरले नकाङजन येशुल मिनत अपमान सहिन्या लायकला आठहराइवाङ। <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />ओटन दिनकाईज नकाङै मन्दिरलं सनर झिम-झिमल हिनस्यु येशु जै ख्रीस्ट ज्या ऐलेस्यु ह्युउन्या सनर प्रचार ढान्या माराइदुरा।<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">साट वटा व्‌एन्याङ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />नका दिनल जब सिइयाङल बगाल बदिऊयन हिनज्याऔ, तब हिब्रूयाङल बिरोदल ग्रीक-यहूदीयाङ गनगन लेवाङ, दानाङभन्या दिनकाई अन राभाकौक ओला बिदवाङ राचाहिन्या याए ज्यान्या रांमाडोटौ। <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />तब बारं गोटाई सिइयाङल बगालजन खुल्स्यु ऐराढोव, “परमेस्वरलं बचन प्रचार ढान्या राइस्यु यांईन्या-ओएन्याल सेवा गे ढान्या ईका ठिक माङडी। <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />नैताइस्यु दाज्यूभाई दिदीबैनाङ, जेमध्य पबित्र आत्मा सनर बुद्दिले भरिसिन्याङ सनर सोगलैले ग्रहन राढान्या साट वटा रुयाङ छेल्चिरते जोजन गे ईका कामत खटाहौ ग्याढुदुयित्या। <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />तर गे प्रार्थना सनर बचनल सेवाकाईत सोगल समाय यांन्या लेया।”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />आका छेनत बगालला सोगल रुयाङल रायिङहुकौ, ओटन दुउसिन्या सोगलैजन चान्या लागिऊ, ओटन नकाङै पबित्र आत्मा सनर बिस्वासले भरपुरी ताइन्या स्तिफनस, फिलिप, प्रखरस, निकनोर, तीमोन, पर्मिनास सनर एन्टिओखियाला यहूदी परम्परा मानिन्या निकोलाउसजन रांछेलौ। <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />नकाङै ईका रुयाङजन प्रेरितयाङल सामन्दी राहोनौ, ओटन प्रेरितयाङै राकुई नाएस्यु नकाङल नाल्ट प्रार्थना रांढोव।<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />परमेस्वरलं बचन बदिऊयन हिनौ, ओटन सिइयाङल बगाल यरुशलेमल भ्याईजै बदिऊ। पुजाउरोयाङ मध्य तबर गोटाले ईका बिस्वासजन ग्रहन रांढोव।<verse eid="ACT 6:7" /></para>
  <para style="s">स्तिफनसजन राकोलोकौ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />स्तिफनस परमेस्वरलं अनुग्रह सनर सक्तिले भरपुर ताइस्यु, रुयाङल खार्ल घिन्या-घिन्या अचम्मला काम सनर रंनन्या काम आढोव। <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />तर काङ्का-काङ्काङ जो स्वतन्त्र-बगालला यहूदीयाङल आराधना झिमयाङ (इकाङल मिन ईकाइ लेऊ), ओटन कुरेनी, अलेक्जेन्ड्रिया, किलिकिया सनर एशियाला रुयाङ लेवाङ, नकाङै च्याङस्यु स्तिफनस सकाए छलफल ढाऔलागिवाङ। <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />स्तिफनस जब बुद्दि सनर पबित्र आत्माङन छ्योङौ, तब नकाङै नकाल बिरोदत टनौ रांमाढुदुऊ। <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />तब नकाङै गोप्यल रुयाङजन मच्चाईस्यु ऐलेऊ रापरिङवाङ, “मोशा सनर परमेस्वरलं बिरोदल इकाले गिलल्याइस्यु आछ्योङन्या छेन गे गेथएयिउ।” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />तब नकाङै जनताङल अगवा सेरयाङ सनर शास्त्रीयाङजन घूस या:स्यु, ओटन नकाङजन हमला रांढोव, ओटन कोलोअस्यु महासभालं राहोन्वाङ। <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />नकाङै ऐटाइन्या छ्योङन्या ग्वारवा साचीयाङजन हादेए रापरिङवाङ, “ईका रुले पबित्र पो सनर ब्यबस्थालं बिरोदत छेन छ्योङन्या माराइज्यादी।<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JER 26:11">यर्मिया २६:११</ref></char></note> <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />दानाङभन्या इकाले ऐआलन्या गे गेथएयिउ, ‘नासरतला येशुले ईका पोजन नास जाएन्यालेया, ओटन मोशाले गेजन आयांन्या रीतिथिति बै फिरिन्यालेया।’” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />महासभालं चुङज्यान्याङ सोगलैले इस्तिफनसजन दवलसै रांखिमौ, ओटन नकाल अनवार स्वर्गदुतल अनवार मनताइन्याई रांरङौ।<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">स्तिफनसल भासन</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />तब मुख्या पुजाउरोले स्तिफनसजन आगिनौ, “नैति ईका छेन मछ्यु रों?” <verse eid="ACT 7:1" /><verse number="2" style="v" sid="ACT 7:2" />नकाले ऐलेऊ “ऐ दाज्यूभाई दिदीबैनाङ सनर बौ बाज्याङ, थएचिते। महिमाला परमेस्वरले गेमि पितामह अब्राहामजन नका हारानल आचुङौ हादेए मेसोपोटामियाल आलिज्याऔक दर्शन आयोव, <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />ओटन अब्राहामजन ऐआढोव, ‘नङ न देस सनर न जाहानयाङ्ङन पलिईस्यु, जो देस ङा नङजन ठन्स्यान, नङै हिनन्ते।’”<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="GEN 12:1">उत्पत्ति १२:१</ref></char></note> <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />“तब अब्राहाम कल्दीयाङल देसलन पलिईस्यु हारानल रा:स्यु चुङौ, ओटन नकाल आबौ आसिऊ छिन्ट परमेस्वरले ओलजन नङंन आका मलुउलं आसराहौ, जोङ आकअ जे जेचुङज्याचिऊ। <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />नकाजन ना पोल धनसम्पत ता हुदेएज ग्याहिनत्या, सील नाएन्या पो समन बै मायोडा। तर नकाल सन्तानयाङ मालरकन बै नका धनसम्पत परमेस्वरले नकाल सन्तानजन आपेवाला सम्पतल हिसापत यांन्या बाचा आढोव।<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="GEN 13:15">उत्पत्ति १३:१५</ref>; <ref loc="GEN 15:18">उत्पत्ति १५:१८</ref>; <ref loc="GEN 16:1">उत्पत्ति १६:१</ref>; <ref loc="GEN 24:7">उत्पत्ति २४:७</ref>; <ref loc="DEU 2:5">ब्यबस्था २:५</ref>; <ref loc="DEU 11:5">ब्यबस्था ११:५</ref> </char></note> <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />परमेस्वरले ऐआढोव, ‘न सन्तान छुट्टै देसलं हिनस्यु चारसय बर्स समन चुङौ परिन्या लेया, ओटन ओयाङै इकाङजन कमारा जाएस्यु चारसय बर्स समन दमन ढास्यु नाएन्या लेरा।’<note caller="-" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="GEN 15:13-14">उत्पत्ति १५:१३-१४</ref>; <ref loc="EXO 2:22">प्रस्थान २:२२</ref></char></note> <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />परमेस्वरले ऐलेऊ ‘तर नकाङ जो जातिल सेवाऱ्या ताइस्यु चुङर ना जातिल निया ङा ढान्यालेङा। ओलं छिन्ट नकाङ पलिईस्यु रा:स्यु ईकाइ पोल ङामि आराधना ढान्यालेरा।’<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="GEN 15:14">उत्पत्ति १५:१४</ref>; <ref loc="EXO 3:12">प्रस्थान ३:१२</ref> </char></note> <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />परमेस्वरले अब्राहामस खटनाल बाचा आढोव, ओटन अब्राहाम इसहाकलं बौ आताहौल छिन्क आट दिन छिम्क इसहाकलं खटना<note caller="+" style="f"><char style="fr" closed="false">7:8 </char><char style="ft" closed="false">ल्हेपाङल गुप्त कलाङल रापलन्या </char></note> आढोव। इसहाक याकूबल बौ ताहौ, ओटन याकूब बारैं गोटा कुलल बौ ताहौ।”<note caller="-" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="GEN 17:10-11">उत्पत्ति १७:१०-११</ref>; <ref loc="GEN 21:4">उत्पत्ति २१:४</ref> </char></note><verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />“याकूबल ज़ायाङै रांभाई योसेफजन खिई ढास्यु ओलजन मिस्र देसलं रायेटौ। तर परमेस्वर ओलसं लेऊ।<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="GEN 37:11">उत्पत्ति ३७:११</ref>; <ref loc="GEN 37:28">उत्पत्ति ३७:२८</ref>; <ref loc="GEN 39:2-3">उत्पत्ति ३९:२-३</ref>; <ref loc="GEN 45:4">उत्पत्ति ४५:४</ref> </char></note> <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />परमेस्वरले नकाल सोगल कस्टङन छुताइस्यु मिस्र देसला रय फारोल सामन्दी नकाजन दया आढोव, ओटन बुद्दि आयोव, ओटन फारोले नकाजन मिस्र देस सनर आमि सोगल झिमला हाकिम आजाटौ।”<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="GEN 39:21">उत्पत्ति ३९:२१</ref>; <ref loc="GEN 41:40">उत्पत्ति ४१:४०</ref>; <ref loc="GEN 41:43">उत्पत्ति ४१:४३</ref>; <ref loc="GEN 41:46">उत्पत्ति ४१:४६</ref>; <ref loc="PSA 105:21">भजनसङ्ग्रह १०५:२१</ref> </char></note><verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />नालछिन्ट सोगल मिस्र देस सनर कनानल अनिकाल परीस्यु घिन्या दुख ताहौ, ओटन गे पुर्खाङै अन माडोएदुरा।<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="GEN 41:54-55">उत्पत्ति ४१:५४-५५</ref>; <ref loc="GEN 42:5">उत्पत्ति ४२:५</ref></char></note> <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />तर याकूबले मिस्र देसलं अन लेऊ ऐलेन्या छेन थएस्यु गे पुर्खाङजन पहेलाचोए नङ आपरिङवाङ।<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="GEN 42:2">उत्पत्ति ४२:२</ref></char></note> <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />नेंपालाका डोएसिइ त योसेफले आदाज्यू भाईयाङजन आपरिचय आयोवाङ, ओटन योसेफल जाहानयाङ बै फारो ल्योङ आशई ताइवाङ।<note caller="-" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="GEN 45:1">उत्पत्ति ४५:१</ref>; <ref loc="GEN 45:3">उत्पत्ति ४५:३</ref>; <ref loc="GEN 45:16">उत्पत्ति ४५:१६</ref> </char></note> <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />योसेफले आबौ याकूबजन सनर आमि सोगलै शाखासन्तानयाङजन, जो पचहत्तर परानी लेवाङ, आल्योङ खुलौ आपरिङवाङ।<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="GEN 45:9-11">उत्पत्ति ४५:९-११</ref>; <ref loc="GEN 45:18-19">उत्पत्ति ४५:१८-१९</ref>; <ref loc="EXO 1:2">प्रस्थान १:२</ref>; <ref loc="DEU 10:22">ब्यबस्था १०:२२</ref> </char></note> <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />याकूब मिस्र देसलं हिनौ, ओटन नङै सिऊ, ओटन गे शाखापुर्खाङ बै ओलै सिवाङ।<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GEN 45:5-6">उत्पत्ति ४५:५-६</ref>; <ref loc="GEN 49:33">उत्पत्ति ४९:३३</ref>; <ref loc="EXO 1:6">प्रस्थान १:६</ref> </char></note> <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />ओलं छिन्ट नकाङल सिन्या बुल शकेमल रालाङौ, ओटन अब्राहामले शकेमल हमोरल ज़ायाङ ल्योङन चान्दील पैसा फोअस्यु आलङन्या ऊईल रानाएवाङ।<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="GEN 23:16-17">उत्पत्ति २३:१६-१७</ref>; <ref loc="GEN 33:19">उत्पत्ति ३३:१९</ref>; <ref loc="GEN 49:29-30">उत्पत्ति ४९:२९-३०</ref>; <ref loc="GEN 50:13">उत्पत्ति ५०:१३</ref>; <ref loc="JOS 24:32">यहोशू २४:३२</ref> </char></note><verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />“तर जब परमेस्वरले अब्राहाम सकाए आढान्या बाचा पुरा ताइन्या बेला नेरा रांऔ, तब मिस्र देसलं नका रुयाङ बदिऊ लागिवाङ, ओटन नकाङल बगाल भ्याईजै ताइवाङ। <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />तब मिस्र देसलं योसेफजन माशईन्या छुट्टै रय च्याङौ।<note caller="-" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="EXO 1:7-8">प्रस्थान १:७-८</ref> </char></note> <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />ओ रयले गे जातियाङसं क्याइसिन्या बानी बेहोरा आढोव, ओटन गे पुर्खाङजन रांमि लुलल्याङ पाखाल हिनस्यु नाएन्या कर आलाइवाङ, ओटन ऐलेस्यु भाबाअ जर्मिन्या सोगलै लुलल्याङजन रासएवाङ।”<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="EXO 1:9-10">प्रस्थान १:९-१०</ref>; <ref loc="EXO 1:18">प्रस्थान १:१८</ref>; <ref loc="EXO 1:22">प्रस्थान १:२२</ref></char></note><verse eid="ACT 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20" />“नवाए बेलाई मोशाल जन्म ताहौ। मोशा परमेस्वरलं नजरत चान्या लेऊ। नका तिन मैना समन आबौल झिमल ङासिऊ।<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="EXO 2:2">प्रस्थान २:२</ref></char></note> <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />नका पाखाल क्याइसियापाइना फारोल मेएमाज़ाले नाजन छेन्स्यु आलाङौ, ओटन आमिई ज़ामन जाएस्यु आमोव।<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="EXO 2:5">प्रस्थान २:५</ref>; <ref loc="EXO 2:10">प्रस्थान २:१०</ref></char></note> <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />मोशाजन मिस्रीयाङल सोगल पाठशालाल सिक्छ्या यांसिऊ, ओटन मोशा आमि बचन सनर कामत सक्तिशाली ताहौ।”<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />“जब मोशा चालिस बर्सका ताहौ, तब नकाले इस्राएली दाज्यूभाई दिदीबैनाङजन कैताइन्या ब्यबहार ढाज्यावाङ ऐलेस्यु नकाङसं डोएसिन्या यिङ आढोव।<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="EXO 2:11">प्रस्थान २:११</ref></char></note> <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />आमि जातला भाई मध्य तोलोअल यर्त अनिया आताइज्यान्या रङस्यु, नकाले ओजन आजोगाहौ, ओटन नका अनिया ढान्या मिस्रजन सएस्यु आभाईजन आताइन्या अत्याचारल पालो आहोलौ।<note caller="-" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="EXO 2:12">प्रस्थान २:१२</ref> </char></note> <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />परमेस्वरले ङा कुईतन नकाङल उद्दार ढोवा ऐलेन्या ङा भाईबन्दयाङै ऐबुझिरा लेस्यु नाले बिचार ढाज्याऔ। तर नकाङै ईका माबुजिदुरा। <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />तयोअ इस्राएलीयाङ रारां रा:यिसिज्याऔ बेलाक मोशा रांऔ, ओटन नकाङजन मिलाइङा लेस्यु ऐआढोवाङ, ‘ऐ भाईयाङ, जे ता दाज्यू भाईयाङ दी, तब दानाङ तोलोअले छुट्टैजन अनिया ढाज्याच्यो?’”<verse eid="ACT 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27" />“तर आदेराला रु यर्त अनिया ढान्याले मोशाजन ऐढास्यु आठुहौ, ‘गे यर्त शासन चलाइन्या सनर नियाकर्ता ताइन्या नङजन काङ्काले आठहराइनु? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />ज्योलाअ ना मिस्रजन नसटौमन नङ ङाजन बै सटौ नरोअनु?’<note caller="-" style="x"><char style="xo" closed="false">7:28 </char><char style="xt" closed="false"><ref loc="EXO 2:13-14">प्रस्थान २:१३-१४</ref></char></note> <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />ऐटाइन्या जबाक थएस्यु मोशा ढोङस्यु मिद्यान देसलं हिनस्यु प्रदेसी ताहौ। नङ मोशाल नेंलोअ आज़ाने जर्मिऊने।”<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="EXO 2:15-22">प्रस्थान २:१५-२२</ref>; <ref loc="EXO 18:3-4">प्रस्थान १८:३-४</ref> </char></note><verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />“चालिस बर्स आबितिऊ छिन्ट सिनै पर्बतल हरहर तांन्या पोल भलाङज्यान्या पथरक्यांल भुबरात तोलोअ स्वर्गदुत नका ल्योङ रंनौ।<note caller="-" style="x"><char style="xo" closed="false">7:30 </char><char style="xt" closed="false"><ref loc="EXO 3:1">प्रस्थान ३:१</ref> </char></note> <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />जब मोशाले ईका आरङौ तब नका अचम्मै ताहौ, ओटन नकाले चान्यासं खिमन्यालेस्यु नेराक आहिनौक परमप्रभुल ऐटाइन्या ग़ा आठटौ,<note caller="-" style="x"><char style="xo" closed="false">7:31 </char><char style="xt" closed="false"><ref loc="EXO 3:2-3">प्रस्थान ३:२-३</ref></char></note> <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘ङा न पुर्खाङल परमेस्वर हो अब्राहाम, इसहाक, सनर याकूबल, परमेस्वर।’ मोशा वुकौ तअसिऊ, ओटन नकाले नदेए ब्याएन्या आमाआन्टिदुउ।”<verse eid="ACT 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33" />“तब परमप्रभुले नाजन ऐआढोव, ‘नखङला जुता फिरते, दानाङभन्या जो पोल नङ च्याङज्यान, नका पबित्र पो हो।<note caller="-" style="x"><char style="xo" closed="false">7:33 </char><char style="xt" closed="false"><ref loc="EXO 3:5">प्रस्थान ३:५</ref></char></note> <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />मिस्रल लिज्यान्या ङा जनताङ दुर्दशा ङारङ्ङु, ओटन नकाङ राआतिइले राव्‌रन्या बै ङा थएङु। नैताइस्यु नकाङजन छुटकारा यांऔ नाल्ट ङा लांइस्यु ङारांङु हो। आब रांन्ते, ङा नङजन मिस्र देसलं परिङना।’”<note caller="-" style="x"><char style="xo" closed="false">7:34 </char><char style="xt" closed="false"><ref loc="EXO 2:24">प्रस्थान २:२४</ref>; <ref loc="EXO 3:7-10">प्रस्थान ३:७-१०</ref> </char></note><verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />“ईकाइ मोशा हो, जोजन इस्राएलला रुयाङै ऐलेस्यु रांगिनौ, नङजन काङ्काले गेयर्त शासक सनर नियाकर्ता आजाएनु। ऐलेस्यु नकाङै रामाभनस्योव, नकाजन परमेस्वरले पथरक्यांत रंनन्या स्वर्गदुतङन हाकिम सनर सङ्कटतन बचाइन्या जाएस्यु आपरिङौ।<note caller="-" style="x"><char style="xo" closed="false">7:35 </char><char style="xt" closed="false"><ref loc="EXO 2:14">प्रस्थान २:१४</ref>; <ref loc="EXO 3:2">प्रस्थान ३:२</ref></char></note> <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />ईकाइ रुले मिस्र देसला, लाल समुन्दरल सनर चालिस बर्स भरि जङ्गलला पोल मारंनन्या काम सनर अचम्मला कामयाङ ढास्युकने नकाङजन बाहेर आहोन्वाङ।”<note caller="-" style="x"><char style="xo" closed="false">7:36 </char><char style="xt" closed="false"><ref loc="EXO 7:3">प्रस्थान ७:३</ref>; <ref loc="EXO 14:21">प्रस्थान १४:२१</ref>; <ref loc="NUM 14:33">गन्ती १४:३३</ref></char></note><verse eid="ACT 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37" />“ना ओइ मोशा ज्या, जोले इस्राएलीयाङजन ऐढास्यु आनाएवाङ, ‘परमेस्वरले ङाजन आसच्यानौमन्जै जे नाल्ट तोलोअ अगमबक्ता सच्यानवा।’<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="DEU 18:15-18">ब्यबस्था १८:१५-१८</ref> </char></note> <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />ओ नाइ मोशा ज्या, जो जङ्गलला पोल लिज्यान्या समुदायल स्वर्गदुतस लेऊ, जो स्वर्गदुतले सिनै पर्बतल सनर गे पुर्खा सकाए छ्योङस्यु लेऊ, ओटन नकाले गेजन यांऔ नाल्ट जिङदा बचनयाङ डोएस्यु आनाटौ।”<note caller="-" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EXO 19:1-6">प्रस्थान १९:१-६</ref>; <ref loc="EXO 20:1-17">प्रस्थान २०:१-१७</ref>; <ref loc="DEU 9:10-11">ब्यबस्था ९:१०-११</ref></char></note><verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />“गे पुर्खाङै मोशाल आग्या मानिन्या माभन्वाङ। नकाङै ओजन बनाएस्यु मिस्र देसदेए वलस्यु हिनन्या यिङ रांढोव।<note caller="-" style="x"><char style="xo" closed="false">7:39 </char><char style="xt" closed="false"><ref loc="EXO 23:20-21">प्रस्थान २३:२०-२१</ref>; <ref loc="NUM 14:3-4">गन्ती १४:३-४</ref> </char></note> <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />नकाङै हारुनजन ऐराढोव, ‘गे नाल्ट गेहाहां बान्या कोबाअ देउताङ जाएस्यासिन्ते, दानाङभन्या गेजन मिस्र देसङन पलिईस्यु होनन्या ईका मोशाजन नैति ताहौ गे मासनैदी।’<note caller="-" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="EXO 32:1">प्रस्थान ३२:१</ref>; <ref loc="EXO 32:23">प्रस्थान ३२:२३</ref></char></note> <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />नका दिनल नकाङै तोलोअ बाछालं सुरुप रांजाटौ, ओटन नकात बलि बै रांचराहौ, ओटन राकुईले राढान्या कामत हेसाङवाङ।<note caller="-" style="x"><char style="xo" closed="false">7:41 </char><char style="xt" closed="false"><ref loc="EXO 32:4-6">प्रस्थान ३२:४-६</ref> </char></note> <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />नैताइस्यु परमेस्वर नकाङल्योङन ह्याऔ, ओटन नकाङजन नमता हरवएयाङल पुजा ढान्या आराइवाङ, जोमनलेस्यु अगमबक्ताङल किटापल सरसिज्याया, ‘इस्राएलला रुयाङ! चालिस बर्स समन हरहर ताइन्या पोल जे पशु सएस्यु जेचराइन्या बलि ङा नाल्ट माङडी?<note caller="-" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="JER 7:18">यर्मिया ७:१८</ref>; <ref loc="JER 8:2">यर्मिया ८:२</ref>; <ref loc="JER 19:13">यर्मिया १९:१३</ref> </char></note> <verse eid="ACT 7:42" /><verse number="43" style="v" sid="ACT 7:43" />जे मोलोखल तिरपाल सनर रेफन देउताल हरवए ओटन पुजिऊ नाल्ट जेजाएन्या मुर्तियाङ छेन्स्यु जेलाङचिऊ। आब ङा जेजन बेबिलोनतन हूत सराइच्या।’”<note caller="+" style="f"><char style="fr" closed="false">7:43 </char><char style="ft" closed="false">आमोस ५:२५-२६ </char></note><verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />“गे पुर्खाङस हरहर ताइन्या पोल परमेस्वरलं साचील तिरपाल लेऊ, मोशाले आरङन्या नक्कल अनुसार परमेस्वरले ओलजन जाएते ऐआढोव।<note caller="-" style="x"><char style="xo" closed="false">7:44 </char><char style="xt" closed="false"><ref loc="EXO 25:1-40">प्रस्थान २५:१-४०</ref>; <ref loc="EXO 25:40">प्रस्थान २५:४०</ref>; <ref loc="EXO 27:21">प्रस्थान २७:२१</ref>; <ref loc="NUM 1:1-50">गन्ती १:१-५०</ref> </char></note> <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />ओलं छिन्ट गेमि पुर्खाङै जोले नकाङल पुर्खाङ्ङन यहोशू सकाए तिरपाल हिनस्यु हादेए बदिस्यु रांहिनौक परमेस्वरले आढपाइन्या गैरयहूदीयाङल देसला रनबन रांमी अधिकारत राहोनौ। ना दाऊदल पालासमन नङै लिज्याऔ।”<note caller="-" style="x"><char style="xo" closed="false">7:45 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">यहोशू ३:१४-१७</ref>; <ref loc="JOS 18:1">यहोशू १८:१</ref>; <ref loc="JOS 23:9">यहोशू २३:९</ref>; <ref loc="JOS 24:18">यहोशू २४:१८</ref></char></note> <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />नकाले परमेस्वरलं अनुग्रह आडोटौ, ओटन याकूबल परमेस्वरलं नाल्ट तोलोअ चुङन्या पो जाएन्या अनुमति नीऊ।<note caller="-" style="x"><char style="xo" closed="false">7:46 </char><char style="xt" closed="false"><ref loc="2SA 7:2-16">२शमूयल ७:२-१६</ref>; <ref loc="1KI 8:17-18">१राजा ८:१७-१८</ref>; <ref loc="1CH 17:1-14">१इतिहास १७:१-१४</ref>; <ref loc="2CH 6:7-8">२इतिहास ६:७-८</ref>; <ref loc="PSA 132:5">भजनसङ्ग्रह १३२:५</ref> </char></note> <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />तर परमेस्वरलं नाल्ट झिम सोलोमनले आजाटौ।<note caller="-" style="x"><char style="xo" closed="false">7:47 </char><char style="xt" closed="false"><ref loc="1KI 6:1-2">१राजा ६:१-२</ref>; <ref loc="1KI 6:14">१राजा ६:१४</ref>; <ref loc="1KI 8:19-20">१राजा ८:१९-२०</ref>; <ref loc="2CH 3:1-2">२इतिहास ३:१-२</ref>; <ref loc="2CH 5:1-2">२इतिहास ५:१-२</ref>; <ref loc="2CH 6:2">२इतिहास ६:२</ref>; <ref loc="2CH 6:10">२इतिहास ६:१०</ref> </char></note><verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />तर कुईले जाएसिन्या झिमजिऊल परमेस्वर माचुङडी, जोमनलेस्यु अगमबक्ताङै ऐलेस्यु लेवाङ,<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />ङामि सिहासन स्वर्ग ज्या,</para>
  <para style="q2" vid="ACT 7:49">ओटन पिरथ्बी ङा खङबाङ,</para>
  <para style="q1" vid="ACT 7:49">जे ङा नाल्ट कैताइन्या झिम जाएन्या हो?</para>
  <para style="q2" vid="ACT 7:49">परमप्रभुले ऐलेया, ङा नानसिन्या पो काङ हो?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />ईका सोगल जन्तु ङा कुईलेई ङाजाएन्या माङडी का?<note caller="-" style="x"><char style="xo" closed="false">7:50 </char><char style="xt" closed="false"><ref loc="ISA 66:1-2">यशैया ६६:१-२</ref></char></note><verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />“ऐ चिमत्या रुयाङ, जरन्या यिङ सनर भैरा ना लेन्याङ, जे सदाई पबित्र आत्माल बिरोद ढाज्याच्या। जे पुर्खाङै जोमन लेवाङ जे बै नैज लिज्याच्या।<note caller="-" style="x"><char style="xo" closed="false">7:51 </char><char style="xt" closed="false"><ref loc="EXO 32:9">प्रस्थान ३२:९</ref>; <ref loc="LEV 26:41">लेवी २६:४१</ref>; <ref loc="NUM 27:14">गन्ती २७:१४</ref>; <ref loc="ISA 63:10">यशैया ६३:१०</ref>; <ref loc="JER 6:10">यर्मिया ६:१०</ref>; <ref loc="JER 9:26">यर्मिया ९:२६</ref></char></note> <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />जे पुर्खाङै अगमबक्ताङ मध्य काङ्काजन रामासटाहौ का? गैरयहूदीयाङै सच्चा रुल आगमन आताहौ हादेए प्रचार ढान्या सोगलैल हत्या रांढोव। ओलं हत्या जेढोचिऊ। नकाङ सोगलैजन रासएवाङ, जोयाङै ना धर्मि रु रांन्या बाए हाकन्जै रा:सथएचिऊ। आब जे ओलै बिस्वासघाटी सनर साइढवा ताइस्युलेच्या।<note caller="-" style="x"><char style="xo" closed="false">7:52 </char><char style="xt" closed="false"><ref loc="2CH 36:16">२इतिहास ३६:१६</ref> </char></note> <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />स्वर्गदुतयाङै रा:सुम्पिन्या ब्यबस्था जे डोएदुच्या, तर नकाल पालन जेमाढोचिऊ।”<verse eid="ACT 7:53" /></para>
  <para style="s">स्तिफनसजन लुङले ताप्स्यु रासएन्या</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />जब माहासभाहाला सदस्याङै ईका छेन राथटौ तब नकाङ चिरिऊ ताइवाङ ओटन रिईले रांह्वा ग्रिबग्रीब कयौ लागिवाङ।<note caller="-" style="x"><char style="xo" closed="false">7:54 </char><char style="xt" closed="false"><ref loc="JOB 16:9">अय्यूब १६:९</ref>; <ref loc="PSA 35:16">भजनसङ्ग्रह ३५:१६</ref>; <ref loc="PSA 37:12">भजनसङ्ग्रह ३७:१२</ref>; <ref loc="PSA 112:10">भजनसङ्ग्रह ११२:१०</ref> </char></note> <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />तर स्तिफनसले पबित्र आत्माङन भरिपुरी ताइस्युकने नमदेए ध्यानसं आखिमौ, ओटन परमेस्वरलं महिमा सनर येशुजन परमेस्वरलं दाइन्याङन आच्याङज्यान्या आरङौ। <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />नकाले ऐलेऊ खिम्चिते, “ङा स्वर्ग आफएसिन्या ङारङ्ङु, ओटन रुल ज़ाजन परमेस्वरलं दाइन्याङन आच्याङज्यान्या ङा ङारङ्ङु।”<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />तर नकाङ घिन्या ग़ाले कलिऊस्यु च्याङवाङ, ओटन अपङ्गी रां नां रासुटौ, ओटन नकाङ तचोएकै नकाल यर्त परिवाङ। <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />नकाङै ओलजन बजार बाहेर देए पलिईस्यु रालाङौ, ओटन नकाल यर्त लुङले भराबर राआपौ। ओटन साचीयाङै रांक्वायाङ फिरस्यु शाऊल मिनला तोलोअ धापाल खङ ल्यौल रांनाटौ। <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />जोमनलेस्यु नकाङै स्तिफनसजन लुङले टुपज्यावाङ, नकाले आपुकारिउ, “औ, प्रभु येशु, ङामि आत्माजन ग्रहन ढोते।”<note caller="-" style="x"><char style="xo" closed="false">7:59 </char><char style="xt" closed="false"><ref loc="PSA 31:5">भजनसङ्ग्रह ३१:५</ref> </char></note> <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />नकाले घुन्डा तिकिस्यु घिन्या ग़ाले कलिऊस्यु ऐलेऊ, “औ, प्रभु ईका पापल दोस इकाङजन तालागित्या।” आवाए पानस्यु नकाले आपरान आराहौ।<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="s">शाऊलले मन्डलीजन आसताइन्या</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />स्तिफनसल हत्या आताहौक शाऊल बै मिलिस्यु लेऊ। ओछिम्कै यरुशलेमल लेन्या मन्डलीलं बिरोदल घिन्या सटावट सुरु ताहौ, ओटन प्रेरितयाङ बाहेक नकाङ सोगलै यहूदिया सनर सामरीयाला इलाकादेए तत्तर बित्तर ताइवाङ। <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />भक्तजनयाङै स्तिफनसजन लाङस्यु रारीनौ, ओटन नकाल नाल्ट घिन्या शोक रामनाहौ। <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />तर शाऊलले मन्डलीजन दुख यांज्याव। नकाले झिम-झिमल पसिस्यु ल्हेपाङ सनर मेएमाङजन घिसारस्यु घिसारस्यु लाङस्यु झ्यालखानाल आझोअवाङ।<verse eid="ACT 8:3" /></para>
  <para style="s">फिलिपले सामरीयाल चान्याथाई प्रचार ढोङा लेसिन्या</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />तब नका तत्तर बित्तर ताइन्याङै चारैवरदेए हिनस्यु बचन प्रचार रांढोव। <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />फिलिपलेकने सामरीयाल तोलोअ सहरल हिनस्यु नकाङजन ख्रीस्टल प्रचार आढोव। <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />फिलिपले आपानन्या बचन राथटौ ओटन नकाले आढान्या अचम्मला कामयाङ रङस्यु, हुलले त यिङला ताइस्यु नकाल छेनत ध्यान रांयोव। <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />दानाङभन्या तबर जनाङन दुस्टआत्माङ घिन्या ग़ाले चिचच्याइस्यु पलिहौ लागिवाङ, ओटन तबर जनाङ लुलाइन्या रोगियाङ सनर दुन्डाङ बै सबेल्सिवाङ। <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />ऐलेस्यु ना सहरल भ्याई आनन्द ताहौ।<verse eid="ACT 8:8" /></para>
  <para style="s">सिमोन जादुवाला</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />सिमोन मिनला तोलोअ रु नङ लेऊ। नकाले हादेएकन्जै ना बजारल जादुगर ढास्यु सामरीयाला रुयाङजन अचम्म छक्कै पराइस्यु लेऊ, ओटन ओलझन्जै ङाई ज्या घिन्या ऐलेस्यु यिङवा। <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />नका रुजन इङन्याङतन घिन्या समन सोगलैले ऐलेस्यु रामानिऊ, “ईका रु परमेस्वरलं ना सक्ति ज्या, जोजन महासक्ति ऐढासिया।” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />नकाङै नाजन रामानिऊ, दानाङभन्या तबर हाकन्जै नकाले आमि जादुगरीले रुयाङजन अचम्म जाएस्यु आनाटौ। <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />तर जब नकाङै परमेस्वरलं राज्य सनर येशु ख्रीस्टल मिनङन चान्याथाई सथएन्या फिलिपल छेन बिस्वास रांढोव, तब ल्हेपा सनर मेएमाङै बप्तिस्मा राहोनौ। <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />सिमोनले ओलं बै बिस्वास आढोव। नकाले बप्तिस्मा आहोनौ, ओटन नकाई फिलिपसैज लागिज्याव, ओटन अचम्मला अचम्मला कामयाङ सनर घि-घिन्या अचम्मला काम आढान्या रङस्यु नाजन छक्कै ताइवाङ।<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />सामरीयाला रुयाङै परमेस्वरलं बचन ग्रहन रांढोव ऐलेन्या थएस्यु यरुशलेमल लिज्यान्या प्रेरितयाङै पत्रुस सनर यहुन्नाजन नकाङल्योङ रांपरिङौ। <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />नकाने नङ रा:स्यु नकाङै पबित्र आत्मा ग्याडोएरत्या लेस्यु छार बिस्वासीयाङ नाल्ट प्रार्थना नेंढोव। <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />दानाङभन्या नवाए बेला समन नकाङ मध्य काङ्काईलयर्त बै पबित्र आत्मा राइस्युमालेऊ। नकाङल बप्तिस्मा प्रभु येशुल मिनङन याएज ताइस्युलेऊ। <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />तब पत्रुस सनर यहुन्नानेंले नें कुई नकाङलयर्त नेंनाटौ, ओटन नकाङै पबित्र आत्मा रांडोटौ।<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />आब प्रेरितयाङै कुई रांनाटौक पबित्र आत्मा डोएसिऊ रैस ऐलेन्या रङस्यु सिमोनले ऐलेऊयन नकाङजन रुप्या यांन्या लेस्यु आहोनौ, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />“ङाजन बै ईका सक्ति यांङचिन्ते, ओटन ङा बै जोल यर्त कुई नाटङ नकाले पबित्र आत्मा ग्याडोटौत्या।”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />तर पत्रुसले ऐलेऊ, “न रुप्या नङसं नस्ट ग्याताइत्या, दानाङभन्या परमेस्वरलं बरदान रुप्याले लङौ दुदुसिया लेस्यु नङ बिचार नढोनु। <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />ईका बारेल न त नमी कोबाअ भागले न त बठाइज ले, दानाङभन्या परमेस्वरलं सामन्दी न यिङ सोझा मालेऊ रैस।<note caller="-" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="PSA 78:37">भजनसङ्ग्रह ७८:३७</ref></char></note> <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />नैताइस्यु नङ नमी ईका पापल नाल्ट पस्चाताप ढोते ओटन प्रभुत प्रार्थना ढोते, ओटन पक्का बै यिङला ऐटाइन्या बिचार छेमा ताहा। <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />दानाङभन्या नङजन ङा ङारङज्यानु, नङ पापले भरिस्यु लेना, ओटन अधर्मल बन्धनल लिज्याना।”<note caller="-" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="DEU 29:18">ब्यबस्था २९:१८</ref>; <ref loc="LAM 3:15">बिलाप ३:१५</ref> </char></note><verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />तब सिमोनले ऐलेऊ, “झेन्जै ङा नाल्ट प्रभुत प्रार्थना ढास्याङचिन्ते, ओटन झेन्जै झेनपानन्या नैज बै छेन ङा यर्त तालागित्या।” <verse eid="ACT 8:24" /><verse number="25" style="v" sid="ACT 8:25" />ओटन नकानेले गवाइ योंन्यापाइनाई सनर प्रभुल बचन छ्योङस्यु खेमन्यापाइनाई सामरीयाङल तबर नङ्गरल चान्याथाई प्रचार ढाऔयन नकाने यरुशलेम वलौने।<verse eid="ACT 8:25" /></para>
  <para style="s">फिलिप सनर इथियोपियाला अढिकारी</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />नकाल छिन्ट प्रभुल तोलोअ दुतले फिलिपजन आढोव, “सोस्यु दच्छिनदेए यरुशलेमङन गाजादेए हिनन्या यमल हिनन्ते। नल यम माखअन्या पो लेया।” <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />ओटन फिलिप च्याङस्यु हिनौ, ओटन तोलोअ इथियोपियाली मिहिरीजन आडोटौ, जो इथियोपिया देसला माहारयनी कन्दाकीला घिन्या पदाधिकारी सनर सोगलै धनसम्पतलं कोस अढक्छ्या लेऊ। ओ यरुशलेमल आराधना ढानास्यु लेऊ। <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />नका वलस्यु रांज्याऔ, ओटन आरथल चुङस्यु यशैया अगमबक्ताल किटाप परीज्याव। <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />तब पबित्र आत्माले फिलिपजन ऐआढोव, “हिनन्ते ओटन ना रथवाला सकाए बान्ते।” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />फिलिप नका ल्योङ चोएस्युकने हिनौ, ओटन नकाले यशैया अगमबक्ताल किटाप आपरिज्यान्या थएस्यु आगिनौ, “नङ नपरीज्यान्या छेन नबुझिनु?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />तब नकाले ऐलेऊ, “काङ्काईले मापानस्यास्यु ङा कैलेस्यु बुजिऊ ढुदुङ का?” ओटन नकाले फिलिपजन रथत वूमस्यु ओलसं चुङनते ऐलेस्यु बिन्ति रांढोव। <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />आब नकाले आपरिज्यान्या पबित्रशास्त्रलं अध्याय ईका लेऊ, “जोमनलेस्यु भेडा पलन्याल नाल्ट लाङसी, या थुमा उन कतरिन्याल ल्यौक छपक्कै दिङज्या, नैलेस्यु जै नकाले आयां: माफएदा। <verse eid="ACT 8:32" /><verse number="33" style="v" sid="ACT 8:33" />नकाल अपमान आताहौ बेलाक नाले निया माडोएदा। नकाल पुस्तालं चर्चा काङ्काले ढान्या? दानाङभन्या नकाल जिबन पिरथ्बीलन लाङसिऊ।”<note caller="-" style="x"><char style="xo" closed="false">8:33 </char><char style="xt" closed="false"><ref loc="ISA 53:7-8">यशैया ५३:७-८</ref></char></note><verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />तब ना मिहिरी फिलिपजन ऐआढोव, “किर्पा ढास्यु ङाजन पानस्याङते, अगमबक्ताले ईका काङ्काल बारेङन आपानौ, ओलं आमि बारेल सन् अपुर काङ्काङै बारेल?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />तब फिलिपले आयां: खुलिस्यु पबित्रशास्त्रलं ईका खन्डलन नकाजन येशुल चान्याथाई आसथटौ। <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />ओटन नकाने यमल नेंहिनज्याऔ नेंहिनज्याऔकै तचिइ री लेन्या तोलोअ पोल तापराऔने। ना मिहिरी ऐलेऊ, “ब्याएते, इल री लेऊरैस, ङाजन बप्तिस्मा होनन्याङन नैले रुकिऊढुदुउ?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />फिलिपले ऐलेऊ, “यदि सोगल यिङले जै बिस्वास ढोनकन नङ बप्तिस्मा होनौ ऐदुदुना।” नकाले जबाक आयोव “येशु ख्रीस्ट जै परमेस्वरलं ज़ा ज्या ऐलेस्यु ङा बिस्वास ढोङा।”<verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />फिलिपले रथ रुकिन्या आग्या आयोव, ओटन फिलिप सनर नका मिहिरी नेंलोअनेंज रील लाहौने, ओटन ओले नकाजन बप्तिस्मा आयोव। <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />तर जब नकाने रील डुबिस्यु पाखा पलिईस्यु रांऔने, तब प्रभुल आत्माले फिलिपजन कोलोअस्यु आलाङौ, ओटन नका मिहिरी फिलिपजन फरि मारङदा, ओटन नका हेसाङस्यु आयम लागिऊ।<note caller="-" style="x"><char style="xo" closed="false">8:39 </char><char style="xt" closed="false"><ref loc="1KI 18:12">१राजा १८:१२</ref></char></note> <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />तर फिलिप अश्दोदल रंनौ, ओटन कैसरिया आमातापौ समन सोगल सहरजिऊल चान्याथाई पानौयन हिनौ।<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">पावलल उद्दार</para>
  <para style="r">
    <ref loc="ACT 22:6-16">प्रेरित २२:६-१६</ref>; <ref loc="ACT 26:12-18">२६:१२-१८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />शाऊल प्रभुल सिइयाङल बिरोदल अझ बै धम्की सनर सएन्या सुरत प्रधान पुजाउरो ल्योङ हिनौ, <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />ओटन नकाले प्रभुल यमत बान्या रुयाङ ल्हेपा ताह या मेएमा, जोजन डोटौकन बै नकाजन पोअस्यु यरुशलेमल होनौ ग्याडोटङत्या लेस्यु दमस्कसला आराधना झिमयाङल मिनत पुर्जी नीऊ। <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />जब शाऊल बाऔयनढास्यु दमस्कसलं नेराल तापौ, झुकाउन्या नमतन तोलोअ ज्योति नकाल हुङआङन चम्किऊ। <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />नका नामल वङौ, ओटन नकाले ऐलेन्या ग़ा आठटौ, “शाऊल, शाऊल, नङ दानाङ ङाजन सताइज्याङ?”<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />नकाले ऐलेऊ, “प्रभु, नङ काङ्का?” ओटन ओले ऐआढोव, “ङा येशु हो, जोजन नङ नसताइज्यानु। <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />आब सोस्यु सहरल हिनन्ते, ओटन नङ जो ढान्या ताह, ना नङजन पानस्यासिया।”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />ओलसं बान्या रुयाङै ग़ा ता राथटौ, तर काङ्काईजन रांमारङौकाले बक्कै ताइस्यु च्याङज्यावाङ। <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />तब शाऊल नामलन आसोवौक अन्ढला ताइस्यु लेऊ ओटन नैज आमारङौ, ओटन नकाङै नकाल कुई कोलोअस्यु डोऱ्याइस्यु ओलजन दमस्कसलं राहोनौ। <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />ओटन तिन दिन समन नका मारङन्या ताहौ, ओटन न त याए ज्योव न त री ओव। <verse eid="ACT 9:9" /><verse number="10" style="v" sid="ACT 9:10" />दमस्कसलं हननिया मिनला तोलोअ सिइ लेऊ। नाजन प्रभुले दर्शनल ऐआढोव, “ऐ हननिया।” नकाले ऐलेऊ, हौ “प्रभु।”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />तब प्रभुले हननियाजन ऐआढोव, “च्याङनते, ओटन ‘सोझा’ मिनला गल्लिल हिनन्ते, ओटन नङ यहूदाल झिमल शाऊल मिनला तार्सस-चुङन्याजन रोअते, दानाङभन्या नका प्रार्थना ढाज्याव। <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />शाऊलले दर्शनत हननिया मिनला तोलोअ रुजन भितरलं रा:स्यु, इकाले रङौ ग्याडोटौत्या लेस्यु आयर्त आकुई आनाएन्या आरङौ।”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />तर हननियाले ऐलेऊ, “प्रभु, ईका रुले यरुशलेमल न सन्तानयाङजन आवाए भ्याई माचान्या आढोवाङ, ईका ङा तबर रुयाङ्ङन ङा थएङु। <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />इल बै नमिनङन उपासना ढान्याङजन सोगलैजन बन्दी जाएस्यु लाङन्या अढिकार मुख्या पुजाउरोयाङ्ङन नकाले डोएस्यु लेया।” <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />तर प्रभुले नकाजन ऐआढोव, “हिनन्ते, दानाङभन्या गैरयहूदी रययाङ सनर इस्राएललं सन्तानल ल्योङ, ङा मिन प्रचार ढाऔ नाल्ट छेल्सिन्या नका तोलोअ ङामि कामदार हो, <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />दानाङभन्या ङा मिनल नाल्ट नकाले ख्वाए दुख भोघिऊ परिन्या, ना ङा थनस्योङा।”<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />तब हननिया हिनस्यु ना झिम भितरलं पसिऊ, ओटन नकाल यर्त आकुई नाएस्यु ऐलेऊ, “भाई शाऊल, जो प्रभु येशु नङ नराज्यान्या यमल न ल्योङ रंनौ, ओइलेज नङ ग्यारङनत्या ऐलेस्यु, सनर नङ पबित्र आत्माले परिपुर्न ताहन्ते ऐलेस्यु ङाजन आपरिङ्ङु हो।” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />ओचोएटै नकाल म्युउलन खोप्पर मनताइन्या कोबाअ तेहौ, ओटन नकाले फरि आरङौ। तब नकाले सोस्यु बप्तिस्मा आहोनौ, <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />ओटन ज्यान्या ज्यास्यु नकाले बल आडोटौ। ओटन शाऊल तचिइ दिन समन सिइयाङस दमस्कसलं लिज्याऔ।<verse eid="ACT 9:19" /></para>
  <para style="s">शाऊलले दमस्कसलं प्रचार आढोव</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />ओटन ओचोएटै नकाले आराधना झिमल येशुल प्रचार ऐलेस्यु आढोव, “ओ परमेस्वरलं ज़ा ज्या।”<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />ओटन थएन्या वालाङ सोगलैले अचम्म मानिस्यु ऐलेवाङ, “ईका मिन पुकारिन्या भरियाङजन यरुशलेमल माएन्या सनर इल बै नकाङजन पोअस्युकने मुख्या पुजाउरोयाङ ल्योङ लाङन्या यिङले रांन्या ईकाइ माङडीका?” <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />तर शाऊल अझै भ्याई सक्तिशाली ताहौवन हिनौ, ओटन येशु जै ख्रीस्ट ज्या ऐलेन्या प्रमान यांस्यु दमस्कसलं लिज्यान्या यहूदीयाङै नैज जबाक यांऔ रांमाढुदुऊ।<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />ओटन तबर दिन छिन्ट यहूदीयाङै दुउसिस्यु नकाजन सएन्या जाल रांढोव।<note caller="-" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="2CO 11:32-33">२कोरिन्थी ११:३२-३३</ref></char></note> <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />तर नकाङल जाल शाऊलले आसनौ। नकाङै नकाजन सएन्याल नाल्ट लाअ रिउ सहरला द्वाहाडोबाटा वुइस्यु चुङवाङ। <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />तर नकाल आसिइयाङै ओलजन रिउलै घिन्या घोनल झोअस्यु भान्दाअलन रांल्हाटौ।<verse eid="ACT 9:25" /></para>
  <para style="s">शाऊल यरुशलेमल</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />शाऊल यरुशलेमल रायापाइनाई नकाले सिइयाङस डोएसिन्या कोशिस आढोव। तर नकाङजन ङा सिइ ज्या ऐआढोऔक माकोनस्यु सोगलै ओलसं छ्याएवाङ। <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />तर बारनाबासले नकाजन ओलसं लाङस्यु प्रेरितयाङ ल्योङ आलाङौ। ओटन शाऊलले प्रभुजन यमल आरङन्या सनर प्रभु ओलसं आछ्योङन्या ओटन ओलं दमस्कसलं साहस सकाए येशुल मिनतन प्रचार आढान्या छेन नकाङजन आपानस्योवाङ। <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />शाऊल यरुशलेमल प्रेरित सिइयाङसकाए बोलोङ माछ्याएस्यु बाऔ तअसिऊ, ओटन साहस सकाए प्रभुल मिनजन प्रचार ढाऔ लागिऊ, <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />ओटन ओलं ग्रीक-यहूदीयाङस छेनछ्योङन्या आढोव, तर नकाङै ओलजन सटौ रारोकौ। <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />तर ईका सनस्यु बिस्वासी भाईयाङै ओलजन कैसरियाल राहोनौ ओटन नङंन ओलजन टार्ससलं रांपरिङौ।<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />नैलेस्यु सोगल यहूदिया, गालील सनर सामरीयाभरिला मन्डलीलं शान्ति ताहौ ओटन मन्डली सुढार ताहौ। प्रभुल छ्याइत बाऔयन सनर पबित्र आत्माल सानत्वना डोएस्यु मन्डली बदिऊयन हिनौ।<verse eid="ACT 9:31" /></para>
  <para style="s">पत्रुस योप्पा सनर लुड्डाल</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />पत्रुस यरुशलेमल हुदेएअदेए सोगलै पोल बाऔयन लुड्डाल लेन्याङ परमेस्वरलं रुयाङ ल्योङ बै ताप्‌रा:औ। <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />नकाले नङ एनियास मिनला काङ्का तोलोअ रुजन आडोटौ, जो आट बर्सकन लुलाइन्या नाएबोरले आतानलै वङज्याऔ। <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />पत्रुसले नकाजन ऐआढोव, “ऐ एनियास, येशु ख्रीस्टले नङजन सबेल्दुन्वा। च्याङनते, ओटन नटान मिलाइते।” ओटन ना ओचोएटै सोव। <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />लुड्डा सनर शारोनल चुङन्या सोगलैले नाजन रङस्यु प्रभु लेऊदेए वल्वाङ।<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />योप्पा इलाकाल तबीता, अथाबा डोरकास (हरिनी) ऐढासिन्या तोलोअ सिइ लेऊ। नका चान्या काम ढान्या सनर दान यांन्यात लागिज्याव। <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />नवाए बेला नकाल आनाएबोरौ ओटन नका सिऊ, ओटन रुयाङै हरस्यु ओलजन टङटाल्ला तोलोअ कोठाल रांनाटौ। <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />लुड्डा नङ्गर सनर योप्पा नङ्गरने नेराक नेंलेऊकाले, सिइयाङै पत्रुस नङ लिज्याऔ ऐलेन्या थएस्यु नकाङल्योङ नेंलोअ रुनेंजन ऐटाइन्या बिन्ति ढाऔ रांपरिङौ, “गेल्योङ ढिलो माढास्यु रांन्ते।”<verse eid="ACT 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39" />तब पत्रुस च्याङस्यु नकाने सकाए हिनौ। नङ ताप्‌रा पाइना नकाङै ओलजन टङटाल कोठाल रालाङौ। बिदवाङ सोगलै नकाल नेराक च्याङस्यु व्‌रौ तअसिवाङ, ओटन डोरकास नकाङ सकाए आलिज्याऔक नकाले जाएस्युआनाएन्या क्वा सनर अपुर क्वायाङबै राठनस्यौ।<verse eid="ACT 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 9:40" />तर पत्रुसले नकाङ सोगलैजन बाहेर देए परिङस्यु घुन्डा टिकिस्यु प्रार्थना आढोव, ओटन ना मरु ल्यौदेए फर्किस्यु ऐलेऊ, “तबीता, सोन्ते!” ओटन नकाले आ म्युउ आखिमौ, ओटन पत्रुसजन रङस्यु सोस्यु चुङौ। <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />पत्रुसले नाजन आकुईले कोलोअस्यु जरुक्कै आसच्यानौ, ओटन बिस्वासीयाङ सनर बिदवाङजन खुल्स्यु नकाजन जिङदा आठनौ।<verse eid="ACT 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 9:42" />आब ईका छेन सोगल योप्पा भरिलाङ रा:सनौ, ओटन तबरले प्रभुत बिस्वास रांढोव। <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />ओटन पत्रुस तबर दिन समन सिमोन मिनला तोलोअ <note caller="+" style="f"><char style="fr" closed="false">9:43 </char><char style="ft" closed="false">चर्मकार=छाला जाएन्या</char></note>छालाल काम ढान्यासं योप्पाल चुङौ।<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">पत्रुस सनर कर्नेलियस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />कैसरियाल कर्नेलियस मिनला तोलोअ रु लेऊ, जो रोमल इटालिया पल्टनला तोलोअ कप्तान लेऊ। <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />नका ईस्वरभक्त लेऊ, ओटन ओल सनर आमि सोगल जाहानयाङै परमेस्वरलं छ्याइ मानिरा। नकाले चाहिज्यान्याङजन उद्दारतासं दान यांस्यु परमेस्वरतं सदाई प्रार्थना ढोवा। <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />नकाले तयोअ लाअका तिन बजेदेएका दर्शनत परमेस्वरलं तोलोअ स्वर्गदुत आलेऊदेए रा:स्यु ऐआलज्यान्या आठटौ, “कर्नेलियस!”<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />नकाले छ्याहैसं ओजन दवलसं आखिमौ ओटन ऐआढोव, “प्रभु पान्ते।” ओटन स्वर्गदुतले नकाजन ऐआढोव, “न प्रार्थना सनर मायोअन्याङजन नयांन्या दान यांकाल नाल्ट परमेस्वरलं हाक ताप्स्यु लेरा। <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />ओटन पत्रुस राढान्या सिमोनजन खुलन्या रुयाङ योप्पा नङ्गरल परिङचिते। <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />नका छालाल काम ढान्या सिमोन ल्योङ चुङज्याऊ, जोल झिम समुन्दरल वङल लेऊ।”<verse eid="ACT 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7" />जब नकासं छ्योङज्यान्या स्वर्गदुत बिदा ताहौ, तब कर्नेलियस आनोक्करयाङ मध्य नेंलोअ मध्य तोलोअजन लगातार नकाल सेवा-परिपन्जा ढान्या तोलोअ भक्त सिपाइजन आखुलौ, <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />ओटन नकानेजन सोगल छेन पानस्यु योप्पादेए आपरिङौने।<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />छिन्का छिम्क बारं बजेदेए योप्पा सहरल नेराक राटापराऔक, पत्रुस झिमल मैराअत प्रार्थना ढान्या वूमौ। <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />नका करेव ओटन नाले कोबाअ ज्यान्या यिङ आढोव, तर अपुऱ्याङै ज्यान्या रांफिनज्याऔक ओलं दर्शन रङज्याव। <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />नकाले स्वर्ग आफएसिन्या सनर नङंन चार कोनाअल पोअसिन्या क्वा मनताइन्या नैजतिअ पिरथ्बीदेए आलाइरांज्यान्या आरङौ। <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />नका तन्नाल पिरथ्बीला सोगलै किसिमला चारखुटत्या जनावर सनर घस्रिन्या परानी ओटन नमता बायाङ लेवाङ। <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />तब नकाले तोलोअ ग़ा आठटौ, “ऐ पत्रुस च्याङनते, ओटन सएस्यु कैटे।”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />तर पत्रुसले ऐलेऊ, “माङडी प्रभु, दानाङभन्या ङा खकैज नैज अपबित्र या अशुद्द जन्तु कैस्यु मालेङदी।”<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="LEV 11:47">लेवी ११:४७</ref>; <ref loc="EZK 4:14">इजकिएल ४:१४</ref> </char></note><verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />ना ग़ा फरि नेंपाला नाले आठटौ, “परमेस्वरले जो चोखा जाएस्यु ले नकाजन नङ अशुद्द तालेन।”<verse eid="ACT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 10:16" />तिन पालासमन ऐज ताहौ, ओटन ओचोएटै नका तन्ना नमदेए लाङसिऊ।<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />जब पत्रुसले ओलं आरङन्या आका दर्शनल अर्थ नैति होला ऐलेस्यु आयिङ आयिङल अन्टातोल ताइज्याऔ, नाइ बेला कर्नेलियसले आपरिङन्या रुयाङ सिमोनल झिम रोअस्यु रा:स्यु झलाप वङल च्याङज्यावाङ, <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />“ओटन ओयाङ रांगिनौ, पत्रुस ऐढासिन्या सिमोन इल चुङौ?”<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />जब पत्रुस दर्शनल बारेङन बिचार ढाज्याव तब पबित्र आत्माले नकाजन ऐआढोव, “खिम्ते, तिनवटा रुयाङै नङजन रोअज्यावाङ। <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />च्याङनते, ओटन वान्ल हिनन्ते, ओटन गाएगुइ मालस्यु नकाङ सकाए लागिन्ते, दानाङभन्या नकाङजन ङा ङापरिङ्ङु।” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />तब पत्रुस लाहौ, ओटन नका रुयाङ ल्योङ हिनस्यु ऐलेऊ, “खिम्चिते, जे जेरोअन्या रु ङाई ज्या। जे इल जेरांन्या कारन नैति?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />नकाङै ऐलेवाङ, “तोलोअ कप्तान कर्नेलियसले गेजन आपरिङयिउ, जो धर्मि परमेस्वरसं छ्याएन्या सनर सोगल यहूदी जातियाङ्ङन मानिसिन्या रु लेऊ, नङजन ओलं झिमल खुलौ परिङन्या सनर नल्योङन थाई थएच्यो ऐलेस्यु तोलोअ स्वर्गदुतङन ओजन आदेस यांसिऊ।” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />तब पत्रुसले नकाङजन भितरलं खुल्स्यु नकाङजन स्वागत रांढोव। छिन्का छिम्क पत्रुस सोस्यु नकाङसं हिनौ, ओटन योप्पाला ख्वाएयाए बिस्वासी भाईयाङ नासकाए लागिवाङ।<verse eid="ACT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24" />तयोअका छिम्क नकाङ कैसरियाल तापवाङ। रांनालनाठा सनर नेराका न्हाएयाङजन खुल्स्यु रादुउवाङ कर्नेलियस नकाङल यम वुइज्यावाङ। <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />जब पत्रुस भितर रांऔ तब कर्नेलियसले ओलसं डोएसिस्यु नकाल खङल फलुप्सिस्यु धोक आढोव। <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />तर पत्रुसले नकाजन ऐढास्यु आसचोटौ, “सोन्ते, ङा बै ता नङमन ताइन्याई रु ज्याअसा।” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />तब नका ओलसं छ्योङौयन झिम भितरलं हिनौ, ओटन नङ नकाले तबर जना रादुउसिन्या आडोएवाङ। <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />तब पत्रुसले नकाङजन ऐआढोवाङ, “अपुर जातियाङसं न्हाए ढोच्यो, अथाबा नकाङसं डोएसिऊयन ढान्या तोलोअ यहूदीयाङ नाल्ट ख्वाए माचान्या हो ऐलेन्या छेन जेजन थाह लेया, ताहकन बै परमेस्वरले ङाजन काङ्काई रुजन अशुद्द अथाबा माचान्या तायिङ ऐलेस्यु थनस्यु लेऊ। <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />नैताइस्यु खुलौ चोएटै नैज दुख मामानिस्यु ङा जेल्योङ ङारांङु। जे ङाजन दानाङ खुलङच्यो? आब पान्चिते।”<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />तब कर्नेलियसले आपानौ, “चार दिन छिम्क, छ्योअ ईकाइ बेला झिमल ङा तिन बजेला प्रार्थना ङाढाज्याङु, तब चम्किन्या क्वा क्वाएसिज्यान्या तोलोअ रु ङा सामन्दी च्याङौ, <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />ओटन ऐलेऊ, ‘कर्नेलियस, परमेस्वरलं सामन्दी न प्रार्थना थएस्यु लेया, ओटन ओङ गरिबयाङजन नयांन्या दानल यांका ताइस्यु लेया। <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />नैताइस्यु योप्पाल रुयाङ परिङस्यु पत्रुस ऐराढान्या सिमोनजन खुल्स्यु परिङचिते। नका समुन्दरल वङल छालाल काम ढान्या सिमोनल झिमल चुङज्याऊ।’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />तब ङा ओचोएटै न ल्योङ रुयाङ ङापरिङवाङ, ओटन नङ भलाढास्यु नरानु। आब प्रभुङन नङजन आग्या आताइन्या सोगलै छेनयाङ पान्ते गे थएया।”<verse eid="ACT 10:33" /></para>
  <para style="s">पत्रुसलं भासन</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />तब पत्रुस छ्योङौ तअसिऊ, “मछ्युजै ङा ङारङ्ङु, कि परमेस्वरले पक्छेबाद माढोवदी।<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ब्यबस्था १०:१७</ref>; <ref loc="2CH 19:7">२इतिहास १९:७</ref> </char></note> <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />तर सोगलै जातिलन जो ओलसं छ्यात, सनर ठिक काम ढोव, नका ओलं सामन्दी ग्रहन ढान्या लायकला ताहा।” <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />परमेस्वरले इस्राएलीयाङजन आपरिङन्या चान्याथाई, अथाबा ख्रीस्टङन प्रचार ढासिन्या शान्तिल चान्याथाई जेजन थाहै लेया। (येशु जै सोगलैल प्रभु ज्या।)<note caller="-" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="PSA 107:20">भजनसङ्ग्रह १०७:२०</ref>; <ref loc="PSA 147:18">भजनसङ्ग्रह १४७:१८</ref>; <ref loc="ISA 52:7">यशैया ५२:७</ref>; <ref loc="NAM 1:15">नहूम १:१५</ref> </char></note> <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />बप्तिस्मा यांन्या यहुन्नाले प्रचार आढाऔ छिन्ट, गालीलला प्रदेसङन सुरु ढास्यु सोगल यहूदिया भरि प्रचार ढासिन्या बचन ईकाइ ज्या, <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />कि परमेस्वरले नासरतला येशुजन पबित्र आत्मा सनर सक्तिले अबिसेक आढोव। ओले चान्या काम ढाऔयन सनर दियाबलसङन दुख डोएज्यान्याङजन सबेलौयन बाऔ, दानाङभन्या परमेस्वर ओलसं लेऊ। <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />“ओटन ओले यहूदीयाङल देस सनर यरुशलेमल आढान्या सोगलै छेनल गे साचीयाङ ज्या। ओलजन नकाङै येशुजन क्रूसतं केप्स्यु रासटौ। <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />ओलझन्जै परमेस्वरले तिन दिनक जिङदा जाएस्यु आसचोटौ, तर ओलजन रुयाङ लेऊक रंनन्या आजाटौ, <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />सोगलै रुयाङजन माङडी, तर गे जोजन परमेस्वरले साचील हिसापत आछेलयिउ, ओटन ओलं सिन्यातन जिङदा आताहौ छिन्ट गे ओलसं ज्यान्या ओन्या गेढोयिउ। <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />ओले गेजन जनताल प्रचार ढान्या, सनर ओलं जिङदा सनर सिन्याङल नियादिस ताइन्याल नाल्ट परमेस्वरङन ठहराइसिन्या हो ऐलेन्या गवाइ यांऔ नाल्ट आग्या यांस्यु आनाएयिउ। <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />सोगलै अगमबक्ताङै ओलं बयन यांस्युई लेरा, कि येशुत बिस्वास ढान्या सोगलैले ओलं सक्तिङन पापल-छेमा डोएरा।”<note caller="-" style="x"><char style="xo" closed="false">10:43 </char><char style="xt" closed="false"><ref loc="ISA 33:24">यशैया ३३:२४</ref>; <ref loc="ISA 53:5-6">यशैया ५३:५-६</ref>; <ref loc="JER 31:34">यर्मिया ३१:३४</ref>; <ref loc="DAN 9:24">दानियल ९:२४</ref> </char></note><verse eid="ACT 10:43" /></para>
  <para style="s">गैरयहूदीयाङ पबित्र आत्मा राडोएन्या</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />पत्रुसले ईका छेन आछ्योङज्याऔ आछ्योङज्याऔकै बचन थएन्या सोगलैत पबित्र आत्मा लाहौ। <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />गैरयहूदीयाङजन बै पबित्र आत्माल बरदान आयांन्या रङस्यु पत्रुस सकाए रांन्या यहूदी बिस्वासीयाङ अचम्मै ताइवाङ। <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />दानाङभन्या अपुर छेनल छ्योङस्यु नकाङै परमेस्वरलं प्रसम्सा राढाज्यान्या ओयाङै राथटौ। तब पत्रुसले ऐलेऊ, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“गेमन्जै पबित्र आत्मा डोएन्या इकाङजन रील बप्तिस्मा यांन्यातन काङ्काले अहअ ऐलेऊ ढुदुऊ?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />ओटन पत्रुस ले नकाङजन येशु ख्रीस्टल मिनतन बप्तिस्मा योंचिते ऐलेस्यु आग्या आयोवाङ। तब नकाङै पत्रुसजन तचिइ दिन आलै लिज्यान्ते ऐलेस्यु अनुरोद आढोव।<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">यरुशलेमला मन्डलीलं पत्रुसलं चर्चा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />यहूदियाल लिज्यान्या प्रेरितयाङ सनर भाईयाङै गैरयहूदीयाङ बै परमेस्वरलं बचन ग्रहन ढोदुरा ऐलेन्या राथटौ। <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />जब पत्रुस यरुशलेमल रांऔ, तब खटना ढान्या बगालले नकाजन ऐलेस्यु ग्यानगिन रांढोव, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />“नङ दानाङ खटना माढान्या ल्योङ हिनस्यु नकाङ सकाए ज्यान्याओन्या ढोन?” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />तब पत्रुसले नकाङजन आवाऱ्याईसज आपानस्योवाङ<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />“ङा योप्पा सहरल प्रार्थना ङाढाज्याङु, ओटन ङा एकसोऱ्या ङाध्यानत ङालेङु, तब तोलोअ घिन्या क्वा मनताइन्या चार कोनाअल कोलोअस्यु नमतन वान्देए आतेइज्यान्या नैति जन्तु ङा दर्शनत ङारङ्ङु, ओटन नका ङाल्योङ रांऔ। <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />ङा दवलसं ङाखिमौक नल पिरथ्बीला जनावर सनर बन पशुयाङ, घस्रिन्या जन्तु ओटन नमता बायाङ ङारङ्ङवाङ। <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />ङाजन ऐआढाज्यान्या तोलोअ ग़ा ङा थएङु, ‘पत्रुस च्याङनते, ओटन सएस्यु कयौरते।’” <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />“तर ङा ऐङाढोङु, ‘माङडी प्रभु, नैज अपबित्र अथाबा अशुद्द जन्तु ङायाह्‌ल खकै परीस्यु माल्दी।’”<verse eid="ACT 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9" />“तर नका ग़ाले नेंपालात स्वर्गङन ङाजन आढाङु, ‘जोजन परमेस्वरले चोखा जाएस्यु ले, नकाजन नङ अपबित्र ऐटालेन।’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />तिन पाला नैज ताहौ, ओटन ना सोगलै फरि नमदेए लाङसिवाङ।”<verse eid="ACT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11" />“नवाए बेलाई कैसरियाङन ङाल्योङ परिङसिन्या तिनगोटा रुयाङ, गे गेचुङज्यान्या झिमल ताप्‌रावाङ। <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />गाएगुइ मालस्युई नकाङसं हिनन्या ङाजन पबित्र आत्माले ऐआढाङु। ईका छ जना भाईयाङ बै ङासकाए हिनस्यु लेवाङ, ओटन गे ना रुल झिमलं गेपसियिउ। <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />नकाले गेजन आपानस्यायिउ, कि तोलोअ स्वर्गदुत नकाल झिमल च्याङस्यु ऐआलज्यान्या नकाले आरङौ, ‘योप्पाल रु परिङस्यु पत्रुस ऐढासिन्या सिमोनजन खुल्स्यु परिङचिते। <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />ओले नङजन बचन सथएवा, जोल्योङन नङ उद्दार डोएना-नङ सनर नमी सोगल नजहानले।’”<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />“जब ङा छ्योङौ ङातअसिङु, तब पईला गेत आलाइरांन्यामन पबित्र आत्मा नकाङयर्त बै नैलेस्युजै लांइरांऔ। <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />तब प्रभुले आपानन्या ना बचन ङाजन याद ताहौ, ‘बप्तिस्मा यांन्या यहुन्नाले ता री ङन बप्तिस्मा आयोव, तर पबित्र आत्माङन जे बप्तिस्मा ताहा।’<note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="ACT 1:5">प्रेरित १:५</ref></char></note> <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />प्रभु येशु ख्रीस्टजन बिस्वास ढाऔक परमेस्वरले गेजन जो बरदान आयोव, नकाङजन बै नकाई बरदान योंवरा पाइनाई परमेस्वरजन रुकिऊढुदुन्या ङा काङ्का का?”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />जब ईका छेन थएरा पाइनाई नकाङ छपक्कै दिङवाङ, ओटन ऐलेस्यु नकाङै परमेस्वरलं महिमा रांढोव “आब ता परमेस्वरले गैरयहूदीयाङजन बै जिबनल नाल्ट पस्चातापल मौका आयोवाङ रैस।”<verse eid="ACT 11:18" /></para>
  <para style="s">एन्टिओखियाला मन्डली</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />स्तिफनसल पालाल सुरु ताइन्या, सटावट कारन सोगल पोदेए तत्तर बित्तर ताइन्याङै अपुऱ्याङजन माङडी, तर यहूदीयाङजन याएज बचन प्रचार ढाऔयन, फोनिके, साइप्रस सनर एन्टिओखिया समन बान्या रांढोव।<note caller="-" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="ACT 8:1-4">प्रेरित ८:१-४</ref></char></note> <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />तर नकाङ मध्य काङ्काकाङ्काङ साइप्रस सनर कुरेनीला रुयाङ लेवाङ। नकाङै एन्टिओखियाल रा:स्यु गैरयहूदी ग्रीकयाङजन बै प्रभु येशुल प्रचार रांढोव। <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />प्रभुल बाहुबल नकाङसं आलेऊकाले, नैताइस्यु भ्याई रुयाङै पस्चाताप ढास्यु बिस्वास ढान्याङ भ्याई बगालल प्रभु देए वल्वाङ।<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />ईका थाई यरुशलेमल लेन्या मन्डलीयाङै राथटौ, ओटन नकाङै बारनाबासजन एन्टिओखियाल रांपरिङौ। <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />बारनाबास ओलं रांऔ ओटन परमेस्वरलं अनुग्रहजन रङस्यु हेसाङौ, नैताइस्यु नकाङजन बिस्वाससकाए प्रभुत पुरा यिङले तोलोअ यिङला ताइस्यु लिज्यान्या हौसला आयोवाङ। <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />दानाङभन्या नकाङ चान्या, पबित्र आत्मा सनर बिस्वासलं भरिपुर्न ताइन्या बारनाबास लेऊ। रुयाङल घिन्या बगाल प्रभुत चैइसिवाङ।<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />तब शाऊलजन बारनाबासले टार्ससलं रोअनाऔ। <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />जब नकाले ओजन आडोटौ तब पावलजन एन्टिओखियाल आहोनौ। तब पुरा त बर्स समनज मन्डलीला रुयाङस नकाङ डोएसिज्याऔयन रांढोव, ओटन रुयाङल घिन्या बगालजन सिक्छ्या रांयोवाङ। बिस्वासी सिइयाङजन पहेला चोए एन्टिओखियालैज बिस्वासी ऐढासिवाङ।<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />नका बेला काङ्का-काङ्का अगमबक्ताङ यरुशलेमङन एन्टिओखियाल रांवाङ। <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />नकाङ मध्य अगाबस मिनला तोलोअ रु च्याङस्यु सोगल पिरथ्बील घिन्या अनिकाल परिङा लिज्याऔ ऐलेस्यु पबित्र आत्माङन भबिस्यबानी छ्योङौ। ना अनिकाल क्लौडियसलं शासनकालल परिया।<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="ACT 21:10">प्रेरित २१:१०</ref></char></note> <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />तब सिइयाङ सोगलैले रांमि-रांमि हैसेत अनुसार यहूदियाल चुङन्या भाईबैनाङजन व्टौ नाल्ट भिटी परिङन्या टोक रांढोव। <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />नकाङै नैजै रांजाटौ, ओटन बारनाबास सनर शाऊलल कुईतन नकाङल भिटी सेरयाङ ल्योङ रापरिङस्योवाङ।<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">बअ दुख</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />नका बेलाक हेरोद रयले मन्डलीला ख्वाए जनाङयर्त भ्याई अत्याचार ढाऔ लागिऊ। <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />ओले यहुन्नाल दाज्यू याकूबजन तरवालले आसटौ। <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />ना काम रङस्यु यहूदीयाङ खुशी ताइवाङ ओटन पत्रुसजन बै कोलोअन्या जोर आढोव। ईका घटना मासोदाला भरेईल पर्बल बेलाक ताइस्यु लेऊ। <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />हेरोदले पत्रुसजन कोलोअस्यु झ्यालखानाल आझोकौ, ओटन निस्तार पर्बल छिन्ट नाजन जनताङल सामन्दी होनन्या बिचार ढास्यु नकाजन वुइन्याल नाल्ट सिपाइयाङल चार टोलील जिम्मा आलाइस्योवाङ। <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />ऐलेस्यु पत्रुसजन झ्यालखानाल झोअसिऊ तर नकाल नाल्ट मन्डलीले परमेस्वरलं लेऊक भ्याई जोससं प्रार्थना ढाज्यावाङ।<verse eid="ACT 12:5" /></para>
  <para style="s">पत्रुसजन कैदलन राराइन्या</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />हेरोदले पत्रुसजन पाखाल पलिईस्यु होनौ आरोकौ रिउल, ओलजन नेंलोअ साङ्गलले पोअन्याईज नेंलोअ सिपाइनेल खार्ल रुउज्याऔ। ओलं सिपाइयाङ बै झलाप हाक च्याङस्यु झ्यालखानाल वुइज्यावाङ। <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />झुकाउन्या प्रभुल तोलोअ स्वर्गदुत नल रंनौ, ओटन कोठाल ज्योति चम्किऊ। स्वर्गदुतले पत्रुसजन हल्लाइस्यु “छिटो सोन्ते” ऐढास्यु नकाल कुईतन साङ्गलयाङ फिरसिस्यु तेइवाङ। <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />स्वर्गदुतले नकाजन ऐआढोव, “क्वा क्वाएसिन्ते, ओटन जुता जाएसिन्ते।” तब नकाले नैज लेऊ। ओले नकाजन ऐआढोव, “खाइटो खुप्सिस्यु ङा छिनछिन लागिन्ते।” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />ओटन नका पलिईस्यु नकाल छिनछिन लागिऊ। स्वर्गदुतङन ढासिन्या छेन मछ्युजै ज्या ऐलेन्या नाजन थाईज माताइदा। तर दर्शन ङारङज्याङु ऐलेस्यु नकाले आयिङौ। <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />जब हादेएङा सनर दोस्रा वुइन्या-टोली घापस्यु सहरल पसिऊ नाल्ट झङल झलाप ल्योङ नकाने तापौने, तब नका झलाप ओलजै नकानेल नाल्ट फएसिऊ, ओटन नकाने बाहेर पलिईस्यु तोलोअ गल्लिला यम ताइस्यु हिनौने, ओटन ओचोएटै स्वर्गदुत पत्रुसजन राइस्यु हिनौ।<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />जब पत्रुसलं होस खुलिउ तब नकाले ऐलेऊ, “आब ङाजन मछ्युजै थाह ताइदा, कि प्रभुले आदुत परिङस्यु हेरोद रयल कुईतन यहूदीयाङै जो ढाऔ रारोकौ नका सोगलैतन ङाजन छुटकारा आयांङु।”<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />ईका छेन नकाले सन्वापाइनाई, नका यहुन्ना “जोजन मर्कुसं बै ऐढोरा” ओलं आअमा मरियमलं झिमल हिनौ। नल तबर जना दुउसिस्यु प्रार्थना ढाज्यावाङ। <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />पत्रुसले झलाप ध्वांध्वां आजाटौक रोदा मिनला नोक्कर्नि झलाप फएराव। <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />पत्रुसलं ग़ा शईस्यु नका हेसाङसिस्यु झलाप माफएस्युई भितर देए चोएस्यु हिनस्यु “पत्रुस झलाप त च्याङज्याऊ” ऐलेस्यु थाई आयोवाङ। <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />तर नकाङै नाजन ऐराढोव, “नङ बौलाहानी हो।” तर नकाले ङापानन्या छेन मछ्यु ज्या ऐलेस्यु नकाले आझ्योङ आजाटौ। तब नकाङै ऐलेवाङ, “ना नकाल स्वर्गदुत होला।”<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />तर पत्रुसले पालै पाला ध्वांध्वां जै जाएज्याऔ। झलाप राफटौक ओलजन रङस्यु नकाङ हलाअ ताइवाङ। <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />पत्रुसले “दिङचिते” ऐलेस्यु कुईले सयान आढोव, ओटन प्रभुले नकाजन कैलेस्यु कैदलन बाहेर आपलिटौ ना नकाङजन आपानस्योवाङ। ईका छेनल थाई याकूब सनर अपुर भाईयाङजन योंचिरते ऐलेस्यु नका बिदा नीस्यु छुट्टै पोल हिनौ।<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />नम रंनापाइनाई पत्रुसजन काङ हिनौ? ओमनलेस्यु सिपाइयाङल खार्ल घिन्या हल्ला मच्चिऊ। <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />हेरोदले पत्रुसजन रोअस्यु बै फेला आमापराहौक, सिपाइयाङल छानबिन ढास्यु नकाङजन ज्याहान सजायल हुकुम आयोव। हेरोद फरि यहूदिया प्रदेसजन राइस्यु कैसरिया हिनस्यु ओङै लिज्याऔ।<verse eid="ACT 12:19" /></para>
  <para style="s">हेरोदल सिइ</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />हेरोदल टुरोस सनर सीदोनला रुयाङस भ्याई आयिङ चोव। नकाङ त बगाल ताइस्यु आल्योङ रांवाङ, ओटन रयल भितरला कर्मचारी बलस्तसजन सभनस्यु मिलाहौ नाल्ट बिन्ति रांढोव। दानाङभन्या नकाङल देस अनल नाल्ट रयल देसलं भरपरिस्यु लेवाङ।<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="1KI 5:11">१राजा ५:११</ref>; <ref loc="EZK 27:17">इजकिएल २७:१७</ref> </char></note><verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />तोकिसिन्या दिन छिम्क राजकीय क्वा क्वाएसिस्यु हेरोद आमि सिहासनल चुङौ, ओटन रुयाङजन ओले भासन आयोवाङ। <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />ओटन रुयाङ “ईका ता देउताल ग़ा दी, रुल माङडी!” ऐलेस्यु कलिऊवाङ। <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />तर परमेस्वरजन महिमा रामाढाऔकाले नवाए बेलाई प्रभुल तोलोअ स्वर्गदुतले नकाजन आराइस्योव, ओटन बज्यां-बज्यां लुइस्यु नकाल सिइ ताहौ।<note caller="-" style="x"><char style="xo" closed="false">12:23 </char><char style="xt" closed="false"><ref loc="DAN 5:20">दानियल ५:२०</ref> </char></note><verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />तर प्रभुल बचन बदिऊयन सनर भ्याई फैलिऊयन हिनौ।<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />बारनाबास सनर शाऊलने सेवाकाई पुरा ढास्यु यरुशलेमलन वलौने। नकाने सकाए मर्कुसं ऐढासिन्या यहुन्ना बै हिनौ।<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">बारनाबास सनर शाऊलजन सेवाकाईल नाल्ट छेल्स्यु परिङसिऊ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />एन्टिओखियाल मन्डलीला अगमबक्ताङ सनर गुरयाङ, अथाबा बारनाबास, मोलौ ऐढासिन्या शिमियोन, कुरेनीला लुकियस, प्रदेसला शासक हेरोदस हुर्किन्या मनेन सनर शाऊल लेऊने। <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />नकाङले प्रभुल आराधना राढाज्यान्या सनर बर्त राचुङज्यान्या बेलाक पबित्र आत्माले ऐलेऊ, “ङा नाल्ट बारनाबास सनर शाऊलजन नका कामल नाल्ट छुटाइचिते, जो कामल नाल्ट ङा नकाङजन खुल्स्यु लेङा।” <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />तब बर्त चुङन्या सनर प्रार्थना ढास्यु नकाङै ओयाङयर्त राकुई नाएस्यु ओयाङजन बिदा रांयोवाङ।<verse eid="ACT 13:3" /></para>
  <para style="s">साइप्रसल सेवाकाई</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />तब पबित्र आत्माङन परिङसिन्या ताइस्यु नकाङ सिलुकियाल हिन्वाङ ओटन नङंन जहासलं चरिस्यु साइप्रसदेए हिन्वाङ। <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />सलामिसल ताप्‌रा:रा पाइना नकाङै यहूदीयाङल आराधना झिमल परमेस्वरलं चान्याथाई प्रचार रांढोव। नकाङजन सेबकल नाल्ट मर्कुसं यहुन्ना नकाङसं लिज्याऔ।<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />जब नकाङ सोगल टापुल बारिन्या ढाऔयन पाफोस समन ताप्‌रावाङ, तब नल नकाङै तोलोअ यहूदी ग्वारवा अगमबक्ता बार येशु ऐढासिन्या तोलोअ जादुगर सकाए डोएसिवाङ। <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />नका जादुगर तोलोअ प्रदेसला शासक सर्गियस पौलस सकाए चुङा। सर्गियस पौलस बुद्दिमान रु लेऊ। नकाले शाऊल सनर बारनाबासजन खुल्स्यु परमेस्वरलं बचन थएन्या इच्छ्या आढोव। <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />तर एलुमास जादुगरले (दानाङभन्या ग्रीक छेनल नका मिनल अर्थ ईकाइ ज्या) सर्गियस पौलसजन एलुमासले येशुजन बिस्वास ढान्यातन रुकिऊ आरोकौ। <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />तर शाऊलले, जोजन पावल बै ऐढासिया, जो पबित्र आत्माले भरिस्यु जादुगर लेऊदेए चान्यासं आखिमौ, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />“नङ दियाबलसलं ज्या, सोगलै धार्मिकताल शत्तुर, सोगलै ग्वारन्या सनर कपटले भरिसिन्या! नैति नङ प्रभुल सोझा यमजन सग्यालन्या नमाराइनु?<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="PRO 10:9">हितोपदेश १०:९</ref>; <ref loc="HOS 14:9">होशे १४:९</ref> </char></note> <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />आब खिम्ते, प्रभुल कुई नयर्त परीस्यु लेया, ओटन नङ आब तचियाए दिन समन नम्युउल प्रकाश रङन्या मालेन्दी नङ काना ताइना।”</para>
  <para style="p" vid="ACT 13:11">ओटन ओचोएटै अन्ढमुन्द सनर काईकाई च्युऊन्याले नङजन कपन्‌वा, ओटन काङ्काङै नकुई कोलोअस्यु राडोऱ्याहौ सन् ऐलेस्यु नङ हुदेएअदेए बाऔ रोअना। <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />तब प्रदेसला नका शासकले ऐआटाईन्या रङस्यु बिस्वास आढोव, दानाङभन्या प्रभुल सिक्छ्यात नका छक्कै परीस्यु लेऊ।<verse eid="ACT 13:12" /></para>
  <para style="s">पिसिदियाल एन्टिओखियाला सेवाकाई</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />पावल सनर नकाल आन्हाएयाङ पाफोसलन जहास चरिस्यु पामफिलियाला सहर पर्गाल तापवाङ, ओटन यहुन्नाचाय नकाङल्योङन भाअसिस्यु यरुशलेम वलौ। <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />तर नकाङ पर्गालन पलिईस्यु पिसिदियाल एन्टिओखियाल रांवाङ, ओटन शबाथल आराधना झिम भितरलं हिनस्यु चुङवाङ। <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />आब ब्यबस्था सनर अगमबक्ताङ किटापल पाठ परिरापाइना आराधना झिमला शासकयाङै नकाङल्योङ ऐढास्यु रांपरिङौ, “ऐ भाई, झेनसकाए रुयाङ नाल्ट उत्साहलं अर्थल बचन कोबाअ लेकन पान्चिते।”<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />तब च्याङस्यु पावलले कुईल सयान ढास्यु ऐलेऊ, “ऐ इस्राएलला रु सनर गैरयहूदीयाङ ओटन परमेस्वरलं छ्याइ मानिन्याङ, थएचिते, <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />इस्राएल जातिला परमेस्वरले गे बौ बाज्याङजन छेल्स्यु मिस्र देसलं रालज्याऔक नकाङजन महान आठहराइवाङ, ओटन ओलं सक्तिल बल बर्गतले नकाङजन ना देसलन पलिईस्यु आहोन्वाङ।<note caller="-" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="EXO 16:1">प्रस्थान १६:१</ref>; <ref loc="EXO 12:51">प्रस्थान १२:५१</ref> </char></note> <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />जङ्गलला पोल छ्योअ चालिस बर्स समन ओले नकाङजन आखिम्वाङ।<note caller="-" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="EXO 16:35">प्रस्थान १६:३५</ref>; <ref loc="NUM 16:35">गन्ती १६:३५</ref>; <ref loc="DEU 1:31">ब्यबस्था १:३१</ref> </char></note> <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />तब ओले कनान देसला साट वटा जातियाङजन नस्ट आजाटौ ओटन ओयाङजन नका पोला खसम आजाएवाङ।”<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 7:1">ब्यबस्था ७:१</ref>; <ref loc="JOS 14:1">यहोशू १४:१</ref></char></note><verse eid="ACT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 13:20" />“ईका सोगलै छ्योअ चारसय पचास बर्स लागिऊ, ओलं छिन्ट शमुएल अगमबक्ताल पालासमन ओले नियादिसयाङ आयोवाङ।<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="DEU 2:16">ब्यबस्था २:१६</ref>; <ref loc="1SA 2:16">१शमूयल २:१६</ref></char></note> <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />नालछिन्ट नकाङै रय नीवाङ, ओटन परमेस्वरले बेन्यामीन कुलला किशल आज़ा शाऊलजन चालिस बर्स समन नकाङयर्त राज्य ढाऔ आयोव।<note caller="-" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="1SA 8:5">१शमूयल ८:५</ref>; <ref loc="1SA 8:19">१शमूयल ८:१९</ref>; <ref loc="1SA 10:24">१शमूयल १०:२४</ref>; <ref loc="1SA 11:15">१शमूयल ११:१५</ref> </char></note> <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />परमेस्वरले ईका बारेल बयन यांस्यु ऐलेऊ, ‘ङा यिशैल ज़ा दाऊदजन ङायिङ्कामन्ताइन्या रु डोएस्युङाल्ङु, नैताइस्यु पावलजन रयतन हताइस्यु दाऊदजन नकाङल रय ताहौनाल्ट सच्यान्ङा, जोले ङा इच्छ्याला सोगल काम पुरा ढान्यालेया।’”<note caller="-" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="1SA 13:14">१शमूयल १३:१४</ref>; <ref loc="1SA 16:12-13">१शमूयल १६:१२-१३</ref>; <ref loc="PSA 89:20">भजनसङ्ग्रह ८९:२०</ref>; <ref loc="ISA 44:28">यशैया ४४:२८</ref> </char></note><verse eid="ACT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23" />“ईका रुल भाबी सन्तानङन, ओलं बाचा अनुसार, परमेस्वरले इस्राएललं नाल्ट तोलोअ मुक्तिदाता, येशुजन आहोनौ।<note caller="-" style="x"><char style="xo" closed="false">13:23 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">२शमूयल ७:१२-१३</ref>; <ref loc="ISA 11:1">यशैया ११:१</ref> </char></note> <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />ओ आरांऔ हादेए बप्तिस्मा यांन्या यहुन्नाले इस्राएलला सोगलै रुयाङजन पापल पस्चाताप सनर बप्तिस्मालं प्रचार आढोव। <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />बप्तिस्मा यांन्या यहुन्नाले आकाम खिम्ङा आलेऊक आपानौ, ‘जे नै जेयिङचिऊ, ङा काङ्का? ङा ओ माङडी। तर ङाछिन्ट तोलोअ रांन्या लेया, जोल आखङला जुता समन बै फिरन्या लायकला ङा मालेङदी।’”<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />“ऐ, अब्राहामल बङशल सन्तान, सनर जे तन परमेस्वरलं छ्याइ मानिन्या ऐ भाईयाङ, गेल्योङ बै ईका मुक्तिल थाई परिङस्यास्यु लेया। <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />दानाङभन्या यरुशलेमला चुङन्याङ सनर नकाङल शासकयाङै येशुजन माशईस्यु सनर सोगल शबाथल परिन्या अगमबक्ताल बचनयाङ माबुजिस्यु ओजन सजायल आग्या यांस्यु ना बचन पुरा रांढोव। <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />ज्याहान सजायल नैज कारन माडोएरकन बै नकाङै ओजन सएन्यालेस्यु पिलातस सकाए बिन्ति रांढोव, <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />ओटन नकाल बारेल सरसिन्या सोगल छेन नकाङै पुरा ढोरा पाइनाई नकाङै ओजन क्रूसतन ल्हाएस्यु ऊईल रारीनौ। <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />तर परमेस्वरले नकाजन सिन्यातन जिङदा आजाटौ। <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />ओलसं गालीलङन यरुशलेमङ रांन्याङ ल्योङ ओ तबर दिन समन ठन्सिस्युलेऊ, ओटन नकाङै आकअ समन जनताल ओलं साची लिज्याऔज लिज्यारा।”<verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />“परमेस्वरले बौ-बाज्याङ सकाए आढान्या बाचाल चान्याथाई गे जेल्योङ होन्‌या। <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />अथाबा, कढाई परमेस्वरले येशुजन जिङदा आसचोटौ नका छेन गे, नकाङल सन्तानल नाल्ट बाचा पुरा आढोव, जो भजनसङग्रह नें अध्यायल साट पदल बै सरसिन्या लेया,</para>
  <para style="q" vid="ACT 13:33">‘नङ ङा ज़ा हो,</para>
  <para style="q" vid="ACT 13:33">आछिमका दिन ङा नङजन ङा जर्म ङायानु।<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="PSA 2:7">भजनसङ्ग्रह २:७</ref> </char></note><verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />ओले ख्रीस्टजन खकै माचिन्या जाएस्यु सिन्यातन जिङदा आजाएन्या बारेल ऐलेस्यु पानस्यु लेऊ, ङा जेजन दाऊदजन ङायान्या पबित्र सनर अटल आशिर्बाद यांच्या।<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="ISA 55:3">यशैया ५५:३</ref></char></note><verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />दानाङभन्या छुट्टै खन्डल बै ऐलेसिज्याया,</para>
  <para style="q" vid="ACT 13:35">कि नङ नमी पबित्र जनल बुल चिऊन्या मालेन्दी।’”<verse eid="ACT 13:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36" />“दानाङभन्या दाऊद आमिई पुस्तालं परमेस्वरलं उदश्य अनुसार सेवा ढास्यु सिऊ ओटन आबौ आबाज्याङमन री:नसिऊ तर नकाल बुलबै चिस्यु हिन्दा। <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />तर परमेस्वरले जोजन सिन्यातन जिङदा आजाटौ ओलं बुल माचिडा।”<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />“नैताइस्यु भाईयाङ जेजन थाह ग्याताइत्या, कि ईकाइ रुङन याएज रुयाङल पाप छेमा ताहा ऐलेस्यु जेजन प्रचार ढास्युई लेया। <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />जे बिस्वास ढान्या भरिले नकातन्जै सोगल छिन्ङन छुटकारा डोएस्यु लेच्या, जो छुटकारा मोशाल ब्यबस्थाङन जे नाल्ट सम्भब माल्दी। <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />ऐताइस्यु होसस लिज्याच्यो, मानकन ता अगमबक्ताङल किटापल पान्सिन्या आका छेन जेयर्त रांया<verse eid="ACT 13:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="ACT 13:41" />‘ऐ बाएढान्याङ, खिम्चिते ओटन अचम्म ताइच्या,</para>
  <para style="q" vid="ACT 13:41">ओटन नस्ट ताइच्या,</para>
  <para style="q" vid="ACT 13:41">दानाङभन्या जे बेलाक ङा तोलोअ काम ढोङा,</para>
  <para style="q" vid="ACT 13:41">ऐटाइन्या काम जोल बारेल काङ्काङै पानरकन बै</para>
  <para style="q" vid="ACT 13:41">जे सिटीमिटी बिस्वास ढान्या माल्चिदी।’”<note caller="-" style="x"><char style="xo" closed="false">13:41 </char><char style="xt" closed="false"><ref loc="HAB 1:5">हबकूक १:५</ref> </char></note><verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />पावल सनर बारनाबास आराधना झिमलन पलिईस्यु हिन्ङा नेंलेऊक रांन्या शबाथल बै ईकाइ छेन सथएसिन लेस्यु रुयाङै नकानेजन बिन्ति रांढोव। <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />आराधना खेमापाइना तबर यहूदीयाङ सनर यहूदीमत मानिन्या भक्तयाङ पावल सनर बारनाबासलं छिन्ट लागिवाङ, ओटन नकाङै ओनेस छ्योङौयन, नकाङजन परमेस्वरलं अनुग्रहत लिज्याचिते ऐलेस्यु ऐराढोवने।<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />छुट्टै शबाथ छिम्क छ्योअ सोगलै सहरला रुयाङ परमेस्वरलं बचन ठटौनाल्ट उर्लिस्यु रांवाङ। <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />हुलजन रङस्यु, यहूदीयाङ खिई ढास्युकने ओटन पावलले आछ्योङन्या छेन राकोटत्याहौ, ओटन ओलं मेहोनो रांढोव। <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />तर पावल सनर बारनाबासले साहस ढास्यु नेंपानौ, “परमेस्वरलं बचन सोगलैहादेए जेझन्जै सथएन्या आबस्यक लेया। जे ईका निर्नय मामानिस्यु जे जेईजन अनन्त जिबनल अयोग्य जेठहराहौकाले गे आब गैरयहूदीयाङ ल्योङ हिन्‌या। <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />दानाङभन्या प्रभुले गेजन ऐटाइन्या आग्या आयांयिउ, कि ‘पिरथ्बील हुङावङ समन मुक्ति सतापन्या ङा जेजन गैरयहूदीयाङ नाल्ट ज्योति ताइन्या परिङन्या लेङा।’”<note caller="-" style="x"><char style="xo" closed="false">13:47 </char><char style="xt" closed="false"><ref loc="ISA 49:6">यशैया ४९:६</ref> </char></note><verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />जब गैरयहूदीयाङै ईका छेन राथटौ, नकाङ हेसाङवाङ, ओटन परमेस्वरलं बचनल प्रसम्सा रांढोव, ओटन अनन्त जिबनल नाल्ट नियुक्त ताइन्याङ सोगलैले बिस्वास रांढोव।<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />प्रभुल बचन सोगलै पोभरिल फैलिऊ। <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />तर पावल सनर बारनाबासलं बिरोदत यहूदीयाङै भक्त सनर मिनथइन्या मेएमाङ सनर सहरला खास-खास रुयाङजन रामच्चाहौ, ओटन ओयाङजन रां सान्ढ सिमाना बाहेर देए रांकताहौ। <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />तर ओयाङ रांखङला धुलो नकाङल बिरोदत हरस्यु, आइकोनियनल रांवाङ। <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />सिइयाङ आनन्द सनर पबित्र आत्माले भरिपुरी ताइवाङ।<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">पावल सनर बारनाबास आइकोनियाल सेवाकाई</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />जब पावल सनर बारनाबास आइकोनियन राढान्या पोला यहूदीयाङल आराधना झिमल हिनस्यु ऐटाइन्या किसिमले छ्योङौने, कि यहूदीयाङ सनर ग्रीकयाङल घिन्या बगालले प्रभुत बिस्वास रांढोव। <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />तर बिस्वास माढान्या यहूदीयाङै गैरयहूदीयाङजन बिस्काइस्यु बिस्वासी भाईयाङल बिरोदत ओयाङल यिङ रा:सग्यालस्योवाङ। <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />प्रभुल भर त साहस सकाए छ्योङौयन तबर समाय समन पावल सनर बारनाबास नलै लिज्याऔने। प्रभुले नकानेल कुईतन अचम्मला कामयाङ सनर अचम्मला कामयाङ ढाऔपरिङस्युकने आमि अनुग्रहल बचनल बयन आयोव। <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />तर सहरला रुयाङल भाअसिइ ताइनाऔ, ओटन काङ्काङ यहूदीयाङ लेऊदेए सनर काङ्काङ प्रेरितयाङ लेऊदेए लागिवाङ।<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />गैरयहूदीयाङ सनर यहूदीयाङ नेपक्छेलेई रांमि शासकयाङसं मिलिस्यु ना नेंलोअ प्रेरितनेजन सताइन्या सनर लुङले टुपन्या जोर रांढोव। <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />नकानेले ईका छेन नेसनौ, नैताइस्यु लुकोनियाला सहरयाङ लुस्त्रा, डर्बी सनर आनावङला छेत्रलन ताइस्यु ढोङस्यु हिनौने, <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />ओटन नल नकानेले चान्याथाई प्रचार ढाऔयन्जै नेंढोव।<verse eid="ACT 14:7" /></para>
  <para style="s">लुस्त्रा सनर डर्बील सेवाकाई</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />ओटन लुस्त्रा सहरल तोलोअ आखङ माचलाइदुन्या रु लेऊ, ना आजर्मिऊ कन्ज लुला आटाहौकाले खकै बास्यु मालेऊ। <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />पावलले आछ्योङज्यान्या नकाले थएज्याऔ। ओटन पावलले नकाजन एखौऱ्या आखिमौक, ङा ऐबेल्ङा ऐलेन्या नकाल बिस्वास रङस्युकने। <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />बअ जोरसै कलिऊस्यु ऐआढोव, “न खङले सोझा च्याङनते।” नका जरू च्याङौ ओटन उफ्रिस्यु बाऔ तअसिऊ। <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />जब पावलले आढान्या ऐटाइन्या काम हुलले आरङौ, तब नकाङै लुकोनिया भासाङन बअघिन्या ग़ाले ऐलेवाङ, “देबनें रुल भेसतं गेल्योङ लांइस्यु रांऔने रैस।” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />नकाङै बारनाबासजन जिउस देउता सनर पावलजन हर्मेस देउता ऐढाऔ तअसिवाङ, दानाङभन्या इकाने मुख्या बक्ता लेऊने। <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />सहरल हाङन लेन्या जिउसलं मन्दिरला पुजाउरोले मुल झलाप जिऊल यीङयाङ सनर वोईल डोअ होनस्यु नला रुयाङस मिलिस्यु बलि-पुजा ढान्या बिचार रांढोव।<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />जब प्रेरित बारनाबास सनर पावलले ईका छेन नेंथटौ, तब नकानेले नेंक्वा चेईस्यु ऐलेस्यु कलिऊस्यु चोएस्यु रुयाङल खार्ल हिनौने ओटन ऐनेढोवाङ, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“ऐ रुयाङ, जे दानाङ ऐटाइन्या काम ढोच्यो? घोन बै ता जेमन्ताइन्याई दुखसुख भोघिन्या रुनें ज्याअसा, ओटन घोन जेजन आका बिकामला छेनयाङ्ङन जिङदा परमेस्वर ल्यौदेए होलौ नाल्ट चान्याथाई सथएज्याच्या, जो परमेस्वरले स्वर्ग, पिरथ्बी, समुन्दर सनर नकाङल लेन्या वाली वालीला जन्तु आजाटौ।<note caller="-" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="EXO 20:11">प्रस्थान २०:११</ref>; <ref loc="PSA 146:6">भजनसङ्ग्रह १४६:६</ref></char></note> <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />ओले हादेए ताइस्युखेमन्या पुस्ताला सोगलै जातियाङजन रांमि-रांमि चलन अनुसारला रांयमल बाऔ आयोवाङ। <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />तब बै ओले ओलजन बिना साची माराइदा, दानाङभन्या ओले दयाढास्यु जेजन नमतन रील झरि सनर शईन्या रितु अनुसारला ज्यान्या यांस्यु जे यिङजन आनन्दले शान्त आजाएचिऊ।”<note caller="-" style="x"><char style="xo" closed="false">14:17 </char><char style="xt" closed="false"><ref loc="PSA 147:8">भजनसङ्ग्रह १४७:८</ref>; <ref loc="JER 5:24">यर्मिया ५:२४</ref> </char></note> <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />प्रेरितनेले ईका छेनयाङ पानस्यास्यु धौधौ नका रुयाङजन बलि-चराइन्यातन नेंरुकिवाङ।<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />तर ख्वाए यहूदीयाङ एन्टिओखिया सनर आइकोनियनङन नल ताप्‌रावाङ, ओटन रुयाङजन मच्चाईस्यु पावलजन लुङले टुपौ रांपरिङौ, ओटन ईका सिदा ऐलेस्यु सहरलन घिसारस्यु बाहेर रालाङौ। <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />तर जब सिइयाङ चारवरङन दुउसिवाङ, तब नका सोव ओटन सहर भितरलं हिनौ, ओटन तयोअका छिम्क बारनाबास सकाए पलिईस्यु डर्बील हिनौने।<verse eid="ACT 14:20" /></para>
  <para style="s">सिरियाला एन्टिओखियाल रावलन्या</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />पावल सनर बारनाबासनेले ना दर्बिया सहरल चान्याथाई प्रचार ढास्यु तबर सिइयाङ नेंजाएवाङ, ओटन नकाने लुस्त्रा, आइकोनियन सनर एन्टिओखियाला पिसिदियाल वलौने, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />सिइयाङजन बिस्वासतं तोलोअ यिङला जाएस्यु, ज्वाए दुख भुगिन्या ताहकन्बै सहिस्यु, गे परमेस्वरलं राज्यल पसिन्याई ताहा, ऐलेस्यु ओयाङजन हौसला नयोन्वाङ। <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />जब नकानेले ओयाङल सोगल मन्डलीलं सेर अगवा तयार नेंजाएवाङ, तब प्रार्थना सनर बर्तसका ओयाङै राढान्या बिस्वास अनुसार प्रभुल जिम्मात नकाङजन रा:सुम्पिवाङ।<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />ओलं छिन्ट नकाने पिसिदिया छेत्रङन ताइस्यु पामफिलियाल रांऔने। <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />पर्गाल बचन प्रचार ढास्यु नकाने अतालियाल रांऔने।<verse eid="ACT 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 14:26" />ओटन नलन नकाने समुन्दरल बास्यु एन्टिओखिया हिनौने, जोल नकानेले पुरा नेंढोन्या कामल नाल्ट परमेस्वरलं अनुग्रहत नकाङजन अर्पन ढास्युवाङ। <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />जब नकाने एन्टिओखियाल ताप्‌राऔने, तब मन्डलीजन नेंदुउवाङ, ओटन परमेस्वरले नकानेङन आढान्या सोगलै कामल चर्चा नेंढोव, ओटन कैलेस्यु ओले गैरयहूदीयाङ नाल्ट बिस्वासलं झलाप आफएस्योवाङ नका नेसठएवाङ। <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />बारनाबास सनर पावलने एन्टिओखियाला सिइयाङस तबर दिन चुङौने।<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">यरुशलेमल बिस्वासीयाङलं बैठअ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />आब काङ्का रुयाङै यहूदियाङन एन्टिओखियाल रा:स्यु बिस्वासी भाईयाङजन ऐटाइन्या सिक्छ्या यांऔ तअसिवाङ, “जे मोशाल चलन अनुसार खटना माढोच्योकन ता जे उद्दार ताहौ माढुदुऊदी।”<note caller="-" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LEV 12:3">लेवी १२:३</ref></char></note> <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />तब पावल सनर बारनाबासलं नकाङ सकाए तबर ताकानतोकन ताहापाइना, नला बिस्वासी भाईयाङै पावल सनर बारनाबास सनर अपुर ख्वाएजन ईका पान टुङ्गाहौ नाल्ट प्रेरितयाङ सनर बिस्वासी सेरयाङ<note caller="+" style="f"><char style="fr" closed="false">15:2 </char><char style="ft" closed="false">सेर=सेर</char></note> ल्योङ, यरुशलेम हिनौ नाल्ट पक्का आजाटौ।<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />मन्डलीला सदस्याङै नकाङजन नङंन बिदा रांयोव। नकाङ फोनिके सनर सामरीयाङन ताइस्यु रांहिनौक, गैरयहूदीयाङै प्रभुजन ग्रहन राढान्या छेन नकाङजन तचिचीइङन नेसठटौ। आका थाईले नङा बिस्वासी भाईयाङ तबर जै हेसाङवाङ। <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />जब नकाने यरुशलेमल ताप्‌राऔने, तब नेंजन मन्डलीला प्रेरितयाङ सनर बिस्वासी सेरयाङै स्वागत रांढोव, परमेस्वरले नेंङन आढान्या स्वाट्टै छेनल गतिबिधि नकाङजन नेसठएवाङ। <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />तब फरिसी बगालला ख्वाएयाए बिस्वास ढान्याङै च्याङस्यु ऐलेवाङ, “गैरयहूदीयाङल खटना ढास्यान्या सनर नकाङजन मोशाल ब्यबस्था मानिन्या आग्या यांन्या आबस्यक लेया।”<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />ईका बारेल बिचार ढाऔ नाल्ट प्रेरितयाङ सनर बिस्वासी सेरयाङ दुउसिस्यु लेवाङ। <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />जमा भ्याई बहस चलियापाइना पत्रुसले च्याङस्यु नकाङजन ऐआढोवाङ, “ऐ बिस्वासी भाईबैनाङ, जेजन थाहै लेया कि हाका दिनयाङल कैलेस्यु परमेस्वरले ङा याह्‌लन गैरयहूदीयाङै चान्याथाईल बचन ग्याथएरत्या सनर बिस्वास ग्याढोरत्या लेस्यु, जेखार्लन ङाजन आछेल्ङु। <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />यिङला छेन सनन्या परमेस्वरले नकाङजन बै गे मन्जै पबित्र आत्मा योंवरा पाइना नकाङै ग्रहन राढान्या छेनयाङ आठनस्योवाङ। <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />ओले नकाङ सनर गे खार्ल नैज भेदभाब मानाएदा, तर नकाङल यिङ बिस्वासङन चोखा आजाएस्योव। <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />नैताइस्यु सिइयाङल पुङत ईका कुम नाएस्यास्यु दानाङ परमेस्वरजन अल्चिज्याच्यो? ईका कुम न त गेमि बौ-बाज्याङै न गे वुरौ गेढुदुयिउ। <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />तर गे बिस्वास ऐढोया, कि प्रभु येशुल अनुग्रहङन गे उद्दार डोएस्यु लेया, जोमनलेस्यु ओयाङै बै डोएस्यु लेरा।” <verse eid="ACT 15:11" /><verse number="12" style="v" sid="ACT 15:12" />तब बैठअलाङ सोगलै छपक्कै दिङवाङ, ओटन गैरयहूदीयाङल खार्ल परमेस्वरले नकाङतन कैताइन्या अचम्मला कामयाङ सनर अचम्मला कामयाङ आढोव नकाल चर्चा बारनाबास सनर पावलले नेंढोव। नकाङै ईका छेन राथटौ। <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />नकाने छ्योङस्यु खेमन्यापाइनाई याकूबले ऐआढोवाङ, “ऐ, बिस्वासी भाईबैनाङ, ङा छेन थएचिते। <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />परमेस्वरले आमिई मिनल नाल्ट गैरयहूदीयाङ्ङन तोलोअ जाति छेलन्या क्रिपा आढोव ऐलेन्या छेन रुयाङजन सिमोनले आपानस्योवाङ। <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />ईकाइ अगमबक्ताङल छेन बै मिलिया, जोमनताइन्या सरसिन्यालेया, <verse eid="ACT 15:15" /><verse number="16" style="v" sid="ACT 15:16" />‘ईका छेनल छिन्ट ङा वलन्यालेङा, ओटन दाऊदल तांन्या बाईपो फरि जाएन्यालेङा, नकाल तांस्युलेन्या बाईपो ङा फरि जाएस्योङा, ओटन नाजन सच्यानन्यालेङा,<note caller="-" style="x"><char style="xo" closed="false">15:16 </char><char style="xt" closed="false"><ref loc="JER 12:15">यर्मिया १२:१५</ref> </char></note> <verse eid="ACT 15:16" /><verse number="17" style="v" sid="ACT 15:17" />ओटन बाङ्की रुयाङै परमप्रभुजन रोंकौ ग्याढुदुरत्या, ओटन सोगल गैरयहूदीयाङै बै जोयाङ ङा मिनतन खुल्सिवाङ।’ <verse eid="ACT 15:17" /><verse number="18" style="v" sid="ACT 15:18" />ईका छेन परमप्रभुले आपानौ, जोले ऐका बेलाकन्ज ईका छेनयाङ जनाइस्यु लेऊ, जो स्रिस्टील सुरुकन सन्सिन्या लेऊ।”<note caller="-" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="AMO 9:9-12">आमोस ९:९-१२</ref>; <ref loc="ISA 45:21">यशैया ४५:२१</ref></char></note><verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“नैताइस्यु ङामि निर्नय आकाई ज्या, कि परमेस्वर लेऊदेए वलन्या गैरयहूदीयाङजन गे दुख यांन्यामाङदी। <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />तर नकाङजन आका छेन गेसरस्योइवाङ, कि नकाङ मुर्ति पुजाल अशुद्दताङन अलक ग्यालरत्या, ब्यबिचारङन अलक ग्यालरत्या, भोङकराअ पचिरस्यु सएसिन्या पशुल चिप सनर जीतन अलक ग्यालरत्या।<note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="GEN 9:4">उत्पत्ति ९:४</ref>; <ref loc="LEV 3:17">लेवी ३:१७</ref>; <ref loc="LEV 17:14">लेवी १७:१४</ref> </char></note> <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />दानाङभन्या हाङा पुस्ताङन्जै सहरभरि मोशाल ब्यबस्थालं प्रचार ताइरा:स्यु लेया, आका सदाई यहूदी आराधना झिमल स्वाट्टै शबाथल परीज्यासिया।”<verse eid="ACT 15:21" /></para>
  <para style="s">अपुर बिस्वासीयाङजन चिठी</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />तब प्रेरितयाङ, सेर बिस्वासीयाङ सनर सोगलै मन्डलीले मिलिस्यु, रां खार्लन ख्वाएयाए रुयाङजन छेल्स्यु पावल सनर बारनाबास सकाए एन्टिओखियाल परिङन्या सहि रामानिऊ, ओटन बिस्वासी भाईयाङ मध्य मुख्या रुनें, यहूदा ऐढासिन्या बारनाबास सनर सिलासजन रांछेलौ।<verse eid="ACT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 15:23" />“ओटन नकानेसं ओयाङै ईका चिठी रांपरिङौ एन्टिओखिया, सिरिया सनर किलिकियाल लिज्यान्या मन्डलीला गैरयहूदी भाईबैनाङजन प्रेरितयाङ सनर सेर बिस्वासीयाङजन अभिबादन। <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />गे थएस्यु गेलेयिउ कि, गे खार्ला काङ्का-काङ्काङै गे आदेस बिनाईज जे यिङ दोधारल जाएस्यास्यु जेजन भ्याई छेनले दुख यांस्यु रानाएचिऊ। <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />नैताइस्यु गे सोगलैल सहमतित ढासिन्या निर्नय अनुसार ख्वाएयाए रुयाङजन छेल्स्यु नकाङजन गेमि ङानिज्युन्या बारनाबास सनर पावल सकाए परिङन्या गेजन ठिक लागिऊ। <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />ईका रुयाङ ऐटाइन्या ग्याताइत्या, जोले गेमि प्रभु येशु ख्रीस्टल नाल्ट रां परान जोखिमल पराइस्यु लेर। <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />नैताइस्यु गे यहूदा सनर सिलासजन परिङस्यु गेलेयिउ। नकानेले बै ना छेनयाङ याह्‌लेई पानन्यालेन्या। <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />दानाङभन्या पबित्र आत्मा सनर गेजन ईका ठिकलागिऊ, कि ईका आबस्यक छेनयाङ बाहेक अपुर तबर वुर जेजन बोकाइन्या माचाहिइडी। <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />जे शुरुपयाङजन बलि जेचराइन्या जन्तु, जी, भोङकराअ पचिरस्यु सएसिन्या पशुल चिप सनर ब्यबिचारतन अलक लेचिते। ईका छेनयाङतन अलक लेच्योकन चान्या ताइन्यालेया।”<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="GEN 9:4">उत्पत्ति ९:४</ref>; <ref loc="LEV 3:17">लेवी ३:१७</ref></char></note><verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />बिदाबारी ताहा पाइनाई बारनाबास, यहूदा, सिलास सनर पावलयाङ एन्टिओखियाल रांवाङ, ओटन बिस्वासी बगालजन तचोएकै दुउस्यु ना चिठी रांयोव। <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />चिठील लेन्या अर्थला छेन डोएसिऊ नकाङ हेसाङस्यु उत्साहित ताइवाङ। <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />यहूदा सनर सिलास नें बै अगमबक्ता नेंताहौकाले बिस्वासी भाईयाङजन तबर बचनङन अर्थ यांस्यु नकाङजन साहसी सनर बलल्या नेंजाटौवाङ। <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />नकाने तचिइ समाय नङ बिताइन्या पाइना नङा बिस्वासी भाईबैनाङै नकाङजन परिङन्याङ ल्योङ चान्यासकाए बिदा यांस्यु रांपरिङौ। <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />तर सिलासजन नङै चुङन्या चान्या लागिऊ।<verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />पावल सनर बारनाबास सिक्छ्या यांऔयन प्रभुल बचन प्रचार ढाऔयन अपुर तबर जनाङसं एन्टिओखियाल छिन्ङ समन ओलै लिज्याऔने।<verse eid="ACT 15:35" /></para>
  <para style="s">पावल सनर बारनाबासने नेभाअसिन्या</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />तचिइ दिनछिन्ट पावलले बारनाबासजन आढोव, “रांन्ते, जो-जो सहरल प्रभुल बचन घोन प्रचार घेनढोचिऊ नका सहरयाङल वलस्यु हिनस्यु भाईबैनाङजन डोएन्याङ ओटन नकाङ नै कैताइज्यावाङ खिमन्याङ।” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />बारनाबासले मर्कुसं ऐढासिन्या यहुन्नाजन नेसकाए लाङन्या बिचार आढोव। <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />तर पावलले मर्कुसजन नें सकाए लाङन्या ठिकमामानिदा, दानाङभन्या नका पामफिलियाङन नकाङसं छुतिस्यु लेऊ, ओटन नकाङ सकाए कामल हिनस्यु मालेव। <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />नकाङल खार्ल आवाए घिन्या यिसिई ताहौ, कि नकाने नेंने भाअसिऊने, ओटन बारनाबास मर्कुसजन ओलसं लाङस्यु साइप्रसदेए हिनौ। <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />तर पावलले सिलासजन आछेलौ, ओटन भाईयाङ्ङन परमेस्वरलं अनुग्रहल अर्पन ताइस्यु बिदा ताहौ। <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />मन्डलीयाङजन बलल्या जाटौवन नकाले सिरिया सनर किलिकिया ताइस्यु भ्रमन रांढोव।<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">पावल सनर सिलास सकाए तिमोथी आहिनन्या</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />पावल डर्बी सनर लुस्त्रालं बै रांऔ। ओलं तिमोथी मिनला तोलोअ सिइ लेऊ। नका तोलोअ बिस्वासी यहूदी मेएमाल ल्हेपाज़ा हो, तर नकाल आबौ ग्रीक हो। <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />लुस्त्रा सनर आइकोनियनला बिस्वासी भाईयाङतन नकाल मिन चलिस्यु लेऊ। <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />तिमोथीजन पावलले ओलसं लाङन्या यिङ आढोव। तर ना पो ज्युउल लिज्यान्या यहूदीयाङल कारनले पावलले नकाजन लाङस्यु खटना आढोस्योव। दानाङभन्या नकाल बौ ग्रीक हो ऐलेन्या नकाङ सोगलैजन थाह लेऊ। <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />आब नकाङ सहर जिऊला यम ताइस्यु रांहिनौक नकाङै यरुशलेमला प्रेरितयाङ सनर मुख्या सेर बिस्वासीयाङै राढान्या निर्नययाङ मानिन्या ढोचिते, लेस्यु रा:सथएवाङ। <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />ऐलेस्यु मन्डलीयाङ बिस्वासतं बलल्या ताहौयन सनर सङख्याल दिनकाई बदिस्यु हिन्वाङ।<verse eid="ACT 16:5" /></para>
  <para style="s">त्रोआसल पावलल दर्शन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />पबित्र आत्माङन एशियाल बचन प्रचार ढाऔ माडोएन्या आताहौकाले पावल सनर आन्हाएयाङ फ्रिगिया सनर गलातियाला पो ज्युउलन ताइस्यु हिन्वाङ। <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />माइसियाला सान्ढल रारापाइना नकाङै बिथिनिया प्रदेस देए हिनन्या बिचार रांढोव। तर येशुल आत्माले नकाङजन हिनौ मायोदुऊरा। <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />तब माइसिया ताइस्यु नकाङ त्रोआसल हिन्वाङ। <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />रिउल पावलले तोलोअ दर्शन आरङौ माकेडोनियाला तोलोअ रु च्याङस्यु ओलजन बिन्ति ढाज्याव, “माकेडोनियाल रांन्ते, ओटन गेजन व्एन्या ढासिन्ते।” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />जब पावलले ईका दर्शन आडोटौ, ओचोएटै गे माकेडोनिया हिनन्या तयार गेताइयिउ। गे ईका पक्का गेढोयिउ कि नकाङजन चान्याथाई प्रचार ढावनाल्ट परमेस्वरले गेजन आखुलयिउ रैस।<verse eid="ACT 16:10" /></para>
  <para style="s">लिडियाल यिङ फिलिप्पील आफिरिसिन्या</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />तब गे त्रोआसङन री जाहसतं चरिस्यु सिधै सामोथ्राकेदेए<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="ft" closed="false">सामोथ्राकेल अर्थ टापु</char></note> गेहिन्यिउ, ओटन तयोअका छिम्क नियापोलिसलं गेतापरायिउ, <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />ओटन गे माकेडोनियाला जो पहेला जिल्ला फिलिप्पी सहरल गेरांयिउ, ओटन जो रोमी उपनिबेस हो। गे ना सहरल तचिइ दिन गेचुङयिउ। <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />आब शबाथ छिम्क सहरला झलाप तन बाहेर भई वङल गेहिन्यिउ, दानाङभन्या नङ प्रार्थना ढान्या पो लेया लेस्यु गे अनुमान गेढोयिउ ओटन नङ गेचुङयिउ ओटन दुउसिस्यु लेन्या मेएमाङस छेनपान छ्योङौ गेलागियिउ। <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />ओटन थिआटीरा सहरला चुङन्या, धुङल्याइन्या रङला क्वाल ब्यापार ढान्या लिडिया मिनला तोलोअ ईस्वरभक्त मेएमाले गेमि बचन आठटौ। पावलले आछ्योङन्या छेन ध्यानसं ग्याथएरत्या ऐलेस्यु प्रभुले नकाल यिङ आखुलिस्यौ। <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />जब ओलं सनर आझिमलाङ सोगलैले बप्तिस्मा राहोनौ, तब नकाले गेजन बिन्ति आजुरिऊ, “यदि जे ङाजन प्रभुल बिस्वासीनी यिङ्ङच्योकन ङा झिमल रा:स्यु चुङचिते।” ऐलेस्यु नकाले गेजन कर आलाइयिउ।<verse eid="ACT 16:15" /></para>
  <para style="s">पावल सनर सिलास झ्यालखानाल</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />जब गे प्रार्थना ढान्या पोल गेहिनज्यायिउ, तब अख्यान रङन्या आत्मा लेन्या तोलोअ नोक्कर्नि मेएमासकाए गे गेडोएसियिउ, जोले अख्यान ढास्यु नकाल साहूल नाल्ट भ्याई पैसा कमाइ ढोस्यौरा। <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />नका पावल सनर गे छिनछिन लागिऊ, ओटन ऐलेस्यु कलिकौ, “ईका रुयाङ सर्बोच्च परमेस्वरलं सेवाऱ्याङ हो। इकाङै जेजन मुक्तिल ऐलेस्यु मुइरा।” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />ना मेएमाले तबर दिन समन ऐजै लिज्याऔ। तब पावलले झिजो मानिस्यु फरक्कै वलस्यु ना दुस्टआत्माजन ऐआढोव, “येशु ख्रीस्टल मिनतन ङा नङजन नका ल्योङन पलिईन्या आग्या यांना।” ओटन दुस्टआत्मा नवाए बेलाजै पलिईदा।<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />तर नकाल खसमयाङै नकाङल कमाइल आस आमालन्या रङस्यु पावल सनर सिलासजन कोलोअस्यु बजारला चोकल शासकयाङ ल्योङ सेलस्यु रालाङौ। <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />ओटन नकानेजन सहरला रोमी अढिकारीयाङ ल्योङ हिनस्यु ऐराढोव, “ईका रुनें यहूदीने हो, ओटन इकाने गे सहरल होहल्ला मच्चाईन्या।<note caller="-" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="1KI 18:17">१राजा १८:१७</ref> </char></note> <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />इकानेले ऐटाइन्या सिक्छ्या ह्युउन्या जो रोमी शासकलं नियामल बिरोदल लेऊ, जो निया सङ्गत माल्दी।” <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />तब हुलयाङ मिलिस्यु पावल सनर सिलासनेलयर्त परिरावाङ। सहरला हाकिमयाङै नकानेल क्वा चिइस्युकने राक्याइस्यौ, ओटन नकानेजन सिप्का राइस्यान्या आग्या रांयोव। <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />ओयाङै पावल सनर सिलासनेजन भ्याई सिप्का रांलाहौ छिन्ट नकानेजन झ्यालखानाल राझोकौ, ओटन झ्यालखानाला हाकिमजन ईका कैदीयाङजन कडा नजरत नाएन्या आदेस आयोव। <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />ऐटाइन्या आदेस डोएस्यु नकानेजन झ्यालखानाल भितरङा पोल लाङस्यु नकानेल खङल यिईन्या फत्किला ठुकिस्यु रांनाटौ।<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />तर आधा रिउल पावल सनर सिलास प्रार्थना ढाऔयन परमेस्वरलं भजन रेएसिज्याऊने, ओटन छुट्टै कैदीयाङै ओ थएज्यावाङ। <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />तब झुकाउन्या तोलोअ घिन्या भुईचाल रांऔ, ओटन झ्यालखानाला जगयाङ हल्लिवाङ, ओटन ओचोएटै सोगलै झलापयाङ फएसिवाङ, ओटन सोगलैल बन्दनयाङ पलाअसिवाङ। <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />झ्यालखानाला हाकिम मिऊरुइङन सन्सिऊ, ओटन झ्यालखानाला झलापयाङ आफएसिज्यान्या रङस्यु कैदीयाङ सोगलै ढोङदुरा ऐलेन्या यिङस्यु नकाले ओलझन्जै सएन्या बिचारले तरवाल आसेलौ। <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />तर पावलले जोरसं ऐलेस्यु कलिकौ, “नङ नङझन्जै नैज नोक्सान ताढो, दानाङभन्या गे सोगलै इलै लिज्याया।”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />तब भाङ नीस्यु नका तरवाल आसिपलं झोअस्यु भितरलं रांऔ, ओटन छ्याहै वुउस्यु पावल सनर सिलासनेल खङल लेऊक गोम लेस्यु फलुप्सिऊ। <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />नकानेजन बाहेर हिनस्यु नकाले ऐआढोवने, “गुरु ज्यू, उद्दार डोटौ नाल्ट ङा नै ढान्या ताहौ?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />ओटन नकानेले ऐनेढोव, “प्रभु येशु ख्रीस्टतं बिस्वास ढोते, नङ उद्दार डोएना ओटन नजाहानयाङै बै।” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />नकानेले ओलजन सनर आझिमल लिज्यान्याङ सोगलैजन प्रभुल बचन नेसठटौ। <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />तब रिउला नकाई बेला ओले नकानेजन लाङस्यु घाऊ आचेईस्यौने। ओटन ओलं सनर आजाहानयाङै ओचोएटै बप्तिस्मा राहोनौ। <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />नकाल छिन्ट पावल सनर सिलासनेजन झिमल हिनस्यु नकानेजन ज्यान्या रांयोव, ओटन परमेस्वरतं बिस्वास रांढोव ऐलेन्या छेनत खुशी ताइस्यु आमि सोगलै जाहानयाङस ना आनन्दै ताइवाङ।<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />तर तयोअका छिम्क छकाल्या ताहापाइनाई सहरला रोमी हाकिमयाङै सिपाइयाङजन ईका आदेस यांस्यु रांपरिङौ, “ना नकानेजन राइचिते।”<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />तब झ्यालखानाला पहरादारले पावलजन ईका छेन आसथटौ, “सहरला हाकिमयाङै झेनजन राइन्या आदेस रायांयिउ। नैताइस्यु आब पलिईस्यु शान्तिसं हिन्चिन्ते।”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />तर पावलले शासकयाङजन ऐआढोवाङ, “घोन रोमी नागरिकजन दोसी जै माठहराइस्यु नकाङै रुयाङल हार्मै रातुप्चिऊ, ओटन झ्यालखानाल बै झोअदुचिरा, ओटन आब घेनजन गोप्यल पलिटौ रोअरा? ईका ताहौ माढुदुऊदी। रोमी अढिकारीयाङ रांईज ग्यारांरत्या ओटन घेनजन पलिईस्यु ग्यालाङचिरत्या।” <verse eid="ACT 16:37" /><verse number="38" style="v" sid="ACT 16:38" />ना सिपाइयाङै रोमी हाकिमयाङजन आछेन रापानस्यौ। नकाने ता रोमी नागरिक रैस ऐलेन्या थएस्यु नकाङ छ्याएवाङ। <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />नकाङ पावल सनर सिलास ल्योङ रा:स्यु छेमा नीवाङ, ओटन नकानेजन बाहेर रालाङौ ओटन सहर राइस्यु हिन्चिन्ते लेस्यु बिन्ति रांढोव। <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />नकाने कैदलन पलिईस्यु लिडियाल झिमल हिनौने, ओटन बिस्वासी भाईयाङ सकाए डोएसिस्यु नकाङजन उत्साह यांस्यु बिदा ताहौने।<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">पावल सनर सिलास थेसलोनिकेलं</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />पावल सनर सिलास अम्फिपोलिस सनर अपोल्लोनियाला यम ताइस्यु थेसलोनिकेलं रांऔने। नङ यहूदीयाङल तोलोअ आराधना झिम लेऊ। <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />पावल आबानि अनुसार नकाङ आराधना झिम भितरलं हिनौ, ओटन तिन साटा समन पबित्रशास्त्रङन नकाङ सकाए छ्योङज्याऔ। <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />“ख्रीस्टजन ऐजै दुख भुगिन्या सनर सिन्यातन जिङदा ताहौजै परिऊ, ओटन ईकाइ येशु, जोल चान्याथाई जेजन ङा सथएचिऊ, ओइ ज ख्रीस्ट ज्या” ऐलेन्या छेनल अर्थ खुलिस्यु पावलले प्रमानित आजाएस्योवाङ। <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />नकाङ मध्य ख्वाए जनाले पावल सनर सिलासस लागिवाङ। ओटन घिन्या बगालला ईस्वरभक्त ग्रीकयाङ सनर ख्वाएयाए मुख्या मेएमाङ बै बिस्वास ढाऔ भन्वाङ।<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />तर खिई वुरस्यु यहूदीयाङै बजारला बदमासयाङजन दुउस्यु हुल वुरस्यु सहरल खैलाबैला मच्चाहौ रापरिङवाङ, ओटन यासोनल झिमल हमला ढास्यु पावल सनर सिलासजन जनताङल सामन्दी होनौ रारोकौ। <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />नकानेजन डोटौ माढुदुस्यु, नकाङै यासोन सनर काङ्का-काङ्का भाईयाङजन सहरला शासकयाङ ल्योङ ऐढास्यु कलिकौयन घिसारस्यु राहोनौ, “सङ्सारजन उलत्या सुलत्या जाएन्या आरुयाङ इल बै ताप्‌रा:स्यु लेरा। <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />नकाने यासोनल पाहुना ताइस्यु लेऊने, ओटन नकाङ सोगलैले येशु ऐढासिन्या तोलोअ छुट्टै रय लेऊरैस ऐलेस्यु कैसरलं नियामल बिरोदत काम जेढाज्याचिऊ।” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />ईका छेन थएस्यु रुयाङ सनर सहरला शासकयाङ आतिवाङ। <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />नकाङै यासोन सनर बाङ्की रुयाङ्ङन धरौटी रुप्या नाएस्यु नकानेजन राराहौ।<verse eid="ACT 17:9" /></para>
  <para style="s">बेरियाल पावल सनर सिलास</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />बिस्वासी भाईयाङै ओचोएटै पावल सनर सिलासजन रिउलै बेरिया रांपरिङौ, ओटन जब नकाने ओङ तापौने तब नकाने यहूदीयाङल आराधना झिम भितरलं हिनौने। <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />बेरियाला यहूदीयाङ थेसलोनिकेलाङतन भ्याई चान्या लेवाङ दानाङभन्या इकाङै पुरै बअ चासोसकाए बचन ग्रहन रांढोव, ओटन ना छेनयाङ ठिक नैताइन्याई ज सन् माङडी ऐलेस्यु दिनकाई पबित्रशास्त्र ब्याएस्यु छुटाइन्या रांढोव। <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />नैताइस्यु इकाङ मध्य, समुदायला मुख्या तचिइ तबर घिन्या घार बगालला ग्रीक मेएमाङ सनर ल्हेपा रुयाङै बिस्वास रांढोव। <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />तर जब परमेस्वरलं बचन पावलङन बेरियाल बै प्रचार ताइज्याऔ ऐलेन्या थेसलोनिकेला यहूदीयाङै रा:सनौ, तब ओयाङ नङ बै हुलयाङजन छेनन्या सनर मच्चाईन्या ताप्‌रावाङ। <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />तब बिस्वासी भाईयाङै ओचोएटै पावलजन समुन्दरङन रांपरिङौ। तर सिलास सनर तिमोथी बेरियालै चुङौने। <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />पावलजन नुल्नाङन्याङै ओलजन एथेन्स समन राहोनौ। सिलास सनर तिमोथीने घेनढुदुऊ समन छिटै नका ल्योङ हिनन्याई ताहा ऐलेन्या आग्या डोएस्यु नकाने बेरियाल वलौने।<verse eid="ACT 17:15" /></para>
  <para style="s">पावल एथेन्सलं</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />पावलले सिलास सनर तिमोथीनेजन एथेन्सलं आवुइज्याऔक, ना सहरजन स्वरुपै स्वरुपले फाङआताइज्यान्या रङस्यु नकाल यिङ हूरौ। <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />ऐताइस्यु नकाले यहूदीयाङ सनर ईस्वरभक्त जनयाङसं आराधना झिमल, सनर राडोएसिन्या भरियाङस बजारला द्वाहाल सोगल रुयाङस दिनकाई यिसीइ रांढोव। <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />इपिक्युरी सनर स्तोइकी दार्शनिकयाङ मध्य बै ख्वाएयाएले नका सकाए छेनपान रांढोव। नकाङ ख्वाएयाएले ऐलेवाङ, “ईका गनगन्याले नै आपानौ?” “अपुऱ्याङै ऐलेवाङ, अपुर बिदेसी देबी-देउताङल प्रचार ढान्यामन ताइन्याई रंना।” दानाङभन्या पावलले येशु सनर सिन्यातन जिङदा ताइन्या छेनल प्रचार ढाज्याऔ। <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />तब नकाङै ओलजन अरियोपागसलं रालाङौ ओटन रांगिनौ, “नङ नयांन्या ईका छार सिक्छ्या नै रैस, नैति गे सनौ गेढुदुयिउ? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />दानाङभन्या नङ गे नांल अचम्मला छेनयाङ सथएज्याना। ऐताइस्यु ईका छेनल मतलब नैति गे नका सनौ रोअया।” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />सोगलै एथेन्स बासियाङ सनर नङ चुङन्या बिदेसीयाङ छार-छार छेन पानन्या या थएन्या बाहेक रांमि समाय अपुर नैज छेनल माबिताइरदी।<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />तब पावलले अरियोपागसलं खार्ल च्याङस्यु ऐआढोवाङ, “ऐ एथेन्सला रुयाङ, जेजन ङाजन सोगल तबर देउताङल भक्तमन्ताइन्या जेरङचिऊ। <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />दानाङभन्या ङा बाऔयन ङाढाज्याऊक सहरल जे जेपुजिन्या जन्तुयाङ ङा ङारङ्ङु। ङा तोलोअ ऐटाइन्या थान बै ङाडोएङु जोत ‘माशईसिन्या देउताल नाल्ट’ ऐटाइन्या कुरिसिन्या लेऊरैस। ऐताइस्यु जे मासनस्यु पुजिज्याच्या नाजन ङा जे खार्लैज ङापानज्याङु।” <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />परमेस्वर जोले सङ्सार सनर नकाल लेन्या सोगल जन्तु आजाटौ, ओ स्वर्ग सनर पिरथ्बील प्रभु आताहौकाले कुईले जाएसिन्या मन्दिरलं बाए माचुङडी,<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="1KI 8:27">१राजा ८:२७</ref>; <ref loc="2CH 6:18">२इतिहास ६:१८</ref>; <ref loc="PSA 146:6">भजनसङ्ग्रह १४६:६</ref> </char></note> <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />ओजन कोबाअ जन्तुल अभाब आपरिउमन लेस्यु रुल कुईतन ओलं सेवा ढाऔपरिऊ लेस्यु तायिङच्यो। दानाङभन्या ओले जै सोगलैजन जिबन परान सअ सनर सोगलै जन्तु योंवरा।<note caller="-" style="x"><char style="xo" closed="false">17:25 </char><char style="xt" closed="false"><ref loc="ISA 42:5">यशैया ४२:५</ref>; <ref loc="PSA 50:12">भजनसङ्ग्रह ५०:१२</ref></char></note> <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />परमेस्वरले तोलोअ रुतन सोगल पिरथ्बील बाए चुङन्या रुयाङ हरेक जाति आजाटौ। नकाङजन ठहराइसिन्या समाय सनर सिमा बै पक्का आजाएस्योवाङ,<note caller="-" style="x"><char style="xo" closed="false">17:26 </char><char style="xt" closed="false"><ref loc="DEU 32:8">ब्यबस्था ३२:८</ref></char></note> <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />नकाङै परमेस्वरजन ग्यारोअरत्या, सक्या नकाङै छपछप लेस्यु ओजन रांडोटौ सन् ऐलेन्या आस त ऐलेस्यु। फिरि बै ओ गे काङ्काईतन लोए माल्दी।<note caller="-" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="ISA 55:6">यशैया ५५:६</ref>; <ref loc="JER 23:23">यर्मिया २३:२३</ref> </char></note> <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />जोमनलेस्यु काङ्काङै ऐलेऊ, “गे ओलटै बान्चिया, ओटन ओङंन्जै बान्या चलिन्या ढोया सनर ओलटै गेमि अस्तित्व लेया। जे जेमिई कबिले बै पानस्यु नाएरा, ‘गे पक्का ओलै सन्तानयाङ ज्या।’”<verse eid="ACT 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />“आब गे परमेस्वरलं सन्तान गेताहौकाले, परमेस्वर सुन, चान्दी या लुङमन ज्या लेस्यु गे यिङन्या माताइदी, इकाङता रुल सिप सनर यिङसिन्या प्रतिरुपयाङ याएजै ज्या।<note caller="-" style="x"><char style="xo" closed="false">17:29 </char><char style="xt" closed="false"><ref loc="GEN 1:27">उत्पत्ति १:२७</ref>; <ref loc="ISA 40:18-20">यशैया ४०:१८-२०</ref>; <ref loc="ISA 44:10-17">यशैया ४४:१०-१७</ref> </char></note> <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />ऐटाइन्या अग्यानताल समायजन परमेस्वरले ध्यान माढोदा, तर आब सोगल पोल सोगल रुयाङजन पापला यमलन पस्चाताप ढान्या आग्या योंवा। <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />दानाङभन्या ओले तयोअ तुकिसिऊ नाएवा, जो छिम ओले ओलजै आखताइन्या तोलोअ ब्यक्तिङन धार्मिकताल सङ्सारलं निया ढान्यालेया। ओजन सिन्यातन जिङदा जाएसिऊ ओले सोगलै रुयाङजन इकाल प्रमान यांस्युई लेया।”<note caller="-" style="x"><char style="xo" closed="false">17:31 </char><char style="xt" closed="false"><ref loc="PSA 9:8">भजनसङ्ग्रह ९:८</ref>; <ref loc="PSA 72:2-4">भजनसङ्ग्रह ७२:२-४</ref>; <ref loc="PSA 96:13">भजनसङ्ग्रह ९६:१३</ref>; <ref loc="PSA 8:9">भजनसङ्ग्रह ८:९</ref>; <ref loc="ISA 2:4">यशैया २:४</ref> </char></note><verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />जब नकाङै पावलले सिन्यातन जिङदा ताइन्या बारेल आपानन्या राथटौ, तब काङ्का-काङ्काङै रांगिलल्याहौ। तर अपुऱ्याङै “गे तपाला बै ईका बारेल नछेन थएया” ऐलेवाङ। <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />ओलं छिन्ठक्क पावल बैठअलन हिनौ। <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />तर ख्वाएयाए रुयाङ ओलसं लागिवाङ, ओटन बिस्वास रांढोव। नकाङ तन अरियोपागसला सदस्य डियनुसियस, दामारिस मिनला तोलोअ मेएमा, सनर अपुऱ्याङ बै लेवाङ।<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">पावल कोरिन्थील</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />ओटन नाल छिन्ट पावल एथेन्स सहर राइस्यु कोरिन्थीले हिनौ। <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />नकाले पोन्टसलं जर्मिन्या अकिलास मिनला तोलोअ यहूदीजन आडोटौ। नका आमेएमा प्रिस्किलास इटालियाङन रा:स्यु लेऊ, दानाङभन्या सम्राट क्लौडियसले सोगलै यहूदीयाङजन रोमङन पलिईस्यु हिनन्या आग्या आयोवाङ। पावल नकाङजन डोएनाव। <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />नकाङ तोलोअ तिरपाल जाएन्या पेशाला राटाहौकाले पावल बै नकाङसै चुङौ, ओटन काम आढोव। दानाङभन्या नकाङल पेशा तिरपाल जाएसिऊ चुङौ नाल्ट जिबिका चलाइज्यावाङ। <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />सदाईका शबाथल नका आराधना झिमल बहस ढोवा, ओटन यहूदीयाङ सनर ग्रीकयाङजन बिस्वासतं होनन्याल नाल्ट सभनन्या कोशिस आढोवाङ।<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />जब सिलास सनर तिमोथी माकेडोनियाङन ताप्‌राऔने, ओटन पावलले यहूदीयाङजन येशु जै ख्रीस्ट ज्या, ऐलेस्यु बचन प्रचारल सोगल समायतन लाइस्यु नकाले गवाइ आयोवाङ। <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />तर जब नकाङै बिरोद ढास्यु नकाल बाए ढाऔ लागिवाङ, तब नाले आक्वा हरस्यु नकाङजन आढोवाङ, “जे जी जे ङएलै ग्यापरित्या, ङा दोस माल्दी। आबकन ङा गैरयहूदीयाङ ल्योङ हिनन्यालेङा।” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />तब पावलले ओयाङजन बनाएस्यु नङंन परमेस्वरलं भक्ति ढान्या तितस युस्तस मिनला गैरयहूदी रुल झिमल चुङौ नाल्ट हिनौ। ओलंझिम आराधना झिमल वङ्क लेऊ। <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />यहूदी आराधना झिमला शासक क्रिस्पसलं सोगल जाहानले प्रभु त बिस्वास रांढोव, ओटन कोरिन्थीयाङ मध्य बै तबर रुयाङै पावलल बचन थएस्यु बिस्वास रांढोव, ओटन बप्तिस्मा राहोनौ।<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />तरिऊ प्रभुल पावलजन दर्शनत ऐआढोव, “ताछ्यातन, तर ङा बचन छ्योङौयन ढाज्यान्ते, ओटन छपक्कै तादिङन, <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />दानाङभन्या ङा नङसं लिज्याङा, काङ्काईले नयर्त परिरास्यु नैज हानि ढाऔ माढुदुऊदी, दानाङभन्या ईका सहरल ङामि भ्याई रुयाङ लिज्यारा।”<note caller="-" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="ISA 41:10">यशैया ४१:१०</ref>; <ref loc="ISA 43:5">यशैया ४३:५</ref>; <ref loc="JER 1:8">यर्मिया १:८</ref> </char></note> <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />ओटन रुयाङजन परमेस्वरलं बचन ह्युउकौयन ढास्यु पावल त बर्स छ मैना समन कोरिन्थीलै लिज्याऔ।<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />जब गलियोन अखैयाला शासक ताहौ, तब कोरिन्थीला यहूदीयाङ तपोईलै ताइस्युकने पावलल यर्त परिवाङ, ओटन नकाजन कोलोअस्यु अदालतल राहोनौ, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />ओटन नकाङै ऐलेवाङ, “ईका रुले ब्यबस्थालं बिरोदत परमेस्वरलं आराधना ढान्या रुयाङजन ह्युउज्याऔ।”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />जब पावल छ्योङ्ङाइ लिज्याऔ, तब गलियोनले नका यहूदीयाङजन आढोवाङ, “ऐ यहूदीयाङ, यदि मछ्युजै ईका तचिइ अनिया या घुर्बी अपरादल छेन आताइन्या ताहकन ङा जेमि छेन ध्यानसं थएन्या ठिक ताइन्यालेऊ। <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />तर शब्दयाङ, मिनयाङ सनर जे-जेमिईज ब्यबस्थालं सवाल आताहौकाले जे-जेईज बिचार ढोचिते। ङा ऐटाइन्या छेनयाङल निया ढान्या सुइकार माढोङदी।” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />ओटन ओले नकाङजन अदालतलन आचाहारवाङ। <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />तब नकाङ सोगलैले आराधना झिमला शासक सोस्थेनेसजन कोलोअस्यु अदालतल सामन्दी राटुपौ। तर गलियोनले ना छेनल नैज वास्ता मानाएदा।<verse eid="ACT 18:17" /></para>
  <para style="s">पावल एन्टिओखियाल वलस्यु रांऔ</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />नकाल छिन्ट पावल तबर दिन समन कोरिन्थील लिज्याऔ। तब भाईयाङस बिदा ताइस्यु नका जहासतं सिरियाल हिनौ। नका सकाए प्रिस्किला सनर अकिलासने बै लेऊने। नकाले कोबाअ बर आनीउकाले नका बाचा अनुसार किङक्रियाल हिनस्यु आचेम आयनौ।<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="NUM 6:18">गन्ती ६:१८</ref></char></note><verse eid="ACT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 18:19" />नकाङ एफिससलं ताप्‌रावाङ, ओटन पावलले अकिलास सनर प्रिस्किलानेजन नलै आबनाटौने, ओटन ओलं तोलोअ आराधना झिमल पसिस्यु यहूदीयाङस बहस ढाऔ तअसिऊ। <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />तब नकाङै ओलजन अझै तचिइ दिन चुङन्या बिन्ति राढाऔक नकाले आमाभनस्योवाङ। <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />नकाङसं बिदा आताहौक नाले आढोवाङ, “परमेस्वरलं इच्छ्या ताहकन ङा फरि वलस्यु जेल्योङ ऐरांङा।” तब नका री जहासलं चरिस्यु एफिससलन हिनौ।<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />जब ना कैसरियाल ताप्स्यु लाहौ, तब नका यरुशलेमल हिनौ ओटन तङ्ङ वूमस्यु मन्डलीलं डोएसिस्यु अभिबादन ढास्यु एन्टिओखियाल वलौ। <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />नकाले नल तचिइ दिन बिताइस्यु नङंन पलिईस्यु गलातिया सनर फ्रिगियाला पोलन ताइस्यु सोगलै सिइयाङजन हौसला यांऔयन छुटाछुट्टै पो जिऊल हिनौ।<verse eid="ACT 18:23" /></para>
  <para style="s">एफिसस सनर कोरिन्थील अपोल्लोस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />तचिइ समायल अलेक्जेन्ड्रिया सहरल जर्मिन्या अपोल्लोस मिनला तोलोअ यहूदी एफिससलं रांऔ। नकाजन पबित्रशास्त्रलं चान्या ग्यान लेऊ। <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />नकाले प्रभुल सत्य यमल सिक्छ्या डोएस्यु आनाटौ, ओटन आत्मात उत्साहित ताइस्यु येशुल बारेला छेनयाङ चान्यासै छ्योङन्या सनर ह्युउन्या आढोव। अथाबा नाले बप्तिस्मा यांन्या यहुन्नाल बप्तिस्मालं बारे याएज सनस्यु लेऊ। <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />नका यहूदी आराधना झिमल साहस सकाए छ्योङौ लागिऊ। तर नकाले आछ्योङन्या छेन थएस्यु प्रिस्किला सनर अकिलासनेले नकाजन नें झिमल नेंहोनौ, ओटन परमेस्वरलं यमल अर्थ जन अझै प्रस्टै नेंबुजाहौ। <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />अपोल्लोसले अखैया राढान्या पोल हिनन्या यिङ आढाऔक बिस्वासी भाईयाङै नकाजन नङ हिनन्या अझै हौसला रांयोव, ओटन नकाजन सुइकार ग्याढोरत्या लेस्यु नङा सिइयाङजन उत्साह यांस्यु चिठी रा:सरौ। नाले नङ तापौ ओटन अनुग्रहङन बिस्वास ढान्याङजन तबर आव्एवाङ। <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />दानाङभन्या नकाले पबित्रशास्त्रला बचनङन येशु जै ख्रीस्ट ज्या ऐलेन्या ईका छेन प्रमानित जाएस्युकने यहूदीयाङजन सोगलै रुयाङल हार्मै नैज माछ्योङडुन्या आजाएवाङ।<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">पावल एफिससलं</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />अपोल्लोस कोरिन्थी सहरल आलिज्याऔ बेलाक, पावल भितरला इलाकाङन ताइस्यु एफिससलं रांऔ। पावल काङ्का काङ्का सिइयाङस डोएसिऊ। <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />पावलले नकाङजन ऐआढोवाङ, “जब जे बिस्वास ढास्यु पबित्र आत्मा जेडोएचिऊ?” नकाङै ऐलेवाङ, “गे खकै बै पबित्र आत्मा लेया ऐलेन्या थएस्यु मालेईदी।” <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />पावलले नकाङजन ऐआढोवाङ, “तब जे कैताइन्या किसिमला बप्तिस्मा जेहोन्चिऊ?” नकाङै ऐलेवाङ, “बप्तिस्मा यांन्या यहुन्नाल बप्तिस्मा।”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />तब पावलले ऐलेऊ, “बप्तिस्मा यांन्या यहुन्नाले आयांन्या बप्तिस्मा पापतन पस्चातापल बप्तिस्मा लेऊ। तर ङाछिन्ट रांन्या रु, अथाबा येशुत बिस्वास ढोचिते ऐलेस्यु नकाले रुयाङजन ऐआढोवाङ।”<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="MAT 3:11">मत्ती ३:११</ref>; <ref loc="MRK 1:4">मर्कुस १:४</ref>,<ref loc="MRK 1:7-8">७-८</ref>; <ref loc="LUK 3:4">लूका ३:४</ref>,<ref loc="LUK 3:16">१६</ref>; <ref loc="JHN 1:26-27">यहुन्ना १:२६-२७</ref></char></note><verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />ईका छेन थएस्यु नकाङै प्रभु येशुल मिनत बप्तिस्मा राहोनौ। <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />जब पावलले नकाङयर्त कुई आनाटौ, तब पबित्र आत्मा नकाङयर्त रांऔ, ओटन नकाङ छुटाछुट्टै छेनल छ्योङवाङ ओटन भबिस्यबानी रांढोव। <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />नकाङ छ्योअ बारं गोटा ल्हेपाङ लेवाङ।<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />पावल यहूदी आराधना झिम पसिस्यु तिन मैना समन पावलले परमेस्वरलं राज्यला बारेल नकाङसं साहस सकाए छ्योङस्यु रुयाङजन सभनज्याऔ। <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />तर जब काङ्काङ झ्योङस्यु बिस्वास रांमाढोव, ओटन ईका नङ्गरल परमेस्वरलं यमल बिरोदत बगालयाङ माचान्या छ्योङौ लागिवाङ, तब पावल नकाङल्योङन बाठए ताइवाङ, ओटन सिइयाङजन बोलोङ लाङस्यु टुरान्नसलं पाठशालाल छ्योङौ तअसिऊ। <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />ईका काम नें बर्स समन ताइज्याऔ, ओटन एशियाला प्रदेसलं लिज्यान्या सोगलै चुङन्याङ, यहूदी सनर ग्रीकयाङ नेंलोअलेईज प्रभुल बचन राथटौ।<verse eid="ACT 19:10" /></para>
  <para style="s">स्केवाल सन्तानयाङ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />परमेस्वरले पावलङन बडअचम्मला कामयाङ आढोव। <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />इङ समन कि रूमाल अथाबा खाइटो नकाल कलाङल छुऊपरिङस्यु नाएबोरन्याङ ल्योङ लाङसिरा, ओटन नकाङल रोगयाङ हिन्‌रा ओटन दुस्टआत्माङ बै पलिईस्यु हिन्वाङ। <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />तर काङ्का-काङ्का हुदेएअदेए बारिन्या यहूदी झारफुक ढान्याङै दुस्टआत्मा लागिन्याङजन प्रभु येशुल मिन पानौयन ऐलिज्यावाङ, “पावलले प्रचार आढान्या येशुल मिनङन ङा नङजन बाहेर पलिईन्या आग्या यांसिना।” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />नङ तोलोअ स्केवास मिनला यहूदी प्रधान पुजाउरोल साट वटा ल्हेपाज़ायाङै ऐटाइन्या काम रांढोव।<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />तब दुस्टआत्माले जबाक यांस्यु नकाङजन ऐआढोवाङ, “येशुजन ङा ऐशईङा, ओटन पावलजन बै ङा ऐशईङा, तर जे काङ्काङ?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />ना दुस्टआत्मा लागिस्यु रु नकाङयर्त उफ्रिस्यु रांऔ, ओटन नकाङ सोगलैजन कायम जाएस्यु आपछारवाङ ओटन नका झारफुक ढान्याङजन ना झिमलन क्वा मालन्या सनर घाइत्या ताइस्यु ढोङवाङ। <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />ईका छेन एफिससला सोगल रुयाङ, यहूदी सनर ग्रीकयाङै आका छेन थएस्यु। ओटन नकाङ सोगलैलयर्त छ्याइपरिऊ, ओटन प्रभु येशुल मिनल प्रसम्सा ताहौ। <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />बिस्वास ढान्याङ रुयाङ भ्याई रांवाङ, ओटन नकाङै राढान्या रा:मी रा:मी दुस्ट कामयाङ सुइकार रांढोव ओटन ना सोगलै लेऊक रांठनौ। <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />नकाङ मध्य भ्याईयाङ, जोजोले टुनामुना रांढोव, रांमि-रांमि किटापयाङ सिमस्यु राहोनौ, ओटन सोगलैल लेऊक रांहिपौ। नकाङै नकाल येए जाटौक पचास हजार चान्दील सिक्काल हिसाप लागिऊ। <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />ऐलेस्यु प्रभुल बचन फैलिस्यु हिनौ, ओटन भ्याई प्रभाबशाली ताहौ।<verse eid="ACT 19:20" /></para>
  <para style="s">एफिससलं यिसिई</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />ईका घटनाङ छिन्ट, पबित्र आत्माल प्रेरनाल पावलले माकेडोनियाङन अखैयाला यम ताइस्यु यरुशलेम हिनन्या पक्का आजाटौ। नकाले ऐलेऊ, “नङ तापङापाइनाई ङा रोम हिनौजपरिया” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />नकाल सेवा ढान्याने नेंलोअ, तिमोथी सनर इरास्तसजन नकाले माकेडोनियाल आपरिङौने, तर नका ओलं तचिइ दिन एशिया प्रदेसलै लिज्याऔ।<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />नका बेलादेए परमेस्वरलं यमल बारेल एफिससलं भ्याई छ्याइला होहल्ला ताहौ। <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />दानाङभन्या डेमेत्रियस मिनला तोलोअ चान्दील शिल्पकारले चान्दील आर्तेमिस देबील स्वरुप सनर इङइङन्या मन्दिरयाङ जाएस्यु, कारीगरयाङजन भ्याई काम आयोवाङ, दानाङभन्या ईका धन्दातन भ्याई फाइदा ताहौ। <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />तब इकाङ सनर अपुर ऐटाइन्याई बैपार ढान्याङजन नकाले दुउस्यु ऐआढोवाङ, “भाईयाङ, जेजन थाहै लेया, कि ईका बैपारलन गेजन चान्याई काजकमाई ताहा। <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />जे ऐरङज्याच्या ओटन ऐथएज्याच्या, कि पावलले तबर रुयाङजन झुकाइस्यु अथाबा मच्चाईस्यु आलाङवाङ। तर एफिससलं याएज माङडी छ्योअछ्योअ सोगल एशियाल कुईले जाएसिन्या, दयदेउताङ काङ्काईबै ईस्वर माङडी। <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />नैताइस्यु गेमि बैपारल प्रतिस्ठा मांन्या याएज माङडी तर महान देबी आर्तेमिसलं मन्दिर समेत नस्ट ताहा, ओटन सोगल एशिया सनर सङ्सारले रापुजिन्या देबील गौरबल नैज महत्व माताइदी।”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />ईका थएस्यु नकाङ रारिऊ चिरिऊ ताइवाङ, ओटन “एफिसीयाङलं आर्तेमिस महान ज्या।” आर्तेमिस देउताल ऐलेस्यु चिचच्याहौ तअसिवाङ। <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />सोगल सहरल होहल्ला मच्चिऊ ओटन नकाङ बोलोङ ताइस्यु पावल सकाए बान्या माकेडोनियाल चुङन्या गायस सनर अरिस्तार्खसनेजन कोलोअस्यु चौरभितरल होतऱ्याइस्यु रालाङौनें। <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />पावल रुयाङल हुलल हिनौ आरोकौ, तर सिइयाङै ओलजन हिनौ रांमायोव। <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />एशियाला ख्वाएयाए मुख्या रुयाङ पावलल न्हाए लेवाङ। नकाङै पावलजन चौरभितरल हिनस्यु जोखिम तामुलिई ऐलेस्यु बिन्ति ढास्यु रांपरिङौ। <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />तब नकाङ छुटाछुट्टै छेन छ्योङौयन कलिऊस्यु हल्ला मच्चाईज्यावाङ। दानाङभन्या ना बैठअल गडबद ताइज्याऔ, ओटन भ्याउयाए रुयाङै ता नकाङ दानाङ दुउसिस्यु लेर ओ बै मासनरदी। <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />हुलल ख्वाए रुयाङै अलेक्जेन्डरजन हादेए रा:सराहौ, जोजन यहूदीयाङै जिम्मा होनौ नाल्ट सच्यानस्यु लेवाङ। अलेक्जेन्डरले आकुईले सयान ढास्यु रुयाङजन शान्त लिज्याऔ नाल्ट कोबाअ पानन्या इच्छ्या आढोव। <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />तर नकाङै नका ता यहूदी रैस ऐलेन्या सनस्यु सोगलैले तचोएकै लगभग नेंघन्टा या “एफिसीयाङलं आर्तेमिस मानिसिन्या ज्या।” ऐलेऊयन कलिऊवाङ।<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />सहरला शासकले रुयाङजन शान्त आजाटौ छिन्ट, “ऐ एफिससला रुयाङ, एफिसीयाङलं सहरतन मानिसिन्या आर्तेमिसलं मन्दिर सनर नमतन आतेइन्या नकाल मुर्तिल रछ्यक ज्या ऐलेन्या छेन काङ्काईजन थाह मालेवका? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />जे ऐसनच्या ईका छेन पानौ माढुदुसिन्या लेया, नैताइस्यु जे शान्त ताहौजपरिया ओटन मायिङसिस्यु नैज काम ताढोच्यो। <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />दानाङभन्या जे जेहोनन्या ईका रुयाङै मन्दिर लुटिस्यु मालेरदी ओटन गेमि देबील अपमान बै ढास्यु मालेरदी। <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />नैताइस्यु यदि डेमेत्रियस सनर नका सकाए लेन्या कारीगरयाङल काङ्काईल बिरोदल कोबाअ पानस्यु लेरकन अदालतयाङ खुल्लालिज्याऔज लिज्यारा, ओटन नियादिसयाङ बै लिज्याऔजलिज्यारा, नकाङ तोलोअले तोलोअल बिरोदत मुद्दा ग्यालरिरत्या। <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />तर ईका बाहेक अपुर नैज बारेत छेनौ रोअच्योकन्ता नकाल फैसला सदाई कचहरील ताहा, <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />दानाङभन्या आछिम ईका डोङ्गाल दोस गेयर्त रांन्या छ्याइ लेया। दानाङभन्या ईका बिना कारनल यिसिईखप्सिईल नैज इस्पस्टीकरन गे यांऔ माढुदुइदी।” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />आवाए पानस्यु नकाले कचहरीजन आटुङग्याहौ।<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">पावल माकेडोनिया सनर ग्रीसलं</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />आका खैलाबैला शान्त ताहापाइना पावलले सिइयाङजन तचोएकै खुल्स्यु उत्साह आयोवाङ, ओटन ओलं बिदाई ताइस्यु माकेडोनियादेए हिनौ। <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />नला इलाकाङल हिनस्यु बिस्वासीयाङजन भ्याई उत्साह यांस्यु नका ग्रीस देसलं हिनौ। <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />जोङ तिन मैना चुङस्यु आबिताहौ, सिरियादेए री जाहसलन हिनन्या ठिक्कै आताइज्याऔक, यहूदीयाङै आबिरोदल जाल राढाज्यान्या सनस्यु पावलले माकेडोनिया ताइस्युई वलन्या पक्का आजाटौ। <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />तब बेरियाल चुङन्या पुरसलं ल्हेपाज़ा सोपात्रोस, थेसलोनिकेङन अरिस्तार्खस सनर सिकन्दस, डर्बीला गायस, सनर तिमोथी ओटन एशियाला तुखिकस सनर त्रोफिमस बोलोङ एशिया प्रदेसलं हिन्वाङ। <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />नकाङ हादेए हिनस्यु गेजन त्रोआसल वुइज्यावाङ। <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />तब गे सोडामालन्या भरेईल पर्बल छिन्ट फिलिप्पीलन री जाहसतं चरिस्यु पास दिनक त्रोआसल नकाङल्योङ गेरांयिउ, ओटन नङ साट दिन समन गेलिज्यायिउ।<verse eid="ACT 20:6" /></para>
  <para style="s">पावल आसापट त्रोआसल आहिनन्या</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />हप्ताल पैला दिन जब गे भरेई कलाएन्या गेदुउसियिउ, तब पावलले छिन्काछिम हिनन्या इच्छ्या आढाऔकाले, नकाङसं आधारिउ समन छ्योङज्यावाङ। <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />गे गेदुउसिन्या टङटाल्ला कोठाल नल तबर गोटा बत्तियाङ भलाङज्यावाङ। <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />नल युटिकस मिनला तोलोअ धापा झिमल झरकित चुङज्याऊ। पावलले भ्याई छिन्ङ समन छेन रांछ्योङौक, नका बअजोरला मिऊरुइल परिऊ ओटन मिऊरुइले उङ्गिस्यु ना तिन ताललन वान्ल तेहौ, ओटन नाजन नकाङै सिन्या अबस्थालं रासोचटौ। <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />तब पावल वान्ल लाहौ, ओटन नकाजन गोम लेस्यु हमोअस्यु ऐलेऊ, “ताछ्याएच्यो दानाङभन्या ईका जिङदाइ लिज्याया।”<note caller="-" style="x"><char style="xo" closed="false">20:10 </char><char style="xt" closed="false"><ref loc="1KI 17:21">१राजा १७:२१</ref></char></note> <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />तब नका टङटाल कोठाल हिनौ, ओटन भरेई कलाएस्यु कैरापाइना छकाल्या नम आमारनौ समन तबर छ्योङस्यु चुङवाङ। ओटन भाअसिवाङ। <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />ओटन ओयाङ नका धापाजन जिङदा अबस्थालै झिमल राहोनौ ओटन भ्याई सानत्वना रांडोटौ।<verse eid="ACT 20:12" /></para>
  <para style="s">त्रोआसङन मिलेटस समनका बए</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />गे री जाहसलं चरिस्यु हादेए सरिस्यु अस्सोस गेहिन्यिउ। गे पावलजन नङ जाहसलं चराहौ गेरोअयिउ। पावलले ऐटाइन्या बन्दबस्त ढास्यु नका अस्सोस समन पाइदलज हिनस्यु लेऊ।<verse eid="ACT 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 20:14" />जब नकाले गेजन अस्सोसलं आडोएयिउ, गे नकाजन री जहासलं गेसचुन्यिउ, ओटन मितिलेनेल गेरांयिउ। <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />नङंन री जहासलं राराज्याऔक नेंयोअक खियस टापुल गेतापरायिउ, ओटन नेंयोअ छिम्क सामोस टापुल गेतापरायिउ। नकाल नेंयोअक मिलेटस सहरल गेरांयिउ, <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />एशियाल समाय बिताइन्या यिङ आमालेऊकाले पावल एफिससलं मापसिस्यु हिनन्या निर्नय आढोव। दानाङभन्या सम्भब ताहकन पेन्तिकोसलं दिन यरुशलेमङ तापङा लेस्यु टेकाटेक लिज्याऔ।<verse eid="ACT 20:16" /></para>
  <para style="s">एफिससला सेरयाङजन पावलल बिदाईल प्रचार</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />पावलले मिलेटसजन एफिससलं परिङस्यु मन्डलीला बिस्वासी सेरयाङजन खुलौआपरिङौ। <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />जब नकाङ पावल ल्योङ रांवाङ, नकाले ओयाङजन ऐआढोवाङ, “जे ऐसनच्या जब ङा पैला दिन एशिया प्रदेसलं ङातापराङु, ङा लगातार जे सकाए कैलेस्यु ङालज्याङु। <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />पुराई नम्रता सकाए मिऊकलि राइस्यु-राइस्यु, यहूदीयाङल सड्यन्त्रल सटावटत बै ङा प्रभुल सेवा ङाढोङु। <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />ङा जेमि फाइदा ताइन्या छेन जे लेऊक मुइन्याङन सनर झिम-झिमल सोगलैल लेऊक जेजन सिक्छ्या यांन्यातन ङा खकै छिन्देए माहाएसिदुङा। <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />यहूदीयाङजन ओटन ग्रीकयाङजन पस्चाताप ढास्यु परमेस्वर देए वलन्या सनर गे प्रभु येशु ख्रीस्टजन बिस्वास ढोचिते, ऐलेन्या छेनल साची ङा यांस्युई लेङा।”<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />“आब खिम्चिते, ङा पबित्र आत्माल करपरिस्यु यरुशलेम देए ङाहिनज्याङु, नङ ङाजन कैताइन्या परिरान्या हो ना ङा नैज मासनङदी। <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />ङा इवाएजाई सन्ङा, कि कैदी ताइन्या सनर कस्ट डोएन्या ङायर्त परिराया, ऐलेन्या पबित्र आत्माले ङाजन सोगल पोल चेताउनी यांस्यु ऐलेऊ। <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />तर ङा ङा परानजन नैज मया माढोङदी सनर ङा नैज येएला मालेङदी, आवाए याएज चाहिङा कि ङाजिबनल परमेस्वरलं अनुग्रहङन चान्याथाईल बयन यांऔ नाल्ट प्रभु येशु ङन ङासेवाकाई पुरा ढाऔ ग्याडोटङत्या।”<note caller="-" style="x"><char style="xo" closed="false">20:24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">२तिमोथी ४:७</ref></char></note><verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />“आब खिम्चिते, ङा ऐसन्ङा कि जे तन सोगलै, जो-जोजन ङा परमेस्वरलं राज्यल प्रचार ढाऔयन बाङ, जे फरि ङाजन खकै रङन्या माल्चिदी। <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />नैताइस्यु आछिमका दिन ङा जेजन साची यांच्या, कि ङा काङ्काईल जील दोसी मालेङदी। <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />दानाङभन्या परमेस्वरलं सोगल इच्छ्या जेजन पानस्याऔ नाल्ट ङा खकै छिन्देए माहाएसिदुङा। <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />जे जेनाल्ट सनर जे सोगल बगालजन जोगाइसिस्यु लेच्यो। पबित्र आत्माले जेजन बगालल ग्वाला आजाएचिऊकाले ओले आमिई जीले आलङन्या परमेस्वरलं मन्डलीलं ब्याएबिई ढोचिते।<note caller="-" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="PSA 74:2">भजनसङ्ग्रह ७४:२</ref></char></note> <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />दानाङभन्या ङाजन थाह लेया, कि ङा ङाहिनौ छिन्ट जेल्यौल भ्याई फ्याऊ पसिन्या लेरा, जोले बगालजन बाङ्की मानाएरदी। <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />नका बेला रांन्यालेया जे खार्लन्जै ग्वारवा रुयाङ च्याङन्या लेरा, ओटन बगालजन ग्वारस्यु छ्योङस्यु, नकाङै सिइयाङजन छुट्टै यमदेए लाङन्यालेरा। <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />नैताइस्यु ईका यिङसिस्यु सजक ताइचिते, कि तिन बर्स समन छकाल्या ओईक मिऊकलि बगाइस्यु सोगलै रुजन ङा सिक्छ्या ङाह्युउचिऊ।”<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“ओटन आब ङा जेजन परमेस्वरलं सनर ओलं अनुग्रहल बचनत सुम्पिस्योङा, जोले जेजन सुढारौ ढुदुऊ, सनर पबित्र ताइन्या रुयाङजन उत्तराधिकार यांऔ ढुदुन्यालेया। <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />ङा काङ्काई रुयाङल सुन, चान्दी, या क्वाल लोब ङामाढोङु।<note caller="-" style="x"><char style="xo" closed="false">20:33 </char><char style="xt" closed="false"><ref loc="1SA 12:3">१शमूयल १२:३</ref></char></note> <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />जेजन थाहैलेया कि ईकाइ ङाकुईले ङा न्हाएयाङ सनर ङाजन चाहिन्या आबस्यकताङजन ङा पुरा ढास्यु लेङा। <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />ङा जेजन सोगलै छेनल उदाहरन यांस्युई नाएच्या, कि जे बै ऐलेस्युईज बअ परिस्रम ढास्यु गरिबयाङजन व्एचिर। प्रभु येशुल बचन यांका नाएचिते, कैलेस्यु ओले ओलजै ऐलेऊ, कि ‘होनन्यातन यांन्या अझै बअचान्या हो।’” <verse eid="ACT 20:35" /><verse number="36" style="v" sid="ACT 20:36" />आवाए ऐलेस्यु नकाले घुन्डा आटिकिउ ओटन नकाङ सोगलैस बोलोङ प्रार्थना आढोव। <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />ओयाङ सोगलै व्‌रवाङ, ओटन पावलजन हमोअस्यु रांम्वाहौ। ओटन बिदा रांढोव। <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />नकाङै फरि खकै नकाल हां रङन्या मालरदी ऐलेस्यु पावलले आपानन्या छेनल नकाङै भ्याई दुखी ताइवाङ। ओटन नकाङले ओजन रीजाहसल रासटापौ।<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">पावलल यरुशलेमला बए</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />नकाङसं भाअसिस्यु गे री जहासलं चरिस्यु सोझै कोस टापुल गेरांयिउ, ओटन तयोअका छिम्क रोडसल सनर नङंन पटाराल गेतापरायिउ। <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />ओटन फोनिकेल हिनन्या तोलोअ री जाहस डोएस्यु गे नकालै चरिस्यु गेहिन्यिउ। <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />जब साइप्रस तापु रंनौ, तब ओलं हुदिन्टा दाबऱ्याङा सिरिया इलाकाल ल्योङ हिनस्यु टुरोसलं गेलाइयिउ। दानाङभन्या री जाहसला मालसामान ओलं ल्हाएन्या लेऊ। <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />ओङ सिइयाङस गेडोएसियिउ ओटन नकाङसं गे साट दिन ओलं गेचुङयिउ। पावलजन यरुशलेमल ताहिनन् ऐलेस्यु नकाङै पबित्र आत्माङन ऐराढोव। <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />नङंन गेमि बान्या बेला ताहापाइना गे बिदा ताइस्यु गे यमल गेपलिईयिउ, रांमि जाहान सनर लुलल्याङ समेत नकाङै सहरलन बाहेर समन रानुल्‌रिइयिउ, ओटन गे समुन्दरल वङल घुन्डा टिकिस्यु प्रार्थना गेढोयिउ। <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />तब गे बिदा ताइस्यु री जाहसलं गेचरियिउ, ओटन नकाङ फरि राझिम वल्वाङ।<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />टुरोस ल्योङन समुन्दर-बए ढास्यु गे टोलेमाइसलं गेतापरायिउ। नङ बिस्वासी भाईबैनाङजन अभिबादन ढास्यु नकाङ सकाए तयोअ गेचुङयिउ। <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />छिन्का छिम्क गे भाअसिस्यु कैसरियाल गेरांयिउ, ओटन प्रचारक फिलिपल झिमल गेपसियिउ। नका ओ साट गोटाङ मध्य तोलोअ लेऊ, ओटन गे ओलं झिमल गेपसियिउ। <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />परमेस्वरलं बचन भबिस्यबानी छ्योङन्या नकाल चारगोटा कनन्याङ लेवाङ।<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="JOL 2:28">योएल २:२८</ref></char></note><verse eid="ACT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10" />गे नङ तचिइ दिन गेचुङौक यहूदियालन अगाबस मिनला तोलोअ अगमबक्ता रांऔ। <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />नकाले गेल्योङ रा:स्यु पावलल पिटी हिनस्यु आकुई-आखङ आपोकौ, ओटन ऐलेऊ, “पबित्र आत्माले ऐलेऊ, ‘ईका पिटी जो रुल हो, नकाजन यरुशलेमल यहूदीयाङले ऐलेस्युजै पोअरा ओटन गैरयहूदीयाङल कुईत जिम्मा यांन्या लेरा।’”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />आका छेन थएस्यु, गे सनर नका टुरोसला सोगल रुयाङै पावलजन यरुशलेमल ताहिनन् ऐढास्यु बिन्ति राजुरिऊ। <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />तर पावलले जबाक आयोवाङ, “जे ऐलेस्यु व्‌रस्यु ङायिङजन दानाङ चिइचिइ जाएस्याङच्यो? दानाङभन्या प्रभु येशुल मिनल नाल्ट कैदल परिन्या याएज माङडी, तर यरुशलेमल सिन्या बै ङा तयार लेङा।”<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />नकाजन सभनौ माढुदुस्यु “प्रभुल इच्छ्या पुरा ग्याताइत्या” ऐलेस्यु गे छपक्कै गेदिङयिउ।<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />नङ तचिइछिन्ट गे हिनन्या तयार गेताइयिउ, ओटन गेमि सामानयाङ छेन्स्यु यरुशलेम देए गेलाङयिउ। <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />गेसं ख्वाएयाए सिइयाङ बै कैसरियाला हिन्वाङ, ओटन नकाङै गेजन साइप्रसला तोलोअ पुरानो सिइ मनासोन ऐढासिन्या रुल झिमल राहोनौ, ओटन नका ल्योङ तचिइ दिन गेचुङयिउ।<verse eid="ACT 21:16" /></para>
  <para style="s">पावल याकूब डोएस्यु</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />ओटन जब गे यरुशलेमल गेतापरायिउ, तब भाईयाङै गेजन हेसाङस्युकने स्वागत राढायिउ। <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />छिन्का छिम्क पावल गेसकाए याकूबजन खिमौ नाल्ट हिनौ। नङ सोगलै मन्डलीला बिस्वासी सेरयाङबै दुउसिस्यु लेवाङ। <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />नकाङजन अभिबादन, ढोवरा पाइना पावलले आसेवाकाईङन गैरयहूदीयाङ खार्ल परमेस्वरले आढान्या काम नकाङजन तो-तोलोअङन आपानस्योवाङ। <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />ईका थएरा पाइनाई परमेस्वरलं महिमा रांढोव। तब पावलजन ऐराढोव, “खिम्ते भाई पावल, यहूदीयाङल खार्ल बिस्वास ढान्याङ हजारौ लेरा, ओटन ब्यबस्थाला छेनत नकाङ सोगलै जोशलै लेरा। <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />नकाङै नमी बारेल बै कोबाअ नह्युउन्या छेनयाङ थएस्यु लेरा, ओ नैति ऐलेऊक, गैरयहूदीयाङल खार्ल चुङन्या यहूदीयाङजन नङ ‘मोशाल ब्यबस्थाजन राइन्या सनर नकाङल लुलल्याङजन खटना माढान्या ओटन रीतिथिति पालन माढान्या’ ऐलेस्यु ह्युउस्यु लेना। <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />आब गे कैलेई? नङ रा:स्यु लेना ऐलेस्यु नकाङै निस्सिबै थएस्युई लेरा। <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />नैताइस्यु जो गे पानै, ओइज ढोते बाचा ढान्या गेसकाए चारगोटाङ लेरा। <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />इकाङजन हिनस्यु नङ बै नकाङसं बोलोङ चोखा ताहन्ते, ओटन इकाङजन चाहिन्या खर्च नङ योंवरते, ओटन इकाङै चेम ग्यायनरत्या। ऐलेस्यु नङ मोशाल ब्यबस्था पालन नढान्या रङस्यु न बारेल राथएन्या छेन नैज सत्य माङडी रैस, ऐलेस्यु सोगलैले ग्यासनरत्या।<note caller="-" style="x"><char style="xo" closed="false">21:24 </char><char style="xt" closed="false"><ref loc="NUM 6:5">गन्ती ६:५</ref>; <ref loc="NUM 6:13-18">गन्ती ६:१३-१८</ref>; <ref loc="NUM 6:21">गन्ती ६:२१</ref> </char></note> <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />तर गैरयहूदीयाङ जोले बिस्वास ढास्यु लेर, नकाङ स्वरुपजन बलि चराइसिन्या जन्तु, जी, ढेङ पचिरस्यु सएसिन्या पशुल चिप सनर ब्यबिचारलन अलक्कै लिज्यावपरिया ऐलेस्यु गे निर्नय सनस्यु गे चिठी सरस्यु लेया।”<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />तब पावलले तयोअछिम्क नका रुयाङजन ओलसं आहोन्वाङ, ओटन नकाङजन सनर ओलजन बै चोखा आजाटौ, ओटन चोख्याइसिन्या दिनयाङ खक पुरा ताइन्या हो, या सोगलैल नाल्ट यांसिन्या भिटीलं थाह यांऔ नाल्ट नका मन्दिर भितरलं पसिऊ।<note caller="-" style="x"><char style="xo" closed="false">21:26 </char><char style="xt" closed="false"><ref loc="NUM 6:13-21">गन्ती ६:१३-२१</ref> </char></note><verse eid="ACT 21:26" /></para>
  <para style="s">मन्दिरलं पावल आकोलोसिन्या</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />जब साटौ दिन पुरा ताइङा लिज्याऔ, तब एशिया प्रदेसला यहूदीयाङै पावलजन मन्दिरलं रङस्यु सोगल हुलजन रांछेनौ, ओटन नकाजन राकोलोकौ। <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />नकाङ ऐलेस्यु कलिकौ तअसिवाङ “इस्राएलला रुयाङजन व्एन्या ढोचिरते! रुयाङजन जोङबै गे जाति, मोशाल ब्यबस्था अनुसार ईका पोल बिरोदल सिक्छ्या यांऔयन बान्या रु ईकाइ ज्या। आवाए जा माङडी, इकाले ग्रीकयाङजन बै मन्दिर भितरलं हिनस्यु ईका पबित्र पोजन अशुद्द जाएस्यास्यु लेया।” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />दानाङभन्या इकाल हादेए नकाङै एफिससलं त्रोफिमस ऐढासिन्या तोलोअजन ओलसं सहरल रङसिन्याले नकाईजन पावलले मन्दिर भितर आहोनौ ऐलेस्यु नकाङै रायिङौ।<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />तब सोगलै सहरल हलचल ताहौ, ओटन रुयाङ बोलोङ चोएस्यु रांवाङ। नकाङै पावलजन कोलोअस्यु मन्दिरलन बाहेर लतारस्यु राहोनौ, ओटन ओचोएटै झलापयाङ राऱ्हुपौ।<note caller="-" style="x"><char style="xo" closed="false">21:30 </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरित २०:४</ref> </char></note> <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />जब नकाङै ओलजन सटौ रारोकौ, तब सोगल यरुशलेम खल्बलिस्यु लेया ऐलेन्या छेनल थाई पल्टनला सेनापति ल्योङ ताप्‌रा:औ। <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />ओ ओचोएटै कप्तानयाङै सिपाइयाङजन बोलोङ हिनस्यु नकाङल्योङ ओचोएटै रांवाङ। ओटन जब नकाङै सेनापतिङन रांरङौ तब पावलजन टुपन्या राराहौ।<verse eid="ACT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33" />तब ना सेनापति नेराक रा:स्यु पावलजन आकोलोकौ ओटन नेंलोअ साङ्गलले नकाजन पोअन्या आदेस आयोवाङ। ईका काङ्का ओटन इकाले नैआढोव ऐलेस्यु नकाले आगिन्वाङ। <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />तर ना हुल मध्य काङ्काङै तोलोअ छेन ओटन काङ्काङै छुट्टै छेन छ्योङस्यु कलिऊवाङ, ओटन नकाङल होहल्लाले घटना नैति ना सनौ आमाढुदुऊकाले पावलजन अड्डाल लाङचिते ऐलेस्यु आग्या आयोवाङ। <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />जब पावल थपल्याअलेऔक ताप्‌रा:औ, तब पर्लाकापर्ला सएन्या यिङले सिपाइयाङै ओलजन छेन्स्यु रालाङौ। <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />“दानाङभन्या रुयाङै हुल ‘नकाजन सएचिते’ ऐलेस्यु कलिकौयन छिनछिन लागिस्यु नकाजन सएचिते ऐलेवाङ।”<verse eid="ACT 21:36" /></para>
  <para style="s">पावल जोगाइसिऊ</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />अड्डाल सतापङा रालज्याऔक पावलले सेनापतिजन ऐआढोव, “नैति अनुमति डोटङ्कन, ङा कोबाअ पानङा।” नकाले ऐलेऊ, “नैति नङजन ग्रीक भासा रांऔ? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />नैति नङ नकाई मिस्री माङडी, जोले भाबाअ बिद्रोह मच्चाईस्यु चार हजार हतियारधारी रुयाङजन जङ्गलल नलाङवाङ?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />तर पावलले उत्तर आयोव, “ङा ता किलिकियाला सहर टार्ससला तोलोअ यहूदी रु दी, ङा इङन्या सहरला नागरिक माङडी। बिन्ति लेया, ईका रुयाङस कोबाअ छ्योङौ यांङते।”<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />जब नकाले छ्योङौ आयोव, तब थपल्याअत च्याङस्यु पावलले रुयाङजन कुईले सयान आढोव। रुयाङ मछ्युजै छपक्कै दिङवाङ, नकाले नकाङजन हिब्रू छिन्ङन ऐआढोवाङ,<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“ऐ भाईबैनाङ सनर आमा बौयाङ, ङा छेन थएचिते, जो ङा आब जेहार्मै ऐलेङा।” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />पावल हिब्रू छेनल आछ्योङन्या थएस्यु नकाङ चुप ताइवाङ।<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />नकाले ऐलेऊ, “ङा किलिकिया सहर टार्ससलं जर्मिन्या तोलोअ यहूदी हो, तर ईका यरुशलेमला गमलिएलल सिक्छ्यात ङाघिङु। गे पुर्खाल बिधि अनुसार ङा चान्या सिक्छ्या डोएस्यु लेङा। आछिम जे परमेस्वरतं ज्वाए उत्साहित जेल्चिऊ, ङा बै ओवाएजै उत्साहित लिज्याङा। <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />ङा ईका यमला रुयाङजन सिऊ समनजै ङासताहङवाङ, ओटन ल्हेपा सनर मेएमाङजन पोअस्यु झ्यालखानाल ङाझोकङवाङ। <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />प्रधान पुजाउरो सनर सोगलै महासभाले बै ङा पक्छेल साची योंरा। प्रधान पुजाउरोयाङ तरफङन भाईबैनाङल मिनत कोलोअन्या पुर्जी डोएस्यु ङा नङ लिज्यान्या बिस्वासीयाङजन पोअस्यु यरुशलेमल होनस्यु सजाय यांऔ नाल्ट दमस्कसलं हिनस्यु ङाल्ङु।”<verse eid="ACT 22:5" /></para>
  <para style="s">पावलले आयिङ आफिरिसिन्या बारे आपानन्या</para>
  <para style="r">
    <ref loc="ACT 9:1-19">प्रेरित ९:१-१९</ref>; <ref loc="ACT 26:12-18">२६:१२-१८</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“ङा यमल दमस्कसलेऊलं ङातापरांऔक लगभग लाअक तोलोअ झुकाउन्या नमतन तोलोअ घिन्या ज्योति ङा चारवरङन चम्किऊ, <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />ओटन ङा नामल ङापाइङु, ओटन ङाजन ऐआढाज्याङन्या तोलोअ ग़ा ङा थएङु, ‘औ शाऊल, औ शाऊल, नङ दानाङ ङाजन दुख यांङ?’ <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />ओटन ङा ङागिन्ङु, ‘औ प्रभु, नङ काङ्का?’ ओटन ओले ङाजन ऐआढाङु, ‘नासरतला येशु ङाई ज्या, जोजन नङ दुख नयांज्यानु।’ <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />तब ङासकाए ज्वाए गोटाङ लेवाङ, नकाङै ज्योति ता रांरङौ, तर ङासकाए छ्योङन्याल शब्द ता माथएदुरा।” <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />“ङा ऐङाढोङु, ‘औ प्रभु, आब कै लेङ?’ ओटन प्रभुले ङाजन ऐआढाङु, ‘च्याङनते, दमस्कसलं हिनन्ते, ओटन नङ ढाऔपरिन्या तुकिसिन्या कामयाङ नङजन पानन्या लेसिया।’ <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />नका ज्योतिल चमकले जब ङा नैज रङौ ङामाढुदुङु, तब ङासकाए लिज्यान्याङै ङा कुई कोलोअस्यु डोऱ्याइस्यु ङाजन दमस्कसलं राहोनौ।”<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“नका सहरल हननिया ऐढासिन्या तोलोअ ब्यबस्था अनुसार चलिस्यु लेन्या तोलोअ भक्त रु जोले नल चुङन्या सोगलै यहूदीयाङ ल्योङन मान डोएस्यु लेऊ, <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />नका ङाल्योङ रांऔ, ओटन ङा नेराक च्याङस्यु ङाजन ऐआढाङु, ‘भाई शाऊल, कि नङ रङौ ग्याढुदुनत्या।’ ओटन ङा नवाए बेला नजर ङाडोएङु, ओटन नकाजन ङारङ्ङु।”<verse eid="ACT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14" />“ओटन नकाले ऐलेऊ, ‘गे पुर्खाङल परमेस्वरलं इच्छ्याजन सनन्या, सनर ना धार्मिक ल्हेपाजन रङन्या, ओटन ओलं याह्‌लन छेन थटौ नाल्ट नङजन छेल्स्यु नाटन्वा। <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />दानाङभन्या सोगलै रुयाङल लेऊक ओलं नाल्ट नङ जो नरङन्या सनर थएस्यु नल्‌नु, नङ नकाल साची लेना। <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />ओटन आब दानाङ वुइज्याङ? च्याङनते, ओटन बप्तिस्मा होन्ते, ओटन येशुल मिन पुकारस्यु नपाप चेईते।’”<note caller="-" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="JOL 2:32">योएल २:३२</ref> </char></note><verse eid="ACT 22:16" /></para>
  <para style="s">गैरयहूदीयाङजन प्रचार यांऔ नाल्ट पावलजन अनुरोद</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“जब ङा फरि यरुशलेमल वलस्यु ङारांङु मन्दिरलं प्रार्थना ङाढाज्याङु ना बेला दर्शन ङारङ्ङु। <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />परमेस्वरले ङाजन ऐआढाज्यान्या ङा ङारङ्ङु, ‘छिटो ढास्यु यरुशलेमलन पलिहन्ते, दानाङभन्या ङा बारेल नङ नयांन्या बयन नकाङै ग्रहन ढान्या मालरदी।’”<verse eid="ACT 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19" />“ङा ऐङाल्ङु, ‘औ प्रभु, ङा सोगल आराधना झिमल हिनस्यु नयर्त बिस्वास ढान्याङजन झ्यालखानाल झोअन्याङ सनर टुपन्याङ इकाङ सोगलैजन थाह ऐलेया।’ <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />नमी साची स्तिफनसल जी आबगिउक ङा ङाईज बै नेराकै च्याङस्यु नकाजन सएन्याल सहमत ताइस्यु, नकाजन सएन्याङै क्वा वाइस्यु ङाचुङज्याङु। <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />तब प्रभुले ङाजन ऐआढाङु, ‘हिनन्ते, दानाङभन्या ङा नङजन गैरयहूदीयाङ ल्योङ लोए-लोए समन परिङना।’”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />नकाङै पावलल छेन इङ समन याएज राथटौ, ओटन ऐलेऊयन नकाङ घिन्या ग़ाले चिचच्याहौ तअसिवाङ, “ऐटाइन्या रु पिरथ्बीलन लोए ग्याताइत्या। दानाङभन्या ईका बान्चिन्या लायकला माल्दी।” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />नकाङ रां क्वा चिटौयन ओटन धुलो ओडाहौयन कलिकौ तअसिवाङ। <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />रोमला सेनापतिले आदेस आयोवाङ, “नाजन अड्डा भितरलं लाङचिते, ओटन कोर्ला लगाइस्यु खारनिखार जाएचिते, कि ङाजन थाह ग्याताइत्या दानाङ नकाल बिरोद ढास्यु ऐलेस्यु कलिऊज्यार।” <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />ओटन जब नकाङै पावलजन छालाल छिङले रांपोकौ, तब पावलले नेराकै च्याङज्यान्या कप्तानजन आगिनौ, “नैति रोमी नागरिक सनर दोसी माठहरिन्या रुजन कोर्ला लगाइन्या नियासका लेऊ?”<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />कप्तानले ईका थएवापाइनाई सेनापति ल्योङ रा:स्यु ऐलेऊ, “नङ नैति ढाऔ नआन्तिज्यानु? दानाङभन्या ईका रु ता रोमी नागरिकदी रैस।” <verse eid="ACT 22:26" /><verse number="27" style="v" sid="ACT 22:27" />तब सेनापतिले रा:स्यु पावलजन आगिनौ, “ङाजन पान्ते, नैति नङ रोमी नागरिक रों?” नकाजन ऐआढोव, “औ ओज्या।” <verse eid="ACT 22:27" /><verse number="28" style="v" sid="ACT 22:28" />सेनापतिले जबाक आयोव, “ङा ता ईका नागरिक ताइन्या हक भ्याई रुप्या फोअस्यु ङालङ्ङु हो।” पावलले ऐलेऊ, “तर ङा ता ङाजर्मिऊकन्ज रोमी ज्या।” <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />तर नकाजन जान्चिन्या ठिक्कै ताइन्याङ सोगलै ओचोएटै हतिस्यु हिन्वाङ, ओटन पावल तोलोअ रोमी नागरिक रैस ऐलेस्यु सनस्यु सेनापति बै छ्याटौ, दानाङभन्या नकाले ओजन साङ्गलले पोअस्यु लेऊ।<verse eid="ACT 22:29" /></para>
  <para style="s">पावल महासभालं लेऊक</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />तर छिन्का छिम्क यहूदीयाङै पावलजन नैति खास नै कारनले दोस लगाइस्यु लेवाङ, ना बुजिन्या इच्छ्याले नकाजन आपलाकौ, ओटन सोगलै मुख्या पुजाउरोयाङ सनर महासभाजन दुउसिन्या आग्या आयोव, ओटन पावलजन वान्ल हिनस्यु नकाङल लेऊक आसच्यानौ।<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />पावलले महासभादेए एखौऱ्या आखिमौ, ओटन ऐलेऊ, “भाईयाङ, आछिमका दिन समन परमेस्वरलं नजरत ङा चोखा बिबेकले जिबन कटाइस्यु लेङा।” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />ईका छेनल प्रधान पुजाउरो हननियाले नकाल लेऊक च्याङन्याङजन हाल टुपन्या आग्या आयोवाङ। <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />तब पावलले नकाजन ऐआढोव, “औ ऱ्हाए सेप्सिन्या भिठाअस! नङजन बै परमेस्वरले राइस्यान्वा ब्यबस्था अनुसार ङा निया ढान्या चुङस्यु नैति ब्यबस्थालं उलत्या ङाजन टुपन्या आग्या नयोनु?” <note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="LEV 19:15">लेवी १९:१५</ref>; <ref loc="EZK 13:10-15">इजकिएल १३:१०-१५</ref> </char></note><verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />ओटन पावलल आनावङल च्याङज्यान्याङै ऐलेवाङ, “नैति नङ परमेस्वरलं प्रधान पुजाउरोल अपमान ढोना?” <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />तब पावलले ऐलेऊ, “इस्राएल भाईयाङ, ओ प्रधान पुजाउरो लेया ऐलेन्या ङा मासहङदी। दानाङभन्या पबित्र शास्त्रल सरसिस्यु लेया, ‘नङ नमी जनताल शासकलं नाल्ट माचान्या ताछ्योङन।’”<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 22:28">प्रस्थान २२:२८</ref></char></note><verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />तर महासभालं तबगाल सदुकीयाङ सनर छुट्टै बगाल फरिसीयाङ रैस ऐलेन्या सनस्यु पावलले घिन्या ग़ा ले ऐलेऊ, “इस्राएली भाईयाङ, ङा ता फरिसीयाङलं ल्हेपाज़ा ज्या। सिन्याङल आस सनर पुनरुत्थानल कारन ङामि मुद्दा चलिज्याऔ।”<note caller="-" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="ACT 26:5">प्रेरित २६:५</ref>; <ref loc="PHP 3:5">फिलिप्पी ३:५</ref> </char></note><verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />नकाले ऐढोवरा पाइनाई फरिसीयाङ सनर सदुकीयाङल यिसीइ ताहौ तअसिऊ, ओटन बैठअल रांछेन मामिलिस्यु भाअसिवाङ। <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />दानाङभन्या सदुकीयाङ ऐलेरा कि रुयाङल पुनरुत्थान, स्वर्गदुत, आत्मा ऐढासिन्या नैज बै माल्दी। तर फरिसीयाङ ना सोगलै मानिरा।<note caller="-" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">मत्ती २२:२३</ref>; <ref loc="MRK 12:18">मर्कुस १२:१८</ref>; <ref loc="LUK 20:27">लूका २०:२७</ref></char></note> <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />नङ घिन्या होहल्ला मच्चिऊ, ओटन फरिसी दलला काङ्का शास्त्रीयाङ च्याङस्यु ऐलेस्यु गनज्याइस्यु लागिवाङ, “ईका रुल गे नैज माचान्या माडोटैदी। यदि आत्मा या स्वर्गदुतले इकाजन ऐआढान्या ताहकन कै वन?”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />नङं घिन्या यिसीइ आताहौ छिन्ट नकाङल कुईलन पावलजन लक्कनझिक्क जाएरा ऐलेन्या छ्याइले सेनापतिले सिपाइयाङजन वान्ल हिनस्यु नकाजन नकाङल खार्लन जबरजस्तिसकाए हिनस्यु अड्डा भितरलं लाङचिते ऐलेस्यु आग्या आयोवाङ।<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />छिन्का छिम्क रिउ प्रभुले नकाल लेऊक च्याङस्यु ऐआढोव, “साहस ढोते, पावल, दानाङभन्या जोमनलेस्यु नङ यरुशलेमल ङा बिसयलं बयन नयोनु, नैलेस्युजै नङ रोमल बै बयन यांऔपरिया।”<verse eid="ACT 23:11" /></para>
  <para style="s">पावलजन सएन्या सड्यन्त्र</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />छकाल्या आताहौ छिन्ट यहूदीयाङै रारांल अपङ्गी पोअसिस्यु पावलजन मासटौ समन नैज माज्यान्या ओटन माओन्या बाचा रांढोव। <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />ईका सड्यन्त्र ढान्या रुयाङ चालिसतन बै भ्याई रुयाङ लेवाङ। <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />इकाङै मुख्या पुजाउरोयाङ सनर मुख्याङ ल्योङ हिनस्यु ऐलेवाङ, “पावलजन गेमासटौ समन गे नैज माज्यान्या ऐलेस्यु पक्का बाचा ज्यास्यु लेया। <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />नैताइस्यु जे सनर महासभा मिलिस्यु सेनापतिङन कर लाइचिते, ओटन नकाल मुद्दाल खअ अझ चान्या सकाए ढान्याताहा ऐलेन्या बाहाना जाएस्यु नकाजन पलिइचिते। ओटन नका इल आरांऔ चोएटै नकाजन सएन्या ठिक्कै ताइज्याया।”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />आब पावलल आदिदील ज़ा आभान्जले ईका सड्यन्त्र सनस्यु अड्डा भितर हिनस्यु पावलजन आसथटौ। <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />तब पावलले कप्तानयाङ मध्य तोलोअजन खुल्स्यु ऐआढोव, “ईका धापाजन सेनापति ल्योङ लाङते, दानाङभन्या इकाल ओसकाए कोबाअ छेन पानन्या लेया।” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />नैताइस्यु नकाले नाजन हिनस्यु सेनापति ल्योङ सतापस्यु बिन्ति आढोव, “बन्दी पावलले ङाजन खुल्स्यु ईका धापाजन न ल्योङ लाङ ऐढास्यु नाटङवा, नङजन कोबाअ छेन पानन्या लेया, तो।”<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />सेनापतिले नकाल कुई कोलोअस्यु तपोईदेए लाङस्यु काङ्काई मालन्या पोल आगिनौ, “नङ ङाजन नैति छेन पानस्याङा नढाङनु?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />नकाले ऐआढोव, “यहूदीयाङै पावलल बिसयलं अझै चान्यासकाए गिनौ जाएसिस्यु छिन्का छिम्क नकाजन महासभालं होनस्यासिन्ते ऐलेस्यु नङसं अनुरोद ढान्या सल्ला ढास्यु लेरा। <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />तर नङ नकाङल छेन तामानि, दानाङभन्या नकाङ मध्य चालिसतन बै भ्याई रुयाङै नकाजन रामासटौ समन नैज माज्यान्या किऱ्या ज्यास्यु नकाजन सएन्याल नाल्ट वुइस्यु चुङज्यारा, ओटन आब नकाङ नमी बचनल आस ढास्यु तयार ताइस्यु लेरा।”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />नैताइस्यु सेनापतिले ना धापाजन ऐढास्यु आग्या यांस्यु आपरिङौ, “नङ ङाजन ईका छेनल थाई नयांन्या काङ्काईजन तापान।”<verse eid="ACT 23:22" /></para>
  <para style="s">पावल कैसरियाल आपरिङसिन्या</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />नकाल छिन्ट पावलले कप्तानयाङ मध्य नेंलोअनेंजन खुल्स्यु ऐआढोव, “आछिमका रिउ नौ बजेदेए नेसय सिपाइयाङ, सहत्तर घोराचरिन्याङ सनर नेसय भालाबर्छा वालाङजन कैसरिया समन हिनन्या ठिक्कै जाएस्यु नाएचिन्ते। <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />ओटन पावलल नाल्ट बै घोराल बन्दबस्त ढोचिन्ते, ओटन नकाजन जोगाइस्यु हाकिम फेलिक्स ल्योङ सतापचिन्ते।” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />नकाले ईका किसिमला चिठी बै आसरौ, <verse eid="ACT 23:25" /><verse number="26" style="v" sid="ACT 23:26" />“मानिसिन्या हाकिम फेलिक्सजन, क्लौडियस लुसियसलं अभिबादन! <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />ईका रुजन यहूदीयाङै कोलोअस्यु सएङा लिज्यावाङ, तर ईका रोमी नागरिक रैस ऐलेन्या ङा सनस्यु फौजसकाए ओङ ताप्स्यु नकाजन ङाछुटाइङु। <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />नैति कारनले नकाङै इकाजन दोस रांलाहौ रैस, ऐलेस्यु सनन्या इच्छ्याले ङा नकाजन नकाङल महासभालं ङाहोन्ङु। <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />नकाङै ब्यबस्थाला गिन्सिइलबारे इकाजन दोस रांलाहौ रैस। तर सएन्या सजाय अथाबा कैदी जाटौपरिन्या डवलला नैज दोस ङा ङामाडोएङु। <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />ईका रुल बिरोदल सड्यन्त्र ताइज्याऔ ऐलेन्या छेनल थाई ङाजन यांसिऊ, ओटन इकाजन ओचोएटै नलेऊक ङापरिङ्ङु, ओटन इकाल बिरोदल दोस लाइन्याङजन बै नलेऊक साची योंचिते ऐलेस्यु आदेस यांस्यु लेङा।”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />ओल्योङन आग्या आडोएन्या अनुसार सिपाइयाङै पावलजन रिउलै एन्टिपाट्रिसलं रासटापौ। <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />घोराचरिन्याङजन नका सकाए नङै बनाएस्यु छिन्का छिम्क नकाङ अड्डा वल्वाङ। <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />कैसरियाल तापराया पाइनाई नकाङै शासकजन थाई बुजाइस्यु पावलजन बै नकाल लेऊक रालाङौ। <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />फिलेक्सले चिठी परिया पाइना नका काङ्का प्रदेसला ऐलेस्यु आगिनौ। नका किलिकियाला ऐलेन्या सनस्यु नकाले ऐआढोव, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />“नङजन दोस लाइन्याङ रांरकन नमी मुद्दा थएन्या लेङा।” ओटन नकाले पावलजन हेरोदले आजाएन्या दरबारल नाएचिते ऐढास्यु हुकुम आयोवाङ।<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">पावल बिरोदत पेसी</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />पास दिनछिन्ट प्रधान पुजाउरो हननिया सनर ख्वाएयाए मुख्याङ, तर्तुल्लस मिनला तोलोअ वकिल सकाए कैसरियाल रांवाङ, ओटन नकाङै पावलल बिरोदत फेलिक्सलं हाक मुद्दा दर्ता रांढोव। <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />पावलजन नलन पलिइरा पाइना तर्तुल्लसले नकाजन ऐलेस्यु आरोप लाहौ तअसिऊ, “बअ मानिसिन्या फेलिक्स, नल्योङन गे घिन्या शान्ति भोग ढाज्याया, ओटन नङ ईका देसला जातिल नाल्ट सुढार सुरु ढास्युलेना। <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />ईका छेन जोमनलेस्यु सोगलै पोल सोगलै समायत गे किरतग्यतासं सुइकार ढोया। <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />तर नङसं गे भ्या समाय माहोनैदी गेमि तुनन्या बिन्ति थएते।” <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />“दानाङभन्या गे ईका रुजन, सोगलैदेए दुख यांस्यु बारिन्या, सङ्सारभरिला सोगल यहूदीयाङल खार्ल आन्दोलन मच्चाईन्या, सनर नासरी पत्तिला मुख्या अगवाजन डोएस्युई लेया। <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />इकाले मन्दिर अपबित्र जाटौ बै आरोकौ हो, तर गे इकाजन कोलोअदुया। गे ब्यबस्था अनुसार कारबाइ ढान्या गेलेयिउ, <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />तर सेनापति लुसियसले गेल्योङ रा:स्यु, भ्याई जबरजस्तिसकाए नकाजन गेल्योङन न्हानस्यु आलाङौ। <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />आब नङजै इकाजन गिनन्‌कन इकाजन गे लाइन्या दोस सोगलै छेन नका ल्योङन ऐसन्ना।” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />ईका यहूदीयाङ बै ना छेनयाङ सोगलैले मछ्यु ज्या, ऐलेस्यु सहमति ताइवाङ।<verse eid="ACT 24:9" /></para>
  <para style="s">फेलिक्सलं लेऊक पावलले जबाक आयांन्या</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />शासकले पावलजन छ्योङन्ते लेस्यु सयान आढाऔ छिन्ट ओले जबाक आयोव, “तबर बर्सकन नङ यहूदी जातिला नियादिस नताइज्यान्या छेन ङासनौकाले ङा हेसाङसै छ्योङ्ङा। <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />नङ सनस्युई लेना, कि ङा यरुशलेमल आराधना ङाढानान्या बारं दिनतन भ्या ताइस्युमाल्दी। <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />इकाङै ङाजन न त काङ्का रुयाङस ङाछ्योङज्यान्या राडोएङु, न त मन्दिरलं या यहूदीयाङल आराधना झिमल अथाबा सहरल जनताङजन ङा मच्चाईज्यान्या राडोएङु, <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />न त इकाङै ङाजन आकअ रालाइज्यान्या दोसलं प्रमान यांऔ ढुदुर। <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />तर ङा ईका नलेऊक सुइकार ऐढोङा, कि जो यमजन नकाङ पाटी ऐढोर, नकाई अनुसार मोशाल ब्यबस्थालं लेन्या छेन सनर अगमबक्ताल किटापल सरसिज्यान्या सोगलै छेन बिस्वास ढास्यु ङा पुर्खाङल परमेस्वरलं आराधना ढोङा। <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />धर्मि सनर पापी नेंलोअनेंलै सिन्यातन पुनरुत्थान ताहा ऐलेन्या इकाङ रांईज सुइकार राढाऔमन ङा बै परमेस्वरतं आस नाएङा।<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 12:2">दानियल १२:२</ref> </char></note> <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />नैताइस्यु ङा परमेस्वर लेऊदेए सनर रुयाङ लेऊदेए सदाई चोखा यिङ नाएन्या कोशिस ढोङा।<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />“ङा तबर बर्स छिन्ट ङा जातियाङल नाल्ट दान यांन्या सनर बलिल भिटी चराइन्या यरुशलेमल रा:स्यु ङाल्ङु। <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />इकाङै ङाजन मन्दिरलं रांडोटौक, ङा चोखा ताइन्या बिधि पुरा ढास्यु ङालेङु। ओङ नैज हुल मालेऊ, होहल्ला बै मालेऊ। <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />तर नङ एशियाला काङ्का यहूदीयाङ लेवाङ, नकाङ इल नलेऊक रांऔ परिन्या हो। यदि ङा बिरोदत कोबाअ पानन्या छेन लेकन नकाङै दोस लाहौ ऐढुदुरा। <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />अथाबा नका रुयाङै ईका महासभालं लेऊक रांईज ग्यापानरत्या, ङामि कोबाअ बिराऊ रांडोटौ का? <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />जम्मा ईकाइ तोलोअ छेन याएज ज्या, जो ङा नकाङल खार्ल च्याङस्यु कलिऊस्यु पानस्यु ङालेङु, ‘सिन्याङल पुनरुत्थानल बिस्वासलं बारेल आछिम जे लेऊक ङामि मुद्दा चलिज्याया।’”<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रेरित २३:६</ref> </char></note><verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />ईका सत्य यमल बारेल फेलिक्सजन चान्यासै थाह लेऊ, नैताइस्यु नाले आका छेन थएस्यु नकाङजन ऐढास्यु आपरिङवाङ, “सेनापति लुसियसं इल रायापाइना ङा जे मुद्दा फैसला ढास्याच्या।” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />तब पावलजन पहरा यांस्यु नाएच्यो ओटन नकाजन तचिइ छुट योंच्यो, ओटन नकाल आन्हाएयाङ आसेवा ढाऔ रोअरकन तारुखिचिर ऐलेस्यु कप्तानले आग्या आयोवाङ।<verse eid="ACT 24:23" /></para>
  <para style="s">पावल फेलिक्स सनर दुरसिल्लालं हाक</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />तचिइ दिनछिन्ट फेलिक्सले यहूदी आमेएमा द्रूसिल्लाजन ओलसं हिनस्यु रांऔ, ओटन नकाले पावलजन खुल्स्यु येशु ख्रीस्टलयर्ता बिस्वासलं बारेत नकाङन आठटौ। <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />पावलले धार्मिकता, सङयम सनर रांन्या नियाल बारेल आछ्योङौक फेलिक्स छ्याटौ ओटन ऐआढोव, “आकअ हिनन्ते, मौका आपरिउ बेलाक ङा नङजन खुल्ना।” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />पावल ल्योङन ऐयाङ रुप्या डोएसिऊ सन् ऐलेस्यु, नकाले आस बै आढोव। नैताइस्यु बै फिलेक्सले नकाजन बेलाबेलाक खुल्स्यु छ्योङन्या आढोव।<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />तर नें बर्स छिन्ट जब फेलिक्सलं पालोल पर्किअस फेस्तस रांऔ, तब फेलिक्सले यहूदीयाङजन खुशी जाटौ नाल्ट पावलजन झ्यालखानालै बनाएस्यु हिनौ।<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">सम्राटल लेऊक पावलल बिन्ति</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />फेस्तस प्रदेसलं आरांन्या तिनदिनछिन्ट कैसरियालन यरुशलेम हिनौ। <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />मुख्या पुजाउरोयाङ सनर यहूदीयाङल मुख्या रुयाङै पावलल बिरोदत आरोप लाइस्यु नकाङै फेस्तसजन बिन्ति रांढोव। <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />ओटन नकाजन यमलै सएन्या जाल रचिस्यु पावलजन दया ढास्यु यरुशलेमल होनस्यासिन लेस्यु बिन्ति रांढोव। <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />तर फेस्तसले पावलजन कैसरियाला कैदल नाएसिन्या, सनर ओलज बै छिटो हिनन्या इच्छ्या आलन्या छेन आपानौ। <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />फेस्तसले ऐलेऊ, “नैताइस्यु ङा सकाए जे भितरला नेताङ ओङ कैसरियाल ग्याहिनरत्या, ओटन ना रु सकाए कोबाअ माचान्या लेकन नाजन दोस लाइचिते।” <verse eid="ACT 25:5" /><verse number="6" style="v" sid="ACT 25:6" />नकाङल ल्यौल आट-दस दिनतन भ्या माचुङस्यु कैसरिया वलौ, ओटन फेस्तस छिन्काछिम निया ढान्यापोत चुङस्यु नकाले पावलजन होनन्या आदेस आयोवाङ। <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />पावल रायापाइना यरुशलेमङन रांन्या यहूदीयाङ नकाल चारवर च्याङवाङ, ओटन पावलल बिरोदत लेन्यामालन्या घिन्या आरोप रांलाहौ, फरि बै नकाङै प्रमान यांऔ माढुदुरा। <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />पावलले आपक्छ्याल छ्योङस्यु ऐलेऊ, “ङा यहूदीयाङल ब्यबस्थालं बिरोदत, सनर मन्दिरलं बिरोदत, ओटन कैसरलं बिरोदत नैज अपराद ढास्यु मालेङदी।”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />तर फेस्तसले यहूदीयाङजन खुशी जाटौ नाल्ट पावलजन ऐआढोव, “नैति नङ यरुशलेमल हिनस्यु ओङ ङाहार्मै ईका छेनयाङ बारेल निया ग्याताइत्या ऐलेन्या इच्छ्या नढोनु?”<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />तर पावलले ऐलेऊ, “ङा कैसरलं निया ढान्या पोल लेऊक च्याङज्याङा, जोङ ङामि निया ताहौपर्च। यहूदीयाङै बिरोदत नैज अपराद ढास्यु मालेङदी, जो नलेऊक चान्यासै जाहेर लेया। <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />यदि ङा अपरादि ताहङकन सनर ज्याहानमारा सजाय डोएन्या लायकला काम ढास्यु लेङ्कन सनर ङा ब्यबस्थालं नियाम मामानिङ्कन, ङा सिन्या अहअ मालेङदी। तर यदि इकाङै ङाजन रांलाइन्या दोसलं नैज सत्य प्रमान मालेकन ङाजन इकाङल कुईत काङ्काईले सुम्पिऊ माढुदुऊदी। ङा कैसर ल्योङ निबेदन परीङा।”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />तब फेस्तसले सल्लाकारयाङस छ्योङस्यु ऐलेऊ, “नङ कैसर ल्योङ निबेदन ढोनकन, नङ कैसर ल्योङै हिन्ना।”<verse eid="ACT 25:12" /></para>
  <para style="s">अग्रिपास सनर बरनिकील हाक पावल</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />तचिइदिन बितियापाइना फेस्तसजन अभिबादन, ढाऔ नाल्ट रय अग्रिपास सनर बरनिकी कैसरियाल ताप्‌राऔने। <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />नकाने नङ तबर दिन नेंचुङौछिन्ट फेस्तसले रयल लेऊक पावलल मुद्दाल बारेल निबेदन आयोव, “फेलिक्सले आनाएन्या तोलोअ कैदी इल लिज्याया, <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />पावलल बारेल, ङा यरुशलेमल ङालिज्याऊक, मुख्या पुजाउरोयाङ सनर यहूदीयाङल मुख्याङै नकाल बिरोदल दोस लाइस्यु नकाजन सजाय यांऔजै परिया लेस्यु अनुरोद ढास्यु लेया।”<verse eid="ACT 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 25:16" />“तर ङा नकाङजन ऐङाढोङवाङ, कि रोमीयाङल ईका चलन माल्दी, काङ्काई रुजन सजायल नाल्ट सुम्पिचिरते, जब समन आरोप लाइस्युनीन्या रु ओलजन दोस लाइन्या वाला आ सामन्डी च्याङस्यु दोसलं जबाक यांन्या मौका माडोटौ। <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />जब नकाङ दुउसिस्यु रांवाङ, ङा ढिलो माढोस्यु छिन्का छिम्क निया ढान्या पोत चुङस्यु नकाजन होनन्या आदेस ङायोङवाङ। <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />जब नकाल आरोपितयाङ च्याङवाङ ङा ङायिङौमन्ज नकाल मुद्दाल नैज माचान्या छेनयाङल आरोप नकाङै लगाहौ रांमाढुदुऊ। <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />तर नकाङल यिसीइकने नकाङलै धर्मल बारेल सनर सिस्युहिनन्या येशुल बारेल रैस, जोजन पावलले कने अझै जिङदा लिज्याया ऐलेस्यु दाबि आढोव। <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />ओटन ईका छेनल निर्नय ढान्या बारेल ङा अक्कमक्क ङाताहौकाले ईका बारेल छलफल ढाऔ नाल्ट यरुशलेमल हिनन्या नकाल इच्छ्या लेऊ सन् ऐलेस्यु नकाजन ङा ङागिन्ङु। <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />तर जब पावलले सम्राटल फैसला आमाताहौ समन हिरासतलै नाएच्यो ऐलेस्यु निबेदन आयांऔकाले नकाजन कैसर ल्योङ मापरिङौ समन वुइन्याल्योङ नाएन्या हुकुम आयोव।”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />तब अग्रिपासले फेस्तसजन ऐआढोव, “ङा ईका रुल छेन ङा ङाईज थटौ डोटङ्कन ताइन्या।” ओटन नकाले ऐलेऊ, “घालाअ नङ थए।”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />छिन्का छिम्क अग्रिपास सनर बरनिकी स्वाई हेसाङस्यु सेनापतियाङ सनर सहरला मुख्या रुयाङस बोलोङ आराधना झिमल पसिऊने। ओटन फेस्तसलं हुकुम डोएस्यु पावलजन राहोनौ। <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />फेस्तसले ऐआढोव, “रय अग्रिपास सनर घेनसकाए इल लेन्याङ सोगलै रांन्या सज्जनयाङ, जे ईका रुजन ऐरङच्या, जोल बारेल सोगल यहूदीयाङै ‘ईका रु आबकन बान्चिन्या लायकला माल्दी’ ऐलेस्यु यरुशलेमल सनर इल बै ङासकाए बिन्ति रांढोव। <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />तर ज्याहानमारा सजाय डोएन्या नैज अपराद आढान्या ङामाडोटौकाले सनर ईका ओलजै सम्राटजन निबेदन आयांऔकाले ङा इकाजन परिङन्या निर्नय ङाढोङु। <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />इकाल बारेल ङा ङामि सम्राटजन सरन्या खास छेन नैज माल्दी। नैताइस्यु ङा इकाजन जे हार्मै सनर खास त, ऐ रय अग्रिपास, इकाजन नलेऊक हिनस्यु लेङा, ओटन गे इकाल छानबिन ढोयापाइना ङा कोबाअ सरन्या छेन ङाडोएङु सन्। <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />दानाङभन्या कैदील बिरोदत कोबाअ दोस मापानस्यु नकाजन परिङन्या ङाजन चान्या मालागिदा।”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">पावल अग्रिपासल लेऊक पावल</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />अग्रिपासले पावलजन ऐआढोव, “नङ नपक्छ्यल छ्योङन्या अनुमति ऐलेया।” तब आकुई छेन्स्यु पावलले ओलं बचिऊ नाल्ट छ्योङौ तअसिऊ<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“खिम्ते रय अग्रिपास, यहूदीयाङै ङाजन रांलाइन्या सोगलै दोसलं बारेल आछिम नलेऊक बचिऊ नाल्ट छ्योङौ ङाडोएन्यात ङा ङाईझन्ज भागिइवाला यिङ्ङा। <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />यहूदीयाङल सोगलै चलन सनर रांछ्योङन्या छेनल नङ खासतं नशईसिऊकाले, ङा चर्चा धैर्यतासं थएते ऐलेस्यु ङा बिन्ति ढोङा।”<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“ङा जातिल खार्ल सनर ङा देस यरुशलेमल सुरुकन बितिस्यु रांन्या ङा धापा बेलाकन्ज ङा जिबन तरिका यहूदीयाङजन थाह ऐलेया। <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />ल्होन्या समायकन ईका छेन नकाङजन थाह ऐलेया, कि गेमि धर्मल सोगलैतन कट्टर पन्थी दल भितरलं ङा तोलोअ फरिसी ताइस्यु ङा जिबन बिताइस्यु लेङा। नकाङै चाहिरकन ईका छेनल बयन यांऔ ढुदुरा।<note caller="-" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="ACT 26:5">प्रेरित २६:५</ref>; <ref loc="PHP 3:5">फिलिप्पी ३:५</ref> </char></note> <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />परमेस्वरले गे पुर्खाङजन आढान्या बाचाल ङा आस ङानाटौकाले आछिम ङा ईका मुद्दाल च्याङस्यु लेङा। <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />गेमि बारं कुल गे रुयाङै आका आस डोटौ नाल्ट लाअरिऊ तयिङले परमेस्वरलं आराधना ढोरा, ओटन ईकाइ आसलं नाल्ट, ऐ रय, यहूदीयाङै ङाजन दोस लाइस्यु नाएरा। <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />परमेस्वरले सिन्याजन जिङदा जाएवा ऐलेन्या छेनत दानाङ जे काङ्काईले बिस्वास ढान्या निर्नय माढोच्यो?”<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />“ङा बै ङायिङ्ङु कि नासरत येशुल मिनता बिरोदत घिन्या कारबाइ ढान्याई ताहा, ऐलेन्या ङा ङाझन्ज बै बिस्वास लेऊ। <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />ङा यरुशलेमल बै ऐज ङालेङु, ओटन मुख्या पुजाउरोयाङ ल्योङन अढिकार डोएस्यु भ्याई परमेस्वरलं रुयाङजन ङा झ्यालखानाल ङाझोअन्या याएज माङडी, तर नकाङजन सटौक नकाङलै बिरोदल ङा सहमति बै लेऊ।<note caller="-" style="x"><char style="xo" closed="false">26:10 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरित ८:३</ref>; <ref loc="ACT 22:4-5">२२:४-५</ref> </char></note> <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />ओटन सोगलै आराधना झिमयाङल नकाङजन पालै पाला सजाय यांस्युकने नकाङजन बिस्वास राहौपरिङन्या जोर ङाढोङु। नकाङल बिरोदल भ्याईज यिङचोस्यु सहर बाहेरल बै ङा नकाङजन हलाअ ङाजाटौवाङ।”<verse eid="ACT 26:11" /></para>
  <para style="s">पावलले आयिङ आफिरिन्या आपानौ</para>
  <para style="r">
    <ref loc="ACT 9:1-19">प्रेरित ९:१-१९</ref>; <ref loc="ACT 22:6-16">२२:६-१६</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />“ऐलेस्यु मुख्या पुजाउरोयाङ ल्योङन अढिकार डोएस्यु सनर आग्या चिठी हिनस्यु ङा दमस्कसदेए ङाहिन्ङु। <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />ऐ रय अग्रिपास, तकलाएलाअका बेला यमल ङा नमतन नम्युउतन बै चम्किन्या ज्योति ङारङ्ङु, जो ङा सनर ङासकाए लिज्यान्याङ चारैवरदेए चम्किज्याऔ। <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />जब गे सोगलै नामल पाइस्यु गेलेयिउ, तब हिब्रू छेनल ङाजन ऐआढाज्यान्या ग़ा ङा ङा थएङु, ‘शाऊल, शाऊल, नङ दानाङ ङाजन दुख यांङ?’ बैसाकीत लाट्टी नटुपौक नङजन जै हूरा।” <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />“ओटन ङा ऐङाढोङु, ‘औ प्रभु, नङ काङ्का?’ प्रभुले ङाजन ऐआढोव, ‘ङा येशु ज्या, जोजन नङ दुख यांज्याना। <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />तर सोन्ते ओटन नखङले च्याङनते, दानाङभन्या ङात नङ नरङन्या सनर ङा नङजन ठन्स्याऔ परिन्या छेनल नाल्ट सेबक सनर साची खटाइन्या यिङले नङजन छेलन्या ङा नल्योङ ङारंन्ङु हो।<note caller="-" style="x"><char style="xo" closed="false">26:16 </char><char style="xt" closed="false"><ref loc="EZK 2:1">इजकिएल २:१</ref> </char></note> <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />ङा नङजन नमी इस्राएलीयाङ सनर गैरयहूदीयाङ ल्योङन छुटकारा यांना, जोल्योङ ङा नङजन परिङना,<note caller="-" style="x"><char style="xo" closed="false">26:17 </char><char style="xt" closed="false"><ref loc="1CH 16:35">१इतिहास १६:३५</ref> </char></note> <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />कि नङ नकाङल म्युउ फएस्योर, ओटन नकाङ च्युऊन्याङन ज्योतिदेए, ओटन सैतानल अढिकारङन परमेस्वर लेऊदेए ग्यावलरते। ऐलेस्यु नकाङै पापल छेमा डोएरा ओटन ङायर्ता बिस्वासलन पबित्र ताइन्याङै नका पो रङौ डोएरा।’<note caller="-" style="x"><char style="xo" closed="false">26:18 </char><char style="xt" closed="false"><ref loc="DEU 33:3">ब्यबस्था ३३:३</ref>; <ref loc="ISA 35:5-6">यशैया ३५:५-६</ref>; <ref loc="ISA 42:7">यशैया ४२:७</ref>; <ref loc="ISA 42:16">यशैया ४२:१६</ref>; <ref loc="ISA 61:1">यशैया ६१:१</ref> </char></note><verse eid="ACT 26:18" /></para>
  <para style="s">पावलले आसेवाकाई बारेल आपानन्या</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“नैताइस्यु, ऐ रय अग्रिपास, स्वर्गङन्ता दर्शनत ङा अनाग्याकारी माताहङदी। <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />तर हादेए दमस्कसलं, तब यरुशलेमल ओटन सोगल यहूदियाला देसभरि लिज्यान्याङजन, ओटन गैरयहूदीयाङजन बै पापतन पस्चाताप ढास्यु परमेस्वर लेऊदेए वल्चिते ओटन जे पस्चातापल लायकला काम ढोचिते ऐलेस्यु ङा प्रचार ङाढोङु। <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />ईका छेनल कारन ख्वाए यहूदीयाङै जब ङा मन्दिरलं ङालज्याङु नकाङै ङाजन कोलोअस्यु सएन्या कोशिस राढाङु। <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />आछिमका दिन समन परमेस्वरले ङाजन व्एस्युई लेया। ओल्योङन्ज इङन्या घिन्या नेंलोअनेंझन्ज गवाइ यांऔयन ङा इल च्याङस्यु लेङा। अगमबक्ताङै सनर मोशाले आछ्योङन्या बचन निस्सिबै पुरा ताइरा ऐलेन्या छेन बाहेक अपुर नैज पानस्यु माल्दी। <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />नकाङै ऐलेवाङ कि ख्रीस्टले दुख भोघिऊजपरिया, ओटन सिन्यातन जिङदा ताइन्या हादेए ओले आमि आरुयाङ सनर गैरयहूदीयाङजन उद्दारल सनर ज्योतिल मुइवा।”<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="ISA 42:6">यशैया ४२:६</ref>; <ref loc="ISA 49:6">यशैया ४९:६</ref> </char></note><verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />पावलले ओलजै आबचाउल नाल्ट ईका छेन आछ्योङज्याऔक फेस्तसले घिन्या ग़ाले ऐआढोव, “ऐ पावल, नङ भ्याई नपरीऊकाले नङ बौलाहा नताइनु।”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />तर पावलले ऐआढोव, “भ्याई आदरला फेस्तस, ङा बौलाहा माङडी, तर सत्य सनर सहि छेन छ्योङज्याङा। <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />दानाङभन्या ङा रयल लेऊक बै ढूक्‌कैसं छ्योङज्याङा। ओलं लेऊक ईका नैज छेन मामोअसिडी ङाजन बिस्वास ऐलेया, कि नाले ईका छेन ऐसनज्याया, दानाङभन्या नका घटना ता गोप्यल माताइदा। <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />रय अग्रिपास, नैति नङ अगमबक्ताङत बिस्वास माढोनच्यो? ङा ऐसन्ङा, नङ बिस्वास ऐढोना।”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />अग्रिपासले पावलजन ऐआढोव, “आवाए छिटै नङ ङाजन बिस्वासी जाटौ नरोअनु?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />पावलले जबाक आयोव, “थोरै बेलाल ग्याताइत्या या भ्याईलं ईका पोअसिन्या बन्दनयाङ राइस्यु, नङ याएज माङडी, तर आछिम ङाछेन थएन्याङ ज्वाए जेल्चिऊ सोगलै ङामन ग्याताइरत्या ऐलेस्यु ङा परमेस्वरलं प्रार्थना ढोङा।”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />तब रय, हाकिम बरनिकी सनर नङं चुङन्याङ ज्वाएलेवाङ सोगलै च्याङवाङ। <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />तब नकाङ पलिईस्यु रारांल ऐलेस्यु छ्योङवाङ, “ईका रुले परान सजाय डोएन्या अथाबा कैदी हिनन्या डवलला नैज काम ढास्यु माल्दी।” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />अग्रिपासले फेस्तसजन ऐआढोव, “इकाले कैसर ल्योङ निबेदन माढासिन्या ताहकन ईका रुजन राइसिकन बै ताइन्या।”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">पावल रोमदेए हिनौ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />जब ईका निर्नय ताहौ कि गे री जाहसतन इटालिया हिन्‌या, तब नकाङै पावल सनर कोबाअ अपुर कैदीयाङ राझन्ज बै युलियस मिनला अगस्तसल सैनिक दलला कप्तानल कुईत रा:सुम्पिऊ। <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />एड्रामिटेनोसलन एशिया प्रदेसला छुटाछुट्टै बन्दरगाहयाङ ताइस्यु हिनन्या तोलोअ री जाहसलं छिरिस्यु गे काम सुरु गेढोयिउ। अरिस्तार्खस मिनला थेसलोनिकेला तोलोअ माकेडोनि गेसकाए बोलोङ लेऊ। <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />गे छिन्का छिम्क गे सीदोनल गेतापयिउ। युलियसले पावलजन दया थनस्यु नकाल न्हाएयाङ ल्योङ हिनस्यु चाहिन्या व्एन्या होनन्या अनुमति आयोव। <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />नङंन घूईका आढाऔकाले री जाहस फएस्यु गे साइप्रस टापुल वङ्ङन ताइस्यु गेहिन्यिउ। <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />किलिकिया सनर पामफिलिया नेराका समुन्दर ताइस्यु गे लुकिया सहरल माइराल गेलाइयिउ। <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />नङ कप्तान अलेक्जेन्ड्रियाला तोलोअ री जाहस इटालिया हिन्ङाआल्ज्यान्या गेडोएयिउ ओटन ओले गेजन ओलं अलेक्जेन्ड्रियाल तोलोअ री जाहस गेडोएयिउ ओटन पटवाराले गेजन नकाल आचराइयिउ। <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />जब गे भ्याई दिन समन माठो माठो बअ दुखसकाए क्नीडसल सामन्दी गेतापरायिउ, ओटन घूईकालेगर्दा अझै हादेए बाऔ आमायांचिऊ नैताइस्यु क्रेट ताइस्यु गे सालमोनेल वङल गेहिन्यिउ। <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />बअ दुखसकाए नकाल वङवङ बास्यु गे सुन्दर बन्दरगाह ऐढासिन्या पोल गेराइयिउ। नङंन लासिया सहर नेराकै लेऊ।<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />जब भ्याई दिन बितिऊ, ओटन समुन्दर रीला यमल गारोला लेऊ, नैताइस्यु कि बर्तल दिन आब खिमस्यु लेऊ, ओटन पावलले नकाङजन ऐआढोवाङ, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />“ऐ भाईयाङ, ङाजन ऐटाइन्या सनौज परिया कि ईका यमल बिपत्ता सनर भ्याई नोक्सान याएज समान ओटन जाहसलं मानकन गेमि परान बै हिनौढुदुवाङ।” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />तर सुबिदारले पावल आछ्योङन्याल भन्या री जहास चलाइन्या कप्तान सनर जहासलं खसमले नेंछ्योङन्या छेनत बिस्वास आढोव। <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />ईका बन्दरगाहल हिउदा कटाइन्या सुबिदा आलेऊकाले जोमनलेस्यु बै फोनिक्सलं ज ताप्स्यु झिमौ साहा कटाइन्या ताहा ऐलेस्यु भ्याउयाएले नङंन जाहस चलाइन्या सल्ला रांयोव। फोनिक्स क्रेटला तोलोअ बन्दरगाह ज्या, जो दच्छिन-पछिम सनर उत्तर-पछिमदेए फर्किस्यु लेऊ।<verse eid="ACT 27:12" /></para>
  <para style="s">समुन्दरल आन्ढी</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />जब दच्छिनङा घूईका ततार सकाए आढोव, नकाङै रायिङौ कि नकाङजन जो आबस्यक लेऊ नका रांल्योङ लेऊ, नैताइस्यु लङ्गर रांछेनौ ओटन क्रेटल वङवङ समुन्दरल लेऊक गेहिन्यिउ। <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />तर तचिइ समाय छिन्ट ना टापुलन घिन्या आन्ढील बेगत उत्तर-पुर्बी ऐढासिन्या मिनला घूईका चलिउ। <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />जब री जाहस आन्ढील चपेटाल परिऊ, नाले घूईकाजन थामिऊ माढुदुडा, ओटन गे ओजन बगिऊ गेयोंयिउ ओटन चलिज्यान्या हावासै गेराइयिउ ओटन ना हिनौ। <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />तब क्लौडा ऐढासिन्या तोलोअ इङन्या टापुल वङ्ङन बगिस्यु हिनौ, ओटन गे बअ दुख सकाए जाहसला डोङ्गाजन जोगाहौ गेढुदुयिउ। <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />नकाजन छेन्स्यु गोटागोटा उपाय ढास्यु जाहसजन वान्ङन रांपोकौ, ओटन सिरटिस ऐढासिन्या बाल्वाल बुदिया ऐलेन्या छ्याइले तिरपाल सनर समानजन रांउतारिऊ ओटन जहास ओलजै बगिऊ लागिऊ। <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />आब आन्ढीले गेजन भ्याईज छेनन्या सनर पछारिऊ लागिऊ, ओटन तयोअछिम्क नकाङै री जाहसला सामान क्याहौ लागिवाङ। <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />ओटन तिस्रा दिन नकाङै राकुईले जाहसला समान बै रामिल्काहौ। <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />जब तबर दिन समन नम्युउ सनर हरवए नैज रङौ माडोएज्यावाङ, नवाए बेला भ्याई आन्ढी चलिज्याऔ, आखिरीत गे सोगल बान्चिन्या आसज गेमाढोयिउ।<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />तबर दिन समन नकाङ ज्यान्या समन माज्यास्यु चुङस्यु लेवाङ। तब पावल नकाङ लेऊक च्याङस्यु ऐलेऊ, “ऐ न्हाएयाङ, जे ङा सल्ला मानिस्यु क्रेटलन जाहस माचलाहौ परिन्या हो, ओटन ऐटाइन्या दुख ङा कारनले नोक्सान ब्याहारिऊ परिऊ। <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />तर आब ङा आकअ जेजन बिन्ति ढाच्या, साहस ढोचिते। जे काङ्काईल सिन्या माल्चिदी, तर जाहस नस्ट ताहा। <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />दानाङभन्या ङा जो परमेस्वरलं हो, ओटन जोल आराधना ङा ढोङ, ओलं तोलोअ स्वर्गदुत जेईक रिउल ङालेऊक च्याङस्यु छ्योङौ। <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />ओले ङाजन ऐआढाङु, ‘पावल, ताछ्यातन, नङ कैसरलं लेऊक निस्सिबै च्याङौपरिया, ओटन खिम्ते, नङसं जहासलं चरिन्या सोगलैजन परमेस्वरले नकुईत यांस्यु नाटन्वा।’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />नैताइस्यु न्हाएयाङ, साहस ढोचिते। ङा परमेस्वरजन बिस्वास ढोङा, ङाजन जो पानस्याङु, ठिक्कै नैज ताहा। <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />तर गे काङ्का तोलोअ टापुल बजारसिन्या लेया।”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />तर जब चौध रिउ ताहौ, ओटन अन्द्रियास भुमध्य सागरल गेहुत्तिज्यायिउ, तब तपाअ रिउल नाबीयाङै गे काङा नामल नेराक गेतापराज्यायिउ ऐलेस्यु अनुमान रांढोव, <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />ओटन गैराई मानस्यु रांखिमौक नकाङै चालिस मिटर लेऊ लेस्यु पत्ता रांलाहौ, ओटन तचिइ हुदेए हिनस्यु फरि गैराई रामानौक नकाङै तिस मिटर लेऊ लेस्यु पत्ता रांलाहौ। <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />ओटन ऐयाङ चमलयर्त ठुकिसियाकरअ ऐलेन्या छ्याहै, नकाङै जहासलं छिन्ङन चारगोटा लङ्गर रासटेहौ, ओटन छकाल्या ग्याताइत्या ऐलेस्यु प्रार्थना ढाऔ तअसिवाङ। <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />जब नाबीकयाङ री जाहसलन ढोङौ तअसिवाङ, ओटन हाङन लङ्गर सतेइन्या बाहानाले डोङ्गालन समुन्दरल लाइवाङ, <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />तब पावलले कप्तान सनर सिपाइयाङजन ऐआढोवाङ, “ईका रुयाङ जाहसलं माचुङदुरा भन्या जे बान्चिऊ माढुदुचिदी।” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />तब सिपाइयाङै डोङ्गाला छिङयाङ रापलाअस्योव, ओटन डोङ्गाजन हिनौ रांयोव।<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />जब छकाल्या होएहोए ताइङा लिज्याऔ, पावलले सोगलैजन ज्यान्याज्योया ऐआढोवाङ, “जे अन्टातोल परीस्यु लेच्यो नैज माज्यास्यु करेटै जेचुङन्या आछिम चौध दिन ताइदा। <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />नैताइस्यु कोबाअ ज्योचिते ङा जेजन ऐढाच्या। कोबाअ ज्योच्योकन जे बान्चिच्या, ओटन जेमि काङ्काईल ङएलन तोलोअ चेम बै नस्ट माताइदी।” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />ईका आपानौ छिन्ट नकाले भरेई आहोनौ, ओटन सोगलैल हार्मै परमेस्वरजन धन्याबाद चराइस्यु ना कलाएस्यु कयौ तअसिऊ। <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />तब नकाङ सोगलैले बै हौसला डोएस्यु कोबाअ ज्यान्या जन्तु रांज्योव। <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />जाहसलं ताइन्या गे जम्मा नेसय छेहत्तर जना गेलेयिउ। <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />नकाङ सोगलैले वाङौजोरसं ज्योरापाइना, जाहसजन बुङन्या जाटौ नाल्ट समुन्दरल पलीमाजन राक्याइस्यौ।<verse eid="ACT 27:38" /></para>
  <para style="s">री जहासलं नोक्सान</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />होएहोए आताहौक बै नकाङै ना पो सहौ रांमाढुदुऊ, तर नकाङै तोलोअ खाडी रांरङौ। नकाल बलौत्या आवङ लेऊ। ताहौढुदुउकन जाहसजन नलै आवङल लाङया। <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />नकाङै लङ्गर पलाअस्यु रासटेहौ, ओटन समुन्दरलै नका लिज्याऔ रांयोव। नवाए बेलाई पटवाराङजन पोअस्यु रानाएन्या छिङयाङ रापलाअस्योवाङ, हादेएङा तिरपालजन छेन्स्यु घूईकादेए राथोरौ ओटन जाहसजन आवङदेए रालाङौ। <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />तर रील न्युउल बोरसिज्यान्या बाल्वाल जाहस थुक्किसिस्यु नलै बुदिउ, जहासलं हाङन्ता वङ व्आव ओटन चलिउज माढुदुडा, ओटन छिन्ङन्ता भाग छालयाङल जोरले टुक्रिऊ तअसिऊ। <verse eid="ACT 27:41" /><verse number="42" style="v" sid="ACT 27:42" />कैदीयाङ च्योलस्यु ढोङवाङ सन् ऐलेन्या यिङसिस्यु सिपाइयाङै नकाङजन सएन्या सल्ला रांढोव। <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />तर कप्तानले पावलजन जोगाइन्या यिङ ढास्यु नकाङजन नैलेन्यातन आरुकिवाङ। च्योलौ ढुदुन्याङ सोगलै जाहसलन हादेए जोओस्यु आवङल हिन्चिते ऐलेन्या आदेस नकाले आयोवाङ, <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />ओटन बाङ्की लिज्यान्याङ फलल्यां जिऊतन सनर जाहसला टुक्राङतन हूत हिन्चिते ऐआढोवाङ, ओटन ऐलेस्यु सोगलै चान्यासकाए आवङल तापवाङ।<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">पावल माल्टा टापुल</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />गे चान्यासकाए समुन्दर वङदेए पलिईया पाइनाई टापुल मिन माल्टा रैस ऐलेन्या गेजन थाह ताहौ। <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />नल चुङन्याङै गेजन गजाबसै दया राढायिउ, नमवास्यु झिमापाइनाई नकाङै मी रा:सलकाईस्यायिउ, ओटन गे सोगलैजन स्वागत रांढोव। <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />पावलले तबीता सिङ दुउस्यु आहोनौ ओटन ना हिनस्यु मील आवोरज्याऔक, मील मुनले तोलोअ डाङ पलिईस्यु रांऔ, ओटन आकुईल मलिङसिऊ।<verse eid="ACT 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 28:4" />नला चुङन्याङै नकाल कुईल डाङ आमलिङसिन्या रङस्यु रारांल छ्योङौ तअसिवाङ, “ईका रु पक्का बै साइढवा जै ताहौपरिया। ईका समुन्दरलन बान्चिस्यु ता पलिहौ तर नियाले नकाजन बान्चिन्या अनुमति मायोडा।” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />पावलले ना डाङजन मील आक्याहौ, ओटन नकाल नैज बै बिराऊ माढोदा। <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />तर नकाङै आकाल बुल वया, अथाबा आका झुकाउन्या ढलिस्यु सिया ऐलेस्यु वुटौ तअसिवाङ। तर नकाङै तबर छिन्ट समन रावुटौ ओटन बै नकाजन कैज आमाताइन्या रङस्यु राबिचार फिरिस्यु ऐलेऊ तअसिवाङ, “ईका ता देउता दी रैस।”<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />ना टापुला पब्लियस मिनला मुख्याल यिङ खेए ना पोल आनावङल लेऊ। नकाले गेजन स्वागत आढायिउ, ओटन तिन दिन समन आझिमल गे अतिथि सेवा आढोव। <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />पब्लियसलं बौ नाएबोर सनर फुहुर बेथाले आनाएबोरज्याऔ। पावल नकाजन खिम्नाऔ, ओटन नकाल नाल्ट प्रार्थना आढोव, ओटन आकुई नकाल यर्त नाएस्यु नकाजन आसबेलौ। <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />ईका घटना आताहौ छिन्ट, ना टापुला अपुर नाएबोरन्या रुयाङ बै रांवाङ, ओटन ओयाङजन आसबेल्वाङ। <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />नकाङै गेजन भ्याई आदर राढायिउ, जब गे री जहासलं गेचरियिउ, ओयाङै गेजन उपाहार यांस्यु सम्मान राढायिउ, ओटन गेजन जो जो सामानल आबस्यक लेऊ नका समान जहासलं रानाएस्यायिउ।<verse eid="ACT 28:10" /></para>
  <para style="s">माल्टा टापुङन रोम समन</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />तिन मैना छिन्ट, गे अलेक्जेन्ड्रियाल जहासलं गेचरियिउ, ईका जाहस हिउदाक बै ईकाइ टापुल लेऊ, जहासलं हाङन्ता भागल जोङल्या देबल सुरुप खोपिसिन्या लेऊ। <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />सुराकुसाईल ताप्स्यु गे नङं तिन दिन गेचुङयिउ। <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />नङंन गे वङवङ ताइस्यु रेगियन सहरल गेतापरायिउ, तयोअछिन्ट दच्छिनी घूईका आढोव, ओटन फरि छिन्का छिम्क गे पटिओलील गेतापरायिउ। <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />नल गे भाईयाङजन गेडोटैवाङ, ओटन नकाङै गेजन साट दिन समन रा:सकाए बोलोङ चुङौ नाल्ट बिन्ति राढायिउ, नैलेस्यु गे रोमल गेतापरायिउ। <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />नलन गे रांन्या थाई थएस्यु रोमला भाईयाङै गेजन डोएन्या अप्पियसलं बजार सनर तिन-पाटी ऐढासिन्या पोल रा:स्यु गेलेयिउ। नकाङजन रङस्यु पावलले परमेस्वरजन धन्याबाद आयोव, ओटन साहस आडोटौ।<verse eid="ACT 28:15" /></para>
  <para style="s">रोमल पावल</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />जब गे रोमल गेपसियिउ, तब पावलस तोलोअ सिपाइले आबाठएक पहरा यांस्यु चुङन्या अनुमति आडोटौ।<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />तिन दिनछिन्ट पावलले यहूदीयाङल स्थानीय अगवाङजन खुल्स्यु आपरिङवाङ। नकाङ दुउसिरा पाइनाई नकाले ओयाङजन ऐआढोवाङ, “इस्राएली भाईबैनाङ, ङा ता ङादेसला रुयाङ, अथाबा बौ-पुर्खाला रीतिथितिला बिरोदल नैज काम ढास्यु ङामालेङु। ताहकन्बै बन्दी ताइस्यु यरुशलेमङन रोमीयाङल कुईल ङाजन जिम्मा यांस्यु लेरा। <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />नकाङै छानबिन राढाऔछिन्ट, ओयाङै ङाजन सएन्या सजायल नैज कारन माडोएरापाइना ङाजन राइन्या यिङ रांढोव। <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />तर यहूदीयाङै बिरोद राढान्याले कैसर ल्योङ निबेदन यांन्या ङाजन कर रांलाइङु। ङा रुयाङ बिरोदल नैज आरोप होनन्या छेन मालेऊ।<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 25:11">प्रेरित २५:११</ref></char></note> <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />नैताइस्यु ङा जे सकाए डोएसिस्यु छ्योङन्या ऐलेस्यु ङाखुल्चिऊ। दानाङभन्या इस्राएलला आस जो हो नकाल नाल्ट ईका साङ्गलल ङा पोअसिस्यु लिज्याङा।”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />नकाङै नकाजन ऐराढोव, “गे ता नमी बारेल यहूदिया प्रदेसलन नैज चिठी डोएस्यु मालेईदी, गे काङ्काई गे रुयाङै रा:स्यु नबिरोदल नैज माचान्या छेन बै रा:सथएन्या या रांछ्योङन्या माल्दी। <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />तर नमी बिचार नैति, नका नल्योङन्ज थटौ रोअया। दानाङभन्या ईका बगालल बारेल गेजन इवाएजाई थाह लेया, कि जोङबै रुयाङ इकाल बिरोदत छ्योङज्यारा।”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />तब नकाङै पावलल नाल्ट तयोअ रातोकिस्योव, ओटन भ्याई बगालल रुयाङ नकाल डेराल रांवाङ। नकाले ओयाङजन छकाल्याकन ओईक समन आपानस्योवाङ, ओटन मोशाल ब्यबस्था सनर अगमबक्ताङल किटापलन परमेस्वरलं राज्यल बयन आयोव, ओटन येशुल बिसयलं नकाङजन बिस्वास ढाऔपरिङन्या चेस्टा आढोव। <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />नकाले आपानन्या छेन ख्वाएले बिस्वास रांढोव, ख्वाएले रांमाढोव। <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />ओयाङ रारांल माभन्वाङ, ओटन भाअसिङा रालज्याऔक पावलले ईका आखिरी छेन आपानस्योवाङ, “गेमि बौ-पुर्खाङजन यशैया अगमबक्ताङन पबित्र आत्माले आपानन्या बचन चान्याई लेऊ,<verse eid="ACT 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 28:26" />ईका रुयाङ ल्योङ हिनस्यु पान्ते,</para>
  <para style="q" vid="ACT 28:26">थएन्या ता जे ऐथएच्या, तर ‘खकै माबुचिडी,</para>
  <para style="q" vid="ACT 28:26">खिमन्या ता ऐखिमच्या, तर खकै मारङचिदी।’<note caller="-" style="x"><char style="xo" closed="false">28:26 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यशैया ६:९-१०</ref> </char></note><verse eid="ACT 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 28:27" />दानाङभन्या ईका रुयाङल यिङ बोधो ताइस्यु लेया,</para>
  <para style="q" vid="ACT 28:27">ओटन ‘नकाङल ना भैरा ताइस्यु लेया,’</para>
  <para style="q" vid="ACT 28:27">ओटन नकाङल राम्युउ बन्द जाएस्यु लेया,</para>
  <para style="q" vid="ACT 28:27">मानकन्ता नकाङै म्युउले रङरा होला,</para>
  <para style="q" vid="ACT 28:27">ना ले बुझिरा होला,</para>
  <para style="q" vid="ACT 28:27">ओटन वल्‌राहोला,</para>
  <para style="q" vid="ACT 28:27">ओटन परमेस्वरले ऐलेऊ, ङा नकाङजन सबेलङराहोला।”<note caller="-" style="x"><char style="xo" closed="false">28:27 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यशैया ६:९-१०</ref> </char></note><verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />“नैताइस्यु जेजन थाह ग्याताइत्या, कि परमेस्वरलं आका मुक्ति गैरयहूदीयाङल नाल्ट परिङस्यास्यु लेया, ओटन नकाङै थएन्या लेरा।”<note caller="-" style="x"><char style="xo" closed="false">28:28 </char><char style="xt" closed="false"><ref loc="PSA 67:2">भजनसङ्ग्रह ६७:२</ref>; <ref loc="PSA 98:3">भजनसङ्ग्रह ९८:३</ref>; <ref loc="ISA 40:5">यशैया ४०:५</ref> </char></note> <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />ओटन नकाले ईका बचन आपानौ छिन्ट, यहूदीयाङ रारांल भ्याई यिसिऊयन ढास्यु भाअसिवाङ।<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />पावल पुरा नेबर्स समन आखर्चले रोमल चुङौ, ओटन नका ल्योङ रांन्याङ सोगलैजन नकाले स्वागत आढोवाङ। <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />नकाले खुल्लमखुल्लासं मारुकिस्यु परमेस्वरलं राज्यल प्रचार आढोव, ओटन प्रभु येशु ख्रीस्टल बारेल सिक्छ्या आयोवाङ।<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>