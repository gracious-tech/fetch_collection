<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="HAB" style="id">HAB'.TXT Marzo 2009 Pedro D. Cabrera Mam Ostuncalco</book>
  <para style="h">Habacuc</para>
  <para style="toc3">Hab</para>
  <para style="toc2">Hab</para>
  <para style="toc1">Tuj Ab'akuk (Habacuc)</para>
  <para style="mt1">TUJ AB'AKUK</para>
  <para style="mt2">(Habacuc)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Ate Ab'akuk pakb'an tojxju' tq'ijlalil tej tpakb'an Nawum, tej ma'toq kub'kyi'j aj Asirya kyu'n aj B'ab'ilon, ex tej tok toklenju' B'ab'ilon kse'n toklen Asirya. Aye'tzunju' kxjal te q'oj e'pon kse'nqe' t-xjal Asirya majxtaq txkupqe'. Qa tzalajte Nawum tej tkub'ti'ju' Ninib'e, atzunte Ab'akuk jawsak'puj tej tka'yinte qa b'entlju' B'ab'ilon kse'nxju' Ninib'e. Ex kane toj twitz Ab'akuk qa ma'toq che b'inchan ilju' ttanam Dyos sk'o'n ex intoq tna'nju' t-snajelal Dyos qa che b'el yajti jumajtl toj kq'ob'ju' aj B'ab'ilon. Ati maj ntzaj toj twitz Ab'akuk ti'j Dyos kse'nte Job' ex intma'n. ¿Se'n taq'wi ntjo'n Dyos tu'n tik' tkyaqil ja'lu? Atzun kyi'ju' aj B'ab'ilon ntma'n, qa Xjan Dyos, ¿Se'n taq'witzun nche' ikxju' xjal pi'sqe' tu'n? (cap. 1). Atzunte Dyos tzaj ttzaq'we'n te Ab'akuk qa ati tu'n tten tpasens ex ati tu'n tokqe tk'u'j ti'j. Qu'n naqa xponju' tq'ijlalil ex ajtponju' kmuj, ate Dyos tzul q'ol tume'n t-xel kye kykyaqil xjal: che kb'el t-xitunju' xjal myab'a'nqe' ex che anq'ilju' mache kub' we' toj kyokslab'l tu'n (cap. 2) Aju' mankb'il tnej atzu' nyolina' ti'ju' jun na'j Dyos, nakuj tuk'i'l b'itz, ja najwalitaju' tb'i Dyos nitzku' ex ja nq'anchalixaju' tokslab'l Ab'akuk nimxi'x ti'j Dyos.</para>
  <chapter number="1" style="c" />
  <para style="s1">Minti' elb'a'n b'yojxjali'n ex mya tnik'alti'j toj twitz Ab'akuk</para>
  <para style="q">
    <verse number="1" style="v" />A pakb'ab'l ja'lu tzaj tyek'u'n Qman Dyos te Ab'akuk ju' t-sanjelal.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Qman Dyos, ¿Jtojtzun chin q'jene' tu'n nqanin o'nb'ile' twitza</para>
  <para style="q">ex min nchin tzaj tb'i'na?</para>
  <para style="q">¿Jtojlo tu'n nq'jene' tu'n tpaju' b'yojxjali'n</para>
  <para style="q">ex na'mxtula tzaqpilqeye'?</para>
  <para style="q">
    <verse number="3" style="v" />¿Tiqu'n ntjo'naya tu'n nka'yinteye'</para>
  <para style="q">txqan mya tnik'alilti'j ex txqan il?</para>
  <para style="q">Txqan myab'a'n txoli'nk wi'je' ex xitb'il;</para>
  <para style="q">naqx q'oj nok toj tkyaqil najb'il.</para>
  <para style="q">
    <verse number="4" style="v" />Min nb'inchetju' ntma'n kawb'il,</para>
  <para style="q">nb'aj wab'la'nju' toklen xjal,</para>
  <para style="q">ljo'n toj tq'iju' b'a'n tu'nju' myab'a'n</para>
  <para style="q">ex matxi' txalpuju' tnik'alilti'j.</para>
  <para style="s1">Tzaq'web'l tu'n Qman Dyos</para>
  <para style="q">
    <verse number="5" style="v" />Kyka'yinxpe'ye' nb'aj kyxolju' txqantl tnam najlqe' kyi'jileye';</para>
  <para style="q">kyka'yinxpe'ye' ex che xob'xe'.</para>
  <para style="q">Naqxi'x tu'n nb'inchantetle ti'xti'</para>
  <para style="q">expe' jaku' layx txi' kyoksla'ne', qa ati jun matxi' q'mante kyeye'.</para>
  <para style="q">
    <verse number="6" style="v" />Che tzajel wi'ne' kaldey q'ojil kyi'je',</para>
  <para style="q">aye'ju' txkup xjalqe', ex axi'x tb'is kyk'u'ju'</para>
  <para style="q">tu'n kyxi' toj tkyaqil twitz tx'otx' toj jun plaj ex tojun plajtel</para>
  <para style="q">tu'n tkub' ktzyu'nju' tx'otx' mya kye.</para>
  <para style="q">
    <verse number="7" style="v" />Xob'ajilqe'x, mixti' nxi' knima'n juntl kawb'il</para>
  <para style="q">aye'ku' nche kub' q'onte kykawb'il.</para>
  <para style="q">
    <verse number="8" style="v" />Kuwxi'x che ojqelanju' kychej kyekywitz Leopa'rt,</para>
  <para style="q">myalqexi'x kyekywitzju' xo'j toj chq'ajlaj.</para>
  <para style="q">Txqanju' kyxjal aj chejil</para>
  <para style="q">najchaq nche'x q'ojina' kyi'ju' kyajq'oj,</para>
  <para style="q">kse'n t'iw najchaq ntzaj t-xona' tib' ti'j tchi'.</para>
  <para style="q">
    <verse number="9" style="v" />Nkyaj xitj tkyaqil kyu'n ja nche' ik'a';</para>
  <para style="q">nkyaj kyawanxi'ju' xob'ajil nche b'etxi',</para>
  <para style="q">nimxi'x txqan xjal nche'x kyk'lo'n</para>
  <para style="q">kyetwitzju' tz'awun toj ninnjab'.</para>
  <para style="q">
    <verse number="10" style="v" />Nche' jaw xmayin kyi'ju' nimaqkawil</para>
  <para style="q">ex kyi'ju' xjal nim kyoklen.</para>
  <para style="q">Nche jaw tze'n kyi'ju' ja kuwsa'nqe',</para>
  <para style="q">qu'n njaw kych'uqi'nju' tx'otx' twitzju' ja</para>
  <para style="q">ex nche b'jo'kx lipan toj.</para>
  <para style="q">
    <verse number="11" style="v" />Nche' ik' kse'n jun kyq'iq' jb'al;</para>
  <para style="q">axju' kyipumal nok kyq'o'n te kydyos.</para>
  <para style="s1">Jaw yolin jumajtl Ab'akuk ti'j Qman Dyos</para>
  <para style="q">
    <verse number="12" style="v" />Qman Dyos, atina'ta tejumajx,</para>
  <para style="q">Nman Dyos milo b'ajela'ta ex xjana.</para>
  <para style="q">A na'ta klol weye' Qman Dyos,</para>
  <para style="q">matxi' txitq'o'na kyipumal kaldey</para>
  <para style="q">tu'n kyb'inchanteju' tnik'alilti'j ntma'na.</para>
  <para style="q">
    <verse number="13" style="v" />Majx b'a'nxi'xta, min ntk'mo'nju'ya taq'wixil,</para>
  <para style="q">tu'nju' ntka'yi'nju'ya taq'wixxi'x naku'j b'a'n toj twitza;</para>
  <para style="q">¿Se'n taq'witzun naq nka'yina ex mixti'</para>
  <para style="q">ntma'na kyeju' nimaq aj il,</para>
  <para style="q">ex mixti'te' ntma'na kyeju' b'inchal myab'a'n</para>
  <para style="q">nche kub' kb'yo'nju' b'a'nqe'xi'x kyetwitz?</para>
  <para style="q">
    <verse number="14" style="v" />¿Titiqu'n ntb'incha'na' lu kyeju' xjal</para>
  <para style="q">naku'xwitloj kyiẍqe' toj ninnjab',</para>
  <para style="q">kse'nkye txkup mixti' jun kawb'il kyxol?</para>
  <para style="q">
    <verse number="15" style="v" />Nkub' kyi'ju' junjuntl tnam kyu'nju' kaldey</para>
  <para style="q">kse'n tzyul kyiẍ nkub'ti'ju' kyiẍ tu'n:</para>
  <para style="q">ntzyet tu'n tuk'i'l jun k'uxb'il ẍok twi' ex tuk'i'l pa te tzuyb'il kyiẍ,</para>
  <para style="q">ajtzun tka'yinte, matxi'toq che chmet tu'n junx, ntzalajxi'x kyi'j.</para>
  <para style="q">
    <verse number="16" style="v" />Qu'mtzun aju' tzyul kyiẍ inxi'x tzalaj kyi'ju' pa exju' k'uxb'il ẍok ti'j,</para>
  <para style="q">inkub'tq'o'n chojb'il kye ex sturak te ninb'il kye,</para>
  <para style="q">chjontexi'x kye qu'n ati twa nim ex tb'anilxi'x kyu'n.</para>
  <para style="q">
    <verse number="17" style="v" />¡Lalun taja tu'n kyoktenju' kaldey tzyulqeye' tu'n pa tzuyb'il kyiẍ!</para>
  <para style="q">¡Lalun taja tu'n kyb'iyonju' xjal mixti'x tch'yon juntl kye!</para>
  <chapter number="2" style="c" />
  <para style="s1">Aju' tzaj tyek'u'n Qman Dyos te Ab'akuk</para>
  <para style="q">
    <verse number="1" style="v" />Naqx chin ayole' ex chin xq'uqile',</para>
  <para style="q">kse'n xq'uqil toju' taq'un,</para>
  <para style="q">tu'n wlonteye' titi' ktzajel tma'n Qman Dyos</para>
  <para style="q">ex titi' tzaq'web'l tzultq'o'n kyeju' nxjele'.</para>
  <para style="q">
    <verse number="2" style="v" />Tzaj ttzaq'we'nte Qman Dyos kjalu:</para>
  <para style="q">Tz'ib'anku'ya kywitz loq' naku'j tz'lanqe'</para>
  <para style="q">aju' kxe'l nyek'u'ne' teya,</para>
  <para style="q">tu'n tb'ent t-ẍch'et b'a'n ex ojqel.</para>
  <para style="q">
    <verse number="3" style="v" />Na'mx tpon kmuj tu'n tjapun ntma'nju' witzik' lu;</para>
  <para style="q">extzun ilti'j tu'n tjapun.</para>
  <para style="q">Naq tz'ayona, nakuj nimtoj,</para>
  <para style="q">kpomel jun tq'ijlalil tu'n tjapun.</para>
  <para style="q">
    <verse number="4" style="v" />Tz'ib'a'nku'ya qa njaw kynima'nkyib'ju' b'inchal myab'a'n,</para>
  <para style="q">aye'tzu'n tnik'alkyi'j kche anq'il tu'nju' nkyb'incha'n wajb'ile' ayine' Dyos, chij.</para>
  <para style="s1">Tz'e'ysb'il kywitzju' nche kub' kyjtz'o'n xjal</para>
  <para style="q">
    <verse number="5" style="v" />Kyajb'ilu' ichan nknima'n kyib' tu'n kpon toj oklenj,</para>
  <para style="q">inxi'x kyjyo'n ex min nche qen ex kyajb'il txqantl,</para>
  <para style="q">b'a'nqa myab'a'nju' oklenj.</para>
  <para style="q">Inxi' kyjqo'n toj kytzi kse'n kyjulil kyimni;</para>
  <para style="q">mixjun nche noj, kse'n kamik,</para>
  <para style="q">qu'mtzun nche b'etenje jyolte txqantl tnam tu'n tkub'ti'j kyu'n.</para>
  <para style="q">
    <verse number="6" style="v" />Ex kykyaqilxju' tnam b'aj kub'ni kyi'j kyu'n</para>
  <para style="q">kche xmayil kyi'ju' oje kub'kyi'j kyu'n, tuk'i'l b'itz kjalu:</para>
  <para style="q">¡Layxwita, matxi' jaw q'inumaxa</para>
  <para style="q">tu'nju' mya teya!</para>
  <para style="q">¿Jtojtzun tu'n tq'jena tu'n</para>
  <para style="q">tb'uyinteya tq'inumala, noq tzaj tmajena'na?</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Mixti' tnab'ena ti'j,</para>
  <para style="q">che pomelju' ati tk'asa kye,</para>
  <para style="q">ktzajel kna'n kyib'ju' che okyelten yajulteya</para>
  <para style="q">ex majx kjel ẍb'iqb'ana kyu'n.</para>
  <para style="q">
    <verse number="8" style="v" />Kb'ajel kb'uyi'n kyib'ju' nimaqtnam ti'ja</para>
  <para style="q">ex k'elex kyelq'a'n ti'xti' teya kse'nxju' tb'inchaya kye.</para>
  <para style="q">Kb'el tchjo'na tkyaqilju' xb'aj tb'incha'na,</para>
  <para style="q">jni'xju' myab'a'n xb'aj tb'inchana toj tnam</para>
  <para style="q">kyi'ju' nintnam exqe' xjal najlqe' kyoj.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />¡Layxwita, tu'nju matxi' noj toj tjaya</para>
  <para style="q">naqx tu'n teleq'a,</para>
  <para style="q">tu'n tb'ant tklonte tib'a teju' xob'ajil tzul!</para>
  <para style="q">
    <verse number="10" style="v" />Iktzun sela' kych'ixawju' toj tjaya tu'na,</para>
  <para style="q">ex matxi' tzaj tiq'inju'ya xitb'il tib'aja</para>
  <para style="q">tu'n tpaju' nim txqan tnam matxi' kub' xitj tu'na.</para>
  <para style="q">
    <verse number="11" style="v" />Che ẍch'ilju' ab'j teju' tapi</para>
  <para style="q">exqe'ju' ptzo'n te ja,</para>
  <para style="q">ti'ja tu'nju' ẍe kub' t-xituna.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />¡Layxwita, njaw tb'incha'na ninttanama</para>
  <para style="q">naqx tu'n b'yojxjali'n ex mya tnik'alilti'j ntb'incha'na!</para>
  <para style="q">
    <verse number="13" style="v" />Ate Qman Dyos nimtipumal</para>
  <para style="q">lay kub' tk'iwlanju' taq'unb'ena ex t-sikte'na,</para>
  <para style="q">qu'n tkyaqilju' taq'unb'ena kb'ajel wan tu'n q'aq'.</para>
  <para style="q">
    <verse number="14" style="v" />Knojelju' tkyaqil twitz tx'otx'</para>
  <para style="q">tu'nju' tojtzqib'l ex ninb'ilte Qman Dyos</para>
  <para style="q">kse'nqe' a' nnoju' ninnjab' kyu'n.</para>
  <para style="q">
    <verse number="15" style="v" />¡Layxwita, toka tx'ujt-salkyeju' tqe' nqayin tk'etza</para>
  <para style="q">nxi' tq'o'nju'ya q'e'n kye smo'n twitz tuk'i'l k'ul chuksal nab'l,</para>
  <para style="q">tu'n tkub' xnakyix tu'ntzun tok tka'yi'n ẍb'iqli!</para>
  <para style="q">
    <verse number="16" style="v" />K'elel tch'ixawa, mya tu'nwit tjaw nimana,</para>
  <para style="q">qu'n ate Qman Dyos kxe'l q'onte jun k'wab'l teya tu'n txi' tk'wana</para>
  <para style="q">ex kb'el tyek'u'n qa mixti' techila ti'j tchib'jila</para>
  <para style="q">ex kjawil miltz'uju' tninb'ila te tch'ixawa.</para>
  <para style="q">
    <verse number="17" style="v" />Tu'nju' taq'wixil xb'aj tb'incha'na ti'j witz Lib'ano</para>
  <para style="q">axtzun che okyel miltz'uju' ti'ja,</para>
  <para style="q">ex kjawil xob'a tu'nju' ẍe kub' tb'yo'na talu'n.</para>
  <para style="q">Atzun tzulju' ti'ja tu'n tpaju' nimaq il xkub' tb'incha'na</para>
  <para style="q">exju' txqan il xb'aj tb'incha'na toj tnam</para>
  <para style="q">kyi'ju' nimaqtnam exqe' xjal najlqe' kyoj.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />¿Titi' k'ajb'ela' jun</para>
  <para style="q">tilb'ilal xb'aj b'incha'n?</para>
  <para style="q">¿Titi' k'ajb'ela' jun tilb'ilal</para>
  <para style="q">noq nqo'x tiq'in toj chajyolil?</para>
  <para style="q">Min b'ent kyolinju' witzileb';</para>
  <para style="q">¿se'ntzun taq'wi tu'n tokqe tk'u'j kyi'j</para>
  <para style="q">aju' xjal nb'inchankye?</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />¡Layxwita, nxi' tma'na</para>
  <para style="q">te jun witzileb' tze tu'n ttzaj tna'ntib',</para>
  <para style="q">ex te jun ab'j min yolin tu'n tkub' we'!</para>
  <para style="q">¿Ma atitzun tu'me'l tu'n ttzaj kma'n jun pakb'ab'l?</para>
  <para style="q">¡Lay, qu'n mixti' kychwinqlal,</para>
  <para style="q">b'a'nqa ktxu'nqe' tu'n q'anpwaq ex saqpwaq!</para>
  <para style="q">
    <verse number="20" style="v" />Atzunte Qman Dyos ati toj tja:</para>
  <para style="q">¡che numeku' xjal twitz te tkyaqil twitz tx'otx'!</para>
  <chapter number="3" style="c" />
  <para style="s1">Tna'j Dyos Ab'akuk</para>
  <para style="q">
    <verse number="1" style="v" />Aja'lu jun tna'j Dyos t-sanjelal Dyos Ab'akuk.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Aju' nb'i'ne' ti'ja, Qman Dyos,</para>
  <para style="q">ex ti'ju' matxi' tb'inchaya,</para>
  <para style="q">nqe nk'u'je' ex nchin nimane' tu'n.</para>
  <para style="q">B'inchama ja'lo, toj qchwinqlale',</para>
  <para style="q">axju' oje tb'inchaya ojtxi',</para>
  <para style="q">tu'ntzun telqnik'e' ti'j.</para>
  <para style="q">Yek'untzju'ya tk'ujlalila qeye'</para>
  <para style="q">b'a'nqa toj ttx'u'jila.</para>
  <para style="q">
    <verse number="3" style="v" />Ate Qman Dyos atzu' tzula' toju' tnej tx'otx' te Teman;</para>
  <para style="q">twi'ju' witz te Paran tzulaju' Dyos xjan.</para>
  <para style="q">Matxi' kub' noju' twitz kya'j tu'nju' tajwalil,</para>
  <para style="q">ex matxi' noju' tkyaqil twitz tx'otx' tu'n ajwalb'ilte.</para>
  <para style="q">
    <verse number="4" style="v" />Inxi'x qoptza'j ti'j ajtul,</para>
  <para style="q">ex nche etz qoptz'aj spik'un toj tq'ob'</para>
  <para style="q">atzuntzu' ntyek'u'na' tipumal e'wa'n tu'n.</para>
  <para style="q">
    <verse number="5" style="v" />Twitz nche' etza'ju' yajb'il taq'wixqe'xi'x,</para>
  <para style="q">ex ti'jxi' netza'ju' kyeq inxi'x k'ant kse'n q'aq'.</para>
  <para style="q">
    <verse number="6" style="v" />Inlu'lunju' tx'otx' kse'n ajtkub' we';</para>
  <para style="q">nche b'aj yukchiju' nimaqtnam qama txi' ka'yi'n kyi'j;</para>
  <para style="q">nche tzaj niq'ju' ojtxi' witz</para>
  <para style="q">ex nche kub' niwju' ojtxi' k'ul;</para>
  <para style="q">ayetzunkye' tb'eyil Qman Dyos tejumajxqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Oje che wile' xjal te Kusan</para>
  <para style="q">matxi' che kub' yajt,</para>
  <para style="q">exqe'ju' najlqe' Madyan matxi'</para>
  <para style="q">che b'ajxob' b'a'nxi'x.</para>
  <para style="q">
    <verse number="8" style="v" />¿Matxi' tzaj ttx'ujila, Qman Dyos kyi'ju' nin a'?</para>
  <para style="q">¿Matxi' tzaj ttx'ujila kyi'ju' ninnjab'?</para>
  <para style="q">¿In chejina kyi'ju' ttcheja</para>
  <para style="q">ex njaxa toju' tkarwaja te kanb'ab'l?</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />B'incha'nqe'tlju' t-smaja</para>
  <para style="q">ex ikqe'x tal t-smaja kykyaqil.</para>
  <para style="q">Matxi' jqetju' tb'e a' toj tx'otx' kyu'nju' nin a'.</para>
  <para style="q">
    <verse number="10" style="v" />Nche lu'lunju' witz ajtka'yinjtza kyu'n;</para>
  <para style="q">ntzaj txqan jb'al twitz kya'j,</para>
  <para style="q">ex ntinunju' ninnjab' nimin t-xe</para>
  <para style="q">kse'n nche' jaw lipanju' ttolob' nimaqxi'x.</para>
  <para style="q">
    <verse number="11" style="v" />Minti' nche etzju' q'ij exju' xjaw toju' knajb'il</para>
  <para style="q">kse'n nche' qoptz'aju' tal t-smaja</para>
  <para style="q">exqa nche' qoptz'aju' tch'uta.</para>
  <para style="q">
    <verse number="12" style="v" />Ntb'eti'na tx'otx' tkyaqil toju' ttx'ujila;</para>
  <para style="q">ex toj ttx'ujila nche b'aj kub'twab'e'na nimaqtnam.</para>
  <para style="q">
    <verse number="13" style="v" />Matxi' tz'etza onilteju' ttanama</para>
  <para style="q">ex onilteju' nimaqkawil xjaw t-sk'o'na.</para>
  <para style="q">Matxi' kub' t-xitu'na twi' tjaju' b'inchal taq'wix,</para>
  <para style="q">ex matxi' kyej q'ancha'lixju' tq'uqlil pik tu'na.</para>
  <para style="q">
    <verse number="14" style="v" />Kyu'nxju' ksmaj ekub'a tb'yo'na knejel,</para>
  <para style="q">tej aye'ju' aj chejil naku'j jun q'ankyaqqe',</para>
  <para style="q">e'tzaj sputilkyeju' minti' nb'ent kyq'ojin</para>
  <para style="q">tu'n kykub' xitu'ne' kyu'n toj ewaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Kyuk'i'lju' ttcheja nb'aj tb'eti'na toj tkyaqilju' ninnjab',</para>
  <para style="q">aju' txqan a' nimin t-xe ex nimin twitz.</para>
  <para style="q">
    <verse number="16" style="v" />Tetzunj nb'inteye' lu tkyaqilju' tzaj xob'il wi'je'.</para>
  <para style="q">E'b'jaw lu'lunju' ttxo'w ntziye',</para>
  <para style="q">el kyipumalju' nkuxe' tu'n nwe'ye' kyib'aj</para>
  <para style="q">tkyaqilju' nxmilale' mixti'tl kyipumal.</para>
  <para style="q">Tu'npetzunju' lu, kchin ayole' q'uqli nk'u'je'</para>
  <para style="q">ajtpon tq'ijlalil tu'n ttzaju' yajb'il tu'n</para>
  <para style="q">Dyos kyib'aj xjal te q'oj ate'qe'k yajlal qeye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="17-18" style="v" />Oktzun chin tzalajeltze' nimxi'x</para>
  <para style="q">tu'n Qman Dyos klol weye'.</para>
  <para style="q">Chin b'itzale' te b'a'nqa min nche' ub'chin tqan iw</para>
  <para style="q">ex b'a'nqa min ẍe' witzan tqan ub'a exqe' olib'o;</para>
  <para style="q">b'a'nqa min xjaw twitz awal toj kojb'il;</para>
  <para style="q">b'a'n qama che b'aju' tnej rit</para>
  <para style="q">ex b'a'nqa mixti'qe'tl wakx toj kyja.</para>
  <para style="q">
    <verse number="19" style="v" />Qu'n ate Qman Dyos ktzajel q'onte' wipumale';</para>
  <para style="q">ktzajel tq'o'n ipumalj kyeju' nkuxe' tu'n kyojqelan se'n te masat</para>
  <para style="q">ex kchin xe'l tiq'ine' twi' witz ja tu'me'l kchin kletela'ye'.</para>
</usx>