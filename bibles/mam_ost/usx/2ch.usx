<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="2CH" style="id">2KH.TXT Febrero 2009 Pedro D Cabrera Mam Ostunkalko. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">2 Crónicas</para>
  <para style="toc3">2 Cr</para>
  <para style="toc2">2 Cr</para>
  <para style="toc1">Tkab' Tu'jil Tqanil B'inchb'aj (2 Crónicas) Chik'b'ab'l</para>
  <para style="mt1">TKAB' TU'JIL TQANIL B'INCHB'AJ</para>
  <para style="mt2">(2 Crónicas)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Toju' tkab' Tu'jil Tqanil B'inchb'aj, nyolin ti'ju' tkawb'il Salomon, kyoju' tnejel b'eljoj (caps. 1-9) tnej, ti'jxi'tzuntl nyolin ti'ju' tej tjaw kyiq'i'n kyib'ju' tnej tyajajil Israel toj tb'a'nq'ob'kya'j tzmax tej tel kypa'n kyib' ti'ju' kykawb'il toj tja Dab'i (cap. 10). O'kxtzuntzu' nyolina'tl kyi'ju' nimaqkawil toj Juda, tzmax tej tkub'ti'j Jerusalen kyu'n ajq'oj (caps. 11-36). Ti'jxi'tzuntl ch'i'n chik'b'ab'l ti'ju' tej kyb'ajx q'i'n tjaq' tkawb'il juntl tnam, nb'aju' chik'b'ab'l toju' u'j lu tuk'i'lju' chaq'b'il etz tu'n Siro tu'n tb'aj ttxa'nju' yajb'il kyib'aju' ttanam Dyos ex taq' anb'il tu'n tanjtzkyi'ju' aj Juda toju' kytx'otx'.</para>
  <chapter number="1" style="c" />
  <para style="s1">Xitqani'n Salomon tnab'l te Dyos</para>
  <para style="r">(<ref loc="1KI 3:3-15">1 R 3.3-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Kuwixju' tkawb'il Salomon, tk'wal Dab'i, qu'n atitoq Qman Dyos tuk'i'l, tzaj tq'o'n nimxi'x tipumal. <verse number="2" style="v" />E'ttxoktzun Salomon kykyaqil aj Israel: e'nejenel kye xjal te q'oj, nejenel nche kawin tuk'i'l ex kykyaqilju' nejenel kye junjun ja atitoq kyoklen toj Israel. <verse number="3" style="v" />Xi'tzuntz kyuky'i'l kykyaqilju' xjal b'u'yi'ntoq kyib', toju' ja xjan atitoq toj Kab'aon, qu'n atoqtzu' ta'ju' ja te mujb'ab'ltib'il tuk'i'l Dyos, ju' kub' tb'incha'n Moyses, tmajin Dyos, toj chq'ajlaj. <verse number="4" style="v" />Ojetoqtzun tz'etz tiq'i'n Dab'i kax te Dyos toj Kyiryat-jearim ex pon tiq'i'n toju' tkub'el ojetoq kub' tb'incha'n, qu'n ojetoq jawtb'incha'n jun tpach xb'alun toj Jerusalen. <verse number="5" style="v" />Ex atoqtzu' ta' q'olb'eb'l q'ank'uxb'il, ju' kub' tb'incha'n B'esalel, tk'wal Uri ex tchman Ur, toj Kab'aon twitzju' ja xb'alun te Qman Dyos. Xi' Salomon kyuk'i'l kykyaqilju' tnam xjelul atzu'.</para>
  <para style="p">
    <verse number="6" style="v" />Jax Salomon tk'etzju' q'olb'eb'l q'ank'uxb'il atitoq twitz Qman Dyos, twitzju' ja te mujb'ab'ltib'il tuk'i'l Dyos ex tchaq' tu'n kytz'e'yset kab'k'al lajnaq (1,000) chojb'il k'ok'sb'il tib'aj.</para>
  <para style="p">
    <verse number="7" style="v" />Textzu'n qonik'an lu, kub' tyek'u'ntib' Dyos twitz Salomon ex tzaj tma'n te: Qanintza weye' aju' tajb'ila, kxe'l nq'o'nwe' teya, chij.</para>
  <para style="p">
    <verse number="8" style="v" />Xittzaq'we'n Salomon te Dyos: Matzaj tka'yina nmane' Dab'i tuk'i'l t-xtalb'ila, ex machin ok tq'o'na kawil te t-xel. <verse number="9" style="v" />Atzu'n ja'lo, Nman Dyos, japunx tu'na aju' tzaj tma'na te nmane' Dab'i, mana' chin oktq'o'na te kynimaqkawil jun tnam nimxi'x tajlal kse'n quq twitz tx'otx'. <verse number="10" style="v" />Qu'mtzun q'ontza nnab'le' ex wojtzqib'le' tu'n tb'ent tkawitju' tnam lu wu'ne'; qu'n ¿alkye kb'entel tkawinte ttanama lu niminxi'x? chi Salomon.</para>
  <para style="p">
    <verse number="11" style="v" />Tzajtzun ttzaq'we'n Qman Dyos te Salomon:</para>
  <para style="pi">Tu'ntzu'n a tb'is tk'u'ju'ya lu, ex mya q'inumal ex ti'xti' teya ex oklenj xtqaniya, ex mya kykamikju' tajq'oja, ex mya tchwinqlala nimtoj, ape' xtqaniya nab'l ex ojtzqib'l tu'n tb'ent tkawinteya ntaname', ja soka' q'o'na te nimaqkawil, <verse number="12" style="v" />kxe'l nq'o'ne' tnab'la ex tojtzqib'la, expe' kxe'l nq'o'ntle' tq'inumala, ti'xti' teya ex toklena; ju' minti' ten kyeju' nimaqkawil e'ten nejtl twitza, ex lay ten kyeju' che okyel yajxi'tl, chi Dyos.</para>
  <para style="p">
    <verse number="13" style="v" />Etztzun Salomon toju' ja xjan atitoq toj Kab'aon, ex anjti'j toj Jerusalen, ex tb'ajlenxi' tka'yi'nju' ja te mujb'ab'ltib'il tuk'i'l Dyos, kawin toj Israel.</para>
  <para style="s1">Tq'inumal Salomon</para>
  <para style="r">(<ref loc="1KI 10:26-29">1 R 10.26-29</ref>; <ref loc="2CH 9:25-28">2 Cr 9.25-28</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Eb'aj tb'u'yi'n Salomon karwaj ex xjal aj chejil. Atitoq oxk'al lajnaq (1,400) tkarwaj, atzun junmutx' lajk'al (12,000) t-xjal q'ojil aj chejil, eb'ajx t-sipa'n kyoju' ja kye karwaj te q'oj ex kyeju' xq'uqilte nimaqkawil toj Jerusalen. <verse number="15" style="v" />Nim saqpwaq ex q'anpwaq ten toj Jerusalen kse'n txqan ab'j tej tkawin Salomon; ex ten txqan k'ute kse'n tqan iw naq nche tzaj ch'iy toju' plan tx'otx'. <verse number="16" style="v" />Xi' nche tzaja' kylq'o'na' t-xk'aẍlel nimaqkawil Salomon tchej toj Musri ex Silisya. <verse number="17" style="v" />Junk'al lajnaq (600) saqpwaq twi' jun karwaj tzajni toj Ejipt, atzun wuqnaq lajoj (150) twi' jun chej. Intoq che k'ayin t-xk'aẍlel Salomon karwaj ex chej kyeju' nimaqkawil itit ex aj Sirya.</para>
  <chapter number="2" style="c" />
  <para style="s1">Kyej b'entti'j kyyol Salomon tuk'i'l Iram, nimaqkawil toj Tiro</para>
  <para style="r">(<ref loc="1KI 5:1-18">1 R 5.1-18</ref>; <ref loc="1KI 7:13-14">7.13-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Kub' t-xima'n Salomon tu'n ttzyet tb'inchet jun ja te Qman Dyos exju' tja te kawb'il. <verse number="2" style="v" />Wajxaqmutx' o'lajk'al (70,000) iqal e'oktq'o'n, atzun lajmutx' (80,000) jsol twitz ab'j twi' witz, atzun b'elajk'al (3,600) nejenel ka'yil aq'untl.</para>
  <para style="p">
    <verse number="3" style="v" />Yajxi'tzuntl xit-sma'n Salomon tq'umli te Iram, nimaqkawil toj Tiro: B'inchama weye' kse'nxju' tb'inchaya tuk'i'l nmane' Dab'i, tzaj tq'o'na tze k'ute te tu'n tjaw b'inchet jun tja te kawb'il jatu'n ttena'. <verse number="4" style="v" />Ayintzunwe' kjawil nb'incha'ne' jun tja Qdyose', tu'n ttz'e'yset k'ok'sb'il te ninb'ilte, tu'n kykub' txolb'etju' wab'j kukxju' twitz ex tu'n tkub' q'et chojb'il k'oksb'il twitz te prim ex qale, ex kyoju' q'ij te ojlab'l, ex ninq'ij te ak'a'j xjaw, ex kyoju' txqantl ninq'ij nche ik'set kukxju' toj Israel te ninb'ilte Qdyose'. <verse number="5" style="v" />Niminju' tja Dyos kjawil nb'incha'ne', qu'n nimxi'x toklenju' Dyos inqo k'ulune' te kyekywitz kykyaqil dyos. <verse number="6" style="v" />Naqtzun aju', ¿alkye jaku' jaw b'inchante jun tja Dyos, nimxi'xpena'ju' kya'j extzun lay b'ent tten toj? ¿Ti'xi'xtzunwe' woklen tu'n tjaw nb'incha'ne' jun tja, maskyepe' naq tu'n tz'e'yset sturak te ninb'ilte? <verse number="7" style="v" />Qu'mtzun smantza jun xjal b'a'n tz'aq'unan kyi'j q'anpwaq, saqpwaq, q'anku'xb'il ex k'uxb'il, ex kyi'j xb'alun chukchaq che ka'yin. Ex b'a'n b'inchan tilb'ilal tu'n tzqub' tu'ntzun toni'n kyuky'i'lju' xnaq'tzal nche ajb'en weye' toj Juda ex Jerusalen, aye' eb'jo'ktq'o'n nmane' Dab'i. <verse number="8" style="v" />Ex smantza tze weye': k'ute, tzis ex sandalo toj Lib'ano, qu'n b'i'n wu'ne' b'a'n che jon tzeju' xjal ate' tjaq' tkawb'ila toj Lib'ano. Che onilkye' nmajine' kyi'ju' tmajina <verse number="9" style="v" />tu'n kyb'inchante txqan tze, qu'n niminju' ja kjawil nb'incha'ne' ex tb'anilxi'x. <verse number="10" style="v" />Na'nku'ya, kxe'l nq'o'ne' junk'al wuqnaq lajmutx' (4,400,000) litr triy, ex kyinx seb'adju', kab'naq o'lajmutx' (440,000) litr b'in ex txqantl litr aseyt, kyeju' taq'unala ex kyeju' che jolteju' tze.</para>
  <para style="p">
    <verse number="11" style="v" />Tzajtzun t-sma'n Iram, nimaqkawil toj Tiro, jun u'j te Salomon, intoq tma'n ikjalu: Matz'okq'o'na nimaqkawil kye aj Israel tu'n Qman Dyos, qu'n intk'u'jla'nju' ttanam, chij. <verse number="12" style="v" />Ex intoq tma'ntl: ¡Nimanjtzxwitju' Qman Dyos inche k'ulun aj Israel te, ju' b'inchante kya'j ex tx'otx', qu'n matzaj tq'o'n jun tk'walu' nimaqkawil Dab'i atixi'x tnab'l, xnaq'tza'n ex inximan, kjawil tb'incha'n jun ja te Qman Dyos ex jun tja te kawb'il! <verse number="13" style="v" />Qu'mtzun kxe'l nsma'ne' xnaq'tzal Iram teya, jun ichan japumnixi'x tij ex ati tnab'l. <verse number="14" style="v" />Tal jun qya kyxolju' tyajajil Dan ex tk'wal jun xjal aj Tiro. B'a'n tz'aq'unan ti'j q'anpwaq, saqpwaq, q'ank'uxb'il, k'uxb'il, ab'j, tze, ti'j xb'alun kyeq smo'n tk'i' cha'x ex morad, sed ex xb'alun kyeq, ex tu'n tb'inchet tkyaqil tilb'ilal tu'n tz'qub', ex inb'ent tb'inchante tkyaqil tilb'ilal qa matxi' qanet te, tu'n tb'inchante kyuky'i'lju' t-xjala ati b'a'n kyu'n ex kyuk'i'lju' intoq che ajb'en te taye Dab'i ju' tmana. <verse number="15" style="v" />Qu'mtzun, nimaqkawil, smantzju'ya triy, seb'ad, aseyt exju' b'in xtmaya tu'n ttzaj tq'o'na. <verse number="16" style="v" />Akxtzun in qjonju'ye' tze toj Lib'ano tkyaqilju' k'ajb'el teya, kb'ajel qk'lo'ne' ex kxel qi'ne' tib'aj ninnjab' tu'n tpon tzmax ttzi ninnjab' toj tnam Jope. Atzuntlta kxe'l q'inte tu'n tpon Jerusalen, chi Iram toj u'j.</para>
  <para style="p">
    <verse number="17" style="v" />Tchaq'tzun Salomon tu'n tjaw kyajlal kykyaqilju' najchaq xjal najlqe'toq kyxol aj Israel, ti'jxi'xtlju' jawni tu'n Dab'i ju' tman, ate'toq b'eljlajmutx' kab'k'al lajnaq (153,000) kyb'aj elyal. <verse number="18" style="v" />Kxoltzun ja'lu, e'oktq'o'n wajxaqmutx' o'lajk'al (70,000) iqal, lajmutx' (80,000) pa'l ab'j twi' witz, atzun b'eljojk'al (3,600) ka'yil aq'untl, tu'n kyokten chq'olkyeju' xjal tu'n kyaq'unan.</para>
  <chapter number="3" style="c" />
  <para style="s1">Tchaq' Salomon tu'n tjaw b'inchet tja Dyos</para>
  <para style="r">(<ref loc="1KI 6:1-38">1 R 6.1-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tchaq' Salomon tu'n ttzyet tb'inchetju' tja Dyos toj Jerusalen twi' witz Morya, jakub' tyek'u'na'tib' Qman Dyos twitz Dab'i ju' tman, toju' najb'il jyo'ntltoq tu'n Dab'i, ja intoq triyina' Ornan, ju' aj Jeb'u. <verse number="2" style="v" />Tzyet tb'inchetju' tja Dyos toj tkab' q'ij teju' tkab' xjaw te tkyaji'n ab'q'i nkawin.</para>
  <para style="p">
    <verse number="3" style="v" />Aye' echb'ente tq'uqlil tja Dyos ja'lu kub' tq'o'n Salomon: junaq wuq (27) metr tnuqub', atzun b'eljoj metr twitz. <verse number="4" style="v" />Atzu'n koredor twitzju' tja Dyos, b'eljoj metr tnuqub', kse'nx twitzju' tja Dyos, ex b'eljoj metr twe'. Tchaq' Salomon tu'n tb'ajktxet tojile tu'n qa'npwaqxi'x, <verse number="5" style="v" />ex tchaq' tu'n tb'aj kyktxu'n tojileju' ja nim toklen tu'n tz'lantzaj, tib'ajxi'tzuntl okktxu'n tu'n tb'anil q'anpwaq, ex b'ajkub' kyb'incha'n tilb'ilal tut ex xpatx'k'uxb'il etzniqe'ten, <verse number="6" style="v" />ex tchaq' tu'n tb'aj wiqo'n kyuk'i'l tb'anil ab'j. Tb'anilxi'xju' q'anpwaq ajb'en kyu'n. <verse number="7" style="v" />Tchaq' tu'n tb'aj kyktxu'n toj tkyaqilju' jatu'n q'anpwaq: e'ptzo'n, exqe' nunb'ral, e'tapi exqe' tjpel, ex e'ok kyb'incha'n kyilb'ilal kyerb'in kywitzju' tapi.</para>
  <para style="p">
    <verse number="8" style="v" />Expe' tchaq' tu'n tjaw b'incha'nju' mqo'n xjanxi'x tojxi'. B'eljoj metr tnuqub', kse'nx twitz tja Dyos, ex b'eljoj metr ttx'u'k. Ex tchaq' tu'n tb'aj ktxu'n tu'n q'anpwaq tb'anilxi'x, ch'inxmi junk'al kab'naq (440) kyintal q'anpwaq b'aj ti'j. <verse number="9" style="v" />Masch'i'n jun lib'r kyalal junjun klawẍ. Ex eb'aj kyktxu'nju' mqo'n te tkab' kol tu'n q'anpwaq.</para>
  <para style="p">
    <verse number="10" style="v" />Tchaq' tu'n kykub' b'incha'n kab'e' tilb'ilal kyerb'in toju' mqo'n xjanxi'x, ex eb'aj ktxu'n tu'n q'anpwaq. <verse number="11" style="v" />Te b'eljoj metr kynuqub' kyxik'ju' kyerb'in lik'u'nqe'toq tkyaqil; kab'e' metr tk'i' ch'intl tliky'e jun t-xik'u' jun, intoq pon kanun twitzju' ttapiyilu' mqo'n, ex kyinxtoq juntl t-xik'ju', intoq pon kanun ti'j ttxa'n t-xik'ju' juntl kyerb'in. <verse number="12" style="v" />Ikxtzu'n, kyinx tliky'e jun t-xik' juntl kyerb'inju', kse'nqe' t-xik'u' jun, intoq pon kanun jun twitzju' ttapiyilju' mqo'n, exju' juntl t-xik', kyinx tnuqub'ju', ntoq pon kanun ttxa'n t-xik'ju' tnejel kyerb'in. <verse number="13" style="v" />B'eljoj metr tnuqub' kyxik'ju' kyerb'in lu tu'n tkyaqil, wa'lqe'toq intoq che ka'yinx tu'me'lju' mqo'n toj nky'ajchaq. <verse number="14" style="v" />Ex tchaq' tu'n kyb'inchetju' xb'alun chukchaq che ka'yin, ex tu'n kyb'inchet kyilb'ilal kyerb'in toj.</para>
  <para style="s1">Aye' kab'e' tqan tilb'ilal</para>
  <para style="r">(<ref loc="1KI 7:15-22">1 R 7.15-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" />Tchaq' Salomon tu'n kyb'inchet kab'e' tqan tilb'ilal twitzju' tja Dyos, ch'inxmi qaqlajoj metr kywe'. Aye'tzu'n kyilb'ilal kywi', kab'e' metr tk'i' ch'intl. <verse number="16" style="v" />Ex tchaq' tu'n kyb'inchet xpatx'k'uxb'il kse'n u'wj, ex tu'n kyb'jo'k q'o'n tzma toj kywi'ju' tqan; ex b'inchet jo'naq (100) tilb'ilal maẍlob'j ex eb'jo'k q'o'n kyi'j xpatx'k'uxb'il. <verse number="17" style="v" />Tchaq' tu'n kykub' q'o'nju' tqan lu twitzju' tja Dyos, jun toj tb'a'nq'ob' atzun juntl toj tnayaj. Aju' tqan toj tb'a'nq'ob' oktq'o'n tb'i Jakyin, atzu'n toj tnayaj oktq'o'n tb'i B'oas.</para>
  <chapter number="4" style="c" />
  <para style="s1">Ti'xti' e'ajb'en toj tja Dyos</para>
  <para style="r">(<ref loc="1KI 7:23-51">1 R 7.23-51</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Ex tchaq' Salomon tu'n tkub' b'inchet jun q'olb'eb'l q'ank'uxb'il, b'eljoj metr tnuqub' ex b'eljoj metr twitz, atzun kyaje' metr tk'i' niky'jan twe'. <verse number="2" style="v" />Ex tchaq' tu'n tkub' b'incha'n jun nin pil q'ank'uxb'il tkb'elju' a'. Tolintoq, kyaje' metr tk'i' nik'jan (4.5 m.) twitz txi'x jun plaj ex ponx jun plajtl. Kab'e' metr tk'i' ch'i'ntl (2.25 m.) twe', atzun oxlajoj metr tk'i' nik'jan (13.5 m.) ttole ttziyile. <verse number="3" style="v" />Ate'toq kab'e' txol tilb'ilal naku'j tman wakxqe' tjaq'ile ttziju' pil ti'jile, lajoj toj kakab'naqjo' (45 cm.) chaq sentimetro, jun tnejx elna'qe' tuk'i'lju' pil. <verse number="4" style="v" />Tkub' toqju' pil kyib'aj kab'lajoj (12) tman wakx q'ank'uxb'ilqe', oxe' tman wakx nche ka'yinx toj tb'a'nq'ob'kya'j, oxe' toj tnayajkya'j, oxe' toj tjawetzq'ij ex oxe' toj tkub'exq'ij. E'kyajtenju' kyqan kytze'lkyi'j tojxi' ex atkub'toqju' pil kyib'aj. <verse number="5" style="v" />Wajxaq sentimetro tpimal ttapiyilju' pil; ikytoq ttziyileju' kse'n tb'echil jun b'ech liryo, wajxaqmutx' jok'al (66,000) litr a' intoq b'ajx toj.</para>
  <para style="p">
    <verse number="6" style="v" />Ex tu'n kyb'inchet lajoj pil q'ank'uxb'il te tx'ajb'il, jwe' e'kub' q'o'n toj tb'a'nq'ob' ex jwe' toj tnayaj. Tkyaqiltzu'n intoq che ajb'en teju' chojb'il k'ok'sb'il nche txjet toj; atzu'n nin pil tu'ntoq kytx'ajunju' pale toj.</para>
  <para style="p">
    <verse number="7" style="v" />Ex tchaq' tu'n kyb'inchet lajoj kykb'el kantil q'anpwaqqe', kse'nxju' tz'ib'a'ntoq, e'kub' kyq'o'ntzuntz toju' tja Dyos, jwe' toj tb'a'nq'ob' ex jwe' toj tnayaj. <verse number="8" style="v" />Expe' tchaq' tu'n kykub' b'incha'n lajoj mes, ex e'kub' kyq'o'n toju' tja Dyos, jwe' toj tb'a'nq'ob' ex jwe' toj tnayaj. Ex e'kub' kyb'incha'n jonaq (100) nimaqlaq q'ank'uxb'ilqe'.</para>
  <para style="p">
    <verse number="9" style="v" />Ex tchaq' tu'n tkub' b'incha'nju' pe'n kye pale exju' pe'n nim toklen, kyuk'i'l kyjpel, eb'aj kyktxu'n tu'n q'ank'uxb'il. <verse number="10" style="v" />Tchaq'tzuntzu' tu'n tkub' q'o'nju' nin pil toj tb'a'nq'ob' tja Dyos, kyxol tnayajkya'j ex tkub'exq'ij.</para>
  <para style="p">
    <verse number="11" style="v" />Ex tchaq' Iram tu'n kyb'inchet k'wil, jotb'il ex nimaqlaq, ikytzu'n b'aja' b'enta' aq'untl tu'n te Salomon toju' tja Dyos. <verse number="12" style="v" />Aye' aq'untl ja'lu: kab'e' kyqan tilb'ilal, exqe' kyilb'ilal toli'n kyi'j, ju' ate'toq kywi', kab'e' sarant tu'n kyktxetju' kyilb'il lu, <verse number="13" style="v" />junk'al (400) kyilb'ilal maẍlob'j kyeju' kab'e' sarant, kab'e' txol maẍlob'j kye junjun sarant, ju' inche ajb'en kutxb'ilkye kyilb'ilal toli'n kyi'j toj kywi'ju' kyqan; <verse number="14" style="v" />lajoj tq'uqb'il, lajoj pil atokxtoq kyib'aj, <verse number="15" style="v" />nin pil tk'b'elju' a', kyuk'i'lju' kab'lajoj (12) tman wakx ate'kxtoq tjaq', <verse number="16" style="v" />exqe'ju' k'wil, jotb'il ex xokb'il.</para>
  <para style="p">Kykyaqilju' aq'unb'il teju' tja Qman Dyos e'kub' tb'incha'n xnaq'tzal Iram teju' nimaqkawil Salomon, q'ank'uxb'ilileqe' ex sq'ib'un. <verse number="17" style="v" />E'b'ajku'x tb'incha'n kyoj molt te tz'awun, toju' tnej tx'otx' ttzi nin a' Jordan, kyxol Sukot tuk'i'l Saretan. <verse number="18" style="v" />Tchaq' Salomon tu'n kyb'ajkub' b'inchet txqan aq'unb'il q'ank'uxb'ilileqe', ex min b'ajx tk'u'j tu'n kykub' mlo'n.</para>
  <para style="p">
    <verse number="19" style="v" />Ex tchaq' Salomon tu'n kyb'inchet tkyaqilju' txqantl aq'unb'il ate'toq toju' tja Dyos: ju' q'olb'eb'l q'anpwaq, e'mes jatu'n kykub'q'eta wab'j tu'n kyxjanset twitz Qman Dyos, <verse number="20" style="v" />e'kyb'el kantil q'anpwaqxi'x kyuk'i'lju' kykantilil ate'toq twitzju' najb'il xjanxi'x, tu'n kyk'ent kse'nxju' q'ma'ntl; <verse number="21" style="v" />ekyilb'ilal b'ech, e'kantil ex pitxb'il, ex q'anpwaqqe'; <verse number="22" style="v" />e'pitxb'il, nimaqlaq, pak' exqe' kykb'el sturak, kykyaqil q'anpwaqileqe'xi'x. Ex q'anpwaqileqe', ttziju' tja Dyos, kyxaqu' jqob'l tojxi', ttziju' najb'il xjanxi'x exqe'ju' jqob'lte tja Dyos.</para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tetzunj kyb'aj b'ent tkyaqil aq'untl tchaq' Salomon tu'n kyb'inchet toju' tja Dyos, tchaq' Salomon tu'n kyb'ajx q'i'n aq'unb'il q'anpwaq ex saqpwaq ojetoq che'x tq'o'n Dab'i, ju' tman, te Qman Dyos, e'okx k'u'ntzuntz kyoju' k'uwenj toj tja Dyos.</para>
  <para style="s1">Pon q'i'n tkaxil tyol Dyos kyejni b'entti'j toju' ja te k'u'lb'il</para>
  <para style="r">(<ref loc="1KI 8:1-11">1 R 8.1-11</ref>)</para>
  <para style="p">
    <verse number="2" style="v" />Eb'ajtzun tb'u'yi'n Salomon tijwnaq kyxol aj Israel, kykyaqilju' nejenel kye junjun tnej kyyajajil exqe' xjal nimaq kyoklen toj kyja aj Israel, toj Jerusalen, tu'n tetz kyiq'i'nju' kax k'ub'lteju' tyol Dyos kyejni b'entti'j, toj Syon, Nimttanam Dab'i. <verse number="3" style="v" />Kykyaqiltzunju' aj Israel b'aj kyb'u'yi'n kyib' tuk'i'lju' nimaqkawil Salomon toju' ninq'ij nim toklen toj twuqi'n xjaw teju' ab'q'i. <verse number="4" style="v" />Kykyaqilju' tijwnaq kyxol aj Israel eb'aj pon, jawtzun kyiq'i'n tyajajil Leb'iju' kax, <verse number="5" style="v" />xikyiq'i'ntzuntz toju' tja Dyos, junx tuk'i'lju' ja te mujb'ab'ltib'il tuk'i'l Dyos exqe'ju' aq'unb'il xjansa'nqe' ate'toq toj, iq'i'nqe'toq kyu'n pale ex aj Leb'i. <verse number="6" style="v" />Ate'toqju' nimaqkawil Salomon kyuk'i'l kykyaqilju' tnam aj Israel matxi'toq b'aj kyb'u'yi'n kyib' tuk'i'l, twitzju' kax, intoq kub' kyq'o'n txqan rit ex tman wakx te chojb'il, mixtoqti'tl nb'ent kyajlet. <verse number="7" style="v" />Yajxi'tzuntl xikyiq'i'n pale tkaxilju' tyol Dyos kyajni b'antti'j, toju' ja te k'u'lb'il, tzmax toju' najb'il xjanxi'x, kyjaq' kyxik'ju' kyerb'in, <verse number="8" style="v" />lik'u'nqe'toqu' kyxik' tib'aju' jata'toqju' kax, ktxu'ntoq tib'aju' kax kyuk'i'lxi' tqul kyu'n. <verse number="9" style="v" />Nimaqxi'toqtzun kywe'ju' tqul, q'ancha'ltoqu' kytxa'n tzmax toju' mqo'n Xjan, twitzju' Najb'il Xjanxi'x, atzu'n ti'jxi' minti' q'ancha'lqe'toq; majxtzun e'kyajten ikyju'. <verse number="10" style="v" />O'xtoqju' kab'e' tz'len ab'j atku'x toju' kax ju' ku'x tq'o'n Moyses toj, tzmax Oreb', aye' tz'len ab'j ja tz'ib'a'na'qe' tyol Qman Dyos kyejni b'entti'j kyuk'i'l aj Israel tej kyetz Ejipt.</para>
  <para style="p">
    <verse number="11" style="v" />E' b'je'tzju' pale toju' Najb'il Xjan. Matxitoq kyẍtilsa kyib' kykyaqilju' pale ate'toq ex minti' e'oklpe kse'nxju' nuk'b'enkye aj kych'exb'ente kyib'. <verse number="12" style="v" />Kykyaqilju' aj Leb'i ajb'itzalqe', aye' Asap, Eman ex Jedutun, junx kyuk'i'lju' kyk'wal ex txqantl kywitze'l, wa'lqe'toq toj tjawetzq'ij teju' q'olb'eb'l, oksa'ntoq kyi'j sed. Iq'imiletoq kychinab' txijtxij, tzintzin ex arpa. Ate'toq qaqnaq (120) pale kyuk'i'l intoq che q'ajtzan chun.</para>
  <para style="p">
    <verse number="13" style="v" />E'oktzun tentz kykyaqil junx q'ajtzalkyeju' chun ex b'itzal junx tq'ojq'ojel kywi' te ajwalb'ilte Qman Dyos ex q'ob'l chjonte te, intoq che kyq'ajtza'nju' chun, txijtxij ex junjuntl chnab', intoq kyb'itza'nxi': Kyajwali'nktze' Qman Dyos, qu'n majx b'a'nte, qu'n tejumajxju' tk'u'jlalil, chechij. Tojtzu'n kmoj lu kub' noju' tja Qman Dyos tu'n muj, <verse number="14" style="v" />ex mixti' b'entl kykyajtenju' pale b'inchalteju' k'u'lb'il tu'nju' muj, qu'n matxi'toq kub' noju' ja te k'u'lb'il tu'n tajwalil Qman Dyos.</para>
  <chapter number="6" style="c" />
  <para style="s1">Kub' tq'o'n Salomon ja te k'u'lb'il toj tq'ob' Dyos</para>
  <para style="r">(<ref loc="1KI 8:12-66">1 R 8.12-66</ref>)</para>
  <para style="q">
    <verse number="1" style="v" />Tmatzun Salomon:</para>
  <para style="q">Oje tmaya Taye</para>
  <para style="q">qa najliya toj qxopin.</para>
  <para style="q">
    <verse number="2" style="v" />Ayintzunwe' matxi' jaw nb'incha'ne'</para>
  <para style="q">jun tjaya tu'n tnajana toj,</para>
  <para style="q">jun najb'il tu'n tnajana tejumajx, chij.</para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" />Anjtzun ka'yi'n ti'ju' nimaqkawil kywitz kykyaqil aj Israel, wa'lqe'toq ex e'kub' tky'i'wla'n <verse number="4" style="v" />chij kjalu: Ajwalinjtzxwitju' Qman Dyos inqo k'ulun te, qu'n ma japunju' tyol tzaj ttziya'n te nmane' Dab'i tej ttzaj tma'n te:</para>
  <para style="pi">
    <verse number="5" style="v" />B'ajxtoq jawa' nsk'o'ne' jun nintnam kyxol kykyaqilju' tnej tyajajil Israel, atxi'x kyetzlen wiq'ine' ntaname' toj Ejipt, tu'n tjaw b'inchet jun ja te k'u'lb'il toj, jatu'n ttzaja' na'n nb'iye', ex b'ajxtoq jawa' nsk'o'ne' jun ichan te nejenel teju' ntaname' Israel, <verse number="6" style="v" />matxitzun jawnsk'o'ne' Jerusalen tu'n ttzaj na'nju' nb'iye' atzu', ex majawnsk'o'ne' Dab'i tu'n tkawinteju' ntaname' Israel, chij. <verse number="7" style="v" />Kub'tzun t-xima'n nmane' Dab'i tu'n tjaw tb'incha'n jun ja te ninb'ilte Qman Dyos janche k'uluna' aj Israel. <verse number="8" style="v" />Atzunte Qman Dyos tzaj tma'n te: B'a'nte' tu'n xkub't-xima'na tu'n tjaw tb'incha'na njaye'; <verse number="9" style="v" />naq aju' myaya kb'inchalte, jun tk'wal teju'ya kjawil b'inchanteju' njaye', chi Dyos.</para>
  <para style="p">
    <verse number="10" style="v" />Matxi'tzun japunte Qman Dyos tyol kyajni ttziya'n. Ikxi'xju' kse'n tma, matxi' chin kub' qeye' toju' q'uqb'il te kawb'il toj Israel te t-xel nmane' Dab'i ex matxi' jaw nb'incha'ne' jun tja Qman Dyos janche k'lu'na' aj Israel. <verse number="11" style="v" />Expe' matxi' tz'okx nq'o'ne' kax toj, ju' k'ub'lte tyol Qman Dyos kyejni b'entti'j kyuk'i'l aj Israel, chi Salomon.</para>
  <para style="p">
    <verse number="12" style="v" />Kub'tzun ten Salomontz twitzju' q'olb'eb'l te Qman Dyos, kywitz kykyaqilju' tnam aj Israel ex exi' tnuqpi'n tq'ob'. <verse number="13" style="v" />Atokxtoq tib'aj jun tkub'el q'ank'uxb'il, te kab'e' metr tk'i' ch'i'ntl (2.25 m.) tnuqub' ex kyinx twitzju', atzun jun metr tk'i' ch'i'ntl (1.35) twe', ju' ojetoq tchaq' tu'n tjaw b'incha'n ex tu'n tkub' q'o'n toj nky'ajchaqju' pe'n. Kub' mejetzuntz kywitz kykyaqilju' tnam aj Israel, ex eb'jaw tq'o'n tq'ob' twitz kya'j. <verse number="14" style="v" />Tmatzuntz: Nman Dyos: mixti' juntl Dyos twitz kya'j ex twitz tx'otx' kse'n aya, in japunju' tyola nkyaj b'entti'j tu'na ex intzaj tyek'u'na t-xtalb'ila kyeju' nche ajb'en tu'n tkyaqil kyk'u'j teya; <verse number="15" style="v" />matxi' japunju' tyola tzaj ttziya'na te nma'ne' Dab'i, tzaj tma'na ex ma japun tu'na toju' q'ij ja'lo. <verse number="16" style="v" />Qu'mtzun, Taye, ex japunxju' tzaj ttziya'na te tmajina Dab'i, ju' nmane', tu'na: qa k'okyixqe jun tyajajil kukxju' toju' q'uqb'il te kawb'il toj Israel tu'nelju' t-xtalb'ila, qama che anq'inju' tk'wal b'a'n exqa ma japunju' tkawb'ila kyu'n, kse'nxte japun tu'n. <verse number="17" style="v" />Ixkwittzu'n Nman Dyos, b'inchama tu'n tapunju' yol tzaj ttziya'na teju' tmajina Dab'i, ju' nmane'.</para>
  <para style="p">
    <verse number="18" style="v" />Naqtzun aju' ¿ma axtzunlo taye qa kb'entel tnajana kyuk'i'lju' xjal twitz tx'otx'? Naqpena'ju' kya'j niminxi'x, lay b'ent ttena toj, ¡mitzunloyate' tal ja lu xjaw nb'incha'ne' teya! <verse number="19" style="v" />Qu'mtzun Nman Dyos, tzaq'wentza nkub'sb'ile' ex nqanb'e'tze'; b'intza tq'ojq'ojel nwi'ye' ex nna'j Dyose' teya, ayine' tmajina. <verse number="20" style="v" />Ka'yintzu'ya ja lu, q'ijtl ex qonik'an, jatmaya'ya tu'n ttena. B'intza nna'j Dyose' teya tzalu, ayine' tmajena. <verse number="21" style="v" />B'inqe'tzju'ya nqanb'e'tze' ex kyqanb'e'tzju' ttanama aj Israel, aj txi' qna'na toju' najb'il lu. B'inqe'tza toj kya'j ja najla'ya, ex qo' tnajsama.</para>
  <para style="p">
    <verse number="22" style="v" />Qatzun ati jun mab'inchan myab'a'n ti'j twnaqil, exqa matxi q'ma'n te tu'n ttziyanteju' ax twitzju' q'olb'eb'l toju' ja te k'u'lb'il lu, <verse number="23" style="v" />b'intza tzmax toj kya'j ex tzaq'wentza; b'inchama tnik'alilti'j kyeju' tmajina. Tz'e'ysanku'ya twitzju' ati til, tu'n tchjonteju' tb'inchb'aj myab'a'n, atzu'n mixti' til b'inchama tnik'alilti'jte, kse'nxju' nojqelan te.</para>
  <para style="p">
    <verse number="24" style="v" />Qatzun makub'ti'ju' ttanama kyu'n tajq'oj tu'n tpaju' kyil twitza, extzunqa majaw kyajwali'ntlju' tb'iya ex mache kub'san teya toj kyna'j Dyos toju' ja lu, <verse number="25" style="v" />b'intza tzmax toj kya'j, najsanku'ya kyil, ex iq'inqe'tz jumajtla toju' tx'otx' xitq'o'na kye ex kyeju' kyyajilb'en.</para>
  <para style="p">
    <verse number="26" style="v" />Qa minti' xkub' jb'al tu'n tpaj mache b'incha'n ilju' ttanama twitza, extzun qama che k'ulun teya toju' najb'il lu, ex majawkyajwali'n tb'iya exqa matz'anjtzti'j kyanmi tu'n tpaju' kyil ajtkub' ttz'e'ysa'na kywitz, <verse number="27" style="v" />b'inqe'tza tzmax toj kya'j ex najsanku'ya kyilju' tmajina ex kyilju' ttanama aj Israel, ex yek'unxa b'a'n b'e kye tu'n kyb'et toj. Q'ontz tzuna jb'al twitzju' tx'otx' lu, ju' tzaj tq'o'na te kyetzb'ilju' ttanama.</para>
  <para style="p">
    <verse number="28" style="v" />Qatzun matzaj we'yaj toju' tx'otx', mo tx'u'j yab'il, mujqa mache kub' tzqiju' awal tu'n kyaq, mo matz'ok soj kyi'j, mo yajb'il kyu'n ẍt'ikt'u'l mujqa juntl ttxkuplal; qama tz'ok kytxoli'n kyib'u' ajq'oj kyi'ju' nimaq qtaname' exqa mache oktzaqpaj q'ojil kyi'j, mujqa matzaj alkyexku' yajb'il mo yab'il, <verse number="29-30" style="v" />b'intzju'ya na'j Dyos mujqa kub'sb'il makyb'incha alkyexku' xjal mujqa tkyaqilju' ttanama aj Israel, ajkylonte xitb'il ex k'ixk'oj kyi'j, qama jawkyiq'i'n kyq'ob' toj kyna'j Dyos toju' ja te k'u'lb'il lu. B'inqe'tza tzmax toj kya'j, ja najla'ya ex najsanku'ya kyil; q'ontza tu'me'l t-xel teyile junjun kse'nxju' kyb'inchb'aj, qu'n o'kxa ojtzqilte kyxim xjal ex kyanmi. <verse number="31" style="v" />Che nimaltzuntz ex che b'il teya toju' kychwinqlal twitzju' tx'otx' tzaj tq'o'na kyeju' ojtxi' qyajilb'ene'.</para>
  <para style="p">
    <verse number="32" style="v" />Expe' jun najchaq xjal, jun mya ttanama, qama tzaj kyoj najchaq tx'otx' naqx tu'nelju' tb'iya nimxi'x toklen ex nimtipumala, exqa matzaj na'na tu'n toju' ja te k'u'lb'il lu, <verse number="33" style="v" />b'intza tzmax toj kya'j ja najla'ya, ex q'ontza te tkyaqilju' kxe'l tqani'n teya, tu'ntzun tojtzqinjtza ex tu'n tnimanjtza kyu'n kykyaqilju' nimaqtnam twitz tx'otx', kse'n ntb'incha'nju' ttanama Israel, ex tu'n telkynik' qa aju' tb'iya ntzaj na'n toju' ja lu, xjaw nb'incha'ne' teya.</para>
  <para style="p">
    <verse number="34" style="v" />Aj texju' ttanama q'ojil kyi'ju' tajq'oj, jaxjaku' matxa' tchq'o'na, qama tzaj na'na kyu'n tu'me'lju' nintnam xjaw t-sk'o'na lu ex tu'me'lu' ja xjaw nb'incha'ne' teya, <verse number="35" style="v" />b'intza kyna'j Dyos ex kykub'sb'il tzmax toj kya'j, che tkloma kye kyajq'oj.</para>
  <para style="p">
    <verse number="36" style="v" />Qatzun mache b'inchan il twitza, qu'n mixti' jun mixwitti' nb'inchan il, qama tzaj ttx'u'jila kyi'j exqa mache'x tq'o'na toj kyq'ob' kyajq'oj tu'n kyokq'o'n te majin lq'o'n ex tu'n kyxi'q'i'n toj juntl ttx'otx' nqaku' mujqa najchaq, <verse number="37" style="v" />qatzun matz'anjtzti'j kyanmi toju' tx'otx' jaẍepona' iq'i'n, exqa mache kub'san teya exqa matz'el kynik' ti'ju' kyil ex myab'a'n xkyb'incha, <verse number="38" style="v" />Qama tz'anjtzkyi'j tuk'i'la tu'n tkyaqil kyk'u'j toju' tx'otx' jamache'xa' iq'i'n toj jitz'jtib'il, exqa mache na'n Dyos tu'me'lju' tx'otx' saj tq'o'na lu kyeju' kyyajilb'en, ex tu'me'lju' nintnam jaw t-sk'o'na, ex tu'me'lju' tjaya xjaw nb'incha'ne', <verse number="39" style="v" />b'intzju'ya kyna'j Dyos ex kykub'sb'il tzmax toj kya'j ja najla'ya, najsanku'ya kyilju' ttanama twitza ex klonqe'ma kyeju' kyajq'oj.</para>
  <para style="p">
    <verse number="40" style="v" />Nman Dyos, b'inqe'tzju'ya na'j Dyos ajkyok toju' najb'il lu.</para>
  <para style="b" />
  <para style="q">
    <verse number="41" style="v" />Iq'i'nktz tib'a Nman Dyos, tuk'i'lju' tkaxa nimtipumal,</para>
  <para style="q">ex kuttzaja jak'ojlala'ya.</para>
  <para style="q">Nman Dyos, tz'okxwit kyoksa'n pale twitza kolb'il kyi'j,</para>
  <para style="q">che tzalajxwitju' nche niman teya toju' q'inumal.</para>
  <para style="q">
    <verse number="42" style="v" />Taye, lalun chin eltik'o'na, ayine' nimaqkawil njaw t-sk'o'na.</para>
  <para style="q">Na'ntza tk'u'jlalila ti'j Dab'i, ju' tmajina, chi nimaqkawil Salomon toj tna'j Dyos.</para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tetzunj tb'aj na'n Dyos Salomon, ku'tz q'aq' toj kya'j ex b'aj ttz'e'ysa'nju' chojb'il k'ok'sb'il exqe' chojb'il, ex kub' noju' ja te k'u'lb'il tu'n tajwalil Qman Dyos, <verse number="2" style="v" />qu'mtzun min b'ent kyokxju' pale toj. <verse number="3" style="v" />Tetzunj kyka'yinte kykyaqil aj Israel q'aq' exju' tajwalil Qman Dyos nche kb'u'l tib'aju' ja, e'kub' meje majx ku'punju' kyplaj twitz tx'otx' ja txoli'na' ab'j twitz, ek'ulun ex e'q'on chjonte te Qman Dyos, kukxtoq kymanteju': Qu'n majx b'a'n te, qu'n tejumajxju' tk'u'jlalil, chechij.</para>
  <para style="p">
    <verse number="4" style="v" />Tb'ajlenxi'tzun ja'lu, kub' kyq'o'n nimaqkawil ex kykyaqilju' tnam chojb'il twitz Qman Dyos. <verse number="5" style="v" />Kab'mutx' o'lajk'al (22,000) wakx ex o'lajmutx' (120,000) rit b'ajkub' tq'o'n Salomon te chojb'il.</para>
  <para style="p">Iktzu'n xjanseta' tja Dyos tu'n nimaqkawil kyuk'i'l kykyaqilju' aj Israel.</para>
  <para style="p">
    <verse number="6" style="v" />Ate'toqtzu'nkye' pale toju' kyaq'un exqe' tyajajil Leb'i kyuk'i'lju' kychinab' xjansa'nqe' matxi'toq che kub' tb'incha'n nimaqkawil tu'n kyq'ajtzet toju' b'itz intma'n: Qu'n tejumajxju' tk'u'jlalil, tej intoq tb'itza'n Dab'i kyuk'i'l. Intoq kyq'ajtza'n paleju' chun kywitz, tej wa'lqe'toqju' aj Israel.</para>
  <para style="p">
    <verse number="7" style="v" />Ex kub' t-xjansa'n Salomon toj nky'ajchaqju' pe'n twitzju' tja Qman Dyos, qu'n atzu' e'kub'tq'o'na'ju' chojb'il k'ok'sb'il ex ky-untilju' chojb'il te mujb'ab'ltib'il, qu'n mixtoqti' nche b'ajxju' chojb'il k'ok'sb'il e'oyaj twitz awal k'ok'e'kywitz ex ky-until, tib'aju' q'olb'eb'l q'ank'uxb'il ojetoq tchaq' tu'n tjaw b'incha'n.</para>
  <para style="p">
    <verse number="8" style="v" />Kub' tik'sa'n Salomon kyq'iju' pach t-xaq tze toju' tq'ijlalil lu kyuk'i'l kykyaqil aj Israel, nimxi'xtoq txqan kyb'aj, e'tzajx ttzi Amat, ponx ttziju' a' toj Ejipt. <verse number="9" style="v" />Tetzun jun q'ijtel kub'kyik'sa'n jun ninq'ij nim toklen, qu'n wuq q'ij kub'kyik'sa'n tej t-xjansetu' q'olb'eb'l ex kub'kyik'sa'n wuq q'ijtlju' kyq'ij pach t-xaq tze. <verse number="10" style="v" />Tojtzun junaq oxe' (23) q'ij teju' twuqi'n xjaw, xitma'n nimaqkawil kyeju' tnam xjal tu'n kyb'aj anj kyja toj tzalajb'il tu'nju' b'a'n matxi'toq tb'incha Qman Dyos te Dab'i, te Salomon ex kyeju' ttanam aj Israel.</para>
  <para style="s1">Kyej b'entti'j tyol Qman Dyos tuk'i'l Salomon</para>
  <para style="r">(<ref loc="1KI 9:1-9">1 R 9.1-9</ref>)</para>
  <para style="p">
    <verse number="11" style="v" />Tetzunj tb'aj b'entju' tja Qman Dyos tu'n Salomon, exju' tja nimaqkawb'il ex tkyaqilju' tma tu'n tb'inchante kyoj eb'aj b'entile b'a'n, <verse number="12" style="v" />kub' tyek'u'ntib' Qman Dyos twitz toj qonik'an ex tzaj tma'n te:</para>
  <para style="pi">Matxi' nb'iju'ye' tna'j Dyosa, ex matxi' jawnsk'o'ne' najb'il lu tu'n tok te ja te k'u'lb'il, jatu'n kykub'q'eta chojb'il. <verse number="13" style="v" />Ikytzu'n, qama kub' njpu'ne' kya'j tu'n lalun tzaj jb'al, mujqa mache tzaj nchq'o'ne' ẍt'ikt'u'l tu'n tb'aj kyyajla'nju' twitz tx'otx', mujqa matzaj nq'o'ne' jun tx'u'j yab'il tib'aju' ntaname', <verse number="14" style="v" />qatzun makub' kyme'ssa'n kyib'u' ntaname' inche tzaj na'nte nb'iye', qama chin tzajkyna'ne', qama che jyon wi'je' ex min ẍeb'inchantl taq'wix, che tzajel nb'i'ne' tzmax toj kya'j, kb'el nnajsa'ne' kyil ex che jawil b'ent jumajtl toju' kytx'otx' wu'ne' kse'n tnejel. <verse number="15" style="v" />Kxe'l qex ja'lo, ktzajel nb'i'nju'ye' kyna'j Dyos k'okyel toju' najb'il lu, <verse number="16" style="v" />qu'n majawnsk'o'ne' ex makub' nxjansa'ne' ja te k'u'lb'il lu jatu'n ttzaja' na'nju' nb'iye' tejumajx. Knxq'uqi'ye' ex kb'el nna'ne' kukxju'. <verse number="17" style="v" />Atzu'n ja'lo, qama tz'anq'ina nwitze' kse'n Dab'i ju' tmana, qa mache'x tb'i'ncha'na tkyaqilju' xinma'ne' teya, exqa mache'x tb'i'na nkawb'ile' ex nnuk'b'ile', <verse number="18" style="v" />knkuwsa'ye' tkawb'ila, kse'nxju' kyej b'entti'j wu'ne' tuk'i'l Dab'i ju' tmana, tej nmanteye' te qa che kawilju' tyajajil kukxju' tib'aj Israel. <verse number="19" style="v" />Qatzun matz'el kypa'n kyib'e' wi'je', exqa min ẍe'x kyb'incha'ne' nkawb'ile' ex nchaq'b'ile' ẍe'x nq'o'ne' kyeye', qa xi' ẍe ajb'ena'tle' ex xi' ẍe k'uluna'tle' kye junxi'tl dyos, <verse number="20" style="v" />che elex nxla'ja'ne' twitzju' tx'otx' xinq'o'ne' kyeye', ex k'elel wik'o'nju'ye' ja matxi' kub' nxjansa'ne' lu, ex k'okyel te xmayb'il kyxol kykyaqilju' nimaqtnam. <verse number="21" style="v" />Atzunju' ja lu, ju' tb'anilxi'xtoq, naq tik'lenxtl kyjelten, kykyaqiltzunju' che ik'el tk'etz che jawil lab'ti ex che xjelul tiqu'n xtb'inchaya' Qman Dyos ja'lu ti'ju' tx'otx' lu ex ti'ju' ja te k'u'lb'il lu. <verse number="22" style="v" />Kxe'l tzaq'we'ntzuntz kye, qa tu'n tpaj makyej kykolb'e'n Qman Dyos Kydyos ojtxi' kyyajilb'en, ju' etz iq'inkye toj Ejipt, ex tu'n tpaj okten kywitz tu'n kyk'ulun ex tu'n kyajb'en kye txqantl dyos; qu'mtzun saja' tq'o'na' nin taq'wix lu kyib'aj, chi Qman Dyos.</para>
  <chapter number="8" style="c" />
  <para style="s1">Txqantl taq'un Salomon</para>
  <para style="r">(<ref loc="1KI 9:10-28">1 R 9.10-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tb'ajlenxi' junaq (20) ab'q'i tjawlen tb'incha'n Salomon tja Dyos exju' tja nintkawb'il, <verse number="2" style="v" />tchaq'tzuntz tu'n kyb'jaw b'incha'n jumajtlju' nimaqtnam ojetoq che'x tq'o'n Iram te, ex e'kub' tq'o'n aj Israel kyoj.</para>
  <para style="p">
    <verse number="3" style="v" />Yajxi'tzuntl xi' q'ojil ti'j Amat toj Sob'a, kub'ti'j tu'n ex kub' ttzyu'n. <verse number="4" style="v" />Ex tchaq' tu'n tjaw b'incha'ntlju' Tadmor, toj chq'ajlaj, ex kykyaqilju' nimaqtnam janche tk'u'na'toqju' wab'j, ojetoq tchaq' tu'n kyjaw b'incha'n toj Amat. <verse number="5" style="v" />Ex ikx tchaq' tu'n kyjaw b'incha'ntlju' nimaqtnam B'et-oron jawtl ex B'et-oron kub'l, kuwsa'nqe' tu'n nimaqtapi, tjpel ex k'uxb'il xtanb'ilkye, <verse number="6" style="v" />ex tchaq' tu'n kyjaw b'incha'ntlu' B'aalat exqe' txqantl nimaqtnam janche tk'u'na'toqju' wab'j, kykyaqilju' ja k'ub'lkye karwaj te q'oj, exqe' kyja chej te q'oj, ex tkyaqilju' kub' t-xima'n tu'n tb'inchante toj Jerusalen, toj Lib'ano ex toj tkyaqilju' tx'otx' jatoq nkawina'. <verse number="7" style="v" />Najliqe'xtoqtzun xjal mya aj Israelqe' toju' tx'otx', junjun itit, amorey, eb'ey, peresey ex jeb'usey. <verse number="8" style="v" />Aye' kyyajajilju' nimaqtnam min e'kub' kyb'ajsa'n aj Israel, e'okchq'o'ntzuntz tu'n Salomon aq'unal kuwxi'x te lq'o'n majin, ex axtoq nkyb'incha'nju' tej tkub' tz'ib'a'n u'j lu. <verse number="9" style="v" />Aye'tzu'n aj Israel min e'oktchq'o'n Salomon aq'unal kuw kse'nqe' lq'o'n majin, aye'kye eb'jo'k q'o'n te xjal te q'oj, ajb'el te nimaqkawil, nejenel ex chaq'ul, aj chejil ex q'il karwaj te q'oj. <verse number="10" style="v" />Kab'lajnaq lajoj (250) kyb'aju' ka'yil aq'untl e'oktq'o'n nimaqkawil Salomon.</para>
  <para style="p">
    <verse number="11" style="v" />Etztiq'i'n Salomonju' tmyal Paraon toj Ninttanam Dab'i ex pon tiq'i'n toju' ja te kawb'il matxi'toq jawtb'incha'n te, qu'n kub' t-xima'n qa laytoq b'ent tnajanju' t-xu'jil toju' tja Dab'i te kawb'il, kynimaqkawil aj Israel, qu'n xjansa'nqe'toqju' tenb'el ja okxa' q'o'na' tkax Qman Dyos.</para>
  <para style="p">
    <verse number="12" style="v" />Intoq che kub' tq'o'n Salomon chojb'il k'ok'sb'il twitz Qman Dyos tib'aju' q'olb'eb'lte ojetoq tchaq' tu'n tjaw b'incha'n twitzju' tilb'ilal tpenju' ja te k'u'lb'il, <verse number="13" style="v" />kyoju' q'ij tu'n t-xa'q'eta', kse'nx tkawb'il Moyses, aye' q'ij te ojlab'l, tq'ij ak'a'j xjaw ex kyoju' oxe' ninq'ij nche ik'set toj ab'q'i: kyeju' wab'j mixti' ttx'amal, kyeju' sman ex kyeju' pach t-xaq tze.</para>
  <para style="p">
    <verse number="14" style="v" />Ex e'kub' tnk'u'nju' pale tu'n kych'exb'ente kyib' toju' kyajb'eb'l, kse'nx tma Dab'i, ju' tma'n, tu'n kyb'inchante pale kyajb'eb'l, aye'tzu'n aj Leb'i, tu'n kyajwalinte Qman Dyos ex tu'n kyonin kyuk'i'lju' pale, kse'nxju' in ojqelan junjun q'ij. Ex e'kub' tnk'u'nju' xq'uqil ttzi junjun tjpel ja, tu'n kych'exb'ente kyib', qu'n iku' kyejtma'n Dab'i, tmajin Dyos. <verse number="15" style="v" />Ikytzu'n, minti' elkypa'n kyib' ti'ju' tchaq'b'il nimaqkawil Dab'i, ju' ntma'n kyi'ju' pale, aj Leb'i ex k'ub'l pwaq. <verse number="16" style="v" />B'ajb'ent tkyaqilju' atitoq tu'n tb'inchante Salomon, tzajx toju' q'ij tej kykub' tq'uqlilju' tja Dyos ex japunb'aj tkyaqil. Kyej b'entju' tja Dyos b'a'nxi'x.</para>
  <para style="p">
    <verse number="17" style="v" />Xi'tzun Salomontz toj Esyon-keb'er ex toj Elat, ttzi ninnjab', toju' tx'otx' te Edom. <verse number="18" style="v" />Atzunte Iram e'tzaj t-sma'nju' tmajin tk'etz Salomon kyuk'i'l b'ark, e'xjal b'a'n che aq'unan toj ninnjab', aye'tzun exi'ju' kyuk'i'l tmajin Salomon toj Opir, jatzaja' kyiq'i'na' qapelo qaqlajnaq lajoj (330) kyintal q'anpwaq teju' nimaqkawil Salomon.</para>
  <chapter number="9" style="c" />
  <para style="s1">Ulju' qya nimaqkawil toj Sab'a xb'etzalte Salomon</para>
  <para style="r">(<ref loc="1KI 10:1-13">1 R 10.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tb'itzu'n qya nimaqkawil tok toj Sab'a, b'a'n tyolinjtz Salomon tu'nju' matxi'toq b'ajb'ent tu'n, pontzuntz toj Jerusalen tu'n tik'twitz ti'j kyu'n t-xjel ch'uẍqe'. Pon tuk'i'l nim toklen, kyuk'i'l kamey iqa'n k'ok'sb'il kyu'n tuk'i'l txqan q'anpwaq ex tb'anil ab'j. Tetzunj tpon twitz Salomon, b'ajx t-xjelu'n te tkyaqilju' xima'ntoq tu'n, <verse number="2" style="v" />atzunte Salomon b'ajx ttzaq'we'n tkyaqilju' t-xjel. Mixti' jun xjel mixti'wt b'ent ttzaq'wet tu'n. <verse number="3" style="v" />Tetzunj tka'yinte qya nimaqkawil aj Sab'a ju' tnab'l Salomon, exju' tja kawb'il matxi'toq jawtb'incha'n, <verse number="4" style="v" />e'wab'j tib'aju' tmes, e'mqo'n jata'qe'toqju' tmajin, ex kyka'yinkju' tmajin tuk'i'l kyi'j, exqe' b'inchal b'in tuk'i'l kyi'j, exju' aj tjawx toju' ja te k'u'lb'il, kyej lab'ti b'a'nxi'x <verse number="5" style="v" />ex tma teju' nimaqkawil: Axte' oje nb'iye' tzmax toju' ntaname' kyi'ju' tb'inchb'aja exju' tnab'la; <verse number="6" style="v" />matxitzun wokslaye' ja'lo tej ẍin nule' ex mawile' kyu'nku' nwitze'. Axxi'x, b'ajxtoqpe' tzaja' tx'olb'a'n nik'janju' txqan tnab'la weye', nimxi'xte' tnab'la kyetwitzju' ojetoq nb'iye'. <verse number="7" style="v" />¡Tzalajb'ilxlote' kyeju' t-xjala, exlo nxi'x che tzalaju' tmajina lu, ate'qe' kukxju' tk'etza b'ilkyeju' tyola tuk'i'l nab'l! <verse number="8" style="v" />¡Nimanjtzxwitju' Qman Dyos ink'uluna te, matzaj ka'yi'na tuk'i'l tzalajb'il tu'n ex makub' q'o'na tu'n toju' tq'uqb'il tu'n toka te nimaqkawil! ¡Tu'nju' tk'u'jlalil kyi'j aj Israel, ex tu'n tkuwsante tejumajx soka' q'o'na te nimaqkawil kyib'aj, tu'n tkawina toj ttzinunal ex toj tnik'alti'j! chij te Salomon.</para>
  <para style="p">
    <verse number="9" style="v" />Xi'tzun tq'o'n kyajnaq wuq kyintal tk'i' kab'lajoj lib'r (87.12) q'anpwaq teju' nimaqkawil, ex txqan k'ok'sb'il ex tb'anil ab'j. Mixti' pon txqan k'ok'sb'il toj Israel kyinju' tajlal xitoyi'n qya nimaqkawil aj Sab'a teju' nimaqkawil Salomon.</para>
  <para style="p">
    <verse number="10" style="v" />Exqepe' ichan nche ajb'en te Iram ex te Salomon, ju' e'tzaj iq'inte q'anpwaq toj Opir, ex tzaj kyiq'i'n tze Sandalo ex tb'anil ab'j te Salomon. <verse number="11" style="v" />Tchaq'ju' nimaqkawil tu'n kykub' b'incha'n maqb'il ti'ju' tja Dyos ex ti'ju' tja nimaqkawb'il kyu'n tze sandalo, e' arpa ex tzintzin kyeju' aj chinb'al. B'ajxtoq ka'yinjtza' ikju' toju' tx'otx' Juda. <verse number="12" style="v" />Atzunte' nimaqkawil Salomon, xitq'o'n tkyaqilju' tqani'nju' qya nimaqkawil aj Sab'a te, tib'ajxi'tlju' xitq'o'n te t-xelju' pon tiq'i'n te. Anjtzun ti'ju' qya nimaqkawil toju' ttx'otx' kyuk'i'lju' xjal nche ajb'en te.</para>
  <para style="s1">B'a'n tyolinjtz ex tq'inumal Salomon</para>
  <para style="r">(<ref loc="1KI 10:14-29">1 R 10.14-29</ref>; <ref loc="2CH 1:14-17">2 Cr 1.14-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Junk'al kyajnaq kyaje' (484) kyintal njapuna'ju' q'anpwaq ntoq tk'mo'n Salomon junjun ab'q'i, <verse number="14" style="v" />myatlte' chojb'il intoq kychjo'nju' nche xk'aẍlen exqe'ju' inche b'et. Expe' kykyaqilju' nimaqkawil te Arab'ya exqe' kawil toju' tx'otx', intoq tzaj kyiq'i'n q'anpwaq ex saqpwaq te Salomon. <verse number="15" style="v" />Xitq'a' b'incha' nimaqkawil Salomon lajnaq (200) q'anpwaq kolb'il nimaqqe', masch'i'n oxlajoj lib'r q'anpwaq xi' ti'j junjun. <verse number="16" style="v" />Ex xitq'a' b'incha' o'lajnaq (300) kolb'il k'ok'e', masch'i'n qaq lib'r tk'i' nik'jan q'anpwaq xi' ti'j junjun b'incha'nqe', e'okx tq'o'ntzuntz toju' ja te kawb'il tok tb'i k'ul te Lib'ano. <verse number="17" style="v" />Ex xitq'a' b'incha' jun nin q'uqb'il b'aq te kawb'il, ex tchaq' tu'n tktxet tu'n q'anpwaqxi'x. <verse number="18" style="v" />B'incha'nktoq waqaq tpeta'nilju' q'uqb'il, ex q'anpwaqju' tkub'el qanb'aj, ex ate'toq kyojlab'l q'ob'aj toj junjun plaj teju' q'uqb'il, wa'lqe'toq kab'e' b'alun kytx'u'k. <verse number="19" style="v" />Ex ate'toq kab'lajoj (12) b'alun wa'lqe'toq, junjun toj junjun kytx'u'kju' waqaq tpeta'nil. ¡B'ajxtoq jawa' b'incha'n jun toj juntl kawb'il kse'n ja'lu! <verse number="20" style="v" />Expe' kykyaqilu' tk'wab'l nimaqkawil q'anpwaq qe'toq ex kykyaqilju' aq'unb'il nche ajb'en toju' ja te kawb'il, ju' k'ul te Lib'ano tb'i. Mixti'xtoq jun b'incha'n ti'j saqpwaq, qu'n myatoq wi'yalu' saqpwaq toj tq'ijlalil Salomon, <verse number="21" style="v" />qu'n intoq che'xju' tb'ark nimaqkawil Tarsis kyuk'i'lju' ichan tmajin Iram, ex intoq che ul junmaj toj oxox ab'q'i, intoq ul kyiq'i'n q'anpwaq, saqpwaq, b'aq, maẍ ex chojpich'.</para>
  <para style="p">
    <verse number="22" style="v" />Matxixi'xtoq jawb'ent nimaqkawil Salomon toj q'inumal ex nab'l kyekywitz kykyaqilju' nimaqkawil twitz tx'otx'. <verse number="23" style="v" />Kykyaqilju' nimaqkawil twitz tx'otx' kyajb'iltoq tu'n kyka'yinte ex tu'n kyb'inteju' tnab'l tzaj tq'o'n Dyos, <verse number="24" style="v" />kykyaqiltzun intoq pon kyiq'i'n jun oyaj te atl junjun ab'q'i: e'ti'xti' saqpwaq ex q'anpwaq, e'xb'alun, e'ub'l, e'k'ok'sb'il, eb'a'nchej ex e'mul.</para>
  <para style="s1">Xk'aẍlen Salomon karwaj ex chej</para>
  <para style="r">(<ref loc="1KI 10:26-29">1 R 10.26-29</ref>; <ref loc="2CH 1:14-17">2 Cr 1.14-17</ref>)</para>
  <para style="p">
    <verse number="25" style="v" />Ate'toq lajk'al (4,000) ja, jatu'n kytena' tchej ex tkarwaj Salomon, atzun jumutx' lajk'al (12,000) xjal aj chejil te q'oj, e'kub' tq'o'n kyoju' ja kye karwaj te q'oj ex tu'n kyxq'uqin tk'etz toj Jerusalen. <verse number="26" style="v" />Nimtoq toklen Salomon kye kykyaqilju' nimaqkawil, tzajx ttziju' nin a' Ewprates pomnix toj kytx'otx'ju' pilistey ex pomnix tnqachil Ejipt. <verse number="27" style="v" />Nim txqan saqpwaq naku'j txqan ab'j ten tu'n nimaqkawil toj Jerusalen; ex txqan tze k'ute kse'nqe' tqan iw naq nche tzaj ch'iy toju' plan tx'otx'. <verse number="28" style="v" />Xi'toq nche tzaja' tchej Salomon toj Musri ex kyoj kykyaqilju' txqantl tnam.</para>
  <para style="s1">Kyim Salomon</para>
  <para style="r">(<ref loc="1KI 11:41-43">1 R 11.41-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" />Atzu'n jni'tl tqanil ti'j Salomon, tzajx tnejel ex tzmax te b'ajsb'il, tz'ib'a'n toju' kyu'jil tqanil tu'n Natan ju' t-sanjelal Dyos, ex kyoju' yol tz'ib'a'n tu'n sanjelal Ayiy ju' aj Silo ex kyoju' tz'ib'a'n tu'n Iddo ju' sanjelal, nyolin ti'j Jerob'oam, tk'wal Nab'at. <verse number="30" style="v" />Kab'naq (40) ab'q'i kawin Salomon toj Jerusalen tib'aj tkyaqil Israel, <verse number="31" style="v" />tetzunj tkyim, ku'x mqu'n toju' Ninttanam Dab'i, ju' tman. Atl Rob'oam ju' tk'wal kawin te t-xel.</para>
  <chapter number="10" style="c" />
  <para style="s1">Kub' aq'puju' kawb'il</para>
  <para style="r">(<ref loc="1KI 12:1-24">1 R 12.1-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Xi' Rob'oam toj Sikyem, qu'n matxitoq che b'ajx kykyaqilju' aj Israel atzu' tu'n tok kyq'o'n te nimaqkawil. <verse number="2" style="v" />Tb'itzu'n Jerob'oam tk'wal Nab'at, ju' atitoq toj Ejipt, ja xana'toq oq twitzju' nimaqkawil Salomon, anjtztzun ti'jtz toj Ejipt. <verse number="3" style="v" />Tetzunj t-xitxkob'aj, e'pon Jerob'oam kyuk'i'l kykyaqil aj Israel yolil tuk'i'l Rob'oam, ex xikyma'n te:</para>
  <para style="p">
    <verse number="4" style="v" />—Kuwxi'x soka'ju' tmana qeye'; atzu'n ja'lo tz'okxta b'a'n quk'i'le', iq'imil jni'ju'ya chaq'b'il kuw xkub' tq'o'n qib'aje', qo' ajb'eltzuntze' teya, chechij te.</para>
  <para style="p">
    <verse number="5" style="v" />Atzunte Rob'oam, xittzaq'we'n kye:</para>
  <para style="p">—Kukyul jumajtle' nk'etze' oxj, chij.</para>
  <para style="p">E'b'aj anjtzun xjaltz, <verse number="6" style="v" />qanintzu'n tnab'lju' nimaqkawil Rob'oam kyeju' tijwnaq e'ajb'en te Salomon ju' tman, tej itz'xtoq. Xitqani'n kye:</para>
  <para style="p">—¿Ti' ch'i'nkye' nnab'le' ktzajel kyq'o'n tu'n txi' ntzaq'we'ne' kyeju' xjal lu? chij.</para>
  <para style="p">
    <verse number="7" style="v" />Aye'tzunkye xikyma'n te:</para>
  <para style="p">—Qa b'a'n kyilwiju' xjal lu tu'na exqa matb'inchaju'ya inkyqani'n ex b'a'nju' tyola aj txi' ttzaq'we'na kye, che ajb'elkye' teya kukxju', chechij.</para>
  <para style="p">
    <verse number="8" style="v" />Atzunte Rob'oam mixti' xitb'i'n kynab'lju' tijwnaq, xi'pe' xa'tqani'ntl tnab'l kyeju' ku'xun junx e'ch'iy kyuk'i'l ex intoq che ajb'en te, <verse number="9" style="v" />xitqani'n kye:</para>
  <para style="p">—¿Ti' ch'i'nkye' nnab'l ktzajel kyma'ne' tu'n txi' ntzaq'we'ne' kyeju' xjal lu, inkyqani'n weye' tu'n tel wiq'i'n jni'ju'ye' chaq'b'il kub' tq'o'n nmane' kyib'aj? chij.</para>
  <para style="p">
    <verse number="10" style="v" />Aye'tzu'n ku'xun junx e'ch'iy tuk'i'l, xikytzaqwe'n te:</para>
  <para style="p">—Ata' tzaq'wenx kyeju' xjal saj kyqani'n teya tu'n tel tiq'i'n jni'ju'ya chaq'b'il kub'ni tq'o'n tmana kyib'aj, ikjalu: Qa kuw oka' nmane' kyeye', kuw qinxi'xtlpe'we' kyetwitz; <verse number="11" style="v" />qa kub' tq'o'n jun chaq'b'il kuw kyib'aje', kuwxi'xtlwe' kb'el nq'o'n; exqa intoq che tjiku'ne' kyu'n asyalxi', ayintzunwe' che njiku'ye' kyu'n tz'u'n asyal k'uxb'il kytxa'n, chiku'ya kye, chechij.</para>
  <para style="p">
    <verse number="12" style="v" />Tojtzu'n toxi'n q'ij, e'pon jumajtl Jerob'oam kyuk'i'l tkyaqilju' tnam twitz Rob'oam kse'nxju' tma nimaqkawil kye. <verse number="13" style="v" />Atzunte' nimaqkawil Rob'oam, kuwju' tzaq'web'l xitq'o'n kye', mixti' xitb'i'nju' nab'l xikyq'o'n tijwnaq te, <verse number="14" style="v" />ax xitma'nju' kye aju' tnab'l xikyq'o'n ku'xun: qa kuwju' chaq'b'il kub' tq'o'n tman kyib'aj, kuwxi'xtltoqte kb'eltq'o'n, exqa e'jikunjtz kyu'n asyalxi' tu'n tman, atzunte kyuk'i'l tz'u'n asyal k'uxb'il kytxa'n. <verse number="15" style="v" />Mixti' exi'tb'i'n nimaqkawilju' tnam, qu'n q'ma'ntltoq tu'n Qman Dyos tu'n tb'aj ikju', tu'n tjapunju' tzaj ttziya'n Qman Dyos te Jerob'oam, tk'wal Nab'at, toj ttzi Ayiy, aj Silo. <verse number="16" style="v" />Tetzunj kyka'yinte' tnam Israel mixti' exib'i'n tu'n nimaqkawil, xikytzaq'we'n te kjalu:</para>
  <para style="b" />
  <para style="q">¡Mixti'qe' qoklen tuk'i'l Dab'i!</para>
  <para style="q">¡Min xqo' etzanqe' tuk'i'l tk'wal Jese!</para>
  <para style="q">¡Qoqe' anj qja aj Israel!</para>
  <para style="q">¡Kyka'yinxkye toj tja Dab'i kyib'! chechij.</para>
  <para style="b" />
  <para style="p">Textzunju' kmoj lu, kykyaqilxju' aj Israel eb'ajx kyja. <verse number="17" style="v" />Aye'tzu'n aj Israel najli qe'toq kyoju' nimaqtnam toj Juda, ax Rob'oam kawin kyib'aj. <verse number="18" style="v" />Tetzunj txi' tchq'o'n Rob'oam ju' Adoram, ju' intoq ka'yinte aq'untl ilxi'xti'j tu'n tb'inchet, kub' kyb'yo'n aj Israel tu'n ab'j. Lwiyxi'xtzun jaxju' nimaqkawil Rob'oam toju' tkarwaj, xi' oqtzuntz Jerusalen. <verse number="19" style="v" />Iktzu'n jawa' kyiq'inkyib'u' aj Israel kyi'ju' tyajajil Dab'i ex majxkub' kypa'n kyib'.</para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tetzunj tpon Rob'oam Jerusalen, b'aj tb'u'yi'n junaq kab'mutx' lajk'al (180,000) xjal te q'oj sk'o'nqe' kyxolju' aj Juda ex aj B'enjamin, tu'n kyq'ojin kyi'ju' aj Israel tu'ntzun ttzyunte jumajtlju' tkawb'il. <verse number="2" style="v" />Atzunte Qman Dyos yolin te Semayiy, tmajin Dyos, ex tzaj tma'n te:</para>
  <para style="pi">
    <verse number="3" style="v" />Q'manxa te Rob'oam, tk'wal Salomon nimaqkawil toj Juda, ex kye kykyaqilju' aj Israel kyyajajil Juda ex B'enjamin, <verse number="4" style="v" />qa ayine' nchin q'mante kye tu'n lalun che q'ojin kyi'ju' kytzik ex kyitz'in. Tu'n tanjkyi'j kykyaqil kyja, qu'n ikymatxi' kub' nxima'nju'ye', chi Dyos.</para>
  <para style="p">Tetzunj kyb'inteju' tma Qman Dyos kye, b'aj anjkyi'j, minti' eb'ajxtl q'ojil ti'j Jerob'oam.</para>
  <para style="s1">Jawb'ent Rob'oam</para>
  <para style="p">
    <verse number="5" style="v" />Kub'ten Rob'oam toj Jerusalen ex tchaq' tu'n kyjaw b'incha'n nimaqtnam kuwsa'nqe' toj Juda. <verse number="6" style="v" />Iktzu'n e'tkuwsaju' B'elen, Etam, Tekoa, <verse number="7" style="v" />B'et-sur, Soko, Adulam, <verse number="8" style="v" />Kat, Maresa, Sip, <verse number="9" style="v" />Adoraym, Lakyis, Aseka, <verse number="10" style="v" />Sora, Ayalon ex Eb'ron, nimaqkytanam kyyajajil Juda ex B'enjamin, nimaqtapi kyi'j. <verse number="11" style="v" />Eb'aj tkuwsa'n nimaqtapi ex e'oktq'o'n chaq'ul kyi'j, e'wab'j, aseyt ex b'in. <verse number="12" style="v" />Expe' eb'ajx tq'o'n kolb'il ex ch'ut kyoj kykyaqilju' nimaqtnam, eb'aj tkuwsa'n b'a'nxi'x. Iktzu'n, kyejten Rob'oam kyib'aj kyyajajil Juda ex B'enjamin.</para>
  <para style="p">
    <verse number="13" style="v" />Aye'tzu'n pale ex tyajajil Leb'i toj tkyaqil Israel, jaxjaku' najlqe'toq, pon kyb'u'yi'n kyib' tk'etz, <verse number="14" style="v" />kyej kykolb'e'n tyajajil Leb'iju' kytx'otx' te k'ik'leb'l ex txqantl kyetzb'il, tu'n kyb'ajx toj Jerusalen ex kyoju' txqantl najb'il toj Juda, qu'n minti' tajtl Jerob'oam exqe' t-xel yajxi'tl, tu'n kyb'inchanteju' kyaq'un twitz Qman Dyos. <verse number="15" style="v" />Sk'o'nqe'tltoqte' Jerob'oam tpale tu'n kyajb'en kyoju' ja xjan kye txqantl dyos ex kyoju' k'u'lb'il kywitz tajaw il ex kwitzju' tman wakx matxi'toq che kub' tb'incha'n. <verse number="16" style="v" />Exqepe'ju' tzaj anq'in toj kyanmi tu'n kyjyon ti'j Qman Dyos janche k'uluna'toq aj Israel, ax kyb'inchaju' kse'nkye pale ex aj Leb'i, exi' toj Jerusalen q'ol chojb'il twitzu' Qman Dyos Kydyos ojtxi' kyyajilb'en. <verse number="17" style="v" />Iktzu'n kykuwsaju' kawb'il te Juda ex e'onin oxe' ab'q'i ti'j Rob'oam tk'wal Salomon, qu'n oxe' ab'q'i e'oklpe ti'ju' tb'incha Dab'i ex Salomon.</para>
  <para style="p">
    <verse number="18" style="v" />Mje Rob'oam tuk'i'l Maalat, tmyal Jerimot, tk'wal Dab'i, ex Ab'yayil, tmyal Elyab' ex tchman Jese. <verse number="19" style="v" />E'ten oxe' kyk'wal, aye' ja'lu: Jewus, Semariy ex Saam. <verse number="20" style="v" />Yajxi'tel mje tuk'i'l Maaka, tmyal Ab'salon, aye'tzu'n tk'wal ja'lu: Ab'yam, Atay, Sisa ex Selomit. <verse number="21" style="v" />Wajxaqlajoj (18) t-xu'jil Rob'oam ten, atzun oxnaq (60) tqya, ex atoq Maaka intk'u'jla'nxi'x kyekywitzju' txqantl. Junaq wajxaq (28) tk'wal ten, atzun oxnaq (60) tmyal.</para>
  <para style="p">
    <verse number="22" style="v" />Oktq'o'n Rob'oamu' Ab'yam tal Maaka te nejenel kyeju' ttzik ex titz'in, qu'n tajb'iltoq tu'n toktq'o'n te nimaqkawil. <verse number="23" style="v" />Ximan b'a'n qu'n eb'ajx tq'o'n txqantl tk'wal kyoj tkyaqilju' kytx'otx' kyajajil Juda ex B'enjamin ex kyoj kykyaqilju' nimaqtnam tok nimaqtapi kyi'j, nim kywa xitq'o'n ex tjoy txqan kyxu'jil.</para>
  <chapter number="12" style="c" />
  <para style="s1">Kub' ttzyu'n Sisak Juda</para>
  <para style="r">(<ref loc="1KI 14:21-31">1 R 14.21-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tetzunj tkuwixju' tkawb'il Rob'oam ex tna'nte kuwtltoq, kyej ttzaqpi'n tkawb'il Qman Dyos, ex ax kyb'incha aj Israel kykyaqil. <verse number="2" style="v" />Tu'ntzunju' min e'nima'ntl te Qman Dyos, pon Sisak nimaqkawil aj Ejipt toj tjwe'yi'n ab'q'i nkawin Rob'oam, ex oktzaqpaj q'ojil ti'j Jerusalen <verse number="3" style="v" />kyuk'i'l oxk'al (1,200) karwaj te q'oj, wuqmutx' lajk'al (60,000) xjal aj chejil te q'oj ex nim txqan xjal te q'oj e'tzaj tuk'i'l toj Ejipt: aj Lib', aj Sukyen ex aj Etyopiy. <verse number="4" style="v" />Kub'kyi'ju' nimaqtnam nimaqtapi kyi'j toj Juda tu'n, ex pon tzmax toj Jerusalen.</para>
  <para style="p">
    <verse number="5" style="v" />Pontzu'n Semayiy t-sanjelal Dyos twitz Rob'oam ex kywitzju' nejenel toj Juda matxi'toq b'aj kyb'u'yi'n kyib' toj Jerusalen tu'nju' kxi'toq ttzaj Sisak, ex xitma'n kye:</para>
  <para style="p">—Chi Qman Dyos qa matxi' kyej kytzaqpi'ne', qu'mtzun che kjel tq'o'ne' toj tq'ob' Sisak ja'lo, chij.</para>
  <para style="p">
    <verse number="6" style="v" />Aye'tzu'n nejenel kye aj Israel exju' nimaqkawil elkynik' ti'j, kub' kyme'ssa'nkyib' ex kyma:</para>
  <para style="p">—¡Ax tete' Qman Dyos! chechij.</para>
  <para style="p">
    <verse number="7" style="v" />Tetzunj tka'yinte Qman Dyos matxitoq kub' kyme'ssa'nkyib', tzaj tma'n te Semayiy: Tu'nju' makub' kyme'ssa'n kyib'e' nwitze', lay che kub' nnajsa'ne', kche nkla'ye' ch'intl, ex lay tz'ajb'en Sisak wu'ne' tu'n telb'aju' ntx'u'jile' tib'aj Jerusalen; <verse number="8" style="v" />Naq aju' che kjele' tjaq' tkawb'il, k'eleltzun kynik'tze' alkye b'a'n, tu'n kyajb'ene' weye' mujqa tu'n kyajb'ene' kyeju' nimaqkawil kye txqantl nimaqtnam, chi Dyos.</para>
  <para style="p">
    <verse number="9" style="v" />Oktzaqpaj Sisak, nimaqkawil toj Ejipt, q'ojil ti'j Jerusalen ex b'ajx tiq'i'n k'uwenj toju' tja Qman Dyos ex toju' nimaq tja kawb'il. Tkyaqil b'ajx tiq'i'n, exqe'ju' kolb'il q'anpwaq tchaq' Salomon tu'n kyb'inchet. <verse number="10" style="v" />Tchaq'tzun nimaqkawil Rob'oam tu'n kyb'inchet kxelju' kolb'il q'ank'uxb'il, ex exi' tq'o'n toj kyq'ob'ju' nejenel kyeju' xq'uqil ntoq che xq'uqin ttziju' tja te kawb'il. <verse number="11" style="v" />Atltzun junjun maj ajt-xi' nimaqkawil toju' tja Dyos, intoq che'xju' xq'uqil ex intoq che'x kyiq'i'n. Ex intoq pon kyiq'i'n jumajtl toju' ja kye xq'uqil. <verse number="12" style="v" />Tu'ntzunju' kub' tme'ssa'ntib' Rob'oam, chewexju' ttx'u'jil Qman Dyos ti'j ex min e'kub' t-xitu'n tejumajx. Qu'mtzun e'tena' ti'xti' tb'anilqe' toj Juda.</para>
  <para style="p">
    <verse number="13" style="v" />Ch'iy tipumalju' nimaqkawil Rob'oam toj Jerusalen, ex xitljo'n tu'n tkawin. Tetoq kab'naq jun (41) ab'q'i tej ttzyet tkawin, ex wuqlajoj (17) ab'q'i kawin toj Jerusalen, ju' nintnam jaw t-sk'o'n Qman Dyos kyxol kykyaqilu' junjun tnej tyajajil Israel tu'n tnajan toj. Naama tb'iju' ttxu Rob'oam ex aj Amon. <verse number="14" style="v" />Myab'a'n b'aj tb'incha'n Rob'oam, qu'n min tjoy Qman Dyos tu'n tkyaqil tk'u'j.</para>
  <para style="p">
    <verse number="15" style="v" />Xi' tz'ib'a'na'qe' tqanil ti'j Rob'oam, tzajx tnejel ex tzmax b'ajsb'il, kyoju' tqanil tu'n Semayiy t-sanjelal Dyos, ex tu'n Iddo juntl sanjelal, toju' u'j ja tz'ib'ana'qe' tyajil.</para>
  <para style="p">
    <verse number="16" style="v" />Ten q'oj kukxju' kyxol Rob'oam tuk'i'l Jerob'oam. Tetzunj tkyim Rob'oam, ku'x mqu'n toju' Ninttanam Dab'i. Atl Ab'yam ju' tk'wal kawin te t-xel.</para>
  <chapter number="13" style="c" />
  <para style="s1">Tkawb'il Ab'yam toj Juda</para>
  <para style="r">(<ref loc="1KI 15:1-7">1 R 15.1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Ma'toq b'aj wajxaqlajoj (18) ab'q'i nkawin Jerob'oam, tej ttzyet tkawin Ab'yam toj Juda. <verse number="2" style="v" />Oxe' ab'q'i kawin toj Jerusalen. Mikayiy tb'iju' ttxu, tmyal Uryel aj Wib'ea.</para>
  <para style="p">E'q'ojin Ab'yam tuk'i'l Jerob'oam. <verse number="3" style="v" />Tzyet tq'ojin Ab'yam kyuk'i'l kab'naq lajmutx' (400,000) xjal te q'oj sk'o'nqe'. Atzunte Jerob'oam tb'inchatib' tu'n tq'ojin ti'j kyuk'i'l jo'naq mutx' (800,000) xjal te q'oj sk'o'nqe'. <verse number="4" style="v" />Kub'tzun we' Ab'yam twi' witz Semaraym, ju' ati toju' k'ul te Eprayin, ex xit-ẍch'i'n: ¡Jerob'oam ex kykyaqile' aj Israel, chin kyb'itze'! <verse number="5" style="v" />¿Ma mixtzunti' b'i'n kyu'ne', qa xi' xa' tq'o'na' Qman Dyos kawb'il te Dab'i ex kyeju' tyajajil tejumajx tej tkyaj b'entju' tyol mi xitjela'? <verse number="6" style="v" />Atzuntlte Jerob'oam, tk'wal Nab'at, tmajin Salomon ju' tk'wal Dab'i, jawtiq'i'ntib' ti'ju' tajaw. <verse number="7" style="v" />Ex okkymojb'a'nkyib' junjun ichan tuk'i'l, ky'ejqe' ex b'inchal taq'wixilqe', jawtzun kyiq'inkyib'tz ti'j Rob'oam tk'wal Salomon, qu'n ku'xuntoq ex mya kuw xjal. Qu'mtzun mixti' ten tipumal tu'n twe' kywitz. <verse number="8" style="v" />Atzu'n ja'lo kyajb'ile' tu'n kyq'ojine' ti'ju' tkawb'il Qman Dyos ati toj kyq'ob'u' tyajajil Dab'i, naqx tu'nju' nim txqan kyb'aje' ex ate' tman wakx q'anpwaq kyuk'i'le' ju' e'kub' tb'incha'n Jerob'oam tu'n kyokkyq'o'ne' te kydyose'. <verse number="9" style="v" />¡Mapena' che ex kyxla'ja'ne' pale te Qman Dyos, tyajajil Aaron, exqe' aj Leb'i, ex mache jawkysk'o'ne' kypaleye' kse'n nkyb'incha'n nimaqtnam nimalqe' kye txqantl dyos! ¡Alkyexku'tzun matzul xjansaltib' tuk'i'l jun tman wakx ex wuq tman rit, inok te pale kywitzju' mya dyosqe'! <verse number="10" style="v" />Atzunqe', teku'xi'x Qman Dyos nqo nimana'ye', ex b'ajxa' kyaja' qtzaqpi'ne'. Tyajajil Aaron qe'kye' pale nche ajb'en te Qman Dyos, ex tyajajil Leb'iqe' ate'x toju' kyajb'eb'l. <verse number="11" style="v" />Inkub' kyq'o'n chojb'il k'ok'sb'il ex sturak twitz Qman Dyos prim ex qale, ex inkub' kyq'o'n wab'j xjansa'n tib'aj jun mes ẍtilsa'n, ex nche okkytxqo'n kantil tkyaqil qale tu'n kyk'antl tib'aju' kykb'el kantil q'anpwaq. Nche japunqe' ntzaj tma'n Qman Dyos qu'n, aye'tzunkye' matxi' kyej kykolb'e'ne'. <verse number="12" style="v" />Qu'mtzun kyb'inku'ye', nejlite Dyos qwitze' kyuk'i'lju' tpale, ex naq tkub'qe'tlju' chun tu'n kyq'ajtzet tu'n ttzyetju' q'oj kyi'je'. Qu'mtzun, aj Israel, lalun jaw kyiq'i'n kyib'e' ti'j Qman Dyos kydyos ojtxi' qyajilb'en, qu'n lay che kanb'ane', chi Ab'yan.</para>
  <para style="p">
    <verse number="13" style="v" />Atzunte Jerob'oam matxi'toq tchaq' tu'n kyxi' jun tnej t-xjal te q'oj kyi'jxi'tl tu'ntzun kyok tzaqpaj q'ojil kytze'lkyi'jxi', e'kyajtzun ten kynimalju' t-xjal Jerob'oam te q'oj kywitzju' te Juda, aye'tzu'n exi' kyi'jxi' e'oktzaqpaj q'ojin kytze'lkyi'j. <verse number="14" style="v" />Tetzunj kyxi'ka'yin aj Juda kytze'lkyi'j, elkynik' qa che okyeltoq tzaqpaj q'ojil kyi'j kywitz ex kytze'lkyi'j. Ekub'santzuntz te Qman Dyos, aye'tzu'n pale exi' kyq'ajtza'n chun. <verse number="15" style="v" />Tetzunj kyjaw ẍch'inju' aj Juda tu'n kyxi' q'ojil, kub'ki'j Jerob'oam kyuk'i'l kykyaqil aj Israel tu'n Qman Dyos kywitz Ab'yam ex aj Juda. <verse number="16" style="v" />E'kub' oqu' aj Israel kywitzju' aj Juda qu'n exi' tq'o'n Dyos toj kyq'ob'. <verse number="17" style="v" />Nim txqan xjal e'kub' kyb'yo'n Ab'yam kyuk'i'lju' t-xjal, oxnaq kab'mutx' lajk'al (500,000) xjal te q'oj sk'o'nqe' kyxol aj Israel eb'aj kyu'n. <verse number="18" style="v" />Iktzu'n kub'a' kyi'ju' aj Israel toju' tq'ijlalil lu, aye'tzu'n aj Juda kyek'u qa kuwqe', qu'n okqe kyk'u'j ti'j Qman Dyos Kydyos ojtxi' kyyajilb'en.</para>
  <para style="p">
    <verse number="19" style="v" />Xilpe Ab'yam ti'j Jerob'oam ex b'je'l tiq'i'n nimaqtnam B'etel, Jesana ex Eprayin te kyuk'i'lxi' kykojb'il. <verse number="20" style="v" />Mixti'x kanb'et jumajtlu' tipumal Jerob'oam toju' tq'ijlalil Ab'yam. Te b'ajsb'iltzun k'ixb'sanjtz tu'n Qman Dyos, kyimtzuntz. <verse number="21" style="v" />Atzunte Ab'yam kuwix toju' tkawb'il. Kyajlajoj (14) t-xu'jil ten, junaq kab'e' (22) tk'wal, atzun qaqlajoj (16) tmyal. <verse number="22" style="v" />Xi' tz'ib'a'na' jni'tl tqanil ti'j Ab'yam ex tkyaqilju' tb'incha, toju' poq'b'ente yol tu'n Iddo t-sanjelal Dyos.</para>
  <chapter number="14" style="c" />
  <para style="s1">Tkawb'il Asa toj Juda</para>
  <para style="r">(<ref loc="1KI 15:8-12">1 R 15.8-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tetzunj tkyim Ab'yam, ku'x mqu'n toju' Ninttanam Dab'i. Atl Asa ju' tk'wal kawin te t-xel. Ten lajoj ab'q'i nak'b'il toju' tx'otx' toj tq'ijlalilju' tkawb'il.</para>
  <para style="p">
    <verse number="2" style="v" />B'a'nqe'ju' tb'inchb'aj Asa ex tz'aqli b'je'la' twitz Qman Dyos. <verse number="3" style="v" />B'je'l tiq'i'n q'olb'eb'l kye txqantl dyos tzajni q'i'nqe' najchaq, exqe'ju' najb'il xjan kywi'witz; ex eb'aj kub'tpa'nju' ab'j xjansa'nqe' exqe'ju' tilb'ilal Asera. <verse number="4" style="v" />Expe' tchaq' kyeju' aj Juda tu'n kyjyon ti'ju' Qman Dyos Kydyos ojtxi' kyyajilb'en, ex tu'n kyjapunju' tkawb'il ex tchaq'b'il kyu'n. <verse number="5" style="v" />E'b'je'l tiq'i'n ja xjan exqe' q'olb'eb'l kye txqantl dyos kywi'witz kyoj kykyaqilju' nimaqtnam toj Juda. Tentzun nak'b'iltz toju' tq'ijlalilu' tkawb'il.</para>
  <para style="p">
    <verse number="6" style="v" />Tchaq' Asa tu'n kyb'jaw b'incha'n nimaqtnam tok nimaqtapi kyi'j toj Juda, kyoju' ab'q'i atitoqu' tnam toj nak'b'il ex mixtoqti' tu'n kyxi' q'ojil, qu'n tzaj tq'o'n Qman Dyos nak'b'il kye. <verse number="7" style="v" />Xitma'n kyeju' xjal aj Juda: Che' qkuwsamu' nimaqtnam lu ex qb'inchanktz nimaqtapi kyi'jile, exqe' ja nimaq kywe' kyeju' xq'uqil tnam, e'tjpel ja kyuk'i'l xtanb'ilkye, atixku'ju' tx'otx' toj qq'ob'. Qu'n mana' qo' jyon ti'ju' Qman Dyos, ex matzaj tq'o'n nak'b'il qe kyuk'i'lju' tnam qi'jile, chiju' nimaqkawil. Qu'mtzun japun b'aju' aq'untl kyu'n.</para>
  <para style="p">
    <verse number="8" style="v" />Ate'toq junaq wuqlajmutx' lajk'al (300,000) t-xjal Asa te q'oj kyxol aj Juda, iq'i'mile kykolb'il ex kych'ut, atzun junaq o'lajmutx' (280,000) kyxol aj B'enjamin, iq'i'mile kykolb'il ex kysmaj. Kykyaqil ja'lu xjalqe' te q'oj min nche xob'. <verse number="9" style="v" />Ulju' Sera aj Etyopiy q'ojil kyi'j tuk'i'l qaqnaq jo'mutx' (1,000,000) ichan, atzun o'lajnaq (300) karwaj te q'oj, e'ponx tzmax Maresa. <verse number="10" style="v" />Etztzun Asa k'lulkye, b'aj kynk'u'n kyten tu'n kyq'ojin kyuk'i'lju' t-xjal toju' b'ya' Sepata, tk'etzu' tnam Maresa. <verse number="11" style="v" />K'uluntzu'n Asa twitz Qman Dyos, ex tma: Taye, junxte' teya tu'n tonina ti'ju' kuw mujqa ti'ju' mixti' tipumal. Qu'mtzun, ¡qo tonima, Qman Dyos, q'uqli na'qe' qk'u'j ti'ja, ex toj tb'iya xqo' ula'ye' q'ojil kyi'ju' xjal te q'oj lu! Taye, teya inqo nimana'ye'. ¡Yek'uma qa mixti' jun tu'n toktq'o'ntib' q'ojil tuk'i'la! chij toj tna'j Dyos.</para>
  <para style="p">
    <verse number="12" style="v" />Ekanb'antzu'n Asa kyuk'i'l aj Juda tu'n Qman Dyos kyib'aju' aj Etyopiy, qu'mtzun e'kub' oq kywitz. <verse number="13" style="v" />Aye'tzunkye Asa kyuk'i'lju' t-xjal exi' lpe kyi'j tzmax toj Werar, ex e'kub' kyb'yo'n kykyaqilxju' aj Etyopiy ex mixti' jun kyej anq'in, qu'n majx e'kub' mankun twitz Qman Dyos ex kywitzju' t-xjal te q'oj, ex nim txqan ti'xti' b'je'l kyiq'i'n kyeju' kyajq'oj. <verse number="14" style="v" />Yajxi'tzuntl eb'jo'k tzaqpaj q'ojil kyi'j kykyaqilju' nimaqtnam ti'jile Werar, qu'n kykyaqilju' tnam lu ok xob'el kyi'j twitz Qman Dyos. B'je'tzkyiq'i'n aj Juda txqan ti'xti' kyoj, qu'n nimtoq q'inumal ati kyoj. <verse number="15" style="v" />Ex eb'jo'k tzaqpaj kyi'ju' najb'il ja ate'toq alu'mj, ex b'aj tzaj kyiq'i'n txqan rit ex kamey. Anjtztzun kyi'jtz toj Jerusalen.</para>
  <chapter number="15" style="c" />
  <para style="s1">Ch'ixpub'l tu'n Asa toju' okslab'l</para>
  <para style="r">(<ref loc="1KI 15:13-15">1 R 15.13-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Atzu'n Asariy, tk'wal Ob'ed, noj tu'n t-xew Dyos, <verse number="2" style="v" />etztzun k'lulte Asa tu'n txi' tma'n te: ¡Chin kyb'itze', Asa, ex kykyaqile' aj Juda ex aj B'enjamin! Atite' Qman Dyos kyuk'i'le', qa ate'qe'ye' tuk'i'l. Qama che jyone' ti'j, kknetel kyu'ne'; qatzun makyej kykolb'i'ne', ikxte che kjel tkolb'i'ne'. <verse number="3" style="v" />Matxi' tzaj nim tq'ijlalil min nche k'uluntl aj Israel teku' Dyos, ex mixti'qe' pale tu'n kyxnaq'tzan kyxol ex mixti' nuk'b'il kye toj kyokslab'l. <verse number="4" style="v" />Tetzunj ate'toq toj yajb'il, b'aj anjtz jumajtlkyi'j tuk'i'l Qman Dyos, mache jyon ti'j ex ma knet kyu'n. <verse number="5" style="v" />Mix-alo'xtoqte ati nak'b'il te kyoju' tq'ijlalil lu, ninpe' xob'el tzaj kyib'aju' xjal kyoju' chukchaq tx'otx'. <verse number="6" style="v" />Intoq b'aj kyxitu'n kyib'ju' nimaqtnam kyxolilex jun ti'j juntl, ex ikxqe' b'o's tnam jun tk'i' juntl, qu'n tzaj tq'o'n Qman Dyos chukchaq yajb'il kyib'aj. <verse number="7" style="v" />Laluntzun che xob'e' ex lalun che kub' numje', qu'n ati tu'me'l t-xelju' kyaq'une', chij.</para>
  <para style="p">
    <verse number="8" style="v" />Tetzunj tb'inte Asa tyolju' t-sanjelal Dyos, ten tipumal ex eb'ajkub' t-xitu'n witzileb' ik'b'ilqe'xi'x toj tkyaqilju' kytx'otx' aj Juda ex aj B'enjamin ex kyoju' nimaqtnam matxi'toq che kanb'et tu'n kywi'witz te Eprayin, ex jaw tb'incha'nxi'xtlju' q'olb'eb'l te Qman Dyos atitoq twitzju' tilb'ilal twitz tja Qman Dyos. <verse number="9" style="v" />Yajxi'tzuntl eb'aj tb'u'yi'n kykyaqilju' aj Juda ex aj B'enjamin, kyuk'i'lxi' ajb'etun ate'toq kyuk'i'l tzajniqe' kyxol kyyajajil Eprayin, Manases ex Simeon, qu'n nimtoqu' aj Israel matxi'toq kymujb'a kyib' tuk'i'l Asa tej kyka'yinte atitoq Qman Dyos tuk'i'l.</para>
  <para style="p">
    <verse number="10" style="v" />B'aj kyb'u'yi'n kyib' toj Jerusalen toj toxi'n xjaw teju' o'lajoj ab'q'i ntoq kawin Asa, <verse number="11" style="v" />kub' kyq'o'n junk'al o'lajnaq (700) wakx ex wuqlajk'al lajnaq (7,000) rit te chojb'il te Qman Dyos toju' q'ij lu, kyi'ju' b'je'l kyiq'i'n kye ajq'oj. <verse number="12" style="v" />Kytziyatzuntz tu'n kyjyonte Qman Dyos tu'n tkyaqil kyk'u'j, Kydyos ojtxi' kyyajilb'en. <verse number="13" style="v" />Ex kytziya, qa kb'el b'yet alkyexku' xjal minti' xjyon ti'j Qman Dyos, maskye tij ichan mujqa k'wal, ichan mujqa qya. <verse number="14" style="v" />Xikytziya'n tu'n tq'ojq'ojel kywi' kuw twitz Qman Dyos, ex e'jaw ẍch'in tu'n kytzalajb'il toj tq'ojq'ojel chun ex kyuk'a alu'mj. <verse number="15" style="v" />Kykyaqiltzu'n aj Juda eb'aj tzalaj qu'n kytziya tu'n tkyaqil kyanmi ex kyjoyu' Qman Dyos tu'n tkyaqil kyk'u'j, tzajtzun tyek'u'ntib' Qman Dyos kye ex tzaj tq'o'n nak'b'il kyxol kyuk'i'l kykyaqilju' kyb'sin.</para>
  <para style="p">
    <verse number="16" style="v" />Expe' eltiq'i'n nimaqkawil Asa toklen Maaka, ju' tya, toju' tkawb'il, qu'n ojetoq t-xitq'a' b'incha' jun tilb'ilal Asera. Kub' t-xitu'n Asa ju' tilb'ilal lu; b'ajkub' tb'uchi'n ex oktq'o'n tq'aq'al ttzi a' Sedron. <verse number="17" style="v" />Maskyepe' min eb'aj kub' xitu'nju' ja xjan kye txqantl dyos kywi'witz toj Israel, kub' we'te Asa toj tokslab'l, <verse number="18" style="v" />b'jo'kx tq'o'n tkyaqilju' q'anpwaq ex saqpwaq toju' tja Dyos, ju' ojetoq kub' kyq'o'n tuk'i'lju' tman twitz Qman Dyos. <verse number="19" style="v" />Ex mixti'te' q'oj b'aj tzmax tb'ent junaq o'lajoj (35) ab'q'i nkawin Asa.</para>
  <chapter number="16" style="c" />
  <para style="s1">Kyej b'entti'j kyyol Asa tuk'i'l B'en-adad</para>
  <para style="r">(<ref loc="1KI 15:16-22">1 R 15.16-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tojtzun junaq qaqlajoj (36) ab'q'i ntoq kawin Asa, tzaju' B'aasa, nimaqkawil kye aj Israel, q'ojil ti'j Juda, ex jawtb'incha'n nintapi ti'ju' tnam Rama, tu'n tmqonte b'e tu'n mix-a'lo' pon q'inte tqanil teju' nimaqkawil toj Juda. <verse number="2" style="v" />B'je'tztzun tiq'i'n Asa ju' q'anpwaq ex saqpwaq toju' k'uwenj toj tja Qman Dyos ex toj tja kawb'il, xit-sma'ntzuntz te B'en-adad, nimaqkawil toj Sirya najlitoq Damask. Ex xit-sma'n tq'umli te ikjalu: <verse number="3" style="v" />Qtziyankjti'j jun qyol tu'n tkyejb'ent ti'j, kse'n kyb'inchaju' qman. Matxinsma'ne' q'anpwaq ex saqpwaq lu teya. Xitunku'ya tyola kyejni b'entti'j tuk'i'lju' nimaqkawil B'aasa toj Israel, tu'ntzun nkyaj tq'o'ne' toj nak'b'il, chij.</para>
  <para style="p">
    <verse number="4" style="v" />B'a'n ela' tyolju' nimaqkawil Asa toj twitz B'en-adad, exi' tchq'o'ntzu'n nejeneltz kyeju' t-xjal te q'oj tu'n kyok tzaqpaj kyi'ju' nimaqkytanam aj Israel. Ikytzu'n kub'kyi'ju' nimaqtnam Iyon, Dan, Ab'el-maym kyu'n, ex kykyaqilju' nimaqkytanam aj Neptali intoq che ajb'en te k'ub'l twitz awal. <verse number="5" style="v" />Tetzunj tb'inte B'aasa, kyej ttenb'a'n taq'un tu'n tb'inchante nimaqtapi ti'ju' tnam Rama. <verse number="6" style="v" />Eb'ajxtzun tiq'i'n nimaqkawil Asa kykyaqilju' aj Juda tuk'i'l, b'aj tzaj kyiq'i'nju' ab'j ex tze toj Rama ju' ajb'en tu'n B'aasa te nintapi, ex jawtb'incha'n nintapi kyu'n, kyi'ju' tnam Web'a ex Mispa.</para>
  <para style="p">
    <verse number="7" style="v" />Pontzu'n Anani t-sanjelal Dyos tk'etzu' nimaqkawil Asa toj Juda toju' tq'ijlalil lu, ex xitma'n te: Tu'nju' xi' soka' qe tk'u'ja ti'ju' nimaqkawil toj Sirya ex mya ti'j Qman Dyos, matxi' che tzaqpaj t-xjalu' nimaqkawil toj Sirya te q'oj toj tq'ob'a. <verse number="8" style="v" />¿Ma myatzun kuwqe'toqju' xjal te q'oj aj Etyope ex aj Lib'yo, nimtoq txqan kychej ex kykarwaj te q'oj? Extzun kub'kyi'j tu'na qu'n okqe tk'u'ja ti'j Qman Dyos. <verse number="9" style="v" />Ina' ka'yinte Qman Dyos ti'ju' inb'aj toj tkyaqil twitz tx'otx', ex intzaj tq'o'n kyipumalju' q'uqli kyk'u'j axxi'x ti'j. ¡Atzunta naku'j mixti' tnab'la tu'nju' xtb'inchaya! Ma'tzun txi'tza ja'lo naqx toj q'oj, chi t-sanjelal Dyos te.</para>
  <para style="p">
    <verse number="10" style="v" />Tzajtzun ttx'u'jilu' Asa b'a'nxi'x ti'ju' t-sanjelal Dyos, tchaq' tu'n tokxq'o'n toj jpub'l. Ex taq'wixi'xtoq kyilwi junjun xjal toju' tnam tu'n toju' tq'ijlalil lu.</para>
  <para style="s1">Kyim Asa</para>
  <para style="r">(<ref loc="1KI 15:23-24">1 R 15.23-24</ref>)</para>
  <para style="p">
    <verse number="11" style="v" />Xi' tz'ib'a'na' tqanil ti'j Asa, ttzajku' qe ex tej tpon b'aj toju' u'j kye nimaqkawil toj Juda ex toj Israel. <verse number="12" style="v" />Tojtzun junaq b'eljlajoj (39) ab'q'i ntoq kawin, kub' ichin Asa tu'n jun yab'il kuwxi'x kyi'ju' tqan; ex mixti' jyon ti'j Qman Dyos toju' tyab'il, aye'tlju' q'anal e' tjoy. <verse number="13" style="v" />Kyimtzuntz toju' ab'q'i kab'naq jun (41) teju' tkawb'il, <verse number="14" style="v" />ku'x mqu'ntzuntz toju' muqb'il ojetoq tchaq' tu'n tb'inchet toju' Ninttanam Dab'i. Kub' q'o'n tib'aj jun kuẍb'il nim k'ok'sb'il toj ex chukchaq k'ok'sb'il b'incha'n b'a'nxi'x. Oktzun txqo'n jun nin q'aq'tz te ninb'ilte.</para>
  <chapter number="17" style="c" />
  <para style="s1">Tkawb'il Josapat</para>
  <para style="p">
    <verse number="1" style="v" />Atl Josapat kawin te t-xel Asa ju' tman, nimtipumal ten tu'n tq'ojin ti'j Israel. <verse number="2" style="v" />E'kub' tq'o'n b'a'npun tnej xjal te q'oj kyoj kykyaqilju' nimaqtnam tokyile nimaqtapi kyi'j toj Juda ex k'loj xq'uqil toj tkyaqilju' tx'otx' te Juda ex kyoju' nimaqtnam te Eprayin, ojetoq kub'kyi'j tu'n Asa ju' tman.</para>
  <para style="p">
    <verse number="3" style="v" />Ten Qman Dyos tuk'i'l Josapat, qu'n anq'in kse'n Dab'i ojtxi' tyajilb'en. Min ajb'en kyeju' chukchaq tilb'ilal B'aal, <verse number="4" style="v" />xi' ajb'ena' te Qman Dyos ja ajb'ena' tman, ejapunju' tchaq'b'il tu'n, min oktq'o'n twitz ti'j kyb'incha'ju' xjal kyxol aj Israel. <verse number="5" style="v" />Qu'mtzun tkuwsa Qman Dyos kawb'il toj tq'ob'. Kykyaqilju' aj Juda intoq tzaj kyiq'i'n kyoyaj te, tentzun txqan tq'inumaltz ex toklen. <verse number="6" style="v" />Xitljo'nju' b'e kyej tyek'u'n Qman Dyos kye toj tzalajb'il, ex eb'je'l tiq'i'nju' najb'il xjan kye txqantl dyos kywi'ju' witz exqe'ju' tilb'ilal Asera toj Juda.</para>
  <para style="p">
    <verse number="7" style="v" />E'xitchq'o'n B'enayl, Ab'diy, Sakariy, Natanael ex Mikayiy ju' nche kawin tuk'i'l, toj toxi'n ab'q'i nkawin, tu'n kyxnaq'tzan kyoju' nimaqtnam toj Juda, <verse number="8" style="v" />ex e'xi' tyajajil Leb'i kyuky'i'l, aye' Semayiy, Netaniy, Seb'adiy, Asael, Semiramot, Jonatan, Adoniy, Tob'iy ex Tob'adoniy. Ex exi' pale Elisama ex Joram kyuky'i'l. <verse number="9" style="v" />E'xitchq'o'n tu'n t-xikyxnaq'tzan tuk'i'lu' tu'jil tkawb'il Qman Dyos kye aj Juda. Ex b'je'lpun b'aj kykyaqilju' nimaqtnam toj Juda kyu'n xnaq'tzalkye xjal.</para>
  <para style="p">
    <verse number="10" style="v" />Kykyaqiltzu'n kawb'il kyoju' tx'otx' ate'toq ti'jile Juda mixti' jawkyiq'i'nkyib' q'ojil ti'j Josapat qu'n tzaj tchi Qman Dyos kyi'j. <verse number="11" style="v" />Ape' b'ajiju', ate' junjun pilistey intoq tzaj kyiq'i'n oyaj ex q'anpwaq te chojb'il te Josapat, aye'tzun aj Arab'e pon kyiq'i'n b'eljlajk'al jo'naq (7,700) chib' ex kyinx tajlal ritju' te.</para>
  <para style="p">
    <verse number="12" style="v" />Qu'mtzun xitoq ttenxi'x tipumal Josapat. Tchaq' tu'n kyb'jaw tb'incha'n ja nimaq kywe' te xq'uqb'il, e'nimaqtnam te k'ub'l twitz awal toj Juda, <verse number="13" style="v" />ex ten nim ti'xti' te kyoju' nimaqtnam toj Juda. Ex nimqe'toq t-xjal te q'oj min nche xob' toj Jerusalen. <verse number="14" style="v" />A kyb'i ja'lu, kse'nxju' tz'ib'a'n toju' u'j kye kyyajajil kyman:</para>
  <para style="p">Atoq Adna chaq'ul kye nejenel kye xjal te q'oj kyxol aj Juda, ate'toq junaq wuqlajmutx' lajk'al (300,000) xjal te q'oj tjaq' tkawb'il. <verse number="15" style="v" />Ex atitoq Joanan tuk'i'l, nejenel kye junaq o'lajmutx' (280,000) xjal te q'oj, <verse number="16" style="v" />ex atitoq Amasiy, tk'wal Sikri, ju' taq'tib' tu'n tk'u'j tu'n tajb'en te Qman Dyos, kyuk'i'l junaqjo' mutx' (200,000) xjal te q'oj min nche xob'.</para>
  <para style="p">
    <verse number="17" style="v" />Atitoq Elyada kyxolju' tyajajil B'enjamin, jun xjal te q'oj min xob', kyuk'i'l junaqjo' mutx' (200,000) ichan iq'i'mile kysmaj ex kykolb'il, <verse number="18" style="v" />ex atitoq Josab'ad kyuk'i'l junaq kab'mutx' lajk'al (180,000) ichan b'incha'ntl kyten tu'n kyxi' q'ojil.</para>
  <para style="p">
    <verse number="19" style="v" />Aye'tzun intoq che ajb'enju' te nimaqkawil, kyi'jxi'tlju' e'kub' tq'o'n nimaqkawil kyoju' nimaqtnam tok nimaqtapi kyi'j toj tkyaqil Juda.</para>
  <chapter number="18" style="c" />
  <para style="s1">Tqanil tu'n Mikayiy qa kb'elti'j Akab'</para>
  <para style="r">(<ref loc="1KI 22:1-40">1 R 22.1-40</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tente Josapat txqan tq'inumal ex toklen, ex ok kykunpaleyi'nkyib' tuk'i'l Akab'. <verse number="2" style="v" />Tb'ajlenxi'tzun jte' ab'q'i, xi' Josapat q'olb'elte Akab' toj Samarya, atzunte Akab', e'kub' tb'yo'n txqan rit ex wakx tu'n tnimet tponlen Josapat kyuk'i'lju' lepchqe'k ti'j, ex okten so'jlalte tu'ntzun kyxi' tuk'i'l q'ojil ti'j Ramot toj Kalaad. <verse number="3" style="v" />Xit-xjelu'n Akab', nimaqkawil toj Israel, te Josapat, nimaqkawil toj Juda, ikyja'lu:</para>
  <para style="p">—¿Ma jaku' txi'ya q'ojil wuk'i'le' ti'j Ramot toj Kalaad? chij.</para>
  <para style="p">Xi'tzun ttzaq'we'n Josapat te:</para>
  <para style="p">—Q'o'nqe' qib' kyuk'i'lju' nxjale' te q'oj tuk'i'la, tu'n qxi'ye' kyuk'i'lju' t-xjala q'ojil. <verse number="4" style="v" />Naqtzun aju' nejtl xjeluna alkye tb'is tk'u'j Qman Dyos, chij te.</para>
  <para style="p">
    <verse number="5" style="v" />Eb'ajtzun tb'u'yi'n nimaqkawil toj Israel t-sanjelal Dyos, junk'al (400) kyb'aj, xi'tqani'ntzuntz kye:</para>
  <para style="p">—¿Ma b'a'n tu'n qxi' q'ojil ti'j Ramot toj Kalaad mujqa mya? chij.</para>
  <para style="p">Aye'tzunkye xikytzaq'we'n te:</para>
  <para style="p">—Kutxi'ya q'ojil, qu'n che b'eltq'o'nte Qman Dyos toj tq'ob'a, chechij.</para>
  <para style="p">
    <verse number="6" style="v" />Atzunte Josapat xitqani'n:</para>
  <para style="p">—¿Ma mixtzunti' juntl t-sanjelal Qman Dyos jatu'n qxjeluna'tl? chij.</para>
  <para style="p">
    <verse number="7" style="v" />Xi'tzun ttzaq'we'n nimaqkawil toj Israel te Josapat:</para>
  <para style="p">—Atix juntlte' b'a'n tu'n qxjelun te Qman Dyos tuk'i'l. A Mikayiy, tk'wal Imla. Naq aju' majx nwik'o'nwe', qu'n mixti'x ntzaj tma'n tqanil b'a'n, naq taq'wix ntzaj tma'n weye', chij.</para>
  <para style="p">Atzunte Josapat xitma'n te:</para>
  <para style="p">—Lalun tmaya ikju', chij.</para>
  <para style="p">
    <verse number="8" style="v" />Tzajtzun ttxko'n nimaqkawil aj Israel junju' onilte ex tchaq' te:</para>
  <para style="p">—¡Ati tu'n ttzaj Mikayiy, tk'wal Imla, ja'loxi'x! chij.</para>
  <para style="p">
    <verse number="9" style="v" />Q'uqlqe'toqtzu'n nimaqkawil aj Israel tuk'i'l Josapat nimaqkawil toj Juda toju' kyq'uqb'il te kawb'il twi' pe'n ttzi Samarya, oksa'nktoqju' kyi'j nim toklen, kykyaqiltzunju' t-sanjelal Dyos intoq xikyma'nju' tqanil ti'ju' kb'ajel kywitz. <verse number="10" style="v" />Atzunte Sedekyiy, tk'wal Kyenaana, matxi'toq che kub' tb'incha'n junjun kyuk'a wakx k'uxb'ilqe' ex intoq tma'n tuk'i'l tq'ojq'ojel twi': ¡A ntma'n Qman Dyos ja'lu: Che kxe'le' q'ojil kyi'ju' aj Siryo kyuk'i'lju' kyuk'a alu'mj lu ex che mankul kyu'ne'! chij.</para>
  <para style="p">
    <verse number="11" style="v" />Axtoq tqanilju' kyu'n kykyaqilju' sanjelal. Intoq kyma'n teju' nimaqkawil: Kutxi'ya q'ojil ti'j Ramot toj Kalaad ex kkanb'ala ti'j, qu'n kb'eltq'o'nte Qman Dyosju' nintnam toj tq'ob'a, chechij te.</para>
  <para style="p">
    <verse number="12" style="v" />Atzunju' xichq'o'n txkolte Mikayiy, xitma'n te:</para>
  <para style="p">—Kykyaqilxju' sanjelal, mixti' jun myawit b'a'nju' ttzaq'web'l teju' nimaqkawil. Qu'mtzun wajb'ile' tu'n tyolina' kse'nkye, tu'n tmanteya jun tqanil b'a'n, chij te.</para>
  <para style="p">
    <verse number="13" style="v" />Atzunte Mikayiy xittzaq'we'n te:</para>
  <para style="p">—¡Lu Qman Dyos, o'kxwe' kxe'l nma'n aju' matchaq' Dyos tu'n nmanteye'! chij.</para>
  <para style="p">
    <verse number="14" style="v" />Pontzuntz twitzju' nimaqkawil, xi'tzun tqani'n nimaqkawil te:</para>
  <para style="p">—Mikayiy, ¿Ma b'a'n tu'n qxi'ye' q'ojil ti'j Ramot toj Kalaad mujqa mya? chij.</para>
  <para style="p">Xi'tzun ttzaq'we'n Mikayiy te:</para>
  <para style="p">—Kukyxi'kye' q'ojil, kna'lo che kanb'ale', kna' kb'eltq'o'n Qman Dyos toj kyq'ob'e', chij.</para>
  <para style="p">
    <verse number="15" style="v" />Atzunte' nimaqkawil xittzaq'we'n te:</para>
  <para style="p">—¿Jte'xi'xtzun maj kxe'l nma'ne' teya, tu'n ttzaj tma'na ax weye' toj tb'i Qman Dyos? chij.</para>
  <para style="p">
    <verse number="16" style="v" />Tmatzun Mikayiytz:</para>
  <para style="b" />
  <para style="q">Mache wile' kykyaqilu' aj Israel</para>
  <para style="q">matxi' che b'ajx slamj kyoj k'ul,</para>
  <para style="q">kse'nqe' rit mix-a'lo' k'ik'lelkye.</para>
  <para style="q">Ex matxi' tma Qman Dyos:</para>
  <para style="q">Mixti' kye'lu kyajaw;</para>
  <para style="q">kukyanj kyja teyile junjun toj nak'b'il, chi Dyos, chij.</para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" />Xi'tzun tma'n nimaqkawil toj Israel te Josapat:</para>
  <para style="p">—Mana' txinma'ne' teya, mixti'x jun tqanil b'a'n tu'nte' ichan lu, naq o'kx myab'a'n ntzaj tma'n weye', chij.</para>
  <para style="p">
    <verse number="18" style="v" />Tmatltzun Mikayiy:</para>
  <para style="p">—Kyb'intztzune' tyol Qman Dyos: Wile' Qman Dyos q'uqli toju' tq'uqb'il te kawb'il kyuk'i'l kykyaqilju' anjl wa'lqe'toq toj tb'a'ntq'ob' ex toj tnayaj. <verse number="19" style="v" />Xi'tzun tqani'n Qman Dyos alkye jaku' b'inchante tu'n telb'a'n toj twitz Akab' nimaqkawil toj Israel tu'n txi' q'ojil ti'j Ramot toj Kalaad, tu'ntzun tb'aj atzu'. Chukchaqtoqtzu'n tzaq'web'l tu'n junjun. <verse number="20" style="v" />O'kx ttzaj jun xewb'aj pon twitz Qman Dyos ex tma qa kb'entel tu'n. Xi'tzun tqani'n Qman Dyos te, kse'n tu'me'l tu'n tb'inchante, <verse number="21" style="v" />xi'tzun tma'n xewb'aj qa kt-xewsa' chajyolil kye kykyaqilju' sanjelal teju' nimaqkawil. Xi'tzun tma'n Qman Dyos te, qa kb'entel t-sb'et tu'n, ex tu'n txi' b'inchalte. <verse number="22" style="v" />Matxi'tzun tb'iya ja'lo, matxi' kub' tq'o'n Qman Dyos jun xewb'aj chalyol toj kytziju' sanjelal lu teya, ex matxi' tma tu'n tb'aja, chi Mikayiy.</para>
  <para style="p">
    <verse number="23" style="v" />Atzunte Sedekyiy, tk'wal Kyenaana, pon lq'e tk'etz Mikayiy, oktq'o'n jun tjaq' ttzi ex xitma'n te:</para>
  <para style="p">—¿Jatzun xxa'ju' t-xew Qman Dyos atitoq woje, tu'n tyolintzuntz teya? chij.</para>
  <para style="p">
    <verse number="24" style="v" />Xi'tzun ttzaq'we'n Mikayiy te:</para>
  <para style="p">—K'elel tnik'a ti'j aj txi'ya ewal jayi'nchaq, chij te.</para>
  <para style="p">
    <verse number="25" style="v" />Tchaq'tzunju' nimaqkawil toj Israel:</para>
  <para style="p">—¡Kytzyume' Mikayiy ex kyjpunkxe' kywitz Amon, kawil toju' nintnam, ex Joas nk'wale'! <verse number="26" style="v" />Kymanxe' kye qa matxi' nchaq'e' tu'n tokx kyjpu'ne', ex naqch'i'n twa ex tk'wa' kyq'onxe', tzmax ajtanjtz wi'je' toj b'anil, chij.</para>
  <para style="p">
    <verse number="27" style="v" />Atzunte Mikayiy tmatl:</para>
  <para style="b" />
  <para style="q">Qa matz'anjtzti'ja toj b'anil,</para>
  <para style="q">myatzun Qman Dyostz xyolin toj ntziye', chij.</para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" />Exi'tzun nimaqkawiltz aj Israel, tuk'i'l Josapat nimaqkawil aj Juda, q'ojil ti'j Ramot toj Kalaad. <verse number="29" style="v" />Xi'tzun tma'n nimaqkawil aj Israel te Josapat:</para>
  <para style="p">—Kxel nch'ixpu'nwe' wi'j toju' q'oj, atzunta oksanka wi'je', chij te.</para>
  <para style="p">Ikytzu'n tch'ixpu nimaqkawil aj Israel ti'j, exi'tzuntz kykab'il q'ojil. <verse number="30" style="v" />Ojetoqtzun tchaq'ju' nimaqkawil aj Sirya kyeju' nejenel kye tkarwaj te q'oj tu'n lalun che oktzaqpaj q'ojil kyi'ju' xjal qa myaku' nimaqkawil kye aj Israel. <verse number="31" style="v" />Tetzunj tknet Josapat kyu'n nejenel kye karwaj, kub' kyxima'n qa atoq nimaqkawilju' kye aj Israel, okkytxoli'nkyib' ti'j tu'n kyq'ojin. Jawtzun ẍch'in Josapat nqanin o'nb'il, ex tzaj oni'n tu'n Qman Dyos. Eb'je'l tlaq'b'a'n Qman Dyos ti'j, <verse number="32" style="v" />qu'n tej kyka'yinte myate' nimaqkawilju' kye aj Israel, kyej kytzaqpi'n. <verse number="33" style="v" />O'kx ttzaj jun xjal aj Siryo te q'oj, naq xit-smaji'nxi', aku'xi'xju' nimaqkawil kye aj Israel tak' b'a'nxi'x tu'n kyxolju' b'u'yi'nkyib' toj q'oj. Tchaq'tzuntz teju' iq'iltoqte karwaj:</para>
  <para style="p">—Kutanj ti'ja ex chin tiq'imixa ti'jxi'ju' q'oj qu'n matxi' chin k'ixb'iye' b'a'nxi'x, chij.</para>
  <para style="p">
    <verse number="34" style="v" />Kuwu' q'oj ok toju' q'ij lu, qu'mtzun wa'ltoqju' nimaqkawil kye aj Israel toju' tkarwaj, q'ojil kyi'ju' aj Siryo tzmaxi'j tok qale, kyimtzuntz tej tex q'ij.</para>
  <chapter number="19" style="c" />
  <para style="s1">Xitzak'u'n Josapat tu'n Jewu t-sanjelal Dyos</para>
  <para style="p">
    <verse number="1" style="v" />Anjtzti'j Josapat nimaqkawil aj Juda, b'a'n, toju' tja te kawb'il toj Jerusalen. <verse number="2" style="v" />Atzu'n t-sanjelal Dyos Jewu, tk'wal Anani, ex k'lulte ex xitqani'n te: ¿Tiqu'n n-onina ti'ju' myab'a'n xjal ex kyexi'x ttena kyuk'i'lu' ajq'oj ti'j Qman Dyos? Tu'ntzun ja'lu, matxi' tzaj ttxu'jil Qman Dyos ti'ja. <verse number="3" style="v" />Naqpe' ate' ate'x junjuntl ti'xti' b'a'n xtb'inchaya, mache kub't-xitu'nju'ya tilb'ilal Asera ate'toq toju' tx'otx', ex makub' t-xima'na tu'n tjyona ti'j Dyos, chij te.</para>
  <para style="s1">Eb'jo'ktq'o'n Josapat ajkawil</para>
  <para style="p">
    <verse number="4" style="v" />Najlitoq Josapat toj Jerusalen, ex naq'litoq inex xb'etzalkyeju' ttanam, ntzajx B'eerseb'a ex nponx kywi' witz te Eprayin, tu'n tanjtz jumajtlkyi'j tuk'i'l Qman Dyos Kydyos ojtxi' kyyajilb'en. <verse number="5" style="v" />Expe' eb'jo'ktq'o'n ajkawil kyoj kykyaqilju' nimaqtnam tok nimaqtapi kyi'j toj Juda. <verse number="6" style="v" />Ex xitma'n kyeju' ajkawil: Kyka'yinxe' b'a'nxi'x ti'ju' nkyb'incha'ne', qu'n toj tb'i Qman Dyos che kawila'ye' ex mya toj kyb'i xjal, ktenb'il kyuk'i'le' ajkymanteye' qa kb'el sentens. <verse number="7" style="v" />Qu'mtzun kyb'inxju'ye' Qman Dyos ex kyka'yinxe' b'a'nxi'x ti'ju' nkyb'incha'ne', qu'n myanaq nka'yinte Qman Dyos ti'ju' mya tnik'alti'j, ti'ju' myab'a'n b'inchb'ente ex tu'nwt tk'met oyaj ti'j myab'a'n, chij.</para>
  <para style="p">
    <verse number="8" style="v" />Ex eb'jo'ktq'o'n Josapat junjun aj Leb'i, e'pale ex e'nejenel kye junjun ja aj Israel te ajkawil toj Jerusalen, kyib'aj ti'xti' toj okslab'l ex kyib'aju' q'oj nb'aj kyxolu' xjal toj Jerusalen. <verse number="9" style="v" />Ex xitma'n kye: Ati tu'n kynimane' te Qman Dyos toju' kyaq'une', japunxju' tchaq'b'il kyu'ne' ex che okxe' tnik'alkyi'je'. <verse number="10" style="v" />Alkyexku'chaq kyq'oju' kywnaqile' mapon kyiq'i'n kywitze', ju' najlqe' kyoju' chukchaq nimaqtnam, tu'n kymanteye' qa b'yo'n xkyima' jun xjal mujqa mya, mujqa tu'n tajb'en chukchaq kawb'il kyu'ne', chaq'b'il ex nuk'b'il, kyab'tzinxe' kye tu'n lalun che b'inchan il twitz Qman Dyos, tu'ntzun lalun tzaj ttx'u'jil kyi'je' ex kyi'j. Kyb'inchame' ikju', myaye'tzuntze' ati kypaje'. <verse number="11" style="v" />A Amariy, ju' knejel pale, nim toklen kyeye' kyoju' ti'xti' te okslab'l, atzu'n kyoju' ti'xti' kyxol tnam a Seb'adiy tk'wal Ismael ex nejenel kyeju' tyajajil Juda; aye'tzu'n aj Leb'i che onil kyuk'i'le'. ¡Kykuwsam kyib'e' ex che aq'unane'! ¡Awttzun Qman Dyos ten tuk'i'lju' matb'incha taq'un b'a'n! chi nimaqkawil.</para>
  <chapter number="20" style="c" />
  <para style="s1">Kanb'an Josapat kyi'j Moab' ex Amon</para>
  <para style="p">
    <verse number="1" style="v" />Tb'ajlenxi'tzun jte' q'ij, e'tzaju' aj Moab' ex aj Amon, q'o'ntoq kyib' kyuk'i'lu' aj Meunit, eb'jo'k tzaqpaj q'ojil ti'j Josapat; <verse number="2" style="v" />e'tzajtzun jte' xjaltz q'malte te: ¡Lu jun nin k'loj xjal te q'oj aj Edom jlajxi'ju' Kyimni Ninnjab', xi'kytzaj q'ojil ti'ja! ¡Lu Ate'qe'tl toj Aseson-tamar! chechij. (Aju' Aseson-tamar axju' En-kadi.)</para>
  <para style="p">
    <verse number="3" style="v" />Jawxob' Josapat, ex kub' t-xima'n tu'n tjyon ti'j Qman Dyos. Extma'ntzun jun tqaniltz toj tkyaqil Juda tu'n kymewayin, <verse number="4" style="v" />b'ajtzun kyb'u'yi'n kyib'ju' xjal aj Juda qanil o'nb'il te Qman Dyos. E'pon xjal te kykyaqilju' nimaqtnam toj Juda. <verse number="5" style="v" />Kub'tzun we' Josapat kyxolju' tnam xjal te Juda matxi'toq b'aj kyb'u'yi'n kyib' toj Jerusalen, twitzju' ak'a'j pe'n teju' tja Qman Dyos, <verse number="6" style="v" />tmatzuntz: Nman Dyos, ju' mache k'ulun ojtxi' qyajilb'ene' teya', ¡ateju'ya Dyos te toj kya'j, kykyaqil nimaqtnam ate' tjaq' tkawb'ila! ¡Toj tq'ob'a ta'ju' ipumalj ex oklenj: mix-a'lo' jun kb'entel tq'ojin tuk'i'la! <verse number="7" style="v" />Qman Dyos, eb'je'l tiq'i'nju'ya najlqe'toq toju' tx'otx' lu twitzju' ttanama Israel, ex matzaj tq'o'na tx'otx' tejumajx kyeju' tyajajil Ab'raam, ju' kye ttena tuk'i'l. <verse number="8" style="v" />Tetzunj ate'tltoq tza'lu, jaw kyb'incha'n jun ja te k'u'lb'il teya, ex kyma: <verse number="9" style="v" />Qama tzaj jun taq'wixil qib'aje' te tz'e'ysb'il qwitze', q'oj, yab'il mujqa we'yaj, qo' ule' twitzju' ja lu, qu'n atiya toj, ex qo qanil o'nb'ile' teya toj k'ixk'oj, qo tzajel tb'i'na ex qo tkla'ya, chechij. <verse number="10" style="v" />Lu qe'tzunju' aj Amon, aj Moab' exqe' najlqe' twi' witz Seyir, jamin taja'ya tu'n kyb'jo'kxju' aj Israel toju' kytx'otx' tej tzajniqe'toq toj Ejipt, elpe' kypa'n kyib' kyi'j ex min e'kub' kyxitu'n. <verse number="11" style="v" />Lutzunju' tu'me'l t-xel kyu'n ja'lo, xi'kytzaj q'ojil tu'n qex kyxla'ja'ne' toju' ttx'otx'a, tzajni tq'o'na te qetzb'ile'. <verse number="12" style="v" />Qman Dyos, ¿laytzun kub' ttz'e'ysa'na kywitz? Lay qoxkyeqe' tu'n qq'ojine' kyi'ju' jun nin tnej xjal te q'oj lu nche oktzaqpaj q'ojil qi'je'. ¡Min nkane' toj qwitze' titi' kqb'incha'ye': Qu'mtzun q'uqli qk'u'je' ti'ja!, chij toj tna'j Dyos.</para>
  <para style="p">
    <verse number="13" style="v" />Kykyaqilju' aj Juda wa'lqe'toq twitz Qman Dyos kyuk'i'l kyxu'jil ex kyk'wal, exqepe' k'wal b'o'sqe'. <verse number="14" style="v" />Tetzunj b'u'yi'ntoq kyib' kykyaqilju' xjal, ulju' t-xew Qman Dyos tib'aj Jaasyel, tk'wal Sakariy ex tchman B'enayiy, tk'wal Jeyel ex tchman Mataniy, jun aj Leb'i, tyajajil Asap, <verse number="15" style="v" />tmatzuntz: Kyb'intzpe'ye' najlqe'ye' toj Juda ex toj Jerusalen, ex aya nimaqkawil Josapat. Chi Qman Dyos kyeye':</para>
  <para style="pi">Lalun che xob'e' ex lalun tzaj kychiju' nin tnej xjal te q'oj kyi'je', qu'n ayinwe' chin q'ojil ex myaye'kye'. <verse number="16" style="v" />Kukyku'xe' q'ojil kyi'j najchi'j. Luqe' che b'jawu'l tk'u'ju' witz Sis, che okyel yal kyu'ne' ttziju' a' jata' chq'ajlaj te Jerwel. <verse number="17" style="v" />Mya'ye'na'kye' che q'ojil toju' q'oj lu. Kynk'um kyib'e', ex che nak'eku'ye', kyla'tzuntze' se'n che kletela'ye' wu'ne' ayine' Dyos Manb'aj. ¡Lalun che xob'e' ex lalun tzaj kychi kyi'je', aye'ye' najlqe'ye' toj Jerusalen ex toj Juda; kukxi'ye' q'ojil kyi'j najchi'j, qu'n atinqinwe' kyuk'i'le'! chi Dyos, chi Jaasyel.</para>
  <para style="p">
    <verse number="18" style="v" />Kub'tzun meje Josapat ex majx kub'joqe twitz tx'otx', exqe' xjal aj Juda ex te Jerusalen e'kub' meje k'ulul twitz Qman Dyos. <verse number="19" style="v" />Aye'tzu'n aj Leb'i kyyajajil Kyeat ex Kore, e'aq'wi ajwalilte Qman Dyos, kydyos aj Israel, tuk'i'l tq'ojq'ojel kywi' kuw.</para>
  <para style="p">
    <verse number="20" style="v" />Eb'jawe'tzuntz b'a'n prim te juntl q'ij tu'n kyxi' toju' chq'ajlaj Tekoa. Tojtzu'n kmuj tej kyb'je'x, kub' we' Josapat ex xitma'n kye: Kyb'intzpe'ye' najlqe'ye' toj Jerusalen ex toj Juda: qek kyk'u'je' ti'j Qman Dyos, tu'ntzun kyxi'ye' toj b'anil, qek kyk'u'je' kyi'ju' t-sanjelal, tu'ntzun telb'a'n tkyaqil, chij kye.</para>
  <para style="p">
    <verse number="21" style="v" />Tetzunj tb'aj yolin kyuk'i'lju' xjal, xitma'n kye jte' aj b'itzal, tu'n tokkyoksa'n kyxb'alun xjansa'n tu'n kykub'nej kywitzju' xjal te q'oj, tu'n kyajwalinte Qman Dyos tuk'i'l b'itz: Kyq'onx chjonteye' te Qman Dyos, qu'n tejumajxju' tk'u'jlalil, chechij.</para>
  <para style="p">
    <verse number="22" style="v" />Tetzunj kyaq'wi b'itzal te ajwalb'il tuk'i'l tzalajb'il, e'kub' tchuksa'n Qman Dyos aj Amon, aj Moab' exqe' najlqe' twi' witz Seyir, ju' xi'toq kytzaj q'ojil ti'j Juda, ex kub'kyi'j. <verse number="23" style="v" />Qu'n eb'jo'k tzaqpaju' aj Amon ex aj Moab' q'ojil kyi'ju' najlqe' twi' witz Seyir ex majx e'kub' kynajsa'n, tetzunj kyb'aj mankun kyu'n, b'ajkub' kyb'yo'n kyib' kyxolilex. <verse number="24" style="v" />Tetzunj kyponju' ichan aj Juda jaq'ancha'la' chq'ajlaj, xikyka'yi'n woqa'jqe'tlju' kyajq'oj. ¡Mix-a'lo'x jun tzaqpaj! <verse number="25" style="v" />Xi'tzun Josapattzu' kyuk'i'lju' t-xjal iq'iloktzte b'aj kyej kyq'o'nju' ajq'oj, nim alu'mj, ub'l, xb'alun ex ti'xti' wi'yalqe' knet kyu'n, b'aj tzaj kyiq'i'n tkyaqil. Nimxi'xtoqu' ti'xti' ati, mixtoqti' ntzajb'aj kyu'n. Oxe' q'ij b'jawa' kyu'n, qu'n nimxi'xtoq.</para>
  <para style="p">
    <verse number="26" style="v" />Tojtzun tkyaji'n q'ij b'aj kyb'u'yi'n kyib' toju' b'ya' B'eraka, ex jawkynima'n Qman Dyos atzu'. Qu'mtzun B'ya' te B'eraka tb'iju' najb'il lu okkyq'o'n, ex majx kyej tb'i ikju'. <verse number="27" style="v" />Yajxi'tzuntl kykyaqilju' ichan aj Juda ex te Jerusalen, nejli Josapat kywitz, anjtzkyi'j toj Jerusalen, inxi'x che tzalaj, qu'n ojexi'x che tzalaj tu'n Qman Dyos kyib'aju' kyajq'oj. <verse number="28" style="v" />Tetzunj kypon toj Jerusalen, exi' toju' tja Qman Dyos tuk'i'l chnab' tzintzin, Arpa ex chun.</para>
  <para style="p">
    <verse number="29" style="v" />Kykyaqiltzunju' nimaqtnam oktchi Dyos kyi'j tej kyb'inte qa a Qman Dyos q'ojin kyi'ju' kyajq'oj aj Israel. <verse number="30" style="v" />Ikytzu'n tenju' tkawb'il Josapat toj nak'b'il, qu'n tzaj tq'o'n Dyos nak'b'il te kyuk'i'lju' txqantl tnam ti'jile.</para>
  <para style="s1">Tqanil jte'x yol ti'ju' tkawb'il Josapat</para>
  <para style="r">(<ref loc="1KI 22:41-50">1 R 22.41-50</ref>)</para>
  <para style="p">
    <verse number="31" style="v" />Ikytzu'n, kawin Josapat toj Juda. Tetoq Junaq o'lajoj (35) ab'q'i tej ttzyet tkawin, ex kawin junaqjo' (25) ab'q'i toj Jerusalen. Asub'a tb'iju' ttxu, tmyaltoq Sili.</para>
  <para style="p">
    <verse number="32" style="v" />Toj ttxolilti'j anq'ina' Josapat, kse'n anq'ina' Asa ju' tman. B'a'nile b'je'la'ju' tb'inchb'aj twitz Qman Dyos. <verse number="33" style="v" />Tu'npetzunju', min eb'je'l tiq'i'n najb'il xjan kye txqantl dyos kywi'witz, qu'n na'mxi'xtoq tokkyxon kyk'u'ju' tnam tu'n kxi'lpe ti'ju' Kydyos ojtxi' kyyajilb'en.</para>
  <para style="p">
    <verse number="34" style="v" />Xi' tz'ib'a'na' jni'tl tqanil ti'j Josapat, tzajx tej ttzyet ex japona' b'aj, toju' tu'jil tqanil tu'n Jewu, tk'wal Anani, ex tku'x toju' u'j kye nimaqkawil toj Israel.</para>
  <para style="p">
    <verse number="35" style="v" />Yajxi'tzuntel, tmujb'atib' Josapat, nimaqkawil toj Juda, tuk'i'l Okosiy, nimaqkawil toj Israel, ju' majxtoq taq'wixju' tb'inchb'aj. <verse number="36" style="v" />Oktq'o'ntib' tuk'i'l tu'n tkub' kyb'incha'n b'ark tu'n kyxi' Tarsis, atzu' ekub'a' kyb'incha'n toj Esyon-keb'er. <verse number="37" style="v" />Tzajtzun Elyeser aj Maresa, tk'wal Dodab'aw, tmaju' yol tzaj tma'n Dyos ti'j Josapat: Kb'el tq'uchi'n Qman Dyos taq'unb'ena, tu'n tpaju' soktmujb'a'ntib'a tuk'i'l Okosiy, chij. Ekub'tzun b'uchj b'arktzu', ex mixti' b'ent kyxi'tl toj Tarsis.</para>
  <chapter number="21" style="c" />
  <para style="s1">Tkawb'il Joram</para>
  <para style="r">(<ref loc="2KI 8:16-24">2 R 8.16-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Kyim Josapat ex ku'x mqu'n toju' Ninttanam Dab'i, ojtxi' tyajilb'en. Atl Joram ju' tk'wal kawin te t-xel. <verse number="2" style="v" />Aye' titz'in Joram, tk'wal Josapat ja'lu: Asariy, Jeyel, Sakariy, Mikael ex Sepatiy. Kykyaqil tk'wal Josapatqe', nimaqkawil toj Juda. <verse number="3" style="v" />Ojetoq b'ajx toyi'n kyman txqan ti'xti' q'anpwaq ex saqpwaq kye, ex txqantl ti'xti' wi'yalqe'. Ex e'xitq'o'n nimaqtnam tok nimaqtapi kyi'j kye, atzu'n kawb'il xitq'o'n toj tq'ob' Joram, qu'n a tnejel tk'walju'. <verse number="4" style="v" />Tetzunj tkuwix Joram toj tkawb'ilju' tman, e'kub' tb'yo'n kykyaqilju' titz'in tu'n qesb'il ex junjun nejenel kye aj Israel. <verse number="5" style="v" />Tetoq junaq kab'lajoj (32) ab'q'i tej ttzyet tkawin, wajxaq ab'q'i kawin toj Jerusalen. <verse number="6" style="v" />Ax tb'inchaju' kse'n kyb'inchaju' nimaqkawil toj Israel ex kse'n kyb'incha tyajajil Akab', qu'n tyajajiltoq Akab' ju' t-xu'jil; qu'mtzun taq'wix b'je'la'ju' tb'inchb'aj twitz Qman Dyos. <verse number="7" style="v" />Atzunte Qman Dyos mixti' taj tu'n tkub' t-xitu'n tyajajil Dab'i tu'nju' ojetoq kyej b'entti'j jun tyol tuk'i'l Dab'i, ju' tzaj ttziya'n te, ex kyeju' tk'wal, qa kukxju' kk'antel jun kytzaj.</para>
  <para style="p">
    <verse number="8" style="v" />Tojtzu'n tq'ijlalil tkawb'il Joram, jawtiq'i'ntib' Edom ti'ju' tkawb'il Juda ex jaw t-sk'o'n tnimaqkawil. <verse number="9" style="v" />Xi'tzun Joramtz kyuk'i'lju' nejenel ex kykyaqilju' tkarwaj te q'oj, tetzun qonik'an jawe' kyuk'i'lju' nejenel kyi'j karwaj te q'oj, eb'jo'k tzaqpajtzuntz kyi'ju' aj Edom matxi'toq tz'ok kytxoli'n kyib' kyi'j. <verse number="10" style="v" />Kykanb'atzu'n aj Edom tu'n tel kypa'n kyib' ti'j Juda ex majx etzaqpaj. Ex tzaqpetju' nintnam Lib'na toju' tq'ijlalil lu, qu'n ojetoq tz'el tpa'ntib' Joram ti'j Qman Dyos Kydyos ojtxi' kyyajilb'en. <verse number="11" style="v" />Expe' tchaq' tu'n kyb'jaw b'incha'n ja xjan kye txqantl dyos kywi'witz toj Juda, tu'ntzun tpaju' min e'nimantlu' xjal toj Jerusalen te Qman Dyos, ex e'kub' ttzpet-sa'n aj Juda.</para>
  <para style="p">
    <verse number="12" style="v" />Atzu'n Eliy t-sanjelal Dyos xittz'ib'a'n jun u'j te Joram, intoq tma'n: Lu intma'n Qman Dyos ja k'uluna' Dab'i, ojtxi' tyajilb'ena:</para>
  <para style="pi">Minti' xtb'inchaya kse'n xtb'incha Josapat ju' tmana, ex kse'n tb'incha Asa nimaqkawil toj Juda, <verse number="13" style="v" />axxi'tkno'nju'ya kse'n nkyb'incha'n nimaqkawil toj Israel, tu'n tpaja min nche nimantlju' aj Juda exqe' najlqe' Jerusalen weye' ayine' Dyos Manb'aj kse'n kyb'incha toj tja Akab'. Expe' matxi' che kub' tb'yo'na titz'ina, ju' b'a'nqexi'xtoq kyetwitza. <verse number="14" style="v" />Qu'mtzun ktzajel nq'o'ne' jun yajb'il, ayine' Dyos Manb'aj, kyib'aju' ttanama, etk'wala, et-xu'jila ex kyib'aj kykyaqilju' ati teya. <verse number="15" style="v" />Ex ktzajel nq'o'ne' txqan yab'il tib'aja. Kb'el yab'tiya tu'n tk'u'ja, okxi'x kb'el b'o'lja tu'n, expe' kq'ayjelju' t-xqintxaya, chi Dyos, chi Eliy te.</para>
  <para style="p">
    <verse number="16" style="v" />Tb'inchatzun Qman Dyostz tu'n ttzaj kyq'oju' pilistey exqe' aj Arab'e najlqe' kyk'etzju' aj Kus ti'j Joram; <verse number="17" style="v" />eb'ajtzajtzuntz toj Juda, eb'jo'kx toju' tx'otx', b'ajx kyiq'i'n tkyaqilju' q'inumal knet kyu'n toj tja nimaqkawil, e'tk'wal exqe'tzu'n t-xu'jil. Naq o'kx Joakas kyejten, aju' ch'i'p. <verse number="18" style="v" />Tib'ajxi'tzun ja'lu, kub' ttz'e'ysa'n Qman Dyos twitz tu'n xka'tx'un mixti' q'a'nb'il te. <verse number="19" style="v" />Tetzunj tb'et q'ij, tb'aj kab'e' ab'q'i, eb'je'tzju' t-xqintxa tu'nju' yab'il, kyimtzun tu'n k'ixk'oj kuwxi'x. Mixpeti'x kub' kytxqo'n ttanam q'aq' te ninb'ilte, kse'n kyb'incha kyeju' ojtxi' tyajilb'en. <verse number="20" style="v" />Tetoq junaq kab'lajoj (32) ab'q'i tej ttzyet tkawin, wajxaq ab'q'i kawin toj Jerusalen, ex mix-a'lo'te oq' ti'j tej tkyim. Ku'x mqu'n toju' Ninttanam Dab'i, ex myatzu' kyoju' muqb'il kye nimaqkawil.</para>
  <chapter number="22" style="c" />
  <para style="s1">Tkawb'il Okosiy</para>
  <para style="r">(<ref loc="2KI 8:25-29">2 R 8.25-29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Atl Okosiy tch'i'p Joram okkyq'o'n xjal najlqe' toj Jerusalen te nimaqkawil te t-xelu' tman, qu'n kykyaqilju' tk'wal Joram, nimaqkawil toj Juda, tzikb'ajqe', e'kub' b'yo'n kyu'nju' jun tnej eleq' eb'jo'k kyuk'i'l aj Arab'ya toj kynajb'ilju' xjal te q'oj. Ikytzu'n tzyet tkawin Okosiy, tk'wal Joram, nimaqkawil toj Juda. <verse number="2" style="v" />Tetoq junaq kab'e' (22) ab'q'i tej ttzyet tkawin, jun ab'q'i kawin toj Jerusalen. Ataliy tb'iju' ttxu, tyajajil Omri. <verse number="3-4" style="v" />Ikxte Okosiy xitkno'n se'nx tb'incha Akab' kyuk'i'lju' tyajajil, qu'n toktoqu' ttxu q'ol taq'wix nab'l te, ex tu'nju' kyetoq tten kyuk'i'lju' toj tja Akab', taq'wix b'aj tb'incha'n twitz Qman Dyos. Ex aye'toq q'olte tnab'l tkyimlenxi'ju' tman, qu'mtzun kub' b'o'lj. <verse number="5" style="v" />Tu'ntzu'n xitb'i'nju' kynab'l, tmujb'atib' Okosiy tuk'i'l Joram, tk'wal Akab', nimaqkawil toj Israel, tu'n kyq'ojin ti'j Asael, nimaqkawil kye aj Sirya, toj Ramot te Kalaad. K'ixb'itzu'n Joram kyu'n aj Sirya, <verse number="6" style="v" />anjtztzun ti'j Joram toj Jesreel q'analteju' tk'ixb'len, qu'n tak' toj Ramot tej intoq che q'ojin ti'j Asael, nimaqkawil kye aj Sirya. Tu'ntzu'n yab'toq Joram, xi' Okosiy ka'yilte toj Jesreel.</para>
  <para style="s1">Kub' tb'yo'n Jewu Okosiy</para>
  <para style="r">(<ref loc="2KI 9:27-29">2 R 9.27-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" />Xima'ntltoq tu'n Dyos tu'n tkyim Okosiy tej txi' ka'yilte Joram. Naqtzun npon, eb'je'tz tuk'i'l Joram ti'j Jewu tk'wal Nimsi. Matxi'toqtzun jaw t-sk'o'n Qman Dyos Jewu tu'n kykub' tb'ajsa'n toj tja Akab'. <verse number="8" style="v" />Tej ljo'ntoq kykub' tb'yo'n Jewu toj tja Akab', eb'je'l yalju' nejenel toj Juda tu'n kyuk'i'lju' twitze'l Okosiy, intoq che ajb'en te, e'kub' tb'yo'ntzuntz. <verse number="9" style="v" />Ex tchaq' tu'n tjyet Okosiy, ju' matxi'toq kub' ewan toj Samarya, tzyettzuntz, xiq'i'n twitz Jewu, ex kub' b'yo'n. Tu'ntzu'n tk'wal Josapat ju' jyon ti'j Qman Dyos tu'n tkyaqil tk'u'j, kux mqu'n. Qu'mtzun mix-a'lo' juntl tyajajil Okosiy kyej tu'n tb'ent ttzyuntetlju' kawb'il.</para>
  <para style="s1">Oktq'o'ntib' Ataliy te nimaqkawil</para>
  <para style="r">(<ref loc="2KI 11:1-21">2 R 11.1-21</ref>)</para>
  <para style="p">
    <verse number="10" style="v" />Tej tb'inte Ataliy, ttxu Okosiy, qa matxi'toq kyimju' tal, xi' b'ajsalkye tk'walju' nimaqkawil toj Juda. <verse number="11" style="v" />Atzunte Jseb'a, tmyalu' nimaqkawil Joram, etztiq'i'n Joas, tk'wal Okosiy, kyxolju' txqantl tk'walu' nimaqkawil intoq che kub' b'yo'n, ex kub' tewa'n twitz Ataliy, tk'etzju' qya ch'isalte toj jun ja te wtab'l. Qu'mtzun min kub' b'yo'n. A Josab'a tmyalu' nimaqkawil Joram, tanab' Okosiy ex t-xu'jilju' pale Joyada, b'inchante ja'lu. <verse number="12" style="v" />E'wa'ntoq Joas kyuk'i'l, toju' tja Qman Dyos. Atzunte Ataliy intoq kawin toju' tx'otx'.</para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tojtzun twuqi'n ab'q'i, xitma'n Joyada tu'n kyxi' txokb'aju' nejenel kye xjal te q'oj, aye': Asariy tk'wal Jeroam, Ismael tk'wal Joanan, Asariy tk'wal Ob'ed, Maaseyiy tk'wal Adayiy, ex Elisapat tk'wal Sikri, ex b'antti'j kyu'n tu'n kymujb'ante kyib' tuk'i'l Joyada. <verse number="2" style="v" />Eb'ajxtzuntz toj tkyaqil Juda, e'tzaj kyb'u'yi'n aj Leb'i kyoj kykyaqil nimaqtnam Juda, exqe' nejenel kye junjun ja xjal aj Israel, exi'tzuntz kykyaqil toj Jerusalen. <verse number="3" style="v" />Kykyaqiltzunju' b'aj kyb'u'yi'n kyib' atzu', kyej b'entti'j jun kyol tuk'i'lu' nimaqkawil toju' tja Dyos.</para>
  <para style="p">Xitma'n Joyada kye: ¡Lu tk'wa' nimaqkawil ati kyuk'i'le'! Ate ati tu'n tokju' te nimaqkawil, kse'nx ttziya Qman Dyos kyib'aju' tyajajil Dab'i. <verse number="4" style="v" />A kyb'inchamju'ye' lu: jun toxi'n tnejkye', aye' pale ex aj Leb'i nche ajb'en toju' q'ij te ojlab'l, che xq'uqilteju' ttzi tja Dyos; <verse number="5" style="v" />atzun jun toxi'n tnejtel che tenb'il toju' nin tja kawb'il; atzu'n juntl toxi'n tnej ttzi jata'qe'ju' tq'uqlil. Kykyaqiltzunju' tnam xjal che tenb'il tpenju' tja Dyos. <verse number="6" style="v" />Mixtzun a'lo'te tu'n tokx toju' tja Dyos, naq oqe'kxju' pale ex aj Leb'i ate' toj kyajb'eb'l. O'qe'kxkye che okyix, qu'n xjansa'nqe'; aye'tzu'n txqantl xjal te tnam che xq'uqil te ninb'ilte Qman Dyos. <verse number="7" style="v" />K'okyel kytxoli'n kyib'ju' aj Leb'i ti'ju' nimaqkawil, teyile junjun tzyu'n tq'ojb'il, alkyete matz'okx toju' tja Dyos qa mya q'ma'n, kb'el b'yet. Che kxe'l tuk'i'lju' nimaqkawil jaxjaku' matxa', chi Joyada kye.</para>
  <para style="p">
    <verse number="8" style="v" />Xikyb'incha'n aj Leb'i kyuk'i'lju' xjal aj Juda tkyaqilju' tchaq' pale Joyada kye. Teyiletzun junjun nejenel kyuk'i'lju' t-xjal, jni'xqe'ju' nche xq'uqin toju' q'ij te ojb'il, kyuk'i'lju' intoq che ajb'en, qu'n min taju' pale Joyada tu'n kyanju' intoq che pon ch'exb'aj. <verse number="9" style="v" />B'ajxtzun tq'o'n Joyada txqan ch'ut ex chukchaq kolb'il kyeju' nejenel, aye' tetoq nimaqkawil Dab'i, ate'toq toju' tja Dyos. <verse number="10" style="v" />Ekub'tzun tnk'u'n kykyaqilju' xjal kytziju' tja Dyos, tzajx ttx'u'k toj tb'a'nq'ob' ex pomnix toju' juntl ttx'u'k toj tnayaj, ex ti'jileju' q'olb'eb'l, tzyu'nmile kych'ut tu'n kyxq'uqinteju' nimaqkawil. <verse number="11" style="v" />Tzajtzu'n Joyada kyuk'i'l tk'wal, etzkyiq'i'n tk'wal nimaqkawil, jaxkyq'o'n koron toj twi', ex b'ajx kyq'o'n techel toklen nimaqkawil te, tjawlenxtzun tqo'n aseyt toj twi' okkyq'o'n toklen te nimaqkawil. Eb'jaw ẍch'intzuntz kykyaqil: ¡B'a'nwt tena' nimaqkawil! chechij.</para>
  <para style="p">
    <verse number="12" style="v" />Tetzunj tb'inte Ataliy inxi'xtoq che ẍch'inju' xjal ex intoq jawkynima'n nimaqkawil, xi' toju' tja Qman Dyos ja b'u'yi'na'toq kyib'u' tnam. <verse number="13" style="v" />Xitka'yi'nju' nimaqkawil, wa'ltoq tk'etzju' tqan tilb'ilal ttziju' tja Dyos. Ate'toqju' nejenel kyuk'i'lju' aj chinb'al ttx'u'k, kykyaqiltzu'n xjal inxi'xtoq che tzalaj, intoq che kyq'ajtza'n chun; intoq xikyb'itza'n ajb'itzalju' b'itz te ninb'il tuk'i'l chnab'. Kub'tzun tlaqu'n Ataliy ti'j ex jawẍch'in:</para>
  <para style="p">—¡Matxi' che b'jaw miltz'uje'! ¡Matxi' che b'jaw miltz'uje' wi'je'! chij.</para>
  <para style="p">
    <verse number="14" style="v" />Atzunte pale Joyada tb'incha tu'n kyetzju' nejenel chaq'ul kyib'aj junjun tnej xjal te q'oj, xitma'n kye:</para>
  <para style="p">—Kyiq'imixe' kyxolu' xjal, alkyetzunte makolon ti'j, kyb'yonku'ye' tu'n qesb'il, chij.</para>
  <para style="p">Matxi'toqna' tchaq' pale, tu'n lalun kub' kyb'yo'n toju' tja Qman Dyos, <verse number="15" style="v" />kub' kytzyu'n ex etzkyiq'i'n ttzi kyja chej ttx'u'k nin ja te kawb'il, atzuntzu' kub' kyb'yo'na'.</para>
  <para style="p">
    <verse number="16" style="v" />Tb'ajlenxi'tzun ja'lu, kyej b'entti'j jun tyol Joyada tuk'i'l tkyaqilju' tnam ex tuk'i'lju' nimaqkawil, qa ttanam Qman Dyos qe'. <verse number="17" style="v" />Exi'tzuntz kykyaqil xitulteju' ja te k'u'lb'il te B'aal, eb'ajkub' kytxiju'nju' q'olb'eb'l exqe' witzileb'. Atzu'n Matan ju' pale te B'aal el kyk'uẍpi'n twi' kywitzju' q'olb'eb'l. <verse number="18" style="v" />Tb'ajlentzun ja'lu, e'kub' tq'o'n Joyada xq'uqil toju' tja Dyos, tjaq' kykawb'ilu' pale ex aj Leb'i, ju' e'kub' taq'pu'n Dab'i tej kykub' tnk'u'n tu'n kych'exb'ente kyib', tu'n kyajb'en toju' ja te k'u'lb'il tu'n tkub' kyq'o'n chojb'il k'ok'sb'il twitz Qman Dyos, kse'nx tku'x toju' tkawb'il Moyses, ex tu'n kyb'itzan tuk'i'l tzalajb'il, kse'nx kyejtma'n Dab'i. <verse number="19" style="v" />Ex e'kub' tq'o'n xq'uqil kytziju' tja Qman Dyos, tu'ntzun lalun tz'okx jun xjal toj qa mya ẍtilsa'ntib'. <verse number="20" style="v" />Eb'ajtzun tnk'u'nju' nejenel kye xjal te q'oj, e'xjal nim kyoklen, e'kawil kye tnam kyuk'i'l kykyaqilju' xjal, exi'tzuntz wab'alteju' nimaqkawil, e'tzajx toju' tja Dyos ex e'pon toju' nin tja kawb'il, ttziju' ja jawl eb'jo'kxa'. Kub'tzun kyq'uqb'a'n nimaqkawil toju' tq'uqb'il, <verse number="21" style="v" />kykyaqiltzun tnam xjal eb'aj tzalaj. Toj nak'b'il tena' nintnam, qu'n matxi'toqna' kub' b'yo'n Ataliy tu'n k'uẍtx'e'nb'il.</para>
  <chapter number="24" style="c" />
  <para style="s1">Tkawb'il Joas</para>
  <para style="r">(<ref loc="2KI 12:1-21">2 R 12.1-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tetoq wuq ab'q'i Joas tej ttzyet tkawin, kab'naq (40) ab'q'i kawin toj Jerusalen. Sib'ya tb'iju' ttxu, aj B'eerseb'a. <verse number="2" style="v" />B'a'n b'je'la' tb'inchb'aj Joas twitz Qman Dyos, tej itz'toqju' pale Joyada. <verse number="3" style="v" />Kub' mojb'a'n tu'n Joyada kyuk'i'l kab'e' t-xu'jil, e'ten tk'wal ex tmyal kyuk'i'l.</para>
  <para style="p">
    <verse number="4" style="v" />Tb'ajlenxi'tzun jte' q'ij, kub' t-xima'n Joas tu'n tb'aj tb'incha'ntlju' tja Dyos, <verse number="5" style="v" />tu'ntzu'n e'tzaja' tb'u'yi'nju' pale ex aj Leb'i, xitma'ntzuntz kye: Kukyxi'ye' kyoju' nimaqtnam toj Juda, kyb'uyime' pwaq kyxol kykyaqilju' aj Israel tu'n tajb'en b'inchb'ilte tja Dyos atl junjun ab'q'i. Kytxoktxonx kyib'e' b'inchalte ja'lu, chij. Aye'tzu'n aj Leb'i min oktilil kyu'n tu'n kyxi'. <verse number="6" style="v" />Tzajtzun ttxko'n nimaqkawilju' Joyada kynejel pale ex xitma'n te:</para>
  <para style="p">—¿Tiqu'n min nb'ajx tk'u'ja tu'n kyb'ajxu' aj Leb'i q'ilte oyaj toj Juda ex Jerusalen, kyejtma'n Moyses, tmajin Qman Dyos tuk'i'lju' tnam Israel tu'n tajb'en te tjaju' yol kyejni b'entti'j? chij te. <verse number="7" style="v" />Qu'n ojetoqna' che okxju' Ataliy, majx myab'a'n qe' kyuk'i'lju' lepchqe'k ti'j, toju' tja Dyos, ex b'ajx kyiq'i'n tkyaqilju' ti'xti' ate'toq toju' tja Dyos tu'n kyajb'en kyu'n toju' kyk'u'lb'il kye witzileb'. <verse number="8" style="v" />Xi'tzun tq'a' b'incha' nimaqkawil jun kax, kub' kyq'o'ntzuntz ttziju' tja Dyos, ti'jxi'. <verse number="9" style="v" />Xi'tzun kyq'o'n tqanil toj tkyaqil Juda ex Jerusalen tu'n ttzaj kyiq'i'n xjalju' kyoyaj te Qman Dyos, tchaq' Moyses tmajin Dyos, kye aj Israel toj chq'ajlaj. <verse number="10" style="v" />Kykyaqiltzu'n nejenel ex kykyaqilju' xjal te tnam eb'aj pon q'ol kyoyaj tu'n tkyaqil kyk'u'j toju' kax, tzmajx tnoj kyu'n. <verse number="11" style="v" />Qatzun matxi'toq chmetju' pwaq toju' kax, intoq xikyiq'i'n aj Leb'i twitzju' nimaqkawil tu'n tajlante, ajtzun tkub' kyka'yi'n nimtoqju' pwaq, intoq ponju' ttz'ib'al nimaqkawil ti'j tqanil ex jun ka'yil chq'o'n tu'nju' kynejel pale ex intoq jatz kyiq'i'nju' pwaq toj, ex intoq pon kyq'o'n jumajtlju' kax jatoq ta'. Tkyaqil q'ij intoq kyb'incha'n ikyju', ex nimtoq pwaq nchmet kyu'n. <verse number="12" style="v" />Intoq xikyq'o'n nimaqkawil tuk'i'l Joyada ju' pwaq lu kyeju' nejenel ti'ju' aq'untl ti'ju' tja Dyos, tu'n kyjyonte aq'unal ti'j ab'j ex ti'j tze, tu'n tb'aj kyb'incha'nju' tja Qman Dyos. Ex titoq tu'n kyjyonteju' b'a'n che aq'unan ti'j k'uxb'il ex q'anku'xb'il, tu'n tb'aj b'inchetju' ja te k'u'lb'il. <verse number="13" style="v" />E' aq'witzun nejeneltz aq'unal, ojexi'x lq'eju' aq'untl tu'n tb'aj b'inchetju' ja toj kyq'ob', pon jumajtlju' tja Dyos kyu'n kse'nqe'xju' tilb'ilal tnejel ex kyej kyb'incha'n b'a'nxi'x. <verse number="14" style="v" />Tetzunj tb'aj b'ent kyu'n, xikyiq'i'nju' pwaq minti' b'aj kyeju' nimaqkawil ex Joyada, xi'tzun kyq'a' b'incha' nimaqkawil aq'unb'il tu'n kyajb'en toju' k'u'lb'il ex kyeju' chojb'il k'ok'sb'il toj tja Dyos, e'nimaqpak' ex junjuntl aq'unb'il q'anpwaq ex saqpwaqqe'. Tej itz'xtoq Joyada e'kub' q'o'n chojb'il k'ok'sb'il kukxju' toju' tja Qman Dyos.</para>
  <para style="p">
    <verse number="15" style="v" />Kub'tzun tijin Joyada, matxi'toq tzaj lq'eju' tab'q'i, kyimtzuntz. Tetoq qaqnaq lajoj (130) ab'q'i tej tkyim; <verse number="16" style="v" />ku'x mqu'ntzuntz toju' Ninttanam Dab'i, kyk'etzju' nimaqkawil, qu'n b'a'n tb'incha teju' tnam Israel, te Dyos ex teju' ja te k'u'lb'il. <verse number="17" style="v" />Tkyimlenxi'tzun Joyada, eponju' nejenel te Juda ex jawkynima'n nimaqkawil. Xitb'i'n nimaqkawilju' kynab'l, <verse number="18" style="v" />kyajtzun kykolb'e'nju' tja Qman Dyos, ju' ek'ulun ojtxi' kyyajilb'en te, ek'uluntzuntz kyeju' tilb'ilal Asera ex kye txqantl witzileb'. Tzaj ttx'u'jil Qman Dyos ti'j Juda ex ti'j Jerusalen tu'n tpaju' il lu. <verse number="19" style="v" />E'tzajtzun tchq'o'n Qman Dyos t-sanjelal tu'n tanj jumajtlkyi'j tuk'i'l. Aye'tzu'n xjal mixti'x xikyb'i'nju' tzak'b'il kyu'n t-sanjelal Dyos.</para>
  <para style="p">
    <verse number="20" style="v" />Nojtzu'n Sakariy tk'walju' pale Joyada tu'n t-xew Qman Dyos, kub' we' Sakariy tib'aj jun b'us jawl toktza' kywitzju' tnam, xitma'ntzuntz kye: Luju' ntma'n Dyos:</para>
  <para style="pi">¿Tiqu'n min nche'x kynima'ne' nchaq'b'ile'? Aye'xe' nche tzaj q'inte taq'wix kyib'aje'. ¡Matxi'na' chin kyej kykolb'e'ne', ikxwe' che kjel nkolb'e'ne'! chi Dyos, chij.</para>
  <para style="p">
    <verse number="21" style="v" />Aye'tzunkye moje kytzi ex jawkyiq'i'nkyib' ti'j, ex toj tchaq'b'ilju' nimaqkawil, b'aj kyxon toj ab'j tpen tja Qman Dyos. <verse number="22" style="v" />Aju' xtalb'il tb'incha Joyada tman Sakariy teju' nimaqkawil Joas, ik'tna'l tu'n, ex Kub' tb'yo'n Sakariy, ju' tk'wal Joyada, tetzunj ch'inxtltoq tkyim tma: ¡Tzajxwit tka'yi'n Qman Dyos ja'lu ex che okxwite' toj xjel tu'n ti'ju' xkyb'inchaye'! chij.</para>
  <para style="p">
    <verse number="23" style="v" />Tetzunj ttzyet juntl ab'q'i, e'tzaju' xjal te q'oj aj Sirya q'ojil ti'j Joas, tetzunj kyul toj Juda ex Jerusalen, e'kub' kyb'ajsa'n kykyaqilju' nejenel toj tnam, b'ajx kysma'n tkyaqilju' elyal kyu'n teju' nimaqkawil toj Damask. <verse number="24" style="v" />Naq jni'xte' kyb'aju' xjal aj Sirya te q'oj e'pon, atzunte Qman Dyos e'xitq'o'n txqan xjal te q'oj nimxi'xtoq kyb'aj toj kyq'ob', tu'n tpaju' kyej kytzaqpi'n Qman Dyos, Kydyos ojtxi' kyyajilb'en. Iktzu'n kub'a' tz'e'ysa'n twitz Joas.</para>
  <para style="p">
    <verse number="25" style="v" />Tetzunj kyanju' aj Sirya, kyej kyk'ixb'sa'n Joas b'a'nxi'x, aye'tzuntlju' nche kawin tuk'i'l jawkyiq'i'nkyib' ti'j q'olte tu'me'l t-xelu' tkamik tk'wal pale Joyada, kub' kyb'yo'ntzuntz tojku' tkuẍb'il. Ku'x kymqu'ntzuntz toju' Ninttanam Dab'i, ex mya toju' muqb'il kye nimaqkawil.</para>
  <para style="p">
    <verse number="26" style="v" />Aye' jaw kyi'nq'i'nkyib'ju' ti'j, aye' Sab'ad tk'wal Simat, jun aj Amon, ex Josab'ad tk'wal Simrit, jun aj Moab'.</para>
  <para style="p">
    <verse number="27" style="v" />Aye'tzu'n tqanil kyi'ju' tk'wal Joas, e' yol q'manjtz ti'j, ex tej tb'aj tb'incha'nju' tja Qman Dyos, tkyaqil tz'ib'a'n toju' tu'jil chik'b'ab'l kyi'ju' u'j kye nimaqkawil. Atl Amasiyas ju' tk'wal kawin te t-xel.</para>
  <chapter number="25" style="c" />
  <para style="s1">Tkawb'il Amasiy</para>
  <para style="r">(<ref loc="2KI 14:1-22">2 R 14.1-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tetoq Junaqjo' (25) ab'q'i Amasiy tej ttzyet tkawin, junaq b'eljoj (29) ab'q'i kawin toj Jerusalen. Joadan tb'iju' ttxu, aj Jerusalen toq. <verse number="2" style="v" />B'a'nqe' tb'inchb'aj Amasiy twitz Qman Dyos, naqtzun aju' myaxi'x tu'n tkyaqil tk'u'j.</para>
  <para style="p">
    <verse number="3" style="v" />Tej tkuwix Amasiy toju' kawb'il, e'kub'tb'yo'n kykyaqilju' nejenel e'kub' b'yonteju' tman. <verse number="4" style="v" />Aye'tzu'n kyk'wal min e'kub'tb'yo'n, qu'n a tz'ib'a'nju' toju' tu'jil tkawb'il Moyses, aju' tchaq' Qman Dyos:</para>
  <para style="pi">Lay che kub' b'yetju' manb'aj tu'n tpaj kyb'inchb'aju' kyk'wal, ex lay che kub' b'yetju' k'wa'lb'aj tu'n tpaj tb'inchb'aju' kyman, teyilex junjunte' kkyimel tu'nxju' til, chi Dyos.</para>
  <para style="p">
    <verse number="5" style="v" />E' b'aj tb'u'yi'n Amasiy kykyaqilju' ichan kyyajajil Juda ex B'enjamin, ex eb'aj tnk'u'n kse'nxju' tojile kyjakyib' tjaq' kychaq'b'il nejenel kye xjal te q'oj. Tchaq'tzuntz tu'n tjaw kyajlal, kykyaqilju' txiqex kyab'q'i te winqi'n (20), junaq wuqlajmutx' lajk'al (300,000) ichan sk'o'nqe' te q'oj eb'je'l yal, b'entnikyten tu'n kyxi' q'ojil ex b'a'n che q'ojin tuk'i'l ch'ut ex kolb'il. <verse number="6" style="v" />Expe' e'tchoj kab'lajmutx' lajk'al (100,000) xjal aj Israel te q'oj, tu'n oxnaq kab'lajoj kyintal tk'i' oxnaq lib'r (72.60) saqpwaq.</para>
  <para style="p">
    <verse number="7" style="v" />Pontzun jun tmajin Dyos twitz, ex xitma'n te:</para>
  <para style="p">—Nimaqkawil, lalun tz'ok kychmo'n kyib'ju' xjal aj Israel te q'oj tuk'i'la, qu'n mix-a'lo' te Qman Dyos kyuk'i'lu' aj Israel, ex kyuk'i'l kykyaqilju' tyajajil Eprayin lu. <verse number="8" style="v" />Qatzun tajb'ila tu'n kykuwix t-xjala kyu'n aj Israel tu'n kyxi'ye' q'ojil, ktb'incha' Dyos tu'n tkub' ti'ja kyu'n tajq'oja, qu'n atite Dyos tipumal tu'n tonin ex tu'n t-xitun, chij te.</para>
  <para style="p">
    <verse number="9" style="v" />Xi'tzun tqani'n Amasiy teju' tmajin Dyos:</para>
  <para style="p">—Naqtzun aju', ¿Ti'tzu'n kb'ajel ti'ju' oxnaq kab'lajoj kyintal tk'i' oxnaq lib'r (72.60) saqpwaq xxinq'o'ne' kyeju' aj Israel te q'oj? chij.</para>
  <para style="p">Xittzaq'we'nju' tmajin Dyos te:</para>
  <para style="p">—Atina' te Qman Dyos tuk'i'l tu'n ttzaj tq'o'n txqantl nim teya kyetwitzju' lu, chij te.</para>
  <para style="p">
    <verse number="10" style="v" />Xi'tzun tma'n Amasiy tu'n tel kypa'n kyib'u' tyajajil Eprayin te q'oj eb'ju'l tu'n kyonin ti'j, ex tu'n tanjkyi'j kyja. Aye'tzunkye tzaj kytx'u'jil ti'j Juda, inxi'xtoq che tx'u'jin tej kyanj kyja.</para>
  <para style="p">
    <verse number="11" style="v" />Tb'inchatzun tib' Amasiy ex exitiq'i'nju' t-xjal te q'oj toju' B'ya' Atz'an tb'i, ex e'kub'tb'yo'n junmutx' jok'al (10,000) ichan aj Seyir. <verse number="12" style="v" />Expe' e'kub'kytzyu'n aj Juda junmutx' jok'altl (10,000) ichan itz'qe', exikyiq'i'ntzuntz twi' jun witz pikyile; tzmaxtzuntzu' e'tzaj kyxona', kykyaqilx eb'aj q'uchj.</para>
  <para style="p">
    <verse number="13" style="v" />Aye'tzuntlju' xjal te q'oj mixti'x taj Amasiy tu'n kyonin ti'j, ex e'xitchq'o'n tu'n kyanj kyja, b'ajkub' kyq'o'n kyib' kyoju' nimaqtnam toj Juda, tzajx Samarya ex ponx B'et-oron, e'kub' kyb'yo'n wuqk'al lajnaq (3,000) xjal ex nim txqan ti'xti' b'ajx kyelq'a'n.</para>
  <para style="p">
    <verse number="14" style="v" />Tetzun tanjtzti'j Amasiy, tkub'le kyi'ju' aj Edon tu'n, e'tzaj tiq'i'n kydyosu' aj Seyir, ex eb'jo'ktq'o'n te tdyos, k'ulun kye ex kub' ttz'e'ysa'n sturak kywitz. <verse number="15" style="v" />Tzaj ttxu'jil Qman Dyos ti'j Amasiy, tzajtzun tchq'o'n jun t-sanjelaltz q'malte te:</para>
  <para style="p">—¿Tiqu'n atzu' njyona'ya kyi'ju' tdyos jun tnam min xb'ent tklet toj tq'ob'a kyu'n?</para>
  <para style="p">
    <verse number="16" style="v" />Tetzunj intoq tma'n t-sanjelal Dyos ja'lu, xittzaq'we'n nimaqkawil te:</para>
  <para style="p">—¿Maxi'nitzun nq'o'ne' toklena te q'ol nab'l toju' kawb'il? ¡K'oltziya! ¿Mujqa tajb'ila tu'n tkyima? chij.</para>
  <para style="p">Min ok iltlju' t-sanjelal Dyos, atlte tmaju':</para>
  <para style="p">—B'i'n wu'ne' qa matxi' kub' t-xima'n Dyos tu'n tkub' najsa'na tu'n, tu'nju' xtb'inchaya lu ex min xxi' tb'i'na nyole', chij.</para>
  <para style="p">
    <verse number="17" style="v" />Atzunte Amasiy, nimaqkawil toj Juda, xitb'i'n kynab'l txqantl, xit-sma'n tq'umli te Joas, nimaqkawil toj Israel, tk'wal Joakas ex tchman Jewu: Kutzaja tu'n tokmoje qwitz, chij. <verse number="18" style="v" />Atzunte Joas tzaj ttzaq'we'n tuk'i'lju' techlal lu: xit-sma'n tq'umliju' ch'i'x teju' k'ute toj Lib'ano: Q'ontzju'ya tmyala te t-xu'jilu' nk'wale', chij. O'kx tik' jun tojk'ul txkup atzu', majxkub' twab'e'nju' ch'i'x. <verse number="19" style="v" />Tu'nloju' matxi' kub'kyi'j aj Edom tu'na, in tnima'n tib'a ex tajb'ila tu'n tjaw nima'nxi'xtla. Ate b'a'nju' tenkja tjaya. ¿Tiqu'n axa njyonte taq'wix tib'aja ex tib'aj Juda? chij te.</para>
  <para style="p">
    <verse number="20" style="v" />Atzunte Amasiy mixti'x xitb'i'n, qu'n xima'ntltoq tu'n Dyos ikju', tu'n kyxitq'o'n toj tq'ob' Joas, tu'n tpaju' atzu' e'jyona' kyi'ju' kydyos aj Edom. <verse number="21" style="v" />Tzajtzun Joas q'ojil ti'j Amasiy toj B'et-semes, toju' tx'otx' Juda. <verse number="22" style="v" />Kub'tzun ti'j Juda kyu'n aj Israel, ex teyile jun xi' oq tja. <verse number="23" style="v" />Okx jpu'n Amasiy nimaqkawil toj Juda tu'n Joas nimaqkawil toj Israel, toj B'et-semes, xitiq'i'ntzuntz Jerusalen, extb'incha'n jun b'e te b'eljojnaq (180) metr tqan toju' nintapi ti'j Jerusalen, tzajx ttzi tjpel tnam Eprayin tb'i, ponx ttziju' tjpel toj ttx'u'k. <verse number="24" style="v" />Expe' b'ajxtiq'i'n tkyaqilju' q'anpwaq ex saqpwaq, ex kykyaqilju' ti'xti' ate'toq toj tja Dyos toj tq'ob' Ob'ed-edom exqe' ti'xti' kyoju' k'uwenj ate'toq toj tja nimaqkawb'il. Ex eb'jax tiq'i'n jte' xjal ati kyoklen, anjtzun ti'jtz Samarya.</para>
  <para style="p">
    <verse number="25" style="v" />Anq'inx o'lajoj (15) ab'q'itl Amasiy, tk'wal Joas, nimaqkawil toj Juda, tkyimlenxi' Joas, tk'wal Joakas, nimaqkawil toj Israel. <verse number="26" style="v" />Xi' tz'ib'a'na' txqantl tqanil ti'j Amasiy, tzajx tnejel ex ponx te b'ajsb'il, toju' u'j kye nimaqkawil toj Juda ex Israel. <verse number="27" style="v" />Atxi'x tej tel tpa'ntib' Amasiy ti'j Qman Dyos, jawkyiq'i'nkyib'u' xjal toj Jerusalen ti'j, xi' oqtzuntz toj nintnam Lakyis; aye'tzu'n xjal exi' lpe ti'j tzmax toju' nintnam lu, atzuntzu' kub'a' kyb'yo'n. <verse number="28" style="v" />Xikyiq'i'ntzuntz tib'aj jun chej ex ku'x kymqu'n kyk'etzju' ojtxi' kyyajilb'en, toju' Ninttanam Dab'i.</para>
  <chapter number="26" style="c" />
  <para style="s1">Tkawb'il Osiy</para>
  <para style="r">(<ref loc="2KI 14:21-22">2 R 14.21-22</ref>; <ref loc="2KI 15:1-7">15.1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Kykyaqiltzu'n xjal aj Juda, okkyq'o'n Osiy te nimaqkawil te t-xel Amasiy ju' tman, tetoq qaqlajoj (16) ab'q'i, <verse number="2" style="v" />atzun chaq'unte tu'n tjaw b'inchet jumajtlju' nintnam Elat, tkyimlenxi'ju' tman, ex kanb'et jumajtl tu'n.</para>
  <para style="p">
    <verse number="3" style="v" />Tetoq qaqlajoj (16) ab'q'i Osiy tej ttzyet tkawin, kab'naq kab'ljoj (52) ab'q'i kawin toj Jerusalen. Jekoliy tb'iju' ttxu, aj Jerusalen toq. <verse number="4" style="v" />B'a'n tb'inchb'aj Osiy twitz Qman Dyos, kse'nx tb'incha Amasiy ju' tman. <verse number="5" style="v" />Oktq'o'n tilil tu'n tjyon ti'j Dyos tej itz'xtoq Sakariy, ju' xnaq'tzante tu'n tniman te Dyos. Ex tej intoq jyon ti'j Qman Dyos, tkyaqilju' ntb'incha'n b'a'ntoq nnela'. <verse number="6" style="v" />Xi' Osiy q'ojil kyi'ju' pilistey, ex eb'ajkub' t-xitu'n nimaqtapi ti'j Kat, ti'j Jab'nya ex ti'j Asdod, ex tchaq' tu'n kyb'jaw b'incha'n nimaqtnam toju' tx'otx' Asdod, kyxol pilistey. <verse number="7" style="v" />Oninjtz tu'n Dyos tu'n tkub'kyi'ju' pilistey, aj Arab'ya ju' najlqe'toq Wur-b'aal, ex aj Mewnit. <verse number="8" style="v" />Intoq che chojon aj Amon te Osiy, xi'tzun mlen tyolinjtz Osiy tzmax ja ta'qe' tnaqachil Ejipt, qu'n matxi'xi'xtoq ch'iyu' tipumal. <verse number="9" style="v" />Ex tchaq' tu'n kyb'jaw tb'incha'n ja nimaq kywe' toj Jerusalen, kyib'aju' ttzi tnam ttx'u'k, te b'ya' ex tib'aju' ttx'u'k, ex eb'aj tkuwsa'n. <verse number="10" style="v" />Expe' tchaq' tu'n kyjaw b'incha'n ja nimaq kywe' toj chq'ajlaj, ex tchaq' tu'n kyku'x b'incha'n txqan xoch, qu'n nimtoq talu'n ati, toju' plan tx'otx' ex kywi'witz. Ex ate'toq tmajin nche' aq'unan kyoju' ttx'otx' ex toj tqan ub'a tzyu'ntoq tu'n kywi'witz ex kyoju' tx'otx' te awb'il, qu'n atitoq tk'u'j tu'n taq'unan ti'j awal.</para>
  <para style="p">
    <verse number="11" style="v" />Ex atitoq jun tnej t-xjal Osiy b'incha'ntl kyten tu'n kyq'ojin, intoq cheb'je'x toj q'oj nk'u'n kyten toj k'loji'n, kse'nxju' tajlal jaw tu'n Jeyel, tz'ib'al tqanil kye nimaqkawil, ex tu'n Maaseyiy, nejenel tjaq tkawb'il Ananiy, jun kyxolju' tchaq'ul nimaqkawil. <verse number="12" style="v" />Qaqk'al lajnaq (2,600) kyb'aju' nejenel kyeju' toj kyjakyib', nimaq q'ojilqe' min nche xob'. <verse number="13" style="v" />Jun tnej xjal te q'oj, junaq wajxaqlajmutx' wajxaqk'al o'lajnaq (307,500) kyb'aj tjaq' tkawb'il, b'antnitltoq kyten tu'n kyq'ojin, atixi'xtoq kyipumal tu'n kyonin ti'ju' nimaqkawil toj q'oj. <verse number="14" style="v" />Eb'aj tb'incha'n Osiy kolb'il, ch'ut, kolb'il wi'yb'aj, kolb'il ttzik'u'jb'aj, smaj ex ka'yb'il kye kykyaqilju' xjal te q'oj. <verse number="15" style="v" />Expe' tchaq' tu'n kykub' b'incha'n aq'unb'il te q'oj toj Jerusalen, tu'n kykub' q'o'n kyoju' ja nimaq kywe' ex kyib'aju' nimaqtapi kyoju' plaj nimaqxi'x kywe', tu'ntzun kyxi' xon talsmaj ex nimaq ab'j tzmax ja ate'qe'. Ximlenju' tyolinjtz najchaq, qu'n onin Dyos nimxi'x ti'j, qu'mtzun nimxi'x tipumal ten.</para>
  <para style="p">
    <verse number="16" style="v" />Tetzunj tkuwix toju' kawb'il, jawtnima'n tib', atzun kub' xitunteju'. Min nimantl te Qman Dyos, qu'n okx toju' tja Qman Dyos tz'e'ysal sturak tib'aju' q'olb'eb'l. <verse number="17" style="v" />Atzu'n pale Asariy okxlpe ti'j kyuk'i'l kyajnaq (80) pale te Qman Dyos min nche xob', <verse number="18" style="v" />ok kywab'a'nkyib' twitzju' nimaqkawil ex xikyma'n te: Nimaqkawil Osiy, myata q'ma'n tu'n tkub' q'onte sturak twitz Qman Dyos, aye'kye' paleju' tyajajil Aaron tu'n kykub' q'onte, xjansa'nqe' tu'n kyb'inchante. Kutexa nimaqkawil toju' ja xjan, qu'n minti' xxi' tnima'na tchaq'b'il Qman Dyos, ex lay jaw nima'na tu'n Dyos tu'nju' xtb'inchaya lu, chechij te.</para>
  <para style="p">
    <verse number="19" style="v" />Tzaj ttx'u'jil Osiy kyi'ju' pale, tzyu'ntoq jun tkb'el sturak tu'n. Tojtzu'n kmoj lu, etz b'ent xlemtx'a'k ti'ju' twitz tojku' tja Dyos, tk'etzju' q'olb'eb'l ex kywitzku' pale. <verse number="20" style="v" />Tetzunj txi' ka'yi'n tu'n Asariy kynejel pale kyuk'i'lju' txqantl pale, matxi'toq b'je'tz b'ent xlemtx'a'k twitz, lwiyxi'x etzkyiq'i'n atzu'; ex aku' tajb'iltoq tu'n tetz lwiyxi'x, qu'n matxi'toq kub' tz'e'ysa'n twitz tu'n Qman Dyos.</para>
  <para style="p">
    <verse number="21" style="v" />Anq'inju' nimaqkawil Osiy toj xlemtx'a'k tzmax tej tkyim, qu'mtzun najan toj jun ja najchaq, min ajonjtztl tu'n tokx toju' tja Dyos, toj tq'ob'tl Jotam ju' tk'wal tena'ju' kawb'il, atlte kawinteju' tnam.</para>
  <para style="p">
    <verse number="22" style="v" />A Isayiy t-sanjelal Dyos, tk'wal Amos, kub' tz'ib'ante jni'tl tqanil ti'j Osiy, tzajx tnejel tzmajx te b'ajsb'il. <verse number="23" style="v" />Tetzunj tkyim Osiy, ku'x mqu'n kyk'etzju' ojtxi' tyajilb'en toj jun tx'otx' kye nimaqkawil, qu'n xlemtx'a'k toqti'j. Atl Jotam ju' tk'wal kawin te t-xel.</para>
  <chapter number="27" style="c" />
  <para style="s1">Tkawb'il Jotam</para>
  <para style="r">(<ref loc="2KI 15:32-38">2 R 15.32-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tetoq junaqjo' ab'q'i (25) Jotam tej ttzyet tkawin, qaqlajoj (16) ab'q'i kawin toj Jerusalen. Jerusa tb'iju' ttxu, tmyal Sadok. <verse number="2" style="v" />B'a'n tb'inchb'aj Jotam twitz Qman Dyos, kse'n tb'incha Osiy ju' tman. Naq aju' min okx toju' tja Qman Dyos. Aye'tzu'n tnam xjal xikyljo'n kyb'inchanteju' myab'a'n. <verse number="3" style="v" />Ate Jotam chaq'unte tu'n tjaw b'inchet tjpel tja Qman Dyos toju' plaj jawl, exqe' txqantl b'jaw tb'incha'n ti'ju' nintapi ti'j Opel. <verse number="4" style="v" />Ex tchaq' tu'n kyjaw b'inchet nimaqtnam twi' witz toj Juda, exqe' ja kuwsa'nqe', e' ja nimaq kywe' kyoju' k'ul. <verse number="5" style="v" />Q'ojin tuk'i'l nimaqkawil kye aj Amon ex kub'kyi'j tu'n. Toju' ab'q'i lu, tzaj kychjon aj Amon oxnaq kab'lajoj kyintal tk'i' oxnaq lib'r (72.60) saqpwaq, oxlajnaq o'lajoj mutx' (2,200,000) litr triy ex txqantl seb'ad te chojb'il te. Ex kyinxchaq kychoju' te toju' tkab' ex toj toxi'n ab'q'i.</para>
  <para style="p">
    <verse number="6" style="v" />Nimtipumal Jotam ten, qu'n b'a'n tena' tchwinqlal twitz Qman Dyos. <verse number="7" style="v" />Xi' tz'ib'a'na' txqantl tqanil ti'j Jotam, tkyaqilju' nyolin ti'ju' tej tq'ojin ex kyi'ju' tb'incha, toju' tu'jil tqanil kyi'j nimaqkawil toj Israel ex toj Juda.</para>
  <para style="p">
    <verse number="8" style="v" />Tetoq junaqjo' (25) ab'q'i Jotam tej ttzyet tkawin, ex qaqlajoj (16) ab'q'i kawin toj Jerusalen. <verse number="9" style="v" />Tetzunj tkyim, ku'x mqu'n kyk'etzju' ojtxi' tyajilb'en toju' Ninttanam Dab'i. Atl Ajas ju' tk'wal kawin te t-xel.</para>
  <chapter number="28" style="c" />
  <para style="s1">Tkawb'il Ajas Toj Juda</para>
  <para style="r">(<ref loc="2KI 16:1-20">2 R 16.1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tetoq winqi'n ab'q'i Ajas tej ttzyet tkawin, qaqlqjoj ab'q'i kawin toj Jerusalen; myab'a'n tb'inchb'aj twitz Qman Dyos, mikxa' kse'n tb'incha Dab'i ojtxi' tyajilb'en, <verse number="2" style="v" />xitkno'n kse'n nkyb'incha'n nimaqkawil toj Israel, ex tchaq' tu'n kykub' b'incha'n tilb'ilal B'aal k'uxb'ilqe', <verse number="3" style="v" />kub' ttz'e'ysa'n sturak toju' b'ya' B'en-inom ex tb'incha tu'n kykub' tz'e'ysa'n tk'wal te chojb'il kse'n kyb'inchb'aju' tnam taq'wixi'xju' eb'je'x tiq'i'n Qman Dyos kywitzu' aj Israel. <verse number="4" style="v" />Expe' e'kub'tq'o'n chojb'il ex kub' ttz'e'ysa'n sturak kyoju' ja xjan kye txqantl dyos, kywi'witz ex kyxe kykyaqilju' tze pujin kyxaq.</para>
  <para style="p">
    <verse number="5" style="v" />Tu'ntpajtzu'n lu, xitq'o'n Qman Dyos toj tq'ob'ju' nimaqkawil aj Sirya, kub'ti'j kyu'n aj Sirya, ex nim t-xjal tzyet kyu'n ex exi' kyiq'i'n toj Damask. Ex ikx xitq'o'n Qman Dyos toj tq'ob'u' nimaqkawil aj Israel, ex ojexi'x kub'kyi'j tu'n. <verse number="6" style="v" />A Peka, tk'wal Remaliy, kub' b'yonkye o'lajmutx' (120,000) ichan toj Juda naq toj jun q'ijx, kykyaqil ichanqe' min nche xob', tu'n tpaj kyej kykolb'e'n Qman Dyos Kydyos ojtxi' kyyajilb'en. <verse number="7" style="v" />Atzu'n Sikri, jun nimaq q'ojil kyxol tyajajil Eprayin, kub'yonkye Maaseyiy tk'walu' nimaqkawil, ex Asrikam nejenel toju' ja te kawb'il, ex Elkana tnejil onil ti'ju' nimaqkawil. <verse number="8" style="v" />Exqepe' xjal te q'oj te Israel, e'okx kyjpu'n junaqjo' mutx' (200,000) xjal aj Juda, e'qya, e'qa' ex e'txin, ex nim txqan ti'xti' xikyiq'i'n Samarya.</para>
  <para style="p">
    <verse number="9" style="v" />Atitoqtzun jun t-sanjelal Dyos atzu', Ob'ed tb'i, etz k'lulkyeju' xjal te q'oj tej ljontoq kyokx toj Samarya, ex xitma'n kye:</para>
  <para style="p">—Tzaj ttx'u'jil Qman Dyos, Kydyos ojtxi' qyajilb'en, kyi'ju' aj Juda, qu'mtzun mache kub' tq'o'n toj kyq'ob'e'. Aye'tzunkye' mache kub' kyb'yo'ne' tu'n kytx'u'jile', ex matxi' japun ja'lu toj kya'j. <verse number="10" style="v" />Expe' matxi' kub' kyxima'ne' tu'n kyoku' xjal aj Juda ex aj Jerusalen te kymajine' lq'o'n. ¿Ma mixtzunti' kye' kyil twitz Qman Dyos? <verse number="11" style="v" />Qu'mtzun, chin kyb'ime' ex che kytzaqpinqe'xu'ye' xjal presi'nqe' kyu'ne' extzun kyitz'in kyib'e' kyuk'i'l, qu'n matxi' tzaj ttx'u'jil Qman Dyos kyi'je', chi t-sanjelal Dyos. <verse number="12" style="v" />E' tzajtzu'n Asariy tk'wal Joanan, B'erekyiy tk'wal Mesilemot, Esekyiy tk'wal Salum, ex Amasa tk'wal Adlay, ju' nejenelqe'toq nimaq kyoklen kyxol tyajajil Eprayin, e'kub'we' kywitzju' anjniqe'toq toj q'oj, <verse number="13" style="v" />xikyma'ntzuntz kye:</para>
  <para style="p">—Lalun che tzaj kyiq'i'nju'ye' pres tza'lu, qu'n tu'nju' lu ati qil twitz Qman Dyos. Tu'nju' kkyb'incha'ye', kchmetilxi'xtl qil ex qpaj, extzun nimxi'pena', ktzajeltzun ttx'u'jil Qman Dyostz nimxi'x qi'j ayo' aj Israel, chechij kye.</para>
  <para style="p">
    <verse number="14" style="v" />Aye'tzu'n xjal te q'oj e'xi' kytzaqpi'nju' pres exqe'tzu'n ti'xti' b'je'l kyiq'i'n kyej kyq'o'n kywitzju' nejenel ex kywitzju' tnam. <verse number="15" style="v" />Aye'tzu'n q'ma'ntlu' kyb'i jawl, exi' ka'yinkye pres, ex b'jatz kyiq'i'n xb'alun kyojxju' ti'xti' b'je'l kyiq'i'n kye, tu'n kyktxetju' ẍb'iqlqe'toq, ex b'jo'k kyq'o'n kyxajab', b'ajx kyq'o'n kywa ex kyk'wa', ex b'aj kyq'a'na'nju' kyk'ixb'len, kykyaqiltzu'n mixti'tl kyipumal tu'n kyb'et exi' iq'i'n kyib'aj b'ur tzmax Jeriko, ju' nintnam nim tut toj, e'kyaj kyq'o'ntzuntz kyk'etz kywitze'l. Anjtzun kye kyi'jtz toj Samarya.</para>
  <para style="p">
    <verse number="16" style="v" />Toju' tq'ijlalil lu, xitchq'o'n nimaqkawil Ajas t-sanjelal qanil o'nb'il te nimaqkawil aj Asirya, <verse number="17" style="v" />qu'n matxitoq che b'jo'ktlju' aj Edom ex matxi'toq kub'ti'ju' Juda kyu'n, ex b'ajx kyiq'i'n junjun xjal pres. <verse number="18" style="v" />Exqe'tlu' pilistey, matxitoq kub'kyi'ju' nimaqtnam toj plan tx'otx' ex toj Nekeb' te Juda kyu'n; e'kub'kyetza' B'et-semes, Ayalon ex Wederot, ex ikxqe' Soko, Timna ex Wimso kyuk'i'lxi' kykojb'il, ex matxi'toq che kub'ten kyoj. <verse number="19" style="v" />Ojetoq kub't-xima'n Qman Dyos tu'n kykub' tme'ssa'n aj Juda tu'n tpaj Ajas, nimaqkawil toj Juda, qu'n a kub'nej b'inchal myab'a'n twitzu' tnam ex matxi'toq tz'el tpa'ntib' ti'j Qman Dyos.</para>
  <para style="p">
    <verse number="20" style="v" />Atzunte Tijlat-pileser, nimaqkawil aj Asirya, mixti'x onin ti'j Ajas, xi'pe' tzaja' q'ojil ti'j ex okten yajlalte. <verse number="21" style="v" />Maskyepe' eb'je'tz tiq'i'n Ajas ti'xti' twi' wi'yal toju' tja Dyos, ex toju' tja nimaqkawb'il ex kyoj kyja nejenel tu'n t-xitchjo'n teju' nimaqkawil aj Asirya, mixti'x oninjtz. <verse number="22" style="v" />Maskyepe' matxitoq tzaju' yajb'il lu ti'j, kukxtoq tb'inchan ilju' twitz Qman Dyos. ¡Iktzun anq'ina' nimaqkawil Ajas ju'! <verse number="23" style="v" />E'kub'tq'o'n chojb'il kywitzju' kydyos aj Damask, tu'ntzunju' kub'a' ti'j. Chilo qa matxitoq che onin kydyos aj Sirya kyi'ju' nimaqkawil teju' tx'otx' lu, exqa ikxte k'oninjtzel kyu'n qama kub' tq'o'n chojb'il kywitz. Kyu'npe'kye tzaja' xitb'il tib'aj ex kyib'aj kykyaqil aj Israel. <verse number="24" style="v" />Eb'aj tb'u'yi'n Ajas ju' aq'unb'il toj tja Dyos ex eb'ajkub' tb'uchi'n, eb'aj kub'tjpu'n ttziju' tja Dyos ex tchaq' tu'n kykub' b'incha'n q'olb'eb'l kye txqantl dyos kyoj kykyaqilju' ttx'u'k Jerusalen. <verse number="25" style="v" />Tchaq' tu'n kyb'jaw b'incha'n ja xjan kyoj kykyaqilju' nimaqtnam toj Juda tu'n ttz'e'yset sturak kye txqantl dyos, ikytzu'n oktq'o'n ttx'u'jil Qman Dyos Kydyos ojtxi' kyyajilb'en.</para>
  <para style="p">
    <verse number="26" style="v" />Xi' tz'ib'a'na' txqantl tqanil ti'j Ajas ex tkyaqilju' tb'incha, ttzajku' qe ex tej tpon b'aj, toju' u'j kye nimaqkawil toj Juda ex te Israel. <verse number="27" style="v" />Tej tkyim, ku'x mqu'n kyk'etzju' ojtxi' tyajilb'en toju' nintnam Jerusalen, myatzu' toj muqb'il kye nimaqkawil toj Israel. Atl Esekyiy ju' tk'wal kawin te t-xel.</para>
  <chapter number="29" style="c" />
  <para style="s1">Tkawb'il Esekyiy</para>
  <para style="r">(<ref loc="2KI 18:1-3">2 R 18.1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tetoq junaqjo' (25) ab'q'i Esekyiy tej ttzyet tkawin, ex junaq b'eljoj (29) ab'q'i kawin toj Jerusalen. Ab'i tb'iju' ttxu, ex tmyal Sakariy. <verse number="2" style="v" />B'a'n tb'incha Esekyiy twitz Qman Dyos, kse'n tkyaqilju' tb'incha Dab'i ojtxi' tyajilb'en. <verse number="3" style="v" />A jqonkyeju' tjpel tja Qman Dyos toj tnejel xjaw teju' tnejel ab'q'i nkawin, ex eb'aj tb'incha'n. <verse number="4" style="v" />E' tzaj ttxko'ntzun paletz exqe' tyajajil Leb'i, eb'aj tb'u'yi'n ttxa'n tpen tja Dyos toj tjawetzq'ij <verse number="5" style="v" />ex xitma'n kye: Chin kyb'itze' tyajajil Leb'i: kyẍtilsam kyib'e' ja'lo, ex kyẍtilsame' tja Qman Dyos Kydyos ojtxi' kyyajilb'ene'. Kyiq'imitze' tkyaqilju' myab'a'n toju' ja xjan. <verse number="6" style="v" />Qu'n eb'inchan ilu' ojtxi' qyajilb'en, taq'wixu' kyb'inchb'aj twitz Qman Dyos, ex kyej kykolb'e'n. Elkypa'n kyib' ti'j ex el kyik'o'nju' najb'il ja ntzaja' na'n Qman Dyos. <verse number="7" style="v" />Kub' kyjpu'n kyjpelju' ja ate' twitz tja Dyos, b'aj kyej kyupi'nju' kandil, mixti' kub' kytz'e'ysa'ntl sturak ex mixti' kub' kytz'e'ysa'ntl chojb'il k'ok'sb'il te Qman Dyos toju' ja xjan. <verse number="8" style="v" />Tu'n tpajtzu'n tzaj ttx'u'jil Qman Dyos kyi'j aj Juda ex aj Jerusalen, ex mache kyej tq'o'n xob'ajilx ex tzajx kychi, ex makyile' tu'nku' kywitze'. <verse number="9" style="v" />Qu'mtzun e'kyimu' qman toj q'oj, aye'tzu'n qk'wal e' qmyal exqe'ju' qxu'jil exi' iq'i'n pres. <verse number="10" style="v" />Qu'mtzun, matxi' kub' nximane' tu'n tkyejb'ent ti'j jun nyole' tuk'i'lu' Qman Dyos ati kyib'aj aj Israel, tu'n telu' ttx'u'jil qi'j. <verse number="11" style="v" />Qu'mtzun e'nk'wal, lay naq che ka'yine', ojena' che b'jaw sk'o'ne' tu'n Qman Dyos tu'n kytene' twitz ex tu'n kyab'ene' te, ex tu'n tkub' kyq'o'ne' sturak twitz, chi Esekyiy.</para>
  <para style="p">
    <verse number="12" style="v" />Aye'tzu'n tyajajil Leb'iju' lwiyxi'x e'aq'wi aq'unal: kyxolju' tyajajil Kyeat, aye': Maat tk'wal Amasay ex Joel tk'wal Asariy; kyxol tyajajil Merari, aye' Kyis tk'wal Ab'di ex Asariy tk'wal Jealeel; kyxol tyajajil Werson, aye' Joa tk'wal Sima ex Eden tk'wal Joa; <verse number="13" style="v" />kyxol tyajajil Elisapan, aye' Simri ex Jeyel; kyxol tyajajil Asap, aye' Sakariy ex Mataniy; <verse number="14" style="v" />kyxol tyajajil Eman, aye' Jeyel ex Simi, atzu'n kyxol tyajajil Jedutun, aye' Semayiy ex Usyel. <verse number="15" style="v" />Tnejel eb'aj kyb'u'yi'n kywitze'l ex b'aj kyẍtilsa'nkyib' kykyaqil; e'okxtzuntz ẍtilsalte toju' tja Dyos, kse'nx tchaq' nimaqkawil kye kse'nxju' tchaq'b'il Qman.</para>
  <para style="p">
    <verse number="16" style="v" />Yajxi'tzuntel e'okxju' pale xjansalte toju' tja Dyos. Etzkyiq'i'n tkyaqilju' ti'xti' tz'iltoq toju' tja Dyos ex b'ajkub' kyq'o'n tpen, b'ajxtzun kyiq'i'n tyajajil Leb'itz toju' nin a' Sedron. <verse number="17" style="v" />Tzyet kẍtilsante toju' tnejel q'ij teju' tnejel xjaw, tojtzun twajxaqi'n q'ij teju' xjaw, matxi'toq che pon jata'ju' ja ati twitzju' tja Dyos. B'aj kyẍtilsa'n jni'tl tja Dyos toj wajxaq q'ijtel ex matxitoq b'ajb'ent kyu'n toju' twaqlajoji'n q'ij. <verse number="18" style="v" />Yajxi'tzuntl e'okx twitzju' nimaqkawil Esekyiy toju' ja te kawb'il, ex xikyma'n te: Matxi' b'aj qẍtilsa'ne' tkyaqilju' tja Dyos: ju' q'olb'eb'l te chojb'il k'ok'sb'il kyuk'i'lxi' aq'unb'il inche ajb'en te, exju' mes kykb'elju' wab'j xjansa'nqe' kyuk'i'lxi' aq'unb'il inche ajb'en tib'aj. <verse number="19" style="v" />Ex matxi' b'ajqnk'u'ne' ex matxi' che b'aj qẍtilsa'ne' kykyaqilju' aq'unb'il b'je'xnitoq t-xon nimaqkawil Ajas tej tel tpa'ntib' ti'j Dyos toju' tq'ijlalil tkawb'il, atzu'n ja'lo ate'qe'tl twitzju' q'olb'eb'l te Qman Dyos, chechij te nimaqkawil.</para>
  <para style="p">
    <verse number="20" style="v" />Primxi'xtzun jawe' nimaqkawil Esekyiy, eb'aj tb'u'yi'nju' ati kyoklen toju' nintnam, xi'tzuntz toju' tja Dyos. <verse number="21" style="v" />Iq'i'ntoq wuq qpoj tman wakx kyu'n, wuq tman rit, wuq qpoj tman rit ex wuq qpoj tman chib', te chojb'il tu'n tpaj kyilju' toj tja nimaqkawil, exu' ja te k'u'lb'il ex kyil aj Juda. Tchaq'u' nimaqkawil kyeju' pale, tyajajil Aaron, tu'n tkub' kyq'o'n te chojb'il k'ok'sb'il tib'aju' q'olb'eb'l te Qman Dyos. <verse number="22" style="v" />Ekub'tzun kyb'yo'n pale qpoj tman wakx, jaw kyiq'i'nju' kychk'el ex kub' kywitxk'a'n tib'aju' q'olb'eb'l. Axtzun kyb'inchaju' kyi'ju' tman rit ex kyi'ju' qpoj tman rit. <verse number="23" style="v" />Yajxi'tzuntl exi' kyiq'i'n tal chib' te chojb'il tu'n tpaj il twitzju' nimaqkawil ex kywitzju' tnam xjal, aye'tzunkye kub' kyq'o'n kyq'ob' kyib'aju' alu'mj. <verse number="24" style="v" />E'tzajtzu'n pale e'kub' kyb'yo'n, ex kub'kyqo'n kychk'el tib'aju' q'olb'eb'l te jun chojb'il tu'n tpaj il, tu'n tkub'najsa'n kyil kykyaqil aj Israel, qu'n tchaq' nimaqkawil tu'n tkub' q'etju' chojb'il k'ok'sb'il tu'n kpaj kykyaqil aj Israel.</para>
  <para style="p">
    <verse number="25" style="v" />Ex e'kub'tq'o'n Esekyiy tyajajil Leb'i toj tja Dyos kyuk'i'l chnab' k'uxb'il sewun, tzintzin ex kyitar, kse'nxju' nuk'b'il kyu'n Dab'i ex Kad, ju' npon tnab'l toj kawb'il, ex Natan ju' sanjelal. Qu'n a Qman Dyos tzaj q'onteju' nuk'b'il lu kyeju' t-sanjelal.</para>
  <para style="p">
    <verse number="26" style="v" />Wa'lqetoqu' tyajajil Leb'i iq'i'mile tchinab' Dab'i kyu'n, aye'tzu'n pale kyuk'i'lu' chun. <verse number="27" style="v" />Tmatzun Esekyiy tu'n kykub' q'o'n chojb'il k'ok'sb'il tib'aju' q'olb'eb'l. Tetzunj ttzyet ttz'e'ysetu' chojb'il k'ok'sb'il, ex tzyet kyb'itzanjtzju' b'itz te ninb'ilte Qman Dyos ex exi'q'ajtza'n chun kyuk'i'lu' tchinab' nimaqkawil Dab'i. <verse number="28" style="v" />Kykyaqilu' xjal mejliqe' intoq che k'ulun, aye'tzu'n aj b'itzal intoq che b'itzan, exqe'tzu'n pale intoq che kyq'ajtza'n chun. Tkyaqil ja'lu intoq b'inchet tzmax tb'aju' chojb'il k'ok'sb'il. <verse number="29" style="v" />Tetzunj tb'aj ja'lu, kub' mejeju' nimaqkawil k'ulul kyuk'i'l kykyaqilju' ate'toq tuk'i'l. <verse number="30" style="v" />Tb'ajlentzu'n ja'lu, tchaq' nimaqkawil Esekyiy kyuk'i'lju' ati kyoklen kyeju' tyajajil Leb'i tu'n kyajwalinte Qman Dyos kyuk'i'lju' tb'itz Dab'i ex tb'itz Asap ju' t-sanjelal Dyos. E' b'itzantzuntz tu'n kytzalajb'il, ex e'kub' meje k'ulul.</para>
  <para style="p">
    <verse number="31" style="v" />Xitma'ntzun Esekyiytz kye xjal: Matxina' kyxjansa kyib'e' ja'lo te Qman Dyos, che lq'eqe'tze' ex kyiq'intze' chojb'il ex kyoyaje' te aq'b'il chjonte toju' tja Qman Dyos, chij kye. Tzajtzun kyiq'i'n xjal chojb'il ex kyoyaj te aq'b'il chjonte, aye'tzu'n tzaj anq'in toj kyanmi, kub' kyq'o'n chojb'il k'ok'sb'il. <verse number="32" style="v" />A kyajlal alu'mju' tzaj kyiq'i'n xjal te chojb'il k'ok'sb'il: oxnaq lajoj (70) tman wakx, jo'naq (100) rit ex lajnaq (200) qpoj tman rit. Kykyaqil tu'ntoq kykub' q'et te chojb'il k'ok'sb'il twitz Qman Dyos. <verse number="33" style="v" />Junk'al lajnaq (600) wakx, atzun wuqk'al lajnaq (3,000) rit kub' kyq'o'n tu'n kykyaqil.</para>
  <para style="p">
    <verse number="34" style="v" />Naqtoqtzun jte'x kyb'aju' pale ex min nche' xkyetoq tu'n tel iq'et kytz'umal kykyaqilju' alu'mj te chojb'il k'ok'sb'il, e'oninju' kyitz'in mo kytzik kyi'j, aye' tyajajil Leb'i, tu'n tb'aj b'entju' aq'untl, tzmaxi'j kyẍtilsante kyib'ju' txqantl pale; qu'n kyaq'xi'x kyib'ju' tyajajil Leb'i tu'n kyẍtilsante kyib' kyekywitzju' pale. <verse number="35" style="v" />Expe' nimtoq txqan chojb'il k'ok'sb'il tu'n tkub' q'et, ex ky-until chojb'il te b'inchjtib'il, exqe' oyaj b'in nche kub' q'et junx kyuk'i'lju' chojb'il k'ok'sb'il.</para>
  <para style="p">Iktzu'n b'inchet jumajtlu' k'u'lb'il toju' tja Qman Dyos. <verse number="36" style="v" />E' b'aj tzalaj Esekyiy kyuk'i'l kykyaqilju' xjal tu'nju' matxi'toq tb'incha Dyos teju' ttanam, qu'n lwiyxi'x tb'aj b'enti tkyaqil.</para>
  <chapter number="30" style="c" />
  <para style="s1">Kub' Tik'sa'n Esekyiy Tq'ij Tzaqpib'l</para>
  <para style="p">
    <verse number="1" style="v" />Xitchq'o'n Esekyiy tq'umli toj tkyaqil Israel ex Juda, ex xit-sma'n u'j kye tyajajil Eprayin ex Manases, tu'n kyb'ajtzaj toju' tja Dyos toj Jerusalen, ik'salteju' Tq'ij Tzaqpib'l te Qman Dyos. <verse number="2" style="v" />B'antti'j tu'n nimaqkawil kyuk'i'lju' nche kawin tuk'i'l ex kykyaqilju' xjal aj Jerusalen, tu'n tik'setju' Tq'ij Tzaqpib'l toju' tkab' xjaw, <verse number="3" style="v" />mixnati' b'ent kyik'sante tojku'xi'xju' tq'ijlalil qu'n naqtoq jte'xju' pale matxi'toq kyẍtilsa kyib', expe' na'mxtoq kyb'u'yinte kyib'ju' xjal toj Jerusalen. <verse number="4" style="v" />B'a'na' ela' toj twitzju' nimaqkawil ex toj kywitz xjal, <verse number="5" style="v" />extzun txokb'iltz kyu'n toj tkyaqil Israel, tzajx B'eerseb'a ex ponx Dan, tu'n kyb'ajtzaj ik'salte Tq'ij Tzaqpib'l tu'n Qman Dyos toj Jerusalen. Qu'n b'ajxtoq che tena'xi' txqan xjal ik'salte, kse'nju' tz'ib'a'ntoq.</para>
  <para style="p">
    <verse number="6" style="v" />Eb'je'xtzun sanjelaltz toj tkyaqil Israel ex Juda, tuk'i'l kyuj nimaqkawil exqe' nche kawin tuk'i'l, q'malte tchaq'b'il nimaqkawil ikjalu: Ku'tanjtz kyi'je' aj Israel tk'etzu' Qman Dyos ek'ulun Ab'raam, Isaak ex Israel te, k'anjetztzun ti'jtk'u'jtz qi'j ju' o'tzaqpet toj kyq'ob' nimaqkawil te Asirya. <verse number="7" style="v" />Lan che okye' kse'nqe' ojtxi' qyajilb'en ex kse'nqe' qitz'in ex qtzik, tu'n tpaj elkypa'n kyib' ti'j Qman Dyos Kydyos ojtxi' qyajilb'en, e'kyaj q'o'n toju' xitb'il nqka'yi'n lu. <verse number="8" style="v" />Qu'mtzun lalun che okye' jip, kse'nqe' ojtxi' qyajilb'en; kyq'o'nktz kyq'ob'e' te Qman Dyos tu'n tb'inchet jumajtlju' yol kyejni b'entti'j ex kukytzaje' toju' tja xjan, ju' oje t-xjansa tejumajx. Che ajb'enqe'ye' te Qman Dyos, laytzun tzajtl ttx'u'jiltz qi'j. <verse number="9" style="v" />Qama tz'anjtz kyi'je' tk'etz Qman Dyos, ktzajel q'aq'an kyk'u'ju' qajq'oj kyi'ju' qtzik, qitz'in ex qk'wal jpu'nqe' kyu'n ex che tzajel kytzaqpi'n tu'n tanjtzkyi'j toju' tx'otx' lu, qu'n in q'aq'ante Qman Dyos tk'u'j ex nlaqj tk'u'j, lay che el ik'o'ne' tu'n, qama tz'anjtz kyi'je' tuk'i'l, chiju' nimaqkawil.</para>
  <para style="p">
    <verse number="10" style="v" />B'aj kyb'eti'n q'ol tqanil toj kytx'otx' tyajajil Eprayin ex Manases, eb'jik' tojile' junjun nimaqtnam, tzmax kyponkanun Sab'ulon. Aye'tzu'n xjal naq eb'jaw tze'n ex intoq che xmayin kyi'j. <verse number="11" style="v" />Ate'toqtzun junjun ichan kyxolju' kyyajajil Aser, Manases ex Sab'ulon kub' kyme'ssa'nkyib' twitz Dyos ex e'pon toj Jerusalen. <verse number="12" style="v" />Ex yolin Dyos toj kyanmiju' xjal aj Juda tu'n tjapun tchaq'b'il nimaqkawil kyu'n ex kychaq'b'ilju' ati kyoklen, kse'nxju' ojetoq tchaq' Qman Dyos.</para>
  <para style="p">
    <verse number="13" style="v" />Ikytzu'n, nim txqan xjal b'aj kyb'u'yi'n kyib' toj Jerusalen toju' tkab' xjaw tu'n kyik'santeju' ninq'ij tu'n kywayet wab'j mixti' kytx'amal. <verse number="14" style="v" />E'aq'witzuntz iq'imilkyeju' q'olb'eb'l exqe' jatoq ntz'e'ysanjtza' sturak toj Jerusalen, b'ajku'x kyxontzuntz toju' nin a' Sedron. <verse number="15" style="v" />Kub' kyb'yo'n qpoj tman rit te Tq'ij Tzaqpib'l toj kyajlajoj q'ij te tkab' xjaw. Kub'tzu'n kych'ixwle'n pale ex tyajajil Leb'i, b'aj kyẍtilsa'nkyib' ex exi' kyiq'i'n alu'mj te chojb'il k'ok'sb'il toju' tja Qman Dyos. <verse number="16" style="v" />E'oktzuntz toju' kyaq'un, kse'nxju' q'ma'n toj tkawb'il Moyses, tmajin Dyos. Intoq kub' kywitxk'a'n pale chik' ntoq xikyq'o'n tyajajil Leb'i kye. <verse number="17" style="v" />Ate'toqtzun txqan na'mxtoq kyẍtilsante kyib' kyxolju' tnam xjal, e'kub' kyb'yo'n tyajajil Leb'i alu'mj te Tq'ij Tzaqpib'l kye kykyaqilju' na'mxtoq kyẍtilsante kyib', tu'n kyxjanset te Qman Dyos. <verse number="18" style="v" />Nimtzu'n txqan xjal kyyajajil Eprayin, Manases, Isakar ex Sab'ulon e'wan ti'ju' wab'j te Tq'ij Tzaqpib'l, extzun myatoq ẍtilsa'nkyib', kse'n tz'ib'a'n. Atzunte Esekyiy na'n Dyos kyi'j, tma: Nman Dyos aya nim t-xtalb'ila, najsama kyil kykyaqilju' nche jyon ti'ja tu'n tkyaqil kyk'u'j, <verse number="19" style="v" />Taye, ju' ek'ulun ojtxi' qyajilb'ene' teya, maskye na'mx kyẍtilsante kyib', kse'nxju' xjansb'il nojqelan toju' tjaya, chij te Dyos.</para>
  <para style="p">
    <verse number="20" style="v" />Tzajtzun tb'i'n Qman Dyos tkub'sb'il Esekyiy ex kub' tnajsa'n kyilju' tnam. <verse number="21" style="v" />Kub'tzun kyik'sa'n aj Israel ate'toq toj Jerusalen, tq'ij wab'j mixti' ttx'amal tuk'i'l nim tzalajb'il toju' wuq q'ij. Aye'tzu'n pale ex tyajajil Leb'i intoq jawkyajwali'n Qman Dyos tkyaqil q'ij kyuk'i'lju' tb'anil chnab' xjansa'nqe'. <verse number="22" style="v" />Xi'tzun tq'o'n Esekyiy yol te tzalajb'il kye kykyaqilju' tyajajil Leb'i tu'nju' kyaq'kyib' tu'n tkyaqil kyk'u'j tu'n kyajb'en te Qman Dyos.</para>
  <para style="p">Kyb'ajlenxi'tzun wan ti'ju' wab'j te ninq'ij toju' wuq q'ij, tkub'lenxi' kyq'o'n chojb'il te b'inchjtib'il ex tb'jawlenxi' kyajwali'n Qman Dyos, Kydyos ojtxi' kyyajilb'en, <verse number="23" style="v" />b'entti'j kyu'n kykyaqilju' xjal tu'n txi' wuq q'ijtlju' ninq'ij, ojexi'xtzun che tzalaj; <verse number="24" style="v" />qu'n exitoyi'n Esekyiy, nimaqkawil toj Juda, kab'k'al lajnaq (1,000) qpoj tman wakx ex wuqlajk'al lajnaq (7,000) rit kyeju' tnam xjal, ikyqe'xtlju' ati kyoklen toj kawb'il xikyoyi'n kab'k'al lajnaq (1,000) qpoj tman wakx ex junmjutx' jo'k'al (10,000) rit kyeju' tnam xjal. Nim txqan pale b'aj kẍtilsa'nkyib'. <verse number="25" style="v" />Kykyaqilju' xjal aj Juda eb'aj tzalaj, exqe' pale, e'aj Leb'i ex kykyaqilju' xjal e'tzaj toj Israel, exqe' najchaq xjal e'tzaj toj Israel mujqa najlqe'toq toj Juda. <verse number="26" style="v" />Iktzu'n, nin tzalajb'il b'aj toj Jerusalen, qu'n b'ajxtoq b'aja' ikyju' toj Jerusalen atxi'x toj tq'ijlalil tkawb'il Salomon, tk'wal Dab'i ex nimaqkawil toj Israel. <verse number="27" style="v" />Yajxi'tzuntl e'kub' we'ju' pale ex aj Leb'i, xikyqani'n b'a'n kyib'aju' tnam xjal; e'tzajtzun tb'i'n Qman Dyos, ex ponju' kyna'j Dyos tzmax toj kya'j, ja ta'ya' Qman Dyos xjan.</para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tb'ajlenxi'tzu'n tkyaqil ja'lu, kykyaqilu' aj Israel e'ten atzu' e'xi' kyoju' nimaqtnam toj Juda ex b'aj kyb'uchi'nju' ab'j xjansa'nqe', eb'aj kypa'nju' tilb'ilal Asera ex eb'ajkub' kyxitu'n ja xjan kywi' witz kye txqantla dyos, b'aje'lpunx kyu'n b'ajsalkyeju' lu kyxol kykyaqil kyyajajil Juda ex B'enjamin, ex kyxol kyyajajil Eprayin ex Manases. E'anjtzun aj Israeltz kyoj nimaqkytanam, tojilex tetzb'il junjun.</para>
  <para style="p">
    <verse number="2" style="v" />Yajxi'tzuntl eb'aj tnk'u'n Esekyiy pale ex aj Leb'i tu'n kyche'xb'entekyib', tu'ntzun tkub' kyq'o'n chojb'il k'ok'sb'il ex chojb'il te b'inchjtib'il teyile junjun tojxju' taq'un, tu'n kyq'o'n chjonte te Qman Dyos ex tu'n tjaw kyajwali'n, ex tu'n kyajb'en ttziju' tja Dyos. <verse number="3" style="v" />Expe' onin nimaqkawil tu'nku' ti'xti' te, tu'n tkub'ju' chojb'il k'ok'sb'il te prim ex te qale, ex tu'n kykub' chojb'il k'ok'sb'il toju' q'ij te ojlab'l, toju' tq'ij ak'a'j xjaw ex kyoju' ninq'ij nim kyoklen, kse'nx tz'ib'a'n toj tkawb'il Qman Dyos. <verse number="4" style="v" />Ex tchaq' kyeju' xjal najlqe'toq toj Jerusalen tu'n txikyq'o'n kyoyaj teyile junjun kyeju' pale ex aj Leb'i, tu'ntzun toktilil kyu'n tu'n tjapun tkawb'il Qman Dyos. <verse number="5" style="v" />Tetzunj tex tqanilju' chaq'b'il lu, nim kyoyaj aj Israel xikyq'o'n ti'ju' tb'anilxi'x twitz kyawal triy, b'in, aseyt, ta'lkab' ex tkyaqil chukchaq twitz kyawal njaw toj kojb'il tu'n tkyaqil kyk'u'j. Ex nim tlajoji'n tnej xikyiq'i'n kyi'j tkyaqilju' twitz kyawal.</para>
  <para style="p">
    <verse number="6" style="v" />Exqe' xjal najlqe'toq toj Israel exqe' najlqe'toq kyoj txqantl nimaqtnam toj Juda, tzaj kyiq'i'n jun tlajoji'n tnej kyi'j kywakyix ex kyi'j kyrit ex jun tlajoji'n tnej kyi'ju' ti'xti' xjansa'nqe' twitz Qman Dyos. Tkyaqil b'ajkub' kyq'o'n toj ch'uqi'n. <verse number="7" style="v" />Tzyet kyb'uyinteju' chaqi'n ti'xti' lu toj toxi'n xjaw, ex b'ajb'ent kyu'n toj twuqi'n xjaw. <verse number="8" style="v" />Tetzunj kyxi' Esekyiy kyuk'i'lju' ati kyoklen ka'yilteju' matxi'toq b'uyet, xikyq'o'n chjonte te Qman Dyos ex teju' ttanam Israel. <verse number="9" style="v" />Xi'tzun tqani'n Esekyiy jun chik'b'ab'l kyeju' pale ex aj Leb'i kyi'ju' matxitoq chmet lu, <verse number="10" style="v" />xi'tzun ttzaq'we'n Asariy, kynejel pale, tyajajil Sadok, te: Atxi'x ttzyet ttzaj kyiq'i'n kyoyaj toj tja Qman Dyos, ati qwaye' expe' min nb'aj; tkyaqilju' txqan lu min nb'aj, qu'n matxi' tzaj tky'i'wla'n Qman Dyos ttanam, chij.</para>
  <para style="p">
    <verse number="11" style="v" />Qu'mtzun tchaq' Esekyiy tu'n kyb'inchanjtz k'uja toju' tja Dyos. Tetzunj kyb'aj b'ent, <verse number="12" style="v" />b'ajku'x kyq'o'n kyoj kse'nx chaqu' o'nb'il, e' tlajoji'n tnej kub' q'o'n exqe' oyaj xjansa'nqe' twitz Qman Dyos. Tkyaqil ja'lu xiq'o'n toj tq'ob' Kananiy aj Leb'i, atzu'n Simi ju' titz'in ok te tkab' nejenel. <verse number="13" style="v" />Aye'tzu'n Jeyel, Asasiy, Naat, Asael, Jerimot, Josab'ad, Elyel, Ismakyiy, Maat ex B'enayiy, e'okq'o'n tu'n nimaqkawil Esekyiy ex tu'n Asariy, ju' nejenel nim toklen toj tja Dyos, te xq'uqil tjaq' kykawb'il Konaniy ex Simi ju' titz'in. <verse number="14" style="v" />Toj tq'ob' Kore tk'wal Imna, tyajajil Leb'i, xq'uqil ttziju' ja toj tjawetzq'ij, ta'qe' toqju' oyaj ntzaj kyiq'i'n xjal tu'n kyk'u'j te Dyos, ex tu'n t-xit-sipa'nju' o'nb'il nkub' q'o'n twitz Qman Dyos exqe'ju' oyaj nche elpa'n te Qman Dyos. <verse number="15" style="v" />Aye'tzu'n Eden, Minjamin, Jesus, Semayiy, Amariy ex Sekaniy intoq che onin ti'j Kore, kyoju' nimaqkytanam pale, tu'n kyb'ajx sipetju' oyaj kyxolju' kyuk'i'l tojxi'x tu'me'l. Intoq xikysipa'n kse'nx kyten junjun tnej ajkych'exb'ente kyib' toju' kyaq'un, junelni kyu'n kye nimaq ex kye b'o's, <verse number="16" style="v" />kye kykyaqilju' ntoq che pon b'inchalteju' kyaq'un tkyaqil q'ij toju' tja Dyos, kse'nx kyten ajkych'exb'ente kyib' ex kyaq'un teyile junjun, qa tz'ib'a'nqe' kyoju' u'j, tzajx kyuk'i'lju' matxi'toq che el oxe' ab'q'i. <verse number="17" style="v" />Tz'ib'a'n kyb'iju' pale kse'nx kyb'aj toj kyja, exqe' aj Leb'i, tzajx kyuk'i'lju' te winqi'n ab'q'i, kse'nxju' kyaq'un ex kyten aj kych'exb'ente kyib'. <verse number="18" style="v" />Tz'ib'a'ntoq kyb'i kykyaqilju' k'wal b'o'sqe', e' kyxu'jil, kyk'wal ex kymyal, kykyaqilju' kyb'aj, qu'n tu'nju' kyaq'un xi'ni q'o'n xjansa'nqe' te Dyos. <verse number="19" style="v" />Ate'toq ichan kyoj kykyaqilju' nimaqtnam q'ma'n kye tu'n t-xikysipa'n oyaj kye kykyaqilju' pale tyajajil Aaron, ex kye kykyaqil aj Leb'i tz'ib'a'nqe' ex najlqe'toq kyoju' tx'otx' te k'ik'leb'l kyoj nimaqkytanam pale.</para>
  <para style="p">
    <verse number="20" style="v" />Toj tkyaqil Juda tb'inchaya' Esekyiy ja'lu. B'a'n b'aj tb'incha'n, tz'inun ex tu'n tkyaqil tk'u'j twitz Qman Dyos. <verse number="21" style="v" />Tkyaqilju' aq'untl tb'incha toju' ajb'eb'l toj tja Dyos kse'nxju' ntma'n kawb'il ex chaq'b'il, tb'incha ex jyon ti'j Qman Dyos tu'n tkyaqil tk'u'j, qu'mtzun b'a'n ela' tkyaqilju' tb'incha.</para>
  <chapter number="32" style="c" />
  <para style="s1">Kub' kytzyu'n Senakyerib' kytx'otx' aj Juda</para>
  <para style="r">(<ref loc="2KI 18:13-19:37">2 R 18.13—19.37</ref>; <ref loc="ISA 36-37">Is 36—37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Kyb'antlenxi'tzun ja'lu, matxi'toq tyek'u Esekyiy b'a'n tb'inchb'en, ulju' nimaqkawil Senakyerib' aj Asirya kyuk'i'l t-xjal te q'oj, kub' kytzyu'n Juda ex b'aj kytxoli'n kyi'ju' nimaqtnam kuwsa'nqe', tu'ntoq tkub'kyi'j kyu'n.</para>
  <para style="p">
    <verse number="2" style="v" />Tetzunj tlonte Esekyiy matxi'toq pon Senakyerib' kyuk'i'l t-xjal te q'oj tu'n kyok tzaqpaj q'ojil ti'j Jerusalen, <verse number="3" style="v" />xjelun kyeju' nejenel toju' nintnam ex nejenel kye t-xjal te q'oj, xitma'n kye tu'n kykub' jpetju' t-xiklil a' ate'toq ti'jxi' nintnam, ex b'a'n ela' toj kywitz. <verse number="4" style="v" />B'ajtzun kyb'u'yi'n kyib' txqan xjal ex eb'ajkub' kyjpu'n tkyaqilu' a' exju' a' xi'ni toj tx'otx', tu'ntzun lalun knet nim a' kyu'n nimaqkawil aj Asirya ajkyul kanun.</para>
  <para style="p">
    <verse number="5" style="v" />Kub' tkuwsa'ntib' Esekyiy ex tchaq' tu'n tjaw tb'incha'ntlju' nintapi, ex tu'n kyb'jaw b'inchet ja nimaq kywe' tib'aj, ex tchaq' tu'n tjaw b'inchet juntl nintapi ti'jile. Ex tchaq' tu'n tjaw b'inchet tapi ti'ju' Ninttanam Dab'i, ex nim txqan ch'ut ex kolb'il e'kub' kyb'incha'n. <verse number="6" style="v" />Ex e'oktq'o'n nejenel chaq'ul kyib'aju' xjal te q'oj, e'kub' tb'u'yi'n toju' plan ttzi nintnam ex exitkuwsa'n kyu'nju' yol lu: <verse number="7" style="v" />¡Kuwqe'xe' ex lalun che xob'e'! Lalun che xob'e' ex lalun b'aj kyk'u'je' twitzju' nimaqkawil aj Asirya ex kywitzju' tnam xjal te q'oj ate' tuk'i'l, qu'n nimxi'xtl qe ati quk'i'l. <verse number="8" style="v" />Ate' tkuwal aju' kyipumalu' xjal, atzunqe aku' Qman Dyos ati quk'i'l tu'n tonin qi'j toju' q'oj, chij kye. Tetzunj kyb'inte tnam xjal tyolju' nimaqkawil Esekyiy, ten kyipumal.</para>
  <para style="p">
    <verse number="9" style="v" />Yajxi'tzuntl, tej intoq q'ojin nimaqkawil Senakyerib' aj Asirya kyuk'i'l kykyaqilju' t-xjal te q'oj ti'ju' tnam Lakyis, e'tzaj tchq'o'n jte' t-sanjelal toj Jerusalen q'malte te Esekyiy, nimaqkawil toj Juda, ex kye kykyaqilju' najlqe' ex ate'toq toj Jerusalen, ikjalu:</para>
  <para style="p">
    <verse number="10" style="v" />Lu saj tma'n tq'umli nimaqkawil Senakyerib' aj Asirya kyeye': ¿Tiqu'n q'uqlixi'x kyk'u'je' toj Jerusalen extzun txoli'ntl kyi'je'? <verse number="11" style="v" />Qa tok Esekyiy q'malte kyeye' qa che kletele' toj nq'ob'e' tu'n Dyos Manb'aj nche k'ulune' te, naq tokte' sb'ulkyeye' ex nche kub' tq'o'ne' tu'n kykyime' tu'n we'yaj ex k'waj. <verse number="12" style="v" />Mana' che kub' tnajsa'n Esekyiy janoka'toq k'u'lb'il exqe' q'olb'eb'l teju' Dyos lu, tchaq'tzuntz kye xjal aj Juda ex aj Jerusalen tu'n kyk'ulun ex tu'n tkub' kyq'o'n sturak naq tib'aj jun q'olb'eb'l. <verse number="13" style="v" />¿Ma mixtzunti' b'i'n kyu'ne' tiju' matxi' qb'inchaye' kyuk'i'lju' ojtxi' nyajilb'ene' kyi'j kykyaqilju' tnam kyoju' txqantl tx'otx'? ¿Ma eklettzu'n tnam lu kyu'n kydyos teju' wipumale'? <verse number="14" style="v" />¿Ma atitzun jun dyos kyxol kykyaqil kydyosju' tnam lu, ju' e'kub' xitu'n kyu'n ojtxi' nyajilb'ene', kletju' ttanam tu'n teju' wipumale'? ¿Tiqu'ntzun nkyxima'ne' qa che kletele' tu'n Kydyose'? <verse number="15" style="v" />Qu'mtzun lan kyaq' sb'u'kyib'e' ex lalun txikyliq'b'a'n kyẍkyine' te Esekyiy; lalun txi' kyoksla'ne', qu'n mixna'ti'x jun kydyosju' tnam lu, ma'wt kletju' ttanam tu'n teju' wipumale' ex te kyipumalju' ojtxi' nyajilb'ene', ¡mitzunloyate' Kydyose' layx che klete' tu'n teju' wipumale'!, chi nimaqkawil aj Asirya, chechij.</para>
  <para style="p">
    <verse number="16" style="v" />Expe' atix txqantl yol kymaju' tmajin nimaqkawil aj Asirya ti'j Qman Dyos ex ti'j Esekyiy ju' tmajin. <verse number="17" style="v" />Ex e'kub' ttz'ib'a'n Senakyerib' txqantl u'j te i'lb'ilte Qman Dyos, ex a tmaju' ti'j kjalu: Kse'nqe' kydyosu' tnam kyoj txqantl tx'otx' min b'ent kykletju' kytanam kyu'n te wipumale', ikxtzunte tdyos Esekyiyju' lay b'ent tkletju' ttanam tu'n te wipumale', chij.</para>
  <para style="p">
    <verse number="18" style="v" />E'tzaj ẍch'i'n tmajin Senakyerib' kuw toj eb'rey kyeju' xjal aj Jerusalen ate'toq tib'aju' nintapi, tu'n toktchi kyi'j ex tu'n kyxob', tu'ntzun tkub'ti'ju' nintnam kyu'n. <verse number="19" style="v" />E'yolin ti'ju' Qman Dyos janche k'uluna' aj Jerusalen, kse'n kyi'ju' kydyos txqantl tnam b'incha'n kyu'n xjal.</para>
  <para style="p">
    <verse number="20" style="v" />Tojtzunju' lu, e'na'n Dyos nimaqkawil Esekyiy exju' Isayiy t-sanjelal Dyos, tk'wal Amos, ex e'qanin o'nb'il te toj kya'j. <verse number="21" style="v" />Tzajtzun tchq'o'n Qman Dyos jun anjl najsalkye kykyaqilju' xjal te q'oj exqe' nejenel ex chaq'ul toju' t-xmuj nimaqkawil aj Asirya, anjtzun ti'jtz toju' ttx'otx' matxi'toq tz'el tch'ixaw. Tetzunj tokx toj tja tdyos, axtzu' kub'a' b'yo'n kyu'nku' tk'wal.</para>
  <para style="p">
    <verse number="22" style="v" />Ikytzu'n etkola' Qman Dyos Esekyiy exqe' xjal toj Jerusalen te tipumalu' Senakyerib', nimaqkawil toj Asirya, ex te kyipumal kykyaqilju' txqantl, ex e'kub' tq'o'n toj nak'b'il kyuk'i'l kykyaqilju' tnam kyi'jile. <verse number="23" style="v" />Nimtzun xjaltz tzaj kyiq'i'n kyoyaj te Qman Dyos toj Jerusalen, ex tzaj kyiq'i'n oyaj twi' wi'yalqe' te Esekyiy, nimaqkawil te Juda. Atxi'xtzunj, okq'o'n Esekyiy nim toklen kyu'n txqantl nimaqtnam.</para>
  <para style="s1">Yab'ti Esekyiy ex b'anix</para>
  <para style="r">(<ref loc="2KI 20:1-11">2 R 20.1-11</ref>; <ref loc="ISA 38:1-22">Is 38.1-22</ref>)</para>
  <para style="p">
    <verse number="24" style="v" />Tojtzu'n tq'ijlalil lu, kub' ichin Esekyiy tu'n yab'il, oktzun ten na'l Dyos, ex tzaj tzaq'we'n tu'n Qman Dyos tuk'i'l jun b'a'nq'ob'aj. <verse number="25" style="v" />Tu'npe'tzunju' matxi'toq b'inchanjtzu' b'a'n lu te, mya xtalb'ilte' oka' te Esekyiy, qu'n jaw tnima'ntib', qu'mtzun tzaj ttx'u'jil Qman Dyos ti'j ex ti'j Juda ex Jerusalen.</para>
  <para style="p">
    <verse number="26" style="v" />Tu'npetzu'n jawtnima'n tib', kub' tme'ssa'ntib' Esekyiy twitz Dyos, ex ikx kyb'incha xjalju' najlqe' toj Jerusalen, ex min tzaj tq'o'ntl Qman Dyos ttx'u'jil kyib'aj tej itz'xtoq Esekyiy.</para>
  <para style="s1">Jaw q'inumax Esekyiy</para>
  <para style="p">
    <verse number="27" style="v" />Ojexi'x tachu Esekyiy nimaq q'inumal ex oklenj, ex b'aj tb'u'yi'n nim txqan saqpwaq, q'anpwaq, tb'anil ab'j, k'ok'sb'il, e'kolb'il ex chukchaq ti'xti' twi' wi'yal. <verse number="28" style="v" />Ex tchaq' tu'n kyjaw b'inchet k'uja tu'n tk'u'yit twitz awal, b'in ex aseyt, ex kyja chukchaq alu'mj ex kych'laj rit. <verse number="29" style="v" />Expe' tchaq' tu'n kyb'jaw b'incha'n nimaqtnam, ex nim txqan twakyix ex trit ten, qu'n nim txqan tq'inumal tzaj tq'o'n Qman Dyos.</para>
  <para style="p">
    <verse number="30" style="v" />A Esekyiy q'mante tu'n kyjpetju' a' intoq che jatz tib'aju' t-xiklil a' Wiyon, xitq'o'ntzuntz tjaq' tx'otx', toju' plaj tkub'exq'ij teju' Ninttanam Dab'i. Qu'mtzun b'a'n b'jela' tkyaqilju' aq'untl tb'incha Esekyiy.</para>
  <para style="s1">E'tk'am Esekyiy sanjelal e'tzaj B'ab'ilon</para>
  <para style="r">(<ref loc="2KI 20:12-19">2 R 20.12-19</ref>; <ref loc="ISA 39:1-8">Is 39.1-8</ref>)</para>
  <para style="p">
    <verse number="31" style="v" />Ikxtzun b'ajiju' tej kytzaj kychq'o'n kawil te B'ab'ilon jte' sanjelal xb'etzalte Esekyiy ex tu'n kyb'inte ti'ju' b'a'nq'ob'aj matxi'toq b'ant toju' tx'otx' lu. Kyej tq'o'n Dyos Esekyiy tjunal, tu'n tka'yinte ex tu'n teltnik' b'a'nxi'x ti'ju' t-xim.</para>
  <para style="s1">Kyim Esekyiy</para>
  <para style="r">(<ref loc="2KI 20:20-21">2 R 20.20-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" />Xitz'ib'a'na' jni'tl tqanil ti'j Esekyiy exju' b'a'n tb'inchb'aj, toju' tuj Isayiy t-sanjelal Dyos, tk'wal Amos, ex toju' tu'jil tqanil kyi'j nimaqkawil te Juda ex Israel. <verse number="33" style="v" />Tetzunj tkyim Esekyiy, okxmqu'n tib'aju' muqb'il kye toj tja Dab'i. Kykyaqil aj Juda exqe' xjal najlqe' toj Jerusalen kynimaju' tkyimlen; ex atl Manases ju' tk'wal kawin te t-xel.</para>
  <chapter number="33" style="c" />
  <para style="s1">Tkawb'il Manases</para>
  <para style="r">(<ref loc="2KI 21:1-18">2 R 21.1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tetoq kab'lajoj (12) ab'q'i Manases tej ttzyet tkawin, kab'naq o'lajoj (55) ab'q'i kawin toj Jerusalen. <verse number="2" style="v" />Myab'a'n b'ajtb'incha'n twitz Qman Dyos, qu'n aye'x tb'inchaju' taq'wixi'x kse'nx kyb'inchaju' nimaqtnam eb'je'l tiq'i'n Qman Dyos kywitzju' aj Israel: <verse number="3" style="v" />tchaq' tu'n kyb'jaw b'incha'n jumajtlu' ja kye witzleb' kywi'witz e'kub't-xitu'n Esekyiy ju' tman; tchaq' tu'n kyb'jaw b'incha'n q'olb'eb'l kye tilb'ilal B'aal, ex tu'n kykub' b'incha'n tilb'ilal Asera; expe' e'oktk'lu'n ex e'jaw tnima'n tkyaqilju' che'w twitz kya'j, <verse number="4" style="v" />ex tchaq' tu'n kyjaw b'incha'n q'olb'eb'l toju' tja Qman Dyos, ja ojetoq tma Qman Dyos tu'n ttenju' tb'i tejumajx toj Jerusalen. <verse number="5" style="v" />Tchaq' tu'n kyjaw b'incha'n txqantl q'olb'eb'l kyoju' kab'e' tpen tja Qman Dyos, ex e'oktq'o'n kye kykyaqilju' che'w twitz kya'j.</para>
  <para style="p">
    <verse number="6" style="v" />Expe' e'kub' ttz'e'ysa'n tk'wal te chojb'il toju' b'ya' B'en-inom, txokon ti'j kyanmi kyimni, ok te ajnab'lil, ex b'ant mayn tu'n, ex taq' anb'il tu'n kytenju' nche jyonkyi'j xjal kyuk'i'l xewb'aj exqe' ajk'a. Taq'wixqe'xi'xju' tb'inchb'aj twitz Qman Dyos, qu'mtzun tzaj ttx'u'jil Dyos nimxi'x. <verse number="7" style="v" />Ex tchaq' tu'n tkub' q'o'n witzileb' matxi'toq kub' kyb'incha'n toju' tja Dyos, ju' ojetoq tma Dyos te Dab'i ex te Salomon ti'j ikjalu: Jawnsk'o'ne' ja te k'u'lb'il lu toj Jerusalen, kyxol kykyaqilu' junjun tnej tyajajil Israel, jaktenb'ela' nb'iye' tejumajx. <verse number="8" style="v" />Lay che ex nxla'ja'ntle' aj Israel toju' tx'otx' ja e'kub'a' nq'o'ne' ojtxi' kyyajilb'en, qama japun kyu'n exqa makyb'incha tkyaqilju' oje nchaq'e' kye, ex kykyaqilju' xnaq'tzb'il, kawb'il ex chaq'b'il oje che'x nq'o'ne' kyeye' toj ttzi Moyses, chi Dyos.</para>
  <para style="p">
    <verse number="9" style="v" />Atzunte Manases eb'ajx tiq'i'n aj Juda exqe' najlqe' toj Jerusalen tu'n kyxi' toj taq'wix b'e, tu'n kyanq'in taq'wixi'x kyekywitzpe' nimaqtnam e'kub' tnajsa'n Qman Dyos kywitzu' aj Israel. <verse number="10" style="v" />Tzaj yolin Qman Dyos te Manases ex teju' ttanam, ex mixti'x xikyb'i'n. <verse number="11" style="v" />Qu'mtzun e'tzaj tiq'i'n Qman Dyos nejenel kye t-xjalu' nimaqkawil aj Asirya te q'oj kyi'j, ex tzyet Manases kyu'n, exkyq'o'n k'uxb'il toj ttxa'n, kub' kyxmo'n kyu'n xpatx'q'ank'uxb'il ex xikyiq'i'n B'ab'ilon.</para>
  <para style="p">
    <verse number="12" style="v" />Tetzunj inxi'xtoq b'isun, kub'san twitz Qman Dyos ex kub' tme'ssa'ntb'i b'a'nxi'x twitzu' Dyos Kydyos ojtxi' kyyajilb'en. <verse number="13" style="v" />Tetzunj tna'n Dyos, tzajb'i'n tu'n Dyos, tzaj ttzaq'we'nju' tkub'sb'il ex tzaj tiq'i'n jumajtl toj Jerusalen tu'n tkawin jumajtl toju' tkawb'il. Kanetzuntz toj twitz Manases qa ate Qman Dyosju' Dyos.</para>
  <para style="p">
    <verse number="14" style="v" />Tb'ajlenxi'tzun ja'lu, tchaq' Manases tu'n tjaw b'incha'n jun nintapi nimin twe' ti'jileju' Ninttanam Dab'i, toj tkub'exq'ij te Kiyon, ttziyileju' a' ex pomnix ttzi jqob'lkye kyiẍ, ti'jile Opel. Ex e'oktq'o'n chaq'ul kye xjal te q'oj kyoj kykyaqilju' nimaqtnam tok nimaqtapi kyi'j toj Juda. <verse number="15" style="v" />Expe' tchaq' tu'n kyb'je'lq'i'n kydyos txqantl tnam exju' witzleb' toju' tja Qman Dyos, ex kykyaqilju' q'olb'eb'l kye txqantl dyos eb'jaw kyb'incha'n twi' witz teju' tja Dyos ex toj Jerusalen, tchaq' tu'n kyb'je'x xon ti'jxi' nintnam. <verse number="16" style="v" />Tchaq'tzuntz tu'n tb'aj b'incha'n q'olb'eb'l te Qman Dyos, ex tu'n tkub' q'o'n chojb'il te mujb'ab'ltib'il tib'aj ex te aq'b'il chjonte, ex tchaq' kye aj Juda tu'n kyk'ulun te Qman Dyos janche ajb'ena' aj Israel. <verse number="17" style="v" />Tu'npe'tzunju', inxtoq kub' kyq'o'n tnam chojb'il kyib'aju' q'olb'eb'l kye witzleb', naq aju' te Qman Dyos nkub'a'toq kyq'o'n.</para>
  <para style="p">
    <verse number="18" style="v" />Xi' tz'ib'a'na' jni'tl tqanil ti'j Manases, tna'j Dyos, exqe' chik'b'ab'l xikyq'o'n t-sanjelal Dyos toj tb'i Qman Dyos te, kyoju' tu'jil tqanil kyi'j nimaqkawil toj Israel. <verse number="19" style="v" />Atzu'n tna'j Dyos ex tej ttzaj tzaq'we'n, ex tkyaqilju' tqanil ti'ju' til tej tel txalpuj ex jatchaq'a' tu'n kyjaw b'incha'n ja xjan kye witzleb' twi' witz, ja e'kub' tq'o'na' tilb'ilal Asera exqe' witzileb' tej na'mxtoq tkub' tme'ssa'ntib' twitz Dyos, tz'ib'a'nqe' toju' tu'jil tqanil kyu'n t-sanjelal. <verse number="20" style="v" />Tetzunj tkyim, ku'x mqu'n toju' tx'otx' twitzu' tja te kawb'il. Atl Amon ju' tk'wal kawin te t-xel.</para>
  <para style="s1">Tkawb'il Amon</para>
  <para style="r">(<ref loc="2KI 21:19-26">2 R 21.19-26</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />Tetoq junaq kab'e' (22) ab'q'i Amon tej ttzyet tkawin, kab'e' ab'q'i kawin toj Jerusalen. <verse number="22" style="v" />Mya b'a'nqe' tb'inchb'aj twitz Qman Dyos, kse'nx tb'incha Manases ju' tman. E'kub' tq'o'n chojb'il ex k'ulun kye kykyaqilju' witzileb' e'kub' tb'incha'n Manases ju' tman. <verse number="23" style="v" />Mixti'x kub' tme'ssa'ntib' twitz Qman Dyos, kse'n tb'incha Manases ju' tman, b'inchanxi'xtlpe' txqantl il.</para>
  <para style="p">
    <verse number="24" style="v" />Jaw kyiq'i'n kyib'ju' nejenel ti'j, ex kub' kyb'yo'n toju' tja te kawb'il. <verse number="25" style="v" />Aye'tzu'n xjal toju' tnam eb'aj kub' kyb'yo'nju' jaw kyi'q'i'nkyib' ti'ju' nimaqkawil Amon, ex okkyq'o'n Josiy ju' tk'wal tu'n tkawin te t-xel.</para>
  <chapter number="34" style="c" />
  <para style="s1">Tkawb'il Josiy</para>
  <para style="r">(<ref loc="2KI 22:1-2">2 R 22.1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tetoq wajxaq ab'q'i Josiy tej ttzyet tkawin, junaq junlajoj (31) ab'q'i kawin toj Jerusalen. <verse number="2" style="v" />B'a'n b'aj tb'incha'n Josiy twitz Qman Dyos, qu'n tb'incha kse'nte Dab'i, ojtxi' tyajilb'en, min eltxalpuj ti'j.</para>
  <para style="s1">Ch'exb'eb'l tu'n Josiy</para>
  <para style="p">
    <verse number="3" style="v" />Tojtzu'n twajxaqi'n ab'q'i nkawin Josiy ku'xunxtoq, tzyet tjyonte Dyos ja k'uluna' Dab'i ojtxi' tyajilb'en. Tojtzun tkab'lajoji'n (12) ab'q'i nkawin, aq'wi ẍtilsalte toj Juda ex Jerusalen, eb'je'l tiq'i'n ja xjan te witzleb'i'n, e'tilb'ilal Asera, e'witzileb' exqe' tilb'ilal tzq'ajsa'n k'uxb'il. <verse number="4" style="v" />Ex twitzku' ekub'xitu'na' q'olb'eb'l kye chukchaq tilb'ilal B'aal. Expe' tchaq' Josiy tu'n kykub'xitu'n q'olb'eb'l tz'e'ysb'il sturak ate'toq kyib'aj. Ex tchaq' tu'n kykub' b'uchi'n tilb'ilal Asera, e'witzileb' exqe' tilb'ilal tzq'ajsa'n k'uxb'ilqe'; majx e'kub' quqix tu'n, b'ajx t-sputi'ntzuntz kyib'aj kymuqb'ilju' e'kub' q'onte chojb'il kywitz. <verse number="5" style="v" />Expe' tchaq' tu'n kykub' ttz'e'ysa'n kyb'aqilju' pale kyib'ajxu' kyq'olb'eb'l, ikytzu'n t-ẍtilsaya' Juda ex Jerusalen. <verse number="6" style="v" />Ikx tb'inchaju' kyoj nimaqkytanam kyyajajil Manases, Eprayin ex Simeon, ex ponb'aj kyoj kykyaqil nimaqkytanam tyajajil Neptali, b'aj t-ẍtilsa'n kyoj, jachaq nkyb'u'yi'na' kyib' xjal. <verse number="7" style="v" />Tchaq' tu'n kyb'ajkub' xitu'n q'olb'eb'l, e'tilb'ilal Asera ex witzleb', majx e'kub' quqix kyu'n, e'kub' kyxitu'n kykyaqilju' q'olb'eb'l tz'e'ysb'il sturak toj tkyaqilju' tx'otx' Israel. Anjtzun ti'jtz toj Jerusalen.</para>
  <para style="s1">Okyalju' tu'jil kawb'il</para>
  <para style="r">(<ref loc="2KI 22:3-23:3">2 R 22.3—23.3</ref>)</para>
  <para style="p">
    <verse number="8" style="v" />Tb'ajlenxi'tzun t-ẍtilsa'n tkyaqilju' tx'otx' exju' tja Dyos, toj twajxaqlajoji'n (18) ab'q'i nkawin, exi' tchq'o'n Sapan, tk'wal Asaliy, ex Amasiy, kawil nintnam, ex Joa ttz'ib'al, tk'wal Joakas, tu'n tb'aj kyb'incha'n tja Qman Dyos. <verse number="9" style="v" />Exi'tzuntz tk'etz Ilkyiy kynejel pale ex xikyq'o'n pwaq te, ju' b'aj pon iq'i'n toju' tja Dyos, jaw kyb'u'yi'n aj Leb'i nche xq'uqin ttzija, kyeju' kyyajajil Manases ex Eprayin, kyeju' xjal e'kyaj toj Israel, kye kykyaqil kyyajajil Juda ex B'enjamin ex kyeju' najlqe' toj Jerusalen. <verse number="10" style="v" />Xikyq'o'ntzuntz kyeju' ka'yilte aq'untl ti'j tja Qman Dyos, tu'ntzun txi' kychjo'n twikyk'u'ju' nche aq'unan tu'n tb'aj b'inchetju' tja Dyos. <verse number="11" style="v" />B'ajx kyq'o'n pwaq kye' aq'unal ti'j tze ex kye nejenel ti'ju' aq'untl tu'n kylq'onte jso'n ab'j, tze te tzuyb'ilkye ex kyptzo'nilju' ja eb'ajkub' kyxitu'n nimaqkawil toj Juda.</para>
  <para style="p">
    <verse number="12-13" style="v" />Intoq che aq'unanju' ichan lu toj tnik'alti'j, ex aye'toq aj Leb'i Jaat ex Ab'diy, kyyajajil Merari, Sakariy ex Mesulam, tyajajil Kyeatqe', ka'yilkye ex nejenel kye. Aye'xtoq ka'yilkye iqal ex nuk'ul kyi'j kykyaqilju' ntoq che aq'unan ti'ju' aq'untl ljo'n. Kykyaqilju' aj Leb'i chinb'al qe'toq, ex junjun b'inchal tqanil, junjuntl xq'uqil mo xq'uqil ttzija.</para>
  <para style="p">
    <verse number="14" style="v" />Tetzunj intoq jatz kyiq'i'nju' pwaq pon iq'i'n toju' tja Dyos, elyalju' tu'jil tkawb'il Qman Dyos tu'n pale Ilkyiy, ju' tzaj q'o'n te Moyses. <verse number="15" style="v" />Xitma'ntzuntz te Sapan, ju' tz'ib'al tqanil, qa elyalju' tu'jil kawb'il toju' tja Qman Dyos tu'n; ex xitq'o'n te, <verse number="16" style="v" />xi'tzu'n Span q'olte teju' nimaqkawil ex xitma'n te ikjalu:</para>
  <para style="p">—Inkyb'incha'n ajb'el teya tkyaqilju' xiq'met kye. <verse number="17" style="v" />Matxi' b'aj kyb'u'yi'n saqpwaq atitoq toj tja Dyos, ex matxi' txikyq'o'n kyeju' nk'ul aq'untl ex kyeju' ka'yilte aq'untl, chij.</para>
  <para style="p">
    <verse number="18" style="v" />Ex xitma'n Sapan te nimaqkawil qa xitq'o'n pale Ilkyiy jun u'j te; ex jawt-ẍch'i'n Sapan twitzju' nimaqkawil. <verse number="19" style="v" />Tetzunj tb'aj tb'i'n nimaqkawilu' ntma'n toju' tu'jil kawb'il, xitlaqu'n t-xb'alun, <verse number="20" style="v" />tchaq'tzuntz te Ilkyiy, te Aykam tk'wal Sapan, te Ab'don tk'wal Mikayiy, te Sapan tz'ib'al tqanil, ex te Asayiy, tmajin nimaqkawil, ikjalu:</para>
  <para style="p">
    <verse number="21" style="v" />—Kukyxi'ye xjelul te Qman Dyos wi'je' ex kyi'ju' xjal ate'x toj Israel ex toj Juda; inxi'xlo tx'u'jil te Qman Dyos qi'j, mixna'ti'x xikyb'i'n ojtxi' qyajilb'enju' tma Qman Dyos, ex min xikyb'incha'nju' intma'n toju' u'j sel yal lu, chij.</para>
  <para style="p">
    <verse number="22" style="v" />Xi'tzun Ilkyiy kyuk'i'lju' eb'ajx tchq'o'n nimaqkawil tk'etz Ulda ju' t-sanjel Dyos, t-xu'jil Salum, tk'wal Tikb'a ex tchman Aras, ju' k'u'lkyeju' xb'alun nche ajb'en toj tja Dyos. Najlitoq Ulda toju' tkab' tnej te Jerusalen, tetzunj kyxi' yolin te, <verse number="23" style="v" />tzaj ttzaq'we'n kye:</para>
  <para style="p">—Chi Qman Dyos kjalu:</para>
  <para style="pi">Kymanxe' teju' xjal saj chq'onkyeye' xjelul weye', <verse number="24" style="v" />qa ayine' Dyos Manb'aj nchin q'mante: Ktzajel nq'o'ne' jun yajb'il tib'aju' najb'il lu ex kyib'aju' xjal najlqe' toj, kse'nxu' qanb'en tz'ib'a'n toju' u'j xjaw ẍch'i'n twitzju' nimaqkawil toj Juda. <verse number="25" style="v" />Qu'n matz'el kypa'n kyib' wi'je' ex makub' kytz'e'ysa'n sturak kywitz txqantl dyos, matz'okkyq'o'n ntx'u'jile' tu'n tkyaqilju' kyb'inchb'aj; qu'mtzun matzaj ntx'u'jile' ti'ju' najb'il lu, ex lay tz'el. <verse number="26" style="v" />Kymanxe' teju' nimaqkawil toj Juda, saj chq'o'nkyeye' xjelul weye', qa ikx kxe'l nma'ne' ayine' Dyos Manb'aj, naq tu'nju' matz'ok tq'o'n twi' ti'ju' nyole', <verse number="27" style="v" />ex tu'nju' sanjtz ti'j tanmi ex matz'oktq'o'ntib' tjaq' nkawb'ile' tej xtb'inteju' nyole' ti'ju' najb'il lu ex kyi'ju' xjal najlqe' toj, makub' tme'ssa'ntib' ex matxitlaqu'n t-xb'alun ex matz'oq' nwitze', ex manb'iwe' tkub'sb'il. Ayine' Dyos Manb'aj nchin q'mante. <verse number="28" style="v" />Toj nak'b'il ky'ik'ela' twitzju' tx'otx' ex kpomela' kyk'etzju' ojtxi' tyajilb'en, lay tilju' yajb'il ktzajel nq'o'ne' tib'aju' najb'il lu ex kyib'aju' xjal najlqe' toj, chi Dyos, chij kye.</para>
  <para style="p">Anjtzun kyi'ju' t-sanjelal nimaqkawil q'malteju' tzaq'web'l te. <verse number="29" style="v" />Tchaq'tzun nimaqkawil tu'n kytxket kykyaqilju' tijwnaq kyxol aj Juda ex aj Jerusalen tu'n kyb'uyinte kyib'. <verse number="30" style="v" />Tzajtzun nimaqkawiltz, kyuk'i'l kykyaqilju' xjal aj Juda exqe' najlqe' toj Jerusalen, e'pale, e'aj Leb'i ex tkyaqilju' tnam, ch'i'n kyoklen ex nimaq kyoklen, exi' toju' tja Qman Dyos. Atzuntzu' jawa' t-ẍch'i'n nimaqkawil tkyaqilju' ntma'n toj tu'jilu' yol kyajni b'entti'j tu'n Dyos, ju' etzyal toj tja Dyos. <verse number="31" style="v" />Kub'tzun we' nimaqkawil jaxu' ntoq che kub'a' we' nimaqkawil, ex xittziya'n te Qman Dyos tu'n tkub' tb'i'n, tu'n tb'inchanteqe' tchaq'b'il q'ma'n tu'n ex tkawb'il tojxi'x tu'me'l ex axxi'x, ex tu'n kyjapunju' yol kyejni b'entti'j tz'ib'anqe' toju' u'j. <verse number="32" style="v" />Yajxi'tzuntl tb'incha tu'n kytziyante kykyaqil xjal to Jerusalen ex tyajajil B'enjamin ate'toq atzu', tu'n tjapun kyu'n. Ex japunju' yol kyejni b'entti'j tu'n Dyos, Kydyos ojtxi' kyyajilb'en, kyu'n xjal najlqe' toj Jerusalen. <verse number="33" style="v" />B'je'l tiq'i'n Josiy b'inchaj taq'wix toj tkyaqilju' tnam Israel, ex tb'incha tu'n kyk'ulun kykyaqilju' ate'qe' toj Israel teku' Qman Dyos. Min elkypa'n kyib' ti'ju' Qman Dyos Kydyos ojtxi' kyyajilb'en tej itz'toq Josiy.</para>
  <chapter number="35" style="c" />
  <para style="s1">Kub' tik'sa'n Josiy Tq'ij Tzaqpib'l</para>
  <para style="r">(<ref loc="2KI 23:21-33">2 R 23.21-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Kub' tik'sa'n Josiy Tq'ij Tzaqpib'l toj Jerusalen te ninb'ilte Qman Dyos: kub' q'o'n qpoj tman rit te chojb'il toju' ninq'ij toj tkyajlajoji'n tajlal tnejel xjaw te ab'q'i. <verse number="2" style="v" />Eb'jo'k tq'o'n pale toj kyoklen toju' kyajb'eb'l, ex xitma'n kye tu'n t-xikyka'yi'n aq'untl toj tja Dyos. <verse number="3" style="v" />Ex b'ajx tx'olb'a'n kye aj Leb'iju' xnaq'tzal qe'toq kye kykyaqil aj Israel, xjansa'nqe'toq te Qman Dyos, ikjalu: Kyq'onku'ye' kax xjan toju' tja Dyos jawtb'incha'n Salomon, tk'wal Dab'i ex nimaqkawil toj Israel. Mixti' tu'n t-xikyiq'i'ntle' ti'j kyqule'. Kyq'onk tilile' tu'n kyajb'ene' ja'lo te Qman Dyos ex kye aj Israel kytaname'. <verse number="4" style="v" />Kynk'unx kyib'e' kse'nx kyyajajile' ex tu'n kych'exb'ente kyib'e', kse'nxju' kyej ttz'ib'a'n Dab'i, nimaqkawil toj Israel, ex Salomon ju' tk'wal. <verse number="5" style="v" />Che tenkj jun tzb'oj aj Leb'i toju' ja xjan kyxol junjun tzb'oj kyyajajil Israel, te kyxelju' tzb'oj kyyajajil txqantl aj Israel, kytzik mujqa kyitz'inkyib'. <verse number="6" style="v" />Kyq'onku'ye' qpoj tman rit teju' Tq'ij Tzaqpib'l, kyẍtilsam kyib'e' ex kynab'enku'ye' nojqelan tu'n tjapunju' tchaq' Qman Dyos tu'nel Moyses, kyu'nju' kyitz'ine' ex kytzike', chi Josiy kye.</para>
  <para style="p">
    <verse number="7" style="v" />Ex xitq'o'n Josiy alu'mj, kyi'jxu' talu'n, kye kykyaqilju' xjal toju' tnam ate'toq atzu' tu'n kyik'santeju' Tq'ij Tzaqpib'l: oxmutx' o'lajk'al (30,000) qpoj tman rit kyuk'i'lxi' qpoj tman chib', expe' wuqk'al lajnaq (3,000) tman wakx kyib'ajxi'tl. <verse number="8" style="v" />Expe' kyaq'ju' nche kawin tuk'i'lu' nimaqkawil kyoyaj tu'n kyk'u'j kye tnam, kyeju' pale, ex kye aj Leb'i. Aye'tzu'n Ilkyiy, Sakariy ex Jeyel, ka'yil tja Dyos qe', xikyq'o'n qaqk'al lajnaq (2,600) alu'mj, ex o'lajnaq (300) tman wakx, kyeju' pale tu'n tik'setju' Tq'ij Tzaqpib'l; <verse number="9" style="v" />ex ikxte Konaniy, kyuk'i'lu' tuk'i'l Semayiy ex Natanael, ikxqe' Asab'iy, Jeyel ex Josab'ad, kynejel aj Leb'i, xikyq'o'n kab'lajk'al lajnaq (5,000) alu'mj, ex junk'al jo'naq (500) tman wakx tu'n tkub' ik'setju' Tq'ij Tzaqpib'l.</para>
  <para style="p">
    <verse number="10" style="v" />Tetzunj matxi'toq b'ent tten tu'n ttzyetju' ninq'ij, eb'jo'kju' pale toj kyaq'un ex b'aj kynk'u'n kyib'ju' aj Leb'i tu'n kych'exb'ente kyib', kse'nx tchaq' nimaqkawil. <verse number="11" style="v" />Iktzu'n e'kub' b'yo'nju' alu'mj te Tq'ij Tzaqpib'l, nelxi' kyjon aj Leb'i kyqulu' alu'mj, ex nkub' kyq'o'nxi' pale chik' tib'aju' q'olb'eb'l. <verse number="12" style="v" />Ex elkypa'n seb' ju' ati tu'n tkub' tz'e'yset, kse'nxju' tnej kyyajajil toj tnam, tu'n kyq'onte te Qman Dyos, kse'nxju' tz'ib'a'n tu'n Moyses kyoju' tchaq'b'il; ex ikx kyb'incha kyi'ju' tman wakx. <verse number="13" style="v" />Ekub'tzun kyk'asa'n alu'mj tu'n tik'setju' Tq'ij Tzaqpib'l, kse'nx tz'ib'a'ntoq; aye'tzu'n txqantl oyaj xjansa'nqe' jawx kytzq'ajsa'n kyoj k'wil, nimaqlaq ex tx'i'lb'il, ex ch'intqan b'aj kysipa'n kyxol kykyaqilju' xjal toj tnam. <verse number="14" style="v" />E'oktzun ten aj Leb'itz b'inchalteju' kychi' ex kychi' pale, qu'n nim kyaq'unju' pale, tyajajil Aaron, inxtoq che aq'unan qonik'an q'olkye chojb'il k'ok'sb'il ex ky-until. Qu'mtzun e'okten aj Leb'i b'inchalte kychi' ex kychi' pale, tyajajil Aaron.</para>
  <para style="p">
    <verse number="15" style="v" />Ex ate'toq aj b'itzal, tyajajil Asap, toju' kyaq'un, kse'nxju' q'ma'ntl kyu'n Dab'i, Asap, Eman ex Jedutun, ajna toj tja nimaqkawb'il. Exqe' xq'uqil ttzija ate'toq jaxchaq tu'n kytena'; mix-a'lo'xte jun kyej ttzaqpi'n toklen, qu'n aye' kyuk'i'l, aj Leb'i qe'x, e'kub' b'inchanteju' kychi' kyi'ju' chojb'il.</para>
  <para style="p">
    <verse number="16" style="v" />Ikytzu'n b'ajnk'eta' tkyaqil ajb'eb'l te Qman Dyos toju' q'ij lu, tu'n tik'setju' Tq'ij Tzaqpib'l ex tu'n kykub' ttz'e'ysetju' chojb'il k'ok'sb'il tib'aj q'olb'eb'l te Qman Dyos, kse'nx ojetoq tchaq' nimaqkawil Josiy. <verse number="17" style="v" />Kub'kyik'sa'n aj Israel Tq'ij Tzaqpib'l, ju' ate'toq toju' tq'ijlalil lu, exju' wuq q'ij te wab'j mixti' ttx'amal. <verse number="18" style="v" />B'ajxtoq kub'a' ik'sa'n jumaju' Tq'ij Tzaqpib'l toj Israel kse'n ja'lu ttzajlenx toj tq'ijlalil Samwel t-sanjelal Dyos; mix-a'lo'x jun nimaqkawil toj Israel kub' ik'sa'nte Tq'ij Tzaqpib'l kse'n kub' tik'sa'n Josiy kyuk'i'l pale, e' aj Leb'i, exqe' xjal aj Juda ex aj Israel, ate'toq toju' kmuj lu, kyuk'i'lxi' najlqe' toj Jerusalen. <verse number="19" style="v" />Toj twajxaqlajoji'n (18) ab'q'i ntoq kawin Josiy tej tkub' ik'sa'n Tq'ij Tzaqpib'l lu.</para>
  <para style="s1">Kyim Josiy</para>
  <para style="r">(<ref loc="2KI 23:28-30">2 R 23.28-30</ref>)</para>
  <para style="p">
    <verse number="20" style="v" />Yajxi'tzuntel, tb'antlenxi'tlju' tja Dyos tu'n Josiy, xi' Nekao, nimaqkawil toj Ejipt, ttzi nin a' Ewprates tu'n tq'ojin toj Karkyemis. Ex Josiy k'lulte; <verse number="21" style="v" />atzunte Nekao e'tzaj tchq'o'n t-sanjel q'malte te kjalu: Chin tq'onkja toj nak'b'il, nimaqkawil aj Juda. Mya ti'jta ẍin tzaja'we' ja'lo, qu'n ti'j juntl nintnam nchin q'ojina'we'. Matma Dyos weye' tu'n nxi'ye' ojqel; tu'ntzun mixti'ku' b'ajteya, q'oma anb'il tu'n wik'xe' qu'n aku'te Qman Dyos ati wuk'i'le', laytzun b'ajtza tu'n, chi Nekao te.</para>
  <para style="p">
    <verse number="22" style="v" />Atzunte Josiy mixti'x xitb'i'n, xi'pe' xa'xi'xtl q'ojil ti'j, mixti'x kub' tb'i'nju' toqxenb'il Nekao, ju' tzaj tq'o'n Dyos te. Q'ojintzuntz toju' b'ya' Mewido tb'i, <verse number="23" style="v" />aye'tzu'n q'ojil tu'n smaj tzaj kyxonju' nimaqkawil Josiy. Xitma'ntzun nimaqkawiltz kyeju' nejenel kye t-xjal te q'oj: ¡Matxi' chin k'ixb'iye' b'a'nxi'x, chin kyiq'i'mixe' tzalu! chij. <verse number="24" style="v" />Ku'tz iq'i'ntzuntz kyu'n kynejel t-xjal te q'oj toju' karwaj te q'oj, okxkyq'o'n toj juntl tkarwaj, xikyiq'i'ntzuntz toj Jerusalen, atzuntzu' kyima'. Okxkyq'o'n toju' muqb'il kyeju' tyajilb'en. Kykyaqil aj Juda ex aj Jerusalen eb'aj oq' ti'j Josiy. <verse number="25" style="v" />Kub' tb'incha'n Jeremiy jun b'itz te tkyimlen Josiy. Majxpe' ekyajtenju' b'itz lu kyu'n aj b'itzal kyi'j kyimni kyxol aj Israel, ex tz'ib'a'nqe' kyxolju' b'itz kye kyimni.</para>
  <para style="p">
    <verse number="26-27" style="v" />Xi' tz'ib'a'na' jni'l tqanil ti'j Josiy kyuk'i'lju' taq'unb'en tb'anilqe' kse'nx tz'ib'a'n toju' tu'jil tkawb'il Qman Dyos, exqe' tb'inchb'aj, ttzaj qe ex tpon b'aj, toju' kyu'jil nimaqkawil toj Israel ex Juda.</para>
  <chapter number="36" style="c" />
  <para style="s1">Tkawb'il Joakas</para>
  <para style="r">(<ref loc="2KI 23:31-35">2 R 23.31-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tzajtzun kyiq'i'n xjal toj tnam Joakas, tk'wal Josiy, ex okkyq'o'n te nimaqkawil toj Jerusalen te t-xelju' tman. <verse number="2" style="v" />Tetoq junaq oxe' (23) ab'q'i Joakas tej ttzyet tkawin, ex oxe' xjaw kawin toj Jerusalen. <verse number="3" style="v" />El iq'i'n tu'n nimaqkawil aj Ejipt toju' kawb'il toj Jerusalen ex tchaq' tu'n tq'o'nte tnam jun chojb'il te oxnaq kab'lajoj kyintal tk'i' oxnaq lib'r (72.60) saqpwaq ex masch'i'n oxnaq kab'lajoj lib'r tk'i' nik'jan (72) q'anpwaq. <verse number="4" style="v" />Expe' atl Elyakyim, ttzik mo titz'in Joakas, oktq'o'n nimaqkawil aj Ejipt te nimaqkawil toj Juda ex Jerusalen, ex tch'exb'e'nju' tb'i, Joakyim tb'i oktq'o'n, atzu'n Joakas xitiq'i'n Ejipt.</para>
  <para style="s1">Tkawb'il Joakyim</para>
  <para style="r">(<ref loc="2KI 23:36-24:7">2 R 23.36—24.7</ref>)</para>
  <para style="p">
    <verse number="5" style="v" />Tetoq junaqjo' (25) ab'q'i Joakyim, ex junlajoj (11) ab'q'i kawin toj Jerusalen. Taq'wix qe'ju' tb'incha twitz Qman Dyos. <verse number="6" style="v" />Tzaju' Nab'ukodonosor, nimaqkawil aj B'ab'ilon, q'ojil ti'j, ex b'ajtk'lo'n tu'n xpatx'q'ank'uxb'il, xitiq'i'ntzuntz B'ab'ilon. <verse number="7" style="v" />Xitiq'i'n Nab'ukodonosor nik'janju' aq'unb'il ate'toq toj tja Qman Dyos, ex eb'jo'kx tq'o'n toju' tja te tk'ulb'il toj B'ab'ilon.</para>
  <para style="p">
    <verse number="8" style="v" />Xi' tz'ib'a'na' jni'tl tqanil ti'j Joakyim, kyuk'i'lju' tb'inchb'en myab'a'n exju' b'aji ti'j, toju' kyu'jil nimaqkawil toj Israel ex Juda. Atl Joakyin ju' tk'wal kawin te t-xel.</para>
  <para style="s1">Xiq'i'n Joakyin B'ab'ilon</para>
  <para style="r">(<ref loc="2KI 24:8-17">2 R 24.8-17</ref>)</para>
  <para style="p">
    <verse number="9" style="v" />Tetoq wajxaqlajoj ab'q'i Joakyin tej ttzyet tkawin, ex oxe' xjaw tk'i' lajoj q'ij kawin. Taq'wixqe'xi'xju' tb'incha twitz Qman Dyos.</para>
  <para style="p">
    <verse number="10" style="v" />Tetzu'n ttzyet q'ijal te ab'q'i lu, tchaq' nimaqkawil Nab'ukodonosor tu'n txiq'i'n toj B'ab'ilon kyuk'i'lju' aq'unb'il twi' wi'yalqe'xi'x toju' tja Qman Dyos, ex atl Sedekyiy, twitze'l Joakyin, oktq'o'n te nimaqkawil toj Juda ex Jerusalen.</para>
  <para style="s1">Tkawb'il Sedekyiy</para>
  <para style="p">
    <verse number="11" style="v" />Tetoq junaq jun (21) ab'q'i Sedekyiy tej ttzyet tkawin, ex kawin junlajoj (11) ab'q'i toj Jerusalen. <verse number="12" style="v" />Taq'wixqe' tb'inchb'en twitz Qman Dyos. Min kub' tme'ssa'ntib' twitz Jeremiy t-sanjelal Dyos, ju' ntoq yolin Dyos toj ttzi. <verse number="13" style="v" />Expe' jawmiltz'uj ti'ju' nimaqkawil Nab'ukodonosor, ja ojetoq ttziya toj tb'i Dyos tu'n tmujb'antetib' tuk'i'l, ex kub' tpi'sa'ntib', mixti'x anjtzti'j tanmi te Qman Dyos.</para>
  <para style="p">
    <verse number="14" style="v" />Ex kykyaqilju' nejenel toj Juda, e'pale exqe' xjal, mixti'x eb'et toj tnik'alti'j, exi' lpe kyi'ju' nimaqtnam taq'wixi'x kyb'inchb'aj witzleb'ilqe' ex mixiti'x e'niman teju' tja Qman Dyos xjan jaw t-sk'o'n toj Jerusalen. <verse number="15" style="v" />Intoq che tzaj tchq'o'n Qman Dyos t-sanjel kukxju' q'malkyeju' toqxenb'il, qu'n intoq laqj tk'u'j ti'ju' ttanam ex ti'ju' ja nna'njtza' tb'i. <verse number="16" style="v" />Aye'tzunkye naq e'jawtze'n kyi'ju' t-sanjelal Dyos, el kyik'o'nju' tqanil tu'n Dyos ex e'xmayin kyi'ju' t-sanjelal, tzmax ttzaj ttx'u'jil Qman Dyos ti'ju' ttanam, mixtzunti'tlte q'anb'iltz te.</para>
  <para style="s1">Kub' xitu'n tja Dyos ex eb'je'xq'i'n aj Juda</para>
  <para style="r">(<ref loc="2KI 25:8-21">2 R 25.8-21</ref>; <ref loc="JER 39:8-10">Jer 39.8-10</ref>; <ref loc="JER 52:12-30">52.12-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" />Tzajtzun tiq'i'n Qman Dyos kynimaqkawil aj Kaldey q'ojil kyi'j, e'kub'tb'yo'n ku'xun tu'n kchil tojku' tja Dyos ex mixti'x tzaj laqj tk'u'j kyi'ju' ku'xun ex txin, kyi'j tijwnaq ex kyi'ju' mixti'x tu'me'l tu'n kyaq'unan. Kykyaqil exi' tq'o'n Qman Dyos toj kyq'ob'. <verse number="18" style="v" />Kykyaqilju' aq'unb'il toj tja Dyos, nimaq ex b'o'sqe', exqe' k'uwenj toj tja Dyos, tk'uwen nimaqkawil ex kyeju' nche kawin tuk'i'l, tkyaqil b'ajx tiq'i'n kynimaqkawil aj Kaldey toj B'ab'ilon. <verse number="19" style="v" />Expe' okkyq'o'n tq'aq'alu' tja Dyos, kub' kytilu'n nintapi ti'j Jerusalen, okkyq'o'n kyq'aq'alu' ja te kawb'il ex b'ajkub' kyxitu'n tkyaqilju' ti'xti' twi' wi'yal ate'toq. <verse number="20" style="v" />Tb'ajlenxi'tzun ja'lu eb'je'xtiq'i'nju' min e'kub'tb'yo'n ex eb'ajx tiq'i'n B'ab'ilon, jae'oka' tq'o'n te tmajen lq'o'n ex kyeju' tk'wal, tzmax tkub'ti'j B'ab'ilon tu'n kynimaqkawil aj Persya, <verse number="21" style="v" />tu'n tjapunju' tyol Qman Dyos tma toj ttzi Jeremiy t-sanjelal. Iktzu'n ojlana' tx'otx'; qu'n atzu' ojlana' ch'i'n, tzajx tej tkub' xitu'nju' tnam, tzmax tb'aj oxnaq lajoj (70) ab'q'i.</para>
  <para style="s1">Tchaq'b'il Siro</para>
  <para style="r">(<ref loc="EZR 1:1-4">Esd 1.1-4</ref>)</para>
  <para style="p">
    <verse number="22" style="v" />Tu'ntzun tjapunju' tyol Qman Dyos q'ma'ntltoq tu'n Jeremiy, xitq'o'n Qman Dyos tipumal Siro, nimaqkawil te Persya, toju' tnejel ab'q'i ntoq kawin, tu'n tex tq'o'n tqanil jun chaq'b'il tu'n yol mujqa tz'ib'a'n, toj tkyaqilju' tx'otx' tjaq' tkawb'il, ikjalu: <verse number="23" style="v" />Intma'n Siro, nimaqkawil te Persya, ikjalu: Matxi' che kub' tq'o'n Qman Dyos te toj kya'j kykyaqilju' kawb'il twitz tx'otx' toj nq'ob'e', ex tzaj toqxena'n weye' tu'n tjaw nb'incha'ne' jun tja Dyos toj Jerusalen, toju' tx'otx' Juda. Qu'mtzun alkyexku'kye' tzajni toju' ttanam Qman Dyos, awtju' Qman Dyos ntnima'n tz'oninte, ex kutanjtlti'j atzu', chiju' tchaq'b'il Siro.</para>
</usx>