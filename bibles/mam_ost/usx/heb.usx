<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="HEB" style="id">HEB. TXT Febrero 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Hebreos</para>
  <para style="toc3">Heb</para>
  <para style="toc2">Heb</para>
  <para style="toc1">U'j kye aj Eb'rey (Hebreos)</para>
  <para style="mt1">U'J KYE AJ EB'REY</para>
  <para style="mt2">(Hebreos)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Naq o'kx mankb'il teju' u'j lu nq'ancha'lixa' qa ikju' kse'n jun u'j xitz'ib'a'n kse'nqe' txqantl. Ate' u'j lu naku'j jun chik'b'ab'l mo jun pakb'ab'l. Tu'nju' tz'ib'a'n toj, nakuj xi' xa'sma'na' kyeju' okslal kyxol aj Juda, tu'nju' ma'toq jaw kyiq'i'n kyib' xjal kyi'j, kyajb'iltoq tu'n tanjtl jumajtlkyi'j tojxju' ojtxi' kytxol ex kyajb'iltoq tu'n tkyej kytzaqpi'nju' okslab'l ti'j Jesukrist. Atzunju' kub' tz'ib'ante u'j nxitjqo'n kynab'l. Atzu' nyolina'xi'xju' u'j lu ajttzaj tzyet (1.1-3) ti'ju' toklen Jesukrist nimaqxi'x oje tzaj tyek'u'n Dyos.</para>
  <para style="ip">In yoliltzuntz nk'u'nile tten ti'j Jesus: Tk'walkuxi'x Dyos tejumajx, b'in b'a'nxi'x te Dyos tojnelju' yajb'il ik'xtu'n, nimaqte' toklen kyekywitzju' t-sanjelal Dyos (1.1) ex kyekywitz anjl nche'x tchq'o'n smal tqanil, (1.4—2.18), nimxi'x toklen kyekywitz Moyses ex Joswe (3.1—4.13), ex nimaqxi'x toklen kyekywitz ojtxi' pale nimaq kyoklen, qu'n aku'te Dyos sok q'onte te nimaq kynejel pale tejumajx (4.14—7.28). Naq tu'nel Jesus, xkyeja' b'ent jun yol ak'a'j ex tb'anil tu'n Dyos kyuk'i'l xjal (8.1—9.28). Tu'nju' mataq'tib' Jesus te chojb'il ex nimxi'x toklen kyekywitzju' chojb'il tman wakx ex tal tman chib', extzun aku' b'inchante chojb'il kse'n kynejel pale tejumajx, alkyete ma tz'okslan te, kkletel tu'n te il, te xob'ajil ex te kamik. Atzuntzu' nel yala' axxi'x kolb'il tk'etz Jesus, myatzu' kyi'ju' txkup nche kub' te chojb'il kse'n yol kyejni b'entti'j tu'n Dyos kyuk'i'l xjal ojtxi', naq jun yek'b'ilpunte' ti'ju' xi'toq tulkanun (10.1-31).</para>
  <para style="ip">Naqna' o'kx tu'n okslab'l nqk'mo'na' kolb'il lu, aju' kub' tz'ib'ante u'j lu nyolin ti'j txqan techlal ti'ju' tqanil kyi'j aj Juda, ti'ju' okslab'l nimaq toklen. Tu'ntzunju', in okten tzak'ulkye okslal tu'n kykub' we' b'a'nxi'x toj kyokslab'l tzmax ajtjapun b'ajsb'il q'ij, ex tu'n tok kyq'o'n kywitz ti'j Jesus, tu'n tik'xju' yajb'il kyu'n ex tu'n tik'xju' kyu'n qama tzaj joyb'ilkyi'j. Aju' tnej oxlajoj nb'aj yolin ti'j txqan tzak'b'il, e'kub'sb'il ex e'mankb'il q'olb'eb'l.</para>
  <chapter number="1" style="c" />
  <para style="s1">Yolin Dyos tu'nelju' Tk'wal</para>
  <para style="p">
    <verse number="1" style="v" />B'a'npun maj yolin Dyos ojtxi' kyeju' qyajilb'en ex yolin toj chukchaq tu'me'l kyu'nelju' t-sanjelal. <verse number="2" style="v" />Atzu'n toju' mankb'il tq'ijlalil ja'lo, mayolin qe tu'nelju' Tk'wal, ex tu'nelju' Tk'wal kub' tb'incha'na' tkyaqilju' twitz tx'otx' exju' kya'j, ex axju' Tk'wal sok tq'o'n etzilte. <verse number="3" style="v" />Intqoptz'a'n K'walb'aj t-spik'umal Dyos ex tipumal, qu'n axju' K'wa'lb'aj tilb'ilal Dyos ex tu'nju' tyol tzyu'na' tkyaqilju' ati twitz tx'otx' ex twitz kya'j. Qb'ajlenxi'tzun txjet tu'n toj qil, kub' qe toj tb'a'nq'ob' Dyos toj kya'j.</para>
  <para style="s1">Nimxi'x toklen Tk'wal Dyos kyekywitz anjl</para>
  <para style="p">
    <verse number="4" style="v" />Nimxi'x toklenju' Tk'wal Dyos kyekywitz anjl, qu'n nimxi'x toklenju' tb'i oktq'o'n Dyos kyetwitz kyb'i anjl. <verse number="5" style="v" />Qu'n mixti' xitma'nte Dyos te jun anjl kjalu:</para>
  <para style="q">Aya Nk'wale';</para>
  <para style="q">Ayine' ẍinx q'onte tchwinqlala, chiwt.</para>
  <para style="b" />
  <para style="m">Ex mixti' tma ti'j jun anjl kjalu:</para>
  <para style="q">Ayine' chin okyel te tman,</para>
  <para style="q">atzunte k'okyel te nk'wale', chiwt.</para>
  <para style="m">
    <verse number="6" style="v" />Tetzunj ttzaj tq'o'n Tk'wal twitzju' tx'otx' lu, tma kjalu:</para>
  <para style="q">Ati tu'n kyk'ulun kykyaqilju' anjl twitz, chi Dyos.</para>
  <para style="m">
    <verse number="7" style="v" />Atzu'n kyi'ju' anjl tma Dyos kjalu:</para>
  <para style="q">Che okyel nq'o'ne' anjl kse'n kyq'iq',</para>
  <para style="q">ex che okyel nq'o'ne' ajb'el kse'n q'aq', chi Dyos.</para>
  <para style="m">
    <verse number="8" style="v" />Atzu'n ti'ju' Tk'wal intma'n kjalu:</para>
  <para style="q">Milo b'ajela' tkawb'ila, Dyos,</para>
  <para style="q">ex nkawina tojxi'x tu'me'l.</para>
  <para style="q">
    <verse number="9" style="v" />Ma tk'u'jlaya tnik'alilti'j ex matz'el tik'una myab'a'n;</para>
  <para style="q">qu'mtzun ma sk'onjtza tu'n Dyos Tdyosa,</para>
  <para style="q">ex tzalajb'ilxi'x ta'ya tu'n</para>
  <para style="q">kyekwitzju' tuk'ila, chi Dyos.</para>
  <para style="m">
    <verse number="10" style="v" />Ex ikx intma'n:</para>
  <para style="q">Taye, aya kub' b'inchante tq'uqb'il tx'otx' atxi'x t-xe tnejel;</para>
  <para style="q">ex aya kub' b'inchanteju' kya'j.</para>
  <para style="q">
    <verse number="11" style="v" />Tkyaqiltzu'n tb'inchb'ena lu kche najel,</para>
  <para style="q">atzunta ktenb'ela kukxju' tejumajx.</para>
  <para style="q">Kykyaqil che b'ajel kse'n xb'alun inb'aj;</para>
  <para style="q">
    <verse number="12" style="v" />¡kche b'eltb'altz'i'na nakuj jun xb'alun,</para>
  <para style="q">kche ch'ixpetel tu'na nakuj jun ch'ix xb'alun!</para>
  <para style="q">Atzunta kukx ttenju'ya tejumajx;</para>
  <para style="q">ex mixti'x b'ajsb'il teju' tchwinqlala, chi Dyos.</para>
  <para style="m">
    <verse number="13" style="v" />Mixti' junmaj tmate Dyos te jun anjl kjalu:</para>
  <para style="q">Qeku'ya ntx'u'kye' toj nb'anq'ob'e',</para>
  <para style="q">tzmax ajkykub' nq'o'ne' tajq'oja tjaq' tqana, chiwt.</para>
  <para style="m">
    <verse number="14" style="v" />Qu'n kykyaqilkye' anjl xewb'ajqe' ex inche ajb'en te Dyos, ex inche tzaj chq'o'n tu'n Dyos onilkyeju' nche k'monte kolb'il.</para>
  <chapter number="2" style="c" />
  <para style="s1">Nimaq toklenju' kolb'il saj q'o'n qe</para>
  <para style="p">
    <verse number="1" style="v" />Qu'mtzun ati tu'n tok tenxi'x qnab'l ti'ju' yol matxi' qb'i, tu'ntzun lalun tz'el qpa'nqib' ti'j Dyos. <verse number="2" style="v" />Nimxi'xpena' toklenju' chaq'b'il kyma anjl ojtxi', aye'tzu'n mixti' xikynima'n ex eb'jik' tib'aj, kub' tz'e'ysa'n kywitz tojxi'x tu'me'l. <verse number="3" style="v" />¿Yajtzunqe, se'ntaq'wi tu'n qtzaqpaj teju' tz'e'ysb'il witzb'aj, qama kyej qtzaqpi'nju' kolb'il nimxi'x toklen? Qu'n aku'te Qajaw pakb'ante tqanil ti'j kolb'il tnejelxi'x, aye'tzu'n eb'inte kyma qa axxi'xju' yol lu, ex aye' ẍekyej q'onte qe. <verse number="4" style="v" />Ex aku'te Dyos tzaj kuwsantexi'x qa axju' yol tzaj tma'n qe kyu'n techlal, kyu'n tb'inchb'en tb'anilxi'x ex txqan b'a'nq'ob'aj b'ent tu'n Xewb'aj Xjan toj chukchaq tu'me'l, kse'nxju' tajb'il Dyos.</para>
  <para style="s1">Ikyte Jesukrist kse'n qtzik</para>
  <para style="p">
    <verse number="5" style="v" />Qu'n min tmate Dyos kye anjl tu'n kykawin kyib'aju' xjal toju' tq'ijlalil tzul, aju' nqo yolin ti'j. <verse number="6" style="v" />Tchik'b'a pe'na' jun toju' tyol Dyos kjalu:</para>
  <para style="q">¿Titi'tzun toklenju' ichan? ¿titi'tzun kyoklenju' xjal?</para>
  <para style="q">¿Titi'qu'n intzaja' tna'na ex inxi'x ximana kyi'j?</para>
  <para style="q">
    <verse number="7" style="v" />Oktq'o'na jte' q'ij naqch'i'n toklen kyekywitz anjl,</para>
  <para style="q">extzun oktq'o'na toklen nimxi'x tu'n tjaw nima'n;</para>
  <para style="q">
    <verse number="8" style="v" />tkyaqil kub' tq'o'na tjaq' tqan tu'n tkawin kyib'aj, chij.</para>
  <para style="b" />
  <para style="m">Tu'ntzunju' kub' tq'o'n Dyos tkyaqil tjaq' tqanju' ichan, tkyaqil kyejten tjaq' tkawb'il. Na'mxtzun qlonte ja'lo qa tkyaqilwit tkub' tjaq' tkawb'il ichan. <verse number="9" style="v" />Lutzunte' Jesus, oktq'o'n Dyos jte' q'ij naqch'i'n toklen kyekywitz anjl, atzun ja'lo matxi' q'o'n toklen nimxi'x ex majaw nimsa'n naq tu'nju' ik'x kamik tu'n, kyim naq tu'n qpaj qkyaqil tu'nju' t-xtalb'il Dyos.</para>
  <para style="p">
    <verse number="10" style="v" />Kub' tb'incha'n Dyos tkyaqilju' ti'xti' tu'n tajb'en te, ex a tajb'il Dyosju' tu'n kyten kykyaqil tk'wal tuk'i'l toj tajwalil. Qu'mtzun atitoq tu'n tok Jesukrist tz'aqlixi'x tu'n Dyos tu'n tik'x tkyaqilju' yajb'il tu'n ex tu'n tok b'inchalte kolb'il kyeju' xjal. <verse number="11" style="v" />Aye'tzunju' mache eltpa'n Krist tu'n kyajb'en o'kxte Dyos, junx kyman tuk'i'l Krist sel pa'nkye; qu'mtzun mixti' nch'ixwite Krist tu'n kyoktq'o'n te titz'in. <verse number="12" style="v" />Qu'n intma'n toj Tu'jil kjalu:</para>
  <para style="q">Kxe'l npakb'ane' tb'iya kyeju' witz'ine',</para>
  <para style="q">ex chin b'itzale' ti'ju' tb'iya toju' b'u'yb'il kyib', chij.</para>
  <para style="m">
    <verse number="13" style="v" />Ex ikx intma'ntl kjalu:</para>
  <para style="q">Atzu' kqeb'ila' nk'u'je' ti'j, chij.</para>
  <para style="b" />
  <para style="m">Ikx jumajtl intma'n:</para>
  <para style="q">Luqine' atinqine' kyuk'ilju' k'wa'lb'aj e'tzaj tq'o'n Dyos weye', chij.</para>
  <para style="p">
    <verse number="14" style="v" />Ikse'nqe' k'wa'lb'aj kyitz'inkyib' junx kychib'jil ex kychk'el, ikyxtzunte Jesusju' tej tok te xjal, ok te xjal tu'n tb'ent tkyim, tu'ntzun tkub' t-xitu'n tipumal tajaw kamik, aju' tajaw il. <verse number="15" style="v" />Tu'ntzu'n tkamik, ẍetzaqpeta'ju' xjal nche' xob' te kamik tkyaqil q'ij. <verse number="16" style="v" />Qu'n min ulte' Qajaw Jesukrist onilkye anjl, xi' u'late' onilkyeju' tyajajil Ab'raam. <verse number="17" style="v" />Tu'ntzun tb'ent tonin kyi'ju' xjal atitoq tu'n tok ikxju' kse'nkye, tu'ntzun tok te jun kynejel pale, in japunxi'x tu'n toj tajb'eb'l twitz Dyos, ex tu'n tchjet kyil xjal tu'n tu'nju' tkamik. <verse number="18" style="v" />Tu'ntzunju' yajtite Krist ex ok toj joyb'ilti'j tu'n tajaw il, qu'mtzun ati tipumal tu'n tonin kyi'ju' nche ok toj joyb'ilkyi'j.</para>
  <chapter number="3" style="c" />
  <para style="s1">Nimxi'x toklen Jesus kyetwitz Moyses</para>
  <para style="p">
    <verse number="1" style="v" />Qu'mtzun e'ntzik ex e'witz'in, aye'ye' oje che txokliye' tu'n Dyos tu'n kyokye' teku'xi'x, che ximanqe'ye' ti'ju' Jesukrist, Chq'o'n ex Kynejel pale nimaq toklen toj qokslab'l. <verse number="2" style="v" />Qu'n oktq'o'n Dyos toklen Jesus nimxi'x, kse'n jun kynejel pale, ex tkyaqilju' tyol Dyos japunxi'x tu'n, kse'nte Moyses japunxi'x tkyaqil tu'n kyxolju' ttanam Dyos. <verse number="3" style="v" />Atzunte Dyos oktq'o'n toklen Jesus nimxi'x kyetwitz Moyses, ikse'n jun b'inchal ja, nimxi'x toklen kyetwitzju' ja nb'ent tu'n. <verse number="4" style="v" />Qu'n tkyaqil ja ati jun b'inchalte; ikxtzunte Dyosju' ate b'inchante tkyaqilju' ati. <verse number="5" style="v" />Ajb'ente Moyses te Dyos, japun tu'n toj tkyaqil tajb'eb'l kyxol ttanam Dyos, ex ttziyaju' oktoq tma' Dyos yajxi'tl. <verse number="6" style="v" />Atzunte Krist K'walb'ajte, japunxi'x tu'n kyxolju' ttanam Dyos, ayo' qa q'uqli qk'u'j ti'j kukxju', exqa kukxju' nqo' ayon ti'j toj tzalajb'il.</para>
  <para style="s1">Jun ojb'il kyeju' ttanam Dyos</para>
  <para style="p">
    <verse number="7" style="v" />Qu'mtzun kse'n intma'n Xewb'aj Xjan toju' Tu'jil tyol Dyos kjalu:</para>
  <para style="q">Qama kyb'iju'ye' intma'n Dyos ja'lo,</para>
  <para style="q">
    <verse number="8" style="v" />Lalun kub' kych'uẍsa'n kyanmiye' kse'n kyb'incha aj Israel tej tok kyq'o'n ttx'u'jil Dyos</para>
  <para style="q">ex okkyq'o'n Dyos toj joyb'ilti'j toj chq'ajlaj.</para>
  <para style="q">
    <verse number="9" style="v" />Qu'n tma Dyos kjalu: Atzu' noka'ye' toj joyb'ilwi'je' kyu'n ojtxi' kyajilb'ene',</para>
  <para style="q">extzun matxi'toq tz'ok kyka'yi'n nb'inchb'ene' toju' kab'naq ab'q'i.</para>
  <para style="q">
    <verse number="10" style="v" />Qu'mtzun tzaj ntx'u'jile' kyi'j,</para>
  <para style="q">ex nmaye': Kukx kytenjuye' chukjni kynab'le',</para>
  <para style="q">ex min kyajb'ile' tu'n kyoklpeye' wi'je', nchije'.</para>
  <para style="q">
    <verse number="11" style="v" />Qu'mtzun tzaja' nq'oje kyi'j ex nmaye' kye qa lay che okx toju' tx'otx' te ojb'il wu'ne', chi Dyos.</para>
  <para style="p">
    <verse number="12" style="v" />Qu'mtzun, kyka'yinx kyib'e' e'ntzik ex e'witz'in tu'n lalun tz'el kypa'n kyib'e' ti'ju' Dyos itz'; qu'n jaku' tu'n tpaj kyanmiye' myab'a'n mintz'oka' qe kyk'u'je' ti'j Dyos. <verse number="13" style="v" />Kyq'uqb'am pe'kye' kyk'u'j kyxolilexe' atl junjun q'ij, atixku' anb'il tu'n kyb'inchanteye', tu'ntzun lalun kub' sb'u'n junkye' tu'n il ex tu'n lalun che okye' pi's twitz Dyos. <verse number="14" style="v" />Qu'n atiqe qoklen tuk'i'l Jesukrist, qa kukx qtenju' wa'lqoxi'x toj qokslab'l exqa q'uqlokxi'x qk'u'j ti'j kse'nxju' tnejel.</para>
  <para style="p">
    <verse number="15" style="v" />Qu'mtzun intma'n toj Tu'jil kjalu:</para>
  <para style="q">Qama kyb'iju'ye' intma'n Dyos ja'lo,</para>
  <para style="q">lalun kub' kych'uẍsa'n kyanmiye' kse'nqe' aj Israel okkyq'o'n ttx'u'jil Dyos, chij.</para>
  <para style="m">
    <verse number="16" style="v" />¿Alkyeqe'tzu'n eb'inte tyol Dyos ojtxi', ex e'okten q'olte ttx'u'jil Dyos? Kykyaqilju' eb'je'tz tiq'i'n Moyses toj Ejipt. <verse number="17" style="v" />¿Ex alkyeqetzu'n tzaj ttx'u'jil Dyos kyi'j toju' kab'naq ab'q'i? Aye'ju' eb'inchan il ex axtzu' e'kyaja' kyim toj chq'ajlaj. <verse number="18" style="v" />¿Ex alkyetzun xa'ya' tma'n Dyos qa lay che okx toju' tx'otx' te ojb'il tu'n Dyos? Kyeju' min xikynima'n tyol Dyos. <verse number="19" style="v" />Atzuntzu' nka'yina', qa min e'okxju' aj Israel toju' tx'otx' jatoq tu'n kyojlana' tu'n Dyos, tu'n tpaj min xikyoksla'n tyol Dyos.</para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Qu'mtzun, atixku' anb'il qe tu'n qok toju' ojb'il tzajni ttziya'n Dyos, ati tu'n txi' qka'yi'n qib', qu'n jaku' ati junqe min b'ent tokx toju' ojb'il kub'ni tb'incha'n Dyos. <verse number="2" style="v" />Qu'n matxi' tzaj pakb'a'n tpakb'al b'a'n qe, kse'n xipakb'a'n kye xjal ojtxi'; aye'tzunkye mixti'x ajb'en kye, qu'n kyb'i extzun min xikyoksla'n. <verse number="3" style="v" />Ayo'tzunqe oje qo' okslan te, qo'qe' okyex toju' ojb'il b'incha'n tu'n Dyos, kse'nju' oje tma:</para>
  <para style="q">Qu'mtzun oje tzaj nq'oje kyi'j</para>
  <para style="q">ex oje txinma'ne' kye qa lay che okx toju' ojb'il b'incha'n wu'ne' Dyos, chi Dyos.</para>
  <para style="b" />
  <para style="m">Tma Dyos ja'lu, maskye ojetoq b'aj b'entju' taq'un, atxi'x tej tb'ent tkyaqil twitz tx'otx'; <verse number="4" style="v" />qu'n ati jun tnej toj Tu'jil tyol Dyos nyolin ti'ju' twuqi'n q'ij ex intma'n kjalu:</para>
  <para style="q">Ojlante Dyos tej tb'entju' taq'un toj twuqi'n q'ij, chij.</para>
  <para style="m">
    <verse number="5" style="v" />Ex intma'n jumajtl toju' Tu'jil tyol Dyos:</para>
  <para style="q">Lay che okxkye' toju' ojb'il b'incha'n wu'ne', chij.</para>
  <para style="m">
    <verse number="6" style="v" />Aye'ju' e' b'inte tpakb'al b'a'n nejku' min ẍe'okx toju' ojb'il tu'n tpaj min xikynima'n Dyos. Atzunte tzajni ttziya'n Dyos atixte' kyeju' junjuntl na'mx kyokx. <verse number="7" style="v" />Qu'mtzun matzaj tq'o'n Dyos jun q'ijtl anb'il, aju' tq'ijlalil ja'lo, ex matzaj tma'n qe kse'n tma ojtxi' kye' aj Israel tu'nel Dab'i kjalu:</para>
  <para style="q">Qama kyb'iye' ntma'n Dyos ja'lo,</para>
  <para style="q">lalun kub' kych'uẍsa'n kyanmiye', chij.</para>
  <para style="m">
    <verse number="8" style="v" />Qu'n naqwit xitq'o'n Joswe ojb'il kye aj Israel, mixti'wtlo yolin ti'j juntl tq'ijlalil. <verse number="9" style="v" />Qu'mtzun atix jun q'ijtl anb'il kyeju' ttanam Dyos tu'n kyokx toju' ojb'il kub' tb'incha'n Dyos; <verse number="10" style="v" />alkyete matz'okx toju' ojb'il b'incha'n tu'n Dyos, k'ojlaltzuntz toju' taq'un, ikse'nte Dyos ojlan tej tb'aj b'entju' taq'un. <verse number="11" style="v" />Qq'onktzun tilil tu'n qokx toju' ojb'il b'incha'n tu'n Dyos, tu'n mix-a'lo' tz'ok kse'nqe'ju' min xikyoksla'n tyol Dyos.</para>
  <para style="p">
    <verse number="12" style="v" />Qu'n itz'te' tyol Dyos ex ati tipumal. Tzayunxi'xte' twitzte kyetwitz jun k'uẍtx'e'nb'il jqu'n twitzte toj kykab'il plaj, majx in okpun tojxi' qanmi ex tzmax toj kyaqamil qb'aqil; inb'aj tka'yi'n tkyaqilju' qxim ex tb'is qk'u'j. <verse number="13" style="v" />Mixti'x jun tb'inchb'aj Dyos kb'entel tewin twitz, qu'n tkyaqil ti'xti' q'ancha'lile' twitz Dyos, ja kxe'la' qchik'b'a'n tkyaqilju' qb'inchb'en.</para>
  <para style="s1">Nimxi'x toklen Jesus kse'n kynejel pale</para>
  <para style="p">
    <verse number="14" style="v" />Ate Jesus, Tk'wal Dyos, Kynejel pale nimxi'x toklen qe oje pon kanun toj kya'j. Qu'mtzun ati tu'n qwab'anteqib' toj qokslab'l ti'j. <verse number="15" style="v" />Qu'n aju' kynejel pale qe intzaj q'aq'an tk'u'j qi'j tu'n tpaj mixti' qipumal, qu'n ikx okte toj joyb'ilti'j tu'n tajaw il kse'nx nqo' ik'a'; naqtzun ate mixti' b'inchan il. <verse number="16" style="v" />Qoqe' lq'extzun tk'etz Dyos qek qk'u'j tu'n qpon kanun twitzju' tq'uqb'il jata' t-xtalb'il, tu'ntzun qtzajtq'o'n t-xtalb'il qe toju' tq'ijlalil inxi'x ojqelan toj qchwinqlal.</para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Kykyaqilju' kynejel pale, inche jaw sk'o'n kyxol xjal ex in okq'o'n kyoklen tu'n kyyolin kyi'j xjal twitz Dyos, ex tu'n tkub' kyq'o'n oyaj ex chojb'il tu'n tchjet kyil xjal. <verse number="2" style="v" />Intzaj q'aq'an tk'u'ju' kynejel pale lu kyi'ju' mixti' b'a'n kyu'n ex kyi'ju' nche eltxalpuj ti'j Dyos, qu'n ikxnate mixti'xi'x tipumal; <verse number="3" style="v" />tu'ntzun tpaju' mixti'xi'x tipumal, ilti'j tu'n txitq'o'n chojb'ilte til ex chojb'ilte kyilju' tnam. <verse number="4" style="v" />Mix-a'lox jun xjal kb'entil t-sk'ontetib' tib'xtib' tu'n tok te nejenel, qu'n aku'te Dyos ntzaj txkonte ex aku' nokq'onte toklen kse'nte Aaron. <verse number="5" style="v" />Qu'mtzun ikxte Kristju' mya' tu'nxtib' oka' te Nejenel, aku'te Dyos okq'onte toklen, qu'n a Dyos q'mante te kjalu:</para>
  <para style="q">Ateju'ya nk'wale';</para>
  <para style="q">matxi' txi' nq'o'ne' tchwinqlala ja'lo, chi Dyos.</para>
  <para style="m">
    <verse number="6" style="v" />Ex xitma'n Dyos te toj jun tnejtl Tu'jil kjalu:</para>
  <para style="q">Aya pale te jumajx,</para>
  <para style="q">ikx toklena kse'n toklen Melkisedek, chij.</para>
  <para style="m">
    <verse number="7" style="v" />Tej tten Jesukrist twitz tx'otx', na'n Dyos tuk'i'l tkyaqil tipumal expe' majx oq' twitz Dyos inxi'xtoq kub'san tu'n tklonjtz toju' kamik; tzajtzun ttzaq'we'n Dyos tkub'sb'il tu'nju' atixi'x tchiylal Dyos te. <verse number="8" style="v" />Tu'npetzu'n aku'te Krist Tk'wal Dyos, b'ent tnimet Dyos tu'n toj tkyaqilju' yajb'il ik'xtu'n; <verse number="9" style="v" />Tetzunj tjapun tzqet tkyaqil tu'n, oktzuntz te b'inchal kolb'il tejumajx kye kykyaqilju' nche okslan te, <verse number="10" style="v" />ex oktq'o'n Dyos te Kynejel pale kse'n toklen Melkisedek.</para>
  <para style="s1">Oqxenb'il kyi'ju' chalyol</para>
  <para style="p">
    <verse number="11" style="v" />Nimte' tu'n qyolin ti'j ja'lu, naqtzun aju' ch'uẍ tu'n tb'ajx nchik'b'ane' kyeye', qu'n mya lwiy nkane toj kywitze'. <verse number="12" style="v" />Ayepe'wtlokye' nche q'o'n xnaq'tzb'il ja'lo tu'nju' ojtxi' okslalqeye'; atzunte' ape' kyajb'iljuye' tu'n kyxi' xnaq'tzet jumajtle' kyi'ju' tal tnejel xnaq'tzb'il ti'j tyol Dyos. Matxi' che okye' naku'j ne'ẍ o'kx kyajb'il kych'uye', atzu'n wab'j kuw min nxi' kyu'ne'. <verse number="13" style="v" />Aye'tzu'n inx che ch'u'n ikqe'ju' kse'n jun ne'ẍ, min nelkynik' ti'ju' xnaq'tzb'il tnik'alxi'xti'j. <verse number="14" style="v" />Aye'tzunkye' xjal matxi' che ch'iy a kywaju' wab'j kuw, aye'ju' inel kynik' ti'ju' b'a'n ex ti'ju' myab'a'n, qu'n matxi' tzik' kywitz ti'j nim ti'xti'.</para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Qu'mtzun qq'ok tilil tu'n qch'iy, lalun qo kyejten axtzu' toju' tnejel xnaq'tzb'il ti'j Krist. Lalun tz'anjtlqi'j kyi'ju' xnaq'tzb'il tzaj q'o'n qe nejku', kse'n ti'ju' tu'n tanjtzti'j qanmi kyi'ju' qb'inchb'aj myab'a'n, ti'j qokslab'l ti'j Dyos, <verse number="2" style="v" />ti'ju' xnaq'tzb'il tib'aj jawsaj a', ti'ju' nkub' q'et q'ob'aj toj kywi' okslal, ti'ju' anq'ib'l kye kyimni ex ti'ju' tz'e'ysb'il witzb'aj tejumajx. <verse number="3" style="v" />K'okyelxi'xtl tilil qu'n tu'n ttenxi'xtl qojtzqib'l qa ax tajb'il Dyosju'.</para>
  <para style="p">
    <verse number="4" style="v" />Qu'n aye'ju' ma spik'b'anjtz toj kynab'l ex kyk'amju' oyaj tzaj toj kya'j, ex kyk'amju' Xewb'aj Xjan, <verse number="5" style="v" />matz'el kynik' ti'ju' tyol Dyos ex kyi'ju' ipumalj che ul toju' tq'ijlalil tzul, <verse number="6" style="v" />qama che kub' tz'aq jumajtl, lay b'ent tanjtz jumajtlti'j kyanmi twitz Dyos, qu'n injaw kyq'o'n jumajtl Qajaw Jesukrist twitz krus ex nel tch'ixaw kyu'n kywitz kykyaqil xjal. <verse number="7" style="v" />Ikse'n tx'otx' nak' tu'n jb'al nkub' tib'aj: qama taq'ju' tx'otx' lu tawal b'a'n kyeju' nche aq'unan, kk'i'wlanjtzel tu'n Dyos; <verse number="8" style="v" />qatzun ch'i'x mujqa saqch'i'x tawalju' tx'otx' lu xtaq', mixti'x tajb'en, ktzajel txko'n toj twi' tu'n Dyos ex majx kb'el tz'e'ysa'n.</para>
  <para style="s1">Qek qk'u'j kukxju' ti'j Dyos</para>
  <para style="p">
    <verse number="9" style="v" />E'ntzik ex e'witz'in, q'uqlixi'x nk'u'je' kyi'je', maskye nchin yoline' kyeye' ti'ju' tx'otx' myab'a'n, qu'n q'uqlikye' kyk'u'j ti'j Dyos ex lepchqekye' ti'ju' tb'eyil kolb'il. <verse number="10" style="v" />Qu'n tnik'alte Dyos ti'j, lay tzik'tna'l tu'n tkyaqilju' b'a'n nkyb'incha'ne' ex ljo'nx kyb'inchanteye' kyeju' okslal te, tu'ntzun ja'lu nkyek'una'ye' qa inkk'u'jla'ne' Dyos. <verse number="11" style="v" />Naq aju' a qajb'ilju'ye' tu'n toktilil kyu'ne' teyile junjun tu'n tjapun tu'n twitz Dyos, tu'ntzun kyk'monteye' nche ayone' ti'j. <verse number="12" style="v" />Min qajb'ile' tu'n kyokye' ky'ej, kyknomile' kyi'ju' ati kyokslab'l ex nten kpasens, qu'n ikytzu'n kyk'ma'ya'ju' tzajni ttziya'n Dyos.</para>
  <para style="p">
    <verse number="13" style="v" />Tej ttzaj ttziya'n Dyos tyol te Ab'raam, axju' tb'i tzaj tna'n ti'ju' tyol, qu'n mixti' juntl nimxi'x toklen kyetwitz tu'n ttzaj tna'n ti'j tyol; <verse number="14" style="v" />ex tma: Kb'el nk'i'wla'na b'a'nxi'x ex kche chmetel tyajila b'a'nxi'x wu'ne', chi Dyos te Ab'raam. <verse number="15" style="v" />Tentzun tpasens Ab'raam ex kub' tyo'n, ex tk'amju' tzaj ttziya'n Dyos te. <verse number="16" style="v" />Qama tzajkyna'n xjal tb'i juntl ajkymante jun kyyol, intzajkyna'n tb'i juntl nimxi'x toklen kyekywitz, qu'n aye' tziyalju' ti'j tkyaqil. <verse number="17" style="v" />Qu'mtzun axte Dyos tb'i tzaj tna'n ti'ju' tyol, qu'n tajb'il Dyos tu'n tyek'u'nte qa lay tch'exb'eju' tzajni ttziya'n. <verse number="18" style="v" />Tu'ntzu'n kab'e' tu'me'l lu in qexi'x qk'u'j ti'j Dyos, qu'n tu'nju' tzajttziya'n ex tu'nju' tzaj tna'n tb'i, axxi'xju' yol ex layx jaw tch'exb'e'n oje tzaj ttziya'n qe. <verse number="19" style="v" />Tu'ntzunju' tzajni ttziya'n Dyos lu in qeya' qk'u'j, kse'n jun k'uxb'il nku'x q'o'n t-xe a' tzyulteju' b'ark tu'n lalun yukchi. Atzunqe tzyulqe atzu' tzajna' ti'jxi'ju' xb'alun yo'l toj tnk'yejchaqil tja Dyos toj kya'j, <verse number="20" style="v" />ja okxa' nej Jesus qwitz jqolteju' tb'eyil tk'etz Dyos, matz'ok Jesus te kynejel pale nimxi'x toklen tejumajx, kse'n toklen Melkisedek.</para>
  <chapter number="7" style="c" />
  <para style="s1">A Krist pale kse'n toklen Melkisedek</para>
  <para style="p">
    <verse number="1" style="v" />Ate Melkisedek nimaqkawiltoq toj tnam Salem ex paletoq te Dyos nimxi'x toklen. Tej tanjtzti'j Ab'raam toj q'oj, tkub'lenxi' kyi'ju' nimaqkawil tu'n, etz Melkisedek k'lulte ex kub' tky'iwla'n Ab'raam; <verse number="2" style="v" />xi'tzun tq'o'n Ab'raam tlajoji'n tnej te Melkisedek ti'j tkyaqil tkamb'a toju' q'oj. Aju' b'iyj Melkisedek a tz'elpuna'ju' nimaqkawil tnik'alxi'xti'j, expe' a juntl tb'iju' nimaqkawil toj Salem, atz'elpuna'ju': nimaqkawil q'ol nak'b'il. <verse number="3" style="v" />Mixti'x b'i'n alkye tman Melkisedek, alkye ttxu ex alkyeqe' ojtxi' tyajilb'en; min b'i'n jtoje titz'ji ex jtoje tkyim; ikyininxju' kse'n Tk'wal Dyos, aju' pale tejumajx.</para>
  <para style="p">
    <verse number="4" style="v" />Nimxi'xte' toklen Melkisedek, qu'n xitq'o'n qyajilb'en Ab'raam tlajoji'n ti'ju' tkanb'a toj q'oj te. <verse number="5" style="v" />Kse'n intma'n toj tkawb'il Moyses, ati kyoklenju' pale tyajajil Leb'i tu'n tel kypeyu'n tlajoji'n tkyaqil ti'xti' kyi'ju' tnam, aye'xju' kywnaqil, maskye tyajajilx Ab'raamqe'. <verse number="6" style="v" />Atzunte Melkisedek, maskyepe' mya tyajajil Leb'i, tk'amju' tlajoji'n te Ab'raam ju' ojetoq ttziya Dyos tyol te. Ex kub' k'iwla'n Ab'raam tu'n Melkisedek; <verse number="7" style="v" />ex mix-a'lox kb'entel tewante qa nimxi'x toklenju' ink'iwlan kyetwitzju' nkub' k'iwla'n. <verse number="8" style="v" />Aye'kye' nche k'monte tlajoji'n toju' tq'ijlalil ja'lo, ichanqe' inche kyim; atzunte' intma'n toj tu'jil ti'j Melkisedek, kukx ttenju' qu'm mixti' intma'n toj Tu'jil qa oje kyim. <verse number="9" style="v" />Toj juntl tu'me'l, aye' pale tyajajil Leb'i inche peyun tlajoji'n ja'lo, xikychjo'n tlajoji'n te Melkisedek tej t-xitchjo'n Ab'raam te; <verse number="10" style="v" />qu'n tu'nju' tyajajil Ab'raamqe', maskye na'mxtoq kyitz'ji, naku'j aye'jun ate'toq tej tetz Melkisedek k'lulte Ab'raam.</para>
  <para style="p">
    <verse number="11" style="v" />Kyk'am aj Israel tkawb'il Moyses nyolin kyi'ju' pale tyajajil Leb'i, aye' tyajajil Aaron. Naqwit mache okju' aj Israel tnik'alkyi'j kyu'n pale lu, myawtlo ilti'j tu'n ttzaj juntl pale junxi'tl, kse'n toklen Melkisedek mya tyajajil Aaron. <verse number="12" style="v" />Qama che ch'exb'etkye' pale, ex ati tu'n tch'exb'etju' kawb'il; <verse number="13" style="v" />myana' tyajajil Aaron te' Qajaw, kse'n intma'n toj Tu'jil, xi'tzajna'te ti'j juntl tnej kyajil aj Israel b'ajx tz'etza' jun pale kyxol. <verse number="14" style="v" />Qu'n b'i'nxi'x qu'n qa xi' itz'ja' Qajaw Jesukrist ti'j tyajajil Juda; ex tej tyolin Moyses min tma qa che okyel aj Juda te pale.</para>
  <para style="p">
    <verse number="15" style="v" />Chik'lixi'xtzuntz qa aju' k'a'j pale lu junxi'tlte', ikx toklenju' kse'nte Melkisedek, <verse number="16" style="v" />min sok te pale tu'nwtju' tyajajil kse'n intma'n kawb'il, ma tz'okte' te pale tu'nju' tchwinqlal mlay b'aj. <verse number="17" style="v" />Qu'n intma'n Dyos ti'j toj Tu'jil kjalu:</para>
  <para style="q">Aya pale tejumajx,</para>
  <para style="q">ikx toklenju'ya kse'nte Melkisedek, chij.</para>
  <para style="m">
    <verse number="18" style="v" />Ikytzu'n makyej najte' ojtxi' chaq'b'il tu'n tpaj mixti' tipumal ex mixti' tajb'en, <verse number="19" style="v" />qu'n min xb'ent kyokju' xjal tnik'alkyi'j tu'n tkawb'il Moyses, ex ma tzaj q'o'n jun q'uqb'ab'l qk'u'j b'a'nxi'x te t-xelju' kawb'il lu, tu'n qpon lq'e tk'etz Dyos.</para>
  <para style="p">
    <verse number="20" style="v" />Tzaj tna'nte Dyos tb'i tej tok Jesukrist te pale, atzu'n tej kyokju' txqantl pale min tzaj tna'n tb'i, <verse number="21" style="v" />atzu'n tej tok Jesukrist te pale tzaj tna'n Dyos tb'i ti'j, qu'mtzun tz'ib'a'n toj Tu'jil kjalu:</para>
  <para style="q">Tzaj tna'nte Dyos tb'i ti'j</para>
  <para style="q">ex lay tch'exb'eju' tyol</para>
  <para style="q">qu'n tma: Aya pale tejumajx, chij.</para>
  <para style="m">
    <verse number="22" style="v" />Ikytzu'n a Jesus tziyante ex tq'uqb'axi'x tk'u'jlalil, qa ktb'incha' tu'n tjapunju' yol kyej b'entti'j tu'n Dyos tnejel. <verse number="23" style="v" />Aye'tzunkye' txqantl pale, nimxi' matxi' che b'ajten tu'n tpaju' nche kyim; <verse number="24" style="v" />atzunte' Jesus mina' junti' nkyim, lay kyej tq'o'nju' toklen te pale te juntl. <verse number="25" style="v" />Qu'mtzun ati tipumal Jesus tu'n kykletju' xjal tu'n tejumajx, aye' inche pon lq'e tk'etz Dyos noq tu'nel, qu'n itz'te' Jesus tejumajx tu'n tkub'san twitz Dyos kyi'j.</para>
  <para style="p">
    <verse number="26" style="v" />Qu'mtzun ate Jesus kynejel pale atixi'x tajb'en qe. Qu'n ate Jesus xjan te, mixti' til ex mixti'x ttz'ilil tanmi, pa'ntib' kyi'j aj il ex nimxi'x toklen kyetwitz kya'j. <verse number="27" style="v" />Mikxa'ju' kse'nqe' txqantl kynejel pale, inche kub' kyb'yo'n alu'mj te chojb'il atl junjun q'ij, tnejelxi'x te chojb'ilte kyil, yajxi'tzuntl te chojb'ilte kyilju' tnam. Atzunte Jesus noq junx maj oje txi' tq'o'n chojb'il kyil xjal ex tejumajx, qu'n aku'te xitq'o'ntib' tu'n tkyim. <verse number="28" style="v" />Ate intma'n toj tkawb'il Moyses tu'n kyok kynejel pale, aye' mixti'x njapun kyu'n twitz Dyos. Atzunte' tzajni ttziya'n Dyos qe tib'ajxi'ju' tkawb'il Moyses, tma Dyos qa k'okyel tq'o'nju' Tk'wal te kynejel pale, tz'aqli toj tkyaqil tejumajx.</para>
  <chapter number="8" style="c" />
  <para style="s1">A Jesus ul q'inte ak'a'j yol kyej b'entti'j tu'n Dyos quk'i'l</para>
  <para style="p">
    <verse number="1" style="v" />Ate nimxi'x toklenju' toj tkyaqilju' nxiqma'ne' kyeye', aju' tu'n ati jun tnejel qpale nimaqxi'x toklen, xi'q'uqla' ja'lo toj tb'a'nq'ob' Dyos toj kya'j, <verse number="2" style="v" />ex in najb'en toju' ja xjanxi'x, aju' ja xjan axxi'x lu aku' Dyos b'inchante, mya'ye' xjal.</para>
  <para style="p">
    <verse number="3" style="v" />Kykyaqil kynejel pale nxiq'o'n kyoklen tu'n tkub' kyq'o'n oyaj ex chojb'il te Dyos, qu'mtzun ikxte Qajaw Jesukrist ati tu'n tkub' tq'o'n jun oyaj twitz Dyos. <verse number="4" style="v" />Naqwit atite' Qajaw Jesukrist twitz tx'otx', mixti'x petlo sok te pale, qu'n ate'tlkye pale twitz tx'otx' nche kub' q'onte oyaj chqo'nqe' toj tkawb'il Moyses. <verse number="5" style="v" />Tkyaqiltzunte' nkyb'incha'n pale lu twitz tx'otx' toju' kyajb'eb'l te Dyos, noqx jun techlal ex noq jun t-xlekumalju' ati toj kya'j, qu'n tej tb'inchante Moyses ja xjan, tzaj tma'n Dyos te kjalu: B'inkuya b'a'nxi'x ex b'ichanxa kse'nxju' oje txinma'ne' teya twi' witz, chi Dyos te. <verse number="6" style="v" />Atzunte' tnejel qpale, matxi' tk'am jun nimaq toklen te pale tb'anilxi'x, ate ntzaj chik'b'ante yol kyejni b'entti'j tu'n Dyos tb'anilxi'x, tb'anilxi'xju' ntzaj ttziya'n qe kyetwitzju' tnejel.</para>
  <para style="p">
    <verse number="7" style="v" />Naqwit okju' tnejel yol kyejni b'entti'j tu'n Dyos tzinunxi'x ti'j, myawtlo ilti'j tu'n tb'entti'j juntl tkab' yol. <verse number="8" style="v" />Tka'yitzunte Dyos ati kypaltilju' xjal, tmatzuntz kjalu:</para>
  <para style="q">Tzul tq'ijlalil —chi Qajaw—</para>
  <para style="q">kjel b'entti'j jun ak'a'j yol wu'ne' kyuk'i'l aj Israel ex aj Juda.</para>
  <para style="q">
    <verse number="9" style="v" />Mikxa'tl te yol lu kse'n kyej b'entti'j wu'ne' kyuk'i'lju' ojtxi' kyajilb'ene',</para>
  <para style="q">tej chab'axi'x eb'je'tz nxko'ne'</para>
  <para style="q">tu'n kyetz wiq'ine' toju' tx'otx' Ejipt;</para>
  <para style="q">Aye'tzunkye min xjapunju' yol kyu'n,</para>
  <para style="q">qu'mtzun mache kyej nleb'a'ne', —chi Qman Dyos—.</para>
  <para style="q">
    <verse number="10" style="v" />Ate' ak'a'j yol kjel b'entti'j wu'ne' kyuk'i'l aj Israel</para>
  <para style="q">toju' tq'ijlalil tzul,</para>
  <para style="q">aja'lu, —chi Qman Dyos:—</para>
  <para style="q">Kche kb'el nq'o'ne' nkawb'ile' toj kynab'l</para>
  <para style="q">ex che kjel ntz'ib'a'ne' toj kyanmi.</para>
  <para style="q">Ayine' chin nokyel te Kydyos</para>
  <para style="q">aye'tzunkye che okyel te ntaname'.</para>
  <para style="q">
    <verse number="11" style="v" />Min nojqelantl tu'n tq'on xnaq'tzb'il jun te juntel,</para>
  <para style="q">jun kyxjalil mujqa kywitze'l</para>
  <para style="q">tu'n telkynik' wi'je' ayine' Dyos,</para>
  <para style="q">qu'n kykyaqil k'elelkynik' weye',</para>
  <para style="q">k'elelkynik'ju' b'o's exqe' nimaq.</para>
  <para style="q">
    <verse number="12" style="v" />Kb'el najsa'ne' kyb'inchb'aj myab'a'n</para>
  <para style="q">ex lay che tzaj nna'ntle' kyil, chi Dyos.</para>
  <para style="m">
    <verse number="13" style="v" />Tu'ntzunju' nyolin Dyos ti'j juntl ak'a'j yol tu'n tkyej b'entti'j quk'i'l, intchik'b'a'n qa ojtxi'tlju' tnejel yol kyejni b'entti'j, mixti'tl tajb'en ex in nojqelan tu'n tkub' naj.</para>
  <chapter number="9" style="c" />
  <para style="s1">Kab'e' ja xjan: jun twitz tx'otx' ex jun toj kya'j</para>
  <para style="p">
    <verse number="1" style="v" />Toju' tnejel yol kyej b'entti'j tu'n Dyos quk'i'l nk'u'na' kse'n tu'n qk'ulun te Dyos toju' ja xjan te twitz tx'otx'. <verse number="2" style="v" />Ikytten ja xb'alunju' te k'u'lb'il jaw b'incha'n kjalu: Toju' tnejel mqo'n ajqokx ttzija tok tb'i Xjan Mqo'n, ja ta'qe' tkb'el kantil exju' mes ja tkub'a' wab'j xjansa'nqe' twitz Dyos. <verse number="3" style="v" />Atzu'n tkab' mqo'n t-xexi' ti'jxi' xb'alun lik'u'ntz te maqb'il toj nky'ajchaq, tok tb'i Xjanxi'x Mqo'n; <verse number="4" style="v" />atzuntzu' ta'ya' jun q'anpwaq q'olb'eb'l jankub'a' tz'e'yset sturak, ex tkaxilju' yol kyajni b'antti'j tokyile q'anpwaq ti'j. Tojtzu'n kax lu tku'x jun q'anpwaq xar tku'x mana toj, ex toju' kax tku'xa' ttze Aaron ma'toq t-xulin exju' tz'lan ab'j jatz'ib'ana' lajoj chaq'b'il. <verse number="5" style="v" />Tib'ajtzu'n kax lu ate' kab'e' tilb'ilal anj Kerb'in kyb'i yek'b'ilte qa atzu' ta' Dyos, majxtoq ktxu'n tib'aju' kax tu'n kyxik'. Naqtzun aju' lay txinch'ik'b'a'nxi'xe' txqantl ti'xti' lu kyeye' ja'lo.</para>
  <para style="p">
    <verse number="6" style="v" />Iktzunju', kykyaqilju' ti'xti' nk'u'mile kyten toju' ja xb'alun. Inche okxju' pale tkyaqil q'ij toju' tnejel mqo'n tu'n kyb'inchante k'u'lb'il te Dyos. <verse number="7" style="v" />Atzu'n toju' tkab' mqo'n ati t-xexi' o'kxju' kynejel pale in okx toj naq junmaj toj ab'q'i; ajtzun tokx toju' kol ja Xjanxi'x ati tu'n tokx tiq'i'n tchk'el a'lumj te chojb'ilte til ex chojb'ilte kyilju' xjal. <verse number="8" style="v" />Tu'ntzu'n ja'lu intyek'u'n Xewb'aj Xjan qe, qa ljo'nx tajb'enju' tnejel mqo'n te k'u'lb'il mixti' tu'me'l tu'n qokx toju' Xjanxi'x Mqo'n. <verse number="9" style="v" />Tkyaqilte' lu naq jun techlal ti'ju' tq'ijlalil ja'lo; qu'n lay b'ent tu'n tqe kyk'u'ju' xjal naq tu'n inche'x kyq'o'n oyaj ex chojb'il toj ju' ja te k'u'lb'il, tu'nwt tkub'najsa'n kyilju' nche k'ulun toju' tu'me'l lu. <verse number="10" style="v" />Qu'n ate' k'u'lb'il lu xi' nyolina' ti'j chib'j, k'wab'j ex ti'j chukchaq tu'me'l ẍtilsab'lkye, qu'n tkyaqilju' chaq'b'il lu o'kxtzu' najb'ena' te qxmilal ex che tenb'il akxku' npon tq'ijlalil tu'n tch'exb'et tu'n Dyos.</para>
  <para style="p">
    <verse number="11" style="v" />Atzu'n ja'lo matxi' tzul Krist ex matxi' tz'ok te kynejel pale nimaqxi'x toklen ex matxi' tzaj tq'o'n xtalb'il qe. Nimaqxi'x toklenju' ja xjan jannajb'ena' Krist ex tz'aqlixi'x kyetwitzju' tnejel, mya kyb'ichb'aj xjal ex mya te twitz tx'otx'. <verse number="12" style="v" />Mya tchk'el chib' mujqa tchk'el qpoj tman wakx in okxtiq'i'n Qajaw Jesukrist te chojb'il kyil xjal toju' ja xjan, aku'te tchk'el ajb'en tu'n te chojb'il kyil xjal; naq jumaj ex tejumajx sokx toju' ja xjan, majx maqo kolpet tu'n tejumajx. <verse number="13" style="v" />Aye'kye' xjal nche tz'ilix, inche ẍtilset tu'n tchk'el tman wakx ex chib', ex ttza'jil ttxu wakx nkub' tz'e'yset tib'aj q'olb'eb'l, qama witxk'et kyi'j. <verse number="14" style="v" />Qatzun ikju' qa nche ẍtilset xjal tu'n kychk'el alu'mj ¡Yajtzunte' tchk'el Qajaw Jesukrist ma myatzulo nimxi'xte tipumal! Qu'n naq tu'nel Xewb'aj Xjan itz' tejumajx xitq'o'ntib' Qajaw Jesukrist te chojb'il mixti' ttz'ilil te Dyos, matxi' ẍtilset qanmi tu'n te tkyaqilju' qb'inchb'en te kamik, tu'ntzun qajb'en te Dyos itz'.</para>
  <para style="p">
    <verse number="15" style="v" />Qu'mtzun ja'lo naq tu'nel Krist maqo ok toj jun ak'a'j yol kyej b'entti'j tu'n Dyos quk'i'l, qu'n ate Krist xkub'najsante kyilju' xjal kb'incha tjaq'ju' tnejel yol kyejni b'entti'j ojtxi', ex tu'nte kyk'ma'ya' xjal kyetzb'il tejumajx te Dyos, aju' tzajni ttziya'n kyeju' sk'onqe'tl tu'n. <verse number="16" style="v" />Kse'n jun tu'jil etzb'il nkyej q'o'n mixti' tajb'en qa na'mtoq tkyimju' nkyej q'onte. <verse number="17" style="v" />Qu'n mixti'x tajb'enju' tu'jil etzb'il qa itz'xju' xkyej q'onte, qatzun matxitoq kyim atitzun tajb'entz. <verse number="18" style="v" />Qu'mtzun aju' tnejel yol kyej b'entti'j tu'n Dyos kyuk'i'l ojtxi' qyajilb'en, el kychk'el alu'mj tu'n tqexi'x tk'u'jlalilju' yol lu. <verse number="19" style="v" />Qu'n tkyaqilju' chaq'b'il tz'ib'a'n toju' kawb'il xitma'n Moyses kye kykyaqil xjal; tb'ajlenxi'tzun tma'n, tzajtiq'i'n jni' t-smal rit kyeqka'yin ex jun t-ẍk'ilub' tze, ku'xtzun tnub'sa'n toju' kychk'el tal tman wakx ex kychk'el tman chib' smo'n twitz tuk'i'l a', oktzun twitxk'a'n ti'ju' tu'jil kawb'il ex kyi'j kykyaqil xjal. <verse number="20" style="v" />Xitma'ntzun Moysestz kjalu: Aju' chik' lu a tajb'enju' tu'n tkyej qexi'x tk'u'jlajilju' yol xkyej b'entti'j tu'n Dyos kyuk'ile', chij. <verse number="21" style="v" />Ikx oktwitxk'a'n Moyses kychk'el alu'mj ti'ju ja xjan ex kyi'j kykyaqil ti'xti' nche ajb'en toj k'u'lb'il te Dyos. <verse number="22" style="v" />Ex a intma'nju' toj kawb'il, naku'j tkyaqil ti'xti' ati tu'n kyẍtilset tu'n chik'; ex min nkub' najsa'n kyilju' xjal qa min sel tchk'el jun alu'mj.</para>
  <para style="s1">Aju' tkamik Krist nel q'inte tkyaqil il</para>
  <para style="p">
    <verse number="23" style="v" />Qu'mtzun ilxi'xtoq ti'ju' kychk'el alu'mj tu'n tajb'en ẍtilsab'lkye ti'xti' naq tilb'ilalju' ati toj kya'j; aye'tzunkye' ti'xti' toj kya'j a chojb'ilju' nojqelan kye aju' tb'anilxi'x kyetwitz kychk'el alu'mj.</para>
  <para style="p">
    <verse number="24" style="v" />Myatzu' okxa'te Krist toju' ja xjan kyb'inchb'aj xjal, qu'n ate' ja lu, naq jun tilb'ilal ti'ju' ja ati toj kya'j, xi'okxa'te Krist toj kya'j, ja nyolina' qi'j twitz Dyos ja'lo. <verse number="25" style="v" />Ex min okxte Krist b'a'npun maj q'oltib' te chojb'il, kse'n nkyb'incha'n kynejel pale atl junjun ab'q'i nche okx tuk'i'l kychk'el alu'mj, ex myaku' kychk'el kse'nte Krist. <verse number="26" style="v" />Naqwit ikju' atiwtlo tu'n tkyim Krist b'a'npun maj ttzajlenx tb'entlen twitz tx'otx'. Atzunte' ja'lo tej xjapun b'aju' tq'ijlalil, naq jumaj xtyek'utib' Krist ex naq junmaj kyim te chojb'ilte qil. <verse number="27" style="v" />Ikse'nqe xjalqo' naq junmaj qo' kyimel, qkyimlenxi'tzun qo' okyel toj xjel, <verse number="28" style="v" />ikxtzunte Kristju' naq junmaj xtaq'tib' tu'n tkyim te chojb'ilte kyil xjal. Tzultzun jumajtl tkamaji'n, mya'tl tu'n tchjet kyil xjal, qu'n tzul klolkyeju' nche' ayon ti'j.</para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ate' tkawb'il Moyses naqtaq jun t-xlekumalju' ti'xti' tb'anilxi'x atitoq tulel, mya awtju' kawb'il lu tzul q'onte ti'xti' tb'anilxi'x qe. Qu'mtzun layx che okju' xjal tz'aqli twitz Dyos tu'n kawb'il, tu'nju' axchojb'ilju' inkub' kyq'o'n twitz Dyos atl junjun ab'q'i. <verse number="2" style="v" />Naqwit inche ẍtilsetju' xjal te il tu'nju' kawb'il, mixti'wtlo kyil ex mixti'wtlo nxi' kyq'o'ntl chojb'il atl junjun ab'q'i. <verse number="3" style="v" />Aye'tzunkye inx xikyq'o'n chojb'ilte kyil atl junjun ab'q'i, ex atl junjun ab'q'i ntzaj kyna'n kyil. <verse number="4" style="v" />Qu'n layx b'ent tnajsette' kyil xjal kyu'n kychk'el tman wakx ex kychk'el tman chib'. <verse number="5" style="v" />Qu'mtzun tma Krist te Dyos tej tul twitz tx'otx' kjalu:</para>
  <para style="q">Min tajb'ilta chojb'il ex oyaj twitza,</para>
  <para style="q">qu'n matxi' tzaj tq'o'na nxmilale'.</para>
  <para style="q">
    <verse number="6" style="v" />Myab'a'n inche ela' chojb'il k'ok'sb'il exqe' oyaj tu'n tnajsetju' kyil xjal toj twitza.</para>
  <para style="q">
    <verse number="7" style="v" />Qu'mtzun xinma'ne' kjalu: Luqine' lu, tu'n nb'inchanteye' tajb'ila,</para>
  <para style="q">kse'nxju' tz'ib'a'n wi'je' toju' Tu'jil tyola, nman Dyos, nchije', chij.</para>
  <para style="m">
    <verse number="8" style="v" />Tnejelxi'x intma'n qa min tajb'il Dyos chojb'il mujqa alu'mj te oyaj, ex min tajb'ilju' chojb'il k'ok'sb'il te najsb'il kyil xjal, maskye iky intma'nju' toj kawb'il. <verse number="9" style="v" />Ex intma'ntl: Luqine' lu, Dyos, machin nule' tu'n nb'inchanteye' tajb'ila, chij. Atzun ja'lu a ntma'nju' qa mixti'tl kyajb'enju' ojtxi' chojb'il ex a Krist sok tq'o'n Dyos te jun ak'a'j chojb'il. <verse number="10" style="v" />Ma'tzun qo jaw t-sk'o'n Dyos tu'nju' japun tajb'il tu'n Qajaw Jesukrist tej txitq'o'n t-xmilal te chojb'il jumajx ex te kukxju'.</para>
  <para style="p">
    <verse number="11" style="v" />Kkyaqilju' pale aj Juda nche okx toj tja Dyos tkyaqil q'ij ex aye'x chojb'ilju' nche kub' kyq'o'n, maskyetzun mixti'x in najset kyil xjal kyu'n. <verse number="12" style="v" />Atzunte Jesukrist naq junxju' chojb'il xtaq' twitz Dyos tu'n tnajset kyil xjal tejumajx, ex matxi' kub' qe toj tb'a'nq'ob' Dyos. <verse number="13" style="v" />Axtzuntzu' k'ayola' tzmax ajkykub' tq'o'n Dyos tajq'oj tjaq' tqan, <verse number="14" style="v" />qu'n naq tu'n junmaj kyim Krist, che okyela' xjal tzinunxi'x tejumajx tu'n Dyos tu'n kyajb'en o'kxtzu' te. <verse number="15" style="v" />Qu'n iku' ntma'n Xewb'aj Xjan qe tej tmante kjalu:</para>
  <para style="q">
    <verse number="16" style="v" />Aju' yol kjel b'entti'j wu'ne' kyuk'i'l</para>
  <para style="q">ajtpon kanun tq'ijlalil,</para>
  <para style="q">aja'lu, chi Qajaw:</para>
  <para style="q">Che kb'el nq'o'ne' nkawb'ile' toj kyanmi</para>
  <para style="q">ex che kb'el ntz'ib'a'ne' toj kynab'l.</para>
  <para style="q">
    <verse number="17" style="v" />Ex lay tzajnna'n jumajtle' kyil ex kyb'inchb'aj myab'a'n, chi Xewb'aj Xjan.</para>
  <para style="m">
    <verse number="18" style="v" />Ikytzu'n, qa matxi' che kub'najsa'nju' il, min nojqelan tu'n tkub'tl chojb'il te najsb'il il.</para>
  <para style="s1">Qq'onk tilil tu'n qpon lq'e tk'etz Dyos</para>
  <para style="p">
    <verse number="19" style="v" />Qu'mtzun e'ntzik ex e'witz'in, matxi' tzaj q'o'n anb'il qe tu'n qokx toju' najb'il Xjanxi'x, naq tu'nel tchk'el Jesukrist, <verse number="20" style="v" />qa lepchiqo' ti'ju' ak'a'j b'e te chwinqlal xtjaq Jesukrist qe ti'ju' xb'alun lik'u'n te maqb'il toju' ja te k'u'lb'il, xi' nyolina' xb'alun lu ti'jku' t-xmilal Jesukrist. <verse number="21" style="v" />Ja'lo ati jun qpale nimxi'x toklen toju' ja xjan toj kya'j. <verse number="22" style="v" />Qu'mtzun qoqe' lq'ex tk'etz Qman Dyos tu'n tkyaqil qanmi axxi'x ex tuk'i'l qokslab'l axxi'x, ẍtiluntl qanmi te il ex txjo'ntl qxmilal tuk'i'l a' ẍnu'l teju' il. <verse number="23" style="v" />Qek qk'u'j b'a'nxi'x ti'j Dyos ex lalun jawje qk'u'j toj qokslab'l, qu'n kjapumelte' Dyos tyol tu'n oje tzaj ttziya'n qe. <verse number="24" style="v" />Qjyom tu'me'l tu'n qoninte qib' qxolilex, tu'n tten qk'u'jlalil ex tu'n qb'inchanteju' b'a'n. <verse number="25" style="v" />Lalun kyej qtzaqpi'n tu'n qb'uyinteqib', kse'n nkyb'incha'n junjun, ape' qb'inchamju' qq'uqb'am qk'u'j jun te juntel; ex qq'onk tilil tu'nju' in qka'yi'n matxi' tzaj lq'e tq'ijlalil tulel Qajaw Jesukrist.</para>
  <para style="p">
    <verse number="26" style="v" />Qu'n qa inx qo b'inchan il extzun matxi' tz'el qnik' ti'ju' yol axxi'x, mixti' juntl chojb'ilte qil; <verse number="27" style="v" />noq o'kxtl in qayo'nju' xob'ajilxi'x ajqok toj xjel te b'ajsb'il, ajkyb'aju' ajq'oj ti'j Dyos toj q'aq'. <verse number="28" style="v" />Qa ati jun xjal inel txalpuj toj tkawb'il Moyses, extzunqa ati kab'e' mujqa oxe' tziyal ti'j qa axx min nxitnima'n, mixti'x ntzaj laqj tk'u'jlalil ex majx nkub' b'yo'n. <verse number="29" style="v" />¿Yajtzu'n ja'lo, ma myatzulo nimxi'x tz'e'ysb'il witzb'aj tzul tib'aju' xjal nkub' wab'inte Tk'wal Dyos ex neltik'u'nju' tchk'el, ex inel kysuchu'n T-xew Dyos nk'u'jlankye xjal? Qu'n aju' tchk'el Qajaw kuwsalteju' yol kyejni b'entti'j tu'n Dyos quk'i'l ex tu'n tchk'el Krist xtxjeta' kyanmi xjal toj il. <verse number="30" style="v" />B'i'nqe' qu'n aju' tma Qajaw kjalu: Ayinwe' chin q'olte tu'me'l t-xel kyeju' xjal nche b'inchan taq'wix ex ayine' chin q'olte tz'e'ysb'il kywitz, chij. Ex tmatl kjalu: Aku'te Qajaw k'okyel q'onte ttanam toj xjel, chij. <verse number="31" style="v" />¡Xob'ajilxi'xte' qama qokub' tz'aq toj tq'ob'ju' Dyos itz'! <verse number="32" style="v" />Kyna'ntze' b'aj kyi'je' ojtxi' tej tzqekutoq kyk'monteju'ye' spik'un, tej tik'xkyu'ne' toju' yajb'il kuwxi'x kyu'n xjal. <verse number="33" style="v" />Ate' junjunkye' eb'jo'k yasu'n ex eb'jo'k ili'n kyu'n xjal kywitz kykyaqil xjal, aye'tzun junjuntlkye' tzaj b'is toj kyanmiye' tu'nju' nche yajtiju' kyuk'ile' toj kytzi xjal. <verse number="34" style="v" />Tzaj q'aq'an kyk'u'je' kyi'ju' ate'kxtoq toj kars, expe' e'tzalaje' tu'nju' b'je'l q'i'nju' ati kyeye', qu'n b'i'ntl kyu'ne' qa ati junkye' kyetzb'ile' toj kya'j tb'anilxi'x ex lay b'aj. <verse number="35" style="v" />Qu'mtzun qek kyk'u'je' ti'j Dyos, qu'n ktzajel tq'o'n Dyos jun chojb'il nimxi'x kyeye' qa q'uqlok kyk'u'je' kukxju' ti'j. <verse number="36" style="v" />In nojqelan tu'n tten kyipumale' toj ju' yajb'il, tu'ntzun kyb'inchanteye' tajb'il Dyos ex tu'n kyk'monteye' oje tzaj ttziya'n Dyos kyeye'. <verse number="37" style="v" />Qu'n intma'n toj Tu'jil tyol Dyos kjalu:</para>
  <para style="q">Ch'inxtl, naqch'inxtl</para>
  <para style="q">tulju' ati tulel.</para>
  <para style="q">Lu xi' tulkanun.</para>
  <para style="q">
    <verse number="38" style="v" />Aju' xjal tnik'alti'j naq tu'n tokslab'l k'anq'ila';</para>
  <para style="q">qatzun ma tz'anjti'j ti'jxi',</para>
  <para style="q">lay chin tzalaje' ti'j, chiju' tz'ib'a'n.</para>
  <para style="m">
    <verse number="39" style="v" />Ayo'tzunqe mya ikqo'ju' kse'nqe' nanjkyi'j kyi'jxi' ex nche'x toj naje'n, xi'toqo'qe kyuk'ilju' nkub'ti'j kolb'il kyu'n, qu'n ati kyokslab'l.</para>
  <chapter number="11" style="c" />
  <para style="s1">Aju' kyokslab'l ojtxi' xjal</para>
  <para style="p">
    <verse number="1" style="v" />Qa ati qokslab'l q'uqlixi'x qk'u'j tu'n qk'monteju' in qo ayon te; ex q'uqlok qk'u'j kyi'ju' ti'xti' na'mx tok qka'yi'n. <verse number="2" style="v" />E'k'metkye' ojtxi' qyajilb'en tu'n Dyos qu'n atitoq kyokslab'l.</para>
  <para style="p">
    <verse number="3" style="v" />Tu'n qokslab'l inela' qnik' ti'j qa tu'n tyol Dyos b'enta' twitz tx'otx', qu'mtzun aju' q'ancha'l ja'lo kub' b'incha'n kyi'j ti'xti' min q'ancha'lqe'.</para>
  <para style="p">
    <verse number="4" style="v" />Tu'n tokslab'l Ab'el xaya' tq'o'n jun oyaj tb'anilxi'xte Dyos kyetwitz Kayin. Qu'mtzun okq'o'n Ab'el tnik'alti'j tu'n Dyos ex tk'amju' toyaj. Maskyetzun oje kyimte Ab'el, inx yolin qe tu'nju' ten tokslab'l.</para>
  <para style="p">
    <verse number="5" style="v" />Tu'n tokslab'l Enok xiq'i'n tu'n Dyos itz' ex min kyim, ex min okyalju' t-xmilal, qu'n aku' Dyos xiq'inte. Ex intma'n toj Tu'jil tyol Dyos, qa intoq tzalaj Dyos ti'j Enok tej na'mxtoq txiq'i'n. <verse number="6" style="v" />Lay tzalajte Dyos qi'j qa min nqoksla'n, qu'n kb'antel qok lq'e tk'etz Dyos qa in qoksla'n qa ati Dyos exqa intzaj tq'o'n tu'me'l t-xel b'a'n kyeju' nche' jyon ti'j.</para>
  <para style="p">
    <verse number="7" style="v" />Tu'n tokslab'l Noe tzaj tma'n Dyos te ti'ju' na'mxtoq tyek'u'njtz, xitb'i'n Noe tyol Dyos ex jawtb'incha'n jun b'ark tu'n kyklet kyuk'i'lju' toj tja. Ex tu'nxju' tokslab'l Noe kub' tz'e'ysa'n kywitz xjal twitz tx'otx', atzunte okq'o'n tnik'alti'j tu'n Dyos.</para>
  <para style="p">
    <verse number="8" style="v" />Tu'n tokslab'l Ab'raam xitnima'n txokb'ilte tu'n Dyos tu'n tetz toj ttanam, ex tu'n tpon toju' tx'otx' atitoq tu'n tk'monte te tetzb'il. Etztzuntz toju' ttx'otx' ex min b'i'n tu'n jatoq kpomela', <verse number="9" style="v" />ex tu'nju' atitoq tokslab'l ti'j Dyos, anq'in kse'n najchaq xjal toju' tx'otx' xittziya'n Dyos te. Najan Ab'raam kyoj pach, ikxte Isaak ex Jakob' xitziya'n tx'otx' lu kye. <verse number="10" style="v" />Qu'n intoq ayon Ab'raam ti'ju' nintnam b'incha'n tq'uqlil b'a'nxi'x, ju' aku' Dyos kub' ximante ex kub' b'inchante.</para>
  <para style="p">
    <verse number="11" style="v" />Ex ikx tu'n tokslab'l Ab'raam, tk'am tipumal tu'n titz'ji jun tk'wal, maskye matxitoq tijin ex mixti' nnalin Sara ju' t-xu'jil, qu'n xitoksla'n qa kjapumelju' tzaj ttziya'n Dyos te. <verse number="12" style="v" />Qu'mtzun maskye matxitoq tijin Ab'raam, eb'je'l anq'in txqan xjal ti'j kse'n kyajlal che'w twitz kya'j ex kse'n tajlal tz'awun ttzi ninnjab', lay b'ent kyajlet.</para>
  <para style="p">
    <verse number="13" style="v" />Kykyaqilju' xjal lu eb'aj kyim, ex min kyk'amju' ojetoq tzaj ttziya'n Dyos kye; tu'ntzunju' ati kyokslab'l xikyka'yi'n najchaq ex ojexi'x che tzalaj ti'j, atzuntzu' kymaya' qa najchaq xjalqe' ex naq ajb'etunqe' twitz tx'otx'. <verse number="14" style="v" />Aye'tzu'n inche q'mante ikju', inkychik'b'a'n qa nche jyon ti'j jun kytanam. <verse number="15" style="v" />Noqwit inche ximan ti'ju' tx'otx' jaeb'jetza', anjwitlokyi'j toju' kytanam; <verse number="16" style="v" />aye'tzunkye intoq che jyon ti'j jun tnam tb'anilxi'x ati toj kya'j. Qu'mtzun min nch'ixwite Dyos tu'n tok te Kydyos, qu'n ati jun nintnam b'entni tu'n te kytanam.</para>
  <para style="p">
    <verse number="17" style="v" />Iky' twitzlalil tokslab'l Ab'raam tu'n Dyos, ku chij, xitq'o'n Isaak te chojb'il. Xitq'o'nte Ab'raamju' tk'wal te chojb'il maskye naq jun twitz, ex maskye ojetoq txi' ttziya'n Dyos te kjalu: <verse number="18" style="v" />Che chmetel tyajajila tu'nel Isaak, chij. <verse number="19" style="v" />Qu'n q'uqlixi'x tk'u'j Ab'raam qa atite Dyos tipumal tu'n kyjaw anq'in xjal tu'n kyxol kyimni; qu'mtzun tk'am jumajtl Ab'raam tk'wal naku'j ojetoq jaw anq'in kyxol kyimni.</para>
  <para style="p">
    <verse number="20" style="v" />Tu'n tokslab'l Isaak e'kub' tk'iwla'n Jakob' ex Esawu.</para>
  <para style="p">
    <verse number="21" style="v" />Tu'n tokslab'l Jakob', tej ch'inxtltoq tkyim, e'kub' tk'iwla'n tk'wal Jse, ex kub'ten k'ulul twitz Dyos qejlkub' tib'aju' tal tb'aston.</para>
  <para style="p">
    <verse number="22" style="v" />Tu'n tokslab'l Jse kyejtma'n kye aj Israel tej tkyim, qa yajxi'tel che b'je'letz toju' tx'otx' Ejipt, ex kyejtma'n kye titi' kkyb'incha' ti'ju' tb'aqil ajkyetz toju' tx'otx' Ejipt.</para>
  <para style="p">
    <verse number="23" style="v" />Tu'n kyokslab'l tman Moyses b'enta' tewit oxe' xjaw kyu'n tej titz'ji; qu'n okna' kyka'yi'n qa tb'anilxi'xtoqju' tal ne'ẍ, ex min e'xob' teju' tchaq'b'il nimaqkawil toj Ejipt tej tmante tu'n kykub' b'yetju' tal q'a.</para>
  <para style="p">
    <verse number="24" style="v" />Tu'n tokslab'l Moyses tej ichantltoq, min taj tu'n tok te talju' tmyal Paraon; <verse number="25" style="v" />a jaw t-sk'o'nju' tu'n tb'aj yajla'n junx kyuk'i'l ttanam Dyos, qu'n min taj tu'n ttzalaj kyi'ju' achb'il intq'o'n il naq te jte' q'ij. <verse number="26" style="v" />Kub' t-xima'n Moyses tu'n tik'xju' yajb'il tu'n kse'n kyajtela'toq Krist, jun q'inumal nimxi'x toklen toj twitz kyetwitzju' kyq'inumal aj Ejipt; qu'n xi'toka'te Moyses twitz ti'ju' tu'me'l t-xel tb'anilxi'x ktzajel tq'o'n Dyos.</para>
  <para style="p">
    <verse number="27" style="v" />Tu'n tokslab'l Moyses etz toju' tx'otx' Ejipt, ex min xob' teju' ttx'u'jil nimaqkawil; kub' twab'a'ntib' b'a'nxi'x naku'j in ka'yink teju' Dyos min q'ancha'l. <verse number="28" style="v" />Tu'n tokslab'l Moyses kub' tik'sa'n tq'ij Tzaqpib'l ex tchaq' kye aj Israel tu'n tok kywitxk'a'n tchk'el jun tal rit ttzi kyja, tu'ntzun lalun che kyimju' tnejel kyk'wal tu'n anjl matxitoq txi' q'o'n toklen tu'n tik' b'yolkyeju' tnejel k'wal.</para>
  <para style="p">
    <verse number="29" style="v" />Tu'n kyokslab'l aj Israel eb'jik'tza' toju' Kyeq Ninnjab' naku'j nche b'et tib'aj tzqij tx'otx'; tetzunj kyik'tz lpe aj Ejipt kyi'j, lwiyxi'x e'kyaj jaq'wi toj a'.</para>
  <para style="p">
    <verse number="30" style="v" />Tu'n kyokslab'l aj Israel b'ajkub' tz'aqju' nintapi ti'jile nintnam Jeriko, kyb'ajlenxi' b'et wuq q'ij ti'jile. <verse number="31" style="v" />Ex tu'n tokslab'l Raab' aju' qya ajpajil, min kyima' kyuk'ilju' xjal min nche niman te Dyos, qu'n e'tk'amju' kab'e' aj Israel e'pon ka'yil toj ewaj chq'o'nqe'toq kyu'n aj Israel.</para>
  <para style="p">
    <verse number="32" style="v" />¿Titi'tl kxe'l nma'ne' kyeye'? Lay kanun anb'il tu'n tb'aj ntx'olb'a'ne' kyeye' ti'j Kedeon, ti'j B'arak, ti'j Sanson, ti'j Jepte, ti'j Dab'i, ti'j Samwel ex kyi'j txqantl t-sanjelal Dyos. <verse number="33" style="v" />Tu'n kyokslab'l aj Israel ti'j Dyos, kub'kyi'j txqantl nimaqtnam kyu'n; ex tu'nju' e'kawin tojxi'x tnik'alti'j, kyk'amju' tzaj ttziya'n Dyos kye, expe' jpet kytzi b'alun kyu'n, <verse number="34" style="v" />e'kyupiju' q'aq' inxi'xtoq che k'ant, e'tzaqpaj te kamik tu'n k'uẍtx'e'nb'il, kyk'am kyipumal tej numjniqe'toq ex eb'jo'k kuw toj q'oj ex kub'kyi'ju' kyajq'oj kyu'n. <verse number="35" style="v" />Ate'qe' qya kyk'am jumajtlu' kychmil mujqa kyal qu'n eb'jaw anq'in.</para>
  <para style="p">Aye'tzun junjuntel eb'ajkub' b'yo'n ex min kyaj tu'n kxitzaqpi'n, qu'n atoq kyajb'ilu' tu'n kyk'monte jun anq'ib'l tb'anilxi'x. <verse number="36" style="v" />Aye'tzun txqantl eb'aj xmayi'n ex eb'aj jiku'n toj asyal, ex eb'ajkub' k'lo'n toj xpatx'k'uxb'il ex eb'jo'kx jpu'n toj kars. <verse number="37" style="v" />Ate' junjuntl eb'aj kub' b'yo'n eb'aj xon toj ab'j, eb'je'x jon tu'n job'l tze mujqa e'kub' b'yo'n tu'n k'uẍtx'e'nb'il. Aye'tzun junjuntl noq nche b'etje, oksa'nk ttz'umal rit kyu'n mujqa ttz'umal chib', prowqe'xi'x, intoq che b'isun ex inxi'x che yajlanjtz. <verse number="38" style="v" />Mixti' tu'me'l tu'n kytenju' wnaq lu kyxolju' xjal aj il twitz tx'otx', naqx eb'etje toj chq'ajlaj, kyoj k'ul, kyoj jul ex kyoj pik.</para>
  <para style="p">
    <verse number="39" style="v" />Mixtzunti' kyk'amju' tzaj ttziya'n Dyos kye, extzun eb'jo'k tnik'alkyi'j ex ten kyokslab'l ti'j Dyos; <verse number="40" style="v" />qu'n atitoq jun t-xim Dyos tb'anilxi'x qe, tu'ntzun kyok tz'aqlixi'x junx quk'i'l tu'n Dyos.</para>
  <chapter number="12" style="c" />
  <para style="s1">Xi'tenka' qwitz ti'j Krist</para>
  <para style="p">
    <verse number="1" style="v" />Ikytzu'n, txoli'nk qi'j kyu'n wnaq lu oje kyyek'u kyokslab'l ti'j Dyos, che qq'onkju' ti'xti' nche mqonqe, exju' il in qo kub' tzpet tu'n, qq'onk tilil tu'n qojqelan ex tu'n tten qipumal toju' qb'e ljo'n. <verse number="2" style="v" />Xi'tenka' qwitz ti'j Jesus, qu'n ti'j te ntzaj anq'ina' qokslab'l ex tu'nte ntenxi'x qokslab'l. Ik'xtu'n Jesus twitz krus ex min okten twitz ti'ju' tkamik ch'ixb'ajilx, qu'n b'i'ntoq tu'n qa tb'ajlenxi'ju' yajte'n ktzajel q'o'n tzalajb'il te, atzu'n ja'lo q'uqli toj tb'a'nq'ob' Dyos.</para>
  <para style="p">
    <verse number="3" style="v" />Qu'mtzun che ximanqeye' ti'ju' yek'b'il tu'n Jesus, ik'xtu'n tej ojexi'x yajti kyu'n xjal aj il; qu'mtzun lalun che kub' siktiye' ex lalun che kub' numje'. <verse number="4" style="v" />Qu'n na'mx tokxi'x tilil kyu'ne' tu'n kyq'ojine' tuk'i'l il, ex na'mx tik'xkyu'ne' kse'nte Krist, <verse number="5" style="v" />expe' matxi' tzik'tna'l kyu'ne' aju' kynab'le' ntzaj tma'n Dyos tu'nju' ẍe'okye' te tk'wal. Qu'n intma'n toj Tu'jil tyol Dyos kjalu:</para>
  <para style="q">Nk'wal, lalun tz'el tik'u'na</para>
  <para style="q">kawb'ilteya tu'n Qajaw,</para>
  <para style="q">lalunpe' kub' numja qama tzak'unjtza tu'n.</para>
  <para style="q">
    <verse number="6" style="v" />Inche ttzak'u'nte Dyosju' nche tk'u'jla'n,</para>
  <para style="q">ex inttz'e'ysa'n kywitzju' nche tk'mo'n te tk'wal, chiju' tz'ib'a'n.</para>
  <para style="m">
    <verse number="7" style="v" />Tzik'xku' kyu'ne' qa nche' kawinjtze' tu'n Dyos, qu'n inche oktq'o'ne' te tk'wal. ¿Ma atitzulo jun k'walb'aj min ntzak'unjtz tu'n tman? <verse number="8" style="v" />Qatzun min nche tzak'unjtze' tu'n Dyos, kse'n ntb'incha'n kye kykyaqilju' tk'wal, mya'tzun tk'wal Dyos qexi'xtze'. <verse number="9" style="v" />Expe' tej k'walqotoq, maqotzaj tzak'u'n kyu'n qman twitz tx'otx' ex intoq qo' niman kye. ¿Yajtzu'n ja'lo ma laytzun qo niman te Dyos Manb'aj ati toj kya'j, tu'n ttzaj tq'o'n qchwinqlal tejumajx? <verse number="10" style="v" />In qo kytzak'u'nkye' qman te twitz tx'otx' toju' jte' q'ij qchwinqlal tzalu twitz tx'otx', kse'nxju' b'a'n toj kywitz; atzunte Dyos in qotzaj ttzak'u'n te jun b'a'n qe, tu'n qok te xjan kse'nte. <verse number="11" style="v" />Axxi'x tkyaqilte' tz'e'ysb'il qwitz myab'a'n inela' qe toju' kmuj ajqtzak'unjtz, qu'n ina' ch'yon; qatzun tokel qnab'lju' tz'e'ysb'il qwitz, qo tenb'iltzuntz toj nak'b'il ex tojxi'x tnik'alti'j.</para>
  <para style="s1">Xob'ajilx qama tz'el qik'o'n tyol Dyos</para>
  <para style="p">
    <verse number="12" style="v" />Qu'mtzun, tenx kyipumalju' kyq'ob'e' matx che sit exqe' kych'ekye' matxi' che kub'numj, <verse number="13" style="v" />ex kjyome' b'e tzinun, tu'ntzun tb'anix kyqane' kox ex tu'n lalun kub' koxix jumajtl.</para>
  <para style="p">
    <verse number="14" style="v" />Kyq'onk tilile' tu'n kytene' toj nak'b'il kyuk'i'l kykyaqil xjal ex kyxjansam kyib'e'; qu'n aye' mya xjansa'nkyib' layx tz'ok kyka'yin Qajaw. <verse number="15" style="v" />Kyka'yinx kyib'e' tu'ntzun mix-a'lo' junkye' kjelten miwtjun tk'maju' xtalb'il intzaj tq'o'n Dyos, ex tu'n mix-a'lo'wt junkye' tz'ok kse'n junwi' tze k'a tlok' tu'n tb'iyun kye xjal. <verse number="16" style="v" />Mix-a'lowt junkye' tz'ok ajpajil ex lalunwt tz'el kyik'u'ne' Dyos tu'n tpaj te twitz tx'otx'; kse'n tb'incha Esawu, xitk'a'yi'n toklen te tnejel k'walb'aj naq tu'n tpaj ch'i'n tich. <verse number="17" style="v" />Yajxi'tzuntel tej tjapun tq'ijlalil tu'n tk'iwlanjtz tu'n tman, el ik'u'n ex min tk'amtlju' k'iwb'il; maskyepe' oq' b'a'nxi'x, mixti'x b'ent tch'exb'etlju' ojetoq b'entti'j tu'n.</para>
  <para style="p">
    <verse number="18" style="v" />Min ẍepon lq'ekye' t-xe witz Sinayi, kse'nkye aj Israel, intoq b'ent tka'yit ex tmkyet, intoq k'ant q'aq' ti'jile, qlolj ti'jile ex atitoq q'ankyaq ti'jile; <verse number="19" style="v" />ex min kyb'iye' tq'ojq'ojel chun ex tq'ojq'ojel twi' Dyos. Qu'n aye' eb'inte tq'ojq'ojel twi' Dyos, ekub'san twitz Dyos tu'n lalun yolintl kye, <verse number="20" style="v" />qu'n exob' teju' chaq'b'il tzaj tma'n Dyos kjalu: Alkyete makub' tq'o'n tqan tib'aju' k'ul lu, kb'ajel xoyit toj ab'j mujqa toj ch'ut, maskyepe' jun txkup. <verse number="21" style="v" />Tkyaqilju' intoq nok kyka'yi'n majxtoq xob'ajilx, ex aku'pe' Moyses q'mante: Inxi'x chin lu'lune' tu'n nxob'ele', chij.</para>
  <para style="p">
    <verse number="22" style="v" />Aye'tzunkye' ja'lo xi' ẍe ulaye' t-xe witz Syon ex toju' ninttanam Dyos itz', aju' Jerusalen ati toj kya'j, ex mache ule' tu'n kytene' junx kyuk'i'lju' txqan anjl b'u'yi'n kyib' tu'n kyajwalin tb'i Dyos, <verse number="23" style="v" />kxolju' tnejel tk'wal Dyos tz'ib'a'n kyb'i toj kya'j. Matxi' che ul lq'eye' tk'etz Dyos, aju' che okyel xjal te tkyaqil twitz tx'otx' toj xjel tu'n, ex mache' ul lq'eye' kyk'etzju' xjal oje che ok tnik'alkyi'j tu'n Dyos, <verse number="24" style="v" />Mache ule' tk'etz Jesus, aju' sul q'inte ak'a'j yol kyej b'entti'j tu'n Dyos quk'i'l, ex mache' ul lq'eye' tk'etz Dyos tu'nju' tchk'el Jesus el chitj ẍtilsab'lqe, qu'n b'a'nxi'xju' chik' lu kyetwitz tchk'el Ab'el.</para>
  <para style="p">
    <verse number="25" style="v" />Qu'mtzun kyka'yinxe' b'a'nxi'x tu'n lalun tz'el kyik'o'ne' Dyos ajtyolin quk'i'l. Qu'n qa min e'kletju' xjal e'el ik'onte Dyos tej tyolin kyuk'i'l tza'lu twitz tx'otx'; mitzunloyaqe lay qoklet qama tz'el qik'o'n Dyos ja'lo, aju' ntzaj yolin qe tzmax toj kya'j. <verse number="26" style="v" />Tej tyolin Dyos ojtxi' kye aj Israel majx yukchi tx'otx' tu'n tq'ojq'ojel twi', atzu'n ja'lo intma'n kjalu: Mya o'kxju' tx'otx' klu'lul jumajtl wu'ne', expe' klu'lulju' kya'j, chij. <verse number="27" style="v" />Atzunju' intma'n: Klu'lul jumajtl, chij, atz'elpuna'ju' qa tkyaqilju' b'incha'nqe' tu'n Dyos, aye' nche' yukch, kche b'ajel tu'ntzun kykyejten oqe'kxju' mixti' tu'me'l tu'n kyukchi. <verse number="28" style="v" />Qq'onx chjonte te Dyos tu'nju' ma qk'amu' tkawb'il mixti' tu'me'l tu'n tyukchi, ex qo ajb'en te Dyos, tu'ntzun ttzalaj qi'j, ex tenx tchiylal qe, ex qo niman te. <verse number="29" style="v" />Qu'n ikyte Qdyos kse'n jun q'aq' nb'aj tz'e'y tkyaqil tu'n.</para>
  <chapter number="13" style="c" />
  <para style="s1">Se'n tu'n ttzalaja' Dyos qi'j</para>
  <para style="p">
    <verse number="1" style="v" />Kyk'u'jlam kyib'e' kukxju' kyxolilexe', qu'n kyitz'imile kyib'e'. <verse number="2" style="v" />Ex lalun tzik'tna'l kyu'ne' tu'n kyoke b'a'n xjal kyeju' nche pon kyjaye', ate junjun mixti' kynab'en ti'j, qa ekyejten anjl wtal kya.</para>
  <para style="p">
    <verse number="3" style="v" />Q'aq'anx kyk'u'je' kyi'ju' jpu'nqe', nakuxwitloj aye'x junkye' jpu'nqeye' kyuk'i'l, ex q'aq'anx kyk'u'je' kyi'ju' nche yajlanjtz, ku'xwitloj aye'x junkye' ate' toj yajtib'il.</para>
  <para style="p">
    <verse number="4" style="v" />Kyq'onke' toklen mjeb'le'n kykyaqile' ex che tenkuye' b'a'n toju' kymjeb'le'ne'; qu'n kche okyelju' ajpajil toj xjel tu'n Dyos, ex ikqe'kxju' pa'l mjeb'le'n.</para>
  <para style="p">
    <verse number="5" style="v" />Lalun che jamjone' ti'j pwaq; che tzalajxe' ti'ju' ati kyeye', qu'n oje tma Dyos kjalu: Layx kyej ntzaqpi'na ex lay kyej nq'o'na tjunila, chij. <verse number="6" style="v" />Qu'mtzun b'a'n tu'n qmante ja'lu tu'n tkyaqil qk'u'j:</para>
  <para style="q">Ate Qman Dyos onilweye'; mixti' tu'n nxob'e'.</para>
  <para style="q">¿Tixixti' kb'antel tb'incha jun xjal wi'je'?</para>
  <para style="p">
    <verse number="7" style="v" />Kyna'ntze' alkyeqe' nejenel e'ten kyxole' ex alkyeqe' e'xnaq'tzante tyol Dyos kyeye'; che ximane' ti'ju' kyaq'unb'en ex kse'n xjapuna' b'aju' kychwinqlal, ex tenx kyokslab'le' kse'nkye.</para>
  <para style="p">
    <verse number="8" style="v" />Axte Qajaw Jesukrist te' ewi, ja'lo ex tejumajx. <verse number="9" style="v" />Lalun txikyq'o'n kyib'e' toj chukchaq xnaq'tzb'il junxi'tl mujqa taq'wix. Ate' b'a'nju' tu'n tkuwix qanmi tu'n t-xtalb'il Qman Dyos, kyetwitz tu'n kyxi' lpeye' kyi'ju' kawb'il kyib'aj chukchaq t-xilel wab'j tu'n txi' qwan; qu'n mixti'xkye' lu kyajb'en kye xjal.</para>
  <para style="p">
    <verse number="10" style="v" />Ati junqe qq'olb'eb'l, aju' lay b'ent kywan ti'j, aye' inx che ajb'en toju' ojtxi' ja xjan. <verse number="11" style="v" />Qu'n ate' kynejel pale ojtxi' in okx kyi'nju' kychk'el alu'mj toju' xjan ja, te chojb'il kyil xjal, aye'tzu'n kyxmilal alu'mj lu nche kub' pati'n ti'jxi'ju' kyxmuj. <verse number="12" style="v" />Qu'mtzun ikxte Jesus axtzu' kyima' ti'jxiju' tnam, tu'n kypon lq'e xjal tk'etz Dyos tu'nelju' tchk'el. <verse number="13" style="v" />Ikxtzunqeju' qoqe' ex ti'jxi' tnam tuk'i'l Jesus, ex tzik'xku' qu'n tkyaqilju' sik'xtu'n Jesus. <verse number="14" style="v" />Qu'n mixti' junqe qtanam tejumajx tzalu twitz tx'otx', tzma in qo jyon ti'j qtanam tzul yek'u'n. <verse number="15" style="v" />Qu'mtzun qajwalinktz tb'i Qman Dyos kukxju' tu'nel Qajaw Jesukrist. Qu'n qa nqo ajwalin tb'i Qman Dyos, inxi' qq'o'n jun oyaj te tu'n qtzi. ¡Qajwalinktz tb'i Qman Dyos! <verse number="16" style="v" />Lalun tzik'tna'l kyu'ne' tu'n kyb'inchanteye' b'a'n ex tu'n kyoninte kyi'j junjuntl; qu'n atzunte oyaju' intzalaj Dyos ti'j.</para>
  <para style="p">
    <verse number="17" style="v" />Kynimanqexe' kynejele' ex kyb'inxe' kykawb'il, qu'n aye' nche xq'uqinju' kyi'je', ex ojtzqi'n kyu'n qa che okyele' toj xjel tu'n Qman Dyos. Qu'mtzun che b'inqeye' kye tu'ntzun tb'entju' kyaq'un toj tzalajb'il ex mya toj b'is, qatzun min, lay kykanb'aye' jun b'a'n.</para>
  <para style="p">
    <verse number="18" style="v" />Che' na'nqe' Dyose' qi'je', qu'n q'uqli qk'u'je' qa b'a'nju' nqb'incha'ne', qu'n qajb'ile' tu'n qb'inchanteye' b'a'n toj tkyaqil. <verse number="19" style="v" />Ex inxi'x xinqanine' kyeye' tu'n kyna'n Dyose' wi'je', tu'n tq'onte anb'il tu'n npon jumajtle' lwiy kk'etze'.</para>
  <para style="s1">Qaninjtz k'iwb'il kyi'j okslal</para>
  <para style="p">
    <verse number="20" style="v" />Aju' Dyos ntzaj q'onte nak'b'il, jaw anq'in Qajaw Jesukrist tu'n kyxol kyimni, aju' nimaq k'ik'lel kyi'j rit, ex tu'nju' tchk'el xkyaja' qexi'x tk'u'jlalilju' yol kyej b'entti'j tejumajx tu'n Dyos, <verse number="21" style="v" />axwittzun Qman Dyos q'onte kynab'le' tu'n kyel b'a'ne' toj tkyaqil, tu'n kyb'inchanteye' tajb'il; ex ax Dyos kq'olte qipumal tu'n qb'inchante tkyaqilju' tajb'il, tu'nel Jesukrist. ¡Nimanjtzxwit tb'i Jesukrist toj tkyaqil tab'q'iyil! Ikxwitju'.</para>
  <para style="p">
    <verse number="22" style="v" />E' ntzik ex witz'in, nchin kub'sane' kywitze' tu'n tkub' kyb'i'njuye' yol lu, qu'n ati tajb'en kyeye' tu'n tok kynab'le', ex mya nim yol xxintz'ib'a'ne' kyeye'. <verse number="23" style="v" />Ex wajb'ile' tu'n kyb'inteye' qa matxi' tz'etz tzaqpi'n qitz'in Timotey toj kars, qa lwiy sul tzalu, kxe'l wiq'i'ne' wuk'i'le' ajnxi'ye' ka'yilkyeye'.</para>
  <para style="p">
    <verse number="24" style="v" />Che kyq'olb'enxe' kykyaqil kynejele' ex kkyaqilju' qtzik ex qitz'in toj okslab'l. Ex nche'x q'olb'ene' kyu'nju' okslal toj Italya.</para>
  <para style="p">
    <verse number="25" style="v" />Tenxwit t-xtalb'il Dyos kyuk'i'le' kykyaqile'. Ikxwitju'.</para>
</usx>