<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="HOS" style="id">HOS.TXT Febrero 2009 Pedro D. Cabrera Mam Ostunkalko. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Osey</para>
  <para style="toc3">Os</para>
  <para style="toc2">Os</para>
  <para style="toc1">Tuj Osey (Oseas)</para>
  <para style="mt1">TUJ OSEY</para>
  <para style="mt2">(Osey)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Axjunte Osey ok nimaq t-sanjelal Dyos toju' tkab' jo'k'al (800) ab'q'i na'mtoq titz'ji Krist. Pakb'an Osey kye aj Israel, kyeju' nche' kawin toj tb'a'nq'ob'kya'j, ti'jxi'tl Amos. Yajti Osey tu'n tpaj mje tuk'i'l jun qya ajpajil, kub' tnajsa'n tilju' qya ex xitiq'i'n te t-xu'jil, pakb'an kuw ti'ju' twitzileb'in tnam, ex oktq'o'n kse'nju' ajpaji'n kse'n tpakb'a Jeremiy yajxi'tl. Qu'mtzun tzaj ttx'u'jil Dyos kyib'aj aj Israel tu'n tpaju' kyb'inchb'aj. Atzunte Dyos tu'nju' nimxi'x tk'u'jlalil, inxi'x tk'u'jla'n ttanam, maskye min nche okslan te, qu'mtzun njyonte Dyos kyi'j, nkub' tnajsa'n kyil, nche' etzti'n toj il ex nkub'san tu'n tanjtz jumajtlkyi'j tk'etz.</para>
  <para style="ip">Atzun tb'is tk'u'j tpakb'ab'l Oseyju'. Toj oxe' aq'pun ta'ya' tuj Osey: Aju' tnejel nyolin ti'ju' tmjeb'le'n Osey (Caps. 1-3). Atzu'n tkab' nyolin kyi'j aj Israel tu'nju' e'ok ajpajil twitz Dyos (Caps. 4-13). Atzu'n toxi'n ntxokon kye aj Israel tu'n tanjtzti'j kyanmi ex tu'n tanjtzkyi'j tk'etz Dyos tu'ntzun tkub'najsa'n kyil (Cap. 14).</para>
  <chapter number="1" style="c" />
  <para style="s1">Aju' t-xu'jil Osey exqe' tk'wal</para>
  <para style="p">
    <verse number="1" style="v" />A tyol Qman Dyos ja'lu tzaj tma'n te Osey, tk'wal B'eeri, toj kyq'ijlalil Usiy, Jotam, Akas ex Esekyiy, nimaqkawil toj Juda, ex Jerob'oam, tk'wal Joas, nimaqkawil toj Israel.</para>
  <para style="p">
    <verse number="2" style="v" />Tzyet tmante Qman Dyos tyol te Osey ju' t-sanjelal tu'n tmante kjalu: Matxi' tb'incha taq'wixju' tnam Israel ex matxi' tz'el tpa'ntib' wi'je'. Kuxtxi'ya ex q'intza jun qya ajpajil te t-xu'jila, ex tenx tk'wala tuk'i'l, aye'tzu'n tk'wala tuk'i'l che okyel te tal jun qya ajpajil, chi Dyos.</para>
  <para style="p">
    <verse number="3" style="v" />Tzajtzun tiq'in Osey Komer tmyal Dib'laym te t-xu'jil, ch'onwi'yix tu'n ex itz'ji jun tal q'a. <verse number="4" style="v" />Tzajtzun tma'n Qman Dyos te Osey: Q'onka tb'i k'wal Jesreel, qu'n toj jte' q'ijtl kb'el ntz'e'ysa'ne' kywitz tyajajil nimaqkawil Jewu tu'n tpaju' b'yojwnaqil tb'incha toj Jesreel ex kb'el nb'ajsane' tkawb'il Israel. <verse number="5" style="v" />Kb'el nxitu'ne' kyipumalju' xjal aj Israel te q'oj toju' b'ya' Jesreel toju' tq'ijlalil lu, chi Dyos.</para>
  <para style="p">
    <verse number="6" style="v" />Ch'onwi'yix jumajtlu' qya Komer ex itz'jitl jun tal txin. Atzunte Qman Dyos tzaj tma'n te Osey; Q'onka tb'i tmyala Lo-rwama, qu'n lay tzaj laqjtl nk'u'je' ti'ju' tkawb'il Israel, ex lay kub' nnajsa'ne' til. <verse number="7" style="v" />Atzu'n te tkawb'il Juda ktzajel laqj nk'u'je' ti'j, ayinkuwe' Dyos chin klol kye; ex lay che nkole' tu'n q'oj, tu'n smaj mo tu'n k'uẍtx'e'nb'il ex mya kyu'n aj chejil, chi Dyos.</para>
  <para style="p">
    <verse number="8" style="v" />Telenxi' Lo-rwama ti'j tch'u', ok jumajtlu' qya Komer ch'o'nwi' ex itz'j juntl tal q'a.</para>
  <para style="p">
    <verse number="9" style="v" />Tzajtzun tma'n Qman Dyos te Osey: Loami tb'i k'wal lu q'onka, qu'n tu'n tpaj lay che oktle' te ntaname' ex lay chin noktle te Kydyose', chi Dyos.</para>
  <para style="s1">Kb'entel jumajtlu' tnam Israel</para>
  <para style="q">
    <verse number="10" style="v" />Jun q'ij che okyel aj Israel</para>
  <para style="q">naku'j tz'awun ttzi ninnjab',</para>
  <para style="q">mix-a'lo'x kb'entel techante ex kb'entel tajlante.</para>
  <para style="q">Ex lay t-xinma'ntle' kyeye':</para>
  <para style="q">Qa mya ntanamqe'tle',</para>
  <para style="q">atlpewe' kxe'l nma'n kyeye':</para>
  <para style="q">Ntanam qe'kye', ayine' Dyos i'tz', nchiku'we'</para>
  <para style="q">
    <verse number="11" style="v" />Kb'ajeltzun kyb'u'yi'n kyib' aj Juda ex aj Israel</para>
  <para style="q">ex noq jun kynejel k'okyel kyq'o'n.</para>
  <para style="q">K'anjetz kyi'j kykyaqilu' ate' jaxjaku' tu'n kyb'ju'l toj Jerusalen,</para>
  <para style="q">¡Nim toklenju' tq'ij Jesreel k'okyel! chi Dyos.</para>
  <chapter number="2" style="c" />
  <para style="q">
    <verse number="1" style="v" />Kxe'ltzun kyma'ntze' kye kyitz'ine' mo kytzike' kjalu:</para>
  <para style="q">Ttanam Dyos</para>
  <para style="q">ex kxe'l kymane' kye kyanab'e':</para>
  <para style="q">Matzajlaqj tk'u'j Dyos kyi'je', chechiku'ye'.</para>
  <para style="s1">Elkypa'n kyib' aj Israel ti'j Qman Dyos</para>
  <para style="q">
    <verse number="2" style="v" />Chi Qman Dyos kjalu:</para>
  <para style="q">¡Kypoqonxjuye' kytxuye', kypoqonxe',</para>
  <para style="q">qu'n mya nxu'jiltlwe' ex myayintlwe' tchmil!</para>
  <para style="q">¡Tu'n lalun tz'ajpajintl!</para>
  <para style="q">¡Ex tu'n lalun che ku'xtentl tajpaj titk'u'j!</para>
  <para style="q">
    <verse number="3" style="v" />Qatzun min xkyaj tkyajsa'n, majxtzun kb'el nẍb'iqb'a'ntze'</para>
  <para style="q">majx kjel ẍb'iqe' kse'nx tej titz'ji,</para>
  <para style="q">kjawil b'ent wu'ne' te jun chq'ajlaj</para>
  <para style="q">majx kjel te tzqij tx'otx',</para>
  <para style="q">expe' kkyimel tu'n k'waj wu'ne'.</para>
  <para style="q">
    <verse number="4" style="v" />Lay tzaj laqj nk'u'je' kyi'ju' tal,</para>
  <para style="q">qu'n toj ajpaji'n ẍetzaja'ti'n.</para>
  <para style="q">
    <verse number="5" style="v" />Matxi'ju' kytxu toj ajpaji'n;</para>
  <para style="q">mix-a'lotlte nniman te, tej tmante:</para>
  <para style="q">Machinxe' jyolkye wajpaje',</para>
  <para style="q">aye' nche tzaj q'onte nwaye' ex nk'wa'ye',</para>
  <para style="q">e'tzmal nrite' ex nxb'alune' tz'umin,</para>
  <para style="q">ex waseyte' kyuk'i'l nk'wa'ye', chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Qu'mtzun kb'el njpu'ne' tb'e tu'n ch'i'x</para>
  <para style="q">ex k'okyel nch'laji'ne' ti'j,</para>
  <para style="q">tu'ntzun lalun tz'el yal tb'eyil tu'n.</para>
  <para style="q">
    <verse number="7" style="v" />Kxe'l lpe kyi'j tajpaj extzun lay kub'kyi'j tu'n;</para>
  <para style="q">Kjyol kyi'j, ex lay che elyal tu'n.</para>
  <para style="q">Ktma'tzuntz kjalu:</para>
  <para style="q">K'anjel wi'je' tk'etz tnejel nchmile',</para>
  <para style="q">b'a'ntoq tinqina'we' tuk'i'l kyetwitz ja'lo, chiku'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Min selte' qya lu tnik'</para>
  <para style="q">qa ayine' nchinxtoq q'onte</para>
  <para style="q">ttriy, tb'in ex taseyt;</para>
  <para style="q">ayintoqe' nchin jaw chmet-sante</para>
  <para style="q">t-saqpwaq ex tq'anpwaq xkub' tb'incha'n twitzileb' tu'n.</para>
  <para style="q">
    <verse number="9" style="v" />Qu'mtzun, k'elel wi'ntle' te</para>
  <para style="q">k'anjel wi'ntlwe' ntriy ex nb'in</para>
  <para style="q">toju' q'ij ajtjaw b'uyit awal,</para>
  <para style="q">ex k'anjel wi'nwe' tzmal nrit ex nxb'alun tz'umin,</para>
  <para style="q">xinq'o'ne' te ktxub'lte.</para>
  <para style="q">
    <verse number="10" style="v" />Kywitzku' tajpaj</para>
  <para style="q">kb'ela' nẍb'iqb'a'ne'.</para>
  <para style="q">¡Mix-a'lo'x jun kklolte toj nq'ob'e'!</para>
  <para style="q">
    <verse number="11" style="v" />Kb'el nnajsa'ne' ttzalajb'il,</para>
  <para style="q">e'tninq'ij ex ak'a'j xjaw,</para>
  <para style="q">exqe' tq'ij te ojlab'l</para>
  <para style="q">ex tkyaqilju' tninq'ij.</para>
  <para style="q">
    <verse number="12" style="v" />Kb'el nxitu'ne' tqan t-ub'a ex tqan t-iw,</para>
  <para style="q">aye'ju' intoq tma'n kyi'j:</para>
  <para style="q">Atzun chjob'lteju' lu</para>
  <para style="q">tzaj kyq'o'n wajpaje', chij.</para>
  <para style="q">kjawil b'ent wu'ne' te jun tx'otx' mixti' tawal,</para>
  <para style="q">kb'ajel kywan toj k'ul txkupju' k'ul toj.</para>
  <para style="q">
    <verse number="13" style="v" />Kb'el ntz'e'ysa'ne' twitz tu'nju' tq'ijlalil</para>
  <para style="q">xkub' tq'o'n sturak kywitz witzileb',</para>
  <para style="q">tej intoq achun kyoj tu ex t-xmilq'ob'</para>
  <para style="q">lepchiktoq kyi'ju' tajpaj</para>
  <para style="q">ex matzik' nna'le' tu'n.</para>
  <para style="q">Ayine' Dyos Manb'aj nchin q'mante, chi Dyos.</para>
  <para style="s1">Ntk'u'jla'n Qman Dyos Israel ttanam</para>
  <para style="q">
    <verse number="14" style="v" />Tu'npetzunju', k'okyel nxmoxi'n jumaqjtle':</para>
  <para style="q">kxe'l wi'ne' toj chq'ajlaj</para>
  <para style="q">kchin yolitle' te tu'n toklaqtl wi'je'.</para>
  <para style="q">
    <verse number="15" style="v" />Kxe'l nq'o'ntle' tqan t-ub'a,</para>
  <para style="q">ex kjawil b'entju' b'ya' Akor wu'ne'</para>
  <para style="q">tu'n tqe jumajtl tk'u'ju' qya.</para>
  <para style="q">atzuntzu' ktzajela' ttzaq'we'n weye' kse'n toj tku'xumal,</para>
  <para style="q">kse'n toju' q'ij tej kyetzju' ntaname' toj Ejipt.</para>
  <para style="q">
    <verse number="16" style="v" />Ktzajel tma'ntzuntz weye' kjalu: aya nchmile',</para>
  <para style="q">mya tu'nwt ttzajtma'ntl, Nb'aal chiwt.</para>
  <para style="q">Ayine' Dyos Manb'aj nchin q'mante.</para>
  <para style="q">
    <verse number="17" style="v" />Ex kche elel wi'ne'</para>
  <para style="q">kyb'i twitzleb' toj ttzi,</para>
  <para style="q">layx che tzaj tna'ntl.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Tojtzu'n tq'ijlalil tjawx chix</para>
  <para style="q">kjel b'entti'j jun yol wu'ne'</para>
  <para style="q">kyuk'i'l tojk'ul txkup, e'pich' exqe' kan;</para>
  <para style="q">che k'elel wi'ne' smaj, k'uẍtx'e'nb'il,</para>
  <para style="q">ex k'elel wiq'i'ne' q'oj toju' tnam lu,</para>
  <para style="q">tu'ntzun ttenju' ntaname' toj nak'b'il.</para>
  <para style="q">
    <verse number="19" style="v" />K'okyelta Israel te nxu'jile' tejumajx,</para>
  <para style="q">k'okyela te nxu'jilkuxi'xe' kse'nxju' ntma'n kawb'il,</para>
  <para style="q">qu'n inxi'x chin laqje' ti'ja.</para>
  <para style="q">
    <verse number="20" style="v" />K'okyela te nxu'jile' ex chin okyele' b'a'n teya,</para>
  <para style="q">k'eleltzun tnik'tza weye' ayine' Dyos Manb'aj.</para>
  <para style="q">
    <verse number="21" style="v" />Ayine' Dyos Manb'aj nchin q'mante:</para>
  <para style="q">knb'incha'ye' tu'n tq'onte kya'j,</para>
  <para style="q">jb'al tib'aj ju' tx'otx';</para>
  <para style="q">
    <verse number="22" style="v" />atzunte tx'otx' ktq'a' txqan tawal</para>
  <para style="q">triy, b'in ex aseyt,</para>
  <para style="q">ikytzu'n kb'antela'ju' b'ya' Jesreel.</para>
  <para style="q">
    <verse number="23" style="v" />Kb'el nq'o'ne' ntaname' toju' tx'otx',</para>
  <para style="q">ex k'okyel we'ku'xi'xe';</para>
  <para style="q">ktzajel laqj nk'u'je' ti'j Lo-rwama,</para>
  <para style="q">ex kxe'l nma'ne' te: Lo-ami ¡Aya ntaname'!, nchiku'ye',</para>
  <para style="q">atzunte ktzajel tma'n weye' ¡Aya Ndyose'! chiku'.</para>
  <chapter number="3" style="c" />
  <para style="s1">Aju' qya ajpajil ex Osey</para>
  <para style="q">
    <verse number="1" style="v" />Tzaj tma'n jumajtl Qman Dyos weye':</para>
  <para style="q">Kutxi'ya ex k'u'jlama jun qya</para>
  <para style="q">k'u'jla'n tu'n tamiwa ex ajpajil.</para>
  <para style="q">Ikytzu'n nche nk'u'jla'ne' aj Israel ayine' Dyos Manb'aj,</para>
  <para style="q">maskyepe' matz'anjtlkyi'j k'ulul kye junxi'tl dyos</para>
  <para style="q">ex nkywanju' muqin tzqij ub'a nokx kyq'o'n kywitz witzileb', chij.</para>
  <para style="q">
    <verse number="2" style="v" />Tzajtzun nlq'o'ne' nxu'jile'</para>
  <para style="q">tu'n o'lajoj medi (15) saqpwaq.</para>
  <para style="q">ex qaqlajnaq lajoj (330) litr Seb'ad.</para>
  <para style="q">
    <verse number="3" style="v" />Xinma'ntzuntze' te: k'okyela te nxu'jile' nim tq'ijlalil;</para>
  <para style="q">lalun tz'ajpajina ex lalun txi'tla tuk'i'l juntl ichan,</para>
  <para style="q">ex ikxwe' majx chin nokyelwe' b'a'n teya, nchije' te.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Ikyqextzun aj Israelju' b'a'npun ab'q'i che kjelten</para>
  <para style="q">mixti' kynimaqkawil ex mixti' kynejel,</para>
  <para style="q">lay kub' kyq'o'ntl chojb'il expe' lay che tentl kyab'aj xjanqe',</para>
  <para style="q">mixti'tl kyxb'alun pale ex mixti'tl kywitzleb' ktenb'el tojele kyja.</para>
  <para style="q">
    <verse number="5" style="v" />Yajxi'tzuntel k'anjetz kyi'ju' aj Israel</para>
  <para style="q">ok kyjya' Qman Dyos</para>
  <para style="q">exju' Dab'i kynimaqkawil.</para>
  <para style="q">Kche pomel tk'etz Qman Dyos tuk'i'l ninb'il</para>
  <para style="q">toj mankb'il tq'ijlalil</para>
  <para style="q">ex kyk'mo'ju t-xtalb'il.</para>
  <chapter number="4" style="c" />
  <para style="s1">Tq'oj Dyos kyi'j aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Kyb'intze' aj Israel</para>
  <para style="q">aju' ntma'n Qman Dyos.</para>
  <para style="q">Matxi' tzyet tq'ojin</para>
  <para style="q">kyi'ju' najlqe' toju' tx'otx' lu,</para>
  <para style="q">qu'n mixti'tlte ax kyxolju' xjal tza'lu,</para>
  <para style="q">min nlaq kyk'u'j ex min nelkynik' te Dyos.</para>
  <para style="q">
    <verse number="2" style="v" />Inpe' tzajkyna'n tb'i Dyos ti'j jun ti'xti' mya ax ex nche chanyol</para>
  <para style="q">nche b'yonwnaq ex nche elq'a'n,</para>
  <para style="q">nche ajpajin ex nche b'iyun,</para>
  <para style="q">naqx nche b'yonxjal kukxju'.</para>
  <para style="q">
    <verse number="3" style="v" />Qu'mtzun, toj b'is ta'ju' tx'otx';</para>
  <para style="q">mixti' kyipumalju' najlqe' toj;</para>
  <para style="q">ex kyuk'i'l tojk'ul txkup exqe' pich'</para>
  <para style="q">nche kyimaju' kyiẍ toj ninnjab'.</para>
  <para style="s1">Nche' tpoqo'n Qman Dyos Pale</para>
  <para style="q">
    <verse number="4" style="v" />Chi Qman Dyos kjalu:</para>
  <para style="q">¡Mix-a'lo'x jun tu'n tpoqon ex tu'n ttzak'un ti'j juntl!</para>
  <para style="q">O'kxtzu' ta'we' nq'oj ti'ja, aya pale.</para>
  <para style="q">
    <verse number="5" style="v" />Kb'el tz'aqa te q'ijtl ku'xi'x,</para>
  <para style="q">ex kb'el tz'aqju' t-sanjelal Dyos tuk'i'la te qonik'an,</para>
  <para style="q">ex kb'el nxitu'ne' ttxuya.</para>
  <para style="q">
    <verse number="6" style="v" />Mixti' tojtzqib'lju' ntaname',</para>
  <para style="q">qu'mtzun xkub' xituna'.</para>
  <para style="q">Atzunta pale, matz'eltik'u'na ojtzqib'l,</para>
  <para style="q">K'elel wiq'i'na toju' toklena te pale.</para>
  <para style="q">Mana' b'jik'kyna'lju' nxnaq'tzb'ile' tu'na ayine' Tdyosa,</para>
  <para style="q">Ex k'ik'el kyna'lwe' tyajajila wu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Tej pena' ẍe jaw chmet pale, majx ẍe b'inchanxi'xtl il nwitze';</para>
  <para style="q">qu'mtzun kjawil nmiltz'u'ne' ninb'il kye te kych'ixaw.</para>
  <para style="q">
    <verse number="8" style="v" />Xi' nche anq'ina' kyi'ju' il nkyb'incha'n ntaname';</para>
  <para style="q">qu'mtzun kyajb'il tu'n kyb'inchan xjal il.</para>
  <para style="q">
    <verse number="9" style="v" />Kb'el ntz'e'ysa'n kywitzju'ye' xjal exqe' pale, tu'n tpaju' kyb'ichb'en myab'a'n,</para>
  <para style="q">
    <verse number="10" style="v" />Mina'jon nche ajb'entl weye' ayine' Dyos Manb'aj,</para>
  <para style="q">Che wal ex lay che noj b'a'nxi'x;</para>
  <para style="q">Che okyel ajpajil ex lay tzul kyk'wal.</para>
  <para style="s1">E'k'ulun aj Israel kwitz witzileb'</para>
  <para style="q">
    <verse number="11" style="v" />In naj qnab'l</para>
  <para style="q">tu'n ajpaji'n, ex tu'n k'waj b'in.</para>
  <para style="q">
    <verse number="12" style="v" />Nche xjelunju' ntaname' kye kywitzleb' tzeqe,</para>
  <para style="q">ex nkyjyo'n kyi'j tu'n jun piẍ tze.</para>
  <para style="q">Tzpetniqe' toj ajpaji'n,</para>
  <para style="q">myab'a'n tb'eju' ntaname' ljo'n:</para>
  <para style="q">nche ajpajin ex nelkypa'n kyib' wi'je' aniye' Kydyos.</para>
  <para style="q">
    <verse number="13" style="v" />Nche'x tz'e'ysal sturak ex nkub' kyq'o'n chojb'il</para>
  <para style="q">kywi' nimaq witz ex kywi' ttxa'nwitz</para>
  <para style="q">ex kyjaq' kyxlekumal k'ol, chjaj ex b'ansi.</para>
  <para style="q">qu'mtzun matxi' che okju' kymyal te ajpajil,</para>
  <para style="q">ex nche ajpajinju' kylib'.</para>
  <para style="q">
    <verse number="14" style="v" />Laytzun kub' ntz'e'ysa'we' kywitzju' kymyale' tu'nju' nche ajpajin</para>
  <para style="q">ikxqe' kylib'e' tu'nju' nche ajpaji'n,</para>
  <para style="q">qu'n aye'ku'ye' nchex kyuk'i'l qya ajpajil;</para>
  <para style="q">ajtkub' kyq'o'ne' chojb'il</para>
  <para style="q">nok kymujb'a'n kyib'e' kyuk'i'lju' qya ajpajil naku'j jun k'u'lb'il.</para>
  <para style="q">¡Ikytzu'n nxa' tzpeta' jun tnam mixti' tnab'l.!</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Qama tz'oka Israel te ajpajil,</para>
  <para style="q">tu'npe' o'kx Juda laywit b'inchan il.</para>
  <para style="q">¡Lalun che'xe' toj Kilkal</para>
  <para style="q">mixti' tu'n kyjaxe' toj B'et-ab'en</para>
  <para style="q">ex lalun tzaj kyna'ne' tb'i Dyos tib'aj jun ti'xti'!</para>
  <para style="q">
    <verse number="16" style="v" />Pi'sju' tnam Israel</para>
  <para style="q">naku'j jun tal wakx nt'ikpuj;</para>
  <para style="q">¿ma oktzun che kxe'ltka'yi'n Qman Dyos tu'n kykub' tq'o'n toj tb'anil kytwa,</para>
  <para style="q">naku'xwitloj tal b'o's a'la'jqe'?</para>
  <para style="q">
    <verse number="17-18" style="v" />Matxi' txit-xontib' Eprayin toj witzleb'i'n.</para>
  <para style="q">¡Kykyaqil matxi' che b'ajkub' tz'aq naku'j txqan tx'ujtenil!</para>
  <para style="q">Ex kukxu' kyu'n nche b'aj ajpajin</para>
  <para style="q">ex kyajb'ilxi'x tu'n tel kych'ixaw kyetwitz tu'n kyjaw nima'n.</para>
  <para style="q">
    <verse number="19" style="v" />Che kxe'l iqa'n tu'n kyq'iq',</para>
  <para style="q">ex che b'elch'ixwi ti'ju' kywitzleb'i'n.</para>
  <chapter number="5" style="c" />
  <para style="q">
    <verse number="1" style="v" />Kyb'intzju'ye' lu, pale;</para>
  <para style="q">kyb'intzpeye' tnam aj Israel;</para>
  <para style="q">kyb'intze' aye'ye' toj tja nimaqkawil:</para>
  <para style="q">Kye nakye' tzula' xjel,</para>
  <para style="q">qu'n matxi' che oke' te xpatxab' toj Mispa,</para>
  <para style="q">jun xpatxab' tkub' twi' witz Tab'or,</para>
  <para style="q">
    <verse number="2" style="v" />Kse'n xoch kyejni leb'a'n toj b'ya' Sitim.</para>
  <para style="q">Qu'mtzun kb'el ntz'e'ysa'ne' kywitze'.</para>
  <para style="q">
    <verse number="3" style="v" />Wojtzqi'na Eprayin;</para>
  <para style="q">ex wojtzqina Israel.</para>
  <para style="q">Matz'oka Eprayin te ajpajil;</para>
  <para style="q">ex matxi' b'aj ttxa'ju'ntib'a Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Axju' tb'inchb'aja tnam myab'a'n,</para>
  <para style="q">min najonte tu'n tanjtzkyi'je' tuk'i'l Dyos.</para>
  <para style="q">Matxi kub'ti'ja tu'n ajpaji'n,</para>
  <para style="q">qu'mtzun min nel tnik'a ti'j Dyos.</para>
  <para style="q">
    <verse number="5" style="v" />Axju' kyninb'il kyib'a' aj Israel nyek'unte kyila';</para>
  <para style="q">Njaw trakpuja Eprayin ti'jxju' tila,</para>
  <para style="q">¡expe' axjuna Juda kjawel trakpuja kyuk'i'l!</para>
  <para style="q">
    <verse number="6" style="v" />Okpe' che jyole' wi'je'</para>
  <para style="q">kyuk'i'l kyrite' ex kywakyixe',</para>
  <para style="q">ex lay chin knete' kyu'ne'</para>
  <para style="q">qu'n che kjel nleb'a'ne'.</para>
  <para style="q">
    <verse number="7" style="v" />Mache oke' naku'j qya ajpajil,</para>
  <para style="q">qu'n machin kub'kysb'u'ne' tej ẍe k'ulune' kye txqantl dyos.</para>
  <para style="q">Tu'ntzu'n min nche nimane' weye'</para>
  <para style="q">noq ch'inxtl tkub' xitu'n kytx'otx'e'.</para>
  <para style="s1">Tz'e'ysb'il kywitz Israel ex Juda</para>
  <para style="q">
    <verse number="8" style="v" />¡Kyq'ajtzanxu'ye' xux te q'oj toj Kyib'ea,</para>
  <para style="q">exju' chun toj Rama!</para>
  <para style="q">¡Kyq'onxe' tqanil xob'ajil toj B'et-ab'en!</para>
  <para style="q">¡Tu'n t-xob' B'enjamin!</para>
  <para style="q">
    <verse number="9" style="v" />Kxe'l nma'ne' tpakb'alil kyxole' tnej tyajajil Israel</para>
  <para style="q">aju' kb'ajel ilxi'xti'j:</para>
  <para style="q">Majx che kb'el nxitu'ne' Eprayin toju' tq'ijlalil ajtkub' ntz'e'ysa'ne' kywitze'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Chi Qman Dyos kjalu:</para>
  <para style="q">Ikqe'kye' kynejel aj Juda kse'nqe' xjal</para>
  <para style="q">nche' laq'b'an nqach.</para>
  <para style="q">¡Ex majx che kb'el nnajsa'ne' tu'n ntx'u'jile'!</para>
  <para style="q">
    <verse number="11" style="v" />Jtz'o'nte Eprayin ja'lo</para>
  <para style="q">mixti'tl nnimanjtzu' toklen,</para>
  <para style="q">qu'n xi' soka' tq'o'na'tl twitz,</para>
  <para style="q">kyi'j junxi'tl dyos.</para>
  <para style="q">
    <verse number="12" style="v" />Qu'mtzun kb'el nxitu'ne' tkawb'ilju' tnam lu exju' tkawb'il Juda</para>
  <para style="q">kse'n pok' nokten walte tze.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Ajtzun tkayinte Eprayin qa matxitoq b'o'lj,</para>
  <para style="q">ex ajtka'yinte Juda matxitoq tak',</para>
  <para style="q">che kxe'ltzuntz qanil o'nb'il teju' nimaqkawil aj Asirya;</para>
  <para style="q">extzun lay b'ent kyq'anit tu'n nimaqkawil lu.</para>
  <para style="q">
    <verse number="14" style="v" />Chin xe'l tzaqpaje' b'yolte Eprayin ex Juda</para>
  <para style="q">kse'n jun b'alun aj txi' t-xontib' b'iyul;</para>
  <para style="q">ayinku'ye' chin b'ajel tzaqunkye ex chin oqele'</para>
  <para style="q">txab' kytzyet wu'ne' ex mix-a'lo' kb'entel tklonkye' toj nq'ob'e'.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />K'anjeltzun wi'jtze' toj nnajb'ile'</para>
  <para style="q">tzmaxi'j ajtel kynik' ti'ju' kyil</para>
  <para style="q">ex ajkyul jyolweye'.</para>
  <para style="q">¡Tojtzunju' yajb'ilkye chin kyjya'ye'!</para>
  <chapter number="6" style="c" />
  <para style="s1">Naqx Inkyma'n aj Israel tu'n tanjtzkyi'j tk'etz Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Kukytzaje' kykyaqile', kutanj qi'j tk'etz Qman Dyos.</para>
  <para style="q">Ate xb'aj b'yonqe, ex ate kq'analqe;</para>
  <para style="q">maqo k'ixb'i tu'n ex okqo tq'ana'.</para>
  <para style="q">
    <verse number="2" style="v" />Noq toj kab'e' oxe' q'ijx ktzajel tq'o'n jumajtl qchwinqlal,</para>
  <para style="q">qo jawil twab'a'n tu'n qanq'in twitz.</para>
  <para style="q">
    <verse number="3" style="v" />¡Qq'onk tilil tu'n telqnik' te Qman Dyos!</para>
  <para style="q">Axxi'x tzulte Qman Dyos quk'i'l,</para>
  <para style="q">kse'n ajtjawu'l q'ij,</para>
  <para style="q">axxi'x kse'n ajttzaj jb'al nb'aj ak'u' tx'otx' tu'n</para>
  <para style="q">kse'n tnejel jb'al na'mxtoq tetz jb'alil.</para>
  <para style="s1">Ttzaq'web'l Qman Dyos</para>
  <para style="q">
    <verse number="4" style="v" />Chi Qman Dyos kjalu:</para>
  <para style="q">¿Titi' knb'incha'ye' kyeye' Eprayin ex Juda?</para>
  <para style="q">¿Titi' kche nse'ye'?</para>
  <para style="q">Iky kyk'u'jlalile' wi'je'.</para>
  <para style="q">Kse'n muj te prim,</para>
  <para style="q">ex kse'n ta'l che'w te b'a'n prim, texju' prim nkub'naj.</para>
  <para style="q">
    <verse number="5" style="v" />Qu'mtzun aju' nyole' xpon kyeye' kyu'n nsanjelale',</para>
  <para style="q">iky sela' kse'n q'ankyaq b'iyul</para>
  <para style="q">majx ẍeb'aje' tu'n.</para>
  <para style="q">
    <verse number="6" style="v" />Awe' wajb'il chin kyk'u'jlame',</para>
  <para style="q">myate' chojb'il tu'n tzaj kyq'o'ne' weye'</para>
  <para style="q">tz'elx kynik'e' qa ayine' Dyos,</para>
  <para style="q">myate' tu'n tkub' kyq'o'ne' chojb'il k'ok'sb'il nwitze'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Ikx ntanamju'ye' kse'n Adan,</para>
  <para style="q">matz'ik' tib'aju' nchaq'b'ile' ex min nb'intl.</para>
  <para style="q">
    <verse number="8" style="v" />Matxi' tz'ok Kalaad te jun nintnam aj il,</para>
  <para style="q">matxi'xi'x b'aj txa'j toj tik'len chik'.</para>
  <para style="q">
    <verse number="9" style="v" />Jun k'loj eleq' qekye' pale.</para>
  <para style="q">tokkywitz kyi'ju' xjal;</para>
  <para style="q">nche kub' kyb'yo'n xjal ex nche elq'an kyi'j</para>
  <para style="q">toj tb'eyil Sikyem.</para>
  <para style="q">
    <verse number="10" style="v" />Matxi' wile' ti'xti' taq'wixi'x nkyb'incha'n aj Israel:</para>
  <para style="q">Matxi' tz'ok Eprayin te ajpajil,</para>
  <para style="q">ex ikx Israel matxi' txilpe ti'j.</para>
  <para style="q">
    <verse number="11" style="v" />Ex ikxta Juda</para>
  <para style="q">matxi' kyej b'entti'j tq'ijlalil tz'e'ysb'il twitza.</para>
  <para style="b" />
  <para style="q">Naqa xntch'exb'eye'</para>
  <para style="q">tchwinqlalju' ntaname' Israel.</para>
  <chapter number="7" style="c" />
  <para style="q">
    <verse number="1" style="v" />Qa wajb'ile' tu'n nq'aninteye' ntaname':</para>
  <para style="q">nelyal kyil Eprayin ex aj Samarya taq'wixi'x.</para>
  <para style="q">Qu'n kykyaqilx nche b'aj chanyol;</para>
  <para style="q">ikqe' kse'n eleq' nche b'jo'kx elq'al tk'u'ja</para>
  <para style="q">ex nche oktzaqpaj elq'al kyi'j xjal toj b'e.</para>
  <para style="q">
    <verse number="2" style="v" />Min nche ximan ti'j</para>
  <para style="q">qa na'mile wu'ne' tkyaqil kyb'inchb'aj taq'wix.</para>
  <para style="q">atzu'n ja'lo mache jpet tu'nxju' kyb'inchb'en myab'a'n.</para>
  <para style="q">
    <verse number="3" style="v" />Nxi'x kytzalajsa'n nimaqkawil exqe' nejenel</para>
  <para style="q">tu'n kyb'inchb'aj myab'a'n ex kychajyolil.</para>
  <para style="q">
    <verse number="4" style="v" />Kykyaqilx ajpajilqe';</para>
  <para style="q">ikyqe' kse'n chuj, naqa xk'ent</para>
  <para style="q">inxi'x k'ent ajxi'x tkub' jayun</para>
  <para style="q">b'ankxpun ntx'amset tq'otjel wab'j.</para>
  <para style="q">
    <verse number="5" style="v" />Ajtok tq'ij nimaqkawil,</para>
  <para style="q">majxkub' yab'ti tu'n b'in kyu'n nejenel</para>
  <para style="q">¡ex junx nela' kyuk'i'lju' nche xmayin!</para>
  <para style="q">
    <verse number="6" style="v" />K'u'n kyq'oj toj kyanmi</para>
  <para style="q">nche oklq'e tk'etzu' nimaqkawil naqx tu'n tb'o'lj kyu'n.</para>
  <para style="q">min nche wtan ajtb'aj qonik'an</para>
  <para style="q">qu'n inxi'x che ximan</para>
  <para style="q">se'n kb'o'ljela' kyu'n ajqsqix.</para>
  <para style="q">
    <verse number="7" style="v" />Kykyaqilx ikyqe' kse'n jun chuj nk'ant</para>
  <para style="q">majx ẍeb'aju' kawil kyu'n.</para>
  <para style="q">Kykyaqilju' kynimaqkawil matxi' che b'aj kyu'n</para>
  <para style="q">ex mix-a'lo' jun xqanin o'nb'il weye', chi Dyos.</para>
  <para style="s1">Matz'el tpa'ntib'u' tnam ti'ju' Tdyos</para>
  <para style="q">
    <verse number="8" style="v" />Matxi' txit-smo'ntib' Eprayin kyuk'i'l txqantl tnam.</para>
  <para style="q">Ikyte Eprayin kse'n jun muqin</para>
  <para style="q">noq jun plaj tzq'aj.</para>
  <para style="q">
    <verse number="9" style="v" />Matz'elq'in tipumal kyu'n najchaq xjal.</para>
  <para style="q">Ex min neltnik' ti'j,</para>
  <para style="q">¡expe' matxi' kub' saqax t-xya'mal twi'</para>
  <para style="q">ex min nel tnik' ti'j!</para>
  <para style="q">
    <verse number="10" style="v" />Axju' kynimb'ilkyib' aj Israel xtziyan kyi'jx</para>
  <para style="q">Extzun min nanjtzkyi'j,</para>
  <para style="q">ex min nche jyon wi'je' ayine' Kydyos.</para>
  <para style="q">
    <verse number="11" style="v" />Ikyte Eprayin kse'n jun xu'ch</para>
  <para style="q">noq nttakla'ntib' ex min nximan:</para>
  <para style="q">nqanin o'nb'il te Ejipt</para>
  <para style="q">ex lwiy nxi'tl qanil tnab'l te Asirya.</para>
  <para style="q">
    <verse number="12" style="v" />Ajtzun kxi' na'tz,</para>
  <para style="q">kxe'l nxone' pa te xpatxab' kyib'aj;</para>
  <para style="q">kche b'eltz'aqtzuntz wu'ne' kse'nqe' pich' twitz kya'j,</para>
  <para style="q">kche tzyetel wu'ne' tu'n tpaju' kyb'inchb'en taq'wix.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¡Qab'anx kywitz tu'n sel kypa'n kyib' wi'je'!</para>
  <para style="q">Kb'elkyi'j tu'n xitb'ilkye,</para>
  <para style="q">qu'n majawkyi'nkyib' wi'je'.</para>
  <para style="q">Wajb'ilwe' tu'n kyklet wu'ne'</para>
  <para style="q">aye'tzunkye nche chanyol wi'je'.</para>
  <para style="q">
    <verse number="14" style="v" />B'a'n qama che ẍch'in toj kuẍb'il,</para>
  <para style="q">min nche kub'san nwitze' tu'n tkyaqil kyanmi.</para>
  <para style="q">Maskye nkyk'ixb'sa'n kyib' ajkyqanin kywa triy ex kyk'wa' b'in;</para>
  <para style="q">¡matxi'na' jawkyi'nkyib' wi'je'!</para>
  <para style="q">
    <verse number="15" style="v" />Oje che b'ajx nxnaq'tza'ne'</para>
  <para style="q">ex matxi'nq'o'ne' kyipumal,</para>
  <para style="q">aye'tzunkye mab'aj kyxima'n ti'xti' taq'wix wi'je'.</para>
  <para style="q">
    <verse number="16" style="v" />Mache k'ulun jumajtl kye witzleb';</para>
  <para style="q">ikqe' kse'n jun smaj txalchi,</para>
  <para style="q">min pon yalju' tal janxa' nik'una'.</para>
  <para style="q">Tu'nju' kyol taq'wix wi'je'</para>
  <para style="q">kche b'ajelju' kynejel tu'n k'uẍtx'e'nb'il,</para>
  <para style="q">ex k'elel kych'ixaw toj Ejipt.</para>
  <chapter number="8" style="c" />
  <para style="s1">Kub' tz'e'ysa'n twitz Israel tu'n tpaj witzleb'i'n</para>
  <para style="q">
    <verse number="1" style="v" />Q'ajtzanxa chun,</para>
  <para style="q">kse'n jun xq'uqil nxq'uqin</para>
  <para style="q">tib'aju' ntaname' ayine' Dyos.</para>
  <para style="q">Qu'n min xjapunju' yol kyejni b'entti'j kyu'n</para>
  <para style="q">matxi' tz'el kypa'n kyib' ti'ju' nxnaq'tzb'ile'.</para>
  <para style="q">
    <verse number="2" style="v" />Che ultzuntz k'ulul weye', nche' ẍch'in kjalu:</para>
  <para style="q">¡Matxi' tz'el qnik'e' teya Tdyos Israel!</para>
  <para style="q">
    <verse number="3" style="v" />Extzun min kyajb'il tu'n kyb'inchante b'a'n,</para>
  <para style="q">qu'mtzun kche jyonjtzel kyu'n kyajq'oj.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Matxi' che b'jo'k kyq'o'n kynimaqkawil ex mixti'xte saj kyma'n weye',</para>
  <para style="q">matxi' che b'jo'k kyq'o'n kynejel ex min b'i'n wu'ne'.</para>
  <para style="q">Matz'ajb'en saqpwaq ex q'anpwaq kyu'n</para>
  <para style="q">tej xkub' kyb'incha'n kywitzleb',</para>
  <para style="q">ex xkub' kyxitu'nkyib'.</para>
  <para style="q">
    <verse number="5" style="v" />¡Majx ntik'o'n nk'u'ju'ye' wakx nche k'ulune' te, aj Samarya!</para>
  <para style="q">Matxi' tzaj txqan ntx'u'jile' ti'j.</para>
  <para style="q">¿Jtojtzun kyẍtilsa kyib'e' aj Israel? <verse number="6" style="v" />¡Mya Dyoste' tal wakx ati Samarya!</para>
  <para style="q">Naqna' jun xjalte' b'inchante</para>
  <para style="q">ex majx kb'el npẍu'ne'.</para>
  <para style="q">
    <verse number="7" style="v" />Ktz'e'ysetel kywitze'</para>
  <para style="q">qa min nchinx kyb'i'ne':</para>
  <para style="q">mixti'x twitz kyawale' kjawil</para>
  <para style="q">ex mixti'x twitz kytriy k'elel;</para>
  <para style="q">qatzun ma'x tz'el ch'i'n kyu'ne';</para>
  <para style="q">naqxte kywa najchaq xjal k'okyela'.</para>
  <para style="q">
    <verse number="8" style="v" />¡Kyjel xitju' Israel!</para>
  <para style="q">Kyjel kse'n ttx'anqa'n k'wil mixti'tl tajb'en.</para>
  <para style="q">
    <verse number="9" style="v" />Tu'n tpaj exi' qanil onb'il Asirya</para>
  <para style="q">kse'n jun b'etlaj tx'yan</para>
  <para style="q">¡Xitq'o'n Eprayin oyaj naqx tu'n ttzaj o'ni'n!</para>
  <para style="q">
    <verse number="10" style="v" />B'a'ntzun qa matxikyq'o'n oyaj kyxol nimaqtnam,</para>
  <para style="q">Che kxe'l nsputi'ne' kyoj txqantl nimaqtnam,</para>
  <para style="q">Ex kpomil jun tq'ijlalil</para>
  <para style="q">lay che tentl nimaqkawil ex nejenel kye.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Qu'n nim txqan q'olb'eb'l matxi' b'jaw kyb'incha'ne' Eprayin;</para>
  <para style="q">naqx tu'n kyb'inchan ile' nche ajb'ena'.</para>
  <para style="q">
    <verse number="12" style="v" />Nim xnaq'tzb'il matxi' b'ajx ntz'ib'a'ne' kyeye',</para>
  <para style="q">aye'tzunkye' mache b'je'l kyik'o'ne'.</para>
  <para style="q">
    <verse number="13" style="v" />Inxi'x kub' kyq'o'ne' chojb'il,</para>
  <para style="q">ex nxi' kych'yo'ne' kychib'jilu' chojb'il;</para>
  <para style="q">ayintzunwe' min nchin tzalaje' kyuk'i'le', ayine' Dyos Manb'aj:</para>
  <para style="q">na'nwe' kyile' wu'n,</para>
  <para style="q">kb'el ntz'e'ysa'n kywitze' tu'n tpaju' kyile',</para>
  <para style="q">k'anjetl kyi'je' Ejipt.</para>
  <para style="q">
    <verse number="14" style="v" />Aj Israel, nche jaw kyb'incha'ne' tja nimaqkawb'il,</para>
  <para style="q">ayintzune' matxi' tzik'nna'le' kyu'ne', ayine' ch'isalkyeye'.</para>
  <para style="q">Ikxte Juda nche jawtb'incha'n nimaqtnam kuwsa'nqe',</para>
  <para style="q">oktzun che b'ajel npati'nwe' toj q'aq'</para>
  <para style="q">majx che b'ajelju' tja nimaqkawb'il.</para>
  <chapter number="9" style="c" />
  <para style="s1">Tqanil tz'e'ysb'il kywitz aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Lan che jawnaj tzalaje', Israel;</para>
  <para style="q">lan che xlik'pune' tu'n kytzalajb'ile' kse'n nkyb'incha'n txqantl tnam,</para>
  <para style="q">matxina' che oke' ajpajil</para>
  <para style="q">tu'n xkyaj kytzaqpi'ne' Dyos.</para>
  <para style="q">Ajtel twitz kyawale' kyoju' er ja inela' b'inchet triy</para>
  <para style="q">xi' nche q'ona' chjonteye' kyeju' mya dyos qe'.</para>
  <para style="q">
    <verse number="2" style="v" />Tnam Israel, lay ten kytriye' ex kyb'ine'</para>
  <para style="q">ex lay kanun kyb'ine' ak'a'j.</para>
  <para style="q">
    <verse number="3" style="v" />K'anjetlkyi'je' Ejipt,</para>
  <para style="q">ex kche wal tz'il wab'je' toj Asirya.</para>
  <para style="q">Lay che najantle' toju' ttanam Qman Dyos:</para>
  <para style="q">
    <verse number="4" style="v" />lay che k'wantl b'ine' ninb'ilte Qman Dyos,</para>
  <para style="q">expe' lay b'entl kyq'on chojb'ile'.</para>
  <para style="q">Qama txi' kywan jun kywaye' naku'j te b'is,</para>
  <para style="q">ex che kjel tz'ilixju' che kxe'l wante.</para>
  <para style="q">Kxe'l kywane' wab'j lu,</para>
  <para style="q">extzun lay b'ent t-xikyiq'i'ne' toj tja Dyos.</para>
  <para style="q">
    <verse number="5" style="v" />¿Titi' kb'antel kyu'ne' toju' ninq'ij</para>
  <para style="q">aju' nim toklen te Qman Dyos?</para>
  <para style="q">
    <verse number="6" style="v" />Mana' che'x oqe' teju' xitb'il saj kyib'aje'</para>
  <para style="q">che tzyunjtzele' Ejipt,</para>
  <para style="q">ex che b'elex mqu'ne' Menpis.</para>
  <para style="q">Kb'el noj kyk'uwene' saqpwaq tu'n ch'i'x,</para>
  <para style="q">ex che ch'iyel ch'i'x toj kyxmuje'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />¡Matxi' pon tq'ijlalil tu'n ttzaj tz'e'ysb'il kywitze'!</para>
  <para style="q">¡Matxi' pon tq'ijlalil tu'n kychjonteye' kyile'!</para>
  <para style="q">¡Oktb'i'ya Israel qa matxi' pon tq'ijlalil!</para>
  <para style="q">Ina' kyma'ne': Xnakte' t-sanjelal Dyos.</para>
  <para style="q">Okni toj twi'ju' ichan xewsa'n tu'n Dyos, chechije'</para>
  <para style="q">Iky nkyma'nju'ye' lu, qu'n nojniqe'ye' tu'n il,</para>
  <para style="q">nimxi'x kytx'u'jile'.</para>
  <para style="q">
    <verse number="8" style="v" />Xq'uqilte Eprayin kub'a' tq'o'nte Dyos t-sanjelal</para>
  <para style="q">aye'tzunkye' nkub' kyq'o'ne' xpatxab' toj tb'e;</para>
  <para style="q">¡Inxi'xpe' walti'j kyk'u'je' ti'j toju' tja Dyos!</para>
  <para style="q">
    <verse number="9" style="v" />Mache kub' tzuwixe' toju' kyile',</para>
  <para style="q">kse'nqe' najlqe'toq Kyib'ea.</para>
  <para style="q">Laytzun tzik'tna'lte' kyb'inb'aje' taq'wix tu'n Qman Dyos</para>
  <para style="q">ex kb'el ttz'e'ysa'n kywitze' tu'n tpaju' kyile'.</para>
  <para style="s1">Kyajtel Israel tu'n tpaj til:</para>
  <para style="q">
    <verse number="10" style="v" />Intma'n Qman Dyos kjalu:</para>
  <para style="q">Intzalaje' tej kyknete' wu'ne'</para>
  <para style="q">kse'n nknet lob'j ub'a tu'n jun xjal toj chq'ajlaj.</para>
  <para style="q">Iky eb'jela' ojtxi' kychmanju'ye' weye',</para>
  <para style="q">kse'n tnejel twitz lob'j iw.</para>
  <para style="q">tetzunj kypon tk'etz B'aal-peor</para>
  <para style="q">xi' kyaq'atlkyib' kyuk'i'lju' dyos mya ax,</para>
  <para style="q">mache ok ik'b'ajilqe'xi'x,</para>
  <para style="q">kse'nqe' witzileb' nche' kyk'u'jla'n.</para>
  <para style="q">
    <verse number="11" style="v" />Lay tentlte' txqan tq'inumal Eprayin:</para>
  <para style="q">kxe'l iqa'n tu'n kyq'iq' kse'n t-xaq tze,</para>
  <para style="q">lay che oktlkye' qya ch'onwi',</para>
  <para style="q">lay tentlkye qya aj Israel kyal.</para>
  <para style="q">
    <verse number="12" style="v" />Qatzun mache anq'in kyk'wal kyu'n,</para>
  <para style="q">ayinwe' chin elelq'inkye ex lay kyej junkye.</para>
  <para style="q">¡Qab'a'nx kyej xjal kywitz ajtel npa'nwib'e kyi'j!</para>
  <para style="q">
    <verse number="13" style="v" />Nok nka'yi'ne' ikynche t-se'n Eprayin tk'wal</para>
  <para style="q">kse'nqe' txkup nche tzyet kyu'n xjal toj k'ul:</para>
  <para style="q">nche etztiq'in ex nche'x tq'o'n tu'n kykub' b'yo'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />¡Nman Dyos, b'inchama kye aju' tu'n tb'inchateya!</para>
  <para style="q">¡Tu'n lalun che alantlu' qya ex tu'n lalun tentl ta'l kyimi'ẍ!</para>
  <para style="s1">Ttx'u'jil Qman Dyos ti'j Eprayin</para>
  <para style="q">
    <verse number="15" style="v" />Chi Qman Dyos kjalu:</para>
  <para style="q">Kyb'inchaye' taq'wix tej kyule' Kyilkal,</para>
  <para style="q">atzuntzu' tzaja' ntx'u'jile' kyi'je'.</para>
  <para style="q">Tu'n tpaju' kyb'inchb'aje' taq'wix</para>
  <para style="q">kche elex nxla'ja'ne' toj njaye';</para>
  <para style="q">ex lay che nk'u'jlatle'.</para>
  <para style="q">kykyaqilxju' kynejele' pi'sqe'.</para>
  <para style="q">
    <verse number="16" style="v" />Matxi' che k'ixb'iye' Eprayin;</para>
  <para style="q">kse'n jun tze tzqijtl tlok'</para>
  <para style="q">ex min nwitzantl.</para>
  <para style="q">b'a'n qama che ul kk'wale',</para>
  <para style="q">ayinwe' chin kb'el b'yonkye, chi Dyos.</para>
  <para style="q">
    <verse number="17" style="v" />Aj Israel, che elel ik'o'ne' tu'n Qman Dyos</para>
  <para style="q">qu'n min nche okslane' te.</para>
  <para style="q">Qu'mtzun che ik'ele' toju' kytaname',</para>
  <para style="q">ex noq kche b'etenjele' kyojile junjun nimaqtnam.</para>
  <chapter number="10" style="c" />
  <para style="s1">B'ajkub' xitu'n kyq'olb'eb'l aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Ikyqe' aj Israel kse'n junwi' tqan ub'a txijli toj twitz</para>
  <para style="q">tu'ntzu'n txijlixi'xtoq</para>
  <para style="q">txqanxi'xtl q'olb'eb'l nche kyb'incha'n;</para>
  <para style="q">tu'nju' tb'anilxi'xju' kytx'otx',</para>
  <para style="q">ex tb'anilqe'xi'xtlju' kyab'aj xjansa'nqe'.</para>
  <para style="q">
    <verse number="2" style="v" />Kyajb'il aj Israel tu'n kyk'u'jlante Dyos, ex kyeju' mya dyos qe'</para>
  <para style="q">atzun ja'lo kkychja' kyil.</para>
  <para style="q">Che b'elt-xitu'n Qman Dyos kyq'olb'eb'l ex kyab'aj xjansa'nqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Kkyma'tzuntz:</para>
  <para style="q">Mixti' qnimaqkawil</para>
  <para style="q">qu'n min nqo niman te Qman Dyos.</para>
  <para style="q">ex naqwit ati ¿Ti'wttzuloti' kb'antel tu'n nimaqkawil qe?</para>
  <para style="q">
    <verse number="4" style="v" />Noq nyolin ex nyolin,</para>
  <para style="q">nxittziya'n jun ti'xti' mya ax ex nkyaj b'enttij jun yol kyu'n;</para>
  <para style="q">ikytzu'n nch'iyju' taq'wixil</para>
  <para style="q">kse'n junwi' k'ul b'iyul toj kojb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Nche lu'lunju' xjal aj Samarya;</para>
  <para style="q">nche' oq' tu'n tpaj kywitzleb' tal wakx matz'exq'i'n B'et-ab'en.</para>
  <para style="q">Tu'ntzunju' nche oq'a' tnam exqe' pale,</para>
  <para style="q">qu'n matxi' kub' naju' ninb'ilkye.</para>
  <para style="q">
    <verse number="6" style="v" />Aku'pe' tal wakx kxe'l q'in Asirya.</para>
  <para style="q">tu'n txi' q'o'n teju' nin nimaqkawil.</para>
  <para style="q">Extzun majx k'elel tch'ixaw Eprayin:</para>
  <para style="q">Kb'el ch'ixwi Israel tu'n tpaj kxe'l q'i'n twitzleb'.</para>
  <para style="q">
    <verse number="7" style="v" />Kb'el naju' nimaqkawil toj Samarya</para>
  <para style="q">kse'n jun xpe'lb'en ntananje tib'aj a'.</para>
  <para style="q">
    <verse number="8" style="v" />Che b'ajel xitu'n najb'il xjan te witzileb'i'n</para>
  <para style="q">ja xb'inchana' il tnam Israel.</para>
  <para style="q">Che b'ajel ch'iy txo'k ex ch'i'x kyib'aju' kyq'olb'eb'l,</para>
  <para style="q">aye'tzu'n xjal kxe'l kyma'n kyeju' nimaq witz:</para>
  <para style="q">¡Kukytzaj niq'je' qib'aje'!,</para>
  <para style="q">ex kxe'l kyma'n kye k'ok'e' witz:</para>
  <para style="q">¡ktzaj tz'aqe' qib'aje'!</para>
  <para style="s1">Tz'e'ysb'il twitz Israel tu'n Dyos</para>
  <para style="q">
    <verse number="9" style="v" />Chi Qman Dyos kjalu:</para>
  <para style="q">Aj Israel, na'mx tkyej kytzaqpine' tu'n kyb'inchan ile'</para>
  <para style="q">ttzajtlenx kyb'inchan ile' toj Kib'ey.</para>
  <para style="q">¡Kukx kytenju'ye' toj il!</para>
  <para style="q">Qu'mtzun kb'elkyi'je' tu'n q'oj</para>
  <para style="q">aye'ye' b'inchal taq'wix toj Kib'ey.</para>
  <para style="q">
    <verse number="10" style="v" />Kb'el ntz'e'ysa'n twitzju'ye' tnam lu.</para>
  <para style="q">Kb'ajel kyb'u'yi'n kyib' nimaqtnam q'ojil ti'j.</para>
  <para style="q">Ajtkub' ntz'e'ysa'ne' twitz tu'n tpaju' myab'a'n xtb'incha.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Ikytoq Eprayin kse'n jun wakx mansi'ntl</para>
  <para style="q">ex tajb'ilxi'x tu'n ttriyin.</para>
  <para style="q">Atzu'n ja'lo matxi' jax nq'o'ne' tiqb'il</para>
  <para style="q">tib'aju' tqul tb'anilxi'x,</para>
  <para style="q">tu'n txi' tjk'u'n karwaj;</para>
  <para style="q">atzunte Juda matxi' kjol kyuk'i'l wakx,</para>
  <para style="q">atzuntlte Jakob' kb'ajel txijinte tq'ub'en.</para>
  <para style="q">
    <verse number="12" style="v" />Ex xinma'ne' kye: kyawanku'xe' tnik'alilti'j</para>
  <para style="q">tu'n kyb'uyinteye' tk'u'jlalil.</para>
  <para style="q">Kyaq'unanku'ye' tx'otx' tu'n toktl tawal,</para>
  <para style="q">qu'n a tq'ijlalilu' ja'lo tu'n kyjyonteye' Qman Dyos.</para>
  <para style="q">tzmax ajtul tq'o'n</para>
  <para style="q">kolb'ilkyeye' nakuj jb'al.</para>
  <para style="q">
    <verse number="13" style="v" />Aye'tzunkye' ma ku'x kyawa'ne' taq'wix,</para>
  <para style="q">naqx xitb'il xkyk'ame'.</para>
  <para style="q">naqx chajyolil tokx toj kytziye' naku'j kywaye'.</para>
  <para style="b" />
  <para style="q">Tu'n tpaj xi' soka' qe kyk'u'je' ti'j kykarwaje' te q'oj</para>
  <para style="q">ex kyi'j txqan kyxjale' te q'oj,</para>
  <para style="q">
    <verse number="14" style="v" />kche jawil tilju' kyxjale'</para>
  <para style="q">ex kykyaqilju' kyjaye' kuwsa'nqe' che b'elxitj,</para>
  <para style="q">kse'n kub'a' xitu'n B'et-arb'el tu'n nimaqkawil Salman</para>
  <para style="q">toju' q'oj tej tkub' b'yo'n txub'aj kyuk'i'lxi' tal.</para>
  <para style="q">
    <verse number="15" style="v" />Ikxtzun che okyela'ju'ye',</para>
  <para style="q">najlqe'ye' toj B'etel,</para>
  <para style="q">tu'n tpaj txqan taq'wix xkyb'inchaye'.</para>
  <para style="q">Kb'ajelte' nimaqkawil aj Israel ajtjawu'l q'ij.</para>
  <chapter number="11" style="c" />
  <para style="s1">Ntk'u'jla'nte Dyos ttanam b'a'nqa pi's</para>
  <para style="q">
    <verse number="1" style="v" />Chi Qman Dyos teju' ttanam kjalu:</para>
  <para style="q">Israel, tej ikyqe'toqu'ye' kse'n jun k'wal,</para>
  <para style="q">intoq che nk'u'jla'ne'.</para>
  <para style="q">E'etzwiq'i'ne' toj Ejipt, qu'n nk'wal qena'ya.</para>
  <para style="q">
    <verse number="2" style="v" />Tetzu'n nchin txokone' kyi'je',</para>
  <para style="q">xi'pe' nela' kypa'ntl kyib'e' wi'je'.</para>
  <para style="q">Ntanam, xi' nche q'ona'tl chojb'ile' kyeju' mya dyosqe'</para>
  <para style="q">ex nkub' kypati'n sturak kywitz witzleb'.</para>
  <para style="q">
    <verse number="3" style="v" />E'xipe' nxb'etza'ne' tnam Israel</para>
  <para style="q">ex e'xinxnaq'tza'ne' tu'n kyb'ete';</para>
  <para style="q">aye'tzunkye' min kane toj kywitze' qa nchin xq'uqine' kyi'je'.</para>
  <para style="q">
    <verse number="4" style="v" />E'tzaj nlaq'b'a'ne' nk'etze'</para>
  <para style="q">tuk'i'l tlaqb'il nk'u'je' ex nk'u'jlalile',</para>
  <para style="q">e'oknlaq'b'a'ne' ti'j ntziye';</para>
  <para style="q">naku'j ne'ẍ tzma nch'u'n;</para>
  <para style="q">kub' nq'o'ne' kywaye',</para>
  <para style="q">
    <verse number="5" style="v" />Aye'tzunkye' min kyaje' tu'n tanjtzkyi'je' wuk'i'le'.</para>
  <para style="q">Qu'mtzun k'anjel jumajtlkyi'je' Ejipt,</para>
  <para style="q">ex kkawil Asirya kyib'aje'.</para>
  <para style="q">
    <verse number="6" style="v" />Tzul q'oj kyi'ju' nimaqkytaname'</para>
  <para style="q">ex che b'ajelju' kyjaye' kuwsa'n,</para>
  <para style="q">che b'elb'ajsa'ne' tu'n tpaj kyxime' myab'a'n.</para>
  <para style="q">
    <verse number="7" style="v" />Matxi' tz'el kypa'n kyib'e' wi'je' ntanam;</para>
  <para style="q">xi' toka'tl kywitze' kyi'ju' mya dyos qe' ex min nb'ent kyonin kyi'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />¿Se'n taq'wi ajkykyaj nkolb'e'ne' Eprayin?</para>
  <para style="q">¿Se'ntaq'wi ajkykyaj ntzaqpi'ne' Israel?</para>
  <para style="q">¿Ma che kb'el nxitu'ne' kse'n tkub' nxitu'ne' nintnam Adma,</para>
  <para style="q">mujqa tu'n nb'inchanteye' kyeye' kse'n nb'inchaye' te Seb'oyim?</para>
  <para style="q">¡Inlaqjwe' nk'u'j kyi'je',</para>
  <para style="q">ex nche exch'yone' toj nk'u'je'!</para>
  <para style="q">
    <verse number="9" style="v" />Lay tzajtl ntx'u'jile' kyi'je':</para>
  <para style="q">lay che kub' nxitu'ntle',</para>
  <para style="q">qu'n ayine' Dyos Manb'aj, mya jun xjal qine',</para>
  <para style="q">Xjan qinwe' ex atinqine' kyxole',</para>
  <para style="q">ex min ẍinule' xitulkyeye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Kchin tzanule' kse'n jun b'alun,</para>
  <para style="q">aye'tzunkye' che nimale' weye'.</para>
  <para style="q">Kchin tzanule', che b'ju'ltzuntze'</para>
  <para style="q">nxi'x che lu'lune' ajkytzaje' te tkub'exq'ij nwitze'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Naku'j pich' qe'ye' nche lu'lune' ajkytzaje' Ejipt;</para>
  <para style="q">naku'j xu'ch qe'ye' ajkytzaje' Asirya;</para>
  <para style="q">che najal jumajtle' toj kyjaye' wu'ne'.</para>
  <para style="q">Ayine' Dyos Manb'aj nchin yolin.</para>
  <para style="s1">Kyil ttanam Dyos</para>
  <para style="q">
    <verse number="12" style="v" />Matxi'xi'x che chanyole' weye' Eprayin;</para>
  <para style="q">matxi'xi'x chin kub'kysb'u'ne' Israel.</para>
  <para style="q">Ikx qe'tlkye' aj Juda matxi' tz'el kypa'n kyib'e' wi'je',</para>
  <para style="q">qu'n inxi'x che k'ulune' kywitz witzleb'.</para>
  <chapter number="12" style="c" />
  <para style="q">
    <verse number="1" style="v" />Tu'n kyq'iq' nnoja' Eprayin:</para>
  <para style="q">tkyaqil q'ij lepchix ti'ju' kyq'iq' te tjawetzq'ij.</para>
  <para style="q">njaw chmet tchajyolil ex tq'oji'n,</para>
  <para style="q">nkyaj b'entti'j tyol tuk'i'l Asirya</para>
  <para style="q">ex nxit-sma'n toyaj aseyt te Ejipt.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Kq'ojil Qman Dyos ti'j Israel.</para>
  <para style="q">Kb'el ttz'e'ysa'n twitz ttanam Jakob' tu'n tpaj myab'a'n tchwinqlal;</para>
  <para style="q">kb'el tchjo'n kse'nxju' tb'inchb'aj.</para>
  <para style="q">
    <verse number="3" style="v" />Tej na'mxtoq titz'ji Jakob' tzyetju' tuẍil tqan ttzik tu'n,</para>
  <para style="q">tetzunj matxi'toq ichamix b'ujun tuk'i'l jun anjl.</para>
  <para style="q">
    <verse number="4" style="v" />B'ujun tuk'i'lju' anjl ex kub'ti'j tu'n;</para>
  <para style="q">oq' ex xitkub'sa'n te tu'n ttzaj laqj tk'u'j ti'j.</para>
  <para style="q">Kub' tyek'u'ntib' Dyos twitz toj B'etel</para>
  <para style="q">ex yolin Dyos tuk'i'l atzu'.</para>
  <para style="q">
    <verse number="5" style="v" />A Qman Dyos nimtipumal:</para>
  <para style="q">¡ex a tb'iju': Qman Dyos!</para>
  <para style="q">
    <verse number="6" style="v" />Aj Israel, kutanjtz kyi'je' tuk'i'l Dyos;</para>
  <para style="q">kyb'inchame' b'a'n ex toj tzinun,</para>
  <para style="q">qek kyk'u'je' kukxu' ti'ju' kydyose'.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Chi Qman Dyos kjalu:</para>
  <para style="q">Min tz'aqli kymalb'il aj Kanaan,</para>
  <para style="q">qu'n majx kgan tu'n kyelq'an.</para>
  <para style="q">
    <verse number="8" style="v" />Aye'tzuntlkye' Eprayin inkyma'ne': ¡Matxi' qo q'inumaxe',</para>
  <para style="q">matz'okyal jun qq'inumale';</para>
  <para style="q">mix-a'lo'te kpoq'il qi'je' qa ati qile'</para>
  <para style="q">tu'n qkanb'ab'le' toj sb'ub'l!, chechiye'.</para>
  <para style="q">
    <verse number="9" style="v" />Ayine' Dyos Manb'aj Kydyose'</para>
  <para style="q">ttzajlenx tej ate'toqe' Ejipt,</para>
  <para style="q">kche najal jumajtle' wu'ne' kyoj pach xb'alun,</para>
  <para style="q">kse'nx tej kyb'ete' toj chq'ajlaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Nyolinwe' kyeye' toj kytzi nsanjelale'</para>
  <para style="q">ex nim xb'ajx nyek'une' kyeye',</para>
  <para style="q">toj kytzi nyolina'ye' kyuk'i'l techlal kyeye'.</para>
  <para style="q">
    <verse number="11" style="v" />Ate' junxi'tl dyos toj Kalaad,</para>
  <para style="q">extzun mya dyosqe'.</para>
  <para style="q">Nche kub' q'o'n chojb'il tman wakx toj Kilkal;</para>
  <para style="q">ikyqe' kyq'olb'eb'l kse'n ch'uq ab'j</para>
  <para style="q">kyxolile txol awal toj kojb'il.</para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" />Xi' oq Jakob' toj tx'otx' Aram, ex atzu' aq'unana' k'ik'lel rit tu'n tkanb'et t-xu'jil. <verse number="13" style="v" />Etzti'n Qman Dyos tnam Israel toj Ejipt tu'nel jun t-sanjelal; ¡e't-xq'uqi tu'nel t-sanjelal!</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Matxi' tz'ok kyq'o'n aj Israel ttx'u'jil Qman Dyos,</para>
  <para style="q">matxi'xi'x tz'ok kyq'o'n jun tk'ayil te.</para>
  <para style="q">Qu'mtzun kb'el ttz'e'ysa'n Qman Dyos kywitz tu'nju' kyb'inchb'en myab'a'n,</para>
  <para style="q">ex kb'el tz'aqju' kyb'inchb'en taq'wix kyib'aj.</para>
  <chapter number="13" style="c" />
  <para style="s1">Tej tkub' xitj Israel tkyaqil</para>
  <para style="q">
    <verse number="1" style="v" />Tej intoq che yolin tyajajil Eprayin,</para>
  <para style="q">nima'ntoq kyyol kyu'n txqantl tnej tyajajil Israel;</para>
  <para style="q">tu'ntzun tpaj ek'ulun te B'aal, eb'inchan il twitz Qman Dyos ex e'kyim.</para>
  <para style="q">
    <verse number="2" style="v" />¡Ex kukx kyb'inchan ilju'!</para>
  <para style="q">Nkub' kyb'incha'n kysaqpwaq te kywitzleb'</para>
  <para style="q">kse'nx nkub' kyxima'n b'inchalte.</para>
  <para style="q">Inkyma'ntzuntz: ¡kyq'onku'tzun chojb'ile' kywitz ja'lo! chechij,</para>
  <para style="q">aye'tzu'n xjal nche okkyma'tzi'n witzleb' wakx che ka'yin.</para>
  <para style="q">
    <verse number="3" style="v" />Qu'mtzun kche okyel kse'n muj te prim,</para>
  <para style="q">ex kse'n ta'l che'w te b'a'n prim, texu' kmuj nkub'naj,</para>
  <para style="q">kse'n ttxa triy naq nxitiqa'n kyq'iq',</para>
  <para style="q">ex kse'n sib' nnex toj telex sib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Chi Qman Dyos kjalu:</para>
  <para style="q">Ayinwe' Kydyose',</para>
  <para style="q">atxi'x ate'xtoqe' Ejipt:</para>
  <para style="q">Lalun tz'ok kyq'o'n juntle' te Dyos nwitze',</para>
  <para style="q">qu'n o'qinkxwe' klolkyeye'.</para>
  <para style="q">
    <verse number="5" style="v" />E'nxq'uqiye' kyoju' tx'otx' nche tanton toj chq'ajlaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Atzu'n tej min xb'ajtl kywateye'</para>
  <para style="q">matz'okxten nimjtib'il toj kyanmiye'</para>
  <para style="q">ex matzik' nna'le' kyu'ne'.</para>
  <para style="q">
    <verse number="7" style="v" />Qu'mtzun chin okyile' kse'n b'alun kyeye'</para>
  <para style="q">ex kse'n jun tx'u'jb'alam nk'utzin ti'j tchi' toj b'e.</para>
  <para style="q">
    <verse number="8" style="v" />Chin nelixe' mqolkyeye' toj b'e kse'n jun ttxu oso</para>
  <para style="q">matoq che'x tzpet tal,</para>
  <para style="q">ex kb'ajel nẍilu'ne' kyanmiye'.</para>
  <para style="q">Kse'n jun b'alun, axtzu' nche b'ajtch'yo'na';</para>
  <para style="q">kse'n jun txkup ajtb'aj ttzaqi'n tchi'.</para>
  <para style="q">
    <verse number="9" style="v" />Che kb'el nxitu'ne' Israel,</para>
  <para style="q">ex mix-a'lo' kklolkyeye' toj nq'ob'e'.</para>
  <para style="q">
    <verse number="10" style="v" />¿Jatzunta' kynimaqkawile' ja'lo,</para>
  <para style="q">tu'n tkolon kyoj kykyaqil nimaqkytaname'?</para>
  <para style="q">¿Jatzun ta'qe' nejenel kyeye'</para>
  <para style="q">Jaxa' kyqanine' kynimaqkawile' ex kynejele'?</para>
  <para style="q">
    <verse number="11" style="v" />Tzaj ntx'u'jile' kyi'je' tej txinq'o'ne' kynimaqkawile'</para>
  <para style="q">ex tzaj ntx'u'jile' kyi'je' tej kyel wiq'i'ne'.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Tz'ib'a'ntlte' toj jun u'j</para>
  <para style="q">tkyaqil taq'wix xtb'incha Eprayin.</para>
  <para style="q">
    <verse number="13" style="v" />Matxi' pon kmuj tu'n kyitz'je' Israel,</para>
  <para style="q">naq aju' ikyqe'ju'ye'</para>
  <para style="q">kse'nqe' k'wal xnak</para>
  <para style="q">min nb'ent kyten b'a'nxi'x tu'n kyul itz'ji.</para>
  <para style="q">
    <verse number="14" style="v" />¿Ma inxtzun che ayone'</para>
  <para style="q">Qa che nkla'ye' te tipumal kamik?</para>
  <para style="q">¿Jata' tipumala te xitul, kamik?</para>
  <para style="q">¡Kutzaja xitulteju' tnam</para>
  <para style="q">lay laqtlwe' nk'u'j kyi'je'!</para>
  <para style="q">
    <verse number="15" style="v" />B'a'n qama che b'echantle' Israel kse'n itzaj,</para>
  <para style="q">tzulu' kyq'iq' toj tjawetzq'ij,</para>
  <para style="q">aju' kyq'iq' kuw njub'in toj chq'ajlaj,</para>
  <para style="q">che tzqijelju' t-xiklil a' ex che najelju' nin a' tu'n.</para>
  <para style="q">Tzulju' kyajq'oje', che b'je'lex tiq'i'n tkyaqil kyk'uwene'.</para>
  <para style="q">
    <verse number="16" style="v" />Kb'el ntz'e'ysa'n kywitze' aj Samarya</para>
  <para style="q">tu'n tpaj sel kypa'n kyib'e' wi'je'.</para>
  <para style="q">Kche b'ajele' tu'n k'uẍtx'e'nb'il,</para>
  <para style="q">che b'eltzeq'u'n kyk'wale' twitz tx'otx'</para>
  <para style="q">ex kb'je'lex k'ab'cha'n kk'u'ju' qya ch'o'nwi'qe' toj nky'ajchaq.</para>
  <chapter number="14" style="c" />
  <para style="s1">Txokb'il tu'ntanjtzkyi'j aj Israel tuk'i'l Dyos</para>
  <para style="q">
    <verse number="1" style="v" />¡Kutanjtz kyi'je' Israel tuk'i'l Qman Dyos,</para>
  <para style="q">mache kub' tz'aqe' tu'n tpaj kyile'!</para>
  <para style="q">
    <verse number="2" style="v" />Kutanjtz kyi'je' tuk'i'l Qman Dyos.</para>
  <para style="q">Ex kymanxe' lu toj kyna'j Dyose':</para>
  <para style="q">Najsanku'ya tkyaqil qile'</para>
  <para style="q">ex k'moma ninb'il nxiqq'o'ne' teya tu'n tkyaqil tk'uja.</para>
  <para style="q">
    <verse number="3" style="v" />Lay qo kletqe' tu'n Asirya</para>
  <para style="q">expe' lay b'ent qojqe' ti'j chej.</para>
  <para style="q">Lay che okqq'o'ntlqe' qb'inchb'aj tu'n qq'ob'e' te Qdyose',</para>
  <para style="q">qu'n o'kx tuk'i'la Nman Dyos,</para>
  <para style="q">nkneta' q'uqb'ab'l tk'u'j meb'a, chechiku'ye'.</para>
  <para style="s1">Tma Qman Dyos tu'n tk'i'wlante Israel</para>
  <para style="q">
    <verse number="4" style="v" />Chi Qman Dyos:</para>
  <para style="q">Kche nq'ana'ye' toj kypi'sile';</para>
  <para style="q">Kche nk'u'jla'ye' maskye myab'a'n qe'ye' weye',</para>
  <para style="q">qu'n matxi' tz'el ntx'u'jile' kyi'j.</para>
  <para style="q">
    <verse number="5" style="v" />Chin okyele' kyeye' Israel kse'n ẍmu's,</para>
  <para style="q">atzunkye' kche b'echile', kse'nqe' b'ech liryo.</para>
  <para style="q">kche okyelu' kylok'e' kuw</para>
  <para style="q">kse'n witz Lib'ano;</para>
  <para style="q">
    <verse number="6" style="v" />okxi'x che ch'iyel tq'ob'</para>
  <para style="q">tb'anilqexi'x kse'n tq'ob' tze olib'</para>
  <para style="q">ex iky tk'ok'jal kse'n k'ute toj Lib'ano.</para>
  <para style="q">
    <verse number="7" style="v" />Che najaltle' tjaq' kolb'ilkyeye' wu'ne';</para>
  <para style="q">kche ch'iyeltzuntze' kse'n triy,</para>
  <para style="q">kche b'echale' kse'n tqan lob'j ub'a</para>
  <para style="q">ex che okyele' b'a'n kyolinjtze' kse'n b'in toj Lib'ano.</para>
  <para style="q">
    <verse number="8" style="v" />Kkyma'tzuntze' Eprayin kjalu: ¿Mixti'tlqe' tajb'en witzleb' qe?</para>
  <para style="q">¡Ayinwe' chin ka'yilte ex chin xq'uqilteju' ntaname'!</para>
  <para style="q">Ikyqinwe' kse'n junwi' tzaj kukx ttenju' cha'x,</para>
  <para style="q">ex atzuntzu' che witzalaju' ntaname' wu'ne'.</para>
  <para style="s1">B'ajsb'il</para>
  <para style="q">
    <verse number="9" style="v" />Aye' ati kynab'l ex k'atzqe'</para>
  <para style="q">tu'n telkynik' ti'ju' yol lu:</para>
  <para style="q">Tzinun qe'kye' tb'e Qman Dyos,</para>
  <para style="q">ex aye' tnik'alkyi'j nche b'et toj;</para>
  <para style="q">aye'tzunkye' b'inchal il nche' jaw tz'aq toj.</para>
</usx>