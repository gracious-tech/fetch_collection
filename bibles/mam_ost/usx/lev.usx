<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="LEV" style="id">LEV.TXT Febrero 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Levítico</para>
  <para style="toc3">Lv</para>
  <para style="toc2">Lv</para>
  <para style="toc1">U'j kye aj Leb'i (Levítico)</para>
  <para style="mt1">U'J KYE AJ LEB'I</para>
  <para style="mt2">(Levítico)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Aju' yol Leb'itiko atz'elpuna'ju' Ati toklen, mujqa, kye tyajajil Leb'i. Aye'ju' tyajajil Leb'i ati kyoklen te pale mujqa onil kyoju' ajb'eb'l toj k'u'lb'il twitz Qman Dyos ex ka'yilteju' tja Dyos. Okq'o'n tb'iju' u'j lu ikju', qu'n atzu' tku'xa'qe'ju' nuk'b'il ex chaq'b'il kyi'ju' aq'untl toj tja Qman Dyos, nuk'b'il toj k'u'lb'il, chaq'b'il kyi'ju' tu'me'l ẍtilsab'l, e'nimaq ninq'ij twitz Dyos ex kyi'ju' k'a'chb'il b'a'n kywayet ex min q'o'n tu'n kywayet.</para>
  <para style="ip">A tnab'lxi'x u'j ja'lu aju' xjanb'ilte Qman Dyos nkyk'lu'n aj Israel exju' tu'n kyb'inchante ttanam tu'n tten kychwinqlal ẍtilun, kse'nxte Dyos xjan te. Nyolin kyoju' b'a'npun aq'pub'lteju' u'j lu kyi'ju' chaq'b'il kyi'j chojb'il ex oyaj (1.1—7.38), tej tokq'o'n Aaron kyuk'i'lju' tk'wal toj oklenj te pale (8.1—10.20), chaq'b'il kyi'j alkyeqe' tz'il ex tu'me'l tu'n kyẍtilset (11.1—15.33), kse'n tu'n tik'seta'ju' q'ij te najsb'il il (16.1-34), e'chaq'b'il ti'ju' xjansb'ilteju' kychwinqlal toj k'u'lb'il. Tojtzu'n u'j lu (19.18) tzaja' tna'n Qman Jesukrist jun nimaq chaq'b'il (Mat. 22.39), aju' tu'n qk'u'jlante qwnaqil.</para>
  <chapter number="1" style="c" />
  <para style="s1">Chojb'il k'ok'sb'il</para>
  <para style="p">
    <verse number="1" style="v" />Txkonjtz Moyses tu'n Qman Dyos toju' Ja te Mujb'ab'ltib'il ex tzaj tma'n te:</para>
  <para style="pi">
    <verse number="2" style="v" />Yolina kyuk'i'l aj Israel, q'manxa kye qa ati jun matzaj tiq'i'n toyaj kyi'ju' alu'mj weye', ati tu'n ttzaj tiq'i'n kyi'ju' twakyix mujqa kyi'ju' trit.</para>
  <para style="pi">
    <verse number="3" style="v" />Qa kyi'ju' twakyix sela'ju' alu'mj kb'eltq'o'n te chojb'il k'ok'sb'il, jun tman wakx mixti' ttzakajil. Tu'ntzun tk'met te, ati tu'n tkub' tq'o'n nwitze' ttziju' Ja te Mujb'ab'ltib'il, <verse number="4" style="v" />kb'el tq'o'nju' tq'ob' tib'aj twi'ju' alu'mj, iktzun kk'metela' alu'mju' tu'n tnajsetju' til. <verse number="5" style="v" />Kb'el tb'yo'nju' tman wakx nwitze', aye'tzuntlju' pale tk'wal Aaron ajtkub' kyq'o'nju' chik' nwitze', kb'el kywitxk'a'n tib'aj ex ti'jileju' q'olb'eb'l ati ttziju' Ja te Mujb'ab'ltib'il. <verse number="6" style="v" />Aju' kb'el q'onte alu'mj te chojb'il k'ok'sb'il, k'elel tiq'i'nju' ttz'umal, kb'ajel tpẍu'ntzuntz, <verse number="7" style="v" />aye'tzunju' pale kb'el kynk'u'nju' si tib'aju' q'olb'eb'l ex k'okyil kyq'o'n tq'aq'al, <verse number="8" style="v" />tu'ntzun tkub' kyq'o'nju' alu'mj pẍu'nl exju' twi' tib'aj, exju' unt kyi'ju' t-xqintxa. <verse number="9" style="v" />Aju' kb'el q'onte chojb'il k'ok'sb'il, kche ttxja'ju' t-xqintxa exju' tkux alu'mj, atzunju' pale kb'el tz'e'ysante tkyaqil tib'aj q'olb'eb'l te jun oyaj tz'e'ysa'n tb'anil tk'ok'jal weye'.</para>
  <para style="pi">
    <verse number="10" style="v" />Qatzun kyi'ju' trit mujqa kyi'ju' tchib' sela'ju' alu'mj kb'eltq'o'n te chojb'il k'ok'sb'il, tmanju' ktzajel tiq'i'n mixti' ttzakajil, <verse number="11" style="v" />ex kb'el tb'yo'n toj tnayajkya'j teju' q'olb'eb'l nwitze'. Aye'tzunju' pale tk'wal Aaron kb'el kywitxk'a'n tchk'elju' alu'mj tib'aj ex ti'jeleju' q'olb'eb'l; <verse number="12" style="v" />ex kb'el tpẍu'nju' alu'mj toj tx'naji'n, atzunju' pale kb'el nk'unteju' alu'mj pẍu'nl tib'aju' si ink'ant tib'aj q'olb'eb'l junx tuk'i'lju' twi' exju' unt kyi'ju' t-xqintxa. <verse number="13" style="v" />Yajxi'tzuntel aju' kb'el q'onte chojb'il k'ok'sb'il kb'ajel ttxjo'nju' t-xqintxaju' alu'mj exqe'ju' tkux, atzunju' pale kb'el tz'e'ysante tkyaqil tib'aj q'olb'eb'l te jun oyaj k'ok'j weye'.</para>
  <para style="pi">
    <verse number="14" style="v" />Qatzun pich'ju' alu'mj kb'eltq'o'n te chojb'il k'ok'sb'il te ninb'ilweye', jun palomste' ktzajel tiq'i'n mujqa xlak'uk'. <verse number="15" style="v" />Kb'eltq'o'n paleju' pich' tib'aju' q'olb'eb'l: k'elel tiq'i'nju' twi' ex k'elel tiq'i'nju' tchk'el toj jun plaj teju' q'olb'eb'l, yajxi'tzuntel kb'el ttz'e'ysa'n t-xmilalju' pich' tib'aj. <verse number="16" style="v" />K'elel tiq'i'nju' twab'l exju' ati toj ex kb'eltq'o'n toju' plaj tjawetzq'ij teju' q'olb'eb'l ja inkub'a' q'eta'ju' tza'j; <verse number="17" style="v" />kb'elex taq'pu'n ttzitk'u'ju' pich' tu'n t-xi' aq'puj toj kab'e', kb'el ttz'e'ysa'ntzuntz tib'aju' si tib'aj q'olb'eb'l te chojb'il k'ok'sb'il, te jun oyaj tz'e'ysa'n tb'anil tk'ok'jal weye', chiku'ya kye, chi Qman Dyos te Moyses.</para>
  <chapter number="2" style="c" />
  <para style="s1">Oyaj twitz awal k'ok'e'kywitz</para>
  <para style="pi">
    <verse number="1" style="v" />Qama tzul jun xjal tuk'i'l toyaj twitz awal nwitze', arin tb'anilxi'x tu'n ttzaj tiq'i'n ex kjawix tq'o'n aseyt ex sturak tib'aj; <verse number="2" style="v" />kxel tiq'i'ntzuntz kyeju' pale tk'wal Aaron, juntzun kyxol kjawil q'inte jun jot arin tuk'i'l aseyt junx tuk'i'lju' sturak, kb'el ttz'e'ysa'ntzuntz tib'aj q'olb'eb'l te jun oyaj tz'e'ysa'n te nab'ab'l tb'anil tk'ok'jal weye'. <verse number="3" style="v" />Atzunju' kjel tpa'ntib', qu'n xjan na' kyxolju' oyaj inkub' tz'e'yset te ninb'ilweye', kxe'l te Aaron kyuk'i'lju' tyajajil.</para>
  <para style="pi">
    <verse number="4" style="v" />Qama txi' kyq'o'n jun kyoyaje' twitz awal tzq'ajsa'n toj chuj, kyq'onxe' muqintl ti'j tb'anil arin xyuq'i'n tuk'i'l aseyt mixti' ttx'amal, mujqa xwok' muqin mixti' ttx'amal witxk'a'n aseyt kyi'j.</para>
  <para style="pi">
    <verse number="5" style="v" />Qatzun twitz awalju' kyoyaje' tzq'ajsa'n toj sarten, ati tu'n kyb'inchanteye' tu'n tb'anil arin xyuq'i'n tuk'i'l aseyt mixti' ttx'amal; <verse number="6" style="v" />kb'ajel kypiẍu'ne' ex kb'ajel kywitxk'a'ne' tu'n aseyt, qu'n oyaj te twitz awal.</para>
  <para style="pi">
    <verse number="7" style="v" />Qatzun twitz awalju' kyoyaje' tzq'ajsa'n toj k'wil, ati tu'n tb'inchet tu'n tb'anil arin ex tuk'i'l aseyt. <verse number="8" style="v" />Ajtzun tb'aj kyb'incha'nju'ye' oyaj kyuk'i'lju' junjunl ti'xti' lu, ktzajel kyiq'i'ntzuntze' nwitze' ex kxel kyq'o'ne' teju' pale, atzunte kxel iq'inte tk'etz q'olb'eb'l. <verse number="9" style="v" />Atzuntzu' kjawitza' tiq'i'n pale ch'i'n tu'n tkub' ttz'e'ysa'n tib'aj q'olb'eb'l te jun oyaj tz'e'ysa'n te nab'ab'l tb'anil tk'ok'jal weye'. <verse number="10" style="v" />Atzunju' kjel tpa'ntib' ti'ju' oyaj, aju' jun tnej xjan kyxolju' oyaj inche tz'e'yset te ninb'ilweye', kxel q'et te Aaron ex kyeju' tyajajil.</para>
  <para style="pi">
    <verse number="11" style="v" />Mixti'xte jun ttx'amal oyaj twitz awal kb'elex kyq'o'ne' aju' intzaj kyq'o'ne' weye', expe' mixti'x jun ttx'amal ex myel kb'el tz'e'yset te oyaj te ninb'ilweye'. <verse number="12" style="v" />B'a'nte' tu'n tkub' kyq'o'ne' ttx'amal ex myel nwitze' te jun oyaj tnejel twitz awal, naqtzun o'kx mya te jun oyaj tu'n tkub' tz'e'yset te jun tb'anil tk'ok'jal.</para>
  <para style="pi">
    <verse number="13" style="v" />Ilti'j kxel kyq'o'ne' atz'an kyoju' kyoyaje' twitz awal, ex lalun tzaj kyq'o'ne' kyoyaje' twitz awal mixwitti' atz'an toj teju' yol kyejni b'entti'j wu'ne' ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="14" style="v" />Qama tzaj kyq'o'ne' kyoyaje' tnejel twitz awal weye', ate ktzajel kyq'o'nju'ye' aju' matxi' tijin twitz, wensi'n ex pa'n twi'. <verse number="15" style="v" />Kb'el kyqo'ne' aseyt tib'aju' kyoyaje' ex kb'el kyq'o'ne' sturak tib'aj, qu'n oyaj twitz awal. <verse number="16" style="v" />Kb'el kytz'e'ysa'ntzun paletz ch'i'n twitz awal pa'n twi' ex aseyt junx tuk'i'l tkyaqilju' sturak, k'okeltzuntz te jun oyaj te nab'ab'l tz'e'ysa'n te ninb'ilweye', chiku'ya kye, chi Qman Dyos te Moyses.</para>
  <chapter number="3" style="c" />
  <para style="s1">Chojb'il te mujb'ab'ltib'il</para>
  <para style="pi">
    <verse number="1" style="v" />Qa ati jun makub' tq'o'n chojb'il te mujb'ab'ltib'il nwitze', tman wakx mujqa ttxu wakx kyi'ju' talu'n, a kb'el tq'o'nju' mixti' ttzakajil. <verse number="2" style="v" />Aju' kb'el q'onteju' oyaj kb'eltq'o'n tq'ob' tib'aj twi'ju' alu'mj, kb'el tb'yo'ntzuntz ttziju' Ja te Mujb'ab'ltib'il. Aye'tzuntlju' pale kxel kywitxk'a'nju' chik' tib'aj ex ti'jile q'olb'eb'l.</para>
  <para style="pi">
    <verse number="3" style="v" />Alkyete makub' tq'o'n toyaj alu'mj te jun chojb'il te mujb'ab'ltib'il, kb'el tq'o'nju' unt tok ti'j t-xqintxaju' alu'mj te jun oyaj tz'e'ysa'n nwitze', <verse number="4" style="v" />exqe'ju' tchinaq', exju' unt twittze'lti'j, exju' unt tok kyi'ju' twab'l, ju' k'elel tiq'i'n junx kyuk'i'lju' tchinaq'. <verse number="5" style="v" />Kb'el kytz'e'ysa'n pale tkyaqil ja'lu tib'aj q'olb'eb'l, junx tuk'i'lju' alu'mj ju' kb'el tz'e'yset tib'aju' si in k'ent te jun oyaj tz'e'ysa'n tb'anil tk'ok'jal weye'.</para>
  <para style="pi">
    <verse number="6" style="v" />Qa ati jun makub' tq'o'n jun talu'n kyi'ju' trit te jun chojb'il te mujb'ab'ltib'il nwitze', jun tman mujqa jun ttxu mixti' ttzakajil kb'eltq'o'n. <verse number="7" style="v" />Qama kub' tq'o'n jun qpoj tman rit, ajtkub' tq'o'n nwitze' <verse number="8" style="v" />kb'eltq'o'n tq'ob' tib'aju' twi', kb'el tb'yo'ntzuntz ttziju' Ja te Mujb'ab'ltib'il. Aye'tzunju' pale kb'el kywitxk'a'nju' chik' tib'aj ex ti'jileju' q'olb'eb'l.</para>
  <para style="pi">
    <verse number="9" style="v" />Alkye makub' tq'o'n alu'mj te jun chojb'il te mujb'ab'ltib'il, kb'eltq'o'n unt exju' tje elni joyet twitzxi'x tb'aqil, exju' unt tok kyi'ju' t-xqintxa te jun oyaj tz'e'ysa'n nwitze', <verse number="10" style="v" />kyuk'i'lju' kab'e' tchinaq' exju' unt tok kyi'j exju' unt twittze'lti'j, exju' unt tok kyi'ju' twab'l, ju' k'elel tiq'i'n junx kyuk'ilju' tchinaq'. <verse number="11" style="v" />Kb'el ttz'e'ysa'ntzun paletz tkyaqil ja'lu tib'aj q'olb'eb'l te jun oyaj k'a'chb'il tz'e'ysa'n te ninb'ilweye'.</para>
  <para style="pi">
    <verse number="12" style="v" />Qatzun ttxu chib' kb'eltq'o'n nwitze', <verse number="13" style="v" />kb'eltq'o'n tq'ob' toj twi', kb'el tb'yo'ntzuntz ttziju' Ja te Mujb'ab'ltib'il, aye'tzuntlju' pale kb'el kywitxk'a'nju' chik' tib'aj ex ti'jileju' q'olb'eb'l.</para>
  <para style="pi">
    <verse number="14" style="v" />Aju' kb'el q'onte alu'mj, ate kb'el tq'o'nju' ti'ju' oyaj tz'e'ysa'n te ninb'ilweye' aju' unt tok kyi'ju' t-xqintxa, <verse number="15" style="v" />exju' kab'e' tchinaq', exju' unt tok kyi'j, exju' unt twittze'lti'j, exju' unt tok ti'ju' twab'l, ju' k'elel tiq'i'n junx tuk'i'lju' tchinaq'. <verse number="16" style="v" />Tkyaqiltzun ja'lu kb'el ttz'e'ysa'nju' pale tib'aju' q'olb'eb'l te jun oyaj k'a'chb'il tz'e'ysa'n, tb'anil tk'ok'jal. Tkyaqilju' unt weye' ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="17" style="v" />Jun kawb'ilte' lu kjelten tejumajx kyeye' ex kye kyk'wale' jaxjaku' mache'xa'ye': mixti' tu'n t-xi' kych'yo'ne' unt exju' chik', chiku'ya kye, chi Qman Dyos.</para>
  <chapter number="4" style="c" />
  <para style="s1">Chojb'il tu'ntpaj il</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">
    <verse number="2" style="v" />Qa ati jun xb'inchan il ex mya xima'nju' tu'n, tu'n tik' tib'aju' nchaq'b'ile', a kb'inchetel ja'lu:</para>
  <para style="pi">
    <verse number="3" style="v" />Qa aju' kynejel pale xb'inchan il ex makub' tz'aqju' til tib'aju' tnam, ati tu'n tkub' tq'o'n jun tman wakx mixti' ttzakajil nwitze', te jun chojb'il tu'n tpaju' il xtb'incha. <verse number="4" style="v" />Ktzajel tiq'i'n nwitze' ttziju' Ja te Mujb'ab'ltib'il, atzuntzu' kb'el tq'o'na' tq'ob' tib'aj twi'ju' wakx, kb'el tb'yo'ntzuntz nwitze'. <verse number="5" style="v" />Yajxi'tzuntel axte ktzajel q'inte ch'i'n tchk'elju' wakx ex kxe'l tiq'i'n toju' Ja te Mujb'ab'ltib'il; <verse number="6" style="v" />atzuntzu' kb'elixa' tq'o'nju' tq'ob' toju' chik', ex kb'el twitxk'a'n wuq maj nwitze' tu'me'lju' xb'alun teju' ja xjan. <verse number="7" style="v" />Ex k'okel t-sun ch'i'nju' chik' kyi'ju' tuk'a q'olb'eb'l tz'e'ysb'il sturak, ju' ati nwitze' toju' Ja te Mujb'ab'ltib'il, atzunju' txqantl chik' kb'el tqo'n t-xeju' q'olb'eb'l tz'e'ysb'il chojb'il k'ok'sb'il, ju' ati ttziju' Ja te Mujb'ab'ltib'il. <verse number="8" style="v" />Yajxi'tzuntel k'elel tiq'i'n tkyaqilju' unt kyi'j t-xqintxaju' tal tman wakx kb'eltq'o'n te chojb'il tu'n tpaj il, <verse number="9" style="v" />ex kyi'ju' kab'e' tchinaq' exju' unt tok kyi'j, exju' ati twittze'lti'j, exju' unt ati kyi'ju' twab'l, ju' ati tu'n kyel tiq'i'n junx kyuk'i'lju' tchinaq', <verse number="10" style="v" />kse'n in b'inchet ti'ju' tman wakx inkub' q'et te chojb'il te mujb'ab'ltib'il, kb'el ttz'e'ysa'ntzun paletz tib'aju' q'olb'eb'l tz'e'ysb'il chojb'il k'ok'sb'il. <verse number="11" style="v" />Atzu'n ttz'umalju' tal tman wakx ex tkyaqilju' tchib'jil, tuk'i'lju' twi', tkux, t-xqintxa exju' ttxa <verse number="12" style="v" />—mujqa tkyaqilju' wakx—, k'elex tiq'i'n ti'jxi'ju' najb'il toj jun plaj ẍtilun jankub' q'eta' tza'j, tib'ajtzunju' txqan tza'j kb'el tb'incha'n si, k'okel tq'o'ntzun tq'aq'altz.</para>
  <para style="pi">
    <verse number="13" style="v" />Qatzun kykyaqil aj Israel makyb'incha jun il ex myate xima'nju' kyu'n, exqa mix-a'lo'x jun sel tnik' ti'ju' kyb'inchb'aj mya q'o'n tu'n kyb'inchante toju' nchaq'b'ile' ex iktzu'n sela' yal kyil, <verse number="14" style="v" />ajtzun tb'injtzju' kyil xkyb'incha, ati tu'n tkub' tq'o'n teyle junjun jun qpoj tman wakx te chojb'il tu'n tpaj il. Kxe'l kyiq'i'n twitzju' Ja te Mujb'ab'ltib'il, <verse number="15" style="v" />aye'tzunju' tijwnaq te tnam kb'el kyq'o'n kyq'ob' tib'aj twi'ju' qpoj tman wakx, nwitze', axtzuntzu' kb'ela' kyb'yo'n. <verse number="16" style="v" />Atzuntlju' kynejel pale kxe'l tiq'i'n ch'i'n tchk'elju' qpoj tman wakx toju' Ja te Mujb'ab'ltib'il, <verse number="17" style="v" />kb'elex tq'o'n twitq'ob' toju' chik' ex kxel twitxk'a'n wuq maj nwitze' twitzju' xb'alun te aq'pub'l. <verse number="18" style="v" />Ex k'okel t-sun ch'i'nju' chik' kyi'j tuk'a q'olb'eb'l, ju' ati nwitze' toju' Ja te Mujb'ab'ltib'il. Atzunju' txqantl chik' kb'el tqo'n t-xeju' q'olb'eb'l tz'e'ysb'il chojb'il k'ok'sb'il, ju' ati ttziju' Ja te Mujb'ab'ltib'il. <verse number="19" style="v" />Ex k'elel tiq'i'n t-untilju' qpoj tman wakx ex kb'el ttz'e'ysa'n tib'aju' q'olb'eb'l; <verse number="20" style="v" />axte kb'inchetilju' ti'ju' qpoj tman wakx lu kse'nx nb'inchet ti'j qpoj tman wakx nkub' q'et te chojb'il tu'n tpaj il; ikytzu'n kb'ela' nk'u'je' tu'nju' pale, kb'el nnajsa'ntzun kyiltze'. <verse number="21" style="v" />K'elextzun tiq'i'n qpoj tman wakxtz ti'jxi' najb'il, kse'nxju' nb'inchet ti'ju' tnejel qpoj tman wakx, qu'n a chojb'ilju' tu'n tpaj kyilju' tnam.</para>
  <para style="pi">
    <verse number="22" style="v" />Qa ati jun nejenel matb'incha jun il min q'o'n tu'n tb'inchet toj nchaq'b'ile', jun aj il te' maskye mixtoqti' xima'n tu'n, tu'n tb'inchante. <verse number="23" style="v" />Ajtzun teltnik' ti'ju' il xtb'incha, kxe'l tiq'i'n jun chib' mixti' ttzakajil te chojb'il tu'n tpaju' til. <verse number="24" style="v" />Kb'eltq'o'n tq'ob' tib'aj twi'ju' chib' ex kb'el tb'yo'n nwitze' ja inche kub'a' b'yeta'ju' alu'mj tu'n kykub' tz'e'yset, qu'n chojb'ilte' tu'n tpaj il. <verse number="25" style="v" />Atzunju' pale kjawil tiq'i'n ch'i'n tchk'elju' alu'mj xkub' q'et te chojb'il tu'n tpaj il tu'n twitq'ob', k'okel t-suntzuntz kyi'j tuk'a q'olb'eb'l tz'e'ysb'il chojb'il k'ok'sb'il, atzu'n txqantl chik' kb'el tqo'n t-xe q'olb'eb'l. <verse number="26" style="v" />Ex kb'el ttz'e'ysa'n tkyaqilju' unt tib'aj q'olb'eb'l, kse'nxju' in b'inchet ti'ju' unt teju' chojb'il te mujb'ab'ltib'il. Iktzu'n kb'ela' nk'u'je' tu'nju' pale, kb'el nnajsa'ntzun til nejeneltze'.</para>
  <para style="pi">
    <verse number="27" style="v" />Qama b'inchan il jun xjal prow ex mya xima'nju' tu'n, tu'ntzunju' lu matz'elyal ati tpaj, qu'n min q'o'n toj nchaq'b'ile', <verse number="28" style="v" />ajtzun teltnik' ti'ju' il xtb'incha, kxe'l tiq'i'n jun ttxu chib' mixti' ttzakajil te chojb'il tu'n tpaju' il xtb'incha. <verse number="29" style="v" />Kb'el tq'o'nju' tq'ob' tib'aj twi'ju' alu'mj, ju' kb'eltq'o'n te chojb'il tu'n tpaj il, kb'el tb'yo'ntzuntz ja inkub' q'eta' chojb'il k'ok'sb'il. <verse number="30" style="v" />Atzunju' pale kjawil tiq'i'n ch'i'n chik' tu'n twitq'ob' ex k'okel t-sun kyi'j tuk'a q'olb'eb'l tz'e'ysb'il chojb'il k'ok'sb'il, atzunju' txqantl chik' kb'el tqo'n t-xeju' q'olb'eb'l. <verse number="31" style="v" />Ex ikx k'elel tiq'i'n tkyaqilju' unt ti'j kse'n inel iq'et ti'ju' chojb'il te mujb'ab'ltib'il ex kb'el ttz'e'ysa'n unt lu tib'aju' q'olb'eb'l te jun tk'ok'jal tb'anilxi'x weye'. Iktzu'n kb'ela' nk'u'je' tu'nju' pale, ex kb'el nnajsa'ne' tilju' xjal lu.</para>
  <para style="pi">
    <verse number="32" style="v" />Qatzun aju' xjal lu matzaj tiq'i'n jun rit te chojb'il tu'n tpaju' il, jun ttxu mixti' ttzakajil ktzajel tiq'i'n. <verse number="33" style="v" />Kb'el tq'o'nju' tq'ob' tib'aj twi'ju' rit, kb'el tb'yo'ntzuntz te jun chojb'il tu'n tpaj il ja inche kub'a' b'yeta'ju' alu'mj tu'n kytz'e'yset. <verse number="34" style="v" />Atzunju' pale kjawil tiq'i'n ch'i'n tchk'elju' alu'mj xkub' q'et te chojb'il tu'n tpaj il tu'n twitq'ob' ex k'okel t-sun kyi'j tuk'a q'olb'eb'l tz'e'ysb'il chojb'il k'ok'sb'il, atzunju' txqantl chik' kb'el tqo'n t-xeju' q'olb'eb'l. <verse number="35" style="v" />Ex k'elel tiq'i'n tkyaqilju' unt ti'j kse'n inel iq'et ti'ju' qpoj tman wakx nkub' q'et te chojb'il te mujb'ab'ltib'il, ex kb'el ttz'e'ysa'n unt tib'aj q'olb'eb'l junx kyuk'i'lju' oyaj tz'e'ysa'n te ninb'ilweye'. Ikytzu'n kb'ela' nk'u'je' tu'nju' pale, kb'el nnajsa'ne' tilju' xjal lu.</para>
  <chapter number="5" style="c" />
  <para style="s1">Nuk'b'il ti'j chojb'il tu'ntpaj il</para>
  <para style="pi">
    <verse number="1" style="v" />Qa ati jun xjal matxi txko'n tu'n t-xi' tziyal ti'j jun ti'xti' matil mujqa matb'i, extzunqa min xtaj tu'n ttziyante, ilju' intb'incha'n ex k'okel q'et te til.</para>
  <para style="pi">
    <verse number="2" style="v" />Qa ati jun xjal matxi ttzyu'n jun ti'xti' tz'il, jun kyimni txkup tz'il, tojk'ul txkup mujqa aluma'n, mujqa txkup in qittinje twitz tx'otx', kjel tz'ilix tu'n ex ati tpaj, maskyepe' min xtil.</para>
  <para style="pi">
    <verse number="3" style="v" />Qa ati jun xjal matxi ttzyu'n ttz'ilil xjal ex min xtil, exqa yajxi'tl sel tnik' ti'j, ati tpaj.</para>
  <para style="pi">
    <verse number="4" style="v" />Qa ati jun xjal matz'el tma'n jun tyol toj ojqelb'il tu'n tb'inchante jun b'a'n mujqa jun myab'a'n, extzunqa yajxi'tl sel tnik' ti'ju' xttziya ju' min xima'ntoq tu'n, ati tpaj.</para>
  <para style="pi">
    <verse number="5" style="v" />Aju' xjal matz'elyal toj alkyexku'ju' il lu, ilti'j tu'n tjatz tpa'n til <verse number="6" style="v" />ex kb'eltq'o'n jun ttxu rit mujqa jun ttxu chib' te chojb'il nwitze' tu'n tpaju' il xtb'incha, tu'ntzunju' chojb'il lu kchjetel tilju' xjal tu'nju' pale, kb'el najsettzun tiltz.</para>
  <para style="pi">
    <verse number="7" style="v" />Qatzun mixti' tu'me'l tu'n tlq'onte jun qpoj tman rit, ktzajel tiq'i'n jun muj xlak'uk' mujqa jun muj tal paloms tu'n tpaju' il xtb'incha: jun te chojb'il tu'n tpaj il, atzu'n juntl te chojb'il k'ok'sb'il. <verse number="8" style="v" />Che kxe'l tq'o'n teju' pale, atzunju' pale nejl kb'el tq'o'nju' chojb'il tu'n tpaj il, k'elel tiq'i'n twi'; <verse number="9" style="v" />ex kxel twitxk'a'n ch'i'n tchk'elju' alu'mj te chojb'il tu'n tpaj il toj jun plaj teju' q'olb'eb'l, atzunju' txqantl chik' k'elel tytz'o'n t-xeju' q'olb'eb'l, qu'n chojb'il tu'n tpaj il. <verse number="10" style="v" />Atzunju' tkab' kb'eltq'o'n te chojb'il k'ok'sb'il, kse'nxju' nuk'b'il q'ma'ntl; iktzu'n kchjetela' tilju' xjal tu'nju' pale, knajseteltzun tiltz.</para>
  <para style="pi">
    <verse number="11" style="v" />Qatzun mixti'x tu'me'l tu'n tlq'onte jun muj xlak'uk' mujqa jun muj tal paloms, ktzajel tiq'i'n kyaje' lib'r tk'i' nik'jan tb'anil arin te jun oyaj tu'n tpaju' til, mixti' tu'n tkux tq'o'n aseyt mujqa sturak tib'aj, qu'n jun oyajte' tu'n tpaj il. <verse number="12" style="v" />Kxe'l tq'o'n teju' pale, atzunju' pale kjawil tiq'i'n jun jot te nab'ab'l ex kb'el ttz'e'ysa'n tib'aju' q'olb'eb'l junx kyuk'i'lju' oyaj inche tz'e'yset te ninb'ilweye'. Jun oyajte' tu'n tpaj il, <verse number="13" style="v" />tu'ntzun tchjet alkyexku' il xtb'inchaju' xjal tu'nju' pale, kb'el najsettzun tiltz. Atzunju' minti' xb'aj ti'ju' oyaj twitz awal kxe'l teju' pale, chiku'ya kye, chi Qman Dyos te Moyses.</para>
  <para style="s1">Chojb'il tu'ntpaj kyil aj Israel</para>
  <para style="p">
    <verse number="14" style="v" />Tzaj tma'n Qman Dyos te Moyses ikjalu:</para>
  <para style="pi">
    <verse number="15" style="v" />Alkyete naqx myanim xb'inchan il tu'n qa min xkub' tq'o'n tkyaqilju' oyaj tu'n tq'onte weye', ati tu'n ttzaj tiq'i'n jun tman rit mixti' ttzakajil kyi'ju' talu'n te jun chojb'il tu'n tten b'a'n nwitze'. Ati tu'n toktq'o'na twi'ju' tman rit kse'nxju' tajlal tu'n saqpwaq, kse'nxju' malb'il q'ma'n toju' ja xjan kyeju' oyaj tu'n kytene' b'a'n wuk'i'le'. <verse number="16" style="v" />Aju' xjal lu ati tu'n tchjonte twi'ju' xkyej tiq'i'n ti'ju' oyaj xjansa'n nwitze', tuk'i'l jun tjwe'yi'n tnejtl tib'ajxi'ju' lu, aju' tajlal lu kxe'l tq'o'n teju' pale. Tu'ntzunju' tman rit kb'eltq'o'n te chojb'il tu'n tten b'a'n wuk'i'le', oktk'ma' najsb'il til tu'n pale, knajseteltzun tiltz.</para>
  <para style="pi">
    <verse number="17" style="v" />Qa ati jun xjal mab'inchan il tu'nju' matb'incha jun myab'a'n min tma'n toj nchaq'b'ile', maskye minti' sel tnik', ati tpaj ex kjelten myab'a'n tten wuk'i'le'. <verse number="18" style="v" />Qu'mtzun ati tu'n ttzaj tiq'i'n jun tman rit mixti' ttzakajil kyi'ju' trit, ati tu'n tmanteya jte' twi', ex kxe'l tiq'i'n teju' pale te jun chojb'il tu'n tten b'a'n wuk'i'le', tu'ntzun tk'monteju' xjal lu najsb'ilteju' til, ju' min xima'ntoq tu'n, tu'n tb'inchante, knajseteltzun tiltz. <verse number="19" style="v" />Jun chojb'ilte' tu'n tten b'a'n wuk'i'le', qu'n myab'a'n ttenju' xjal lu nwitze', chi Dyos.</para>
  <chapter number="6" style="c" />
  <para style="s1">Chojb'il tu'ntpaj sb'ub'l</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj tma'n Qman Dyos te Moyses kjalu:</para>
  <para style="pi">
    <verse number="2" style="v" />Qa ati jun xjal mab'inchan il nwitze' tu'nju' makub' t-sb'u'n twnaqil ti'j jun ti'xti' makyej oqxena'n te mujqa matxi majina'n te, mujqa matz'el telq'a'n jun ti'xti' te, <verse number="3" style="v" />mujqa makub' tewa'n qama tz'el yal jun ti'xti' tu'n, ju' xini tz'aqi, mujqa tu'nju' mattziya jun yol mya ax, (kyu'n alchaqxkyeku' ti'xti' lu inqo b'inchana' il), <verse number="4" style="v" />ati tpaj tu'nju' il lu. Qu'mtzun ati tu'n t-xi' tanjsa'n ti'ju' ti'xti' xkub' telq'a'n, mujqa naq sel t-xk'a'yu'n, mujqa aju' kyajni oqxeni'n te mujqa aju' naq sel yal tu'n, <verse number="5" style="v" />mujqa naq alkyexku' ti'xti'ju' mattziya jun tyol ti'j mya ax. Ati tu'n t-xi' tanjsa'n ti'j tkyaqil teju' tajaw tuk'i'l jun tjwe'yi'n tnej, aj tq'onteju' chojb'il tu'n tten b'a'n wuk'i'le'. <verse number="6" style="v" />Atzunju' chojb'il kb'eltq'o'n nwitze' jun tman rit mixti' ttzakajil, aya kq'malte jte' twi'ju' rit ktzajel tiq'i'n kyi'ju' trit, kxel tq'o'ntzuntz teju' pale te chojb'il tu'n tten b'a'n wuk'i'le'. <verse number="7" style="v" />Iktzu'n kchjetela' tilju' xjal tu'nju' pale nwitze' ti'j alkyexku' ti'xti' lu ja xb'inchana' il, ex kb'el najsetju' til, chi Dyos.</para>
  <para style="s1">Chik'b'ab'l kyi'j chojb'il k'ok'sb'il</para>
  <para style="p">
    <verse number="8-9" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n kyb'ajx tma'nju' nuk'b'il kyi'ju' chojb'il k'ok'sb'il, te Aaron ex kyeju' tk'wal ikjalu:</para>
  <para style="pi">Kjel q'etju' alu'mj te chojb'il tib'aj ttxalq'aq' tib'aj q'olb'eb'l toj tkyaqil qonik'an tzmaxi'j ajtb'aj tu'n q'aq'. <verse number="10" style="v" />K'okyel tq'o'n pale t-xb'alun ex tkalsonsiy sed, k'okyil tentzuntz jtolte ttza'jilju' alu'mj tib'aj q'olb'eb'l, ex kb'eltq'o'n ttx'u'k q'olb'eb'l. <verse number="11" style="v" />Yajxi'tzuntel k'elel tch'ixpu'n t-xb'alun, kxel tiq'i'nju' tza'j ex kb'eltq'o'n toj jun tkub'el ẍnu'l ti'jxi' kynajb'ile'.</para>
  <para style="pi">
    <verse number="12" style="v" />Aju' q'aq' ink'ant tib'aj q'olb'eb'l mixti' tu'n tyupj. Ati tu'n tokxtq'o'n pale t-siyilju' q'aq' tkyaqil prim ex tu'n tokx tb'incha'nju' alu'mj tib'a q'aq', ju' ktz'e'ysetel, ex kb'el tz'e'ysetju' t-until chojb'il te mujb'ab'ltib'il tib'aj q'olb'eb'l. <verse number="13" style="v" />Ati tu'n tk'antju' q'aq' kukxju' tib'aj q'olb'eb'l. Mixti' tu'n tyupj, chi Dyos te Moyses.</para>
  <para style="s1">Chik'b'ab'l ti'j oyaj twitz awal k'ok'e'kywitz</para>
  <para style="pi">
    <verse number="14" style="v" />Aye'ju' xnaq'tzb'il lu nyolin kyi'ju' oyaj twitz awal: Kb'el kyq'o'n pale tib'aju' q'olb'eb'l nwitze'. <verse number="15" style="v" />Juntzun kyxol kjawil tiq'i'n jun txab' arin, ju' kub'ni q'o'n te oyaj ex ch'i'n aseyt, tuk'i'ltzu'n tkyaqilju' sturak ati tmoj oyaj, che kb'el ttz'e'ysa'n tib'aju' q'olb'eb'l te jun oyaj tz'e'ysa'n te nab'ab'l tb'anil tk'ok'jal weye'. <verse number="16" style="v" />Atzunju' lay b'aj ti'ju' oyaj kxel kywan Aaron kyuk'i'lju' tk'wal, mixti' ttx'amal ex toj jun najb'il xjansa'n twitpenju' Ja te Mujb'ab'ltib'il. <verse number="17" style="v" />Mixti' tu'n kytzq'ajsante tuk'i'l ttx'amal. Qu'n a kyeju' oje txi' nq'o'ne' ti'ju' oyaj tz'e'ysa'n inkub' q'o'n nwitze', ex xjanxi'x kyoklen kse'n kyoklen chojb'il tu'n tpaj il ex tu'n kyten b'a'n wuk'i'le'. <verse number="18" style="v" />Majx kjeltenju' lu toju' tq'ijlalil tzul, kykyaqilju' ichan tyajajil Aaron qe' che wal ti'ju' q'o'n kye kyi'ju' oyaj tz'e'ysa'n nwitze'. Ex alkyexku' jun ti'xti' mapon tiqli ti'j kjel xjan, chi Qman Dyos te Moyses.</para>
  <para style="s1">Kyoyaju' pale</para>
  <para style="p">
    <verse number="19" style="v" />Tzaj tma'n Qman Dyos te Moyses kjalu:</para>
  <para style="pi">
    <verse number="20" style="v" />A kyoyaj Aaron ja'lu kyuk'i'lju' tk'wal kb'el kyq'o'n nwitze' ajkyok te pale: kyaje' lib'r tk'i' nik'jan tb'anil arin te jun oyaj twitz awal k'ok'e'kywitz, nik'jan kb'el kyq'o'n te prim ex nik'jantl ajtok qale, mixti' jun q'ij laywit kub' kyq'o'n. <verse number="21" style="v" />Ati tu'n kyb'inchanteju' oyaj toj jun sarten, smo'n twitz b'a'nxi'x tuk'i'l aseyt, kb'el kyq'o'ntzuntz aq'pu'nchaqtl te jun oyaj tk'ok'jal nwitze'. <verse number="22" style="v" />Ikytzu'n kb'ela' tb'incha'n kynejel pale tyajajil Aaron aju' xjansa'ntl te t-xel; wewe' oyaj lu kukxju', ex majx kb'ajel tu'n q'aq'. <verse number="23" style="v" />Tkyaqil kyoyaju' pale majx kb'ajel tu'n q'aq', ex mix-a'lote kxel wante, chi Dyos.</para>
  <para style="s1">Chik'b'ab'l Kyi'j chojb'il tu'ntpaj il</para>
  <para style="p">
    <verse number="24-25" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n kyb'ajx tma'nju' nuk'b'il kyib'aju' chojb'il tu'n tpaj il, kye Aaron kyuk'i'lju' tk'wal ikjalu:</para>
  <para style="pi">Ati tu'n tkub' b'yetju' alu'mj nwitze' aju' kb'el q'et te chojb'il tu'n tpaj il, janche kub'b'yeta' alu'mj tu'n kykub' tz'e'yset, qu'n xjanxi'x toklen. <verse number="26" style="v" />Aju' pale kb'el q'onte chojb'il tu'n tpaj il, b'a'n tu'n twan ti'j, naq o'kx ati tu'n tkub'ten walte toj jun najb'il xjan twitpenju' Ja te Mujb'ab'ltib'il. <verse number="27" style="v" />Ex alkyexku' ti'xti' matz'ok tiqli ti'j tchib'jilju' alu'mj kjelten xjan, qatzun matz'ok witxli chik' ti'ju' t-xb'alun ati tu'n ttxjet toj jun najb'il xjan. <verse number="28" style="v" />Kb'el pa'yetju' tx'otx' k'wil ja xloqlona' chib'j oyaj, qatzun q'ank'uxb'ilju' k'wil ja xloqlona' naq kb'ajel jqet twitz ex kjawil txjet toj.</para>
  <para style="pi">
    <verse number="29" style="v" />Xjanxi'x toklenju' chojb'il lu, oqe'kxju' pale b'a'n tu'n kywan ti'j. <verse number="30" style="v" />Atzunju' alu'mj xini q'et te chojb'il tu'n tpaj il, ju' xini iq'etju' tchk'el toju' Ja te Mujb'ab'ltib'il tu'n tnajsetju' il, mixti' tu'n t-xi' ch'yet. Ati tu'n tkub' tz'e'yset.</para>
  <chapter number="7" style="c" />
  <para style="s1">Chik'b'ab'l kyi'ju' chojb'il tu'ntpaj kyil aj Israel</para>
  <para style="pi">
    <verse number="1" style="v" />Xjanxi'x kyoklenju' chojb'il tu'n kytene' b'a'n wuk'i'le'. Aye' chik'b'ab'l ja'lu kyib'aj: <verse number="2" style="v" />Xi' kb'ela' b'yeta' alu'mj kxel q'et te chojb'il tu'n kytene' b'a'n wuk'i'le' janche kub'a' b'yeta' alu'mj inche'x q'et tu'n kykub' tz'e'yset, atzunju' tchk'el ati tu'n t-xi' witxk'et tib'aj ex ti'jileju' q'olb'eb'l. <verse number="3" style="v" />Ati tu'n tkub' q'et tkyaqil t-untilju' alu'mj: jni'ju' ati ti'j tje exju' tok ti'jileju' t-xqintxa, <verse number="4" style="v" />exju' kab'e' tchinaq', exju' unt tok kyi'j exju' ati twittze'lti'j, exju' ati ti'ju' twab'l, aju' lu ati tu'n kyel iq'et junx kyuk'i'lju' tchinaq'. <verse number="5" style="v" />Kb'eltzun ttz'e'ysa'n paletz tib'aju' q'olb'eb'l, te jun oyaj tz'e'ysa'n te ninb'ilweye'. Jun chojb'ilte' tu'n kytene' b'a'n wuk'i'le', <verse number="6" style="v" />ex b'a'n tu'n kywan kykyaqilju' pale ti'j, naq o'kx ati tu'n kywante toj jun najb'il xjan, qu'n xjanxi'xte' toklen.</para>
  <para style="pi">
    <verse number="7" style="v" />Ikx chojb'ilju' tu'n kytene' b'a'n, kse'n jun chojb'il tu'n tpaj il, ex ax chik'b'ab'lju' kyi'j te kykab'il: teju' pale kb'inchalteju' chojb'il tu'n tk'metju' najsb'il il kxe'la'ju' alu'mj kb'el q'et. <verse number="8" style="v" />Ex ikx kjelju' ttz'umal alu'mj teju' pale kb'inchalteju' alu'mj te chojb'il k'ok'sb'il makub'tq'o'n jun xjal. <verse number="9" style="v" />Ex kykyaqilju' oyaj twitz awal k'ok'e'kywitz b'incha'n toj chuj ex b'incha'n toj k'wil b'o's t-xe ex toj sarten kxe'l teju' pale kb'el q'onteju' oyaj. <verse number="10" style="v" />Ex ikx kb'inchetelju' kyi'j kykyaqilju' oyaj twitz awal k'ok'e'kywitz, xyuq'i'n tuk'i'l aseyt mujqa kukx ttenju', ati tu'n t-xi' kyeju' tyajajil Aaron, junelni kxe'l kye, chi Dyos.</para>
  <para style="s1">Chik'b'ab'l kyi'ju' chojb'il te b'inchjtib'il</para>
  <para style="pi">
    <verse number="11" style="v" />Aye' chik'b'ab'l ja'lu kyib'aju' chojb'il te b'inchjtib'il, ju' inkub' q'et nwitze': <verse number="12" style="v" />Qa te aq'b'il chjonteju' chojb'il, ktzajel kyq'o'ne' muqin mixti' ttx'amal xyuq'i'n tuk'i'l aseyt ex xwok' muqin mixti' ttx'amal witxk'a'n aseyt ti'j ex muqin tu'n tb'anil arin xyuq'i'n tuk'i'l aseyt; <verse number="13" style="v" />ex ktzajel kyq'o'ne' wab'j muqin tuk'i'l ttx'amal junx tuk'i'lju' chojb'il te aq'b'il chjonte ex te mujb'ab'ltib'il. <verse number="14" style="v" />K'elel pa'yet jun tnej weye' ti'j tkyaqilju' oyaj tu'n t-xi' q'et teju' pale kb'el witxk'ante tchk'elju' alu'mj te chojb'il te mujb'ab'ltib'il.</para>
  <para style="pi">
    <verse number="15" style="v" />Ati tu'n t-xi' ch'yet tchib'jilju' alu'mj makub' q'et te chojb'il te aq'b'il chjonte ex te mujb'ab'ltib'il tojxju' q'ij ajtkub' q'et; mixti' tu'n tkyaj klet jun tx'naj te juntl q'ij. <verse number="16" style="v" />Qatzun tu'n tjapun jun yol xkub' q'eta'ju' alu'mj, mujqa matzaj anq'in kyk'u'je', ati tu'n t-xi' ch'yet tojxju' q'ij ajtkub' q'et, qatzun mixti' xb'aj, b'a'n tu'n t-xi' ch'yet toj juntl q'ij; <verse number="17" style="v" />qatzun atix tchib'jilju' alu'mj toj toxi'n q'ij, ati tu'n tkub' tz'e'yset tkyaqil. <verse number="18" style="v" />Qatzun ati jun matxi tch'yo'n tchib'jilju' alu'mj te chojb'il te mujb'ab'ltib'il toj toxi'n q'ij, lay nk'amju'ye' chojb'il lu ex lay tz'ok toj tajlal, k'elel ik'etju' chib'j lu. Alkyete mach'yon ti'j ati til tu'n tpaj.</para>
  <para style="pi">
    <verse number="19" style="v" />Qama tz'ok tiqli chib'j ti'j alkyexku' ti'xti' tz'il, kb'el tz'e'yset ex lay txi' ch'yet.</para>
  <para style="pi">Kykyaqilju' ẍtilsa'n kyib' b'a'n tu'n kych'yonteju' chib'j.</para>
  <para style="pi">
    <verse number="20" style="v" />Qama ch'yon jun xjal tz'ilsa'n tchwinqlal ti'ju' chojb'il te mujb'ab'ltib'il, ju' makub' q'o'n nwitze', ati tu'n tex xla'jetju' xjal lu ti'jxi'ju' ttanam.</para>
  <para style="pi">
    <verse number="21" style="v" />Alkyete xjal qama tz'ok ttzyu'n alkyexku' ti'xti' tz'il, qa kytz'ilil xjal mujqa kytz'ilil alu'mj, mujqa alkyexku' juntl ti'xti' tz'il, extzun matxi tch'yo'nju' tchib'jilju' chojb'il te mujb'ab'ltib'il makub' q'o'n nwitze', k'elex xla'jet ti'jxi'ju' ttanam, chi Qman Dyos.</para>
  <para style="s1">Chik'b'ab'l ti'ju' unt ex ti'ju' chik'</para>
  <para style="p">
    <verse number="22-23" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">Mixti' tu'n t-xi' kych'yo'ne' ky-until tman wakx, qpoj tman rit, mujqa chib'. <verse number="24" style="v" />Atzu'n ky-untilju' alu'mj kub'ni b'yo'nqe' mujqa kub'niqe' tzaqu'n kyu'n tojk'ul txkup, o'kx b'a'n tu'n tajb'ena' kyu'ne' te juntl ti'xti', mixti' tu'n t-xi' kych'yo'ne'. <verse number="25" style="v" />Alkyete matxi tch'yo'n ky-until alu'mj ju' inche kub' q'o'n nwitze' te jun oyaj tz'e'ysa'n, ati tu'n tex xla'jet toju' ttanam. <verse number="26" style="v" />Jachaqxjaku' mache anq'ina'ye', mixti' tu'n kych'yonteye' tchk'el pich' ex tchk'el txkup. <verse number="27" style="v" />Aju' xjal in ch'yon alkyexku' chik', ati tu'n tex xla'jet toju' ttanam, chi Qman Dyos.</para>
  <para style="s1">Aju' ati toklen pale ti'j</para>
  <para style="p">
    <verse number="28-29" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">Alkyete matzaj q'onte jun chojb'il te mujb'ab'ltib'il weye', ati tu'n ttzaj tiq'i'n nwitze'. <verse number="30" style="v" />Aku' ktzajel iq'inteju' oyaj tz'e'ysa'n nwitze', aju' ttzitk'u'j tuk'i'lxi' t-until tu'n ttzaj q'o'n weye'. <verse number="31" style="v" />Kb'el ttz'e'ysa'n paleju' unt tib'aj q'olb'eb'l, atzunju' ttzitk'u'j kxe'l te Aaron ex kyeju' tyajajil. <verse number="32" style="v" />Kyeju' pale kxe'la' kykuxju' alu'mj te kyb'anq'ob', ju' inche kub' q'et te chojb'il te mujb'ab'ltib'il, te jun oyaj kye. <verse number="33" style="v" />Teju' pale kb'el q'onteju' unt ex tchk'elju' chojb'il te mujb'ab'ltib'il kxe'la' tkuxju' alu'mj te tb'anq'ob', <verse number="34" style="v" />qu'n matxi' tz'el npa'ne' ttzitk'u'ju' alu'mj intzaj kyq'o'n aj Israel weye' te chojb'il te mujb'ab'ltib'il, te jun oyaj tb'anilxi'x, exju' tkux te jun o'nb'il, che kxe'l teju' pale Aaron ex kyeju' tyajajil kukxju'.</para>
  <para style="pi">
    <verse number="35" style="v" />Atzun kxe'lju' te Aaron ex kyeju' tyajajil kyi'ju' oyaj nche kub' tz'e'yset te ninb'ilweye', ati kyoklen ti'j atxi'x t-xi' nq'o'ne' kyoklen te pale nwitze'. <verse number="36" style="v" />Ayine' ẍin kyej q'onte chaq'b'il lu kyeye' tu'n t-xi' kyq'o'ne' kye', ktzyetelx toju' q'ij ajkyok nq'o'ne' toj kyoklen, ilti'j tu'n kyq'onteye' kukxju', tu'n kyb'inchanteye' exqe' kyk'wal, chi Qman Dyos.</para>
  <para style="p">
    <verse number="37-38" style="v" />Atzun chik'b'ab'l ja'lu tzaj tma'n Qman Dyos te Moyses twi' witz Sinayi kyi'ju' chojb'il k'ok'sb'il, oyaj twitz awal k'ok'e'kywitz, chojb'il tu'n tpaj il ex tu'n kyten b'a'n tuk'i'l Dyos, oyaj te xjanb'il exqe'ju' chojb'il te mujb'ab'ltib'il, tej tmante kye aj Israel toju' chq'ajlaj Sinayi tu'n tb'ajkub' kyq'o'n kyoyaj.</para>
  <chapter number="8" style="c" />
  <para style="s1">Tej kyok Aaron kyuk'i'lju' tk'wal toj kyoklen</para>
  <para style="r">(<ref loc="EXO 29:1-37">Ex 29.1-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj tma'n Qman Dyos te Moyses kjalu:</para>
  <para style="pi">
    <verse number="2" style="v" />Q'inqe'tza Aaron kyuk'i'lju' tk'wal, exju' kyxb'alun te pale, exju' aseyt te xjansb'il, exju' qpoj tman wakx kb'el q'et te chojb'il tu'n tpaj il, exqe' kab'e' rit exju' tal chi'l te wab'j mixti' ttx'amal, <verse number="3" style="v" />ex b'uyinqe'tza tnam ttziju' Ja te Mujb'ab'ltib'il, chij.</para>
  <para style="p">
    <verse number="4" style="v" />Xitb'incha'n Moyses tma Qman Dyos te, ex kykyaqilju' xjal b'aj kyb'u'yi'n kyib' ttziju' Ja te Mujb'ab'ltib'il. <verse number="5" style="v" />Xi'tzun tma'n Moysestz kye kykyaqil aj Israel: A matxi' tchaq' Qman Dyos ja'lu tu'n tb'inchet, chij.</para>
  <para style="p">
    <verse number="6" style="v" />E'tzajtzun tk'le'n Moyses Aaron kyuk'i'lju' tk'wal ex eb'aj tichi'n. <verse number="7" style="v" />Kyb'ajlenxi'tzun ichin, oktq'o'n t-xb'alun Aaron ku'j ex oktq'o'n tk'alb'il, ex oktq'o'n pinpa't ti'jxi'; oktzun tq'o'n t-ẍa'ytz ex oktk'lo'n tu'njxju' taq'e'l. <verse number="8" style="v" />Ex oktq'o'nju' tal xb'alun ttzitk'u'j, ex e'oktq'o'nju' ab'j Urim, ex Tumin ti'j. <verse number="9" style="v" />Ex jax tq'o'nju' ẍipb'il twi' ex oktq'o'n plak q'anpwaq ti'j toju' plaj twitzxi' tu'n tok toklen te pale, kse'nxju' tchaq' Qman Dyos. <verse number="10" style="v" />Tzajtzun tiq'i'n Moyses aseyt te xjanb'il ex jax tqo'n tib'aju' ja xjan ex kyib'aj kykyaqilju' ate' toj, iktzu'n kub'a' t-xjansa'na'. <verse number="11" style="v" />Tu'nxtzunju' aseyt lu b'aj twitxk'a'n wuq maj ti'jile q'olb'eb'l ex kub' tqo'n tib'aj ex kyib'aju' aq'unb'il inche ajb'en te, ex tib'aj tkb'elju' a' exju' tq'uqlil tu'n kxjanset.</para>
  <para style="p">
    <verse number="12" style="v" />Jaxtzun tqo'n Moyses aseyt te xjansb'il toj twi' Aaron tu'n t-xjanset te pale. <verse number="13" style="v" />Ex e'tzaj tiq'i'n tk'wal Aaron, ex oktq'o'nju' kyxb'alun ku'j, oktk'lo'nju' kyk'alb'il ex jax tq'o'nju' ẍipb'il kywi' kse'nxju' ojetoq tchaq' Qman Dyos.</para>
  <para style="p">
    <verse number="14" style="v" />Xi'tzun tma'n Moysestz tu'n ttzaj q'i'nju' qpoj tman wakx nkub' q'et te chojb'il tu'n tpaj il, kub'tzun kyq'o'n Aaron kyq'ob' kyuk'i'lju' tk'wal tib'aj twi'ju' qpoj tman wakx. <verse number="15" style="v" />Kub'tzun tb'yo'n Moyses qpoj tman wakx ex jawtiq'i'n chik' kyu'n twitq'ob' ex okt-sun kyi'j tuk'a q'olb'eb'l ti'jile tu'n t-xjanset, atzunju' chik' kyej sob'rin kub' tqo'n t-xe q'olb'eb'l. Iktzu'n xjanseta' q'olb'eb'l tu'n tk'metju' najsb'il il tib'aj. <verse number="16" style="v" />Yajxi'tzuntl tzaj tiq'i'n Moyses tkyaqilju' unt tok kyi'ju' t-xqintxa, exju' unt tok kyi'ju' twab'l exqe'ju' kab'e' tchinaq' kyuk'i'lju' ky-until, kub' ttz'e'ysa'ntzuntz tkyaqil tib'aj q'olb'eb'l; <verse number="17" style="v" />atzu'n jni'tlju' wakx, ttz'umal, tchib'jil ex ttxa, oktq'o'n kyq'aq'al ti'jxi'ju' najb'il, kse'nxju' tchaq' Qman Dyos te.</para>
  <para style="p">
    <verse number="18" style="v" />Xitma'n Moyses tu'n ttzaj iq'i'n tman rit inkub' q'et te chojb'il k'ok'sb'il, ex kub' kyq'o'n Aaron kyq'ob' kyuk'i'lju' tk'wal tib'aj twi'. <verse number="19" style="v" />Kub' tb'yo'ntzun Moysestz ex kub' tqo'nju' tchk'el tib'aj q'olb'eb'l ex ti'jile, <verse number="20" style="v" />kub' tpẍu'nju' rit toj tx'naji'n, ex kub' ttz'e'ysa'n tuk'i'lxi'ju' twi' exju' unt; <verse number="21" style="v" />ex eb'aj ttxjo'nju' t-xqintxa exqe'ju' tkux, kub' ttz'e'ysa'ntzuntz tkyaqil tib'aj q'olb'eb'l te jun chojb'il k'ok'sb'il te jun oyaj tb'anil tk'ok'jal te Qman Dyos, kse'nxju' tchaq' Qman Dyos te.</para>
  <para style="p">
    <verse number="22" style="v" />Ex tchaq' Moyses tu'n ttzaj iq'i'nju' juntl rit, ju' tu'n tb'inchet te xjansb'il, ex kub' kyq'o'n Aaron kyq'ob' kyuk'i'lju' tk'wal tib'aj twi'. <verse number="23" style="v" />Kub' tb'yo'ntzun Moysestz, jawtiq'i'n ch'i'n tchk'elju' alu'mj ex okt-sun tjaq' t-ẍkyin Aaron toj tb'a'nq'ob', ex ti'ju' tman twitq'ob' teju' tb'anq'ob' ex ti'ju' tman twitqan toj tb'a'nq'ob'. <verse number="24" style="v" />Ex e'tzaj tlaq'b'a'n tk'wal Aaron, ex ikx okt-sun chik' tjaq' kyẍkyin toj kyb'anq'ob', ex ti'j tman twikyq'ob' toj kyb'anq'ob' ex ti'j tman twikyqan toj kyb'anq'ob'; atzunju' jni'l chik' kub' tqo'n tib'aj q'olb'eb'l ex ti'jile.</para>
  <para style="p">
    <verse number="25" style="v" />Ex e'tzaj tiq'i'n Moyses unt, tje, tkyaqil t-untilju' t-xqintxa, t-untilju' twab'l, exqe' kab'e' tchinaq' tuk'i'lju' ky-until, exju' tkux toj tb'a'nq'ob'. <verse number="26" style="v" />Jatztzun tiq'i'n Moyses jun muqin mixti' ttx'amal, jun muqin xyuq'i'n tuk'i'l aseyt ex jun tal xwok' muqin toju' tal chi'l jatku'xa' wab'j mixti' ttx'amal, ju' nkub' q'et twitz Qman Dyos, ex e'kub'tq'o'n tk'etzju' unt exju' tkux alu'mj te tb'anq'ob'; <verse number="27" style="v" />kub' tq'o'ntzuntz tkyaqil toj tq'ob' Aaron ex toj kyq'ob'ju' tk'wal tu'n kyb'inchanteju' tu'me'l tu'n kyq'onte oyaj twitz Qman Dyos. <verse number="28" style="v" />Xi'tzun Moysestz k'molte tkyaqil ja'lu kye, ex kub' ttz'e'ysa'n tib'aj q'olb'eb'l junx tuk'i'l chojb'il k'ok'sb'il, te jun oyaj te xjansb'il tb'anil tk'ok'jal: jun oyaj tz'e'ysa'n te ninb'ilte Qman Dyos.</para>
  <para style="p">
    <verse number="29" style="v" />Yajxi'tzuntl tzaj tiq'i'n Moyses ttzitk'u'ju' rit ex tb'inchaju' tu'me'l tu'n tq'onte twitz Qman Dyos. Atzun kyaju' te Moyses ti'ju' rit te xjansb'il, kse'nxju' ojetoq tchaq' Qman Dyos te. <verse number="30" style="v" />Ex tzaj tiq'i'n Moyses ch'i'n aseyt te xjansb'il ex ch'i'n chik' ju' ati tib'aj q'olb'eb'l, kub' twitxk'a'ntzuntz tib'aj Aaron, ex kyib'aju' tk'wal, ex kyib'aju' kyxb'alun te pale. Iktzu'n e txjansaya' Aaron kyuk'i'lju' tk'wal, exju' kyi'j te pale. <verse number="31" style="v" />Xitma'ntzun Moysestz te Aaron ex kyeju' tk'wal: kytzq'ajsanku'xe' chib'j ttziju' Ja te Mujb'ab'ltib'il, ex axtzu' kych'yonxa'ye' tuk'i'lju' wab'j atku'x toju' tal chi'l te xjansb'il, kse'nxju' tzaj tma'n Qman Dyos weye' qa aye'ye' kyuk'i'lju' tk'wala che xe'lch'yonteju' chib'j lu. <verse number="32" style="v" />Qatzun min xb'aju' chib'j exu' wab'j, kypatinku'ye. <verse number="33" style="v" />Ex lalun che el lq'eye' ttziju' Ja te Mujb'ab'ltib'il toju' wuq q'ij, qu'n a tq'ijlalilju' te xjansb'ilkyeye'. <verse number="34" style="v" />Oje tchaq' Qman Dyos tu'me'l aj t-xi' q'etju' chojb'il tu'n tnajsetju' il makyb'inchaye'; ati tu'n tb'inchet kse'n xb'inchet ja'lo. <verse number="35" style="v" />Qu'mtzun ati tu'n kykyajtene' q'ijl ex qonik'an ttziju' Ja te Mujb'ab'ltib'il toju' wuq q'ij. Kynimanxju'ye' tchaq'b'il Qman Dyos, laytzun che kyimtze', qu'n a chaq'b'ilju' tzaj q'o'n weye', chij.</para>
  <para style="p">
    <verse number="36" style="v" />Kyb'inchatzu'n Aaron kyuk'i'lju' tk'wal tkyaqilju' tchaq' Qman Dyos te Moyses.</para>
  <chapter number="9" style="c" />
  <para style="s1">Tzyet taq'unan Aaron te pale</para>
  <para style="p">
    <verse number="1" style="v" />Tojtzu'n twajxaqi'n q'ij e'tzaj ttxko'n Moyses Aaron kyuk'i'lju' tk'wal, exqe' tijwnaq kyxol aj Israel. <verse number="2" style="v" />Ex xitma'n te Aaron: Q'intza jun qpoj tman wakx te chojb'il tu'n tpaj il, ex jun tman rit mixti' ttzakajil tu'n tkub' q'et te chojb'il k'ok'sb'il ex q'onku'ya twitz Qman Dyos. <verse number="3" style="v" />Atzu'n kye' aj Israel q'manxa tu'n ttzaj kyiq'i'n jun tman chib' te chojb'il tu'n tpaj il, jun qpoj tman wakx ex jun qpoj tman rit te jun ab'q'i qe' ex mixti' kytzakajil, tu'n kykub' q'et te chojb'il k'ok'sb'il. <verse number="4" style="v" />Ex jun tman wakx ex jun tman rit tu'n kykub' b'yet twitz Qman Dyos te jun chojb'il te mujb'ab'ltib'il. Ex tu'n ttzaj kyiq'i'n jun oyaj triy xyuq'i'n tuk'i'l aseyt, qu'n ktyek'u'tib' Qman Dyos kywitz ja'lo, chij te.</para>
  <para style="p">
    <verse number="5" style="v" />Xi'tzun kyiq'i'n aj Israel tkyaqilju' tchaq' Moyses kyetwitzju' Ja te Mujb'ab'ltib'il, kykyaqiltzunju' tnam e'pon ex e'kub' we' twitz Qman Dyos. <verse number="6" style="v" />Tmatzun Moysestz: a matxi' tchaq' Qman Dyos kyeye'. Kyb'inchame', atzunte Qman Dyos kb'el tyek'u'ntib' kywitze' toj nim tajwalil, chij kye.</para>
  <para style="p">
    <verse number="7" style="v" />Ex xitma'ntl Moyses te Aaron: lq'exa tk'etz q'olb'eb'l, ex q'onku'ya chojb'il saj tiq'i'na tu'n tpaj tila exju' alu'mj kb'el tq'o'na te chojb'il k'ok'sb'il tu'n tnajset tila ex tu'n tnajset kyil aj Israel. Ex q'onku'ya kyoyaj aj Israel tu'n najset kyil, kse'nxju' oje tchaq' Qman Dyos, chij te.</para>
  <para style="p">
    <verse number="8" style="v" />Xi'tzun lq'e Aaron tk'etz q'olb'eb'l ex kub' tb'yo'nju' tman wakx tu'n tkub' tq'o'n tu'n tpaj til. <verse number="9" style="v" />Xi'tzun kylaq'b'a'n tk'wal Aaron ju' chik' tk'etz, atzunte Aaron, ku'x tak'sa'n twitq'ob' toj ex oktb'aku'n kyi'j tuk'a q'olb'eb'l, atzunju' jni'l kub' tqo'n t-xe tqan q'olb'eb'l. <verse number="10" style="v" />Ex kub' ttz'e'ysa'n unt tib'aj q'olb'eb'l exqe'ju' tchinaq' exju' unt tok ti'j twab'lju' alu'mj kb'el q'et te chojb'il tu'n tpaj il kse'nxju' ojetoq tchaq' Qman Dyos te Moyses. <verse number="11" style="v" />Atzu'n tchib'jil exju' ttz'umal e'kub' ttz'e'ysa'n ti'jxi'ju' kynajb'il.</para>
  <para style="p">
    <verse number="12" style="v" />Ex kub' tb'yo'n Aaron ju' alu'mj inkub' q'et te chojb'il k'ok'sb'il, aye'tzu'n tk'wal xi' kylaq'b'a'nju' chik' te, atzunte Aaron kub' tqo'n tib'aj ex ti'jileju' q'olb'eb'l. <verse number="13" style="v" />Ex xikyiq'i'n twi' ex tchib'jilju' alu'mj toj tx'naji'n ju' inkub' q'et te chojb'il k'ok'sb'il, atzunte Aaron kub' ttz'e'ysa'n tib'aj q'olb'eb'l; <verse number="14" style="v" />ex b'aj ttxjo'nju' t-xqintxa exqe' tkux, e'kub' ttz'e'ysa'ntzuntz tib'aj q'olb'eb'l, ex tkyaqil t-xmilalju' alu'mj.</para>
  <para style="p">
    <verse number="15" style="v" />Ex kub' tq'o'n Aaron oyaj tu'nkypaj aj Israel. Tzaj tiq'i'n tman chib' te chojb'il tu'ntpaj kyilju' tnam ex kub' tb'yo'n, kub' tq'o'n tu'n tpaju' il kse'nxju' ojetoq tb'incha nejl. <verse number="16" style="v" />Tej tkub' tq'o'nju' alu'mj ju' inkub' q'et te chojb'il k'ok'sb'il, tb'incha kse'nxju' q'ma'ntl. <verse number="17" style="v" />Ex kub' tq'o'ntlju' oyaj twitz awal k'ok'e'kywitz, ex kub' ttz'e'ysa'n tib'aj q'olb'eb'l, kyib'ajxi'tlu' chojb'il k'ok'sb'il inche kub' q'et te prim.</para>
  <para style="p">
    <verse number="18" style="v" />Ex e'kub' tb'yo'n Aaron tman wakx ex tman rit inxi' kyq'o'n aj Israel te b'inchjtib'il. Xilaq'b'a'n chik' te kyu'n tk'wal, atzunte kub' tqo'n tib'aj ex ti'jileju' q'olb'eb'l. <verse number="19" style="v" />Ex xikyq'o'n ky-untilju' tman wakx ex tman rit te, exju' kyje ex ky-untilju' kyxqintxa exqe'ju' kychinaq', ex ky-untilju' kywab'l, <verse number="20" style="v" />ex kub' kyq'o'nju' unt junx kyuk'i'lju' ttzikyk'u'j. E kub'tzun ttz'e'ysa'n Aaron ju' unt tib'aj q'olb'eb'l, <verse number="21" style="v" />aye'tzu'n ttzikyk'u'j exju' kykux te kyb'anq'ob', naq tb'incha tu'me'l tu'n tq'onte twitz Qman Dyos, kse'nxju' tchaq' Qman Dyos te Moyses.</para>
  <para style="p">
    <verse number="22" style="v" />Jawtiq'i'n Aaron tq'ob' ex e'kub' tky'i'wla'n aj Israel, tetzunj kyb'ajkub' tq'o'nju' chojb'il tu'n tpaj il, chojb'il k'ok'sb'il ex chojb'il te mujb'ab'ltib'il, el lq'e tk'etzju' q'olb'eb'l. <verse number="23" style="v" />E'okxtzun Moysestz tuk'i'l Aaron toju' Ja te Mujb'ab'ltib'il, atzunj kyetz e'kub' kyky'i'wla'n aj Israel. Kub'tzun tyek'u'ntib' Qman Dyostz nxi'x qoptz'aj kywitz kykyaqilju' tnam Israel: <verse number="24" style="v" />etz q'aq' twitz Qman Dyos ex b'aj patju' alu'mj tu'n, ju' atitoq tu'n tkub' tz'e'y exqe'ju' unt atitoq tib'aj q'olb'eb'l. Tetzunj kyka'yinte aj Israel ja'lu e'jaw ẍch'in kykyaqil tu'n kytzalajb'il ex e'kub' meje majx ku'pun kyplaj twitz tx'otx'.</para>
  <chapter number="10" style="c" />
  <para style="s1">Kyil Nadab' ex Ab'yu</para>
  <para style="p">
    <verse number="1" style="v" />Aye'tzu'n Nadab' ex Ab'yu, tk'wal Aaron, teyile junjun jawtiq'i'n jun tkb'el tza'j, kuxkyq'o'n q'aq' toj ex sturak, kub' kyq'o'n jun q'aq' junxi'tl twitz Qman Dyos min tzajtma'n Dyos tu'n kyb'inchante. <verse number="2" style="v" />Etztzun q'aq'tz twitz Qman Dyos ex majx eb'aj patj. Ikytzu'n e'kyima' twitz Qman Dyos. <verse number="3" style="v" />Yajxi'tzuntl xitma'n Moyses te Aaron:</para>
  <para style="p">—Atoqtzun tajb'il Qman Dyos tu'n ttzaj tma'n tej tmante:</para>
  <para style="pi">Kxel nyek'u'nju'ye' nxjanb'ile' kyeju' mache tzaj lq'e nk'etze',</para>
  <para style="pi">Ex kxel nyek'u'ne' wajwalile' kye kykyaqil aj Israel, chij, chi Moyses.</para>
  <para style="p">Atzunte Aaron naqkyaj take, mixti'tl b'ent tyolin.</para>
  <para style="p">
    <verse number="4" style="v" />E'ttxoktzun Moyses Misael ex Elsapan, tk'wal Usyel, ttiy Aaron, ex xitma'n kye:</para>
  <para style="p">—Kyiq'inqe'mitze' kywitze'le' toju' ja xjan, ex kyiq'inqe'mixe' ti'jxi' najb'il, chij kye.</para>
  <para style="p">
    <verse number="5" style="v" />E'tzunkye exi'lq'e ex kyojxju' kyxb'alun ku'j e'exa' kyiq'i'n ti'jxi' najb'il, kse'nx tchaq' Moyses kye.</para>
  <para style="s1">Kyajb'eb'l ex kyaq'un pale tu'n kyb'inchante</para>
  <para style="p">
    <verse number="6" style="v" />Xi'tzun tma'n Moysestz te Aaron ex kyeju' tk'wal, aye' Eleasar ex Itamar:</para>
  <para style="p">—Lalun tz'el kyiq'i'ne' toj kywi'ye' ex lalun kub' kylaqu'ne' kyxb'alune' tu'n tpaj b'is, qu'n jaku' che kyime' ex jaku' tzaj tq'o'n Dyos ttx'u'jil kyib'aju' tnam. O'qe'kxkye aj Israel b'a'n tu'n kyb'isun kyi'ju' ẍeb'aj tu'n q'aq' saj tq'o'n Qman Dyos. <verse number="7" style="v" />Ex lalun che el lq'eye' ti'ju' Ja te Mujb'ab'ltib'il, tu'ntzun lalun che kyime', qu'n ojena' che xjansetkye' tu'n aseyt te Qman Dyos, chij kye.</para>
  <para style="p">Ex kyb'incha kse'nx tchaq' Moyses kye. <verse number="8" style="v" />Expe' tzaj tma'ntl Qman Dyos te Aaron kjalu:</para>
  <para style="pi">
    <verse number="9" style="v" />Ajtokxa mujqa aj kyokxju' tk'wala toju' Ja te Mujb'ab'ltib'il, lalun txi' kyk'wa'ne' ta'l ub'a tx'amsa'n, ex q'e'n kuw tq'ob', qu'n jaku' che kyime'. Jun kawb'ilte' lu kjelten kukxju' kyeye' ex kye kyk'wale', <verse number="10" style="v" />tu'ntzun telkynik'e' ti'ju' xjan exju' mya xjan, ex ti'ju' ẍtilun ex mya ẍtilun, <verse number="11" style="v" />ex tu'n t-xikyxnaq'tza'ne' tkyaqilju' kawb'il ẍexnq'o'ne' kyeye' tu'nel Moyses, chi Dyos.</para>
  <para style="p">
    <verse number="12" style="v" />Yajxi'tzuntel xitma'n Moyses te Aaron ex kyeju' kab'e'tl tk'wal e'kyajten, aye' Eleasar ex Itamar:</para>
  <para style="p">—Kyiq'inxju'ye' oyaj twitz awal k'ok'e'kywitz xkyaj kyi'ju' oyaj tz'e'ysa'n twitz Qman Dyos, ex kywanxe' mixti' ttx'amal tk'etzu' q'olb'eb'l, qu'n xjanxi'xte'. <verse number="13" style="v" />Kywanxe' toj jun najb'il xjan, qu'n atzun teju'ya ex kye tk'wala kyi'ju' oyaj nche tz'e'yset te ninb'ilte Qman Dyos. Atzun oje tzaj q'ma'nju' weye'. <verse number="14" style="v" />Extzunju' ttzitk'u'j, aju' oyaj nim toklen, exju' tkux nkub' q'o'n, kxe'l kywane' kyuk'i'lju' tk'wala ex tmyala toj jun najb'il ẍtilun, qu'n a kyeju'ye' ti'ju' chojb'il te b'inchjtib'il nkub' kyq'o'n aj Israel. <verse number="15" style="v" />Che xe'l iq'etju' tkux, aju' nkub' q'et, exju' ttzitk'u'j aju' oyaj nim toklen, tu'n kykub' q'et te jun oyaj nim toklen tk'etzju' unt, ju' nkub' tz'e'yset. Aju' lu kxe'l teya kukxju' ex kyeju' tk'wala, kse'nxju' oje tchaq' Qman Dyos, chi Moyses te.</para>
  <para style="p">
    <verse number="16" style="v" />Xi'tzun tqani'n Moyses jatoq ta' tman chib' nkub' q'et te chojb'il tu'n tpaj il, ex tb'i qa matxitoq kub' kytz'e'ysa'n. Tzajtzun ttx'u'jiltz ti'j Eleasar ex ti'j Itamar, ju' kab'e'tl tk'wal Aaron itz'qe'xtoq ex xitma'n kye:</para>
  <para style="p">
    <verse number="17" style="v" />—¿Tiqu'n minti' xxi' kych'yo'nju'ye' chojb'il tu'n tpaj il toju' najb'il xjan? Xjanxi'xnate', ex a Qman Dyos xiq'onte kyeye' tu'n kyiqanteye' kyilju' tnam tu'ntzun tkub' tnajsa'n Qman Dyos kyil. <verse number="18" style="v" />Ex tu'nju' min xi' iq'etju' chik' toju' ja xjan, ilxi'xtoqti'j tu'n txi' kych'yo'nju'ye' chojb'il toju' najb'il xjan lu, kse'nxju' oje nchaq'e' kyeye', chi Moyses.</para>
  <para style="p">
    <verse number="19" style="v" />Atzunte Aaron xittzaq'we'n te:</para>
  <para style="p">—Ka'yintzpe'ya, ma'pena' tzul kyiq'i'n chojb'il tu'ntpaj il exju' chojb'il k'ok'sb'il twitz Qman Dyos, extzun mache ik'ju' ti'xti' lu wi'je'. Noqwit machin wane' ja'lo ti'ju' chojb'il tu'n tpaj il ¿Ma b'a'nwtzulo sela' toj twitz Qman Dyos? chij.</para>
  <para style="p">
    <verse number="20" style="v" />Qetzun tk'u'j Moysestz tej tb'inte ja'lu.</para>
  <chapter number="11" style="c" />
  <para style="s1">Ẍtilun txkup ex tz'il</para>
  <para style="r">(<ref loc="DEU 14:3-21">Dt 14.3-21</ref>)</para>
  <para style="p">
    <verse number="1-2" style="v" />Tzaj tma'n Qman Dyos te Moyses ex te Aaron tu'n t-xi' kyma'n kye aj Israel ikjalu:</para>
  <para style="pi">Aye' txkup ja'lu b'a'n tu'n kyxi' kych'yo'ne' kyxol kykyaqilju' ate' twitz tx'otx', <verse number="3" style="v" />aye' inche kok'san ex pa'ch kyxky'eq; <verse number="4" style="v" />naqtzun oqe'kx txkupju' mixti' tu'n kyxi' kych'yo'ne', maskye inche kok'san mujqa pa'ch kyxky'eq:</para>
  <para style="pi">Aju' kamey, qu'n mya pa'ch t-xky'aq, maskye in kok'san. Ati tu'n tok kyu'ne' te tz'il txkup.</para>
  <para style="pi">
    <verse number="5" style="v" />Exju' ẍiky, qu'n mya pa'ch t-xky'aq, maskye nkok'san. Ati tu'n tok kyu'ne' te tz'il txkup.</para>
  <para style="pi">
    <verse number="6" style="v" />Exju' toj k'ul ẍiky, qu'n mya pa'ch t-xky'aq, maskye in kok'san, ati tu'n tok kyu'ne' te tz'il txkup.</para>
  <para style="pi">
    <verse number="7" style="v" />Aju' b'och, minti' in kok'san, maskye pa'ch t-xky'aq, ati tu'n tok kyu'ne' te tz'il txkup.</para>
  <para style="pi">
    <verse number="8" style="v" />Lalun txi' kych'yo'ne' kychib'jilju' txkup lu, expe' lalun txi' kytzyu'nju'ye' t-xmilal kyimnitl. Ati tu'n kyok kyu'ne' te tz'il txkup.</para>
  <para style="pi">
    <verse number="9" style="v" />O'qe'kxju' txkup ati tal kyxik' ex ati tal kyxk'owil kuw b'a'n tu'n txi' kych'yo'ne' kyxolju' txkup ate'qe' toj a', toj ninnjab' mujqa toj nimaq a'. <verse number="10" style="v" />Aye'tzunju' mixti' tal kyxik' ex mixti' kyxk'owil kuw toj ninnjab' mujqa toj nimaq a', k'ok'e' mujqa nimaq, ati tu'n tok kyu'ne' te tz'il txkup. <verse number="11" style="v" />Mixti' tu'n txi' kych'yo'nju'ye' kychib'jil; ati tu'n kyel kyik'o'nju'ye' txkup lu, ex ati tu'n tel kyik'o'nju'ye' kyxmilal kyimniqe'tl. <verse number="12" style="v" />Kykyaqilju' txkup mixti' tal kyxik' ex mixti' kyxk'owil kuw toj a', ati tu'n tel kyik'o'ne'.</para>
  <para style="pi">
    <verse number="13" style="v" />Aye' pich' ja'lu mixti' tu'n kych'yone', expe' kche elel kyik'o'ne': t'iw, toqil b'aq, t'iw tib'aj ninnjab', <verse number="14" style="v" />milano ex tkyaqil kyyajil alkon, <verse number="15" style="v" />tkyaqil kyyajil joj, <verse number="16" style="v" />ab'estrus, xitx', kab'yota, ex tkyaqil kyyajajil q'anjel, <verse number="17" style="v" />tukru, kormoran, ib'is, <verse number="18" style="v" />sisne, pelikano, k'utz, <verse number="19" style="v" />siwenya, tkyaqil tyajil gars, ab'ub'iya ex sotz'.</para>
  <para style="pi">
    <verse number="20" style="v" />Ex kykyaqil tal txkup b'o'sqe' nche lipan ex nche b'et, ati tu'n tel kyik'o'ne', <verse number="21" style="v" />aye'tzu'n b'a'n tu'n kyxi' kych'yo'ne', aye' mujli kykux tuk'i'l kyqan tu'n tb'ent kyxlik'pun twitz tx'otx', maskye inche lipan ex inche b'et. <verse number="22" style="v" />Kyxoltzu'n ja'lu b'a'n tu'n t-xi' kych'yo'ne' tkyaqil kyajajil ẍt'ikt'u'l, e'nimaq ẍt'ikt'u'l, ex txil. <verse number="23" style="v" />Aye'tzu'n txqantl tal txkup nche lipan ex nche b'et, ati tu'n tel kyik'o'ne'.</para>
  <para style="pi">
    <verse number="24" style="v" />Aye' ti'xti' ja'lu che kjel tz'ilixe' tu'n: alkyete matxi ttzyu'n t-xmilal junju' txkup lu kyimnitl, kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="25" style="v" />Alkyete majaw q'inte junju' txkup lu kyimnitl, kttx'ja'ju' ti'j ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="26" style="v" />Kykyaqil txkup, mya pa'ch kyxky'eq ex mixti' inche kok'san, ati tu'n kyok kyu'ne' tz'il txkupqe', ex alkyete matz'ok tzyunkye, k'okyel tz'il.</para>
  <para style="pi">
    <verse number="27" style="v" />Alkyexku' txkup kyaje' tqan ex ajtb'et xi'nkub'a' talal tib'aju' t-xky'aq, ati tu'n tok kyu'ne' te tz'il txkup; ex alkyexku' matz'ok mkonte t-xmilal junju' txkup lu kyimnitl, k'okyel tz'il tzmaxi'j ajqok yupj. <verse number="28" style="v" />Ex alkyexku' majaw q'inte t-xmilal junju' txkup lu kyimnitl, ati tu'n ttxjonteju' ti'j ex kyjelten tz'il tzmaxi'j ajqok yupj. Qu'n ati tu'n kyokju' txkup lu tz'ilqe' kyu'ne'.</para>
  <para style="pi">
    <verse number="29" style="v" />Aye' txkup ja'lu nche qitinje twitz tx'otx', ati tu'n kyok kyu'ne' tz'ilqe': Saqb'in, ich' ex tkyaqil kyyajil txkup nche qititinje. <verse number="30" style="v" />Exqe'ju' salamankyesas, kokodrilo, lakart, xmatx, ex kamalyon.</para>
  <para style="pi">
    <verse number="31" style="v" />Ayetzun txkupju' che okyel kyu'ne' te tz'il kyxol kykyaqilju' txkup twitz tx'otx'. Alkyetzunte matz'ok ttzyu'n junju' txkup lu kyimnitl, kjel tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="32" style="v" />Ex ikx qama tz'ok tiqli junju' txkup lu kyimnitl ti'j jun ti'xti', kjel tz'ilix tu'n. Qa jun ti'xti' tze mujqa xb'alun, mujqa jun ti'xti' tz'u'n, mujqa kostal, mujqa alkyexku' aq'unb'il, ati tu'n tku'x q'et toj a' ex kjel tz'il tzmaxi'j ajqok yupj; yajxi'tzuntel kjel ẍtilun.</para>
  <para style="pi">
    <verse number="33" style="v" />Qatzun nab'en ma ku'x tz'aq junju' txkup lu toj jun tx'otx' k'wil, tkyaqilju' ati toju' k'wil kjel tz'ilix, ex kb'el pa'yetju' k'wil. <verse number="34" style="v" />Ex tkyaqilju' wab'j qama kub'ju' a' setz toju' k'wil lu tib'aj, kjel tz'ilix; ex tkyaqil k'wab'j ati toj, kjel tz'il. <verse number="35" style="v" />Tkyaqilju' ti'xti' qama kub' tz'aq junju' txkup lu kyimnitl tib'aj, kjel tz'il; jun chuj mujqa tkub'el q'aq', ati tu'n kykub' xitet. Ati tu'n tok kyu'ne' tz'il, qu'n tz'ilte'.</para>
  <para style="pi">
    <verse number="36" style="v" />Atzun teju' t-xiklil a' mujqa xoch janjatza' a' te k'wab'j kjelten ẍtilun kukxju'; atzunju' matz'ok mkonkyeju' txkup kyimniqe'tl kjelten tz'il.</para>
  <para style="pi">
    <verse number="37" style="v" />Qama kub' tz'aq junju' txkup lu kyimnitl tib'aj jun ij ju' kxel awet, lay kyej tz'ilixju' ij; <verse number="38" style="v" />qatzun makub' tz'aq junju' txkup lu kyimnitl tib'aj jun ij ak'sa'ntl, kjel tz'ilix.</para>
  <para style="pi">
    <verse number="39" style="v" />Qatzun nab'en makyim jun alu'mj b'entnitlti'j tu'n t-xi' kych'yo'ne', alkyete matxi tzyunte kjelten tz'il; <verse number="40" style="v" />alkyetzunte matxi' ch'yonteju' alu'mj kyimnitl, ati tu'n ttxjonteju' ti'j ex kjelten tz'il tzmaxi'j ajqok yupj; ex ikxju' matz'ex q'inteju' alu'mj kyimnitl, ex ati tu'n ttxjonteju' ti'j ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="41" style="v" />Mixti' tu'n t-xi' kych'yo'ne' jun txkup nqititinje twitz tx'otx'; ati tu'n tel kyik'o'ne'.</para>
  <para style="pi">
    <verse number="42" style="v" />Kykyaqilju' txkup nche qititinje twitz tx'otx', mixti' tu'n kyxi' ch'yet, b'a'ntzun ntjqu'n tk'u'j ajtb'et mujqa nb'et kyu'n kyaje' mujqa txqantl kyqan, qu'n tz'il txkupqe'. <verse number="43" style="v" />Qu'mtzun lalun kub' kytz'ilsa'n kyib'e' ex lalun che oke' kse'nqe'ju' txkup lu tz'ilqe'. <verse number="44" style="v" />Qu'n ayine' Dyos Manb'aj. Ati tu'n kyoke' ẍtilun ex xjan, qu'n xjan qinwe'. Lalun kytxa'jla kyib'e' tu'n junju' txkup nqititinje twitz tx'otx'. <verse number="45" style="v" />Ayine' Dyos Manb'aj, inetz q'inkyeye' toj Ejipt tu'n kyajb'ene' weye'. Qu'mtzun ati tu'n kyoke' xjan qu'n xjan qinwe', chi Qman Dyos kye Moyses ex Aaron.</para>
  <para style="p">
    <verse number="46" style="v" />Aye' nuk'b'il ja'lu kyi'ju' txkup, pich' ex kykyaqilju' najliqe' toj a', ex kykyaqilju' txkup nche qititinje twitz tx'otx', <verse number="47" style="v" />Tu'ntzun tel kynik'tzilju' ẍtilunqe' kyi'ju' tz'ilqe', ex tu'n tel kynik'tzilju' b'a'n tu'n kych'yet exqe' myab'a'n tu'n kych'yet.</para>
  <chapter number="12" style="c" />
  <para style="s1">Chaq'b'il tu'n t-ẍtilsantetib'ju' qya mab'anix</para>
  <para style="p">
    <verse number="1-2" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel ikjalu:</para>
  <para style="pi">Ajtok jun qya ch'onwi' ex q'aju' tal sitz'ji, kjel tz'ilix wuq q'ij, kse'nxju' aj tkb'u'lju' ttx'ajin. <verse number="3" style="v" />Ati tu'n tok techelju' k'wal ti'j tchib'jil tb'ajlenxi' wajxaq q'ij titz'jlen. <verse number="4" style="v" />Atzunju' txub'aj kxel tljo'n junaq oxlajoj (33) q'ijtl tu'n t-ẍtilsantetib' teju' chik'. Mixti' tu'n tokttzyu'n jun ti'xti' xjan mujqa tu'n tokx toju' ja xjan qa na'mxtoq tjapun tq'ijlalil tu'n t-ẍtilsantetib'. <verse number="5" style="v" />Qatzun txinju' tal sitz'ji, kb'elten o'lajoj q'ij tz'il kse'nxju' tq'ijlalil ajtkb'u'l ttx'ajin, ex ati tu'n t-ẍtilsantetib' oxnaq qaq (66) q'ijtl.</para>
  <para style="pi">
    <verse number="6" style="v" />Ajtzun tjapunju' tq'ijlalil te ẍtilsab'l, b'a'ntzun tu'n jun q'a mujqa tu'n txin, ktzajel tiq'i'n txub'aj jun qpoj tman rit te jun ab'q'i tu'n tkub' q'et te chojb'il k'ok'sb'il ttziju' Ja te Mujb'ab'ltib'il, ex ktzajel tiq'i'n jun tal paloms mujqa jun xlak'uk' te chojb'il tu'n tpaj il. Che kxe'l tq'o'n teju' pale, <verse number="7" style="v" />atzunju' pale che kb'eltq'o'n nwitze' tu'n ttzaj tqani'n najsb'il weye' ti'ju' qya; kjel tentzun qyatz ẍtilun teju' chik' inel ti'j, chi Dyos te Moyses.</para>
  <para style="p">Aye'tzun chik'b'ab'l ja'lu ti'j titz'jlen jun q'a mujqa jun txin. <verse number="8" style="v" />Qatzun mixti' xkanunju' txub'aj tu'n ttzaj tiq'i'n jun qpoj tman rit, b'a'n tu'n ttzaj tiq'i'n kab'e' tal xlak'uk' mujqa kab'e' tal paloms, jun tu'n tkub' q'et te chojb'il k'ok'sb'il, atzu'n juntl te chojb'il tu'n tpaj il; kxeltzun tqani'n pale najsb'il te Qman Dyos ti'ju' qya, kjel tentzun qyatz ẍtilun.</para>
  <chapter number="13" style="c" />
  <para style="s1">Chik'b'ab'l ti'ju' xlemtx'a'k</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj tma'n Qman Dyos kye Moyses ex Aaron ikjalu:</para>
  <para style="pi">
    <verse number="2" style="v" />Qa ati jun xjal matxi' b'jaw mal tchib'jil mujqa mab'jaw punq'ij, mujqa b'je'tzni ẍal ti'j, exqa majawb'ent te xlemtx'a'k, ati tu'n t-xi' iq'et tk'etzju' pale Aaron mujqa tk'etz jun pale tyajajilx. <verse number="3" style="v" />Ati tu'n tok tka'yi'n paleju' tx'a'k ti'j tchib'jil xjal, qatzun matxi' saqax t-smalju' xjal toju' tx'a'k exqa matxi' ku'x lq'eju' tx'a'k toj tchib'jil, xlemtx'a'ktzuntz. Tb'ajlenxi'tzun tka'yi'n paleju' xjal lu, ktma'tzuntz qa tz'il.</para>
  <para style="pi">
    <verse number="4" style="v" />Qa saq ka'yinju' tchib'jil tu'n extzun mixti' kuxni lq'eju' tx'a'k toj tchib'jil, ex mya saq t-smal, k'okex tjpu'n pale wuq q'iju' yab'. <verse number="5" style="v" />Tojtzun twuqi'n q'ij k'okel tka'yi'n jumajtel, qatzun kukx tten tx'a'kju' ex na'mx t-xi' mlen ti'ju' tchib'jil, k'okex tjpu'n wuq q'ijtel. <verse number="6" style="v" />K'okel tka'yi'n jumajtl toj twuqi'n q'ijtel, qatzun kxi' tkub' naju' tx'a'k ex min xxi' mlentl, ktma'tzun paletz qa ẍtilun te' yab', qu'n naq jun yab'ilxi'te' ti'j tchib'jil. Atzunte yab' kb'ajel ttxjo'nju' ti'j ex kjelten ẍtilun.</para>
  <para style="pi">
    <verse number="7" style="v" />Qatzun matxi mlenju' tx'a'k ti'j tchib'jilju' yab' tb'ajlenxi' ka'yi'n tu'n pale ex ojetoq tma pale qa ẍtilun, ati tu'n t-xi' jumajtl twitz pale tu'n tok ka'yet. <verse number="8" style="v" />Ajtzun tok tka'yi'n pale, qa matxi' txi' mlenju' tx'a'k ti'j tchib'jilju' yab', ktma'tzuntz qa tz'il, qu'n xlemtx'a'k ati ti'j. <verse number="9" style="v" />Qa yab' jun xjal tu'n xlemtx'a'k, ati tu'n t-xi' iq'et twitz pale. <verse number="10" style="v" />K'okel tka'yi'nju' pale, qatzun saq ka'yinju' malni ti'j tchib'jil ex matxi' txi' saqaxju' t-smal tu'n, exqa q'ancha'lju' tchib'jil toju' malni, <verse number="11" style="v" />xlemtx'a'ktzuntz matxi' lok'an ti'j. Oktma' pale qa tz'ilju' xjal lu, ex min in ojqelan tu'n tokx tjpu'ntl, qu'n tz'iltel.</para>
  <para style="pi">
    <verse number="12" style="v" />Qa lwiy xxi' mlenju' xlemtx'a'k lu ti'j, qama tzajx t-xe tqan ex majapunx toj twi' ja maka'yeta' tu'n pale, <verse number="13" style="v" />Kb'ajel tka'yi'n pale b'a'nxi'x; qatzun matxi' b'aj noj ti'ju' xjal tu'n xlemtx'a'k, ktma' qa ẍtilun, qu'n matxi' kub' saqaxju' xlemtx'a'k ex matxi' kyej tenju' xjal ẍtilun. <verse number="14" style="v" />Qatzun alkye q'ij maq'ancha'linju' tchib'jil yab' toju' xlemtx'a'k, kjel tentzuntz tz'il. <verse number="15" style="v" />Oktzun k'okel tka'yi'n pale tchib'jil qa q'ancha'l toju' tx'a'k, ktma'tzuntz qa tz'il, qu'n tz'ilte' qa q'ancha'lju' tchib'jil, xlemtx'a'ktzuntz.</para>
  <para style="pi">
    <verse number="16" style="v" />Qatzun nab'en makub' saqaxlju' tchib'jil q'ancha'l toju' tx'a'k, kxe'lju' yab' twitz pale, <verse number="17" style="v" />tu'n tok tka'yi'n, qatzun matilju' pale masaqaxju' tx'a'k, ktma'tzuntz qa ẍtilunju' yab', qu'n matxi' kyej ẍtilun.</para>
  <para style="pi">
    <verse number="18" style="v" />Qa ati jun ati tx'a'k ti'j, ex mab'anix, <verse number="19" style="v" />exqa makyej ten jun malni saq ka'yin jata'toqju' tx'a'k, mujqa tik'len saqẍkyaqinin, ati tu'n t-xi' twitz pale. <verse number="20" style="v" />Qama tz'ok tka'yi'n pale matxitoq kux lq'eju' tx'a'k toj tchib'jil, ex matxi' saqaxju' t-smal, ktma'tzuntz qa tz'ilju' xjal lu, qu'n xlemtx'a'k te' ati ti'j. <verse number="21" style="v" />Qatzun min xsaqaxju' tzmal ex min xku'x lq'eju' tx'a'k toj tchib'jil, kxi'pe' tkub' naj, k'okex tjpu'n wuq q'iju' xjal. <verse number="22" style="v" />Qatzun xi't-xi' mlenxi'xtlju' yab'il ti'j tchib'jil, ktma'tzun paletz qa tz'ilju' xjal lu, qu'n xlemtx'a'kju' ati ti'j. <verse number="23" style="v" />Qatzun kukx tten tx'a'kju' ti'j ex min inxi' mlen, naqtzun tik'lentz xkyajten, ex ktma'ju' pale qa ẍtilun.</para>
  <para style="pi">
    <verse number="24" style="v" />Qa ati jun mab'aj tz'e'y, extzun qama q'ancha'linju' tchib'jil saq mujqa saqẍkyaqinin mujqa saq ka'yin tojku'ju' tchib'jil b'ajni tz'e'y, <verse number="25" style="v" />k'okel tka'yi'nju' pale. Qama txi' saqaxju' t-smal toju' tik'len, exqa makux lo'n toju' tchib'jil b'ajni tz'e'y, xlemtx'a'ktzuntz xjaw poq'li; ktma'tzun paletz qa tz'il tu'n tpaju' xlemtx'a'k ti'j. <verse number="26" style="v" />Qatzun ajtok tka'yi'n paleju' tx'a'k, qa mixti' jun t-smal saq ex min kuxni lo'nju' tchib'jil, kxi'pe' tkub' naj, k'okex tjpu'n wuq q'iju' xjal lu. <verse number="27" style="v" />K'okel tka'yi'n jumajtlju' pale toj twuqi'n q'ij, qatzun matxi mlenju' tx'a'k ti'j tchib'jil, ktma' qa tz'ilju' xjal lu, qu'n xlemtx'a'kju' ati ti'j. <verse number="28" style="v" />Qatzun min xxi' mlenju' tx'a'k ti'j tchib'jil ex kxi' tkub' naj, tzleq'intzun te tz'e'ynaqtz, ktma'tzun paletz qa ẍtilunju' yab', qu'n naqna' tik'len te tz'e'ynaqju'.</para>
  <para style="pi">
    <verse number="29" style="v" />Qa ati jun ichan mujqa jun qya ati jun tx'a'k toj twi' mujqa toj t-xmatzi. <verse number="30" style="v" />K'okel tka'yi'n paleju' tx'a'k, qa kuxni lo'nju' tchib'jil tu'n exqa ẍq'anju' t-smal ex mya jupli, ktma'tzun paletz qa tz'ilju' xjal lu, qu'n xlemtx'a'k ati toj twi' ex toj ttxmatziy. <verse number="31" style="v" />Qatzun min kuxni lo'n toj twi'ju' xjal tu'n tx'a'k ajtok tka'yi'n pale exqa mixti' t-xya'mal q'eq, k'okex tjpu'n wuq q'iju' xjal. <verse number="32" style="v" />Tojtzun twuqi'n q'ij k'okel tka'yi'n jumajtlju' pale, qatzun min xxi' mlenxi'xtlju' tx'a'k, qa min xku'x lo'nju' tchib'jil tu'n ex mixti' t-xya'mal ẍq'an, <verse number="33" style="v" />Ktma'tzun paletz tu'n tel joyet twi' mujqa t-xmatzi xjal yab', naq o'kx lay tz'el joyetju' jata' tx'a'k, ex k'okex tjpu'n wuq q'ijtel. <verse number="34" style="v" />Tb'ajlenxi'tzu'n wuq q'ijtl k'okel tka'yi'n paleju' tx'a'k, qatzun na'mx t-xi' mlen ex minti' xku'x lo'n toj tchib'jil, ktma'tzun paletz qa ẍtilunju' xjal, atzu'n xjal lu kttx'ja'ju' ti'j ex kjelten ẍtilun. <verse number="35" style="v" />Qatzun kxi' t-xi' mlenju' tx'a'k ti'j tchib'jil tb'ajlen q'met qa ẍtiluntl. <verse number="36" style="v" />Ati tu'n tok tka'yi'n jumajtl paleju' xjal yab'; qa matxi' txi' mlen jun majtlju' tx'a'k ti'j tchib'jil; mixti' in nojqelantl tu'n tok tka'yi'n t-smal qa ẍq'antl: tz'ilte' xjal lu. <verse number="37" style="v" />Qatzun ajtok tka'yi'n matxi' we'ju' tx'a'k ex mach'iy t-xya'mal q'eq, matxitzun b'anix te tx'a'ktzu' ex ẍtilunju' xjal. Ktma'tzun paletz qa ẍtilunju' xjal lu.</para>
  <para style="pi">
    <verse number="38" style="v" />Qa ati jun ichan mujqa qya kxi' tjaw punq'ij tchib'jil, <verse number="39" style="v" />k'okel tka'yi'n paleju' tchib'jil, qa saq mujqa sjumj ka'yin, naq a' te' xjaw punq'ij ti'j; ẍtilun te' xjal.</para>
  <para style="pi">
    <verse number="40" style="v" />Qa maku'tz q'ulj twi' jun ichan ex makejten ẍle'j, ẍtilun te' xjal lu. <verse number="41" style="v" />Qa maku'tz q'ulj twi' tib'aju' tplaj ex makyej tenju' tplaj ẍle'j, ex ẍtilun te' xjal lu. <verse number="42" style="v" />Qatzun matz'etz jun tx'a'k saq ka'yin ex ẍkyeqinin toju' twi' ẍle'j, maskye ti'j twi' mujqa twitz, xlemtx'a'ktzuntz xi' tetz ti'j. <verse number="43" style="v" />K'okel tka'yi'ntzun paletz, qatzun saq ka'yinju' malni teju' tx'a'k ex ẍkyaqinin toju' kyajni ẍle'jix, kse'n ka'yin xlemtx'a'k ti'j tchib'jil, <verse number="44" style="v" />yab' te' ichan lu tu'n xlemtx'a'k, qu'n ati tx'a'k toj twi'. Tz'ilte' ichan lu, ex ktma'ju' pale qa tz'il.</para>
  <para style="pi">
    <verse number="45" style="v" />Aju' ati ttx'a'kal xlemtx'a'k ti'j, ati tu'n toktq'o'n ti'j ẍla'q ex lay jawx toj twi', ktxu'ninin twitz ex in ẍch'inxi' qa tz'il. <verse number="46" style="v" />Ex k'okel q'et te ichan tz'il toju' tq'ijlalil ati tx'a'k ti'j; ex ati tu'n tnajan tjunalx ti'jxi'ju' najb'il.</para>
  <para style="pi">
    <verse number="47" style="v" />Qa ati jun tz'il majx makyajten ti'j jun xb'alun lan mujqa sed chub'i'ntwitz, <verse number="48" style="v" />mujqa ti'j jun chemuj sed chub'i'ntwitz mujqa Lan, mujqa ti'j jun tz'u'n, mujqa ti'j alkyexku' ti'xti' b'incha'n tu'n tz'u'n, <verse number="49" style="v" />qatzun cha'xinin mujqa kyeqinin ka'yinju' tz'il kyi'ju' ti'xti' lu, tik'len xlemtx'a'k te', ati tu'n t-xi' yek'et te pale. <verse number="50" style="v" />K'okel tka'yi'n paleju' tz'il ex k'okex tjpu'n wuq q'iju' ti'xti' lu. <verse number="51" style="v" />Tojtzun twuqi'n q'ij okb'ajel tka'yi'n paleju' tz'il, qa matxitoq txi' mlen ti'ju' xb'alun mujqa xb'alun chmo'n, ti'j tz'u'n mujqa ti'xti' tz'u'nqe', ttz'ilil tx'a'k taq'wixi'xte', aye'tzu'n ti'xti' che kjelten tz'il. <verse number="52" style="v" />Iktzu'n tkyaqil ti'xti' qa atiju' tz'il lu ti'j, ati tu'n kykub' tz'e'yset tejumajx, qu'n xlemtx'a'k taq'wixi'xte'; <verse number="53" style="v" />qatzun matz'ok tka'yi'n pale exqa matz'elyal min xxi' mlenju' tz'il, <verse number="54" style="v" />ktma' tu'n tel txjetju' tz'il ex tu'n tokx jpet wuq q'ijtlu' ti'xti'.</para>
  <para style="pi">
    <verse number="55" style="v" />Tb'ajlenxi' txjetju' tz'il, kb'ajel tka'yi'n pale. Qatzun matz'ok tka'yi'n qa na'mx tnaju' tz'il, taq'wix tz'iltzuntz, ilti'j tu'n tkub' tz'e'ysetju' ti'xti' lu, maskye na'mxtoq t-xi' mlenju' tz'il, qu'n ch'i'naq t-xi' tlo'n, tojxi' mujqa ti'jxi'. <verse number="56" style="v" />Aj tka'yintel paleju' tz'il qa matxitoq kub'naj tb'ajlenxi' txjet, k'eletz ttiq'i'n ti'ju' xb'alun, mujqa tz'u'n mujqa chemuj. <verse number="57" style="v" />Qatzun maq'ancha'lix junmajtl ex matxi mlentl ti'ju' xb'alun, ti'j chemuj mujqa ti'j ti'xti' tz'u'n, kb'el tz'e'ysetju' ti'xti' b'ajni txa'j. <verse number="58" style="v" />Atzu'n xb'alun chmo'n mujqa jun ti'xti' tz'u'n jatoka'toqju' tz'il ajtb'aj txjet, ktx'jetel jumajtl ex kjeltzuntz ẍtilun, chi Dyos.</para>
  <para style="p">
    <verse number="59" style="v" />Aye'tzun xnaq'tzb'il ja'lu ti'j jwe' ttz'ilil xlemtx'a'k, ti'j xb'alun lan, mujqa sed, mujqa ti'j xb'alun chmo'n, mujqa ti'xti' tz'u'n, tu'ntzun kq'met qa ẍtilun mujqa tz'il.</para>
  <chapter number="14" style="c" />
  <para style="s1">Chik'b'ab'l tu'n kyẍtilsetju' yab'qe' tu'n xlemtx'a'k</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj tma'n Qman Dyos te Moyses kjalu:</para>
  <para style="pi">
    <verse number="2" style="v" />Aye' chik'b'ab'l ja'lu tu'n t-ẍtilset jun yab' tu'n xlemtx'a'k: ati tu'n t-xi' iq'et twitz pale, <verse number="3" style="v" />k'elexju' pale ti'jxi'ju' najb'il tu'n tok tka'yi'n. Qa matxitoq b'anixju' xlemtx'a'k ti'ju' yab', <verse number="4" style="v" />kxe'l tma'n tu'n kytzaj iq'i'n kab'e' tal pich' ẍtilun ex itz'qe', tze k'ute, xb'alun kyeqka'yin ex k'ak'ul, teju' ati tu'n t-ẍtilset. <verse number="5" style="v" />Kxe'l tma'n tu'n tkub' b'yet junju' tal pich' tib'aj jun tx'otx' k'wil atku'x a' toj tzajnix toj t-xiklil, <verse number="6" style="v" />ex ktzajel tiq'i'n tal pich' itz', exju' tze k'ute, xb'alun kyeqka'yin exju' k'ak'ul, kche kb'el tak'sa'nju' ti'xti' lu exju' tal pich' itz' tu'n tchk'elju' pich' kyimnitl tib'aju' a' tzajni toj t-xiklil. <verse number="7" style="v" />K'okeltzun twitxk'a'n wuq maju' chik' ti'ju' kẍtilsetel teju' xlemtx'a'k, ktma'tzuntz qa ẍtilun. Atzunju' tal pich' itz' kxel ttzaqpi'n.</para>
  <para style="pi">
    <verse number="8" style="v" />Ati tu'n ttxjonte t-xb'alunju' maẍtilset, ex kb'ajel ttxjo'ntib', k'elel tjso'n tkyaqilju' t-smal, tu'ntzun tkyejten ẍtilun. Yajxi'tzuntel b'a'n tu'n tokx toju' najb'il, ex ati tu'n tkyej ten wuq q'ijtl najal twipe'n. <verse number="9" style="v" />Tojtzun twuqi'n q'ij k'elel t-sk'o'ji'nju' twi', kb'je'lel tjso'n t-xmatzi ex kyib'aj twitz, ex tkyaqilju' t-smal, kttx'ja' t-xb'alun ex ktxja'tib', kjeltzuntz ẍtilun. <verse number="10" style="v" />Ktzajel tiq'i'n kab'e' qpoj tman rit mixti' kytzakajil toj twajxaqi'n q'ij, ex jun qpoj ttxu rit te jun ab'q'i mixti' ttzakajil; ex masch'i'n kyajlajoj (14.3) lib'r tb'anil arin te jun oyaj xyuq'i'n tuk'i'l aseyt, ex nik'jan litr aseyt. <verse number="11" style="v" />Kb'el q'o'nju' xjal kẍtilsetel exqe'ju' ti'xti', ttziju' Ja Te Mujb'ab'ltib'il nwitzku'ye' ayine' Dyos Manb'aj, tu'nju' pale kb'inchalteju' ẍtilsab'l. <verse number="12" style="v" />Ktzajeltzun tiq'i'n junju' qpoj tman rit ex kb'eltq'o'n junx tuk'i'lju' nik'jan litr aseyt, te jun chojb'il tu'n tten b'a'n wuk'i'le', kxel t-se'nju' tu'me'l tu'n tkub' q'etju' chojb'il nwitze'. <verse number="13" style="v" />Kb'el b'yetju' qpoj tman rit ja tu'me'l xjansa'n tu'n kykub' b'yetju' alu'mj te chojb'il tu'n tpaj il ex chojb'il k'oksb'il. Aju' chojb'il tu'n tten xjal b'a'n wuk'i'le' kxe'l teju' pale, ex ikxju' chojb'il tu'n tpaj il, qu'n xjanxi'xte'.</para>
  <para style="pi">
    <verse number="14" style="v" />Kjawiltzun tiq'i'n pale ch'i'n tchk'elju' chojb'il tu'n tten xjal b'a'n wuk'i'le', ex k'okyel t-sun ti'j t-ẍkyinju' xjal in ẍtilset toj tb'a'nq'ob', ti'j tman tq'ob' te tb'a'nq'ob' ex ti'j tman twitqan te tb'a'nq'ob'. <verse number="15" style="v" />Ktzajeltzun tiq'i'n ch'i'n aseyt ex kb'eltq'o'n toju' tq'ob' te tnayaj; <verse number="16" style="v" />kb'elex tak'sa'ntzun twitq'ob'tz te tb'anq'ob' toju' aseyt tkub' toj tq'ob' ex kxel twitxk'a'n wuq maju' aseyt tu'n twitq'ob' nwitze'. <verse number="17" style="v" />Kjawiltzun tiq'i'n pale ch'i'n aseyt ti'ju' atix toj tq'ob' tu'n tokt-sun ti'j t-ẍkyinju' xjal in ẍtilset te tb'anq'ob', ti'ju' tman tq'ob' te tb'anq'ob' ex ti'ju' tman twitqan te tb'anq'ob', jaxju' b'jo'ka' t-suna' tchk'elju' chojb'il tu'n tten b'a'n wuk'i'le', <verse number="18" style="v" />atzunju' aseyt min xb'aj kjawix t-sun toj twi'ju' in t-ẍtilsa'ntib'. Iktzu'n kknetela' najsb'il tilju' xjal lu nwitze' tu'n pale. <verse number="19" style="v" />Kb'eltzun tq'o'n paleju' chojb'il tu'n tpaj il, iktzu'n ktb'incha'ya' ẍtilsab'l teju' mya ẍtilun; yajxi'tzuntel kb'el tq'o'nju' alu'mj te chojb'il k'ok'sb'il, <verse number="20" style="v" />kb'eltq'o'n tib'aj q'olb'eb'l junx tuk'i'lju' oyaj twitz awal k'ok'e'kwitz. Iktzu'n kknetela' najsb'il tilju' xjal lu tu'n pale, kyjeltzuntz ẍtilun.</para>
  <para style="pi">
    <verse number="21" style="v" />Qatzun prowju' xjal yab' ex mixti'xi'x tu'me'l tu'n, ktzajel tiq'i'n jun qpoj tman rit te chojb'il tu'n tten b'a'n wuk'i'le', kb'el tq'o'ntzuntz te jun oyaj tb'anilxi'x tu'n kynajsetju' til, tuk'i'l kyaje' lib'r tk'i' nik'jan arin tb'anilxi'x xyuq'i'n tuk'i'l aseyt, te jun oyaj ti'j twitz awal k'ok'e'kwitz, ex ch'intlmi nik'jan litr aseyt, <verse number="22" style="v" />ex kab'e' tal xlak'uk' mujqa kab'e' tal paloms kse'nxju' tipumal, jun tu'n t-xi' q'et te chojb'il tu'n tpaj il, atzu'n juntl te jun chojb'il k'ok'sb'il. <verse number="23" style="v" />Kxe'l tiq'i'n tkyaqilju' lu toj twajxaqi'n q'ij teju' pale, te ẍtilsb'ilte; ktzajel tq'o'n nwitze', ttziju' Ja te Mujb'ab'ltib'il. <verse number="24" style="v" />Ktzajel tiq'i'n paleju' qpoj tman rit te chojb'il tu'n tten b'a'n wuk'i'le' exu' ch'intlmi nik'jan litr aseyt, kb'el tq'o'ntzuntz nwitze' te jun oyaj tb'anilxi'x; <verse number="25" style="v" />kb'el tb'yo'nju' qpoj tman rit te chojb'il tu'n ten b'a'n wuk'i'le' ex kjawil tiq'i'n ch'i'n tchk'elu' qpoj tman rit, k'okyel tb'aku'n ti'j t-ẍkyinju' nt-ẍtilsa'ntib' te tb'anq'ob', ti'j tman tq'ob' te tb'anq'ob' ex ti'ju' tman twitqan te tb'anq'ob'; <verse number="26" style="v" />ex kb'eltq'o'n ch'i'n aseyt toj tq'ob' te tnayaj, <verse number="27" style="v" />kxeltzun twitxk'a'n wuq maj ch'i'n aseyt nwitze' tu'n twitq'ob' te tb'anq'ob' ti'ju' aseyt ati toj tq'ob'. <verse number="28" style="v" />Ex ikx k'okyel tb'aku'n ch'i'n aseyt ti'j t-ẍkyinju' xjal in t-ẍtilsa'n te tb'anq'ob', ti'ju' tman tq'ob' te tb'anq'ob' ex ti'ju' tman twitqan te tb'anq'ob', jaxu' soka' tb'aku'n tchk'elju' chojb'il tu'n tten b'a'n wuk'i'le'. <verse number="29" style="v" />Atzunju' ch'i'ntl aseyt xkyaj kjawix tb'aku'n pale toj twi'ju' xjal in t-ẍtilsa'ntib', tu'ntzun tkub' nnajsa'ne' til, ayine' Dyos Manb'aj. <verse number="30" style="v" />Kb'eltzun tq'o'n pale jun tal xlak'uk' mujqa jun tal paloms, se'nxju' kb'entel tq'onteju' nt-ẍtilsa'ntib'. <verse number="31" style="v" />Junju' tal pich' kb'el te chojb'il tu'n tpaj il, atzu'n juntl te chojb'il k'ok'sb'il, tib'ajxi'tlju' oyaj twitz awal k'ok'e'kwitz. Iktzu'n ktk'ma'ya' pale najsb'ilte tilju' xjal nt-ẍtilsa'ntib' nwitze', chi Qman Dyos te Moyses.</para>
  <para style="p">
    <verse number="32" style="v" />Aye'tzun xnaq'tzb'ilju' kyeju' yab' tu'n xlemtx'a'k, ju' mixti' tu'me'l tu'n kyq'onte jun oyaj nim tu'n kyẍtilsante kyib'.</para>
  <para style="s1">Chik'b'ab'l tu'n kyẍtilsetju' ja nche sb'akyix</para>
  <para style="p">
    <verse number="33" style="v" />Tzaj tma'n Qman Dyos kye Moyses ex Aaron kjalu:</para>
  <para style="pi">
    <verse number="34" style="v" />Qama tzaj nq'o'ne' nim txqan sb'ak toj jun ja toj kytaname', kse'n ate'qe'tle' toju' tx'otx' Kanaan, ju' kxe'l nq'o'ne' kyeye' te kyetzb'ile', <verse number="35" style="v" />kxe'lju' tajaw ja nelteju' pale ex kxe'l tma'n te: Naku'j matxi' sb'akyixju' njaye', chiku'.</para>
  <para style="pi">
    <verse number="36" style="v" />Nejl kxel tma'nju' pale tu'n kyb'je'tz iq'i'nju' ati toj, tu'ntzun lalun che b'ajtz'ilix tkyaqilju' ati toj. K'okyextzuntz ka'yilteju' sb'ak.</para>
  <para style="pi">
    <verse number="37" style="v" />Ajtzun tok tka'yi'n paleju' sb'ak, qa atiyile twitzju' ttapiyil ja cha'xinin mujqa kyeqinin ka'yin, exqa in che'x yeq'li toju' tapi, <verse number="38" style="v" />k'eletz toju' ja ex ktma' tu'n tkyaj jpet wuq q'iju' ja. <verse number="39" style="v" />Tojtzun twuqi'n q'ij k'okel tka'yi'n jumajtlju' pale, qatzun matxi mlenju' sb'ak ti'ju' ttapiyil ja, <verse number="40" style="v" />kxel tma'ntzuntz tu'n kyel iq'etju' ab'j ati sb'ak kyi'j ex tu'n kyxi' xoyit jata' txqan tz'il ti'jxi' nintnam; <verse number="41" style="v" />Ex kxe'l tma'n tu'n tb'aj jset tkyaqilu' tojxi' ja ex tu'n tex xoyet ti'jxi' nintnam tkyaqilju' quq mab'je'l jset, jata' txqan tz'il. <verse number="42" style="v" />Kche tzajel iq'ettzun txqantl ab'jtz tu'n tok kyxelju' ẍe el iq'et, ex ak'a'j b'a'ntx'otx' tu'n tktxetl toju' ja.</para>
  <para style="pi">
    <verse number="43" style="v" />Qatzun masb'akyix jumajtlju' ja tb'je'lenxi' iq'etju' ab'j ex tb'ajlen jset twitz ttapiyilju' ja ex tb'ajlenxi' ktxet jumajtl, <verse number="44" style="v" />k'okyex jumajtlju' pale ka'yilte. Qama txi' mlenju' sb'ak toju' ja, taq'wixi'x sb'aktzuntz ex tz'iltlju' ja. <verse number="45" style="v" />Qu'mtzun ati tu'n tkub' xitetju' ja, ex tkyaqilx kxel xoyit jata' txqan tz'il ti'jxi' nintnam. <verse number="46" style="v" />Alkyexku' matz'okx toju' ja toju' tq'ijlalil kyejtma'n pale tu'n tjpet, kjelten tz'il tzmaxi'j ajqok yupj. <verse number="47" style="v" />Alkyexku' mawan mujqa mawtan toju' ja, ati tu'n ttxjonte t-xb'alun tu'n t-ẍtilset.</para>
  <para style="pi">
    <verse number="48" style="v" />Qatzun ajtokxju' pale ka'yilteju' ja, qama til min xxi' mlentlju' sb'ak tb'ajlenxi' ktxet jumajtl toj, ktma'tzuntz qa ẍtiluntlju' ja, qu'n matxi' kub' naju' sb'ak. <verse number="49" style="v" />Tu'ntzun t-ẍtilsetju' ja, ktzajel tiq'i'n kab'e' tal pich', tze k'ute, xb'alun kyeqka'yin ex k'ak'ul. <verse number="50" style="v" />Kb'el tb'yo'n junju' tal pich' tib'aj jun tx'otx' k'wil nojni tu'n a' tzajnix toj t-xiklil. <verse number="51" style="v" />Ktzajel tiq'i'ntzun k'utetz, k'ak'ul, xb'alun kyeq, exju' tal pich' itz', che kb'elex tak'sa'ntzuntz toj tchk'elju' tal pich' kyimnitl ex toju' a' tzajni toj t-xiklil, kxel twitxk'a'ntzun wuq majtz ti'ju' ja. <verse number="52" style="v" />Iktzu'n kẍtilsetela'ju' jatu'n tchk'elju' tal pich' tuk'i'lju' a' tzajnix toj t-xiklil, ex tal pich' itz', ex k'ute, ex k'ak'ul exju' xb'alun kyeq. <verse number="53" style="v" />Yajxi'tzuntl kxel ttzaqpi'n tal pich' itz' ti'jxi' nintnam, ikytzun ktb'incha'ju' tu'n t-ẍtilsetju' ja, chi Dyos.</para>
  <para style="p">
    <verse number="54" style="v" />Aye'tzun xnaq'tzb'ilju' ti'j alkyexku' yab'il tu'n xlemtx'a'k, ẍal, tx'a'k, <verse number="55" style="v" />psuq' ti'j xb'alun ex sb'ak ti'j ja, <verse number="56" style="v" />malni ex b'je'tzni poq'li, ex tz'il majx inkyajten, <verse number="57" style="v" />tu'ntzun tel kynik'tzilju' ẍtilun exju' mya ẍtilun. Iktzun xnaq'tzb'ilju' tib'aju' xlemtx'a'k.</para>
  <chapter number="15" style="c" />
  <para style="s1">Xnaq'tzb'il tib'aj ttz'ilil ichan</para>
  <para style="p">
    <verse number="1-2" style="v" />Tzaj tma'n Qman Dyos kye Moyses ex Aaron tu'n t-xi' kyma'n kye aj Israel kjalu:</para>
  <para style="pi">Qama tzaj yab'il toj ttz'a'lb'il jun ichan, kjelten tz'il. <verse number="3" style="v" />Aju' tz'il tu'n tpaju' ij yab'tl inel qojl kukxju' toj twi'ju' ttz'a'lb'il mujqa mamqet toj twi' ttz'a'lb'il tu'nxju' yab'il, tu'nju' lu in kyejten xjal tz'il.</para>
  <para style="pi">
    <verse number="4" style="v" />Jaxjaku' makub'a' kẍeju' ichan lu ex ja makyaja' qojl txqantl tu'n, kjel tz'il.</para>
  <para style="pi">Alkyexku' ti'xti' jamakub'a' qe, kjel tz'il.</para>
  <para style="pi">
    <verse number="5" style="v" />Alkyexku' matxi tzyunteju' jamakub'a' kẍeju' ichan lu, ati tu'n ttxjonteju' t-xb'alun ex tu'n ttxjontetib' tu'n a', ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="6" style="v" />Alkyexku' makub' qe tib'aj tq'uqb'lenju' ichan lu, ati tu'n ttxjonteju' t-xb'alun ex tu'n ttxjontetib' tu'n a', ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="7" style="v" />Alkyexku' matxi tzyunteju' inel qojl ij ti'j, ati tu'n ttxjonteju' t-xb'alun ex tu'n ttxjontetib' tu'n a', ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="8" style="v" />Qama tz'ok ttzub'a'nju' yab' ti'j jun xjal b'a'n, aju' xjal lu ati tu'n ttxjonteju' t-xb'alun ex tu'n ttxjontetib' tu'n a', ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="9" style="v" />Alkyexku' iqb'il xjal ti'j chej matz'ajb'en tu'nju' inel qojl ij toj twi' ttz'a'lb'il, kjelten tz'il.</para>
  <para style="pi">
    <verse number="10" style="v" />Alkyexku' matxi tzyunte jun ti'xti' jamakub' qeya'ju' yab' lu, kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">Alkyexku' matxi iq'inte junju' ti'xti' lu, ati tu'n ttxjonteju' t-xb'alun ex tu'n ttxjontetib' tu'n a', ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="11" style="v" />Alkyexku' matz'ok tzyunteju' in qojl ij ti'j exqa mixti' xtx'jon tq'ob', ati tu'n ttxjonte t-xb'alun ex tu'n ttxjontetib' tu'n a', ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="12" style="v" />Ati tu'n tkub' pa'yetju' tx'otx' k'wil qama txi' ttzyu'nju' inel qojl ij ti'j; aye'tzu'n ti'xti' tzeqe' ati tu'n kytx'jet.</para>
  <para style="pi">
    <verse number="13" style="v" />Qatzun mab'anixju' ichan lu teju' tyab'il tu'n ij, ati tu'n t-ẍtilsantetib' toj wuq q'ij; kttxja'ju' t-xb'alun ex kttxja'tib' tu'n a' tzajnix toj t-xiklil, kjeltzuntz ẍtilun. <verse number="14" style="v" />Tojtzun twajxaqi'n q'ij ktzajel tiq'i'n kab'e' xlak'uk' mujqa kab'e' tal paloms, kxe'ltzuntz ttziju' Ja te Mujb'ab'ltib'il tu'n t-xi' tq'o'n teju' pale nwitze'. <verse number="15" style="v" />Atzu'n pale kb'eltq'o'n jun te chojb'il tu'n tpaj il, atzu'n juntl te chojb'il k'ok'sb'il, iktzu'n ktb'incha'ju' ẍtilsab'l teju' ichan yab' tu'n ij nwitze' ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="16" style="v" />Qa ati jun ichan matz'el qojlju' ij toj twi' ttz'a'lb'il, kttxja'tib' tkyaqilju' t-xmilal toj a' ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="17" style="v" />Alkyexku' xb'alun mujqa tz'u'n makub' qojlju' ij tib'aj, ati tu'n txjet tu'n a' ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="18" style="v" />Qama kub' kẍe jun ichan tuk'i'l jun qya, kykab'ilx ati tu'n kytx'jonte kyib' tu'n a' ex che kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="s1">Xnaq'tzb'il tib'aj kytz'ilil qya</para>
  <para style="pi">
    <verse number="19" style="v" />Ajtkb'u'l ttx'ajin jun qya, kjelten wuq q'ij tz'il.</para>
  <para style="p">Alkyexku' matxi tzyunte, kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="20" style="v" />Alkyexku' ti'xti' jamakub'a' kẍeju' qya lu toju' tq'ijlalil aj tkb'u'lju' ttx'ajin, kjelten tz'il.</para>
  <para style="pi">Alkyexku' ti'xti' jamakub'a' qe, kjelten tz'il.</para>
  <para style="pi">
    <verse number="21" style="v" />Alkyexku' matxi tzyunteju' tkuẍb'len, ati tu'n txjonteju' t-xb'alun ex tu'n ttxjontetib' tu'n a', ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="22" style="v" />Alkyexku' matxi tzyunte jun ti'xti' jamakub'a' qeju' qya lu, ati tu'n ttxjonteju' t-xb'alun ex tu'n ttxjontetib' tu'n a', ex kjelten tz'il tzmaxi'j ajqok yupj. <verse number="23" style="v" />Qama txi' ttzyu'nju' tkuẍb'len mujqa tq'uqb'lenju' qya lu, kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="24" style="v" />Qama kub' kẍe jun ichan tuk'i'lju' qya lu, matxi' tz'el tiqa'nju' ttz'ilil, kjel tentzun wuq q'ijtz tz'il, ex ikxju' jamakub'a' kẍe.</para>
  <para style="pi">
    <verse number="25" style="v" />Qa nab'en ati jun qya matz'el qojl chik' ti'j na'mxtoq tjapun tq'ijlalil tu'n tkb'u'lju' ttx'ajin, exqa maqojl b'a'npun q'ij, mujqa matenxi'xtl tq'ijlalilju' ttx'ajin, kjelten tz'il tzmaxi'j aj tqjenju' chik' ti'j, naku'xwitloj kse'n aj tkb'u'lju' ttx'ajin.</para>
  <para style="pi">
    <verse number="26" style="v" />Jaxjaku' mawtana'ju' qya lu ex alkyexku' ti'xti' jamakub'a' qe akxku' in qojlu' chik' ti'j, kjelten tz'il, ikxju' kse'n ati toj tq'ijlalil aj tkb'u'lju' ttx'ajin.</para>
  <para style="pi">
    <verse number="27" style="v" />Alkyexku' matxi tzyunkyeju' ti'xti' lu, kjelten tz'il. Ati tu'n ttxjonte t-xb'alun ex tu'n ttxjontetib' tu'n a', ex kjelten tz'il tzmaxi'j ajqok yupj.</para>
  <para style="pi">
    <verse number="28" style="v" />Ajtzun tqjenju' chik' ti'j, b'a'n tu'n t-xi' tajla'n wuq q'ij, tb'ajlenxi'tzu'n wuq q'ij kjel ẍtilun. <verse number="29" style="v" />Tojtzun twajxaqi'n q'ij ktzajel tiq'i'n kab'e' tal xlak'uk' mujqa kab'e' tal paloms, che kxel tiq'i'ntzuntz teju' pale ttziju' Ja te Mujb'ab'ltib'il. <verse number="30" style="v" />Kb'eltq'o'n pale jun te chojb'il tu'n tpaj il, atzu'n juntl te chojb'il k'ok'sb'il. Iktzun ktb'incha' paleju' nwitze' ayine' Dyos Manb'aj tu'n t-ẍtilsetju' qya teju' chik' sel qojl ti'j, <verse number="31" style="v" />ikytzu'n che elela' kylaq'b'a'ne' aj Israel ti'ju' kytz'ilil, tu'n lalun che kyim tu'ntpaj qama b'aj kytz'ilsa'n najb'il ja najla' qine' kyxole', chi Dyos.</para>
  <para style="p">
    <verse number="32" style="v" />Aye'tzun xnaq'tzb'il ja'lu kyi'ju' ichan inel qojl ij toj twi' kytz'a'lb'il ex kyi'ju' inel qojl junjun maj kyi'j, ju' inche kyejten tz'il tu'nju' yab'il lu; <verse number="33" style="v" />ex kyi'ju' qya inkb'u'l kytx'ajin toj xjawi'n ex kyi'ju' naqx in kb'u'l qojl chik' kye na'mtoq tkb'u'lju' kytx'ajin. Aye'tzun xnaq'tzb'ilju' tu'n tb'inchet kyeju' ichan mujqa kyeju' qya, ex kyeju' ichan inche kub'kẍe tuk'i'l jun qya ati toj tq'ijlalil ttx'ajin.</para>
  <chapter number="16" style="c" />
  <para style="s1">Tq'ij najsb'il</para>
  <para style="p">
    <verse number="1" style="v" />Yolin Qman Dyos tuk'i'l Moyses kykyimlenxi' kab'e' tk'wal Aaron, ju' e'kyim tu'n tpaj exi'lq'exi'x twitz Qman Dyos. <verse number="2" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n te Aaron, ju' ttzik:</para>
  <para style="pi">Mixti' tu'n tokx alkyexku' kmoj toju' ja xjan ati ti'jxi'ju' xb'alun te aq'pub'l ex twitz tjpelju' kax k'ub'lteju' yol kyejni b'entti'j, tu'ntzun lalun Kyim; qu'n knyek'u' wib'e' toj muj tib'aju' tjpel kax. <verse number="3" style="v" />Ati tu'n tokx Aaron toju' ja xjan tuk'i'l jun qpoj tman wakx te chojb'il tu'n tpaj il ex jun tman rit tu'n tkub' tq'o'n te chojb'il k'ok'sb'il. <verse number="4" style="v" />Ati tu'n tok toksa'nkju' t-xb'alun ku'j sed xjansa'n, ktxu'nju' t-xmilal tu'n kalsonsiy sed, ex tokju' k'alb'il tk'u'j ex ẍipb'il twi' sed. Xjansa'nqe'ju' xb'alun lu, qu'mtzun ati tu'n ttxjontetib' tu'n a' na'mtoq kyok toksa'n.</para>
  <para style="pi">
    <verse number="5" style="v" />Atzu'n kye' aj Israel ktzajel kyq'o'n kab'e' chib' te Aaron te chojb'il tu'ntpaj il, ex jun tman rit tu'n tkub' q'et te chojb'il k'ok'sb'il. <verse number="6" style="v" />Kb'el tq'o'ntzun tman wakxtz te chojb'il tu'n tpaju' til, tu'ntzun tkub'najsetju' til ex kyilju' toj tja. <verse number="7" style="v" />Yajxi'tzuntl kche tzajel tiq'i'nju' kab'e' chib' ex che kb'eltq'o'n nwitze' ttziju' Ja te Mujb'ab'ltib'il; <verse number="8" style="v" />kxel t-se'ntzuntz tu'n teltnik' kyi'ju' kab'e' tman chib' lu alkyeju' weye' ex alkye kxel tzaqpet tu'n t-xi' tiqa'n kyil xjal. <verse number="9" style="v" />Aju' chib' xkub' tz'aq weye', kb'eltq'o'n Aaron te chojb'il tu'n tpaj il; <verse number="10" style="v" />atzunju' chib' xkub' tz'aq tu'n t-xi' tzaqpet, kb'eltq'o'n itz' nwitze' ayine' Dyos Manb'aj tu'ntzun tnajset kyilju' tnam, okxe'l tzaqpettzuntz ex kxel q'et toj chq'ajlaj.</para>
  <para style="pi">
    <verse number="11" style="v" />Kb'eltq'o'n Aaron ju' qpoj tman wakx te chojb'il teku' tu'n tpaj il, tu'n tnajsetju' til ex kyilju' toj tja. <verse number="12" style="v" />Ktzajel tiq'i'ntzun jun xq'aq'b'iltz nojni tu'n ttxalq'aq' tzajni tib'aju' q'olb'eb'l ati nwitze', ex kab'e' txab' sturak k'ok'sb'il chen, ex kxe'l tiq'i'n ti'jxi'ju' xb'alun te aq'pub'l; <verse number="13" style="v" />k'okyex tq'o'nju' sturak tib'aju' q'aq' nwitze', ex kb'el noj ti'ju' tjpel kax k'ub'lteju' yol kyejni b'entti'j tu'n t-sb'elju' sturak. Laytzun kyim Aarontz ikju'. <verse number="14" style="v" />Ex kjawil tiq'i'n ch'i'n tchk'elju' qpoj tman wakx, kxel twitxk'a'ntzuntz tu'n twitq'ob' tib'aju' tjpel kax tu'me'l tjawetzq'ij. Ex kxel twitxk'a'n wuq maju' chik' tu'n twitq'ob' twitz tjpelju' kax, <verse number="15" style="v" />yajxi'tzuntl kb'el tb'yo'nju' chib' te chojb'il tu'n tpaj kyilju' tnam ex k'okex tiq'i'nju' chik' ti'jxi'ju' xb'alun te aq'pub'l; atzuntzu' kb'el twitxk'a'n tib'aj ex twitzju' tjpel kax, kse'nxju' tb'incha tu'nju' tchk'el qpoj tman wakx. <verse number="16" style="v" />Iktzu'n kt-ẍtilsa'ju' ja xjan te tkyaqilju' kytz'ilil, kypi'sal ex kyil aj Israel. Ex ikx tu'n tb'inchanteju' ti'ju' Ja te Mujb'ab'ltib'il, ju' ati kyxol tuk'i'lju' kytz'ilil.</para>
  <para style="pi">
    <verse number="17" style="v" />Akxku' ati Aaron toju' ja xjan tu'n tk'monteju' najsb'il il tzmaxi'j ajtetz, mix-a'lo' te ktenb'el toju' Ja te Mujb'ab'ltib'il. Ajtzun tk'monteju' najsb'il til, kyilju' toj tja ex kyil tkyaqilju' tnam Israel, <verse number="18" style="v" />k'eletztzuntz tu'n t-xi' ẍtilsalteju' q'olb'eb'l ati nwitze'. Ktzajel tiq'i'n ch'i'n kychk'elju' qpoj tman wakx ex tman chib', ex k'okel t-sun kyi'j tuk'a ex ti'jile q'olb'eb'l, <verse number="19" style="v" />ex kxel twitxk'a'n wuq maju' chik' tu'n twitq'ob' tib'aju' q'olb'eb'l. Iktzu'n kẍtilsetela'ju' tu'n teju' kytz'ilil aj Israel, ex kt-xjansa'.</para>
  <para style="pi">
    <verse number="20" style="v" />Ajtzun kyb'aj t-ẍtilsa'n Aaron ju' ja xjan, Ja te Mujb'ab'ltib'il exju' q'olb'eb'l, kxe'l tma'n tu'n ttzaj iq'i'n chib' itz'x <verse number="21" style="v" />ex kb'eltq'o'n tq'ob' tib'aj twi'ju' alu'mj, kxel tpa'ntzuntz tkyaqil kyil aj Israeltz tib'aj, tkyaqilju' kyb'inchb'aj taq'wix ex tu'nju' njaw kyi'nkyib' wi'je'. Iktzu'n che kb'ela' tq'o'nju' il tib'aj twi'ju' tman chib'. Ex jun xjal kxel q'inte tu'n t-xi' ttzaqpi'n toj chq'ajlaj. <verse number="22" style="v" />Iktzu'n aj t-xi' tzpetju' tman chib' toj chq'ajlaj, kxe'l tiq'i'n tkyaqilju' kyil jamixti'qe' xjal najla'qe'. <verse number="23" style="v" />Oktzun k'okyex Aarontz toju' Ja te Mujb'ab'ltib'il ex k'elel tiq'i'nju' t-xb'alun sed, ju' oktq'o'n tej tokx toju' ja xjan, kjel tq'o'ntzuntz atzu'. <verse number="24" style="v" />Axtzuntzu' kttxja'tib' tu'n a' toju' ja xjan, toklenxi'tzun tq'o'nju' t-xb'alun, k'eletz tu'n tkub' tq'o'nju' toyaj k'ok'sb'il, extzunju' kb'eltq'o'n tu'nelju' tnam, iktzu'n ktk'ma' najsb'il til ex kyilju' tman. <verse number="25" style="v" />Kb'el ttz'e'ysa'n t-untilju' chojb'il tu'n tpaj il tib'aj q'olb'eb'l; <verse number="26" style="v" />atzunju' xxi' q'inteju' chib' tu'n t-xi' tzaqpet toj chq'ajlaj kttx'ja' t-xb'alun ex kttxja'tib' tu'n a', b'a'ntzun tu'n tokxtzuntz toju' najb'il.</para>
  <para style="pi">
    <verse number="27" style="v" />Aye'tzu'n qpoj tman wakx ex tman chib' e'kub' q'et te chojb'il tu'ntpaj il, ju' xi' iq'etu' kychk'el toju' ja xjan tu'n tk'metju' najsb'il il, che kxe'l iq'et ti'jxi' najb'il, aye'tzu'n kytz'umal, kychib'jil ex kytxa, che b'eltz'e'yset. <verse number="28" style="v" />Ati tu'n ttxjonte t-xb'alunju' xjal kb'el tz'e'ysankye ex tu'n ttxjontetib' tu'n a', b'a'ntzun tu'n tokxtz toju' najb'il.</para>
  <para style="pi">
    <verse number="29" style="v" />Majx kjeltenju' kawb'il lu kyeye': ati tu'n kmewayine' toj tlajoji'n q'ij tajlalju' twuqi'n xjaw ex mixti' jun aq'untl tu'n kyb'inchanteye', kykyaqilx aj Israel exqe' najchaq xjal najliqe' kyxole', <verse number="30" style="v" />qu'n kyk'ma'ju'ye' najsb'il kyile' nwitze' ayine' Dyos Manb'aj toju' q'ij lu, che kjele' ẍtilun te tkyaqilju' kyile'. <verse number="31" style="v" />Jun kawb'ilte' majx kjelten: k'okelju' q'ij lu nim toklen kyeye' te ojlab'l ex te mewayi'n. <verse number="32" style="v" />Aju' pale jawni sk'o'n ex matxi' txiq'o'n toklen tu'n tok te t-xelju' tman te pale kb'inchalteju' tu'me'l tu'n tknetju' najsb'il il; k'okyel tq'o'nju' t-xb'alun sed xjansa'n <verse number="33" style="v" />ex ktb'incha'ju' ẍtilsab'l teju' ja xjanxi'x, exju' Ja te Mujb'ab'ltib'il, ex teju' q'olb'eb'l, ex ktk'ma' najsb'ilte kyilju' pale ex najsb'ilte kyil kykyaqilju' tnam.</para>
  <para style="pi">
    <verse number="34" style="v" />Jun kawb'ilte' lu majx kjelten kyeye': kb'el ik'set jumaju' tu'me'l tu'n tnajset kyil aj Israel nkyb'incha'n toj ab'q'i, chi Qman Dyos.</para>
  <para style="p">Ex b'inchet kse'nxju' ojetoq tman Qman Dyos te Moyses.</para>
  <chapter number="17" style="c" />
  <para style="s1">O'kxku' jun ja xjan</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj tma'n Qman Dyos te Moyses <verse number="2" style="v" />tu'n t-xitma'n kye Aaron kyuk'i'lju' tk'wal ex kye kykyaqil aj Israel qa matxitoq che tzaj tq'o'nju' chaq'b'il ikjalu:</para>
  <para style="pi">
    <verse number="3" style="v" />Alkyexku' jun aj Israel makub' tb'yo'n jun tman wakx, jun tman rit mujqa jun ttxu chib' toju' najb'il mujqa ti'jxi', <verse number="4" style="v" />exqa min saj tiq'i'n ttziju' Ja te Mujb'ab'ltib'il tu'n tkub' tq'o'n te jun oyaj weye' twitzju' njaye' xjan, atitzun tiltz tu'nju' matz'el chik' tu'n, qu'mtzun k'elex iq'et kyxolju' twnaqil. <verse number="5" style="v" />K'ajb'elju' lu kyu'ne' aj Israel tu'n kytzaj kyiq'i'ne' alu'mj inche kub' kyb'yo'ne' toj kojb'il nwitze', ex tu'n t-xi' kyiqi'ne' teju' pale ttziju' Ja te Mujb'ab'ltib'il, tu'ntzun tkub' tq'o'n pale te chojb'il kyu'nele' te b'inchjtib'il. <verse number="6" style="v" />Kxel twitxk'a'n paleju' chik' tib'aju' q'olb'eb'l weye' ttziju' Ja te Mujb'ab'ltib'il, ex kttz'e'ysa'ju' unt te k'ok'sb'il tb'anil nwitze'. <verse number="7" style="v" />Ex mixti'tl tu'n tkub' kyq'o'ne' chojb'il kyeju' tajaw il lu, ju' e k'ulune' kye ex e'txalpuje' kyu'n. Jun kawb'ilte' lu majx kjelten kyeye', k'ajb'el kyeye' ex kye kyk'wale' toj wiqi'n.</para>
  <para style="pi">
    <verse number="8" style="v" />Ex alkyexku' aj Israel mujqa najchaq xjal najli kyxole' qama kub' tq'o'n jun chojb'il k'ok'sb'il mujqa alkyexku' juntl chojb'il, <verse number="9" style="v" />exqa min xxi' tiq'i'n ttziju' Ja te Mujb'ab'ltib'il tu'n tkub' tq'o'n nwitze', ati tu'n tex iq'et kyxolju' ttanam.</para>
  <para style="s1">Min q'o'n tu'n t-xi' ch'yetju' chik'</para>
  <para style="pi">
    <verse number="10" style="v" />Kchin q'ojile' kyi'j kykyaqil aj Israel mujqa najchaq xjal najli kyxole' qama ch'yon chik', alkyexku' tu'me'l matxa' tch'yo'n, k'elex wiq'i'ne' toj ttanam. <verse number="11" style="v" />Qu'n kykyaqilju' txkup' itz'qe' tu'nju' kychk'el ati, ex oje txi' nq'o'ne' kyeye' tu'n tpon kyiq'i'ne' tib'aj q'olb'eb'l te chojb'il tu'n tklet kychwinqlale', qu'n tu'nju' chik' in kolpeta' tchwinqlal xjal.</para>
  <para style="pi">
    <verse number="12" style="v" />Qu'mtzun inma'ne' kyeye' aj Israel, mix-a'lo' junkye' ex mix-a'lo' jun najchaq xjal najli kyxole' tu'n tch'yon chik'. <verse number="13" style="v" />Alkyexku' jun aj Israel mujqa najchaq xjal najli kyxole' matzyet jun txkup tu'n mujqa pich'ju' b'a'n tu'n kych'yet, ati tu'n tel tqo'n tchk'elju' xtzyet tu'n ex tu'n tmqunte toj tx'otx', <verse number="14" style="v" />qu'n tu'nju' chik' inche anq'ina' kykyaqilju' itz'qe'. Qu'mtzun in xa' nma'ne' kyeye' tu'n lalun txi' kych'yo'nju'ye' chik', qu'n a chwinqlalju' kye kykyaqilju' itz'qe', alkyexku' matxi ch'yonte k'elex xla'jet kyxolju' ttanam.</para>
  <para style="pi">
    <verse number="15" style="v" />Alkyexku' jun aj Israel mujqa najchaq xjal matxi ch'yonte tchib'jil jun txkup kyimnitl mujqa b'ajni tzaqu'n tu'n jun tojk'ul txkup, ati tu'n ttx'jonteju' t-xb'alun ex tu'n ttxjontetib' tu'n a', ex kjelten tz'il tzmaxi'j ajqok yupj. Yajxi'tzuntel kjelten ẍtilun. <verse number="16" style="v" />Qatzun min xttx'aju' t-xb'alun ex min xb'aj ttxjo'ntib', kjelten toj il, chi Dyos.</para>
  <chapter number="18" style="c" />
  <para style="s1">Mya kyuk'i'l alkyexku' qya tu'n kykub' kẍe ichan</para>
  <para style="p">
    <verse number="1-2" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">Ayinwe' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="3" style="v" />Lalun txikyb'incha'nju'ye' nkyb'incha'n aj Ejipt jaẍe najana'ye'.</para>
  <para style="pi">Lalun che'x lpeye' ti'ju' nkyb'incha'n aj Kanaan toju' tx'otx' ja che kxe'la' wiq'i'ne', lalun che oklpeye' kyi'ju' kykawb'il.</para>
  <para style="pi">
    <verse number="4" style="v" />Che japunxju' nnuk'b'ile' kyu'ne'; kyb'inchanqe'xe' nkawb'ile'; che anq'ine' kse'nxju' nkyma'n. Ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="5" style="v" />Kyb'inchanqe'xe' nkawb'ile' ex nnuk'b'ile'. K'anq'ilte' xjal mache japun tu'n. Qu'n ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="6" style="v" />Mixti' tu'n tkub' kẍe jun ichan tuk'i'l jun qya twitze'lx. Qu'n ayine' Dyos Manb'aj inchin q'mante.</para>
  <para style="pi">
    <verse number="7" style="v" />Lalun tz'el kyiq'i'n tch'ixaw kymane' tu'nwt kykub'kẍeye' tuk'i'l kytxuye'; lalun kyb'inchaye' tuk'i'l qu'n kytxuna'ye'.</para>
  <para style="pi">
    <verse number="8" style="v" />Ex lalun tz'el kyiq'i'n tch'ixaw kymane' tu'nwt kykub'kẍeye' tuk'i'l junju' juntl t-xu'jil.</para>
  <para style="pi">
    <verse number="9" style="v" />Lalun che kub' kẍeye' tuk'i'l kyanab'e', qa o'kx kymane' junx tuk'i'l mujqa o'kx kytxuye'; qa itz'ji tuja mujqa ttzija k'wal, lalun che kub' kẍeye' tuk'i'l.</para>
  <para style="pi">
    <verse number="10" style="v" />Lalun che elsan ch'xawe' tuk'i'l kychmane' txin, tmyal kyk'wale' mujqa tal kymyale', lalun che kub' kẍeye' tuk'i'l.</para>
  <para style="pi">
    <verse number="11" style="v" />Lalun che kub' kẍeye' tuk'i'l talju' t-xu'jil kymane', qu'n kyanab'e'. Lalun kub' kyajine'.</para>
  <para style="pi">
    <verse number="12" style="v" />Lalun che kub' kẍeye' tuk'i'l tanab' kymane', qu'n ax tchk'el kymanju'ye'.</para>
  <para style="pi">
    <verse number="13" style="v" />Lalun che kub' kẍeye' tuk'i'l titz'in kytxuye', qu'n ax tchk'el kytxuju'ye'.</para>
  <para style="pi">
    <verse number="14" style="v" />Lalun tz'el kyiq'i'n tch'ixaw kytiye' tu'nwt kykub'kẍeye' tuk'i'l t-xu'jil, qu'n kytiyxe' t-xu'jil.</para>
  <para style="pi">
    <verse number="15" style="v" />Lalun che kub' kẍeye' tuk'i'l kylib'e', qu'n t-xu'jilna' kyk'wale'.</para>
  <para style="pi">
    <verse number="16" style="v" />Lalun tz'el kyiq'i'ne' tch'ixaw kytzikye' tu'nwt kykub'kẍeye' tuk'i'lju' t-xu'jil.</para>
  <para style="pi">
    <verse number="17" style="v" />Lalun che kub' kẍeye' tuk'i'l jun qya tojx kyjakyib'e' tuk'i'l, ex tuk'i'l jun tal, mujqa jun tchman, qa tmyal tal mujqa tal tal. Qu'n taq'wixi'xte' tu'n kyb'inchanteye' lu.</para>
  <para style="pi">
    <verse number="18" style="v" />Lalun kub'kyxu'jila'ne' titz'in kyxu'jile', ex lalun che kub' kẍeye' tuk'i'l itz'ku'xju' kyxu'jile', tu'ntzun lalun tzaj q'oj kyxol.</para>
  <para style="pi">
    <verse number="19" style="v" />Lalun che kub' kẍeye' tuk'i'l jun qya toju' tq'ijlalil ajtkb'u'l ttx'ajin.</para>
  <para style="pi">
    <verse number="20" style="v" />Lalun che kub' kẍeye' tuk'i'l t-xu'jil kywnaqile' tu'n lalun che tz'ilixe' tu'n tpaj.</para>
  <para style="pi">
    <verse number="21" style="v" />Lalun txikyq'o'n junju'ye' kyk'wale' te oyaj teju' dyos Molok. Lalun kyb'inchaye' taq'wix lu ti'ju' nb'iye'. Qu'n ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="22" style="v" />Lalun che kub' kẍeye' tuk'i'l jun ichan kse'n tuk'i'l jun qya. Qu'n mixyab'a'nte' lu qama b'inchet.</para>
  <para style="pi">
    <verse number="23" style="v" />Lalun che kub' kẍeye' tuk'i'l jun txkup, tu'n lalun che kyaje' tz'il tu'n tpaj. Ex ikxqe' qya lalun txikyq'o'nkyib' te jun txkup. Qu'n mixyab'a'nte' lu.</para>
  <para style="pi">
    <verse number="24" style="v" />Lalun kytz'ilsa kyib'e' tu'n junju' ti'xti' lu, qu'n kyu'nju' lu matxi' kytz'ilsa kyib'ju' tnam che eletz wu'ne' toju' kytanam kywitze', <verse number="25" style="v" />ex kyej tz'ilixju' kytx'otx'; xi'tzun nxjelu'ne' kye ti'ju' kyb'inchb'aj, ex eb'je'tz xon tu'nju' tx'otx' janajlqe'toq. <verse number="26" style="v" />Aye'tzunkye' aj Israel, exqe' najchaq xjal najliqe' kyxole', kyb'inchanqe'xe' nkawb'ile' exqe' nnuk'b'ile', lalun kyb'incha junju'ye' ti'xti' taq'wixi'x lu, <verse number="27" style="v" />qu'n kykyaqilju' taq'wix lu makyb'inchaju' ẍenajanteju' tx'otx' nejl kywitze', ex makyej tz'ilixju' tx'otx' kyu'n. <verse number="28" style="v" />¡Laywit che etz xla'ja'ne' tu'nju' tx'otx' tu'n kpaju' tz'il lu, kse'n eb'je'tza' t-xla'ja'nju' xjal e'najan atzu' nejl kywitze'.! <verse number="29" style="v" />Alkyexku' mab'inchanteju' ti'xti' taq'wixi'x lu, k'elex iq'et kyxolju' ttanam. <verse number="30" style="v" />Qu'mtzun kyb'inchanxju'ye' nchaq'b'ile' ex lalun che kub' tz'aqe' kyoju' taq'wixi'x intoq che eb'inchanjtz na'mxtoq kypone', ex lalun kytz'ilsa kyib'e' toj. Qu'n ayine' Dyos Manb'aj, chi Dyos.</para>
  <chapter number="19" style="c" />
  <para style="s1">Kawb'il tib'aj xjanb'il ex tnik'alilti'j</para>
  <para style="p">
    <verse number="1-2" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">Kyxjansam kyib'e', qu'n xjan qinwe', ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="3" style="v" />Teyle junjunkye' che nimane' te kymane' ex te kytxuye'.</para>
  <para style="pi">Ex kynimanku'ye' q'ij te ojlab'l. Qu'n ayine' Dyos Manb'aj nchin q'mante.</para>
  <para style="pi">
    <verse number="4" style="v" />Lalun che'xe' k'ulul te witzleb', ex lalun kub' kyb'incha'n kydyose' k'uxb'il ttx'otx'al, qu'n ayinwe' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="5" style="v" />Ajtkub' kyq'o'ne' chojb'il te b'inchjtib'il nwitze' ayine' Dyos Manb'aj, kyb'inchame' b'a'nxi'x tu'n nk'monteye'. <verse number="6" style="v" />Ati tu'n t-xi' ch'yetju' alu'mj ax q'iju' ajtkub' kyq'o'ne', ex b'a'n t-xi' ch'yet toj tkab' q'ij, qatzun makyej ch'i'ntl te toxi'n q'ij, ati tu'n tkub' tz'e'yset. <verse number="7" style="v" />Qatzun matxi kych'yo'ne' oyaj toj toxi'n q'ij, k'elel wik'o'ne' ex lay nk'ame'; <verse number="8" style="v" />alkye matxi ch'yonte, kjelten il tib'aj ex k'elex iq'et kyxolju' ttanam tu'nju' makub' ttxa'ju'nju' xjansa'ntl nwitze'.</para>
  <para style="pi">
    <verse number="9" style="v" />Ajtpon tq'ijlalil tu'n tjaw twitz awal, lalun majx tek' b'jawju' twitz kyawale' toj kytx'otx'e' ex lalun che'xe' sakwilteju' triy xkyaj tz'aqi. <verse number="10" style="v" />Ex lalun che'xe' sakwilteju' ub'a toj tqanb'en ex lalun jawkysk'o'ne' naq inche kub' tz'aq; kyq'onkje' kyeju' prow ex kye najchaq xjal. Ayine' Dyos Manb'aj nchin q'mante.</para>
  <para style="pi">
    <verse number="11" style="v" />Lalun che elq'ane'. Lalun che chanyole' ex lalun b'ajkub' kysb'u'n kyib'e'.</para>
  <para style="pi">
    <verse number="12" style="v" />Lalun tz'ajb'enju' nb'iye' kyu'ne' tu'n ttziyet jun kyole' lay japun, qu'n naq ate'kye' txa'julteju' nb'iye'. Ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="13" style="v" />Lalun che jaw tzaqpaje' ti'j kywnaqile' ex lalun tz'el kyiq'i'ne' ati te. Lalun txi' kychjo'ne' twitk'u'j aq'unal tojxi' juntl q'ij.</para>
  <para style="pi">
    <verse number="14" style="v" />Lalun che yoline' taq'wix ti'ju' xjal chkyin.</para>
  <para style="pi">Lalun kub' kyq'o'n xpatxab'e' toj tb'eju' moẍ. Kyyek'ume' ninb'ilweye', qu'n ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="15" style="v" />Lalun kub' kyq'o'ne' tz'e'ysb'il witzb'aj mya toj tnik'alilti'j: mya tu'nwtu' prow lay tz'e'yset twitz, ex mya tu'nwtu' nim toklen lay tz'e'yset twitz. Che lpekye' ti'ju' tnik'alilti'j ajtkub' tz'e'ysb'il kywitz xjal.</para>
  <para style="pi">
    <verse number="16" style="v" />Lalun che jk'un yole' kyxol kyxjalile'.</para>
  <para style="p">Lalun kyaq'kyib'e' tu'n tkub' b'yetju' kywnaqile'. Ayine' Dyos Manb'aj nchin q'mante.</para>
  <para style="pi">
    <verse number="17" style="v" />Lalun majx kux kyawa'n kyq'oje kyi'j kytzikye' toj kyanmiye'.</para>
  <para style="pi">Kytzak'unxe' kywnaqile' qa ati til, tu'ntzun lalun che ele' junx tuk'i'l toju' til.</para>
  <para style="pi">
    <verse number="18" style="v" />Lalun kyaq' tu'me'l t-xele' ex lalun ku'x kyk'u'n kyq'oje kyi'j kywnaqile', kyk'u'jlame' kywnaqile' kse'nx aye'ye'. Ayine' Dyos Manb'aj nchin q'mante.</para>
  <para style="pi">
    <verse number="19" style="v" />Kyb'inchanqe'xe' nkawb'ile'.</para>
  <para style="pi">Lalun kyaje' tu'n kyẍchanju' kywakyixe' tuk'i'l alkyexku' juntl txkup.</para>
  <para style="pi">Lalun tz'ok kyawa'n b'a'npun tyajajil kyijaje' toj kyawb'ile'.</para>
  <para style="pi">Lalun tz'ok kyq'o'n jun kyxb'alune' b'incha'n tu'n chukchaq q'in.</para>
  <para style="pi">
    <verse number="20" style="v" />Qa ati jun makub' kẍe tuk'i'l jun qya majin k'a'yi'n exqa tetoq juntl ichan, na'mxtoqtzun t-xi' lq'o'n ex na'mxtoq ttzaqpet, ati tu'n tchjonte te kykab'il, ex lay che kub' b'yet, qu'n mya tzaqpi'nju' qya lu. <verse number="21" style="v" />Ati tu'n ttzaj tiq'i'n ichan jun tman rit nwitze' te chojb'il tu'n tten b'a'n wuk'i'le', ati tu'n t-xi' tiq'i'n ttziju' Ja te Mujb'ab'ltib'il.</para>
  <para style="pi">
    <verse number="22" style="v" />Tu'ntzunju' tman rit lu te chojb'il tu'n tten b'a'n wuk'i'le', ktzajel tqani'n pale weye' tu'n tkub' najset tilu' ichan lu, ex kb'el nnajsa'ne' til xtb'incha.</para>
  <para style="pi">
    <verse number="23" style="v" />Ajkyokxe' toju' tx'otx', qa makux kyawa'ne' tze tqan lob'j, lalun tz'el kyt'uxi'n oxe' ab'q'iye' twitz te kylo'ye'. <verse number="24" style="v" />Atzu'n toj tkyaji'n ab'q'i kykyaqilju' twitz lob'j kxjansetel nwitze' toj jun ninq'ij, <verse number="25" style="v" />tojtzu'n tjwe'yi'n ab'q'i b'a'n kylo'nteye' kywitz. Kkyq'a'tzun kye tzetz kywitz. Ayine' Dyos Manb'aj nchin q'mante.</para>
  <para style="pi">
    <verse number="26" style="v" />Lalun txi' kych'yo'n chib'je' tuk'i'lxi' chik'.</para>
  <para style="p">Lalun che ajpkab'ine' ex lalun tz'ok kyq'o'n kyib'e' q'malte titi' tzul.</para>
  <para style="pi">
    <verse number="27" style="v" />Lalun tz'el kyjon kywi'ye' sewun, ex lalun tz'el kyjone' ttxa'n kyxmatziye'.</para>
  <para style="pi">
    <verse number="28" style="v" />Lalun tz'ok kyky'ixb'sa'n kyib'e' tu'n tpaj jun kyimni. Lalun tz'ok kyq'o'n tilb'ilale' ti'j kychib'jile'. Ayine' Dyos Manb'aj nchin q'mante.</para>
  <para style="pi">
    <verse number="29" style="v" />Lalun che'x kyq'o'ne' kymyale' toj ajpaji'n. Lalun kub' tzuwixju' tx'otx' kyu'ne' tu'n txqan il taq'wixi'x.</para>
  <para style="pi">
    <verse number="30" style="v" />Kynimanku'ye' q'ij te ojlab'l weye', tenx tchiylal njaye' xjan kyeye'. Ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="31" style="v" />Lalun che'xe' jyol kyi'je' kyuk'i'l spritist ex ajpkab'. Lalun kytz'ilsa kyib'e' tu'nju' joyb'ilkyi'je'. Qu'n ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="32" style="v" />Che q'olb'enqe'ye' ex che nimane' kye tijwnaq. Tenx nchiylale' kyeye'. Qu'n ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="33" style="v" />Lalun kub' kyyaju'ne' najchaq xjal najli kyxole'.</para>
  <para style="pi">
    <verse number="34" style="v" />Kyq'onke' kse'n jun kywnaqile'; kyk'u'jlame', qu'n ikxju' kse'n aye'ye'. Expena' ikxkye' e'okye' te najchaq xjal toj Ejipt. Ayine' Dyos Manb'aj nchin q'mante.</para>
  <para style="pi">
    <verse number="35" style="v" />Lalun che sb'une' kyi'j echb'il tx'otx', peẍ ex juntl malb'il. <verse number="36" style="v" />Ati tu'n kyajb'en echb'il kyu'ne', e'peẍ ex juntl malb'il tz'aqliqe'. Qu'n Ayine' Dyos Manb'aj, inetz q'inkyeye' toj Ejipt.</para>
  <para style="pi">
    <verse number="37" style="v" />Qu'mtzun kyb'inchanqe'xe' nkawb'ile' ex nnuk'b'ile'; che japunx kyu'ne'. Ayine' Dyos Manb'aj, chi Qman Dyos.</para>
  <chapter number="20" style="c" />
  <para style="s1">Tz'e'ysb'il kywitz xjal tu'ntpaj min nche b'in</para>
  <para style="p">
    <verse number="1-2" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">Alkyexku' aj Israel mujqa najchaq xjal najli toj Israel, qama t-xi' tq'o'n jun tk'wal teju' dyos Molok, ati tu'n tkub' b'yet tu'n ab'j kyu'nju' xjal toju' tx'otx'. <verse number="3" style="v" />Kchin okyel miltz'uje' ti'ju' xjal lu ex kb'el nnajsa'ne' kyxolju' ttanam, tu'n tpaj makub' ttz'ilsa'nju' njaye' xjan ex makub' ttxa'ju'n nb'iye' tu'nju' matxi tq'o'n jun tk'wal te Molok. <verse number="4" style="v" />Qatzun makyẍkyinsa kyib'ju' xjal toju' tx'otx' teju' nb'aj lu exqa min xkub' kyb'yo'nju' xjal lu, <verse number="5" style="v" />kchin okyel miltz'uje' ti'ju' xjal lu ex kyi'ju' toj tja, ex kb'el nnajsa'ne' kyxolju' ttanam junx kyuk'i'lxi'ju' ẍe'x lpe ti'j k'ulul te Molok. <verse number="6" style="v" />Qatzun ati jun mattz'ilsatib' tu'ntpaj matxi' jyolti'j kyuk'i'l spritist ex kyuk'i'l ajpkab', kchin q'ojile' ti'ju' xjal lu ex kb'el nnajsa'ne' kyxolju' ttanam.</para>
  <para style="pi">
    <verse number="7" style="v" />Kyxjansanku'xi'x kyib'e' weye', che okxe' xjan, qu'n ayine' Dyos Manb'aj. <verse number="8" style="v" />Kyb'inchanqe'xe' nkawb'ile'; che japunx kyu'ne'. Qu'n ayine' Dyos Manb'aj, nche nxjansa'ne' te weye'.</para>
  <para style="pi">
    <verse number="9" style="v" />Alkyexku' matz'ok tili'n tman mujqa ttxu, kb'el b'yet. Tib'ajxte ta'ju' tkamik, qu'n mana' tz'ok tili'n tman mujqa ttxu.</para>
  <para style="pi">
    <verse number="10" style="v" />Qa nab'en ati jun matb'incha ajpaji'n tuk'i'l t-xu'jil twnaqil, ati tu'n tkub' b'yetju' ichan exju' qya.</para>
  <para style="pi">
    <verse number="11" style="v" />Qa ati jun makub' kẍe tuk'i'l t-xu'jil tman, in eltiq'i'n tch'ixaw tman. Qu'mtzun ati tu'n tkub' b'yetju' ichan exju' qya, ex kyib'ajx ta'ju' kykamik.</para>
  <para style="pi">
    <verse number="12" style="v" />Qa ati jun makub' kẍe tuk'i'l tlib', ati tu'n kykub' b'yet kykab'il ex kyib'ajx ta'ju' kykamik, qu'n taq'wixi'x ju'lu.</para>
  <para style="pi">
    <verse number="13" style="v" />Qa ati jun ichan makub' kẍe tuk'i'l juntl ichan nakuxwitloj tuk'i'l jun qya, ati tu'n kykub' b'yet kykab'il ex kyib'ajx ta'ju' kykamik, qu'n taq'wixi'xju' xkyb'incha.</para>
  <para style="pi">
    <verse number="14" style="v" />Qa ati jun ichan makub' t-xu'jila'n jun qya tuk'i'lxi' ttxu, aju' lu taq'wixi'x ex ati tu'n kykub' tz'e'yset itz'qe'. Laytzun ten iltz taq'wixi'x kyxole'.</para>
  <para style="pi">
    <verse number="15" style="v" />Qama tz'oktq'o'ntib' jun ichan ajpajil tuk'i'l jun txkup, ati tu'n tkub' b'yet. Ex ati tu'n tkub' b'yetju' txkup.</para>
  <para style="pi">
    <verse number="16" style="v" />Qama txi' tq'o'ntib' jun qya ajpajil tuk'i'l jun txkup, ati tu'n tkub' b'yetju' qya exju' txkup. Kyib'ajx ta'ju' kykamik.</para>
  <para style="pi">
    <verse number="17" style="v" />Qa ati jun makub' t-xu'jila'n tanab', qa tmyal tman mujqa tal ttxu, ex makub' kẍe tuk'i'l, kche elex xla'jet kyxolju' kywnaqil, qu'n ch'ixb'ilxi'xte' qama kub' kẍe jun ichan tuk'i'lx tanab', ex alkye mab'inchanteju' lu tib'ajx ta'ju' til.</para>
  <para style="pi">
    <verse number="18" style="v" />Qa ati jun makub' kẍe tuk'i'l jun qya toju' tq'ijlalil aj tkb'u'lju' ttx'ajin ex matxi ttzyu'n, kykab'ilx che elex xla'jet kyxolju' kytanam tu'n tpaj min xkynimaju' chaq'b'il tu'n lalun kub'kẍe jun ichan tuk'i'l jun qya toju' tq'ijlalil ajtkb'u'l ttx'ajin.</para>
  <para style="pi">
    <verse number="19" style="v" />Lalun che ajpajine' tuk'i'l titz'in kytxuye' ex tuk'i'l tanab' kymane', qu'n kywitze'lxe' ex kyib'ajxe' kjela'ten kyile' tuk'i'l.</para>
  <para style="pi">
    <verse number="20" style="v" />Qa ati jun makub' kẍe tuk'i'l t-xu'jil ttiy, tch'ixaw ttiy in eltiq'i'n; kyib'ajx kyjela' tenju' kyil: mixti'xte jun kyk'wal tzul ajkykyim.</para>
  <para style="pi">
    <verse number="21" style="v" />Qa ati jun makub' t-xu'jila'n t-xu'jil ttziky, tch'ixaw ttziky sel tiq'i'n. Mixyab'a'n te lu, ex mixti'x jun kyk'wal tzul ajkykyim.</para>
  <para style="pi">
    <verse number="22" style="v" />Kyb'inchanqe'xe' nkawb'ile'; che japunx kyu'ne'. Laytzun che ex xla'ja'ntze' tu'nju' tx'otx' ja che pomela' wiq'i'ne' tu'n kyanq'ine' twitz. <verse number="23" style="v" />Lalun che'x lpeye' ti'ju' nkyb'incha'n xjal che elex nq'o'ne' kywitze'; tkyaqilju' ti'xti' lu intoq kyb'incha'n, qu'mtzun lay che ik'xtl wu'ne'. <verse number="24" style="v" />Kxel ntziya'ne' kyeye' qa aye'ye' che okyel tajawju' kytx'otx'; ayinku'we' kchin xel q'onteju' tb'anil tx'otx' lu toj kyq'ob'e'.</para>
  <para style="pi">Ayine' Dyos Manb'aj, ẍin el pa'nkyeye' kyi'ju' txqantl tnam. <verse number="25" style="v" />Qu'mtzun ikxkye' ati tu'n tel kynik'e' kyi'ju' txkup ẍtilunqe' exqe' tz'ilqe', ex kyi'ju' pich' ẍtilunqe' exqe' tz'ilqe'. Lalun b'aj kytz'ilsa'n kyib'e' tu'n kypaju' txkup, pich' exqe' inche qitinje twitz tx'otx', ju' matxi' txi' nma'ne' kyeye' qa tz'ilqe'. <verse number="26" style="v" />Che okxe' xjan nwitze', qu'n xjan qinwe', ayine' Dyos Manb'aj, ex matxi' che elnpa'ne' kyxolju' txqantl tnam tu'n kyoke' te ntaname'.</para>
  <para style="pi">
    <verse number="27" style="v" />Qa ati jun ichan mujqa qya spritist, mujqa ajpkab', ati tu'n kykub' b'yet toj ab'j ex kyib'ajx ta'ju' kykamik, chi Qman Dyos.</para>
  <chapter number="21" style="c" />
  <para style="s1">Nuk'b'il kye pale</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj tma'n Qman Dyos te Moyses ikjalu:</para>
  <para style="pi">Q'manxa kye pale tyjajil Aaron tu'n lalun kytz'ilsa kyib' tu'ntpaj jun kywitze'l kyimnitl, <verse number="2" style="v" />o'kx tu'n tok kymko'n jun kyimniju' qa kytxu, kyman, kyk'wal, kymyal, kytzik <verse number="3" style="v" />mujqa kyanab' na'mx tmje najlix kyuk'i'l, qu'n na'mxna' tmje; maskye makytz'ilsa kyib' tu'n kpaju' lu. <verse number="4" style="v" />Atzu'n qa jun kyimni kywitze'l mjeb'nil, mixti' tu'n tok kymko'n.</para>
  <para style="pi">
    <verse number="5" style="v" />Mixti' tu'n tel kyjon kywi', tu'n tel kyjso'n kyxmatzi, ex mixti' tu'n kyk'ixb'sante kyib', <verse number="6" style="v" />naq o'kx tu'n tb'aj kyxjansa'n kyib' nwitze' ayine' Dyos Manb'aj ex mixti' tu'n tkub' kytxa'ju'n nb'iye', qu'n aye' che kb'el q'onteju' oyaj tz'e'ysa'n exju' wab'j nwitze'; qu'mtzun ati tu'n kyten xjansa'nqe'.</para>
  <para style="pi">
    <verse number="7" style="v" />Ex mixti' tu'n kymje tuk'i'l jun qya ajpajil, tuk'i'l jun qya b'ajni yaju'n, mujqa tuk'i'l jun qya kub'ni tpa'ntib' tuk'i'l tchmil, qu'n xjansa'nqe' nwitze'. <verse number="8" style="v" />Pa'nqemila ti'j tkyaqil, qu'n aye' che kb'el q'onte wab'j nwitze'. Ex che okyel xjan teya, qu'n ayine' Dyos Manb'aj, xjan qine' ex ayine' inchin xjansankye.</para>
  <para style="pi">
    <verse number="9" style="v" />Qama tz'el twi' ajpajil tmyal jun pale, tch'ixaw tman sel tiq'i'n ex ati tu'n tkub' tz'e'yset itz'x.</para>
  <para style="pi">
    <verse number="10" style="v" />Matxi' tk'amju' kynejel pale toklen tu'n tok toksa'nju' t-xb'alun xjansa'n, qu'n matxi' jax q'etju' aseyt te xjansb'il toj twi'. Qu'mtzun mixti' tu'n ttenju' twi' chitpu'n ex mixti' tu'n t-xi' tlaqu'n t-xb'alun tu'n tpaj b'is; <verse number="11" style="v" />ex mixti' tu'n tokx jata' jun kyimni: maskye tman mujqa ttxu, tu'n lalun ttz'ilsatib'. <verse number="12" style="v" />Mixti' tu'n tetz toju' njaye' xjan ex mixti' tu'n ttz'ilsante, qu'n oje kub' q'et aseyt te xjansb'il toj twi' tu'n tajb'en weye', ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="13" style="v" />A t-xu'jilju' ktzajel tiq'i'n aju' na'mx txi' tzyu'n tu'n jun ichan. <verse number="14" style="v" />Mixti' tu'n tmje tuk'i'l jun qya kyimni tchmil, kub'ni tpa'ntib' tuk'i'l tchmil, kub'ni yaju'n tu'n ichan, mujqa twi' ajpajil; a te k'okyelju' te t-xu'jil jun txin twitze'lx b'ajx txa' tzyu'n tu'n jun ichan, <verse number="15" style="v" />tu'ntzun lalun kub' b'aju' tyajajil kyxolju' twnaqil; qu'n oje nxjansaye', ayine' Dyos Manb'aj, chi Dyos.</para>
  <para style="s1">Maqb'il tu'n miche oka' te pale</para>
  <para style="p">
    <verse number="16-17" style="v" />Tzaj tma'n Qman Dyos te Moyses ikjalu:</para>
  <para style="pi">Q'manxa te Aaron qa okxe'l qex ja'lo, lay txi' q'et anb'il te junju' tyajajil ati ttzakajil tu'n tkub' tq'o'nju' oyaj wab'j nwitze'. <verse number="18" style="v" />Qu'n axxi'x, mix a'lo' jun ati ttzakajil tu'nwt tkub' tq'o'nju' lu: qa moẍ, kox, tzkaj ttxa'n mujqa t-ẍkyin, <verse number="19" style="v" />qa toqjni tqan mujqa tq'ob', <verse number="20" style="v" />qa k'o'lti'j, tal b'o's twe', muj kyi'j twitz, ati ẍal ti'j mujqa b'je'tzni poq'li ti'j, mujqa tzkajqe'ju' tb'aq'. <verse number="21" style="v" />Mix a'lo' jun tyajajilju' pale Aaron, ati ttzakajil tu'nwt kykub' tq'o'nju' oyaj nwitze' ju' inche tz'e'yset; myab'a'n tu'n kykub' tq'o'nju' oyaj wab'j nwitze' ayine' Dyos Manb'aj. <verse number="22" style="v" />B'a'n tu'n twanteju' oyaj lu, ex kyi'ju' xjanqe' ex xjanqe'xi'x, <verse number="23" style="v" />atzu'n ti'jxi'ju' xb'alun te aq'pub'l mixti' tu'n tokx ex mixti' tu'n tpon lq'e tk'etzju' q'olb'eb'l, tu'n lalun ttz'ilsa toklenju' njaye' xjan tu'n ttzakajil. Ayine' Dyos Manb'aj nchin xjansante, chi Dyos.</para>
  <para style="p">
    <verse number="24" style="v" />Aye'xtzun yol ja'lu xitma'n Moyses te Aaron, kye tk'wal ex kye kykyaqil aj Israel.</para>
  <chapter number="22" style="c" />
  <para style="s1">O'qe'kxju' b'a'n kywan kyi'ju' oyaj te Qman Dyos</para>
  <para style="p">
    <verse number="1-2" style="v" />Tzaj tma'n Qman Dyos te Moyses ikjalu:</para>
  <para style="pi">Q'manxa te Aaron ex kyeju' tyajajil tu'n tten kyxob'il kyi'ju' ti'xti' xjan intzaj kyq'o'n aj Israel weye', tu'ntzun lalun kub' kyaju'nju' nb'iye' xjan. Ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="3" style="v" />Kxe'l qex ja'lo, alkyexku' jun kyyajajil tz'ilsa'ntib' mache kub' tq'o'nju' ti'xti' xjanqe' nwitze' ju' intzaj kyiq'i'n aj Israel weye', ati tu'n tel toklen nwitze'. Ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="4" style="v" />Qa ati jun tyajajil Aaron yab' tu'n xlemtx'a'k mujqa in qojl ij twi' ttz'a'lb'il, lalun txi' twanju' ti'xti' xjan tzmaxi'j aj t-ẍtilset.</para>
  <para style="pi">Alkye matxi ttzyu'n jun ti'xti' tz'il tu'n jun kyimni mujqa matxi ttzyu'n jun yab' tu'n ij inel qojl twi' ttz'a'lb'il, <verse number="5" style="v" />mujqa aju' matz'ilix tu'nju' xittzyu'n jun txkup nqititinje mujqa matz'oktmko'n jun ichan tz'il tu'n alkyexku' tz'il, <verse number="6" style="v" />kjelten tz'il tzmaxi'j ajqok yupj, ex mixti' tu'n twanteju' ti'xti' xjanqe' qa na'mxtoq ttxjontetib' tu'n a'. <verse number="7" style="v" />Kẍtilsetelxi' ajxi' tku'x q'ij, b'a'ntzun twantz kyi'ju' ti'xti' xjanqe', qu'n ana' twaju'. <verse number="8" style="v" />Mixti' tu'n tch'yonte tchib'jil jun txkup kyimnitl mujqa jun alu'mj b'ajni tzaqu'n tu'n jun tojk'ul txkup, tu'ntzun lalun ttz'ilsatib' tu'n. Ayine' Dyos Manb'aj inchin q'mante.</para>
  <para style="pi">
    <verse number="9" style="v" />Q'manxa kye tu'n tjapunju' nchaq'b'ile' kyu'n tu'ntzun lalun kyejten il kyib'aj tu'n tpaj qa min xxi' kyb'incha'n, laytzun che kyimtz. Ayine' Dyos Manb'aj, ẍin xjansankye.</para>
  <para style="pi">
    <verse number="10" style="v" />Mixalokyex jun mya pale tu'n twanteju' xjansa'n.</para>
  <para style="pi">Qa jun tulaju' pale mujqa jun tmajin, mixti' tu'n t-xi' twanju' xjansa'n.</para>
  <para style="pi">
    <verse number="11" style="v" />Qama tloq'ju' pale jun tmajin tu'n tmedi, aju' tmajin lq'o'n b'a'n tu'n twanteju' wab'j xjansa'n. Ex b'a'n tu'n kywanju' itz'jniqe' toj tja pale ti'ju' twa.</para>
  <para style="pi">
    <verse number="12" style="v" />Qa mjeb'niju' tmyal pale tuk'i'l jun ichan mya pale, mixti'tl tu'n twan kyi'ju' oyaj inxi' kyeju' pale. <verse number="13" style="v" />Qatzun kyimnitl tchmil mujqa kub'ni tpa'ntib' tuk'i'l tchmil, qa mixti' tal, ex matz'anjtzti'j toj tja tman kse'nx na'mxtoq tmje, b'a'n tu'n twan ti'ju' twa tman. Aye'tzu'n mya paleqe' mixti' tu'n kywante.</para>
  <para style="pi">
    <verse number="14" style="v" />Qa ati jun matxi twanju' wab'j xjan ex min b'in tu'n qa xjan, ati tu'n t-xi' tq'o'n t-xe'lju' xb'aj twanteju' pale tuk'i'l jun tjwe'yi'n tnejtl; <verse number="15" style="v" />lalun kyaq'ju' pale anb'il tu'n tkub' kytxa'ju'n aj Israel ti'xti' xjan nche kub' q'o'n nwitze', <verse number="16" style="v" />tu'ntzun lalun kyejten taq'wix kyib'aj tu'n tpaj qama txi' kywanju' wab'j xjan. Ayine' Dyos Manb'aj ẍin xjansankye, chi Dyos.</para>
  <para style="s1">Nuk'b'il kyi'j alu'mj che kxe'lq'et te Qman Dyos</para>
  <para style="p">
    <verse number="17-18" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye Aaron kyuky'i'lju' tk'wal ex kye kykyaqil aj Israel kjalu:</para>
  <para style="pi">Qa ati jun aj Israel mujqa jun te najchaq xjal najliqe' kyxole', makub' tq'o'n jun alu'mj te chojb'il k'ok'sb'il nwitze', qa tu'n tjapun jun yol tziya'ntl mujqa jun oyaj tu'n tk'u'j, <verse number="19" style="v" />ati tu'n tkub' tq'o'n jun tman mixti' ttzakajil tu'ntzun tk'met te. Qa jun tman wakx, jun qpoj tman rit mujqa jun tman chib', <verse number="20" style="v" />naq o'kx mya jun alu'mj ati ttzakajil, qu'n lay k'met te.</para>
  <para style="pi">
    <verse number="21" style="v" />Alkyexku' makub' tq'o'n jun chojb'il te b'inchjtib'il nwitze', qa tu'n tjapun jun yol tziya'ntl mujqa jun oyaj tu'n tk'u'j, ati tu'n kykub' tq'o'n tma wakx mujqa ttxu rit mixti' kytzakajil tu'ntzun kyk'met te. <verse number="22" style="v" />Lalun che tzaj kyq'o'ne' alu'mj weye' moẍqe', k'ixb'niqe', koxqe', tx'a'k kyi'j, ẍal kyi'j mujqa b'je'tzni poq'li kyi'j, ex lalun che tzaj kyq'o'ne' weye' te oyaj tz'e'ysa'n tib'aj q'olb'eb'l. <verse number="23" style="v" />Qa te jun oyaj tu'n kyk'u'je', b'a'n tu'n kyq'onteye' jun tman wakx mujqa jun tma rit mya junelniqe' tqan, qatzun tu'n tjapun jun yol tziya'ntl lay k'met kyeye'. <verse number="24" style="v" />Ex mixti' tu'n kytzaj kyq'o'ne' alu'mj weye' k'ixb'niqe' kyb'aq', b'ajni tx'no'n, etzni xb'oqi'n mujqa elni jon. Lalun kyb'incha'juye' lu toj kytx'otx'e'. <verse number="25" style="v" />Ex mixti' tu'n kyk'monteye' alu'mj ikju' te jun najchaq xjal tu'n ttzaj kyq'o'ne' weye', qu'n tzkaj alu'mjqe' ex lay che k'met kyeye', chi Dyos.</para>
  <para style="s1">Nuk'b'il tu'n kykub'yetju' alu'mj che kxe'lq'et te Dyos</para>
  <para style="p">
    <verse number="26" style="v" />Tzaj tma'n Qman Dyos te Moyses ikjalu:</para>
  <para style="pi">
    <verse number="27" style="v" />Ajtitz'ji jun qpoj tman wakx, jun qpoj tman rit mujqa jun qpoj tman chib', ati tu'n tkyejten wuq q'ij tk'etzju' ttxu, tojtzunju' twajxaqi'n q'ij b'a'n tu'n tk'met tu'n tkub' tz'e'yset te oyaj weye'.</para>
  <para style="pi">
    <verse number="28" style="v" />Lalun kub' kyb'yo'ne' jun ttxu wakx mujqa ttxu rit tuk'i'lxi' tal toj jun q'ijx.</para>
  <para style="pi">
    <verse number="29" style="v" />Ajttzaj kyq'o'ne' jun oyaj te aq'b'il chjonte weye', kyb'inchame' toj tu'me'l tu'ntzun nk'monteye'. <verse number="30" style="v" />Expe' kych'yonxe' ax q'iju' ex lalun kyej kyq'o'ntle' te jun q'ijtl. Ayine' Dyos Manb'aj nchin q'mante.</para>
  <para style="pi">
    <verse number="31" style="v" />Kyb'inchanqe'xju'ye' nchaq'b'ile'; che japunx kyu'ne'. Ayine' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="32" style="v" />Lalun kub' kytxa'ju'ne' nb'iye' xjan, tu'ntzun wokye' xjan kyeye'. Ayine' Dyos Manb'aj, matxi che nxjansaye' <verse number="33" style="v" />ex oje che etz wiq'i'ne' toj Ejipt tu'n kyk'ulune' weye'. Ayine' Dyos Manb'aj, chi Dyos.</para>
  <chapter number="23" style="c" />
  <para style="s1">Ninq'ij toj kyokslab'l aj Israel</para>
  <para style="r">(<ref loc="NUM 28:16-25">Nm 28.16-25</ref>)</para>
  <para style="p">
    <verse number="1-2" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">Aye' ninq'ij ja'lu nim kyoklen tu'n kyk'ulune' weye', ex a tb'iju' k'okyel kyq'o'ne' b'uyjtib'il xjan.</para>
  <para style="pi">
    <verse number="3" style="v" />Waqaq q'ij kche aq'unale', atzu'n toj twuqi'n q'ij mixti' tu'n kyb'inchante jun aq'untle'; jun q'ijte' te ojlab'l nim toklen ex tu'n tten jun b'uyjtib'il xjan. Jaxjaku' mache najane', te ojlab'l te' q'ij lu te ninb'ilweye'.</para>
  <para style="pi">
    <verse number="4" style="v" />Aye'tzun q'iju' nimaq kyoklen tu'n kykub' ik'setju' b'uyjtib'il xjan te ninb'ilweye', aye' q'iju' ati tu'n kyb'u'yinte kyib'e':</para>
  <para style="pi">
    <verse number="5" style="v" />Toj tkyajlajoji'n q'ij teju' tnejel xjaw, ajtok qale, kb'el kyik'sa'ne' Q'ij te Tzaqpib'l te ninb'ilweye'.</para>
  <para style="pi">
    <verse number="6" style="v" />Atzu'n toj tjwe'lajoji'n q'ij texju' xjaw lu, kb'el kyik'sa'ne' tq'ij wab'j mixti' ttx'amal te ninb'ilweye'. Wuq q'ij tu'n kywanteye' wab'j mixti' ttx'amal. <verse number="7" style="v" />K'okyel jun b'uyjtib'il xjan kyu'ne' toju' tnejel q'ij. Mixti' tu'n kyb'inchante jun aq'untle'. <verse number="8" style="v" />Wuq q'ij ati tu'n kytz'e'ysanteye' chojb'il nwitze', tojtzu'n twuqi'n q'ij k'okyel jun b'uyjtib'il xjan kyu'ne'. Mixti' tu'n kyb'inchante jun aq'untle', chi Dyos.</para>
  <para style="s1">Tq'ij tnejel twitz awal</para>
  <para style="r">(<ref loc="NUM 28:26-31">Nm 28.26-31</ref>)</para>
  <para style="p">
    <verse number="9-10" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">Ajkyokxe' toju' tx'otx' kxe'l nq'o'ne' kyeye', aj tjawju' twitz kytriye', ati tu'n tpon kyiq'i'ne' tnejel manoj teju' pale. <verse number="11" style="v" />Tetzun juntl q'ij tik'lenxi' q'ij te ojlab'l, kb'el tq'o'nju' pale nwitze' te jun oyaj tb'anilxi'x, tu'ntzun tk'met kyeye'. <verse number="12" style="v" />Ax q'iju' ajttzaj kyq'o'ne' manoj triy, ktzajel kyq'o'ne' jun qpoj tman rit te jun ab'q'i mixti' ttzakajil, te jun chojb'il k'ok'sb'il te ninb'ilweye'. <verse number="13" style="v" />Ex ktzajel kyiq'i'ne' ch'inxmi lajoj lib'r tb'anil arin xyuq'i'n tuk'i'l aseyt, tu'n tkub' kyq'o'ne' nwitze' te jun oyaj tz'e'ysa'n tb'anil tk'ok'jal. Ex ktzajel kyiq'i'ne' jun litr b'in te jun oyaj tu'n tkub' qet. <verse number="14" style="v" />Lalun che wan wab'je', triy ch'i'li'n mujqa cha'x, tzmaxi'j ajttzaj kyiq'i'ne' kyoyaje' weye'. Jun kawb'ilte' lu majx kjelten, ex kjel kyma'ne' kye kyk'wale' jaxjaku' mache najane'.</para>
  <para style="pi">
    <verse number="15" style="v" />Textzunju' q'ij ajttzaj kyq'o'ne' jun manoj triy te jun oyaj tb'anilxi'x, tik'lenxi'ju' q'ij te ojlab'l, kxel kyajla'ne' wuq smanxi'x. <verse number="16" style="v" />Ajtzun tjapunju' twuqi'n sman tuk'i'lxi' juntl q'ij tik'lenju' q'ij te ojlab'l, kjapumel b'aj kab'wnaq lajoj (50) q'ij. Kb'eltzun kyq'o'n kyoyajtze' ak'a'j twitz triy nwitze', <verse number="17" style="v" />ex ktzajel kyiq'i'ne' kab'e' wab'j b'incha'n tu'n tb'anil arin tzq'ajsa'n tuk'i'l ttx'amal, ch'inxmi b'eljoj lib'r talal junjun, te jun oyaj weye' tb'anilxi'xte tnejel twitz awal. <verse number="18" style="v" />Che ktzajel kyiq'i'ne' kab'e' wab'j junx kyuk'i'l wuq qpoj tman rit te jun ab'q'iqe' mixti' kytzakajil, jun tman wakx ex kab'e' tman rit, te chojb'il k'ok'sb'il te ninb'ilweye', te jun oyaj tz'e'ysa'n tb'anil tk'ok'jal, tib'ajxi'ju' kyoyaje' ti'j twitz awal k'ok'e'kywitz ex ti'j b'in.</para>
  <para style="pi">
    <verse number="19" style="v" />Ex ikx kb'el kyq'o'ne' jun chib' te chojb'il tu'n tpaj il, ex kab'e' qpoj tman rit te jun ab'q'iqe' te chojb'il te b'inchjtib'il. <verse number="20" style="v" />Che kb'eltq'o'n paleju' alu'mj te jun oyaj tb'anilxi'x nwitze', junx tuk'i'lju' wab'j te tnejel twitz awal ex kab'e' qpoj tman rit. Kche xjansetel nwitze' teju' pale.</para>
  <para style="pi">
    <verse number="21" style="v" />Ati tu'n tkub' kyq'o'ne' jun b'uyjtib'il xjan tojxju' q'ij lu, ex mixti' tu'n kyb'inchanteye' jun aq'untl. Jun kawb'ilte' lu majx kjelten kyeye' ex kye kyk'wale' toj wiqi'nwiq jaxjaku' mache najane'.</para>
  <para style="pi">
    <verse number="22" style="v" />Ajtjaw twitz kyawale', lalun majx tek' jawju' twitz kyawale' twitzju' kytx'otx'e' ex lalun che oktene' sakwilteju' t-spiyil triy nkyaj tz'aqi. Kyq'onkje' kye prow ex kye najchaq xjal. Ayine' Dyos Manb'aj nchin q'mante, chi Dyos.</para>
  <para style="s1">Kyq'ij chun</para>
  <para style="r">(<ref loc="NUM 29:1-6">Nm 29.1-6</ref>)</para>
  <para style="p">
    <verse number="23-24" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">Kb'el kyik'sa'ne' jun q'ij te ojlab'l ex jun b'uyjtib'il xjan te nab'ab'l tuk'i'l chun toj tnejel q'ij teju' twuqi'n xjaw. <verse number="25" style="v" />Ati tu'n tkub' kytz'e'ysa'ne' jun oyaj te ninb'ilweye', ex mixti' tu'n kyb'inchante jun aq'untle', chi Dyos.</para>
  <para style="s1">Tq'ij najsb'il</para>
  <para style="r">(<ref loc="NUM 29:7-11">Nm 29.7-11</ref>)</para>
  <para style="p">
    <verse number="26" style="v" />Tzaj tma'n Qman Dyos te Moyses ikjalu:</para>
  <para style="pi">
    <verse number="27" style="v" />Tq'ij Najsb'il toju' tlajoji'n q'ij texju' twuqi'n xjaw. Ati tu'n tkub' kyik'sa'ne' jun b'uyjtib'il xjan, ex tu'n kymewayine' teju' q'ij lu, ex tu'n tkub' kytz'e'ysa'ne' jun oyaj te ninb'ilweye'. <verse number="28" style="v" />Lalun kyb'incha jun aq'untle' toju' q'ij lu, qu'n Tq'ij Najsb'ilte', a q'iju' tu'n tknet najsb'il kyile' nwitze' ayine' Dyos Manb'aj. <verse number="29" style="v" />Alkyexku' jun min xmewayin teju' q'ij lu, ati tu'n tex xla'jet toj ttanam. <verse number="30" style="v" />Ex alkyexku' jun matzaq'unan teju' q'ij lu, knajel wu'ne' toj ttanam.</para>
  <para style="pi">
    <verse number="31" style="v" />Lalun kyb'incha jun aq'untle'. Jun kawb'ilte' lu majx kjelten kyeye', ex kjel kyma'ne' kye kyk'wale' toj wiqi'n jaxjaku' mache najane'. <verse number="32" style="v" />Ati tu'n tokju' q'ij lu kyu'ne' te ojlab'l ex te mewayi'n, kxel qe kyu'ne' ajtok qale teju' tb'eljoji'n q'ij teju' xjaw ex kb'ajelxi' ajtok qale te juntl q'ij, chi Dyos.</para>
  <para style="s1">Kyq'ij pach tq'ob' tze</para>
  <para style="r">(<ref loc="NUM 29:12-40">Nm 29.12-40</ref>)</para>
  <para style="p">
    <verse number="33-34" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">Kxel qeju' ninq'ij kyeju' pach tq'ob' tze toju' t-o'lajoji'n q'ij texju' twuqi'n xjaw, wuq q'ij kb'el kyik'sa'ne' te ninb'ilweye', <verse number="35" style="v" />k'okyel jun b'uyjtib'il xjan kyu'ne' toju' tnejel q'ij. Lalun kyb'incha jun aq'untle'. <verse number="36" style="v" />Kb'el kytz'e'ysa'ne' oyaj te ninb'ilweye' toju' wuq q'ij lu, atzu'n toj twajxaqi'n q'ij kb'el kyik'sa'ne' jun b'uyjtib'il xjan ex kb'el kytz'e'ysa'ne' jun oyaj te ninb'ilweye'. Jun ninq'ijte', mixti' tu'n kyb'inchante jun aq'untle'.</para>
  <para style="pi">
    <verse number="37" style="v" />Aye'tzun q'iju' nim kyoklen tu'n njaw kynima'ne' ayine' Dyos Manb'aj, ati tu'n tok b'uyjtib'il xjan kyu'ne' ex kb'el kyq'o'ne' oyaj tz'e'ysa'n weye' kyoju' q'ij lu, e'chojb'il k'ok'sb'il, oyaj kywitz awal k'ok'e'kywitz, chojb'il ex oyaj b'in, kse'nxju' q'ij in ik'set, <verse number="38" style="v" />kyib'ajxi'tlju' q'ij te ojlab'l te ninb'ilweye' ex kyi'jxi'tlju' q'ij tu'n kykub' q'etju' oyaj tziya'ntl kyu'ne' weye' mujqa tu'n kyk'u'je' tu'n kyq'onteye'.</para>
  <para style="pi">
    <verse number="39" style="v" />Toj o'lajoj q'ij tajlalju' twuqi'n xjaw, tb'ajlenxi' kyb'u'yi'nju'ye' twitz kyawale', kb'el kyik'sa'ne' jun ninq'ij te wuq q'ij te ninb'ilweye', tuk'i'l ojlab'l te tnejel q'ij ex twajxaqi'n q'ij. <verse number="40" style="v" />Toju' tnejel q'ij ktzajel kyiq'i'ne' lob'j kywitz tb'anil tze, kyxaq tut ex tb'anil tze ex e'chjaj toj nin a', ex che tzalajel wuq q'ije' nwitze'. <verse number="41" style="v" />Atl junjun ab'q'i toj twuqi'n xjaw, kb'el kyik'sa'ne' jun ninq'ij te wuq q'ij te ninb'ilweye'. Jun kawb'ilte' majx kjelten ex kjel kyma'ne' kye kyk'wale'. <verse number="42" style="v" />Tojtzu'n wuq q'ij lu kykyaqile', aj Israel qe'ye' kyitz'jlenxe', che tenb'ele' toj pach b'incha'n tu'n tq'ob' tze, <verse number="43" style="v" />Tu'ntzun kyb'inte kykyaqilju' kyyajajile' qa e'najanpun aj Israel wu'ne' toj pach tq'ob' tze tej kyetzwiq'i'ne' toj Ejipt. Ayine' Dyos Manb'aj, chi Dyos.</para>
  <para style="p">
    <verse number="44" style="v" />Iktzun xitma'n Moyses kye aj Israel alkyechaq tq'ijlalil nim kyoklen tu'n kyok teku' Qman Dyos.</para>
  <chapter number="24" style="c" />
  <para style="s1">Aseyt tu'n tajb'en kyoj kantil</para>
  <para style="r">(<ref loc="EXO 27:20-21">Ex 27.20-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tzaj tma'n Qman Dyos te Moyses ikjalu:</para>
  <para style="pi">
    <verse number="2" style="v" />Q'manxa kye aj Israel tu'n ttzaj kyiq'i'n aku' aseyt olib'o, tu'n tajb'en kyeju' kandil tu'n kyk'ant kukxju'.</para>
  <para style="pi">
    <verse number="3" style="v" />A Aaron kb'inchalkye tu'ntzun kyk'ant nwitze' ajtb'aj qonik'an toju' Ja te Mujb'ab'ltib'il, ti'jxi'ju' xb'alun maqb'il teju' kax k'ub'lteju' yol kyejni b'entti'j. Jun kawb'ilte' lu majx kjelten kyeye' ex kjel kyma'ne' kye kyk'wale'. <verse number="4" style="v" />Kb'elix tb'incha'n kytenju' kandil toju' kykb'el q'anpwaq ttx'otx'al tu'ntzun kyk'ant nwitze'.</para>
  <para style="s1">Wab'j nkub' q'et twitz Qman Dyos</para>
  <para style="pi">
    <verse number="5" style="v" />Q'intza tb'anil arin ex tzq'ajsama kab'lajoj (12) muqin, ch'inxmi lajoj lib'r talal junjun, <verse number="6" style="v" />ex q'onqeku'ya tib'aju' mes q'anpwaqile tkub' nwitze', kab'e' txol te waqaqchaq wab'j junjun txol. <verse number="7" style="v" />Ex q'onku'ya sturakxi'x tib'aj junjun txol, tu'n tajb'en teju' wab'j te jun oyaj te nab'ab'l tz'e'ysa'n te ninb'ilweye'. <verse number="8" style="v" />Ati tu'n kykub' q'etju' lu nwitze' atl junjun q'ij te ojlab'l, te jun yol kyejni b'entti'j kyu'n aj Israel tejumajx. <verse number="9" style="v" />Te Aaron che kxe'la' wab'j lu ex kye tyajajil, ati tu'n t-xikywan toj jun najb'il xjan, qu'n a xjanxi'xju' kyxolju' oyaj nche kub' tz'e'yset te ninb'ilweye', chi Dyos.</para>
  <para style="s1">Tz'e'ysb'il kywitzju' nche yolin myab'a'n ti'j Dyos</para>
  <para style="p">
    <verse number="10-11" style="v" />Atitoq jun ichan kyxol aj Israel, aj Israel ttxu atzu'n tman aj Ejipt. Selomit tb'iju' ttxu, tmyal Dib'ri, tyajajil Dan. Jaw q'ojinju' ichan lu tuk'i'l jun aj Israelx toju' kypach, tojtzunju' lu tmaju' ichan talju' qya aj Israel jun yol taq'wix ti'j Qman Dyos. Xiq'i'ntzuntz twitz Moyses, <verse number="12" style="v" />ex kub' kyxq'uqi'n akx intzaj tma'n Qman Dyos titi' tu'n kyb'inchante. <verse number="13" style="v" />Atzunte Qman Dyos tzaj tma'n te Moyses ikjalu:</para>
  <para style="pi">
    <verse number="14" style="v" />Iq'imitza xq'mante taq'wix wi'je' ti'jxi'ju' najb'il; kykyaqilju' ẍe b'inteju' tyol kb'el kyq'o'n kyq'ob' tib'aj twi', ex kykyaqilju' tnam che kb'el b'yonte toj ab'j. <verse number="15-16" style="v" />Ex q'manxa kye aj Israel qa alkyexku' mayolin taq'wix wi'je' ayine' Dyos Manb'aj, tib'ajx kjela' tenju' til ex ati tu'n tkyim toj ab'j kyu'n kykyaqilju' tnam. Qa jun najchaq xjal mujqa aj Israel, qama tma jun taq'wix ti'ju' nb'iye', ati tu'n tkyim.</para>
  <para style="pi">
    <verse number="17" style="v" />Alkye matz'el q'inte tchwinqlal juntl xjal, ati tu'n tkyim.</para>
  <para style="pi">
    <verse number="18" style="v" />Alkye makub' b'yonte talu'n juntl, ati tu'n t-xi' tq'o'n t-xelju' alu'mj.</para>
  <para style="pi">
    <verse number="19" style="v" />Alkye matz'oktb'incha'n taq'wix te jun twnaqil, ex ati tu'n tokb'inchet taq'wix te kse'nxju' xtb'incha: <verse number="20" style="v" />ktoqetel tu'n tpaj toqb'en, k'eletz iq'et twitz tu'n tpaj twitz juntl, k'eletz twitzte tu'n tpaj witzteyj, ati tu'n tb'inchet ti'jku' kse'nxju' matb'incha te juntl.</para>
  <para style="pi">
    <verse number="21" style="v" />Alkye makub' b'yonte talu'n juntl, ati tu'n t-xi' tq'o'n t-xel. Alkye makub' b'yonte jun xjal, ati tu'n tkub' b'yet.</para>
  <para style="pi">
    <verse number="22" style="v" />Ax kawb'ilju' k'ajb'el kyeju' najchaq xjal ex kye aj Israel. Ayine' Dyos Manb'aj nchin q'mante, chi Dyos.</para>
  <para style="p">
    <verse number="23" style="v" />B'ajxtzun tma'n Moysestz kye aj Israel, aye'tzunkye etzkyiq'i'nju' q'mante taq'wix ti'j Dyos toju' najb'il jate'qe'toq, kub' kyb'yo'ntzuntz atzu' toj ab'j. Kyb'incha aj Israel kse'nxju' tchaq' Qman Dyos te Moyses.</para>
  <chapter number="25" style="c" />
  <para style="s1">Ab'q'i te ojlab'l ex ab'q'i te tzaqpib'l</para>
  <para style="p">
    <verse number="1-2" style="v" />Tzaj tma'n Qman Dyos te Moyses twi' witz Sinayi tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">Ajkyokxe' toju' tx'otx' kxe'l nq'o'ne' kyeye', ati tu'n tojlanju' tx'otx' te ninb'ilweye'. <verse number="3" style="v" />B'a'n tu'n kyawan waqaq ab'q'iye' twitzju' kytx'otx'e'. Ikx waqaq ab'q'i tu'n kypodarinteju'ye' tqan kylob'aje' ub'a ex tu'n kyb'u'yinteye' twitz, <verse number="4" style="v" />atzu'n twuqi'n ab'q'i ati tu'n tojlanju' tx'otx' te ninb'ilweye'; lalun che awane' twitzju' kytx'otx'e' toju' ab'q'i lu ex lalun kypodari kylob'aje' ub'a. <verse number="5" style="v" />Ex lalun jaw kych'umi'ne' triy intzaj ch'iy tu'nxtib' tjawlenxi'ju' b'ajsb'il kyawale', ex lalun jaw kyb'u'yi'ne' twitz lob'j ub'a mya podari'n kyu'ne'; ati tu'n tojlanju' tx'otx' b'a'nxi'x. <verse number="6" style="v" />Kkanunelte' tawalju' tx'otx' ktzajel ch'iy tu'nxtib' toju' tojlab'l te kywaye', kywaju' kymajine' ichan ex qya, kywa aq'unal ex kywaju' te najchaq xjal najliqe' kyuk'i'le', <verse number="7" style="v" />kywaju' kyalu'ne' ex kywaju' tojk'ul txkup toju' tx'otx'. Tkyaqil tawalju' tx'otx' matzaj ch'iy k'ajb'el te kywaye'.</para>
  <para style="pi">
    <verse number="8" style="v" />Ati tu'n t-xi' kyajla'ne' wuq sman ab'q'i, mujqa wuq maj wuq ab'q'i, oktzun kjapumel tajlaltz toj kab'naq b'eljoj (49) ab'q'i, <verse number="9" style="v" />Tojtzun tlajoji'n q'ij teju' twuqi'n xjaw, ju' Tq'ij Najsb'il, kxel kyq'ajtza'ne' tuk'a rit toj tkyaqilju' tx'otx'. <verse number="10" style="v" />Atzunju' Tkab'naqlajoji'n (50) ab'q'i k'okyel kyu'ne' te xjan: k'okyel te ab'q'i te tzaqpib'l, ex ati tu'n tex kyma'ne' tqanilju' tzaqpib'l kye kykyaqilju' xjal najliqe' toju' tx'otx' toju' ab'q'i lu. Kykyaqilju' xjal k'anjelkyi'j kyk'etzju' kywitze'l ex che okyel jumajtl tajawju' kytx'otx'. <verse number="11" style="v" />K'okyelju' tkab'naqlajoji'n (50) ab'q'i kyu'ne' te ab'q'i te tzaqpib'l, ex lay che awane' toju' ab'q'i lu ex lalun jaw kychmo'ne' triy intzaj ch'iy tu'nxtib' ex lalun kypodariye' tqan ky-ub'aye' ex mixti' tu'n kychmonteju'ye' twitz, <verse number="12" style="v" />Qu'n xjante' ab'q'i lu ex te tzaqpib'l kyeye'. O'kx kxel kywanju'ye' o'kxju' ktq'a'ju' tx'otx' tu'nxtib'.</para>
  <para style="pi">
    <verse number="13" style="v" />Tojtzunju' ab'q'i te tzaqpib'l lu kykyaqilxe' kb'el kytzyu'n jumajtlju'ye' kytx'otx'e'. <verse number="14" style="v" />Qa ati jun mak'ayin mujqa malq'on ttx'otx' te juntl xjal, lalun kyb'incha jun sb'ujtib'il ti'j; <verse number="15" style="v" />ati tu'n tchjonteju' kloq'ol kse'nxju' tab'q'iyil matxitoq tzik' tik'lenxi'ju' ab'q'i te tzaqpib'l, exju' kk'ayil ati tu'n tqaninte kse'nxju' jte'tl ab'q'i tu'n tjaw awal: <verse number="16" style="v" />qa atix b'a'npun ab'q'itl tu'n tjaw twitz awal, wi'yilx ch'i'ntl twi'; qatzun naqjte'x ab'q'itl, ex naqjni'x ch'i'ntl twi', qu'n ate in k'ayetju' aju' jte' ab'q'i tu'n tjaw twitz awal twitz.</para>
  <para style="pi">
    <verse number="17" style="v" />Lalun kub' kysb'u'n kyib'e' jun te juntl, kyyek'ume' ninb'il nwitze', qu'n ayine' Dyos Manb'aj. <verse number="18" style="v" />Che japunxju' nkawb'ile' kyu'ne', kyb'inchamqe'ye' nnuk'b'ile'. Che japunx kyu'ne', che anq'iltzuntze' toj nak'b'il toju' tx'otx'; <verse number="19" style="v" />ktq'a' te tx'otx' tawal, kche anq'ile' toj nak'b'il twitz ex che wale' ti'ju' tawal tzmaxi'j aj kynoje'.</para>
  <para style="pi">
    <verse number="20" style="v" />Qajlo in kyxima'ne': ¿Ti'tzu'n kxel qwan toju' twuqi'n ab'q'i, qa lay qo awan ex lay qo b'uyin twitz qawal? qa chechiye'. <verse number="21" style="v" />Ktzajel nq'o'nwe' nb'anq'ob'e' toju' twaqaqi'n ab'q'i, exju' twitz kyawale' kjawil kab'alx te oxe' ab'q'i; <verse number="22" style="v" />kche waltzuntze' ti'ju' twitz awal k'u'n akx inche awan jumajtle' toj twajxaqi'n ab'q'i, expe' kche wale' ti'j toju' tb'eljoji'n ab'q'i, akx inpon tq'ijlalil tu'n tjaw kyb'uyi'ne' twitz kyawale'.</para>
  <para style="pi">
    <verse number="23" style="v" />Lay b'ent tk'ayetju' tx'otx' tejumajx: wewe' tx'otx', aye'tzunkye' naq ajb'etu'nqe'ye' twitz, naq ulaqe'ye' weye'. <verse number="24" style="v" />Tu'ntzunju', alkyexku' kytx'otx'e', ati tu'n kyq'onteye' anb'il kyeju' tnejel tajaw tu'n kylq'onte jumajtl.</para>
  <para style="pi">
    <verse number="25" style="v" />Qa ati jun kywnaqile' makyej toj prowil ex makyej tk'a'yi'n ttx'otx' kyeye', aju' twitze'l atixi'x kylontekyib' tuk'i'l b'a'n tu'n tkolpilteju' ojetoq tk'ayiju' twitze'l.</para>
  <para style="pi">
    <verse number="26" style="v" />Qatzun ati jun mixti' jun twitze'l tu'n tkolpinteju' ttx'otx' exqa mab'ent tu'nx tu'n tel tkolpi'n, <verse number="27" style="v" />kxel ximetju' tq'ijlalil matxi' tzik'xi' t-xilen tk'a'yi'n, k'anjel tanjsa'n ti'ju' twi' tx'otx' teju' lq'onte jte' kpomila' tajlal jte' ab'q'itl tu'n tulju' ab'q'i te tzaqpib'l, ex ktzyetel jumajtlju' ttx'otx'. <verse number="28" style="v" />Qatzun min xb'uyetju' medi tu'n, tu'n tkotpetju' ttx'otx', kjel tentzun tx'otx'tz teju' loq'ol tzmaxi'j ajtul kanunju' ab'q'i te tzaqpib'l, tzmaxitzun ktzaqpetel te tx'otx'tz, atzunju' k'ayinte kttzyu' jumajtlju' ttx'otx'.</para>
  <para style="pi">
    <verse number="29" style="v" />Qa ati jun matk'ayi jun ja toj nintnam tok tapi ti'j, ati toklen tu'n tlq'onte jumajtl toj jun ab'q'i t-xilenxi' tk'a'yi'n. <verse number="30" style="v" />Qatzun min xb'ent tkolpetju' ja toj jun ab'q'i, kjeltzuntz tejumajx teju' lq'onte ex kye tk'wal. Lay b'ant ttzaqpet toju' ab'q'i te tzaqpib'l. <verse number="31" style="v" />Aye'tzu'n ja toj tnam min tok tapi kyi'j ikx che okyela' kse'n tx'otx' toj kojb'il; b'a'n tu'n kykolpet ex tu'n kytzyet jumajtl toju' ab'q'i te tzaqpib'l.</para>
  <para style="pi">
    <verse number="32" style="v" />Ati kyoklen aj Leb'i kukxju' tu'n kylq'onte jumajtlu' ja ate' kyoju' nimaqkytanam. <verse number="33" style="v" />Qa jun aj Leb'i kkolpilte, kjel ttzaqpi'n loq'olu' ja toju' ab'q'i te tzaqpib'l ex tu'n tpon aj Leb'i toju' tetzb'il toj nintnam, qu'n o'kxte kyetzb'il aj Leb'iju' kyxol aj Israel o'kxju' kyja ati toj ninkytanam. <verse number="34" style="v" />Mixti' tu'n kyk'ayetju' tx'otx' kyi'jile ninkytanam aj Leb'i, qu'n kyetzb'ilqe' tejumajx.</para>
  <para style="pi">
    <verse number="35" style="v" />Qa ati jun kywnaqile' makyej toj prowil ex mapon kyuk'i'le', ati tu'n kyonine' ti'j kse'n jun te najchaq xjal toj b'e ex tu'n t-xi' kyiq'i'ne' kyjaye'. <verse number="36" style="v" />Lalun tz'el kyqani'n ti'xti'ye' te ex lalun kyqaniye' tub'chilju' tch'ex qama t-xi' kyq'o'ne'; che xob'pekye' nwitze' ex kyk'mome' kywnaqile' tu'n tten kyjaye'. <verse number="37" style="v" />Lalun kyqani tub'chilju'ye' ch'ex medi qama txi' kyq'o'ne', ex lalun jax kych'isa'ne' twi'ju' twa kxel kyq'o'ne'. <verse number="38" style="v" />Qu'n ayinwe' Dyos Manb'aj, inetz q'inkyeye' Ejipt tu'n t-xinq'o'ne' tx'otx' kanaan kyeye' ex tu'n kyk'ulune' weye'.</para>
  <para style="pi">
    <verse number="39" style="v" />Qa ati jun kywnaqile' makyej toj prowil ex kyk'etze' ta', ex matk'ayitib' kyeye', lalun tz'aq'unan kyu'ne' te jun majin lq'o'n; <verse number="40" style="v" />kyq'onke' kse'n jun aq'unal mujqa jun ula. K'aq'unal kyuk'i'le' tzmaxi'j ajtul kanunju' ab'q'i te tzaqpib'l, <verse number="41" style="v" />k'ik'el b'ettzuntz kyjaye' ex kxe'l kyuk'i'lxi'ju' tk'wal tu'n tpon jumajtl kyuk'i'lju' twitze'l toju' ttx'otx'; <verse number="42" style="v" />qu'n nmajin qewe'; ayine' netz q'inkye Ejipt ex mixti' tu'n kyk'ayet te majin. <verse number="43" style="v" />Lalun che oktene' yajulkye; che xob'x pekye' nwitze'.</para>
  <para style="pi">
    <verse number="44" style="v" />Qa kyajb'ile' tu'n kyten kymajine' ichan mujqa qya lq'o'nqe', kylq'onqe'tze' kyoju' txqantl nimaqtnam ate' kyi'jileye'. <verse number="45" style="v" />Ex b'a'n tu'n kylq'onteye' te najchaq xjal najliqe' kyxole', exqe'ju' kyk'wal mache itz'ji akx ate'qe' toj kytx'otx'e'; aye'tzun b'a'n tu'n kylq'onteju'ye' <verse number="46" style="v" />ex tu'n kykyaj kyq'o'ne' te kyetzb'il kyk'wale' aj kykyime'; kche ajb'el kye kukxju'. Atzunkye' aj Israel, mixti' junkye' tu'n tkawin ex tu'n tkub' kyyaju'n kytzike' mujqa kyitz'ine' kyyajajilxe'.</para>
  <para style="pi">
    <verse number="47" style="v" />Qa ati jun najchaq xjal najli toj kytx'otx'e' majaw q'inumax, atzun jun kywnaqile' tb'esinju' najchaq xjal makub' prowix ex matxi tk'a'yi'ntib' teju' najchaq xjal lu, mujqa te juntl najchaq xjal, <verse number="48" style="v" />ati toklen tu'n tlq'etju' tzaqpib'l te maskye t-xilenxi' tk'a'yi'ntib'. Kb'antel tkolpetl tu'n jun ttzik, <verse number="49" style="v" />tu'n jun ttiy, tu'n jun tk'wal ttiy mujqa tu'n alkyexku' juntl twitze'l nqaku' ta'; ex ikx kb'antel tkolpintetib' tu'nxtib', qa ati tu'me'l tu'n, <verse number="50" style="v" />kxel t-xima'n junx tuk'i'lju' lq'onte, tzajx toju' ab'q'i tk'a'yintetib' kpomelx toju' ab'q'i te tzaqpib'l: ax twi'ju' kse'nxju' kyajlal ab'q'i, ex jte'xi' ab'q'i matxi tz'aq'unanxi' kxel ximet kse'nxju' twikyk'u'j aq'unal. <verse number="51" style="v" />Qa atix b'a'npun ab'q'itl tu'n tjapun, axtzun kxel ximetju' jni' kxe'l tq'o'n te kotpib'lte ti'ju' pwaq tk'am tej t-xi' tk'a'yi'ntib'; <verse number="52" style="v" />qatzun naq jni'xtl tu'n tul kanunju' ab'q'i te tzaqpib'l, a kxel tq'o'nju' te kolpib'lte o'kxju' te jte'tl tq'ijlalil tu'n tjapun. <verse number="53" style="v" />Ik k'okela'ju' kse'n jun aq'unal in b'entti'j tu'n taq'unan te jun ab'q'i; lalun kyaje' tu'n tyajunjtz.</para>
  <para style="pi">
    <verse number="54" style="v" />Qatzun min xb'ent tkolpet toju' tq'ijlalil lu, ktzaqpetel toju' ab'q'i te tzaqpib'l junx kyuk'i'lju' tk'wal, <verse number="55" style="v" />qu'n nmajin qewe' aj Israel, nmajin qeku'xi'xe'; ayine' inetz q'inkyeye' Ejipt. Ayine' Dyos Manb'aj.</para>
  <chapter number="26" style="c" />
  <para style="s1">Ky'i'wb'il kye b'a'n che b'in</para>
  <para style="r">(<ref loc="DEU 7:12-24">Dt 7.12-24</ref>; <ref loc="DEU 28:1-14">28.1-14</ref>)</para>
  <para style="pi">
    <verse number="1" style="v" />Lalun che kub' kyb'incha'ne' witzleb' ex tilb'ilal; lalun che jaw kyb'incha'ne' ab'j toj kytx'otx'e' xjanqe'wt ex ab'j tz'ib'a'n twitz; lalun che nimane' kywitz, qu'n ayinwe' Dyos Manb'aj. <verse number="2" style="v" />Kynimanku'ye' q'ij te ojlab'l; che nimanqe'ye' teju' njaye' xjan: ayinwe' Dyos Manb'aj.</para>
  <para style="pi">
    <verse number="3" style="v" />Qama che'x lpeye' kyi'ju' nkawb'ile' exqa mache japun nchaq'b'ile' kyu'ne', ex nche kyb'incha'ne', <verse number="4" style="v" />ktzajel nq'o'ne' jb'al tojxi'x tq'ijlalil, atzunju' tx'otx' exqe'ju' tze kkyq'a' kywitz; <verse number="5" style="v" />atitzun kytriytze' tzmaxi'j ajtul tq'ij lob'j ub'a, ex ati ub'a tzmaxi'j ajtul tq'ij awaj awal; kche wal wab'je' tzmaxi'j aj kynoje', ex kqeb'el kyk'u'je' toju' tx'otx'. <verse number="6" style="v" />B'a'n kche najala'ye' toju' tx'otx', ex lay che jaw sak'puje' ajkywtane', knkla'ju'ye' tx'otx' kye txkup xob'ajilqe'x ex te q'oj. <verse number="7" style="v" />Kche oqelju' kyajq'oje' kyeye', ex kche b'ajel kyu'ne' tu'n k'uẍtx'e'nb'il; <verse number="8" style="v" />Naqpe' kye jwe'kye' kche oqela' jo'naq, ex naq kye jo'naqkye' kche oqela' junmutx' lajk'al (10,000); che b'elkyb'yo'ne' kyajq'oje' tu'n k'uẍtx'e'nb'il. <verse number="9" style="v" />Kche ktzajel nka'yi'ne' tuk'i'l tzalajb'il, kchmetel kyb'aje' wu'ne', ex ktenb'elju' nyole' kyejni b'entti'j kyuk'i'le'. <verse number="10" style="v" />Kche wale' ti'ju' triy k'u'n te jnab'txi', expe' k'eletz kyiq'i'ne' lay b'aj tu'ntzun tokx kyk'u'nju'ye' ak'a'j triy.</para>
  <para style="pi">
    <verse number="11" style="v" />Kchin najalwe' kyxole', ex lay che elwik'o'ne'; <verse number="12" style="v" />chin b'etele' kukxju' kyxole', ayine' chin okyel te Kydyose', aye'tzunkye' che okyel te ntaname'. <verse number="13" style="v" />Ayine' Dyos Manb'aj, inetz q'inkyeye' Ejipt tu'ntzun lalun che oktle' te majin k'a'yi'n kye aj Ejipt, ayine' ẍin toqinteju' yajb'il altoq kyib'aje', ex nche b'etle' mixti'tl kyxob'ele' wu'ne', chi Dyos.</para>
  <para style="s1">Ab'tzib'l kyeju' myab'a'n che b'in</para>
  <para style="r">(<ref loc="DEU 28:15-68">Dt 28.15-68</ref>)</para>
  <para style="pi">
    <verse number="14" style="v" />Qatzun min ẍinx kyb'i'ne' exqa min xxikyb'incha'ne' tkyaqilju' nchaq'b'ile', <verse number="15" style="v" />qama che el kyik'o'ne' nkawb'ile' ex nnuk'b'ile', qa min ẍe kyk'ame', ex min xjapun junju' nchaq'b'ile' kyu'ne', mache el txalpujtzuntze' ti'ju' nyole' kyej b'entti'j kyuk'i'le', <verse number="16" style="v" />ex ikxwe' a knb'incha'ju'ye' kyi'je': ktzajel nq'o'ne' nxob'ele' kyib'aje' ex yab'il te kamik, kyaq, tyab' kywitze', ex che kb'el numje'; ex naqxgan kche awale' qu'n aye' kyajq'oje' kche walteju' twitz kyawale'. <verse number="17" style="v" />Kchin okyel miltz'uje' kyi'je', ex kb'elkyi'je' kyu'nju' kyajq'oje'; kb'elkyi'je' kyu'nju' inche ik'unkyeye', ex kche oqele' maskye mix a'lo' xla'jalkyeye'.</para>
  <para style="pi">
    <verse number="18" style="v" />Qatzun mixti'x xkyb'iye' tu'nju' lu, kb'el ntz'e'ysa'n wuq majtl kywitze', tu'n tpaju' kyile'. <verse number="19" style="v" />Kb'el nxitu'nju'ye' kypi'sale' toju' nimjtib'il, lay tzaj nq'o'ntle' jb'al kyib'aje' ex lay taq'tl tawalju' kytx'otx'e'. <verse number="20" style="v" />Naqxgan kche aq'unale', qu'n layx tzajte tx'otx' tawal, exqe'ju' tze lay kyaq'tl kywitz.</para>
  <para style="pi">
    <verse number="21" style="v" />Qatzun kukxju' kyu'ne' ex mixti'x inche b'ine' weye', kb'el ntz'e'ysa'n wuq majtl kywitze', kse'nxju' kyile'. <verse number="22" style="v" />Kche tzajel nq'o'ne' tojk'ul txkup xob'ajilqe'x kyib'aje' ex kche b'ajelju' kyk'wale' kyu'n, kche b'ajel kytzaqu'nju' kyalu'ne' ex kjel ko'pju' kyb'aje' ex lay che b'etl xjal toj kyb'eye'.</para>
  <para style="pi">
    <verse number="23" style="v" />Qatzun mixti'x inok toj kywi'ye' tu'nju' lu, qa kukx kyq'ojinju'ye' wi'je', <verse number="24" style="v" />ex ikxwe' chin q'ojile' kyi'je' ex kb'el ntz'e'ysa'n wuq majtl kywitze' tu'n tpaju' kyile'. <verse number="25" style="v" />Ktzajel nq'o'n jun q'oje' kyib'aje' tu'n tpaju' yol kyejni b'entti'j kyuky'i'le'; che xe'l oqe' ewal kyoj nimaqkytaname', ayintzunwe' che kxe'lnsma'ne' yab'il kyi'je' ex kb'elkyi'je' kyu'n kyajq'oje'.</para>
  <para style="pi">
    <verse number="26" style="v" />Ajtkub' nxitu'ne' kywaye' k'u'n kyu'ne', lajoj qya ktzq'ajsalte kywaye' toj jun chuj, kxel kysipa'n kyxole' ex lay che noje'.</para>
  <para style="pi">
    <verse number="27" style="v" />Qatzun min ẍin kyb'iye' tu'n ja'lu ex kukx kyq'ojine' wi'je', <verse number="28" style="v" />ikxwe' kchin q'ojile' kyi'je', kb'el ntz'e'ysa'n wuq majtl kywitze' tuk'i'l ntx'u'jile' tu'n tpaju' kyile'. <verse number="29" style="v" />Oktzun che kxel kych'yo'n kyk'waltze' ex kymyale'. <verse number="30" style="v" />Che kb'el nxitu'ne' kyja kywitzleb'e' ex che kb'el npa'ne' kyq'olb'eb'le' te sturak; che kb'el nch'uqb'a'ne' kyimniqe'tle' kyib'aju' kydyose' kyimniqe', kche elel wik'o'ne'; <verse number="31" style="v" />che kb'el nxitu'ne' nimaqkytaname' ex che b'ajel nxitu'ne' kyja kywitzleb'e', lay chin tzalajtle' ti'ju' tk'ok'jal kyoyaje'.</para>
  <para style="pi">
    <verse number="32" style="v" />Kb'el nxitu'nju'ye' tx'otx', aye'tzu'n kyajq'oje' che ulel najal toj, kche lab'tel tu'n. <verse number="33" style="v" />Aye'tzunkye' che kxel nsputi'ne' kyxol nimaqtnam ex chin okyel lpeye' b'yolkyeye' tu'n k'uẍtx'e'nb'il; kjel chq'ajlajixu' kytx'otx'e', ex che kjel xitju' nimaqkytaname'. <verse number="34" style="v" />Kyjeltentzun tx'otx'tz toj nak'b'il tkyaqilju' tq'ijlalil kjel kytzaqpi'ne' ex ajkytene' toj kytx'otx' kyajq'o'je'; iktzun k'ojlala'ju' tu'n tokt-xelju' min sojlan kyu'ne'. <verse number="35" style="v" />K'ojlalju' tx'otx' toj tkyaqilju' tq'ijlalil makyej ten, te t-xelju' min sojlan kyu'ne' najli qe'toqe' twitz.</para>
  <para style="pi">
    <verse number="36" style="v" />Aye'tzunju' kywnaqile' mache kyej anq'in toj kytx'otx' kyajq'oje', k'okyel nq'o'ne' nin xob'el kyi'j, che kb'el oq naq tu'n tq'ojq'ojel jun t-xaq tze ajtkub' tz'aqi; che kb'el oq naku'xwitloj xla'ja'nqe' tu'n kyajq'oj tuk'i'l k'uẍtx'e'nb'il, kyjunalx che b'eltz'aqi ex mix a'lo'te xla'jalkye; <verse number="37" style="v" />kche jawil takpuj jun ti'j juntl naku'j inche oq toj q'oj, maskye mix a'lo' xla'jalkye; ¡mix-a'lo'x junkye' kweb'el kywitzju' kyajq'oje'! <verse number="38" style="v" />Che kb'el nb'yo'ne' kyxolu' nimaqtnam, ex che b'elb'ajsa'ne' kyu'n kyajq'oje' tojx kytx'otx'e'; <verse number="39" style="v" />Aye'tzu'n mache kyej anq'in toj kytx'otx'u' kyajq'oje', che kyimel tu'ntpaj kyil; ¡che kyimel junx kyuky'i'lju' kyman tu'n tpajxju' kyil!</para>
  <para style="pi">
    <verse number="40" style="v" />Maskyetzun matz'el kynik'e' ti'ju' kyile' ex kyilju' kymane', tu'n min njapun nyole' kyu'ne' ex inche q'ojine' wi'je', <verse number="41" style="v" />ikxwe' kchin q'ojile' kyi'je' ex che kxel wiq'i'ne' toj kytx'otx'ju' kyajq'oje'; atzuntzu' kb'ela' me'sa'n kynab'le' tok kyi'j witzleb', kb'el kychjo'ntzun kyiltze'. <verse number="42" style="v" />Oktzun ktzajel nna'n nyoltze' kyej b'entti'j tuk'i'l Jakob', tuk'i'l Isaak, ex tuk'i'l Ab'raam, ex ktzajel nna'ne' tx'otx', <verse number="43" style="v" />ju' kjel kytzaqpi'ne' ex k'ojlal toju' tq'ijlalil lay che najane' twitz; kb'el kychjo'ntzun kyiltze', qu'n mache el kyik'o'ne' nnuk'b'ile' exqe' nkawb'ile'.</para>
  <para style="pi">
    <verse number="44" style="v" />Tu'npetzunju', maskye ate'qe'ye' toj kytx'otx'ju' kyajq'oje', lay che elwik'o'ne' ex lay che el wi'jla'ne'; lay che kub' nb'yo'ne' ex kjapumelu' nyole' kyej b'entti'j wu'ne' kyuk'i'lju' ojtxi' kyyajilb'ene', qu'n ayinwe' Dyos Manb'aj. <verse number="45" style="v" />Kpena' tzajel nna'ne' nyole' kyej b'entti'j kyuk'i'l tej kyetzwiq'i'ne' Ejipt kywitzju' nimaqtnam tu'n kyajb'ene' weye'. Ayine' Dyos Manb'aj, chi Dyos.</para>
  <para style="p">
    <verse number="46" style="v" />Aye'tzun kawb'il ja'lu, e'nuk'b'il ex xnaq'tzb'il tzaj tq'o'n Qman Dyos te Moyses twi' witz Sinayi tu'n t-xitma'n kye aj Israel.</para>
  <chapter number="27" style="c" />
  <para style="s1">Ti'xti' xjansa'nqe' te Dyos</para>
  <para style="p">
    <verse number="1-2" style="v" />Tzaj tma'n Qman Dyos te Moyses tu'n t-xitma'n kye aj Israel kjalu:</para>
  <para style="pi">Qa ati jun tajb'il tu'n tjapun tyol tu'nju' oje tma weye' tu'n ttzaj tq'o'n kse'nxju' twi' jun xjal, <verse number="3" style="v" />jun ichan te winqi'n (20) ab'q'i kpomelx te oxnaq (60) ab'q'i kxe'l tma'na te tu'n tq'onte jun o'nb'il te jun lib'r saqpwaq, kse'nxju' malb'il toju' ja xjan; <verse number="4" style="v" />qatzun jun qya, aju' o'nb'il tu'n tq'onte masch'i'n nik'jan lib'r saqpwaq. <verse number="5" style="v" />Atzu'n kyeju' xjal tzajx te jwe' ab'q'i tu'n tpon te winqi'n ab'q'i, ch'inxmi nik'jan lib'r saqpwaqju' o'nb'il tu'n tq'onte qa q'a, qatzun txin masch'i'n oxe' ons saqpwaq tu'n kyq'onte. <verse number="6" style="v" />Atzu'n kye k'wal tzajx te jun xjaw tu'n tpon te jwe' ab'q'i, aju' o'nb'il kyu'n qa q'a, masch'i'n jun ons tk'i' nik'jan saqpwaq, qatzun txin te ch'intlmi jun ons saqpwaq. <verse number="7" style="v" />Atzu'n kyeju' xjal matxi' chi ex tib'aj oxnaq (60) kyab'q'i, te ch'intlmi jwe' ons saqpwaqju' o'nb'il tu'n kyq'onte qa ichan, qatzun qya masch'i'n oxe' ons saqpwaq tu'n kyq'onte. <verse number="8" style="v" />Qatzun prowxi'xju' xjal ex lay b'ant tchjet tu'n kse'nxju' q'ma'ntl, kxel iq'et twitzju' pale tu'ntzun tmante jte' tu'n tq'onte kse'nxju' tu'me'l tu'n.</para>
  <para style="pi">
    <verse number="9" style="v" />Aye'tzu'n alu'mj b'a'n tu'n kytzaj kyq'o'ne' weye', tkyaqil alu'mj che ktzajel kyq'o'ne' weye' kche xjansetel, <verse number="10" style="v" />ex lay ch'exb'et tuk'i'l juntl alu'mj, maskye tb'anilxi'x mujqa taq'wix. Qatzun makych'exb'eye', kxjansetelju' alu'mj oje q'onjtz tuk'i'lxi'ju' alu'mj in q'onjtz te t-xel.</para>
  <para style="pi">
    <verse number="11" style="v" />Qatzun jun alu'mj tz'il myab'a'n tu'n ttzaj kyq'o'ne' weye', ati tu'n t-xi' iq'etju' alu'mj te' pale <verse number="12" style="v" />tu'n tmante jte' twi', kse'nx tka'yinkju' alu'mj qa tb'anil mujqa mya. Atzunju' tajlal matmaju' pale, atzun twi'ju', <verse number="13" style="v" />qatzun kyajb'ile' tu'n tkolpetju' alu'mj, ati tu'n kyq'onteye' tjwe'yi'n tnejtlju' o'nb'il tib'aju' twi' maq'manjtz.</para>
  <para style="pi">
    <verse number="14" style="v" />Qa ati jun matzaj tq'o'n tja tu'n t-xjanset weye', aju' pale kq'malte jte' twi'ju' ja kse'nxju' b'inchb'ente. Aju' tajlal ktma' pale, atzun twi'ju'. <verse number="15" style="v" />Qatzun tajb'ilju' saj q'onte tu'n tkolpetl tu'n, ati tu'n tq'onte jun tjwe'yi'n tnejtlju' o'nb'il tib'aju' twi' ojetoq q'manjtz, kyjeltzun jumajtltz te tja.</para>
  <para style="pi">
    <verse number="16" style="v" />Qa ati jun matzaj tq'o'n jun piẍ tx'otx' ti'ju' tetzb'il tu'n t-xjanset weye', kximetel twi'ju' tx'otx' kse'nxju' tawal intq'o'n, nik'jan lib'r saqpwaq tu'n junjun kyintal seb'ad njaw twitz. <verse number="17" style="v" />Qama t-xjansaju' ttx'otx' weye' tojxju' ab'q'i te tzaqpib'l, ax twi'ju' kjelten kse'nxju' q'ma'ntl; <verse number="18" style="v" />qatzun mat-xjansa tik'lenxi'ju' ab'q'i te tzaqpib'l, kxel t-xima'n pale tajlalju' saqpwaq tu'n tq'onte, k'elel iq'et ti'ju' twi' q'ma'ntl kse'nxju' jte' ab'q'itl tu'n tponju' ab'q'i te tzaqpib'l.</para>
  <para style="pi">
    <verse number="19" style="v" />Qatzun tajb'ilju' xxjansanteju' tx'otx' tu'n tkolpetl tu'n, ati tu'n tq'onte jun tjwe'yi'n tnejtl tib'aju' twi' xima'n, kyjeltzun tx'otx'tz te; <verse number="20" style="v" />qatzun min xkolpet tu'n, exqa matxi k'ayetju' tx'otx' te juntl xjal, laytzun b'ent tkolpetltz tu'n. <verse number="21" style="v" />Ajtzun ttzaqpetju' tx'otx' toju' ab'q'i te tzaqpib'l, kjelten xjansa'n weye' ex kttzyu' pale te kyetzb'il.</para>
  <para style="pi">
    <verse number="22" style="v" />Qa ati jun matzaj tq'o'n jun tx'otx' tu'n t-xjanset weye' loq'oj tu'n, mya ti'ju' tetzb'il kyxolju' toj tja, <verse number="23" style="v" />kxel t-xima'n pale twi' tuk'i'lju' xjal lu tzmajx ajtul kanunju' ab'q'i te tzaqpib'l, textzu'n q'ij lu ktchja' xjal lu kse'nx twi' tx'otx' xb'aj ximet, kt-xjansa'tzuntz weye'. <verse number="24" style="v" />Tojtzunju' ab'q'i te tzaqpib'l, k'anjelti'ju' tx'otx' lu teju' k'ayinte, aju' tajawku'xi'x.</para>
  <para style="pi">
    <verse number="25" style="v" />Tkyaqilju' twi' kxel t-xima'na kse'nxju' pwaq in ajb'en toju' ja xjan, ch'inxmi tz'aqla' nik'jan ons talal.</para>
  <para style="pi">
    <verse number="26" style="v" />Aye'tzu'n tnejel kyal alu'mj, weqe'ye' tu'n tpaju' tnejelqe', mix-a'lokye kxjansalkye. B'a'ntzun qpoj tman wakx mujqa qpoj tman rit, weqe'ye'. <verse number="27" style="v" />Qatzun jun alu'mj tz'il, b'a'n tu'n tkolpet kse'nxju' twi' kxel ximet tuk'i'l jun tjwe'yi'n tnejtl tib'aju' twi'. Qatzun min xkolpet, b'a'n tu'n t-xi' k'ayet kse'nxju' twi' xima'ntl.</para>
  <para style="pi">
    <verse number="28" style="v" />Qa ati jun matzaj tq'o'n jni'ju' ati te tu'n t-xjanset weye', b'a'ntzun xjal, alu'mj mujqa tx'otx' ti'ju' tetzb'il kyxolju' toj tja, mixti'x jun tu'n tk'ayet ex tu'n tkolpet; tkyaqilju' ktzajel tq'o'n che kyjelten xjanxi'x tu'n kyajb'en weye'. <verse number="29" style="v" />Ex Lay b'ant tkolpet jun xjal b'entnitlti'j tu'n tkyim: ati tu'n tkyim.</para>
  <para style="pi">
    <verse number="30" style="v" />Aju' tlajoji'n tnej kyeju' kwitz tawalju' tx'otx' injaw, triy ex kywitz tze, weye' ex xjansa'nqe' weye'. <verse number="31" style="v" />Qa ati jun tajb'il tu'n tkolpinte jni' ti'ju' tlajoji'n tnej lu, ati tu'n tchjonte jte' twi' tuk'i'l jun tjwe'yi'n tnejtl.</para>
  <para style="pi">
    <verse number="32" style="v" />Jun ti'j lajojchaq alu'mj, wakx mujqa rit, ktzajel kyq'o'ne' weye' te tlajoji'n tnej, <verse number="33" style="v" />mixti' tu'n kyjaw sk'etju' tb'anil exju' toq'wixqe', ex lay ch'exb'et jun tu'n juntl. Qatzun mab'aj jun ch'exb'eb'l, kykab'ilju' alu'mj kche kyjelten xjan, aju' tnejel exju' kyjel te t-xel, qu'mtzun lay tz'anjtl kyi'j teju' xkub' q'onkye, chi Qman Dyos.</para>
  <para style="p">
    <verse number="34" style="v" />Aye'tzun chaq'b'ilju' tzaj tma'n Qman Dyos te Moyses twi' witz Sinayi tu'n t-xitma'n kye aj Israel.</para>
</usx>