<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="MAL" style="id">MAL.TXT Febrero 2009 Pedro D. Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Malaquías</para>
  <para style="toc3">Mal</para>
  <para style="toc2">Mal</para>
  <para style="toc1">Tuj Malakyiy (Malaquías)</para>
  <para style="mt1">TUJ MALAKYIY</para>
  <para style="mt2">(Malaquías)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Aju' b'iyj Malakyiy tzajni toj eb'rey, a tz'elpuna' nsanjelale'. Eq'ma'njtzju' tpakb'alil toju' u'j lu toju' ab'q'i junka'l jo'naq (500) na'mxtoq tul Qajaw Jesukrist, tjawlenxi' b'incha'ntlju' tja Dyos. Ojetoq che b'aj kub'numju' xjal, expe' ojetoq b'ajx kyxonkyib' toj kypi'sal ex matxitoq tz'el kyik'o'n k'u'lb'il te Qman Dyos. Jni'qe'xju' xjal toju' tnam exqepe' pale b'aj kub'kyxk'ayu'n oyaj atitoq tu'n tb'ajx kyq'o'n te Qman Dyos, ex b'aj kyej kykolb'e'n tchaq'b'il Qman Dyos. Eb'ajtzak'u'n aj Israel tu'n tpaj kyil tu'n t-sanjelal Dyos (1.1—2.16) ex xitma'n tqanil kye qa che okyel toj xjel tu'n Qman Dyos ex che t-ẍtilsa'. Ex oktoq tzajel tchq'o'n t-sanjelal nejli twitz, ikx toklen kse'n Eliy t-sanjelal Dyos (4.5), tu'n tb'inchantepunju' tb'e. Kuwxi'x toklenju' tq'ijlalil tkawb'il Qman Dyos xi' tul kanun, che tzaqpetelju' matz'anjtzti'j kyanmi ex matxi kynima'n, ex che tenb'el toj tzalajb'il.</para>
  <chapter number="1" style="c" />
  <para style="s1">Tk'u'jlalil Dyos Ti'j Israel</para>
  <para style="p">
    <verse number="1" style="v" />A tpakb'alil ja'lu tzaj tma'n Qman Dyos te Malakyiy ju' t-sanjelal tu'n txitma'n kye aj Israel.</para>
  <para style="p">
    <verse number="2" style="v" />Chi Qma Dyos kjalu: K'u'jla'n qe'ye' wu'ne', chij. Aye'tzunkye' ntzaj kytzaq'we'ne' kjalu: ¿Se'n taq'wi tu'n telqnik'e' ti'j qa nqo tk'u'jla'na? chechije'. Atzunte Qman Dyos ntzaj ttzaq'we'n: Inche nk'u'jla'ne', kse'nx k'u'jlb'ente Jakob' wu'ne', extzun kyitz'inkyib' tuk'i'l Esawu <verse number="3" style="v" />elwik'o'ne' Esawu. Nimaq k'ul toqu' ttx'otx' Esawu, jun chq'ajlajtl xkyaj wu'ne', ex xinq'o'ne' ttx'otx' kye tojk'ul txkup, chi Dyos.</para>
  <para style="p">
    <verse number="4" style="v" />Qatzun makyma aj Edom tyajajil Esawu kjalu: Matxi' kub' xitu'n qtaname', oktzun jawil qb'incha'ntlqe' qtanam, qa chechi, ktzajel ttzaq'we'n Qman Dyos nimtipumal kye kjalu: kjawil kyb'incha'n jumajtl, ex kb'el nxitu'n jumajtle'. K'okyel tb'i kytx'otx' te Kytx'otx' b'inchal myab'a'n ex Nintnam tkub' ttx'u'jil Dyos tib'aj tejumajx. <verse number="5" style="v" />Kyka'yi'ye' tu'nku' kywitze' ex kkyma'ye' kjalu: ¡Nimxi'xte Qman Dyos toklen, majx matz'ex tqanil kyi'jxi' tnaqach Israel!</para>
  <para style="s1">Eb'aj tzak'u'n pale tu'n Qman Dyos</para>
  <para style="p">
    <verse number="6" style="v" />Chi Qman Dyos nimtipumal kye pale: Nche nimankye' k'wa'lb'aj kye kyman, exqe' lq'o'n majin nche niman kye kyajaw. Qatzun ayine' Manb'aj kyeye', ¿tiqu'ntzun min nchin kynima'ne'? Qa ayine' Kyajawe', ¿Tiqu'ntzun min nche okslane' weye'? Inchin elkyik'o'ne', extzun nkyma'ntle': ¿Alkye tu'me'l nela' qik'u'na? chechije'. <verse number="7" style="v" />Intzaj kyiq'i'ne' wab'j taq'wix tib'aju' q'olb'eb'l weye', extzun ntzaj kyqani'ntle': ¿Titi'tzu'n taq'wix nqb'incha'ne' twitza? chechije'. Inkyb'incha'ne' taq'wix weye' ajtkub' kyxima'ne' qa b'a'n tu'n tel kysuchu'ne' q'olb'eb'l weye' <verse number="8" style="v" />ex qa mya taq'wix tu'n kykub' kyq'o'ne' alu'mj moẍ, kox mo yab'qe' te chojb'il nwitze'. ¡Kux kyxi'tzune' ex kyiq'inxe' kyeju' nche kawin kyxole'! ¡Atzun kyile' qama txikyk'mo'n kyoyaje' lu tuk'i'l tzalajb'il! chi Qman Dyos. <verse number="9" style="v" />Kyqaninxe' te Dyos tu'n ttzaj q'aq'an tk'u'j qi'j. Qatzun ikyqe' kyoyaju'ye' nche kub' kyq'o'ne' lu, lalun kymaye' qa che k'monjtzele' tu'n Dyos tuk'i'l tzalajb'il. Intma'n Qman Dyos nimtipumal kjalu: <verse number="10" style="v" />¡Noqwit tzul jun kyxole' jpulkye tjpelju' ja te k'u'lb'il, tu'ntzun lalun che ultle' txqolte q'aq' mixti' tajb'en tib'aju' q'olb'eb'l weye'! Qu'n min nchin tzalaje' kyi'je' ex lay che nk'amtle' kyoyaje'. <verse number="11" style="v" />Inchin nimanjtzwe' kyoj kykyaqil nimaqtnam; inkytz'e'ysa'n xjal sturak te ninb'ilweye' toj tkyaqil najb'il ex nkub' kyq'o'n kyoyaj tb'anilxi'x weye'. <verse number="12" style="v" />Aye'tzunkye' myab'a'n nkyb'incha'ne' weye', qu'n in elkyik'o'ne' q'olb'eb'l weye' ex nkyxima'ne' qa i'k'b'ilxju' wab'j tkub' tib'aj. <verse number="13" style="v" />Intzun kyma'ntle': ¡Matxi' qo siktiye' ti'j tkyaqil ja'lu! chechije'. Ex nchin elkyik'o'ne'. Expe' toj kynab'le' qa nchin tzalaje' ajkyule' q'ol jun alu'mj elq'a'n te chojb'il nwitze', mo jun wakx kox mujqa yab'. <verse number="14" style="v" />¡Kb'el taq'wix tib'aju' xjal sb'ul ntzaj tma'n tu'n ttzaj tq'o'n jun alu'mj tb'anilxi'x weye' kyxolju' talu'n, extzun makub' tq'o'n jun alu'mj tzkaj nwitze'! Ayinweju'ye' Nimaqkawil nim toklen, ex ati nchiylale' kyoj nimaqtnam, chi Qman Dyos nimtipumal.</para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ja'lotzun, a yol ja'lu kyeye' pale: <verse number="2" style="v" />Ilti'j tu'n t-xikyb'i'ne' nyole' ex ati tu'n kynimane' axxi'x weye'. Extzunqa min xkyb'inchaye', che kjel nq'o'ne' tjaq' taq'wix. Na'mxna' kynimane' weye', expe' ktzajel nq'o'ne' taq'wix kyib'aju' ti'xti' nkyk'mo'ne' toju' kyajb'eb'le' te pale. Chi Qman Dyos nimtipumal.</para>
  <para style="p">
    <verse number="3" style="v" />K'elel wiq'i'ne' kyipumale' ex k'okyel nxone' kytxa alu'mj nche tzaj kyiq'i'ne' te chojb'il kyplaje'. ¡Ex majx che b'je'lex nxone' tuk'i'lxi' kytxa alu'mj! <verse number="4" style="v" />K'eleltzun kynik'tze' qa ayine' nchin q'onte chaq'b'il lu tu'n ttenju' nyole' kyej b'entti'j tuk'i'l Leb'i kukxju', chi Qman Dyos nimtipumal.</para>
  <para style="p">
    <verse number="5" style="v" />Chwinqlal ex nak'b'il toqju' nyole' kyejni b'entti'j kyuk'i'l aj Leb'i. Xinq'o'ne' kye tu'n kyniman ex tu'n kyxob' weye', ex kyek'u tchiylal ex ninb'ilweye'. <verse number="6" style="v" />Xikyq'o'n aj Leb'i xnaq'tzb'il tib'aju' ax ex mixtoqti' nkyma'n taq'wixil. Intoq che anq'in b'a'n wuk'i'le' ex nim xjal kyej kytzaqpi'n b'inchaj myab'a'n kyu'n. <verse number="7" style="v" />A kyaq'un paleju' tu'n kyxi' kyxnaq'tza'n xjal tu'n telkynik' wi'je', ex kykyaqil xjal tu'n kyul k'mol xnaq'tzb'il kye, qu'n aye' nsanjelju'ye' ayine' Dyos Manb'aj nimwipumale'.</para>
  <para style="p">
    <verse number="8" style="v" />Aye'tzunkye' pale, matxi' che el txalpuje' ti'ju' b'a'n b'e; nim xjal matxi' che kub' tz'aq tu'n kyxnaq'tzb'ile' myab'a'n. Tu'ntzu'n matxi' che okye' xitulteju' nyole' kyejni b'entti'j kyuk'i'l aj Leb'i. <verse number="9" style="v" />Tu'ntzunju', b'ajxna' chinxa' kyb'i'ne' expe' mya junelni kyilwi xjal kyu'ne' ajt-xikyq'o'ne' xnaq'tzb'il kye, knb'incha'ye' tu'n kyokq'o'ne te mya'l ex tu'n kyel ik'u'ne' kyu'n kykyaqil xjal, chij. Aku' Qman Dyos nimtipumal inq'mante.</para>
  <para style="s1">Lalun kyej kykolb'e'n kyxu'jile', chi Dyos.</para>
  <para style="p">
    <verse number="10" style="v" />¿Ma myatzun junx Qman, aju' Dyos kub' b'inchanqe qkyaqil? ¿Tiqu'ntzun noqx nqsb'u'nchaq qib', ikytzu'n to'ka' xitulteju' yol kyejni b'enti ti'j tu'n Dyos kyuk'i'l ojtxi' qchman? <verse number="11" style="v" />Min njapun kyol aj Juda tu'n kyajb'en te Dyos, ex nkyb'incha'n ti'xti' taq'wixi'x toj Jerusalen ex toj Israel. Matxi' kub'kyya'ju'n aj Juda t-xjanilju' ja te k'u'lb'il k'u'jla'nxi'x tu'n Qman Dyos, exqe' ichan aj Juda mab'ajtzaj kyiq'i'n kyxu'jil k'lul witzleb'qe'. <verse number="12" style="v" />¡Che kub'xwit tnajsa'n Qman Dyos xjal nche b'inchante ti'xti' lu toju' ninqtanam, alkyexku'chaq xjal b'a'nqa ntzaj kyiq'i'n kyoyaj twitzju' Qman Dyos nimtipumal!</para>
  <para style="p">
    <verse number="13" style="v" />Aye'tzunkye' inxi'xpe' kyb'incha'n txqantle': inxi'x kukyak'sa'ne' q'olb'eb'l te Dyos tu'n ta'l kywitze', inxi'x che oq'e' kuw tu'nju' min nxitk'mo'ntl Dyos kyoyaje' tuk'i'l tzalajb'il. <verse number="14" style="v" />¿Inxtzun kyqani'ntle' titiqu'n? Kanlina' twitzte Qman Dyos tu'nju' min xjapun tyola xittziya'na te t-xu'jila tej mjeya tuk'i'l ku'xunqe'toqe'. ¡Atoq t-xq'lab'ju'ya, ex xittziya'na tu'n tjapun tyola te! <verse number="15" style="v" />¿Ma myatzun ax Dyos b'inchanteju' xmil exju' t-xew xjal? ¿Titi'tzu'n tajb'ilju' Dyos lu qa mya tu'n kyxjansetju' tyajajil te? ¡Kyka'yinx kyib'e' ex japunx kyole' xikytziya'ne' te kyxu'jile' ku'xunqe'toqe'! <verse number="16" style="v" />Intma'n Qman Dyos nimtipumal, Kydyos aj Israel, kjalu: ¡Kyka'yinxtzun kyib'e', ex japunx kyole'; inel wik'o'nwe' xjal nkub' tpa'ntib' tuk'i'l t-xu'jil ex nb'aj ttz'ilsa'ntib' tu'n txqan il ntb'incha'n!, chi Dyos.</para>
  <para style="p">
    <verse number="17" style="v" />Matxi' siktite Qman Dyos b'ib'enkyeye'; aye'tzunkye' inx kyxjelu'ne': ¿Titi'tzu'n matxi' txiqma'ne' tu'n qa matxi' sikti b'ib'enqeye'? chechije'. Matxi' kymaxi'ye' qa b'a'nqe' b'inchal myab'a'n toj twitz Qman Dyos, exqa ntzalaj kyi'j. ¡Min nkyoksla'ne' qa tz'aqlite Dyos!</para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Chi Qman Dyos nimtipumal kjalu: Kxel nsma'ne' nsanjelale' tu'n tkub'nej nwitze' b'inchalteju' b'e. ¡Aju' Dyos Manb'aj nche jyone' ti'j, lwiyxi'x k'okyix toju' tja te k'u'lb'il; ch'inxtl tulju' sanjelal q'malteju' yol kyejni b'entti'j kyuk'i'le', aju' nche ayone' ti'j!</para>
  <para style="p">
    <verse number="2" style="v" />¿Alxixlokye kweb'el twitz toju' q'ij ajtul? ¿Alxixkye kb'antel twe' twitz ajtul? Qu'n tzul kse'n jun q'aq', ẍtilsalqe; ikyk'okyela' kse'n jun q'eq, kb'je'lel tiq'i'n qtz'ilil. <verse number="3" style="v" />Kb'el qe Qman Dyos ẍtilsalkyeju' pale, tyajajil Leb'i, kse'n xjal nokxtq'o'n q'anpwaq ex saqpwaq toj q'aq' tu'n t-ẍtilset. Yajxi'tzuntl b'a'n tu'n tkub' kyq'o'n kyoyaj twitz Qman Dyos kse'nxju' tu'me'l. <verse number="4" style="v" />Oktzun tzalajel Qman Dyostz ti'ju' kyoyaj aj Juda ex aj Jerusalen, kse'nx intoq tzalaj ti'j nejtl.</para>
  <para style="p">
    <verse number="5" style="v" />Chi Qman Dyos nimtipumal kjalu: Chin nule' xjelul kyeye'. Ex ikx chin okyile' tziyalkyeju' ajk'a, e'ajpajil, exqe' ntzaj kyna'n tb'i Dyos ti'ju' mya ax, exqe' nche kub' kyjtz'o'n aq'unal, exqe' qya kyimni kychmil ex meb'a, exqe' nche okten yajulkye najchaq xjal, exqe' min nche niman weye', chi Dyos.</para>
  <para style="s1">Aju' tlajoji'n tnej exqe' oyaj</para>
  <para style="p">
    <verse number="6" style="v" />Ayinweju'ye' Dyos Manb'aj. Na'mx nch'exb'ete'. Qu'npena'tzun na'mx kynaje' tyajajil Jakob'. <verse number="7" style="v" />Mache el txalpuje' kyi'ju' nchaq'b'ile', kse'n telkypa'nkyib' ojtxi' kychmane', ex min nche kynima'ne'. Nxinma'ne' kyeye' ayine' Dyos Manb'aj nimwipumale': ¡Kukyajtle' wuk'i'le' ex k'anjetztl tink'u'je' kyi'je'! Aye'tzunkye' nkyma'ne': ¿Tiqu'n k'anjela'tlqi'je' tk'etza? <verse number="8" style="v" />Atzunwe' nchin xjelune': ¿Ma b'a'ntzun tu'n talq'an jun xjal ti'j Dyos? ¡Matxina' chin kub'kyalq'a'nkye'! Extzun ntzaj kyqani'ntle': ¿Ti'tzu'n matxi' kub' qelq'a'ne' teya? chechije'. ¡Matxi' kub'kyelq'a'ne' tlajoji'n tnej exqe' oyaj! <verse number="9" style="v" />Iku', tkyaqilju' nintnam ex kykyaqile' nche kub' alq'anweye', qu'mtzun ktzajel nq'o'ne' taq'wix kyib'aje'. Ayine' Dyos Manb'aj nimwipumale' nchin yolin: <verse number="10" style="v" />Kyiq'intze' kyoyaje' tlajoji'n tnej toju' k'uwenj toj njaye', tu'ntzun tten wab'j toj njaye'. Tzik' kywitze' wi'je' tu'n ja'lu, atzun kyile' qa min ẍenjaqe' tjpel kya'j tu'n ttzaj ntzaqpi'ne' ky'i'wb'il kyib'aje'. <verse number="11" style="v" />Lay waje' tu'ntb'aju' twitz kyawale' ex tqan kyawale' tu'n soj. <verse number="12" style="v" />Kykyaqil xjal kyoj nimaqtnam kyma'n kyeye' qa majx b'a'n ta'qe'ye', qu'n achb'ajilixi'x ktenb'ela' kytx'otx'e'. Ayine' Dyos Manb'aj matxi' chin q'mante.</para>
  <para style="s1">Q'aq'an tk'u'j Dyos kyi'ju' ttanam</para>
  <para style="p">
    <verse number="13" style="v" />Chi Qman Dyos kjalu: Matxi' kyma kyole' kuwxi'x wi'je'. Extzun nkyqani'ntle' kjalu: ¿Ti'tzu'n taq'wix matxi' qmaye' ti'ja? chechije'. <verse number="14" style="v" />A oje kymaye' wi'je' kjalu: Mixti'xte' tajb'en tu'n qajb'en te Dyos. ¿Tixi'xti' qkanb'a' qama txiqb'i'ncha'n ntchaq'u'n qe, tu'n qb'et toj b'is twitz Qman Dyos nimtipumal? <verse number="15" style="v" />Matxi' qile' tzalajb'il ta'qe' nkynima'n kyib', b'a'n nche ela' ti'xti' kyu'n b'inchal myab'a'n, nkub' kyq'o'n Dyos toj joyb'ilti'j ex min ntzaj jun tz'e'ysb'il kywitz, chechije'.</para>
  <para style="p">
    <verse number="16" style="v" />(Eb'ajtzun yolinju' nche niman te Dyos kyxolilex, inxi'xtoq b'in Qman Dyos ti'ju' ntoq kyma'n. Ex kub' tz'ib'a'n jun u'j twitzku' Qman Dyos, intoq tma'n tu'n ttzaj na'n kyeju' nche niman te Dyos ex nche ximan ti'j.)</para>
  <para style="p">
    <verse number="17" style="v" />Ntma'n Qman Dyos nimtipumal kjalu: Kjel b'ent jun q'ij wu'ne' tu'n kyok jumajtl te ntaname'. Kse'n jun manb'aj ntzaj laqtk'u'j ti'ju' tk'wal najb'en te, ikytzu'n ktzajel q'aq'an nk'u'je' kyi'j. <verse number="18" style="v" />K'eleltzun jumajtl kynik'tze' qa mya junju' b'a'n tuk'i'lju' myab'a'n, mya junxju' nk'ulun te Dyos tuk'i'lju' min nk'ulun te Dyos.</para>
  <chapter number="4" style="c" />
  <para style="s1">Tq'ijlalil tulel Qman Dyos</para>
  <para style="p">
    <verse number="1" style="v" />Chi Qman Dyos nimtipumal: Xi' tul lq'e tq'ijlalil, nxi'x k'ant kse'n q'aq' toj jun chuj, kykyaqilju' nkynima'nkyib' ex b'inchal myab'a'n che b'ajel tz'e'y toj, ex mixti'tlkye kjelten. <verse number="2" style="v" />Aye'tzunkye' nche nimane' weye', kqob'tz'ajel tnik'alilti'j wu'ne' kse'n t-spik'umal q'ij, nultiq'i'n chwinqlal kyoju' ttilky'ajel. Aye'tzunkye' che xlik'pule' tu'n kytzalajb'ile' kse'nqe' qpoj tman wakx ajkyetz ti'jxi' kywab'l. <verse number="3" style="v" />Tojtzu'n q'ij lu in nb'inch'a'ne' tten, che b'el kywab'e'ne' b'inchal myab'a'n naku'xwitloj quq.</para>
  <para style="p">
    <verse number="4" style="v" />Kyna'ntze' kawb'il xinq'o'ne' te nmajine' Moyses twi' witz Oreb'. ¡Kawb'il qe' ex chaq'b'il qe' atitoq tu'n t-xikynima'n kykyaqil aj Israel!</para>
  <para style="p">
    <verse number="5" style="v" />Kyb'intzpe'ye': Kxel nchq'o'ne' nsanjelale' Eliy kyxole', na'mxtoq tpon kanun nq'ije' ayine' Dyos Manb'aj, nim toklenju' q'ij lu ex kuw. <verse number="6" style="v" />Ktb'incha' tu'n kyb'anixju' manb'aj kyuk'i'l k'walb'aj. Qatzun min, chin ule' ex ktzajel nq'o'ne' tz'e'ysb'il witzb'aj tib'aju' ttx'otx'a, majx kb'el nxitu'ne', chi Dyos.</para>
</usx>