<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="LAM" style="id">LAM.TXT Febrero 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Lamentaciones</para>
  <para style="toc3">Lm</para>
  <para style="toc2">Lm</para>
  <para style="toc1">Tu'jil Oq'e'n (Lamentaciones)</para>
  <para style="mt1">TU'JIL OQ'E'N</para>
  <para style="mt2">(Lamentaciones)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">A tb'i u'j lu Tu'jil Oq'e'n, tu'nju' oq'e'n b'aj ti'j Jerusalen tej tkub' xitj, jwe' b'itz te oq'e'n b'isb'ajilx nk'u'nku'x toj, tz'ib'a'n tu'n Jeremiy t-sanjelal Dyos, nyolin ti'ju' tkub' xitu'n Jerusalen ex tkyaj mixti'tl najli toj, tej kyb'ajx q'i'n aj Israel toj juntl tnam. Ojexi'x b'isun Jeremiy, ex eltni'k qa toj tu'me'lju' tz'e'ysb'il witzb'aj tzaj lu. Junjun b'itz toj junjun tnej. Tu'npetzu'n atzu' nyolina'xi'x ti'ju' oq'e'n, ex ikx nyolin ti'ju' q'uqb'ab'l k'u'jb'aj tu'n Qman Dyos ex ti'ju' b'a'n tzul yajxi'tl.</para>
  <chapter number="1" style="c" />
  <para style="ms">TNEJEL OQ'E'N (1.1-22)</para>
  <para style="q">
    <verse number="1" style="v" />¡Tjunalju' nintnam xkyajten,</para>
  <para style="q2">aj nimtoq xjal toj!</para>
  <para style="q">¡Matz'okju' tnejel nintnam kyxol tnam</para>
  <para style="q2">naku'j qya kyimni tchmil!</para>
  <para style="q">¡Jtz'o'nkju' t-xu'jil nimaqkawil kyoj kawb'il</para>
  <para style="q2">ti'j kuw aq'untl!</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Inxi'x kub' oq' toj qonik'an;</para>
  <para style="q2">inxi'x b'ilj ta'l twitz kykab'il plaj.</para>
  <para style="q">Mix-a'lo'x jun nq'uqb'ante tk'u'j</para>
  <para style="q2">kyxol kykyaqilju' tajpaj.</para>
  <para style="q">Kykyaqilju' tamiw ẍekub' sb'unte;</para>
  <para style="q2">ex mache ok te tajq'oj.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Ti'jxi'tlju' k'ixk'oj ex kuw aq'untl,</para>
  <para style="q2">nyajti Juda ja'lo toju' txi'wb'il.</para>
  <para style="q">Aju' ntoq kawin kyxol tnam ojtxi',</para>
  <para style="q2">atzu'n ja'lo mixti' ojlab'l te.</para>
  <para style="q">Makub'ti'j kyu'nju' ljoltoq toj tq'ij</para>
  <para style="q2">ex b'aj kytxoli'nti'j tu'n mitzaqpaja'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />¡B'isb'ajilx kyoju' tb'eyil Syon!</para>
  <para style="q2">¡Mix-a'lo'x jun tu'n tul toju' ninq'ij!</para>
  <para style="q">Kyajni leb'anju' tjpel nintnam,</para>
  <para style="q2">nche oq'ju' pale,</para>
  <para style="q">Inche b'isunju' txin</para>
  <para style="q2">atzu'n Jerusalen toj k'ixk'oj nnik'a'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Aye' tajq'oj nche kawin tib'aj</para>
  <para style="q2">ex xi'kyjaw q'inumax.</para>
  <para style="q">Matzaj tq'o'n Dyos tz'e'ysb'il kywitz</para>
  <para style="q2">tu'n tpaju' nim txqan kyil.</para>
  <para style="q">Mache b'ajxq'i'n kyk'wal toj juntl tx'otx'</para>
  <para style="q2">mache'x q'i'n kyu'n kyajq'oj.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Mab'ajkub'naj tkyaqil</para>
  <para style="q2">ju' tilb'ilal Syon tb'anil;</para>
  <para style="q">naku'j msatqe' kynejel,</para>
  <para style="q2">inik'tjoyli kywa kyu'n;</para>
  <para style="q">jk'u'n kyqan ljo'n kyb'e</para>
  <para style="q2">nejlqe' kywitzju' ub'alkye.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Intzaj tna'n Jerusalen tq'ijlalil ojtxi',</para>
  <para style="q2">tej tkyejten tjunal ex toj b'is;</para>
  <para style="q">ntzaj tna'n tkyaqilju' tq'inumal atitoq</para>
  <para style="q2">kyoju' tq'ijlalil ojtxi';</para>
  <para style="q">ntzaj tna'n tej tkub'ti'j tu'n tajq'oj</para>
  <para style="q2">ex mix-a'lo'x ul onilte,</para>
  <para style="q">e'xmayin tajq'oj ti'j</para>
  <para style="q2">tej tkub'ti'j kyu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Nimxi'x til Jerusalen xkub' tb'incha'n</para>
  <para style="q2">majx matz'el ik'o'n tu'n tpaj.</para>
  <para style="q">Matxi' tz'elkyik'o'nju' ntoq che niman te,</para>
  <para style="q2">qu'n matz'ok kyka'yi'n sel tch'ixaw.</para>
  <para style="q">Tu'ntzun tpaju' nnoq'a',</para>
  <para style="q2">ex matxi tmiltz'u'n twitz tu'n tch'ixaw.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Tz'ilju' t-xb'alun tu'n taq'wixil;</para>
  <para style="q2">min ximan ti'ju' tzul tz'aq tib'aj.</para>
  <para style="q">Mixti' tnab'en tej tkub' tz'aq;</para>
  <para style="q2">mix-a'lo'x jun q'uq'b'alte tk'u'j.</para>
  <para style="q">¡Nman Dyos, ka'yintza nk'ixk'oje</para>
  <para style="q2">exju' tninb'iltib' wajq'oje!</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Matxi' che kub'tetza'n ajq'oj</para>
  <para style="q2">q'inumal toj Jerusalen.</para>
  <para style="q">E'til nintnamju' k'lul witzleb'</para>
  <para style="q2">tej kyokx tzaqpaj toju' ja xjan,</para>
  <para style="q">¡aye' xjal tmaya, Nman Dyos,</para>
  <para style="q2">tu'n miche okxa' toju' ja te b'uyjtib'il!</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Kykyaqilju' najlqe' toj nche oq',</para>
  <para style="q2">nche elb'aj ti'j kywa;</para>
  <para style="q">xikyq'o'n kyq'inumal tet-xel kywa</para>
  <para style="q2">tu'n txkye kyanmi.</para>
  <para style="q">¡Ka'yintza, Nman Dyos, matx chin b'o'lje'!</para>
  <para style="q2">¡Ka'yintzpe'ya matxi'xi'x chin kub'me'ssa'ne'! chij.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />¡Aye'tzunkye' nche b'ete' toju' b'e,</para>
  <para style="q2">che tenku' jun kmuje' ximalte</para>
  <para style="q">qa ati juntl nik' ti'j kse'nwe',</para>
  <para style="q2">nxi'x chin kub' yajtiye' tu'n!</para>
  <para style="q">¡Matzaj tq'o'n Qman Dyos k'ixk'oj lu wi'je'</para>
  <para style="q2">tej saj ttx'u'jil!</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Matzajtq'on Qman Dyos jun q'aq' tzmajx toj kya'j</para>
  <para style="q2">majx ẍe tz'e'y nb'aqile' tu'n;</para>
  <para style="q">makub' tq'o'n jun xpatxab' toj nb'eye</para>
  <para style="q2">majx sanjtlwi'je' tu'n wi'jxi'ye';</para>
  <para style="q">majx ẍin kyej tleb'a'ne',</para>
  <para style="q2">toju' yajb'il atl junjun kmuj.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Matxi' che til Qam Dyos wile',</para>
  <para style="q2">machin kub' t-xwaku'ne' toj,</para>
  <para style="q">alqe' wib'aje' kse'n iqb'il ti'j tqul wakx</para>
  <para style="q2">¡majx nchin kub' numje' kyjaq'!</para>
  <para style="q">Ma chinx tq'one' Qman Dyos toj kyq'ob' xjal</para>
  <para style="q2">layx tzik'xtl wu'ne' ja'lo.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Najchaq ẍe'xa' tlaq'b'a'n Qman Dyos</para>
  <para style="q2">xjal kuw che q'ojin intoq chin kyklo'ne'.</para>
  <para style="q">Mache tzaj tchq'o'n xjal te q'oj wi'je,</para>
  <para style="q2">tu'n kykub' kyb'yo'n nxjale' kuwxi'x che q'ojin.</para>
  <para style="q">¡Matxi' kub' tpch'u'n Qman Dyos Juda ju' tmyal</para>
  <para style="q2">kse'n nkub' pch'u'n ub'a tu'n tel b'in ti'j!</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Inxi'x chin oq'e' tu'n tpaj ja'lu.</para>
  <para style="q2">Inxi'x el qojl ta'l nwitze',</para>
  <para style="q">mix-a'lo'x jun q'uqb'alte nk'u'je',</para>
  <para style="q2">mix-a'lo'x jun tu'n tul kuwsalte nk'u'je'.</para>
  <para style="q">Mache kyejten nk'wale' toj xitb'il,</para>
  <para style="q2">tu'n tpaj kuwqe'xi'xju' qajq'oje ex maqo kub'e' kyu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Nxitjqo'n Syon tq'ob' nxi'x kub'san kse'n jun qya kyimni tchmil,</para>
  <para style="q2">ex mix-a'lo'x nq'uqb'ante tk'u'j.</para>
  <para style="q">Matxi' tchaq' Qman Dyos</para>
  <para style="q2">tu'n toktxoli'n ti'j Jakob' kyu'n tajq'oj;</para>
  <para style="q">matxi' tz'ok Jerusalen kye</para>
  <para style="q2">naku'j tz'is ex tz'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />B'a'nte' xtb'incha Qman Dyos,</para>
  <para style="q2">qu'n machin okmiltz'uje' kyi'ju' tchaq'b'il.</para>
  <para style="q">¡Chin kyb'intze', kykyaqile' tnam;</para>
  <para style="q2">kyka'yinkye' nk'ixk'oje!</para>
  <para style="q">¡K'lo'nqe' nkuxune' ex nqpoje</para>
  <para style="q2">ẍeb'ajxq'i'n toj juntl tnam!</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Matxi' nqani'ne' o'nb'il kyeju' wajpaje',</para>
  <para style="q2">aye'tzunkye xi' ẍe okmiltz'uja' wi'je.</para>
  <para style="q">Mache kyimu' npaleye'</para>
  <para style="q2">exqe' ntijwnaqe' toju' nintnam:</para>
  <para style="q">¡intoq che joylaj ti'j kywa</para>
  <para style="q2">tu'n t-xkye ch'i'n kyanmi!</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />¡Nman Dyos, ka'yintzju'ya nb'ise'!</para>
  <para style="q2">¡Inxi'x julky'aj toj nk'u'je'!</para>
  <para style="q">Qtanun wanmiye' tu'n k'ixk'oj</para>
  <para style="q2">ajtkub' nxima'ne' nb'inchb'ene' toj pi'sal.</para>
  <para style="q">Toj b'e nche b'yonjtza' nk'wale',</para>
  <para style="q2">ex ati kamik tzalu toju' tnam.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Inkyb'i'nkye xjal nchin oq'e',</para>
  <para style="q2">ex mix-a'lo'x jun nq'uqb'qnte nk'u'je'.</para>
  <para style="q">kykyaqil wajq'oje ojtzqilte titi' xb'ajweye',</para>
  <para style="q2">ex nche tzalaj tu'n xtb'inchaya weye' iku'.</para>
  <para style="q">¡B'inchama tu'n tjapunju' tq'ijlalil q'mantl tu'na,</para>
  <para style="q2">ex tu'n tik' kyi'j kse'nwe' nchinik'a'!</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Japunxwitju' kyil twitza</para>
  <para style="q2">tkyaqilju' xkyb'incha;</para>
  <para style="q">b'inchama kye tu'n tpaj kyil</para>
  <para style="q2">kse'nxju' xtb'inchaya weye',</para>
  <para style="q">qu'n inxi'x chin oq'e' nim;</para>
  <para style="q2">¡Matx kub'aj wanmiye'!</para>
  <chapter number="2" style="c" />
  <para style="ms">TKAB' OQ'E'N (2.1-22)</para>
  <para style="q">
    <verse number="1" style="v" />¡Nimxi'xte' ttx'u'jil Qman Dyos,</para>
  <para style="q2">majx xkub' qyupe' tb'anil Syon tu'n!</para>
  <para style="q">Matz'el t-xitu'n tilb'il Israel tb'anilxi'x,</para>
  <para style="q2">saj t-xon twitz kya'j tzmax twitz tx'otx';</para>
  <para style="q">miẍpeti' sajtna'ntlju' tkub'el tqan</para>
  <para style="q2">tej saj ttx'u'jil.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Kykyaqilxju' tja Jakob'</para>
  <para style="q2">ẍeb'ajkub' t-xitu'n Qman Dyos;</para>
  <para style="q">toj jun kmujx saj ttx'u'jil xkub' t-xitu'n</para>
  <para style="q2">tipumal Juda tb'anilxi'x tmyal;</para>
  <para style="q">Mache kutmessa'n ninkawb'il exqe' nimaq kyoklen kawil</para>
  <para style="q2">majx ẍekub' ch'ixwi tu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Tej ttzaj tx'u'jil, kub' tnajsa'n</para>
  <para style="q2">tkyaqil kyipumal aj Israel.</para>
  <para style="q">Min taq'tl tq'ob' te ipumalj qeye'</para>
  <para style="q2">tej qokwe'ye' kywitz qajq'oje;</para>
  <para style="q">¡tzaj tq'o'n jun q'aq' tib'aj Jakob'</para>
  <para style="q2">nkub' ttz'e'ysa'n tkyaqil matzel yal twitz!</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Naku'j jun ajq'oju' Qman Dyos,</para>
  <para style="q2">xitqinu'n t-smaj, xitb'incha'n tten tq'ob';</para>
  <para style="q">ikxi'x kse'n jun ajq'oj,</para>
  <para style="q2">b'ajkub' t-xitu'nju' tb'anilxi'xtoq;</para>
  <para style="q">tzaj ttzaqpi'n ttx'u'jil, naku'j q'aq',</para>
  <para style="q2">tib'aju' t-xmuj Syonju' tmyal.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Tb'incha Qman Dyos kse'n jun ajq'oj;</para>
  <para style="q">majx ekub't-xitu'n aj Israel;</para>
  <para style="q">e'kub' t-xitu'n kykyaqilju' tja nimaqkawb'il,</para>
  <para style="q2">e'kub' t-xitu'n kyja xq'uqil nimaq kywe',</para>
  <para style="q">makyej tq'o'n Juda tb'anil tmyal</para>
  <para style="q2">toj b'is ex oq'el.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />B'iyon toju' tja xjan kse'n jun eleq';</para>
  <para style="q2">kub' t-xitu'n ja noka' b'uyjtib'il.</para>
  <para style="q">Tb'incha Qman Dyos tu'n tik'kyna'l ninq'ij</para>
  <para style="q2">exqe' q'ij te ojlab'l toj Syon.</para>
  <para style="q">E'elt-suchu'n nimaqkawil ex pale</para>
  <para style="q2">tu'n tkyaqil ttx'u'jil.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Matz'el tik'o'n Qman Dyos qolb'eb'l te,</para>
  <para style="q2">matz'el tik'o'nju' tja xjan;</para>
  <para style="q">matxi tq'o'n nimaqtapi kolb'ilte ti'ju' nintnam</para>
  <para style="q2">toj kyq'ob'ju' ajq'oj.</para>
  <para style="q">¡Inxi'x jaw tq'ojq'ojel wi'yj toj tja Dyos,</para>
  <para style="q2">kuxi'xtej jun ninq'ij!</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Kub't-xitu'n Qman Dyos</para>
  <para style="q2">nintapi ti'jile Syon tb'anilxi'x tmyal.</para>
  <para style="q">B'ajkub' t-xima'n tu'n tkub' t-xitu'n</para>
  <para style="q2">ex min sojlan ti'j, ma japun tu'n.</para>
  <para style="q">B'is ẍekyaja' tapi ex nimaqtapi tu'n,</para>
  <para style="q2">matxi' che b'aj kub'niq'j.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Mixti'tl tjpel nintnam ex mixti'tl jupb'ilte:</para>
  <para style="q2">¡toqniqe'tl ex pak'a'jqe' twitz tx'otx'!</para>
  <para style="q">Ati tnimaqkawil exqe' tkawil kyxol witzleb'il;</para>
  <para style="q2">mixti'tlte tkawb'il Dyos kye;</para>
  <para style="q">¡mixpeti'tlte yek'b'il mo witzik' tu'n Dyos</para>
  <para style="q2">kyeju' kysanjelal!</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Nche kub' qe tijwnaq twitz tx'otx'</para>
  <para style="q2">mixti'x nche yukchi toju' Syon tb'anil txin,</para>
  <para style="q">njax kyq'o'n quq toj kywi'</para>
  <para style="q2">ex nok kyq'o'n kyi'j jochon.</para>
  <para style="q">Tzipli qe'ju' q'poj aj Jerusalen</para>
  <para style="q2">tzmaxtzu' twitz tx'otx'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Mache kub'aj nwitze' tu'n oq'el</para>
  <para style="q2">naku'xi'xtej k'elitz laqj wanmiye';</para>
  <para style="q">matxi' chin kub' numje'</para>
  <para style="q2">tu'n tpaj xitjnitl ninkytanam nxjalile',</para>
  <para style="q">tej ẍe'xnka'yi'ne' neẍ inx che ch'u'n</para>
  <para style="q2">expe' nche kyim tu'n we'yaj kyoj b'e.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Intoq xikyma'n k'wal te kytxu kjalu:</para>
  <para style="q2">¡Mixti'tl qwaye' ex qk'wa'ye'! chechij,</para>
  <para style="q">Nche kub' tz'aqtzuntz naku'j nche kub' b'yo'n</para>
  <para style="q2">kyoj b'e toju' nintnam,</para>
  <para style="q">toj kyq'ob'u kytxu</para>
  <para style="q2">ne'la' kyxew.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¿Alxwit quk'i'l jaku' tz'oka' nq'o'ne'</para>
  <para style="q2">qa ikyju'ya Jerusalen tb'anilxi'xa?</para>
  <para style="q">¿Titi' jun techlal jaku' kub' nq'o'ne' q'uqb'ab'l tk'u'ja,</para>
  <para style="q2">aku'xi'xa tb'anil nintnam Syon?</para>
  <para style="q">Nimxi'xte' xitb'il ti'ja naku'j ninnjab';</para>
  <para style="q2">¿Alxi'xkye kq'analteya?</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Naqx sb'ub'lqekye' yek'b'il mo witzik'</para>
  <para style="q2">matxi' b'aj kyma'n t-sanjelala teya.</para>
  <para style="q">Min xkub' kychik'b'a'n tila</para>
  <para style="q2">tu'n tch'exb'etju' tchwinqlala;</para>
  <para style="q">kyma witzik' mo yek'b'il te sb'ub'l teya,</para>
  <para style="q2">ex mab'ajx toksla'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Ajt-xika'yi'na kyu'n nche b'et toj b'e</para>
  <para style="q2">nkypoq'cha'n toj kyq'ob' xmayb'il teya;</para>
  <para style="q">nche ẍut'in ex nkyukcha'n kywi',</para>
  <para style="q2">inkyma'n ti'ju' tb'anil txin Jerusalen:</para>
  <para style="q2">¿Ma atzun nintnam ja'lu intoq q'manjtz</para>
  <para style="q">qa tb'anilxi'x toj tkyaqil twitz tx'otx'? chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Kykyaqilju' tajq'oja</para>
  <para style="q2">nche b'ajk'ab'j ti'ja.</para>
  <para style="q">Nche ẍut'inxi' ex nkyokcha'n kywitz, nkyma'n kjalu:</para>
  <para style="q2">Majx matxi' kub'olj qu'ne'.</para>
  <para style="q">Matxi'pe'tzun japun toj tq'ij ja'lo;</para>
  <para style="q2">¡ma'x qka'yi kse'ntoq kpomela' b'aj! chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Majapunte Qman Dyos t-xim,</para>
  <para style="q2">ex ma japunju' tyol.</para>
  <para style="q">Mixti'x tzajlaq'jtk'u'j tej tkub' t-xitu'nju</para>
  <para style="q2">ojetoq kub' t-xima'n tu'n t-xitet,</para>
  <para style="q">taq' anb'il tu'n kytze'n ajq'oj ti'ja</para>
  <para style="q2">mache jawtlaq'b'a'n ajq'oj tu'n ẍekanb'an.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />¡Qaninx o'nb'ila te Qman Dyos,</para>
  <para style="q2">aya tb'anil nintnam Syon!</para>
  <para style="q">¡Qojexwit ta'l twitza</para>
  <para style="q2">q'ijtl ex qonik'an!</para>
  <para style="q">¡Lalunx qjena tu'n toq'a,</para>
  <para style="q2">lalun che ojlanju' twitza!</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />We'ktza qonik'an,</para>
  <para style="q2">ẍch'ina tkyaqil kmoj;</para>
  <para style="q">qonku'ya tanmiya twitz Qman Dyos,</para>
  <para style="q2">qojlku'j naku'j a' nb'et;</para>
  <para style="q">q'onqe'ktz tq'ob'a ex kub'sana te,</para>
  <para style="q2">ex na'n Dyosa kyi'ju' tala,</para>
  <para style="q">nche kyim kyoj xky'ichb'e</para>
  <para style="q2">toju' tnam tu'n we'yaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Ximankupe'ya Nman Dyos</para>
  <para style="q2">mix-a'lo'xte jun oje tb'inchaya ikju'.</para>
  <para style="q">¿Ma oktzun xe'l kych'yo'n txub'aj</para>
  <para style="q2">kyne'ẍ inx che ch'u'n?</para>
  <para style="q">¿Ma atitzun tu'n kykub' b'yo'n</para>
  <para style="q2">pale exqe' sanjelal toju' tjaya xjan?</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />Woqliqe' ku'xun ex tijwnaq</para>
  <para style="q2">kyoju' b'e toj tnam;</para>
  <para style="q">eb'ajkub' b'yo'n nku'xune ex nqpoje</para>
  <para style="q2">tu'n k'uẍtx'e'nb'il.</para>
  <para style="q">E'tk'ixb'saya b'a'nxi'x tej ttzaj ttx'u'jila,</para>
  <para style="q2">¡Mixti'x tzajlaqtk'u'ja tej kykub'tb'iyo'na!</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Mache tzaj tb'u'yi'na xob'el toj tkyaqil plaj,</para>
  <para style="q2">naku'xi'xtej toj jun ninq'ij ẍeb'ju'la;</para>
  <para style="q">mix-a'lo'x jun tzaqpaj toj tq'ob'a</para>
  <para style="q2">tej ttzaj ttx'u'jila, Nman Dyos.</para>
  <para style="q">E'b'aj kub' kyb'yo'n ajq'oju'</para>
  <para style="q2">e'nch'isa'ye' ex e'nxnaq'tza'ye'.</para>
  <chapter number="3" style="c" />
  <para style="ms">TOXI'N OQ'E'N (3.1-66)</para>
  <para style="q">
    <verse number="1" style="v" />Ayinweju'ye' matxi' tzik'nwitz toju' yajb'il</para>
  <para style="q2">tjaq' tkyaqilju' ttx'u'jil Qman Dyos.</para>
  <para style="q">
    <verse number="2" style="v" />Machin iq'injeye' tu'n toj qloj,</para>
  <para style="q2">machin b'ete' tu'n kyoj b'e qlolj kyoj;</para>
  <para style="q">
    <verse number="3" style="v" />atl junjun kmuj ex junjun q'ij,</para>
  <para style="q2">nokmeltz'ujxi'xju' tq'ob' wi'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Makub' tijin nchib'jile' ex ntz'umile' tu'n,</para>
  <para style="q2">mache kub' ttoqi'n nb'aqile';</para>
  <para style="q">
    <verse number="5" style="v" />mab'aj kyjpu'n wijileye'</para>
  <para style="q2">tu'n k'ixk'oj ex yajb'il;</para>
  <para style="q">
    <verse number="6" style="v" />machin kub'tq'one' tu'n wanq'ine',</para>
  <para style="q2">toj qlolj kse'nqe' ojtxi' kykyimlen.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Mab'aj tjpu'n wi'jileye', mixti'l welixe';</para>
  <para style="q2">machin kub'tjtz'one' kyu'n txqan xpatx'k'uxb'il;</para>
  <para style="q">
    <verse number="8" style="v" />maskyepe' nẍch'ine' tu'n tonin wi'je',</para>
  <para style="q2">kub' tchkyinsa'ntib' weye';</para>
  <para style="q">
    <verse number="9" style="v" />kub'tmq'o'n nb'eye' kyu'n ab'j b'jaw tnk'u'n,</para>
  <para style="q">¡ttch'exb'e tu'me'l nb'eye'!</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Ikymatxi' tz'oka' weye' kse'n jun b'alun jutzlokx toj k'ul,</para>
  <para style="q2">kse'n jun oso naqx tu'n ttzajlipan wi'je'.</para>
  <para style="q">
    <verse number="11" style="v" />Machian nel ttxalpu'ne' toj nb'eye', machin b'ajtk'ixb'sa'ne',</para>
  <para style="q2">¡matz'ok tq'o'n nim xob'il wi'je'!</para>
  <para style="q">
    <verse number="12" style="v" />¡Matxitqinu'n t-smaj</para>
  <para style="q2">ex machin tzajtnik'u'ne'!</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />Majx ex xopq'iju' wanmiye'</para>
  <para style="q2">tu'n talt-smaj Qman Dyos.</para>
  <para style="q">
    <verse number="14" style="v" />Kykyaqil nxjalile' nche xmayin wi'je';</para>
  <para style="q2">majx atinqine' twi' kyaq' tkyaqil kmoj.</para>
  <para style="q">
    <verse number="15" style="v" />Nim k'ixk'oj saj tq'o'n Dyos weye';</para>
  <para style="q2">k'aju' k'wab'j saj tq'o'n weye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Mache b'je'tz nq'uchi'ne' nwisteye ti'j ab'j;</para>
  <para style="q2">mab'aj nxtoli'n wib'e' toj quq.</para>
  <para style="q">
    <verse number="17" style="v" />Mixti'tl nak'b'il weye' ja'lo</para>
  <para style="q2">ex matzik'tna'lju' tzalajb'il wu'ne'.</para>
  <para style="q">
    <verse number="18" style="v" />Expe' kub' nxima'ne' qa ojetoq tzpetju'</para>
  <para style="q2">q'uq'b'ab'l nk'u'je' ti'j Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Ntzaj nna'ne' b'is nik'a'ye' tej njunale',</para>
  <para style="q2">toju' k'ixk'oj ex yajb'il nnik'a'ye';</para>
  <para style="q">
    <verse number="20" style="v" />nchin kub' tene' ximal ti'j tkyaqil ja'lu</para>
  <para style="q2">ex majx nkub'aj wipumale'.</para>
  <para style="q">
    <verse number="21" style="v" />Atitzun jun ti'xti' majx ntzaj nna'ne'</para>
  <para style="q2">ex tu'n tokqe nk'u'je' ti'j:</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Mixti'te b'ajsb'il teju' tk'u'jlalil Dyos,</para>
  <para style="q2">ex kukx tten t-xtalb'ilju'.</para>
  <para style="q">
    <verse number="23" style="v" />Ak'a'jchaq atl junjun prim;</para>
  <para style="q2">¡inxi'x che japunju' tyol!</para>
  <para style="q">
    <verse number="24" style="v" />Ex inma'ne' toj wanmiye': ¡Ate Qman Dyos tkyaqil weye';</para>
  <para style="q2">qu'mtzun q'uliwe' nk'u'j ti'j!</para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" />B'a'nte Qman Dyos kyeju' q'uqlok kyk'u'j ti'j,</para>
  <para style="q2">kyeju' nche jyon ti'j.</para>
  <para style="q">
    <verse number="26" style="v" />Ate b'a'nju' tu'n qayon</para>
  <para style="q2">ti'ju' to'nb'il Qman Dyos.</para>
  <para style="q">
    <verse number="27" style="v" />A b'a'nju' qama t-xitb'i'n xjal tzak'b'il</para>
  <para style="q2">tzajx toj tku'xumal.</para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" />Ati tu'n tkyajtenju' xjal tjunal ex k'otzli</para>
  <para style="q2">ajttzak'unjtz tu'n Qman Dyos;</para>
  <para style="q">
    <verse number="29" style="v" />ati tu'n tkub'tma'tzi'n twitz tx'otx',</para>
  <para style="q2">qu'n jaku' atix q'uq'b'ab'l k'u'jb'aj te;</para>
  <para style="q">
    <verse number="30" style="v" />kxe'l tq'o'n poq'cha' ttx'u'k twitz qa ati xb'ujun te,</para>
  <para style="q2">ex tu'n tb'aj yasu'n b'a'nxi'x.</para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" />Lay qokyaj tleb'a'nte Qman Dyos tejumajx.</para>
  <para style="q">
    <verse number="32" style="v" />B'a'nqa maqo kub' tyaju'n, inx tzaj q'aq'an tk'u'j,</para>
  <para style="q2">qu'n nimxi'xte tk'u'jlalil.</para>
  <para style="q">
    <verse number="33" style="v" />Axxi'x min nkub' toj twitz tu'n ttzaj tq'o'n b'is</para>
  <para style="q2">mujqa tu'n toktq'o'n k'ixk'oj kyi'j xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" />Qama che kub' wab'e'n jpu'nqe' toj tnam</para>
  <para style="q2">ex mixti'x tlaqb'il kyk'u'jlalil,</para>
  <para style="q">
    <verse number="35" style="v" />qa min xnimanjtzju' toklen jun xjal</para>
  <para style="q2">twitzku' Qman Dyos,</para>
  <para style="q">
    <verse number="36" style="v" />qa min xb'inchanjtz tnik'alilti'j toj jun ttxolil kawb'ill,</para>
  <para style="q2">tkyaqil ja'lu ik'o'nqe' tu'n Qman Dyos.</para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" />Qa ati nyolinjtz, mujqa ati xb'aji,</para>
  <para style="q2">aku'te Qman Dyos xq'mante.</para>
  <para style="q">
    <verse number="38" style="v" />Qama tzaju' b'a'n mujqa taq'wix</para>
  <para style="q2">ate Qman Dyos inq'mante tu'n tzaj.</para>
  <para style="q">
    <verse number="39" style="v" />Aj il na'te' xjal twitzju' tx'otx' lu</para>
  <para style="q2">¿Tiqu'ntzun ntx'eqneya'tz tu'n tzak'b'il?</para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" />Qo ximan b'a'nxi'x ti'ju' qkchwinqlal;</para>
  <para style="q2">ex kutanjtz ti'j qanmi te Qman Dyos.</para>
  <para style="q">
    <verse number="41" style="v" />Qq'onx qanmi ex qo na'n Dyos</para>
  <para style="q2">te Qman Dyos te toj kya'j.</para>
  <para style="q">
    <verse number="42" style="v" />Maqo' b'inchan ile' ex maqo elpi'se';</para>
  <para style="q2">ex min xkub' tnajsa'na qile'.</para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" />Mab'aj ttxoli'na qi'je' tu'n ttx'u'jila, ex makub'tljo'na toj qq'ije',</para>
  <para style="q2">¡mixti'x q'aq'an tk'u'ja tej qkub' tb'iyo'na!</para>
  <para style="q">
    <verse number="44" style="v" />Okx tewa'ntib'a toj jun muj</para>
  <para style="q2">tu'n mitzaja' tb'i'na qkub'sb'ile'.</para>
  <para style="q">
    <verse number="45" style="v" />Ikymatxi' qo oka'ju'ye teya kse'n tz'is</para>
  <para style="q2">kywitz kykyaqil xjal.</para>
  <para style="b" />
  <para style="q">
    <verse number="46" style="v" />Matxi'xi'x qo okye'</para>
  <para style="q2">te kyxmayb'ilju' qajq'oje;</para>
  <para style="q">
    <verse number="47" style="v" />¡maqo okye' toj ex nqo ik'e' ja'lo</para>
  <para style="q2">toj xob'il, xpatxab' ex xitb'il!</para>
  <para style="q">
    <verse number="48" style="v" />Inxi'x che qojli ta'l nwitze'</para>
  <para style="q2">tu'nju' xitb'il saj ti'ju' ntaname'.</para>
  <para style="b" />
  <para style="q">
    <verse number="49" style="v" />Min nche ojlan nwitze' tu'n woq'b'ene',</para>
  <para style="q2">ex layx qe nk'u'je'</para>
  <para style="q">
    <verse number="50" style="v" />tzmaxi'j ajqtzaj b'i'n</para>
  <para style="q2">tu'n Qman Dyos toj kya'j.</para>
  <para style="q">
    <verse number="51" style="v" />Nche ch'yon nwitze' ex majx npon ti'j wanmiye',</para>
  <para style="q2">tu'nju' ẍe ik'a' tmyal ntaname'.</para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" />Ma chintzaj kyub'a'ne' wajq'oje naku'j pich'</para>
  <para style="q2">extzun mixti' wile' kye;</para>
  <para style="q">
    <verse number="53" style="v" />Inku'x kyq'o'ne' itz'qinxe' toj jun xoch</para>
  <para style="q2">ex kub' kyjpu'n ttzi tu'n jun ab'j.</para>
  <para style="q">
    <verse number="54" style="v" />Majx nxi'mulq'ije' tjaq' a',</para>
  <para style="q2">ex kub' nxima'ne': Matxi'tzun chin b'aje', nchije'.</para>
  <para style="b" />
  <para style="q">
    <verse number="55" style="v" />Intzaj nna'ne' tb'iya, Nman Dyos</para>
  <para style="q2">tzmajxtzu' t-xe a':</para>
  <para style="q">
    <verse number="56" style="v" />ina' tzajtb'i'nteya tq'ojq'ojel nwi'ye';</para>
  <para style="q2">lalun tz'elt-suchu'na nkub'sb'ile'.</para>
  <para style="q">
    <verse number="57" style="v" />Ina' ul lq'eya nk'etze' ajttzaj ntxko'na</para>
  <para style="q2">ex ntzaj tma'na weye': Lalun xob'a.</para>
  <para style="b" />
  <para style="q">
    <verse number="58" style="v" />Nman Dyos, inchin tklo'nta toju' yajb'ilweye'</para>
  <para style="q2">ex intklo'na nchwinqlale'.</para>
  <para style="q">
    <verse number="59" style="v" />Nman Dyos, intka'yi'na jitz'b'il weye',</para>
  <para style="q2">¡b'inchama tnik'alilti'j weye'!</para>
  <para style="q">
    <verse number="60" style="v" />Tojtzqi'nta kyajb'il tu'n nb'o'lje' kyu'n</para>
  <para style="q2">ex tkyaqilju' kyxim b'incha'n wi'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="61" style="v" />Nman Dyos, b'intzju'ya ajkyok tzaqpaj</para>
  <para style="q2">ex tkyaqilju' kyxim wi'je';</para>
  <para style="q">
    <verse number="62" style="v" />e'txqan kyolju' wajq'oje,</para>
  <para style="q2">tkyaqil kmuj nche yolin myab'a'n wi'je';</para>
  <para style="q">
    <verse number="63" style="v" />¡Ka'yintza tkyaqilju' nkyb'incha'n</para>
  <para style="q2">majx intinkye' te kyxmayb'il!</para>
  <para style="b" />
  <para style="q">
    <verse number="64" style="v" />Nman Dyos, tz'e'ysanku'ya kywitz,</para>
  <para style="q2">kse'nxju' kyb'inchb'aj,</para>
  <para style="q">
    <verse number="65" style="v" />Ch'uẍsanku'ya kynab'l,</para>
  <para style="q2">ex q'ontzju'ya taq'wix txko'ntl kyb'aj.</para>
  <para style="q">
    <verse number="66" style="v" />Nman Dyos, xla'janqe'ma toj ttx'u'jila,</para>
  <para style="q2">¡najsanqeku'ya twitzu' tx'otx' lu!</para>
  <chapter number="4" style="c" />
  <para style="ms">TKYAJI'N OQ'E'N (4.1-22)</para>
  <para style="q">
    <verse number="1" style="v" />¡Matxi' kub'sju'kixju' q'anpwaq!</para>
  <para style="q2">¡Min nqoptz'atlju' tb'anil q'anpwaq!</para>
  <para style="q">¡Jaxja pak'a'jqe'tl tab'jilju' ja xjan</para>
  <para style="q2">kyojile xky'ichb'e!</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Aye'kyej aj Syon, kye kyilwi',</para>
  <para style="q2">ikytoq kyoklenju' kse'n q'anpwaq,</para>
  <para style="q">atzu'n ja'lo nche senjtz kse'n tx'otx' k'wil</para>
  <para style="q2">jun xjalxi' b'inchalkye.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />In pena' xikyq'o'n ttxu ẍal kyimi'ẍ</para>
  <para style="q2">tu'n kych'u'n kyal,</para>
  <para style="q">atzunte' ntaname' matxi' tz'ok tx'u'j</para>
  <para style="q2">naku'j pich' ab'estrus tb'i toj chq'ajlaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Inche k'wajti tal ne'ẍ</para>
  <para style="q2">nok lak'e kyaq' toj kyk'o'n.</para>
  <para style="q2">Nkyqani'n tal k'wal kywa,</para>
  <para style="q2">ex mix-a'lo'x jun nxiq'onte kywa.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Aye'kyej inxi'xtoq che wan b'a'nxi'x nej</para>
  <para style="q2">nche woqojla tu'n we'yaj kyoj b'e ja'lo.</para>
  <para style="q">Aye'kyej ẍeb'ajch'iy toj q'inumal,</para>
  <para style="q2">inche anq'in toj tkb'el tz'is ja'lo.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Nimxi'xte' tilju' ntaname'</para>
  <para style="q2">kyetwitzju' til Sodom,</para>
  <para style="q">aj mix-a'lo'te q'ojin ti'j</para>
  <para style="q2">tej tkub' xitu'n toj jun kmujx.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />Saq qexi'xju' t-xjal sk'o'nqe' twitz txun che'w</para>
  <para style="q2">saq qexi'x twitz ta'l mi'ẍj;</para>
  <para style="q">kyaqxi'x ka'yin kyxmilal kyetwitz tal ab'j koral;</para>
  <para style="q2">tb'anil ka'yin naku'j ab'j sapiro.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Atzu'n ja'lo qxopinxi'x che ka'yin twitz qlolj;</para>
  <para style="q2">mix-a'lo'x jun jaku' tz'el tnik' kye toj b'e.</para>
  <para style="q">Nnoktzqij kytz'umal ti'j kyb'aqil,</para>
  <para style="q2">¡Matxi' tz'oktzqij naku'j si!</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Axte b'a'n kse'nqe' ẍe kyim toj q'oj</para>
  <para style="q2">kyekywitz ẍe b'aj kyim tu'n we'yaj,</para>
  <para style="q">qu'n ch'i'naq kykyim</para>
  <para style="q2">tu'n tpaj min xknetl kywa.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Tu'nku' kyq'ob'ju' txub'aj b'a'nxjalqe'</para>
  <para style="q2">eb'ajku'x kytzq'ajsa'n kyal;</para>
  <para style="q">ayexju' kyej eb'ajx kychy'o'n</para>
  <para style="q2">tej tkub' xitu'n tanmi ntaname'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Elb'aj tq'oj Qman Dyos,</para>
  <para style="q2">ojexi'x q'ojin tu'n ttx'u'jil;</para>
  <para style="q">oktq'o'n tq'aq'al Syon</para>
  <para style="q2">expe' majx kub't-xitu'n tq'uqlil.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Mixti'x xikyoksla'n nimaqkawil,</para>
  <para style="q2">intoq che kawin toj tkyaqil twitz tx'otx',</para>
  <para style="q">qa jaku'toq tz'okxju' ajq'oj,</para>
  <para style="q2">kyoju' ttzi Jerusalen.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¡Tkyaqil ja'lu tu'n tpaj kyilju' kysanjelal,</para>
  <para style="q2">ex tu'n tpaj kyilju' kypale,</para>
  <para style="q">tojxpe'ju' nintnam</para>
  <para style="q2">b'aj qojli kychk'elju' mixti' kyil kyu'n!</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Inche takajla ajkyb'et toju' nintnam</para>
  <para style="q2">naku'j mo'ẍqe'.</para>
  <para style="q">b'ajniqe' tx'a'j toj chik'</para>
  <para style="q2">mix-a'lo'x jun noktzyunte kyxb'alun.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Nxi'x jawkyẍch'i'n witzleb'il kjalu:</para>
  <para style="q">¡che lq'emile', che lq'emile',</para>
  <para style="q2">tz'il qekye' xjal lu, lan che okkytzyu'ne'!</para>
  <para style="q">Naq nche b'etenje kye'lu b'je'xniqe' oq,</para>
  <para style="q2">lay b'ent kyanq'in tzalu, chechij.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Twitzku' Qman Dyos ẍe'xa' slamja',</para>
  <para style="q2">ex min ẍetzaj tka'yi'ntl.</para>
  <para style="q">Min exi' oksla'n pale</para>
  <para style="q2">ex min tzaj q'aq'an kyk'u'jlalilju' tijwnaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Intoq che ch'yon qwitze', ex inxtoq qo ka'ylaje',</para>
  <para style="q2">tu'n qtzaj onine', mixti'xte'.</para>
  <para style="q">Intoq qo ayone' tu'n tul jun tnam</para>
  <para style="q2">ju' layxtoq b'ent tkolon qi'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Xq'uqi'n qo'ye' kyu'n jamaqo'xa'ye';</para>
  <para style="q2">layx b'ent qexe' toj b'e.</para>
  <para style="q">Naq ch'i'ntl to'ka'ye', matxi' qoq'naxe';</para>
  <para style="q2">¡matxi' japun toj qq'ije'!</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Ojqelxi'x kyelju' ljolte toj qa'ije'</para>
  <para style="q2">kyekywitz q'anjel twitz kya'j;</para>
  <para style="q">xla'ja'nqo'ye' kyu'n kyoj k'ul,</para>
  <para style="q2">¡nkub' kyq'o'n xpatxab' qeye' toj chq'ajlaj!</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Matxiq'i'n sk'o'n tu'n Dyos tojapub'l,</para>
  <para style="q2">jaq'uqla'toq qk'u'j,</para>
  <para style="q">aj nimaqkawil intoq qma'n ti'j:</para>
  <para style="q2">Tjaq' t-xlekumal qo anq'ila' kyxol tnam, qochij.</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />¡Tze'na ex tzalajxa, nintnam Edom;</para>
  <para style="q2">aya nkawina toj tx'otx' Us!</para>
  <para style="q">¡Ex kpomelju' k'wab'j k'a teya,</para>
  <para style="q2">ktx'u'jtela b'a'nxi'x tu'n ex ksanajlab'ila!</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Matxi' pon b'aju' tz'e'ysb'il twitza nintnam Syon;</para>
  <para style="q2">lay tz'exq'i'ntla toj juntl tx'otx' tu'n Dyos.</para>
  <para style="q">Atzunta Edom, kb'el ttz'e'ysa'n twitza,</para>
  <para style="q2">ex che b'eltyek'u'nju' tila.</para>
  <chapter number="5" style="c" />
  <para style="ms">TJWE'YI'N OQ'E'N (5.1-22)</para>
  <para style="q">
    <verse number="1" style="v" />Na'ntzju'ya xqo ik'a'ye', Nman Dyos;</para>
  <para style="q2">Qotka'yintza, se'n nqo oka' ik'le'na'ye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Tkyaqilju' qetoqe' matxi' kub'kyetza'n najchaq xjal,</para>
  <para style="q2">kyetl junxi'tl xjalqe' qjaye' ja'lo.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Mixti'tl qmane', meb'aqo'ye';</para>
  <para style="q2">matxi' che kyaju' qtxuye' kyimni kychmil.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />¡Axju' qaye' ati tu'n qlq'onteye';</para>
  <para style="q2">ex axju' qsiye' ati tu'n qchjonteye'!</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Matxi' kub' qo'n jun iqtz ti'j qqule';</para>
  <para style="q2">inxi'x qo siktiye' ex minqo ojlane' kyu'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Naqx tu'n tpaj qwaye', nxi'x qo ajb'ene'</para>
  <para style="q2">kye aj Ejipt ex aj Asirya.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />E'b'inchan ilju' ojtxi' qchmane', ex oje che b'jik',</para>
  <para style="q2">ayo'ltzunqe' nqo chjonte kyb'inchb'aj.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Aye'tlju' lq'o'n majin nche kawin qib'aje' ja'lo,</para>
  <para style="q2">ex mix-a'lo'x jun tzaqpilqeye' toj kyq'ob'.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Majx oyi'n qchwinqlale' naqx tu'n tjyet qwaye'.</para>
  <para style="q2">extzun ate'qe' q'ojil toj chq'ajlaj.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />In q'aq'lix qchib'jile' kse'n chuj te wab'j;</para>
  <para style="q2">tu'n tkyqalju' we'yaj qi'je'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Eb'ajkub' yaju'n qya exqe' tal txin,</para>
  <para style="q2">toj Syon ex kyoju' nintnam toj Juda.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Eb'jaw tunb'a'n kyq'ob'ju' qnejenele',</para>
  <para style="q2">min e'nimanjtzju' tijwnaq.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />E'okq'o'n ichan atixi'x kyipumal chel;</para>
  <para style="q2">aye'tzu'n ku'xun e'kub' yajti tjaq' si.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Mixti'qe'tl tijwnaq ttzi nintnam;</para>
  <para style="q2">min nche b'itzantl ku'xun.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Mixti'tl tzalajb'il toj qanmiye';</para>
  <para style="q2">toj b'is xpon b'aja' qb'ixa'ne' te tzalajb'il.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Eltz'aqju' qkorone' toj qwi'ye'</para>
  <para style="q2">¡xpelo ta'qo'ye', ob'inchan ile'!</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />T'untpajtzu'n lu soka' tyab' qanmiye';</para>
  <para style="q2">ex nok muj kyi'j qwitze'.</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Naq tik'lentlte' twitz Syon xkyej;</para>
  <para style="q2">inxi'x che ẍchun chuẍ toj.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Atzunta, Nman Dyos, inkawina kukxju';</para>
  <para style="q2">¡kukx ttenju'ya toj tq'uq'b'ila!</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />¿Tiqu'ntzun k'ik'ela' qna'le' tu'na tejumajx?</para>
  <para style="q2">¿Titiqu'n qokjel tkolb'i'na nimtoj?</para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" />¡Anjsanma qi'je', Nman Dyos, ex k'anjelqe' qi'j tuk'i'la!</para>
  <para style="q2">¡B'inchama tu'n qanq'intle' kse'nx nejtl!</para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" />Nimxi'x ttx'u'jila saj qi'je';</para>
  <para style="q2">majx xqo' eltik'o'na.</para>
</usx>