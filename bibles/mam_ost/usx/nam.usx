<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="NAM" style="id">NAM.TXT Maezo 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Nahúm</para>
  <para style="toc3">Nah</para>
  <para style="toc2">Nah</para>
  <para style="toc1">Tuj Nawum (Nahúm)</para>
  <para style="mt1">TUJ NAWUM</para>
  <para style="mt2">(Nahúm)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Xi' nyolina' tuj Nawum ti'ju' tzalajb'il b'aj tej tkub'ti'ju' tnam Ninib'e, aju' nintnam nimaq toklen te Asirya, jaw nimix kyib'aj kykyaqil tnam ojtxi' ex nimaqtoq toklen, ex majxtoq ajq'oj kyi'j aj Israel. Kub'ti'ju' tnam lu tej tb'aj junk'al o'lajnaq (700) ab'q'i na'mxtoq titz'ji Krist, ex kykyaqilju' tnam e'tzalaj tej tkub'ti'ju' nintnam lu, mya oqe'kxju' aj Juda, qu'n majx etzaqpaj kykyaqilju' tnam toj tjawetzq'ij tjaq' tkawb'ilju' nintnam lu. Atzunte t-sanjelal Dyos lu nkane toj twitz qa jun tz'e'ysb'il twitzju' tnam lu tzaj tq'o'n Dyos. Aju' yol tz'ib'a'n toju' u'j lu ttxolexi'x tel ex nimaqxi'x toklen, kse'n ajtyolin kyi'ju' karwaj ex kyi'j aj chejil ajq'ojqe' xi'toq kypon ti'ju' nintnam (2.1-12). Aju' tz'ib'ante junxi'tl nakuxi'xtej nche' yukchi xjal toj ajtjaw qẍch'i'n, tuk'i'l junjun tnej yol b'a'nxi'x chik'b'ab'ente ex nakuxi'xtej nche' q'ajti, kyuk'i'l yol toj eb'rey ojtxi' ajb'en tu'n t-sanjelal Dyos nakuj nxi' kxnik'b'e'n kse'n nche' q'ajta' karwaj ex kyqan chej ex tej kykub' chukli toj q'oj.</para>
  <chapter number="1" style="c" />
  <para style="s1">Ttx'u'jil Dyos ex tu'me'l t-xel tu'n</para>
  <para style="p">
    <verse number="1" style="v" />U'j te pakb'ab'l tk'am Nawum te Elkos toj nakuj witzik'. Ti'j Ninib'e yolina' pakb'ab'l lu.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Nxky'aqlante Qman Dyos ex nq'on tu'me'l t-xel:</para>
  <para style="q">Ntq'o'n tz'e'ysb'il witzb'aj kyeju' min nche' b'in te,</para>
  <para style="q">ex ntzaj ttx'u'jil kyi'ju' tajq'oj.</para>
  <para style="q">
    <verse number="3" style="v" />Atite Qman Dyos tpasensi ex nimtipumal,</para>
  <para style="q">ex nkub' ttz'e'ysa'n twitzju' ati tpaj.</para>
  <para style="q">Ate Qman Dyos nb'et toj q'ankyaq,</para>
  <para style="q">ex njawju' muj nakuj quq tu'n tqan.</para>
  <para style="q">
    <verse number="4" style="v" />Ntzqiju' ninnjab', qama txi' tma'n te.</para>
  <para style="q">Nche tzqiju' nin a' tu'n kykyaqil.</para>
  <para style="q">Nche kub' jilju' witz te B'asan exju' witz te Karmelo tu'n,</para>
  <para style="q">ex ikx nche' ch'uẍi'xju' b'ech toj tx'otx' te Lib'ano tu'n.</para>
  <para style="q">
    <verse number="5" style="v" />Nche lu'lunju' witz twitz;</para>
  <para style="q">ex nche kub' niwju' k'ok'e witz twitz.</para>
  <para style="q">Tkyaqilju' tx'otx' njaw yukchi aj tlonte</para>
  <para style="q">tkyaqilju' twitz tx'otx' ex ikxqe' xjal najlqe' twitz.</para>
  <para style="q">
    <verse number="6" style="v" />¿Alxi'xkyeju' kweb'il twitzju' ttx'u'jil?</para>
  <para style="q">¿Alxi'xkye jun k'ik'exju' ttx'u'jil tu'n?</para>
  <para style="q">In ximlenju' ttx'u'jil kse'n q'aq',</para>
  <para style="q">ex twitzku' nche'xa' aq'puju' pik.</para>
  <para style="q">
    <verse number="7" style="v" />B'a'nxi'x te Qman Dyos;</para>
  <para style="q">ntq'uqb'a'n qk'u'j toj k'ixk'oj:</para>
  <para style="q">nche' tklo'nju' q'uqlok kyk'u'j ti'j.</para>
  <para style="q">
    <verse number="8" style="v" />Extzun, kse'n tnimal a' tkyaqil kb'ajel t-xitu'n,</para>
  <para style="q">nche kub' tb'ajsa'nju' nche okmiltz'uj ti'j;</para>
  <para style="q">kb'el kyi'ju' tajq'oj tu'nju' qlolj.</para>
  <para style="q">
    <verse number="9" style="v" />¿Titi' nkyxima'ne' ti'j Qman Dyos?</para>
  <para style="q">¡Che b'elxitu'n jumajx tu'n!</para>
  <para style="q">¡Mix-a'lo'x kb'entel tmyonte tkamaji'n!</para>
  <para style="q">
    <verse number="10" style="v" />Ikyqe' kse'n ch'i'x tzyu'nkyib',</para>
  <para style="q">tzyu'n kywi' b'a'nxi'x tu'n q'e'n,</para>
  <para style="q">ikyche okyela' kse'n t-xaq tze tzqij te q'aq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Tnam Ninib'e, toja setza'ju' xjaw ximante'</para>
  <para style="q">taq'wixil ti'j Qman Dyos:</para>
  <para style="q">Jun taq'wix q'ol nab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Qu'mtzun ntma'n Qman Dyos teju' ttanam:</para>
  <para style="q">B'a'nqa kuwqe'kye' aj Asirya ex nim kyb'aj,</para>
  <para style="q">kche b'elxitit ex che najel.</para>
  <para style="q">Matxi' yajtixi'ya wu'ne',</para>
  <para style="q">Extzun lay yajtitla wu'ne'.</para>
  <para style="q">
    <verse number="13" style="v" />Kb'ajel nq'uchi'ne' tiqb'ila ti'j tqula</para>
  <para style="q">ex k'elel nlaqu'ne' txpatx'k'uxb'ila.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />Oje tchaq'te Qman Dyos teya, nimaqkawil toj Ninib'e kjalu:</para>
  <para style="q">Mixti' tyajajila kjelten tu'n tkyeju' tb'iya kukxju';</para>
  <para style="q">toju' tja tdyosa che kb'el nxitu'ne'.</para>
  <para style="q">witzileb' exju' tilb'ilal b'incha'n,</para>
  <para style="q">ex atzu' kb'elexa' mqu'na qu'n mya b'a'na toj nwitze'.</para>
  <para style="s1">Tqanil tu'n tkub' tz'aqju' nintnam Ninib'e</para>
  <para style="q">
    <verse number="15" style="v" />¡Kyka'yinxe'! ¡Lu tzul kwi'ju' witz</para>
  <para style="q">lu sanjelal tzul ti'nju' tqanil te nak'b'il!</para>
  <para style="q">Kyik'samjuye' ninq'ij, Juda;</para>
  <para style="q">japunx tyola oje tmaya.</para>
  <para style="q">Lay tz'el q'i'n jumajtlju' ttx'otx'a kyu'nju' b'inchal myab'a'n;</para>
  <para style="q">matxi' che kub' xiti'n kykyaqil.</para>
  <chapter number="2" style="c" />
  <para style="q">
    <verse number="1" style="v" />Lu xitul tzul ti'ja Ninib'e.</para>
  <para style="q">¡Q'onqe'ka xq'uqil toju' ja kuwsa'n!</para>
  <para style="q">¡Xq'uqimju'ya b'e!</para>
  <para style="q">¡K'lonkjuya k'uẍtx'e'nb'il b'a'nxi'x tk'uja!</para>
  <para style="q">¡Kq'onk kyipumale' b'a'nxi'x!</para>
  <para style="q">
    <verse number="2" style="v" />Qu'n kjawil nimsa'n jumajltlu' Jakob' tu'n Qman Dyos,</para>
  <para style="q">ex kjawil nimsa'nju' Israel tu'n,</para>
  <para style="q">kse'nx tej na'mxtoq tb'aje'x iq'inju' ti'xti' toj</para>
  <para style="q">ex na'mxtoq tkyej nakuj jun tqan ub'a mixti'tl tq'ob'.</para>
  <para style="q">
    <verse number="3" style="v" />Kyeq che ka'yin kykolb'ilju' q'ojil</para>
  <para style="q">ex kyeq che ka'yinju' kxb'alun kxjal te q'oj.</para>
  <para style="q">¡Ma matxi' b'ent ktene' tu'n kq'ojine'!</para>
  <para style="q">Nakuj q'aq'qeju' kykarwaj;</para>
  <para style="q">exqetzunju' kychej inxi'x che ayon tu'n kq'ojin.</para>
  <para style="q">
    <verse number="4" style="v" />Inxi'x che ik' jumju' kykarwaj tu'n ktx'ujil toj xky'ichb'e,</para>
  <para style="q">inxi'x nche jumunje tiju' plas,</para>
  <para style="q">naku'j q'aq' che k'ant,</para>
  <para style="q">ex nche qoptz'aj nakuj xloq'lokya'j.</para>
  <para style="q">
    <verse number="5" style="v" />Ntxokinju' nimaqkawil kyeju' nejenel,</para>
  <para style="q">aye'tzunkye nche jaw tz'aq ajkypon ojqel twitzju' nintapi,</para>
  <para style="q">ja taju' kolb'il kyib'.</para>
  <para style="q">
    <verse number="6" style="v" />Nche etz jaqlju' tjpel nin a',</para>
  <para style="q">ex ntzaj niq'ju' tja kawb'il.</para>
  <para style="q">
    <verse number="7" style="v" />Nxi' iq'i'n t-xu'jil nimaqkawil toj juntl tnam;</para>
  <para style="q">nche'x lpeju' tmajen ti'j,</para>
  <para style="q">nche oq' kse'nqe' xu'ch</para>
  <para style="q">ex nok kyjumi'n ttzikyk'uj kuw tu'n b'is.</para>
  <para style="q">
    <verse number="8" style="v" />Nche' b'je'x oqkye' xjal toju' tnam Ninib'e</para>
  <para style="q">naku'j kse'n a' nex toju' tk'b'el pa'x.</para>
  <para style="q">¡Che we'ku'ye'! ¡Kutanjtz kyi'je'! chechij nxi'kyma'n kye,</para>
  <para style="q">Ex mix-a'loxte anjtzti'j.</para>
  <para style="q">
    <verse number="9" style="v" />¡Kyelq'anxjiye' saqpwaq! ¡kyelq'anxjiye' q'anpwaq!</para>
  <para style="q">¡Qu'n layx mankunju' tq'inumal Ninib'e!</para>
  <para style="q">
    <verse number="10" style="v" />Matxi' kub' xitj, chq'ajlajtl ex mixti'tl toju' tnam Ninib'e.</para>
  <para style="q">Inxi'x ch'onju' kyanmi tu'n xob'il,</para>
  <para style="q">inxi'x lu'lun kyqan tu'n xob'il,</para>
  <para style="q">kykyaqilx mixti'tl kyipumal,</para>
  <para style="q">ex majx matxi' che kub' sq'anax.</para>
  <para style="q">
    <verse number="11" style="v" />¿Jatzun taju' kyjul b'alun ja'lo,</para>
  <para style="q">exju' kyja tal tman b'alun?</para>
  <para style="q">Jamitoq jun nche xob'a b'alun kyuk'i'lju' kyal;</para>
  <para style="q">Ex mixa'lo'toq nok sak'punkye.</para>
  <para style="q">
    <verse number="12" style="v" />Intoq kub' tb'yonte b'alunju' tchi',</para>
  <para style="q">ex nxi' t-sipa'n kxolju' ttxu b'alun exqe'ju' tal tma'n b'alun,</para>
  <para style="q">ex nojnitoqju' tjul kyu'nju' tchi'.</para>
  <para style="s1">Kub' xiti'nju' tnam Ninib'e tkyaqil</para>
  <para style="q">
    <verse number="13" style="v" />Chi Qman Dyos nimtipumal kjalu:</para>
  <para style="q">Luqine' nchin q'ojine' ti'ja:</para>
  <para style="q">che kb'el ntz'e'ysa'ne tkarwaja te q'oj</para>
  <para style="q">ex sib'tl che jela' wu'ne';</para>
  <para style="q">che kb'el nb'yo'ne' tal tman b'alun ateqe' toja,</para>
  <para style="q">lay che alq'antlju' xjal najlqe' toj ttx'otx'a,</para>
  <para style="q">ex lay txi' b'intl tq'ojq'ojel kywi'ju' t-sanjelala.</para>
  <chapter number="3" style="c" />
  <para style="q">
    <verse number="1" style="v" />¡Qab'anx twitza, b'yolxjal nintnam,</para>
  <para style="q">nojni toja tu'n chajyolil ex b'yojxjali'n;</para>
  <para style="q">layx b'aj ttxa'nju' alq'an toja!</para>
  <para style="q">
    <verse number="2" style="v" />¡B'inxa tq'ojq'ojel asyal, exqe' ttulil!</para>
  <para style="q">¡tq'ojq'ojel kyqan chej, nche t'ikpuju' karwaj kyu'n!</para>
  <para style="q">
    <verse number="3" style="v" />¡Txqan xjal aj chejil!</para>
  <para style="q">¡Nche tilk'aju' k'uẍtx'e'nb'il,</para>
  <para style="q">ex nche qoptz'aju' ch'ut!</para>
  <para style="q">¡Txqan k'ixjb'niqe',</para>
  <para style="q">txqan kyimni pa'k'lqe'!</para>
  <para style="q">¡Layx b'ent kyajletju' kyimni!</para>
  <para style="q">¡Nche jaw tz'aqju' xjal kyi'j!</para>
  <para style="q">
    <verse number="4" style="v" />Naqx tu'n tpaju' ajpaji'n saja' lu</para>
  <para style="q">tu'nju' qya ajpajil tb'anilxi'x,</para>
  <para style="q">xnaq'tzalteju' jk'ayi'n kye xjal,</para>
  <para style="q">naqx tu'nju' ajpaji'n ex jk'ayi'n</para>
  <para style="q">nche kub' t-sb'u'nju' tnam exqe'ju' nimaqtnam.</para>
  <para style="q">
    <verse number="5" style="v" />Chi Qman Dyos nimtipumal kjalu:</para>
  <para style="q">Luqine' nchin q'ojin ti'ja:</para>
  <para style="q">k'elel wi'ne' ti'ja ex majx kb'el nẍb'iqb'a'na,</para>
  <para style="q">tu'ntzun tel tch'ixawa kwitzju' nimaqtnam.</para>
  <para style="q">
    <verse number="6" style="v" />Kb'el nq'o'n txqan tz'ile' tib'aja;</para>
  <para style="q">ex majx k'elel tch'ixawa wu'ne kwitz txqan xjal.</para>
  <para style="q">
    <verse number="7" style="v" />Kykyaqilju' che okyel ka'yinteya che b'el oq ex kkyma':</para>
  <para style="q">¡Matxi' kub' xitjte' Ninib'e!</para>
  <para style="q">¿Alxi'xkye jun ktzajel laqj tk'u'j ti'j? ¿Ja k'elel yala jun q'uqb'al tk'u'j?</para>
  <para style="q">
    <verse number="8" style="v" />¿B'a'nxi'xtzunta kyetwitz Teb'as,</para>
  <para style="q">aju' nintnam ati ttzi nin a' Nilo,</para>
  <para style="q">tok txqan a' ti'jile;</para>
  <para style="q">tu'nju' nin a' nkleta' ex tokju' a' te jun tapi ti'j?</para>
  <para style="q">
    <verse number="9" style="v" />Atoq Etyopiy ex Ejipt kuwsalte;</para>
  <para style="q">ex tqe'ktoq xjal te Put, exqe' aj Lib'ya tuk'i'l.</para>
  <para style="q">
    <verse number="10" style="v" />Xipe' q'inte Teb'as toj juntl tnam;</para>
  <para style="q">eb'aj kub't'aqu'n kyk'wal twitz tx'otx' ja nkymujb'ana' kyib'ju' xkichb'e;</para>
  <para style="q">eb'ajx pa'nju nimaq kyoklen kyeju' jatu'n kxa' q'o'na</para>
  <para style="q">ex eb'ajk'lo'n kyq'ob'ju' kynejel toj xpatx'k'uxb'il.</para>
  <para style="q">
    <verse number="11" style="v" />Ex kxe'l q'o'n q'e'n teya tu'n tjaw tx'ujtiya;</para>
  <para style="q">kb'el ewintzuntza twitz tajq'oja.</para>
  <para style="q">
    <verse number="12" style="v" />Tkyaqilju' ja kuwsa'n tu'na ikqeju' kse'n iw txijli toj twitz cha'x,</para>
  <para style="q">nche kutz tz'aq qama che'x yukchet,</para>
  <para style="q">toj ktziju' nche'x wante.</para>
  <para style="q">
    <verse number="13" style="v" />Naku'j qyaqe' t-xjala te q'oj;</para>
  <para style="q">matxi' che okx jaqliju' tjpel tnam kyeju' ajq'oj;</para>
  <para style="q">matxi' che b'aju' t-xq'e'l tjpel ja tu'n q'aq'.</para>
  <para style="q">
    <verse number="14" style="v" />Q'intza a' tu'ntzun twe'ya kwitzju' ajq'oj;</para>
  <para style="q">kuwsanqema ja te kolb'ilteya,</para>
  <para style="q">we'kuxa toju' xo'q'l,</para>
  <para style="q">wab'enku'ya xo'q'l b'a'nxi'x,</para>
  <para style="q">q'intza malb'ilkyeju' tladrisa.</para>
  <para style="q">
    <verse number="15" style="v" />Atzuntzu' kb'ajelaya tu'n q'aq',</para>
  <para style="q">tu'n k'uẍtx'e'nb'il, kse'n kyu'n ẍt'ikt'u'l,</para>
  <para style="q">majx kb'el b'ajsa'na.</para>
  <para style="q">¡Maskye nim txqan t-xjal ate'!</para>
  <para style="q">¡Maskye iky kyajlal kse'nqe' ẍt'ikt'u'l!</para>
  <para style="q">
    <verse number="16" style="v" />Mape' che chmet-xi'xju' t-ẍk'aẍlela kyewitzju' che'w twitz kya'j.</para>
  <para style="q">(In chukjte' ẍt'ikt'u'l ti'j ex nlipan.)</para>
  <para style="q">
    <verse number="17" style="v" />Naku'j ẍt'ikt'u'l t-xq'uqila;</para>
  <para style="q">exqetzunju' nejenel kyeju' t-xjala te q'oj</para>
  <para style="q">naku'j txqan txkupqe' snuk'li twitz kya'j:</para>
  <para style="q">qa ati che'w nche ok snuk'e twitz tapi;</para>
  <para style="q">ajtzun tjawil q'ij nche'x lipan ex mix-a'loxte b'ilte ja nche'xa'.</para>
  <para style="q">
    <verse number="18" style="v" />¡Naq nche wtanju' tk'ik'lela,</para>
  <para style="q">nimaqkawil toj Asirya!</para>
  <para style="q">Nche wtanju' nejenel kye xjal te q'oj,</para>
  <para style="q">matxi' che'x sputju' t-xjala te q'oj toj k'ul</para>
  <para style="q">ex mix-a'lox jun tu'nwt tok b'uyinkye.</para>
  <para style="q">
    <verse number="19" style="v" />¡Mixti'xte q'anb'il teju' tk'ixb'ena;</para>
  <para style="q">layx b'ent tq'anitju' tx'a'k ti'ja!</para>
  <para style="q">Kykyaqilju' matxi' kb'i ti'ju' k'ulb'a'n saj ti'ja nche ploq'chan toj kyq'ob' tu'n tzalajb'il,</para>
  <para style="q">qu'n, ¿alkye jun min xyajt tu'nju' tila mib'ajela'?</para>
</usx>