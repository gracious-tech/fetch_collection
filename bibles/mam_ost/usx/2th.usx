<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="2TH" style="id">2TH.TXT Febrero 2009 PEDRO D. Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">2 Tesalonisenses</para>
  <para style="toc3">2 Ts</para>
  <para style="toc2">2 Ts</para>
  <para style="toc1">Tkab' U'j Kye Aj Tesalonik (2 Tesalonicenses) Chik'b'ab'l</para>
  <para style="mt1">TKAB' U'J KYE AJ TESALONIK</para>
  <para style="mt2">(2 Tesalonisenses)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Nakuj jaw iq'i'n kyk'u'ju' okslal aj Tesalonik tu'nju' tnejel u'j xittz'ib'a'n Pawl kye: majx e'jaw xob', qu'n kub' kyxima'n qa ch'inxtltoq tul jumajtl Jesukrist. Expe' a b'aju' kyxol (3.6-12), qa ateqe' junjun okslal ma'toq kyaj kytzaqpi'n kyaq'un tu'n tpaj ex intoq che ayon tu'n tul Qajaw Jesukrist, ex intoq che anq'in tu'n kyonb'il txqantl okslal. Atzunte Pawl xittz'ib'anju' juntl tuj tu'n tb'ajx tchik'b'a'nxi'x kye, tu'n lalun che b'ajxob' ex tu'n lalun che kub' chukj.</para>
  <para style="ip">Yajxi'tzuntl tej tjaw tzalaj Pawl ex tej txitq'o'n chjonte te Dyos tu'nju' ma'toq che ch'iy okslal aj Tesalonik toj kyokslab'l ex intoq kyk'u'jla'n kyib' (1.1-12) okten chik'b'alte kye qa ilti'j tu'n kyok xjal toj xjel tu'n Dyos exqa aju' tulel Qajaw tkamaji'n axte', na'mxtaqtzun tpon kanun ja'lu ajtb'aj ttxa'nju' il tkyaqil twitz tx'otx' tjaq' tkawb'il jun xjal nok q'o'n tb'i tu'n Pawl xjal nimaq aj il mujqa Nimaq b'inchal il, atzun kjawil b'uyinkye txqantlju' tu'n tjaw kyiq'i'nkyib' ti'j Dyos ex ti'j Krist. Qu'mtzun b'ajx toqxeni'n Pawl kye, tu'n lalun che jawxob' ajt-xi' q'ma'n txqan ti'xti' kye, maskyepe' axte xxiq'mante kye, qa aju' tq'ijlalil Qajaw tu'n tul matxi' japun kanun (2.2).</para>
  <para style="ip">Kyxoltzunju' nab'l b'ajkub' ttz'ib'a'n mankb'ilxi' toju' tuj (cap. 3), ex tej ma'toq txitqani'n kye tu'n kyna'n Dyos ti'j ex kyi'ju' tuk'i'l, nyolin b'a'nxi'x ex kuw ti'ju' tu'n qaq'unan tojxi'x tnik'alti'j tu'ntzun qwan, kse'nju' tu'me'l aku' xiyek'unte kye. Aja'lu tyolku', ex nelyal jun tyol nimxi'x toklen toju' u'j lu, aju' nok q'o'n qa tyol juntl, ju' intma'n kjalu: Alkyete min tajb'il tu'n taq'unan ex lalun wan (3.10), chij.</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ayine' Pawl tuk'i'l Silb'ano ex Timotey, nche'x qq'olb'e'ne' aye'ye' okslalqe'ye' te Qman Dyos ex te Qajaw Jesukrist toj nintnam Tesalonik. <verse number="2" style="v" />Awt Qman Dyos ex Qajaw Jesukrist tzaj q'onte t-xtalb'il ex tnak'b'il kyeye'.</para>
  <para style="s1">Ktz'e'ysetel kywitz aj il tu'n Krist ajtul</para>
  <para style="p">
    <verse number="3" style="v" />E'ntzik ex e'witz'in, ati tu'n qq'on chjonteye' te Dyos kukxju' kyi'je', tu'me'lte' tu'n qb'inchanteye' qu'n in ch'iy kyokslab'le' ex kyk'u'jlalile' kyi'j txqantl. <verse number="4" style="v" />Qu'mtzun nqo tzalaje' ajqyoline' kye okslal ti'j Dyos tu'nju' kyipumale' toj kyokslab'le' toj tkyaqil yajb'il kyi'je' ex k'ixk'oj nik'xkyu'ne'. <verse number="5" style="v" />A yek'b'il ja'lu qa tu'me'lxi'x tu'n Dyos matxi' che oke' toj xjel tu'n ex mataq' anb'il tu'n kyoke' toju' tkawb'il, tu'n tpajtzu'n nche yajtiye' ja'lo.</para>
  <para style="p">
    <verse number="6" style="v" />Tu'me'lte' tu'n ttz'e'ysante Dyos kywitzju' nche yajun kyeye', <verse number="7" style="v" />ex tu'n tq'onte ojb'il kyeye' junx quk'i'le', aye'ye' nche yajtiye', toju' tq'ijlalil ajtul Qajaw Jesus kyuk'i'l tanjl ati kyipumal, ajttzaj toj kya'j toj tqan taq' q'aq'. <verse number="8" style="v" />Tzul tz'e'ysalte kywitzju' min nelkynik' te Dyos ex min nkynima'n tpakb'al b'a'n tu'n Qajaw Jesus. <verse number="9" style="v" />Kb'el ttz'e'ysa'n kywitz tu'n xitb'il tejumajx, ex che b'je'lex q'o'n najchaq ti'j Dyos ex ti'jxi' tajwalil ex tipumal, <verse number="10" style="v" />toju' tq'ijlalil ajtul Qajaw tu'n tjaw nima'n kxolju' xjan tnam ex tu'n ktzalaj kykyaqilju' okslal ti'j; matxina' kyokslaye' tpakb'al b'a'n xiqpakb'a'ne' kyeye'.</para>
  <para style="p">
    <verse number="11" style="v" />Tu'ntzunju' nqo na'n Dyose' kukxju' kyi'je', nxi' qqani'ne' te Qman Dyos tu'n kyanq'ine' b'a'n twitz se'nx txokb'enkyeye' tu'n, ex tu'n tjapun tkyaqil kyximb'e'tze' b'a'n tu'n tipumal Dyos, ex tu'n kyb'antju' aq'untl nkyb'incha'ne' tu'n kyokslab'le'. <verse number="12" style="v" />Ikytzu'n kjawil nima'n tb'i Qajaw Jesus kyi'je', ex che jawil nima'ne' tu'n, tu'nju' t-xtalb'il Qman Dyos ex Qajaw Jesukrist.</para>
  <chapter number="2" style="c" />
  <para style="s1">Aju' xjal aj ilxi'x</para>
  <para style="p">
    <verse number="1" style="v" />Atzun ja'lo e'ntzik ex e'witz'in, ajtultl Qajaw Jesukrist ex ajqmujb'ante qib' tuk'i'l, nxiqkub'sa'ne' kyeye' <verse number="2" style="v" />tu'n lalun kych'exb'enaj kynab'le' ex lalun che jaw sak'puje' qa ati jun maq'mante qama tk'am jun yek'b'il tu'n Xewb'aj Xjan, mujqa matk'am xnaq'tzb'il ku'xwitloj matxi qma'ne' te mujqa toj quje' qa matxi' tzul tq'ijlalil tu'n tul Qajaw. <verse number="3" style="v" />Lalun kyaq' sb'u'kyib'e'. Nej che q'ojilkye xjal ti'j Dyos, tzulnejte' jun xjal aj ilxi'x, ju' kxe'l toj naje'n. <verse number="4" style="v" />Atzun ajq'oju' ti'j Dyos ex kyi'ju' nche k'ulun te Dyos, expe' kb'el qe toj tja Dyos ex k'okyel tq'o'ntib' te Dyos.</para>
  <para style="p">
    <verse number="5" style="v" />Kyna'ntze' nyoline' ti'ju' lu kyeye' tej atinxtoqe' kyxole'. <verse number="6" style="v" />B'i'ntl kyu'ne' ja'lo alkyeju' nmqonte, tu'ntzun lalun tzul na'mxtoq tpon tq'ijlalil. <verse number="7" style="v" />Ljo'na' tulte' t-xim myab'a'n toj ewaj, naqa sel q'i'nju' mqolte ja'lo. <verse number="8" style="v" />Oktzun tyek'u'tib' xjaltz aj ilxi'x, ex kb'el b'yo'n tu'n Qajaw, naq kxel t-xupi'n ex k'elel tipumal tu'n t-spik'umal Qajaw ajtul. <verse number="9" style="v" />Q'o'n tipumalju' xjal aj ilxi'x tu'n tajaw il ajtul; che b'antel techlal ex b'a'nq'ob'aj mya ax tu'n. <verse number="10" style="v" />Ksb'ul kyu'n tb'inchb'en myab'a'n kyi'ju' xjal che kxe'l toj tz'e'ysb'il witzb'aj, tu'n tpaj min nkyk'mo'n tpakb'al b'a'n axxi'x tu'n kyklet. <verse number="11" style="v" />Qu'mtzun nche kyej tq'o'n Dyos tu'n kysb'unjtz tu'n b'inchal myab'a'n ex tu'n txi' kyoksla'n chajyolil, <verse number="12" style="v" />tu'n kyxiq'o'ntzuntz toj tz'e'ysb'il witzb'aj kykyaqilju' min nche okslan teju' tpakb'al b'a'n axxi'x, axtzu' q'uqla' kyk'u'j toju' kyb'inchb'aj myab'a'n.</para>
  <para style="s1">Ojaw t-sk'o'n Dyos tu'n qklet</para>
  <para style="p">
    <verse number="13" style="v" />Ilti'j tu'n qq'onteye' chjonte te Dyos kyi'je' ntzik ex e'witz'in, k'u'jla'n qe'ye' tu'n Qajaw, qu'n mache jaw sk'o'ne' tu'n Dyos tu'ntzun nejtl tu'n kykanb'anteye' kolb'il tu'nel Xewb'aj Xjan nxjansankyeye', ex tu'n kyk'monteye' tpakb'al b'a'n axxi'x matxi' kyokslaye'. <verse number="14" style="v" />E'txkonjtze' tu'n Dyos toju' tpakb'al b'a'n xiqpakb'a'ne': tu'ntzun tten kyoklene' toju' tajwalil Qajaw Jesukrist.</para>
  <para style="p">
    <verse number="15" style="v" />Qu'mtzun e'ntzik ex e'witz'in, lalun tzik'tna'lju' xnaq'tzb'il xiqq'o'ne' kyeye', ayo'ku'ye' mujqa toj u'j. <verse number="16" style="v" />Matxi' qotk'u'jla Qajaw Jesukrist ex Qman Dyos, ex matxi' tzaj tq'uqb'a'n qk'u'j tejumajx tu'n t-xtalb'il, <verse number="17" style="v" />Awt Qajaw ex Qman Dyos kuwsante kyanmiye' ex tz'oninkyeye' tu'n kyb'inchanteye' b'a'n ex tu'n kyoline' b'a'n.</para>
  <chapter number="3" style="c" />
  <para style="s1">Tqani Pawl tu'n kyna'n Dyos ti'j</para>
  <para style="p">
    <verse number="1" style="v" />E'ntzik ex e'witz'in, atzun ja'lo, che na'nqe Dyose' qi'je', tu'ntzun tpon pakb'ab'l tyol Dyos lwiyxi'x toj tkyaqil plaj ex tu'n tk'monjtz toj tzalajb'il, kse'n b'aj tej tpon kyxole'. <verse number="2" style="v" />Ex che na'nqe' Dyose' qi'je' tu'n qklonjtze' tu'n Dyos kyeju' xjal b'inchal myab'a'n ex pi'sqe', qu'n mya kykyaqil xjal nche okslan te Qajaw. <verse number="3" style="v" />Atzunte Qajaw njapun tyol, ex a k'onilkyeye' tu'n kywe'ye' toj kyokslab'le' ex che xq'uqinjtzele' tu'n te tajaw il. <verse number="4" style="v" />Ex q'uqli qk'u'je' ti'j Qajaw qa nkyb'incha'ne' matxi' b'ajx qma'ne' kyeye' ex kyb'incha'ye' kukxju'. <verse number="5" style="v" />Awt Qajaw tz'oninkyeye' tu'n tten kyk'u'jlalile' kse'n tk'u'jlalil Dyos kyi'je', ex tu'n tq'onjtz kyipumale' tu'n Krist toju' yajb'il kyi'je'.</para>
  <para style="s1">Ilti'j tu'n qaq'unan</para>
  <para style="p">
    <verse number="6" style="v" />E'ntzik ex e'witz'in, kxe'l qma'ne' chaq'b'il kyeye' toj tb'i Qajaw Jesukrist, kypa'mil kyib'e' ti'j alkyexku' okslal min nb'et ex min nanq'in kse'nx matxi' txiqxnaq'tza'ne' kyeye'. <verse number="7" style="v" />Kanlikye' kywitz se'n tu'n kyanq'ina'ye' tu'n tel kykno'ne' qi'je': min o'tenqe' kyxole' miwtjun o'aq'unane', <verse number="8" style="v" />ex min o'wane' miwtjun qchoj qwaye'. Ojexi'x pena' o aq'unanqe' q'ijtl ex qonik'an tu'n lalun kub' qq'o'n jun iqtze' kyib'aje'. <verse number="9" style="v" />Axxi'x atitoqqe' qoklen tu'n txi' qqani'ne' o'nb'ilqeye' kyeye', o'aq'unan tzune' tu'n tkub' qq'o'ne' jun yek'b'il kyeye' tu'n txi' kyb'incha'ne'. <verse number="10" style="v" />Xiqq'o'ne' chaq'b'il kyeye' tej qtene' kyxole' kjalu: alkyete min tajb'il tu'n taq'unan, ex mixti' tu'n twan. <verse number="11" style="v" />Matxitzun qb'iye' ate' junjun kyxole' min kyajb'il tu'n kyaq'unan, naq nex kyq'ij ttzi kyja xjal. <verse number="12" style="v" />Nxiqma'ne' ex nxiqoqxena'ne' kyeju' xjal lu tu'n qoklene' tzaj tq'o'n Qajaw Jesukrist, che aq'unanqe' tu'n kyk'a'chante kyib', tu'ntzun lalun che yajun kye txqantl.</para>
  <para style="p">
    <verse number="13" style="v" />Naq o'kx lalun che siktiye' tu'n kyb'inchanteye' b'a'n, e'ntzik ex e'witz'in. <verse number="14" style="v" />Qa ati jun min nxitb'i'nju' nxiqma'ne' toju' u'j lu, kyka'yinke' alkye ex lalun kyuk'ilakyib'e' tuk'i'l, tu'n tkub' ch'ixwi. <verse number="15" style="v" />Naq o'kx lalun tz'ok te kyajq'oje', kyq'onxe' tnab'l kse'n jun qtzik mo qitz'in.</para>
  <para style="s1">Q'olb'eb'l te b'ajsb'il</para>
  <para style="p">
    <verse number="16" style="v" />Axwit Qman Dyos q'ol nak'b'il tzaj q'onte nak'b'il kyeye' toj tkyaqil tq'ijlalil ex toj tkyaqil tu'me'l. Awt Qajaw ten kyuk'i'le' kykyaqile'.</para>
  <para style="p">
    <verse number="17" style="v" />Ayine' Pawl, nxi' ntz'ib'a'ne' q'olb'eb'l lu kyeye' tu'n nq'ob'e'. Ikytzu'n nkub'a' nsqitu'ne' kyi'j kykyaqil wuje'; ikytzun chin tz'ib'a'n ju'ye'. <verse number="18" style="v" />Awt Qajaw Jesukrist tzaj q'onte t-xtalb'il kyeye' kykyaqile'.</para>
</usx>