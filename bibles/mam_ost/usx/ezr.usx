<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="EZR" style="id">EZR.TXT Febrero 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Esdras</para>
  <para style="toc3">Esd</para>
  <para style="toc2">Esd</para>
  <para style="toc1">Tuj Esdras (Esdras)</para>
  <para style="mt1">TUJ ESDRAS</para>
  <para style="mt2">(Esdras)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Toj jun tu'me'l junqe'xju' u'j lu tuk'i'lju' tuj Neemiy, ax tq'ijlalilju' nche yolina' ti'ju' tqanil kyi'ju' aj Juda. Toj juntl tu'me'l, tzyu'n kyib'ju' tz'ib'a'n kyoj ex nkytz'aqtza'nchaqju' tqanil. Atzu'n janche yolina'xi'x junjun junxi'tlchaq. Jun xnaq'tzalte' Esdras ti'j chaq'b'il, axi'x tb'is tk'u'ju' tu'n tb'ant jumajtlju' kychwinqlal toj kyokslab'l. Atzunte Neemiy jun kawil kye tnam ex ati tk'u'j ti'ju' okslab'l, atzu' ximana'xi'x tu'n tb'jaw b'inchet jumajtlu' nintnam ex se'n tu'n kyklonte kyib' kye xjal ex tu'n kyb'aj tnk'u'n kyxjal te q'oj.</para>
  <para style="ip">Tz'ib'a'n tqanil tu'n Esdras kyi'j junjun aj Juda anjtzkyi'j tjaq' tkawb'il Sorob'ab'el; intq'o'n jun kyajlal kyoju' tnej jun ex kab'e' (1-2), atzu'n kyoju' tnej oxe' tzmax qaq (3-6) nyolin ti'ju' tej tjaw b'inchetl ex tej t-xjanset jumajtlu' tja Dyos. Atzu'n kyoju' tnej wuq tzmax toj lajoj (7-10) nyolin ti'ju' tej tanjtzti'j kyuk'i'l jte'tl exniqe'toq, ex ti'ju' taq'un tb'incha tej tb'aj tnk'u'n junmajtlu' kyanq'ib'l toj okslab'l.</para>
  <chapter number="1" style="c" />
  <para style="s1">Taq' Siro anb'il tu'n tnajkyi'j aj Juda toj kytx'otx'</para>
  <para style="r">(<ref loc="2CH 36:22-23">2 Cr 36.22-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tu'n tjapunju' tyol Qman Dyos q'ma'ntltoq tu'n Jeremiy, tzaj tq'o'n Qman Dyos tipumal Siro, nimaqkawil aj Persya, toju' tnejel ab'q'i nkawin, tu'n tex tq'o'n tqanil jun chaq'b'il toj tkyaqilju' tx'otx' tjaq' tkawb'il, ikjalu.</para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" />Intma'n Siro, nimaqkawil toj Persya, kjalu:</para>
  <para style="b" />
  <para style="pi">Matxi' che kub' tq'o'n Qman Dyos te toj kya'j kykyaqilju' kawb'il twitz tx'otx' toj nq'ob'e', ex tzaj toqxena'n weye' tu'n tjaw nb'incha'ne' jun tja Dyos toj Jerusalen, toju' tx'otx' Juda. <verse number="3" style="v" />Qu'mtzun, alkyexku' tzajni toju' ttanam Qman Dyos, awt Dyos tz'oninte, ex kutantlti'j toj Jerusalen, toj Juda, b'inchalteju' tja Qman Dyos ati toj Jerusalen. <verse number="4" style="v" />Ex kykyaqilxju' xjal najlqe' jachaq ta'qe'ju' etzniqe' ti'jxi' ttanam Dyos, tu'n kyonin ti'ju' kyb'isin k'anjetlti'j Jerusalen tuk'i'l saqpwaq, q'anpwaq, alu'mj ex ti'xti', ex oyaj tu'n kyk'u'j tiju' tja Qman Dyos toj Jerusalen, chi nimaqkawil Siro.</para>
  <para style="s1">E'ul junmajtl aj Israel Jerusalen</para>
  <para style="p">
    <verse number="5" style="v" />Aye'tzu'n nejenel kye kyyajajil Juda ex B'enjamin, e'pale exqe' aj Leb'i, mujqa kykyaqilju' atitltoq kyipumal tu'n Qman Dyos, kyb'inchakyib' tu'n kyantz toj Jerusalen b'inchalte jumajtl tja Qman Dyos. <verse number="6" style="v" />Kykyaqilju' kyb'sin eb'aj onin kyi'j tuk'i'n saqpwaq, q'anpwaq, alu'mj ex e'ti'xti' twi' wi'yalqe', ex chukchaq oyaj tu'n kyk'u'j. <verse number="7" style="v" />Atzunte nimaqkawil Siro, tzaj tanjsa'ntl kyi'ju' aq'unb'il toj tja Qman Dyos, ojetoq che b'je'tz tiq'in Nab'ukodonosor toj Jerusalen, ex eb'ajx tiq'i'n toju' tja kydyos. <verse number="8" style="v" />Xitma'n nimaqkawil Siro te Mitridates k'u'l pwaq tu'n ttzaj tanjsa'ntlkyi'j, eb'aj tajla'n ex b'ajx tq'o'n te Sesb'asar, kawil toj Juda. <verse number="9" style="v" />A kyajlal aq'unb'il ja'lu: junaq lajoj (30) nimaqlaq q'anpwaqqe', kab'k'al lajnaq (1,000) nimaqlaq saqpwaqqe', junaqb'eljoj (29) kuchil, <verse number="10" style="v" />junaq lajoj (30) laq q'anpwaqqe', junk'al lajoj (410) laq saqpwaqqe' myaxi'x twi' wi'yal, ex txqantl ti'xti'. <verse number="11" style="v" />Oxlajk'al lajnaq (5,400) kyajlalju' aq'unb'il q'anpwaq ex saqpwaq. Tkyaqil ja'lu b'aj tzaj tiq'i'n jumajtl Sesb'asar toj Jerusalen, tej kyb'je'tz jumajtl toj B'ab'ilon kyuk'i'lju' b'ajxniqe' iq'i'n.</para>
  <chapter number="2" style="c" />
  <para style="s1">Aye' anjtzkyi'j B'ab'ilon</para>
  <para style="r">(<ref loc="NEH 7:5-73">Neh 7.5-73</ref>)</para>
  <para style="p">
    <verse number="1-2" style="v" />A kyajlal aj Israel ja'lu e'i'tz'ji toj Juda, ju' eb'ajx iq'i'n toj B'ab'ilon tu'n nimaqkawil Nab'ukodonosor, ex yajxi'tl anjtztlkyi'j toj Jerusalen ex toj junjuntl najb'il toj Juda, teyile junjun toj tnajb'il, aye' nejliqe'ju' kywitz: Sorob'ab'el, Joswe, Neemiy, Serayiy, Reelayiy, Mardokyey, B'ilsan, Mispar, B'iwb'ay, Rewum ex B'aana:</para>
  <para style="q">
    <verse number="3" style="v" />jok'al wajxaqnaq kab'lajoj (2,172) tyajajil Paros,</para>
  <para style="q">
    <verse number="4" style="v" />atzun wajxaqlajnaq kab'lajoj (372) tyajajil Sepatiy;</para>
  <para style="q">
    <verse number="5" style="v" />atzun junk'al wajxaqlajnaq o'lajoj (775) tyajajil Ara;</para>
  <para style="q">
    <verse number="6" style="v" />atzun wuqk'al kab'lajoj (2,812) tyajajil Paat-moab', mujqa kyyajajil Joswe ex Joab';</para>
  <para style="q">
    <verse number="7" style="v" />atzun oxk'al kab'naq kyajlajoj (1,254) ttyajajil Elam;</para>
  <para style="q">
    <verse number="8" style="v" />atzun kab'k'al wuqnaq jwe' (945) tyajajil Satu;</para>
  <para style="q">
    <verse number="9" style="v" />atzun junk'al wajxaqlajnaq (760) tyajajil Sakay;</para>
  <para style="q">
    <verse number="10" style="v" />atzun junk'al kab'lajnaq kab'e' (642) tyajajil B'inuy;</para>
  <para style="q">
    <verse number="11" style="v" />atzun junk'al junlajnaq oxe' (623) tyajajil B'eb'ay;</para>
  <para style="q">
    <verse number="12" style="v" />atzun oxk'al junaq kab'e' (1,222) ttyajajil Askad;</para>
  <para style="q">
    <verse number="13" style="v" />atzun junk'al oxlajnaq qaq (666) tyajajil Adonikam;</para>
  <para style="q">
    <verse number="14" style="v" />atzun jok'al kab'naq qaqlajoj (2,056) tyajajil B'ikb'ay;</para>
  <para style="q">
    <verse number="15" style="v" />atzun junk'al kab'naq kyajlajoj (454) tyajajil Adin;</para>
  <para style="q">
    <verse number="16" style="v" />atzun kyajnaq wajxaqlajoj (98) tyajajil Ater;</para>
  <para style="q">
    <verse number="17" style="v" />atzun qaqlajnaq oxe' (323) tyajajil B'esay;</para>
  <para style="q">
    <verse number="18" style="v" />atzun jo'naq kab'lajoj (112) tyajajil Jora;</para>
  <para style="q">
    <verse number="19" style="v" />atzun junlajnaq oxe' (223) tyajajil Asum;</para>
  <para style="q">
    <verse number="20" style="v" />atzun kyajnaq o'lajoj (95) tyajajil Kib'ar;</para>
  <para style="q">
    <verse number="21" style="v" />atzun qaqnaq (123) aj B'elen.</para>
  <para style="q">
    <verse number="22" style="v" />Atzun kab'naq qaqlajoj (56) aj Netopa;</para>
  <para style="q">
    <verse number="23" style="v" />atzun qaqnaq wajxaq (128) aj Anatot.</para>
  <para style="q">
    <verse number="24" style="v" />Atzun kab'naq kab'e' (42) tyajajil B'et-asmab'et;</para>
  <para style="q">
    <verse number="25" style="v" />atzun junk'al wuqlajnaq oxe' (743) aj Kyiryat-jearim, aj Kyepira ex aj B'eerot;</para>
  <para style="q">
    <verse number="26" style="v" />atzun junk'al junlajnaq jun (621) aj Rama ex aj Kyeb'a.</para>
  <para style="q">
    <verse number="27" style="v" />Atzun qaqnaq kab'e' (122) xjal aj Mikmas;</para>
  <para style="q">
    <verse number="28" style="v" />atzun junlajnaq oxe' (223) aj B'etel ex aj Ay.</para>
  <para style="q">
    <verse number="29" style="v" />Kab'naq kab'lajoj (52) tyajajil Neb'o;</para>
  <para style="q">
    <verse number="30" style="v" />atzun wuqnaq qaqlajoj (156) tyajajil Makb'is;</para>
  <para style="q">
    <verse number="31" style="v" />atzun oxk'al kab'naq kyajlajoj (1,254) tyajajil juntl Elam;</para>
  <para style="q">
    <verse number="32" style="v" />atzun qaqlajnaq (320) tyajajil Arim.</para>
  <para style="q">
    <verse number="33" style="v" />Junk'al qaqlajnaq jwe' (725) aj Load, aj Adid ex aj Ono;</para>
  <para style="q">
    <verse number="34" style="v" />atzun wuqlajnaq jwe' (345) aj Jeriko;</para>
  <para style="q">
    <verse number="35" style="v" />atzun b'eljojk'al junaq lajoj (3,630) aj Senaa.</para>
  <para style="q">
    <verse number="36" style="v" />Kab'k'al wajxaqnaq oxlajoj (973) pale tyajajil Jedayiy, kyxol toj tja Joswe.</para>
  <para style="q">
    <verse number="37" style="v" />Atzun kab'k'al kab'lajnaq kab'lajoj (1,052) tyajajil Imer;</para>
  <para style="q">
    <verse number="38" style="v" />atzun oxk'al kab'naq wuq (1,247) ttyajajil Pasur;</para>
  <para style="q">
    <verse number="39" style="v" />atzun kab'k'al lajnaq wuqlajoj (1,017) tyajajil Arim.</para>
  <para style="q">
    <verse number="40" style="v" />Oxnaq kyajlajoj (74) tyajajil Leb'i, tyajajil Joswe ex Kadmyel, ex tyajajil Odab'iy.</para>
  <para style="q">
    <verse number="41" style="v" />Atzun qaqnaq wajxaq (128) aj b'itzal, tyajajil Asap.</para>
  <para style="p">
    <verse number="42" style="v" />Aye'tzu'n xq'uqil ttzija, aye' tyajajil Salum, tyajajil Ater, tyajajil Talmon, tyajajil Akub', tyajajil Atita exqe' tyajajil Sob'ay. Qaqnaq b'eljlajoj (139) tu'n kykyaqil.</para>
  <para style="p">
    <verse number="43" style="v" />Aye'tzu'n ajb'el toj tja Dyos aye' kyyajajil Siya, Asupa, Tab'aot, <verse number="44" style="v" />Kyeros, Syaa, Padon, <verse number="45" style="v" />Leb'ana, Akab'a, Akub', <verse number="46" style="v" />Akab', Salmay, Anan, <verse number="47" style="v" />Kyidel, Kaar, Reayiy, <verse number="48" style="v" />Resin, Nekoda, Kasam, <verse number="49" style="v" />Usa, Pasea, B'esay, <verse number="50" style="v" />Asna, Newunim, Nepusim, <verse number="51" style="v" />B'akb'uk, Akupa, Arur, <verse number="52" style="v" />B'aslut, Meyda, Arsa, <verse number="53" style="v" />B'arkos, Sisara, Tema, <verse number="54" style="v" />Nesiy ex Atipa.</para>
  <para style="p">
    <verse number="55" style="v" />Aye'tzu'n kyyajajilju' tmajen Salomon aye' kyyajajil Sotay, Soperet, Peruda, <verse number="56" style="v" />Jaala, Darkon, Kyidel, <verse number="57" style="v" />Sepatiy, Atil, Pokyeret-aseb'ayim ex Amon. <verse number="58" style="v" />Japun kyajlalju' ajb'el toj tja Dyos kyuk'i'lxi' tmajin Salomon toj b'eljlajnaq kab'lajoj (392).</para>
  <para style="p">
    <verse number="59" style="v" />Aye'tzu'n e'tzaj kyoju' tnam Tel-mela, Tel-arsa, Kyerub', Adon ex Imer, ex min elkynik'tzil qa aj Israel qe'xi'x mujqa kywitze'l kyib', aye': <verse number="60" style="v" />kyyajajil Delayiy, Tob'iy ex Nekoda, junk'al kab'lajnaq kab'lajoj (652) kyb'aj. <verse number="61" style="v" />Aye'tzu'n kywitze'l kyyajajilu' pale: Aye' kyyajajil Ob'ayiy, Kos ex B'arsilay, ju' mje tuk'i'l jun tmyal B'arsilay, aj Kalaad, ex ax tb'iju' oktq'o'n. <verse number="62" style="v" />Kyjoy ju'lu kyb'i toju' u'j jatz'ib'ana'qe' ojtxi' kyyajilb'en, tu'ntzu'n min knet kyu'n, eb'je'ltzuntz ti'ju' kyoklen te pale. <verse number="63" style="v" />Expe' tchaq'ju' kawil tu'n miche wana' ti'ju' wab'j xjan qa min xtma jun pale kyu'nel Urim ex Tumim.</para>
  <para style="p">
    <verse number="64" style="v" />Japun tajlalju' tnam toj jo'mutx' jok'al wajxaqlajnaq (42,360) kyb'aj, <verse number="65" style="v" />extzun wajxaqlajk'al qaqnaq wuqlajoj (7,337) kymajin lq'o'n, ichan ex qya. Ex ate'toq lajnaq (200) ky-ajb'itzal ichan ex qya. <verse number="66" style="v" />Ex ate'toq junk'al qaqlajnaq qaqlajoj (736) kyb'a'nchej, kab'lajnaq jwe' (245) kymul, <verse number="67" style="v" />junk'al junaq o'lajoj (435) kamey ex qaqlajk'al qaqlajnaq (6,720) b'ur. <verse number="68" style="v" />Ate' junjun nejenel kye junjun ja xjal, xikyq'o'n oyaj b'inchb'il teju' tja Dyos tej kypon toju' tja Qman Dyos toj Jerusalen. <verse number="69" style="v" />Kub' kyq'o'n lajoj kyintal tk'i' ch'inxmi oxe' rob' (10.73.6) q'anpwaq, oxnaq kyintal tk'i' nik'jan (60.5) saqpwaq, ex jo'naq (100) kyxb'alu pale ku'j, kse'nxju' tu'me'l kyu'n tu'n tjaw b'inchet jumajtlju' tja Dyos.</para>
  <para style="p">
    <verse number="70" style="v" />E'kyaj tenju' pale aj Leb'i ex junjun xjal aj tnam najal toj Jerusalen, exqe' aj b'itzal, xq'uqil ttzija exqe' ajb'el toj tja Dyos, aye'tzu'n txqantl aj Israel, e'kyajte kyojilex nimaqkytanam.</para>
  <chapter number="3" style="c" />
  <para style="s1">B'ajnk'et jumajtlju' k'u'lb'il</para>
  <para style="p">
    <verse number="1" style="v" />Tej tjapunju' twuqi'n xjaw, ex matxitoq b'entkyten aj Israel tojilex kynajb'il, b'aj kyb'u'yi'n kyib' tkyaqilju' tnam toj Jerusalen. <verse number="2" style="v" />Aye'tzu'n Joswe, tk'wal Josadak, kyuk'i'lu' paleju' tuk'i'l, ex Sorob'ab'el, tk'wal Salatyel, exqe' twitze'l, e'okten b'inchalte q'olb'eb'l te Qman Dyos, tu'n kykub' q'etju' chojb'il k'ok'sb'il tib'aj, ju' ntma'n toj tkawb'il Moyses tmajin Dyos. <verse number="3" style="v" />Jaw kyb'incha'n q'olb'eb'l axtzu' jatoq ta' nejtl, maskyepe' intoq che xob' kyeju' xjal najlqe' nqayin kyk'etz, ex intoq kub' kyq'o'n chojb'il k'ok'sb'il tib'aj atl prim ex atl qale te ninb'ilte Qman Dyos. <verse number="4" style="v" />Expe' kub'kyik'sa'n tq'ij pach xb'alun, kse'nx tz'ib'a'n toj kawb'il, ex kub' kyq'o'n chojb'il k'ok'sb'il tkyaqil q'ij kse'nxju' nb'inchet, kse'nxju' nkub' q'o'n atl junjun q'ij, <verse number="5" style="v" />kse'nqe' chojb'il k'ok'sb'il junjun q'ij ex te ak'a'j xjaw, kyexju' ninq'ij xjan te Qman Dyos, exju' nkub' tq'o'n junjun xjal tu'n tk'u'j te Qman Dyos. <verse number="6" style="v" />Tzyet tkub' kyq'o'n chojb'il k'ok'sb'il te Qman Dyos toj tnejel q'ij teju' twuqi'n xjaw, na'mxtoqpe' ttzyet tjaw b'incha'n jumajtlu' tja Qman Dyos. <verse number="7" style="v" />Xikyq'o'ntzun pwaqtz kye b'inchal ja ex aq'unal kyi'j tze, ex xikyq'o'n wab'j, k'wab'j ex aseyt kye xjal aj Tiro ex aj Sidon, tu'ntzun ttzaj kyiq'i'n tze k'ute tib'aj ninnjab', tzmax Lib'ano, tu'n tul Jope, kse'nxju' anb'il ojetoq taq' Siro, nimaqkawil aj Persya kye.</para>
  <para style="s1">Tzyet tjaw b'inchetl tja Dyos</para>
  <para style="p">
    <verse number="8" style="v" />Toj tkab' xjaw te tkab' ab'q'i kyulen toj Jerusalen, tzyet tjaw b'incha'n jumajtlu' tja Dyos kyu'n Sorob'ab'el tk'wal Salatyel, ex Joswe tk'wal Josadak, junx kyuk'i'lu' kyuk'i'l pale ex tyajajil Leb'i, kyuk'i'l kykyaqilju' b'je'xni qe'toq' iq'i'n ex e'ul jumajtl toj Jerusalen, kyej kyq'o'n tiq'jiju' aq'untl toj kyq'ob'u' aj Leb'i ik'ni kyab'q'i tib'aj winqi'n. <verse number="9" style="v" />Okkyb'u'yi'nkyib' Joswe kyuk'i'lju' tk'wal, e' ttzik ex titz'in junx k'loj kyuk'i'l Kadmyel kyuk'i'l tk'wal, tyajajil Judaqe', ex kyuk'i'lju' tyajajil Enadad, e'tk'wal, e'titz'in ex ttzik, aj Leb'iqe', tu'n tiq'et twitzju' aq'unal ti'j tja Dyos.</para>
  <para style="p">
    <verse number="10" style="v" />Tetzunj tkuxkyq'o'n b'inchal ja tq'uqlil tja Dyos, e'kub' we' pale, toktoq kyi'j ex iq'i'n kychun teju' ninq'ij lu. Iq'i'ntoq txijtxij ajwalb'ilte Qman Dyos kyu'n aj Leb'i tyajajil Asap, kse'nx tchaq' Dab'i, nimaqkawil toj Israel. <verse number="11" style="v" />Intoq che b'itzan junjun, aye'tzu'n junjuntl intoq xikytzaq'we'n: Kyq'onx chjonteye' te Qman Dyos, qu'n majx b'a'n te, qu'n tejumajxju' tk'u'jlalil ti'j Israel, chechij. Tkyaqiltzu'n tnam intoq jaw toj kywi' tu'n kytzalajb'il ex inche b'itzan te Qman Dyos, tu'nju' matxi'toq tzyet tb'inchanjtz jumajtlu' tja Dyos. <verse number="12" style="v" />Nimtzu'n pale, aj Leb'i ex nejenel kye k'loj kyyajajil, ti'jwnaqqe'tel, kyilju' tnejel tja Dyos, inxi'xtoq che oq' b'a'nxi'x tej tokkyk'a'yi'n intoq b'inchanjtz jumajtlu' tja Dyos. Ex ax kmoju', nim qe'toqtlju' nche ẍch'in tu'n tzalajb'il. <verse number="13" style="v" />Mixtoqti'x inel kynik'tzilju' tq'ojq'ojel wi'y injaw, alkyeqe'toq inche oq' ex alkyeqe'toq inche ẍch'in tu'n kytzalajb'il, qu'n inxi'xtoq jaw toj kywi' b'a'nxi'x, ex q'ojq'oj qe'toq najchaq.</para>
  <chapter number="4" style="c" />
  <para style="s1">Kub'toq kyxitu'n ajq'oj toju' aq'untl</para>
  <para style="p">
    <verse number="1" style="v" />Tetzunj kyb'inte' ajq'oj kyi'j aj Juda qa aye' b'je'xniqe' iq'i'n mache ul jumajtl, ntoq jaw kyb'incha'n jumajtlu' tja Dyos, <verse number="2" style="v" />eb'aj pon kyk'etz Sorob'ab'el ex Joswe ex kyk'etzju' nejenel kye junjun ja:</para>
  <para style="p">—Kyq'ome' anb'il tu'n qonine' kyuk'i'le' tu'n tjaw b'inchetlu' tja Dyos, qu'n ikxqe' nqo k'ulune' te Qman Dyos kse'nkye', ex nqo q'on chojb'ile' te atxi'x atitoq Esaradon, nimaqkawil aj Asirya, ju' tzaj q'inqeye' tzmax tzalu, chechij.</para>
  <para style="p">
    <verse number="3" style="v" />Atzunte Sorob'ab'el ex Joswe exqe' txqantl nejenel kye junjun ja Israel xikytzaq'we'n kye:</para>
  <para style="p">—Lay b'ent tjaw qb'incha'ntle' junx kyuk'i'le'. O'qo'kxqe' qo jawil b'inchante jumajtlu' tja Qman Dyos, qu'n iku' saj tma'n Siro, nimaqkawil toj Persya, qeye', chechij kye.</para>
  <para style="p">
    <verse number="4" style="v" />E'oktzun ten xjaltz najlqe' kyi'jile xob'tzalkyeju' xjal aj Juda tu'n mitxa' kyljo'n aq'untl. <verse number="5" style="v" />Expe' kub'kyi'j junjunju' nimaq kyoklen toju' kawb'il tu'n pwaq kyu'n, e'okmiltz'ujtzuntz ti'ju' tb'is kyk'u'j toj tkyaqilju' tq'ijlalil ten Siro nimaqkawil toj Persya, txmax toju' tq'ijlalil tkawin Dariy, nimaqkawil toj Persya.</para>
  <para style="s1">Tzaj wuljtib'il yajxi'tl tu'n tpaju' ntoq jaw b'inchetl nintapi</para>
  <para style="p">
    <verse number="6" style="v" />Tojtzun jun tq'ijlalil yajxi'tl tzmatoq ntzyet tkawin Aswer, xikytz'ib'a'n ajq'oj jun poqb'ilkye aj Juda ex aj Jerusalen twitz. <verse number="7" style="v" />Ikx toju' tq'ijlalil tten Artajerjes, nimaqkawil toj Persya, xikytz'ib'a'n B'islam, Mitridates, Tab'eel exqe'tzu'n txqantl kyuk'i'l, jun u'j te Artajerjes. Tz'ib'a'ntoq toj aramey, ex poq'i'n toj yol persa. <verse number="8" style="v" />Atzu'n Rewum, chaq'ultoq, ex Simsay, ju' tz'ib'al, xikytz'ib'a'n jun u'j taq'wix te nimaqkawil Artajerjes kyi'ju' xjal aj Jerusalen.</para>
  <para style="p">
    <verse number="9-11" style="v" />A u'j ja'lu xikytz'ib'a'n Rewum, chaq'ul, ex Simsay, tz'ib'al, exqe' kyuk'i'l ajkawilqe', e'nejenel kye xjal te q'oj exqe' nimaq kyoklen toj kykawb'il aj Persya, Erek, B'ab'ilon ex Susa, mujqa Elam, exqe' txqantl nimaqtnamju' eb'je'x tiq'i'n nimaqxjal Asnapar ex eb'aj kub' tq'o'n kyoju' nimaqtnam toj Samarya ex toju' txqantl tx'otx' toj tkub'exq'ij te nin a' Ewprates, intma'n kjalu:</para>
  <para style="b" />
  <para style="pi">Qman nimaqkawil Artajerjes, ayo'ye' ajb'el teya toju' tx'otx' toj tkub'exq'ij te nin a' Ewprates: <verse number="12" style="v" />Nxiqq'o'ne' tqanil teya nimaqkawil qa aye'ju' aj Juda oje che anjtz toj nintnam jata'ya, oje che pon toj Jerusalen ex ate'k b'inchalte jumajtl ma' nintnam pi's ex tx'yan tuk'i'l. Matxi' tzyet tjaw kyb'incha'n nintapi ti'j ex ate'k xk'ojilteju' tq'uqlil. <verse number="13" style="v" />Ex kxe'l qma'ne' teya nimaqkawil qama jaw b'incha'ntlju' nintnam lu exqa majawju' nintapi ti'j, lay kyaq'ju' xjal lu o'nb'il ex chojb'il ju' ilti'j tu'n kyq'onte, kb'eltzun tk'uwen kawb'iltz toj kub'l. <verse number="14" style="v" />Ajb'elqo' na'qe' teya nimaqkawil, min qajb'ile' tu'n mitxa' nima'na'ya. Qu'mtzun xxa' qsma'ne' tqanil lu teya nimaqkawil, <verse number="15" style="v" />tu'n t-xijyet tqanil kyoju' k'ub'l kyu'ju' ojtxi' tyajilb'ena nimaqkawil. Tu'ntzun tq'met qa matxi' tz'el tnik'a nimaqkawil qa njaw miltzuju' nintnam lu ex xob'ajilqe'x kyeju' nimaqkawil ex kyeju' najlqe' kyoju' txqantl tnej tx'otx', ex matxi' jawxi' kyiq'i'n kyib' kyoju' tq'ijlalil ojtxi', qu'mtzun kub'a' xitu'n. <verse number="16" style="v" />Qu'mtzun nxiqma'ne' teya nimaqkawil, qama jaw b'incha'n jumajtlju' nintnam lu, exqa mab'aj b'incha'ntlu' nintapi ti'j, lay b'entl tkawina nimaqkawil tib'aju' tx'otx' toj tkub'exq'ij teju' nin a' Ewprates, chiju' xikytz'ib'a'n.</para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" />Tzajtzun t-sma'n nimaqkawil Artajerjes tzaq'web'l te u'j lu kye:</para>
  <para style="b" />
  <para style="pi">Inche'x nq'olb'e'ne' Rewum, ju' chaq'ul, ex Simsay, tz'ib'al, exqe' kyuk'i'le' najlqe' toj Samarya ex toju' txqantl tx'otx' toj tkub'exq'ij teju' nin a' Ewprates:</para>
  <para style="b" />
  <para style="pi">ti'jtzunju' u'j <verse number="18" style="v" />tzaj kysma'ne' weye', oje jaw ẍch'i'n poq'b'ente nwitze', <verse number="19" style="v" />nchaq'e' tu'n tjyet tqanil. Matz'elyal qa intoq okmeltz'uju' nintnam lu kyi'ju' nimaqkawil ojtxi', ex matxi' che jawxi' miltz'uj nk'u'n kyten tuk'i'l kyxim taq'wix, <verse number="20" style="v" />ex e'ten nimaqkawil nim kyipumal toj Jerusalen, e'kawin kyib'aju' tx'otx' toj tkub'exq'ij te nin a' Ewprates, ex intoq q'onjtz chojb'il tuk'i'l oklenj kye. <verse number="21" style="v" />Qu'mtzun, kymanxe' kye' xjal lu tu'n lalun txikyljo'n aq'untl, ex tu'n lalun jaw b'inchetlu' nintnam lu tzmaxi'j ajtex nq'o'n juntl chaq'b'ile'. <verse number="22" style="v" />Kyka'yinxju'ye' lu, tu'n lalun chmetju' taq'wixil ti'ju' nkawb'ile', chi nimaqkawil.</para>
  <para style="p">
    <verse number="23" style="v" />Tetzunj tjaw ẍch'in tuj nimaqkawil Artajerjes, kywitz Rewum, Simsay ju' tz'ib'al, ex kywitzju' tuk'i'l, lwiyxi'x eb'ajx kykyaqilx toj Jerusalen, ilxi'xti'j kub'kymqo'n kywitzu' aj Juda tu'n twe' kyaq'unan.</para>
  <para style="s1">Xi'ljet tjaw b'inchetlu' tja Dyos<note caller="+" style="f"><char style="fr" closed="false">4.24 </char><char style="ft" closed="false">Nota: Esdras 4.6-23 Aju' tqanil ti'ju' aq'untl tu'n tb'inchetlju' tja Dyos kyej tenpuj kyoju' tqek' qaq ponx toj junaq oxe', atzu' nxa'ljeta'tl tzalu.</char></note></para>
  <para style="p">
    <verse number="24" style="v" />Iktzu'n, kyeja tene tjaw b'inchetlu' tja Dyos toj Jerusalen tzmaxi'j tjapun toj tkab' ab'q'i nkawin Dariy nimaqkawil toj Persya.</para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Xikyma'n t-sanjelal Dyos Akey ex Sakariy tk'wal Ido, kye aj Juda ex aj Jerusalen, ju' matxi'toq tzaj tma'n Qman Dyos kye. <verse number="2" style="v" />Aye'tzunkye Sorob'ab'el, tk'wal Salatyel, ex Joswe, tk'wal Josadak, eb'jo'kten jumajtl aq'unal tu'n tjaw b'inchetlu' tja Dyos toj Jerusalen, ex ate'toqju' t-sanjelal Dyos onilkye. <verse number="3-4" style="v" />Atzunte Tatenay, kawil toju' tx'otx' tkub'exq'ij te nin a' Ewprates, ex Setar-b'osnay exqe' kyuk'i'l, e'pon q'malte kye toj Jerusalen: ¿Alkyetzu'n xq'mante kyeye' tu'n tjaw b'inchetlu' ja te k'u'lb'il lu, ex tu'n tjawx kyq'o'ne' tz'len tib'aj? ¿Titi' kyb'iju' xjal nche jaw b'inchante jumajtju' tja Dyos lu? chechij. <verse number="5" style="v" />Atzunte Dyos kolon kyi'ju' nejenel kye aj Juda, qu'mtzun mixti'x e'myet ti'ju' aq'untl, tzmaxi'j txi' tqanil te Dariy ex tu'n tulju' tzaq'web'l tu'n.</para>
  <para style="p">
    <verse number="6" style="v" />Ajun tilb'ilal u'j ja'lu xikytz'ib'a'n Tatenay, kawil toju' tx'otx' tkub'exq'ij te nin a' Ewprates, ex Setar-b'osnay exqe' kyuk'i'l, nim kyoklen toju' kawb'il tkub'exq'ij te nin a' Ewprates, ju' xikysma'n te nimaqkawil Dariy, <verse number="7-8" style="v" />intma'n ikjalu:</para>
  <para style="b" />
  <para style="pi">Nxi qq'olb'e'nq nimaqkawil, b'a'nwt ta'ya toj tchwinqlala, nxiqq'o'ne' tqanil teya, oxt'anje' toju' tx'otx' Juda, ljo'n tb'inchanjtz jumajtl tjaju' Dyos nimxi'x toklen kyu'n txqan ab'j jso'n kywitz. Atzuntl ja'lo ljo'n tktxunjtzu' tapi tu'n tz'lan, inxi'x oktilil kyu'n ex lwiyxi'x nxilq'eju' aq'untl ti'j. <verse number="9" style="v" />Xiqqani'ne' kyeju' kynejel aj Juda alkye xq'mante kye tu'n tjaw kyb'incha'n jumajtlju' tja Dyos, ex tu'n tb'aj kyktxu'n tu'n tz'lan, <verse number="10" style="v" />ex ti'ti' kyb'iju' xjal q'ilte twitzju' aq'untl lu, tu'n tku'x tz'ib'itju' kyb'i ex tu'n t-xiq'met teya nimaqkawil. <verse number="11" style="v" />Aye'tzunkye tzaj kytzaq'we'n qa nche niman te Dyos te toj kya'j ex twitz tx'otx', qu'mtzun ljo'n tjaw kyb'incha'n jumajtlu' tja Dyos matxi' b'et b'a'npun ab'q'i tjawlen tb'incha'n jun nin kynimaqkawil aj Israel. <verse number="12" style="v" />Ex kyma qa okkyq'o'n ojtxi' kyyajilb'en ttx'u'jil Dyos te toj kya'j, ex a Dyos kub'q'o'nkye toj tq'ob'u' nimaqkawil Nab'ukodonosor toj B'ab'ilon, aj kaldeytoq, ju' kub' xitunteju' ja te k'u'lb'il lu, ex eb'ax tiq'i'n tzmax B'ab'ilon. <verse number="13" style="v" />Yajxi'tzuntel, tchaq' Siro, toju' tnejel ab'q'i nkawin toj B'ab'ilon, tu'n tjaw b'inchet jumajtlju' tja Dyos.</para>
  <para style="p">
    <verse number="14" style="v" />Ex kymatl qeye' qa eb'je'tz tiq'i'n nimaqkawil Siro aq'unb'il q'anpwaq ex saqpwaqqe' toju' ja te k'u'lb'il toj B'ab'ilon, ju' eb'je'tz tiq'i'n Nab'ukodonosor toju' tja Dyos toj Jerusalen ex b'aj pon tiq'i'n toju' ja te k'u'lb'il B'ab'ilon, exqa e'xitq'o'n te Sesb'asar, ju' ojetoq tz'oktq'o'n te kawil.</para>
  <para style="p">
    <verse number="15" style="v" />Tchaq' Siro te Sesb'asar tu'n kytzaj tiq'i'nju' aq'unb'il lu ex tu'n kyul tq'o'n jumajtl toju' tja Dyos toj Jerusalen, ex tu'n tjaw tb'incha'n jumajtlju' tja Dyos. <verse number="16" style="v" />Tetzunj tul Sesb'asar ex eku'x tq'o'n tq'uqlilju' tja Dyos toj Jerusalen; atxi'xtzu'n tzyet tjaw b'inchet jumajtlu' tja Dyos, ex na'mx tb'ent ja'lo, chechij qeye'.</para>
  <para style="p">
    <verse number="17" style="v" />Atzu'n ja'lo, qama kub' toj twitza nimaqkawil, inxiqqani'ne' tu'n tjyontz kyoju' k'ub'l tu'j nimaqkawil toj B'ab'ilon, ex tu'n tka'yit qa ax qa tchaq' nimaqkawil Siro tu'n tjaw b'inchet jumajtlju' tja Dyos toj Jerusalen, ex tu'n ttzaj tma'na t-xima nimaqkawil tib'aj ja'lu, chiju' xikytz'ib'a'n.</para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tchaq'tzu'n nimaqkawil Dariy tu'n tjyonjtz kyoju' k'ub'l u'j janche k'u'njtza'ju' u'j nim kyoklen toj B'ab'ilon, <verse number="2" style="v" />eltzun yal jun u'j toju' ja te kawb'il toj Ekb'atana, toju' tx'otx' Medya, ja tz'ib'a'na' kjalu:</para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" />Etztq'o'n nimaqkawil Siro chaq'b'il lu, toju' tnejel ab'q'i nkawin, chij kjalu:</para>
  <para style="pi">Ti'ju' tja Dyos toj Jerusalen: ati tu'n kyku'x q'etju' tq'uqlil ex tu'n tjaw b'inchet jumajtlju' ja, tu'n kykub' kyq'o'n xjal chojb'il atzu'. Ati tu'n tkub' junaq wuq (27) metr twe' ex junaq wuq (27) twitz; <verse number="4" style="v" />tuk'i'l oxe' txol ab'j nimaq kypimal ex jun txol ak'a'j tze. Aju' tk'uwen nimaqkawil kchjolteju' kb'ajel ti'j. <verse number="5" style="v" />Aye'tzu'n aq'unb'il q'anpwaqqe' ex saqpwaqqe' toju' tja Dyos, ju' b'je'tztiq'i'n Nab'ukodonosor toju' tja Dyos toj Jerusalen, ex eb'ju'l tiq'in B'ab'ilon, tu'ntanjl anjsetlkyi'j ex tu'n kyxi' iq'et toj Jerusalen, ex tu'n kyokxq'et to'ju' tja Dyos, jaxu' te'qe'toq, chiju' chaq'b'il tz'ib'a'n.</para>
  <para style="p">
    <verse number="6" style="v" />Etztzun tq'o'n nimaqkawil Dariy chaq'b'il lu te Tatenay, kawil toju' tx'otx' toj tkub'exq'ij te nin a' Ewprates, ex te Setar-b'osnay ex kyeju' kyuk'i'l, nim kyoklen toju' kawb'il tojxju' t'xotx' lu:</para>
  <para style="b" />
  <para style="pi">Kukyetze' toj Jerusalen <verse number="7" style="v" />ex kq'onxe' anb'il teju' kawil kye aj Juda ex kyeju' nejenel kyxol tu'n tjaw kyb'incha'n jumajtlju' tja Dyos toju' tkub'el. <verse number="8" style="v" />Aye' nchaq'b'il ju'ye' lu tu'n kyonetju' nejenel kye aj Juda tu'n tjaw b'inchet jumajtlu' tja Dyos: Tu'n kychjetju' nb'aj ti'ju' aq'untl lu tojxi'x tq'ijlalil kyu'nju' chojb'il njaw b'uyet teju' kawb'il toju' tx'otx' toj tkub'exq'ij te nin a' Ewprates, tu'n mi kyeja' teneju' aq'untl. <verse number="9" style="v" />Ex tu'n kyxi' q'et ilxi'xti'j tkyaqil q'ij titi' makyqaniju' pale toj Jerusalen, tkyaqilju' nojqelan, qa e'qpoj tma'n wakx, e'tman rit mo qpoj tman rit te chojb'il k'ok'sb'il teju' Qman Dyos te toj kya'j; mujqa triy, atz'an, b'in mo aseyt, <verse number="10" style="v" />tu'n kyq'onte chojb'il k'ok'j te Dyos te toj kya'j ex tu'n kykub'san twitz Dyos tib'aju' nchwinqlale' ayine' nimaqkawil ex tib'aj kychwinqlalju' nk'wale'. <verse number="11" style="v" />Ex majx kxe'l nma'ne' qa ati jun min xtb'inchaju' nchaq'b'ile' lu, k'eletz qitpet jun tptz'o'milu' tja ex kb'ajel jumet toj; ex majx kjel xitetju' tja. <verse number="12" style="v" />¡Ex awtju' Dyos jaw sk'onte Jerusalen jatu'n ttzaja' na'n tb'i, kub' xitunte alkyexku' nimaqkawil mujqa nimaqtnam, qama tz'oktq'o'ntib' maqul mujqa xitul ti'ju' tja Qman Dyos ati toj Jerusalen! Ayine', Dariy, ẍin q'onteju' chaq'b'il lu. Japunx kyu'ne' kse'nxju' xb'ajx ntz'ib'a'ne', chiju' tchaq'b'il nimaqkawil.</para>
  <para style="s1">Xiljo'n aq'untl ex japunb'aj</para>
  <para style="p">
    <verse number="13" style="v" />Kyb'inchatzu'n Tatenay, kawil toju' tx'otx' toj tkub'exq'ij te nin a' Ewprates, ex Setar-b'osnay exqe' kyuk'i'l, kse'nxju' tchaq' nimaqkawil Dariy. <verse number="14" style="v" />Iktzu'n b'enta' txi' kyljo'n nejenel kye aj Juda aq'untl tu'n tjaw b'inchet jumajtlju' tja Dyos, kse'nx kymaju' t-sanjelal Dyos Akey ex Sakariy, tk'wal Ido. Ex japunb'aj tb'inchet jumajtlju' tja Dyos kse'nxju' tchaq' Qman Dyos ex kse'n kychaq' Siro, Dariy ex Artajerjes, nimaqkawil aj Persya. <verse number="15" style="v" />Japunb'aj tb'inchetju' tja Dyos toj oxe' tajlal xjaw Adar, toj twaqaqi'n ab'q'i nkawin Dariy, nimaqkawil aj Persya.</para>
  <para style="p">
    <verse number="16" style="v" />Kub' kytzalajsa'n aj Israel, e'pale, tyajajil Leb'i exqe' txqantl b'je'xni qe'toq iq'i'n, tej tkub' xjansetju' tja Dyos. <verse number="17" style="v" />Kub' kyq'o'n jo'naq (100) qpoj tman wakx te chojb'il toju' q'ij lu, ex lajnaq (200) tman rit ex junk'al (400) qpoj tman rit, extzun kab'lajoj (12) chib', jun tu'n junjun tnej tyajajil Israel, te oyaj tu'n tpaj kyil kykyaqil aj Israel. <verse number="18" style="v" />Ekub'tzun kyq'o'n pale toj k'loji'n tu'n kych'exb'ente kyib', exqe' aj leb'i tojilex kyaq'un, tu'n kyajb'en toju' k'u'lb'il te Dyos toj Jerusalen, kse'nxju' tz'ib'a'n toju' tuj Moyses. <verse number="19" style="v" />Expe' kub'kyik'sa'n b'je'xniqe'toq iq'i'n Tq'ij Tzaqpib'l toj kyajlajoj (14) tajlal tnejel xjaw. <verse number="20" style="v" />Matxitoq b'aj kyẍtilsa'n kyib'ju' pale ex aj Leb'i, qu'mtzun ẍtilsa'ntltoq kyib' twitz Dyos. Kub'tzun kyq'o'n chojb'il te Tq'ij Tzaqpib'l kye kykyaqilju' b'je'xniqe'toq iq'i'n, kyex ex kyeju' pale kyuk'i'l. <verse number="21" style="v" />Kykyaqilu' aj Israel exniqe'toq iq'i'n ex eb'ju'l jumajtl, e'wan ti'ju' wab'j te Tzaqpib'l, junx kyuk'i'lju' ojetoq tz'el kypa'n kyib' ti'ju' taq'wix kyb'inchb'aju' nimaqtnam min nche niman te Dyos, ex kymujb'a kyib' kyuk'i'l toju' k'u'lb'il te Qman Dyos. <verse number="22" style="v" />Wuq q'ij kub'kyik'sa'n tq'ij wab'j mixti' ttx'amal tuk'i'l tzalajb'il, qu'n ojexi'x che tzalaj tu'n Qman Dyos tu'nju' tb'incha tq'onte tib'ju' nimaqkawil aj Persya kyuk'i'l ex matz'onin kyi'j tu'n tjw b'inchet jumajtlju' tja Qman Dyos.</para>
  <chapter number="7" style="c" />
  <para style="s1">Eb'ju'l Esdras kyuk'i'lju' tuk'i'l toj Jerusalen</para>
  <para style="p">
    <verse number="1" style="v" />Yajxi'tzuntel, toju' tq'ijlalil nkawin Artajerjes, nimaqkawil aj Persya, ten jun xjal Esdras tb'i, tk'wal Serayiy, tk'wal Asariy, tk'wal Ilkyiy, <verse number="2" style="v" />tk'wal Salum, tk'wal Sadok, tk'wal Aytub', <verse number="3" style="v" />tk'wal Amariy, tk'wal Asariy, tk'wal Merayot, <verse number="4" style="v" />tk'wal Serayiy, tk'wal Usi, tk'wal B'ukyi, <verse number="5" style="v" />tk'wal Ab'isuwa, tk'wal Pinees, tk'wal Eleasar tk'wal Aaron, ju' tnejel pale. <verse number="6" style="v" />Aju' Esdras jun xnaq'tzaltoq, xnaq'tza'nxi'x ti'ju' tkawb'il Qman Dyos tzaj tq'o'n te Moyses, ex q'o'ntoq tipumal tu'n Qman Dyos, qu'mtzun tzaj tq'o'n nimaqkawil Artajerjes te tkyaqilju' xitqani'n. Iktzu'n anjtza'kyi'j Esdras B'ab'ilon <verse number="7" style="v" />ex e'pon toj Jerusalen toju' twuqi'n ab'q'i nkawin Artajerjes, kyuk'i'l jun b'yuj aj Israel, ate' pale kyxol, e'aj leb'i, e'aj b'itzal, e'xq'uqil ttzija ex e'ajb'el toj tja Dyos. <verse number="8-9" style="v" />Tu'nju' to'nb'il Dyos ti'j Esdras, tzyet b'e tu'n kyetz toj B'ab'ilon toj tnejel q'ij teju' tnejel xjaw te twuqi'n ab'q'i nkawin Artajerjes, ex e'pon toj Jerusalen toju' tnejel q'ij te tjwe'yi'n xjaw texju' ab'q'i lu. <verse number="10" style="v" />Atitoq tb'is tk'u'j Esdras tu'n t-xnaqtzante tkawb'il Qman Dyos ex tu'n tb'inchante, ex tu'n tb'ajx t-xnaq'tza'n tkawb'il Dyos ex tnuk'b'il kye aj Israel.</para>
  <para style="p">
    <verse number="11" style="v" />A tilb'ilal u'j ja'lu tzaj tq'o'n nimaqkawil Artajerjes te Esdras, ju' pale ex xnaq'tzal, xnaq'tza'n b'a'nxi'x ti'j tkyaqilju' tchaq'b'il ex tkawb'il Qman Dyos:</para>
  <para style="b" />
  <para style="pi">
    <verse number="12" style="v" />Ayine' ninimaqkawil Artajerjes, nxinq'olb'e'na' Esdras, pale ex xnaq'tzal, xnaq'tza'na b'a'nxi'x ti'ju' tkawb'il Dyos toj kya'j.</para>
  <para style="pi">
    <verse number="13" style="v" />Matxi' nchaq'e qa ate' aj Israel toju' nkawb'ile' kyajb'il tu'n kyxi' Jerusalen tuk'i'la, b'a'n tu'n kyxi', exqa aj Leb'i mujqa pale. <verse number="14" style="v" />Qu'n ayine' nimaqkawil kyuk'i'lju' wuq q'ol nab'l nqo'x chq'onteya ka'yilte qa nkyb'incha'n xjal toj Juda ex toj Jerusalen, kse'nx tkawb'il Dyos ojtzqi'n b'a'nxi'x tu'na. <verse number="15" style="v" />Q'inxa saqpwaq ex q'anpwaq nxiqq'o'ne' tu'n qk'u'je', ayine' nimaqkawil exqe' q'ol nab'l, teju' Kydyos aj Israel, ju' ati toj Jerusalen. <verse number="16" style="v" />Tkyaqiltzu'n saqpwaq ex q'anpwaq qama knet tu'na toj tkyaqilju' tx'otx' B'ab'ilon, tuk'i'lju' oyaj qa makyaq'ju' tnam kyuk'i'lju' pale tu'n kyk'u'j teju' tja Dyos toj Jerusalen. <verse number="17" style="v" />K'ajb'el tu'na tu'n kylq'et qpoj tman wakx, tman rit, ex qpoj tman rit, junx kyuk'i'lju' kyoyaj twitz awal k'ok'e'kywitz ex b'in, tu'n kykub' q'et tib'aju' q'olb'eb'l toju' ja te k'u'lb'il teju' Dyos nche k'ulune' te toj Jerusalen. <verse number="18" style="v" />Atzu'n q'anpwaq ex saqpwaq qa min xb'aj, axi'x titi' k'okyila' kyu'ne' kyuk'i'lju' tuk'i'la, kse'nxju' tajb'il Dyos. <verse number="19" style="v" />Aye'tzu'n aq'unb'il ẍe'x q'o'n teya tu'n kyajb'en te k'u'lb'il toj tja Tdyosa, q'onxa te Dyos toj Jerusalen.</para>
  <para style="pi">
    <verse number="20" style="v" />Alkyexku' juntl ti'xti' tu'n tq'o'n teya toju' tja Tdyosa nk'uluna te, b'a'n tu'n tjyonteya kyoju' k'ub'l toj kawb'il. <verse number="21" style="v" />Ayine', nimaqkawil Artajerjes, manchaq'e' kye kykyaqilju' k'u'l pwaq toj tkub'exq'ij te nin a' Ewprates, tu'n txikyq'o'n ilxi'xti'j teya tkyaqilju' matqaniya, aya Esdras, pale ex xnaq'tzal, xnaq'tzanxi'xa toju' tkawb'il Dyos te toj kya'j, <verse number="22" style="v" />tzmax toj oxnaq kab'lajoj kyintal tk'i' oxnaq lib'r (72.60) saqpwaq, kab'mutx' o'lajk'al (22,000) litr triy, jok'al lajnaq (2,200) litr b'in, jok'al lajnaq (2,200) aseyt ex tkyaqil jni'xku' atz'an matqaniya.</para>
  <para style="pi">
    <verse number="23" style="v" />Lwiyxi'x tu'n txiq'o'n tkyaqilju' ktqani' Dyos toj kya'j ti'ju' tja te k'u'lb'il, tu'ntzun mitzaja' jun yajb'il kyib'aju' nk'wale' ex kyib'aju' tnam ate'qe' tjaq' nkawb'ile'. <verse number="24" style="v" />Expe' b'a'n tu'n kyb'inteye' qa q'ma'n toj kawb'il tu'n lalun qanet o'nb'il chojb'il mo oklenj kye alkyexku' pale, aj Leb'i, aj b'itzal, xq'uqil ttzija, ajb'el toju' ja te k'u'lb'il mujqa alkyexku' junxi'tl xjal najb'en toj tja Dyos.</para>
  <para style="pi">
    <verse number="25" style="v" />Atzunta Esdras, q'onqe'ka ajkawil ex kawil, kse'nxju' ojtzqib'l tzajni tq'o'n Dyos teya, tu'n kyb'inchante tnik'alilti'j kye kykyaqilu' xjal toju' tx'otx' toj tkub'exq'ij te nin a' Ewprates, aye' kykyaqilju' kyojtzqi'n tkawb'ilu' Dyos ntnima'na; aye'tzu'n min kyojtzqi'n xnaq'tzanxa kye. <verse number="26" style="v" />Kykyaqiltzu'n qa min xjapun tkawb'il Tdyosa kyu'n, exqe' nkawb'ile' ayine' nimaqkawil, lwiyxi'x ktchja' tu'n tkub' b'yet, mo k'elex xla'jet, mo ktchja' tu'n pwaq mo k'okyex jpet, chiju' xittz'ib'a'n Artajerjes te Esdras.</para>
  <para style="s1">Tna'j Dyos Esdras</para>
  <para style="p">
    <verse number="27" style="v" />Atzunte Esdras na'n Dyos ikjalu: Nimanjtzxwitju' Qman Dyos Kydyos ojtxi' qyajilb'ene', qu'n mataq' tipumalu' nimaqkawil tu'n tjaw tnima'n tja te k'u'lb'il toj Jerusalen, <verse number="28" style="v" />ex matye'k'uju' t-xtalb'il weye' twitzku' nimaqkawil kyuk'i'lju' q'ol nab'l te, exqe' xjal nimxi'x kyoklen toju' kawb'il, ex matzaj tq'o'n wipumale', qu'n machin toniye' tu'n tb'ent kyb'u'yetju' nimaqxi'x kyoklen kyxol aj Israel tu'n kyanj wuk'i'le', chij.</para>
  <chapter number="8" style="c" />
  <para style="s1">Kyajlalju' Anjtzkyi'j B'ab'ilon</para>
  <para style="p">
    <verse number="1" style="v" />A kyb'i nejenel ja'lu, kse'nxju' tku'x toju' u'j ja tz'ib'a'na' kyb'i tojile tja junjun, ju' anjtzkyi'j B'ab'ilon tuk'i'l Esdras tej intoq kawin Artajerjes:</para>
  <para style="q">
    <verse number="2-3" style="v" />Werson, kyxol tyajajil Pinees;</para>
  <para style="q">Danyel, kyxol tyajajil Itamar;</para>
  <para style="q">Atus, tk'wal Sekaniy, kyxol tyajajil Dab'i;</para>
  <para style="q">Sakariy, kyxol tyajajil Paros, kyuk'i'l wuqnaq lajoj (150) xjal tz'ib'a'nqe' toju' kyajlal;</para>
  <para style="q">
    <verse number="4" style="v" />Elyeoenay, tk'wal Serayiy, kyxol tyajajil Paat-moab', kyuk'i'l lajnaq (200) xjal;</para>
  <para style="q">
    <verse number="5" style="v" />Sekaniy, tk'wal Jaasyel, kyxol tyajajil Satu, kyuk'i'l o'lajnaq (300) xjal;</para>
  <para style="q">
    <verse number="6" style="v" />Eb'ed, tk'wal Jonatan, kyxol tyajajil Adin, kyuk'i'l kab'naqlajoj (50) xjal;</para>
  <para style="q">
    <verse number="7" style="v" />Isayiy, tk'wal Ataliy, kyxol tyajajil Elam, kyuk'i'l oxnaq lajoj (70) xjal;</para>
  <para style="q">
    <verse number="8" style="v" />Seb'adiy, tk'wal Mikael, kyxol tyajajil Sepatiy, kyuk'i'l kyajnaq (80) xjal;</para>
  <para style="q">
    <verse number="9" style="v" />Ab'diy, tk'wal Jeyel, kyxol tyajajil Joab', kyuk'i'l lajnaq wajxaqlaj (218) xjal;</para>
  <para style="q">
    <verse number="10" style="v" />Selomit, tk'wal Josipiy, kyxol tyajajil B'ani, kyuk'i'l wajxaqnaq (160) xjal;</para>
  <para style="q">
    <verse number="11" style="v" />Sakariy, tk'wal B'eb'ay, kyxol tyajajil B'eb'ay, kyuk'i'l junaq wajxaq (28) xjaq;</para>
  <para style="q">
    <verse number="12" style="v" />Joanan, tk'wal Akatan, kyxol tyajajil Askad, kyuk'i'l, jo'naq lajoj (110) xjal;</para>
  <para style="q">
    <verse number="13" style="v" />Elipelet, Jeyel ex Semayiy, mank'b'il tyajajil Adonikam qe', kyuk'i'l oxnaq (60) xjal, e'anjtz yajxi'tl.</para>
  <para style="q">
    <verse number="14" style="v" />Utay ex Sab'ud, kyxol tyajajil B'iwb'ay, kyuk'i'l oxnaq lajoj (70) xjal.</para>
  <para style="s1">Ajb'el toju' Ja te k'u'lb'il</para>
  <para style="p">
    <verse number="15" style="v" />Ayine', Esdras, inb'uyinkye kykyaqilju' xjal lu ttziju' tb'e a' inpon toju' nin a' Aab'a, ex o'kub'ten oxe' q'ije' atzu'. Tetzunj kyb'aj nka'yi'ne' xjal ex pale, mixti' elyal jun aj Leb'i kyxol wu'ne'. <verse number="16" style="v" />Qu'mtzun exi' nchq'one' Elyeser, Aryel, Semayiy, Elnatan, Jarib', Elnata, Natan, Sakariy ex Mesulam, ju' nimaq kyoklen, exqe' xnaq'tzal Joyarib' ex Elnatan, <verse number="17" style="v" />tu'n kyxi' nenulte Ido, nejenel toju' najb'il Kasipya, ex b'ajx nma'ne' kye titi'toq tu'n txikyma'n te Ido ex kyeju' kyuk'i'l, aye' ajb'el toj tja Dyos ate'toq toj Kasipya, tu'n kytzaj kyiq'in xjal onilqeye' toju' tja Qman Dyos. <verse number="18" style="v" />Ex chjonte te Dyos, ul kyiq'in jun ichan atixi'x b'a'n tu'n, Sereb'iy tb'i, tyajajil jun aj leb'i Mali tb'i, wajxaqlajoj (18) kyb'aj kyuk'i'lxi' tk'wal e' ttzik ex titz'in. <verse number="19" style="v" />Expe' eb'ju'l kyiq'i'ntlju' Asab'iy ex Isayiy, tyajajil Merari qe', junaq (20) kyb'aj kyuk'i'lxi' kyk'wal e'kyitz'in ex kytzik.</para>
  <para style="p">
    <verse number="20" style="v" />Aye'tzu'n ajb'el toj tja Dyos okniqe' tq'o'n Dab'i exqe' nejenel onilkye aj Leb'i, junlajnaq (220) kyb'aj.</para>
  <para style="p">
    <verse number="21" style="v" />Yajxi'tzuntel nmaye' tu'n tok jun mewayi'n ttziju' nin a' Aab'a, tu'ntzun tok qq'o'ne' qile qi'je' twitz Qman Dyos, ex tu'n txi' qqani'ne' te tu'n qtzajtiq'i'ne' toj tzalajb'il toju' qb'eye' kyuk'i'lju' toj qjaye' exqe' ti'xti' qeye'. <verse number="22" style="v" />Qu'n inch'ixwiye' tu'n kyxinqani'ne' xjal te q'oj kyuk'i'lxi' kychej teju' nimaqkawil tu'n kytzaj tq'o'n xq'uqil qe'ye' kye ajq'oj toj b'e, qu'n ojetoqna' txiqma'ne' teju' nimaqkawil qa ate Dyos xq'uqilkyeju' nche niman te, aye'tzu'n mache kyej kolb'ente intzaj tq'o'n tipumal ex ttx'u'jil kyib'aj. <verse number="23" style="v" />Ikytzu'n omewayine' ex o'kub'sane' te Dyos tib'aj tkyaqil ja'lu, ex otzaj tb'i'ne'.</para>
  <para style="p">
    <verse number="24" style="v" />E' jawtzun nsk'o'ne' kab'lajoj (12) nuk'ul kyeju' pale: aye' Sereb'iy, Asab'iy ex lajojtl kyuk'i'l, <verse number="25" style="v" />b'ajtzun nmlo'ne' saqpwaq, q'anpwaq exqe' aq'unb'il e'tzaj tq'o'n nimaqkawil kyuk'i'lju' q'ol tnab'l exqe' ajb'el te, ex tkyaqilju' tzaj kyq'o'n aj Israel ate'toq atzu' te oyaj ti'ju' tja Dyos, ex b'ajx nq'o'ne' kyeju' eb'jaw nsk'o'ne'. <verse number="26" style="v" />B'aj nmlo'ne' ex xinq'o'ne' junk'al oxnaq junlajoj kyintal tk'i' kyajnaq lajoj lib'r (471.90) saqpwaq, jo'naq (100) aq'unb'il saqpwaqqe', ex oxnaq kab'lajoj kyintal tk'i' oxnaq lib'r (72.60) q'anpwaq; <verse number="27" style="v" />expe' junaq (20) laq q'anpwaqqe', masch'i'n wuqlajoj lib'r tk'i' nik'jan kyalal, ex kab'e' aq'unb'il q'ank'uxb'il b'incha'nqe' tb'anilxi'x, twi' wi'yal naku'j q'anpwaq.</para>
  <para style="p">
    <verse number="28" style="v" />Xi'tzun nma'ntle' kye: Xjansa'n qe'kye' twitz Qman Dyos, kse'nxqe' aq'unb'il. Te Qman Dyos qekye' saqpwaq ex q'anpwaq, aju' Dyos eniman ojtxi' qchman te. <verse number="29" style="v" />Ape' kyka'yi'xe' b'a'nxi'x ex kyk'u'nxe' tzmaxi'j ajkykub' kymlo'ne' kywitzju' kynejel pale, ex kywitz aj Leb'i ex nejenel kye toj kyja aj Israel, kyoju' ja ti'j tja Qman Dyos toj Jerusalen, nchije'. <verse number="30" style="v" />Xi'tzun kyk'mo'n pale ex aj Leb'i saqpwaq, q'anpwaq exqe' aq'unb'il ju' matxi'toq b'aj mlo'n, xikyiq'i'ntzuntz Jerusalen, toju' tja Qman Dyos.</para>
  <para style="p">
    <verse number="31" style="v" />O ik'tzun b'ettze' ttziju' nin a' Aab'a, toj tkab'lajoji'n (12) tajlalju' tnejel xjaw, tu'n qule' Jerusalen. Ate Qman Dyos oninqeye', o'tkole' kye ajq'oj ex kye eleq' toj b'e. <verse number="32" style="v" />Tetzunj qule' toj Jerusalen o'ojlan oxe' q'ije'. <verse number="33" style="v" />Tojtzu'n tkyaji'n q'ij b'ajkub' mlrtju' saqpwaq, q'anpwaq exqe' aq'unb'il toju' tja Qman Dyos, b'ajx q'ettzuntz tkyaqil teju' pale Meremot, tk'wal Uriy. Atitoq Eleasar tk'wal Pinees tk'etz, exqe' aj Leb'i Josab'ad tk'wal Joswe, ex Noadiy tk'wal B'inuy. <verse number="34" style="v" />B'aj mlet ex b'aj ajlet tkyaqilju' iqtz texju' q'ij lu, ku'x tz'ib'ettzuntz toj jun u'j.</para>
  <para style="p">
    <verse number="35" style="v" />Yajxi'tzuntl, b'ajx kyq'o'n xjal, ju' anjtzkyi'j B'ab'ilon, chojb'il k'ok'sb'il te Qman Dyos, ex xikyq'o'n kab'lajoj (12) qpoj tman wakx, kyajnaq qaqlajoj (96) tman rit, oxnaq wuqlajoj (77) qpoj tman rit ex kab'lajoj (12) tman chib' toj kyb'i kykyaqil aj Israel, te oyaj tu'n tpaju' kyil. Kykyaqil e'kub' tz'e'ysa'n ninb'ilte Qman Dyos. <verse number="36" style="v" />Xi'tzun kyq'o'n tchaq'b'il nimaqkawb'il kyeju' ati kyoklen toju' kawb'ij ex kyeju' kawil toju' tx'otx' tkub'exq'ij te nin a' Ewprates, ex e'onin ti'ju' tnam ex ti'ju' tja Dyos.</para>
  <chapter number="9" style="c" />
  <para style="s1">Kyilju' tnam ex tna'j Dyos Esdras</para>
  <para style="p">
    <verse number="1" style="v" />Tb'ajlenxi'tzun ja'lu, e'ul lq'eju' kynejel pale q'malte weye' ikjalu: Mya pa'nkyib'ju' aj Israel, exqe' pale kyuk'i'l aj Leb'i, kyi'ju' xjal najlqe' toju' tx'otx' lu, aye' aj Kanaan, itit, peresey, jeb'usey, amonit, aj Moab', aj Ejipt ex amorey, tu'npetzu'n taq'wixi'x kyb'inchb'aju' xjal na'j. <verse number="2" style="v" />Matxi' che b'ajmje exqe' kyk'wal kyuk'i'l kymyalju' xjal lu; qu'mtzun, matxi' b'aj kysmo'n kyib'ju' ttanam Dyos kyuk'i'lju' xjal te junxi'tl tnam. Aye'ku'pe' nejenel exqe' kawil ẍekub'nej b'inchalteju' il lu, chechij.</para>
  <para style="p">
    <verse number="3" style="v" />Tetzunj nb'inteju'ye' yol lu, kub'nlaqu'ne' wi'je', kub' ntzuqi'ne' nwi'ye' ex nxmatziye' te yek'b'il k'ixk'oj, ex nkub' qeye' numjniqinxi'xe'. <verse number="4" style="v" />Kykyaqilju' intoq che xob' teju' tz'e'ysb'il witzb'aj tu'n Qman Dyos, tu'n tpaj kyilju' ojetoq che ul jumajtl, b'aj kyb'u'yi'n kyib' nk'etze'; ayintzunwe' q'uqlqinxtoqe' numjni qine' tzmax tponju' kmuj tu'n kykub'q'et chojb'il te qale. <verse number="5" style="v" />Atzun kmoju' okjumajtl wipumale', noktene' k'ulul te Qman Dyos tuk'i'lxi' wi'je' ẍla'q, <verse number="6" style="v" />xinma'ne' te Dyos: Nman Dyos, nchin ch'ixwi'ye' ex min nkane toj nwitze' tu'n nyoline' tuk'i'la. Matxi' chmet txqan qile' nimxi'x, exu' qpaje' njapun toj kya'j. <verse number="7" style="v" />Matxi' b'et-xi' ab'q'i ex ljo'nx qanq'ine' ja'lo toju' il. Oje qo'x q'o'ne' tjaq' kykawb'il nimaqkawil kye txqantl tx'otx', tu'n tpaju' qb'inchb'ene' myab'a'n, e'qile' ex kyilu' qnimaqkawile' exqe' pale qxole'. Matxi' qo' b'aj k'ixb'iye', maqo' ex iq'i'ne' toj qtx'otx'e', matz'el iq'i'n tkyaqil qe'ye' ex maqo'el ik'u'ne', ex ato'xe' ja'lo toju' yajb'il qe'ye' lu. <verse number="8" style="v" />Atzu'n ja'lo, Nman Dyos, tu'nju t-xtalb'ila maq'onjtz tzaqpib'l kye jun k'loj quk'i'le' ex matzaj q'o'n anb'il qe'ye' tu'ntkun qb'incha'ne' qjaye' toju' tx'otx' xjan; matzaj tq'o'na ak'a'j spik'un kye, matzaj tq'o'na ch'i'n ojlab'l toju' yajb'il qe'ye'. <verse number="9" style="v" />B'a'ntzunqa maqo oke' k'a'yi'nmajin, min sik qna'le' tu'na tjaq'ju' yajb'il qe'ye'; matyek'u'ya t-xtalb'ila qeye' kywitzju' nimaqkawil aj Persya, matzaj tq'o'na qchwinqlale' tu'n tjaw qb'incha'n jumajtle' tjaya te k'u'lb'il kyoju' tik'len, ¡maqo tkola toj Juda ex toj Jerusalen!</para>
  <para style="p">
    <verse number="10" style="v" />Atzu'n ja'lo, Taye, ¿titi' kxel qma'ne' tib'ajxi' tkyaqilju' matxi' b'aj qb'incha'ne'? Na'mx kyjapunju' chaq'b'il qu'ne' <verse number="11" style="v" />e'tchaq'a toj kytziju' t-sanjelala, ajb'elqe' teya. Tzajpena' toqxena'na qe'ye' qa aju' tx'otx' ja qo'pomila'toqe' ex ja qtzyu'ya'toq qtx'otx'e', nojnitoq tu'n kyb'inchb'aju' xjal taq'wixi'x, ju' najlqe'toq atzu', tu'nju' kyb'inchb'en myab'a'n matxi'toq noj twitzju' tx'otx' lu tu'n kytz'ilil. <verse number="12" style="v" />Ex tmaya qe'ye' tu'n miche kub'a' qmujb'a'ne' qmyale' kyuk'i'lju' kyk'wal ex kymyal kyuk'i'lju' qk'wale', ex tu'n lalun qo onine' kyi'j tu'nwt kyten toj nak'b'il ex toj b'anil, tu'ntzun tten qipumale kukxju', tu'n qanq'ine' kyi'ju' ntq'o'nju' tx'otx' ex tu'n tkyaj qq'one' te kyetzb'ilju' qyajajile' che ul yajxi'tl tejumajx.</para>
  <para style="p">
    <verse number="13" style="v" />Tib'ajxi'pe' tkyaqilju' yajb'il matxi' tzik'x qu'ne' tu'n tpaju' qb'inchb'aje' myab'a'n ex txqan qpaje', mixpenati' xkub' ttz'e'ysa'na qwitze' kse'nxtoqju' qile', mape' qokub' tq'o'na toj tzaqpib'l, <verse number="14" style="v" />¿ma ktzunlo k'elel qik'o'n jumajtle' tchaq'b'ila ex tu'n tokqq'o'n jumajtl qib'e' kse'nqe' xjal mixyab'a'n nkyb'incha'n? ¿Ma laytzun tzaj ttx'u'jila qi'je' ex tu'n qkub' tb'ajsa'na qkyaqile'?</para>
  <para style="p">
    <verse number="15" style="v" />Nman Dyos, majx tnik'altati'j qeye'; matb'inchaya tu'n qanq'ine' jun k'loj qb'aje', lu nqka'yi'ne' ja'lo. Axxi'x ayo'qe' ati qpaje' twitza; qu'mtzun lay b'ent qtene' twitza.</para>
  <chapter number="10" style="c" />
  <para style="s1">Okkyq'o'n tnam kyil kyi'j</para>
  <para style="p">
    <verse number="1" style="v" />Tetzunj intoq na'n Dyos Esdras ex ntoq jatz tpa'n il lu, in oq'xi' ex mejli twitzu' tja Dyos, ex ate'toq jun k'loj aj Israel, ichan, qya ex k'wal, inxi'xtoq che oq' b'a'nxi'x, eb'jo'kten ttx'ukyile. <verse number="2" style="v" />Atzunte Sekaniy, tk'wal Jeyel ex tyajajil Elam, yolin ex xitma'n te Esdras: Matxi' qo b'inchan ile' twitz Qman Dyos, qu'n maqo mjeye' kyuk'i'l qya najchaq xjal, te nimaqtnam nimalqe' kye txqantl dyos; maskyetzun ikju', atixnate' q'uqb'ab'l kyk'u'j aj Israel ja'lo. <verse number="3" style="v" />Qtziyanxe' twitz Qman Dyos tu'n kyex qxla'ja'ne' qxu'jile' najchaq xjalqe' kyuk'i'lxi' kyal, ex tu'n tjapunju' kawb'il, kse'nxju' ntzajkyma'ne' kyuk'i'lju' nkub' kyb'i'n tchaq'b'il Qman Dyos qeye'. <verse number="4" style="v" />Iq'i'nktz tib'a, qu'n taq'unteju'ya lu tu'n tb'inchanteya, qo onilqe' tuk'i'la. Kuwsam tib'a ex tzyunkju'ya aq'untl, chij te.</para>
  <para style="p">
    <verse number="5" style="v" />Kub'tzun we' Esdras, ex tb'incha tu'n kymanteju' kynejel pale ex kynejel aj Leb'i, ex kykyaqil aj Israel, jun kyol ax tu'n tjapun kyu'n; xikytziyatzuntz. <verse number="6" style="v" />Etztzun Esdras toj tja Dyos ex xi' tja Joanan, tk'wal Elyasib', ja exa' qonik'an tu'n, mixti'x wan ex mixti'x k'wan, qu'n intoq b'isun tu'n tpaj kypi'silju' eb'ju'l jumajtl Jerusalen.</para>
  <para style="p">
    <verse number="7" style="v" />Yajxi'tzuntl ex tqanil toj Juda ex Jerusalen, tu'n kyb'u'yinte kyib'ju' eb'ju'l jumajtl. <verse number="8" style="v" />Alkyetzunte min xpon toj toxi'n q'ij, kse'nxju' kyej b'entti'j kyu'n nejenel ex q'ol nab'l, k'elil iq'i'nju' ti'xti' te ex k'elex xlajet kyxolju' eb'ju'l jumajtl. <verse number="9" style="v" />Qu'mtzun kykyaqilju' xjal kyyajajil Juda ex B'enjamin b'aj kyb'u'yi'n kyib' toj Jerusalen toj winqi'n tajlalju' tb'lejoji'n xjaw, mujqa, tej tb'aju' oxe' q'ij. Kykyaqilju' xjal lu eb'ajkub' qe twitzju' tja Dyos, intoq che lu'lun tu'n tpaju' atitoq tu'n tb'inchet ex tu'nju' jb'al intoq kub': <verse number="10" style="v" />Kub'tzun we' Esdras, ju' pale, ex tma:</para>
  <para style="p">—Mache b'inchan ile' tu'nju' ẍe mjeye' kyuk'i'lju' qya najchaq xjal, iktzu'n xchmeta' kyil aj Israel kyu'ne'. <verse number="11" style="v" />Qu'mtzun ja'lo, twitzku' Qman Dyos, kyq'onke' kyi'je' qa aye'ye' ati kypaje' ex kyb'inchame' tajb'il Qman Dyos. Kypamilkyib'e' kyi'ju' xjal b'inchal taq'wix ex kyi'ju' kyxu'jile' najchaq xjal, chi Esdras.</para>
  <para style="p">
    <verse number="12" style="v" />Kykyaqiltzu'n xjal jawkyma'n kuw:</para>
  <para style="p">—Okyi, kqb'incha'qeye' saj tma'na qeye'. <verse number="13" style="v" />Naq o'kx nim qb'aje', ex lay we'ju' jb'al lwiy; expe' lay qokyaj we'ye' toj b'e, qu'n mya naq te jun q'iju' lu mujqa kab'e' q'ij, qu'n nim qb'aje' xb'inchanteju' il lu. <verse number="14" style="v" />Ate b'a'nju' tu'n kykyajtenju' qnejele' tza'lu yolil qi'je', kykyaqiltzu'n najlqe' kyoju' nimaqqtaname' e'mje kyuk'i'lu' qya najchaq xjal b'a'n kyul toj jun q'ij aj kytxkonjtz, k'le'nqe' kyu'n ajb'el toj kawb'il ex ajkawil te ninkytanam, tzmax ajtik' ttx'u'jil Qman Dyos qi'je' tu'n tpaju' lu, chechij.</para>
  <para style="p">
    <verse number="15-16" style="v" />B'a'n ela' toj kywitz kykyaqilju' eb'ju'l jumajtl tu'n kyb'inchante ikju', naq o'kx Jonatan, tk'wal Asael, ex Jaasiy, tk'wal Tikb'a, min kub' toj kywitz, o'ni'nqe' kyu'n Mesulam ex Sab'tay aj Leb'i. Ejawtzun t-sk'o'n Esdras, ju' pale, jte xjal, nejenelqe'toq kyxolu' toj kyja ex aku' okq'onkye, tojtzun tnejel q'ij teju' tlajoji'n xjaw, b'ent jun k'loj kawil kyu'n kykyaqilju' eb'jaw sk'on tu'n tb'aj kyka'yi'n atl junjun b'inchb'en. <verse number="17" style="v" />Tojtzu'n tnejel q'ij teju' tnejel xjaw b'je'lpun b'aj tnuk'li kyb'inchb'aju' ichan e'mje kyuk'i'lju' qya najchaq xjal.</para>
  <para style="p">
    <verse number="18" style="v" />Aye' pale ja'lu e'elyal mjeb'niqe'toq kyuk'i'l qya najchaq xjal:</para>
  <para style="p">Kyxol tyajajil Joswe, a tk'wal Josadak, ex kyxolu' kywitze'l: aye' Maasiy, Elyeser, Jarib' ex Wedaliy, <verse number="19" style="v" />kytziya axxi'x tu'n tkub' kypa'n kyib' kyuk'i'lju' kyxu'jil ex tzaj kyiq'i'n jun rit te chojb'il tu'n tpaju' kyil.</para>
  <para style="p">
    <verse number="20" style="v" />Kyxol tyajajil Imer: aye' Anani ex Seb'adiy.</para>
  <para style="p">
    <verse number="21" style="v" />Kyxol tyajajil Arim: aye' Maaseyiy, Eliy, Semayiy, Jeyel ex Osiy.</para>
  <para style="p">
    <verse number="22" style="v" />Kyxol tyajajil Pasur: aye' Elyoenay, Maaseyiy, Ismael, Natanael, Josab'ad ex Elasa.</para>
  <para style="p">
    <verse number="23" style="v" />Kyxol kyyajajil aj Leb'i: aye' Josab'ad, Simi, Kyelayiy (mujqa kyelita), Petayiy, Juda ex Elyeser.</para>
  <para style="p">
    <verse number="24" style="v" />Kyxol aj b'itzal: a Elyasib'.</para>
  <para style="p">Kyxol xq'uqil ttzija: aye' Salum, Telem ex Uri.</para>
  <para style="p">
    <verse number="25" style="v" />Aye'tzu'n txqantl aj Israel ikxtoq te'qe'ju', aye' ja'lu:</para>
  <para style="p">Kyxol tyajajil Paros: Ramiy, Jesiy, Malkyiy, Mijamin, Eleasar, Malkyiy ex B'enayiy.</para>
  <para style="p">
    <verse number="26" style="v" />Kyxol tyajajil Elam: aye' Mataniy, Sakariy, Jeyel, Ab'di, Jeremot ex Eliy.</para>
  <para style="p">
    <verse number="27" style="v" />Kyxol tyajajil Satu: aye' Elyoenay, Elyasib', Mataniy, Jeremot, Sab'ad ex Asisa.</para>
  <para style="p">
    <verse number="28" style="v" />Kyxol tyajajil B'eb'ay: aye' Joanan, Ananiy, Sab'ay ex Atlay.</para>
  <para style="p">
    <verse number="29" style="v" />Kyxol tyajajil B'ani: aye' Mesulam, Maluk, Adayiy, Jasub', Seal ex Ramot.</para>
  <para style="p">
    <verse number="30" style="v" />Kyxol tyajajil Paat-moab': aye' Adna, Kyelal, B'enayiy, Maaseyiy, Mataniy, B'esalel, B'inuy ex Manases.</para>
  <para style="p">
    <verse number="31" style="v" />Kyxol tyajajil Arim: aye' Elyeser, Isyiy, Malkyiy, Semayiy, Simeon, <verse number="32" style="v" />B'enjamin, Maluk ex Semariy.</para>
  <para style="p">
    <verse number="33" style="v" />Kyxol tyajajil Asum: aye' matenay, Matata, Sab'ad, Elipelet, Jeremay, Manases ex Simi.</para>
  <para style="p">
    <verse number="34" style="v" />Kyxol tyajajil B'ani: aye' Maday, Amram, Wel, <verse number="35" style="v" />B'enayiy, B'ediy, Kyeluu, <verse number="36" style="v" />B'aniy, Meremot, Elyasib', <verse number="37" style="v" />Mataniy, Matenay, Jaasay.</para>
  <para style="p">
    <verse number="38" style="v" />Kyxol tyajajil B'inuy: aye' Simi, <verse number="39" style="v" />Selemiy, Natan Adayiy, <verse number="40" style="v" />Maknadb'ay, Sasay, Saray, <verse number="41" style="v" />Asarel, Selemiy, Semariy, <verse number="42" style="v" />Salum, Amariy ex Jse.</para>
  <para style="p">
    <verse number="43" style="v" />Kyxol tyajajil Neb'o: aye' Jeyel, Matatiy, Sab'ad, Seb'ina, Jadaw, Joel ex B'enayiy.</para>
  <para style="p">
    <verse number="44" style="v" />Kykyaqil ja'lu ojetoq che mje kyuk'i'l qya najchaq xjal, ex b'ajkub' kypa'n kyib' kyuk'i'l ex eb'ajx kylipb'a'nju' kyal kyi'j.</para>
</usx>