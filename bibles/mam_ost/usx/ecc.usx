<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="ECC" style="id">ECC. TXT Febrero 2009 Pedro D. C. Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Eclesiastés</para>
  <para style="toc3">Ec</para>
  <para style="toc2">Ec</para>
  <para style="toc1">Tu'jil Pakb'ab'l (Eclesiastés)</para>
  <para style="mt1">TUJ PAKB'AL</para>
  <para style="mt2">(Eclesiastés)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Xi' tzajna' tb'i U'j Eclesiastes lu toju' poq'i'n kyu'n oxnaq lajoj (los 70), ja tzajna' yol glesi, atzu'n toj eb'rey, kyolju' ttanam Dyos ojtxi', Qohelet, atz'elpuna'ju': aju' q'ilte twitz jun b'uyjtib'il, mujqa aju' nyolin toj jun b'uyjtib'il. Ana' yol toj kryek, ekklesia, atz'elpuna'ju', b'uyjtib'il. Atzu'n toju' okslab'l ti'j Qajaw Jesukrist, atz'elpuna'ju': jun pakb'al. A ntma'nju': jun xjal twattzi tu'n tyolin, jun tx'olb'al toj ttxolilti'j, mujqa jun ajximal nximan tib'aj jun ti'xti' nim toklen: ¿Alkyeju' b'a'n nim toklen? ¿Alkyetzu'n nimxi'x toklen toju' chwinqlal, tu'ntzun atzu' tz'oka' tilil tu'n xjal tu'n tkanb'anteju' tb'is tk'u'j?</para>
  <para style="ip">Int-xjelu'n tz'ib'alteju' u'j lu toj jun tu'me'l ax ex tnik'alti'j, qa aju' q'inumal, achb'il ex aq'untl, exju' ojtzqib'l, nimxi'x kyoklen toju' kychwinqlal xjal. Eltnik' ti'j qa myaye'ju': mixti'xkye' kyajb'en tu'n tokqe qk'u'j kyi'j axi'xwit tu'n kykanb'etju'. Naku'j inyolin tz'ib'alte u'j lu tjunalx, nnoktq'o'n toklen jun ti'xti', yajxi'tl nkutmyo'n mujqa inel tik'u'n tojxi'x tu'me'l, inxi'x jyo'n alkyexi'x tb'anilju' chwinqlal.</para>
  <para style="ip">Tu'nju' xjel tojxi'x tu'me'l toju' u'j lu, nimju' ntma'n naku'j mixti'x kyajb'en ex mya tzalajb'ilqe'. Ojexi'x ximanju' tz'ib'alte u'j lu tib'aju' tchwinqlal xjal naq ch'i'ntoj ex nimu' ti'xti' nb'aj toj mya tnik'alilti'j ex b'is, ex kane toj twitzju' tz'ib'al qa mixti'x tajb'enju' chwinqlal, naq jun kmujx ex mixti'x tb'anil. Atzu'n toj b'ajsb'il teju' u'j lu, in tchik'b'a'n qa a nim toklenju' teju' ichan, aju' titi' kub'a' b'incha'na' tu'n Dyos, tu'n tniman ex tu'n tb'inte Qman Dyos, ju' ajkawil nim toklen tkyaqil ojtzqi'n tu'n. Tkyaqilju' tzalajb'il kyi'ju' oklenj qe tu'n Dyos, e' aq'untl exju' nab'l, o'kx ati kyoklen ex kyajb'enju' qa te ninb'il ex okslab'lte Qman Dyos.</para>
  <chapter number="1" style="c" />
  <para style="s1">Tkyaqil Naqx toqwitz nok</para>
  <para style="p">
    <verse number="1" style="v" />Tej tten jun tk'wal Dab'i te nimaqkawil toj Jerusalen, ojtzqi'nxi'xtoq tu'nju' nim tnab'l, aye' junjun yol ja'lu e'tma.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />¡Tkyaqil naqgan!</para>
  <para style="q">¡Naqxgan, mixti'x tajb'en!</para>
  <para style="q">
    <verse number="3" style="v" />¿Titi' ntkanb'a'nju' xjal</para>
  <para style="q">tu'n tkyaqilju' ntaq'una'n twitz tx'otx'?</para>
  <para style="q">
    <verse number="4" style="v" />Nche itz'ji junjun, nche kyim junjuntl,</para>
  <para style="q">atzunte tx'otx' kukx ttenju'.</para>
  <para style="q">
    <verse number="5" style="v" />In jawu'lu' q'ij, ex innex,</para>
  <para style="q">innanj junmajtlti'j tojxju' tb'e</para>
  <para style="q">tu'n tjawu'l junmajtl.</para>
  <para style="q">
    <verse number="6" style="v" />Njub'in kyq'iq' toj tnayajkya'j</para>
  <para style="q">inanjtz jumajtlti'j toj tb'a'nq'ob'kya'j.</para>
  <para style="q">¡Insutyanju' kyq'iq', insutyan!</para>
  <para style="q">¡Insutyan ex nnanj jumajtlti'j!</para>
  <para style="q">
    <verse number="7" style="v" />Kykyaqilju' nin a' nche pon toj ninnjab',</para>
  <para style="q">atzunte' ninnjab' mixti'x innoj;</para>
  <para style="q">axtzuntzu' nnanja' kyi'ju' nin a' janche jatza' anq'in</para>
  <para style="q">tu'n kyb'et jumajtl tojxju' kyb'e.</para>
  <para style="q">
    <verse number="8" style="v" />Mixti'x jun tu'me'l tu'n tq'met</para>
  <para style="q">b'ajx qgan tu'n tkyaqilju' ti'xti' lu;</para>
  <para style="q">mixti'x nqe tk'u'ju' qwitz tu'nju' ntka'yi'n</para>
  <para style="q">exju' qẍkyin tu'nju' ntb'i'n.</para>
  <para style="q">
    <verse number="9" style="v" />Mixti'te jun ti'xti' ktenb'el qa min ten ojtxi'</para>
  <para style="q">mixti'te jun ti'xti' kb'inchetil qa min b'ent ojtxi'.</para>
  <para style="q">¡Mixti'te jun ti'xti' ak'a'jwit twitzju' tx'otx'!</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Kukx kymantekye xjalju':</para>
  <para style="q">¡Ak'a'jtzunte' lu!, chechij.</para>
  <para style="q">Extzun oje tente' ojtxi' kyeqwitz.</para>
  <para style="q">
    <verse number="11" style="v" />Oje b'jik'kyna'lju' ti'xti' ojtxi',</para>
  <para style="q">ikyqe'xtzun ti'xti'ju' che ul k'ik'el kyna'l</para>
  <para style="q">kyu'nju' che itz'jel yajxi'tel.</para>
  <para style="s1">Twitzlalil tu'n Pakb'al</para>
  <para style="p">
    <verse number="12" style="v" />Ayine' pakb'al, inten te nimaqkawil kye aj Isarael toj Jerusalen, <verse number="13" style="v" />oknxon nk'u'je' tu'n kyb'aj nka'yi'ne' tkyaqilju' nb'aj twitz tx'otx' tu'n kykane tuk'i'l nab'l. ¡Jun nin iqtzte' oje tzaj tq'o'n Qman Dyos kyib'aju' xjal tu'n lalun jaw kynima'n kyib'! <verse number="14" style="v" />Eltzun nnik'tze' qa naqx toqwitzte' nnok tu'n tkyaqilju' nb'inchet twitz tx'otx', ikte' kse'n qajb'il tu'n qxi' knolte kyq'iq'.</para>
  <para style="p">
    <verse number="15" style="v" />¡Layx b'ent ttzinsetju' ch'okti'j, ex lay b'ent tokju' mixti'x toj tajlal!</para>
  <para style="p">
    <verse number="16-17" style="v" />Nmatzuntze' wib'xwib'e': Inchin okq'o'ne' te jun nimaqxjal, atixi'x tnab'l kyekywitz kykyaqilju' txqantl nimaqkawil e'kawin nejtl nwitze' toj Jerusalen; majx q'o'n wib'e' tu'n tel nnik'e' b'a'nxi'x ti'ju' nab'l ex ti'j ojtzqib'l, ex ti'ju' ti'xti' myab'a'n ex xnakyil, naqx tu'n tel nnik'e' qa ikxju' kse'n qajb'il tu'n qxi' knolte kyq'iq', nchije'. <verse number="18" style="v" />Axxi'x, qa nim qnab'l, ex nim yajb'il qe; qa nimxi'xju' b'i'n qu'n, inqo yajtixi'xtl.</para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Ex nmaye' wib'xwib'e': Ja'lo k'ik'elnwitze' toju' tzalajb'il; chin anq'ile' b'a'n, nchije'. ¡Ex ikxte' lu naqx toqwitz nnok! <verse number="2" style="v" />Eltzun nnik'tze' qa naq nnok toj qwi' kse'n aj qtze'n exqa mixti'x tajb'enju' achb'il.</para>
  <para style="p">
    <verse number="3" style="v" />Waq'wib'e' tu'n tik' nwitze' ti'ju' tzalajb'il tu'n b'in, ẍaqlu'n qine' tu'n nab'l, naqx tu'n tel nnik'e' qa a b'a'nju' teju' xjal toju' jte' q'ij tchwinqlal twitz tx'otx'o.</para>
  <para style="p">
    <verse number="4" style="v" />Eb'aj nb'incha'ne' nimaq aq'untl; eb'jaw nb'incha'n njaye' te kawb'il; ex ten wawale' ub'a. <verse number="5" style="v" />Ok wawale' toju' wawb'ile' ex toju' ntx'otx'e', e'okwawa'ne' chukchaq tqan lob'j. <verse number="6" style="v" />Eb'ajkub' nb'incha'ne' nimaq tkb'el a' tu'n kya'litju' tze b'jo'k wawa'ne'; <verse number="7" style="v" />e'nloq' nmajine' ichan ex qya, ex e'ten nmajine' itz'jniqe' tojx njaye'; ex nimxi'x txqan nwakyixe' ex nrite' ten kyekwitzju' e'ten nejtl nwitze' toj Jerusalen. <verse number="8" style="v" />B'aj nchmo'n txqan nq'anpwaqe' ex nsaqpwaqe', nk'uwene' kyetoq txqantl nimaqkawil ex kye junxi'tl tx'otx'. E'tzun ichan ex qya ajb'itzalqe' eb'aj ten, in achune' kyuk'i'l xjal ex txqan nqyaye' ten.</para>
  <para style="p">
    <verse number="9" style="v" />In okye' te jun nimaqxjal, nimxi'x txqan ti'xti' ten weye' kyekywitzju' e'ten nejtl nwitze' toj Jerusalen. Expe' kukxtoq tten nnab'lju'ye'. <verse number="10" style="v" />Mixti' jumaj kub'wit nẍk'u'ẍi'n wib'e'; mixti' jumaj njuk'witwib'e' ti'j juntl tzalajb'il. Ojexi'x intzalaje' tu'n tkyaqil nk'u'je' toju' waq'une', ex o'kxte nkanb'aju'ye' tzalajb'il lu.</para>
  <para style="p">
    <verse number="11" style="v" />Nkub'tentzuntze' ximalte tkyaqilju' waq'unb'ene' nim tq'ijlalil xi' kyi'j tu'n kyb'aj b'ent, ex kane toj nwitze' qa tkyaqil ja'lu mixti'x ttx'o'lajil, ikxju' kse'n qajb'il tu'n qxi' tzyulte kyq'iq', mixti'x tajb'en twitzju' tx'otx' lu.</para>
  <para style="p">
    <verse number="12" style="v" />Nkub'tentzuntze' ximal tib'aju' nab'l ex tib'aju' xnakyil: ¿Ti'xi'xtzunlo ktb'inch'a'tlju' nimaqkqwil tzul wi'jxi'ye', qa mya axju' matxi' b'inchet nejtl? <verse number="13" style="v" />Ex el nniky'e' ti'j qa atixi'x tajb'enju' nab'l kyetwitz xnakyil, kse'n spik'un atixi'x tajb'en kyetwitz qxopin.</para>
  <para style="q">
    <verse number="14" style="v" />Inxitka'yi'n te' xjal ati tnab'l b'a'nxi'x, atzu'n xnak nttakla'ntib' toj qxopin. Matxitzun tz'el nnik'e' ti'j qa qkyaqil junx qopomela' b'aj, <verse number="15" style="v" />kunxima'ntzuntze': Ax kb'ajelju' wi'je', kse'nx kb'ajel ti'ju' xnak, mixti'xte' tajb'en txqan nnab'le'. ¡Ex mixti'xte' lu ttx'o'lajil! <verse number="16" style="v" />Qu'n mixi'xlo ktzajela' na'nju' ati tnab'l exju' mixti'x tnab'l; qu'n tkyaqil inik'tna'l aj tb'etq'ij, kkyimelju' ati tnab'l exju' mixti' tnab'l.</para>
  <para style="p">
    <verse number="17" style="v" />Elpe' wik'o'ne' chwinqlal, qu'n tkyaqilju' nb'inchet twitzju' tx'otx' ok te jun myab'a'n weye'. Axxi'x, tkyaqil ja'lu mixti'x ttx'o'lajil, ¡ikxi'xte' kse'n qajb'il tu'n qxi' knolte kyq'iq'! <verse number="18" style="v" />Ex elwik'o'ne' tkyaqil aq'untl ojetoq che nb'inchaye' twitzju' tx'otx', qu'n tkyaqil ati tu'n tkyejten teju' nxele' k'okyel. <verse number="19" style="v" />Ex b'i'nxi'xtoq wu'ne' qa aju' xjal kjelten te nxele', b'a'ntzun ati tnab'l mujqa mixti', ilti'j kjelten tib'aj tkyaqilju' waq'unb'ene' maxi'x nb'inchaye' tuk'i'l nab'l twitz tx'otx'. ¡Expe' mixti'x ttx'o'lajil ja'lu!</para>
  <para style="p">
    <verse number="20" style="v" />Tetzunj nka'yinteju'ye' waq'unb'ene' matxi'toq che nb'inchaye' twitzju' tx'otx', ul toj nk'u'je' tu'nju' nim ẍin aq'unane', <verse number="21" style="v" />qu'n atite xjal nnaq'unan tuk'i'l nab'l, ojtzqib'l ex twitzlalil, naqx tu'n tkyaj tq'o'nju' taq'unb'en te juntl min xsikti tu'n tten te. ¡Mixti'x ttx'o'lajil ja'lu ex mixya tnik'alilti'j!</para>
  <para style="p">
    <verse number="22" style="v" />Ikytzu'n, ¿titi' tajb'en teju' xjal tu'nju' inxi'x elb'aj tu'n taq'unan ex inxi'x b'ajx tk'u'j twitzju' tx'otx'? <verse number="23" style="v" />Tkyaqilju' tq'ijlalil tchwinqlal yajte'n, jun nin iqtzxi'x; mixpeti'x nnojlanju' tnab'l te qonik'an. ¡Ex mixti'x ttx'o'lajil ja'lu!</para>
  <para style="p">
    <verse number="24" style="v" />Ate b'a'nju' tu'n tb'inchante xjal tu'n twan ex tu'n tk'wan, ex tu'n ttzalaj tu'nju' twitz taq'unb'en, qu'n matxi' tz'el nnik'e' ti'j qa axte Qman Dyos kyej q'onte ja'lu. <verse number="25" style="v" />Qu'n, ¿alxi'xkye jaku' wan, mujqa tu'n ttzalaj qa mya tu'nx? <verse number="26" style="v" />Qu'n intzaj tq'o'nte Qman Dyos nab'l, ojtzqib'l ex tzalajb'il teju' xjal b'a'ntel twitz; atzu'n teju' b'inchal il ntq'o'n anb'il tu'n tjaw b'ent ex tu'n tchmet tk'uwen, tu'n txi' tq'o'ntl teju' b'a'ntel twitz. ¡Mixti'x ttx'o'lajil ja'lu ex ikx nnela'ju' kse'n qajb'il tu'n qxi' knolte kyq'iq'!</para>
  <chapter number="3" style="c" />
  <para style="s1">Tkyaqil ati kmuj te</para>
  <para style="p">
    <verse number="1" style="v" />Tkyaqil ati tq'ijlalil twitzju' tx'otx'; ati jun kmuj te tkyaqilju' nb'aji:</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Maqo itz'ji ja'lo,</para>
  <para style="q">najchi'j qokyim.</para>
  <para style="q">nqo awan ja'lo,</para>
  <para style="q">najchi'j jaw qb'uyi'n twitz qawal.</para>
  <para style="q">
    <verse number="3" style="v" />Nche kub' b'yo'n xjal ja'lo,</para>
  <para style="q">najchi'j che q'ananjtz.</para>
  <para style="q">Nkub' qxitu'n ja'lo,</para>
  <para style="q">najchi'j jaw qb'incha'n.</para>
  <para style="q">
    <verse number="4" style="v" />Nqo oq' ja'lo,</para>
  <para style="q">najchi'j qo tze'n.</para>
  <para style="q">Nqo b'isun ja'lo</para>
  <para style="q">najchi'j qo b'ixin.</para>
  <para style="q">
    <verse number="5" style="v" />Nche'x qchitu'n ab'j ja'lo,</para>
  <para style="q">najchi'j che jaw qb'uyi'n.</para>
  <para style="q">Nqo chlenqib' ja'lo,</para>
  <para style="q">najchi'j kub' qpa'nqib'.</para>
  <para style="q">
    <verse number="6" style="v" />Nqo jyon ja'lo,</para>
  <para style="q">najchi'j txi' qtzaqpi'n,</para>
  <para style="q">Nb'ajx qk'u'n ja'lo,</para>
  <para style="q">najchi'j b'ajx qxon.</para>
  <para style="q">
    <verse number="7" style="v" />Nkub' qlaqu'n ja'lo,</para>
  <para style="q">najchi'j kub' qtzo'n.</para>
  <para style="q">Numliqo' ja'lo,</para>
  <para style="q">najchi'j qo yolin.</para>
  <para style="q">
    <verse number="8" style="v" />Nqk'u'jla'nqib' ja'lo,</para>
  <para style="q">najchi'j tz'el qik'o'n qib'.</para>
  <para style="q">Nqo q'ojin ja'lo,</para>
  <para style="q">najchi'j toj nak'b'il ta'qo'.</para>
  <para style="p">
    <verse number="9" style="v" />¿Titi' tajb'en teju' xjal tu'nju' nxi'x elb'aj tu'n taq'unan? <verse number="10" style="v" />Inel nnik'e' ti'ju' aq'untl kyej tq'o'n Qman Dyos kyeju' xjal tu'n kyyajti tu'n. <verse number="11" style="v" />Tkyaqil kub' tb'incha'n Qman Dyos tb'anilxi'x, ex tojku'xi'x tq'ijlalil; kub' tq'o'n toj tnab'lu' xjal tu'n teltnik' ti'ju' tq'ijlalil tejumajx, extzun min npon kanunju' xjal tu'n teltnik' ti'j tkyaqilju' matxi' tb'incha Dyos exju' ktb'incha'.</para>
  <para style="p">
    <verse number="12" style="v" />Awe' b'i'n wu'n qa a b'a'n tu'n tb'inchanteju' xjal, tu'n ttzalaj ex tu'n tachunteju' tchwinqlal, <verse number="13" style="v" />qu'n qa nqo wan ex nqo k'wan, exqa nqnik'b'e'n twitzlalilju' qaq'unb'en, ate Qman Dyos saj q'onte qe. <verse number="14" style="v" />Ex b'i'n wu'ne' qa tkyaqilju' matxi' tb'incha Qman Dyos ktenb'el tejumajx. Mixti'te tu'n toktz'aqtzet ex tu'n tel iq'et; aku' Qman Dyos kub' b'inchante, tu'ntzun kynimanju' xjal twitz. <verse number="15" style="v" />Mixti' jun ti'xti' ati ja'lo miwtjunti' ojtxi', ex mixti' jun ti'xti' kb'entel na'mxwit tten. Ate Qman Dyos nb'inchante tu'n tb'aji ja'lo kse'n b'aj ojtxi'.</para>
  <para style="s1">Mya tnik'alilti'j nb'aj toju' chwinqlal</para>
  <para style="p">
    <verse number="16" style="v" />Matxi' wile' twitzju' tx'otx', nim sb'ujtib'il ex nim il ati, awtlote atiju' tnik'alilti'j ex ttxolilti'j. <verse number="17" style="v" />Qu'mtzun kub' nxima'ne' qa che okyelju' tnik'alkyi'j exqe' b'inchal myab'a'n toj xjel tu'n Qman Dyos, qu'n atiyile junjun kmuj te tkyaqilju' nb'aji ex te tkyaqilju' nb'inchet.</para>
  <para style="p">
    <verse number="18" style="v" />Ex kub' nxima'ne' ti'ju' tu'me'l nb'eta' xjal, qa nche kub' tq'o'n Qman Dyos toj joyb'ilkyi'j tu'n telkynik' qa ikqe'xju' kse'nqe' txkup. <verse number="19" style="v" />Axxi'x, axche ik'ela' xjalju' kse'nkye txkup: nche kyimju' xjal ex nche kyimu' txkup, ex axte kyxewju' tu'n kyanq'in kykyaqil. Mixti'te juntl ti'xti' atiwt teju' xjal kyekywitzju' txkup: tkyaqil ja'lu mixti'x ttx'o'lajil, <verse number="20" style="v" />ex junx che pomela' b'aj kykyaqil; kykyaqil e'kub' b'incha'n ti'j tx'otx' ex kykyaqil k'anjetlkyi'j toj tx'otx'. <verse number="21" style="v" />¿Alxi'xkye kq'malte qa axxi'x njapunju' kyxew xjal toj kya'j, atzu'n kyxew txkup xi' nxa' t-xexi' tx'otx'? <verse number="22" style="v" />Matxi' wile' qa mixti' juntl ti'xti' b'a'nxi'x teju' xjal kyetwitz tu'n tnik'b'enteju' twitz taq'unb'en, qu'n a saja' q'o'na'ju', mixna' a'lo'xte ktzajel iq'inte junmajtl ka'yilteju' kb'ajel tkyimlenxi'.</para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Inximatzuntze' ti'ju' yajb'il nb'inchanjtz twitz tx'otx'. E'wilju'ye' xjal nche yajlanjtz intoq che oq' ex mix-a'lo' nq'uqb'ante kyk'u'j; inxi'xtoq che yajlanjtz kyu'nju' yajlalkye ex mix-a'lo' nklonkye. <verse number="2" style="v" />Qu'mtzun elnnik'e' ti'j qa tzalajb'ilxi'x kyeju' oje che kyim kyekywitzju' itz'qe'x; <verse number="3" style="v" />b'a'nxi'xpena' ta'qe'ju' namx kyitz'ji kyekywitzju' kab'e' tnej lu, qu'n na'mx tik' kywitz ti'ju' il nb'inchanjtz twitzju' tx'otx'.</para>
  <para style="p">
    <verse number="4" style="v" />Ex matz'el nnik'e' ti'j, qa nnoktilil tu'n qaq'unan exqa b'a'n inela'ju' qaq'un, njaw tx'a'lti'j tk'u'j jun xjal ti'j juntl tu'n tpaj, ex ikxjalu mixti'x ttx'o'lajil, ikxu' kse'n qajb'il tu'n qxi' knolte kyq'iq'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Inkyma'n xjal kjalu: Naq chle'n tq'ob'ju' xjal mixti' tnab'l ex ax nkub' tb'o'ljsa'n tib', chechij.</para>
  <para style="q">
    <verse number="6" style="v" />Atzu'n nchiwe': Ate b'a'n naq jun jtoj tuk'i'l ojlab'l kyetwitz kab'e' jtoj nim sikte'n ti'j, naqx tu'n qxi' knolte kyq'iq'.</para>
  <para style="p">
    <verse number="7" style="v" />Tej txi' nmiltz'u'n nwitze' toj jun plajtl, wile' juntl ti'xti' mixti'x ttx'o'lajil twitzju' tx'otx': <verse number="8" style="v" />jun xjal naq tjunal, mixti'qe' tamiw, mixti' tk'wal, mixti'qe' titz'in, ex mixti'x nnojlan ch'i'n ex miẍti'x nqjen tu'n tchmon tq'inumal, ex mixti' nkub'ten ximalte alqe nnaq'unana' ex tiqu'n nkub'a' t-xk'a'yina'tib' ti'ju' ati te. Ex mixti'x ttx'o'lajil ja'lu ex jun iqtz alxi'x.</para>
  <para style="s1">Nten qipumal qa mujli qten</para>
  <para style="p">
    <verse number="9" style="v" />Ate b'a'nju' kab'e' qb'aj kyetwitz qjunal, qu'n inka'yin ch'i'ntl twitzju' qaq'unb'en. <verse number="10" style="v" />Qatzun makub' tz'aq junkye, aju' juntl kjawil wab'ante. ¡Atzu'n xjal tjunal, qab'anx twitz qu'n qama kub' tz'aq, mix-a'lo' kajwil wab'ante! <verse number="11" style="v" />Expe' qama che ktan kab'e' junx, che maq'tel kykab'ilx; qatzun naq jun, ¡lay maq'ti! <verse number="12" style="v" />Qa naq tjunal jun ati lwiy kb'elti'j, qatzun kab'e' kyb'aj lay kub'kyi'j. Expe' ky'jaj te oxe' twitz lay laqnaj.</para>
  <para style="s1">Mya o'kxtzu' ta'te' nab'l tuk'i'lju' matxi' tzaj tab'q'i</para>
  <para style="p">
    <verse number="13" style="v" />Toj juntl tu'me'l, ate nim toklenju' ku'xun prow ati tnab'l kyetwitzju' nimaqkawil matxi' tijin ex mixti' tnab'l, qu'n min ntk'mo'ntl nab'l. <verse number="14-15" style="v" />Maskyepe' akxtoq tetzju' ku'xun toj kars ajtok te t-xelju' nimaqkawil matxi' tzaj twinqil, mujqa toj prowil setza' xpon toj kawb'il, matxi' tz'el nniky'e' kyi'ju' xjal nche onin tuk'i'l. <verse number="16" style="v" />Ex b'a'nqa tnamju' xjal jakkawila', lay che tzalaj ti'j, exqe' kyyajajil che ul yajxi'tel. Ex mixti'x ttx'o'lajil ja'lu, ikxi'xte' kse'n qajb'il tu'n qxi' knolte kyq'iq'.</para>
  <chapter number="5" style="c" />
  <para style="s1">Ati tu'n tjapun qyol nxiqtziya'n twitz Dyos</para>
  <para style="p">
    <verse number="1" style="v" />Aj txi'ya toj tja Dyos, ka'yinxa tu'me'l: lq'eka ex b'ina tu'n tkyaqil tk'u'ja te Dyos, kyetwitz tu'n tkub' tq'o'n chojb'ila kse'n nkyb'incha'n xjal mixti' kynab'lju' min nnel kynik' qa ilu' nkyb'incha'n.</para>
  <para style="p">
    <verse number="2" style="v" />Lalun txi'naj ttziya'n jun tyola tu'n ttziya mujqa tu'n tnab'la te Qman Dyos, qu'n toj kya'j ta'te Qman Dyos, atzunta twitz tx'otx'. Qu'mtzun o'kxte q'manxju'ya aju' kb'entel tu'na, <verse number="3" style="v" />qu'n qa nqo ximan nim inokok toj qwitz, exqa nim nqo yolin ati maj myab'a'ntlju' qyol nxiqma'n.</para>
  <para style="p">
    <verse number="4" style="v" />Ajttziyante jun tyola twitz Qman Dyos, lwiyxi'x japun tu'na, qu'n min ntzalaj kyi'ju' mixti' kynab'l. Japunx tu'na aju' oje tmaya, <verse number="5" style="v" />qu'n ate b'a'nju' min nxiqtziya'n kyetwitz nqtziya'n extzu'n lay japun qu'n.</para>
  <para style="p">
    <verse number="6" style="v" />Lalun taja tu'n tb'inchan ila tu'n ttziya, qu'n jaku' tmatla twitzju' t-sanjelal Qman Dyos qa naq xtzpeta ti'j tyola. ¿Tiqu'n k'okyela' tq'o'na ttx'u'jil Qman Dyos tu'nju' kxel ttziya'na naq tu'n tkub' t-xitu'nju' matxi' b'ent tu'na? <verse number="7" style="v" />Qu'mtzun, tu'nju' nim txqan ti'xti' inokok toj twitza ex nim txqan tyola ex milchaqx ti'xti' mixti' kynab'l, ati tu'n tnimana twitz Qman Dyos.</para>
  <para style="s1">Mixti'xte b'a'n toju' Chwinqlal</para>
  <para style="p">
    <verse number="8" style="v" />Lalun jaw lab'tiya qama tila nche yajlanjtzju' prow toj jun tnam exqa min nb'inchanjtz tnik'alilti'j ex min nnimajtzju' kyoklen, qu'n jun xjal nim toklen toj kawb'il inkub' jpu'n til tu'n juntl nimxi'x toklen, e'tzun txqantl nimxi'xtl kyoklen nche kub'jpu'nte kyilju' kab'e' lu. <verse number="9" style="v" />¡Inq'manjtztzuntz ti'j ja'lu qa xi'tch'iyju' tnam exqa nnajb'enju' nimaqkawil toj kojb'il!</para>
  <para style="p">
    <verse number="10" style="v" />Aju' xjal majx tok tk'u'j ti'j pwaq, mixti'x nqe tk'u'j; aju' majx tok tk'u'j ti'j q'inumal, naq ch'i'nte' ati te toj twitz. Ex ikx mixti'x ttx'o'lajil ja'lu, <verse number="11" style="v" />qu'n qa nimxi'x ati, ex nimxi'xtl nnajset. ¿Ti'tzu'n k'ajb'ela' tu'n tten txqan q'inumal, ti'jxi'tlju' ati qe? <verse number="12" style="v" />Aju' nnaq'unan, b'a'ntzun qa nwan b'a'nxi'x mujqa min, inwtan b'a'nxi'x, atzu'n q'inun min nnok twatl tu'n tpaju' tq'inumal.</para>
  <para style="p">
    <verse number="13" style="v" />Matxi' wile' jun ti'xti' majx b'isb'ajilxi'x twitzju' tx'otx' lu: qa nimxi'xju' q'inumal, myab'a'n nnela' teju' tajaw, <verse number="14" style="v" />qama tzaj jun k'aẍjel twitz kub'l, kb'elb'aju' q'inumal, extzunqa ati jun tk'wal, mixti'tlte kjel tq'o'n te. <verse number="15" style="v" />Ikxtzu'n kse'n tej tul twitzju' tx'otx', ikxtzu'n k'anjela' ti'j: naq chle'n tq'ob' kse'nx itz'ja', ex mixti'xte' kxe'l tiq'i'n ti'ju' taq'unb'en. <verse number="16" style="v" />Axxi'x b'isb'ajilx te'lu: ikxju' kse'n ula' twitz tx'otx', ikxtzun k'anjela'ju'. ¿Ti'tzun xtkanb'a tu'n txqan taq'un xtb'incha mixti'tl tz'oka'?. <verse number="17" style="v" />Noqwittzun o'kxju', toj qlolj xtena' toj tkyaqil tchwinqlal, toj yajb'il, k'ixk'oj ex ma ku'x tq'o'n q'oj toj tk'u'j.</para>
  <para style="p">
    <verse number="18" style="v" />Matxi' tz'el nnik'e' ti'j ate b'a'nju' ex tzalajb'ilxi'x tu'n qwan ex tu'n qk'wan, tu'n qnik'b'ente twitzlalilju' qaq'un inxi'x qo'elb'aj tu'n tb'inchet toju' jte' q'ij qchwinqlal ntzaj tq'o'n Qman Dyos, qu'n ana' xqo tzaja' q'o'na'ju'. <verse number="19" style="v" />Toj juntl tu'me'l, kykyaqilju' xjal ntzaj tq'o'n Qman Dyos txqan kyq'inumal, ex ntzaj tq'o'n anb'il kye tu'n kynik'b'ente, qu'n ana' tzaj tq'o'n Qman Dyos kye tu'n kynik'b'ente txqan kyaq'unb'en. <verse number="20" style="v" />Ina' tzaj tq'o'n Qman Dyos tzalajb'il toj kyanmi, min nb'ajxtl kyk'u'j ti'ju' tq'ijlalil kychwinqlal.</para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Atix juntl ti'xti' matxi' tz'el nnik'e' ti'j nb'aj kyxol xjal twitzju' tx'otx' lu: <verse number="2" style="v" />intzaj tq'o'n Qman Dyos txqan kyq'inumal ex ninb'ilkye junjun xjal, ex majx atiyileju' ti'xti' kye aju' npon kyk'u'j ti'j; extzun min q'o'n kye tu'n kynik'b'ente tkyaqil, junxi'qe'tlkye' nche nik'b'elte. ¡Ex mixti'x ttx'o'lajil ja'lu ex b'isb'ajilx! <verse number="3" style="v" />Jaku' ten jo'naq tk'wal jun xjal ex jaku' tz'anq'in b'a'npun ab'q'i; naqtzun aju' maskye maten nimtoj, qa min xtzalaj toju' b'a'n, expe' qa min xku'x mqu'n; ape'te b'a'n jun k'wal noq e'la'n kyetwitzju' xjal lu. <verse number="4" style="v" />Maskye naq xkub'naju' k'wal lu toj qxopin ja kjela' naja' tb'i, <verse number="5" style="v" />b'a'ntzun qa min xtilju' q'ij ex mixti'xte sok tb'i'n, maspe' matz'ojlan twitzju' xjal lu, <verse number="6" style="v" />b'a'npe'wtlo qa matz'anq'in jo'k'al (2,000) ab'q'i, qa min xtnik'b'eju' ati te. ¡Junxna' qo pomela'te' qkyaqil!</para>
  <para style="p">
    <verse number="7" style="v" />Inxi'x oktilil tu'n taq'unanju' xjal tu'n twan, extzun mixti'x nqe tk'u'j. <verse number="8" style="v" />¿Ti'xi'xtzu'n ati teju' xjal ati tnab'lju' mixti' teju' mixti' tnab'l, qa myaju' tojtzqib'l tu'n tb'ent tanq'in?</para>
  <para style="p">
    <verse number="9" style="v" />Ate b'a'nju' nnok qka'yi'n kyetwitzju' naq nkub' qxima'n. Expe' ikx mixti'x ttx'o'lajil ja'lu, ikxju' kse'n qajb'il tu'n qxi' knolte kyq'iq'. <verse number="10" style="v" />Aju' ati ja'lo, ojtxi'ku' toklen q'o'n tb'i, ex b'i'n alkye. Mix-a'lo' jun kb'entel tq'ojin tuk'i'lju' nimxi'x tipumal. <verse number="11" style="v" />Qa jun xjal nim nyolin, nim txqan tyol mixti'x tajb'en; ex mixti'xte nkanb'et tu'n ja'lu. <verse number="12" style="v" />Qu'mtzun mix-a'lo'xte b'ilte alkyexi'xju' b'a'n teju' xjal toju' jte' q'ij tchwinqlal naqx tal witzik' twitzju' tx'otx'. K'ik'elju' jte' q'ij tchwinqlal naku'j leku'n, ¿alxi'xkye kpomel q'malte te titi' kb'ajel twitzju' tx'otx' tkyimlenxi'?</para>
  <chapter number="7" style="c" />
  <para style="s1">Aju' nimxi'x toklen tu'n t-xib'inchet</para>
  <para style="q">
    <verse number="1" style="v" />Ate b'a'nju' b'a'n qyolinjtz</para>
  <para style="q">kyetwitz tb'anil k'ok'sb'il.</para>
  <para style="b" />
  <para style="q">Ate q'iju' b'a'n aj qkyim</para>
  <para style="q">kyetwitzju' q'ij aj qitz'ji.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Ate b'a'nju' tu'n qxi' muqul</para>
  <para style="q">kyetwitz tu'n qxi' tzalajeb'el;</para>
  <para style="q">kykyaqil nakye' xjal nche kyim,</para>
  <para style="q">na'nwtlote' tu'n kyk'u'ju' itz'qe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />A b'a'nju' tu'n qoq' kyetwitz tu'n qtze'n,</para>
  <para style="q">b'a'ntzun myab'a'n tka'yinku' qwitz</para>
  <para style="q">atzu'n te qanmi b'a'n nnela'.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Inximante' xjal ati tnab'l ti'ju' kamik,</para>
  <para style="q">atzu'n xjal mixti' tnab'l o'kxtzu' nximana' tu'n txi' tzalajeb'el.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Ate b'a'nju' tu'n txiqb'i'n tzak'b'il kyu'n ati kynab'l</para>
  <para style="q">kyetwitz tu'n qjaw nima'n kyu'n xjal mixti' kynab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Ikytq'ojq'ojel kytze' xjalju' mixti' kynab'l</para>
  <para style="q">kse'n ch'i'x nspoq'ob'ti toj q'aq',</para>
  <para style="q">ex ikx mixti'x ttx'o'lajil ja'lu.</para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" />In okju' q'oj te takpuje'n teju' xjal ati tnab'l,</para>
  <para style="q">ex tu'nju' pwaq nk'met ti'j myab'a'n nkub'a' b'o'lju' tchwinqlal.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Ate b'a'nju' tu'n tpon b'aj ttxa'n jun qaq'un</para>
  <para style="q">kyetwitz tu'n ttzyet.</para>
  <para style="b" />
  <para style="q">Ate b'a'nju' ati qpasens</para>
  <para style="q">kyetwitz nqnima'n qib'.</para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" />Lalun naq tx'u'jina, qu'n ate xjalju' mixti' tnab'l naq ntx'u'jin.</para>
  <para style="q">
    <verse number="10" style="v" />Lalun t-xjelu'ya tiqu'n majx b'a'nju' tq'ijlalil ojtxi' kyetwitz ja'lo, mya tuk'i'l nab'lte' xjel lu.</para>
  <para style="p">
    <verse number="11" style="v" />Tb'anilxi'xte' ojtzqib'l ex nim tajb'en kyeju' nche anq'in twitz tx'otx', qa mujli tuk'i'l jun etzb'il. <verse number="12" style="v" />Qu'n inqotklo'n nab'l kse'n pwaq, naqtzun ate' nab'l atixi'x tajb'en qu'n ntq'o'n tchwinqlalju' xjal ati tnab'l.</para>
  <para style="p">
    <verse number="13" style="v" />Ximanxpe'ju'ya taq'un Qman Dyos matxi' tb'incha: ¿alxi'xkye jun kb'antel tz'anjtz tz'umante ti'ju' kyejni tch'okyi'n? <verse number="14" style="v" />Qa b'a'n tela, tzalajxa toju' b'a'n lu; qatzun myab'a'n tela, ximanku'ya qa tu'nile Dyos tkyaqilju' tu'me'l lu, ex min b'i'n tu'nte' xjal titi' tzul ti'j yajxi'tel.</para>
  <para style="p">
    <verse number="15" style="v" />Tkyaqil ja'lu matxi' wile' toju' tq'ijlalil nchwinqlale', naqxtojqwitz nnok: inche kyimju' b'a'n xjal extzun b'a'n wnaqqe', ate'tzuntl xjal myab'a'n kyb'inchb'aj nche anq'in nimtoj.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />Lalun tz'oka b'a'nxjalile,</para>
  <para style="q">ex lalun tyek'uxi'x tnab'la.</para>
  <para style="q">¡Titi' ktyaju'ya'xi'x tib'a!</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Lalun tz'oka txkupxi'x,</para>
  <para style="q">ex lalun naq tyo'ka.</para>
  <para style="q">¡Qu'n jaku' tz'el tchwinqlala lwiy!</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Ate b'a'n tu'n qtzyunte ja'lu b'a'nxi'x</para>
  <para style="q">ex mixti' tu'n txi' qtzaqpi'nju' juntl.</para>
  <para style="b" />
  <para style="q">Alkyete nniman te Qman Dyos</para>
  <para style="q">k'elel b'a'n toj tkyaqil ja'lu.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Nimxi'x tipumalju' ati tnab'l tu'n nab'l,</para>
  <para style="q">kyekywitz lajoj kawil toju' nintnam.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Mixna' a'lo'te jun xjal twitz tx'otx' majxwit tz'aqli, o'kxwitju' b'a'n ntb'incha'n exwit min nb'inchan il.</para>
  <para style="p">
    <verse number="21" style="v" />Lalun txitoksla'na tkyaqilju' nq'umli, laytzun tb'i'tza aj tyolinju' tmajina taq'wix ti'ja. <verse number="22" style="v" />Expena' ikxta, kanlixi'x twitza, b'a'npun majxi' yolina kyi'j txqantl.</para>
  <para style="s1">Tjyonjtzju' nab'l</para>
  <para style="p">
    <verse number="23" style="v" />Ik'nwitze' ti'j tkyaqil ja'lu tuk'i'l nab'l, qu'n kub' nq'o'ne' toj wanmiye' tu'n woke' atixi'x nnab'le'; mixtzunti'x npon kanune' ti'j. <verse number="24" style="v" />¡Mixti'x nchinpon kanune' kyi'j tkyaqilju' ati! Nimxi'xte' t-xilen. ¿Alxi'xkye kpomel kanun ti'j?</para>
  <para style="p">
    <verse number="25" style="v" />Oktililtzuntz wu'ne' tu'n tten wojtzqib'le', ex nxnaq'tza wib'e' tu'n tel yalju' nab'l wu'ne'. Eltzun nnik'tze' ti'j qa myab'a'nte' xnakyil, ex tontilte' xtrakyil.</para>
  <para style="p">
    <verse number="26" style="v" />Matxi' tz'el yal jun ti'xti' wu'ne' kuwxi'x tk'ayil kyetwitz kamik: aju' qya chab'axi'x nkub' twitz ichan tu'n ex nkuttz'u'li'n kyu'n tq'ob'. Alkye nniman te Qman Dyos ktzopajel toj tq'ob', atzu'n aj il kb'eltz'aq toju' t-xpatxab'.</para>
  <para style="p">
    <verse number="27" style="v" />Tej soktilil wu'ne' tu'n tjyet chik'b'ab'l titiqu'n nb'aja' junjun ti'xti', ayine' pakb'al, el nniky'e' ti'j ikjalu: <verse number="28" style="v" />¡na'mx tknetju' injyo'ne'! naq junku' ichan matxi' tz'el yal wu'ne' kyxol kab'k'al lajnaq (1,000), atzun mixti'x jun qya kyxol kykyaqil. <verse number="29" style="v" />O'kxte matxi' tz'el yalju' wu'ne': tz'aqlite' ichan kub' tb'incha'n Qman Dyos, axtzunte nkub' b'o'ljsantetib'.</para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />¿Alxi'xkye jun kpomel kse'n ati tnab'l? ¿Alkye ojtzqilte tnab'l junjun ti'xti'? Inspik'e' twitzju' xjal tu'n nab'l; ex ntch'exb'e'n twitzju' xjal tx'u'j.</para>
  <para style="s1">Ninb'ilteju' nimaqkawil</para>
  <para style="p">
    <verse number="2" style="v" />Japunx tchaq'b'il nimaqkawil tu'na, qu'n ikyxittziya'nju' twitz Qman Dyos. <verse number="3" style="v" />Lalun tz'etza ojqel twitz. Lalun tz'okx tq'o'ntib'a kyoju' myab'a'n, qu'n jaku' tb'incha ti'xku' tajb'il ti'ja. <verse number="4" style="v" />Ate nimaqkawilju' nchaq'un, ex mixti'x tu'n tchik'b'ante te juntl ti'ju' ntb'incha'n. <verse number="5" style="v" />Alkyete njapun chaq'b'il tu'n, lay tzaj taq'wix ti'j, alkyetzunte ati tnab'l nkane toj twitz jtoj ex se'ntaq'wi tu'n tjapunju' chaq'b'il tu'n. <verse number="6" style="v" />Axxi'x, ati jun kmuj ex jun tu'me'l tu'n kyb'inchet tkyaqilju' ati tu'n kyb'inchet, naqtzun a ch'uẍju' te xjal <verse number="7" style="v" />mixti'x b'i'n tu'n titi' kb'ajel, ex mix-a'lo' jun tu'n tb'ant tmantepun te.</para>
  <para style="s1">Mix-a'lo'te ati toklen tib'aju' chwinqlal ex tib'aju' kamik</para>
  <para style="p">
    <verse number="8" style="v" />Mix-a'lo'kye jun ati toklen tib'aju' chwinqlal, tu'nwt tten tu'n, ex mix-a'lo'kye ati toklen tib'aju' kamik. Mix-a'lo'te kb'entel toq teju' q'oj lu. Lay kletju' b'inchal myab'a'n tu'nju' til.</para>
  <para style="p">
    <verse number="9" style="v" />El nniky'e' ti'j tkyaqil ja'lu tej toknxon nk'u'je' tu'n wojtzqinteju'ye' nb'inchet twitz tx'otx', exju' ntb'incha'n xjal myab'a'n ti'j twnaqil.</para>
  <para style="s1">Ate' ti'xti' mixti'x kytx'o'lajil</para>
  <para style="p">
    <verse number="10" style="v" />Ex matxi' wile' inxi'x jaw nima'nju' xjal b'inchal myab'a'n ajt-xi muqb'aj; atzunju' xjal b'a'n tb'inchb'aj, miẍpeti'x ntzaj toju' ttnam. Mixti'xte' lu ttx'o'lajil, <verse number="11" style="v" />qu'n qa mixti'x xkub' tz'e'yset twitz lwiy tu'nju' il xtb'incha, atzuntzu' nnokxa' ten toj twi' tu'n tb'inchante naqx taq'wix. <verse number="12" style="v" />¡Ikytzu'n nimtoj nnanq'inju' xjal nb'inchan il ex ljo'n tb'inchan il! (Atoqwe' b'i'n wu'n qa b'a'n nche'xa'ju' nche niman te Qman Dyos ex nche k'ulun te; <verse number="13" style="v" />aye'tzu'n b'inchal myab'a'n toj myab'a'n nche'xa' ex nche ik' kse'n leku'n qu'n min nche niman te Qman Dyos.) <verse number="14" style="v" />Iktzun nb'ajiju' twitzu' tx'otx', mya tu'me'l nche yajtiju' b'a'n xjal naku'j b'inchal taq'wixqe', aye'tzu'n b'inchal myab'a'n inxi'x che achun ku'xi'xtej b'a'n xjalqe'. ¡Mixya tu'me'lte' ja'lu toj nwitze'!</para>
  <para style="p">
    <verse number="15" style="v" />Qu'mtzun a b'a'nju' tzalajb'il toj nwitze'. Ex ate b'a'nju' tu'n tb'inchante xjal twitz tx'otx', aju' tu'n twan, tu'n tk'wan ex tu'n ttzalaj, qu'n o'kxte tu'n tnik'b'enteju' tu'n taq'un ntb'incha'n toju' tchwinqlal ntzaj tq'o'n Qman Dyos twitzju' tx'otx' lu.</para>
  <para style="p">
    <verse number="16" style="v" />Tetzunj intoq oktililxi'x wu'ne' tu'n tkane ex tu'n tel nnik'e', ex tu'n nka'yinteye' tkyaqilju' nb'inchet twitzju' tx'otx'. In pon jun kmuj mixti'x nnok qwatl tu'n tpaj, <verse number="17" style="v" />apete' el nnik'ju'ye' ti'j qa min nkaneju' ntb'incha'n Qman Dyos toj twitzju' xjal exju' nb'aj twitz tx'otx'. B'a'nqa matz'oktilil tu'n, tu'n tknetu' tzaq'web'l, layx knet tu'n; maskyepe' matmaju' ati tnab'l qa ojtzqi'n tu'n, axxi'x na'mx teltnik' ti'j.</para>
  <chapter number="9" style="c" />
  <para style="s1">Se'nju' Chwinqlal ex se'nju' kamik</para>
  <para style="p">
    <verse number="1" style="v" />Matz'oktilil wu'ne' naqx tu'n tel nnik'e' ti'j qa toj tq'ob' Qman Dyos ta' kyaq'un b'a'n xjal ex kyaq'un ati kynab'l. Min b'i'n tu'nte xjal ti'ju' tk'u'jlalil ex ti'ju' ik'jtib'il, b'a'ntzun qa twitzx ta'qe'. <verse number="2" style="v" />T-ximanjtz b'a'nxi'x, ax che ik'ela' kykyaqil: kyi'j tnik'alkyi'j ex kyi'ju' mya tnik'alkyi'j, kyi'j b'a'n xjal ex kyi'ju' txkup xjal, kyi'j b'a'n kychwinqlal ex kyi'ju' myab'a'n kychwinqlal, kyi'j nkub' kyq'o'n chojb'il ex kyi'j min nche q'on chojb'il; ikx kb'ajelju' kyi'ju' min nche b'inchan il kse'nx kyi'ju' b'inchal il, kyi'ju' nkytziya'n jun kyol ex kyi'ju' min kytziya'n kyol.</para>
  <para style="p">
    <verse number="3" style="v" />Atzun myab'a'nju' tu'n tkyaqilju' nb'aj twitz tx'otx': tu'n ax che ik'ela'ju' kykyaqil. Expena' nojni tnab'lu' xjal tu'n myab'a'n; inkub'ti'j tnab'l tu'n xnakyil toj tkyaqilju' tchwinqlal; inpon b'ajtzuntz toj muqb'il.</para>
  <para style="p">
    <verse number="4" style="v" />Q'uqlixi'x tk'u'jlalilju' xjal atix tchwinwqlal, qu'n ate b'a'n jun tx'yan itz' kyetwitz jun b'alun kyimni. <verse number="5" style="v" />Exqepe' itz'qe' b'i'n kyu'n qa che kyimel, aye'tzu'n kyimniqe'tl mixti' b'i'n kyu'n ex mixti'xte nkykanb'a'n, qu'n majx nnik' kyna'l. <verse number="6" style="v" />Atzuntzu' nb'aja' kyk'u'jlalil, kyq'oj ex kyxim, ex milo tu'n kyula'tl b'inchal jun ti'xti' twitz tx'otx'.</para>
  <para style="p">
    <verse number="7" style="v" />¡Qu'mtzun, kuwxa! Q'onku'x twaya titk'u'ja; q'onku'x tk'wa'ya b'in titk'u'ja, qu'n b'a'n ẍe ela' taq'una twitz Qman Dyos. <verse number="8" style="v" />Q'onk ti'ja saq kukxju'; ex sunkxa k'ok'sb'il toj twi'ya kukxju'. <verse number="9" style="v" />Tzalajxa atl junjun kmuj tuk'i'lju' t-xu'jila toju' tchwinqlala mixti'x ttx'o'lajil saj tq'o'n Qman Dyos twitz tx'otx'; qu'n o'kxte ktkanb'a'ju'ya tu'n txqan taq'una ntb'incha'na twitz tx'otx'. <verse number="10" style="v" />Ex B'inchama tu'n tkyaqil tk'u'ja tkyaqilju' kb'antel tb'inchanteya; qu'n mixti'tlte tu'n tb'inchet toju' muqb'il jakpomela'ya ex mixti'te tu'n t-ximet, mixti'te ojtzqib'l ex nab'l.</para>
  <para style="s1">Mya tnik'alti'ju' nb'aj toju' chwinqlal</para>
  <para style="p">
    <verse number="11" style="v" />Matxi' wile' junjuntl ti'xti' twitz tx'otx', myaye' kuw che ojqelan nche kanb'an toj jun sqach, ex myaye' kuw che q'ojin nche kanb'ante q'oj; mya o'qe'kxju' ati kynab'l ati kywa, ex mya o'qe'kxju' k'atzkywi' q'inunqe', ex mya o'qe'kxju' xnaq'tza'nqe' b'a'n kyilwi; tkyaqil ja'lu teylex junjun. <verse number="12" style="v" />Toj juntl tu'me'l, mix-a'lo' jun b'ilte jtoj pon q'ij te: kse'nqe' kyiẍ ajkytzyet tu'n tzuyb'ilkye exqe' pich' toj xpatxab', ikxtzunte xjalju', mixti' tnab'en ti'j ajtok takpuj twitz jun ti'xti' myab'a'n.</para>
  <para style="p">
    <verse number="13" style="v" />Ex matxi' wil juntl ti'xti'ye' twitz tx'otx', inok te jun nimaq xnaq'tzb'il weye': <verse number="14" style="v" />jun b'o's nintnam, naqjte'x xjal toj, oktzaqpaj jun nimaqkawil kuw q'ojil ti'j, b'aj tmqo'n ti'jile tu'n tkub'ti'j tu'n. <verse number="15" style="v" />Ex najli jun xjal prow, extzun ati tnab'l, toju' nintnam, ex b'ent tklonteju' nintnam tu'n tnab'l, ¡ex mix-a'lo'te ntzaj na'nte!</para>
  <para style="s1">A nab'l ati tib'aj tkyaqil ti'xti'</para>
  <para style="p">
    <verse number="16" style="v" />Atzu'n nchiwe', ana'te b'a'nju' ati qnab'l kyetwitz kuwqo', maskyepe' min nxib'i'n tnab'lju' xjal prow, ex min nkub'i'nju' tyol.</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />Ate b'a'n tyol jun xjal ati tojtzqib'l chab'a' nb'aj tma'n,</para>
  <para style="q">kyetwitz tyol jun kynimaqkawil xnak nxi'x ẍalb'i kuw.</para>
  <para style="q">
    <verse number="18" style="v" />Ate ojtzqib'lju' nim toklen</para>
  <para style="q">kyekywitz aq'unb'il te q'ojb'il.</para>
  <para style="b" />
  <para style="q">Naq tu'n jun ti'xti' myab'a'n sela'</para>
  <para style="q">intzaja' nim xitb'il.</para>
  <chapter number="10" style="c" />
  <para style="q">
    <verse number="1" style="v" />Tu'n jun a'jin kyimni</para>
  <para style="q">nkub' tzu'wixa' tb'anil k'ok'sb'il.</para>
  <para style="b" />
  <para style="q">Ikytzu'n, anajte nnokq'o'n toklenju' naq toj twitz xjal nok</para>
  <para style="q">kyetwitzju' ojtzqib'l nimxi'x toklen.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Atzu' nximana'te' xjal ati tnab'l ti'ju' b'a'n,</para>
  <para style="q">atzunte' xnak ti'ju' myab'a'n.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Toj tkyaqilju' ntb'incha'n xjal xnak,</para>
  <para style="q">intyek'u'n qa mixti'x tnab'l,</para>
  <para style="q">maskyepe' intma'n</para>
  <para style="q">qa mixti'x nche ximanju' txqantl.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Qama tzaj ttx'u'jilju' nkawin ti'ja; lalun tzaj pa'l toj twi'ya,</para>
  <para style="q">ate q'a'nb'ilju' qa myab'a'n sela' jun ti'xti',</para>
  <para style="q">tu'n tnk'et chab'a mya tuk'i'l qtx'u'jil.</para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" />Oje wile' jun taq'wix nb'inchanjtz twitzju' tx'otx' lu, ex aye'ku' kawil inche b'inchante: <verse number="6" style="v" />aju' xjal min nximan nxiq'o'n jun toklen nimxi'x, aye'tzu'n xjal ati tnab'l naqch'i'n toklen nxiq'o'n. <verse number="7" style="v" />Oje che wile' lq'o'n majin iqa'nqe' tu'n chej, aye'tzu'n kyk'wal nimaqkawil nche b'et tu'n kyqan naku'j tq'o'n majinqe'.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Alkyete ma ku'x tb'incha'n jun jul,</para>
  <para style="q">axte nku'x tz'aq toj.</para>
  <para style="b" />
  <para style="q">Alkyete nlaqun nimaqtapi</para>
  <para style="q">nnok tx'a'n tu'n kan.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Aju' jsol ab'j,</para>
  <para style="q">nk'ixb'i tu'n tjosli ab'j.</para>
  <para style="b" />
  <para style="q">aju' npa'n toj si,</para>
  <para style="q">jaku' tz'ok ttx'e'mu'ntib'.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Qama b'aj twitzteju' k'uxb'il pab'l toj si</para>
  <para style="q">exqa min xjqetl twitzte,</para>
  <para style="q">ati tu'n tokxi'xtl qipumal ti'j.</para>
  <para style="q">Ate b'a'nju' tu'n qaq'unan b'a'n tuk'i'l nab'l.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />¿Titi' k'ajb'ela' jun xjal nkub' mansix kan tu'n,</para>
  <para style="q">extzunqa matxi'toq tx'a'nju' kan?</para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" />Inche tzalaj xjal ti'j tyolju' xjal ati tnab'l,</para>
  <para style="q">atzu'n xnak nkub' b'o'lj tu'nxju' tyol:</para>
  <para style="q">
    <verse number="13" style="v" />Ajtaq'wi yolil mixti'x ttx'o'lajil tyol,</para>
  <para style="q">ex nb'aj tyolin kyi'j xlab'yol.</para>
  <para style="q">
    <verse number="14" style="v" />¡Majx ati txqan tyolju' xjal xnak!</para>
  <para style="b" />
  <para style="q">¿Alxi'xkye jaku' q'mante titi' tzul,</para>
  <para style="q">mixna' a'lo'kyete b'ilte ti' tzul yajxi'tl?</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Inxi'x tb'yo'ntib'ju' xjal xnak tu'n taq'unan,</para>
  <para style="q">ex min tojtzqi'n tb'eyilu' nintnam.</para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" />¡Qab'anx twitzju' tx'otx', k'walju' tnimaqkawil,</para>
  <para style="q">qa nche sqixinju' tk'wal nimaqkawil</para>
  <para style="q">tu'n kyten kyoj nimaqwan!</para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" />¡B'a'nxi'x teju' tnam tok jun tnimaqkawil nimaqxjal,</para>
  <para style="q">ex nche wanju' kawil toj</para>
  <para style="q">tojxi'xju' kmuj tu'n kywan,</para>
  <para style="q">tu'n toktl kyipumal,</para>
  <para style="q">mya tu'nwt kyaq'wi tx'ojtel!</para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" />Naq ntyo'nkju' xjal ky'aj ajtku'tz tz'aq twi' tja;</para>
  <para style="q">naq chle'n tq'ob', naq nka'yin ajtkub' xitju' tja.</para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" />Kyejni q'o'n qwa tu'n qtzalaj,</para>
  <para style="q">exju' ta'l ub'a tu'n tku'x qnik'b'e'n toj qchwinqlal;</para>
  <para style="q">naq a mixti' pwaq te.</para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" />Lalun yolina ti'ju' nimaqkawil</para>
  <para style="q">naqpe' toj tnab'la.</para>
  <para style="b" />
  <para style="q">Lalun yolina taq'wix ti'ju' q'inun, b'a'nqa tjunala toj twitza,</para>
  <para style="q">qu'n nche lipanju' pich', jaku' che b'ajx q'malte te.</para>
  <chapter number="11" style="c" />
  <para style="q">
    <verse number="1" style="v" />Chtonxa twaya toj a';</para>
  <para style="q">kna' tk'ma'ta tu'me'l t-xel yajxi'tel.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Aq'punku'ya ati teya kse'nxju' mab'ent tu'na,</para>
  <para style="q">qu'n min b'i'n tu'na titi' jaku' tzaj tib'aju' tnam.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Qa jupli muj twitz kya'j,</para>
  <para style="q">tzul jb'aj twitz tx'otx'.</para>
  <para style="b" />
  <para style="q">Qama kub'tz'aq jun tze toj tnayaj q'ij,</para>
  <para style="q">mujqa toj tb'a'nq'ob'kya'j,</para>
  <para style="q">axtzuntzu' kjela'ten</para>
  <para style="q">jama kub'a' tz'aq.</para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" />Alkyete matz'okten twitz ti'ju' kyq'iq', lay tz'awan,</para>
  <para style="q">ex alkyete matz'okten twitz ti'ju' muj, lay jaw tawal.</para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" />Ikxtzu'n kse'n min b'i'n tu'na janxa' kyq'iq', ex kse'n nch'iya'ju' ne'ẍ toj t-xmilal ttxu, ex min b'i'n tu'na titi' ntb'incha'n Qman Dyos, ju' b'inchante tkyaqil ti'xti'.</para>
  <para style="p">
    <verse number="6" style="v" />Awanxa tijaja prim ex awanxa te qale', qu'n minti' b'i'n tu'na alkye k'elelb'a'n, qa aju' tnejel awal mujqa aju' tkab', mujqa kykab'il.</para>
  <para style="p">
    <verse number="7" style="v" />Majx tb'anilxi'xju' spik'un, ex b'a'n tu'n qka'yinteju' q'ij tu'n qwitz; <verse number="8" style="v" />naqtzun aju' maskye maqo' anq'in b'a'npun ab'q'i twitz tx'otx' ex maqo' tzalaj toj, na'nku'ya qa nimxi'x tq'ijlalil qxopin tzul ex mixti'x ttx'o'lajil tkyaqilju' tzul.</para>
  <para style="s1">Nab'l kye ku'xun</para>
  <para style="p">
    <verse number="9" style="v" />Tzalajxa ja'lo ku'xun, tzma ku'xunku'ya, tzalajxa toju' b'a'n ja'lo qu'n kb'entel tu'na. B'inchama tkyaqilju' makub' t-xima'na exju' matz'ok tka'yi'na, majxtzun na'nku'ya, jun q'ij k'okyela toj xjel tu'n Qman Dyos ti'j tkyaqil ja'lu. <verse number="10" style="v" />Lalun txib'ajtl tk'u'ja ti'ju' ati toj tnab'la ex pa'mil tib'a ti'ju' yajb'il, qu'n ikxpete' tq'ijlalil ku'xumal mixti'x ttx'o'lajil.</para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Na'ntzju'ya ch'isalteya, ku'xunku'ya ja'lo ex na'mxku' toka toju' tq'ijlalil ch'uẍ; tzul tq'ijlalil ja ktma'ya'ya: Mixti'x inchin tzalajwe' toju' nchwinqlale', chiloya. <verse number="2" style="v" />B'inchama ja'lo, na'mxku' kyupj q'ij, xjaw ex che'w, ex namxku' tanjtztlti'j muj tik'lenxi' jb'al. <verse number="3" style="v" />Kpomel tq'ijlalil che lu'lulju' xq'uqil ja, ex che b'eltz'umju' ichan kuwqe'xi'x; kche b'aje'lju' cheb'l, ex lay b'ent kychentl; che najel kywitzju' nche ka'yimitz kyoj tokexspik'un, <verse number="4" style="v" />ajtul kanunju' tq'ijlalil lu, che jpetelju' ttzija toj b'e, lay che q'ojq'ojixtlju' cheb'l wab'j; Kukx kyoq'kye pich'ju', atzunta lay che tb'itla; <verse number="5" style="v" />kxob'ela aj tjax b'eta twitz jawl ex xob'ajilx tu'n tb'eta toj b'e.</para>
  <para style="b" />
  <para style="q">Kb'el saqax twi'ya,</para>
  <para style="q">lay tipatla tu'n tb'eta</para>
  <para style="q">lay tna'tla tk'ok'jal jun ti'xti' ajt-xi' twana.</para>
  <para style="q">Xi'na' t-xi'te xjal toju' tnajb'il tejumajx,</para>
  <para style="q">kb'injtzelju' oq'e'n toj b'e ajtkyima.</para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" />Na'ntzju'ya b'inchanteya, na'mxku' tlaqju' ky'jaj saqpwaq ex na'mxku' tpaxju' k'wil q'anpwaq; ex na'mxku' tpaxju' xar ttziju' t-xiklil a' ex na'mxku' tkupilju' tul tu'nb'il a' tib'aj xoch. <verse number="7" style="v" />Qu'n ajtzun kyik' ja'lu, k'anjelti'ju' quq toj tx'otx', kse'nxtoq tten nejtl, atzunju' xewb'aj k'anjel jumajtlti'j tk'etz Dyos, qu'n a tzaj q'onte.</para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" />Inxinma'n jumajtel, ayine' pakb'al:</para>
  <para style="q">¡Mixti'x ttx'o'lajil, mixti'x ttx'o'lajil!</para>
  <para style="q">¡Tkyaqil mixti'x tajb'en!</para>
  <para style="s1">Mankb'il yol</para>
  <para style="p">
    <verse number="9" style="v" />Tu'ntzu'n nim tnab'lju' pakb'al ten, nim ojtzqib'l b'axtma'n kyeju' xjal. Ex oktq'o'n tilil tu'n teltnik' kyi'j txqan yol tuk'i'l nab'l ex eb'aj tnk'u'n kse'nxju' kynab'l. <verse number="10" style="v" />Oktq'o'n tilil tu'n kyel yal yol atixi'x kyajb'en, ex tu'n kytz'ib'etu' yol ax ttxolilxi'xkyi'j.</para>
  <para style="p">
    <verse number="11" style="v" />Ikyqe' yolju' kyu'n xjal ati kynab'l kse'n ch'ut, ajtzun kyb'aj b'u'yi'n nk'u'nile kyten ikyqe' kse'nqe' stak awa'nqe' b'a'nxi'x naq tu'n jun k'ik'lel. <verse number="12" style="v" />Nimaq oqxenb'il inetz qu'n kyoj. Layx b'ajte' ttxa'n tu'n kyb'aj tz'ib'et u'j, exqa nim nqxnaq'tza'nqib' inqo' sikti.</para>
  <para style="p">
    <verse number="13" style="v" />Matxi' pon b'aju' pakb'ab'l. Matxi' b'aj chik'b'et tkyaqil. Nimana te Qman Dyos ex che japunxju' tchaq'b'il tu'na, qu'n atzunte xjalju' ati tu'n tb'inchante. <verse number="14" style="v" />Qo okyel toj xjel tu'n Qman Dyos ti'j tkyaqilju' qb'inchb'en, qa b'a'n mujqa taq'wix, b'a'ntzun qa toj ewaj xqb'inchaya'.</para>
</usx>