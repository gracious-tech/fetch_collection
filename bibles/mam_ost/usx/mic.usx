<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="MIC" style="id">MIC Marzo 2009 Pedro D. Cabrera Mam Ostuncalco. Updated for DBL by G. Grasso and E. Canales, December 2012, standardization after migration to PT8 by A. Camus March, 2019.</book>
  <para style="h">Miqueas</para>
  <para style="toc3">Miq</para>
  <para style="toc2">Miq</para>
  <para style="toc1">Tuj Mikey (Miqueas)</para>
  <para style="mt1">TUJ MIKEY</para>
  <para style="mt2">(Miqueas)</para>
  <para style="imt">CHIK'B'AB'L</para>
  <para style="ip">Axjunte Mikey kxolju' kyaje' t-sanjelal Dyos nimaq kyoklen toju' tkab'k'al (siglo VIII) ab'q'i na'mtoq tul Krist, ex junx kyab'q'iyil tuk'i'l Isayiy. Ate Mikey kanlixi'x twitz qa ate Juda, janajla' ex ja npakb'ana' toj kojb'il, ikx kb'ajilteju' kse'nte Israel, k'ik'el ti'j kse'n oje tma Amos (caps. 1-3). Ax tpakb'a Mikey junx kyuk'i'l txqantl t-sanjelal Dyos, aju' kyma tqanil ti'j tz'e'ysb'il witzb'aj tzultoq tu'n Dyos, exju' kpakb'ab'l tib'aju' xjansajtib'il, tnik'alil ti'j ex tu'n ati Dyos tib'aj tkyaqil. Ex nyolin Mikey ti'ju' tk'u'jlalil Dyos: aju' Dyos ntzaj q'onte tz'e'ysb'il witzb'aj ex ax Dyosju' nkub'najsante qil. Qu'mtzun ntma'na' Mikey tqanil ti'ju' mankb'il tq'ijlalil aj kykotpet xjal tu'n Dyos ex aj knajan toj nak'b'il (caps. 4 ex 5). Atzu'n b'ajsb'il teju' u'j lu nyolin ti'j tzak'b'il ex q'uqb'ab'l k'u'jb'aj, tu'nju' nttziya'n Dyos tu'n kykolpetju' xjal tu'n toj il.</para>
  <para style="ip">Ex intma'n tqanil ti'j jun nimaqkawil k'eletz toj tja Dab'i, aju' in nayonjtz ex sk'o'ntl, atzu' k'itz'jela' toj B'elen Eprata (5.2-5a), ex intma'n toj Mt 2.6 ja ntma'na' tqanil ti'j titz'jlen Jesus toju' tnej tx'otx' lu.</para>
  <chapter number="1" style="c" />
  <para style="s1">Tze'ysb'il kywitz aj Samarya tu'n Qman Dyos</para>
  <para style="p">
    <verse number="1" style="v" />A tqanil ja'lu tzaj tq'o'n Qman Dyos te Mikey te tnam Moreset, exju' xitma'n te toj naku'j witzik' ti'ju' tnam Samarya ex Jerusalen, toju' tq'ijlalil tej intoq che kawinju' nimaqkawil Jotam, Akas ex Esekyiy toj tnam Juda.</para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" />Kyb'inku'ye' lu kykyaqile' tnam;</para>
  <para style="q">aye'ye' najlqe'ye' toju' tx'otx' lu, kb'inku'ye' b'a'nxi'x:</para>
  <para style="q">Aku' Qman Dyos k'okel te tziyal,</para>
  <para style="q">tzmaxtzu' toju' tja xjan kyi'je'.</para>
  <para style="q">
    <verse number="3" style="v" />K'eletzte Qman Dyos janajla'</para>
  <para style="q">ex kb'etel kwi'ju' witz ajtul.</para>
  <para style="q">
    <verse number="4" style="v" />Kche kb'el niwju' witz tjaq' tqan</para>
  <para style="q">naku'j ser nkub' niwj tu'n q'aq',</para>
  <para style="q">aye'tzu'n b'ya' kche kb'el aq'puj toj kab'e'</para>
  <para style="q">kse'n nxi' xaqix tu'n jun tnimal a'.</para>
  <para style="q">
    <verse number="5" style="v" />Tkyaqil ja'lu naq tu'n tpi'salu' ttanam Jakob',</para>
  <para style="q">tu'n tpaju' il toj kawb'il te Israel.</para>
  <para style="q">¿Jatzunta'ju' tpi'sal Jakob'?</para>
  <para style="q">¡Toju' tnam Samarya!</para>
  <para style="q">¿Ex jatzun ta'qe'ju' ja xjan kye txqantl dyos te Juda?</para>
  <para style="q">¡Qa myatzu' toj Jerusalen!</para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" />Qu'mtzun ntma'n Qman Dyos kjalu:</para>
  <para style="q">Naq tik'lentlte' nintnam Samarya kjelten wu'ne',</para>
  <para style="q">jun tnej tx'otx' tu'n tawet tqan ub'a.</para>
  <para style="q">Che kb'je'lix nxone' tab'jelju' nintnam toj b'ya'</para>
  <para style="q">ex che kjel q'ancha'lixju' tq'uqlil wu'ne'.</para>
  <para style="q">
    <verse number="7" style="v" />Kykyaqilju' witzleb' ate' toj majx che kjel b'uchj,</para>
  <para style="q">ex kykyaqilju' ẍwank xjansa'nqe' kyu'n che b'ajel patj tu'n q'aq'.</para>
  <para style="q">Qu'n ekub'incha'n tu'n kypwaq qya ajpajil,</para>
  <para style="q">kjawil b'ent jumajtl tex kypwaq qya ajpajil wu'ne'.</para>
  <para style="s1">Exch'yon toj tk'u'j Mikey</para>
  <para style="q">
    <verse number="8" style="v" />Qu'mtzun chin oq'ile' tu'n b'is nimxi'x;</para>
  <para style="q">qu'mtzun chin b'etele' mixti' nxajab'e' ex ẍb'iqlqine',</para>
  <para style="q">chin xo'jile' kse'n jun xo'j</para>
  <para style="q">ex chin ẍch'ile' kse'n jun pich' ab'estrus.</para>
  <para style="q">
    <verse number="9" style="v" />Qu'n mixti'tlte q'a'nb'il teju' tk'ixb'len Samarya:</para>
  <para style="q">matxi' ponju' k'ixk'oj toj tnam Juda</para>
  <para style="q">ex matxi' pon tzmaxtzu' toj Jerusalen,</para>
  <para style="q">toju' nintnam ja najla'ju' ntaname'.</para>
  <para style="q">
    <verse number="10" style="v" />Lalun txi' kyma'ne' lu kyeju' xjal najlqe' toj tnam Kat;</para>
  <para style="q">lalun che oq'e'.</para>
  <para style="q">Kytolimkyib'e' tu'n taq'len k'ixk'oj</para>
  <para style="q">toj quq te B'et-le-apra.</para>
  <para style="q">
    <verse number="11" style="v" />¡Kukxi'ye' toj juntl tnam aye'ye' najlqe'ye' toj Sapir,</para>
  <para style="q">ẍb'iqlqe'ye' ex elni kych'ixawe'!</para>
  <para style="q">¡Lay che etzju' xjal najlqe' toj Sanan!</para>
  <para style="q">¡Ati oq'el toj B'et-esel,</para>
  <para style="q">ex lay b'ent kyoninjtze' kyu'n!</para>
  <para style="q">
    <verse number="12" style="v" />Aye'ju' xjal najlqe' toj tnam Marot nkyxb'aq'la'nkyib' tu'n k'ixk'oj</para>
  <para style="q">naqxi'xwit tu'n telju' k'ixk'oj kyi'j,</para>
  <para style="q">qu'n ate Qman Dyos xb'inchante tu'n tpon kanun</para>
  <para style="q">taq'wixil ttzi nintnam Jerusalen.</para>
  <para style="q">
    <verse number="13" style="v" />Aye'ye' najlqe'ye' toj tnam Lakis,</para>
  <para style="q">mache okye' pi's kse'n Israel,</para>
  <para style="q">tu'n kpaje' xb'incha'na' il Syon,</para>
  <para style="q">che kyk'lonkye' chej kyi'j kykarwaje'.</para>
  <para style="q">
    <verse number="14" style="v" />Kypa'mil kyib'e' tejumajx ti'ju' tnam Moreset-kat.</para>
  <para style="q">k'okyilte' nintnam Aksib'</para>
  <para style="q">te trakpuje'n kyeju' nimaqkawil te Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" />Chi Qman Dyos:</para>
  <para style="q">Kyi'je' najlqe'ye' toj tnam Maresa,</para>
  <para style="q">ktzajel nchq'o'ne' jun xjal tu'n tkub'kyi'je' tu'n,</para>
  <para style="q">atzunju' sk'o'n b'a'nxi'x toj Israel</para>
  <para style="q">kxe'l ewal kyoju' jul te Adulam.</para>
  <para style="q">
    <verse number="16" style="v" />Atzunta nintnam Syon,</para>
  <para style="q">sk'o'jimilju'ya twi'ya techlalju' k'ixk'oj,</para>
  <para style="q">tu'n kpaju' tk'wala inxi'x che tk'u'jla'na.</para>
  <para style="q">B'ajsamilju'ya twi'ya tu'n tkyejtena sk'o'j kse'n ti'j twi' jun k'utz,</para>
  <para style="q">qu'n che kxe'lq'i'nju' tk'wala toj juntl tx'otx'.</para>
  <chapter number="2" style="c" />
  <para style="s1">Kyipumalju' nche' yajlan</para>
  <para style="q">
    <verse number="1" style="v" />¡Qab'anx kwitzju' xjal, naqpe' toj kwitzik'</para>
  <para style="q">nche' ximan tu'n kb'inchante myab'a'n,</para>
  <para style="q">ajtzun qsqix nkb'incha'n</para>
  <para style="q">qu'n tojna' kq'ob' ta'ju' oklenj!</para>
  <para style="q">
    <verse number="2" style="v" />Inxi'x che jamjon ti'j tx'otx', ex nkub' kyetza'n;</para>
  <para style="q">inxi'x che jamjon ti'j ja, ex nel kyelq'a'n.</para>
  <para style="q">Nche' yaju'n kye xjal, ex kyeju' toj kyja,</para>
  <para style="q">kyeju' tajaw exqe'ju' nche etzan.</para>
  <para style="q">
    <verse number="3" style="v" />Qu'mtzun ntma'n Qman Dyos:</para>
  <para style="q">Ex ikxwe' atiwe' nxim kyi'je'.</para>
  <para style="q">Ktzajel nq'o'ne' jun yajb'il kyib'aje',</para>
  <para style="q">ja lay b'enta' kyklete',</para>
  <para style="q">ex lalun che b'etle' tuk'i'l nimjtib'il</para>
  <para style="q">qu'n yajb'ilte' tq'ijlalil lu.</para>
  <para style="q">
    <verse number="4" style="v" />Toju' q'ij lu che b'itzanjtzel</para>
  <para style="q">b'itz kyeye' toj tq'ojq'ojel b'is. Chilo kq'manjtzel kyeye':</para>
  <para style="q">Majx matxi' qo' kub' xitune';</para>
  <para style="q">matxi' kub' xitu'n qtaname', teku' Qman Dyos,</para>
  <para style="q">junxi'tl tajaw ex mix-a'lo' jun xmyonte;</para>
  <para style="q">matxi' b'ajx aq'pu'n qtx'otx'e'</para>
  <para style="q">kxolju' ajq'oj ẍekanb'an qi'je'.</para>
  <para style="q">
    <verse number="5" style="v" />Qu'mtzun mixti' kyoklene' kxolju' ttanam Qman Dyos.</para>
  <para style="s1">Aye' myab'a'n sanjelal</para>
  <para style="q">
    <verse number="6" style="v" />¡Lalun che ule' q'mal tqanil tu'n Dyos qeye'! —chechij—.</para>
  <para style="q">¡Lay tzul kanunte' taq'wixil qi'j!</para>
  <para style="q">
    <verse number="7" style="v" />¿Ma atitzun qanb'en tib'aju' tnam Jakob'?</para>
  <para style="q">¿Matxi'tzun b'aj tpasensi Qman Dyos qi'j?</para>
  <para style="q">¿Ma iktzun ntb'incha'n Qman Dyosju'?</para>
  <para style="q">¿Ma mitzunjunti' njapunju' tyol</para>
  <para style="q">teju' nb'et toj tnik'alilti'j?</para>
  <para style="q">
    <verse number="8" style="v" />Matxi' che okmiltz'ujkye' ti'ju' ntaname'.</para>
  <para style="q">Inel kyelq'a'ne' kyi'ju' nanjtzkyi'j toj q'oj twi' wi'yal</para>
  <para style="q">chechiloye' qa matxi' che klete'.</para>
  <para style="q">
    <verse number="9" style="v" />Mache ex kxla'jane' qya</para>
  <para style="q">tojku' ktanam,</para>
  <para style="q">atzu'n kyeju' kyal</para>
  <para style="q">matz'elkyiq'i'nju'ye' oklenj xini nq'o'ne' kye.</para>
  <para style="q">
    <verse number="10" style="v" />Che we'ktze' ex kljom kb'eye',</para>
  <para style="q">mya ojb'ilte najb'il lu;</para>
  <para style="q">tu'nju' myab'a'n ati toj,</para>
  <para style="q">kb'el xitu'n jumajx.</para>
  <para style="q">
    <verse number="11" style="v" />Qa ati jun majaw t-xima'n chajyolil, exqa matma:</para>
  <para style="q">Kxe'l q'onte tk'wa'ya b'in ex q'e'n tu'n Qman Dyos,</para>
  <para style="q">atzun sanjelalju' lu chq'o'n teju' tnam lu.</para>
  <para style="s1">Ttziya Qman Dyos tu'n ttzaqpet ttanam</para>
  <para style="q">
    <verse number="12" style="v" />Che ktzajel nb'u'yi'ne' ttnam Jakob';</para>
  <para style="q">ex che kxe'l wiq'i'ne' jte'tl aj Israel ate'x.</para>
  <para style="q">Che okyel nb'uyi'ne' junx kse'nqe' rit toj ch'laj,</para>
  <para style="q">kse'nqe' rit toj k'ik'leb'l,</para>
  <para style="q">ex che kxe'l b'i'n naku'j txqan kb'aj,</para>
  <para style="q">
    <verse number="13" style="v" />Ate Qman Dyos kb'el nej yek'ulte kb'e,</para>
  <para style="q">aye'tzunkye che okyel lpe ti'j</para>
  <para style="q">ex atzu' che elixa' ttzi tjpel nintnam.</para>
  <para style="q">Kb'el neju' kynimaqkawil kwitz, aju' Qman Dyos.</para>
  <chapter number="3" style="c" />
  <para style="s1">Tqanil kyi'ju' myab'a'n kawil</para>
  <para style="q">
    <verse number="1" style="v" />Kyb'intze' ja'lo, e'kawil ex nejenel kyxol aj Israel,</para>
  <para style="q">¿ma mitzun jun nojqelan kyeye'</para>
  <para style="q">tu'n telkynik'e' ti'ju' tnik'alilti'j?</para>
  <para style="q">
    <verse number="2" style="v" />Atzunkye', nelkyik'u'nju'ye' b'a'n, ex nkyk'ujla'ne' myab'a'n;</para>
  <para style="q">nel kyi'ne' ttz'umalju' ntaname'</para>
  <para style="q">ex majx nkyej sji'lixju' tb'aqil kyu'ne'.</para>
  <para style="q">
    <verse number="3" style="v" />Nche'x kwanju'ye' ntaname' itz';</para>
  <para style="q">inel ktzaqu'nju'ye' tchib'jil ex nkub' ktoqi'nju'ye' tb'aqil;</para>
  <para style="q">iknela'ju' kyeye' kse'n chib'j nku'x toj k'wil.</para>
  <para style="q">
    <verse number="4" style="v" />Kpomil jun q'ij che txkole' ti'j Qman Dyos,</para>
  <para style="q">ex lay che tzaj tzaq'we'ne' tu'n.</para>
  <para style="q">Toju' tq'ijlalil lu kb'el tewa'ntib' kwitze'</para>
  <para style="q">tu'n tpaju' il matxi' kb'inchaye'.</para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" />Myab'a'n b'e ljo'n tu'nju' ntaname'</para>
  <para style="q">tu'n kpaju' nche sb'un sanjelal,</para>
  <para style="q">nxi' kpakb'a'n nak'b'il kyeju' nxi' q'o'n kwa kyu'n</para>
  <para style="q">qatzun min nxi' q'o'n kye nkma'n qa tzul q'oj.</para>
  <para style="q">Atzunte Qman Dyos ntma'n kyeju' sanjelal kjalu:</para>
  <para style="q">
    <verse number="6" style="v" />Lay kyk'amtlkye' tqanil</para>
  <para style="q">toj naku'j witzik' te qonik'an</para>
  <para style="q">ex lalun kmatle' ti'ju' tzul toj qlolj.</para>
  <para style="q">K'elexte' q'ij kyeju' sanjelal lu,</para>
  <para style="q">ex kb'el qloljixju' q'ij kye.</para>
  <para style="q">
    <verse number="7" style="v" />K'elil kych'ixawju' sanjelal lu exqe'ju' jyolkyi'j xjal.</para>
  <para style="q">Lay tz'eltl ktzi kykyaqil</para>
  <para style="q">qu'n lay che tzaj tzaq'we'ntl tu'n Qman Dyos.</para>
  <para style="q">
    <verse number="8" style="v" />Ayintzunwe' nojniqine' tu'n t-xew Qman Dyos,</para>
  <para style="q">ntzaj tq'o'n wipumale', tnik'alilti'j ex tu'n michin xob'aye',</para>
  <para style="q">tu'n txi' npajune' kpi'sal aj Israel exju' kyil kplajku'.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Kyb'intzju'ye' lu ja'lo, aye'ye' kawil ex nejenel toj Israel,</para>
  <para style="q">aye'ye' nelkyik'u'nju'ye' tnik'alilti'j</para>
  <para style="q">ex inel kypa'n kyib'e' ti'ju' ttxolilti'j,</para>
  <para style="q">
    <verse number="10" style="v" />njaw kyb'incha'ne' nintnam Jerusalen, tkub' twi' witz Syon,</para>
  <para style="q">tib'aj tq'uqlil b'yojxjali'n ex tib'aj mya tnik'alilti'j.</para>
  <para style="q">
    <verse number="11" style="v" />Nkyq'a' sb'u'kyib'ju' ajkawil toj nintnam tu'n pwaq,</para>
  <para style="q">exqe' pale naqx tu'n pwaq nche xnaq'tzana',</para>
  <para style="q">aye'tzuntlju' sanjelal majx chjo'nqe' ajkymante jun tqanil,</para>
  <para style="q">extzun nkma'n qa ati Qman Dyos kyuk'i'l. Qu'mtzun nkma'n:</para>
  <para style="q">Atite Qman quk'i'le';</para>
  <para style="q">mixti'te jun taq'wixil tzul qi'je'.</para>
  <para style="q">
    <verse number="12" style="v" />Qu'mtzun tu'n kpaje',</para>
  <para style="q">kjelu' Jerusalen, nintnam twi' witz Syon</para>
  <para style="q">naku'j q'uwaj,</para>
  <para style="q">naqx tik'lentl kjelten,</para>
  <para style="q">ex kb'el k'ulixu' witz jata' tja Qman Dyos.</para>
  <chapter number="4" style="c" />
  <para style="s1">Kawb'il toj nak'b'il tu'n Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Kjeltenju' witz ja tkub'a' tja Qman Dyos tejumajx</para>
  <para style="q">toju' tq'ijlalil tzul tjax chix.</para>
  <para style="q">A witzju' niminxi'x twe' ktenb'el;</para>
  <para style="q">niminxi'x k'okyela' kyekwitzju' txqantl witz.</para>
  <para style="q">Kykyaqilju' nimaqtnam kche ul twitz;</para>
  <para style="q">
    <verse number="2" style="v" />tnam xjal kche pomel ex kma':</para>
  <para style="q">Kuktzaje' qo'qe' jax twi' witz te Qman Dyos,</para>
  <para style="q">toju' tja Dyos janajb'ena' Jakob',</para>
  <para style="q">tu'n ttzaj tyek'u'nju' tb'eyil qe,</para>
  <para style="q">tu'ntzun qb'et tojku'xi'xju' tb'e.</para>
  <para style="q">Qu'n toju' tnam Syon k'eletza'ju' xnaq'tzb'il tu'n Qman Dyos,</para>
  <para style="q">toj Jerusalen tzula'ju' tyol.</para>
  <para style="q">
    <verse number="3" style="v" />Kkawilte' Qman Dyos kyib'aju' nimaqtnam,</para>
  <para style="q">ex kb'el tnk'u'nju' q'oj kxolju' tnam nim txqan kb'aj,</para>
  <para style="q">expe' kyeju' najchaq ta'qe'.</para>
  <para style="q">Che okyelju' kyk'uẍtx'e'nb'il te ktz'utz' kyu'n,</para>
  <para style="q">aye'tzunju' kych'ut te semu'l.</para>
  <para style="q">Mix-a'lo' jun tnam okwit kjawil tiq'i'ntl tq'aq' ti'j juntl tnam,</para>
  <para style="q">mujqa okwit tk'ma' xnaq'tzb'il tu'n tq'ojin.</para>
  <para style="q">
    <verse number="4" style="v" />Che anq'iltzuntz kykyaqil mixti'tlte' xob'il kyi'j,</para>
  <para style="q">ex b'a'n tu'n tojlan junjun</para>
  <para style="q">tjaq' t-xlekumalju' tqan tlob'aj ub'a ex iw.</para>
  <para style="q">¡Tyolku' Qman Dyos nimtipumal!</para>
  <para style="q">
    <verse number="5" style="v" />Nche nimankye' txqantl tnam kyexju' kydyos,</para>
  <para style="q">ayo'tzunqe qo' nimal te Qman Dyos Qdyos kukxju'.</para>
  <para style="s1">Ok tkla' Qman Dyos ttanam</para>
  <para style="q">
    <verse number="6-7" style="v" />Chi Qman kjalu:</para>
  <para style="q">Che kb'ajel nb'u'yi'nju'ye' nrite' toju' tq'ijlalil lu,</para>
  <para style="q">aye'ju' ojetoq kub' ntz'e'ysa'ne' kwitz;</para>
  <para style="q">aye'ju' kox, siktniqe' exqe'ju' b'ajxni slamj.</para>
  <para style="q">Kyuk'i'lkye, aye' ẍeb'aj kyejten,</para>
  <para style="q">kche okyel wu'ne' te jun nintnam ex kuw b'a'nxi'x.</para>
  <para style="q">Ayintzune' Dyos Manb'aj chin kawile' tib'aju' ntaname'</para>
  <para style="q">tzmaxtzu' twi' witz Syon, ja'lo ex tejumajx.</para>
  <para style="q">
    <verse number="8" style="v" />Atzunta Jerusalen, tka'yb'il ex tkuwal Syon,</para>
  <para style="q">toja kb'ela' jumajtlju' kawb'il,</para>
  <para style="q">kse'nxju' toklena nejtl tib'aj tkyaqil Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Atzu'n ja'lo, ¿tiqu'n inxi'x ẍch'ina</para>
  <para style="q">kse'n jun qya ati tch'on wnaq ti'j?</para>
  <para style="q">¿Ma tu'n tpaju' mixti' nimaqkawil kxole'?</para>
  <para style="q">¿Mujqa tu'n tpaju' matxi' che kyimju' q'ol knab'le'?</para>
  <para style="q">
    <verse number="10" style="v" />K'oyimtib'a ex ẍch'ina, nintnam twi' Syon,</para>
  <para style="q">kse'n jun qya ati tch'on wnaq ti'j,</para>
  <para style="q">qu'n kche elixju' xjal najlqe' toja</para>
  <para style="q">tu'n knajan toj kojb'il,</para>
  <para style="q">expe' kche pomel tzmaxtzu' B'ab'ilon.</para>
  <para style="q">Atzuntzu' ktkla'ya' Qman Dyos ttanam;</para>
  <para style="q">oktkla' kyeju' tajq'oj.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Ja'lo matxi' jaw kb'u'yi'nkyib'</para>
  <para style="q">txqan nimaqtnam ti'ja,</para>
  <para style="q">ex nkma'n: ¡Okxi'xpe'tzun qo' tzalajel</para>
  <para style="q">aj qka'yinte Jerusalen mixti'tl toklen!</para>
  <para style="q">
    <verse number="12" style="v" />Aye'kye' tnam lu mixti' b'i'n kyu'n</para>
  <para style="q">titi' t-xim Qman Dyos exju' nk'u'ntl tu'n;</para>
  <para style="q">min b'i'n kyu'n qa che kb'ajel tb'u'yi'n Qman Dyos</para>
  <para style="q">kse'n triy manoji'n toj er.</para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" />¡We'ktza ex triyina, nintnam twi' Syon!</para>
  <para style="q">Qu'n chi Qman kjalu:</para>
  <para style="q">Kxe'l nq'o'ne' tipumala kse'n tipumal jun tman wakx</para>
  <para style="q">k'uxb'ilqe' tuk'a, atzun q'ank'uxb'ilqe' t-xky'aq,</para>
  <para style="q">tu'ntzun kykub' t-xitu'n txqan tnama.</para>
  <para style="q">K'elel tiq'i'nju'ya kq'inumal myab'a'n kanb'ante</para>
  <para style="q">ex che ktzajel tiq'i'na weye',</para>
  <para style="q">weye', tajaw tkyaqil twitz tx'otx'.</para>
  <chapter number="5" style="c" />
  <para style="s1">Tzul q'onte' kawil Israel tu'n Qman Dyos</para>
  <para style="q">
    <verse number="1" style="v" />Atzu'n ja'lo, b'incham ttenju'ya kolb'ilteya, Jerusalen,</para>
  <para style="q">qu'n matxi' b'aj ktxoli'n kyib'ju' ajq'oj ti'ja,</para>
  <para style="q">ex kb'el ktz'e'ysa'n twitzju' nejenel te Israel kuwxi'x.</para>
  <para style="q">
    <verse number="2" style="v" />Atzunta B'elen Eprata,</para>
  <para style="q">tal b'o'sa kyxolju' txqantl tnam toj Juda,</para>
  <para style="q">xi'k'elitza' jun kawil te Israel toja,</para>
  <para style="q">k'itz'jel ti'j jun tyajajil ojtxi' xjal.</para>
  <para style="q">
    <verse number="3" style="v" />Che kjel ttzaqpi'nte Qman Dyos ttanam ja'lo,</para>
  <para style="q">naq o'kx aj tb'anixju' qya</para>
  <para style="q">nayon tu'n titz'jiju' tal.</para>
  <para style="q">Oktzun kb'ajel kmujb'a'n kyib'tz kyuk'i'lju' kwnaqil</para>
  <para style="q">aye' aj Israel exi'ni iq'i'n toj junxi'tl tx'otx'.</para>
  <para style="q">
    <verse number="4" style="v" />Kjawilwe'tzun nimaqkawiltz k'ik'lelkyeju' ttanam</para>
  <para style="q">tuk'i'l tipumal ex toklenju' Dyos Manb'aj,</para>
  <para style="q">aye'tzunkye kche anq'il toj nak'b'il,</para>
  <para style="q">qu'n knimanjtzel Qman Dyos</para>
  <para style="q">toj tkyaqil mankb'il twitz tx'otx'.</para>
  <para style="q">
    <verse number="5" style="v" />Ktenb'el nak'b'il tu'n.</para>
  <para style="q">Ajtkub' ktzyu'n aj Asirya qtanam</para>
  <para style="q">ex aj kyokx kyoju' tja kawb'il,</para>
  <para style="q">che kxe'l qchq'o'n</para>
  <para style="q">wuq nejenel ex wajxaq xjal nimaq kyoklen kyi'j.</para>
  <para style="q">
    <verse number="6" style="v" />Aye'kye che kawilju' toj Asirya,</para>
  <para style="q">aju' ttanam Nimrod, tu'n k'uẍtx'e'nb'il, kb'ela kyi'ju' aj Asirya,</para>
  <para style="q">ex qo' kletel kyu'n kye aj Asirya</para>
  <para style="q">ju' matxi'toq che b'jo'ktz toju' qtanam ex matxi'toq kub' ktzyu'nju' qtx'otx'.</para>
  <para style="q">
    <verse number="7" style="v" />Aye'tzu'n che kjelten toju' ttanam Jakob'</para>
  <para style="q">kxol txqan tnam</para>
  <para style="q">ikyche okyela' kse'n ta'l muj ntzaj tq'o'n Qman Dyos, ex kse'n jb'al ntzaj tib'aj k'ul,</para>
  <para style="q">ntzaj mya tu'n jun xjal.</para>
  <para style="q">
    <verse number="8" style="v" />Ex kxolju' txqan tnam</para>
  <para style="q">ja che kjela' jte'tl te ttanam Jakob'</para>
  <para style="q">che okyel kse'n jun b'alun kxol tojk'ul txkup,</para>
  <para style="q">kse'n jun b'alun kxol jun tnej rit,</para>
  <para style="q">nche b'aj ttzaqu'n ex majx nche kyajtb'yo'n,</para>
  <para style="q">ex mixti'te jun nb'ent toq twitz.</para>
  <para style="q">
    <verse number="9" style="v" />Iktzu'n k'okyela' tzaqpaja Qman Dyos</para>
  <para style="q">kyi'ju' tajq'oja, ex majx che kb'ajel tu'na.</para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" />Chi Qman Dyos kjalu:</para>
  <para style="q">Toju' q'ij lu che kb'el nb'yo'nju'ye' tcheja</para>
  <para style="q">ex che kb'el nxitunju'ye' tkarwaja te q'oj;</para>
  <para style="q">
    <verse number="11" style="v" />naq tik'lenxtlju' ninttanama kjelten wu'ne'</para>
  <para style="q">ex majx che kb'el nxitune' ja kuwsa'nqe' tu'na;</para>
  <para style="q">
    <verse number="12" style="v" />Che najelju' ajk'a wu'ne'</para>
  <para style="q">ex che mankulju' jyolkyi'j xjal wu'ne';</para>
  <para style="q">
    <verse number="13" style="v" />che kb'el nxitunju'ye' twitzileb'a exqe'ju' ab'j xjansa'nqe' tu'na,</para>
  <para style="q">tu'ntzun lalun k'uluntla</para>
  <para style="q">kwitzju' dyos ẍe kub' tb'incha'na.</para>
  <para style="q">
    <verse number="14" style="v" />Che jawitz nb'ultx'i'ne' tze xjansa'n tu'na</para>
  <para style="q">ex majx che kb'el nxitu'ne' nimaqttanama.</para>
  <para style="q">
    <verse number="15" style="v" />K'okyel tu'me'l t-xel wu'ne' toju' ntx'u'jile'</para>
  <para style="q">kye'ju' nimaqtnam min kyaj tu'n kniman weye'.</para>
  <chapter number="6" style="c" />
  <para style="s1">Tq'oj Qman Dyos kyi'j aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />Kyb'intzpe'ye' ja'lo ti' ntma'n Qman Dyos:</para>
  <para style="q">¡We'ktza ex chik'b'anxa tila kwitzju' witz,</para>
  <para style="q">ex tzajxwit b'i'n tq'ojq'ojel twi'ya kyu'nju' witz!</para>
  <para style="q">
    <verse number="2" style="v" />Kyb'intzpe'ye' aye'ye' witz,</para>
  <para style="q">exqe'ye' tq'uqlil tx'otx':</para>
  <para style="q">k'okyel tq'o'n Qman Dyos ttanam toj xjel,</para>
  <para style="q">ktzyetel jun q'oj tu'n ti'j Israel.</para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" />Lu ntma'n Qman Dyos kjalu:</para>
  <para style="q">Ktzaq'wentze' ntanam,</para>
  <para style="q">¿titi' oje nb'inchaye' kyeye' mujqa titi' myab'a'n xnb'inchaye' kyeye'?</para>
  <para style="q">
    <verse number="4" style="v" />Ayine' netz iq'inteya toj Ejipt, wu'ne' kletiya toj yajb'il;</para>
  <para style="q">e'tzaj nchq'o'ne' Moyses, Aaron ex Mariy,</para>
  <para style="q">tu'n kykub'nej kwitze'.</para>
  <para style="q">
    <verse number="5" style="v" />Ntanam, na'ntzpe'ju'ya t-xim B'alak, nimaqkawil toj Moab',</para>
  <para style="q">exju' tzaq'web'l xitq'o'n B'alaam te, tk'wal B'eor.</para>
  <para style="q">Na'ntza tej kyik'e' Sitim tu'n kpone' Kilkal,</para>
  <para style="q">ex tz'elx tnik'a ti'ju' tkanb'ab'l Qman Dyos.</para>
  <para style="s1">Aju' tajb'il Qman Dyos tu'n tb'ent kyu'n xjal</para>
  <para style="q">
    <verse number="6" style="v" />¿Titi' kxe'l wiq'i'ne' ajnxi'ye'</para>
  <para style="q">k'ulul twitz Qman Dyos te toj kya'j?</para>
  <para style="q">¿Ma kchin pomile' twitz kyuk'i'l tal tman wakx te jun ab'q'iqe',</para>
  <para style="q">tu'n kykub' q'et te chojb'il k'ok'sb'il?</para>
  <para style="q">
    <verse number="7" style="v" />¿Ma ktzalajel Qman Dyos qama kub' nq'o'ne' kab'k'al lajnaq (1,000) rit twitz</para>
  <para style="q">mujqa junmutx' jo'k'al (10,000) t-xiklil aseyt?</para>
  <para style="q">¿Mujqa tu'n txi' nq'o'ne' tnejel nk'wale'</para>
  <para style="q">tu'n tchjetju' nb'inchb'ene' myab'a'n exju' wile'?</para>
  <para style="q">
    <verse number="8" style="v" />Matxi'na' tzaj tma'nte' Qman Dyos teya, xjal,</para>
  <para style="q">titi'ju' b'a'n</para>
  <para style="q">ex titi'ju' tajb'il Qman Dyos teya:</para>
  <para style="q">tu'n tb'inchanteya tnik'alilti'j, tu'n toka tnik'alti'j ex b'a'n</para>
  <para style="q">ex tu'n tnimana te Qman Dyos tu'n tkyaqil tanmiya.</para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" />Ntxokonte Qman Dyos teju' nintnam,</para>
  <para style="q">ex ati qnab'l tuk'i'l qama txi' qb'i'n;</para>
  <para style="q">Kyb'intzpe'ye' tnam ex q'ol nab'l toju' nintnam:</para>
  <para style="q">
    <verse number="10" style="v" />Nim q'inumal myab'a'n kanb'ab'ente ati tjaju' xjal b'inchal myab'a'n,</para>
  <para style="q">exqe'ju' malb'il mya tz'aqlqe' nche elwik'o'ne'.</para>
  <para style="q">
    <verse number="11" style="v" />¿Se'n taq'wi kb'el nnajsa'ne' tilju'</para>
  <para style="q">najb'en malb'il txalchi ex mya tz'aqlqe' tu'n?</para>
  <para style="q">
    <verse number="12" style="v" />Kykyaqilju' q'inun toju' nintnam lu yajulqe';</para>
  <para style="q">kykyaqilju' xjal najlqe' toj chalyolqe' ex sb'ulqe'.</para>
  <para style="q">
    <verse number="13" style="v" />Qu'mtzun kb'el ntz'e'ysa'ne' twitza;</para>
  <para style="q">kb'el yajtiya wu'ne' tu'n tpaju' tila.</para>
  <para style="q">
    <verse number="14" style="v" />Layx qe tk'u'ja maskye mawana,</para>
  <para style="q">kukx kwe'yajtelju'ya;</para>
  <para style="q">qama txi' tk'u'n twaya, kb'el b'o'lj,</para>
  <para style="q">maskyepe' mak'u'yit ch'i'n tu'na, kb'ajelte' tu'n q'oj.</para>
  <para style="q">
    <verse number="15" style="v" />K'awala, ex lay jaw twitz tawala;</para>
  <para style="q">kb'el tchena aseytun, ex lay tnik'b'eya aseyt;</para>
  <para style="q">k'elil tyitz'o'na ta'l ub'a, ex lay txi' tk'wa'na ta'l.</para>
  <para style="q">
    <verse number="16" style="v" />Qu'n matxi' lpeya ti'ju' tchaq'b'il Omri exju' toj tja Akab'</para>
  <para style="q">ex matxi' tb'incha'na nkb'incha'n,</para>
  <para style="q">matz'ela junx kyuk'i'l kse'nxju' nkb'incha'n.</para>
  <para style="q">Qu'mtzun k'okyela wu'ne' exqe'ju' najlqe' toja majx taq'wixi'x ex ch'ixb'ajilx,</para>
  <para style="q">extzunju' tch'ixawju' ntaname' kb'eltz'aq tib'aja.</para>
  <chapter number="7" style="c" />
  <para style="s1">Myab'a'n kb'incha aj Israel</para>
  <para style="q">
    <verse number="1" style="v" />¡Qab'anxwe' nwitz! Ikyqinju'ye' kse'n jun xjal nex sakwil tjawlenxi' awal,</para>
  <para style="q">ex mixti'te ub'a nknet ex iw tu'n,</para>
  <para style="q">aye'ju' lob'j tajb'il tu'n txi' tlo'n.</para>
  <para style="q">
    <verse number="2" style="v" />Mixti'qe'tl xjal twitz tx'otx'</para>
  <para style="q">tnik'alkyi'j ex tz'aqlqe'wt twitz Qman Dyos;</para>
  <para style="q">kykyaqilx naq nche ayon</para>
  <para style="q">tu'n kb'inchante myab'a'n;</para>
  <para style="q">kyib'xkyib' nkub' kq'o'n xpatxab' toj kb'e.</para>
  <para style="q">
    <verse number="3" style="v" />Majxpe'tzun kanli kywitz tu'n kyb'inchante myab'a'n;</para>
  <para style="q">ilxi'xti'j nelkyqani'n nejenel tu'me'l t-xel</para>
  <para style="q">exqetzunju' ajkawil nkub'kyi'j tu'n pwaq,</para>
  <para style="q">aye'tzunju' nimaq kyoklen nkyb'incha'n aju' b'a'n toj kywitz</para>
  <para style="q">ex nche okten chuksalkye xjal toj nintnam.</para>
  <para style="q">
    <verse number="4" style="v" />Nakuj jun ch'i'xju' xjal atixi'x b'a'n tu'n kxol;</para>
  <para style="q">atzu'nju' tnik'alxi'xti'j, kse'n ch'i'x sarsa.</para>
  <para style="q">Tzultzun tq'ijlalil tu'n kyok toj xjel,</para>
  <para style="q">aju' q'ij tmaju' xq'uqil te qonik'an.</para>
  <para style="q">Tzultzun xitb'iltzu' kxol.</para>
  <para style="q">
    <verse number="5" style="v" />Lalun txi' toksla'na tyolju' twnaqila</para>
  <para style="q">ex lalun tz'okqe tk'u'ja ti'j jun tamiwa;</para>
  <para style="q">expe' ka'yinxa tyola nxi' tma'na teju' t-xu'jila.</para>
  <para style="q">
    <verse number="6" style="v" />Nche b'jelkyik'o'ne' k'wal kyman,</para>
  <para style="q">njaw kyi'nkyib'ju' txin kyi'j ktxu,</para>
  <para style="q">njaw ti'ntib' lib'j ti'ju' lib'alte,</para>
  <para style="q">ex kywitze'lx nche ok ajq'oj.</para>
  <para style="q">
    <verse number="7" style="v" />Ayintzunwe' chin ayole' ti'j Qman Dyos;</para>
  <para style="q">k'okyel qe nk'u'je' ti'j Qman Dyos klol weye',</para>
  <para style="q">qu'n chin ktzajel b'i'nwe' tu'n.</para>
  <para style="s1">Kanb'ab'l tejumajx kyu'n aj Israel</para>
  <para style="q">
    <verse number="8" style="v" />Lan jaw tzalaja nintnamju' ajq'oja wi'je', tu'n ẍin k'ulb'ane',</para>
  <para style="q">b'a'nqa machin kub' tz'aqe', chin jawilwe'tlwe';</para>
  <para style="q">b'a'nqa matz'ok qloljix wi'je',</para>
  <para style="q">ate Qman Dyos kq'olte spik'un weye'.</para>
  <para style="q">
    <verse number="9" style="v" />Matxi' chin b'inchan ile' twitz Qman Dyos,</para>
  <para style="q">qu'mtzun k'ik'exju' ttx'u'jil wu'ne';</para>
  <para style="q">b'ankxpun b'aja' lu, a kq'malte se'nju' wile'</para>
  <para style="q">ex ktb'incha' tnik'alilti'j weye'.</para>
  <para style="q">Chin kxe'l tiq'i'ne' Qman Dyos toj spik'un,</para>
  <para style="q">ex ktzajel tyek'u'n aj tkanb'ab'l weye'.</para>
  <para style="q">
    <verse number="10" style="v" />Ex k'okyel ka'yin tu'n wajq'oje,</para>
  <para style="q">ex majx kb'el ch'ixwi tu'n tpaj.</para>
  <para style="q">Intoq tzaj tma'n weye': ¿Jatzunta' Dyos Manb'aj tdyosa? chij,</para>
  <para style="q">atzu'n ja'lo tzalajb'il weye' ajtok nka'yine'</para>
  <para style="q">wab'la'n b'a'nxi'x kse'n xoq'l toj b'e.</para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" />Luju' q'ij tzul, Jerusalen</para>
  <para style="q">tu'n kyjaw b'incha'n jumajtlju' ninttapiya</para>
  <para style="q">ex che kxe'l lq'ech'i'ntlju' tnqacha.</para>
  <para style="q">
    <verse number="12" style="v" />Luju' q'ij tzul</para>
  <para style="q">tu'n kyul xjal toja jaxjaku' che tzajela':</para>
  <para style="q">tzajx Asirya ponx Ejipt,</para>
  <para style="q">tzajx ttziju' nin a' Nilo ponx Euprates,</para>
  <para style="q">tzajx ttzi jun ninnjab' pomnix ttzi juntl, ex tzaj tk'etz jun witz pomnix twi' juntl witz.</para>
  <para style="q">
    <verse number="13" style="v" />Kjeltenju' tx'otx' naq chq'ajlajtl</para>
  <para style="q">tu'n kypaju' xjal najlqe' twitz,</para>
  <para style="q">tu'n tpaju' kyil.</para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" />¡Xq'uqima ttanama, Nman Dyos,</para>
  <para style="q">exqe'ju' trita etza'nqe' tu'na,</para>
  <para style="q">ayeju' teqe' toj k'ul o'qekxkye,</para>
  <para style="q">kyoju' tb'anil tx'otx'!</para>
  <para style="q">Iq'inqexa kse'nxju' ojtxi',</para>
  <para style="q">kyoju' k'ul te B'asan ex Kalaad.</para>
  <para style="q">
    <verse number="15" style="v" />Yek'unxa b'a'nq'ob'aj kye,</para>
  <para style="q">kse'n toju' tq'ijlalil tej kyetztiq'i'na Ejipt.</para>
  <para style="q">
    <verse number="16" style="v" />¡Tu'n kyka'yinte junjuntl nimaqtnam,</para>
  <para style="q">ex tz'elxwit kych'ixaw</para>
  <para style="q">tu'npetzunj nim kyipumal toj kwitz!</para>
  <para style="q">¡Che kyajxwit meyix ex t-ẍkyinix!</para>
  <para style="q">
    <verse number="17" style="v" />¡Che wanxwit quq kse'nqe' kan</para>
  <para style="q">ex kse'nqe' txqantl txkup nche qititinje twitz tx'otx'!</para>
  <para style="q">¡Che lu'lunxwit ajkyetz toj kyjul,</para>
  <para style="q">ex tu'nwt kxob'il</para>
  <para style="q">che pon tk'etza, Nman Dyos!</para>
  <para style="s1">Kub' tnajsa'n Qman Dyos kyilju' ttanam</para>
  <para style="q">
    <verse number="18" style="v" />Mixti' juntl Dyos kse'n aya Nman Dyos,</para>
  <para style="q">qu'n nkub' tnajsa'nta il</para>
  <para style="q">ex nche' ik'tna'lju' myab'a'n</para>
  <para style="q">nkb'incha'nju' ch'i'ntl ttanama xkyejten.</para>
  <para style="q">Intzaj tyek'u'na tk'u'jlalila qeye'</para>
  <para style="q">ex minti' ntenju' ttx'u'jila tejumajx.</para>
  <para style="q">
    <verse number="19" style="v" />Q'aq'antz jumajtl tk'u'ja qi'je'</para>
  <para style="q">ex tzik'x tna'lju' qb'inchb'ene' myab'a'n tu'na.</para>
  <para style="q">ex xonku'xa qile' tzmax t-xe ninnjab'.</para>
  <para style="q">
    <verse number="20" style="v" />¡Nman Dyos, japunxju' tyola exju' tk'u'jlalila</para>
  <para style="q">tmaya ojtxi' kyeju' ojtxi' qyajilb'ene' Ab'raam ex Jakob'!</para>
</usx>