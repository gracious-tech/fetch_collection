<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id"/>
  <para style="h">II Tesalonisyen Yo</para>
  <para style="toc1">II TESALONISYEN YO</para>
  <para style="toc2">II Tesalonisyen Yo</para>
  <para style="toc3">II Tes</para>
  <para style="mt1">II TESALONISYEN YO</para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>Paul, Silvain ak Timothée, a <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 17:1">Trav 17:1</ref></char></note>legliz Tesalonisyen yo, nan Bondye, Papa nou an, e Senyè a, Jésus Kri: <verse eid="2TH 1:1"/><verse number="2" style="v" sid="2TH 1:2"/><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ROM 1:7">Wo 1:7</ref></char></note>Gras pou nou ak lapè Bondye, Papa a, e Senyè a, Jésus Kri.<verse eid="2TH 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>Nou ta dwe toujou <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ROM 1:8">Wo 1:8</ref></char></note>bay remèsiman a Bondye pou nou menm, frè m yo, nan jan sa merite a, paske lafwa nou gen tan grandi anpil, e <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="1TH 3:12">I Tes 3:12</ref></char></note>lanmou a nou chak pou youn lòt ap grandi menm plis toujou. <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>Konsa, nou menm, nou <note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2CO 7:4">II Kor 7:4</ref></char></note>pale avèk fyète de nou pami <note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="1TH 2:14">I Tes 2:14</ref></char></note>legliz a Bondye yo, pou pèseverans ak lafwa nou nan mitan tout pèsekisyon ak soufrans ke nou andire yo. <verse eid="2TH 1:4"/><verse number="5" style="v" sid="2TH 1:5"/>Sa se yon sign byen klè de jijman dwat Bondye anvè nou <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="LUK 20:35">Luc 20:35</ref></char></note>ke nou konsidere dign pou wayòm Bondye a, de li menm nou vrèman ap soufri a.<verse eid="2TH 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 1:6"/>Paske se byen jis pou Bondye rann afliksyon a sila ki aflije nou yo, <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>epi pou bay repo a nou menm ki aflije ak nou yo <note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="LUK 17:30">Luc 17:30</ref></char></note>lè Senyè a Jésus va vin parèt nan syèl la avèk zanj pwisan Li yo nan flanm dife yo. <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>Konsa L a bay chatiman a sila <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="GAL 4:8">Gal 4:8</ref></char></note>ki pa konnen Bondye yo, e a sila <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="ROM 2:8">Wo 2:8</ref></char></note>ki pa obeyisan a levanjil Senyè Jésus nou a.<verse eid="2TH 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2TH 1:9"/>Sila yo va peye pinisyon <note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="PHP 3:19">Fil 3:19</ref></char></note>destriksyon etènèl la, lwen prezans Senyè a ak laglwa a pouvwa Li a. <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>Lè Li vini pou L kapab <note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ISA 49:3">És 49:3</ref></char></note>glorifye nan sen Li yo nan <note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ISA 2:1">És 2:1</ref></char></note>jou sa a, e pou L kapab admire pami tout moun ki kwè yo—paske nou te kwè temwayaj pa nou a.<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>Pou rezon sa a osi, nou toujou priye pou nou, pou <note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1KI 22:22">I Wa 22:22</ref></char></note>Bondye kapab konte nou dign de apèl nou an, e ranpli tout dezi pou fè sa ki bon ak zèv lafwa yo avèk fòs, <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>pou <note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ISA 24:15">És 24:15</ref></char></note>non a Senyè Jésus nou an kapab vin glorifye nan nou, e nou nan Li, pa lagras Bondye nou an ak Senyè a, Jésus Kri.<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>Alò, nou mande nou, frè nou yo, konsènan <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="1TH 2:19">I Tes 2:19</ref></char></note>vini a Senyè nou an, Jésus Kri, ak <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="MRK 13:27">Mc 13:27</ref></char></note>reyinyon nou ansanm avèk Li a, <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>pou nou pa pèdi bon sans ak ekilib nou twò vit pa ni yon <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="1JN 4:1">I Jn 4:1</ref></char></note>lespri, ni yon <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="2TH 2:15">II Tes 2:15</ref></char></note>mesaj, ni yon lèt, kòmsi y ap di sòti nan nou menm, ak efè ke jou Senyè a gen tan rive deja.<verse eid="2TH 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 2:3"/>Pa kite okenn moun nan okenn sans twonpe nou, paske li p ap vini amwenske gwo renye lafwa nan Bondye a ta fèt avan, e <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="DAN 7:25">Dan 7:25</ref></char></note>nonm peche a, fis a <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="JHN 17:12">Jn 17:12</ref></char></note>pèdisyon an, ta vin parèt. <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>Li va opoze e egzalte tèt li pi wo pase tout kalite bagay yo rele Dye oubyen tout sa ki adore, pou li kapab pran plas li nan tanp Bondye a, e <note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="ISA 14:14">És 14:14</ref></char></note>prezante tèt li kòm Bondye.<verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>Èske nou pa sonje <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="1TH 3:4">I Tes 3:4</ref></char></note>lè m te toujou avèk nou an, mwen t ap di nou bagay sa yo?<verse eid="2TH 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 2:6"/>Konsa, nou konnen <note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="2TI 2:7">II Tim 2:7</ref></char></note>kisa ki anpeche li koulye a, pouke nan lè li a, li kapab vin parèt. <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>Paske <note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="REV 17:5">Rev 17:5</ref>,<ref loc="REV 17:7">7</ref></char></note>mistè nonm a peche a ap travay deja; sèlman Sila k ap anpeche li kounye a, va fè sa jiskaske li vin retire nan wout la.<verse eid="2TH 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TH 2:8"/>Nan moman sa a, nonm a peche a va vin parèt; sila ke Bondye va touye <note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 7:4">És 7:4</ref></char></note>avèk souf ki soti nan bouch li a, e fè sa fini ak aparisyon retou a Li menm nan. <verse eid="2TH 2:8"/><verse number="9" style="v" sid="2TH 2:9"/>Sa se, sila kap vini an akò avèk aktivite Satan, avèk tout pouvwa, <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="MAT 24:24">Mat 24:24</ref></char></note>sign, ak fo mirak, <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>epi avèk tout desepsyon mechanste pou <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="1CO 1:18">I Kor 1:18</ref></char></note>sila ki peri yo, paske yo pa t resevwa lanmou <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="2TH 2:12">II Tes 2:12</ref>,<ref loc="2TH 2:13">13</ref></char></note>a verite a, jis pou yo ta kapab sove.<verse eid="2TH 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 2:11"/>Pou rezon sa a, <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="1KI 22:22">I Wa 22:22</ref></char></note>Bondye va voye sou yo yon lespri twonpè pou yo kapab kwè sa ki fo a, <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>pou yo tout kapab jije ki <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ROM 2:8">Wo 2:8</ref></char></note>pa t kwè nan verite a, men ki te <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ROM 1:32">Wo 1:32</ref></char></note>pran plezi nan mechanste.<verse eid="2TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>Men nou ta dwe bay remèsiman pou nou menm, frè m yo, byeneme nan Senyè a, akoz <note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EPH 1:4">Ef 1:4</ref></char></note>Bondye te chwazi nou depi nan kòmansman an pou sali atravè sanktifikasyon <note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="1TH 4:7">I Tes 4:7</ref></char></note>pa Lespri a ak lafwa nan verite a. <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>Se te pou sa Li te <note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="1TH 2:12">I Tes 2:12</ref></char></note>rele nou atravè levanjil nou an, pou nou ta kapab vin genyen laglwa Senyè nou an, Jésus Kri.<verse eid="2TH 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TH 2:15"/>Konsa, frè m yo, kanpe fèm e <note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="1CO 11:2">I Kor 11:2</ref></char></note>kenbe ak tradisyon ke yo te enstwi nou yo, kit se pa pawòl kit se pa lèt a nou an.<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:16 </char>
      <char style="xt" closed="false">
        <ref loc="1TH 3:11">I Tes 3:11</ref>
      </char>
    </note>Koulye a, ke Senyè nou an, Jésus Kri, Li menm, ak Bondye, Papa nou an, ki renmen nou e ki bay nou rekonfò etènèl ak bon espwa pa lagras la <verse eid="2TH 2:16"/><verse number="17" style="v" sid="2TH 2:17"/><note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="1TH 3:2">I Tes 3:2</ref></char></note>rekonfòte nou e ranfòse kè nou nan tout bon zèv ak pawòl.<verse eid="2TH 2:17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>Finalman, frè m yo <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="1TH 5:25">I Tes 5:25</ref></char></note>priye pou nou pou pawòl a Senyè a kapab gaye vit e vin glorifye, jis jan sa te fèt osi avèk nou an, <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>epi pou nou kapab <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="ROM 15:31">Wo 15:31</ref></char></note>delivre de moun pèvès e mechan yo, paske se pa tout ki gen lafwa.<verse eid="2TH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3"/>Men <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="1CO 1:9">I Kor 1:9</ref></char></note>Senyè a fidèl, e Li va ranfòse nou e pwoteje nou de mechan an. <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>Nou gen konfyans nan Senyè a konsènan nou menm, ke nou <note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="1TH 4:10">I Tes 4:10</ref></char></note>ap fè e va kontinye fè sa ke nou kòmande yo. <verse eid="2TH 3:4"/><verse number="5" style="v" sid="2TH 3:5"/>Ke Senyè a <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="1TH 3:11">I Tes 3:11</ref></char></note>dirije kè nou nan lanmou Bondye a, ak nan kenbe fèm nan Kris la.<verse eid="2TH 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>Alò, nou kòmande nou, frè yo, nan non Senyè nou an, Jésus Kris, pou nou <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ROM 16:17">Wo 16:17</ref></char></note>rete lwen de tout frè ki mennen yon vi san prensip e ki pa an akò avèk tradisyon ke nou te resevwa de nou menm yo.<verse eid="2TH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2TH 3:7"/>Paske nou menm, nou konnen jan nou ta dwe <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="1TH 1:6">I Tes 1:6</ref></char></note>swiv egzanp nou an, paske nou pa t aji nan yon fason dezòd pami nou. <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>Ni nou pa t manje pen a lòt moun san peye pou li, men avèk <note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="1TH 2:9">I Tes 2:9</ref></char></note>travay ak difikilte, nou te kontinye travay lajounen kou lannwit pou nou te kab pa vini yon chaj lou pou okenn nan nou. <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>Se pa paske nou pa gen <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="1CO 9:4-18">I Kor 9:4-18</ref></char></note>dwa sa a, men pou nou te kab ofri tèt nou kòm yon modèl pou nou, pou nou ta kapab swiv egzanp nou an.<verse eid="2TH 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2TH 3:10"/>Paske menm lè nou te avèk nou an, nou te konn bannou lòd sa a: <note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="1TH 4:11">I Tes 4:11</ref></char></note>si yon moun pa vle travay, alò, li pa dwe manje nonplis. <verse eid="2TH 3:10"/><verse number="11" style="v" sid="2TH 3:11"/>Paske nou tande ke kèk pami nou ap mennen yon vi dezòd, ke yo pa travay menm, men k ap <note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="1TH 5:13">I Tes 5:13</ref></char></note>aji kòm antre bouch yo nan zafè a lòt moun. <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>Alò, moun konsa yo, nou kòmande e egzòte nan Senyè a, Jésus Kri, pou yo <note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="1TH 4:11">I Tes 4:11</ref></char></note>travay nan yon jan ki kalm pou manje pwòp pen pa yo. <verse eid="2TH 3:12"/><verse number="13" style="v" sid="2TH 3:13"/>Men pou nou, frè m yo <note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="GAL 6:9">Gal 6:9</ref></char></note>pa fatige nan fè sa ki bon.<verse eid="2TH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14"/>Si yon moun pa obeyi a enstriksyon nou an nan lèt sa, pran nòt de moun sa a, e <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="2TH 3:6">II Tes 3:6</ref></char></note>pa asosye nou avè l pou <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="TIT 2:8">Tit 2:8</ref></char></note>li kab vin wont. <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>Malgre sa, pa gade l kòm yon lènmi, men <note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="1TH 5:14">I Tes 5:14</ref></char></note>egzòte li kòm yon frè.<verse eid="2TH 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>Koulye a, ke Senyè lapè a, Li menm, kontinye bannou lapè nan tout sikonstans. <note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="RUT 2:4">Rt 2:4</ref></char></note>Ke Senyè a avèk nou tout!<verse eid="2TH 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17"/>Mwen, Paul ekri salitasyon sa a <note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="1CO 16:21">I Kor 16:21</ref></char></note>avèk pwòp men m, e sa se mak ki idantifye m nan chak lèt; se konsa ke m ekri.<verse eid="2TH 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:18 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 16:20">Wo 16:20</ref>
      </char>
    </note>Ke lagras Senyè nou an, Jésus Kri, rete avèk nou tout. Amen.<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
