<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">MAT</book>
  <para style="h">Matthïeu</para>
  <para style="toc1">LEVANJIL SELON MATTHÏEU</para>
  <para style="toc2">Matthïeu</para>
  <para style="toc3">Mat</para>
  <para style="mt1">LEVANJIL SELON MATTHÏEU</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>Rejis a zansèt Jésus Kris yo, <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ISA 9:6">És 9:6</ref></char></note>fis a David, fis a Abraham nan. <verse eid="MAT 1:1"/><verse number="2" style="v" sid="MAT 1:2"/>Abraham te papa Isaac. Isaac te fè Jacob. Jacob te papa Juda ak lòt frè l yo. <verse eid="MAT 1:2"/><verse number="3" style="v" sid="MAT 1:3"/>Juda te papa <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="RUT 4:18-22">Rt 4:18-22</ref></char></note>Pharès avèk Zara pa Thamar, Pharès te papa Esrom, epi Esrom te papa a Ram. <verse eid="MAT 1:3"/><verse number="4" style="v" sid="MAT 1:4"/>Ram te papa Aminadab. Aminadab te papa Naasson. Naasson te papa Salmon. <verse eid="MAT 1:4"/><verse number="5" style="v" sid="MAT 1:5"/>Salmon e Rehab te fè Boaz. Boaz te papa Obed pa Ruth; Obed te papa Isaï. <verse eid="MAT 1:5"/><verse number="6" style="v" sid="MAT 1:6"/>Epi Isaï te bay nesans a David, wa a. <note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2SA 11:27">II Sam 11:27</ref></char></note>David te fè Salomon pa Bathshéba ki te madanm a Urie. <verse eid="MAT 1:6"/><verse number="7" style="v" sid="MAT 1:7"/>Salomon te fè <note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="1CH 3:10">I Kwo 3:10</ref></char></note>Roboam. Roboam fè Abia, e pa Abia, Asa. <verse eid="MAT 1:7"/><verse number="8" style="v" sid="MAT 1:8"/>Asa te fè Josaphat, e pa Josaphat, Joram. Pa Joram, Ozias; <verse eid="MAT 1:8"/><verse number="9" style="v" sid="MAT 1:9"/>Pou Ozias te fèt Jotham; e a Jotham, Achaz; a Achaz, Ézéchias; <verse eid="MAT 1:9"/><verse number="10" style="v" sid="MAT 1:10"/>epi pa Ézéchias te fèt Manassé; e a Manassé, Amon; e pa Amon <note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="1CH 3:14">I Kwo 3:14</ref></char></note>Josias; <verse eid="MAT 1:10"/><verse number="11" style="v" sid="MAT 1:11"/>Josias te fè Jéchonias ak frè li yo nan tan <note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2KI 24:14">II Wa 24:14</ref></char></note>depòtasyon Babylone nan.<verse eid="MAT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12"/>Aprè depòtasyon Babylone nan, Jéchonias te fè Salathiel; e pa Salathiel, Zorobabel. <verse eid="MAT 1:12"/><verse number="13" style="v" sid="MAT 1:13"/>A Zorobabel te fèt Abiud; e a Abiud, Eliakim, e a Eliakim, Azor. <verse eid="MAT 1:13"/><verse number="14" style="v" sid="MAT 1:14"/>Pou Azor te vin fèt Sadok, e a Sadok, Achim, e a Achim, Éliud. <verse eid="MAT 1:14"/><verse number="15" style="v" sid="MAT 1:15"/>A Éliud te vin fèt Éléazar. Éléazar te fè Matthan, e pou Matthan, Jacob. <verse eid="MAT 1:15"/><verse number="16" style="v" sid="MAT 1:16"/>Jacob te fè Joseph, mari a Marie a, manman a Jésus <note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="MAT 27:17-22">Mat 27:17-22</ref></char></note>ke yo rele Kris la.<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>Konsa, tout jenerasyon yo soti nan Abraham jiska David se katòz jenerasyon epi kite David pou rive nan depòtasyon Babylone nan, se katòz jenerasyon. E pou<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="2KI 24:14">II Wa 24:14</ref></char></note>kite depòtasyon Babylone nan pou rive a Kris La, se katòz jenerasyon.<verse eid="MAT 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>Nesans a Jésus, Kris la te fèt konsa: Lè <note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="MAT 12:46">Mat 12:46</ref></char></note>manman Li, Marie, te fiyanse ak Joseph, avan ke yo te vini ansanm, li te twouve ansent pa Lespri Sen an. <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Konsa, Joseph, mari li, ki te yon nonm dwat, pa t vle fè l wont. Pou sa a, li te pran desizyon pou <note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="DEU 22:20-24">Det 22:20-24</ref></char></note>mete l sou kote an sekrè. <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>Men pandan li t ap anvizaje sa, konsa, yon zanj Bondye te parèt devan li nan yon rèv epi te di l konsa:</para>
  <para style="p" vid="MAT 1:20">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:20 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 2:4">Luc 2:4</ref>
      </char>
    </note>“Joseph, fis a David la, ou pa bezwen pè pran Marie kon madanm ou; pwiske sa ki gen tan plase nan vant li an, soti nan Lespri Sen an. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>Li va fè yon fis, epi ou va rele li Jésus paske se Li menm ki <note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 2:11">Luc 2:11</ref></char></note>va sove pèp li a de peche yo.”<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>Tout sa te fèt pou akonpli sa ki <note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="LUK 24:44">Luc 24:44</ref></char></note>te pale pa Senyè a, atravè pwofèt yo;<verse eid="MAT 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:23 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 7:14">És 7:14</ref>
      </char>
    </note>“Koute byen, vyèj la va <note caller="+" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 9:6">És 9:6</ref>,<ref loc="ISA 9:7">7</ref></char></note>vin ansent</para>
  <para style="q1" vid="MAT 1:23">e l ap fè yon gason.</para>
  <para style="q1" vid="MAT 1:23">Y ap nonmen li Emmanuel”,</para>
  <para style="q1" vid="MAT 1:23">ki tradwi vle di “Bondye Avèk Nou”.<verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>Konsa, Joseph te leve nan dòmi. Li te fè sa ke zanj Senyè a te mande l fè a, e te pran li pou madanm li. <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>Li te kenbe l kon yon vyèj jiskaske li te fin fè gason an, epi <note caller="+" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="MAT 1:21">Mat 1:21</ref></char></note>li te rele li Jésus.<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>Aprè Jésus te fin <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="MIC 5:2">Mi 5:2</ref></char></note>fèt Bethléem nan peyi Judée pandan Hérode te wa, konsa yon ekip mesye saj ki sòti nan lès te rive Jérusalem pou mande; <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>“Kote sila ki fèt <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="JER 23:5">Jr 23:5</ref></char></note>Wa a Jwif yo a? Nou gen tan wè zetwal Li nan pati lès la, e nou vini pou adore Li.”<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>Lè Hérode te tande sa, li te vin twouble, e tout Jérusalem avèk li. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>Li te rasanble tout chèf prèt yo avèk skrib a pèp la, e te kòmanse mande yo kote Kris la t ap fèt la.<verse eid="MAT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5"/>Yo te di li: <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="JHN 7:42">Jn 7:42</ref></char></note>“Nan Bethléem a Judée jan li te ekri pa pwofèt la”;<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:6 </char>
      <char style="xt" closed="false">
        <ref loc="MIC 5:2">Mi 5:2</ref>
      </char>
    </note>“E ou menm, Bethléem, peyi Judée,</para>
  <para style="q1" vid="MAT 2:6">ou pa manke valè pami chèf Judée yo:</para>
  <para style="q1" vid="MAT 2:6">paske yon Gran Chèf k ap sòti nan ou menm,</para>
  <para style="q1" vid="MAT 2:6">Li va vin yon bèje pou pèp Mwen an, Israël”.<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>Konsa, Hérode te rele mesye saj yo an sekrè pou fè yon ankèt egzakt pou konnen kilè <note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="NUM 24:17">Nonb 24:17</ref></char></note>zetwal la te parèt la. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>Li te voye yo Bethléem e li te di yo: “Ale Chèche pou twouve Pitit la, e lè nou jwenn li, voye di m sa, pou m ka ale adore Li tou.”<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>Lè yo fin tande wa a, yo ale fè wout yo, e konsa zetwal la ke yo te wè nan lès la, te ale devan yo jiskaske li te vin kanpe kote menm ke Pitit la te ye a. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>Lè yo te wè zetwal la, yo te rejwi anpil avèk anpil jwa. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>Yo te ale nan kay la e te wè Pitit la avèk Marie, manman Li. Yo te pwostène devan Li pou te <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="MAT 14:33">Mat 14:33</ref></char></note>adore L. Yo te ouvri trezò yo e te prezante L kòm kado, lò, lansan, ak lami. <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>Men akoz ke yo te avèti <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="JOB 33:15">Job 33:15</ref></char></note>nan yon rèv ke yo pa t dwe retounen kote Hérode, yo te ale nan peyi yo pa yon lòt wout.<verse eid="MAT 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Lè yo fin pati, lapoula yon zanj Bondye te <note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="MAT 2:12">Mat 2:12</ref>,<ref loc="MAT 2:19">19</ref></char></note>vin parèt a Joseph nan yon rèv. Li te di l: “Leve pran Pitit la avèk manman L epi kouri ale an Égypte. Rete la jiskaske mwen di ou, paske Hérode ap chèche Zanfan sila a pou l ka detwi L.”<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>Joseph te leve pran Pitit la avèk manman L pandan nwit lan pou te ale an Égypte. <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>Li te rete la jiskaske Hérode te mouri. Sa te fèt pou akonpli sa Senyè a te pale pa pwofèt la pou li ta kapab akonpli lè l te di: “Pou soti an Égypte, Mwen te rele Fis Mwen an”.<verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>Lè Hérode te vin wè ke li te <note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="MAT 2:1">Mat 2:1</ref></char></note>twonpe pa mesye saj yo, li te vin anraje. Konsa, li te voye touye tout ti gason mwens ke de zan nan tout anviwon Bethléem nan, selon tan li te vin konprann pa mesye saj yo. <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>Konsa, sa ki te pale pa pwofèt Jérémie an te vin akonpli lè l te di konsa:<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:18 </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:15">Jr 31:15</ref>
      </char>
    </note>“Yon vwa te tande nan Rama;</para>
  <para style="q1" vid="MAT 2:18">yo te kriye e fè gwo lamantasyon.</para>
  <para style="q1" vid="MAT 2:18">Rachel ki t ap kriye pou Pitit li yo;</para>
  <para style="q1" vid="MAT 2:18">li te refize konsole, paske yo pa t la ankò.”<verse eid="MAT 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>Men lè Hérode te vin mouri, yon zanj <note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="MAT 1:20">Mat 1:20</ref></char></note>te parèt an Égypte pou di Joseph nan yon rèv: <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>“Leve, pran Pitit la avèk manman L pou ale nan peyi Israël, paske sila yo ki t ap chèche touye Pitit la gen tan mouri.”<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>Konsa Joseph te leve pran Pitit la avèk manman L, e te ale nan peyi Israël. <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>Men lè li tande ke Archélaüs te gwo chèf nan Judée nan plas papa li, Hérode, li te pè ale la. Lè li te fin <note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="MAT 2:12">Mat 2:12</ref>,<ref loc="MAT 2:13-19">13-19</ref></char></note>avèti pa Bondye nan yon rèv, li te sòti la, e te ale nan anviwon Galilée yo. <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>Li te vin rete nan yon vil yo rele <note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="LUK 1:26">Luc 1:26</ref></char></note>Nazareth pou sa ke pwofèt yo te pale yo ta kapab akonpli: “Yo va rele Li yon Nazareyen”.<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>Alò, <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="JHN 1:6-8">Jn 1:6-8</ref></char></note>nan jou sa yo, Jean Baptiste te vin parèt. Li t ap preche nan gran savann Judée a, e li t ap di: <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/><note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">Mat 4:17</ref></char></note>“Repanti paske Wayòm Syèl la gen tan parèt.” <verse eid="MAT 3:2"/><verse number="3" style="v" sid="MAT 3:3"/>Paske sila a se de <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="LUK 1:17-76">Luc 1:17-76</ref></char></note>li menm ke pwofèt Esaïe te pale a lè l te di: <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">És 40:3</ref></char></note></para>
  <para style="q1" vid="MAT 3:3">“Men vwa a youn k ap kriye nan savann nan,</para>
  <para style="q1" vid="MAT 3:3">Prepare chemen Bondye a!</para>
  <para style="q1" vid="MAT 3:3">Fè chemen Li yo dwat”!<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>Alò, Jean li menm te gen <note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">II Wa 1:8</ref></char></note>yon rad fèt avèk pwal chamo avèk yon sentiwon fèt an kwi nan senti li. Li te konn manje krikèt avèk siwo myèl sovaj. <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>Jérusalem avèk tout Judée <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="MRK 1:5">Mc 1:5</ref></char></note>t ap vin kote l, avèk tout zòn ozanviwon Jourdain an. <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>Yo t ap <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="MAT 3:11">Mat 3:11</ref></char></note>batize pa li menm nan lariviyè Jourdain an pandan yo t ap konfese peche yo.<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>Men lè li te wè anpil <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 16:1">Mat 16:1</ref></char></note>Farizyen avèk <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 22:23">Mat 22:23</ref></char></note>Sadiseyen ki t ap vini pou batèm nan, li te di yo: “Men yon bann vipè; kilès ki te di nou chape anba kòlè k ap vini an? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/><note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="LUK 3:8">Luc 3:8</ref></char></note>Pou sa, pote yon fwi ki dign de repantans lan. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>Pa sipoze ke nou kapab di pwòp tèt nou: <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="LUK 3:8">Luc 3:8</ref></char></note>‘Nou gen Abraham kòm papa’. Paske m ap di nou ke Bondye kapab fè leve soti nan wòch sa yo, pitit Abraham yo. <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/><note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="LUK 3:9">Luc 3:9</ref></char></note>Rach la tou parèt nan rasin bwa yo; konsa, tout ab ki pa pote bon fwi va koupe pou jete nan lanfè.”<verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>“Pou mwen menm, m ap batize nou avèk dlo pou repantans, men sila a k ap vini aprè mwen an pi fò pase m. Mwen pa menm dign pou m retire sandal Li yo. Li menm L ap batize nou avèk <note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="MRK 1:4-8">Mc 1:4-8</ref></char></note>Lespri Sen an, epi avèk dife. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Fouch vannen an deja nan men Li. L ap netwaye glasi a nèt e mete tout ble yo nan depo, men L ap brile tout pay la avèk yon dife ki p ap kapab etenn.”<verse eid="MAT 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:13 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:29-34">Jn 1:29-34</ref>
      </char>
    </note>Nan lè sa a, Jésus te rive soti Galilée toupre larivyè Jourdain an. Li te vin kote Jean pou L ta kapab batize. <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>Men Jean te eseye anpeche Li. Li te di: “Mwen bezwen batize pa Ou menm, men Ou vin kote mwen?”<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>Men Jésus te reponn li. Li te di l: <char style="wj">“Kite sa fèt nan moman sa a; paske se konsa li dwe fèt</char> <note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="PSA 40:7-8">Sòm 40:7-8</ref></char></note><char style="wj">pou nou kapab akonpli tout ladwati.”</char> Konsa li te kite sa fèt.<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>Aprè Jésus te batize, Li te soti tou dwat nan dlo a, e lapoula syèl yo te vin louvri. <note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="MRK 1:10">Mc 1:10</ref></char></note>Li te wè Lespri Bondye a desann kon yon toutrèl e vin poze sou Li. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>Epi yon vwa ki te soti nan syèl yo te di: <note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Sòm 2:7</ref></char></note>“Sa se Fis byeneme Mwen an, e nan Li menm, Mwen pran plezi.”<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:12">Mc 1:12</ref>,<ref loc="MRK 1:13">13</ref></char>
    </note>Apre sa, Lespri Sen an te mennen Jésus nan savann nan pou L ta kapab tante pa Satan. <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>Lè Li te fin fè jèn <note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">Egz 34:28</ref></char></note>karant jou avèk karant nwit lan, Li te grangou. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/><note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="1TH 3:5">I Tes 3:5</ref></char></note>Konsa, Tantatè a te parèt, e te di Li: “Si Ou se <note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="MAT 14:33">Mat 14:33</ref></char></note>Fis Bondye a, kòmande wòch sa yo vin pen.”<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>Men Li te reponn li e te di l: <char style="wj">“Sa ekri </char><note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">Det 8:3</ref></char></note><char style="wj">Lòm pa pou viv sèlman pa pen, men pa chak mo ki sòti nan bouch Bondye”.</char><verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>Apre sa, Satan te mennen Li antre nan <note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="NEH 11:18">Né 11:18</ref></char></note>vil sen, Jérusalem nan. Li te fè L kanpe sou pi wo pwent tanp lan. <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>Konsa, li te di Li: “Si Ou menm se Fis Bondye a, jete kò Ou anba, paske sa ekri:</para>
  <para style="q1" vid="MAT 4:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:11-12">Sòm 91:11-12</ref>
      </char>
    </note>‘L ap bay zanj Li yo lòd de Ou menm, e</para>
  <para style="q1" vid="MAT 4:6">‘ak men yo, y ap bay Ou soutyen</para>
  <para style="q1" vid="MAT 4:6">pou ke Ou pa ta menm frape</para>
  <para style="q1" vid="MAT 4:6">pye Ou kont yon wòch’”.<verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>Jésus te di l: <char style="wj">“Anplis sa ekri: ‘Ou pa pou tante Senyè a, Bondye Ou a’”.</char><verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:8 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:26">Mat 16:26</ref>
      </char>
    </note>Ankò dyab la te mennen Li nan yon mòn wo e te montre Li tout wayòm nan mond lan, avèk tout glwa yo. <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>Li te di Li: <note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="1CO 10:20">I Kor 10:20</ref></char></note>“Tout bagay sa yo, mwen va bay Ou yo si Ou pwostène pou adore mwen.”<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>Konsa, Jésus te di li: <char style="wj">“Soti la Satan! Paske sa ekri:</char> <note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Det 6:13</ref></char></note><char style="wj">‘Ou va adore Senyè a, Bondye ou a, e sèvi Li menm sèl’”.</char><verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>Konsa, dyab la te kite Li, e lapoula, <note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="MAT 28:5">Mat 28:5</ref></char></note>zanj yo te vini sèvi Li.<verse eid="MAT 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>Alò lè Jésus te tande ke <note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">Mat 14:3</ref></char></note>Jean te arete, Li te retire kò li pou L antre Galilée. <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>Lè Li kite Nazareth, Li te vin <note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="MAT 11:23">Mat 11:23</ref></char></note>rete Capernanüm, toupre lanmè a, nan zòn Zabulon avèk Nephtali. <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>Sa te fèt pou akonpli sa ke pwofèt Esaïe te pale lè li te di:<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:15 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 9:1">És 9:1</ref>
      </char>
    </note>“Peyi Zabulon ak peyi Nephtali,</para>
  <para style="q1" vid="MAT 4:15">toupre lanmè a, lòtbò Jourdain an,</para>
  <para style="q1" vid="MAT 4:15">Galilée ki pou payen yo”<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:16 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 9:2">És 9:2</ref>
      </char>
    </note>“Pèp la ki te chita nan tenèb la te wè yon gwo limyè;</para>
  <para style="q1" vid="MAT 4:16">e sila yo ki te chita nan peyi lonbraj lanmò a,</para>
  <para style="q1" vid="MAT 4:16">sou yo menm yon limyè te vin parèt.”<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:17 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:14">Mc 1:14</ref>,<ref loc="MRK 1:15">15</ref></char>
    </note>Depi lè sa a, Jésus te kòmanse preche. Li te di:<char style="wj">“Repanti, paske wayòm syèl la pwòch.” </char><verse eid="MAT 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:18 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:2-11">Luc 5:2-11</ref>
      </char>
    </note>Alò pandan Jésus t ap mache sou kote lanmè Galilée a, Li te wè de frè yo, Simon, ke yo rele Pierre, ak André, frè li. Yo t ap voye yon filè nan lanmè a, paske se moun lapèch yo te ye. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>Li te di yo: <char style="wj">“Swiv Mwen e M ap fè nou vin fè lapèch moun.” </char><verse eid="MAT 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 4:20"/>Lapoula, yo te kite filè yo pou yo te swiv Li.<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>Lè Li te vin ale pi lwen, Li te wè de lòt frè, <note caller="+" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="MAT 10:2">Mat 10:2</ref></char></note>Jacques fis a Zébédé avèk Jean, frè li. Yo te nan kannòt la avèk Zébédé, papa yo. Yo t ap repare filè yo. Li te rele yo.<verse eid="MAT 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 4:22"/>Imedyatman, yo te kite kannòt la avèk papa yo pou yo te swiv Li.<verse eid="MAT 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>Jésus t ap prale toupatou nan tout Galilée. Li t ap <note caller="+" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">Mat 9:35</ref></char></note>enstwi nan sinagòg yo pou pwoklame bòn nouvèl wayòm nan, e Li t ap fè gerizon tout kalite maladi pami pèp la.<verse eid="MAT 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 4:24"/>Nouvèl Li te gaye <note caller="+" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="MRK 7:26">Mc 7:26</ref></char></note>toupatou nan peyi Syrie. Yo te pote bay Li tout sila ki te gen maladi avèk tout kalite doulè yo, sila ki te gen move lespri yo, sila ki te fè gwo kriz, ki te vin paralize yo, e Li te geri yo.<verse eid="MAT 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 4:25"/>Gran foul la te swiv Li <note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MRK 3:7">Mc 3:7</ref>,<ref loc="MRK 3:8">8</ref></char></note>soti Galilée, Decapolis, Jérusalem avèk Judée e rive jis lòtbò Jourdain an.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>Lè Jésus te wè foul la, Li te monte sou mòn nan. Lè Li fin chita, disip Li yo te vin kote L. <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>Li te <note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 13:35">Mat 13:35</ref></char></note>louvri bouch Li e te kòmanse enstwi yo konsa:<verse eid="MAT 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>
    <char style="wj">“Beni se sila yo ki malere an espri;</char></para>
  <para style="q1" vid="MAT 5:3">
    <char style="wj">paske wayòm syèl la se pou yo. </char><verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>
    <char style="wj">Beni se</char> <note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="ISA 61:2">És 61:2</ref></char></note><char style="wj">sila yo ki soufri doulè akoz gwo pèt;</char></para>
  <para style="q1" vid="MAT 5:4">
    <char style="wj">yo va konsole.</char><verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>
    <char style="wj">Beni se sila yo ki</char> <note caller="+" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">Sòm 37:11</ref></char></note><char style="wj">enb; </char></para>
  <para style="q1" vid="MAT 5:5">
    <char style="wj">yo va resevwa tout latè kòm eritaj.</char><verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>
    <char style="wj">Beni se</char> <note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1-2">És 55:1-2</ref></char></note><char style="wj">sila yo ki grangou avèk swaf pou ladwati; </char></para>
  <para style="q1" vid="MAT 5:6">
    <char style="wj">yo va satisfè.</char><verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>
    <char style="wj">Beni se</char> <note caller="+" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="PRO 11:17">Pwov 11:17</ref></char></note><char style="wj">sila yo ki bay mizerikòd; </char></para>
  <para style="q1" vid="MAT 5:7">
    <char style="wj">yo va resevwa mizerikòd.</char><verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>
    <char style="wj">Beni se</char> <note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 24:4">Sòm 24:4</ref></char></note><char style="wj">sila yo ki gen kè pwòp nèt; </char></para>
  <para style="q1" vid="MAT 5:8">
    <char style="wj">yo va wè Bondye. </char><verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>
    <char style="wj">Beni se sila yo ki fè lapè;</char> <note caller="+" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="MAT 5:45">Mat 5:45</ref></char></note></para>
  <para style="q1" vid="MAT 5:9">
    <char style="wj">yo va rele yo fis Bondye.</char><verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>
    <char style="wj">Beni se sila yo ki te</char> <note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">I Pi 3:14</ref></char></note><char style="wj">pèsekite pou ladwati; </char></para>
  <para style="q1" vid="MAT 5:10">
    <char style="wj">wayòm syèl la se pou yo.</char><verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>
    <char style="wj">“Beni se nou menm lè moun</char> <note caller="+" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">I Pi 4:14</ref></char></note><char style="wj">ensilte nou, pèsekite nou e pale san verite tout kalite mal kont nou pou koz a Non Mwen. </char> <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/><char style="wj">Rejwi e fè kè nou kontan. Rekonpans nou nan syèl la gran; paske</char> <note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">II Kwo 36:16</ref></char></note><char style="wj">se konsa yo te pèsekite pwofèt ki te avan nou yo.</char><verse eid="MAT 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>
    <char style="wj">“Nou se sèl latè; men</char> <note caller="+" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="MRK 9:50">Mc 9:50</ref></char></note><char style="wj">si sèl la pèdi gou li, kijan pou l fè l rekouvri gou sèl ankò? Li p ap bon ankò sof pou voye jete e pile anba pye moun. </char><verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>
    <char style="wj">“Nou se</char> <note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="PRO 4:18">Pwov 4:18</ref></char></note><char style="wj">limyè lemonn; yon vil ki plase sou tèt yon mòn pa kapab kache. </char> <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/><note caller="+" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">Mc 4:21</ref></char></note><char style="wj">Ni moun p ap limen yon lanp pou mete li anba yon panyen; men sou yon tab kote li va bay limyè pou tout sila yo ki nan kay la.</char> <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/><char style="wj">Kite limyè nou an klere devan tout moun pou yo kapab</char> <note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">I Pi 2:12</ref></char></note><char style="wj">wè bon zèv nou, e bay glwa a Papa nou ki nan syèl la. </char><verse eid="MAT 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>
    <char style="wj">“Pa panse ke Mwen te vini pou </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:17 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 7:12">Mc 7:12</ref>
      </char>
    </note>
    <char style="wj">aboli Lalwa ak pwofèt yo. Mwen pa te vini pou aboli, men pou akonpli.</char> <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/><char style="wj">Paske vrèman Mwen di nou</char> <note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="MAT 24:35">Mat 24:35</ref></char></note><char style="wj">jiskaske syèl la avèk tè a disparèt, ni yon ti lèt, ni yon ti mak p ap disparèt nan Lalwa a, jiskaske tout bagay fin acheve.</char> <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/><char style="wj">Pou sa, nenpòt moun ki anile menm youn ki pi piti nan kòmandman sa yo, e bay enstriksyon a lòt pou fè sa, l ap rele pi piti</char> <note caller="+" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="MAT 11:11">Mat 11:11</ref></char></note><char style="wj">nan wayòm syèl la. Men sila ki kenbe yo e enstwi lòt pou fè yo tou, li va rele pi gran nan wayòm syèl la. </char> <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/><char style="wj">Paske m ap di nou ke si ladwati nou pa depase sila a skrib avèk Farizyen yo, nou p ap janm antre nan wayòm syèl la. </char> <verse eid="MAT 5:20"/><verse number="21" style="v" sid="MAT 5:21"/><char style="wj">Nou konn tande ke tout ansyen yo te di: </char> <note caller="+" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="MAT 10:2">Mat 10:2</ref></char></note><char style="wj">‘Nou pa pou touye moun’ e ‘Nenpòt moun ki touye moun ap rann kont devan tribinal’.</char> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/><char style="wj">Men Mwen di nou ke nenpòt moun ki fache avèk frè li, ap koupab devan</char> <note caller="+" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="DEU 16:18">Det 16:18</ref></char></note><char style="wj">tribinal. Epi nenpòt moun ki di: ‘Raka’ (pou ryen) ap koupab devan tribinal pi wo a, epi sila ki di: ‘enbesil’ ap koupab pou l antre nan lanfè. </char><verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>
    <char style="wj">“Pou sa, lè ou ap</char> <note caller="+" style="x"><char style="xo" closed="false">5:23 </char><char style="xt" closed="false"><ref loc="MAT 5:24">Mat 5:24</ref></char></note><char style="wj">prezante ofrann ou sou lotèl la, e pandan ou la, ou sonje ke frè ou a gen yon bagay kont ou,</char> <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/><char style="wj">kite ofrann ou an la devan lotèl a e ale fè wout ou. Premyeman, rekonsilye avèk frè ou, e apre vin prezante ofrann ou an. </char><verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>
    <char style="wj">“Fè zanmi depi nan wout avèk lènmi k ap mennen ou tribinal la, pou li pa livre ou devan jij la, e jij la va livre ou bay otorite pou jete ou nan prizon.</char> <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/><char style="wj">Anverite Mwen di nou,</char> <note caller="+" style="x"><char style="xo" closed="false">5:26 </char><char style="xt" closed="false"><ref loc="LUK 12:59">Luc 12:59</ref></char></note><char style="wj">nou p ap soti la jiskaske nou peye dènye santim nan.” </char><verse eid="MAT 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>
    <char style="wj">“Nou konn tande ke yo te di: </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:27 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:14">Egz 20:14</ref>
      </char>
    </note>
    <char style="wj">‘Nou pa pou fè adiltè’; </char> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/><char style="wj">men Mwen di nou ke nenpòt moun ki gade yon fanm</char> <note caller="+" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="2SA 11:25">II Sam 11:25</ref></char></note><char style="wj">avèk lanvi pou li, gen tan fè adiltè avèk li deja nan kè l. </char><verse eid="MAT 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 5:29"/>
    <char style="wj">“Konsa,</char> <note caller="+" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">Mat 18:9</ref></char></note><char style="wj">si zye dwat ou fè ou tonbe, rache li e jete li lwen ou. Paske li pi bon pou pèdi yon manm nan kò ou, pase pou kite tout kò ou jete nan lanfè.</char> <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/><note caller="+" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">Mat 18:8</ref></char></note><char style="wj">Si men dwat ou fè ou tonbe, koupe li e jete li lwen ou. Paske li pi bon pou yon pati nan kò ou ta pèdi olye pou tout kò ou ta ale nan lanfè.”</char><verse eid="MAT 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>
    <char style="wj">“Epi yo te konn di: </char> <note caller="+" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="DEU 24:1">Det 24:1</ref>,<ref loc="DEU 24:3">3</ref></char></note><char style="wj">‘Nenpòt moun ki voye madanm li ale; kite li bay li yon sètifika divòs pou voye l ale.’ </char> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/><note caller="+" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">Mat 19:9</ref></char></note><char style="wj">Men Mwen di nou ke nenpòt moun ki voye madanm li ale, sof pou enfidelite, fè l komèt adiltè, e nenpòt moun ki marye avèk yon fanm divòse fè adiltè. </char><verse eid="MAT 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>
    <char style="wj">“Ankò, nou konn tande yo te di a lansyen yo: </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:33 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 19:12">Lev 19:12</ref>
      </char>
    </note>
    <char style="wj">‘Nou pa pou fè fo sèman, men nou gen pou akonpli tout sa ke nou sèmante a Bondye’.</char> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/><char style="wj">Men Mwen di nou:</char> <note caller="+" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">Jc 5:12</ref></char></note><char style="wj">Pa sèmante menm, ni pa syèl la, paske se</char> <note caller="+" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="DEU 23:3-6">Det 23:3-6</ref>; <ref loc="ISA 66:1">És 66:1</ref></char></note><char style="wj">twòn Bondye li ye; </char> <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/><char style="wj">ni pa tè a, paske se kote Li mete pye Li, ni pa Jérusalem, paske se</char> <note caller="+" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="DEU 23:3-6">Det 23:3-6</ref>; <ref loc="ISA 66:1">És 66:1</ref></char></note><char style="wj">Gran Vil a Gran Wa a.</char> <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/><char style="wj">Ni nou pa pou sèmante sou tèt nou paske nou pa kapab fè menm yon grenn cheve vin blan, ni nwa.</char> <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/><char style="wj">Men kite pawòl nou sèlman ‘wi’ pou ‘wi’ e ‘non’ pou ‘non’. Nenpòt bagay ki depase sa yo soti nan mèt mechanste a. </char><verse eid="MAT 5:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>
    <char style="wj">“Nou konn tande ke yo konn di: </char> <note caller="+" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">Egz 21:24</ref></char></note><char style="wj">‘Zye pou zye e dan pou dan’; </char> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/><char style="wj">men Mwen di nou: Pa reziste a sila ki mechan an, men si </char><note caller="+" style="x"><char style="xo" closed="false">5:39 </char><char style="xt" closed="false"><ref loc="1CO 6:7">I Kor 6:7</ref></char></note><char style="wj">nenpòt moun frape nou bò figi dwat nou, vire bay li lòt la tou.</char> <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/><char style="wj">Si nenpòt moun vle fè pwosè kont nou pou l pran chemiz nou, bay li palto a tou.</char> <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/><char style="wj">Nenpòt moun ki fòse nou pou mache yon kilomèt avèk li, fè de kilomèt.</char> <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/><note caller="+" style="x"><char style="xo" closed="false">5:42 </char><char style="xt" closed="false"><ref loc="DEU 15:7-11">Det 15:7-11</ref></char></note><char style="wj">Bay a sila ki mande nou an, e pa vire do bay sila ki vle prete nan men nou an. </char><verse eid="MAT 5:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>
    <char style="wj">“Nou konn tande ke yo di: ‘Renmen vwazen nou, e rayi lènmi nou.’</char> <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/><char style="wj">Men Mwen di nou: </char> <note caller="+" style="x"><char style="xo" closed="false">5:44 </char><char style="xt" closed="false"><ref loc="LUK 6:27">Luc 6:27</ref></char></note><char style="wj">Renmen lènmi nou yo e priye pou sila ki pèsekite nou yo,</char> <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/><char style="wj">pou nou kapab</char> <note caller="+" style="x"><char style="xo" closed="false">5:45 </char><char style="xt" closed="false"><ref loc="MAT 5:9">Mat 5:9</ref></char></note><char style="wj">fis a Papa nou ki nan syèl la. Paske Li fè solèy Li leve sou mechan yo, ak bon yo, e voye lapli sou sila ki dwat yo, ak sila ki pa dwat yo. </char><verse eid="MAT 5:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 5:46"/>
    <char style="wj">“Paske </char> <note caller="+" style="x"><char style="xo" closed="false">5:46 </char><char style="xt" closed="false"><ref loc="LUK 6:32">Luc 6:32</ref></char></note> <char style="wj">si nou renmen sila ki renmen nou yo, ki rekonpans nou ka resevwa? Èske kolektè kontribisyon yo pa fè menm bagay la tou?</char> <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/><char style="wj">Epi si nou salye frè nou yo sèlman, kisa nou fè plis ke lòt moun yo? Èske payen yo pa fè menm bagay la tou? </char><verse eid="MAT 5:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 5:48"/>
    <char style="wj">Pou sa, nou dwe pafè menm jan ke Papa nou ki nan syèl la pafè.” </char> <note caller="+" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">Lev 19:2</ref>; <ref loc="1JN 3:12">I Jn 3:12</ref></char></note><verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>
    <char style="wj">“Veye pou nou pa pratike ladwati nou devan moun</char> <note caller="+" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="MAT 6:5">Mat 6:5</ref>,<ref loc="MAT 6:16">16</ref></char></note><char style="wj">pou yo kapab wè nou. Si se konsa, nou p ap twouve okenn rekonpans nan men Papa nou ki nan syèl la.</char><verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>
    <char style="wj">“Pou sa, lè nou ap bay lacharite, pa sonnen yon twonpèt devan nou tankou ipokrit yo konn fè nan sinagòg ak lari yo, pou yo</char> <note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="MAT 6:5">Mat 6:5</ref>,<ref loc="MAT 6:16">16</ref></char></note><char style="wj">kapab resevwa lonè a lòm. M ap di ou, yo gen tan resevwa tout rekonpans yo. </char> <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/><char style="wj">Men lè nou ap bay lacharite, pa kite men goch nou konnen kisa men dwat nou ap fè;</char> <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/><char style="wj">ke lacharite nou kapab an sekrè, e</char> <note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JER 17:10">Jr 17:10</ref></char></note><char style="wj">Papa nou ki wè an sekrè a, ap bannou rekonpans.</char><verse eid="MAT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>
    <char style="wj">“Lè nou ap fè lapriyè, pa fè l tankou ipokrit yo. Yo</char> <note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="MRK 11:25">Mc 11:25</ref></char></note><char style="wj">renmen kanpe pou fè lapriyè nan sinagòg yo ak nan kwen lari pou moun kapab wè yo. Anverite, Mwen di nou, yo gen tan twouve tout rekonpans yo.</char><verse eid="MAT 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 6:6"/>
    <char style="wj">“Men nou menm, lè nou ap priye,</char> <note caller="+" style="x"><char style="xo" closed="false">6:6 </char><char style="xt" closed="false"><ref loc="ISA 26:20">És 26:20</ref></char></note><char style="wj">ale nan ti chanm andedan kay nou an, e fèmen pòt nou. Priye a Papa nou ki an sekrè a, e Papa nou ki wè an sekrè a ap bay nou rekonpans.</char><verse eid="MAT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7"/>
    <char style="wj">“Lè nou ap priye, pa itilize anpil mo vag, e san sans jan payen yo konn fè a; paske yo sipoze ke lapriyè yo ap tande akoz</char> <note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="1KI 18:26">I Wa 18:26</ref></char></note><char style="wj">anpil mo.</char> <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/><char style="wj">Men pa fè tankou yo; paske </char> <note caller="+" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="PSA 38:9">Sòm 38:9</ref></char></note> <char style="wj">Papa nou konnen kisa nou bezwen menm avan nou mande Li.</char> <verse eid="MAT 6:8"/><verse number="9" style="v" sid="MAT 6:9"/><char style="wj">Pou tout sa,</char> <note caller="+" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="LUK 11:1-4">Luc 11:1-4</ref></char></note><char style="wj">priye konsa: </char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="wj">“‘Papa nou ki nan syèl la,</char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="wj">ke non Ou kapab Sen. </char><verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>
    <char style="wj">Ke Wayòm Ou kapab vini,</char></para>
  <para style="q1" vid="MAT 6:10">
    <char style="wj">ke volonte Ou kapab fèt sou latè</char></para>
  <para style="q1" vid="MAT 6:10">
    <char style="wj">menm jan ke li fèt nan syèl la. </char><verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>
    <char style="wj">Bay nou pou jou sa a pen </char></para>
  <para style="q1" vid="MAT 6:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:11 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 30:8">Pwov 30:8</ref>
      </char>
    </note> <char style="wj">ke nou bezwen an,</char><verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>
    <char style="wj">Epi</char> <note caller="+" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="EXO 34:7">Egz 34:7</ref></char></note><char style="wj">padone nou ofans nou yo </char></para>
  <para style="q1" vid="MAT 6:12">
    <char style="wj">menm jan ke nou padone sila ki fè nou tò yo. </char><verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>
    <char style="wj">Epi pa mennen nou nan tantasyon, men</char> <note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JHN 17:15">Jn 17:15</ref></char></note> <char style="wj">delivre nou de mal. </char></para>
  <para style="q1" vid="MAT 6:13">
    <char style="wj">Paske wayòm nan, pouvwa a, avèk glwa a </char></para>
  <para style="q1" vid="MAT 6:13">
    <char style="wj">se pou Ou menm pou tout letènite. Amèn.’ </char><verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:2">Mat 7:2</ref>
      </char>
    </note>
    <char style="wj">“Paske si nou padone moun yo pou ofans pa yo, Papa nou ki nan syèl la va padone nou menm.</char> <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/><char style="wj">Men</char> <note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="MAT 18:35">Mat 18:35</ref></char></note><char style="wj">si nou pa padone moun yo pou ofans pa yo, Papa nou p ap padone ofans pa nou yo.</char><verse eid="MAT 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>
    <char style="wj">“Konsa,</char> <note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="ISA 58:5">És 58:5</ref></char></note><char style="wj">lè nou ap fè jèn, pa mete yon figi tris jan ipokrit yo konn fè a. Paske yo neglije aparans yo pou moun kapab wè ke y ap fè jèn. Anverite, yo deja twouve tout rekonpans pa yo. </char><verse eid="MAT 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 6:17"/>
    <char style="wj">“Men nou menm, lè nou ap fè jèn,</char> <note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="RUT 3:3">Rt 3:3</ref></char></note><char style="wj">onksyone tèt nou avèk lwil e lave figi nou,</char> <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/><char style="wj">pou moun pa wè ke nou ap fè jèn, men se Papa nou ki nan sekrè a k ap wè. Konsa,</char> <note caller="+" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="MAT 6:4-6">Mat 6:4-6</ref></char></note><char style="wj">Papa nou ki wè nan sekrè a ap bannou rekonpans.</char><verse eid="MAT 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:19 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:4">Pwov 23:4</ref>
      </char>
    </note>
    <char style="wj">“Pa ranmase trezò nou isit la nan mond sa a kote ensèk avèk lawouj ap detwi yo, e kote vòlè kapab kase antre pou vòlè. </char> <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/><char style="wj">Men pito nou ranmase pou nou</char> <note caller="+" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="MAT 19:21">Mat 19:21</ref></char></note><char style="wj">trezò ki nan syèl la kote ensèk avèk lawouj p ap detwi yo, e kote vòlè p ap kase ni vòlè.</char> <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/><char style="wj">Paske</char> <note caller="+" style="x"><char style="xo" closed="false">6:21 </char><char style="xt" closed="false"><ref loc="LUK 12:34">Luc 12:34</ref></char></note><char style="wj">kote trezò nou ye se la kè nou va ye tou. </char><verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>
    <char style="wj">“Lanp kò nou se</char> <note caller="+" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="LUK 11:34-35">Luc 11:34-35</ref></char></note><char style="wj">zye nou. Konsa si zye nou klè, tout kò nou ap plen limyè.</char> <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/><char style="wj">Men si</char> <note caller="+" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="MAT 20:15">Mat 20:15</ref></char></note><char style="wj">zye nou pa bon, tout kò nou ap plen tenèb. </char></para>
  <para style="p" vid="MAT 6:23">
    <char style="wj">“Konsa, si limyè ki nan nou an se tenèb, ki pwofondè tenèb sa a genyen! </char><verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:24 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 18:21">I Wa 18:21</ref>
      </char>
    </note>
    <char style="wj">“Nanpwen moun ki kab sèvi de mèt; swa l ap rayi youn pou renmen lòt la, oswa l ap renmen youn pou meprize lòt la. Nou pa kapab sèvi Bondye ak richès. </char><verse eid="MAT 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:25 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:22-31">Luc 12:22-31</ref>
      </char>
    </note>
    <char style="wj">“Pou rezon sa a, Mwen di nou pa enkyete nou pou lavi nou, kisa nou ap manje, ni sa nou ap bwè; ni pou kò nou, pou sa nou ap mete sou li. Èske lavi pa plis ke manje, e kò a plis ke rad nou mete sou li? </char> <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/><note caller="+" style="x"><char style="xo" closed="false">6:26 </char><char style="xt" closed="false"><ref loc="JOB 35:11">Job 35:11</ref></char></note><char style="wj">Gade zwazo ki anlè yo; yo pa simen, ni rekòlte, ni ranmase pou mete nan depo. Malgre sa, Papa yo bay yo manje. Èske nou pa vo bokou plis ke yo?</char><verse eid="MAT 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 6:27"/>
    <char style="wj">“Epi kilès nan nou ki avèk</char> <note caller="+" style="x"><char style="xo" closed="false">6:27 </char><char style="xt" closed="false"><ref loc="MAT 6:25">Mat 6:25</ref>,<ref loc="MAT 6:28">28</ref>,<ref loc="MAT 6:31">31</ref>,<ref loc="MAT 6:34">34</ref></char></note><char style="wj">enkyetid kapab ogmante vi li menm yon ti kras?</char> <verse eid="MAT 6:27"/><verse number="28" style="v" sid="MAT 6:28"/><char style="wj">E poukisa nou</char> <note caller="+" style="x"><char style="xo" closed="false">6:28 </char><char style="xt" closed="false"><ref loc="MAT 6:25-28">Mat 6:25-28</ref></char></note><char style="wj">enkyete pou zafè rad?</char></para>
  <para style="p" vid="MAT 6:28">
    <char style="wj">“Gade flè lis ki nan chan yo; yo pa travay, ni fè twal;</char> <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/><char style="wj">men Mwen di nou ke menm</char> <note caller="+" style="x"><char style="xo" closed="false">6:29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">I Wa 10:4-7</ref></char></note><char style="wj">Salomon nan tout glwa li pa t mete pi bèl rad pase youn nan yo. </char> <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/><char style="wj">“Men si se konsa ke Bondye abiye</char> <note caller="+" style="x"><char style="xo" closed="false">6:30 </char><char style="xt" closed="false"><ref loc="JAS 1:10-11">Jc 1:10-11</ref></char></note><char style="wj">zèb chan an, ki la jodi a, e demen ap jete nan dife, konbyen anplis L ap fè pou nou, o</char> <note caller="+" style="x"><char style="xo" closed="false">6:30 </char><char style="xt" closed="false"><ref loc="MAT 8:26">Mat 8:26</ref></char></note><char style="wj">nou menm, moun ki manke lafwa!</char><verse eid="MAT 6:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31"/>
    <char style="wj">“Konsa, pa </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:31 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 6:25">Mat 6:25</ref>,<ref loc="MAT 6:27">27</ref>,<ref loc="MAT 6:28">28</ref>,<ref loc="MAT 6:34">34</ref></char>
    </note>
    <char style="wj">enkyete nou, pou di: ‘Kisa n ap manje?’ ni ‘Kisa n ap bwè?’ ni ‘Avèk kisa n ap abiye?’ </char> <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/><char style="wj">Paske se tout bagay sa yo ke tout payen yo cho pou chèche, men </char><note caller="+" style="x"><char style="xo" closed="false">6:32 </char><char style="xt" closed="false"><ref loc="MAT 6:8">Mat 6:8</ref></char></note><char style="wj">Papa nou ki nan syèl la konnen ke nou bezwen tout bagay sa yo. </char> <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/><char style="wj">Chèche premyèman wayòm Li avèk ladwati Li, epi</char> <note caller="+" style="x"><char style="xo" closed="false">6:33 </char><char style="xt" closed="false"><ref loc="MAT 19:28">Mat 19:28</ref></char></note><char style="wj">tout bagay sa yo ap vini anplis.</char><verse eid="MAT 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34"/>
    <char style="wj">“Pou sa, pa enkyete nou pou demen, paske demen ap okipe tèt li. Chak jou gen kont pwoblèm li pou regle pou kont li.” </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:34 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 30:8">Pwov 30:8</ref>
      </char>
    </note><verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 14:10">Wo 14:10</ref>,<ref loc="ROM 14:13">13</ref></char>
    </note>
    <char style="wj">“Pa jije pou nou menm pa vin jije.</char> <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/><char style="wj">Paske menm jan ke nou jije a, nou menm tou, nou va vin jije;</char> <note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">Mc 4:24</ref></char></note><char style="wj">pa menm mezi ke nou sèvi a, yo va mezire bay nou.</char> <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/><char style="wj">E poukisa nou</char> <note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="ROM 2:1">Wo 2:1</ref></char></note><char style="wj">gade ti kras poud ki nan zye frè nou an, men nou pa wè gwo bout bwa ki nan zye pa nou an? </char> <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/><note caller="+" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="LUK 6:42">Luc 6:42</ref></char></note><char style="wj">O kijan nou kapab di frè nou an: ‘Kite m retire ti kras sa a ki nan zye ou a’, epi gade, gwo bout bwa nan zye w?</char> <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/><char style="wj">Ipokrit! Premyeman, retire gwo bout bwa nan zye ou a, e konsa w ap kapab wè byen klè pou retire ti kras ki nan zye frè ou a.</char><verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:6 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 15:26">Mat 15:26</ref>
      </char>
    </note>
    <char style="wj">“Pa bay sa ki sen a chen yo; ni pa jete pèl nou yo devan kochon yo, sinon yo va foule yo anba pye epi vire pou chire nou an mòso.</char><verse eid="MAT 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:7 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 11:9-13">Luc 11:9-13</ref>
      </char>
    </note>
    <char style="wj">“Mande, e nou va resevwa. Chache, e nou va twouve. Frape nan pòt la, e l ap louvri.</char> <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/><char style="wj">Paske tout moun ki mande ap resevwa. E sila ki chèche yo va twouve. E a sila ki frape yo, pòt la va louvri.</char> <verse eid="MAT 7:8"/><verse number="9" style="v" sid="MAT 7:9"/><char style="wj">O ki moun pami nou lè Pitit li mande yon moso pen, l ap bay li yon wòch?</char> <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/><char style="wj">O si li mande yon pwason, èske l ap bay li yon koulèv?</char> <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/><char style="wj">Si nou menm ki mechan, konnen kijan pou bay bon kado a pitit nou yo, </char><note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="PSA 84:11">Sòm 84:11</ref></char></note><char style="wj">konbyen anplis, Papa nou ki nan syèl la ap bay sa ki bon a sila ki mande Li yo.</char> <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/><note caller="+" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="LUK 6:31">Luc 6:31</ref></char></note><char style="wj">Pou sa, menm jan ke nou vle moun aji avèk nou, fè yo menm bagay la, paske</char> <note caller="+" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="MAT 22:40">Mat 22:40</ref></char></note><char style="wj">sa se Lalwa, ak Pwofèt yo. </char><verse eid="MAT 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:13 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 13:24">Luc 13:24</ref>
      </char>
    </note>
    <char style="wj">“Antre pa pòt etwat la; paske pòt laj la, e chemen byen gwo ki mennen nan destriksyon an. Gen anpil moun k ap antre pa li menm.</char> <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/><char style="wj">Paske pòt etwat la, e chemen piti ki mennen a lavi a. Ni pa gen anpil moun k ap twouve l.</char><verse eid="MAT 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>
    <char style="wj">“Veye nou ak</char> <note caller="+" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="MAT 24:11">Mat 24:11</ref>,<ref loc="MAT 24:24">24</ref></char></note><char style="wj">fo pwofèt yo, ki vin kote nou ak vètman brebi; men anndan se lou visye yo ye.</char> <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/><char style="wj">Nou ap</char> <note caller="+" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="MAT 7:20">Mat 7:20</ref></char></note><char style="wj">konnen yo pa fwi yo. Rezen pa janm soti nan raje pikan, ni fig frans nan move zèb.</char> <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/><char style="wj">Menm jan an, </char><note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="MAT 12:33">Mat 12:33</ref>,<ref loc="MAT 12:35">35</ref></char></note><char style="wj">chak bon ab ap bay bon fwi, men yon move ab ap bay move fwi.</char> <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/><char style="wj">Yon bon ab p ap kapab bay move fwi, ni yon move ab p ap pwodwi bon fwi.</char> <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/><note caller="+" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">Mat 3:10</ref></char></note><char style="wj">Chak ab ki pa bay bon fwi ap koupe jete nan lanfè.</char> <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/><char style="wj">Konsa, nou ap konnen yo </char><note caller="+" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 7:16">Mat 7:16</ref></char></note><char style="wj">pa fwi yo.</char><verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:21 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:46">Luc 6:46</ref>
      </char>
    </note>
    <char style="wj">“Se pa tout moun ki rele ‘Senyè, Senyè’ k ap antre nan wayòm syèl la, men sila yo ki fè volonte a Papa M ki nan syèl la.</char> <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/><note caller="+" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="MAT 25:11">Mat 25:11</ref></char></note><char style="wj">Anpil ap di Mwen nan jou sa: ‘Senyè, Senyè, èske nou pa t pwofetize nan non Ou? Èske nan non Ou, nou pa t chase move lespri yo e nan non Ou, nou pa t fè anpil mirak?’ </char> <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/><char style="wj">Konsa, nan moman sa a, M ap deklare:</char> <note caller="+" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">Sòm 6:8</ref></char></note><char style="wj">‘Mwen pa t janm konnen nou. Kite Mwen, nou tout ki pratike lenjistis.’</char><verse eid="MAT 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>
    <char style="wj">“Pou sa, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:18">Mat 16:18</ref>
      </char>
    </note>
    <char style="wj">tout moun ki tande pawòl sa yo ke Mwen bay yo, e ki aji sou yo, y ap tankou yon nonm saj ki bati kay li sou wòch. </char> <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/><char style="wj">Lapli te tonbe, inondasyon te vini, van te soufle e te frape kont kay la, men li pa t tonbe paske fondasyon li te sou wòch. </char> <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/><char style="wj">Tout moun ki tande pawòl sa yo ke Mwen pale yo, e ki pa aji sou yo, y ap tankou yon moun sòt. Li te bati kay li sou sab.</char> <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/><char style="wj">Lapli te tonbe, inondasyon te vini, van te soufle e te frape kont kay la. Li te tonbe, e tonbe sa a te byen gwo.” </char><verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>Lè Jésus te fin pale mo sa yo, <note caller="+" style="x"><char style="xo" closed="false">7:28 </char><char style="xt" closed="false"><ref loc="MAT 13:54">Mat 13:54</ref></char></note>foul la te byen etone pou jan Li te enstwi yo a. <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>Paske Li te enstwi yo tankou yon moun avèk otorite, e pa tankou skrib yo.<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>Lè Jésus te fin desann mòn nan, yon gran foul te swiv Li. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Epi <note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MRK 1:40-44">Mc 1:40-44</ref></char></note>yon moun lalèp te vin kote L, te bese devan Li. Li te di: “Senyè, si se volonte Ou, Ou kapab fè m vin pwòp”.<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>Jésus te lonje men Li e te touche l. Li te di l: <char style="wj">“Se volonte Mwen; vin pwòp.” </char>Imedyatman <note caller="+" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="MAT 11:5">Mat 11:5</ref></char></note>lèp la te vin pwòp. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>Jésus te di li: <char style="wj">“Gade pou ou pa di pèsòn sa, men </char> <note caller="+" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="MRK 1:44">Mc 1:44</ref></char></note> <char style="wj">ale prezante ou devan prèt la, epi bay yo ofrann lan ke Moïse te mande a kon yon temwayaj a yo menm.”</char><verse eid="MAT 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:5 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:1-10">Luc 7:1-10</ref>
      </char>
    </note>Lè Jésus te fin antre Capernaüm, yon chèf sentiwon Women te vin sipliye Li: <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>“Senyè, sèvitè mwen an kouche <note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="MAT 4:24">Mat 4:24</ref></char></note>paralize lakay mwen. L ap soufri anpil.”<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>Jésus Li te di li: <char style="wj">“M ap vin geri li.” </char><verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>Men sentiwon an te reponn Li: “Senyè, mwen pa dign pou Ou pase anba twati kay mwen, men sèlman di yon mo, e sèvitè mwen an va geri. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>Paske mwen menm tou se yon moun anba <note caller="+" style="x"><char style="xo" closed="false">8:9 </char><char style="xt" closed="false"><ref loc="MRK 1:27">Mc 1:27</ref></char></note>otorite, avèk sòlda anba mwen. Mwen di a youn ‘ale’, li ale, e a yon lòt ‘vini’, e li vini, epi a esklav mwen ‘Fè sa’ e li fè l.”<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>Lè Jésus te tande sa, Li te etone e te di a sila ki t ap swiv Li yo: <char style="wj">“Anverite, Mwen di nou, Mwen pa twouve lafwa konsa nan okenn moun an Israël.</char> <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/><char style="wj">Konsa, Mwen di nou ke anpil moun</char> <note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="ISA 49:12">És 49:12</ref></char></note><char style="wj">va vin soti nan lès ak lwès pou chita sou tab avèk Abraham, Isaac ak Jacob nan wayòm syèl la;</char> <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/><char style="wj">men </char> <note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 13:38">Mat 13:38</ref></char></note> <char style="wj">fis yo a wayòm lan ap jete deyò nan </char><note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 22:13">Mat 22:13</ref></char></note><char style="wj">fon tenèb. E nan plas sa a, yo va rele anmwey e yo va manje dan yo.”</char> <verse eid="MAT 8:12"/><verse number="13" style="v" sid="MAT 8:13"/>Jésus te di a sentiwon an: <char style="wj">“Ou mèt ale. Ke sa fèt pou ou </char><note caller="+" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="MAT 9:22">Mat 9:22</ref>,<ref loc="MAT 9:29">29</ref></char></note><char style="wj">jan ou kwè a.” </char> Konsa, sèvitè li a te geri nan menm lè sa a.<verse eid="MAT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:14 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:29-34">Mc 1:29-34</ref>
      </char>
    </note>Lè Jésus te antre lakay Pierre, Li te wè bèlmè li kouche malad sou kabann li avèk lafyèv. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>Lè Li fin touche men li, lafyèv la te kite l. Konsa, li te leve pou sèvi Li. <verse eid="MAT 8:15"/><verse number="16" style="v" sid="MAT 8:16"/>Lè fènwa te vin rive, yo te pote bay Li anpil moun <note caller="+" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="MAT 4:24">Mat 4:24</ref></char></note>ki te gen move lespri. Li te jete move lespri sa yo deyò avèk yon mo, e te <note caller="+" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>geri tout malad yo. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Sa te fèt pou akonpli sa ke pwofèt Ésaïe te pale lè li te di: <note caller="+" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">És 53:4</ref></char></note>“Li menm te pran tout enfimite nou yo, e pote tout maladi nou yo.”<verse eid="MAT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>Lè Jésus te wè yon foul t ap antoure l, <note caller="+" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MRK 4:35">Mc 4:35</ref></char></note>Li te pase lòd pou pati ale lòtbò lanmè a.<verse eid="MAT 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 8:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:19 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 9:57-60">Luc 9:57-60</ref>
      </char>
    </note>Yon sèten skrib te parèt. Li te di L: “Mèt, m ap swiv ou nenpòt kote ou ale.”<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>Jésus te di li: <char style="wj">“Rena yo gen twou pou yo kache, e zwazo anlè yo gen nich pa yo, men</char> <note caller="+" style="x"><char style="xo" closed="false">8:20 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7:13</ref></char></note><char style="wj">Fis a Lòm nan pa gen kote pou repoze tèt Li.” </char><verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>Yon lòt nan disip Li yo te di Li: “Senyè, kite mwen premyèman ale antere papa m.”<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>Men Jésus te di li: <note caller="+" style="x"><char style="xo" closed="false">8:22 </char><char style="xt" closed="false"><ref loc="MAT 9:9">Mat 9:9</ref></char></note><char style="wj">“Swiv Mwen. Kite mò yo antere mò parèy yo.” </char><verse eid="MAT 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:23 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 4:36-41">Mc 4:36-41</ref>
      </char>
    </note>Lè L fin antre nan kannòt la, disip Li yo te swiv Li. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Epi konsa, te vin leve yon gwo tanpèt sou lanmè a, ki te fè vag lanmè yo kouvri kannòt la; men Jésus, Li menm, t ap dòmi. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>Disip Li yo te vin fè L leve. Yo te di L: “Senyè, sove nou! N ap peri!”<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>Li te reponn yo: <char style="wj">“Poukisa nou pè konsa, </char><note caller="+" style="x"><char style="xo" closed="false">8:26 </char><char style="xt" closed="false"><ref loc="MAT 6:30">Mat 6:30</ref></char></note><char style="wj">moun ak ti lafwa piti?” </char> Konsa Li te leve. Li te reprimande van an avèk lanmè a, e tan an te vin kalm nèt.<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>Moun yo te etone. Yo te di: “Ki kalite moun sa a ye, ke menm van avèk lanmè obeyi Li?”<verse eid="MAT 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:28 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 5:1-17">Mc 5:1-17</ref>
      </char>
    </note>Lè li te rive lòtbò nan peyi Gadarenyen yo, de moun ki te gen move lespri te rankontre li pandan yo t ap soti nan tonm yo. Yo te tèlman vyolan ke pèsòn pa t kapab pase nan chemen sa a. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>Epi yo te kriye e te di: <note caller="+" style="x"><char style="xo" closed="false">8:29 </char><char style="xt" closed="false"><ref loc="JDG 11:12">Jij 11:12</ref></char></note>“Kisa nou gen avè W, Fis Bondye a? Èske Ou vini la pou toumante nou avan lè a?” <verse eid="MAT 8:29"/><verse number="30" style="v" sid="MAT 8:30"/>A yon distans, te gen yon bann kochon ki t ap manje. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Epi lespri yo te kòmanse sipliye Li konsa: “Si ou ap mete nou deyò, voye nou nan bann kochon sa yo.”<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>Li te di yo: <char style="wj">“Ale!”</char></para>
  <para style="p" vid="MAT 8:32">Yo te pati e te ale nan kochon yo. Lapoula, tout bann kochon yo te kouri desann falèz la, tonbe nan lanmè, pou mouri nan dlo a.<verse eid="MAT 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33"/>Gadyen yo te kouri ale antre nan vil la kote yo te fè rapò tout bagay sa yo, ansanm avèk sa ki te rive <note caller="+" style="x"><char style="xo" closed="false">8:33 </char><char style="xt" closed="false"><ref loc="MAT 4:24">Mat 4:24</ref></char></note>moun move lespri yo. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Konsa, tout vil la te soti pou rankontre Jésus. Lè yo te wè L, <note caller="+" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="AMO 7:12">Am 7:12</ref></char></note>yo te sipliye Li pou kite peyi yo a.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>Jésus te antre nan yon kannòt pou travèse dlo a, e te vin rive nan <note caller="+" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="MAT 4:13">Mat 4:13</ref></char></note>pwòp vil Li a. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/><note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="MRK 2:3-12">Mc 2:3-12</ref></char></note>Epi konsa, yo te pote bay Li yon moun paralize ki kouche sou yon kabann. Lè Jésus te wè lafwa yo, Li te di a moun paralize a: <char style="wj">“Pran kouraj fis Mwen, peche ou yo padone.” </char><verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>Kèk nan skrib yo te reflechi nan kè yo: “Moun sa a <note caller="+" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="MRK 3:28-29">Mc 3:28-29</ref></char></note>ap blasfeme.”<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>Men Jésus te <note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="MAT 12:25">Mat 12:25</ref></char></note>konnen panse yo e Li te di: <char style="wj">“Poukisa nou ap reflechi mal nan kè nou? </char> <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/><char style="wj">Kisa ki pi fasil pou di: </char><note caller="+" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="MAT 9:2">Mat 9:2</ref>,<ref loc="MAT 9:6">6</ref></char></note><char style="wj">‘Peche ou yo padone’, oubyen ‘leve mache’?</char> <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/><char style="wj">Men pou nou kapab konprann ke Fis a lòm nan gen otorite sou latè pou padone peche”, </char> Li te di a paralitik la: <char style="wj">“Leve, pran kabann ou e ale lakay ou!” </char><verse eid="MAT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7"/>Epi konsa, Li te leve ale lakay li. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>Lè foul la te wè sa, yo te etonnen, e yo te <note caller="+" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="MAT 5:16">Mat 5:16</ref></char></note>bay glwa a Bondye ki te bay otorite konsa a lèzòm.<verse eid="MAT 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:9 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 2:14-22">Mc 2:14-22</ref>
      </char>
    </note>Lè Jésus te kite kote sa a, Li te wè yon nonm yo rele Matthieu ki te chita nan biwo kontribisyon an. Li te di l: <char style="wj">“Swiv Mwen!” </char> Epi li te leve e te swiv Li. <verse eid="MAT 9:9"/><verse number="10" style="v" sid="MAT 9:10"/>Li vin rive pandan Li te sou tab nan kay la, ke anpil ouvriye travay Kontribisyon an, avèk anpil pechè t ap manje avèk Jésus ak disip Li yo. <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>Lè Farizyen yo te wè sa, yo te di a disip Li yo: <note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAT 11:19">Mat 11:19</ref></char></note>“Poukisa Mèt nou ap manje avèk moun kontribisyon ak pechè sa yo?”<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>Men, lè Jésus tande sa, Li te di: <char style="wj">“Se pa </char><note caller="+" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="MRK 2:17">Mc 2:17</ref></char></note><char style="wj">sila ki ansante yo ki bezwen yon doktè, men sila ki malad yo.</char> <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/><char style="wj">Men ale konprann kisa sa vle di: </char> <note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Os 6:6</ref></char></note><char style="wj">‘Mwen dezire mizerikòd, pa sakrifis’, paske mwen pa t vini pou rele jis yo, men pechè yo.” </char><verse eid="MAT 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>Aprè sa, disip a Jean yo <note caller="+" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="LUK 18:12">Luc 18:12</ref></char></note>te vini mande L: “Poukisa nou menm avèk Farizyen yo fè jèn, men disip Ou yo pa fè l?”<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>Jésus di yo konsa: <char style="wj">“Èske moun k ap fete avèk mesye maryaj la kapab tris pandan mesye a toujou la? Men jou yo ap vini lè mesye a p ap la ankò e nan tan sa a, yo va fè jèn. </char> <verse eid="MAT 9:15"/><verse number="16" style="v" sid="MAT 9:16"/><char style="wj">Men pèsòn pa pyese yon vye rad avèk yon twal nèf dekwa ke twal nèf la pa vin chire lè l ap ratresi pou chire rad la pi mal.</char> <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/><char style="wj">Ni moun pa mete diven nèf nan po kwi ansyen, sinon po a ap fann, diven an va tonbe, e ansyen po a va gate. Men yo mete diven nèf nan po nèf pou tou de kapab konsève.”</char><verse eid="MAT 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:18 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 5:22-43">Mc 5:22-43</ref>
      </char>
    </note>Pandan Li t ap pale konsa avèk yo, yon ofisye sinagòg la te vin bese devan Li e te di L: “Fi mwen an apèn fin mouri, men si ou vin mete men ou sou li, l ap viv.”<verse eid="MAT 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19"/>Jésus te leve e te swiv li ansanm avèk tout disip Li yo. <verse eid="MAT 9:19"/><verse number="20" style="v" sid="MAT 9:20"/>Konsa, yon fanm ki te soufri yon maladi pèt de san depi douz ane te parèt pa dèyè Li, e te touche <note caller="+" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="NUM 15:38">Nonb 15:38</ref></char></note>rebò vètman Li; <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>paske li t ap di nan tèt li: “Si sèlman mwen kapab <note caller="+" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="MAT 14:36">Mat 14:36</ref></char></note>touche rebò vètman Li, m ap geri.”<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>Men Jésus te vire wè li e te di li: <char style="wj">“Fi mwen, pran kouraj, </char><note caller="+" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="MAT 9:29">Mat 9:29</ref></char></note><char style="wj">fwa ou gen tan fè ou geri.”</char> Lapoula, fanm nan te gen tan geri.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>Konsa, lè Jésus te rive lakay ofisye a, Li te wè <note caller="+" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="2CH 35:25">II Kwo 35:25</ref></char></note>moun ki t ap jwe flit avèk yon foul ki t ap fè anpil bwi avèk dezòd. <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>Li te di: <char style="wj">“Fè yon ti deplase; fi a </char> <note caller="+" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="JHN 11:13">Jn 11:13</ref></char></note><char style="wj">pa mouri, men se dòmi, l ap dòmi.” </char></para>
  <para style="p" vid="MAT 9:24">Epi yo te kòmanse ri sou Li. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>Men <note caller="+" style="x"><char style="xo" closed="false">9:25 </char><char style="xt" closed="false"><ref loc="ACT 9:40">Trav 9:40</ref></char></note>lè foul la te soti deyò, Li te antre, <note caller="+" style="x"><char style="xo" closed="false">9:25 </char><char style="xt" closed="false"><ref loc="MRK 9:27">Mc 9:27</ref></char></note>pran men li, e fi a te vin leve. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/><note caller="+" style="x"><char style="xo" closed="false">9:26 </char><char style="xt" closed="false"><ref loc="MAT 4:24">Mat 4:24</ref></char></note>Nouvèl sa a te kouri toupatou nan peyi a.<verse eid="MAT 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>Lè Jésus te rive pi lwen, de moun avèg t ap swiv Li. Konsa, yo t ap kriye: “Fè nou gras <note caller="+" style="x"><char style="xo" closed="false">9:27 </char><char style="xt" closed="false"><ref loc="MAT 1:1">Mat 1:1</ref></char></note>Fis a David la!” <verse eid="MAT 9:27"/><verse number="28" style="v" sid="MAT 9:28"/>Lè L te fin antre nan kay la, yo te vin kote L. Li te mande yo: <char style="wj">“Èske nou kwè ke Mwen kapab fè sa?” </char></para>
  <para style="p" vid="MAT 9:28">Yo te reponn Li: “Wi, Senyè”.<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>Li te touche zye yo e te di: <char style="wj">“Ke sa fèt</char> <note caller="+" style="x"><char style="xo" closed="false">9:29 </char><char style="xt" closed="false"><ref loc="MAT 8:13">Mat 8:13</ref></char></note><char style="wj">selon lafwa nou.” </char> <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>Epi zye yo te vin louvri. Jésus <note caller="+" style="x"><char style="xo" closed="false">9:30 </char><char style="xt" closed="false"><ref loc="MAT 8:4">Mat 8:4</ref></char></note>te pale ak yo sevèman: <char style="wj">“Gade byen, pa kite pèsòn konnen bagay sa a.” </char> <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>Men yo te ale deyò e <note caller="+" style="x"><char style="xo" closed="false">9:31 </char><char style="xt" closed="false"><ref loc="MAT 4:24">Mat 4:24</ref></char></note>te gaye nouvèl la toupatou nan peyi a.<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>E pandan yo t ap soti deyò, konsa, yo te pote bay Li <note caller="+" style="x"><char style="xo" closed="false">9:32 </char><char style="xt" closed="false"><ref loc="MAT 12:22">Mat 12:22</ref>,<ref loc="MAT 12:24">24</ref></char></note>yon moun bèbè avèk yon move lespri. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>Lè Li fin jete move lespri a, bèbè a vin pale. Tout foul la te byen etone. Yo te di: <note caller="+" style="x"><char style="xo" closed="false">9:33 </char><char style="xt" closed="false"><ref loc="MRK 2:12">Mc 2:12</ref></char></note>“Nou pa janm wè anyen parèy a sa an Israël.”<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>Men Farizyen yo t ap di: <note caller="+" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="MAT 12:24">Mat 12:24</ref></char></note>“Li chase move lespri yo pa pouvwa a mèt move lespri yo.”<verse eid="MAT 9:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>Jésus t ap prale toupatou nan tout vil ak tout bouk yo. Li t ap <note caller="+" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>enstwi nan sinagòg yo pou pwoklame bòn nouvèl wayòm nan, e Li t ap geri tout kalite maladi ak pwoblèm fizik. <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Epi lè Li wè tout foul moun yo, Li te gen konpasyon pou yo, <note caller="+" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Nonb 27:17</ref></char></note>paske yo te dezole e dekouraje tankou mouton ki san gadò. <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>Konsa Li di a disip Li yo: <note caller="+" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="LUK 10:2">Luc 10:2</ref></char></note><char style="wj">“Rekòlt la anpil, men ouvriye yo manke. </char> <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/><char style="wj">Pou sa, sipliye Senyè rekòlt la pou voye ouvriye nan rekòlt Li a.” </char><verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>Jésus te rele douz disip li yo. Li te bay yo pouvwa sou move lespri yo, pou chase yo deyò, e pou geri tout kalite enfimite avèk maladi. <note caller="+" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="MRK 3:13-15">Mc 3:13-15</ref></char></note> <verse eid="MAT 10:1"/><verse number="2" style="v" sid="MAT 10:2"/><note caller="+" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MRK 3:16-19">Mc 3:16-19</ref></char></note>Alò, non a douz apot yo te konsa: Premye a, Simon, ke yo rele Pierre, André, frè li, Jacques, fis a Zébédée, Jean, frè li, <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/><note caller="+" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="JHN 1:4">Jn 1:4</ref>; <ref loc="JHN 11:16">Jn 11:16</ref></char></note>Philippe ak Barthélèmy; Thomas ak Matthieu ki te kolektè kontribisyon an, Jacques, fis Alphée a, ak Thaddée; <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>Simon, Zelòt la ak <note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="MAT 26:14">Mat 26:14</ref></char></note>Judas Iscariot, sila ki te trayi Jésus a.<verse eid="MAT 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>Douz sila yo Jésus te voye lè Li te fin enstwi yo konsa: <char style="wj">“Pa antre nan chemen payen yo, ni pa antre nan okenn vil ki pou</char> <note caller="+" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="2KI 17:24">II Wa 17:24</ref></char></note><char style="wj">Samariten yo, </char> <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/><char style="wj">Men pito ale vè</char> <note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="MAT 15:24">Mat 15:24</ref></char></note><char style="wj">mouton ki pèdi lakay Israël yo.</char> <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/><char style="wj">Pandan n ap prale, preche epi di: </char> <note caller="+" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat 3:2</ref></char></note><char style="wj">‘Wayòm syèl la prèt pou rive.’ </char> <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/><char style="wj">Geri malad yo, leve mò yo, pirifye lepre yo, chase move lespri yo. Nou te resevwa gratis, nou mèt bay gratis.</char> <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/><note caller="+" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="LUK 22:35">Luc 22:35</ref></char></note><char style="wj">Nou pa pou pran ni lò, ni lajan ni kwiv pou mete nan bous senti nou, </char> <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/><char style="wj">Ni yon sak pou vwayaj nou, pa menm de chemiz, ni sapat, ni baton; paske yon </char><note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">I Kor 9:14</ref></char></note><char style="wj">ouvriye merite soutyen li. </char><verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>
    <char style="wj">“Nan nenpòt vil oubyen bouk ke nou antre, mande kilès ki gen merit nan li, epi ak li pou nou rete jis lè nou kite vil sa a.</char> <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/><char style="wj">Pandan n ap antre nan kay la,</char> <note caller="+" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="1SA 25:6">I Sam 25:6</ref></char></note><char style="wj">bay li salitasyon nou.</char> <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/><char style="wj">Epi si kay la gen merit, ke benediksyon lapè nou rete sou li, men si li pa gen merit, ke benediksyon lapè nou retounen sou nou.</char> <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/><char style="wj">Nenpòt moun ki pa resevwa nou, ni pa okipe pawòl nou, lè nou kite kay sa a, oubyen vil sa a, </char><note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 15:21">Trav 15:21</ref></char></note><char style="wj">souke pye nou pou pousyè li pa rete. </char> <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/><char style="wj">Anverite Mwen di nou,</char> <note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:22">Mat 11:22</ref>,<ref loc="MAT 11:24">24</ref></char></note><char style="wj">l ap pi tolerab pou peyi Sodome ak Gomorrhe nan jou jijman an pase vil sa a.”</char><verse eid="MAT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:16 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:3">Luc 10:3</ref>
      </char>
    </note>
    <char style="wj">Veye byen, Mwen voye nou tankou mouton nan mitan lou. Konsa, se pou nou saj kon sèpan, men inosan kon toutrèl.</char><verse eid="MAT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17"/>
    <char style="wj">Men veye lèzòm, y ap livre nou devan </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:17 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:22">Mat 5:22</ref>
      </char>
    </note>
    <char style="wj">tribinal yo, e y ap bat nou ak fwèt nan sinagòg yo. </char> <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/><char style="wj">Konsa, y ap menm fè nou vini devan ofisye ak wa yo pou non Mwen, kon yon temwayaj de yo menm ak lòt nasyon yo. </char> <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/><note caller="+" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="MRK 13:11-13">Mc 13:11-13</ref></char></note><char style="wj">Men lè yo livre nou nan men yo, pa enkyete pou sa n ap di; paske nou va resevwa nan lè sa, sa nou gen pou nou pale.</char> <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/><char style="wj">Paske </char><note caller="+" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="LUK 12:12">Luc 12:12</ref></char></note><char style="wj">se pa nou menm k ap pale, men se Lespri Papa nou an k ap pale nan nou. </char><verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:35">Mat 10:35</ref>,<ref loc="MAT 10:36">36</ref></char>
    </note>
    <char style="wj">Frè va livre frè l a lanmò, e papa va livre Pitit li. Zanfan yo ap leve kont paran yo e fè mete yo a lanmò.</char> <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/><note caller="+" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">Mat 24:9</ref></char></note><char style="wj">Nou va rayi pa tout moun akoz non Mwen, men sila ki reziste jiska lafen an ap sove.</char><verse eid="MAT 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 10:23"/>
    <char style="wj">Men nenpòt lè ke yo pèsekite nou nan yon vil, sove ale nan yon lòt. Paske anverite Mwen di nou, nou p ap gen tan fin pase nan tout vil Israël yo,</char> <note caller="+" style="x"><char style="xo" closed="false">10:23 </char><char style="xt" closed="false"><ref loc="MAT 16:27">Mat 16:27</ref></char></note><char style="wj">pou lè Fis a Lòm nan vini.</char><verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:24 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:40">Luc 6:40</ref>
      </char>
    </note>
    <char style="wj">Yon disip pa pi wo pase enstriktè li, ni yon esklav pase mèt li. </char> <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/><char style="wj">Se kont pou yon disip pou li vini menm jan avèk enstriktè li, e yon esklav menm jan ak mèt li. Si yo rele mèt kay la</char> <note caller="+" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="2KI 1:2">II Wa 1:2</ref></char></note><char style="wj">Béelzébul, konbyen anplis pou yo kalomye manm kay li yo!</char> <verse eid="MAT 10:25"/><verse number="26" style="v" sid="MAT 10:26"/><char style="wj">Pou sa, pa pè yo;</char> <note caller="+" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">Mc 4:22</ref></char></note><char style="wj">paske pa gen anyen ki kouvri ki p ap dekouvri, e kache ki p ap revele. </char> <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/><note caller="+" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="LUK 12:3">Luc 12:3</ref></char></note><char style="wj">Sa ke Mwen di nou nan tenèb, pale li nan plen limyè, e sa ke nou tande yo chikote nan zòrèy nou, pwoklame li sou twati kay la. </char> <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/><char style="wj">Epi pa pè sa ki kapab touye kò a men ki pa ka touye nanm nan. Men pito</char> <note caller="+" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="HEB 10:31">Eb 10:31</ref></char></note><char style="wj">pè sila ki kapab detwi ni nanm nan, ni kò a nan lanfè. </char><verse eid="MAT 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 10:29"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:29 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:6">Luc 12:6</ref>
      </char>
    </note>
    <char style="wj">Èske yo pa vann de zwazo pou yon santim? Malgre sa, pa gen youn nan yo k ap tonbe atè san ke Papa nou pa konnen.</char> <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/><char style="wj">Men </char> <note caller="+" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="1SA 14:45">I Sam 14:45</ref></char></note> <char style="wj">menm chak ti grenn cheve nan tèt nou gen tan kontwole. </char> <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/><char style="wj">Konsa, nou pa bezwen pè. Nou </char><note caller="+" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 12:12">Mat 12:12</ref></char></note><char style="wj">gen bokou plis valè pase anpil zwazo.</char> <verse eid="MAT 10:31"/><verse number="32" style="v" sid="MAT 10:32"/><char style="wj">Pou sa, tout moun ki konfese M devan lòm, Mwen menm osi, M ap konfese l devan Papa m ki nan syèl la.</char> <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/><char style="wj">Men</char> <note caller="+" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="MRK 8:38">Mc 8:38</ref></char></note><char style="wj">nenpòt moun ki renye m devan lòm, M ap renye l devan papa M ki nan syèl la. </char><verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:51-55">Luc 12:51-55</ref>
      </char>
    </note>
    <char style="wj">Pa sipoze ke Mwen vini pou pote lapè sou latè. Mwen pa t vini pou pote lapè, men nepe.</char> <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/><char style="wj">Mwen te vini pou</char> <note caller="+" style="x"><char style="xo" closed="false">10:35 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mi 7:6</ref></char></note><char style="wj">mete yon nonm kont papa li, yon fi kont manman li, e yon bèlfi kont bèlmè Li. </char> <verse eid="MAT 10:35"/><verse number="36" style="v" sid="MAT 10:36"/><char style="wj">Epi</char> <note caller="+" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mi 7:6</ref></char></note><char style="wj">lènmi a yon nonm ap manm a pwòp kay li.</char> <verse eid="MAT 10:36"/><verse number="37" style="v" sid="MAT 10:37"/><note caller="+" style="x"><char style="xo" closed="false">10:37 </char><char style="xt" closed="false"><ref loc="DEU 33:9">Det 33:9</ref></char></note><char style="wj">Sila ki renmen papa li oubyen manman li plis ke Mwen, li pa dign de Mwen; e sila ki renmen fis li, oubyen fi li plis ke Mwen, li pa dign de Mwen. </char> <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/><char style="wj">Epi</char> <note caller="+" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">Mat 16:24</ref></char></note><char style="wj">sila ki pa pran kwa li pou swiv Mwen, li pa merite Mwen. </char> <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/><note caller="+" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">Mat 16:25</ref></char></note><char style="wj">Sila k ap konsève lavi li, li va pèdi li; men sila ki pèdi vi li pou Mwen, l ap twouve li.</char><verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>
    <char style="wj">Sila ki resevwa nou menm, resevwa M; e</char> <note caller="+" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="MRK 9:37">Mc 9:37</ref></char></note><char style="wj">si la ki resevwa Mwen, resevwa Sila ki te voye Mwen an. </char> <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/><note caller="+" style="x"><char style="xo" closed="false">10:41 </char><char style="xt" closed="false"><ref loc="MAT 25:44-45">Mat 25:44-45</ref></char></note><char style="wj">Sila ki resevwa yon pwofèt nan non a yon pwofèt ap resevwa rekonpans a yon pwofèt. Epi li ki resevwa yon nonm ladwati nan non a yon nonm ladwati, va resevwa rekonpans la a yon nonm dwat.</char> <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/><char style="wj">Nenpòt moun ki nan non a yon disip, bay youn nan pitit sa yo menm yon tas dlo frèt pou bwe; anverite, Mwen di nou li pa p pèdi rekonpans li. </char><verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:28">Mat 7:28</ref>
      </char>
    </note>Lè Jésus te fin bay enstriksyon a douz disip Li yo, Li te kite kote sa a pou enstwi e preche nan vil pa yo.<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:12">Mat 4:12</ref>
      </char>
    </note>Alò, lè Jean, depi nan prizon an, te tande tout zèv ke Kris la t ap fè yo. Konsa, li te voye yon mesaj pa disip Li yo. <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>Li te mande L: “Èske Ou se <note caller="+" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Sòm 118:26</ref></char></note>Sila ke nou t ap tann nan, oubyen èske nou bezwen tann yon lòt?”<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>Jésus te reponn yo e te di: <char style="wj">“Ale fè rapò a Jean selon tout sa nou tande e wè:</char> <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/><note caller="+" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5">És 35:5</ref></char></note><char style="wj">Avèg yo vin wè, sila ki t ap bwate yo vin mache dwat, lepre yo vin pirifye, soud yo vin tande, mò yo vin resisite, e malere yo tande bòn nouvèl la.</char> <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/><char style="wj">Beni se sila ki</char> <note caller="+" style="x"><char style="xo" closed="false">11:6 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat 5:29</ref></char></note><char style="wj">pa chite akoz Mwen menm nan.”</char><verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>Pandan mesye sa yo, disip a Jean Baptiste yo t ap prale, Jésus te kòmanse pale avèk foul la konsènan Jean: <char style="wj">“Kisa nou te </char><note caller="+" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="MAT 3:1">Mat 3:1</ref></char></note><char style="wj">ale wè nan savann nan? Yon wozo ki souke pa van?</char> <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/><char style="wj">Men kisa nou te ale wè? Yon nonm abiye ak rad ki swa? Sila ki mete rad swa yo rete nan palè a wa yo.</char> <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/><char style="wj">Men kisa nou te sòti pou wè?</char> <note caller="+" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="MAT 14:5">Mat 14:5</ref></char></note><char style="wj">Yon pwofèt? Wi, Mwen di nou e se youn ki plis ke yon pwofèt.</char> <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/><char style="wj">Se selon sila menm ke pwofèt yo te ekri:</char> <note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3:1</ref></char></note><char style="wj">Gade byen! Mwen voye mesaje Mwen an devan fas nou, ki va prepare chemen an devan nou.” </char> <verse eid="MAT 11:10"/><verse number="11" style="v" sid="MAT 11:11"/><char style="wj">Anverite Mwen di nou, pami sila ki fèt pa fanm yo, pa janm leve youn ki pi gran ke Jean Baptiste; malgre sa, sila ki pi piti nan wayòm syèl la, pi gran pase li.</char> <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/><note caller="+" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="LUK 16:16">Luc 16:16</ref></char></note><char style="wj">Depi jou a Jean Baptiste yo jis rive kounye a, wayòm syèl la ap soufri vyolans, e lòm vyolan yo pran li pa lafòs.</char> <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/><char style="wj">Paske tout pwofèt yo ansanm ak Lalwa a te pwofetize jiska Jean.</char> <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/><char style="wj">Konsa, si nou kapab aksepte l, se li menm ki</char> <note caller="+" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mal 4:5</ref></char></note><char style="wj">Elie, sila ki te genyen pou vini an.</char> <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/><note caller="+" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 13:9">Mat 13:9</ref>,<ref loc="MAT 13:43">43</ref></char></note><char style="wj">Sila ki gen zòrèy pou tande, kite l tande.</char><verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>
    <char style="wj">“Men a kisa Mwen kapab konpare jenerasyon sila a? Li tankou timoun ki chita nan mache a, k ap rele lòt timoun</char> <verse eid="MAT 11:16"/><verse number="17" style="v" sid="MAT 11:17"/><char style="wj">pou di: ‘Nou te jwe flit pou nou, e nou pa t danse. Nou te chante yon antèman, e nou pa t kriye’.</char> <verse eid="MAT 11:17"/><verse number="18" style="v" sid="MAT 11:18"/><char style="wj">Paske Jean te vini san manje ni</char> <note caller="+" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="LUK 1:15">Luc 1:15</ref></char></note><char style="wj">bwè, e yo di: </char> <note caller="+" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat 9:34</ref></char></note> <char style="wj">‘Li gen yon move lespri’!</char> <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/><char style="wj">Men Fis a Lòm nan te vini avèk manje e avèk bwè, e yo di: </char> <note caller="+" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="MAT 9:11">Mat 9:11</ref></char></note><char style="wj">‘Gade, li manje twòp, li bwè twòp, e li fè zanmi avèk moun biwo kontribisyon an, ak pechè yo!’ Men sajès la toujou jistifye pa zanfan li yo.”</char><verse eid="MAT 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>Li te kòmanse repwoche vil kote pi fò <note caller="+" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="LUK 10:13-15">Luc 10:13-15</ref></char></note>mirak yo te fèt yo, paske yo pa t repanti. <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/><note caller="+" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="LUK 10:13-15">Luc 10:13-15</ref></char></note><char style="wj">Malè a ou menm, Chorazin! Malè a ou menm, Bethsaïda! Si mirak ki te fèt nan nou yo, te fèt nan Tyr ak Sidon, yo t ap gen tan repanti lontan avèk rad sak ak sann.</char> <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/><char style="wj">Malgre sa Mwen di nou, l ap pi tolerab pou Tir ak Sidon nan</char> <note caller="+" style="x"><char style="xo" closed="false">11:22 </char><char style="xt" closed="false"><ref loc="MAT 10:15">Mat 10:15</ref></char></note><char style="wj">jou jijman an pase pou nou menm.</char> <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/><char style="wj">Epi nou menm,</char> <note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 4:13">Mat 4:13</ref></char></note><char style="wj">Capernaüm; nou p ap monte nan syèl la! Nou konnen sa? Nou ap</char> <note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">És 14:13-15</ref></char></note><char style="wj">desann nan Lanfè. Paske si mirak ki te fèt nan nou yo, te fèt nan Sodome; yo ta toujou la jodi a</char>. <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/><char style="wj">Malgre sa, Mwen di nou ke</char> <note caller="+" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">Mat 10:15</ref></char></note><char style="wj">li va pi tolerab pou peyi Sodome nan jou jijman an pase pou nou menm.</char><verse eid="MAT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:25 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:21">Luc 10:21</ref>
      </char>
    </note> Nan lè sa a, Jésus te reponn. Li te di: <char style="wj">“Mwen bay Ou glwa, O Papa, Senyè syèl la ak tè a, ke Ou kache bagay sa yo pou saj avèk entèlijan yo pa wè, e Ou te montre yo menm a zanfan yo.</char> <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/><char style="wj">Wi</char> <note caller="+" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="LUK 22:42">Luc 22:42</ref></char></note><char style="wj">Papa, konsa sa te fè plezi nan zye Ou. </char> <verse eid="MAT 11:26"/><verse number="27" style="v" sid="MAT 11:27"/><char style="wj">Papa M</char> <note caller="+" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="MAT 28:18">Mat 28:18</ref></char></note><char style="wj">fin lonje ban Mwen tout bagay. Pèsòn pa konnen Fis la, sof Papa a; ni pèsòn pa konnen Papa a, sof ke Fis La, ak nenpòt moun ke Fis La vle revele Li menm.</char><verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:28 </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:25">Jr 31:25</ref>
      </char>
    </note>
    <char style="wj">“Vini a Mwen menm, tout sila yo ki fatige, k ap pote chaj lou, e M ap bannou repo. Aprann de Mwen menm; paske Mwen dous e enb nan kè, e Mwen va bay nou repo. </char> <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/><char style="wj">Pran jouk mwen sou nou, e vin </char> <note caller="+" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JHN 13:15">Jn 13:15</ref></char></note><char style="wj">aprann de Mwen menm, paske Mwen dous e enb nan kè; e </char> <note caller="+" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JER 6:16">Jr 6:16</ref></char></note> <char style="wj">nou va jwenn repo pou nanm nou. </char> <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/><char style="wj">Paske</char> <note caller="+" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="1JN 5:3">I Jn 5:3</ref></char></note><char style="wj">jouk Mwen an dous, e chaj Mwen an lejè.” </char><verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>Nan lè sa a, Jésus te pase nan chan sereyal yo nan jou Saba a e disip Li yo te vin grangou. Yo te kòmanse keyi tèt grenn sereyal pou manje yo. <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>Men lè Farizyen yo te wè sa, yo te di Li: “Gade, disip Ou yo fè sa ki <note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="MAT 12:10">Mat 12:10</ref></char></note>pa pèmi nan yon jou Saba.”<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>Men Li te di yo: <char style="wj">“Èske nou pa li sa ke David te fè lè li te vin grangou; li menm avèk lòt moun ki te avè l yo?</char> <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/><char style="wj">Jan li te antre nan kay Bondye a, e</char> <note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="1SA 2:16">I Sam 2:16</ref></char></note><char style="wj">te manje pen ki te konsakre ki pa t pèmi pou li ta manje, ni pou sa yo ki te avè l yo, men te sèlman pou prèt yo?</char> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/><char style="wj">Oubyen èske nou pa t li nan Lalwa a ke nan jou Saba a, prèt yo nan tanp lan te konn vyole Saba a men rete inosan?</char> <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/><char style="wj">Men Mwen di nou ke yon choz</char> <note caller="+" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="2CH 6:18">II Kwo 6:18</ref></char></note><char style="wj">pi gran pase tanp lan isit la.</char> <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/><char style="wj">Men si nou te konnen kisa sa vle di: </char> <note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="1SA 6:6">I Sam 6:6</ref></char></note><char style="wj">‘Mwen dezire mizerikòd olye sakrifis’, nou pa t ap kondane inosan yo.</char> <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/><char style="wj">Paske </char><note caller="+" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="MAT 8:20">Mat 8:20</ref></char></note><char style="wj">Fis a Lòm nan se Senyè Saba a.”</char><verse eid="MAT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>Konsa, Li te <note caller="+" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="MRK 3:1-6">Mc 3:1-6</ref></char></note>kite la e te ale nan sinagòg yo. <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>Epi vwala, te gen yon mesye avèk yon men ki sèch. Farizyen yo te mande L: <note caller="+" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="MAT 12:2">Mat 12:2</ref></char></note>“Èske li pèmi pou geri nan jou Saba a?” Yo te mande sa a pou yo ta kapab akize Li.<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>Li te reponn yo: <note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">Luc 14:5</ref></char></note><char style="wj">“Ki moun nan sila ki pami nou yo, si li te gen yon mouton ki tonbe nan yon twou nan Saba a, pa t ap lonje pran l e fè l sòti nan twou a?</char> <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/><note caller="+" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="MAT 10:31">Mat 10:31</ref></char></note><char style="wj">Konbyen plis valè a yon moun pase yon mouton? Ebyen, li pèmi pou fè sa ki bon nan Saba a.”</char> <verse eid="MAT 12:12"/><verse number="13" style="v" sid="MAT 12:13"/>Konsa, Li di mesye a: <char style="wj">“Lonje men ou!”</char> <note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="MAT 8:3">Mat 8:3</ref></char></note>Li te lonje li, e li te retounen nòmal tankou lòt la. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>Men Farizyen yo te soti deyò, pou <note caller="+" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="MAT 26:4">Mat 26:4</ref></char></note>fè konplo ansanm kont Li, sou kijan yo ta kapab detwi L.<verse eid="MAT 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>Men Jésus te vin konnen tout sa, e Li te retire kò l.</para>
  <para style="p" vid="MAT 12:15">Anpil moun te swiv Li, e <note caller="+" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>Li te geri yo tout.<verse eid="MAT 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 12:16"/>Epi Li te <note caller="+" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="MAT 8:4">Mat 8:4</ref></char></note>pase lòd pou yo pa fè pèsòn konnen ki moun Li te ye. <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>Sa te fèt pou akonpli sa ki te pale pa pwofèt Ésaïe a lè li te di:<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:18 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 42:1">És 42:1</ref>
      </char>
    </note>“Gade sèvitè Mwen ke Mwen te chwazi a;</para>
  <para style="q1" vid="MAT 12:18">
    <note caller="+" style="x">
      <char style="xo" closed="false">12:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:17">Mat 3:17</ref>
      </char>
    </note>byeneme Mwen ki fè nanm Mwen byen kontan an.</para>
  <para style="q1" vid="MAT 12:18">M ap mete lespri Mwen sou Li,</para>
  <para style="q1" vid="MAT 12:18">e Li va pwoklame jistis a payen yo.<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:19 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 42:2">És 42:2</ref>
      </char>
    </note>Li p ap diskite, ni kriye;</para>
  <para style="q1" vid="MAT 12:19">ni pèsòn p ap tande vwa Li nan lari.<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:20 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 42:3">És 42:3</ref>
      </char>
    </note>Yon wozo brize, Li p ap kase,</para>
  <para style="q1" vid="MAT 12:20">e yon fisèl bouji k ap toufe,</para>
  <para style="q1" vid="MAT 12:20">Li p ap tenyen,</para>
  <para style="q1" vid="MAT 12:20">jouk lè Li mennen jistis la rive nan viktwa a.<verse eid="MAT 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:21 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:2">Wo 15:2</ref>
      </char>
    </note>Nan Non Pa Li, payen yo ap gen espwa.”<verse eid="MAT 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:32">Mat 9:32</ref>,<ref loc="MAT 9:34">34</ref></char>
    </note>Apre sa, yo te pote bay Li yon mesye ki te avèg e bèbè akoz yon move lespri. Li te geri li, e bèbè a te vin pale e li te vin wè. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>Tout foul la te etone, e te kòmanse di: “Èske se posib ke moun sa a kapab <note caller="+" style="x"><char style="xo" closed="false">12:23 </char><char style="xt" closed="false"><ref loc="MAT 9:27">Mat 9:27</ref></char></note>Fis a David?” <verse eid="MAT 12:23"/><verse number="24" style="v" sid="MAT 12:24"/>Men lè Farizyen yo tande sa, yo te di: “Mesye sa ap <note caller="+" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat 9:34</ref></char></note>chase move lespri sa yo pa Béelzébul ki mèt a tout move lespri yo.”<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:25 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:27">Mat 23:27</ref>
      </char>
    </note>Li te konnen panse yo, e Li te di yo: <char style="wj">“Nenpòt wayòm ki divize kont pwòp tèt li va gaye; e nenpòt vil oswa kay ki divize kont pwòp tèt li p ap kanpe.</char> <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/><char style="wj">Si se</char> <note caller="+" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="MAT 4:10">Mat 4:10</ref></char></note><char style="wj">Satan k ap jete Satan, li divize kont pwòp tèt li. Konsa kijan wayòm li va kanpe?</char> <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/><char style="wj">Epi si Mwen menm</char> <note caller="+" style="x"><char style="xo" closed="false">12:27 </char><char style="xt" closed="false"><ref loc="ACT 19:13">Trav 19:13</ref></char></note><char style="wj">pa fòs Béelzébul, chase move lespri yo, pa kilès fis nou yo ap jete yo? Pou rezon sa a, se yo menm k ap jije nou. </char> <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/><char style="wj">Men</char> <note caller="+" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="1JN 3:8">I Jn 3:8</ref></char></note><char style="wj">si Mwen chase move lespri yo pa Lespri Bondye a, wayòm Bondye a gen tan vini sou nou.</char> <verse eid="MAT 12:28"/><verse number="29" style="v" sid="MAT 12:29"/><char style="wj">Oubyen kijan yon moun kapab antre nan kay a nonm fò, pou pran tout byen li, sof ke premyèman li mare nonm fò a? Lè l fini, l ap piyaje kay la. </char><verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:30 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:40">Mc 9:40</ref>
      </char>
    </note>
    <char style="wj">“Sila ki pa pou Mwen an, kont Mwen; e sila ki pa ranmase avè M nan ap gaye. </char> <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/><note caller="+" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luc 12:10</ref></char></note><char style="wj">Pou sa, Mwen di nou, nenpòt peche, menm blasfèm kapab padone; men blasfèm kont Lespri Sen an p ap kapab padone. </char> <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/><note caller="+" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luc 12:10</ref></char></note><char style="wj">Nenpòt moun ki pale yon mo kont Fis a Lòm nan, l ap padone; men nenpòt moun ki pale yon mo kont Lespri Sen an, sa p ap padone, ni nan</char> <note caller="+" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="MAT 13:22">Mat 13:22</ref>,<ref loc="MAT 13:39">39</ref></char></note><char style="wj">laj sila a ni nan laj k ap vini an. </char><verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>
    <char style="wj">“Swa pyebwa a bon, e fwi li bon; oubyen pyebwa a pouri e fwi li pouri.</char> <note caller="+" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="MAT 7:16-18">Mat 7:16-18</ref></char></note><char style="wj">Pyebwa a rekonèt pa fwi ke li bay.</char> <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/><note caller="+" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mat 3:7</ref></char></note><char style="wj">Nou menm nich vipè, jan nou mechan; kijan nou sipoze nou kapab pale sa ki bon? Se bouch la ki pale tout sa ki plen kè a.</char> <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/><note caller="+" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="PRO 10:20">Pwov 10:20</ref>,<ref loc="PRO 10:21">21</ref></char></note><char style="wj">Bon moun nan fè sòti nan bon trezò li, sa ki bon; e move moun nan fè sòti nan move trezò li, sa ki mal.</char> <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/><char style="wj">Epi Mwen di nou ke nan</char> <note caller="+" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="MAT 10:15">Mat 10:15</ref></char></note><char style="wj">jou jijman an, moun ap rann kont pou chak ti mo ke yo pale anven. </char> <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/><char style="wj">Paske pa pawòl nou, nou va jistifye; e pa pawòl nou, nou va kondane.”</char><verse eid="MAT 12:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>Kèk nan Skrib ak Farizyen yo te reponn li konsa: <note caller="+" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">Mat 16:1</ref></char></note>“Mèt, nou vle wè yon sign de Ou menm”.<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>Men li te reponn yo konsa: <note caller="+" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">Mat 16:4</ref></char></note><char style="wj">“Yon jenerasyon mechan ak adiltè vle yon sign; men pa gen yon sign ke n ap bay sof ke sign ki pou pwofèt Jonas la. </char> <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/><char style="wj">Menm jan ke</char> <note caller="+" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="JON 1:17">Jon 1:17</ref></char></note><char style="wj">Jonas te pase twa jou ak twa nwit nan vant gwo pwason an, konsa Fis a Lòm nan ap pase</char> <note caller="+" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref></char></note><char style="wj">twa jou ak twa nwit nan kè latè.</char> <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/><char style="wj">Moun Niniv ap kanpe avèk jenerasyon sila a nan jijman e kondane li, paske</char> <note caller="+" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JON 3:5">Jon 3:5</ref></char></note><char style="wj">yo te repanti lè Jonas te preche yo. Epi veye byen, yon bagay pi gran pase Jonas gen tan rive isit la.</char> <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/><note caller="+" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1">I Wa 10:1</ref></char></note><char style="wj">Rèn nan Sid la ap leve avèk jenerasyon sila a nan jijman e kondane li, paske li te sòti nan dènye ekstremite latè pou tande sajès Salomon; epi veye byen, yon choz pi gran pase Salomon gen tan rive isit la.</char><verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:43 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 11:24-26">Luc 11:24-26</ref>
      </char>
    </note>
    <char style="wj">“Alò, lè yon move lespri kite yon nonm, li pase nan zòn sèk san dlo pou chache repo, men li pa jwenn.</char> <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/><char style="wj">Konsa li di: M ap retounen lakay kote mwen te sòti a. Lè li vini li twouve li vid, bale e ranje nan lòd.</char> <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/><char style="wj">Konsa l ale chache sèt lòt espri pi mal ke li. Yo antre la pou viv avè l, epi</char> <note caller="+" style="x"><char style="xo" closed="false">12:45 </char><char style="xt" closed="false"><ref loc="MRK 5:9">Mc 5:9</ref></char></note><char style="wj">dènye eta a moun sa a pi mal pase premye a. Se konsa l ap ye avèk jenerasyon mechan sila a.”</char><verse eid="MAT 12:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:46 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 3:31-35">Mc 3:31-35</ref>
      </char>
    </note>Pandan Li te toujou ap pale avèk foul la, konsa, manman L avèk frè Li yo te vin parèt pa deyò akoz yo te vle pale avèk Li. <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>Yon moun te di li: “Gade, manman Ou avèk frè Ou yo kanpe deyò a pou pale avèk ou!”<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>Men Li te reponn sila ki te pale avèk Li pou di l: <char style="wj">“Kilès ki manman M? E kilès ki frè M?”</char> <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>Konsa, byen lonje men L vè disip Li yo, Li te di: <char style="wj">“Gade manman M ak frè Mwen yo.</char> <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/><char style="wj">Paske sila ki fè volonte a Papa M ki nan syèl la, se li menm ki frè M, sè M, ak manman M.” </char><verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>Nan jou sa a, Jésus te sòti nan kay la e te chita <note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="MRK 2:13">Mc 2:13</ref></char></note>bò kote lanmè a. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Yon gran foul te rasanble bò kote L, epi <note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:3">Luc 5:3</ref></char></note>Li te antre chita nan yon kannòt. Foul la te kanpe arebò lanmè a. <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>Li te pale anpil bagay avèk yo an <note caller="+" style="x"><char style="xo" closed="false">13:3 </char><char style="xt" closed="false"><ref loc="MAT 13:10">Mat 13:10</ref></char></note>parabòl konsa: <char style="wj">“Gade byen, yon moun ki t ap plante, te ale deyò pou simen grenn.</char> <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/><char style="wj">Pandan li t ap simen, kèk grenn te tonbe akote wout la, e zwazo te vin manje yo.</char> <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/><char style="wj">Gen lòt ki te tonbe kote ki plen wòch kote te manke tè, epi yo te leve byen vit pwiske tè a te manke pwofondè.</char> <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/><char style="wj">Men lè solèy la vin leve, yo te vin sèch; akoz ke yo te manke rasin, yo te vin fennen.</char> <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/><char style="wj">Lòt te tonbe pami pikan e pikan yo te leve toufe yo.</char> <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/><char style="wj">Lòt te tonbe nan bon tè kote yo te bay yon bon rekòlt; kèk miltipliye</char> <note caller="+" style="x"><char style="xo" closed="false">13:8 </char><char style="xt" closed="false"><ref loc="GEN 26:12">Jen 26:12</ref></char></note><char style="wj">san fwa, kèk swasant fwa, e kèk trant fwa.</char> <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/><note caller="+" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="MAT 11:15">Mat 11:15</ref></char></note><char style="wj">Sila ki gen zòrèy la, kite li tande.”</char><verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>Disip Li yo te vin kote L e te mande: “Poukisa ou pale avèk yo an parabòl konsa?”<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>Li te reponn yo: <note caller="+" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="MAT 19:11">Mat 19:11</ref></char></note><char style="wj">“A nou menm, li pèmèt pou nou konnen sekrè a wayòm syèl la, men pou yo menm, sa poko pèmèt.</char> <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/><note caller="+" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">Mat 25:29</ref></char></note><char style="wj">Paske pou nenpòt moun ki genyen, l ap vin resevwa plis, e l ap gen an abondans; men pou nenpòt moun ki pa genyen, menm sa li genyen an ap retire nan men l.</char> <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/><char style="wj">Se pou sa Mwen pale ak yo an parabòl; paske pandan y ap</char> <note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="DEU 29:4">Det 29:4</ref></char></note><char style="wj">gade yo p ap wè, e pandan y ap tande yo p ap koute, ni yo p ap konprann.</char> <verse eid="MAT 13:13"/><verse number="14" style="v" sid="MAT 13:14"/><char style="wj">Se nan yo menm, ke pwofesi Ésaïe a ap akonpli lè l di: </char></para>
  <para style="q1" vid="MAT 13:14">
    <note caller="+" style="x">
      <char style="xo" closed="false">13:14 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 16:9">És 16:9</ref>
      </char>
    </note>
    <char style="wj">‘Nou va kontinye tande, men nou p ap konprann; </char></para>
  <para style="q1" vid="MAT 13:14">
    <char style="wj">nou va kontinye gade, men nap manke apèsi. </char><verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:15 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 6:10">És 6:10</ref>
      </char>
    </note>
    <char style="wj">Paske kè a pèp sa a pa sansib ankò. </char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">Avèk zòrèy yo manke tande e yo fèmen zye yo; </char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">otreman yo ta wè avèk zye yo, tande avèk zòrèy yo, </char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">konprann avèk kè yo, e retounen pou M ta kapab geri yo.’</char><verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:17">Mat 16:17</ref>
      </char>
    </note>
    <char style="wj">“Men beni se zye pa nou paske yo wè; e zòrèy nou paske yo tande.</char> <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/><char style="wj">Anverite, Mwen di nou ke</char> <note caller="+" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="JHN 8:56">Jn 8:56</ref></char></note><char style="wj">anpil pwofèt ak moun ladwati te vle wè sa ke nou menm wè a, men yo pa t janm wè; e pou tande sa ke nou tande a, men yo pa t tande l.</char><verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>
    <char style="wj">“Pou sa,</char> <note caller="+" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="MRK 4:13-20">Mc 4:13-20</ref></char></note><char style="wj">tande parabòl moun ki t ap simen an.</char> <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/><char style="wj">Lè nenpòt moun tande</char> <note caller="+" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note><char style="wj">pawòl wayòm nan e li pa konprann li, mechan an (Satan) vini rache sa ki te plante nan kè li a. Sa se grenn ki te simen akote wout la.</char> <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/><char style="wj">Sa ki te simen nan wòch yo se moun ki tande pawòl la e imedyatman li resevwa l avèk jwa;</char> <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/><char style="wj">men li pa gen rasin pou kont li, e li dire sèlman pou yon moman. Lè gen afliksyon avèk pèsekisyon akoz pawòl la, byen vit </char> <note caller="+" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="MAT 11:6">Mat 11:6</ref></char></note> <char style="wj">li chite.</char> <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/><char style="wj">Epi sila ki te simen pami pikan yo se moun ki tande pawòl la, men tout pwoblèm mond sa a, avèk</char> <note caller="+" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="MAT 19:23">Mat 19:23</ref></char></note><char style="wj">sediksyon richès yo toufe pawòl la, e li pa donnen fwi.</char> <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/><char style="wj">Konsa, sila ki te gen grenn ki tonbe nan bon tè a, se moun ki tande pawòl la e ki konprann li. Li vrèman pote fwi ki pwodwi pafwa,</char> <note caller="+" style="x"><char style="xo" closed="false">13:23 </char><char style="xt" closed="false"><ref loc="MAT 13:8">Mat 13:8</ref></char></note><char style="wj">san fwa, pafwa swasant fwa, e pafwa trant fwa sa li te simen an.”</char><verse eid="MAT 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>Jésus te bay yo yon lòt parabòl. Li te di: <note caller="+" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="MAT 13:31">Mat 13:31</ref>,<ref loc="MAT 13:33">33</ref>,<ref loc="MAT 13:45">45</ref>,<ref loc="MAT 13:47">47</ref></char></note><char style="wj">“Wayòm syèl la se kon yon nonm ki simen bon semans nan chan li.</char> <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/><char style="wj">Men pandan ouvriye li yo t ap dòmi, lènmi li yo te vin simen zèb pikan pami ble a, e ale.</char> <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/><char style="wj">Men lè ble a te vin leve e fòme tèt grenn, zèb pikan yo te parèt tou.</char> <verse eid="MAT 13:26"/><verse number="27" style="v" sid="MAT 13:27"/><char style="wj">Epi esklav a mèt tè yo te vin di l: ‘Mèt, èske nou pa t simen bon semans nan chan ou an? Kijan konsa li vin plen avèk zèb pikan sa yo.’</char><verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>
    <char style="wj">“Epi Li te di yo: ‘Yon lènmi te fè sa!’ E esklav yo te di li: ‘Ou pa vle nou ale ranmase yo?’ </char><verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>
    <char style="wj">“Men li te di yo: ‘Non, paske pandan nou ap ranmase zèb pikan yo, nou kab derasinen ble a tou.</char> <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/><char style="wj">Kite toulède grandi ansanm jouk rekòlt la rive. Nan tan rekòlt la, mwen va di ouvriye yo, premyèman, ranmase zèb pikan yo, mare yo nan pake e brile yo. Men</char> <note caller="+" style="x"><char style="xo" closed="false">13:30 </char><char style="xt" closed="false"><ref loc="MAT 3:12">Mat 3:12</ref></char></note><char style="wj">ranmase ble a pou mete li nan depo mwen.’”</char><verse eid="MAT 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>Li te pale yon lòt parabòl a yo menm. Li te di: <note caller="+" style="x"><char style="xo" closed="false">13:31 </char><char style="xt" closed="false"><ref loc="MAT 13:24">Mat 13:24</ref></char></note><char style="wj">“Wayòm syèl la tankou yon grenn moutad ke yon nonm te pran pou simen nan jaden li.</char> <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/><char style="wj">Malgre grenn sa a pi piti pase tout lòt grenn yo, lè li vin grandi, li pi gran pase tout lòt plant nan jaden an, e te vin fè yon pyebwa kote tout zwazo ki vole anlè vin</char> <note caller="+" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="EZK 17:23">Éz 17:23</ref></char></note><char style="wj">fè nich nan branch li yo.”</char><verse eid="MAT 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>Li pale yon lòt parabòl a yo menm konsa: <note caller="+" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="MAT 13:24">Mat 13:24</ref></char></note><char style="wj">“Wayòm syèl la tankou ledven ke yon fanm te pran pou sere nan twa mezi farin jiskaske tout vin leve.”</char><verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>Tout bagay sa yo, Jésus te pale a foul la an parabòl, epi Li pa t pale avèk yo <note caller="+" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="MRK 4:34">Mc 4:34</ref></char></note>san parabòl. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Se te pou akonpli sa ki te pale pa pwofèt yo lè yo te di: <note caller="+" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">Sòm 78:2</ref></char></note></para>
  <para style="q1" vid="MAT 13:35">“Mwen va ouvri bouch Mwen an parabòl;</para>
  <para style="q1" vid="MAT 13:35">Mwen va eksprime sekrè ki kache depi fondasyon mond sa a.”<verse eid="MAT 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>Apre sa, Li kite foul la e Li te ale nan <note caller="+" style="x"><char style="xo" closed="false">13:36 </char><char style="xt" closed="false"><ref loc="MAT 13:1">Mat 13:1</ref></char></note>kay la. Disip Li yo te vin kote l pou di: <note caller="+" style="x"><char style="xo" closed="false">13:36 </char><char style="xt" closed="false"><ref loc="MAT 15:15">Mat 15:15</ref></char></note>“Eksplike nou parabòl konsènan zèb pikan nan chan an.”<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>Li te di: <char style="wj">“Sila a ki simen bon semans lan se </char><note caller="+" style="x"><char style="xo" closed="false">13:37 </char><char style="xt" closed="false"><ref loc="MAT 8:20">Mat 8:20</ref></char></note><char style="wj">Fis a Lòm nan.</char> <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/><char style="wj">Chan an se lemonn, e bon semans lan, se sila yo ki</char> <note caller="+" style="x"><char style="xo" closed="false">13:38 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat 8:12</ref></char></note><char style="wj">fis a wayòm nan. Zèb pikan yo se sila yo ki</char> <note caller="+" style="x"><char style="xo" closed="false">13:38 </char><char style="xt" closed="false"><ref loc="JHN 8:44">Jn 8:44</ref></char></note><char style="wj">fis a mechan an.</char> <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/><char style="wj">Epi lènmi ki te simen move grenn nan se Satan. Rekòlt la se </char> <note caller="+" style="x"><char style="xo" closed="false">13:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">Mat 16:4</ref></char></note> <char style="wj">fen tan yo, epi ouvriye yo se zanj yo.</char> <verse eid="MAT 13:39"/><verse number="40" style="v" sid="MAT 13:40"/><char style="wj">Pou sa, menm jan ke zèb pikan yo ranmase e brile avèk dife, konsa sa ap ye nan</char> <note caller="+" style="x"><char style="xo" closed="false">13:40 </char><char style="xt" closed="false"><ref loc="MAT 12:32">Mat 12:32</ref></char></note><char style="wj">fen tan yo.</char> <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/><note caller="+" style="x"><char style="xo" closed="false">13:41 </char><char style="xt" closed="false"><ref loc="MAT 8:20">Mat 8:20</ref></char></note><char style="wj">Fis a Lòm nan ap voye zanj li yo pou ranmase fè sòti nan wayòm Li an, tout obstak ki fè moun tonbe, avèk tout sila k ap fè mechanste.</char> <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/><note caller="+" style="x"><char style="xo" closed="false">13:42 </char><char style="xt" closed="false"><ref loc="MAT 13:50">Mat 13:50</ref></char></note><char style="wj">L ap jete yo nan founo dife a e nan plas sa a,</char> <note caller="+" style="x"><char style="xo" closed="false">13:42 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat 8:12</ref></char></note><char style="wj">y ap kriye e y ap manje dan yo.</char> <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/><note caller="+" style="x"><char style="xo" closed="false">13:43 </char><char style="xt" closed="false"><ref loc="DAN 12:3">Dan 12:3</ref></char></note><char style="wj">Konsa, sila ki gen ladwati yo ap fè klè tankou solèy la nan wayòm Papa yo a. Sila ki gen zòrèy la, kite l tande.</char><verse eid="MAT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>
    <char style="wj">“Wayòm syèl la tankou yon trezò ki te sere nan yon chan. Yon nonm te twouve li e te sere l ankò. Ranpli ak lajwa, li te kouri ale</char> <note caller="+" style="x"><char style="xo" closed="false">13:44 </char><char style="xt" closed="false"><ref loc="MAT 13:46">Mat 13:46</ref></char></note><char style="wj">vann tout sa li te posede, e te achte chan sa a.</char><verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>
    <char style="wj">“Ankò,</char> <note caller="+" style="x"><char style="xo" closed="false">13:45 </char><char style="xt" closed="false"><ref loc="MAT 13:24">Mat 13:24</ref></char></note><char style="wj">wayòm syèl la tankou yon machann k ap chèche bèl pèl.</char> <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/><char style="wj">Lè li twouve youn ki gen gran valè, li te ale vann tout sa li te posede pou te achte l.</char><verse eid="MAT 13:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>
    <char style="wj">“Ankò, </char> <note caller="+" style="x"><char style="xo" closed="false">13:47 </char><char style="xt" closed="false"><ref loc="MAT 13:44">Mat 13:44</ref></char></note> <char style="wj">wayòm syèl la se yon filè ki voye nan lanmè pou ranmase tout kalite pwason.</char> <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/><char style="wj">Lè l fin ranpli, yo rale li atè. Yo te chita pou mete bon pwason nan yon veso, e te jete move yo.</char> <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/><char style="wj">Konsa sa ap ye nan </char><note caller="+" style="x"><char style="xo" closed="false">13:49 </char><char style="xt" closed="false"><ref loc="MAT 13:39">Mat 13:39</ref>,<ref loc="MAT 13:40">40</ref></char></note><char style="wj">fen tan yo. Zanj yo ap tou parèt e y ap fè triyaj mechan yo pami jis yo.</char> <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/><char style="wj">Epi</char> <note caller="+" style="x"><char style="xo" closed="false">13:50 </char><char style="xt" closed="false"><ref loc="MAT 13:42">Mat 13:42</ref></char></note><char style="wj">y ap jete mechan yo nan founo dife a, kote y ap kriye e manje dan yo.</char><verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>
    <char style="wj">“Èske nou konprann tout bagay sa yo?”</char></para>
  <para style="p" vid="MAT 13:51">Yo reponn Li: “Wi”.<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>Epi Jésus te di yo: <char style="wj">“Konsa, chak skrib ki vini yon disip a wayòm nan se tankou yon mèt kay ki fè vin parèt nan trezò li sa ki nèf ak sa ki vye.”</char><verse eid="MAT 13:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:53 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:28">Mat 7:28</ref>
      </char>
    </note>Lè Jésus te fini avèk parabòl sa yo, li kite la. <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/><note caller="+" style="x"><char style="xo" closed="false">13:54 </char><char style="xt" closed="false"><ref loc="MRK 6:1-6">Mc 6:1-6</ref></char></note>Li rive nan vil pa Li a, e Li te <note caller="+" style="x"><char style="xo" closed="false">13:54 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>kòmanse preche nan sinagòg yo, jiskaske yo te etone e te di: “Kote nonm sa a twouve sajès sila a ak pouvwa fè mirak sa yo? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>Se pa pitit a chapant la? Èske yo pa rele <note caller="+" style="x"><char style="xo" closed="false">13:55 </char><char style="xt" closed="false"><ref loc="MAT 12:46">Mat 12:46</ref></char></note>manman L Marie, e frè li yo Jacques, Joseph, Simon ak Judas? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>Epi <note caller="+" style="x"><char style="xo" closed="false">13:56 </char><char style="xt" closed="false"><ref loc="MRK 6:3">Mc 6:3</ref></char></note>sè Li yo; èske yo tout pa avèk nou? Ebyen, kote nonm sa a twouve tout bagay sa yo?” <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>Konsa, yo te <note caller="+" style="x"><char style="xo" closed="false">13:57 </char><char style="xt" closed="false"><ref loc="MAT 11:6">Mat 11:6</ref></char></note>pran ofans de Li.</para>
  <para style="p" vid="MAT 13:57">Men Jésus te di yo: <note caller="+" style="x"><char style="xo" closed="false">13:57 </char><char style="xt" closed="false"><ref loc="MRK 6:4">Mc 6:4</ref></char></note><char style="wj">“Yon pwofèt p ap janm manke respè sof ke nan pwòp vil li, ak nan pwòp kay li.” </char> <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>Li pa t fè anpil mirak la akoz ke yo pa t kwè.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 6:14-29">Mc 6:14-29</ref>
      </char>
    </note>Nan lè sa a, Hérode, tetrak la, te tande nouvèl a Jésus. <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>Konsa, Li te di a sèvitè pa li yo: <note caller="+" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="MAT 16:14">Mat 16:14</ref></char></note>“Se Jean Baptiste sa a ye. Li gen tan leve soti vivan nan lanmò. Se pou sa li kapab fè tout mirak sa yo.” <verse eid="MAT 14:2"/><verse number="3" style="v" sid="MAT 14:3"/>Paske lè <note caller="+" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="MRK 8:15">Mc 8:15</ref></char></note>Hérode te fè yo arete Jean, li te mare li e mete li nan prizon akoz Hérodias, madanm a frè li, Philippe. <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>Paske Jean t ap di li ke <note caller="+" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">Lev 18:16</ref></char></note>li pa pèmèt pou l ta genyen l kon madanm. <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>Epi malgre ke Hérode te vle touye li, li te pè pèp la paske yo te konsidere li kon <note caller="+" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="MAT 11:9">Mat 11:9</ref></char></note>yon pwofèt. <verse eid="MAT 14:5"/><verse number="6" style="v" sid="MAT 14:6"/>Men lè fèt nesans Hérode te rive, Pitit a Hérodias te vin danse devan yo, e <note caller="+" style="x"><char style="xo" closed="false">14:6 </char><char style="xt" closed="false"><ref loc="MRK 8:15">Mc 8:15</ref></char></note>Hérode te trè kontan. <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>Konsa, li menm te sèmante pou bay li nenpòt sa ke li te mande li. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>Akoz ke fi a te ankouraje pa manman l, li te di: “Ban m isit la menm sou yon plato, tèt a Jean Baptiste.”<verse eid="MAT 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9"/>Malgre sa te fè l tris, wa a te kòmande sa fèt akoz sèman an, e akoz tout vizitè ki te la avèk yo. <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>Li te voye fè yo koupe tèt a Jean nan prizon an. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>Yo te pote tèt li sou yon plato e te bay fi a. Konsa, fi a te pote l bay manman l. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>Disip li yo te vin pran kò a e te antere l. Apre, yo te ale bay rapò a Jésus. <verse eid="MAT 14:12"/><verse number="13" style="v" sid="MAT 14:13"/><note caller="+" style="x"><char style="xo" closed="false">14:13 </char><char style="xt" closed="false"><ref loc="MAT 15:32-38">Mat 15:32-38</ref></char></note>Lè Jésus tande sa, Li te retire kò L nan yon kannòt pou kont Li nan yon landwa izole. Lè foul la te tande sa, yo te sòti lavil la apye pou swiv Li.<verse eid="MAT 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 14:14"/>Lè L te debake atè, Li te wè yon gran foul. Li te gen konpasyon pou yo, e Li te <note caller="+" style="x"><char style="xo" closed="false">14:14 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>geri malad yo.<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>Lè li te vin fènwa, disip yo te vin di Li: “Plas sa a dezète, e lè a gen tan depase. Konsa, voye foul la ale pou yo kapab rive nan bouk yo pou achte kèk manje.”<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>Men Jésus te di yo: <char style="wj">“Yo pa bezwen ale. Nou menm, bay yo manje!”</char><verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>Yo te di Li: “Nou gen sèlman <note caller="+" style="x"><char style="xo" closed="false">14:17 </char><char style="xt" closed="false"><ref loc="MAT 16:9">Mat 16:9</ref></char></note>senk pen ak de grenn pwason.”<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>Li te di: <char style="wj">“Pote yo ban Mwen!”</char> <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>Li te kòmande tout foul la chita atè. Li te pran senk pen avèk de pwason yo. Li te gade anwo nan syèl la, e te <note caller="+" style="x"><char style="xo" closed="false">14:19 </char><char style="xt" closed="false"><ref loc="1SA 9:13">I Sam 9:13</ref></char></note>beni manje a. Li te kase pen yo, Li te bay disip yo, epi disip yo te bay foul la. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Tout te manje e tout te byen satisfè. Yo te ranmase sa ki te rete nan mòso kase yo, e yo te rete douz <note caller="+" style="x"><char style="xo" closed="false">14:20 </char><char style="xt" closed="false"><ref loc="MAT 16:9">Mat 16:9</ref></char></note>panyen byen plen. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Te gen anviwon senk-mil gason ki te manje san konte fanm avèk timoun.<verse eid="MAT 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:22 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 6:45-51">Mc 6:45-51</ref>
      </char>
    </note>Imedyatman, Li te fè disip yo antre nan kannòt la pou ale lòtbò a, pandan Li menm te voye foul la ale. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Apre li te voye foul la ale, <note caller="+" style="x"><char style="xo" closed="false">14:23 </char><char style="xt" closed="false"><ref loc="MRK 6:46">Mc 6:46</ref></char></note>Li te monte mòn nan Li sèl Li, pou L ta kapab priye. Lè lannwit vin rive, Li te la pou kont Li. <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>Men kannòt la te deja byen lwen tè a, byen bat pa vag lanmè yo, paske van an te byen <note caller="+" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="ACT 27:4">Trav 27:4</ref></char></note>move. <verse eid="MAT 14:24"/><verse number="25" style="v" sid="MAT 14:25"/>Nan katriyèm vèy nwit lan, Li te vin kote yo ap mache sou lanmè a. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Lè disip Li yo te wè L ap mache sou lanmè a, yo te krent, e yo te di: “Sa se yon <note caller="+" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="LUK 24:37">Luc 24:37</ref></char></note>fantom” epi yo te kriye fò avèk laperèz. <verse eid="MAT 14:26"/><verse number="27" style="v" sid="MAT 14:27"/>Men imedyatman, Jésus te pale avèk yo e te di: <note caller="+" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="MAT 9:2">Mat 9:2</ref></char></note><char style="wj">“Pran kouraj! Se Mwen menm! Pa pè.”</char><verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>Konsa, Pierre te reponn Li: “Senyè, si se Ou menm, kòmande m vin kote Ou sou dlo a.”<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>Li te reponn: <char style="wj">“Vini!”</char> Pierre te sòti nan kannòt la, e te mache sou dlo a vè Jésus. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>Men lè l te wè van an, li te vin pè, e te kòmanse desann nan dlo a. Li te rele: “Senyè, sove m!”<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>Lapoula, Jésus te lonje men li e te kenbe l. Li te di l konsa: <char style="wj">“Ou menm avèk mank lafwa, poukisa ou te doute?”</char> <verse eid="MAT 14:31"/><verse number="32" style="v" sid="MAT 14:32"/>Lè yo te fin antre nan kannòt la, van an te vin sispann. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Sila ki te nan kannòt yo te adore Li. Yo te di: “Anverite, Ou se <note caller="+" style="x"><char style="xo" closed="false">14:33 </char><char style="xt" closed="false"><ref loc="MAT 4:3">Mat 4:3</ref></char></note>Fis Bondye a!”<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:34 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:24">Jn 6:24</ref>,<ref loc="JHN 6:25">25</ref></char>
    </note>Lè yo te fin travèse, yo te rive atè nan Génésareth. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>Lè moun nan plas sa yo te rekonèt Li, yo te voye nouvèl nan tout ozanviwon an, e yo te pote bay Li tout sila ki te malad yo. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>Yo t ap sipliye L pou yo ta kapab sèlman touche rebò a vètman Li, e tout sila ki te <note caller="+" style="x"><char style="xo" closed="false">14:36 </char><char style="xt" closed="false"><ref loc="MAT 9:21">Mat 9:21</ref></char></note>touche L yo te geri nèt.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:1 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 7:1-23">Mc 7:1-23</ref>
      </char>
    </note>Apre sa, kèk Farizyen ak Skrib ki te sòti Jérusalem te vin kote Jésus pou mande L: <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“Poukisa disip ou yo vyole tradisyon a lansyen nou yo? Paske yo <note caller="+" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="LUK 11:38">Luc 11:38</ref></char></note>pa lave men yo lè yo manje pen.”<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>Li te reponn yo: <char style="wj">“E poukisa nou menm vyole kòmandman Bondye a pou koz a tradisyon nou yo?</char> <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/><char style="wj">Paske Bondye te di: ‘Onore papa ou avèk manman ou,’ epi: ‘Sila ki pale mal a manman li oswa a papa li, va mete a lanmò.’”</char><verse eid="MAT 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 15:5"/>
    <char style="wj">Men nou di: “Nenpòt moun ki di a manman l oswa papa l, tout sa mwen genyen ki ta kapab ede ou se pou Bondye,</char> <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/><char style="wj">li pa oblije onore ni papa l ni manman l”. Konsa, nou te anile pawòl Bondye a pou koz tradisyon pa nou an.</char> <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/><char style="wj">Nou menm ipokrit; anverite, Ésaïe te bay pwofesi sou nou lè l te di: </char><verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:8 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 29:13">És 29:13</ref>
      </char>
    </note>
    <char style="wj">Pèp sa a onore M avèk lèv yo,</char></para>
  <para style="q1" vid="MAT 15:8">
    <char style="wj">men kè yo byen lwen Mwen.</char><verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>
    <char style="wj">An ven yo adore M;</char></para>
  <para style="q1" vid="MAT 15:9">
    <char style="wj">lè yo enstwi kòm</char> <note caller="+" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="COL 2:22">Kol 2:22</ref></char></note><char style="wj">doktrin, prensip a lòm.</char><verse eid="MAT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>Apre sa, Li te rele foul akote Li a, e Li te di yo: <char style="wj">“Tande e konprann; </char> <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/><note caller="+" style="x"><char style="xo" closed="false">15:11 </char><char style="xt" closed="false"><ref loc="MAT 15:18">Mat 15:18</ref></char></note><char style="wj">Se pa sa ki antre nan bouch la ki kontamine yon nonm, men se sa ki sòti nan bouch la ki kontamine l.”</char><verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>Alò, disip Li yo te vin kote L. Yo te di L: “Èske Ou konnen ke Farizyen yo te blese lè yo te tande pawòl sa a?”<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>Men Li te reponn yo e di: <note caller="+" style="x"><char style="xo" closed="false">15:13 </char><char style="xt" closed="false"><ref loc="ISA 60:21">És 60:21</ref></char></note><char style="wj">“Chak plant ke Papa M pa plante, ap vin rache.</char> <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/><char style="wj">Pa okipe yo. Yo se</char> <note caller="+" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="MAT 23:16">Mat 23:16</ref>,<ref loc="MAT 23:24">24</ref></char></note><char style="wj">avèg k ap gide avèg. </char> <note caller="+" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">Luc 6:39</ref></char></note> <char style="wj">Si yon avèg ap gide yon avèg, se toude k ap tonbe nan yon twou.”</char><verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>Pierre te reponn, e te di L: <note caller="+" style="x"><char style="xo" closed="false">15:15 </char><char style="xt" closed="false"><ref loc="MAT 13:36">Mat 13:36</ref></char></note>“Eksplike nou parabòl sa a.”<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>Li te di: <char style="wj">“Èske nou menm, nou toujou manke konprann nan?</char> <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/><char style="wj">Èske nou pa konprann ke tout bagay ki antre nan bouch, e ki pase nan vant, ap vin elimine?</char> <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/><char style="wj">Men</char> <note caller="+" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat 12:34</ref></char></note><char style="wj">bagay ki sòti nan bouch yo, se nan kè yo sòti, e se sa yo ki kontamine yon moun.</char><verse eid="MAT 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 15:19"/>
    <char style="wj">“Paske se nan kè move panse yo sòti; touye moun, adiltè, imoralite seksyèl, vòlè, fo temwen, tripotay.</char> <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/><char style="wj">Se bagay sa yo ki kontamine yon moun, men manje san lave men pa kapab kontamine yon moun.”</char><verse eid="MAT 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>Konsa, Jésus te kite la, e retire kò l pou landwa <note caller="+" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="MAT 11:21">Mat 11:21</ref></char></note>Tyr ak Sidon. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>Epi gade, yon fanm Canaan nan rejyon sa a te vin parèt. Li te kòmanse kriye fò e te di: “Fè m gras, Senyè, Fis a David la! Fi mwen an gen yon <note caller="+" style="x"><char style="xo" closed="false">15:22 </char><char style="xt" closed="false"><ref loc="MAT 4:24">Mat 4:24</ref></char></note>move lespri.”<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>Men Li pa t reponn li yon mo.</para>
  <para style="p" vid="MAT 15:23">Disip Li yo te vin kote L. Yo te di L: “Fè l ale; l ap rele dèyè nou tout kote nou ale”.<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>Men Li te reponn e te di: “<char style="wj">Mwen te voye sèlman pou</char> <note caller="+" style="x"><char style="xo" closed="false">15:24 </char><char style="xt" closed="false"><ref loc="MAT 10:6">Mat 10:6</ref></char></note><char style="wj">mouton pèdi nan lakay Israël la.”</char><verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>Men fanm nan te <note caller="+" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="MAT 8:2">Mat 8:2</ref></char></note>vin bese devan Li, e te di: “Senyè, ede m!”<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>Men Li te reponn: <char style="wj">“Li pa bon pou pran manje ki pou timoun yo pou jete l bay chen.”</char><verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>Men li te di: “Wi Senyè, men menm chen yo manje ti kras manje k ap tonbe sòti sou tab mèt la.”<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>Jésus te reponn li: <char style="wj">“Men fanm, </char><note caller="+" style="x"><char style="xo" closed="false">15:28 </char><char style="xt" closed="false"><ref loc="MAT 9:22">Mat 9:22</ref></char></note><char style="wj">lafwa ou gran! Ke sa fèt jan ou vle a”. Epi fi li a te geri lapoula. </char><verse eid="MAT 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 15:29-31">Mat 15:29-31</ref>
      </char>
    </note>Lè Li kite la, Jésus te ale bò kote Lanmè Galilée a. Li te monte yon mòn e Li te chita la.<verse eid="MAT 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 15:30"/>Gran foul la te vin kote Li. Yo t ap mennen avèk yo sila ki te bwete, kokobe, avèg, bèbè ak anpil lòt. Yo te depoze yo bò kote pye Li e <note caller="+" style="x"><char style="xo" closed="false">15:30 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>Li te geri yo. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>Konsa, foul la te vin etone lè yo te wè bèbè pale, kokobe restore, bwete mache, avèk avèg yo ki te wè e yo te <note caller="+" style="x"><char style="xo" closed="false">15:31 </char><char style="xt" closed="false"><ref loc="MAT 9:8">Mat 9:8</ref></char></note>bay glwa a Bondye Israël la.<verse eid="MAT 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:32 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:13-21">Mat 14:13-21</ref>
      </char>
    </note>Jésus te rele disip Li yo pou vin kote L. Li te di: <char style="wj">“Mwen santi konpasyon pou foul la, paske yo la avè M koulye a pandan twa jou, e yo pa gen anyen pou yo manje. Mwen pa vle voye yo ale grangou, paske yo kab fennen sou wout la.”</char><verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>Disip Li yo te mande L: <char style="wj">“Kibò nou ta twouve kantite pen sa a nan yon andwa izole konsa pou bay yon gran foul konsa?”</char><verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>Jésus te mande yo: <char style="wj">“Konbyen pen nou genyen”?</char></para>
  <para style="p" vid="MAT 15:34">Yo te di: “Sèt, avèk kèk ti pwason.”<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>Li te kòmande foul la chita atè. <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>Li te pran sèt ti pen yo avèk pwason an. Lè Li te fin <note caller="+" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="MAT 14:9">Mat 14:9</ref></char></note>remèsye Bondye pou yo, Li te kase yo, e te bay disip Li yo, ki te bay tout foul la. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>Konsa, tout moun te manje e te satisfè. Lè yo te ranmase mòso kase ki te rete yo, te rete sèt gran <note caller="+" style="x"><char style="xo" closed="false">15:37 </char><char style="xt" closed="false"><ref loc="MAT 16:10">Mat 16:10</ref></char></note>panyen byen plen. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Sila ki te manje yo te kat mil gason plis fanm avèk timoun.<verse eid="MAT 15:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39"/>Apre Li voye foul la ale, Li te monte nan yon kannòt e te ale nan rejyon <note caller="+" style="x"><char style="xo" closed="false">15:39 </char><char style="xt" closed="false"><ref loc="MRK 8:10">Mc 8:10</ref></char></note>Magadan nan.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:1 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 8:11-21">Mc 8:11-21</ref>
      </char>
    </note>Farizyen ak Sadiseyen yo te vin kote Jésus pou sonde L. Yo te mande Li pou bay yo yon sign ki sòti nan syèl la.<verse eid="MAT 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2"/>Men Li te reponn yo: <note caller="+" style="x"><char style="xo" closed="false">16:2 </char><char style="xt" closed="false"><ref loc="LUK 12:54">Luc 12:54</ref></char></note><char style="wj">“Lè se nan aswè, nou di ‘l ap fè bon tan, paske syèl la wouj’.</char> <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/><char style="wj">Epi nan maten, ‘pral gen yon tanpèt jodi a, paske syèl la wouj e menasan.’</char> <note caller="+" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="LUK 12:56">Luc 12:56</ref></char></note><char style="wj">Ipokrit! Nou konn kalkile aparans syèl la, men nou pa konn disène sign nan tan sila yo? </char> <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/><note caller="+" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat 12:39</ref></char></note><char style="wj">Yon jenerasyon mechan e adiltè ap chache yon sign, men yo p ap resevwa l, eksepte sign ki pou Jonas la.”</char> Konsa, Li te sòti kite yo.<verse eid="MAT 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>Lè disip yo te ale lòtbò lanmè a, yo te bliye pote pen.<verse eid="MAT 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 16:6"/>Jésus te di yo: <char style="wj">“Veye e fè atansyon pou ledven Farizyen ak Sadiseyen yo.”</char><verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>Yo te kòmanse diskite pami yo menm. Yo te di: “Se paske nou pa pote pen an.”<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>Men Jésus, okouran de sa, te di yo: <note caller="+" style="x"><char style="xo" closed="false">16:8 </char><char style="xt" closed="false"><ref loc="MAT 6:30">Mat 6:30</ref></char></note><char style="wj">“O moun ak ti lafwa piti yo, poukisa nou diskite pami nou ke nou pa gen pen?</char> <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/><char style="wj">Èske nou poko konprann ni sonje jiska prezan</char> <note caller="+" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">Mat 14:17-21</ref></char></note><char style="wj">senk pen ki te pou senk mil mesye yo, e konbyen panyen nou te ranmase?</char> <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/><char style="wj">Ni </char><note caller="+" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">Mat 15:34-38</ref></char></note><char style="wj">sèt pen ki te pou kat mil moun yo, e konbyen gran panyen nou te ranmase?</char> <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/><char style="wj">Kijan ke nou pa konprann ke Mwen pa t pale avèk nou pou afè pen? Men fè atansyon ak ledven Farizyen ak Sadiseyen yo.”</char><verse eid="MAT 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12"/>Konsa, yo te vin konprann ke Li pa t pale de ledven nan pen, men enstriksyon a <note caller="+" style="x"><char style="xo" closed="false">16:12 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mat 3:7</ref></char></note>Farizyen ak Sadiseyen yo.<verse eid="MAT 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:13 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 8:27-29">Mc 8:27-29</ref>
      </char>
    </note>Alò, lè Jésus te vini nan landwa Césarée de Philippe, Li te kòmanse mande disip Li yo: <char style="wj">“Ki moun yo di ke Fis a Lòm nan ye?”</char><verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>Yo te di: “Kèk moun di ke se <note caller="+" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="MAT 14:2">Mat 14:2</ref></char></note>Jean Baptiste, lòt <note caller="+" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="MAT 17:10">Mat 17:10</ref></char></note>Elie, e lòt, Jérémie oswa youn nan pwofèt yo.”<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>Li te di yo: <char style="wj">“Men nou menm, ki moun nou di Mwen ye?”</char><verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>Simon Pierre te reponn Li: <char style="wj">“Ou menm se Kris La, </char><note caller="+" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="MAT 4:3">Mat 4:3</ref></char></note><char style="wj">Fis a</char> <note caller="+" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="PSA 42:2">Sòm 42:2</ref></char></note><char style="wj">Bondye vivan an.”</char><verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>Jésus te reponn li: <char style="wj">“Ou menm ou beni, Simon, fis Jonas la, paske chè avèk san pa t revele ou sa, men Papa M ki nan syèl la.</char> <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/><char style="wj">Epi Mwen di Ou ke ou menm, ou se </char> <note caller="+" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="MAT 4:18">Mat 4:18</ref></char></note> <char style="wj">Pierre e se sou wòch sa a M ap bati legliz Mwen an, e pòtay peyi </char> <note caller="+" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="MAT 11:23">Mat 11:23</ref></char></note> <char style="wj">mò yo p ap kapab venk li.</char> <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/><char style="wj">M ap bay ou kle wayòm syèl la;</char> <note caller="+" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">Mat 18:18</ref></char></note><char style="wj">nenpòt sa ou mare sou latè, ap mare nan syèl la; e nenpòt sa ou demare sou latè, ap demare nan syèl la.”</char><verse eid="MAT 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:20 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 8:4">Mat 8:4</ref>
      </char>
    </note>Apre sa, Li te avèti yo pou pa di pèsòn ke se Kris la ke Li te ye.<verse eid="MAT 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:21 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 8:31-38">Mc 8:31-38</ref>
      </char>
    </note>Depi lè sa a, Jésus te kòmanse montre disip Li yo ke Li te oblije ale Jérusalem pou soufri anpil bagay nan men lansyen yo, wo prèt yo ak skrib yo; pou yo ta menm touye L, e pou L ta leve nan twazyèm jou a.<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>Konsa, Pierre te mennen L akote. Li te di L: “Ke Bondye anpeche sa, Senyè! Sa p ap janm rive Ou.”<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>Men Li te vire bò kote Pierre: <char style="wj">“Mete ou dèyè M </char> <note caller="+" style="x"><char style="xo" closed="false">16:23 </char><char style="xt" closed="false"><ref loc="MAT 4:10">Mat 4:10</ref></char></note> <char style="wj">Satan! Ou menm, ou se yon wòch chite pou Mwen. Ou pa mete tèt ou nan enterè Bondye, men nan enterè a lòm.”</char><verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>Jésus te di a disip Li yo: <char style="wj">“Si yon moun vle swiv Mwen, li dwe nye tèt li,</char> <note caller="+" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat 10:38</ref></char></note><char style="wj">pran kwa li e swiv Mwen.</char> <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/><char style="wj">Paske </char><note caller="+" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10:39</ref></char></note><char style="wj">nenpòt moun ki vle sove vi li, ap pèdi li; men nenpòt moun ki pèdi vi li pou koz Mwen menm, ap twouve li. </char> <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/><char style="wj">Paske ki pwofi yon nonm ap twouve si li vin genyen tout lemonn, men li pèdi pwòp nanm li? Kisa yon nonm ap bay an echanj pou nanm li?</char><verse eid="MAT 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 16:27"/>
    <char style="wj">“Paske Fis a Lòm nan</char> <note caller="+" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MRK 8:38">Mc 8:38</ref></char></note><char style="wj">ap vini nan tout glwa Papa Li, avèk zanj Li yo, e y ap rekonpanse tout moun selon zak yo.</char><verse eid="MAT 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 16:28"/>
    <char style="wj">“Anverite, Mwen di nou, gen nan nou ki kanpe la a ki p ap goute lanmò jiskaske yo wè Fis a Lòm nan k ap vini nan wayòm Li an.” </char><verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:1 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:2-8">Mc 9:2-8</ref>
      </char>
    </note>Sis jou pita, Jésus te pran <note caller="+" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="MAT 26:37">Mat 26:37</ref></char></note>Pierre, Jacques ak frè li, Jean pou kont yo, e te mennen yo sou yon mòn byen wo. <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>Konsa, Li te transfòme la devan yo. Figi Li te klere tankou solèy la, e vètman li te vin blanch tankou limyè. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>Epi konsa, gade, yo te wè Moïse ak Elie ki t ap pale avèk Li.<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>Pierre te di a Jésus: “Senyè, se bon pou nou isit la. Si Ou vle, <note caller="+" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="MRK 9:5">Mc 9:5</ref></char></note>m ap fè twa tabènak isit la; youn pou Ou, youn pou Moïse, e youn pou Elie.”<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>Pandan Li t ap pale, vwala, yon nwaj byen briyan te kouvri yo. E konsa, <note caller="+" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="MRK 1:11">Mc 1:11</ref></char></note>yon vwa sòti nan nwaj la e te di: “Sa se Fis byeneme Mwen an. Avèk Li, Mwen byen kontan. Koute Li!”<verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>Lè disip Li yo te tande sa, yo te tonbe sou figi yo byen sezi avèk laperèz.<verse eid="MAT 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 17:7"/>Jésus te vin kote yo. Li te touche yo, e te di: <char style="wj">“Leve, e</char> <note caller="+" style="x"><char style="xo" closed="false">17:7 </char><char style="xt" closed="false"><ref loc="MAT 14:27">Mat 14:27</ref></char></note><char style="wj">pa pè.” </char><verse eid="MAT 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 17:8"/>Lè yo leve zye yo, yo pa t wè pèsòn sof ke Jésus ki te la pou kont Li.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:9 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:9-13">Mc 9:9-13</ref>
      </char>
    </note>Pandan yo t ap desann mòn nan, Jésus te kòmande yo: <char style="wj">“Pa pale pèsòn afè vizyon sila a jiskaske Fis a Lòm nan fin</char> <note caller="+" style="x"><char style="xo" closed="false">17:9 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref></char></note><char style="wj">leve soti nan lanmò.”</char><verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>Epi disip Li yo te mande L: “E poukisa Skrib yo toujou di ke <note caller="+" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mal 4:5</ref></char></note>Elie oblije vini avan?”<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>Li te reponn yo: <char style="wj">“Elie ap vini e l ap restore tout bagay. </char> <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/><char style="wj">Men Mwen di nou ke Elie te vini deja, e yo pa t rekonèt li, men yo te fè avè l sa ke yo te pito. Menm jan an,</char> <note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 8:20">Mat 8:20</ref></char></note><char style="wj">Fis a Lòm nan ap soufri nan men yo.”</char><verse eid="MAT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13"/>Konsa, disip yo te vin konprann ke Li t ap pale de Jean Baptiste.<verse eid="MAT 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:14 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:14-28">Mc 9:14-28</ref>
      </char>
    </note>Lè yo rive bò kote foul la, yon mesye te vin tonbe sou jenou devan Li. Li te di L: <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>“Senyè, gen pitye pou fis mwen an. Li se yon <note caller="+" style="x"><char style="xo" closed="false">17:15 </char><char style="xt" closed="false"><ref loc="MAT 4:24">Mat 4:24</ref></char></note>epileptik; li byen malad. Souvan li tonbe nan dife a, e pafwa menm nan dlo. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>Mwen te pote li bay disip Ou yo, men yo pa t kapab geri li.”<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>Jésus te reponn. Li te di: <char style="wj">“O jenerasyon enkredil e pèvès; pandan konbyen de tan M ap avèk nou? Pandan konbyen de tan M ap sipòte nou? Mennen li ban Mwen!” </char> <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>Jésus te reprimande lespri a. Dyab la te sòti sou li, epi jennonm nan te geri lapoula.<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>Konsa, disip yo te vin kote Jésus an prive. Yo te mande L: “Poukisa nou menm pa t kapab chase l?”<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>Li te di yo: <char style="wj">“Paske lafwa nou tèlman piti. Paske konsa Mwen di nou:</char> <note caller="+" style="x"><char style="xo" closed="false">17:20 </char><char style="xt" closed="false"><ref loc="MAT 21:2">Mat 21:2</ref></char></note><char style="wj">Si nou gen lafwa gwosè yon grenn moutad, nou ap di a mòn sa a: ‘Deplase ou isit la, ale la,’epi l ap prale. Nanpwen anyen k ap enposib pou nou.</char> <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/><note caller="+" style="x"><char style="xo" closed="false">17:21 </char><char style="xt" closed="false"><ref loc="MRK 9:29">Mc 9:29</ref></char></note><char style="wj">Men kalite sila a pa sòti sof ke pa lapriyè, avèk jèn.”</char><verse eid="MAT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:22 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:30-32">Mc 9:30-32</ref>
      </char>
    </note>Pandan yo t ap rasanble Galilée, Jésus te di yo: <char style="wj">“Fis a Lòm nan prèt pou livre nan men a lèzòm.</char> <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/><note caller="+" style="x"><char style="xo" closed="false">17:23 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref></char></note><char style="wj">Yo va touye Li, e Li va leve nan twazyèm jou a.” </char> Yo te byen tris.<verse eid="MAT 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>Lè yo te ale Capernaüm, sila ki te fè koleksyon taks <note caller="+" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">Egz 30:13</ref></char></note>drachma yo te vin Kote Pierre, Li te mande l: “Èske mèt ou a pa peye taks drachma?”<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>Li te reponn: “Wi”.</para>
  <para style="p" vid="MAT 17:25">Lè Pierre te antre nan kay la, Jésus, akoz Li te konnen sa li t ap mande, te di: <char style="wj">“Kisa ou panse, Simon? Nan men ki moun wa sou latè yo ranmase </char><note caller="+" style="x"><char style="xo" closed="false">17:25 </char><char style="xt" closed="false"><ref loc="ROM 13:7">Wo 13:7</ref></char></note><char style="wj">tarif ak enpo? Èske se nan men fis pa yo, oubyen èske se nan men moun yo pa rekonèt?”</char><verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>Lè li reponn: “Moun yo pa rekonèt”, Jésus te di l: <char style="wj">“Konsa, fis yo egzante.</char> <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/><char style="wj">Sepandan, pou nou pa</char> <note caller="+" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="MAT 5:29-30">Mat 5:29-30</ref></char></note><char style="wj">ofanse yo, ale bò kote lanmè a; voye yon filè ladann e rale premye pwason ki vini an. Lè nou ouvri bouch li nou va wè yon statère (yon kòb Women). Pran li pote bay yo pou ou ak Mwen.” </char><verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:1 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:33-37">Mc 9:33-37</ref>
      </char>
    </note>Nan lè sa a, disip yo te vin jwenn Jésus pou mande L: “Kilès konsa ki pi gran nan wayòm syèl la?”<verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>Jésus te rele yon timoun vin kote Li, e te plase l nan mitan yo. <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>Li te di yo: <char style="wj">“Anverite Mwen di nou, anmwenske nou konvèti pou </char><note caller="+" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="MAT 19:14">Mat 19:14</ref></char></note><char style="wj">vini tankou timoun yo, nou p ap antre nan wayòm syèl la.</char> <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/><char style="wj">Nenpòt moun ki vin enb tankou timoun sa a, se li menm ki pi gran nan wayòm syèl la.</char><verse eid="MAT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5"/>
    <char style="wj">“Epi nenpòt moun ki resevwa yon pitit tankou sa a nan non Mwen, li resevwa Mwen.</char> <verse eid="MAT 18:5"/><verse number="6" style="v" sid="MAT 18:6"/><char style="wj">Men</char> <note caller="+" style="x"><char style="xo" closed="false">18:6 </char><char style="xt" closed="false"><ref loc="MRK 9:42">Mc 9:42</ref></char></note><char style="wj">nenpòt moun ki lakoz pou fè youn nan timoun sa yo ki kwè nan Mwen an vin chape tonbe, li ta mye pou li menm si yon gwo wòch moulen ta mare nan kou li, e li ta vin mouri nan fon lanmè.</char><verse eid="MAT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7"/>
    <char style="wj">“Malè a mond sa a akoz wòch chite li yo! Wòch chite sa yo</char> <note caller="+" style="x"><char style="xo" closed="false">18:7 </char><char style="xt" closed="false"><ref loc="LUK 17:1">Luc 17:1</ref></char></note><char style="wj">pa kapab pa vini, men malè a moun sila a ki fè yo parèt.</char><verse eid="MAT 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:8 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:30">Mat 5:30</ref>
      </char>
    </note>
    <char style="wj">“Si men nou oubyen pye nou fè nou tonbe, koupe l e jete l lwen nou. Li pi bon pou antre nan lavi tankou yon kokobe oubyen bwate, pase ak toude men ak pye nou pou nou ta jete nan lanfè etènèl la.</char><verse eid="MAT 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 18:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:29">Mat 5:29</ref>
      </char>
    </note>
    <char style="wj">“Epi si zye nou fè nou tonbe, rache li jete li byen lwen nou. Li pi bon pou antre nan lavi avèk yon sèl grenn zye olye avèk toude pou nou ta jete nan lanfè dife a.</char><verse eid="MAT 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>
    <char style="wj">“Veye pou nou pa meprize youn nan timoun sa yo, paske Mwen di nou ke </char> <note caller="+" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="LUK 1:19">Luc 1:19</ref></char></note> <char style="wj">zanj yo nan syèl la toujou wè figi a Papa M ki nan syèl la.</char> <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/><note caller="+" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">Luc 19:10</ref></char></note><char style="wj">Paske Fis a Lòm nan te vini pou sove sila ki te pèdi a.</char><verse eid="MAT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>
    <char style="wj">“Kisa nou panse?</char> <note caller="+" style="x"><char style="xo" closed="false">18:12 </char><char style="xt" closed="false"><ref loc="LUK 15:4-7">Luc 15:4-7</ref></char></note><char style="wj">Si yon moun gen san mouton e youn vin pèdi, èske li p ap kite katre-ven-diz-nèf yo sou mòn nan pou ale chèche sila ki pèdi a?</char> <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/><char style="wj">Epi si li twouve li, Mwen di nou, l ap rejwi plis sou sila a pase lòt katre-ven-diz-nèf ki pa t janm pèdi yo.</char><verse eid="MAT 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 18:14"/>
    <char style="wj">“Konsa se pa volonte Papa nou nan syèl la pou youn nan Pitit sila yo ta pèdi.</char><verse eid="MAT 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:15 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 19:17">Lev 19:17</ref>
      </char>
    </note>
    <char style="wj">“Si frè ou peche, rele l apa pou pale avèk li. Si li koute ou, ou gen tan rekonsilye ak frè ou a.</char> <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/><char style="wj">Men si li pa koute ou, ale kote l avèk youn oubyen de lòt dekwa ke</char> <note caller="+" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">Det 19:15</ref></char></note><char style="wj">‘pa bouch a de oubyen twa temwen tout bagay ki fèt kapab konfime.’</char> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/><char style="wj">Epi si li refize koute yo, pale avèk legliz la, e si li refize koute menm legliz la,</char> <note caller="+" style="x"><char style="xo" closed="false">18:17 </char><char style="xt" closed="false"><ref loc="2TI 3:6-14">II Tim 3:6-14</ref></char></note><char style="wj">kite li devni a ou menm tankou yon payen oswa youn nan kolektè kontribisyon yo.</char><verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>
    <char style="wj">“Anverite Mwen di nou:</char> <note caller="+" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">Mat 16:19</ref></char></note><char style="wj">“Nenpòt sa nou mare sou latè, l ap mare nan syèl la; e nenpòt sa nou lage sou latè, l ap lage nan syèl la.</char><verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>
    <char style="wj">“Ankò Mwen di nou ke si de nan nou dakò sou latè sou nenpòt bagay ke yo mande,</char> <note caller="+" style="x"><char style="xo" closed="false">18:19 </char><char style="xt" closed="false"><ref loc="MAT 7:7">Mat 7:7</ref></char></note><char style="wj">li va fèt pou yo pa Papa M ki nan syèl la.</char> <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/><char style="wj">Paske kote de oubyen twa reyini ansanm nan non Mwen,</char> <note caller="+" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="MAT 28:20">Mat 28:20</ref></char></note><char style="wj">Mwen la nan mitan yo.”</char><verse eid="MAT 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>Apre sa, Pierre te vin kote L e te mande L: “Senyè, <note caller="+" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="MAT 18:15">Mat 18:15</ref></char></note>konbyen fwa frè m kapab peche kont mwen pou m toujou padone l? Jis <note caller="+" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="LUK 17:4">Luc 17:4</ref></char></note>sèt fwa?”<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>Jésus te reponn li: <char style="wj">“Mwen p ap di ou sèt fwa, men jiska</char> <note caller="+" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="GEN 4:24">Jen 4:24</ref></char></note><char style="wj">swasann-dis fwa sèt.</char><verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>
    <char style="wj">“Pou rezon sa a, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:24">Mat 13:24</ref>
      </char>
    </note>
    <char style="wj">wayòm syèl la kapab konpare avèk yon sèten wa ki te vle</char> <note caller="+" style="x"><char style="xo" closed="false">18:23 </char><char style="xt" closed="false"><ref loc="MAT 25:19">Mat 25:19</ref></char></note><char style="wj">regle kont lajan yo avèk esklav li yo.</char> <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/><char style="wj">Lè li kòmanse regle yo, yo mennen bay li yon nonm ki te dwe li di-mil talan (yon fòtin imans.)</char> <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/><char style="wj">Men akoz ke li</char> <note caller="+" style="x"><char style="xo" closed="false">18:25 </char><char style="xt" closed="false"><ref loc="LUK 7:42">Luc 7:42</ref></char></note><char style="wj">pa t gen mwayen pou peye, mèt li te kòmande ke yo ta</char> <note caller="+" style="x"><char style="xo" closed="false">18:25 </char><char style="xt" closed="false"><ref loc="EXO 21:2">Egz 21:2</ref></char></note><char style="wj">vann mesyè a, ni madanm li ak Pitit li yo ak tout sa li te posede, pou ranbousman an ta kapab fèt. </char><verse eid="MAT 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26"/>
    <char style="wj">“Konsa, esklav la vin tonbe atè </char> <note caller="+" style="x"><char style="xo" closed="false">18:26 </char><char style="xt" closed="false"><ref loc="MAT 8:2">Mat 8:2</ref></char></note> <char style="wj">pwostène devan li, e te di: ‘Gen pasyans avè m e m ap peye ou tout.’</char> <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/><char style="wj">Konsa, mèt esklav sila a te santi konpasyon pou li, te lage li e</char> <note caller="+" style="x"><char style="xo" closed="false">18:27 </char><char style="xt" closed="false"><ref loc="LUK 7:42">Luc 7:42</ref></char></note><char style="wj">te padone dèt la.</char><verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>
    <char style="wj">“Men esklav la te ale twouve yon lòt esklav parèy li, ki te dwe l san denye (yon ti kòb)</char>. <char style="wj">Li te sezi li, e te kòmanse trangle l e te di: ‘Peye sa ou dwe a’.</char><verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>
    <char style="wj">“Esklav parèy li a te tonbe pwostène e te sipliye l: ‘Pran pasyans avè m, e m ap peye ou.’ </char> <verse eid="MAT 18:29"/><verse number="30" style="v" sid="MAT 18:30"/><char style="wj">Men li pa t vle fè sa. Li te voye jete l nan prizon jis lè li ta kapab repeye tout sa li te dwe a.</char><verse eid="MAT 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31"/>
    <char style="wj">“Lè lòt esklav yo te wè sa ki te rive a, yo te byen twouble. Yo te vin bay yon rapò a mèt pa yo a sou tout sa ki te rive yo.</char><verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>
    <char style="wj">“Konsa, mèt li a te voye yon manda pou fè l vini. Li te di l: Ala esklav mechan ou ye! Mwen te padone ou tout dèt sa a, paske ou te sipliye m.</char> <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/><note caller="+" style="x"><char style="xo" closed="false">18:33 </char><char style="xt" closed="false"><ref loc="MAT 6:12">Mat 6:12</ref></char></note><char style="wj">Konsa, èske ou pa t dwe gen konpasyon pou esklav parèy ou a menm jan ke mwen te gen konpasyon pou ou a?</char> <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/><char style="wj">Epi mèt li a, byen fache, te livre bay moun nan pou l tòtire jis lè li ta repeye tout sa li te dwe l la.</char><verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>
    <char style="wj">“Konsa</char> <note caller="+" style="x"><char style="xo" closed="false">18:35 </char><char style="xt" closed="false"><ref loc="MAT 6:14">Mat 6:14</ref></char></note> <char style="wj">Papa M nan syèl la va fè a nou menm osi si nou pa padone frè nou yo jis nan kè nou.”</char><verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>Lè Jésus te fin pale pawòl sa yo, li te kite Galilée pou <note caller="+" style="x"><char style="xo" closed="false">19:1 </char><char style="xt" closed="false"><ref loc="MRK 10:1-12">Mc 10:1-12</ref></char></note>ale nan rejyon Judée, lòtbò Jourdain an. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Gran foul yo te swiv Li, e <note caller="+" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>Li te geri yo la.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>Kèk Farizyen te vin kote Li pou fè pase L eprèv. Yo mande L: <note caller="+" style="x"><char style="xo" closed="false">19:3 </char><char style="xt" closed="false"><ref loc="MAT 5:31">Mat 5:31</ref></char></note>“Èske li pèmèt pou yon nonm divòse ak madanm li pou okenn rezon?”<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>Li te reponn yo: <char style="wj">“Èske nou pa konn li</char> <note caller="+" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Jen 1:27</ref></char></note><char style="wj">ke Sila ki te kreye yo depi nan kòmansman an, te fè yo mal ak femèl,</char> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/><char style="wj">ke: </char><note caller="+" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Jen 2:24</ref></char></note><char style="wj">‘pou koz sa a, yon nonm ap kite papa li ak manman li pou vin atache a madanm li, epi yo de a ap vini yon sèl chè?</char> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/><char style="wj">Konsa, se pa de yo ye ankò, men yon sèl chè. Sa ke Bondye mete ansanm, pa kite okenn moun separe l.’”</char><verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>Yo te mande L: “Ebyen, <note caller="+" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Det 24:1-4</ref></char></note>poukisa Moïse te kòmande yo pou ‘Bay li yon sètifika divòs e voye li ale?’”<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>Li te reponn yo: <char style="wj">“Akoz kè di nou, Moïse te pèmèt nou divòse ak madanm nou yo, men depi nan kòmansman an, se pa konsa li te ye.</char> <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/><char style="wj">Mwen di nou:</char> <note caller="+" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat 5:32</ref></char></note> <char style="wj">Nenpòt moun ki divòse ak madanm li, sof ke pou imoralite, epi marye avèk yon lòt fanm, li fè adiltè.” </char><verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>Disip Li yo te di L: “Si se konsa relasyon a yon mesye ye avèk madanm li, li pi bon pou pa marye.”<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>Men Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="1CO 7:7">I Kor 7:7</ref></char></note><char style="wj">“Se pa tout moun ki kapab aksepte sa nou di a, men sèl sa yo ke li te bay.</char> <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/><char style="wj">Paske gen enik ki te fèt konsa depi nan vant manman yo, e gen enik ki te fèt konsa pa lòm; e gen enik ki te fèt konsa pou tèt yo, pou koz a wayòm syèl la. Sila ki kapab aksepte sa, kite l aksepte li.”</char><verse eid="MAT 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>Apre sa, <note caller="+" style="x"><char style="xo" closed="false">19:13 </char><char style="xt" closed="false"><ref loc="MRK 10:13-16">Mc 10:13-16</ref></char></note>yo te mennen kèk timoun kote L pou Li ta kapab mete men Li sou yo e priye pou yo; men disip yo te reprimande yo.<verse eid="MAT 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14"/>Konsa, Jésus te di: <note caller="+" style="x"><char style="xo" closed="false">19:14 </char><char style="xt" closed="false"><ref loc="MAT 18:3">Mat 18:3</ref></char></note><char style="wj">“Bay timoun yo pèmi, e pa anpeche yo vin kote Mwen, paske wayòm syèl la se pou sila ki tankou yo”.</char> <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>Apre Li mete men Li sou yo, Li kite la.<verse eid="MAT 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:16 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:25-28">Luc 10:25-28</ref>
      </char>
    </note>Konsa, youn moun te vini la, e te di: “Mèt, ki bon bagay Mwen kapab fè pou m jwenn lavi etènèl?”<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>Li te di l: “<char style="wj">Poukisa ou ap kesyone M sou sa ki bon? Gen yon sèl ki bon, Bondye. Men</char> <note caller="+" style="x"><char style="xo" closed="false">19:17 </char><char style="xt" closed="false"><ref loc="LEV 18:5">Lev 18:5</ref></char></note><char style="wj">si ou vle antre nan lavi, kenbe kòmandman yo.”</char><verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>Li te mande Li: “Kilès nan yo?”</para>
  <para style="p" vid="MAT 19:18">Jésus te reponn li: <note caller="+" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">Egz 20:13-16</ref></char></note><char style="wj">“Ou pa pou touye moun, ou pa pou fè adiltè, ou pa pou vòlè, ou pa pou pote fo temwayaj.</char> <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/><note caller="+" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Egz 20:12</ref></char></note><char style="wj">Onore papa ou avèk manman ou, epi </char><note caller="+" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lev 19:18</ref></char></note><char style="wj">renmen pwochen ou tankou tèt ou.”</char><verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>Jennonm nan te di L: “Tout bagay sa yo, mwen fè yo. Kisa mwen manke?”<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>Jésus te di l: <char style="wj">“Si ou vle pafè, </char> <note caller="+" style="x"><char style="xo" closed="false">19:21 </char><char style="xt" closed="false"><ref loc="LUK 12:33">Luc 12:33</ref></char></note> <char style="wj">ale vann tout sa ou posede, bay malere yo, e w ap gen richès nan syèl la; epi vin swiv Mwen.”</char><verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>Men lè jennonm nan te tande pawòl sa a, li te sòti dezole, paske li te gen anpil byen.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>Jésus te di a disip Li yo: <char style="wj">“Anverite Mwen di nou: </char><note caller="+" style="x"><char style="xo" closed="false">19:23 </char><char style="xt" closed="false"><ref loc="MAT 13:22">Mat 13:22</ref></char></note> <char style="wj">Li difisil pou yon nonm rich antre nan wayòm syèl la.</char> <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/><char style="wj">Ankò, Mwen di nou:</char> <note caller="+" style="x"><char style="xo" closed="false">19:24 </char><char style="xt" closed="false"><ref loc="MRK 10:25">Mc 10:25</ref></char></note><char style="wj">Li pi fasil pou yon chamo pase nan zye a yon zegwi, pase pou yon nonm rich antre nan wayòm Bondye a.”</char><verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>Lè disip Li yo te tande sa, yo te etone e te di: “Kilès konsa ki kab sove?”<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>Jésus te byen gade yo, e te di: <note caller="+" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="GEN 18:14">Jen 18:14</ref></char></note><char style="wj">“Avèk moun, li pa posib, men avèk Bondye, tout bagay posib.”</char><verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>Konsa Pierre te reponn Li. Li te di: “Gade, nou fin kite tout bagay pou te swiv Ou. Kisa k ap gen pou nou?”<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>Jésus te di yo: <char style="wj">“Anverite, Mwen di nou ke nou ki te swiv Mwen yo, nan tan renouvèlman tout bagay la, lè Fis a Lòm nan vin chita sou twòn Li nan tout glwa Li, nou menm</char> <note caller="+" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="LUK 22:30">Luc 22:30</ref></char></note><char style="wj">tou, n ap chita sou douz twòn pou jije douz tribi Israël yo.</char><verse eid="MAT 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 19:29"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 6:33">Mat 6:33</ref>
      </char>
    </note>
    <char style="wj">“Tout moun ki kite kay yo oubyen frè yo oubyen sè yo, papa, Manman, zanfan, oubyen tè pou koz a Non Mwen, ap resevwa anpil fwa sa a, e va eritye lavi etènèl.</char> <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/><note caller="+" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mat 20:16</ref></char></note><char style="wj">Men anpil moun ki premye ap dènye, e dènye yo, ap vin premye.” </char><verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>
    <char style="wj">“Paske wayòm syèl la tankou yon mèt tè ki ale deyò granmaten pou anplwaye ouvriye pou </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:28">Mat 21:28</ref>,<ref loc="MAT 21:33">33</ref></char>
    </note>
    <char style="wj">chan rezen li.</char> <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/><char style="wj">Lè li te fin antann li avèk ouvriye yo pou yon denye (frè kòb jounalye) pou jou a, li voye yo nan chan an.</char><verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>
    <char style="wj">“Vè twazyèm lè, li te soti pou wè lòt moun san anyen pou fè, ki te kanpe nan mache a.</char> <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/><char style="wj">Li te di yo: ‘Nou menm tou, ale nan chan rezen an, epi nenpòt bagay ki jis, m ap bannou.’ Konsa, yo ale.</char><verse eid="MAT 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 20:5"/>
    <char style="wj">“Ankò li ale deyò vè sizyèm lè, nevyèm lè, e te fè menm bagay la.</char> <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/><char style="wj">“Vè onzyèm lè, li te ale deyò e te twouve lòt moun ki tap kanpe. Li te di yo: ‘Poukisa nou kanpe la tout lajounen san fè anyen?’</char><verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>
    <char style="wj">“Yo te reponn li: ‘Paske pèsòn pa anplwaye nou.’ </char></para>
  <para style="p" vid="MAT 20:7">
    <char style="wj">“Li te di yo: ‘Nou menm tou, ale nan chan rezen an.’</char><verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>
    <char style="wj">“Lè</char> <note caller="+" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">Lev 19:13</ref></char></note><char style="wj">aswè rive, mèt chan rezen an te di fòmann nan: ‘Rele ouvriye yo pou peye yo salè yo. Kòmanse avèk dènye ekip la, pou ale nan premye a.’</char><verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>
    <char style="wj">“Lè ouvriye ki te antre vè onzyèm lè yo te vini, yo chak te resevwa yon denye. </char> <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/><char style="wj">Konsa, lè sa ki te anplwaye anpremye yo te vini, yo te sipoze yo t ap resevwa plis, men yo chak te resevwa yon denye.</char> <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/><char style="wj">Alò, lè yo te resevwa l, yo te plenyen kont mèt tè a. </char> <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/><char style="wj">Yo te di: ‘Moun sa yo te travay sèlman pou yon èdtan, men ou fè yo menm jan avèk nou ki pote tout fado a, avèk </char> <note caller="+" style="x"><char style="xo" closed="false">20:12 </char><char style="xt" closed="false"><ref loc="JON 4:8">Jon 4:8</ref></char></note> <char style="wj">chalè ki t ap brile nou tout jounen an.’</char><verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>
    <char style="wj">“Men li te reponn a youn nan yo:</char> <note caller="+" style="x"><char style="xo" closed="false">20:13 </char><char style="xt" closed="false"><ref loc="MAT 22:12">Mat 22:12</ref></char></note><char style="wj">‘Zanmi m, mwen pa fè ou okenn tò. Èske ou pa t vin dakò pou yon denye?</char> <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/><char style="wj">Pran sa ki pou ou a, epi al fè wout ou. Se volonte m pou bay moun sa menm fòs avèk ou. </char> <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/><char style="wj">Èske m pa gen dwa fè sa mwen vle avèk sa ki pou mwen? Oubyen èske</char> <note caller="+" style="x"><char style="xo" closed="false">20:15 </char><char style="xt" closed="false"><ref loc="DEU 15:9">Det 15:9</ref></char></note><char style="wj">zye ou plen ak lanvi paske mwen gen jenewozite?’</char><verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>
    <char style="wj">“Konsa</char> <note caller="+" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">Mat 19:30</ref></char></note><char style="wj">dènye a ap vin premye, e premye a ap vin dènye.”</char><verse eid="MAT 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:17 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 10:32-34">Mc 10:32-34</ref>
      </char>
    </note> Lè Jésus te apèn parèt pou monte a Jérusalem, Li te pran douz disip yo akote pou kont yo. Pandan yo nan wout la, Li te di yo: <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/><char style="wj">“Gade, n ap monte Jérusalem, epi Fis a Lòm nan</char> <note caller="+" style="x"><char style="xo" closed="false">20:18 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref></char></note><char style="wj">ap livre a chèf prèt yo ak Skrib yo, e y ap kondane Li a lanmò.</char> <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/><char style="wj">Konsa, y ap livre Li a payen yo pou yo ka moke L e bay Li kout fwèt, e y ap krisifye Li. Epi </char><note caller="+" style="x"><char style="xo" closed="false">20:19 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref></char></note><char style="wj">nan twazyèm jou a, L ap leve.”</char><verse eid="MAT 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:20 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 10:35-45">Mc 10:35-45</ref>
      </char>
    </note>Manman a fis Zébédée yo te vin kote L avèk fis li yo. Li te bese devan L pou mande L yon favè.<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>Li te di L: <char style="wj">“Kisa ou vle?”</char></para>
  <para style="p" vid="MAT 20:21">Li te di L: “Pase lòd pou nan Wayòm ou an, de fis mwen yo <note caller="+" style="x"><char style="xo" closed="false">20:21 </char><char style="xt" closed="false"><ref loc="MAT 19:28">Mat 19:28</ref></char></note>kapab chita youn sou bò dwat Ou ak youn sou bò goch Ou.”<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>Men Jésus te reponn: <char style="wj">“Nou pa konnen kisa n ap mande a. Èske nou kapab </char><note caller="+" style="x"><char style="xo" closed="false">20:22 </char><char style="xt" closed="false"><ref loc="ISA 51:17-22">És 51:17-22</ref></char></note><char style="wj">bwè tas ke Mwen prè pou M bwè a?”</char></para>
  <para style="p" vid="MAT 20:22">Yo te di Li: “Nou kapab”.<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">20:23 </char><char style="xt" closed="false"><ref loc="ACT 12:2">Trav 12:2</ref></char></note><char style="wj">“Tas Mwen an nou ap bwè, men pou chita adwat Mwen, oubyen agoch Mwen, se pa Mwen ki pou bay li, men se pou sila papa M te </char><note caller="+" style="x"><char style="xo" closed="false">20:23 </char><char style="xt" closed="false"><ref loc="MAT 25:34">Mat 25:34</ref></char></note><char style="wj">prepare li yo.”</char><verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>Konsa, lè dis yo te tande sa, yo te vin trè fache avèk de frè yo.<verse eid="MAT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 20:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:25 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 20:25-28">Mat 20:25-28</ref>
      </char>
    </note>Men Jésus te rele yo a Li menm e te di yo: <char style="wj">“Ou konnen ke chèf payen yo pran pozisyon yo kon gwo chèf sou yo, epi moun enpòtan pa yo egzèse gwo otorite sou yo.</char><verse eid="MAT 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 20:26"/>
    <char style="wj">“Li pa konsa pami nou,</char> <note caller="+" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="MAT 2:11">Mat 2:11</ref></char></note><char style="wj">men sila ki ta vle gran pami nou an, ap vin sèvitè nou.</char> <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/><char style="wj">Epi sila a ki vle premye pami nou an, va vin esklav nou.</char> <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/><char style="wj">Menm jan ke Fis a Lòm nan</char> <note caller="+" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="MAT 26:28">Mat 26:28</ref></char></note><char style="wj">pa t vini pou fè lòt sèvi Li, men pou sèvi lòt yo, e pou bay vi li pou ranson vi a anpil lòt moun.” </char><verse eid="MAT 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:27-31">Mat 9:27-31</ref>
      </char>
    </note>Pandan yo t ap kite Jéricho, yon gran foul te swiv Li.<verse eid="MAT 20:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 20:30"/>Epi konsa de moun avèg ki te chita akote wout la, lè yo te tande ke Jésus t ap pase la, te kòmanse kriye: “Senyè, <note caller="+" style="x"><char style="xo" closed="false">20:30 </char><char style="xt" closed="false"><ref loc="MAT 9:27">Mat 9:27</ref></char></note>gen pitye pou nou, Fis a David la!”<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>Men moun yo te pale ak yo sevèman pou yo sispann pale, men yo rele pi fò: “Senyè, gen pitye pou nou, <note caller="+" style="x"><char style="xo" closed="false">20:31 </char><char style="xt" closed="false"><ref loc="MAT 9:27">Mat 9:27</ref></char></note>Fis a David la”.<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>Epi Jésus te rete la. Li te rele yo, e te di: <char style="wj">“Kisa nou ta renmen Mwen fè pou nou?”</char><verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>Yo te reponn Li: “Senyè, nou vle zye nou louvri”.<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>Jésus, ranpli avèk konpasyon, te touche zye yo. Imedyatman yo te vin wè, e yo te swiv Li.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:1 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 11:1-10">Mc 11:1-10</ref>
      </char>
    </note>Lè yo te pwoche Jérusalem pou rive kote Bethphagé nan Mòn Oliv la, Jésus te voye de nan disip li yo, <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>epi te di yo: <char style="wj">“Ale nan vilaj anfas nou an, epi nou va twouve yon bourik ki mare la avèk pitit li. Demare yo, e mennen yo ban Mwen.</char> <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/><char style="wj">Epi si yon moun di nou yon bagay, nou va di li konsa: ‘Senyè a gen bezwen yo’, epi lapoula, l ap voye yo.”</char><verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:4 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 11:7-10">Mc 11:7-10</ref>
      </char>
    </note>Tout sa te fèt pou sa ki te pale pa pwofèt la ta kapab akonpli, lè li te di:<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 62:11">És 62:11</ref>
      </char>
    </note>“Pale a fi Sion an,</para>
  <para style="q1" vid="MAT 21:5">Men gade, Wa ou ap vin kote ou,</para>
  <para style="q1" vid="MAT 21:5">dou, e monte sou yon bourik,</para>
  <para style="q1" vid="MAT 21:5">yon jenn bourik, Pitit a yon bèt ki pote chaj”.<verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>Epi disip yo te ale fè tout sa Li te mande yo. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>Konsa yo te mennen bourik la avèk Pitit li a e te mete vètman yo, epi konsa, sou vètman yo Li te chita.<verse eid="MAT 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 21:8"/>Pifò nan foul la te <note caller="+" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="2KI 9:13">II Wa 9:13</ref></char></note>plase vètman yo louvri sou wout la, e kèk lòt t ap koupe branch nan bwa yo pou plase sou wout la.<verse eid="MAT 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 21:9"/>Foul la ki te ale devan Li, ni sa ki te swiv Li t ap rele: “Ozana (Glwa a Bondye) a Fis a David la! <note caller="+" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Sòm 118:26</ref></char></note>Beni se Sila ki vini nan non Senyè a! Ozana <note caller="+" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="LUK 2:14">Luc 2:14</ref></char></note>nan pi wo a!”<verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>Lè Li te antre Jérusalem, tout vil la te byen boulvèse e t ap di: “Ki moun sa ye?” <verse eid="MAT 21:10"/><verse number="11" style="v" sid="MAT 21:11"/>Epi foul la t ap di: “Sa se <note caller="+" style="x"><char style="xo" closed="false">21:11 </char><char style="xt" closed="false"><ref loc="MAT 21:26">Mat 21:26</ref></char></note>pwofèt Jésus ki sòti Nazareth nan Galilée a”.<verse eid="MAT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:12 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 11:15-18">Mc 11:15-18</ref>
      </char>
    </note>Jésus te antre nan tanp lan e te chase mete tout moun deyò ki t ap achte e vann nan tanp lan. Li te chavire tab a moun ki t ap chanje lajan yo, avèk chèz a moun ki t ap vann toutrèl yo. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>Li te di yo: <char style="wj">“Li ekri:</char> <note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">És 56:7</ref></char></note><char style="wj">‘Lakay Mwen an va rele yon kay pou lapriyè,’ men nou menm, nou fè li yon</char> <note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="JER 7:11">Jr 7:11</ref></char></note><char style="wj">twou kachèt pou vòlè!”</char><verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>Avèg yo avèk bwate yo te vin kote L nan tanp lan, e <note caller="+" style="x"><char style="xo" closed="false">21:14 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>Li te geri yo.<verse eid="MAT 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 21:15"/>Men lè chèf prèt yo avèk skrib yo te wè tout mèvèy ke Li te fè yo, epi timoun nan tanp yo ki t ap kriye: “Ozana a <note caller="+" style="x"><char style="xo" closed="false">21:15 </char><char style="xt" closed="false"><ref loc="MAT 9:27">Mat 9:27</ref></char></note>Fis a David la!”, yo te ankòlè anpil. <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>Epi yo te di Li: “Ou pa tande kisa timoun sa yo ap di?” Jésus te reponn yo: <char style="wj">“Wi, nou pa janm konn li</char> <note caller="+" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">Sòm 8:2</ref></char></note><char style="wj">‘Nan bouch a timoun avèk ti bebe k ap tete yo, nou prepare lwanj pou Ou menm’”?</char><verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>Li te kite yo, e sòti pou ale nan vil <note caller="+" style="x"><char style="xo" closed="false">21:17 </char><char style="xt" closed="false"><ref loc="MAT 26:6">Mat 26:6</ref></char></note>Béthanie pou pase nwit lan.<verse eid="MAT 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:18 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 11:12-24">Mc 11:12-24</ref>
      </char>
    </note>Alò nan maten, Li te retounen nan vil la. Li te vin grangou. <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>Li te wè yon sèl <note caller="+" style="x"><char style="xo" closed="false">21:19 </char><char style="xt" closed="false"><ref loc="LUK 13:6-9">Luc 13:6-9</ref></char></note>pye fig frans akote wout la. Men lè L vin kote l, Li pa twouve anyen sof ke fèy yo. Konsa Li pale li: <char style="wj">“Ou p ap janm gen fwi ki sòti sou ou ankò!”</char> Epi lapoula, pye fig frans lan te vin fennen nèt.<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>Lè yo wè sa, disip yo te etone. Yo te di: “Kijan fig frans sa a fè vin fennen nan yon moman konsa?”<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>Jésus te reponn e te di yo: <char style="wj">“Anverite Mwen di nou:</char> <note caller="+" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat 17:20</ref></char></note><char style="wj">Si nou gen lafwa e nou pa doute, non sèlman n ap fè sa ki te fèt a fig frans lan, men menm si nou di a mòn sa a: ‘Leve ale jete ou nan lanmè’, sa va fèt.</char> <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/><char style="wj">Epi</char> <note caller="+" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="MAT 7:7">Mat 7:7</ref></char></note><char style="wj">tout sa nou mande nan lapriyè e kwè, nou va resevwa li.”</char><verse eid="MAT 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:23 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 11:27-33">Mc 11:27-33</ref>
      </char>
    </note>Lè Li te fin antre nan tanp lan, chèf prèt yo avèk lansyen pami pèp la te vin kote L pandan Li t ap enstwi pou mande L: “Pa ki otorite Ou fè bagay sa yo? Se kilès ki te bay ou otorite sila a?”<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>Jésus te reponn yo: <char style="wj">“M ap mande nou yon bagay tou, e si nou reponn Mwen, M ap fè nou konnen pa ki otorite Mwen fè bagay sila yo.</char> <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/><char style="wj">Batèm a Jean an, kibò li sòti? Èske sous li se syèl la, oubyen lòm?”</char></para>
  <para style="p" vid="MAT 21:25">Konsa, yo te kòmanse rezone pami yo menm. Yo te di: “Si nou di ‘syèl la’, L ap di nou ‘ebyen poukisa nou pa t kwè l?’ <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>Men si nou di ‘lòm’, nou pè foul la, paske yo tout kwè ke Jean te <note caller="+" style="x"><char style="xo" closed="false">21:26 </char><char style="xt" closed="false"><ref loc="MAT 11:9">Mat 11:9</ref></char></note>yon pwofèt.”<verse eid="MAT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27"/>Yo te reponn Jésus. Yo te di: “Nou pa konnen”.</para>
  <para style="p" vid="MAT 21:27">Li te reponn yo: <char style="wj">“Ni Mwen menm p ap di nou pa ki otorite Mwen fè bagay sa yo.” </char><verse eid="MAT 21:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>
    <char style="wj">“Men kisa nou panse? Yon nonm te gen de fis. Li te vini a premye a, e te di l: ‘Fis mwen, ale travay pou mwen jodi a nan</char> <note caller="+" style="x"><char style="xo" closed="false">21:28 </char><char style="xt" closed="false"><ref loc="MAT 20:1">Mat 20:1</ref></char></note><char style="wj">chan rezen an.’” </char><verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>
    <char style="wj">“Li te reponn: ‘M p ap prale’. Men, apre li te regrèt sa, e li te ale.</char><verse eid="MAT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30"/>
    <char style="wj">“Nonm nan te rive kote dezyèm nan, e te di menm bagay la. Men li menm te reponn, e te di: Avozòd! Men li pa t ale. </char> <verse eid="MAT 21:30"/><verse number="31" style="v" sid="MAT 21:31"/><char style="wj">Kilès nan de fis sa yo ki te fè volonte a papa l?”</char></para>
  <para style="p" vid="MAT 21:31">Yo te reponn: “Premye a”.</para>
  <para style="p" vid="MAT 21:31">Jésus te di yo: <char style="wj">“Anverite, Mwen di nou ke</char> <note caller="+" style="x"><char style="xo" closed="false">21:31 </char><char style="xt" closed="false"><ref loc="LUK 7:29">Luc 7:29</ref>,<ref loc="LUK 7:37">37</ref></char></note><char style="wj">kolektè kontribisyon yo avèk fanm movèz vi yo va antre nan wayòm syèl la avan nou menm.</char> <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/><char style="wj">Paske Jean te vini a nou menm nan chemen ladwati, men nou pa t kwè li; men</char> <note caller="+" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">Luc 3:12</ref></char></note><char style="wj">kolektè kontribisyon yo avèk fanm movèz vi yo te kwè li.</char>. <char style="wj">Men nou menm ki te wè sa, nou pa t menm repanti lè l fin fèt pou nou ta kwè li.</char><verse eid="MAT 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>
    <char style="wj">“Koute yon lòt parabòl. Te gen yon mèt tè ki te plante yon chan rezen. Li te antoure li avèk yon miray. Li te fouye yon rezèvwa pou kraze rezen yo, e te bati yon tou ki wo. Li te antann demwatye ak kiltivatè yo, e te ale fè yon vwayaj.</char><verse eid="MAT 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 21:34"/>
    <char style="wj">“Lè lè rekòlt la te rive, li te</char> <note caller="+" style="x"><char style="xo" closed="false">21:34 </char><char style="xt" closed="false"><ref loc="MAT 22:3">Mat 22:3</ref></char></note><char style="wj">voye esklav li yo jwenn kiltivatè yo pou resevwa pwodwi pa li a.</char> <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/><char style="wj">Konsa, kiltivatè yo te pran esklav li yo, te bat youn, te touye yon lòt, e yo te kalonnen twazyèm lan avèk kout wòch.</char><verse eid="MAT 21:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 21:36"/>
    <char style="wj">“Ankò li</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:36 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:4">Mat 22:4</ref>
      </char>
    </note>
    <char style="wj">te voye yon lòt ekip esklav pi gran pase premye yo, e yo fè yo menm bagay la.</char><verse eid="MAT 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 21:37"/>
    <char style="wj">“Men anfen, li te voye fis li a. Li te di: ‘Y ap respekte fis mwen an.’</char> <verse eid="MAT 21:37"/><verse number="38" style="v" sid="MAT 21:38"/><char style="wj">Men lè kiltivatè yo te wè fis la, yo te di pami yo, ‘Sa se eritye a. Vini, annou touye li epi sezi eritaj li a.’</char> <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/><char style="wj">Konsa, yo te pran li, voye li deyò chan an e yo te touye li.”</char><verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>
    <char style="wj">“Akoz sa, lè mèt teren an vini, kisa l ap fè avèk kiltivatè sa yo?”</char><verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>Yo te di Li: “L ap mennen malveyan sa yo a yon move fen, epi li <note caller="+" style="x"><char style="xo" closed="false">21:41 </char><char style="xt" closed="false"><ref loc="MAT 8:11">Mat 8:11</ref></char></note>va lwe chan sa a bay lòt kiltivatè k ap peye li sa yo dwe yo nan pwòp lè yo.”<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>Jésus te di yo:</para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">“Èske nou pa janm li nan Ekriti Sen yo, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:42 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:22">Sòm 118:22</ref>
      </char>
    </note></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">‘Wòch ke sila ki t ap bati yo te rejte a, </char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">te devni wòch ang prensipal la. </char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">Sa te sòti nan Senyè a, e se te yon mèvèy nan zye nou.’?” </char><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>
    <char style="wj">“Akoz sa Mwen di nou: Wayòm syèl la ap vin pran nan men nou pou plase bay yon nasyon k ap pwodwi fwi li.</char> <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/><char style="wj">Epi</char> <note caller="+" style="x"><char style="xo" closed="false">21:44 </char><char style="xt" closed="false"><ref loc="ISA 8:14">És 8:14</ref>,<ref loc="ISA 8:15">15</ref></char></note><char style="wj">sila ki tonbe sou wòch sila ap kraze an mòso, men sou sila ke li tonbe a, l ap gaye li tankou poud.”</char><verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>Lè chèf prèt ak Farizyen yo te tande parabòl Li yo, yo te konprann ke Li t ap pale de yo menm. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>Lè yo te chèche mwayen sezi Li, yo te <note caller="+" style="x"><char style="xo" closed="false">21:46 </char><char style="xt" closed="false"><ref loc="MAT 21:26">Mat 21:26</ref></char></note>krent foul la paske yo te konsidere Li kon yon <note caller="+" style="x"><char style="xo" closed="false">21:46 </char><char style="xt" closed="false"><ref loc="MAT 21:11">Mat 21:11</ref></char></note>pwofèt.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>Ankò Jésus te reponn yo e pale ak yo an parabòl. Li te di: <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/><note caller="+" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="MAT 13:24">Mat 13:24</ref></char></note><char style="wj">“Wayòm syèl la tankou yon wa ki fè yon fèt maryaj pou fis li.</char> <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/><char style="wj">Li te</char> <note caller="+" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="MAT 21:34">Mat 21:34</ref></char></note><char style="wj">voye esklav li yo deyò pou rele sila yo ki te envite nan fèt maryaj la, men yo pa t dakò vini.</char><verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>
    <char style="wj">“Ankò li</char> <note caller="+" style="x"><char style="xo" closed="false">22:4 </char><char style="xt" closed="false"><ref loc="MAT 21:36">Mat 21:36</ref></char></note><char style="wj">voye lòt esklav pou di: “Gade, mwen prepare anpil manje. Bèf avèk anpil lòt bèt gra gen tan fin kòche. Tout bagay prè. Vini nan fèt maryaj la.</char><verse eid="MAT 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5"/>
    <char style="wj">“Men yo pa t okipe li. Yo fè wout yo. Youn ale nan chan li, yon lòt pou okipe afè l.</char> <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/><char style="wj">Konsa, rès yo te sezi esklav li yo, e te maltrete e touye yo.</char> <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/><char style="wj">Lè wa a tande sa a, li te anraje. Li te voye lame li pou te detwi tout asasen sa yo, e te mete dife nan vil pa yo.</char><verse eid="MAT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8"/>
    <char style="wj">“Apre, li te di a esklav li yo: ‘Maryaj la prepare, men sila ki te envite yo pa dign.</char> <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/><char style="wj">Pou sa, ale nan</char> <note caller="+" style="x"><char style="xo" closed="false">22:9 </char><char style="xt" closed="false"><ref loc="EZK 21:21">Éz 21:21</ref></char></note><char style="wj">gran wout yo, epi tout sila nou twouve la yo, envite yo nan fèt maryaj la.’</char><verse eid="MAT 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 22:10"/>
    <char style="wj">“Konsa, esklav sila yo te ale deyò nan lari yo pou te ranmase tout sa yo te twouve, ni mechan, ni bon, epi chan maryaj la te ranpli avèk moun envite yo. </char><verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>
    <char style="wj">“Men lè wa a te vini pou wè sila ki te vini yo, li twouve</char> <note caller="+" style="x"><char style="xo" closed="false">22:11 </char><char style="xt" closed="false"><ref loc="2KI 10:22">II Wa 10:22</ref></char></note><char style="wj">yon nonm ki pa abiye avèk vètman maryaj la.</char> <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/><char style="wj">Li te di li:</char> <note caller="+" style="x"><char style="xo" closed="false">22:12 </char><char style="xt" closed="false"><ref loc="MAT 20:13">Mat 20:13</ref></char></note> <char style="wj">‘Zanmi m, kijan ou fè antre isit la san vètman maryaj la?’ Moun nan pa t kab menm pale.</char><verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>
    <char style="wj">“Konsa, wa a te di a sèvitè yo: Mare men li avèk pye li, e jete li deyò nan</char> <note caller="+" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat 8:12</ref></char></note><char style="wj">fon tenèb. Nan plas sa a, va genyen gwo kriye avèk manje dan.</char> <verse eid="MAT 22:13"/><verse number="14" style="v" sid="MAT 22:14"/><char style="wj">Paske gen anpil moun k ap</char> <note caller="+" style="x"><char style="xo" closed="false">22:14 </char><char style="xt" closed="false"><ref loc="MAT 24:22">Mat 24:22</ref></char></note><char style="wj">resevwa apèl la, men pa anpil moun kap chwazi.”</char><verse eid="MAT 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:15 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 12:13-17">Mc 12:13-17</ref>
      </char>
    </note>Konsa, Farizyen yo te ale pran konsèy ansanm pou twouve kijan yo ta kab kenbe L nan pèlen pawòl ke Li te pale yo. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>Yo te voye disip pa yo ansanm avèk <note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="MRK 3:6">Mc 3:6</ref></char></note>Ewodyen yo. Yo te di: “Mèt, nou konnen ke Ou bay verite, e enstwi chemen Bondye a ak verite, san patipri, paske Ou pa pran pati a pèsòn. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Pou sa, di nou kisa Ou panse? Èske li pèmèt pou peye <note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="MAT 17:25">Mat 17:25</ref></char></note>taks a <note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="LUK 3:1">Luc 3:1</ref></char></note>César? Wi oubyen non?”<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>Men Jésus te konprann mechanste yo. Li te reponn: <char style="wj">“Poukisa nou ap tante M konsa? Ipokrit nou ye!</char> <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/><char style="wj">Montre M </char><note caller="+" style="x"><char style="xo" closed="false">22:19 </char><char style="xt" closed="false"><ref loc="MAT 17:25">Mat 17:25</ref></char></note><char style="wj">kòb ke nou sèvi pou peye taks la.” </char></para>
  <para style="p" vid="MAT 22:19">Yo te pote bay Li yon denye.<verse eid="MAT 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 22:20"/>
    <char style="wj">Li te mande yo: “Limaj avèk lenskripsyon a ki moun nou wè la a?”</char><verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>Yo reponn Li: “Se pou César”.</para>
  <para style="p" vid="MAT 22:21">Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">22:21 </char><char style="xt" closed="false"><ref loc="MRK 12:7">Mc 12:7</ref></char></note><char style="wj">“Ebyen, bay a César sa ki pou César, e bay Bondye sa ki pou Bondye.”</char><verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>Lè yo tande sa, yo te etone e yo te <note caller="+" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="MRK 12:12">Mc 12:12</ref></char></note>kite Li ale.<verse eid="MAT 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:23 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 12:18-27">Mc 12:18-27</ref>
      </char>
    </note>Nan menm jou sa a, kèk nan Sadiseyen yo (ki di pa gen rezirèksyon) te vin kote L pou poze L kesyon. <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>Yo te di: “Mèt, Moïse te di: <note caller="+" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Det 25:5</ref></char></note>‘Si yon nonm mouri, li pa gen pitit, frè li, nan fanmi ki pi prè a va marye avèk madanm li, pou l elve yon Pitit pou frè li.’ <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>Konsa, te gen sèt frè avèk nou. Premye a te marye. Li mouri san fè Pitit e li te kite madanm li pou frè l la. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>Konsa tou, dezyèm lan, twazyèm nan, jouk rive nan setyèm frè a. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>An dènye lye, fanm nan te mouri. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>Konsa nan rezirèksyon an, se madanm a kilès l ap ye? Paske yo tout te genyen l.”<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>Men Jésus te reponn yo: <char style="wj">“Nou twonpe nou. Nou </char><note caller="+" style="x"><char style="xo" closed="false">22:29 </char><char style="xt" closed="false"><ref loc="JHN 20:9">Jn 20:9</ref></char></note><char style="wj">pa konprann Ekriti Sen yo, ni pouvwa Bondye a.</char> <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/><char style="wj">Paske nan rezirèksyon an, yo</char> <note caller="+" style="x"><char style="xo" closed="false">22:30 </char><char style="xt" closed="false"><ref loc="MAT 24:38">Mat 24:38</ref></char></note><char style="wj">pa marye, ni bay moun nan maryaj, men se kon zanj nan syèl yo.</char> <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/><char style="wj">Men konsènan rezirèksyon mò yo, nou pa t li sa ki te pale a nou pa Bondye lè Li di nou:</char> <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/><note caller="+" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Egz 3:6</ref></char></note><char style="wj">‘Mwen menm se Bondye Abraham, Bondye Isaac, Bondye Jacob la’? Li menm pa Bondye a mò yo, men a sila ki vivan yo.”</char><verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>Lè foul la te tande sa, <note caller="+" style="x"><char style="xo" closed="false">22:33 </char><char style="xt" closed="false"><ref loc="MAT 7:28">Mat 7:28</ref></char></note>yo te etone de jan Li te enstwi a.<verse eid="MAT 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:25-37">Luc 10:25-37</ref>
      </char>
    </note>Men lè Farizyen yo te tande ke Li gen tan fè Sadiseyen yo sispann pale, yo te reyini ansanm.<verse eid="MAT 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 22:35"/>Youn nan yo, yon <note caller="+" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="LUK 7:30">Luc 7:30</ref></char></note>avoka, te kesyone L pou pase l a leprèv. <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>“Mèt, kilès nan kòmandman nan Lalwa a ki pi gran?” <verse eid="MAT 22:36"/><verse number="37" style="v" sid="MAT 22:37"/>Li te reponn li: <note caller="+" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">Det 6:5</ref></char></note><char style="wj">“‘Ou va renmen Senyè a, Bondye ou avèk tout kè ou, avèk tout nanm ou, e avèk tout lespri ou’.</char><verse eid="MAT 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 22:38"/>
    <char style="wj">“Sa se premye e pi gran kòmandman an.</char> <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/><char style="wj">Dezyèm nan se parèy a li menm: </char><note caller="+" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lev 19:18</ref></char></note><char style="wj">‘Ou va renmen vwazen ou tankou tèt ou’.</char><verse eid="MAT 22:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 22:40"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:40 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:12">Mat 7:12</ref>
      </char>
    </note>
    <char style="wj">“Sou de kòmandman sa yo depann tout Lalwa, avèk pwofèt yo.”</char><verse eid="MAT 22:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:41 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 12:35-37">Mc 12:35-37</ref>
      </char>
    </note>Alò, pandan Farizyen yo te ansanm, Jésus te poze yo yon kesyon. <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>Li te mande yo: <char style="wj">“Kisa nou panse de Kris la? Se Fis a kilès Li ye?” </char></para>
  <para style="p" vid="MAT 22:42">Yo te reponn Li: <note caller="+" style="x"><char style="xo" closed="false">22:42 </char><char style="xt" closed="false"><ref loc="MAT 9:27">Mat 9:27</ref></char></note>“Fis a David la”.<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>Li te di yo: <char style="wj">“Ebyen, ki jan konsa ke nan Lespri a, David te rele Li ‘Senyè’ lè li te di: </char><verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:44 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 12:34">Mc 12:34</ref>
      </char>
    </note>
    <char style="wj">“SENYÈ a di a Senyè mwen an,</char></para>
  <para style="q1" vid="MAT 22:44">
    <char style="wj">‘Chita sou men dwat Mwen,</char></para>
  <para style="q1" vid="MAT 22:44">
    <char style="wj">jouk lè Mwen mete lènmi ou yo anba pye ou’?</char><verse eid="MAT 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45"/>
    <char style="wj">“Si David li menm rele Li ‘Senyè’, kijan Li fè kapab Pitit Li?”</char><verse eid="MAT 22:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46"/>Pèsòn pa t kapab reponn Li yon mo, <note caller="+" style="x"><char style="xo" closed="false">22:46 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Sòm 110:1</ref></char></note>ni yo pa t tante mande Li anyen depi jou sa a.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Alò, Jésus te pale avèk foul la ak disip Li yo <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">23:2 </char><char style="xt" closed="false"><ref loc="DEU 33:3">Det 33:3</ref></char></note><char style="wj">“Skrib yo avèk Farizyen yo gen tan chita nan chèz Moïse la.</char> <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/><char style="wj">Pou sa, tout sa yo mande nou fè ak swiv, fè l. Men pa swiv zak yo, paske yo pale bagay sa yo, men yo pa fè yo.</char> <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/><note caller="+" style="x"><char style="xo" closed="false">23:4 </char><char style="xt" closed="false"><ref loc="LUK 11:46">Luc 11:46</ref></char></note><char style="wj">Yo mare gwo chaj e mete yo sou zepòl a moun; men yo menm, yo p ap leve menm yon dwèt pou ede yo.</char><verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>
    <char style="wj">“Men yo fè tout zak pa yo pou moun kapab wè. Yo </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:5 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:9">Egz 13:9</ref>
      </char>
    </note>
    <char style="wj">agrandi filaktè pa yo (ti bwat ki pote woulo avèk Ekriti Sen yo ekri ladann) e fè ganiti (alonj ki fèt ak kòd) arebò vètman yo vin pi long.</char> <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/><char style="wj">Yo</char> <note caller="+" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="LUK 11:43">Luc 11:43</ref></char></note><char style="wj">renmen plas onè nan resepsyon yo, avèk plas ki pi enpòtan nan sinagòg yo,</char> <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/><char style="wj">ak salitasyon ki plen respè nan mache yo, e pou tout moun rele yo</char> <note caller="+" style="x"><char style="xo" closed="false">23:7 </char><char style="xt" closed="false"><ref loc="MAT 23:8">Mat 23:8</ref></char></note> <char style="wj">‘Rabbi’ (Mèt).</char><verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>
    <char style="wj">“Men pa kite yo rele nou</char> <note caller="+" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 23:7">Mat 23:7</ref></char></note><char style="wj">‘Rabbi’, paske se yon sèl ki Mèt nou, e nou tout se frè nou ye. </char> <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/><char style="wj">Epi pa rele pèsòn sou latè ‘papa’, paske se</char> <note caller="+" style="x"><char style="xo" closed="false">23:9 </char><char style="xt" closed="false"><ref loc="MAT 6:9">Mat 6:9</ref></char></note><char style="wj">yon sèl ki Papa nou; Sila ki nan syèl la.</char> <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/><char style="wj">Ni pa kite yo rele nou Direktè, paske nou gen yon sèl Direktè; se Kris la.</char><verse eid="MAT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 23:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 20:26">Mat 20:26</ref>
      </char>
    </note>
    <char style="wj">“Men pi gran pami nou an va vin sèvitè nou.</char> <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/><note caller="+" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">Luc 14:11</ref></char></note><char style="wj">Konsa, sila ki pran wo plas yo ap desann, e sila ki desann tèt yo ap vin gen yon wo plas.</char><verse eid="MAT 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>
    <char style="wj">“Men malè a nou menm Skrib yo avèk Farizyen yo! Ipokrit nou ye! Paske</char> <note caller="+" style="x"><char style="xo" closed="false">23:13 </char><char style="xt" closed="false"><ref loc="MRK 12:40">Mc 12:40</ref></char></note><char style="wj">nou devore kay vèv yo menm lè nou pretann n ap fè lapriyè long; pou sa, nou ap resevwa yon pi gwo kondanasyon.</char> <verse eid="MAT 23:13"/><verse number="14" style="v" sid="MAT 23:14"/><char style="wj">“Malè a nou menm Skrib ak Farizyen yo! Ipokrit! </char><note caller="+" style="x"><char style="xo" closed="false">23:14 </char><char style="xt" closed="false"><ref loc="LUK 11:52">Luc 11:52</ref></char></note><char style="wj">Paske nou bloke wayòm syèl la kont moun. Nou p ap antre nou menm, ni nou pa kite sila k ap antre yo ale ladann.</char><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>
    <char style="wj">“Malè a nou menm Skrib ak Farizyen yo; ipokrit nou ye! Paske nou travèse tout latè avèk lanmè pou fè</char> <note caller="+" style="x"><char style="xo" closed="false">23:15 </char><char style="xt" closed="false"><ref loc="ACT 2:10">Trav 2:10</ref></char></note><char style="wj">yon sèl disip; e lè nou fè l, li vini de fwa plis fis lanfè ke nou menm.</char><verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>
    <char style="wj">“Malè a nou menm,</char> <note caller="+" style="x"><char style="xo" closed="false">23:16 </char><char style="xt" closed="false"><ref loc="MAT 15:14">Mat 15:14</ref></char></note><char style="wj">gid ki avèg! Ki di: ‘Sila ki sèmante sou tanp lan, sa pa anyen, men sila ki sèmante sou lò a tanp lan, se oblije.’ </char> <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/><char style="wj">Bann sòt ak moun avèg!</char> <note caller="+" style="x"><char style="xo" closed="false">23:17 </char><char style="xt" closed="false"><ref loc="EXO 30:29">Egz 30:29</ref></char></note><char style="wj">Kisa ki pi gran? Lò a, oubyen tanp lan ki sanktifye lò a?</char><verse eid="MAT 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 23:18"/>
    <char style="wj">“Epi ‘Sila ki sèmante sou lotèl la, sa pa anyen; men sila ki sèmante sou ofrann ki sou lotèl la, li oblije’.</char> <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/><char style="wj">Moun avèg! </char> <note caller="+" style="x"><char style="xo" closed="false">23:19 </char><char style="xt" closed="false"><ref loc="EXO 29:37">Egz 29:37</ref></char></note> <char style="wj">Kilès ki pi enpòtan, ofrann sou lotèl la, oubyen lotèl la ki sanktifye lofrann nan?</char><verse eid="MAT 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 23:20"/>
    <char style="wj">“Pou sa, sila ki sèmante sou lotèl la, sèmante ni sou li, ni sou tout bagay ki sou li.</char> <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/><char style="wj">Epi sila ki sèmante sou tanp lan, sèmante non sèlman sou tanp lan, men osi sou Sila ki</char> <note caller="+" style="x"><char style="xo" closed="false">23:21 </char><char style="xt" closed="false"><ref loc="1KI 8:13">I Wa 8:13</ref></char></note><char style="wj">rete ladann nan.</char> <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/><char style="wj">Epi sila ki sèmante sou syèl la,</char> <note caller="+" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">És 66:1</ref></char></note><char style="wj">sèmante non sèlman sou twòn Bondye a, men sou Sila ki chita ladann nan.</char><verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:13">Mat 23:13</ref>
      </char>
    </note>
    <char style="wj">“Malè a nou menm, Skrib ak Farizyen yo, ipokrit! Paske nou bay ladim nan mant, ani, avèk pèsi (yon kalite epis) men nou neglije pòsyon Lalwa ki pote plis pwa yo; lajistis, mizerikòd, ak fidelite. Men bagay sa yo nou dwe fè yo san neglije lòt yo. </char> <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/><char style="wj">Nou menm,</char> <note caller="+" style="x"><char style="xo" closed="false">23:24 </char><char style="xt" closed="false"><ref loc="MAT 23:16">Mat 23:16</ref></char></note><char style="wj">gid ki avèg, ki sèvi ak yon paswa pou retire mouch, men nou vale yon chamo!</char><verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>
    <char style="wj">“Malè a nou menm Skrib ak Farizyen yo, ipokrit!</char> <note caller="+" style="x"><char style="xo" closed="false">23:25 </char><char style="xt" closed="false"><ref loc="MRK 7:4">Mc 7:4</ref></char></note><char style="wj">Nou netwaye deyò tas la ak plato a, men anndan yo plen avèk bann vòlè k ap peze souse ak mechanste pou achevi tout bezwen pèsonèl yo.</char> <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/><char style="wj">Nou menm, Farizyen ki avèg yo; premyèman,</char> <note caller="+" style="x"><char style="xo" closed="false">23:26 </char><char style="xt" closed="false"><ref loc="MRK 7:4">Mc 7:4</ref></char></note><char style="wj">netwaye anndan tas la ak plato a, pou deyò li kapab vin pwòp tou.</char><verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:27 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 11:44">Luc 11:44</ref>
      </char>
    </note>
    <char style="wj">“Malè a nou menm, Skrib ak Farizyen yo, ipokrit! Paske nou tankou tonm ki blanchi deyò pou parèt bèl, men anndan yo ranpli avèk zo mò ak tout kalite pouriti.</char> <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/><char style="wj">Menm jan an, nou menm tou, nou gen aparans ladwati, men anndan nou ranpli avèk ipokrizi ak linikite.</char><verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:29 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 11:47">Luc 11:47</ref>
      </char>
    </note>
    <char style="wj">“Malè a nou menm Skrib ak Farizyen yo, ipokrit! Nou bati tonm pou pwofèt yo e dekore moniman a sila ki te jis yo,</char> <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/><char style="wj">epi di: ‘Si nou te viv nan jou zansèt nou yo, nou pa t ap ede yo vèse san a pwofèt yo’.</char> <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/><char style="wj">An konsekans, nou temwaye kont pwòp tèt pa nou; ke nou menm</char> <note caller="+" style="x"><char style="xo" closed="false">23:31 </char><char style="xt" closed="false"><ref loc="MAT 23:34-37">Mat 23:34-37</ref></char></note><char style="wj">se fis a moun ki te touye pwofèt yo.</char><verse eid="MAT 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 23:32"/>
    <char style="wj">“Konsa, ranpli mezi koupabilite nou, menm jan tankou zansèt nou yo te fè a.</char> <verse eid="MAT 23:32"/><verse number="33" style="v" sid="MAT 23:33"/><char style="wj">Bann sèpan,</char> <note caller="+" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mat 3:7</ref></char></note><char style="wj">nich ranpli ak koulèv; kijan pou nou ta kapab chape de chatiman lanfè a?</char><verse eid="MAT 23:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 23:34"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:34-36">Mat 23:34-36</ref>
      </char>
    </note>
    <char style="wj">“Pou sa, gade, Mwen ap voye bannou pwofèt ak moun saj, ak Skrib yo. Kèk nan yo, nou va touye e krisifye. Kèk nan yo, nou ap bay kout fwèt nan sinagòg nou yo, e pèsekite yo soti nan yon vil jiska yon lòt,</char> <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/><char style="wj">pou sa rive ke sou nou kapab tonbe koupabilite pou tout san ki te vèse sou latè yo, kòmanse avèk Abel ki te jis, pou rive jouk nan san Zacharie, </char> <note caller="+" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="ZEC 1:1">Za 1:1</ref></char></note> <char style="wj">fis a Barachie a, ke nou te</char> <note caller="+" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="2CH 24:21">II Kwo 24:21</ref></char></note><char style="wj">asasine antre tanp lan ak lotèl la. </char><verse eid="MAT 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 23:36"/>
    <char style="wj">“Anverite, Mwen di nou ke tout bagay sa yo ap rive sou</char> <note caller="+" style="x"><char style="xo" closed="false">23:36 </char><char style="xt" closed="false"><ref loc="MAT 10:23">Mat 10:23</ref></char></note><char style="wj">jenerasyon sila a. </char><verse eid="MAT 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>
    <char style="wj">“O</char> <note caller="+" style="x"><char style="xo" closed="false">23:37 </char><char style="xt" closed="false"><ref loc="LUK 13:34-35">Luc 13:34-35</ref></char></note><char style="wj">Jérusalem, Jérusalem, ki touye pwofèt yo e asasine sila ki te voye a li menm yo avèk kout wòch! Konbyen fwa Mwen te vle rasanble nou ansanm, kon yon poul rasanble pitit li anba zèl li, men nou pa t vle. </char><verse eid="MAT 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 23:38"/>
    <char style="wj">“Gade byen,</char> <note caller="+" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="1KI 9:7">I Wa 9:7</ref></char></note><char style="wj">lakay nou rete nan men nou dezole nèt.</char> <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/><char style="wj">Paske Mwen di nou: Depi koulye a, nou p ap wè M jiskaske nou di: </char> <note caller="+" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Sòm 118:26</ref></char></note><char style="wj">‘Beni se Sila ki vini nan non Senyè a.’”</char><verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:1 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 13">Mc 13</ref>
      </char>
    </note>Jésus te sòti nan tanp lan e t ap fè wout Li. Disip Li yo te vini pou montre Li bèl konstriksyon tanp lan. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>Men Li te di yo: <char style="wj">“Konsa, nou wè tout bagay sa yo? Anverite, Mwen di nou ke</char> <note caller="+" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="LUK 19:44">Luc 19:44</ref></char></note><char style="wj">pa menm yon wòch isit la ap rete sou youn lòt ki p ap jete dekonble nèt.” </char><verse eid="MAT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>Pandan Li t ap chita sou <note caller="+" style="x"><char style="xo" closed="false">24:3 </char><char style="xt" closed="false"><ref loc="MAT 21:1">Mat 21:1</ref></char></note>Mòn Oliv la, disip Li yo te vin kote Li an prive. Yo te mande L: “Di nou kilè bagay sa yo ap rive, e ki sign k ap fè nou konnen ke Ou ap vini, e k ap enfòme nou sou fen tan yo?”<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>Jésus te reponn yo: <char style="wj">“Fè atansyon pou pèsòn pa kondwi nou nan erè!”</char> <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/><char style="wj">Konsa,</char> <note caller="+" style="x"><char style="xo" closed="false">24:5 </char><char style="xt" closed="false"><ref loc="MAT 24:11-24">Mat 24:11-24</ref></char></note><char style="wj">anpil moun ap vini nan non Mwen k ap di: ‘Se Mwen ki Kris La’, e yo va kondwi anpil moun nan erè. </char><verse eid="MAT 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 24:6"/>
    <char style="wj">“Nou va tande afè</char> <note caller="+" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="REV 4:6">Rev 4:6</ref></char></note><char style="wj">lagè, avèk bwi ki pale sou lagè, men fè atansyon pou nou pa pè. Fòk bagay sa yo rive, men sa se pa lafen an.</char> <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/><char style="wj">Paske </char><note caller="+" style="x"><char style="xo" closed="false">24:7 </char><char style="xt" closed="false"><ref loc="2CH 15:6">II Kwo 15:6</ref></char></note><char style="wj">nasyon ap leve kont nasyon, epi wayòm kont wayòm. Nan plizyè andwa, va gen gwo grangou avèk tranbleman de tè yo.</char> <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/><note caller="+" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="MAT 24:8-20">Mat 24:8-20</ref></char></note><char style="wj">Men tout bagay sa yo se sèlman kòmansman an; tankou premye doulè a fanm k ap akouche a.</char><verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:17">Mat 10:17</ref>
      </char>
    </note>
    <char style="wj">“Epi konsa yo va livre nou nan touman, e yo va touye nou.</char> <note caller="+" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat 10:22</ref></char></note><char style="wj">Nou va rayi pa tout nasyon yo pou koz a non Mwen.</char><verse eid="MAT 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 24:10"/>
    <char style="wj">“Konsa, nan tan sa a, anpil moun ap </char> <note caller="+" style="x"><char style="xo" closed="false">24:10 </char><char style="xt" closed="false"><ref loc="MAT 11:6">Mat 11:6</ref></char></note> <char style="wj">chite. Youn ap denonse lòt, e youn ap rayi lòt.</char> <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/><char style="wj">Epi anpil</char> <note caller="+" style="x"><char style="xo" closed="false">24:11 </char><char style="xt" closed="false"><ref loc="MAT 7:15">Mat 7:15</ref></char></note><char style="wj">fo pwofèt ap leve, e y ap mennen anpil moun nan erè.</char> <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/><char style="wj">Epi akoz inikite ogmante, lanmou a pi fò moun ap vin fwèt.</char> <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/><note caller="+" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat 10:22</ref></char></note><char style="wj">Men sila ki kenbe fèm jiska lafen an ap sove.</char><verse eid="MAT 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 24:14"/>
    <char style="wj">“Epi</char> <note caller="+" style="x"><char style="xo" closed="false">24:14 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note><char style="wj">bòn nouvèl a wayòm sila a va preche nan tout</char> <note caller="+" style="x"><char style="xo" closed="false">24:14 </char><char style="xt" closed="false"><ref loc="LUK 4:5">Luc 4:5</ref></char></note><char style="wj">lemonn kon yon temwayaj a tout nasyon yo, e apre sa a, lafen an va rive.</char><verse eid="MAT 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>
    <char style="wj">“Pou sa, kon pwofèt Daniel te pale a, lè nou wè</char> <note caller="+" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">Dan 9:27</ref></char></note><char style="wj">abominasyon dezolasyon an ki te pale pa Daniel, pwofèt la, k ap kanpe nan lye sen an,</char> (kite moun k ap li a konprann) <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/><char style="wj">nan moman sa a kite sila nan Judée yo sove pou ale nan mòn yo.</char> <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/><char style="wj">Nenpòt moun ki</char> <note caller="+" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="1SA 9:25">I Sam 9:25</ref></char></note><char style="wj">anwo kay la pa dwe desann pou pran byen li nan kay li,</char> <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/><char style="wj">ni nenpòt moun ki nan chan an pa dwe retounen pou pran rad li. </char> <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/><char style="wj">Men</char> <note caller="+" style="x"><char style="xo" closed="false">24:19 </char><char style="xt" closed="false"><ref loc="LUK 23:29">Luc 23:29</ref></char></note><char style="wj">malè a sila ki ansent yo e a sila k ap bay pitit yo tete nan jou sa yo!</char><verse eid="MAT 24:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 24:20"/>
    <char style="wj">“Men priye pou ou pa oblije sove ale nan livè, ni nan yon jou Saba,</char> <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/><char style="wj">paske nan tan sa a, ap gen yon</char> <note caller="+" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="DAN 12:1">Dan 12:1</ref></char></note><char style="wj">gwo tribilasyon yon jan ki pa janm fèt depi nan kòmansman mond lan, jouk rive koulye a, ni p ap janm genyen ankò.</char> <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/><char style="wj">Konsa, si jou sa yo pa t rakousi, pa t ap gen vi ki t ap sove. Men pou</char> <note caller="+" style="x"><char style="xo" closed="false">24:22 </char><char style="xt" closed="false"><ref loc="MAT 22:14">Mat 22:14</ref></char></note><char style="wj">lakoz a sila ki chwazi yo, y ap rakousi.</char><verse eid="MAT 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:23 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:23">Luc 17:23</ref>
      </char>
    </note>
    <char style="wj">“Nan lè sa a, si yon moun di nou: ‘Gade, men Kris la isit la’, oubyen ‘Men Li la’, pa kwè li.</char> <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/><char style="wj">Paske fo Kris yo ak fo pwofèt yo ap prezante e montre gwo </char><note caller="+" style="x"><char style="xo" closed="false">24:24 </char><char style="xt" closed="false"><ref loc="JHN 4:48">Jn 4:48</ref></char></note><char style="wj">sign avèk mirak pou yo ta kab, si li te posib, redwi nan erè menm</char> <note caller="+" style="x"><char style="xo" closed="false">24:24 </char><char style="xt" closed="false"><ref loc="MAT 22:14">Mat 22:14</ref></char></note><char style="wj">sila ki eli yo.</char> <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/><char style="wj">Veye, Mwen avèti nou davans.</char><verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>
    <char style="wj">“Si yo di nou ‘Men Li nan dezè a’ pa ale la; oubyen ‘Gade la, Li la nan chanm pa anndan an, pa kwè yo.</char> <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/><note caller="+" style="x"><char style="xo" closed="false">24:27 </char><char style="xt" closed="false"><ref loc="LUK 17:24">Luc 17:24</ref></char></note><char style="wj">Paske menm jan ke kout eklè a sòti nan lès pou klere jouk rive nan lwès, konsa n ap wè vini Fis a Lòm nan.</char> <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/><note caller="+" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="JOB 39:30">Job 39:30</ref></char></note><char style="wj">Nenpòt kote kadav la ye, se la ou va twouve votou yo.</char><verse eid="MAT 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>
    <char style="wj">“Men imedyatman apre tribilasyon nan jou sa yo,</char> <note caller="+" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">És 13:10</ref></char></note><char style="wj">solèy la va vin nwa. Lalin lan p ap bay limyè, zetwal yo va tonbe sòti nan syèl la, e pouvwa syèl yo va souke. </char><verse eid="MAT 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30"/>
    <char style="wj">“Epi nan moman sa a,</char> <note caller="+" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="MAT 24:3">Mat 24:3</ref></char></note><char style="wj">sign a Fis a Lòm nan va parèt nan syèl la, e tout tribi sou tè a va kriye avèk doulè, paske yo va wè</char> <note caller="+" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7:13</ref></char></note><char style="wj">Fis a Lòm nan vini sòti sou nyaj syèl yo avèk pouvwa ak gran glwa,</char> <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/><char style="wj">epi Li va voye zanj Li avèk</char> <note caller="+" style="x"><char style="xo" closed="false">24:31 </char><char style="xt" closed="false"><ref loc="EXO 19:16">Egz 19:16</ref></char></note><char style="wj">yon gwo twonpèt, e yo va rasanble ansanm ak sila ki eli yo, ki sòti nan kat van yo, sòti nan yon pwent syèl la ale nan lòt pwent lan.</char><verse eid="MAT 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>
    <char style="wj">“Koulye a, vin konprann parabòl a pye fig frans lan: lè branch li vin vèt, e prezante fèy, nou konnen ke gran sezon chalè a rive sou nou. </char> <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/><char style="wj">Ou menm tou, lè nou wè tout bagay sa yo, rekonèt ke Li pwòch,</char> <note caller="+" style="x"><char style="xo" closed="false">24:33 </char><char style="xt" closed="false"><ref loc="JAS 5:9">Jc 5:9</ref></char></note><char style="wj">Li parèt menm nan pòt la.</char><verse eid="MAT 24:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 24:34"/>
    <char style="wj">“Anverite, Mwen di nou: </char> <note caller="+" style="x"><char style="xo" closed="false">24:34 </char><char style="xt" closed="false"><ref loc="MAT 10:23">Mat 10:23</ref></char></note> <char style="wj">Jenerasyon sila a p ap disparèt jouk lè ke tout bagay sa yo fin pase. </char> <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/><note caller="+" style="x"><char style="xo" closed="false">24:35 </char><char style="xt" closed="false"><ref loc="MAT 5:18">Mat 5:18</ref></char></note><char style="wj">Syèl la avèk tè a va disparèt, men pawòl pa M yo p ap janm disparèt. </char> <verse eid="MAT 24:35"/><verse number="36" style="v" sid="MAT 24:36"/><char style="wj">Men</char> <note caller="+" style="x"><char style="xo" closed="false">24:36 </char><char style="xt" closed="false"><ref loc="MRK 13:32">Mc 13:32</ref></char></note><char style="wj">konsènan jou sa a, avèk lè sa a, pèsòn pa konnen, pa menm zanj nan syèl yo, ni Fis la, men sèl Papa a.</char><verse eid="MAT 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 24:37"/>
    <char style="wj">“Paske vini a Fis a Lòm nan va</char> <note caller="+" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5">Jen 6:5</ref></char></note><char style="wj">menm jan avèk jou a Noé yo.</char> <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/><char style="wj">Paske menm jan ke jou yo te ye avan gwo delij la, yo t ap manje e bwè; yo t ap </char><note caller="+" style="x"><char style="xo" closed="false">24:38 </char><char style="xt" closed="false"><ref loc="MAT 22:30">Mat 22:30</ref></char></note><char style="wj">marye, e t ap bay moun nan maryaj, jouk jou ke</char> <note caller="+" style="x"><char style="xo" closed="false">24:38 </char><char style="xt" closed="false"><ref loc="GEN 7:7">Jen 7:7</ref></char></note><char style="wj">Noé te antre nan lach la.</char> <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/><char style="wj">Epi yo pa t konprann jiskaske delij la te vini e pote yo tout ale; konsa l ap ye avèk </char><note caller="+" style="x"><char style="xo" closed="false">24:39 </char><char style="xt" closed="false"><ref loc="MAT 16:27">Mat 16:27</ref></char></note><char style="wj">vini a Fis a Lòm nan.</char><verse eid="MAT 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 24:40"/>
    <char style="wj">“Nan moman sa a, ap gen de mesyè nan yon chan; youn ap prale; lòt la ap rete.</char> <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/><note caller="+" style="x"><char style="xo" closed="false">24:41 </char><char style="xt" closed="false"><ref loc="LUK 17:35">Luc 17:35</ref></char></note><char style="wj">De fanm k ap moulen nan moulen an; youn ap prale, lòt la ap rete.</char><verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>
    <char style="wj">“Pou sa, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:42 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43-44">Mat 24:43-44</ref>
      </char>
    </note> <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/><char style="wj">men konnen byen yon bagay; </char><note caller="+" style="x"><char style="xo" closed="false">24:43 </char><char style="xt" closed="false"><ref loc="LUK 12:39">Luc 12:39</ref></char></note><char style="wj">si mèt kay la te konnen a</char> <note caller="+" style="x"><char style="xo" closed="false">24:43 </char><char style="xt" closed="false"><ref loc="MRK 13:35">Mc 13:35</ref></char></note><char style="wj">kilè nan nwit lan vòlè a t ap parèt, li t ap veye plis, e pa t ap kite kay la kase.</char> <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/><char style="wj">Pou rezon sa a,</char> <note caller="+" style="x"><char style="xo" closed="false">24:44 </char><char style="xt" closed="false"><ref loc="MAT 24:42">Mat 24:42</ref>,<ref loc="MAT 24:43">43</ref></char></note><char style="wj">fòk nou menm, nou byen prepare tou. Paske Fis a Lòm nan ap vini nan yon lè ke nou pa sipoze.</char><verse eid="MAT 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:45 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:42-46">Luc 12:42-46</ref>
      </char>
    </note>
    <char style="wj">“Kilès, konsa, ki se esklav fidèl e rezonab ke mèt la te mete responsab tout lakay li, pou bay yo manje nan lè ke yo bezwen? </char> <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/><char style="wj">Beni se esklav k ap fè sa lè mèt li vini an.</char> <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/><char style="wj">Anverite Mwen di nou ke</char> <note caller="+" style="x"><char style="xo" closed="false">24:47 </char><char style="xt" closed="false"><ref loc="MAT 25:21-23">Mat 25:21-23</ref></char></note><char style="wj">l ap mete li kòm chèf sou tout byen li yo.</char><verse eid="MAT 24:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 24:48"/>
    <char style="wj">“Men si esklav mechan sa a di nan kè li, ‘Mèt mwen p ap vini pandan anpil jou’,</char> <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/><char style="wj">epi li kòmanse bat esklav parèy li yo, manje e bwè avèk moun sou yo,</char> <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/><char style="wj">mèt a esklav sa a ap vini nan yon jou ke li pa t panse, e nan yon lè ke li pa t konnen,</char> <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/><char style="wj">epi li va koupe li an mòso e bay li yon plas avèk ipokrit yo. Se la, y ap gen </char> <note caller="+" style="x"><char style="xo" closed="false">24:51 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat 8:12</ref></char></note> <char style="wj">kriye avèk manje dan.”</char><verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:24">Mat 13:24</ref>
      </char>
    </note>
    <char style="wj">“Konsa, Wayòm syèl la tankou dis vyèj ki te pran</char> <note caller="+" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="ACT 20:8">Trav 20:8</ref></char></note><char style="wj">lanp yo pou soti e rankontre jennonm k ap marye a.</char> <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/><char style="wj">Senk nan yo te manke sajès, men lòt senk yo te </char><note caller="+" style="x"><char style="xo" closed="false">25:2 </char><char style="xt" closed="false"><ref loc="MAT 7:24">Mat 7:24</ref></char></note><char style="wj">gen bon konprann.</char> <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/><char style="wj">Lè sila ki manke sajès yo te pran lanp yo, yo pa t pran lwil avèk yo. </char> <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/><char style="wj">Men </char><note caller="+" style="x"><char style="xo" closed="false">25:4 </char><char style="xt" closed="false"><ref loc="MAT 7:24">Mat 7:24</ref></char></note><char style="wj">saj yo te pran lwil nan veso ansanm avèk lanp yo. </char> <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/><char style="wj">Konsa, pandan jennonm nan t ap pran reta, yo tout te vin fatige, e dòmi te pran yo.</char><verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>
    <char style="wj">“Men a minwi, te gen yon gwo kri: ‘Men gade, jennonm k ap marye a parèt! Vin rankontre li.’ </char><verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>
    <char style="wj">“Alò, tout vyèj sa yo te leve pou prepare lanp pa yo.</char> <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/><char style="wj">Men sila ki pa t saj yo te di a sila ki te pridan yo: ‘Bannou kèk nan lwil pa nou an, paske lanp nou yo ap etenn.’</char><verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>
    <char style="wj">“Men</char> <note caller="+" style="x"><char style="xo" closed="false">25:9 </char><char style="xt" closed="false"><ref loc="MAT 7:24">Mat 7:24</ref></char></note><char style="wj">saj yo te reponn: ‘Non, pwiske si nou fè sa, nou p ap rete kont pou nou. Pito nou ale kote machann pou nou achte pou tèt nou.’</char><verse eid="MAT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10"/>
    <char style="wj">“Konsa, pandan yo t ap pral achte, jennonm nan te vin parèt e sila ki te </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:42">Mat 24:42</ref>
      </char>
    </note>
    <char style="wj">prepare yo te antre avè l</char> <note caller="+" style="x"><char style="xo" closed="false">25:10 </char><char style="xt" closed="false"><ref loc="LUK 12:35">Luc 12:35</ref></char></note><char style="wj">nan fèt maryaj la. Epi pòt la te vin fèmen.</char><verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>
    <char style="wj">“Pita lòt vyèj yo te vini. Yo te di: </char> <note caller="+" style="x"><char style="xo" closed="false">25:11 </char><char style="xt" closed="false"><ref loc="MAT 7:2">Mat 7:2</ref></char></note> <char style="wj">‘Senyè, Senyè, louvri pòt la pou nou.</char><verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>
    <char style="wj">“Men li te reponn yo konsa: ‘Anverite mwen di nou, mwen pa rekonèt nou.’ </char><verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>
    <char style="wj">“Pou sa,</char> <note caller="+" style="x"><char style="xo" closed="false">25:13 </char><char style="xt" closed="false"><ref loc="MAT 24:42">Mat 24:42</ref></char></note><char style="wj">fè atansyon, paske nou pa konnen ni jou, ni lè.</char><verse eid="MAT 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 25:14-30">Mat 25:14-30</ref>
      </char>
    </note>
    <char style="wj">“Konsa, li menm jan avèk yon nonm ki fenk pare pou fè yon vwayaj. Li rele esklav li yo, e konfye tout sa li posede nan men yo menm.</char> <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/><char style="wj">A youn li te bay senk talan (yon gwo sòm dajan) a yon lòt de, e a yon lòt, youn, selon kapasite ke chak te genyen. Epi li te</char> <note caller="+" style="x"><char style="xo" closed="false">25:15 </char><char style="xt" closed="false"><ref loc="MAT 21:33">Mat 21:33</ref></char></note><char style="wj">sòti pou fè vwayaj la.</char> <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/><char style="wj">Imedyatman, sila ki te resevwa senk </char><note caller="+" style="x"><char style="xo" closed="false">25:16 </char><char style="xt" closed="false"><ref loc="MAT 18:24">Mat 18:24</ref></char></note><char style="wj">talan yo te fè afè avèk yo, e te ranmase yon lòt senk talan anplis. </char> <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/><char style="wj">“Menm jan an, sila ki te resevwa de talan yo te vin jwenn de lòt.</char> <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/><char style="wj">Men sila ki te resevwa yon sèl talan an te ale fouye yon twou nan tè pou te sere lajan mèt li.</char><verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>
    <char style="wj">“Apre anpil tan, mèt a esklav sa yo te vini pou te </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:23">Mat 18:23</ref>
      </char>
    </note>
    <char style="wj">regle kont avèk yo.</char> <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/><char style="wj">Sila ki te resevwa senk</char> <note caller="+" style="x"><char style="xo" closed="false">25:20 </char><char style="xt" closed="false"><ref loc="MAT 18:24">Mat 18:24</ref></char></note><char style="wj">talan yo te vin pote li avèk yon lòt senk talan ankò, epi te di: ‘Mèt, ou te fè m konfyans ak senk talan. Ou wè, mwen fè l rapòte senk talan anplis.’</char><verse eid="MAT 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21"/>
    <char style="wj">“Mèt li te di li: ‘Byen fèt, bon e fidèl sèvitè. Ou te fidèl avèk yon ti kras bagay. M ap</char> <note caller="+" style="x"><char style="xo" closed="false">25:21 </char><char style="xt" closed="false"><ref loc="LUK 12:44">Luc 12:44</ref></char></note><char style="wj">fè ou responsab anpil bagay. Antre nan lajwa a mèt ou.’</char><verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>
    <char style="wj">“Sila ki te resevwa de</char> <note caller="+" style="x"><char style="xo" closed="false">25:22 </char><char style="xt" closed="false"><ref loc="MAT 18:24">Mat 18:24</ref></char></note><char style="wj">talan yo te vini epi te di: ‘Mèt, ou te fè m konfyans ak de talan. Ou wè, mwen fè l rapòte de talan anplis.’ </char><verse eid="MAT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23"/>
    <char style="wj">“Mèt li te di li: ‘Byen fèt, bon sèvitè </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:45">Mat 24:45</ref>,<ref loc="MAT 24:47">47</ref></char>
    </note> <char style="wj">fidèl la. Ou te fidèl avèk yon ti kras bagay. M ap fè ou responsab anpil bagay. Antre nan lajwa a mèt ou.’</char><verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>
    <char style="wj">“Konsa, sila osi ki te resevwa yon sèl </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:24">Mat 18:24</ref>
      </char>
    </note>
    <char style="wj">talan an te vini e te di: ‘Mèt, mwen te byen konprann ke ou menm se te yon mèt ki di; ke ou rekòlte kote ou pa plante, e ranmase kote ou pa simen.</char> <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/><char style="wj">Epi mwen te krent, e te ale sere talan an nan tè. Gade byen, ou twouve sa ki pou ou a.’ </char><verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>
    <char style="wj">“Men mèt li te reponn li e te di: ‘Esklav malveyan e parese! Ou te konnen ke mwen rekòlte kote mwen pa plante, e ranmase kote mwen pa simen.</char> <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/><char style="wj">Pou sa, ou te dwe mete kòb mwen an labank pou lè m rive mwen ta kapab resevwa l avèk enterè.</char><verse eid="MAT 25:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28"/>
    <char style="wj">“Konsa, retire talan an nan men li, epi bay li a sila a ki gen dis talan yo.</char> <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/><note caller="+" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat 13:12</ref></char></note><char style="wj">Paske a sila a ki genyen an, l ap resevwa plis e l ap gen an abondans, men pou sila a ki pa genyen an, menm sa li genyen an ap retire nan men l.</char> <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/><char style="wj">Voye esklav initil sila a nan</char> <note caller="+" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat 8:12</ref></char></note><char style="wj">fon tenèb, nan plas kote ap genyen kriye ak manje dan.’</char><verse eid="MAT 25:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>
    <char style="wj">“Men lè </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:31 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:27">Mat 16:27</ref>
      </char>
    </note> <char style="wj">Fis a Lòm nan vini nan tout glwa Li avèk tout zanj Li yo, Li va chita sou twòn glwa pa Li a.</char> <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/><char style="wj">Tout nasyon yo va rasanble devan Li. E Li va separe yo youn de lòt,</char> <note caller="+" style="x"><char style="xo" closed="false">25:32 </char><char style="xt" closed="false"><ref loc="EZK 34:17-20">Éz 34:17-20</ref></char></note><char style="wj">kon yon gadyen patiraj separe mouton avèk kabrit.</char> <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/><char style="wj">Konsa, l ap mete mouton yo adwat li, e kabrit yo</char> <note caller="+" style="x"><char style="xo" closed="false">25:33 </char><char style="xt" closed="false"><ref loc="ECC 10:2">Ekl 10:2</ref></char></note><char style="wj">agoch Li.</char><verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>
    <char style="wj">“Epi Wa la va di a sila ki adwat li yo: ‘Vini, nou menm ki beni pa Papa m;</char> <note caller="+" style="x"><char style="xo" closed="false">25:34 </char><char style="xt" closed="false"><ref loc="MAT 5:3">Mat 5:3</ref></char></note><char style="wj">eritye wayòm nan ki te prepare pou nou depi fondasyon mond lan.</char> <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/><char style="wj">Paske</char> <note caller="+" style="x"><char style="xo" closed="false">25:35 </char><char style="xt" closed="false"><ref loc="ISA 58:7">És 58:7</ref></char></note><char style="wj">Mwen te grangou, e nou te ban M bagay pou M manje. Mwen te swaf, e nou te ban M bwè. Mwen te yon etranje, e nou te envite M antre,</char> <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/><note caller="+" style="x"><char style="xo" closed="false">25:36 </char><char style="xt" closed="false"><ref loc="ISA 58:7">És 58:7</ref></char></note><char style="wj">Mwen te touni, e nou te ban M rad. Mwen te malad e nou te vizite M. Mwen te nan prizon e nou te vin kote M.</char><verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>
    <char style="wj">“Epi jis yo ap di Li: ‘Senyè, kilè nou te wè Ou grangou e te bay Ou manje, ni swaf pou te bay Ou bwè?</char> <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/><char style="wj">Epi kilè nou te wè Ou yon etranje, epi envite Ou antre, oubyen touni pou te bay Ou rad?</char> <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/><char style="wj">Epi kilè nou te wè Ou malad, e te vizite Ou; oubyen nan prizon pou te vizite Ou?’ </char><verse eid="MAT 25:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40"/>
    <char style="wj">“Konsa, wa a va reponn yo: ‘Anverite, Mwen di nou</char> <note caller="+" style="x"><char style="xo" closed="false">25:40 </char><char style="xt" closed="false"><ref loc="PRO 19:17">Pwov 19:17</ref></char></note><char style="wj">menm jan ke nou te fè li a youn nan frè Mwen yo, nou te fè l a Mwen menm tou.’</char><verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>
    <char style="wj">“Apre Li va di a sila ki agoch Li yo:</char> <note caller="+" style="x"><char style="xo" closed="false">25:41 </char><char style="xt" closed="false"><ref loc="MAT 7:23">Mat 7:23</ref></char></note> <char style="wj">‘Sòti sou Mwen, nou menm ki modi, pou ale nan dife etènèl ki te prepare pou Satan avèk zanj li yo a.</char> <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/><char style="wj">Paske Mwen te grangou, men nou te refize ban M manje. Mwen te swaf, e nou pa t ban M bwè.</char> <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/><char style="wj">Mwen te yon etranje, e nou pa t envite M antre, touni, e nou pa t ban M rad, nan prizon e nou pa t vizite M.</char><verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>
    <char style="wj">“Alò yo menm va reponn: ‘Senyè, kilè nou te wè Ou grangou, oswa swaf, oswa yon etranje, touni, malad oubyen nan prizon, e nou pa t okipe Ou?’ </char><verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>
    <char style="wj">“Konsa L ap reponn yo: ‘Anverite Mwen di nou, menm jan ke nou pa t fè li pou youn nan pi piti nan sa yo, nou pa t fè l pou Mwen tou.’</char> <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/><char style="wj">Epi sila yo va ale nan pinisyon etènèl, men jis yo nan</char> <note caller="+" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="MAT 19:20">Mat 19:20</ref></char></note><char style="wj">lavi etènèl.” </char><verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:28">Mat 7:28</ref>
      </char>
    </note> Lè Jésus te fin pale tout pawòl sa yo, Li te di a disip Li yo: <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/><note caller="+" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="MRK 14:1-2">Mc 14:1-2</ref></char></note><char style="wj">“Nou konnen ke apre de jou, Jou Pak Jwif la ap vini, e Fis a Lòm nan ap livre a yo menm pou yo kab krisifye L.” </char><verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>Nan moman sa a, chèf prèt yo avèk lansyen a pèp yo te reyini ansanm <note caller="+" style="x"><char style="xo" closed="false">26:3 </char><char style="xt" closed="false"><ref loc="MAT 26:58">Mat 26:58</ref>,<ref loc="MAT 26:59">59</ref></char></note>nan lakou tribinal wo prèt ke yo te rele Caïphe la. <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>Epi yo te <note caller="+" style="x"><char style="xo" closed="false">26:4 </char><char style="xt" closed="false"><ref loc="MAT 12:14">Mat 12:14</ref></char></note>fè konplo ansanm pou sezi Jésus an sekrè e touye Li. <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>Men yo t ap di: “Pa fè l pandan fèt la <note caller="+" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="MAT 27:24">Mat 27:24</ref></char></note>otreman sa kab fè yon gwo revòlt pami pèp la.”<verse eid="MAT 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:6 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:37-39">Luc 7:37-39</ref>
      </char>
    </note>Alò, lè Jésus te Béthanie nan kay a Simon, lepre la, <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/><note caller="+" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="LUK 7:37">Luc 7:37</ref></char></note>yon fanm te vin kote L avèk yon bokal pòslèn plen avèk pafen ki te trè chè. Li te vide li sou tèt Jésus, pandan Li te sou tab la.<verse eid="MAT 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8"/>Men disip yo te mekontan lè yo te wè sa. Yo te di: “Poukisa l ap fè gaspiyaj konsa? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>Pwiske pafen sa a ta kapab vann pou yon gwo pri, e lajan sa a ta kapab separe bay a malere yo.”<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>Men Jésus te konprann sa, e te di yo: <char style="wj">“Poukisa nou ap twouble fanm nan? Li fè M yon bon bagay.</char> <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/><char style="wj">Paske</char> <note caller="+" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">Det 15:11</ref></char></note><char style="wj">malere yo ap toujou avèk nou, men Mwen menm, Mwen p ap la pou tout tan.</char> <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/><char style="wj">Pwiske lè li te vide pafen sila a sou kò M, li te fè l</char> <note caller="+" style="x"><char style="xo" closed="false">26:12 </char><char style="xt" closed="false"><ref loc="JHN 19:40">Jn 19:40</ref></char></note><char style="wj">pou prepare Mwen pou lantèman.</char> <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/><char style="wj">Anverite, Mwen di nou ke</char> <note caller="+" style="x"><char style="xo" closed="false">26:13 </char><char style="xt" closed="false"><ref loc="MRK 14:9">Mc 14:9</ref></char></note><char style="wj">nenpòt kote ke bòn nouvèl sila a preche nan tout mond lan, sa ke fanm sila a te fè a, ap toujou pale pou yo sonje li nèt.” </char><verse eid="MAT 26:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:14 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:10-11">Mc 14:10-11</ref>
      </char>
    </note>Konsa, youn nan douz yo ki te rele Judas Iscariot te ale kote chèf prèt yo. <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>Li te di yo: “Kisa nou ap ban mwen si mwen livre Li bannou?”</para>
  <para style="p" vid="MAT 26:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">26:15 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 21:32">Egz 21:32</ref>
      </char>
    </note>Yo te peze bay li trant pyès ajan. <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>Depi lè sa a, li te kòmanse chache yon bon moman pou trayi li.<verse eid="MAT 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:17 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:12-16">Mc 14:12-16</ref>
      </char>
    </note>Alò, nan premye jou Fèt Pen San Ledven an, disip yo te vin kote Jésus pou mande L: “Kibò Ou vle nou prepare manje Jou Pak Jwif la pou Ou?”<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>Li te di yo: <char style="wj">“Ale nan vil la a yon</char> <note caller="+" style="x"><char style="xo" closed="false">26:18 </char><char style="xt" closed="false"><ref loc="MRK 14:13">Mc 14:13</ref></char></note><char style="wj">sèten mesye e di li: ‘Mèt la di nou “Lè Mwen prèske rive. M ap fè fèt Jou Pak la lakay ou avèk disip Mwen yo.”’”</char><verse eid="MAT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19"/>Disip yo te fè sa, jan Jésus te mande yo a. Konsa, yo te prepare Jou Pak la.<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:20 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:17-21">Mc 14:17-21</ref>
      </char>
    </note>Alò, lè fènwa te vin rive, Jésus te lonje sou tab la avèk douz disip yo. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>Pandan yo t ap manje, Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">26:21 </char><char style="xt" closed="false"><ref loc="LUK 22:21-23">Luc 22:21-23</ref></char></note> <char style="wj">“Anverite Mwen di nou, youn nan nou ap trayi M”.</char><verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>Avèk yon doulè pwofon, yo chak te kòmanse mande L: “Asireman, se pa mwen menm, Senyè?”<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>Li te reponn: <note caller="+" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Sòm 41:9</ref></char></note><char style="wj">“Sila ki mete men l avèk mwen nan bòl la, se li menm k ap trayi Mwen an.</char> <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/><char style="wj">Fis a Lòm nan gen pou ale,</char> <note caller="+" style="x"><char style="xo" closed="false">26:24 </char><char style="xt" closed="false"><ref loc="MAT 26:31-54">Mat 26:31-54</ref></char></note><char style="wj">jan ke li ekri sou Li a, men malè a sila ki trayi Fis a Lòm nan! Li t ap pi bon pou li si li pa t janm fèt.”</char><verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:25 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:14">Mat 26:14</ref>
      </char>
    </note>Judas, ki t ap trayi Li a te reponn: “Asireman se pa mwen menm, Rabbi (Mèt)?”</para>
  <para style="p" vid="MAT 26:25">Li te reponn li: <char style="wj">“Se ou menm ki di l.”</char><verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:26 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:16">I Kor 10:16</ref>
      </char>
    </note>Pandan yo t ap manje, Jésus te pran kèk pen. Li te beni li, kase l epi separe bay disip Li yo. Li te di: <char style="wj">“Pran, manje; sa se kò Mwen.”</char><verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>Li te pran tas la e te bay remèsiman. Li te bay yo e Li te di: <char style="wj">“Bwè ladann, nou tout;</char> <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/><char style="wj">paske</char> <note caller="+" style="x"><char style="xo" closed="false">26:28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Egz 24:8</ref></char></note><char style="wj">sa se san akò Mwen ki vèse pou anpil moun, pou padon peche yo.</char> <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/><char style="wj">Men Mwen di nou, Mwen p ap bwè fwi rezen sila a ankò depi koulye a, jouk rive lè Mwen bwè l de nouvo avèk nou nan wayòm Papa Mwen an.” </char><verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:30 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:26-31">Mc 14:26-31</ref>
      </char>
    </note>Apre yo chante yon kantik, yo te ale nan Mòn Oliv la.<verse eid="MAT 26:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>Konsa, Jésus te di yo: <char style="wj">“Nou tout ap gaye akoz Mwen pandan nwit sa a, paske sa ekri:</char> <note caller="+" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Za 13:7</ref></char></note><char style="wj">‘Mwen va frape e fè tonbe bèje a, epi tout mouton va gaye.’ </char> <verse eid="MAT 26:31"/><verse number="32" style="v" sid="MAT 26:32"/><char style="wj">Men lè M leve,</char> <note caller="+" style="x"><char style="xo" closed="false">26:32 </char><char style="xt" closed="false"><ref loc="MAT 28:7">Mat 28:7</ref>,<ref loc="MAT 28:10">10</ref>,<ref loc="MAT 28:16">16</ref></char></note><char style="wj">M ap prale devan nou Galilée.”</char><verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>Men Pierre te reponn e te di Li: “Menm lè tout lòt yo fè bak akoz de Ou menm, mwen menm, mwen p ap fè bak.”<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>Jésus te di li: <note caller="+" style="x"><char style="xo" closed="false">26:34 </char><char style="xt" closed="false"><ref loc="MAT 26:75">Mat 26:75</ref></char></note><char style="wj">“Anverite Mwen di ou ke menm nwit sa a, avan kòk la gen tan chante, ou ap gen tan nye Mwen twa fwa.”</char><verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>Pierre te di Li: <note caller="+" style="x"><char style="xo" closed="false">26:35 </char><char style="xt" closed="false"><ref loc="JHN 13:37">Jn 13:37</ref></char></note>“Menm si mwen oblije mouri avèk Ou, mwen p ap janm nye Ou.” Tout lòt disip yo te di menm bagay sila a tou.<verse eid="MAT 26:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:36 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:32-42">Mc 14:32-42</ref>
      </char>
    </note>Konsa, Jésus te vini avèk yo nan yon plas yo rele Gethsémané. Li te di a disip Li yo: <char style="wj">“Chita isit la pandan Mwen prale lòtbò a pou priye.”</char><verse eid="MAT 26:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 26:37"/>Li te pran avè L <note caller="+" style="x"><char style="xo" closed="false">26:37 </char><char style="xt" closed="false"><ref loc="MAT 4:21">Mat 4:21</ref></char></note>Pierre, avèk de fis Zébédée yo, epi Li te kòmanse ranpli avèk gwo doulè ak tristès. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>Konsa Li te di yo: <char style="wj">“Nanm Mwen jis nan fon Mwen tris, jiskaske rive nan pwent pou mouri. Rete isit la pou veye avè M”.</char> <note caller="+" style="x"><char style="xo" closed="false">26:38 </char><char style="xt" closed="false"><ref loc="JHN 12:27">Jn 12:27</ref></char></note> <verse eid="MAT 26:38"/><verse number="39" style="v" sid="MAT 26:39"/><char style="wj">Li te ale yon ti jan pi lwen; Li te tonbe sou figi Li, e te priye konsa: “Papa M, si se posib, kite</char> <note caller="+" style="x"><char style="xo" closed="false">26:39 </char><char style="xt" closed="false"><ref loc="MAT 20:22">Mat 20:22</ref></char></note><char style="wj">tas sila a chape de Mwen menm;</char> <note caller="+" style="x"><char style="xo" closed="false">26:39 </char><char style="xt" closed="false"><ref loc="MAT 26:42">Mat 26:42</ref></char></note><char style="wj">men pa jan Mwen menm ta vle l la, men jan volonte pa W la.” </char><verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>Li te vin vire vè disip Li yo e te twouve yo t ap dòmi. Li te di a Pierre: <char style="wj">“Konsa, nou pa t kapab </char><note caller="+" style="x"><char style="xo" closed="false">26:40 </char><char style="xt" closed="false"><ref loc="MAT 26:38">Mat 26:38</ref></char></note><char style="wj">veye avè M pandan yon sèl èdtan?</char> <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/><char style="wj">Veye byen e priye pou nou pa antre nan tantasyon.</char> <note caller="+" style="x"><char style="xo" closed="false">26:41 </char><char style="xt" closed="false"><ref loc="MRK 14:38">Mc 14:38</ref></char></note><char style="wj">Lespri a byen dispoze, men chè la fèb.” </char><verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>Li te kite yo yon dezyèm fwa e te priye konsa: <char style="wj">“Papa M, si tas sa a p ap kab retire anmwens ke M bwè l,</char> <note caller="+" style="x"><char style="xo" closed="false">26:42 </char><char style="xt" closed="false"><ref loc="MAT 26:39">Mat 26:39</ref></char></note><char style="wj">ke volonte Ou fèt.” </char><verse eid="MAT 26:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43"/>Ankò Li te retounen e te twouve yo t ap dòmi, paske zye yo te byen lou. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>Konsa, Li te kite yo ankò pou te ale pou priye yon twazyèm fwa. Li te fè menm priyè a yon fwa ankò.<verse eid="MAT 26:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45"/>
    <char style="wj">Apre Li te vin kote disip Li yo. Li te mande yo: “Èske nou toujou ap dòmi epi pran repo nou? Gade, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:45 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:41">Mc 14:41</ref>
      </char>
    </note> <char style="wj">lè a rive. Fis a Lòm nan ap livre nan men pechè yo.</char> <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/><char style="wj">Leve, annou ale. Men gade, sila k ap trayi Mwen an gen tan rive!” </char><verse eid="MAT 26:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:47 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:43-50">Mc 14:43-50</ref>
      </char>
    </note>Pandan Li te toujou ap pale, Judas, youn nan douz yo, te pwoche. Li te akonpanye pa yon gwo foul avèk nepe ak baton, ki te voye pa gran prèt ak lansyen a pèp yo. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>Konsa, sila ki t ap trayi Li a te deja bay yo yon sinyal. Li te di: “Sila ke m bo a, se Li menm. Sezi Li.” <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>Touswit, Li te ale kote Jésus. Li te di: “Bonswa <note caller="+" style="x"><char style="xo" closed="false">26:49 </char><char style="xt" closed="false"><ref loc="MAT 23:7">Mat 23:7</ref></char></note>Rabbi (Mèt)!” e li te bo Li.<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>Jésus te di Li: <note caller="+" style="x"><char style="xo" closed="false">26:50 </char><char style="xt" closed="false"><ref loc="MAT 20:13">Mat 20:13</ref></char></note> <char style="wj">“Zanmi M, poukisa ou vini la.” </char> Konsa yo vin mete men yo sou Li, e te sezi Li.<verse eid="MAT 26:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51"/>Epi konsa, <note caller="+" style="x"><char style="xo" closed="false">26:51 </char><char style="xt" closed="false"><ref loc="MRK 14:47">Mc 14:47</ref></char></note>youn nan yo ki te avèk Jésus te rale nepe l, te voye l e koupe zòrèy a esklav gran prèt la.<verse eid="MAT 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52"/>Alò, Jésus te di l: <char style="wj">“Remete nepe ou nan plas li; paske</char> <note caller="+" style="x"><char style="xo" closed="false">26:52 </char><char style="xt" closed="false"><ref loc="GEN 9:6">Jen 9:6</ref></char></note><char style="wj">tout sila ki leve nepe yo, y ap peri pa nepe.</char> <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/><char style="wj">Men èske nou panse ke Mwen pa kapab fè apèl a Papa M, e l ap voye ban Mwen plis ke</char> <note caller="+" style="x"><char style="xo" closed="false">26:53 </char><char style="xt" closed="false"><ref loc="MRK 5:9">Mc 5:9</ref>,<ref loc="MRK 5:15">15</ref></char></note><char style="wj">douz lejyon (sa vle di 72,000) </char><note caller="+" style="x"><char style="xo" closed="false">26:53 </char><char style="xt" closed="false"><ref loc="MAT 4:11">Mat 4:11</ref></char></note><char style="wj">zanj?</char> <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/><char style="wj">Men kijan konsa,</char> <note caller="+" style="x"><char style="xo" closed="false">26:54 </char><char style="xt" closed="false"><ref loc="MAT 26:24">Mat 26:24</ref></char></note><char style="wj">pou Ekriti Sen yo kab vin akonpli ki fè nou konnen jan l ap oblije fèt?”</char><verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>Nan moman sa a, Jésus te di a foul la: <char style="wj">“Èske nou vini avèk nepe ak baton pou arete M, konsi nou ta vin kont yon vòlè?</char> <note caller="+" style="x"><char style="xo" closed="false">26:55 </char><char style="xt" closed="false"><ref loc="MRK 12:35">Mc 12:35</ref></char></note><char style="wj">Chak jou Mwen te konn chita nan tanp lan pou enstwi nou, e nou pa t janm sezi M.</char> <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/><char style="wj">Men tout sa vin rive pou </char><note caller="+" style="x"><char style="xo" closed="false">26:56 </char><char style="xt" closed="false"><ref loc="MAT 26:24">Mat 26:24</ref></char></note><char style="wj">Ekriti Sen yo selon pwofèt yo ta kapab vin akonpli.”</char></para>
  <para style="p" vid="MAT 26:56">Lapoula, tout disip Li yo te kouri kite Li.<verse eid="MAT 26:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:57 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:53-65">Mc 14:53-65</ref>
      </char>
    </note>Sila ki te sezi Jésus yo te mennen L ale pou wè Caïphe, gran prèt la, kote skrib yo avèk lansyen a pèp yo te gen tan rasanble.<verse eid="MAT 26:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 26:58"/>Men <note caller="+" style="x"><char style="xo" closed="false">26:58 </char><char style="xt" closed="false"><ref loc="JHN 18:15">Jn 18:15</ref></char></note>Pierre te swiv Li a yon distans jouk yo rive nan <note caller="+" style="x"><char style="xo" closed="false">26:58 </char><char style="xt" closed="false"><ref loc="MAT 26:3">Mat 26:3</ref></char></note>lakou wo prèt la. Li te antre avèk yo e chita avèk gad yo pou wè jan li ta fini.<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>Epi chèf prèt yo avèk tout <note caller="+" style="x"><char style="xo" closed="false">26:59 </char><char style="xt" closed="false"><ref loc="MAT 5:22">Mat 5:22</ref></char></note>Konsèy la t ap fòse wè si yo ta kab twouve kèk fo temwayaj kont Jésus, pou yo ta kapab mete L a lanmò. <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>Men yo pa t twouve okenn, malgre ke anpil fo temwayaj te vin prezante.</para>
  <para style="p" vid="MAT 26:60">Men pita, <note caller="+" style="x"><char style="xo" closed="false">26:60 </char><char style="xt" closed="false"><ref loc="DEU 19:15">Det 19:15</ref></char></note>te gen de ki te vin prezante. <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>Yo te di: “Nonm sa a te di: <note caller="+" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="MAT 27:40">Mat 27:40</ref></char></note>‘Mwen kapab detwi tanp Bondye a, e rebati li nan twa jou.’”<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>Konsa, wo prèt la te kanpe pou te di L: “Èske Ou p ap reponn? Kisa ke moun sa yo ap temwaye kont ou an?”<verse eid="MAT 26:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 26:63"/>Men Jésus te rete an silans.</para>
  <para style="p" vid="MAT 26:63">
    <note caller="+" style="x">
      <char style="xo" closed="false">26:63 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:63-66">Mat 26:63-66</ref>
      </char>
    </note>Epi wo prèt la te di L: “Mwen egzije Ou pa Bondye vivan an, pou di nou, si Ou menm se Kris La, Fis Bondye a.”<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>Jésus te di li: <char style="wj">“Ou te di li ou menm. Malgre sa, Mwen ap di nou, apre sa, nou va wè Fis a Lòm nan k ap chita sou men dwat Pwisan an e</char> <note caller="+" style="x"><char style="xo" closed="false">26:64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7:13</ref></char></note><char style="wj">k ap vini sou nyaj ki nan syèl yo.” </char><verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>Konsa wo prèt la te <note caller="+" style="x"><char style="xo" closed="false">26:65 </char><char style="xt" closed="false"><ref loc="NUM 14:6">Nonb 14:6</ref></char></note>chire rad li e te di: “Li gen tan vin blasfeme! Kisa nou bezwen ankò kon temwayaj? Gade, nou fin tande blasfèm nan. <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>Kisa nou panse?” Yo te reponn e te di: <note caller="+" style="x"><char style="xo" closed="false">26:66 </char><char style="xt" closed="false"><ref loc="LEV 24:16">Lev 24:16</ref></char></note>“Li merite lanmò!”<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:67 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 50:6">És 50:6</ref>
      </char>
    </note>Epi yo krache nan figi Li, e te bat Li avèk kout pwen. Lòt yo te souflete L. <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>Yo te di: <note caller="+" style="x"><char style="xo" closed="false">26:68 </char><char style="xt" closed="false"><ref loc="MRK 14:65">Mc 14:65</ref></char></note>“Pwofetize pou nou, Ou menm Kris la! Kilès ki te frape Ou a?”<verse eid="MAT 26:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:69 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:66-72">Mc 14:66-72</ref>
      </char>
    </note>Konsa, Pierre te chita deyò a nan lakou a, e yon sèten fi ki t ap sèvi lòt yo te vin kote l. Li te di l: “Ou te osi avèk Jésus, Galileyen an.”<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>Men Li demanti devan tout e te di: “Mwen pa konnen menm de kisa w ap pale a!”<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>Epi lè li fin sòti sou galri a, yon lòt fi ki t ap sèvi te wè l e te di: “Mesye sila a te avèk Jésus, Nazareyen an.”<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>Ankò li te demanti sa avèk yon sèman: “Mwen pa menm konnen mesye sila a!”<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>Epi yon ti jan pita, sila ki te la yo, te vin kote Pierre. Yo te di l: “Asireman ou menm, ou se youn nan yo. <note caller="+" style="x"><char style="xo" closed="false">26:73 </char><char style="xt" closed="false"><ref loc="MRK 14:70">Mc 14:70</ref></char></note>Jan ou pale a devwale ou.”<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>Konsa li te kòmanse bay madichon e te sèmante: “Mwen pa menm konnen nonm sila a!”</para>
  <para style="p" vid="MAT 26:74">Imedyatman, kòk la te chante. <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>Pierre te sonje mo Jésus a, lè Li te di: <char style="wj">“Avan kók la chante, ou va nye Mwen twa fwa.” </char> E li te ale deyò pou te kriye yon kriye anmè.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Alò, lè maten <note caller="+" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="MRK 15:1">Mc 15:1</ref></char></note>vin rive, tout chèf prèt yo avèk lansyen a pèp la te pran diskite kont Jésus pou mete Li a lanmò. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>Yo te mare Li, mennen L ale pou te livre Li a <note caller="+" style="x"><char style="xo" closed="false">27:2 </char><char style="xt" closed="false"><ref loc="LUK 3:1">Luc 3:1</ref></char></note>Pilate, gouvènè peyi a.<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>Konsa, lè <note caller="+" style="x"><char style="xo" closed="false">27:3 </char><char style="xt" closed="false"><ref loc="MAT 26:14">Mat 26:14</ref></char></note>Judas ki te trayi Li a te wè ke Li te kondane, Li te sanse regrèt. Li te retounen bay <note caller="+" style="x"><char style="xo" closed="false">27:3 </char><char style="xt" closed="false"><ref loc="MAT 26:15">Mat 26:15</ref></char></note>trant pyès ajan yo bay chèf prèt yo avèk lansyen a pèp yo. <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>Li te di yo: “Mwen te peche. Mwen te trayi san inosan an.”</para>
  <para style="p" vid="MAT 27:4">Men yo te reponn l: “Kisa sa ye pou nou? <note caller="+" style="x"><char style="xo" closed="false">27:4 </char><char style="xt" closed="false"><ref loc="MAT 27:24">Mat 27:24</ref></char></note>Okipe sa ou menm!”<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>Pou sa a, li te jete pyès ajan yo nan santyè tanp lan. <note caller="+" style="x"><char style="xo" closed="false">27:5 </char><char style="xt" closed="false"><ref loc="MAT 26:24">Mat 26:24</ref></char></note>Li te sòti, e te ale pann tèt li.<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>Chèf prèt yo te pran pyès ajan yo, e te di: “Sa pa pèmèt pou nou mete yo nan kès tanp lan, akoz ke se pri san.” <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>Konsa, yo te mete tèt yo ansanm. Avèk kòb la, yo te achte yon chan yo te rele Chan Kanari a pou yon simityè pou etranje yo. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/><note caller="+" style="x"><char style="xo" closed="false">27:8 </char><char style="xt" closed="false"><ref loc="ACT 1:19">Trav 1:19</ref></char></note>Pou rezon sa a, yo rele chan sa a Chan San an, jiska jodi a.<verse eid="MAT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9"/>Epi sa ki te pale pa pwofèt Jérémie a te akonpli, sa ki te di:</para>
  <para style="q1" vid="MAT 27:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">27:9 </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 11:12">Za 11:12</ref>
      </char>
    </note>“Yo te pran trant pyès ajan,</para>
  <para style="q1" vid="MAT 27:9">pri sou Sila a ke yo te etabli yon pri;</para>
  <para style="q1" vid="MAT 27:9">ke kèk nan fis Israël te etabli,<verse eid="MAT 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 27:10"/>epi yo te bay yo pou <note caller="+" style="x"><char style="xo" closed="false">27:10 </char><char style="xt" closed="false"><ref loc="ZEC 11:13">Za 11:13</ref></char></note>Chan Kanari a</para>
  <para style="q1" vid="MAT 27:10">jan Senyè a te dirije m nan.”<verse eid="MAT 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:11 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 15:2-5">Mc 15:2-5</ref>
      </char>
    </note>Alò, Jésus te kanpe devan gouvènè a, e gouvènè a te kesyone L konsa: “Èske ou se Wa a Jwif yo”?</para>
  <para style="p" vid="MAT 27:11">Jésus te reponn li: <char style="wj">“Se konsa ou di a.” </char><verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>Lè Li te akize pa chèf prèt yo avèk lansyen a pèp yo, <note caller="+" style="x"><char style="xo" closed="false">27:12 </char><char style="xt" closed="false"><ref loc="MAT 26:63">Mat 26:63</ref></char></note>Li pa t reponn.<verse eid="MAT 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13"/>Konsa, Pilate te di L: “Èske ou pa tande konbyen bagay yo temwaye kont Ou?”<verse eid="MAT 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:12">Mat 27:12</ref>
      </char>
    </note>Li pa t reponn li menm a yon sèl akizasyon. Gouvènè a te byen etone pou sa.<verse eid="MAT 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:15 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 18:39">Jn 18:39</ref>
      </char>
    </note>Alò, nan fèt la, gouvènè a te abitye lage pou pèp la yon sèl prizonye selon volonte pa yo. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>Nan moman sa a, yo te gen yon move prizonye byen rekonèt, yo te rele Barabbas.<verse eid="MAT 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 27:17"/>Konsa, lè yo te reyini ansanm, Pilate te mande yo: “Kilès nou vle m lage pou nou? Barabbas, oubyen Jésus <note caller="+" style="x"><char style="xo" closed="false">27:17 </char><char style="xt" closed="false"><ref loc="MAT 1:16">Mat 1:16</ref></char></note>ke yo rele Kris la?” <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>Paske li te byen konprann ke se jalouzi ki te fè yo livre Li.<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:19 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:13">Jn 19:13</ref>
      </char>
    </note>Pandan Li te chita sou chèz jijman an, madanm li te voye di li: “Pa gen anyen pou fè avèk Nonm jis sila a; paske jodi a, mwen te soufri anpil nan yon rèv akoz de Li menm.”<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>Men chèf prèt yo avèk lansyen yo te konvenk yo pou <note caller="+" style="x"><char style="xo" closed="false">27:20 </char><char style="xt" closed="false"><ref loc="ACT 3:14">Trav 3:14</ref></char></note>mande pou Barabbas, e pou mete Jésus a lanmò.<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>Men gouvènè a te reponn e te di yo: “Kilès nan de sa yo nou ta vle m lage bannou?”</para>
  <para style="p" vid="MAT 27:21">E yo te di: “Barabbas!”<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>Pilate te di: “E kisa pou mwen ta fè avèk Jésus <note caller="+" style="x"><char style="xo" closed="false">27:22 </char><char style="xt" closed="false"><ref loc="MAT 1:16">Mat 1:16</ref></char></note>ke yo rele Kris la?”</para>
  <para style="p" vid="MAT 27:22">E yo te di: “Krisifye Li!”<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>Li te di: “Poukisa, ki mal Li fè?”</para>
  <para style="p" vid="MAT 27:23">Men yo te kontinye rele pi fò: “Krisifye Li!”<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>Konsa, lè Pilate te wè ke li pa t ap rezoud anyen, men okontrè, pèp la te kòmanse ap fè tenten, li te pran dlo pou <note caller="+" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="DEU 21:6-8">Det 21:6-8</ref></char></note>te lave men li devan pèp la, e te di: “Mwen inosan a san Nonm sila a; fè l nou menm”.<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>Tout pèp la te reponn e te di: <note caller="+" style="x"><char style="xo" closed="false">27:25 </char><char style="xt" closed="false"><ref loc="JOS 2:19">Jos 2:19</ref></char></note>“Kite san Li sou nou e sou Pitit nou yo!”<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>Konsa, li te lage Barabbas pou yo; men li te fè yo <note caller="+" style="x"><char style="xo" closed="false">27:26 </char><char style="xt" closed="false"><ref loc="MRK 15:15">Mc 15:15</ref></char></note>bat Jésus avèk fwèt, epi li te livre Li pou L te krisifye.<verse eid="MAT 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:27 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 15:16-20">Mc 15:16-20</ref>
      </char>
    </note>Epi sòlda a gouvènè yo te pran Jésus ale nan pretwa a (lakou gad la), e te rasanble tout kowòt la (yon bann sòlda Women) pou antoure Li. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>Yo te retire rad sou Li, e te abiye Li avèk yon vètman wouj. <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/><note caller="+" style="x"><char style="xo" closed="false">27:29 </char><char style="xt" closed="false"><ref loc="MRK 15:17">Mc 15:17</ref></char></note>Epi lè yo fin trese yon kouwòn avèk bwa pikan, yo te mete li sou tèt Li, ak yon wozo nan men dwat Li. Yo te bese ajenou devan L pou te moke L. Yo te di L: “Salitasyon, Wa a Jwif yo!” <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/><note caller="+" style="x"><char style="xo" closed="false">27:30 </char><char style="xt" closed="false"><ref loc="MAT 26:67">Mat 26:67</ref></char></note>Yo te krache sou Li, yo te pran wozo a e te kòmanse bat Li nan tèt.<verse eid="MAT 27:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 27:31"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:31 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 15:20">Mc 15:20</ref>
      </char>
    </note>Lè yo te fin moke L, yo te retire vètman wouj la sou Li, e te remete rad Li sou Li pou mennen L al krisifye. <verse eid="MAT 27:31"/><verse number="32" style="v" sid="MAT 27:32"/><note caller="+" style="x"><char style="xo" closed="false">27:32 </char><char style="xt" closed="false"><ref loc="JHN 19:17">Jn 19:17</ref></char></note>Pandan yo t ap sòti, yo te rankontre yon nonm peyi Siryen ke yo te rele Simon, e yo te fòse li pote Kwa Li a.<verse eid="MAT 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 27:33"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:33 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 15:22-32">Mc 15:22-32</ref>
      </char>
    </note>Lè yo te rive nan yon plas yo rele Golgotha, ki vle di Plas Zo Bwa Tèt La, <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/><note caller="+" style="x"><char style="xo" closed="false">27:34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Sòm 69:21</ref></char></note>yo te bay Li diven pou bwè mele avèk fyèl. Men lè L te goute l, Li pa t dakò bwè l. <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>Answit lè yo te fin krisifye L, yo te <note caller="+" style="x"><char style="xo" closed="false">27:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">Sòm 22:18</ref></char></note>pataje vètman Li pami yo selon tiraj osò. <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>Epi konsa, yo te chita e te <note caller="+" style="x"><char style="xo" closed="false">27:36 </char><char style="xt" closed="false"><ref loc="MAT 27:54">Mat 27:54</ref></char></note>kòmanse veye L la. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>Yo te plase anwo tèt Li akizasyon ki te kont Li an ki te di: <note caller="+" style="x"><char style="xo" closed="false">27:37 </char><char style="xt" closed="false"><ref loc="MRK 15:26">Mc 15:26</ref></char></note> “SA SE JÉSUS WA JWIF LA”.<verse eid="MAT 27:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38"/>Nan menm lè sa a, de vòlè te krisifye avè L, youn pa adwat Li, e youn pa agoch Li. <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>Sila yo ki t ap pase la yo t ap voye kout lang sou Li, e t ap <note caller="+" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="JOB 16:4">Job 16:4</ref></char></note>souke tèt yo. <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>Yo t ap di: <note caller="+" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">Mat 26:61</ref></char></note>“Ou menm k ap detwi tanp lan pou rebati li nan twa jou a, sove pwòp tèt ou! <note caller="+" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 27:42">Mat 27:42</ref></char></note>Si ou se Fis Bondye a, sòti sou kwa a.”<verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>Epi menm jan an, chèf prèt yo avèk skrib ak lansyen yo t ap moke L e t ap di: <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/><note caller="+" style="x"><char style="xo" closed="false">27:42 </char><char style="xt" closed="false"><ref loc="MRK 15:31">Mc 15:31</ref></char></note>“Li te sove lòt yo; Li pa kapab sove pwòp tèt Li. Si Li se Wa Israël la, koulye a, kite L sòti sou kwa a, e n ap kwè nan Li. <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/><note caller="+" style="x"><char style="xo" closed="false">27:43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">Sòm 22:8</ref></char></note>Li mete konfyans nan Bondye. Kite Li sove Li koulye a, si Li vlè L; paske Li te di: ‘Mwen se Fis Bondye a’”.<verse eid="MAT 27:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44"/>Anplis, <note caller="+" style="x"><char style="xo" closed="false">27:44 </char><char style="xt" closed="false"><ref loc="LUK 23:3-9">Luc 23:3-9-43</ref></char></note>volè ki te krisifye avè L yo t ap voye menm ensilt yo sou Li.<verse eid="MAT 27:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:45 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 15:33-41">Mc 15:33-41</ref>
      </char>
    </note>Alò, depi sizyèm lè (midi), fènwa te tonbe sou tout tè a jis rive nan nevyèm lè (twazè).<verse eid="MAT 27:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 27:46"/>Nan anviwon nevyèm lè, Jésus te kriye avèk yon vwa byen fò: <note caller="+" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Sòm 22:1</ref></char></note><char style="wj">“Eli, Eli, lima sabachthani?” </char> Ki vle di: <char style="wj">“Bondye m, Bondye m, Poukisa Ou abandone Mwen?” </char><verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>Epi kèk nan yo ki te kanpe la, lè yo te tande sa, yo te kòmanse di: “Nonm sa a ap rele Elie”. <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/><note caller="+" style="x"><char style="xo" closed="false">27:48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Sòm 69:21</ref></char></note>E lapoula, youn nan yo te kouri pran yon eponj. Li te ranpli li avèk vinèg si, e plase li sou yon wozo pou te bay Li pou bwè. <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>Men lòt yo te di: “Annou wè si Elie ap vin sove L”.<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>Konsa, Jésus <note caller="+" style="x"><char style="xo" closed="false">27:50 </char><char style="xt" closed="false"><ref loc="MRK 15:37">Mc 15:37</ref></char></note>te kriye ankò avèk yon vwa fò, e te kite nanm Li sòti.<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:51 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 23:47-49">Luc 23:47-49</ref>
      </char>
    </note>Epi gade, <note caller="+" style="x"><char style="xo" closed="false">27:51 </char><char style="xt" closed="false"><ref loc="EXO 26:31">Egz 26:31</ref></char></note>vwal tanp lan te chire de bout soti anwo, rive jouk anba, epi latè te tranble, e wòch yo te vin fann. <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>Konsa, tonm yo te louvri e kò anpil sen ki <note caller="+" style="x"><char style="xo" closed="false">27:52 </char><char style="xt" closed="false"><ref loc="ACT 7:60">Trav 7:60</ref></char></note>t ap dòmi te vin leve. <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>Yo te sòti nan tonm yo lè Li te fin resisite e te antre nan <note caller="+" style="x"><char style="xo" closed="false">27:53 </char><char style="xt" closed="false"><ref loc="MAT 4:5">Mat 4:5</ref></char></note>vil sen an kote yo te parèt a anpil moun.<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:54 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 15:39">Mc 15:39</ref>
      </char>
    </note>Epi santenye a ak sila ki te avèk li yo ki t ap veye Jésus yo, lè yo te wè tranbleman de tè a, ak bagay ki t ap fèt yo te vin fè pè anpil. Yo te di: “Anverite, sa se te Fis a Bondye a!”<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:55 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 15:40">Mc 15:40</ref>
      </char>
    </note>Anpil fanm te la. Yo t ap gade a yon distans. Se te sila ki te swiv Jésus yo soti Galilée pandan yo t ap sèvi L. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>Pami yo, te gen <note caller="+" style="x"><char style="xo" closed="false">27:56 </char><char style="xt" closed="false"><ref loc="MAT 28:1">Mat 28:1</ref></char></note>Marie a Magdala, Marie, manman a Jacques ak Joseph, e manman a fis Zébédée yo.<verse eid="MAT 27:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:57 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 15:42-47">Mc 15:42-47</ref>
      </char>
    </note>Lè li te fin fènwa, te vini yon nonm rich ki te soti Arimathée, ke yo te rele Joseph. Li menm osi, li te deja yon disip a Jésus. <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>Mesye sila a te mande Pilate pou kò Jésus.</para>
  <para style="p" vid="MAT 27:58">Konsa Pilate te kòmande ke li te livre bay li.<verse eid="MAT 27:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 27:59"/>Epi Joseph te pran kò a e te vlope li nan yon twal lèn pwòp. <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>Li te mete li nan pwòp tonm nèf pa li, ki te fouye nan wòch. Li te woule yon <note caller="+" style="x"><char style="xo" closed="false">27:60 </char><char style="xt" closed="false"><ref loc="MAT 27:66">Mat 27:66</ref></char></note>gwo wòch kont antre a, e li te kite lye a.<verse eid="MAT 27:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="MAT 27:61"/>Epi Marie ki te sòti Magdala te la avèk lòt Marie a, ki te chita anfas tonm lan.<verse eid="MAT 27:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Konsa, nan jou swivan an, ki te jou apre <note caller="+" style="x"><char style="xo" closed="false">27:62 </char><char style="xt" closed="false"><ref loc="MAT 27:56">Mat 27:56</ref></char></note>preparasyon an, chèf prèt yo avèk Farizyen yo te reyini avèk Pilate. <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>Yo te di l: “Mèt, nou sonje ke lè Li te vivan an ke twonpè sila a te di: <note caller="+" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref></char></note><char style="wj">‘Apre twa jou, Mwen va leve ankò.’ </char> <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Pou sa, kòmande pou yo mete tonm nan an sekirite jiska twa jou. Otreman, disip Li yo kab vin vòlè Li e di pèp la ke Li gen tan leve nan lanmò; epi dènye desepsyon sila a ap pi mal pase premye a.”<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>Pilate te di yo: “Nou genyen <note caller="+" style="x"><char style="xo" closed="false">27:65 </char><char style="xt" closed="false"><ref loc="MAT 27:66">Mat 27:66</ref></char></note>gad la; ale mete li ansekirite jan nou konnen an.”<verse eid="MAT 27:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66"/>Epi yo te ale mete tonm nan ansekirite. Plis ke gad la, yo te mete yon <note caller="+" style="x"><char style="xo" closed="false">27:66 </char><char style="xt" closed="false"><ref loc="DAN 6:17">Dan 6:17</ref></char></note>so sou wòch la.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">28:1 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 20:1-8">Jn 20:1-8</ref>
      </char>
    </note>Alò, apre Saba a, lè li te kòmanse fè jou nan premye jou semèn nan, Marie Magdala ak lòt Marie a te vini pou gade tonm nan.<verse eid="MAT 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2"/>Lapoula, te gen yon gwo tranbleman de tè, e <note caller="+" style="x"><char style="xo" closed="false">28:2 </char><char style="xt" closed="false"><ref loc="LUK 24:4">Luc 24:4</ref></char></note>yon zanj Bondye te desann soti nan syèl la. Li te vin woule <note caller="+" style="x"><char style="xo" closed="false">28:2 </char><char style="xt" closed="false"><ref loc="MAT 27:66">Mat 27:66</ref></char></note>wòch akote a, e li te chita sou li. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Li te <note caller="+" style="x"><char style="xo" closed="false">28:3 </char><char style="xt" closed="false"><ref loc="DAN 7:9">Dan 7:9</ref></char></note>parèt tankou kout eklè, e vètman li te blanch tankou lanèj.<verse eid="MAT 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 28:4"/>Gad yo te vin tranble avèk lakrent, e yo te tounen tankou moun mouri.<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>Konsa zanj lan te reponn e te di a fanm yo: <note caller="+" style="x"><char style="xo" closed="false">28:5 </char><char style="xt" closed="false"><ref loc="MRK 14:27">Mc 14:27</ref></char></note>“Pa pè, paske mwen konnen ke nou ap chèche Jésus ki te krisifye a. <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>Li pa la, paske Li leve, <note caller="+" style="x"><char style="xo" closed="false">28:6 </char><char style="xt" closed="false"><ref loc="MAT 12:40">Mat 12:40</ref></char></note>menm jan Li te di a. Vin wè plas kote Li te kouche a.” <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>“Epi ale vit pou di disip Li yo ke Li leve soti nan lanmò. Epi gade byen, l ap prale devan nou nan<note caller="+" style="x"><char style="xo" closed="false">28:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mat 26:32</ref></char></note>Galilée. La nou va wè Li. Gade byen, mwen gen tan di nou sa.”<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>Yo te kite tonm nan vit avèk lakrent, avèk gwo lajwa, e yo te kouri ale bay rapò a disip Li yo.<verse eid="MAT 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9"/>Pandan yo t ap w ale pou pale disip Li yo, gade byen, Jésus te rankontre yo e te salye yo.</para>
  <para style="p" vid="MAT 28:9">Yo te vin kote l, te kenbe pye Li, e te adore L. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>Jésus te di yo: <char style="wj">“Pa pè. Ale di </char> <note caller="+" style="x"><char style="xo" closed="false">28:10 </char><char style="xt" closed="false"><ref loc="JHN 20:17">Jn 20:17</ref></char></note><char style="wj">frè M yo pati pou rive nan Galilée. La, yo va wè m.” </char><verse eid="MAT 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>Pandan yo te nan wout la, konsa kèk nan <note caller="+" style="x"><char style="xo" closed="false">28:11 </char><char style="xt" closed="false"><ref loc="MAT 27:65">Mat 27:65</ref>,<ref loc="MAT 27:66">66</ref></char></note>gad yo te antre lavil la pou te bay rapò a chèf prèt yo sou tout sa ki te rive yo a. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Konsa, lè yo te rasanble avèk tout lansyen yo e te pran konsèy ansanm, yo te bay yon gwo sòm lajan a sòlda yo. <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>Yo te di yo: “Nou gen pou di: ‘Disip Li yo te vini nan lannwit e te vòlè L pote ale pandan nou t ap dòmi. <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Si sa ta gen tan rive nan <note caller="+" style="x"><char style="xo" closed="false">28:14 </char><char style="xt" closed="false"><ref loc="MAT 27:2">Mat 27:2</ref></char></note>zòrèy Gouvènè a, n ap pale avè l pou pwoteje nou pou nou pa gen pwoblèm’”.<verse eid="MAT 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15"/>Alò, yo te pran kòb la, e te fè jan yo te enstwi yo. Listwa sila a te <note caller="+" style="x"><char style="xo" closed="false">28:15 </char><char style="xt" closed="false"><ref loc="MAT 9:31">Mat 9:31</ref></char></note>gaye pami Jwif yo e kontinye jouk jou sila a.<verse eid="MAT 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>Men onz disip yo te fè wout yo pou <note caller="+" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mat 26:32</ref></char></note>Galilée, vè mòn ke Jésus te dezinye a. <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>Lè yo te wè Li, yo te adore Li; men <note caller="+" style="x"><char style="xo" closed="false">28:17 </char><char style="xt" closed="false"><ref loc="MRK 16:11">Mc 16:11</ref></char></note>kèk te doute.<verse eid="MAT 28:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18"/>Jésus te vin pale avèk yo, e te di: <note caller="+" style="x"><char style="xo" closed="false">28:18 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7:13</ref></char></note><char style="wj">“Mwen fin resevwa tout pouvwa nan syèl la ak sou latè.</char> <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/><char style="wj">Konsa, ale </char> <note caller="+" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="MAT 15:32">Mat 15:32</ref></char></note> <char style="wj">fè disip a tout nasyon yo, epi </char> <note caller="+" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 2:38">Trav 2:38</ref></char></note><char style="wj">batize yo nan non Papa a, Fis la, avèk Lespri Sen an.</char> <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/><char style="wj">Enstwi yo pou swiv tout sa ke Mwen te kòmande nou yo, epi konsa, </char> <note caller="+" style="x"><char style="xo" closed="false">28:20 </char><char style="xt" closed="false"><ref loc="MAT 18:20">Mat 18:20</ref></char></note> <char style="wj">Mwen va avèk nou toujou jiska lafen de laj.” </char><verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
