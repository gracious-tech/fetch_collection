<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id" />
  <para style="h">II Timothée</para>
  <para style="toc1">II TIMOTHÉE</para>
  <para style="toc2">II Timothée</para>
  <para style="toc3">II Tim</para>
  <para style="mt1">II TIMOTHÉE</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Paul <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2CO 1:1">II Kor 1:1</ref></char></note>yon apot a Kris Jésus pa volonte Bondye, selon pwomès lavi ki nan Kris Jésus, <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" />a Timothée <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="1TI 1:2">I Tim 1:2</ref></char></note>fis byeneme mwen an: Lagras, mizerikòd, ak lapè Bondye, Papa a, e Kris Jésus, Senyè nou an.<verse eid="2TI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:3 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:8">Wo 1:8</ref>
      </char>
    </note>Mwen remèsye Bondye ke mwen sèvi avèk yon bon konsyans jan zansèt mwen yo te fè a, pandan mwen sonje ou tout tan nan lapriyè mwen yo lannwit kon lajounen <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" /><note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2TI 4:9">II Tim 4:9</ref>,<ref loc="2TI 4:21">21</ref></char></note>avèk lanvi pou m wè ou <note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="ACT 20:37">Trav 20:37</ref></char></note>menm lè mwen sonje dlo ki te sòti nan zye ou, pou m kapab ranpli avèk jwa.<verse eid="2TI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TI 1:5" />Paske mwen sonje <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="1TI 1:5">I Tim 1:5</ref></char></note>lafwa sensè ki nan ou a, ki te dabò rete <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">Trav 16:1</ref></char></note>nan grann ou, Lois ak manman ou, Eunice, e mwen byen si ke li nan ou tou. <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />Pou rezon sa a, mwen fè ou sonje pou rechofe <note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="1TI 4:14">I Tim 4:14</ref></char></note>don Bondye ki nan ou depi mwen te poze menm sou ou a.<verse eid="2TI 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2TI 1:7" />Paske Bondye pa bannou yon <note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JHN 14:27">Jn 14:27</ref></char></note>lespri timidite, men pouvwa, lanmou ak disiplin.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />Konsa <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MRK 8:38">Mc 8:38</ref></char></note>pa fè wont de temwayaj Senyè nou an, ni mwen menm nan, prizonye Li a, men vin jwenn ansanm avè m nan <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="2TI 2:3">II Tim 2:3</ref>,<ref loc="2TI 2:9">9</ref></char></note>soufrans pou levanjil la selon pouvwa Bondye a, <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />ki te sove nou e te <note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="ROM 8:28">Wo 8:28</ref></char></note>rele nou avèk yon apèl ki sen, <note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="EPH 2:9">Ef 2:9</ref></char></note>pa selon zèv nou yo, men selon pwòp bi ak gras pa L, ki te bay a nou menm nan Kris Jésus depi tout letènite, <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />men koulye a, ki vin revele pa aparans a Sovè nou an, Kris Jésus, ki te <note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="1CO 15:26">I Kor 15:26</ref></char></note>aboli lanmò e te pote lavi ak imòtalite nan limyè, atravè levanjil la. <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" /><note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1TI 2:7">I Tim 2:7</ref></char></note>Pou li menm, mwen te chwazi kòm predikatè, apot, ak pwofesè pou ale vè etranje yo. <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />Pou rezon sa a, mwen osi soufri bagay sa yo, men <note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="2TI 1:8">II Tim 1:8</ref>,<ref loc="2TI 1:16">16</ref></char></note>mwen pa wont; paske mwen konnen nan kilès mwen kwè a, e mwen konvenk ke Li kapab pwoteje sa ke m livre a Li menm nan jiska jou sa a.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:13 </char>
      <char style="xt" closed="false">
        <ref loc="TIT 1:9">Tit 1:9</ref>
      </char>
    </note>Kenbe fèm a pawòl sen ke ou tande de mwen yo, nan <note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="1TI 1:14">I Tim 1:14</ref></char></note>lafwa ak lanmou ki nan Kris Jésus a.<verse eid="2TI 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 1:14" />Veye byen, selon lespri Sen ki <note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ROM 8:9">Wo 8:9</ref></char></note>demere nan nou an, trezò kite konfye a ou a.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />Ou byen okouran ke tout moun ki an Asie yo, te <note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="2TI 4:10">II Tim 4:10</ref>,<ref loc="2TI 4:16">16</ref></char></note>vire kite m, pami yo menm, Phygelle ak Hermogène.<verse eid="2TI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16" />Ke Senyè a bay mizerikòd a <note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="2TI 4:10">II Tim 4:10</ref>,<ref loc="2TI 4:16">16</ref></char></note>lakay Onésiphore, paske Li te souvan konsole m, e li pa t wont pou chenn mwen yo; <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />men lè li te Rome, li te chèche mwen avèk dilijans e li te jwenn mwen. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />Ke Senyè a fè li jwenn mizerikòd Senyè a nan <note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="1CO 1:8">I Kor 1:8</ref></char></note>jou sa a—e ke ou konnen trè byen tout sèvis li te rann nan Éphèse.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />Konsa, ou menm, fis mwen an <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="EPH 6:10">Ef 6:10</ref></char></note>se pou ou dyanm nan gras ki nan Kris Jésus a. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />Bagay <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="2TI 1:13">II Tim 1:13</ref></char></note>ke ou te tande de mwen nan prezans a anpil temwen yo, konfye yo a moun ki fidèl, ki kapab osi enstwi lòt yo.<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:3 </char>
      <char style="xt" closed="false">
        <ref loc="2TI 1:8">II Tim 1:8</ref>
      </char>
    </note>Soufri difikilte avèk mwen, tankou yon bon sòlda a Kris Jésus. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />Nanpwen sòlda an sèvis ki <note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="2PE 2:20">II Pi 2:20</ref></char></note>mele tèt li nan zafè lavi kotidyèn, pou li kapab fè plezi a sila ki te enskri li kòm sòlda a.<verse eid="2TI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TI 2:5" />Osi, si yon moun nan <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="1CO 9:25">I Kor 9:25</ref></char></note>konpetisyon nan spò, li p ap genyen pri a amwenske li fè konpetisyon an selon règ yo.<verse eid="2TI 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 2:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:6 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 9:10">I Kor 9:10</ref>
      </char>
    </note>Kiltivatè ki travay di a ta dwe premyè pou resevwa pòsyon pa l nan rekòlt la.<verse eid="2TI 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2TI 2:7" />Konsidere sa ke m di a, paske Senyè a va ba ou bon konprann nan tout bagay.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />Sonje Jésus Kri <note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ACT 2:24">Trav 2:24</ref></char></note>leve soti nan lanmò, desandan a David la, selon levanjil mwen an. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />Pou li menm, mwen <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="2TI 1:8">II Tim 1:8</ref></char></note>soufri difikilte, menm anprizone kòm yon kriminèl; men pawòl Bondye a pa anprizone. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />Pou rezon sa a, mwen andire tout bagay, pou <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="LUK 18:7">Luc 18:7</ref></char></note>koz a sila ki te chwazi yo, pou yo kapab osi vin jwenn sali ki nan Kris Jésus a e avèk li, laglwa etènèl.<verse eid="2TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11" />“Sa se yon vrè pawòl:</para>
  <para style="q1" vid="2TI 2:11">Paske <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="ROM 6:8">Wo 6:8</ref></char></note>si nou te mouri avèk Li,</para>
  <para style="q1" vid="2TI 2:11">nou va osi viv avèk Li.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />Si nou andire,</para>
  <para style="q1" vid="2TI 2:12">nou va osi renye avèk Li.</para>
  <para style="q1" vid="2TI 2:12">Si nou <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 10:33">Mat 10:33</ref></char></note>rejte Li,</para>
  <para style="q1" vid="2TI 2:12">Li tou va rejte nou.<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />Si nou pa fidèl</para>
  <para style="q1" vid="2TI 2:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:13 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:3">Wo 3:3</ref>
      </char>
    </note>Li rete fidèl;</para>
  <para style="q1" vid="2TI 2:13">paske Li pa kapab nye pwòp tèt Li.”<verse eid="2TI 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />Fè yo sonje bagay sa yo, e<note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="1TI 5:21">I Tim 5:21</ref></char></note>anchaje yo solanèlman nan prezans a Bondye pou yo pa <note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="1TI 6:4">I Tim 6:4</ref></char></note>goumen sou pawòl yo, ki initil e ki mennen nan destriksyon sila k ap tande yo. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />Se pou ou dilijan pou <note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ROM 6:13">Wo 6:13</ref></char></note>prezante tèt ou apwouve bay Bondye, kòm yon ouvriye ki pa bezwen wont, ki livre byen klè pawòl verite a.<verse eid="2TI 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 2:16" />Men evite <note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="1TI 6:20">I Tim 6:20</ref></char></note>pale pawòl anven a mond sa a, paske l ap fè nou soti lwen lafwa Bondye a.<verse eid="2TI 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TI 2:17" />Epi pawòl sa yo va gaye tankou pwazon nan san. Pami yo, <note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="1TI 1:20">I Tim 1:20</ref></char></note>Hyménée ak Philète: <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />Moun ki te egare kite verite yo nan di ke <note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="1CO 15:12">I Kor 15:12</ref></char></note>rezirèksyon an gen tan fèt deja a, e konsa yo te boulvèse lafwa a kèk moun.<verse eid="2TI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 2:19" />Malgre <note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="ISA 28:16">És 28:16</ref></char></note>fondasyon Bondye a kanpe byen fèm, e li gen so sila a sou li: “Senyè a konnen sila ki pou Li yo”, epi: “Ke tout moun ki nonmen non Senyè a rete lwen mechanste.”<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />Alò, nan yon gran mezon, pa gen sèlman veso an lò ak lajan, men osi veso an bwa ak kanari. <note caller="+" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="ROM 9:21">Wo 9:21</ref></char></note>Yon pati pou onore e yon pati pou dezonore. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />Konsa, si yon nonm netwaye tèt li de <note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="2TI 2:16-18">II Tim 2:16-18</ref></char></note>bagay sa yo, li va yon veso lonè, sanktifye, itil pou Mèt la, prepare pou tout bon zèv.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />Alò, sove kite move dezi a jenès yo; men pouswiv ladwati, lafwa, lanmou ak lapè, avèk sila ki rele non Senyè yo <note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="1TI 1:5">I Tim 1:5</ref></char></note>avèk yon kè ki san tach. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />Men refize diskisyon ki sòt e san bon rezon yo, paske ou konnen ke y ap <note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="TIT 3:9">Tit 3:9</ref></char></note>prodwi konfli.<verse eid="2TI 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2TI 2:24" />Yon sèvitè-atache nèt a Senyè a pa dwe renmen fè kont, men se pou li janti ak tout moun, avèk <note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="1TI 3:2">I Tim 3:2</ref></char></note>yon kapasite pou l enstwi e pasyan lè yo fè li lenjistis, <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />avèk dousè, korije sila ki nan opozisyon yo, pou <note caller="+" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="ACT 8:22">Trav 8:22</ref></char></note>si petèt Bondye kapab bay yo repantans k ap mennen yo a <note caller="+" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="1TI 2:4">I Tim 2:4</ref></char></note>konesans verite a, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />pou yo kapab twouve bon sans pa yo, pou chape anba <note caller="+" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="1TI 3:7">I Tim 3:7</ref></char></note>pèlen a Dyab la, ki kenbe yo kaptif pou fè volonte l.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />Men konprann sa, ke <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="1TI 4:1">I Tim 4:1</ref></char></note>nan dènye jou yo, tan difisil yo va vini. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />Paske lèzòm va renmen pwòp tèt yo <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="LUK 16:14">Luc 16:14</ref></char></note>renmen lajan, <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="ROM 1:30">Wo 1:30</ref></char></note>ògeye, awogan, blasfematè, dezobeyisan a paran yo, engra, san lafwa, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" /><note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ROM 1:31">Wo 1:31</ref></char></note>san lanmou, san kapasite pou antann yo, medizan <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="1TI 3:11">I Tim 3:11</ref></char></note>san kontwòl tèt yo, brital, moun ki rayi sa ki bon, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />trèt, enpridan awogan, renmen plezi olye de renmen Bondye; <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />k ap kenbe yon fòm <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="1TI 3:6">I Tim 3:6</ref></char></note>sentete, sepandan yo nye pouvwa li.</para>
  <para style="p" vid="2TI 3:5">Evite moun konsa yo. <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />Paske pami yo menm, gen moun ki <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="JUD 1:4">Jd 1:4</ref></char></note>antre nan kay yo e pran an kaptif fanm ki fèb akoz chaj peche yo, e ki mennen pa <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="TIT 3:3">Tit 3:3</ref></char></note>move lanvi de tout kalite, <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />k ap toujou aprann e ki pa janm <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="2TI 2:25">II Tim 2:25</ref></char></note>rive a konesans verite a.<verse eid="2TI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 3:8" />Jis jan ke Jannès ak Jambrès te opoze a Moïse la, konsa moun sa yo opoze verite a; <note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="1TI 6:5">I Tim 6:5</ref></char></note>lèzòm ak lespri konwonpi, ki rejte sa ki konsène lafwa a.<verse eid="2TI 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 3:9" />Men yo p ap fè plis pwogrè, paske <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="LUK 6:11">Luc 6:11</ref></char></note>foli yo va parèt klè a tout moun, jis jan ke foli a Jannès ak Jambrès te osi parèt a klè a.<verse eid="2TI 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />Alò, ou te <note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="1TI 4:6">I Tim 4:6</ref></char></note>swiv ansègnman mwen an, kondwit, bi, lafwa, pasyans <note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="1TI 6:11">I Tim 6:11</ref></char></note>lanmou, pèseverans <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" /><note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="2CO 11:23-27">II Kor 11:23-27</ref></char></note>pèsekisyon, ak soufrans, jan sa te rive m Antioche, Icone ak Lystre la. <note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ROM 15:31">Wo 15:31</ref></char></note>A la pèsekisyon m te andire, e nan yo tout, Senyè a te delivre m! <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />Vrèman, tout moun ki dezire viv yon vi sentete nan Kris Jésus <note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="JHN 15:20">Jn 15:20</ref></char></note>va pèsekite.<verse eid="2TI 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 3:13" />Men moun mechan ak moun twonpè yo va avanse soti nan mal pou rive nan pi mal <note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="TIT 3:3">Tit 3:3</ref></char></note>nan twonpe moun ak vin twonpe.<verse eid="2TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14" />Sepandan, ou menm <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="TIT 1:13">Tit 1:13</ref></char></note>kontinye nan bagay ke ou te aprann yo, e vin konvenk, nan konnen de ki moun ou te aprann yo a. <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />Depi timoun, ou te konnen <note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="JHN 5:47">Jn 5:47</ref></char></note>Lekriti sakre yo, ki kapab <note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="PSA 119:98">Sòm 119:98</ref></char></note>bay ou sajès ki mennen moun a sali atravè lafwa ki nan Kris Jésus a.<verse eid="2TI 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 3:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:16 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:23">Wo 4:23</ref>
      </char>
    </note>Tout lekriti sen an enspire pa Bondye, e pwofitab pou enstwi, pou konvenk, pou korije, e pou fòme moun nan ladwati. <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />Konsa, chak moun Bondye a kapab konplè e byen <note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="2TI 2:21">II Tim 2:21</ref></char></note>prepare pou tout bon zèv.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Mwen anchaje ou solanèlman, nan prezans Bondye ak Kris Jésus a, ki <note caller="+" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="ACT 10:42">Trav 10:42</ref></char></note>dwe jije vivan ak mò yo, pa aparans ak wayòm Li an: <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />Preche <note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="COL 4:3">Kol 4:3</ref></char></note>pawòl la; pa neglije fè l ni nan sezon favorab ak nan lè l pa favorab; <note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="1TI 5:20">I Tim 5:20</ref></char></note>reprimande, repwoche, egzòte, avèk anpil pasyans ak enstriksyon.<verse eid="2TI 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 4:3" />Paske <note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="2TI 3:1">II Tim 3:1</ref></char></note>tan an va vini lè yo pa sipòte doktrin ki sen yo, men akoz yo vle sa ki fè zòrèy yo plezi, yo va ranmase pou kont yo, pwofesè ki dakò avèk pwòp dezi pa yo. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />Konsa, <note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="2TH 2:11">II Tes 2:11</ref></char></note>yo va vire zòrèy yo kite verite a akote pou fo istwa yo.<verse eid="2TI 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TI 4:5" />Men ou menm, rete tanpere nan tout bagay, sipòte difikilte yo, fè travay a yon evanjelis, akonpli <note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="EPH 4:12">Ef 4:12</ref></char></note>ministè ou la.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />Paske mwen deja ap <note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PHP 2:17">Fil 2:17</ref></char></note>vide kòm yon ofrann bwason, e <note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PHP 1:23">Fil 1:23</ref></char></note>lè pou m ale a gen tan rive. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" /><note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="1CO 9:25">I Kor 9:25</ref></char></note>Mwen mennen bon konba a, mwen fin fè kous la, mwen kenbe lafwa. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />A lavni m ap <note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="COL 1:5">Kol 1:5</ref></char></note>gen kouwòn ladwati a, ki prepare pou mwen deja, ke Senyè a, jij ladwati a, va ban m nan <note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="2TI 1:12">II Tim 1:12</ref></char></note>jou sila a; e pa sèlman de mwen menm, men osi a tout moun ki renmen aparisyon Li an.<verse eid="2TI 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:9 </char>
      <char style="xt" closed="false">
        <ref loc="2TI 1:4">II Tim 1:4</ref>
      </char>
    </note>Fè tout efò pou vini kote mwen byen vit, <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />paske <note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="COL 4:14">Kol 4:14</ref></char></note>Démas, ki renmen <note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="1TI 6:17">I Tim 6:17</ref></char></note>mond prezan sila a, te abandone m, e te ale Thessalonique. Crescens te ale Galatie, Tite te ale Dalmatie. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />Se sèl <note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="COL 4:14">Kol 4:14</ref></char></note>Luc ki avè m. Pran Marc e mennen l vini avè w, paske li itil a mwen pou zèv mwen an. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />Men <note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">Trav 20:4</ref></char></note>Tychique, mwen te voye li Éphèse. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />Lè ou vini, pote manto ke m te kite <note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="ACT 16:8">Trav 16:8</ref></char></note>Troas avèk Carpus la, menm ak liv yo, sitou woulo yo.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:14 </char>
      <char style="xt" closed="false">
        <ref loc="1TI 1:20">I Tim 1:20</ref>
      </char>
    </note>Alexandre, bòs fòjewon an, te fè mwen anpil mal. Senyè a va rann li sa selon zèv li. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />Veye kont li ou menm, paske li te opoze ak fòs a enstriksyon nou an.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />Nan premye defans mwen an, pèsòn pa t ban m soutyen yo, men yo tout te kite m. <note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ACT 7:60">Trav 7:60</ref></char></note>Ke sa pa kontwole kont yo. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />Men Senyè a te kanpe avèk mwen e te <note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="1TI 1:12">I Tim 1:12</ref></char></note>ban m fòs pou pwoklamasyon an ta kapab <note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="2TI 4:5">II Tim 4:5</ref></char></note>fin akonpli nèt, e pou tout pèp etranje yo kapab tande. Se konsa, mwen te sove soti nan bouch a lyon an.<verse eid="2TI 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TI 4:18" />Anplis, Senyè a va delivre m de tout zèv mechan yo, e va mennen m san danje nan <note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="1CO 15:50">I Kor 15:50</ref></char></note>wayòm selès Li a. A Li menm, laglwa pou tout tan e pou tout tan. Amen.<verse eid="2TI 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />Salye Prisca ak <note caller="+" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">Trav 18:2</ref></char></note>Aquillas, ak <note caller="+" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="2TI 1:16">II Tim 1:16</ref></char></note>tout kay Onésiphore a.<verse eid="2TI 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 4:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:20 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:22">Trav 19:22</ref>
      </char>
    </note>Éraste te rete Corinthe, men <note caller="+" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="ACT 20:4">Trav 20:4</ref></char></note>Trophime, mwen te kite li malad Milet.<verse eid="2TI 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2TI 4:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:21 </char>
      <char style="xt" closed="false">
        <ref loc="2TI 4:9">II Tim 4:9</ref>
      </char>
    </note>Fè tout efò pou vini avan sezon livè a. Eubulus salye ou, Pudens, Linus, Claudia, ak tout frè yo salye ou osi.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />Ke <note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="PHP 4:23">Fil 4:23</ref></char></note>Senyè a avèk lespri ou. Ke lagras avèk ou.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>