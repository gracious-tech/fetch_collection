<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id" />
  <para style="h">II Korentyen Yo</para>
  <para style="toc1">II KORENTYEN YO</para>
  <para style="toc2">II Korentyen Yo</para>
  <para style="toc3">II Kor</para>
  <para style="mt1">2 KORENTYEN YO</para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />Paul, yon apot Kris Jésus <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1CO 1:1">I Kor 1:1</ref></char></note>pa volonte Bondye, e Timothée, frè nou, <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1CO 10:32">I Kor 10:32</ref></char></note>a legliz Bondye ki nan Corinthe lan, avèk tout sen ki toupatou nan vil Achaïe yo: <verse eid="2CO 1:1" /><verse number="2" style="v" sid="2CO 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ROM 1:7">Wo 1:7</ref></char></note>Lagras avèk nou ak lapè ki sòti nan Bondye, Papa nou an, ak Senyè a Jésus Kri.<verse eid="2CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:3 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 1:3">Ef 1:3</ref>
      </char>
    </note>Beni se Bondye ak Papa a Senyè nou an Jésus Kri, Papa a mizerikòd yo, e Bondye a tout rekonfò yo; <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />ki <note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="ISA 51:12">És 51:12</ref></char></note>rekonfòte nou nan tout afliksyon nou yo pou nou kapab rekonfòte sila ki nan nenpòt afliksyon avèk menm rekonfò ke nou menm te rekonfòte pa Bondye a. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />Paske menm jan <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="2CO 4:10">II Kor 4:10</ref></char></note>ke soufrans a Kris yo se pou nou an abondans, konsa tou rekonfò nou an abondans atravè Kris la. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />Men si nou aflije, se <note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2CO 4:15">II Kor 4:15</ref></char></note>pou rekonfò ak sali de nou menm. Si nou rekonfòte, se pou rekonfò pa nou, ki efikas pou nou ka sipòte avèk pasyans, menm soufrans ke nou menm isit la ap soufri yo tou. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />Konsa, espwa nou pou ou tout fonde byen fèm paske nou konnen <note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="ROM 8:17">Wo 8:17</ref></char></note>menm jan ke ou pataje soufrans nou yo avèk nou, ou menm tou ap pataje rekonfò nou yo.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />Paske nou pa vle nou inyoran, frè m yo, de <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="ACT 19:23">Trav 19:23</ref></char></note>afliksyon ki te vini sou nou an Asie yo, ke nou te peze anpil anpil, menm depase fòs nou, pou nou te kab menm vin dezespere de lavi nou. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />Vrèman, nou te gen yon kondanasyon lanmò anndan nou, pou nou pa mete konfyans nan tèt nou, men nan Bondye ki fè mò yo leve a, <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />ki te delivre nou soti de yon si gran danje lanmò, e Li va delivre nou. Se <note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="1TI 4:10">I Tim 4:10</ref></char></note>sou Li menm nou te mete tout espwa nou an. Epi Li va toujou delivre nou; <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />nou osi ki jwenn avèk nou menm nan lapriyè, pou remèsiman kapab bay pa <note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2CO 4:15">II Kor 4:15</ref></char></note>anpil moun pou nou, pou gras ke nou resevwa atravè priyè anpil moun.<verse eid="2CO 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />Paske konfyans fyète nou an se sa; temwayaj <note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 23:1">Trav 23:1</ref></char></note>konsyans nou, ke nan sentete avèk senserite anvè Bondye, pa nan sajès lachè men nan gras Bondye a, nou kondwi tèt nou nan mond lan, e sitou vè nou menm. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />Paske nou pa ekri okenn lòt bagay bannou, sof ke sa nou kapab li ak konprann, e m espere ke nou va konprann <note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="1CO 1:8">I Kor 1:8</ref></char></note>jiska lafen. <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />Menm jan ou te osi konprann nou nan yon pati a, ke ou se rezon fyète nou nan <note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="1CO 1:8">I Kor 1:8</ref></char></note>jou a Senyè nou an Jésus, menm jan tou ke ou se rezon fyète pa nou an.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />Epi premyèman, se te nan konfyans sila ke m te gen entansyon pou vin kote nou an, pou nou ta kapab resevwa yon <note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ROM 1:11">Wo 1:11</ref></char></note>benediksyon doub. <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />Sa vle di, pou <note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="ACT 19:21">Trav 19:21</ref></char></note>pase kote nou nan antre Macédoine, e osi nan soti Macédoine pou m vin kote nou, pou nou ta kapab ede m nan vwayaj mwen pou rive Judée. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />Konsa, èske m te varye lè m te fè nou konnen entansyon sa a? Oswa sa ke m te propoze a, èske m te propoze li <note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="2CO 10:2">II Kor 10:2</ref></char></note>selon lachè? Konsa, li ta sanble wi e non ansanm k ap di nan menm lè a? <verse eid="2CO 1:17" /><verse number="18" style="v" sid="2CO 1:18" />Men jan <note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="1CO 1:9">I Kor 1:9</ref></char></note>Bondye fidèl la, pawòl nou anvè ou menm se pa wi avèk non ansanm. <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />Paske <note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="MAT 4:3">Mat 4:3</ref></char></note>Fis Bondye a, Kris Jésus, ki te preche pami nou an, pa nou menm—mwen, Silvain, ak Timothée—pa t di wi e non, men te gen wi sèlman nan Li menm. <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />Paske malgre fòs kantite <note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="ROM 15:8">Wo 15:8</ref></char></note>pwomès Bondye yo kon bay, nan Li menm, pwomès yo se “wi”; konsa tou, pa Li menm tou, nou di “Amèn” pou laglwa Bondye atravè nou menm.<verse eid="2CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CO 1:21" />Koulye a, <note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="ROM 8:16">Wo 8:16</ref></char></note>Sila ki etabli nou avèk ou menm an Kris, epi ki te onksyone nou, se Bondye. <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />Se Li ki te mete so Li sou nou e te bannou Lespri a nan kè nou kòm yon pwomès.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />Men <note caller="+" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ROM 1:9">Wo 1:9</ref></char></note>mwen rele Bondye kòm temwen nanm mwen, ke se sèl pou m fè nou gras, m pa t vin Corinthe ankò. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />Se pa ke nou menm <note caller="+" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="2CO 4:5">II Kor 4:5</ref></char></note>ta domine fwa pa nou, men se ouvriye nou ye ansanm avèk ou pou lajwa ou. Paske nan lafwa a, ou deja kanpe fèm.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />Men mwen te deside sa pou koz pa mwen, pou mwen <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="1CO 4:21">I Kor 4:21</ref></char></note>pa ta vin kote nou menm nan tristès ankò. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />Paske si m <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="2CO 7:8">II Kor 7:8</ref></char></note>fè nou tris, kilès k ap fè m kontan, sof ke sila ke m te fè tris la. <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />Sa se menm bagay ke m te ekri nou an, jis pou lè m te vini, pou mwen pa ta twouve tristès nan sila ki ta dwe fè m rejwi yo. Paske mwen gen <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="GAL 5:10">Gal 5:10</ref></char></note>konfyans ke m gen nan nou tout la, pou lajwa pa m ta kapab lajwa pa nou tout. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />Paske se te nan anpil afliksyon ak soufrans nan kè mwen, ke m <note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="2CO 2:9">II Kor 2:9</ref></char></note>te ekri nou avèk anpil dlo nan zye; pa pou m ta fè nou tris, men pou nou ta kapab konnen lanmou pwofon ke mwen gen pou nou an.<verse eid="2CO 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />Men <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="1CO 5:1">I Kor 5:1</ref></char></note>si yon moun fè nou tris, se pa mwen li fè tris la, men, nan yon sèten sans, (jis pou m pa di twòp) a nou tout. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />Sifi pou yon moun konsa se <note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="1CO 5:4">I Kor 5:4</ref></char></note>pinisyon ki te enpoze pa majorite a. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />Donk okontrè, nou ta pito rekonfòte e <note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="GAL 6:1">Gal 6:1</ref></char></note>padone li, otreman pou yon moun konsa ta sibi yon tristès ki depase limit. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />Pou sa, mwen ankouraje nou pou fè l konnen ankò, lanmou nou gen anvè li a. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />Paske nan bi sa, mwen osi te ekri nou pou m te kapab teste nou, si nou <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="2CO 7:15">II Kor 7:15</ref></char></note>obeyisan nan tout bagay. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />Men sila ke nou te padone a, mwen te padone li tou; paske anverite, sa ke m te padone a, si vrèman mwen te padone yon bagay, mwen te fè l pou koz nou <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="1CO 5:4">I Kor 5:4</ref></char></note>nan prezans a Kris la <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />pou Satan pa t kab vin pwofite de nou; paske <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="LUK 22:31">Luc 22:31</ref></char></note>nou pa inyoran de manèv li yo.<verse eid="2CO 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />Alò, lè m te vini <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ACT 16:8">Trav 16:8</ref></char></note>Troas pou levanjil a Kris la, e lè <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ACT 14:27">Trav 14:27</ref></char></note>yon pòt te vin ouvri pou mwen nan Senyè a, <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />mwen <note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="2CO 7:5">II Kor 7:5</ref></char></note>pa t gen repo nan lespri mwen, akoz mwen pa t twouve Tite, frè mwen an. Konsa, mwen te kite yo, pou mwen te kontinye vè Macédoine.<verse eid="2CO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:14 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:8">Wo 1:8</ref>
      </char>
    </note>Men gras a Bondye, ki toujou mennen nou nan viktwa Li an Kris la, e ki toujou fè parèt nan nou yon pafen ki santi bon de konesans a Li nan tout kote. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />Paske nou se <note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="EPH 5:2">Ef 5:2</ref></char></note>odè santi bon a Kris la vè Bondye pami <note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="1CH 1:18">I Kwo 1:18</ref></char></note>sila k ap vin sove yo, e pami sila k ap peri yo. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" /><note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="LUK 2:34">Luc 2:34</ref></char></note>Pou youn, yon movèz odè ki soti nan lanmò pou rive nan lanmò, pou lòt la, yon odè ki soti nan lavi pou rive nan lavi. E kilès nan nou ki <note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="2CO 3:5">II Kor 3:5</ref></char></note>gen ase de fòs pou bagay sa yo? <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />Paske nou pa tankou anpil moun, k ap vann pawòl Bondye a. Men <note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="1CO 5:8">I Kor 5:8</ref></char></note> nan senserite, devan ze Bondye, nou pale nan Kris.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />Èske n ap kòmanse <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="2CO 5:12">II Kor 5:12</ref></char></note>bay pwòp tèt nou lwanj ankò? Oswa èske nou menm bezwen, tankou kèk lòt moun, lèt rekòmandasyon pou nou menm, oswa petèt ki sòti de nou menm? <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" /><note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="1CO 9:2">I Kor 9:2</ref></char></note>Nou menm nan legliz Korent se lèt nou, ki ekri nan kè nou, ki rekonèt e ki li pa tout moun. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />Li parèt klè ke nou se yon lèt ki sòti nan Kris la, ki pran swen pa nou menm, ki pa t ekri avèk lank, men avèk Lespri Bondye vivan an, pa sou tablèt wòch, men sou <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="PRO 3:3">Pwov 3:3</ref></char></note>tablèt kè lòm.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />Yon <note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="EPH 3:12">Ef 3:12</ref></char></note>konfyans konsa ke nou genyen atravè Kris la vè Bondye. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />Se pa ke nou ase fò nan nou menm pou konsidere ke tout bagay kapab sòti nan nou menm, men <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="1CO 15:10">I Kor 15:10</ref></char></note>fòs nou an soti nan Bondye. <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />Ki te osi fè nou ase fò tankou sèvitè a yon <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="JER 31:31">Jr 31:31</ref></char></note>akò tounèf, pa selon <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ROM 2:29">Wo 2:29</ref></char></note>lèt la, men selon Lespri a. Paske lèt la touye, men Lespri a bay lavi.<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />Men si <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 7:5">Wo 7:5</ref></char></note>zèv lanmò a, ak lèt la byen grave sou wòch te vini avèk glwa, <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="EXO 34:29-35">Egz 34:29-35</ref></char></note>jis pou fis Israël yo pa t kapab fikse atansyon yo sou figi Moïse akoz de glwa a figi li, malgre briyans lan te kòmanse ap bese, <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />kòman zèv Lespri a p ap vin pi fò avèk laglwa a? <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />Paske si zèv kondanasyon an gen glwa, konbyen anplis <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="ROM 1:17">Wo 1:17</ref></char></note>zèv ladwati a p ap ranpli avèk glwa? <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />Paske anverite, sa ki te gen glwa a, nan ka sa a pa gen glwa, akoz glwa ki depase l la. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />Paske si sa ki disparèt la te avèk glwa, bokou plis sa ki rete a gen glwa.<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />Konsa, akoz ke nou gen yon espwa parèy a sa a, <note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="ACT 4:13">Trav 4:13</ref>,<ref loc="ACT 4:29">29</ref></char></note>nou sèvi ak gran kouraj nan pawòl nou yo. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />Se pa tankou Moïse <note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 34:33-35">Egz 34:33-35</ref></char></note>ki te konn mete yon vwal sou figi l pou fis Israël yo pa t kab gade avèk atansyon sou fen sa ki t ap disparèt la. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />Men tèt yo te <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="ROM 11:7">Wo 11:7</ref></char></note>vin di; paske jis rive nan jou sa a, nan lekti ansyen akò a, <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="ACT 13:5">Trav 13:5</ref></char></note> menm vwal la rete toujou san leve, paske se jis nan Kris li vin leve. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />Men jis rive nan jou sa a, lè ekriti Moïse la vin li, yon vwal kouvri kè yo. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" /><note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="EXO 34:34">Egz 34:34</ref></char></note>Men nenpòt lè yon moun vire vè Senyè a, vwal la vin sòti. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />Alò, Senyè a se Lespri a; e kote Lespri Senyè a ye, <note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="JHN 8:32">Jn 8:32</ref></char></note>gen libète. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />Men nou tout, avèk figi devwale <note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="1CO 13:12">I Kor 13:12</ref></char></note>k ap gade tankou nan yon miwa laglwa Senyè a <note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ROM 8:29">Wo 8:29</ref></char></note>k ap transfòme nan menm imaj a glwa sa a, jis rive nan glwa ki sòti nan Senyè a, ki se Lespri a.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />Konsa, akoz ke nou gen ministè sa a, jan nou te <note caller="+" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="1CO 7:25">I Kor 7:25</ref></char></note>resevwa mizerikòd la, nou pa dekouraje. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />Men nou renonse a <note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="ROM 6:21">Wo 6:21</ref></char></note>bagay ki fèt an kachèt ki fè wont yo. Nou pa mache nan riz, ni nan kase fòs pawòl Bondye a ak desepsyon, men ak demonstrasyon verite a, nou rekòmande tèt nou a konsyans tout moun devan zye Bondye. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />Men si levanjil nou an <note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="1CO 2:6">I Kor 2:6</ref></char></note>vwale, li vwale pou sila k ap peri yo. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />Nan ka sila a, <note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="JHN 12:31">Jn 12:31</ref></char></note>dye a mond sa a <note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="2CO 3:14">II Kor 3:14</ref></char></note>vwale lespri a enkwayan yo pou yo pa wè limyè levanjil la, glwa a Kris la, ki se imaj a Bondye. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />Paske <note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="1CO 4:15">I Kor 4:15</ref></char></note>nou pa preche tèt nou, men Kris Jésus a kòm Senyè, epi nou menm kòm sèvitè a nou tout, pou kòz a Jésus. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />Paske se Bondye, ki te di: <note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="GEN 1:3">Jen 1:3</ref></char></note>“Limyè va klere nan tenèb la”. Se Li menm nan ki <note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="2PE 1:19">II Pi 1:19</ref></char></note>te briye nan kè nou pou bay limyè de konesans a glwa Bondye a, ki se nan figi Kris Jésus a.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />Men nou gen trezò sa a nan <note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="LAM 4:2">Lam 4:2</ref></char></note>po ki fèt avèk tè ajil, pou grandè a <note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="JDG 7:2">Jij 7:2</ref></char></note>pouvwa ki depase tout bagay la, kapab sòti nan Bondye e pa nan nou menm. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />Nou <note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="2CO 1:8">II Kor 1:8</ref></char></note>aflije nan tout fason, men nou pa kraze; nou nan konfizyon, men nou pa nan dezespwa, <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />pèsekite, men nou pa <note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="PSA 129:2">Sòm 129:2</ref></char></note>abandone. Nou pran so, men nou pa detwi. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" /><note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="ROM 6:5">Wo 6:5</ref></char></note>Nou toujou ap pote nan kò la, lanmò Jésus, pou lavi Jésus kapab vin parèt nan kò nou. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />Paske nou menm ki vivan yo toujou ap livre a lanmò pou kòz a Jésus, pou lavi Jésus kapab osi manifeste nan chè mòtèl nou an. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />Konsa, lanmò travay nan nou, men lavi nan ou.<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />Men avèk menm lespri lafwa a, selon sa ki ekri a: <note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="PSA 116:10">Sòm 116:10</ref></char></note>“Mwen te kwè, e akoz sa mwen te pale”, nou osi kwè, e akoz sa, nou pale; <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />avèk konesans ke Sila ki te <note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="ACT 2:24">Trav 2:24</ref></char></note>leve Senyè a Jésus <note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="1TH 4:14">I Tes 4:14</ref></char></note>va leve nou osi avèk Jésus e va prezante nou avèk nou menm. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />Paske tout bagay se pou koz a nou menm, pouke lagras k ap gaye a de plizanplis moun nan <note caller="+" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="ROM 8:28">Wo 8:28</ref></char></note>kapab koz anpil remèsiman pou laglwa Bondye.<verse eid="2CO 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />Donk, nou p ap dekouraje, men malgre ke lòm eksteryè nou ap dekonpoze <note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ROM 7:22">Wo 7:22</ref></char></note>deja lòm enteryè nou ap renouvle de jou an jou. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />Paske ti afliksyon <note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="ROM 8:18">Wo 8:18</ref></char></note>pou yon ti tan an ap pwodwi pou nou yon pwa laglwa etènèl ki depase tout konparezon, <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />pandan <note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="ROM 8:24">Wo 8:24</ref></char></note>nou p ap gade bagay ki vizib, men bagay ki pa vizib. Paske bagay vizib yo se pou yon ti moman, men bagay ki pa vizib yo se pou tout letènite.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />Paske nou konnen ke si <note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="JOB 4:19">Job 4:19</ref></char></note>tant tèrès la ki se lakay nou an vin demoli, nou gen yon kay ki sòti nan Bondye; yon kay ki <note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="ACT 7:48">Trav 7:48</ref></char></note>pa fèt avèk men, ki etènèl nan syèl la. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />Paske vrèman, nan kay sila a, nou <note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="ROM 8:23">Wo 8:23</ref></char></note>plenyen avèk lanvi pou nou abiye nou ak kay nou ki nan syèl la; <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />kòmsi nou konnen ke lè nou fin mete li, nou p ap janm toutouni ankò. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />Paske vrèman, pandan nou nan tant kò sa a, nou plenyen, nou anba gwo fado, paske nou pa vle dezabiye nou, men abiye nou, jis pou sa ki mòtèl la kapab anglouti pa lavi etènèl. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />Alò, Sila ki te prepare nou pou menm bi sa a, se Bondye, ki te <note caller="+" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="ROM 8:23">Wo 8:23</ref></char></note>bannou Lespri Sen kòm yon pwomès la.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />Konsa, toujou avèk bon kouraj, ak konesans ke <note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="HEB 11:13">Eb 11:13</ref></char></note>pandan nou lakay nou nan kò a, nou absan de Senyè a, <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />paske <note caller="+" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="1CH 13:12">I Kwo 13:12</ref></char></note>nou mache pa lafwa, e pa selon sa nou wè. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />Men, mwen di nou, nou gen bon kouraj. Nou prefere pito absan de kò a pou prezan <note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="JHN 12:26">Jn 12:26</ref></char></note>lakay nou avèk Senyè a. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />Konsa nou gen osi kòm dezi, pou, kit nou lakay, kit nou absan, <note caller="+" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="ROM 14:18">Wo 14:18</ref></char></note>pou fè Li menm plezi. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />Paske nou tout dwe parèt devan <note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="MAT 16:27">Mat 16:27</ref></char></note>chèz jijman a Kris la, pou chak moun kapab rekonpanse pou zèv li nan kò a, selon sa li te fè, kit byen kit mal.<verse eid="2CO 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />Konsa, avèk konesans lakrent Senyè a, nou menm ap fè tout moun kwè, men nou vin rekonèt devan Bondye; epi mwen espere ke nou <note caller="+" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="2CO 4:2">II Kor 4:2</ref></char></note>rekonèt nan konsyans pa nou yo tou. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />Nou p ap vin pale byen de pwòp tèt nou bannou ankò, men <note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CO 1:14">II Kor 1:14</ref></char></note>n ap bannou yon okazyon pou vin fyè de nou, pou nou kab gen yon repons a sila ki jwenn fyète nan aparans, men pa nan kè. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />Paske si nou vin <note caller="+" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="MRK 3:21">Mc 3:21</ref></char></note>debòde, se pou Bondye. Epi si nou nan bon sans nou, se pou nou menm. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />Paske lanmou Kris la k ap bourade nou. Konsa li mennen nou a konklizyon sa a; ke <note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="ROM 5:15">Wo 5:15</ref></char></note>yon moun te mouri pou tout moun, kidonk, tout moun te mouri. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />Li te mouri pou tout moun, pouke sila ki vivan yo pa ta <note caller="+" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="ROM 14:7-9">Wo 14:7-9</ref></char></note>viv pou tèt yo ankò, men pou Li menm ki te mouri an e ki te leve ankò pou yo a.<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />Pou sa a, depi koulye a nou pa rekonèt okenn moun <note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="JHN 8:15">Jn 8:15</ref></char></note>selon lachè. Malgre ke nou te konnen Kris selon lachè, deja koulye a nou pa konnen Li fason sa a ankò. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />Donk Si yon moun nan Kris, Li se yon kreyati tounèf. <note caller="+" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ISA 43:18">És 43:18</ref></char></note>Ansyen bagay yo vin pase. Gade byen, tout bagay vin tounèf. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />Konsa, tout bagay sa yo sòti nan Bondye <note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="ROM 5:10">Wo 5:10</ref></char></note>ki te rekonsilye nou a Li menm pa Kris la, e ki te bannou ministè rekonsilyasyon an. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />Kòmsi ke <note caller="+" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="COL 2:9">Kol 2:9</ref></char></note>Bondye te nan Kris ki t ap rekonsilye mond lan a Li menm, san konte ofans pa yo kont yo menm, e Li te livre bannou, pawòl a rekonsilyasyon an.<verse eid="2CO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20" />Konsa, nou se ambasadè pou Kris, tankou si Bondye t ap sèvi nou pou sipliye lòt. Pou sa a, nou priye nou nan non a Kris la <note caller="+" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="ROM 5:10">Wo 5:10</ref></char></note>pou nou vin rekonsilye ak Bondye. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />Li te fè Sila ki <note caller="+" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="HEB 4:15">Eb 4:15</ref></char></note>pa t konnen okenn peche a devni peche pou nou menm, pou nou ta kapab devni ladwati Bondye nan Li menm.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />Epi nan <note caller="+" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="1CO 3:9">I Kor 3:9</ref></char></note>travay ansanm avèk Li menm, nou osi ankouraje ou pou nou pa resevwa lagras Bondye a anven. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />Paske Li di:</para>
  <para style="q1" vid="2CO 6:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:2 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:8">És 49:8</ref>
      </char>
    </note>“Nan tan akseptab la Mwen te koute nou,</para>
  <para style="q1" vid="2CO 6:2">e nan jou sali a Mwen te ede nou”.</para>
  <para style="p" vid="2CO 6:2">Gade byen, koulye a se “tan akseptab la”. Gade byen, koulye a se “jou sali a”. <verse eid="2CO 6:2" /><verse number="3" style="v" sid="2CO 6:3" />Konsa,<note caller="+" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="1CO 8:9">I Kor 8:9</ref>,<ref loc="1CO 8:13">13</ref></char></note>Nou p ap bay kòz pou ofans nan anyen, pou ministè a pa vin pèdi valè li. <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />Men nan tout bagay pou n ap rekòmande tèt nou kòm sèvitè a Bondye: nan<note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="ACT 9:16">Trav 9:16</ref></char></note>anpil andirans, nan afliksyon, difikilte, ak detrès <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />nan <note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="ACT 16:23">Trav 16:23</ref></char></note>pran kou, nan pran prizon, nan twoub, nan travay di, nan san dòmi <note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="1CO 4:11">I Kor 4:11</ref></char></note>nan grangou <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />nan lavi dwat, nan konesans, nan pasyans, nan bonte, nan <note caller="+" style="x"><char style="xo" closed="false">6:6 </char><char style="xt" closed="false"><ref loc="1CO 2:4">I Kor 2:4</ref></char></note>Lespri Sen an, nan vrè lanmou an <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />nan pawòl verite a, nan <note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="1CO 2:5">I Kor 2:5</ref></char></note>pwisans Bondye a; ak <note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="2CO 10:4">II Kor 10:4</ref></char></note>zam ladwati pou men dwat ak men goch yo, <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />pa laglwa ak <note caller="+" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="1CH 4:10">I Kwo 4:10</ref></char></note>wont, pa move rapò ak bon rapò, gade kòm mantè yo, malgre sa nan verite a; <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />kòm enkoni malgre byen koni, kòm moun k ap mouri men gade, nou byen <note caller="+" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="2CO 1:8">II Kor 1:8</ref>,<ref loc="2CO 1:10">10</ref></char></note>vivan; kon sila ke y ap pini, men poko mete a lanmò, <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />kòm <note caller="+" style="x"><char style="xo" closed="false">6:10 </char><char style="xt" closed="false"><ref loc="JHN 16:22">Jn 16:22</ref></char></note>plen ak tristès men toujou ap rejwi, kòm <note caller="+" style="x"><char style="xo" closed="false">6:10 </char><char style="xt" closed="false"><ref loc="2CO 8:9">II Kor 8:9</ref></char></note>pòv, men ap fè anpil moun rich, kòm yon moun ki pa genyen anyen men ki posede tout bagay.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:11 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 33:22">Éz 33:22</ref>
      </char>
    </note>Bouch nou pale avèk libète ak nou menm, o Korentyen yo. Kè nou ouvri byen laj. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />Nou pa anpeche nou, men <note caller="+" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="2CO 7:2">II Kor 7:2</ref></char></note>ou anpeche nan pwòp afeksyon pa w. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />Koulye a, <note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="1CO 4:14">I Kor 4:14</ref></char></note>nan yon echanj konsa—-m ap pale kòmsi se ak timoun mwen yo—-ouvri kè nou laj pou nou tou.<verse eid="2CO 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />Pa mare ansanm avèk enkwayan yo; paske <note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="EPH 5:7-11">Ef 5:7-11</ref></char></note>ki relasyon ki gen antre ladwati ak inikite, oswa ki rapò ki genyen antre limyè ak tenèb? <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />Oubyen ki <note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="1CO 10:21">I Kor 10:21</ref></char></note>amitye Kris gen avèk Bélial, oswa kisa yon kwayan gen an komen avèk yon enkwayan? <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />Oswa, ki akò tanp Bondye a gen avèk zidòl yo? Paske nou se tanp a Bondye vivan an. Jan Bondye te di a: <note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="EXO 29:45">Egz 29:45</ref></char></note>“Mwen va viv nan yo e mache pami yo. Mwen va Bondye pa yo e yo va pèp Mwen.” <verse eid="2CO 6:16" /><verse number="17" style="v" sid="2CO 6:17" /><note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="ISA 52:11">És 52:11</ref></char></note>Konsa,</para>
  <para style="q1" vid="2CO 6:17">“‘Soti nan mitan yo,</para>
  <para style="q1" vid="2CO 6:17">e separe de yo’, di Senyè a.</para>
  <para style="q1" vid="2CO 6:17">‘Pa touche sa ki enpi.</para>
  <para style="q1" vid="2CO 6:17">Mwen va akeyi nou.<verse eid="2CO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:18 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:14">II Sam 7:14</ref>
      </char>
    </note>Mwen va yon Papa pou nou,</para>
  <para style="q1" vid="2CO 6:18">e nou va fis ak fi pou Mwen,’</para>
  <para style="p" vid="2CO 6:18">di Senyè Tou Pwisan an.”<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />Konsa, paske nou gen pwomès sa yo byeneme, <note caller="+" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="1PE 1:15">I Pi 1:15</ref></char></note>annou netwaye tèt nou de tout salte lachè ak lespri, e vin konplete lasentete nan lakrent Bondye.<verse eid="2CO 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:2 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 6:12">II Kor 6:12</ref>
      </char>
    </note>Fè espas pou nou nan kè nou. Nou pa t fè pèsòn mal. Nou pa t fè pèsòn vin konwonpi, ni nou pa t pran avantaj sou okenn moun. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />Mwen pa pale pou kondane nou, paske Mwen te di <note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="2CO 6:11">II Kor 6:11</ref></char></note>avan sa, nou nan kè nou jis nou rive mouri ansanm e viv ansanm. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />Konfyans mwen gen nan nou an gran. <note caller="+" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="2CO 7:14">II Kor 7:14</ref></char></note>Fyète m lè m nonmen non nou an gran. Mwen ranpli avèk <note caller="+" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="2CO 1:4">II Kor 1:4</ref></char></note>rekonfò. M ap debòde avèk lajwa nan tout afliksyon nou yo.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />Paske menm lè nou te vini Macédoine, chè nou pa t gen okenn repo, men nou te <note caller="+" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="2CO 4:8">II Kor 4:8</ref></char></note>aflije toupatou: <note caller="+" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="DEU 32:25">Det 32:25</ref></char></note>konfli deyò, laperèz anndan. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />Men Bondye, ki rekonfòte sila k ap viv nan afliksyon yo, te rekonfòte nou lè <note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="2CO 2:13">II Kor 2:13</ref></char></note>Tite te vini an. <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />Pa sèlman vini li an, men osi pa rekonfò avèk sila li te rekonfòte nou an, lè li te bannou rapò de dezi nou genyen an, tristès nou, zèl ke nou te gen pou mwen an; pou m te rejwi plis toujou.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />Paske malgre ke m te <note caller="+" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="2CO 2:2">II Kor 2:2</ref></char></note>koze tristès pa lèt mwen an, mwen pa regrèt sa; sepandan mwen te regrèt li. Paske mwen wè ke lèt sa a te koze tristès nou, malgre sèlman pou yon ti tan. <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />Koulye a, mwen rejwi, pa paske mwen te fè nou tris, men ke nou te vin tris jis pou mennen nou a larepantans. Paske mwen te fè nou tris selon volonte Bondye, jis pou nou pa ta soufri pèt nan okenn bagay akoz nou menm. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />Paske tristès ki selon volonte Bondye a prodwi yon <note caller="+" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="ACT 11:18">Trav 11:18</ref></char></note>repantans ki san regrè, ki mennen nan sali; men tristès a mond lan prodwi lanmò. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />Paske gade byen avèk ki senserite menm bagay sa a, tristès sa ki sòti nan Bondye a, te vin prodwi nan nou. Kèl jistifikasyon pou nou menm, kèl endiyasyon, kèl krent, kèl <note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="2CO 7:7">II Kor 7:7</ref></char></note>dezi, kèl zèl, kèl retribisyon kont lemal. Nan tout bagay nou te montre a tèt nou, nou inosan nan zafè sila a. <verse eid="2CO 7:11" /><verse number="12" style="v" sid="2CO 7:12" />Donk, malgre <note caller="+" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="2CO 2:3">II Kor 2:3</ref>,<ref loc="2CO 2:9">9</ref></char></note>m te ekri nou, se pa t pou koz a sila ki te fè ofans lan, ni pou koz a sila ki te donmaje a, men pou Bondye ta kapab konfime nan ou senserite ou anvè nou menm. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />Pou rezon sa a, nou te rekonfòte. Epi anplis de rekonfò nou, nou te rejwi menm plis pou lajwa a Tite, paske lespri li te vin rafrechi pa nou tout. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />Paske si nan yon bagay mwen te <note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="2CO 7:4">II Kor 7:4</ref></char></note>fè nou konpliman a li menm, nou pa t fè m wont. Men menm jan ke nou te pale tout bagay anverite a nou menm nan, menm jan an osi tout konpliman nou te pale Tite de nou te vin fè prèv ke se te verite. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />Afeksyon Li anvè nou ap vin plis toujou lè li sonje obeyisans nou tout, jan nou te resevwa li avèk <note caller="+" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="1CO 2:3">I Kor 2:3</ref></char></note>lakrent e avèk tranbleman. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />Mwen rejwi ke nan tout bagay <note caller="+" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="2CO 2:3">II Kor 2:3</ref></char></note>mwen gen konfyans nan nou.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />Koulye a, frè nou yo, nou ta renmen fè nou konnen lagras Bondye <note caller="+" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="2CO 8:5">II Kor 8:5</ref></char></note>ki te vin bay nan legliz Macédoine yo. <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />Ke nan yon gran eprèv afliksyon, abondans lajwa ak gwo povrete, yo te debòde jis li vin <note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="ROM 2:4">Wo 2:4</ref></char></note>richès nan jenewozite yo. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />Paske mwen temwaye ke <note caller="+" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="1CO 16:2">I Kor 16:2</ref></char></note>selon kapasite yo, e menm depase kapasite yo, yo te bay selon pwòp volonte pa yo. <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />Yo t ap byen plede avèk nou avèk anpil ankourajman, pou favè pran pa nan <note caller="+" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="ROM 15:31">Wo 15:31</ref></char></note>soutyen a fidèl yo. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />Epi sa menm, se pa jan nou te prevwa a, men yo te dabò bay tèt yo a Senyè a, e a nou menm <note caller="+" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="1CO 1:1">I Kor 1:1</ref></char></note>selon volonte Bondye. <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />Donk, nou te <note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="2CO 8:17">II Kor 8:17</ref></char></note>ankouraje Tite ke, jan li te kòmanse oparavan an, pou li ta osi konplete nan nou zèv gras sila a. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />Men menm jan nou toujou <note caller="+" style="x"><char style="xo" closed="false">8:7 </char><char style="xt" closed="false"><ref loc="2CO 9:8">II Kor 9:8</ref></char></note>fè ekselans ki depase <note caller="+" style="x"><char style="xo" closed="false">8:7 </char><char style="xt" closed="false"><ref loc="1CO 1:5">I Kor 1:5</ref></char></note>nan tout bagay, nan lafwa, nan langaj, nan konesans, nan zèl, ak nan lanmou ke nou te enspire nan ou an, gade ke ou depase osi nan zèv lagras sila a.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />Mwen <note caller="+" style="x"><char style="xo" closed="false">8:8 </char><char style="xt" closed="false"><ref loc="1CO 7:6">I Kor 7:6</ref></char></note>p ap pale sa tankou se yon lòd, men pou pwouve selon zèl a lòt yo, senserite lanmou pa nou tou. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />Paske nou konnen lagras Senyè nou an Jésus Kri, ke <note caller="+" style="x"><char style="xo" closed="false">8:9 </char><char style="xt" closed="false"><ref loc="PHP 2:6">Fil 2:6</ref></char></note>malgre Li te rich, pou koz nou, Li te vin pòv, pouke, nou menm, atravè povrete Li, nou ta kapab vin rich. <verse eid="2CO 8:9" /><verse number="10" style="v" sid="2CO 8:10" />Mwen bay opinyon mwen nan ka sa a, paske sa se nan avantaj pa nou, ki, lane pase, te premye moun <note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="1CO 16:2">I Kor 16:2</ref></char></note>ki te kòmanse fè non sèlman sa, men osi te gen volonte pou fè l. <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />Men koulye a, fin fè li. Menm jan nou te gen <note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="2CO 8:12">II Kor 8:12</ref>,<ref loc="2CO 8:19">19</ref></char></note>bòn volonte pou fè l la, pou li kapab osi konplete pa kapasite nou. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />Paske si volonte a la, li akseptab <note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MRK 12:43">Mc 12:43</ref></char></note>selon sa ke yon moun genyen, pa selon sa ke li pa genyen. <verse eid="2CO 8:12" /><verse number="13" style="v" sid="2CO 8:13" />Paske sa se pa pou fè lòt yo alèz, pandan nou pote gwo chaj, men pou gen egalite. <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />Nan tan prezan sila, abondans nou la pou satisfè <note caller="+" style="x"><char style="xo" closed="false">8:14 </char><char style="xt" closed="false"><ref loc="ACT 4:34">Trav 4:34</ref></char></note>bezwen pa yo, pouke abondans pa yo osi kapab vin yon sous pou bezwen pa nou, pouke kapab gen egalite. <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />Jan sa ekri a: <note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="EXO 16:18">Egz 16:18</ref></char></note>“Sila ki te ranmase anpil la, pa t gen depase, e sila ki te ranmase piti a pa t manke.”<verse eid="2CO 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />Men <note caller="+" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="2CO 2:14">II Kor 2:14</ref></char></note>gras a Bondye ki <note caller="+" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="REV 17:17">Rev 17:17</ref></char></note>mete menm zèl la pou nou nan kè Tite la. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />Paske li pa t sèlman aksepte <note caller="+" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="2CO 8:6">II Kor 8:6</ref></char></note>apèl nou, men akoz li te trè zele, li te vin kote nou ak pwòp volonte li. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />Epi nou te voye avèk li <note caller="+" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="1CO 16:3">I Kor 16:3</ref></char></note>frè a ki gen bon repitasyon nan bagay levanjil ki te gaye pami tout legliz yo. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />Epi se pa sèlman sa, men li te osi <note caller="+" style="x"><char style="xo" closed="false">8:19 </char><char style="xt" closed="false"><ref loc="1CO 16:3">I Kor 16:3</ref></char></note>chwazi pa legliz yo pou vwayaje avèk nou nan zèv lagras sila ke n ap administre pou glwa a Senyè a Li menm, e pou montre bòn volonte nou. <verse eid="2CO 8:19" /><verse number="20" style="v" sid="2CO 8:20" />N ap pran prekosyon pou pèsòn pa vin denigre administrasyon nou nan kado jenewozite sila a. <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />Paske nou <note caller="+" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="ROM 12:17">Wo 12:17</ref></char></note>respekte sa ki onorab, non sèlman nan zye Senyè a, men osi nan zye lèzòm. <verse eid="2CO 8:21" /><verse number="22" style="v" sid="2CO 8:22" />Nou te voye avèk yo, frè nou an, ke nou souvan teste, e twouve zèl nan anpil bagay, men koulye a menm pi zele akoz de gran konfyans li nan nou menm. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />Tankou pou Tite, li se asosye e ouvriye parèy mwen pami nou. Tankou pou frè nou yo, yo se <note caller="+" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="PHP 2:25">Fil 2:25</ref></char></note>mesaje a legliz yo, yon glwa pou Kris la. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />Konsa, piblikman devan legliz yo, montre yo prèv lanmou nou ak <note caller="+" style="x"><char style="xo" closed="false">8:24 </char><char style="xt" closed="false"><ref loc="2CO 7:4">II Kor 7:4</ref></char></note>rezon pou gen fyète de nou.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />Paske se pa nesesè pou m ta ekri nou sou <note caller="+" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="2CO 8:4">II Kor 8:4</ref></char></note>ministè sa a pou sen yo, <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />paske mwen konnen volonte nou. Pou sa menm, mwen fè nou konpliman devan pèp Macédoine lan, anfèt ke Achaïe te deja prepare depi <note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="2CO 8:10">II Kor 8:10</ref></char></note>ane pase, e ke zèl nou te eksite pifò nan yo. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />Men mwen te voye frè yo, pouke <note caller="+" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="2CO 7:4">II Kor 7:4</ref></char></note>konpliman nou an pa ta fèt nan vid nan ka sa a, pouke <note caller="+" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="1CH 16:2">I Kwo 16:2</ref></char></note>jan mwen t ap di a, nou kapab byen prepare. <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />Pou si li pa t fèt , epi nenpòt nan <note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="ROM 15:26">Wo 15:26</ref></char></note>Masedonyen yo ta parèt avè m, nou pa t ap desi (ak ou menm tou) e soufri wont akoz sa ki te anvizaje. <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />Donk, mwen te panse ke li te nesesè pou ankouraje frè yo pou yo ta ale devan nou menm pou òganize davans <note caller="+" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="GEN 33:11">Jen 33:11</ref></char></note>kado jenewozite ke nou te deja pwomèt la. Epi konsa, kado sa a ta kapab parèt kon yon kado jenewozite ki pa afekte pa lanvi de nou menm.<verse eid="2CO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />Sonje, <note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="PRO 11:24">Pwov 11:24</ref></char></note>sila a ki simen tikal va rekòlte tikal. Men sila a ki simen an abondans va rekòlte an abondans. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />Chak moun dwe fè jis jan ke li te rezone nan kè l, pa avèk <note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="DEU 15:10">Det 15:10</ref></char></note>regrè oubyen anba presyon, paske <note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="EXO 25:2">Egz 25:2</ref></char></note>Bondye renmen yon moun ki bay avèk jwa. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />Epi Bondye kapab fè tout gras vin an kantite a nou menm, pou nou toujou gen kont nou nan tout bagay, pou nou kapab gen osi yon abondans nan tout bon zèv. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />Jan sa ekri a:</para>
  <para style="q1" vid="2CO 9:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">9:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 112:9">Sòm 112:9</ref>
      </char>
    </note>“Li te gaye toupatou.</para>
  <para style="q1" vid="2CO 9:9">Li te bay a malere yo.</para>
  <para style="q1" vid="2CO 9:9">Ladwati Li ap rete jis pou tout tan.”<verse eid="2CO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10" />Koulye a Li menm ki founi semans pou sila k ap simen an avèk pen pou l manje, va founi e miltipliye semans nou an pou simen e ogmante rekòlt ladwati nou an. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />Pou konsa, nou ka <note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="1CO 1:5">I Kor 1:5</ref></char></note>anrichi nan tout bagay ak tout jenewozite, ki atravè nou, ap pwodwi remèsiman a Bondye. <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />Paske ministè sèvis don sa a se pa sèlman pou byen founi <note caller="+" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="2CO 8:14">II Kor 8:14</ref></char></note>bezwen a sen yo, men va osi pou debòde <note caller="+" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="2CO 1:11">II Kor 1:11</ref></char></note>atravè anpil remèsiman a Bondye. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />Akoz de prèv ki te bay pa <note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="ROM 15:31">Wo 15:31</ref></char></note>ministè sèvis sila a, yo va bay Bondye glwa pou obeyisans konfesyon levanjil a Kris la, ak jenewozite don pa nou pou yo menm, ak tout lòt yo. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />Pandan yo menm osi, nan lapriyè pou nou, y ap gen dezi wè nou akoz ke gras Bondye ki anndan nou an ki depase tout bagay. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />Remèsiman a Bondye pou <note caller="+" style="x"><char style="xo" closed="false">9:15 </char><char style="xt" closed="false"><ref loc="ROM 5:15">Wo 5:15</ref></char></note>don Li ki depase tout sa ki kapab eksprime.<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />Koulye a, mwen menm Paul, mwen ankouraje nou pa <note caller="+" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="MAT 11:29">Mat 11:29</ref></char></note>imilite ak dousè a Kris la—mwen menm ki enb lè mwen fasafas avèk nou, men plen ak kouraj anvè nou lè m absan! <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />Mwen mande ke lè m prezan ke m p ap oblije vin parèt ak menm fòs kouraj la pou mwen ta vin advèsè <note caller="+" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="1CO 4:18">I Kor 4:18</ref></char></note>kèk moun ki konsidere nou tankou moun ki te mache selon lachè. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />Paske malgre ke n ap mache nan lachè, nou pa <note caller="+" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="ROM 8:4">Wo 8:4</ref></char></note>fè lagè selon lachè, <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />paske <note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="2CO 6:7">II Kor 6:7</ref></char></note>zam lagè nou yo pa nan lachè, men ranpli ak pwisans Bondye pou detwi barikad yo. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />N ap detwi tout sipozisyon avèk <note caller="+" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="ISA 2:11">És 2:11</ref></char></note>tout ògèy ki vin leve kont konesans Bondye a, e nou ap mennen tout panse kaptif yo nan obeyisans a Kris la. <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />Konsa, nou prè pou pini tout dezobeyisans, lè <note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="2CO 2:9">II Kor 2:9</ref></char></note>obeyisans nou an fin ranpli.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:7 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 7:24">Jn 7:24</ref>
      </char>
    </note>Nou menm ap gade bagay yo kòmsi, pa deyò. Si nenpòt moun gen konfyans nan tèt li ke li pou Kris, kite li konsidere sa ankò nan lespri li, ke menm jan li nan Kris la <note caller="+" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="1CO 9:1">I Kor 9:1</ref></char></note>nou menm osi, nou nan Li. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />Paske menm si m ta vante tèt mwen yon ti kras anplis pou otorite nou <note caller="+" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="2CO 13:10">II Kor 13:10</ref></char></note>ke Senyè a te bay pou bati nou menm e pa pou detwi nou, mwen p ap wont. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />Paske mwen pa vle li sanble ke m ta entimide nou pa lèt mwen yo. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />Paske, yo di: “Lèt li yo lou e dyanm, men prezans pèsonèl li pa enpresyonan ditou, e <note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 1:17">I Kor 1:17</ref></char></note>jan li pale vrèman meprizab.” <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />Kite yon moun konsa konsidere sa; ke sa nou ye nan lèt nou yo lè nou absan, se menm moun nan ke nou ye nan aksyon lè nou la.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />Paske nou p ap tante sèvi kouraj nou pou konpare oswa klase nou menm avèk kèk nan sila ki <note caller="+" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="2CO 3:1">II Kor 3:1</ref></char></note>rekòmande tèt yo. Men lè yo mezire tèt yo ak yo menm e konpare tèt yo avèk yo menm, yo san konprann. <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />Men nou p ap vante tèt nou plis ke mezi nou, men <note caller="+" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="ROM 12:3">Wo 12:3</ref></char></note>nan domèn kote Bondye te chwazi nou kòm yon mezi, pou menm rive kote nou ye a. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />Paske nou p ap lonje depase kapasite nou menm, kòmsi li pa t rive bò kote nou, paske nou te premye pou vini jis rive kote ou nan <note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="2CO 2:12">II Kor 2:12</ref></char></note>levanjil Kris la. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />Nou p ap vante tèt nou depase mezi pa nou, kòmsi, nan zèv a lòt moun, men avèk espwa ke pandan <note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="2TH 1:3">II Tes 1:3</ref></char></note>lafwa nou ap grandi, nou va, nan mezi nou, agrandi menm plis akoz nou menm. <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />Konsa nou ka preche levanjil menm nan zòn pi lwen nou yo, e pa vante tèt nou <note caller="+" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="ROM 15:20">Wo 15:20</ref></char></note>nan travay ki te fèt nan landwa a yon lòt. <verse eid="2CO 10:16" /><verse number="17" style="v" sid="2CO 10:17" />Men <note caller="+" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="JER 9:24">Jr 9:24</ref></char></note>“Sila k ap vante tèt li a, kite li vante tèt li nan Senyè a.” <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />Paske se pa sila ki rekòmande tèt li a ki apwouve, men se <note caller="+" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="ROM 2:29">Wo 2:29</ref></char></note>sila ki rekòmande pa Bondye a.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />Mwen swete ke nou <note caller="+" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="MAT 17:17">Mat 17:17</ref></char></note>ta ban mwen pèmisyon pou yon ti foli; men anfèt nou ban mwen l deja. <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />Paske mwen jalou pou nou avèk yon jalouzi ki sòti nan Bondye. Paske mwen te <note caller="+" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="HOS 2:19">Os 2:19</ref></char></note>fyanse nou ak yon mari, pou m ta kapab prezante nou a Kris kòm yon vyèj ki san tach. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />Men mwen pè pou menm jan ke Eve te twonpe pa riz sèpan an, pou panse nou ta de yon fason oubyen yon lòt detounen de devosyon sensè e san tach de Kris la. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />Paske si yon moun vini pou preche <note caller="+" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="1CO 3:11">I Kor 3:11</ref></char></note>yon lòt Jésus, ke nou menm pa t preche, oswa nou resevwa yon lòt lespri ke nou pa t resevwa, oswa yon <note caller="+" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="GAL 1:6">Gal 1:6</ref></char></note>lòt levanjil ke nou pa t aksepte, nou ase tolere sa. <verse eid="2CO 11:4" /><verse number="5" style="v" sid="2CO 11:5" />Paske mwen pa konsidere tèt mwen <note caller="+" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="2CO 12:11">II Kor 12:11</ref></char></note>kòm enferyè a pi gran apot yo. <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />Men menmsi mwen manke abil nan pale, deja mwen pa konsa nan <note caller="+" style="x"><char style="xo" closed="false">11:6 </char><char style="xt" closed="false"><ref loc="1CO 12:8">I Kor 12:8</ref></char></note>konesans. Anfèt, nan tout aspè, sa te deja fèt klè de nou tout, nan tout bagay.<verse eid="2CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />Oubyen èske mwen te fè yon peche lè m te aksepte imilye tèt mwen pou nou menm ta kapab egzalte, paske m te preche levanjil Bondye a nou menm <note caller="+" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="ACT 18:3">Trav 18:3</ref></char></note>san frè? <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />Okontrè, mwen te vòlè lòt legliz yo lè m te <note caller="+" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="1CO 4:12">I Kor 4:12</ref></char></note>pran kòb soutyen lan nan men yo pou sèvi nou. <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />Lè m te prezan avèk nou nan nesesite, mwen <note caller="+" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="2CO 12:13">II Kor 12:13</ref>,<ref loc="2CO 12:16">16</ref></char></note>pa t devni yon chaj pou okenn moun; paske lè <note caller="+" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="ACT 18:5">Trav 18:5</ref></char></note>frè yo te vini sòti Macédoine, yo te satisfè tout bezwen m yo, e nan tout bagay mwen te kenbe tèt mwen pou mwen pa t vin yon chaj pou nou menm, e m va kontinye fè menm bagay la. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" /><note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="ROM 9:1">Wo 9:1</ref></char></note>Jan verite Kris la nan mwen an <note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="1CO 9:15">I Kor 9:15</ref></char></note>vante tèt mwen an p ap tèmine fèt nan zòn Achaïe yo. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />Poukisa? <note caller="+" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="2CO 12:15">II Kor 12:15</ref></char></note>Paske mwen pa renmen nou? <note caller="+" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="2CO 11:31">II Kor 11:31</ref></char></note>Bondye konnen ke m renmen nou!<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />Men m ap kontinye fè sa ke m ap fè a <note caller="+" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="1CO 9:12">I Kor 9:12</ref></char></note>pou m kapab rachte okazyon de sila yo ki vle twouve yon okazyon pou moun konsidere yo egal avèk nou nan bagay ke y ap vante tèt yo. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />Paske moun konsa yo se fo apot yo ye, <note caller="+" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="PHP 3:2">Fil 3:2</ref></char></note>ouvriye twonpè k ap degize tèt yo tankou apot a Kris yo. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />Sa pa yon gwo sipriz, paske menm <note caller="+" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAT 4:10">Mat 4:10</ref></char></note>Satan degize tèt li tankou yon zanj limyè. <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />Konsa, se pa yon sipriz si sèvitè li yo degize tèt yo tankou sèvitè ladwati Bondye yo, ki <note caller="+" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="ROM 2:6">Wo 2:6</ref></char></note>va tèmine menm jan kon pwòp zèv pa yo.<verse eid="2CO 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:16 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 11:1">II Kor 11:1</ref>
      </char>
    </note>Ankò mwen di, ke pèsòn pa panse ke mwen fou. Men si nou panse sa, resevwa m menm tankou moun fou, pou mwen tou kapab vante tèt mwen tou piti. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />Sa m ap di a, mwen p ap di li <note caller="+" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="1CH 7:12">I Kwo 7:12</ref>,<ref loc="1CH 7:25">25</ref></char></note>jan Senyè a ta pale, men yon jan fou, konsi, m ap vante tèt mwen an. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />Akoz ke <note caller="+" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="PHP 3:3">Fil 3:3</ref></char></note>anpil moun vante tèt yo selon lachè, mwen va vante tèt mwen konsa tou. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />Men nou menm <note caller="+" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="1CO 4:10">I Kor 4:10</ref></char></note>ki tèlman saj, tolere foli a avèk kè kontan. <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />Paske nou tolere li si yon moun <note caller="+" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="GAL 2:4">Gal 2:4</ref></char></note>fè nou esklav, si yon moun devore nou, si yon moun pran avantaj de nou, si yon moun egzalte tèt li, menm si yon moun bannou kou nan figi. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />Nan wont mwen, mwen oblije di ke nou te <note caller="+" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="2CO 10:10">II Kor 10:10</ref></char></note>twò fèb pa konparezon. Men nan nenpòt bagay respekte nenpòt lòt moun se plen ak kouraj (mwen pale ak foli), mwen menm, mwen gen kouraj menm jan an. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />Èske se Ebre yo ye? <note caller="+" style="x"><char style="xo" closed="false">11:22 </char><char style="xt" closed="false"><ref loc="PHP 3:5">Fil 3:5</ref></char></note>Mwen menm tou, mwen Ebre. Èske se Izrayelit yo ye? Mwen menm tou, mwen se Izrayelit. Èske se desandan Abraham yo ye? <note caller="+" style="x"><char style="xo" closed="false">11:22 </char><char style="xt" closed="false"><ref loc="ROM 11:1">Wo 11:1</ref></char></note>Mwen menm tou. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />Èske se sèvitè a Kris yo ye? (Mwen pale tankou moun fou) Mwen menm tou, <note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="1CO 15:10">I Kor 15:10</ref></char></note>plis nan travay, <note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="2CO 6:5">II Kor 6:5</ref></char></note>bokou plis nan pran prizon. Mwen te bat depase mezi, mwen te souvan nan danje lanmò. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />Senk fwa mwen te resevwa nan men Jwif yo <note caller="+" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="DEU 25:3">Det 25:3</ref></char></note>trant-nèf kout fwèt. <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />Twa fwa mwen te <note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="ACT 16:22">Trav 16:22</ref></char></note>bat avèk baton, yon fwa mwen te <note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="ACT 14:19">Trav 14:19</ref></char></note>lapide avèk wòch, twa fwa mwen te nan bato ki kraze nan lanmè, yon jou ak yon nwit mwen te pase nan fon lanmè. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />Souvan mwen te fè vwayaj, an danje nan rivyè, danje ak vòlè, danje ak pwòp moun peyi mwen, danje ak moun etranje yo <note caller="+" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="ACT 21:31">Trav 21:31</ref></char></note>danje nan vil yo, danje nan dezè, danje sou lanmè, <note caller="+" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="GAL 2:4">Gal 2:4</ref></char></note>e danje pami fo frè yo. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />Mwen te nan travay, nan sikonstans difisil, nan anpil nwit san dòmi, nan grangou ak swaf, souvan <note caller="+" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="2CO 6:5">II Kor 6:5</ref></char></note>san manje, nan fredi e <note caller="+" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="1CO 4:11">I Kor 4:11</ref></char></note>san rad.<verse eid="2CO 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2CO 11:28" />Apa kondisyon ekstèn sa yo, gen fòs opresyon chak jou sou mwen pou sousi mwen gen pou <note caller="+" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="1CO 7:17">I Kor 7:17</ref></char></note>tout legliz yo. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />Kilès ki vin <note caller="+" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="1CO 8:9">I Kor 8:9</ref>,<ref loc="1CO 8:13">13</ref></char></note>fèb, san m pa fèb tou? Kilès ki lage nan peche, san gwo sousi mwen.<verse eid="2CO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30" />Si mwen dwe vante tèt mwen, m ap vante tèt mwen de sa ki apatyen a <note caller="+" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="1CO 2:3">I Kor 2:3</ref></char></note>feblès mwen. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />Bondye e Papa a Senyè a Jésus <note caller="+" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="ROM 1:25">Wo 1:25</ref></char></note>Li menm ki beni pou tout tan an, konnen ke m p ap bay manti. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />Nan Damas gouvènè anba Arétas, wa a t ap veye vil moun Damas yo pou l te kapab sezi mwen. <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />Se konsa mwen te kite lòt moun desann mwen nan yon panyen <note caller="+" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="ACT 9:25">Trav 9:25</ref></char></note>pa fenèt nan mi an, e se konsa m te chape nan men li.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />Vante tèt pa bon, men malgre ke li pa gen pwofi, kite m rive nan vizyon ak <note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="1CO 14:6">I Kor 14:6</ref></char></note>revelasyon Senyè a. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />Mwen konnen yon nonm an Kris, ki katòzan pase—-si se te nan kò li, m pa konnen, oubyen si se pa t nan kò li, m pa konnen, Bondye konnen——yon nonm konsa te monte nan <note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="DEU 10:14">Det 10:14</ref></char></note>twazyèm syèl la. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />Epi mwen konnen jan yon nonm konsa——si se nan kò li oubyen apa de kò li, mwen pa konnen <note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="2CO 11:11">II Kor 11:11</ref></char></note>(Bondye konnen), <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />jan li te <note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="EZK 8:3">Éz 8:3</ref></char></note>rale anwò nan <note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="LUK 23:43">Luc 23:43</ref></char></note>Paradi e li te tande pawòl ki pa t kapab eksprime, ke yon nonm pa gen pèmèt pou l pale. <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />Pou yon nonm konsa ak eksperyans li yo, mwen va anfle; men pou mwen, mwen p ap anfle, eksepte nan sa ki gade a <note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="1CO 2:3">I Kor 2:3</ref></char></note>feblès mwen. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />Paske si mwen vle vante tèt mwen, mwen p ap fè foli; <note caller="+" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="2CO 7:14">II Kor 7:14</ref></char></note>paske se verite m ap pale. Men m ap sispann fè sa pou pèsòn pa fè mwen kredi pou plis ke sa li wè nan mwen oubyen tande de mwen. <verse eid="2CO 12:6" /><verse number="7" style="v" sid="2CO 12:7" />Akoz grandè a revelasyon yo depase tout bagay, pou rezon sa a, pou anpeche m vante tèt mwen, mwen te resevwa yon <note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="NUM 33:55">Nonb 33:55</ref></char></note>pikan nan chè a, yon mesaje Satan pou toumante mwen, pou anpeche mwen vante tèt mwen. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />Konsènan sa, mwen te priye Senyè a <note caller="+" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="MAT 26:44">Mat 26:44</ref></char></note>twa fwa pou sa te kab sòti sou mwen. <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />Men Li te di mwen: <char style="wj">“Lagras mwen sifi pou ou, paske </char><note caller="+" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="1CO 2:5">I Kor 2:5</ref></char></note><char style="wj">pouvwa a vin konplè nan feblès”. </char> Konsa, avèk kè kontan, mwen va pito vante tèt mwen de feblès mwen, jis pou pouvwa Kris la kapab rete nan mwen.<verse eid="2CO 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 12:10" />Konsa <note caller="+" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="ROM 8:35">Wo 8:35</ref></char></note>mwen byen kontan avèk feblès yo, avèk ensilt yo, avèk twoub yo, avèk pèsekisyon yo, avèk difikilte yo, pou koz a Kris. Paske lè m fèb, se nan moman sa a ke m gen fòs. <verse eid="2CO 12:10" /><verse number="11" style="v" sid="2CO 12:11" />Koulye a, mwen te gen tan vin fou. Nou menm, nou te fòse m fè sa. Anverite, mwen ta dwe felisite pa nou menm, paske <note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="2CO 11:5">II Kor 11:5</ref></char></note>nan okenn jan, mwen pa t enferyè de apot pi wo yo, malgre <note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="1CO 3:7">I Kor 3:7</ref></char></note>mwen menm, mwen pa anyen. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" /><note caller="+" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="JHN 4:48">Jn 4:48</ref></char></note>Sign a yon vrè apot te fèt pami nou avèk tout pèseverans, pa sign, mèvèy ansanm ak mirak yo. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />Paske nan ki sans nou te trete kòm enferyè a rès legliz yo, eksepte mwen menm, m pa t vin yon chaj pou nou? Padone mwen pou <note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="2CO 11:7">II Kor 11:7</ref></char></note>mal sa a.<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />Sa fè pou <note caller="+" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="2CO 13:1">II Kor 13:1</ref>,<ref loc="2CO 13:2">2</ref></char></note>yon twazyèm fwa ke m prè pou vin kote nou, e mwen p ap yon chaj pou nou; paske mwen p ap chèche sa ke nou posede, men kè nou menm. Paske se pa timoun yo ki responsab pou ekonomize pou paran yo, men paran yo pou timoun yo. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />Mwen va avèk kè kontan depanse e konsakre m pou nanm nou. <note caller="+" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="2CO 11:11">II Kor 11:11</ref></char></note>Si m renmen nou plis konsa, èske nou dwe renmen m mwens? <verse eid="2CO 12:15" /><verse number="16" style="v" sid="2CO 12:16" />Men malgre jan sa kapab ye a <note caller="+" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="2CO 11:9">II Kor 11:9</ref></char></note>mwen menm, mwen pa t mete chaj tèt mwen bannou. Sepandan, nonm malen ke mwen ye, mwen te vin pran nou pa riz. <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" /><note caller="+" style="x"><char style="xo" closed="false">12:17 </char><char style="xt" closed="false"><ref loc="2CO 9:5">II Kor 9:5</ref></char></note>Éske mwen te pran avantaj sou nou, swa fè kòb sou nou atravè okenn nan sila ke mwen te voye bannou yo? <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />Mwen <note caller="+" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="2CO 8:6">II Kor 8:6</ref></char></note>te ankouraje Tite pou ale, e mwen te voye <note caller="+" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="2CO 8:18">II Kor 8:18</ref></char></note>frè a avèk li. Éske Tite te pran okenn avantaj sou nou? Èske nou pa t kondwi tèt nou nan menm lespri a e mache sou menm pa yo?<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />Èske ou kwè ke n ap sèlman fè eskiz pwòp tèt nou devan nou menm. Anverite <note caller="+" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="2CO 2:17">II Kor 2:17</ref></char></note>se te devan zye Bondye ke nou pale an Kris la. Men nou fè tout sa <note caller="+" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="ROM 14:19">Wo 14:19</ref></char></note>pou edifikasyon nou, byeneme yo. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />Paske mwen pè ke petèt lè m vin kote nou, pou mwen pa twouve nou jan mwen swete l la, e pou nou pa jwenn mwen jan nou swete l la; pou petèt kapab genyen kont, jalouzi <note caller="+" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="GAL 5:20">Gal 5:20</ref></char></note>move jan, dispit, kout lang <note caller="+" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="ROM 1:29">Wo 1:29</ref></char></note>tripotay, awogans, ak tapaj. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />Mwen pè ke lè m vini ankò pou Bondye mwen an pa rabese m devan nou, e pou mwen pa gen tristès pou anpil nan sila ki <note caller="+" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="2CO 13:2">II Kor 13:2</ref></char></note>te peche nan tan pase yo e ki pa t repanti de <note caller="+" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="1CO 6:9">I Kor 6:9</ref>,<ref loc="1CO 6:18">18</ref></char></note>salte, imoralite, ak sansyalite ke yo te fè yo.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />Sa se twazyèm fwa m ap vin kote nou. <note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="DEU 17:6">Det 17:6</ref></char></note>“Chak sa ki fèt dwe konfime pa temwayaj a de oubyen twa temwen.” <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />Mwen te di nou oparavan lè m te la nan dezyèm fwa a, e byenke m pa la koulye a, mwen di davans a sila yo ki te peche nan tan pase yo e a tout rès moun yo tou, ke si m vini ankò, mwen p ap <note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="2CO 1:23">II Kor 1:23</ref></char></note>epagne pèsòn. <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />Paske se konsa nou ap chache prèv a Kris ki pale nan mwen an, e ki pa fèb anvè nou an, men <note caller="+" style="x"><char style="xo" closed="false">13:3 </char><char style="xt" closed="false"><ref loc="2CO 9:8">II Kor 9:8</ref></char></note>byen pwisan nan nou. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />Paske malgre Li te <note caller="+" style="x"><char style="xo" closed="false">13:4 </char><char style="xt" closed="false"><ref loc="PHP 2:7">Fil 2:7</ref></char></note>krisifye akoz de feblès, deja Li vivan akoz de <note caller="+" style="x"><char style="xo" closed="false">13:4 </char><char style="xt" closed="false"><ref loc="1CO 6:14">I Kor 6:14</ref></char></note>pwisans Bondye a. Paske nou osi, nou fèb nan Li, malgre nou va viv avèk Li akoz de pwisans Bondye anvè nou.<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />Fè prèv tèt nou pou wè si nou nan lafwa. <note caller="+" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="1CO 11:28">I Kor 11:28</ref></char></note>Egzamine tèt nou! Oubyen èske nou pa rekonèt sa nan ou menm, ke Jésus Kri nan nou—-amwenske anfèt nou ta echwe nan tès la? <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />Men mwen gen konfyans ke ou va vin reyalize ke nou menm, nou pa echwe nan tès la.<verse eid="2CO 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 13:7" />Koulye a, n ap priye Bondye pou ou pa fè okenn mal; se pa pou nou kapab parèt kòmsi nou vin apwouve, men pou ou kapab fè sa ki bon, menmsi li sanble nou pa apwouve. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />Paske nou pa kapab fè anyen kont verite a, men sèlman pou verite a. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />Paske nou rejwi lè nou fèb e ou menm vin gen fòs. Se pou sa n ap priye; ke ou kapab <note caller="+" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="1CO 1:10">I Kor 1:10</ref></char></note>vin konplè. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />Pou rezon sa a, mwen ap ekri bagay sa yo pandan mwen pa la a, jis pou lè m la, mwen p ap bezwen <note caller="+" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="TIT 1:3">Tit 1:3</ref></char></note>itilize severite mwen, selon otorite ke Senyè a te ban mwen pou bati e pa pou detwi.<verse eid="2CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />Finalman, frè m yo, rejwi. Vin konplè, vin rekonfòte <note caller="+" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="ROM 12:16">Wo 12:16</ref></char></note>vin gen yon sèl panse. Viv nan lapè, epi Bondye lanmou ak lapè a va avèk nou. <verse eid="2CO 13:11" /><verse number="12" style="v" sid="2CO 13:12" /><note caller="+" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="ROM 16:16">Wo 16:16</ref></char></note>Salye youn lòt avèk yon beze ki sen.<verse eid="2CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 13:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:13 </char>
      <char style="xt" closed="false">
        <ref loc="PHP 4:22">Fil 4:22</ref>
      </char>
    </note>Tout sen yo salye nou.<verse eid="2CO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 13:14" />Ke lagras Senyè a Jésus Kri, lanmou Bondye a, ak <note caller="+" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="PHP 2:1">Fil 2:1</ref></char></note>dous kominyon Lespri Sen an, rete avèk nou tout. Amen.<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>