<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id" />
  <para style="h">Kantik A Kantik Yo</para>
  <para style="toc1">KANTIK A KANTIK YO</para>
  <para style="toc2">Kantik A Kantik Yo</para>
  <para style="toc3">Kan</para>
  <para style="mt1">KANTIK A KANTIK YO</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />Kantik A <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">I Wa 4:32</ref></char></note>Kantik Yo, ki ekri pa Salomon.<verse eid="SNG 1:1" /></para>
  <para style="sp">Jenn Fi a</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />Kite l bo m ak bo bouch li!</para>
  <para style="q1" vid="SNG 1:2">Paske <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="SNG 1:4">Kan 1:4</ref></char></note>lanmou ou bon pase diven.<verse eid="SNG 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />Lwil pafen ou yo santi bon.</para>
  <para style="q1" vid="SNG 1:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:3 </char>
      <char style="xt" closed="false">
        <ref loc="ECC 7:1">Ekl 7:1</ref>
      </char>
    </note>Non ou menm se tankou lwil kap vide;</para>
  <para style="q1" vid="SNG 1:3">se pou sa ke tout vyèj yo renmen ou konsa.<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />Rale m dèyè ou e annou kouri ansanm!</para>
  <para style="q1" vid="SNG 1:4">Wa a mennen m nan chanm li yo.</para>
  <para style="b" vid="SNG 1:4" />
  <para style="sp" vid="SNG 1:4">Lòt Yo</para>
  <para style="q1" vid="SNG 1:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:4 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 1:4">Kan 1:4</ref>
      </char>
    </note>“Nou va rejwi nan ou e fè kè kontan;</para>
  <para style="q1" vid="SNG 1:4">nou va leve lanmou ou wo plis pase diven.</para>
  <para style="sp" vid="SNG 1:4">Jenn Fi a</para>
  <para style="q1" vid="SNG 1:4">Ak bon rezon, yo renmen ou konsa.”<verse eid="SNG 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />Mwen menm, mwen nwa; men mwen byen bèl,</para>
  <para style="q1" vid="SNG 1:5">O fi a Jérusalem yo, tankou tant <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ISA 60:7">És 60:7</ref> </char></note>Kédar yo,</para>
  <para style="q1" vid="SNG 1:5">tankou rido a Salomon yo.<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />Pa gade mwen konsa akoz mwen nwa;</para>
  <para style="q1" vid="SNG 1:6">solèy la brile m konsa.</para>
  <para style="q1" vid="SNG 1:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:8">Sòm 69:8</ref>
      </char>
    </note>Fis a manman m yo te byen fache avè m;</para>
  <para style="q1" vid="SNG 1:6">Yo te fè m gadyen chan rezen yo.</para>
  <para style="q1" vid="SNG 1:6">Men pwòp jaden pa m nan vin neglije.<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />Pale mwen, ou menm nan</para>
  <para style="q1" vid="SNG 1:7">ke nanm mwen tèlman renmen;</para>
  <para style="q1" vid="SNG 1:7">ki kote ou fè patiraj twoupo ou a?</para>
  <para style="q1" vid="SNG 1:7">Ki kote ou konn fè l kouche a midi?</para>
  <para style="q1" vid="SNG 1:7">Paske poukisa mwen ta tankou yon moun</para>
  <para style="q1" vid="SNG 1:7">ki vwale figi li nan kote twoupo <note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="SNG 8:13">Kan 8:13</ref> </char></note>zanmi ou yo?<verse eid="SNG 1:7" /></para>
  <para style="b" />
  <para style="sp">Salomon</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />Si ou menm, ou pa konnen,</para>
  <para style="q1" vid="SNG 1:8">O <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="SNG 5:9">Kan 5:9</ref></char></note>pi bèl pami tout fanm yo;</para>
  <para style="q1" vid="SNG 1:8">janbe swiv wout twoupo a,</para>
  <para style="q1" vid="SNG 1:8">e fè patiraj pou jenn kabrit ou yo</para>
  <para style="q1" vid="SNG 1:8">akote tant bèje ou yo.<verse eid="SNG 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />Pou mwen, cheri mwen an,</para>
  <para style="q1" vid="SNG 1:9">ou tankou <note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="2CH 1:16-17">II Kwo 1:16-17</ref></char></note> pi bèl poulich</para>
  <para style="q1" vid="SNG 1:9">pami sa kap rale cha Farawon an.<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />Bò figi ou byen bèl ak zanno,</para>
  <para style="q1" vid="SNG 1:10">kou ou ak <note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="GEN 24:53">Jen 24:53</ref> </char></note>bèl kolye.<verse eid="SNG 1:10" /></para>
  <para style="b" />
  <para style="sp">Lòt Yo</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />Nou va fè pou ou dekorasyon an lò</para>
  <para style="q1" vid="SNG 1:11">anbeli ak pwent an ajan tou won.<verse eid="SNG 1:11" /></para>
  <para style="sp">Jenn Fi a</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />Pandan wa a te sou tab li,</para>
  <para style="q1" vid="SNG 1:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:12 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:14">Kan 4:14</ref>
      </char>
    </note>pafen mwen te rive kote l ak bèl odè.<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />Sila ke m renmen an se yon pòch pafen;</para>
  <para style="q1" vid="SNG 1:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:13 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:8">Sòm 45:8</ref>
      </char>
    </note>fèy bazilik ki pase tout nwit lan antre tete mwen.<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />Cheri mwen an se yon grap flè jasmen</para>
  <para style="q1" vid="SNG 1:14">byen plase nan chan rezen <note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="1SA 23:29">I Sam 23:29</ref> </char></note>En-Guédi yo.<verse eid="SNG 1:14" /></para>
  <para style="sp">Salomon</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />“Tèlman ou bèl, cheri mwen an; tèlman ou bèl!</para>
  <para style="q1" vid="SNG 1:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:15 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:1">Kan 4:1</ref>
      </char>
    </note>Zye ou tankou toutrèl yo.”<verse eid="SNG 1:15" /></para>
  <para style="sp">Jenn Fi Lan</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />Gade jan ou bèl e byen agreyab, <note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="SNG 2:3-17">Kan 2:3-17</ref></char></note>cheri mwen an;</para>
  <para style="q1" vid="SNG 1:16">anverite, se zèb vèt kap fè kabann nou.<verse eid="SNG 1:16" /></para>
  <para style="sp">Salomon</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />Pilye kay nou se <note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="1KI 6:9-10">I Wa 6:9-10</ref></char></note>bwa sèd</para>
  <para style="q1" vid="SNG 1:17">e travès yo se bwa pen.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="sp">Jenn Fi An</para>
  <para style="p">
    <verse number="1" style="v" sid="SNG 2:1" />Mwen se flè Woz Saron an,</para>
  <para style="q1" vid="SNG 2:1">flè Lis a vale yo.<verse eid="SNG 2:1" /></para>
  <para style="b" />
  <para style="sp">Salomon</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />Tankou yon flè lis pami pikan yo,</para>
  <para style="q1" vid="SNG 2:2">se konsa <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="SNG 1:9">Kan 1:9</ref></char></note>cheri mwen an ye</para>
  <para style="q1" vid="SNG 2:2">pami tout jenn fi yo.<verse eid="SNG 2:2" /></para>
  <para style="b" />
  <para style="sp">Jenn Fi an</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />Tankou yon <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="SNG 8:5">Kan 8:5</ref></char></note>pye pòm pami bwa nan forè,</para>
  <para style="q1" vid="SNG 2:3">se konsa cheri mwen an ye pami jennonm yo.</para>
  <para style="q1" vid="SNG 2:3">Nan lonbraj li mwen te pran gwo plezi pou m te chita;</para>
  <para style="q1" vid="SNG 2:3">konsa fwi li te dous nan gou m.<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />Li te mennen m nan gwo sal bankè li,</para>
  <para style="q1" vid="SNG 2:4">e <note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="PSA 20:5">Sòm 20:5</ref> </char></note>drapo li monte sou mwen an se lanmou.<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />Ban m fòs ak <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="2SA 6:19">II Sam 6:19</ref></char></note> gato rezen,</para>
  <para style="q1" vid="SNG 2:5">rafrechi m ak pòm,</para>
  <para style="q1" vid="SNG 2:5">akoz mwen malad ak lanmou.<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />Kite men goch li rete anba tèt mwen</para>
  <para style="q1" vid="SNG 2:6">ak men dwat li pou l <note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="PRO 4:8">Pwov 4:8</ref></char></note>anbrase m.<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />M ap <note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="SNG 3:5">Kan 3:5</ref></char></note>avèti nou, O fi a Jérusalem yo,</para>
  <para style="q1" vid="SNG 2:7">nan non antilòp ak bich mawon an,</para>
  <para style="q1" vid="SNG 2:7">pou nou pa fè lanmou m leve,</para>
  <para style="q1" vid="SNG 2:7">ni ouvri zye li jiskaske se plezi li.<verse eid="SNG 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />Koute! Men cheri mwen an!</para>
  <para style="q1" vid="SNG 2:8">Men l ap vini!</para>
  <para style="q1" vid="SNG 2:8">L ap monte <note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="SNG 2:17">Kan 2:17</ref></char></note>sou mòn yo,</para>
  <para style="q1" vid="SNG 2:8">epi vòltije sou kolin yo!<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />Cheri mwen an tankou yon <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="PRO 6:5">Pwov 6:5</ref></char></note>antilòp,</para>
  <para style="q1" vid="SNG 2:9">oswa yon jenn sèf.</para>
  <para style="q1" vid="SNG 2:9">Gade byen, li kanpe dèyè mi kay nou an;</para>
  <para style="q1" vid="SNG 2:9">l ap gade nan fenèt yo, l ap gade nan jalouzi a.<verse eid="SNG 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />Cheri mwen an te reponn mwen</para>
  <para style="q1" vid="SNG 2:10">e te di m: <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="SNG 2:13">Kan 2:13</ref></char></note>“Leve vini cheri mwen an,</para>
  <para style="q1" vid="SNG 2:10">pi bèl mwen an.<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />Paske gade, sezon fredi a fin pase,</para>
  <para style="q1" vid="SNG 2:11">lapli fin pati nèt.<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />Flè yo deja parèt nan peyi a;</para>
  <para style="q1" vid="SNG 2:12">tan an chante a fin rive!</para>
  <para style="q1" vid="SNG 2:12">Vwa <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="GEN 15:9">Jen 15:9</ref></char></note>toutrèl la ap koute deja nan peyi a.<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />Fwi <note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="MAT 24:32">Mat 24:32</ref></char></note>pye fig etranje a fin mi,</para>
  <para style="q1" vid="SNG 2:13">e chan rezen yo bay odè pafen.</para>
  <para style="q1" vid="SNG 2:13">Leve vini, annou pati!”<verse eid="SNG 2:13" /></para>
  <para style="sp">Salomon</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />O toutrèl nan <note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="JER 48:28">Jr 48:28</ref></char></note>fant wòch mwen an,</para>
  <para style="q1" vid="SNG 2:14">nan kote sekrè chemen ki monte apik,</para>
  <para style="q1" vid="SNG 2:14">kite mwen wè figi ou, kite mwen tande vwa ou!</para>
  <para style="q1" vid="SNG 2:14">Paske vwa ou dous e fòm ou bèl nèt.<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:15 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 13:4">Éz 13:4</ref>
      </char>
    </note>Kenbe rena yo pou nou,</para>
  <para style="q1" vid="SNG 2:15">ti rena k ap detwi chan rezen yo,</para>
  <para style="q1" vid="SNG 2:15">paske chan nou yo ap fè flè.<verse eid="SNG 2:15" /></para>
  <para style="sp">Jenn Fi an</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />Cheri mwen an se pa m,</para>
  <para style="q1" vid="SNG 2:16">e mwen se pa l.</para>
  <para style="q1" vid="SNG 2:16">Li fè patiraj twoupo li pami flè lis yo.<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:17 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:6">Kan 4:6</ref>
      </char>
    </note>Jiskaske joune a vin fè fre</para>
  <para style="q1" vid="SNG 2:17">lè lonbraj yo kouri ale;</para>
  <para style="q1" vid="SNG 2:17">vire, cheri mwen an,</para>
  <para style="q1" vid="SNG 2:17">fè tankou antilòp la, oswa jenn sèf sou mòn Bether a.<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="sp">Jenn Fi an</para>
  <para style="p">
    <verse number="1" style="v" sid="SNG 3:1" />Sou kabann mwen, pandan nwit la,</para>
  <para style="q1" vid="SNG 3:1">mwen te chache sila <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="SNG 1:7">Kan 1:7</ref></char></note>ke nanm mwen renmen an.</para>
  <para style="q1" vid="SNG 3:1">Mwen te chache l, men m pa t jwenn li.<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />Koulye a fòk mwen leve mache toupatou nan vil la;</para>
  <para style="q1" vid="SNG 3:2">nan <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="JER 5:1">Jr 5:1</ref></char></note>ri yo ak nan plas yo.</para>
  <para style="q1" vid="SNG 3:2">Fòk mwen chache sila ke nanm mwen renmen an.</para>
  <para style="q1" vid="SNG 3:2">Mwen te chache l, men m pa t jwenn li.<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:3 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 5:7">Kan 5:7</ref>
      </char>
    </note>Gadyen ki fè tou vil la te twouve m.</para>
  <para style="q1" vid="SNG 3:3">Mwen te mande l: “Èske ou konn wè</para>
  <para style="q1" vid="SNG 3:3">sila ke nanm mwen renmen an?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />Lè m <note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="PRO 8:17">Pwov 8:17</ref></char></note>fenk kite yo mwen te jwenn</para>
  <para style="q1" vid="SNG 3:4">sila ke nanm mwen renmen an.</para>
  <para style="q1" vid="SNG 3:4">Mwen te kenbe l, mwen te refize lage l</para>
  <para style="q1" vid="SNG 3:4">jiskaske mwen mennen l rive lakay manman m,</para>
  <para style="q1" vid="SNG 3:4">pou l antre nan chanm a sila ki te vin ansent mwen an.<verse eid="SNG 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />M ap <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="SNG 2:7">Kan 2:7</ref></char></note>avèti nou, O fi a Jérusalem yo,</para>
  <para style="q1" vid="SNG 3:5">nan non antilòp ak bich mawon an,</para>
  <para style="q1" vid="SNG 3:5">pou nou pa fè lanmou leve</para>
  <para style="q1" vid="SNG 3:5">ni ouvri zye l jiskaske se plezi li.<verse eid="SNG 3:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />Se kisa k ap monte kite dezè a</para>
  <para style="q1" vid="SNG 3:6">tankou pilye lafimen yo,</para>
  <para style="q1" vid="SNG 3:6">byen pafime ak fèy bazilik ak <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="EXO 30:34">Egz 30:34</ref> </char></note>lansan,</para>
  <para style="q1" vid="SNG 3:6">plen ak poud santi bon machann yo?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />Gade byen, se kanape vwayaj Salomon k ap monte;</para>
  <para style="q1" vid="SNG 3:7">swasant òm pwisan kap antoure l,</para>
  <para style="q1" vid="SNG 3:7">mesye pwisan Israël yo.<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />Yo tout ki konn manyen nepe,</para>
  <para style="q1" vid="SNG 3:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">3:8 </char>
      <char style="xt" closed="false">
        <ref loc="JER 50:9">Jr 50:9</ref>
      </char>
    </note>ki fò nan afè lagè;</para>
  <para style="q1" vid="SNG 3:8">chak mesye gen nepe l bò kote li,</para>
  <para style="q1" vid="SNG 3:8">pou fè gad kont menas lannwit yo.<verse eid="SNG 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />Wa Salomon te fè pou kont li</para>
  <para style="q1" vid="SNG 3:9">yon kanape vwayaj ak bwa Liban an.<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />Li te fè pye li ak ajan e repo pou do a ak lò.</para>
  <para style="q1" vid="SNG 3:10">Kote pou chita a fabrike ak twal mov,</para>
  <para style="q1" vid="SNG 3:10">e tout anndan li byen dekore pa <note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="SNG 1:5">Kan 1:5</ref></char></note>fi Jérusalem yo.<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />Ale, O fi a Sion yo,</para>
  <para style="q1" vid="SNG 3:11">e fikse byen Wa Salomon ak kouwòn sila a</para>
  <para style="q1" vid="SNG 3:11">manman l te kouwone l nan <note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ISA 62:5">És 62:5</ref> </char></note>jou fèt maryaj li,</para>
  <para style="q1" vid="SNG 3:11">nan jou kè kontan li an.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">Salomon</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />A la ou bèl, cheri mwen an, a la ou bèl!</para>
  <para style="q1" vid="SNG 4:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 1:15">Kan 1:15</ref>
      </char>
    </note>Zye ou tankou toutrèl dèyè vwal ou;</para>
  <para style="q1" vid="SNG 4:1">cheve ou tankou yon bann kabrit</para>
  <para style="q1" vid="SNG 4:1">ki fin desann sòti Mòn Galaad.<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:2 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 6:6">Kan 6:6</ref>
      </char>
    </note>Dan ou tankou yon bann mouton</para>
  <para style="q1" vid="SNG 4:2">ak lenn fenk taye ki sot benyen.</para>
  <para style="q1" vid="SNG 4:2">Yo tout fè pòtre jimo yo,</para>
  <para style="q1" vid="SNG 4:2">ni youn nan yo pa pèdi pitit li.<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />Lèv ou tankou <note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="JOS 2:18">Jos 2:18</ref></char></note>fisèl wouj</para>
  <para style="q1" vid="SNG 4:3">e bouch ou tèlman bèl.</para>
  <para style="q1" vid="SNG 4:3">De bò figi ou tankou yon tranch grenad dèyè vwal ou.<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:4 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 7:4">Kan 7:4</ref>
      </char>
    </note>Kou ou tankou fò David la,</para>
  <para style="q1" vid="SNG 4:4">bati ak wòch byen ranje sou sila yo mete mil boukliye yo,</para>
  <para style="q1" vid="SNG 4:4">tout boukliye won a mesye pwisan yo.<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:5 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 7:3">Kan 7:3</ref>
      </char>
    </note>De tete ou tankou de jèn ti antilòp;</para>
  <para style="q1" vid="SNG 4:5">jimo manman k ap chache manje pami flè lis yo.<verse eid="SNG 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:6 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 2:17">Kan 2:17</ref>
      </char>
    </note>Jiskaske jou a bese pou l vin fre</para>
  <para style="q1" vid="SNG 4:6">e lonbraj yo vin disparèt,</para>
  <para style="q1" vid="SNG 4:6">mwen va trase chemen mwen rive nan mòn</para>
  <para style="q1" vid="SNG 4:6">fèy bazilik la, ak nan kolin lansan an.<verse eid="SNG 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:7 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 1:15">Kan 1:15</ref>
      </char>
    </note>Ou fin bèl nèt, cheri mwen an,</para>
  <para style="q1" vid="SNG 4:7">e nanpwen defo nan ou.<verse eid="SNG 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />Vin avè m soti <note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="1KI 4:33">I Wa 4:33</ref></char></note>Liban, fi maryaj mwen an;</para>
  <para style="q1" vid="SNG 4:8">m bezwen ou vini avè m sòti Liban.</para>
  <para style="q1" vid="SNG 4:8">Vwayaje desann soti nan wo pwent Amana,</para>
  <para style="q1" vid="SNG 4:8">soti nan wo pwent Mòn Senir ak Hermon;</para>
  <para style="q1" vid="SNG 4:8">soti nan kav lyon yo, nan mòn a leyopa yo.<verse eid="SNG 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />Ou fè kè m bat pi vit sè mwen, fi maryaj mwen an;</para>
  <para style="q1" vid="SNG 4:9">ou te fè kè m bat pi vit ak yon sèl ti kout zye tou kout,</para>
  <para style="q1" vid="SNG 4:9">ak yon sèl bout fisèl nan <note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="GEN 41:42">Jen 41:42</ref></char></note>kolye ou.<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:10 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 7:6">Kan 7:6</ref>
      </char>
    </note>A la bèl lanmou ou bèl, sè mwen an,</para>
  <para style="q1" vid="SNG 4:10">fi a maryaj mwen an!</para>
  <para style="q1" vid="SNG 4:10">A la pi bon lanmou ou pi bon pase diven</para>
  <para style="q1" vid="SNG 4:10">e bon odè a lwil ou depase tout kalite epis!<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />Lèv ou, fi a maryaj mwen an, gen gou siwo myèl;</para>
  <para style="q1" vid="SNG 4:11">siwo myèl ak lèt anba lang ou.</para>
  <para style="q1" vid="SNG 4:11">Bon odè vètman ou tankou <note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="GEN 27:27">Jen 27:27</ref></char></note>bon odè Liban an.<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />Yon jaden fèmen ak kle se sè mwen,</para>
  <para style="q1" vid="SNG 4:12">fi a maryaj mwen;</para>
  <para style="q1" vid="SNG 4:12">yon jaden wòch ki fèmen,</para>
  <para style="q1" vid="SNG 4:12">yon fontèn dlo ki <note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="GEN 29:3">Jen 29:3</ref></char></note>ansèkle.<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />Boujon ou se yon chan kiltive ak pye grenad,</para>
  <para style="q1" vid="SNG 4:13">ak fwi chwazi, pye jasmen ak ti bonm;<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />ti bonm ak safran, sitwonèl ak kannèl,</para>
  <para style="q1" vid="SNG 4:14">ak tout bwa lansan yo, <note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="PSA 45:8">Sòm 45:8</ref> </char></note>lami ak lalwa,</para>
  <para style="q1" vid="SNG 4:14">ansanm ak tout meyè kalite epis yo.<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />Ou menm se yon sous jaden,</para>
  <para style="q1" vid="SNG 4:15">yon pwi <note caller="+" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="ZEC 14:8">Za 14:8</ref></char></note>dlo fre ak ti ravin dlo k ap kouri soti Liban.<verse eid="SNG 4:15" /></para>
  <para style="sp">Jenn Fi an</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />Leve, o van nan nò a, e vini van nan sid!</para>
  <para style="q1" vid="SNG 4:16">Fè jaden mwen respire ak souf bon odè;</para>
  <para style="q1" vid="SNG 4:16">kite epis li yo vante gaye toupatou.</para>
  <para style="q1" vid="SNG 4:16">Ke cheri mwen an vin nan jaden li an</para>
  <para style="q1" vid="SNG 4:16">pou manje tout fwi chwa li yo.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">Salomon</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />Mwen te vini nan jaden mwen an, sè mwen,</para>
  <para style="q1" vid="SNG 5:1">fi a maryaj mwen an.</para>
  <para style="q1" vid="SNG 5:1">Mwen te ranmase lami mwen ak tout fèy awomatik mwen.</para>
  <para style="q1" vid="SNG 5:1">Mwen te manje gato myèl ak siwo myèl mwen;</para>
  <para style="q1" vid="SNG 5:1">mwen te bwè diven mwen ak lèt mwen.</para>
  <para style="b" vid="SNG 5:1" />
  <para style="sp" vid="SNG 5:1">Lòt Yo</para>
  <para style="p" vid="SNG 5:1">Manje, zanmi nou yo; bwè e vin sou ak lanmou!<verse eid="SNG 5:1" /></para>
  <para style="b" />
  <para style="sp">Jenn Fi a</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />Mwen t ap dòmi, men kè m t ap veye.</para>
  <para style="q1" vid="SNG 5:2">Yon vwa! Cheri mwen an t ap frape sou pòt la:</para>
  <para style="q1" vid="SNG 5:2">“Ouvri pou mwen, sè mwen, cheri mwen an,</para>
  <para style="q1" vid="SNG 5:2">toutrèl mwen an, ou menm ki pafè pou mwen an! Tèt mwen mouye ak lawouze,</para>
  <para style="q1" vid="SNG 5:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:2 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 5:11">Kan 5:11</ref> </char>
    </note>très cheve mwen ak imidite nwit lan.<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />Mwen te <note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="LUK 11:7">Luc 11:7</ref></char></note>fin retire rad mwen;</para>
  <para style="q1" vid="SNG 5:3">kijan pou m ta remete l ankò a?</para>
  <para style="q1" vid="SNG 5:3">Mwen te lave pye mwen;</para>
  <para style="q1" vid="SNG 5:3">kijan pou m ta fè vin sal yo ankò a?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />Cheri mwen an te lonje men l pase nan twou pòt la.</para>
  <para style="q1" vid="SNG 5:4">Tout <note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="JER 31:20">Jr 31:20</ref></char></note>santiman kè m te leve pou li.<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />Mwen te leve pou ouvri pou cheri mwen an.</para>
  <para style="q1" vid="SNG 5:5">Men m te <note caller="+" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="SNG 5:13">Kan 5:13</ref></char></note>degoute menm ak lami,</para>
  <para style="q1" vid="SNG 5:5">e dwèt mwen ak dlo lami, sou manch boulon pòt lan.<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />Mwen te ouvri a cheri mwen an,</para>
  <para style="q1" vid="SNG 5:6">men cheri mwen an te <note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="SNG 6:1">Kan 6:1</ref></char></note>vire kite pou l ale!</para>
  <para style="q1" vid="SNG 5:6">Kè m te sòti lè l te pale a.</para>
  <para style="q1" vid="SNG 5:6">Mwen te chache li, men mwen pa t jwenn li.</para>
  <para style="q1" vid="SNG 5:6">Mwen te rele li, men li pa t reponn mwen.<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:7 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 3:3">Kan 3:3</ref>
      </char>
    </note>Gadyen ki te fè tou vil la te twouve mwen.</para>
  <para style="q1" vid="SNG 5:7">Yo te bat mwen.</para>
  <para style="q1" vid="SNG 5:7">Yo te blese mwen.</para>
  <para style="q1" vid="SNG 5:7">Jandam sou miray la te retire gwo manto mwen an.<verse eid="SNG 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />“M ap <note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="SNG 2:5">Kan 2:5</ref></char></note>avèti nou, O fi a Jérusalem yo,</para>
  <para style="q1" vid="SNG 5:8">si nou jwenn cheri mwen an, konsa nou va di l;</para>
  <para style="q1" vid="SNG 5:8">ke mwen malad ak lanmou.”<verse eid="SNG 5:8" /></para>
  <para style="b" />
  <para style="sp">Lòt Yo</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />“Ki jan cheri ki cheri ou a,</para>
  <para style="q1" vid="SNG 5:9">sinon pi bèl pami fanm yo?</para>
  <para style="q1" vid="SNG 5:9">Ki jan cheri ki cheri ou a,</para>
  <para style="q1" vid="SNG 5:9">pi bon pase lòt,</para>
  <para style="q1" vid="SNG 5:9">ke ou ta nomen non l devan nou konsa?”<verse eid="SNG 5:9" /></para>
  <para style="b" />
  <para style="sp">Jenn Fi a</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />Cheri mwen an mèvèye,</para>
  <para style="q1" vid="SNG 5:10">yon figi wouj ranpli ak sante,</para>
  <para style="q1" vid="SNG 5:10">k ap <note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="PSA 45:2">Sòm 45:2</ref> </char></note>parèt miyò pami di-mil.<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />Tèt li tankou lò, lò san tach;</para>
  <para style="q1" vid="SNG 5:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:11 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 5:2">Kan 5:2</ref>
      </char>
    </note>très cheve li tankou grap rezen</para>
  <para style="q1" vid="SNG 5:11">e nwa tankou kòbo.<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />Zye li tankou toutrèl</para>
  <para style="q1" vid="SNG 5:12">akote dlo k ap koule,</para>
  <para style="q1" vid="SNG 5:12">ki benyen nan lèt,</para>
  <para style="q1" vid="SNG 5:12">ki monte kon bijou akote yon <note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="EXO 25:7">Egz 25:7</ref> </char></note>basen dlo.<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />De bò figi li tankou yon kabann fèt ak fèy awomatik,</para>
  <para style="q1" vid="SNG 5:13">kap poze sou yon kouch zèb santi bon.</para>
  <para style="q1" vid="SNG 5:13">Lèv li yo se flè <note caller="+" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="SNG 2:1">Kan 2:1</ref> </char></note>lis ki degoute dlo lami.<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />Men li se wondèl fèt an lò,</para>
  <para style="q1" vid="SNG 5:14">anbeli ak bijou beril.</para>
  <para style="q1" vid="SNG 5:14">Kò li se ivwa taye ki kouvri ak pyè safi.<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />Janm li se pilye fèt an mèb blan,</para>
  <para style="q1" vid="SNG 5:15">plase sou yon baz lò san tach;</para>
  <para style="q1" vid="SNG 5:15">aparans li tankou <note caller="+" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="SNG 7:4">Kan 7:4</ref></char></note>chwa Liban an,</para>
  <para style="q1" vid="SNG 5:15">kon pi bèl bwa sèd li.<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />Bouch li plen ak dousè.</para>
  <para style="q1" vid="SNG 5:16">Li dezirab nèt.</para>
  <para style="q1" vid="SNG 5:16">Sa se cheri mwen an,</para>
  <para style="q1" vid="SNG 5:16">e sa se zanmi mwen an,</para>
  <para style="q1" vid="SNG 5:16">o fi Jérusalem yo.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">Lòt yo</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:1 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 5:6">Kan 5:6</ref>
      </char>
    </note>“Kote cheri ou a te ale, o pi bèl pami fanm yo?</para>
  <para style="q1" vid="SNG 6:1">Kote cheri ou a te vire, pou nou ka chache li ansanm avèk ou?”<verse eid="SNG 6:1" /></para>
  <para style="b" />
  <para style="sp">Jenn Fi a</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />Cheri mwen an te desann nan jaden li an,</para>
  <para style="q1" vid="SNG 6:2">nan kabann ki fèt ak fèy awomatik,</para>
  <para style="q1" vid="SNG 6:2">pou fè patiraj twoupo li nan jaden yo,</para>
  <para style="q1" vid="SNG 6:2">pou ranmase flè <note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="SNG 2:1">Kan 2:1</ref></char></note>lis.<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />Mwen pou cheri mwen an e cheri mwen pou mwen;</para>
  <para style="q1" vid="SNG 6:3">sila ki fè patiraj twoupo li pami flè lis yo.<verse eid="SNG 6:3" /></para>
  <para style="b" />
  <para style="sp">Salomon</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />Ou bèl, cheri mwen an, tankou <note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="1KI 14:17">I Wa 14:17</ref></char></note>Thirtsa;</para>
  <para style="q1" vid="SNG 6:4">bèl tankou Jérusalem,</para>
  <para style="q1" vid="SNG 6:4">mèvèye tankou yon lame ak drapo yo.<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />Vire zye ou! Pa gade m!</para>
  <para style="q1" vid="SNG 6:5">Paske zye ou fè m egare.</para>
  <para style="q1" vid="SNG 6:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:5 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:1">Kan 4:1</ref>
      </char>
    </note>Cheve ou tankou yon bann kabrit k ap soti desann Galaad.<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:6 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:2">Kan 4:2</ref>
      </char>
    </note>Dan ou tankou yon bann mouton</para>
  <para style="q1" vid="SNG 6:6">ki fenk monte sot benyen.</para>
  <para style="q1" vid="SNG 6:6">Yo tout ki pòtre marasa.</para>
  <para style="q1" vid="SNG 6:6">Nanpwen menm youn nan yo ki pèdi pitit.<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:7 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:3">Kan 4:3</ref>
      </char>
    </note>De bò figi ou tankou yon tranch grenad</para>
  <para style="q1" vid="SNG 6:7">dèyè vwal ou.<verse eid="SNG 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />Genyen swasant rèn ak katre-ven konkibin,</para>
  <para style="q1" vid="SNG 6:8">e <note caller="+" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="SNG 1:3">Kan 1:3</ref></char></note>jèn fi menm pa kab konte;<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />Men toutrèl mwen an, parèy san parèy mwen an inik;</para>
  <para style="q1" vid="SNG 6:9">li se sèl fi a manman li.</para>
  <para style="q1" vid="SNG 6:9">Fi san tach a sila ki te pote li a.</para>
  <para style="q1" vid="SNG 6:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:9 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 30:13">Jen 30:13</ref> </char>
    </note>Jenn fi yo te wè l e te rele l beni;</para>
  <para style="q1" vid="SNG 6:9">ni rèn ni konkibin yo.</para>
  <para style="q1" vid="SNG 6:9">Yo te louwe l pou di:<verse eid="SNG 6:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />Kilès li ye ki grandi kon solèy leve a,</para>
  <para style="q1" vid="SNG 6:10">bèl tankou plèn lin nan,</para>
  <para style="q1" vid="SNG 6:10">san tach tankou <note caller="+" style="x"><char style="xo" closed="false">6:10 </char><char style="xt" closed="false"><ref loc="MAT 17:2">Mat 17:2</ref></char></note>solèy la,</para>
  <para style="q1" vid="SNG 6:10">e mèvèye tankou yon lame ak tout drapo li a?<verse eid="SNG 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />Mwen te desann nan chan bwa nwa yo</para>
  <para style="q1" vid="SNG 6:11">pou wè bwa vèt yo nan vale a;</para>
  <para style="q1" vid="SNG 6:11">pou wè si chan rezen fin fè boujon,</para>
  <para style="q1" vid="SNG 6:11">oswa <note caller="+" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="SNG 4:13">Kan 4:13</ref></char></note>grenad yo te fleri.<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />Avan mwen te menm konnen,</para>
  <para style="q1" vid="SNG 6:12">dezi m te plase mwen sou cha a pèp nòb mwen an.<verse eid="SNG 6:12" /></para>
  <para style="b" />
  <para style="sp">Lòt Yo</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />Retounen, retounen, O Silamit lan;</para>
  <para style="q1" vid="SNG 6:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:13 </char>
      <char style="xt" closed="false">
        <ref loc="JDG 21:21">Jij 21:21</ref>
      </char>
    </note>retounen, retounen, pou zye nou ka gade ou!</para>
  <para style="b" vid="SNG 6:13" />
  <para style="sp" vid="SNG 6:13">Salomon</para>
  <para style="q1" vid="SNG 6:13">Poukisa ou ta gade Silamit lan tankou se nan dans a de twoup koral?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 7:1" />A la bèl pye ou bèl nan sandal yo, o pitit a nòb yo!</para>
  <para style="q1" vid="SNG 7:1">O <note caller="+" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="PSA 45:13">Sòm 45:13</ref></char></note>fi a prens lan!</para>
  <para style="q1" vid="SNG 7:1">Koub kwis ou tankou bijou, zèv a yon vrè atis.<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />Lonbrit ou kon yon tas won ki pa janm manke diven mele;</para>
  <para style="q1" vid="SNG 7:2">vant ou se yon bèl pakèt ble ankadre ak flè lis;<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:3 </char>
      <char style="xt" closed="false">
        <ref loc="SNG 4:5">Kan 4:5</ref>
      </char>
    </note>De tete ou se de jenn pòtre a yon antilòp,</para>
  <para style="q1" vid="SNG 7:3">jimo a yon antilòp.<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />Kou ou se yon kou ivwa,</para>
  <para style="q1" vid="SNG 7:4">zye ou tankou sous dlo nan <note caller="+" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="NUM 21:26">Nonb 21:26</ref></char></note>Hesbon yo</para>
  <para style="q1" vid="SNG 7:4">akote pòtay a Bath-Rabbim nan.</para>
  <para style="q1" vid="SNG 7:4">Nen ou tankou tou Liban ki gade vè Damas la.<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />Tèt ou kouwone ou tankou <note caller="+" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="ISA 35:2">És 35:2</ref></char></note>Mòn Carmel</para>
  <para style="q1" vid="SNG 7:5">e très cheve tèt ou tankou fisèl mov.</para>
  <para style="q1" vid="SNG 7:5">Wa a kaptire pa très ou yo.<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />A la ou <note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="SNG 1:15-16">Kan 1:15-16</ref></char></note>bèl e a la ou mèvèye,</para>
  <para style="q1" vid="SNG 7:6">ak tout bèlte ou yo!<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />Lè ou kanpe se tankou yon pye palmis</para>
  <para style="q1" vid="SNG 7:7">e tete ou se grap li yo.<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />Mwen te di: “Mwen va monte pye palmis lan,</para>
  <para style="q1" vid="SNG 7:8">mwen va kenbe tij fwi li yo.”</para>
  <para style="q1" vid="SNG 7:8">O ke tete ou yo kapab tankou grap</para>
  <para style="q1" vid="SNG 7:8">ki pann sou chan rezen nan</para>
  <para style="q1" vid="SNG 7:8">e bon odè a <note caller="+" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="SNG 2:5">Kan 2:5</ref></char></note>souf ou tankou pòm,<verse eid="SNG 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9" />Epi <note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="SNG 5:16">Kan 5:16</ref></char></note>bouch ou tankou meyè diven an, ki desann byen swa pou cheri mwen an,</para>
  <para style="q1" vid="SNG 7:9">e koule dousman nan lèv a sila</para>
  <para style="q1" vid="SNG 7:9">ki tonbe nan dòmi yo.<verse eid="SNG 7:9" /></para>
  <para style="b" />
  <para style="sp">Jenn Fi a</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />Mwen pou cheri mwen an</para>
  <para style="q1" vid="SNG 7:10">e <note caller="+" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="PSA 45:11">Sòm 45:11</ref> </char></note>dezi li se pou mwen.<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />Vini, cheri mwen an!</para>
  <para style="q1" vid="SNG 7:11">Annou pati ale nan chan yo</para>
  <para style="q1" vid="SNG 7:11">e fè lojman nan ti vil yo.<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />Annou leve bonè pou rive nan chan rezen yo;</para>
  <para style="q1" vid="SNG 7:12">annou <note caller="+" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="SNG 6:11">Kan 6:11</ref></char></note>gade pou wè si chan rezen an</para>
  <para style="q1" vid="SNG 7:12">gen tan boujonnen e flè li yo fin ouvri.</para>
  <para style="q1" vid="SNG 7:12">Se la, m ap bay ou lanmou mwen an.<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />Mandragò yo fin bay bèl odè;</para>
  <para style="q1" vid="SNG 7:13">epi sou tout pòt nou yo se tout meyè fwi yo,</para>
  <para style="q1" vid="SNG 7:13">ni nèf ni ansyen,</para>
  <para style="q1" vid="SNG 7:13">ki te konsève pou ou, lanmou mwen an.<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 8:1" />O ke ou te tankou frè m,</para>
  <para style="q1" vid="SNG 8:1">ki te souse nan tete a manman m.</para>
  <para style="q1" vid="SNG 8:1">Si mwen te jwenn ou deyò, mwen ta bo ou;</para>
  <para style="q1" vid="SNG 8:1">nonplis, pèsòn pa ta denonse m pou sa!<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />Mwen ta mennen ou e <note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="SNG 3:4">Kan 3:4</ref></char></note>fè ou antre</para>
  <para style="q1" vid="SNG 8:2">lakay a manman m ki te konn enstwi mwen an.</para>
  <para style="q1" vid="SNG 8:2">Mwen ta bay ou diven pafime ki sòti</para>
  <para style="q1" vid="SNG 8:2">nan ji grenad mwen yo pou ou bwè.<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />Kite <note caller="+" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="SNG 2:6">Kan 2:6</ref></char></note>men goch li rete anba tèt mwen</para>
  <para style="q1" vid="SNG 8:3">e men dwat li anbrase m.<verse eid="SNG 8:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />“<note caller="+" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="SNG 2:7">Kan 2:7</ref></char></note>Mwen vle nou sèmante, o fi Jérusalem yo,</para>
  <para style="q1" vid="SNG 8:4">pa fè lanmou a vin leve,</para>
  <para style="q1" vid="SNG 8:4">ni ankouraje l jiskaske se plezi li.<verse eid="SNG 8:4" /></para>
  <para style="b" />
  <para style="sp">Lòt Yo</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />Se <note caller="+" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="SNG 3:6">Kan 3:6</ref></char></note>ki fi sa a k ap monte sòti nan dezè a,</para>
  <para style="q1" vid="SNG 8:5">k ap apiye sou cheri li a?”</para>
  <para style="b" vid="SNG 8:5" />
  <para style="sp" vid="SNG 8:5">Jenn Fi an</para>
  <para style="q1" vid="SNG 8:5">Anba pye pòm nan, mwen te fè ou leve;</para>
  <para style="q1" vid="SNG 8:5">se la manman ou te gen doulè e te fè ou vin parèt.<verse eid="SNG 8:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />Mete mwen tankou yon so sou kè ou,</para>
  <para style="q1" vid="SNG 8:6">tankou yon <note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="ISA 49:16">És 49:16</ref></char></note>so sou bra ou.</para>
  <para style="q1" vid="SNG 8:6">Paske lanmou gen fòs menm jan ak lanmò.</para>
  <para style="q1" vid="SNG 8:6">Jalouzi sevè tankou Sejou mò yo;</para>
  <para style="q1" vid="SNG 8:6">lè l pete se tankou dife k ap pete.</para>
  <para style="q1" vid="SNG 8:6">Vrèman se flanm SENYÈ a.<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />Anpil dlo p ap ka etenn lanmou,</para>
  <para style="q1" vid="SNG 8:7">ni rivyè p ap ka inonde l.</para>
  <para style="q1" vid="SNG 8:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">8:7 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:35">Pwov 6:35</ref>
      </char>
    </note>Menm si yon nonm ta bay tout richès lakay li pou lanmou,</para>
  <para style="q1" vid="SNG 8:7">sa ta konplètman meprize.<verse eid="SNG 8:7" /></para>
  <para style="sp">Frè Yo</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />Nou gen yon ti sè e li <note caller="+" style="x"><char style="xo" closed="false">8:8 </char><char style="xt" closed="false"><ref loc="EZK 16:7">Éz 16:7</ref></char></note>pa gen tete menm;</para>
  <para style="q1" vid="SNG 8:8">kisa n ap fè pou sè nou an nan jou ke yon moun</para>
  <para style="q1" vid="SNG 8:8">ta vin pale pou l ta fiyanse avè l?<verse eid="SNG 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />Si ti fi a se yon mi, nou va bati yon ranpa fèt an ajan pou antoure l;</para>
  <para style="q1" vid="SNG 8:9">men, si li se yon pòt, n ap fè yon barikad</para>
  <para style="q1" vid="SNG 8:9">ak <note caller="+" style="x"><char style="xo" closed="false">8:9 </char><char style="xt" closed="false"><ref loc="1KI 6:15">I Wa 6:15</ref></char></note>gwo planch bwa sèd.<verse eid="SNG 8:9" /></para>
  <para style="b" />
  <para style="sp">Jenn Fi a</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />Mwen te yon miray e <note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="EZK 16:7">Éz 16:7</ref></char></note>tete mwen te tankou fò yo;</para>
  <para style="q1" vid="SNG 8:10">konsa, mwen te devni nan zye li kon yon moun ki jwenn lapè.<verse eid="SNG 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />Salomon te gen yon chan rezen nan Baal-Hamon;</para>
  <para style="q1" vid="SNG 8:11">Li te <note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 21:33">Mat 21:33</ref> </char></note>bay jerans chan rezen an a gadyen yo.</para>
  <para style="q1" vid="SNG 8:11">Yo chak te gen pou pote mil sik ajan pou fwi li yo.<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />Pwòp chan rezen mwen an se devan m;</para>
  <para style="q1" vid="SNG 8:12">mil sik ajan yo se pou ou, Salomon</para>
  <para style="q1" vid="SNG 8:12">ak de-san pou sila ki okipe fwi li yo.<verse eid="SNG 8:12" /></para>
  <para style="sp">Salomon</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />O ou menm, ki chita nan jaden yo,</para>
  <para style="q1" vid="SNG 8:13">ansanm ak zanmi mwen yo,</para>
  <para style="q1" vid="SNG 8:13">kite m tande vwa ou.<verse eid="SNG 8:13" /></para>
  <para style="b" />
  <para style="sp">Jenn Fi an</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />Annou pati, cheri mwen an!</para>
  <para style="q1" vid="SNG 8:14">Fè tankou yon antilòp,</para>
  <para style="q1" vid="SNG 8:14">oswa yon jenn sèf sou mòn ki plen epis yo.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>