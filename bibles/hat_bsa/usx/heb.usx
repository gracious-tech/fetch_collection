<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id" />
  <para style="h">Ebre Yo</para>
  <para style="toc1">EBRE YO</para>
  <para style="toc2">Ebre Yo</para>
  <para style="toc3">Eb</para>
  <para style="mt1">EBRE YO</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Bondye, nan tan lontan, nan plizyè epòk ak plizyè mwayen, te pale a zansèt nou yo pa pwofèt yo.<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="NUM 12:6">Nonb 12:6</ref>,<ref loc="NUM 12:8">8</ref></char></note><verse eid="HEB 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 1:2" />Nan dènye jou sa yo, Li pale ak nou pa Fis Li a, ke Li te chwazi kòm <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="PSA 2:8">Sòm 2:8</ref></char></note>eritye de tout bagay, e pa sila a osi, ke Li te fè mond lan. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Anplis, Li menm se refleksyon laglwa Li, ak <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="2CO 4:4">II Kor 4:4</ref></char></note>reprezantasyon egzakt de nati Li. Se Li ki <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="COL 1:17">Kol 1:17</ref></char></note>bay soutyen a tout bagay pa pawòl a pouvwa Li a.</para>
  <para style="p" vid="HEB 1:3">Lè li te fin pirifye tout peche yo, Li te monte chita sou bò dwat a Majeste anwo a. <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />Kòmsi li te devni bokou pi bon ke zanj yo, akoz Li eritye yon <note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="EPH 1:21">Ef 1:21</ref></char></note>non pi ekselan ke yo menm.<verse eid="HEB 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />Paske a kilès nan zanj yo, Li te janm di:</para>
  <para style="q1" vid="HEB 1:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:7">Sòm 2:7</ref>
      </char>
    </note>“Ou se Fis Mwen.</para>
  <para style="q1" vid="HEB 1:5">Jodi a Mwen fè Ou”?</para>
  <para style="m" vid="HEB 1:5">E ankò:</para>
  <para style="q1" vid="HEB 1:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:5 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:14">II Sam 7:14</ref>
      </char>
    </note>“Mwen va yon Papa pou Li e</para>
  <para style="q1" vid="HEB 1:5">Li va yon Fis pou Mwen,”<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />E ankò, lè Li te pote premye ne a nan mond lan, Li di: <note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="PSA 97:7">Sòm 97:7</ref></char></note>“Kite tout zanj Bondye yo adore Li,” <verse eid="HEB 1:6" /><verse number="7" style="v" sid="HEB 1:7" />A zanj yo Li di:</para>
  <para style="q1" vid="HEB 1:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:4">Sòm 104:4</ref>
      </char>
    </note>“Li fè zanj Li yo tounen van, e</para>
  <para style="q1" vid="HEB 1:7">sèvitè Li yo yon flanm dife”<verse eid="HEB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 1:8" />Men a Fis la, Li di:</para>
  <para style="q1" vid="HEB 1:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:6">Sòm 45:6</ref>
      </char>
    </note>“Twòn pa Ou a, O Bondye, se pou</para>
  <para style="q1" vid="HEB 1:8">Tout tan e pou tout tan.</para>
  <para style="q1" vid="HEB 1:8">E otorite san patipri a</para>
  <para style="q1" vid="HEB 1:8">se otorite wayòm Li an.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:7">Sòm 45:7</ref>
      </char>
    </note>Ou renmen ladwati e</para>
  <para style="q1" vid="HEB 1:9">ou rayi linikite;</para>
  <para style="q1" vid="HEB 1:9">konsa, Bondye, Bondye pa w la</para>
  <para style="q1" vid="HEB 1:9">te <note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="ISA 61:1">És 61:1</ref>,<ref loc="ISA 61:3">3</ref></char></note>onksyone ou avèk lwil lajwa a</para>
  <para style="q1" vid="HEB 1:9">pi plis ke parèy Ou yo.”<verse eid="HEB 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 1:10" />Epi,</para>
  <para style="q1" vid="HEB 1:10">“Ou menm, Senyè, nan kòmansman an</para>
  <para style="q1" vid="HEB 1:10">te poze fondasyon tè a.</para>
  <para style="q1" vid="HEB 1:10">Syèl yo se zèv lamen Ou.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:26">Sòm 102:26</ref>
      </char>
    </note>Yo va peri, men Ou va reste toujou.</para>
  <para style="q1" vid="HEB 1:11">Yo tout va vin vye tankou vètman.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Epi tankou yon manto,</para>
  <para style="q1" vid="HEB 1:12">Ou va woule yo, fè woulo nèt.</para>
  <para style="q1" vid="HEB 1:12">Tankou vètman, yo va vin chanje,</para>
  <para style="q1" vid="HEB 1:12">men Ou rete menm jan an.</para>
  <para style="q1" vid="HEB 1:12">Lane pa Ou yo p ap fini.” <note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="PSA 102:26">Sòm 102:26</ref>,<ref loc="PSA 102:27">27</ref></char></note><verse eid="HEB 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13" />Men a kilès nan zanj yo, Li janm di:</para>
  <para style="q1" vid="HEB 1:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:13 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 110:1">Sòm 110:1</ref>
      </char>
    </note>“Chita sou men dwat Mwen,</para>
  <para style="q1" vid="HEB 1:13">jiskaske Mwen fè lènmi Ou yo vin</para>
  <para style="q1" vid="HEB 1:13">yon ti ban pou pye Ou”?<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />Èske tout zanj yo se pa <note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="PSA 103:20">Sòm 103:20</ref></char></note>lespri sèvitè, ki te voye eksprè pou rann sèvis pou koz a sila ki va eritye sali yo?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Pou rezon sa a, nou dwe prete bokou plis atansyon a sa nou tande deja, pou <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="PRO 3:21">Pwov 3:21</ref></char></note>nou pa vin vag sou li.<verse eid="HEB 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 2:2" />Paske si pawòl ki te pale pa <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="ACT 7:53">Trav 7:53</ref></char></note>zanj yo pa t kapab vyole, e si tout transgresyon ak dezobeyisans te gen yon pinisyon ki jis, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" /><note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="HEB 10:29">Eb 10:29</ref></char></note>kòman nou va chape si nou neglije yon gran sali konsa?</para>
  <para style="p" vid="HEB 2:3">Aprè sa te fin pale pa Senyè a, li te vin konfìme pou nou pa sila ki te tande yo. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Bondye, osi, te pote temwayaj a yo menm, pa sign, pa mèvèy, pa plizyè mirak e pa <note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="1CO 12:4">I Kor 12:4</ref>,<ref loc="1CO 12:11">11</ref></char></note>don Lespri Sen yo selon pwòp volonte pa Li.<verse eid="HEB 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Paske Li pa t bay zanj yo kontwòl sou <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="MAT 24:14">Mat 24:14</ref></char></note>monn k ap vini an, sou sa n ap pale a, <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />men youn te temwaye yon kote, pou di:</para>
  <para style="q1" vid="HEB 2:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 8:4">Sòm 8:4</ref>
      </char>
    </note>“Kisa lòm ye, pou ou sonje li?</para>
  <para style="q1" vid="HEB 2:6">Oubyen, fis a lòm, pou ou sousye de li?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Ou fè li pou yon ti tan yon ti jan pi</para>
  <para style="q1" vid="HEB 2:7">piti pase zanj yo.</para>
  <para style="q1" vid="HEB 2:7">Ou kouwone li avèk glwa ak lonè.</para>
  <para style="q1" vid="HEB 2:7">Ou ba li pouvwa sou tout zèv men Ou yo;<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />e Ou mete tout bagay anba pye li.”</para>
  <para style="p" vid="HEB 2:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 8:5">Sòm 8:5</ref>,<ref loc="PSA 8:6">6</ref></char>
    </note> Paske nan bay li kontwòl sou tout bagay, Li pa kite anyen ki pa t kontwole pa li. Men koulye a <note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="1CO 15:25">I Kor 15:25</ref></char></note>malgre sa, nan moman sa a, nou poko wè tout bagay anba kontwòl li.<verse eid="HEB 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 2:9" />Men nou wè Li, Jésus, ki te fèt pou yon ti tan pi ba pase zanj yo, ki, <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="ACT 3:13">Trav 3:13</ref></char></note>akoz soufrans lanmò a, vin kouwone avèk glwa ak lonè, ke konsa pa lagras Bondye, Li ta kapab goute lanmò pou tout moun.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />Paske se te jan li te dwe ye pou Li a, kòmsi <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="ROM 11:36">Wo 11:36</ref></char></note>pou Li menm e nan Li menm ke tout bagay yo ye, pou mennen anpil fis nan laglwa, pou <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="HEB 5:9">Eb 5:9</ref></char></note>rann pafè Otè delivrans lan atravè soufrans li yo.<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />Paske Sila ki <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="HEB 13:12">Eb 13:12</ref></char></note>fè moun sen an, ni sila ki vin sen yo, yo tout soti nan yon sèl Papa. Se pou rezon sa a, Li pa wont rele yo frè. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Li di:</para>
  <para style="q1" vid="HEB 2:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:12 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:22">Sòm 22:22</ref>
      </char>
    </note>“Mwen va pwokame non Ou a frè m yo.</para>
  <para style="q1" vid="HEB 2:12">Nan mitan asanble a, Mwen va chante lwanj Ou.<verse eid="HEB 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 2:13" />Epi ankò:</para>
  <para style="q1" vid="HEB 2:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:13 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 8:17">És 8:17</ref>
      </char>
    </note>“Mwen va mete konfyans Mwen nan Li.”</para>
  <para style="m" vid="HEB 2:13">E ankò:</para>
  <para style="q1" vid="HEB 2:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:13 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 8:18">És 8:18</ref>
      </char>
    </note>“Gade, Mwen menm avèk pitit</para>
  <para style="q1" vid="HEB 2:13">ke Bondye te ban Mwen yo.”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Alò, paske timoun yo vin menm ak Li nan pataje <note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="MAT 16:17">Mat 16:17</ref></char></note>chè ak san, Li menm tou te patisipe menm jan an, pouke selon lanmò, Li ta kapab kase pouvwa a sila ki te gen pouvwa lanmò a, ki se, dyab la; <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />e ki ta kapab delivre tout sila ki akoz<note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ROM 8:15">Wo 8:15</ref></char></note>perèz lanmò yo, te sijè a esklavaj pou tout lavi yo.<verse eid="HEB 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 2:16" />Paske anverite, Li pa bay èd a zanj yo, men li bay èd a desandan Abraham yo.<verse eid="HEB 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 2:17" />Pou sa ta vin rive, li te <note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="PHP 2:7">Fil 2:7</ref></char></note>oblije vin fèt tankou frè Li yo nan tout aspè, pou Li ta kapab devni yon wo prèt fidèl ki gen mizerikòd nan tout bagay ki apatyen a Bondye, pou fè <note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="DAN 9:24">Dan 9:24</ref></char></note> yon sakrifis k ap padonnen peche a pèp yo. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Paske akoz ke Li menm te <note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="HEB 4:15">Eb 4:15</ref></char></note>tante nan sa ke Li te soufri a, Li kapab vin ede sila ki tante yo.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Konsa, frè sen yo, patisipan a yon <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="PHP 3:14">Fil 3:14</ref></char></note>apèl selès yo, konsidere Jésus, Apot ak Wo prèt lafwa ke n ap konfese a. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Li te fidèl a Sila ki te chwazi Li a, menmjan <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="EXO 40:16">Egz 40:16</ref></char></note>Moïse osi te fidèl nan tout kay Li a. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" /><note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="2CO 3:7-11">II Kor 3:7-11</ref></char></note>Paske Li te konte dign de plis glwa ke Moïse, menmjan ke konstriktè kay la gen plis onè pase kay la li menm. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Paske tout kay bati pa yon moun, men Sila ki bati tout bagay la, se Bondye. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Alò, Moïse te fidèl nan tout kay Li a, kòm yon <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="NUM 12:7">Nonb 12:7</ref></char></note>sèvitè <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="DEU 18:18">Det 18:18</ref></char></note>pou yon temwayaj a bagay sila ki t ap vin pale pita yo; <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Men Kris te fidèl kòm yon Fis nan kay Li a. <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="1CO 3:16">I Kor 3:16</ref></char></note>Se a kay pa Li nou ye a, si nou kenbe fèm nan konfyans nou an, ak fyète de fèm esperans ke nou gen jiska lafen an.<verse eid="HEB 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Konsa, jan Lespri Sen an di a:</para>
  <para style="q1" vid="HEB 3:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:8">Sòm 95:8</ref>
      </char>
    </note>“Jodi a, si nou tande vwa Li,<verse eid="HEB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8" />pa fè tèt nou di, jan lè yo te fè M fache a,</para>
  <para style="q1" vid="HEB 3:8">pandan jou tribilasyon yo nan dezè a,<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:11">Sòm 95:11</ref>
      </char>
    </note>kote Papa nou yo te fè eprèv mwen nan</para>
  <para style="q1" vid="HEB 3:9">tante Mwen, e te vin wè zèv Mwen yo</para>
  <para style="q1" vid="HEB 3:9">pandan <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="ACT 7:36">Trav 7:36</ref></char></note>karant ane.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:10 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:10">Sòm 95:10</ref>
      </char>
    </note>Konsa, Mwen te fache avèk jenerasyon sila a,</para>
  <para style="q1" vid="HEB 3:10">e M te di:</para>
  <para style="q1" vid="HEB 3:10">‘Yo toujou vin egare nan kè yo;</para>
  <para style="q1" vid="HEB 3:10">e yo pa t konnen chemen Mwen yo’.<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:11">Sòm 95:11</ref>
      </char>
    </note>Jan Mwen te sèmante nan kòlè Mwen an,</para>
  <para style="q1" vid="HEB 3:11">‘Yo p ap antre nan repo Mwen’.<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:8">Kol 2:8</ref>
      </char>
    </note>Fè atansyon, frè m yo, pou pa ta gen pami nou okenn mechan, kè enkredil ki tonbe lwen Bondye vivan an. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Men <note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="HEB 10:24">Eb 10:24</ref></char></note>ankouraje youn lòt jou aprè jou, toutotan li rele “jodi a”, pouke okenn nan nou pa vin fè tèt di pa <note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EPH 4:22">Ef 4:22</ref></char></note>sediksyon peche a.<verse eid="HEB 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 3:14" />Paske nou gen tan devni patisipan an Kris <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="HEB 3:6">Eb 3:6</ref></char></note>si nou kenbe fèm a premye <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="HEB 11:1">Eb 11:1</ref></char></note>asirans nou an jiska lafen; <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />Pandan ke li di:</para>
  <para style="q1" vid="HEB 3:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">3:15 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:7">Sòm 95:7</ref>
      </char>
    </note>“Jodi a si nou tande vwal L,</para>
  <para style="q1" vid="HEB 3:15">pa andisi kè nou,</para>
  <para style="q1" vid="HEB 3:15">jan lè yo te fè nan rebelyon an.”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Paske kilès ki te <note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="JER 32:29">Jr 32:29</ref></char></note>fè rebelyon an? Èske, vrèman, se pa t tout sila ki te sòti an Égypte ki te mennen pa Moïse yo?<verse eid="HEB 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 3:17" />Epi avèk kilès Li te fache pandan karant ane yo? Èske se pa avèk sila ki te peche yo <note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="NUM 14:29">Nonb 14:29</ref></char></note>ke kò yo te tonbe nan dezè a?<verse eid="HEB 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 3:18" />Epi a kilès Li te sèmante ke yo <note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="NUM 14:23">Nonb 14:23</ref></char></note>pa t ap antre nan repo, sof ke a sila ki te dezobeyisan yo?<verse eid="HEB 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 3:19" />Donk, nou wè ke yo pa t kapab antre akoz <note caller="+" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="JHN 3:18">Jn 3:18</ref>,<ref loc="JHN 3:36">36</ref></char></note>enkwayans yo.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Konsa, annou toujou gen lakrent pou si, pandan yon pwomès pou antre nan repo Li a toujou rete, okenn nan nou pa ta sanble vin <note caller="+" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="2CO 6:1">II Kor 6:1</ref></char></note>rate li.<verse eid="HEB 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 4:2" />Paske vrèman, bòn nouvèl la te preche a nou menm, menm jan ak yo, men <note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="ROM 10:17">Wo 10:17</ref></char></note>pawòl yo te tande a pa t fè avantaj pou yo, paske li pa t jwenn avèk lafwa nan sila ki te tande yo a. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Paske nou menm ki te kwè yo, nou te antre nan repo sa a, jan Li te di a: <note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Sòm 95:11</ref></char></note>“Jan Mwen te sèmante nan kòlè Mwen an, yo p ap antre nan repo Mwen”, malgre zèv Li yo fini depi nan fondasyon mond lan.<verse eid="HEB 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 4:4" />Paske Li te di, yon kote, konsènan setyèm jou a: <note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">Jen 2:2</ref></char></note>“Epi Bondye te repoze nan setyèm jou a de tout zèv Li yo.”<verse eid="HEB 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 4:5" />E ankò nan pasaj sa a: <note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Sòm 95:11</ref></char></note>“Yo p ap antre nan repo Mwen.”<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Konsa, paske li rete pou kèk moun antre ladann, epi sila ki, avan, te gen bòn nouvèl la preche a yo menm yo, te echwe antre ladann akoz <note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="HEB 3:18">Eb 3:18</ref></char></note>dezobeyisans yo, <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Li ankò fikse yon sèten jou, “Jodi a”, e sa te ankò di atravè David apre anpil tan <note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="HEB 3:7">Eb 3:7</ref></char></note>menm jan ke Li te di avan an: <note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="PSA 95:7">Sòm 95:7</ref></char></note>“Jodi a, si nou tande vwa Li, pa andisi kè nou.”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Paske <note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="JOS 22:4">Jos 22:4</ref></char></note>si Josué te bay yo repo, Li pa t ap pale de yon lòt jou apre sa.<verse eid="HEB 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 4:9" />Konsa, gen yon repo Saba ki rete pou pèp Bondye a. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Paske sila ki te antre nan repo Li a, li menm tou, te repoze de zèv li yo, jan <note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="GEN 2:2">Jen 2:2</ref></char></note>Bondye te fè pou zèv pa Li yo. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Konsa, annou fè dilijans pou antre nan repo sila a, pou okenn moun pa tonbe, nan swiv menm <note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="2PE 2:6">II Pi 2:6</ref></char></note>egzanp dezobeyisans lan.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Paske <note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="JER 23:29">Jr 23:29</ref></char></note>pawòl Bondye a vivan, aktif, li pi file pase yon nepe ki koupe de bò. Li penetre rive jis lè l divize nanm nan ak lespri a, menm jwenn zo ak mwèl, e li kapab jije panse ak lentansyon a kè yo. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" /><note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="2CH 16:9">II Kwo 16:9</ref></char></note>Nanpwen kreyati ki kache devan zye Li, men tout bagay ouvri nèt e parèt toutouni devan zye a Sila ke nou oblije ran kont.<verse eid="HEB 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Konsa, paske nou gen yon si tèlman <note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="HEB 2:17">Eb 2:17</ref></char></note>wo prèt ki te <note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="EPH 4:10">Ef 4:10</ref></char></note>travèse nan tout syèl yo, Jésus, Fis a Bondye a, annou kenbe fèm nan lafwa ke nou konfese a. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Paske nou pa gen yon wo prèt ki pa gen senpati ak feblès nou yo, men youn ki te <note caller="+" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="HEB 2:18">Eb 2:18</ref></char></note>tante nan tout bagay tankou nou menm, men <note caller="+" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="2CO 5:21">II Kor 5:21</ref></char></note>san peche.<verse eid="HEB 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 4:16" />Konsa, annou <note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="HEB 7:19">Eb 7:19</ref></char></note>rapwoche nou ak konfyans a twòn lagras la, pou nou kapab resevwa mizerikòd e twouve gras pou ede nou nan moman bezwen nou yo.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Paske tout wo prèt ki <note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="EXO 28:1">Egz 28:1</ref></char></note>pran pami moun se deziye pou moun, nan bagay ki apatyen a Bondye, pou l kapab ofri Bondye don ak sakrifis pou peche yo. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Konsa,<note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="HEB 2:18">Eb 2:18</ref></char></note>wo prèt la kapab aji ak konpasyon selon moun inyoran ak egare yo, paske li menm osi, li gen anpil feblès. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Epi akoz de sa, li oblije ofri sakrifis <note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="LEV 9:7">Lev 9:7</ref></char></note>pou peche pèp la, e pou pwòp tèt li tou. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" /><note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="NUM 16:40">Nonb 16:40</ref></char></note>Okenn moun konsa p ap pran onè pou tèt li, men li rele pa Bondye, menm jan Aaron te rele a. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Menmjan an, Kris pa t osi bay pwòp tèt Li glwa, pou L ta devni yon wo prèt, men Li menm, Bondye ki te di Li:</para>
  <para style="q1" vid="HEB 5:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:7">Sòm 2:7</ref>
      </char>
    </note>“Ou se Fis Mwen; jodi a Mwen vin Papa Ou.”;<verse eid="HEB 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 5:6" />Menmjan Li di osi nan yon lòt pasaj:</para>
  <para style="q1" vid="HEB 5:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 110:4">Sòm 110:4</ref>
      </char>
    </note>“Ou se yon prèt pou tou tan</para>
  <para style="q1" vid="HEB 5:6">selon modèl Melchisédek la.”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Nan jou lachè Li yo, <note caller="+" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="MAT 26:39">Mat 26:39</ref>,<ref loc="MAT 26:42">42</ref>,<ref loc="MAT 26:44">44</ref></char></note>Li te ofri priyè, siplikasyon avèk gwo kriye ak dlo nan zye a Sila sèl ki ta kapab sove Li soti nan lanmò a, e Li, Bondye, te tande akoz de sentete Li. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Malgre Li te <note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="HEB 1:2">Eb 1:2</ref></char></note>yon Fis, Li te aprann <note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PHP 2:8">Fil 2:8</ref></char></note>obeyisans nan bagay ke Li te soufri yo. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Epi apre, lè L te vin <note caller="+" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="HEB 2:10">Eb 2:10</ref></char></note>pafè, Li te vin devni pou tout sila ki obeyi Li yo, sous sali etènèl la, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />nonmen pa Bondye kòm <note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="HEB 2:17">Eb 2:17</ref></char></note>wo prèt nan modèl a Melchisédek la.<verse eid="HEB 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Konsènan Li menm, nou gen anpil bagay pou di, e se difisil pou eksplike akoz ke nou vin mal pou tande. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Paske malgre lè sa a, nou ta dwe vin mèt, nou bezwen ankò yon moun pou enstwi nou <note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="HEB 6:1">Eb 6:1</ref></char></note>prensip de baz revelasyon Bondye yo. Ou vin bezwen lèt olye manje solid.<verse eid="HEB 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 5:13" />Paske tout sila ki pran lèt sèlman yo, yo pa abitye avèk pawòl ladwati a, paske yo <note caller="+" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="1CO 3:1">I Kor 3:1</ref></char></note>bebe toujou. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Men manje solid la, se pou <note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="1CO 2:6">I Kor 2:6</ref></char></note>granmoun yo, ki akoz de pratik yo, vin gen kapasite pou distenge sa ki byen ak sa ki mal.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Konsa, nan <note caller="+" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="PHP 3:13">Fil 3:13</ref></char></note>kite enstriksyon elemantè sou Kris la, annou pouse de lavan vè matirite. Nou p ap poze ankò yon fondasyon repantans ki soti nan <note caller="+" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="HEB 9:14">Eb 9:14</ref></char></note>zèv mò yo, ak lafwa anvè Bondye, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" /><note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="JHN 3:25">Jn 3:25</ref></char></note>lenstriksyon sou lave ak poze men yo, <note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="ACT 17:31">Trav 17:31</ref></char></note>rezirèksyon a mò yo ak jijman etènèl la. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Tout sa nou va fè <note caller="+" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="ACT 18:21">Trav 18:21</ref></char></note>si Bondye kite l fèt.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Paske nan ka a sila ki, yon fwa, te <note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="2CO 4:4">II Kor 4:4</ref>,<ref loc="2CO 4:6">6</ref></char></note>eklere yo, ki te goute kado selès la, ki te vin patisipan nan Lespri Sen yo, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" /><note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="1PE 2:3">I Pi 2:3</ref></char></note>te goute bon pawòl Bondye a ak pouvwa a tan k ap vini an, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />e ki answit, te vin tonbe, se <note caller="+" style="x"><char style="xo" closed="false">6:6 </char><char style="xt" closed="false"><ref loc="HEB 10:26">Eb 10:26</ref></char></note>enposib pou renouvle yo ankò a repantans, paske yo ankò krisifye pou kont yo Fis Bondye a e ekspoze Li a lawont piblik.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Paske tè ki bwè lapli ki tonbe souvan sou li a, e ki pote plant ki itil a <note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="2TI 2:6">II Tim 2:6</ref></char></note>sila k ap kiltive tè a, resevwa benediksyon a Bondye. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Men si li pote pikan ak zepeng, li san valè e <note caller="+" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="GEN 3:17">Jen 3:17</ref></char></note>prèt pou vin madichonnen, e fini pa brile. <verse eid="HEB 6:8" /><verse number="9" style="v" sid="HEB 6:9" />Men <note caller="+" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="1CO 10:14">I Kor 10:14</ref></char></note>byeneme yo, nou konvenk de pi bon bagay konsènan nou menm yo, bagay ki akonpanye Sali yo, malgre se konsa n ap pale.<verse eid="HEB 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 6:10" />Paske <note caller="+" style="x"><char style="xo" closed="false">6:10 </char><char style="xt" closed="false"><ref loc="PRO 19:17">Pwov 19:17</ref></char></note>Bondye pa enjis pou Li ta bliye travay nou ak lanmou ke nou montre anvè non Li, ke nou te bay e kontinye ap bay a sen yo. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Nou dezire ke nou chak montre menm dilijans lan pou nou kapab gen yon <note caller="+" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="HEB 3:6">Eb 3:6</ref></char></note>espwa ranpli nan <note caller="+" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="HEB 10:22">Eb 10:22</ref></char></note>asirans konplè jiska lafen, <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />pou nou pa vin mou, men rete <note caller="+" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="HEB 13:7">Eb 13:7</ref></char></note>imitatè a sila ki, atravè lafwa ak tenasite, te vin eritye pwomès yo.<verse eid="HEB 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Paske lè Bondye te fè pwomès la a Abraham, akoz ke Li pa t kapab sèmante pa okenn pi gran, Li te <note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="GEN 22:16">Jen 22:16</ref></char></note>sèmante pa pwòp tèt Li. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Li te di: “Byensi <note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="GEN 22:17">Jen 22:17</ref></char></note>Mwen va beni ou, e byensi, Mwen va miltipliye nou.” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Konsa, nan <note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="GEN 12:4">Jen 12:4</ref></char></note>tann li avèk anpil andirans, Abraham te resevwa pwomès la.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />Paske moun toujou sèmante pa yon moun ki pi gran pase yo, e nan nenpòt malantandi <note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="EXO 22:11">Egz 22:11</ref></char></note>yon sèman ki fèt avèk yon akò fèmen tout diskisyon.<verse eid="HEB 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 6:17" />Nan menm fason an, Bondye, ak volonte pou menm plis montre <note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="HEB 11:9">Eb 11:9</ref></char></note>eritye pwomès yo ke bi Li a pa kab chanje, Li te pale avèk yon sèman. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Pouke pa <note caller="+" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="NUM 23:19">Nonb 23:19</ref></char></note>de (2) bagay ki pa kab chanje yo, pa sila ke li enposib pou Bondye bay manti, nou menm ki te pran refij nan Kris la, nou genyen yon gwo ankourajman pou kenbe esperans ki plase devan nou an. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Lesperans sa a ke nou gen kòm lank pou nanm nou an, yon esperans ki asire e solid, youn ki <note caller="+" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="LEV 16:2">Lev 16:2</ref>,<ref loc="LEV 16:15">15</ref></char></note>menm antre anndan vwal tanp lan, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" /><note caller="+" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="JHN 14:2">Jn 14:2</ref></char></note>kote Jésus te deja antre kòm youn ki kouri devan pou nou, e te devni yon wo prèt pou tout tan nan lòd Melchisédek la.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Paske <note caller="+" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="GEN 14:18-20">Jen 14:18-20</ref></char></note>Melchisédek sila a, wa Salem nan, prèt a Bondye Pi Wo a, ki te rankontre Abraham lè l t ap retounen soti nan masak wa yo e te beni li, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />a li menm osi Abraham te bay yon dim nan tout piyaj la, ki te dabò, nan tradwi non li, wa ladwati, e menm osi wa Salèm, ki vle di wa lapè. <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />San papa, san manman, san listwa zansèt, ki pa t gen ni kòmansman nan jou li yo, ni lafen nan lavi li, men fèt tankou <note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="HEB 7:28">Eb 7:28</ref></char></note>Fis a Bondye a, li rete yon prèt pou tout tan.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Alò, obsève kijan mesye sa a te gran; menm Abraham, <note caller="+" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="ACT 2:29">Trav 2:29</ref></char></note>patriyach la, te bay li yon dim nan pi bon pati piyaj sila a. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Konsa, sila vrèman de <note caller="+" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">Nonb 18:21</ref>,<ref loc="NUM 18:26">26</ref></char></note>fis a Lévi yo, ki te resevwa plas a wo prèt la, te gen yon kòmandman nan lalwa pou fè kolekte yon dim ki soti nan pèp la, sa vle di, ki soti nan frè yo, malgre ke yo se desandan Abraham.<verse eid="HEB 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 7:6" />Men youn ki pa menm pami zansèt li yo, te kolekte yon dim soti nan Abraham e te beni sila <note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="ROM 4:13">Wo 4:13</ref></char></note>ki te gen tout pwomès yo. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Men san kesyon, pi piti a beni pa pi gran an.<verse eid="HEB 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 7:8" />Nan ka sila a, lòm mòtèl yo resevwa dim yo, men nan lòt ka a, yon moun resevwa yo <note caller="+" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="HEB 5:6">Eb 5:6</ref></char></note>de sila ke yo temwaye ke li viv toujou. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Epi nou kapab di ke, selon Abraham menm Lévi, ki te resevwa dim yo, te peye dim yo, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />paske li te toujou nan ren a Papa l lè Melchisédek te rankontre li a.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:11 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 7:18">Eb 7:18</ref>
      </char>
    </note>Alò, si pèfeksyon an te nan sistèm prèt Levitik yo (paske se sou baz sa a ke <note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="HEB 10:1">Eb 10:1</ref></char></note>pèp la te resevwa Lalwa), ki bezwen anplis ki te gen pou yon lòt prèt leve nan modèl Melchisédek la, ki pa t dezigne selon modèl Aaron an?<verse eid="HEB 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 7:12" />Paske lè sistèm prèt la vin chanje, vin gen nesesite pou yon chanjman lalwa tou. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Paske <note caller="+" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="HEB 7:14">Eb 7:14</ref></char></note>sou sila ke n ap pale la a, li se yon manm nan yon lòt tribi ki pa t gen okenn moun ki te fè sèvis devan lotèl la.<verse eid="HEB 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 7:14" />Paske li byen klè ke Senyè nou an te desann <note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="NUM 24:17">Nonb 24:17</ref></char></note>sòti nan Juda, yon tribi ki pa gen korespondans ak anyen Moïse te pale konsènan zafè prèt yo. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Epi sa pi klè toujou, si yon lòt prèt leve selon resanblans a Melchisédek, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />ki pa t devni konsa sou baz a yon <note caller="+" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="HEB 9:10">Eb 9:10</ref></char></note>lwa lachè, men selon pouvwa a yon lavi ki pa t kab peri. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Paske li temwaye de Li: <note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Sòm 110:4</ref></char></note>“Ou se yon prèt pou tout tan nan modèl a Melchisédek la.”<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />Paske sou yon bò, yo mete sou kote ansyen kòmandman an <note caller="+" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="ROM 8:3">Wo 8:3</ref></char></note>akoz de feblès ak initilite li. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />(Paske <note caller="+" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="ACT 13:39">Trav 13:39</ref></char></note>Lalwa pa t fè anyen pafè), epi sou lòt bò, yo mennen yon pi bon espwa, e atravè li menm nou vin rapwoche de Bondye. <verse eid="HEB 7:19" /><verse number="20" style="v" sid="HEB 7:20" />E kòmsi, li pa t fèt yon prèt san yon sèman, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />paske vrèman prèt lalwa yo te vin prèt san sèman, men Li menm avèk yon sèman, atravè Sila ki te di Li a:</para>
  <para style="q1" vid="HEB 7:21">
    <note caller="+" style="x">
      <char style="xo" closed="false">7:21 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 110:4">Sòm 110:4</ref>
      </char>
    </note>“Senyè a gen tan sèmante e Li p ap chanje tèt Li;</para>
  <para style="q1" vid="HEB 7:21">‘Ou se yon prèt pou tout tan’.”</para>
  <para style="q1" vid="HEB 7:21">Selon modèl a Melchisédek la.”<verse eid="HEB 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 7:22" />Konbyen anplis ke sa, Jésus gen tan vin <note caller="+" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="PSA 119:122">Sòm 119:122</ref></char></note>garanti a yon pi bon akò. <verse eid="HEB 7:22" /><verse number="23" style="v" sid="HEB 7:23" />Lansyen prèt yo, sou yon bò, te egziste an gran nonb, paske lanmò te anpeche yo kontinye fè sèvis yo, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />men Jésus, de lòt bò, akoz ke Li la <note caller="+" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="ISA 9:7">És 9:7</ref></char></note>pou tout tan, Li kenbe pozisyon prèt Li a pou tout tan.<verse eid="HEB 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 7:25" />Konsa, osi, Li kapab sove pou tout tan sila ki vin rapwoche de Bondye atravè Li menm yo, paske Li toujou vivan pou <note caller="+" style="x"><char style="xo" closed="false">7:25 </char><char style="xt" closed="false"><ref loc="ROM 8:34">Wo 8:34</ref></char></note>entèsede pou yo.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Paske se te byen an lòd pou nou ta gen yon wo prèt konsa, sen <note caller="+" style="x"><char style="xo" closed="false">7:26 </char><char style="xt" closed="false"><ref loc="1PE 2:22">I Pi 2:22</ref></char></note>inosan, san tach, separe de pechè yo e <note caller="+" style="x"><char style="xo" closed="false">7:26 </char><char style="xt" closed="false"><ref loc="HEB 4:14">Eb 4:14</ref></char></note>egzalte piwo ke syèl yo; <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />ki pa bezwen chak jou, tankou wo prèt sila yo, ofri sakrifis, premyèman pou pwòp peche pa L e anplis pou peche a pèp la, paske Li te deja fè sa <note caller="+" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="HEB 9:12">Eb 9:12</ref>,<ref loc="HEB 9:28">28</ref></char></note>yon fwa pou tout, lè Li te ofri tèt Li a.<verse eid="HEB 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 7:28" />Paske Lalwa nonmen moun <note caller="+" style="x"><char style="xo" closed="false">7:28 </char><char style="xt" closed="false"><ref loc="HEB 5:2">Eb 5:2</ref></char></note>ki fèb kòm wo prèt, men pawòl a sèman, ki te vini aprè Lalwa a, te nonmen yon Fis ki te <note caller="+" style="x"><char style="xo" closed="false">7:28 </char><char style="xt" closed="false"><ref loc="HEB 2:10">Eb 2:10</ref></char></note>fèt pafè pou tout tan.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Koulye a, pwen prensipal nan sa ki te di a se sa: “Nou gen yon si tèlman wo prèt ki pran plas Li <note caller="+" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Sòm 110:1</ref></char></note>adwat a twòn Majeste a nan syèl yo.” <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />Pou Li aji kòm sèvitè nan sanktyè a, ak nan <note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="HEB 9:11">Eb 9:11</ref>,<ref loc="HEB 9:24">24</ref></char></note>vrè tabènak la ke Senyè a, olye lòm te fè leve.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Paske chak <note caller="+" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="HEB 2:17">Eb 2:17</ref></char></note>wo prèt nonmen pou ofri ni don ni sakrifis. Konsa li nesesè pou wo prèt sila a gen yon bagay pou l ofri tou. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Alò, si Li te sou latè, Li pa t ap yon prèt menm, paske pou sa a, gen sila yo ki <note caller="+" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="HEB 5:1">Eb 5:1</ref></char></note>ofri don yo selon Lalwa, <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />ki sèvi kòm yon kopi ak lonbraj a bagay selès yo, jis jan ke Moïse te avèti pa Bondye lè Li te prèt pou leve tabènak la, paske <note caller="+" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="EXO 25:40">Egz 25:40</ref></char></note>“Veye” Li te di: “pou ou fè tout bagay selon modèl ki te montre a ou menm sou mòn nan.”<verse eid="HEB 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 8:6" />Men koulye a, Li vin gen yon èv ki pi ekselan, paske Li se osi <note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="1TI 2:5">I Tim 2:5</ref></char></note>medyatè a yon pi bon akò, ki te etabli sou pi bon pwomès yo.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Paske <note caller="+" style="x"><char style="xo" closed="false">8:7 </char><char style="xt" closed="false"><ref loc="HEB 7:11">Eb 7:11</ref></char></note>si premye akò sa a te san defo, pa t ap gen yon rezon pou yon dezyèm. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Paske akoz Li twouve fot nan yo, Li di:</para>
  <para style="q1" vid="HEB 8:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">8:8 </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:31">Jr 31:31</ref>
      </char>
    </note>“Gade byen, jou yo ap vini, di Senyè a,</para>
  <para style="q1" vid="HEB 8:8">lè Mwen va fè yon akò tounèf avèk kay Israël la</para>
  <para style="q1" vid="HEB 8:8">e avèk kay Juda a;<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:9 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 19:5">Egz 19:5</ref>
      </char>
    </note>Pa tankou akò ke Mwen te fè avèk zansèt pa yo</para>
  <para style="q1" vid="HEB 8:9">nan jou ke M te pran yo nan men</para>
  <para style="q1" vid="HEB 8:9">pou mennen yo sòti an Égypte la;</para>
  <para style="q1" vid="HEB 8:9">paske yo pa t kontinye nan akò Mwen an</para>
  <para style="q1" vid="HEB 8:9">e Mwen pa t okipe yo, di Senyè a.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:10 </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:33">Jr 31:33</ref>
      </char>
    </note>Paske sa se akò ke Mwen va fè avèk kay Israël la</para>
  <para style="q1" vid="HEB 8:10">apre jou sa yo, di Senyè a:</para>
  <para style="q1" vid="HEB 8:10">Mwen va mete Lalwa Mwen nan panse yo,</para>
  <para style="q1" vid="HEB 8:10">e Mwen va ekri yo nan kè yo.</para>
  <para style="q1" vid="HEB 8:10">Mwen va Bondye yo,</para>
  <para style="q1" vid="HEB 8:10">e yo va pèp Mwen.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:11 </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:34">Jr 31:34</ref>
      </char>
    </note>Epi yo p ap enstwi chak sitwayen parèy a yo</para>
  <para style="q1" vid="HEB 8:11">ak chak frè a yo, pou di: ‘Vin konnen Bondye’,</para>
  <para style="q1" vid="HEB 8:11">paske tout moun ap deja konnen Mwen, soti nan</para>
  <para style="q1" vid="HEB 8:11">pi piti jiska pi gran nan yo.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:12 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 43:25">És 43:25</ref>
      </char>
    </note>Paske Mwen va gen mizerikòd pou linikite pa yo</para>
  <para style="q1" vid="HEB 8:12">e Mwen p ap sonje peche yo ankò.<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Lè L te di: <note caller="+" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="LUK 22:20">Luc 22:20</ref></char></note>“Yon akò tounèf”, Li fè premye a epwize nèt. Men, nenpòt sa ki vin epwize a, e ki vin vye, prè pou vin disparèt.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Alò, menm premye akò a te gen <note caller="+" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="HEB 9:10">Eb 9:10</ref></char></note>règleman pou adore Bondye ak sanktyè tèrès la. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Paske te gen <note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="EXO 25:8">Egz 25:8</ref>,<ref loc="EXO 25:9">9</ref></char></note>yon tabènak ki te fin prepare. Sa ki pa deyò a, nan li te gen chandelye a, tab la, ak pen sakre a. Yo rele l lye sen an.<verse eid="HEB 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 9:3" />Andedan <note caller="+" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Egz 26:31-33</ref></char></note>dezyèm vwal la, te gen yon tabènak ke yo te rele Sen de Sen yo. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />Li gen yon <note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EXO 30:1-5">Egz 30:1-5</ref></char></note>lotèl an lò pou lansan an, ak lach akò a ki kouvri nan tout kote avèk lò. Ladann te gen yon vaz an lò ki gen lamàn nan, ak baton Aaron an ki te boujonnen, ak tablèt akò yo. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Epi anwo li, se te cheriben laglwa a ki te fè lonbraj sou plas ekspiyasyon an. Men de bagay sa yo, nou pa kab pale an detay koulye a.<note caller="+" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="EXO 25:17">Egz 25:17</ref>,<ref loc="EXO 25:20">20</ref></char></note><verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Alò, lè bagay sa yo fin byen prepare konsa, prèt yo ap <note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="NUM 18:2-6">Nonb 18:2-6</ref></char></note>toujou antre nan tabènak pa deyò a, pou fè adorasyon Bondye, <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />men nan dezyèm nan, se sèl wo prèt la ki antre ladann yon fwa pa ane. Men fòk li pote <note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="LEV 16:11">Lev 16:11</ref>,<ref loc="LEV 16:14">14</ref></char></note>san, ke li ofri pou tèt li a ak pou <note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="NUM 15:25">Nonb 15:25</ref></char></note>peche ke pèp la te fè nan inyorans yo.<verse eid="HEB 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 9:8" />Lespri Sen an ap fè nou konnen sa a; <note caller="+" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="JHN 14:6">Jn 14:6</ref></char></note>ke chemen pou antre nan lye sen an poko fin revele, pandan tabènak deyò a toujou kanpe. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Tabènak sila a se yon imaj pou tan prezan sila a. Selon sa a <note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="HEB 5:1">Eb 5:1</ref></char></note>ni kado ni sakrifis k ap ofri yo pa kapab fè adoratè a vin pafè nan konsyans li, <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />paske yo lye sèlman ak <note caller="+" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="LEV 11:2">Lev 11:2</ref></char></note>manje, bwason, ak plizyè bagay pou lave, règleman kò ki enpoze jis pou <note caller="+" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="HEB 7:12">Eb 7:12</ref></char></note>lè tout bagay vin nèf.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Men lè Kris te parèt tankou <note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="HEB 2:17">Eb 2:17</ref></char></note>wo prèt a bon bagay ki t ap vini yo, li te antre nan tabènak pi gran e pi pafè a, ki pa fèt avèk men; sa vle di, ki pa t sòti nan kreyasyon sila a. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Li pa te depann sou san kabrit ak jenn ti bèf, men <note caller="+" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="HEB 9:14">Eb 9:14</ref></char></note>nan pwòp san pa Li. Konsa, Li te antre nan lye sen an yon fwa pou tout, akoz Li te resevwa yon redanmsyon etènèl.<verse eid="HEB 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 9:13" />Paske si <note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="LEV 16:15">Lev 16:15</ref></char></note>san a kabrit, ak towo, ak pousyè sann a yon gazèl voye sou sila ki te konwonpi yo, te sanktifye yo pou netwaye chè a, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />konbyen anplis ke <note caller="+" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="HEB 9:12">Eb 9:12</ref></char></note>san a Kris la, ki atravè Lespri etènèl la, ki te ofri pwòp tèt Li san tach a Bondye, va netwaye konsyans nou de zèv lanmò yo, pou sèvi Bondye vivan an?<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Pou rezon sila a, Li se <note caller="+" style="x"><char style="xo" closed="false">9:15 </char><char style="xt" closed="false"><ref loc="1TI 2:5">I Tim 2:5</ref></char></note>medyatè a yon akò tounèf. Pouke, depi yon mò gen tan fèt pou redanmsyon transgresyon ki te komèt anba premye akò a, sila yo ki te rele a, kapab resevwa pwomès a eritaj etènèl la.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Paske kote denyè testaman akò mò a ye, fòk gen lanmò a sila ki te fè l la. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Paske yon denyè testaman akò mò valab sèlman lè moun mouri, paske li pa janm an fòs pandan sila ki te fè l la toujou vivan.<verse eid="HEB 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 9:18" />Konsa, menm premye akò a pa t inogire san san. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Paske lè tout kòmandman yo te fin pale pa Moïse a tout pèp la selon Lalwa <note caller="+" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="EXO 24:6">Egz 24:6</ref></char></note>li te pran san a towo ak kabrit <note caller="+" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="LEV 14:4-7">Lev 14:4-7</ref></char></note>avèk dlo, lenn wouj ak izòp, e te aspèje yo ni sou liv la, ak tout pèp la. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />E konsa li te di: <note caller="+" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Egz 24:8</ref></char></note>“Sa se san akò ke Bondye te kòmande nou an.”<verse eid="HEB 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 9:21" />Menm jan an, li te <note caller="+" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="EXO 24:6">Egz 24:6</ref></char></note>flite tabènak la ak tout veso pou sèvis yo avèk san an. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Epi selon Lalwa, se <note caller="+" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="LEV 5:11">Lev 5:11</ref></char></note>prèske tout bagay ki netwaye avèk san, e san vèsman san, nanpwen padon.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Konsa, li te nesesè pou kopi <note caller="+" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="HEB 8:5">Eb 8:5</ref></char></note>a bagay ki nan syèl yo ta vin netwaye avèk san sila a, men bagay selès yo, yo menm, avèk yon pi bon sakrifis ke sa yo.<verse eid="HEB 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 9:24" />Paske Kris <note caller="+" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="HEB 4:14">Eb 4:14</ref></char></note>pa t antre nan yon lye sen ki te fèt avèk men, yon kopi senp de sa ki vrè a, men nan syèl la li menm; konsa, pou l parèt nan prezans a Bondye pou nou. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Ni se pa t pou Li ta kab ofri tèt Li souvan, kòm <note caller="+" style="x"><char style="xo" closed="false">9:25 </char><char style="xt" closed="false"><ref loc="HEB 9:7">Eb 9:7</ref></char></note>wo prèt ki antre nan lye sen an ane aprè ane avèk san ki pa pou li a. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Otreman, Li t ap bezwen soufri souvan depi fondasyon mond lan; men koulye a <note caller="+" style="x"><char style="xo" closed="false">9:26 </char><char style="xt" closed="false"><ref loc="HEB 7:27">Eb 7:27</ref></char></note>pou yon sèl fwa nan fen tan yo, Li te vin parèt pou aboli peche yo pa sakrifis a Li menm nan.<verse eid="HEB 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 9:27" />Epi konsa, jan <note caller="+" style="x"><char style="xo" closed="false">9:27 </char><char style="xt" closed="false"><ref loc="GEN 3:19">Jen 3:19</ref></char></note>sa apwente pou moun mouri yon sèl fwa a, e apre sa <note caller="+" style="x"><char style="xo" closed="false">9:27 </char><char style="xt" closed="false"><ref loc="2CO 5:10">II Kor 5:10</ref></char></note>jijman an vini an, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />konsa Kris tou, ki te ofri yon sèl fwa pou <note caller="+" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">És 53:12</ref></char></note>pote peche a anpil moun nan, va vin parèt yon dezyèm fwa pou pote sali, san referans a peche, pou sila k ap vrèman tann Li yo.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Paske Lalwa a, akoz ke se sèlman yon lonbraj a bon bagay k ap vini yo, e ki pa vrè fòm a bagay sa yo, pa <note caller="+" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="ROM 8:3">Wo 8:3</ref></char></note>janm kapab, ak menm sakrifis ke yo ofri, tout tan ane apre ane yo <note caller="+" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="HEB 7:19">Eb 7:19</ref></char></note> fè vin pafè moun ki te rapwoche de li yo. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Otreman, èske yo pa t ap sispann ofri sakrifis sa yo, akoz de adoratè yo, lè yo te fin netwaye yon fwa, yo pa t ap <note caller="+" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="1PE 2:19">I Pi 2:19</ref></char></note>vin sanse pechè ankò?<verse eid="HEB 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 10:3" />Men <note caller="+" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="HEB 9:7">Eb 9:7</ref></char></note>nan sakrifis sa yo, gen yon sistèm pou sonje peche yo ane apre ane. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Paske se enposib pou <note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="HEB 9:12">Eb 9:12</ref></char></note>san towo ak kabrit efase peche.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Konsa, lè Li vini nan mond lan, Li te di:</para>
  <para style="q1" vid="HEB 10:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">10:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:6">Sòm 40:6</ref>
      </char>
    </note>“Sakrifis ak ofrann Ou pa t dezire,</para>
  <para style="q1" vid="HEB 10:5">men yon kò Ou te prepare pou Mwen.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:6">Sòm 40:6</ref>
      </char>
    </note>Nan tout ofrann ki brile</para>
  <para style="q1" vid="HEB 10:6">ak sakrifis pou peche,</para>
  <para style="q1" vid="HEB 10:6">Ou pa t pran plezi.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:7">Sòm 40:7</ref>,<ref loc="PSA 40:8">8</ref></char>
    </note>Answit, Mwen te di:</para>
  <para style="q1" vid="HEB 10:7">‘Gade, Mwen gen tan vini</para>
  <para style="q1" vid="HEB 10:7">(nan woulo liv la li ekri de Mwen)</para>
  <para style="q1" vid="HEB 10:7">“pou fè volonte Ou, o Bondye.’”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />Lè L te fin di tout sa a: <note caller="+" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="PSA 40:6">Sòm 40:6</ref></char></note>“Sakrifis ak ofrann yo, tout ofrann brile ak sakrifis pou peche yo, Ou pa t dezire yo, ni Ou pa t pran plezi nan yo” (sila k ap ofri selon Lalwa yo).<verse eid="HEB 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 10:9" />Answit, Li te di: <note caller="+" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="PSA 40:7">Sòm 40:7</ref>,<ref loc="PSA 40:8">8</ref></char></note>“Gade, Mwen vini pou fè volonte Ou.”</para>
  <para style="p" vid="HEB 10:9">Li retire premye a pou Li kapab etabli dezyèm nan. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Pa volonte sila a, nou <note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="JHN 17:19">Jn 17:19</ref></char></note>vin sanktifye pa <note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="EPH 5:2">Ef 5:2</ref></char></note>ofrann a kò Jésus Kris la yon fwa pou tout.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Chak prèt kanpe chak jou pou fè ministè li e <note caller="+" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="HEB 5:1">Eb 5:1</ref></char></note>l ofri, tan apre tan, menm sakrifis yo, ki <note caller="+" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MIC 6:6-8">Mi 6:6-8</ref></char></note>pa janm kapab efase peche yo.<verse eid="HEB 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 10:12" />Men Li menm, ki te ofri yon sèl sakrifis pou peche yo pou tout tan an, Li <note caller="+" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Sòm 110:1</ref></char></note>te vin chita sou men dwat a Bondye, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />pou Li ta tann depi lè sa jis rive pi devan an <note caller="+" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Sòm 110:1</ref></char></note>jiskaske lènmi li yo vin tounen yon ti ban pou pye li. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Paske pa yon sèl ofrann, Li te vin rann <note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="HEB 10:1">Eb 10:1</ref></char></note>pafè pou tout tan sila ki vin sen yo.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Epi <note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="HEB 3:7">Eb 3:7</ref></char></note>Lespri Sen an temwaye osi a nou menm. Paske apre Li te di:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:16 </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:33">Jr 31:33</ref>
      </char>
    </note>“Sa se akò ke Mwen va fè avèk yo</para>
  <para style="q1" vid="HEB 10:16">apre jou sa yo, di Senyè a;</para>
  <para style="q1" vid="HEB 10:16">Mwen va mete Lwa Mwen nan kè yo,</para>
  <para style="q1" vid="HEB 10:16">e nan panse yo, Mwen va ekri yo.”</para>
  <para style="p" vid="HEB 10:16">Li di answit:<verse eid="HEB 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HEB 10:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:17 </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:34">Jr 31:34</ref>
      </char>
    </note>“Epi peche ak inikite yo,</para>
  <para style="q1" vid="HEB 10:17">Mwen p ap sonje yo ankò.”<verse eid="HEB 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18" />Alò, kote gen padon pou bagay sa yo, nanpwen ofrann pou peche ankò.<verse eid="HEB 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Konsa, frè yo, paske nou gen konfyans <note caller="+" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="HEB 9:25">Eb 9:25</ref></char></note>pou antre nan lye sen an pa san Jésus a <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />pa yon chemen tounèf e vivan ke Li te ouvri pou nou <note caller="+" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="HEB 6:19">Eb 6:19</ref></char></note>atravè vwal la, ki se chè Li, <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />epi paske nou vin gen yon Granprèt <note caller="+" style="x"><char style="xo" closed="false">10:21 </char><char style="xt" closed="false"><ref loc="1TI 3:15">I Tim 3:15</ref></char></note>lakay Bondye a, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />annou <note caller="+" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="HEB 7:19">Eb 7:19</ref></char></note>rapwoche nou avèk yon kè sensè, ki plen asirans lafwa, avèk kè nou ki vin pwòp de yon move konsyans, e kò nou ki vin lave avèk dlo pwòp. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Pou nou kenbe fèm a <note caller="+" style="x"><char style="xo" closed="false">10:23 </char><char style="xt" closed="false"><ref loc="HEB 3:1">Eb 3:1</ref></char></note>pwofesyon esperans lan, san ezite, paske Sila ki fè pwomès la, Li fidèl.<verse eid="HEB 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 10:24" />Epi annou konsidere jan pou nou kapab <note caller="+" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="HEB 13:1">Eb 13:1</ref></char></note>ankouraje youn lòt nan lanmou ak bon zèv. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Pa nan abandone pwòp asanble nou, jan kèk moun abitye fè, men nan <note caller="+" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="HEB 3:13">Eb 3:13</ref></char></note>ankouraje youn lòt, e plis menm akoz nou wè jou a ap pwoche.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Paske si nou kontinye nan <note caller="+" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="NUM 15:30">Nonb 15:30</ref></char></note>peche volontèman aprè nou resevwa <note caller="+" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="1TI 2:4">I Tim 2:4</ref></char></note>konesans verite a, p ap gen yon sakrifis pou peche ki rete ankò, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />men n ap tann ak laperèz yon jijman ki asire, ak <note caller="+" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="ISA 26:11">És 26:11</ref></char></note>yon dife anraje, ranpli lakòlè ki va konsome tout advèsè yo.<verse eid="HEB 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 10:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:28 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 17:2-6">Det 17:2-6</ref>
      </char>
    </note>Nenpòt moun ki te konn mete sou kote Lalwa Moïse la te gen pou mouri san mizerikòd avèk temwayaj de de oubyen twa temwen. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Ki pinisyon pi rèd ou panse li va merite, sila ki foule anba pye li Fis a Bondye a, e gade <note caller="+" style="x"><char style="xo" closed="false">10:29 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Egz 24:8</ref></char></note>san akò pa sila li te vin sanktifye a, kòm pa pwòp, e ki ensilte Lespri lagras la?<verse eid="HEB 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 10:30" />Paske nou konnen Sila ki te di a: <note caller="+" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="ROM 12:19">Wo 12:19</ref></char></note>“Vanjans se pou Mwen. Mwen va rekonpanse.” E ankò: <note caller="+" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="DEU 32:36">Det 32:36</ref></char></note>“Senyè a va jije pèp Li a.” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Se yon bagay ki tèrib pou tonbe nan men <note caller="+" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 16:16">Mat 16:16</ref></char></note>Bondye vivan an.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Men sonje jou nan tan pase yo, lè apre nou te fin <note caller="+" style="x"><char style="xo" closed="false">10:32 </char><char style="xt" closed="false"><ref loc="HEB 6:4">Eb 6:4</ref></char></note>eklere, nou te andire yon gwo <note caller="+" style="x"><char style="xo" closed="false">10:32 </char><char style="xt" closed="false"><ref loc="PHP 1:30">Fil 1:30</ref></char></note>konfli soufrans <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />nan yon jan, nou te <note caller="+" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="1CO 4:9">I Kor 4:9</ref></char></note>devni yon spektak piblik, repwòch ak tribilasyon, men osi nou te <note caller="+" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="PHP 4:14">Fil 4:14</ref></char></note>pataje soufrans ak sila ki te maltrete konsa yo. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Paske nou te montre konpasyon pou prizonye yo e te aksepte l <note caller="+" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="MAT 5:12">Mat 5:12</ref></char></note>avèk jwa lè yo te sezi byen nou yo, nan konnen ke nou te gen yon pi bon posesyon k ap dire nèt.<verse eid="HEB 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35" />Konsa, pa jete <note caller="+" style="x"><char style="xo" closed="false">10:35 </char><char style="xt" closed="false"><ref loc="HEB 10:19">Eb 10:19</ref></char></note>konfyans nou an, ki gen yon gran rekonpans. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Paske nou oblije <note caller="+" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="LUK 21:19">Luc 21:19</ref></char></note>andire, pou lè nou fin fè volonte Bondye, nou kab <note caller="+" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="HEB 9:15">Eb 9:15</ref></char></note>resevwa sa ki te pwomèt a nou an.<verse eid="HEB 10:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:37 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 2:3">Eb 2:3</ref>
      </char>
    </note>“Paske nan yon tan ki kout,</para>
  <para style="q1" vid="HEB 10:37">Sila ki ap vini an, va vini, e li p ap fè reta.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:38 </char>
      <char style="xt" closed="false">
        <ref loc="HAB 2:4">Hab 2:4</ref>
      </char>
    </note>Men moun ladwati pa M nan, va viv pa lafwa;</para>
  <para style="q1" vid="HEB 10:38">e si li fè bak, nanm Mwen p ap gen plezi nan li.”<verse eid="HEB 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39" />Men nou pa pami sila ki fè bak pou vin detwi yo, men sila ki gen lafwa pou prezève nanm la.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Alò, lafwa se <note caller="+" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="HEB 3:14">Eb 3:14</ref></char></note>asirans a sa ke n ap espere ak konviksyon de bagay nou pa wè yo.<verse eid="HEB 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 11:2" />Paske se pa lafwa, moun nan tan ansyen yo te <note caller="+" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="HEB 11:4">Eb 11:4</ref>,<ref loc="HEB 11:39">39</ref></char></note>vin apwouve.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Pa lafwa nou konprann ke <note caller="+" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="JHN 1:3">Jn 1:3</ref></char></note>mond yo te prepare pa pawòl Bondye a, pouke sa nou wè pa t fèt avèk bagay ki vizib.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Pa lafwa <note caller="+" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="GEN 4:4">Jen 4:4</ref></char></note>Abel te ofri a Bondye yon pi bon sakrifis ke Cain, selon sa, li te resevwa temwayaj ke li te jis. Bondye te fè temwayaj de ofrann li yo, epi pa lafwa, malgre ke li mouri, li toujou pale.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Pa lafwa <note caller="+" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="GEN 5:21-24">Jen 5:21-24</ref></char></note>Enoch te monte pou l te kab pa wè lanmò. E kò li pa te jwenn akoz ke Bondye te pran l. Paske li te twouve temwen ke avan li te monte a, li t ap fè Bondye plezi.<verse eid="HEB 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 11:6" />Konsa, san lafwa, li enposib pou fè Li plezi, paske sila ki <note caller="+" style="x"><char style="xo" closed="false">11:6 </char><char style="xt" closed="false"><ref loc="HEB 7:19">Eb 7:19</ref></char></note>vin kote Bondye a, dwe kwè ke Li egziste, e ke li bay rekonpans a sila ki chache L yo.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Pa lafwa <note caller="+" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 6:13-22">Jen 6:13-22</ref></char></note>Noé te avèti pa Bondye de bagay ki potko vizib yo, avèk respè, li te prepare yon lach pou sove tout lakay li. Pa sa, li te kondane mond lan, e li te devni yon eritye ladwati ki se pa lafwa.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Pa lafwa <note caller="+" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 12:1-4">Jen 12:1-4</ref></char></note>Abraham, lè l te rele, li te obeyi lè l te sòti pou ale yon kote ke li te dwe resevwa pou eritaj. Li te soti malgre li pa t menm konnen ki kote li t ap prale. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Pa lafwa, li te viv kòm yon etranje nan <note caller="+" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="ACT 7:5">Trav 7:5</ref></char></note>peyi pwomès la, tankou se nan yon peyi etranje, e li te abite nan tant avèk Isaac ak Jacob, eritye ansanm a menm pwomès la. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Paske li t ap chache <note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="HEB 12:22">Eb 12:22</ref></char></note>vil ki gen fondasyon an, ki gen kòm achitèk ak fondatè, Bondye menm.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Pa lafwa, menm <note caller="+" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="GEN 17:19">Jen 17:19</ref></char></note>Sarah te vin gen kapasite pou l ansent, menm depase pwòp tan lavi li, paske li te konsidere Li menm fidèl ki te fè pwomès la. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Akoz sa te vin fèt de yon sèl moun, e <note caller="+" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="ROM 4:19">Wo 4:19</ref></char></note>li menm, tankou yon moun mouri deja, yon kantite desandan “an chif <note caller="+" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="GEN 22:17">Jen 22:17</ref></char></note>kòm zetwal, e ki pa kab kontwole tankou grenn sab lanmè.”<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Tout sila yo te mouri nan lafwa <note caller="+" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="HEB 11:39">Eb 11:39</ref></char></note>san resevwa pwomès yo, men yo te wè yo e te rejwi de yo a yon distans, epi yo <note caller="+" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="GEN 23:4">Jen 23:4</ref></char></note>te konfese ke yo te etranje e egzile sou tè a. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Paske sila ki di bagay sa yo, fè l klè ke y ap chache yon peyi ki pou yo. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Si vrèman, yo t ap panse ak peyi sa a ke yo te soti a <note caller="+" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="GEN 24:6-8">Jen 24:6-8</ref></char></note>yo t ap twouve chans pou retounen. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Men jan sa ye a, yo pito yon pi bon peyi, yon <note caller="+" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="2TI 4:18">II Tim 4:18</ref></char></note>peyi selès. Konsa, Bondye pa t wont pou Li menm ta rele Bondye pa yo a, paske <note caller="+" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="HEB 11:10">Eb 11:10</ref></char></note>Li te prepare yon vil pou yo.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Pa lafwa <note caller="+" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="GEN 22:1-10">Jen 22:1-10</ref></char></note>Abraham, lè l te vin pase a leprèv, li te ofri Isaac; e sila ki te <note caller="+" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="HEB 11:13">Eb 11:13</ref></char></note>resevwa pwomès la, t ap ofri sèl fis li a. <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />Se te selon fis sa menm ke Li te di: <note caller="+" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">Jen 21:12</ref></char></note>“Nan Isaac, desandan ou yo va rele.”<verse eid="HEB 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 11:19" />Men li te konsidere ke <note caller="+" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="ROM 4:21">Wo 4:21</ref></char></note>Bondye kapab leve moun menm soti nan lanmò. E vreman, li te osi resevwa li (Isaac) soti nan lanmò kòm yon modèl de sila ki t ap vini an. <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />Pa lafwa <note caller="+" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="GEN 27:27-29">Jen 27:27-29</ref>,<ref loc="GEN 27:39">39</ref></char></note>Isaac te beni Jacob ak Ésaü, menm selon bagay ki t ap vini yo.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Pa lafwa <note caller="+" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="GEN 48:1">Jen 48:1</ref>,<ref loc="GEN 48:5">5</ref>,<ref loc="GEN 48:16">16</ref>,<ref loc="GEN 48:20">20</ref></char></note>Jacob, pandan li t ap mouri, li te beni tout fis Joseph yo, e li te adore pandan li t ap apiye sou tèt baton li.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Pa lafwa <note caller="+" style="x"><char style="xo" closed="false">11:22 </char><char style="xt" closed="false"><ref loc="GEN 50:24">Jen 50:24</ref></char></note>Joseph, lè l t ap mouri, te pale sou egzòd a fis Israël yo, e te pase lòd konsènan zo li yo.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Pa lafwa <note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="EXO 2:2">Egz 2:2</ref></char></note>Moïse, lè l te fèt, te kache pandan twa mwa pa paran li yo, paske yo te wè ke li te yon bèl pitit; e yo pa t pè <note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="EXO 1:16">Egz 1:16</ref>,<ref loc="EXO 1:22">22</ref></char></note>lòd wa a.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Pa lafwa, Moïse <note caller="+" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="EXO 2:10">Egz 2:10</ref>,<ref loc="EXO 2:11">11</ref></char></note>lè l te fin grandi, li te refize rele fis a fi Farawon an; <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />men li te chwazi pito <note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="HEB 11:37">Eb 11:37</ref></char></note>sipòte afliksyon avèk pèp Bondye a pase pou l ta rejwi nan plezi peche k ap pase yo. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Li te <note caller="+" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="LUK 14:33">Luc 14:33</ref></char></note>konsidere repwòch a Kris la kòm pi gran richès pase trezò an Égypte yo; paske li t ap gade rekonpans lan.<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />Pa lafwa, li te <note caller="+" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="EXO 2:15">Egz 2:15</ref></char></note>kite Égypte, san <note caller="+" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="EXO 2:14">Egz 2:14</ref></char></note>krent kòlè a wa a; paske li te kenbe fèm, kòmsi li te wè Sila ki pa vizib la. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Pa lafwa, li te <note caller="+" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="EXO 12:21">Egz 12:21</ref></char></note>fè Pak Jwif la, e li te flite san an, pou sila ki te detwi premye ne yo pa t kab touche yo. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />Pa lafwa yo te <note caller="+" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="EXO 14:22-29">Egz 14:22-29</ref></char></note>travèse Lamè Wouj, kòmsi yo t ap pase sou tè sèk. E Ejipsyen yo, lè yo te tante fè l, te vale nèt. <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />Pa lafwa <note caller="+" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JOS 6:20">Jos 6:20</ref></char></note>miray Jéricho yo te tonbe <note caller="+" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JOS 6:15">Jos 6:15</ref></char></note>apre yo te fin fè wonn yo pandan sèt jou.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />Pa lafwa <note caller="+" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="JOS 2:9">Jos 2:9</ref></char></note>Rahab fanm movèz vi a, pa t peri ansanm avèk sila ki te dezobeyisan yo, apre li te fin resevwa espyon yo an pè.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Epi kisa mwen kapab di anplis? Paske nanpwen tan pou pale de Gédéon <note caller="+" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JDG 4">Jij 4</ref>; <ref loc="JDG 5">Jij 5</ref></char></note>Barak, Samson, Jephthé, David, Samuel, ak pwofèt yo, <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />ki pa lafwa, te fè konkèt wayòm yo, te fè zèv ladwati, te <note caller="+" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="2SA 7:11">II Sam 7:11</ref></char></note>resevwa pwomès yo, e te fèmen bouch a lyon yo. <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />Yo te <note caller="+" style="x"><char style="xo" closed="false">11:34 </char><char style="xt" closed="false"><ref loc="DAN 3:23">Dan 3:23</ref></char></note>etenn pouvwa dife a, chape de lanm nepe a, nan feblès yo te vin fò, vin vanyan nan lagè, e yo te fè lame etranje yo sove ale.<verse eid="HEB 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 11:35" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:35 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 17:23">I Wa 17:23</ref>
      </char>
    </note>Fanm yo te resevwa anretou mò yo pa rezirèksyon. Lòt yo te toumante, ni pa t aksepte pou yo ta lage, paske yo te pito resevwa yon pi bon rezirèksyon. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Epi lòt nan yo te pase pay nan moke ak resevwa kout fwèt; wi, menm <note caller="+" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="GEN 39:20">Jen 39:20</ref></char></note>chenn ak prizon tou.<verse eid="HEB 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="HEB 11:37" />Yo te <note caller="+" style="x"><char style="xo" closed="false">11:37 </char><char style="xt" closed="false"><ref loc="1KI 21:13">I Wa 21:13</ref></char></note>lapide ak kout wòch, yo te siye an de bout, yo te pwovoke, e te mete a lanmò avèk nepe. Yo te ale toupatou an po mouton ak po kabrit, san mwayen, aflije, maltrete— <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />moun ke mond lan pa menm merite yo— Yo te <note caller="+" style="x"><char style="xo" closed="false">11:38 </char><char style="xt" closed="false"><ref loc="1KI 18:4">I Wa 18:4</ref>,<ref loc="1KI 18:13">13</ref></char></note>gaye kò yo nan dezè, mòn, nan kavo, ak twou nan tè yo.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Malgre, tout moun sila yo, ki te vin apwouve selon lafwa yo <note caller="+" style="x"><char style="xo" closed="false">11:39 </char><char style="xt" closed="false"><ref loc="HEB 10:36">Eb 10:36</ref></char></note>pa t resevwa sa ki te pwomèt la. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Paske Bondye te ranje yon <note caller="+" style="x"><char style="xo" closed="false">11:40 </char><char style="xt" closed="false"><ref loc="HEB 11:16">Eb 11:16</ref></char></note>pi bon pwovizyon pou nou menm <note caller="+" style="x"><char style="xo" closed="false">11:40 </char><char style="xt" closed="false"><ref loc="REV 6:11">Rev 6:11</ref></char></note>pouke apa de nou menm, yo pa ta kapab vin pafè.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Konsa, akoz ke nou gen yon si tèlman gran nwaj temwen ki antoure nou, annou osi <note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ROM 13:12">Wo 13:12</ref></char></note>mete sou kote tout anpèchman ak peche ki trè fasil vin vlope nou, e annou kouri avèk andirans kous la ki mete devan nou an, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />ak zye nou byen fikse sou Jésus <note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="HEB 2:10">Eb 2:10</ref></char></note>fondatè e nonm pafè lafwa a, ki pou lajwa ki te mete devan Li an, te <note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="PHP 2:8">Fil 2:8</ref></char></note>sipòte lakwa a, te meprize wont lan, e te vin chita sou men dwat twòn Bondye a.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />Paske <note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="REV 2:3">Rev 2:3</ref></char></note>konsidere Li menm ki te andire tèl opozisyon pa pechè yo kont Li menm, pou nou menm pa t ap vin fatige e dekouraje.<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:4 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 10:32">Eb 10:32</ref>
      </char>
    </note>Nou poko reziste jis rive <note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="PHP 2:8">Fil 2:8</ref></char></note>pou rann san nan lit nou kont peche. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Nou gen tan bliye egzòtasyon ki te adrese a nou menm kòm fis yo:</para>
  <para style="q1" vid="HEB 12:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">12:5 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:17">Job 5:17</ref>
      </char>
    </note>“Fis mwen, pa gade a la lejè disiplin Bondye a,</para>
  <para style="q1" vid="HEB 12:5">ni vin febli lè nou korije pa Li;<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:6 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:12">Pwov 3:12</ref>
      </char>
    </note>Paske sila ke Bondye renmen yo, Li disipline yo,</para>
  <para style="q1" vid="HEB 12:6">e Li fwete tout fis ke L resevwa.”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Se pou disiplin ke nou andire. <note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="DEU 8:5">Det 8:5</ref></char></note>Bondye aji avèk nou kòm fis, paske ki fis ki genyen ke papa l pa ba l disiplin? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Men si nou san disiplin <note caller="+" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="1PE 5:9">I Pi 5:9</ref></char></note>kon sila nou tout gen tan patisipe a, alò, nou se pitit ilejitim, e pa vrè fis.<verse eid="HEB 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 12:9" />Anplis ke sa, nou te gen papa sou latè pou disipline nou, e nou te respekte yo. Èske nou pa ta bokou pito vin soumèt a <note caller="+" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="NUM 16:22">Nonb 16:22</ref></char></note>Papa a tout lespri yo, e <note caller="+" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="ISA 38:16">És 38:16</ref></char></note>viv? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Paske yo te disipline nou pou yon ti tan ki, selon yo, te sanble pi bon, men Li menm, Li disipline nou pou byen nou <note caller="+" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="2PE 1:4">II Pi 1:4</ref></char></note>pou nou kapab pataje sentete Li a.<verse eid="HEB 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 12:11" />Tout disiplin, nan moman an, sanble pa bay lajwa, men tristès. Malgre a sila ki fin antrene pa li yo, li vin bay <note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="ISA 32:17">És 32:17</ref></char></note>fwi lapè ladwati a.<verse eid="HEB 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Konsa <note caller="+" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">És 35:3</ref></char></note>ranfòse men ki manke fòs ak jenou ki fèb yo, <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />epi <note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">Pwov 4:26</ref></char></note>fè chemen pye nou dwat, jis pou manm kò ki mal ranje a pa vin dejwente nèt, men pito vin geri.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:14 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 14:19">Wo 14:19</ref>
      </char>
    </note>Chèche lapè avèk tout moun, avèk sanktifikasyon. San sa a, pèsòn p ap wè Senyè a. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Fè si ke pèsòn pa manke rive nan gras Bondye a; pou okenn <note caller="+" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="DEU 29:18">Det 29:18</ref></char></note>rasin anmè pa vin monte pou fè twoub, e pa li menm, anpil moun ta vin <note caller="+" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="TIT 1:15">Tit 1:15</ref></char></note>konwonpi. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Pa kite nou gen okenn moun imoral oubyen <note caller="+" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="1TI 1:9">I Tim 1:9</ref></char></note>san Bondye tankou Esaü <note caller="+" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="GEN 25:33">Jen 25:33</ref></char></note>ki te vann pwòp dwa eritaj li a pou yon sèl repa manje. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Paske nou konnen ke menm apre sa, <note caller="+" style="x"><char style="xo" closed="false">12:17 </char><char style="xt" closed="false"><ref loc="GEN 27:30-40">Jen 27:30-40</ref></char></note>lè li te dezire vin eritye yon benediksyon, li te rejte, paske li pa t twouve yon plas pou repantans, malgre li te chache sa ak dlo nan zye.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Paske nou pa t vin kote <note caller="+" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="EXO 19:12">Egz 19:12</ref>,<ref loc="EXO 19:16">16</ref></char></note>yon mòn ki kapab touche e ki t ap flanbe, ni a tenèb, fènwa, ak tanpèt <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />ni a <note caller="+" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="MAT 24:31">Mat 24:31</ref></char></note>gwo kout twonpèt ak son pawòl ki sone tankou sila ki te tande l t ap <note caller="+" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="EXO 20:19">Egz 20:19</ref></char></note>mande sekou a, pou okenn pawòl pa t pale a yo menm ankò. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Paske yo pa t kapab sipòte dekrè lan: <note caller="+" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="EXO 19:12">Egz 19:12</ref></char></note>“Menm si yon bèt touche mòn nan, li va lapide ak kout wòch.” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Vizyon sila a te si tèlman tèrib ke Moïse te di: <note caller="+" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">Det 9:19</ref></char></note>“Mwen plen lakrent ak tranbleman”.<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Men <note caller="+" style="x"><char style="xo" closed="false">12:22 </char><char style="xt" closed="false"><ref loc="REV 14:1">Rev 14:1</ref></char></note>nou menm, nou te vini sou Mòn Sion ak <note caller="+" style="x"><char style="xo" closed="false">12:22 </char><char style="xt" closed="false"><ref loc="HEB 11:10">Eb 11:10</ref></char></note>vil a Bondye vivan an, Jérusalem selès la, e avèk kantite zanj ki pa t kab menm kontwole, <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />anvè gran asanble a, ak legliz premye ne yo <note caller="+" style="x"><char style="xo" closed="false">12:23 </char><char style="xt" closed="false"><ref loc="LUK 10:20">Luc 10:20</ref></char></note>ki anrejistre nan syèl la, anvè Bondye, jij a tout moun nan, e anvè lespri a moun ladwati ki te fèt pafè yo, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />epi anvè Jésus <note caller="+" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="1TI 2:5">I Tim 2:5</ref></char></note>medyatè yon akò tounèf la, e anvè <note caller="+" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="HEB 9:19">Eb 9:19</ref></char></note>san vèse a, ki pale pi klè pase san Abel la. <verse eid="HEB 12:24" /><verse number="25" style="v" sid="HEB 12:25" />Fè si ke nou pa refize Sila k ap pale a. Paske si sa yo pa t chape lè yo te refize li menm ki te <note caller="+" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="EXO 20:22">Egz 20:22</ref></char></note>avèti yo sou latè a, konbyen mwens nou va chape nou menm ki vire kite Sila ki avèti nou depi nan syèl la. <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Epi vwa Li te souke tè a nan moman an, men koulye a, Li fè yon pwomès, e Li di: <note caller="+" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">Ag 2:6</ref></char></note>“Malgre sa, yon fwa ankò Mwen va souke, non sèlman tè a, men osi syèl la.”<verse eid="HEB 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 12:27" />Ekspresyon sa a: “Malgre yon fwa ankò”, fè nou konprann ke tout bagay ki te kreye, ki kapab souke <note caller="+" style="x"><char style="xo" closed="false">12:27 </char><char style="xt" closed="false"><ref loc="ISA 34:4">És 34:4</ref></char></note>va retire, pou bagay sila ki pa kapab souke yo, kapab vin rete. <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />Konsa, akoz ke nou resevwa yon <note caller="+" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="DAN 2:44">Dan 2:44</ref></char></note>wayòm ki pa kapab souke, annou montre rekonesans, pa sila nou kapab ofri a Bondye yon sèvis akseptab, avèk reverans ak lakrent. <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />Paske <note caller="+" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">Det 4:24</ref></char></note>Bondye nou an se yon dife k ap devore.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Kite <note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="ROM 12:10">Wo 12:10</ref></char></note>lanmou pou frè yo kontinye.<verse eid="HEB 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 13:2" />Pa neglije byen resevwa etranje yo, paske pa fason sa a, kèk nan nou <note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="GEN 18:1">Jen 18:1</ref></char></note>bay lojman menm a zanj, san nou pa konnen.<verse eid="HEB 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 13:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:3 </char>
      <char style="xt" closed="false">
        <ref loc="COL 4:18">Kol 4:18</ref>
      </char>
    </note>Sonje prizonye yo, kòmsi nou ta nan prizon avèk yo, e sila ki maltrete yo, akoz ke nou menm, nou osi nan kò a.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Maryaj dwe kenbe ak gwo respè pami tout moun, e kabann maryaj la dwe rete san souye; <note caller="+" style="x"><char style="xo" closed="false">13:4 </char><char style="xt" closed="false"><ref loc="1CO 6:9">I Kor 6:9</ref></char></note>paske Bondye ap jije fònikatè ak adiltè yo.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />Fè si ke karaktè nou lib de lanmou lajan, e nou rete kontan avèk sa ke nou genyen, paske Li menm te di: <note caller="+" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">Det 31:6</ref>,<ref loc="DEU 31:8">8</ref></char></note>“Mwen p ap janm kite nou, ni abandone nou,” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />pou nou di avèk konfyans:</para>
  <para style="q1" vid="HEB 13:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">13:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:6">Sòm 118:6</ref>
      </char>
    </note>“Senyè a se soutyen mwen.</para>
  <para style="q1" vid="HEB 13:6">Mwen p ap pè.</para>
  <para style="q1" vid="HEB 13:6">Sa lòm ka fè m?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Sonje <note caller="+" style="x"><char style="xo" closed="false">13:7 </char><char style="xt" closed="false"><ref loc="HEB 13:17">Eb 13:17</ref>,<ref loc="HEB 13:24">24</ref></char></note>sila ki te dirije nou yo, ki te pale pawòl Bondye ak nou. Konsidere rezilta a zèv pa yo, e imite lafwa yo.<verse eid="HEB 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 13:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:8 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 8:12">Eb 8:12</ref>
      </char>
    </note>Jésus Kri se menm lan ayè, jodi a, e pou tout tan.<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:9 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:14">Ef 4:14</ref>
      </char>
    </note>Pa vin pote ale pa doktrin varye e dwòl, paske li bon pou kè a ranfòse pa lagras, men pa ak kalite manje <note caller="+" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="HEB 9:10">Eb 9:10</ref></char></note>ki pa t bay benefis a sila ki te swiv yo.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />Nou gen yon lotèl <note caller="+" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="1CO 10:18">I Kor 10:18</ref></char></note>kote sila ki fè sèvis nan tabènak yo pa gen dwa manje. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Paske <note caller="+" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="EXO 29:14">Egz 29:14</ref></char></note>kò a bèt sila yo ki gen san yo, ke Wo Prèt la pote nan lye sen an kòm yon ofrann pou peche yo, dwe brile deyò kan an. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Menm jan an, Jésus osi, pou Li te kapab sanktifye pèp la <note caller="+" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="HEB 9:12">Eb 9:12</ref></char></note>ak pwòp san Li, te soufri deyò pòtay la. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Donk, annou ale jwenn Li deyò kan an <note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="LUK 9:23">Luc 9:23</ref></char></note>pou pote repwòch Li yo.<verse eid="HEB 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 13:14" />Paske isit la, nou pa gen yon vil k ap dire, men n ap chache vil ki gen pou vini an.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />Alò, atravè Li menm, annou ofri yon sakrifis lwanj pou Bondye san rete, ki se <note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ISA 57:19">És 57:19</ref></char></note>fwi a lèv ki bay remèsiman a non Li yo.<verse eid="HEB 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 13:16" />Epi pa neglije fè sa ki bon e <note caller="+" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="ROM 12:13">Wo 12:13</ref></char></note>pataje youn avèk lòt. Paske <note caller="+" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="PHP 4:18">Fil 4:18</ref></char></note>nan sakrifis konsa yo, Bondye pran plezi.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Obeyi lidè nou yo e soumèt nou a yo. Paske <note caller="+" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="EZK 3:17">Éz 3:17</ref></char></note>yo kontinye ap gade sou nanm nou, kòm sila ki oblije rann kont. Kite yo fè sa avèk jwa, olye chagren, paske sa pa t ap gen pwofi pou nou. <verse eid="HEB 13:17" /><verse number="18" style="v" sid="HEB 13:18" />Priye pou nou, paske nou asire ke nou gen yon <note caller="+" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="ACT 24:16">Trav 24:16</ref></char></note>bon konsyans, nan dezire kondwi tèt nou avèk lonè nan tout bagay. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Mwen ankouraje nou menm plis pou fè sa <note caller="+" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="PHM 1:22">Phm 22</ref></char></note>pou mwen kapab vin restore a nou menm pi vit menm.<verse eid="HEB 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Koulye a, ke <note caller="+" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="ROM 15:33">Wo 15:33</ref></char></note>Bondye lapè a, ki te fè leve nan lanmò a <note caller="+" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="JHN 10:11">Jn 10:11</ref></char></note>gran Pastè a brebi yo pa san akò etènèl la, menm Jésus, Senyè nou an, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" /><note caller="+" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="1PE 5:10">I Pi 5:10</ref></char></note>ekipe nou nan tout bon zèv, pou <note caller="+" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="PHP 2:13">Fil 2:13</ref></char></note>fè volonte Li, nan travay nan nou sa k ap fè plezi devan zye Li, nan Jésus Kri, a Li menm, laglwa pou tout tan e pou tout tan. Amen.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Men mwen ankouraje nou <note caller="+" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="HEB 3:1">Eb 3:1</ref></char></note>frè m yo, pou sipòte <note caller="+" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="1PE 5:12">I Pi 5:12</ref></char></note>pawòl egzòtasyon sila a, paske mwen ekri nou brèvman. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Byen aprann ke <note caller="+" style="x"><char style="xo" closed="false">13:23 </char><char style="xt" closed="false"><ref loc="ACT 16:1">Trav 16:1</ref></char></note>frè nou Timothée lage, e mwen va wè nou avèk li menm, si li vini vit. <verse eid="HEB 13:23" /><verse number="24" style="v" sid="HEB 13:24" />Salye <note caller="+" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="1CO 16:16">I Kor 16:16</ref></char></note>tout lidè nou yo ak tout sen yo. Sila an Italie yo salye nou. <verse eid="HEB 13:24" /><verse number="25" style="v" sid="HEB 13:25" />Ke lagras rete avèk nou tout.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>