<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id" />
  <para style="h">Lamantasyon Yo</para>
  <para style="toc1">LAMANTASYON YO</para>
  <para style="toc2">Lamantasyon Yo</para>
  <para style="toc3">Lam</para>
  <para style="mt1">LAMANTASYON YO</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="LAM 1:1" />A la sèl,</para>
  <para style="q1" vid="LAM 1:1">vil ki te konn <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ISA 22:2">És 22:2</ref></char></note>plen moun nan chita sèl!</para>
  <para style="q1" vid="LAM 1:1">Li vin tankou yon vèv</para>
  <para style="q1" vid="LAM 1:1">ki te konn byen pwisan pami nasyon yo!</para>
  <para style="q1" vid="LAM 1:1">Sila ki te konn yon fanm</para>
  <para style="q1" vid="LAM 1:1">byen gran pami nasyon yo!</para>
  <para style="q1" vid="LAM 1:1">Li menm ki te yon prensès pami pwovens yo,</para>
  <para style="q1" vid="LAM 1:1">Koulye a, se travo fòse li oblije fè!<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />Li kriye byen anmè nan nwit lan.</para>
  <para style="q1" vid="LAM 1:2">Dlo zye li kouri desann figi l.</para>
  <para style="q1" vid="LAM 1:2">Pami tout sila ki te renmen l yo,</para>
  <para style="q1" vid="LAM 1:2">nanpwen moun ki pou bay li rekonfò.</para>
  <para style="q1" vid="LAM 1:2">Tout zanmi li yo fè l trèt;</para>
  <para style="q1" vid="LAM 1:2">yo te tounen lènmi l.<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:3 </char>
      <char style="xt" closed="false">
        <ref loc="JER 13:19">Jr 13:19</ref>
      </char>
    </note>Juda antre an egzil anba gwo opresyon;</para>
  <para style="q1" vid="LAM 1:3">anba esklavaj byen di.</para>
  <para style="q1" vid="LAM 1:3">Li demere pami nasyon yo;</para>
  <para style="q1" vid="LAM 1:3">pou repo, nanpwen.</para>
  <para style="q1" vid="LAM 1:3">Tout sila k ap pesekite l yo,</para>
  <para style="q1" vid="LAM 1:3">fin sezi li nan mitan gwo twoub li.<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:4 </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:8-13">Jl 1:8-13</ref>
      </char>
    </note>Chemen Sion yo ap fè dèy;</para>
  <para style="q1" vid="LAM 1:4">pèsòn pa rive nan fèt li yo.</para>
  <para style="q1" vid="LAM 1:4">Tout pòtay li yo vin dezole.</para>
  <para style="q1" vid="LAM 1:4">Prèt li yo ap plenn nan gòj,</para>
  <para style="q1" vid="LAM 1:4">vyèj li yo vin aflije,</para>
  <para style="q1" vid="LAM 1:4">e li menm, li vin anmè.<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />Advèsè li yo te vin mèt li.</para>
  <para style="q1" vid="LAM 1:5">Lènmi li yo ap byen reyisi;</para>
  <para style="q1" vid="LAM 1:5">paske SENYÈ a te <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="PSA 90:7-8">Sòm 90:7-8</ref></char></note>koze doulè l,</para>
  <para style="q1" vid="LAM 1:5">akoz gwo kantite transgresyon li yo.</para>
  <para style="q1" vid="LAM 1:5">Pitit li yo se prizonye devan advèsè yo.<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />Tout <note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="JER 13:18">Jr 13:18</ref></char></note>majeste fin kite fi a Sion an.</para>
  <para style="q1" vid="LAM 1:6">Prens li yo vin tankou sèf ki pa t jwenn patiraj.</para>
  <para style="q1" vid="LAM 1:6">Yo sove ale san rezistans</para>
  <para style="q1" vid="LAM 1:6">devan mèt lachas la.<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />Jérusalem sonje tout bagay presye li yo <note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JER 37:7-10">Jr 37:7-10</ref></char></note>nan jou afliksyon li.</para>
  <para style="q1" vid="LAM 1:7">Tout bèl bagay ki te la depi nan jou ansyen yo;</para>
  <para style="q1" vid="LAM 1:7">lè pèp li a te tonbe nan men a advèsè a,</para>
  <para style="q1" vid="LAM 1:7">e pat gen okenn ki pou ede l.</para>
  <para style="q1" vid="LAM 1:7">Advèsè yo te wè l.</para>
  <para style="q1" vid="LAM 1:7">Yo te giyonnen l akoz tristes li.<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />Jérusalem te <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="ISA 59:2-13">És 59:2-13</ref></char></note>fè gwo peche.</para>
  <para style="q1" vid="LAM 1:8">Konsa, li te vin yon bagay ki pa pwòp.</para>
  <para style="q1" vid="LAM 1:8">Tout sila ki te konn louwe l yo,</para>
  <para style="q1" vid="LAM 1:8">meprize l akoz yo te wè li toutouni.</para>
  <para style="q1" vid="LAM 1:8">Menm li menm plenn nan gòj, e vire an ayè.<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />Depi nan jip li, salte a te la.</para>
  <para style="q1" vid="LAM 1:9">Li pa t konsidere davni li.</para>
  <para style="q1" vid="LAM 1:9">Akoz sa li te vin tonbe yon fason etonan.</para>
  <para style="q1" vid="LAM 1:9">Napwan moun pou konsole l.</para>
  <para style="q1" vid="LAM 1:9">“Gade, O SENYÈ, afliksyon mwen an;</para>
  <para style="q1" vid="LAM 1:9">paske ènmi an vante tèt.</para>
  <para style="q1" vid="LAM 1:9">Li vin ògeye!”<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />Advèsè a te lonje men l sou tout bagay</para>
  <para style="q1" vid="LAM 1:10">presye fi a te genyen;</para>
  <para style="q1" vid="LAM 1:10">li te wè ènmi yo antre nan sanktyè li a;</para>
  <para style="q1" vid="LAM 1:10">sila ke Ou menm te kòmande pou yo</para>
  <para style="q1" vid="LAM 1:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:10 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 23:3">Det 23:3</ref>
      </char>
    </note>pa antre nan asanble Ou a.<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />Tout pèp li a plenn nan gòj.</para>
  <para style="q1" vid="LAM 1:11">Yap <note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="JER 38:9">Jr 38:9</ref></char></note>chache pen.</para>
  <para style="q1" vid="LAM 1:11">Tout sa ak valè deja vèse bay pou manje,</para>
  <para style="q1" vid="LAM 1:11">pou kenbe nanm yo vivan an.</para>
  <para style="q1" vid="LAM 1:11">“Gade, O SENYÈ, paske mwen vin meprize.”<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />Èske sa pa anyen pou nou tout ki pase nan wout sa a?</para>
  <para style="q1" vid="LAM 1:12">Gade pou wè si genyen yon doulè ki tankou doulè mwen an,</para>
  <para style="q1" vid="LAM 1:12">doulè ki te pase vin nan men m nan,</para>
  <para style="q1" vid="LAM 1:12">avèk sila <note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="JER 30:23-24">Jr 30:23-24</ref></char></note>SENYÈ a te aflije m nan jou a gran kòlè Li a.<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />Soti anwo, Li te voye dife antre nan <note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="JOB 30:30">Job 30:30</ref></char></note>zo m,</para>
  <para style="q1" vid="LAM 1:13">e lap dominen yo.</para>
  <para style="q1" vid="LAM 1:13">Li te ouvri yon pèlen pou pye m;</para>
  <para style="q1" vid="LAM 1:13">Li te fè m vire fè bak.</para>
  <para style="q1" vid="LAM 1:13">Li te fè m vin dezole, fèb tout lajounen.<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />Jouk transgresyon mwen yo vin mare;</para>
  <para style="q1" vid="LAM 1:14">ak men Li yo koude nèt ansanm.</para>
  <para style="q1" vid="LAM 1:14">Yo te rive jis nan kou m;</para>
  <para style="q1" vid="LAM 1:14">Li te fè fòs mwen vin kraze disparèt.</para>
  <para style="q1" vid="LAM 1:14">Senyè a te <note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="JER 32:3-5">Jr 32:3-5</ref></char></note>livre m nan men a sila yo;</para>
  <para style="q1" vid="LAM 1:14">kont yo, mwen pa ka kanpe.<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />Senyè a te rejte tout mesye pwisan ki nan mitan m yo.</para>
  <para style="q1" vid="LAM 1:15">Li te rele yon asanble solanèl kont mwen pou kraze <note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="JER 6:11">Jr 6:11</ref></char></note>jennonm mwen yo.</para>
  <para style="q1" vid="LAM 1:15">Senyè a te foule, konsi se nan yon pèz rezen, fi vyèj a Juda a.<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />Pou bagay sa yo, mwen ap kriye.</para>
  <para style="q1" vid="LAM 1:16">Zye m koule ak dlo.</para>
  <para style="q1" vid="LAM 1:16">Konsolatè kap refreshi nanm mwen lwen m,</para>
  <para style="q1" vid="LAM 1:16">Nanpwen <note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="PSA 69:20">Sòm 69:20</ref></char></note>okenn ki ta ka konsole mwen,</para>
  <para style="q1" vid="LAM 1:16">okenn ki ta ka restore nanm mwen.</para>
  <para style="q1" vid="LAM 1:16">Pitit mwen yo vin dezole akoz ènmi an te vin genyen.<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />Sion lonje men l ouvri nèt.</para>
  <para style="q1" vid="LAM 1:17">Nanpwen ki pou konsole l.</para>
  <para style="q1" vid="LAM 1:17">SENYÈ a te bay lòd konsènan Jacob,</para>
  <para style="q1" vid="LAM 1:17">ke sila ki antoure l yo ta lènmi avè l.</para>
  <para style="q1" vid="LAM 1:17">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:17 </char>
      <char style="xt" closed="false">
        <ref loc="LAM 1:8">Lam 1:8</ref>
      </char>
    </note>Jérusalem te devni yon bagay pa pwòp pami yo.<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />SENYÈ a jis;</para>
  <para style="q1" vid="LAM 1:18">paske mwen te <note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="1SA 12:14-15">I Sam 12:14-15</ref></char></note>fè rebèl kont lòd Li.</para>
  <para style="q1" vid="LAM 1:18">Tande koulye a, tout pèp yo</para>
  <para style="q1" vid="LAM 1:18">e gade byen doulè m nan.</para>
  <para style="q1" vid="LAM 1:18">Vyèj mwen yo ak jennonm mwen yo</para>
  <para style="q1" vid="LAM 1:18">te antre an kaptivite.<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19" />Mwen te rele vè renmen mwen yo,</para>
  <para style="q1" vid="LAM 1:19">men yo te fè m desi.</para>
  <para style="q1" vid="LAM 1:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:19 </char>
      <char style="xt" closed="false">
        <ref loc="JER 14:15">Jr 14:15</ref>
      </char>
    </note>Prèt mwen yo ak ansyen mwen yo te peri nan vil la</para>
  <para style="q1" vid="LAM 1:19">pandan yo t ap chache manje</para>
  <para style="q1" vid="LAM 1:19">pou restore fòs yo pou kont yo.<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />Gade, O SENYÈ, paske mwen nan gwo twoub.</para>
  <para style="q1" vid="LAM 1:20">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:20 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 16:11">És 16:11</ref>
      </char>
    </note>Lespri m twouble anpil;</para>
  <para style="q1" vid="LAM 1:20">kè m boulvèse anndan m,</para>
  <para style="q1" vid="LAM 1:20">paske mwen te fè rebèl anpil.</para>
  <para style="q1" vid="LAM 1:20">Nan lari, se nepe k ap touye;</para>
  <para style="q1" vid="LAM 1:20">nan kay, se tankou lanmò.<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />Yo te tande ke m ap plenyen nan gòj;</para>
  <para style="q1" vid="LAM 1:21">men nanpwen ki pou konsole m.</para>
  <para style="q1" vid="LAM 1:21">Tout lènmi mwen yo tande afè gwo malè m nan.</para>
  <para style="q1" vid="LAM 1:21">Yo <note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="PSA 35:15">Sòm 35:15</ref></char></note>kontan Ou te fè sa.</para>
  <para style="q1" vid="LAM 1:21">O ke Ou ta mennen jou ke Ou te pwoklame a,</para>
  <para style="q1" vid="LAM 1:21">pou yo ka vin tankou mwen.<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />Kite tout mechanste yo vini devan Ou.</para>
  <para style="q1" vid="LAM 1:22">Konsa, <note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="NEH 4:4">Né 4:4</ref></char></note>aji avèk yo kon Ou te aji avè m nan,</para>
  <para style="q1" vid="LAM 1:22">pou tout transgresyon mwen yo.</para>
  <para style="q1" vid="LAM 1:22">Paske plent k ap sòti anndan m yo anpil</para>
  <para style="q1" vid="LAM 1:22">e kè m vin fèb nèt.<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="p">
    <verse number="1" style="v" sid="LAM 2:1" />Gade kijan Senyè a te kouvri fi a Sion an</para>
  <para style="q1" vid="LAM 2:1">ak yon nwaj nan kòlè li!</para>
  <para style="q1" vid="LAM 2:1">Li te <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="ISA 14:12-15">És 14:12-15</ref></char></note>jete soti nan syèl la, jis rive atè glwa Israël la.</para>
  <para style="q1" vid="LAM 2:1">Li pa t menm sonje machpye pa L la, nan jou kòlè Li.<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />Senyè a te vale tout nèt.</para>
  <para style="q1" vid="LAM 2:2">Li pa t epanye tout abitasyon Jacob yo.</para>
  <para style="q1" vid="LAM 2:2">Nan gwo chalè Li, Li te jete sitadèl fi a Juda a.</para>
  <para style="q1" vid="LAM 2:2">Li te <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="ISA 25:12">És 25:12</ref></char></note>bese yo nèt jis rive atè.</para>
  <para style="q1" vid="LAM 2:2">Li te pwofane wayòm nan ak tout prens li yo.<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />Nan gwo chalè, Li te koupe tout fòs Israël la.</para>
  <para style="q1" vid="LAM 2:3">Li te retire men dwat Li soti devan lènmi an.</para>
  <para style="q1" vid="LAM 2:3">Konsa, Li te <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ISA 42:25">És 42:25</ref></char></note>brile Jacob tankou flanm dife</para>
  <para style="q1" vid="LAM 2:3">ki konsome toupatou.<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />Li te koube <note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="JOB 6:4">Job 6:4</ref></char></note>banza Li kon yon lènmi.</para>
  <para style="q1" vid="LAM 2:4">Li te poze men dwat li konsi se yon advèsè.</para>
  <para style="q1" vid="LAM 2:4">Konsa, Li te touye tout ki bèl pou gade.</para>
  <para style="q1" vid="LAM 2:4">Nan tant a fi a Sion an,</para>
  <para style="q1" vid="LAM 2:4">Li te vin vide gwo kòlè Li tankou dife.<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />Senyè a vin tankou yon <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="JER 30:14">Jr 30:14</ref></char></note>lènmi.</para>
  <para style="q1" vid="LAM 2:5">Li te vale Israël nèt.</para>
  <para style="q1" vid="LAM 2:5">Li te vale tout palè li yo.</para>
  <para style="q1" vid="LAM 2:5">Li te detwi sitadèl li yo.</para>
  <para style="q1" vid="LAM 2:5">Li te miltipliye doulè yo ak plent yo</para>
  <para style="q1" vid="LAM 2:5">nan fi a Juda yo.<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />Ak vyolans, Li te aji sou tanp Li an,</para>
  <para style="q1" vid="LAM 2:6">konsi se yon tonèl jaden.</para>
  <para style="q1" vid="LAM 2:6">Li te <note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="JER 52:13">Jr 52:13</ref></char></note>detwi kote ke Li menm te deziye</para>
  <para style="q1" vid="LAM 2:6">pou asanble yo.</para>
  <para style="q1" vid="LAM 2:6">SENYÈ a te fè bliye tout jou fèt ak Saba Sion yo,</para>
  <para style="q1" vid="LAM 2:6">e Li te meprize ni wa a, ni prèt la</para>
  <para style="q1" vid="LAM 2:6">nan gwo kòlè Li a.<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />Senyè a te rejte lotèl Li a.</para>
  <para style="q1" vid="LAM 2:7">Li te abandone sanktyè Li a.</para>
  <para style="q1" vid="LAM 2:7">Li te <note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="JER 33:4-5">Jr 33:4-5</ref></char></note>livre nan men lènmi an, miray a palè li yo.</para>
  <para style="q1" vid="LAM 2:7">Yo te fè yon bri nan kay SENYÈ a, konsi</para>
  <para style="q1" vid="LAM 2:7">li ta nan yon jou fèt deziye.<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />SENYÈ a te pran desizyon pou detwi miray a fi a Sion an.</para>
  <para style="q1" vid="LAM 2:8">Li te <note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="2KI 21:13">II Wa 21:13</ref></char></note>lonje yon lign.</para>
  <para style="q1" vid="LAM 2:8">Li pa t ralanti men l nan destriksyon.</para>
  <para style="q1" vid="LAM 2:8">Li te fè ni ranpa, ni miray la plen tristès;</para>
  <para style="q1" vid="LAM 2:8">y ap kriye ansanm.<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:9 </char>
      <char style="xt" closed="false">
        <ref loc="NEH 1:3">Né 1:3</ref>
      </char>
    </note>Pòtay li yo te fonse antre nan tè,</para>
  <para style="q1" vid="LAM 2:9">Li te detwi e kraze fè fòje a.</para>
  <para style="q1" vid="LAM 2:9">Wa li yo ak prens li yo vin gaye pami nasyon yo;</para>
  <para style="q1" vid="LAM 2:9">lalwa, nanpwen ankò.</para>
  <para style="q1" vid="LAM 2:9">Anplis, pwofèt li yo pa resevwa vizyon de SENYÈ a.<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />Ansyen a fi a Sion yo chita atè.</para>
  <para style="q1" vid="LAM 2:10">Yo rete an silans.</para>
  <para style="q1" vid="LAM 2:10">Yo te jete <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="JOB 2:12">Job 2:12</ref></char></note>pousyè sou tèt yo.</para>
  <para style="q1" vid="LAM 2:10">Yo abiye yo ak twal sak.</para>
  <para style="q1" vid="LAM 2:10">Vyèj Jérusalem yo fin bese tèt yo jis a tè a.<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />Zye m gate akoz dlo k ap sòti ladann,</para>
  <para style="q1" vid="LAM 2:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:11 </char>
      <char style="xt" closed="false">
        <ref loc="JER 4:19">Jr 4:19</ref>
      </char>
    </note>lespri m vin nan gwo twoub;</para>
  <para style="q1" vid="LAM 2:11">kè m vin vide atè nèt, akoz</para>
  <para style="q1" vid="LAM 2:11">fi a pèp mwen an vin detwi</para>
  <para style="q1" vid="LAM 2:11">e timoun ak tibebe yo ap fennen</para>
  <para style="q1" vid="LAM 2:11">nan lari vil la.<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />Yo mande manman yo: <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="JER 5:17">Jr 5:17</ref></char></note>“Kote sereyal ak diven an?”</para>
  <para style="q1" vid="LAM 2:12">Konsa, yo fennen tankou yon nonm ki blese nan lari vil yo,</para>
  <para style="q1" vid="LAM 2:12">pandan lavi yo menm vin vide nan sen manman yo.<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />Kisa pou m ta di ou?</para>
  <para style="q1" vid="LAM 2:13">A kilès pou m ta konpare ou, O fi Jérusalem nan?</para>
  <para style="q1" vid="LAM 2:13">A kisa pou m ta di ou sanble pandan mwen</para>
  <para style="q1" vid="LAM 2:13">ap mennen rekonfò bay ou a,</para>
  <para style="q1" vid="LAM 2:13">O fi vyèj a Sion an?</para>
  <para style="q1" vid="LAM 2:13">Paske destriksyon ou an vast tankou lanmè.</para>
  <para style="q1" vid="LAM 2:13">Se kilès ki ka <note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="JER 8:22">Jr 8:22</ref></char></note>geri ou?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />Pwofèt ou yo te wè pou ou vizyon ki te fo;</para>
  <para style="q1" vid="LAM 2:14">ki te plen foli.</para>
  <para style="q1" vid="LAM 2:14">Yo pa t <note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="ISA 58:1">És 58:1</ref></char></note>dekouvri inikite ou</para>
  <para style="q1" vid="LAM 2:14">pou restore ou sòti an kaptivite,</para>
  <para style="q1" vid="LAM 2:14">men yo te wè pou ou vizyon</para>
  <para style="q1" vid="LAM 2:14">pòt pawòl ki te fo,</para>
  <para style="q1" vid="LAM 2:14">ki te egare ou.<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />Tout moun ki pase akote chemen an</para>
  <para style="q1" vid="LAM 2:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:15 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 27:23">Job 27:23</ref>
      </char>
    </note>bat men yo pou moke ou.</para>
  <para style="q1" vid="LAM 2:15">Yo sifle anlè kon koulèv</para>
  <para style="q1" vid="LAM 2:15">sou fi Jérusalem nan, epi yo di:</para>
  <para style="q1" vid="LAM 2:15">“Men èske se vil sa a yo te konn rele</para>
  <para style="q1" vid="LAM 2:15">‘pèfeksyon a bèlte a, yon jwa de tout tè a’?”<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />Tout lènmi ou yo te louvri bouch yo laj kont ou.</para>
  <para style="q1" vid="LAM 2:16">Yo sifle anlè kon koulèv.</para>
  <para style="q1" vid="LAM 2:16">Yo fwote dan yo.</para>
  <para style="q1" vid="LAM 2:16">Yo di: “Nou te <note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="PSA 56:2">Sòm 56:2</ref></char></note>vale l nèt!</para>
  <para style="q1" vid="LAM 2:16">Anverite, se jou sa ke nou t ap tann nan.</para>
  <para style="q1" vid="LAM 2:16">Nou gen tan jwenn li.</para>
  <para style="q1" vid="LAM 2:16">Nou gen tan wè l.”<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />SENYÈ a te <note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="JER 4:28">Jr 4:28</ref></char></note>acheve objektif Li;</para>
  <para style="q1" vid="LAM 2:17">Li te akonpli pawòl Li, pawòl ke Li</para>
  <para style="q1" vid="LAM 2:17">te kòmande soti nan jou ansyen yo.</para>
  <para style="q1" vid="LAM 2:17">Li te jete ba,</para>
  <para style="q1" vid="LAM 2:17">Li pat fè pitye.</para>
  <para style="q1" vid="LAM 2:17">Li te fè lènmi an rejwi sou ou.</para>
  <para style="q1" vid="LAM 2:17">Li te egzalte pwisans a advèsè ou yo.<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:18 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:145">Sòm 119:145</ref>
      </char>
    </note>Kè yo te kriye fò a Senyè a.</para>
  <para style="q1" vid="LAM 2:18">O miray a fi Sion an,</para>
  <para style="q1" vid="LAM 2:18">kite dlo sòti nan zye ou lajounen kon lannwit.</para>
  <para style="q1" vid="LAM 2:18">Pa aksepte okenn soulajman;</para>
  <para style="q1" vid="LAM 2:18">'Pa kite zye ou pran repo.<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />Leve, kriye fò nan nwit lan,</para>
  <para style="q1" vid="LAM 2:19">nan kòmansman vèy nwit lan!</para>
  <para style="q1" vid="LAM 2:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:19 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 1:15">I Sam 1:15</ref>
      </char>
    </note>Vide kè ou konsi se dlo devan prezans Senyè a.</para>
  <para style="q1" vid="LAM 2:19">Leve men ou a Li menm pou lavi pitit ou yo</para>
  <para style="q1" vid="LAM 2:19">ki fèb nèt ak grangou sou tèt a tout ri yo.<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />Gade pou wè, O SENYÈ! Avèk kilès ou te aji konsa?</para>
  <para style="q1" vid="LAM 2:20">Èske fanm ta dwe <note caller="+" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="JER 19:9">Jr 19:9</ref></char></note>manje pwòp pitit pa yo,</para>
  <para style="q1" vid="LAM 2:20">pitit yo ki te fèt an bòn sante?</para>
  <para style="q1" vid="LAM 2:20">Èske prèt la ak pwofèt la</para>
  <para style="q1" vid="LAM 2:20">dwe vin touye nan sanktyè Senyè a?<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />Sou tè nan lari yo, kouche <note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="2CH 36:17">II Kwo 36:17</ref></char></note>jenn yo ak granmoun yo.</para>
  <para style="q1" vid="LAM 2:21">Vyèj mwen yo ak jennonm mwen yo te tonbe sou nepe.</para>
  <para style="q1" vid="LAM 2:21">Ou te touye yo nan jou gwo kòlè Ou a;</para>
  <para style="q1" vid="LAM 2:21">Ou te fè masak, san pitye.<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />Ou te rele nou konsi se nan jou a yon fèt etabli,</para>
  <para style="q1" vid="LAM 2:22">gwo laperèz mwen yo tout kote.</para>
  <para style="q1" vid="LAM 2:22">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:22 </char>
      <char style="xt" closed="false">
        <ref loc="JER 11:11">Jr 11:11</ref>
      </char>
    </note>Nanpwen moun ki te chape sòti vivan</para>
  <para style="q1" vid="LAM 2:22">nan jou kòlè SENYÈ a.</para>
  <para style="q1" vid="LAM 2:22">Sila ke m te fè e leve yo,</para>
  <para style="q1" vid="LAM 2:22">lènmi m te anile yo nèt.<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />Mwen se moun ki te <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="PSA 88:7-16">Sòm 88:7-16</ref></char></note>wè afliksyon</para>
  <para style="q1" vid="LAM 3:1">akoz baton kòlè Li a.<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />Li te mennen mwen,</para>
  <para style="q1" vid="LAM 3:2">e te fè m mache nan <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="JOB 30:26">Job 30:26</ref></char></note>tenèb,</para>
  <para style="q1" vid="LAM 3:2">pa nan limyè.<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />Anverite, li te <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="PSA 38:2">Sòm 38:2</ref></char></note>vire men L kont mwen</para>
  <para style="q1" vid="LAM 3:3">plizyè fwa, tout jounen an.<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />Li te fè chè m ak po m vin epwize sòti sou mwen,</para>
  <para style="q1" vid="LAM 3:4">Li te <note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="PSA 51:8">Sòm 51:8</ref></char></note>kase zo m yo.<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />Li te <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="JOB 19:8">Job 19:8</ref></char></note>jennen mwen e te antoure m</para>
  <para style="q1" vid="LAM 3:5">ak ametim ak difikilte.<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />Nan kote ki <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="PSA 88:5-6">Sòm 88:5-6</ref></char></note>fènwa, li te fè m abite,</para>
  <para style="q1" vid="LAM 3:6">tankou sila ki fin mouri lontan yo.<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />Li te <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="JOB 3:23">Job 3:23</ref></char></note>antoure m anndan pou m pa ka sòti.</para>
  <para style="q1" vid="LAM 3:7">Li te fè chenn mwen an byen lou.<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />Menm lè m kriye e rele sekou,</para>
  <para style="q1" vid="LAM 3:8">Li <note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JOB 30:20">Job 30:20</ref></char></note>fèmen lapriyè m deyò.<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />Li te <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="ISA 63:17">És 63:17</ref></char></note>bloke wout mwen yo ak wòch taye.</para>
  <para style="q1" vid="LAM 3:9">Li te fè chemen mwen yo vin kwochi.<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />Li pou mwen tankou yon lous ki kouche ap tann,</para>
  <para style="q1" vid="LAM 3:10">tankou yon lyon nan kote an kachèt.<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />Li te detounen tout chemen mwen yo</para>
  <para style="q1" vid="LAM 3:11">e Li te <note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JOB 16:12-13">Job 16:12-13</ref></char></note>chire mwen an mòso;</para>
  <para style="q1" vid="LAM 3:11">Li te fè m vin dezole nèt.<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />Li te koube banza Li,</para>
  <para style="q1" vid="LAM 3:12">e Li te <note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="JOB 6:4">Job 6:4</ref></char></note>chwazi m kon pwen final pou flèch Li.<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />Li te fè flèch nan <note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="JER 5:16">Jr 5:16</ref></char></note>fouwo L yo</para>
  <para style="q1" vid="LAM 3:13">antre nan ren mwen.<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />Mwen te vin yon <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="PSA 22:6-7">Sòm 22:6-7</ref></char></note>rizib pou tout pèp mwen an,</para>
  <para style="q1" vid="LAM 3:14">chante giyonnen yo sonnen tout lajounen.<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />Li te <note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="JER 9:15">Jr 9:15</ref></char></note>plen mwen ak anmetim.</para>
  <para style="q1" vid="LAM 3:15">Li te fè m sou ak dlo absent.<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />Li te <note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="PSA 3:7">Sòm 3:7</ref></char></note>kase dan m ak gravye.</para>
  <para style="q1" vid="LAM 3:16">Li fè m kache nan pousyè.<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />Nanm mwen <note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="ISA 59:11">És 59:11</ref></char></note>p ap jwenn lapè ankò.</para>
  <para style="q1" vid="LAM 3:17">Bonè vin bliye pou mwen.<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />Konsa mwen di: “Fòs mwen fin peri,</para>
  <para style="q1" vid="LAM 3:18">ansanm ak <note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="JOB 17:5">Job 17:5</ref></char></note>espwa m ki sòti nan SENYÈ a.”<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />Sonje soufrans mwen ak mizè mwen an;</para>
  <para style="q1" vid="LAM 3:19">dlo absent ak anmetim ki nan kè m nan.<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />Anverite, nanm mwen sonje yo.</para>
  <para style="q1" vid="LAM 3:20">Li vin <note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 42:5-11">Sòm 42:5-11</ref></char></note>koube anndan mwen.<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />Men sa mwen sonje nan tèt mwen;</para>
  <para style="q1" vid="LAM 3:21">pou sa, mwen gen <note caller="+" style="x"><char style="xo" closed="false">3:21 </char><char style="xt" closed="false"><ref loc="PSA 130:7">Sòm 130:7</ref></char></note>espwa.<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />Lamou dous SENYÈ a, anvèrite, p ap janm sispann,</para>
  <para style="q1" vid="LAM 3:22">
    <note caller="+" style="x">
      <char style="xo" closed="false">3:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAL 3:6">Mal 3:6</ref>
      </char>
    </note>paske mizerikòd Li p ap janm manke.<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />Yo renouvle chak maten.</para>
  <para style="q1" vid="LAM 3:23">Gran se <note caller="+" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="HEB 10:23">Eb 10:23</ref></char></note>fidelite Ou.<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />“SENYÈ a se <note caller="+" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="PSA 16:5">Sòm 16:5</ref></char></note>pòsyon mwen.”</para>
  <para style="q1" vid="LAM 3:24">Se sa nanm mwen di m.</para>
  <para style="q1" vid="LAM 3:24">Konsa, mwen mete espwa m nan Li.<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />SENYÈ a montre dousè Li a sila ki <note caller="+" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="PSA 27:14">Sòm 27:14</ref></char></note>tann Li yo,</para>
  <para style="q1" vid="LAM 3:25">a moun ki chache Li a.<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />Se bon pou yon nonm gen espwa,</para>
  <para style="q1" vid="LAM 3:26">e <note caller="+" style="x"><char style="xo" closed="false">3:26 </char><char style="xt" closed="false"><ref loc="PSA 37:7">Sòm 37:7</ref></char></note>tann byen trankil pou sali SENYÈ a.<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />Se bon pou yon nonm pote jouk la nan jenès li.<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />Kite li <note caller="+" style="x"><char style="xo" closed="false">3:28 </char><char style="xt" closed="false"><ref loc="JER 15:7">Jr 15:7</ref></char></note>chita apa pou kont li, e rete an silans,</para>
  <para style="q1" vid="LAM 3:28">akoz Li te poze sa sou li.<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />Kite li mete bouch li nan pousyè,</para>
  <para style="q1" vid="LAM 3:29">si se konsa, pou l ka gen <note caller="+" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="JER 31:17">Jr 31:17</ref></char></note>espwa.<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />Kite li lonje <note caller="+" style="x"><char style="xo" closed="false">3:30 </char><char style="xt" closed="false"><ref loc="JOB 16:10">Job 16:10</ref></char></note>machwè li, bay sila k ap frape l la.</para>
  <para style="q1" vid="LAM 3:30">Kite li ranpli ak repwòch.<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />Paske se pa pou tout tan ke Senyè a ap <note caller="+" style="x"><char style="xo" closed="false">3:31 </char><char style="xt" closed="false"><ref loc="PSA 77:7">Sòm 77:7</ref></char></note>rejte.<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />Paske malgre se gwo doulè ke Li fè rive;</para>
  <para style="q1" vid="LAM 3:32">alò, Li va gen <note caller="+" style="x"><char style="xo" closed="false">3:32 </char><char style="xt" closed="false"><ref loc="PSA 78:38">Sòm 78:38</ref></char></note>mizerikòd selon gran lanmou dous Li a.<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />Paske <note caller="+" style="x"><char style="xo" closed="false">3:33 </char><char style="xt" closed="false"><ref loc="PSA 119:67-75">Sòm 119:67-75</ref></char></note>se pa ak kè kontan ke Li aflije,</para>
  <para style="q1" vid="LAM 3:33">oswa pou atriste fis a lòm yo.<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />Pou kraze anba pye, tout prizonye nan mond la,<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />pou retire <note caller="+" style="x"><char style="xo" closed="false">3:35 </char><char style="xt" closed="false"><ref loc="PSA 140:12">Sòm 140:12</ref></char></note>jistis sou yon nonm nan prezans a Pi Wo a,<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />pou <note caller="+" style="x"><char style="xo" closed="false">3:36 </char><char style="xt" closed="false"><ref loc="JER 22:3">Jr 22:3</ref></char></note>fè yon nonm tò nan pwosè legal pa li,</para>
  <para style="q1" vid="LAM 3:36">sou bagay sa yo, Senyè a p ap dakò.<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />Se kilès li ye ki pale, e <note caller="+" style="x"><char style="xo" closed="false">3:37 </char><char style="xt" closed="false"><ref loc="PSA 33:9-11">Sòm 33:9-11</ref></char></note>sa vin rive,</para>
  <para style="q1" vid="LAM 3:37">amwenske Senyè a te pase lòd la?<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />Èske <note caller="+" style="x"><char style="xo" closed="false">3:38 </char><char style="xt" closed="false"><ref loc="JOB 2:10">Job 2:10</ref></char></note>sa ki bon ak sa ki mal</para>
  <para style="q1" vid="LAM 3:38">pa soti nan bouch a Pi Wo a?<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />Poukisa yon nonm vivan dwe plenyen,</para>
  <para style="q1" vid="LAM 3:39">yon nonm<note caller="+" style="x"><char style="xo" closed="false">3:39 </char><char style="xt" closed="false"><ref loc="JER 30:15">Jr 30:15</ref></char></note>ta plenyen lè l resevwa pinisyon pou pwòp peche l yo?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />Annou <note caller="+" style="x"><char style="xo" closed="false">3:40 </char><char style="xt" closed="false"><ref loc="PSA 119:59">Sòm 119:59</ref></char></note>egzamine e sonde wout nou yo</para>
  <para style="q1" vid="LAM 3:40">pou nou retounen kote SENYÈ a.<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />Annou <note caller="+" style="x"><char style="xo" closed="false">3:41 </char><char style="xt" closed="false"><ref loc="PSA 25:1">Sòm 25:1</ref></char></note>leve kè nou ak men nou vè Bondye nan syèl la;<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />Nou te <note caller="+" style="x"><char style="xo" closed="false">3:42 </char><char style="xt" closed="false"><ref loc="NEH 9:26">Né 9:26</ref></char></note>peche e nou te fè rebèl;</para>
  <para style="q1" vid="LAM 3:42">Ou pa t padone.<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />Ou te kouvri nou ak <note caller="+" style="x"><char style="xo" closed="false">3:43 </char><char style="xt" closed="false"><ref loc="LAM 2:2-21">Lam 2:2-21</ref></char></note>kòlè e te kouri dèyè nou.</para>
  <para style="q1" vid="LAM 3:43">Ou te touye.</para>
  <para style="q1" vid="LAM 3:43">Ou pa t gen pitye menm.<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />Ou te <note caller="+" style="x"><char style="xo" closed="false">3:44 </char><char style="xt" closed="false"><ref loc="LAM 3:8">Lam 3:8</ref></char></note>kouvri tèt Ou ak yon nwaj lakolè,</para>
  <para style="q1" vid="LAM 3:44">pou okenn lapriyè pa ka pase ladann.<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />Ou fè nou kon <note caller="+" style="x"><char style="xo" closed="false">3:45 </char><char style="xt" closed="false"><ref loc="1CO 4:13">I Kor 4:13</ref></char></note>poupou bèt ak fatra</para>
  <para style="q1" vid="LAM 3:45">ki rejte nan mitan lòt nasyon yo.<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />Tout lènmi nou yo te <note caller="+" style="x"><char style="xo" closed="false">3:46 </char><char style="xt" closed="false"><ref loc="JOB 30:9-10">Job 30:9-10</ref></char></note>ouvri bouch yo laj kont nou.<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:47 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 24:17-18">És 24:17-18</ref>
      </char>
    </note>Sezisman ak pyèj tonbe sou nou,</para>
  <para style="q1" vid="LAM 3:47">ravaj ak destriksyon.<verse eid="LAM 3:47" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:48 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:136">Sòm 119:136</ref>
      </char>
    </note>Zye m koule nèt ak flèv dlo</para>
  <para style="q1" vid="LAM 3:48">akoz destriksyon a fi a pèp mwen an.<verse eid="LAM 3:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49" />Zye m koule <note caller="+" style="x"><char style="xo" closed="false">3:49 </char><char style="xt" closed="false"><ref loc="PSA 77:2">Sòm 77:2</ref></char></note>san sès, san rete menm pou yon ti moman,<verse eid="LAM 3:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50" />jiskaske SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">3:50 </char><char style="xt" closed="false"><ref loc="PSA 80:14">Sòm 80:14</ref></char></note>gade anba</para>
  <para style="q1" vid="LAM 3:50">soti nan wotè syèl la pou wè.<verse eid="LAM 3:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />Zye m pote doulè rive nan nanm mwen,</para>
  <para style="q1" vid="LAM 3:51">akoz tout fi nan vil mwen.<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:52 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 26:20">I Sam 26:20</ref>
      </char>
    </note>Lènmi m yo san koz te fè lachas dèyè m tankou zwazo.</para>
  <para style="q1" vid="LAM 3:52">Se lènmi m san koz.<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />Yo te fè m rete an silans <note caller="+" style="x"><char style="xo" closed="false">3:53 </char><char style="xt" closed="false"><ref loc="DAN 6:17">Dan 6:17</ref></char></note>nan twou fòs la</para>
  <para style="q1" vid="LAM 3:53">e te poze yon wòch sou mwen.<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />Dlo yo te koule <note caller="+" style="x"><char style="xo" closed="false">3:54 </char><char style="xt" closed="false"><ref loc="PSA 69:2">Sòm 69:2</ref></char></note>depase tèt mwen.</para>
  <para style="q1" vid="LAM 3:54">Mwen te di: “Mwen fin koupe retire nèt”!<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />Mwen <note caller="+" style="x"><char style="xo" closed="false">3:55 </char><char style="xt" closed="false"><ref loc="PSA 130:1">Sòm 130:1</ref></char></note>te rele non Ou, O SENYÈ,</para>
  <para style="q1" vid="LAM 3:55">depi nan twou fòs pi ba a.<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />Ou te <note caller="+" style="x"><char style="xo" closed="false">3:56 </char><char style="xt" closed="false"><ref loc="JOB 34:28">Job 34:28</ref></char></note>tande vwa m:</para>
  <para style="q1" vid="LAM 3:56">pa kache zòrèy W de lapriyè mwen pou sekou,</para>
  <para style="q1" vid="LAM 3:56">ak kriyè mwen an.<verse eid="LAM 3:56" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />Ou te <note caller="+" style="x"><char style="xo" closed="false">3:57 </char><char style="xt" closed="false"><ref loc="PSA 145:18">Sòm 145:18</ref></char></note>vin rapwoche lè m te rele Ou a.</para>
  <para style="q1" vid="LAM 3:57">Ou te di: “Pa pè!”<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />O Senyè, Ou <note caller="+" style="x"><char style="xo" closed="false">3:58 </char><char style="xt" closed="false"><ref loc="JER 50:34">Jr 50:34</ref></char></note>te plede ka pou nanm mwen an.</para>
  <para style="q1" vid="LAM 3:58">Ou te rachte lavi mwen.<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />O SENYÈ, Ou te wè jan m oprime.</para>
  <para style="q1" vid="LAM 3:59">
    <note caller="+" style="x">
      <char style="xo" closed="false">3:59 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 26:1">Sòm 26:1</ref>
      </char>
    </note>Jije ka m nan.<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />Ou te wè tout vanjans pa yo;</para>
  <para style="q1" vid="LAM 3:60">tout <note caller="+" style="x"><char style="xo" closed="false">3:60 </char><char style="xt" closed="false"><ref loc="JER 11:19">Jr 11:19</ref></char></note>manèv yo kont mwen.<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />Ou te tande <note caller="+" style="x"><char style="xo" closed="false">3:61 </char><char style="xt" closed="false"><ref loc="PSA 74:18">Sòm 74:18</ref></char></note>repwòch yo, O SENYÈ,</para>
  <para style="q1" vid="LAM 3:61">tout manèv yo kont mwen.<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:62 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 59:7-12">Sòm 59:7-12</ref>
      </char>
    </note>Lèv a sila k ap atake m yo</para>
  <para style="q1" vid="LAM 3:62">ak konplo yo kont mwen tout lajounen.<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />Gade jan yo <note caller="+" style="x"><char style="xo" closed="false">3:63 </char><char style="xt" closed="false"><ref loc="PSA 139:2">Sòm 139:2</ref></char></note>chita ak jan yo leve;</para>
  <para style="q1" vid="LAM 3:63">se mwen ki sijè chan giyonnen yo a.<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />Ou va <note caller="+" style="x"><char style="xo" closed="false">3:64 </char><char style="xt" closed="false"><ref loc="PSA 28:4">Sòm 28:4</ref></char></note>rekonpanse yo, O SENYÈ,</para>
  <para style="q1" vid="LAM 3:64">selon zèv men yo.<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />Ou va bay yo yon kè ki di;</para>
  <para style="q1" vid="LAM 3:65">
    <note caller="+" style="x">
      <char style="xo" closed="false">3:65 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:8">Egz 14:8</ref>
      </char>
    </note>madichon pa yo va sou yo.<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />Ou va <note caller="+" style="x"><char style="xo" closed="false">3:66 </char><char style="xt" closed="false"><ref loc="LAM 3:43">Lam 3:43</ref></char></note>kouri dèyè yo nan kòlè Ou</para>
  <para style="q1" vid="LAM 3:66">e detwi yo soti anba syèl SENYÈ a!<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />A la briyans lò a vin <note caller="+" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="EZK 7:19-22">Éz 7:19-22</ref></char></note>bese!</para>
  <para style="q1" vid="LAM 4:1">Lò pi a pa menm ankò!</para>
  <para style="q1" vid="LAM 4:1">Wòch tanp yo vide deyò nan tout kwen lari.<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />Pyè presye a fis a Sion yo;</para>
  <para style="q1" vid="LAM 4:2">ki gen valè kon lò fen,</para>
  <para style="q1" vid="LAM 4:2">gade kijan yo konsidere kon <note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="ISA 30:14">És 30:14</ref></char></note>veso tè,</para>
  <para style="q1" vid="LAM 4:2">travay a potye a!<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />Menm chen mawon yo konn bay tete;</para>
  <para style="q1" vid="LAM 4:3">yo kite pitit yo souse yo.</para>
  <para style="q1" vid="LAM 4:3">Men fi a pèp mwen an te vin <note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="ISA 49:15">És 49:15</ref></char></note>mechan</para>
  <para style="q1" vid="LAM 4:3">kon yon otrich nan dezè.<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:15">Sòm 22:15</ref>
      </char>
    </note>Lang a ti bebe a kole nan fon bouch yo,</para>
  <para style="q1" vid="LAM 4:4">tèlman yo swaf;</para>
  <para style="q1" vid="LAM 4:4">ti piti yo mande pen,</para>
  <para style="q1" vid="LAM 4:4">men pèsòn pa kase bay yo.<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />Sila ki te konn manje <note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="JER 6:2">Jr 6:2</ref></char></note>ti manje delika yo,</para>
  <para style="q1" vid="LAM 4:5">vin abandone nan lari.</para>
  <para style="q1" vid="LAM 4:5">Sila ki te leve nan abiman an mov yo</para>
  <para style="q1" vid="LAM 4:5">ap degaje yo chèche kaka bèf.<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />Paske inikite a fi a pèp mwen an</para>
  <para style="q1" vid="LAM 4:6">pi gwo ke peche Sodome,</para>
  <para style="q1" vid="LAM 4:6">ki te <note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="GEN 19:25">Jen 19:25</ref></char></note>boulvèse nan yon moman,</para>
  <para style="q1" vid="LAM 4:6">san pa t gen men ki boulvèse l.<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />Prens li yo te <note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="PSA 51:7">Sòm 51:7</ref></char></note>pi pwòp ke lanèj.</para>
  <para style="q1" vid="LAM 4:7">Yo te pi blan ke lèt.</para>
  <para style="q1" vid="LAM 4:7">Yo te pi wouj pase koray.</para>
  <para style="q1" vid="LAM 4:7">Yo te poli tankou pyè safì.<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />Aparans yo koulye a <note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="JOB 30:30">Job 30:30</ref></char></note>pi nwa ke poud chabon.</para>
  <para style="q1" vid="LAM 4:8">Yo pa menm rekonèt yo nan lari.</para>
  <para style="q1" vid="LAM 4:8">Chè yo vin kole sou zo yo.</para>
  <para style="q1" vid="LAM 4:8">Li fennen nèt.</para>
  <para style="q1" vid="LAM 4:8">Li vin tankou bwa.<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />Pi bon se sila ki te touye ak nepe yo,</para>
  <para style="q1" vid="LAM 4:9">ke sila ki touye ak grangou yo;</para>
  <para style="q1" vid="LAM 4:9">paske yo vin chagren</para>
  <para style="q1" vid="LAM 4:9">e epwize akoz mank fwi chan an.<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />Men a fanm ki te konn plen konpasyon yo</para>
  <para style="q1" vid="LAM 4:10">te bouyi pwòp pitit yo.</para>
  <para style="q1" vid="LAM 4:10">Yo te devni <note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 28:53-55">Det 28:53-55</ref></char></note>manje pou yo,</para>
  <para style="q1" vid="LAM 4:10">akoz destriksyon a fi a pèp mwen an.<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />SENYÈ a te <note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="JER 7:20">Jr 7:20</ref></char></note>acheve gwo kòlè Li a.</para>
  <para style="q1" vid="LAM 4:11">Li te vide gwo kòlè Li a.</para>
  <para style="q1" vid="LAM 4:11">Li te limen yon dife nan Sion,</para>
  <para style="q1" vid="LAM 4:11">ki te manje tout fondasyon Li yo.<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />Wa latè yo pa t kwè,</para>
  <para style="q1" vid="LAM 4:12">ni okenn abitan nan mond lan,</para>
  <para style="q1" vid="LAM 4:12">ke advèsè ak ènmi an ta ka <note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="JER 21:13">Jr 21:13</ref></char></note>antre</para>
  <para style="q1" vid="LAM 4:12">nan pòtay Jérusalem nan.<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />Akoz peche a pwofèt li yo</para>
  <para style="q1" vid="LAM 4:13">ak inikite a prèt li yo,</para>
  <para style="q1" vid="LAM 4:13">ki te vèse nan mitan li</para>
  <para style="q1" vid="LAM 4:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:13 </char>
      <char style="xt" closed="false">
        <ref loc="JER 2:30">Jr 2:30</ref>
      </char>
    </note>san a moun ladwati yo.<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />Yo egare e avèg nan lari yo.</para>
  <para style="q1" vid="LAM 4:14">Yo te vin souye ak <note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="ISA 1:15">És 1:15</ref></char></note>san,</para>
  <para style="q1" vid="LAM 4:14">jiskaske pèsòn pa t ka manyen abiman yo.<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />“Sòti! <note caller="+" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="LEV 13:45-46">Lev 13:45-46</ref></char></note>Pa pwòp!” Yo te kriye a yo menm.</para>
  <para style="q1" vid="LAM 4:15">“Sòti, sòti, pa touche!”</para>
  <para style="q1" vid="LAM 4:15">Konsa yo te sove ale, e te mache toupatou.</para>
  <para style="q1" vid="LAM 4:15">Pami nasyon yo, yo te di:</para>
  <para style="q1" vid="LAM 4:15">“Yo p ap ka kontinye rete pami nou”.<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />Prezans a SENYÈ a te gaye yo.</para>
  <para style="q1" vid="LAM 4:16">Li p ap kontinye bay yo swen.</para>
  <para style="q1" vid="LAM 4:16">Yo pa t <note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ISA 9:14-16">És 9:14-16</ref></char></note>onore prèt yo,</para>
  <para style="q1" vid="LAM 4:16">Yo pa t respekte ansyen yo.<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />Malgre sa, zye nou febli.</para>
  <para style="q1" vid="LAM 4:17">Chache sekou te vin <note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="JER 37:7">Jr 37:7</ref></char></note>initil.</para>
  <para style="q1" vid="LAM 4:17">Nan chache, nou te chache pou yon nasyon</para>
  <para style="q1" vid="LAM 4:17">ki pa t ka sove.<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />Konsa, yo te <note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="JER 16:16">Jr 16:16</ref></char></note>fè lachas dèyè nou</para>
  <para style="q1" vid="LAM 4:18">jiskaske nou pa t ka mache nan lari nou yo.</para>
  <para style="q1" vid="LAM 4:18">Lafen nou vin pwòch.</para>
  <para style="q1" vid="LAM 4:18">Jou nou yo fin ranpli,</para>
  <para style="q1" vid="LAM 4:18">paske dènye moman nou vin rive.<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />Sila ki te kouri dèyè nou yo</para>
  <para style="q1" vid="LAM 4:19">te pi vit pase èg k ap volè anlè.</para>
  <para style="q1" vid="LAM 4:19">Yo te fè lachas sou nou nan mòn yo.</para>
  <para style="q1" vid="LAM 4:19">Yo te kache tann anbiskad pou nou nan savann nan.<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />Souf lè ki nan nen nou,</para>
  <para style="q1" vid="LAM 4:20">nou menm ki onksyone de <note caller="+" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="2SA 1:14">II Sam 1:14</ref></char></note>SENYÈ a,</para>
  <para style="q1" vid="LAM 4:20">te vin kaptire nan twou fòs yo,</para>
  <para style="q1" vid="LAM 4:20">de sila nou te konn di:</para>
  <para style="q1" vid="LAM 4:20">“Anba lonbraj li, nou va viv pami nasyon yo”.<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />Rejwi e fè kè kontan, O fi a <note caller="+" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="PSA 137:7">Sòm 137:7</ref></char></note>Edom nan,</para>
  <para style="q1" vid="LAM 4:21">ki rete nan peyi Uts la.</para>
  <para style="q1" vid="LAM 4:21">Tas la va fè wonn vin jwenn ou tou.</para>
  <para style="q1" vid="LAM 4:21">Ou va vin sou.</para>
  <para style="q1" vid="LAM 4:21">Ou va vin toutouni.<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />Pinisyon pou inikite nou yo fin <note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="ISA 40:2">És 40:2</ref></char></note>konplete,</para>
  <para style="q1" vid="LAM 4:22">O fi a Sion an.</para>
  <para style="q1" vid="LAM 4:22">Li p ap ekzile nou ankò.</para>
  <para style="q1" vid="LAM 4:22">Li va pini inikite nou an, O fi Edom an.</para>
  <para style="q1" vid="LAM 4:22">Li va fè parèt tout peche ou yo!<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="p">
    <verse number="1" style="v" sid="LAM 5:1" />Sonje, O SENYÈ, sa ki te rive nou an.</para>
  <para style="q1" vid="LAM 5:1">Gade pou wè <note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="PSA 44:13-16">Sòm 44:13-16</ref></char></note>repwòch nou.<verse eid="LAM 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />Eritaj nou te bay kon don a <note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="ISA 1:7">És 1:7</ref></char></note>etranje yo,</para>
  <para style="q1" vid="LAM 5:2">kay nou yo a moun nou pa konnen.<verse eid="LAM 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />Nou te devni òfelen <note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="EXO 22:24">Egz 22:24</ref></char></note>san papa.</para>
  <para style="q1" vid="LAM 5:3">Manman nou yo tankou vèv.<verse eid="LAM 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />Nou oblije achte <note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="ISA 3:1">És 3:1</ref></char></note>dlo pou nou bwè.</para>
  <para style="q1" vid="LAM 5:4">Bwa nou se pou vann, yo vann nou li.<verse eid="LAM 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />Sila k ap kouri dèyè nou yo rive sou kou nou.</para>
  <para style="q1" vid="LAM 5:5">Nou vin bouke nèt.</para>
  <para style="q1" vid="LAM 5:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:5 </char>
      <char style="xt" closed="false">
        <ref loc="NEH 9:36-37">Né 9:36-37</ref>
      </char>
    </note>Nanpwen repo pou nou.<verse eid="LAM 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />Nou te vin soumèt devan <note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="HOS 9:3">Os 9:3</ref></char></note>Egypte ak Assyrie</para>
  <para style="q1" vid="LAM 5:6">pou nou jwenn ase pen.<verse eid="LAM 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:7 </char>
      <char style="xt" closed="false">
        <ref loc="JER 14:20">Jr 14:20</ref>
      </char>
    </note>Papa zansèt nou yo te peche,</para>
  <para style="q1" vid="LAM 5:7">men yo pa la ankò;</para>
  <para style="q1" vid="LAM 5:7">se nou menm ki te pote inikite pa yo.<verse eid="LAM 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />Se <note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="NEH 5:15">Né 5:15</ref></char></note>esklav yo k ap domine sou nou;</para>
  <para style="q1" vid="LAM 5:8">nanpwen moun ki pou delivre nou nan men yo.<verse eid="LAM 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />Nou <note caller="+" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="JER 40:9-12">Jr 40:9-12</ref></char></note>riske lavi nou pou jwenn pen</para>
  <para style="q1" vid="LAM 5:9">akoz nepe nan dezè a.<verse eid="LAM 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />Po nou vin <note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="JOB 30:30">Job 30:30</ref></char></note>kwit tankou yon fou,</para>
  <para style="q1" vid="LAM 5:10">akoz gwo chalè grangou a.<verse eid="LAM 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />Yo te ravaje tout <note caller="+" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="ISA 13:16">És 13:16</ref></char></note>fanm Sion yo;</para>
  <para style="q1" vid="LAM 5:11">vyèj lavil a Juda yo.<verse eid="LAM 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />Prens yo te pann pa men yo;</para>
  <para style="q1" vid="LAM 5:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:12 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 47:6">És 47:6</ref>
      </char>
    </note>ansyen yo te vin pa respekte.<verse eid="LAM 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />Jennonm yo te <note caller="+" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="JDG 16:21">Jij 16:21</ref></char></note>fòse travay devan moulen an</para>
  <para style="q1" vid="LAM 5:13">e timoun yo te kilbite anba gwo chaj bwa yo.<verse eid="LAM 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />Ansyen yo ale kite pòtay la;</para>
  <para style="q1" vid="LAM 5:14">jennonm yo ale kite <note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="ISA 24:8">És 24:8</ref></char></note>mizik yo.<verse eid="LAM 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />Jwa nan kè nou vin <note caller="+" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="JER 25:10">Jr 25:10</ref></char></note>sispann;</para>
  <para style="q1" vid="LAM 5:15">danse vin ranplase pa fè dèy.<verse eid="LAM 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />Kouwòn nan soti sou tèt nou;</para>
  <para style="q1" vid="LAM 5:16">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:16 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 3:9-11">És 3:9-11</ref>
      </char>
    </note>malè a nou menm, paske nou te peche!<verse eid="LAM 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />Akoz sa, <note caller="+" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ISA 1:5">És 1:5</ref></char></note>kè nou febli;</para>
  <para style="q1" vid="LAM 5:17">akoz bagay sa yo, zye nou pa wè klè.<verse eid="LAM 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />Akoz <note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="MIC 3:12">Mi 3:12</ref></char></note>Mòn Sion ki kouche dezole nèt,</para>
  <para style="q1" vid="LAM 5:18">rena yo fè patwouj ladann.<verse eid="LAM 5:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19" />Ou menm, O SENYÈ, Ou renye jis pou tout tan;</para>
  <para style="q1" vid="LAM 5:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:19 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:6">Sòm 45:6</ref>
      </char>
    </note>twòn Ou se de jenerasyon an jenerasyon.<verse eid="LAM 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />Poukisa Ou <note caller="+" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PSA 13:1">Sòm 13:1</ref></char></note>bliye nou jis pou tout tan?</para>
  <para style="q1" vid="LAM 5:20">Poukisa Ou abandone nou jis rive tout tan sa a?<verse eid="LAM 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:21 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 80:3">Sòm 80:3</ref>
      </char>
    </note>Restore nou a Ou menm O SENYÈ,</para>
  <para style="q1" vid="LAM 5:21">pou nou ka vin restore.</para>
  <para style="q1" vid="LAM 5:21">Fè jou nou yo vin jan yo te ye nan tan pase yo.<verse eid="LAM 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />Men <note caller="+" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="PSA 60:1-2">Sòm 60:1-2</ref></char></note>Ou deja fin rejte nou nèt.</para>
  <para style="q1" vid="LAM 5:22">Ou rete byen fache nèt ak nou.<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>