<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id"/>
  <para style="h">Pwovèb</para>
  <para style="toc1">PWOVÈB YO</para>
  <para style="toc2">Pwovèb Yo</para>
  <para style="toc3">Pwov</para>
  <para style="mt1">PWOVÈB YO</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 4:32">I Wa 4:32</ref>
      </char>
    </note>Pwovèb Salomon yo, fis a David la, wa Israël la:<verse eid="PRO 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2"/>pou konnen sajès avèk enstriksyon,</para>
  <para style="q1" vid="PRO 1:2">Pou dekouvri pawòl <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="PRO 4:1">Pwov 4:1</ref> </char></note>bon konprann yo,<verse eid="PRO 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3"/>Pou <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="PRO 2:1">Pwov 2:1</ref></char></note>resevwa enstriksyon nan jan pou aji ak sajès,</para>
  <para style="q1" vid="PRO 1:3">ladwati, jistis, menm jan pou tout moun;<verse eid="PRO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4"/>Pou <note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="PRO 8:5-12">Pwov 8:5-12</ref></char></note>avèti san konprann yo e bay konesans ak pridans a jenn yo.<verse eid="PRO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5"/>Yon nonm saj va tande, va grandi nan konesans li</para>
  <para style="q1" vid="PRO 1:5">e yon <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="PRO 14:6">Pwov 14:6</ref> </char></note>nonm bon konprann va twouve konsèy ki saj,<verse eid="PRO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6"/>Pou konprann yon pwovèb ak mo kache, pawòl a saj yo avèk <note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="NUM 12:8">Nonb 12:8</ref></char></note>devinèt yo.<verse eid="PRO 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:7 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:28">Job 28:28</ref>
      </char>
    </note>Lakrent SENYÈ a se kòmansman sajès la;</para>
  <para style="q1" vid="PRO 1:7">sila ki plen foli, meprize sajès ak lenstriksyon.<verse eid="PRO 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>Tande byen, fis mwen an, lenstriksyon papa ou,</para>
  <para style="q1" vid="PRO 1:8">e <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="PRO 6:20">Pwov 6:20</ref> </char></note>pa abandone leson a manman ou yo;<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>Anverite, yo fè yon <note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="GEN 41:42">Jen 41:42</ref></char></note>kouwòn byen bèl sou tèt ou,</para>
  <para style="q1" vid="PRO 1:9">ak yon bèl dekorasyon nan kou ou.<verse eid="PRO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10"/>Fis mwen an, si pechè yo vin tante ou, <note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="GEN 39:7-10">Jen 39:7-10</ref></char></note>pa dakò.<verse eid="PRO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>Si yo di: “Vini avèk nou, annou <note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="PRO 12:6">Pwov 12:6</ref></char></note>kouche yon pyèj pou san,</para>
  <para style="q1" vid="PRO 1:11">annou fè anbiskad pou inosan yo san koz;<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>Annou <note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="PSA 124:3">Sòm 124:3</ref></char></note>vale yo vivan tankou Sejou mò yo,</para>
  <para style="q1" vid="PRO 1:12">menm an antye tankou sila k ap desann nan fòs yo.<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>Nou va jwenn tout kalite byen presye,</para>
  <para style="q1" vid="PRO 1:13">nou va ranpli lakay nou ak piyaj.<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>Tire osò pa ou ansanm ak nou.</para>
  <para style="q1" vid="PRO 1:14">Nou tout va gen yon sèl bous”—<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>Fis mwen an, <note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="PSA 1:1">Sòm 1:1</ref></char></note>pa mache nan chemen avèk yo.</para>
  <para style="q1" vid="PRO 1:15">Anpeche pye ou antre sou wout yo,<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>Paske <note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="PRO 6:17-18">Pwov 6:17-18</ref></char></note>pye yo kouri jwenn mal,</para>
  <para style="q1" vid="PRO 1:16">e yo fè vit pou yo vèse san.<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>Anverite, se initil pou ouvri yon filè ak pen gaye</para>
  <para style="q1" vid="PRO 1:17">devan nenpòt kalite zwazo;<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>men yap kouche yon pyèj pou pwòp san pa yo.</para>
  <para style="q1" vid="PRO 1:18">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:18 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:19">Pwov 11:19</ref>
      </char>
    </note> Yo fè anbiskad pou pwòp lavi pa yo.<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>Se konsa tout chemen yo ye a pou</para>
  <para style="q1" vid="PRO 1:19">tout moun ki <note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="PRO 15:27">Pwov 15:27</ref></char></note>vin genyen pa mwayen vyolans.</para>
  <para style="q1" vid="PRO 1:19">Se pwòp lavi yo kap vin rache.<verse eid="PRO 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:20 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:1-3">Pwov 8:1-3</ref>
      </char>
    </note>Sajès rele fò nan lari.</para>
  <para style="q1" vid="PRO 1:20">Li leve vwa li nan plas la.<verse eid="PRO 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21"/>Nan tèt lari ki gen zen yo, li kriye fò.</para>
  <para style="q1" vid="PRO 1:21">Nan antre pòtay lari yo,</para>
  <para style="q1" vid="PRO 1:21">li fè moun tande tout pawòl li yo:<verse eid="PRO 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>“Jiskilè, O moun san bon konprann yo,</para>
  <para style="q1" vid="PRO 1:22">nou va renmen rete san konprann anyen?</para>
  <para style="q1" vid="PRO 1:22">Pou mokè yo rejwi yo nan moke moun e</para>
  <para style="q1" vid="PRO 1:22">moun san konprann yo rayi konesans?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>Vire sou repwòch mwen an.</para>
  <para style="q1" vid="PRO 1:23">Gade byen, mwen <note caller="+" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 32:15">És 32:15</ref></char></note>va vide lespri m sou nou.</para>
  <para style="q1" vid="PRO 1:23">Mwen va fè nou konnen pawòl mwen yo.<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>Akoz mwen te rele nou e nou te refize;</para>
  <para style="q1" vid="PRO 1:24">mwen te <note caller="+" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="ISA 65:2">És 65:2</ref> </char></note>lonje men m, e pèsòn pa t okipe sa,<verse eid="PRO 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25"/>men nou te neglije tout konsèy mwen yo,</para>
  <para style="q1" vid="PRO 1:25">e nou <note caller="+" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="PRO 15:10">Pwov 15:10</ref> </char></note>pa t vle tande repwòch mwen;<verse eid="PRO 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26"/>konsa, mwen menm anplis, va ri sou malè nou yo.</para>
  <para style="q1" vid="PRO 1:26">Mwen va moke nou lè <note caller="+" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="PRO 10:24">Pwov 10:24</ref> </char></note>gran laperèz la rive,<verse eid="PRO 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27"/>lè gran laperèz nou rive tankou tanpèt</para>
  <para style="q1" vid="PRO 1:27">e gwo dezas nou yo tankou <note caller="+" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="PRO 10:25">Pwov 10:25</ref></char></note>toubiyon,</para>
  <para style="q1" vid="PRO 1:27">lè gwo pwoblèm ak soufrans rive sou nou.<verse eid="PRO 1:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28"/>Nan lè sa a, yo va rele m, men mwen p ap reponn.</para>
  <para style="q1" vid="PRO 1:28">Yo va <note caller="+" style="x"><char style="xo" closed="false">1:28 </char><char style="xt" closed="false"><ref loc="PRO 8:17">Pwov 8:17</ref></char></note>chache mwen avèk dilijans, men yo p ap twouve m,<verse eid="PRO 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29"/>akoz yo te <note caller="+" style="x"><char style="xo" closed="false">1:29 </char><char style="xt" closed="false"><ref loc="JOB 21:14">Job 21:14</ref></char></note>rayi konesans</para>
  <para style="q1" vid="PRO 1:29">e pa t chwazi gen lakrent SENYÈ a.<verse eid="PRO 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30"/>Yo te refize konsèy mwen.</para>
  <para style="q1" vid="PRO 1:30">Yo te rejte tout repwòch mwen yo.<verse eid="PRO 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31"/>Pou sa, yo va <note caller="+" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="JOB 4:8">Job 4:8</ref></char></note>manje fwi a pwòp chemen yo,</para>
  <para style="q1" vid="PRO 1:31">e vant yo va vin plen ak pwòp manèv yo.<verse eid="PRO 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32"/>Paske <note caller="+" style="x"><char style="xo" closed="false">1:32 </char><char style="xt" closed="false"><ref loc="JER 2:19">Jr 2:19</ref></char></note> chemen kwochi a moun</para>
  <para style="q1" vid="PRO 1:32">san konprann yo va touye yo.</para>
  <para style="q1" vid="PRO 1:32">Kè kontan a sila ki plen foli va detwi yo.<verse eid="PRO 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33"/>Men sila ki koute mwen an</para>
  <para style="q1" vid="PRO 1:33">va viv ansekirite,</para>
  <para style="q1" vid="PRO 1:33">e li va rete alèz san pè malè.”<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1"/>Fis mwen an, si ou resevwa pawòl mwen yo,</para>
  <para style="q1" vid="PRO 2:1">e <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="PRO 3:1">Pwov 3:1</ref></char></note>gade kòmandman mwen yo nan kè ou,<verse eid="PRO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2"/>e <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="PRO 22:17">Pwov 22:17</ref></char></note>fè zòrèy ou atantif a sajès;</para>
  <para style="q1" vid="PRO 2:2">e enkline zòrèy ou vè bon konprann,<verse eid="PRO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3"/>wi, si ou leve vwa w pou sajès;</para>
  <para style="q1" vid="PRO 2:3">e leve vwa ou vè bon konprann;<verse eid="PRO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4"/>si ou chache li kon ajan,</para>
  <para style="q1" vid="PRO 2:4">e fè rechèch dèyè li kon trezò <note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="JOB 3:21">Job 3:21</ref></char></note>ki kache;<verse eid="PRO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5"/>nan lè sa a, ou va dekouvri <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="PRO 1:7">Pwov 1:7</ref></char></note>lakrent SENYÈ a,</para>
  <para style="q1" vid="PRO 2:5">e dekouvri konesans Bondye a.<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>Paske, <note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="1KI 3:12">I Wa 3:12</ref></char></note>SENYÈ a bay sajès.</para>
  <para style="q1" vid="PRO 2:6">Nan bouch Li, soti konesans ak bon konprann.<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>Li mete sajès nan depo pou moun dwat la.</para>
  <para style="q1" vid="PRO 2:7">Li se <note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="PSA 84:11">Sòm 84:11</ref></char></note>boukliye pou sila ki mache ak entegrite yo,<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>Ka p veye chemen lajistis yo,</para>
  <para style="q1" vid="PRO 2:8">e <note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="1SA 2:9">I Sam 2:9</ref></char></note>pwoteje chemen a fidèl Li yo.<verse eid="PRO 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>Konsa, ou va dekouvri <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="PRO 8:20">Pwov 8:20</ref></char></note>ladwati ak jistis,</para>
  <para style="q1" vid="PRO 2:9">e menm egalite avèk tout bon chemen yo.<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>Paske, sajès va antre nan kè ou,</para>
  <para style="q1" vid="PRO 2:10">e <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="PRO 22:18">Pwov 22:18</ref> </char></note>konesans va fè ou alèz jis rive nan nanm ou.<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>Bon konprann va <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="PRO 4:6">Pwov 4:6</ref></char></note>pwoteje ou,</para>
  <para style="q1" vid="PRO 2:11">konesans va veye sou ou,<verse eid="PRO 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>pou <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PRO 28:26">Pwov 28:26</ref></char></note>pwoteje ou kont chemen mal la,</para>
  <para style="q1" vid="PRO 2:12">kont lòm ki pale bagay pèvès yo.<verse eid="PRO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13"/>Kont sila ki <note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="PRO 21:16">Pwov 21:16</ref></char></note>kite chemen ladwati yo</para>
  <para style="q1" vid="PRO 2:13">pou mache nan chemen fènwa yo;<verse eid="PRO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14"/>ki <note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="PRO 10:23">Pwov 10:23</ref></char></note>pran plezi nan fè sa ki mal</para>
  <para style="q1" vid="PRO 2:14">e rejwi nan mechanste mal la.<verse eid="PRO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15"/>Chemen a sila ki vin <note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="PSA 125:5">Sòm 125:5</ref></char></note>kwochi yo</para>
  <para style="q1" vid="PRO 2:15">e ki vin gaye kò yo nan tout sa yo fè.<verse eid="PRO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>Pou delivre ou soti nan men fanm etranje a,</para>
  <para style="q1" vid="PRO 2:16">soti nan men <note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="PRO 23:27">Pwov 23:27</ref></char></note>fanm adiltè ki flate ak pawòl li;<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>ki kite <note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="MAT 2:14-15">Mat 2:14-15</ref></char></note>konpanyen jenès li a,</para>
  <para style="q1" vid="PRO 2:17">e ki bliye akò a Bondye li;<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>paske lakay li mennen a lanmò</para>
  <para style="q1" vid="PRO 2:18">e tras a pla pye li yo rive kote mò yo.<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>Pèsòn <note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="ECC 7:26">Ekl 7:26</ref></char></note>ki ale kote li menm, pa retounen ankò,</para>
  <para style="q1" vid="PRO 2:19">ni yo pa jwenn pa lavi.<verse eid="PRO 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>Akoz sa a, ou va <note caller="+" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="HEB 6:12">Eb 6:12</ref></char></note>mache nan chemen a sila ki bon yo,</para>
  <para style="q1" vid="PRO 2:20">e swiv tras a moun ladwati yo.<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>Paske moun dwat yo va viv nan peyi a,</para>
  <para style="q1" vid="PRO 2:21">e <note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="PRO 28:10">Pwov 28:10</ref> </char></note>sila ki san tò yo va rete ladann;<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>men mechan yo va koupe retire nèt de peyi a,</para>
  <para style="q1" vid="PRO 2:22">e moun trèt yo va <note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="DEU 28:63">Det 28:63</ref> </char></note>dechouke de li.<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>Fis mwen an, <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="PSA 119:61">Sòm 119:61</ref></char></note>pa bliye enstriksyon mwen an,</para>
  <para style="q1" vid="PRO 3:1">men kite kè ou kenbe kòmandman Mwen yo;<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>paske konsa, longè jou, ane lavi ak lapè yo</para>
  <para style="q1" vid="PRO 3:2">va vin ogmante sou ou.<verse eid="PRO 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>Pa kite <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="2SA 15:20">II Sam 15:20</ref></char></note>dousè ak verite kite ou.</para>
  <para style="q1" vid="PRO 3:3">Mare yo antoure kou ou.</para>
  <para style="q1" vid="PRO 3:3">Ekri yo sou tablo kè ou.<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>Konsa, ou va twouve favè avèk <note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="PSA 111:10">Sòm 111:10</ref></char></note>bon repitasyon</para>
  <para style="q1" vid="PRO 3:4">nan men Bondye a, ak moun.<verse eid="PRO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:3-5">Sòm 37:3-5</ref>
      </char>
    </note>Mete konfyans nan SENYÈ a ak tout kè ou;</para>
  <para style="q1" vid="PRO 3:5">pa apiye sou pwòp bon konprann pa w.<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>Nan tout chemen ou yo rekonèt Li;</para>
  <para style="q1" vid="PRO 3:6">konsa Li va <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ISA 45:13">És 45:13</ref></char></note>fè pa ou yo vin dwat.<verse eid="PRO 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:16">Wo 12:16</ref>
      </char>
    </note>Pa vin saj nan pwòp zye pa ou;</para>
  <para style="q1" vid="PRO 3:7">krent SENYÈ a e vire kite mal.<verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>Li va sèvi kon yon <note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="PRO 4:22">Pwov 4:22</ref></char></note>gerizon pou kò ou,</para>
  <para style="q1" vid="PRO 3:8">ak rafrechisman a zo ou.<verse eid="PRO 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>Onore SENYÈ a ak sa ki soti nan bonte ou yo;</para>
  <para style="q1" vid="PRO 3:9">ak <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="EXO 23:19">Egz 23:19</ref> </char></note>premye pati nan tout prodwi ou,<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>pou <note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="DEU 28:8">Det 28:8</ref></char></note>depo ou yo kab vin plen ak abondans,</para>
  <para style="q1" vid="PRO 3:10">e pou sitèn ou yo plen ak diven tounèf.<verse eid="PRO 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:11 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:17">Job 5:17</ref>
      </char>
    </note>Fis mwen an, pa rejte disiplin SENYÈ a,</para>
  <para style="q1" vid="PRO 3:11">ni rayi repwòch Li,<verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>Paske <note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 3:19">Rev 3:19</ref></char></note>sila ke SENYÈ a renmen an, Li korije li,</para>
  <para style="q1" vid="PRO 3:12">jis tankou yon papa konn korije</para>
  <para style="q1" vid="PRO 3:12">fis nan sila li pran plezi a.<verse eid="PRO 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:13 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:32-34">Pwov 8:32-34</ref>
      </char>
    </note>A la beni nonm ki twouve sajès,</para>
  <para style="q1" vid="PRO 3:13">e nonm ki vin genyen bon konprann nan beni!<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>Paske <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="JOB 28:15-19">Job 28:15-19</ref></char></note>avantaj li pi bon ke avantaj ajan,</para>
  <para style="q1" vid="PRO 3:14">e pwofi li pi bon ke lò fen.<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>Li <note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="JOB 28:18">Job 28:18</ref></char></note>pi presye pase bijou;</para>
  <para style="q1" vid="PRO 3:15">e okenn lòt bagay ke ou ta dezire pa kab konpare avèk li.<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>Lavi ki long va trouve nan men dwat li.</para>
  <para style="q1" vid="PRO 3:16">Nan men goch li se <note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="PRO 8:18">Pwov 8:18</ref> </char></note>richès ak lonè.<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:17 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 11:29">Mat 11:29</ref>
      </char>
    </note>Chemen li yo byen dous,</para>
  <para style="q1" vid="PRO 3:17">e tout pa li yo se lapè.<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>Li se yon <note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="GEN 2:9">Jen 2:9</ref></char></note>pyebwa lavi a sila ki pran l yo,</para>
  <para style="q1" vid="PRO 3:18">e byen kontan se tout sila ki kenbe l fèm yo.<verse eid="PRO 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="PSA 104:24">Sòm 104:24</ref></char></note>ak sajès te fonde latè a;</para>
  <para style="q1" vid="PRO 3:19">ak bon konprann Li te etabli syèl yo.<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>Ak konesans Li, <note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="GEN 7:11">Jen 7:11</ref></char></note>fon yo te vin ouvri,</para>
  <para style="q1" vid="PRO 3:20">e syèl yo te vin degoute lawouze.<verse eid="PRO 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21"/>Fis mwen an, pa kite yo vin disparèt devan zye ou;</para>
  <para style="q1" vid="PRO 3:21">kenbe bon sajès ak bon konprann.<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>Konsa yo va <note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="DEU 32:47">Det 32:47</ref></char></note>lavi pou nanm ou</para>
  <para style="q1" vid="PRO 3:22">ak dekorasyon pou kou ou.<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>Konsa, ou va mache nan chemen ou ak sekirite,</para>
  <para style="q1" vid="PRO 3:23">e pye ou p ap <note caller="+" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="PSA 91:12">Sòm 91:12</ref> </char></note>chape.<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>Lè ou <note caller="+" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="JOB 11:9">Job 11:9</ref></char></note>kouche ou p ap pè;</para>
  <para style="q1" vid="PRO 3:24">kouche ou ak dòmi ou va byen dous.<verse eid="PRO 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>Pa pè gwo laperèz ki parèt sibitman,</para>
  <para style="q1" vid="PRO 3:25">ni atak a mechan an lè l vini.<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>Paske Bondye va konfyans ou,</para>
  <para style="q1" vid="PRO 3:26">e va <note caller="+" style="x"><char style="xo" closed="false">3:26 </char><char style="xt" closed="false"><ref loc="1SA 2:9">I Sam 2:9</ref></char></note>veye pye ou pou l pa pran nan pyèj.<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:27 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 13:7">Wo 13:7</ref>
      </char>
    </note>Pa refize fè byen a sila ki merite l yo,</para>
  <para style="q1" vid="PRO 3:27">si se nan kapasite ou pou fè l.<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>Pa di vwazen ou: “Ale e retounen pita”,</para>
  <para style="q1" vid="PRO 3:28">oswa “Demen, m ap bay ou”, lè l deja nan men w.<verse eid="PRO 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:29 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:14">Pwov 6:14</ref>
      </char>
    </note>Pa kalkile mal kont vwazen ou</para>
  <para style="q1" vid="PRO 3:29">pandan l ap viv an sekirite akote ou.<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>Pa fè kont ak yon nonm san koz,</para>
  <para style="q1" vid="PRO 3:30">depi li pa konn fè ou tò.<verse eid="PRO 3:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:31 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:1">Sòm 37:1</ref>
      </char>
    </note>Pinga ou gen anvi a yon nonm vyolan,</para>
  <para style="q1" vid="PRO 3:31">ni pa chwazi chemen li yo.<verse eid="PRO 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>Moun pèvès se yon abominasyon a SENYÈ a;</para>
  <para style="q1" vid="PRO 3:32">men SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">3:32 </char><char style="xt" closed="false"><ref loc="JOB 29:4">Job 29:4</ref> </char></note>vin toupre a sila yo ki dwat yo.<verse eid="PRO 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>Malediksyon SENYÈ a sou kay mechan yo,</para>
  <para style="q1" vid="PRO 3:33">men Li <note caller="+" style="x"><char style="xo" closed="false">3:33 </char><char style="xt" closed="false"><ref loc="JOB 8:6">Job 8:6</ref> </char></note>beni abitasyon a moun dwat yo.<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:34 </char>
      <char style="xt" closed="false">
        <ref loc="JAS 4:6">Jc 4:6</ref>
      </char>
    </note>Li moke moun k ap moke,</para>
  <para style="q1" vid="PRO 3:34">men Li bay gras a sila ki aflije yo.<verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:35 </char>
      <char style="xt" closed="false">
        <ref loc="DAN 12:3">Dan 12:3</ref>
      </char>
    </note>Saj yo va resevwa gran respe kon eritaj,</para>
  <para style="q1" vid="PRO 3:35">men moun plen foli yo va dezonere.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>Tande, O fis yo, <note caller="+" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="PSA 34:11">Sòm 34:11</ref></char></note>enstriksyon a yon papa,</para>
  <para style="q1" vid="PRO 4:1">e fè atansyon pou ou kab reyisi jwenn bon konprann,<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>Paske mwen bay ou bon konsèy;</para>
  <para style="q1" vid="PRO 4:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:30">Sòm 89:30</ref> </char>
    </note>pa abandone enstriksyon mwen.<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>Lè m te yon jenn timoun ak papa m,</para>
  <para style="q1" vid="PRO 4:3">byen jenn e <note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="ZEC 12:10">Za 12:10</ref></char></note>sèl fis devan zye a manman m,<verse eid="PRO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4"/>Alò, li te <note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EPH 6:4">Ef 6:4</ref></char></note>enstwi mwen e te di mwen:</para>
  <para style="q1" vid="PRO 4:4">“Kite kè ou kenbe fèm a pawòl mwen;</para>
  <para style="q1" vid="PRO 4:4">kenbe lòd mwen yo pou ou viv.<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>Vin ranmase sajès!</para>
  <para style="q1" vid="PRO 4:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:5 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:16">Pwov 16:16</ref>
      </char>
    </note>Ranmase bon konprann!</para>
  <para style="q1" vid="PRO 4:5">Pa bliye, ni pa vire kite pawòl a bouch mwen yo.<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>Pa abandone li e li va pwoteje ou;</para>
  <para style="q1" vid="PRO 4:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:6 </char>
      <char style="xt" closed="false">
        <ref loc="2TI 2:10">II Tim 2:10</ref>
      </char>
    </note>renmen li e li va veye sou ou.<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>Men sa ki kòmansman sajès la:</para>
  <para style="q1" vid="PRO 4:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:7 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:23">Pwov 23:23</ref>
      </char>
    </note>Ranmase sajès!</para>
  <para style="q1" vid="PRO 4:7">Epi avèk sa ou rasanble a,</para>
  <para style="q1" vid="PRO 4:7">chache bon konprann.<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:8 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:30">I Sam 2:30</ref>
      </char>
    </note>Mete valè li wo e li va fè ou leve;</para>
  <para style="q1" vid="PRO 4:8">li va bay ou onè si ou anbrase l.<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>Li va poze <note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="PRO 1:9">Pwov 1:9</ref></char></note>sou tèt ou yon kouwòn lagras;</para>
  <para style="q1" vid="PRO 4:9">li va prezante ou avèk yon kouwòn byen bèl.”<verse eid="PRO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>Tande, fis mwen an, <note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="PRO 2:1">Pwov 2:1</ref></char></note>vin dakò ak pawòl mwen yo,</para>
  <para style="q1" vid="PRO 4:10">e lane lavi ou yo va vin byen long.<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="1SA 12:23">I Sam 12:23</ref></char></note>dirije ou nan chemen sajès la;</para>
  <para style="q1" vid="PRO 4:11">mwen te kondwi ou nan pa ladwati yo.<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>Lè ou mache, pa ou yo p ap jennen;</para>
  <para style="q1" vid="PRO 4:12">epi si ou kouri, <note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="PSA 91:11">Sòm 91:11</ref> </char></note>ou p ap glise tonbe.<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:13 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:18">Pwov 3:18</ref>
      </char>
    </note>Pran enstriksyon; pa lage menm.</para>
  <para style="q1" vid="PRO 4:13">Pwoteje li paske li se lavi ou.<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 1:1">Sòm 1:1</ref>
      </char>
    </note>Pa antre nan chemen mechan yo,</para>
  <para style="q1" vid="PRO 4:14">e pa avanse nan vwa malfektè yo.<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>Evite li, pa pase kote li;</para>
  <para style="q1" vid="PRO 4:15">vire kite li e ale byen lwen.<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>Paske, yo p ap kab dòmi si yo pa fè mal;</para>
  <para style="q1" vid="PRO 4:16">epi dòmi vin vòlè soti nan zye yo</para>
  <para style="q1" vid="PRO 4:16">si yo pa fè lòt glise tonbe.<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>Paske yo <note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="PRO 13:2">Pwov 13:2</ref></char></note>manje pen a malveyan yo</para>
  <para style="q1" vid="PRO 4:17">e bwè diven vyolans.<verse eid="PRO 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>Men pa a moun dwat yo se tankou limyè granmmaten</para>
  <para style="q1" vid="PRO 4:18">ki <note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="DAN 12:3">Dan 12:3</ref> </char></note> briye pi fò e pi fò jiskaske li vin fè jou nèt.<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:19 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 18:5-6">Job 18:5-6</ref>
      </char>
    </note>Chemen mechan yo tankou tenèb;</para>
  <para style="q1" vid="PRO 4:19">yo pa konnen sou kisa pou yo tonbe.<verse eid="PRO 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>Fis mwen an, <note caller="+" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="PRO 5:1">Pwov 5:1</ref></char></note>prete atansyon a pawòl mwen yo;</para>
  <para style="q1" vid="PRO 4:20">panche zòrèy ou vè diskou mwen yo.<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>Pa kite yo vin disparèt devan zye ou;</para>
  <para style="q1" vid="PRO 4:21">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:21 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 7:1-2">Pwov 7:1-2</ref>
      </char>
    </note>kenbe yo nan fon kè ou.<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>Paske yo se <note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="PRO 3:22">Pwov 3:22</ref></char></note>lavi a sila ki jwenn yo,</para>
  <para style="q1" vid="PRO 4:22">ak lasante a tout kò yo.<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>Veye sou kè ou ak tout dilijans;</para>
  <para style="q1" vid="PRO 4:23">paske <note caller="+" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat 12:34</ref></char></note>de li, sous lavi yo koule.<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>Mete lwen de ou yon bouch manti</para>
  <para style="q1" vid="PRO 4:24">e <note caller="+" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="PRO 19:1">Pwov 19:1</ref> </char></note>mete tout pawòl foub byen lwen ou.<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>Kite zye ou gade tou dwat devan</para>
  <para style="q1" vid="PRO 4:25">e kite vizyon ou konsantre devan nèt.<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:26 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 5:21">Pwov 5:21</ref>
      </char>
    </note>Veye wout pye ou konn pran</para>
  <para style="q1" vid="PRO 4:26">e tout chemen ou yo va byen etabli.<verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:27 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 5:32">Det 5:32</ref>
      </char>
    </note>Pa vire ni adwat ni agoch;</para>
  <para style="q1" vid="PRO 4:27">fè pye ou vire kite mal.<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>Fis mwen an, fè atansyon a sajès mwen,</para>
  <para style="q1" vid="PRO 5:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:1 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 22:17">Pwov 22:17</ref>
      </char>
    </note>apiye zòrèy ou vè bon konprann mwen;<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>pou ou kab kenbe sajès</para>
  <para style="q1" vid="PRO 5:2">e pou <note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAL 2:7">Mal 2:7</ref> </char></note>lèv ou ka konsève konesans.<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>Paske lèv a fanm adiltè a degoute siwo,</para>
  <para style="q1" vid="PRO 5:3">e pale li <note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="PSA 55:21">Sòm 55:21</ref> </char></note>pi dous pase lwil;<verse eid="PRO 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4"/>men a lafen, li vin anmè pase kou fyèl,</para>
  <para style="q1" vid="PRO 5:4">epi file kon yon nepe ki koupe de bò.<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>Pye li yo <note caller="+" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PRO 7:27">Pwov 7:27</ref></char></note>desann vè lanmò</para>
  <para style="q1" vid="PRO 5:5">e pa li yo kenbe fèm nan chemen Sejou mò yo.<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>Li pa reflechi sou pa lavi a;</para>
  <para style="q1" vid="PRO 5:6">vwa li yo pa stab; <note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="PRO 30:20">Pwov 30:20</ref> </char></note>li pa rekonèt bagay sa a.<verse eid="PRO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>Alò, fis mwen yo, koute mwen,</para>
  <para style="q1" vid="PRO 5:7">e <note caller="+" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="PSA 119:102">Sòm 119:102</ref></char></note>pa bliye pawòl a bouch mwen yo.<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>Kenbe wout ou byen lwen li, e</para>
  <para style="q1" vid="PRO 5:8">pa pwoche toupre <note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PRO 9:14">Pwov 9:14</ref> </char></note>pòt lakay li.<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>Oswa ou va bay fòs ou a lòt yo</para>
  <para style="q1" vid="PRO 5:9">ak ane ou yo a mechan an.<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>Konsa, etranje yo va ranpli ak fòs ou,</para>
  <para style="q1" vid="PRO 5:10">e byen yo ke ou te ranmase ak swè ou,</para>
  <para style="q1" vid="PRO 5:10">va rive lakay a yon etranje.<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>Epi ou va plenyen nan gòj</para>
  <para style="q1" vid="PRO 5:11">lè dènye moman lavi ou rive,</para>
  <para style="q1" vid="PRO 5:11">lè chè ou ak kò ou fin manje nèt.<verse eid="PRO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12"/>Ou va di: “Ki jan mwen te <note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="PRO 1:7-29">Pwov 1:7-29</ref></char></note>rayi enstriksyon!</para>
  <para style="q1" vid="PRO 5:12">Ak “Ki jan kè m te rayi repwòch!<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>Mwen pa t koute vwa a sa yo kap enstwi m yo,</para>
  <para style="q1" vid="PRO 5:13">ni mwen pa t panche zòrèy mwen vè <note caller="+" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="PRO 1:8">Pwov 1:8</ref></char></note>mèt mwen yo.<verse eid="PRO 5:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>Mwen te prèt pou fini nèt nan mitan asanble a ak kongregasyon an.”<verse eid="PRO 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>Bwè dlo nan pwòp sitèn pa ou e dlo fre nan pwi pa ou.<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>Èske <note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="PRO 5:18">Pwov 5:18</ref></char></note>sous ou yo dwe dispèse nan peyi etranje,</para>
  <para style="q1" vid="PRO 5:16">kòn vwa dlo k ap kouri nan lari yo?<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>Kite yo pou ou sèl, e pa pou etranje yo avèk ou yo.<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>Kite fontèn dlo ou a rete beni,</para>
  <para style="q1" vid="PRO 5:18">e rejwi ou nan madanm a jenès ou a.<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>Tankou yon sèf amourez ak yon bich elegan,</para>
  <para style="q1" vid="PRO 5:19">kite tete li yo satisfè ou tout tan.</para>
  <para style="q1" vid="PRO 5:19">Rete debòde nèt ak lanmou li.<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>Paske poukisa fis mwen an,</para>
  <para style="q1" vid="PRO 5:20">ou ta dwe renmen ak yon fanm adiltè,</para>
  <para style="q1" vid="PRO 5:20">e anbrase lestonmak a yon <note caller="+" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 2:16">Pwov 2:16</ref></char></note>etranje?<verse eid="PRO 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>Paske chemen a yon nonm se devan zye a SENYÈ a,</para>
  <para style="q1" vid="PRO 5:21">e Li <note caller="+" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="PRO 4:26">Pwov 4:26</ref></char></note>veye tout pa li yo.<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:22 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 32:23">Nonb 32:23</ref>
      </char>
    </note>Pwòp inikite a mechan an va kaptire li.</para>
  <para style="q1" vid="PRO 5:22">Li va kole nan kòd a pwòp peche pa li.<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>Li va <note caller="+" style="x"><char style="xo" closed="false">5:23 </char><char style="xt" closed="false"><ref loc="JOB 4:21">Job 4:21</ref></char></note>mouri akoz mank enstriksyon,</para>
  <para style="q1" vid="PRO 5:23">e nan grandè foli li, li va vin egare.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1"/>Fis mwen an, si ou devni <note caller="+" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="PRO 11:15">Pwov 11:15</ref></char></note>garanti dèt pou vwazen ou,</para>
  <para style="q1" vid="PRO 6:1">ou te fè pwomès pou yon lòt ki pa pa w.<verse eid="PRO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2"/>Ou te tonbe nan pèlen akoz pawòl a bouch ou,</para>
  <para style="q1" vid="PRO 6:2">ou te kenbe menm, akoz pawòl bouch ou yo.<verse eid="PRO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3"/>Alò fè sa, fis mwen an, pou delivre tèt ou.</para>
  <para style="q1" vid="PRO 6:3">Akoz ou te vin antre nan men a vwazen ou an,</para>
  <para style="q1" vid="PRO 6:3">ale desann pou jennen vwazen ou an.<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>Pa kite <note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="PSA 132:4">Sòm 132:4</ref></char></note>dòmi tonbe nan zye ou,</para>
  <para style="q1" vid="PRO 6:4">ni somèy rive sou pòpyè zye ou.<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>Chape tèt ou kon yon antilòp nan men a chasè,</para>
  <para style="q1" vid="PRO 6:5">oswa <note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="PSA 91:3">Sòm 91:3</ref></char></note>zwazo a nan pelen moun lachas la.<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>Ale kote <note caller="+" style="x"><char style="xo" closed="false">6:6 </char><char style="xt" closed="false"><ref loc="PRO 30:24-25">Pwov 30:24-25</ref></char></note>foumi, o parese.</para>
  <para style="q1" vid="PRO 6:6">Veye abitid li yo e vin saj!<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>Li menm, <note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="PRO 30:27">Pwov 30:27</ref></char></note> san pa gen chèf, ni ofisye, ni mèt,<verse eid="PRO 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8"/>kon prepare manje li <note caller="+" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="PRO 10:5">Pwov 10:5</ref></char></note>nan gran sezon an</para>
  <para style="q1" vid="PRO 6:8">e ranmase pwovizyon li nan rekòlt la.<verse eid="PRO 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>Pou konbyen de tan ou va kouche konsa O parese?</para>
  <para style="q1" vid="PRO 6:9">Se kilè ou va leve soti nan dòmi?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:10 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:33">Pwov 24:33</ref>
      </char>
    </note>Yon ti dòmi, yon ti somèy,</para>
  <para style="q1" vid="PRO 6:10">yon ti pliye men ou yo pou repoze;<verse eid="PRO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:11 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:34">Pwov 24:34</ref>
      </char>
    </note>mizè ou va vin parèt sou ou tankou yon vagabon,</para>
  <para style="q1" vid="PRO 6:11">e nesesite ou tankou yon nonm k ap pote zam.<verse eid="PRO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>Yon sanzave, yon moun mechan</para>
  <para style="q1" vid="PRO 6:12">se sila ki mache ak yon <note caller="+" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="PRO 4:24">Pwov 4:24</ref> </char></note>bouch pèvès,<verse eid="PRO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13"/>ki <note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JOB 15:12">Job 15:12</ref></char></note>bat zye li, ki fè siy ak pye li,</para>
  <para style="q1" vid="PRO 6:13">ki pwente ak dwèt li;<verse eid="PRO 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14"/>ki avèk pèvèsite nan kè l</para>
  <para style="q1" vid="PRO 6:14">fè tout tan sa ki mal,</para>
  <para style="q1" vid="PRO 6:14">ki <note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="PRO 6:19">Pwov 6:19</ref> </char></note>gaye konfli.<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>Pou sa, <note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="PRO 24:22">Pwov 24:22</ref></char></note>malè li va parèt sibitman;</para>
  <para style="q1" vid="PRO 6:15">nan yon enstan li va kase nèt;</para>
  <para style="q1" vid="PRO 6:15">e li p ap gen gerizon ditou.<verse eid="PRO 6:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16"/>Gen sis bagay ke SENYÈ a rayi;</para>
  <para style="q1" vid="PRO 6:16">wi sèt menm ki abominab devan l:<verse eid="PRO 6:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17"/>Zye ògeye, <note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="PSA 31:18">Sòm 31:18</ref></char></note>yon lang k ap bay manti,</para>
  <para style="q1" vid="PRO 6:17">avèk men ki vèse san inosan,<verse eid="PRO 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18"/>Yon kè ki divize plan mechan yo,</para>
  <para style="q1" vid="PRO 6:18">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:18 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:16">Pwov 1:16</ref> </char>
    </note>pye ki kouri vit pou jwenn mal,<verse eid="PRO 6:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19"/>Yon <note caller="+" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="PSA 27:1">Sòm 27:1</ref></char></note>fo temwen ki bay manti,</para>
  <para style="q1" vid="PRO 6:19">ak yon moun ki gaye konfli pami frè yo.<verse eid="PRO 6:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:20 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:1">Ef 6:1</ref>
      </char>
    </note>Fis mwen an, swiv lòd a papa ou</para>
  <para style="q1" vid="PRO 6:20">e pa abandone enstriksyon manman ou.<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:21 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:3">Pwov 3:3</ref>
      </char>
    </note>Mare yo tout tan sou kè ou;</para>
  <para style="q1" vid="PRO 6:21">mare yo nan kou ou.<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>Lè ou <note caller="+" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="PRO 3:23">Pwov 3:23</ref></char></note>mache toupatou, yo va gide ou.</para>
  <para style="q1" vid="PRO 6:22">Lè ou dòmi, yo va veye sou ou.</para>
  <para style="q1" vid="PRO 6:22">Epi lè ou leve, yo va pale avèk ou.<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>Paske <note caller="+" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="PSA 19:8">Sòm 19:8</ref></char></note>kòmandman an se yon lanp,</para>
  <para style="q1" vid="PRO 6:23">e enstriksyon li se limyè.</para>
  <para style="q1" vid="PRO 6:23">Konsa, repwòch ki disipline a se chemen lavi a<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>pou <note caller="+" style="x"><char style="xo" closed="false">6:24 </char><char style="xt" closed="false"><ref loc="PRO 5:3">Pwov 5:3</ref></char></note>anpeche ou rive nan fanm movèz vi a,</para>
  <para style="q1" vid="PRO 6:24">a lang glise de fanm adiltè a.<verse eid="PRO 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:25 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:28">Mat 5:28</ref>
      </char>
    </note>Pa dezire bote li nan kè ou,</para>
  <para style="q1" vid="PRO 6:25">ni kite li kapte ou avèk pòpyè zye li.<verse eid="PRO 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>Paske akoz yon pwostitiye,</para>
  <para style="q1" vid="PRO 6:26">yon gason redwi a yon mòso pen.</para>
  <para style="q1" vid="PRO 6:26">Yon fanm adiltè fè lachase lavi presye.<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>Èske yon nonm kab mete dife poze antre janm li yo</para>
  <para style="q1" vid="PRO 6:27">pou rad li pa brile?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>Oswa èske yon nonm kab mache sou chabon limen,</para>
  <para style="q1" vid="PRO 6:28">san ke pye l pa brile?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>Se konsa li ye ak yon nonm ki</para>
  <para style="q1" vid="PRO 6:29">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:29 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 18:6">Éz 18:6</ref>
      </char>
    </note>antre nan madanm vwazen li.</para>
  <para style="q1" vid="PRO 6:29">Nenpòt moun ki manyen l p ap sòti san pinisyon.<verse eid="PRO 6:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>Pèsòn pa meprize yon vòlè</para>
  <para style="q1" vid="PRO 6:30">kap vòlè pou l kab <note caller="+" style="x"><char style="xo" closed="false">6:30 </char><char style="xt" closed="false"><ref loc="JOB 38:39">Job 38:39</ref></char></note>satisfè grangou.<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>Men si pa aza, li jwenn li, la oblije</para>
  <para style="q1" vid="PRO 6:31">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:31 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 22:1-4">Egz 22:1-4</ref>
      </char>
    </note>repeye li sèt fwa.</para>
  <para style="q1" vid="PRO 6:31">Lap oblije bay tout sa li posede lakay li.<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>Sila ki fè adiltè ak yon fanm manke sajès;</para>
  <para style="q1" vid="PRO 6:32">nonm nan ki fè sa a, <note caller="+" style="x"><char style="xo" closed="false">6:32 </char><char style="xt" closed="false"><ref loc="PRO 7:22-23">Pwov 7:22-23</ref></char></note> detwi pwòp nanm li.<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>L ap twouve blesi ak gwo wont,</para>
  <para style="q1" vid="PRO 6:33">e repwòch li p ap efase menm.<verse eid="PRO 6:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>Paske <note caller="+" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="PRO 27:4">Pwov 27:4</ref></char></note>jalouzi fè laraj nan yon nonm;</para>
  <para style="q1" vid="PRO 6:34">li p ap fè gras nan jou vanjans lan.<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>Li p ap dakò dedonmaje ak ranson,</para>
  <para style="q1" vid="PRO 6:35">ni li p ap satisfè malgre ou fè li anpil kado.<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1"/>Fis mwen an, <note caller="+" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="PRO 2:1">Pwov 2:1</ref></char></note>kenbe pawòl mwen yo</para>
  <para style="q1" vid="PRO 7:1">e kache kòmandman mwen yo anndan ou.<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>Kenbe kòmandman mwen yo pou viv,</para>
  <para style="q1" vid="PRO 7:2">ak enstriksyon mwen yo</para>
  <para style="q1" vid="PRO 7:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">7:2 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:10">Det 32:10</ref>
      </char>
    </note>kon de grenn zye nan tèt ou.<verse eid="PRO 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3"/>Mare yo sou dwèt ou;</para>
  <para style="q1" vid="PRO 7:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">7:3 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:3">Pwov 3:3</ref>
      </char>
    </note>ekri yo sou tablo a kè ou.<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>Di a sajès: “Se ou ki sè mwen,”</para>
  <para style="q1" vid="PRO 7:4">e rele sajès pi bon zanmi ou,<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>Pou li kab anpeche ou ale</para>
  <para style="q1" vid="PRO 7:5">jwenn ak yon fanm adiltè;</para>
  <para style="q1" vid="PRO 7:5">yon fanm etranje a ki fè flate ak pawòl li.<verse eid="PRO 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>Paske bo fenèt lakay mwen,</para>
  <para style="q1" vid="PRO 7:6">mwen te gade <note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="PRO 6:32">Pwov 6:32</ref> </char></note>nan fant fenèt mwen an.<verse eid="PRO 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7"/>Konsa, mwen te wè pami moun <note caller="+" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="PRO 1:22">Pwov 1:22</ref></char></note>sòt yo,</para>
  <para style="q1" vid="PRO 7:7">e te rekonèt pami jenn yo,</para>
  <para style="q1" vid="PRO 7:7">yon jennonm ki te manke bon sans;<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>ki t ap pase nan lari a toupre</para>
  <para style="q1" vid="PRO 7:8">kwen kay fanm nan.</para>
  <para style="q1" vid="PRO 7:8">Konsa, li pran chemen pou rive <note caller="+" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="PRO 7:27">Pwov 7:27</ref></char></note>lakay li,<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>nan solèy kouche a, nan aswè,</para>
  <para style="q1" vid="PRO 7:9">nan mitan lannwit ak nan fènwa.<verse eid="PRO 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10"/>Epi gade, yon fanm vin pwoche li</para>
  <para style="q1" vid="PRO 7:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">7:10 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 38:14-15">Jen 38:14-15</ref>
      </char>
    </note>abiye kon pwostitiye ak riz nan kè l.<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>Li parèt plen kouraj nan rebelyon li.</para>
  <para style="q1" vid="PRO 7:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">7:11 </char>
      <char style="xt" closed="false">
        <ref loc="1TI 5:13">I Tim 5:13</ref>
      </char>
    </note>Pye li pa rete lakay li.<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>Koulye a nan lari yo, koulye a nan plas yo,</para>
  <para style="q1" vid="PRO 7:12">lap <note caller="+" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="PRO 23:28">Pwov 23:28</ref></char></note>kache tan nan tout kwen.<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>Konsa, li sezi li, bo li;</para>
  <para style="q1" vid="PRO 7:13">e ak <note caller="+" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="PRO 21:29">Pwov 21:29</ref></char></note>figi byen ranje, li di li:<verse eid="PRO 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14"/>“Mwen te prèt pou ale fè ofrann lapè yo.</para>
  <para style="q1" vid="PRO 7:14">Se jodi a, mwen <note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="LEV 7:16">Lev 7:16</ref> </char></note>fin peye ve mwen yo.<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>Konsa, mwen te vin rankontre ou,</para>
  <para style="q1" vid="PRO 7:15">pou jwenn prezans ou;</para>
  <para style="q1" vid="PRO 7:15">e konsa, mwen te twouve ou.<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>Mwen byen ranje kabann mwen ak kouvèti;</para>
  <para style="q1" vid="PRO 7:16">avèk bèl <note caller="+" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="ISA 19:9">És 19:9</ref></char></note>dra Égypte yo.<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>Mwen te flite kabann nan ak pafen</para>
  <para style="q1" vid="PRO 7:17">flè jasmen, lwil womaren ak <note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="EXO 30:23">Egz 30:23</ref> </char></note>kanèl.<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>Vini, annou bwè ladann</para>
  <para style="q1" vid="PRO 7:18">e fè lanmou jis rive nan maten.</para>
  <para style="q1" vid="PRO 7:18">Annou fè kè nou kontan ak doudous nou yo.<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>Paske mari m pa lakay la;</para>
  <para style="q1" vid="PRO 7:19">li ale nan yon gran vwayaj.<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>Li te pran yon sak lajan avè l.</para>
  <para style="q1" vid="PRO 7:20">Jis rive nan plèn lin, l ap retounen lakay.”<verse eid="PRO 7:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21"/>Ak anpil ankourajman, li atire li;</para>
  <para style="q1" vid="PRO 7:21">avèk <note caller="+" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="PRO 5:3">Pwov 5:3</ref></char></note>lèv a flatè, li sedwi li.<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>Sibitman, li swiv li tankou</para>
  <para style="q1" vid="PRO 7:22">yon bèf k ap monte labatwa,</para>
  <para style="q1" vid="PRO 7:22">tankou moun sòt</para>
  <para style="q1" vid="PRO 7:22">kab mache rive nan ne koulan an.<verse eid="PRO 7:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23"/>Jiskaske yon flèch frennen li nan fwa l;</para>
  <para style="q1" vid="PRO 7:23">tankou yon <note caller="+" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="ECC 9:12">Ekl 9:12</ref></char></note>zwazo k ap fè vit pou rive nan pèlen.</para>
  <para style="q1" vid="PRO 7:23">Se konsa, li pa konnen ke sa va koute lavi li.<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24"/>Alò, pou sa, fis yo, <note caller="+" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="PRO 5:7">Pwov 5:7</ref></char></note>koute mwen</para>
  <para style="q1" vid="PRO 7:24">e okipe pawòl a bouch mwen yo.<verse eid="PRO 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25"/>Pa kite kè ou <note caller="+" style="x"><char style="xo" closed="false">7:25 </char><char style="xt" closed="false"><ref loc="PRO 5:8">Pwov 5:8</ref></char></note>vire akote nan chemen li yo!</para>
  <para style="q1" vid="PRO 7:25">Pa vin antre egare nan wout li yo!<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>Paske, anpil se viktim ke li deja jete anba yo;</para>
  <para style="q1" vid="PRO 7:26">e <note caller="+" style="x"><char style="xo" closed="false">7:26 </char><char style="xt" closed="false"><ref loc="PRO 9:18">Pwov 9:18</ref></char></note>anpil se sila ki te mouri akoz li.<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:27 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:18">Pwov 2:18</ref>
      </char>
    </note>Lakay li nan wout Sejou mò yo,</para>
  <para style="q1" vid="PRO 7:27">k ap desann nan chanm lanmò yo.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>Èske <note caller="+" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="PRO 1:20-21">Pwov 1:20-21</ref></char></note>sajès pa rele?</para>
  <para style="q1" vid="PRO 8:1">Èske bon konprann pa leve vwa li?<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>Anlè <note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="PRO 9:3-14">Pwov 9:3-14</ref></char></note>wotè akote chemen yo, akote kafou wout yo;</para>
  <para style="q1" vid="PRO 8:2">la li pran pozisyon li.<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>Akote <note caller="+" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="JOB 29:7">Job 29:7</ref></char></note>pòtay yo, nan ouvèti vil la,</para>
  <para style="q1" vid="PRO 8:3">nan antre pòtay yo, li kriye fò:<verse eid="PRO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4"/>Vè nou menm, O mesye yo, mwen rele!</para>
  <para style="q1" vid="PRO 8:4">Konsa, vwa m se pou fis a lòm yo.<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>O moun ensanse yo, vin aprann pridans!</para>
  <para style="q1" vid="PRO 8:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">8:5 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:22-32">Pwov 1:22-32</ref> </char>
    </note>Moun fou yo, vin konprann sajès!<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>Koute mwen, paske mwen va pale gwo bagay.</para>
  <para style="q1" vid="PRO 8:6">Lè lèv mwen louvri, <note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="PRO 23:16">Pwov 23:16</ref> </char></note>y ap devwale bagay ki kòrèk.<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>Paske <note caller="+" style="x"><char style="xo" closed="false">8:7 </char><char style="xt" closed="false"><ref loc="PSA 37:30">Sòm 37:30</ref></char></note>bouch mwen va eksprime verite;</para>
  <para style="q1" vid="PRO 8:7">epi mechanste vin abominab a lèv mwen.<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>Tout pawòl a bouch mwen yo dwat;</para>
  <para style="q1" vid="PRO 8:8">nanpwen anyen <note caller="+" style="x"><char style="xo" closed="false">8:8 </char><char style="xt" closed="false"><ref loc="DEU 32:5">Det 32:5</ref></char></note>kwochi oswa pèvès ladann yo.<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>Yo byen dwat pou sila ki konprann nan,</para>
  <para style="q1" vid="PRO 8:9">e kòrèk pou sila ki <note caller="+" style="x"><char style="xo" closed="false">8:9 </char><char style="xt" closed="false"><ref loc="PRO 3:13">Pwov 3:13</ref> </char></note>jwenn konesans lan.<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>Pran <note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="PRO 3:14-15">Pwov 3:14-15</ref></char></note>konsèy mwen olye ajan,</para>
  <para style="q1" vid="PRO 8:10">e konesans olye pi chwa nan lò pi.<verse eid="PRO 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>Paske, sajès <note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="JOB 28:15-18">Job 28:15-18</ref></char></note>pi bon ke bijou;</para>
  <para style="q1" vid="PRO 8:11">epi tout pi bèl bagay yo p ap kab konpare avè l.<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>Mwen se sajès. Mwen rete avèk bon konprann.</para>
  <para style="q1" vid="PRO 8:12">Konsa, mwen fè jwenn <note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="PRO 1:4">Pwov 1:4</ref></char></note>konesans ak bon sans.<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:13 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:7">Pwov 3:7</ref>
      </char>
    </note>Lakrent SENYÈ a se pou rayi mal,</para>
  <para style="q1" vid="PRO 8:13">ansanm ak ògèy, awogans, ak yon bouch pevès.<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:14 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:25">Pwov 1:25</ref>
      </char>
    </note>Konsèy ak bon sajès se pou mwen.</para>
  <para style="q1" vid="PRO 8:14">Entèlijans se non mwen. Pouvwa se pa m.<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>Akoz mwen, <note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="2CH 1:10">II Kwo 1:10</ref></char></note>wa yo vin renye;</para>
  <para style="q1" vid="PRO 8:15">e gouvènè yo fè dekrè lajistis.<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>Akoz mwen, prens ak nòb yo pran pouvwa;</para>
  <para style="q1" vid="PRO 8:16">tout moun ki fè jijman ki bon yo.<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>Mwen renmen sila ki renmen m yo.</para>
  <para style="q1" vid="PRO 8:17">
    <note caller="+" style="x">
      <char style="xo" closed="false">8:17 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:4-5">Pwov 2:4-5</ref> </char>
    </note>Sila ki chache mwen ak dilijans yo va jwenn mwen.<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:18 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:16">Pwov 3:16</ref>
      </char>
    </note>Richès ak lonè avèk m;</para>
  <para style="q1" vid="PRO 8:18">richès k ap dire ak ladwati.<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>Fwi mwen <note caller="+" style="x"><char style="xo" closed="false">8:19 </char><char style="xt" closed="false"><ref loc="JOB 28:15">Job 28:15</ref></char></note>pi bon ke lò, menm lò pi.</para>
  <para style="q1" vid="PRO 8:19">Rannman mwen pi bon ke pi bèl ajan an.<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>Mwen mache nan ladwati,</para>
  <para style="q1" vid="PRO 8:20">nan mitan wout lajistis yo,<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>Pou m bay a sila ki renmen m, richès;</para>
  <para style="q1" vid="PRO 8:21">pou m kab <note caller="+" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="PRO 24:4">Pwov 24:4</ref></char></note>ranpli kès yo.<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22"/>SENYÈ a te posede m <note caller="+" style="x"><char style="xo" closed="false">8:22 </char><char style="xt" closed="false"><ref loc="JOB 28:26-28">Job 28:26-28</ref></char></note>nan kòmansman travay pa Li;</para>
  <para style="q1" vid="PRO 8:22">menm avan zèv ansyen Li yo.<verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>Depi nan etènite, mwen te etabli,</para>
  <para style="q1" vid="PRO 8:23">depi nan kòmansman, <note caller="+" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="JHN 17:5">Jn 17:5</ref> </char></note>depi nan tan pi ansyen mond lan.<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>Lè potko gen <note caller="+" style="x"><char style="xo" closed="false">8:24 </char><char style="xt" closed="false"><ref loc="GEN 1:2">Jen 1:2</ref></char></note>pwofondè, mwen te fèt,</para>
  <para style="q1" vid="PRO 8:24">lè pa t gen sous ki t ap bonbade dlo yo.<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:25 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 15:7">Job 15:7</ref>
      </char>
    </note>Avan mòn yo te poze, avan kolin yo,</para>
  <para style="q1" vid="PRO 8:25">mwen te fèt;<verse eid="PRO 8:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26"/>pandan li potko fè tè a ak chan yo,</para>
  <para style="q1" vid="PRO 8:26">ni premye grenn pousyè mond lan.<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>Lè Li te etabli syèl yo, mwen te la,</para>
  <para style="q1" vid="PRO 8:27">lè <note caller="+" style="x"><char style="xo" closed="false">8:27 </char><char style="xt" closed="false"><ref loc="JOB 26:10">Job 26:10</ref> </char></note>Li te trase yon sèk won fas a pwofondè a,<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>lè Li te fè syèl yo anwo vin fèm,</para>
  <para style="q1" vid="PRO 8:28">lè sous nan fon yo te vin etabli,<verse eid="PRO 8:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29"/>lè Li te mete lizyè sou lanmè a pou dlo pa t vyole lòd Li,</para>
  <para style="q1" vid="PRO 8:29">lè Li te make tras <note caller="+" style="x"><char style="xo" closed="false">8:29 </char><char style="xt" closed="false"><ref loc="JOB 38:6">Job 38:6</ref></char></note>fondasyon tè a;<verse eid="PRO 8:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30"/>Nan tan sa a, mwen te akote Li,</para>
  <para style="q1" vid="PRO 8:30">yon mèt ouvriye; epi, mwen te fè L plezi tout lajounen</para>
  <para style="q1" vid="PRO 8:30">e te rejwi devan L tout tan,<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>Mwen t ap Rejwi nan mond Li a,</para>
  <para style="q1" vid="PRO 8:31">e fè <note caller="+" style="x"><char style="xo" closed="false">8:31 </char><char style="xt" closed="false"><ref loc="PSA 16:3">Sòm 16:3</ref></char></note>kè kontan nan fis a lòm yo.<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>“Alò, pou sa, fis yo, <note caller="+" style="x"><char style="xo" closed="false">8:32 </char><char style="xt" closed="false"><ref loc="PRO 5:7">Pwov 5:7</ref></char></note>koute mwen;</para>
  <para style="q1" vid="PRO 8:32">paske beni se sila ki kenbe chemen mwen yo.<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:33 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 4:1">Pwov 4:1</ref>
      </char>
    </note>Koute lenstriksyon pou ou vin saj e pa neglije l.<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:34 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:13-18">Pwov 3:13-18</ref>
      </char>
    </note>Beni se moun ki koute mwen an,</para>
  <para style="q1" vid="PRO 8:34">k ap veye chak jou nan pòtay mwen yo,</para>
  <para style="q1" vid="PRO 8:34">k ap veye kote poto pòt kay mwen an.<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>Paske sila ki twouve mwen an, jwenn lavi</para>
  <para style="q1" vid="PRO 8:35">e resevwa lonè devan SENYÈ a.<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>Men sila ki peche kont mwen an, fè pwòp tèt li mal;</para>
  <para style="q1" vid="PRO 8:36">tout sila ki rayi mwen yo, <note caller="+" style="x"><char style="xo" closed="false">8:36 </char><char style="xt" closed="false"><ref loc="PRO 21:6">Pwov 21:6</ref> </char></note>renmen lanmò.”<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1"/>Sajès <note caller="+" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="COL 3:9-10">Kol 3:9-10</ref></char></note>bati kay li a;</para>
  <para style="q1" vid="PRO 9:1">li taye sèt gwo pilye li yo.<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>Li te <note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="MAT 22:4">Mat 22:4</ref></char></note>prepare manje li,</para>
  <para style="q1" vid="PRO 9:2">li te mele diven li; anplis, li fin ranje tab li.<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>Li <note caller="+" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="PSA 68:11">Sòm 68:11</ref></char></note>voye demwazèl li yo deyò,</para>
  <para style="q1" vid="PRO 9:3">li rele soti nan anlè wotè pwent vil yo:<verse eid="PRO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4"/>“Pou sila ki ensanse a, kite li antre isit la!”</para>
  <para style="q1" vid="PRO 9:4">Pou sila ki <note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="PRO 6:32">Pwov 6:32</ref> </char></note>manke bon konprann nan, li di:<verse eid="PRO 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5"/>“Vin <note caller="+" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="SNG 5:1">Kan 5:1</ref></char></note>manje manje mwen an,</para>
  <para style="q1" vid="PRO 9:5">e bwè diven ke m te melanje a.<verse eid="PRO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6"/>Kite foli ou pou ou ka viv;</para>
  <para style="q1" vid="PRO 9:6">epi <note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="EZK 11:20">Éz 11:20</ref></char></note>avanse nan chemen bon konprann nan.”<verse eid="PRO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="PRO 23:9">Pwov 23:9</ref></char></note>korije yon mokè resevwa dezonè pou pwòp tèt li,</para>
  <para style="q1" vid="PRO 9:7">e sila ki repwoche yon nonm mechan</para>
  <para style="q1" vid="PRO 9:7">va resevwa ofans sou tèt li.<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>Pa repwoche yon mokè, sinon li va rayi ou;</para>
  <para style="q1" vid="PRO 9:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">9:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 141:5">Sòm 141:5</ref>
      </char>
    </note>repwoche yon nonm saj e li va renmen ou.<verse eid="PRO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9"/>Bay konsèy a yon nonm saj e li va vin pi saj,</para>
  <para style="q1" vid="PRO 9:9">enstwi yon nonm dwat e li va <note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="PRO 1:5">Pwov 1:5</ref></char></note>ogmante konesans li.<verse eid="PRO 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:10 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:28">Job 28:28</ref>
      </char>
    </note>Lakrent SENYÈ a se kòmansman a sajès</para>
  <para style="q1" vid="PRO 9:10">e konesans a Sila Ki Sen an se bon konprann.<verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>Paske <note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="PRO 3:16">Pwov 3:16</ref></char></note>pa mwen, jou ou yo va miltipliye,</para>
  <para style="q1" vid="PRO 9:11">e ane yo ap ogmante sou lavi ou.<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>Si ou saj, ou saj <note caller="+" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="JOB 22:2">Job 22:2</ref></char></note>pou pwòp tèt ou;</para>
  <para style="q1" vid="PRO 9:12">e si ou moke, ou pote sa a pou kont ou.<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13"/>Fanm sòt <note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="PRO 7:11">Pwov 7:11</ref></char></note>pale byen fò ak gwo vwa;</para>
  <para style="q1" vid="PRO 9:13">li bèt, e li pa konnen anyen.<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>Li chita devan pòtay lakay li,</para>
  <para style="q1" vid="PRO 9:14">sou yon chèz akote <note caller="+" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="PRO 9:3">Pwov 9:3</ref></char></note>wo plas vil yo.<verse eid="PRO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15"/>Li rele sila ki pase yo,</para>
  <para style="q1" vid="PRO 9:15">ki ap fè chemen yo dwat yo:<verse eid="PRO 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:16 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:4">Pwov 9:4</ref>
      </char>
    </note>Sila ki pa konnen anyen an,</para>
  <para style="q1" vid="PRO 9:16">kite li antre isit la.</para>
  <para style="q1" vid="PRO 9:16">Pou sila ki manke konprann nan, li di:<verse eid="PRO 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17"/>“Dlo yo vòlè dous</para>
  <para style="q1" vid="PRO 9:17">e <note caller="+" style="x"><char style="xo" closed="false">9:17 </char><char style="xt" closed="false"><ref loc="PRO 20:17">Pwov 20:17</ref></char></note>pen ki manje an sekrè byen agreyab.”<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>Men mesye a pa konnen ke se la mò yo ye a.</para>
  <para style="q1" vid="PRO 9:18">Vizitè li yo la.</para>
  <para style="q1" vid="PRO 9:18">Yo nan fon Sejou mò yo.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 10:1"/>Pwovèb a Salomon yo.</para>
  <para style="q1" vid="PRO 10:1">Yon fis ki saj fè papa li kontan,</para>
  <para style="q1" vid="PRO 10:1">men yon fis ki plen ak foli</para>
  <para style="q1" vid="PRO 10:1">se yon gwo doulè pou manman l.<verse eid="PRO 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 49:7">Sòm 49:7</ref>
      </char>
    </note>Richès ranmase pa mechanste pa reyisi,</para>
  <para style="q1" vid="PRO 10:2">men ladwati delivre soti nan lanmò.<verse eid="PRO 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3"/>SENYÈ a p ap kite moun ladwati yo grangou,</para>
  <para style="q1" vid="PRO 10:3">men l ap rejte lanvi mechan an.<verse eid="PRO 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>Malere se sila ki travay ak men lach;</para>
  <para style="q1" vid="PRO 10:4">men lamen moun dilijan an, anrichi.<verse eid="PRO 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>Sila ki fè rekòlt nan gran sezon an a,</para>
  <para style="q1" vid="PRO 10:5">se yon fis ki aji ak sajès;</para>
  <para style="q1" vid="PRO 10:5">men sila ki dòmi nan lè rekòlt la,</para>
  <para style="q1" vid="PRO 10:5">fè gwo wont.<verse eid="PRO 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6"/>Benediksyon se sou tèt a moun dwat la;</para>
  <para style="q1" vid="PRO 10:6">men <note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="PRO 10:11">Pwov 10:11</ref></char></note>bouch mechan an kache vyolans.<verse eid="PRO 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>Memwa a moun dwat la beni;</para>
  <para style="q1" vid="PRO 10:7">men <note caller="+" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="PSA 9:5">Sòm 9:5</ref> </char></note>non mechan an vin pouri.<verse eid="PRO 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:8 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:8">Pwov 9:8</ref>
      </char>
    </note>Saj nan kè yo va resevwa lòd chèf la;</para>
  <para style="q1" vid="PRO 10:8">men yon moun fou ki pale anpil ap pèdi.<verse eid="PRO 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>Sila ki mache ak entegrite a, mache an sekirite;</para>
  <para style="q1" vid="PRO 10:9">men sila <note caller="+" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="PRO 26:6">Pwov 26:6</ref> </char></note>ki fè wout kwochi a va vin dekouvri.<verse eid="PRO 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>Sila <note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="PSA 35:19">Sòm 35:19</ref></char></note>ki bat zye a, koze pwoblèm,</para>
  <para style="q1" vid="PRO 10:10">e moun fou a ki pale anpil, fè dega.<verse eid="PRO 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:30">Sòm 37:30</ref>
      </char>
    </note>Bouch a moun dwat se yon fontèn dlo lavi,</para>
  <para style="q1" vid="PRO 10:11">men bouch a mechan an kache vyolans.<verse eid="PRO 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>Rayisman pwovoke konfli;</para>
  <para style="q1" vid="PRO 10:12">men lanmou kouvri tout fot.<verse eid="PRO 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>Sou <note caller="+" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="PRO 10:31">Pwov 10:31</ref></char></note>lèv a moun ki konn disène, nou twouve sajès;</para>
  <para style="q1" vid="PRO 10:13">men gen baton pou do a sila ki manke konprann nan.<verse eid="PRO 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14"/>Moun saj yo ranmase konesans;</para>
  <para style="q1" vid="PRO 10:14">men ak <note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="PRO 10:8-10">Pwov 10:8-10</ref> </char></note>bouch moun fou a, destriksyon an toupre.<verse eid="PRO 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>Byen a moun rich se yon sitadèl pou li.</para>
  <para style="q1" vid="PRO 10:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">10:15 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:7">Pwov 19:7</ref>
      </char>
    </note> Sa ki detwi malere a se mizè.<verse eid="PRO 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:16 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:18-19">Pwov 11:18-19</ref>
      </char>
    </note>Salè a moun dwat se lavi;</para>
  <para style="q1" vid="PRO 10:16">revni a mechan an se pinisyon.<verse eid="PRO 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>Sila ki swiv enstriksyon an, <note caller="+" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="PRO 6:23">Pwov 6:23</ref></char></note>sou wout lavi;</para>
  <para style="q1" vid="PRO 10:17">men sila ki pa tande repwòch la vin egare nèt.<verse eid="PRO 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>Sila <note caller="+" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="PRO 26:24">Pwov 26:24</ref></char></note>ki kache rayisman an gen lèv k ap bay manti;</para>
  <para style="q1" vid="PRO 10:18">e sila ki gaye difamasyon an se yon moun fou.<verse eid="PRO 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>Lè gen anpil pawòl, transgresyon pa kab evite;</para>
  <para style="q1" vid="PRO 10:19">men <note caller="+" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="PRO 17:27">Pwov 17:27</ref></char></note>sila ki frennen lèv li gen sajès.<verse eid="PRO 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>Lang a moun dwat yo se tankou <note caller="+" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="PRO 8:19">Pwov 8:19</ref></char></note>ajan pi chwazi a;</para>
  <para style="q1" vid="PRO 10:20">men kè a mechan an vo piti.<verse eid="PRO 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:21 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:11">Pwov 10:11</ref>
      </char>
    </note>Lèv a moun dwat yo fè anpil moun manje;</para>
  <para style="q1" vid="PRO 10:21">men moun fou yo mouri akoz mank bon konprann.<verse eid="PRO 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>Benediksyon SENYÈ a fè moun rich;</para>
  <para style="q1" vid="PRO 10:22">konsa li pa mele ak chagren.<verse eid="PRO 10:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>Fè mal se tankou fè spò pou moun san konprann nan;</para>
  <para style="q1" vid="PRO 10:23">e se konsa sajès la ye pou moun entèlijan an.<verse eid="PRO 10:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>Sa ke mechan an pè a, ap rive sou li;</para>
  <para style="q1" vid="PRO 10:24">men <note caller="+" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="PSA 145:19">Sòm 145:19</ref></char></note>sa ke moun dwat la vle, va vin reyisi.<verse eid="PRO 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>Lè toubiyon an fin pase, mechan an vin disparèt;</para>
  <para style="q1" vid="PRO 10:25">men moun dwat la gen yon fondasyon etènèl.<verse eid="PRO 10:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>Tankou vinèg anba dan ak lafimen nan zye;</para>
  <para style="q1" vid="PRO 10:26">se konsa <note caller="+" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="PRO 26:6">Pwov 26:6</ref></char></note>parese a ye pou sila ki voye li yo.<verse eid="PRO 10:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:27 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:2">Pwov 3:2</ref>
      </char>
    </note>Lakrent SENYÈ a pwolonje lavi;</para>
  <para style="q1" vid="PRO 10:27">men lane mechan yo va kout.<verse eid="PRO 10:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>Lespwa a moun dwat la se kè kontan;</para>
  <para style="q1" vid="PRO 10:28">men <note caller="+" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="JOB 8:13">Job 8:13</ref> </char></note>entansyon mechan an va peri.<verse eid="PRO 10:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>Chemen Bondye a se yon sitadèl pou moun dwat yo;</para>
  <para style="q1" vid="PRO 10:29">men <note caller="+" style="x"><char style="xo" closed="false">10:29 </char><char style="xt" closed="false"><ref loc="PRO 21:15">Pwov 21:15</ref> </char></note>destriksyon nèt pou tout ouvriye inikite yo.<verse eid="PRO 10:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>Moun ladwati a p ap janm souke;</para>
  <para style="q1" vid="PRO 10:30">men <note caller="+" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="PRO 2:22">Pwov 2:22</ref></char></note>mechan yo p ap demere nan peyi a.<verse eid="PRO 10:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:31 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:30">Sòm 37:30</ref>
      </char>
    </note>Bouch a moun dwat la koule ak sajès;</para>
  <para style="q1" vid="PRO 10:31">men lang pèvès la vin koupe.<verse eid="PRO 10:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>Lèv a moun dwat yo fè parèt <note caller="+" style="x"><char style="xo" closed="false">10:32 </char><char style="xt" closed="false"><ref loc="ECC 12:10">Ekl 12:10</ref></char></note>sa ki bon;</para>
  <para style="q1" vid="PRO 10:32">men bouch a mechan an, sa ki pèvèti.<verse eid="PRO 10:32"/></para>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>Yon <note caller="+" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="LEV 19:35-36">Lev 19:35-36</ref></char></note>fo balans se abominasyon a SENYÈ a;</para>
  <para style="q1" vid="PRO 11:1">men yon pwa ki jis se plezi Li.<verse eid="PRO 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>Lè <note caller="+" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="PRO 16:18">Pwov 16:18</ref></char></note>ògèy vin monte, dezonè vin swiv;</para>
  <para style="q1" vid="PRO 11:2">men avèk moun enb lan, se sajès.<verse eid="PRO 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>Entegrite a moun dwat la va gide yo;</para>
  <para style="q1" vid="PRO 11:3">men <note caller="+" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="PRO 19:3">Pwov 19:3</ref> </char></note>koripsyon a sila ki fè konplo a va detwi yo.<verse eid="PRO 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>Richès pa gen avantaj nan jou jijman an;</para>
  <para style="q1" vid="PRO 11:4">men <note caller="+" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="GEN 7:1">Jen 7:1</ref> </char></note>ladwati va delivre moun soti nan lanmò.<verse eid="PRO 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>Ladwati a sila ki san tò a va fè wout li vin swa;</para>
  <para style="q1" vid="PRO 11:5">men mechan an va tonbe akoz pwòp inikite pa Li.<verse eid="PRO 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6"/>Ladwati a moun dwat yo va delivre yo;</para>
  <para style="q1" vid="PRO 11:6">men moun trèt yo <note caller="+" style="x"><char style="xo" closed="false">11:6 </char><char style="xt" closed="false"><ref loc="PSA 7:15-16">Sòm 7:15-16</ref></char></note>va kenbe pa pwòp vorasite yo.<verse eid="PRO 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7"/>Lè yon nonm mechan mouri,</para>
  <para style="q1" vid="PRO 11:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">11:7 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:28">Pwov 10:28</ref>
      </char>
    </note>sa li anvizaje a mouri avè l.<verse eid="PRO 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8"/>Moun dwat la va delivre soti nan twoub;</para>
  <para style="q1" vid="PRO 11:8">men mechan an va pran plas li.<verse eid="PRO 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9"/>Avèk bouch li, moun san Bondye a detwi vwazen li;</para>
  <para style="q1" vid="PRO 11:9">men ak konesans, moun dwat yo va delivre.<verse eid="PRO 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10"/>Lè sa <note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="PRO 28:12">Pwov 28:12</ref></char></note>ale byen ak moun dwat yo, vil la fè rejwisans;</para>
  <para style="q1" vid="PRO 11:10">e lè mechan yo peri, gen gwo kri lajwa.<verse eid="PRO 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11"/>Avèk benediksyon a moun dwat yo, yon vil vin leve wo;</para>
  <para style="q1" vid="PRO 11:11">men avèk bouch a mechan yo, li vin chire nèt.<verse eid="PRO 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12"/>Sila ki meprize vwazen li an, manke bon tèt;</para>
  <para style="q1" vid="PRO 11:12">men yon nonm ak bon konprann pa pale menm.<verse eid="PRO 11:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13"/>Sila ki mache toupatou tankou rapòte, revele sekrè yo;</para>
  <para style="q1" vid="PRO 11:13">men sila ki dign de konfyans sere yon bagay.<verse eid="PRO 11:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14"/>Kote ki pa gen <note caller="+" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="PRO 15:22">Pwov 15:22</ref></char></note>gid, moun yo tonbe;</para>
  <para style="q1" vid="PRO 11:14">men ak anpil konseye, gen viktwa.<verse eid="PRO 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15"/>Sila ki se <note caller="+" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="PRO 6:1">Pwov 6:1</ref></char></note>garanti pou yon moun li pa konnen,</para>
  <para style="q1" vid="PRO 11:15">va vrèman soufri pou sa a;</para>
  <para style="q1" vid="PRO 11:15">men sila ki rayi vin yon garanti va asire.<verse eid="PRO 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16"/>Yon <note caller="+" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="PRO 31:28-30">Pwov 31:28-30</ref></char></note>fanm ak gras twouve onè;</para>
  <para style="q1" vid="PRO 11:16">e mesye san prensip yo twouve richès.<verse eid="PRO 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17"/>Yon nonm ki fè <note caller="+" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="MAT 5:7">Mat 5:7</ref></char></note>gras fè byen pou pwòp tèt li;</para>
  <para style="q1" vid="PRO 11:17">men yon nonm mechan fè tèt li mal.<verse eid="PRO 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18"/>Mechan an ranmase salè li nan koken;</para>
  <para style="q1" vid="PRO 11:18">men sila ki <note caller="+" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="HOS 10:12">Os 10:12</ref></char></note>simen ladwati a, va twouve vrè rekonpans lan.<verse eid="PRO 11:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19"/>Sila ki fidèl nan ladwati a va jwenn lavi,</para>
  <para style="q1" vid="PRO 11:19">e sila ki pouswiv mal la va jwenn pwòp lanmò pa li.<verse eid="PRO 11:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20"/>Sila ki pèvès nan kè yo abominab a SENYÈ a;</para>
  <para style="q1" vid="PRO 11:20">men sila ki san tò nan chemen yo, se <note caller="+" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="1CH 29:17">I Kwo 29:17</ref></char></note>plezi Li.<verse eid="PRO 11:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21"/>Anverite, moun mechan an p ap chape anba pinisyon;</para>
  <para style="q1" vid="PRO 11:21">men desandan a moun dwat yo va delivre.<verse eid="PRO 11:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>Tankou yon bag fèt an lò nan nen a kochon,</para>
  <para style="q1" vid="PRO 11:22">se konsa yon bèl fanm ki manke bon sans.<verse eid="PRO 11:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23"/>Dezi a moun dwat la se sèlman sa ki bon;</para>
  <para style="q1" vid="PRO 11:23">men <note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="PRO 10:28">Pwov 10:28</ref></char></note>dezi a mechan an mennen jijman.<verse eid="PRO 11:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24"/>Gen yon moun ki separe bay; malgre sa li vin ogmante plis.</para>
  <para style="q1" vid="PRO 11:24">Genyen ki refize bay sa ke li dwe, e sa fè l vin manke.<verse eid="PRO 11:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25"/>Sila <note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="PRO 3:9-10">Pwov 3:9-10</ref></char></note>ki bay ak bon kè a va pwospere;</para>
  <para style="q1" vid="PRO 11:25">sila ki bay dlo a va jwenn dlo kont pou tèt li.<verse eid="PRO 11:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26"/>Sila ki refize bay manje sereyal la, <note caller="+" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="PRO 24:24">Pwov 24:24</ref></char></note>va modi pa pèp la;</para>
  <para style="q1" vid="PRO 11:26">men benediksyon va tonbe sou sila ki vann li an.<verse eid="PRO 11:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27"/>Sila ki chache sa ki bon an, chache favè Bondye;</para>
  <para style="q1" vid="PRO 11:27">men <note caller="+" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="EST 7:10">Est 7:10</ref></char></note>sila ki chache mal la,</para>
  <para style="q1" vid="PRO 11:27">se mal la k ap vin jwenn li.<verse eid="PRO 11:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="PSA 49:6">Sòm 49:6</ref></char></note>mete konfyans nan richès li va vin tonbe;</para>
  <para style="q1" vid="PRO 11:28">men moun dwat la va grandi tankou fèy vèt sou pyebwa.<verse eid="PRO 11:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29"/>Sila ki mennen twoub lakay li va eritye van;</para>
  <para style="q1" vid="PRO 11:29">e san konprann nan va vin sèvitè a sila ki gen kè saj la.<verse eid="PRO 11:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30"/>Fwi ladwati a se yon pyebwa lavi,</para>
  <para style="q1" vid="PRO 11:30">e <note caller="+" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="PRO 14:25">Pwov 14:25</ref> </char></note>sila ki saj va sove nanm yo.<verse eid="PRO 11:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31"/>Si <note caller="+" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="2SA 22:21-25">II Sam 22:21-25</ref></char></note>moun dwat yo twouve rekonpans yo sou latè,</para>
  <para style="q1" vid="PRO 11:31">konbyen anplis pou mechan an avèk pechè a!<verse eid="PRO 11:31"/></para>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1"/>Nenpòt moun ki renmen disiplin, renmen konesans,</para>
  <para style="q1" vid="PRO 12:1">men sila ki rayi korije a, se bèt.<verse eid="PRO 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2"/>Yon <note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="PRO 3:4">Pwov 3:4</ref></char></note>bon moun va jwenn favè SENYÈ a;</para>
  <para style="q1" vid="PRO 12:2">men Bondye va kondane sila ki fè manèv mechanste a.<verse eid="PRO 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3"/>Yon nonm p ap etabli ak mal la;</para>
  <para style="q1" vid="PRO 12:3">men rasin <note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="PRO 10:25">Pwov 10:25</ref></char></note>moun dwat la p ap sòti menm.<verse eid="PRO 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>Yon bon madanm se kouwòn a mari li;</para>
  <para style="q1" vid="PRO 12:4">men sila ki fè l wont lan se tankou <note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="PRO 14:30">Pwov 14:30</ref> </char></note>pouriti nan zo li.<verse eid="PRO 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5"/>Panse a moun dwat yo jis;</para>
  <para style="q1" vid="PRO 12:5">men konsèy a mechan yo se desepsyon.<verse eid="PRO 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6"/>Pawòl a mechan yo kouche tann pyèj pou vèse san;</para>
  <para style="q1" vid="PRO 12:6">men <note caller="+" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="PRO 14:3">Pwov 14:3</ref></char></note>bouch moun dwat yo va delivre yo.<verse eid="PRO 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7"/>Mechan yo va boulvèse e vin disparèt;</para>
  <para style="q1" vid="PRO 12:7">men kay a moun dwat yo va kanpe.<verse eid="PRO 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8"/>Yon nonm ap twouve glwa selon entèlijans li;</para>
  <para style="q1" vid="PRO 12:8">men sila ak panse pèvès la va meprize.<verse eid="PRO 12:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9"/>Meyè se sila ki enkoni a, men gen sèvitè,</para>
  <para style="q1" vid="PRO 12:9">pase sila ki onore pwòp tèt li e manke pen an.<verse eid="PRO 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10"/>Yon nonm ladwati gen respè pou lavi a bèt li;</para>
  <para style="q1" vid="PRO 12:10">men konpasyon a mechan an se mechanste.<verse eid="PRO 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11"/>Sila <note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="PRO 28:19">Pwov 28:19</ref></char></note>ki raboure tè li a va gen anpil pen;</para>
  <para style="q1" vid="PRO 12:11">men sila ki swiv bagay san valè yo manke bon konprann.<verse eid="PRO 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12"/>Moun mechan an vle pran piyaj a mechan yo;</para>
  <para style="q1" vid="PRO 12:12">men rasin ladwati yo <note caller="+" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="PRO 11:30">Pwov 11:30</ref> </char></note>va donnen fwi li.<verse eid="PRO 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13"/>Yon moun mechan pyeje pa transgresyon lèv li;</para>
  <para style="q1" vid="PRO 12:13">men moun dwat la va evite pwoblèm.<verse eid="PRO 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14"/>Yon nonm va satisfè avèk sa ki bon kon fwi a pawòl li,</para>
  <para style="q1" vid="PRO 12:14">e zèv lamen a yon nonm va retounen kote li.<verse eid="PRO 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15"/>Chemen a yon moun fou bon nan zye li;</para>
  <para style="q1" vid="PRO 12:15">men yon nonm saj koute konsèy.<verse eid="PRO 12:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>Lè yon moun fou vekse, ou konnen sa vit;</para>
  <para style="q1" vid="PRO 12:16">men sila ki saj la evite wont.<verse eid="PRO 12:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17"/>Sila ki pale verite a pale sa ki dwat;</para>
  <para style="q1" vid="PRO 12:17">men yon fo temwen twonpe.<verse eid="PRO 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>Genyen yon moun ki pale san pridans</para>
  <para style="q1" vid="PRO 12:18">tankou sila k ap goumen ak nepe yo;</para>
  <para style="q1" vid="PRO 12:18">men lang a saj la pote gerizon.<verse eid="PRO 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19"/>Lèv verite yo va etabli pou tout tan;</para>
  <para style="q1" vid="PRO 12:19">men <note caller="+" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="PSA 52:4-5">Sòm 52:4-5</ref></char></note>lang ki bay manti a rete pou yon moman.<verse eid="PRO 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20"/>Desepsyon se nan kè a sila k ap fè manèv mechanste yo;</para>
  <para style="q1" vid="PRO 12:20">men konseye lapè yo gen jwa.<verse eid="PRO 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:21 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:10">Sòm 91:10</ref>
      </char>
    </note>Nanpwen mal ki rive moun dwat yo;</para>
  <para style="q1" vid="PRO 12:21">men mechan yo plen ak twoub.<verse eid="PRO 12:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:22 </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:15">Rev 22:15</ref>
      </char>
    </note>Lèv ki manti a abominab a SENYÈ a;</para>
  <para style="q1" vid="PRO 12:22">men sila ki aji nan fidelite, se plezi Li.<verse eid="PRO 12:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23"/>Yon moun <note caller="+" style="x"><char style="xo" closed="false">12:23 </char><char style="xt" closed="false"><ref loc="PRO 10:14">Pwov 10:14</ref></char></note>pridan kache sa li konnen;</para>
  <para style="q1" vid="PRO 12:23">men kè moun san konprann pale jis nan foli.<verse eid="PRO 12:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24"/>Men a dilijan yo va kòmande;</para>
  <para style="q1" vid="PRO 12:24">men parese a va <note caller="+" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="GEN 49:15">Jen 49:15</ref></char></note>fè kòve.<verse eid="PRO 12:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25"/>Gwo pwoblèm nan kè a yon moun peze li desann;</para>
  <para style="q1" vid="PRO 12:25">men yon <note caller="+" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="ISA 50:4">És 50:4</ref> </char></note>bon pawòl fè l leve.<verse eid="PRO 12:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26"/>Moun ladwati a se yon gid a vwazen li;</para>
  <para style="q1" vid="PRO 12:26">men chemen a mechan fè yo egare.<verse eid="PRO 12:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27"/>Yon nonm parese pa menm boukannen bèt lachas li,</para>
  <para style="q1" vid="PRO 12:27">men pi presye nan sa yon nonm <note caller="+" style="x"><char style="xo" closed="false">12:27 </char><char style="xt" closed="false"><ref loc="PRO 10:4">Pwov 10:4</ref></char></note>posede se dilijans.<verse eid="PRO 12:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:28 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 30:15">Det 30:15</ref>
      </char>
    </note>Nan chemen ladwati se lavi;</para>
  <para style="q1" vid="PRO 12:28">e nan wout li nanpwen lanmò.<verse eid="PRO 12:28"/></para>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1"/>Yon <note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="PRO 10:1">Pwov 10:1</ref></char></note>fis ki saj aksepte disiplin a papa l,</para>
  <para style="q1" vid="PRO 13:1">men yon mokè pa koute repwòch.<verse eid="PRO 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2"/>Fwi pawòl la ki soti nan bouch moun se rejwisans de sa ki bon;</para>
  <para style="q1" vid="PRO 13:2">men volonte moun infidèl se vyolans.<verse eid="PRO 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">13:3 </char><char style="xt" closed="false"><ref loc="PRO 18:21">Pwov 18:21</ref></char></note>kontwole bouch li, konsève lavi li;</para>
  <para style="q1" vid="PRO 13:3">sila ki ouvri lèv li byen laj va detwi nèt.<verse eid="PRO 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4"/>Nanm a parese a anvi, e li pa jwenn;</para>
  <para style="q1" vid="PRO 13:4">men nanm a moun dilijan an vin gra.<verse eid="PRO 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5"/>Yon nonm dwat <note caller="+" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="COL 3:9">Kol 3:9</ref></char></note>rayi sa ki fo;</para>
  <para style="q1" vid="PRO 13:5">men zak mechan yo degoutan e fè gwo wont.<verse eid="PRO 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6"/>Ladwati se <note caller="+" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="PRO 11:3">Pwov 11:3</ref></char></note>yon pwotèj pou sila ki san fot la;</para>
  <para style="q1" vid="PRO 13:6">men mechanste fè pechè a vin souye nèt.<verse eid="PRO 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7"/>Genyen moun ki pretann yo rich, men yo pa gen anyen;</para>
  <para style="q1" vid="PRO 13:7">yon lòt pretann li <note caller="+" style="x"><char style="xo" closed="false">13:7 </char><char style="xt" closed="false"><ref loc="LUK 12:33">Luc 12:33</ref></char></note>malere men li gen gwo richès.<verse eid="PRO 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8"/>Ranson pou lavi a yon nonm rich se richès li;</para>
  <para style="q1" vid="PRO 13:8">men malere a pa tande menas.<verse eid="PRO 13:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9"/>Limyè a moun dwat la se rejwisans;</para>
  <para style="q1" vid="PRO 13:9">men <note caller="+" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="JOB 18:5">Job 18:5</ref></char></note>lanp a mechan an va etenn.<verse eid="PRO 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10"/>Ògèy pa pote anyen sof ke konfli;</para>
  <para style="q1" vid="PRO 13:10">men sajès rete ak sila ki resevwa konsèy yo.<verse eid="PRO 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11"/>Richès ki sòti nan manti koule ale;</para>
  <para style="q1" vid="PRO 13:11">men sila ki rasanble ak men li, fè l grandi.<verse eid="PRO 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12"/>Lespwa jennen fè kè a malad;</para>
  <para style="q1" vid="PRO 13:12">men dezi acheve a se yon pyebwa lavi.<verse eid="PRO 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="NUM 15:31">Nonb 15:31</ref></char></note>meprize lenstriksyon va peye fwe a;</para>
  <para style="q1" vid="PRO 13:13">men sila ki respekte lòd yo va resevwa rekonpans li.<verse eid="PRO 13:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14"/>Lenstriksyon a saj yo se yon <note caller="+" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="PSA 10:11">Sòm 10:11</ref></char></note>fontèn dlo lavi</para>
  <para style="q1" vid="PRO 13:14">pou detounen pèlen lanmò a.<verse eid="PRO 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:15 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 111:10">Sòm 111:10</ref>
      </char>
    </note>Bon konprann pwodwi favè;</para>
  <para style="q1" vid="PRO 13:15">men chemen moun ki pa fidèl la di.<verse eid="PRO 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16"/>Tout moun ki <note caller="+" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="PRO 12:23">Pwov 12:23</ref></char></note>pridan aji ak konesans;</para>
  <para style="q1" vid="PRO 13:16">men yon moun san konprann parèt ak foli li.<verse eid="PRO 13:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17"/>Yon mesaje mechan tonbe nan advèsite;</para>
  <para style="q1" vid="PRO 13:17">men sila ki pote pawòl ak bòn fwa a, pote gerizon<verse eid="PRO 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18"/>Mizè ak wont se pou sila ki <note caller="+" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="PRO 15:5-32">Pwov 15:5-32</ref></char></note>manke disiplin nan;</para>
  <para style="q1" vid="PRO 13:18">men sila ki konsidere repwòch la va onore.<verse eid="PRO 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19"/>Yon dezi ki realize se dous a nanm nan,</para>
  <para style="q1" vid="PRO 13:19">men moun bèt pa vle kite mechanste.<verse eid="PRO 13:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:20 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:20">Pwov 2:20</ref>
      </char>
    </note>Sila ki mache ak moun saj va vin saj;</para>
  <para style="q1" vid="PRO 13:20">men bon zanmi a moun ensanse a va soufri.<verse eid="PRO 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21"/>Se malè ki kouri dèyè pechè yo;</para>
  <para style="q1" vid="PRO 13:21">men moun dwat yo va pwospere.<verse eid="PRO 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22"/>Yon bon moun va <note caller="+" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="EZR 9:12">Esd 9:12</ref></char></note>lese eritaj pou pitit pitit li;</para>
  <para style="q1" vid="PRO 13:22">men richès a pechè yo konsève pou moun dwat yo.<verse eid="PRO 13:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23"/>Gen <note caller="+" style="x"><char style="xo" closed="false">13:23 </char><char style="xt" closed="false"><ref loc="PRO 12:11">Pwov 12:11</ref></char></note>anpil manje nan tè malere a;</para>
  <para style="q1" vid="PRO 13:23">men li fin bale nèt akoz enjistis.<verse eid="PRO 13:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24"/>Sila ki ralanti baton li, rayi fis li;</para>
  <para style="q1" vid="PRO 13:24">men sila ki renmen l va ba li <note caller="+" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="DEU 8:5">Det 8:5</ref> </char></note>disiplin ak dilijans.<verse eid="PRO 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25"/>Moun dwat la gen kont pou satisfè dezi li;</para>
  <para style="q1" vid="PRO 13:25">men vant <note caller="+" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="PRO 13:18">Pwov 13:18</ref> </char></note>mechan an toujou gen bezwen.<verse eid="PRO 13:25"/></para>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="RUT 4:11">Rt 4:11</ref>
      </char>
    </note>Fanm saj la bati kay li,</para>
  <para style="q1" vid="PRO 14:1">men fanm ensanse a demoli li ak pwòp men li.<verse eid="PRO 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2"/>Sila ki mache nan ladwati a gen lakrent SENYÈ a;</para>
  <para style="q1" vid="PRO 14:2">men sila ki fè chemen <note caller="+" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="PRO 2:15">Pwov 2:15</ref> </char></note>kwochi a meprize li.<verse eid="PRO 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3"/>Nan bouch a moun sòt la, se yon baton pou do li;</para>
  <para style="q1" vid="PRO 14:3">men <note caller="+" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="PRO 12:6">Pwov 12:6</ref></char></note>lèv a saj yo va pwoteje yo.<verse eid="PRO 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>Kote nanpwen bèf, manjwa a pwòp;</para>
  <para style="q1" vid="PRO 14:4">men se fòs a bèf la ki fè richès.<verse eid="PRO 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5"/>Yon <note caller="+" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="REV 1:5">Rev 1:5</ref></char></note>temwen fidèl p ap bay manti;</para>
  <para style="q1" vid="PRO 14:5">men yon fo temwen pale manti.<verse eid="PRO 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6"/>Yon mokè chache sajès, e li pa jwenn anyen;</para>
  <para style="q1" vid="PRO 14:6">men konesans fasil pou sila ki gen bon konprann nan.<verse eid="PRO 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7"/>Kite <note caller="+" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="PRO 23:9">Pwov 23:9</ref></char></note>prezans a yon moun ensanse,</para>
  <para style="q1" vid="PRO 14:7">sinon ou p ap rekonèt pawòl a saj yo.<verse eid="PRO 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8"/>Sajès a moun rezonab la se pou l konprann chemen li;</para>
  <para style="q1" vid="PRO 14:8">men <note caller="+" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="1CO 3:19">I Kor 3:19</ref></char></note>betiz a moun ensanse a se desepsyon.<verse eid="PRO 14:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9"/>Moun ensanse kontwole peche kon jwèt;</para>
  <para style="q1" vid="PRO 14:9">men <note caller="+" style="x"><char style="xo" closed="false">14:9 </char><char style="xt" closed="false"><ref loc="PRO 3:34">Pwov 3:34</ref></char></note>pami moun dwat yo, gen bòn volonte.<verse eid="PRO 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10"/>Kè a konnen pwòp <note caller="+" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="1SA 1:10">I Sam 1:10</ref> </char></note>amètim ak bonè li;</para>
  <para style="q1" vid="PRO 14:10">men ak lòt, sa p ap pataje.<verse eid="PRO 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:11 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 8:15">Job 8:15</ref>
      </char>
    </note>Lakay mechan yo va detwi;</para>
  <para style="q1" vid="PRO 14:11">men tant a moun dwat la va fleri.<verse eid="PRO 14:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12"/>Gen yon chemen ki sanble bon pou lòm;</para>
  <para style="q1" vid="PRO 14:12">men <note caller="+" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="ROM 6:21">Wo 6:21</ref></char></note>fen li se chemen lanmò an.<verse eid="PRO 14:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13"/>Menm lè bouch ri, kè a ka gen doulè,</para>
  <para style="q1" vid="PRO 14:13">e <note caller="+" style="x"><char style="xo" closed="false">14:13 </char><char style="xt" closed="false"><ref loc="ECC 2:1-2">Ekl 2:1-2</ref></char></note>lajwa kon fini nan tristès.<verse eid="PRO 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14"/>Kè a ki pa fidèl va <note caller="+" style="x"><char style="xo" closed="false">14:14 </char><char style="xt" closed="false"><ref loc="PRO 1:31">Pwov 1:31</ref></char></note>jwen rekonpans pou pwòp chemen li;</para>
  <para style="q1" vid="PRO 14:14">men yon bon moun va rekonpanse pou sa li fè a.<verse eid="PRO 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15"/>Moun san konprann kwè nan tout bagay;</para>
  <para style="q1" vid="PRO 14:15">men yon nonm k ap refleshi veye pa li yo.<verse eid="PRO 14:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16"/>Yon nonm saj fè atansyon pou l <note caller="+" style="x"><char style="xo" closed="false">14:16 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Job 28:28</ref></char></note>vire kite mal;</para>
  <para style="q1" vid="PRO 14:16">men yon moun fou plen ògèy; li pa pè anyen.<verse eid="PRO 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17"/>Yon nonm kolerik aji nan foli,</para>
  <para style="q1" vid="PRO 14:17">e yon nonm kokèn va rayi pa lòt yo.<verse eid="PRO 14:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18"/>Moun san konprann yo gen foli kon eritaj;</para>
  <para style="q1" vid="PRO 14:18">men moun rezonab lan kouwone ak konesans.<verse eid="PRO 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:19 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:36">I Sam 2:36</ref>
      </char>
    </note>Mal la va bese devan sa ki bon an;</para>
  <para style="q1" vid="PRO 14:19">e mechan an devan pòtay a moun dwat la.<verse eid="PRO 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:20 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:7">Pwov 19:7</ref>
      </char>
    </note>Malere a vin rayi menm pa vwazen li;</para>
  <para style="q1" vid="PRO 14:20">men moun gwo kòb gen anpil zanmi.<verse eid="PRO 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21"/>Sila ki meprize vwazen li fè peche;</para>
  <para style="q1" vid="PRO 14:21">men <note caller="+" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="PSA 41:1">Sòm 41:1</ref> </char></note>sila ki fè gras a malere a, beni.<verse eid="PRO 14:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22"/>Èske sila ki <note caller="+" style="x"><char style="xo" closed="false">14:22 </char><char style="xt" closed="false"><ref loc="PSA 36:4">Sòm 36:4</ref></char></note>fòmante mechanste a, pa egare?</para>
  <para style="q1" vid="PRO 14:22">Men ladousè avèk verite se pou sa yo ki fè sa ki bon.<verse eid="PRO 14:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23"/>Nan tout travay gen pwofi;</para>
  <para style="q1" vid="PRO 14:23">men pale anpil mennen nan povrete.<verse eid="PRO 14:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:24 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:22">Pwov 10:22</ref>
      </char>
    </note>Kouwòn saj yo se richès yo;</para>
  <para style="q1" vid="PRO 14:24">men betiz moun ensanse se foli yo.<verse eid="PRO 14:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25"/>Yon vrè temwen sove lavi a moun;</para>
  <para style="q1" vid="PRO 14:25">men sila ki <note caller="+" style="x"><char style="xo" closed="false">14:25 </char><char style="xt" closed="false"><ref loc="PRO 14:5">Pwov 14:5</ref></char></note>pale manti pase moun nan betiz.<verse eid="PRO 14:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26"/>Nan <note caller="+" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="PRO 18:10">Pwov 18:10</ref></char></note>lakrent SENYÈ a, gen gwo konfyans;</para>
  <para style="q1" vid="PRO 14:26">e pitit li yo va jwenn sekou.<verse eid="PRO 14:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27"/>Lakrent SENYÈ a se yon fontèn dlo lavi,</para>
  <para style="q1" vid="PRO 14:27">pou moun ka evite pèlen lanmò yo.<verse eid="PRO 14:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28"/>Nan fòs kantite a pèp yo se glwa a yon wa,</para>
  <para style="q1" vid="PRO 14:28">men afè prens ki manke moun gate nèt.<verse eid="PRO 14:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">14:29 </char><char style="xt" closed="false"><ref loc="PRO 16:32">Pwov 16:32</ref></char></note>lan nan kòlè a, gen gwo konprann;</para>
  <para style="q1" vid="PRO 14:29">men sila ki fè fache vit, leve foli byen wo.<verse eid="PRO 14:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30"/>Yon kè trankil se lavi pou kò a;</para>
  <para style="q1" vid="PRO 14:30">men pasyon fè tout zo yo <note caller="+" style="x"><char style="xo" closed="false">14:30 </char><char style="xt" closed="false"><ref loc="PRO 12:4">Pwov 12:4</ref> </char></note>pouri.<verse eid="PRO 14:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31"/>Sila ki oprime malere a ap vekse Kreyatè li;</para>
  <para style="q1" vid="PRO 14:31">men sila ki gen bonte anvè pòv la, onore L.<verse eid="PRO 14:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32"/>Mechan an jete anba pa malfezans li;</para>
  <para style="q1" vid="PRO 14:32">men moun ladwati a gen sekou lè l mouri.<verse eid="PRO 14:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33"/>Sajès se nan kè a sila ki gen bon konprann nan;</para>
  <para style="q1" vid="PRO 14:33">menm moun ensanse yo, nan kè, yo konnen.<verse eid="PRO 14:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34"/>Ladwati leve yon nasyon;</para>
  <para style="q1" vid="PRO 14:34">men peche se yon gwo wont pou yon pèp.<verse eid="PRO 14:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35"/>Favè a wa a se anvè <note caller="+" style="x"><char style="xo" closed="false">14:35 </char><char style="xt" closed="false"><ref loc="MAT 24:45-47">Mat 24:45-47</ref></char></note>sèvitè ki aji ak sajès;</para>
  <para style="q1" vid="PRO 14:35">men kòlè li se anvè sila ki fè gwo wont.<verse eid="PRO 14:35"/></para>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1"/>Yon repons ki dous kalme kòlè;</para>
  <para style="q1" vid="PRO 15:1">men yon <note caller="+" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="1SA 25:10-13">I Sam 25:10-13</ref> </char></note>mo sevè pwovoke gwo fache.<verse eid="PRO 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:2 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:7">Pwov 15:7</ref>
      </char>
    </note>Lang a saj la gen pou mèt, konnesans;</para>
  <para style="q1" vid="PRO 15:2">men bouch a sila ki manke konprann nan eksprime foli.<verse eid="PRO 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>Zye a SENYÈ a tout kote;</para>
  <para style="q1" vid="PRO 15:3">L ap veye sa ki bon ak sa ki mal.<verse eid="PRO 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>Yon lang ki kalme se yon pyebwa lavi;</para>
  <para style="q1" vid="PRO 15:4">men si l gen desepsyon, l ap kraze lespri.<verse eid="PRO 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5"/>Yon moun ensanse refize disiplin a papa l;</para>
  <para style="q1" vid="PRO 15:5">men sila ki aksepte repwòch gen sajès.<verse eid="PRO 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>Gran richès twouve nan kay a moun dwat yo;</para>
  <para style="q1" vid="PRO 15:6">men gwo twoub se salè a mechan an.<verse eid="PRO 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>Lèv a moun saj yo gaye konesans;</para>
  <para style="q1" vid="PRO 15:7">men se pa konsa ak kè moun ensansib yo.<verse eid="PRO 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>Sakrifis a mechan an abominab a SENYÈ a;</para>
  <para style="q1" vid="PRO 15:8">men <note caller="+" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="PRO 15:29">Pwov 15:29</ref></char></note>lapriyè moun dwat yo se gwo plezi Li.<verse eid="PRO 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>Chemen mechan an abominab a SENYÈ a;</para>
  <para style="q1" vid="PRO 15:9">men Li renmen sila ki <note caller="+" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="1TI 6:11">I Tim 6:11</ref></char></note>chache ladwati a.<verse eid="PRO 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>Pinisyon byen di ap tann sila ki abandone chemen an;</para>
  <para style="q1" vid="PRO 15:10">sila ki rayi korije a va mouri.<verse eid="PRO 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11"/>Sejou mò yo ak labim nan parèt devan zye SENYÈ a;</para>
  <para style="q1" vid="PRO 15:11">konbyen, anplis, pou <note caller="+" style="x"><char style="xo" closed="false">15:11 </char><char style="xt" closed="false"><ref loc="1SA 16:7">I Sam 16:7</ref> </char></note>kè a lòm!<verse eid="PRO 15:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:12 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:1">Pwov 13:1</ref>
      </char>
    </note>Sila ki moke a pa renmen sila ki fè l repwòch la;</para>
  <para style="q1" vid="PRO 15:12">li pa janm ale kote moun saj.<verse eid="PRO 15:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>Kè ki gen lajwa fè figi moun rejwi;</para>
  <para style="q1" vid="PRO 15:13">men lè kè a tris, <note caller="+" style="x"><char style="xo" closed="false">15:13 </char><char style="xt" closed="false"><ref loc="PRO 17:22">Pwov 17:22</ref> </char></note>lespri a vin brize.<verse eid="PRO 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:14 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:15">Pwov 18:15</ref>
      </char>
    </note>Lespri a moun entèlijan an chache konesans;</para>
  <para style="q1" vid="PRO 15:14">men bouch a moun sòt la, manje foli.<verse eid="PRO 15:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15"/>Tout jou aflije yo move;</para>
  <para style="q1" vid="PRO 15:15">men yon kè kontan se yon fèt ki pa janm sispann.<verse eid="PRO 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>Pi bon se piti ak lakrent SENYÈ a,</para>
  <para style="q1" vid="PRO 15:16">pase gwo richès ak gwo twoub ladann.<verse eid="PRO 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>Pi bon se yon plato legim avèk lanmou,</para>
  <para style="q1" vid="PRO 15:17">pase yon bèf gra ak rayisman.<verse eid="PRO 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>Yon nonm ki kolerik pwovoke konfli;</para>
  <para style="q1" vid="PRO 15:18">men sila ki lan nan kòlè a kalme yon kont.<verse eid="PRO 15:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>Wout a parese a se tankou yon ran pikan;</para>
  <para style="q1" vid="PRO 15:19">men pa a moun dwat la se yon gran chemen.<verse eid="PRO 15:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>Yon <note caller="+" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="PRO 10:1">Pwov 10:1</ref></char></note>fis ki saj fè papa l kontan;</para>
  <para style="q1" vid="PRO 15:20">men yon gason ensanse meprize manman l.<verse eid="PRO 15:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>Foli se gwo plezi pou sila ki manke bon konprann nan;</para>
  <para style="q1" vid="PRO 15:21">men yon nonm ak bon konprann <note caller="+" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="PRO 14:8">Pwov 14:8</ref></char></note>mache dwat.<verse eid="PRO 15:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22"/>San konsèy, plan yo vin jennen;</para>
  <para style="q1" vid="PRO 15:22">men ak anpil konseyè, yo vin reyisi.<verse eid="PRO 15:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>Yon nonm jwenn kè kontan nan yon repons ki jis,</para>
  <para style="q1" vid="PRO 15:23">e a la bèl yon mo livre nan pwòp lè li bèl!<verse eid="PRO 15:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>Wout lavi a mennen moun saj la anwo,</para>
  <para style="q1" vid="PRO 15:24">pou l kab evite Sejou mò k ap tann li anba a.<verse eid="PRO 15:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>SENYÈ a va demoli kay moun ògeye a;</para>
  <para style="q1" vid="PRO 15:25">men L ap etabli lizyè vèv la.<verse eid="PRO 15:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26"/>Plan mechan yo abominab a SENYÈ a;</para>
  <para style="q1" vid="PRO 15:26">men pawòl agreyab yo san tach.<verse eid="PRO 15:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>Sila ki fè pwofi ak movèz fwa a, twouble pwòp lakay li;</para>
  <para style="q1" vid="PRO 15:27">men sila ki rayi afè anba tab la, va viv.<verse eid="PRO 15:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>Kè a moun dwat la <note caller="+" style="x"><char style="xo" closed="false">15:28 </char><char style="xt" closed="false"><ref loc="1PE 3:15">I Pi 3:15</ref></char></note>reflechi anpil pou bay repons;</para>
  <para style="q1" vid="PRO 15:28">men bouch a mechan an fè anpil move bagay vin parèt.<verse eid="PRO 15:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29"/>SENYÈ a lwen mechan an;</para>
  <para style="q1" vid="PRO 15:29">men Li <note caller="+" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 145:18-19">Sòm 145:18-19</ref></char></note>tande lapriyè a moun dwat yo.<verse eid="PRO 15:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30"/>Zye klè fè kè kontan;</para>
  <para style="q1" vid="PRO 15:30">bòn nouvèl kon mete grès sou zo.<verse eid="PRO 15:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>Zòrèy k ap koute repwòch ap viv;</para>
  <para style="q1" vid="PRO 15:31">zore ki koute koreksyon ap alèz pami saj yo.<verse eid="PRO 15:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>Sila ki neglije disiplin meprize pwòp tèt li;</para>
  <para style="q1" vid="PRO 15:32">men sila ki <note caller="+" style="x"><char style="xo" closed="false">15:32 </char><char style="xt" closed="false"><ref loc="PRO 15:5">Pwov 15:5</ref> </char></note>koute repwòch ranmase bon konprann.<verse eid="PRO 15:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>Lakrent SENYÈ a se enstriksyon ki bay sajès;</para>
  <para style="q1" vid="PRO 15:33">avan onè, fòk imilite.<verse eid="PRO 15:33"/></para>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:1 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:9">Pwov 16:9</ref>
      </char>
    </note>Plan kè a sòti nan lòm;</para>
  <para style="q1" vid="PRO 16:1">men repons a lang lan sòti nan SENYÈ a.<verse eid="PRO 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>Tout chemen a yon nonm pwòp nan zye pa li;</para>
  <para style="q1" vid="PRO 16:2">men SENYÈ a peze sa k nan kè l.<verse eid="PRO 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:5">Sòm 37:5</ref>
      </char>
    </note>Konsakre tout zèv ou yo a SENYÈ a,</para>
  <para style="q1" vid="PRO 16:3">e plan ou yo va etabli.<verse eid="PRO 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>SENYÈ a te fè tout bagay pou pwòp sèvis li;</para>
  <para style="q1" vid="PRO 16:4">menm <note caller="+" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="ROM 9:22">Wo 9:22</ref> </char></note>mechan yo pou jou jijman an.<verse eid="PRO 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>Tout sila ki gen kè ògèy, abominab a SENYÈ a;</para>
  <para style="q1" vid="PRO 16:5">anverite, li p ap chape anba pinisyon.<verse eid="PRO 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>Pa <note caller="+" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="DAN 4:27">Dan 4:27</ref></char></note>lanmou dous avèk verite, inikite lave;</para>
  <para style="q1" vid="PRO 16:6">e pa lakrent SENYÈ a moun chape anba mal.<verse eid="PRO 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>Lè chemen a yon nonm fè SENYÈ a kontan,</para>
  <para style="q1" vid="PRO 16:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">16:7 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 33:4">Jen 33:4</ref>
      </char>
    </note>l ap fè menm lènmi li yo vin anpè avè l.<verse eid="PRO 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>Pi bon se piti ak ladwati</para>
  <para style="q1" vid="PRO 16:8">pase gwo kòb k ap antre avèk enjistis.<verse eid="PRO 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>Panse a lòm fè plan pou wout li;</para>
  <para style="q1" vid="PRO 16:9">men <note caller="+" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="PSA 37:23">Sòm 37:23</ref> </char></note>SENYÈ a dirije pa li yo.<verse eid="PRO 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>Se desizyon diven ki nan lèv a wa a;</para>
  <para style="q1" vid="PRO 16:10">bouch li pa dwe fè erè nan jijman.<verse eid="PRO 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>Yon balans ki jis apatyen a Bondye;</para>
  <para style="q1" vid="PRO 16:11">li veye sou tout pwa nan sak yo.<verse eid="PRO 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12"/>Se abominab pou wa yo komèt zak mechan,</para>
  <para style="q1" vid="PRO 16:12">paske yon <note caller="+" style="x"><char style="xo" closed="false">16:12 </char><char style="xt" closed="false"><ref loc="PRO 25:5">Pwov 25:5</ref></char></note>twòn etabli sou ladwati.<verse eid="PRO 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>Lèv ki dwat se plezi a wa yo;</para>
  <para style="q1" vid="PRO 16:13">e sila ki pale dwat, vin renmen.<verse eid="PRO 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>Kòlè a yon wa se tankou mesaje lanmò;</para>
  <para style="q1" vid="PRO 16:14">men yon nonm saj va kalme li.<verse eid="PRO 16:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>Nan vizaj a yon wa briye lavi;</para>
  <para style="q1" vid="PRO 16:15">e favè li se tankou yon nwaj avèk lapli prentan.<verse eid="PRO 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>A la bon li pi bon pou resevwa sajès pase lò!</para>
  <para style="q1" vid="PRO 16:16">Pito nou jwenn bon konprann pase ajan.<verse eid="PRO 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:17 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 35:8">És 35:8</ref>
      </char>
    </note>Gran chemen a moun dwat la se pou kite mal;</para>
  <para style="q1" vid="PRO 16:17">sila ki veye chemen li an prezève lavi li.<verse eid="PRO 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>Ògèy ale devan destriksyon</para>
  <para style="q1" vid="PRO 16:18">e yon lespri ògèy devan moun kap tonbe.<verse eid="PRO 16:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>Li pi bon pou rete <note caller="+" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="PRO 3:34">Pwov 3:34</ref></char></note>enb nan lespri avèk sila ki ba yo,</para>
  <para style="q1" vid="PRO 16:19">pase divize piyaj ak moun ògeye yo.<verse eid="PRO 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>Sila ki bay atansyon a pawòl la va jwenn sa ki bon;</para>
  <para style="q1" vid="PRO 16:20">beni se sila ki mete konfyans li nan SENYÈ a.<verse eid="PRO 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:21 </char>
      <char style="xt" closed="false">
        <ref loc="HOS 14:9">Os 14:9</ref>
      </char>
    </note>Moun saj nan kè va rekonèt kon moun bon konprann;</para>
  <para style="q1" vid="PRO 16:21">e dousè nan pale va ogmante kapasite konvenk moun.<verse eid="PRO 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>Bon konprann se yon fontèn dlo lavi pou sila ki genyen l;</para>
  <para style="q1" vid="PRO 16:22">men pou disipline moun ensanse yo se foli.<verse eid="PRO 16:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:23 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:30">Sòm 37:30</ref>
      </char>
    </note>Kè moun saj la enstwi bouch li;</para>
  <para style="q1" vid="PRO 16:23">li ogmante pouvwa l pou konvenk moun ak lèv li.<verse eid="PRO 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:24 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:10">Sòm 19:10</ref>
      </char>
    </note>Pawòl agreyab se yon nich gato siwo myèl;</para>
  <para style="q1" vid="PRO 16:24">dous pou nanm nan, ak gerizon pou zo.<verse eid="PRO 16:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:25 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:15">Pwov 12:15</ref>
      </char>
    </note>Gen wout ki parèt bon a yon nonm;</para>
  <para style="q1" vid="PRO 16:25">men fen li se lanmò.<verse eid="PRO 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26"/>Apeti a yon ouvriye fè byen pou li;</para>
  <para style="q1" vid="PRO 16:26">paske se grangou ki ankouraje l.<verse eid="PRO 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>Yon <note caller="+" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="PRO 6:12-18">Pwov 6:12-18</ref></char></note>sanzave fòmante mechanste;</para>
  <para style="q1" vid="PRO 16:27">pawòl li yo brile tankou dife wouj.<verse eid="PRO 16:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>Yon nonm pèvès gaye konfli,</para>
  <para style="q1" vid="PRO 16:28">e yon nonm k ap bay kout lang ap separe bon zanmi yo.<verse eid="PRO 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>Yon nonm vyolan <note caller="+" style="x"><char style="xo" closed="false">16:29 </char><char style="xt" closed="false"><ref loc="PRO 1:10">Pwov 1:10</ref></char></note>ap tante vwazen li</para>
  <para style="q1" vid="PRO 16:29">pou l mennen li nan move chemen.<verse eid="PRO 16:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>Sila kap bay je dou, fè l pou l kab mennen bagay pèvès;</para>
  <para style="q1" vid="PRO 16:30">sila ki fèmen sere lèv li, fè mal la rive.<verse eid="PRO 16:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>Yon <note caller="+" style="x"><char style="xo" closed="false">16:31 </char><char style="xt" closed="false"><ref loc="PRO 20:29">Pwov 20:29</ref></char></note>tèt blanch se yon kouwòn laglwa;</para>
  <para style="q1" vid="PRO 16:31">li jwenn nan chemen ladwati a.<verse eid="PRO 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>Sila ki lan nan kòlè a pi bon pase pwisan yo;</para>
  <para style="q1" vid="PRO 16:32">e sila ki gouvène lespri li a pi bon pase sila kap kaptire yon gran vil.<verse eid="PRO 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>Tiraj osò fèt nan fon wòb;</para>
  <para style="q1" vid="PRO 16:33">men tout desizyon ki sòti, sòti nan SENYÈ a.<verse eid="PRO 16:33"/></para>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>Pi bon se yon mòso pen sèch ak lapè</para>
  <para style="q1" vid="PRO 17:1">pase yon kay ak gwo manje nan konfli.<verse eid="PRO 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>Yon sèvitè ki aji avèk sajès</para>
  <para style="q1" vid="PRO 17:2">va renye sou yon fis ki aji ak wont;</para>
  <para style="q1" vid="PRO 17:2">li va pataje eritaj la pami frè yo.<verse eid="PRO 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>Po rafine se pou ajan, e founo se pou lò;</para>
  <para style="q1" vid="PRO 17:3">men <note caller="+" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="1CH 29:17">I Kwo 29:17</ref></char></note>SENYÈ a ap sonde tout kè.<verse eid="PRO 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>Yon malfektè koute lèv mechan yo;</para>
  <para style="q1" vid="PRO 17:4">yon mantè prete atansyon a yon lang kap detwi.<verse eid="PRO 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>Sila ki moke <note caller="+" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="PRO 14:31">Pwov 14:31</ref></char></note>malere a moke Kreyatè li;</para>
  <para style="q1" vid="PRO 17:5">sila ki rejwi nan malè a, p ap soti san pinisyon.<verse eid="PRO 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>Pitit a pitit se kouwòn a granmoun,</para>
  <para style="q1" vid="PRO 17:6">e <note caller="+" style="x"><char style="xo" closed="false">17:6 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Egz 20:12</ref> </char></note>glwa a fis yo se papa yo.<verse eid="PRO 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>Bèl diskou pa byen koresponn ak yon moun ki ensanse,</para>
  <para style="q1" vid="PRO 17:7">bokou mwens <note caller="+" style="x"><char style="xo" closed="false">17:7 </char><char style="xt" closed="false"><ref loc="PSA 31:18">Sòm 31:18</ref> </char></note>lèv kap manti sou yon prens.<verse eid="PRO 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>Vèse kòb anba tab se tankou wanga pou mèt li;</para>
  <para style="q1" vid="PRO 17:8">nenpòt kote li vire, li byen reyisi.<verse eid="PRO 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">17:9 </char><char style="xt" closed="false"><ref loc="PRO 10:12">Pwov 10:12</ref></char></note>kouvri yon transgresyon, chache lanmou;</para>
  <para style="q1" vid="PRO 17:9">men sila ki repete yon koze, separe bon zanmi yo.<verse eid="PRO 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>Yon repwòch antre pi fon nan moun bon konprann nan</para>
  <para style="q1" vid="PRO 17:10">pase anpil kou sou yon moun ensanse.<verse eid="PRO 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>Yon nonm rebèl se mal l ap chache;</para>
  <para style="q1" vid="PRO 17:11">konsa, yon mesaje byen sovaj va voye kont li.<verse eid="PRO 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>Pito yon nonm rankontre yon <note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="2SA 17:8">II Sam 17:8</ref> </char></note> lous fewòs ki separe de pitit li,</para>
  <para style="q1" vid="PRO 17:12">pase yon moun ensanse nan mitan foli li.<verse eid="PRO 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>Pou sila ki <note caller="+" style="x"><char style="xo" closed="false">17:13 </char><char style="xt" closed="false"><ref loc="PSA 35:12">Sòm 35:12</ref> </char></note>remèt mal pou byen an,</para>
  <para style="q1" vid="PRO 17:13">mal la p ap janm kite lakay li.<verse eid="PRO 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>Kòmansman a konfli se tankou pete gwo baryè dlo;</para>
  <para style="q1" vid="PRO 17:14">konsa, <note caller="+" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="PRO 20:3">Pwov 20:3</ref> </char></note>kite kont la avan l kòmanse.<verse eid="PRO 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">17:15 </char><char style="xt" closed="false"><ref loc="EXO 23:7">Egz 23:7</ref></char></note>bay rezon a mechan an, ni sila ki kondane moun dwat la;</para>
  <para style="q1" vid="PRO 17:15">tou de abominab a SENYÈ a.<verse eid="PRO 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>Poukisa gen kòb nan men moun ensanse a</para>
  <para style="q1" vid="PRO 17:16">pou l <note caller="+" style="x"><char style="xo" closed="false">17:16 </char><char style="xt" closed="false"><ref loc="PRO 23:23">Pwov 23:23</ref></char></note>achte sajès, konsi, li pa konprann anyen?<verse eid="PRO 17:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>Yon <note caller="+" style="x"><char style="xo" closed="false">17:17 </char><char style="xt" closed="false"><ref loc="RUT 1:16">Rt 1:16</ref></char></note>zanmi renmen tout tan;</para>
  <para style="q1" vid="PRO 17:17">yon frè fèt pou move tan.<verse eid="PRO 17:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>Yon nonm ki manke konprann <note caller="+" style="x"><char style="xo" closed="false">17:18 </char><char style="xt" closed="false"><ref loc="PRO 6:1">Pwov 6:1</ref></char></note>sèvi garanti,</para>
  <para style="q1" vid="PRO 17:18">e devni responsab nan prezans a vwazen li.<verse eid="PRO 17:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>Sila ki renmen vyole lalwa a renmen konfli;</para>
  <para style="q1" vid="PRO 17:19">sila ki <note caller="+" style="x"><char style="xo" closed="false">17:19 </char><char style="xt" closed="false"><ref loc="PRO 16:18">Pwov 16:18</ref></char></note>awogan an, chache gwo dega.<verse eid="PRO 17:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20"/>Sila ki gen panse kwochi a, <note caller="+" style="x"><char style="xo" closed="false">17:20 </char><char style="xt" closed="false"><ref loc="PRO 24:20">Pwov 24:20</ref></char></note>pa jwenn anyen ki bon,</para>
  <para style="q1" vid="PRO 17:20">e sila ki pèvès nan pawòl li yo tonbe nan mal.<verse eid="PRO 17:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>Sila ki fè pitit ki san konprann nan, fè l nan tristès;</para>
  <para style="q1" vid="PRO 17:21">e papa a yon moun ensanse pa gen kè kontan.<verse eid="PRO 17:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>Yon kè kontan se bon remèd;</para>
  <para style="q1" vid="PRO 17:22">men yon lespri brize <note caller="+" style="x"><char style="xo" closed="false">17:22 </char><char style="xt" closed="false"><ref loc="PSA 22:15">Sòm 22:15</ref> </char></note>seche tout zo.<verse eid="PRO 17:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>Yon nonm mechan an resevwa kòb anba tab an sekrè;</para>
  <para style="q1" vid="PRO 17:23">pou l <note caller="+" style="x"><char style="xo" closed="false">17:23 </char><char style="xt" closed="false"><ref loc="EXO 23:8">Egz 23:8</ref></char></note>tòde chemen lajistis.<verse eid="PRO 17:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>Sajès se devan fas a sila ki gen bon konprann nan;</para>
  <para style="q1" vid="PRO 17:24">men <note caller="+" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="ECC 2:14">Ekl 2:14</ref></char></note>zye a moun ensanse yo chache jis rive nan tout pwent latè.<verse eid="PRO 17:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>Yon fis ki san konprann se yon tèt chaje a papa l,</para>
  <para style="q1" vid="PRO 17:25">ak <note caller="+" style="x"><char style="xo" closed="false">17:25 </char><char style="xt" closed="false"><ref loc="PRO 10:1">Pwov 10:1</ref> </char></note>gwo chagren a sila ki te pòte li a.<verse eid="PRO 17:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>Anplis, li pa bon pou <note caller="+" style="x"><char style="xo" closed="false">17:26 </char><char style="xt" closed="false"><ref loc="PRO 17:5">Pwov 17:5</ref></char></note>pini moun dwat la,</para>
  <para style="q1" vid="PRO 17:26">ni pou frape prens yo akoz entegrite yo.<verse eid="PRO 17:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>Sila ki kenbe pawòl li, gen konesans;</para>
  <para style="q1" vid="PRO 17:27">e sila ki gen <note caller="+" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="PRO 14:29">Pwov 14:29</ref> </char></note>lespri kalm nan se yon nonm ak bon konprann.<verse eid="PRO 17:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>Menm yon moun ensanse, lè l rete an silans, konsidere kon saj;</para>
  <para style="q1" vid="PRO 17:28">lè l fèmen lèv li, li parèt rezonab.<verse eid="PRO 17:28"/></para>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1"/>Sila ki izole pwòp tèt li, chache pwòp enterè l;</para>
  <para style="q1" vid="PRO 18:1">bon jijman an pa anyèn devan l.<verse eid="PRO 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>Yon moun ensanse pa pran plezi nan bon konprann;</para>
  <para style="q1" vid="PRO 18:2">men sèlman <note caller="+" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="PRO 12:23">Pwov 12:23</ref></char></note>nan devwale pwòp panse li.<verse eid="PRO 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>Lè yon nonm mechan vin parèt, mepriz la vini ansanm avè l;</para>
  <para style="q1" vid="PRO 18:3">e avèk dezonè, wont vin parèt.<verse eid="PRO 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>Pawòl yo ki sòti nan bouch a yon nonm se yon <note caller="+" style="x"><char style="xo" closed="false">18:4 </char><char style="xt" closed="false"><ref loc="PRO 20:5">Pwov 20:5</ref></char></note>dlo byen fon;</para>
  <para style="q1" vid="PRO 18:4">dlo sajès se yon dlo fre k ap koule tout tan.<verse eid="PRO 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>Panche vè youn moun mechan an pa bon,</para>
  <para style="q1" vid="PRO 18:5">ni pou fè jijman ki rache jistis nan men moun dwat yo.<verse eid="PRO 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>Lèv a yon moun ensanse mennen konfli;</para>
  <para style="q1" vid="PRO 18:6">bouch li ap mande kou.<verse eid="PRO 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>Bouch a <note caller="+" style="x"><char style="xo" closed="false">18:7 </char><char style="xt" closed="false"><ref loc="PSA 64:8">Sòm 64:8</ref></char></note>moun san konprann nan se dega li;</para>
  <para style="q1" vid="PRO 18:7">e lèv li se pèlen pou nanm li.<verse eid="PRO 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>Pawòl a sila ki chichote pawòl nan zòrèy moun nan</para>
  <para style="q1" vid="PRO 18:8">se tankou bonbon ki gen gou dous;</para>
  <para style="q1" vid="PRO 18:8">se jis nan fon kò a yo desann.<verse eid="PRO 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>Anplis, sila ki parese nan travay li a</para>
  <para style="q1" vid="PRO 18:9">se <note caller="+" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="PRO 28:24">Pwov 28:24</ref> </char></note>frè a sila ki detwi.<verse eid="PRO 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:10 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 3:15">Egz 3:15</ref>
      </char>
    </note>Non SENYÈ a se yon sitadèl byen fò;</para>
  <para style="q1" vid="PRO 18:10">moun ladwati a kouri ladann pou jwenn sekou.<verse eid="PRO 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>Pou yon nonm <note caller="+" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="PRO 10:15">Pwov 10:15</ref></char></note>rich, byen li se yon vil ki fò;</para>
  <para style="q1" vid="PRO 18:11">kon yon miray byen wo nan panse li.<verse eid="PRO 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:12 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:2">Pwov 11:2</ref>
      </char>
    </note>Avan destriksyon, kè yon nonm plen ògèy;</para>
  <para style="q1" vid="PRO 18:12">men imilite ale devan onè.<verse eid="PRO 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">18:13 </char><char style="xt" closed="false"><ref loc="PRO 20:25">Pwov 20:25</ref></char></note>bay repons avan li koute a;</para>
  <para style="q1" vid="PRO 18:13">plen foli ak wont.<verse eid="PRO 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>Lespri a yon nonm kapab sipòte maladi;</para>
  <para style="q1" vid="PRO 18:14">men nan ka lespri brize a, se kilès ki kab sipòte li?<verse eid="PRO 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:15 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:4">Pwov 15:4</ref>
      </char>
    </note>Panse a sila ki gen bon konprann nan, ranmase konesans;</para>
  <para style="q1" vid="PRO 18:15">anplis, zòrèy a saj la chache konesans.<verse eid="PRO 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:16 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 32:20">Jen 32:20</ref>
      </char>
    </note>Don a yon nonm fè kont espas pou li,</para>
  <para style="q1" vid="PRO 18:16">e mennen li devan moun enpòtan.<verse eid="PRO 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>Premye moun pou plede ka li a, sanble gen rezon;</para>
  <para style="q1" vid="PRO 18:17">jiskaske yon lòt moun vin egzamine l.<verse eid="PRO 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:18 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:33">Pwov 16:33</ref>
      </char>
    </note>Tiraj osò fè konfli sispann;</para>
  <para style="q1" vid="PRO 18:18">lap pran desizyon antre moun pwisan yo.<verse eid="PRO 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>Yon frè ki blese se pi rèd pou konvenk pase yon vil fòtifye;</para>
  <para style="q1" vid="PRO 18:19">konfli ak li se tankou ba fè nan yon sitadèl.<verse eid="PRO 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>Se fwi a bouch moun ki satisfè vant li;</para>
  <para style="q1" vid="PRO 18:20">
    <note caller="+" style="x">
      <char style="xo" closed="false">18:20 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:14">Pwov 14:14</ref>
      </char>
    </note>l ap satisfè ak sa ke lèv li pwodwi.<verse eid="PRO 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:21 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:13">Pwov 12:13</ref>
      </char>
    </note>Lanmò ak lavi nan pouvwa a lang lan;</para>
  <para style="q1" vid="PRO 18:21">e sila ki renmen l yo, va manje fwi li.<verse eid="PRO 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>Sila ki jwenn yon <note caller="+" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="GEN 2:18">Jen 2:18</ref></char></note>madanm, jwenn yon bon bagay,</para>
  <para style="q1" vid="PRO 18:22">e twouve favè SENYÈ a.<verse eid="PRO 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:23 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:7">Pwov 19:7</ref>
      </char>
    </note>Malere a pale: “Souple, fè m gras”;</para>
  <para style="q1" vid="PRO 18:23">men moun rich la reponn byen di.<verse eid="PRO 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>Yon nonm ak anpil zanmi vin kraze nèt;</para>
  <para style="q1" vid="PRO 18:24">men gen <note caller="+" style="x"><char style="xo" closed="false">18:24 </char><char style="xt" closed="false"><ref loc="PRO 17:17">Pwov 17:17</ref></char></note>yon kalite zanmi ki rete pi pwòch pase yon frè.<verse eid="PRO 18:24"/></para>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:1 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:6">Pwov 28:6</ref>
      </char>
    </note>Pi bon se yon malere ki mache ak entegrite</para>
  <para style="q1" vid="PRO 19:1">pase sila ak bouch konwonpi ki ensanse a.<verse eid="PRO 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>Anplis, li pa bon pou gen gwo kouraj, san konesans,</para>
  <para style="q1" vid="PRO 19:2">ni pou prese rive <note caller="+" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="PRO 21:5">Pwov 21:5</ref></char></note> fè fo pa.<verse eid="PRO 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>Foli a yon nonm fè chemen l gate;</para>
  <para style="q1" vid="PRO 19:3">e kè li anraje kont SENYÈ a.<verse eid="PRO 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:4 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:20">Pwov 14:20</ref>
      </char>
    </note>Richès fè zanmi ogmante anpil;</para>
  <para style="q1" vid="PRO 19:4">men malere pèdi zanmi li yo.<verse eid="PRO 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>Yon <note caller="+" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="EXO 23:1">Egz 23:1</ref></char></note>fo temwen pa prale san pinisyon;</para>
  <para style="q1" vid="PRO 19:5">e sila ki fè manti a, p ap chape.<verse eid="PRO 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:6 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 29:26">Pwov 29:26</ref>
      </char>
    </note>Anpil moun va chache favè a yon moun jenere ak men ouvri;</para>
  <para style="q1" vid="PRO 19:6">tout moun se zanmi a sila ki bay kado.<verse eid="PRO 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>Tout frè a malere yo a rayi li;</para>
  <para style="q1" vid="PRO 19:7">konbyen, anplis, pou zanmi l kouri kite l.</para>
  <para style="q1" vid="PRO 19:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">19:7 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:23">Pwov 18:23</ref> </char>
    </note>L ale jwenn yo ak pawòl plede, men yo fin ale.<verse eid="PRO 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>Sila ki twouve sajès renmen pwòp nanm li.</para>
  <para style="q1" vid="PRO 19:8">Sila ki kenbe ak bon konprann nan va <note caller="+" style="x"><char style="xo" closed="false">19:8 </char><char style="xt" closed="false"><ref loc="PRO 16:20">Pwov 16:20</ref></char></note> jwenn sa ki bon.<verse eid="PRO 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>Yon <note caller="+" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="PRO 19:5">Pwov 19:5</ref></char></note>fo temwen pa prale san pinisyon;</para>
  <para style="q1" vid="PRO 19:9">epi sila ki bay manti a, va peri.<verse eid="PRO 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>Lavi alèz pa fèt pou moun ensanse;</para>
  <para style="q1" vid="PRO 19:10">bokou mwens pou yon <note caller="+" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="PRO 30:22">Pwov 30:22</ref></char></note>esklav ta gen otorite sou prens yo.<verse eid="PRO 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>Yon nonm ak bon konprann lan nan kòlè;</para>
  <para style="q1" vid="PRO 19:11">se glwa li <note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="MAT 5:44">Mat 5:44</ref> </char></note>pou bliye yon transgresyon.<verse eid="PRO 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:12 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:14">Pwov 16:14</ref>
      </char>
    </note>Kòlè a wa a se tankou yon lyon k ap rele fò;</para>
  <para style="q1" vid="PRO 19:12">men favè li se tankou lawouze sou zèb vèt.<verse eid="PRO 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>Se yon fis plen foli k ap detwi papa l,</para>
  <para style="q1" vid="PRO 19:13">e yon madanm k ap <note caller="+" style="x"><char style="xo" closed="false">19:13 </char><char style="xt" closed="false"><ref loc="PRO 21:9-19">Pwov 21:9-19</ref> </char></note>diskite a</para>
  <para style="q1" vid="PRO 19:13">se tankou dlo kap degoute san rete.<verse eid="PRO 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>Kay ak byen se <note caller="+" style="x"><char style="xo" closed="false">19:14 </char><char style="xt" closed="false"><ref loc="2CH 12:14">II Kwo 12:14</ref></char></note>eritaj ki sòti nan papa;</para>
  <para style="q1" vid="PRO 19:14">men yon fanm pridan sòti nan SENYÈ a.<verse eid="PRO 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:15 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:9-10">Pwov 6:9-10</ref>
      </char>
    </note>Parès va voye yon pwofon somèy sou moun,</para>
  <para style="q1" vid="PRO 19:15">e yon nonm ki pa travay, va soufri grangou.<verse eid="PRO 19:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">19:16 </char><char style="xt" closed="false"><ref loc="PRO 16:16">Pwov 16:16</ref></char></note>kenbe kòmandman an kenbe nanm li,</para>
  <para style="q1" vid="PRO 19:16">men sila ki enpridan nan kondwit va mouri.<verse eid="PRO 19:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>Yon moun ki <note caller="+" style="x"><char style="xo" closed="false">19:17 </char><char style="xt" closed="false"><ref loc="DEU 15:7-8">Det 15:7-8</ref></char></note>fè gras a yon malere prete a SENYÈ a,</para>
  <para style="q1" vid="PRO 19:17">e Li va bay li rekonpans pou bon zèv li a.<verse eid="PRO 19:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:18 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:24">Pwov 13:24</ref>
      </char>
    </note>Bay fis ou a disiplin pandan gen espwa;</para>
  <para style="q1" vid="PRO 19:18">pa chache lanmò li.<verse eid="PRO 19:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>Yon nonm ak gwo kòlè va pote pinisyon li;</para>
  <para style="q1" vid="PRO 19:19">paske si ou pwoteje moun nan ou va oblije fè l ankò.<verse eid="PRO 19:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>Koute konsèy e aksepte disiplin pou ou</para>
  <para style="q1" vid="PRO 19:20">kab vin saj pou tout rès vi ou.<verse eid="PRO 19:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>Plan nan kè lòm yo anpil;</para>
  <para style="q1" vid="PRO 19:21">men se konsèy SENYÈ a ki kanpe.<verse eid="PRO 19:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>Sa ki dezirab nan yon nonm se yon kè ki dous.</para>
  <para style="q1" vid="PRO 19:22">Pito yon nonm ta malere pase li ta yon mantè.<verse eid="PRO 19:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:23 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:27">Pwov 14:27</ref>
      </char>
    </note>Lakrent SENYÈ a dirije a lavi pou fè moun dòmi</para>
  <para style="q1" vid="PRO 19:23">ak kè satisfè, san kontamine ak mal.<verse eid="PRO 19:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>Parese a fouye men l nan plato a;</para>
  <para style="q1" vid="PRO 19:24">men li refize rale l rive nan bouch li.<verse eid="PRO 19:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>Frape yon mokè pou moun san konprann nan vin gen lespri;</para>
  <para style="q1" vid="PRO 19:25">
    <note caller="+" style="x">
      <char style="xo" closed="false">19:25 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:8">Pwov 9:8</ref>
      </char>
    </note>repwòch a yon moun bon konprann,</para>
  <para style="q1" vid="PRO 19:25">va fè l genyen konesans.<verse eid="PRO 19:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>Sila <note caller="+" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="PRO 28:24">Pwov 28:24</ref></char></note>ki atake papa li e chase manman l ale,</para>
  <para style="q1" vid="PRO 19:26">se yon fis ki fè wont ak dega patou.<verse eid="PRO 19:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>Sispann koute disiplin, fis mwen an</para>
  <para style="q1" vid="PRO 19:27">e ou va pèdi chemen konesans.<verse eid="PRO 19:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>Yon temwen ki fè dezòd moke lajistis;</para>
  <para style="q1" vid="PRO 19:28">e bouch mechan an <note caller="+" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="JOB 15:16">Job 15:16</ref></char></note>gaye inikite.<verse eid="PRO 19:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>Gen desizyon jijman pou mokè yo;</para>
  <para style="q1" vid="PRO 19:29">ak kou pou do a moun ensanse yo.<verse eid="PRO 19:29"/></para>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1"/>Diven se yon mokè, e <note caller="+" style="x"><char style="xo" closed="false">20:1 </char><char style="xt" closed="false"><ref loc="PRO 3:14">Pwov 3:14</ref></char></note>bwason fò fè goumen rive nan tenten;</para>
  <para style="q1" vid="PRO 20:1">nenpòt moun ki vin sou pa li, pa saj.<verse eid="PRO 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2"/>Laperèz a wa a se tankou gwo vwa lyon k ap rele fò;</para>
  <para style="q1" vid="PRO 20:2">sila ki fè l fache <note caller="+" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="NUM 16:38">Nonb 16:38</ref></char></note>va pèdi lavi l.<verse eid="PRO 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:3 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 13:7">Jen 13:7</ref>
      </char>
    </note>Rete lwen konfli ak rayisman, e ou va gen respe;</para>
  <para style="q1" vid="PRO 20:3">alò, nenpòt moun ensanse ka fè yon kont.<verse eid="PRO 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:4 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:4">Pwov 13:4</ref>
      </char>
    </note>Parese a pa laboure tè nan sezon otòn;</para>
  <para style="q1" vid="PRO 20:4">akoz sa li mande charite pandan rekòlt la, e li p ap gen anyen.<verse eid="PRO 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5"/>Yon plan nan kè moun se tankou dlo fon;</para>
  <para style="q1" vid="PRO 20:5">men yon nonm ak bon konprann rale l fè l sòti.<verse eid="PRO 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>Gen anpil moun ki pwomèt fidelite;</para>
  <para style="q1" vid="PRO 20:6">men kibò pou jwenn yon nonm onèt?<verse eid="PRO 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>Yon nonm dwat ki mache nan entegrite l;</para>
  <para style="q1" vid="PRO 20:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">20:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:26">Sòm 37:26</ref>
      </char>
    </note>A la beni fis ki vini apre li yo beni!<verse eid="PRO 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:8 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:26">Pwov 20:26</ref>
      </char>
    </note>Yon wa ki chita sou twòn lajistis</para>
  <para style="q1" vid="PRO 20:8">fè tout mal sove ale ak pwòp zye l.<verse eid="PRO 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:9 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 8:46">I Wa 8:46</ref>
      </char>
    </note>Se kilès ki kapab di: “Mwen te netwaye kè m;</para>
  <para style="q1" vid="PRO 20:9">mwen vin pirifye de tout peche m?”<verse eid="PRO 20:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:10 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:1">Pwov 11:1</ref>
      </char>
    </note>Balans ki pa ojis ak mezi ki pa ojis;</para>
  <para style="q1" vid="PRO 20:10">tou de abominab a SENYÈ a.<verse eid="PRO 20:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>Menm yon ti moun se <note caller="+" style="x"><char style="xo" closed="false">20:11 </char><char style="xt" closed="false"><ref loc="MAT 7:16">Mat 7:16</ref></char></note>rekonnet pa zèv li yo;</para>
  <para style="q1" vid="PRO 20:11">si li aji byen e si kondwit li dwat.<verse eid="PRO 20:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:12 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 4:11">Egz 4:11</ref>
      </char>
    </note>Zòrèy ki tande ak zye ki wè;</para>
  <para style="q1" vid="PRO 20:12">se SENYÈ a ki te fè tou de.<verse eid="PRO 20:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:13 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:9-10">Pwov 6:9-10</ref>
      </char>
    </note>Pa renmen dòmi, sinon ou va vin malere;</para>
  <para style="q1" vid="PRO 20:13">ouvri zye ou e ou va satisfè ak manje.<verse eid="PRO 20:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>“Pa bon, pa bon”, di sila k ap achte a;</para>
  <para style="q1" vid="PRO 20:14">men lè l fè wout li, li pale kè l kontan.<verse eid="PRO 20:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>Gen lò ak tout kalite bijou;</para>
  <para style="q1" vid="PRO 20:15">men lèv plèn konesans se pi bèl bagay.<verse eid="PRO 20:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>Lè l sèvi garanti pou yon enkoni, pran manto li;</para>
  <para style="q1" vid="PRO 20:16">epi pou fanm andeyò a, fè papye pwose vèbal pou sa li pwomèt la.<verse eid="PRO 20:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:17 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:17">Pwov 9:17</ref>
      </char>
    </note>Pen kòn twouve nan bay manti dous;</para>
  <para style="q1" vid="PRO 20:17">men pita, bouch la plen gravye.<verse eid="PRO 20:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>Fè tout plan ak konsiltasyon;</para>
  <para style="q1" vid="PRO 20:18">
    <note caller="+" style="x">
      <char style="xo" closed="false">20:18 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:6">Pwov 24:6</ref> </char>
    </note>fè lagè ak konsèy saj.<verse eid="PRO 20:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>Sila ki difame moun devwale sekrè;</para>
  <para style="q1" vid="PRO 20:19">pou sa a, pa asosye ou ak moun ki mache bouch ouvri.<verse eid="PRO 20:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">20:20 </char><char style="xt" closed="false"><ref loc="EXO 21:17">Egz 21:17</ref></char></note>modi papa li oswa manman li an,</para>
  <para style="q1" vid="PRO 20:20">lanp li va etenn nan tan fènwa.<verse eid="PRO 20:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>Yon eritaj ranmase vit nan kòmansman a, p ap beni nan lafen.<verse eid="PRO 20:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:22 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:14">Sòm 27:14</ref>
      </char>
    </note>Pa di: “M ap rekonpanse mechanste”;</para>
  <para style="q1" vid="PRO 20:22">tann SENYÈ a, e Li va sove ou.<verse eid="PRO 20:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:23 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:1">Pwov 11:1</ref>
      </char>
    </note>Pwa ki pa ojis ak mezi ki pa ojis;</para>
  <para style="q1" vid="PRO 20:23">tou de abominab a SENYÈ a.<verse eid="PRO 20:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:24 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:9">Pwov 16:9</ref>
      </char>
    </note>Pa a yon nonm regle pa SENYÈ a;</para>
  <para style="q1" vid="PRO 20:24">konsa, kijan yon nonm kab vin konprann chemen li?<verse eid="PRO 20:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25"/>Se yon pèlen pou yon nonm ta di avèk enpridans:</para>
  <para style="q1" vid="PRO 20:25">“Sa sen!” e <note caller="+" style="x"><char style="xo" closed="false">20:25 </char><char style="xt" closed="false"><ref loc="ECC 5:4-5">Ekl 5:4-5</ref></char></note>aprè ve yo fèt, pou fè ankèt.<verse eid="PRO 20:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>Yon wa ki saj va vannen mechan yo</para>
  <para style="q1" vid="PRO 20:26">e fè <note caller="+" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="ISA 28:27">És 28:27</ref></char></note>wou moulen pase anwo yo.<verse eid="PRO 20:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>Lespri a lòm se lanp SENYÈ a,</para>
  <para style="q1" vid="PRO 20:27">ki chache pati ki pi entim nan li yo.<verse eid="PRO 20:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>Fidelite ak <note caller="+" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="PRO 29:14">Pwov 29:14</ref></char></note>verite prezève wa a,</para>
  <para style="q1" vid="PRO 20:28">e ladwati bay twòn li an soutyen.<verse eid="PRO 20:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>Glwa a jèn yo se fòs yo,</para>
  <para style="q1" vid="PRO 20:29">e lonè a granmoun yo se cheve blan yo.<verse eid="PRO 20:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:30 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:32">Sòm 89:32</ref>
      </char>
    </note>Kout fwèt ki blese fè disparèt mechanste;</para>
  <para style="q1" vid="PRO 20:30">li frape rive nan pati pi fon yo.<verse eid="PRO 20:30"/></para>
  <para style="b"/>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1"/>Kè a wa a se tankou kanal dlo nan men SENYÈ a;</para>
  <para style="q1" vid="PRO 21:1">Li <note caller="+" style="x"><char style="xo" closed="false">21:1 </char><char style="xt" closed="false"><ref loc="EZR 6:22">Esd 6:22</ref></char></note>vire l kote Li vle.<verse eid="PRO 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>Chemen a yon moun bon nan pwòp zye li;</para>
  <para style="q1" vid="PRO 21:2">men SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="PRO 16:2">Pwov 16:2</ref></char></note>peze kè yo.<verse eid="PRO 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>SENYÈ a pito <note caller="+" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="1SA 15:22">I Sam 15:22</ref></char></note>ladwati ak lajistis</para>
  <para style="q1" vid="PRO 21:3">plis pase sakrifis.<verse eid="PRO 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>Zye ki leve wo ak kè ki plen ògèy;</para>
  <para style="q1" vid="PRO 21:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">21:4 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:20">Pwov 24:20</ref>
      </char>
    </note>lanp a mechan yo se peche.<verse eid="PRO 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>Plan a <note caller="+" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="PRO 10:4">Pwov 10:4</ref></char></note>dilijan an mennen byen si, vè avantaj;</para>
  <para style="q1" vid="PRO 21:5">men tout moun ki aji san reflechi va, san dout, vin pòv.<verse eid="PRO 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>Ranmase anpil byen ak lang k ap bay manti</para>
  <para style="q1" vid="PRO 21:6">se yon vapè k ap sove ale, k ap kouri dèyè lanmò.<verse eid="PRO 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>Vyolans a mechan yo va trennen yo fè yo pati,</para>
  <para style="q1" vid="PRO 21:7">akoz yo <note caller="+" style="x"><char style="xo" closed="false">21:7 </char><char style="xt" closed="false"><ref loc="AMO 5:7">Am 5:7</ref></char></note>refize aji ak jistis.<verse eid="PRO 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>Chemen a yon moun koupab <note caller="+" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="PRO 2:15">Pwov 2:15</ref></char></note>kwochi;</para>
  <para style="q1" vid="PRO 21:8">men pou sila ki san tach la, kondwit li dwat.<verse eid="PRO 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>Li pi bon pou viv nan ti kwen sou twati a</para>
  <para style="q1" vid="PRO 21:9">pase nan yon kay ak yon fanm k ap fè kont tout tan.<verse eid="PRO 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>Nanm a mechan an vle mal;</para>
  <para style="q1" vid="PRO 21:10">vwazen li an pa twouve gras nan zye l.<verse eid="PRO 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>Lè <note caller="+" style="x"><char style="xo" closed="false">21:11 </char><char style="xt" closed="false"><ref loc="PRO 19:25">Pwov 19:25</ref></char></note>mokè a vin pini, moun san konprann nan vin saj;</para>
  <para style="q1" vid="PRO 21:11">men lè moun saj la enstwi, li resevwa konesans.<verse eid="PRO 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>Lè sila ki dwat, pran an konsiderasyon kay mechan an,</para>
  <para style="q1" vid="PRO 21:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">21:12 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:11">Pwov 14:11</ref>
      </char>
    </note>afè mechan an vin detwi nèt.<verse eid="PRO 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="MAT 18:30-34">Mat 18:30-34</ref></char></note>fèmen zòrèy li a kri aflije a,</para>
  <para style="q1" vid="PRO 21:13">va vin kriye pou kont li, men li p ap jwenn <note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="JAS 2:13">Jc 2:13</ref> </char></note>repons.<verse eid="PRO 21:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>Yon <note caller="+" style="x"><char style="xo" closed="false">21:14 </char><char style="xt" closed="false"><ref loc="PRO 18:16">Pwov 18:16</ref></char></note>kado vèse an sekrè kalme fachez,</para>
  <para style="q1" vid="PRO 21:14">e yon anba tab ki glise rive, bese gwo kòlè.<verse eid="PRO 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>Aplike lajistis se yon plezi pou moun dwat;</para>
  <para style="q1" vid="PRO 21:15">men se yon gwo laperèz pou malfektè inikite yo.<verse eid="PRO 21:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>Yon nonm egare ki kite chemen bon konprann nan,</para>
  <para style="q1" vid="PRO 21:16">va jwenn repo nan asanble mò yo.<verse eid="PRO 21:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">21:17 </char><char style="xt" closed="false"><ref loc="PRO 23:21">Pwov 23:21</ref></char></note>renmen plezi, va vin pòv;</para>
  <para style="q1" vid="PRO 21:17">sila ki renmen diven ak lwil, p ap janm rich.<verse eid="PRO 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>Mechan an se yon <note caller="+" style="x"><char style="xo" closed="false">21:18 </char><char style="xt" closed="false"><ref loc="ISA 43:3">És 43:3</ref></char></note>ranson pou moun dwat yo;</para>
  <para style="q1" vid="PRO 21:18">e sila ki fè trèt la pou sila ki kanpe janm.<verse eid="PRO 21:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:19 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 21:9">Pwov 21:9</ref>
      </char>
    </note>Li pi bon pou rete nan dezè</para>
  <para style="q1" vid="PRO 21:19">pase viv ak yon fanm k ap agase moun tout tan.<verse eid="PRO 21:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>Gen bèl trezò ak lwil nan abitasyon a moun saj la;</para>
  <para style="q1" vid="PRO 21:20">men, moun san konprann nan <note caller="+" style="x"><char style="xo" closed="false">21:20 </char><char style="xt" closed="false"><ref loc="JOB 20:15-18">Job 20:15-18</ref> </char></note>vale tout.<verse eid="PRO 21:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="PRO 15:9">Pwov 15:9</ref></char></note>swiv ladwati ak fidelite a</para>
  <para style="q1" vid="PRO 21:21">jwenn lavi, ladwati ak lonè.<verse eid="PRO 21:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>Yon <note caller="+" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="2SA 5:6-9">II Sam 5:6-9</ref></char></note>nonm saj monte sou miray vil pwisan,</para>
  <para style="q1" vid="PRO 21:22">e fè tonbe sitadèl la ki te bay yo konfyans.<verse eid="PRO 21:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">21:23 </char><char style="xt" closed="false"><ref loc="PRO 12:13">Pwov 12:13</ref></char></note>veye bouch li ak lang li</para>
  <para style="q1" vid="PRO 21:23">pwoteje nanm li kont gwo twoub.<verse eid="PRO 21:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>Ògèy, Monte Tèt Wo, Mokè;</para>
  <para style="q1" vid="PRO 21:24">men tit a sila ki aji nan ògèy ak ensolans yo.<verse eid="PRO 21:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>Se <note caller="+" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="PRO 13:4">Pwov 13:4</ref></char></note>volonte a parese a ki fè l mouri,</para>
  <para style="q1" vid="PRO 21:25">paske men li refize travay;<verse eid="PRO 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>Gen moun tout lajounen kap anvi yon bagay,</para>
  <para style="q1" vid="PRO 21:26">pandan moun dwat yo <note caller="+" style="x"><char style="xo" closed="false">21:26 </char><char style="xt" closed="false"><ref loc="PSA 37:26">Sòm 37:26</ref></char></note> ap vèse bay san rete.<verse eid="PRO 21:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>Sakrifis a mechan yo abominab;</para>
  <para style="q1" vid="PRO 21:27">se konbyen anplis, lè l pote ak movèz fwa.<verse eid="PRO 21:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>Yon <note caller="+" style="x"><char style="xo" closed="false">21:28 </char><char style="xt" closed="false"><ref loc="PRO 19:5-9">Pwov 19:5-9</ref></char></note>fo temwen va peri;</para>
  <para style="q1" vid="PRO 21:28">men sila ki koute verite a va pale ak letènite.<verse eid="PRO 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>Moun mechan an afiche yon figi brav;</para>
  <para style="q1" vid="PRO 21:29">men pou <note caller="+" style="x"><char style="xo" closed="false">21:29 </char><char style="xt" closed="false"><ref loc="PSA 119:5">Sòm 119:5</ref></char></note>moun ladwati a, chemen li an sèten.<verse eid="PRO 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:30 </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:23">Jr 9:23</ref>
      </char>
    </note>Nanpwen sajès, ni bon konprann, ni konsèy kont SENYÈ a.<verse eid="PRO 21:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>Cheval la prepare pou jou batay la;</para>
  <para style="q1" vid="PRO 21:31">men <note caller="+" style="x"><char style="xo" closed="false">21:31 </char><char style="xt" closed="false"><ref loc="PSA 3:8">Sòm 3:8</ref></char></note>viktwa a se nan men SENYÈ a.<verse eid="PRO 21:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>Yon <note caller="+" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="PRO 10:7">Pwov 10:7</ref></char></note>bon non pi bon pase tout richès;</para>
  <para style="q1" vid="PRO 22:1">e favè Bondye, pase ajan ak lò.<verse eid="PRO 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>Rich la ak malere a mare ansanm;</para>
  <para style="q1" vid="PRO 22:2">se SENYÈ a ki <note caller="+" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="JOB 31:15">Job 31:15</ref></char></note> fè yo tout.<verse eid="PRO 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="PRO 14:16">Pwov 14:16</ref></char></note>reflechi, wè mal e kache kò li;</para>
  <para style="q1" vid="PRO 22:3">men ensanse yo antre ladann e jwenn pinisyon.<verse eid="PRO 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>Rekonpans pou imilite avèk lakrent SENYÈ a</para>
  <para style="q1" vid="PRO 22:4">se richès, bon repitasyon, ak lavi.<verse eid="PRO 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:5 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:19">Pwov 15:19</ref>
      </char>
    </note>Pikan ak pèlen se nan chemen a pèvès yo;</para>
  <para style="q1" vid="PRO 22:5">sila ki veye nanm li, va rete lwen yo.<verse eid="PRO 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:6 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:4">Ef 6:4</ref>
      </char>
    </note>Leve yon timoun nan chemen li ta dwe ale,</para>
  <para style="q1" vid="PRO 22:6">e lè li vin gran, li p ap kite li;</para>
  <para style="q1" vid="PRO 22:6">menm lè l granmoun, li p ap kite li.<verse eid="PRO 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:7 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:23">Pwov 18:23</ref>
      </char>
    </note>Rich yo domine sou pòv yo,</para>
  <para style="q1" vid="PRO 22:7">e moun ki prete vin esklav a sila k ap bay prè a.<verse eid="PRO 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">22:8 </char><char style="xt" closed="false"><ref loc="JOB 4:8">Job 4:8</ref></char></note>simen inikite a va rekòlte vanite;</para>
  <para style="q1" vid="PRO 22:8">e baton kòlè li a va detwi.<verse eid="PRO 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">22:9 </char><char style="xt" closed="false"><ref loc="PRO 19:17">Pwov 19:17</ref></char></note>bay ak men louvri va beni;</para>
  <para style="q1" vid="PRO 22:9">paske li bay manje a malere.<verse eid="PRO 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:10 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 21:9-10">Jen 21:9-10</ref>
      </char>
    </note>Mete moun k ap moke moun yo deyò,</para>
  <para style="q1" vid="PRO 22:10">e diskisyon an prale tou;</para>
  <para style="q1" vid="PRO 22:10">wi, konfli ak dezonore moun ap sispann.<verse eid="PRO 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>Sila ki renmen <note caller="+" style="x"><char style="xo" closed="false">22:11 </char><char style="xt" closed="false"><ref loc="PSA 24:4">Sòm 24:4</ref></char></note>kè ki san tach</para>
  <para style="q1" vid="PRO 22:11">e ki pale ak gras, va zanmi a wa a.<verse eid="PRO 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>Zye a SENYÈ a konsève konesans;</para>
  <para style="q1" vid="PRO 22:12">men Li boulvèse pawòl moun malveyan yo.<verse eid="PRO 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:13 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 26:13">Pwov 26:13</ref>
      </char>
    </note>Parese a di: “Gen yon lyon deyò a;</para>
  <para style="q1" vid="PRO 22:13">m ap mouri nan lari!”<verse eid="PRO 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>Bouch a <note caller="+" style="x"><char style="xo" closed="false">22:14 </char><char style="xt" closed="false"><ref loc="PRO 21:16">Pwov 21:16</ref></char></note>fanm adiltè a se yon fòs byen fon;</para>
  <para style="q1" vid="PRO 22:14">sila ke SENYÈ a modi va tonbe ladann.<verse eid="PRO 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>Foli mare nan kè a yon timoun;</para>
  <para style="q1" vid="PRO 22:15">baton disiplin nan va retire sa mete lwen li.<verse eid="PRO 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>Sila ki oprime malere a pou ogmante tèt li;</para>
  <para style="q1" vid="PRO 22:16">ni sila k ap fè kado a rich yo, va rive nan povrete.<verse eid="PRO 22:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:17 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 5:1">Pwov 5:1</ref>
      </char>
    </note>Apiye zòrèy ou pou tande pawòl a saj yo;</para>
  <para style="q1" vid="PRO 22:17">epi aplike ou a konesans mwen.<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>Paske sa va <note caller="+" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="PRO 2:10">Pwov 2:10</ref></char></note>byen agreyab pou ou</para>
  <para style="q1" vid="PRO 22:18">si ou kenbe yo anndan ou, pou yo toujou prè sou lèv ou.<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>Pou <note caller="+" style="x"><char style="xo" closed="false">22:19 </char><char style="xt" closed="false"><ref loc="PRO 3:5">Pwov 3:5</ref></char></note>konfyans ou kapab nan SENYÈ a,</para>
  <para style="q1" vid="PRO 22:19">mwen te enstwi ou jodi a, menm ou menm nan.<verse eid="PRO 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20"/>Èske mwen pa t ekri ou trant <note caller="+" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="PRO 8:6">Pwov 8:6</ref></char></note>bèl bagay,</para>
  <para style="q1" vid="PRO 22:20">de konsèy ak konesans yo?<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>Pou fè ou <note caller="+" style="x"><char style="xo" closed="false">22:21 </char><char style="xt" closed="false"><ref loc="LUK 1:3-4">Luc 1:3-4</ref></char></note>konnen vrè pawòl verite yo,</para>
  <para style="q1" vid="PRO 22:21">pou ou kab byen reponn sila ki te voye ou a?<verse eid="PRO 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>Pa vòlè malere a paske li pòv,</para>
  <para style="q1" vid="PRO 22:22">ni <note caller="+" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="ZEC 7:10">Za 7:10</ref> </char></note>kraze aflije nan pòtay la;<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>paske, SENYÈ a va <note caller="+" style="x"><char style="xo" closed="false">22:23 </char><char style="xt" closed="false"><ref loc="1SA 25:39">I Sam 25:39</ref></char></note>plede ka yo</para>
  <para style="q1" vid="PRO 22:23">e pran lavi a sila ki vòlè yo.<verse eid="PRO 22:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>Pa asosye ak yon nonm ki livre a kòlè;</para>
  <para style="q1" vid="PRO 22:24">oswa ale ak yon <note caller="+" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="PRO 29:22">Pwov 29:22</ref></char></note>moun kolerik,<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>sinon, ou va <note caller="+" style="x"><char style="xo" closed="false">22:25 </char><char style="xt" closed="false"><ref loc="1CO 15:33">I Kor 15:33</ref></char></note>aprann mès li yo</para>
  <para style="q1" vid="PRO 22:25">e jwenn yon pèlen pou tèt ou.<verse eid="PRO 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>Pa konte pami sila ki <note caller="+" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="PRO 17:18">Pwov 17:18</ref></char></note>sèvi kon garanti yo,</para>
  <para style="q1" vid="PRO 22:26">pami sila ki fè sekirite pou dèt yo.<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>Si ou pa gen mwayen pou ou kab peye,</para>
  <para style="q1" vid="PRO 22:27">poukisa ou ta kite l <note caller="+" style="x"><char style="xo" closed="false">22:27 </char><char style="xt" closed="false"><ref loc="EXO 22:26">Egz 22:26</ref></char></note>rale kabann nan sòti anba ou?<verse eid="PRO 22:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:28 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 19:14">Det 19:14</ref>
      </char>
    </note>Pa deplase ansyen bòn</para>
  <para style="q1" vid="PRO 22:28">ke papa zansèt nou yo te mete a.<verse eid="PRO 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>Èske ou wè yon nonm byen abil nan travay li?</para>
  <para style="q1" vid="PRO 22:29">Li va <note caller="+" style="x"><char style="xo" closed="false">22:29 </char><char style="xt" closed="false"><ref loc="GEN 41:46">Jen 41:46</ref></char></note>kanpe devan wa yo;</para>
  <para style="q1" vid="PRO 22:29">li p ap oblije kanpe devan nenpòt kalite vye moun.<verse eid="PRO 22:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1"/>Lè ou chita sou tab ak yon ki gouvènè,</para>
  <para style="q1" vid="PRO 23:1">konsidere byen sa ki devan ou.<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>Konsa, mete yon kouto sou gòj ou</para>
  <para style="q1" vid="PRO 23:2">si ou se yon <note caller="+" style="x"><char style="xo" closed="false">23:2 </char><char style="xt" closed="false"><ref loc="PRO 23:20">Pwov 23:20</ref></char></note>nonm ak gwo lanvi.<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>Pa dezire bon manje sa yo,</para>
  <para style="q1" vid="PRO 23:3">paske se yon repa desepsyon.<verse eid="PRO 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>Pa fatige kò ou pou jwenn richès;</para>
  <para style="q1" vid="PRO 23:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">23:4 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:5-7">Pwov 3:5-7</ref> </char>
    </note>sispann reflechi sou sa.<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>Depi ou mete zye ou sou li, l ale.</para>
  <para style="q1" vid="PRO 23:5">Paske, anverite, <note caller="+" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="PRO 27:24">Pwov 27:24</ref></char></note>li gen zèl kon yon èg</para>
  <para style="q1" vid="PRO 23:5">k ap vole vè syèl yo.<verse eid="PRO 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>Pa manje pen a yon <note caller="+" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="DEU 15:9">Det 15:9</ref></char></note>mesye ki chich,</para>
  <para style="q1" vid="PRO 23:6">ni anvi bèl bagay li;<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>paske jan li panse nan tèt li a, se konsa li ye.</para>
  <para style="q1" vid="PRO 23:7">Li di ou: “Manje e bwè!” Men <note caller="+" style="x"><char style="xo" closed="false">23:7 </char><char style="xt" closed="false"><ref loc="PRO 26:24-25">Pwov 26:24-25</ref></char></note>kè li pa avè w.<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>Ou va <note caller="+" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="PRO 25:16">Pwov 25:16</ref></char></note>vomi mòso ke ou te manje a</para>
  <para style="q1" vid="PRO 23:8">e gaspiye tout bèl pawòl ou yo.<verse eid="PRO 23:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:6">Mat 7:6</ref>
      </char>
    </note>Pa pale nan zòrèy a moun sòt,</para>
  <para style="q1" vid="PRO 23:9">paske l ap meprize sajès a pawòl ou yo.<verse eid="PRO 23:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>Pa deplase ansyen bòn nan,</para>
  <para style="q1" vid="PRO 23:10">ni <note caller="+" style="x"><char style="xo" closed="false">23:10 </char><char style="xt" closed="false"><ref loc="JER 22:3">Jr 22:3</ref></char></note>antre nan chan òfelen yo,<verse eid="PRO 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11"/>Paske <note caller="+" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="JOB 19:25">Job 19:25</ref></char></note>Redanmtè yo a pwisan.</para>
  <para style="q1" vid="PRO 23:11">Li va plede ka yo kont ou.<verse eid="PRO 23:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>Aplike kè ou a disiplin</para>
  <para style="q1" vid="PRO 23:12">ak zòrèy ou a pawòl ki pote konesans.<verse eid="PRO 23:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:13 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:24">Pwov 13:24</ref>
      </char>
    </note>Pa ralanti disiplin sou yon timoun;</para>
  <para style="q1" vid="PRO 23:13">malgre ou frape li ak yon baton, li p ap mouri.<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>Ou va frape li ak baton</para>
  <para style="q1" vid="PRO 23:14">pou <note caller="+" style="x"><char style="xo" closed="false">23:14 </char><char style="xt" closed="false"><ref loc="1CO 5:5">I Kor 5:5</ref></char></note>delivre nanm li de sejou mò yo.<verse eid="PRO 23:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>Fis mwen an, si kè ou <note caller="+" style="x"><char style="xo" closed="false">23:15 </char><char style="xt" closed="false"><ref loc="PRO 23:24">Pwov 23:24</ref></char></note>saj,</para>
  <para style="q1" vid="PRO 23:15">pwòp kè m va kontan tou.<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>Wi, jis anndan m va rejwi</para>
  <para style="q1" vid="PRO 23:16">lè lèv ou pale <note caller="+" style="x"><char style="xo" closed="false">23:16 </char><char style="xt" closed="false"><ref loc="PRO 8:6">Pwov 8:6</ref></char></note>sa ki dwat.<verse eid="PRO 23:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:17 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:1">Sòm 37:1</ref>
      </char>
    </note>Pa kite kè ou fè lanvi pechè yo,</para>
  <para style="q1" vid="PRO 23:17">men viv nan lakrent SENYÈ a tout tan.<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>Anverite, gen davni,</para>
  <para style="q1" vid="PRO 23:18">e <note caller="+" style="x"><char style="xo" closed="false">23:18 </char><char style="xt" closed="false"><ref loc="PSA 9:18">Sòm 9:18</ref></char></note>espwa ou p ap anile.<verse eid="PRO 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>Koute, fis mwen an, vin saj</para>
  <para style="q1" vid="PRO 23:19">pou <note caller="+" style="x"><char style="xo" closed="false">23:19 </char><char style="xt" closed="false"><ref loc="PRO 4:23">Pwov 4:23</ref> </char></note>dirije kè ou nan chemen an.<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>Pa bwè twòp diven,</para>
  <para style="q1" vid="PRO 23:20">ni fè <note caller="+" style="x"><char style="xo" closed="false">23:20 </char><char style="xt" closed="false"><ref loc="DEU 21:20">Det 21:20</ref> </char></note>voras nan manje vyann;<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>paske sila ki <note caller="+" style="x"><char style="xo" closed="false">23:21 </char><char style="xt" closed="false"><ref loc="PRO 21:17">Pwov 21:17</ref></char></note>bwè twòp la ak moun voras la va vin pòv;</para>
  <para style="q1" vid="PRO 23:21">e dòmi nan zye a va fè l abiye ak vye twal chire.<verse eid="PRO 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:22 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:8">Pwov 1:8</ref>
      </char>
    </note>Koute papa ou ki te fè ou a,</para>
  <para style="q1" vid="PRO 23:22">e pa meprize manman ou lè l vin granmoun.<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:23 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 4:7">Pwov 4:7</ref>
      </char>
    </note>Achte verite e pa vann li!</para>
  <para style="q1" vid="PRO 23:23">Ranmase sajès, enstriksyon ak bon konprann.<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>Papa a sila ki dwat la va rejwi anpil,</para>
  <para style="q1" vid="PRO 23:24">e <note caller="+" style="x"><char style="xo" closed="false">23:24 </char><char style="xt" closed="false"><ref loc="PRO 10:1">Pwov 10:1</ref></char></note>sila ki fè yon fis ki saj la va gen kè kontan nan li.<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>Kite <note caller="+" style="x"><char style="xo" closed="false">23:25 </char><char style="xt" closed="false"><ref loc="PRO 27:11">Pwov 27:11</ref></char></note>papa ou ak manman ou fè kè kontan;</para>
  <para style="q1" vid="PRO 23:25">kite fanm ki te fè ou a, rejwi.<verse eid="PRO 23:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>Ban m kè ou, fis mwen an;</para>
  <para style="q1" vid="PRO 23:26">kite zye ou <note caller="+" style="x"><char style="xo" closed="false">23:26 </char><char style="xt" closed="false"><ref loc="PSA 1:2">Sòm 1:2</ref> </char></note>fè kè kontan nan chemen mwen yo.<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>Paske yon pwostitiye se yon fòs byen fon,</para>
  <para style="q1" vid="PRO 23:27">e yon <note caller="+" style="x"><char style="xo" closed="false">23:27 </char><char style="xt" closed="false"><ref loc="PRO 5:20">Pwov 5:20</ref> </char></note>fanm adiltè se yon ti pwi etwat.<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>Anverite, li <note caller="+" style="x"><char style="xo" closed="false">23:28 </char><char style="xt" closed="false"><ref loc="PRO 6:26">Pwov 6:26</ref></char></note>kache veye tankou vòlè,</para>
  <para style="q1" vid="PRO 23:28">pou l ogmante enfidelite pami lòm.<verse eid="PRO 23:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>Se kilès ki gen <note caller="+" style="x"><char style="xo" closed="false">23:29 </char><char style="xt" closed="false"><ref loc="ISA 5:11-22">És 5:11-22</ref></char></note>gwo pwoblèm?</para>
  <para style="q1" vid="PRO 23:29">Se kilès ki gen tristès?</para>
  <para style="q1" vid="PRO 23:29">Se kilès ki gen konfli?</para>
  <para style="q1" vid="PRO 23:29">Se kilès kap plenyèn?</para>
  <para style="q1" vid="PRO 23:29">Se kilès ki blese san rezon?</para>
  <para style="q1" vid="PRO 23:29">Se kilès ki gen zye wouj?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="1SA 25:36">I Sam 25:36</ref></char></note>mize sou diven nan,</para>
  <para style="q1" vid="PRO 23:30">sila ki ale goute diven mele an.<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>Pa gade diven an lè l wouj,</para>
  <para style="q1" vid="PRO 23:31">lè l fè klè nan tas la,</para>
  <para style="q1" vid="PRO 23:31">lè l <note caller="+" style="x"><char style="xo" closed="false">23:31 </char><char style="xt" closed="false"><ref loc="SNG 7:9">Kan 7:9</ref></char></note>desann byen dous.<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>Nan dènye moman an, li <note caller="+" style="x"><char style="xo" closed="false">23:32 </char><char style="xt" closed="false"><ref loc="JOB 20:16">Job 20:16</ref></char></note>mòde tankou sèpan;</para>
  <para style="q1" vid="PRO 23:32">li brile tankou bouch koulèv.<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>Zye ou va wè bagay ki dwòl,</para>
  <para style="q1" vid="PRO 23:33">e panse ou va <note caller="+" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="PRO 2:12">Pwov 2:12</ref></char></note>twouble anpil.<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>Ou va tankou yon moun ki kouche nan mitan lanmè,</para>
  <para style="q1" vid="PRO 23:34">oswa tankou yon moun ki kouche sou ma batiman.<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>“Yo te frape m, men mwen pa t santi anyen!</para>
  <para style="q1" vid="PRO 23:35">Yo te bat mwen, men mwen pa t konnen sa!</para>
  <para style="q1" vid="PRO 23:35">Lè m leve, m ap <note caller="+" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="PRO 26:11">Pwov 26:11</ref></char></note>chache pou m kab bwè ankò.”<verse eid="PRO 23:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>Pa fè anvi a moun mechan,</para>
  <para style="q1" vid="PRO 24:1">ni dezire <note caller="+" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="PSA 1:1">Sòm 1:1</ref> </char></note>pou avèk yo;<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>paske panse yo fòmante <note caller="+" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="ISA 30:12">És 30:12</ref></char></note>vyolans</para>
  <para style="q1" vid="PRO 24:2">e lèv yo pale inikite.<verse eid="PRO 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:3 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 9:1">Pwov 9:1</ref>
      </char>
    </note>Avèk sajès, kay la bati</para>
  <para style="q1" vid="PRO 24:3">e avèk bon konprann, li vin etabli.<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>Pa konesans, chanm yon moun vin</para>
  <para style="q1" vid="PRO 24:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">24:4 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:21">Pwov 8:21</ref>
      </char>
    </note>ranpli avèk tout bèl kalite richès.<verse eid="PRO 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>Yon nonm saj byen fò,</para>
  <para style="q1" vid="PRO 24:5">e yon nonm ak konesans ogmante pouvwa li.<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>Paske ak konsèy saj ou va fè lagè,</para>
  <para style="q1" vid="PRO 24:6">e <note caller="+" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="PRO 11:14">Pwov 11:14</ref></char></note>ak konseye an abondans, gen viktwa.<verse eid="PRO 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>Sajès <note caller="+" style="x"><char style="xo" closed="false">24:7 </char><char style="xt" closed="false"><ref loc="PSA 10:5">Sòm 10:5</ref></char></note>twò wo pou moun ensanse a;</para>
  <para style="q1" vid="PRO 24:7">li pa ouvri bouch li nan pòtay la.<verse eid="PRO 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>Yon moun ki fè plan pou fè mal,</para>
  <para style="q1" vid="PRO 24:8">moun va rele li magouyè.<verse eid="PRO 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>Fòmante foli se peche,</para>
  <para style="q1" vid="PRO 24:9">e mokè a abominab a tout moun.<verse eid="PRO 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>Si ou <note caller="+" style="x"><char style="xo" closed="false">24:10 </char><char style="xt" closed="false"><ref loc="DEU 20:8">Det 20:8</ref></char></note>lach nan jou gran pwoblèm nan, fòs ou pa fò.<verse eid="PRO 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 82:4">Sòm 82:4</ref>
      </char>
    </note>Delivre sila k ap mennen vè lanmò a,</para>
  <para style="q1" vid="PRO 24:11">ak sila k ap mache tonbe vè labatwa a.</para>
  <para style="q1" vid="PRO 24:11">O, kenbe yo!<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>Si ou di: “Gade, nou pa t konnen sa”;</para>
  <para style="q1" vid="PRO 24:12">èske Li pa <note caller="+" style="x"><char style="xo" closed="false">24:12 </char><char style="xt" closed="false"><ref loc="ECC 5:8">Ekl 5:8</ref></char></note>konsidere sa, sila ki peze kè?</para>
  <para style="q1" vid="PRO 24:12">Epi èske Li pa konnen sa, sila kap kenbe nanm ou an?</para>
  <para style="q1" vid="PRO 24:12">Èske Li p ap rann a lòm selon zèv li?<verse eid="PRO 24:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>Fis mwen, manje <note caller="+" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="PSA 19:10">Sòm 19:10</ref></char></note>siwo myèl, paske li bon;</para>
  <para style="q1" vid="PRO 24:13">wi, siwo sòti nan nich lan dous pou goute.<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>Konnen ke <note caller="+" style="x"><char style="xo" closed="false">24:14 </char><char style="xt" closed="false"><ref loc="PRO 2:10">Pwov 2:10</ref></char></note>sajès se konsa pou nanm ou;</para>
  <para style="q1" vid="PRO 24:14">si ou twouve li, va gen yon avni, e espwa ou p ap anile.<verse eid="PRO 24:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:15 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:9-10">Sòm 10:9-10</ref>
      </char>
    </note>Pa kouche mete pyèj, o lòm mechan,</para>
  <para style="q1" vid="PRO 24:15">kont kote ke moun dwat la rete a.</para>
  <para style="q1" vid="PRO 24:15">Pa detwi kote repo li a;<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>paske yon <note caller="+" style="x"><char style="xo" closed="false">24:16 </char><char style="xt" closed="false"><ref loc="JOB 5:19">Job 5:19</ref></char></note>nonm ladwati tonbe sèt fwa e leve ankò,</para>
  <para style="q1" vid="PRO 24:16">men se nan lè gwo malè ke mechan an tonbe.<verse eid="PRO 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:17 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 31:29">Job 31:29</ref>
      </char>
    </note>Pa rejwi lè lènmi ou tonbe.</para>
  <para style="q1" vid="PRO 24:17">Ni pa kite kè ou kontan lè l tonbe;<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>Oswa, SENYÈ a va wè l,</para>
  <para style="q1" vid="PRO 24:18">vin pa kontan e detounen kòlè Li de li.<verse eid="PRO 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:19 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:1">Sòm 37:1</ref>
      </char>
    </note>Pa twouble tèt ou pou malveyan yo,</para>
  <para style="q1" vid="PRO 24:19">ni fè lanvi pou mechan yo,<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>paske pou yon nonm mechan, <note caller="+" style="x"><char style="xo" closed="false">24:20 </char><char style="xt" closed="false"><ref loc="JOB 15:31">Job 15:31</ref></char></note>pa gen avni.</para>
  <para style="q1" vid="PRO 24:20">Lanp a mechan an va etenn nèt.<verse eid="PRO 24:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>Fis mwen an, <note caller="+" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ROM 13:1-7">Wo 13:1-7</ref></char></note>gen lakrent SENYÈ a ak wa a;</para>
  <para style="q1" vid="PRO 24:21">pa asosye ak sila ki pa stab yo,<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>paske, <note caller="+" style="x"><char style="xo" closed="false">24:22 </char><char style="xt" closed="false"><ref loc="PRO 24:16">Pwov 24:16</ref></char></note>malè yo va leve vit.</para>
  <para style="q1" vid="PRO 24:22">Kilès ki konnen destriksyon an k ap sòti nan yo de a.<verse eid="PRO 24:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 24:23"/>Sila yo, anplis, se pawòl a sajès:</para>
  <para style="b" vid="PRO 24:23"/>
  <para style="q1" vid="PRO 24:23">Fè <note caller="+" style="x"><char style="xo" closed="false">24:23 </char><char style="xt" closed="false"><ref loc="PRO 18:5">Pwov 18:5</ref></char></note> patipri nan jijman pa bon.<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>Sila ki di a mechan an: “Ou dwat”,</para>
  <para style="q1" vid="PRO 24:24">
    <note caller="+" style="x">
      <char style="xo" closed="false">24:24 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 11:26">Pwov 11:26</ref> </char>
    </note>pèp yo va modi li e nasyon yo va rayi li;<verse eid="PRO 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>men pou <note caller="+" style="x"><char style="xo" closed="false">24:25 </char><char style="xt" closed="false"><ref loc="PRO 28:23">Pwov 28:23</ref></char></note>sila ki repwoche mechan yo,</para>
  <para style="q1" vid="PRO 24:25">lap wale byen ak yo.</para>
  <para style="q1" vid="PRO 24:25">Bon benediksyon va tonbe sou yo.<verse eid="PRO 24:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>Yon repons onèt tankou yon bo sou lèv yo.<verse eid="PRO 24:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>Prepare tout travay ou a deyò;</para>
  <para style="q1" vid="PRO 24:27">byen prepare chan ou.</para>
  <para style="q1" vid="PRO 24:27">Apre, alò, bati kay ou.<verse eid="PRO 24:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>Pa vin yon temwen kont vwazen ou san koz,</para>
  <para style="q1" vid="PRO 24:28">e <note caller="+" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LEV 6:2-3">Lev 6:2-3</ref></char></note>pa bay manti ak lèv ou.<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:29 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:22">Pwov 20:22</ref>
      </char>
    </note>Pa di: “Se konsa mwen va fè l paske li te fè m konsa;</para>
  <para style="q1" vid="PRO 24:29">mwen va rann a nonm nan selon zèv li yo.”<verse eid="PRO 24:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>Mwen te pase nan chan parese a;</para>
  <para style="q1" vid="PRO 24:30">akote chan rezen a nonm ki manke <note caller="+" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="PRO 6:22">Pwov 6:22</ref></char></note>bon konprann nan.<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>Epi gade byen, li te plen ak raje pikan,</para>
  <para style="q1" vid="PRO 24:31">e kouvri ak move zèb,</para>
  <para style="q1" vid="PRO 24:31">
    <note caller="+" style="x">
      <char style="xo" closed="false">24:31 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:5">És 5:5</ref> </char>
    </note>Miray an wòch la te fin kraze nèt.<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>Lè m te wè, mwen te reflechi sou sa;</para>
  <para style="q1" vid="PRO 24:32">mwen te gade e m te resevwa enstriksyon.<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:33 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:10">Pwov 6:10</ref>
      </char>
    </note>“Yon ti dòmi, yon ti somèy,</para>
  <para style="q1" vid="PRO 24:33">yon ti pliye men pou repoze,”<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>Konsa mizè ou va vin parèt sou ou tankou yon vòlè;</para>
  <para style="q1" vid="PRO 24:34">ak bezwen tankou yon bandi kon zam.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>Sila yo se <note caller="+" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="PRO 1:1">Pwov 1:1</ref></char></note>pwovèb yo a Salomon ke mesye Ézéchias yo, wa Juda a te dechifre.<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>Se glwa Bondye pou kache yon bagay;</para>
  <para style="q1" vid="PRO 25:2">men se glwa a <note caller="+" style="x"><char style="xo" closed="false">25:2 </char><char style="xt" closed="false"><ref loc="EZR 6:1">Esd 6:1</ref> </char></note>wa yo pou chache konprann yon bagay.<verse eid="PRO 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>Tankou syèl la nan wotè a, ak tè a nan pwofondè a,</para>
  <para style="q1" vid="PRO 25:3">se konsa kè a wa a ensondab.<verse eid="PRO 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>Retire vye kras sou ajan k ap fonn nan, e va sòti metal pi pou òfèv la.<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>Retire <note caller="+" style="x"><char style="xo" closed="false">25:5 </char><char style="xt" closed="false"><ref loc="PRO 20:8">Pwov 20:8</ref></char></note>mechan an devan wa a,</para>
  <para style="q1" vid="PRO 25:5">e twòn li an va etabli nan ladwati.<verse eid="PRO 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>Pa reklame bèl repitasyon nan prezans a wa a,</para>
  <para style="q1" vid="PRO 25:6">e pa kanpe nan plas a moun pwisan yo;<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>paske li pi bon pou yo di ou: “Vin monte isit la”,</para>
  <para style="q1" vid="PRO 25:7">olye pou ou ta oblije desann piba nan prezans a prens lan,</para>
  <para style="q1" vid="PRO 25:7">ke zye ou te wè.<verse eid="PRO 25:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8"/>Pa fè vit lantre nan tribinal <note caller="+" style="x"><char style="xo" closed="false">25:8 </char><char style="xt" closed="false"><ref loc="PRO 17:14">Pwov 17:14</ref></char></note>pou diskite ka ou;</para>
  <para style="q1" vid="PRO 25:8">anfen, sa ou va fè lè vwazen ou fè ou desann nèt.<verse eid="PRO 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:15">Mat 18:15</ref>
      </char>
    </note>Diskite pwòp ka pa ou devan vwazen ou,</para>
  <para style="q1" vid="PRO 25:9">e pa devwale sekrè a yon lòt,<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>oswa sila ki tande ou a, va fè ou repwòch,</para>
  <para style="q1" vid="PRO 25:10">e move rapò sou ou menm p ap janm disparèt.<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>Tankou pòm an lò ki monte sou ajan,</para>
  <para style="q1" vid="PRO 25:11">se konsa yon <note caller="+" style="x"><char style="xo" closed="false">25:11 </char><char style="xt" closed="false"><ref loc="PRO 15:23">Pwov 15:23</ref></char></note>mo byen plase nan moman li.<verse eid="PRO 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>Tankou yon <note caller="+" style="x"><char style="xo" closed="false">25:12 </char><char style="xt" closed="false"><ref loc="EXO 32:2">Egz 32:2</ref></char></note>zanno an lò ak yon dekorasyon an lò fen</para>
  <para style="q1" vid="PRO 25:12">se yon repwòch saj nan zòrèy k ap koute.<verse eid="PRO 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>Tankou fredi lanèj nan lè rekòlt,</para>
  <para style="q1" vid="PRO 25:13">se konsa yon <note caller="+" style="x"><char style="xo" closed="false">25:13 </char><char style="xt" closed="false"><ref loc="PRO 13:17">Pwov 13:17</ref></char></note>mesaje fidèl ye a sila ki voye l yo,</para>
  <para style="q1" vid="PRO 25:13">paske li rafrechi nanm a mèt li yo.<verse eid="PRO 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>Tankou <note caller="+" style="x"><char style="xo" closed="false">25:14 </char><char style="xt" closed="false"><ref loc="JUD 1:12">Jd 12</ref></char></note>nwaj ak van san lapli,</para>
  <para style="q1" vid="PRO 25:14">se konsa yon nonm ki ogmante don li yo ak manti.<verse eid="PRO 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>Ak <note caller="+" style="x"><char style="xo" closed="false">25:15 </char><char style="xt" closed="false"><ref loc="GEN 32:4">Jen 32:4</ref></char></note>pasyans, yon chèf ka vin pèswade;</para>
  <para style="q1" vid="PRO 25:15">se yon lang dous ki kase zo.<verse eid="PRO 25:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>Èske ou te <note caller="+" style="x"><char style="xo" closed="false">25:16 </char><char style="xt" closed="false"><ref loc="JDG 14:8">Jij 14:8</ref></char></note>jwenn siwo myèl?</para>
  <para style="q1" vid="PRO 25:16">Manje sèlman kont ou,</para>
  <para style="q1" vid="PRO 25:16">pou ou pa gen twòp pou vomi li.<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>Kite pye ou raman pile lakay vwazen ou,</para>
  <para style="q1" vid="PRO 25:17">sinon li va fatige avè w, e vin rayi ou.<verse eid="PRO 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>Tankou gwo baton, nepe, oswa flèch file,</para>
  <para style="q1" vid="PRO 25:18">se konsa yon nonm ki pote <note caller="+" style="x"><char style="xo" closed="false">25:18 </char><char style="xt" closed="false"><ref loc="EXO 20:16">Egz 20:16</ref></char></note>fo temwen kont vwazen li.<verse eid="PRO 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>Tankou yon move dan ak yon pye ki pa estab,</para>
  <para style="q1" vid="PRO 25:19">se konsa konfyans nan yon <note caller="+" style="x"><char style="xo" closed="false">25:19 </char><char style="xt" closed="false"><ref loc="JOB 6:15">Job 6:15</ref></char></note>nonm enfidèl nan tan gwo twoub.<verse eid="PRO 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>Tankou yon moun ki retire rad li nan jou fredi,</para>
  <para style="q1" vid="PRO 25:20">oswa tankou vinèg sou poud bikabonat,</para>
  <para style="q1" vid="PRO 25:20">se konsa sila ki chante chan ak kè twouble yo ye.<verse eid="PRO 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:21 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 23:4-5">Egz 23:4-5</ref>
      </char>
    </note>Si lènmi ou grangou, ba li manje;</para>
  <para style="q1" vid="PRO 25:21">epi si li swaf, ba li dlo pou l bwè;<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>paske, ou va anpile chabon tou limen sou tèt li,</para>
  <para style="q1" vid="PRO 25:22">e <note caller="+" style="x"><char style="xo" closed="false">25:22 </char><char style="xt" closed="false"><ref loc="2SA 16:12">II Sam 16:12</ref></char></note>SENYÈ a va bay ou rekonpans.<verse eid="PRO 25:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>Van nò pote lapli</para>
  <para style="q1" vid="PRO 25:23">e yon <note caller="+" style="x"><char style="xo" closed="false">25:23 </char><char style="xt" closed="false"><ref loc="PSA 101:5">Sòm 101:5</ref></char></note>lang medizan, pote yon move vizaj.<verse eid="PRO 25:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>Li <note caller="+" style="x"><char style="xo" closed="false">25:24 </char><char style="xt" closed="false"><ref loc="PRO 21:9">Pwov 21:9</ref></char></note>pi bon pou viv nan yon kwen twati</para>
  <para style="q1" vid="PRO 25:24">pase nan yon kay avèk yon fanm k ap fè kont tout tan.<verse eid="PRO 25:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>Tankou dlo frèt pou yon nanm fatige,</para>
  <para style="q1" vid="PRO 25:25">se konsa yon <note caller="+" style="x"><char style="xo" closed="false">25:25 </char><char style="xt" closed="false"><ref loc="PRO 15:30">Pwov 15:30</ref></char></note>bòn nouvèl ki sòti nan yon peyi lwen.<verse eid="PRO 25:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>Tankou yon <note caller="+" style="x"><char style="xo" closed="false">25:26 </char><char style="xt" closed="false"><ref loc="EZK 32:2">Éz 32:2</ref></char></note>sous ki foule anba pye ak yon pwi kontamine,</para>
  <para style="q1" vid="PRO 25:26">se konsa yon nonm dwat ki bay plas a mechan an.<verse eid="PRO 25:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>Li pa bon pou bwè anpil siwo myèl,</para>
  <para style="q1" vid="PRO 25:27">ni li pa bon pou <note caller="+" style="x"><char style="xo" closed="false">25:27 </char><char style="xt" closed="false"><ref loc="PRO 27:2">Pwov 27:2</ref></char></note>chache pwòp glwa pa w.<verse eid="PRO 25:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>Tankou yon gran vil ki kase antre san miray,</para>
  <para style="q1" vid="PRO 25:28">se konsa yon nonm ki <note caller="+" style="x"><char style="xo" closed="false">25:28 </char><char style="xt" closed="false"><ref loc="2CH 32:5">II Kwo 32:5</ref> </char></note>pa kontwole pwòp tèt li.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1"/>Tankou lanèj nan sezon chalè a, tankou lapli nan sezon rekòlt,</para>
  <para style="q1" vid="PRO 26:1">se konsa respè <note caller="+" style="x"><char style="xo" closed="false">26:1 </char><char style="xt" closed="false"><ref loc="PRO 17:7">Pwov 17:7</ref> </char></note>pa merite rive sou yon moun ensanse.<verse eid="PRO 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>Tankou yon ti zwazo k ap sove ale, tankou yon ti iwondèl nan vòl li,</para>
  <para style="q1" vid="PRO 26:2">se konsa yon <note caller="+" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="NUM 23:8">Nonb 23:8</ref></char></note>madichon san koz p ap poze.<verse eid="PRO 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>Yon fwèt se pou chwal la, yon brid pou bourik la,</para>
  <para style="q1" vid="PRO 26:3">ak <note caller="+" style="x"><char style="xo" closed="false">26:3 </char><char style="xt" closed="false"><ref loc="PRO 10:13">Pwov 10:13</ref></char></note>baton pou do a moun ensanse a.<verse eid="PRO 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:4 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:9">Pwov 23:9</ref>
      </char>
    </note>Pa reponn yon moun ensanse selon foli li,</para>
  <para style="q1" vid="PRO 26:4">oswa ou va vin tankou li.<verse eid="PRO 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:5 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:1-4">Mat 16:1-4</ref>
      </char>
    </note>Reponn yon moun ensanse selon foli li merite,</para>
  <para style="q1" vid="PRO 26:5">pou l pa vin saj nan pwòp zye li.<verse eid="PRO 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>Li koupe pwòp pye li, e bwè vyolans,</para>
  <para style="q1" vid="PRO 26:6">ki voye yon mesaj pa men a moun ensanse a.<verse eid="PRO 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>Tankou janm ki initil pou moun bwate a,</para>
  <para style="q1" vid="PRO 26:7">se konsa yon pwovèb nan bouch a moun ensanse.<verse eid="PRO 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>Tankou yon moun ki mare wòch anndan fistibal</para>
  <para style="q1" vid="PRO 26:8">se konsa sila ki bay respè a moun ensanse a.<verse eid="PRO 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9"/>Tankou yon pikan ki tonbe nan men yon moun k ap bwè gwòg,</para>
  <para style="q1" vid="PRO 26:9">se konsa yon pwovèb nan bouch a moun ki ensanse.<verse eid="PRO 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10"/>Tankou moun ak banza k ap blese tout moun,</para>
  <para style="q1" vid="PRO 26:10">se konsa sila ki anplwaye moun ensanse a,</para>
  <para style="q1" vid="PRO 26:10">ak sila ki anplwaye sila k ap pase pa aza a.<verse eid="PRO 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11"/>Tankou <note caller="+" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="2PE 2:22">II Pi 2:22</ref></char></note>yon chen ki retounen nan vomi li,</para>
  <para style="q1" vid="PRO 26:11">se konsa yon moun ensanse kap repete foli li.<verse eid="PRO 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12"/>Èske ou wè yon moun ki saj nan pwòp zye li?</para>
  <para style="q1" vid="PRO 26:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">26:12 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 29:20">Pwov 29:20</ref> </char>
    </note>Gen plis espwa pou moun fou pase li menm.<verse eid="PRO 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:13 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 22:13">Pwov 22:13</ref>
      </char>
    </note>Parese a di: “Gen yon lyon nan lari a!</para>
  <para style="q1" vid="PRO 26:13">Yon lyon nan plas la!”<verse eid="PRO 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14"/>Tankou pòt la vire sou gon li,</para>
  <para style="q1" vid="PRO 26:14">se konsa <note caller="+" style="x"><char style="xo" closed="false">26:14 </char><char style="xt" closed="false"><ref loc="PRO 6:9">Pwov 6:9</ref></char></note>parese a sou kabann li.<verse eid="PRO 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:15 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:24">Pwov 19:24</ref>
      </char>
    </note>Parese a fouye men l nan plato a;</para>
  <para style="q1" vid="PRO 26:15">men l twò fatige pou fè l ankò rive nan bouch li.<verse eid="PRO 26:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16"/>Parese a <note caller="+" style="x"><char style="xo" closed="false">26:16 </char><char style="xt" closed="false"><ref loc="PRO 27:11">Pwov 27:11</ref></char></note>pi saj nan pwòp zye li</para>
  <para style="q1" vid="PRO 26:16">pase sèt moun ki kab reponn ak bon konprann.<verse eid="PRO 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17"/>Tankou yon moun ki pran yon chen pa zòrèy,</para>
  <para style="q1" vid="PRO 26:17">se konsa sila k ap pase pa aza a,</para>
  <para style="q1" vid="PRO 26:17">pou l gaye nan goumen ki pa apatyen a li menm nan.<verse eid="PRO 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18"/>Tankou yon moun fou k ap jete <note caller="+" style="x"><char style="xo" closed="false">26:18 </char><char style="xt" closed="false"><ref loc="ISA 50:11">És 50:11</ref></char></note>bwa dife, flèch ak lanmò,<verse eid="PRO 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19"/>se konsa nonm ki tronpe vwazen li an pou di:</para>
  <para style="q1" vid="PRO 26:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">26:19 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:4">Ef 5:4</ref> </char>
    </note>“Èske se pa blag mwen t ap fè?”<verse eid="PRO 26:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20"/>Akoz mank bwa, dife a etenn;</para>
  <para style="q1" vid="PRO 26:20">lè ti koze sispann, <note caller="+" style="x"><char style="xo" closed="false">26:20 </char><char style="xt" closed="false"><ref loc="PRO 22:10">Pwov 22:10</ref> </char></note>rayisman vin kalme.<verse eid="PRO 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>Tankou chabon tou limen anvè sann cho, ak bwa anvè dife,</para>
  <para style="q1" vid="PRO 26:21">se konsa yon moun tchenpwèt <note caller="+" style="x"><char style="xo" closed="false">26:21 </char><char style="xt" closed="false"><ref loc="PRO 15:18">Pwov 15:18</ref></char></note> chofe pwoblèm pou limen konfli.<verse eid="PRO 26:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:22 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 18:8">Pwov 18:8</ref>
      </char>
    </note>Pawòl a moun k ap chichote nan zòrèy moun nan,</para>
  <para style="q1" vid="PRO 26:22">vin tankou bèl ti mòso delika.</para>
  <para style="q1" vid="PRO 26:22">Yo desann rive jis nan pati pi fon kò a.<verse eid="PRO 26:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23"/>Tankou veso ki fèt ak tè ki kouvri ak yon kouch ajan,</para>
  <para style="q1" vid="PRO 26:23">se konsa lèv ki brile ak yon kè ki mechan.<verse eid="PRO 26:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24"/>Yon nonm malonèt, <note caller="+" style="x"><char style="xo" closed="false">26:24 </char><char style="xt" closed="false"><ref loc="PSA 41:6">Sòm 41:6</ref></char></note>kache sa pou l pa parèt sou lèv li;</para>
  <para style="q1" vid="PRO 26:24">men nan kè l, li fè depo desepsyon.<verse eid="PRO 26:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25"/>Lè l <note caller="+" style="x"><char style="xo" closed="false">26:25 </char><char style="xt" closed="false"><ref loc="PSA 28:3">Sòm 28:3</ref></char></note>pale byen dous, pa kwè l;</para>
  <para style="q1" vid="PRO 26:25">paske, gen sèt abominasyon nan kè l.<verse eid="PRO 26:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26"/>Malgre rayisman kouvri kò l ak riz,</para>
  <para style="q1" vid="PRO 26:26">mechanste li va <note caller="+" style="x"><char style="xo" closed="false">26:26 </char><char style="xt" closed="false"><ref loc="LUK 8:17">Luc 8:17</ref> </char></note>devwale devan asanble a.<verse eid="PRO 26:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">26:27 </char><char style="xt" closed="false"><ref loc="EST 7:10">Est 7:10</ref></char></note>fouye fòs la va tonbe ladann,</para>
  <para style="q1" vid="PRO 26:27">e sila ki woule wòch la, sou li menm l ap retounen.<verse eid="PRO 26:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28"/>Yon lang ki bay manti, rayi sila li kraze yo,</para>
  <para style="q1" vid="PRO 26:28">e zèv a lang flatè a se dega.<verse eid="PRO 26:28"/></para>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1"/>Pa vin ògeye sou bagay demen,</para>
  <para style="q1" vid="PRO 27:1">paske ou <note caller="+" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="LUK 12:19-20">Luc 12:19-20</ref> </char></note>pa konnen kisa yon jou ka pote.<verse eid="PRO 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>Kite <note caller="+" style="x"><char style="xo" closed="false">27:2 </char><char style="xt" closed="false"><ref loc="PRO 25:27">Pwov 25:27</ref></char></note>yon lòt moun ba ou lwanj,</para>
  <para style="q1" vid="PRO 27:2">e pa fè ak pwòp bouch ou.</para>
  <para style="q1" vid="PRO 27:2">Kite l fèt pa yon ou pa konnen,</para>
  <para style="q1" vid="PRO 27:2">e pa de pwòp lèv ou.<verse eid="PRO 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>Yon gwo wòch lou ak sab gen pwa;</para>
  <para style="q1" vid="PRO 27:3">men moun ensanse k ap anmède a</para>
  <para style="q1" vid="PRO 27:3">pi lou pase yo tou de.<verse eid="PRO 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>Fachez rèd fè move.</para>
  <para style="q1" vid="PRO 27:4">Kòlè se yon inondasyon.</para>
  <para style="q1" vid="PRO 27:4">Men se <note caller="+" style="x"><char style="xo" closed="false">27:4 </char><char style="xt" closed="false"><ref loc="PRO 6:34">Pwov 6:34</ref></char></note>kilès ki ka kanpe devan jalouzi.<verse eid="PRO 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>Repwòch ki klè pi bon pase lanmou ki kache.<verse eid="PRO 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>Fidèl se blese a yon zanmi;</para>
  <para style="q1" vid="PRO 27:6">men twonpri se <note caller="+" style="x"><char style="xo" closed="false">27:6 </char><char style="xt" closed="false"><ref loc="MAT 26:49">Mat 26:49</ref></char></note>bo a yon ènmi.<verse eid="PRO 27:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>Moun vant plen rayi siwo myèl;</para>
  <para style="q1" vid="PRO 27:7">men pou sila ki grangou,</para>
  <para style="q1" vid="PRO 27:7">nenpòt bagay anmè vin dous.<verse eid="PRO 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>Tankou yon <note caller="+" style="x"><char style="xo" closed="false">27:8 </char><char style="xt" closed="false"><ref loc="PRO 26:2">Pwov 26:2</ref></char></note>zwazo ki egare nich li,</para>
  <para style="q1" vid="PRO 27:8">se konsa yon nonm ki mache lwen kay li.<verse eid="PRO 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:5">Sòm 23:5</ref>
      </char>
    </note>Lwil ak pafen fè kè kontan;</para>
  <para style="q1" vid="PRO 27:9">se konsa konsèy a yon nonm dous pou zanmi li.<verse eid="PRO 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>Pa abandone pwòp zanmi ou, ni <note caller="+" style="x"><char style="xo" closed="false">27:10 </char><char style="xt" closed="false"><ref loc="1KI 12:6-8">I Wa 12:6-8</ref></char></note>zanmi a papa ou.</para>
  <para style="q1" vid="PRO 27:10">Pa ale lakay frè ou nan jou malè ou.</para>
  <para style="q1" vid="PRO 27:10">Pi bon se yon vwazen toupre pase yon frè ki byen lwen.<verse eid="PRO 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:11 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 10:1">Pwov 10:1</ref>
      </char>
    </note>Sèvi ak sajès, fis mwen,</para>
  <para style="q1" vid="PRO 27:11">e fè kè m kontan pou m kab reponn sila ki repwoche mwen an.<verse eid="PRO 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>Yon nonm ki saj wè mal e li kache kò l;</para>
  <para style="q1" vid="PRO 27:12">men sila ki fou a avanse pou peye pri a.<verse eid="PRO 27:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>Pran vètman li lè l sèvi garanti pou yon enkoni,</para>
  <para style="q1" vid="PRO 27:13">e pou yon fanm adiltè, kenbe mesye a menm kon garanti a.<verse eid="PRO 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>Sila ki beni zanmi li ak gwo vwa bonè maten an,</para>
  <para style="q1" vid="PRO 27:14">sa va rekonèt kon madichon pou li.<verse eid="PRO 27:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:15 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:13">Pwov 19:13</ref>
      </char>
    </note>Dlo k ap degoute san rete nan jou gwo lapli</para>
  <para style="q1" vid="PRO 27:15">avèk fanm k ap fè kont san rete sòti menm jan:<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>Sila ki ta anpeche fanm sa a, vle anpeche van,</para>
  <para style="q1" vid="PRO 27:16">oswa sezi lwil ak men dwat li.<verse eid="PRO 27:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>Se fè ki file fè;</para>
  <para style="q1" vid="PRO 27:17">se konsa yon nonm file zanmi l.<verse eid="PRO 27:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>Sila ki pran swen pye fig la va manje fwi li,</para>
  <para style="q1" vid="PRO 27:18">e sila ki pran swen mèt li a va jwenn lonè.<verse eid="PRO 27:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>Tankou nan dlo, figi reflete figi,</para>
  <para style="q1" vid="PRO 27:19">konsa kè a yon nonm reflete lentansyon l.<verse eid="PRO 27:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:20 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 26:6">Job 26:6</ref>
      </char>
    </note>Sejou Lanmò ak labim pa janm satisfè;</para>
  <para style="q1" vid="PRO 27:20">ni zye a lòm pa janm satisfè.<verse eid="PRO 27:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>Po fonn nan se pou ajan, e founo se pou lò;</para>
  <para style="q1" vid="PRO 27:21">konsa, yon nom rafine pa lwanj ke l resevwa.<verse eid="PRO 27:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>Malgre ou ta <note caller="+" style="x"><char style="xo" closed="false">27:22 </char><char style="xt" closed="false"><ref loc="PRO 23:35">Pwov 23:35</ref></char></note>foule yon moun fou ak pilon jiskaske li fè poud,</para>
  <para style="q1" vid="PRO 27:22">tankou sereyal byen kraze a, foli li p ap sòti sou li.<verse eid="PRO 27:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:23 </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:10">Jr 31:10</ref>
      </char>
    </note>Konnen byen kondisyon a bann ou yo,</para>
  <para style="q1" vid="PRO 27:23">e okipe twoupo ou yo;<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>paske richès pa la pou tout tan,</para>
  <para style="q1" vid="PRO 27:24">ni yon <note caller="+" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="JOB 19:9">Job 19:9</ref></char></note>kouwòn pa rete pandan tout jenerasyon.<verse eid="PRO 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25"/>Zèb yo vin disparèt, e sa ki nèf la vin pouse,</para>
  <para style="q1" vid="PRO 27:25">e zèb mòn yo <note caller="+" style="x"><char style="xo" closed="false">27:25 </char><char style="xt" closed="false"><ref loc="ISA 17:5">És 17:5</ref></char></note>fin ranmase.<verse eid="PRO 27:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26"/>Jenn mouton yo va sèvi kon vètman ou,</para>
  <para style="q1" vid="PRO 27:26">e kabrit yo va mennen pri a yon chan.<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>Lèt kabrit ap kont pou manje ou,</para>
  <para style="q1" vid="PRO 27:27">pou manje tout lakay ou,</para>
  <para style="q1" vid="PRO 27:27">ak soutyen pou tout sèvant lakay ou yo.<verse eid="PRO 27:27"/></para>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1"/>Mechan yo <note caller="+" style="x"><char style="xo" closed="false">28:1 </char><char style="xt" closed="false"><ref loc="LEV 26:17-36">Lev 26:17-36</ref></char></note>sove ale lè pa gen k ap kouri dèyè yo;</para>
  <para style="q1" vid="PRO 28:1">men moun dwat yo gen kouraj kon lyon.<verse eid="PRO 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>Pa transgresyon a yon pèp, <note caller="+" style="x"><char style="xo" closed="false">28:2 </char><char style="xt" closed="false"><ref loc="1KI 16:8-28">I Wa 16:8-28</ref></char></note>chèf peyi yo vin anpil;</para>
  <para style="q1" vid="PRO 28:2">men lòd se etabi pa yon nonm bon konprann ak konesans.<verse eid="PRO 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>Yon moun pòv ki peze malere</para>
  <para style="q1" vid="PRO 28:3">se tankou gwo lapli ki lave tè a san kite anyen.<verse eid="PRO 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>Sila ki abandone lalwa a <note caller="+" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="PSA 49:18">Sòm 49:18</ref></char></note>bay lwanj a moun mechan;</para>
  <para style="q1" vid="PRO 28:4">men sila ki kenbe lalwa a va kanpe devan yo.<verse eid="PRO 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>Moun mechan yo <note caller="+" style="x"><char style="xo" closed="false">28:5 </char><char style="xt" closed="false"><ref loc="PSA 92:6">Sòm 92:6</ref></char></note>pa konprann lajistis;</para>
  <para style="q1" vid="PRO 28:5">men sila ki chache SENYÈ yo konprann tout bagay.<verse eid="PRO 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">28:6 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:1">Pwov 19:1</ref>
      </char>
    </note>Pi bon se malere ki mache ak ladwati a</para>
  <para style="q1" vid="PRO 28:6">pase sila ki kwochi a, menm si l gen anpil richès.<verse eid="PRO 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7"/>Sila ki kenbe lalwa a se yon fis ak bon konprann;</para>
  <para style="q1" vid="PRO 28:7">men sila ki fè zanmi ak moun <note caller="+" style="x"><char style="xo" closed="false">28:7 </char><char style="xt" closed="false"><ref loc="PRO 23:20">Pwov 23:20</ref></char></note>voras fè papa l wont.<verse eid="PRO 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8"/>Sila ki agrandi richès li avèk <note caller="+" style="x"><char style="xo" closed="false">28:8 </char><char style="xt" closed="false"><ref loc="EXO 22:25">Egz 22:25</ref></char></note>enterè sou lajan,</para>
  <para style="q1" vid="PRO 28:8">ranmase li pou sila k ap fè gras a malere a.<verse eid="PRO 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>Sila ki vire zòrèy li pou pa koute lalwa a,</para>
  <para style="q1" vid="PRO 28:9">menm <note caller="+" style="x"><char style="xo" closed="false">28:9 </char><char style="xt" closed="false"><ref loc="PSA 66:18">Sòm 66:18</ref></char></note>lapriyè li abominab.<verse eid="PRO 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>Sila ki egare moun dwat la nan move chemen an</para>
  <para style="q1" vid="PRO 28:10">va li menm tonbe nan pwòp fòs li;</para>
  <para style="q1" vid="PRO 28:10">men <note caller="+" style="x"><char style="xo" closed="false">28:10 </char><char style="xt" closed="false"><ref loc="MAT 6:33">Mat 6:33</ref> </char></note>sila ki san tò a, va gen bon eritaj.<verse eid="PRO 28:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>Mesye rich la saj nan pwòp zye l;</para>
  <para style="q1" vid="PRO 28:11">men malere ki gen bon konprann nan wè l jis li sonde l nèt.<verse eid="PRO 28:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>Lè moun ladwati a gen viktwa, gen anpil glwa;</para>
  <para style="q1" vid="PRO 28:12">men <note caller="+" style="x"><char style="xo" closed="false">28:12 </char><char style="xt" closed="false"><ref loc="PRO 28:28">Pwov 28:28</ref></char></note>lè mechan yo leve tout moun kache kò yo.<verse eid="PRO 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>Sila ki kache transgresyon li yo, p ap fè pwogrè;</para>
  <para style="q1" vid="PRO 28:13">men sila ki <note caller="+" style="x"><char style="xo" closed="false">28:13 </char><char style="xt" closed="false"><ref loc="PSA 32:5">Sòm 32:5</ref> </char></note>konfese yo e kite yo, va jwenn konpasyon.<verse eid="PRO 28:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>A la beni se sila ki toujou <note caller="+" style="x"><char style="xo" closed="false">28:14 </char><char style="xt" closed="false"><ref loc="PRO 23:17">Pwov 23:17</ref></char></note>gen lakrent Bondye a!</para>
  <para style="q1" vid="PRO 28:14">Men sila ki fè kè l di, va tonbe nan malè.<verse eid="PRO 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>Tankou lyon k ap rele fò ak lous k ap atake,</para>
  <para style="q1" vid="PRO 28:15">se konsa yon <note caller="+" style="x"><char style="xo" closed="false">28:15 </char><char style="xt" closed="false"><ref loc="EXO 1:14">Egz 1:14</ref> </char></note>chèf mechan ye sou yon pèp malere.<verse eid="PRO 28:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>Yon <note caller="+" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="ECC 10:16">Ekl 10:16</ref></char></note>gouvènè ki peze pèp la manke bon konprann;</para>
  <para style="q1" vid="PRO 28:16">men sila ki rayi richès ki pa jis, pwolonje jou li yo.<verse eid="PRO 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>Yon nonm ki <note caller="+" style="x"><char style="xo" closed="false">28:17 </char><char style="xt" closed="false"><ref loc="GEN 9:6">Jen 9:6</ref></char></note>twouble ak koupabilite san moun</para>
  <para style="q1" vid="PRO 28:17">va yon fijitif jiskaske li mouri.</para>
  <para style="q1" vid="PRO 28:17">Pinga pèsòn ba li soutyen.<verse eid="PRO 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>Sila ki mache san tò a va delivre;</para>
  <para style="q1" vid="PRO 28:18">men sila ki <note caller="+" style="x"><char style="xo" closed="false">28:18 </char><char style="xt" closed="false"><ref loc="PRO 10:27">Pwov 10:27</ref></char></note>kwochi a va tonbe byen vit.<verse eid="PRO 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">28:19 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:11">Pwov 12:11</ref>
      </char>
    </note>Sila ki laboure tè a va gen anpil manje;</para>
  <para style="q1" vid="PRO 28:19">men sila ki swiv vanite va jwenn anpil mizè.<verse eid="PRO 28:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>Yon nonm <note caller="+" style="x"><char style="xo" closed="false">28:20 </char><char style="xt" closed="false"><ref loc="PRO 10:6">Pwov 10:6</ref></char></note>fidèl va gen anpil benediksyon;</para>
  <para style="q1" vid="PRO 28:20">men sila ki fè vit pou jwenn richès, p ap chape anba pinisyon.<verse eid="PRO 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>Montre patipri pa bon,</para>
  <para style="q1" vid="PRO 28:21">paske yon sèl mòso pen ka fè yon moun transgrese.<verse eid="PRO 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>Yon nonm ak <note caller="+" style="x"><char style="xo" closed="false">28:22 </char><char style="xt" closed="false"><ref loc="PRO 23:6">Pwov 23:6</ref></char></note>move zye kouri dèyè richès</para>
  <para style="q1" vid="PRO 28:22">e li pa konnen kisa k ap rive li.<verse eid="PRO 28:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>Sila ki bay yon moun repwòch</para>
  <para style="q1" vid="PRO 28:23">va jwenn plis favè pase sila ki <note caller="+" style="x"><char style="xo" closed="false">28:23 </char><char style="xt" closed="false"><ref loc="PRO 29:5">Pwov 29:5</ref> </char></note>fè flatè ak lang li an.<verse eid="PRO 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>Sila ki vòlè papa li oswa manman l</para>
  <para style="q1" vid="PRO 28:24">epi di: “Sa pa yon transgresyon”,</para>
  <para style="q1" vid="PRO 28:24">se <note caller="+" style="x"><char style="xo" closed="false">28:24 </char><char style="xt" closed="false"><ref loc="PRO 18:9">Pwov 18:9</ref> </char></note>parèy ak yon moun ki detwi.<verse eid="PRO 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>Yon nonm awogan ap <note caller="+" style="x"><char style="xo" closed="false">28:25 </char><char style="xt" closed="false"><ref loc="PRO 15:18">Pwov 15:18</ref></char></note>pwovoke konfli;</para>
  <para style="q1" vid="PRO 28:25">men sila ki mete konfyans nan SENYÈ a va pwospere.<verse eid="PRO 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">28:26 </char><char style="xt" closed="false"><ref loc="PRO 3:5">Pwov 3:5</ref></char></note>mete konfyans nan pwòp kè li a se yon moun fou;</para>
  <para style="q1" vid="PRO 28:26">men sila ki mache ak sajès la va delivre.<verse eid="PRO 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">28:27 </char><char style="xt" closed="false"><ref loc="PRO 11:24">Pwov 11:24</ref></char></note>bay a malere a p ap janm manke;</para>
  <para style="q1" vid="PRO 28:27">men sila ki fèmen zye l ap jwenn anpil malediksyon.<verse eid="PRO 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>Lè mechan yo leve, pèp la kache kò yo;</para>
  <para style="q1" vid="PRO 28:28">men lè yo peri moun dwat yo vin plis.<verse eid="PRO 28:28"/></para>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1"/>Yon nonm ki fè tèt di apre anpil repwòch</para>
  <para style="q1" vid="PRO 29:1">va <note caller="+" style="x"><char style="xo" closed="false">29:1 </char><char style="xt" closed="false"><ref loc="PRO 6:15">Pwov 6:15</ref></char></note> vin kraze sibitman san remèd.<verse eid="PRO 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>Lè <note caller="+" style="x"><char style="xo" closed="false">29:2 </char><char style="xt" closed="false"><ref loc="EST 8:15">Est 8:15</ref></char></note>moun dwat yo vin ogmante, pèp la rejwi;</para>
  <para style="q1" vid="PRO 29:2">men lè yon moun mechan gouvène, pèp la jemi.<verse eid="PRO 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>Yon nonm ki <note caller="+" style="x"><char style="xo" closed="false">29:3 </char><char style="xt" closed="false"><ref loc="PRO 10:1">Pwov 10:1</ref></char></note>renmen sajès fè papa l kontan;</para>
  <para style="q1" vid="PRO 29:3">men sila ki pase tan l ak pwostitiye yo gate byen li.<verse eid="PRO 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">29:4 </char>
      <char style="xt" closed="false">
        <ref loc="2CH 9:8">II Kwo 9:8</ref>
      </char>
    </note>Avèk jistis, wa a fè tout peyi a vin estab;</para>
  <para style="q1" vid="PRO 29:4">men yon nonm ki aksepte kòb anba tab boulvèse li.<verse eid="PRO 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>Yon nonm ki <note caller="+" style="x"><char style="xo" closed="false">29:5 </char><char style="xt" closed="false"><ref loc="PSA 5:9">Sòm 5:9</ref></char></note>flate vwazen li</para>
  <para style="q1" vid="PRO 29:5">ap ouvri filè pou pla pye li.<verse eid="PRO 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>Pa transgresyon yon nonm mechan</para>
  <para style="q1" vid="PRO 29:6">vin <note caller="+" style="x"><char style="xo" closed="false">29:6 </char><char style="xt" closed="false"><ref loc="PRO 22:5">Pwov 22:5</ref></char></note>pran nan pyèj nèt;</para>
  <para style="q1" vid="PRO 29:6">men moun dwat la va chante e rejwi.<verse eid="PRO 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>Moun <note caller="+" style="x"><char style="xo" closed="false">29:7 </char><char style="xt" closed="false"><ref loc="JOB 29:16">Job 29:16</ref></char></note>ladwati a gen kè pou dwa malere;</para>
  <para style="q1" vid="PRO 29:7">men mechan an pa menm konprann afè sa a.<verse eid="PRO 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>Mokè yo, fè gwo vil la pran dife;</para>
  <para style="q1" vid="PRO 29:8">men moun <note caller="+" style="x"><char style="xo" closed="false">29:8 </char><char style="xt" closed="false"><ref loc="PRO 16:14">Pwov 16:14</ref> </char></note>saj yo kalme kòlè.<verse eid="PRO 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>Lè yon nonm saj gen yon kont ak yon moun san konprann,</para>
  <para style="q1" vid="PRO 29:9">moun san konprann nan anraje oswa ri, e nanpwen repo.<verse eid="PRO 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>Moun k ap <note caller="+" style="x"><char style="xo" closed="false">29:10 </char><char style="xt" closed="false"><ref loc="GEN 4:5-8">Jen 4:5-8</ref></char></note>vèse san rayi inosan an;</para>
  <para style="q1" vid="PRO 29:10">men moun dwat yo pwoteje lavi li.<verse eid="PRO 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>Moun san konprann toujou fache;</para>
  <para style="q1" vid="PRO 29:11">men <note caller="+" style="x"><char style="xo" closed="false">29:11 </char><char style="xt" closed="false"><ref loc="PRO 19:11">Pwov 19:11</ref></char></note>yon nonm saj kenbe tèt li anba kontwòl.<verse eid="PRO 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>Si <note caller="+" style="x"><char style="xo" closed="false">29:12 </char><char style="xt" closed="false"><ref loc="1KI 12:14">I Wa 12:14</ref></char></note>gouvènè a prete atansyon a manti,</para>
  <para style="q1" vid="PRO 29:12">tout minis li yo va vin mechan.<verse eid="PRO 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>Malere a ak opresè a gen yon bagay ki sanble;</para>
  <para style="q1" vid="PRO 29:13">se SENYÈ a ki <note caller="+" style="x"><char style="xo" closed="false">29:13 </char><char style="xt" closed="false"><ref loc="EZR 9:8">Esd 9:8</ref></char></note> mete limyè nan zye tou de.<verse eid="PRO 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>Si yon <note caller="+" style="x"><char style="xo" closed="false">29:14 </char><char style="xt" closed="false"><ref loc="PSA 72:4">Sòm 72:4</ref></char></note>wa jije pòv yo ak verite,</para>
  <para style="q1" vid="PRO 29:14">twòn li va etabli jis pou tout tan.<verse eid="PRO 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">29:15 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 13:24">Pwov 13:24</ref>
      </char>
    </note>Baton ak repwòch bay sajès;</para>
  <para style="q1" vid="PRO 29:15">men timoun ki fè sa li pito a mennen wont sou manman l.<verse eid="PRO 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>Lè mechan yo vin plis, transgresyon yo ogmante;</para>
  <para style="q1" vid="PRO 29:16">men <note caller="+" style="x"><char style="xo" closed="false">29:16 </char><char style="xt" closed="false"><ref loc="PSA 37:34-36">Sòm 37:34-36</ref></char></note>moun dwat yo va wè tonbe yo.<verse eid="PRO 29:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>Korije fis ou e li va ba ou rekonfò;</para>
  <para style="q1" vid="PRO 29:17">anplis, li va <note caller="+" style="x"><char style="xo" closed="false">29:17 </char><char style="xt" closed="false"><ref loc="PRO 10:1">Pwov 10:1</ref> </char></note>bay nanm ou gwo plezi.<verse eid="PRO 29:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>Kote nanpwen <note caller="+" style="x"><char style="xo" closed="false">29:18 </char><char style="xt" closed="false"><ref loc="1SA 3:1">I Sam 3:1</ref></char></note>vizyon, pèp la san fren;</para>
  <para style="q1" vid="PRO 29:18">men byen kontan se sila ki kenbe lalwa a.<verse eid="PRO 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>Pawòl sèl p ap ka enstwi yon esklav;</para>
  <para style="q1" vid="PRO 29:19">paske malgre li konprann, li p ap reponn.<verse eid="PRO 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>Èske ou wè yon nonm ki <note caller="+" style="x"><char style="xo" closed="false">29:20 </char><char style="xt" closed="false"><ref loc="JAS 1:19">Jc 1:19</ref></char></note> pale vit san reflechi?</para>
  <para style="q1" vid="PRO 29:20">Gen plis espwa pou moun fou a pase li menm.<verse eid="PRO 29:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>Sila ki byen swaye esklav li depi li piti a,</para>
  <para style="q1" vid="PRO 29:21">nan lafen, twouve yon fis.<verse eid="PRO 29:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>Yon <note caller="+" style="x"><char style="xo" closed="false">29:22 </char><char style="xt" closed="false"><ref loc="PRO 15:18">Pwov 15:18</ref></char></note>nonm an kòlè pwovoke konfli</para>
  <para style="q1" vid="PRO 29:22">e yon nonm ki plen fachèz fè anpil tò.<verse eid="PRO 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>Ògèy a yon nonm va mennen li ba;</para>
  <para style="q1" vid="PRO 29:23">men yon <note caller="+" style="x"><char style="xo" closed="false">29:23 </char><char style="xt" closed="false"><ref loc="PRO 15:33">Pwov 15:33</ref> </char></note>lespri enb va jwenn respè.<verse eid="PRO 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>Sila ki fè konplo ak yon volè rayi pwòp lavi li;</para>
  <para style="q1" vid="PRO 29:24">li <note caller="+" style="x"><char style="xo" closed="false">29:24 </char><char style="xt" closed="false"><ref loc="LEV 5:1">Lev 5:1</ref></char></note>pran sèman an men li pa pale anyen.<verse eid="PRO 29:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>Lakrent a lòm mennen yon pèlen;</para>
  <para style="q1" vid="PRO 29:25">men sila ki <note caller="+" style="x"><char style="xo" closed="false">29:25 </char><char style="xt" closed="false"><ref loc="PSA 91:1-16">Sòm 91:1-16</ref></char></note>mete konfyans li nan SENYÈ a va leve wo.<verse eid="PRO 29:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>Gen anpil moun k ap chache favè a sila ki gouvène a;</para>
  <para style="q1" vid="PRO 29:26">men <note caller="+" style="x"><char style="xo" closed="false">29:26 </char><char style="xt" closed="false"><ref loc="ISA 49:4">És 49:4</ref></char></note>lajistis pou lòm va sòti nan SENYÈ a.<verse eid="PRO 29:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>Tankou yon nonm <note caller="+" style="x"><char style="xo" closed="false">29:27 </char><char style="xt" closed="false"><ref loc="PSA 6:8">Sòm 6:8</ref></char></note>enjis abominab a moun dwat,</para>
  <para style="q1" vid="PRO 29:27">yon nonm ladwati abominab a mechan yo.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>Pawòl a Agur, fis a Jaké a, pwofèt la:</para>
  <para style="q1" vid="PRO 30:1">nonm nan pale Ithiel,</para>
  <para style="q1" vid="PRO 30:1">a Ithiel ak Ucal:<verse eid="PRO 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2"/>“Anverite, mwen <note caller="+" style="x"><char style="xo" closed="false">30:2 </char><char style="xt" closed="false"><ref loc="PSA 49:10">Sòm 49:10</ref></char></note>pi bèt pase tout moun</para>
  <para style="q1" vid="PRO 30:2">e mwen pa gen konprann a yon nonm.<verse eid="PRO 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3"/>Mwen pa t aprann sajès,</para>
  <para style="q1" vid="PRO 30:3">ni mwen pa gen <note caller="+" style="x"><char style="xo" closed="false">30:3 </char><char style="xt" closed="false"><ref loc="PRO 9:10">Pwov 9:10</ref></char></note>konesans a Sila Ki Sen an.<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>Kilès ki te <note caller="+" style="x"><char style="xo" closed="false">30:4 </char><char style="xt" closed="false"><ref loc="REV 19:12">Rev 19:12</ref></char></note>monte nan syèl la e te desann?</para>
  <para style="q1" vid="PRO 30:4">Kilès ki te ranmase van nan ponyèt li?</para>
  <para style="q1" vid="PRO 30:4">Kilès ki te vlope dlo nan vètman li?</para>
  <para style="q1" vid="PRO 30:4">Kilès ki te etabli tout pwent tè yo?</para>
  <para style="q1" vid="PRO 30:4">Ki non li e ki non fis Li a?</para>
  <para style="q1" vid="PRO 30:4">Asireman, ou konnen!<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>“Tout <note caller="+" style="x"><char style="xo" closed="false">30:5 </char><char style="xt" closed="false"><ref loc="PSA 12:6">Sòm 12:6</ref></char></note>pawòl Bondye pase a leprèv;</para>
  <para style="q1" vid="PRO 30:5">Li se yon boukliye pou sila ki kache nan Li yo.<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">30:6 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:2">Det 4:2</ref>
      </char>
    </note>Pa ogmante sou pawòl Li yo,</para>
  <para style="q1" vid="PRO 30:6">oswa Li va repwoche ou</para>
  <para style="q1" vid="PRO 30:6">e ou va fè prèv ke se yon mantè ou ye.<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>“De bagay m te mande ou yo;</para>
  <para style="q1" vid="PRO 30:7">pa refize m yo avan m mouri:<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>Fè desepsyon ak manti rete lwen mwen.</para>
  <para style="q1" vid="PRO 30:8">Pa ban m richès ni povrete.</para>
  <para style="q1" vid="PRO 30:8">Nouri mwen ak <note caller="+" style="x"><char style="xo" closed="false">30:8 </char><char style="xt" closed="false"><ref loc="JOB 23:12">Job 23:12</ref></char></note>manje ki se pòsyon pa m nan,<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>pou m pa <note caller="+" style="x"><char style="xo" closed="false">30:9 </char><char style="xt" closed="false"><ref loc="DEU 8:12">Det 8:12</ref></char></note>vin plen e refize rekonèt Ou</para>
  <para style="q1" vid="PRO 30:9">pou di: ‘Se kilès ki SENYÈ a?’</para>
  <para style="q1" vid="PRO 30:9">oswa, pou m ta manke, vin vòlè</para>
  <para style="q1" vid="PRO 30:9">e fè yon gwo wont sou non Bondye mwen an.<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>“Pa pale mal yon esklav a mèt li,</para>
  <para style="q1" vid="PRO 30:10">sinon li va <note caller="+" style="x"><char style="xo" closed="false">30:10 </char><char style="xt" closed="false"><ref loc="ECC 7:21">Ekl 7:21</ref></char></note>modi ou, e ou va twouve koupab.<verse eid="PRO 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>Gen yon kalite moun ki <note caller="+" style="x"><char style="xo" closed="false">30:11 </char><char style="xt" closed="false"><ref loc="EXO 21:17">Egz 21:17</ref></char></note>modi papa li</para>
  <para style="q1" vid="PRO 30:11">e refize beni manman l.<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>Gen yon kalite ki san tach nan pwòp zye li;</para>
  <para style="q1" vid="PRO 30:12">sepandan, yo poko lave pou sòti salte a.<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>Gen yon kalite—O, jan <note caller="+" style="x"><char style="xo" closed="false">30:13 </char><char style="xt" closed="false"><ref loc="PRO 6:17">Pwov 6:17</ref></char></note>zye li leve wo,</para>
  <para style="q1" vid="PRO 30:13">e pòpyè zye li leve ak awogans.<verse eid="PRO 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14"/>Gen yon kalite moun ak dan tankou nepe</para>
  <para style="q1" vid="PRO 30:14">ak machwè tankou kouto,</para>
  <para style="q1" vid="PRO 30:14">ki prèt pou <note caller="+" style="x"><char style="xo" closed="false">30:14 </char><char style="xt" closed="false"><ref loc="PSA 14:4">Sòm 14:4</ref></char></note>devore aflije sou fas tè yo,</para>
  <para style="q1" vid="PRO 30:14">e fè moun malere yo disparèt pami moun.<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>“Sansi a gen de fi: ‘Ban mwen’ ak ‘Ban m’.</para>
  <para style="b" vid="PRO 30:15"/>
  <para style="q1" vid="PRO 30:15">“Gen twa bagay ki pa janm satisfè, menm kat ki refize di: ‘Se kont’:<verse eid="PRO 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16"/>Sejou Lanmò a, <note caller="+" style="x"><char style="xo" closed="false">30:16 </char><char style="xt" closed="false"><ref loc="GEN 30:1">Jen 30:1</ref></char></note>vant fanm esteril la,</para>
  <para style="q1" vid="PRO 30:16">latè a ki pa janm jwenn dlo ase,</para>
  <para style="q1" vid="PRO 30:16">ak dife ki pa janm di: ‘Se kont’.<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>“Pou zye moun ki moke yon papa e ki giyonnen yon manman,</para>
  <para style="q1" vid="PRO 30:17">
    <note caller="+" style="x">
      <char style="xo" closed="false">30:17 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:26">Det 28:26</ref>
      </char>
    </note>kòbo nan vale a va vin rache l,</para>
  <para style="q1" vid="PRO 30:17">e jenn èg yo va manje li.<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18"/>“Gen twa bagay ki twò bèl pou mwen,</para>
  <para style="q1" vid="PRO 30:18">kat ke m pa konprann:<verse eid="PRO 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">30:19 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:49">Det 28:49</ref>
      </char>
    </note>Vòl a yon èg nan syèl la,</para>
  <para style="q1" vid="PRO 30:19">pa sèpan an sou wòch,</para>
  <para style="q1" vid="PRO 30:19">chemen gwo bato a nan mitan lanmè,</para>
  <para style="q1" vid="PRO 30:19">ak manèv a yon jennonm ak yon fi.<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>“Men konsa chemen a <note caller="+" style="x"><char style="xo" closed="false">30:20 </char><char style="xt" closed="false"><ref loc="PRO 5:6">Pwov 5:6</ref></char></note>fanm adiltè a:</para>
  <para style="q1" vid="PRO 30:20">Li manje, li siye bouch li e li pale klè: ‘Mwen pa t fè mal’.<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21"/>“Anba twa bagay, latè tranble,</para>
  <para style="q1" vid="PRO 30:21">e anba kat, li pa ka kenbe:<verse eid="PRO 30:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22"/>Anba yon <note caller="+" style="x"><char style="xo" closed="false">30:22 </char><char style="xt" closed="false"><ref loc="PRO 19:10">Pwov 19:10</ref></char></note>esklav lè li vin wa,</para>
  <para style="q1" vid="PRO 30:22">ak yon moun fou lè l vin satisfè ak manje,<verse eid="PRO 30:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23"/>anba yon fanm neglije lè l jwenn mari,</para>
  <para style="q1" vid="PRO 30:23">ak yon sèvant lè l pran plas mètrès kay la.<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24"/>“Kat bagay ki tou piti sou latè, men yo plen sajès:<verse eid="PRO 30:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">30:25 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:5">Pwov 6:5</ref>
      </char>
    </note>Foumi se pa yon pèp ki fò;</para>
  <para style="q1" vid="PRO 30:25">men yo prepare manje yo nan gran sezon.<verse eid="PRO 30:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">30:26 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 11:5">Lev 11:5</ref>
      </char>
    </note>Chat mawon se pa yon pèp pwisan;</para>
  <para style="q1" vid="PRO 30:26">men yo fè kay yo nan wòch.<verse eid="PRO 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27"/>Krikèt volan yo pa gen wa;</para>
  <para style="q1" vid="PRO 30:27">men yo parèt <note caller="+" style="x"><char style="xo" closed="false">30:27 </char><char style="xt" closed="false"><ref loc="JOB 2:7">Job 2:7</ref></char></note>byen alinye.<verse eid="PRO 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28"/>Zandolit ke ou kab kenbe nan men ou;</para>
  <para style="q1" vid="PRO 30:28">sepandan, li antre nan palè a wa a.<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29"/>“Gen twa bagay ki mache parèt bèl,</para>
  <para style="q1" vid="PRO 30:29">menm kat ki bèl lè yo mache:<verse eid="PRO 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30"/>Lyon ki <note caller="+" style="x"><char style="xo" closed="false">30:30 </char><char style="xt" closed="false"><ref loc="JDG 14:18">Jij 14:18</ref></char></note>pwisan pami bèt yo,</para>
  <para style="q1" vid="PRO 30:30">e ki pa fè bak devan okenn bèt;<verse eid="PRO 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31"/>Jan kòk mache a,</para>
  <para style="q1" vid="PRO 30:31">menm ak mal kabrit,</para>
  <para style="q1" vid="PRO 30:31">o yon wa lè lame parèt avè l.<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>“Si ou te fè foli nan leve tèt ou byen wo,</para>
  <para style="q1" vid="PRO 30:32">oswa si ou te fè konplo pou mal,</para>
  <para style="q1" vid="PRO 30:32">
    <note caller="+" style="x">
      <char style="xo" closed="false">30:32 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 21:5">Job 21:5</ref>
      </char>
    </note>mete men ou sou bouch ou.<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>Paske lèt k ap laboure vin fè bè,</para>
  <para style="q1" vid="PRO 30:33">ak peze nen pote san;</para>
  <para style="q1" vid="PRO 30:33">se konsa <note caller="+" style="x"><char style="xo" closed="false">30:33 </char><char style="xt" closed="false"><ref loc="PRO 10:12">Pwov 10:12</ref></char></note> laboure kòlè pwodwi konfli.”<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>Pawòl a wa Lemuel yo; pwofesi ke manman li te ansegne li a:<verse eid="PRO 31:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>“O fis mwen an!</para>
  <para style="q1" vid="PRO 31:2">O fis a vant mwen an!</para>
  <para style="q1" vid="PRO 31:2">O fis a ve mwen yo!<verse eid="PRO 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">31:3 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 5:9">Pwov 5:9</ref>
      </char>
    </note>Pa bay fòs ou a fanm,</para>
  <para style="q1" vid="PRO 31:3">ni wout ou a sila ki konn detwi wa yo.<verse eid="PRO 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>Se pa pou <note caller="+" style="x"><char style="xo" closed="false">31:4 </char><char style="xt" closed="false"><ref loc="ECC 10:17">Ekl 10:17</ref></char></note>wa yo, O Lemuel,</para>
  <para style="q1" vid="PRO 31:4">se pa pou wa yo bwè diven, ni pou chèf yo ta bwè diven,<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>Paske y ap bwè epi vin bliye dekrè ki te fèt la,</para>
  <para style="q1" vid="PRO 31:5">e <note caller="+" style="x"><char style="xo" closed="false">31:5 </char><char style="xt" closed="false"><ref loc="EXO 23:6">Egz 23:6</ref></char></note>tòde dwa a sila ki aflije yo.<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>Bay bwason fò a sila k ap <note caller="+" style="x"><char style="xo" closed="false">31:6 </char><char style="xt" closed="false"><ref loc="JOB 29:13">Job 29:13</ref></char></note>peri a,</para>
  <para style="q1" vid="PRO 31:6">ak diven a sila ki gen lavi anmè a.<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>Kite li bwè pou bliye mizè li</para>
  <para style="q1" vid="PRO 31:7">e pa sonje pwoblèm li ankò.<verse eid="PRO 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">31:8 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 29:12-17">Job 29:12-17</ref>
      </char>
    </note>Ouvri bouch ou pou bèbè a;</para>
  <para style="q1" vid="PRO 31:8">pou dwa yo a tout sila ki san sekou.<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>Ouvri bouch ou, fè jijman ak dwati,</para>
  <para style="q1" vid="PRO 31:9">e defann <note caller="+" style="x"><char style="xo" closed="false">31:9 </char><char style="xt" closed="false"><ref loc="ISA 1:17">És 1:17</ref> </char></note>dwa a aflije yo ak endijan an.”<verse eid="PRO 31:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10"/>Yon <note caller="+" style="x"><char style="xo" closed="false">31:10 </char><char style="xt" closed="false"><ref loc="RUT 3:11">Rt 3:11</ref></char></note>madanm ki ekselan, se kilès ki ka twouve li?</para>
  <para style="q1" vid="PRO 31:10">Paske valè li depase bijou.<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>Kè a mari li mete konfyans nan li</para>
  <para style="q1" vid="PRO 31:11">e li p ap manke reyisi.<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>Li fè l sa ki bon e pa sa ki mal</para>
  <para style="q1" vid="PRO 31:12">pandan tout jou lavi li.<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>Li chache lèn ak len e travay avèk men l ak kè kontan.<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>Li tankou bato komès;</para>
  <para style="q1" vid="PRO 31:14">li mennen manje li soti byen lwen.<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>Anplis, li leve pandan li toujou fènwa pou</para>
  <para style="q1" vid="PRO 31:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">31:15 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:42">Luc 12:42</ref>
      </char>
    </note>bay manje a tout lakay li,</para>
  <para style="q1" vid="PRO 31:15">ak yon pòsyon pou sèvant li yo.<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>Li konsidere yon chan e achte li.</para>
  <para style="q1" vid="PRO 31:16">Ak benefis travay li, li plante yon chan rezen.<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>Li <note caller="+" style="x"><char style="xo" closed="false">31:17 </char><char style="xt" closed="false"><ref loc="1KI 18:46">I Wa 18:46</ref></char></note>mare senti l ak gwo fòs</para>
  <para style="q1" vid="PRO 31:17">pou fè bra li vin fò.<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>Li santi ke siksè li bon;</para>
  <para style="q1" vid="PRO 31:18">lanp li pa janm etenn lannwit.<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>Li lonje men l vè aparèy tise a</para>
  <para style="q1" vid="PRO 31:19">e men l kenbe l.<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>Li <note caller="+" style="x"><char style="xo" closed="false">31:20 </char><char style="xt" closed="false"><ref loc="DEU 15:11">Det 15:11</ref></char></note>lonje men l vè pòv yo</para>
  <para style="q1" vid="PRO 31:20">avèk sila ki gen bezwen an.<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>Lakay li pa fè krent pou lanèj,</para>
  <para style="q1" vid="PRO 31:21">paske tout lakay <note caller="+" style="x"><char style="xo" closed="false">31:21 </char><char style="xt" closed="false"><ref loc="2SA 1:24">II Sam 1:24</ref></char></note> abiye an wouj.<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>Li fè <note caller="+" style="x"><char style="xo" closed="false">31:22 </char><char style="xt" closed="false"><ref loc="PRO 7:16">Pwov 7:16</ref></char></note>kouvèti pou tèt li;</para>
  <para style="q1" vid="PRO 31:22">tout vètman li se twal fen blan ak mov.<verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>Mari li byen rekonèt <note caller="+" style="x"><char style="xo" closed="false">31:23 </char><char style="xt" closed="false"><ref loc="DEU 16:18">Det 16:18</ref></char></note>nan pòtay lavil yo,</para>
  <para style="q1" vid="PRO 31:23">lè l chita pami ansyen a peyi yo.<verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>Li fè <note caller="+" style="x"><char style="xo" closed="false">31:24 </char><char style="xt" closed="false"><ref loc="JDG 14:12">Jij 14:12</ref></char></note>vètman an len pou vann yo,</para>
  <para style="q1" vid="PRO 31:24">e founi sentiwon a tout komèsan yo.<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>Fòs ak <note caller="+" style="x"><char style="xo" closed="false">31:25 </char><char style="xt" closed="false"><ref loc="1TI 2:9-10">I Tim 2:9-10</ref></char></note>respè se abiman li</para>
  <para style="q1" vid="PRO 31:25">e li souri a lavni.<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>Li <note caller="+" style="x"><char style="xo" closed="false">31:26 </char><char style="xt" closed="false"><ref loc="PRO 10:31">Pwov 10:31</ref></char></note>ouvri bouch li avèk sajès</para>
  <para style="q1" vid="PRO 31:26">e enstriksyon ladousè sou lang li.<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>Li gade byen tout afè lakay li</para>
  <para style="q1" vid="PRO 31:27">e li pa manje <note caller="+" style="x"><char style="xo" closed="false">31:27 </char><char style="xt" closed="false"><ref loc="PRO 15:19">Pwov 15:19</ref></char></note>pen laparès.<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>Pitit li yo leve e beni li;</para>
  <para style="q1" vid="PRO 31:28">mari li tou ba li gwo lwanj pou di l:<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>“Anpil fi te fè byen bon;</para>
  <para style="q1" vid="PRO 31:29">men ou pi bon anpil pase yo tout.”<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>Chàm konn twonpe e bèlte konn vanite;</para>
  <para style="q1" vid="PRO 31:30">men se fanm nan ki <note caller="+" style="x"><char style="xo" closed="false">31:30 </char><char style="xt" closed="false"><ref loc="PSA 112:1">Sòm 112:1</ref></char></note>krent SENYÈ a</para>
  <para style="q1" vid="PRO 31:30">k ap resevwa lwanj.<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>Ba li sa ke men l te pwodwi,</para>
  <para style="q1" vid="PRO 31:31">epi kite zèv li yo fè lwanj li nan pòtay yo.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
