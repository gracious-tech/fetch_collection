<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ISA" style="id"/>
  <para style="h">Ésaïe</para>
  <para style="toc1">ÉSAÏE</para>
  <para style="toc2">Ésaïe</para>
  <para style="toc3">És</para>
  <para style="mt1">ÉSAÏE</para>
  <chapter number="1" style="c" sid="ISA 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1"/>Vizyon Ésaïe a, fis Amots la, konsènan Juda avèk Jérusalem, ke li te wè pandan tan pouvwa a Ozias, Jotham, Achaz ak <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 18:1-20">II Wa 18:1-20</ref> </char></note>Ézéchias, wa Juda yo.<verse eid="ISA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 1:2"/>Koute O syèl yo e tande O latè;</para>
  <para style="q1" vid="ISA 1:2">paske SENYÈ a pale:</para>
  <para style="q1" vid="ISA 1:2">“Fis Mwen leve yo,</para>
  <para style="q1" vid="ISA 1:2">men yo <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ISA 30:1-9">És 30:1-9</ref> </char></note>fè rebèl kont Mwen.<verse eid="ISA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 1:3"/>Yon bèf konnen mèt li</para>
  <para style="q1" vid="ISA 1:3">e yon bourik manjwa a mèt li,</para>
  <para style="q1" vid="ISA 1:3">men Israël <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="JER 9:3">Jr 9:3</ref></char></note>pa konsa.</para>
  <para style="q1" vid="ISA 1:3">Pèp Mwen an pa reflechi.”<verse eid="ISA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 1:4"/>Elas, yon nasyon plen peche,</para>
  <para style="q1" vid="ISA 1:4">yon pèp peze avèk inikite,</para>
  <para style="q1" vid="ISA 1:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:4 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 14:20">És 14:20</ref>
      </char>
    </note>ras malfektè, fis ki fè zak konwonpi!</para>
  <para style="q1" vid="ISA 1:4">Yo te abandone SENYÈ a;</para>
  <para style="q1" vid="ISA 1:4">yo te meprize Sila Ki Sen Israël la.</para>
  <para style="q1" vid="ISA 1:4">Yo te vire kite Li nèt!<verse eid="ISA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 1:5"/>Se ki bo nou va pran so ankò?</para>
  <para style="q1" vid="ISA 1:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 31:6">És 31:6</ref>
      </char>
    </note>Poukisa nou mache fè rebèl san rete?</para>
  <para style="q1" vid="ISA 1:5">Tout tèt la malad e tout kè a fèb.<verse eid="ISA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 1:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:6 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 2:7">Job 2:7</ref>
      </char>
    </note>Depi nan pla pye jis rive nan tèt,</para>
  <para style="q1" vid="ISA 1:6">nanpwen anyen ak sante ladann,</para>
  <para style="q1" vid="ISA 1:6">sèlman kote ki brize, ak maleng ak blese.</para>
  <para style="q1" vid="ISA 1:6">Yo pa pran swen, ni panse, ni soulaje l ak lwil.<verse eid="ISA 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 1:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:7 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:33">Lev 26:33</ref>
      </char>
    </note>Peyi nou an vin devaste, vil nou yo brile ak dife.</para>
  <para style="q1" vid="ISA 1:7">Chan nou yo——se etranje k ap devore yo nan prezans nou;</para>
  <para style="q1" vid="ISA 1:7">se dezolasyon nèt, pandan etranje yo ap ranvèse li.<verse eid="ISA 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 1:8"/>Fi Sion an vin tankou yon ti tonèl</para>
  <para style="q1" vid="ISA 1:8">nan yon chan rezen,</para>
  <para style="q1" vid="ISA 1:8">tankou abri a yon gadyen nan yon chan konkonb,</para>
  <para style="q1" vid="ISA 1:8">tankou yon vil ki anba syèj.<verse eid="ISA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 1:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:9 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 9:29">Wo 9:29</ref>
      </char>
    </note>Amwenske SENYÈ dèzame yo te kite kèk grenn chape viv,</para>
  <para style="q1" vid="ISA 1:9">nou t ap tankou Sodome,</para>
  <para style="q1" vid="ISA 1:9">nou t ap sanble ak Gomorrhe.<verse eid="ISA 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 1:10"/>Tande pawòl SENYÈ a, nou menm, chèf <note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ISA 3:9">És 3:9</ref> </char></note>Sodome yo;</para>
  <para style="q1" vid="ISA 1:10">bay zòrèy nou enstriksyon Bondye nou a,</para>
  <para style="q1" vid="ISA 1:10">nou menm pèp Gomorrhe.<verse eid="ISA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 1:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:8">Sòm 50:8</ref>
      </char>
    </note>“Ki sa gran fòs kantite sakrifis sa yo ye</para>
  <para style="q1" vid="ISA 1:11">k ap ogmante pou Mwen?” di SENYÈ a.</para>
  <para style="q1" vid="ISA 1:11">Mwen fin resevwa kont ofrann brile</para>
  <para style="q1" vid="ISA 1:11">a belye ak grès a bèf gra yo.</para>
  <para style="q1" vid="ISA 1:11">Mwen pa pran plezi nan san towo yo,</para>
  <para style="q1" vid="ISA 1:11">jenn mouton, ni kabrit.<verse eid="ISA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 1:12"/>Lè nou vin <note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="EXO 23:17">Egz 23:17</ref></char></note>parèt devan M,</para>
  <para style="q1" vid="ISA 1:12">kilès ki egzije nou vin foule lakou Mwen an konsa?<verse eid="ISA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 1:13"/>Pa vin pote ofrann san valè sa yo ankò;</para>
  <para style="q1" vid="ISA 1:13">lansan vin abominab devan M.</para>
  <para style="q1" vid="ISA 1:13">Nouvèl lin ak Saba a, apèl asanble yo—</para>
  <para style="q1" vid="ISA 1:13">Mwen pa ka <note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="JER 7:9-10">Jr 7:9-10</ref></char></note>sipòte inikite ansanm ak asanble solanèl la.<verse eid="ISA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 1:14"/>Mwen rayi fèt nouvèl lin yo ak fèt apwente nou yo.</para>
  <para style="q1" vid="ISA 1:14">Yo vin yon gwo fado pou mwen.</para>
  <para style="q1" vid="ISA 1:14">Mwen <note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ISA 7:13">És 7:13</ref> </char></note>fatige sipòte yo.<verse eid="ISA 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 1:15"/>Pou sa, lè nou ouvri men nou nan lapriyè,</para>
  <para style="q1" vid="ISA 1:15">Mwen va kache zye M de nou menm.</para>
  <para style="q1" vid="ISA 1:15">Wi, menm si nou ogmante lapriyè nou yo, Mwen p ap koute yo.</para>
  <para style="q1" vid="ISA 1:15">Men nou kouvri ak san.<verse eid="ISA 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 1:16"/>Lave nou pou nou vin pwòp;</para>
  <para style="q1" vid="ISA 1:16">retire zak malonèt nou yo devan zye M.</para>
  <para style="q1" vid="ISA 1:16">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:16 </char>
      <char style="xt" closed="false">
        <ref loc="JER 25:5">Jr 25:5</ref> </char>
    </note>Sispann fè mechanste.<verse eid="ISA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 1:17"/>Aprann fè sa ki bon;</para>
  <para style="q1" vid="ISA 1:17">chache lajistis,</para>
  <para style="q1" vid="ISA 1:17">fè sekou oprime yo,</para>
  <para style="q1" vid="ISA 1:17">defann òfelen yo,</para>
  <para style="q1" vid="ISA 1:17">plede ka a vèv la.<verse eid="ISA 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 1:18"/>“Alò, vini koulye a; <note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="ISA 41:1-21">És 41:1-21</ref></char></note>annou rezone ansanm, di SENYÈ a:</para>
  <para style="q1" vid="ISA 1:18">“Malgre peche nou yo wouj, yo va vin blan tankou lanèj;</para>
  <para style="q1" vid="ISA 1:18">malgre yo fonse tankou kramwazi, y ap vin tankou len.<verse eid="ISA 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 1:19"/>Si nou vin dakò e obeyi,</para>
  <para style="q1" vid="ISA 1:19">nou va <note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ISA 55:2">És 55:2</ref> </char></note>manje pi bon bagay ki gen nan peyi a;<verse eid="ISA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 1:20"/>men si nou refize, e fè rebèl,</para>
  <para style="q1" vid="ISA 1:20">nou va devore pa nepe.”</para>
  <para style="q1" vid="ISA 1:20">Anverite, <note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="ISA 40:5">És 40:5</ref> </char></note>bouch SENYÈ a fin pale.”<verse eid="ISA 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 1:21"/>Gade vil fidèl la vin devni yon <note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="ISA 57:3-9">És 57:3-9</ref></char></note>pwostitiye!</para>
  <para style="q1" vid="ISA 1:21">Sila ki te konn plen ak jistis la!</para>
  <para style="q1" vid="ISA 1:21">Nan yon lè, ladwati te rete nan li,</para>
  <para style="q1" vid="ISA 1:21">men koulye a, se asasen yo ye.<verse eid="ISA 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 1:22"/>Ajan ou yo, koulye a vin tounen kim</para>
  <para style="q1" vid="ISA 1:22">e bwason ou vin mele ak dlo.<verse eid="ISA 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 1:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:23 </char>
      <char style="xt" closed="false">
        <ref loc="HOS 5:10">Os 5:10</ref>
      </char>
    </note>Chèf ou yo se rebèl yo ye</para>
  <para style="q1" vid="ISA 1:23">k ap fè zanmi parèy ak volè.</para>
  <para style="q1" vid="ISA 1:23">Se yo tout ki renmen resevwa</para>
  <para style="q1" vid="ISA 1:23">anba tab ak kouri dèyè benifis.</para>
  <para style="q1" vid="ISA 1:23">Yo pa defann òfelen an,</para>
  <para style="q1" vid="ISA 1:23">ni ka a vèv la pa rive devan yo.<verse eid="ISA 1:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 1:24"/>Pou sa, Senyè BONDYE dèzame yo,</para>
  <para style="q1" vid="ISA 1:24">Toupwisan Israël la, deklare:</para>
  <para style="q1" vid="ISA 1:24">“Ah, M ap jwenn soulajman de advèsè Mwen yo;</para>
  <para style="q1" vid="ISA 1:24">M ap <note caller="+" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="DEU 28:63">Det 28:63</ref></char></note>pran vanjans mwen sou lènmi Mwen yo.<verse eid="ISA 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 1:25"/>Mwen va vire men m kont nou</para>
  <para style="q1" vid="ISA 1:25">e Mwen va <note caller="+" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="EZK 22:19-22">Éz 22:19-22</ref></char></note>fonn kim nou an tankou se ak likid lesiv,</para>
  <para style="q1" vid="ISA 1:25">pou l pa gen metal ki rete.<verse eid="ISA 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 1:26"/>Mwen va restore <note caller="+" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="ISA 60:17">És 60:17</ref></char></note>jij nou yo tankou nan kòmansman an</para>
  <para style="q1" vid="ISA 1:26">ak konseye yo jan lè nou te fenk kòmanse a.</para>
  <para style="q1" vid="ISA 1:26">Apre sa, yo va rele nou vil ladwati,</para>
  <para style="q1" vid="ISA 1:26">yon vil ki fidèl.<verse eid="ISA 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 1:27"/>Sion va <note caller="+" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="ISA 35:9">És 35:9</ref></char></note>rachte ak lajistis, e sila ki repanti ladann yo va plen ladwati a.<verse eid="ISA 1:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 1:28"/>Men transgresè ak pechè yo va <note caller="+" style="x"><char style="xo" closed="false">1:28 </char><char style="xt" closed="false"><ref loc="PSA 9:5">Sòm 9:5</ref></char></note>kraze ansanm,</para>
  <para style="q1" vid="ISA 1:28">e sila ki abandone SENYÈ yo va vin disparèt nèt.<verse eid="ISA 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 1:29"/>Anverite, nou va wont pou bwadchenn ke nou te pito yo,</para>
  <para style="q1" vid="ISA 1:29">e nou va wont pou <note caller="+" style="x"><char style="xo" closed="false">1:29 </char><char style="xt" closed="false"><ref loc="ISA 65:3">És 65:3</ref> </char></note>jaden ke nou te pito yo.<verse eid="ISA 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 1:30"/>Paske nou va tankou yon bwadchenn ak <note caller="+" style="x"><char style="xo" closed="false">1:30 </char><char style="xt" closed="false"><ref loc="ISA 64:6">És 64:6</ref></char></note>fèy ki fennen,</para>
  <para style="q1" vid="ISA 1:30">oswa tankou yon jaden ki pa gen dlo menm.<verse eid="ISA 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 1:31"/>Sila ki pwisan an va devni retay pishpèn.</para>
  <para style="q1" vid="ISA 1:31">Zèv li yo anplis va tankou etensèl dife.</para>
  <para style="q1" vid="ISA 1:31">Konsa, y ap brile ansanm</para>
  <para style="q1" vid="ISA 1:31">e p ap gen moun ki pou fè yo etenn.”<verse eid="ISA 1:31"/></para>
  <chapter eid="ISA 1"/>
  <chapter number="2" style="c" sid="ISA 2"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1"/>Pawòl ke <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="ISA 66:24">És 66:24</ref></char></note>Ésaïe, fis a Amots la, te wè konsènan Juda avèk Jérusalem.<verse eid="ISA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 2:2"/>Alò, li va vin rive <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="MIC 4:1-3">Mi 4:1-3</ref></char></note>nan dènye jou yo,</para>
  <para style="q1" vid="ISA 2:2">ke mòn lakay SENYÈ a va etabli kon chèf a mòn yo.</para>
  <para style="q1" vid="ISA 2:2">Li va leve pi wo pase kolin yo,</para>
  <para style="q1" vid="ISA 2:2">e tout nasyon yo va kouri vin jwenn li.<verse eid="ISA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 2:3"/>Konsa, anpil pèp va vini e yo va di:</para>
  <para style="q1" vid="ISA 2:3">Vini, annou monte nan mòn SENYÈ a,</para>
  <para style="q1" vid="ISA 2:3">lakay Bondye a Jacob la;</para>
  <para style="q1" vid="ISA 2:3">pou L kab enstwi nou konsènan chemen Li yo,</para>
  <para style="q1" vid="ISA 2:3">e pou nou kapab mache nan pa Li yo.</para>
  <para style="q1" vid="ISA 2:3">Paske lalwa a va sòti fè parèt <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ISA 51:4-5">És 51:4-5</ref></char></note>soti nan Sion,</para>
  <para style="q1" vid="ISA 2:3">e pawòl Bondye a soti nan Jérusalem.<verse eid="ISA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 2:4"/>Li va jije pami nasyon yo,</para>
  <para style="q1" vid="ISA 2:4">e Li va rann desizyon pou anpil pèp.</para>
  <para style="q1" vid="ISA 2:4">Yo va frape nepe yo pou fè cha tè a,</para>
  <para style="q1" vid="ISA 2:4">ak lans lagè pou fè kwòk imondaj yo.</para>
  <para style="q1" vid="ISA 2:4">Nasyon p ap leve nepe kont nasyon</para>
  <para style="q1" vid="ISA 2:4">e jis pou tout tan,</para>
  <para style="q1" vid="ISA 2:4">yo p ap vin aprann fè lagè ankò.<verse eid="ISA 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 2:5"/>Vini lakay Jacob;</para>
  <para style="q1" vid="ISA 2:5">annou mache nan <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="ISA 60:1-20">És 60:1-20</ref></char></note>limyè SENYÈ a.<verse eid="ISA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 2:6"/>Paske ou te <note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="DEU 31:17">Det 31:17</ref></char></note>abandone pèp Ou a, lakay Jacob,</para>
  <para style="q1" vid="ISA 2:6">akoz yo plen ak jan de panse yo</para>
  <para style="q1" vid="ISA 2:6">ki sòti nan lès;</para>
  <para style="q1" vid="ISA 2:6">akoz yo vin pwofèt ki swiv Filisten yo,</para>
  <para style="q1" vid="ISA 2:6">k ap antann yo ak pitit a etranje yo.<verse eid="ISA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 2:7"/>Anplis, peyi yo vin plen ak ajan ak lò</para>
  <para style="q1" vid="ISA 2:7">e pou richès yo, nanpwen fen.</para>
  <para style="q1" vid="ISA 2:7">Peyi yo osi vin plen ak cheval yo,</para>
  <para style="q1" vid="ISA 2:7">e ak cha lagè yo, nanpwen fen.<verse eid="ISA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 2:8"/>Peyi yo anplis <note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 10:11">És 10:11</ref></char></note>plen ak zidòl;</para>
  <para style="q1" vid="ISA 2:8">yo adore zèv men pa yo, sa ke dwèt yo te fè.<verse eid="ISA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 2:9"/>Pou sa, lòm vin imilye;</para>
  <para style="q1" vid="ISA 2:9">e limanite vin bese.</para>
  <para style="q1" vid="ISA 2:9">Konsa, <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="NEH 4:5">Né 4:5</ref></char></note>pa padone yo.<verse eid="ISA 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 2:10"/>Antre nan wòch,</para>
  <para style="q1" vid="ISA 2:10">e kache nan pousyè,</para>
  <para style="q1" vid="ISA 2:10">kont <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="2TH 1:9">II Tes 1:9</ref> </char></note>laperèz SENYÈ a,</para>
  <para style="q1" vid="ISA 2:10">kont mayifisans ak majeste li.<verse eid="ISA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 2:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:11 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:15">És 5:15</ref>
      </char>
    </note>Ògèy a lòm va vin bese</para>
  <para style="q1" vid="ISA 2:11">e wotè a lòm va vin imilye.</para>
  <para style="q1" vid="ISA 2:11">E nan jou sa a se sèl SENYÈ a k ap egzalte.<verse eid="ISA 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 2:12"/>Paske SENYÈ dèzame yo va gen yon jou jijman</para>
  <para style="q1" vid="ISA 2:12">kont nenpòt moun <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="JOB 40:11-12">Job 40:11-12</ref></char></note>ki ògeye, e ki awogan;</para>
  <para style="q1" vid="ISA 2:12">nenpòt moun ki leve tèt li wo va bese li.<verse eid="ISA 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 2:13"/>Epi kont tout bwa sèd Liban an ki byen wo,</para>
  <para style="q1" vid="ISA 2:13">e ki leve tèt yo wo,</para>
  <para style="q1" vid="ISA 2:13">kont tout <note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="ZEC 11:2">Za 11:2</ref></char></note>chenn Basan yo.<verse eid="ISA 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 2:14"/>Kont tout <note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="ISA 40:4">És 40:4</ref></char></note> mòn wo yo,</para>
  <para style="q1" vid="ISA 2:14">kont tout kolin ki leve wo yo,<verse eid="ISA 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 2:15"/>Kont tout <note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ISA 25:12">És 25:12</ref></char></note>fò wo yo,</para>
  <para style="q1" vid="ISA 2:15">kont tout miray fòtifye yo,<verse eid="ISA 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 2:16"/>Kont tout <note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="1KI 10:22">I Wa 10:22</ref></char></note>bato Tarsis yo,</para>
  <para style="q1" vid="ISA 2:16">kont tout sa ki bèl pou wè yo.<verse eid="ISA 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 2:17"/>Ògèy a lòm va vin imilye</para>
  <para style="q1" vid="ISA 2:17">e wotè a lòm va vin desann.</para>
  <para style="q1" vid="ISA 2:17">Se sèl SENYÈ a ki va egzalte nan jou sa a.<verse eid="ISA 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 2:18"/>Men <note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="ISA 21:9">És 21:9</ref></char></note>zidòl yo va vin disparèt nèt.<verse eid="ISA 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 2:19"/>Tout moun va <note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="ISA 2:10">És 2:10</ref></char></note>antre nan kav pami wòch yo,</para>
  <para style="q1" vid="ISA 2:19">ak nan twou tè a,</para>
  <para style="q1" vid="ISA 2:19">devan gran laperèz SENYÈ a,</para>
  <para style="q1" vid="ISA 2:19">ak gwo bagay etonnan de majeste Li,</para>
  <para style="q1" vid="ISA 2:19">lè Li leve pou fè tè a tranble.<verse eid="ISA 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 2:20"/>Nan jou sa a, tout moun va <note caller="+" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="ISA 30:22">És 30:22</ref></char></note>jete deyò rat ak chòv-sourit,</para>
  <para style="q1" vid="ISA 2:20">zidòl fèt an ajan, ak zidòl fèt an lò,</para>
  <para style="q1" vid="ISA 2:20">ke yo te fè pou yo menm ta adore,<verse eid="ISA 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 2:21"/>pou yo ka <note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="ISA 2:19">És 2:19</ref></char></note>antre nan kav wòch</para>
  <para style="q1" vid="ISA 2:21">ak twou wòch nan falèz yo,</para>
  <para style="q1" vid="ISA 2:21">pou yo pa parèt devan laperèz SENYÈ,</para>
  <para style="q1" vid="ISA 2:21">ak gwo bagay etonan a majeste Li a,</para>
  <para style="q1" vid="ISA 2:21">lè Li leve pou fè latè tranble.<verse eid="ISA 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 2:22"/>Sispann mete konfyans nan lòm;</para>
  <para style="q1" vid="ISA 2:22">souf vi li se sèl nan nen l.</para>
  <para style="q1" vid="ISA 2:22">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:22 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:15-17">És 40:15-17</ref> </char>
    </note>Kisa li vo?<verse eid="ISA 2:22"/></para>
  <chapter eid="ISA 2"/>
  <chapter number="3" style="c" sid="ISA 3"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 3:1"/>Paske gade byen, Senyè BONDYE dèzame yo va <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="LEV 26:26">Lev 26:26</ref></char></note>retire sou Jérusalem ak Juda ni sipò, ni mwayen materyo,</para>
  <para style="q1" vid="ISA 3:1">tout sa ki pou founi pen</para>
  <para style="q1" vid="ISA 3:1">e tout sa ki pou founi dlo;<verse eid="ISA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 3:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:2 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 24:14">II Wa 24:14</ref>
      </char>
    </note>Nonm pwisan an,</para>
  <para style="q1" vid="ISA 3:2">gèrye la,</para>
  <para style="q1" vid="ISA 3:2">jij ak pwofèt la,</para>
  <para style="q1" vid="ISA 3:2">divinò a ak ansyen an,<verse eid="ISA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 3:3"/>Kapitèn dè senkant yo,</para>
  <para style="q1" vid="ISA 3:3">nonm ki resevwa onè a,</para>
  <para style="q1" vid="ISA 3:3">konseye a,</para>
  <para style="q1" vid="ISA 3:3">atizan an,</para>
  <para style="q1" vid="ISA 3:3">ak sila ki fò nan fè wanga a.<verse eid="ISA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 3:4"/>Konsa, Mwen va fè <note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="ECC 10:16">Ekl 10:16</ref></char></note>senp tigason yo vin chèf sou yo,</para>
  <para style="q1" vid="ISA 3:4">e timoun san kontwòl yo va vin renye sou yo.<verse eid="ISA 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 3:5"/>Epi pèp la va <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="MIC 7:3-6">Mi 7:3-6</ref></char></note>oprime,</para>
  <para style="q1" vid="ISA 3:5">youn pa yon lòt e chak pa vwazen li;</para>
  <para style="q1" vid="ISA 3:5">jenn yo va fè rebèl kont granmoun yo</para>
  <para style="q1" vid="ISA 3:5">e sila ki enferyè a kont sila ki gen onè a.<verse eid="ISA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 3:6"/>Lè yon nonm <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ISA 4:1">És 4:1</ref></char></note>mete men l sou frè l lakay papa l, epi di:</para>
  <para style="q1" vid="ISA 3:6">“Se ou ki gen manto a, se ou k ap chèf nou an,</para>
  <para style="q1" vid="ISA 3:6">e tout miray kraze sa yo va anba pouvwa ou”,<verse eid="ISA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 3:7"/>Nan jou sa a, li va diskite ak yo e li va di:</para>
  <para style="q1" vid="ISA 3:7">“Se pa mwen menm k ap <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="EZK 34:4">Éz 34:4</ref></char></note>geri nou an;</para>
  <para style="q1" vid="ISA 3:7">paske lakay mwen pa gen ni pen, ni manto;</para>
  <para style="q1" vid="ISA 3:7">se pa mwen menm pou nou ta chwazi chèf sou pèp la.”<verse eid="ISA 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 3:8"/>Paske Jérusalem chape glise e Juda fin tonbe akoz</para>
  <para style="q1" vid="ISA 3:8">pawòl ak zak yo kont SENYÈ a;</para>
  <para style="q1" vid="ISA 3:8">pou yo <note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="ISA 65:3">És 65:3</ref> </char></note>fè rebèl kont prezans sen Li an.<verse eid="ISA 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 3:9"/>Vizaj figi yo fè temwen kont yo,</para>
  <para style="q1" vid="ISA 3:9">e yo montre tout moun peche yo tankou Sodome.</para>
  <para style="q1" vid="ISA 3:9">Yo pa menm kache sa a. Malè a yo menm!</para>
  <para style="q1" vid="ISA 3:9">Paske yo <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="PRO 8:36">Pwov 8:36</ref></char></note>mennen mal la vin tonbe sou yo.<verse eid="ISA 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 3:10"/>Di a <note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="DEU 28:1-14">Det 28:1-14</ref></char></note>moun dwat yo sa prale byen pou yo,</para>
  <para style="q1" vid="ISA 3:10">paske yo va manje fwi a zèv yo.<verse eid="ISA 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 3:11"/>Malè a mechan an!</para>
  <para style="q1" vid="ISA 3:11">Sa prale mal pou li.</para>
  <para style="q1" vid="ISA 3:11">Paske <note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="DEU 28:15-68">Det 28:15-68</ref></char></note>sa li merite a, se sa k ap rive li.<verse eid="ISA 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 3:12"/>O pèp Mwen an! Moun ki oprime yo se timoun</para>
  <para style="q1" vid="ISA 3:12">ak fanm ki gouvène sou yo.</para>
  <para style="q1" vid="ISA 3:12">O pèp Mwen an! <note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="ISA 9:16">És 9:16</ref> </char></note>Sila k ap gide ou yo, egare ou,</para>
  <para style="q1" vid="ISA 3:12">e konfonn direksyon chemen nou yo.<verse eid="ISA 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 3:13"/>Se <note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ISA 66:16">És 66:16</ref></char></note>SENYÈ a ki parèt kon advèsè yo</para>
  <para style="q1" vid="ISA 3:13">e ki kanpe pou jije pèp la.<verse eid="ISA 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 3:14"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="JOB 22:4">Job 22:4</ref></char></note>antre nan jijman ak ansyen ak prens a pèp Li a.</para>
  <para style="q1" vid="ISA 3:14">“Se nou ki te devore chan rezen an;</para>
  <para style="q1" vid="ISA 3:14">piyaj malere a fèt anndan lakay nou.<verse eid="ISA 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 3:15"/>Se kilès ki bannou dwa pou <note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="PSA 94:5">Sòm 94:5</ref></char></note>kraze pèp Mwen an,</para>
  <para style="q1" vid="ISA 3:15">e foule figi malere yo?” SENYÈ dèzame yo pale.<verse eid="ISA 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 3:16"/>Anplis SENYÈ a di: “Akoz <note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="SNG 3:11">Kan 3:11</ref></char></note>fi a Sion yo ògeye,</para>
  <para style="q1" vid="ISA 3:16">mache ak tèt anlè ak zye k ap sedwi,</para>
  <para style="q1" vid="ISA 3:16">mache ak ti pa kout pou atire zye gason,</para>
  <para style="q1" vid="ISA 3:16">e fè sone tout ti son braslè sou pye yo.<verse eid="ISA 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 3:17"/>Pou sa, SENYÈ a va aflije tèt fi a Sion yo ak kal,</para>
  <para style="q1" vid="ISA 3:17">e SENYÈ a va fè tèt yo chòv.”<verse eid="ISA 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18"/>Nan jou sa a, SENYÈ a va retire bèlte a braslè pye yo, bando sou tèt yo, <note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="JDG 8:21-26">Jij 8:21-26</ref></char></note>dekorasyon kwasan yo, <verse eid="ISA 3:18"/><verse number="19" style="v" sid="ISA 3:19"/>zanno zòrèy yo, braslè yo, vwal yo, <verse eid="ISA 3:19"/><verse number="20" style="v" sid="ISA 3:20"/><note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="EXO 29:38">Egz 29:38</ref></char></note>dekorasyon tèt yo, chenn nan pye yo, bèl twal sentiwon yo ak bwat pafen yo, bwòch yo, <verse eid="ISA 3:20"/><verse number="21" style="v" sid="ISA 3:21"/>bag dwèt yo, <note caller="+" style="x"><char style="xo" closed="false">3:21 </char><char style="xt" closed="false"><ref loc="GEN 24:47">Jen 24:47</ref></char></note>zanno nen yo. <verse eid="ISA 3:21"/><verse number="22" style="v" sid="ISA 3:22"/>Vètman gwo fèt yo, gwo manto yo, bous lajan yo, <verse eid="ISA 3:22"/><verse number="23" style="v" sid="ISA 3:23"/>miwa men yo, ti sou-vètman yo, tiban yo, ak vwal yo.<verse eid="ISA 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 3:24"/>Epi li va fin rive ke olye sant pafen dous,</para>
  <para style="q1" vid="ISA 3:24">ap gen move odè pouriti;</para>
  <para style="q1" vid="ISA 3:24">olye se sentiwon, ap gen yon kòd;</para>
  <para style="q1" vid="ISA 3:24">olye se <note caller="+" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="1PE 3:3">I Pi 3:3</ref></char></note>cheve swa byen ranje,</para>
  <para style="q1" vid="ISA 3:24">ap gen yon tèt chòv;</para>
  <para style="q1" vid="ISA 3:24">olye se bèl vètman, ya mete twal sak;</para>
  <para style="q1" vid="ISA 3:24">epi y ap pote etanp sou kò pou ranplase bote.<verse eid="ISA 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 3:25"/>Gason nou yo va <note caller="+" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="ISA 1:20">És 1:20</ref></char></note>tonbe devan nepe,</para>
  <para style="q1" vid="ISA 3:25">ak moun pwisan nou yo nan batay.<verse eid="ISA 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 3:26"/>Epi pòtay vil la va kriye fò ak lamantasyon,</para>
  <para style="q1" vid="ISA 3:26">doulè ak dezolasyon nèt. Li va <note caller="+" style="x"><char style="xo" closed="false">3:26 </char><char style="xt" closed="false"><ref loc="LAM 2:10">Lam 2:10</ref></char></note>chita atè.<verse eid="ISA 3:26"/></para>
  <chapter eid="ISA 3"/>
  <chapter number="4" style="c" sid="ISA 4"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 4:1"/>Paske sèt fanm va kenbe <note caller="+" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="GEN 30:23">Jen 30:23</ref></char></note>yon sèl gason nan jou sa a pou di l: “Nou va manje pwòp pen nou e mete pwòp rad nou. Sèlman, kite nou rele pa non ou. Souple retire wont nou an!”<verse eid="ISA 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2"/>Nan jou sa a, branch SENYÈ a va bèl, plen ak glwa, e fwi tè a va fè yo leve tèt yo wo akoz bèlte a tout retay Israël yo. <verse eid="ISA 4:2"/><verse number="3" style="v" sid="ISA 4:3"/>Li va rive ke sila ki rete Sion an ak sila yo ki rete Jérusalem nan va rele sen— tout moun ki anrejistre pou <note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="EXO 32:32">Egz 32:32</ref> </char></note> lavi Jérusalem yo <verse eid="ISA 4:3"/><verse number="4" style="v" sid="ISA 4:4"/>lè Senyè a fin lave fè sòti tout salte fi a Sion yo, e pirifye Jérusalem de tout san vèse pou fè l sòti nan mitan li, pa lespri jistis ak <note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="ISA 1:31">És 1:31</ref> </char></note>lespri brile a. <verse eid="ISA 4:4"/><verse number="5" style="v" sid="ISA 4:5"/>SENYÈ la va fè sou tout landwa Mòn Sion, ak sou tout asanble li yo, yon <note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Egz 13:21-22</ref></char></note>nwaj pa jou, lafimen a menm, epi eklere ak yon flanm dife pandan nwit la, paske sou tout glwa la, va genyen yon kouvèti. <verse eid="ISA 4:5"/><verse number="6" style="v" sid="ISA 4:6"/>Va gen <note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 27:5">Sòm 27:5</ref></char></note>abri pou bay lonbraj kont chalè jounen an, e pou pwoteje kont tanpèt ak lapli.<verse eid="ISA 4:6"/></para>
  <chapter eid="ISA 4"/>
  <chapter number="5" style="c" sid="ISA 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 5:1"/>Kite mwen chante koulye a pou byeneme mwen an, selon chan rezen Li.</para>
  <para style="q1" vid="ISA 5:1">Byeneme m nan te gen yon <note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="PSA 80:8">Sòm 80:8</ref></char></note>chan rezen sou yon kolin byen fètil.<verse eid="ISA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2"/>Li te fouye toupatou li,</para>
  <para style="q1" vid="ISA 5:2">retire wòch li yo,</para>
  <para style="q1" vid="ISA 5:2">e te plante li avèk pye rezen pi chwazi a.</para>
  <para style="q1" vid="ISA 5:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:2 </char>
      <char style="xt" closed="false">
        <ref loc="JER 2:21">Jr 2:21</ref>
      </char>
    </note>Li te bati yon fò nan mitan l,</para>
  <para style="q1" vid="ISA 5:2">e te fouye yon basen diven ladann.</para>
  <para style="q1" vid="ISA 5:2">Alò, li te sipoze pou l ta pwodwi bon rezen yo,</para>
  <para style="q1" vid="ISA 5:2">men li te pwodwi sèlman sa ki pa bon.<verse eid="ISA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3"/>Konsa, O abitan Jérusalem yo ak mesye Juda yo,</para>
  <para style="q1" vid="ISA 5:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:3 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:40">Mat 21:40</ref>
      </char>
    </note>jije antre Mwen menm ak chan rezen Mwen an.<verse eid="ISA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:4 </char>
      <char style="xt" closed="false">
        <ref loc="2CH 36:16">II Kwo 36:16</ref>
      </char>
    </note>Kisa anplis ki gen pou fèt pou chan rezen Mwen an ke M pa t fè deja?</para>
  <para style="q1" vid="ISA 5:4">Poukisa lè M te atann a bon rezen yo,</para>
  <para style="q1" vid="ISA 5:4">li te vin pwodwi sa ki pa bon yo?<verse eid="ISA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5"/>Pou sa a, kite Mwen di nou koulye a sa M ap fè ak chan rezen sa a:</para>
  <para style="q1" vid="ISA 5:5">Mwen va retire kloti li e li va brile;</para>
  <para style="q1" vid="ISA 5:5">Mwen va kraze miray li e li va vin foule nèt.<verse eid="ISA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6"/>Mwen va gaye gate l nèt.</para>
  <para style="q1" vid="ISA 5:6">Li p ap koupe ni sèkle ak wou,</para>
  <para style="q1" vid="ISA 5:6">men pikan ak zepin va vin leve nan li.</para>
  <para style="q1" vid="ISA 5:6">Anplis, Mwen va pase lòd sou nwaj yo</para>
  <para style="q1" vid="ISA 5:6">pou <note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="1KI 8:35">I Wa 8:35</ref> </char></note>lapli pa tonbe ladann.<verse eid="ISA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7"/>Paske <note caller="+" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="PSA 80:8-11">Sòm 80:8-11</ref></char></note>chan rezen SENYÈ dèzame yo se lakay Israël,</para>
  <para style="q1" vid="ISA 5:7">e pèp Juda a se plant ki ba Li plezi a.</para>
  <para style="q1" vid="ISA 5:7">Konsa, Li t ap chache jistis;</para>
  <para style="q1" vid="ISA 5:7">men olye sa Li te jwenn san vèse;</para>
  <para style="q1" vid="ISA 5:7">pou ladwati, men olye sa, moun k ap rele “Amwey”.<verse eid="ISA 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 5:8"/>Malè a sila ki ogmante kay sou kay</para>
  <para style="q1" vid="ISA 5:8">ak chan a sou lòt chan,</para>
  <para style="q1" vid="ISA 5:8">jiskaske pa gen plas,</para>
  <para style="q1" vid="ISA 5:8">pou ou oblije rete sèl nan mitan peyi a!<verse eid="ISA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 5:9"/>Nan zòrèy mwen SENYÈ dèzame yo te sèmante:</para>
  <para style="q1" vid="ISA 5:9">“Anverite, anpil kay va vin <note caller="+" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="MAT 23:38">Mat 23:38</ref></char></note>vid;</para>
  <para style="q1" vid="ISA 5:9">menm sa ki bèl yo, san moun pou rete ladann.<verse eid="ISA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 5:10"/>Paske kat ekta teren p ap donnen plis ke yon bat (22 lit) diven</para>
  <para style="q1" vid="ISA 5:10">e yon <note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="EZK 45:11">Éz 45:11</ref></char></note>omè (220 lit) p ap bay plis ke yon efa (22 lit) sereyal.”<verse eid="ISA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 5:11"/>Malè a sila ki leve granmaten yo</para>
  <para style="q1" vid="ISA 5:11">pou yo ka kouri dèyè <note caller="+" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="PRO 23:29-30">Pwov 23:29-30</ref></char></note> bwason fò,</para>
  <para style="q1" vid="ISA 5:11">sila ki rete kanpe tan lannwit pou diven an ka anflame yo.<verse eid="ISA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 5:12"/>Gwo fèt pa yo akonpanye ak jwe gita ak ap, tanbouren, flit ak diven;</para>
  <para style="q1" vid="ISA 5:12">men <note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="JOB 34:27">Job 34:27</ref></char></note>yo pa okipe zèv SENYÈ yo,</para>
  <para style="q1" vid="ISA 5:12">ni yo pa konsidere zèv men Li yo.<verse eid="ISA 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 5:13"/>Pou sa, pèp Mwen an antre an egzil akoz <note caller="+" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="ISA 1:3">És 1:3</ref></char></note>mank konesans yo;</para>
  <para style="q1" vid="ISA 5:13">epi mesye ki gen onè yo</para>
  <para style="q1" vid="ISA 5:13">rete grangou e foul moun yo rete sèch ak swaf.<verse eid="ISA 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 5:14"/>Pou sa, <note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="PRO 30:16">Pwov 30:16</ref></char></note>Sejou mò yo vin fè gòj li pi gwo</para>
  <para style="q1" vid="ISA 5:14">e louvri bouch li jiskaske li pa ka kontwole;</para>
  <para style="q1" vid="ISA 5:14">epi bèlte a Jérusalem, tout pèp li a,</para>
  <para style="q1" vid="ISA 5:14">ak gwo kri kè kontan yo, vin desann ladann.<verse eid="ISA 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 5:15"/>Pou sa, tout moun yo va imilye e limanite va abese;</para>
  <para style="q1" vid="ISA 5:15">anplis, <note caller="+" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="ISA 2:11">És 2:11</ref></char></note>zye a ògeye a va vin febli nèt.<verse eid="ISA 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 5:16"/>Men SENYÈ dèzame yo va leve wo nan jijman</para>
  <para style="q1" vid="ISA 5:16">e Bondye sen an va montre <note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="ISA 8:13">És 8:13</ref> </char></note>sentete Li nan ladwati.<verse eid="ISA 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 5:17"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ISA 7:25">És 7:25</ref></char></note>jèn mouton yo va manje alèz konsi se nan chan patiraj</para>
  <para style="q1" vid="ISA 5:17">e etranje yo va manje pami ansyen mazi a moun rich yo.<verse eid="ISA 5:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 5:18"/>Malè a sila ki rale <note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="ISA 59:4-8">És 59:4-8</ref></char></note>inikite ak kòd manti,</para>
  <para style="q1" vid="ISA 5:18">e ki fè peche tankou se kòd kabwèt;<verse eid="ISA 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 5:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:19 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 12:22">Éz 12:22</ref>
      </char>
    </note>Ka p di: “Kite Li fè vit,</para>
  <para style="q1" vid="ISA 5:19">kite Li prese fè travay Li pou nou ka wè;</para>
  <para style="q1" vid="ISA 5:19">kite volonte a Sila Ki Sen an Israël la</para>
  <para style="q1" vid="ISA 5:19">vin rapwoche pou fè sa rive pou nou ka konnen!”<verse eid="ISA 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 5:20"/>Malè a sila ki <note caller="+" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 17:15">Pwov 17:15</ref></char></note>rele mal la bon,</para>
  <para style="q1" vid="ISA 5:20">ak bon nan mal;</para>
  <para style="q1" vid="ISA 5:20">sila ki prezante tenèb la tankou limyè a,</para>
  <para style="q1" vid="ISA 5:20">ak limyè a kon tenèb la;</para>
  <para style="q1" vid="ISA 5:20">sila ki prezante sa ki anmè a kon dous,</para>
  <para style="q1" vid="ISA 5:20">e sa ki dous kon anmè.<verse eid="ISA 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 5:21"/>Malè a sila ki <note caller="+" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="PRO 3:7">Pwov 3:7</ref></char></note>saj nan pwòp zye yo</para>
  <para style="q1" vid="ISA 5:21">e ki sipoze ke yo byen koken yo!<verse eid="ISA 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 5:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:22 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:30">Pwov 23:30</ref>
      </char>
    </note>Malè a sila ki vanyan nan bwè gwòg la</para>
  <para style="q1" vid="ISA 5:22">e gen gwo kouraj nan mele bwason fò a,<verse eid="ISA 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 5:23"/>sila ki jistifye mechan yo pou kòb glise anba tab</para>
  <para style="q1" vid="ISA 5:23">e ki <note caller="+" style="x"><char style="xo" closed="false">5:23 </char><char style="xt" closed="false"><ref loc="PSA 94:21">Sòm 94:21</ref> </char></note>rachte dwa a sila ki gen rezon yo!<verse eid="ISA 5:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 5:24"/>Akoz sa, tankou lang dife a manje pay sèch yo</para>
  <para style="q1" vid="ISA 5:24">e konsonmen zèb sèch nan flanm nan,</para>
  <para style="q1" vid="ISA 5:24">konsa rasin yo va vin tankou pouriti,</para>
  <para style="q1" vid="ISA 5:24">e flè yo va vannen ale tankou pousyè;</para>
  <para style="q1" vid="ISA 5:24">paske yo fin <note caller="+" style="x"><char style="xo" closed="false">5:24 </char><char style="xt" closed="false"><ref loc="ISA 8:6">És 8:6</ref></char></note>rejte lalwa SENYÈ dèzame yo,</para>
  <para style="q1" vid="ISA 5:24">e te rayi pawòl a Sila Ki Sen An Israël la.<verse eid="ISA 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 5:25"/>Akoz sa, kòlè SENYÈ a te brile kont pèp Li a,</para>
  <para style="q1" vid="ISA 5:25">Li te lonje men l kont yo e te frape yo tonbe anba.</para>
  <para style="q1" vid="ISA 5:25">Mòn yo te tranble</para>
  <para style="q1" vid="ISA 5:25">e kadav yo te kouche tankou fatra nan mitan lari a.</para>
  <para style="q1" vid="ISA 5:25">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:25 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 9:12-21">És 9:12-21</ref> </char>
    </note>Menm ak tout sa a, kòlè Li a poko fin pase, men men L toujou lonje.<verse eid="ISA 5:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 5:26"/>Konsa, Li va leve yon <note caller="+" style="x"><char style="xo" closed="false">5:26 </char><char style="xt" closed="false"><ref loc="ISA 13:2-3">És 13:2-3</ref></char></note>drapo a yon nasyon byen lwen</para>
  <para style="q1" vid="ISA 5:26">e Li va soufle pou li soti nan dènye pwent latè;</para>
  <para style="q1" vid="ISA 5:26">epi gade byen, li va vini byen vit ak gwo vitès.<verse eid="ISA 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 5:27"/>Nan nasyon sila a, nanpwen moun ki ni fatige, ni tonbe;</para>
  <para style="q1" vid="ISA 5:27">nanpwen moun k ap kabicha oswa k ap dòmi;</para>
  <para style="q1" vid="ISA 5:27">ni <note caller="+" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="JOB 12:18">Job 12:18</ref> </char></note>sentiwon nan senti li pa lage,</para>
  <para style="q1" vid="ISA 5:27">menm bretèl sandal li pa janm kase.<verse eid="ISA 5:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 5:28"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:28 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:12-13">Sòm 7:12-13</ref>
      </char>
    </note>Flèch li yo file e tout banza li yo fin koube;</para>
  <para style="q1" vid="ISA 5:28">pye cheval li yo parèt kon pyè silèks,</para>
  <para style="q1" vid="ISA 5:28">e wou cha li yo tankou toubiyon.<verse eid="ISA 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 5:29"/>Kri <note caller="+" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="JER 51:38">Jr 51:38</ref></char></note>gwonde li tankou yon lyon</para>
  <para style="q1" vid="ISA 5:29">e vwa li tankou jèn lyon;</para>
  <para style="q1" vid="ISA 5:29">li fè gwo bri pandan l ap sezi viktim li an</para>
  <para style="q1" vid="ISA 5:29">e pote l ale kote nanpwen moun pou delivre li.<verse eid="ISA 5:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 5:30"/>Epi li va gwonde sou li nan jou sa a tankou gwo bri lanmè.</para>
  <para style="q1" vid="ISA 5:30">Si yon moun anwò dlo <note caller="+" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="ISA 8:22">És 8:22</ref></char></note>ta gade vè latè;</para>
  <para style="q1" vid="ISA 5:30">men gade, tout fènwa ak gwo twoub.</para>
  <para style="q1" vid="ISA 5:30">Menm limyè fènwa akoz nwaj li yo.<verse eid="ISA 5:30"/></para>
  <chapter eid="ISA 5"/>
  <chapter number="6" style="c" sid="ISA 6"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1"/>Nan ane Wa Ozias te mouri an, <note caller="+" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="JHN 12:41">Jn 12:41</ref></char></note>mwen te wè SENYÈ a ki te chita sou yon twòn, byen wo e egzalte, avèk ke wòb Li ki te ranpli tanp lan. <verse eid="ISA 6:1"/><verse number="2" style="v" sid="ISA 6:2"/>Serafen yo te kanpe pi wo Li, <note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="REV 4:8">Rev 4:8</ref></char></note>yo chak ak sis zèl: ak de, li te kouvri figi li; ak de, li te kouvri pye li e ak de, li te vole.<verse eid="ISA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 6:3"/>Youn te rele a yon lòt epi te di:</para>
  <para style="q1" vid="ISA 6:3">“Sen, Sen, Sen, se SENYÈ dèzame yo;</para>
  <para style="q1" vid="ISA 6:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:3 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:21">Nonb 14:21</ref>
      </char>
    </note> tout latè plen ak glwa Li.”<verse eid="ISA 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 6:4"/>Fondasyon a papòt yo te tranble ak vwa a sila ki te rele fò a pandan <note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="REV 15:8">Rev 15:8</ref></char></note>tanp lan te plen ak lafimen. <verse eid="ISA 6:4"/><verse number="5" style="v" sid="ISA 6:5"/>Konsa, mwen te di: “Malè a mwen, paske mwen fin detwi nèt! Akoz mwen se yon nonm ak <note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="EXO 6:12-30">Egz 6:12-30</ref> </char></note>lèv ki pa pwòp, e mwen viv pami yon pèp ak lèv ki pa pwòp; paske zye m te wè Wa a, SENYÈ dèzame yo.”<verse eid="ISA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6"/>Epi youn nan serafen yo te vole kote m ak yon mòso chabon tou limen nan men l, ke li te pran sou <note caller="+" style="x"><char style="xo" closed="false">6:6 </char><char style="xt" closed="false"><ref loc="REV 8:3">Rev 8:3</ref></char></note>lotèl la ak pensèt. <verse eid="ISA 6:6"/><verse number="7" style="v" sid="ISA 6:7"/>Li te touche bouch mwen ak li, epi te di: “Men vwala, sa fin touche lèv ou; epi <note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="ISA 40:2">És 40:2</ref></char></note>inikite pa ou retire e peche ou vin padone.”<verse eid="ISA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8"/>Konsa, mwen te tande vwa SENYÈ a, ki te di: “Se kilès ke m ap voye, e se kilès k ap ale pou Nou?”</para>
  <para style="p" vid="ISA 6:8">Epi <note caller="+" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="ACT 26:19">Trav 26:19</ref></char></note>mwen te di: “Men mwen! Voye mwen!”<verse eid="ISA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9"/>Li te di: “Ale di pèp sa a:</para>
  <para style="q1" vid="ISA 6:9">‘Kontinye <note caller="+" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="ISA 43:8">És 43:8</ref></char></note>koute, men pa wè;</para>
  <para style="q1" vid="ISA 6:9">kontinye gade, men pa konprann.’<verse eid="ISA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 6:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:15">Mat 13:15</ref>
      </char>
    </note>Rann kè a pèp sa a ensansib, zòrèy yo di e zye yo mal pou wè;</para>
  <para style="q1" vid="ISA 6:10">otreman, petèt yo ta wè ak zye yo,</para>
  <para style="q1" vid="ISA 6:10">tande ak zòrèy yo,</para>
  <para style="q1" vid="ISA 6:10">konprann ak kè yo</para>
  <para style="q1" vid="ISA 6:10">e retounen pou resevwa gerizon.”<verse eid="ISA 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11"/>Epi mwen te di: “Senyè, pou konbyen tan?”</para>
  <para style="p" vid="ISA 6:11">Li te reponn:</para>
  <para style="q1" vid="ISA 6:11">“Jiskaske vil yo fin devaste nèt e pa gen moun pou rete ladan yo,</para>
  <para style="q1" vid="ISA 6:11">kay yo vin san moun e peyi a fin dezole,<verse eid="ISA 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 6:12"/>epi SENYÈ a fin <note caller="+" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="DEU 28:64">Det 28:64</ref></char></note>retire moun yo byen lwen</para>
  <para style="q1" vid="ISA 6:12">e plas abandone yo vin anpil nan mitan peyi a.<verse eid="ISA 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 6:13"/>Sepandan, si genyen yon dizyèm pòsyon ladann,</para>
  <para style="q1" vid="ISA 6:13">li va osi manje nèt,</para>
  <para style="q1" vid="ISA 6:13">tankou yon bwa terebinth oswa yon bwadchenn</para>
  <para style="q1" vid="ISA 6:13">ak chouk ki rete lè l koupe mete atè.</para>
  <para style="q1" vid="ISA 6:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:13 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 7:6">Det 7:6</ref> </char>
    </note>Konsa, Semans ki sen se chouk li.”<verse eid="ISA 6:13"/></para>
  <chapter eid="ISA 6"/>
  <chapter number="7" style="c" sid="ISA 7"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1"/>Alò, li te vin rive nan jou Achaz yo, fis a Jotham la, fis a Ozias la, wa Juda a, ke Retsin, wa Syrie a ak Pékach, fis a Remalia a, wa Israël la, te monte vè Jérusalem pou fè lagè kont li, men yo <note caller="+" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="ISA 7:6-7">És 7:6-7</ref></char></note>pa t ka genyen l. <verse eid="ISA 7:1"/><verse number="2" style="v" sid="ISA 7:2"/>Lè rapò a te rive kote <note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="ISA 7:13">És 7:13</ref></char></note>lakay David e te di: “Siryen yo te fè kan Éphraïm”, ke Achaz ak kè pèp li te vin ajite tankou bwa forè k ap souke nan van.<verse eid="ISA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3"/>Konsa, SENYÈ a te di a Ésaïe: “Sòti la koulye a pou rankontre Achaz, ou menm ak fis ou, Schear-Jaschub, nan pwent <note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="2KI 18:17">II Wa 18:17</ref></char></note>kanal la premye ma dlo sou gran chemen ki mennen kote chan Foulon an. <verse eid="ISA 7:3"/><verse number="4" style="v" sid="ISA 7:4"/>Epi di li: ‘Fè atansyon e rete kalm. Pa pè e pa dekouraje akoz grenn chouk <note caller="+" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="AMO 4:11">Am 4:11</ref></char></note>sann cho sa yo k ap fè lafimen akoz de gwo kòlè Retsin ak Syrie, ak fis Remalia a. <verse eid="ISA 7:4"/><verse number="5" style="v" sid="ISA 7:5"/>Paske <note caller="+" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="ISA 7:2">És 7:2</ref></char></note>Syrie, Éphraïm ak fis a Remalia yo, te fè plan mechanste kont ou e te di: <verse eid="ISA 7:5"/><verse number="6" style="v" sid="ISA 7:6"/>Annou monte kont Juda, teworize l, fè pou nou yon brèch nan miray li yo, e fè fis Tabeel la vin wa nan mitan li.” <verse eid="ISA 7:6"/><verse number="7" style="v" sid="ISA 7:7"/>Konsa pale Senyè BONDYE a: <note caller="+" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="ISA 8:10">És 8:10</ref></char></note>“Sa p ap kanpe, ni sa p ap pase.” <verse eid="ISA 7:7"/><verse number="8" style="v" sid="ISA 7:8"/>Paske tèt Syrie a se <note caller="+" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="GEN 14:15">Jen 14:15</ref></char></note>Damas, tèt Damas se Retsin (e nan yon lòt swasann-senk ane, Éphraïm va kraze nèt jiskaske li pa menm yon pèp ankò), <verse eid="ISA 7:8"/><verse number="9" style="v" sid="ISA 7:9"/>Epi tèt a Éphraïm se Samarie, tèt a Samarie se fis a Remalia a. <note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="2CH 20:20">II Kwo 20:20</ref></char></note>Si ou pa kwè, anverite, ou p ap etabli.’”<verse eid="ISA 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10"/>SENYÈ a te pale ankò ak Achaz. Li te di: <verse eid="ISA 7:10"/><verse number="11" style="v" sid="ISA 7:11"/>“Mande yon <note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="2KI 19:29">II Wa 19:29</ref></char></note>sign pou ou menm soti nan SENYÈ a, Bondye ou a; fè l nan fon a, tankou Sejou mò yo, oswa nan wotè tankou rive nan syèl la.”<verse eid="ISA 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 7:12"/>Men Achaz te di: “Mwen p ap mande, ni mwen p ap pase SENYÈ a a leprèv!”<verse eid="ISA 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13"/>Epi li te di: “Koute koulye a, O lakay David! Èske se yon bagay ki twò piti pou nou menm pou tante pasyans a lezòm, ke nou va tante pasyans a <note caller="+" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="ISA 25:1">És 25:1</ref> </char></note>Bondye mwen an tou? <verse eid="ISA 7:13"/><verse number="14" style="v" sid="ISA 7:14"/>Pou sa, SENYÈ a, Li menm, va bay nou yon sign: Gade byen, yon <note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="MAT 1:23">Mat 1:23</ref></char></note>vyèj va vin ansent. Li va fè yon fis e li va rele non Li <note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="ISA 8:8-10">És 8:8-10</ref> </char></note>Emmanuel. <verse eid="ISA 7:14"/><verse number="15" style="v" sid="ISA 7:15"/>Li va manje <note caller="+" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="ISA 7:22">És 7:22</ref></char></note>bòl lèt kaye ak siwo myèl nan lè Li gen konesans ase pou refize mal e chwazi sa ki bon. <verse eid="ISA 7:15"/><verse number="16" style="v" sid="ISA 7:16"/>Paske avan jenn gason a va gen ase konesans pou refize mal e chwazi sa ki bon, <note caller="+" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="ISA 8:14">És 8:14</ref> </char></note>peyi a de wa ke nou krent yo va abandone nèt. <verse eid="ISA 7:16"/><verse number="17" style="v" sid="ISA 7:17"/>SENYÈ a va mennen fè rive sou nou, sou pèp nou an ak sou lakay papa nou, jou konsi ki pa t janm gen parèy depi jou ke <note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="1KI 12:16">I Wa 12:16</ref></char></note>Éphraïm te separe ak Juda a—Wa Assyrie a.<verse eid="ISA 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18"/>Nan jou sa a, SENYÈ a va soufle mouch ki nan <note caller="+" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="ISA 13:5">És 13:5</ref> </char></note>kote pi lwen nan rivyè Égypte yo ak foul myèl ki rete Assyrie yo. <verse eid="ISA 7:18"/><verse number="19" style="v" sid="ISA 7:19"/>Yo tout va vini fè anplasman sou ravin apik yo, sou <note caller="+" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="ISA 2:19">És 2:19</ref></char></note>ti pla falèz yo, kloti bwa pikan yo ak sou tout sous patiraj bèt yo.<verse eid="ISA 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 7:20"/>Nan jou sa a, SENYÈ a va <note caller="+" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="2KI 18:13-16">II Wa 18:13-16</ref></char></note>raze ak yon razwa, ki lwe soti nan rejyon lòtbò rivyè Euphrate la. Se wa Assyrie la menm. L ap manje tout jis nan tèt ak plim sou pye, pou l rive fin manje jis nan bab la.<verse eid="ISA 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 7:21"/>Alò, nan jou sa a, yon nonm ka fè viv yon sèl grenn <note caller="+" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="ISA 14:30">És 14:30</ref></char></note>gazèl bèf ak yon pè mouton. <verse eid="ISA 7:21"/><verse number="22" style="v" sid="ISA 7:22"/>Men akoz gwo kantite lèt ki pwodwi, li va bwè bòl lèt kaye a, paske tout moun ki rete nan peyi a va bwè <note caller="+" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="ISA 8:15">És 8:15</ref></char></note>bòl lèt ak siwo myèl la.<verse eid="ISA 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 7:23"/>Konsa, li va rive nan jou sa a, ke <note caller="+" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="ISA 5:10">És 5:10</ref></char></note>tout kote ki te konn genyen mil pye rezen, ki te gen valè a mil sik ajan, va vin tounen raje ak pikan. <verse eid="ISA 7:23"/><verse number="24" style="v" sid="ISA 7:24"/>Moun va vini la ak banza ak flèch yo akoz tout tè a va vin fè raje ak pikan. <verse eid="ISA 7:24"/><verse number="25" style="v" sid="ISA 7:25"/>Tout kolin ki te konn kiltive ak wou yo, nou p ap prale la akoz nou pè raje ak pikan. Li va devni yon kote pou <note caller="+" style="x"><char style="xo" closed="false">7:25 </char><char style="xt" closed="false"><ref loc="ISA 5:17">És 5:17</ref></char></note> pye bèf ak mouton pou yo foule l nèt.”<verse eid="ISA 7:25"/></para>
  <chapter eid="ISA 7"/>
  <chapter number="8" style="c" sid="ISA 8"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1"/>SENYÈ a te di mwen, pran pou ou yon gwo tablo, e ekri sou li an lèt òdinè: “ rele non l ‘Maher-Schalal-Chasch-Baz’” <note caller="+" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="ISA 8:3">És 8:3</ref> </char></note>(Vit se piyaj la e rapid se viktim nan), <verse eid="ISA 8:1"/><verse number="2" style="v" sid="ISA 8:2"/>Epi Mwen va pran pou Mwen temwen fidèl pou fè temwayaj, <note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="2KI 16:10-16">II Wa 16:10-16</ref></char></note> Urie, prèt la ak Zacharie, fis a Bérékia a.<verse eid="ISA 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 8:3"/>Pou sa, mwen te pwoche pwofetès la. Li te vin ansent e li te bay nesans a yon fis. Epi SENYÈ a te di mwen: “Bay li non Maher-Schalal-Chasch-Baz. <verse eid="ISA 8:3"/><verse number="4" style="v" sid="ISA 8:4"/>Paske avan tigason an konnen jan pou li kriye: ‘Papa mwen oswa manman mwen’, tout richès Damas ak piyaj Samarie yo va fin pote ale devan wa Assyrie a.”<verse eid="ISA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5"/>Ankò SENYÈ a te pale ak mwen. Li te di: <verse eid="ISA 8:5"/><verse number="6" style="v" sid="ISA 8:6"/>“Konsi moun sa yo fin <note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="ISA 1:20">És 1:20</ref></char></note> rejte dlo Siloé k ap koule dous la pou rejwi nan Retsin ak fis Remalia a; <verse eid="ISA 8:6"/><verse number="7" style="v" sid="ISA 8:7"/>alò, pou sa, men gade, SENYÈ a prè pou mennen sou yo dlo fò an gran kantite ki sòti nan rivyè Euphrate la, wa Assyrie ak tout glwa li. Dlo sa a va <note caller="+" style="x"><char style="xo" closed="false">8:7 </char><char style="xt" closed="false"><ref loc="AMO 8:8">Am 8:8</ref> </char></note>monte wo pou kite kanal li yo e vide sou tout rebò li yo. <verse eid="ISA 8:7"/><verse number="8" style="v" sid="ISA 8:8"/>Li va pase kouri nèt rive Juda. Li va debòde e pase sou li nèt jiskaske li <note caller="+" style="x"><char style="xo" closed="false">8:8 </char><char style="xt" closed="false"><ref loc="ISA 30:28">És 30:28</ref> </char></note>rive menm nan kou li. Konsa, zèl ouvri li yo va ranpli lajè peyi ou a, O Emmanuel!<verse eid="ISA 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 8:9"/>“Se pou fè bwi, o pèp yo, e vin <note caller="+" style="x"><char style="xo" closed="false">8:9 </char><char style="xt" closed="false"><ref loc="DAN 2:34-35">Dan 2:34-35</ref> </char></note>kraze nèt! Bay zòrèy nou, tout peyi lwen yo. Mare senti nou, malgre n ap fin brize nèt! Abiye pou batay la, malgre n ap brize nèt. <verse eid="ISA 8:9"/><verse number="10" style="v" sid="ISA 8:10"/><note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="JOB 5:12">Job 5:12</ref></char></note> Fè yon plan, e sa ap bloke. Pale yon pawòl, e sa p ap dire. Paske Bondye avèk nou.”<verse eid="ISA 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11"/>Paske se konsa SENYÈ a te pale mwen ak gwo pouvwa e te pase m lòd pou m <note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="EZR 2:8">Esd 2:8</ref></char></note> pa mache nan chemen a pèp sa a, epi te di: <verse eid="ISA 8:11"/><verse number="12" style="v" sid="ISA 8:12"/>“Ou pa dwe di: ‘Konplo’ de tout sa ke pèp sa a rele ‘konplo’ a. <note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="1PE 3:14-15">I Pi 3:14-15</ref></char></note> Ou pa pou pè sa ke yo menm pè a, ni etone pa li. <verse eid="ISA 8:12"/><verse number="13" style="v" sid="ISA 8:13"/>Se SENYÈ dèzame yo <note caller="+" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="NUM 20:12">Nonb 20:12</ref></char></note> ke ou dwe gade kon sen. Se Li k ap vin lakrent ou. Se li k ap fè w etone. <verse eid="ISA 8:13"/><verse number="14" style="v" sid="ISA 8:14"/>Li va devni yon sanktiyè; men pou toulède kay Israël yo, L ap yon <note caller="+" style="x"><char style="xo" closed="false">8:14 </char><char style="xt" closed="false"><ref loc="LUK 2:34">Luc 2:34</ref></char></note> wòch pou fè nou bite, yon zatrap ak yon pèlen pou sila ki rete Jérusalem yo. <verse eid="ISA 8:14"/><verse number="15" style="v" sid="ISA 8:15"/>Se anpil moun <note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="ISA 28:13">És 28:13</ref></char></note> k ap bite sou yo, yo va tonbe e yo va kraze nèt. Yo menm va pran nan pyèj e va tonbe pou yo kenbe nèt.”<verse eid="ISA 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 8:16"/>Mare akò la. Sele lalwa pami <note caller="+" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="DAN 12:4">Dan 12:4</ref></char></note> disip mwen yo. <verse eid="ISA 8:16"/><verse number="17" style="v" sid="ISA 8:17"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 25:9">És 25:9</ref></char></note> tann SENYÈ a ki kache figi Li kont kay Jacob la. Mwen va chache Li ak enpasyans. <verse eid="ISA 8:17"/><verse number="18" style="v" sid="ISA 8:18"/>Gade byen, mwen menm ak pitit ke SENYÈ a te ban mwen yo se pou <note caller="+" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="LUK 2:34">Luc 2:34</ref></char></note> sign ak mèvèy an Israël ki sòti depi nan SENYÈ Dèzame yo, ki demere sou Mòn Sion.<verse eid="ISA 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19"/>Lè y ap di nou: “Konsilte sila ki konn pale ak mò yo ak divinò ki yo menm pale ak ti souf e bougonnen;” èske yon pèp pa ta dwe konsilte Bondye pa yo? Èske yo ta dwe konsilte mò yo pou sila ki vivan yo? <verse eid="ISA 8:19"/><verse number="20" style="v" sid="ISA 8:20"/>Vire kote lalwa ak akò la! Si yo pa pale selon pawòl sa a, se akoz ke <note caller="+" style="x"><char style="xo" closed="false">8:20 </char><char style="xt" closed="false"><ref loc="ISA 8:22">És 8:22</ref></char></note> yo pa gen granmaten k ap vini. <verse eid="ISA 8:20"/><verse number="21" style="v" sid="ISA 8:21"/>Yo va pase nan peyi a, <note caller="+" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="ISA 9:20-21">És 9:20-21</ref></char></note> plen gwo pwoblèm ak grangou nèt. Li va vin rive ke lè yo grangou, y ap vin anraje e modi wa yo ak Bondye pandan y ap gade anlè. <verse eid="ISA 8:21"/><verse number="22" style="v" sid="ISA 8:22"/>Epi konsa, y ap gade vè latè, gade byen, gwo twoub ak fènwa, dezolasyon ak gwo lapèn. Konsa, yo va <note caller="+" style="x"><char style="xo" closed="false">8:22 </char><char style="xt" closed="false"><ref loc="ISA 8:20">És 8:20</ref></char></note> chase ale nan tenèb.<verse eid="ISA 8:22"/></para>
  <chapter eid="ISA 8"/>
  <chapter number="9" style="c" sid="ISA 9"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1"/>Men nanpwen tristès ankò pou sila ki te nan gwo lapèn nan; nan tan pase yo, Li te trete <note caller="+" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="MAT 4:15-16">Mat 4:15-16</ref> </char></note>peyi Zabulon ak peyi Nephthali tankou sa ki pa t gen valè; men pi lwen, Li te fè li plenn glwa, pa lòtbò rivyè Jourdain an, Galilée a pèp etranje yo.<verse eid="ISA 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 9:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:16">Mat 4:16</ref>
      </char>
    </note> Pèp ki mache nan tenèb la va wè yon gwo limyè;</para>
  <para style="q1" vid="ISA 9:2">sila ki rete nan peyi lonbraj lamò a,</para>
  <para style="q1" vid="ISA 9:2">limyè va fonse briye sou yo;<verse eid="ISA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 9:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:3 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 26:15">És 26:15</ref>
      </char>
    </note> Ou te fè pèp la grandi anpil;</para>
  <para style="q1" vid="ISA 9:3">Ou ogmante kè kontan yo.</para>
  <para style="p" vid="ISA 9:3">Yo kontan prezans Ou. Menm jan moun yo gen kè kontan an nan rekòlt la lè y ap divize piyaj la. <verse eid="ISA 9:3"/><verse number="4" style="v" sid="ISA 9:4"/>Paske Ou va kraze fado ki peze sou do yo a ak baton sou zepòl yo; baton a <note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="ISA 14:4">És 14:4</ref> </char></note>sila ki oprime yo, tankou nan batay Madian an. <verse eid="ISA 9:4"/><verse number="5" style="v" sid="ISA 9:5"/>Paske tout protej gèrye a ak bwi gwo batay, ak manto ki woule nan san va sèvi pou brile, yon lwil pou dife a. <verse eid="ISA 9:5"/><verse number="6" style="v" sid="ISA 9:6"/>Paske yon pitit va ne a nou menm, yon fis va bay a nou menm; epi <note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="MAT 28:18">Mat 28:18</ref> </char></note>gouvènman an va rete sou zepòl Li. Non Li va rele Konseye Mèvèye, Bondye Pwisan an, Papa Etènèl la, Prens Lapè a. <verse eid="ISA 9:6"/><verse number="7" style="v" sid="ISA 9:7"/><note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="DAN 2:44">Dan 2:44</ref></char></note> P ap gen fen nan gouvènman Li an ni p ap manke gen lapè sou twòn David la ak sou wayòm li an, pou etabli li e soutni l ak jistis avèk ladwati soti nan moman sa a jis rive pou tout tan. Zèl a SENYÈ dèzame yo va akonpli sa a.<verse eid="ISA 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 9:8"/>SENYÈ a voye yon mesaj rive nan Jacob</para>
  <para style="q1" vid="ISA 9:8">e li tonbe sou Israël.<verse eid="ISA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 9:9"/>Tout pèp la va konnen sa;</para>
  <para style="q1" vid="ISA 9:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">9:9 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 7:8-9">És 7:8-9</ref>
      </char>
    </note> Éphraïm ak moun ki rete Samarie yo,</para>
  <para style="q1" vid="ISA 9:9">k ap pale ak awogans e ak ògèy nan kè yo:<verse eid="ISA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 9:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAL 1:4">Mal 1:4</ref>
      </char>
    </note> “Brik yo fin tonbe,</para>
  <para style="q1" vid="ISA 9:10">men nou va rebati ak wòch taye;</para>
  <para style="q1" vid="ISA 9:10">bwa sikomò yo fin koupe,</para>
  <para style="q1" vid="ISA 9:10">men nou va ranplase yo ak bwa sèd.”<verse eid="ISA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 9:11"/>Akoz sa, SENYÈ a fè leve kont yo</para>
  <para style="q1" vid="ISA 9:11">advèsè ki sòti <note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ISA 7:1-8">És 7:1-8</ref></char></note> Retsin yo</para>
  <para style="q1" vid="ISA 9:11">e chofe ènmi yo,<verse eid="ISA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 9:12"/>Siryen lès yo ak <note caller="+" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="2CH 28:18">II Kwo 28:18</ref></char></note> Filisten lwès yo;</para>
  <para style="q1" vid="ISA 9:12">epi yo va devore Israël ak machwè ki ouvri.</para>
  <para style="q1" vid="ISA 9:12">Malgre sa, kòlè Li p ap detounen</para>
  <para style="q1" vid="ISA 9:12">e men L va toujou lonje.<verse eid="ISA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 9:13"/>Sepandan, pèp la <note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="JER 5:3">Jr 5:3</ref></char></note>p ap vire retounen</para>
  <para style="q1" vid="ISA 9:13">kote Sila ki te frape yo a,</para>
  <para style="q1" vid="ISA 9:13">ni yo pa chache SENYÈ dèzame yo.<verse eid="ISA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 9:14"/>Konsa, SENYÈ a va koupe retire ni <note caller="+" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="ISA 19:15">És 19:15</ref></char></note> tèt ni ke sou Israël,</para>
  <para style="q1" vid="ISA 9:14">ni branch palmis ak wozo nan yon sèl jou.<verse eid="ISA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 9:15"/>Tèt la se <note caller="+" style="x"><char style="xo" closed="false">9:15 </char><char style="xt" closed="false"><ref loc="ISA 3:2-3">És 3:2-3</ref></char></note> ansyen ki byen respekte a</para>
  <para style="q1" vid="ISA 9:15">e ke a se pwofèt ki ansegne manti a.<verse eid="ISA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 9:16"/>Paske sila k ap gide pèp sa yo, egare yo.</para>
  <para style="q1" vid="ISA 9:16">Epi sila ki gide pa yo ap mennen yo antre nan gwo konfizyon.<verse eid="ISA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 9:17"/>Akoz sa, SENYÈ a pa pran plezi nan jennonm yo,</para>
  <para style="q1" vid="ISA 9:17">ni Li pa fè pitye pou òfelen yo, ni pou vèv yo;</para>
  <para style="q1" vid="ISA 9:17">paske yo tout se malfektè ki san Bondye</para>
  <para style="q1" vid="ISA 9:17">e <note caller="+" style="x"><char style="xo" closed="false">9:17 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat 12:34</ref> </char></note>bouch yo tout ap pale nan foli.</para>
  <para style="q1" vid="ISA 9:17">Malgre tout sa, kòlè Li pa detounen,</para>
  <para style="q1" vid="ISA 9:17">e men L toujou lonje.<verse eid="ISA 9:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 9:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:18 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 83:14">Sòm 83:14</ref>
      </char>
    </note> Paske mechanste brile tankou dife;</para>
  <para style="q1" vid="ISA 9:18">li manje ni pikan ni raje.</para>
  <para style="q1" vid="ISA 9:18">Menm gwo rak bwa forè, li fè pran flanm</para>
  <para style="q1" vid="ISA 9:18">e yo woule monte kon yon gwo kolòn lafimen.<verse eid="ISA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 9:19"/>Se gwo kòlè a SENYÈ dèzame yo ki brile peyi a,</para>
  <para style="q1" vid="ISA 9:19">e se pèp la ki se lwil pou dife a.</para>
  <para style="q1" vid="ISA 9:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">9:19 </char>
      <char style="xt" closed="false">
        <ref loc="MIC 7:2-6">Mi 7:2-6</ref> </char>
    </note>Nanpwen moun ki eseye sove frè l.<verse eid="ISA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 9:20"/>Yo manje sou men dwat la, men yo rete grangou;</para>
  <para style="q1" vid="ISA 9:20">yo manje sou men goch la, men yo pa satisfè.</para>
  <para style="q1" vid="ISA 9:20">Yo chak manje <note caller="+" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="ISA 49:26">És 49:26</ref></char></note> chè pwòp bra yo.<verse eid="ISA 9:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 9:21"/>Manassé devore Éphraïm, Éphraïm devore Manassé</para>
  <para style="q1" vid="ISA 9:21">e ansanm, yo kont Juda.</para>
  <para style="q1" vid="ISA 9:21">
    <note caller="+" style="x">
      <char style="xo" closed="false">9:21 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:25">És 5:25</ref>
      </char>
    </note> Malgre tout sa, kòlè Li pa detounen</para>
  <para style="q1" vid="ISA 9:21">e men Li toujou lonje.<verse eid="ISA 9:21"/></para>
  <chapter eid="ISA 9"/>
  <chapter number="10" style="c" sid="ISA 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 10:1"/>Malè a sila ki <note caller="+" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="PSA 94:20">Sòm 94:20</ref></char></note> fè règleman lajistis ki pa dwat yo ak sila k ap anrejistre desizyon ki pa jis yo, <verse eid="ISA 10:1"/><verse number="2" style="v" sid="ISA 10:2"/>pou rache lajistis nan men a endijan yo, vòlè dwa a moun malere yo, pou vèv ka sèvi kon piyaj pou yo, e <note caller="+" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="ISA 1:23">És 1:23</ref> </char></note>pou yo ka piyaje òfelen yo. <verse eid="ISA 10:2"/><verse number="3" style="v" sid="ISA 10:3"/>Alò, se kisa nou va fè nan <note caller="+" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="ISA 13:6">És 13:6</ref> </char></note>jou chatiman an ak nan jou destriksyon ki va sòti byen lwen an? A kilès nou va kouri rive pou jwenn sekou? Epi se ki kote nou va lèse richès ak byen nou?<verse eid="ISA 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 10:4"/>Anyen pa p rete men y ap akwoupi pami kaptif yo oswa tonbe pami sila ki touye yo. <note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="ISA 5:25">És 5:25</ref> </char></note>Malgre sa, kòlè Li pa detounen e men L toujou lonje.<verse eid="ISA 10:4"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="5" style="v" sid="ISA 10:5"/>Malè a <note caller="+" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="JER 51:20">Jr 51:20</ref></char></note> Assyrie, baton kòlè Mwen an, e zouti pou kòlè Mwen an. <verse eid="ISA 10:5"/><verse number="6" style="v" sid="ISA 10:6"/>Mwen voye li kont yon nasyon ki san Bondye e Mwen bay li komisyon kont pèp k ap resevwa kòlè Mwen an, pou kaptire piyaj yo, sezi byen yo, e pou foule yo anba tankou <note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="ISA 5:25">És 5:25</ref> </char></note>labou nan lari. <verse eid="ISA 10:6"/><verse number="7" style="v" sid="ISA 10:7"/>Men <note caller="+" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="GEN 50:20">Jen 50:20</ref></char></note> se pa sa ki entansyon li; ni plan an pa konsa nan kè l. Men pito bi li se pou detwi e koupe retire nèt pami anpil nasyon. <verse eid="ISA 10:7"/><verse number="8" style="v" sid="ISA 10:8"/>Paske li di: “Èske tout prens mwen yo pa wa yo? <verse eid="ISA 10:8"/><verse number="9" style="v" sid="ISA 10:9"/>Èske Calno pa tankou <note caller="+" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="2CH 35:20">II Kwo 35:20</ref> </char></note>Carkemisch, oswa Hamath pa tankou Arpad? Ni Samarie pa tankou Damas? <verse eid="ISA 10:9"/><verse number="10" style="v" sid="ISA 10:10"/>Menm jan men m te rive kote <note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="2KI 19:17-18">II Wa 19:17-18</ref></char></note> wayòm a zidòl yo, ki te gen imaj taye pi gran pase sila Jérusalem ak Samarie yo, <verse eid="ISA 10:10"/><verse number="11" style="v" sid="ISA 10:11"/>eske mwen p ap fè a Jérusalem ak imaj pa li yo menm jan ke m te fè a Samarie ak <note caller="+" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="ISA 2:8">És 2:8</ref></char></note> zidòl pa li yo?” <verse eid="ISA 10:11"/><verse number="12" style="v" sid="ISA 10:12"/>Se konsa li va rive ke lè Senyè a fin akonpli tout travay Li yo sou Mòn Sion ak sou Jérusalem, Mwen va pini fwi a kè ògèy wa Assyrie a ak gwosè awogans li. <verse eid="ISA 10:12"/><verse number="13" style="v" sid="ISA 10:13"/>Paske li te di: “Ak pouvwa men m ak sajès mwen, mwen te fè sa a, paske mwen gen konprann. Mwen te <note caller="+" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="HAG 2:6-11">Ag 2:6-11</ref></char></note>retire bòn a tout pèp la, mwen te piyaje tout byen yo, e tankou yon nonm pwisan, mwen te ranvèse chèf yo. <verse eid="ISA 10:13"/><verse number="14" style="v" sid="ISA 10:14"/>Epi men m te lonje desann jis li rive nan richès a pèp la kon yon <note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="JER 49:16">Jr 49:16</ref></char></note>nich, e tankou yon moun ta ranmase ze ki abandone, se konsa mwen te ranmase tout latè. Konsa, pa t gen youn nan yo ki te bat zèl li, oswa te ouvri bèk li, ni ki te kriye.” <verse eid="ISA 10:14"/><verse number="15" style="v" sid="ISA 10:15"/>Èske rach la fèt pou <note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 29:16">És 29:16</ref> </char></note>vin ògeye sou sila ki koupe avè l la? Èske si a konn egzalte tèt li sou sila ki manevre l la? Sa ta sanble ak yon baton ki voye sila ki leve l la, oswa tankou yon baton ki leve sa ki pa fèt ak bwa a. <verse eid="ISA 10:15"/><verse number="16" style="v" sid="ISA 10:16"/>Pou sa, Senyè a, BONDYE dèzame yo, va voye yon <note caller="+" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="PSA 106:15">Sòm 106:15</ref></char></note>maladi deperi moun nèt pami gèrye vanyan li yo; epi anba ògèy li, va rasanble yon dife tankou yon flanm k ap brile. <verse eid="ISA 10:16"/><verse number="17" style="v" sid="ISA 10:17"/>Limyè Israël la va devni yon dife; <note caller="+" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="ISA 37:23">És 37:23</ref> </char></note>Sila ki Sen an, yon flanm. Li va brile yo e devore pikan li yo ak raje li yo nan yon sèl jou. <verse eid="ISA 10:17"/><verse number="18" style="v" sid="ISA 10:18"/>Epi Li va <note caller="+" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="ISA 10:33-34">És 10:33-34</ref></char></note>detwi glwa a forè ak jaden plen ak fwi li yo, ni nanm, ni kò; epi sa va tankou lè yon nonm malad vin deperi nèt e deseche nèt. <verse eid="ISA 10:18"/><verse number="19" style="v" sid="ISA 10:19"/>Epi <note caller="+" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="ISA 21:17">És 21:17</ref></char></note>rès bwa ki rete nan forè li yo, va vin tèlman piti an kantite, ke yon timoun ta ka konte yo. <verse eid="ISA 10:19"/><verse number="20" style="v" sid="ISA 10:20"/>Alò nan jou sa a, retay Israël la ak sila lakay Jacob ki te chape yo p ap janm depann de sila ki te frape yo, men va anverite <note caller="+" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="2CH 14:11">II Kwo 14:11</ref></char></note>depann de SENYÈ a, Sila ki sen an Israël la. <verse eid="ISA 10:20"/><verse number="21" style="v" sid="ISA 10:21"/>Yon retay va retounen, retay a Jacob la, retounen kote Bondye pwisan an. <verse eid="ISA 10:21"/><verse number="22" style="v" sid="ISA 10:22"/>Paske malgre pèp ou a, O Israël, kapab tankou sab lanmè, sèlman yon retay ladann va retounen. Yon <note caller="+" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="ISA 28:22">És 28:22</ref></char></note>destriksyon, debòde ak ladwati, fèt pou rive. <verse eid="ISA 10:22"/><verse number="23" style="v" sid="ISA 10:23"/>Paske yon destriksyon konplè nan tout latè a dekrete deja, e <note caller="+" style="x"><char style="xo" closed="false">10:23 </char><char style="xt" closed="false"><ref loc="ISA 28:22">És 28:22</ref></char></note>SENYÈ dèzame yo va egzekite li. <verse eid="ISA 10:23"/><verse number="24" style="v" sid="ISA 10:24"/>Pou sa, konsa pale Senyè BONDYE dèzame yo: “O pèp Mwen an, ki rete Sion an, pa pè Assyrie ki <note caller="+" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="EXO 5:14-16">Egz 5:14-16</ref> </char></note>frape nou ak baton an e ki leve baton l kont nou kon Ejipsyen yo te konn fè a. <verse eid="ISA 10:24"/><verse number="25" style="v" sid="ISA 10:25"/>Paske nan <note caller="+" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="ISA 17:4">És 17:4</ref></char></note> yon tan byen kout, kòlè Mwen kont nou va fin pase, e kòlè Mwen va dirije vè destriksyon pa yo.” <verse eid="ISA 10:25"/><verse number="26" style="v" sid="ISA 10:26"/>SENYÈ dèzame yo va leve yon gwo fwèt kont li tankou masak a Madian nan wòch Oreb la. Baton Li va lonje sou lanmè a e Li va leve li wo <note caller="+" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="EXO 14:27">Egz 14:27</ref> </char></note>jan Li te konn fè an Égypte la. <verse eid="ISA 10:26"/><verse number="27" style="v" sid="ISA 10:27"/>Konsa li va rive nan jou sa a, ke <note caller="+" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="ISA 9:4">És 9:4</ref></char></note>chaj Li va leve soti sou do nou, jouk Li sou kou nou, e jouk la va kraze akoz lwil oksonye. <verse eid="ISA 10:27"/><verse number="28" style="v" sid="ISA 10:28"/>Li te vini kont Ajjath, li te pase nan Migron; nan Micmasch, li te depoze <note caller="+" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="JDG 18:21">Jij 18:21</ref> </char></note>bagaj li. <verse eid="ISA 10:28"/><verse number="29" style="v" sid="ISA 10:29"/>Yo te pase nan lakoup lan epi te di: <note caller="+" style="x"><char style="xo" closed="false">10:29 </char><char style="xt" closed="false"><ref loc="JOS 21:17">Jos 21:17</ref> </char></note>“Nan Guéba, nou va fè plas pou nou rete.” Rama nan laperèz nèt e Guibea a Saul la sove ale nèt. <verse eid="ISA 10:29"/><verse number="30" style="v" sid="ISA 10:30"/>Kriye fò ak vwa ou, <note caller="+" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="1SA 25:44">I Sam 25:44</ref></char></note>fi a Gallim nan! Fè atansyon, Laïs ak malere Anathoth! <verse eid="ISA 10:30"/><verse number="31" style="v" sid="ISA 10:31"/>Madména fin sove ale. Abitan Guébim yo fin chache sekou. <verse eid="ISA 10:31"/><verse number="32" style="v" sid="ISA 10:32"/>Men jodi a, li va rete Nob. <note caller="+" style="x"><char style="xo" closed="false">10:32 </char><char style="xt" closed="false"><ref loc="ISA 19:16">És 19:16</ref></char></note> Li souke ponyèt li vè mòn fi a Sion an, kolin a Jérusalem nan. <verse eid="ISA 10:32"/><verse number="33" style="v" sid="ISA 10:33"/>Gade byen, SENYÈ a, BONDYE dèzame yo va koupe tout branch yo ak yon gran bri. Sa osi ki gen <note caller="+" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="ISA 37:24-38">És 37:24-38</ref></char></note>gran tay va koupe nèt e sila a gran wotè yo va vin bese nèt. <verse eid="ISA 10:33"/><verse number="34" style="v" sid="ISA 10:34"/>Li va koupe nèt gwo rakbwa forè a ak yon rach ki fèt an fè, e Liban va tonbe akoz Toupwisan an.<verse eid="ISA 10:34"/></para>
  <chapter eid="ISA 10"/>
  <chapter number="11" style="c" sid="ISA 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 11:1"/>Yon boujon va vòltije soti nan chouk Jessé a</para>
  <para style="q1" vid="ISA 11:1">e yon <note caller="+" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="REV 5:5">Rev 5:5</ref> </char></note>branch ki sòti nan rasin li, va bay anpil fwi.<verse eid="ISA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 11:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:2 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 42:1">És 42:1</ref>
      </char>
    </note>Lespri SENYÈ a va poze sou Li,</para>
  <para style="q1" vid="ISA 11:2">lespri a sajès ak bon konprann,</para>
  <para style="q1" vid="ISA 11:2">lespri a konsèy ak pwisans lan,</para>
  <para style="q1" vid="ISA 11:2">lespri a konesans ak lakrent SENYÈ a.<verse eid="ISA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 11:3"/>Li va pran plezi nan lakrent SENYÈ a.</para>
  <para style="q1" vid="ISA 11:3">Li p ap jije selon sa ke zye l <note caller="+" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="JHN 2:25">Jn 2:25</ref></char></note>wè,</para>
  <para style="q1" vid="ISA 11:3">ni fè yon desizyon pa sa ke zòrèy li tande;<verse eid="ISA 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 11:4"/>men ak <note caller="+" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="ISA 9:7">És 9:7</ref></char></note>ladwati, Li va jije malere yo,</para>
  <para style="q1" vid="ISA 11:4">e pran desizyon ak jistis pou aflije sou latè yo.</para>
  <para style="q1" vid="ISA 11:4">Li va frape tè a ak baton bouch Li,</para>
  <para style="q1" vid="ISA 11:4">e avèk souf lèv Li yo, Li va detwi mechan yo.<verse eid="ISA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 11:5"/>Anplis, ladwati va sentiwon an ki antoure ren Li</para>
  <para style="q1" vid="ISA 11:5">e fidelite va sentiwon ki pase nan senti Li a.<verse eid="ISA 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 11:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:6 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 65:25">És 65:25</ref>
      </char>
    </note>Lou a va demere ak jèn mouton an,</para>
  <para style="q1" vid="ISA 11:6">leyopa va kouche ak jèn kabrit la,</para>
  <para style="q1" vid="ISA 11:6">jèn bèf la ak jèn lyon an ansanm ak bèf gra a;</para>
  <para style="q1" vid="ISA 11:6">epi yon tigason va mennen yo.<verse eid="ISA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 11:7"/>Anplis, vach la ak lous la va manje zèb nan patiraj la;</para>
  <para style="q1" vid="ISA 11:7">pitit pa yo va kouche ansanm e lyon an va manje zèb tankou bèf la.<verse eid="ISA 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 11:8"/>Pitit k ap tete, va jwe bò twou koulèv anpwazone a,</para>
  <para style="q1" vid="ISA 11:8">e pitit sevre a va mete men l sou kav vipè a.<verse eid="ISA 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 11:9"/>Yo p ap donmaje ni detwi nan tout mòn sen Mwen an,</para>
  <para style="q1" vid="ISA 11:9">paske latè va ranpli ak konesans SENYÈ a,</para>
  <para style="q1" vid="ISA 11:9">tankou dlo kouvri lanmè a.<verse eid="ISA 11:9"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10"/>Nan jou sa a, <note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="LUK 2:32">Luc 2:32</ref></char></note>nasyon yo va retounen vè rasin a Jessé a, ki va kanpe tankou yon sinyal pou pèp la. Epi plas repo Li a va ranpli ak laglwa.<verse eid="ISA 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 11:11"/>Li va vin rive nan jou sa a ke SENYÈ a va ranmase yon dezyèm fwa ak men Li, retay a pèp Li a ki rete soti Assyrie <note caller="+" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="ISA 19:21-22">És 19:21-22</ref> </char></note>Égypte, Pathros, Cush, Élam Schinear, ak Hamath ak devan lil lanmè yo. <verse eid="ISA 11:11"/><verse number="12" style="v" sid="ISA 11:12"/>Li va leve yon drapo pou nasyon yo, <note caller="+" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="ISA 56:8">És 56:8</ref></char></note>rasanble egzile Israël yo, e Li va rasanble dispèse Juda ki soti nan kat kwen latè yo. <verse eid="ISA 11:12"/><verse number="13" style="v" sid="ISA 11:13"/><note caller="+" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="ISA 9:21">És 9:21</ref></char></note>Jalouzi Éphraïm nan va fini, e sila ki twouble Juda va koupe retire nèt. Éphraïm p ap jalou a Juda e Juda p ap twouble Éphraïm. <verse eid="ISA 11:13"/><verse number="14" style="v" sid="ISA 11:14"/>Yo va <note caller="+" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="JER 48:40">Jr 48:40</ref></char></note>desann sou pant Filisten yo vè lwès. Ansanm yo va piyaje fis a lès yo. Yo va posede Edom ak Moab e fis a Ammon yo va vin soumèt a yo menm. <verse eid="ISA 11:14"/><verse number="15" style="v" sid="ISA 11:15"/>Konsa, SENYÈ a va detwi lang lanmè Égypte la nèt. Li va pase men L sou <note caller="+" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="ISA 7:20">És 7:20</ref></char></note>rivyè a ak van cho a, e Li va frape divize l an sèt flèv pou fè moun kapab travèse li pye sèk. <verse eid="ISA 11:15"/><verse number="16" style="v" sid="ISA 11:16"/>Va gen yon gran chemen k ap sòti depi Assyrie pou retay a pèp Li, menm jan ki te genyen pou Israël <note caller="+" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="EXO 14:26-29">Egz 14:26-29</ref> </char></note>nan jou ke yo te monte kite peyi Egypte la.<verse eid="ISA 11:16"/></para>
  <chapter eid="ISA 11"/>
  <chapter number="12" style="c" sid="ISA 12"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1"/>Nou va di nan jou sa a: “Mwen va bay remèsiman a Ou menm, O SENYÈ; paske <note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="PSA 30:5">Sòm 30:5</ref></char></note>malgre ou te fache avèk mwen, kòlè Ou vin detounen, e Ou fè m twouve rekonfò. <verse eid="ISA 12:1"/><verse number="2" style="v" sid="ISA 12:2"/>Gade byen, Bondye se delivrans mwen. Mwen va <note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="ISA 26:3">És 26:3</ref> </char></note>fè Li konfyans e mwen pa pè, paske SENYÈ BONDYE a se fòs mwen ak chan mwen; se Sila ki te devni sali mwen an.” <verse eid="ISA 12:2"/><verse number="3" style="v" sid="ISA 12:3"/>Akoz sa, plen ak jwa, nou va <note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="JHN 4:10">Jn 4:10</ref></char></note>rale dlo nan sous sali yo. <verse eid="ISA 12:3"/><verse number="4" style="v" sid="ISA 12:4"/>Konsa, nan jou sa a, nou va di: “Bay remèsiman a SENYÈ a! Rele non Li! <note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="PSA 145:4">Sòm 145:4</ref> </char></note>Fè konnen zèv Li yo pami pèp latè yo! Fè yo sonje ke non Li egzalte! <verse eid="ISA 12:4"/><verse number="5" style="v" sid="ISA 12:5"/><note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="EXO 15:1">Egz 15:1</ref></char></note>Louwe SENYÈ a ak chanson yo, paske Li te fè gwo bagay! Kite sa konnen sou tout latè! <verse eid="ISA 12:5"/><verse number="6" style="v" sid="ISA 12:6"/>Fè kri anlè e rele ak jwa, O nou menm ki rete Sion, paske <note caller="+" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="ISA 1:24">És 1:24</ref></char></note>gran nan mitan nou se Sila Ki Sen an Israël la!”<verse eid="ISA 12:6"/></para>
  <chapter eid="ISA 12"/>
  <chapter number="13" style="c" sid="ISA 13"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1"/>Pwofesi konsènan <note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="ISA 47:1-15">És 47:1-15</ref> </char></note>Babylon ke Ésaïe, fis a Amots la, te wè a.<verse eid="ISA 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 13:2"/>Leve yon drapo sou <note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="JER 51:25">Jr 51:25</ref> </char></note>mòn toutouni an! Leve vwa nou vè yo! Fè sign ak men pou yo ka antre nan pòt a prens yo! <verse eid="ISA 13:2"/><verse number="3" style="v" sid="ISA 13:3"/>Mwen te pase lòd anvè konsakre Mwen yo; menm <note caller="+" style="x"><char style="xo" closed="false">13:3 </char><char style="xt" closed="false"><ref loc="JOL 3:11">Jl 3:11</ref></char></note>gran gèrye Mwen yo. Mwen te rele sila ki rejwi nan pwisans Mwen yo, pou egzekite kòlè Mwen. <verse eid="ISA 13:3"/><verse number="4" style="v" sid="ISA 13:4"/>Yon <note caller="+" style="x"><char style="xo" closed="false">13:4 </char><char style="xt" closed="false"><ref loc="ISA 5:30">És 5:30</ref></char></note>bri a gwo zen sou mòn yo, tankou bri anpil moun! Yon son a gwo bri nan wayòm yo; son a nasyon yo ki vin rasanble ansanm! SENYÈ dèzame yo ap rasanble lame a pou batay. <verse eid="ISA 13:4"/><verse number="5" style="v" sid="ISA 13:5"/>Yo sòti nan yon peyi byen lwen, soti nan ekstremite pi lwen yo, SENYÈ a avèk zouti a gwo kòlè Li yo, pou <note caller="+" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="ISA 24:1">És 24:1</ref> </char></note>detwi tout peyi a.<verse eid="ISA 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 13:6"/>Rele anmwey, paske <note caller="+" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="ISA 2:12">És 2:12</ref></char></note>jou SENYÈ a toupre! Li va rive tankou yon destriksyon k ap sòti nan Toupwisan an. <verse eid="ISA 13:6"/><verse number="7" style="v" sid="ISA 13:7"/>Akoz sa, tout men yo va tonbe san fòs e <note caller="+" style="x"><char style="xo" closed="false">13:7 </char><char style="xt" closed="false"><ref loc="ISA 19:1">És 19:1</ref></char></note>kè a tout moun va fann. <verse eid="ISA 13:7"/><verse number="8" style="v" sid="ISA 13:8"/>Y ap vin pè anpil; doulè ak gwo lapèn va sezi yo nèt. Yo va <note caller="+" style="x"><char style="xo" closed="false">13:8 </char><char style="xt" closed="false"><ref loc="ISA 26:17">És 26:17</ref> </char></note>vire tòde tankou fanm k ap akouche; youn va gade lòt ak sezisman. Figi yo k ap fè flanm dife. <verse eid="ISA 13:8"/><verse number="9" style="v" sid="ISA 13:9"/>Gade byen, <note caller="+" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="ISA 13:6">És 13:6</ref></char></note>jou SENYÈ a ap vini, byen sovaj ak gwo kòlè tèrib; kòlè k ap brile pou fè peyi a dezole! Li va ekstèmine pechè ki sou li yo. <verse eid="ISA 13:9"/><verse number="10" style="v" sid="ISA 13:10"/>Konsa, zetwal syèl yo ak fòmasyon yo p ap bay limyè yo. <note caller="+" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="ISA 24:23">És 24:23</ref> </char></note>Solèy la va nwa lè l leve e lalin nan p ap bay limyè li. <verse eid="ISA 13:10"/><verse number="11" style="v" sid="ISA 13:11"/>Konsa Mwen va pini mond lan pou mechanste li ak <note caller="+" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="ISA 3:11">És 3:11</ref> </char></note>mechan yo pou inikite yo. Mwen va mete fen ak awogans moun ògeye e desann awogans a sila ki san pitye a. <verse eid="ISA 13:11"/><verse number="12" style="v" sid="ISA 13:12"/>Mwen va fè lòm mòtèl la vin <note caller="+" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="ISA 4:1">És 4:1</ref></char></note>pi ra pase lò san tach, e limanite ke lò Ophir. <verse eid="ISA 13:12"/><verse number="13" style="v" sid="ISA 13:13"/>Pou sa, Mwen va fè syèl yo tranble e latè va fin souke jiskaske li kite plas li nan kòlè a SENYÈ dèzame yo nan <note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="LAM 1:12">Lam 1:12</ref> </char></note>jou kòlè Li k ap anflame a. <verse eid="ISA 13:13"/><verse number="14" style="v" sid="ISA 13:14"/>Konsa li va rive ke menm tankou yon antilop k ap chase, oswa <note caller="+" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="1KI 22:17">I Wa 22:17</ref></char></note>mouton san moun pou rasanble yo, yo chak va vire vè pwòp pèp yo, e yo chak va sove ale rive nan pwòp peyi yo. <verse eid="ISA 13:14"/><verse number="15" style="v" sid="ISA 13:15"/>Nenpòt moun yo rankontre, yo va <note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ISA 14:9">És 14:9</ref></char></note>frennen touye nèt, e nenpòt moun ke yo kaptire, va mouri pa nepe. <verse eid="ISA 13:15"/><verse number="16" style="v" sid="ISA 13:16"/><note caller="+" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="PSA 137:8-9">Sòm 137:8-9</ref></char></note>Timoun piti pa yo, anplis, va kraze an mòso devan zye yo. Lakay yo va piyaje e madanm yo va vyole.<verse eid="ISA 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 13:17"/>Gade byen, Mwen va fè Mèdes <note caller="+" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="JER 51:11">Jr 51:11</ref></char></note>leve kont yo; kont sila ki p ap bay ajan valè yo, ni pran plezi nan lò yo. <verse eid="ISA 13:17"/><verse number="18" style="v" sid="ISA 13:18"/>Banza yo va koupe jennonm yo tankou zèb; yo p ap menm gen konpasyon pou fwi zantray la, ni <note caller="+" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="EZR 9:5-10">Esd 9:5-10</ref></char></note>zye yo p ap fè pitye pou timoun. <verse eid="ISA 13:18"/><verse number="19" style="v" sid="ISA 13:19"/>Konsa, Babylon <note caller="+" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DAN 4:30">Dan 4:30</ref> </char></note>bèlte a wayòm yo, glwa ak ògèy a Kaldeyen yo, va tankou lè ke Bondye te boulvèse Sodome ak Gomorrhe a. <verse eid="ISA 13:19"/><verse number="20" style="v" sid="ISA 13:20"/>Li <note caller="+" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="ISA 14:23">És 14:23</ref></char></note>p ap janm abite ankò, ni pèsòn p ap viv ladann soti nan yon jenerasyon a yon lòt. Arab la p ap monte tant li la, ni bèje yo p ap fè twoupo yo kouche la. <verse eid="ISA 13:20"/><verse number="21" style="v" sid="ISA 13:21"/>Men se <note caller="+" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="ISA 34:11-15">És 34:11-15</ref></char></note>bèt sovaj dezè ki va kouche la, e lakay yo va plen jakal. Anplis, otrich va viv la e kabrit mawon k ap vòltije la. <verse eid="ISA 13:21"/><verse number="22" style="v" sid="ISA 13:22"/>Chat mawon va plenyen nan fò ki wo yo, e jakal yo nan bèl <note caller="+" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="ISA 25:2">És 25:2</ref></char></note>palè yo. Move lè pa li a va rive ase vit e jou li yo p ap pwolonje.<verse eid="ISA 13:22"/></para>
  <chapter eid="ISA 13"/>
  <chapter number="14" style="c" sid="ISA 14"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 14:1"/>SENYÈ a va ankò gen konpasyon sou Jacob, pou l chwazi Israël ankò e fè yo rete nan pwòp peyi yo. Etranje yo va vin jwenn ak yo e atache yo menm a kay Jacob la. <verse eid="ISA 14:1"/><verse number="2" style="v" sid="ISA 14:2"/>Yo va mennen yo fè yo vini nan plas yo, e lakay Israël va posede yo nan peyi SENYÈ a, kon sèvant ak sèvitè. Konsa, yo va pran sila ki te pran yo kaptif yo, yo va kaptire yo e vin mèt sou sila ki te oprime yo.<verse eid="ISA 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3"/>Li va rive nan jou lè SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="EZR 9:8-9">Esd 9:8-9</ref></char></note>ba ou repò sou doulè ou, twoub ou ak redi di nan sila ou te vin esklav la, <verse eid="ISA 14:3"/><verse number="4" style="v" sid="ISA 14:4"/>Ke ou va <note caller="+" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="HAG 2:6">Ag 2:6</ref></char></note>pran chante sa a kont wa Babylon nan epi di: “Gade kijan opresè a vin sispann! Gwo twoub la pa la ankò!” <verse eid="ISA 14:4"/><verse number="5" style="v" sid="ISA 14:5"/>SENYÈ a fin kase baton a mechan an, baton a wa yo <verse eid="ISA 14:5"/><verse number="6" style="v" sid="ISA 14:6"/><note caller="+" style="x"><char style="xo" closed="false">14:6 </char><char style="xt" closed="false"><ref loc="ISA 10:14">És 10:14</ref></char></note>ki te konn frape pèp la ak gran kolè, ak kou san rete, ki te soumèt nasyon yo ak gwo kòlè ak gwo pèsekisyon san fren. <verse eid="ISA 14:6"/><verse number="7" style="v" sid="ISA 14:7"/>Tout latè gen repo e rete kalm. Yo <note caller="+" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="PSA 47:1-3">Sòm 47:1-3</ref></char></note>eklate ak chante kè kontan yo. <verse eid="ISA 14:7"/><verse number="8" style="v" sid="ISA 14:8"/>Menm <note caller="+" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="ISA 55:12">És 55:12</ref></char></note>bwa siprè yo rejwi sou ou e bwa sèd Liban yo ap di: “Paske ou te bese ou, pa gen moun ki koupe bwa k ap monte kont nou. <verse eid="ISA 14:8"/><verse number="9" style="v" sid="ISA 14:9"/><note caller="+" style="x"><char style="xo" closed="false">14:9 </char><char style="xt" closed="false"><ref loc="ISA 5:14">És 5:14</ref></char></note>Sejou mò a depi anba, gen kè kontan sou ou, pou l ka rankontre ou lè ou vini. Li leve menm pou ou lespri mò yo, tout chèf sou tout latè yo. Li fè leve tout wa a tout nasyon yo soti nan twòn yo. <verse eid="ISA 14:9"/><verse number="10" style="v" sid="ISA 14:10"/><note caller="+" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="EZK 32:21">Éz 32:21</ref></char></note>Yo tout va reponn epi mande ou: ‘Ou menm, èske ou vin fèb tankou nou? Èske ou vini tankou nou?’ <verse eid="ISA 14:10"/><verse number="11" style="v" sid="ISA 14:11"/>Tout <note caller="+" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="ISA 5:14">És 5:14</ref></char></note>gwo bagay fèt ou ak mizik ap ou yo fin desann rive nan sejou mò yo. Se vè ki fè kabann anba ou e se vè k ap kouvri ou.”<verse eid="ISA 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 14:12"/>Kòman ou te tonbe soti nan syèl la, O <note caller="+" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="2PE 1:19">II Pi 1:19</ref></char></note>zetwal granmmaten an! Ou te koupe ra tè; ou menm ki te detwi tout nasyon yo! <verse eid="ISA 14:12"/><verse number="13" style="v" sid="ISA 14:13"/>Men nan kè ou, ou te di: “Mwen va <note caller="+" style="x"><char style="xo" closed="false">14:13 </char><char style="xt" closed="false"><ref loc="EZK 28:2">Éz 28:2</ref></char></note>monte jis rive nan syèl la! Mwen va fè leve twòn mwen piwo zetwal Bondye yo! Mwen va chita sou mòn asanble a nan fon nò yo! <verse eid="ISA 14:13"/><verse number="14" style="v" sid="ISA 14:14"/>Mwen va monte piwo nwaj yo! Mwen va fè mwen menm tankou Pi Wo a!” <verse eid="ISA 14:14"/><verse number="15" style="v" sid="ISA 14:15"/>Sepandan, ou <note caller="+" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="EZK 28:8">Éz 28:8</ref></char></note>va pouse desann nan Sejou mò yo, kote fon a gwo fòs la ye a. <verse eid="ISA 14:15"/><verse number="16" style="v" sid="ISA 14:16"/>Sila ki wè ou va fikse zye sou ou. Yo va reflechi sou ou pou di: “Èske se nonm sila a ki te fè tè a tranble a, ki te souke wayòm yo? <verse eid="ISA 14:16"/><verse number="17" style="v" sid="ISA 14:17"/>Ki te fè mond lan tankou yon dezè a, ki te boulvèse gwo vil li yo, ki te <note caller="+" style="x"><char style="xo" closed="false">14:17 </char><char style="xt" closed="false"><ref loc="ISA 45:13">És 45:13</ref> </char></note>refize kite prizonye li yo ale lakay yo?”<verse eid="ISA 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 14:18"/>Tout wa sou latè yo kouche nan glwa yo, yo chak nan pwòp tonbo pa yo. <verse eid="ISA 14:18"/><verse number="19" style="v" sid="ISA 14:19"/>Men ou menm, ou te jete deyò tonbo pa ou a, tankou yon branch rejte, abiye ak sila ki te touye yo, ki te pèse ak nepe yo, ki te desann kote wòch a fòs la tankou yon kadav, <note caller="+" style="x"><char style="xo" closed="false">14:19 </char><char style="xt" closed="false"><ref loc="ISA 5:25">És 5:25</ref> </char></note>kraze foule ak pye. <verse eid="ISA 14:19"/><verse number="20" style="v" sid="ISA 14:20"/>Ou p ap reyini ak yo nan antèman, akoz ou te detwi peyi ou a. Ou te touye pèp ou a. Konsa, non <note caller="+" style="x"><char style="xo" closed="false">14:20 </char><char style="xt" closed="false"><ref loc="JOB 18:16-19">Job 18:16-19</ref></char></note>desandan a malfektè sila yo pa p nonmen jis pou tout tan!<verse eid="ISA 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 14:21"/>Prepare pou fis li yo yon kote pou masak, akoz <note caller="+" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="EXO 20:5">Egz 20:5</ref></char></note>inikite a papa yo. Konsa pou yo pa leve pran posesyon latè e ranpli sifas mond lan ak gwo vil. <verse eid="ISA 14:21"/><verse number="22" style="v" sid="ISA 14:22"/>“Mwen va leve kont yo”, deklare SENYÈ dèzame yo. “Mwen va koupe retire yo nèt de non Babylone ak desandan yo de <note caller="+" style="x"><char style="xo" closed="false">14:22 </char><char style="xt" closed="false"><ref loc="JOB 18:19">Job 18:19</ref> </char></note>sila ki fèt ak sila ki gen pou vini yo,” deklare SENYÈ a. <verse eid="ISA 14:22"/><verse number="23" style="v" sid="ISA 14:23"/>“Anplis, M ap fè l tounen yon marekaj pou <note caller="+" style="x"><char style="xo" closed="false">14:23 </char><char style="xt" closed="false"><ref loc="ISA 34:11">És 34:11</ref></char></note>kochon mawon yo. Mwen va bale li ak bale destriksyon an,” deklare SENYÈ dèzame yo.<verse eid="ISA 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24"/>SENYÈ dèzame yo fin sèmante. Li te di: “Anverite, <note caller="+" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="JOB 23:13">Job 23:13</ref></char></note>jan ke Mwen te fè plan an, se konsa li va rive! Jan ke M te planifye a, se konsa l ap kanpe! <verse eid="ISA 14:24"/><verse number="25" style="v" sid="ISA 14:25"/>Pou M kraze Assyrie nan peyi Mwen an e pou M foule li sou mòn Mwen yo. Konsa <note caller="+" style="x"><char style="xo" closed="false">14:25 </char><char style="xt" closed="false"><ref loc="ISA 9:4">És 9:4</ref> </char></note>jouk li va retire sou yo e gwo chaj li va sòti sou zepòl yo. <verse eid="ISA 14:25"/><verse number="26" style="v" sid="ISA 14:26"/>Sa se <note caller="+" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="ISA 23:9">És 23:9</ref></char></note>plan a ki te fòme kont tout tè a. Sa se men ki lonje kont tout nasyon yo. <verse eid="ISA 14:26"/><verse number="27" style="v" sid="ISA 14:27"/>Paske <note caller="+" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="2CH 20:6">II Kwo 20:6</ref></char></note>SENYÈ dèzame yo te fè yon plan e se kilès ki ka anpeche l? Epi pou men lonje pa l la, se kilès ki ka fè l fè bak?”<verse eid="ISA 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28"/>Nan <note caller="+" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="2KI 16:20">II Wa 16:20</ref> </char></note>ane Wa Achaz te mouri an, Pwofesi sa a te fèt:<verse eid="ISA 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ISA 14:29"/>Pa rejwi, O Peyi Filisten yo, nou tout, akoz baton ki te konn frape ou a fin kase. Soti nan rasin sèpan an, yon vipè va vin parèt, k ap fè kon fwi, yon <note caller="+" style="x"><char style="xo" closed="false">14:29 </char><char style="xt" closed="false"><ref loc="ISA 30:6">És 30:6</ref> </char></note>sèpan k ap vole. <verse eid="ISA 14:29"/><verse number="30" style="v" sid="ISA 14:30"/>Premyè nè malere a va manje byen, e endijan an va kouche ansekirite. Mwen va detwi rasin pa ou ak <note caller="+" style="x"><char style="xo" closed="false">14:30 </char><char style="xt" closed="false"><ref loc="ISA 8:21">És 8:21</ref></char></note> gwo grangou, e anplis l ap touye sila ki te chape yo.<verse eid="ISA 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ISA 14:31"/>Rele anmwey, O pòtay la! Kriye fò, O Gran Vil la! Fann nèt, O Filistia, nou tout! Paske lafimen ap sòti nan <note caller="+" style="x"><char style="xo" closed="false">14:31 </char><char style="xt" closed="false"><ref loc="JER 1:14">Jr 1:14</ref></char></note>nò e nanpwen moun k ap fè reta. Lennmi a kwense nou nèt.<verse eid="ISA 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ISA 14:32"/>Alò, kòman yon moun ka reponn <note caller="+" style="x"><char style="xo" closed="false">14:32 </char><char style="xt" closed="false"><ref loc="ISA 37:9">És 37:9</ref></char></note>mesaje a nasyon yo? Ke se SENYÈ a ki te etabli Sion, e aflije a pèp Li yo va chache sekou nan li.<verse eid="ISA 14:32"/></para>
  <chapter eid="ISA 14"/>
  <chapter number="15" style="c" sid="ISA 15"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1"/>Pwofesi konsènan Moab la.</para>
  <para style="p" vid="ISA 15:1">Anverite nan yon sèl nwit, <note caller="+" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="NUM 21:28">Nonb 21:28</ref></char></note>Ar-Moab fin devaste e detwi nèt. Nan yon sè nwit, Kir-Moab fin devaste e detwi nèt. <verse eid="ISA 15:1"/><verse number="2" style="v" sid="ISA 15:2"/>Yo fin monte nan tanp lan ak <note caller="+" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="JER 48:18-22">Jr 48:18-22</ref></char></note>Dibon, menm kote wo plas yo pou kriye. Moab rele anmwey sou Nebo ak Médeba. Razwa fin pase sou tèt tout moun e tout bab fin koupe. <verse eid="ISA 15:2"/><verse number="3" style="v" sid="ISA 15:3"/>Nan lari yo, yo fin abiye ak <note caller="+" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="JON 3:6-8">Jon 3:6-8</ref></char></note>twal sak. Sou twati lakay yo e sou gwo plas yo, tout moun ap rele anmwey e vin fann nèt akoz dlo ki sòti nan zye yo. <verse eid="ISA 15:3"/><verse number="4" style="v" sid="ISA 15:4"/>Anplis, <note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="NUM 21:28">Nonb 21:28</ref></char></note>Hesbon ak Élealé rele anmwey; vwa yo konn tande jis rive Jahats. Akoz sa, tout mesye ak zam yo kriye fò; nanm yo tranble anndan. <verse eid="ISA 15:4"/><verse number="5" style="v" sid="ISA 15:5"/>Kè m kriye fò pou Moab! Prens li yo sove ale rive jis Tsoar yo, jis Églath-Schelischija yo. Yo monte pant Luchith la pandan y ap kriye nèt; anverite, menm sou wout pou rive Choronaïm nan, y ap leve yon kri anmwey <note caller="+" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="ISA 59:7">És 59:7</ref> </char></note>pou destriksyon yo. <verse eid="ISA 15:5"/><verse number="6" style="v" sid="ISA 15:6"/>Paske dlo a Nimrin yo abandone. Anverite, zèb la fennen nèt; menm boujon gazon mouri. <note caller="+" style="x"><char style="xo" closed="false">15:6 </char><char style="xt" closed="false"><ref loc="JOL 1:10-12">Jl 1:10-12</ref></char></note>Pa gen anyen ki vèt. <verse eid="ISA 15:6"/><verse number="7" style="v" sid="ISA 15:7"/>Pou sa, <note caller="+" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ISA 30:6">És 30:6</ref></char></note>gwo kantite byen ke yo vin genyen pou mete nan depo, yo pote yo ale sou flèv dlo Arabim nan. <verse eid="ISA 15:7"/><verse number="8" style="v" sid="ISA 15:8"/>Paske kri anmwey la fin kouri ale antoure peyi Moab la. Plenyen li an rive jis Egalïm, e lamantasyon li an jis Beer-Élim. <verse eid="ISA 15:8"/><verse number="9" style="v" sid="ISA 15:9"/>Paske dlo a Dimon yo plen ak san. Anverite Mwen va ogmante mizè sou Dimon, ak yon <note caller="+" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="2KI 17:25">II Wa 17:25</ref></char></note>lyon sou sila yo k ap sove ale Moab, menm ankò sou retay yo nan peyi a.<verse eid="ISA 15:9"/></para>
  <chapter eid="ISA 15"/>
  <chapter number="16" style="c" sid="ISA 16"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 16:1"/>Voye mouton tribi a bay gouvènè peyi a, soti nan Sela pa wout dezè a, jis rive nan mòn a fi Sion an. <verse eid="ISA 16:1"/><verse number="2" style="v" sid="ISA 16:2"/>Li va rive ke tankou <note caller="+" style="x"><char style="xo" closed="false">16:2 </char><char style="xt" closed="false"><ref loc="PRO 27:8">Pwov 27:8</ref></char></note>zwazo k ap sove ale, oswa k ap gaye sòti nan nich yo, fi Moab yo va parèt kote pou janbe Arnon an. <verse eid="ISA 16:2"/><verse number="3" style="v" sid="ISA 16:3"/>“Bannou konsèy! Fè yon desizyon! Voye lonbraj ou tankou lannwit nan gran lajounen! <note caller="+" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="1KI 18:4">I Wa 18:4</ref></char></note>Kache sila ki san abri yo! Pa trayi refijye a! <verse eid="ISA 16:3"/><verse number="4" style="v" sid="ISA 16:4"/>Kite refijye Moab yo rete avè w! Devni yon kote pou yo kache kont destriktè a.” Paske <note caller="+" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="ISA 9:4">És 9:4</ref></char></note>opresè yo p ap reyisi. Destriksyon an va sispann. Opresè ap disparèt nèt nan peyi a. <verse eid="ISA 16:4"/><verse number="5" style="v" sid="ISA 16:5"/>Yon twòn va etabli avèk lanmou dous, e yon jij va chita ak fidelite sou li nan tant <note caller="+" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="ISA 9:7">És 9:7</ref> </char></note>David la. Li va chache jistis e va fè vit pou etabli ladwati.<verse eid="ISA 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 16:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:6 </char>
      <char style="xt" closed="false">
        <ref loc="JER 48:29">Jr 48:29</ref>
      </char>
    </note>Nou konn tande afè ògèy Moab la, yon ògèy ki depase; afè awogans li an, ògèy li a, ak gwo kòlè li a. Pawòl anfle ògèy li pa anyen. <verse eid="ISA 16:6"/><verse number="7" style="v" sid="ISA 16:7"/>Pou sa, Moab va rele anmwey; tout sila nan Moab yo va plenyen anlè. Ou va plenyen pou <note caller="+" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="1CH 16:3">I Kwo 16:3</ref></char></note>gato rezen a Kir-Haréseth kon sila konplètman frape yo. <verse eid="ISA 16:7"/><verse number="8" style="v" sid="ISA 16:8"/>Paske chan a Hesbon yo te fennen, ansanm ak chan rezen a <note caller="+" style="x"><char style="xo" closed="false">16:8 </char><char style="xt" closed="false"><ref loc="NUM 32:38">Nonb 32:38</ref></char></note>Sibma yo. Mèt nasyon yo te kraze gwo grap ki te pi chwazi li yo, ki te rive jis Jaezer e te lonje kote dezè yo. Branch li yo te gaye nèt e te menm pase lòtbò lanmè a. <verse eid="ISA 16:8"/><verse number="9" style="v" sid="ISA 16:9"/>Pou sa, Mwen va <note caller="+" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="JER 48:32">Jr 48:32</ref></char></note>kriye byen fò pou Jaezer, pou chan Sibma a. Mwen va tranpe nou nèt ak dlo k ap sòti nan zye m, O Hesbon ak Élealé, paske sou fwi gran sezon nou yo ak rekòlt nou yo gen gwo lagè. <verse eid="ISA 16:9"/><verse number="10" style="v" sid="ISA 16:10"/><note caller="+" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="ISA 24:8">És 24:8</ref></char></note>Kè kontan ak lajwa sou chan fètil la ale. Nan chan rezen yo tou, p ap genyen chante a, ni gwo kri egzaltasyon yo, ni ouvriye k ap foule diven anba pye li nan peze yo. Mwen te fè kriye sa yo sispann. <verse eid="ISA 16:10"/><verse number="11" style="v" sid="ISA 16:11"/>Pou sa, <note caller="+" style="x"><char style="xo" closed="false">16:11 </char><char style="xt" closed="false"><ref loc="ISA 24:8">És 24:8</ref></char></note>kè mwen sone tankou ap pou Moab ak santiman anndan mwen pou Kir-Haréseth. <verse eid="ISA 16:11"/><verse number="12" style="v" sid="ISA 16:12"/>Konsa, li va rive ke lè Moab prezante tèt li, lè l fin fatige kò l sou <note caller="+" style="x"><char style="xo" closed="false">16:12 </char><char style="xt" closed="false"><ref loc="ISA 15:2">És 15:2</ref> </char></note>wo plas li e rive nan sanktiyè li a pou fè lapriyè, li p ap reyisi.<verse eid="ISA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13"/>Se pawòl sa a ke SENYÈ a te pale avan sa sou Moab. <verse eid="ISA 16:13"/><verse number="14" style="v" sid="ISA 16:14"/>Men koulye a, SENYÈ a pale e di: “Avan twazan fin rive, jan yon <note caller="+" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="JOB 7:1">Job 7:1</ref></char></note>anplwaye ta konte yo, glwa a Moab la va vin degrade ansanm ak tout gwo kantite pèp li a, e retay li va vin piti e san fòs.”<verse eid="ISA 16:14"/></para>
  <chapter eid="ISA 16"/>
  <chapter number="17" style="c" sid="ISA 17"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1"/>Pwofesi sou Damas.</para>
  <para style="p" vid="ISA 17:1">“Gade byen, Damas prèt pou retire nèt kon vil. Li va tonbe nèt an yon <note caller="+" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="ISA 25:2">És 25:2</ref> </char></note>gwo pil mazi. <verse eid="ISA 17:1"/><verse number="2" style="v" sid="ISA 17:2"/>Vil <note caller="+" style="x"><char style="xo" closed="false">17:2 </char><char style="xt" closed="false"><ref loc="NUM 32:34">Nonb 32:34</ref></char></note>Aroër yo ap abandone nèt. Y ap sèvi kon plas pou twoupo yo kouche. P ap gen pèsòn pou fè yo pè. <verse eid="ISA 17:2"/><verse number="3" style="v" sid="ISA 17:3"/><note caller="+" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="ISA 7:8-16">És 7:8-16</ref></char></note>Vil fòtifye a va disparèt nan Éphraïm e wa Damas la ak retay Syrie. Yo va tankou laglwa a fis Israël yo,” deklare SENYÈ dèzame yo.<verse eid="ISA 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 17:4"/>Alò, nan jou sa a, <note caller="+" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="ISA 10:3">És 10:3</ref></char></note>glwa Jacob la va febli nèt, e grès chè li va vin megri. <verse eid="ISA 17:4"/><verse number="5" style="v" sid="ISA 17:5"/>Li va tankou lè mwasonè sereyal la ap ranmase; lè bra li ap rekòlte tèt sereyal yo. Wi, tankou yon moun k ap ranmase tèt sereyal nan <note caller="+" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="2SA 5:18-22">II Sam 5:18-22</ref></char></note>vale Rephaïm yo. <verse eid="ISA 17:5"/><verse number="6" style="v" sid="ISA 17:6"/>Sepandan, <note caller="+" style="x"><char style="xo" closed="false">17:6 </char><char style="xt" closed="false"><ref loc="DEU 4:27">Det 4:27</ref></char></note>kèk nan mwason an va rete tankou lè yo rekòlte bwa doliv. Y ap jwenn de oswa twa grenn sou branch piwo a, kat oswa senk nan bwa ki donnen pi byen yo, deklare SENYÈ a, Bondye Israël la. <verse eid="ISA 17:6"/><verse number="7" style="v" sid="ISA 17:7"/>Nan jou sa a, lòm va <note caller="+" style="x"><char style="xo" closed="false">17:7 </char><char style="xt" closed="false"><ref loc="ISA 10:20">És 10:20</ref></char></note>gen respè pou Kreyatè li a e zye li va gade vè Sila Ki Sen An Israël la. <verse eid="ISA 17:7"/><verse number="8" style="v" sid="ISA 17:8"/>Yo p ap gade vè lotèl yo, zèv a men li yo, ni yo p ap okipe sa ke dwèt yo te fè; ni <note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="EXO 34:13">Egz 34:13</ref> </char></note>Asherim yo ni lanp lansan yo. <verse eid="ISA 17:8"/><verse number="9" style="v" sid="ISA 17:9"/>Nan jou sa a, vil ranfòse yo va tankou kote abandone nan forè a; tankou branch ke yo te abandone devan fis Israël yo. Konsa, tè a va dezole. <verse eid="ISA 17:9"/><verse number="10" style="v" sid="ISA 17:10"/>Paske nou te bliye <note caller="+" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="PSA 68:19">Sòm 68:19</ref> </char></note>Bondye a sali nou an, ni nou pa t sonje wòch ki se sekou nou an. Pou sa, nou plante bèl plant e plase yo pami boujon chan a dye etranje yo. <verse eid="ISA 17:10"/><verse number="11" style="v" sid="ISA 17:11"/>Nan jou ke nou plante l la, nou fè bèl kloti pou li. Nan <note caller="+" style="x"><char style="xo" closed="false">17:11 </char><char style="xt" closed="false"><ref loc="PSA 90:6">Sòm 90:6</ref></char></note>maten, nou fè jèm nan rive fè flè; men rekòlt la ap sove ale nan jou gwo maladi, nan jou doulè san rete a.<verse eid="ISA 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 17:12"/>Sepandan, gwo zen a anpil nasyon <note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="ISA 5:30">És 5:30</ref></char></note>ki gwonde tankou anpil dlo yo, e ki fè bri a anpil nasyon k ap kouri desann tankou gwo dlo pwisan! <verse eid="ISA 17:12"/><verse number="13" style="v" sid="ISA 17:13"/><note caller="+" style="x"><char style="xo" closed="false">17:13 </char><char style="xt" closed="false"><ref loc="ISA 33:3">És 33:3</ref></char></note>Nasyon yo fè gwo bri desann tankou gwonde a anpil dlo, men Li va repwoche yo e yo va kouri rive byen lwen, yo va chase tankou pay sou mòn devan van, oswa toubiyon van an fè avan gwo tanpèt. <verse eid="ISA 17:13"/><verse number="14" style="v" sid="ISA 17:14"/>Nan aswè, gade, gwo laperèz! Avan maten, yo <note caller="+" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="2KI 19:35">II Wa 19:35</ref></char></note>disparèt nèt. Se konsa pòsyon a sila k ap ranmase byen nou yo e tiraj osò a sila ki piyaje nou yo.<verse eid="ISA 17:14"/></para>
  <chapter eid="ISA 17"/>
  <chapter number="18" style="c" sid="ISA 18"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 18:1"/>Elas! O peyi a zèl k ap fè gwo bri krikèt volan yo, ki rete lòtbò rivyè a <note caller="+" style="x"><char style="xo" closed="false">18:1 </char><char style="xt" closed="false"><ref loc="2KI 19:19">II Wa 19:19</ref></char></note>Ethiopie yo. <verse eid="ISA 18:1"/><verse number="2" style="v" sid="ISA 18:2"/>Nou voye reprezantan yo bò lanmè a, menm sou veso fèt ak fèy papiris ki kouri sou sifas dlo. Ale, mesaje rapid yo, vè yon nasyon <note caller="+" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="ISA 18:7">És 18:7</ref> </char></note>wo e swa, vè yon pèp ke tout moun pè, ni sa ki pre ni sa ki lwen, vè yon nasyon pwisan ki oprime tout moun, peyi ke rivyè yo divize a! <verse eid="ISA 18:2"/><verse number="3" style="v" sid="ISA 18:3"/>Nou tout, abitan mond lan ak sila ki rete sou latè yo, depi drapo a leve sou mòn yo, <note caller="+" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="ISA 26:11">És 26:11</ref></char></note>nou va wè l, e depi twonpèt la sone, n ap tande l.<verse eid="ISA 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 18:4"/>Paske se konsa SENYÈ a te pale mwen: “Mwen va gade soti nan <note caller="+" style="x"><char style="xo" closed="false">18:4 </char><char style="xt" closed="false"><ref loc="ISA 26:21">És 26:21</ref></char></note>kote ke M rete byen kalm la. Mwen va tankou gwo chalè nan plen solèy, tankou yon nwaj lawouze nan chalè rekòlt la.” <verse eid="ISA 18:4"/><verse number="5" style="v" sid="ISA 18:5"/>Paske <note caller="+" style="x"><char style="xo" closed="false">18:5 </char><char style="xt" closed="false"><ref loc="ISA 17:10-11">És 17:10-11</ref></char></note>avan rekòlt la, la menm boujon yo ak flè a devni rezen ki mi; alò, Li va koupe retire nan bwa rezen ak yon sèpèt. Li va koupe retire branch k ap gaye yo. <verse eid="ISA 18:5"/><verse number="6" style="v" sid="ISA 18:6"/>Yo va lese atè ansanm pou <note caller="+" style="x"><char style="xo" closed="false">18:6 </char><char style="xt" closed="false"><ref loc="ISA 46:11">És 46:11</ref></char></note>zwazo mòn ki manje chè yo; pou bèt latè yo. Zwazo ki manje chè yo va pase tout gran sezon an nan manje yo, e tout bèt latè yo va manje yo nan sezon livè. <verse eid="ISA 18:6"/><verse number="7" style="v" sid="ISA 18:7"/>Nan lè sa a, yon kado omaj ki sòti nan yon <note caller="+" style="x"><char style="xo" closed="false">18:7 </char><char style="xt" closed="false"><ref loc="PSA 68:31">Sòm 68:31</ref></char></note>pèp wo e swa va pote bay SENYÈ dèzame yo. Li va soti menm nan yon pèp ki inspire lakrent a sila ki pre, ak sila ki lwen yo; yon nasyon pwisan ki fè kalkil, ki oprime tout moun, yon peyi ke rivyè yo divize a. L ap rive nan plas ki pote non SENYÈ dèzame yo, menm Mòn Sion an.<verse eid="ISA 18:7"/></para>
  <chapter eid="ISA 18"/>
  <chapter number="19" style="c" sid="ISA 19"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1"/>Pwofesi konsènan Égypte la.</para>
  <para style="p" vid="ISA 19:1">“Gade byen, SENYÈ a monte sou yon nwaj rapid pou L rive Égypte. Zidòl Égypte yo va tranble nan prezans Li; <note caller="+" style="x"><char style="xo" closed="false">19:1 </char><char style="xt" closed="false"><ref loc="JOS 2:11">Jos 2:11</ref> </char></note>kè Ejipsyen yo va fann anndan yo. <verse eid="ISA 19:1"/><verse number="2" style="v" sid="ISA 19:2"/>Pou sa, Mwen va eksite Ejipsyen vin kont Ejipsyen. Yo <note caller="+" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="JDG 7:22">Jij 7:22</ref></char></note>chak va goumen kont frè pa yo, e yo chak kont vwazen yo; vil kont vil e wayòm kont wayòm. <verse eid="ISA 19:2"/><verse number="3" style="v" sid="ISA 19:3"/>Konsa, lespri a Ejipsyen yo va vin twouble anndan yo, e Mwen va boulvèse tout plan yo. Konsa, <note caller="+" style="x"><char style="xo" closed="false">19:3 </char><char style="xt" closed="false"><ref loc="1CH 10:13">I Kwo 10:13</ref></char></note>yo va vire kote zidòl, fantom a mò yo, sila ki pale ak mò yo ak divinò yo. <verse eid="ISA 19:3"/><verse number="4" style="v" sid="ISA 19:4"/>Anplis, Mwen va livre Ejipsyen yo nan men a yon <note caller="+" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="ISA 20:4">És 20:4</ref></char></note>mèt mechan. Yon gran wa pwisan va gouvène sou yo,” deklare Senyè BONDYE dèzame yo.<verse eid="ISA 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 19:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 50:2">És 50:2</ref>
      </char>
    </note>Dlo lanmè yo va vin sèch e rivyè a va vin sèch san dlo. <verse eid="ISA 19:5"/><verse number="6" style="v" sid="ISA 19:6"/>Kanal yo va lage yon movèz odè. Rivyè Égypte yo va vin sèch e san dlo. <note caller="+" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="JOB 8:11">Job 8:11</ref> </char></note>Wozo ak zèb dlo yo va rete pouri. <verse eid="ISA 19:6"/><verse number="7" style="v" sid="ISA 19:7"/>Gwo wozo a bò Rivyè <note caller="+" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="ISA 23:3-10">És 23:3-10</ref></char></note>Nil la, arebò Nil la ak tout chan ki fin plante akote Nil la va vin sèch, pouse ale, e p ap gen la ankò. <verse eid="ISA 19:7"/><verse number="8" style="v" sid="ISA 19:8"/><note caller="+" style="x"><char style="xo" closed="false">19:8 </char><char style="xt" closed="false"><ref loc="EZK 47:10">Éz 47:10</ref></char></note>Moun lapèch yo va plenyen; tout sila ki konn voye yon liy nan Nil la va lamante, e sila ki ouvri filè sou dlo yo va santi gwo pèt. <verse eid="ISA 19:8"/><verse number="9" style="v" sid="ISA 19:9"/>Anplis, sila k ap pwodwi twal len nan ki fèt ak len swa ak bòs <note caller="+" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="PRO 7:16">Pwov 7:16</ref></char></note>twal blan yo va tris nèt. <verse eid="ISA 19:9"/><verse number="10" style="v" sid="ISA 19:10"/><note caller="+" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="PSA 11:3">Sòm 11:3</ref></char></note>Pilye a Égypte yo va kraze nèt; tout anplwaye yo va afilje nan nanm yo.<verse eid="ISA 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 19:11"/>Prens a <note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="NUM 13:22">Nonb 13:22</ref></char></note>Tsoan yo pa plis ke moun fou. Konseye a pi saj Farawon yo vin bèt nèt. Kòman nou menm, mesye, nou ka di Farawon: “Mwen se fis a moun saj yo, fis a wa ansyen yo”? <verse eid="ISA 19:11"/><verse number="12" style="v" sid="ISA 19:12"/>Eh byen, kote moun saj ou yo? Souple, kite yo pale ak ou, e kite yo konprann sa ke SENYÈ dèzame yo te <note caller="+" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="ISA 14:24">És 14:24</ref></char></note> planifye pou fè kont Égypte. <verse eid="ISA 19:12"/><verse number="13" style="v" sid="ISA 19:13"/>Prens a Tsoan yo te aji nan foli. Prens a <note caller="+" style="x"><char style="xo" closed="false">19:13 </char><char style="xt" closed="false"><ref loc="JER 2:16">Jr 2:16</ref></char></note>Noph yo te byen tronpe. Sila ki ta ang prensipal a pèp li a fin mennen Égypte nan wout egare. <verse eid="ISA 19:13"/><verse number="14" style="v" sid="ISA 19:14"/>SENYÈ a te mele nan li yon lespri ki fè l toudi; <note caller="+" style="x"><char style="xo" closed="false">19:14 </char><char style="xt" closed="false"><ref loc="ISA 3:12">És 3:12</ref> </char></note>yo mennen Égypte nan wout egare nan tout sa li fè, tankou moun sou k ap glise tonbe nan vomisman li. <verse eid="ISA 19:14"/><verse number="15" style="v" sid="ISA 19:15"/>P ap gen travay pou Égypte; <note caller="+" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="ISA 9:14-15">És 9:14-15</ref></char></note>ni pou tèt li, ni pou ke li, branch palmis li, oswa sa ke wozo li yo ka fè. <verse eid="ISA 19:15"/><verse number="16" style="v" sid="ISA 19:16"/>Nan jou sa a, Ejipsyen yo va vin tankou fanm. Yo va tranble nan gwo laperèz akoz <note caller="+" style="x"><char style="xo" closed="false">19:16 </char><char style="xt" closed="false"><ref loc="ISA 11:15">És 11:15</ref></char></note>pase men ke SENYÈ a ap fè pase sou yo. <verse eid="ISA 19:16"/><verse number="17" style="v" sid="ISA 19:17"/>Peyi Juda va devni yon gwo laperèz pou Égypte. Tout moun ki tande non li va gen gwo lakrent li akoz volonte a SENYÈ dèzame yo, ki poze kont yo. <verse eid="ISA 19:17"/><verse number="18" style="v" sid="ISA 19:18"/>Nan jou sa a, senk gwo vil peyi Égypte yo va pale langaj a Kanaraneyen yo, e yo va <note caller="+" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="ISA 45:23">És 45:23</ref></char></note>sèmante alyans ak SENYÈ dèzame yo. Youn nan yo va rele Vil Destriksyon an.<verse eid="ISA 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19"/>Nan jou sa a, va gen yon <note caller="+" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="ISA 56:7">És 56:7</ref></char></note>lotèl a SENYÈ a nan mitan peyi Égypte la, e yon pilye a SENYÈ a toupre fwontyè li a. <verse eid="ISA 19:19"/><verse number="20" style="v" sid="ISA 19:20"/>Li va vin fè yon sign ak yon temwen a SENYÈ dèzame yo nan peyi Égypte; paske yo va kriye a SENYÈ a akoz sila k ap oprime moun yo, e Li va voye ba yo yon <note caller="+" style="x"><char style="xo" closed="false">19:20 </char><char style="xt" closed="false"><ref loc="ISA 43:3">És 43:3</ref></char></note>sovè, yon defansè e Li va delivre yo. <verse eid="ISA 19:20"/><verse number="21" style="v" sid="ISA 19:21"/>Konsa SENYÈ a va fè Égypte konnen Li. Konsa, Ejipsyen yo va konnen SENYÈ a nan jou sa a. Yo va anplis adore Li avèk <note caller="+" style="x"><char style="xo" closed="false">19:21 </char><char style="xt" closed="false"><ref loc="ISA 56:7">És 56:7</ref></char></note>sakrifis ak ofrann. Yo va fè yon ve a SENYÈ a, epi yo va akonpli li. <verse eid="ISA 19:21"/><verse number="22" style="v" sid="ISA 19:22"/>SENYÈ a va frape Égypte; frape, men <note caller="+" style="x"><char style="xo" closed="false">19:22 </char><char style="xt" closed="false"><ref loc="DEU 32:39">Det 32:39</ref></char></note>geri li. Yo va retounen kote SENYÈ, epi Li va reponn yo e geri yo.<verse eid="ISA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23"/>Nan jou sa a, va gen yon gran chemen soti an Égypte pou rive Assyrie. Asiryen yo va antre an Égypte, e Ejipsyen yo an Assyrie. Ejipsyen ak Asiryen yo va <note caller="+" style="x"><char style="xo" closed="false">19:23 </char><char style="xt" closed="false"><ref loc="ISA 27:13">És 27:13</ref> </char></note>adore ansanm.<verse eid="ISA 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 19:24"/>Nan jou sa a, Israël va fè yon twazyèm nan, ansanm ak Égypte ak Assyrie, yon gran benediksyon nan mitan mond lan. <verse eid="ISA 19:24"/><verse number="25" style="v" sid="ISA 19:25"/>Paske SENYÈ dèzame yo ap beni yo e di: “Beni se <note caller="+" style="x"><char style="xo" closed="false">19:25 </char><char style="xt" closed="false"><ref loc="ISA 45:14">És 45:14</ref></char></note>Égypte, pèp Mwen an e Assyrie, zèv men Mwen an, ak Israël, eritaj Mwen an.”<verse eid="ISA 19:25"/></para>
  <chapter eid="ISA 19"/>
  <chapter number="20" style="c" sid="ISA 20"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1"/>Nan ane ke kòmandan Asiryen an te vini <note caller="+" style="x"><char style="xo" closed="false">20:1 </char><char style="xt" closed="false"><ref loc="1SA 5:1">I Sam 5:1</ref></char></note>Asdod la, lè Sargon, wa Assyrie a, te voye li goumen kont Asdod la pou te pran li, <verse eid="ISA 20:1"/><verse number="2" style="v" sid="ISA 20:2"/>nan lè ke SENYÈ a te pale pa Ésaïe, fis a Amots la, epi te di: “Ale retire <note caller="+" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="ZEC 13:4">Za 13:4</ref></char></note>twal sak la sou kwis ou e retire soulye nan pye ou.” Se konsa li te fè, epi li te ale toutouni, epi pye a tè. <verse eid="ISA 20:2"/><verse number="3" style="v" sid="ISA 20:3"/>Konsa, SENYÈ a te di: “Menm jan tankou sèvitè Mwen an, Ésaïe, te ale toutouni e pye atè pandan twazan kon yon <note caller="+" style="x"><char style="xo" closed="false">20:3 </char><char style="xt" closed="false"><ref loc="ISA 8:18">És 8:18</ref></char></note>sign nan, e kon yon avètisman kont Égypte ak Éthiopie, <verse eid="ISA 20:3"/><verse number="4" style="v" sid="ISA 20:4"/>menm jan, wa a Assyrie va mennen fè sòti kaptif Ejipsyen yo ansanm ak egzile Éthiopie yo <note caller="+" style="x"><char style="xo" closed="false">20:4 </char><char style="xt" closed="false"><ref loc="ISA 47:2-3">És 47:2-3</ref> </char></note>jenn kon vye, toutouni, e pye atè ak tout do yo dekouvri, pou fè Égypte vin wont. <verse eid="ISA 20:4"/><verse number="5" style="v" sid="ISA 20:5"/>Epi yo va vin dezole e wont akoz Éthiopie, ki te espwa yo, e anplis ak Égypte, fyète yo a. <verse eid="ISA 20:5"/><verse number="6" style="v" sid="ISA 20:6"/>Pou sa, moun ki rete nan peyi bò lanmè sa a, va di nan jou sa a: ‘Gade byen, se konsa espwa nou vin rive! Gade kote nou te kouri ale pou sekou, pou delivre anba men wa a Assyrie a! Epi koulye a, nou menm, <note caller="+" style="x"><char style="xo" closed="false">20:6 </char><char style="xt" closed="false"><ref loc="MAT 23:33">Mat 23:33</ref></char></note>se kòman nou va chape?’”<verse eid="ISA 20:6"/></para>
  <chapter eid="ISA 20"/>
  <chapter number="21" style="c" sid="ISA 21"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1"/>Pwofesi konsènan dezè lanmè a.</para>
  <para style="p" vid="ISA 21:1">Kon tanpèt van nan dezè a kontinye ravaje, sa sòti nan dezè a, de yon peyi etonnan. <verse eid="ISA 21:1"/><verse number="2" style="v" sid="ISA 21:2"/>Yon vizyon tèlman rèd devwale devan m. <note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="ISA 24:16">És 24:16</ref> </char></note>Moun nan ki trèt la, fè trèt toujou, e sila k ap detwi a, detwi toujou. Monte Élam, fè syèj! Mwen te fè tout plenyen Médie sispann. <verse eid="ISA 21:2"/><verse number="3" style="v" sid="ISA 21:3"/>Pou rezon sa a, <note caller="+" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="ISA 13:8">És 13:8</ref> </char></note>kwis mwen plen doulè. Gwo lapèn sezi mwen tankou doulè a fanm ansent. Mwen tèlman twouble ke m pa ka tande. Mwen tèlman pè ke m pa ka wè. <verse eid="ISA 21:3"/><verse number="4" style="v" sid="ISA 21:4"/>Panse mwen ap vire tounen. Gwo efryans plen tèt mwen. Ti limyè aswè a ke m te anvi wè a, koulye a vin <note caller="+" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="DEU 28:67">Det 28:67</ref></char></note>fè m tranble. <verse eid="ISA 21:4"/><verse number="5" style="v" sid="ISA 21:5"/>Yo <note caller="+" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="JER 51:39-57">Jr 51:39-57</ref></char></note>prepare tab la, yo plase watchman nan, yo manje, yo bwè. Leve, o kapitèn yo, mete lwil sou boukliye yo! <verse eid="ISA 21:5"/><verse number="6" style="v" sid="ISA 21:6"/>Paske konsa SENYÈ a pale avèk mwen: “Ale pozisyone gadyen an; kite li <note caller="+" style="x"><char style="xo" closed="false">21:6 </char><char style="xt" closed="false"><ref loc="2KI 9:17-20">II Wa 9:17-20</ref></char></note>bay rapò a sa li wè a. <verse eid="ISA 21:6"/><verse number="7" style="v" sid="ISA 21:7"/>Lè l wè sila ki <note caller="+" style="x"><char style="xo" closed="false">21:7 </char><char style="xt" closed="false"><ref loc="ISA 21:9">És 21:9</ref></char></note>monte cheval yo, chevalye aliye pa de yo, yon lign bourik yo, yon lign chamo yo, kite li veye ak atansyon, veye byen pre.” <verse eid="ISA 21:7"/><verse number="8" style="v" sid="ISA 21:8"/>Gadyen nan rele kon yon lyon: <note caller="+" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="HAG 2:1">Ag 2:1</ref></char></note>“O SENYÈ, mwen kanpe tout jou yo san deplase sou wo tou la! Nan lanwit sou pòs gad la! <verse eid="ISA 21:8"/><verse number="9" style="v" sid="ISA 21:9"/>Atansyon! Veye byen! Men yon ekip moun monte, chevalye alinye pa de yo ap vini.” Li te reponn: “Tonbe, Babylone fin tonbe! Tout <note caller="+" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="ISA 46:1">És 46:1</ref> </char></note>imaj a dye li yo kraze atè.”<verse eid="ISA 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 21:10"/>O <note caller="+" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="JER 51:33">Jr 51:33</ref></char></note>moun pa m ke yo fin bat nèt kon sereyal! Sa ke m te tande soti nan SENYÈ dèzame yo, Bondye Israël la, sa mwen fè nou konnen. <verse eid="ISA 21:10"/><verse number="11" style="v" sid="ISA 21:11"/>Pwofesi konsènan Edom an.</para>
  <para style="p" vid="ISA 21:11">Gen yon moun ki toujou ap rele m depi nan <note caller="+" style="x"><char style="xo" closed="false">21:11 </char><char style="xt" closed="false"><ref loc="GEN 32:3">Jen 32:3</ref></char></note>Séir: “Gadyen, kijan nwit lan ap avanse? Gadyen, kijan nwit lan ap avanse?” <verse eid="ISA 21:11"/><verse number="12" style="v" sid="ISA 21:12"/>Gadyen an reponn: “Maten an vin pwoche; men osi anplis, nwit lan. Si ou ta vle fè ankèt, fè ankèt. Retounen ankò.”<verse eid="ISA 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13"/>Pwofesi konsènan Arabie a.</para>
  <para style="p" vid="ISA 21:13">Fòk nou pase nwit lan nan rakbwa pikan Arabie yo, O karavàn a <note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="GEN 10:7">Jen 10:7</ref> </char></note>Dedan yo. <verse eid="ISA 21:13"/><verse number="14" style="v" sid="ISA 21:14"/>Pote dlo pou moun swaf yo, O moun ki rete nan peyi <note caller="+" style="x"><char style="xo" closed="false">21:14 </char><char style="xt" closed="false"><ref loc="GEN 25:15">Jen 25:15</ref></char></note>Théma yo; rankontre ak sila k ap sove ale ak pen an. <verse eid="ISA 21:14"/><verse number="15" style="v" sid="ISA 21:15"/>Paske yo te <note caller="+" style="x"><char style="xo" closed="false">21:15 </char><char style="xt" closed="false"><ref loc="ISA 13:14-15">És 13:14-15</ref></char></note>sove ale chape devan nepe yo, devan nepe ki rale yo, banza ki koube a ak presyon batay la. <verse eid="ISA 21:15"/><verse number="16" style="v" sid="ISA 21:16"/>Paske konsa SENYÈ a te di mwen: “Nan yon ane, jan yon anplwaye ta kab konwole li, tout grandè a <note caller="+" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 120:5">Sòm 120:5</ref> </char></note>Kédar va fini; <verse eid="ISA 21:16"/><verse number="17" style="v" sid="ISA 21:17"/>epi <note caller="+" style="x"><char style="xo" closed="false">21:17 </char><char style="xt" closed="false"><ref loc="ISA 10:19">És 10:19</ref></char></note>retay sòlda banza yo, mesye pwisan a, fis a Kédar yo, va vin yon tikras; paske SENYÈ a, Bondye Israël la, te pale.”<verse eid="ISA 21:17"/></para>
  <chapter eid="ISA 21"/>
  <chapter number="22" style="c" sid="ISA 22"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1"/>Pwofesi konsènan vale a vizyon an.</para>
  <para style="p" vid="ISA 22:1">Sa k pase nou koulye a, ke nou tout monte sou <note caller="+" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="ISA 15:3">És 15:3</ref> </char></note>twati kay yo? <verse eid="ISA 22:1"/><verse number="2" style="v" sid="ISA 22:2"/>Nou menm ki te plen ak gwo bri, nou menm vil plen ak zen. Mò pa nou yo <note caller="+" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="JER 14:18">Jr 14:18</ref></char></note>pa t mouri akoz nepe, ni yo pa t mouri nan batay la. <verse eid="ISA 22:2"/><verse number="3" style="v" sid="ISA 22:3"/><note caller="+" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="ISA 21:15">És 21:15</ref></char></note>Tout chèf nou yo te kouri ale ansanm e te kaptire san sèvi ak banza yo. Nou tout ke yo te twouve yo te kaptire ansanm, malgre yo te sove ale rive byen lwen. <verse eid="ISA 22:3"/><verse number="4" style="v" sid="ISA 22:4"/>Akoz sa, mwen di nou: “Tounen zye nou byen lwen m; kite mwen <note caller="+" style="x"><char style="xo" closed="false">22:4 </char><char style="xt" closed="false"><ref loc="ISA 15:3">És 15:3</ref></char></note>kriye byen fò, pa eseye rekonfòte m pou destriksyon a fi a pèp mwen an.”<verse eid="ISA 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 22:5"/>Paske Senyè BONDYE dèzame yo te fè yon jou panik <note caller="+" style="x"><char style="xo" closed="false">22:5 </char><char style="xt" closed="false"><ref loc="ISA 10:6">És 10:6</ref> </char></note>opresyon ak konfizyon nan vale vizyon an, miray ki kraze ak kriye nan mòn lan. <verse eid="ISA 22:5"/><verse number="6" style="v" sid="ISA 22:6"/>Élam te leve fouwo flèch yo, cha yo, sòlda sou pa yo ak chevalye yo; epi <note caller="+" style="x"><char style="xo" closed="false">22:6 </char><char style="xt" closed="false"><ref loc="2KI 16:9">II Wa 16:9</ref> </char></note>Kir te dekouvri boukliye a. <verse eid="ISA 22:6"/><verse number="7" style="v" sid="ISA 22:7"/>Vale pi bèl nou yo te vin plen ak cha e chevalye yo te pran pozisyon yo nan pòtay la. <verse eid="ISA 22:7"/><verse number="8" style="v" sid="ISA 22:8"/>Epi li te retire defans Juda. Nan jou sa a, nou te depann de zam a <note caller="+" style="x"><char style="xo" closed="false">22:8 </char><char style="xt" closed="false"><ref loc="1KI 7:2">I Wa 7:2</ref></char></note>kay forè yo. <verse eid="ISA 22:8"/><verse number="9" style="v" sid="ISA 22:9"/>Nou te wè ke brèch nan miray vil a David yo te anpil; epi nou te <note caller="+" style="x"><char style="xo" closed="false">22:9 </char><char style="xt" closed="false"><ref loc="2KI 20:20">II Wa 20:20</ref></char></note>fè koleksyon dlo nan etan dlo pi ba a. <verse eid="ISA 22:9"/><verse number="10" style="v" sid="ISA 22:10"/>Konsa nou te konte kay Jérusalem e nou te detwi kay yo pou ranfòse miray la. <verse eid="ISA 22:10"/><verse number="11" style="v" sid="ISA 22:11"/>Nou te fè yon rezèvwa antre de miray yo pou dlo a <note caller="+" style="x"><char style="xo" closed="false">22:11 </char><char style="xt" closed="false"><ref loc="2KI 20:20">II Wa 20:20</ref> </char></note> ansyen etan dlo a. Men nou pa t depann sou Li ki te fè l, ni ou pa t fè konsiderasyon de Li ki te fè plan an depi tan ansyen nan.<verse eid="ISA 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 22:12"/>Akoz sa, nan jou ke Senyè BONDYE dèzame yo te rele nou pou kriye ak gwo plenyen yo, pou <note caller="+" style="x"><char style="xo" closed="false">22:12 </char><char style="xt" closed="false"><ref loc="MIC 1:16">Mi 1:16</ref></char></note>pase razwa nan tèt ak mete twal sak yo. <verse eid="ISA 22:12"/><verse number="13" style="v" sid="ISA 22:13"/>Men olye sa, nou fè gwo fèt ak kè kontan, touye bèf, kòche mouton, manje vyann ak bwè diven: <note caller="+" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="ISA 56:12">És 56:12</ref></char></note>“Kite nou fè fèt; paske demen nou va mouri.” <verse eid="ISA 22:13"/><verse number="14" style="v" sid="ISA 22:14"/>Men SENYÈ dèzame yo te revele Li menm nan zore m yo: “Anverite, <note caller="+" style="x"><char style="xo" closed="false">22:14 </char><char style="xt" closed="false"><ref loc="1SA 3:14">I Sam 3:14</ref></char></note>nou p ap padone pou krim sa a jiskaske nou mouri”, pale Senyè BONDYE dèzame yo. <verse eid="ISA 22:14"/><verse number="15" style="v" sid="ISA 22:15"/>Se konsa, pale Senyè BONDYE dèzame yo: “Vini, ale kote jeran sila a, kote <note caller="+" style="x"><char style="xo" closed="false">22:15 </char><char style="xt" closed="false"><ref loc="2KI 18:18-37">II Wa 18:18-37</ref></char></note> Schebna ki se chèf an tèt anndan kay wa a. <verse eid="ISA 22:15"/><verse number="16" style="v" sid="ISA 22:16"/>‘Ki dwa ou gen isit la e se kilès ou gen isit la ki fè w fouye yon tonm pou ou menm isit la?’ Ou menm ki fouye yon tonm sou gran wotè a, ki fouye yon plas repo nan wòch la?” <verse eid="ISA 22:16"/><verse number="17" style="v" sid="ISA 22:17"/>Gade byen, SENYÈ a prèt pou voye ou tèt devan. Li prèt pou sezi ou byen di, <verse eid="ISA 22:17"/><verse number="18" style="v" sid="ISA 22:18"/>epi fè ou woule fè yon bòl pou jete nan yon gwo peyi. La, ou va mouri e la, bèl cha ou yo ap ye; Ou menm ki se wont pou lakay mèt ou a. <verse eid="ISA 22:18"/><verse number="19" style="v" sid="ISA 22:19"/>M ap <note caller="+" style="x"><char style="xo" closed="false">22:19 </char><char style="xt" closed="false"><ref loc="JOB 40:11-12">Job 40:11-12</ref></char></note>retire ou nan pozisyon ou e m ap rale ou desann soti nan wo plas ou.<verse eid="ISA 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 22:20"/>Konsa, li va rive nan jou sa a ke Mwen va voye rele sèvitè Mwen an, <note caller="+" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="2KI 18:18">II Wa 18:18</ref></char></note>Éliakim, fis a Hilkija a, <verse eid="ISA 22:20"/><verse number="21" style="v" sid="ISA 22:21"/>Mwen va abiye l ak vètman pa w e tache sentiwon pa w, byen tache sou li. Mwen va fè l konfyans pou l pran otorite pa w la e li va vin yon <note caller="+" style="x"><char style="xo" closed="false">22:21 </char><char style="xt" closed="false"><ref loc="GEN 45:8">Jen 45:8</ref></char></note>papa a sila ki rete Jérusalem yo ak lakay Juda a. <verse eid="ISA 22:21"/><verse number="22" style="v" sid="ISA 22:22"/>Konsa, Mwen va mete <note caller="+" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="REV 3:7">Rev 3:7</ref></char></note>kle lakay David la sou zepòl li. Lè l ouvri li, pèsòn p ap fèmen l e lè l fèmen l, pèsòn p ap ouvri li. <verse eid="ISA 22:22"/><verse number="23" style="v" sid="ISA 22:23"/>Mwen va kondwi li antre tankou yon <note caller="+" style="x"><char style="xo" closed="false">22:23 </char><char style="xt" closed="false"><ref loc="EZR 9:8">Esd 9:8</ref></char></note>klou sou yon kote byen solid e li va devni yon twòn glwa pou lakay papa l. <verse eid="ISA 22:23"/><verse number="24" style="v" sid="ISA 22:24"/>Konsa, yo va kloue sou li tout glwa lakay papa l, desandan ak sila k ap vini yo, tout veso pi piti yo, soti nan bòl, jis rive nan bokal. <verse eid="ISA 22:24"/><verse number="25" style="v" sid="ISA 22:25"/>“Nan jou sa a”, deklare SENYÈ dèzame yo: <note caller="+" style="x"><char style="xo" closed="false">22:25 </char><char style="xt" closed="false"><ref loc="ISA 22:23">És 22:23</ref></char></note>“Klou ki kloue nan yon kote solid la, va rache tonbe. Epi chaj ki kenbe sou li a va koupe retire nèt; paske SENYÈ a te pale.”<verse eid="ISA 22:25"/></para>
  <chapter eid="ISA 22"/>
  <chapter number="23" style="c" sid="ISA 23"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1"/>Pwofesi konsènan Tyr a.</para>
  <para style="p" vid="ISA 23:1">Rele anmwey, O bato a <note caller="+" style="x"><char style="xo" closed="false">23:1 </char><char style="xt" closed="false"><ref loc="GEN 10:4">Jen 10:4</ref> </char></note>Tarsis yo! Paske Tyr detwi e li vin rete san kay, ni pò. Rapò a rive kote yo soti nan peyi Chypre. <verse eid="ISA 23:1"/><verse number="2" style="v" sid="ISA 23:2"/><note caller="+" style="x"><char style="xo" closed="false">23:2 </char><char style="xt" closed="false"><ref loc="ISA 47:5">És 47:5</ref></char></note>Rete san pale, O moun ki rete nan peyi kot yo; komèsan a Sidon yo k ap travèse lanmè a fin ranplase ou. <verse eid="ISA 23:2"/><verse number="3" style="v" sid="ISA 23:3"/>Sou anpil dlo sereyal a <note caller="+" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="JOS 13:3">Jos 13:3</ref></char></note>Nil la, rekòlt a Rivyè a te mwayen lavi li. Se li ki te mache pou nasyon yo. <verse eid="ISA 23:3"/><verse number="4" style="v" sid="ISA 23:4"/>Rete wont, <note caller="+" style="x"><char style="xo" closed="false">23:4 </char><char style="xt" closed="false"><ref loc="GEN 10:15-19">Jen 10:15-19</ref></char></note>O Sidon; paske lanmè a pale, sitadèl lanmè a, di: “Mwen pa t gen doulè, ni fè pitit; mwen pa t leve jennonm, ni leve vyèj.” <verse eid="ISA 23:4"/><verse number="5" style="v" sid="ISA 23:5"/>Lè rapò a rive an Égypte, y ap twouble anpil akoz rapò Tyr a. <verse eid="ISA 23:5"/><verse number="6" style="v" sid="ISA 23:6"/>Janbe rive <note caller="+" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="ISA 23:1">És 23:1</ref></char></note>Tarsis! Rele anmwey, O moun peyi kot yo! <verse eid="ISA 23:6"/><verse number="7" style="v" sid="ISA 23:7"/>Èske sa se gwo vil <note caller="+" style="x"><char style="xo" closed="false">23:7 </char><char style="xt" closed="false"><ref loc="ISA 22:2">És 22:2</ref></char></note>kè kontan nou an, ki te bati soti antikite yo, pye a sila ki te konn pote li jis byen lwen nan vwaj yo?<verse eid="ISA 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 23:8"/>Kilès ki te fè plan sila a kont Tyr, ki te konn <note caller="+" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="EZK 28:2">Éz 28:2</ref></char></note>bay tout kouwòn yo, komèsan a sila ki te prens yo, machann a sila ki te gen onè sou tout latè yo? <verse eid="ISA 23:8"/><verse number="9" style="v" sid="ISA 23:9"/>SENYÈ dèzame yo te planifye sa, pou souye ògèy a tout bèlte sa a e imilye <note caller="+" style="x"><char style="xo" closed="false">23:9 </char><char style="xt" closed="false"><ref loc="ISA 5:13">És 5:13</ref> </char></note>tout gran sou latè yo. <verse eid="ISA 23:9"/><verse number="10" style="v" sid="ISA 23:10"/>Debòde peyi ou a tankou Rivyè Nil, O fi a Tarsis; nanpwen anyen ki pou anpeche ou ankò. <verse eid="ISA 23:10"/><verse number="11" style="v" sid="ISA 23:11"/>Li fin lonje men l sou lanmè a, Li te fè wayòm yo tranble. SENYÈ a te pase lòd konsènan Canaan pou <note caller="+" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="ISA 25:2">És 25:2</ref> </char></note>detwi tout fò ranfòse yo. <verse eid="ISA 23:11"/><verse number="12" style="v" sid="ISA 23:12"/>Li fin di: “Ou p ap leve tèt ou wo ankò, O vyèj kraze Sidon nan! Leve, travèse <note caller="+" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="ISA 23:1">És 23:1</ref></char></note>Chypre; menm la, ou p ap jwenn repo.”<verse eid="ISA 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 23:13"/>Gade byen, peyi a Kaldeyen yo—sa se pèp ki pa t egziste. Assyrie te dezigne l pou moun dezè—yo te fè leve fò syèj yo, byen wo. Yo te kraze palè li yo, yo te fè l vin yon pil mazi kraze. <verse eid="ISA 23:13"/><verse number="14" style="v" sid="ISA 23:14"/>Rele anmwey, O <note caller="+" style="x"><char style="xo" closed="false">23:14 </char><char style="xt" closed="false"><ref loc="ISA 2:16">És 2:16</ref></char></note>bato a Tarsis yo, paske sitadèl ranfòse nou yo vin detwi! <verse eid="ISA 23:14"/><verse number="15" style="v" sid="ISA 23:15"/>Alò, nan jou sa a, Tyr va vin bliye pandan <note caller="+" style="x"><char style="xo" closed="false">23:15 </char><char style="xt" closed="false"><ref loc="JER 25:11-22">Jr 25:11-22</ref></char></note>swasann-dizan, tankou jou a yon sèl wa. Nan fen swasann-dizan yo, sa va vin rive Tyr tankou nan chanson a fanm pwostitiye a. <verse eid="ISA 23:15"/><verse number="16" style="v" sid="ISA 23:16"/>Pran ap ou, mache nan vil la, O fanm pwostitiye ki fin bliye. Rale kòd li yo ak ladrès; chante anpil chan pou yo ka sonje ou. <verse eid="ISA 23:16"/><verse number="17" style="v" sid="ISA 23:17"/>Li va vin rive nan <note caller="+" style="x"><char style="xo" closed="false">23:17 </char><char style="xt" closed="false"><ref loc="ISA 23:15">És 23:15</ref></char></note>fen swasann-dizan yo, ke SENYÈ a va vizite Tyr. Apre, li va retounen jwenn salè pwostitiye li yo e li va fè pwostitiye ak tout wayòm sou tout fas latè yo. <verse eid="ISA 23:17"/><verse number="18" style="v" sid="ISA 23:18"/>Sa li reyalize ak salè pwostitiye a, li va <note caller="+" style="x"><char style="xo" closed="false">23:18 </char><char style="xt" closed="false"><ref loc="EXO 28:36">Egz 28:36</ref></char></note>mete li apa pou SENYÈ a. Li p ap mete li nan depo, ni sere l nan depo, men sa li reyalize a va devni manje ase ak vètman byen chwazi pou sila ki demere nan prezans SENYÈ yo.<verse eid="ISA 23:18"/></para>
  <chapter eid="ISA 23"/>
  <chapter number="24" style="c" sid="ISA 24"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 24:1"/>Gade byen, SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="ISA 2:19">És 2:19</ref></char></note>va devaste tout latè ak gwo destriksyon, boulvèse sifas li e gaye tout moun ki rete ladann. <verse eid="ISA 24:1"/><verse number="2" style="v" sid="ISA 24:2"/>Pèp la menm jan ak prèt la, sèvitè a tankou mèt li, sèvant lan tankou mètrès li, sa k ap achte tankou sa k ap vann, sila k ap fè prè a tankou sila k ap prete a, <note caller="+" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="LEV 25:36-37">Lev 25:36-37</ref></char></note>sila ki resevwa kredi a tankou sila k ap bay kredi a. <verse eid="ISA 24:2"/><verse number="3" style="v" sid="ISA 24:3"/>Latè va devaste nèt e vin depouye, paske SENYÈ a te pale pawòl sa a. <verse eid="ISA 24:3"/><verse number="4" style="v" sid="ISA 24:4"/><note caller="+" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="ISA 33:8">És 33:8</ref></char></note>Latè kriye ak doulè e vin fennen nèt. Sila ki egzalte wo sou moun latè yo vin disparèt. <verse eid="ISA 24:4"/><verse number="5" style="v" sid="ISA 24:5"/>Anplis, latè vin plen ak pouriti a moun k ap viv ladann, paske yo te transgrese lalwa yo, vyole règleman yo, e te kraze akò letènèl la. <verse eid="ISA 24:5"/><verse number="6" style="v" sid="ISA 24:6"/>Akoz sa, yon <note caller="+" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="JOS 23:15">Jos 23:15</ref></char></note>malediksyon devore latè a, e sila ki rete ladann yo vin twouve koupab. Konsa, sila ki rete sou latè yo vin brile e se sèl kèk grenn moun ki rete. <verse eid="ISA 24:6"/><verse number="7" style="v" sid="ISA 24:7"/><note caller="+" style="x"><char style="xo" closed="false">24:7 </char><char style="xt" closed="false"><ref loc="ISA 16:10">És 16:10</ref></char></note>Diven nèf la fèb. Chan rezen an gate. Tout kè kontan yo fè gwo plent. <verse eid="ISA 24:7"/><verse number="8" style="v" sid="ISA 24:8"/><note caller="+" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="ISA 5:12-14">És 5:12-14</ref></char></note>Kè kontan a tanbouren yo vin rete, bri a moun k ap fete yo vin sispann. <verse eid="ISA 24:8"/><verse number="9" style="v" sid="ISA 24:9"/>Yo pa bwè diven ak chanson; bwason fò yo vin <note caller="+" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="ISA 5:20">És 5:20</ref> </char></note>anmè pou sila ki bwè l yo. <verse eid="ISA 24:9"/><verse number="10" style="v" sid="ISA 24:10"/>Vil gwo dezòd la vin kraze nèt. <note caller="+" style="x"><char style="xo" closed="false">24:10 </char><char style="xt" closed="false"><ref loc="ISA 23:1">És 23:1</ref> </char></note>Tout kay vin fèmen pou pèsòn pa antre. <verse eid="ISA 24:10"/><verse number="11" style="v" sid="ISA 24:11"/>Gen gwo kriye nan lari a pou afè diven. <note caller="+" style="x"><char style="xo" closed="false">24:11 </char><char style="xt" closed="false"><ref loc="ISA 16:10">És 16:10</ref></char></note>Tout kè kontan vire an gwo tristès. <verse eid="ISA 24:11"/><verse number="12" style="v" sid="ISA 24:12"/>Se dezolasyon ki rete nan vil la e <note caller="+" style="x"><char style="xo" closed="false">24:12 </char><char style="xt" closed="false"><ref loc="ISA 14:31">És 14:31</ref></char></note>pòtay la fin kraze nèt. <verse eid="ISA 24:12"/><verse number="13" style="v" sid="ISA 24:13"/>Paske se <note caller="+" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="ISA 17:6">És 17:6</ref></char></note>konsa l ap ye nan mitan latè a pami pèp yo; tankou lè bwa doliv souke fò, tankou sila ki ranmase apre rekòlt rezen an fin fèt yo. <verse eid="ISA 24:13"/><verse number="14" style="v" sid="ISA 24:14"/><note caller="+" style="x"><char style="xo" closed="false">24:14 </char><char style="xt" closed="false"><ref loc="ISA 12:6">És 12:6</ref></char></note>Yo leve vwa yo; yo kriye ak kè kontan. Yo kriye soti nan lwès akoz majeste SENYÈ a. <verse eid="ISA 24:14"/><verse number="15" style="v" sid="ISA 24:15"/>Pou sa, bay glwa a SENYÈ a nan lès, non SENYÈ a, Bondye Israël la, nan <note caller="+" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="ISA 11:11">És 11:11</ref> </char></note>peyi kot lanmè yo. <verse eid="ISA 24:15"/><verse number="16" style="v" sid="ISA 24:16"/>Soti nan <note caller="+" style="x"><char style="xo" closed="false">24:16 </char><char style="xt" closed="false"><ref loc="ISA 11:12">És 11:12</ref></char></note>dènye pwent latè, nou tande chan yo: “Glwa a Sila Ki Dwat la,” men mwen di: “Malè a mwen menm! Malè a mwen menm! Elas pou mwen! Moun trèt yo aji an trèt e moun trèt yo aji an trèt anpil.” <verse eid="ISA 24:16"/><verse number="17" style="v" sid="ISA 24:17"/><note caller="+" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="JER 48:43">Jr 48:43</ref></char></note>Gwo laperèz, twou fòs ak pèlen vin devan nou menm ki rete sou latè. <verse eid="ISA 24:17"/><verse number="18" style="v" sid="ISA 24:18"/>Konsa, li va rive ke sila ki sove ale lè l tande gwo dega a va vin tonbe nan fòs la, e sila ki rale kò l sòti nan fòs la va pran nan pèlen an; paske <note caller="+" style="x"><char style="xo" closed="false">24:18 </char><char style="xt" closed="false"><ref loc="GEN 7:11">Jen 7:11</ref></char></note>fenèt anlè yo vin louvri e fondasyon latè yo ap tranble. <verse eid="ISA 24:18"/><verse number="19" style="v" sid="ISA 24:19"/>Latè vin dechire. Latè vin <note caller="+" style="x"><char style="xo" closed="false">24:19 </char><char style="xt" closed="false"><ref loc="NUM 16:31-32">Nonb 16:31-32</ref> </char></note>fann nèt. Latè souke ak vyolans. <verse eid="ISA 24:19"/><verse number="20" style="v" sid="ISA 24:20"/>Latè woule de bò tankou moun ki anba gwòg. Li pyete tankou vye kay pay. Akoz transgresyon li yo peze lou sou li, li va tonbe nèt <note caller="+" style="x"><char style="xo" closed="false">24:20 </char><char style="xt" closed="false"><ref loc="DAN 11:19">Dan 11:19</ref></char></note>pou l pa janm leve ankò. <verse eid="ISA 24:20"/><verse number="21" style="v" sid="ISA 24:21"/>Li va rive nan jou sa a ke SENYÈ a va <note caller="+" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ISA 10:12">És 10:12</ref></char></note>pini lame syèl anwo yo ak wa latè sou latè yo. <verse eid="ISA 24:21"/><verse number="22" style="v" sid="ISA 24:22"/>Yo va ranmase ansanm tankou <note caller="+" style="x"><char style="xo" closed="false">24:22 </char><char style="xt" closed="false"><ref loc="ISA 10:4">És 10:4</ref></char></note>prizonye nan yon kacho e yo va fèmen nan prizon. Apre anpil jou, yo va pini. <verse eid="ISA 24:22"/><verse number="23" style="v" sid="ISA 24:23"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">24:23 </char><char style="xt" closed="false"><ref loc="ISA 13:10">És 13:10</ref></char></note>lalin nan va vin twouble e solèy la va vin wont, paske SENYÈ dèzame yo va renye sou Mòn Sion ak Jérusalem, e laglwa Li va devan ansyen Li yo.<verse eid="ISA 24:23"/></para>
  <chapter eid="ISA 24"/>
  <chapter number="25" style="c" sid="ISA 25"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 25:1"/>O SENYÈ, Ou se Bondye mwen. Mwen va leve Ou byen wo! Mwen va bay remèsiman a non Ou, paske Ou te fè gwo mèvèy; <note caller="+" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="EPH 1:11">Ef 1:11</ref> </char></note>plan yo ki te fòme depi lontan, avèk tout fidelite ak verite. <verse eid="ISA 25:1"/><verse number="2" style="v" sid="ISA 25:2"/>Paske Ou te fè yon gran vil vin tounen yon gwo pil wòch, yon vil byen fòtifye vin detwi nèt. Yon <note caller="+" style="x"><char style="xo" closed="false">25:2 </char><char style="xt" closed="false"><ref loc="ISA 13:22">És 13:22</ref></char></note> palè pou etranje yo pa yon vil ankò; li p ap janm rebati. <verse eid="ISA 25:2"/><verse number="3" style="v" sid="ISA 25:3"/>Akoz sa, yon pèp byen fò va bay Ou glwa. <note caller="+" style="x"><char style="xo" closed="false">25:3 </char><char style="xt" closed="false"><ref loc="ISA 13:11">És 13:11</ref></char></note>Gran vil a nasyon ki mechan yo va fè Ou omaj . <verse eid="ISA 25:3"/><verse number="4" style="v" sid="ISA 25:4"/>Ou te toujou yon abri pou sila ki san sekou yo; yon defans pou malere nan gwo twoub la, yon pwotèj kont tanpèt, lonbraj kont chalè. Paske souf a <note caller="+" style="x"><char style="xo" closed="false">25:4 </char><char style="xt" closed="false"><ref loc="ISA 29:5-20">És 29:5-20</ref></char></note>mechan yo se tankou gwo tanpèt lapli kont yon miray. <verse eid="ISA 25:4"/><verse number="5" style="v" sid="ISA 25:5"/>Tankou chalè nan gwo sechrès, Ou fè bese <note caller="+" style="x"><char style="xo" closed="false">25:5 </char><char style="xt" closed="false"><ref loc="JER 51:54-56">Jr 51:54-56</ref></char></note>zen a etranje yo; tankou chalè toupre lonbraj a yon nwaj, chanson a malveyan an vin bese ba.<verse eid="ISA 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 25:6"/>SENYÈ dèzame yo va prepare yon gwo bankè pou <note caller="+" style="x"><char style="xo" closed="false">25:6 </char><char style="xt" closed="false"><ref loc="ISA 2:2-4">És 2:2-4</ref></char></note>tout pèp sou mòn sa a; yon bankè diven rasi, mòso chwazi ak mwèl zo, diven byen rafine. <verse eid="ISA 25:6"/><verse number="7" style="v" sid="ISA 25:7"/>Sou mòn sa a, Li va vale nèt <note caller="+" style="x"><char style="xo" closed="false">25:7 </char><char style="xt" closed="false"><ref loc="2CO 3:15-16">II Kor 3:15-16</ref></char></note>kouvèti pwotèj ki sou tout pèp yo, menm vwal la ki tann sou tout nasyon yo. <verse eid="ISA 25:7"/><verse number="8" style="v" sid="ISA 25:8"/>Li te <note caller="+" style="x"><char style="xo" closed="false">25:8 </char><char style="xt" closed="false"><ref loc="HOS 13:14">Os 13:14</ref></char></note>vale lanmò jis pou tout tan! Senyè BONDYE a va siye tout dlo nan zye a tout moun e li va retire repwòch a pèp Li a sou tout latè. Paske SENYÈ a te pale.<verse eid="ISA 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9"/>Konsa, li va pale nan jou sa a, “Gade byen, <note caller="+" style="x"><char style="xo" closed="false">25:9 </char><char style="xt" closed="false"><ref loc="ISA 35:2">És 35:2</ref></char></note>sa se Bondye nou an! Sila nou te tann pou L te ka sove nou an! Sa se SENYÈ a! Sila nou t ap tann nan! Annou rejwi e fè kè kontan nan sali Li a!” <verse eid="ISA 25:9"/><verse number="10" style="v" sid="ISA 25:10"/>Paske men SENYÈ a va rete sou mòn sa a.</para>
  <para style="p" vid="ISA 25:10">Epi <note caller="+" style="x"><char style="xo" closed="false">25:10 </char><char style="xt" closed="false"><ref loc="ISA 16:14">És 16:14</ref></char></note>Moab va foule kote li ye, tankou pay fin foule nan dlo a yon pil fimye. <verse eid="ISA 25:10"/><verse number="11" style="v" sid="ISA 25:11"/>L ap ouvri men l byen gran nan mitan li kon yon moun k ap naje ta lonje men l yo pou naje; men SENYÈ a va <note caller="+" style="x"><char style="xo" closed="false">25:11 </char><char style="xt" closed="false"><ref loc="JOB 40:11">Job 40:11</ref></char></note>desann ògèy li ansanm ak manèv koken a men li yo. <verse eid="ISA 25:11"/><verse number="12" style="v" sid="ISA 25:12"/>L ap desann ranfòsman fò ki <note caller="+" style="x"><char style="xo" closed="false">25:12 </char><char style="xt" closed="false"><ref loc="ISA 15:1">És 15:1</ref></char></note>pa t ka menm pwoche la, li va anile yo, bese yo e jete yo atè, jis rive nan pousyè.<verse eid="ISA 25:12"/></para>
  <chapter eid="ISA 25"/>
  <chapter number="26" style="c" sid="ISA 26"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1"/>Nan jou sa a, chanson sa a va chante nan peyi Juda:</para>
  <para style="q1" vid="ISA 26:1">“Nou gen yon vil ki fò;</para>
  <para style="q1" vid="ISA 26:1">li monte miray ak ranfò pou <note caller="+" style="x"><char style="xo" closed="false">26:1 </char><char style="xt" closed="false"><ref loc="ISA 60:18">És 60:18</ref> </char></note>sekirite.<verse eid="ISA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2"/>Ouvri <note caller="+" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="ISA 60:11-18">És 60:11-18</ref></char></note>pòtay yo pou nasyon ladwati a ka antre;</para>
  <para style="q1" vid="ISA 26:2">sila ki rete fidèl la.<verse eid="ISA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3"/>Sila ki rete fèm nan panse li yo,</para>
  <para style="q1" vid="ISA 26:3">Ou va kenbe nan <note caller="+" style="x"><char style="xo" closed="false">26:3 </char><char style="xt" closed="false"><ref loc="ISA 26:12">És 26:12</ref></char></note>lapè pafè,</para>
  <para style="q1" vid="ISA 26:3">akoz li gen konfyans nan Ou.<verse eid="ISA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4"/>Mete konfyans nan SENYÈ a jis pou tout tan,</para>
  <para style="q1" vid="ISA 26:4">paske nan BONDYE SENYÈ a,</para>
  <para style="q1" vid="ISA 26:4">nou gen yon <note caller="+" style="x"><char style="xo" closed="false">26:4 </char><char style="xt" closed="false"><ref loc="ISA 17:10">És 17:10</ref> </char></note>Wòch etènèl.<verse eid="ISA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5"/>Paske Li te bese sila ki te rete anwo yo,</para>
  <para style="q1" vid="ISA 26:5">vil ki pa t kapab venk lan.</para>
  <para style="q1" vid="ISA 26:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">26:5 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 40:11-13">Job 40:11-13</ref>
      </char>
    </note>Li te desann li ba.</para>
  <para style="q1" vid="ISA 26:5">Li te desann li jis atè.</para>
  <para style="q1" vid="ISA 26:5">Li te jete li nan pousyè.<verse eid="ISA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:6 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 40:11-13">Job 40:11-13</ref>
      </char>
    </note>Pye va foule l, pye a malere a,</para>
  <para style="q1" vid="ISA 26:6">pla pye a sila ki san sekou yo.”<verse eid="ISA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:7 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 57:2">És 57:2</ref>
      </char>
    </note>Chemen moun jis se ladwati.</para>
  <para style="q1" vid="ISA 26:7">O Sila Ki Dwat la, fè wout a moun dwat yo a byen pla.<verse eid="ISA 26:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8"/>Anverite, selon jijman Ou yo,</para>
  <para style="q1" vid="ISA 26:8">O SENYÈ, nou t ap tann Ou.</para>
  <para style="q1" vid="ISA 26:8">Non Ou, menm <note caller="+" style="x"><char style="xo" closed="false">26:8 </char><char style="xt" closed="false"><ref loc="EXO 3:15">Egz 3:15</ref></char></note>memwa Ou, se dezi a nanm nou.<verse eid="ISA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 63:5-6">Sòm 63:5-6</ref>
      </char>
    </note>Nan lannwit, nanm mwen anvi Ou.</para>
  <para style="q1" vid="ISA 26:9">Anverite, lespri m anndan mwen chache Ou ak enpasyans;</para>
  <para style="q1" vid="ISA 26:9">paske lè jijman Ou yo rive sou latè,</para>
  <para style="q1" vid="ISA 26:9">sila ki rete ladann yo, aprann ladwati.<verse eid="ISA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10"/>Malgre mechan an ta jwenn favè, li pa p aprann ladwati.</para>
  <para style="q1" vid="ISA 26:10">Li <note caller="+" style="x"><char style="xo" closed="false">26:10 </char><char style="xt" closed="false"><ref loc="HOS 11:7">Os 11:7</ref></char></note>aji ak enjistis nan peyi ladwati.</para>
  <para style="q1" vid="ISA 26:10">Konsa, li p ap janm wè majeste Senyè a.<verse eid="ISA 26:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11"/>O SENYÈ, men Ou leve wo, men <note caller="+" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="ISA 44:9-18">És 44:9-18</ref></char></note>yo pa wè li;</para>
  <para style="q1" vid="ISA 26:11">men yo va wè zèl Ou pou pèp la</para>
  <para style="q1" vid="ISA 26:11">e y ap vin wont.</para>
  <para style="q1" vid="ISA 26:11">Anverite, dife va devore lènmi Ou yo.<verse eid="ISA 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12"/>SENYÈ, Ou va etabli <note caller="+" style="x"><char style="xo" closed="false">26:12 </char><char style="xt" closed="false"><ref loc="ISA 26:3">És 26:3</ref></char></note>lapè pou nou,</para>
  <para style="q1" vid="ISA 26:12">akoz ou te akonpli pou nou tout zèv nou yo.<verse eid="ISA 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13"/>O SENYÈ, Bondye nou an, lòt mèt apà de ou te gouvène nou;</para>
  <para style="q1" vid="ISA 26:13">men se non Ou sèl, ke nap konfese.<verse eid="ISA 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:14 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:28">Det 4:28</ref>
      </char>
    </note>Sila ki mouri yo p ap viv.</para>
  <para style="q1" vid="ISA 26:14">Lespri ki pati yo p ap leve ankò.</para>
  <para style="q1" vid="ISA 26:14">Konsa, Ou te pini yo, detwi yo</para>
  <para style="q1" vid="ISA 26:14">e Ou te efase tout memwa a yo menm.<verse eid="ISA 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:15 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 9:3">És 9:3</ref>
      </char>
    </note> Ou te ogmante nasyon an, O SENYÈ,</para>
  <para style="q1" vid="ISA 26:15">Ou te agrandi nasyon an!</para>
  <para style="q1" vid="ISA 26:15">Ou leve wo!</para>
  <para style="q1" vid="ISA 26:15">Ou te fè tout lizyè peyi a vin pi laj.<verse eid="ISA 26:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16"/>O SENYÈ, nan mitan <note caller="+" style="x"><char style="xo" closed="false">26:16 </char><char style="xt" closed="false"><ref loc="ISA 37:3">És 37:3</ref></char></note>gwo twoub yo, yo te chache Ou.</para>
  <para style="q1" vid="ISA 26:16">Yo pa t ka fè plis pase respire yon priyè le chatiman Ou te sou yo.<verse eid="ISA 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">26:17 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 13:8">És 13:8</ref>
      </char>
    </note>Tankou fanm ansent k ap pwoche tan pou akouche;</para>
  <para style="q1" vid="ISA 26:17">li vire kò l e li rele anmwey nan doulè ansent lan;</para>
  <para style="q1" vid="ISA 26:17">se konsa nou te ye devan Ou, O SENYÈ.<verse eid="ISA 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18"/>Nou te ansent, nou te vire kò,</para>
  <para style="q1" vid="ISA 26:18">men nou pa t bay nesans a plis ke van.</para>
  <para style="q1" vid="ISA 26:18">Nou pa t ka akonpli delivrans sou tè a,</para>
  <para style="q1" vid="ISA 26:18">ni <note caller="+" style="x"><char style="xo" closed="false">26:18 </char><char style="xt" closed="false"><ref loc="PSA 17:14">Sòm 17:14</ref></char></note> pitit mond yo pa t tonbe.<verse eid="ISA 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19"/>Moun <note caller="+" style="x"><char style="xo" closed="false">26:19 </char><char style="xt" closed="false"><ref loc="ISA 25:8">És 25:8</ref></char></note>mouri Ou yo va viv;</para>
  <para style="q1" vid="ISA 26:19">kadav pa yo va leve.</para>
  <para style="q1" vid="ISA 26:19">Nou menm ki kouche nan pousyè a,</para>
  <para style="q1" vid="ISA 26:19">leve e fè kri lajwa,</para>
  <para style="q1" vid="ISA 26:19">paske lawouze ou se lawouze solèy leve a,</para>
  <para style="q1" vid="ISA 26:19">e latè va bay nesans a lespri ki te pati yo.<verse eid="ISA 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 26:20"/>Vini, pèp mwen an, antre nan chanm nou</para>
  <para style="q1" vid="ISA 26:20">e fèmen pòt nou dèyè nou.</para>
  <para style="q1" vid="ISA 26:20">Kache pou yon ti tan jiskaske <note caller="+" style="x"><char style="xo" closed="false">26:20 </char><char style="xt" closed="false"><ref loc="ISA 10:5-25">És 10:5-25</ref></char></note>gwo kòlè a fin pase.<verse eid="ISA 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 26:21"/>Paske gade byen, SENYÈ a prèt pou sòti nan plas Li,</para>
  <para style="q1" vid="ISA 26:21">pou pini sila ki rete sou latè yo pou inikite yo.</para>
  <para style="q1" vid="ISA 26:21">Konsa, latè va fè parèt tout san vèse li yo,</para>
  <para style="q1" vid="ISA 26:21">e li p ap kache mò li yo ankò.<verse eid="ISA 26:21"/></para>
  <chapter eid="ISA 26"/>
  <chapter number="27" style="c" sid="ISA 27"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1"/>Nan jou sa a, SENYÈ a va pini Leviathan ak gwo nepe a byen di. Leviathan, sèpan tòde a, kap pran flit; <note caller="+" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="ISA 51:9">És 51:9</ref> </char></note>li va touye dragon an ki rete nan lanmè a.<verse eid="ISA 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 27:2"/>Nan jou sa a, chante pou li <note caller="+" style="x"><char style="xo" closed="false">27:2 </char><char style="xt" closed="false"><ref loc="PSA 80:8">Sòm 80:8</ref></char></note>"Yon bèl chan rezen! <verse eid="ISA 27:2"/><verse number="3" style="v" sid="ISA 27:3"/>Mwen, SENYÈ a, se jeran li. Mwen wouze li tout tan. Pou pèsòn pa fè l donmaj, Mwen <note caller="+" style="x"><char style="xo" closed="false">27:3 </char><char style="xt" closed="false"><ref loc="1SA 2:9">I Sam 2:9</ref> </char></note>veye li lajounen kon lannwit. <verse eid="ISA 27:3"/><verse number="4" style="v" sid="ISA 27:4"/>Mwen pa moun lakòlè. Men si Mwen ta jwenn raje ak pikan yo, Mwen ta fè batay! <note caller="+" style="x"><char style="xo" closed="false">27:4 </char><char style="xt" closed="false"><ref loc="ISA 33:12">És 33:12</ref></char></note>Mwen ta mache sou yo, e brile yo nèt. <verse eid="ISA 27:4"/><verse number="5" style="v" sid="ISA 27:5"/>Oswa, kite li <note caller="+" style="x"><char style="xo" closed="false">27:5 </char><char style="xt" closed="false"><ref loc="ISA 12:2">És 12:2</ref></char></note>depann de fòs Mwen pou l ka fè lapè avè M. Kite li fè lapè avè M.”<verse eid="ISA 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 27:6"/>Nan jou k ap vini yo, Jacob va pran rasin. Israël va fleri e boujonnen. Yo va plen tout mond lan ak <note caller="+" style="x"><char style="xo" closed="false">27:6 </char><char style="xt" closed="false"><ref loc="ISA 4:2">És 4:2</ref> </char></note>fwi. <verse eid="ISA 27:6"/><verse number="7" style="v" sid="ISA 27:7"/>Èske Li te frape yo, jan <note caller="+" style="x"><char style="xo" closed="false">27:7 </char><char style="xt" closed="false"><ref loc="ISA 10:12-17">És 10:12-17</ref></char></note>li te frape sa yo ki frape yo? Oswa èske se tankou masak Sila ki touye yo a, Li te touye yo? <verse eid="ISA 27:7"/><verse number="8" style="v" sid="ISA 27:8"/>Ou te konfwonte yo ak egzil; ou te pouse yo ale. Ak souf fewòs Li, Li te chase yo ale nan jou <note caller="+" style="x"><char style="xo" closed="false">27:8 </char><char style="xt" closed="false"><ref loc="JER 4:11">Jr 4:11</ref></char></note>van lès la. <verse eid="ISA 27:8"/><verse number="9" style="v" sid="ISA 27:9"/>Akoz sa e atravè sa, inikite a Jacob la va padone. Konsa, sa va tout fwi la pou <note caller="+" style="x"><char style="xo" closed="false">27:9 </char><char style="xt" closed="false"><ref loc="ROM 11:27">Wo 11:27</ref> </char></note>rete peche li: lè l fè lotèl wòch yo vin tankou poud wòch lakrè, pou Asherim nan ak lotèl lansan yo pa kanpe ankò. <verse eid="ISA 27:9"/><verse number="10" style="v" sid="ISA 27:10"/>Paske vil fòtifye a vin sèl, yon anplasman kay ki dezole e ki vin bliye tankou dezè. <note caller="+" style="x"><char style="xo" closed="false">27:10 </char><char style="xt" closed="false"><ref loc="ISA 17:2">És 17:2</ref> </char></note>Jenn bèf la va manje la, li va kouche e manje sou branch li yo. <verse eid="ISA 27:10"/><verse number="11" style="v" sid="ISA 27:11"/>Lè branch li yo vin sèch, yo vin kase yo. Fanm yo va vini pou fè dife avèk yo, paske se yon pèp san konprann. Akoz sa <note caller="+" style="x"><char style="xo" closed="false">27:11 </char><char style="xt" closed="false"><ref loc="DEU 32:18">Det 32:18</ref></char></note>Kreyatè yo a p ap fè konpasyon sou yo. Li ki te fòme yo a p ap bay yo gras.<verse eid="ISA 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12"/>Nan jou sa a, SENYÈ a va kòmanse bat gwo rekòlt Li depi nan flèv Rivyè Euphrate la jis rive nan dlo Égypte la, e nou va vin ranmase youn pa youn, O fis Israël yo.<verse eid="ISA 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 27:13"/>Anplis, li va vin rive ke nan jou ke <note caller="+" style="x"><char style="xo" closed="false">27:13 </char><char style="xt" closed="false"><ref loc="LEV 25:9">Lev 25:9</ref></char></note>gran twonpèt la ap sone a, sila ki t ap peri nan peyi Assyrie yo, e ki te gaye an Égypte yo, va vin adore SENYÈ a nan mòn sen Jérusalem nan.<verse eid="ISA 27:13"/></para>
  <chapter eid="ISA 27"/>
  <chapter number="28" style="c" sid="ISA 28"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 28:1"/>Malè a kouwòn ògèy a moun sou ak diven <note caller="+" style="x"><char style="xo" closed="false">28:1 </char><char style="xt" closed="false"><ref loc="ISA 9:9">És 9:9</ref> </char></note>Éphraïm yo, ak flè fane li ki pèdi bèlte ak glwa li. Li menm ki sou tèt vale fètil a sila ki fin sou ak diven yo! <verse eid="ISA 28:1"/><verse number="2" style="v" sid="ISA 28:2"/>Veye byen, SENYÈ a gen <note caller="+" style="x"><char style="xo" closed="false">28:2 </char><char style="xt" closed="false"><ref loc="ISA 8:7">És 8:7</ref></char></note>yon asistan ase fò e pwisan. Tankou tanpèt lagrèl, yon tanpèt destriksyon, yon tanpèt pwisan k ap debòde dlo, Li va vin jete yo atè ak men Li. <verse eid="ISA 28:2"/><verse number="3" style="v" sid="ISA 28:3"/>Kouwòn ògèy a moun sou Éphraïm yo va vin <note caller="+" style="x"><char style="xo" closed="false">28:3 </char><char style="xt" closed="false"><ref loc="ISA 26:6">És 26:6</ref></char></note>foule anba pye. <verse eid="ISA 28:3"/><verse number="4" style="v" sid="ISA 28:4"/>Epi flè ki kanpe sou tèt valè fètil la, va vin pèdi bèlte li tankou <note caller="+" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="HOS 9:10">Os 9:10</ref></char></note>premye fwi figye etranje ke yon moun wè avan gran sezon a. Yon moun jwenn l, epi lapoula, li vale l. <verse eid="ISA 28:4"/><verse number="5" style="v" sid="ISA 28:5"/>Nan jou sa a, SENYÈ dèzame yo va vini yon bèl <note caller="+" style="x"><char style="xo" closed="false">28:5 </char><char style="xt" closed="false"><ref loc="ISA 62:3">És 62:3</ref></char></note>kouwòn, yon dyadèm ranpli ak glwa pou retay a pèp Li a. <verse eid="ISA 28:5"/><verse number="6" style="v" sid="ISA 28:6"/>Li va yon <note caller="+" style="x"><char style="xo" closed="false">28:6 </char><char style="xt" closed="false"><ref loc="1KI 3:28">I Wa 3:28</ref></char></note>espri lajistis pou sila ki chita nan jijman an, yon ranfòsman pou sila k ap detounen atak devan pòtay yo.<verse eid="ISA 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 28:7"/>Anplis yo vin toudi akoz bwason fò yo: prèt la ak pwofèt la vin toudi ak bwason fò. Yo vin konfonn akoz diven an, e yo vin toudi akoz bwason fò a. Yo kilbite pandan y ap fè <note caller="+" style="x"><char style="xo" closed="false">28:7 </char><char style="xt" closed="false"><ref loc="ISA 29:11">És 29:11</ref> </char></note>vizyon, e yo manke tonbe lè y ap rann jijman. <verse eid="ISA 28:7"/><verse number="8" style="v" sid="ISA 28:8"/>Paske tout tab yo plen ak salte <note caller="+" style="x"><char style="xo" closed="false">28:8 </char><char style="xt" closed="false"><ref loc="JER 48:26">Jr 48:26</ref></char></note>vomisman an; pa menm gen yon kote ki pwòp.<verse eid="ISA 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 28:9"/>A ki moun Li ta enstwi konesans e a kilès Li ta entèprete mesaj la? Sila ki fenk <note caller="+" style="x"><char style="xo" closed="false">28:9 </char><char style="xt" closed="false"><ref loc="PSA 131:2">Sòm 131:2</ref></char></note>sevre nan lèt yo? Sila ki fenk sispann pran tete yo? <verse eid="ISA 28:9"/><verse number="10" style="v" sid="ISA 28:10"/>Paske Li pale, <note caller="+" style="x"><char style="xo" closed="false">28:10 </char><char style="xt" closed="false"><ref loc="2CH 36:15">II Kwo 36:15</ref></char></note> Lòd sou lòd, lòd sou lòd, liy sou liy, liy sou liy, yon ti kras pa isi, yon ti kras pa la.<verse eid="ISA 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 28:11"/>Anverite, Li va pale ak pèp sa a ak <note caller="+" style="x"><char style="xo" closed="false">28:11 </char><char style="xt" closed="false"><ref loc="ISA 33:19">És 33:19</ref></char></note>lèv bege e ak yon lang etranje, <verse eid="ISA 28:11"/><verse number="12" style="v" sid="ISA 28:12"/>Sila ki te di yo: “Men <note caller="+" style="x"><char style="xo" closed="false">28:12 </char><char style="xt" closed="false"><ref loc="ISA 11:10">És 11:10</ref></char></note>repo isit la; bay repo a sila ki fatige yo,” epi: “Men repo”, men yo pa t koute. <verse eid="ISA 28:12"/><verse number="13" style="v" sid="ISA 28:13"/>Akoz sa, pawòl SENYÈ a, yo va: “Lòd sou lòd, lòd sou lòd, liy sou liy, liy sou liy, yon ti kras pa isi, yon ti kras pa la,” pou yo kapab ale, <note caller="+" style="x"><char style="xo" closed="false">28:13 </char><char style="xt" closed="false"><ref loc="ISA 8:15">És 8:15</ref></char></note>chape glise pa dèyè, vin kraze, pran nan pèlen e vin prizonye.<verse eid="ISA 28:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 28:14"/>Pou sa, koute pawòl SENYÈ a, O <note caller="+" style="x"><char style="xo" closed="false">28:14 </char><char style="xt" closed="false"><ref loc="ISA 29:20">És 29:20</ref></char></note>nou menm k ap moke yo, sila ki chèf sou pèp sa a ki rete nan Jérusalem nan: <verse eid="ISA 28:14"/><verse number="15" style="v" sid="ISA 28:15"/>“Akoz nou te di: ‘Nou te fè yon akò ak lanmò’, epi ak Sejou mò yo, nou te vin angaje. Gwo dega p ap rive sou nou lè l pase, paske nou te fè pwotèj nou ak manti e nou te <note caller="+" style="x"><char style="xo" closed="false">28:15 </char><char style="xt" closed="false"><ref loc="ISA 29:15">És 29:15</ref> </char></note>kache kò nou ak desepsyon.” <verse eid="ISA 28:15"/><verse number="16" style="v" sid="ISA 28:16"/>Pou sa, Senyè BONDYE a di: <note caller="+" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="ROM 9:33">Wo 9:33</ref></char></note>“Gade byen, Mwen ap poze nan Sion yon wòch, yon wòch eprèv, yon wòch ang prensipal pou fondasyon ki plase byen solid la. Sila ki kwè nan li a, p ap twouble menm. <verse eid="ISA 28:16"/><verse number="17" style="v" sid="ISA 28:17"/>Mwen va fè <note caller="+" style="x"><char style="xo" closed="false">28:17 </char><char style="xt" closed="false"><ref loc="2KI 21:13">II Wa 21:13</ref></char></note>jistis sèvi kon lign mezi e ladwati kon règ nivo. Lagrèl va bale tout fatra nèt ki fèt ak manti, e dlo yo va debòde antre nan kote sekrè a. <verse eid="ISA 28:17"/><verse number="18" style="v" sid="ISA 28:18"/>Akò nou an ak lanmò va anile, e angajman nou an ak Sejou mò yo p ap kanpe. Lè gwo twoub la k ap kraze tout moun nan, pase kote nou, alò, nou va <note caller="+" style="x"><char style="xo" closed="false">28:18 </char><char style="xt" closed="false"><ref loc="ISA 28:3">És 28:3</ref> </char></note> foule anba l. <verse eid="ISA 28:18"/><verse number="19" style="v" sid="ISA 28:19"/>Otan li pase, li va kenbe nou; maten apre maten, l ap pase. Nenpòt lè pandan lajounen oswa lannwit, pou konprann sa li ye a, va pote gwo laperèz.” <verse eid="ISA 28:19"/><verse number="20" style="v" sid="ISA 28:20"/>Kabann nan twò kout pou lonje kò nou e <note caller="+" style="x"><char style="xo" closed="false">28:20 </char><char style="xt" closed="false"><ref loc="ISA 59:6">És 59:6</ref> </char></note>dra a twò etwat pou vlope nou. <verse eid="ISA 28:20"/><verse number="21" style="v" sid="ISA 28:21"/>Paske SENYÈ a va leve tankou nan Mòn Peratsim. Li va fache tankou nan vale <note caller="+" style="x"><char style="xo" closed="false">28:21 </char><char style="xt" closed="false"><ref loc="JOS 10:10-12">Jos 10:10-12</ref> </char></note>Gabaon, pou fè tach Li, tach ki pa sanblab ak lòt, e pou egzekite travay Li, travay ekstrawòdinè Li. <verse eid="ISA 28:21"/><verse number="22" style="v" sid="ISA 28:22"/>Alò, konsa, pa aji tankou mokè yo, pou chenn ki mare nou yo pa vin pi rèd. Paske mwen te tande soti nan Senyè BONDYE dèzame yo, desizyon deja fèt pou <note caller="+" style="x"><char style="xo" closed="false">28:22 </char><char style="xt" closed="false"><ref loc="ISA 10:22-23">És 10:22-23</ref> </char></note>detwi tout latè a.<verse eid="ISA 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 28:23"/>Prete zòrèy nou pou tande vwa mwen! Koute e tande pawòl mwen yo. <verse eid="ISA 28:23"/><verse number="24" style="v" sid="ISA 28:24"/>Èske kiltivatè a raboure tout tan pou plante grenn semans? Èske li pa janm sispann vire tè a? <verse eid="ISA 28:24"/><verse number="25" style="v" sid="ISA 28:25"/>Èske li pa fè tè a nivo pou simen <note caller="+" style="x"><char style="xo" closed="false">28:25 </char><char style="xt" closed="false"><ref loc="MAT 23:23">Mat 23:23</ref></char></note>grenn lanni, gaye grenn kimen, plante ble nan ranje yolòj nan plas li ak pitimi nan kote pa li? <verse eid="ISA 28:25"/><verse number="26" style="v" sid="ISA 28:26"/>Paske Bondye pa li a enstwi li, e montre li sa ki bon. <verse eid="ISA 28:26"/><verse number="27" style="v" sid="ISA 28:27"/>Paske grenn lanni pa kraze vannen ak <note caller="+" style="x"><char style="xo" closed="false">28:27 </char><char style="xt" closed="false"><ref loc="AMO 1:3">Am 1:3</ref></char></note>gwo baton, ni wou kabwèt pa woule sou kimen, men lanni bat ak yon planch bwa e kimen ak yon baton. <verse eid="ISA 28:27"/><verse number="28" style="v" sid="ISA 28:28"/>Sereyal pou fè pen oblije kraze; anverite, li p ap ka kontinye bat pou vannen li tout tan. Menmsi wou kabwèt li a ak pye cheval li yo ta pase sou li, cheval la pa ka fè l moulen. <verse eid="ISA 28:28"/><verse number="29" style="v" sid="ISA 28:29"/>Sa anplis, sòti nan SENYÈ dèzame yo, ki te fè konsèy Li mèvèye, ak sajès Li <note caller="+" style="x"><char style="xo" closed="false">28:29 </char><char style="xt" closed="false"><ref loc="ISA 31:2">És 31:2</ref> </char></note>byen gran.<verse eid="ISA 28:29"/></para>
  <chapter eid="ISA 28"/>
  <chapter number="29" style="c" sid="ISA 29"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 29:1"/>Malè a Ariel! Ariel, vil kote David yon fwa <note caller="+" style="x"><char style="xo" closed="false">29:1 </char><char style="xt" closed="false"><ref loc="2SA 5:9">II Sam 5:9</ref></char></note>te fè kan an! Ogmante lane sou lane, obsève fèt ou yo nan lè yo. <verse eid="ISA 29:1"/><verse number="2" style="v" sid="ISA 29:2"/>Mwen va mennen gwo pwoblèm sou Ariel e li va vin yon vil <note caller="+" style="x"><char style="xo" closed="false">29:2 </char><char style="xt" closed="false"><ref loc="ISA 3:26">És 3:26</ref></char></note>gwo doulè ak lamantasyon. Pou Mwen, li va tankou yon lotèl k ap brile a. <verse eid="ISA 29:2"/><verse number="3" style="v" sid="ISA 29:3"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">29:3 </char><char style="xt" closed="false"><ref loc="LUK 19:43">Luc 19:43</ref></char></note>fè kan kont ou e antoure ou. Mwen va monte aparèy syèj kont ou e fè yo monte fò batay kont ou. <verse eid="ISA 29:3"/><verse number="4" style="v" sid="ISA 29:4"/>Konsa ou va vin <note caller="+" style="x"><char style="xo" closed="false">29:4 </char><char style="xt" closed="false"><ref loc="ISA 8:19">És 8:19</ref></char></note>bese. Se jis nan tè a, pale ou va bougonnen depi nan pousyè. Vwa ou va, anplis, tankou yon vwa a yon lespri, konsi ou konnen l deja, k ap soti nan tè a. Se konsa pawòl ou yo va chichote soti nan pousyè a.<verse eid="ISA 29:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 29:5"/>Men fòs kantite a lènmi ou yo va devni tankou <note caller="+" style="x"><char style="xo" closed="false">29:5 </char><char style="xt" closed="false"><ref loc="ISA 17:13">És 17:13</ref></char></note>pousyè fen e fòs kantite a mechan san prensip yo va tankou pay k ap vannen ale. Sa va fèt nan yon moman; sibitman. <verse eid="ISA 29:5"/><verse number="6" style="v" sid="ISA 29:6"/>Li va vizite pa SENYÈ dèzame yo. Li va pini yo ak <note caller="+" style="x"><char style="xo" closed="false">29:6 </char><char style="xt" closed="false"><ref loc="1SA 2:10">I Sam 2:10</ref> </char></note>tonnè, tranbleman detè, gwo bri, toubiyon ak tanpèt ak flanm dife a ki manje tout bagay. <verse eid="ISA 29:6"/><verse number="7" style="v" sid="ISA 29:7"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">29:7 </char><char style="xt" closed="false"><ref loc="MIC 4:11-12">Mi 4:11-12</ref></char></note>fòs kantite a tout nasyon ki va fè lagè kont Ariel yo, menm tout moun ki fè lagè kont li ak gwo fò li yo ak sila ki bay li gwo twoub, sa va devni tankou yon rèv, yon vizyon nan nwit. <verse eid="ISA 29:7"/><verse number="8" style="v" sid="ISA 29:8"/>Sa va tankou lè yon nonm grangou fè rèv—e gade byen, l ap manje. Men lè l leve nan dòmi a, gade byen, li toujou fèb e grangou; li pa satisfè. Oswa lè yon nonm swaf fè rev—epi gade byen, l ap bwe, men lè l leve li toujou fèb, e swaf la pa t satisfè. Se <note caller="+" style="x"><char style="xo" closed="false">29:8 </char><char style="xt" closed="false"><ref loc="ISA 8:19">És 8:19</ref></char></note>konsa kantite tout nasyon ki fè lagè kont Mòn Sion yo va ye.<verse eid="ISA 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 29:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">29:9 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 29:1">És 29:1</ref>
      </char>
    </note>Pran reta epi tan! Avegle tèt nou pou nou avèg! Yo vin sou, men pa avèk diven; yo kilbite, men pa akoz bwason fò. <verse eid="ISA 29:9"/><verse number="10" style="v" sid="ISA 29:10"/>Paske SENYÈ a te vide sou nou, yon lespri <note caller="+" style="x"><char style="xo" closed="false">29:10 </char><char style="xt" closed="false"><ref loc="PSA 69:23">Sòm 69:23</ref></char></note>pwofon somèy. Li te fèmen zye nou menm, pwofèt yo, e Li te kouvri tèt nou menm, konseye yo. <verse eid="ISA 29:10"/><verse number="11" style="v" sid="ISA 29:11"/>Tout vizyon va pou nou tankou pawòl a yon <note caller="+" style="x"><char style="xo" closed="false">29:11 </char><char style="xt" closed="false"><ref loc="ISA 8:16">És 8:16</ref></char></note>liv ki fèmen ak so. Lè yo bay li a yon moun ki konn li, yo di l: “Souple, li sa a.” Men li va di: “Mwen pa kapab, paske li fèmen ak so.” <verse eid="ISA 29:11"/><verse number="12" style="v" sid="ISA 29:12"/>Konsa liv la va bay a sila ki pa ka li, e y ap di l: “Souple, li sa a.” Epi li va di: “Mwen pa kapab li.”<verse eid="ISA 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13"/>Senyè a te di: “Akoz <note caller="+" style="x"><char style="xo" closed="false">29:13 </char><char style="xt" closed="false"><ref loc="EZK 33:31">Éz 33:31</ref></char></note>pèp sa a rapwoche ak pawòl pa yo, e onore Mwen ak lèv yo, men yo retire kè yo byen lwen Mwen, e akoz adorasyon yo pou Mwen fèt pa tradisyon ki aprann pa kè, <verse eid="ISA 29:13"/><verse number="14" style="v" sid="ISA 29:14"/>pou sa, gade byen, Mwen va yon fwa ankò aji ak mèvèy pami pèp sa; yon mèvèy ki etonan! Konsa, <note caller="+" style="x"><char style="xo" closed="false">29:14 </char><char style="xt" closed="false"><ref loc="ISA 44:25">És 44:25</ref></char></note>sajès a moun saj pa yo va disparèt, e konesans a moun ki gen bon konprann yo va vin kache.”<verse eid="ISA 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 29:15"/>Malè a sila ki kache plan yo byen fon pou SENYÈ a pa wè, e ki fè <note caller="+" style="x"><char style="xo" closed="false">29:15 </char><char style="xt" closed="false"><ref loc="JOB 22:13">Job 22:13</ref> </char></note>zak yo nan fènwa a, e y ap di: “Se kilès ki wè nou?” Oswa “Se kilès ki rekonèt nou?” <verse eid="ISA 29:15"/><verse number="16" style="v" sid="ISA 29:16"/>Ou chavire bagay la nèt! Èske sila ki fè kanari a ta dwe konsidere egal ak ajil la, pou sa ki te fèt la, ta ka di a sila ki fè li a: “Li pa t fè mwen”; oswa <note caller="+" style="x"><char style="xo" closed="false">29:16 </char><char style="xt" closed="false"><ref loc="ISA 45:9">És 45:9</ref></char></note>sa ki te fòme a ta ka di a sila ki te fòme li a: “Li pa konprann anyen?”<verse eid="ISA 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 29:17"/>Èske se pa yon ti kras tan ki rete ankò avan Liban vin transfòme an yon <note caller="+" style="x"><char style="xo" closed="false">29:17 </char><char style="xt" closed="false"><ref loc="PSA 84:6">Sòm 84:6</ref></char></note>chan fètil, e chan fètil la va konsidere kon yon forè? <verse eid="ISA 29:17"/><verse number="18" style="v" sid="ISA 29:18"/>Nan jou sa a, <note caller="+" style="x"><char style="xo" closed="false">29:18 </char><char style="xt" closed="false"><ref loc="ISA 35:5">És 35:5</ref></char></note>moun soud yo va tande pawòl a liv la e zye avèg yo va wè sa ki te kon fènwa ak tenèb. <verse eid="ISA 29:18"/><verse number="19" style="v" sid="ISA 29:19"/>Anplis, <note caller="+" style="x"><char style="xo" closed="false">29:19 </char><char style="xt" closed="false"><ref loc="PSA 25:9">Sòm 25:9</ref></char></note>moun enb yo va fè kè yo pi kontan ak SENYÈ a, e malere yo pami moun yo va rejwi nan Sila Ki Sen an Israël la. <verse eid="ISA 29:19"/><verse number="20" style="v" sid="ISA 29:20"/>Paske moun san pitye yo va rive nan fen yo, e mokè yo va disparèt. Anverite, <note caller="+" style="x"><char style="xo" closed="false">29:20 </char><char style="xt" closed="false"><ref loc="ISA 59:4">És 59:4</ref></char></note>tout moun ak lentansyon fè mal, va vin koupe retire nèt— <verse eid="ISA 29:20"/><verse number="21" style="v" sid="ISA 29:21"/>sila ki pou valè a yon sèl pawòl, rele moun nan tribinal la, epi fè pyèj pou sila ki korije moun nan pòtay la, e ak fwod, rache dwa inosan an ak fo temwayaj.<verse eid="ISA 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22"/>Akoz sa a, SENYÈ a ki te rachte Abraham nan, di konsènan lakay Jacob: <note caller="+" style="x"><char style="xo" closed="false">29:22 </char><char style="xt" closed="false"><ref loc="ISA 45:17">És 45:17</ref></char></note>“Jacob p ap ankò vin wont, ni figi li vin pal. <verse eid="ISA 29:22"/><verse number="23" style="v" sid="ISA 29:23"/>Men lè li wè <note caller="+" style="x"><char style="xo" closed="false">29:23 </char><char style="xt" closed="false"><ref loc="ISA 49:20-26">És 49:20-26</ref></char></note>pitit li yo, zèv men Mwen yo nan mitan li, yo va sanktifye non Mwen. Anverite, yo va sanktifye non a Sila Ki Sen a Jacob la, e va kanpe byen etone devan Bondye Israël la. <verse eid="ISA 29:23"/><verse number="24" style="v" sid="ISA 29:24"/>Anplis, sila ki fè tò nan panse yo, va <note caller="+" style="x"><char style="xo" closed="false">29:24 </char><char style="xt" closed="false"><ref loc="ISA 41:20">És 41:20</ref></char></note>konnen verite a, e sila ki kritike yo va resevwa enstriksyon.”<verse eid="ISA 29:24"/></para>
  <chapter eid="ISA 29"/>
  <chapter number="30" style="c" sid="ISA 30"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 30:1"/>“Malè a pitit k ap fè rebèl yo”, deklare SENYÈ a: “Sila ki resevwa konsèy, men ki pa pa M; ki <note caller="+" style="x"><char style="xo" closed="false">30:1 </char><char style="xt" closed="false"><ref loc="ISA 8:11-12">És 8:11-12</ref> </char></note>fè yon alyans, men pa nan Lespri pa M, pou ogmante peche sou peche; <verse eid="ISA 30:1"/><verse number="2" style="v" sid="ISA 30:2"/>ki fè wout desann an Égypte san konsilte Mwen, pou yo ka <note caller="+" style="x"><char style="xo" closed="false">30:2 </char><char style="xt" closed="false"><ref loc="ISA 36:9">És 36:9</ref> </char></note>fè azil, pou Farawon bay yo sekirite, e pou yo chache pwotèj nan lonbraj Égypte! <verse eid="ISA 30:2"/><verse number="3" style="v" sid="ISA 30:3"/>Akoz sa, sekirite Farawon va vin <note caller="+" style="x"><char style="xo" closed="false">30:3 </char><char style="xt" closed="false"><ref loc="ISA 20:5-6">És 20:5-6</ref></char></note>wont nou, e pwotèj nan lonbraj Égypte la va fè imilyasyon nou. <verse eid="ISA 30:3"/><verse number="4" style="v" sid="ISA 30:4"/>Paske <note caller="+" style="x"><char style="xo" closed="false">30:4 </char><char style="xt" closed="false"><ref loc="ISA 19:11">És 19:11</ref></char></note>prens pa yo se nan Tsoan e anbasadè pa yo vin parèt nan Hanès. <verse eid="ISA 30:4"/><verse number="5" style="v" sid="ISA 30:5"/>Tout moun va vin <note caller="+" style="x"><char style="xo" closed="false">30:5 </char><char style="xt" closed="false"><ref loc="JER 2:36">Jr 2:36</ref></char></note>wont akoz yon pèp ki p ap ka bay yo okenn avantaj, ni pou sekou, ni pou pwofi, men pou wont, e anplis, pou repwòch.”<verse eid="ISA 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6"/>Pwofesi konsènan bèt nan <note caller="+" style="x"><char style="xo" closed="false">30:6 </char><char style="xt" closed="false"><ref loc="GEN 12:9">Jen 12:9</ref></char></note>dezè Midi yo.</para>
  <para style="p" vid="ISA 30:6">Atravè yon peyi gwo twoub ak gwo doulè, ladan ki sòti manman lyon ak lyon an, vipè ak sèpan volan an; yo pote gwo kantite byen yo sou do jenn bourik, e trezò yo sou do chamo, pou rive kote yon pèp ki pa kapab bay yo okenn avantaj. <verse eid="ISA 30:6"/><verse number="7" style="v" sid="ISA 30:7"/>Paske sekou Égypte, se vanite san rezilta. Akoz sa, Mwen te rele li Rahab ki kanpe janm. <note caller="+" style="x"><char style="xo" closed="false">30:7 </char><char style="xt" closed="false"><ref loc="JOB 9:13">Job 9:13</ref> </char></note> <verse eid="ISA 30:7"/><verse number="8" style="v" sid="ISA 30:8"/>Koulye a, ale, <note caller="+" style="x"><char style="xo" closed="false">30:8 </char><char style="xt" closed="false"><ref loc="ISA 8:1">És 8:1</ref></char></note>ekri li sou yon adwaz devan yo, e enskri li sou yon woulo papye pou l ka sèvi nan tan k ap vini yo. Konsa la sèvi yon temwen jis pou tout tan. <verse eid="ISA 30:8"/><verse number="9" style="v" sid="ISA 30:9"/>Paske sa se yon pèp rebèl, fis manti, fis ki refize <note caller="+" style="x"><char style="xo" closed="false">30:9 </char><char style="xt" closed="false"><ref loc="ISA 1:10">És 1:10</ref> </char></note>koute enstriksyon SENYÈ a; <verse eid="ISA 30:9"/><verse number="10" style="v" sid="ISA 30:10"/>ki di a konseye yo, “Ou pa dwe wè vizyon”, epi a pwofèt yo, “Ou pa dwe pwofetize a nou menm sa ki dwat. <note caller="+" style="x"><char style="xo" closed="false">30:10 </char><char style="xt" closed="false"><ref loc="1KI 22:8-13">I Wa 22:8-13</ref></char></note>Pale nou bèl pawòl dous, pwofetize ilizyon. <verse eid="ISA 30:10"/><verse number="11" style="v" sid="ISA 30:11"/>Sòti nan wout la, <note caller="+" style="x"><char style="xo" closed="false">30:11 </char><char style="xt" closed="false"><ref loc="ACT 13:8">Trav 13:8</ref></char></note>vire sou kote chemen an. Pa kite nou tande menm ankò afè a Sila Ki Sen an Israël la.” <verse eid="ISA 30:11"/><verse number="12" style="v" sid="ISA 30:12"/>Akoz sa, konsa pale Sila Ki Sen an Israël la: <note caller="+" style="x"><char style="xo" closed="false">30:12 </char><char style="xt" closed="false"><ref loc="ISA 5:24">És 5:24</ref></char></note>“Akoz nou te rejte pawòl sa a, e te mete konfyans nou nan opresyon ak desepsyon, e te depann de yo, <verse eid="ISA 30:12"/><verse number="13" style="v" sid="ISA 30:13"/>akoz sa, <note caller="+" style="x"><char style="xo" closed="false">30:13 </char><char style="xt" closed="false"><ref loc="ISA 26:21">És 26:21</ref></char></note>inikite sa a va pou nou kon yon gwo brèch nan miray ki prèt pou tonbe a, yon gwo pati k ap souke nan yon miray ki wo, ki ka pete tonbe <note caller="+" style="x"><char style="xo" closed="false">30:13 </char><char style="xt" closed="false"><ref loc="ISA 29:5">És 29:5</ref> </char></note>sibitman, nan yon enstan. <verse eid="ISA 30:13"/><verse number="14" style="v" sid="ISA 30:14"/>Lè l vin kraze, l ap tankou <note caller="+" style="x"><char style="xo" closed="false">30:14 </char><char style="xt" closed="false"><ref loc="PSA 2:9">Sòm 2:9</ref></char></note>po a mèt kanari a, ki tèlman kraze ak vyolans ke yon mòso cha p ap ka twouve pami mòso yo, ki ta ka menm pote dife sòti nan founo a, oswa kenbe dlo ki sòti nan sitèn nan.”<verse eid="ISA 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 30:15"/>Paske konsa pale Senyè BONDYE a, sèl Sila Ki Sen an Israël la te di: “Nan repantans ak <note caller="+" style="x"><char style="xo" closed="false">30:15 </char><char style="xt" closed="false"><ref loc="PSA 116:7">Sòm 116:7</ref> </char></note>repo, nou va sove. Nan kalm ak konfyans, fòs nou ye.” Men nou pa t vle. <verse eid="ISA 30:15"/><verse number="16" style="v" sid="ISA 30:16"/>Nou te di: “Non, paske nou va sove ale sou <note caller="+" style="x"><char style="xo" closed="false">30:16 </char><char style="xt" closed="false"><ref loc="ISA 2:7">És 2:7</ref> </char></note>cheval”. Akoz sa, nou va sove ale! "Nou va sove ale ak tout vitès”. Konsa, sila ki kouri dèyè ou va vini byen rapid. <verse eid="ISA 30:16"/><verse number="17" style="v" sid="ISA 30:17"/><note caller="+" style="x"><char style="xo" closed="false">30:17 </char><char style="xt" closed="false"><ref loc="LEV 26:36">Lev 26:36</ref></char></note>Mil moun va sove ale menase pa yon sèl moun. Nou va sove ale sou menas a senk moun, jiskaske nou vin lage tankou yon drapo sou yon do mòn; tankou yon siyal k ap limen sou yon kolin.<verse eid="ISA 30:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 30:18"/>Konsa, SENYÈ a ap tan. Li vle fè nou gras pou Li kapab egzalte, pou Li kapab fè nou mizerikòd. Paske SENYÈ a se yon Bondye de jistis. A la beni tout sila k ap tan Li yo beni! <note caller="+" style="x"><char style="xo" closed="false">30:18 </char><char style="xt" closed="false"><ref loc="ISA 8:17">És 8:17</ref> </char></note> <verse eid="ISA 30:18"/><verse number="19" style="v" sid="ISA 30:19"/>Paske moun yo va rete nan Sion, nan Jérusalem. Nou <note caller="+" style="x"><char style="xo" closed="false">30:19 </char><char style="xt" closed="false"><ref loc="ISA 25:8">És 25:8</ref></char></note>p ap kriye ankò. Anverite Li va fè nou gras lè L tande vwa kriye nou. Lè L tande l, Li va reponn nou. <verse eid="ISA 30:19"/><verse number="20" style="v" sid="ISA 30:20"/>Sepandan, Senyè a te bay nou pen advèsite, ak dlo lafliksyon, malgre, pwofesè nou yo, p ap <note caller="+" style="x"><char style="xo" closed="false">30:20 </char><char style="xt" closed="false"><ref loc="PSA 74:9">Sòm 74:9</ref></char></note>kache tèt yo ankò, men zye nou va wè pwofesè nou yo. <verse eid="ISA 30:20"/><verse number="21" style="v" sid="ISA 30:21"/>Nenpòt lè ou vire adwat oswa agoch, zorèy nou va tande yon pawòl dèyè nou: “Sa se chemen an, mache ladann”. <verse eid="ISA 30:21"/><verse number="22" style="v" sid="ISA 30:22"/>Nou va kraze jete limaj taye nou yo ki kouvri ak yon kouch ajàn, ak limaj an lò fon yo. Nou va gaye yo tankou bagay sal. Nou va di yo: “Retire ou la!”<verse eid="ISA 30:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23"/>Epi Li va <note caller="+" style="x"><char style="xo" closed="false">30:23 </char><char style="xt" closed="false"><ref loc="PSA 65:9-13">Sòm 65:9-13</ref></char></note>bay lapli pou grenn semans ke ou simen nan tè a, ak pen ki soti nan rekòlt tè a. Li va bon e li va anpil. Nan jou sa a, bèt nou yo va manje nan yon patiraj byen laj. <verse eid="ISA 30:23"/><verse number="24" style="v" sid="ISA 30:24"/>Anplis, bèf ak bourik ki travay latè yo va manje yon manje bon gou, ki te <note caller="+" style="x"><char style="xo" closed="false">30:24 </char><char style="xt" closed="false"><ref loc="MAT 3:12">Mat 3:12</ref></char></note>vannen ak pèl ak fouchèt. <verse eid="ISA 30:24"/><verse number="25" style="v" sid="ISA 30:25"/>Sou chak mòn ki wo ak chak <note caller="+" style="x"><char style="xo" closed="false">30:25 </char><char style="xt" closed="false"><ref loc="ISA 35:6-7">És 35:6-7</ref></char></note>kolin, va gen sous ki kouri ak dlo nan jou gwo masak la lè fò yo vin tonbe. <verse eid="ISA 30:25"/><verse number="26" style="v" sid="ISA 30:26"/><note caller="+" style="x"><char style="xo" closed="false">30:26 </char><char style="xt" closed="false"><ref loc="ISA 24:23">És 24:23</ref></char></note>Limyè lalin nan va tankou limyè solèy la, e limyè solèy la va sèt fwa pi klere tankou limyè ki pou sèt jou, nan jou ke SENYÈ a geri frakti a pèp Li a e panse blesi ki te frape yo.<verse eid="ISA 30:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ISA 30:27"/>Gade byen, <note caller="+" style="x"><char style="xo" closed="false">30:27 </char><char style="xt" closed="false"><ref loc="ISA 59:19">És 59:19</ref></char></note>non a SENYÈ a sòti yon kote byen lwen. Lakòlè Li plen chalè ak lafimen k ap monte byen pwès. Lèv Li plen ak gwo kòlè e lang Li tankou yon dife k ap brile tout bagay. <verse eid="ISA 30:27"/><verse number="28" style="v" sid="ISA 30:28"/>Souf Li tankou yon flèv k ap debòde, ki rive jis nan kou, pou souke nasyon yo. L ap fè yo ale retou nan yon paswa destriksyon. Yon <note caller="+" style="x"><char style="xo" closed="false">30:28 </char><char style="xt" closed="false"><ref loc="AMO 9:9">Am 9:9</ref></char></note>brid ki mennen nan destriksyon an va plase nan bouch a pèp yo. <verse eid="ISA 30:28"/><verse number="29" style="v" sid="ISA 30:29"/>Konsa, nou va chante tankou nan lannwit la, tankou lè nou rete nan fèt ak kè kontan, tankou lè yon moun ap mache sou son a flit, pou ale nan mòn SENYÈ a, Wòch Israël la. <verse eid="ISA 30:29"/><verse number="30" style="v" sid="ISA 30:30"/>SENYÈ a va fè yo tande vwa otorite Li, bra Li k ap desann ak gwo kòlè, nan flanm dife k ap brile tout bagay la, nan nwaj k ap pete ak gwo lapli ak lagrèl yo. <verse eid="ISA 30:30"/><verse number="31" style="v" sid="ISA 30:31"/>Paske ak vwa SENYÈ a, Assyrie va vin etone nèt. L ap vin frape ak <note caller="+" style="x"><char style="xo" closed="false">30:31 </char><char style="xt" closed="false"><ref loc="ISA 10:26">És 10:26</ref></char></note>baton. <verse eid="ISA 30:31"/><verse number="32" style="v" sid="ISA 30:32"/>Chak kout baton pinisyon ke SENYÈ a mete sou li, va fèt ak mizik a tanbouren ak gita. Li va fè batay ak yo. <note caller="+" style="x"><char style="xo" closed="false">30:32 </char><char style="xt" closed="false"><ref loc="EZK 32:10">Éz 32:10</ref></char></note>L ap rale tout zam yo parèt. Li va goumen kont yo. <verse eid="ISA 30:32"/><verse number="33" style="v" sid="ISA 30:33"/>Paske <note caller="+" style="x"><char style="xo" closed="false">30:33 </char><char style="xt" closed="false"><ref loc="2KI 23:10">II Wa 23:10</ref></char></note>plas pou brile a te prepare depi lontan. Anverite, li te prepare pou wa a. Li te fè l fon e laj, yon boukan ak anpil bwa. Se souf SENYÈ a, tankou yon tòran souf k ap limen dife sou li.<verse eid="ISA 30:33"/></para>
  <chapter eid="ISA 30"/>
  <chapter number="31" style="c" sid="ISA 31"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 31:1"/>Malè a sila ki desann Égypte pou sekou yo,</para>
  <para style="q1" vid="ISA 31:1">ki depann de cheval yo,</para>
  <para style="q1" vid="ISA 31:1">ki fè konfyans a cha yo paske yo anpil,</para>
  <para style="q1" vid="ISA 31:1">ak nan chevalye yo paske yo tèlman fò;</para>
  <para style="q1" vid="ISA 31:1">men yo pa gade sou <note caller="+" style="x"><char style="xo" closed="false">31:1 </char><char style="xt" closed="false"><ref loc="ISA 10:17">És 10:17</ref> </char></note>Sila Ki Sen an Israël la,</para>
  <para style="q1" vid="ISA 31:1">ni chache SENYÈ a!<verse eid="ISA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 31:2"/>Men anplis, Li saj;</para>
  <para style="q1" vid="ISA 31:2">Li va mennen dezas;</para>
  <para style="q1" vid="ISA 31:2">Li <note caller="+" style="x"><char style="xo" closed="false">31:2 </char><char style="xt" closed="false"><ref loc="NUM 23:19">Nonb 23:19</ref></char></note>p ap retire pawòl Li menm;</para>
  <para style="q1" vid="ISA 31:2">men Li va leve kont kay malfektè yo,</para>
  <para style="q1" vid="ISA 31:2">ak kont sekou a sila ki fè mechanste yo.<verse eid="ISA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 31:3"/>Alò, Ejipsyen yo se <note caller="+" style="x"><char style="xo" closed="false">31:3 </char><char style="xt" closed="false"><ref loc="EZK 28:9">Éz 28:9</ref></char></note>moun.</para>
  <para style="q1" vid="ISA 31:3">Se pa Bondye.</para>
  <para style="q1" vid="ISA 31:3">Cheval yo se chè; se pa lespri.</para>
  <para style="q1" vid="ISA 31:3">Pou sa, SENYÈ la va lonje men L;</para>
  <para style="q1" vid="ISA 31:3">sila k ap bay sekou a va glise tonbe.</para>
  <para style="q1" vid="ISA 31:3">Sila ki resevwa sekou a va tonbe,</para>
  <para style="q1" vid="ISA 31:3">e yo tout va rive fini ansanm.<verse eid="ISA 31:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 31:4"/>Paske konsa SENYÈ a di mwen:</para>
  <para style="q1" vid="ISA 31:4">“Tankou lyon oswa jenn lyon gwonde sou kò bèt l ap manje,</para>
  <para style="q1" vid="ISA 31:4">lè yon bann bèje vin parèt la;</para>
  <para style="q1" vid="ISA 31:4">li p ap pè vwa yo,</para>
  <para style="q1" vid="ISA 31:4">ni li p ap deranje akoz bri yo fè.</para>
  <para style="q1" vid="ISA 31:4">Konsa, SENYÈ dèzame yo va vin desann</para>
  <para style="q1" vid="ISA 31:4">pou <note caller="+" style="x"><char style="xo" closed="false">31:4 </char><char style="xt" closed="false"><ref loc="ISA 42:13">És 42:13</ref></char></note>fè lagè sou Mòn Sion ak sou kolin li an.”<verse eid="ISA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 31:5"/>Tankou zwazo k ap vole,</para>
  <para style="q1" vid="ISA 31:5">se konsa SENYÈ a va pwoteje Jérusalem.</para>
  <para style="q1" vid="ISA 31:5">Li va <note caller="+" style="x"><char style="xo" closed="false">31:5 </char><char style="xt" closed="false"><ref loc="ISA 37:35">És 37:35</ref></char></note>pwoteje li e delivre li.</para>
  <para style="q1" vid="ISA 31:5">Li va pase sou sa pou sove li.<verse eid="ISA 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 31:6"/>Retounen kote Sila ke nou te <note caller="+" style="x"><char style="xo" closed="false">31:6 </char><char style="xt" closed="false"><ref loc="ISA 1:2-5">És 1:2-5</ref> </char></note>tèlman neglije a, O fis Israël yo.<verse eid="ISA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 31:7"/>Paske nan jou sa a, tout moun</para>
  <para style="q1" vid="ISA 31:7">va jete deyò zidòl an ajan li yo ak zidòl an lò li yo,</para>
  <para style="q1" vid="ISA 31:7">ke <note caller="+" style="x"><char style="xo" closed="false">31:7 </char><char style="xt" closed="false"><ref loc="1KI 12:30">I Wa 12:30</ref> </char></note>men plen peche nou yo te fè pou nou.<verse eid="ISA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 31:8"/>Epi Asiryen an va tonbe pa yon nepe ki pa t pou lòm,</para>
  <para style="q1" vid="ISA 31:8">e <note caller="+" style="x"><char style="xo" closed="false">31:8 </char><char style="xt" closed="false"><ref loc="ISA 66:16">És 66:16</ref></char></note>nepe a ki pa pou lòm va devore l.</para>
  <para style="q1" vid="ISA 31:8">Pou sa, li p ap chape anba nepe a,</para>
  <para style="q1" vid="ISA 31:8">e jenn mesye li yo va devni ouvriye kòve.<verse eid="ISA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 31:9"/>“Wòch li va disparèt akoz panik,</para>
  <para style="q1" vid="ISA 31:9">e prens li yo va gen gwo lakrent devan drapo a”,</para>
  <para style="q1" vid="ISA 31:9">deklare SENYÈ a,</para>
  <para style="q1" vid="ISA 31:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">31:9 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 10:16-17">És 10:16-17</ref>
      </char>
    </note>Sila ki gen dife Li nan Sion an,</para>
  <para style="q1" vid="ISA 31:9">ak founo nan Jérusalem nan.<verse eid="ISA 31:9"/></para>
  <chapter eid="ISA 31"/>
  <chapter number="32" style="c" sid="ISA 32"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 32:1"/>Gade byen, yon <note caller="+" style="x"><char style="xo" closed="false">32:1 </char><char style="xt" closed="false"><ref loc="PSA 72:1-4">Sòm 72:1-4</ref></char></note>wa va renye ak ladwati</para>
  <para style="q1" vid="ISA 32:1">e prens yo va renye ak jistis.<verse eid="ISA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 32:2"/>Yon nonm va tankou yon abri kont van</para>
  <para style="q1" vid="ISA 32:2">ak yon pwotèj kont tanpèt,</para>
  <para style="q1" vid="ISA 32:2">tankou sous dlo nan yon peyi sèch,</para>
  <para style="q1" vid="ISA 32:2">tankou <note caller="+" style="x"><char style="xo" closed="false">32:2 </char><char style="xt" closed="false"><ref loc="ISA 4:6">És 4:6</ref></char></note>lonbraj a yon gwo wòch nan yon peyi ki deseche.<verse eid="ISA 32:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 32:3"/>Alò, zye a sila ki wè yo, p ap vin avegle;</para>
  <para style="q1" vid="ISA 32:3">zòrèy a sila ki tande yo, va koute.<verse eid="ISA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 32:4"/>Kè a sila ki <note caller="+" style="x"><char style="xo" closed="false">32:4 </char><char style="xt" closed="false"><ref loc="ISA 29:24">És 29:24</ref></char></note>aji san reflechi a va konprann verite,</para>
  <para style="q1" vid="ISA 32:4">e lang lan a sila ki bege a va pale klè.<verse eid="ISA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 32:5"/>Li p ap rive ankò ke yo rele <note caller="+" style="x"><char style="xo" closed="false">32:5 </char><char style="xt" closed="false"><ref loc="1SA 25:25">I Sam 25:25</ref></char></note>moun fou, prens;</para>
  <para style="q1" vid="ISA 32:5">ni rele vakabon, moun bon kè.<verse eid="ISA 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 32:6"/>Paske moun fou a pale foli,</para>
  <para style="q1" vid="ISA 32:6">e kè li apiye vè mechanste:</para>
  <para style="q1" vid="ISA 32:6">pou fè sa ki kont Bondye</para>
  <para style="q1" vid="ISA 32:6">e pale mal kont SENYÈ a,</para>
  <para style="q1" vid="ISA 32:6">pou <note caller="+" style="x"><char style="xo" closed="false">32:6 </char><char style="xt" closed="false"><ref loc="ISA 3:15">És 3:15</ref> </char></note>kenbe moun grangou a san satisfè,</para>
  <para style="q1" vid="ISA 32:6">e pou anpeche moun swaf la bwè.<verse eid="ISA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 32:7"/>Pou vakabon an, zam li se mechanste.</para>
  <para style="q1" vid="ISA 32:7">Li <note caller="+" style="x"><char style="xo" closed="false">32:7 </char><char style="xt" closed="false"><ref loc="JER 5:26-28">Jr 5:26-28</ref></char></note>fòme plan mechan pou detwi moun aflije a ak kout lang,</para>
  <para style="q1" vid="ISA 32:7">malgre sila ki nan bezwen an pale sa ki bon.<verse eid="ISA 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 32:8"/>Men <note caller="+" style="x"><char style="xo" closed="false">32:8 </char><char style="xt" closed="false"><ref loc="PRO 11:25">Pwov 11:25</ref></char></note>sila ki prens toujou fòme plan ki bèl;</para>
  <para style="q1" vid="ISA 32:8">epi pa bèl plan an, ap kanpe.<verse eid="ISA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 32:9"/>Leve ou menm, O <note caller="+" style="x"><char style="xo" closed="false">32:9 </char><char style="xt" closed="false"><ref loc="ISA 47:8">És 47:8</ref></char></note>fanm ki alèz e tande vwa mwen!</para>
  <para style="q1" vid="ISA 32:9">Prete zòrèy a pawòl mwen, fi ki alèz, san pwoblèm yo.<verse eid="ISA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 32:10"/>Nan yon ane ak kèk jou, nou va twouble,</para>
  <para style="q1" vid="ISA 32:10">O fi ki san pridans yo;</para>
  <para style="q1" vid="ISA 32:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">32:10 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:5-6">És 5:5-6</ref>
      </char>
    </note>paske, afè fwi diven an va fini,</para>
  <para style="q1" vid="ISA 32:10">ni rekòlt la p ap rive.<verse eid="ISA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 32:11"/>Tranble, fanm alèz yo;</para>
  <para style="q1" vid="ISA 32:11">twouble, nou menm ki san pridans!</para>
  <para style="q1" vid="ISA 32:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">32:11 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 47:2">És 47:2</ref> </char>
    </note>Retire rad nou, dezabiye nou</para>
  <para style="q1" vid="ISA 32:11">e mete twal sak nan senti nou.<verse eid="ISA 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 32:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">32:12 </char>
      <char style="xt" closed="false">
        <ref loc="NAM 2:7">Na 2:7</ref>
      </char>
    </note>Bat lestomak nou pou bèl chan jaden yo,</para>
  <para style="q1" vid="ISA 32:12">pou chan ki plen ak fwi rezen yo.<verse eid="ISA 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 32:13"/>Anplis<note caller="+" style="x"><char style="xo" closed="false">32:13 </char><char style="xt" closed="false"><ref loc="ISA 5:6-17">És 5:6-17</ref></char></note>pou peyi a pèp mwen an,</para>
  <para style="q1" vid="ISA 32:13">kote pikan ak raje va pouse monte;</para>
  <para style="q1" vid="ISA 32:13">wi pou tout kay plen ak jwa yo</para>
  <para style="q1" vid="ISA 32:13">ak gran vil kè kontan yo.<verse eid="ISA 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 32:14"/>Paske <note caller="+" style="x"><char style="xo" closed="false">32:14 </char><char style="xt" closed="false"><ref loc="ISA 13:22">És 13:22</ref></char></note>palè a vin vid,</para>
  <para style="q1" vid="ISA 32:14">e gran vil plen moun yo vin abandone.</para>
  <para style="q1" vid="ISA 32:14">Kolin ak fò ki wo yo vin tounen kav yo jis pou tout tan,</para>
  <para style="q1" vid="ISA 32:14">yon plezi pou bourik mawon,</para>
  <para style="q1" vid="ISA 32:14">yon patiraj pou bann mouton yo;<verse eid="ISA 32:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 32:15"/>jiskaske <note caller="+" style="x"><char style="xo" closed="false">32:15 </char><char style="xt" closed="false"><ref loc="ISA 11:2">És 11:2</ref></char></note>Lespri a vide sou nou soti anwo,</para>
  <para style="q1" vid="ISA 32:15">epi savann nan vin fè yon chan fètil,</para>
  <para style="q1" vid="ISA 32:15">e chan fètil la va vin konsidere kon yon forè.<verse eid="ISA 32:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 32:16"/>Nan lè sa a <note caller="+" style="x"><char style="xo" closed="false">32:16 </char><char style="xt" closed="false"><ref loc="ISA 33:5">És 33:5</ref></char></note>lajistis va demere nan dezè a</para>
  <para style="q1" vid="ISA 32:16">e ladwati nan chan fètil la.<verse eid="ISA 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 32:17"/>Epi <note caller="+" style="x"><char style="xo" closed="false">32:17 </char><char style="xt" closed="false"><ref loc="PSA 72:2-3">Sòm 72:2-3</ref></char></note>zèv ladwati a va lapè,</para>
  <para style="q1" vid="ISA 32:17">e sèvis ladwati a va kalm ak konfyans</para>
  <para style="q1" vid="ISA 32:17">k ap dire jis pou tout tan.<verse eid="ISA 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 32:18"/>Nan lè sa a, pèp mwen an va viv nan yon abitasyon lapè,</para>
  <para style="q1" vid="ISA 32:18">ak sekirite ki san twoub nan plas repo san pwoblèm.<verse eid="ISA 32:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 32:19"/>Malgre lagrèl tonbe kraze forè a, e <note caller="+" style="x"><char style="xo" closed="false">32:19 </char><char style="xt" closed="false"><ref loc="ISA 24:10-12">És 24:10-12</ref></char></note>gran vil la va vin devaste nèt.<verse eid="ISA 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 32:20"/>A la <note caller="+" style="x"><char style="xo" closed="false">32:20 </char><char style="xt" closed="false"><ref loc="ECC 11:1">Ekl 11:1</ref></char></note>beni nou va beni,</para>
  <para style="q1" vid="ISA 32:20">nou menm ki simen akote tout dlo yo,</para>
  <para style="q1" vid="ISA 32:20">ki lage pye bèf ak bourik la.<verse eid="ISA 32:20"/></para>
  <chapter eid="ISA 32"/>
  <chapter number="33" style="c" sid="ISA 33"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 33:1"/>Malè a ou menm, O ou ki detwi lòt pandan ou pa t detwi;</para>
  <para style="q1" vid="ISA 33:1">epi sila ki fè trèt pandan lòt moun pa t aji an trèt avè w.</para>
  <para style="q1" vid="ISA 33:1">Depi ou fin detwi, ou osi va vin detwi nèt.</para>
  <para style="q1" vid="ISA 33:1">Depi ou fin fè trèt, lòt moun va <note caller="+" style="x"><char style="xo" closed="false">33:1 </char><char style="xt" closed="false"><ref loc="JER 25:12-14">Jr 25:12-14</ref> </char></note>fè trèt kont ou.<verse eid="ISA 33:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 33:2"/>O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">33:2 </char><char style="xt" closed="false"><ref loc="ISA 30:18-19">És 30:18-19</ref></char></note>fè nou gras. Nou t ap tann Ou.</para>
  <para style="q1" vid="ISA 33:2">Sèvi kon fòs pa nou chak maten,</para>
  <para style="q1" vid="ISA 33:2">delivrans pa nou nan tan gwo twoub.<verse eid="ISA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 33:3"/>Lè bri zen an vin leve, <note caller="+" style="x"><char style="xo" closed="false">33:3 </char><char style="xt" closed="false"><ref loc="ISA 17:13">És 17:13</ref></char></note>pèp yo sove ale.</para>
  <para style="q1" vid="ISA 33:3">Lè Ou fè leve Ou menm, nasyon yo gaye.<verse eid="ISA 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 33:4"/>Piyaj pa W va ranmase tankou cheni ranmase.</para>
  <para style="q1" vid="ISA 33:4">Tankou krikèt volan konn vòltije, se konsa y ap vòltije sou li.<verse eid="ISA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 33:5"/>SENYÈ a leve wo, paske se anwo ke Li rete.</para>
  <para style="q1" vid="ISA 33:5">Li te <note caller="+" style="x"><char style="xo" closed="false">33:5 </char><char style="xt" closed="false"><ref loc="ISA 1:26">És 1:26</ref></char></note>ranpli Sion ak jistis ak ladwati.<verse eid="ISA 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 33:6"/>Se Li k ap fè tan pa nou estab, <note caller="+" style="x"><char style="xo" closed="false">33:6 </char><char style="xt" closed="false"><ref loc="ISA 45:17">És 45:17</ref></char></note>richès a delivrans, sajès ak konesans.</para>
  <para style="q1" vid="ISA 33:6">Lakrent SENYÈ a se trezò ou.<verse eid="ISA 33:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 33:7"/>Gade byen, mesye pwisan pa yo, kriye nan lari,</para>
  <para style="q1" vid="ISA 33:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">33:7 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 18:18-37">II Wa 18:18-37</ref> </char>
    </note>anbasadè lapè yo kriye fò.<verse eid="ISA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 33:8"/>Gran chemen yo rete vid.</para>
  <para style="q1" vid="ISA 33:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">33:8 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 35:8">És 35:8</ref>
      </char>
    </note>Moun ki vwayaje yo sispann.</para>
  <para style="q1" vid="ISA 33:8">Li te kase akò a.</para>
  <para style="q1" vid="ISA 33:8">Li te meprize vil yo.</para>
  <para style="q1" vid="ISA 33:8">Li pa respekte pèsòn.<verse eid="ISA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 33:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">33:9 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 3:26">És 3:26</ref>
      </char>
    </note>Peyi a kriye ak doulè, ak kè fennen.</para>
  <para style="q1" vid="ISA 33:9">Liban vin wont e tanme disparèt.</para>
  <para style="q1" vid="ISA 33:9">Saron vin tankou yon dezè e Basan ak Carmel pèdi tout fèyaj.<verse eid="ISA 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 33:10"/>“Koulye a, <note caller="+" style="x"><char style="xo" closed="false">33:10 </char><char style="xt" closed="false"><ref loc="PSA 12:5">Sòm 12:5</ref></char></note>Mwen va leve”, SENYÈ a di:</para>
  <para style="q1" vid="ISA 33:10">“Koulye a Mwen va egzalte.</para>
  <para style="q1" vid="ISA 33:10">Koulye a Mwen va leve wo.<verse eid="ISA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 33:11"/>Nou te ansent pay, e nou va akouche pay.</para>
  <para style="q1" vid="ISA 33:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">33:11 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:31">És 1:31</ref>
      </char>
    </note> Souf Mwen va manje nou tankou dife.<verse eid="ISA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 33:12"/>Pèp yo va brile kon lacho,</para>
  <para style="q1" vid="ISA 33:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">33:12 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 23:6-7">II Sam 23:6-7</ref> </char>
    </note>tankou pikan koupe ki fin brile nan dife a.”<verse eid="ISA 33:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 33:13"/>“Nou menm ki lwen yo, <note caller="+" style="x"><char style="xo" closed="false">33:13 </char><char style="xt" closed="false"><ref loc="PSA 48:10">Sòm 48:10</ref></char></note> koute sa ke M te fè a;</para>
  <para style="q1" vid="ISA 33:13">epi nou menm ki toupre, rekonèt pwisans Mwen.”<verse eid="ISA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 33:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">33:14 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:28">És 1:28</ref>
      </char>
    </note>Pechè Sion yo vin sezi ak laperèz;</para>
  <para style="q1" vid="ISA 33:14">tranbleman fin sezi enkwayan yo.</para>
  <para style="q1" vid="ISA 33:14">Se kilès pami nou ki ka viv ak yon dife ki manje tout bagay?</para>
  <para style="q1" vid="ISA 33:14">“Se kilès nan nou ki ka viv ak dife k ap brile tou tan an?”<verse eid="ISA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 33:15"/>Sila ki mache nan ladwati a e ki pale ak kè sensè a?</para>
  <para style="q1" vid="ISA 33:15">Sila ki refize benefis lajan ki sòti nan enjistis la,</para>
  <para style="q1" vid="ISA 33:15">e ki souke men l pou sa ki vèse anba tab pa rete nan yo;</para>
  <para style="q1" vid="ISA 33:15">sila ki bouche zòrèy li pou l pa menm tande afè vèse san,</para>
  <para style="q1" vid="ISA 33:15">e ki <note caller="+" style="x"><char style="xo" closed="false">33:15 </char><char style="xt" closed="false"><ref loc="PSA 119:37">Sòm 119:37</ref> </char></note>fèmen zye l pou l pa gade mal.<verse eid="ISA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 33:16"/>Li va demere nan wotè yo;</para>
  <para style="q1" vid="ISA 33:16">
    <note caller="+" style="x">
      <char style="xo" closed="false">33:16 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 25:4">És 25:4</ref>
      </char>
    </note>pwotèj pa li va nan wòch solid ke lènmi yo pa ka pwoche.</para>
  <para style="q1" vid="ISA 33:16">Pen li va vèse bay li, e dlo li va asire.<verse eid="ISA 33:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 33:17"/>Zye nou va wè Wa a nan tout bèlte Li.</para>
  <para style="q1" vid="ISA 33:17">Yo va wè <note caller="+" style="x"><char style="xo" closed="false">33:17 </char><char style="xt" closed="false"><ref loc="ISA 26:15">És 26:15</ref> </char></note>yon peyi ki byen lwen.<verse eid="ISA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 33:18"/>Kè ou va medite sou gwo laperèz la.</para>
  <para style="q1" vid="ISA 33:18">“Kote sila ki te konte a?</para>
  <para style="q1" vid="ISA 33:18">Kote sila ki te peze a?</para>
  <para style="q1" vid="ISA 33:18">Kote sila ki te konte fò yo?”<verse eid="ISA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 33:19"/>Ou p ap ankò wè yon pèp fewòs,</para>
  <para style="q1" vid="ISA 33:19">yon pèp ak <note caller="+" style="x"><char style="xo" closed="false">33:19 </char><char style="xt" closed="false"><ref loc="DEU 28:49-50">Det 28:49-50</ref></char></note>langaj dwòl ke ou pa konprann,</para>
  <para style="q1" vid="ISA 33:19">a lang bege ke pèsòn pa konprann.<verse eid="ISA 33:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 33:20"/>Gade sou Sion, gran vil a gwo fèt dezinye yo.</para>
  <para style="q1" vid="ISA 33:20">Zye ou va wè Jérusalem, yon abitasyon san twoub,</para>
  <para style="q1" vid="ISA 33:20">yon <note caller="+" style="x"><char style="xo" closed="false">33:20 </char><char style="xt" closed="false"><ref loc="ISA 54:2">És 54:2</ref> </char></note>tant ki p ap bezwen pliye.</para>
  <para style="q1" vid="ISA 33:20">Pikèt li p ap janm rache,</para>
  <para style="q1" vid="ISA 33:20">ni kòd li yo p ap chire.<verse eid="ISA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 33:21"/>Men la, SENYÈ va avèk nou nan majeste,</para>
  <para style="q1" vid="ISA 33:21">yon <note caller="+" style="x"><char style="xo" closed="false">33:21 </char><char style="xt" closed="false"><ref loc="ISA 41:18">És 41:18</ref></char></note>kote ak rivyè ak gwo kanal,</para>
  <para style="q1" vid="ISA 33:21">sou sila gwo kannòt ak anpil zaviwon p ap janm pase,</para>
  <para style="q1" vid="ISA 33:21">ni gwo bato p ap janm pase la.<verse eid="ISA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 33:22"/>Paske SENYÈ a se <note caller="+" style="x"><char style="xo" closed="false">33:22 </char><char style="xt" closed="false"><ref loc="ISA 2:4">És 2:4</ref></char></note>jij nou.</para>
  <para style="q1" vid="ISA 33:22">Se SENYÈ a ki bay lwa nou yo.</para>
  <para style="q1" vid="ISA 33:22">Se SENYÈ a ki wa nou.</para>
  <para style="q1" vid="ISA 33:22">Se Li menm ki va sove nou.<verse eid="ISA 33:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 33:23"/>Kòd vwal nou yo vin lach.</para>
  <para style="q1" vid="ISA 33:23">Yo p at ka soutini baz ma bato a byen,</para>
  <para style="q1" vid="ISA 33:23">ni kenbe vwal la gran ouvri.</para>
  <para style="q1" vid="ISA 33:23">Alò, piyaj la a gwo boutin nan te divize.</para>
  <para style="q1" vid="ISA 33:23">
    <note caller="+" style="x">
      <char style="xo" closed="false">33:23 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 7:8">II Wa 7:8</ref>
      </char>
    </note>Sila ki bwate a te pran piyaj la.<verse eid="ISA 33:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 33:24"/>Pèp peyi a pa p di: “Mwen malad”.</para>
  <para style="q1" vid="ISA 33:24">Moun ki rete la yo va padone pou inikite yo.<verse eid="ISA 33:24"/></para>
  <chapter eid="ISA 33"/>
  <chapter number="34" style="c" sid="ISA 34"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 34:1"/>Rapwoche, O nasyon yo pou tande!</para>
  <para style="q1" vid="ISA 34:1">Koute, o pèp yo!</para>
  <para style="q1" vid="ISA 34:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">34:1 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:1">Det 32:1</ref>
      </char>
    </note>Kite latè ak tout sa ki ladann tande,</para>
  <para style="q1" vid="ISA 34:1">e lemonn ak tout sa ki ladann.<verse eid="ISA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 34:2"/>Paske <note caller="+" style="x"><char style="xo" closed="false">34:2 </char><char style="xt" closed="false"><ref loc="ISA 26:20">És 26:20</ref></char></note>gwo kòlè SENYÈ a kont tout nasyon yo</para>
  <para style="q1" vid="ISA 34:2">e jijman Li brile kont tout lame yo.</para>
  <para style="q1" vid="ISA 34:2">Li te detwi yo nèt.</para>
  <para style="q1" vid="ISA 34:2">Li te donnen yo a yon gwo masak.<verse eid="ISA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 34:3"/>Konsa, mò yo va <note caller="+" style="x"><char style="xo" closed="false">34:3 </char><char style="xt" closed="false"><ref loc="ISA 14:9">És 14:9</ref></char></note>jete deyò.</para>
  <para style="q1" vid="ISA 34:3">Kadav yo va fè movèz odè,</para>
  <para style="q1" vid="ISA 34:3">e mòn yo va tranpe ak san yo.<verse eid="ISA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 34:4"/>Tout lame syèl la va vin efase.</para>
  <para style="q1" vid="ISA 34:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">34:4 </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:12-14">Rev 6:12-14</ref>
      </char>
    </note>Syèl la va woule monte tankou yon woulo liv;</para>
  <para style="q1" vid="ISA 34:4">e tout lame li yo va vin fennen nèt,</para>
  <para style="q1" vid="ISA 34:4">tankou yon fèy ta fennen sou branch chan rezen an,</para>
  <para style="q1" vid="ISA 34:4">oswa jan li deseche tonbe sou yon pye fig.<verse eid="ISA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 34:5"/>Paske <note caller="+" style="x"><char style="xo" closed="false">34:5 </char><char style="xt" closed="false"><ref loc="DEU 32:41-42">Det 32:41-42</ref></char></note>nepe Mwen bwe ase nan syèl la.</para>
  <para style="q1" vid="ISA 34:5">Gade byen, li va desann pou jije Édom</para>
  <para style="q1" vid="ISA 34:5">ak pèp ke Mwen te chwazi pou destriksyon yo.<verse eid="ISA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 34:6"/>Nepe SENYÈ a plen ak san.</para>
  <para style="q1" vid="ISA 34:6">Li kouvri ak grès, ak san jenn mouton,</para>
  <para style="q1" vid="ISA 34:6">ak bouk yo, ak grès a ren belye.</para>
  <para style="q1" vid="ISA 34:6">Paske SENYÈ a gen yon sakrifis nan <note caller="+" style="x"><char style="xo" closed="false">34:6 </char><char style="xt" closed="false"><ref loc="ISA 63:1">És 63:1</ref></char></note>Botsra,</para>
  <para style="q1" vid="ISA 34:6">ak yon gwo masak nan peyi Édom.<verse eid="ISA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 34:7"/>Anplis, bèf mawon va desann ak yo,</para>
  <para style="q1" vid="ISA 34:7">ak jenn towo, ak towo pwisan yo.</para>
  <para style="q1" vid="ISA 34:7">Konsa, peyi yo va <note caller="+" style="x"><char style="xo" closed="false">34:7 </char><char style="xt" closed="false"><ref loc="ISA 63:6">És 63:6</ref></char></note>tranpe ak san,</para>
  <para style="q1" vid="ISA 34:7">e pousyè yo va vin gra ak grès.<verse eid="ISA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 34:8"/>Paske SENYÈ a gen yon jou vanjans,</para>
  <para style="q1" vid="ISA 34:8">yon ane vanjans pou koz a Sion an.<verse eid="ISA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 34:9"/>Sous dlo li yo va devni goudwon</para>
  <para style="q1" vid="ISA 34:9">e tè pousyè li kon <note caller="+" style="x"><char style="xo" closed="false">34:9 </char><char style="xt" closed="false"><ref loc="DEU 29:23">Det 29:23</ref></char></note>souf.</para>
  <para style="q1" vid="ISA 34:9">Peyi li va tounen goudwon k ap brile.<verse eid="ISA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 34:10"/>Li p ap etenn ni lajounen, ni lannwit.</para>
  <para style="q1" vid="ISA 34:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">34:10 </char>
      <char style="xt" closed="false">
        <ref loc="REV 14:11">Rev 14:11</ref>
      </char>
    </note>Lafimen li va monte jis pou tout tan.</para>
  <para style="q1" vid="ISA 34:10">De jenerasyon an jenerasyon, li va dezole.</para>
  <para style="q1" vid="ISA 34:10">Okenn moun p ap pase ladann</para>
  <para style="q1" vid="ISA 34:10">pou tout tan e pou tout tan.<verse eid="ISA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 34:11"/>Men <note caller="+" style="x"><char style="xo" closed="false">34:11 </char><char style="xt" closed="false"><ref loc="ZEP 2:14">So 2:14</ref></char></note>grangozye ak ti bèt atè a va vin posede li</para>
  <para style="q1" vid="ISA 34:11">e ibou ak kònèy a va demere ladann.</para>
  <para style="q1" vid="ISA 34:11">Li va tann sou li lign latwoublay,</para>
  <para style="q1" vid="ISA 34:11">ak fil a plon vid la.<verse eid="ISA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 34:12"/>Yo va rele prens li yo a wayòm nan,</para>
  <para style="q1" vid="ISA 34:12">men<note caller="+" style="x"><char style="xo" closed="false">34:12 </char><char style="xt" closed="false"><ref loc="JER 27:20">Jr 27:20</ref></char></note>p ap gen k ap parèt.</para>
  <para style="q1" vid="ISA 34:12">Tout prens li yo p ap anyen.<verse eid="ISA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 34:13"/>Pikan yo va pouse nan gwo fò li yo,</para>
  <para style="q1" vid="ISA 34:13">chadwon ak gwo raje nan <note caller="+" style="x"><char style="xo" closed="false">34:13 </char><char style="xt" closed="false"><ref loc="ISA 13:22">És 13:22</ref></char></note>gwo vil ranfòse yo.</para>
  <para style="q1" vid="ISA 34:13">L ap devni yon kote frekante pa chen mawon.</para>
  <para style="q1" vid="ISA 34:13">Li va fè kay tribinal pou otrich la.<verse eid="ISA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 34:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">34:14 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 13:21">És 13:21</ref>
      </char>
    </note>Bèt dezè yo va fè reyinyon ak lou yo;</para>
  <para style="q1" vid="ISA 34:14">kabrit sovaj ak gwo plim va kriye anvè parèy li.</para>
  <para style="q1" vid="ISA 34:14">Wi, gwo bèt lannwit va vin rete la;</para>
  <para style="q1" vid="ISA 34:14">l ap twouve pou kont li yon kote pou l ka repoze.<verse eid="ISA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 34:15"/>La, koulèv pyebwa a va fè nich li pou ponn ze;</para>
  <para style="q1" vid="ISA 34:15">li va kale yo e ranmase yo anba pwotèj li.</para>
  <para style="q1" vid="ISA 34:15">Menm <note caller="+" style="x"><char style="xo" closed="false">34:15 </char><char style="xt" closed="false"><ref loc="DEU 14:13">Det 14:13</ref> </char></note>bèt malfini yo va rankontre la,</para>
  <para style="q1" vid="ISA 34:15">yo chak ak pwòp parèy yo.<verse eid="ISA 34:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 34:16"/>Chache nan liv SENYÈ a, epi li:</para>
  <para style="q1" vid="ISA 34:16">Nanpwen youn nan sila yo ki p ap la;</para>
  <para style="q1" vid="ISA 34:16">okenn p ap manke parèy yo.</para>
  <para style="q1" vid="ISA 34:16">Paske <note caller="+" style="x"><char style="xo" closed="false">34:16 </char><char style="xt" closed="false"><ref loc="ISA 1:20">És 1:20</ref> </char></note>bouch Mwen te pase lòd,</para>
  <para style="q1" vid="ISA 34:16">e Lespri Li te ranmase yo.<verse eid="ISA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 34:17"/>Li te <note caller="+" style="x"><char style="xo" closed="false">34:17 </char><char style="xt" closed="false"><ref loc="ISA 17:13">És 17:13</ref></char></note>tire osò pou yo,</para>
  <para style="q1" vid="ISA 34:17">e se men L ki separe bay yo selon lign mezi a.</para>
  <para style="q1" vid="ISA 34:17">Yo va posede kote a jis pou tout tan.</para>
  <para style="q1" vid="ISA 34:17">De jenerasyon an jenerasyon, yo va abite ladann.<verse eid="ISA 34:17"/></para>
  <para style="b"/>
  <chapter eid="ISA 34"/>
  <chapter number="35" style="c" sid="ISA 35"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 35:1"/>Savann nan ak dezè a va kontan.</para>
  <para style="q1" vid="ISA 35:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">35:1 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 41:19">És 41:19</ref>
      </char>
    </note>Tè dezole a va rejwi e flèri, tankou yon woz.<verse eid="ISA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 35:2"/>Li va fleri anpil, rejwi ak kè kontan,</para>
  <para style="q1" vid="ISA 35:2">e fè yon kri lajwa.</para>
  <para style="q1" vid="ISA 35:2">Glwa Liban an va bay a li menm;</para>
  <para style="q1" vid="ISA 35:2">majeste a Carmen ak Saron an.</para>
  <para style="q1" vid="ISA 35:2">Yo va wè <note caller="+" style="x"><char style="xo" closed="false">35:2 </char><char style="xt" closed="false"><ref loc="ISA 25:9">És 25:9</ref> </char></note>glwa SENYÈ a, majeste a Bondye nou an.<verse eid="ISA 35:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 35:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">35:3 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 4:3-4">Job 4:3-4</ref>
      </char>
    </note>Ankouraje men ki pedi fòs,</para>
  <para style="q1" vid="ISA 35:3">e ranfòse jenou ki fèb la.<verse eid="ISA 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 35:4"/>Pale a sila ki gen <note caller="+" style="x"><char style="xo" closed="false">35:4 </char><char style="xt" closed="false"><ref loc="ISA 32:4">És 32:4</ref></char></note>kè twouble yo,</para>
  <para style="q1" vid="ISA 35:4">“Pran kouraj!</para>
  <para style="q1" vid="ISA 35:4">Pa pè!</para>
  <para style="q1" vid="ISA 35:4">Gade byen, Bondye nou an va vini ak vanjans.</para>
  <para style="q1" vid="ISA 35:4">Rekonpans Li an va rive.</para>
  <para style="q1" vid="ISA 35:4">Li va vini, e Li va sove nou.”<verse eid="ISA 35:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 35:5"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">35:5 </char><char style="xt" closed="false"><ref loc="ISA 29:18">És 29:18</ref></char></note>zye avèg yo va louvri,</para>
  <para style="q1" vid="ISA 35:5">e zòrèy a soud yo debouche.<verse eid="ISA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 35:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">35:6 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 15:30">Mat 15:30</ref>
      </char>
    </note>Moun bwate yo va vòltije tankou sèf,</para>
  <para style="q1" vid="ISA 35:6">e lang bèbè a va rele ak gwo jwa.</para>
  <para style="q1" vid="ISA 35:6">Paske dlo va pete nan tè sèch yo,</para>
  <para style="q1" vid="ISA 35:6">ak vwa dlo yo nan dezè a.<verse eid="ISA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 35:7"/>Peyi deseche a va vin tounen yon letan,</para>
  <para style="q1" vid="ISA 35:7">e tè swaf kòn <note caller="+" style="x"><char style="xo" closed="false">35:7 </char><char style="xt" closed="false"><ref loc="ISA 49:10">És 49:10</ref></char></note>sous k ap pete dlo.</para>
  <para style="q1" vid="ISA 35:7">Nan landwa chen mawon yo,</para>
  <para style="q1" vid="ISA 35:7">nan kote yo poze a , va gen zèb ak wozo ak jon.<verse eid="ISA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 35:8"/>Yon gran chemen va la, yon gran ri.</para>
  <para style="q1" vid="ISA 35:8">Li va rele Chemen Sen an.</para>
  <para style="q1" vid="ISA 35:8">Sila ki pa pwòp p ap vwayaje sou li,</para>
  <para style="q1" vid="ISA 35:8">men li va sèvi pou sila ki mache nan Chemen an.</para>
  <para style="q1" vid="ISA 35:8">Moun mechan ak enpridan an pa p mache la.<verse eid="ISA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 35:9"/>Nanpwen lyon k ap la,</para>
  <para style="q1" vid="ISA 35:9">ni p ap gen bèt sovaj k ap mache sou li.</para>
  <para style="q1" vid="ISA 35:9">Yo p ap twouve la.</para>
  <para style="q1" vid="ISA 35:9">Men <note caller="+" style="x"><char style="xo" closed="false">35:9 </char><char style="xt" closed="false"><ref loc="ISA 51:10">És 51:10</ref></char></note>rachte yo va mache la.<verse eid="ISA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 35:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">35:10 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:27">És 1:27</ref>
      </char>
    </note>Rachte a SENYÈ yo va retounen.</para>
  <para style="q1" vid="ISA 35:10">Ya vini ak gwo kri lajwa lantre nan Sion;</para>
  <para style="q1" vid="ISA 35:10">lajwa ki p ap janm fini ap sou tèt yo.</para>
  <para style="q1" vid="ISA 35:10">Yo va twouve kè kontan ak lajwa;</para>
  <para style="q1" vid="ISA 35:10">tristès ak soupi va sove ale.<verse eid="ISA 35:10"/></para>
  <chapter eid="ISA 35"/>
  <chapter number="36" style="c" sid="ISA 36"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">36:1 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 18:13">II Wa 18:13</ref>
      </char>
    </note>Alò, nan katòzyèm ane a Wa Ézéchias la, Sanchérib, wa Assyrie a, te monte kont tout vil ranfòse Juda yo e te sezi yo. <verse eid="ISA 36:1"/><verse number="2" style="v" sid="ISA 36:2"/>Konsa, wa Assyrie a te voye Rabschaké sòti Lakis nan Jérusalem vè wa Ézéchias avèk yon gwo lame. Li te kanpe kote kanal la sou gran chemen a ki rele Chan Foule a. <verse eid="ISA 36:2"/><verse number="3" style="v" sid="ISA 36:3"/>Epi <note caller="+" style="x"><char style="xo" closed="false">36:3 </char><char style="xt" closed="false"><ref loc="ISA 22:20">És 22:20</ref></char></note>Éliakim, fis a Hilkija a, ki te chèf sou kay wa a, Schebna, grefye a ak Joach, fis a Asaph la, grefye achiv la, te sòti vin kote l.<verse eid="ISA 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">36:4 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 18:19">II Wa 18:19</ref>
      </char>
    </note>Rabschaké te di yo: “Pale koulye a a Ézéchias; ‘Se konsa gran wa a, wa Assyrie a pale: “Ki konfyans sa ou genyen an? <verse eid="ISA 36:4"/><verse number="5" style="v" sid="ISA 36:5"/>Mwen di ou ke Konsèy nou ak fòs pou fè lagè nou pa plis pase pawòl vid. Alò, de kilès nou va depann lè <note caller="+" style="x"><char style="xo" closed="false">36:5 </char><char style="xt" closed="false"><ref loc="2KI 18:7">II Wa 18:7</ref></char></note>nou fè rebelyon kont mwen an? <verse eid="ISA 36:5"/><verse number="6" style="v" sid="ISA 36:6"/>Gade byen, ou depann de baton a wozo kraze sila a. Égypte menm. Men si yon nonm apiye kote li, baton li an ap antre nan men l e frennen l nèt. <note caller="+" style="x"><char style="xo" closed="false">36:6 </char><char style="xt" closed="false"><ref loc="PSA 146:3">Sòm 146:3</ref></char></note>Se konsa Farawon, wa Égypte la ye pou tout sila ki depann de li yo. <verse eid="ISA 36:6"/><verse number="7" style="v" sid="ISA 36:7"/>Men si ou di m: ‘Nou mete konfyans nan SENYÈ a, Bondye nou an’, èske se pa <note caller="+" style="x"><char style="xo" closed="false">36:7 </char><char style="xt" closed="false"><ref loc="DEU 12:2-5">Det 12:2-5</ref></char></note>wo plas ak lotèl a Li menm yo ke Ézéchias te retire e te di Juda ak Jérusalem: ‘Ou va adore isit la devan lotèl sila a’? <verse eid="ISA 36:7"/><verse number="8" style="v" sid="ISA 36:8"/>Alò, pou rezon sa a, vin fè yon antant ak mèt mwen an, wa Assyrie a, e mwen va bannou de-mil cheval, si nou ka jwenn chevalye kont pou mete sou yo. <verse eid="ISA 36:8"/><verse number="9" style="v" sid="ISA 36:9"/>Kijan, alò, nou ka refize menm youn nan pi piti ofisye a mèt mwen yo pou <note caller="+" style="x"><char style="xo" closed="false">36:9 </char><char style="xt" closed="false"><ref loc="ISA 20:5">És 20:5</ref></char></note>depann de Égypte pou cha ak chevalye? <verse eid="ISA 36:9"/><verse number="10" style="v" sid="ISA 36:10"/>Èske konsa, mwen te monte san pèmisyon SENYÈ a, kont peyi sa a pou detwi l? <note caller="+" style="x"><char style="xo" closed="false">36:10 </char><char style="xt" closed="false"><ref loc="1KI 13:18">I Wa 13:18</ref></char></note>SENYÈ a te di mwen: “Ale monte kont peyi sa a pou detwi l.”’”<verse eid="ISA 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11"/>Epi Éliakim, Schebna ak Joach te di a Rabschaké: “Alò, pale ak sèvitè ou yo an Arameyen, paske nou konprann li. Pa pale ak nou an <note caller="+" style="x"><char style="xo" closed="false">36:11 </char><char style="xt" closed="false"><ref loc="ISA 36:13">És 36:13</ref> </char></note>Jideyen nan zòrèy a moun ki sou miray yo.”<verse eid="ISA 36:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12"/>Men Rabschaké te di: “Èske mèt mwen an te voye m sèlman a mèt nou ak nou menm pou pale pawòl sa yo, e pa a moun sila yo ki chita sou miray la, ki va oblije manje pwòp poupou yo e bwè dlo pipi yo ansanm avèk nou?” <verse eid="ISA 36:12"/><verse number="13" style="v" sid="ISA 36:13"/>Konsa Rabschaké te kanpe e te <note caller="+" style="x"><char style="xo" closed="false">36:13 </char><char style="xt" closed="false"><ref loc="2CH 32:18">II Kwo 32:18</ref></char></note>kriye ak yon gwo vwa an Jideyen. Li te di: “Tande pawòl a gran wa a, wa Assyrie a. <verse eid="ISA 36:13"/><verse number="14" style="v" sid="ISA 36:14"/>Konsa pale wa a: ‘Pa kite Ézéchias pase nou nan <note caller="+" style="x"><char style="xo" closed="false">36:14 </char><char style="xt" closed="false"><ref loc="ISA 37:10">És 37:10</ref></char></note>tenten, paske li p ap ka delivre nou! <verse eid="ISA 36:14"/><verse number="15" style="v" sid="ISA 36:15"/>Ni pa kite Ézéchias fè nou <note caller="+" style="x"><char style="xo" closed="false">36:15 </char><char style="xt" closed="false"><ref loc="ISA 36:18-20">És 36:18-20</ref></char></note>mete konfyans nan SENYÈ a, oswa di nou: “Anverite SENYÈ a va delivre nou, vil sa a p ap bay nan men a wa Assyrie a.”’ <verse eid="ISA 36:15"/><verse number="16" style="v" sid="ISA 36:16"/>Pa koute Ézéchias, paske konsa pale wa Assyrie a: ‘Fè lapè ak mwen, vin jwenn mwen, chak moun va manje nan pwòp chan rezen pa li, chak moun nan pwòp pye fig pa li, e chak moun va bwè <note caller="+" style="x"><char style="xo" closed="false">36:16 </char><char style="xt" closed="false"><ref loc="PRO 5:15">Pwov 5:15</ref> </char></note>dlo nan pwòp sitèn pa li, <verse eid="ISA 36:16"/><verse number="17" style="v" sid="ISA 36:17"/>jiskaske m vin mennen nou ale nan yon peyi tankou peyi pa nou an, yon peyi ak anpil sereyal ak diven nèf, yon peyi ak pen ak chan rezen. <verse eid="ISA 36:17"/><verse number="18" style="v" sid="ISA 36:18"/>Veye pou Ézéchias pa egare nou e di nou: <note caller="+" style="x"><char style="xo" closed="false">36:18 </char><char style="xt" closed="false"><ref loc="ISA 36:15">És 36:15</ref></char></note>“SENYÈ a va delivre nou”. Èske youn nan dye a nasyon yo te delivre tè li a anba men a wa Assyrie la? <verse eid="ISA 36:18"/><verse number="19" style="v" sid="ISA 36:19"/>Kote dye a Hamath ak Arpad yo? Kote dye a Sepharvaïm yo? Epi kilè yo te <note caller="+" style="x"><char style="xo" closed="false">36:19 </char><char style="xt" closed="false"><ref loc="2KI 17:6">II Wa 17:6</ref></char></note>delivre Samarie nan men m?” <verse eid="ISA 36:19"/><verse number="20" style="v" sid="ISA 36:20"/>Se kilès pami tout <note caller="+" style="x"><char style="xo" closed="false">36:20 </char><char style="xt" closed="false"><ref loc="1KI 20:23-28">I Wa 20:23-28</ref></char></note>dye peyi sila yo ki te delivre peyi pa yo nan men m, pou SENYÈ a ta delivre Jérusalem nan soti men m?’”<verse eid="ISA 36:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21"/>Men yo te pe la e <note caller="+" style="x"><char style="xo" closed="false">36:21 </char><char style="xt" closed="false"><ref loc="PRO 9:7-8">Pwov 9:7-8</ref> </char></note>pa t di l yon mo, paske lòd a wa a se te: “Pa reponn li”.<verse eid="ISA 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22"/>Epi <note caller="+" style="x"><char style="xo" closed="false">36:22 </char><char style="xt" closed="false"><ref loc="ISA 22:20">És 22:20</ref></char></note>Éliakim, fis a Hilkija a, ki te chèf sou kay la, Schebna, sekretè a ak Joach, fis a Asaph, achivist la, te rive kote Ézéchias ak rad yo chire, e te di li pawòl a Rabschaké yo.<verse eid="ISA 36:22"/></para>
  <chapter eid="ISA 36"/>
  <chapter number="37" style="c" sid="ISA 37"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">37:1 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 19:1-37">II Wa 19:1-37</ref>
      </char>
    </note>Lè wa Ézéchias te tande sa, li te chire rad li, te kouvri kò l ak sak twal, e li te antre lakay SENYÈ a. <verse eid="ISA 37:1"/><verse number="2" style="v" sid="ISA 37:2"/>Li te voye Éliakim ki te chèf nan kay la avèk Schebna, grefye a ak ansyen a prèt yo, kouvri ak sak twal, kote <note caller="+" style="x"><char style="xo" closed="false">37:2 </char><char style="xt" closed="false"><ref loc="ISA 1:1">És 1:1</ref> </char></note>Ésaïe, pwofèt la, fis a Amots la. <verse eid="ISA 37:2"/><verse number="3" style="v" sid="ISA 37:3"/>Yo te di l: “Men konsa pale Ézéchias: ‘Jou sa a se yon <note caller="+" style="x"><char style="xo" closed="false">37:3 </char><char style="xt" closed="false"><ref loc="ISA 22:5">És 22:5</ref></char></note>jou gwo malè, repwòch ak rejè; paske pitit yo rive nan lè pou yo fèt e nanpwen fòs pou akouche yo. <verse eid="ISA 37:3"/><verse number="4" style="v" sid="ISA 37:4"/>Petèt, SENYÈ Bondye ou a va tande pawòl a Rabschaké, ke mèt li a, wa Assyrie a, te voye pou <note caller="+" style="x"><char style="xo" closed="false">37:4 </char><char style="xt" closed="false"><ref loc="ISA 36:13-20">És 36:13-20</ref></char></note>repwoche Bondye vivan an, e li va repwoche pawòl ke SENYÈ a, Bondye ou a, te tande yo. Pou sa, leve lapriyè yo pou retay ki la toujou yo.’”<verse eid="ISA 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5"/>Se konsa sèvitè a Wa Ézéchias yo te rive kote Ésaïe.<verse eid="ISA 37:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 37:6"/>Ésaïe te di yo: “Konsa nou va pale mèt nou an, ‘Se konsa SENYÈ a pale: <note caller="+" style="x"><char style="xo" closed="false">37:6 </char><char style="xt" closed="false"><ref loc="ISA 7:4">És 7:4</ref></char></note>“Pa pè akoz pawòl ke ou te tande yo, avèk sila sèvitè a wa Assyrie yo te blasfeme non Mwen. <verse eid="ISA 37:6"/><verse number="7" style="v" sid="ISA 37:7"/>Gade byen, Mwen va mete yon lespri nan li pou l <note caller="+" style="x"><char style="xo" closed="false">37:7 </char><char style="xt" closed="false"><ref loc="ISA 37:37-38">És 37:37-38</ref></char></note>tande yon rimè pou li retounen nan pwòp peyi li. Epi Mwen va fè l tonbe pa nepe nan pwòp peyi li.”’”<verse eid="ISA 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8"/>Pou sa a, Rabschaké te retounen e te twouve wa Assyrie a t ap goumen kont Libna, paske li te tande ke wa a te kite <note caller="+" style="x"><char style="xo" closed="false">37:8 </char><char style="xt" closed="false"><ref loc="JOS 10:31-32">Jos 10:31-32</ref> </char></note>Lakis. <verse eid="ISA 37:8"/><verse number="9" style="v" sid="ISA 37:9"/>Lè li menm, wa Assyrie a tande yo pale de Tirhaka, wa <note caller="+" style="x"><char style="xo" closed="false">37:9 </char><char style="xt" closed="false"><ref loc="ISA 18:1">És 18:1</ref></char></note>Cush la: “Li te parèt deyò pou goumen kont nou,” epi lè l tande sa, li te voye mesaje yo kote Ézéchias e te di: <verse eid="ISA 37:9"/><verse number="10" style="v" sid="ISA 37:10"/>“Konsa ou va di a Ézéchias, wa a Juda a: <note caller="+" style="x"><char style="xo" closed="false">37:10 </char><char style="xt" closed="false"><ref loc="ISA 36:15">És 36:15</ref></char></note>‘Pa kite Bondye ou a nan sila ou mete konfyans ou an pase ou anba rizib pou di ou: “Jérusalem p ap bay nan men wa Assyrie a.” <verse eid="ISA 37:10"/><verse number="11" style="v" sid="ISA 37:11"/><note caller="+" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="ISA 10:9-11">És 10:9-11</ref></char></note>Gade byen, ou te tande sa ke wa Assyrie yo te fè a tout peyi yo, ke yo te detwi yo nèt. Konsa, èske ou va chape? <verse eid="ISA 37:11"/><verse number="12" style="v" sid="ISA 37:12"/>Èske dye a nasyon sa yo ke papa m te detwi yo te delivre yo; Gozan, Charan, Retseph, ak fis a Éden ki te Telassar yo? <verse eid="ISA 37:12"/><verse number="13" style="v" sid="ISA 37:13"/>Kote wa Hamath la, wa Arpad la, ak wa nan vil a Sepharvaïm lan, Héna, ak Ivva?’”<verse eid="ISA 37:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14"/>Ézéchias te pran lèt la nan men mesaje a, li te li li. Konsa, li te monte lakay SENYÈ a, e li te ouvri li devan SENYÈ a. <verse eid="ISA 37:14"/><verse number="15" style="v" sid="ISA 37:15"/>Ézéchias te priye a SENYÈ a e te di: <verse eid="ISA 37:15"/><verse number="16" style="v" sid="ISA 37:16"/>“O SENYÈ dèzame yo, Bondye Israël la, ki chita sou twòn li anwo cheriben yo, Ou se Bondye a, Ou menm sèl, sou tout wayòm latè yo. <note caller="+" style="x"><char style="xo" closed="false">37:16 </char><char style="xt" closed="false"><ref loc="ISA 42:5">És 42:5</ref> </char></note>Ou te fè syèl la ak latè a. <verse eid="ISA 37:16"/><verse number="17" style="v" sid="ISA 37:17"/>Panche zòrèy Ou, O SENYÈ pou <note caller="+" style="x"><char style="xo" closed="false">37:17 </char><char style="xt" closed="false"><ref loc="PSA 74:22">Sòm 74:22</ref></char></note>tande. Ouvri zye Ou, O SENYÈ pou Ou wè. Koute byen tout pawòl ke Sanchérib te voye pou repwoche Bondye vivan an. <verse eid="ISA 37:17"/><verse number="18" style="v" sid="ISA 37:18"/>Anverite O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">37:18 </char><char style="xt" closed="false"><ref loc="2KI 15:29">II Wa 15:29</ref></char></note>wa Assyrie yo te detwi tout peyi yo ak tout tè pa yo. <verse eid="ISA 37:18"/><verse number="19" style="v" sid="ISA 37:19"/>Epi li te jete dye pa yo nan dife, paske se pa t dye yo te ye, men <note caller="+" style="x"><char style="xo" closed="false">37:19 </char><char style="xt" closed="false"><ref loc="ISA 2:8">És 2:8</ref></char></note>zèv ki te fèt pa men a lòm, ak bwa ak wòch. Konsa yo te detwi yo. <verse eid="ISA 37:19"/><verse number="20" style="v" sid="ISA 37:20"/>Koulye a, O SENYÈ, Bondye nou an, <note caller="+" style="x"><char style="xo" closed="false">37:20 </char><char style="xt" closed="false"><ref loc="ISA 25:9">És 25:9</ref></char></note>delivre nou soti nan men l pou tout wayòm latè yo ka konnen ke Ou menm sèl SENYÈ a, se Bondye.”<verse eid="ISA 37:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21"/>Ésaïe, fis a Amots la te voye kote Ézéchias e te di: “Konsa pale SENYÈ a, Bondye Israël la, ‘Akoz nou te priye a Mwen menm sou Sanchérib, wa Assyrie a, <verse eid="ISA 37:21"/><verse number="22" style="v" sid="ISA 37:22"/>men pawòl ke SENYÈ a fin pale kont li: <note caller="+" style="x"><char style="xo" closed="false">37:22 </char><char style="xt" closed="false"><ref loc="PSA 9:14">Sòm 9:14</ref></char></note>Fi vyèj a Sion an desann ou nèt! Li pa bay ou valè. Fi a Jérusalem nan souke tèt li devan w! <verse eid="ISA 37:22"/><verse number="23" style="v" sid="ISA 37:23"/>Se kilès ou te meprize e blasfeme? Kont kilès ou te leve vwa ou, e kont kilès ou te leve zye ou ak ògèy la? Kont <note caller="+" style="x"><char style="xo" closed="false">37:23 </char><char style="xt" closed="false"><ref loc="EZK 39:7">Éz 39:7</ref> </char></note>Sila Ki Sen an Israël la! <verse eid="ISA 37:23"/><verse number="24" style="v" sid="ISA 37:24"/>Ak sèvitè ou yo, ou te meprize SENYÈ a! Ou te di: ‘Ak tout cha mwen yo, mwen te monte sou wotè a mòn yo, kote pi izole nan Liban yo. Epi mwen va koupe <note caller="+" style="x"><char style="xo" closed="false">37:24 </char><char style="xt" closed="false"><ref loc="ISA 14:8">És 14:8</ref></char></note>bwa sèd li yo ak tout bwa pichpen pi bèl yo. Mwen va monte kote tèt mòn pi wo li a, nan forè pi bèl li yo. <verse eid="ISA 37:24"/><verse number="25" style="v" sid="ISA 37:25"/>Mwen te fouye pwi yo, mwen te bwè dlo yo e <note caller="+" style="x"><char style="xo" closed="false">37:25 </char><char style="xt" closed="false"><ref loc="DEU 11:10">Det 11:10</ref></char></note>ak pla pye mwen, mwen fè tout rivyè an Égypte yo vin sèch.’”<verse eid="ISA 37:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ISA 37:26"/>“Èske ou pa t tande? Lontan sa, Mwen te fè li; depi nan tan ansyen yo, Mwen te <note caller="+" style="x"><char style="xo" closed="false">37:26 </char><char style="xt" closed="false"><ref loc="ACT 2:23">Trav 2:23</ref></char></note>planifye sa. Koulye a Mwen fin fè l rive, pou ou ta fè gwo vil fòtifye yo vin tounen gwo pil mazi. <verse eid="ISA 37:26"/><verse number="27" style="v" sid="ISA 37:27"/>Akoz sa, moun ki te rete ladann yo te manke fòs. Yo te plen konfizyon ak wont. Yo te tankou zèb chan, tankou zèb vèt, tankou <note caller="+" style="x"><char style="xo" closed="false">37:27 </char><char style="xt" closed="false"><ref loc="PSA 129:6">Sòm 129:6</ref></char></note>zèb sou twati kay ki fennen avan li fin grandi. <verse eid="ISA 37:27"/><verse number="28" style="v" sid="ISA 37:28"/>Men Mwen <note caller="+" style="x"><char style="xo" closed="false">37:28 </char><char style="xt" closed="false"><ref loc="PSA 139:1">Sòm 139:1</ref></char></note>konnen lè ou chita ak lè ou sòti, lè ou antre ak lè ou fè laraj kont Mwen. <verse eid="ISA 37:28"/><verse number="29" style="v" sid="ISA 37:29"/>Akoz laraj ou fè kont Mwen, e akoz <note caller="+" style="x"><char style="xo" closed="false">37:29 </char><char style="xt" closed="false"><ref loc="ISA 10:12">És 10:12</ref></char></note>ògèy ou rive monte nan zòrèy Mwen; pou sa, Mwen va mete yon gwo kwòk nan nen ou ak brid Mwen nan lèv ou, e Mwen va vire fè ou tounen pa chemen ke ou te antre a.”<verse eid="ISA 37:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30"/>“Epi sa va sign pou ou: ou va manje ane sa a sa ki <note caller="+" style="x"><char style="xo" closed="false">37:30 </char><char style="xt" closed="false"><ref loc="LEV 25:5-11">Lev 25:5-11</ref></char></note>grandi pou li, nan dezyèm ane sa ki vin parèt menm jan an. Nan twazyèm ane a, plante, rekòlte, plante chan rezen yo e manje fwi yo. <verse eid="ISA 37:30"/><verse number="31" style="v" sid="ISA 37:31"/>Retay lakay Juda ki chape a va ankò <note caller="+" style="x"><char style="xo" closed="false">37:31 </char><char style="xt" closed="false"><ref loc="ISA 27:6">És 27:6</ref></char></note>pran rasin anba pou donnen fwi anlè. <verse eid="ISA 37:31"/><verse number="32" style="v" sid="ISA 37:32"/>Paske soti nan Jérusalem, va vin parèt yon retay e sòti nan Mòn Sion, kèk moun ki chape. <note caller="+" style="x"><char style="xo" closed="false">37:32 </char><char style="xt" closed="false"><ref loc="2KI 19:31">II Wa 19:31</ref></char></note>Zèl kouraj SENYÈ a va akonpli sa a.”<verse eid="ISA 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33"/>“Pou sa” pale SENYÈ a, pale konsènan wa Assyrie a konsa: “Li p ap rive nan vil sa a, ni tire yon flèch la. Li p ap parèt devan l ak boukliye, ni monte yon <note caller="+" style="x"><char style="xo" closed="false">37:33 </char><char style="xt" closed="false"><ref loc="JER 6:6">Jr 6:6</ref></char></note>ran syèj kont li. <verse eid="ISA 37:33"/><verse number="34" style="v" sid="ISA 37:34"/><note caller="+" style="x"><char style="xo" closed="false">37:34 </char><char style="xt" closed="false"><ref loc="ISA 37:29">És 37:29</ref></char></note>Pa menm chemen ke li te vini an, pa li menm li va retounen e li p ap rive sou vil sa a,’ deklare SENYÈ a. <verse eid="ISA 37:34"/><verse number="35" style="v" sid="ISA 37:35"/>‘Paske Mwen va <note caller="+" style="x"><char style="xo" closed="false">37:35 </char><char style="xt" closed="false"><ref loc="2KI 20:6">II Wa 20:6</ref></char></note>defann vil sa a pou sove li pou pwòp koz pa M, e pou koz sèvitè Mwen an, David.’”<verse eid="ISA 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36"/>Epi <note caller="+" style="x"><char style="xo" closed="false">37:36 </char><char style="xt" closed="false"><ref loc="2KI 19:35">II Wa 19:35</ref></char></note>zanj SENYÈ a te sòti deyò e te frape san-katre-ven-senk-mil lòm nan kan Asiryen yo. Lè moun te leve bonè granmmaten, gade byen, yo tout te mouri. <verse eid="ISA 37:36"/><verse number="37" style="v" sid="ISA 37:37"/>Konsa, Sanchérib, wa Assyrie a te sòti, te retounen lakay li e te rete <note caller="+" style="x"><char style="xo" closed="false">37:37 </char><char style="xt" closed="false"><ref loc="GEN 10:11">Jen 10:11</ref></char></note>Ninive. <verse eid="ISA 37:37"/><verse number="38" style="v" sid="ISA 37:38"/>Li te vin rive pandan li t ap adore lakay Nisroc, dye pa li a, ke Adrammélec ak Scharetser, fis li yo, te touye li ak nepe e yo te chape antre nan peyi Ararat. Konsa, <note caller="+" style="x"><char style="xo" closed="false">37:38 </char><char style="xt" closed="false"><ref loc="EZK 4:12">Éz 4:12</ref></char></note>Ésar-Haddon, fis li a, te renye nan plas li.<verse eid="ISA 37:38"/></para>
  <chapter eid="ISA 37"/>
  <chapter number="38" style="c" sid="ISA 38"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">38:1 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 20:1-11">II Wa 20:1-11</ref>
      </char>
    </note>Nan jou sa yo, Ézéchias te vin malad, prèt pou mouri. Epi Ésaïe, pwofèt la, fis a Amots la, te vin kote li. Li te di l: “Konsa pale SENYÈ a: ‘Mete lakay ou an lòd, paske ou va mouri; ou p ap viv.’”<verse eid="ISA 38:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2"/>Ézéchias te vire figi li vè mi kay la pou te priye a SENYÈ a. <verse eid="ISA 38:2"/><verse number="3" style="v" sid="ISA 38:3"/>Li te di: “Sonje koulye a, O SENYÈ, mwen mande Ou souple, pou jan mwen te <note caller="+" style="x"><char style="xo" closed="false">38:3 </char><char style="xt" closed="false"><ref loc="2KI 18:5-6">II Wa 18:5-6</ref></char></note>mache devan Ou nan verite, ak yon kè entèg e te fè sa ki te bon devan zye Ou.” Konsa, Ézéchias te plere byen fò.<verse eid="ISA 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4"/>Alò, pawòl SENYÈ a te rive kote Ésaïe, epi te di l: <verse eid="ISA 38:4"/><verse number="5" style="v" sid="ISA 38:5"/>“Ale pale ak Ézéchias epi di li: ‘Konsa pale SENYÈ a: “Mwen te tande lapriyè ou, Mwen te wè dlo ki t ap sòti nan zye ou. Gade byen, Mwen va mete <note caller="+" style="x"><char style="xo" closed="false">38:5 </char><char style="xt" closed="false"><ref loc="2KI 18:2-13">II Wa 18:2-13</ref></char></note>kenzan sou lavi ou. <verse eid="ISA 38:5"/><verse number="6" style="v" sid="ISA 38:6"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">38:6 </char><char style="xt" closed="false"><ref loc="ISA 31:5">És 31:5</ref></char></note>delivre ou ak vil sa a soti nan men a wa Assyrie a, epi Mwen va defann vil sa a.”’ <verse eid="ISA 38:6"/><verse number="7" style="v" sid="ISA 38:7"/>Konsa, sa va <note caller="+" style="x"><char style="xo" closed="false">38:7 </char><char style="xt" closed="false"><ref loc="JDG 6:17-40">Jij 6:17-40</ref></char></note>sign pou ou soti nan SENYÈ a, ke SENYÈ a va fè bagay sa ke Li te pale a: <verse eid="ISA 38:7"/><verse number="8" style="v" sid="ISA 38:8"/>Gade byen, Mwen va <note caller="+" style="x"><char style="xo" closed="false">38:8 </char><char style="xt" closed="false"><ref loc="2KI 20:9-11">II Wa 20:9-11</ref></char></note>fè lonbraj sou eskalye a, lonbraj ki te desann avèk solèy la sou eskalye Achaz la, pou fè back dis pa.” Epi konsa lonbraj solèy la te fè bak dis pa sou menm eskalye kote li te desann nan.<verse eid="ISA 38:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9"/>Men yon chanson ke Ézéchias te ekri apre li te malad e te vin refè a:<verse eid="ISA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 38:10"/>Mwen te di: <note caller="+" style="x"><char style="xo" closed="false">38:10 </char><char style="xt" closed="false"><ref loc="PSA 102:24">Sòm 102:24</ref></char></note>“Nan mitan lavi m,</para>
  <para style="q1" vid="ISA 38:10">mwen gen pou antre nan pòtay Sejou mò yo.</para>
  <para style="q1" vid="ISA 38:10">Mwen gen pou pèdi tout rès ane mwen yo.”<verse eid="ISA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 38:11"/>Mwen te di: “Mwen p ap wè SENYÈ a;</para>
  <para style="q1" vid="ISA 38:11">SENYÈ <note caller="+" style="x"><char style="xo" closed="false">38:11 </char><char style="xt" closed="false"><ref loc="PSA 27:13">Sòm 27:13</ref></char></note>nan peyi vivan yo.</para>
  <para style="q1" vid="ISA 38:11">Mwen p ap wè moun ankò pami sila ki viv nan mond yo.<verse eid="ISA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 38:12"/>Tankou <note caller="+" style="x"><char style="xo" closed="false">38:12 </char><char style="xt" closed="false"><ref loc="2CO 5:1-4">II Kor 5:1-4</ref></char></note>tant a yon bèje, lakay mwen va rache retire sou mwen.</para>
  <para style="q1" vid="ISA 38:12">Tankou yon bòs twal, m ap woule fè monte lavi m.</para>
  <para style="q1" vid="ISA 38:12">L ap koupe m fè m sòti nan ankadreman bòs twal la.</para>
  <para style="q1" vid="ISA 38:12">Soti lajounen rive nan lannwit,</para>
  <para style="q1" vid="ISA 38:12">Ou va fè yon fen ak mwen.<verse eid="ISA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 38:13"/>Mwen te kalme nanm mwen jis rive nan maten.</para>
  <para style="q1" vid="ISA 38:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">38:13 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 10:16">Job 10:16</ref>
      </char>
    </note>Tankou yon lyon—se konsa Li kraze tout zo m,</para>
  <para style="q1" vid="ISA 38:13">soti lajounen jis rive lannwit, ou fè yon fen ak mwen.<verse eid="ISA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 38:14"/>Tankou yon iwondèl, tankou yon zwazo se konsa mwen kriye.</para>
  <para style="q1" vid="ISA 38:14">Mwen plenyen kon yon toutrèl.</para>
  <para style="q1" vid="ISA 38:14">Zye m gade ak feblès vè wotè yo.</para>
  <para style="q1" vid="ISA 38:14">O Senyè, mwen oprime!</para>
  <para style="q1" vid="ISA 38:14">Fè m sekou!<verse eid="ISA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 38:15"/>Kisa mwen kapab di?</para>
  <para style="q1" vid="ISA 38:15">Non sèlman Li te pale ak mwen,</para>
  <para style="q1" vid="ISA 38:15">Men Li, Li menm, te fè l.</para>
  <para style="q1" vid="ISA 38:15">Mwen va <note caller="+" style="x"><char style="xo" closed="false">38:15 </char><char style="xt" closed="false"><ref loc="1KI 21:27">I Wa 21:27</ref></char></note>mache an règ pandan tout ane m yo</para>
  <para style="q1" vid="ISA 38:15">akoz gou anmè kè m fin goute.<verse eid="ISA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 38:16"/>O Senyè, se pou bagay sa yo ke moun viv,</para>
  <para style="q1" vid="ISA 38:16">e nan sa yo, lespri m jwenn lavi.</para>
  <para style="q1" vid="ISA 38:16">
    <note caller="+" style="x">
      <char style="xo" closed="false">38:16 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:25">Sòm 119:25</ref>
      </char>
    </note>Ou te fè m twouve lasante e te fè m viv!<verse eid="ISA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 38:17"/>Alò, mwen te manke gen lapè;</para>
  <para style="q1" vid="ISA 38:17">men Ou menm ki te <note caller="+" style="x"><char style="xo" closed="false">38:17 </char><char style="xt" closed="false"><ref loc="PSA 30:3">Sòm 30:3</ref></char></note>kenbe nanm mwen,</para>
  <para style="q1" vid="ISA 38:17">pou l pa antre nan fòs gwo abim nan,</para>
  <para style="q1" vid="ISA 38:17">Ou te jete tout peche m yo dèyè do Ou.<verse eid="ISA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 38:18"/>Paske Sejou mò yo p ap ka remèsye Ou.</para>
  <para style="q1" vid="ISA 38:18">Lanmò menm p ap ka bay Ou lwanj.</para>
  <para style="q1" vid="ISA 38:18">Sila ki <note caller="+" style="x"><char style="xo" closed="false">38:18 </char><char style="xt" closed="false"><ref loc="NUM 16:33">Nonb 16:33</ref></char></note>desann nan fos yo</para>
  <para style="q1" vid="ISA 38:18">p ap ka gen espwa fidelite Ou.<verse eid="ISA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 38:19"/>Se <note caller="+" style="x"><char style="xo" closed="false">38:19 </char><char style="xt" closed="false"><ref loc="PSA 118:17">Sòm 118:17</ref></char></note>vivan, vivan yo ki bay Ou remèsiman,</para>
  <para style="q1" vid="ISA 38:19">tankou mwen menm, mwen fè jodi a.</para>
  <para style="q1" vid="ISA 38:19">Yon papa va pale ak fis li yo selon fidelite Ou.<verse eid="ISA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 38:20"/>Anverite, SENYÈ a va sove mwen.</para>
  <para style="q1" vid="ISA 38:20">Konsa, nou va chante chanson mwen yo</para>
  <para style="q1" vid="ISA 38:20">sou enstriman kòd yo pou tout lavi nou lakay SENYÈ a.”<verse eid="ISA 38:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21"/>Alò <note caller="+" style="x"><char style="xo" closed="false">38:21 </char><char style="xt" closed="false"><ref loc="2KI 20:7-8">II Wa 20:7-8</ref></char></note>Ésaïe te di: “Kite yo fè yon pomad ak gato fig etranje e mete li sou abse a, pou l ka geri.” <verse eid="ISA 38:21"/><verse number="22" style="v" sid="ISA 38:22"/>Epi Ézéchias te di: “Se kisa k ap <note caller="+" style="x"><char style="xo" closed="false">38:22 </char><char style="xt" closed="false"><ref loc="ISA 38:7">És 38:7</ref></char></note>sign ke mwen va monte lakay SENYÈ a?”<verse eid="ISA 38:22"/></para>
  <chapter eid="ISA 38"/>
  <chapter number="39" style="c" sid="ISA 39"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">39:1 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 20:12-19">II Wa 20:12-19</ref>
      </char>
    </note>Nan lè sa a Merodac-Baladan, fis a Baladan nan, wa Babylon nan, te voye lèt ak yon kado bay Ézéchias, paske li te tande ke li te malad, e li te refè. <verse eid="ISA 39:1"/><verse number="2" style="v" sid="ISA 39:2"/>Ézéchias te <note caller="+" style="x"><char style="xo" closed="false">39:2 </char><char style="xt" closed="false"><ref loc="2CH 32:25-31">II Kwo 32:25-31</ref></char></note>kontan e te montre yo tout trezò lakay li yo; ajan ak lò a, epis ak lwil presye, tout zam li yo ak tout sa ki te la nan trezò a. Pa t gen anyen lakay li a ni nan tout wayòm li an ke Ézéchias pa t montre yo.<verse eid="ISA 39:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3"/>Alò, Ésaïe, pwofèt la, te vin kote Wa Ézéchias. Li te di l: “Se kisa mesye sa yo te di, e se kibò yo sòti pou vin kote nou la a?”</para>
  <para style="p" vid="ISA 39:3">Ézéchias te di: “Yo vin kote m soti nan yon <note caller="+" style="x"><char style="xo" closed="false">39:3 </char><char style="xt" closed="false"><ref loc="DEU 28:49">Det 28:49</ref></char></note>peyi lwen, Babylone.”<verse eid="ISA 39:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4"/>Li te di: “Se kisa yo te wè lakay ou a?”</para>
  <para style="p" vid="ISA 39:4">Ézéchias te reponn: “Yo te wè tout sa ki lakay mwen an. Nanpwen anyen pami trezò mwen yo ke mwen pa t montre yo.”<verse eid="ISA 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5"/>Konsa, Ésaïe te di a Ézéchias: “Tande <note caller="+" style="x"><char style="xo" closed="false">39:5 </char><char style="xt" closed="false"><ref loc="1SA 13:13-14">I Sam 13:13-14</ref></char></note>pawòl SENYÈ dèzame yo, <verse eid="ISA 39:5"/><verse number="6" style="v" sid="ISA 39:6"/>‘Gade byen, jou yo ap vini lè <note caller="+" style="x"><char style="xo" closed="false">39:6 </char><char style="xt" closed="false"><ref loc="2KI 24:13">II Wa 24:13</ref></char></note>tout sa ki lakay ou ak tout sa ke papa ou yo te mete nan depo, jis rive nan jodi a, va pote ale Babylone. Anyen p ap rete’, pale SENYÈ a. <verse eid="ISA 39:6"/><verse number="7" style="v" sid="ISA 39:7"/>‘Va gen kèk nan fis ou yo ki sòti nan ou menm, ke ou va fè. Yo va <note caller="+" style="x"><char style="xo" closed="false">39:7 </char><char style="xt" closed="false"><ref loc="2KI 24:10-16">II Wa 24:10-16</ref></char></note> pote ale, e yo va vin fè ofisye nan palè a wa Babylon nan.’”<verse eid="ISA 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8"/>Ézéchias te di a Ésaïe: “Pawòl SENYÈ ke ou te pale a, bon.” Paske li te panse: “Ap gen lapè ak verite <note caller="+" style="x"><char style="xo" closed="false">39:8 </char><char style="xt" closed="false"><ref loc="2CH 34:28">II Kwo 34:28</ref></char></note>nan jou mwen yo.”<verse eid="ISA 39:8"/></para>
  <chapter eid="ISA 39"/>
  <chapter number="40" style="c" sid="ISA 40"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 40:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">40:1 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 12:1">És 12:1</ref>
      </char>
    </note>“Konsole, O konsole pèp Mwen an,”</para>
  <para style="q1" vid="ISA 40:1">pale Bondye ou an.<verse eid="ISA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 40:2"/>“Pale ak dousè ak Jérusalem.</para>
  <para style="q1" vid="ISA 40:2">Rele a li menm, ke <note caller="+" style="x"><char style="xo" closed="false">40:2 </char><char style="xt" closed="false"><ref loc="ISA 41:11-13">És 41:11-13</ref></char></note>konfli li fini an,</para>
  <para style="q1" vid="ISA 40:2">ke inikite li retire a,</para>
  <para style="q1" vid="ISA 40:2">ke li te resevwa nan men SENYÈ a</para>
  <para style="q1" vid="ISA 40:2">doub pou tout peche li yo.”<verse eid="ISA 40:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 40:3"/>Yon vwa k ap rele fò,</para>
  <para style="q1" vid="ISA 40:3">“Debleye chemen an pou SENYÈ a nan dezè a!</para>
  <para style="q1" vid="ISA 40:3">Fè vin swa nan dezè a yon gran chemen pou Bondye nou an.<verse eid="ISA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 40:4"/>Kite tout vale yo vin leve wo,</para>
  <para style="q1" vid="ISA 40:4">e tout mòn ak kolin yo vin ba.</para>
  <para style="q1" vid="ISA 40:4">Kite move teren an vin pla,</para>
  <para style="q1" vid="ISA 40:4">e teren difisil yo vin yon vale ki swa.<verse eid="ISA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 40:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">40:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 6:3">És 6:3</ref>
      </char>
    </note>Glwa a SENYÈ a va vin parèt,</para>
  <para style="q1" vid="ISA 40:5">e tout chè va wè sa ansanm;</para>
  <para style="q1" vid="ISA 40:5">paske bouch a SENYÈ a fin pale.”<verse eid="ISA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 40:6"/>Yon vwa pale: “Rele fò.”</para>
  <para style="q1" vid="ISA 40:6">Yon lòt reponn: “Kisa pou m rele?”</para>
  <para style="q1" vid="ISA 40:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">40:6 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 14:2">Job 14:2</ref>
      </char>
    </note> “Tout chè se zèb,</para>
  <para style="q1" vid="ISA 40:6">e tout bèlte li se tankou flè nan chan.<verse eid="ISA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 40:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">40:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 90:5-6">Sòm 90:5-6</ref>
      </char>
    </note>Zèb la fennen,</para>
  <para style="q1" vid="ISA 40:7">flè a pèdi koulè l,</para>
  <para style="q1" vid="ISA 40:7">depi souf SENYÈ a soufle sou li.</para>
  <para style="q1" vid="ISA 40:7">Anverite, pèp la se zèb.<verse eid="ISA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 40:8"/>Zèb la fennen,</para>
  <para style="q1" vid="ISA 40:8">flè a pèdi koulè l,</para>
  <para style="q1" vid="ISA 40:8">men <note caller="+" style="x"><char style="xo" closed="false">40:8 </char><char style="xt" closed="false"><ref loc="ISA 55:11">És 55:11</ref></char></note>pawòl Bondye nou an kanpe jis pou tout tan.”<verse eid="ISA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 40:9"/>Mete ou menm sou yon mòn ki wo,</para>
  <para style="q1" vid="ISA 40:9">O Sion, ki pote bòn nouvèl.</para>
  <para style="q1" vid="ISA 40:9">Leve vwa ou wo ak gwo pouvwa,</para>
  <para style="q1" vid="ISA 40:9">O Jérusalem, ki pote bòn nouvèl la!</para>
  <para style="q1" vid="ISA 40:9">Leve wo! Pa pè anyen!</para>
  <para style="q1" vid="ISA 40:9">Di a <note caller="+" style="x"><char style="xo" closed="false">40:9 </char><char style="xt" closed="false"><ref loc="ISA 44:26">És 44:26</ref></char></note>vil Juda yo: Men Bondye nou an!<verse eid="ISA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 40:10"/>Gade byen, Senyè BONDYE a, va vini <note caller="+" style="x"><char style="xo" closed="false">40:10 </char><char style="xt" closed="false"><ref loc="ISA 9:6-7">És 9:6-7</ref></char></note>ak pwisans.</para>
  <para style="q1" vid="ISA 40:10">Se bra L k ap kòmande pou Li.</para>
  <para style="q1" vid="ISA 40:10">Gade byen salè Li avè L,</para>
  <para style="q1" vid="ISA 40:10">e rekonpans li devan L.<verse eid="ISA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 40:11"/>Tankou yon bèje, Li va <note caller="+" style="x"><char style="xo" closed="false">40:11 </char><char style="xt" closed="false"><ref loc="JER 31:10">Jr 31:10</ref></char></note>pran swen bann mouton Li.</para>
  <para style="q1" vid="ISA 40:11">Nan bra Li, Li va ranmase jenn mouton yo,</para>
  <para style="q1" vid="ISA 40:11">e pote yo sou lestonmak Li.</para>
  <para style="q1" vid="ISA 40:11">Ak dousè, Li va mennen manma a</para>
  <para style="q1" vid="ISA 40:11">ak ti mouton piti yo.<verse eid="ISA 40:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 40:12"/>Se kilès ki te <note caller="+" style="x"><char style="xo" closed="false">40:12 </char><char style="xt" closed="false"><ref loc="JOB 38:8-11">Job 38:8-11</ref></char></note>mezire dlo nan pla men L?</para>
  <para style="q1" vid="ISA 40:12">Kilès ki te etabli mezi syèl yo ak yon men louvri;</para>
  <para style="q1" vid="ISA 40:12">ki te fè kalkil pousyè latè pa mezi,</para>
  <para style="q1" vid="ISA 40:12">ki te peze mòn yo nan gwo balans,</para>
  <para style="q1" vid="ISA 40:12">e ki te peze kolin yo ak ti balans piti a?<verse eid="ISA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 40:13"/>Se <note caller="+" style="x"><char style="xo" closed="false">40:13 </char><char style="xt" closed="false"><ref loc="ROM 11:34">Wo 11:34</ref></char></note>kilès ki te dirije Lespri SENYÈ a,</para>
  <para style="q1" vid="ISA 40:13">oswa kòn enstwi Li pou l konseye L?<verse eid="ISA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 40:14"/>Ak kilès Li te konsilte,</para>
  <para style="q1" vid="ISA 40:14">e se kilès ki te <note caller="+" style="x"><char style="xo" closed="false">40:14 </char><char style="xt" closed="false"><ref loc="JOB 21:22">Job 21:22</ref></char></note>bay Li bon konprann?</para>
  <para style="q1" vid="ISA 40:14">Epi kilès ki te montre Li chemen lajistis la,</para>
  <para style="q1" vid="ISA 40:14">ki te enstwi Li nan konesans,</para>
  <para style="q1" vid="ISA 40:14">e ki te fè L konnen chemen an pou L byen konprann?<verse eid="ISA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 40:15"/>Gade byen, <note caller="+" style="x"><char style="xo" closed="false">40:15 </char><char style="xt" closed="false"><ref loc="JER 10:10">Jr 10:10</ref></char></note>nasyon yo se tankou yon gout dlo nan yon bokit;</para>
  <para style="q1" vid="ISA 40:15">yo parèt tankou yon grenn pousyè sou balans la.</para>
  <para style="q1" vid="ISA 40:15">Gade byen, li leve fè monte lil yo konsi se yon ti kras pousyè.<verse eid="ISA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 40:16"/>Menm Liban pa kont pou brile, ni <note caller="+" style="x"><char style="xo" closed="false">40:16 </char><char style="xt" closed="false"><ref loc="PSA 50:9-11">Sòm 50:9-11</ref></char></note>bèt li yo</para>
  <para style="q1" vid="ISA 40:16">pa kont pou fè ofrann brile.<verse eid="ISA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 40:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">40:17 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 29:7">És 29:7</ref>
      </char>
    </note>Tout nasyon yo se konsi yo pa anyen devan L,</para>
  <para style="q1" vid="ISA 40:17">Li gade yo tankou mwens ke anyen, kon vanite.<verse eid="ISA 40:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 40:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">40:18 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:10">Egz 8:10</ref>
      </char>
    </note> A kilès, alò, nou ta konpare Bondye?</para>
  <para style="q1" vid="ISA 40:18">Oswa avèk ki imaj nou ta fè L sanble?<verse eid="ISA 40:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 40:19"/>Pou Zidòl la, se yon ouvriye ki fòme l,</para>
  <para style="q1" vid="ISA 40:19">ak òfèv ki <note caller="+" style="x"><char style="xo" closed="false">40:19 </char><char style="xt" closed="false"><ref loc="ISA 2:20">És 2:20</ref></char></note>kouvri l ak lò</para>
  <para style="q1" vid="ISA 40:19">e fè chenn li an ajan,<verse eid="ISA 40:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 40:20"/>Sila ki twò pòv pou fè ofrann sa a,</para>
  <para style="q1" vid="ISA 40:20">pran yon pyebwa ki pa konn pouri;</para>
  <para style="q1" vid="ISA 40:20">li chache jwenn yon mèt atizan pou prepare</para>
  <para style="q1" vid="ISA 40:20">yon zidòl ki <note caller="+" style="x"><char style="xo" closed="false">40:20 </char><char style="xt" closed="false"><ref loc="1SA 5:3-4">I Sam 5:3-4</ref></char></note>p ap deplase.<verse eid="ISA 40:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 40:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">40:21 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:1">Sòm 19:1</ref>
      </char>
    </note> Èske nou pa konnen? Èske nou pa konn tande?</para>
  <para style="q1" vid="ISA 40:21">Èske sa pa t deklare a nou menm depi nan kòmansman?</para>
  <para style="q1" vid="ISA 40:21">Èske nou pa t konprann sa depi nan fondasyon latè yo?<verse eid="ISA 40:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 40:22"/>Se Li menm ki chita anwo <note caller="+" style="x"><char style="xo" closed="false">40:22 </char><char style="xt" closed="false"><ref loc="JOB 22:14">Job 22:14</ref></char></note>wonn tè a</para>
  <para style="q1" vid="ISA 40:22">ki veye nou ki rete ladann tankou krikèt volan;</para>
  <para style="q1" vid="ISA 40:22">ki lonje ouvri syèl yo tankou yon rido</para>
  <para style="q1" vid="ISA 40:22">e fè yo deplwaye tankou yon tant pou moun viv ladann.<verse eid="ISA 40:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 40:23"/>Se Li menm ki redwi gwo chèf yo pou yo pa anyen,</para>
  <para style="q1" vid="ISA 40:23">ki <note caller="+" style="x"><char style="xo" closed="false">40:23 </char><char style="xt" closed="false"><ref loc="ISA 5:21">És 5:21</ref></char></note>fè jij latè yo vin san sans.<verse eid="ISA 40:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 40:24"/>Apèn yo fin plante, apèn yo fin simen,</para>
  <para style="q1" vid="ISA 40:24">apèn stòk yo fin pran rasin nan tè a,</para>
  <para style="q1" vid="ISA 40:24">Li sèlman soufle sou yo,</para>
  <para style="q1" vid="ISA 40:24">e yo fennen pou<note caller="+" style="x"><char style="xo" closed="false">40:24 </char><char style="xt" closed="false"><ref loc="ISA 17:13">És 17:13</ref></char></note>tanpèt la pote yo ale tankou pay.<verse eid="ISA 40:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 40:25"/>“Alò, <note caller="+" style="x"><char style="xo" closed="false">40:25 </char><char style="xt" closed="false"><ref loc="ISA 40:18">És 40:18</ref></char></note>ak kilès ou va konpare Mwen,</para>
  <para style="q1" vid="ISA 40:25">pou M ta kapab vin egal avè l?”</para>
  <para style="q1" vid="ISA 40:25">pale Sila Ki Sen an.<verse eid="ISA 40:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 40:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">40:26 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 51:6">És 51:6</ref>
      </char>
    </note>Leve zye nou anlè,</para>
  <para style="q1" vid="ISA 40:26">e gade kilès ki te kreye zetwal sila yo;</para>
  <para style="q1" vid="ISA 40:26">Sila ki mennen lame selès yo sòti pa chif yo.</para>
  <para style="q1" vid="ISA 40:26">Li rele yo tout pa non yo.</para>
  <para style="q1" vid="ISA 40:26">Akoz grandè a pwisans Li</para>
  <para style="q1" vid="ISA 40:26">ak fòs pouvwa Li,</para>
  <para style="q1" vid="ISA 40:26">nanpwen youn nan yo ki manke.<verse eid="ISA 40:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 40:27"/>Poukisa ou di, O Jacob, e pale O Israël:</para>
  <para style="q1" vid="ISA 40:27">“Chemen Mwen an kache de SENYÈ a</para>
  <para style="q1" vid="ISA 40:27">e <note caller="+" style="x"><char style="xo" closed="false">40:27 </char><char style="xt" closed="false"><ref loc="JOB 27:2">Job 27:2</ref></char></note>jistis ke m merite a chape de atansyon Bondye M”?<verse eid="ISA 40:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 40:28"/>Èske nou pa konnen?</para>
  <para style="q1" vid="ISA 40:28">Èske nou pa tande?</para>
  <para style="q1" vid="ISA 40:28">Ke <note caller="+" style="x"><char style="xo" closed="false">40:28 </char><char style="xt" closed="false"><ref loc="GEN 21:33">Jen 21:33</ref></char></note>Bondye Etènèl la, SENYÈ a,</para>
  <para style="q1" vid="ISA 40:28">Kreyatè a dènye pwent latè a,</para>
  <para style="q1" vid="ISA 40:28">pa konn fatige, ni bouke.</para>
  <para style="q1" vid="ISA 40:28">Konprann pa Li depase tout bon konprann.<verse eid="ISA 40:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 40:29"/>Li bay fòs a sila ki <note caller="+" style="x"><char style="xo" closed="false">40:29 </char><char style="xt" closed="false"><ref loc="ISA 50:4">És 50:4</ref></char></note>fatige yo,</para>
  <para style="q1" vid="ISA 40:29">e a sila ki manke fòs yo, li bay plis pouvwa.<verse eid="ISA 40:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 40:30"/>Malgre moun <note caller="+" style="x"><char style="xo" closed="false">40:30 </char><char style="xt" closed="false"><ref loc="JER 6:11">Jr 6:11</ref></char></note>jenn yo febli e vin bouke,</para>
  <para style="q1" vid="ISA 40:30">e jenn nom plen kouraj yo vin glise tonbe;<verse eid="ISA 40:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 40:31"/>sila ki tann SENYÈ yo va <note caller="+" style="x"><char style="xo" closed="false">40:31 </char><char style="xt" closed="false"><ref loc="JOB 17:9">Job 17:9</ref></char></note>renouvle ak kouraj nèf;</para>
  <para style="q1" vid="ISA 40:31">yo va monte anwo ak zèl kon èg.</para>
  <para style="q1" vid="ISA 40:31">Yo va kouri, e yo p ap bouke;</para>
  <para style="q1" vid="ISA 40:31">yo va mache, e yo p ap fatige.<verse eid="ISA 40:31"/></para>
  <chapter eid="ISA 40"/>
  <chapter number="41" style="c" sid="ISA 41"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 41:1"/>“Peyi kot lanmè yo, koute Mwen an silans</para>
  <para style="q1" vid="ISA 41:1">e kite pèp yo renouvele fòs yo.</para>
  <para style="q1" vid="ISA 41:1">Kite yo vin parèt pa devan,</para>
  <para style="q1" vid="ISA 41:1">konsa, kite yo pale.</para>
  <para style="q1" vid="ISA 41:1">Annou reyini ansanm pou fè jijman.<verse eid="ISA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 41:2"/>Kilès ki te fè leve yon k ap soti nan lès?</para>
  <para style="q1" vid="ISA 41:2">Kilès ki te rele li vin kanpe a pye nan ladwati la?</para>
  <para style="q1" vid="ISA 41:2">Li livre nasyon yo devan li e Li fè wa yo soumèt;</para>
  <para style="q1" vid="ISA 41:2">li fè yo tankou pousyè ak nepe li,</para>
  <para style="q1" vid="ISA 41:2">tankou pay k ap chase pa van devan banza li.<verse eid="ISA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 41:3"/>Li kouri dèyè yo, e Li pase san danje,</para>
  <para style="q1" vid="ISA 41:3">menm nan yon chemen kote li pa t konn pase ak pye li.<verse eid="ISA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 41:4"/>Se kilès ki te fè sa a e ki te acheve li;</para>
  <para style="q1" vid="ISA 41:4">ki te rele fè parèt tout jenerasyon yo soti nan kòmansman?</para>
  <para style="q1" vid="ISA 41:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">41:4 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 43:10">És 43:10</ref>
      </char>
    </note>Mwen, SENYÈ a, se premye a ak dènye a. Mwen se Li.”<verse eid="ISA 41:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 41:5"/>Peyi kot yo te wè e yo gen lakrent;</para>
  <para style="q1" vid="ISA 41:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">41:5 </char>
      <char style="xt" closed="false">
        <ref loc="JOS 5:1">Jos 5:1</ref>
      </char>
    </note>dènye pwent latè yo tranble.</para>
  <para style="q1" vid="ISA 41:5">Yo rapwoche; yo rive.<verse eid="ISA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 41:6"/>Chak moun ap ede vwazen li.</para>
  <para style="q1" vid="ISA 41:6">Yo di a frè yo: “Pran kouraj!”<verse eid="ISA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 41:7"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">41:7 </char><char style="xt" closed="false"><ref loc="ISA 44:12-13">És 44:12-13</ref></char></note>bòs atizan an ankouraje bòs fonn metal la.</para>
  <para style="q1" vid="ISA 41:7">Sila ki fè metal vin poli ak mato a</para>
  <para style="q1" vid="ISA 41:7">ankouraje sila k ap bat fè a.</para>
  <para style="q1" vid="ISA 41:7">Li di a sila k ap soude a: “Li bon”.</para>
  <para style="q1" vid="ISA 41:7">Li kloure li ak klou pou l rete nan plas li.<verse eid="ISA 41:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 41:8"/>Men ou menm, O Israël, <note caller="+" style="x"><char style="xo" closed="false">41:8 </char><char style="xt" closed="false"><ref loc="ISA 42:19">És 42:19</ref></char></note>sèvitè Mwen an,</para>
  <para style="q1" vid="ISA 41:8">Jacob ke M te chwazi a,</para>
  <para style="q1" vid="ISA 41:8">desandan Abraham nan, zami Mwen an;<verse eid="ISA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 41:9"/>ou menm, ke M te <note caller="+" style="x"><char style="xo" closed="false">41:9 </char><char style="xt" closed="false"><ref loc="ISA 11:11">És 11:11</ref></char></note>pran soti nan tout ekstremite latè yo,</para>
  <para style="q1" vid="ISA 41:9">e te rele soti nan kote pi izole yo pou te di ou:</para>
  <para style="q1" vid="ISA 41:9">‘Ou se sèvitè Mwen. Mwen te chwazi ou</para>
  <para style="q1" vid="ISA 41:9">e Mwen pa t rejte ou.’<verse eid="ISA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 41:10"/>Pa <note caller="+" style="x"><char style="xo" closed="false">41:10 </char><char style="xt" closed="false"><ref loc="DEU 20:1">Det 20:1</ref></char></note>pè, paske Mwen avèk ou.</para>
  <para style="q1" vid="ISA 41:10">Pa gade toupatou ak kè twouble, paske Mwen se Bondye ou.</para>
  <para style="q1" vid="ISA 41:10">Mwen va fòtifye ou.</para>
  <para style="q1" vid="ISA 41:10">Anverite Mwen va bay ou sekou.</para>
  <para style="q1" vid="ISA 41:10">Anverite Mwen va bay ou soutyen ak men ladwati,</para>
  <para style="q1" vid="ISA 41:10">men dwat Mwen.<verse eid="ISA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 41:11"/>Gade byen, <note caller="+" style="x"><char style="xo" closed="false">41:11 </char><char style="xt" closed="false"><ref loc="ISA 45:24">És 45:24</ref></char></note>tout sila ki fache ak ou yo</para>
  <para style="q1" vid="ISA 41:11">va vin wont e dezonore.</para>
  <para style="q1" vid="ISA 41:11">Sila k ap pran pòz kont ou yo va vin konsi</para>
  <para style="q1" vid="ISA 41:11">se pa anyen e yo va peri.<verse eid="ISA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 41:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">41:12 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 20:7-9">Job 20:7-9</ref>
      </char>
    </note>Ou va chache sila k ap fè pwoblèm ak ou yo,</para>
  <para style="q1" vid="ISA 41:12">men ou p ap jwenn yo.</para>
  <para style="q1" vid="ISA 41:12">Sila ki fè lagè ak ou yo va vin konsi</para>
  <para style="q1" vid="ISA 41:12">se pa anyen e yo p ap egziste ankò.<verse eid="ISA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 41:13"/>Paske Mwen se SENYÈ a, Bondye ou a,</para>
  <para style="q1" vid="ISA 41:13">ki soutni men dwat Ou,</para>
  <para style="q1" vid="ISA 41:13">ki di ou, pa pè, Mwen va ba ou sekou.<verse eid="ISA 41:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 41:14"/>“Pinga ou pè, ou menm, <note caller="+" style="x"><char style="xo" closed="false">41:14 </char><char style="xt" closed="false"><ref loc="JOB 25:6">Job 25:6</ref></char></note>vètè Jacob la,</para>
  <para style="q1" vid="ISA 41:14">nou menm mesye Israël yo.</para>
  <para style="q1" vid="ISA 41:14">Mwen va ede nou”, deklare SENYÈ a.</para>
  <para style="q1" vid="ISA 41:14">“Redanmtè ou a se Sila Ki Sen an Israël la.<verse eid="ISA 41:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 41:15"/>Gade byen, Mwen te fè ou vin yon zouti tounèf,</para>
  <para style="q1" vid="ISA 41:15">byen file tou de bò, pou kraze vannen rekòlt la.</para>
  <para style="q1" vid="ISA 41:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">41:15 </char>
      <char style="xt" closed="false">
        <ref loc="MIC 4:13">Mi 4:13</ref>
      </char>
    </note>Ou va vannen mòn yo, kraze yo fen,</para>
  <para style="q1" vid="ISA 41:15">e fè kolin yo vin tankou pay.<verse eid="ISA 41:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 41:16"/>Ou va <note caller="+" style="x"><char style="xo" closed="false">41:16 </char><char style="xt" closed="false"><ref loc="JER 51:2">Jr 51:2</ref></char></note>vannen yo;</para>
  <para style="q1" vid="ISA 41:16">van a va pote yo ale e tanpèt va gaye yo.</para>
  <para style="q1" vid="ISA 41:16">Men ou va rejwi nan SENYÈ a;</para>
  <para style="q1" vid="ISA 41:16">ou va fè lwanj Sila Ki Sen an Israël la.<verse eid="ISA 41:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 41:17"/>Aflije yo ak malere yo ap chache dlo, men nanpwen;</para>
  <para style="q1" vid="ISA 41:17">lang yo sèch ak swaf la.</para>
  <para style="q1" vid="ISA 41:17">Mwen menm, SENYÈ a, <note caller="+" style="x"><char style="xo" closed="false">41:17 </char><char style="xt" closed="false"><ref loc="ISA 30:19">És 30:19</ref></char></note>va reponn yo.</para>
  <para style="q1" vid="ISA 41:17">Mwen, Bondye Israël la p ap abandone yo.<verse eid="ISA 41:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 41:18"/>Mwen va ouvri rivyè yo sou wotè ki vid yo</para>
  <para style="q1" vid="ISA 41:18">ak sous nan mitan vale yo.</para>
  <para style="q1" vid="ISA 41:18">Mwen va fè <note caller="+" style="x"><char style="xo" closed="false">41:18 </char><char style="xt" closed="false"><ref loc="PSA 107:35">Sòm 107:35</ref></char></note>dezè a vin yon letan dlo,</para>
  <para style="q1" vid="ISA 41:18">e tè sèch la yon fontèn dlo.<verse eid="ISA 41:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 41:19"/>Mwen va plase pye sèd nan dezè a,</para>
  <para style="q1" vid="ISA 41:19">pye akasya, ak pye jasmen ak pye doliv.</para>
  <para style="q1" vid="ISA 41:19">Mwen va mete pye pichpen nan dezè a ansanm ak pye bwadòm;<verse eid="ISA 41:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 41:20"/>pou yo ka wè, vin rekonèt,</para>
  <para style="q1" vid="ISA 41:20">reflechi e ranmase bon konprann ansanm,</para>
  <para style="q1" vid="ISA 41:20">ke <note caller="+" style="x"><char style="xo" closed="false">41:20 </char><char style="xt" closed="false"><ref loc="JOB 12:9">Job 12:9</ref></char></note>men SENYÈ a te fè sa,</para>
  <para style="q1" vid="ISA 41:20">ke Sila Ki Sen an Israël te kreye li a.<verse eid="ISA 41:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 41:21"/>“Prezante ka nou yo”, pale SENYÈ a.</para>
  <para style="q1" vid="ISA 41:21">“Pote gwo diskou nou yo”, pale Wa a Jacob la.<verse eid="ISA 41:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 41:22"/>Mennen fè yo vin parèt</para>
  <para style="q1" vid="ISA 41:22">e deklare a nou menm sa ki va rive!</para>
  <para style="q1" vid="ISA 41:22">Epi pou <note caller="+" style="x"><char style="xo" closed="false">41:22 </char><char style="xt" closed="false"><ref loc="ISA 43:9">És 43:9</ref></char></note>evenman lontan yo, deklare kisa</para>
  <para style="q1" vid="ISA 41:22">yo te ye, pou nou ka konsidere yo,</para>
  <para style="q1" vid="ISA 41:22">e konnen kijan y ap sòti.</para>
  <para style="q1" vid="ISA 41:22">Oswa, anonse a nou menm sa k ap vini an.<verse eid="ISA 41:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 41:23"/>Deklare bagay ki va vin rive apre yo,</para>
  <para style="q1" vid="ISA 41:23">pou nou ka konnen ke se dye nou ye.</para>
  <para style="q1" vid="ISA 41:23">Anverite, <note caller="+" style="x"><char style="xo" closed="false">41:23 </char><char style="xt" closed="false"><ref loc="JER 10:5">Jr 10:5</ref></char></note>fè byen, oswa fè mal, pou nou ka</para>
  <para style="q1" vid="ISA 41:23">gade toupatou ansanm ak kè twouble.<verse eid="ISA 41:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 41:24"/>Gade byen, nou pou ryen e zèv nou yo pa pou anyen.</para>
  <para style="q1" vid="ISA 41:24">Sila ki pito nou an se yon abominnasyon.<verse eid="ISA 41:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 41:25"/>Mwen te fè leve <note caller="+" style="x"><char style="xo" closed="false">41:25 </char><char style="xt" closed="false"><ref loc="ISA 41:2">És 41:2</ref></char></note>yon moun soti nan nò e li vin parèt;</para>
  <para style="q1" vid="ISA 41:25">depi nan solèy leve a, li va rele non Mwen;</para>
  <para style="q1" vid="ISA 41:25">li va vini sou chèf yo, kon sou mòtye,</para>
  <para style="q1" vid="ISA 41:25">tankou bòs kanari mache sou ajil.<verse eid="ISA 41:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 41:26"/>Se kilès ki te <note caller="+" style="x"><char style="xo" closed="false">41:26 </char><char style="xt" closed="false"><ref loc="ISA 41:22">És 41:22</ref></char></note>deklare sa depi nan kòmansman an,</para>
  <para style="q1" vid="ISA 41:26">pou nou ta ka konnen?</para>
  <para style="q1" vid="ISA 41:26">Oswa depi tan ansyen yo, pou nou ta kapab di: “Li se vrè”?</para>
  <para style="q1" vid="ISA 41:26">San dout, pa t gen moun ki te deklare sa;</para>
  <para style="q1" vid="ISA 41:26">san dout, pa t gen moun ki te pwoklame sa;</para>
  <para style="q1" vid="ISA 41:26">san dout, pa t gen moun ki te tande pawòl sila yo.<verse eid="ISA 41:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 41:27"/>Mwen se premye pou di a Sion:</para>
  <para style="q1" vid="ISA 41:27">‘Men vwala, men yo la;’</para>
  <para style="q1" vid="ISA 41:27">epi a Jérusalem: ‘Mwen va voye yon <note caller="+" style="x"><char style="xo" closed="false">41:27 </char><char style="xt" closed="false"><ref loc="ISA 40:9">És 40:9</ref></char></note>mesaje bòn nouvèl’.<verse eid="ISA 41:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 41:28"/>Men <note caller="+" style="x"><char style="xo" closed="false">41:28 </char><char style="xt" closed="false"><ref loc="ISA 50:2">És 50:2</ref></char></note>lè M gade, nanpwen pèsòn e pa gen konseye pami yo,</para>
  <para style="q1" vid="ISA 41:28">ki, si M te mande, ta kapab bay yon repons.<verse eid="ISA 41:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 41:29"/>Gade byen, yo tout fo. Zèv yo san valè.</para>
  <para style="q1" vid="ISA 41:29">Imaj fonn yo se <note caller="+" style="x"><char style="xo" closed="false">41:29 </char><char style="xt" closed="false"><ref loc="JER 5:13">Jr 5:13</ref></char></note>van ak konfizyon.<verse eid="ISA 41:29"/></para>
  <chapter eid="ISA 41"/>
  <chapter number="42" style="c" sid="ISA 42"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 42:1"/>“Gade byen, men Sèvitè Mwen an, ke M ap soutni an;</para>
  <para style="q1" vid="ISA 42:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">42:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 9:35">Luc 9:35</ref>
      </char>
    </note>sila ke M chwazi a, ki fè nanm Mwen plezi a.</para>
  <para style="q1" vid="ISA 42:1">Mwen te mete Lespri M sou Li.</para>
  <para style="q1" vid="ISA 42:1">Li va mennen fè lajistis vin parèt devan nasyon yo.<verse eid="ISA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 42:2"/>Li p ap kriye menm,</para>
  <para style="q1" vid="ISA 42:2">ni leve vwa l,</para>
  <para style="q1" vid="ISA 42:2">ni fè vwa l tande nan lari.<verse eid="ISA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 42:3"/>Yon wozo ki brize, Li p ap kase,</para>
  <para style="q1" vid="ISA 42:3">e yon fisèl bouji ki brile fèb,</para>
  <para style="q1" vid="ISA 42:3">Li p ap etenn.</para>
  <para style="q1" vid="ISA 42:3">Ak fidelite, Li va mennen <note caller="+" style="x"><char style="xo" closed="false">42:3 </char><char style="xt" closed="false"><ref loc="PSA 72:2-4">Sòm 72:2-4</ref></char></note>lajistis</para>
  <para style="q1" vid="ISA 42:3">e fè l vin parèt.<verse eid="ISA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 42:4"/>Li p ap <note caller="+" style="x"><char style="xo" closed="false">42:4 </char><char style="xt" closed="false"><ref loc="ISA 40:28">És 40:28</ref></char></note>dekouraje oswa vin kraze</para>
  <para style="q1" vid="ISA 42:4">jiskaske Li etabli lajistis sou tout latè,</para>
  <para style="q1" vid="ISA 42:4">epi peyi kot yo va tann lalwa Li.”<verse eid="ISA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 42:5"/>Konsa pale Bondye SENYÈ a</para>
  <para style="q1" vid="ISA 42:5">ki te <note caller="+" style="x"><char style="xo" closed="false">42:5 </char><char style="xt" closed="false"><ref loc="PSA 102:25-26">Sòm 102:25-26</ref></char></note>kreye syèl yo e ki tann yo,</para>
  <para style="q1" vid="ISA 42:5">ki te fè latè vin laj ak tout sa ki viv ladann,</para>
  <para style="q1" vid="ISA 42:5">ki bay souf a tout pèp ki vivan sou li,</para>
  <para style="q1" vid="ISA 42:5">e lespri lavi a tout moun ki mache ladann,<verse eid="ISA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 42:6"/>Mwen menm se SENYÈ a.</para>
  <para style="q1" vid="ISA 42:6">Mwen te <note caller="+" style="x"><char style="xo" closed="false">42:6 </char><char style="xt" closed="false"><ref loc="ISA 41:2">És 41:2</ref></char></note>rele Ou nan ladwati.</para>
  <para style="q1" vid="ISA 42:6">Anplis, Mwen va kenbe Ou nan men.</para>
  <para style="q1" vid="ISA 42:6">Mwen va pran swen Ou.</para>
  <para style="q1" vid="ISA 42:6">Mwen va chwazi Ou kon yon akò pou pèp la,</para>
  <para style="q1" vid="ISA 42:6">kon yon limyè pou nasyon yo,<verse eid="ISA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 42:7"/>pou <note caller="+" style="x"><char style="xo" closed="false">42:7 </char><char style="xt" closed="false"><ref loc="ISA 29:18">És 29:18</ref></char></note>ouvri zye avèg yo,</para>
  <para style="q1" vid="ISA 42:7">pou mennen prizonye yo sòti nan kacho a,</para>
  <para style="q1" vid="ISA 42:7">e fè sila ki viv nan tenèb yo sòti nan prizon an.<verse eid="ISA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 42:8"/>“Mwen se SENYÈ a.</para>
  <para style="q1" vid="ISA 42:8">Sa se non Mwen.</para>
  <para style="q1" vid="ISA 42:8">Mwen p ap bay <note caller="+" style="x"><char style="xo" closed="false">42:8 </char><char style="xt" closed="false"><ref loc="EXO 20:3-5">Egz 20:3-5</ref></char></note>glwa Mwen a yon lòt,</para>
  <para style="q1" vid="ISA 42:8">ni lwanj Mwen a imaj taye.<verse eid="ISA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 42:9"/>Gade byen, <note caller="+" style="x"><char style="xo" closed="false">42:9 </char><char style="xt" closed="false"><ref loc="ISA 48:3">És 48:3</ref></char></note> ansyen bagay yo te fin akonpli;</para>
  <para style="q1" vid="ISA 42:9">koulye a, Mwen deklare bagay nèf yo.</para>
  <para style="q1" vid="ISA 42:9">Avan yo leve vin parèt, Mwen pwoklame yo a nou menm.”<verse eid="ISA 42:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10"/>Chante a SENYÈ a yon chan tounèf,</para>
  <para style="q1" vid="ISA 42:10">lwanj Li jis rive nan <note caller="+" style="x"><char style="xo" closed="false">42:10 </char><char style="xt" closed="false"><ref loc="ISA 49:6">És 49:6</ref></char></note> dènye pwent latè!</para>
  <para style="q1" vid="ISA 42:10">Nou menm ki desann nan lanmè a, ak tout sa ki ladann,</para>
  <para style="q1" vid="ISA 42:10">nou menm lil yo ak sila ki viv sou yo.<verse eid="ISA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11"/>Kite <note caller="+" style="x"><char style="xo" closed="false">42:11 </char><char style="xt" closed="false"><ref loc="ISA 32:16">És 32:16</ref></char></note>dezè a ak vil li yo leve vwa yo;</para>
  <para style="q1" vid="ISA 42:11">anplasman kote Kédar rete a.</para>
  <para style="q1" vid="ISA 42:11">Kite sila ki rete nan Sela la chante anlè;</para>
  <para style="q1" vid="ISA 42:11">kite yo chante ak kè kontan soti nan wotè mòn yo.<verse eid="ISA 42:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12"/>Kite yo <note caller="+" style="x"><char style="xo" closed="false">42:12 </char><char style="xt" closed="false"><ref loc="ISA 24:15">És 24:15</ref></char></note>bay glwa a SENYÈ a</para>
  <para style="q1" vid="ISA 42:12">e deklare lwanj Li nan peyi kot yo.<verse eid="ISA 42:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">42:13 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:3">Egz 15:3</ref>
      </char>
    </note>SENYÈ a va avanse tankou yon gèrye,</para>
  <para style="q1" vid="ISA 42:13">li va chofe zèl Li tankou yon nonm lagè.</para>
  <para style="q1" vid="ISA 42:13">Li va kriye fò, wi Li va leve yon kri lagè.</para>
  <para style="q1" vid="ISA 42:13">Li va enpoze Li sou lènmi Li yo.<verse eid="ISA 42:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">42:14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:21">Sòm 50:21</ref>
      </char>
    </note>Mwen te rete an silans depi lontan sa.</para>
  <para style="q1" vid="ISA 42:14">Mwen te rete kalm e te kontwole Mwen.</para>
  <para style="q1" vid="ISA 42:14">Koulye a, tankou yon fanm k ap fè pitit, Mwen va plenyen.</para>
  <para style="q1" vid="ISA 42:14">Mwen va rale gwo souf e respire fò.<verse eid="ISA 42:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">42:15 </char><char style="xt" closed="false"><ref loc="ISA 2:12-16">És 2:12-16</ref></char></note>ravaje tout mòn yo ak kolin yo,</para>
  <para style="q1" vid="ISA 42:15">e zèb ak raje yo va vin fennen nèt.</para>
  <para style="q1" vid="ISA 42:15">Mwen va fè rivyè lafen lil yo, e seche letan.<verse eid="ISA 42:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">42:16 </char><char style="xt" closed="false"><ref loc="ISA 29:18">És 29:18</ref></char></note>mennen avèg yo pa yon chemen yo pa konnen,</para>
  <para style="q1" vid="ISA 42:16">nan wout yo pa konnen, Mwen va gide yo.</para>
  <para style="q1" vid="ISA 42:16">Mwen va fè tenèb la vin limyè devan yo</para>
  <para style="q1" vid="ISA 42:16">e move kote yo va vin plat.</para>
  <para style="q1" vid="ISA 42:16">Se bagay sa yo Mwen va fè</para>
  <para style="q1" vid="ISA 42:16">e Mwen p ap kite yo pa fèt.<verse eid="ISA 42:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17"/>“Sila ki mete konfyans yo nan zidòl yo</para>
  <para style="q1" vid="ISA 42:17">e ki di a imaj fonn yo:</para>
  <para style="q1" vid="ISA 42:17">‘Se nou menm ki dye pa nou’,</para>
  <para style="q1" vid="ISA 42:17">va voye tounen pa dèyè e va <note caller="+" style="x"><char style="xo" closed="false">42:17 </char><char style="xt" closed="false"><ref loc="PSA 97:7">Sòm 97:7</ref></char></note>vin wont nèt.<verse eid="ISA 42:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 42:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">42:18 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 29:18">És 29:18</ref>
      </char>
    </note>“Tande, nou menm ki soud!</para>
  <para style="q1" vid="ISA 42:18">Epi gade, nou menm ki avèg, pou nou ka wè.<verse eid="ISA 42:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 42:19"/>Se kilès ki avèg sof ke <note caller="+" style="x"><char style="xo" closed="false">42:19 </char><char style="xt" closed="false"><ref loc="ISA 41:8">És 41:8</ref></char></note>sèvitè Mwen an,</para>
  <para style="q1" vid="ISA 42:19">oswa tèlman soud tankou mesaje ke Mwen voye a?</para>
  <para style="q1" vid="ISA 42:19">Se kilès ki avèg tankou sila ki anpè avè M,</para>
  <para style="q1" vid="ISA 42:19">oswa tèlman avèg tankou sèvitè a SENYÈ a?<verse eid="ISA 42:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 42:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">42:20 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 2:21">Wo 2:21</ref>
      </char>
    </note>Nou te wè anpil bagay, men nou pa swiv yo;</para>
  <para style="q1" vid="ISA 42:20">zòrèy nou louvri, men nanpwen moun ki tande.<verse eid="ISA 42:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 42:21"/>SENYÈ a te kontan pou koz ladwati Li;</para>
  <para style="q1" vid="ISA 42:21">pou fè lalwa a <note caller="+" style="x"><char style="xo" closed="false">42:21 </char><char style="xt" closed="false"><ref loc="ISA 42:4">És 42:4</ref></char></note>gran e plen respe.<verse eid="ISA 42:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 42:22"/>Men pèp sa a se yon pèp depouye e piyaje.</para>
  <para style="q1" vid="ISA 42:22">Yo tout <note caller="+" style="x"><char style="xo" closed="false">42:22 </char><char style="xt" closed="false"><ref loc="ISA 24:18">És 24:18</ref></char></note>kole nan kav yo oswa</para>
  <para style="q1" vid="ISA 42:22">kache nan prizon yo.</para>
  <para style="q1" vid="ISA 42:22">Yo devni viktim san okenn moun ki pou delivre yo;</para>
  <para style="q1" vid="ISA 42:22">yon piyaj san okenn moun ki pou di:</para>
  <para style="q1" vid="ISA 42:22">“Restore yo!”<verse eid="ISA 42:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 42:23"/>Se kilès pami nou k ap prete zòrèy a sa a?</para>
  <para style="q1" vid="ISA 42:23">Kilès k ap okipe sa e kòmanse koute depi koulye a?<verse eid="ISA 42:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 42:24"/>Se kilès ki te livre Jacob pou l depouye</para>
  <para style="q1" vid="ISA 42:24">e Israël a piyajè yo?</para>
  <para style="q1" vid="ISA 42:24">Èske se pa t SENYÈ a, kont sila nou te peche a?</para>
  <para style="q1" vid="ISA 42:24">Paske yo te refize mache nan chemen Li yo;</para>
  <para style="q1" vid="ISA 42:24">ni yo pa t swiv lalwa Li.<verse eid="ISA 42:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 42:25"/>Pou sa, Li te vide sou li chalè kòlè Li</para>
  <para style="q1" vid="ISA 42:25">ak <note caller="+" style="x"><char style="xo" closed="false">42:25 </char><char style="xt" closed="false"><ref loc="ISA 5:25">És 5:25</ref></char></note>fòs kouraj batay la.</para>
  <para style="q1" vid="ISA 42:25">Sa te fè l pran flanm toupatou,</para>
  <para style="q1" vid="ISA 42:25">men li pa t rekonèt sa a.</para>
  <para style="q1" vid="ISA 42:25">Li t ap brile l, men li pa t okipe sa.”<verse eid="ISA 42:25"/></para>
  <chapter eid="ISA 42"/>
  <chapter number="43" style="c" sid="ISA 43"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 43:1"/>Men koulye a, konsa pale SENYÈ a, <note caller="+" style="x"><char style="xo" closed="false">43:1 </char><char style="xt" closed="false"><ref loc="ISA 43:15">És 43:15</ref></char></note>Kreyatè ou a, O Jacob,</para>
  <para style="q1" vid="ISA 43:1">e Sila ki te fòme ou a, O Israël:</para>
  <para style="q1" vid="ISA 43:1">“Pa pè, paske Mwen te rachte ou.</para>
  <para style="q1" vid="ISA 43:1">Mwen te rele ou pa non ou.</para>
  <para style="q1" vid="ISA 43:1">Se pa M ou ye!<verse eid="ISA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 43:2"/>Lè w ap <note caller="+" style="x"><char style="xo" closed="false">43:2 </char><char style="xt" closed="false"><ref loc="PSA 66:12">Sòm 66:12</ref></char></note>pase nan gwo dlo yo,</para>
  <para style="q1" vid="ISA 43:2">Mwen va la avèk ou;</para>
  <para style="q1" vid="ISA 43:2">epi nan rivyè yo,</para>
  <para style="q1" vid="ISA 43:2">yo p ap debòde sou ou.</para>
  <para style="q1" vid="ISA 43:2">Lè w ap mache nan dife a, ou p ap brile,</para>
  <para style="q1" vid="ISA 43:2">ni flanm nan p ap brile ou.<verse eid="ISA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 43:3"/>Paske Mwen se SENYÈ a, Bondye ou a,</para>
  <para style="q1" vid="ISA 43:3">Sila Ki Sen en Israël la, <note caller="+" style="x"><char style="xo" closed="false">43:3 </char><char style="xt" closed="false"><ref loc="ISA 19:20">És 19:20</ref></char></note>Sovè ou a.</para>
  <para style="q1" vid="ISA 43:3">Mwen te bay Égypte kon ranson ou</para>
  <para style="q1" vid="ISA 43:3">Cush ak Saba nan plas ou.<verse eid="ISA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 43:4"/>Akoz ou <note caller="+" style="x"><char style="xo" closed="false">43:4 </char><char style="xt" closed="false"><ref loc="EXO 19:5-6">Egz 19:5-6</ref></char></note>presye nan zye M,</para>
  <para style="q1" vid="ISA 43:4">akoz ou gen gran valè</para>
  <para style="q1" vid="ISA 43:4">e Mwen renmen ou,</para>
  <para style="q1" vid="ISA 43:4">Mwen va bay lòt moun nan plas ou</para>
  <para style="q1" vid="ISA 43:4">e lòt pèp an echanj pou lavi ou.<verse eid="ISA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 43:5"/>Pa pè, paske <note caller="+" style="x"><char style="xo" closed="false">43:5 </char><char style="xt" closed="false"><ref loc="ISA 8:10">És 8:10</ref></char></note>Mwen avèk ou;</para>
  <para style="q1" vid="ISA 43:5">Mwen va mennen desandan ou yo soti nan lès</para>
  <para style="q1" vid="ISA 43:5">e ranmase ou nan lwès.<verse eid="ISA 43:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 43:6"/>Mwen va di a <note caller="+" style="x"><char style="xo" closed="false">43:6 </char><char style="xt" closed="false"><ref loc="ISA 8:10">És 8:10</ref></char></note>nò: ‘Lage yo!’</para>
  <para style="q1" vid="ISA 43:6">Epi a sid: ‘Pa anpeche yo!’</para>
  <para style="q1" vid="ISA 43:6">Mennen fis Mwen yo soti lwen</para>
  <para style="q1" vid="ISA 43:6">e fi Mwen yo soti nan dènye pwent latè yo—<verse eid="ISA 43:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 43:7"/>tout moun ki rele pa non Mwen</para>
  <para style="q1" vid="ISA 43:7">e ke Mwen te <note caller="+" style="x"><char style="xo" closed="false">43:7 </char><char style="xt" closed="false"><ref loc="PSA 100:3">Sòm 100:3</ref></char></note>kreye pou glwa Mwen,</para>
  <para style="q1" vid="ISA 43:7">ke M te fòme, menm sa ke m te fè.”<verse eid="ISA 43:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 43:8"/>Mennen fè parèt pèp ki <note caller="+" style="x"><char style="xo" closed="false">43:8 </char><char style="xt" closed="false"><ref loc="ISA 6:9">És 6:9</ref></char></note>avèg la, malgre yo gen zye</para>
  <para style="q1" vid="ISA 43:8">e soud la, malgre yo gen zòrèy.<verse eid="ISA 43:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 43:9"/>Kite tout nasyon yo <note caller="+" style="x"><char style="xo" closed="false">43:9 </char><char style="xt" closed="false"><ref loc="ISA 34:1">És 34:1</ref></char></note>reyini ansanm</para>
  <para style="q1" vid="ISA 43:9">e tout pèp yo rasanble.</para>
  <para style="q1" vid="ISA 43:9">Kilès pami yo ki kapab deklare sa</para>
  <para style="q1" vid="ISA 43:9">e pwoklame a nou menm bagay a tan ansyen yo?</para>
  <para style="q1" vid="ISA 43:9">Kite yo prezante temwen pa yo pou yo ka jistifye,</para>
  <para style="q1" vid="ISA 43:9">oswa kite yo tande e di: “Sa se vrè”.<verse eid="ISA 43:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 43:10"/>“Nou se temwen Mwen,” deklare SENYÈ a,</para>
  <para style="q1" vid="ISA 43:10">“Ak sèvitè ke M te chwazi;</para>
  <para style="q1" vid="ISA 43:10">pou nou ka konnen, kwè nan Mwen</para>
  <para style="q1" vid="ISA 43:10">e konprann ke <note caller="+" style="x"><char style="xo" closed="false">43:10 </char><char style="xt" closed="false"><ref loc="ISA 41:4">És 41:4</ref></char></note>Mwen se Li menm nan.</para>
  <para style="q1" vid="ISA 43:10">Avan Mwen, pa t gen lòt Bondye ki te fòme</para>
  <para style="q1" vid="ISA 43:10">e apre Mwen, p ap gen menm.<verse eid="ISA 43:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 43:11"/>Mwen menm, Mwen se SENYÈ a e nanpwen <note caller="+" style="x"><char style="xo" closed="false">43:11 </char><char style="xt" closed="false"><ref loc="ISA 43:3">És 43:3</ref></char></note>sovè</para>
  <para style="q1" vid="ISA 43:11">apa de Mwen menm.<verse eid="ISA 43:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 43:12"/>Se Mwen ki te deklare, sove, pwoklame</para>
  <para style="q1" vid="ISA 43:12">e pat genyen <note caller="+" style="x"><char style="xo" closed="false">43:12 </char><char style="xt" closed="false"><ref loc="DEU 32:16">Det 32:16</ref></char></note>dye etranje pami nou.</para>
  <para style="q1" vid="ISA 43:12">Konsa, nou se temwen M”,</para>
  <para style="q1" vid="ISA 43:12">deklare SENYÈ a:</para>
  <para style="q1" vid="ISA 43:12">“Epi Mwen se Bondye.<verse eid="ISA 43:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 43:13"/>Menm depi nan letènite, Mwen se Li menm</para>
  <para style="q1" vid="ISA 43:13">e <note caller="+" style="x"><char style="xo" closed="false">43:13 </char><char style="xt" closed="false"><ref loc="PSA 50:22">Sòm 50:22</ref></char></note>pa genyen moun ki ka delivre fè sòti nan men M;</para>
  <para style="q1" vid="ISA 43:13">Mwen aji e se kilès ki ka ranvèse l?”<verse eid="ISA 43:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 43:14"/>Konsa pale SENYÈ a, <note caller="+" style="x"><char style="xo" closed="false">43:14 </char><char style="xt" closed="false"><ref loc="ISA 41:14">És 41:14</ref></char></note>Redanmtè nou an, Sila Ki Sen an Israël la; “Pou koz nou, Mwen voye kote Babylone e Mwen va mennen yo tout desann kote nou kon kaptif, menm Kaldeyen yo nan bato anndan sila yo rejwi yo. <verse eid="ISA 43:14"/><verse number="15" style="v" sid="ISA 43:15"/>Mwen se SENYÈ a, Sila Ki Sen pa nou an, <note caller="+" style="x"><char style="xo" closed="false">43:15 </char><char style="xt" closed="false"><ref loc="ISA 43:1">És 43:1</ref></char></note>Kreyatè Israël la, Wa nou an.”<verse eid="ISA 43:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 43:16"/>Konsa pale SENYÈ a, ki <note caller="+" style="x"><char style="xo" closed="false">43:16 </char><char style="xt" closed="false"><ref loc="EXO 14:21-22">Egz 14:21-22</ref></char></note>fè yon wout sou lanmè a,</para>
  <para style="q1" vid="ISA 43:16">e yon chemen nan dlo pwisan yo,<verse eid="ISA 43:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 43:17"/>Ki mennen fè parèt <note caller="+" style="x"><char style="xo" closed="false">43:17 </char><char style="xt" closed="false"><ref loc="EXO 15:19">Egz 15:19</ref></char></note>cha avèk cheval la,</para>
  <para style="q1" vid="ISA 43:17">lame ak mesye pwisan a</para>
  <para style="q1" vid="ISA 43:17">(Yo va kouche ansanm e yo p ap leve ankò;</para>
  <para style="q1" vid="ISA 43:17">yo te etenn tankou yon fisèl bouji):<verse eid="ISA 43:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 43:18"/>Pa kite ansyen bagay yo antre nan tèt nou,</para>
  <para style="q1" vid="ISA 43:18">ni reflechi sou bagay ki fin pase.<verse eid="ISA 43:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 43:19"/>Gade byen, Mwen va fè yon bagay <note caller="+" style="x"><char style="xo" closed="false">43:19 </char><char style="xt" closed="false"><ref loc="ISA 42:9">És 42:9</ref></char></note>tounèf;</para>
  <para style="q1" vid="ISA 43:19">koulye a, li va pete vin parèt.</para>
  <para style="q1" vid="ISA 43:19">Èske nou p ap rekonèt li?</para>
  <para style="q1" vid="ISA 43:19">Menm yon chemen nan dezè a Mwen va fè,</para>
  <para style="q1" vid="ISA 43:19">ak rivyè yo nan dezè a.<verse eid="ISA 43:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 43:20"/>Bèt nan chan yo va bay glwa a Mwen menm,</para>
  <para style="q1" vid="ISA 43:20">chen mawon nan chan yo ak otrich yo,</para>
  <para style="q1" vid="ISA 43:20">akoz Mwen te <note caller="+" style="x"><char style="xo" closed="false">43:20 </char><char style="xt" closed="false"><ref loc="ISA 41:17-18">És 41:17-18</ref></char></note>bay dlo nan savann nan</para>
  <para style="q1" vid="ISA 43:20">e rivyè nan dezè a pou pèp chwazi Mwen an ka bwè.<verse eid="ISA 43:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 43:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">43:21 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 43:1">És 43:1</ref>
      </char>
    </note>Pèp ke M te fòme pou Mwen an va deklare lwanj Mwen.<verse eid="ISA 43:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 43:22"/>Men ou pa t rele Mwen, O Jacob;</para>
  <para style="q1" vid="ISA 43:22">men ou te<note caller="+" style="x"><char style="xo" closed="false">43:22 </char><char style="xt" closed="false"><ref loc="MIC 6:3">Mi 6:3</ref></char></note>vin fatige ak Mwen, O Israël.<verse eid="ISA 43:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 43:23"/>Ou <note caller="+" style="x"><char style="xo" closed="false">43:23 </char><char style="xt" closed="false"><ref loc="AMO 5:25">Am 5:25</ref></char></note>pa t mennen ban Mwen mouton a ofrann brile ou yo,</para>
  <para style="q1" vid="ISA 43:23">ni ou pa t onore M ak ofrann brile ou yo,</para>
  <para style="q1" vid="ISA 43:23">ni ou pa t onore M ak sakrifis ou yo.</para>
  <para style="q1" vid="ISA 43:23">Mwen pa t mete gwo fado sou ou ak ofrann yo,</para>
  <para style="q1" vid="ISA 43:23">ni fè ou fatige ak lansan.<verse eid="ISA 43:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 43:24"/>Ou pa t mennen ban M kann dous ak lajan,</para>
  <para style="q1" vid="ISA 43:24">ni ou pa t plen M ak grès a sakrifis ou yo.</para>
  <para style="q1" vid="ISA 43:24">Olye de sa, ou te chaje Mwen ak peche ou yo.</para>
  <para style="q1" vid="ISA 43:24">Ou te <note caller="+" style="x"><char style="xo" closed="false">43:24 </char><char style="xt" closed="false"><ref loc="PSA 95:10">Sòm 95:10</ref></char></note>fatige M ak inikite ou yo.<verse eid="ISA 43:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 43:25"/>Mwen menm, Mwen se Sila ki <note caller="+" style="x"><char style="xo" closed="false">43:25 </char><char style="xt" closed="false"><ref loc="ISA 44:22">És 44:22</ref></char></note>efase transgresyon ou yo,</para>
  <para style="q1" vid="ISA 43:25">pou koz Mwen;</para>
  <para style="q1" vid="ISA 43:25">e Mwen p ap sonje peche ou yo.<verse eid="ISA 43:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 43:26"/>Mete M nan memwa ou.</para>
  <para style="q1" vid="ISA 43:26">
    <note caller="+" style="x">
      <char style="xo" closed="false">43:26 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:18">És 1:18</ref>
      </char>
    </note>Annou diskite ka nou ansanm.</para>
  <para style="q1" vid="ISA 43:26">Prezante ka ou pou ou ka jistifye ak eprèv ou.<verse eid="ISA 43:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 43:27"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">43:27 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 51:2">És 51:2</ref>
      </char>
    </note>Premye zansèt ou yo te peche,</para>
  <para style="q1" vid="ISA 43:27">e enstriktè ou yo te trangrese kont Mwen.<verse eid="ISA 43:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 43:28"/>Pou sa, Mwen va deklare prens a sanktyè yo pa pwòp;</para>
  <para style="q1" vid="ISA 43:28">Mwen va fè Jacob yon malediksyon,</para>
  <para style="q1" vid="ISA 43:28">e Israël kon yon <note caller="+" style="x"><char style="xo" closed="false">43:28 </char><char style="xt" closed="false"><ref loc="PSA 79:4">Sòm 79:4</ref></char></note>repwòch.<verse eid="ISA 43:28"/></para>
  <chapter eid="ISA 43"/>
  <chapter number="44" style="c" sid="ISA 44"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 44:1"/>“Men koulye a, koute, O Jacob, <note caller="+" style="x"><char style="xo" closed="false">44:1 </char><char style="xt" closed="false"><ref loc="ISA 41:8">És 41:8</ref></char></note>sèvitè Mwen an;</para>
  <para style="q1" vid="ISA 44:1">Israël ke M te chwazi a.<verse eid="ISA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 44:2"/>Konsa pale SENYÈ ki te fè ou a,</para>
  <para style="q1" vid="ISA 44:2">ki te fòme ou soti nan vant lan,</para>
  <para style="q1" vid="ISA 44:2">ki va bay ou soutyen,</para>
  <para style="q1" vid="ISA 44:2">kap di: ‘Pa pè, O Jacob, sèvitè Mwen an;</para>
  <para style="q1" vid="ISA 44:2">ak ou menm <note caller="+" style="x"><char style="xo" closed="false">44:2 </char><char style="xt" closed="false"><ref loc="DEU 32:15">Det 32:15</ref></char></note>Israël ke M te chwazi a.<verse eid="ISA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 44:3"/>Paske Mwen va vide dlo sou yon tè ki swaf</para>
  <para style="q1" vid="ISA 44:3">e vwa dlo sou tè ki sèch.</para>
  <para style="q1" vid="ISA 44:3">Mwen va <note caller="+" style="x"><char style="xo" closed="false">44:3 </char><char style="xt" closed="false"><ref loc="ISA 32:15">És 32:15</ref></char></note>vide Lespri M sou ras ou</para>
  <para style="q1" vid="ISA 44:3">e benediksyon sou desandan ou yo;<verse eid="ISA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 44:4"/>konsa, yo va vin vòltije pami zèb</para>
  <para style="q1" vid="ISA 44:4">kon <note caller="+" style="x"><char style="xo" closed="false">44:4 </char><char style="xt" closed="false"><ref loc="LEV 23:40">Lev 23:40</ref></char></note>bwa akote sous dlo.’<verse eid="ISA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 44:5"/>Sila a va di: ‘Mwen pou SENYÈ a;’</para>
  <para style="q1" vid="ISA 44:5">epi lòt la va rele sou non Jacob;</para>
  <para style="q1" vid="ISA 44:5">epi yon lòt va <note caller="+" style="x"><char style="xo" closed="false">44:5 </char><char style="xt" closed="false"><ref loc="EXO 13:9">Egz 13:9</ref></char></note>ekri sou men l:</para>
  <para style="q1" vid="ISA 44:5">‘Apatyen a SENYÈ a’,</para>
  <para style="q1" vid="ISA 44:5">epi va nonmen non Israël ak respè.<verse eid="ISA 44:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 44:6"/>Konsa pale SENYÈ a, Wa Israël la,</para>
  <para style="q1" vid="ISA 44:6">ak <note caller="+" style="x"><char style="xo" closed="false">44:6 </char><char style="xt" closed="false"><ref loc="ISA 41:14">És 41:14</ref></char></note>Redanmtè li a, SENYÈ dèzame yo:</para>
  <para style="q1" vid="ISA 44:6">Mwen se premye a e Mwen se dènye a;</para>
  <para style="q1" vid="ISA 44:6">nanpwen Bondye sof ke Mwen menm.<verse eid="ISA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 44:7"/>Se kilès ki tankou Mwen? <note caller="+" style="x"><char style="xo" closed="false">44:7 </char><char style="xt" closed="false"><ref loc="ISA 41:22-26">És 41:22-26</ref></char></note>Kite li pwoklame e deklare sa;</para>
  <para style="q1" vid="ISA 44:7">Wi, kite li pale M sa an lòd.</para>
  <para style="q1" vid="ISA 44:7">Depi lè ke M te etabli ansyen nasyon a.</para>
  <para style="q1" vid="ISA 44:7">Epi kite yo deklare a yo menm bagay</para>
  <para style="q1" vid="ISA 44:7">k ap vini yo ak evenman ki va rive yo.<verse eid="ISA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 44:8"/>Pa tranble, pa pè.</para>
  <para style="q1" vid="ISA 44:8">Èske depi lontan, Mwen pa t anonse sa a nou menm</para>
  <para style="q1" vid="ISA 44:8">e te demontre nou sa?</para>
  <para style="q1" vid="ISA 44:8">Konsa, nou se temwen M.</para>
  <para style="q1" vid="ISA 44:8">Èske gen okenn Bondye <note caller="+" style="x"><char style="xo" closed="false">44:8 </char><char style="xt" closed="false"><ref loc="DEU 4:35-39">Det 4:35-39</ref></char></note>sof ke Mwen menm?</para>
  <para style="q1" vid="ISA 44:8">Anverite, nanpwen!</para>
  <para style="q1" vid="ISA 44:8">Mwen pa konnen okenn lòt Wòch.”<verse eid="ISA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 44:9"/>Sila ki fè yon imaj taye yo, tout se pou ryen.</para>
  <para style="q1" vid="ISA 44:9">Sa ke yo bay enpòtans yo, pa gen benefis.</para>
  <para style="q1" vid="ISA 44:9">Menm pwòp temwen pa yo pa wè ni konnen.</para>
  <para style="q1" vid="ISA 44:9">Yo pa ka menm <note caller="+" style="x"><char style="xo" closed="false">44:9 </char><char style="xt" closed="false"><ref loc="PSA 97:7">Sòm 97:7</ref></char></note>vin wont.<verse eid="ISA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 44:10"/>Se kilès ki te fòme yon dye,</para>
  <para style="q1" vid="ISA 44:10">oswa te fè yon zidòl fonn ki <note caller="+" style="x"><char style="xo" closed="false">44:10 </char><char style="xt" closed="false"><ref loc="ISA 41:29">És 41:29</ref></char></note>san benefis?<verse eid="ISA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 44:11"/>Gade byen, tout zami l yo va <note caller="+" style="x"><char style="xo" closed="false">44:11 </char><char style="xt" closed="false"><ref loc="PSA 97:7">Sòm 97:7</ref></char></note>vin wont,</para>
  <para style="q1" vid="ISA 44:11">paske bòs atizan yo menm se sèlman lòm.</para>
  <para style="q1" vid="ISA 44:11">Kite yo rasanble yo menm,</para>
  <para style="q1" vid="ISA 44:11">kite yo kanpe,</para>
  <para style="q1" vid="ISA 44:11">kite yo tranble,</para>
  <para style="q1" vid="ISA 44:11">kite yo tout ansanm vin wont.<verse eid="ISA 44:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 44:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">44:12 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:19-20">És 40:19-20</ref>
      </char>
    </note>Moun nan fòme bout fè a pou fè yon zouti pou koupe.</para>
  <para style="q1" vid="ISA 44:12">Yon travay ki fèt sou chabon limen.</para>
  <para style="q1" vid="ISA 44:12">Li fòme li ak mato,</para>
  <para style="q1" vid="ISA 44:12">e travay li ak bra li ki fò.</para>
  <para style="q1" vid="ISA 44:12">Anplis, li vin grangou e pèdi fòs;</para>
  <para style="q1" vid="ISA 44:12">li pa bwè dlo e li vin fatige.<verse eid="ISA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 44:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">44:13 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 41:7">És 41:7</ref>
      </char>
    </note>Yon lòt taye bwa, li mezire li ak mèt mezi;</para>
  <para style="q1" vid="ISA 44:13">li trase sou li ak lakrè wouj.</para>
  <para style="q1" vid="ISA 44:13">Li travay li ak rif la, trase l ak konpa</para>
  <para style="q1" vid="ISA 44:13">e fè li sanble ak fòm a yon moun,</para>
  <para style="q1" vid="ISA 44:13">tankou bèlte a lòm,</para>
  <para style="q1" vid="ISA 44:13">pou l ka plase li anndan yon kay.<verse eid="ISA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 44:14"/>Anverite, li koupe bwa sèd yo pou kont li,</para>
  <para style="q1" vid="ISA 44:14">pran yon bwa pichpen oswa yon bwadchenn</para>
  <para style="q1" vid="ISA 44:14">e leve li pou kont li pami bwa forè yo.</para>
  <para style="q1" vid="ISA 44:14">Li plante yon bwa pen e lapli fè l grandi.<verse eid="ISA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 44:15"/>Epi li devni yon bagay pou moun ka brile.</para>
  <para style="q1" vid="ISA 44:15">Li pran kèk nan li pou l ka chofe</para>
  <para style="q1" vid="ISA 44:15">e anplis, fè dife pou kwit pen. Anplis li fè yon dye epi l adore l.</para>
  <para style="q1" vid="ISA 44:15">Li fè li yon imaj taye e li <note caller="+" style="x"><char style="xo" closed="false">44:15 </char><char style="xt" closed="false"><ref loc="2CH 25:14">II Kwo 25:14</ref></char></note>tonbe ba devan l.<verse eid="ISA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 44:16"/>Mwatye li, li brile nan dife;</para>
  <para style="q1" vid="ISA 44:16">sou mwatye sa a, li manje vyann</para>
  <para style="q1" vid="ISA 44:16">pandan li kwit yon gwo mòs e li satisfè.</para>
  <para style="q1" vid="ISA 44:16">Anplis, li chofè kò l epi di: “Aha, koulye a mwen fin chofe ase; mwen te wè dife a.”<verse eid="ISA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 44:17"/>Men rès la, li sèvi pou fòme yon dye, imaj taye pa li.</para>
  <para style="q1" vid="ISA 44:17">Li tonbe ba devan l pou adore l; anplis,</para>
  <para style="q1" vid="ISA 44:17">li <note caller="+" style="x"><char style="xo" closed="false">44:17 </char><char style="xt" closed="false"><ref loc="1KI 18:26-28">I Wa 18:26-28</ref></char></note>priye a li menm e di: “Delivre m, paske se ou ki dye mwen.”<verse eid="ISA 44:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 44:18"/>Yo pa konnen, ni yo pa konprann,</para>
  <para style="q1" vid="ISA 44:18">paske Li te <note caller="+" style="x"><char style="xo" closed="false">44:18 </char><char style="xt" closed="false"><ref loc="PSA 81:12">Sòm 81:12</ref></char></note>fèmen zye yo pou yo pa wè</para>
  <para style="q1" vid="ISA 44:18">e kè yo pou yo pa konprann.<verse eid="ISA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 44:19"/>Nanpwen moun ki sonje, ni pa gen konesans</para>
  <para style="q1" vid="ISA 44:19">ni konprann pou l ta di:</para>
  <para style="q1" vid="ISA 44:19">“Mwen te brile mwatye li nan dife a</para>
  <para style="q1" vid="ISA 44:19">e anplis, mwen te kwit pen sou chabon li.</para>
  <para style="q1" vid="ISA 44:19">Mwen boukannen vyann, e mwen manje li.</para>
  <para style="q1" vid="ISA 44:19">Èske m ap fè rès la vin yon <note caller="+" style="x"><char style="xo" closed="false">44:19 </char><char style="xt" closed="false"><ref loc="DEU 27:15">Det 27:15</ref></char></note>abominasyon?</para>
  <para style="q1" vid="ISA 44:19">Èske mwen va tonbe ba devan yon bout bwa!”<verse eid="ISA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 44:20"/>La p manje sou sann yo.</para>
  <para style="q1" vid="ISA 44:20">Yon <note caller="+" style="x"><char style="xo" closed="false">44:20 </char><char style="xt" closed="false"><ref loc="JOB 15:31">Job 15:31</ref></char></note>kè ki twonpe te mennen l sou kote.</para>
  <para style="q1" vid="ISA 44:20">Li p ap kapab delivre nanm li menm.</para>
  <para style="q1" vid="ISA 44:20">Ni li pa mande:</para>
  <para style="q1" vid="ISA 44:20">“Èske pa gen manti nan men dwat mwen?”<verse eid="ISA 44:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 44:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">44:21 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 46:8">És 46:8</ref>
      </char>
    </note>“Sonje bagay sa yo, O Jacob e Israël,</para>
  <para style="q1" vid="ISA 44:21">paske ou se sèvitè Mwen, O Israël.</para>
  <para style="q1" vid="ISA 44:21">Mwen p ap janm bliye ou.<verse eid="ISA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 44:22"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">44:22 </char><char style="xt" closed="false"><ref loc="PSA 51:1-9">Sòm 51:1-9</ref></char></note>efase transgresyon ou yo</para>
  <para style="q1" vid="ISA 44:22">tankou yon nwaj byen pwès,</para>
  <para style="q1" vid="ISA 44:22">ak peche ou yo tankou yon nwaj.</para>
  <para style="q1" vid="ISA 44:22">Retounen kote Mwen, paske Mwen te rachte ou.”<verse eid="ISA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 44:23"/>Rele ak jwa, O syèl yo, paske SENYÈ a te fè sa!</para>
  <para style="q1" vid="ISA 44:23">Rele ak jwa, ou menm, kote pi ba sou latè yo!</para>
  <para style="q1" vid="ISA 44:23">Pete ak gwo kri lajwa, O mòn yo,</para>
  <para style="q1" vid="ISA 44:23">O forè ak tout pyebwa ki ladann yo;</para>
  <para style="q1" vid="ISA 44:23">paske <note caller="+" style="x"><char style="xo" closed="false">44:23 </char><char style="xt" closed="false"><ref loc="ISA 43:1">És 43:1</ref></char></note>SENYÈ a te rachte Jacob,</para>
  <para style="q1" vid="ISA 44:23">e an Israël,</para>
  <para style="q1" vid="ISA 44:23">Li va devwale glwa Li.<verse eid="ISA 44:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 44:24"/>Konsa pale SENYÈ a, Redanmtè ou a</para>
  <para style="q1" vid="ISA 44:24">e sila ki te fè ou soti nan vant la:</para>
  <para style="q1" vid="ISA 44:24">“Mwen, SENYÈ a, se Kreyatè a tout bagay,</para>
  <para style="q1" vid="ISA 44:24">Mwen te <note caller="+" style="x"><char style="xo" closed="false">44:24 </char><char style="xt" closed="false"><ref loc="ISA 40:22">És 40:22</ref></char></note>lonje ouvri syèl yo pou kont Mwen,</para>
  <para style="q1" vid="ISA 44:24">e Mwen te lonje ouvri latè, Mwen sèl Mwen;<verse eid="ISA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 44:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">44:25 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 47:13">És 47:13</ref>
      </char>
    </note>ki fristre sila yo ki plen ògeye ak mantè yo;</para>
  <para style="q1" vid="ISA 44:25">ki te devwale divinò yo tankou moun fou,</para>
  <para style="q1" vid="ISA 44:25">ki te fè mesye saj yo rale fè bak,</para>
  <para style="q1" vid="ISA 44:25">pou l vire sajès yo fè 1 tounen foli;<verse eid="ISA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 44:26"/>ki te <note caller="+" style="x"><char style="xo" closed="false">44:26 </char><char style="xt" closed="false"><ref loc="ZEC 1:6">Za 1:6</ref></char></note>konfime pawòl a sèvitè Li a</para>
  <para style="q1" vid="ISA 44:26">e te acheve bi a mesaje Li yo.</para>
  <para style="q1" vid="ISA 44:26">Se Mwen menm ki di de Jérusalem:</para>
  <para style="q1" vid="ISA 44:26">Li va gen moun ladann!’ Epi a vil a Juda yo:</para>
  <para style="q1" vid="ISA 44:26">‘Yo va bati.’</para>
  <para style="q1" vid="ISA 44:26">Konsa, Mwen va fè leve mazi li yo ankò.<verse eid="ISA 44:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 44:27"/>Se Mwen menm ki pale a fon lanmè a: ‘Vin sèch,’</para>
  <para style="q1" vid="ISA 44:27">e Mwen va fè rivyè ou yo <note caller="+" style="x"><char style="xo" closed="false">44:27 </char><char style="xt" closed="false"><ref loc="ISA 42:15">És 42:15</ref></char></note>vin sèk.<verse eid="ISA 44:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 44:28"/>Se Mwen menm ki di de Cyrus:</para>
  <para style="q1" vid="ISA 44:28">‘Li se bèje Mwen, epi li va acheve tout volonte mwen.’</para>
  <para style="q1" vid="ISA 44:28">Li va deklare a Jérusalem:<note caller="+" style="x"><char style="xo" closed="false">44:28 </char><char style="xt" closed="false"><ref loc="2CH 36:22-23">II Kwo 36:22-23</ref></char></note> ‘Li va bati,’</para>
  <para style="q1" vid="ISA 44:28">e de tanp lan: ‘Fondasyon ou yo va poze.’”<verse eid="ISA 44:28"/></para>
  <chapter eid="ISA 44"/>
  <chapter number="45" style="c" sid="ISA 45"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 45:1"/>Konsa pale SENYÈ a a Cyrus, onksyone Li a, ke M te pran pa <note caller="+" style="x"><char style="xo" closed="false">45:1 </char><char style="xt" closed="false"><ref loc="PSA 73:23">Sòm 73:23</ref></char></note>men dwat la, pou soumèt nasyon yo devan l e pou lache senti a wa yo, pou ouvri pòt devan l pou pòtay yo pa fèmen:<verse eid="ISA 45:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 45:2"/>“Mwen va ale devan ou</para>
  <para style="q1" vid="ISA 45:2">pou <note caller="+" style="x"><char style="xo" closed="false">45:2 </char><char style="xt" closed="false"><ref loc="PSA 107:6">Sòm 107:6</ref></char></note>fè move kote yo vin swa.</para>
  <para style="q1" vid="ISA 45:2">Mwen va kraze pòt an bwonz yo</para>
  <para style="q1" vid="ISA 45:2">e fin koupe nèt ba an fè li yo.<verse eid="ISA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 45:3"/>Mwen va bay ou <note caller="+" style="x"><char style="xo" closed="false">45:3 </char><char style="xt" closed="false"><ref loc="JER 41:8">Jr 41:8</ref></char></note>trezò lannwit yo</para>
  <para style="q1" vid="ISA 45:3">ak richès k ap kache kote sekrè yo,</para>
  <para style="q1" vid="ISA 45:3">pou ou ka konnen ke se Mwen, SENYÈ a,</para>
  <para style="q1" vid="ISA 45:3">Bondye Israël la, ki rele ou pa non ou.<verse eid="ISA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 45:4"/>Pou koz sèvitè Mwen an, Jacob ak Israël,</para>
  <para style="q1" vid="ISA 45:4">sila ke M te chwazi a,</para>
  <para style="q1" vid="ISA 45:4">Mwen te, anplis, rele ou pa non ou.</para>
  <para style="q1" vid="ISA 45:4">Mwen te bay ou yon tit k ap respekte,</para>
  <para style="q1" vid="ISA 45:4">malgre ou <note caller="+" style="x"><char style="xo" closed="false">45:4 </char><char style="xt" closed="false"><ref loc="ACT 17:23">Trav 17:23</ref></char></note>pa t rekonèt Mwen.<verse eid="ISA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 45:5"/>Mwen se SENYÈ a e pa gen lòt.</para>
  <para style="q1" vid="ISA 45:5">Apa de Mwen menm, pa gen Bondye.</para>
  <para style="q1" vid="ISA 45:5">Mwen va <note caller="+" style="x"><char style="xo" closed="false">45:5 </char><char style="xt" closed="false"><ref loc="PSA 18:39">Sòm 18:39</ref></char></note>fòtifye ou,</para>
  <para style="q1" vid="ISA 45:5">malgre ou pa t rekonèt Mwen;<verse eid="ISA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 45:6"/>ke <note caller="+" style="x"><char style="xo" closed="false">45:6 </char><char style="xt" closed="false"><ref loc="PSA 102:15">Sòm 102:15</ref></char></note>lèzòm ka konnen depi solèy leve</para>
  <para style="q1" vid="ISA 45:6">jiskaske solèy kouche,</para>
  <para style="q1" vid="ISA 45:6">ke nanpwen lòt sof ke Mwen menm.</para>
  <para style="q1" vid="ISA 45:6">Mwen se SENYÈ a e nanpwen lòt;<verse eid="ISA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 45:7"/>Sila ki te fòme limyè a ak fènwa a,</para>
  <para style="q1" vid="ISA 45:7">ki fè bonè e ki <note caller="+" style="x"><char style="xo" closed="false">45:7 </char><char style="xt" closed="false"><ref loc="ISA 31:2">És 31:2</ref></char></note>kreye malè.</para>
  <para style="q1" vid="ISA 45:7">Mwen se SENYÈ a,</para>
  <para style="q1" vid="ISA 45:7">ki fè tout sila yo.<verse eid="ISA 45:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 45:8"/>Degoute depi anwo, O syèl yo,</para>
  <para style="q1" vid="ISA 45:8">e kite nwaj yo vide fè ladwati desann.</para>
  <para style="q1" vid="ISA 45:8">Kite <note caller="+" style="x"><char style="xo" closed="false">45:8 </char><char style="xt" closed="false"><ref loc="PSA 85:11">Sòm 85:11</ref></char></note>latè ouvri nèt pou sali a ka donnen fwi,</para>
  <para style="q1" vid="ISA 45:8">pou fè ladwati vòltije monte avè l.</para>
  <para style="q1" vid="ISA 45:8">Mwen, SENYÈ a te kreye l.<verse eid="ISA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 45:9"/>Malè a sila ki goumen ak Kreyatè li a—</para>
  <para style="q1" vid="ISA 45:9">yon veso fèt ak tè pami veso latè yo!</para>
  <para style="q1" vid="ISA 45:9">Èske <note caller="+" style="x"><char style="xo" closed="false">45:9 </char><char style="xt" closed="false"><ref loc="ISA 29:16">És 29:16</ref></char></note>ajil va di a bòs kanari a: ‘Se kisa w ap fè la a?’</para>
  <para style="q1" vid="ISA 45:9">Oswa bagay w ap fè a, ta di: “Li pa gen men’?<verse eid="ISA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 45:10"/>Malè a sila ki di a yon papa: ‘Ki kalite bagay ou te fè la?’</para>
  <para style="q1" vid="ISA 45:10">Oswa a yon fanm: ‘A kilès w ap bay nesans lan?’”<verse eid="ISA 45:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 45:11"/>Konsa pale SENYÈ a, Sila Ki Sen An Israël</para>
  <para style="q1" vid="ISA 45:11">ak Kreyatè li a:</para>
  <para style="q1" vid="ISA 45:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">45:11 </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:9">Jr 31:9</ref>
      </char>
    </note>“Mande M de bagay k ap vini a konsènan fis Mwen yo</para>
  <para style="q1" vid="ISA 45:11">e ou kòmande Mwen menm selon zèv men M yo!<verse eid="ISA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 45:12"/>Se Mwen ki te fè latè e te kreye lòm sou li.</para>
  <para style="q1" vid="ISA 45:12">Mwen te lonje ouvri syèl yo ak men M</para>
  <para style="q1" vid="ISA 45:12">e mete tout <note caller="+" style="x"><char style="xo" closed="false">45:12 </char><char style="xt" closed="false"><ref loc="GEN 2:1">Jen 2:1</ref></char></note>lame selès pa yo an lòd.<verse eid="ISA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 45:13"/>Mwen te fè leve nan li <note caller="+" style="x"><char style="xo" closed="false">45:13 </char><char style="xt" closed="false"><ref loc="ISA 41:2">És 41:2</ref></char></note>ladwati</para>
  <para style="q1" vid="ISA 45:13">e Mwen va fè wout li yo swa.</para>
  <para style="q1" vid="ISA 45:13">Li va bati vil Mwen,</para>
  <para style="q1" vid="ISA 45:13">e va kite egzile Mwen yo vin libere,</para>
  <para style="q1" vid="ISA 45:13">pa pou pèyman oswa rekonpans,”</para>
  <para style="q1" vid="ISA 45:13">pale SENYÈ dèzame yo.<verse eid="ISA 45:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 45:14"/>Konsa pale SENYÈ a: “Prodwi a Égypte yo</para>
  <para style="q1" vid="ISA 45:14">ak machandiz a Ethiopie a ak Sabeyen yo,</para>
  <para style="q1" vid="ISA 45:14">mesye a gran tay yo, va vin travèse kote ou.</para>
  <para style="q1" vid="ISA 45:14">Yo va pou ou.</para>
  <para style="q1" vid="ISA 45:14">Yo va mache dèyè w.</para>
  <para style="q1" vid="ISA 45:14">Yo va vini ak chenn sou yo, e va bese devan ou;</para>
  <para style="q1" vid="ISA 45:14">yo va fè siplikasyon a ou menm.</para>
  <para style="q1" vid="ISA 45:14">‘Anverite <note caller="+" style="x"><char style="xo" closed="false">45:14 </char><char style="xt" closed="false"><ref loc="JER 16:19">Jr 16:19</ref></char></note>Bondye pami nou; e pa gen lòt.</para>
  <para style="q1" vid="ISA 45:14">Nanpwen lòt Bondye’”<verse eid="ISA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 45:15"/>Anverite, Ou se yon Dye ki <note caller="+" style="x"><char style="xo" closed="false">45:15 </char><char style="xt" closed="false"><ref loc="PSA 44:24">Sòm 44:24</ref></char></note>kache tèt Li,</para>
  <para style="q1" vid="ISA 45:15">O Bondye Israël la, Sovè a!<verse eid="ISA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 45:16"/>Yo va <note caller="+" style="x"><char style="xo" closed="false">45:16 </char><char style="xt" closed="false"><ref loc="ISA 42:17">És 42:17</ref></char></note>desi, imilye menm, yo tout.</para>
  <para style="q1" vid="ISA 45:16">Sa yo ki fabrike zidòl yo va sòti ansanm ak gwo wont.<verse eid="ISA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 45:17"/>Israël va sove pa SENYÈ a, ak yon sali ki pou tout tan.</para>
  <para style="q1" vid="ISA 45:17">Ou <note caller="+" style="x"><char style="xo" closed="false">45:17 </char><char style="xt" closed="false"><ref loc="ISA 49:23">És 49:23</ref></char></note>p ap vin wont, ni imilye jiska letènite.<verse eid="ISA 45:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 45:18"/>Paske SENYÈ a ki te kreye syèl la ak tè a,</para>
  <para style="q1" vid="ISA 45:18">Dye la ki te fòme tè a e ki te fè l la;</para>
  <para style="q1" vid="ISA 45:18">Ki te etabli li, e Li pa t kreye li <note caller="+" style="x"><char style="xo" closed="false">45:18 </char><char style="xt" closed="false"><ref loc="GEN 1:2">Jen 1:2</ref></char></note>vid,</para>
  <para style="q1" vid="ISA 45:18">men te fòme l pou moun ka viv ladann di:</para>
  <para style="q1" vid="ISA 45:18">“Mwen se SENYÈ a.</para>
  <para style="q1" vid="ISA 45:18">Nanpwen lòt.<verse eid="ISA 45:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 45:19"/>Mwen pa t pale an sekrè, nan yon peyi fènwa.</para>
  <para style="q1" vid="ISA 45:19">Mwen pa t di a desandan Jacob yo,</para>
  <para style="q1" vid="ISA 45:19">‘Chache M anven.’</para>
  <para style="q1" vid="ISA 45:19">Mwen, SENYÈ a, <note caller="+" style="x"><char style="xo" closed="false">45:19 </char><char style="xt" closed="false"><ref loc="PSA 19:8">Sòm 19:8</ref></char></note>pale ladwati.</para>
  <para style="q1" vid="ISA 45:19">Mwen deklare sa ki dwat.”<verse eid="ISA 45:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 45:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">45:20 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 43:9">És 43:9</ref>
      </char>
    </note>“Rasanble nou e vini.</para>
  <para style="q1" vid="ISA 45:20">Rapwoche nou ansanm, nou menm,</para>
  <para style="q1" vid="ISA 45:20">refijye a nasyon yo.</para>
  <para style="q1" vid="ISA 45:20">Lòt yo pa gen konesans;</para>
  <para style="q1" vid="ISA 45:20">sila ki pote zidòl an bwa yo toupatou,</para>
  <para style="q1" vid="ISA 45:20">e ki priye a yon dye ki p ap ka sove yo.<verse eid="ISA 45:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 45:21"/>Deklare e prezante ka nou an.</para>
  <para style="q1" vid="ISA 45:21">Anverite, kite yo fè konsiltasyon ansanm.</para>
  <para style="q1" vid="ISA 45:21">Se kilès ki te anonse sa depi nan tan ansyen yo,</para>
  <para style="q1" vid="ISA 45:21">ki te deklare sa depi lontan?</para>
  <para style="q1" vid="ISA 45:21">Èske se pa Mwen, SENYÈ a?</para>
  <para style="q1" vid="ISA 45:21">Epi <note caller="+" style="x"><char style="xo" closed="false">45:21 </char><char style="xt" closed="false"><ref loc="ISA 45:5">És 45:5</ref></char></note>nanpwen lòt Dye sof ke Mwen,</para>
  <para style="q1" vid="ISA 45:21">yon Dye ladwati e yon Sovè. Nanpwen lòt sof ke Mwen.<verse eid="ISA 45:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 45:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">45:22 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:8-9">Nonb 21:8-9</ref>
      </char>
    </note>“Vire kote Mwen pou vin sove, tout pwent latè yo;</para>
  <para style="q1" vid="ISA 45:22">paske Mwen se Bondye e pa gen lòt.<verse eid="ISA 45:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 45:23"/>Mwen te sèmante pa Mwen menm,</para>
  <para style="q1" vid="ISA 45:23">pawòl la te fin sòti nan bouch Mwen nan ladwati</para>
  <para style="q1" vid="ISA 45:23">e li p ap vire fè bak;</para>
  <para style="q1" vid="ISA 45:23">ke a Mwen menm, <note caller="+" style="x"><char style="xo" closed="false">45:23 </char><char style="xt" closed="false"><ref loc="ROM 14:11">Wo 14:11</ref></char></note>tout jenou va koube</para>
  <para style="q1" vid="ISA 45:23">e tout lang va sèmante fidelite.<verse eid="ISA 45:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 45:24"/>Yo va di de Mwen:</para>
  <para style="q1" vid="ISA 45:24">‘Se sèlman <note caller="+" style="x"><char style="xo" closed="false">45:24 </char><char style="xt" closed="false"><ref loc="JER 33:16">Jr 33:16</ref></char></note>nan SENYÈ a ki gen ladwati ak pwisans.’”</para>
  <para style="q1" vid="ISA 45:24">Lèzòm va vin kote Li e tout moun ki te</para>
  <para style="q1" vid="ISA 45:24">fè laràj kont Li va vin wont nèt.<verse eid="ISA 45:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 45:25"/>Nan SENYÈ a, tout desandan Israël yo va vin <note caller="+" style="x"><char style="xo" closed="false">45:25 </char><char style="xt" closed="false"><ref loc="1KI 8:32">I Wa 8:32</ref></char></note>jistifye</para>
  <para style="q1" vid="ISA 45:25">e va rejwi!<verse eid="ISA 45:25"/></para>
  <chapter eid="ISA 45"/>
  <chapter number="46" style="c" sid="ISA 46"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 46:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">46:1 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 2:18">És 2:18</ref>
      </char>
    </note>Bel vin pwostène,</para>
  <para style="q1" vid="ISA 46:1">Nebo koube nèt.</para>
  <para style="q1" vid="ISA 46:1">Imaj pa yo kon pote sou bèt;</para>
  <para style="q1" vid="ISA 46:1">menm sou tout kalite bèt domestik.</para>
  <para style="q1" vid="ISA 46:1">Bagay ke nou pote yo se chaj lou;</para>
  <para style="q1" vid="ISA 46:1">yon fado ki pèze sa yo ki fatige.<verse eid="ISA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 46:2"/>Yo koube nèt e yo vin pwostène ansanm.</para>
  <para style="q1" vid="ISA 46:2">Yo pa t ka delivre chaj lou a,</para>
  <para style="q1" vid="ISA 46:2">men yo menm <note caller="+" style="x"><char style="xo" closed="false">46:2 </char><char style="xt" closed="false"><ref loc="JDG 18:17-24">Jij 18:17-24</ref></char></note>vin prizonye yo.<verse eid="ISA 46:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 46:3"/>Koute Mwen, O lakay Jacob</para>
  <para style="q1" vid="ISA 46:3">ak tout retay lakay Israël la;</para>
  <para style="q1" vid="ISA 46:3">nou menm ki te <note caller="+" style="x"><char style="xo" closed="false">46:3 </char><char style="xt" closed="false"><ref loc="PSA 71:6">Sòm 71:6</ref></char></note>pote menm depi nan nesans,</para>
  <para style="q1" vid="ISA 46:3">ki te pote depi nan vant.<verse eid="ISA 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 46:4"/>Jis rive nan vyeyès nou, Mwen se Li,</para>
  <para style="q1" vid="ISA 46:4">e menm lè <note caller="+" style="x"><char style="xo" closed="false">46:4 </char><char style="xt" closed="false"><ref loc="PSA 71:18">Sòm 71:18</ref></char></note>cheve nou blanch, Mwen va pote nou.</para>
  <para style="q1" vid="ISA 46:4">Mwen te fè, e Mwen va pote.</para>
  <para style="q1" vid="ISA 46:4">Mwen va pote, e Mwen va delivre.<verse eid="ISA 46:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 46:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">46:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:18-25">És 40:18-25</ref>
      </char>
    </note>A kilès nou ta fè Mwen sanble,</para>
  <para style="q1" vid="ISA 46:5">fè Mwen vin egal e konpare Mwen,</para>
  <para style="q1" vid="ISA 46:5">konsi nou te menm bagay?<verse eid="ISA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 46:6"/>Kèk kon <note caller="+" style="x"><char style="xo" closed="false">46:6 </char><char style="xt" closed="false"><ref loc="ISA 40:19">És 40:19</ref></char></note>vide lò ki sòti nan bous,</para>
  <para style="q1" vid="ISA 46:6">oswa peze ajan sou balans.</para>
  <para style="q1" vid="ISA 46:6">Anplwaye yon òfèv,</para>
  <para style="q1" vid="ISA 46:6">e l ap fè l vin tounen yon dye.</para>
  <para style="q1" vid="ISA 46:6">Yo pwostène—</para>
  <para style="q1" vid="ISA 46:6">e anverite, yo adore l.<verse eid="ISA 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 46:7"/>Yo fè l monte sou zepòl pou pote l;</para>
  <para style="q1" vid="ISA 46:7">yo pote l, mete li nan plas li, e li kanpe la.</para>
  <para style="q1" vid="ISA 46:7">Li p ap ka deplase nan plas li.</para>
  <para style="q1" vid="ISA 46:7">Malgre yon moun ta kriye anvè li, <note caller="+" style="x"><char style="xo" closed="false">46:7 </char><char style="xt" closed="false"><ref loc="ISA 41:28">És 41:28</ref></char></note>li p ap ka reponn;</para>
  <para style="q1" vid="ISA 46:7">li p ap ka delivre l nan gwo pwoblèm li an.<verse eid="ISA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 46:8"/>Sonje sa e kanpe fèm kon gason;</para>
  <para style="q1" vid="ISA 46:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">46:8 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 44:19">És 44:19</ref>
      </char>
    </note>kenbe sa nan tèt nou ankò, transgresè yo.<verse eid="ISA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 46:9"/>Sonje <note caller="+" style="x"><char style="xo" closed="false">46:9 </char><char style="xt" closed="false"><ref loc="DEU 32:7">Det 32:7</ref></char></note>ansyen bagay ki pase lontan yo,</para>
  <para style="q1" vid="ISA 46:9">paske Mwen se Bondye e nanpwen lòt.</para>
  <para style="q1" vid="ISA 46:9">Mwen se Bondye, epi pa gen tankou Mwen,<verse eid="ISA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 46:10"/>ki deklare lafen depi nan kòmansman</para>
  <para style="q1" vid="ISA 46:10">e depi tan lansyen yo, bagay ki pa t janm fèt yo.</para>
  <para style="q1" vid="ISA 46:10">Mwen ki di w: <note caller="+" style="x"><char style="xo" closed="false">46:10 </char><char style="xt" closed="false"><ref loc="PSA 33:11">Sòm 33:11</ref></char></note>“Volonte m va etabli e Mwen va akonpli tout bon plezi M.”<verse eid="ISA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 46:11"/>M ap rele yon zwazo ki manje chè soti nan lès,</para>
  <para style="q1" vid="ISA 46:11">yon nonm volonte Mwen an,</para>
  <para style="q1" vid="ISA 46:11">k ap soti nan yon peyi lwen.</para>
  <para style="q1" vid="ISA 46:11">Anverite, Mwen te <note caller="+" style="x"><char style="xo" closed="false">46:11 </char><char style="xt" closed="false"><ref loc="NUM 23:19">Nonb 23:19</ref></char></note>pale.</para>
  <para style="q1" vid="ISA 46:11">Anverite, Mwen va fè sa rive.</para>
  <para style="q1" vid="ISA 46:11">Mwen ki te fè plan an;</para>
  <para style="q1" vid="ISA 46:11">Mwen k ap fè l rive.<verse eid="ISA 46:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 46:12"/>Koute Mwen, nou menm, moun <note caller="+" style="x"><char style="xo" closed="false">46:12 </char><char style="xt" closed="false"><ref loc="PSA 76:5">Sòm 76:5</ref></char></note>tèt di,</para>
  <para style="q1" vid="ISA 46:12">ki lwen ladwati yo!<verse eid="ISA 46:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 46:13"/>Mwen mennen ladwati Mwen vin toupre.</para>
  <para style="q1" vid="ISA 46:13">Li pa lwen,</para>
  <para style="q1" vid="ISA 46:13">epi sali Mwen p ap fè reta.</para>
  <para style="q1" vid="ISA 46:13">Mwen va bay <note caller="+" style="x"><char style="xo" closed="false">46:13 </char><char style="xt" closed="false"><ref loc="ISA 61:3">És 61:3</ref></char></note>sali nan Sion</para>
  <para style="q1" vid="ISA 46:13">e glwa Mwen a Israël.<verse eid="ISA 46:13"/></para>
  <chapter eid="ISA 46"/>
  <chapter number="47" style="c" sid="ISA 47"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 47:1"/>“Vin desann chita nan pousyè a, O <note caller="+" style="x"><char style="xo" closed="false">47:1 </char><char style="xt" closed="false"><ref loc="PSA 137:8">Sòm 137:8</ref></char></note>fi vyèj Babylone nan;</para>
  <para style="q1" vid="ISA 47:1">Chita atè san twòn, O fi a Kaldeyen yo!</para>
  <para style="q1" vid="ISA 47:1">Paske ou p ap rele fanm dous ankò, ni bèl fanm.<verse eid="ISA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 47:2"/>Pran yon wòch moulen pou moulen farin.</para>
  <para style="q1" vid="ISA 47:2">Retire <note caller="+" style="x"><char style="xo" closed="false">47:2 </char><char style="xt" closed="false"><ref loc="GEN 24:65">Jen 24:65</ref></char></note>vwal ou leve jip la wo, dekouvri janm yo.</para>
  <para style="q1" vid="ISA 47:2">Travèse rivyè yo.<verse eid="ISA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 47:3"/>Toutouni ou va dekouvri e wont ou va vin parèt.</para>
  <para style="q1" vid="ISA 47:3">Mwen va <note caller="+" style="x"><char style="xo" closed="false">47:3 </char><char style="xt" closed="false"><ref loc="ISA 34:8">És 34:8</ref></char></note>pran vanjans</para>
  <para style="q1" vid="ISA 47:3">e Mwen p ap bliye pèsòn.”<verse eid="ISA 47:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 47:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">47:4 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 41:14">És 41:14</ref>
      </char>
    </note>Redanmtè nou an, SENYÈ dèzame yo se non Li,</para>
  <para style="q1" vid="ISA 47:4">Sila Ki Sen an Israël la.<verse eid="ISA 47:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 47:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">47:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 23:2">És 23:2</ref>
      </char>
    </note>Chita an silans e antre nan fènwa a,</para>
  <para style="q1" vid="ISA 47:5">O fi a Kaldeyen yo,</para>
  <para style="q1" vid="ISA 47:5">paske ou p ap rele ankò rèn a wayòm yo.<verse eid="ISA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 47:6"/>Mwen te fache ak pèp Mwen an;</para>
  <para style="q1" vid="ISA 47:6">Mwen te pwofane eritaj Mwen an,</para>
  <para style="q1" vid="ISA 47:6">e Mwen te livre pèp Mwen nan men ou.</para>
  <para style="q1" vid="ISA 47:6">Ou pa t montre yo gras,</para>
  <para style="q1" vid="ISA 47:6">men menm ak <note caller="+" style="x"><char style="xo" closed="false">47:6 </char><char style="xt" closed="false"><ref loc="DEU 28:50">Det 28:50</ref></char></note>granmoun nan vyeyès yo,</para>
  <para style="q1" vid="ISA 47:6">ou te fè jouk ou byen lou.<verse eid="ISA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 47:7"/>Malgre, ou te di: ‘Se <note caller="+" style="x"><char style="xo" closed="false">47:7 </char><char style="xt" closed="false"><ref loc="ISA 47:5">És 47:5</ref></char></note>rèn ke m ap ye jis pou tout tan.’</para>
  <para style="q1" vid="ISA 47:7">Bagay sila yo, ou pa t konsidere yo, ni sonje kote yo t ap rive.<verse eid="ISA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 47:8"/>“Alò, tande sa, ou menm, moun sansyèl yo,</para>
  <para style="q1" vid="ISA 47:8">ki viv ansekirite, k ap di nan kè nou:</para>
  <para style="q1" vid="ISA 47:8">‘Se mwen menm e nanpwen lòt.</para>
  <para style="q1" vid="ISA 47:8">Mwen p ap janm <note caller="+" style="x"><char style="xo" closed="false">47:8 </char><char style="xt" closed="false"><ref loc="REV 18:7">Rev 18:7</ref></char></note>chita tankou yon vèv,</para>
  <para style="q1" vid="ISA 47:8">ni konnen pèt timoun.’<verse eid="ISA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 47:9"/>Men de bagay sa yo va rive sou nou <note caller="+" style="x"><char style="xo" closed="false">47:9 </char><char style="xt" closed="false"><ref loc="PSA 73:19">Sòm 73:19</ref></char></note>sibitman</para>
  <para style="q1" vid="ISA 47:9">nan yon jou:</para>
  <para style="q1" vid="ISA 47:9">pèt a pitit ak afè vin vèv la.</para>
  <para style="q1" vid="ISA 47:9">Yo va rive an mezi plen nèt;</para>
  <para style="q1" vid="ISA 47:9">malgre tout maji nou ak gwo pouvwa</para>
  <para style="q1" vid="ISA 47:9">wanga nou konn fè yo.<verse eid="ISA 47:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 47:10"/>Ou te santi ou te <note caller="+" style="x"><char style="xo" closed="false">47:10 </char><char style="xt" closed="false"><ref loc="PSA 52:7">Sòm 52:7</ref></char></note>byen pwoteje nan mechanste ou</para>
  <para style="q1" vid="ISA 47:10">e ou te di: ‘Pèsòn pa wè m’.</para>
  <para style="q1" vid="ISA 47:10">Sajès ou ak konesans ou, yo fin chape kite ou;</para>
  <para style="q1" vid="ISA 47:10">paske nan kè ou, ou te di:</para>
  <para style="q1" vid="ISA 47:10">‘Se mwen menm e nanpwen lòt sof ke mwen’.<verse eid="ISA 47:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 47:11"/>Men <note caller="+" style="x"><char style="xo" closed="false">47:11 </char><char style="xt" closed="false"><ref loc="ISA 57:1">És 57:1</ref></char></note>malè va vini sou ou ke ou p ap gen</para>
  <para style="q1" vid="ISA 47:11">maji pou detounen.</para>
  <para style="q1" vid="ISA 47:11">Gwo dega ke ou p ap ka menm konprann va vini sou ou.</para>
  <para style="q1" vid="ISA 47:11">Destriksyon ke ou pa t janmn sispèk</para>
  <para style="q1" vid="ISA 47:11">va rive sou ou sibitman.<verse eid="ISA 47:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 47:12"/>Kanpe fèm nan tout <note caller="+" style="x"><char style="xo" closed="false">47:12 </char><char style="xt" closed="false"><ref loc="ISA 47:9">És 47:9</ref></char></note>maji ak wanga</para>
  <para style="q1" vid="ISA 47:12">ke ou te sèvi depi nan jenès ou yo.</para>
  <para style="q1" vid="ISA 47:12">Petèt ou va reyisi, petèt ou va fè moun tranble.<verse eid="ISA 47:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 47:13"/>Ou vin <note caller="+" style="x"><char style="xo" closed="false">47:13 </char><char style="xt" closed="false"><ref loc="JER 51:58-64">Jr 51:58-64</ref></char></note>fatige ak tout konsèyè yo.</para>
  <para style="q1" vid="ISA 47:13">Alò koulye a, kite mèt zetwal ki fè pwofesi ak yo,</para>
  <para style="q1" vid="ISA 47:13">k ap fè prediksyon avni ak nouvèl lin yo,</para>
  <para style="q1" vid="ISA 47:13">vin kanpe pou pwoteje ou sou sa k ap vin rive ou yo.<verse eid="ISA 47:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 47:14"/>Gade byen, yo <note caller="+" style="x"><char style="xo" closed="false">47:14 </char><char style="xt" closed="false"><ref loc="ISA 5:24">És 5:24</ref></char></note>tankou pay.</para>
  <para style="q1" vid="ISA 47:14">Dife ap brile yo.</para>
  <para style="q1" vid="ISA 47:14">Yo p ap ka sove kò yo devan pouvwa flanm yo.</para>
  <para style="q1" vid="ISA 47:14">P ap gen chabon ki pou chofe kò yo,</para>
  <para style="q1" vid="ISA 47:14">ni flanm dife pou yo chita devan l!<verse eid="ISA 47:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 47:15"/>Men kijan tout travay lavi ou ap tèminen:</para>
  <para style="q1" vid="ISA 47:15">Tout sa yo ki <note caller="+" style="x"><char style="xo" closed="false">47:15 </char><char style="xt" closed="false"><ref loc="REV 18:11">Rev 18:11</ref></char></note>fè komès ak ou depi nan jenès ou yo</para>
  <para style="q1" vid="ISA 47:15">va mache egare nan chemen pa yo;</para>
  <para style="q1" vid="ISA 47:15">nanpwen moun ki pou ta sove ou.<verse eid="ISA 47:15"/></para>
  <chapter eid="ISA 47"/>
  <chapter number="48" style="c" sid="ISA 48"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 48:1"/>“Tande sa, O lakay Jacob,</para>
  <para style="q1" vid="ISA 48:1">ki rele pa non Israël,</para>
  <para style="q1" vid="ISA 48:1">ki te sòti nan dlo Juda la.</para>
  <para style="q1" vid="ISA 48:1">Nou <note caller="+" style="x"><char style="xo" closed="false">48:1 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Det 6:13</ref></char></note>sèmante pa non SENYÈ a,</para>
  <para style="q1" vid="ISA 48:1">e envoke Bondye Israël la,</para>
  <para style="q1" vid="ISA 48:1">men san verite e san ladwati.<verse eid="ISA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 48:2"/>Paske yo rele tèt yo menm jan ak vil sen an</para>
  <para style="q1" vid="ISA 48:2">e yo <note caller="+" style="x"><char style="xo" closed="false">48:2 </char><char style="xt" closed="false"><ref loc="ISA 10:20">És 10:20</ref></char></note>depann sou Bondye Israël la;</para>
  <para style="q1" vid="ISA 48:2">SENYÈ dèzame se non Li.<verse eid="ISA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 48:3"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">48:3 </char><char style="xt" closed="false"><ref loc="ISA 41:22">És 41:22</ref></char></note>deklare ansyen bagay lontan yo,</para>
  <para style="q1" vid="ISA 48:3">yo te sòti nan bouch Mwen e Mwen te pwoklame yo.</para>
  <para style="q1" vid="ISA 48:3">Sibitman Mwen te fè yo, e yo te vin rive.<verse eid="ISA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 48:4"/>Akoz Mwen konnen ke <note caller="+" style="x"><char style="xo" closed="false">48:4 </char><char style="xt" closed="false"><ref loc="EXO 32:9">Egz 32:9</ref></char></note>tèt ou di,</para>
  <para style="q1" vid="ISA 48:4">kou ou tankou ba fè,</para>
  <para style="q1" vid="ISA 48:4">e fwontèn ou tankou bwonz;<verse eid="ISA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 48:5"/>pou sa, Mwen te deklare sa a ou menm lontan sa;</para>
  <para style="q1" vid="ISA 48:5">avan yo te rive, Mwen te pwoklame yo a Ou menm,</para>
  <para style="q1" vid="ISA 48:5">pou ou pa ta di: ‘Se <note caller="+" style="x"><char style="xo" closed="false">48:5 </char><char style="xt" closed="false"><ref loc="JER 44:15-18">Jr 44:15-18</ref></char></note>zidòl mwen an ki te fè l;</para>
  <para style="q1" vid="ISA 48:5">imaj taye mwen ak imaj fonn mwen an</para>
  <para style="q1" vid="ISA 48:5">ki te kòmande yo.’<verse eid="ISA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 48:6"/>Ou te tande sa!</para>
  <para style="q1" vid="ISA 48:6">Gade tout sa!</para>
  <para style="q1" vid="ISA 48:6">Konsa, ou menm, èske ou p ap deklare li?</para>
  <para style="b" vid="ISA 48:6"/>
  <para style="q1" vid="ISA 48:6">Mwen pwoklame <note caller="+" style="x"><char style="xo" closed="false">48:6 </char><char style="xt" closed="false"><ref loc="ISA 42:9">És 42:9</ref></char></note>bagay tounèf yo a ou menm soti kounye a,</para>
  <para style="q1" vid="ISA 48:6">tout bagay kache a ke ou pa t konnen yo.<verse eid="ISA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 48:7"/>Se koulye a yo fèt, e pa lontan sa.</para>
  <para style="q1" vid="ISA 48:7">Avan jou sa a, ou pa t tande yo.</para>
  <para style="q1" vid="ISA 48:7">Konsa, ou p ap di: “Gade byen, mwen te konnen yo”.<verse eid="ISA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 48:8"/>Anverite, Ou pa t konn tande yo,</para>
  <para style="q1" vid="ISA 48:8">ni ou pa t konnen yo.</para>
  <para style="q1" vid="ISA 48:8">Menm depi lontan, zòrèy ou pa t ouvri,</para>
  <para style="q1" vid="ISA 48:8">paske Mwen te konnen ke ou aji nan koken.</para>
  <para style="q1" vid="ISA 48:8">Depi nan nesans ou, se <note caller="+" style="x"><char style="xo" closed="false">48:8 </char><char style="xt" closed="false"><ref loc="DEU 9:7-24">Det 9:7-24</ref></char></note>rebèl ou te ye.<verse eid="ISA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 48:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">48:9 </char>
      <char style="xt" closed="false">
        <ref loc="NEH 9:30-31">Né 9:30-31</ref>
      </char>
    </note>Pou koz a non Mwen, M ap fè kòlè Mwen pran ti reta;</para>
  <para style="q1" vid="ISA 48:9">pou koz lwanj Mwen, Mwen ralanti l pou ou,</para>
  <para style="q1" vid="ISA 48:9">pou m pa koupe retire ou nèt.<verse eid="ISA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 48:10"/>Gade byen, Mwen te rafine ou, men pa tankou ajan;</para>
  <para style="q1" vid="ISA 48:10">Mwen te fè ou pase a leprèv nan founo doulè a.<verse eid="ISA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 48:11"/>Pou koz pa M,</para>
  <para style="q1" vid="ISA 48:11">pou pwòp koz pa Mwen, Mwen va aji;</para>
  <para style="q1" vid="ISA 48:11">paske kòman non Mwen ka vin pwofane konsa?</para>
  <para style="q1" vid="ISA 48:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">48:11 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:26-27">Det 32:26-27</ref>
      </char>
    </note>Glwa Mwen, Mwen p ap ka sede l bay yon lòt.<verse eid="ISA 48:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 48:12"/>Koute Mwen, O Jacob,</para>
  <para style="q1" vid="ISA 48:12">menm Israël ke M te rele a;</para>
  <para style="q1" vid="ISA 48:12">Mwen se Li menm nan.</para>
  <para style="q1" vid="ISA 48:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">48:12 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 44:6">És 44:6</ref>
      </char>
    </note>Mwen se premye a.</para>
  <para style="q1" vid="ISA 48:12">E Mwen se osi dènye a.<verse eid="ISA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 48:13"/>Anverite, men M te <note caller="+" style="x"><char style="xo" closed="false">48:13 </char><char style="xt" closed="false"><ref loc="EXO 20:11">Egz 20:11</ref></char></note>etabli latè,</para>
  <para style="q1" vid="ISA 48:13">e men dwat Mwen te louvri syèl yo.</para>
  <para style="q1" vid="ISA 48:13">Lè M rele yo, yo kanpe ansanm.<verse eid="ISA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 48:14"/>Rasanble, nou tout pou koute!</para>
  <para style="q1" vid="ISA 48:14">Se kilès pami yo ki te deklare bagay sa yo?</para>
  <para style="q1" vid="ISA 48:14">Sila SENYÈ a renmen; li va <note caller="+" style="x"><char style="xo" closed="false">48:14 </char><char style="xt" closed="false"><ref loc="ISA 46:10-11">És 46:10-11</ref></char></note>akonpli sa li pito sou Babylone.</para>
  <para style="q1" vid="ISA 48:14">Men L va kontra Kaldeyen yo.<verse eid="ISA 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 48:15"/>Mwen menm, Mwen te pale.</para>
  <para style="q1" vid="ISA 48:15">Anverite, Mwen te <note caller="+" style="x"><char style="xo" closed="false">48:15 </char><char style="xt" closed="false"><ref loc="ISA 41:12">És 41:12</ref></char></note>rele li.</para>
  <para style="q1" vid="ISA 48:15">Mwen te mennen li,</para>
  <para style="q1" vid="ISA 48:15">e Li va fè chemen li yo vin reyisi.<verse eid="ISA 48:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 48:16"/>Vin toupre Mwen, koute sa:</para>
  <para style="b" vid="ISA 48:16"/>
  <para style="q1" vid="ISA 48:16">“Depi nan kòmansman, Mwen pa t pale an sekrè;</para>
  <para style="q1" vid="ISA 48:16">depi tan sa te rive a, Mwen te la.”</para>
  <para style="b" vid="ISA 48:16"/>
  <para style="q1" vid="ISA 48:16">Epi koulye a <note caller="+" style="x"><char style="xo" closed="false">48:16 </char><char style="xt" closed="false"><ref loc="ZEC 2:9-11">Za 2:9-11</ref></char></note>Senyè BONDYE a te voye Mwen ak Lespri Li.<verse eid="ISA 48:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 48:17"/>Konsa pale SENYÈ a,</para>
  <para style="q1" vid="ISA 48:17">Redanmtè ou a,</para>
  <para style="q1" vid="ISA 48:17">Sila Ki Sen an Israël la:</para>
  <para style="q1" vid="ISA 48:17">“Mwen se SENYÈ a, Bondye ou a,</para>
  <para style="q1" vid="ISA 48:17">ki enstwi ou pou ou ta byen reyisi,</para>
  <para style="q1" vid="ISA 48:17">ki <note caller="+" style="x"><char style="xo" closed="false">48:17 </char><char style="xt" closed="false"><ref loc="PSA 32:8">Sòm 32:8</ref></char></note>mennen ou nan chemen ke ou ta dwe ale a.<verse eid="ISA 48:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 48:18"/>Si sèlman ou te <note caller="+" style="x"><char style="xo" closed="false">48:18 </char><char style="xt" closed="false"><ref loc="DEU 5:29">Det 5:29</ref></char></note>okipe kòmandman Mwen yo!</para>
  <para style="q1" vid="ISA 48:18">Konsa afè ou t ap mache byen tankou yon rivyè,</para>
  <para style="q1" vid="ISA 48:18">e ladwati ou tankou lam lanmè yo.<verse eid="ISA 48:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 48:19"/>Desandan nou yo t ap tankou sab e pitit ou yo tankou grenn sab.</para>
  <para style="q1" vid="ISA 48:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">48:19 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 56:5">És 56:5</ref>
      </char>
    </note>Non pa li pa ta janm vin disparèt ni detwi devan prezans Mwen.”<verse eid="ISA 48:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 48:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">48:20 </char>
      <char style="xt" closed="false">
        <ref loc="JER 50:8">Jr 50:8</ref>
      </char>
    </note>Ale kite Babylone!</para>
  <para style="q1" vid="ISA 48:20">Sove ale devan Kaldeyen yo!</para>
  <para style="q1" vid="ISA 48:20">Deklare ak son a kri lajwa, pwoklame sa.</para>
  <para style="q1" vid="ISA 48:20">Voye li rive jis nan dènye pwent latè.</para>
  <para style="q1" vid="ISA 48:20">Anonse li, “SENYÈ a te rachte sèvitè Li a, Jacob.”<verse eid="ISA 48:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 48:21"/>Yo pa t swaf lè Li te mennen yo travèse dezè yo.</para>
  <para style="q1" vid="ISA 48:21">Li te fè dlo sòti nan wòch pou yo;</para>
  <para style="q1" vid="ISA 48:21">Li te fann wòch la e <note caller="+" style="x"><char style="xo" closed="false">48:21 </char><char style="xt" closed="false"><ref loc="PSA 78:20">Sòm 78:20</ref></char></note>dlo te vin pete.<verse eid="ISA 48:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 48:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">48:22 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 57:21">És 57:21</ref>
      </char>
    </note>“Pa gen lapè pou mechan yo”, SENYÈ a di.<verse eid="ISA 48:22"/></para>
  <chapter eid="ISA 48"/>
  <chapter number="49" style="c" sid="ISA 49"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 49:1"/>Koute Mwen, O <note caller="+" style="x"><char style="xo" closed="false">49:1 </char><char style="xt" closed="false"><ref loc="ISA 42:4">És 42:4</ref></char></note>lil yo</para>
  <para style="q1" vid="ISA 49:1">e tande byen, pèp ki sòti lwen yo.</para>
  <para style="q1" vid="ISA 49:1">SENYÈ a te rele Mwen depi nan vant;</para>
  <para style="q1" vid="ISA 49:1">depi nan vant manman M, Li te rele M.<verse eid="ISA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 49:2"/>Li te fè bouch Mwen tankou yon nepe file;</para>
  <para style="q1" vid="ISA 49:2">nan <note caller="+" style="x"><char style="xo" closed="false">49:2 </char><char style="xt" closed="false"><ref loc="ISA 51:16">És 51:16</ref></char></note>lonbraj men L, Li te kache Mwen.</para>
  <para style="q1" vid="ISA 49:2">Anplis, Li te fè M vin yon flèch byen poli,</para>
  <para style="q1" vid="ISA 49:2">e Li te kache Mwen nan fouwo Li.<verse eid="ISA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 49:3"/>Li te di Mwen: <note caller="+" style="x"><char style="xo" closed="false">49:3 </char><char style="xt" closed="false"><ref loc="ZEC 3:8">Za 3:8</ref></char></note>“Ou se sèvitè Mwen,</para>
  <para style="q1" vid="ISA 49:3">Israël nan sila Mwen va montre glwa Mwen an.”<verse eid="ISA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 49:4"/>Men Mwen te di: “Mwen te <note caller="+" style="x"><char style="xo" closed="false">49:4 </char><char style="xt" closed="false"><ref loc="ISA 65:23">És 65:23</ref></char></note>travay di an ven.</para>
  <para style="q1" vid="ISA 49:4">Mwen te depanse fòs Mwen pou ryen ak vanite;</para>
  <para style="q1" vid="ISA 49:4">sepandan, anverite, jistis pa m avèk SENYÈ a,</para>
  <para style="q1" vid="ISA 49:4">e rekonpans Mwen avèk Bondye Mwen an.”<verse eid="ISA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 49:5"/>Konsa pale SENYÈ a, ki te fòme m depi nan vant</para>
  <para style="q1" vid="ISA 49:5">pou m ta Sèvitè Li a:</para>
  <para style="q1" vid="ISA 49:5">Li di pou mennen Jacob retounen kote Li a,</para>
  <para style="q1" vid="ISA 49:5">pou Israël ta ranmase vè Li</para>
  <para style="q1" vid="ISA 49:5">(paske mwen te <note caller="+" style="x"><char style="xo" closed="false">49:5 </char><char style="xt" closed="false"><ref loc="ISA 43:4">És 43:4</ref></char></note>resevwa lonè nan zye SENYÈ a</para>
  <para style="q1" vid="ISA 49:5">e Bondye Mwen an se fòs Mwen),<verse eid="ISA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 49:6"/>Li di: “Se yon bagay twò piti pou ou ta Sèvitè Mwen,</para>
  <para style="q1" vid="ISA 49:6">pou leve fè monte tout tribi Jacob yo,</para>
  <para style="q1" vid="ISA 49:6">e restore retay Israël la.</para>
  <para style="q1" vid="ISA 49:6">Konsa anplis, Mwen va fè Ou <note caller="+" style="x"><char style="xo" closed="false">49:6 </char><char style="xt" closed="false"><ref loc="ISA 42:6">És 42:6</ref></char></note>yon limyè a nasyon yo,</para>
  <para style="q1" vid="ISA 49:6">pou sali Mwen ka rive jis nan dènye pwent latè.”<verse eid="ISA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 49:7"/>Konsa pale SENYÈ a, Redanmtè Israël la ak Sila Ki Sen li an,</para>
  <para style="q1" vid="ISA 49:7">a Sila ke lòm <note caller="+" style="x"><char style="xo" closed="false">49:7 </char><char style="xt" closed="false"><ref loc="PSA 22:6-8">Sòm 22:6-8</ref></char></note>meprize a, a Sila ki rayi pa nasyon an,</para>
  <para style="q1" vid="ISA 49:7">a Sèvitè a chèf yo:</para>
  <para style="q1" vid="ISA 49:7">“Wa yo va wè e vin leve,</para>
  <para style="q1" vid="ISA 49:7">Prens yo, anplis, va vin pwostène, akoz SENYÈ a,</para>
  <para style="q1" vid="ISA 49:7">Sila ki fidèl la, Sila Ki Sen an Israël ki te chwazi Ou a.”<verse eid="ISA 49:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 49:8"/>Konsa pale SENYÈ a, se nan yon tan konvenab,</para>
  <para style="q1" vid="ISA 49:8">ke M te reponn Ou.</para>
  <para style="q1" vid="ISA 49:8">Nan jou sali a, Mwen te bay Ou sekou.</para>
  <para style="q1" vid="ISA 49:8">Mwen va kenbe Ou e <note caller="+" style="x"><char style="xo" closed="false">49:8 </char><char style="xt" closed="false"><ref loc="ISA 42:6">És 42:6</ref></char></note>bay Ou kon yon akò pou pèp la,</para>
  <para style="q1" vid="ISA 49:8">pou restore peyi a, e pou fè yo posede eritaj dezole yo.<verse eid="ISA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 49:9"/>Pou pale a <note caller="+" style="x"><char style="xo" closed="false">49:9 </char><char style="xt" closed="false"><ref loc="ISA 42:7">És 42:7</ref></char></note>kaptif yo: ‘Vin parèt’!</para>
  <para style="q1" vid="ISA 49:9">Epi a sila nan tenèb yo: ‘Montre tèt ou’.</para>
  <para style="q1" vid="ISA 49:9">Akote chemen yo, yo va manje</para>
  <para style="q1" vid="ISA 49:9">e patiraj yo va sou tout wotè vid yo.<verse eid="ISA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 49:10"/>Yo p ap grangou, ni soufri swaf,</para>
  <para style="q1" vid="ISA 49:10">ni solèy ki brile p ap frape yo;</para>
  <para style="q1" vid="ISA 49:10">Paske Sila ki gen konpasyon pou yo a va <note caller="+" style="x"><char style="xo" closed="false">49:10 </char><char style="xt" closed="false"><ref loc="PSA 23:2">Sòm 23:2</ref></char></note>mennen yo</para>
  <para style="q1" vid="ISA 49:10">e va gide yo rive nan sous dlo yo.<verse eid="ISA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 49:11"/>Mwen va fè tout <note caller="+" style="x"><char style="xo" closed="false">49:11 </char><char style="xt" closed="false"><ref loc="ISA 40:4">És 40:4</ref></char></note>mòn Mwen yo vin yon chemen,</para>
  <para style="q1" vid="ISA 49:11">e gran chemen Mwen yo va vin leve wo.<verse eid="ISA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 49:12"/>Gade byen, sa yo va vini sòti lwen;</para>
  <para style="q1" vid="ISA 49:12">epi gade, sila yo va soti nan <note caller="+" style="x"><char style="xo" closed="false">49:12 </char><char style="xt" closed="false"><ref loc="ISA 43:5-6">És 43:5-6</ref></char></note>nò ak nan lwès la,</para>
  <para style="q1" vid="ISA 49:12">e sila yo va soti nan peyi Sinim yo.<verse eid="ISA 49:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 49:13"/>Rele fò ak jwa, O syèl yo!</para>
  <para style="q1" vid="ISA 49:13">Rejwi, O latè!</para>
  <para style="q1" vid="ISA 49:13">Eklate ak gwo kri lajwa, O mòn yo!</para>
  <para style="q1" vid="ISA 49:13">Paske <note caller="+" style="x"><char style="xo" closed="false">49:13 </char><char style="xt" closed="false"><ref loc="ISA 40:1">És 40:1</ref></char></note>SENYÈ a te konsole pèp Li a.</para>
  <para style="q1" vid="ISA 49:13">Li va gen konpasyon pou aflije Li yo.<verse eid="ISA 49:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 49:14"/>Men Sion te di: “SENYÈ a te abandone mwen,</para>
  <para style="q1" vid="ISA 49:14">e Senyè a te bliye mwen.”<verse eid="ISA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 49:15"/>Èske yon fanm ka bliye pitit k ap souse li a,</para>
  <para style="q1" vid="ISA 49:15">pou l pa gen konpasyon sou fis ki sòti nan vant li an?</para>
  <para style="q1" vid="ISA 49:15">Menm sila yo ka bliye, men <note caller="+" style="x"><char style="xo" closed="false">49:15 </char><char style="xt" closed="false"><ref loc="ISA 44:21">És 44:21</ref></char></note>Mwen p ap bliye ou.<verse eid="ISA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 49:16"/>Gade byen, Mwen te <note caller="+" style="x"><char style="xo" closed="false">49:16 </char><char style="xt" closed="false"><ref loc="SNG 8:6">Kan 8:6</ref></char></note>enskri ou nan pla men Mwen.</para>
  <para style="q1" vid="ISA 49:16">Miray ou yo devan Mwen tout tan.<verse eid="ISA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 49:17"/>Fè pitit ou yo, fè vit.</para>
  <para style="q1" vid="ISA 49:17">Sila k ap <note caller="+" style="x"><char style="xo" closed="false">49:17 </char><char style="xt" closed="false"><ref loc="ISA 10:6">És 10:6</ref></char></note>detwi yo e k ap devaste yo va kite ou.<verse eid="ISA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 49:18"/>“Leve zye ou e gade toupatou;</para>
  <para style="q1" vid="ISA 49:18">yo tout rasanble ansanm pou yo vin kote ou.</para>
  <para style="q1" vid="ISA 49:18">
    <note caller="+" style="x">
      <char style="xo" closed="false">49:18 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 45:23">És 45:23</ref>
      </char>
    </note>Kon Mwen viv la,” deklare SENYÈ a:</para>
  <para style="q1" vid="ISA 49:18">“Ou va, anverite abiye ak yo tout,</para>
  <para style="q1" vid="ISA 49:18">pou yo sèvi kon bijou ou,</para>
  <para style="q1" vid="ISA 49:18">e tache yo sou ou kon yon jenn fi k ap marye.”<verse eid="ISA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 49:19"/>Nan plas dezè e dezole ou yo,</para>
  <para style="q1" vid="ISA 49:19">nan peyi detwi nèt ou a,</para>
  <para style="q1" vid="ISA 49:19">anverite, koulye a, ou va manke kont espas pou sila ki vivan yo,</para>
  <para style="q1" vid="ISA 49:19">e <note caller="+" style="x"><char style="xo" closed="false">49:19 </char><char style="xt" closed="false"><ref loc="PSA 56:1-2">Sòm 56:1-2</ref></char></note>sila ki te vale ou yo va ale byen lwen.<verse eid="ISA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 49:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">49:20 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 54:1-3">És 54:1-3</ref>
      </char>
    </note>Pitit ke ou te pèdi yo va gen tan di nan zòrèy ou:</para>
  <para style="q1" vid="ISA 49:20">“Plas sa a twò piti pou mwen;</para>
  <para style="q1" vid="ISA 49:20">fè espas pou mwen pou m ka viv isit la.”<verse eid="ISA 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 49:21"/>Epi ou va di nan kè ou: ‘Se kilès ki te fè sila yo pou mwen,</para>
  <para style="q1" vid="ISA 49:21">paske mwen te pèdi pitit mwen yo,</para>
  <para style="q1" vid="ISA 49:21">e mwen rete sèl, yon <note caller="+" style="x"><char style="xo" closed="false">49:21 </char><char style="xt" closed="false"><ref loc="ISA 5:13">És 5:13</ref></char></note>egzile e yon vwayajè?</para>
  <para style="q1" vid="ISA 49:21">Konsa, se kilès ki te leve sila yo?</para>
  <para style="q1" vid="ISA 49:21">Gade byen, mwen te kite sèl. Ki kote sila yo te sòti?’”<verse eid="ISA 49:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 49:22"/>Konsa pale Senyè BONDYE a:</para>
  <para style="q1" vid="ISA 49:22">“Gade byen, Mwen va leve men M vè nasyon yo</para>
  <para style="q1" vid="ISA 49:22">e Mwen va monte drapo Mwen a lòt pèp yo.</para>
  <para style="q1" vid="ISA 49:22">Yo va <note caller="+" style="x"><char style="xo" closed="false">49:22 </char><char style="xt" closed="false"><ref loc="ISA 14:2">És 14:2</ref></char></note>mennen fis ou yo nan sen yo,</para>
  <para style="q1" vid="ISA 49:22">e fi nou yo va pote sou zepòl yo.<verse eid="ISA 49:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 49:23"/>Wa yo va sèvi kon papa adoptif nou yo,</para>
  <para style="q1" vid="ISA 49:23">e fi yo kon manman nouris.</para>
  <para style="q1" vid="ISA 49:23">Yo va bese ba devan ou ak figi yo atè,</para>
  <para style="q1" vid="ISA 49:23">pou niche pousyè nan pye ou.</para>
  <para style="q1" vid="ISA 49:23">Konsa, ou va konnen ke Mwen se SENYÈ a;</para>
  <para style="q1" vid="ISA 49:23">sila ki <note caller="+" style="x"><char style="xo" closed="false">49:23 </char><char style="xt" closed="false"><ref loc="PSA 37:9">Sòm 37:9</ref></char></note>tann Mwen yo p ap vin wont.”<verse eid="ISA 49:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 49:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">49:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:29">Mat 12:29</ref>
      </char>
    </note>Èske piyaj la kapab rache nan men a nonm pwisan an?</para>
  <para style="q1" vid="ISA 49:24">Oswa èske kaptif lejitim yo kapab delivre?<verse eid="ISA 49:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 49:25"/>Anverite, konsa pale SENYÈ a: “Menm <note caller="+" style="x"><char style="xo" closed="false">49:25 </char><char style="xt" closed="false"><ref loc="ISA 10:6">És 10:6</ref></char></note>kaptif a nonm pwisan la va soti,</para>
  <para style="q1" vid="ISA 49:25">e piyaj la va rache nan men nonm fò a;</para>
  <para style="q1" vid="ISA 49:25">paske Mwen va batay ak sila ki batay avèk ou</para>
  <para style="q1" vid="ISA 49:25">e Mwen va sove fis ou yo.<verse eid="ISA 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 49:26"/>Mwen va fè opresè ou yo manje pwòp chè yo;</para>
  <para style="q1" vid="ISA 49:26">yo va vin sou ak pwòp san yo tankou ak diven dous.</para>
  <para style="q1" vid="ISA 49:26">Konsa, tout chè va konnen ke Mwen menm, SENYÈ a,</para>
  <para style="q1" vid="ISA 49:26">se Sovè ou e redanmtè ou, Pwisan A Jacob la.”<verse eid="ISA 49:26"/></para>
  <chapter eid="ISA 49"/>
  <chapter number="50" style="c" sid="ISA 50"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 50:1"/>Konsa pale SENYÈ a: “Kote sètifika divòs ak sila</para>
  <para style="q1" vid="ISA 50:1">Mwen te voye manman ou ale a?</para>
  <para style="q1" vid="ISA 50:1">Oswa èske Mwen te <note caller="+" style="x"><char style="xo" closed="false">50:1 </char><char style="xt" closed="false"><ref loc="DEU 32:30">Det 32:30</ref></char></note>vann ou bay ou yo?</para>
  <para style="q1" vid="ISA 50:1">Gade byen, ou te vann akoz inikite ou yo,</para>
  <para style="q1" vid="ISA 50:1">e manman ou te voye ale akoz transgresyon ou yo.<verse eid="ISA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 50:2"/>Poukisa pa t gen moun lè M te vini an?</para>
  <para style="q1" vid="ISA 50:2">Lè M te rele a, èske pa t gen moun pou reponn?</para>
  <para style="q1" vid="ISA 50:2">Èske men M tèlman kout pou li pa ka rachte?</para>
  <para style="q1" vid="ISA 50:2">Oswa èske Mwen pa gen okenn pouvwa pou rachte moun?</para>
  <para style="q1" vid="ISA 50:2">Gade byen, Mwen fè lanmè a sèk ak repwòch Mwen;</para>
  <para style="q1" vid="ISA 50:2">Mwen <note caller="+" style="x"><char style="xo" closed="false">50:2 </char><char style="xt" closed="false"><ref loc="JOS 3:16">Jos 3:16</ref></char></note>fè rivyè yo vin dezè.</para>
  <para style="q1" vid="ISA 50:2">Pwason pa yo gen move sant akoz mank dlo, e yo mouri ak swaf.<verse eid="ISA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 50:3"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">50:3 </char><char style="xt" closed="false"><ref loc="ISA 13:10">És 13:10</ref></char></note>abiye syèl yo ak fènwa</para>
  <para style="q1" vid="ISA 50:3">e kouvri yo ak twal sak.”<verse eid="ISA 50:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 50:4"/>Senyè a te ban Mwen lang a <note caller="+" style="x"><char style="xo" closed="false">50:4 </char><char style="xt" closed="false"><ref loc="ISA 8:16">És 8:16</ref></char></note>sa yo ki enstwi yo,</para>
  <para style="q1" vid="ISA 50:4">pou M ka konnen jan pou bay pawòl soutyen a sila ki fatige.</para>
  <para style="q1" vid="ISA 50:4">Li fè M leve maten apre maten,</para>
  <para style="q1" vid="ISA 50:4">Li fè zòrèy Mwen leve pou koute kon yon disip.<verse eid="ISA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 50:5"/>SENYÈ a te ouvri zòrèy Mwen.</para>
  <para style="q1" vid="ISA 50:5">Mwen <note caller="+" style="x"><char style="xo" closed="false">50:5 </char><char style="xt" closed="false"><ref loc="MAT 26:39">Mat 26:39</ref></char></note>pa t rebèl, ni Mwen pa t fè bak.<verse eid="ISA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 50:6"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">50:6 </char><char style="xt" closed="false"><ref loc="MAT 26:67">Mat 26:67</ref></char></note>te bay do M a sila ki te vle frape Mwen yo,</para>
  <para style="q1" vid="ISA 50:6">ak machwè M a sila ki t ap rache bab Mwen yo;</para>
  <para style="q1" vid="ISA 50:6">Mwen pa t kouvri figi Mwen devan imilyasyon ak krache.<verse eid="ISA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 50:7"/>Paske Senyè BONDYE a va <note caller="+" style="x"><char style="xo" closed="false">50:7 </char><char style="xt" closed="false"><ref loc="ISA 42:1">És 42:1</ref></char></note>fè M sekou.</para>
  <para style="q1" vid="ISA 50:7">Pou sa, Mwen pa t twouble menm.</para>
  <para style="q1" vid="ISA 50:7">Pou sa, Mwen te fè figi M vin di tankou silèks.</para>
  <para style="q1" vid="ISA 50:7">Konsa, Mwen konnen ke M p ap vin wont.<verse eid="ISA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 50:8"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">50:8 </char><char style="xt" closed="false"><ref loc="ISA 45:25">És 45:25</ref></char></note>jistifye Mwen an toupre;</para>
  <para style="q1" vid="ISA 50:8">se kilès ki mennen ka a kont Mwen?</para>
  <para style="q1" vid="ISA 50:8">Kite li rale pre M.<verse eid="ISA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 50:9"/>Gade byen, Senyè BONDYE a fè M sekou;</para>
  <para style="q1" vid="ISA 50:9">se kilès ki kondane Mwen?</para>
  <para style="q1" vid="ISA 50:9">Gade byen, yo tout va vin vye;</para>
  <para style="q1" vid="ISA 50:9">epwize tankou yon vètman.</para>
  <para style="q1" vid="ISA 50:9">Mit papiyon twal yo va manje yo.<verse eid="ISA 50:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 50:10"/>Se kilès pami nou ki krent SENYÈ a,</para>
  <para style="q1" vid="ISA 50:10">ki obeyi vwa a <note caller="+" style="x"><char style="xo" closed="false">50:10 </char><char style="xt" closed="false"><ref loc="ISA 49:2-3">És 49:2-3</ref></char></note>sèvitè Li a,</para>
  <para style="q1" vid="ISA 50:10">ki mache nan fènwa a e ki pa gen limyè a?</para>
  <para style="q1" vid="ISA 50:10">Kite li mete konfyans nan non SENYÈ a</para>
  <para style="q1" vid="ISA 50:10">e depann de Bondye li a.<verse eid="ISA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 50:11"/>Gade byen, nou tout ki <note caller="+" style="x"><char style="xo" closed="false">50:11 </char><char style="xt" closed="false"><ref loc="PRO 26:18">Pwov 26:18</ref></char></note>limen yon dife,</para>
  <para style="q1" vid="ISA 50:11">ki antoure nou ak tòch ki limen dife yo;</para>
  <para style="q1" vid="ISA 50:11">mache nan limyè dife nou te fè a,</para>
  <para style="q1" vid="ISA 50:11">e pami tòch yo nou te lime a.</para>
  <para style="q1" vid="ISA 50:11">Men sa nou va jwenn nan men Mwen an:</para>
  <para style="q1" vid="ISA 50:11">Nou va kouche pou fè lamantasyon.<verse eid="ISA 50:11"/></para>
  <chapter eid="ISA 50"/>
  <chapter number="51" style="c" sid="ISA 51"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 51:1"/>“Koute mwen, nou menm ki swiv ladwati a,</para>
  <para style="q1" vid="ISA 51:1">k ap <note caller="+" style="x"><char style="xo" closed="false">51:1 </char><char style="xt" closed="false"><ref loc="PSA 94:15">Sòm 94:15</ref></char></note>chache SENYÈ a:</para>
  <para style="q1" vid="ISA 51:1">Gade vè wòch sou sila nou te taye a,</para>
  <para style="q1" vid="ISA 51:1">vè min wòch kote nou te retire a.<verse eid="ISA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 51:2"/>Gade vè <note caller="+" style="x"><char style="xo" closed="false">51:2 </char><char style="xt" closed="false"><ref loc="ISA 29:22">És 29:22</ref></char></note>Abraham, papa nou an</para>
  <para style="q1" vid="ISA 51:2">ak Sarah, ki te fè nou soti nan vant.</para>
  <para style="q1" vid="ISA 51:2">Lè li te yon sèl, Mwen te rele li,</para>
  <para style="q1" vid="ISA 51:2">Mwen te beni li, e te fè l vin miltipliye.”<verse eid="ISA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 51:3"/>Anverite, SENYÈ a te konsole Sion;</para>
  <para style="q1" vid="ISA 51:3">Li te rekonfòte tout kote dezole li yo.</para>
  <para style="q1" vid="ISA 51:3">Epi savann li yo te fèt sanble ak <note caller="+" style="x"><char style="xo" closed="false">51:3 </char><char style="xt" closed="false"><ref loc="GEN 2:8">Jen 2:8</ref></char></note>Éden,</para>
  <para style="q1" vid="ISA 51:3">e dezè yo tankou jaden Senyè a.</para>
  <para style="q1" vid="ISA 51:3">Lajwa ak kè kontan va twouve nan yo;</para>
  <para style="q1" vid="ISA 51:3">remèsiman ak son melodi chanson.<verse eid="ISA 51:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 51:4"/>“Prete atansyon a Mwen, O pèp Mwen an</para>
  <para style="q1" vid="ISA 51:4">e prete Mwen zòrèy nou, O nasyon Mwen an;</para>
  <para style="q1" vid="ISA 51:4">paske yon lwa va sòti nan Mwen</para>
  <para style="q1" vid="ISA 51:4">e Mwen va <note caller="+" style="x"><char style="xo" closed="false">51:4 </char><char style="xt" closed="false"><ref loc="ISA 1:27">És 1:27</ref></char></note>poze jistis Mwen kon yon limyè a tout pèp yo.<verse eid="ISA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 51:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">51:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 46:13">És 46:13</ref>
      </char>
    </note>Ladwati Mwen toupre a.</para>
  <para style="q1" vid="ISA 51:5">Sali Mwen te voye deyò.</para>
  <para style="q1" vid="ISA 51:5">Se bra M kap jije pèp yo.</para>
  <para style="q1" vid="ISA 51:5">Peyi kot yo va tann Mwen,</para>
  <para style="q1" vid="ISA 51:5">e bra M va jije pèp yo.<verse eid="ISA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 51:6"/>Leve zye nou vè syèl la</para>
  <para style="q1" vid="ISA 51:6">e gade anba vè latè;</para>
  <para style="q1" vid="ISA 51:6">paske syèl la va disparèt tankou lafimen;</para>
  <para style="q1" vid="ISA 51:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">51:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:25-26">Sòm 102:25-26</ref>
      </char>
    </note>latè va epwize tankou yon vètman.</para>
  <para style="q1" vid="ISA 51:6">Konsa, moun ki rete ladann yo va mouri;</para>
  <para style="q1" vid="ISA 51:6">men delivrans Mwen va la jis pou tout tan,</para>
  <para style="q1" vid="ISA 51:6">e ladwati Mwen p ap janm sispann.<verse eid="ISA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 51:7"/>“Koute Mwen, nou menm ki konnen ladwati,</para>
  <para style="q1" vid="ISA 51:7">yon pèp ki gen lalwa M nan <note caller="+" style="x"><char style="xo" closed="false">51:7 </char><char style="xt" closed="false"><ref loc="PSA 37:31">Sòm 37:31</ref></char></note>kè yo.</para>
  <para style="q1" vid="ISA 51:7">Pa pè repwòch a lòm,</para>
  <para style="q1" vid="ISA 51:7">ni dekouraje lè y ap meprize nou.<verse eid="ISA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 51:8"/>Paske papiyon va manje yo tankou yon vètman,</para>
  <para style="q1" vid="ISA 51:8">e <note caller="+" style="x"><char style="xo" closed="false">51:8 </char><char style="xt" closed="false"><ref loc="ISA 14:11">És 14:11</ref></char></note>mit va manje yo tankou len.</para>
  <para style="q1" vid="ISA 51:8">Men ladwati Mwen va jis pou tout tan,</para>
  <para style="q1" vid="ISA 51:8">e sali Mwen, a tout jenerasyon yo.”<verse eid="ISA 51:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 51:9"/>“Leve, leve, mete fòs sou Ou, O bra SENYÈ a;</para>
  <para style="q1" vid="ISA 51:9">leve tankou nan jou lansyen yo.</para>
  <para style="q1" vid="ISA 51:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">51:9 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 26:12">Job 26:12</ref>
      </char>
    </note>Èske se pa t Ou menm ki te koupe Rahab an ti mòso a,</para>
  <para style="q1" vid="ISA 51:9">ki te frennen dragon an nèt la?<verse eid="ISA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 51:10"/>Èske se pa Ou menm ki te seche lanmè a,</para>
  <para style="q1" vid="ISA 51:10">dlo yo a gran fon an;</para>
  <para style="q1" vid="ISA 51:10">ki te fè pwofondè lanmè yo yon chemen</para>
  <para style="q1" vid="ISA 51:10">pou rachte yo ta ka travèse lòtbò?<verse eid="ISA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 51:11"/>Pou sa, rachte a SENYÈ yo va retounen;</para>
  <para style="q1" vid="ISA 51:11">vini ak gwo kri lajwa a Sion yo.</para>
  <para style="q1" vid="ISA 51:11">Epi lajwa ki dire nèt la va sou tèt yo.</para>
  <para style="q1" vid="ISA 51:11">Yo va jwenn kè kontan ak lajwa,</para>
  <para style="q1" vid="ISA 51:11">e <note caller="+" style="x"><char style="xo" closed="false">51:11 </char><char style="xt" closed="false"><ref loc="ISA 60:19">És 60:19</ref></char></note>tristès ak soupi pa yo va disparèt nèt.<verse eid="ISA 51:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 51:12"/>“Mwen, Mwen menm se Sila ki <note caller="+" style="x"><char style="xo" closed="false">51:12 </char><char style="xt" closed="false"><ref loc="ISA 51:3">És 51:3</ref></char></note>bannou konsolasyon an.</para>
  <para style="q1" vid="ISA 51:12">Se kilès ou ye pou ou pè moun ki va mouri,</para>
  <para style="q1" vid="ISA 51:12">ak fis a moun ki fèt tankou zèb la?<verse eid="ISA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 51:13"/>Èske ou te <note caller="+" style="x"><char style="xo" closed="false">51:13 </char><char style="xt" closed="false"><ref loc="DEU 6:12">Det 6:12</ref></char></note>bliye SENYÈ a, Kreyatè ou a,</para>
  <para style="q1" vid="ISA 51:13">ki te rale ouvri syèl yo</para>
  <para style="q1" vid="ISA 51:13">e te poze fondasyon latè yo?</para>
  <para style="q1" vid="ISA 51:13">Eske nou krent tout jounen akoz kòlè opresè a,</para>
  <para style="q1" vid="ISA 51:13">pandan l ap prepare pou detwi?</para>
  <para style="q1" vid="ISA 51:13">Men ki kote kòlè opresè sila a?<verse eid="ISA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 51:14"/>Toutalè <note caller="+" style="x"><char style="xo" closed="false">51:14 </char><char style="xt" closed="false"><ref loc="ISA 48:20">És 48:20</ref></char></note>egzile a va libere.</para>
  <para style="q1" vid="ISA 51:14">Li p ap mouri nan kacho a,</para>
  <para style="q1" vid="ISA 51:14">ni li p ap manke pen.<verse eid="ISA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 51:15"/>Paske Mwen se SENYÈ Bondye ou a,</para>
  <para style="q1" vid="ISA 51:15">ki fè <note caller="+" style="x"><char style="xo" closed="false">51:15 </char><char style="xt" closed="false"><ref loc="PSA 107:25">Sòm 107:25</ref></char></note>boulvèse lanmè a,</para>
  <para style="q1" vid="ISA 51:15">Ki fè lanm li yo gwonde.</para>
  <para style="q1" vid="ISA 51:15">SENYÈ dèzame yo se non Li.<verse eid="ISA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 51:16"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">51:16 </char><char style="xt" closed="false"><ref loc="DEU 18:18">Det 18:18</ref></char></note>mete pawòl Mwen nan bouch ou</para>
  <para style="q1" vid="ISA 51:16">e te kouvri ou avèk lonbraj men Mwen,</para>
  <para style="q1" vid="ISA 51:16">pou etabli syèl yo, fonde latè a</para>
  <para style="q1" vid="ISA 51:16">e pou di a Sion: ‘Ou se pèp Mwen.’”<verse eid="ISA 51:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 51:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">51:17 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 51:9">És 51:9</ref>
      </char>
    </note>Leve ou menm! Leve ou menm!</para>
  <para style="q1" vid="ISA 51:17">Kanpe, O Jérusalem!</para>
  <para style="q1" vid="ISA 51:17">Ou menm ki te bwè depi nan men SENYÈ a, tas kòlè Li.</para>
  <para style="q1" vid="ISA 51:17">Gode ki pou fè ou kilbite a,</para>
  <para style="q1" vid="ISA 51:17">ou fin bwè jis rive nan kras anba l.<verse eid="ISA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 51:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">51:18 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 88:18">Sòm 88:18</ref>
      </char>
    </note>Nanpwen moun ki pou gide fi a</para>
  <para style="q1" vid="ISA 51:18">pami tout fis li te fè yo,</para>
  <para style="q1" vid="ISA 51:18">ni nanpwen moun ki pou pran l pa lamen</para>
  <para style="q1" vid="ISA 51:18">pami tout fis li te leve yo.<verse eid="ISA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 51:19"/>Se de bagay sa yo ki gen tan rive ou—</para>
  <para style="q1" vid="ISA 51:19">se kilès ki va kriye pou ou?—</para>
  <para style="q1" vid="ISA 51:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">51:19 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 8:21">És 8:21</ref>
      </char>
    </note>devastasyon ak destriksyon,</para>
  <para style="q1" vid="ISA 51:19">gwo grangou, ak nepe.</para>
  <para style="q1" vid="ISA 51:19">Kijan pou m ta konsole ou?<verse eid="ISA 51:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 51:20"/>Fis ou yo vin endispoze;</para>
  <para style="q1" vid="ISA 51:20">yo kouche atè sou pwent a chak ri,</para>
  <para style="q1" vid="ISA 51:20">tankou antilòp ki kenbe nan pèlen.</para>
  <para style="q1" vid="ISA 51:20">Yo ranpli ak kòlè SENYÈ a,</para>
  <para style="q1" vid="ISA 51:20">ak <note caller="+" style="x"><char style="xo" closed="false">51:20 </char><char style="xt" closed="false"><ref loc="ISA 66:15">És 66:15</ref></char></note>repwòch Bondye ou a.<verse eid="ISA 51:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 51:21"/>Pou sa, souple, koute sa, ou menm ki <note caller="+" style="x"><char style="xo" closed="false">51:21 </char><char style="xt" closed="false"><ref loc="ISA 54:11">És 54:11</ref></char></note>aflije,</para>
  <para style="q1" vid="ISA 51:21">ki sou, men pa avèk diven:<verse eid="ISA 51:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 51:22"/>Konsa pale Senyè ou a,</para>
  <para style="q1" vid="ISA 51:22">SENYÈ a, menm Bondye ou,</para>
  <para style="q1" vid="ISA 51:22">ki pran plede kòz pou pèp Li a:</para>
  <para style="q1" vid="ISA 51:22">“Gade byen, Mwen te retire <note caller="+" style="x"><char style="xo" closed="false">51:22 </char><char style="xt" closed="false"><ref loc="ISA 51:17">És 51:17</ref></char></note>tas kilbite a,</para>
  <para style="q1" vid="ISA 51:22">gode kòlè Mwen an soti nan men ou;</para>
  <para style="q1" vid="ISA 51:22">ou p ap janm bwè l ankò.<verse eid="ISA 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 51:23"/>M ap mete li nan men a sila k ap toumante ou yo,</para>
  <para style="q1" vid="ISA 51:23">ki te di nanm ou: <note caller="+" style="x"><char style="xo" closed="false">51:23 </char><char style="xt" closed="false"><ref loc="JOS 10:24">Jos 10:24</ref></char></note> ‘Kouche pou nou ka mache sou ou’.</para>
  <para style="q1" vid="ISA 51:23">Ou te kouche fè do ou vin tankou tè a;</para>
  <para style="q1" vid="ISA 51:23">tankou gran lari pou sila k ap mache sou li yo.”<verse eid="ISA 51:23"/></para>
  <chapter eid="ISA 51"/>
  <chapter number="52" style="c" sid="ISA 52"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 52:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">52:1 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 51:9-17">És 51:9-17</ref>
      </char>
    </note>Leve, leve! Abiye ou menm ak fòs ou, O Sion.</para>
  <para style="q1" vid="ISA 52:1">Abiye ak bèl vètman ou yo, O Jérusalem, vil sen an;</para>
  <para style="q1" vid="ISA 52:1">paske ensikonsi yo ak pa pwòp yo</para>
  <para style="q1" vid="ISA 52:1">p ap antre kote ou a ankò.<verse eid="ISA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 52:2"/>Souke leve kò ou <note caller="+" style="x"><char style="xo" closed="false">52:2 </char><char style="xt" closed="false"><ref loc="ISA 29:4">És 29:4</ref></char></note>sòti nan pousyè a,</para>
  <para style="q1" vid="ISA 52:2">O kaptif Jérusalem nan!</para>
  <para style="q1" vid="ISA 52:2">Retire chenn sa yo nan kou ou,</para>
  <para style="q1" vid="ISA 52:2">O fi kaptif a Sion an.<verse eid="ISA 52:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 52:3"/>Paske konsa pale SENYÈ a: “Ou te vann pou granmesi</para>
  <para style="q1" vid="ISA 52:3">e ou va <note caller="+" style="x"><char style="xo" closed="false">52:3 </char><char style="xt" closed="false"><ref loc="ISA 1:27">És 1:27</ref></char></note>rachte san vèse lajan.”<verse eid="ISA 52:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 52:4"/>Paske konsa pale SENYÈ a:</para>
  <para style="q1" vid="ISA 52:4">“Pèp Mwen an nan kòmansman,</para>
  <para style="q1" vid="ISA 52:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">52:4 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 46:6">Jen 46:6</ref>
      </char>
    </note>te desann an Égypte pou rezide la,</para>
  <para style="q1" vid="ISA 52:4">epi Asiryen yo te oprime yo san koz.<verse eid="ISA 52:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 52:5"/>Alò, pou sa, kisa Mwen gen pou fè isit la?” deklare SENYÈ a,</para>
  <para style="q1" vid="ISA 52:5">“konsi pèp Mwen an te retire san koz?”</para>
  <para style="q1" vid="ISA 52:5">Ankò deklare SENYÈ a:</para>
  <para style="q1" vid="ISA 52:5">“Konsi, pèp Mwen rachte pou reyen,</para>
  <para style="q1" vid="ISA 52:5">epi sila ki renye sou yo giyonnen yo ak kè kontan,</para>
  <para style="q1" vid="ISA 52:5">e <note caller="+" style="x"><char style="xo" closed="false">52:5 </char><char style="xt" closed="false"><ref loc="EZK 36:20-23">Éz 36:20-23</ref></char></note>non Mwen blasfeme tout lajounen,<verse eid="ISA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 52:6"/>pou sa, pèp Mwen an va <note caller="+" style="x"><char style="xo" closed="false">52:6 </char><char style="xt" closed="false"><ref loc="ISA 49:23">És 49:23</ref></char></note>konnen non Mwen.</para>
  <para style="q1" vid="ISA 52:6">Pou sa, nan jou sa a, yo va konnen se Mwen menm k ap pale.</para>
  <para style="q1" vid="ISA 52:6">Gade byen, se Mwen!”<verse eid="ISA 52:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 52:7"/>A la bèl sou mon yo, se pye a sila ki pote <note caller="+" style="x"><char style="xo" closed="false">52:7 </char><char style="xt" closed="false"><ref loc="ISA 40:9">És 40:9</ref></char></note>bòn nouvèl la,</para>
  <para style="q1" vid="ISA 52:7">ki anonse lapè,</para>
  <para style="q1" vid="ISA 52:7">ki pote bòn nouvèl k ap fè kè kontan,</para>
  <para style="q1" vid="ISA 52:7">ki anonse Sali,</para>
  <para style="q1" vid="ISA 52:7">ki di a Sion: “Bondye pa ou a renye!”<verse eid="ISA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 52:8"/>Gadyen ou yo leve <note caller="+" style="x"><char style="xo" closed="false">52:8 </char><char style="xt" closed="false"><ref loc="ISA 62:6">És 62:6</ref></char></note>vwa yo.</para>
  <para style="q1" vid="ISA 52:8">Yo rele fò ak kè kontan ansanm;</para>
  <para style="q1" vid="ISA 52:8">paske yo va wè ak pwòp zye yo</para>
  <para style="q1" vid="ISA 52:8">lè SENYÈ a retounen nan Sion an.<verse eid="ISA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 52:9"/>Eklate, rele ak jwa ansanm, kote ki dezole Jérusalem yo,</para>
  <para style="q1" vid="ISA 52:9">paske SENYÈ a te konsole pèp Li a.</para>
  <para style="q1" vid="ISA 52:9">Li te <note caller="+" style="x"><char style="xo" closed="false">52:9 </char><char style="xt" closed="false"><ref loc="ISA 43:1">És 43:1</ref></char></note>rachte Jérusalem.<verse eid="ISA 52:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 52:10"/>SENYÈ a te dekouvri sen bra Li pou tout nasyon yo wè.</para>
  <para style="q1" vid="ISA 52:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">52:10 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 45:22">És 45:22</ref>
      </char>
    </note>Tout dènye pwent latè yo te wè sali a Bondye nou an.<verse eid="ISA 52:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 52:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">52:11 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 48:20">És 48:20</ref>
      </char>
    </note>Sòti! Sòti! Kite kote sa a!</para>
  <para style="q1" vid="ISA 52:11">Pa touche anyen ki pa pwòp!</para>
  <para style="q1" vid="ISA 52:11">Sòti nan mitan li!</para>
  <para style="q1" vid="ISA 52:11">Vin pirifye nou menm!</para>
  <para style="q1" vid="ISA 52:11">Netwaye nou, nou ki pote veso SENYÈ a.<verse eid="ISA 52:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 52:12"/>Nou p ap kite ak gran vites,</para>
  <para style="q1" vid="ISA 52:12">ni nou p ap kouri devan moun;</para>
  <para style="q1" vid="ISA 52:12">paske <note caller="+" style="x"><char style="xo" closed="false">52:12 </char><char style="xt" closed="false"><ref loc="ISA 26:7">És 26:7</ref></char></note>SENYÈ a va ale devan nou</para>
  <para style="q1" vid="ISA 52:12">e Bondye Israël la va fè gad an aryè.<verse eid="ISA 52:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 52:13"/>Gade byen, <note caller="+" style="x"><char style="xo" closed="false">52:13 </char><char style="xt" closed="false"><ref loc="ISA 42:1">És 42:1</ref></char></note>sèvitè Mwen an va aji avèk sajès.</para>
  <para style="q1" vid="ISA 52:13">Li va leve wo, e vin egzalte anpil.<verse eid="ISA 52:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 52:14"/>Menm jan ke anpil moun te etone de ou—</para>
  <para style="q1" vid="ISA 52:14">konsa <note caller="+" style="x"><char style="xo" closed="false">52:14 </char><char style="xt" closed="false"><ref loc="ISA 53:2-3">És 53:2-3</ref></char></note>aparans Li te defòme plis ke tout lòt moun,</para>
  <para style="q1" vid="ISA 52:14">e fòm li plis ke fis a lòm yo.<verse eid="ISA 52:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 52:15"/>Konsa, Li va farinen sou anpil nasyon.</para>
  <para style="q1" vid="ISA 52:15">Wa yo va pe bouch yo pou koz Li;</para>
  <para style="q1" vid="ISA 52:15">paske <note caller="+" style="x"><char style="xo" closed="false">52:15 </char><char style="xt" closed="false"><ref loc="ROM 15:21">Wo 15:21</ref></char></note>sa ke yo pa t konn tande a, yo va wè l,</para>
  <para style="q1" vid="ISA 52:15">e sa ke yo pa t koute, yo va konprann li.<verse eid="ISA 52:15"/></para>
  <chapter eid="ISA 52"/>
  <chapter number="53" style="c" sid="ISA 53"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 53:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">53:1 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 12:38">Jn 12:38</ref>
      </char>
    </note>Se kilès ki te kwè mesaj nou yo?</para>
  <para style="q1" vid="ISA 53:1">Epi a kilès bra SENYÈ a te vin revele?<verse eid="ISA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 53:2"/>Paske Li te grandi devan nou kon yon <note caller="+" style="x"><char style="xo" closed="false">53:2 </char><char style="xt" closed="false"><ref loc="ISA 11:1">És 11:1</ref></char></note>boujon vèt,</para>
  <para style="q1" vid="ISA 53:2">e tankou yon rasin ki sòti nan tè sèk.</para>
  <para style="q1" vid="ISA 53:2">Li pa gen okenn bèlte nan fòm Li,</para>
  <para style="q1" vid="ISA 53:2">ni majeste pou nou ta gade sou Li,</para>
  <para style="q1" vid="ISA 53:2">ni aparans pou nou ta atire a Li.<verse eid="ISA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 53:3"/>Li te meprize e abandone pa lòm;</para>
  <para style="q1" vid="ISA 53:3">yon nonm ak gwo tristès</para>
  <para style="q1" vid="ISA 53:3">ki te konnen gwo soufrans,</para>
  <para style="q1" vid="ISA 53:3">ak tout maladi.</para>
  <para style="q1" vid="ISA 53:3">Tankou yon moun de sila moun kache figi yo,</para>
  <para style="q1" vid="ISA 53:3">Li te vin <note caller="+" style="x"><char style="xo" closed="false">53:3 </char><char style="xt" closed="false"><ref loc="MRK 10:33">Mc 10:33</ref></char></note>meprize,</para>
  <para style="q1" vid="ISA 53:3">e nou pa t bay Li okenn valè.<verse eid="ISA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 53:4"/>Anverite, se doulè nou yo Li te <note caller="+" style="x"><char style="xo" closed="false">53:4 </char><char style="xt" closed="false"><ref loc="MAT 8:17">Mat 8:17</ref></char></note>pote</para>
  <para style="q1" vid="ISA 53:4">ak soufrans nou yo Li te chaje sou do L;</para>
  <para style="q1" vid="ISA 53:4">men nou te rekonèt Li kon moun pini,</para>
  <para style="q1" vid="ISA 53:4">frape pa Bondye e aflije.<verse eid="ISA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 53:5"/>Men Li te frennen, pèse nèt pou peche nou yo.</para>
  <para style="q1" vid="ISA 53:5">Li te kraze pou <note caller="+" style="x"><char style="xo" closed="false">53:5 </char><char style="xt" closed="false"><ref loc="1PE 2:24-25">I Pi 2:24-25</ref></char></note>inikite nou yo.</para>
  <para style="q1" vid="ISA 53:5">Chatiman ki fè nou gen lapè a te tonbe sou Li,</para>
  <para style="q1" vid="ISA 53:5">e se pa blesi Li yo, nou te jwenn gerizon.<verse eid="ISA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 53:6"/>Nou tout kon mouton, te pèdi chemen nou yo.</para>
  <para style="q1" vid="ISA 53:6">Nou chak te antre nan pwòp chemen pa nou,</para>
  <para style="q1" vid="ISA 53:6">men SENYÈ a te fè inikite a nou tout tonbe sou Li.<verse eid="ISA 53:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 53:7"/>Li te vin oprime e aflije;</para>
  <para style="q1" vid="ISA 53:7">malgre sa, Li pa t ouvri bouch Li.</para>
  <para style="q1" vid="ISA 53:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">53:7 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:32-33">Trav 8:32-33</ref>
      </char>
    </note>Tankou yon jèn mouton ki t ap mennen labatwa,</para>
  <para style="q1" vid="ISA 53:7">e tankou yon mouton ki rete an silans devan sila</para>
  <para style="q1" vid="ISA 53:7">k ap taye lenn li yo,</para>
  <para style="q1" vid="ISA 53:7">konsa Li pa t ouvri bouch Li.<verse eid="ISA 53:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 53:8"/>Avèk opresyon avèk jijman Li te retire nèt.</para>
  <para style="q1" vid="ISA 53:8">Selon jenerasyon Li,</para>
  <para style="q1" vid="ISA 53:8">yo te konsidere Li te koupe retire nèt nan peyi a vivan yo,</para>
  <para style="q1" vid="ISA 53:8">ke Li te kraze <note caller="+" style="x"><char style="xo" closed="false">53:8 </char><char style="xt" closed="false"><ref loc="ISA 55:5-12">És 55:5-12</ref></char></note> akoz peche a pèp Mwen yo.<verse eid="ISA 53:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 53:9"/>Tonbo pa L te pataje pami moun mechan yo,</para>
  <para style="q1" vid="ISA 53:9">men se avèk yon nonm rich Li te ye nan lanmò Li,</para>
  <para style="q1" vid="ISA 53:9">malgre Li pa t fè okenn vyolans,</para>
  <para style="q1" vid="ISA 53:9">ni pa t gen okenn desepsyon nan bouch Li.<verse eid="ISA 53:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 53:10"/>Men SENYÈ a te kontan <note caller="+" style="x"><char style="xo" closed="false">53:10 </char><char style="xt" closed="false"><ref loc="ISA 53:5">És 53:5</ref></char></note>brize Li;</para>
  <para style="q1" vid="ISA 53:10">pou mete Li nan gwo soufrans,</para>
  <para style="q1" vid="ISA 53:10">pou L ta rann Li menm kon yon ofrann koupabilite,</para>
  <para style="q1" vid="ISA 53:10">pou L ta wè desandan Li yo.</para>
  <para style="q1" vid="ISA 53:10">Li va pwolonje jou Li yo,</para>
  <para style="q1" vid="ISA 53:10">e bon plezi SENYÈ a va reyisi nan men Li.<verse eid="ISA 53:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 53:11"/>Apre gwo doulè nanm Li an,</para>
  <para style="q1" vid="ISA 53:11">Li va <note caller="+" style="x"><char style="xo" closed="false">53:11 </char><char style="xt" closed="false"><ref loc="JHN 10:14-18">Jn 10:14-18</ref></char></note>wè limyè a,</para>
  <para style="q1" vid="ISA 53:11">e Li va satisfè.</para>
  <para style="q1" vid="ISA 53:11">Sèvitè Ladwati Mwen an va jistifye anpil moun</para>
  <para style="q1" vid="ISA 53:11">akoz konnesans Li anvè Li menm;</para>
  <para style="q1" vid="ISA 53:11">e Li va pote inikite yo.<verse eid="ISA 53:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 53:12"/>Konsa, Mwen va bay Li yon pòsyon ak gwo moun yo.</para>
  <para style="q1" vid="ISA 53:12">Li va divize piyaj ak moun pwisan yo,</para>
  <para style="q1" vid="ISA 53:12">akoz Li te livre <note caller="+" style="x"><char style="xo" closed="false">53:12 </char><char style="xt" closed="false"><ref loc="MAT 26:38-42">Mat 26:38-42</ref></char></note>nanm Li menm a lanmò,</para>
  <para style="q1" vid="ISA 53:12">e Li te konte avèk malfektè yo;</para>
  <para style="q1" vid="ISA 53:12">malgre Li te pote peche a anpil moun,</para>
  <para style="q1" vid="ISA 53:12">e te entèsede pou koupab yo.<verse eid="ISA 53:12"/></para>
  <chapter eid="ISA 53"/>
  <chapter number="54" style="c" sid="ISA 54"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 54:1"/>“Chante, O esteril la!</para>
  <para style="q1" vid="ISA 54:1">Ou menm ki pa t kapab fè pitit!</para>
  <para style="q1" vid="ISA 54:1">Eklate nan yon gwo kri lajwa, e kriye fò,</para>
  <para style="q1" vid="ISA 54:1">ou menm ki pa t gen doulè ansent lan!</para>
  <para style="q1" vid="ISA 54:1">Paske fis fanm <note caller="+" style="x"><char style="xo" closed="false">54:1 </char><char style="xt" closed="false"><ref loc="ISA 62:4">És 62:4</ref></char></note>abandone an va depase fis a</para>
  <para style="q1" vid="ISA 54:1">fanm ki marye yo”, SENYÈ a di.<verse eid="ISA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 54:2"/>“Agrandi anplasman tant ou;</para>
  <para style="q1" vid="ISA 54:2">lonje rido lakay ou, pa ralanti!</para>
  <para style="q1" vid="ISA 54:2">Fè kòd yo pi long e fòtifye <note caller="+" style="x"><char style="xo" closed="false">54:2 </char><char style="xt" closed="false"><ref loc="EXO 35:18">Egz 35:18</ref></char></note>pikèt yo.<verse eid="ISA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 54:3"/>Paske ou va <note caller="+" style="x"><char style="xo" closed="false">54:3 </char><char style="xt" closed="false"><ref loc="GEN 28:14">Jen 28:14</ref></char></note>gaye toupatou, ni adwat, ni agoch.</para>
  <para style="q1" vid="ISA 54:3">Konsa, desandan ou yo va posede nasyon yo.</para>
  <para style="q1" vid="ISA 54:3">Yo va rete ankò nan vil abandone yo.”<verse eid="ISA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 54:4"/>“Pa pè, paske ou <note caller="+" style="x"><char style="xo" closed="false">54:4 </char><char style="xt" closed="false"><ref loc="ISA 45:17">És 45:17</ref></char></note>p ap vin wont.</para>
  <para style="q1" vid="ISA 54:4">Pa santi ou imilye, paske ou p ap desi.</para>
  <para style="q1" vid="ISA 54:4">Ou p ap sonje wont jenès ou</para>
  <para style="q1" vid="ISA 54:4">ak repwòch tankou vèv.</para>
  <para style="q1" vid="ISA 54:4">Sa va bliye nèt.<verse eid="ISA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 54:5"/>Paske <note caller="+" style="x"><char style="xo" closed="false">54:5 </char><char style="xt" closed="false"><ref loc="JER 3:14">Jr 3:14</ref></char></note>mari ou se Kreyatè ou a;</para>
  <para style="q1" vid="ISA 54:5">yo rele L SENYÈ dèzame yo.</para>
  <para style="q1" vid="ISA 54:5">Redanmtè ou se Sila Ki Sen An Israël la.</para>
  <para style="q1" vid="ISA 54:5">Yo rele Li Bondye a tout latè a.<verse eid="ISA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 54:6"/>Paske SENYÈ a te rele ou</para>
  <para style="q1" vid="ISA 54:6">kon yon madanm <note caller="+" style="x"><char style="xo" closed="false">54:6 </char><char style="xt" closed="false"><ref loc="ISA 49:14-21">És 49:14-21</ref></char></note>abandone e atriste nan lespri,</para>
  <para style="q1" vid="ISA 54:6">menm kon yon madanm nan jenès li</para>
  <para style="q1" vid="ISA 54:6">lè l abandone,” di Bondye ou.<verse eid="ISA 54:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 54:7"/>“Pou yon <note caller="+" style="x"><char style="xo" closed="false">54:7 </char><char style="xt" closed="false"><ref loc="ISA 26:20">És 26:20</ref></char></note>ti tan kout, Mwen te kite ou;</para>
  <para style="q1" vid="ISA 54:7">men ak gran konpasyon, Mwen va ranmase ou.<verse eid="ISA 54:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 54:8"/>Nan anpil kòlè, Mwen te kache figi M pou yon moman,</para>
  <para style="q1" vid="ISA 54:8">men ak lanmou dous ki p ap janm fini an,</para>
  <para style="q1" vid="ISA 54:8">Mwen va gen konpasyon pou ou”, di SENYÈ a, Redanmtè ou a.<verse eid="ISA 54:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 54:9"/>“Paske pou Mwen, sa se tankou jou Noé yo.</para>
  <para style="q1" vid="ISA 54:9">Menm jan Mwen te sèmante ke dlo a Noé yo <note caller="+" style="x"><char style="xo" closed="false">54:9 </char><char style="xt" closed="false"><ref loc="GEN 9:11">Jen 9:11</ref></char></note>pa ta janm inonde latè ankò,</para>
  <para style="q1" vid="ISA 54:9">konsa Mwen te sèmante ke Mwen p ap fache avèk ou,</para>
  <para style="q1" vid="ISA 54:9">ni ke Mwen p ap repwoche nou.<verse eid="ISA 54:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 54:10"/>Paske mòn yo kapab deplase,</para>
  <para style="q1" vid="ISA 54:10">e kolin yo ka disparèt,</para>
  <para style="q1" vid="ISA 54:10">men lanmou dous Mwen anvè ou menm p ap retire de ou.</para>
  <para style="q1" vid="ISA 54:10">Ni <note caller="+" style="x"><char style="xo" closed="false">54:10 </char><char style="xt" closed="false"><ref loc="2SA 23:5">II Sam 23:5</ref></char></note>akò lapè Mwen p ap soti menm,”</para>
  <para style="q1" vid="ISA 54:10">di SENYÈ ki gen konpasyon pou ou a.<verse eid="ISA 54:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 54:11"/>O sila ki aflije a, balote pa tanpèt la e san <note caller="+" style="x"><char style="xo" closed="false">54:11 </char><char style="xt" closed="false"><ref loc="ISA 51:18-19">És 51:18-19</ref></char></note>konsolasyon an;</para>
  <para style="q1" vid="ISA 54:11">gade byen, Mwen va monte bijou ou ak bon kòl</para>
  <para style="q1" vid="ISA 54:11">ki fèt pou bijou bèl koulè yo,</para>
  <para style="q1" vid="ISA 54:11">epi fondasyon ou yo va poze ak pyè safì.<verse eid="ISA 54:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 54:12"/>Anplis, Mwen va fè ranpa ou ak bijou ribi,</para>
  <para style="q1" vid="ISA 54:12">pòtay nou yo ak pyè kristal,</para>
  <para style="q1" vid="ISA 54:12">e tout miray ou yo ak pyè presye.<verse eid="ISA 54:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 54:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">54:13 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:45">Jn 6:45</ref>
      </char>
    </note>Tout fis ou yo va enstwi pa SENYÈ a;</para>
  <para style="q1" vid="ISA 54:13">pitit ou yo va gen lapè ak bonè nèt.<verse eid="ISA 54:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 54:14"/>Nan <note caller="+" style="x"><char style="xo" closed="false">54:14 </char><char style="xt" closed="false"><ref loc="ISA 1:26-27">És 1:26-27</ref></char></note>ladwati, ou va etabli;</para>
  <para style="q1" vid="ISA 54:14">ou va rete lwen opresyon,</para>
  <para style="q1" vid="ISA 54:14">paske ou p ap gen lakrent.</para>
  <para style="q1" vid="ISA 54:14">Ou p ap gen gwo laperèz, paske li p ap pwoche ou.<verse eid="ISA 54:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 54:15"/>Si nenpòt moun atake ou, se pa kote M sa va sòti.</para>
  <para style="q1" vid="ISA 54:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">54:15 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 41:11-16">És 41:11-16</ref>
      </char>
    </note>Nenpòt moun ki atake ou va tonbe akoz ou menm.<verse eid="ISA 54:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 54:16"/>“Gade byen, se Mwen menm ki te kreye bòs fòjewon</para>
  <para style="q1" vid="ISA 54:16">ki pou soufle dife chabon an,</para>
  <para style="q1" vid="ISA 54:16">e fè sòti yon zam pou travay li.</para>
  <para style="q1" vid="ISA 54:16">Mwen te kreye destriktè a pou l ka detwi.<verse eid="ISA 54:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 54:17"/>Nanpwen zam ki fòme kont ou k ap reyisi;</para>
  <para style="q1" vid="ISA 54:17">epi tout lang ki akize ou nan jijman, ou va kondane yo.</para>
  <para style="q1" vid="ISA 54:17">Sa se eritaj a sèvitè a SENYÈ yo.</para>
  <para style="q1" vid="ISA 54:17">
    <note caller="+" style="x">
      <char style="xo" closed="false">54:17 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 45:24">És 45:24</ref>
      </char>
    </note>Jistis pa yo sòti de Mwen,” deklare SENYÈ a.<verse eid="ISA 54:17"/></para>
  <chapter eid="ISA 54"/>
  <chapter number="55" style="c" sid="ISA 55"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 55:1"/>“Gade! Tout sa ki swaf yo, vin nan dlo!</para>
  <para style="q1" vid="ISA 55:1">Nou menm ki pa gen kòb yo, vin achte pou manje.</para>
  <para style="q1" vid="ISA 55:1">Vin achte diven ak lèt san lajan, e san frè.<verse eid="ISA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 55:2"/>Poukisa nou depanse lajan pou sa ki pa pen,</para>
  <para style="q1" vid="ISA 55:2">ak kouraj travay nou pou sa ki pa ka satisfè?</para>
  <para style="q1" vid="ISA 55:2">Koute Mwen avèk atansyon, <note caller="+" style="x"><char style="xo" closed="false">55:2 </char><char style="xt" closed="false"><ref loc="PSA 22:26">Sòm 22:26</ref></char></note>manje sa ki bon</para>
  <para style="q1" vid="ISA 55:2">e pran plezi nou an abondans.<verse eid="ISA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 55:3"/>Prete zòrèy nou e vin kote Mwen.</para>
  <para style="q1" vid="ISA 55:3">Koute pou nou ka viv.</para>
  <para style="q1" vid="ISA 55:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">55:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 13:34">Trav 13:34</ref>
      </char>
    </note>Mwen va fè yon akò avè w k ap dire pou tout tan,</para>
  <para style="q1" vid="ISA 55:3">selon mizerikòd fidèl ki te montre a David la.<verse eid="ISA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 55:4"/>Gade byen, Mwen te bay <note caller="+" style="x"><char style="xo" closed="false">55:4 </char><char style="xt" closed="false"><ref loc="PSA 18:43">Sòm 18:43</ref></char></note>li kon yon temwen a pèp la,</para>
  <para style="q1" vid="ISA 55:4">yon chèf ak kòmandè pou pèp la.<verse eid="ISA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 55:5"/>Gade byen, ou va rele yon nasyon ou pa rekonèt;</para>
  <para style="q1" vid="ISA 55:5">yon nasyon ki pa rekonèt ou va <note caller="+" style="x"><char style="xo" closed="false">55:5 </char><char style="xt" closed="false"><ref loc="ZEC 8:22">Za 8:22</ref></char></note>kouri bò kote ou,</para>
  <para style="q1" vid="ISA 55:5">akoz SENYÈ Bondye ou a,</para>
  <para style="q1" vid="ISA 55:5">ak Sila Ki Sen an Israël la;</para>
  <para style="q1" vid="ISA 55:5">paske Li te bay ou glwa.”<verse eid="ISA 55:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 55:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">55:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:6">Sòm 32:6</ref>
      </char>
    </note>Chache SENYÈ a pandan Li kapab twouve;</para>
  <para style="q1" vid="ISA 55:6">rele Li pandan Li toupre a.<verse eid="ISA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 55:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">55:7 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:16-19">És 1:16-19</ref>
      </char>
    </note>Kite mechan an abandone chemen li an,</para>
  <para style="q1" vid="ISA 55:7">ak pechè a, panse li yo.</para>
  <para style="q1" vid="ISA 55:7">Kite li retounen kote SENYÈ a</para>
  <para style="q1" vid="ISA 55:7">e Li va gen mizerikòd sou li;</para>
  <para style="q1" vid="ISA 55:7">anvè Bondye nou an, ki pa janm manke mizerikòd.<verse eid="ISA 55:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 55:8"/>“Paske, panse pa Mwen yo se pa <note caller="+" style="x"><char style="xo" closed="false">55:8 </char><char style="xt" closed="false"><ref loc="ISA 65:2">És 65:2</ref></char></note>panse pa w,</para>
  <para style="q1" vid="ISA 55:8">ni wout ou yo se pa wout pa M”, deklare SENYÈ a.<verse eid="ISA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 55:9"/>Paske <note caller="+" style="x"><char style="xo" closed="false">55:9 </char><char style="xt" closed="false"><ref loc="PSA 103:11">Sòm 103:11</ref></char></note>tankou syèl yo pi wo ke tè a,</para>
  <para style="q1" vid="ISA 55:9">konsa wout Mwen yo pi wo ke wout pa w yo,</para>
  <para style="q1" vid="ISA 55:9">e panse Mwen yo ke panse pa w yo.<verse eid="ISA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 55:10"/>Paske menm jan ke lapli ak lanèj desann sòti nan syèl la,</para>
  <para style="q1" vid="ISA 55:10">e pa retounen la, san ke yo pa awoze tè a,</para>
  <para style="q1" vid="ISA 55:10">pou fè l donnen e boujonnen,</para>
  <para style="q1" vid="ISA 55:10">pou fè l bay <note caller="+" style="x"><char style="xo" closed="false">55:10 </char><char style="xt" closed="false"><ref loc="2CH 9:10">II Kwo 9:10</ref></char></note>semans pou kiltivatè,</para>
  <para style="q1" vid="ISA 55:10">ak pen pou sila k ap manje a;<verse eid="ISA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 55:11"/>se konsa pawòl Mwen ki sòti nan bouch Mwen va ye.</para>
  <para style="q1" vid="ISA 55:11">Li <note caller="+" style="x"><char style="xo" closed="false">55:11 </char><char style="xt" closed="false"><ref loc="ISA 44:26">És 44:26</ref></char></note>p ap retounen kote Mwen vid,</para>
  <para style="q1" vid="ISA 55:11">san ke li pa akonpli sa ke M dezire a,</para>
  <para style="q1" vid="ISA 55:11">san ke li pa akonpli bi pou sila Mwen te voye li a.<verse eid="ISA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 55:12"/>Paske ou va sòti ak <note caller="+" style="x"><char style="xo" closed="false">55:12 </char><char style="xt" closed="false"><ref loc="PSA 105:43">Sòm 105:43</ref></char></note>kè kontan</para>
  <para style="q1" vid="ISA 55:12">e mennen sòti ak lapè.</para>
  <para style="q1" vid="ISA 55:12">Mòn yo ak kolin yo va eklate</para>
  <para style="q1" vid="ISA 55:12">nan gwo kri lajwa devan ou,</para>
  <para style="q1" vid="ISA 55:12">e tout bwa nan chan yo va bat men yo.<verse eid="ISA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 55:13"/>Olye de bwa pikan, bwa siprè va leve;</para>
  <para style="q1" vid="ISA 55:13">olye <note caller="+" style="x"><char style="xo" closed="false">55:13 </char><char style="xt" closed="false"><ref loc="ISA 5:6">És 5:6</ref></char></note>machacha, bwa jasmen va leve.</para>
  <para style="q1" vid="ISA 55:13">Sa va sèvi kon yon memoryal a SENYÈ a,</para>
  <para style="q1" vid="ISA 55:13">kon yon sign k ap dire nèt, ki p ap janm disparèt.<verse eid="ISA 55:13"/></para>
  <chapter eid="ISA 55"/>
  <chapter number="56" style="c" sid="ISA 56"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 56:1"/>Konsa pale SENYÈ a:</para>
  <para style="q1" vid="ISA 56:1">“Konsève sa ki jis</para>
  <para style="q1" vid="ISA 56:1">e fè sa ki dwat,</para>
  <para style="q1" vid="ISA 56:1">paske <note caller="+" style="x"><char style="xo" closed="false">56:1 </char><char style="xt" closed="false"><ref loc="PSA 85:9">Sòm 85:9</ref></char></note>sali Mwen an prèt pou rive</para>
  <para style="q1" vid="ISA 56:1">e ladwati Mwen va vin revele.<verse eid="ISA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 56:2"/>A la <note caller="+" style="x"><char style="xo" closed="false">56:2 </char><char style="xt" closed="false"><ref loc="PSA 112:1">Sòm 112:1</ref></char></note>beni nonm ki fè sa a beni,</para>
  <para style="q1" vid="ISA 56:2">e fis a mesye a ki kenbe sa a fèm;</para>
  <para style="q1" vid="ISA 56:2">ki pa janm derespekte Saba a,</para>
  <para style="q1" vid="ISA 56:2">e ki anpeche men l fè mal la.”<verse eid="ISA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 56:3"/>Pa kite etranje a ki te vin jwenn ak SENYÈ a di:</para>
  <para style="q1" vid="ISA 56:3">“Anverite, SENYÈ a va fè m separe de pèp li a.”</para>
  <para style="q1" vid="ISA 56:3">Ni pa kite <note caller="+" style="x"><char style="xo" closed="false">56:3 </char><char style="xt" closed="false"><ref loc="DEU 23:1">Det 23:1</ref></char></note> enik lan di:</para>
  <para style="q1" vid="ISA 56:3">“Gade byen, mwen se yon bwa sèch”.<verse eid="ISA 56:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 56:4"/>Paske konsa pale SENYÈ a:</para>
  <para style="q1" vid="ISA 56:4">“A enik yo ki <note caller="+" style="x"><char style="xo" closed="false">56:4 </char><char style="xt" closed="false"><ref loc="ISA 56:2-6">És 56:2-6</ref></char></note>kenbe Saba Mwen yo,</para>
  <para style="q1" vid="ISA 56:4">ki chwazi sa ki fè M plezi,</para>
  <para style="q1" vid="ISA 56:4">e ki kenbe fèm nan akò Mwen an,<verse eid="ISA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 56:5"/>a yo menm, Mwen va livre depi andann lakay Mwen an;</para>
  <para style="q1" vid="ISA 56:5">anndan miray Mwen yo, yon memoryal</para>
  <para style="q1" vid="ISA 56:5">e yon <note caller="+" style="x"><char style="xo" closed="false">56:5 </char><char style="xt" closed="false"><ref loc="ISA 62:2">És 62:2</ref></char></note>non ki meyè a fis yo oswa fi yo.</para>
  <para style="q1" vid="ISA 56:5">Mwen va bay yo yon non</para>
  <para style="q1" vid="ISA 56:5">k ap dire nèt jis pou letènite,</para>
  <para style="q1" vid="ISA 56:5">ki p ap janm disparèt.”<verse eid="ISA 56:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 56:6"/>“Anplis, <note caller="+" style="x"><char style="xo" closed="false">56:6 </char><char style="xt" closed="false"><ref loc="ISA 56:3">És 56:3</ref></char></note>etranje ki vin atache yo menm a SENYÈ a,</para>
  <para style="q1" vid="ISA 56:6">pou sèvi Li,</para>
  <para style="q1" vid="ISA 56:6">pou renmen non a SENYÈ a,</para>
  <para style="q1" vid="ISA 56:6">pou vin sèvitè Li,</para>
  <para style="q1" vid="ISA 56:6">yo tout ki pa derespekte Saba a,</para>
  <para style="q1" vid="ISA 56:6">e ki kenbe fèm sou akò Mwen an;<verse eid="ISA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 56:7"/>menm sila yo Mwen va mennen sou mòn sen Mwen an,</para>
  <para style="q1" vid="ISA 56:7">e fè yo plenn lajwa andedan kay priyè Mwen an.</para>
  <para style="q1" vid="ISA 56:7">Ofrann brile yo ak sakrifis yo va akseptab sou lotèl Mwen an;</para>
  <para style="q1" vid="ISA 56:7">paske <note caller="+" style="x"><char style="xo" closed="false">56:7 </char><char style="xt" closed="false"><ref loc="MAT 21:13">Mat 21:13</ref></char></note>kay Mwen an va rele yon kay lapriyè pou tout pèp yo.”<verse eid="ISA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 56:8"/>Senyè BONDYE a, ki <note caller="+" style="x"><char style="xo" closed="false">56:8 </char><char style="xt" closed="false"><ref loc="ISA 11:12">És 11:12</ref></char></note>rasanble dispèse a Israël yo, deklare:</para>
  <para style="q1" vid="ISA 56:8">“Mwen va rasanble lòt yo anvè yo,</para>
  <para style="q1" vid="ISA 56:8">lòt anplis de sila ki deja rasanble yo.”<verse eid="ISA 56:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 56:9"/>Nou tout, <note caller="+" style="x"><char style="xo" closed="false">56:9 </char><char style="xt" closed="false"><ref loc="EZK 3:17">Éz 3:17</ref></char></note>bèt a chan yo,</para>
  <para style="q1" vid="ISA 56:9">vin manje,</para>
  <para style="q1" vid="ISA 56:9">ak tout bèt a forè yo.<verse eid="ISA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 56:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">56:10 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 3:17">Éz 3:17</ref>
      </char>
    </note>Gadyen Li yo avèg.</para>
  <para style="q1" vid="ISA 56:10">Tout nan yo san konprann.</para>
  <para style="q1" vid="ISA 56:10">Se chen bèbè ki pa ka jape;</para>
  <para style="q1" vid="ISA 56:10">moun k ap kouche fè rèv,</para>
  <para style="q1" vid="ISA 56:10">ki renmen somèy.<verse eid="ISA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 56:11"/>Wi, chen yo voras.</para>
  <para style="q1" vid="ISA 56:11">Yo pa janm jwenn asi.</para>
  <para style="q1" vid="ISA 56:11">Se bèje yo ye san konprann.</para>
  <para style="q1" vid="ISA 56:11">Yo tout <note caller="+" style="x"><char style="xo" closed="false">56:11 </char><char style="xt" closed="false"><ref loc="ISA 57:17">És 57:17</ref></char></note>vire tounen nan pwòp chemen pa yo,</para>
  <para style="q1" vid="ISA 56:11">yo chak nan ranmase byen de tout katye.<verse eid="ISA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 56:12"/>“Vini”, yo di: “Annou twouve diven;</para>
  <para style="q1" vid="ISA 56:12">annou bwè anpil bwason fò.</para>
  <para style="q1" vid="ISA 56:12">Epi <note caller="+" style="x"><char style="xo" closed="false">56:12 </char><char style="xt" closed="false"><ref loc="PSA 10:6">Sòm 10:6</ref></char></note>demen na p fè menm jan ak jodi a!</para>
  <para style="q1" vid="ISA 56:12">Plis menm!”<verse eid="ISA 56:12"/></para>
  <chapter eid="ISA 56"/>
  <chapter number="57" style="c" sid="ISA 57"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 57:1"/>Moun dwat la peri,</para>
  <para style="q1" vid="ISA 57:1">men pèsòn pa pran sa a kè.</para>
  <para style="q1" vid="ISA 57:1">Sila ak mizerikòd vin retire,</para>
  <para style="q1" vid="ISA 57:1">men pèsòn pa konsidere</para>
  <para style="q1" vid="ISA 57:1">ke moun dwat la retire pou anpeche <note caller="+" style="x"><char style="xo" closed="false">57:1 </char><char style="xt" closed="false"><ref loc="2KI 22:20">II Wa 22:20</ref></char></note>mal la rive l.<verse eid="ISA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 57:2"/>Li antre nan lapè.</para>
  <para style="q1" vid="ISA 57:2">Chak antre nan pwòp kabann pa l;</para>
  <para style="q1" vid="ISA 57:2">tout sila ki te <note caller="+" style="x"><char style="xo" closed="false">57:2 </char><char style="xt" closed="false"><ref loc="ISA 26:7">És 26:7</ref></char></note>mache dwat nan chemen li yo.<verse eid="ISA 57:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 57:3"/>“Men vini isit la, nou menm fis a yon manbo,</para>
  <para style="q1" vid="ISA 57:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">57:3 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:4">És 1:4</ref>
      </char>
    </note>desandan a yon fanm adiltè ak yon pwostitiye.<verse eid="ISA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 57:4"/>Se kont kilès nou fè plezi a?</para>
  <para style="q1" vid="ISA 57:4">Kont kilès nou ouvri bouch nou laj</para>
  <para style="q1" vid="ISA 57:4">e lonje lang nou an?</para>
  <para style="q1" vid="ISA 57:4">Se pa desandan a <note caller="+" style="x"><char style="xo" closed="false">57:4 </char><char style="xt" closed="false"><ref loc="ISA 48:8">És 48:8</ref></char></note>rebèl nou ye,</para>
  <para style="q1" vid="ISA 57:4">ak pòtè a desepsyon?<verse eid="ISA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 57:5"/>Kap limen tèt nou pami bwadchenn yo,</para>
  <para style="q1" vid="ISA 57:5">anba tout gwo bwa vèt,</para>
  <para style="q1" vid="ISA 57:5">ki <note caller="+" style="x"><char style="xo" closed="false">57:5 </char><char style="xt" closed="false"><ref loc="2KI 23:10">II Wa 23:10</ref></char></note>fè masak timoun yo nan ravin yo,</para>
  <para style="q1" vid="ISA 57:5">anba fenèt wòch gwo falèz yo?<verse eid="ISA 57:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 57:6"/>Pami <note caller="+" style="x"><char style="xo" closed="false">57:6 </char><char style="xt" closed="false"><ref loc="JER 3:9">Jr 3:9</ref></char></note>wòch swa nan ravin nan se pòsyon pa w;</para>
  <para style="q1" vid="ISA 57:6">pou yo menm ou te voye osò a.</para>
  <para style="q1" vid="ISA 57:6">Menm pou yo menm, ou te vide yon ofrann bwason.</para>
  <para style="q1" vid="ISA 57:6">Ou te fè yon ofrann sereyal.</para>
  <para style="q1" vid="ISA 57:6">Èske M ta dwe ralanti konsènan bagay sa yo?<verse eid="ISA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 57:7"/>Sou yon gwo mòn byen wo, ou <note caller="+" style="x"><char style="xo" closed="false">57:7 </char><char style="xt" closed="false"><ref loc="EZK 23:41">Éz 23:41</ref></char></note>te fè kabann ou.</para>
  <para style="q1" vid="ISA 57:7">Anplis, se la, ou te monte pou ofri sakrifis.<verse eid="ISA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 57:8"/>Dèyè pòt la ak chanbrann pòt la, ou te fè monte souvni ou;</para>
  <para style="q1" vid="ISA 57:8">ou te ouvri ou menm a yon lòt sòf ke mwen.</para>
  <para style="q1" vid="ISA 57:8">Konsa, ou te monte.</para>
  <para style="q1" vid="ISA 57:8">Ou te ale fè kabann ou byen laj.</para>
  <para style="q1" vid="ISA 57:8">Konsa ou te antann ou avèk yo.</para>
  <para style="q1" vid="ISA 57:8">Ou te byen renmen sa ou te we sou kabann yo.<verse eid="ISA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 57:9"/>Ou te ale kote wa a ak lwil,</para>
  <para style="q1" vid="ISA 57:9">e ou te ogmante pafen ou yo;</para>
  <para style="q1" vid="ISA 57:9">ou te <note caller="+" style="x"><char style="xo" closed="false">57:9 </char><char style="xt" closed="false"><ref loc="EZK 23:16-40">Éz 23:16-40</ref></char></note>voye mesaje ou yo rete lwen,</para>
  <para style="q1" vid="ISA 57:9">e te degrade ou menm jis rive nan Sejou mò yo.<verse eid="ISA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 57:10"/>Ou te fatige akoz wout ou te long,</para>
  <para style="q1" vid="ISA 57:10">men ou pa t di: <note caller="+" style="x"><char style="xo" closed="false">57:10 </char><char style="xt" closed="false"><ref loc="JER 2:25">Jr 2:25</ref></char></note>‘Nanpwen espwa.’</para>
  <para style="q1" vid="ISA 57:10">Ou te jwenn fòs renouvle.</para>
  <para style="q1" vid="ISA 57:10">Ou pa t febli menm.<verse eid="ISA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 57:11"/>De <note caller="+" style="x"><char style="xo" closed="false">57:11 </char><char style="xt" closed="false"><ref loc="PRO 29:25">Pwov 29:25</ref></char></note>kilès ou te pè e twouble a,</para>
  <para style="q1" vid="ISA 57:11">ki fè w manti pou w pa sonje Mwen an,</para>
  <para style="q1" vid="ISA 57:11">ni menm panse a Mwen an?</para>
  <para style="q1" vid="ISA 57:11">Èske Mwen pa t rete an silans pou anpil tan</para>
  <para style="q1" vid="ISA 57:11">ki fè ou pa gen lakrent Mwen an?<verse eid="ISA 57:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 57:12"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">57:12 </char><char style="xt" closed="false"><ref loc="ISA 58:1-2">És 58:1-2</ref></char></note>deklare ladwati ou ak zèv ou yo,</para>
  <para style="q1" vid="ISA 57:12">men yo p ap nan avantaj ou.<verse eid="ISA 57:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 57:13"/>Lè ou vin kriye fò, <note caller="+" style="x"><char style="xo" closed="false">57:13 </char><char style="xt" closed="false"><ref loc="JER 22:20">Jr 22:20</ref></char></note>kite zidòl ou yo delivre ou.</para>
  <para style="q1" vid="ISA 57:13">Men van an va pote yo ale.</para>
  <para style="q1" vid="ISA 57:13">Yon souf va rale yo monte.</para>
  <para style="q1" vid="ISA 57:13">Men sila ki kache nan Mwen an va eritye peyi a.</para>
  <para style="q1" vid="ISA 57:13">Li va posede mòn sen Mwen an.”<verse eid="ISA 57:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 57:14"/>Li va di: <note caller="+" style="x"><char style="xo" closed="false">57:14 </char><char style="xt" closed="false"><ref loc="ISA 62:10">És 62:10</ref></char></note>“Fè l monte, fè l monte, prepare chemen an!</para>
  <para style="q1" vid="ISA 57:14">Retire obstak la ki nan wout pèp Mwen an.”<verse eid="ISA 57:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 57:15"/>Paske se konsa Sila ki wo e egzalte,</para>
  <para style="q1" vid="ISA 57:15">Sila ki viv jis pou tout tan an,</para>
  <para style="q1" vid="ISA 57:15">non a Li se Sila ki Sen an, pale:</para>
  <para style="q1" vid="ISA 57:15">“Mwen rete nan kote ki wo e ki sen,</para>
  <para style="q1" vid="ISA 57:15">anplis ak li menm ki gen <note caller="+" style="x"><char style="xo" closed="false">57:15 </char><char style="xt" closed="false"><ref loc="PSA 34:18">Sòm 34:18</ref></char></note>kè ki pi e ki enb,</para>
  <para style="q1" vid="ISA 57:15">pou fè leve lespri a enb yo,</para>
  <para style="q1" vid="ISA 57:15">e fè leve kè a sila a ki plen regrè pou peche.<verse eid="ISA 57:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 57:16"/>Mwen p ap goumen ak ou pou tout tan,</para>
  <para style="q1" vid="ISA 57:16">
    <note caller="+" style="x">
      <char style="xo" closed="false">57:16 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 85:5">Sòm 85:5</ref>
      </char>
    </note>ni se pa pou tout tan ke M ap fache a;</para>
  <para style="q1" vid="ISA 57:16">paske lespri a ta vin fèb devan M,</para>
  <para style="q1" vid="ISA 57:16">ak nanm a sila ke M te fè yo.<verse eid="ISA 57:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 57:17"/>Akoz inikite <note caller="+" style="x"><char style="xo" closed="false">57:17 </char><char style="xt" closed="false"><ref loc="ISA 2:7">És 2:7</ref></char></note>gwo lanvi li,</para>
  <para style="q1" vid="ISA 57:17">Mwen te fè kòlè, e Mwen te frape li.</para>
  <para style="q1" vid="ISA 57:17">Mwen te kache figi Mwen; Mwen te fache.</para>
  <para style="q1" vid="ISA 57:17">Konsa li te kontinye regrese nan wout kè l te pran an.<verse eid="ISA 57:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 57:18"/>Mwen te wè chemen li yo; malgre sa, <note caller="+" style="x"><char style="xo" closed="false">57:18 </char><char style="xt" closed="false"><ref loc="ISA 19:22">És 19:22</ref></char></note>M ap geri li;</para>
  <para style="q1" vid="ISA 57:18">Mwen va mennen li e restore konsolasyon</para>
  <para style="q1" vid="ISA 57:18">a li menm ak sila k ap lamante pou li.<verse eid="ISA 57:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 57:19"/>Mwen kreye fwi a lèv yo:</para>
  <para style="q1" vid="ISA 57:19">“Lapè, lapè, pou sila ki <note caller="+" style="x"><char style="xo" closed="false">57:19 </char><char style="xt" closed="false"><ref loc="ACT 2:39">Trav 2:39</ref></char></note>lwen yo,</para>
  <para style="q1" vid="ISA 57:19">ak pou sila ki pre yo,” SENYÈ a di:</para>
  <para style="q1" vid="ISA 57:19">“Epi Mwen va geri yo.”<verse eid="ISA 57:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 57:20"/>Men <note caller="+" style="x"><char style="xo" closed="false">57:20 </char><char style="xt" closed="false"><ref loc="JOB 18:5-14">Job 18:5-14</ref></char></note>mechan yo tankou lanmè k ap boulvèse.</para>
  <para style="q1" vid="ISA 57:20">Li p ap ka kalme, e dlo yo</para>
  <para style="q1" vid="ISA 57:20">rale fè monte fatra ak labou.<verse eid="ISA 57:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 57:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">57:21 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 48:22">És 48:22</ref>
      </char>
    </note>“Nanpwen lapè” Bondye Mwen an di:</para>
  <para style="q1" vid="ISA 57:21">“pou mechan yo”.<verse eid="ISA 57:21"/></para>
  <chapter eid="ISA 57"/>
  <chapter number="58" style="c" sid="ISA 58"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 58:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">58:1 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:6">És 40:6</ref>
      </char>
    </note>“Kriye fò, ni pa rete!</para>
  <para style="q1" vid="ISA 58:1">Leve vwa ou tankou yon twonpèt!</para>
  <para style="q1" vid="ISA 58:1">Deklare a pèp Mwen transgresyon yo,</para>
  <para style="q1" vid="ISA 58:1">e a lakay Jacob la, peche yo.<verse eid="ISA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 58:2"/>Malgre yo chache Mwen de jou an jou</para>
  <para style="q1" vid="ISA 58:2">e te fè gwo lanvi pou konnen chemen Mwen yo,</para>
  <para style="q1" vid="ISA 58:2">konsi se yon nasyon ki fè ladwati,</para>
  <para style="q1" vid="ISA 58:2">e ki pa t abandone règleman a Bondye yo.</para>
  <para style="q1" vid="ISA 58:2">Yo mande Mwen pou fè desizyon ki jis.</para>
  <para style="q1" vid="ISA 58:2">Yo pran plezi <note caller="+" style="x"><char style="xo" closed="false">58:2 </char><char style="xt" closed="false"><ref loc="PSA 119:151">Sòm 119:151</ref></char></note>nan pwoksimite Bondye a.<verse eid="ISA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 58:3"/>‘Poukisa nou <note caller="+" style="x"><char style="xo" closed="false">58:3 </char><char style="xt" closed="false"><ref loc="MAL 3:14">Mal 3:14</ref></char></note>fè jèn e Ou pa wè?</para>
  <para style="q1" vid="ISA 58:3">Èske nou imilye nou e Ou pa wè?’</para>
  <para style="b" vid="ISA 58:3"/>
  <para style="q1" vid="ISA 58:3">“Gade byen, nan jou jèn lan, ou satisfè tout dezi nou yo</para>
  <para style="q1" vid="ISA 58:3">e nou kòmande byen di tout ouvriye nou yo.<verse eid="ISA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 58:4"/>Gade byen, nou fè jèn pou <note caller="+" style="x"><char style="xo" closed="false">58:4 </char><char style="xt" closed="false"><ref loc="ISA 3:14">És 3:14</ref></char></note>konfli ak kont;</para>
  <para style="q1" vid="ISA 58:4">pou nou frape ak ponyèt mechan an.</para>
  <para style="q1" vid="ISA 58:4">Kalite jèn nou fè la jodi a pa p fè vwa ou tande anwo a.<verse eid="ISA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 58:5"/>Èske se jèn sa a ki fè kè M kontan?</para>
  <para style="q1" vid="ISA 58:5">Yon jou pou yon nonm ta imilye li menm?</para>
  <para style="q1" vid="ISA 58:5">Pou bese tèt li kon wozo,</para>
  <para style="q1" vid="ISA 58:5">e gaye <note caller="+" style="x"><char style="xo" closed="false">58:5 </char><char style="xt" closed="false"><ref loc="1KI 21:27">I Wa 21:27</ref></char></note>twal sak ak sann kon kabann anba l?</para>
  <para style="q1" vid="ISA 58:5">Èske se yon jèn ke ou rele sa;</para>
  <para style="q1" vid="ISA 58:5">menm yon jou k ap akseptab a SENYÈ a?<verse eid="ISA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 58:6"/>“Se pa jèn sila a ke M pito;</para>
  <para style="q1" vid="ISA 58:6">pou <note caller="+" style="x"><char style="xo" closed="false">58:6 </char><char style="xt" closed="false"><ref loc="NEH 5:10-12">Né 5:10-12</ref></char></note>lache lyann mechanste yo,</para>
  <para style="q1" vid="ISA 58:6">pou demare kòd jouk la,</para>
  <para style="q1" vid="ISA 58:6">pou lese oprime yo pran libète</para>
  <para style="q1" vid="ISA 58:6">e kase tout jouk yo?<verse eid="ISA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 58:7"/>Èske se pa pou divize pen ou ak moun grangou yo,</para>
  <para style="q1" vid="ISA 58:7">e mennen endijan yo antre nan kay?</para>
  <para style="q1" vid="ISA 58:7">Lè ou wè <note caller="+" style="x"><char style="xo" closed="false">58:7 </char><char style="xt" closed="false"><ref loc="MAT 25:35-36">Mat 25:35-36</ref></char></note>toutouni an, pou kouvri l;</para>
  <para style="q1" vid="ISA 58:7">epi pou ou pa kache tèt ou de pwòp chè ou?<verse eid="ISA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 58:8"/>Konsa, limyè ou va pete kon granmmaten,</para>
  <para style="q1" vid="ISA 58:8">e <note caller="+" style="x"><char style="xo" closed="false">58:8 </char><char style="xt" closed="false"><ref loc="EXO 14:19">Egz 14:19</ref></char></note>gerizon ou va vòltije vit devan ou.</para>
  <para style="q1" vid="ISA 58:8">Ladwati ou va ale devan ou,</para>
  <para style="q1" vid="ISA 58:8">e laglwa SENYÈ a va fè gad ou an aryè.<verse eid="ISA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 58:9"/>Nan lè sa a, ou va rele, e SENYÈ a va reponn.</para>
  <para style="q1" vid="ISA 58:9">Ou va kriye e Li va di: ‘Men Mwen isit la’.</para>
  <para style="b" vid="ISA 58:9"/>
  <para style="q1" vid="ISA 58:9">“Si ou retire jouk la nan mitan nou,</para>
  <para style="q1" vid="ISA 58:9">sispann <note caller="+" style="x"><char style="xo" closed="false">58:9 </char><char style="xt" closed="false"><ref loc="PRO 6:13">Pwov 6:13</ref></char></note>pwente dwat sou lòt</para>
  <para style="q1" vid="ISA 58:9">e sispann pale mechanste;<verse eid="ISA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 58:10"/>si ou vide nanm ou a sila ki grangou,</para>
  <para style="q1" vid="ISA 58:10">e satisfè dezi a aflije a;</para>
  <para style="q1" vid="ISA 58:10">nan lè sa a, <note caller="+" style="x"><char style="xo" closed="false">58:10 </char><char style="xt" closed="false"><ref loc="JOB 11:17">Job 11:17</ref></char></note>limyè ou va leve nan fènwa,</para>
  <para style="q1" vid="ISA 58:10">e tristès ou va klere kon gran lajounen.<verse eid="ISA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 58:11"/>Epi SENYÈ a va gide ou tout tan,</para>
  <para style="q1" vid="ISA 58:11">satisfè dezi ou yo kote ki sèch yo,</para>
  <para style="q1" vid="ISA 58:11">e bay fòs a zo ou yo.</para>
  <para style="q1" vid="ISA 58:11">Konsa, ou va kon yon jaden byen awoze</para>
  <para style="q1" vid="ISA 58:11">e tankou yon <note caller="+" style="x"><char style="xo" closed="false">58:11 </char><char style="xt" closed="false"><ref loc="JHN 4:14">Jn 4:14</ref></char></note>sous dlo ki p ap janm seche.<verse eid="ISA 58:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 58:12"/>Sila ki pami ou yo va <note caller="+" style="x"><char style="xo" closed="false">58:12 </char><char style="xt" closed="false"><ref loc="ISA 49:8">És 49:8</ref></char></note>rebati ansyen mazi yo.</para>
  <para style="q1" vid="ISA 58:12">Ou va fè releve ansyen fondasyon yo.</para>
  <para style="q1" vid="ISA 58:12">Konsa yo va rele ou Sila Ki Te Repare Brèch la,</para>
  <para style="q1" vid="ISA 58:12">Sila Ki Te Restore Lari Yo Ak Kay Yo.<verse eid="ISA 58:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 58:13"/>“Si, nan Saba a, ou vire pye ou,</para>
  <para style="q1" vid="ISA 58:13">pou sispann fè pwòp plezi pa ou nan jou sen Mwen an,</para>
  <para style="q1" vid="ISA 58:13">e rele Saba a yon gwo plezi,</para>
  <para style="q1" vid="ISA 58:13">epi jou sen a SENYÈ onorab,</para>
  <para style="q1" vid="ISA 58:13">e bay li onè,</para>
  <para style="q1" vid="ISA 58:13">olye chache <note caller="+" style="x"><char style="xo" closed="false">58:13 </char><char style="xt" closed="false"><ref loc="ISA 55:8">És 55:8</ref></char></note>chemen pa ou,</para>
  <para style="q1" vid="ISA 58:13">olye pwòp plezi pa ou,</para>
  <para style="q1" vid="ISA 58:13">ak pale pwòp pawòl pa w,<verse eid="ISA 58:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 58:14"/>konsa ou va pran plezi nan SENYÈ a,</para>
  <para style="q1" vid="ISA 58:14">e Mwen va fè ou monte <note caller="+" style="x"><char style="xo" closed="false">58:14 </char><char style="xt" closed="false"><ref loc="DEU 32:13">Det 32:13</ref></char></note>sou wotè latè yo.</para>
  <para style="q1" vid="ISA 58:14">Mwen va bay ou manje,</para>
  <para style="q1" vid="ISA 58:14">e Mwen va ba ou eritaj a Jacob, papa ou a,</para>
  <para style="q1" vid="ISA 58:14">paske bouch SENYÈ a pale sa a.”<verse eid="ISA 58:14"/></para>
  <chapter eid="ISA 58"/>
  <chapter number="59" style="c" sid="ISA 59"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 59:1"/>Gade byen, <note caller="+" style="x"><char style="xo" closed="false">59:1 </char><char style="xt" closed="false"><ref loc="NUM 1:23">Nonb 1:23</ref></char></note>men SENYÈ a pa tèlman kout</para>
  <para style="q1" vid="ISA 59:1">pou l pa ka sove;</para>
  <para style="q1" vid="ISA 59:1">ni zòrèy Li pa di pou l pa ka tande.<verse eid="ISA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 59:2"/>Men se <note caller="+" style="x"><char style="xo" closed="false">59:2 </char><char style="xt" closed="false"><ref loc="ISA 1:15">És 1:15</ref></char></note>inikite nou yo ki fè nou separe ak Bondye nou an,</para>
  <para style="q1" vid="ISA 59:2">e se peche nou yo</para>
  <para style="q1" vid="ISA 59:2">ki te kache figi Li de nou menm, pou Li pa tande.<verse eid="ISA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 59:3"/>Paske <note caller="+" style="x"><char style="xo" closed="false">59:3 </char><char style="xt" closed="false"><ref loc="ISA 1:15-21">És 1:15-21</ref></char></note>men nou souye ak san vèse,</para>
  <para style="q1" vid="ISA 59:3">e dwèt nou ak inikite.</para>
  <para style="q1" vid="ISA 59:3">Lèv nou fin pale sa ki fo,</para>
  <para style="q1" vid="ISA 59:3">e lang nou plenyen mechanste.<verse eid="ISA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 59:4"/>Nanpwen moun ki fè pwosè ak dwati,</para>
  <para style="q1" vid="ISA 59:4">ni ki fè plent ak entegrite.</para>
  <para style="q1" vid="ISA 59:4">Yo mete konfyans nan vanite,</para>
  <para style="q1" vid="ISA 59:4">e yo pale manti.</para>
  <para style="q1" vid="ISA 59:4">Yo <note caller="+" style="x"><char style="xo" closed="false">59:4 </char><char style="xt" closed="false"><ref loc="JOB 15:35">Job 15:35</ref></char></note>simen mal e yo rekòlte mechanste.<verse eid="ISA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 59:5"/>Yo kale ze koulèv yo,</para>
  <para style="q1" vid="ISA 59:5">e <note caller="+" style="x"><char style="xo" closed="false">59:5 </char><char style="xt" closed="false"><ref loc="JOB 8:14">Job 8:14</ref></char></note>trese fil arenye yo.</para>
  <para style="q1" vid="ISA 59:5">Sila ki manje ze yo va mouri;</para>
  <para style="q1" vid="ISA 59:5">e nan sa ki kraze a, yon koulèv va pete vin parèt.<verse eid="ISA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 59:6"/>Fil pa yo p ap fè rad;</para>
  <para style="q1" vid="ISA 59:6">ni zèv yo p ap ka <note caller="+" style="x"><char style="xo" closed="false">59:6 </char><char style="xt" closed="false"><ref loc="ISA 28:20">És 28:20</ref></char></note>kouvri yo.</para>
  <para style="q1" vid="ISA 59:6">Zèv pa yo se zèv inikite,</para>
  <para style="q1" vid="ISA 59:6">e se zak vyolans ki rete nan men yo.<verse eid="ISA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 59:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">59:7 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:16">Pwov 1:16</ref>
      </char>
    </note>Pye pa yo kouri vè mal,</para>
  <para style="q1" vid="ISA 59:7">e yo fè vit pou vèse san inosan an.</para>
  <para style="q1" vid="ISA 59:7">Panse pa yo se panse inikite,</para>
  <para style="q1" vid="ISA 59:7">e destriksyon ak dega sou chemen yo.<verse eid="ISA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 59:8"/>Yo pa konnen <note caller="+" style="x"><char style="xo" closed="false">59:8 </char><char style="xt" closed="false"><ref loc="LUK 1:79">Luc 1:79</ref></char></note>chemen lapè,</para>
  <para style="q1" vid="ISA 59:8">e nanpwen jistis nan yo.</para>
  <para style="q1" vid="ISA 59:8">Yo te fè wout kwochi;</para>
  <para style="q1" vid="ISA 59:8">nenpòt moun ki antre kote yo pa konnen lapè.<verse eid="ISA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 59:9"/>Akoz sa, lajistis rete lwen nou,</para>
  <para style="q1" vid="ISA 59:9">e ladwati pa fin rive sou nou.</para>
  <para style="q1" vid="ISA 59:9">Nou espere jwenn limyè pou klere nou,</para>
  <para style="q1" vid="ISA 59:9">men nou mache nan fènwa.<verse eid="ISA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 59:10"/>Nou <note caller="+" style="x"><char style="xo" closed="false">59:10 </char><char style="xt" closed="false"><ref loc="DEU 28:29">Det 28:29</ref></char></note>tatonnen akote mi an tankou moun avèg.</para>
  <para style="q1" vid="ISA 59:10">Nou tatonnen kon sila ki pa gen zye yo.</para>
  <para style="q1" vid="ISA 59:10">Nou kilbite a midi konsi se nan aswè.</para>
  <para style="q1" vid="ISA 59:10">Pami sila ki plen kouraj yo, nou parèt tankou moun mouri.<verse eid="ISA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 59:11"/>Epi nou tout <note caller="+" style="x"><char style="xo" closed="false">59:11 </char><char style="xt" closed="false"><ref loc="ISA 38:14">És 38:14</ref></char></note>gwonde tankou lous,</para>
  <para style="q1" vid="ISA 59:11">e plenyen ak tristès kon toutrèl.</para>
  <para style="q1" vid="ISA 59:11">Nou espere lajistis, men nanpwen;</para>
  <para style="q1" vid="ISA 59:11">pou delivrans, men li lwen nou.<verse eid="ISA 59:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 59:12"/>Paske transgresyon nou yo miltipliye devan Ou,</para>
  <para style="q1" vid="ISA 59:12">e <note caller="+" style="x"><char style="xo" closed="false">59:12 </char><char style="xt" closed="false"><ref loc="ISA 3:9">És 3:9</ref></char></note>peche nou yo temwaye kont nou.</para>
  <para style="q1" vid="ISA 59:12">Paske transgresyon nou yo rete avèk nou</para>
  <para style="q1" vid="ISA 59:12">e nou konnen inikite nou yo:<verse eid="ISA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 59:13"/>Nou fè rebèl e nou <note caller="+" style="x"><char style="xo" closed="false">59:13 </char><char style="xt" closed="false"><ref loc="JOS 24:27">Jos 24:27</ref></char></note>nye SENYÈ a.</para>
  <para style="q1" vid="ISA 59:13">Nou vire kite Bondye nou an,</para>
  <para style="q1" vid="ISA 59:13">ak pawòl opresyon ak rebèl.</para>
  <para style="q1" vid="ISA 59:13">Nan kè a, nou fòmante</para>
  <para style="q1" vid="ISA 59:13">e fè vin parèt pawòl manti.<verse eid="ISA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 59:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">59:14 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:21">És 1:21</ref>
      </char>
    </note>Lajistis vin detounen</para>
  <para style="q1" vid="ISA 59:14">e ladwati vin kanpe byen lwen.</para>
  <para style="q1" vid="ISA 59:14">Paske verite a fin glise tonbe nan lari</para>
  <para style="q1" vid="ISA 59:14">e ladwati p ap ka antre.<verse eid="ISA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 59:15"/>Wi, verite a manke;</para>
  <para style="q1" vid="ISA 59:15">epi sila ki vire akote pou li pa fè mal la,</para>
  <para style="q1" vid="ISA 59:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">59:15 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:23">És 5:23</ref>
      </char>
    </note>fin fè pwòp tèt li yon viktim.</para>
  <para style="b" vid="ISA 59:15"/>
  <para style="q1" vid="ISA 59:15">Alò, SENYÈ a te wè</para>
  <para style="q1" vid="ISA 59:15">e sa pa t fè plezi devan zye L,</para>
  <para style="q1" vid="ISA 59:15">ke pa t gen jistis.<verse eid="ISA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 59:16"/>Li te wè ke pa t gen pèsòn,</para>
  <para style="q1" vid="ISA 59:16">e te etone ke pa t gen moun ki pou entèsede.</para>
  <para style="q1" vid="ISA 59:16">Akoz sa a, <note caller="+" style="x"><char style="xo" closed="false">59:16 </char><char style="xt" closed="false"><ref loc="PSA 98:1">Sòm 98:1</ref></char></note>pwòp bra Li te mennen sali a rive kote Li,</para>
  <para style="q1" vid="ISA 59:16">e ladwati Li te bay Li soutyen.<verse eid="ISA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 59:17"/>Li te abiye ak ladwati kon pwotèj lestomak,</para>
  <para style="q1" vid="ISA 59:17">e ak <note caller="+" style="x"><char style="xo" closed="false">59:17 </char><char style="xt" closed="false"><ref loc="EPH 6:17">Ef 6:17</ref></char></note>kas sali a sou tèt Li.</para>
  <para style="q1" vid="ISA 59:17">Li te mete vètman vanjans kon abiman,</para>
  <para style="q1" vid="ISA 59:17">e te vlope tèt Li ak zèl, kon manto Li.<verse eid="ISA 59:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 59:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">59:18 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 34:11">Job 34:11</ref>
      </char>
    </note>Selon zèv pa yo, konsa Li va rekonpanse yo:</para>
  <para style="q1" vid="ISA 59:18">jijman ak kòlè a advèsè Li yo,</para>
  <para style="q1" vid="ISA 59:18">rekonpans a lènmi Li yo;</para>
  <para style="q1" vid="ISA 59:18">a peyi kot yo, Li va bay sa yo merite.<verse eid="ISA 59:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 59:19"/>Akoz sa, yo va gen krent non SENYÈ a soti nan lwès</para>
  <para style="q1" vid="ISA 59:19">e glwa Li soti kote solèy leve a;</para>
  <para style="q1" vid="ISA 59:19">paske Li va <note caller="+" style="x"><char style="xo" closed="false">59:19 </char><char style="xt" closed="false"><ref loc="ISA 30:28">És 30:28</ref></char></note>vini tankou dlo ravin k ap desann byen rapid.</para>
  <para style="q1" vid="ISA 59:19">Se van SENYÈ a kap pouse l.<verse eid="ISA 59:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 59:20"/>“Yon <note caller="+" style="x"><char style="xo" closed="false">59:20 </char><char style="xt" closed="false"><ref loc="ROM 11:26">Wo 11:26</ref></char></note>Redanmtè va vini nan Sion,</para>
  <para style="q1" vid="ISA 59:20">e a sila ki vire kite transgresyon Jacob yo,” deklare SENYÈ a.<verse eid="ISA 59:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 59:21"/>“Pou Mwen menm, sa se <note caller="+" style="x"><char style="xo" closed="false">59:21 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Jr 31:31-34</ref></char></note>akò mwen avèk yo,” di SENYÈ a: “Lespri Mwen ki sou ou a, e pawòl Mwen ke M te mete nan bouch ou yo p ap janm disparèt nan bouch ou, ni bouch a desandan ou yo, ni bouch a desandan pa yo,” pale SENYÈ a, “depi koulye a e jis rive pou tout tan.”<verse eid="ISA 59:21"/></para>
  <chapter eid="ISA 59"/>
  <chapter number="60" style="c" sid="ISA 60"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 60:1"/>“Leve, briye; paske limyè ou fin parèt</para>
  <para style="q1" vid="ISA 60:1">e <note caller="+" style="x"><char style="xo" closed="false">60:1 </char><char style="xt" closed="false"><ref loc="ISA 24:23">És 24:23</ref></char></note>glwa a SENYÈ a fin leve sou ou.<verse eid="ISA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 60:2"/>Paske gade byen, <note caller="+" style="x"><char style="xo" closed="false">60:2 </char><char style="xt" closed="false"><ref loc="ISA 58:10">És 58:10</ref></char></note>tenèb va kouvri latè</para>
  <para style="q1" vid="ISA 60:2">e pwofon tenèb tout pèp yo.</para>
  <para style="q1" vid="ISA 60:2">Men SENYÈ a va vin leve sou ou,</para>
  <para style="q1" vid="ISA 60:2">e glwa li va parèt sou ou.<verse eid="ISA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 60:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">60:3 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 2:3">És 2:3</ref>
      </char>
    </note>Nasyon yo va vin kote limyè ou a,</para>
  <para style="q1" vid="ISA 60:3">e wa yo nan klète lè ou leve a.<verse eid="ISA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 60:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">60:4 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 11:12">És 11:12</ref>
      </char>
    </note>“Leve zye ou toupatou e gade;</para>
  <para style="q1" vid="ISA 60:4">yo tout rasanble ansanm;</para>
  <para style="q1" vid="ISA 60:4">yo vin kote ou.</para>
  <para style="q1" vid="ISA 60:4">Fis ou yo va vini soti lwen,</para>
  <para style="q1" vid="ISA 60:4">e fi ou yo va pote nan bra yo.<verse eid="ISA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 60:5"/>Epi ou va wè, ou va <note caller="+" style="x"><char style="xo" closed="false">60:5 </char><char style="xt" closed="false"><ref loc="PSA 34:5">Sòm 34:5</ref></char></note>plen ak limyè;</para>
  <para style="q1" vid="ISA 60:5">kè ou va kontan e ou va rejwi.</para>
  <para style="q1" vid="ISA 60:5">Paske abondans lanmè a va vire vè ou;</para>
  <para style="q1" vid="ISA 60:5">gran richès a nasyon yo va rive kote ou.<verse eid="ISA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 60:6"/>Anpil chamo va kouvri ou,</para>
  <para style="q1" vid="ISA 60:6">jenn chamo a Madian ak Épha yo.</para>
  <para style="q1" vid="ISA 60:6">Tout sila soti <note caller="+" style="x"><char style="xo" closed="false">60:6 </char><char style="xt" closed="false"><ref loc="GEN 25:3">Jen 25:3</ref></char></note>Séba yo va vini.</para>
  <para style="q1" vid="ISA 60:6">Yo va pote lò ak lansan,</para>
  <para style="q1" vid="ISA 60:6">e yo va pote bòn nouvèl a, lwanj a SENYÈ a.<verse eid="ISA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 60:7"/>Tout bann mouton Kédar yo va rasanble kote ou.</para>
  <para style="q1" vid="ISA 60:7">Belye a Nebajoth yo va sèvi ou;</para>
  <para style="q1" vid="ISA 60:7">yo va vin aksepte pou monte sou lotèl Mwen an,</para>
  <para style="q1" vid="ISA 60:7">e Mwen va <note caller="+" style="x"><char style="xo" closed="false">60:7 </char><char style="xt" closed="false"><ref loc="ISA 60:13">És 60:13</ref></char></note>glorifye kay Mwen an</para>
  <para style="q1" vid="ISA 60:7">ki plen lonè ak mayifisans.<verse eid="ISA 60:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 60:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">60:8 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:21">És 49:21</ref>
      </char>
    </note>“Se kilès sa yo ki vole tankou yon nwaj</para>
  <para style="q1" vid="ISA 60:8">ak tankou toutrèl vè fenèt pa yo?<verse eid="ISA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 60:9"/>Anverite, peyi kot yo va tann Mwen;</para>
  <para style="q1" vid="ISA 60:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">60:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:7">Sòm 48:7</ref>
      </char>
    </note>gwo bato Tarsis yo va vini premyèman</para>
  <para style="q1" vid="ISA 60:9">pou mennen fis ou yo soti lwen;</para>
  <para style="q1" vid="ISA 60:9">ajan ak lò yo avèk yo, pou non SENYÈ Bondye ou a</para>
  <para style="q1" vid="ISA 60:9">e pou Sila Ki Sen an Israël la,</para>
  <para style="q1" vid="ISA 60:9">akoz Li te bay ou glwa.<verse eid="ISA 60:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 60:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">60:10 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 14:1-2">És 14:1-2</ref>
      </char>
    </note>“Etranje yo va bati, fòtifye miray ou yo,</para>
  <para style="q1" vid="ISA 60:10">epi wa pa yo va fè sèvis pa yo.</para>
  <para style="q1" vid="ISA 60:10">Paske nan kòlè Mwen, Mwen te frape ou</para>
  <para style="q1" vid="ISA 60:10">e nan gras Mwen, Mwen te fè ou mizerikòd.<verse eid="ISA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 60:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">60:11 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 26:2">És 26:2</ref>
      </char>
    </note>Pòtay ou yo va vin louvri nèt tout tan;</para>
  <para style="q1" vid="ISA 60:11">yo p ap fèmen ni lajounen, ni lannwit,</para>
  <para style="q1" vid="ISA 60:11">pou yo kapab pote bay ou richès a tout nasyon yo,</para>
  <para style="q1" vid="ISA 60:11">ak wa yo kon kaptif.<verse eid="ISA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 60:12"/>Paske <note caller="+" style="x"><char style="xo" closed="false">60:12 </char><char style="xt" closed="false"><ref loc="ISA 14:2">És 14:2</ref></char></note>nasyon ak wayòm ki p ap sèvi ou a va peri;</para>
  <para style="q1" vid="ISA 60:12">wi, nasyon sa yo va fin detwi nèt.<verse eid="ISA 60:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 60:13"/>“Glwa a Liban an va rive kote ou,</para>
  <para style="q1" vid="ISA 60:13">bwa pichpen an, bwa sèd ak bwa blan</para>
  <para style="q1" vid="ISA 60:13">pou anbeli plas sanktyè Mwen an.</para>
  <para style="q1" vid="ISA 60:13">Mwen va fè <note caller="+" style="x"><char style="xo" closed="false">60:13 </char><char style="xt" closed="false"><ref loc="1CH 28:2">I Kwo 28:2</ref></char></note>plas pye Mwen yo vin plen glwa.<verse eid="ISA 60:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 60:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">60:14 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 14:1-2">És 14:1-2</ref>
      </char>
    </note>Fis a sila ki te aflije ou yo va vin bese devan ou</para>
  <para style="q1" vid="ISA 60:14">e tout sila ki te meprize ou yo</para>
  <para style="q1" vid="ISA 60:14">va bese yo menm devan pla pye ou.</para>
  <para style="q1" vid="ISA 60:14">Yo va rele ou vil SENYÈ a,</para>
  <para style="q1" vid="ISA 60:14">Sion a Sila Ki Sen an Israël la.<verse eid="ISA 60:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 60:15"/>“Konsi, ou te abandone e rayi, pou pèsòn pa pase ladann,</para>
  <para style="q1" vid="ISA 60:15">Mwen va fè ou <note caller="+" style="x"><char style="xo" closed="false">60:15 </char><char style="xt" closed="false"><ref loc="ISA 4:2">És 4:2</ref></char></note>vin plen ak majeste,</para>
  <para style="q1" vid="ISA 60:15">yon objè lajwa de jenerasyon an jenerasyon.<verse eid="ISA 60:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 60:16"/>Anplis, ou va souse lèt a nasyon yo,</para>
  <para style="q1" vid="ISA 60:16">e ou va souse tete a wa yo.</para>
  <para style="q1" vid="ISA 60:16">Konsa, ou va konnen ke Mwen, SENYÈ a,</para>
  <para style="q1" vid="ISA 60:16">se <note caller="+" style="x"><char style="xo" closed="false">60:16 </char><char style="xt" closed="false"><ref loc="ISA 19:20">És 19:20</ref></char></note>Sovè ou e Redanmtè ou,</para>
  <para style="q1" vid="ISA 60:16">Sila Ki Pwisan a Jacob la.<verse eid="ISA 60:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 60:17"/>Olye bwonz, Mwen va pote lò;</para>
  <para style="q1" vid="ISA 60:17">olye fè, Mwen va pote ajan;</para>
  <para style="q1" vid="ISA 60:17">olye bwa, Mwen va pote bwonz</para>
  <para style="q1" vid="ISA 60:17">e olye wòch, Mwen va pote fè.</para>
  <para style="q1" vid="ISA 60:17">Anplis, Mwen va fè lapè vin chèf ou</para>
  <para style="q1" vid="ISA 60:17">e ladwati kon konseye ou.<verse eid="ISA 60:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 60:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">60:18 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 54:14">És 54:14</ref>
      </char>
    </note>Vyolans p ap tande ankò nan peyi ou,</para>
  <para style="q1" vid="ISA 60:18">ni devastasyon oswa destriksyon anndan lizyè ou;</para>
  <para style="q1" vid="ISA 60:18">men ou va rele miray ou yo: “Sali” e pòtay ou yo: “Lwanj”.<verse eid="ISA 60:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 60:19"/>Ou p ap sèvi <note caller="+" style="x"><char style="xo" closed="false">60:19 </char><char style="xt" closed="false"><ref loc="REV 21:23">Rev 21:23</ref></char></note>solèy la pou limyè lajounen ankò,</para>
  <para style="q1" vid="ISA 60:19">ni klate lalin a nan pou ba ou limyè;</para>
  <para style="q1" vid="ISA 60:19">men ou va gen SENYÈ a kon yon limyè etènèl</para>
  <para style="q1" vid="ISA 60:19">e Bondye ou kon glwa ou.<verse eid="ISA 60:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 60:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">60:20 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 30:26">És 30:26</ref>
      </char>
    </note>Solèy ou p ap bese ankò,</para>
  <para style="q1" vid="ISA 60:20">ni lalin nan p ap febli;</para>
  <para style="q1" vid="ISA 60:20">paske ou va gen SENYÈ a kon limyè etènèl</para>
  <para style="q1" vid="ISA 60:20">e jou ke ou kriye ak gwo doulè yo va fini.<verse eid="ISA 60:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 60:21"/>Epi tout moun ou yo va dwat,</para>
  <para style="q1" vid="ISA 60:21">Yo va <note caller="+" style="x"><char style="xo" closed="false">60:21 </char><char style="xt" closed="false"><ref loc="PSA 37:11-22">Sòm 37:11-22</ref></char></note>posede peyi a jis pou tout tan;</para>
  <para style="q1" vid="ISA 60:21">branch ke M te plante a, zèv a men M yo,</para>
  <para style="q1" vid="ISA 60:21">pou M kapab resevwa glwa.<verse eid="ISA 60:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 60:22"/>Pi piti a va devni yon gran pèp</para>
  <para style="q1" vid="ISA 60:22">e pi piti menm nan, yon nasyon pwisan.</para>
  <para style="q1" vid="ISA 60:22">Mwen, SENYÈ a va fè l prese rive nan lè l.”<verse eid="ISA 60:22"/></para>
  <chapter eid="ISA 60"/>
  <chapter number="61" style="c" sid="ISA 61"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 61:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">61:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 11:5">Mat 11:5</ref>
      </char>
    </note>Lespri Senyè BONDYE a sou mwen,</para>
  <para style="q1" vid="ISA 61:1">akoz SENYÈ a te onksyone mwen pou pote bòn nouvèl a moun aflije yo.</para>
  <para style="q1" vid="ISA 61:1">Li te voye mwen pou bay soutyen a sila ak kè brize yo,</para>
  <para style="q1" vid="ISA 61:1">pou pwoklame libète a kaptif yo</para>
  <para style="q1" vid="ISA 61:1">e delivrans a prizonye yo;<verse eid="ISA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 61:2"/>pou <note caller="+" style="x"><char style="xo" closed="false">61:2 </char><char style="xt" closed="false"><ref loc="ISA 49:8">És 49:8</ref></char></note>pwoklame lane gras SENYÈ a</para>
  <para style="q1" vid="ISA 61:2">e jou a vanjans Bondye nou an;</para>
  <para style="q1" vid="ISA 61:2">pou konsole tout moun ak kè ki tris,<verse eid="ISA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 61:3"/>pou fè pwovizyon pou sila ak kè tris Sion yo;</para>
  <para style="q1" vid="ISA 61:3">pou bay yo yon bèl kouwòn pou ranplase sann yo,</para>
  <para style="q1" vid="ISA 61:3">ak <note caller="+" style="x"><char style="xo" closed="false">61:3 </char><char style="xt" closed="false"><ref loc="PSA 23:5">Sòm 23:5</ref></char></note>lwil kè kontan pou ranplase tristès la,</para>
  <para style="q1" vid="ISA 61:3">ak abiman lwanj pou ranplase lespri kraze a.</para>
  <para style="q1" vid="ISA 61:3">Konsa, yo va rele pye chenn ladwati,</para>
  <para style="q1" vid="ISA 61:3">yon plantasyon SENYÈ a,</para>
  <para style="q1" vid="ISA 61:3">pou Li kapab resevwa glwa.<verse eid="ISA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 61:4"/>Yo va <note caller="+" style="x"><char style="xo" closed="false">61:4 </char><char style="xt" closed="false"><ref loc="ISA 49:8">És 49:8</ref></char></note>rebati ansyen mazi yo,</para>
  <para style="q1" vid="ISA 61:4">yo va fè leve wo sa ki te kraze depi lontan yo.</para>
  <para style="q1" vid="ISA 61:4">Yo va repare vil ki te detwi yo,</para>
  <para style="q1" vid="ISA 61:4">dezolasyon de anpil jenerasyon yo.<verse eid="ISA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 61:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">61:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 14:2">És 14:2</ref>
      </char>
    </note>Etranje yo va kanpe pou okipe bann mouton nou yo,</para>
  <para style="q1" vid="ISA 61:5">e pitit a etranje yo va kiltivatè tè nou,</para>
  <para style="q1" vid="ISA 61:5">ak chan rezen nou yo.<verse eid="ISA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 61:6"/>Men nou va rele kon <note caller="+" style="x"><char style="xo" closed="false">61:6 </char><char style="xt" closed="false"><ref loc="ISA 66:21">És 66:21</ref></char></note>prèt SENYÈ a;</para>
  <para style="q1" vid="ISA 61:6">Lèzòm va rele nou sèvitè yo a Bondye nou an.</para>
  <para style="q1" vid="ISA 61:6">Nou va manje richès a nasyon yo,</para>
  <para style="q1" vid="ISA 61:6">e nan richès pa yo, nou va vante tèt nou.<verse eid="ISA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 61:7"/>Olye de wont nou, <note caller="+" style="x"><char style="xo" closed="false">61:7 </char><char style="xt" closed="false"><ref loc="ISA 40:2">És 40:2</ref></char></note>nou va gen yon pòsyon doub;</para>
  <para style="q1" vid="ISA 61:7">olye de imilyasyon, yo va rele ak lajwa sou pòsyon pa yo.</para>
  <para style="q1" vid="ISA 61:7">Akoz sa, yo va posede yon pòsyon doub nan peyi yo;</para>
  <para style="q1" vid="ISA 61:7">lajwa etènèl la va pou yo.<verse eid="ISA 61:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 61:8"/>Paske Mwen, SENYÈ a, <note caller="+" style="x"><char style="xo" closed="false">61:8 </char><char style="xt" closed="false"><ref loc="ISA 5:16">És 5:16</ref></char></note>renmen lajistis;</para>
  <para style="q1" vid="ISA 61:8">Mwen rayi vòl ak malfezans.</para>
  <para style="q1" vid="ISA 61:8">Ak fidelite Mwen va bay yo rekonpans yo,</para>
  <para style="q1" vid="ISA 61:8">e Mwen va fè yon akò k ap dire pou tout tan avèk yo.<verse eid="ISA 61:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 61:9"/>Desandan pa yo va rekonèt pami nasyon yo,</para>
  <para style="q1" vid="ISA 61:9">e posterite yo nan mitan a tout pèp yo.</para>
  <para style="q1" vid="ISA 61:9">Tout moun ki wè yo va rekonèt yo,</para>
  <para style="q1" vid="ISA 61:9">akoz yo se <note caller="+" style="x"><char style="xo" closed="false">61:9 </char><char style="xt" closed="false"><ref loc="ISA 44:3">És 44:3</ref></char></note>desandan ke SENYÈ a te beni yo.<verse eid="ISA 61:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 61:10"/>Mwen va rejwi anpil nan SENYÈ a;</para>
  <para style="q1" vid="ISA 61:10">nanm mwen va rejwi anpil nan Bondyè mwen an,</para>
  <para style="q1" vid="ISA 61:10">paske Li te abiye mwen ak vètman sali yo.</para>
  <para style="q1" vid="ISA 61:10">Li te vlope m nan yon manto ladwati,</para>
  <para style="q1" vid="ISA 61:10">tankou yon jennonm fenk marye dekore kò l ak yon kouwòn;</para>
  <para style="q1" vid="ISA 61:10">e tankou yon <note caller="+" style="x"><char style="xo" closed="false">61:10 </char><char style="xt" closed="false"><ref loc="REV 21:2">Rev 21:2</ref></char></note>jenn fi maryaj abiye kò l ak bijou.<verse eid="ISA 61:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 61:11"/>Paske jan tè a fè boujon li vin parèt la,</para>
  <para style="q1" vid="ISA 61:11">jaden an fè bagay ki simen ladann yo vin pete grandi,</para>
  <para style="q1" vid="ISA 61:11">konsa Senyè BONDYE a va fè <note caller="+" style="x"><char style="xo" closed="false">61:11 </char><char style="xt" closed="false"><ref loc="PSA 72:3">Sòm 72:3</ref></char></note>ladwati ak lwanj pete grandi devan tout nasyon yo.<verse eid="ISA 61:11"/></para>
  <chapter eid="ISA 61"/>
  <chapter number="62" style="c" sid="ISA 62"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 62:1"/>Pou koz Sion, Mwen p ap rete an silans</para>
  <para style="q1" vid="ISA 62:1">e pou koz Jérusalem, Mwen p ap rete san pawòl,</para>
  <para style="q1" vid="ISA 62:1">jiskaske <note caller="+" style="x"><char style="xo" closed="false">62:1 </char><char style="xt" closed="false"><ref loc="ISA 1:26">És 1:26</ref></char></note>ladwati li vin parèt tankou gran limyè</para>
  <para style="q1" vid="ISA 62:1">e sali li tankou yon tòch k ap brile.<verse eid="ISA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 62:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">62:2 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 60:3">És 60:3</ref>
      </char>
    </note>Nasyon yo va wè ladwati ou</para>
  <para style="q1" vid="ISA 62:2">e tout wa yo glwa ou.</para>
  <para style="q1" vid="ISA 62:2">Konsa, ou va rele pa yon non nouvo ke bouch SENYÈ a va bay.<verse eid="ISA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 62:3"/>Anplis, ou va yon <note caller="+" style="x"><char style="xo" closed="false">62:3 </char><char style="xt" closed="false"><ref loc="ISA 28:5">És 28:5</ref></char></note>kouwòn byen bèl nan men SENYÈ a ,</para>
  <para style="q1" vid="ISA 62:3">e yon dyadèm wayal nan men Bondye ou a.<verse eid="ISA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 62:4"/>Sa p ap di a ou menm ankò: “Abandone”,</para>
  <para style="q1" vid="ISA 62:4">ni a peyi ou, yo p ap di ankò: “Dezole”;</para>
  <para style="q1" vid="ISA 62:4">men ou va rele: “Plezi Mwen nan li”, epi peyi ou: <note caller="+" style="x"><char style="xo" closed="false">62:4 </char><char style="xt" closed="false"><ref loc="HOS 2:19-20">Os 2:19-20</ref></char></note>“Marye”.</para>
  <para style="q1" vid="ISA 62:4">Paske SENYÈ a pran plezi nan ou</para>
  <para style="q1" vid="ISA 62:4">e a Li menm, peyi ou va marye.<verse eid="ISA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 62:5"/>Paske menm jan ke yon jennonm marye ak yon vyèj,</para>
  <para style="q1" vid="ISA 62:5">konsa fis ou yo va marye avèk ou;</para>
  <para style="q1" vid="ISA 62:5">epi menm jan jennonm maryaj la</para>
  <para style="q1" vid="ISA 62:5">ap rejwi ak jenn fi maryaj la,</para>
  <para style="q1" vid="ISA 62:5">konsa <note caller="+" style="x"><char style="xo" closed="false">62:5 </char><char style="xt" closed="false"><ref loc="ISA 65:19">És 65:19</ref></char></note>Bondye ou a va rejwi ak ou.<verse eid="ISA 62:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 62:6"/>Sou miray ou yo, O Jérusalem,</para>
  <para style="q1" vid="ISA 62:6">Mwen te plase <note caller="+" style="x"><char style="xo" closed="false">62:6 </char><char style="xt" closed="false"><ref loc="ISA 52:8">És 52:8</ref></char></note>gadyen yo.</para>
  <para style="q1" vid="ISA 62:6">Tout lajounen ak tout lannwit,</para>
  <para style="q1" vid="ISA 62:6">yo p ap janm rete an silans.</para>
  <para style="q1" vid="ISA 62:6">Nou menm ki raple SENYÈ a,</para>
  <para style="q1" vid="ISA 62:6">pa pran repo pou tèt nou;<verse eid="ISA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 62:7"/>ni pa bay Li repo jiskaske Li etabli</para>
  <para style="q1" vid="ISA 62:7">e fè <note caller="+" style="x"><char style="xo" closed="false">62:7 </char><char style="xt" closed="false"><ref loc="ISA 60:18">És 60:18</ref></char></note>Jérusalem yon lwanj sou tout tè a.<verse eid="ISA 62:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 62:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">62:8 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 45:23">És 45:23</ref>
      </char>
    </note>SENYÈ a te sèmante pa men dwat Li</para>
  <para style="q1" vid="ISA 62:8">e pa men pwisan Li:</para>
  <para style="q1" vid="ISA 62:8">“Mwen p ap janm bay sereyal pa ou ankò</para>
  <para style="q1" vid="ISA 62:8">kon manje pou lènmi ou yo;</para>
  <para style="q1" vid="ISA 62:8">ni etranje yo p ap janm bwè diven nèf</para>
  <para style="q1" vid="ISA 62:8">pou sila ou te depanse fòs ou a.”<verse eid="ISA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 62:9"/>Men sila ki <note caller="+" style="x"><char style="xo" closed="false">62:9 </char><char style="xt" closed="false"><ref loc="ISA 65:13-23">És 65:13-23</ref></char></note>ranmase li,</para>
  <para style="q1" vid="ISA 62:9">se yo k ap manje li e louwe SENYÈ a.</para>
  <para style="q1" vid="ISA 62:9">Sila ki rekòlte li yo va bwè li nan lakou</para>
  <para style="q1" vid="ISA 62:9">sanktiyè pa Mwen an.<verse eid="ISA 62:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 62:10"/>Antre ladann, antre nan pòtay yo!</para>
  <para style="q1" vid="ISA 62:10">Netwaye chemen an pou pèp la!</para>
  <para style="q1" vid="ISA 62:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">62:10 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 57:14">És 57:14</ref>
      </char>
    </note>Bati, bati chemen an!</para>
  <para style="q1" vid="ISA 62:10">Retire wòch yo, leve yon drapo sou nasyon yo.<verse eid="ISA 62:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 62:11"/>Gade byen, SENYÈ a te pwoklame a pwent tè a:</para>
  <para style="q1" vid="ISA 62:11">“Di a fi Sion an: ‘Men <note caller="+" style="x"><char style="xo" closed="false">62:11 </char><char style="xt" closed="false"><ref loc="ISA 51:5">És 51:5</ref></char></note>sali ou a rive!</para>
  <para style="q1" vid="ISA 62:11">Gade byen rekonpans Li avè L e rekonpans Li devan L!’”<verse eid="ISA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 62:12"/>Konsa, yo va rele yo: <note caller="+" style="x"><char style="xo" closed="false">62:12 </char><char style="xt" closed="false"><ref loc="DEU 7:6">Det 7:6</ref></char></note>“Pèp sen an, rachte a SENYÈ yo”.</para>
  <para style="q1" vid="ISA 62:12">Ou va rele: “Sila Ki Chache e ki vin twouve a,</para>
  <para style="q1" vid="ISA 62:12">Yon Vil Ki Pa Abandone.”<verse eid="ISA 62:12"/></para>
  <chapter eid="ISA 62"/>
  <chapter number="63" style="c" sid="ISA 63"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 63:1"/>Se kilès sa ki sòti Edom an,</para>
  <para style="q1" vid="ISA 63:1">avèk vètman Botsra byen kolore a?</para>
  <para style="q1" vid="ISA 63:1">Kilès sila a, ak abiman majeste Li,</para>
  <para style="q1" vid="ISA 63:1">k ap mache nan grandè ak fòs li a?</para>
  <para style="q1" vid="ISA 63:1">“Se Mwen menm ki pale nan ladwati,</para>
  <para style="q1" vid="ISA 63:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">63:1 </char>
      <char style="xt" closed="false">
        <ref loc="ZEP 3:17">So 3:17</ref>
      </char>
    </note>ki pwisan pou delivre a.”<verse eid="ISA 63:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 63:2"/>Poukisa abiman Ou wouj</para>
  <para style="q1" vid="ISA 63:2">e vètman Ou tankou sila</para>
  <para style="q1" vid="ISA 63:2">k ap <note caller="+" style="x"><char style="xo" closed="false">63:2 </char><char style="xt" closed="false"><ref loc="REV 19:13-15">Rev 19:13-15</ref></char></note>mache nan kivèt diven an?<verse eid="ISA 63:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 63:3"/>“Mwen te foule nan kivèt diven an sèl,</para>
  <para style="q1" vid="ISA 63:3">Pami pèp yo, pa t gen moun avè M.</para>
  <para style="q1" vid="ISA 63:3">Anplis, Mwen te foule yo nan kòlè Mwen,</para>
  <para style="q1" vid="ISA 63:3">e Mwen te <note caller="+" style="x"><char style="xo" closed="false">63:3 </char><char style="xt" closed="false"><ref loc="MIC 7:10">Mi 7:10</ref></char></note>mache kraze yo nan kòlè Mwen an.</para>
  <para style="q1" vid="ISA 63:3">Gout san lavi yo te flite sou abiman Mwen</para>
  <para style="q1" vid="ISA 63:3">e Mwen te tache tout vètman Mwen yo.<verse eid="ISA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 63:4"/>Paske <note caller="+" style="x"><char style="xo" closed="false">63:4 </char><char style="xt" closed="false"><ref loc="ISA 34:8">És 34:8</ref></char></note>jou vanjans lan te nan kè M;</para>
  <para style="q1" vid="ISA 63:4">e ane racha a M yo rive.<verse eid="ISA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 63:5"/>Mwen te gade e pa t gen pèsòn pou ede;</para>
  <para style="q1" vid="ISA 63:5">Mwen te etone ke pa t gen pèsòn pou bay soutyen.</para>
  <para style="q1" vid="ISA 63:5">Akoz sa <note caller="+" style="x"><char style="xo" closed="false">63:5 </char><char style="xt" closed="false"><ref loc="PSA 44:3">Sòm 44:3</ref></char></note>pwòp bra M te pote Sali Mwen</para>
  <para style="q1" vid="ISA 63:5">e kòlè Mwen te fè M kanpe.<verse eid="ISA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 63:6"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">63:6 </char><char style="xt" closed="false"><ref loc="ISA 22:5">És 22:5</ref></char></note>te foule nasyon yo byen ba nan kòlè Mwen;</para>
  <para style="q1" vid="ISA 63:6">Mwen te fè yo sou nan kòlè Mwen.</para>
  <para style="q1" vid="ISA 63:6">Mwen te vide san lavi yo sou tè a.”<verse eid="ISA 63:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 63:7"/>Mwen va pale de <note caller="+" style="x"><char style="xo" closed="false">63:7 </char><char style="xt" closed="false"><ref loc="PSA 25:6">Sòm 25:6</ref></char></note>lanmou dous SENYÈ a,</para>
  <para style="q1" vid="ISA 63:7">ak lwanj SENYÈ a.</para>
  <para style="q1" vid="ISA 63:7">Apre tout sa ke SENYÈ a te bannou,</para>
  <para style="q1" vid="ISA 63:7">ak gran bonte anvè lakay Israël ke Li te bay yo,</para>
  <para style="q1" vid="ISA 63:7">selon labondans konpasyon li,</para>
  <para style="q1" vid="ISA 63:7">epi selon gran mizerikòd Li.<verse eid="ISA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 63:8"/>Paske Li te di: “Anverite, yo se pèp Mwen,</para>
  <para style="q1" vid="ISA 63:8">fis ki p ap aji nan manti.”</para>
  <para style="q1" vid="ISA 63:8">Pou sa, Li te devni <note caller="+" style="x"><char style="xo" closed="false">63:8 </char><char style="xt" closed="false"><ref loc="ISA 60:16">És 60:16</ref></char></note>Sovè yo.<verse eid="ISA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 63:9"/>Nan tout afliksyon yo, <note caller="+" style="x"><char style="xo" closed="false">63:9 </char><char style="xt" closed="false"><ref loc="JDG 10:16">Jij 10:16</ref></char></note>Li te aflije</para>
  <para style="q1" vid="ISA 63:9">e zanj a prezans Li an te sove yo.</para>
  <para style="q1" vid="ISA 63:9">Nan lanmou dous Li a ak mizerikòd Li,</para>
  <para style="q1" vid="ISA 63:9">Li te rachte yo.</para>
  <para style="q1" vid="ISA 63:9">Li te leve yo, e te pote yo</para>
  <para style="q1" vid="ISA 63:9">pandan tout ansyen jou yo.<verse eid="ISA 63:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 63:10"/>Men yo te fè rebèl</para>
  <para style="q1" vid="ISA 63:10">e konsa, yo te fè <note caller="+" style="x"><char style="xo" closed="false">63:10 </char><char style="xt" closed="false"><ref loc="PSA 51:11">Sòm 51:11</ref></char></note>Lespri Sen Li an vin tris.</para>
  <para style="q1" vid="ISA 63:10">Akoz sa, Li te vire Li menm, e Li te devni lènmi yo;</para>
  <para style="q1" vid="ISA 63:10">Li te goumen kont yo pou kont Li.<verse eid="ISA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 63:11"/>Men konsa, Li a te vin sonje ansyen jou yo</para>
  <para style="q1" vid="ISA 63:11">ak Moïse e pèp Li.</para>
  <para style="q1" vid="ISA 63:11">Li te di “Kote Li, Sila ki te fè yo monte sòti nan lanmè</para>
  <para style="q1" vid="ISA 63:11">ak bèje a bann mouton Li yo?</para>
  <para style="q1" vid="ISA 63:11">Kote Li, Sila ki te <note caller="+" style="x"><char style="xo" closed="false">63:11 </char><char style="xt" closed="false"><ref loc="NUM 11:17-29">Nonb 11:17-29</ref></char></note>mete Lespri Sen Li nan mitan yo a?”<verse eid="ISA 63:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 63:12"/>Ki te fè men glwa Li a ale akote men dwat Moïse la?</para>
  <para style="q1" vid="ISA 63:12">Ki te <note caller="+" style="x"><char style="xo" closed="false">63:12 </char><char style="xt" closed="false"><ref loc="EXO 14:21-22">Egz 14:21-22</ref></char></note>divize dlo yo devan yo</para>
  <para style="q1" vid="ISA 63:12">pou fè pou pwòp tèt Li</para>
  <para style="q1" vid="ISA 63:12">yon non ki ta dire pou tout tan?<verse eid="ISA 63:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 63:13"/>Ki te mennen yo atravè fon yo</para>
  <para style="q1" vid="ISA 63:13">tankou cheval nan dezè a,</para>
  <para style="q1" vid="ISA 63:13">pou yo pa <note caller="+" style="x"><char style="xo" closed="false">63:13 </char><char style="xt" closed="false"><ref loc="JER 31:9">Jr 31:9</ref></char></note>chape tonbe?<verse eid="ISA 63:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 63:14"/>Tankou bèt ki te desann nan vale yo,</para>
  <para style="q1" vid="ISA 63:14">Lespri SENYÈ a te bay yo repo.</para>
  <para style="q1" vid="ISA 63:14">Konsa, Ou te <note caller="+" style="x"><char style="xo" closed="false">63:14 </char><char style="xt" closed="false"><ref loc="DEU 32:12">Det 32:12</ref></char></note>mennen pèp Ou a</para>
  <para style="q1" vid="ISA 63:14">pou fè pou Ou yon non ki plen laglwa.<verse eid="ISA 63:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 63:15"/>Gade anba depi nan syèl la</para>
  <para style="q1" vid="ISA 63:15">e wè soti nan abitasyon sen Ou</para>
  <para style="q1" vid="ISA 63:15">ki plen ak glwa Ou.</para>
  <para style="q1" vid="ISA 63:15">Kote zèl Ou ak zèv pwisan Ou yo?</para>
  <para style="q1" vid="ISA 63:15">Santiman a kè ou ak konpasyon Ou</para>
  <para style="q1" vid="ISA 63:15">te vin anpeche de mwen.<verse eid="ISA 63:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 63:16"/>Paske Ou se <note caller="+" style="x"><char style="xo" closed="false">63:16 </char><char style="xt" closed="false"><ref loc="ISA 1:2">És 1:2</ref></char></note>Papa nou,</para>
  <para style="q1" vid="ISA 63:16">malgre Abraham pa rekonèt nou,</para>
  <para style="q1" vid="ISA 63:16">ni Israël pa rekonèt nou.</para>
  <para style="q1" vid="ISA 63:16">Ou menm, O SENYÈ, Ou se Papa nou,</para>
  <para style="q1" vid="ISA 63:16">Redanmtè nou soti nan tan ansyen yo se non Ou.<verse eid="ISA 63:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 63:17"/>Poukisa, O SENYÈ, Ou <note caller="+" style="x"><char style="xo" closed="false">63:17 </char><char style="xt" closed="false"><ref loc="ISA 30:28">És 30:28</ref></char></note>fè nou egare kite chemen Ou yo?</para>
  <para style="q1" vid="ISA 63:17">E te fè kè nou di pou nou pa gen lakrent Ou?</para>
  <para style="q1" vid="ISA 63:17">Pou koz sèvitè Ou yo, tribi a eritaj Ou yo, retounen.<verse eid="ISA 63:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 63:18"/>Pèp sen Ou yo te posede sanktyè Ou a pou yon ti tan;</para>
  <para style="q1" vid="ISA 63:18">advèsè nou yo te <note caller="+" style="x"><char style="xo" closed="false">63:18 </char><char style="xt" closed="false"><ref loc="PSA 74:3-7">Sòm 74:3-7</ref></char></note>foule li ba nèt.<verse eid="ISA 63:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 63:19"/>Nou te vin sanble ak sila ke Ou pa t janm gouvène yo,</para>
  <para style="q1" vid="ISA 63:19">tankou sila ki pa t rele pa non Ou yo.<verse eid="ISA 63:19"/></para>
  <chapter eid="ISA 63"/>
  <chapter number="64" style="c" sid="ISA 64"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 64:1"/>O ke Ou ta chire syèl yo,</para>
  <para style="q1" vid="ISA 64:1">ke Ou ta desann,</para>
  <para style="q1" vid="ISA 64:1">ke mòn yo ta <note caller="+" style="x"><char style="xo" closed="false">64:1 </char><char style="xt" closed="false"><ref loc="JDG 5:5">Jij 5:5</ref></char></note>tranble devan prezans Ou—<verse eid="ISA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 64:2"/>tankou dife anflame touf bwa chan an,</para>
  <para style="q1" vid="ISA 64:2">tankou dife fè dlo bouyi.</para>
  <para style="q1" vid="ISA 64:2">Fè non Ou rekonèt a advèsè Ou yo,</para>
  <para style="q1" vid="ISA 64:2">pou <note caller="+" style="x"><char style="xo" closed="false">64:2 </char><char style="xt" closed="false"><ref loc="PSA 99:1">Sòm 99:1</ref></char></note>nasyon yo ka tranble devan prezans Ou!<verse eid="ISA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 64:3"/>Kon lè Ou te fè <note caller="+" style="x"><char style="xo" closed="false">64:3 </char><char style="xt" closed="false"><ref loc="PSA 65:5">Sòm 65:5</ref></char></note> bagay mèvèy ke nou pa t prevwa yo;</para>
  <para style="q1" vid="ISA 64:3">Ou te desann.</para>
  <para style="q1" vid="ISA 64:3">Mòn yo te tranble devan prezans Ou.<verse eid="ISA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 64:4"/>Depi nan jou ansyen yo, <note caller="+" style="x"><char style="xo" closed="false">64:4 </char><char style="xt" closed="false"><ref loc="1CO 2:9">I Kor 2:9</ref></char></note>yo pa t tande ni sezi ak zorèy,</para>
  <para style="q1" vid="ISA 64:4">ni zye pa t wè yon Bondye sof ke Ou,</para>
  <para style="q1" vid="ISA 64:4">k ap aji pou sila k ap tann Li an.<verse eid="ISA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 64:5"/>Ou rankontre avèk sila ki rejwi a nan fè sa ki dwat,</para>
  <para style="q1" vid="ISA 64:5">ki sonje Ou nan chemen pa Ou yo.</para>
  <para style="q1" vid="ISA 64:5">Gade byen, <note caller="+" style="x"><char style="xo" closed="false">64:5 </char><char style="xt" closed="false"><ref loc="ISA 12:1">És 12:1</ref></char></note>Ou te fache paske nou te peche,</para>
  <para style="q1" vid="ISA 64:5">nou te kontinye nan peche pandan anpil tan.</para>
  <para style="q1" vid="ISA 64:5">Èske nou va sove?<verse eid="ISA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 64:6"/>Paske nou tout te vini tankou yon moun ki pa pwòp.</para>
  <para style="q1" vid="ISA 64:6">Tout <note caller="+" style="x"><char style="xo" closed="false">64:6 </char><char style="xt" closed="false"><ref loc="ISA 46:12">És 46:12</ref></char></note>zèv ladwati nou yo tankou yon rad ki sal nèt;</para>
  <para style="q1" vid="ISA 64:6">konsa, nou tout vin fennen kon yon fèy,</para>
  <para style="q1" vid="ISA 64:6">e inikite nou yo tankou van, pote nou ale.<verse eid="ISA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 64:7"/>Nanpwen moun ki rele non Ou,</para>
  <para style="q1" vid="ISA 64:7">ki leve pou atache a Ou menm;</para>
  <para style="q1" vid="ISA 64:7">paske Ou te <note caller="+" style="x"><char style="xo" closed="false">64:7 </char><char style="xt" closed="false"><ref loc="DEU 31:18">Det 31:18</ref></char></note>kache figi Ou a nou menm</para>
  <para style="q1" vid="ISA 64:7">e te livre nou nan pouvwa inikite nou yo.<verse eid="ISA 64:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 64:8"/>Pou sa, O SENYÈ, Ou se Papa nou,</para>
  <para style="q1" vid="ISA 64:8">nou se ajil la e se Ou ki met kanari a;</para>
  <para style="q1" vid="ISA 64:8">nou tout se <note caller="+" style="x"><char style="xo" closed="false">64:8 </char><char style="xt" closed="false"><ref loc="PSA 100:3">Sòm 100:3</ref></char></note>zèv men Ou yo.<verse eid="ISA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 64:9"/>Pa vin fache depase, O SENYÈ,</para>
  <para style="q1" vid="ISA 64:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">64:9 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 43:25">És 43:25</ref>
      </char>
    </note>ni sonje inikite nou yo pou tout tan.</para>
  <para style="q1" vid="ISA 64:9">Gade byen, gade koulye a, nou tout se pèp Ou a.<verse eid="ISA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 64:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">64:10 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 48:2">És 48:2</ref>
      </char>
    </note>Vil sen Ou yo te vin yon dezè;</para>
  <para style="q1" vid="ISA 64:10">Sion te vin yon dezè,</para>
  <para style="q1" vid="ISA 64:10">Jérusalem yon kote dezole.<verse eid="ISA 64:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 64:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">64:11 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 25:9">II Wa 25:9</ref>
      </char>
    </note>Bèl kay sen nou an,</para>
  <para style="q1" vid="ISA 64:11">kote papa nou yo te ba Ou lwanj yo,</para>
  <para style="q1" vid="ISA 64:11">te brile ak dife;</para>
  <para style="q1" vid="ISA 64:11">epi tout bagay ki te chè a nou menm te vin kraze nèt.<verse eid="ISA 64:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 64:12"/>Èske Ou va <note caller="+" style="x"><char style="xo" closed="false">64:12 </char><char style="xt" closed="false"><ref loc="PSA 74:10">Sòm 74:10</ref></char></note>ralanti Ou menm, devan bagay sa yo, O SENYÈ?</para>
  <para style="q1" vid="ISA 64:12">Èske Ou va rete an silans e bannou lapèn ki depase mezi a?<verse eid="ISA 64:12"/></para>
  <chapter eid="ISA 64"/>
  <chapter number="65" style="c" sid="ISA 65"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 65:1"/>“Mwen te chache pa <note caller="+" style="x"><char style="xo" closed="false">65:1 </char><char style="xt" closed="false"><ref loc="ROM 9:24-26">Wo 9:24-26</ref></char></note>sila</para>
  <para style="q1" vid="ISA 65:1">ki pa t mande pou Mwen yo;</para>
  <para style="q1" vid="ISA 65:1">Mwen te twouve pa sila</para>
  <para style="q1" vid="ISA 65:1">ki pa t chache M.</para>
  <para style="q1" vid="ISA 65:1">Mwen te di: “Men Mwen isit la! Men Mwen isit la!’</para>
  <para style="q1" vid="ISA 65:1">a yon nasyon ki pa t rele non Mwen.<verse eid="ISA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 65:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">65:2 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 10:21">Wo 10:21</ref>
      </char>
    </note>Mwen te louvri men M tout lajounen a yon pèp rebèl,</para>
  <para style="q1" vid="ISA 65:2">ki mache nan chemen ki pa bon,</para>
  <para style="q1" vid="ISA 65:2">k ap swiv pwòp panse pa yo,<verse eid="ISA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 65:3"/>Yon pèp ki <note caller="+" style="x"><char style="xo" closed="false">65:3 </char><char style="xt" closed="false"><ref loc="JOB 1:11">Job 1:11</ref></char></note>pwovoke M tout tan nan figi M,</para>
  <para style="q1" vid="ISA 65:3">k ap ofri sakrifis nan jaden yo</para>
  <para style="q1" vid="ISA 65:3">e k ap brile lansan sou brik yo;<verse eid="ISA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 65:4"/>ki chita nan mitan tonm yo</para>
  <para style="q1" vid="ISA 65:4">e ki pase nwit lan kote kache yo;</para>
  <para style="q1" vid="ISA 65:4">ki <note caller="+" style="x"><char style="xo" closed="false">65:4 </char><char style="xt" closed="false"><ref loc="LEV 11:7">Lev 11:7</ref></char></note>manje chè kochon,</para>
  <para style="q1" vid="ISA 65:4">ak soup fèt ak sa ki pa pwòp.<verse eid="ISA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 65:5"/>Ki di: <note caller="+" style="x"><char style="xo" closed="false">65:5 </char><char style="xt" closed="false"><ref loc="MAT 9:11">Mat 9:11</ref></char></note>‘Rete la, ou menm, pa pwoche mwen;</para>
  <para style="q1" vid="ISA 65:5">mwen pi sen pase ou’!</para>
  <para style="q1" vid="ISA 65:5">Sila yo se lafimen nan nen Mwen,</para>
  <para style="q1" vid="ISA 65:5">yon dife ki brile tout lajounen.<verse eid="ISA 65:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 65:6"/>“Gade byen, li ekri devan Mwen:</para>
  <para style="q1" vid="ISA 65:6">Mwen p ap rete an silans,</para>
  <para style="q1" vid="ISA 65:6">men <note caller="+" style="x"><char style="xo" closed="false">65:6 </char><char style="xt" closed="false"><ref loc="JER 16:18">Jr 16:18</ref></char></note>Mwen va bay rekonpans;</para>
  <para style="q1" vid="ISA 65:6">Mwen va rekonpanse jis rive nan lestonmak yo,<verse eid="ISA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 65:7"/>ni pou pwòp inikite pa yo</para>
  <para style="q1" vid="ISA 65:7">ak inikite a zansèt yo ansanm”, pale SENYÈ a.</para>
  <para style="q1" vid="ISA 65:7">“Akoz yo te brile lansan sou mòn yo</para>
  <para style="q1" vid="ISA 65:7">e te moke M sou kolin yo;</para>
  <para style="q1" vid="ISA 65:7">pou sa, Mwen va <note caller="+" style="x"><char style="xo" closed="false">65:7 </char><char style="xt" closed="false"><ref loc="JER 5:29">Jr 5:29</ref></char></note>mezire zèv yo te fè,</para>
  <para style="q1" vid="ISA 65:7">jis rive nan lestonmak yo.”<verse eid="ISA 65:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 65:8"/>Konsa pale SENYÈ a;</para>
  <para style="q1" vid="ISA 65:8">“Menm jan divin tounèf twouve nan yon grap rezen,</para>
  <para style="q1" vid="ISA 65:8">e yon moun di, ‘pa detwi l, paske gen benefis ladann’:</para>
  <para style="q1" vid="ISA 65:8">konsa Mwen va aji pou sèvitè ki pou Mwen yo,</para>
  <para style="q1" vid="ISA 65:8">pou M <note caller="+" style="x"><char style="xo" closed="false">65:8 </char><char style="xt" closed="false"><ref loc="ISA 1:9">És 1:9</ref></char></note>pa detwi yo tout.<verse eid="ISA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 65:9"/>Mwen va mennen fè sòti zanfan Jacob yo</para>
  <para style="q1" vid="ISA 65:9">e yon eritye mòn Mwen yo kap soti nan Juda.</para>
  <para style="q1" vid="ISA 65:9">Menm <note caller="+" style="x"><char style="xo" closed="false">65:9 </char><char style="xt" closed="false"><ref loc="ISA 57:13">És 57:13</ref></char></note>chwazi pa M yo va eritye l</para>
  <para style="q1" vid="ISA 65:9">e sèvitè Mwen yo va demere la.<verse eid="ISA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 65:10"/>Saron va yon peyi ki fè patiraj</para>
  <para style="q1" vid="ISA 65:10">pou bann mouton yo,</para>
  <para style="q1" vid="ISA 65:10">e vale Acor yon kote pou twoupo yo ka repoze,</para>
  <para style="q1" vid="ISA 65:10">pou pèp Mwen ki <note caller="+" style="x"><char style="xo" closed="false">65:10 </char><char style="xt" closed="false"><ref loc="ISA 51:1">És 51:1</ref></char></note>chache Mwen an.<verse eid="ISA 65:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 65:11"/>“Men nou menm ki <note caller="+" style="x"><char style="xo" closed="false">65:11 </char><char style="xt" closed="false"><ref loc="DEU 29:24-25">Det 29:24-25</ref></char></note>abandone SENYÈ a,</para>
  <para style="q1" vid="ISA 65:11">ki bliye mòn sen Mwen an,</para>
  <para style="q1" vid="ISA 65:11">ki ranje yon tab pou Gran Chans,</para>
  <para style="q1" vid="ISA 65:11">ki plen tas ak diven mele pou Desten an;<verse eid="ISA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 65:12"/>Mwen va ranje desten nou ak nepe,</para>
  <para style="q1" vid="ISA 65:12">e nou tout va bese devan masak la.</para>
  <para style="q1" vid="ISA 65:12">Akoz Mwen te rele nou, men nou <note caller="+" style="x"><char style="xo" closed="false">65:12 </char><char style="xt" closed="false"><ref loc="2CH 36:15-16">II Kwo 36:15-16</ref></char></note>pa t reponn;</para>
  <para style="q1" vid="ISA 65:12">Mwen te pale, men nou pa t tande.</para>
  <para style="q1" vid="ISA 65:12">Epi nou te fè mal devan zye M,</para>
  <para style="q1" vid="ISA 65:12">e te chwazi sa ki pa t fè m plezi.”<verse eid="ISA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 65:13"/>Pou sa, konsa pale Senyè BONDYE a:</para>
  <para style="q1" vid="ISA 65:13">“Gade byen, sèvitè Mwen yo va <note caller="+" style="x"><char style="xo" closed="false">65:13 </char><char style="xt" closed="false"><ref loc="ISA 1:19">És 1:19</ref></char></note>manje,</para>
  <para style="q1" vid="ISA 65:13">men nou va rete grangou.</para>
  <para style="q1" vid="ISA 65:13">Gade byen, sèvitè Mwen yo va bwè,</para>
  <para style="q1" vid="ISA 65:13">men nou va rete swaf.</para>
  <para style="q1" vid="ISA 65:13">Gade byen, sèvitè Mwen yo va rejwi,</para>
  <para style="q1" vid="ISA 65:13">men nou va twouve gwo wont.<verse eid="ISA 65:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 65:14"/>Gade byen, sèvitè Mwen yo va rele ak jwa ak kè kontan,</para>
  <para style="q1" vid="ISA 65:14">men nou va <note caller="+" style="x"><char style="xo" closed="false">65:14 </char><char style="xt" closed="false"><ref loc="ISA 13:6">És 13:6</ref></char></note>kriye fò ak yon kè plen doulè,</para>
  <para style="q1" vid="ISA 65:14">e nou va rele anmwey ak yon lespri ki kraze nèt.<verse eid="ISA 65:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 65:15"/>Ou va kite non nou kon yon malediksyon</para>
  <para style="q1" vid="ISA 65:15">a moun chwazi pa Mwen yo,</para>
  <para style="q1" vid="ISA 65:15">e Senyè BONDYE a va touye nou.</para>
  <para style="q1" vid="ISA 65:15">Li va rele sèvitè Li yo pa yon <note caller="+" style="x"><char style="xo" closed="false">65:15 </char><char style="xt" closed="false"><ref loc="ISA 62:2">És 62:2</ref></char></note>lòt non.<verse eid="ISA 65:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 65:16"/>Paske sila ki beni sou tè a,</para>
  <para style="q1" vid="ISA 65:16">va beni pa <note caller="+" style="x"><char style="xo" closed="false">65:16 </char><char style="xt" closed="false"><ref loc="EXO 34:6">Egz 34:6</ref></char></note>Bondye verite a;</para>
  <para style="q1" vid="ISA 65:16">epi sila ki sèmante nan tout tè a,</para>
  <para style="q1" vid="ISA 65:16">va sèmante pa Bondye verite a;</para>
  <para style="q1" vid="ISA 65:16">paske ansyen twoub yo fin bliye</para>
  <para style="q1" vid="ISA 65:16">e paske yo kache devan zye M.”<verse eid="ISA 65:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 65:17"/>Paske gade byen,</para>
  <para style="q1" vid="ISA 65:17">Mwen va kreye yon <note caller="+" style="x"><char style="xo" closed="false">65:17 </char><char style="xt" closed="false"><ref loc="ISA 66:22">És 66:22</ref></char></note>syèl tounèf,</para>
  <para style="q1" vid="ISA 65:17">ak yon tè tounèf;</para>
  <para style="q1" vid="ISA 65:17">epi ansyen bagay yo p ap sonje ankò,</para>
  <para style="q1" vid="ISA 65:17">ni p ap menm antre nan panse.<verse eid="ISA 65:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 65:18"/>Men <note caller="+" style="x"><char style="xo" closed="false">65:18 </char><char style="xt" closed="false"><ref loc="PSA 98">Sòm 98</ref></char></note>fè kè kontan e rejwi nou</para>
  <para style="q1" vid="ISA 65:18">jis pou tout tan nan sa ke M kreye yo;</para>
  <para style="q1" vid="ISA 65:18">paske gade byen, Mwen kreye Jérusalem pou rejwisans,</para>
  <para style="q1" vid="ISA 65:18">e pèp li a pou kè kontan.<verse eid="ISA 65:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 65:19"/>Anplis, Mwen va <note caller="+" style="x"><char style="xo" closed="false">65:19 </char><char style="xt" closed="false"><ref loc="ISA 62:4-5">És 62:4-5</ref></char></note>rejwi de Jérusalem.</para>
  <para style="q1" vid="ISA 65:19">Mwen va fè kè kontan nan pèp Mwen an.</para>
  <para style="q1" vid="ISA 65:19">Epi p ap tande ankò nan li</para>
  <para style="q1" vid="ISA 65:19">vwa kriye ak son moun k ap kriye.<verse eid="ISA 65:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 65:20"/>“P ap genyen ladann ankò timoun ki viv sèlman kèk jou,</para>
  <para style="q1" vid="ISA 65:20">ni granmoun ki pa fin fè tout jou li yo;</para>
  <para style="q1" vid="ISA 65:20">paske jenn yo va mouri nan laj santan</para>
  <para style="q1" vid="ISA 65:20">e sila ki pa rive nan laj santan yo va konsidere kon moun modi.<verse eid="ISA 65:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 65:21"/>Yo va <note caller="+" style="x"><char style="xo" closed="false">65:21 </char><char style="xt" closed="false"><ref loc="ISA 32:18">És 32:18</ref></char></note>bati kay yo pou yo viv ladann;</para>
  <para style="q1" vid="ISA 65:21">anplis, yo va plante chan rezen yo e manje fwi yo.<verse eid="ISA 65:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 65:22"/>Yo p ap bati kay pou yon lòt moun rete ladann,</para>
  <para style="q1" vid="ISA 65:22">yo p ap plante pou yon lòt moun vin manje.</para>
  <para style="q1" vid="ISA 65:22">Paske <note caller="+" style="x"><char style="xo" closed="false">65:22 </char><char style="xt" closed="false"><ref loc="PSA 92:12-14">Sòm 92:12-14</ref></char></note>kon lavi a yon pyebwa, se konsa</para>
  <para style="q1" vid="ISA 65:22">jou a pèp Mwen an va ye,</para>
  <para style="q1" vid="ISA 65:22">e moun chwazi pa M yo va gen tan</para>
  <para style="q1" vid="ISA 65:22">rejwi nan pwòp zèv men yo.<verse eid="ISA 65:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 65:23"/>Yo <note caller="+" style="x"><char style="xo" closed="false">65:23 </char><char style="xt" closed="false"><ref loc="DEU 28:3-12">Det 28:3-12</ref></char></note>p ap travay an ven, ni fè pitit pou mizè;</para>
  <para style="q1" vid="ISA 65:23">paske yo se desandan a sila ki beni pa SENYÈ a,</para>
  <para style="q1" vid="ISA 65:23">e anplis, desandan yo, menm jan.<verse eid="ISA 65:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 65:24"/>Anplis, li va vin rive ke avan yo rele, Mwen va reponn;</para>
  <para style="q1" vid="ISA 65:24">epi pandan yo toujou ap pale, Mwen va <note caller="+" style="x"><char style="xo" closed="false">65:24 </char><char style="xt" closed="false"><ref loc="PSA 91:15">Sòm 91:15</ref></char></note>tande.<verse eid="ISA 65:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 65:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">65:25 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 11:6">És 11:6</ref>
      </char>
    </note>Lou ak ti mouton va manje ansanm.</para>
  <para style="q1" vid="ISA 65:25">Lyon an va manje pay kon bèf.</para>
  <para style="q1" vid="ISA 65:25">Men pousyè va sèvi kon manje pou sèpan an.</para>
  <para style="q1" vid="ISA 65:25">Yo p ap fè mal ni donmaj nan tout mòn sen Mwen an,”</para>
  <para style="q1" vid="ISA 65:25">di SENYÈ a.<verse eid="ISA 65:25"/></para>
  <chapter eid="ISA 65"/>
  <chapter number="66" style="c" sid="ISA 66"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1"/>Konsa pale SENYÈ a:</para>
  <para style="q1" vid="ISA 66:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">66:1 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 8:27">I Wa 8:27</ref>
      </char>
    </note>“Syèl la se twòn Mwen e tè a se machpye M.</para>
  <para style="q1" vid="ISA 66:1">Alò, ki kote ou ta kab bati yon kay pou Mwen?</para>
  <para style="q1" vid="ISA 66:1">Epi ki kote pou M ta ka repoze?<verse eid="ISA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 66:2"/>Paske se <note caller="+" style="x"><char style="xo" closed="false">66:2 </char><char style="xt" closed="false"><ref loc="ISA 40:26">És 40:26</ref></char></note>men M ki te fè tout bagay sa yo;</para>
  <para style="q1" vid="ISA 66:2">se konsa tout bagay sa yo te vin egziste,” deklare SENYÈ a.</para>
  <para style="q1" vid="ISA 66:2">“Men, anvè sila Mwen va gade;</para>
  <para style="q1" vid="ISA 66:2">sila ki enb ak kè ki repanti a,</para>
  <para style="q1" vid="ISA 66:2">e ki tranble devan pawòl Mwen yo.<verse eid="ISA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 66:3"/>Men sila ki touye yon bèf la,</para>
  <para style="q1" vid="ISA 66:3">li tankou sila ki touye yon moun nan;</para>
  <para style="q1" vid="ISA 66:3">sila ki fè sakrifis a yon jenn mouton an,</para>
  <para style="q1" vid="ISA 66:3">li tankou yon moun ki kase kou a yon chen;</para>
  <para style="q1" vid="ISA 66:3">sila ki fè ofrann sereyal la, li tankou sila ki ofri san kochon an;</para>
  <para style="q1" vid="ISA 66:3">sila ki brile lansan an, li tankou sila ki fè beni yon zidòl la.</para>
  <para style="q1" vid="ISA 66:3">Konsi yo te chwazi pwòp chemen pa yo,</para>
  <para style="q1" vid="ISA 66:3">e nanm yo pran gwo plezi nan abominasyon yo.<verse eid="ISA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 66:4"/>Konsa, Mwen va deziye pinisyon yo,</para>
  <para style="q1" vid="ISA 66:4">e Mwen va mennen sou yo sa ke yo plis pè a.</para>
  <para style="q1" vid="ISA 66:4">Paske Mwen te rele, men pèsòn pa t reponn;</para>
  <para style="q1" vid="ISA 66:4">Mwen te pale, men yo pa t koute,</para>
  <para style="q1" vid="ISA 66:4">men se <note caller="+" style="x"><char style="xo" closed="false">66:4 </char><char style="xt" closed="false"><ref loc="2KI 21:2-6">II Wa 21:2-6</ref></char></note>mal yo te fè devan zye M,</para>
  <para style="q1" vid="ISA 66:4">e yo te chwazi sa ki pa t fè M plezi.”<verse eid="ISA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 66:5"/>Tande pawòl SENYÈ a,</para>
  <para style="q1" vid="ISA 66:5">nou menm ki tranble devan pawòl Li yo:</para>
  <para style="q1" vid="ISA 66:5">“Frè nou ki rayi nou yo, ki <note caller="+" style="x"><char style="xo" closed="false">66:5 </char><char style="xt" closed="false"><ref loc="MAT 5:10-12">Mat 5:10-12</ref></char></note>rejte nou akoz non Mwen,</para>
  <para style="q1" vid="ISA 66:5">Yo te di:</para>
  <para style="q1" vid="ISA 66:5">‘Kite SENYÈ a resevwa glwa,</para>
  <para style="q1" vid="ISA 66:5">pou nou ka wè nou fè kè kontan.’</para>
  <para style="q1" vid="ISA 66:5">Men sila yo k ap wont.<verse eid="ISA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 66:6"/>Yon vwa gwo boulvèsman soti nan vil la,</para>
  <para style="q1" vid="ISA 66:6">yon vwa soti nan tanp lan;</para>
  <para style="q1" vid="ISA 66:6">vwa a SENYÈ la k ap <note caller="+" style="x"><char style="xo" closed="false">66:6 </char><char style="xt" closed="false"><ref loc="ISA 59:18">És 59:18</ref></char></note>rann rekonpans a lènmi Li yo.<verse eid="ISA 66:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 66:7"/>“Avan fi a gen doulè, li te anfante;</para>
  <para style="q1" vid="ISA 66:7">avan gwo doulè a te rive li, <note caller="+" style="x"><char style="xo" closed="false">66:7 </char><char style="xt" closed="false"><ref loc="REV 12:5">Rev 12:5</ref></char></note>li te fè yon gason.<verse eid="ISA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 66:8"/>Se <note caller="+" style="x"><char style="xo" closed="false">66:8 </char><char style="xt" closed="false"><ref loc="ISA 64:4">És 64:4</ref></char></note>kilès ki te tande yon koze konsa a?</para>
  <para style="q1" vid="ISA 66:8">Kilès ki te wè yon bagay konsa?</para>
  <para style="q1" vid="ISA 66:8">Èske yon peyi kapab fèt nan yon sèl jou?</para>
  <para style="q1" vid="ISA 66:8">Èske yon nasyon ka vin parèt nan yon enstan?</para>
  <para style="q1" vid="ISA 66:8">La menm Sion te vin gen doulè,</para>
  <para style="q1" vid="ISA 66:8">li te fè fis li yo vin parèt.<verse eid="ISA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 66:9"/>Èske Mwen va rive pre pwen akouchman an,</para>
  <para style="q1" vid="ISA 66:9">pou mwen <note caller="+" style="x"><char style="xo" closed="false">66:9 </char><char style="xt" closed="false"><ref loc="ISA 37:3">És 37:3</ref></char></note>pa livre pitit la?” pale SENYÈ a.</para>
  <para style="q1" vid="ISA 66:9">“Oswa èske Mwen ki fè fanm akouche a,</para>
  <para style="q1" vid="ISA 66:9">ta fèmen vant lan?” pale Bondye nou an.<verse eid="ISA 66:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 66:10"/>“Fè <note caller="+" style="x"><char style="xo" closed="false">66:10 </char><char style="xt" closed="false"><ref loc="DEU 32:43">Det 32:43</ref></char></note>kè kontan ak Jérusalem,</para>
  <para style="q1" vid="ISA 66:10">e rejwi de li, nou tout ki renmen li yo.</para>
  <para style="q1" vid="ISA 66:10">Fè kè kontan anpil, nou tout ki te fè kè tris pou li yo,<verse eid="ISA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 66:11"/>pou nou kapab souse e <note caller="+" style="x"><char style="xo" closed="false">66:11 </char><char style="xt" closed="false"><ref loc="ISA 49:23">És 49:23</ref></char></note>jwenn satisfaksyon nan tete li,</para>
  <para style="q1" vid="ISA 66:11">pou nou kapab souse pou jwenn plezi nan gwo lestonmak li a.”<verse eid="ISA 66:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 66:12"/>Paske konsa pale SENYÈ a:</para>
  <para style="q1" vid="ISA 66:12">“Gade byen, Mwen lonje bay fi a <note caller="+" style="x"><char style="xo" closed="false">66:12 </char><char style="xt" closed="false"><ref loc="PSA 72:3-7">Sòm 72:3-7</ref></char></note>lapè tankou yon rivyè</para>
  <para style="q1" vid="ISA 66:12">e glwa a nasyon yo kon yon flèv k ap debòde.</para>
  <para style="q1" vid="ISA 66:12">Nou va vin pran tete,</para>
  <para style="q1" vid="ISA 66:12">nou va pote sou kwis e vin jwe sou jenou.<verse eid="ISA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 66:13"/>Tankou yon timoun ki jwenn rekonfò a manman l,</para>
  <para style="q1" vid="ISA 66:13">se konsa Mwen va <note caller="+" style="x"><char style="xo" closed="false">66:13 </char><char style="xt" closed="false"><ref loc="ISA 12:1">És 12:1</ref></char></note>rekonfòte nou;</para>
  <para style="q1" vid="ISA 66:13">epi nan Jérusalem, nou va rekonfòte.”<verse eid="ISA 66:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 66:14"/>Nou va wè sa;</para>
  <para style="q1" vid="ISA 66:14">
    <note caller="+" style="x">
      <char style="xo" closed="false">66:14 </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 10:7">Za 10:7</ref>
      </char>
    </note>kè nou va kontan e zo nou</para>
  <para style="q1" vid="ISA 66:14">va fleri tankou zèb vèt tounèf.</para>
  <para style="q1" vid="ISA 66:14">Men SENYÈ a va rekonèt pa sèvitè Li yo;</para>
  <para style="q1" vid="ISA 66:14">men Li va fè gwo kòlè kont lènmi Li yo.<verse eid="ISA 66:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 66:15"/>Paske gade byen, SENYÈ a va vini avèk dife,</para>
  <para style="q1" vid="ISA 66:15">e <note caller="+" style="x"><char style="xo" closed="false">66:15 </char><char style="xt" closed="false"><ref loc="PSA 68:17">Sòm 68:17</ref></char></note>cha Li yo va tankou van toubiyon.</para>
  <para style="q1" vid="ISA 66:15">Li va rann kòlè Li ak gwo raj</para>
  <para style="q1" vid="ISA 66:15">e repwòch Li ak flanm dife.<verse eid="ISA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 66:16"/>Paske SENYÈ a va egzekite jijman ak <note caller="+" style="x"><char style="xo" closed="false">66:16 </char><char style="xt" closed="false"><ref loc="ISA 30:30">És 30:30</ref></char></note>dife</para>
  <para style="q1" vid="ISA 66:16">e avèk nepe Li sou tout chè;</para>
  <para style="q1" vid="ISA 66:16">e sila ki va touye pa nepe yo va anpil.<verse eid="ISA 66:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17"/>“Sila ki sanktifye e pirifye tèt pou ale nan jaden yo, k ap swiv moun mitan an, ki manje chè kochon, bagay abominab, ak sourit la, va sispann <note caller="+" style="x"><char style="xo" closed="false">66:17 </char><char style="xt" closed="false"><ref loc="ISA 1:28-31">És 1:28-31</ref></char></note>nèt”, deklare SENYÈ a. <verse eid="ISA 66:17"/><verse number="18" style="v" sid="ISA 66:18"/>“Paske Mwen konnen zèv yo ak <note caller="+" style="x"><char style="xo" closed="false">66:18 </char><char style="xt" closed="false"><ref loc="ISA 59:7">És 59:7</ref></char></note>panse yo. Lè a ap rive pou rasanble tout nasyon ak tout lang yo. Konsa, yo va vini wè glwa Mwen. <verse eid="ISA 66:18"/><verse number="19" style="v" sid="ISA 66:19"/>Mwen va mete yon sign pami yo e Mwen va voye bay nasyon yo sila ki chape pami yo: Tarsis, Pul, Lud, Tubal ak Javan, nan peyi kot byen lwen ki pa t janm tande afè laglwa Mwen, ni ki pa t konn wè laglwa Mwen. Epi yo va <note caller="+" style="x"><char style="xo" closed="false">66:19 </char><char style="xt" closed="false"><ref loc="1CH 16:24">I Kwo 16:24</ref></char></note>deklare glwa Mwen pami nasyon yo. <verse eid="ISA 66:19"/><verse number="20" style="v" sid="ISA 66:20"/>Yo va <note caller="+" style="x"><char style="xo" closed="false">66:20 </char><char style="xt" closed="false"><ref loc="ISA 43:6">És 43:6</ref></char></note>mennen tout frè nou yo soti nan tout nasyon yo kon yon ofrann sereyal a SENYÈ a. Yo va vini sou cheval, nan cha, sou kabwèt kouvri, sou milèt ak chamo pou rive sou mòn sen Mwen an, Jérusalem”, di SENYÈ a. “Jis konsa, fis Israël yo pote ofrann sereyal nan yon veso pwòp a lakay SENYÈ a. <verse eid="ISA 66:20"/><verse number="21" style="v" sid="ISA 66:21"/>Anplis, Mwen va pran kèk nan yo kon <note caller="+" style="x"><char style="xo" closed="false">66:21 </char><char style="xt" closed="false"><ref loc="EXO 19:6">Egz 19:6</ref></char></note>prèt ak Levit”, SENYÈ a di.<verse eid="ISA 66:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22"/>“Paske menm jan ke <note caller="+" style="x"><char style="xo" closed="false">66:22 </char><char style="xt" closed="false"><ref loc="ISA 65:17">És 65:17</ref></char></note>syèl tounèf la ak tè tounèf ke Mwen va fè a va dire nèt devan Mwen”, deklare SENYÈ a; “se konsa desandan nou yo ak non nou va dire nèt. <verse eid="ISA 66:22"/><verse number="23" style="v" sid="ISA 66:23"/>Epi li va fèt ke soti nan lalin tounèf pou rive nan lalin tounèf la, e soti nan Saba a pou rive nan Saba a, tout limanite va vin pwostène <note caller="+" style="x"><char style="xo" closed="false">66:23 </char><char style="xt" closed="false"><ref loc="ISA 19:21-23">És 19:21-23</ref></char></note>devan Mwen,” SENYÈ a di. <verse eid="ISA 66:23"/><verse number="24" style="v" sid="ISA 66:24"/>“Yo va ale gade sou kadav a moun ki te fè transgresyon kont Mwen yo. Paske <note caller="+" style="x"><char style="xo" closed="false">66:24 </char><char style="xt" closed="false"><ref loc="ISA 14:11">És 14:11</ref></char></note>vè pa yo p ap mouri e dife pa yo p ap etenn. Konsa yo va vin yon abominasyon pou tout limanite.”<verse eid="ISA 66:24"/></para>
  <chapter eid="ISA 66"/>
</usx>
