<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id"/>
  <para style="h">Joël</para>
  <para style="toc1">JOËL</para>
  <para style="toc2">Joël</para>
  <para style="toc3">Jl</para>
  <para style="mt1">JOËL</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>Pawòl SENYÈ a te vin kote <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 2:16">Trav 2:16</ref></char></note>Joël,</para>
  <para style="q1" vid="JOL 1:1">fis a Pethuel la.<verse eid="JOL 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>Koute sa <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JOB 8:8">Job 8:8</ref> </char></note>ansyen nou yo,</para>
  <para style="q1" vid="JOL 1:2">koute sa, tout abitan peyi a!</para>
  <para style="q1" vid="JOL 1:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:2 </char>
      <char style="xt" closed="false">
        <ref loc="JER 30:7">Jr 30:7</ref>
      </char>
    </note>Èske yon bagay konsa konn rive nan jou nou yo,</para>
  <para style="q1" vid="JOL 1:2">oswa nan jou a papa zansèt nou yo?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:3 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:2">Egz 10:2</ref>
      </char>
    </note>Pale pitit nou yo bagay sa a, e kite pitit nou</para>
  <para style="q1" vid="JOL 1:3">pale pitit pa yo ak pitit a yon lòt jenerasyon.<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>Sa ke ti krikèt la te kite,</para>
  <para style="q1" vid="JOL 1:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:4 </char>
      <char style="xt" closed="false">
        <ref loc="NAM 3:15">Na 3:15</ref>,<ref loc="NAM 3:16">16</ref> </char>
    </note> gwo krikèt la fin manje.</para>
  <para style="q1" vid="JOL 1:4">Sa ke gwo krikèt la te kite,</para>
  <para style="q1" vid="JOL 1:4">ti cheni an te manje.</para>
  <para style="q1" vid="JOL 1:4">Sa ke ti cheni an te kite,</para>
  <para style="q1" vid="JOL 1:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:4 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 33:4">És 33:4</ref>
      </char>
    </note>gwo cheni an te manje.<verse eid="JOL 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>Moun sou yo, leve pou nou ka kriye!</para>
  <para style="q1" vid="JOL 1:5">Rele fò, nou tout k ap bwè diven an,</para>
  <para style="q1" vid="JOL 1:5">akoz diven dous lan,</para>
  <para style="q1" vid="JOL 1:5">paske li deja retire pou l kite bouch nou.<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="JOL 3:3">Jl 3:3</ref>; <ref loc="ISA 32:10">És 32:10</ref></char></note><verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>Paske yon nasyon deja anvayi peyi mwen an,</para>
  <para style="q1" vid="JOL 1:6">ak gwo pwisans, fòs kantite moun depase kontwòl.</para>
  <para style="q1" vid="JOL 1:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:6 </char>
      <char style="xt" closed="false">
        <ref loc="REV 9:8">Rev 9:8</ref>
      </char>
    </note>Dan l se dan a yon lyon;</para>
  <para style="q1" vid="JOL 1:6">gwo dan l yo se tankou dan a yon manman lyon.<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>Li te <note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="ISA 5:6">És 5:6</ref></char></note>fè chan rezen mwen an</para>
  <para style="q1" vid="JOL 1:7">vin yon kote gate.</para>
  <para style="q1" vid="JOL 1:7">Li te rache pye fig mwen an.</para>
  <para style="q1" vid="JOL 1:7">Li fin rache li nèt nèt, e jete li.</para>
  <para style="q1" vid="JOL 1:7">Branch yo te vin blanch.<verse eid="JOL 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:8 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 22:12">És 22:12</ref> </char>
    </note>Rele fò tankou yon vyèj ki <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="JOL 1:13">Jl 1:13</ref></char></note>abiye ak twal sak</para>
  <para style="q1" vid="JOL 1:8">pou fiyanse jenès li ki mouri.<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:9 </char>
      <char style="xt" closed="false">
        <ref loc="HOS 9:4">Os 9:4</ref>
      </char>
    </note>Ofrann sereyal ak ofrann bwason an</para>
  <para style="q1" vid="JOL 1:9">vin kou pe soti lakay SENYÈ a.</para>
  <para style="q1" vid="JOL 1:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:9 </char>
      <char style="xt" closed="false">
        <ref loc="JOL 2:17">Jl 2:17</ref> </char>
    </note>Prèt yo, sèvitè a SENYÈ a, ap lamante.<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>Chan an vin gate nèt.</para>
  <para style="q1" vid="JOL 1:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:10 </char>
      <char style="xt" closed="false">
        <ref loc="JER 12:11">Jr 12:11</ref>
      </char>
    </note>Peyi a ap fè dèy.</para>
  <para style="q1" vid="JOL 1:10">Paske tout sereyal la fin gate nèt.</para>
  <para style="q1" vid="JOL 1:10">Diven nèf la fin seche,</para>
  <para style="q1" vid="JOL 1:10">lwil fre a vin sispann.<verse eid="JOL 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>Se pou nou pa konprann anyèn,</para>
  <para style="q1" vid="JOL 1:11">O kiltivatè yo!</para>
  <para style="q1" vid="JOL 1:11">Rele anmwey,</para>
  <para style="q1" vid="JOL 1:11">O nou menm k ap okipe pye rezen yo!</para>
  <para style="q1" vid="JOL 1:11">Ble ak lòj la te peri nèt;</para>
  <para style="q1" vid="JOL 1:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:11 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 17:1">És 17:1</ref> </char>
    </note>rekòlt chan an fin detwi.<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:12 </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:10">Jl 1:10</ref> </char>
    </note>Pye rezen an vin sèch,</para>
  <para style="q1" vid="JOL 1:12">e pye fig la vin pa donnen.</para>
  <para style="q1" vid="JOL 1:12">Pye grenad la, pye palmis lan ak pye pòm nan;</para>
  <para style="q1" vid="JOL 1:12">menm tout pyebwa nan chan an fin cheche.</para>
  <para style="q1" vid="JOL 1:12">Anverite <note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ISA 16:10">És 16:10</ref></char></note>Lajwa a vin seche soti pami fis a lòm yo.<verse eid="JOL 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:13 </char>
      <char style="xt" closed="false">
        <ref loc="JER 4:8">Jr 4:8</ref>
      </char>
    </note>Mare senti nou ak twal sak e kriye fò,</para>
  <para style="q1" vid="JOL 1:13">O prèt yo, Rele anmwey!</para>
  <para style="q1" vid="JOL 1:13">O sèvitè a lotèl yo,</para>
  <para style="q1" vid="JOL 1:13">Vin pase nwit lan ak twal sak,</para>
  <para style="q1" vid="JOL 1:13">chèf sèvitè a Bondye mwen yo.</para>
  <para style="q1" vid="JOL 1:13">Paske ofrann sereyal la ak ofrann bwason an</para>
  <para style="q1" vid="JOL 1:13">p ap antre lakay Bondye nou an.<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>Vin konsakre jèn nan!</para>
  <para style="q1" vid="JOL 1:14">Pwoklame asanble solanèl lan!</para>
  <para style="q1" vid="JOL 1:14">Rasanble tout ansyen yo</para>
  <para style="q1" vid="JOL 1:14">ak tout moun ki rete nan peyi a,</para>
  <para style="q1" vid="JOL 1:14">pou yo vini lakay SENYÈ a, Bondye nou an,</para>
  <para style="q1" vid="JOL 1:14">pou kriye fò anvè SENYÈ a.<note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="JON 3:8">Jon 3:8</ref></char></note><verse eid="JOL 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>Elas pou jou a!</para>
  <para style="q1" vid="JOL 1:15">Paske <note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="JOL 2:1">Jl 2:1</ref>,<ref loc="JOL 2:11">11</ref>,<ref loc="JOL 2:31">31</ref> </char></note>jou SENYÈ a vin pwòch.</para>
  <para style="q1" vid="JOL 1:15">Li va vini tankou <note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ISA 13:6">És 13:6</ref></char></note>destriksyon ki soti</para>
  <para style="q1" vid="JOL 1:15">nan Toupwisan an.<verse eid="JOL 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>Èske manje a pa t retire soti devan zye nou?</para>
  <para style="q1" vid="JOL 1:16">Lajwa ak kè kontan soti lakay Bondye nou an?<note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="ISA 3:7">És 3:7</ref></char></note><verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>Jèm yo vin pouri anba bòl tè yo.</para>
  <para style="q1" vid="JOL 1:17">Depo yo vin abandone.</para>
  <para style="q1" vid="JOL 1:17">Kay depo yo fin demoli nèt,</para>
  <para style="q1" vid="JOL 1:17">paske sereyal la vin sispann nèt.<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="ISA 17:10">És 17:10</ref>,<ref loc="ISA 17:11">11</ref></char></note><verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>Ala plenyen <note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="1KI 8:5">I Wa 8:5</ref></char></note>bèt yo plenyen nan gòj!</para>
  <para style="q1" vid="JOL 1:18">Twoupo bèf yo ap gaye toupatou,</para>
  <para style="q1" vid="JOL 1:18">paske pa gen patiraj pou yo.</para>
  <para style="q1" vid="JOL 1:18">Menm bann mouton yo ap soufri.<verse eid="JOL 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>A Ou menm, O SENYÈ, Mwen kriye;</para>
  <para style="q1" vid="JOL 1:19">paske dife fin devore patiraj nan savann yo,</para>
  <para style="q1" vid="JOL 1:19">e flanm dife fin brile tout pyebwa nan chan yo.<note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="PSA 50:15">Sòm 50:15</ref></char></note><verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>Menm bèt chan yo <note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 104:21">Sòm 104:21</ref> </char></note>rele vè Ou menm;</para>
  <para style="q1" vid="JOL 1:20">paske <note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="1KI 17:7">I Wa 17:7</ref></char></note>sous dlo yo fin seche e dife a te devore</para>
  <para style="q1" vid="JOL 1:20">tout patiraj nan savann yo.<verse eid="JOL 1:20"/></para>
  <para style="b"/>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 2:1"/>Soufle twonpèt la nan Sion,</para>
  <para style="q1" vid="JOL 2:1">e sone alam nan sou mòn sen Mwen an!</para>
  <para style="q1" vid="JOL 2:1">Kite tout moun k ap viv nan peyi a tranble,</para>
  <para style="q1" vid="JOL 2:1">paske jou SENYÈ a ap vini.</para>
  <para style="q1" vid="JOL 2:1">Anverite, li vin pwòch.<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="JOL 1:15">Jl 1:15</ref></char></note><verse eid="JOL 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2"/>Yon jou fènwa ak pèdi espwa,</para>
  <para style="q1" vid="JOL 2:2">yon jou nwaj yo ak tenèb byen pwès.</para>
  <para style="q1" vid="JOL 2:2">Tankou solèy k ap leve sou mòn yo;</para>
  <para style="q1" vid="JOL 2:2">konsa gen yon gwo pèp pwisan.</para>
  <para style="q1" vid="JOL 2:2">Pa t janm gen yon bagay konsa,</para>
  <para style="q1" vid="JOL 2:2">ni p ap janm gen anyen ankò,</para>
  <para style="q1" vid="JOL 2:2">jis rive nan ane anpil jenerasyon yo.<note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="JOL 2:10">Jl 2:10</ref>,<ref loc="JOL 2:31">31</ref>; <ref loc="LAM 1:12">Lam 1:12</ref> </char></note><verse eid="JOL 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>Devan yo, se dife k ap devore,</para>
  <para style="q1" vid="JOL 2:3">e dèyè yo, se yon flanm k ap brile.</para>
  <para style="q1" vid="JOL 2:3">Peyi a vin <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ISA 51:3">És 51:3</ref> </char></note>tankou jaden Eden devan yo,</para>
  <para style="q1" vid="JOL 2:3">men yon savann <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="EXO 10:5">Egz 10:5</ref>,<ref loc="EXO 10:15">15</ref></char></note>dezole dèyè yo,</para>
  <para style="q1" vid="JOL 2:3">e nanpwen anyen ki chape.<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:4 </char>
      <char style="xt" closed="false">
        <ref loc="REV 9:7">Rev 9:7</ref>
      </char>
    </note>Aparans yo se tankou aparans cheval la;</para>
  <para style="q1" vid="JOL 2:4">epi kon yon kavalye kouri cheval li,</para>
  <para style="q1" vid="JOL 2:4">se konsa yo kouri.<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>Tankou bri cha a k ap vòltije sou tèt mòn yo,</para>
  <para style="q1" vid="JOL 2:5">se konsa yo sote;</para>
  <para style="q1" vid="JOL 2:5">tankou bri a yon flanm dife k ap devore pay,</para>
  <para style="q1" vid="JOL 2:5">se konsa yon gwo pèp ranje li pou batay.<note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="REV 9:9">Rev 9:9</ref></char></note><verse eid="JOL 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>Devan yo, pèp yo vin nan gwo <note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="ISA 13:8">És 13:8</ref></char></note>soufrans.</para>
  <para style="q1" vid="JOL 2:6">Tout figi yo vin pal.<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>Yo kouri tankou mesye pwisan yo.</para>
  <para style="q1" vid="JOL 2:7">Yo monte mi tankou sòlda.</para>
  <para style="q1" vid="JOL 2:7">Konsa, yo <note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="PRO 30:27">Pwov 30:27</ref></char></note>mache byen ranje,</para>
  <para style="q1" vid="JOL 2:7">ni yo pa kite pa yo.<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>Youn pa jennen lòt.</para>
  <para style="q1" vid="JOL 2:8">Yo chak mache nan pa yo.</para>
  <para style="q1" vid="JOL 2:8">Lè y ap eklate travèse defans yo,</para>
  <para style="q1" vid="JOL 2:8">yo pa kase ran ranje an.<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>Yo kouri sou vil la.</para>
  <para style="q1" vid="JOL 2:9">Yo kouri sou miray la.</para>
  <para style="q1" vid="JOL 2:9">Yo antre nan <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="EXO 10:6">Egz 10:6</ref> </char></note>kay yo;</para>
  <para style="q1" vid="JOL 2:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:9 </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:21">Jr 9:21</ref>
      </char>
    </note>nan fenèt yo antre kon vòlè.<verse eid="JOL 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>Devan yo, tè a <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="PSA 18:7">Sòm 18:7</ref> </char></note>souke.</para>
  <para style="q1" vid="JOL 2:10">Syèl yo tranble.</para>
  <para style="q1" vid="JOL 2:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:10 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 13:10">És 13:10</ref>
      </char>
    </note>Solèy la ak lalin nan vin tou nwa,</para>
  <para style="q1" vid="JOL 2:10">e zetwal yo vin pèdi briyans yo.<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>Vwa SENYÈ a pale devan lame Li a.</para>
  <para style="q1" vid="JOL 2:11">Anverite, kan Li vin byen gran,</para>
  <para style="q1" vid="JOL 2:11">paske <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="JER 50:34">Jr 50:34</ref> </char></note>byen fò se sila ki akonpli pawòl Li a.</para>
  <para style="q1" vid="JOL 2:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:11 </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:15">Jl 1:15</ref>
      </char>
    </note>Anverite, jou SENYÈ a gran.</para>
  <para style="q1" vid="JOL 2:11">Li tèrib anpil!</para>
  <para style="q1" vid="JOL 2:11">Se kilès ki ka sipòte li?<verse eid="JOL 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>“Koulye a menm”, deklare SENYÈ a,</para>
  <para style="q1" vid="JOL 2:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:12 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:29">Det 4:29</ref> </char>
    </note>“retounen kote Mwen ak tout kè nou;</para>
  <para style="q1" vid="JOL 2:12">avèk <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="DAN 9:3">Dan 9:3</ref></char></note>jèn, avèk gwo kri, e avèk gwo lamantasyon.”<verse eid="JOL 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="PSA 34:18">Sòm 34:18</ref> </char></note>rann kè nou, olye vètman nou.”</para>
  <para style="q1" vid="JOL 2:13">Retounen kote SENYÈ a, Bondye nou an,</para>
  <para style="q1" vid="JOL 2:13">paske Li <note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EXO 34:6">Egz 34:6</ref></char></note>plen gras ak mizerikòd,</para>
  <para style="q1" vid="JOL 2:13">lan nan kòlè, plen ak lanmou dous,</para>
  <para style="q1" vid="JOL 2:13">e konn ralanti nan fè malè.<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>Kilès ki ka konnen <note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="JER 26:3">Jr 26:3</ref></char></note>si Li p ap repanti kite sa a,</para>
  <para style="q1" vid="JOL 2:14">pou L kite dèyè Li yon benediksyon,</para>
  <para style="q1" vid="JOL 2:14">menm yon ofrann sereyal</para>
  <para style="q1" vid="JOL 2:14">ak yon ofrann bwason pou SENYÈ a, Bondye nou an.<verse eid="JOL 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>Soufle yon twonpèt nan Sion!</para>
  <para style="q1" vid="JOL 2:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:15 </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:14">Jl 1:14</ref>
      </char>
    </note>Konsakre yon jèn.</para>
  <para style="q1" vid="JOL 2:15">Pwoklame yon asanble solanèl.<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>Rasanble moun yo.</para>
  <para style="q1" vid="JOL 2:16">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:16 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:5">I Sam 16:5</ref>
      </char>
    </note>Fè yon asanble ki sen.</para>
  <para style="q1" vid="JOL 2:16">Reyini ansyen yo.</para>
  <para style="q1" vid="JOL 2:16">Rasanble timoun ak sila pran tete yo.</para>
  <para style="q1" vid="JOL 2:16">Kite mesye marye a sòti nan chanm li,</para>
  <para style="q1" vid="JOL 2:16">e lamarye a sòti nan chanm maryaj la.<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>Kite prèt yo, sèvitè SENYÈ yo,</para>
  <para style="q1" vid="JOL 2:17">kriye antre galri a ak lotèl la,</para>
  <para style="q1" vid="JOL 2:17">kite yo di: <note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="EXO 32:11">Egz 32:11</ref>,<ref loc="EXO 32:12">12</ref> </char></note>“Epagne pèp Ou a, O SENYÈ!</para>
  <para style="q1" vid="JOL 2:17">Pa fè eritaj Ou a vin yon repwòch,</para>
  <para style="q1" vid="JOL 2:17">yon vye mò pami nasyon yo.</para>
  <para style="q1" vid="JOL 2:17">Poukisa nasyon yo ta dwe di: <note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="PSA 42:10">Sòm 42:10</ref></char></note>“Kote Bondye Yo a ye?”<verse eid="JOL 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>Konsa, SENYÈ a te vin jalou pou peyi Li a,</para>
  <para style="q1" vid="JOL 2:18">e Li te <note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="ISA 60:10">És 60:10</ref> </char></note>fè mizerikòd a pèp Li a.<verse eid="JOL 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19"/>SENYÈ a te reponn pou di a pèp Li a:</para>
  <para style="q1" vid="JOL 2:19">“Gade byen, Mwen va voye bannou sereyal, diven nèf ak lwil.</para>
  <para style="q1" vid="JOL 2:19">Nou va vin satisfè nèt ak yo.</para>
  <para style="q1" vid="JOL 2:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:19 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 34:29">Éz 34:29</ref>
      </char>
    </note> Mwen p ap fè nou ankò vin yon repwòch pami nasyon yo.<verse eid="JOL 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>Men <note caller="+" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="JER 1:14">Jr 1:14</ref>,<ref loc="JER 1:15">15</ref></char></note>Lame nò a, Mwen va retire li ale lwen nou,</para>
  <para style="q1" vid="JOL 2:20">Mwen va pouse li ale nan yon peyi sèk e dezole.</para>
  <para style="q1" vid="JOL 2:20">Tèt devan lame a, Mwen va lage nan lanmè lès la;</para>
  <para style="q1" vid="JOL 2:20">pwent dèyè a, nan lanmè lwès la.</para>
  <para style="q1" vid="JOL 2:20">Konsa, sant pouriti li a va vin leve.</para>
  <para style="q1" vid="JOL 2:20">Movèz odè li va vin monte,</para>
  <para style="q1" vid="JOL 2:20">paske se gwo bagay li te konn fè.”<verse eid="JOL 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 2:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:21 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 54:4">És 54:4</ref>
      </char>
    </note>Pinga nou pè, O peyi a!</para>
  <para style="q1" vid="JOL 2:21">Rejwi e fè kè nou kontan,</para>
  <para style="q1" vid="JOL 2:21">paske SENYÈ a te fè gwo bagay.<verse eid="JOL 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22"/>Pa pè, nou menm bèt chan yo;</para>
  <para style="q1" vid="JOL 2:22">paske patiraj yo nan dezè a deja vin vèt,</para>
  <para style="q1" vid="JOL 2:22">paske pyebwa a vin bay fwi li.</para>
  <para style="q1" vid="JOL 2:22">Pye fig la ak pye rezen an bay tout fòs yo.<note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="PSA 65:12">Sòm 65:12</ref>,<ref loc="PSA 65:13">13</ref></char></note><verse eid="JOL 2:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>Konsa, se pou nou fè kè kontan,</para>
  <para style="q1" vid="JOL 2:23">O fis a Sion yo!</para>
  <para style="q1" vid="JOL 2:23">Rejwi nou nan SENYÈ a, Bondye nou an;</para>
  <para style="q1" vid="JOL 2:23">paske Li te <note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="DEU 11:14">Det 11:14</ref> </char></note>bay nou lapli bonè nan kantite ki jis,</para>
  <para style="q1" vid="JOL 2:23">li te fè vide sou nou lapli,</para>
  <para style="q1" vid="JOL 2:23">premyè ak <note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="LEV 26:4">Lev 26:4</ref></char></note>denyè lapli lan tankou avan an.<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>Glasi vannen yo va plen ak sereyal,</para>
  <para style="q1" vid="JOL 2:24">e chodyè yo va debòde ak diven nèf ak lwil.<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="LEV 26:10">Lev 26:10</ref></char></note><verse eid="JOL 2:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>Konsa, Mwen va restore bannou pou ane</para>
  <para style="q1" vid="JOL 2:25">ke <note caller="+" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOL 1:4-7">Jl 1:4-7</ref></char></note> gwo krikèt te manje yo,</para>
  <para style="q1" vid="JOL 2:25">ak ti krikèt la ki kouri a tè a,</para>
  <para style="q1" vid="JOL 2:25">ak ti cheni ak gwo cheni ke M voye pami nou,</para>
  <para style="q1" vid="JOL 2:25">gwo lame ke Mwen menm te</para>
  <para style="q1" vid="JOL 2:25">voye pami nou.<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>Nou va genyen anpil manje,</para>
  <para style="q1" vid="JOL 2:26">nou va vin satisfè,</para>
  <para style="q1" vid="JOL 2:26">e nou va fè lwanj non SENYÈ a,</para>
  <para style="q1" vid="JOL 2:26">Bondye nou a,</para>
  <para style="q1" vid="JOL 2:26">ki te <note caller="+" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="PSA 126:2">Sòm 126:2</ref>,<ref loc="PSA 126:3">3</ref> </char></note>aji ak mèvèy avèk nou.</para>
  <para style="q1" vid="JOL 2:26">Konsa, pèp Mwen an <note caller="+" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="ISA 45:17">És 45:17</ref></char></note>p ap janm vin desi ankò.<verse eid="JOL 2:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>Konsa, nou va konnen ke</para>
  <para style="q1" vid="JOL 2:27">Mwen nan mitan Israël,</para>
  <para style="q1" vid="JOL 2:27">ke Mwen se SENYÈ a, Bondye nou an,</para>
  <para style="q1" vid="JOL 2:27">e ke pa gen okenn lòt;</para>
  <para style="q1" vid="JOL 2:27">epi pèp Mwen an p ap janm vin desi.<note caller="+" style="x"><char style="xo" closed="false">2:27 </char><char style="xt" closed="false"><ref loc="LEV 26:11">Lev 26:11</ref>,<ref loc="LEV 26:12">12</ref>; <ref loc="ISA 45:5">És 45:5</ref>,<ref loc="ISA 45:6">6</ref></char></note><verse eid="JOL 2:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>Li va vin rive apre sa,</para>
  <para style="q1" vid="JOL 2:28">ke Mwen va <note caller="+" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="ISA 32:15">És 32:15</ref> </char></note>vide Lespri M sou tout <note caller="+" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="ISA 40:5">És 40:5</ref></char></note>chè.</para>
  <para style="q1" vid="JOL 2:28">Fis nou yo ak fi nou yo va pwofetize,</para>
  <para style="q1" vid="JOL 2:28">e granmoun nou yo va fè vizyon yo.<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>Menm sou sèvitè ak sèvan yo,</para>
  <para style="q1" vid="JOL 2:29">mwen va vide Lespri Mwen nan jou sa yo.<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">2:30 </char><char style="xt" closed="false"><ref loc="MAT 24:29">Mat 24:29</ref></char></note>montre mèvèy yo</para>
  <para style="q1" vid="JOL 2:30">nan syèl la ak sou tè a:</para>
  <para style="q1" vid="JOL 2:30">san, dife, ak gwo kolòn lafimen.<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>Solèy la va vin tou nwa,</para>
  <para style="q1" vid="JOL 2:31">e lalin nan tankou san</para>
  <para style="q1" vid="JOL 2:31">devan gwo jou tèrib SENYÈ a.<note caller="+" style="x"><char style="xo" closed="false">2:31 </char><char style="xt" closed="false"><ref loc="ISA 13:10">És 13:10</ref></char></note><verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>Epi li va vin rive ke <note caller="+" style="x"><char style="xo" closed="false">2:32 </char><char style="xt" closed="false"><ref loc="JER 33:3">Jr 33:3</ref></char></note>nenpòt moun</para>
  <para style="q1" vid="JOL 2:32">ki rele non SENYÈ a, li va delivre;</para>
  <para style="q1" vid="JOL 2:32">paske nan Mòn Sion ak Jérusalem,</para>
  <para style="q1" vid="JOL 2:32">va gen sila ki chape yo,</para>
  <para style="q1" vid="JOL 2:32">jan SENYÈ a te di a,</para>
  <para style="q1" vid="JOL 2:32">menm pami retay la, sa yo SENYÈ a rele.<verse eid="JOL 2:32"/></para>
  <para style="b"/>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 3:1"/>“Paske gade byen, nan jou sila yo</para>
  <para style="q1" vid="JOL 3:1">ak nan lè sa a,</para>
  <para style="q1" vid="JOL 3:1">lè Mwen va restore davni Juda ak Jérusalem,<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="JER 16:5">Jr 16:5</ref></char></note><verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="ISA 66:18">És 66:18</ref> </char></note>rasanble tout nasyon yo</para>
  <para style="q1" vid="JOL 3:2">pou mennen yo desann nan vale Josaphat la.</para>
  <para style="q1" vid="JOL 3:2">Epi Mwen va <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="JER 25:31">Jr 25:31</ref></char></note>antre la nan jijman avèk yo</para>
  <para style="q1" vid="JOL 3:2">pou pèp ak eritaj Mwen an, Israël,</para>
  <para style="q1" vid="JOL 3:2">ke yo te gaye pami nasyon yo.</para>
  <para style="q1" vid="JOL 3:2">Yo te divize tè Mwen an,<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>epi te <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="OBA 1:11">Ab 11</ref> </char></note>voye tiraj osò pou pèp Mwen an.</para>
  <para style="q1" vid="JOL 3:3">Yo te <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="AMO 2:6">Am 2:6</ref></char></note>twoke yon gason pou yon pwostitiye</para>
  <para style="q1" vid="JOL 3:3">ak yon fi yo vann pou diven,</para>
  <para style="q1" vid="JOL 3:3">pou yo ta ka bwè.”<verse eid="JOL 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 3:4"/>“Anplis, se kisa ou ye pou Mwen, O Tyr, ak Sidon,</para>
  <para style="q1" vid="JOL 3:4">ak tout rejyon a Philistine yo?</para>
  <para style="q1" vid="JOL 3:4">Èske se yon rekonpans ke n ap ban Mwen?</para>
  <para style="q1" vid="JOL 3:4">Men si Mwen pa jwenn rekonpans</para>
  <para style="q1" vid="JOL 3:4">byen vit e san delè,</para>
  <para style="q1" vid="JOL 3:4">Mwen va fè rekonpans nou an</para>
  <para style="q1" vid="JOL 3:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">3:4 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 34:8">És 34:8</ref> </char>
    </note>retounen sou tèt nou.<verse eid="JOL 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 3:5"/>Akoz nou te <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="2KI 12:18">II Wa 12:18</ref></char></note>pran ajan Mwen</para>
  <para style="q1" vid="JOL 3:5">ak lò Mwen, e te mennen bagay</para>
  <para style="q1" vid="JOL 3:5">presye sakre Mwen yo nan tanp nou yo,<verse eid="JOL 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 3:6"/>epi nou te vann <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="EZK 27:13">Éz 27:13</ref></char></note>fis a Juda ak Jérusalem yo</para>
  <para style="q1" vid="JOL 3:6">bay Grèk yo pou yo ta ka vin rete lwen teritwa yo,<verse eid="JOL 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 3:7"/>gade byen, Mwen va <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ISA 43:5">És 43:5</ref></char></note>fè yo leve soti</para>
  <para style="q1" vid="JOL 3:7">nan plas kote nou te vann yo,</para>
  <para style="q1" vid="JOL 3:7">pou retounen rekonpans nou an</para>
  <para style="q1" vid="JOL 3:7">sou pwòp tèt nou.<verse eid="JOL 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 3:8"/>Anplis, Mwen va <note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="ISA 14:2">És 14:2</ref> </char></note>vann fis nou yo</para>
  <para style="q1" vid="JOL 3:8">ak fi nou yo nan men a fis a Juda yo.</para>
  <para style="q1" vid="JOL 3:8">Konsa, yo va vann yo bay <note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JOB 1:15">Job 1:15</ref></char></note>Sabeyen yo,</para>
  <para style="q1" vid="JOL 3:8">yon nasyon byen lwen,”</para>
  <para style="q1" vid="JOL 3:8">paske SENYÈ a fin pale.<verse eid="JOL 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>Pwoklame sa pami nasyon yo:</para>
  <para style="q1" vid="JOL 3:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">3:9 </char>
      <char style="xt" closed="false">
        <ref loc="JER 6:4">Jr 6:4</ref>
      </char>
    </note>“Prepare nou pou fè lagè!</para>
  <para style="q1" vid="JOL 3:9">Anime mesye pwisan yo!</para>
  <para style="q1" vid="JOL 3:9">Kite tout sòlda yo vin pi pre.</para>
  <para style="q1" vid="JOL 3:9">Kite yo monte kote nou.<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:10 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 2:4">És 2:4</ref>
      </char>
    </note>Bat lam cha pou yo fè epe,</para>
  <para style="q1" vid="JOL 3:10">ak kwòk rebondaj pou fè lans.</para>
  <para style="q1" vid="JOL 3:10">Kite moun fèb yo di: ‘Mwen pwisan!’<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:11 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 38:15">Éz 38:15</ref>,<ref loc="EZK 38:16">16</ref></char>
    </note>Fè vit vini, tout nasyon ki ozalantou yo.</para>
  <para style="q1" vid="JOL 3:11">Rasanble nou ansanm.”</para>
  <para style="q1" vid="JOL 3:11">Fè desann la, O SENYÈ, moun pwisan Ou yo.<verse eid="JOL 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>“Kite nasyon yo leve pwop tèt yo</para>
  <para style="q1" vid="JOL 3:12">pou vin monte nan vale Josaphat la;</para>
  <para style="q1" vid="JOL 3:12">paske se la Mwen va chita pou jije</para>
  <para style="q1" vid="JOL 3:12">tout nasyon ki ozalantou yo.<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="JOL 3:2">Jl 3:2</ref>,<ref loc="JOL 3:14">14</ref>; <ref loc="PSA 7:6">Sòm 7:6</ref> </char></note><verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:13 </char>
      <char style="xt" closed="false">
        <ref loc="REV 14:14-19">Rev 14:14-19</ref> </char>
    </note>Fè antre boutdigo rekòlt la,</para>
  <para style="q1" vid="JOL 3:13">paske <note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="JER 51:33">Jr 51:33</ref></char></note>rekòlt la vin mi.</para>
  <para style="q1" vid="JOL 3:13">Vin mache foule anba pye,</para>
  <para style="q1" vid="JOL 3:13">paske pèz diven an vin plen.</para>
  <para style="q1" vid="JOL 3:13">Chodyè yo ap debòde, paske mechanste yo vin gran.”<verse eid="JOL 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:14 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 34:2-8">És 34:2-8</ref>
      </char>
    </note>Gwo foul yo, gwo foul nan vale desizyon an!</para>
  <para style="q1" vid="JOL 3:14">Paske jou SENYÈ a toupre nan vale desizyon an.<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:15 </char>
      <char style="xt" closed="false">
        <ref loc="JOL 2:10">Jl 2:10</ref>,<ref loc="JOL 2:31">31</ref></char>
    </note>Solèy la ak lalin nan va vin tou nwa,</para>
  <para style="q1" vid="JOL 3:15">e zetwal yo va pèdi briyans yo.<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>Senyè a va gwonde soti nan Sion,</para>
  <para style="q1" vid="JOL 3:16">e va sone vwa Li soti Jérusalem.</para>
  <para style="q1" vid="JOL 3:16">Syèl yo ak tè a va tranble,</para>
  <para style="q1" vid="JOL 3:16">men SENYÈ a se yon <note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="PSA 61:3">Sòm 61:3</ref></char></note>refij pou pèp Li a,</para>
  <para style="q1" vid="JOL 3:16">ak yon <note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="JER 16:9">Jr 16:9</ref> </char></note>sitadèl pou fis Israël yo.<verse eid="JOL 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>Konsa, nou va <note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="JOL 2:27">Jl 2:27</ref> </char></note>konnen</para>
  <para style="q1" vid="JOL 3:17">ke Mwen se SENYÈ a, Bondye nou an,</para>
  <para style="q1" vid="JOL 3:17">ka p viv nan Sion, mòn sen Mwen an.</para>
  <para style="q1" vid="JOL 3:17">Nan lè sa a Jérusalem va sen,</para>
  <para style="q1" vid="JOL 3:17">e <note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="ISA 52:1">És 52:1</ref></char></note>etranje yo p ap pase ladann ankò.<verse eid="JOL 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>Epi nan jou sa a, mòn yo va degoute diven nèf.</para>
  <para style="q1" vid="JOL 3:18">Nan kolin yo, se lèt ki va koule;</para>
  <para style="q1" vid="JOL 3:18">tout <note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ISA 30:25">És 30:25</ref> </char></note>ravin nan Juda va gen dlo,</para>
  <para style="q1" vid="JOL 3:18">epi yon <note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="EZK 47:1-12">Éz 47:1-12</ref></char></note>sous va sòti lakay SENYÈ a</para>
  <para style="q1" vid="JOL 3:18">pou awoze vale a Sittim nan.<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>Égypte va vin yon dezè,</para>
  <para style="q1" vid="JOL 3:19">Edom va vin yon savann dezole,</para>
  <para style="q1" vid="JOL 3:19">akoz <note caller="+" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="OBA 1:10">Ab 10</ref></char></note>vyolans ki te fèt sou fis Israël yo,</para>
  <para style="q1" vid="JOL 3:19">akoz yo te vèse san inosan an nan peyi yo.<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>Men Juda va gen moun ladann jis pou tout tan</para>
  <para style="q1" vid="JOL 3:20">e Jérusalem de jenerasyon an jenerasyon.<note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="EZK 37:25">Éz 37:25</ref></char></note><verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>Epi Mwen va vanje san ke M potko vanje yo,</para>
  <para style="q1" vid="JOL 3:21">paske SENYÈ a rete nan Sion.”<note caller="+" style="x"><char style="xo" closed="false">3:21 </char><char style="xt" closed="false"><ref loc="ISA 4:4">És 4:4</ref></char></note><verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
