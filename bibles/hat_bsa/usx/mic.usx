<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id" />
  <para style="h">Michée</para>
  <para style="toc1">MICHÉE</para>
  <para style="toc2">Michée</para>
  <para style="toc3">Mi</para>
  <para style="mt1">MICHÉE</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />Pawòl SENYÈ a ki te adrese a <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="JER 26:18">Jr 26:18</ref> </char></note>Michée, moun Moréscheth la, nan jou a Jotham, Achaz, ak Ézéchias, wa Juda yo, pawòl ke li te wè konsènan Samarie ak Jérusalem nan.<verse eid="MIC 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />Tande, O pèp yo, nou tout!</para>
  <para style="q1" vid="MIC 1:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:2 </char>
      <char style="xt" closed="false">
        <ref loc="JER 6:19">Jr 6:19</ref> </char>
    </note>Koute, O latè a, ak tout sa ki ladann.</para>
  <para style="q1" vid="MIC 1:2">Kite SENYÈ Bondye a vin <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ISA 50:7">És 50:7</ref></char></note>temwen kont nou;</para>
  <para style="q1" vid="MIC 1:2">SENYÈ a, depi nan tanp sen Li an.<verse eid="MIC 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />Paske gade byen, SENYÈ a ap vin <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 26:21">És 26:21</ref></char></note>sòti nan plas Li a.</para>
  <para style="q1" vid="MIC 1:3">Li va vin desann pou <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="AMO 4:13">Am 4:13</ref> </char></note>foule wo plas latè yo.<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 97:5">Sòm 97:5</ref>
      </char>
    </note>Mòn yo fann anba Li;</para>
  <para style="q1" vid="MIC 1:4">Vale yo fann tankou lasi devan dife,</para>
  <para style="q1" vid="MIC 1:4">tankou dlo k ap vide desann yon pant apik.<verse eid="MIC 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />Tout sa se pou rebelyon a Jacob la</para>
  <para style="q1" vid="MIC 1:5">ak pou peche Israël la.</para>
  <para style="q1" vid="MIC 1:5">Se kisa ki <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="JER 2:19">Jr 2:19</ref> </char></note> rebelyon a Jacob la?</para>
  <para style="q1" vid="MIC 1:5">Èske se pa <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ISA 7:9">És 7:9</ref></char></note>Samarie?</para>
  <para style="q1" vid="MIC 1:5">Se kisa ki wo plas a Juda yo?</para>
  <para style="q1" vid="MIC 1:5">Èske se pa Jérusalem?<verse eid="MIC 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />Alò, Mwen va fè Samarie vin yon pil <note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 19:25">II Wa 19:25</ref></char></note>mazi nan yon chan louvri,</para>
  <para style="q1" vid="MIC 1:6">tankou yon kote pou plante yon chan rezen.</para>
  <para style="q1" vid="MIC 1:6">Mwen va vide wòch batisman li yo nan vale a,</para>
  <para style="q1" vid="MIC 1:6">e Mwen va dekouvri mete toutouni tout fondasyon li yo.<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />Tout <note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="DEU 9:21">Det 9:21</ref> </char></note>zidòl li yo va vin kraze nèt,</para>
  <para style="q1" vid="MIC 1:7">tout kado yo bay li yo va vin brile ak dife a,</para>
  <para style="q1" vid="MIC 1:7">e tout zidòl li yo Mwen va detwi;</para>
  <para style="q1" vid="MIC 1:7">paske se pou salè a yon <note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="DEU 23:18">Det 23:18</ref></char></note>pwostitiye ke li te ranmase yo,</para>
  <para style="q1" vid="MIC 1:7">e pou salè a yon pwostitiye yo va remèt.<verse eid="MIC 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />Pousa, mwen oblije fè dèy e kriye fò.</para>
  <para style="q1" vid="MIC 1:8">Mwen oblije ale <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="ISA 32:11">És 32:11</ref> </char></note>pye atè ak toutouni.</para>
  <para style="q1" vid="MIC 1:8">Mwen oblije fè lamantasyon tankou <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="ISA 13:21">És 13:21</ref>,<ref loc="ISA 13:22">22</ref></char></note>chen mawon,</para>
  <para style="q1" vid="MIC 1:8">plenyen tankou otrich!<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />Paske <note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="ISA 3:26">És 3:26</ref></char></note>blesi li a p ap ka geri;</para>
  <para style="q1" vid="MIC 1:9">paske li fin rive nan Juda.</para>
  <para style="q1" vid="MIC 1:9">Li rive nan pòtay a pèp mwen an,</para>
  <para style="q1" vid="MIC 1:9">menm Jérusalem.<verse eid="MIC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:10 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 1:20">II Sam 1:20</ref>
      </char>
    </note>Pa pale sa nan Gath.</para>
  <para style="q1" vid="MIC 1:10">Pa kriye menm.</para>
  <para style="q1" vid="MIC 1:10">Nan Beth-Leaphra mwen te woule</para>
  <para style="q1" vid="MIC 1:10">kò mwen nan pousyè.<verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />Ale fè wout ou, ou menm ki rete Schaphir;</para>
  <para style="q1" vid="MIC 1:11">nan <note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="EZK 23:29">Éz 23:29</ref> </char></note>lawont ak toutouni ou.</para>
  <para style="q1" vid="MIC 1:11">Moun <note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="JOS 15:37">Jos 15:37</ref></char></note>Tsaanan p ap chape.</para>
  <para style="q1" vid="MIC 1:11">Plenyen Beth-Haëtsel la:</para>
  <para style="q1" vid="MIC 1:11">Li va retire sou ou tout soutyen li.<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />Paske moun Maroth vin fèb nan <note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ISA 59:9-11">És 59:9-11</ref></char></note>tann sa ki bon,</para>
  <para style="q1" vid="MIC 1:12">akoz malè vin desann sòti nan SENYÈ a,</para>
  <para style="q1" vid="MIC 1:12">rive nan pòtay Jérusalem nan.<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />Tache cheval yo nan cha lagè a, O moun <note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="JOS 10:3">Jos 10:3</ref></char></note>Lakis!</para>
  <para style="q1" vid="MIC 1:13">Fi sila a te kòmansman peche pou fi Sion an—</para>
  <para style="q1" vid="MIC 1:13">akoz se nan ou, yo te twouve zak rebelyon a Israël yo.<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />Alò, ou va bay kado dadye a Moreschet-Gath.</para>
  <para style="q1" vid="MIC 1:14">Lakay <note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="JOS 15:44">Jos 15:44</ref> </char></note>Aczib yo va vin yon <note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="JER 15:18">Jr 15:18</ref></char></note>desepsyon pou wa Israël yo.<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />Anplis, Mwen va mennen bay nou sila</para>
  <para style="q1" vid="MIC 1:15">k ap pran posesyon nou an,</para>
  <para style="q1" vid="MIC 1:15">O nou menm k ap viv nan <note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="JOS 15:44">Jos 15:44</ref></char></note>Maréscha yo!</para>
  <para style="q1" vid="MIC 1:15">Glwa Israël la va antre menm nan <note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="2SA 23:13">II Sam 23:13</ref> </char></note>Adullam.<verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />Vin <note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="ISA 22:12">És 22:12</ref></char></note>chòv nèt;</para>
  <para style="q1" vid="MIC 1:16">koupe tout cheve ou pou pitit ke ou renmen an.</para>
  <para style="q1" vid="MIC 1:16">Elaji tèt chòv ou pou vin tankou èg,</para>
  <para style="q1" vid="MIC 1:16">paske <note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="2KI 17:6">II Wa 17:6</ref> </char></note>yo te ale an egzil kite ou!<verse eid="MIC 1:16" /></para>
  <para style="b" />
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 2:1" />Malè a sila k ap <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="PSA 36:4">Sòm 36:4</ref></char></note>fè plan inikite yo,</para>
  <para style="q1" vid="MIC 2:1">k ap manevre mechanste sou kabann yo!</para>
  <para style="q1" vid="MIC 2:1">Lè maten rive, yo pratike li,</para>
  <para style="q1" vid="MIC 2:1">paske sa nan pouvwa a men yo.<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />Yo lanvi chan a lòt, epi konsa yo sezi yo,</para>
  <para style="q1" vid="MIC 2:2">kay yo, e konsa yo pran yo.</para>
  <para style="q1" vid="MIC 2:2">Yo oprimen yon nonm ak kay li,</para>
  <para style="q1" vid="MIC 2:2">Yon nonm ak tout eritaj li.<verse eid="MIC 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 2:3" />Pou sa, pale SENYÈ a:</para>
  <para style="q1" vid="MIC 2:3">“Gade byen, Mwen ap fè yon plan kont pèp sa a,</para>
  <para style="q1" vid="MIC 2:3">yon malè k ap fè nou p ap ka retire kou nou;</para>
  <para style="q1" vid="MIC 2:3">ni nou p ap ka mache ak awogans,</para>
  <para style="q1" vid="MIC 2:3">paske sa se yon <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="DEU 28:48">Det 28:48</ref>; <ref loc="AMO 5:13">Am 5:13</ref> </char></note>move tan.<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />Nan jou sa a, yo va <note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="HAB 2:6">Hab 2:6</ref> </char></note>fè leve kont nou yon pawòl;</para>
  <para style="q1" vid="MIC 2:4">mokè yo va kriye ak yon lamantasyon tris.</para>
  <para style="q1" vid="MIC 2:4">Yo va di: ‘Nou fin <note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="ISA 6:11">És 6:11</ref></char></note>detwi nèt!</para>
  <para style="q1" vid="MIC 2:4">Li divize eritaj a pèp mwen an.</para>
  <para style="q1" vid="MIC 2:4">A la retire, Li retire l nan men mwen!</para>
  <para style="q1" vid="MIC 2:4">Li bay moun trèt yo! Li divize bay chan nou yo!’”<verse eid="MIC 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />Akoz sa, nou p ap gen pèsòn ki va tann <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="NUM 34:13">Nonb 34:13</ref>,<ref loc="NUM 34:16-29">16-29</ref></char></note>lign mezi</para>
  <para style="q1" vid="MIC 2:5">pou fè tiraj osò nan asanble SENYÈ a.<verse eid="MIC 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />“Pa pwofetize”!—yo pwofetize—</para>
  <para style="q1" vid="MIC 2:6">“Pa pwofetize de bagay de sila yo.</para>
  <para style="q1" vid="MIC 2:6">Repwòch sa yo p ap janm rive nou.”<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />Èske sa dwe pale, O Lakay Jacob?</para>
  <para style="q1" vid="MIC 2:7">“Èske Lespri SENYÈ a pa <note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ISA 50:2">És 50:2</ref></char></note>an kolè?</para>
  <para style="q1" vid="MIC 2:7">Èske bagay sa yo se zèv pa Li?</para>
  <para style="q1" vid="MIC 2:7">Èske pawòl Mwen yo pa fè byen</para>
  <para style="q1" vid="MIC 2:7">pou sila k ap mache dwat la?”<verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />Men koulye a, pèp Mwen an leve tankou yon <note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="JER 12:8">Jr 12:8</ref></char></note>ènmi.</para>
  <para style="q1" vid="MIC 2:8">Nou chire retire manto ak abiman</para>
  <para style="q1" vid="MIC 2:8">de sila k ap pase pa aza yo;</para>
  <para style="q1" vid="MIC 2:8">moun k ap retounen, soti nan lagè.<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />Fanm a pèp Mwen yo, nou <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="JER 10:20">Jr 10:20</ref></char></note>chase yo deyò</para>
  <para style="q1" vid="MIC 2:9">pou soti kite bèl ti kay yo.</para>
  <para style="q1" vid="MIC 2:9">Nan men jèn pitit yo, nou rache retire</para>
  <para style="q1" vid="MIC 2:9">tout benediksyon Mwen, jis pou tout tan.<verse eid="MIC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />Leve ale!</para>
  <para style="q1" vid="MIC 2:10">Se pa isit ou ap jwenn repo;</para>
  <para style="q1" vid="MIC 2:10">li plen ak sa ki <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="PSA 106:38">Sòm 106:38</ref></char></note>pa pwòp, sa kab detwi,</para>
  <para style="q1" vid="MIC 2:10">menm avèk yon destriksyon byen grav.<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />Si yon nonm ap mache nan yon</para>
  <para style="q1" vid="MIC 2:11">lespri manti pou l di:</para>
  <para style="q1" vid="MIC 2:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:11 </char>
      <char style="xt" closed="false">
        <ref loc="JER 5:31">Jr 5:31</ref>
      </char>
    </note> “Mwen va pale avèk nou konsènan</para>
  <para style="q1" vid="MIC 2:11">diven ak bwason fò,”</para>
  <para style="q1" vid="MIC 2:11">li ta kapab menm vin pwofèt a <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="ISA 30:10">És 30:10</ref>,<ref loc="ISA 30:11">11</ref> </char></note>pèp sa a.<verse eid="MIC 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />Anverite, Mwen va <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MIC 4:6">Mi 4:6</ref>,<ref loc="MIC 4:7">7</ref> </char></note>rasanble nou tout, O Jacob!</para>
  <para style="q1" vid="MIC 2:12">Anverite, Mwen va ranmase <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MIC 5:7">Mi 5:7</ref>,<ref loc="MIC 5:8">8</ref></char></note>retay Israël yo.</para>
  <para style="q1" vid="MIC 2:12">Mwen va mete yo ansanm tankou mouton nan pak;</para>
  <para style="q1" vid="MIC 2:12">tankou yon bann mouton nan mitan patiraj yo.</para>
  <para style="q1" vid="MIC 2:12">Y ap plenn ak moun.<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />Sila k ap ouvri kraze chemen a va ale devan yo.</para>
  <para style="q1" vid="MIC 2:13">Yo kraze pòtay la pou soti.</para>
  <para style="q1" vid="MIC 2:13">Se wa yo ki pase devan yo,</para>
  <para style="q1" vid="MIC 2:13">ak SENYÈ la a latèt yo.<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />Konsa, mwen te di:</para>
  <para style="q1" vid="MIC 3:1">“Koute koulye a, chèf a Jacob yo ak sila</para>
  <para style="q1" vid="MIC 3:1">k ap gouvène lakay Israël yo.</para>
  <para style="q1" vid="MIC 3:1">Èske nou pa dwe konnen lajistis?<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="PSA 82:1-5">Sòm 82:1-5</ref></char></note><verse eid="MIC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 3:2" />Nou menm ki rayi sa ki bon,</para>
  <para style="q1" vid="MIC 3:2">e ki renmen sa ki mal;</para>
  <para style="q1" vid="MIC 3:2">ki <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="PSA 53:4">Sòm 53:4</ref></char></note>chire po yo sou kò yo,</para>
  <para style="q1" vid="MIC 3:2">ak chè yo soti sou zo yo;<verse eid="MIC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3" />k ap anplis<note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="PSA 14:4">Sòm 14:4</ref> </char></note>manje chè pèp Mwen an,</para>
  <para style="q1" vid="MIC 3:3">chire po yo sou yo, kraze zo yo</para>
  <para style="q1" vid="MIC 3:3">e <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="EZK 11:3">Éz 11:3</ref></char></note>koupe yo an mòso,</para>
  <para style="q1" vid="MIC 3:3">tankou se pou mete nan chodyè,</para>
  <para style="q1" vid="MIC 3:3">tankou vyann nan bonm nan.<verse eid="MIC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />Konsa, yo va kriye fò a SENYÈ a,</para>
  <para style="q1" vid="MIC 3:4">men Li p ap reponn yo.</para>
  <para style="q1" vid="MIC 3:4">Olye de sa, nan lè sa a, Li va <note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="DEU 31:17">Det 31:17</ref>; <ref loc="ISA 3:11">És 3:11</ref></char></note>kache figi li a yo menm,</para>
  <para style="q1" vid="MIC 3:4">akoz yo te pratike zak ki mechan.”<verse eid="MIC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5" />Konsa pale SENYÈ a konsènan pwofèt ki te <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="ISA 3:12">És 3:12</ref> </char></note>mennen pèp mwen an nan erè yo. Lè yo bay yo kèk bagay pou mòde ak dan yo, yo kriye: “Lapè”! men kont sila ki pa mete anyen nan bouch yo, yo deklare lagè.<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />Akoz sa, li fènwa <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ISA 8:20-22">És 8:20-22</ref> </char></note> sou nou—san vizyon</para>
  <para style="q1" vid="MIC 3:6">e fènwa pou nou—san apèsi davni.</para>
  <para style="q1" vid="MIC 3:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">3:6 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 59:10">És 59:10</ref>
      </char>
    </note>Solèy la va kouche sou pwofèt yo,</para>
  <para style="q1" vid="MIC 3:6">e lajounen va vin fènwa sou yo.<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />Vwayan yo va wont</para>
  <para style="q1" vid="MIC 3:7">e <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ISA 44:25">És 44:25</ref> </char></note>divinò yo va nan konfizyon.</para>
  <para style="q1" vid="MIC 3:7">Anverite, yo tout va <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MIC 7:16">Mi 7:16</ref></char></note>kouvri bouch yo</para>
  <para style="q1" vid="MIC 3:7">akoz Bondye pa reponn.<verse eid="MIC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />Men kanta mwen menm,</para>
  <para style="q1" vid="MIC 3:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">3:8 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 61:1-2">És 61:1-2</ref> </char>
    </note>mwen ranpli ak pouvwa pa Lespri SENYÈ a,</para>
  <para style="q1" vid="MIC 3:8">ak jistis ak kouraj Li,</para>
  <para style="q1" vid="MIC 3:8">pou <note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="ISA 58:1">És 58:1</ref></char></note>fè Jacob konnen zak rebelyon li an;</para>
  <para style="q1" vid="MIC 3:8">menm a Israël, peche pa l la.<verse eid="MIC 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />Alò, tande sa, chèf lakay Jacob yo,</para>
  <para style="q1" vid="MIC 3:9">ak sila k ap gouvène lakay Israël yo,</para>
  <para style="q1" vid="MIC 3:9">ki <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="PSA 58:1">Sòm 58:1</ref>,<ref loc="PSA 58:2">2</ref> </char></note>rayi jistis,</para>
  <para style="q1" vid="MIC 3:9">e ki vire tòde tout sa ki dwat,<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />Ki <note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="JER 22:13">Jr 22:13</ref>,<ref loc="JER 22:17">17</ref></char></note>bati Sion ak san koule,</para>
  <para style="q1" vid="MIC 3:10">e Jérusalem ak vyolans e enjistis.<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />Chèf li yo fè <note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ISA 1:23">És 1:23</ref> </char></note>jijman</para>
  <para style="q1" vid="MIC 3:11">pou jwenn sa ki glise anba tab,</para>
  <para style="q1" vid="MIC 3:11">e <note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JER 6:13">Jr 6:13</ref></char></note>prèt li yo enstwi pou kòb,</para>
  <para style="q1" vid="MIC 3:11">pandan pwofèt li yo ap pwofetize pou lajan.</para>
  <para style="q1" vid="MIC 3:11">Malgre sa, yo apiye sou SENYÈ a.</para>
  <para style="q1" vid="MIC 3:11">Yo di: “Se pa SENYÈ a ki nan mitan nou?</para>
  <para style="q1" vid="MIC 3:11">Okenn malè p ap rive sou nou.”<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />Konsa, akoz nou menm,</para>
  <para style="q1" vid="MIC 3:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="JER 26:18">Jr 26:18</ref>
      </char>
    </note>Sion va vin raboure tankou yon chan,</para>
  <para style="q1" vid="MIC 3:12">e <note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="PSA 79:1">Sòm 79:1</ref></char></note>Jérusalem va vin yon pil mazi,</para>
  <para style="q1" vid="MIC 3:12">e mòn tanp lan va devni</para>
  <para style="q1" vid="MIC 3:12">tankou wo plas yo nan forè a.<verse eid="MIC 3:12" /></para>
  <para style="b" />
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1" />Men nan dènye jou yo, li va vin rive ke mòn</para>
  <para style="q1" vid="MIC 4:1">a SENYÈ a va vin etabli kon chèf a mòn yo.</para>
  <para style="q1" vid="MIC 4:1">Li va vin leve anwo kolin yo, e pèp nasyon yo</para>
  <para style="q1" vid="MIC 4:1">va kouri kon dlo pou rive kote l.<note caller="+" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="ISA 2:2-4">És 2:2-4</ref>; <ref loc="PSA 22:27">Sòm 22:27</ref></char></note><verse eid="MIC 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 4:2" />Anpil nasyon va vin di:</para>
  <para style="q1" vid="MIC 4:2">“Vini, annou monte sou mòn SENYÈ a,</para>
  <para style="q1" vid="MIC 4:2">lakay Bondye Jacob la,</para>
  <para style="q1" vid="MIC 4:2">pou L ka enstwi nou nan chemen Li yo</para>
  <para style="q1" vid="MIC 4:2">e pou nou ka mache sou pa Li yo.”</para>
  <para style="q1" vid="MIC 4:2">Paske depi nan Sion, lalwa va sòti</para>
  <para style="q1" vid="MIC 4:2">e pawòl SENYÈ a va soti Jérusalem.<note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="ISA 2:3">És 2:3</ref>; <ref loc="PSA 25:8">Sòm 25:8</ref>,<ref loc="PSA 25:9">9</ref>,<ref loc="PSA 25:12">12</ref></char></note><verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />Konsa, Li va <note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="ISA 2:4">És 2:4</ref> </char></note>jije antre anpil pèp e pran</para>
  <para style="q1" vid="MIC 4:3">desizyon pou anpil nasyon ki byen lwen.</para>
  <para style="q1" vid="MIC 4:3">Yo va bat nepe yo pou fè yo tounen <note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="JOL 3:10">Jl 3:10</ref></char></note>cha</para>
  <para style="q1" vid="MIC 4:3">pou laboure latè yo,</para>
  <para style="q1" vid="MIC 4:3">ak lans lagè yo pou fè yo tounen kwòk imondaj.</para>
  <para style="q1" vid="MIC 4:3">Nasyon p ap leve nepe kont nasyon e</para>
  <para style="q1" vid="MIC 4:3">p ap aprann fè lagè ankò.<verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />Men yo va fè chak moun <note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="1KI 4:25">I Wa 4:25</ref>; <ref loc="LEV 26:6">Lev 26:6</ref> </char></note>chita anba chan</para>
  <para style="q1" vid="MIC 4:4">rezen pa yo, ak anba pye fig pa yo.</para>
  <para style="q1" vid="MIC 4:4">Pèsòn p ap fè yo pè:</para>
  <para style="q1" vid="MIC 4:4">paske bouch SENYÈ dèzame yo fin pale sa.<verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />Malgre tout pèp yo mache</para>
  <para style="q1" vid="MIC 4:5">nan non dye pa yo, pou nou menm,</para>
  <para style="q1" vid="MIC 4:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:5 </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 10:12">Za 10:12</ref>
      </char>
    </note>nou va mache nan non SENYÈ Bondye</para>
  <para style="q1" vid="MIC 4:5">nou an jis pou tout tan e pou tout tan.<verse eid="MIC 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6" />“Nan jou sa a”, deklare SENYÈ a,</para>
  <para style="q1" vid="MIC 4:6">“Mwen va <note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 147:2">Sòm 147:2</ref></char></note>rasanble moun bwate yo,</para>
  <para style="q1" vid="MIC 4:6">e Mwen va reyini moun rejte yo,</para>
  <para style="q1" vid="MIC 4:6">ak sa ke M te aflije yo.<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />Mwen va fè moun bwate yo</para>
  <para style="q1" vid="MIC 4:7">vin yon <note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="MIC 5:7">Mi 5:7</ref>,<ref loc="MIC 5:8">8</ref> </char></note>retay, e moun rejte yo</para>
  <para style="q1" vid="MIC 4:7">vin yon nasyon pwisan;</para>
  <para style="q1" vid="MIC 4:7">Konsa, <note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="ISA 24:23">És 24:23</ref></char></note>SENYÈ a va renye sou yo nan Mòn Sion</para>
  <para style="q1" vid="MIC 4:7">depi koulye a rive jis pou tout tan.”<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />A nou menm, <note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PSA 48:3">Sòm 48:3</ref>,<ref loc="PSA 48:12">12</ref> </char></note> wo tou bann mouton an,</para>
  <para style="q1" vid="MIC 4:8">mòn fi Sion an,</para>
  <para style="q1" vid="MIC 4:8">sou ou menm, li va retounen.</para>
  <para style="q1" vid="MIC 4:8">Wi, menm <note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="ISA 1:26">És 1:26</ref></char></note>ansyen pouvwa a,</para>
  <para style="q1" vid="MIC 4:8">wayòm nan de fi Jérusalem nan.<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />Alò, poukisa ou <note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="JER 8:19">Jr 8:19</ref> </char></note>rele anmwey konsa?</para>
  <para style="q1" vid="MIC 4:9">Èske pa gen wa pami nou?</para>
  <para style="q1" vid="MIC 4:9">Èske <note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="ISA 3:1-3">És 3:1-3</ref></char></note>konseye nou an fin peri?</para>
  <para style="q1" vid="MIC 4:9">Kite gwo doulè a sezi nou</para>
  <para style="q1" vid="MIC 4:9">kon yon fanm k ap pouse fè pitit?<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />Se pou ou vin an doulè,</para>
  <para style="q1" vid="MIC 4:10">doulè pou pouse fè pitit</para>
  <para style="q1" vid="MIC 4:10">fi a Sion an,</para>
  <para style="q1" vid="MIC 4:10">kon yon fanm ki ansent;</para>
  <para style="q1" vid="MIC 4:10">paske koulye a, ou va <note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="2KI 20:18">II Wa 20:18</ref> </char></note>sòti nan vil la</para>
  <para style="q1" vid="MIC 4:10">pou rete nan chan,</para>
  <para style="q1" vid="MIC 4:10">e ou va ale menm nan Babylone.</para>
  <para style="q1" vid="MIC 4:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:10 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 43:14">És 43:14</ref>
      </char>
    </note>La, ou va delivre.</para>
  <para style="q1" vid="MIC 4:10">La, SENYÈ a va rachte ou,</para>
  <para style="q1" vid="MIC 4:10">soti nan men ènmi ou yo.<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />Epi koulye a, gen <note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="ISA 5:25-30">És 5:25-30</ref></char></note>anpil nasyon</para>
  <para style="q1" vid="MIC 4:11">ki rasanble kont ou k ap di:</para>
  <para style="q1" vid="MIC 4:11">“Kite li fin souye nèt,</para>
  <para style="q1" vid="MIC 4:11">e kite zye nou wè dezi nou sou Sion.”<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />Men yo pa <note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="PSA 147:19">Sòm 147:19</ref>,<ref loc="PSA 147:20">20</ref></char></note>konnen refleksyon a SENYÈ a,</para>
  <para style="q1" vid="MIC 4:12">ni yo pa konprann bi Li a;</para>
  <para style="q1" vid="MIC 4:12">paske Li te ranmase moun sa yo,</para>
  <para style="q1" vid="MIC 4:12">kon pakèt sereyal yo,</para>
  <para style="q1" vid="MIC 4:12">pou pote sou glasi vannen an.<verse eid="MIC 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />Leve pou <note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="ISA 41:15">És 41:15</ref> </char></note>bat jèm nan, O fi Sion an!</para>
  <para style="q1" vid="MIC 4:13">Paske M ap fè kòn ou an vin yon kòn fè,</para>
  <para style="q1" vid="MIC 4:13">e zago ou kon yon zago an bwonz.</para>
  <para style="q1" vid="MIC 4:13">Ou va <note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JER 51:20-23">Jr 51:20-23</ref></char></note>bat an mòso anpil pèp,</para>
  <para style="q1" vid="MIC 4:13">pou ou kapab konsakre a SENYÈ a</para>
  <para style="q1" vid="MIC 4:13">tout richès enjis pa yo,</para>
  <para style="q1" vid="MIC 4:13">ke nou ranmase ak tout byen pa yo,</para>
  <para style="q1" vid="MIC 4:13">bay SENYÈ tout latè a.<verse eid="MIC 4:13" /></para>
  <para style="b" />
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 5:1" />Alò, rasanble nou an twoup lame,</para>
  <para style="q1" vid="MIC 5:1">O fi a lame yo.</para>
  <para style="q1" vid="MIC 5:1">Li fin fè syèj kont nou.</para>
  <para style="q1" vid="MIC 5:1">Ak gwo baton, yo va <note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="1KI 22:24">I Wa 22:24</ref></char></note>frape jij Israël la sou machwè.<verse eid="MIC 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />Men ou menm, Bethléhem Éphrata,</para>
  <para style="q1" vid="MIC 5:2">pi piti pami fanmi a Juda yo,</para>
  <para style="q1" vid="MIC 5:2">nan <note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="ISA 11:1">És 11:1</ref>; <ref loc="JER 30:21">Jr 30:21</ref></char></note>ou va soti de Mwen</para>
  <para style="q1" vid="MIC 5:2">Youn pou vin chèf an Israël.</para>
  <para style="q1" vid="MIC 5:2">Lè pou L vin parèt la te etabli depi</para>
  <para style="q1" vid="MIC 5:2">nan tan ansyen yo, jis rive nan jou etènite yo.<verse eid="MIC 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />Akoz sa, Li va <note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="HOS 11:8">Os 11:8</ref></char></note>abandone yo jiskaske</para>
  <para style="q1" vid="MIC 5:3">sila ki te gen doulè a, fin pouse fè pitit la.</para>
  <para style="q1" vid="MIC 5:3">Nan lè sa a, retay nan frè li yo</para>
  <para style="q1" vid="MIC 5:3">va retounen vin jwenn fis Israël yo.<verse eid="MIC 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />Konsa Li va leve pou mennen</para>
  <para style="q1" vid="MIC 5:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:4 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:11">És 40:11</ref> </char>
    </note> bann mouton Li an nan fòs SENYÈ a,</para>
  <para style="q1" vid="MIC 5:4">nan majeste a non SENYÈ, Bondye Li a.</para>
  <para style="q1" vid="MIC 5:4">Epi yo va viv, paske nan tan sa a,</para>
  <para style="q1" vid="MIC 5:4">Li va pwisan jis rive nan <note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="ISA 45:22">És 45:22</ref></char></note>dènye pwent latè.<verse eid="MIC 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />Li va lapè nou<note caller="+" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="ISA 9:6">És 9:6</ref>; <ref loc="ISA 8:7-8">És 8:7-8</ref></char></note> lè Asiryen yo vini nan peyi nou an,</para>
  <para style="q1" vid="MIC 5:5">e lè li va mache nan palè nou yo.</para>
  <para style="q1" vid="MIC 5:5">Konsa, nou va leve kont li sèt bèje ak uit chèf prensipal.<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />Yo va <note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="NAM 2:11-13">Na 2:11-13</ref> </char></note>regle peyi Assyrie ak nepe,</para>
  <para style="q1" vid="MIC 5:6">ak peyi Nimrod la menm nan pòtay li yo.</para>
  <para style="q1" vid="MIC 5:6">Konsa, li va <note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 14:25">És 14:25</ref></char></note>delivre nou soti nan men Asiryen an</para>
  <para style="q1" vid="MIC 5:6">lè l fè envazyon peyi nou an,</para>
  <para style="q1" vid="MIC 5:6">ak lè li mache anndan fwontyè nou an.<verse eid="MIC 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />Epi konsa, <note caller="+" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="MIC 2:12">Mi 2:12</ref></char></note>retay Jacob la va</para>
  <para style="q1" vid="MIC 5:7">nan mitan anpil nasyon pèp yo,</para>
  <para style="q1" vid="MIC 5:7">tankou lawouze ki sòti nan SENYÈ a,</para>
  <para style="q1" vid="MIC 5:7">tankou lapli k ap farinen sou zèb,</para>
  <para style="q1" vid="MIC 5:7">ki p ap tann lòm,</para>
  <para style="q1" vid="MIC 5:7">ni fè reta pou fis a lòm yo.<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />Retay Jacob la va pami nasyon yo,</para>
  <para style="q1" vid="MIC 5:8">pami anpil pèp;</para>
  <para style="q1" vid="MIC 5:8">Tankou yon lyon pami bèt forè,</para>
  <para style="q1" vid="MIC 5:8">tankou yon jèn lyon nan mitan bann mouton;</para>
  <para style="q1" vid="MIC 5:8">li menm, si l pase, mache, dechire an mòso</para>
  <para style="q1" vid="MIC 5:8">e <note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="GEN 49:9">Jen 49:9</ref>; <ref loc="PSA 50:22">Sòm 50:22</ref> </char></note>p ap gen pèsòn ki pou delivre.<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />Ke men ou vin <note caller="+" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="PSA 10:12">Sòm 10:12</ref></char></note>leve kont advèsè Ou yo</para>
  <para style="q1" vid="MIC 5:9">e lènmi Ou yo va vin koupe retire nèt.<verse eid="MIC 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 5:10" />“Li va rive, nan jou sa a,”, deklare SENYÈ a,</para>
  <para style="q1" vid="MIC 5:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:10 </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 9:10">Za 9:10</ref>
      </char>
    </note>“ke Mwen va retire cheval nou yo nan mitan nou</para>
  <para style="q1" vid="MIC 5:10">e Mwen va detwi cha lagè nou yo.<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />“Anplis, Mwen va koupe retire <note caller="+" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="ISA 1:7">És 1:7</ref></char></note>vil</para>
  <para style="q1" vid="MIC 5:11">nan peyi nou yo, e mwen va jete tout</para>
  <para style="q1" vid="MIC 5:11">miray fòterès nou yo.<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />Mwen va koupe retire zafè tout <note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="DEU 18:10-12">Det 18:10-12</ref></char></note>wanga</para>
  <para style="q1" vid="MIC 5:12">soti nan men nou, e nou p ap gen divinò ankò.<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:13 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 2:18">És 2:18</ref>
      </char>
    </note>Mwen va retire imaj taye nou yo ak</para>
  <para style="q1" vid="MIC 5:13">pilye sakre ki pami nou yo,</para>
  <para style="q1" vid="MIC 5:13">pou nou pa adore zèv men nou yo ankò.<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />Mwen va dechouke <note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="EXO 34:13">Egz 34:13</ref></char></note>Asherim ki pami nou yo,</para>
  <para style="q1" vid="MIC 5:14">e mwen va detwi vil nou yo.<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />Epi Mwen va <note caller="+" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="ISA 1:24">És 1:24</ref></char></note>egzekite vanjans kòlè</para>
  <para style="q1" vid="MIC 5:15">ak gwo mekontantman sou nasyon ki pa t koute yo.”<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />Koute koulye a sa ke SENYÈ a ap di:</para>
  <para style="q1" vid="MIC 6:1">“Leve, plede ka ou devan mòn yo;</para>
  <para style="q1" vid="MIC 6:1">kite kolin yo tande vwa ou.<verse eid="MIC 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />Koute, O mòn yo, pwosè vèbal SENYÈ a,</para>
  <para style="q1" vid="MIC 6:2">e ou menm, fondasyon latè ki dire tout tan yo.</para>
  <para style="q1" vid="MIC 6:2">Paske <note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="ISA 1:18">És 1:18</ref></char></note>SENYÈ a gen yon ka kont pèp Li a,</para>
  <para style="q1" vid="MIC 6:2">e Li va plede ka Li ak Israël.<verse eid="MIC 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />“Pèp Mwen, se kisa Mwen te fè Ou?</para>
  <para style="q1" vid="MIC 6:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:3 </char>
      <char style="xt" closed="false">
        <ref loc="JER 2:5">Jr 2:5</ref>; <ref loc="ISA 43:22">És 43:22</ref>,<ref loc="ISA 43:23">23</ref> </char>
    </note>Nan kisa Mwen te fatige ou?</para>
  <para style="q1" vid="MIC 6:3">Reponn Mwen!<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />Anverite Mwen te mennen nou</para>
  <para style="q1" vid="MIC 6:4">monte soti nan peyi Égypte.</para>
  <para style="q1" vid="MIC 6:4">Mwen te rachte ou soti nan kay esklavaj la.</para>
  <para style="q1" vid="MIC 6:4">Mwen te voye devan ou Moïse, Aaron ak Marie.”<note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="DEU 7:8">Det 7:8</ref>; <ref loc="EXO 4:10-16">Egz 4:10-16</ref> </char></note><verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />Pèp mwen, sonje koulye a konsèy</para>
  <para style="q1" vid="MIC 6:5">Balak, wa Moab la ak sa Balaam,</para>
  <para style="q1" vid="MIC 6:5">fis a Beor a, te reponn li depi</para>
  <para style="q1" vid="MIC 6:5">nan Sittim rive Guilgal,</para>
  <para style="q1" vid="MIC 6:5">pou nou ta ka konnen zèv ladwati a SENYÈ a.”<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:6-8">Sòm 40:6-8</ref>
      </char>
    </note>Avèk kisa mwen ta dwe vin parèt devan SENYÈ a,</para>
  <para style="q1" vid="MIC 6:6">e bese m ba devan Bondye anlè a?</para>
  <para style="q1" vid="MIC 6:6">Èske mwen ta vini ak ofrann brile,</para>
  <para style="q1" vid="MIC 6:6">ak ti bèf ki gen yon lane?<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />Èske SENYÈ a pran plezi nan <note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="PSA 50:9">Sòm 50:9</ref> </char></note> milye de belye yo?</para>
  <para style="q1" vid="MIC 6:7">Oswa nan dè di-milye de rivyè lwil yo?</para>
  <para style="q1" vid="MIC 6:7">Èske se <note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="LEV 18:21">Lev 18:21</ref></char></note>premye ne mwen an mwen dwe bay</para>
  <para style="q1" vid="MIC 6:7">pou zak rebelyon mwen yo?</para>
  <para style="q1" vid="MIC 6:7">Fwi a kò m pou peche nanm mwen an?<verse eid="MIC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />Li te montre ou, O lòm, sa ki bon.</para>
  <para style="q1" vid="MIC 6:8">Ki sa SENYÈ a egzije de ou?</para>
  <para style="q1" vid="MIC 6:8">Sèl pou <note caller="+" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="ISA 56:1">És 56:1</ref> </char></note>fè sa ki jis, renmen <note caller="+" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Os 6:6</ref></char></note>Mizerikòd,</para>
  <para style="q1" vid="MIC 6:8">e mache nan imilite ak Bondye ou a?<verse eid="MIC 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />Vwa SENYÈ a va rele vè vil la,</para>
  <para style="q1" vid="MIC 6:9">e sajès, li menm, fè lakrent non Ou.</para>
  <para style="q1" vid="MIC 6:9">“Koute baton an,</para>
  <para style="q1" vid="MIC 6:9">ak Sila ki te deziye l.<verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />Èske toujou gen trezò <note caller="+" style="x"><char style="xo" closed="false">6:10 </char><char style="xt" closed="false"><ref loc="JER 5:26">Jr 5:26</ref>,<ref loc="JER 5:27">27</ref></char></note>mechanste</para>
  <para style="q1" vid="MIC 6:10">lakay mechan an, ak yon mezi ki manke?</para>
  <para style="q1" vid="MIC 6:10">Ki se madichonnen?<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />Èske Mwen kapab tolere yon <note caller="+" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="LEV 19:36">Lev 19:36</ref></char></note> fo balans</para>
  <para style="q1" vid="MIC 6:11">ak yon sachè fo pèz?<verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />Paske moun rich li yo plen vyolans.</para>
  <para style="q1" vid="MIC 6:12">Rezidan li yo fè <note caller="+" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="JER 9:2-6">Jr 9:2-6</ref>,<ref loc="JER 9:8">8</ref> </char></note>manti,</para>
  <para style="q1" vid="MIC 6:12">e <note caller="+" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="ISA 3:8">És 3:8</ref></char></note>lang yo twonpe soti nan bouch yo.<verse eid="MIC 6:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />Konsa tou, Mwen te frape ou ak <note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="MIC 1:9">Mi 1:9</ref>; <ref loc="ISA 1:7">És 1:7</ref></char></note>yon blesi grav.</para>
  <para style="q1" vid="MIC 6:13">Mwen te fè ou vin dezole akoz peche ou yo.<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />Ou va manje, men ou <note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="ISA 9:20">És 9:20</ref> </char></note>p ap satisfè.</para>
  <para style="q1" vid="MIC 6:14">Imilyasyon ou va nan mitan ou.</para>
  <para style="q1" vid="MIC 6:14">Ou va vin mete sou kote,</para>
  <para style="q1" vid="MIC 6:14">men ou p ap <note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="ISA 30:6">És 30:6</ref></char></note>konsève,</para>
  <para style="q1" vid="MIC 6:14">e sa ke ou t ap rezève a,</para>
  <para style="q1" vid="MIC 6:14">Mwen va bay li a nepe.<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />Ou va simen, men ou p ap rekòlte.</para>
  <para style="q1" vid="MIC 6:15">Ou va kraze grenn oliv anba pye,</para>
  <para style="q1" vid="MIC 6:15">men ou menm p ap onksyone ak lwil;</para>
  <para style="q1" vid="MIC 6:15">kraze rezen, men ou p ap bwè diven an.<note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="DEU 28:38-40">Det 28:38-40</ref>; <ref loc="AMO 5:11">Am 5:11</ref></char></note><verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />Paske se règleman <note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="1KI 16:25">I Wa 16:25</ref>,<ref loc="1KI 16:26">26</ref> </char></note>Omri yo nou kenbe,</para>
  <para style="q1" vid="MIC 6:16">ak tout zèv lakay Achab yo nou obsève,</para>
  <para style="q1" vid="MIC 6:16">e se nan konsèy yo ke nou <note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="JER 7:24">Jr 7:24</ref></char></note>mache.</para>
  <para style="q1" vid="MIC 6:16">Akoz sa, Mwen va fè ou vin detwi nèt.</para>
  <para style="q1" vid="MIC 6:16">Pèp ou a va giyonnen,</para>
  <para style="q1" vid="MIC 6:16">e ou va sipòte repwòch a pèp Mwen an.”<verse eid="MIC 6:16" /></para>
  <para style="b" />
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 7:1" />Malè a mwen menm!</para>
  <para style="q1" vid="MIC 7:1">Anverite, mwen tankou moun</para>
  <para style="q1" vid="MIC 7:1">k ap ranmase fwi gran sezon,</para>
  <para style="q1" vid="MIC 7:1">k ap rasanble retay rezen yo lè yo fin retire diven.</para>
  <para style="q1" vid="MIC 7:1">Pa gen grap rezen pou manje,</para>
  <para style="q1" vid="MIC 7:1">ni yon grenn <note caller="+" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="ISA 28:4">És 28:4</ref></char></note>premye fwi fig etranje pou m ta anvi goute.<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />Moun fidèl <note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="ISA 57:1">És 57:1</ref> </char></note>fin disparèt sou latè a,</para>
  <para style="q1" vid="MIC 7:2">e nanpwen moun dwat pami lòm.</para>
  <para style="q1" vid="MIC 7:2">Yo tout kouche an anbiskad pou <note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="ISA 59:7">És 59:7</ref></char></note>vèse san;</para>
  <para style="q1" vid="MIC 7:2">yo tout fè lachas dèyè frè yo ak pèlen.<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />Toude men yo sou sa ki mal la pou fè l <note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="PRO 4:16">Pwov 4:16</ref>,<ref loc="PRO 4:17">17</ref> </char></note>byen.</para>
  <para style="q1" vid="MIC 7:3">Prens lan mande, e jij la prè pou yon <note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="AMO 5:12">Am 5:12</ref></char></note>glise anba tab.</para>
  <para style="q1" vid="MIC 7:3">Yon nonm pwisan prezante tout mechanste</para>
  <para style="q1" vid="MIC 7:3">ke nanm li bezwen.</para>
  <para style="q1" vid="MIC 7:3">Konsa yo trese l pou fè l vin yon sèl.<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />Pi bon nan yo se pikan.</para>
  <para style="q1" vid="MIC 7:4">Pi dwat la pi mal pase kloti zepin.</para>
  <para style="q1" vid="MIC 7:4">Jou gadyen ou,</para>
  <para style="q1" vid="MIC 7:4">jou <note caller="+" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="ISA 10:3">És 10:3</ref></char></note>vizitasyon ou an fin rive.</para>
  <para style="q1" vid="MIC 7:4">Koulye a y ap <note caller="+" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="ISA 22:5">És 22:5</ref> </char></note>boulvèse, egare nèt.<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />Pa <note caller="+" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="JER 9:4">Jr 9:4</ref></char></note>fè konfyans ak yon vwazen.</para>
  <para style="q1" vid="MIC 7:5">Pa fè konfyans ak yon zanmi.</para>
  <para style="q1" vid="MIC 7:5">Ak fi la k ap kouche ak ou a,</para>
  <para style="q1" vid="MIC 7:5">gade pòt bouch ou!<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />Paske <note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="MAT 10:21">Mat 10:21</ref>,<ref loc="MAT 10:25">25</ref></char></note>fis la derespekte papa a,</para>
  <para style="q1" vid="MIC 7:6">e fi a leve kont manman li,</para>
  <para style="q1" vid="MIC 7:6">bèlfi a kont bèlmè li;</para>
  <para style="q1" vid="MIC 7:6">lènmi a yon nonm se anndan lakay li.<verse eid="MIC 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />Men pou mwen menm,</para>
  <para style="q1" vid="MIC 7:7">mwen va <note caller="+" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="HAB 2:1">Hab 2:1</ref> </char></note>gade vè SENYÈ a.</para>
  <para style="q1" vid="MIC 7:7">Mwen va <note caller="+" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="PSA 130:5">Sòm 130:5</ref></char></note>tann Bondye a sali mwen an.</para>
  <para style="q1" vid="MIC 7:7">Bondye mwen an va koute mwen.<verse eid="MIC 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:8 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:17">Pwov 24:17</ref>
      </char>
    </note>Pa rejwi nou kont mwen menm, O lènmi mwen.</para>
  <para style="q1" vid="MIC 7:8">Malgre mwen tonbe, mwen va leve ankò.</para>
  <para style="q1" vid="MIC 7:8">Malgre mwen chita nan tenèb,</para>
  <para style="q1" vid="MIC 7:8">SENYÈ a va yon <note caller="+" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="ISA 9:2">És 9:2</ref> </char></note>limyè pou mwen.<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />Mwen va pote endiyasyon SENYÈ a,</para>
  <para style="q1" vid="MIC 7:9">akoz mwen te peche kont Li,</para>
  <para style="q1" vid="MIC 7:9">jiskaske li <note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="JER 50:34">Jr 50:34</ref></char></note>plede ka mwen an,</para>
  <para style="q1" vid="MIC 7:9">e egzekite jijman pou mwen.</para>
  <para style="q1" vid="MIC 7:9">Konsa, Li va mennen m sòti nan plen limyè,</para>
  <para style="q1" vid="MIC 7:9">e mwen va wè ladwati Li.<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />Answit, lènmi m va wè sa,</para>
  <para style="q1" vid="MIC 7:10">e gwo wont va kouvri fi la ki te di m:</para>
  <para style="q1" vid="MIC 7:10">“Kote SENYÈ Bondye ou a?”</para>
  <para style="q1" vid="MIC 7:10">Zye m va gade fi sa a.</para>
  <para style="q1" vid="MIC 7:10">Epi konsa, nan lè sa a, li va</para>
  <para style="q1" vid="MIC 7:10">vin foule anba pye tankou kras labou nan lari.<note caller="+" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="ISA 51:23">És 51:23</ref></char></note><verse eid="MIC 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />Sa va yon jou pou <note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="ISA 54:11">És 54:11</ref></char></note>bati miray ou yo.</para>
  <para style="q1" vid="MIC 7:11">Nan jou sa a, lizyè ou yo va vin grandi.<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />Sa va yon jou ke yo va <note caller="+" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="ISA 19:23-25">És 19:23-25</ref></char></note>vin kote ou</para>
  <para style="q1" vid="MIC 7:12">soti Assyrie ak vil Égypte yo;</para>
  <para style="q1" vid="MIC 7:12">soti Égypte menm pou rive Rivyè Euphrate la,</para>
  <para style="q1" vid="MIC 7:12">menm soti nan lanmè,</para>
  <para style="q1" vid="MIC 7:12">rive nan lanmè,</para>
  <para style="q1" vid="MIC 7:12">nan mòn rive nan mòn.<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />Malgre, latè va vin <note caller="+" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="JER 25:11">Jr 25:11</ref></char></note>dezole</para>
  <para style="q1" vid="MIC 7:13">akoz sila k ap viv ladann yo,</para>
  <para style="q1" vid="MIC 7:13">akoz fwi a zak yo.<verse eid="MIC 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:7">Sòm 95:7</ref>
      </char>
    </note>Mennen pèp Ou a ak kwòk beje Ou a,</para>
  <para style="q1" vid="MIC 7:14">bann mouton a eritaj Ou a,</para>
  <para style="q1" vid="MIC 7:14">ki rete pou kont yo, nan forè.</para>
  <para style="q1" vid="MIC 7:14">Kite yo manje nan mitan bon pa,</para>
  <para style="q1" vid="MIC 7:14">nan Basan ak Galaad, <note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="AMO 9:11">Am 9:11</ref> </char></note>tankou nan ansyen tan an.<verse eid="MIC 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />“Tankou nan jou lè ou te sòti nan peyi Égypte la,</para>
  <para style="q1" vid="MIC 7:15">Mwen va montre ou <note caller="+" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="EXO 3:20">Egz 3:20</ref> </char></note>Mirak.”<verse eid="MIC 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />Nasyon yo <note caller="+" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="ISA 26:11">És 26:11</ref> </char></note>va wè,</para>
  <para style="q1" vid="MIC 7:16">e yo va wont de tout pwisans yo.</para>
  <para style="q1" vid="MIC 7:16">Yo va <note caller="+" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="MIC 3:7">Mi 3:7</ref></char></note>mete men yo sou bouch yo;</para>
  <para style="q1" vid="MIC 7:16">zòrèy yo va vin soud.<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />Yo va niche pousyè tankou sèpan.</para>
  <para style="q1" vid="MIC 7:17">Tankou bagay k ap ranpe sou latè,</para>
  <para style="q1" vid="MIC 7:17">yo va sòti <note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 18:45">Sòm 18:45</ref> </char></note>tou ap tranble nan sitadèl souteren yo.</para>
  <para style="q1" vid="MIC 7:17">Yo va vin vè SENYÈ Bondye nou an, ak <note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="ISA 25:3">És 25:3</ref></char></note>gwo lakrent;</para>
  <para style="q1" vid="MIC 7:17">konsa, yo va pè devan Ou.<verse eid="MIC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />Se kilès ki yon Bondye tankou Ou,</para>
  <para style="q1" vid="MIC 7:18">ki <note caller="+" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="EXO 34:7">Egz 34:7</ref>,<ref loc="EXO 34:9">9</ref> </char></note>padone inikite,</para>
  <para style="q1" vid="MIC 7:18">e ki bliye zak rebèl a retay pèp eritaj li?</para>
  <para style="q1" vid="MIC 7:18">Li pa <note caller="+" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="PSA 103:8">Sòm 103:8</ref>,<ref loc="PSA 103:9">9</ref>,<ref loc="PSA 103:13">13</ref></char></note>kenbe kòlè li pou tout tan an,</para>
  <para style="q1" vid="MIC 7:18">akoz Li pran plezi nan lanmou dous Li.<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />Li va gen konpasyon pou nou ankò.</para>
  <para style="q1" vid="MIC 7:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">7:19 </char>
      <char style="xt" closed="false">
        <ref loc="JER 50:20">Jr 50:20</ref>
      </char>
    </note>Li va foule inikite nou yo anba pye L.</para>
  <para style="q1" vid="MIC 7:19">Wi, Ou va <note caller="+" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="ISA 38:17">És 38:17</ref> </char></note>jete tout peche yo nan fon lanmè.<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />Ou va bay <note caller="+" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="GEN 24:27">Jen 24:27</ref></char></note>verite a Jacob</para>
  <para style="q1" vid="MIC 7:20">ak mizerikòd a Abraham,</para>
  <para style="q1" vid="MIC 7:20">tankou Ou te sèmante a papa zansèt nou yo</para>
  <para style="q1" vid="MIC 7:20">depi nan jou ansyen yo.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>