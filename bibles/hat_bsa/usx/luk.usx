<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">LUK</book>
  <para style="h">Luc</para>
  <para style="toc1">LEVANJIL SELON LUC</para>
  <para style="toc2">Luc</para>
  <para style="toc3">Luc</para>
  <para style="mt1">LEVANJIL SELON LUC</para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>Akoz gen anpil moun ki deja antreprann pou rasanble yon listwa de bagay ki te <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ROM 4:21">Wo 4:21</ref></char></note>fèt pami nou yo, <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>jis jan ke yo te lonje bay a nou menm pa men a sila yo, ki <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JHN 15:27">Jn 15:27</ref></char></note>depi nan kòmansman an te wè avèk <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2PE 1:16">II Pi 1:16</ref></char></note>pwòp zye yo, e kon sèvitè a pawòl la, te fè nou konnen yo. <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>Sa te sanble bon pou mwen tou, akoz ke m te fè yon ankèt konplè depi nan kòmansman an, pou m ekri sa pou nou ta byen konprann jan li te rive a, <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ACT 23:26">Trav 23:26</ref></char></note>chè ekselans Théophile. <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>Konsa, ou ta kapab konnen verite egzakt la, selon bagay ke ou te <note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="ACT 18:25">Trav 18:25</ref></char></note>enstwi yo.<verse eid="LUK 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>Nan jou Hérode yo, wa Juda a, te gen yon sèten prèt ki te rele Zacharie nan <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="1CH 24:10">I Kwo 24:10</ref></char></note>divizyon Abijah. Li te gen yon madanm ki soti nan fi Aaron yo, yo te rele Elizabeth. <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>Yo te toude jis devan zye Bondye. Yo te mache <note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="PHP 2:15">Fil 2:15</ref></char></note>san fot nan tout kòmandman ak devwa Senyè a. <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>Men yo pa t gen pitit, akoz Elizabeth te esteril, e yo toude te avanse nan laj.<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>Alò, li vin rive ke pandan <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="1CH 24:19">I Kwo 24:19</ref></char></note>li t ap fè sèvis prèt la devan Bondye nan pwòp tan divizyon pa l, <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>selon koutim nan pozisyon li kon prèt, li te chwazi pa tiraj osò pou <note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="EXO 30:7">Egz 30:7</ref></char></note>antre nan tanp Senyè a pou brile lansan. <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>Tout foul pèp la t ap priye <note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="LEV 16:17">Lev 16:17</ref></char></note>deyò a nan lè ofrann lansan an.<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="LUK 2:9">Luc 2:9</ref></char></note>yon zanj Bondye te parèt kote li, e te kanpe adwat lotèl lansan an. <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>Zacharie te twouble lè l te wè li, e<note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="LUK 2:9">Luc 2:9</ref></char></note>lakrent te sezi li.<verse eid="LUK 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 1:13"/>Men zanj lan te di l: “Ou pa bezwen pè, Zacharie, paske sa ou te mande a, tande nan syèl la, e madanm ou, Elizabeth, va fè yon fis pou ou, e <note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="LUK 1:6-63">Luc 1:6-63</ref></char></note>ou va nonmen li Jean. <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>Ou va gen lajwa avèk kè kontan, e anpil moun va rejwi nan nesans li.<verse eid="LUK 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 1:15"/>“Paske li va gran nan zye Bondye. Li p ap <note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="NUM 6:3">Nonb 6:3</ref></char></note>bwè ni diven, ni gwòg; e li va ranpli avèk Lespri Sen an menm lè l toujou nan vant. <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>Li va fè anpil moun nan fis Israël yo <note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat 3:2</ref>,<ref loc="MAT 3:6">6</ref></char></note>retounen a Senyè a, Bondye yo a. <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>Se li ki va ale devan Li menm, nan lespri avèk pouvwa Élie a, <note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAL 4:6">Mal 4:6</ref></char></note>pou fè kè a papa yo retounen a zanfan yo, e dezobeyisan yo a yon lespri ladwati; pou fè prepare yon pèp pou Bondye.”<verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>Zacharie te di a zanj lan: “Kijan m ap fè konnen sa? Paske <note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="GEN 17:17">Jen 17:17</ref></char></note>mwen menm se yon granmoun, e madanm mwen avanse nan laj.”<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>Zanj lan te reponn li e te di: “Mwen se <note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="DAN 8:16">Dan 8:16</ref></char></note>Gabriel, ki kanpe nan prezans Bondye a. Mwen te voye pou pale ak ou, e pou pote bòn nouvèl sila a. <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>Konsa, gade. Ou va rete an silans nèt, e ou p ap kapab pale jiskaske bagay sa yo rive, paske ou pa t kwè pawòl mwen, ki va akonpli nan pwòp lè pa l la.”<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>Pèp la t ap tann Zacharie, e yo te etone pa reta ke li te fè nan tanp lan. <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>Men lè l parèt li pa t kapab pale avèk yo. Konsa, yo te vin konprann ke se te yon vizyon ke li te fè nan tanp lan. Li te <note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="LUK 1:62">Luc 1:62</ref></char></note>kontinye fè sign bay yo, e te rete bèbè.<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>Lè jou a sèvis li kon prèt te fini, li te retounen lakay li. <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>Apre jou sa yo, Elizabeth te vin ansent. Li te kache pandan senk mwa, e te di: <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>“Se konsa ke Senyè a aji avè m nan jou ke Li te voye gras Li sou mwen, e Li te <note caller="+" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="GEN 30:23">Jen 30:23</ref></char></note>retire wont mwen pami lèzòm”.<verse eid="LUK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>Alò, nan sizyèm mwa ansent Elizabeth la, zanj Gabriel la te voye sòti nan Bondye a yon vil nan Galilée ki te rele <note caller="+" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="MAT 2:23">Mat 2:23</ref></char></note>Nazareth, <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>a yon vyèj ki te fiyanse a yon nonm ki te rele Joseph, ki te sòti nan <note caller="+" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 1:16-20">Mat 1:16-20</ref></char></note>desandan David yo. Vyèj la te rele Marie. <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>Lè l te antre, li te di li: “Sali a ou menm ki twouve favè! Bondye se avèk ou. Ou beni pami fanm yo!”<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>Men Marie <note caller="+" style="x"><char style="xo" closed="false">1:29 </char><char style="xt" closed="false"><ref loc="LUK 1:12">Luc 1:12</ref></char></note>te twouble anpil pa pawòl sa a, e li t ap reflechi sou ki kalite salitasyon sa a te ye.<verse eid="LUK 1:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 1:30"/>Konsa zanj lan te di l: <note caller="+" style="x"><char style="xo" closed="false">1:30 </char><char style="xt" closed="false"><ref loc="MAT 14:27">Mat 14:27</ref></char></note>“Ou pa bezwen krent, Marie, paske ou gen tan twouve favè ak Bondye. <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>Gade byen, ou va vin ansent. Ou va fè yon fis, e ou <note caller="+" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="ISA 7:14">És 7:14</ref></char></note>va bay li non a Jésus. <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>Li va gran e Li va rele Fis a <note caller="+" style="x"><char style="xo" closed="false">1:32 </char><char style="xt" closed="false"><ref loc="MRK 5:7">Mc 5:7</ref></char></note>Pi Wo a; epi Senyè Bondye a va bay Li <note caller="+" style="x"><char style="xo" closed="false">1:32 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">II Sam 7:12-16</ref></char></note>twòn a zansèt Li a, David. <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>Li va renye sou lakay Jacob pou tout tan, <note caller="+" style="x"><char style="xo" closed="false">1:33 </char><char style="xt" closed="false"><ref loc="2SA 7:13-16">II Sam 7:13-16</ref></char></note>e wayòm Li an p ap janm fini.”<verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>Marie te di a zanj lan: “Kijan bagay sa a kapab ye, paske mwen menm se yon vyèj?”<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>Zanj lan te reponn. Li te di li: “Lespri Sen an va vini sou ou, e pwisans a Pi Wo a va kouvri ou avèk lonbraj Li. Pou rezon sa a, pitit sen sa a va rele Fis a Bondye. <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>Epi veye byen, menm nan fanmi ou Elizabeth anplis gen tan vin ansent avèk yon fis nan vyeyès li, e li menm ki te rele esteril, koulye a, nan sizyèm mwa li. <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>Paske <note caller="+" style="x"><char style="xo" closed="false">1:37 </char><char style="xt" closed="false"><ref loc="GEN 18:4">Jen 18:4</ref></char></note>anyen pa enposib avèk Bondye.”<verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>Marie te di li: “Men gade, sèvant-dedike a Senyè a; kite sa fèt sou mwen selon pawòl ou.” Konsa, zanj lan te kite li.<verse eid="LUK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>Alò, nan moman sa a, Marie te leve. Li te sòti byen vit pou rive nan peyi kolin yo, nan yon <note caller="+" style="x"><char style="xo" closed="false">1:39 </char><char style="xt" closed="false"><ref loc="JOS 20:7">Jos 20:7</ref></char></note>vil yo rele Juda. <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>Li te antre lakay a Zacharie, e te salye Elizabeth.<verse eid="LUK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 1:41"/>Li te rive ke lè Elizabeth te tande salitasyon Marie a, pitit la te sote nan vant li, epi Elizabeth te <note caller="+" style="x"><char style="xo" closed="false">1:41 </char><char style="xt" closed="false"><ref loc="LUK 1:67">Luc 1:67</ref></char></note>ranpli avèk Lespri Sen an. <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>Li te kriye fò avèk yon gran vwa e te di: “Beni se ou pami fanm yo, e beni se fwi a vant ou an! <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>Kijan bagay sa a rive m, ke manman <note caller="+" style="x"><char style="xo" closed="false">1:43 </char><char style="xt" closed="false"><ref loc="LUK 2:11">Luc 2:11</ref></char></note>Senyè mwen an ta vin kote mwen? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>Paske gade byen, lè son a salitasyon ou an te rive nan zòrèy mwen, pitit la te sote nan vant mwen avèk jwa. <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/><note caller="+" style="x"><char style="xo" closed="false">1:45 </char><char style="xt" closed="false"><ref loc="LUK 1:20-48">Luc 1:20-48</ref></char></note>Beni se sila a ki te kwè ke sa Senyè a te pale a ta vin akonpli.”<verse eid="LUK 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46"/>Marie te di:</para>
  <para style="q1" vid="LUK 1:46">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:46 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:1-10">I Sam 2:1-10</ref>
      </char>
    </note>“Nanm mwen <note caller="+" style="x"><char style="xo" closed="false">1:46 </char><char style="xt" closed="false"><ref loc="PSA 34:21">Sòm 34:21</ref></char></note>egzalte Senyè a,<verse eid="LUK 1:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LUK 1:47"/>Lespri <note caller="+" style="x"><char style="xo" closed="false">1:47 </char><char style="xt" closed="false"><ref loc="PSA 35:9">Sòm 35:9</ref></char></note>mwen gen tan rejwi nan Bondye, Sovè mwen an.<verse eid="LUK 1:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48"/>Paske li te gade <note caller="+" style="x"><char style="xo" closed="false">1:48 </char><char style="xt" closed="false"><ref loc="PSA 138:6">Sòm 138:6</ref></char></note>eta ba sèvant Li an;</para>
  <para style="q1" vid="LUK 1:48">paske gade byen, soti nan moman sa a</para>
  <para style="q1" vid="LUK 1:48">jiska tout jenerasyon yo, yo va rele m beni.<verse eid="LUK 1:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49"/>Paske Toupwisan an</para>
  <para style="q1" vid="LUK 1:49">te fè gwo bagay pou mwen.</para>
  <para style="q1" vid="LUK 1:49">Non Li sen.<verse eid="LUK 1:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:50 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:17">Sòm 103:17</ref>
      </char>
    </note>Epi mizerikòd Li sou jenerasyon</para>
  <para style="q1" vid="LUK 1:50">apre jenerasyon vè sila ki krent Li yo.<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:51 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 98:1">Sòm 98:1</ref>
      </char>
    </note>Li fè zèv pwisan yo avèk bra Li.</para>
  <para style="q1" vid="LUK 1:51">Li te gaye sila avèk panse ògèy nan kè yo.<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>Li rale fè desann chèf yo sou twòn yo,</para>
  <para style="q1" vid="LUK 1:52">e Li <note caller="+" style="x"><char style="xo" closed="false">1:52 </char><char style="xt" closed="false"><ref loc="JOB 5:11">Job 5:11</ref></char></note>egzalte sila ki enb yo.<verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:53 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:9">Sòm 107:9</ref>
      </char>
    </note>Li ranpli sila ki grangou yo avèk bon bagay;</para>
  <para style="q1" vid="LUK 1:53">e Li voye rich yo ale avèk men vid.<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54"/>Li bay sekou a Israël, sèvitè Li a,</para>
  <para style="q1" vid="LUK 1:54">kon yon sonj mizerikòd Li,<verse eid="LUK 1:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55"/>jan Li te pale a zansèt nou yo,</para>
  <para style="q1" vid="LUK 1:55">a <note caller="+" style="x"><char style="xo" closed="false">1:55 </char><char style="xt" closed="false"><ref loc="GEN 17:7">Jen 17:7</ref></char></note>Abraham avèk jenerasyon Li yo</para>
  <para style="q1" vid="LUK 1:55">jis pou tout tan”.<verse eid="LUK 1:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>Marie te rete avèk li pandan anviwon twa mwa, e te retounen lakay li. <verse eid="LUK 1:56"/><verse number="57" style="v" sid="LUK 1:57"/>Alò, lè te rive pou Elizabeth akouche, e li te fè yon fis. <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>Vwazen li yo avèk fanmi li yo te tande ke Senyè a te <note caller="+" style="x"><char style="xo" closed="false">1:58 </char><char style="xt" closed="false"><ref loc="GEN 19:19">Jen 19:19</ref></char></note>montre mizerikòd Li, e yo t ap rejwi avèk li. <verse eid="LUK 1:58"/><verse number="59" style="v" sid="LUK 1:59"/>Li te vin rive ke nan <note caller="+" style="x"><char style="xo" closed="false">1:59 </char><char style="xt" closed="false"><ref loc="GEN 17:12">Jen 17:12</ref></char></note>uityèm jou a, yo te vini pou sikonsi pitit la, e yo t ap rele li Zacharie, non a papa li. <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>Men manman li te reponn e te di: “Non anverite, men <note caller="+" style="x"><char style="xo" closed="false">1:60 </char><char style="xt" closed="false"><ref loc="LUK 1:13-63">Luc 1:13-63</ref></char></note>l ap rele Jean.” <verse eid="LUK 1:60"/><verse number="61" style="v" sid="LUK 1:61"/>Yo te di li: “Nanpwen pèsòn pami fanmi ou ki rele pa non sa a.” <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>Konsa, yo te <note caller="+" style="x"><char style="xo" closed="false">1:62 </char><char style="xt" closed="false"><ref loc="LUK 1:22">Luc 1:22</ref></char></note>fè sign a papa a, pou konnen ki non li te vle bay li. <verse eid="LUK 1:62"/><verse number="63" style="v" sid="LUK 1:63"/>Li te mande yon tablo, e te ekri konsa: <note caller="+" style="x"><char style="xo" closed="false">1:63 </char><char style="xt" closed="false"><ref loc="LUK 1:13-60">Luc 1:13-60</ref></char></note>“Non li se Jean”. Yo tout te etone. <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/><note caller="+" style="x"><char style="xo" closed="false">1:64 </char><char style="xt" closed="false"><ref loc="LUK 1:20">Luc 1:20</ref></char></note>Konsa, nan yon sèl kou bouch li te louvri, lang li te vin lache e li te kòmanse pale e bay glwa a Bondye. <verse eid="LUK 1:64"/><verse number="65" style="v" sid="LUK 1:65"/>Lakrent te vin tonbe sou tout sila yo ki te rete nan landwa sila a; epi tout bagay sa yo te pale nan tout <note caller="+" style="x"><char style="xo" closed="false">1:65 </char><char style="xt" closed="false"><ref loc="LUK 1:39">Luc 1:39</ref></char></note>peyi kolin a Juda yo. <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>Tout sila ki te tande koze sa yo te <note caller="+" style="x"><char style="xo" closed="false">1:66 </char><char style="xt" closed="false"><ref loc="ACT 11:21">Trav 11:21</ref></char></note>sonje sa, e te toujou mande: “Alò, kisa nou sipoze pitit sa a va devni?” Paske men Senyè a te vrèman sou li.<verse eid="LUK 1:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>Papa li, Zacharie, <note caller="+" style="x"><char style="xo" closed="false">1:67 </char><char style="xt" closed="false"><ref loc="LUK 1:41">Luc 1:41</ref></char></note>ranpli avèk Lespri Sen an, te pwofetize. Li te di:<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>Beni se Senyè a, Bondye Israël la,</para>
  <para style="q1" vid="LUK 1:68">paske li vizite nou,</para>
  <para style="q1" vid="LUK 1:68">Li te acheve <note caller="+" style="x"><char style="xo" closed="false">1:68 </char><char style="xt" closed="false"><ref loc="LUK 2:38">Luc 2:38</ref></char></note>redanmsyon pou pèp Li a.<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69"/>Li te leve yon <note caller="+" style="x"><char style="xo" closed="false">1:69 </char><char style="xt" closed="false"><ref loc="1SA 2:1-10">I Sam 2:1-10</ref></char></note>kòn sali pou nou</para>
  <para style="q1" vid="LUK 1:69">lakay David la, sèvitè Li a.<verse eid="LUK 1:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:70 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:2">Wo 1:2</ref>
      </char>
    </note>Jan Li te pale pa bouch a pwofèt Li yo depi nan ansyen tan an,<verse eid="LUK 1:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>Delivrans sou <note caller="+" style="x"><char style="xo" closed="false">1:71 </char><char style="xt" closed="false"><ref loc="PSA 106:10">Sòm 106:10</ref></char></note>lènmi nou yo,</para>
  <para style="q1" vid="LUK 1:71">ak nan men a tout sila ki rayi nou yo;<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>pou montre mizerikòd vè zansèt nou yo,</para>
  <para style="q1" vid="LUK 1:72">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:72 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:8-42">Sòm 105:8-42</ref>
      </char>
    </note>e pou sonje akò sen Li an,<verse eid="LUK 1:72"/></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:73 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 22:16">Jen 22:16</ref>
      </char>
    </note>Sèman ke Li te fè a Abraham, zansèt nou an,<verse eid="LUK 1:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74"/>pou pèmèt ke nou menm,</para>
  <para style="q1" vid="LUK 1:74">ki te delivre nan men lènmi nou yo,</para>
  <para style="q1" vid="LUK 1:74">ta kapab sèvi Li san krent,<verse eid="LUK 1:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:75 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:24">Ef 4:24</ref>
      </char>
    </note>nan sentete ak ladwati devan Li,</para>
  <para style="q1" vid="LUK 1:75">pandan tout jou nou yo.<verse eid="LUK 1:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>Epi ou menm pitit, ou va rele</para>
  <para style="q1" vid="LUK 1:76">pwofèt a Pi Wo a;</para>
  <para style="q1" vid="LUK 1:76">paske ou va ale <note caller="+" style="x"><char style="xo" closed="false">1:76 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3:1</ref></char></note>devan Senyè a,</para>
  <para style="q1" vid="LUK 1:76">pou prepare chemen Li an;<verse eid="LUK 1:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77"/>pou bay pèp Li a konesans a sali a,</para>
  <para style="q1" vid="LUK 1:77">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:77 </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:34">Jr 31:34</ref>
      </char>
    </note>pou padon peche pa yo.<verse eid="LUK 1:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78"/>Akoz de mizerikòd byen dous a Bondye nou an,</para>
  <para style="q1" vid="LUK 1:78">
    <note caller="+" style="x">
      <char style="xo" closed="false">1:78 </char>
      <char style="xt" closed="false">
        <ref loc="MAL 4:2">Mal 4:2</ref>
      </char>
    </note>k ap fè Solèy ki leve soti anwo a vin vizite nou.<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:79 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 9:2">És 9:2</ref>
      </char>
    </note>Pou briye sou sila ki chita nan tenèb yo</para>
  <para style="q1" vid="LUK 1:79">ak nan lonbraj lanmò a,</para>
  <para style="q1" vid="LUK 1:79">pou gide pye nou nan chemen lapè a.<verse eid="LUK 1:79"/></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:80 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 2:40">Luc 2:40</ref>
      </char>
    </note>Pitit la te kontinye grandi, e te vin fò nan lespri. Konsa, li te viv nan dezè yo jis jou li te parèt piblikman an Israël.<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>Alò, li te rive nan jou sa yo ke yon dekrè te sòti nan <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="MAT 22:17">Mat 22:17</ref></char></note>César Auguste, ke yon <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="MAT 4:24">Mat 4:24</ref></char></note>resansman global ta vin fèt pou tout mond lan kote moun rete. <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>Sa se te premye resansman global ki te fèt pandan Quirinius te gouvènè a Syrie. <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>Tout moun te kòmanse anrejistre pou resansman an, chak moun nan pwòp vil pa li.<verse eid="LUK 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4"/>Anplis, Joseph te monte kite Galilée nan vil Nazareth la, pou rive nan Juda, vil David, ke yo rele Bethléhem nan, akoz ke <note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="LUK 1:27">Luc 1:27</ref></char></note>li te sòti nan kay ak fanmi a David, <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>pou l ta kapab anrejistre ansanm avèk Marie, ki te fiyanse li, e ki te ansent.<verse eid="LUK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 2:6"/>Li te vin rive ke pandan yo te la, jou yo te vin rive pou l akouche. <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>Li te <note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="MAT 1:25">Mat 1:25</ref></char></note>bay nesans a premye fis li, epi li te vlope Li nan twal pou nouvo ne yo. Li te mete Li nan yon manjwa, akoz ke pa t gen plas pou Li nan otèl la.<verse eid="LUK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>Nan menm andwa a, te gen bèje deyò nan chan an ki t ap okipe bann mouton yo pandan nwit lan.<verse eid="LUK 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 2:9"/>Konsa yon <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="LUK 1:11">Luc 1:11</ref></char></note>zanj Bondye te vin kanpe sibitman devan yo, epi glwa a Bondye te klere toutotou de yo; e yo te vin ranpli avèk laperèz. <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>Men zanj yo te di yo: <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="MAT 14:27">Mat 14:27</ref></char></note>“Pa pè, paske gade, mwen pote bòn nouvèl a gwo lajwa ki va pou tout pèp la. <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>Paske jodi a nan vil David la, te vin ne pou nou menm, yon <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="MAT 1:21">Mat 1:21</ref></char></note>Sovè, ki se Kris la, Senyè a. <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/><note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="1SA 2:34">I Sam 2:34</ref></char></note>Epi sa va yon sign pou nou; nou va twouve yon anfan vlope nan twal, e kouche nan yon manjwa.”<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>Lapoula te parèt avèk zanj lan yon foul lame syèl la ki t ap fè lwanj Bondye, e ap di:<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:9">Mat 21:9</ref>
      </char>
    </note>“Glwa a Bondye nan pi wo a,</para>
  <para style="q1" vid="LUK 2:14">e sou latè a, lapè pami lèzòm</para>
  <para style="q1" vid="LUK 2:14">ki fè L kontan yo.”<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>Li te rive ke lè zanj yo te kite yo pou retounen nan syèl, ke bèje yo te kòmanse di youn ak lòt: “Alò, annou ale toudwat Bethléhem pou wè bagay sa a ke Bondye fè nou konprann nan.”<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>Yo te fè vit pou rive e te twouve chemen pou rive kote Marie avèk Joseph, avèk pitit ki te kouche nan manjwa a. <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>Alò, lè yo te wè sa, yo te fè konnen pawòl ki te livre a yo konsènan pitit sila a. <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>Tout moun ki te tande sa te etone de bagay ke bèje yo t ap di yo.<verse eid="LUK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 2:19"/>Men Marie te <note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="LUK 2:51">Luc 2:51</ref></char></note>kache tout sa pou sonje l, e li te reflechi sou yo nan kè li.<verse eid="LUK 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 2:20"/>Bèje yo te retounen e yo <note caller="+" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="MAT 9:8">Mat 9:8</ref></char></note>t ap bay Bondye glwa avèk lwanj pou tout sa ke yo te tande e wè, jan ke li te pale a yo menm nan.<verse eid="LUK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>Lè <note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 17:12">Jen 17:12</ref></char></note>uit jou te fin pase avan sikonsizyon Li te fèt, yo te bay Li non Jésus, menm non ki te bay pa zanj yo avan Li te plase nan vant lan.<verse eid="LUK 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:22 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 12:6-8">Lev 12:6-8</ref>
      </char>
    </note>Lè jou pou yo vin pirifye yo te rive selon Lalwa Moïse la, yo te mennen Li Jérusalem pou prezante Li devan Senyè a. <verse eid="LUK 2:22"/><verse number="23" style="v" sid="LUK 2:23"/>(Jan li ekri nan Lalwa Senyè a: <note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="EXO 13:2">Egz 13:2</ref>,<ref loc="EXO 13:12">12</ref></char></note>“Tout mal ki premye ouvri vant lan va rele sen a Bondye”), <verse eid="LUK 2:23"/><verse number="24" style="v" sid="LUK 2:24"/>epi pou ofri yon sakrifis selon sa ki te pale nan Lalwa Senyè a, <note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="LEV 5:11">Lev 5:11</ref></char></note>“yon pè toutrèl, oswa, de jenn pijon.”<verse eid="LUK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25"/>Konsa, te gen yon mesye Jérusalem ki te rele Siméon. Mesye sa a te jis e devwe. Li t ap <note caller="+" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="MRK 15:43">Mc 15:43</ref></char></note>chache konsolasyon Israël, epi Lespri Sen an te sou li. <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>Li te revele a li menm ke li pa t ap <note caller="+" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="PSA 89:48">Sòm 89:48</ref></char></note>wè lanmò avan ke li te wè Kris a Senyè a. <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>Konsa, li te nan Lespri a lè l te antre nan tanp lan nan menm lè paran Jésus yo te pote pitit la, <note caller="+" style="x"><char style="xo" closed="false">2:27 </char><char style="xt" closed="false"><ref loc="LUK 2:22">Luc 2:22</ref></char></note>pou akonpli pou Li koutim Lalwa a. <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>Epi li te ranmase li nan bwa li. Li te beni Bondye, e te di:<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29"/>“Koulye a Senyè, W ap kite sèvitè Ou a</para>
  <para style="q1" vid="LUK 2:29">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:29 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 2:26">Luc 2:26</ref>
      </char>
    </note>pati anpè selon pawòl Ou.<verse eid="LUK 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30"/>Paske zye m gen tan <note caller="+" style="x"><char style="xo" closed="false">2:30 </char><char style="xt" closed="false"><ref loc="PSA 119:166-174">Sòm 119:166-174</ref></char></note>wè delivrans Ou,<verse eid="LUK 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 2:31"/>ke ou prepare devan tout nasyon yo;<verse eid="LUK 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>“yon limyè revelasyon pou payen yo,</para>
  <para style="q1" vid="LUK 2:32">epi laglwa a pèp Ou a, Israël.”<verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>Papa L avèk <note caller="+" style="x"><char style="xo" closed="false">2:33 </char><char style="xt" closed="false"><ref loc="MAT 12:46">Mat 12:46</ref></char></note>manman L te etone de bagay ke yo t ap di sou Li yo.<verse eid="LUK 2:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 2:34"/>Siméon te beni yo, e te di a Marie, manman Li: “Veye byen, anfan sila a fèt pou <note caller="+" style="x"><char style="xo" closed="false">2:34 </char><char style="xt" closed="false"><ref loc="MAT 21:44">Mat 21:44</ref></char></note>tonbe ak leve a anpil moun an Israël, e pou yon sign k ap koze opozisyon. <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>Yon nepe va travèse menm nanm pa ou, jiskaske panse a kè anpil moun kapab vin revele.”<verse eid="LUK 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36"/>Anplis te gen yon pwofetès, Anne, fi a Phanuel, ki te nan <note caller="+" style="x"><char style="xo" closed="false">2:36 </char><char style="xt" closed="false"><ref loc="JOS 19:24">Jos 19:24</ref></char></note>tribi Aser. Li te avanse nan laj, e li <note caller="+" style="x"><char style="xo" closed="false">2:36 </char><char style="xt" closed="false"><ref loc="1TI 5:9">I Tim 5:9</ref></char></note>te viv avèk mari li pandan sèt ane apre maryaj la, <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>answit, kon vèv jis rive nan laj katre-ven-kat ane. Li pa t janm kite tanp lan e te sèvi lajounen kon lannwit nan <note caller="+" style="x"><char style="xo" closed="false">2:37 </char><char style="xt" closed="false"><ref loc="LUK 5:33">Luc 5:33</ref></char></note>jèn ak lapriyè. <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>Nan menm moman sila a, li te monte, e li te bay glwa a Bondye. Li te kontinye pale de Li a tout sila ki t ap <note caller="+" style="x"><char style="xo" closed="false">2:38 </char><char style="xt" closed="false"><ref loc="LUK 1:68">Luc 1:68</ref></char></note>chache redanmsyon Jérusalem nan.<verse eid="LUK 2:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39"/>Lè yo te fin acheve tout bagay selon Lalwa Senyè a, yo te retounen Galilée, nan <note caller="+" style="x"><char style="xo" closed="false">2:39 </char><char style="xt" closed="false"><ref loc="MAT 2:23">Mat 2:23</ref></char></note>pwòp vil pa yo, nan Nazareth.<verse eid="LUK 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 2:40"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:40 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:80">Luc 1:80</ref>
      </char>
    </note>Pitit la te kontinye grandi, e Li t ap vin fò. Li te ogmante nan sajès, e gras Bondye te sou Li.<verse eid="LUK 2:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>Alò paran Li yo te konn ale Jérusalem chak ane nan <note caller="+" style="x"><char style="xo" closed="false">2:41 </char><char style="xt" closed="false"><ref loc="EXO 12:11">Egz 12:11</ref></char></note>fèt Pak Jwif la.<verse eid="LUK 2:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 2:42"/>Lè L te vin gen douz ane, yo te monte la selon koutim fèt la. <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>Pandan yo t ap retounen, apre <note caller="+" style="x"><char style="xo" closed="false">2:43 </char><char style="xt" closed="false"><ref loc="EXO 12:15">Egz 12:15</ref></char></note>tout jou yo te pase, jenn gason an, Jésus te rete dèyè nan Jérusalem. Men paran Li yo pa t konnen sa. <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>Yo te sipoze ke Li te pami lòt moun yo. Yo te vwayaje pandan yon jou, e yo te kòmanse ap chache Li pami manm fanmi avèk zanmi yo.<verse eid="LUK 2:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 2:45"/>Lè yo pa t twouve Li, yo te retounen Jérusalem pou chache Li. <verse eid="LUK 2:45"/><verse number="46" style="v" sid="LUK 2:46"/>Konsa apre twa jou, yo te twouve Li nan tanp lan. Li t ap chita pami mèt yo, pou tande yo, e poze yo kesyon. <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>Tout sila ki te tande Li yo <note caller="+" style="x"><char style="xo" closed="false">2:47 </char><char style="xt" closed="false"><ref loc="MAT 7:28">Mat 7:28</ref></char></note>te etone de jan li te konprann, ak repons ke Li te bay yo.<verse eid="LUK 2:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 2:48"/>Lè yo te wè Li, yo te etone. Manman Li te di Li: “Pitit mwen, Poukisa Ou trete nou konsa? Gade, <note caller="+" style="x"><char style="xo" closed="false">2:48 </char><char style="xt" closed="false"><ref loc="LUK 2:49">Luc 2:49</ref></char></note>papa Ou ak mwen menm te enkyete, e nou t ap chache Ou.”<verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>Li te di yo: <char style="wj">“Poukisa nou t ap chache mwen? Èske nou pa t konnen ke M</char> <note caller="+" style="x"><char style="xo" closed="false">2:49 </char><char style="xt" closed="false"><ref loc="JHN 4:34">Jn 4:34</ref></char></note><char style="wj">te oblije lakay Papa M?”</char> <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>Men <note caller="+" style="x"><char style="xo" closed="false">2:50 </char><char style="xt" closed="false"><ref loc="MRK 9:32">Mc 9:32</ref></char></note>yo pa t konprann pawòl ke Li te di yo a.<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>Konsa, Li te ale avèk yo, e te rive nan <note caller="+" style="x"><char style="xo" closed="false">2:51 </char><char style="xt" closed="false"><ref loc="LUK 2:3">Luc 2:3</ref></char></note>Nazareth. Li te kontinye anba otorite yo, e manman L <note caller="+" style="x"><char style="xo" closed="false">2:51 </char><char style="xt" closed="false"><ref loc="LUK 2:19">Luc 2:19</ref></char></note>te gade tout bagay sa yo nan kè l.<verse eid="LUK 2:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 2:52"/>Epi Jésus te kontinye grandi nan sajès, ak wotè, epi nan <note caller="+" style="x"><char style="xo" closed="false">2:52 </char><char style="xt" closed="false"><ref loc="LUK 2:40">Luc 2:40</ref></char></note>gras avèk Bondye e avèk lèzòm.<verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>Alò nan kenzyèm ane pouvwa a Tibère César a, pandan <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="MAT 27:2">Mat 27:2</ref></char></note>Ponce Pilate te Gouvènè Juda, <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="MAT 14:1">Mat 14:1</ref></char></note>Hérode te tetrak (wa a zòn sila a), frè l Philippe te tetrak pou Liturée avèk Trachonite, e Lysanias te tetrark nan Abilène, <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/>nan tan a Anne ak Caïphe kon wo prèt, <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="MAT 3:1-10">Mat 3:1-10</ref></char></note>pawòl Bondye a te vini a Jean, fis Zacharie a, pandan l te nan dezè a.<verse eid="LUK 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 3:3"/>Konsa, li te vini nan <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="MAT 3:5">Mat 3:5</ref></char></note>tout distri ki te antoure Jourdain yo, e li t ap preche yon batèm repantans pou padon peche yo. <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/>Jan sa ekri nan liv pawòl a Ésaïe yo, pwofèt la:</para>
  <para style="q1" vid="LUK 3:4">“Lavwa a yon moun<note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="ISA 40:3">És 40:3</ref></char></note> k ap kriye nan dezè a,</para>
  <para style="q1" vid="LUK 3:4">‘Prepare chemen SENYÈ a,</para>
  <para style="q1" vid="LUK 3:4">Fè wout Li yo dwat,<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:4">És 40:4</ref>
      </char>
    </note> Chak vale va ranpli,</para>
  <para style="q1" vid="LUK 3:5">E tout gwo mòn ak ti kolin va vin bese.</para>
  <para style="q1" vid="LUK 3:5">Kwochi yo a va vin drese,</para>
  <para style="q1" vid="LUK 3:5">E move wout yo va vin swa.<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:6 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:5">És 40:5</ref>
      </char>
    </note> Tout chè va wè delivrans Bondye a.’”<verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>Konsa, li te kòmanse pale avèk foul la ki te sòti avè l pou batèm nan: <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat 12:34</ref></char></note>“Nou menm, nich vipè! Kilès ki te avèti nou sove kite kòlè k ap vini an? <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>Pou sa, pote fwi ki an akò avèk repantans yo, e pa kòmanse di a nou menm: <note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JHN 8:33">Jn 8:33</ref></char></note>‘Nou gen Abraham pou papa nou’, paske mwen di nou ke menm nan wòch sa yo, Bondye kapab fè leve pitit a Abraham yo. <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>Anverite, rach la deja poze sou rasin a bwa yo. Konsa, chak <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MAT 7:9">Mat 7:9</ref></char></note>bwa ki pa donnen bon fwi va koupe e jete nan dife.”<verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>Foul la ki t ap kesyone li, t ap di: <note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="LUK 3:12">Luc 3:12</ref>,<ref loc="LUK 3:14">14</ref></char></note>“Alò, kisa pou nou ta fè?”<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>Li te reponn yo, e te di: “Ke moun ki gen de tinik lan <note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ISA 58:7">És 58:7</ref></char></note>pataje avèk sila ki pa genyen an, e ke sila ki gen manje a fè menm jan an.”<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>Anplis, <note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LUK 7:29">Luc 7:29</ref></char></note>ajan kolektè kontribisyon yo te vini pou batize. Yo t ap mande l: “Mèt, kisa nou dwe fè?”<verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>Li te di yo: “Pa kolekte plis ke yo mande nou pran.”<verse eid="LUK 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14"/>Konsa, kèk sòlda t ap mande li: “Epi kisa pou nou menm fè”?</para>
  <para style="p" vid="LUK 3:14">Li te di yo: “Pa pran lajan sou okenn moun pa lafòs, ni <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="EXO 20:16">Egz 20:16</ref></char></note>fè fo akizasyon kont pèsòn. Rete satisfè avèk salè nou.”<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>Alò, pandan pèp la t ap antisipe, e t ap reflechi nan kè yo sou Jean, <note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="JHN 1:19">Jn 1:19</ref></char></note>pou konprann si se Kris la ke li te ye, <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/><note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="MAT 3:11-12">Mat 3:11-12</ref></char></note>Jean te reponn. Li te di yo tout: “Kanta mwen menm, mwen ap batize nou avèk dlo. Men gen Youn k ap vini ki pi pwisan pase m; menm lasèt sandal Li, mwen pa dign pou demare. Li va batize nou avèk Lespri Sen an, e avèk dife. <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>Laye vannen an deja nan men L, pou netwaye glasi a nèt, e ranmase tout ble antre nan depo Li; men l ap brile pay yo avèk <note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="MRK 9:43-48">Mc 9:43-48</ref></char></note>dife ki pa kapab etenn.”<verse eid="LUK 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18"/>Konsa, avèk anpil lòt egzòtasyon tou, Li te preche bòn nouvèl la bay pèp la.<verse eid="LUK 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19"/>Men lè l te bay <note caller="+" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="MAT 14:3">Mat 14:3</ref></char></note>Hérode, tetrak la tò akoz Hérodias, madanm a frè l la, e akoz tout mechanste ke Hérode te fè yo, <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>Hérode te ogmante peche l sou sa yo. Li te vin <note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="JHN 3:24">Jn 3:24</ref></char></note>mete Jean nan prizon.<verse eid="LUK 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:13-17">Mat 3:13-17</ref>
      </char>
    </note>Konsa, li te vin rive ke lè tout pèp la t ap batize, Jésus te batize tou. Epi pandan Li t ap priye, syèl la te vin ouvri, <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>e Lespri Sen an te desann sou Li nan fòm tankou yon toutrèl. E yon vwa te sòti nan syèl la: <note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Sòm 2:7</ref></char></note> “Ou menm se Fis byeneme Mwen an; nan Ou menm, Mwen byen kontan.”<verse eid="LUK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:17">Mat 4:17</ref>
      </char>
    </note>Lè L te kòmanse ministè Li, Jésus Li menm te nan laj, anviwon trant ane, e selon kwayans moun yo, fis a Joseph, fis a Héli, <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>fis a Matthat, fis a Lévi, fis a Melchi, fis a Jannaï, fis a Joseph, <verse eid="LUK 3:24"/><verse number="25" style="v" sid="LUK 3:25"/>fis a Mattathias, fis a Amos, fis a Nahum, fis a Esli, fis a Naggaï, <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>fis a Maath, fis a Mattathias, fis a Sémeï, fis a Joseph, fis a Joda, <verse eid="LUK 3:26"/><verse number="27" style="v" sid="LUK 3:27"/>fis a Joanan, fis a Rhésa, <note caller="+" style="x"><char style="xo" closed="false">3:27 </char><char style="xt" closed="false"><ref loc="MAT 1:12">Mat 1:12</ref></char></note>fis a Zorobabel, fis a Salathiel, fis a Néri, <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>fis a Melchi, fis a Addi, fis a Kosam, fis a Elmadam, fis a Er, <verse eid="LUK 3:28"/><verse number="29" style="v" sid="LUK 3:29"/>fis a Jésus, fis a Éliézer, fis a Jorim, fis a Matthat, fis a Lévi <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>fis a Siméon, fis a Juda, fis a Joseph, fis a Jonam, fis a Éliakim, <verse eid="LUK 3:30"/><verse number="31" style="v" sid="LUK 3:31"/>fis a Méléa, fis a Menna, fis a Mattatha, fis a Nathan, fis a David, <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/><note caller="+" style="x"><char style="xo" closed="false">3:32 </char><char style="xt" closed="false"><ref loc="MAT 1:16">Mat 1:16</ref></char></note>fis a Isaï, fis a Jobed, fis a Booz, fis a Salmon, fis a Naason, <verse eid="LUK 3:32"/><verse number="33" style="v" sid="LUK 3:33"/>fis a Aminadab, fis a Admin, fis a Arni, fis a Esrom, fis a Pharès, fis a Juda <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>fis a Jacob, fis a Isaac <note caller="+" style="x"><char style="xo" closed="false">3:34 </char><char style="xt" closed="false"><ref loc="GEN 11:26-30">Jen 11:26-30</ref></char></note>fis a Abraham, fis a Thara, fis a Nachor, <verse eid="LUK 3:34"/><verse number="35" style="v" sid="LUK 3:35"/>fis a Seruch, fis a Ragau, fis a Phalek, fis a Éber, fis a Sala, <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>fis a Kaínam, fis a Arphaxad, fis a Sem, <note caller="+" style="x"><char style="xo" closed="false">3:36 </char><char style="xt" closed="false"><ref loc="GEN 5:3-32">Jen 5:3-32</ref></char></note>fis a Noé, fis a Lamech, <verse eid="LUK 3:36"/><verse number="37" style="v" sid="LUK 3:37"/>fis a Mathusala, fis a Énoch, fis a Jared, fis a Maléléel, fis a Kaïnan, <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>fis a Énos, fis a Seth, fis a Adam, fis a Bondye.<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:1-11">Mat 4:1-11</ref>
      </char>
    </note>Jésus, ranpli avèk Lespri Sen an, te retounen soti nan Jourdain an. Li te mennen pa Lespri a nan dezè a <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>pandan <note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">Egz 34:28</ref></char></note>karant jou, e Li te vin tante pa dyab la. Li pa t manje anyen pandan jou sa yo, epi lè jou yo te fini, Li te vin grangou.<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>Konsa, dyab la te di L: “Si Ou se fis Bondye a, kòmande wòch sila a vin pen.”<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>Jésus te reponn li: <char style="wj">“Li ekri. </char> <note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">Det 8:3</ref></char></note><char style="wj">‘Lòm pa viv sèlman sou pen.’” </char><verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:5 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:8-10">Mat 4:8-10</ref>
      </char>
    </note>Konsa, li te mennen Li monte, e te montre Li tout wayòm latè yo nan yon enstan de tan. <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>Dyab la te di Li: “Mwen va bay Ou tout domenn sila a avèk glwa li, <note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="1JN 5:9">I Jn 5:9</ref></char></note>paske li livre nan men m, e mwen ap bay li a sila a ke m pito. <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>Konsa, si Ou pwostène devan m, tout li ap vini pou Ou.”<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>Jésus te reponn. Li te di l konsa: <char style="wj">“Sa ekri </char><note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Det 6:13</ref></char></note><char style="wj">‘Ou va adore Senyè a Bondye ou a, e sèvi Li menm sèlman.’” </char><verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:5-7">Mat 4:5-7</ref>
      </char>
    </note>Ankò li te mennen Li Jérusalem. Li te fè L kanpe sou pwent twati tanp lan, e te di Li: “Si Ou se Fis Bondye a, voye kò Ou anba soti isit la, <verse eid="LUK 4:9"/><verse number="10" style="v" sid="LUK 4:10"/>paske sa ekri:</para>
  <para style="q1" vid="LUK 4:10">‘Li va bay zanj Li yo chaj de ou pou pwoteje ou,’<verse eid="LUK 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11"/>epi nan men pa yo, yo va kenbe ou,</para>
  <para style="q1" vid="LUK 4:11">pou ou pa frape pye ou kont wòch.’”<verse eid="LUK 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>Konsa, Jésus te reponn li, e te di: <char style="wj">“Li kon di; </char> <note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="DEU 6:16">Det 6:16</ref></char></note> <char style="wj">‘Nou pa pou pase Senyè a, Bondye nou nan eprèv.’” </char><verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>Lè dyab la te fin fè tout tantasyon yo, li te kite Li jiska yon moman konvenab.<verse eid="LUK 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:12">Mat 4:12</ref>
      </char>
    </note>Jésus te retounen Galilée anba pouvwa Lespri a. <note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="MAT 9:26">Mat 9:26</ref></char></note>Nouvèl Li te gaye toupatou nan tout andwa ki antoure distri yo. <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>Li te kòmanse <note caller="+" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>enstwi nan sinagòg yo, e te resevwa lwanj a tout moun.<verse eid="LUK 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>Li te vini Nazareth, kote Li te elve a, e kon koutim Li, <note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="MAT 13:54">Mat 13:54</ref></char></note>Li te antre nan sinagòg la nan Saba a. Li te kanpe pou li. <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>Yo te lonje bay Li liv a pwofèt Ésaïe a. Li te ouvri l e te twouve plas kote sa te ekri:<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:18 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 61:1">És 61:1</ref>
      </char>
    </note> <char style="wj">“Lespri Senyè a sou Mwen, </char></para>
  <para style="q1" vid="LUK 4:18">
    <char style="wj">paske Li te onksyone M pou preche </char></para>
  <para style="q1" vid="LUK 4:18">
    <char style="wj">bòn nouvèl la a malere yo. </char></para>
  <para style="q1" vid="LUK 4:18">
    <char style="wj">Li te voye M pou pwoklame libète a prizonye yo, </char></para>
  <para style="q1" vid="LUK 4:18">
    <char style="wj">pou fè avèg yo vin wè, pou libere sila ki oprime yo. </char><verse eid="LUK 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LUK 4:19"/>
    <char style="wj">Pou pwoklame </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:19 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 61:1">És 61:1</ref>
      </char>
    </note>
    <char style="wj">ane favorab a Senyè a.” </char><verse eid="LUK 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>Li te <note caller="+" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="LUK 4:17">Luc 4:17</ref></char></note>fèmen liv la. Li te remèt li bay atandan an, e Li te chita. Zye a tout sinagòg la te fikse sou Li. <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>Li te di yo: <char style="wj">“Jodi a menm, Ekriti sila a akonpli nan zòrèy nou.” </char><verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>Epi tout moun t ap pale byen de Li, e yo te etone akoz pawòl a gras ki ap tonbe soti nan lèv Li. Yo t ap di: <note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 13:55">Mat 13:55</ref></char></note>“Se pa fis a Joseph la?”<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>Li te di yo: <char style="wj">“San dout nou va repete pwovèb sila pou Mwen: ‘Doktè, geri pwòp tèt Ou!’ Sa ke nou tande ke Ou te fè nan</char> <note caller="+" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 4:13">Mat 4:13</ref></char></note><char style="wj">Capernaüm, fè l isit la lakay Ou tou.’” </char><verse eid="LUK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 4:24"/>Konsa, Li te di: <char style="wj">“Anverite Mwen di nou, </char> <note caller="+" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="MAT 13:57">Mat 13:57</ref></char></note><char style="wj">nanpwen pwofèt ki byen resevwa nan pwòp vil li. </char> <verse eid="LUK 4:24"/><verse number="25" style="v" sid="LUK 4:25"/><char style="wj">Men, Mwen di nou anverite, ke te gen anpil vèv nan Israël</char> <note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="1KI 17:1">I Wa 17:1</ref></char></note><char style="wj">nan jou Élie yo, lè syèl la te fèmen nèt pandan twazan si mwa, lè gwo grangou te rive sou tout peyi a.</char> <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/><char style="wj">Malgre sa, Élie pa t voye a okenn nan yo, men sèlman a</char><note caller="+" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="1KI 17:9">I Wa 17:9</ref></char></note><char style="wj">Sarepta, nan peyi Sidon, a yon fanm ki te yon vèv. </char> <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/><char style="wj">Epi te gen anpil lèp an Israël nan tan pwofèt Élie a, men okenn pa t pirifye, men</char> <note caller="+" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">II Wa 5:1-14</ref></char></note><char style="wj">sèlman Naaman, yon Siryen.” </char><verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>Konsa, tout sinagòg la te anraje lè yo te tande bagay sa yo; <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>Yo te soulve, yo te <note caller="+" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="NUM 15:35">Nonb 15:35</ref></char></note>pouse bourade Li deyò vil la, e te mennen Li nan <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>do ti mòn a kote vil yo te bati, pou yo ta kapab jete L anba nan falèz la. Men Li te <note caller="+" style="x"><char style="xo" closed="false">4:30 </char><char style="xt" closed="false"><ref loc="JHN 10:39">Jn 10:39</ref></char></note>pase nan mitan yo, e Li te al fè wout Li.<verse eid="LUK 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">4:31 </char><char style="xt" closed="false"><ref loc="MRK 1:21-28">Mc 1:21-28</ref></char></note>Li te desann Capernaüm, yon vil nan Galilée. Li t ap enstwi yo nan Saba a. <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>Yo te etone de enstriksyon Li, paske <note caller="+" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="LUK 4:36">Luc 4:36</ref></char></note>mesaj Li yo te avèk otorite.<verse eid="LUK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33"/>Te gen yon mesye nan sinagòg la ki te posede pa lespri a yon dyab enpi, e li t ap kriye avèk yon vwa fò: <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>“Kite nou pou kont nou! <note caller="+" style="x"><char style="xo" closed="false">4:34 </char><char style="xt" closed="false"><ref loc="MAT 8:29">Mat 8:29</ref></char></note> Kisa nou gen avè Ou, Jésus de <note caller="+" style="x"><char style="xo" closed="false">4:34 </char><char style="xt" closed="false"><ref loc="MRK 1:24">Mc 1:24</ref></char></note>Nazareth? Èske Ou vini pou detwi nou? Mwen konnen ki moun Ou ye, Sila Ki Sen a Bondye a!”<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>Jésus te <note caller="+" style="x"><char style="xo" closed="false">4:35 </char><char style="xt" closed="false"><ref loc="MAT 8:26">Mat 8:26</ref></char></note>reprimande li. Li te di: <char style="wj">“Fè silans e sòti sou li!” </char> Lè dyab la te fin jete li atè a nan mitan yo, li te sòti sou li san fè l mal.<verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>Sezisman te pran yo tout. Yo t ap diskite youn avèk lòt e t ap di: “Ki mesaj sa a? Paske avèk otorite ak pwisans Li kòmande lespri enpi yo, e yo te sòti.” <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/><note caller="+" style="x"><char style="xo" closed="false">4:37 </char><char style="xt" closed="false"><ref loc="LUK 4:14">Luc 4:14</ref></char></note>Nouvèl a Li menm t ap gaye toupatou nan distri ozanviwon yo.<verse eid="LUK 4:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:38 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 8:14-15">Mat 8:14-15</ref>
      </char>
    </note>Konsa, Li te leve kite sinagòg la, e Li te antre lakay Simon. Alò, bèlmè Simon t ap soufri anba yon gwo lafyèv, e yo te mande Li pou ede l. <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>Konsa Li te kanpe anwo li; Li te <note caller="+" style="x"><char style="xo" closed="false">4:39 </char><char style="xt" closed="false"><ref loc="LUK 4:35-41">Luc 4:35-41</ref></char></note>reprimande fyèv la. Fyèv la te kite li, epi imedyatman li te leve pou sèvi yo.<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:40 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 8:16-17">Mat 8:16-17</ref>
      </char>
    </note>Pandan solèy la t ap kouche, tout moun ki te gen moun malad avèk plizyè kalite maladi, te pote yo vini. Li te mete men L sou yo tout, e Li t ap geri yo. <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>Anplis, dyab yo t ap sòti nan anpil moun. Yo t ap kriye e t ap di: “Ou se Fis Bondye a!” Men Li t ap reprimande yo. Li <note caller="+" style="x"><char style="xo" closed="false">4:41 </char><char style="xt" closed="false"><ref loc="MAT 8:16">Mat 8:16</ref></char></note>pa t kite yo pale menm, paske yo te konnen ke Li te Kris la.<verse eid="LUK 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:42 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:35-38">Mc 1:35-38</ref>
      </char>
    </note>Lè jou a te rive, Li te sòti pou te ale yon kote ki pa t gen moun. Foul la t ap chache Li, e te vini kote Li. Konsa, yo te kenbe L pou anpeche Li ale.<verse eid="LUK 4:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 4:43"/>Men Li te di yo: <char style="wj">“Mwen oblije preche Wayòm Bondye a nan lòt vil yo tou; </char> <note caller="+" style="x"><char style="xo" closed="false">4:43 </char><char style="xt" closed="false"><ref loc="MRK 1:38">Mc 1:38</ref></char></note><char style="wj">paske Mwen te voye pou rezon sa a.” </char> <verse eid="LUK 4:43"/><verse number="44" style="v" sid="LUK 4:44"/>Konsa, Li te kontinye ap preche nan sinagòg<note caller="+" style="x"><char style="xo" closed="false">4:44 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>Judée yo.<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:18-22">Mat 4:18-22</ref>
      </char>
    </note>Alò, li te vin pase ke foul la t ap peze sou li pou koute pawòl Bondye a, lè L t ap kanpe akote lak ke yo rele Génésareth la. <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/>Li te wè de kannòt ki te twouve akote lak la, men moun lapèch yo te deja desann yo, e t ap lave filè yo. <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>Li te <note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="MAT 13:2">Mat 13:2</ref></char></note>antre nan youn nan kannòt yo ki te pou Simon, e Li te mande li pou mete yo a yon ti distans de tè a. Li te chita, e te kòmanse enstwi foul la depi nan kannòt la.<verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>Lè Li te fin pale, Li te di Simon: <char style="wj">“Mete nou deyò nan dlo fon e</char><note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="JHN 21:6">Jn 21:6</ref></char></note><char style="wj">lage filè yo pou kenbe pwason.” </char><verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>Simon te reponn pou di L: <note caller="+" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="LUK 8:24">Luc 8:24</ref></char></note>“Mèt, nou travay di tout nwit lan, e nou pa t kenbe anyen; men selon sa Ou mande a, m ap lage filè yo.”<verse eid="LUK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:6 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 21:6">Jn 21:6</ref>
      </char>
    </note>Lè yo te fin fè sa, yo te pran yon gwo kantite pwason. Filè yo te tanmen chire. <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>Konsa, yo te fè sign pou moun parèy yo nan lòt kannòt yo vin ede yo. Yo te vini, e te plen tou de kannòt yo jiskaske yo te kòmanse plonje.<verse eid="LUK 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8"/>Men lè Simon Pierre te wè sa, li te tonbe nan pye Jésus. Li te di L: “Ale lwen mwen, paske se yon pechè mwen ye, O Senyè!” <verse eid="LUK 5:8"/><verse number="9" style="v" sid="LUK 5:9"/>Paske sezisman te pran l avèk tout zanmi li yo akoz kantite pwason yo te kenbe. <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>Anplis, Jacques avèk Jean, fis Zébédée yo ki te asosye yo avèk Simon te sezi tou.</para>
  <para style="p" vid="LUK 5:10">Jésus te reponn Simon:<note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="MAT 14:27">Mat 14:27</ref></char></note> <char style="wj">“Pa pè, depi koulye a, se moun n ap kenbe.” </char> <verse eid="LUK 5:10"/><verse number="11" style="v" sid="LUK 5:11"/>Lè yo te fin fè kannòt yo rive atè, <note caller="+" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="MAT 4:20-22">Mat 4:20-22</ref></char></note>yo te kite tout bagay pou yo te swiv Li.<verse eid="LUK 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 8:2-4">Mat 8:2-4</ref>
      </char>
    </note>Pandan Li te nan youn nan vil yo, gade byen, te gen yon nonm ki te kouvri avèk lalèp. Lè l te wè Jésus, li te tonbe sou figi li, e li te enplore Li: “Senyè, si Ou vle, Ou kapab fè m pwòp.”<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>Li te lonje men L, e te touche li. Li te di: <char style="wj">“Mwen vle. Vin pwòp.” </char> Imedyatman, lalèp la te kite li. <verse eid="LUK 5:13"/><verse number="14" style="v" sid="LUK 5:14"/>Li te kòmande li pou pa di pèsòn sa: <char style="wj">“Men ale</char><note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 13:49">Lev 13:49</ref></char></note><char style="wj">montre ou menm a prèt yo, e fè yon ofrann pou netwayaj ou, jan Moïse te kòmande a, kon yon temwayaj a yo menm.” </char><verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>Men <note caller="+" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MAT 9:26">Mat 9:26</ref></char></note>nouvèl sou Li t ap gaye menm pi lwen. Gwo foul moun t ap rasanble pou tande Li, e pou geri de maladi yo. <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>Men Jésus Li menm, te konn souvan chape ale nan dezè a pou<note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="MAT 14:23">Mat 14:23</ref></char></note>priye.<verse eid="LUK 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>Li te rive yon jou pandan Li t ap enstwi, ke kèk Farizyen avèk mèt Lalwa te chita la. Yo te <note caller="+" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="MRK 1:45">Mc 1:45</ref></char></note>sòti nan chak vilaj Galilée, Juda ak Jérusalem. Konsa, <note caller="+" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="MRK 5:30">Mc 5:30</ref></char></note>pwisans a Senyè a te prezan pou l te geri moun.<verse eid="LUK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 5:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:2-8">Mat 9:2-8</ref>
      </char>
    </note> Kèk moun t ap pote sou yon kabann, yon nonm ki te paralize. Konsa, yo t ap eseye fè l antre pou mete l devan L. <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>Men san twouve mwayen pou fè l antre akoz foul la, yo te monte sou tèt kay la, e te fè l desann nan yon twou nan kouvèti mitan foul la, devan Jésus.<verse eid="LUK 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20"/>Lè L te wè lafwa yo, Li te di: <char style="wj">“Mesye, peche ou yo padone”. </char><verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>Skrib yo avèk Farizyen yo te kòmanse rezone. Yo t ap di: <note caller="+" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="LUK 7:49">Luc 7:49</ref></char></note>“Ki moun sa k ap blasfeme konsa? <note caller="+" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="ISA 43:25">És 43:25</ref></char></note>Kilès ki kapab padone peche sof ke Bondye sèl?”<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>Men Jésus, ki te okouran de jan yo t ap reflechi a, te reponn e te di yo: <char style="wj">“Poukisa nou ap reflechi nan kè nou konsa?</char> <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/><char style="wj">Kisa ki pi fasil pou di: ‘Peche ou yo padone’, oubyen pou di: ‘Leve mache’?</char> <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/><char style="wj">Men pou nou kab konnen ke Fis a Lòm nan gen otorite sou latè pou padone peche yo,” </char> li te di a paralitik la: <note caller="+" style="x"><char style="xo" closed="false">5:24 </char><char style="xt" closed="false"><ref loc="MAT 4:24">Mat 4:24</ref></char></note><char style="wj">“Mwen di ou leve, pran kabann ou e ale lakay ou.” </char><verse eid="LUK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25"/>Lapoula nonm nan te leve devan yo, ranmase nat li, e li te ale lakay li <note caller="+" style="x"><char style="xo" closed="false">5:25 </char><char style="xt" closed="false"><ref loc="MAT 9:8">Mat 9:8</ref></char></note>ranpli avèk lwanj Bondye.<verse eid="LUK 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 5:26"/>Yo tout te sezi, etone menm, e <note caller="+" style="x"><char style="xo" closed="false">5:26 </char><char style="xt" closed="false"><ref loc="MAT 9:8">Mat 9:8</ref></char></note>t ap bay Bondye glwa. Yo te ranpli avèk lakrent, e t ap di: “Nou wè bagay ki tèlman remakab jodi a”.<verse eid="LUK 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:27 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:9-17">Mat 9:9-17</ref>
      </char>
    </note>Apre sa, Li te sòti deyò e li te wè yon ajan kontribisyon ki te rele Levi ki te chita nan biwo kontribisyon an. Li te di li: <char style="wj">“Swiv Mwen”. </char> <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>Konsa,li te <note caller="+" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="LUK 5:11">Luc 5:11</ref></char></note>kite tout bagay dèyè, e te leve swiv Li.<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:9">Mat 9:9</ref>
      </char>
    </note>Lévi te fè yon resepsyon pou Li lakay li. Yo te gen yon gwo <note caller="+" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="LUK 15:1">Luc 15:1</ref></char></note>foul kolektè kontribisyon avèk lòt moun ki t ap manje sou tab la avèk yo. <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/><note caller="+" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MRK 2:16">Mc 2:16</ref></char></note>Farizyen yo avèk Skrib yo te kòmanse plenyen bay disip Li yo. Yo t ap di: “Poukisa nou manje e bwè avèk kolektè kontribisyon ak pechè yo?”<verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>Jésus te reponn e te di yo: <note caller="+" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="MAT 9:12">Mat 9:12</ref>,<ref loc="MAT 9:13">13</ref></char></note><char style="wj">“Se pa sila ki ansante yo ki bezwen yon doktè, men sila ki malad yo.” </char> <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/><char style="wj">Mwen pa t vini pou rele jis yo, men pechè yo a larepantans. </char><verse eid="LUK 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>Yo te di Li: <note caller="+" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="MAT 9:14">Mat 9:14</ref></char></note>“Disip a Jean yo souvan fè jèn e fè lapriyè; disip a Farizyen yo fè menm jan an. Men pa Ou yo, manje e bwè.”<verse eid="LUK 5:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34"/>Jésus te di yo: <char style="wj">“Nou pa kapab fè zanmi fèt maryaj yo fè jèn pandan jennonm maryaj la toujou avèk yo. Èske se pa vrè?</char> <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/><note caller="+" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="MAT 9:15">Mat 9:15</ref></char></note><char style="wj">Men jou yo ap vini lè jennonm nan ap kite yo. Alò, yo va fè jèn nan jou sa yo.” </char><verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>Li t ap di yo yon parabòl: <char style="wj">“Pèsonn pa chire yon mòso twal, fè l sòti nan yon vètman nèf, pou mete l sou yon vètman ki vye. Otreman l ap non sèlman fin chire nèf la, men nèf la p ap parèt menm jan ak vye a. </char> <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/><char style="wj">Epi pèsonn pa mete diven nèf nan veso vye kwi, otreman diven nèf la va pete kwi a, gaye tonbe, e vye kwi yo va vin gate. </char> <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/><char style="wj">Men diven nèf la oblije vide nan po fèt avèk kwi nèf. </char> <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/><char style="wj">Epi pèsonn, lè l fin bwè sa ki ansyen, pa janm vle nèf la, paske li di: ‘Vye a pi bon’”. </char><verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:1-8">Mat 12:1-8</ref>
      </char>
    </note>Alò, li vin rive ke nan yon dezyèm Saba apre premye a, Li t ap pase nan yon chan ble. Konsa, disip Li yo t ap ranmase e manje tèt ble yo, lè yo fin fwote yo nan men yo. <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>Men kèk nan Farizyen yo te di: “Poukisa nou fè sa ki pa <note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="MAT 12:2">Mat 12:2</ref></char></note>pèmi nan Saba a?”<verse eid="LUK 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3"/>Jésus te reponn yo e te di: <char style="wj">“Èske nou pa janm li</char><note caller="+" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="1SA 21:6">I Sam 21:6</ref></char></note><char style="wj">sa ke David te fè lè li te grangou; li menm avèk sila ki te avèk li yo?</char> <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/><char style="wj">Kijan li te antre nan kay Bondye a, li te pran manje</char><note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Lev 24:9</ref></char></note><char style="wj">pen konsakre a, ki pa t pèmi pou pèsonn manje sof ke prèt yo sèl, e li te bay a sila ki te avè l yo?”</char> <verse eid="LUK 6:4"/><verse number="5" style="v" sid="LUK 6:5"/>Li te di yo: <char style="wj">“Fis a Lòm nan se Senyè a Saba a.” </char><verse eid="LUK 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:6 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:9-14">Mat 12:9-14</ref>
      </char>
    </note>Nan yon lòt Saba, Li te antre nan sinagòg la. Li t ap enstwi. Te gen yon mesye la avèk yon men dwat ki te sèch.<verse eid="LUK 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 6:7"/>Konsa, skrib yo avèk Farizyen yo <note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="MRK 3:2">Mc 3:2</ref></char></note>t ap veye L byen pre, pou wè si Li ta geri nan Saba a, pou yo ta kapab twouve yon rezon pou akize L.<verse eid="LUK 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 6:8"/>Men Li te <note caller="+" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="MAT 9:4">Mat 9:4</ref></char></note>konnen panse yo. Li te di a mesye avèk men sèch la: <char style="wj">“Leve vin devan.” </char></para>
  <para style="p" vid="LUK 6:8">Konsa, li te leve vin devan.<verse eid="LUK 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9"/>Jésus te di yo: <char style="wj">“Mwen mande nou, èske se pèmi nan Saba a, pou fè byen, oubyen pou fè mal? Pou sove yon vi, oubyen pou detwi li?” </char> <verse eid="LUK 6:9"/><verse number="10" style="v" sid="LUK 6:10"/>Lè L<note caller="+" style="x"><char style="xo" closed="false">6:10 </char><char style="xt" closed="false"><ref loc="MRK 3:5">Mc 3:5</ref></char></note>fin gade yo tout, Li te di li: <char style="wj">“Lonje men ou!” </char></para>
  <para style="p" vid="LUK 6:10">Konsa, li te fè l. Epi men l te restore.<verse eid="LUK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11"/>Men yo menm te anraje. Yo te diskite ansanm sou sa yo ta kapab fè a Jésus.<verse eid="LUK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>Se te nan lè sa yo ke Li te kon ale nan mòn nan pou <note caller="+" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="MAT 14:23">Mat 14:23</ref></char></note>priye. Li te pase tout nwit lan nan lapriyè ak Bondye. <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>Lè li te fè jou, <note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">Mat 10:2-4</ref></char></note>Li te rele disip Li yo kote Li. Konsa, Li te chwazi douz pami yo ke Li te osi nome kòm apòt: <verse eid="LUK 6:13"/><verse number="14" style="v" sid="LUK 6:14"/>Simon, ke Li te osi rele Pierre, André, frè li, Jacques, Jean, Philippe, Barthélemy; <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/><note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="MAT 9:9">Mat 9:9</ref></char></note>Matthieu, Thomas; Jacques, fis de Alphée; Simon ki te rele Zelòt la; <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/>Jude, fis a Jacques; ak Judas Iscariot, ki te devni yon moun trèt.<verse eid="LUK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>Jésus te desann avèk yo, e Li te kanpe nan yon kote pla. Te gen <note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="MAT 4:25">Mat 4:25</ref></char></note>yon gwo foul disip Li yo, ak yon gwo foul moun ki te sòti nan tout Juda avèk Jérusalem, avèk zòn kot Tyr avèk Sidon. <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>Yo te vin pou tande Li, e pou geri de maladi yo; epi sila ki te twouble avèk lespri enpi yo t ap geri. <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>Tout foul la t ap eseye <note caller="+" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="MAT 9:21">Mat 9:21</ref></char></note>touche Li, paske <note caller="+" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="LUK 5:17">Luc 5:17</ref></char></note>pouvwa t ap sòti sou Li, e t ap geri yo tout.<verse eid="LUK 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>Li te leve zye L , vè disip Li yo, e te kòmanse di: <note caller="+" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="MAT 5:3-12">Mat 5:3-12</ref></char></note><char style="wj">“Beni se nou menm ki malere, paske wayòm Bondye a se pou nou. </char><verse eid="LUK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 6:21"/>
    <char style="wj">“Beni se nou menm ki grangou koulye a, paske nou va satisfè. Beni se nou menm ki kriye koulye a, paske nou va ri. </char><verse eid="LUK 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 6:22"/>
    <char style="wj">“Beni se nou menm lè lèzòm rayi nou, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:22 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 9:22">Jn 9:22</ref>
      </char>
    </note>
    <char style="wj">izole nou, ensilte nou, e bafwe non nou kon mechan pou koz Fis a Lòm nan. </char><verse eid="LUK 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23"/>
    <char style="wj">“Fè kè kontan nan jou sa a, e sote ponpe avèk jwa, paske, gade byen, rekonpans nou gran nan syèl la. Paske se</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:23 </char>
      <char style="xt" closed="false">
        <ref loc="2CH 36:16">II Kwo 36:16</ref>
      </char>
    </note>
    <char style="wj">menm jan an, zansèt pa yo te konn maltrete pwofèt yo. </char><verse eid="LUK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 6:24"/>
    <char style="wj">“Men malè a</char> <note caller="+" style="x"><char style="xo" closed="false">6:24 </char><char style="xt" closed="false"><ref loc="LUK 16:25">Luc 16:25</ref></char></note><char style="wj">nou menm ki rich, paske nou ap resevwa tout konfò nou. </char><verse eid="LUK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 6:25"/>
    <char style="wj">“Malè a sila ki byen manje koulye a yo, paske nou va grangou. </char></para>
  <para style="p" vid="LUK 6:25">
    <char style="wj">“Malè a nou menm ki ri koulye a, paske n ap kriye anpil. </char><verse eid="LUK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26"/>
    <char style="wj">“Malè a nou menm lè tout moun pale byen de nou, paske menm jan an, zansèt yo te konn aji avèk</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:26 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:15">Mat 7:15</ref>
      </char>
    </note>
    <char style="wj">fo pwofèt yo. </char><verse eid="LUK 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>
    <char style="wj">“Men Mwen di nou menm k ap tande: </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:27 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:44">Mat 5:44</ref>
      </char>
    </note>
    <char style="wj">renmen lènmi nou yo, e fè byen a sila ki rayi nou yo. </char> <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/><char style="wj">Beni sila ki bannou madichon yo. </char><note caller="+" style="x"><char style="xo" closed="false">6:28 </char><char style="xt" closed="false"><ref loc="MAT 5:44">Mat 5:44</ref></char></note><char style="wj">“Priye pou sila ki maltrete nou yo.</char><verse eid="LUK 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 6:29"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:3">Mat 9:3</ref>
      </char>
    </note> <char style="wj">“Nenpòt moun ki frape nou sou yon bò figi, ofri li lòt la tou; epi sila ki pran manto nou, pa refize li chemiz lan tou. </char><verse eid="LUK 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 6:30"/>
    <char style="wj">“Bay a tout sila ki mande nou yo, e sila ki pran sa ki pou nou, pa mande l remèt li. </char><verse eid="LUK 6:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 6:31"/>
    <char style="wj">“Menm jan ke nou vle moun</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:31 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:12">Mat 7:12</ref>
      </char>
    </note>
    <char style="wj">aji avèk nou, fè l menm jan an nan menm fason an. </char><verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:32 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:46">Mat 5:46</ref>
      </char>
    </note>
    <char style="wj">“Si nou renmen sila ki renmen nou yo, ki merit sa pote pou nou? Paske menm pechè yo renmen sila ki renmen yo. </char> <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/><char style="wj">Si nou fè byen a sila ki fè byen a nou yo, ki merit sa pote pou nou? Paske pechè yo fè menm bagay la. </char> <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/><note caller="+" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="MAT 5:42">Mat 5:42</ref></char></note><char style="wj">Si nou prete a sila ke nou sipoze kapab repeye nou, ki merit sa pote pou nou? Menm pechè yo prete a pechè yo pou yo kapab resevwa anretou. </char><verse eid="LUK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 6:35"/>
    <char style="wj">“Men renmen lènmi nou yo, fè byen, e prete, san sipoze ke yo va remèt; epi rekonpans nou va gran, e nou va vin</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:35 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:9">Mat 5:9</ref>
      </char>
    </note>
    <char style="wj">fis a </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:35 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:32">Luc 1:32</ref>
      </char>
    </note>
    <char style="wj">Trè Wo a; paske Li menm, Li plen charite pou lèzòm engra e malveyan. </char><verse eid="LUK 6:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 6:36"/>
    <char style="wj">“Fè mizerikòd menm jan ke Papa nou fè mizerikòd. </char><verse eid="LUK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:37 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:1-5">Mat 7:1-5</ref>
      </char>
    </note>
    <char style="wj">“Pa jije e nou p ap jije; pa kondane, e nou p ap kondane; padone, e nou va padone. </char><verse eid="LUK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 6:38"/>
    <char style="wj">“Bay, e li va remèt a nou; bon mezi, byen peze, souke ansanm, menm debòde, yo va vide sou nou. </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:38 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 4:24">Mc 4:24</ref>
      </char>
    </note>
    <char style="wj">Paske avèk mezi ou mezire a, li va mezire bay ou anretou.” </char><verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>Epi Li te anplis pale yon parabòl a yo menm: <char style="wj">“Èske</char><note caller="+" style="x"><char style="xo" closed="false">6:39 </char><char style="xt" closed="false"><ref loc="MAT 15:14">Mat 15:14</ref></char></note><char style="wj">yon nonm avèg kapab mennen yon nonm avèg? Èske tou de p ap tonbe nan twou? </char><verse eid="LUK 6:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 6:40"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:40 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:24">Mat 10:24</ref>
      </char>
    </note>
    <char style="wj">“Yon disip pa pi wo ke mèt li; men Nenpòt moun, lè li fin enstwi, ap tankou mèt li. </char><verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>
    <char style="wj">“Poukisa n ap gade pousyè ki nan zye a frè nou an, men pa okipe bout bwa ki nan zye pa nou an?</char> <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/><char style="wj">Oubyen kijan nou kapab di a frè nou an: ‘Frè m, kite m retire pousyè sa a ki nan zye ou a, lè nou menm pa wè bout bwa ki nan zye pa nou an? Nou ipokrit, premyèman retire bout bwa nan zye nou an, e nou va wè klè pou retire pousyè ki nan zye frè nou an. </char><verse eid="LUK 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:43 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:16-20">Mat 7:16-20</ref>
      </char>
    </note>
    <char style="wj">“Paske nanpwen bon ab ki pote move fwi; e lòt kote, yon move ab ki pwodwi bon fwi. </char> <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/><note caller="+" style="x"><char style="xo" closed="false">6:44 </char><char style="xt" closed="false"><ref loc="MAT 7:16">Mat 7:16</ref></char></note><char style="wj">Paske chak ab rekonèt pa pwòp fwi li. Konsa, lèzòm pa ranmase fig frans nan bwa zepin, ni yo p ap rekòlte fwi rezen nan yon touf pikan. </char><verse eid="LUK 6:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 6:45"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:45 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:35">Mat 12:35</ref>
      </char>
    </note> <char style="wj">“Yon bon nonm, nan trezò a kè li, pote sa ki bon; epi moun mechan an nan trezò mechan an va fè parèt sa ki mechan;</char> <note caller="+" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat 12:34</ref></char></note><char style="wj">paske bouch li pale sa ki ranpli kè li. </char><verse eid="LUK 6:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:46 </char>
      <char style="xt" closed="false">
        <ref loc="MAL 1:6">Mal 1:6</ref>
      </char>
    </note>
    <char style="wj">“Poukisa nou rele M ‘Senyè, Senyè’, e pa fè sa ke M di?</char> <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/><note caller="+" style="x"><char style="xo" closed="false">6:47 </char><char style="xt" closed="false"><ref loc="JAS 1:22">Jc 1:22</ref></char></note><char style="wj">Chak moun ki vin kote Mwen, e ki tande pawòl Mwen yo pou aji sou yo, Mwen va montre nou ak kisa li sanble:</char> <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/><char style="wj">Li tankou yon nonm k ap bati yon kay, ki te fouye fon, e ki mete yon fondasyon sou wòch la; epi lè inondasyon rive, tòran dlo a pete sou kay la, men li pa t kapab souke l, akoz ke li te byen bati. </char><verse eid="LUK 6:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 6:49"/>
    <char style="wj">“Men sila ki tande e ki pa aji, se tankou yon nonm ki bati kay li sou tè a san okenn fondasyon; epi tòran dlo a pete kont li. Lapoula li vin tonbe, e destriksyon a kay sa a vin gran.” </char><verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>Lè Li te fin konplete tout diskou Li a nan tande a pèp la, <note caller="+" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="MAT 8:5-13">Mat 8:5-13</ref></char></note>Li te ale Capernaüm. <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>Epi esklav a yon sèten santenye, ke li te renmen anpil, te malad e te prèt pou mouri. <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>Lè li te tande afè Jésus a, <note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="MAT 8:5">Mat 8:5</ref></char></note> chèf santenye a te voye kèk nan Jwif ansyen yo pou mande Li vin sove lavi a esklav li a. <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>Lè yo te rive kote Jésus, yo te sipliye L avèk tout kè yo. Yo te di: “Li merite pou Ou ta fè sa pou li. <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>Paske li renmen nasyon nou an. Se te li ki te bati sinagòg nou an.” <verse eid="LUK 7:5"/><verse number="6" style="v" sid="LUK 7:6"/>Jésus te pran wout la avèk yo. Lè Li te vin prè kay la, santenye a te voye zanmi yo pou di L: “Senyè, pa twouble tèt Ou plis, paske mwen pa dign pou Ou ta antre menm anba twati kay mwen. <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>Pou rezon sa a, mwen pa t menm konsidere ke m te dign pou m te vin kote Ou. Men sèlman di yon mo e sèvitè mwen an va geri. <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>Paske mwen tou se yon moun plase anba otorite, avèk sòlda yo anba m. Mwen di a sila a: ‘Ale’, e li ale, e a yon lòt ‘Vini’, e li vini; e a esklav mwen ‘Fè sa’, e li tou fè l.”<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>Alò, lè Jésus te tande sa, Li te etone de li. Li te vire di foul ki t ap swiv Li a: <char style="wj">“Mwen di nou, </char><note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="MAT 8:10">Mat 8:10</ref></char></note> <char style="wj">pa menm an Israël Mwen pa t twouve yon si gran lafwa.” </char> <verse eid="LUK 7:9"/><verse number="10" style="v" sid="LUK 7:10"/>Epi lè sila ki te voye yo te vin retounen, yo te twouve esklav la an bòn sante.<verse eid="LUK 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>Pa anpil tan apre sa, Li te ale nan yon vil yo rele Naïn. Disip Li yo t ap ale avè l akonpanye pa yon gwo foul moun. <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>Pandan Li t ap pwoche pòtay lavil la, gade, yo t ap pote yon nonm mouri. Li te sèl fis a manman l ki te yon vèv. Yon foul konsiderab te avè l. <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>Lè <note caller="+" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="LUK 7:19">Luc 7:19</ref></char></note>Senyè a te wè l, li te gen konpasyon pou li. Li te di l: <char style="wj">“Pa kriye.” </char> <verse eid="LUK 7:13"/><verse number="14" style="v" sid="LUK 7:14"/>Li te pwoche, te touche sèkèy la, e moun potè yo te kanpe san deplase. Li te di: <char style="wj">“Jennonm, Mwen di ou leve!” </char> <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>Moun mouri an te vin chita, e te kòmanse pale. Konsa, Jésus te remèt li bay manman l.<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:16 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:26">Luc 5:26</ref>
      </char>
    </note>Lakrent te sezi yo tout, yo t ap bay glwa a Bondye, e te di: “Yon gran pwofèt gen tan leve pami nou!” E “Bondye vizite pèp Li a”! <verse eid="LUK 7:16"/><verse number="17" style="v" sid="LUK 7:17"/>Rapò sila a konsènan Li te gaye toupatou nan Juda ak tout landwa nan distri yo.<verse eid="LUK 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 11:2-19">Mat 11:2-19</ref>
      </char>
    </note>Disip a Jean yo te bay li rapò konsènan tout bagay sa yo. <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>Konsa, li te rele de nan disip li yo, e te voye yo kote <note caller="+" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="LUK 7:13">Luc 7:13</ref></char></note>Senyè a pou mande: “Èske Ou se Sila k ap vini an, oubyen èske n ap tann yon lòt?” <verse eid="LUK 7:19"/><verse number="20" style="v" sid="LUK 7:20"/>Lè mesye yo te rive a Li menm, yo te di: “Jean-Baptiste voye nou kote Ou menm pou mande ‘Èske Ou se Sila k ap vini an, oubyen èske n ap tann yon lòt?’”<verse eid="LUK 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21"/>Nan menm lè sa a, Li te <note caller="+" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>geri anpil moun avèk maladi, <note caller="+" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="MRK 3:10">Mc 3:10</ref></char></note>afliksyon, ak move lespri; epi Li te bay vizyon a anpil moun ki te avèg. <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>Li te reponn e te di yo: <char style="wj">“Ale bay rapò a Jean sou sa nou wè ak tande.</char><note caller="+" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="ISA 35:5">És 35:5</ref></char></note></para>
  <para style="q1" vid="LUK 7:22">
    <char style="wj">‘Avèg yo vin wè, bwate yo vin mache,</char></para>
  <para style="q1" vid="LUK 7:22">
    <char style="wj">lepre yo vin pwòp, soud yo tande, mò yo leve,</char></para>
  <para style="q2" vid="LUK 7:22">
    <note caller="+" style="x">
      <char style="xo" closed="false">7:22 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 61:1">És 61:1</ref>
      </char>
    </note>
    <char style="wj">e malere yo gen bòn nouvèl la preche a yo menm. </char><verse eid="LUK 7:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="LUK 7:23"/>
    <char style="wj">Beni se sila ki pa pran ofans akoz Mwen.’” </char><verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>Lè mesaje a Jean yo te sòti, Li te kòmanse pale a foul la sou Jean: <char style="wj">“Kisa nou te ale nan dezè a pou wè? Yon wozo k ap souke pa van?</char> <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/><char style="wj">Men kisa nou te ale pou wè? Yon nonm abiye an twal swa? Gade byen, sila ki abiye byen bèl e ki viv nan richès yo se nan palè wayal yo ye. </char> <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/><char style="wj">Men kisa nou te ale wè? Yon pwofèt? Wi, Mwen di nou, se youn ki plis ke yon pwofèt. </char><verse eid="LUK 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 7:27"/>
    <char style="wj">“Se li menm sou sila yo te ekri a: </char></para>
  <para style="q2" vid="LUK 7:27">
    <note caller="+" style="x">
      <char style="xo" closed="false">7:27 </char>
      <char style="xt" closed="false">
        <ref loc="MAL 3:1">Mal 3:1</ref>
      </char>
    </note>
    <char style="wj">‘Veye byen, Mwen voye, mesaje Mwen devan fas Ou, </char></para>
  <para style="q1" vid="LUK 7:27">
    <char style="wj">ki va prepare chemen Ou an devan Ou.’ </char><verse eid="LUK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 7:28"/>
    <char style="wj">“Mwen di nou, pami sila ki ne de fanm yo, nanpwen youn ki pi gran ke Jean; malgre sila ki pi piti nan wayòm Bondye a, pi gran pase li.” </char><verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>Lè tout pèp la avèk kolektè kontribisyon yo te tande sa, yo te rekonèt jistis Bondye; <note caller="+" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="MAT 21:32">Mat 21:32</ref></char></note>akoz yo te batize avèk batèm Jean an. <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>Men Farizyen yo avèk <note caller="+" style="x"><char style="xo" closed="false">7:30 </char><char style="xt" closed="false"><ref loc="MAT 22:35">Mat 22:35</ref></char></note>avoka yo te rejte volonte a Bondye pou yo menm, akoz ke yo pa t batize avèk batèm a Jean an.<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>
    <char style="wj">“A kisa Mwen kapab konpare lèzòm nan jenerasyon sila a, e ak kisa yo sanble?</char> <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/><char style="wj">Yo tankou timoun ki chita nan plas mache a, e k ap rele youn lòt; epi yo di: ‘Nou te jwe flit la pou ou, e ou pa t danse; nou te chante yon antèman, e ou pa t kriye.’</char> <verse eid="LUK 7:32"/><verse number="33" style="v" sid="LUK 7:33"/><char style="wj">Paske Jean-Baptiste te vini</char><note caller="+" style="x"><char style="xo" closed="false">7:33 </char><char style="xt" closed="false"><ref loc="LUK 1:15">Luc 1:15</ref></char></note><char style="wj">san manje pen, ni bwè diven; epi nou di ke li te gen yon dyab!</char> <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/><char style="wj">Fis a Lòm nan vini nan manje, ak bwè; epi nou di: ‘Gade, yon nonm ki manje twòp, yon moun sou, yon zanmi a kolektè kontribisyon avèk pechè yo!</char> <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/><char style="wj">Men sajès la</char><note caller="+" style="x"><char style="xo" closed="false">7:35 </char><char style="xt" closed="false"><ref loc="LUK 7:29">Luc 7:29</ref></char></note><char style="wj">jistifye pa tout pitit li yo. </char><verse eid="LUK 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>Alò, youn nan Farizyen yo t ap mande L pou dine avèk li. Konsa, Li te antre lakay Farizyen an, e te rete sou tab la. <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/><note caller="+" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="MAT 26:6-13">Mat 26:6-13</ref></char></note>E te gen yon fanm nan vil la ki te yon pechè. Lè l vin konprann ke Li te sou tab lakay Farizyen an, li te pote yon bokal blan plen avèk pafen albat. <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>Li te kanpe dèyè Li, kote pye Li. Pandan l ap kriye, li te kòmanse mouye pye Li avèk dlo ki sòti nan zye li, epi siye yo avèk cheve li. Li te kontinye siye yo avèk cheve tèt li e bese nan pye Li, pou onksyone yo avèk pafen an. <verse eid="LUK 7:38"/><verse number="39" style="v" sid="LUK 7:39"/>Alò, lè Farizyen ki te envite Li a te wè sa, li te di a pwòp tèt li: “Si mesye sa a te <note caller="+" style="x"><char style="xo" closed="false">7:39 </char><char style="xt" closed="false"><ref loc="LUK 7:16">Luc 7:16</ref></char></note>yon pwofèt, Li t ap konnen ki kalite moun fanm sa a ye k ap touche Li a, ke li se yon pechè.”<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>Jésus te reponn li: <char style="wj">“Simon, Mwen gen yon bagay pou di ou.” </char></para>
  <para style="p" vid="LUK 7:40">Li te di: “Pale, Mèt.”<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>
    <char style="wj">Yon sèten moun ki prete lajan te gen de zòm ki te dwe l: youn te dwe l senk-san</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:41 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:28">Mat 18:28</ref>
      </char>
    </note>
    <char style="wj">denye, epi lòt la, senkant. </char> <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/><char style="wj">Lè yo</char> <note caller="+" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="MAT 18:25">Mat 18:25</ref></char></note><char style="wj">pa t kapab repeye, avèk gras, li te padone yo toulède. Pou sa, kilès nan yo k ap renmen li plis?” </char><verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>Simon te reponn e te di: “Mwen sipoze ke se sila ke li te padone plis la.”</para>
  <para style="p" vid="LUK 7:43">“ Li te di li: <char style="wj">“Ou jije byen”. </char><verse eid="LUK 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44"/>Lè Li vire vè fanm nan, Li te di Simon: <char style="wj">“Èske ou wè fanm sa a? Mwen te antre lakay ou. Ou</char> <note caller="+" style="x"><char style="xo" closed="false">7:44 </char><char style="xt" closed="false"><ref loc="GEN 18:4">Jen 18:4</ref></char></note><char style="wj">pa t ban M dlo pou pye Mwen, men li mouye pye M avèk dlo zye li, e li te siye yo avèk cheve li. </char> <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/><char style="wj">Ou pa t</char> <note caller="+" style="x"><char style="xo" closed="false">7:45 </char><char style="xt" closed="false"><ref loc="2SA 15:5">II Sam 15:5</ref></char></note><char style="wj">bo M; men li menm, depi lè M antre a li pa sispann bo pye Mwen. </char> <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/><note caller="+" style="x"><char style="xo" closed="false">7:46 </char><char style="xt" closed="false"><ref loc="2SA 12:20">II Sam 12:20</ref></char></note><char style="wj">Ou pa t onksyone tèt Mwen avèk lwil, men li te onksyone pye Mwen avèk pafen. </char><verse eid="LUK 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 7:47"/>
    <char style="wj">“Pou rezon sa a Mwen di ou, peche li yo ki te anpil, vin padone, paske li te renmen anpil: men sila a ki padone piti, renmen piti.” </char><verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>Answit Li te di li: <note caller="+" style="x"><char style="xo" closed="false">7:48 </char><char style="xt" closed="false"><ref loc="MAT 9:2">Mat 9:2</ref></char></note><char style="wj">“Peche ou yo padone”. </char><verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>Sila ki te sou tab avèk Li yo te kòmanse di a yo menm: <note caller="+" style="x"><char style="xo" closed="false">7:49 </char><char style="xt" closed="false"><ref loc="LUK 5:21">Luc 5:21</ref></char></note>“Ki moun sa ye ki menm padone peche?”<verse eid="LUK 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50"/>Epi Li te di a fanm nan: <char style="wj">“Lafwa ou sove ou;</char> <note caller="+" style="x"><char style="xo" closed="false">7:50 </char><char style="xt" closed="false"><ref loc="MRK 5:34">Mc 5:34</ref></char></note> <char style="wj">ale anpè.” </char><verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>Yon ti tan apre, Li te kòmanse ale de yon vil ak yon bouk a lòt, pou<note caller="+" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>pwoklame e preche wayòm syèl la. Douz yo te avèk Li. <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>Anplis te gen avèk yo <note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 27:55">Mat 27:55</ref></char></note>kèk fanm ki te geri de move lespri yo ak maladi yo. Te gen Marie, ke yo te rele Magdala a, sou kilès sèt dyab yo te sòti a, <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>avèk Jeanne, madanm Chouza a, <note caller="+" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="MAT 14:1">Mat 14:1</ref></char></note>entandan Hérode la, ak anpil lòt ki t ap kontribye a soutyen ki sòti nan mwayen pèsonèl yo.<verse eid="LUK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>Lè yon gran foul t ap rasanble, e sila yo ki sòti nan plizyè vil t ap vwayaje rive kote Li, Li te pale nan yon parabòl: <verse eid="LUK 8:4"/><verse number="5" style="v" sid="LUK 8:5"/><char style="wj">“Semè a te sòti pou simen semans li; e pandan li t ap simen, kèk te tonbe akote wout la; epi yo te vin foule anba pye, e zwazo anlè yo te manje yo. </char> <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/><char style="wj">Lòt semans te tonbe nan tè plen wòch, e pandan yo t ap grandi, yo te fennen akoz ke li pa t gen dlo. </char> <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/><char style="wj">Lòt semans te tonbe pami pikan; epi pikan yo te grandi avè l, e te trangle yo. </char> <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/><char style="wj">Lòt semans te tonbe nan bon tè, te grandi, e te pwodwi yon rekòlt san fwa pi gran.” </char></para>
  <para style="p" vid="LUK 8:8">Pandan Li t ap di bagay sa yo, Li t ap rele fò: <note caller="+" style="x"><char style="xo" closed="false">8:8 </char><char style="xt" closed="false"><ref loc="MAT 11:5">Mat 11:5</ref></char></note><char style="wj">“Sila ki gen zòrèy pou tande, kite l tande.” </char><verse eid="LUK 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:10-23">Mat 13:10-23</ref>
      </char>
    </note>Disip Li yo te kòmanse poze L kesyon sou sa ke parabòl sa a ta kapab vle di.<verse eid="LUK 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 8:10"/>Li te di: <char style="wj">“A nou menm li pèmi pou konnen mistè a wayòm Bondye a, men pou lòt yo, li fèt an parabòl, dekwa ke nan</char><note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="ISA 6:9">És 6:9</ref></char></note><char style="wj">gade, yo vin pa wè, e nan tande, pou yo pa konprann. </char><verse eid="LUK 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>
    <char style="wj">“Alò, parabòl la se sa:</char> <note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="1PE 1:23">I Pi 1:23</ref></char></note><char style="wj">Semans lan se pawòl Bondye a. </char><verse eid="LUK 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 8:12"/>
    <char style="wj">“Sila yo akote wout la se sila yo ki te tande; epi dyab la vin rache pawòl la nan kè yo, pou yo pa kwè e vin sove. </char><verse eid="LUK 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 8:13"/>
    <char style="wj">“Sila yo nan tè plen wòch la se sila yo ke lè yo tande, resevwa pawòl la avèk jwa, men yo pa gen rasin. Yo kwè pou yon tan, epi nan tan tantasyon, yo lage tonbe. </char><verse eid="LUK 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 8:14"/>
    <char style="wj">“Semans ki te tonbe pami pikan yo se sila yo ki te tande, epi pandan yo ap fè wout yo, yo vin trangle avèk pwoblèm pa yo ak richès a vi sa a. Konsa yo pa pote fwi ki vin mi. </char><verse eid="LUK 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 8:15"/>
    <char style="wj">“Semans nan bon tè a se sila yo ki te tande pawòl la avèk yon kè onèt e bon, e ki kenbe fèm, k ap pote fwi avèk pèseverans. </char><verse eid="LUK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>
    <char style="wj">“Alò, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">Mat 5:15</ref>
      </char>
    </note>
    <char style="wj">pèsonn, lè l fin limen yon lanp pa kouvri li avèk yon veso, ni mete l anba yon kabann; men li mete li sou yon chandelye, pou sila yo ki antre kapab wè limyè a. </char> <verse eid="LUK 8:16"/><verse number="17" style="v" sid="LUK 8:17"/><note caller="+" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Mat 10:26</ref></char></note><char style="wj">Paske pa gen anyen kache ki p ap vin parèt, ni anyen an sekrè ki p ap revele pou vin nan limyè. </char><verse eid="LUK 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18"/>
    <char style="wj">“Pou sa, okipe nou de jan nou tande. </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:12">Mat 13:12</ref>
      </char>
    </note>
    <char style="wj">Paske nenpòt moun ki genyen, se plis k ap bay a li menm; e a sila ki pa genyen an, menm sa li sipoze li genyen an va rache soti nan men li.” </char><verse eid="LUK 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:46-50">Mat 12:46-50</ref>
      </char>
    </note>Manman Li avèk frè L yo te vin kote L, e yo pa t kapab rive kote L akoz foul la. <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>Konsa moun yo te bay Li rapò a: “Manman Ou avèk frè Ou yo kanpe deyò a e vle wè Ou.”<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>Men Li te reponn yo e te di yo: <char style="wj">“Manman M avèk Papa M se sila yo </char><note caller="+" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="LUK 11:28">Luc 11:28</ref></char></note><char style="wj">ki tande pawòl Bondye a, e ki fè l.” </char><verse eid="LUK 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 8:23-27">Mat 8:23-27</ref>
      </char>
    </note>Nan youn nan jou sa yo, Li te monte avèk disip Li yo nan yon kannòt. Li te di yo: <char style="wj">“Annou pase pa lòtbò lak la.” </char> Yo te pati.<verse eid="LUK 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 8:23"/>Men pandan yo t ap ale sou vwal a, Li te tonbe nan dòmi. Epi yon gwo van te vin desann sou <note caller="+" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="LUK 5:1">Luc 5:1</ref></char></note>lak la, e yo te kòmanse inonde e te vin an danje.<verse eid="LUK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24"/>Yo te vini a Jésus e yo te fè L leve. Yo te di: <note caller="+" style="x"><char style="xo" closed="false">8:24 </char><char style="xt" closed="false"><ref loc="LUK 5:5">Luc 5:5</ref></char></note>“Mèt, Mèt, n ap peri!”</para>
  <para style="p" vid="LUK 8:24">Lè L vin leve, Li te <note caller="+" style="x"><char style="xo" closed="false">8:24 </char><char style="xt" closed="false"><ref loc="LUK 4:39">Luc 4:39</ref></char></note>reprimande van an avèk gwo lam lanmè yo, e yo te sispann. Konsa, tan an te vin kalm.<verse eid="LUK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 8:25"/>Li te di yo: <char style="wj">“Kote lafwa nou ye?” </char></para>
  <para style="p" vid="LUK 8:25">Yo te ranpli avèk lakrent. Yo te etone, e te di youn lòt: “Alò, kilès nonm sa ye ki kòmande menm van avèk dlo a, e yo obeyi a?”<verse eid="LUK 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:26 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 8:28-34">Mat 8:28-34</ref>
      </char>
    </note>Yo te kouri a vwal jouk lè yo rive nan peyi a Jerazenyen yo ki anfas Galilée. <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>Lè Li te desann atè, Li te rankontre pa yon sèten mesye nan vil la, ki te domine pa dyab. Li pa t konn mete rad depi lontan, e li pa t viv nan kay, men nan tonbo.<verse eid="LUK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 8:28"/>Lè l wè Jésus, li te kriye fò e te tonbe devan Li. Li te di ak yon gwo vwa: <note caller="+" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MAT 8:29">Mat 8:29</ref></char></note>“Kisa m gen avè ou Jésus, Fis a <note caller="+" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 5:7">Mc 5:7</ref></char></note>Pi Wo Bondye a? Mwen sipliye ou, pa toumante mwen.”<verse eid="LUK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 8:29"/>Paske Li te kòmande lespri enpi a pou sòti nan mesye a. Paske li te konn sezi li anpil fwa; e li te mare avèk chenn avèk fè nan pye li, e Li te kenbe anba gad. Li te konn pete tout kontrent sa yo pou dyab yo ta pouse l nan dezè a. <verse eid="LUK 8:29"/><verse number="30" style="v" sid="LUK 8:30"/>Jésus te mande li: <note caller="+" style="x"><char style="xo" closed="false">8:30 </char><char style="xt" closed="false"><ref loc="MAT 26:53">Mat 26:53</ref></char></note><char style="wj">“Kòman yo rele ou?” </char> E li te di: “Lejyon”, paske anpil dyab te gen tan antre nan li. <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>Yo t ap sipliye L pou pa voye yo <note caller="+" style="x"><char style="xo" closed="false">8:31 </char><char style="xt" closed="false"><ref loc="ROM 10:7">Wo 10:7</ref></char></note>nan abim nan. <verse eid="LUK 8:31"/><verse number="32" style="v" sid="LUK 8:32"/>Alò te gen yon gwo bann kochon ki t ap manje la nan mòn nan, e dyab yo te sipliye Li pou kite yo antre nan kochon yo. Konsa, Li te bay yo pèmisyon. <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>Dyab yo te sòti nan mesye a, e te antre nan kochon yo, bann nan te kouri desann pant falèz la, tonbe <note caller="+" style="x"><char style="xo" closed="false">8:33 </char><char style="xt" closed="false"><ref loc="LUK 5:11">Luc 5:11</ref></char></note>nan lak la, e te mouri nan dlo a. <verse eid="LUK 8:33"/><verse number="34" style="v" sid="LUK 8:34"/>Lè gadyen kochon yo te wè sa ki rive a, yo te kouri ale bay rapò a nan vil la avèk tout landwa andeyò yo.<verse eid="LUK 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 8:35"/>Pèp la te sòti vin wè sa ki te rive a, e yo te vin kote Jésus. Yo te twouve nonm ki te konn gen dyab la. Li te chita <note caller="+" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="LUK 10:39">Luc 10:39</ref></char></note>nan pye Jésus, byen abiye, e nan bon tèt li. Yo te vin pè.<verse eid="LUK 8:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 8:36"/>Sila yo ki te wè sa, te eksplike yo kijan nonm nan ki te <note caller="+" style="x"><char style="xo" closed="false">8:36 </char><char style="xt" closed="false"><ref loc="MAT 4:24">Mat 4:24</ref></char></note>posede pa dyab yo, te vin geri.<verse eid="LUK 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 8:37"/>Tout pèp Jerazenyen yo an ak landwa andeyò yo te mande pou L ta kite yo paske yo te ranpli avèk yon gwo perèz. Li te antre nan kannòt la, e te pati.<verse eid="LUK 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38"/>Men mesye a ke dyab yo te kite a te <note caller="+" style="x"><char style="xo" closed="false">8:38 </char><char style="xt" closed="false"><ref loc="MRK 5:18-20">Mc 5:18-20</ref></char></note>sipliye L pou L ta kapab ale avèk li, men Li te voye li ale e te di: <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/><char style="wj">“Retounen lakay ou pou eksplike yo ki gwo bagay ke Bondye te fè pou ou.” </char></para>
  <para style="p" vid="LUK 8:39">Donk li te ale, e te pwoklame toupatou nan tout vil la ki gwo bagay Bondye te fè pou li.<verse eid="LUK 8:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:40 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:1">Mat 9:1</ref>
      </char>
    </note>Lè Jésus te retounen, foul la te resevwa L byen, paske yo tout t ap tann Li.<verse eid="LUK 8:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 8:41"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:41 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:18-26">Mat 9:18-26</ref>
      </char>
    </note>Konsa, te vini yon nonm ki te rele Jaïrus ki te yon ofisye sinagòg la. Li te tonbe nan pye a Jésus e te kòmanse sipliye Li pou te vini lakay li; <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>paske li te gen yon sèl fi, anviwon laj a douz lane, e li te mouri.</para>
  <para style="p" vid="LUK 8:42">Men pandan Li t ap ale, foul la t ap peze Li.<verse eid="LUK 8:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 8:43"/>Konsa, yon fanm, ki te koule san pou plis ke douz lane, men pa t kapab twouve gerizon pa okenn moun, <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>te pwoche dèyè Li. Li te touche arebò vètman Li, e nan menm moman an, san an te rete.<verse eid="LUK 8:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45"/>Jésus te di: <char style="wj">“Kilès ki te touche Mwen an?” </char></para>
  <para style="p" vid="LUK 8:45">E pandan yo tout t ap demanti ke se pa yo, Pierre te di: <note caller="+" style="x"><char style="xo" closed="false">8:45 </char><char style="xt" closed="false"><ref loc="LUK 5:5">Luc 5:5</ref></char></note>“Mèt, foul la ap bourade ou e peze Ou.”<verse eid="LUK 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46"/>Men Jésus te di: <char style="wj">“Yon moun vrèman te touche M, paske Mwen te konnen lè</char><note caller="+" style="x"><char style="xo" closed="false">8:46 </char><char style="xt" closed="false"><ref loc="LUK 5:17">Luc 5:17</ref></char></note><char style="wj">pouvwa a te kite M nan.” </char><verse eid="LUK 8:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47"/>Lè fanm nan te wè ke li t ap dekouvri, li te vini byen tranble, e te tonbe devan Li. Li te deklare nan prezans a tout moun poukisa li te touche L la ak jan li te vin geri nan menm enstan.<verse eid="LUK 8:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 8:48"/>Jésus te di li: <char style="wj">“Fi Mwen, lafwa ou te fè ou geri;</char> <note caller="+" style="x"><char style="xo" closed="false">8:48 </char><char style="xt" closed="false"><ref loc="MRK 5:34">Mc 5:34</ref></char></note><char style="wj">ale anpè.” </char><verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>Pandan Li te toujou ap pale, yon moun te soti lakay<note caller="+" style="x"><char style="xo" closed="false">8:49 </char><char style="xt" closed="false"><ref loc="LUK 8:41">Luc 8:41</ref></char></note>ofisye sinagòg la, e te di: “Pitit ou a gen tan mouri. Pa twouble Mèt la ankò.”<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>Men lè Jésus te tande sa, Li te reponn li: <note caller="+" style="x"><char style="xo" closed="false">8:50 </char><char style="xt" closed="false"><ref loc="MRK 5:36">Mc 5:36</ref></char></note><char style="wj">“Pa pè; sèlman kwè, e li va geri.” </char><verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>Lè Li te rive nan kay la, Li pa t kite okenn lòt moun antre avè L, sof ke Pierre avèk Jean ak Jacques, epi manman ak papa pitit la.<verse eid="LUK 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 8:52"/>Alò yo tout t ap kriye, e t ap <note caller="+" style="x"><char style="xo" closed="false">8:52 </char><char style="xt" closed="false"><ref loc="LUK 23:27">Luc 23:27</ref></char></note>lamante pou li; men Li te di: <char style="wj">“Sispann kriye, paske li pa mouri, men</char> <note caller="+" style="x"><char style="xo" closed="false">8:52 </char><char style="xt" closed="false"><ref loc="JHN 11:13">Jn 11:13</ref></char></note><char style="wj">l ap dòmi.” </char><verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>Yo te kòmanse ap ri sou Li, paske yo te konnen ke li te mouri.<verse eid="LUK 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 8:54"/>Men Li menm te pran li pa lamen, Li te rele e te di: <char style="wj">“Pitit, leve!” </char><verse eid="LUK 8:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 8:55"/>Konsa, lespri lavi li te retounen, e li te leve imedyatman. Li te bay lòd pou yo bay li yon bagay pou l manje.<verse eid="LUK 8:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 8:56"/>Paran li yo te etone, men Li te <note caller="+" style="x"><char style="xo" closed="false">8:56 </char><char style="xt" closed="false"><ref loc="MAT 8:4">Mat 8:4</ref></char></note>enstwi yo pou pa pale pèsonn sa ki te rive a.<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:5">Mat 10:5</ref>
      </char>
    </note>Li te rele douz yo ansanm, e te bay yo pouvwa avèk otorite sou tout dyab, e pou geri maladi. <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>Li te voye yo ale pou <note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="MAT 10:7">Mat 10:7</ref></char></note>pwoklame wayòm Bondye a, e pou geri maladi.<verse eid="LUK 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 9:3"/>Konsa, Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">Luc 10:4-12</ref></char></note><char style="wj">“Pa pran anyen pou vwayaj nou, ni yon baton, ni yon sak, ni pen, ni lajan. Pa menm pote yon dezyèm vètman. </char> <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/><char style="wj">Nan nenpòt kay ke nou antre, rete la jiskaske nou kite vil sa a.</char> <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/><char style="wj">Pou sila yo ki pa resevwa nou, lè n ap kite vil sa a,</char> <note caller="+" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="LUK 10:11">Luc 10:11</ref></char></note><char style="wj">souke pousyè sòti nan pye nou kon yon temwayaj kont yo.” </char><verse eid="LUK 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6"/>Pandan yo t ap kite la, yo te kòmanse ale pami bouk yo, ap <note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="MRK 6:12">Mc 6:12</ref></char></note>preche levanjil la, e te fè gerizon toupatou.<verse eid="LUK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:7 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 6:14">Mc 6:14</ref>
      </char>
    </note>Alò, Hérode, tetrak la te tande tout sa ki t ap fèt yo. Konsa, li te gravman twouble, paske kèk moun te di ke se te Jean ki te leve soti nan lanmò.<verse eid="LUK 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 9:8"/>Selon kèk <note caller="+" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="MAT 16:14">Mat 16:14</ref></char></note>lòt Élie ki vin parèt, oswa youn nan ansyen pwofèt yo te leve ankò.<verse eid="LUK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 9:9"/>Hérode te di: “Mwen menm te fè yo koupe tèt a Jean, men kilès nonm sa a ye, ke m tande tout koze sa yo?” <note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="LUK 23:8">Luc 23:8</ref></char></note>Li te kontinye ap eseye pou l ta kab wè L.<verse eid="LUK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>Lè apòt yo te retounen, yo te bay Jésus yon istwa de tout sa ki te rive a.</para>
  <para style="p" vid="LUK 9:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">9:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:13-21">Mat 14:13-21</ref>
      </char>
    </note>Li te fè yo ale avè L, pou yo fè retrèt vè yon vilaj yo rele Betsaïda.<verse eid="LUK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 9:11"/>Men foul la te konnen sa. Yo te swiv Li, e Li te resevwa yo avèk kè ouvè.</para>
  <para style="p" vid="LUK 9:11">Li te kòmanse pale avèk yo sou wayòm syèl la, e te fè gerizon pou sila yo ki te bezwen geri.<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>Alò jou a te kòmanse ap avanse, e douz yo te vin di Li: “Voye foul la ale pou yo kapab ale nan vilaj yo oswa andeyò pou yo twouve lojman. Konsa, yo ka jwenn yon bagay pou yo manje, paske nou isit la nan yon kote ki izole.”<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>Men Li te di yo: <char style="wj">“Nou menm bay yo manje!” </char> Yo te reponn Li: “Nou pa gen plis ke senk pen avèk de pwason, sof ke petèt ke nou ta ale achte pen pou tout moun sa yo.” <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>(Paske te gen anviwon senk-mil moun.)</para>
  <para style="p" vid="LUK 9:14">Li te di a disip Li yo: <char style="wj">“Fè yo chita </char> <note caller="+" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="MRK 6:39">Mc 6:39</ref></char></note><char style="wj">nan gwoup de senkant chak.” </char><verse eid="LUK 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15"/>Konsa yo te fè; yo te fè tout moun chita.<verse eid="LUK 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 9:16"/>Answit, Li te pran senk pen avèk de pwason yo. Li te gade vè syèl la, e Li te beni yo. Li te kase yo, e te lonje bay disip yo pou mete devan foul la.<verse eid="LUK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 9:17"/>Yo te manje jis vant tout moun te plen. E mòso tou kase ke yo te ranmase yo te fè douz <note caller="+" style="x"><char style="xo" closed="false">9:17 </char><char style="xt" closed="false"><ref loc="MAT 14:20">Mat 14:20</ref></char></note>panyen byen ranpli.<verse eid="LUK 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:13-16">Mat 16:13-16</ref>
      </char>
    </note>Li te vin rive ke pandan Li t ap priye sèl, disip yo te toupre. Konsa, Li te poze yon kesyon. Li te mande: <char style="wj">“Kilès moun pèp la di ke Mwen ye?” </char><verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>Yo te reponn Li, e te di: “Jean-Baptiste, oswa Eli; men lòt yo, youn nan ansyen pwofèt yo ki leve ankò.”<verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>Li te mande yo: <char style="wj">“Men kilès nou menm, nou di ke Mwen ye”?</char></para>
  <para style="p" vid="LUK 9:20">Pierre te reponn. Li te di: <note caller="+" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="JHN 6:68">Jn 6:68</ref></char></note>“Kris la a Bondye a.”<verse eid="LUK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>Men Li te <note caller="+" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="MAT 8:4">Mat 8:4</ref></char></note>avèti yo avèk severite pou yo pa pale sa a pèsonn.<verse eid="LUK 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 9:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:16-28">Mat 21:16-28</ref>
      </char>
    </note>Konsa Li te di: <char style="wj">“Fis a Lòm nan va oblije soufri anpil bagay, e va rejte pa ansyen yo, ak chèf prèt yo, ak skrib yo. Li va vin touye, e va vin leve nan twazyèm jou a.” </char><verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>Li t ap di a yo tout: <note caller="+" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat 10:38</ref></char></note><char style="wj">“Si Nenpòt moun vle swiv Mwen, li dwe renonse a pwòp tèt li, pran kwa li e swiv Mwen. </char> <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/><char style="wj">Paske</char> <note caller="+" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10:39</ref></char></note><char style="wj">Nenpòt moun ki vle sove vi li va pèdi li, men sila a ki pèdi lavi li pou koz Mwen, se li ki va sove li. </char><verse eid="LUK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 9:25"/>
    <char style="wj">“Paske ki avantaj yon nonm gen si li vin genyen tou lemonn, e vin</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:25 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 10:34">Eb 10:34</ref>
      </char>
    </note>
    <char style="wj">pèdi, pou peye kon pri a, pwòp nanm li?</char><verse eid="LUK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 9:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:26 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:23">Mat 10:23</ref>
      </char>
    </note>
    <char style="wj">“Paske Nenpòt moun ki wont Mwen, ak pawòl Mwen yo, a li menm, Fis a Lòm nan va wont lè Li vini nan glwa Li, ak glwa a Papa a, e glwa a zanj sen yo. </char><verse eid="LUK 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 9:27"/>
    <char style="wj">“Men Mwen di nou anverite, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:27 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:28">Mat 16:28</ref>
      </char>
    </note>
    <char style="wj">gen nan sila yo ki kanpe la a ki p ap goute lanmò jouk lè ke yo wè wayòm Bondye a.” </char><verse eid="LUK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>Anviwon uit jou aprè pawòl sa yo, <note caller="+" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="MAT 17:1-8">Mat 17:1-8</ref></char></note>Li te pran Pierre avèk Jean, avèk Jacques, e te monte nan mòn nan pou priye.<verse eid="LUK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 9:29"/>Pandan Li t ap <note caller="+" style="x"><char style="xo" closed="false">9:29 </char><char style="xt" closed="false"><ref loc="LUK 3:21">Luc 3:21</ref></char></note>priye, aspè figi Li te vin chanje, e vètman Li te vin klere kon blan briyan. <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>Epi gade, de zòm t ap pale avèk Li. Se te Moïse avèk Elie, <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>ki te vin parèt nan glwa, e t ap pale sou afè <note caller="+" style="x"><char style="xo" closed="false">9:31 </char><char style="xt" closed="false"><ref loc="2PE 1:15">II Pi 1:15</ref></char></note>depa Li, ke Li te prèt pou acheve nan Jérusalem.<verse eid="LUK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 9:32"/>Alò, Pierre avèk lòt parèy li yo te vin <note caller="+" style="x"><char style="xo" closed="false">9:32 </char><char style="xt" closed="false"><ref loc="MAT 26:43">Mat 26:43</ref></char></note>lou ak dòmi. Men lè zye pa yo te vin ouvri, yo te wè glwa Li ak de zòm sa yo ki te kanpe avè L. <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>Konsa, Li te vin rive ke pandan sila yo t ap kite Li, Pierre te di a Jésus: “Mèt, li bon pou nou isit la. <note caller="+" style="x"><char style="xo" closed="false">9:33 </char><char style="xt" closed="false"><ref loc="MAT 17:4">Mat 17:4</ref></char></note>Annou fè twa tabènak; youn pou Ou, youn pou Moïse, e youn pou Elie.” Men li pa t fin konprann sa li t ap di a.<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>Pandan li t ap di sa, yon nyaj te fòme. Li te pase yon lonbraj sou yo, epi yo te krent lè yo te antre nan lonbraj la.<verse eid="LUK 9:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 9:35"/>Answit yon vwa te sòti nan lonbraj la. Li te di: <note caller="+" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="ISA 42:1">És 42:1</ref></char></note>“Sa se fis byeneme Mwen an; koute Li!”<verse eid="LUK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36"/>Lè vwa a te pale, Jésus te twouve li sèl. Yo te <note caller="+" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="MAT 17:9">Mat 17:9</ref></char></note>rete an silans, e pa t di pèsonn sa ki te rive nan jou sa yo.<verse eid="LUK 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:37 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 17:14-18">Mat 17:14-18</ref>
      </char>
    </note>Nan jou swivan an, lè yo te desann sòti nan mòn nan, yon gwo foul te rankontre Li. <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>Konsa yon mesye nan foul la te rele fò: “Mèt, mwen sipliye ou pou gade wè fis mwen an, paske se li sèl gason ke m genyen. <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>Yon lespri konn sezi li. Li rele fò, lespri a jete li nan gwo kriz ki fè bouch li kimen, e pandan lespri a ap kite li, li kontinye maspinen l nèt jiskaske li ale. <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>Mwen te sipliye disip ou yo pou chase l, men yo pa t kapab.”<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>Jésus te reponn: <char style="wj">“O jenerasyon enkredil, e pèvès! Pou jis kilè M ap avèk nou, pou sipòte nou? Mennen pitit ou a isit la.”</char><verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>Pandan Li t ap pwoche, dyab la te voye l atè, e te jete l nan yon gwo kriz. Men Jésus te repwòche lespri enpi a; Li te geri gason an, e te remèt li bay papa l.<verse eid="LUK 9:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 9:43"/>Yo tout te etone akoz grandè Bondye.</para>
  <para style="p" vid="LUK 9:43">
    <note caller="+" style="x">
      <char style="xo" closed="false">9:43 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 17:22">Mat 17:22</ref>
      </char>
    </note>Men pandan tout t ap admire tout sa ke Li t ap fè, Li te di a disip Li yo: <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/><char style="wj">“Kite pawòl sa yo penetre nan zòrèy nou; </char><note caller="+" style="x"><char style="xo" closed="false">9:44 </char><char style="xt" closed="false"><ref loc="LUK 9:22">Luc 9:22</ref></char></note><char style="wj">paske Fis a Lòm nan va livre nan men a lèzòm.”</char><verse eid="LUK 9:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 9:45"/>Men <note caller="+" style="x"><char style="xo" closed="false">9:45 </char><char style="xt" closed="false"><ref loc="MRK 9:32">Mc 9:32</ref></char></note>yo pa t konprann pawòl sila a, e sans li te kache a yo menm pou yo pa t kab konprann li. Yo te pè kesyone L sou pawòl sa a.<verse eid="LUK 9:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:46 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">Luc 22:24</ref>
      </char>
    </note>Konsa, yon gwo diskisyon te leve pami yo sou kilès nan yo ki ta pi gran.<verse eid="LUK 9:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 9:47"/>Men Jésus, byen <note caller="+" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 9:4">Mat 9:4</ref></char></note>okouran a sa yo t ap panse nan kè yo a, te pran yon timoun. Li te mete li kanpe akote Li. <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat 10:40</ref></char></note><char style="wj">“Nenpòt moun ki resevwa timoun sa a nan non Mwen an resevwa Mwen; e nenpòt moun ki resevwa Mwen, resevwa Papa a, ki te voye Mwen an. Paske sila ki pi piti pami nou an, se li menm ki pi gran.” </char><verse eid="LUK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:49 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:38-40">Mc 9:38-40</ref>
      </char>
    </note>Jean te reponn. Li te di: “Mèt, nou te wè yon moun ki t ap chase dyab nan non Ou, e nou te eseye anpeche li akoz ke li p ap swiv ak nou.”<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>Men Jésus te di l: <char style="wj">“Pa anpeche li</char><note caller="+" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 12:30">Mat 12:30</ref></char></note><char style="wj">paske sila ki pa kont nou an pou nou.” </char><verse eid="LUK 9:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>Lè jou yo t ap pwoche pou L te leve, li te pran desizyon nèt <note caller="+" style="x"><char style="xo" closed="false">9:51 </char><char style="xt" closed="false"><ref loc="LUK 13:22">Luc 13:22</ref></char></note>pou ale Jérusalem. <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>Li te voye mesaje yo devan Li. Konsa, yo te ale antre nan yon vil a <note caller="+" style="x"><char style="xo" closed="false">9:52 </char><char style="xt" closed="false"><ref loc="MAT 10:5">Mat 10:5</ref></char></note>Samariten yo, pou fè aranjman pou li.<verse eid="LUK 9:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 9:53"/>Men yo pa t resevwa Li <note caller="+" style="x"><char style="xo" closed="false">9:53 </char><char style="xt" closed="false"><ref loc="JHN 4:9">Jn 4:9</ref></char></note>akoz ke Li t ap vwayaje ak figi Li fikse vè Jérusalem.<verse eid="LUK 9:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 9:54"/>Lè Jacques avèk Jean te wè sa, yo te di: “Senyè, èske Ou ta vle nou <note caller="+" style="x"><char style="xo" closed="false">9:54 </char><char style="xt" closed="false"><ref loc="2KI 1:9-16">II Wa 1:9-16</ref></char></note>kòmande dife sòti nan syèl la pou devore yo?”<verse eid="LUK 9:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55"/>Men Li te vire e te reprimande yo: <char style="wj">“Nou pa konnen de ki kalite lespri nou ye;</char> <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/><char style="wj">paske Fis a Lòm nan pa t vini pou detwi lavi moun, men pou sove yo.” </char> Konsa, yo te kontinye pou ale nan yon lòt vil.<verse eid="LUK 9:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>Pandan yo t ap prale akote wout la, <note caller="+" style="x"><char style="xo" closed="false">9:57 </char><char style="xt" closed="false"><ref loc="MAT 8:19-22">Mat 8:19-22</ref></char></note>yon moun te di Li: “Mwen va swiv Ou Nenpòt kote Ou ale.”<verse eid="LUK 9:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58"/>Jésus te di Li: <char style="wj">“Rena yo gen twou yo, e zwazo yo gen nich yo, men</char> <note caller="+" style="x"><char style="xo" closed="false">9:58 </char><char style="xt" closed="false"><ref loc="MAT 8:20">Mat 8:20</ref></char></note><char style="wj">Fis a Lòm nan pa gen kote pou poze tèt Li.” </char><verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>Konsa, Li te di a yon lòt: <note caller="+" style="x"><char style="xo" closed="false">9:59 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note><char style="wj">“Swiv Mwen”. </char></para>
  <para style="p" vid="LUK 9:59">Men li te di: “Kite m ale avan pou antere papa m.”<verse eid="LUK 9:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60"/>Men Li te di li: <char style="wj">“Kite mò yo antere mò yo; men pou ou menm, ale</char><note caller="+" style="x"><char style="xo" closed="false">9:60 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note><char style="wj">pwoklame toupatou wayòm Bondye a.” </char><verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>Yon lòt osi te di: “Mwen va swiv Ou Senyè; men <note caller="+" style="x"><char style="xo" closed="false">9:61 </char><char style="xt" closed="false"><ref loc="1KI 19:20">I Wa 19:20</ref></char></note>kite m dabò di orevwa a moun lakay mwen.”<verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>Men Jésus te di li: <note caller="+" style="x"><char style="xo" closed="false">9:62 </char><char style="xt" closed="false"><ref loc="PHP 3:13">Fil 3:13</ref></char></note><char style="wj">“Nenpòt moun ki mete men li sou cha a pou gade pa dèyè pa dign de wayòm Bondye a.” </char><verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>Alò, apre sa, Senyè a te nonmen swasann-dis <note caller="+" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="LUK 9:1-52">Luc 9:1-52</ref></char></note>lòt. Li te voye yo <note caller="+" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="MRK 6:7">Mc 6:7</ref></char></note>de pa de devan Li nan chak vil ak andwa kote Li menm te gen pou vini.<verse eid="LUK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 10:2"/>Li t ap di yo: <note caller="+" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MAT 9:37-38">Mat 9:37-38</ref></char></note><char style="wj">“Rekòlt la anpil, men ouvriye yo piti. Konsa, sipliye Senyè rekòlt la pou L voye ouvriye nan chan rekòlt Li a. </char><verse eid="LUK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 10:3"/>
    <char style="wj">“Ale fè wout nou!</char> <note caller="+" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">Mat 10:16</ref></char></note><char style="wj">Veye byen, Mwen voye nou tankou jenn mouton nan mitan lou. </char> <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/><note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="MAT 10:9-14">Mat 10:9-14</ref></char></note><char style="wj">Pa pote bous, ni sak, ni soulye. Pa menm salye pèsonn nan wout la. </char><verse eid="LUK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5"/>
    <char style="wj">“‘Nan nenpòt kay ke nou antre, premyèman mande pou Lapè rete sou kay sa a’. </char> <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/><char style="wj">Si yon nonm lapè a la, lapè nou va rete sou li; men si li pa la, li va retounen sou nou. </char> <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/><char style="wj">Rete nan kay sa a. Manje e bwè sa ke yo mete devan nou; paske</char> <note caller="+" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="MAT 10:10">Mat 10:10</ref></char></note><char style="wj">ouvriye a dign de salè li. Pa kontinye pase de kay an kay. </char><verse eid="LUK 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8"/>
    <char style="wj">“Nan Nenpòt vil ke nou antre, e yo resevwa nou, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:8 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:27">I Kor 10:27</ref>
      </char>
    </note>
    <char style="wj">manje sa yo mete devan nou. </char> <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/><char style="wj">Geri sila yo ki malad nan li. Di yo: </char><note caller="+" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat 3:2</ref></char></note><char style="wj">Wayòm syèl la gen tan vin toupre nou”. </char><verse eid="LUK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 10:10"/>
    <char style="wj">“Men nan Nenpòt vil ke nou antre, si yo pa resevwa nou, tou ale nan lari yo e di: </char> <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/><note caller="+" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 10:14">Mat 10:14</ref></char></note><char style="wj">Menm pousyè vil nou an ki kole nan pye nou, nou siye li kont nou menm. Men konnen sa byen; ke wayòm syèl la gen tan vin toupre nou.” </char><verse eid="LUK 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 10:12"/>
    <char style="wj">“Mwen di nou, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:12 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 19:24-28">Jen 19:24-28</ref>
      </char>
    </note>
    <char style="wj">li va pi tolerab nan jou sa pou Sodome ke pou vil sa a. </char><verse eid="LUK 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:13 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 11:21-23">Mat 11:21-23</ref>
      </char>
    </note>
    <char style="wj">“Malè a nou menm, Chorazin! Malè a nou menm, Bethsaïde! Paske si mirak ki te fèt nan nou yo te konn fèt nan Tyr avèk Sidon, yo t ap vin repanti lontan sa, e vin chita nan sann abiye ak twal sak. </char><verse eid="LUK 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 10:14"/>
    <char style="wj">“Men li va pi tolerab pou</char> <note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="MAT 11:21">Mat 11:21</ref></char></note><char style="wj">Tyr ak Sidon nan jijman an, pase pou nou menm. </char><verse eid="LUK 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 10:15"/>
    <char style="wj">“Epi nou menm, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:15 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 14:13-15">És 14:13-15</ref>
      </char>
    </note>
    <char style="wj">Capernaüm, nou p ap egzalte nan syèl la, men nou ap jete anba nan sejou mò yo. </char><verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:40">Mat 10:40</ref>
      </char>
    </note>
    <char style="wj">“Sila ki koute nou an, koute Mwen; e sila ki rejte nou an, rejte Mwen. E sila ki rejte Mwen an, rejte Sila a ki voye Mwen an.” </char><verse eid="LUK 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>Swasann-dis yo te retounen avèk jwa. Yo te di: “Senyè, menm <note caller="+" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="LUK 9:1">Luc 9:1</ref></char></note>dyab yo soumèt a nou menm nan non Ou”.<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>Li te di yo: <char style="wj">“Mwen t ap gade </char><note caller="+" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="MAT 4:10">Mat 4:10</ref></char></note><char style="wj">Satan k ap tonbe soti nan syèl la tankou yon kout loraj. </char> <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/><char style="wj">Veye byen, Mwen bannou otorite pou</char><note caller="+" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="PSA 91:13">Sòm 91:13</ref></char></note><char style="wj">mache sou sèpan avèk eskòpyon anba pye nou, sou tout pouvwa a lènmi an, e anyen p ap fè nou mal. </char><verse eid="LUK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 10:20"/>
    <char style="wj">“Malgre sa, pa rejwi nan sa, ke lespri yo soumèt a nou menm, men rejwi paske</char> <note caller="+" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="EXO 32:32">Egz 32:32</ref></char></note><char style="wj">non nou ekri nan syèl la.”</char><verse eid="LUK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 11:25-27">Mat 11:25-27</ref>
      </char>
    </note>Nan menm moman an, Li te rejwi anpil nan Lespri Sen an. Li te di: <char style="wj">“Mwen louwe Ou, o Papa, Senyè a syèl la avèk tè a, Ke Ou kache bagay sa yo devan saj yo ak entèlijan yo pou revele yo a zanfan yo. Wi, Papa, paske konsa sa te fè plezi nan zye Ou.” </char><verse eid="LUK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:22 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 3:35">Jn 3:35</ref>
      </char>
    </note>
    <char style="wj">Tout bagay te livre a Mwen menm pa Papa M, e</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:22 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 10:15">Jn 10:15</ref>
      </char>
    </note>
    <char style="wj">pèsòn pa konnen ki moun Fis la ye, sof ke Papa a, e ki moun Papa a ye, sof ke Fis la, ak Nenpòt moun ke Fis la revele L. </char><verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:16-17">Mat 13:16-17</ref>
      </char>
    </note>Li te vire vè disip yo Li te di an prive: <char style="wj">“Beni se zye ki wè bagay ke nou gen tan wè a. </char> <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/><char style="wj">Paske Mwen di nou, ke anpil nan pwofèt avèk wa yo te vle wè bagay ke nou wè yo, men yo pa t wè yo, ni tande bagay ke nou tande yo, e yo pa t tande yo.” </char><verse eid="LUK 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:25 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:16-19">Mat 19:16-19</ref>
      </char>
    </note>Epi vwala, yon sèten avoka te kanpe pou pase l nan leprèv. Li te di L: “Mèt, kisa pou m ta fè pou eritye lavi etènèl?”<verse eid="LUK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26"/>Li te pale li: <char style="wj">“Kisa ki ekri nan Lalwa a? Kijan ou li li?” </char><verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>Li te reponn:</para>
  <para style="q1" vid="LUK 10:27">
    <note caller="+" style="x">
      <char style="xo" closed="false">10:27 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:5">Det 6:5</ref>
      </char>
    </note> “Ou va renmen Senyè a, Bondye ou a</para>
  <para style="q2" vid="LUK 10:27">avèk tout kè ou, avèk tout nanm ou, avèk tout fòs ou,</para>
  <para style="q2" vid="LUK 10:27">e avèk tout panse ou, epi vwazen ou tankou tèt ou.”<verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>Li te di li: <char style="wj">“Ou reponn byen kòrèk.</char> <note caller="+" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="LEV 18:5">Lev 18:5</ref></char></note><char style="wj">Fè sa, e ou va viv.” </char><verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>Men li te vle <note caller="+" style="x"><char style="xo" closed="false">10:29 </char><char style="xt" closed="false"><ref loc="LUK 16:15">Luc 16:15</ref></char></note>jistifye tèt li. Li te di a Jésus, “E kilès ki vwazen mwen?”<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>Jésus te reponn e te di: <char style="wj">“Yon sèten mesye t ap</char> <note caller="+" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="LUK 18:31">Luc 18:31</ref></char></note><char style="wj">desann sòti Jérusalem pou rive Jéricho. Li te tonbe pami vòlè yo. Yo te pran rad li. Yo te bat li, e yo te kite l mwatye mouri. </char><verse eid="LUK 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 10:31"/>
    <char style="wj">“Konsa, pa aza, yon sèten prèt t ap desann nan wout sa a. Lè l te wè li, li te vin pase sou lòtbò wout la. </char><verse eid="LUK 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 10:32"/>
    <char style="wj">“Menm jan an, yon Levit tou, lè l te rive kote a, li te wè l, e te vin pase sou lòtbò. </char><verse eid="LUK 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 10:33"/>
    <char style="wj">“Men yon sèten</char> <note caller="+" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="MAT 10:5">Mat 10:5</ref></char></note><char style="wj">Samariten, ki t ap fè yon vwayaj, te rive sou li. Lè l te wè l, li te gen konpasyon. </char> <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/><char style="wj">Li te vini kote li, te mete lwil avèk diven sou blesi li yo, e te panse yo. Li te vin mete li sou pwòp bèt pa li, e te mennen li nan yon pansyon pou l pran swen li. </char> <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/><char style="wj">Nan landemen, li te rale kòb de denye. Li te bay yo a mèt otèl la e te di l: ‘Pran swen li, epi nenpòt sa ke ou depanse, lè m tounen, mwen va remèt ou li.’</char><verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>
    <char style="wj">“Kilès nan twa sa yo ou kwè ki te fè prèv ke se te yon bon vwazen a mesye ki te tonbe nan men vòlè yo?” </char><verse eid="LUK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37"/>Li te reponn: “Sila ki te gen konpasyon pou li a.” Konsa Jésus te di l: <char style="wj">“Ale fè menm bagay la”. </char><verse eid="LUK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>Pandan yo t ap vwayaje, Li te antre nan yon sèten vil. Konsa, yon fanm yo rele <note caller="+" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 10:40">Luc 10:40</ref></char></note> Marthe te resevwa Li lakay li.<verse eid="LUK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 10:39"/>Li te gen yon sè yo te rele <note caller="+" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="LUK 10:42">Luc 10:42</ref></char></note>Marie, ki anplis t ap koute pawòl Senyè a, byen chita nan pye Li. <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>Men <note caller="+" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="LUK 10:38-41">Luc 10:38-41</ref></char></note>Marthe te gen tèt chaje akoz tout sèvis lakay yo. Li te pwoche Jésus, e te di: “Senyè, èske sa pa fè Ou anyen ke sè m nan kite m ap fè tout sèvis la pou kont mwen? Alò, di l vin ede m.”<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>Men Senyè a te reponn li, e te di: <char style="wj">“Marthe, Marthe, ou </char><note caller="+" style="x"><char style="xo" closed="false">10:41 </char><char style="xt" closed="false"><ref loc="MAT 6:25">Mat 6:25</ref></char></note><char style="wj">enkyete e twouble pa anpil bagay,</char> <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/><note caller="+" style="x"><char style="xo" closed="false">10:42 </char><char style="xt" closed="false"><ref loc="PSA 27:4">Sòm 27:4</ref></char></note><char style="wj">men se yon sèl bagay ki nesesè. Marie te chwazi sila ki bon an, e sa p ap retire soti nan men li.” </char><verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>Li te rive ke pandan Li t ap priye nan yon sèten kote, lè L te fini, youn nan disip Li yo te di Li: Senyè, montre nou kijan pou nou priye, menm jan ke Jean osi te montre disip li yo.<verse eid="LUK 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2"/>Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="MAT 6:9-13">Mat 6:9-13</ref></char></note> <char style="wj">“Lè n ap priye, di: </char></para>
  <para style="q2" vid="LUK 11:2">
    <char style="wj">‘Papa nou ki nan syèl la, </char></para>
  <para style="q2" vid="LUK 11:2">
    <char style="wj">ke non Ou kapab Sen. </char></para>
  <para style="q2" vid="LUK 11:2">
    <char style="wj">Ke wayòm Ou kapab vini. </char></para>
  <para style="q2" vid="LUK 11:2">
    <char style="wj">Ke volonte ou kapab fèt sou latè a, </char></para>
  <para style="q2" vid="LUK 11:2">
    <char style="wj">menm jan kon nan syèl la. </char><verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>
    <char style="wj">Bannou chak jou pen nou pou jounen an.</char><verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>
    <char style="wj">Konsa, padone peche nou yo, paske nou </char></para>
  <para style="q2" vid="LUK 11:4">
    <char style="wj">menm osi padone tout sila ki</char> <note caller="+" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="LUK 13:4">Luc 13:4</ref></char></note><char style="wj">dwe nou. </char></para>
  <para style="q2" vid="LUK 11:4">
    <char style="wj">Pa mennen nou nan tantasyon, men delivre nou de sila ki mechan an.’” </char><verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5"/>Answit, Li te di yo: <char style="wj">“Sipoze ke youn nan nou ta gen yon zanmi, e nou ale kote li a minwi pou di li: ‘Zanmi, prete m twa mòso pen. </char> <verse eid="LUK 11:5"/><verse number="6" style="v" sid="LUK 11:6"/><char style="wj">Mwen gen yon zanmi ki vini, soti nan yon vwayaj, e mwen pa gen anyen pou mete devan l.’ </char> <verse eid="LUK 11:6"/><verse number="7" style="v" sid="LUK 11:7"/><char style="wj">Depi anndan, li va di: ‘Pa deranje m! Pòt la fèmen deja. Pitit mwen yo avèk mwen menm deja nan kabann nan, e mwen pa kapab leve pou bay ou anyen.’ </char> <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/><char style="wj">Mwen di nou, menm si li p ap leve bay li anyen paske li se zanmi li, men </char><note caller="+" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="LUK 18:5">Luc 18:5</ref></char></note><char style="wj">akoz pèsistans li, l ap leve pou bay li kont sa li bezwen. </char><verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>
    <char style="wj">“Donk Mwen di nou: </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:7-11">Mat 7:7-11</ref>
      </char>
    </note>
    <char style="wj">Mande, e nou va resevwa. Chache e nou va twouve. Frape, e l ap ouvri bannou. </char> <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/><char style="wj">Paske tout moun ki mande, va resevwa. Sila a ki chache, va twouve. E a sila a ki frape, l ap ouvri. </char><verse eid="LUK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11"/>
    <char style="wj">“Alò, sipoze ke youn nan papa nou yo resevwa yon demann de fis li pou yon pen. Li p ap bay li yon wòch olye de pen. Se pa sa? O si li mande pou yon pwason, èske li va bay li yon kolèv?</char> <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/><char style="wj">Oubyen si li mande li pou bay li yon ze, èske l ap bay li yon eskòpyon? </char> <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/><note caller="+" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="MAT 7:11">Mat 7:11</ref></char></note><char style="wj">Si nou menm ki mechan, alò, konnen kijan pou bay bon kado a pitit nou yo, konbyen anplis Papa nou nan syèl la va bay Lespri Sen an a sila yo ki mande Li?” </char><verse eid="LUK 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:32-34">Mat 9:32-34</ref>
      </char>
    </note>Answit, Li t ap chase yon dyab nan yon bèbè. Lè dyab la te fin sòti, gason bèbè a te pale. Konsa, foul la te etone.<verse eid="LUK 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 11:15"/>Men kèk nan yo te di: <note caller="+" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 9:24">Mat 9:24</ref></char></note>“Li chase dyab yo pa <note caller="+" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 10:25">Mat 10:25</ref></char></note>Béelzébul, mèt dyab yo.” <verse eid="LUK 11:15"/><verse number="16" style="v" sid="LUK 11:16"/>Gen Lòt yo, pou teste L, <note caller="+" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mat 12:38</ref></char></note>t ap mande L yon sign ki sòti nan syèl la. <verse eid="LUK 11:16"/><verse number="17" style="v" sid="LUK 11:17"/><note caller="+" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="MAT 12:25-29">Mat 12:25-29</ref></char></note>Men Li te konnen panse yo. Li te di yo: <char style="wj">“Nenpòt wayòm ki divize kont tèt li va detwi. E yon kay divize kont tèt li ap tonbe. </char> <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/><note caller="+" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="MAT 4:10">Mat 4:10</ref></char></note><char style="wj">Si Satan osi divize kont tèt li, kijan wayòm li an va kanpe? Paske nou di ke Mwen chase dyab yo pa Béelzébul. </char> <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/><char style="wj">Men si Mwen menm pa </char><note caller="+" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="MAT 10:25">Mat 10:25</ref></char></note> <char style="wj">Béelzébul chase dyab yo, pa kilès fis nou yo konn chase yo? Konsa, se yo menm k ap jij nou yo.</char> <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/><char style="wj">Men, si Mwen chase dyab yo ak </char><note caller="+" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="EXO 8:19">Egz 8:19</ref></char></note><char style="wj">dwèt Bondye a, alò, </char> <note caller="+" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat 3:2</ref></char></note><char style="wj">wayòm syèl la gen tan vini sou nou. </char> <verse eid="LUK 11:20"/><verse number="21" style="v" sid="LUK 11:21"/><char style="wj">Lè yon nonm fò, plen zam, veye pwòp kay li, byen li yo rete ansekirite.</char> <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/><char style="wj">Men lè yon moun avèk plis fòs pase l vin atake l, li bat li, e li retire nan men li tout zam li yo, pou l vin divize piyaj la. </char> <verse eid="LUK 11:22"/><verse number="23" style="v" sid="LUK 11:23"/><note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 12:30">Mat 12:30</ref></char></note><char style="wj">Sila ki pa avèk Mwen an, kont Mwen; e sila ki pa rasanble avè Mwen an, ap gaye. </char> <verse eid="LUK 11:23"/><verse number="24" style="v" sid="LUK 11:24"/><note caller="+" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 12:43-45">Mat 12:43-45</ref></char></note><char style="wj">Lè lespri enpi a kite yon nonm, li travèse kote ki sèch pou chache repo. Lè l pa twouve, li di: ‘Mwen va retounen lakay mwen kote m sòti a.’</char><verse eid="LUK 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 11:25"/>
    <char style="wj">“Lè l vini, li touve l byen bale, e mete an lòd. </char> <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/><char style="wj">Answit li sòti pou chache pran sèt lòt dyab pi mal pase li menm, e yo vin antre pou viv la. Konsa, dènye eta a nonm sa a pi mal pase premye a.” </char><verse eid="LUK 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>Pandan Jésus t ap di bagay sa yo, youn nan fanm yo nan foul la te leve vwa li. Li te di Li: <note caller="+" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="LUK 23:29">Luc 23:29</ref></char></note>“Beni se vant ki te pote Ou a, e tete kote Ou te souse a.”<verse eid="LUK 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28"/>Men Li te di: <char style="wj">“Okontrè, beni se</char> <note caller="+" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="LUK 8:21">Luc 8:21</ref></char></note><char style="wj">sila yo ki tande pawòl Bondye a, e ki swiv li.” </char><verse eid="LUK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>Pandan foul la t ap ogmante, Li te kòmanse di: <note caller="+" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="MAT 16:4">Mat 16:4</ref></char></note><char style="wj">“Jenerasyon sila a se yon jenerasyon pèvès; l ap chache yon sign, men okenn sign p ap bay, sof ke sign a Jonas la. </char> <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/><char style="wj">Paske menm jan ke</char> <note caller="+" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JON 3:4">Jon 3:4</ref></char></note><char style="wj">Jonas te vin yon sign pou Ninivit yo, menm jan an Fis a Lòm nan va ye pou jenerasyon sila a. </char><verse eid="LUK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 11:31"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:31 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 10:1-10">I Wa 10:1-10</ref>
      </char>
    </note> <char style="wj">“Rèn Sid la va leve avèk lèzòm a jenerasyon sila a nan jijman, e kondane yo; akoz li menm te vini soti nan lekstremite tè a pou tande sajès a Salomon, e konsa, veye byen, gen yon bagay pi gran pase Salomon isit la. </char><verse eid="LUK 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 11:32"/>
    <char style="wj">“Lèzòm Niniv yo va kanpe avèk jenerasyon sila a nan jijman an, e kondane li, paske</char> <note caller="+" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JON 3:5">Jon 3:5</ref></char></note> <char style="wj">yo te repanti lè Jonas te preche. Konsa, veye byen, gen yon bagay pi gran ke Jonas isit la. </char><verse eid="LUK 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">Mat 5:15</ref>
      </char>
    </note> <char style="wj">“Pèsòn, lè l fin limen yon lanp pa mete li nan yon kote an kachèt, ni anba yon panyen, men sou yon chandelye, pou sila ki antre yo kapab wè limyè a. </char><verse eid="LUK 11:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 11:34"/>
    <char style="wj">“Lanp a kò nou se zye nou. Lè zye nou klè, tout kò nou osi ranpli avèk limyè; men lè l pa bon, kò nou osi ranpli avèk tenèb. </char><verse eid="LUK 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 11:35"/>
    <char style="wj">“Alò, veye ke limyè nan nou an pa tenèb. </char><verse eid="LUK 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 11:36"/>
    <char style="wj">“Si donk, tout kò nou ranpli avèk limyè, san tenèb ladann, li va klere nèt, tankou lè lanp klere nou avèk reyon li.” </char><verse eid="LUK 11:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>Alò, lè L fin pale, yon Farizyen te mande Li pou dine avè L. Li te antre e te repoze sou tab la. <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>Lè Farizyen an te wè sa, li te etone, paske Li pa t fè <note caller="+" style="x"><char style="xo" closed="false">11:38 </char><char style="xt" closed="false"><ref loc="MAT 15:2">Mat 15:2</ref></char></note> devwa lave men L avan manje a.<verse eid="LUK 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39"/>Men Senyè a te di: <note caller="+" style="x"><char style="xo" closed="false">11:39 </char><char style="xt" closed="false"><ref loc="MAT 23:25">Mat 23:25</ref></char></note> <char style="wj">“Nou menm Farizyen yo netwaye tas la pa deyò, ansanm ak plato a. Men anndan nou ranpli avèk vòl ak mechanste.</char> <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/><note caller="+" style="x"><char style="xo" closed="false">11:40 </char><char style="xt" closed="false"><ref loc="LUK 12:20">Luc 12:20</ref></char></note> <char style="wj">Nou menm bann ensanse, èske Sila ki te fè deyò a, pa t fè anndan an tou?</char> <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/><char style="wj">Men </char> <note caller="+" style="x"><char style="xo" closed="false">11:41 </char><char style="xt" closed="false"><ref loc="LUK 12:33">Luc 12:33</ref></char></note> <char style="wj">bay sa ki anndan an kòm charite, e konsa tout bagay ap </char> <note caller="+" style="x"><char style="xo" closed="false">11:41 </char><char style="xt" closed="false"><ref loc="TIT 1:15">Tit 1:15</ref></char></note><char style="wj">pwòp pou nou. </char><verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>
    <char style="wj">“Men </char> <note caller="+" style="x"><char style="xo" closed="false">11:42 </char><char style="xt" closed="false"><ref loc="MAT 23:23">Mat 23:23</ref></char></note> <char style="wj">malè a nou menm, Farizyen yo! Paske nou </char><note caller="+" style="x"><char style="xo" closed="false">11:42 </char><char style="xt" closed="false"><ref loc="LEV 27:30">Lev 27:30</ref></char></note><char style="wj">peye ladim, mant, ak lari de tout epis jaden an. Malgre sa, nou neglije lajistis avèk lanmou Bondye. Men bagay sa yo nou te dwe fè, san neglije lòt yo. </char> <verse eid="LUK 11:42"/><verse number="43" style="v" sid="LUK 11:43"/><char style="wj">Malè a nou menm, Farizyen yo! Paske nou renmen </char> <note caller="+" style="x"><char style="xo" closed="false">11:43 </char><char style="xt" closed="false"><ref loc="MAT 23:6">Mat 23:6</ref></char></note> <char style="wj">chèz a chèf nan sinagòg yo, ak salitasyon respè nan mache yo. </char> <verse eid="LUK 11:43"/><verse number="44" style="v" sid="LUK 11:44"/><char style="wj">Malè a nou menm! Paske nou tankou tonm kache, pou moun mache sou yo san ke yo pa menm konnen.” </char><verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>Youn nan <note caller="+" style="x"><char style="xo" closed="false">11:45 </char><char style="xt" closed="false"><ref loc="MAT 22:35">Mat 22:35</ref>; <ref loc="MAT 23:27">Mat 23:27</ref></char></note>avoka yo te reponn Li: “Mèt, lè Ou di sa, W ap ensilte nou osi.”<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>Konsa, Li te di: <char style="wj">“Malè a nou menm, avoka yo osi! Paske </char> <note caller="+" style="x"><char style="xo" closed="false">11:46 </char><char style="xt" closed="false"><ref loc="MAT 23:4">Mat 23:4</ref></char></note><char style="wj">nou chaje kò a moun avèk chaj ki lou, pandan nou menm, nou p ap menm manyen chaj sa yo avèk youn nan dwèt nou. </char><verse eid="LUK 11:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:47 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:29">Mat 23:29</ref>
      </char>
    </note>
    <char style="wj">“Malè a nou menm! Paske nou bati tonm a pwofèt yo, pandan se zansèt nou yo ki te touye yo. </char> <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/><char style="wj">Konsa, nou vin temwen yo, e vin dakò avèk zak a zansèt nou yo. Paske se te yo menm ki te touye yo, e se nou ki bati tonm yo. </char><verse eid="LUK 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 11:49"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:49 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 1:24-30">I Kor 1:24-30</ref>
      </char>
    </note>
    <char style="wj">“Pou rezon sa, sajès a Bondye te di: “Mwen va voye bay yo pwofèt ak apòt. Kèk yo va touye, e kèk yo va pèsekite; </char> <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/><char style="wj">jiskaske tout san a pwofèt yo ki te vèse</char> <note caller="+" style="x"><char style="xo" closed="false">11:50 </char><char style="xt" closed="false"><ref loc="MAT 25:34">Mat 25:34</ref></char></note><char style="wj">depi fondasyon mond lan kapab chaje kont jenerasyon sila a, </char> <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/><char style="wj">soti nan san Abel la, jis rive nan </char> <note caller="+" style="x"><char style="xo" closed="false">11:51 </char><char style="xt" closed="false"><ref loc="2CH 24:20-21">II Kwo 24:20-21</ref></char></note> <char style="wj">san a Zacharie, ki te peri antre nan otèl la ak kay Bondye a. Wi, Mwen di nou, li va chaje kont jenerasyon sila a. </char><verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>
    <char style="wj">“Malè a nou menm, avoka yo! Paske yo pran nan men nou kle konesans lan. Nou pa t antre nou menm, e sila ki t ap antre ladann yo, nou te anpeche yo.” </char><verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>Lè L te kite la, skrib yo avèk Farizyen yo te kòmanse vin move anpil. Yo te kesyone L byen pre sou anpil sijè, <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>paske yo t ap eseye fòme yon konplo kont Li pou kenbe L nan yon pawòl ke Li ta petèt pale.<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>Antre tan an, apre anpil milye moun te rasanble ansanm jiskaske youn t ap mache sou lòt, Li te kòmanse pale a disip Li yo dabò: <note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 16:6-11">Mat 16:6-11</ref></char></note><char style="wj">“Veye ledven Farizyen yo ki se ipokrizi. </char><verse eid="LUK 12:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 12:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:26">Mat 10:26</ref>
      </char>
    </note>
    <char style="wj">“Men pa gen anyen ki kouvri ki p ap vin parèt, e ki kache ki p ap konnen. </char> <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/><char style="wj">Konsa, Nenpòt sa ke nou di nan tenèb va tande nan limyè, e sa nou te pale ak vwa ba, menm nan chanm pa anndan yo va pwoklame sou</char> <note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="MAT 10:27">Mat 10:27</ref></char></note><char style="wj">twati kay yo. </char><verse eid="LUK 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>
    <char style="wj">“Mwen di nou, </char> <note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="JHN 15:13-15">Jn 15:13-15</ref></char></note><char style="wj">zanmi Mwen yo, pa pè sa yo ki kapab touye kò a, men apre sa pa gen plis ke yo kab fè. </char> <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/><char style="wj">“Men Mwen avèti nou kilès pou nou krent;</char> <note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="HEB 10:31">Eb 10:31</ref></char></note><char style="wj">krent Sila a ki lè L fin touye, gen otorite pou jete nan lanfè; wi, Mwen di nou, krent Li!</char><verse eid="LUK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6"/>
    <char style="wj">“Èske </char> <note caller="+" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="MAT 10:29">Mat 10:29</ref></char></note> <char style="wj">senk zwazo pa vann pou de santim? Malgre sa, nanpwen youn nan yo ki bliye devan Bondye. </char> <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/><note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 10:30">Mat 10:30</ref></char></note><char style="wj">Anverite, menm cheve nan tèt nou yo kontwole. Pa krent, nou gen bokou plis valè pase anpil zwazo. </char><verse eid="LUK 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>
    <char style="wj">“ Mwen di nou, tout sila yo ki</char> <note caller="+" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="MAT 10:32">Mat 10:32</ref></char></note><char style="wj">konfese M devan lèzòm, Fis a Lòm nan va konfese l tou devan zanj a Bondye yo;</char> <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/><char style="wj">men </char><note caller="+" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="MAT 10:33">Mat 10:33</ref></char></note><char style="wj">sila ki refize rekonèt Mwen devan lòm, va rejte devan zanj Bondye yo. </char><verse eid="LUK 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:31-32">Mat 12:31-32</ref>
      </char>
    </note>
    <char style="wj">“Epi Nenpòt moun ki pale yon mo kont Fis a Lòm nan, li va padone; men sila ki fè blasfèm kont Lespri Sen an, p ap padone. </char><verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>
    <char style="wj">“Lè yo mennen nou devan sinagòg yo, ak gwo chèf avèk otorite yo, pa</char> <note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="MAT 6:25">Mat 6:25</ref></char></note><char style="wj">twouble nou de kisa nou va pale kòm defans nou, ni kisa nou gen pou di;</char> <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/><char style="wj">paske</char> <note caller="+" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="MAT 10:20">Mat 10:20</ref></char></note><char style="wj">Lespri Sen an va montre nou nan menm lè sa a, kisa nou dwe di.”</char><verse eid="LUK 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>Yon moun nan foul la te di Li: “Mèt, pale frè m nan pou divize eritaj la avè m.”<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>Men Li te di li: <note caller="+" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="MIC 6:8">Mi 6:8</ref></char></note><char style="wj">“Mesye, kilès ki te mete M jij oswa medyatè antre nou?”</char><verse eid="LUK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 12:15"/>Answit Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="1TI 6:6-10">I Tim 6:6-10</ref></char></note><char style="wj">“Fè atansyon, e veye kont tout kalite lanvi; paske menm lè yon moun gen anpil richès, lavi li se pa sa li posede.” </char><verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>Konsa, Li te bay yo yon parabòl: <char style="wj">“Tè a pou yon sèten nonm rich te trè bon, e te pwodwi anpil.” </char><verse eid="LUK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 12:17"/>
    <char style="wj">“Epi li te kòmanse reflechi avèk pwòp tèt li: ‘Kisa pou m ta fè; akoz ke m pa gen depo pou mete rekòlt mwen yo?’</char><verse eid="LUK 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18"/>
    <char style="wj">“Answit li te di: Men kisa m ap fè; m ap retire tout depo ke m genyen yo, e m ap bati pi gwo pou mete tout rekòlt mwen yo. </char> <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/><char style="wj">Epi mwen va di a nanm mwen:</char> <note caller="+" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="ECC 11:9">Ekl 11:9</ref></char></note><char style="wj">‘Nanm, ou gen anpil byen rezève pou anpil ane; pran repo ou, manje, bwè, e rejwi ou.’”</char><verse eid="LUK 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20"/>
    <char style="wj">“Men Bondye te di l: ‘Alò nonm ensanse! Menm nwit sa a, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:20 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 27:8">Job 27:8</ref>
      </char>
    </note>
    <char style="wj">nanm ou ap rachte de ou; e</char> <note caller="+" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="PSA 39:6">Sòm 39:6</ref></char></note><char style="wj">koulye a, kilès k ap mèt a sa ou prepare yo?’</char><verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>
    <char style="wj">“Konsa se mesye la ki</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:21 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:33">Luc 12:33</ref>
      </char>
    </note>
    <char style="wj">ranmase trezò li pou li menm, men ki pa rich anvè Bondye.” </char><verse eid="LUK 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>Li te di sa a disip Li yo: <note caller="+" style="x"><char style="xo" closed="false">12:22 </char><char style="xt" closed="false"><ref loc="MAT 6:25-33">Mat 6:25-33</ref></char></note><char style="wj">“Pou rezon sa a, Mwen di nou, pa twouble pou lavi, pou sa nou va manje, ni pou kò nou, konsi, pou kijan nou ap abiye nou. </char> <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/><char style="wj">Paske lavi plis ke manje, e kò a plis ke vètman. </char><verse eid="LUK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 12:24"/>
    <char style="wj">“Konsidere</char> <note caller="+" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="JOB 38:41">Job 38:41</ref></char></note><char style="wj">kòbo yo, paske yo pa simen, ni yo pa rekòlte; epi yo pa gen depo ni pwotèj, men Bondye bay yo manje. Konbyen plis valè nou genyen pase zwazo yo. </char><verse eid="LUK 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 12:25"/>
    <char style="wj">“Epi kilès nan nou ki kab fè kè twouble a ogmante menm</char> <note caller="+" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="PSA 39:5">Sòm 39:5</ref></char></note><char style="wj">yon èdtan nan longè lavi li?</char> <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/><char style="wj">Si pou sa nou pa kapab fè menm yon ti bagay, poukisa nou fè kè twouble pou lòt bagay?</char><verse eid="LUK 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27"/>
    <char style="wj">“Konsidere flè lis yo, jan yo grandi; yo pa travay ni fè twal, men Mwen di nou ke menm</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:27 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 10:4-7">I Wa 10:4-7</ref>
      </char>
    </note>
    <char style="wj">Salomon nan tout glwa li pa t abiye li menm tankou youn nan sa yo. </char> <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/><char style="wj">Men si Bondye abiye zèb nan chan yo ki jodi a vivan, e demen ap jete nan founèz la, konbyen anplis li va abiye nou, </char><note caller="+" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="MAT 6:30">Mat 6:30</ref></char></note><char style="wj">o moun ti lafwa piti!</char><verse eid="LUK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29"/>
    <char style="wj">“Konsa, pa mande kisa nou va manje, ni kisa nou va bwè, e pa</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 6:31">Mat 6:31</ref>
      </char>
    </note>
    <char style="wj">kontinye enkyete nou. </char> <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/><char style="wj">Paske tout bagay sa yo, tout nasyon nan mond lan chache yo avèk lanvi pa yo; men Papa nou konnen ke nou bezwen bagay sa yo. </char> <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/><char style="wj">Men chache wayòm Li, e</char> <note caller="+" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="MAT 6:33">Mat 6:33</ref></char></note><char style="wj">bagay sa yo va vini a nou tou. </char><verse eid="LUK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>
    <char style="wj">“Pa krent, </char> <note caller="+" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">Jn 21:15-17</ref></char></note><char style="wj">ti bann nan, paske </char><note caller="+" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="EPH 1:5-9">Ef 1:5-9</ref></char></note><char style="wj">Papa nou te chwazi avèk jwa pou bannou wayòm nan. </char><verse eid="LUK 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 12:33"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:21">Mat 19:21</ref>
      </char>
    </note>
    <char style="wj">“Vann sa nou posede, e bay kado lacharite. Fè pou kont nou bous ki p ap janm ize, yon trezò ki p ap kab gate nan syèl la, kote vòlè pa pwoche, ni papiyon detwi. </char> <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/><char style="wj">Paske</char> <note caller="+" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 6:21">Mat 6:21</ref></char></note><char style="wj">kote trezò nou ye, se la kè nou va ye tou. </char><verse eid="LUK 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>
    <char style="wj">“Rete abiye tout tan, </char> <note caller="+" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="EPH 6:14">Ef 6:14</ref></char></note><char style="wj">byen parèt, avèk lanp nou toujou limen. </char><verse eid="LUK 12:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 12:36"/>
    <char style="wj">“Fè tankou mesye k ap tann mèt yo lè l retounen apre fèt maryaj la, pou yo kapab ouvri pòt la imedyatman lè l fin frape. </char> <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/><char style="wj">Beni se esklav sila yo ke mèt la va twouve</char> <note caller="+" style="x"><char style="xo" closed="false">12:37 </char><char style="xt" closed="false"><ref loc="MAT 24:42">Mat 24:42</ref></char></note><char style="wj">k ap byen veye lè l vini. Anverite Mwen di nou ke</char><note caller="+" style="x"><char style="xo" closed="false">12:37 </char><char style="xt" closed="false"><ref loc="LUK 17:8">Luc 17:8</ref></char></note><char style="wj">li va mare senti li pou sèvi yo. Li va fè yo repoze sou tab la, e li va vini pou bay yo sèvis. </char> <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/><note caller="+" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="MAT 24:43">Mat 24:43</ref></char></note><char style="wj">Menm si l vini nan dezyèm oubyen twazyèm lè nwit lan, e li twouve yo konsa, se beni esklav sa a va ye. </char><verse eid="LUK 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 12:39"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43-44">Mat 24:43-44</ref>
      </char>
    </note>
    <char style="wj">“Men, byen konnen sa, ke si mèt kay la te konnen a kilè vòlè a t ap vini, li pa t ap kite l kase kay la. </char> <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/><char style="wj">Nou tou, rete vijilan; paske Fis a Lòm nan ap vini nan yon</char> <note caller="+" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="LUK 12:47-48">Luc 12:47-48</ref></char></note><char style="wj">lè ke nou pa ta sipoze. </char><verse eid="LUK 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>“Pierre te di: ‘Senyè, èske W ap bay parabòl sa pou nou, oubyen <note caller="+" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="LUK 12:47-48">Luc 12:47-48</ref></char></note> pou tout lòt yo tou?’”<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>Senyè a te reponn: <char style="wj">“Alò, </char> <note caller="+" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="MAT 24:45-51">Mat 24:45-51</ref></char></note><char style="wj">kilès ki se jeran fidèl e abil ke mèt li va mete an chaj tout lòt sèvitè yo, pou bay yo manje yo nan lè li dwe fèt?</char> <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/><char style="wj">Beni se</char> <note caller="+" style="x"><char style="xo" closed="false">12:43 </char><char style="xt" closed="false"><ref loc="LUK 12:42">Luc 12:42</ref></char></note><char style="wj">esklav sila a ke mèt la twouve ap fè sa lè l vini an. </char> <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/><char style="wj">Anverite Mwen di nou ke li va mete li an chaj de tout byen li yo. </char><verse eid="LUK 12:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 12:45"/>
    <char style="wj">“Men si esklav la di nan kè l: Mèt mwen ap mize pou rive, epi li kòmanse bat esklav yo, ni fanm, ni gason, epi manje, bwè, e vin sou;</char> <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/><char style="wj">mèt esklav sa a va vini nan yon jou ke li pa prevwa, nan yon lè ke li pa konnen, e li va koupe li an mòso, e mete li yon kote avèk enkwayan yo. </char><verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>
    <char style="wj">“Alò esklav sa a ki te konnen volonte a mèt li a; men pa t prepare ni aji an akò avèk volonte l, va</char> <note caller="+" style="x"><char style="xo" closed="false">12:47 </char><char style="xt" closed="false"><ref loc="DEU 25:2">Det 25:2</ref></char></note><char style="wj">resevwa anpil kout fwèt. </char> <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/><char style="wj">Men sila ki pa t</char> <note caller="+" style="x"><char style="xo" closed="false">12:48 </char><char style="xt" closed="false"><ref loc="LEV 5:17">Lev 5:17</ref></char></note><char style="wj">konnen, men te fè zak ki te merite kou, p ap resevwa plis ke kèk. </char></para>
  <para style="p" vid="LUK 12:48">
    <char style="wj">“Pou tout sila yo ki te resevwa anpil konprann, anpil ap egzije de yo; e a sila ki te konfye anpil, a li menm y ap mande menm plis. </char><verse eid="LUK 12:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>
    <char style="wj">“Mwen vini pou voye dife sou latè; e kijan Mwen ta kontan si li te deja limen!</char><verse eid="LUK 12:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 12:50"/>
    <char style="wj">“Men Mwen gen yon</char> <note caller="+" style="x"><char style="xo" closed="false">12:50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">Mc 10:38</ref></char></note><char style="wj">batèm pou M pase, e kijan sa twouble M jiskaske li fin acheve!</char><verse eid="LUK 12:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 12:51"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:51 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:34-36">Mat 10:34-36</ref>
      </char>
    </note>
    <char style="wj">“Èske nou sipoze ke Mwen te vini pou bay lapè sou latè? Mwen di nou non, men olye sa, divizyon. </char> <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/><char style="wj">Paske depi koulye a, senk moun nan yon kay va divize, twa kont de, e de kont twa. </char> <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/><char style="wj">Yo va divize, </char> <note caller="+" style="x"><char style="xo" closed="false">12:53 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mi 7:6</ref></char></note><char style="wj">papa kont fis, e fis kont papa; manman kont fi, e fi kont manman; bèlmè kont bèlfi, e bèlfi kont bèlmè.” </char><verse eid="LUK 12:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>Li t ap di anplis a foul la: <note caller="+" style="x"><char style="xo" closed="false">12:54 </char><char style="xt" closed="false"><ref loc="MAT 16:2">Mat 16:2</ref></char></note><char style="wj">“Lè nou wè yon nwaj k ap leve nan lwès, imedyatman nou di :‘L ap fè lapli’, e se konsa sa rive. </char> <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/><char style="wj">Epi lè nou wè yon van sid k ap soufle, nou di: </char> <note caller="+" style="x"><char style="xo" closed="false">12:55 </char><char style="xt" closed="false"><ref loc="MAT 20:12">Mat 20:12</ref></char></note><char style="wj">‘L ap fè chalè’, e se konsa sa rive. </char> <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/><char style="wj">Ipokrit nou ye!</char> <note caller="+" style="x"><char style="xo" closed="false">12:56 </char><char style="xt" closed="false"><ref loc="MAT 16:3">Mat 16:3</ref></char></note><char style="wj">Nou konnen kijan pou nou analize aparans a tè a, avèk syèl la, men poukisa nou pa analize tan prezan sila a?</char><verse eid="LUK 12:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>
    <char style="wj">“</char> <note caller="+" style="x"><char style="xo" closed="false">12:57 </char><char style="xt" closed="false"><ref loc="LUK 21:30">Luc 21:30</ref></char></note><char style="wj">“Poukisa nou menm pou kont nou pa jije sa ki bon?</char> <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/><char style="wj">Paske</char> <note caller="+" style="x"><char style="xo" closed="false">12:58 </char><char style="xt" closed="false"><ref loc="MAT 5:25">Mat 5:25</ref>,<ref loc="MAT 5:26">26</ref></char></note><char style="wj">pandan nou ap rive devan majistra avèk advèsè nou, menm nan wout la, fè yon efò pou antann avè l; pou li pa mennen nou devan jij la, e jij la livre nou a ofisye jistis la, k ap jete nou nan prizon. </char> <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/><char style="wj">Mwen di nou, nou p ap sòti la jiskaske nou fin peye dènye</char> <note caller="+" style="x"><char style="xo" closed="false">12:59 </char><char style="xt" closed="false"><ref loc="MRK 12:42">Mc 12:42</ref></char></note><char style="wj">santim nan.” </char><verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>Alò, nan menm lè sa a, te gen kèk moun prezan ki te bay Li yon rapò sou Galileyen sila yo, ke <note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="MAT 27">Mat 27</ref></char></note>Pilate te mele san yo avèk sakrifis pa yo.<verse eid="LUK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 13:2"/>Jésus te reponn yo: <note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="JHN 9:2">Jn 9:2</ref></char></note><char style="wj">“Èske nou sipoze ke Galileyen sa yo te pi gwo pechè pase tout lòt Galileyen yo akoz yo te soufri sò sa a?</char> <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/><char style="wj">Mwen di nou: ‘Non’, men amwenske nou repanti, nou tout ap peri konsa. </char> <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/><char style="wj">Oubyen èske nou sipoze ke lè tou nan</char> <note caller="+" style="x"><char style="xo" closed="false">13:4 </char><char style="xt" closed="false"><ref loc="NEH 3:5">Né 3:5</ref></char></note><char style="wj">Siloé a te tonbe sou diz-uit yo, e te touye yo, ke yo te koupab pase tout lòt moun ki t ap viv Jérusalem yo?</char><verse eid="LUK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 13:5"/>
    <char style="wj">“Mwen di nou non, men amwenske nou repanti, nou tout va peri menm jan an.” </char><verse eid="LUK 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>Li te kòmanse pale parabòl sila a: <char style="wj">“Yon sèten mesye te gen yon</char> <note caller="+" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="MAT 21:19">Mat 21:19</ref></char></note><char style="wj">pye fig frans ki te plante nan chan li. Li te vini pou chache fwi sou li, e li pa t twouve anyen. </char> <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/><char style="wj">Konsa, li te di a jeran chan rezen yo: ‘Gade, depi twa lane m ap vini la pou chache fwi, sou pye sila a, san twouve anyen. </char> <note caller="+" style="x"><char style="xo" closed="false">13:7 </char><char style="xt" closed="false"><ref loc="MAT 3:10">Mat 3:10</ref></char></note> <char style="wj">Koupe retire li nèt! Poukisa menm l ap okipe espas tè a?’</char> <verse eid="LUK 13:7"/><verse number="8" style="v" sid="LUK 13:8"/><char style="wj">Li te reponn pou di l: ‘Kite li nan plas li mesye, pou lane sila a toujou, jis lè ke m fouye tè otou de li pou mete angrè. </char> <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/><char style="wj">Si li pote fwi lane pwochèn, sa bon, men si sa pa fèt, koupe l jete.’”</char><verse eid="LUK 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>Konsa, li t ap <note caller="+" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4:23</ref></char></note>enstwi nan youn nan sinagòg yo nan Saba a. <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>Epi vwala, te gen yon fanm ki t ap vèse san pandan diz-uit lane. Li te gen yon <note caller="+" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="LUK 13:16">Luc 13:16</ref></char></note>maladi ki te fèt pa yon move lespri, ki fè l koube doub, e li pa t kapab drese menm.<verse eid="LUK 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 13:12"/>Lè Jésus te wè l, Li te rele li vini. Li te di l: <char style="wj">“Fanm, ou lib de enfimite ou a”. </char> <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>Li te <note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MRK 5:23">Mc 5:23</ref></char></note>poze men Li sou li, e imedyatman, li te drese dwat ankò, e te kòmanse bay lwanj a Bondye.<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>Men ofisye sinagòg la, byen move akoz Jésus te geri nan Saba a, te di foul la kòm repons: <note caller="+" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="EXO 20:9">Egz 20:9</ref></char></note>“Gen sis jou pou travay kapab fèt. Konsa, vini pandan jou sa yo pou geri, men pa nan jou Saba a.”<verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>Men Senyè a te reponn li: <char style="wj">“Nou ipokrit, </char><note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="LUK 14:5">Luc 14:5</ref></char></note><char style="wj">èske nou chak nan Saba a pa demare bèf li, oswa bourik li sou manjwa a pou l kab mennen l al bwè?</char> <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/><char style="wj">Alò, fanm sa a, </char> <note caller="+" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="LUK 19:9">Luc 19:9</ref></char></note><char style="wj">yon fi Abraham, jan li ye a, mare pa Satan pandan diz-uit ane byen long, èske li pa t dwe lage nan chèn sila a nan jou Saba a?”</char><verse eid="LUK 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17"/>Pandan ke Li t ap di sa a, tout advèsè Li yo te imilye, men <note caller="+" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="LUK 18:43">Luc 18:43</ref></char></note>tout foul la te rejwi yo nan tout mèvèy ke Li t ap fè yo.<verse eid="LUK 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>Konsa <note caller="+" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="MAT 13:31">Mat 13:31</ref></char></note>Li t ap di: <char style="wj">“A kisa wayòm Bondye a sanble, e a kilès Mwen kapab konpare li?</char> <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/><char style="wj">Se tankou yon grenn moutad ke yon mesye te ale jete nan pwòp jaden li. Li te grandi e li te vin tounen yon pyebwa, epi</char> <note caller="+" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="EZK 17:23">Éz 17:23</ref></char></note><char style="wj">zwazo anlè yo te vin fè nich nan branch li.” </char><verse eid="LUK 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>Ankò Li te di: <note caller="+" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="MAT 13:24">Mat 13:24</ref></char></note><char style="wj">“A kilès pou M ta konpare wayòm syèl la?</char> <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/><note caller="+" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="MAT 13:33">Mat 13:33</ref></char></note><char style="wj">Se tankou ledven ke yon fanm te pran e mete nan twa mezi farin jiskaske tout te vin leve.” </char><verse eid="LUK 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>Li t ap pase de yon vil a yon lòt, pou bay enstriksyon pandan Li t ap <note caller="+" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="LUK 9:51">Luc 9:51</ref></char></note>fè wout Li vè Jérusalem. <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>Konsa, yon moun te di Li: “Senyè, èske se sèlman kèk moun k ap sove?”</para>
  <para style="p" vid="LUK 13:23">Li te reponn yo: <verse eid="LUK 13:23"/><verse number="24" style="v" sid="LUK 13:24"/><note caller="+" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="MAT 7:13">Mat 7:13</ref></char></note><char style="wj">“Fè efò pou antre pa pòt etwat la; paske anpil, Mwen di nou, va eseye antre, e yo p ap kapab. </char> <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/><char style="wj">Depi mèt kay la leve e</char><note caller="+" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="MAT 25:10">Mat 25:10</ref></char></note><char style="wj">fèmen pòt la, epi konsa, n ap kanpe deyò pou di: ‘Senyè, ouvri pou nou’. Alò, li va reponn, e va di nou:</char> <note caller="+" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="MAT 7:23">Mat 7:23</ref></char></note><char style="wj">‘Mwen pa konnen nou, ni kote nou sòti’. </char><verse eid="LUK 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26"/>
    <char style="wj">“Konsa, nou</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:26 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 3:8">Luc 3:8</ref>
      </char>
    </note>
    <char style="wj">va kòmanse di: ‘Nou te manje bwè nan prezans Ou, e Ou te enstwi nan lari nou yo.’</char><verse eid="LUK 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27"/>
    <char style="wj">“Epi Li va di: ‘Mwen di nou, Mwen pa konnen kote nou sòti. </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:27 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:8">Sòm 6:8</ref>
      </char>
    </note>
    <char style="wj">Kite Mwen, nou tout ki fè inikite.’</char> <verse eid="LUK 13:27"/><verse number="28" style="v" sid="LUK 13:28"/><char style="wj">Va gen kriye fò, ak manje dan</char><note caller="+" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat 8:12</ref></char></note><char style="wj">nan plas sa a lè nou wè Abraham, Isaac avèk Jacob ak tout pwofèt yo nan wayòm syèl la, men nou menm, k ap jete deyò. </char> <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/><char style="wj">Yo</char><note caller="+" style="x"><char style="xo" closed="false">13:29 </char><char style="xt" closed="false"><ref loc="MAT 8:11">Mat 8:11</ref></char></note><char style="wj">va sòti nan lès, ak lwès, e nan nò avèk sid, epi yo va repoze sou tab la nan wayòm syèl la. </char><verse eid="LUK 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 13:30"/>
    <char style="wj">“Gade byen, gen</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:30 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:30">Mat 19:30</ref>
      </char>
    </note>
    <char style="wj">kèk moun ki dènye ki va vin premye, e kèk moun ki premye ki va vin dènye.” </char><verse eid="LUK 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>Nan menm jou sa a, kèk Farizyen te pwoche. Yo te di L: “Ale kite isit la, paske <note caller="+" style="x"><char style="xo" closed="false">13:31 </char><char style="xt" closed="false"><ref loc="MAT 14:1">Mat 14:1</ref></char></note>Hérode vle touye Ou.”<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>Li te reponn yo: <char style="wj">“Ale di rena sa a ‘Gade, Mwen chase move lespri yo, e Mwen fè gerizon jodi a, ak demen. Epi nan twazyèm jou a </char><note caller="+" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="HEB 2:10">Eb 2:10</ref></char></note><char style="wj">bi m va fin acheve.</char> <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/><char style="wj">Malgre sa, Mwen oblije fè wout Mwen jodi a, demen ak jou apre a, paske li pa kapab fèt pou yon</char><note caller="+" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="MAT 21:11">Mat 21:11</ref></char></note><char style="wj">pwofèt ta peri andeyò Jérusalem.’”</char><verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>
    <char style="wj">O Jérusalem, Jérusalem, vil</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:41">Luc 19:41</ref>
      </char>
    </note>
    <char style="wj">ki touye pwofèt yo, e lapide sila ki te voye kote li yo! Kijan souvan Mwen te vle rasanble pitit nou yo ansanm tankou yon poul ranmase pitit li yo anba zèl li, men nou pa t fè sa!</char><verse eid="LUK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 13:35"/>
    <char style="wj">“Gade, lakay nou rete nan men nou dezole, epi Mwen di nou, nou p ap wè M ankò jiskaske nou di: </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:35 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:26">Sòm 118:26</ref>
      </char>
    </note>
    <char style="wj">‘Beni se Sila a ki vini nan non Senyè a!’”</char><verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>Li te rive ke lè L te antre lakay a youn nan dirijan Farizyen yo, nan Saba a pou manje pen, yo t ap veye L de prè.<verse eid="LUK 14:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 14:2"/>Epi la devan li, te gen yon nonm ki t ap soufri avèk maladi kò anfle.<verse eid="LUK 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 14:3"/>Konsa, Jésus te reponn e te pale avèk avoka ak Farizyen yo. Li te mande: <note caller="+" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="MAT 12:2">Mat 12:2</ref></char></note><char style="wj">“Èske se pèmi pou geri nan Saba a oubyen non?” </char><verse eid="LUK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4"/>Men yo te rete san pale. Li te kenbe li, geri li, e te voye l ale.<verse eid="LUK 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5"/>Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="MAT 12:11">Mat 12:11</ref></char></note><char style="wj">“Kilès nan nou k ap gen yon fis, oswa yon bèf tonbe nan yon pwi, ki p ap imedyatman rale l sòti nan yon jou Saba?” </char><verse eid="LUK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:6 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:46">Mat 22:46</ref>
      </char>
    </note>Epi yo pa t kapab reponn sa menm.<verse eid="LUK 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>Alò, Li te kòmanse pale an parabòl a sila ki te envite yo, lè L te wè jan yo t ap <note caller="+" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="MAT 23:6">Mat 23:6</ref></char></note>chwazi chita nan plas donè sou tab la. Li t ap di yo: <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/><char style="wj">“Lè nou envite pa yon moun nan yon fèt maryaj, </char><note caller="+" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="PRO 25:6-7">Pwov 25:6-7</ref></char></note><char style="wj">pa pran plas donè paske yon moun pi distenge pase ou kapab deja envite pa mèt la. </char> <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/><char style="wj">Epi sila ki te envite nou toulède a ka petèt vin di ou: ‘Bay plas ou a nonm sila a, e answit ak</char><note caller="+" style="x"><char style="xo" closed="false">14:9 </char><char style="xt" closed="false"><ref loc="LUK 3:8">Luc 3:8</ref></char></note><char style="wj">gwo wont, w ap vin okipe dènye plas la’. </char><verse eid="LUK 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 14:10"/>
    <char style="wj">“Men, lè nou envite, ale chita nan dènye plas la, dekwa ke lè sila a ki te envite nou an vini, li kapab di nou: ‘Zanmi</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:10 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 25:6">Pwov 25:6</ref>,<ref loc="PRO 25:7">7</ref></char>
    </note>
    <char style="wj">vin pi devan’. Konsa, nou va gen onè nan zye a tout moun ki chita sou menm tab sa a avèk nou. </char><verse eid="LUK 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 14:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:11 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 22:28">II Sam 22:28</ref>
      </char>
    </note>
    <char style="wj">“Paske tout sila yo ki leve tèt yo va vin desann, e sila yo ki desann tèt yo, va vin leve.” </char><verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>Anplis, Li te ale di a sila a ki te envite L la: <char style="wj">“Lè w ap fè yon bankè oswa yon soupe, pa envite ni zanmi ou, ni frè ou, ni fanmi ou, ni vwazen ki rich yo, otreman yo ta kab envite ou anretou, e sa va sèvi kòm rekonpans a ou menm. </char><verse eid="LUK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 14:13"/>
    <char style="wj">“Men lè w ap fè yon resepsyon, envite malere yo, sila ki bwate yo, ki kokobe yo, ak avèg yo. </char> <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/><char style="wj">Konsa ou va beni, paske yo pa gen mwayen pou remèt ou sa; paske yo va remèt ou sa nan</char><note caller="+" style="x"><char style="xo" closed="false">14:14 </char><char style="xt" closed="false"><ref loc="JHN 5:29">Jn 5:29</ref></char></note><char style="wj">rezirèksyon moun ki jis yo.” </char><verse eid="LUK 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>Lè youn nan sila ki te chita sou tab avèk Li yo te tande sa, li te di Li: <note caller="+" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="REV 19:9">Rev 19:9</ref></char></note>“Beni se tout moun ki va manje pen nan wayòm Bondye a!”<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>Men Li te di li: <char style="wj">“Yon</char><note caller="+" style="x"><char style="xo" closed="false">14:16 </char><char style="xt" closed="false"><ref loc="MAT 22:2-14">Mat 22:2-14</ref></char></note><char style="wj">mesye t ap fè yon gwo bankè, e li te envite anpil moun.</char> <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/><char style="wj">Nan lè bankè a, li te voye esklav Li pou di sila ki te envite yo: ‘Vini! Tout bagay pare koulye a.’</char><verse eid="LUK 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18"/>
    <char style="wj">“Men yo tout ansanm te kòmanse fè eskiz. </char></para>
  <para style="p" vid="LUK 14:18">
    <char style="wj">“Premye a te di li: ‘Mwen achte yon mòso tè, e Mwen bezwen ale wè l. Silvouplè, eskize mwen.’</char><verse eid="LUK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19"/>
    <char style="wj">“Yon lòt te di: ‘Mwen fenk achte senk pè bèf kabwa, e mwen pral eseye yo. Silvouplè, eskize mwen.’</char><verse eid="LUK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20"/>
    <char style="wj">“Epi Yon lòt te di: </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:20 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 24:5">Det 24:5</ref>
      </char>
    </note>
    <char style="wj">‘Mwen fenk marye ak yon fi, e pou rezon sa a, mwen pa kapab vini.’</char><verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>
    <char style="wj">“Esklav la te retounen rapòte sa a mèt li. Answit mèt kay la te vin fache, e te di a esklav li a: ‘Ale depi koulye a nan tout lari ak wout vil yo, e mennen isit la malere yo, bwate yo, avèg ak kokobe yo.’</char><verse eid="LUK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22"/>
    <char style="wj">“Konsa, esklav la te di: “Mèt, sa ou te mande gen tan fèt, e malgre sa, gen espas toujou. </char><verse eid="LUK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23"/>
    <char style="wj">“Mèt la te di a esklav la: ‘Ale nan gran ri yo ak sou kote kloti yo, epi fòse yo antre, pou kay mwen an kapab byen plen. </char> <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/><char style="wj">Paske mwen di nou ke pa gen nan moun sila yo ki te envite k ap goute manje mwen an.’” </char><verse eid="LUK 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>Alò, gwo foul la t ap prale avè l, e Li te vire di yo: <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/><note caller="+" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">Mat 10:37</ref></char></note><char style="wj">“Si Nenpòt moun vini a Mwen, e li pa rayi pwòp papa li, avèk manman li, ak madanm, ak pitit, frè, sè, wi, e menm pwòp vi li, li pa kapab disip Mwen. </char> <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/><char style="wj">Nenpòt moun ki</char><note caller="+" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat 10:38</ref></char></note><char style="wj">pa pote pwòp kwa li pou swiv Mwen, li pa kapab disip Mwen. </char><verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>
    <char style="wj">“Paske kilès nan nou lè li vle bati yon tou fòterès, pa chita avan pou kalkile frè yo pou wè si li gen kont mwayen pou fin fè l?</char> <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/><char style="wj">Otreman, lè l fin fè fondasyon an, e li p ap kab fin fè l, tout sila k ap obsève l yo ap vin pase l nan betiz. </char> <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/><char style="wj">Yo va di: ‘Mesye sa a te kòmanse bati, e li pa kapab fini.’</char><verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>
    <char style="wj">“Oubyen ki wa, lè li pati pou rankontre yon lòt wa nan batay, li p ap dabò</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:31 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:18">Pwov 20:18</ref>
      </char>
    </note>
    <char style="wj">kalkile si l ap gen ase de fòs avèk di-mil moun pou rankontre lòt la k ap vin kont li avèk ven-mil?</char> <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/><char style="wj">Otreman, pandan lòt la toujou lwen, l ap voye yon delegasyon pou mande kondisyon pou fè lapè. </char><verse eid="LUK 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 14:33"/>
    <char style="wj">“Konsa, nanpwen youn nan nou ki kapab disip Mwen si li pa</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:33 </char>
      <char style="xt" closed="false">
        <ref loc="PHP 3:7">Fil 3:7</ref>
      </char>
    </note>
    <char style="wj">renonse ak tout sa li posede. </char><verse eid="LUK 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>
    <char style="wj">“Konsa, sèl la bon; men si menm</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:13">Mat 5:13</ref>
      </char>
    </note>
    <char style="wj">sèl la, pèdi gou li, avèk kisa li va reprann gou l. </char> <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/><char style="wj">Li initil ni pou tè a, ni pou fimye a; fòk li jete. </char><note caller="+" style="x"><char style="xo" closed="false">14:35 </char><char style="xt" closed="false"><ref loc="MAT 11:5">Mat 11:5</ref></char></note><char style="wj">Sila ki gen zòrèy la, kite l tande.” </char><verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>Alò tout <note caller="+" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LUK 5:29">Luc 5:29</ref></char></note>kolektè kontribisyon yo avèk pechè yo t ap vin toupre L pou koute Li. <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>Ni Farizyen yo, ni skrib yo te kòmanse plenyen. Yo t ap di: “Mesye sa a resevwa pechè yo e <note caller="+" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="MAT 9:11">Mat 9:11</ref></char></note>manje avèk yo.”<verse eid="LUK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3"/>Donk Li te di yo parabòl sila a. Li te di: <verse eid="LUK 15:3"/><verse number="4" style="v" sid="LUK 15:4"/><note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="MAT 18:12-14">Mat 18:12-14</ref></char></note><char style="wj">“Ki moun pami nou, si li gen yon santèn mouton e li vin pèdi youn, li p ap kite Katreven-diznèf la nan chan patiraj la, pou ale dèyè sila ki pèdi a, jiskaske li twouve l?</char> <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/><char style="wj">E lè l twouve li, l ap mete l sou zepòl li, e l ap rejwi. </char> <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/><char style="wj">Lè l rive lakay li, l ap rele ansanm tout zanmi avèk vwazen li yo, e l ap di yo: ‘Rejwi avè m, paske mwen twouve mouton m ki te pèdi a!’</char><verse eid="LUK 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 15:7"/>
    <char style="wj">“Mwen di nou ke menm jan an, va gen plis jwa nan syèl la sou yon pechè ki repanti, ke sou katreven-diznèf moun ki pa bezwen repanti. </char><verse eid="LUK 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>
    <char style="wj">“Oubyen, ki fanm, si li gen dis pyès lajan, e vin pèdi youn nan yo, li p ap limen yon lanp, e bale kay la pou l chache avèk atansyon jiskaske li twouve l?</char> <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/><char style="wj">Lè l twouve l, l ap rele tout zanmi li yo ansanm, e l ap di yo: ‘Rejwi avè m, paske mwen twouve pyès lajan ke m te pèdi a!’</char><verse eid="LUK 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 15:10"/>
    <char style="wj">“Menm jan an konsa, Mwen di nou, gen lajwa</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:32">Mat 10:32</ref>
      </char>
    </note>
    <char style="wj">nan prezans zanj Bondye yo, sou yon sèl pechè ki repanti.” </char><verse eid="LUK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>Ankò li di: <char style="wj">“Yon sèten mesye te gen de fis;</char> <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/><char style="wj">Pi jenn nan te di a papa li: ‘Papa, ban m</char><note caller="+" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="DEU 21:17">Det 21:17</ref></char></note><char style="wj">pati pa m nan eritaj ki tonbe pou mwen an.’ Donk, li te</char><note caller="+" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="LUK 15:30">Luc 15:30</ref></char></note><char style="wj">divize byen li pami yo. </char><verse eid="LUK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13"/>
    <char style="wj">“Pa anpil jou apre, pi jenn fis la te rasanble tout bagay pou te fè yon vwayaj nan yon peyi byen lwen, kote li te gaspiye tout eritaj li a nan yon vi banbòch. </char> <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/><char style="wj">Alò, lè l te fin depanse tout, yon gwo grangou te parèt nan peyi sila a, e li te kòmanse vin nan bezwen. </char> <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/><char style="wj">Donk, li te ale anplwaye tèt li a yon sitwayen nan peyi sila a, e li te voye li nan chan an pou bay kochon yo manje. </char> <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/><char style="wj">Epi li te anvi plen vant li avèk po kochon yo t ap manje yo, e pèsòn pa t bay li anyen. </char><verse eid="LUK 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17"/>
    <char style="wj">“Men lè li te vin reflechi byen, li te di: ‘Konbyen nan ouvriye papa m yo ki gen kont pen, men mwen ap mouri isit la avèk grangou. </char> <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/><char style="wj">Mwen va leve ale vè papa m’, e mwen va di l: ‘Papa, mwen peche kont syèl la, e nan zye ou.</char> <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/><char style="wj">Mwen pa ankò dign pou rele fis ou. Fè m tankou youn nan anplwaye ou yo.’ </char> <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/><char style="wj">Donk, li te leve, e te ale kote papa l. </char></para>
  <para style="p" vid="LUK 15:20">
    <char style="wj">“Men pandan l te toujou byen lwen, papa li te wè li. Li te gen konpasyon pou li. Li te kouri</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:20 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 45:14">Jen 45:14</ref>
      </char>
    </note>
    <char style="wj">anbrase l e te bo li. </char> <verse eid="LUK 15:20"/><verse number="21" style="v" sid="LUK 15:21"/><char style="wj">Epi fis la te di li: ‘Papa, mwen peche kont syèl la, e nan zye ou. Mwen pa ankò dign pou m kapab rele fis ou. </char><verse eid="LUK 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22"/>
    <char style="wj">“Men papa a te di a esklav li yo: ‘Fè vit pote</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:22 </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 3:4">Za 3:4</ref>
      </char>
    </note>
    <char style="wj">pi bèl vètman ki genyen an, mete li sou li, e </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:22 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:42">Jen 41:42</ref>
      </char>
    </note>
    <char style="wj">mete yon bag nan men li ak soulye nan pye li. </char> <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/><char style="wj">Anplis mennen jenn ti bèf byen gra a; touye li, e annou manje pou fè fèt.</char> <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/><char style="wj">Paske konsa, fis mwen an te</char><note caller="+" style="x"><char style="xo" closed="false">15:24 </char><char style="xt" closed="false"><ref loc="MAT 8:22">Mat 8:22</ref></char></note><char style="wj">mouri; koulye a li vivan ankò. Li te pèdi, men mwen jwenn li ankò.’ Epi yo te kòmanse fè fèt la. </char><verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>
    <char style="wj">“Alò, pi gran fis la te nan chan an. Lè li te vin toupre kay la, li te tande mizik avèk moun k ap danse. </char> <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/><char style="wj">Li te rele youn nan sèvitè yo, e te kòmanse fè ankèt pou mande kisa bagay sa yo ta kapab ye. </char><verse eid="LUK 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 15:27"/>
    <char style="wj">“Li te di li: ‘Frè ou a vini, e papa ou touye jenn ti bèf byen gra a, paske li rejwenn li ankò sen e sof.’ </char><verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>
    <char style="wj">“Men li te vin fache, e li pa t dakò antre. Papa l te soti. Li te kòmanse plede avè l. </char><verse eid="LUK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 15:29"/>
    <char style="wj">“Men li te reponn e te di a papa l: “Gade, pandan konbyen ane m ap sèvi ou, e mwen pa janm neglije yon lòd ou; men malgre sa, ou pa janm ban mwen yon kabrit pou m ta kapab fè fèt avèk zami mwen yo.</char> <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/><char style="wj">Men lè fis sila a te vini, li menm ki devore</char><note caller="+" style="x"><char style="xo" closed="false">15:30 </char><char style="xt" closed="false"><ref loc="PRO 29:3">Pwov 29:3</ref></char></note><char style="wj">byen ou avèk pwostitiye yo, ou te touye ti bèf byen gra a, pou li. </char><verse eid="LUK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31"/>
    <char style="wj">“Papa a te di l: ‘Fis mwen, ou toujou avè m, e tout sa ke m gen se pou ou.</char> <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/><char style="wj">Men nou te dwe fè fèt, e rejwi, paske frè ou sa a</char><note caller="+" style="x"><char style="xo" closed="false">15:32 </char><char style="xt" closed="false"><ref loc="LUK 15:24">Luc 15:24</ref></char></note><char style="wj">te mouri, e li kòmanse ap viv ankò. Li te pèdi, e koulye a, li retwouve.’” </char><verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>Alò, Li t ap osi di a disip yo: <char style="wj">“Te gen yon sèten mesye rich ki te gen yon jeran. Konsa, yon rapò te vin rive ke li t ap</char><note caller="+" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="LUK 15:13">Luc 15:13</ref></char></note><char style="wj">gaspiye byen li yo. </char> <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/><char style="wj">Li te rele li, e te di li: ‘Kisa ke m tande sou ou la a? Bay yon kontwòl sou jerans ou, paske ou pa kab jeran ankò.’</char><verse eid="LUK 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3"/>
    <char style="wj">“Jeran an te di a pwòp tèt li: ‘Kisa m ta fè, paske mèt mwen ap retire jerans lan nan men mwen? Mwen pa gen ase fòs pou m fouye, e mwen wont mande lacharite. </char> <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/><char style="wj">Mwen konnen kisa mwen va fè, pou lè yo retire m nan jerans lan, pou moun yo kab resevwa m lakay pa yo a.’</char><verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>
    <char style="wj">“Konsa, li te rele chak moun ki te dwe mèt li a. Li te kòmanse di a premye a: ‘Konbyen ou dwe mèt mwen an?’</char><verse eid="LUK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6"/>
    <char style="wj">“Li te di: ‘San mezi lwil’. E li te di li: ‘Pran nòt ou e chita byen vit pou ekri senkant.’</char><verse eid="LUK 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7"/>
    <char style="wj">“Answit, li te di a yon lòt: ‘Epi konbyen ou dwe? </char></para>
  <para style="p" vid="LUK 16:7">
    <char style="wj">“Li te reponn: ‘San mezi ble.’ E li te di li: ‘Pran nòt ou pou ekri katreven.’</char><verse eid="LUK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8"/>
    <char style="wj">“Konsa, mèt la te fè konpliman a jeran enjis la, paske li te aji avèk yon koken sajès. Paske fis a laj sila yo pi koken nan relasyon a moun parèy yo pase</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:8 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 12:36">Jn 12:36</ref>
      </char>
    </note>
    <char style="wj">fis a limyè yo. </char><verse eid="LUK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>
    <char style="wj">“Mwen di nou: “Fè zanmi pou tèt nou pa mwayen a</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 6:24">Mat 6:24</ref>
      </char>
    </note>
    <char style="wj">richès enjis yo; pou lè l echwe, yo kapab resevwa nou nan kay ki etènèl yo. </char><verse eid="LUK 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 25:21-23">Mat 25:21-23</ref>
      </char>
    </note>
    <char style="wj">“Sila a ki fidèl nan yon ti bagay piti, ap fidèl osi nan bagay ki gran. E sila ki enjis nan ti bagay piti, ap enjis osi nan bagay ki gran. </char><verse eid="LUK 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 16:11"/>
    <char style="wj">“Donk, si nou pa fidèl nan sèvis</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:11 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 16:9">Luc 16:9</ref>
      </char>
    </note>
    <char style="wj">richès enjis yo, kilès ki va konfye nou vrè richès yo. </char> <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/><char style="wj">Epi si nou pa fidèl nan sèvis ak sa ki pou yon lòt, kilès ki va bannou sa ki pou nou?</char><verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:13 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 6:24">Mat 6:24</ref>
      </char>
    </note>
    <char style="wj">“Okenn sèvitè pa kapab sèvi de mèt; paske swa l ap rayi youn, e renmen lòt la, oswa l ap kenbe a youn e meprize lòt la. Nou pa kapab sèvi Bondye, ak richès yo.” </char><verse eid="LUK 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>Alò, Farizyen yo ki te <note caller="+" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="2TI 3:2">II Tim 3:2</ref></char></note>renmen lajan anpil t ap koute tout bagay sa yo, e yo t ap moke L.<verse eid="LUK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 16:15"/>Li te di yo: <char style="wj">“Nou menm se sila yo ki jistifye pwòp tèt nou nan zye lèzòm, men</char><note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="1SA 16:7">I Sam 16:7</ref></char></note><char style="wj">Bondye konnen kè nou. Paske sila ki gen gwo valè pami lèzòm yo, yo abominab nan zye Bondye. </char><verse eid="LUK 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:12">Mat 4:12</ref>
      </char>
    </note>
    <char style="wj">“Lalwa avèk pwofèt yo te pwoklame jiska Jean. Depi lè sa a </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 11:23">Mat 11:23</ref>
      </char>
    </note>
    <char style="wj">bòn nouvèl a wayòm Bondye a preche, e tout moun ap fòse antre ladann. </char> <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/><note caller="+" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">Mat 5:18</ref></char></note><char style="wj">Men li pi fasil pou syèl la avèk tè a vin disparèt pase pou yon sèl mak oubyen lèt Lalwa ta anile. </char><verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:32">Mat 5:32</ref>
      </char>
    </note>
    <char style="wj">“Nenpòt moun ki divòse ak madanm li pou marye avèk yon lòt fè adiltè; e sila a ki marye a youn ki divòse ak yon mari, fè adiltè. </char><verse eid="LUK 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>
    <char style="wj">“Alò, te gen yon sèten mesye rich ki te toujou abiye an mov ak lèn fen, e ki t ap viv nan gran richès chak jou. </char><verse eid="LUK 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 16:20"/>
    <char style="wj">“Alò, yon sèten mesye pòv ki te rele Lazare te</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:20 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 3:2">Trav 3:2</ref>
      </char>
    </note>
    <char style="wj">kouche devan pòtay li, kouvri nèt avèk maleng. </char> <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/><char style="wj">Li te byen anvi resevwa sèl ti mòso ki t ap tonbe soti sou tab mesye rich la. Anplis menm chen te konn vin pou niche maleng li yo. </char><verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>
    <char style="wj">“Epi li rive ke nonm malere a te mouri, e li te vin pote pa zanj yo pou rive nan sen</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:22 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:18">Jn 1:18</ref>
      </char>
    </note>
    <char style="wj">Abraham nan. Konsa, mesye rich la te mouri tou, e li te antere. </char> <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/><char style="wj">Nan</char><note caller="+" style="x"><char style="xo" closed="false">16:23 </char><char style="xt" closed="false"><ref loc="MAT 11:23">Mat 11:23</ref></char></note><char style="wj">plas sejou mò yo, li te nan toumant. Li te leve zye li, e te wè Abraham byen lwen, ak Lazare nan sen li. </char> <verse eid="LUK 16:23"/><verse number="24" style="v" sid="LUK 16:24"/><char style="wj">Li te kriye fò, e te di: </char><note caller="+" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="LUK 3:8">Luc 3:8</ref></char></note><char style="wj">‘Papa Abraham, fè m gras, voye Lazare pou li kapab mete dwèt li nan dlo pou rafrechi lang mwen! Paske mwen nan doulè ekstrèm nan </char><note caller="+" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="MAT 25:41">Mat 25:41</ref></char></note><char style="wj">flanm sa a. </char><verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>
    <char style="wj">“Men Abraham te di: ‘Pitit, sonje ke pandan lavi </char> <note caller="+" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="LUK 6:14">Luc 6:14</ref></char></note> <char style="wj">ou, ou te resevwa bon bagay yo. E menm jan an, Lazare te resevwa move bagay yo. Men koulye a, l ap konsole isit la, e ou menm nan gran doulè. </char> <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/><char style="wj">Anplis de sa, antre nou avèk ou menm, gen yon gran vid byen etabli pou anpeche sila isit yo ki vle travèse kote ou a, e ke pèsòn pa kapab travèse soti la a pou rive kote nou menm nan.’ </char><verse eid="LUK 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27"/>
    <char style="wj">“Pou sa li te di: ‘Alò, mwen sipliye ou Papa, pou ou voye li lakay papa m— </char> <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/><char style="wj">Pwiske mwen gen senk frè—pou li kapab </char> <note caller="+" style="x"><char style="xo" closed="false">16:28 </char><char style="xt" closed="false"><ref loc="ACT 2:40">Trav 2:40</ref></char></note><char style="wj">avèti yo, pou ke yo menm tou pa vini nan plas toumant sa a.’</char><verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>
    <char style="wj">“Men Abraham te di: ‘Yo gen </char> <note caller="+" style="x"><char style="xo" closed="false">16:29 </char><char style="xt" closed="false"><ref loc="LUK 4:17">Luc 4:17</ref></char></note> <char style="wj">Moïse avèk pwofèt yo. Kite yo tande yo.’ </char><verse eid="LUK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30"/>
    <char style="wj">“Men li te di: ‘Non. Papa Abraham, men si yon moun ta sòti nan mò a, ale kote yo, yo va repanti!’</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:30 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 3:8">Luc 3:8</ref>
      </char>
    </note><verse eid="LUK 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31"/>
    <char style="wj">“Men li te di yo: ‘Si yo pa koute Moïse avèk pwofèt yo, nonpli, yo p ap kwè menm si yon moun leve soti nan lanmò. </char><verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>Li te di a disip Li yo: <note caller="+" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="MAT 18:7">Mat 18:7</ref></char></note><char style="wj">“Li nesesè ke wòch k ap fè moun chite yo vin parèt, men malè a sila a ke atravè l sa rive!</char> <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/><note caller="+" style="x"><char style="xo" closed="false">17:2 </char><char style="xt" closed="false"><ref loc="MAT 18:6">Mat 18:6</ref></char></note><char style="wj">Li ta miyò pou li si yon wòch moulen te pann nan kou li, e te jete nan mitan lanmè, pase ke li ta fè youn nan pitit sa yo vin tonbe. </char><verse eid="LUK 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 17:3"/>
    <char style="wj">“Fè atansyon! </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:3 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:15">Mat 18:15</ref>
      </char>
    </note>
    <char style="wj">Si frè nou peche, reprimande l; e si li repanti, padone l. </char> <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/><char style="wj">Epi si li peche kont nou</char><note caller="+" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="MAT 18:21">Mat 18:21</ref></char></note><char style="wj">sèt fwa pa jou, e retounen vè nou sèt fwa pou di ‘Mwen repanti’, padone l.” </char><verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>Alò, apòt yo te di: “Senyè, fè nou gen plis lafwa!”<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>Senyè a te di: <char style="wj">“Si nou te gen lafwa tankou yon</char><note caller="+" style="x"><char style="xo" closed="false">17:6 </char><char style="xt" closed="false"><ref loc="MAT 13:31">Mat 13:31</ref></char></note><char style="wj">grenn moutad, nou ta di a pye sikomò sila a, ‘Derasine ou e ale plante ou nan lanmè;’ konsa, li ta obeyi nou. </char><verse eid="LUK 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>
    <char style="wj">“Men kilès nan nou, ki te gen yon esklav ki t ap laboure tè a, oswa k ap okipe mouton, ki va di li lè li vini soti nan chan an, vini koulye a pou chita manje?</char> <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/><char style="wj">Men èske li p ap di li: </char><note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="LUK 12:37">Luc 12:37</ref></char></note><char style="wj">‘Prepare yon bagay pou m manje; mete rad pwòp sou ou, e sèvi m pandan mwen ap manje ak bwè? E aprè, ou va manje e bwè’?</char> <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/><char style="wj">Li p ap remèsye esklav la paske li te fè bagay ki te kòmande yo. Èske se pa vrè?</char><verse eid="LUK 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 17:10"/>
    <char style="wj">“Konsa, nou menm tou lè nou fè tout bagay ke yo kòmande nou fè, nou di: ‘Nou se esklav ki pa dign; nou fè sèlman sa ke nou dwe fè.’” </char><verse eid="LUK 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>Pandan Li te nan wout vè Jérusalem, <note caller="+" style="x"><char style="xo" closed="false">17:11 </char><char style="xt" closed="false"><ref loc="LUK 9:52">Luc 9:52</ref></char></note>Li t ap pase antre Samarie ak Galilée.<verse eid="LUK 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 17:12"/>Pandan Li t ap antre nan yon sèten vilaj, dis lepre ki te <note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="LEV 13:45">Lev 13:45</ref></char></note>kanpe a yon distans te rankontre L. <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>Yo te leve vwa yo e t ap di: “Jésus, <note caller="+" style="x"><char style="xo" closed="false">17:13 </char><char style="xt" closed="false"><ref loc="LUK 5:5">Luc 5:5</ref></char></note>Mèt, fè nou gras!”<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>Lè Li te wè yo, Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Lev 14:1-32</ref></char></note><char style="wj">“Ale montre nou menm a prèt yo.” </char> Pandan yo t ap prale, yo te vin pirifye.<verse eid="LUK 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15"/>Men youn nan yo, lè l wè ke li te geri, te vire retounen e te <note caller="+" style="x"><char style="xo" closed="false">17:15 </char><char style="xt" closed="false"><ref loc="MAT 9:8">Mat 9:8</ref></char></note>bay glwa a Bondye avèk yon vwa byen fò. <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>Li te tonbe sou figi li nan pye Jésus, e t ap bay Li remèsiman. Li te yon Samariten.<verse eid="LUK 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17"/>Jésus te reponn e te di: <char style="wj">“Se pa dis ki te pirifye? Men nèf yo—-kote yo ye?</char> <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/><char style="wj">Èske pa t gen youn ki te vire tounen pou</char><note caller="+" style="x"><char style="xo" closed="false">17:18 </char><char style="xt" closed="false"><ref loc="MAT 9:8">Mat 9:8</ref></char></note><char style="wj">bay glwa a Bondye sof etranje sila a?” </char> <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>Epi Li te di li: <char style="wj">“Leve al fè wout ou.</char> <note caller="+" style="x"><char style="xo" closed="false">17:19 </char><char style="xt" closed="false"><ref loc="MAT 9:22">Mat 9:22</ref></char></note><char style="wj">Lafwa ou geri ou.” </char><verse eid="LUK 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>Alò, lè L te kesyone pa Farizyen yo sou <note caller="+" style="x"><char style="xo" closed="false">17:20 </char><char style="xt" closed="false"><ref loc="LUK 19:11">Luc 19:11</ref></char></note>kilè wayòm a Bondye a t ap vini, Li te reponn yo e te di: <char style="wj">“Wayòm syèl la p ap vini avèk sign ak mirak pou nou kab wè;</char> <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/><char style="wj">ni yo p ap</char><note caller="+" style="x"><char style="xo" closed="false">17:21 </char><char style="xt" closed="false"><ref loc="LUK 17:23">Luc 17:23</ref></char></note><char style="wj">di: ‘Men li isit la!’ Oubyen ‘men li la!’ Paske, veye byen, wayòm syèl la nan mitan nou.” </char><verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>Ankò Li te di a disip yo: <note caller="+" style="x"><char style="xo" closed="false">17:22 </char><char style="xt" closed="false"><ref loc="MAT 9:15">Mat 9:15</ref></char></note><char style="wj">“Jou yo ap vini lè nou va anvi wè youn nan jou Fis a Lòm yo, e nou p ap wè l. </char> <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/><note caller="+" style="x"><char style="xo" closed="false">17:23 </char><char style="xt" closed="false"><ref loc="MAT 24:23">Mat 24:23</ref></char></note><char style="wj">Yo va di nou: ‘Gade la! Gade isit la!’ Pa ale, e pa kouri dèyè yo. </char><verse eid="LUK 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 17:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:27">Mat 24:27</ref>
      </char>
    </note>
    <char style="wj">“Paske menm jan ak loray, lè l fè ekleraj nan yon pati nan syèl la briye jis rive nan lòt pati syèl la, se konsa Fis a Lòm nan va ye nan jou Li a. </char> <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/><note caller="+" style="x"><char style="xo" closed="false">17:25 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref></char></note><char style="wj">Men dabò, fòk li soufri anpil bagay e rejte pa jenerasyon sila a. </char><verse eid="LUK 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:26 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:37-39">Mat 24:37-39</ref>
      </char>
    </note>
    <char style="wj">“Menm jan ke sa te rive nan tan Noé a, se konsa l ap ye nan jou Fis a Lòm yo. </char> <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/><char style="wj">“Yo t ap manje, yo t ap bwè, yo t ap marye e bay nan maryaj jis rive jou ke Noé te antre nan lach la; konsa, delij la te parèt e te detwi yo tout. </char><verse eid="LUK 17:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28"/>
    <char style="wj">“Se te menm jan ke sa te rive nan</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:28 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 19">Jen 19</ref>
      </char>
    </note>
    <char style="wj">jou Lot yo; yo t ap manje, yo t ap bwè, yo t ap achte, yo t ap vann, yo t ap plante, yo t ap bati. </char><verse eid="LUK 17:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 17:29"/>
    <char style="wj">“Men nan jou ke Lot te sòti nan Sodome nan, dife avèk souf te tonbe tankou lapli e te detwi yo tout. </char><verse eid="LUK 17:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30"/>
    <char style="wj">“Li va menm jan nan jou ke Fis a Lòm nan</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:30 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:27">Mat 16:27</ref>
      </char>
    </note>
    <char style="wj">ap revele a. </char> <verse eid="LUK 17:30"/><verse number="31" style="v" sid="LUK 17:31"/><char style="wj">Nan jou sa a, sila a ki</char><note caller="+" style="x"><char style="xo" closed="false">17:31 </char><char style="xt" closed="false"><ref loc="MAT 24:17">Mat 24:17</ref></char></note><char style="wj">sou twati kay, e ki gen byen nan kay la, pa pou desann pou pran yo. Menm jan an, sila ki nan chan an pa pou vire tounen. </char><verse eid="LUK 17:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 17:32"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:32 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 19:26">Jen 19:26</ref>
      </char>
    </note>
    <char style="wj">“Sonje madanm a Lot. </char><verse eid="LUK 17:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 17:33"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:39">Mat 10:39</ref>
      </char>
    </note> <char style="wj">“Nenpòt moun ki chache sove lavi li va pèdi li, e Nenpòt moun ki pèdi lavi li va konsève l. </char><verse eid="LUK 17:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 17:34"/>
    <char style="wj">“Mwen di nou ke nan nwit sa a, ap gen de moun nan yon sèl kabann; youn ap pran, e lòt la ap rete. </char> <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/><char style="wj">Va gen de fanm k ap moulen nan menm kote a. Youn va pran, e lòt la va rete. </char> <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/><char style="wj">De mesye va nan chan an. Youn ap pran, e lòt la va rete.” </char><verse eid="LUK 17:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>Konsa yo te reponn: “Ki kote, Senyè?”</para>
  <para style="p" vid="LUK 17:37">E Li te di yo: <char style="wj">“Kote</char><note caller="+" style="x"><char style="xo" closed="false">17:37 </char><char style="xt" closed="false"><ref loc="MAT 24:28">Mat 24:28</ref></char></note><char style="wj">kadav la ye, se la votou yo va rasanble.” </char><verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>Alò, Li t ap di yo yon parabòl pou montre ke nan tout tan yo te <note caller="+" style="x"><char style="xo" closed="false">18:1 </char><char style="xt" closed="false"><ref loc="LUK 11:5-10">Luc 11:5-10</ref></char></note>dwe priye, e pa <note caller="+" style="x"><char style="xo" closed="false">18:1 </char><char style="xt" closed="false"><ref loc="2CO 4:1">II Kor 4:1</ref></char></note>dekouraje. <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>Li t ap di: <char style="wj">“Te gen nan yon sèten vil, yon jij ki pa t pè Bondye, ni pa t</char><note caller="+" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="LUK 18:4">Luc 18:4</ref></char></note><char style="wj">respekte moun. </char><verse eid="LUK 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 18:3"/>
    <char style="wj">“Alò, Te gen yon vèv nan menm vil sa a, e li te toujou ap vin kote li pou di l: ‘Ban m pwoteksyon kont advèsè mwen an.’</char><verse eid="LUK 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4"/>
    <char style="wj">“Nan kòmansman, li pa t dakò, men apre li te vin di tèt li: ‘Malgre ke m pa pè Bondye, ni</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:4 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 18:2">Luc 18:2</ref>
      </char>
    </note>
    <char style="wj">respekte moun,</char> <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/><char style="wj">men</char><note caller="+" style="x"><char style="xo" closed="false">18:5 </char><char style="xt" closed="false"><ref loc="LUK 11:8">Luc 11:8</ref></char></note><char style="wj">akoz ke vèv sa a anmède m, mwen va bay li pwoteksyon legal. Otreman li ap kontinye vin kote mwen tout tan, e l ap fatige m nèt.’” </char><verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>Epi <note caller="+" style="x"><char style="xo" closed="false">18:6 </char><char style="xt" closed="false"><ref loc="LUK 7:13">Luc 7:13</ref></char></note>Senyè a te di: <char style="wj">“Koute byen sa ke jij enjis la te vle di.</char> <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/><char style="wj">Alò, èske Bondye p ap fè jistis pou</char><note caller="+" style="x"><char style="xo" closed="false">18:7 </char><char style="xt" closed="false"><ref loc="MAT 24:22">Mat 24:22</ref></char></note><char style="wj">sila Li chwazi yo, ki kriye a Li lajounen kon lannwit, epi èske Li va</char><note caller="+" style="x"><char style="xo" closed="false">18:7 </char><char style="xt" closed="false"><ref loc="2PE 3:9">II Pi 3:9</ref></char></note><char style="wj">fè anpil reta sou yo? </char><verse eid="LUK 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 18:8"/>
    <char style="wj">“Mwen di nou ke Li va fè jistis pou yo byen vit. Sepandan lè Fis a Lòm nan vini, </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:8 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:26">Luc 17:26</ref>
      </char>
    </note>
    <char style="wj">èske Li va twouve lafwa sou latè?” </char><verse eid="LUK 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>Li te anplis pale parabòl sila a pou kèk moun ki te<note caller="+" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="LUK 16:15">Luc 16:15</ref></char></note> kwè nan tèt yo ke yo te jis, e<note caller="+" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="ROM 14:3">Wo 14:3</ref>,<ref loc="ROM 14:10">10</ref></char></note>te gade lòt yo kòm piba. <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/><char style="wj">“De mesye</char><note caller="+" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="1KI 10:5">I Wa 10:5</ref></char></note><char style="wj">te monte nan tanp lan pou priye, yon Farizyen, e lòt la yon kolektè kontribisyon.</char><verse eid="LUK 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 18:11"/>
    <char style="wj">“Farizyen an te</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 6:5">Mat 6:5</ref>
      </char>
    </note>
    <char style="wj">kanpe e t ap priye konsa a li menm: ‘Bondye, mwen remèsye Ou ke mwen pa tankou lòt moun; twonpè yo, enjis yo, adiltè yo, oswa menm tankou kolektè kontribisyon sila a.</char> <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/><char style="wj">Mwen fè jèn de fwa chak semèn. Mwen</char><note caller="+" style="x"><char style="xo" closed="false">18:12 </char><char style="xt" closed="false"><ref loc="LUK 11:42">Luc 11:42</ref></char></note><char style="wj">peye ladim sou tout sa mwen fè.’</char> <verse eid="LUK 18:12"/><verse number="13" style="v" sid="LUK 18:13"/><char style="wj">Men kolektè kontribisyon an te kanpe a yon distans, e</char><note caller="+" style="x"><char style="xo" closed="false">18:13 </char><char style="xt" closed="false"><ref loc="EZR 9:6">Esd 9:6</ref></char></note><char style="wj">pa t menm dakò pou leve zye li vè syèl la, men li</char><note caller="+" style="x"><char style="xo" closed="false">18:13 </char><char style="xt" closed="false"><ref loc="LUK 23:48">Luc 23:48</ref></char></note><char style="wj">t ap bat lestomak li, e t ap di: “Bondye, fè gras a mwen, ki pechè a. </char><verse eid="LUK 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14"/>
    <char style="wj">“Mwen di nou ke mesye sa a te desann lakay li jistifye pase lòt la, paske</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:12">Mat 23:12</ref>
      </char>
    </note>
    <char style="wj">nenpòt moun ki leve tèt li va vin imilye, e sila a ki imilye tèt li a, va vin leve.” </char><verse eid="LUK 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:15 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:13-15">Mat 19:13-15</ref>
      </char>
    </note>Alò, yo t ap pote menm tibebe bay li pou Li ta kapab touche yo, men lè disip yo te wè sa, yo te kòmanse reprimande yo.<verse eid="LUK 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 18:16"/>Men Jésus te rele yo, e te di: <char style="wj">“Kite timoun yo vin kote Mwen, e pa anpeche yo, paske wayòm Bondye a se pou sila yo ki tankou yo menm. </char><verse eid="LUK 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 18:17"/>
    <char style="wj">“Anverite, Mwen di nou: </char>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:17 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:3">Mat 18:3</ref>
      </char>
    </note>
    <char style="wj">‘Nenpòt moun ki pa resevwa wayòm Bondye a tankou yon timoun, li p ap antre ladan l menm.’”</char><verse eid="LUK 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:18 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:25-28">Luc 10:25-28</ref>
      </char>
    </note>Konsa, yon sèten direktè te kesyone L e te di: “Bon mèt, kisa pou m ta fè pou eritye lavi etènèl?”<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>Jésus te mande l: <char style="wj">“Poukisa ou rele M bon? Nanpwen pèsòn ki bon sof ke Bondye sèl. </char> <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/><char style="wj">Ou konnen kòmandman yo. </char> <note caller="+" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Egz 20:12-16</ref></char></note><char style="wj">‘Pa fè adiltè, pa touye moun, pa vòlè, pa fè fo temwayaj, onore papa ou avèk manman ou.’” </char><verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>Li te di: “Tout bagay sa yo mwen fè yo depi nan jenès mwen”.<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>Lè Jésus te tande sa, Li te di li: <char style="wj">“Yon sèl bagay ou manke toujou. </char><note caller="+" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="MAT 19:21">Mat 19:21</ref></char></note><char style="wj">Vann tout sa ke ou posede e separe yo bay malere. Konsa ou va gen richès nan syèl la, epi vin swiv Mwen.” </char><verse eid="LUK 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 18:23"/>Men lè li te tande bagay sa yo, li te vin byen tris, paske li te gen anpil richès.<verse eid="LUK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24"/>Lè l wè tristès li, Jésus te gade l, e te di: <note caller="+" style="x"><char style="xo" closed="false">18:24 </char><char style="xt" closed="false"><ref loc="MAT 19:23">Mat 19:23</ref></char></note><char style="wj">“Tèlman li difisil pou sila ki rich yo antre nan wayòm Bondye a! </char> <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/><note caller="+" style="x"><char style="xo" closed="false">18:25 </char><char style="xt" closed="false"><ref loc="MAT 19:24">Mat 19:24</ref></char></note><char style="wj">Li pi fasil pou yon chamo pase nan zye a yon egwi, pase pou yon nonm rich ta antre nan wayòm Bondye a.” </char><verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>Sila yo ki te tande sa te di: “Alò, kilès ki kapab sove?”<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>Men Li te di: <note caller="+" style="x"><char style="xo" closed="false">18:27 </char><char style="xt" closed="false"><ref loc="MAT 19:26">Mat 19:26</ref></char></note><char style="wj">“Bagay ki pa posib avèk lòm posib avèk Bondye.” </char><verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>Konsa, Pierre te di: “Gade byen, <note caller="+" style="x"><char style="xo" closed="false">18:28 </char><char style="xt" closed="false"><ref loc="LUK 5:11">Luc 5:11</ref></char></note>nou kite pwòp kay nou pou swiv Ou.”<verse eid="LUK 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29"/>Li te di yo: <char style="wj">“Anverite Mwen di nou ke</char> <note caller="+" style="x"><char style="xo" closed="false">18:29 </char><char style="xt" closed="false"><ref loc="MAT 6:33">Mat 6:33</ref></char></note><char style="wj">pa gen pèsòn ki te kite kay, oswa madanm, oswa paran, oswa zanfan yo, pou koz a wayòm syèl la, </char> <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/><char style="wj">ki p ap resevwa bokou plis nan tan sila a, e</char> <note caller="+" style="x"><char style="xo" closed="false">18:30 </char><char style="xt" closed="false"><ref loc="MAT 12:32">Mat 12:32</ref></char></note><char style="wj">nan laj k ap vini an, lavi etènèl.” </char><verse eid="LUK 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:31 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 20:17-19">Mat 20:17-19</ref>
      </char>
    </note>Answit Li te pran douz yo sou kote, e te di yo: <char style="wj">“Veye byen, n ap monte Jérusalem, e tout bagay ki te ekri pa pwofèt yo konsènan Fis a Lòm nan va vin acheve. </char> <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/><note caller="+" style="x"><char style="xo" closed="false">18:32 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref></char></note><char style="wj">Paske Li va livre a etranje yo, e li va moke, maltrete, e y ap krache sou Li. </char> <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/><char style="wj">Lè yo fin bat Li avèk fwèt, yo va touye Li. Epi nan twazyèm jou a, l ap leve ankò.” </char><verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>Men <note caller="+" style="x"><char style="xo" closed="false">18:34 </char><char style="xt" closed="false"><ref loc="MRK 9:32">Mc 9:32</ref></char></note>disip yo pa t konprann anyen nan bagay sa yo. Pawòl sa te kache a yo menm, e yo pa t konprann bagay ki t ap pale yo.<verse eid="LUK 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:35 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 20:20-34">Mat 20:20-34</ref>
      </char>
    </note>Pandan Jésus t ap pwoche Jéricho, yon sèten mesye avèg te chita akote wout la pou mande charite.<verse eid="LUK 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 18:36"/>Alò, li te tande foul la ki t ap pase, e te kòmanse mande kisa sa te ye. <verse eid="LUK 18:36"/><verse number="37" style="v" sid="LUK 18:37"/>Yo te reponn Li ke Jésus de Nazareth t ap pase.<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>Konsa, li te kòmanse rele fò, e te di: “Jésus, <note caller="+" style="x"><char style="xo" closed="false">18:38 </char><char style="xt" closed="false"><ref loc="LUK 18:38">Luc 18:38</ref>; <ref loc="MAT 9:27">Mat 9:27</ref></char></note>Fis a David la, Fè m gras!”<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>Sila yo ki t ap dirije chemen an t ap pale sevèman avè l pou fè silans; men li te kriye pi fò, “Jésus, <note caller="+" style="x"><char style="xo" closed="false">18:39 </char><char style="xt" closed="false"><ref loc="LUK 18:38">Luc 18:38</ref>; <ref loc="MAT 9:27">Mat 9:27</ref></char></note>Fis a David la, Fè m gras!”<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>Jésus te kanpe, e te bay lòd pou yo voye l kote Li. Lè l te vin toupre, Li te kesyone l: <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/><char style="wj">“Kisa ou vle M fè pou ou?” </char></para>
  <para style="p" vid="LUK 18:41">Epi Li te di: “Senyè, mwen vle vin wè ankò.”<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>Jésus te di li: <char style="wj">“Resevwa vizyon ou;</char> <note caller="+" style="x"><char style="xo" closed="false">18:42 </char><char style="xt" closed="false"><ref loc="MAT 9:22">Mat 9:22</ref></char></note><char style="wj">lafwa ou fè ou geri.” </char><verse eid="LUK 18:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43"/>Imedyatman, li te vin wè ankò. Konsa, li te kòmanse swiv Li e li t ap <note caller="+" style="x"><char style="xo" closed="false">18:43 </char><char style="xt" closed="false"><ref loc="MAT 9:8">Mat 9:8</ref></char></note>bay glwa a Bondye. Lè tout moun te wè sa, yo te bay lwanj a Bondye.<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>Li te <note caller="+" style="x"><char style="xo" closed="false">19:1 </char><char style="xt" closed="false"><ref loc="LUK 18:35">Luc 18:35</ref></char></note>antre Jéricho e t ap travèse.<verse eid="LUK 19:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 19:2"/>La te gen yon mesye yo te rele Zachée. Li te chèf a kolektè kontribisyon yo, e li te rich. <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>Zachée t ap fè efò pou ta kab wè kilès Jésus te ye, paske li te piti nan tay. <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>Donk li te kouri devan yo, e li te monte yon pyebwa ki rele<note caller="+" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="1KI 10:27">I Wa 10:27</ref></char></note>sikomò pou l ta kapab wè Li, paske Li te gen pou pase pa la.<verse eid="LUK 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5"/>Lè Jésus te rive nan lye a, Li te gade anlè, e te di: <char style="wj">“Zachée, fè vit desann, paske jodi a fòk Mwen rete lakay ou.” </char><verse eid="LUK 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6"/>Li te kouri desann, e te resevwa Li avèk jwa.<verse eid="LUK 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7"/>Lè yo te wè sa, yo tout te kòmanse plenyen pou di: “Li vin rete lakay a yon pechè.”<verse eid="LUK 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8"/>Zachée te kanpe e te di a Senyè a: “Gade byen, Senyè, menm mwatye sa ke m posede, m ap bay a malere yo, e si m te twonpe nenpòt moun de nenpòt bagay, mwen va remèt <note caller="+" style="x"><char style="xo" closed="false">19:8 </char><char style="xt" closed="false"><ref loc="EXO 22:1">Egz 22:1</ref></char></note>kat fwa sa.”<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>Jésus te di li: <char style="wj">“Jodi a delivrans gen tan vini nan kay sa a, paske li menm tou, se </char> <note caller="+" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="LUK 3:8">Luc 3:8</ref></char></note><char style="wj">yon fis Abraham. </char> <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/><char style="wj">Paske</char> <note caller="+" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="MAT 18:11">Mat 18:11</ref></char></note><char style="wj">Fis a Lòm nan vini pou chache e sove sa ki te pèdi.” </char><verse eid="LUK 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>Pandan yo t ap koute bagay sa yo, Li te kontinye bay yon parabòl, akoz ke <note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="LUK 9:51">Luc 9:51</ref></char></note>Li te toupre Jérusalem, e yo te sipoze ke <note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="LUK 17:20">Luc 17:20</ref></char></note>wayòm a Bondye a t ap parèt imedyatman. <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>Akoz sa a, Li te di: <note caller="+" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">Mat 25:14-30</ref></char></note><char style="wj">“Yon sèten prens te vwayaje nan yon peyi byen lwen pou resevwa yon wayòm pou li menm, e answit, pou li retounen. </char> <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/><char style="wj">Konsa, li te rele dis nan esklav li yo, e te bay yo dis min, e te di yo: “Fè biznis avèk sa jiskaske Mwen retounen. </char><verse eid="LUK 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14"/>
    <char style="wj">“Men sitwayen li yo te rayi li, e yo te voye yon delegasyon dèyè l pou di: ‘Nou pa vle nonm sa renye sou nou.’</char><verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>
    <char style="wj">“Lè l te retounen, apre li te resevwa wayòm nan, li te kòmande ke esklav sa yo ke li te bay kòb la, vin kote l pou li ta kapab konnen ki biznis yo te reyisi fè. </char><verse eid="LUK 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16"/>
    <char style="wj">“Premye a te parèt e te di: Mèt, min ou an fè dis min anplis.” </char><verse eid="LUK 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17"/>
    <char style="wj">“Li te di li: ‘Trè byen fèt, bon esklav! Akoz ke ou</char> <note caller="+" style="x"><char style="xo" closed="false">19:17 </char><char style="xt" closed="false"><ref loc="LUK 16:10">Luc 16:10</ref></char></note><char style="wj">fidèl nan yon ti bagay tou piti, vin pran otorite sou dis vil.’ </char><verse eid="LUK 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18"/>
    <char style="wj">“Dezyèm nan te vini, e te di: ‘Min ou an Mèt, li fè senk min anplis.’</char> <verse eid="LUK 19:18"/><verse number="19" style="v" sid="LUK 19:19"/><char style="wj">Li te di li osi: ‘E w ap vin responsab senk vil.’</char><verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20"/>
    <char style="wj">“Yon lòt te vini e te di: ‘Mèt, men min ou an ke m te konsève nan yon mouchwa;</char> <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/><char style="wj">paske mwen te pè ou, akoz ke ou menm se yon moun trè egzijan. Ou ranmase sa ke ou pa t depoze, e rekòlte sa ke ou pa t simen.’</char><verse eid="LUK 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22"/>
    <char style="wj">“Li te di li: “Esklav mechan, pa pwòp pawòl ou, mwen va jije ou. Èske ou pa t konnen ke m se yon moun egzijan, ke m ranmase sa ke m pa t depoze, e rekòlte sa ke m pa t simen?</char> <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/><char style="wj">‘Alò, poukisa ou pa t mete kòb la labank, e lè m te vini, mwen ta twouve li avèk enterè?’</char><verse eid="LUK 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>
    <char style="wj">“Answit li te di a sila ki te kanpe la yo, ‘Tou pran min li an, e bay li a sila ki gen dis la.’ </char><verse eid="LUK 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25"/>
    <char style="wj">“Men yo te di li: ‘Mèt, li gen dis deja.’</char><verse eid="LUK 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:26 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:12">Mat 13:12</ref>
      </char>
    </note>
    <char style="wj">“Mwen di nou ke a tout moun ki gen, plis y ap resevwa, men a sila a ki pa genyen an, menm sa ke li genyen an va pran nan men l. </char><verse eid="LUK 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 19:27"/>
    <char style="wj">“Men</char> <note caller="+" style="x"><char style="xo" closed="false">19:27 </char><char style="xt" closed="false"><ref loc="LUK 19:4">Luc 19:4</ref></char></note><char style="wj">lènmi M sa yo ki pa t vle M renye sou yo a, mennen yo isit la, e touye yo nan prezans mwen.” </char><verse eid="LUK 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>Lè L fin pale bagay sa yo, Li <note caller="+" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="MRK 10:32">Mc 10:32</ref></char></note>te pran devan pou monte vè Jérusalem.<verse eid="LUK 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 19:29"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:1-9">Mat 21:1-9</ref>
      </char>
    </note>Lè L te pwoche Bethphagé ak Béthanie, toupre mòn ki rele Mòn Oliv la, Li te voye de nan disip Li yo devan. <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>Li te di: <char style="wj">“Ale nan vil anfas ou a. La, pandan nou ap antre, nou va twouve yon jenn bourik, sou li, moun poko monte menm. Demare l, mennen l vin isit la. </char> <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/><char style="wj">Si Nenpòt moun mande nou poukisa nou ap demare li, se konsa nou va reponn: ‘Senyè a gen bezwen li.’” </char><verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>Donk sila ki te voye yo te ale, e yo te twouve li jan ke li te di yo a.<verse eid="LUK 19:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 19:33"/>Pandan yo t ap demare jenn bourik la, mèt li te mande yo: “Poukisa nou ap demare jenn bourik la?”<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>Yo te di: “Senyè a gen bezwen li.”<verse eid="LUK 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:35 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:4-9">Mat 21:4-9</ref>
      </char>
    </note>Yo te mennen l kote Jésus, epi yo te voye rad pa yo sou bourik la, e te mete Jésus sou li.<verse eid="LUK 19:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 19:36"/>Pandan li t ap prale, yo t ap ouvri rad yo sou wout la.<verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37"/>Lè L t ap pwoche toupre kote pou desann Mòn Oliv la, tout foul disip yo te kòmanse <note caller="+" style="x"><char style="xo" closed="false">19:37 </char><char style="xt" closed="false"><ref loc="LUK 18:43">Luc 18:43</ref></char></note>louwe Bondye avèk jwa e avèk yon gran vwa, pou tout mirak ke yo te wè yo. <verse eid="LUK 19:37"/><verse number="38" style="v" sid="LUK 19:38"/>Yo t ap rele: <note caller="+" style="x"><char style="xo" closed="false">19:38 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Sòm 118:26</ref></char></note>“Beni se Wa a ki vini nan non Senyè a! Lapè nan syèl la, avèk glwa nan trè wo a!”<verse eid="LUK 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:15">Mat 21:15</ref>
      </char>
    </note>Kèk nan Farizyen yo ki te nan foul la, te di Li: “Mèt, reprimande disip ou yo!”<verse eid="LUK 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40"/>Men Li te reponn e te di: <char style="wj">“Mwen di nou, si sila yo rete an silans, </char> <note caller="+" style="x"><char style="xo" closed="false">19:40 </char><char style="xt" closed="false"><ref loc="HAB 2:11">Hab 2:11</ref></char></note><char style="wj">menm wòch yo va pran rele.” </char><verse eid="LUK 19:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41"/>Lè l te pwoche Jérusalem Li te wè vil la e Li te komanse <note caller="+" style="x"><char style="xo" closed="false">19:41 </char><char style="xt" closed="false"><ref loc="LUK 13:34-35">Luc 13:34-35</ref></char></note>kriye sou li. <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>Li t ap di: <char style="wj">“Si ou te konnen nan jou sa, menm ou menm, bagay ki konn fè lapè! Men koulye a, bagay sa yo kache de zye ou. </char><verse eid="LUK 19:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 19:43"/>
    <char style="wj">“Paske jou yo ap vini sou ou lè lènmi ou yo va</char> <note caller="+" style="x"><char style="xo" closed="false">19:43 </char><char style="xt" closed="false"><ref loc="ECC 9:14">Ekl 9:14</ref></char></note><char style="wj">fè monte yon barikad devan ou, antoure ou, e kwense nou ladann tout kote. </char> <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/><char style="wj">Konsa, yo va raze ou a nivo latè avèk zanfan ou tout ladann. Ni</char> <note caller="+" style="x"><char style="xo" closed="false">19:44 </char><char style="xt" closed="false"><ref loc="MAT 24:2">Mat 24:2</ref></char></note><char style="wj">yo p ap kite nan ou menm yon wòch sou yon lòt, akoz ke ou pa t rekonèt lè ou te vizite a.” </char><verse eid="LUK 19:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:45 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 2:13-16">Jn 2:13-16</ref>
      </char>
    </note>Jésus te antre nan tanp lan e te kòmanse pouse mete deyò sila ki t ap vann yo, <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>Li te di yo: <char style="wj">“Li ekri. </char> <note caller="+" style="x"><char style="xo" closed="false">19:46 </char><char style="xt" closed="false"><ref loc="ISA 56:7">És 56:7</ref></char></note><char style="wj">‘Lakay Mwen va yon kay lapriyè, men nou fè l vin yon kav vòlè.’” </char><verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>Chak jou Li t ap <note caller="+" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="MAT 26:55">Mat 26:55</ref></char></note>enstwi nan tanp lan, men chèf prèt ak skrib yo avèk direktè yo pami pèp la t ap eseye detwi Li. <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>Men yo pa t kab twouve anyen ke yo ta kab fè, paske tout pèp la t ap akwoche sou chak pawòl Li te pale.<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:23-27">Mat 21:23-27</ref>
      </char>
    </note>Nan youn nan jou ke Li t ap enstwi pèp la nan tanp lan, e preche bòn nouvèl la, chèf prèt yo avèk skrib yo avèk ansyen yo te vin parèt devan Li. <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>Yo te mande Li: “Fè nou konnen pa ki otorite Ou fè bagay sa yo, oswa se kilès ki te bay Ou otorite sa a?”<verse eid="LUK 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3"/>Jésus te reponn yo: <char style="wj">“Mwen ap poze nou yon kesyon, epi fè M konnen:</char> <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/><char style="wj">Èske batèm a Jean an te sòti nan syèl la, oswa nan lòm?” </char><verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>Yo te rezone pami yo, e te di: “Si nou di ‘Nan syèl la’, l ap di: “Ebyen, poukisa nou pa t kwè li? <verse eid="LUK 20:5"/><verse number="6" style="v" sid="LUK 20:6"/>Men si nou di: ‘Nan lòm’, tout pèp la va lapide nou avèk wòch jiskaske nou mouri, paske yo konvenk ke Jean te yon <note caller="+" style="x"><char style="xo" closed="false">20:6 </char><char style="xt" closed="false"><ref loc="MAT 11:9">Mat 11:9</ref></char></note>pwofèt.” <verse eid="LUK 20:6"/><verse number="7" style="v" sid="LUK 20:7"/>Konsa, yo te reponn ke yo pa t konnen kote sa sòti.<verse eid="LUK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8"/>Jésus te reponn yo: <char style="wj">“Ni Mwen p ap di nou pa ki otorite ke M fè bagay sa yo.” </char><verse eid="LUK 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:33-46">Mat 21:33-46</ref>
      </char>
    </note> Li te kòmanse di pèp la parabòl sila a: <char style="wj">Yon mesye te plante yon chan rezen. Li te lwe li a kiltivatè yo, e li te ale nan yon vwayaj ki te dire anpil. </char> <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/><char style="wj">Nan tan rekòlt la, li te voye yon esklav kote kiltivatè yo pou yo ta kapab bay li kèk nan rekòlt chan an. Men ouvriye ki okipe lyàn rezen yo te bat li, e te voye li ale men vid. </char> <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/><char style="wj">Alò, li te eseye voye yon lòt esklav. Yo te bat li tou, e te maltrete l jiskaske se te yon eskandal. Konsa, yo te voye li ale men vid. </char> <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/><char style="wj">Konsa, li te eseye voye yon twazyèm. Sila a osi yo te blese e te mete l deyò. </char> <verse eid="LUK 20:12"/><verse number="13" style="v" sid="LUK 20:13"/><char style="wj">Mèt chan an te di: “Kisa pou m ta fè la a? M ap voye fis byeneme mwen an. Petèt yo va</char> <note caller="+" style="x"><char style="xo" closed="false">20:13 </char><char style="xt" closed="false"><ref loc="LUK 18:2">Luc 18:2</ref></char></note><char style="wj">respekte li.</char><verse eid="LUK 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14"/>
    <char style="wj">Men lè ouvriye ki te okipe lyàn rezen yo te wè li, yo te rezone youn avèk lòt konsa: ‘Sa se eritye a. Annou touye li pou eritaj la kapab pou nou.’</char> <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/><char style="wj">Donk yo te jete li deyò chan rezen an, e te touye li. Pou sa, kisa mèt chan rezen an ap fè yo?</char> <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/><char style="wj">Li va vin</char> <note caller="+" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 21:41">Mat 21:41</ref></char></note><char style="wj">detwi ouvriye chan sa yo, e li va bay chan rezen an a lòt.” </char></para>
  <para style="p" vid="LUK 20:16">Lè yo te tande li, yo te di: “Pa janm kite sa fèt!”<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>Alò, Li te gade yo, e te di: <char style="wj">“Ebyen sou kilès sa ekri:</char> <note caller="+" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="PSA 118:22">Sòm 118:22</ref></char></note></para>
  <para style="q1" vid="LUK 20:17">
    <char style="wj">‘Wòch ke sila ki t ap bati yo te rejte a;</char></para>
  <para style="q1" vid="LUK 20:17">
    <char style="wj">sila a te devni</char> <note caller="+" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="EPH 2:20">Ef 2:20</ref></char></note><char style="wj">lang prensipal la.’?</char><verse eid="LUK 20:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 20:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:44">Mat 21:44</ref>
      </char>
    </note>
    <char style="wj">Tout moun ki tonbe sou wòch sa a,</char></para>
  <para style="q1" vid="LUK 20:18">
    <char style="wj">va kraze an mòso; men sou nenpòt </char></para>
  <para style="q1" vid="LUK 20:18">
    <char style="wj">moun ke li menm tonbe, </char></para>
  <para style="q1" vid="LUK 20:18">
    <char style="wj">l ap gaye li tankou pousyè.” </char><verse eid="LUK 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>Skrib yo avèk chèf prèt yo <note caller="+" style="x"><char style="xo" closed="false">20:19 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luc 19:47</ref></char></note>te eseye mete men sou Li, nan menm lè sa a, men yo te pè pèp la. Paske yo te byen konprann ke Li te pale parabòl sa a kont yo menm. <verse eid="LUK 20:19"/><verse number="20" style="v" sid="LUK 20:20"/><note caller="+" style="x"><char style="xo" closed="false">20:20 </char><char style="xt" closed="false"><ref loc="MRK 3:2">Mc 3:2</ref></char></note>Donk yo te veye li, e te voye espyon ki te pretann ke se te moun jis yo te ye, pou yo ta kapab kenbe Li nan yon pawòl, pou yo ta kab livre Li devan lalwa a ak otorite gouvènè a. <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>Yo te poze Li kesyon. Yo te mande l: “Mèt, nou konnen ke Ou pale e enstwi byen dwat, ke Ou pa nan patipri a pèsòn, men enstwi chemen Bondye a ak verite. <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>Èske Li pèmi pou nou <note caller="+" style="x"><char style="xo" closed="false">20:22 </char><char style="xt" closed="false"><ref loc="MAT 17:5">Mat 17:5</ref></char></note>peye taks a César, oubyen non?”<verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>Men Li te konprann koken yo. Li te reponn yo: <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/><char style="wj">“Montre M yon kòb denye. Se pòtre avèk enskripsyon a kilès moun li genyen?” </char> Yo te di: “César”.<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>Li te di yo: <char style="wj">“Pou sa, </char><note caller="+" style="x"><char style="xo" closed="false">20:25 </char><char style="xt" closed="false"><ref loc="MAT 22:21">Mat 22:21</ref></char></note><char style="wj">bay a César sa ki pou César, e a Bondye, sa ki pou Bondye.” </char><verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>Yo pa t kapab <note caller="+" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="LUK 11:54">Luc 11:54</ref></char></note>kenbe L nan yon pawòl nan prezans a pèp la; e byen etone pa repons Li, yo te vin rete an silans. <verse eid="LUK 20:26"/><verse number="27" style="v" sid="LUK 20:27"/>Alò kèk nan <note caller="+" style="x"><char style="xo" closed="false">20:27 </char><char style="xt" closed="false"><ref loc="MAT 22:23-33">Mat 22:23-33</ref></char></note>Sadiseyen yo te vin kote L, (sa yo ki di ke pa gen rezirèksyon). <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>Yo te kesyone L, konsa: “Mèt, Moïse te ekri pou nou ke <note caller="+" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Det 25:5</ref></char></note>si frè a yon mesye mouri avèk yon madanm, san li pa fè pitit, frè li a ta dwe pran madanm li, e fè reyisi yon posterite pou frè li a. <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>Alò, konsa, te gen sèt frè. Premye a te pran yon madanm, e li te mouri san pitit. <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>Konsa, dezyèm nan, <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>epi twazyèm nan te pran l. Epi menm jan an, tout nan sèt yo te pran l, e tout te mouri san kite pitit. <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>Finalman, fanm nan te mouri tou. <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>Konsa, nan rezirèksyon an, se madanm a kilès l ap ye? Paske toule sèt moun yo te genyen li kòm madanm.”<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>Jésus te di yo: <char style="wj">“Fis a laj sila yo marye e bay moun nan maryaj. </char> <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/><char style="wj">Men sila yo ki konsidere dign pou rive nan laj sila a, e rezirèksyon</char> <note caller="+" style="x"><char style="xo" closed="false">20:35 </char><char style="xt" closed="false"><ref loc="MAT 12:32">Mat 12:32</ref></char></note><char style="wj">a mò yo, pa marye, ni yo pa bay moun nan maryaj.</char> <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/><char style="wj">Ni, yo pa kapab mouri ankò, paske yo tankou zanj, e se</char> <note caller="+" style="x"><char style="xo" closed="false">20:36 </char><char style="xt" closed="false"><ref loc="ROM 8:16">Wo 8:16</ref></char></note><char style="wj">fis a Bondye, fis a rezirèksyon an. </char> <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/><char style="wj">Men ke </char><note caller="+" style="x"><char style="xo" closed="false">20:37 </char><char style="xt" closed="false"><ref loc="MRK 12:26">Mc 12:26</ref></char></note><char style="wj">mò yo leve, te montre menm pa Moïse nan pasaj sou touf bwa ki t ap boule a, kote li rele Senyè a <char style="qt">Bondye Abraham nan, Bondye Isaac la ak Bondye a Jacob la.</char> Alò, Li pa Bondye a mò yo, men Bondye a vivan an, pou tout sila ki</char> <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/><char style="wj">viv de Li yo.” </char><verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>Kèk nan skrib yo te reponn e te di: “Mèt, Ou pale byen.” <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>Paske<note caller="+" style="x"><char style="xo" closed="false">20:40 </char><char style="xt" closed="false"><ref loc="MAT 22:46">Mat 22:46</ref>; <ref loc="MAT 22:32">Mat 22:32</ref></char></note>yo pa t gen kouraj pou poze L kesyon sou anyen ankò.<verse eid="LUK 20:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:41 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:41-46">Mat 22:41-46</ref>
      </char>
    </note>Alò Li te di yo, <char style="wj">“Kijan sa fèt ke yo di ke Kris la se Fis a David?</char> <verse eid="LUK 20:41"/><verse number="42" style="v" sid="LUK 20:42"/><char style="wj">Paske David, li menm di nan liv Sòm Yo:</char> <note caller="+" style="x"><char style="xo" closed="false">20:42 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Sòm 110:1</ref></char></note></para>
  <para style="q1" vid="LUK 20:42">
    <char style="wj">‘Senyè a te di a Senyè mwen an, chita bò dwat Mwen, </char><verse eid="LUK 20:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:43 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 110:1">Sòm 110:1</ref>
      </char>
    </note>
    <char style="wj">Jiskaske M fè lènmi ou yo yon ti ban pou lonje pye ou.” </char><verse eid="LUK 20:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 20:44"/>
    <char style="wj">Konsa, David rele Li Senyè, e kijan se fis Li ke li ye a?’”</char><verse eid="LUK 20:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:45 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:1-7">Mat 23:1-7</ref>
      </char>
    </note>Pandan tout pèp la t ap koute, Li te di a disip yo: <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/><char style="wj">“Fè atansyon de skrib yo </char> <note caller="+" style="x"><char style="xo" closed="false">20:46 </char><char style="xt" closed="false"><ref loc="LUK 11:43">Luc 11:43</ref></char></note><char style="wj">ki renmen mache toupatou ak gwo abiman long, e ki renmen salitasyon respè nan mache yo, ak chèz pi enpòtan nan sinagòg yo, ak plas a lonè nan bankè yo; </char> <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/><char style="wj">ki devore kay a vèv yo, e pou yo ka pran pòz, yo ofri gwo priyè long yo. Sila yo va resevwa pi gwo kondanasyon.” </char><verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:1 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 12:4-44">Mc 12:4-44</ref>
      </char>
    </note>Alò, Li leve zye li e te wè moun rich yo ki t ap mete ofrann nan bwat kès nan tanp lan. <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>Konsa, Li te wè yon sèten vèv pòv ki t ap mete <note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="MRK 12:42">Mc 12:42</ref></char></note>de ti pyès monnen an kwiv. <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>Li te di: <char style="wj">“Anverite Mwen di nou, ke fanm pòv sila a te mete plis pase yo tout;</char> <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/><char style="wj">paske yo te mete ofrann selon abondans yo; men li menm, nan povrete li, li te mete tout sa li te gen</char> <note caller="+" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="MRK 12:44">Mc 12:44</ref></char></note><char style="wj">pou l viv.” </char><verse eid="LUK 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:5 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24">Mat 24</ref>
      </char>
    </note>Alò, pandan kèk moun t ap pale de tanp lan, kijan li te byen dekore avèk bèl bijou, ak kado konsakre yo, Li te di: <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/><char style="wj">Pou bagay sa yo ke nou ap gade la a, jou a va vini lè</char> <note caller="+" style="x"><char style="xo" closed="false">21:6 </char><char style="xt" closed="false"><ref loc="LUK 19:44">Luc 19:44</ref></char></note><char style="wj">p ap rete yon sèl wòch sou lòt ki p ap chire dekonble. </char><verse eid="LUK 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>Yo te mande L: “Mèt, kilè bagay sa yo ap rive? Epi ki sign k ap demontre ke yo prèt pou rive?”<verse eid="LUK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>Li te di: <char style="wj">“Veye byen pou nou pa twonpe; paske anpil moun ap vini nan non Mwen, e yo va di: </char> <note caller="+" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="JHN 8:24">Jn 8:24</ref></char></note><char style="wj">‘Mwen se Li menm’, e, ‘Lè a toupre’. </char> <note caller="+" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="LUK 17:23">Luc 17:23</ref></char></note><char style="wj">Pa kouri dèyè yo. </char> <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/><char style="wj">Lè nou tande afè lagè, avèk boulvèsman, pa enkyete; paske fòk bagay sa yo rive avan, men lafen an poko ap rive.” </char><verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>Ankò, Li te di yo: <char style="wj">“Nasyon va leve kont nasyon, e wayòm kont wayòm.</char> <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/><char style="wj">Va gen gran tranbleman detè, e nan plizyè andwa, epidemi avèk gwo grangou. Va gen gwo laperèz avèk gwo sign ki sòti nan syèl la. </char> <verse eid="LUK 21:11"/><verse number="12" style="v" sid="LUK 21:12"/><char style="wj">Men avan tout bagay sa yo, </char> <note caller="+" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="MAT 10:19-22">Mat 10:19-22</ref></char></note><char style="wj">yo va mete men sou nou, yo va pèsekite nou, e yo va livre nou nan sinagòg avèk prizon yo. Yo va mennen nou devan wa ak gouvènè yo pou koz a non Mwen. </char> <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/><note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="PHM 1:12">Phm 1:12</ref></char></note><char style="wj">Sa va ouvri yon chemen pou temwayaj nou. </char> <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/><note caller="+" style="x"><char style="xo" closed="false">21:14 </char><char style="xt" closed="false"><ref loc="LUK 12:11">Luc 12:11</ref></char></note>Pou sa, pran desizyon avan lè pou pa prepare defans nou. <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/><char style="wj">Paske</char> <note caller="+" style="x"><char style="xo" closed="false">21:15 </char><char style="xt" closed="false"><ref loc="LUK 12:12">Luc 12:12</ref></char></note><char style="wj">Mwen va bannou pawòl avèk sajès pou okenn nan advèsè nou yo pa kapab reziste ni demanti.</char> <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/><char style="wj">Men Nou va trayi menm pa paran nou, frè, manm fanmi nou avèk zanmi nou. Yo va mete kèk nan nou a lanmò. </char> <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/><char style="wj">Nou va rayi pa tout moun akoz non Mwen. </char> <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/><char style="wj">Men</char> <note caller="+" style="x"><char style="xo" closed="false">21:18 </char><char style="xt" closed="false"><ref loc="MAT 10:30">Mat 10:30</ref></char></note><char style="wj">pa menm yon cheve nan tèt nou p ap peri. </char><verse eid="LUK 21:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 21:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:22">Mat 19:22</ref>
      </char>
    </note>
    <char style="wj">Pa pèseverans nou, nou va reyisi genyen lavi nou. </char><verse eid="LUK 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>
    <char style="wj">Men lè nou wè Jérusalem</char> <note caller="+" style="x"><char style="xo" closed="false">21:20 </char><char style="xt" closed="false"><ref loc="LUK 19:43">Luc 19:43</ref></char></note><char style="wj">antoure pa lame, nan moman sa a, rekonèt ke dezolasyon li toupre. </char> <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/><char style="wj">Answit</char> <note caller="+" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luc 17:31</ref></char></note><char style="wj">nan lè sa a, sila ki nan Juda yo va oblije sove pou ale nan mòn yo, sila ki nan mitan vil yo va oblije sòti, e sila ki andeyò yo p ap pou antre nan vil la. </char> <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/><char style="wj">Paske jou sa yo se</char> <note caller="+" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="ISA 63:4">És 63:4</ref></char></note><char style="wj">jou vanjans yo, pou tout bagay ki ekri yo kapab vin akonpli. </char> <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/><char style="wj">Malè a sila yo k ap pote pitit, ak sila yo ki nouris nan jou sa yo, paske va gen gwo</char> <note caller="+" style="x"><char style="xo" closed="false">21:23 </char><char style="xt" closed="false"><ref loc="DAN 8:19">Dan 8:19</ref></char></note><char style="wj">twoub sou tè a, e kòlè sou pèp sila a. </char> <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/><char style="wj">Yo va tonbe pa lam nepe, e yo va mennen kòm kaptif pou antre nan tout nasyon yo. Jérusalem va</char> <note caller="+" style="x"><char style="xo" closed="false">21:24 </char><char style="xt" closed="false"><ref loc="REV 11:2">Rev 11:2</ref></char></note><char style="wj">foule anba pye pa payen yo jiskaske</char> <note caller="+" style="x"><char style="xo" closed="false">21:24 </char><char style="xt" closed="false"><ref loc="ROM 11:25">Wo 11:25</ref></char></note><char style="wj">tan payen yo fin acheve. </char><verse eid="LUK 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>
    <char style="wj">Konsa, va gen sign nan solèy la, lalin ak zetwal yo, e sou latè, sezisman pami nasyon yo, ak gwo malantandi akoz laraj lanmè a ak lanm lanmè yo. </char> <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/><char style="wj">Moun va pèdi kapasite akoz laperèz, avèk twòp refleksyon sou sa k ap rive nan mond lan. Paske pouvwa nan syèl yo ap vin ebranle. </char> <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/><char style="wj">Answit yo va wè</char> <note caller="+" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7:13</ref></char></note><char style="wj">Fis a Lòm nan k ap vini nan yon nyaj avèk pouvwa, ak gran glwa. </char> <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/><char style="wj">Men lè bagay sa yo kòmanse fèt, ranje kò nou, e leve tèt nou,</char> <note caller="+" style="x"><char style="xo" closed="false">21:28 </char><char style="xt" closed="false"><ref loc="LUK 18:7">Luc 18:7</ref></char></note><char style="wj">paske delivrans nou ap toupre. </char><verse eid="LUK 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>Answit Li te di yo yon parabòl: <char style="wj">Veye byen pye figye frans lan, avèk tout pyebwa yo. </char> <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/><char style="wj">Depi yo pouse fèy, nou va wè sa, e nou va</char><note caller="+" style="x"><char style="xo" closed="false">21:30 </char><char style="xt" closed="false"><ref loc="LUK 12:57">Luc 12:57</ref></char></note><char style="wj">konnen pou kont nou ke gran sezon chalè a toupre kounye a. </char> <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/><char style="wj">Menm jan an, nou menm tou, lè nou wè bagay sa yo ap fèt, rekonèt ke</char> <note caller="+" style="x"><char style="xo" closed="false">21:31 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat 3:2</ref></char></note><char style="wj">wayòm Bondye a toupre. </char> <verse eid="LUK 21:31"/><verse number="32" style="v" sid="LUK 21:32"/><char style="wj">Anverite Mwen di nou, ke jenerasyon sila a p ap pase avan tout bagay sa yo rive. </char> <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/><note caller="+" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="MAT 5:18">Mat 5:18</ref></char></note><char style="wj">Syèl la avèk tè a va pase, men pawòl Mwen yo p ap pase. </char><verse eid="LUK 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:42-44">Mat 24:42-44</ref>
      </char>
    </note>
    <char style="wj">Veye nou, swa kè nou va vin lou nan banbòch ak bwason avèk enkyetid lavi yo, paske jou sa a va vini sou nou sibitman. </char> <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/><char style="wj">Paske li va vini kon yon piyej sou tout sila yo ki rete sou fas tout tè a. </char> <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/><char style="wj">Men </char><note caller="+" style="x"><char style="xo" closed="false">21:36 </char><char style="xt" closed="false"><ref loc="MRK 13:33">Mc 13:33</ref></char></note><char style="wj">rete vijilan tout tan avèk lapriyè pou nou kapab gen fòs pou chape de tout bagay sila yo ki prèt pou rive, e pou kanpe devan Fis a Lòm nan.” </char><verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>Alò pandan jounen an, Li t ap <note caller="+" style="x"><char style="xo" closed="false">21:37 </char><char style="xt" closed="false"><ref loc="MAT 26:55">Mat 26:55</ref></char></note>enstwi nan tanp lan; men nan aswè, Li te konn ale deyò pou pase nwit lan sou <note caller="+" style="x"><char style="xo" closed="false">21:37 </char><char style="xt" closed="false"><ref loc="MAT 21:1">Mat 21:1</ref></char></note>mòn ki rele Olivye a. <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>Epi tout pèp la te toujou leve granmmaten pou vin kote Li nan tanp lan pou koute Li.<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:1-27">Egz 12:1-27</ref>
      </char>
    </note>Alò, fèt Pen San Ledven an ki rele Pak Jwif la, t ap pwoche. <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>Konsa, Chèf prèt avèk skrib yo <note caller="+" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="MAT 12:14">Mat 12:14</ref></char></note>t ap chache kijan yo ta kapab mete L a lanmò; paske yo te pè pèp la.<verse eid="LUK 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:3 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:14-16">Mat 26:14-16</ref>
      </char>
    </note>Konsa, Satan te antre nan Judas ki te rele Iscariot, ki te konte pami douz yo. <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>Li te sòti, e te diskite avèk chèf prèt avèk <note caller="+" style="x"><char style="xo" closed="false">22:4 </char><char style="xt" closed="false"><ref loc="1CH 9:11">I Kwo 9:11</ref></char></note>ofisye yo sou jan li ta kapab trayi Li a yo menm. <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>Yo te kontan, e te vin dakò pou bay li lajan. <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/>Donk, li te antann li avèk yo, e te kòmanse chache yon bon okazyon pou livre Li bay yo kote pa t gen foul moun.<verse eid="LUK 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:17-19">Mat 26:17-19</ref>
      </char>
    </note>Alò, te rive premye jou Pen San Ledven an pandan lè yo te oblije fè sakrifis jenn mouton an. <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/>Li te voye <note caller="+" style="x"><char style="xo" closed="false">22:8 </char><char style="xt" closed="false"><ref loc="ACT 3:1-11">Trav 3:1-11</ref></char></note>Pierre avèk Jean e te di: <char style="wj">“Ale prepare Pak la pou nou pou nou kab manje li.” </char><verse eid="LUK 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9"/>Yo te mande li: “Ki kote Ou vle nou prepare l?”<verse eid="LUK 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10"/>Li te di yo: <char style="wj">“Gade, lè nou antre nan vil la, yon mesye k ap pote yon vaz dlo va vin rankontre nou. Swiv li pou antre nan kay kote li antre a.” </char> <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>Nou va di a mèt kay la: <char style="wj">“Mèt la di nou, ‘Kote chanm vizitè a kote Mwen kapab manje Pak la avèk disip Mwen yo?’</char> <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/><char style="wj">Epi li va montre nou yon gwo chanm anlè, byen founi. Prepare li la.” </char><verse eid="LUK 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13"/>Yo te pati e te twouve tout bagay jan li te di yo a. Yo te prepare Pak la.<verse eid="LUK 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:20">Mat 26:20</ref>
      </char>
    </note>Lè lè a te rive, Li te repoze a tab, e apòt yo te avè L. <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/>Li te di yo: <char style="wj">“Mwen te seryezman anvi manje Pak sa a avèk nou avan Mwen soufri;</char> <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/><char style="wj">paske Mwen di nou, Mwen p ap janm manje li ankò, </char> <note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="LUK 14:15">Luc 14:15</ref></char></note> <char style="wj">jiskaske li vin akonpli nan wayòm Bondye a.” </char> <verse eid="LUK 22:16"/><verse number="17" style="v" sid="LUK 22:17"/><note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="1CO 10:16">I Kor 10:16</ref></char></note>Lè l te fin pran yon tas, e te beni li, Li te di: <char style="wj">“Pran sa a, e pataje li pami nou menm. </char> <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/><char style="wj">Paske</char><note caller="+" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="MAT 26:29">Mat 26:29</ref></char></note> <char style="wj">Mwen di nou, Mwen p ap bwè fwi rezen an depi kounye a jiskaske wayòm Bondye a vini.” </char><verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>Lè L te fin pran yon pen e te <note caller="+" style="x"><char style="xo" closed="false">22:19 </char><char style="xt" closed="false"><ref loc="MAT 14:9">Mat 14:9</ref></char></note>beni li, Li te kase l. Li te bay yo e te di: <char style="wj">“Sa se kò M ki bay pou nou menm. Fè sa nan memwa a Mwen menm.”</char> <verse eid="LUK 22:19"/><verse number="20" style="v" sid="LUK 22:20"/>Menm jan an, Li te pran tas la lè yo te fin manje e te di: <char style="wj">“Tas sa se </char><note caller="+" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="MAT 26:28">Mat 26:28</ref></char></note> <char style="wj">akò nèf de san Mwen an ki vide </char> <note caller="+" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Egz 24:8</ref></char></note> <char style="wj">nèt pou nou.</char> <verse eid="LUK 22:20"/><verse number="21" style="v" sid="LUK 22:21"/><note caller="+" style="x"><char style="xo" closed="false">22:21 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Sòm 41:9</ref></char></note> <char style="wj">Men gade, men la a sila ki trayi Mwen an; li la avè M sou tab la. </char> <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/><char style="wj">Paske anverite, Fis a Lòm nan va ale</char> <note caller="+" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="ACT 2:23">Trav 2:23</ref></char></note><char style="wj">jan sa te deja detèmine a. Men malè a moun ki trayi Li a!” </char><verse eid="LUK 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23"/>Konsa, yo te kòmanse diskite pami yo kilès nan yo ke li ta kapab ye pou ta fè bagay sa a.<verse eid="LUK 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>Te leve osi yon diskisyon pami yo sou kilès nan yo ki te konsidere kòm pi gran. <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/><note caller="+" style="x"><char style="xo" closed="false">22:25 </char><char style="xt" closed="false"><ref loc="MAT 20:25-28">Mat 20:25-28</ref></char></note>Men Li te di yo: <char style="wj">“Wa a payen yo domine yo, e sila ki gen otorite sou yo, yo rele ‘byenfetè’. </char> <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/><char style="wj">Men se pa konsa pou nou menm, </char><note caller="+" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mat 23:11</ref></char></note><char style="wj">men fòk sila a ki pi gran pami nou an vin tankou pi piti a, e direktè a tankou sèvitè a. </char> <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/><char style="wj">Paske, kilès ki pi gran an, sila a ki repoze a tab la, oubyen sila k ap sèvi a? Se pa sila ki repoze a tab la? Men </char> <note caller="+" style="x"><char style="xo" closed="false">22:27 </char><char style="xt" closed="false"><ref loc="MAT 20:28">Mat 20:28</ref></char></note><char style="wj">Mwen menm, mwen pami nou kòm sila k ap sèvi a. </char><verse eid="LUK 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28"/>
    <char style="wj">Nou menm se sila yo ki te kanpe avè M nan tout</char>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:28 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 2:18">Eb 2:18</ref>
      </char>
    </note>
    <char style="wj">eprèv Mwen yo. </char> <verse eid="LUK 22:28"/><verse number="29" style="v" sid="LUK 22:29"/><char style="wj">Epi menm jan an ke Papa M ban Mwen</char> <note caller="+" style="x"><char style="xo" closed="false">22:29 </char><char style="xt" closed="false"><ref loc="MAT 5:3">Mat 5:3</ref></char></note><char style="wj">yon wayòm, Mwen bannou li,</char> <verse eid="LUK 22:29"/><verse number="30" style="v" sid="LUK 22:30"/><char style="wj">pou nou kapab manje e bwè sou tab Mwen nan wayòm Mwen an. Konsa,</char> <note caller="+" style="x"><char style="xo" closed="false">22:30 </char><char style="xt" closed="false"><ref loc="MAT 19:28">Mat 19:28</ref></char></note><char style="wj">nou va chita sou douz twòn yo pou jije douz tribi Israël yo. </char><verse eid="LUK 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>
    <char style="wj">Simon, Simon, veye byen. </char> <note caller="+" style="x"><char style="xo" closed="false">22:31 </char><char style="xt" closed="false"><ref loc="JOB 1:6">Job 1:6</ref></char></note><char style="wj">Satan mande pèmisyon pou</char><note caller="+" style="x"><char style="xo" closed="false">22:31 </char><char style="xt" closed="false"><ref loc="AMO 9:9">Am 9:9</ref></char></note><char style="wj">vannen ou tankou ble.</char> <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/><char style="wj">Men Mwen te</char><note caller="+" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="JHN 17:9-15">Jn 17:9-15</ref></char></note><char style="wj">priye pou ou, pou lafwa ou pa pèdi; e pou ou, nan lè ke ou retounen ankò, kab bay frè ou yo fòs.” </char><verse eid="LUK 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:33-35">Mat 26:33-35</ref>
      </char>
    </note>Men li te di Li: “Senyè, avèk Ou, mwen prepare pou m ale ni nan prizon, ni a lanmò!”<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>Li te reponn: <char style="wj">“Mwen di ou, Pierre, ke kòk la p ap gen tan chante jodi a avan ou di twa fwa ke ou pa rekonèt Mwen.” </char><verse eid="LUK 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35"/>Li te di yo: <note caller="+" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="MAT 10:9">Mat 10:9</ref></char></note> <char style="wj">“Lè Mwen te voye nou deyò san bous, ni sak, ni sapat la, nou pa t manke anyen; se pa sa?”</char> E yo te di: “Non, anyen”.<verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>Li te di yo ankò: <char style="wj">“Men koulye a, nenpòt moun ki gen yon bous, fòk li pran l avè l; menm jan an tou, yon sak. E nenpòt moun ki pa gen, fòk li vann manto li, pou achte youn nepe. </char> <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/><char style="wj">Paske Mwen di nou ke sa ki ekri a oblije akonpli nan Mwen. </char><note caller="+" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="ISA 53:12">És 53:12</ref></char></note> <char style="wj"><char style="qt">‘E Li te konte pami malfektè yo.’ </char> Paske</char><note caller="+" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="JHN 17:4">Jn 17:4</ref></char></note><char style="wj">sa ki gen referans a Mwen menm nan gen pou ranpli.” </char><verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>Yo te di: “Senyè, gade, men de <note caller="+" style="x"><char style="xo" closed="false">22:38 </char><char style="xt" closed="false"><ref loc="LUK 22:36-49">Luc 22:36-49</ref></char></note>nepe.” E Li te di yo: <char style="wj">“Sa sifi.” </char><verse eid="LUK 22:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>Li te sòti, e te kontinye <note caller="+" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LUK 21:37">Luc 21:37</ref></char></note>kòm abitid Li, vè Mòn Olivye a. Disip Li yo osi te swiv Li. <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>Lè L te rive la, Li te di yo: <char style="wj">“Priye pou nou pa antre nan tantasyon.”</char><note caller="+" style="x"><char style="xo" closed="false">22:40 </char><char style="xt" closed="false"><ref loc="MAT 26:39">Mat 26:39</ref>; <ref loc="MAT 26:36-46">Mat 26:36-46</ref></char></note><verse eid="LUK 22:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41"/>Konsa, Li te kite yo pou rive vè distans ke yon moun kab voye yon wòch, e Li te mete L sou jenou pou priye. <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>Li t ap di: <char style="wj">“Papa, si se volonte Ou, rete tas sa a sou Mwen; </char><note caller="+" style="x"><char style="xo" closed="false">22:42 </char><char style="xt" closed="false"><ref loc="MAT 26:39">Mat 26:39</ref></char></note><char style="wj">malgre pa selon volonte M, men ke pa W la kapab fèt.” </char><verse eid="LUK 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 22:43"/>Alò, yon <note caller="+" style="x"><char style="xo" closed="false">22:43 </char><char style="xt" closed="false"><ref loc="MAT 4:11">Mat 4:11</ref></char></note>zanj syèl la te parèt a Li menm pou bay Li fòs. <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/><note caller="+" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="HEB 5:7">Eb 5:7</ref></char></note>Ak gwo toumant, Li t ap priye avèk entansite. Swè Li te vin tankou gwo gout san ki t ap tonbe atè.<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>Lè L te leve soti nan lapriyè, Li te vin kote disip yo e te twouve yo nan dòmi akoz tristès yo. <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>Li te di yo: <char style="wj">“Poukisa nou ap dòmi? Leve e </char><note caller="+" style="x"><char style="xo" closed="false">22:46 </char><char style="xt" closed="false"><ref loc="LUK 22:40">Luc 22:40</ref></char></note><char style="wj">priye pou nou pa antre nan tantasyon.” </char><verse eid="LUK 22:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:47 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:47-56">Mat 26:47-56</ref>
      </char>
    </note>Pandan Li te toujou ap pale, men yon foul te parèt avèk sila ki te rele Judas a, youn nan douz yo, ki t ap mennen yo. Li te pwoche Jésus pou bo L. <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>Men Jésus te di li: <char style="wj">“Judas, èske w ap trayi Fis a Lòm nan avèk yon bo?” </char><verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>Lè sila ki te antoure Li yo te wè sa ki t ap fèt la, yo te di: “Senyè, èske n ap frape avèk <note caller="+" style="x"><char style="xo" closed="false">22:49 </char><char style="xt" closed="false"><ref loc="LUK 22:38">Luc 22:38</ref></char></note>nepe a”? <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>Konsa, youn nan yo te frape esklav a wo prèt la, e te koupe zòrèy dwat li.<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>Men Jésus te reponn e te di: <char style="wj">“Anmwens, kite m fè sa a” </char> epi Li te touche zòrèy la, e te geri li. <verse eid="LUK 22:51"/><verse number="52" style="v" sid="LUK 22:52"/>Jésus te di a chèf prèt avèk <note caller="+" style="x"><char style="xo" closed="false">22:52 </char><char style="xt" closed="false"><ref loc="LUK 22:4">Luc 22:4</ref></char></note>ofisye a tanp ki te vini kont Li yo: <char style="wj">“Nou vini avèk nepe ak baton tankou nou t ap vini kont yon vòlè?</char> <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/><char style="wj">Pandan ke Mwen te avèk nou chak jou nan tanp lan, nou pa t mete men sou Mwen; men lè sa a avèk pouvwa tenèb la se lè pa nou an.” </char><verse eid="LUK 22:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>Lè yo te fin arete Li, yo te mennen L ale, e te fè L rive lakay wo prèt la. Men <note caller="+" style="x"><char style="xo" closed="false">22:54 </char><char style="xt" closed="false"><ref loc="MAT 26:58">Mat 26:58</ref></char></note>Pierre t ap swiv a yon distans. <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/><note caller="+" style="x"><char style="xo" closed="false">22:55 </char><char style="xt" closed="false"><ref loc="MAT 26:69-75">Mat 26:69-75</ref></char></note>Apre yo te fin sanble dife nan mitan lakou tribinal la, e te chita ansanm, Pierre te chita pami yo. <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>Alò, yon fi ki t ap sèvi, lè l te wè li nan limyè dife a, li te gade l toupre, e te di: “Mesye sa a te avè L tou, wi.”<verse eid="LUK 22:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57"/>Men Li te demanti sa, e te di: “Fanm, mwen pa konnen Li.”<verse eid="LUK 22:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58"/>Yon ti jan pita, <note caller="+" style="x"><char style="xo" closed="false">22:58 </char><char style="xt" closed="false"><ref loc="JHN 18:26">Jn 18:26</ref></char></note>yon lòt te wè l, e te di: “Ou menm se youn nan yo tou.” Men Pierre te di: “Mesye, se pa mwen!”<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>Apre anviwon yon èdtan te fin pase, yon lòt mesye te kòmanse ensiste, e te di: “Sètènman mesye sa a te avè l tou, <note caller="+" style="x"><char style="xo" closed="false">22:59 </char><char style="xt" closed="false"><ref loc="MAT 26:73">Mat 26:73</ref></char></note>paske li se yon Galileyen.”<verse eid="LUK 22:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60"/>Men Pierre te di: “Mesye, mwen pa konnen anyen de sa w ap pale a!” E lapoula, pandan li te toujou ap pale, yon kòk te chante. <verse eid="LUK 22:60"/><verse number="61" style="v" sid="LUK 22:61"/>Senyè a te vire gade Pierre. E Pierre te sonje pawòl a Senyè a, jan li te di li a: <note caller="+" style="x"><char style="xo" closed="false">22:61 </char><char style="xt" closed="false"><ref loc="LUK 22:34">Luc 22:34</ref></char></note> <char style="wj">“Avan kòk la chante jodi a, ou va renye M twa fwa.” </char> <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>Li te sòti deyò, e te kriye byen amè.<verse eid="LUK 22:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>Alò <note caller="+" style="x"><char style="xo" closed="false">22:63 </char><char style="xt" closed="false"><ref loc="MAT 26:67">Mat 26:67</ref></char></note>mesye ki te kenbe Jésus yo t ap moke Li, e bat Li, <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>Konsa, yo te mare kouvri zye Li avèk yon twal, e te di L: <note caller="+" style="x"><char style="xo" closed="false">22:64 </char><char style="xt" closed="false"><ref loc="MAT 26:68">Mat 26:68</ref></char></note> <char style="wj">“Pwofetize non; se kilès ki frape Ou a?” </char> <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>Yo t ap di anpil lòt bagay kont Li, avèk<note caller="+" style="x"><char style="xo" closed="false">22:65 </char><char style="xt" closed="false"><ref loc="MAT 27:39">Mat 27:39</ref></char></note>blasfèm.<verse eid="LUK 22:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:66 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:1">Mat 27:1</ref>
      </char>
    </note>Lè li te fè jou, Konsèy Ansyen a pèp la te reyini, ni chèf prèt avèk skrib yo. Yo te mennen Li nan chanm konsèy la, e t ap di: <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/><note caller="+" style="x"><char style="xo" closed="false">22:67 </char><char style="xt" closed="false"><ref loc="MAT 26:63-66">Mat 26:63-66</ref></char></note>“Si Ou menm se Kris la, di nou sa a.” Men Li te di yo: <char style="wj">“Si Mwen di nou, nou p ap kwè; </char> <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/><char style="wj">epi si Mwen poze nou yon kesyon, nou p ap reponn, ni lage M ale. </char> <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/><note caller="+" style="x"><char style="xo" closed="false">22:69 </char><char style="xt" closed="false"><ref loc="MAT 26:64">Mat 26:64</ref></char></note> <char style="wj">Men depi koulye a, </char><note caller="+" style="x"><char style="xo" closed="false">22:69 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Sòm 110:1</ref></char></note><char style="wj">Fis a Lòm nan va chita sou men dwat a pwisans Bondye a.” </char><verse eid="LUK 22:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70"/>Konsa, yo tout te di: “Alò, Ou menm se Fis Bondye a?” Li te reponn yo: <note caller="+" style="x"><char style="xo" closed="false">22:70 </char><char style="xt" closed="false"><ref loc="MAT 26:64">Mat 26:64</ref></char></note><char style="wj">“Ou pale sa, paske, Mwen Se.” </char><verse eid="LUK 22:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71"/>Answit yo te di: “Kisa nou bezwen anplis kòm temwayaj? Paske nou tande sa nou menm nan pwòp bouch Li!”<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>Alò kon yon sèl kò, yo te leve pou <note caller="+" style="x"><char style="xo" closed="false">23:1 </char><char style="xt" closed="false"><ref loc="MAT 27:2">Mat 27:2</ref></char></note>mennen L devan Pilate. <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/><note caller="+" style="x"><char style="xo" closed="false">23:2 </char><char style="xt" closed="false"><ref loc="MAT 27:11-14">Mat 27:11-14</ref></char></note>Yo te kòmanse akize L, e te di: “Nou te twouve mesye sa t ap egare nasyon nou an, e t ap anpeche yo peye kontribisyon yo bay César, e te di ke Li menm, Li se Kris la, yon Wa.”<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>Donk Pilate te mande Li: “Èske Ou se Wa a Jwif yo?” Epi Li te reponn li: <note caller="+" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="LUK 22:70">Luc 22:70</ref></char></note> <char style="wj">“Se sa ou di l la”. </char><verse eid="LUK 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4"/>Answit Pilate te di a chèf prèt yo avèk foul la: <note caller="+" style="x"><char style="xo" closed="false">23:4 </char><char style="xt" closed="false"><ref loc="MAT 27:23">Mat 27:23</ref></char></note>“Mwen pa twouve okenn koupabilite nan mesye sa a”.<verse eid="LUK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5"/>Men yo te kontinye ensiste, e t ap di: “L ap boulvèse pèp la, e L ap enstwi yo toupatou nan Juda, <note caller="+" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 4:12">Mat 4:12</ref></char></note>kòmanse soti nan Galilée, pou menm rive nan plas sa a.”<verse eid="LUK 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>Men lè Pilate te tande sa, li te mande si mesye sa a te yon Galileyen. <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>Lè l te vin aprann ke Li te anba otorite Hérode, li te voye Li vè <note caller="+" style="x"><char style="xo" closed="false">23:7 </char><char style="xt" closed="false"><ref loc="MAT 14:1">Mat 14:1</ref></char></note>Hérode, ki te osi nan Jérusalem nan moman sa a.<verse eid="LUK 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>Alò, Hérode te trè kontan lè l te wè Jésus; paske <note caller="+" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="LUK 9:9">Luc 9:9</ref></char></note>li te vle wè L depi lontan, akoz ke li t ap tande de Li, e te espere wè l fè kalite mirak ki te fèt pa Li. <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>Li te kesyone Li anpil, men <note caller="+" style="x"><char style="xo" closed="false">23:9 </char><char style="xt" closed="false"><ref loc="MAT 27:12">Mat 27:12</ref>,<ref loc="MAT 27:14">14</ref></char></note>Li pa t reponn li menm. <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>Chèf prèt yo avèk skrib yo te kanpe la, e t ap akize Li avèk vanjans. <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>Epi lè Hérode avèk sòlda li yo, te fin trete L avèk ensolans, e moke L, yo te <note caller="+" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 27:28">Mat 27:28</ref></char></note>fè L abiye ak yon bèl manto, e te voye Li retounen bay Pilate. <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>Alò nan menm jou sa a, <note caller="+" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="ACT 4:27">Trav 4:27</ref></char></note>Hérode avèk Pilate te vin zanmi youn avèk lòt men avan sa, yo te lènmi youn ak lòt.<verse eid="LUK 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>Pilate te rasanble chèf prèt yo avèk <note caller="+" style="x"><char style="xo" closed="false">23:13 </char><char style="xt" closed="false"><ref loc="LUK 23:35">Luc 23:35</ref></char></note>ofisye yo avèk pèp la. <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>Li te di yo: “Nou te mennen nonm sa a kote mwen tankou yon moun ki t ap <note caller="+" style="x"><char style="xo" closed="false">23:14 </char><char style="xt" closed="false"><ref loc="LUK 23:2">Luc 23:2</ref></char></note>pouse pèp la a rebelyon, e gade byen, selon egzamen ki fèt devan nou, mwen <note caller="+" style="x"><char style="xo" closed="false">23:14 </char><char style="xt" closed="false"><ref loc="LUK 23:4">Luc 23:4</ref></char></note>pa twouve okenn koupabilite nan Li, selon chaj ke nou fè kont Li yo. <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>Non, ni <note caller="+" style="x"><char style="xo" closed="false">23:15 </char><char style="xt" closed="false"><ref loc="LUK 9:9">Luc 9:9</ref></char></note>Hérode pa twouve anyen, paske li te voye Li tounen bò kote nou; epi byen gade, anyen ki merite lanmò pa t fèt pa Li. <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>Konsa, mwen va <note caller="+" style="x"><char style="xo" closed="false">23:16 </char><char style="xt" closed="false"><ref loc="MAT 27:26">Mat 27:26</ref></char></note>pini Li, epi lage Li.”<verse eid="LUK 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 23:17"/>Alò li te oblije lage pou yo yon prizonye nan fèt la. <verse eid="LUK 23:17"/><verse number="18" style="v" sid="LUK 23:18"/>Men yo te kriye fò tout ansanm, e te di: <note caller="+" style="x"><char style="xo" closed="false">23:18 </char><char style="xt" closed="false"><ref loc="JHN 18:39">Jn 18:39</ref></char></note>“Fè nonm sa ale! Libere pou nou Barabbas!” <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>(Li te yon moun ki te jete nan prizon pou yon rebelyon ki te fèt nan vil la, ak pou touye moun.)<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>Pilate, ki te vle lage Jésus, te pale avèk yo ankò, <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>men yo te kontinye kriye fò, e te di: “Krisifye! Krisifye Li!”<verse eid="LUK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22"/>Li te di yo yon twazyèm fwa: “Poukisa? Ki mal mesye sa a fè? Mwen pa twouve nan Li okenn fot ki mande lanmò. Konsa, mwen va <note caller="+" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="LUK 23:16">Luc 23:16</ref></char></note>pini Li, epi lage Li.” <verse eid="LUK 23:22"/><verse number="23" style="v" sid="LUK 23:23"/>Men yo te ensiste toujou, e t ap mande ak gwo vwa pou Li krisifye. Epi vwa pa yo te kòmanse vin genyen. <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>Konsa, Pilate te pase lòd ofisyèl pou sede bay yo sa yo te mande a. <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>Li te libere mesye ke yo t ap mande a, ki te jete nan prizon pou rebelyon ak touye moun nan, men li te livre Jésus kon volonte pa yo.<verse eid="LUK 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:26 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:17">Jn 19:17</ref>
      </char>
    </note>Lè yo te mennen L sòti, yo te mete men sou yon Simon de Cyrène ki t ap sòti andeyò, e te mete kwa a sou li pou l ta pote l dèyè Jésus. <verse eid="LUK 23:26"/><verse number="27" style="v" sid="LUK 23:27"/>Yon gran foul nan pèp la t ap swiv Li, avèk fanm yo ki t ap <note caller="+" style="x"><char style="xo" closed="false">23:27 </char><char style="xt" closed="false"><ref loc="LUK 8:52">Luc 8:52</ref></char></note>kriye e fè lamantasyon pou Li. <verse eid="LUK 23:27"/><verse number="28" style="v" sid="LUK 23:28"/>Men Jésus, te vin vire vè yo, e te di: <char style="wj">“Fi Jérusalem yo, sispann kriye pou Mwen, men kriye pou nou menm, ak pou pitit nou yo. </char> <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/><char style="wj">Paske, veye byen, jou yo ap vini lè yo va di: </char> <note caller="+" style="x"><char style="xo" closed="false">23:29 </char><char style="xt" closed="false"><ref loc="MAT 24:19">Mat 24:19</ref></char></note><char style="wj">‘Beni se sila ki esteril yo, e vant ki pa t janm fè pitit yo, ak tete ki pa t janm bay timoun tete yo.’</char> <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/><char style="wj">Alò, yo va kòmanse di a mòn yo: </char> <note caller="+" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">Os 10:8</ref></char></note><char style="wj"><char style="qt">‘Tonbe sou nou, e a ti kolin yo, kouvri nou.’</char></char> <verse eid="LUK 23:30"/><verse number="31" style="v" sid="LUK 23:31"/><char style="wj">Paske si yo fè bagay sa yo avèk bwa ki vèt, kisa k ap rive lè l sèch.” </char><verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:32 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:38">Mat 27:38</ref>
      </char>
    </note>De lòt mesye ki te kriminèl yo t ap mennen sòti pou mete a lanmò avèk Li. <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/><note caller="+" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 27:33-44">Mat 27:33-44</ref></char></note>Lè yo te rive nan plas yo rele Plas Tèt Mò a, yo te krisifye Li avèk kriminèl yo, youn sou bò dwat, e youn sou bò goch.<verse eid="LUK 23:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 23:34"/>Men Jésus t ap di: <char style="wj">“Papa, padone yo; paske yo pa konnen kisa y ap fè.” </char> Epi yo te <note caller="+" style="x"><char style="xo" closed="false">23:34 </char><char style="xt" closed="false"><ref loc="PSA 22:18">Sòm 22:18</ref></char></note>tire osò pou divize vètman Li pami yo menm. <verse eid="LUK 23:34"/><verse number="35" style="v" sid="LUK 23:35"/>Pèp la te kanpe akote, e t ap gade. Menm ofisye yo t ap moke L, e t ap di: “Li te sove lòt yo, <note caller="+" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="MAT 27:43">Mat 27:43</ref></char></note>kite Li sove pwòp tèt Li si se Kris a Bondye a, Sila Ke Li Chwazi a.”<verse eid="LUK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36"/>Sòlda yo osi ki t ap moke Li, te vin kote L, pou <note caller="+" style="x"><char style="xo" closed="false">23:36 </char><char style="xt" closed="false"><ref loc="MAT 27:48">Mat 27:48</ref></char></note>ofri Li diven si. <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>Yo t ap di: <note caller="+" style="x"><char style="xo" closed="false">23:37 </char><char style="xt" closed="false"><ref loc="MAT 27:43">Mat 27:43</ref></char></note>“Si Ou se Wa a Jwif yo, sove tèt Ou!”<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>Alò te gen yon enskripsyon anwo Li: <note caller="+" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="MAT 27:37">Mat 27:37</ref></char></note>“Sa Se Wa a Jwif Yo”.<verse eid="LUK 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:44">Mat 27:44</ref>
      </char>
    </note>Youn nan kriminèl ki te pann yo t ap voye pawòl abizif vè Li; li t ap di: “Èske se pa Kris la Ou ye? Sove tèt Ou, avèk nou!”<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>Men lòt la te reponn ak repwòch e te di: “Èske ou pa menm pè Bondye, paske ou anba menm lòd kondanasyon an? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>Epi nou menm avèk jistis, paske nou ap resevwa sa ke nou merite pou zèv nou yo; men mesye sila a pa fè okenn mal.” <verse eid="LUK 23:41"/><verse number="42" style="v" sid="LUK 23:42"/>Konsa li te di: “Jésus, sonje mwen lè Ou antre nan wayòm Ou an!”<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>Li te reponn li: <char style="wj">“Anverite Mwen di ou, jodi a, ou va avè M nan</char> <note caller="+" style="x"><char style="xo" closed="false">23:43 </char><char style="xt" closed="false"><ref loc="2CH 12:4">II Kwo 12:4</ref></char></note> <char style="wj">Paradi.”</char><verse eid="LUK 23:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:44 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:45-56">Mat 27:45-56</ref>
      </char>
    </note>Alò se te anviwon sizyèm lè, e tenèb te tonbe sou tout latè jiska nevyèm lè. <verse eid="LUK 23:44"/><verse number="45" style="v" sid="LUK 23:45"/>Solèy la te kache nèt, e <note caller="+" style="x"><char style="xo" closed="false">23:45 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Egz 26:31-33</ref></char></note>vwal tanp lan te chire an de bout. <verse eid="LUK 23:45"/><verse number="46" style="v" sid="LUK 23:46"/>Jésus te kriye avèk yon gwo vwa, e te di: <char style="wj">“Papa, </char><note caller="+" style="x"><char style="xo" closed="false">23:46 </char><char style="xt" closed="false"><ref loc="PSA 31:5">Sòm 31:5</ref></char></note><char style="wj">nan men Ou Mwen remèt lespri Mwen.” </char> Lè L fin di sa, Li te respire dènye souf Li.<verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:47 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:54">Mat 27:54</ref>
      </char>
    </note>Alò, lè santenye a te wè sa ki te rive a, li te kòmanse bay lwanj a Bondye, e te di: “Anverite, mesye sa a te inosan.” <verse eid="LUK 23:47"/><verse number="48" style="v" sid="LUK 23:48"/>Alò tout foul la ki te vini ansanm pou espektak sila a, lè yo te wè sa ki te rive a, yo te retounen e t ap <note caller="+" style="x"><char style="xo" closed="false">23:48 </char><char style="xt" closed="false"><ref loc="LUK 8:52">Luc 8:52</ref></char></note>bat lestomak yo. <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/><note caller="+" style="x"><char style="xo" closed="false">23:49 </char><char style="xt" closed="false"><ref loc="MAT 27:55">Mat 27:55</ref></char></note>Epi tout sila ki te rekonèt Li yo, ak fanm Galilée ki te akonpanye Li yo, te kanpe a yon distans e t ap gade tout bagay sa yo.<verse eid="LUK 23:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">23:50 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:57-61">Mat 27:57-61</ref>
      </char>
    </note>Yon mesye ki te rele Joseph, yon manm Konsèy la, te yon nonm ki te bon e jis. <verse eid="LUK 23:50"/><verse number="51" style="v" sid="LUK 23:51"/>Li pa t dakò avèk plan yo a. Se te yon mesye ki te soti Arimathée, yon vil a Jwif yo, e li <note caller="+" style="x"><char style="xo" closed="false">23:51 </char><char style="xt" closed="false"><ref loc="MRK 15:43">Mc 15:43</ref></char></note>t ap tann vini wayòm Bondye a. <verse eid="LUK 23:51"/><verse number="52" style="v" sid="LUK 23:52"/>Mesye sila a te ale kote Pilate, e te mande kò Jésus. <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>Konsa, li te desann kò li, li te vlope li nan yon twal lèn, e li te depoze li nan yon tonbo ki te fouye nan wòch, kote pèsòn pa t janm te depoze. <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>Se te <note caller="+" style="x"><char style="xo" closed="false">23:54 </char><char style="xt" closed="false"><ref loc="MAT 27:62">Mat 27:62</ref></char></note>Jou Preparasyon an, e Saba te prèt pou kòmanse. <verse eid="LUK 23:54"/><verse number="55" style="v" sid="LUK 23:55"/>Alò <note caller="+" style="x"><char style="xo" closed="false">23:55 </char><char style="xt" closed="false"><ref loc="LUK 23:49">Luc 23:49</ref></char></note>fanm ki te vini avèk Li yo depi Galilée te swiv, e te wè tonm nan ak jan kò L te depoze a. <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>Answit yo te retounen pou <note caller="+" style="x"><char style="xo" closed="false">23:56 </char><char style="xt" closed="false"><ref loc="MRK 16:1">Mc 16:1</ref></char></note>prepare epis avèk pafen. Epi nan Saba a, yo te repoze selon Lalwa a.<verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:1 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 20:1-8">Jn 20:1-8</ref>
      </char>
    </note>Men nan premye jou semèn nan, nan granmmaten, yo te vini nan tonm nan, e te pote epis ke yo te fin prepare yo. <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>Konsa, yo te twouve wòch la woule akote tonm nan, <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>men lè yo te antre, yo pa t twouve kò a <note caller="+" style="x"><char style="xo" closed="false">24:3 </char><char style="xt" closed="false"><ref loc="LUK 7:13">Luc 7:13</ref></char></note>Senyè Jésus a. <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>Pandan yo te twouble akoz sa, vwala sibitman, <note caller="+" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="JHN 20:12">Jn 20:12</ref></char></note>de mesye te kanpe toupre yo a ak yon abiman briyan. <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>Fanm yo te sezi avèk laperèz, e te bese figi yo jis atè.</para>
  <para style="p" vid="LUK 24:5">Mesye yo te di yo: “Poukisa nou ap chache Sila ki vivan an pami mò yo? <verse eid="LUK 24:5"/><verse number="6" style="v" sid="LUK 24:6"/><note caller="+" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="MRK 16:6">Mc 16:6</ref></char></note>Li pa la, men Li gen tan leve. Sonje <note caller="+" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="MAT 17:22">Mat 17:22</ref></char></note>jan Li te pale avèk nou pandan Li te toujou Galilée a? <verse eid="LUK 24:6"/><verse number="7" style="v" sid="LUK 24:7"/>Li t ap di ke fòk <note caller="+" style="x"><char style="xo" closed="false">24:7 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref></char></note>Fis a Lòm nan livre nan men a moun pechè yo, pou krisifye, e leve ankò nan twazyèm jou a.”<verse eid="LUK 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8"/>Konsa <note caller="+" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="JHN 2:22">Jn 2:22</ref></char></note>yo te sonje pawòl Li yo. <verse eid="LUK 24:8"/><verse number="9" style="v" sid="LUK 24:9"/>Yo te retounen soti nan tonm nan e te bay rapò a tout bagay sa yo a onz yo ak tout lòt yo. <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>Alò, se te <note caller="+" style="x"><char style="xo" closed="false">24:10 </char><char style="xt" closed="false"><ref loc="MAT 27:56">Mat 27:56</ref></char></note>Marie Magdala, Jeanne, Marie, manman a Jacques; anplis, lòt fanm ki te avèk yo, ki t ap pale apòt yo bagay sa yo. <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>Men pawòl sa yo te parèt a yo menm tankou foli, e yo te refize kwè yo. <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>Men Pierre te leve, e te <note caller="+" style="x"><char style="xo" closed="false">24:12 </char><char style="xt" closed="false"><ref loc="JHN 20:3-6">Jn 20:3-6</ref></char></note>kouri nan tonm nan. Lè l te bese pou gade ladann, li te wè sèlman twal lèn ki te sèvi pou vlope a; epi li te sòti pou rive <note caller="+" style="x"><char style="xo" closed="false">24:12 </char><char style="xt" closed="false"><ref loc="JHN 20:10">Jn 20:10</ref></char></note>lakay li byen etone de sa ki te pase a.<verse eid="LUK 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>E konsa, de nan yo t ap prale menm jou sa nan yon vil yo te rele Emmaüs, ki te anviwon a onz kilomèt de Jérusalem. <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>Yo t ap pale youn ak lòt sou tout bagay sa yo ki te fèt. <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>Pandan yo t ap pale ak diskite, Jésus Li menm te pwoche, e te kòmanse mache fè wout la ansanm avèk yo. <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>Men <note caller="+" style="x"><char style="xo" closed="false">24:16 </char><char style="xt" closed="false"><ref loc="LUK 24:31">Luc 24:31</ref></char></note>zye pa yo te anpeche yo rekonèt Li. <verse eid="LUK 24:16"/><verse number="17" style="v" sid="LUK 24:17"/>Li te di yo: <char style="wj">“Kilès pawòl sa yo ke n ap pataje youn avèk lòt konsa pandan n ap mache a, plen tristès konsa?” </char> <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>Youn nan yo ke yo te rele Cléopas, te reponn e te di Li: “Èske se ou sèl k ap vizite Jérusalem ki pa konnen sa ki te pase isit la nan jou sa yo?”<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>Li te di yo: <char style="wj">“Ki bagay”? </char> Epi yo te di Li: “Bagay sou Jésus de Nazareth la, ki te yon pwofèt byen fò nan zèv, ak pawòl nan zye Bondye avèk tout pèp la. <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>Kijan chèf prèt yo avèk <note caller="+" style="x"><char style="xo" closed="false">24:20 </char><char style="xt" closed="false"><ref loc="LUK 23:13">Luc 23:13</ref></char></note>dirijan nou yo te livre li kondane a lanmò, e te krisifye Li. <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>Men nou t ap espere ke se te Li ki t ap fè <note caller="+" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="LUK 1:68">Luc 1:68</ref></char></note>redanmsyon Israël a. Anplis de tout sa, se twazyèm jou a depi bagay sa yo te fèt. <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>Men osi, kèk fanm pami nou te etone nou. <note caller="+" style="x"><char style="xo" closed="false">24:22 </char><char style="xt" closed="false"><ref loc="LUK 24:1">Luc 24:1</ref></char></note>Lè yo te nan tonm nan bonè maten an, <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>epi pa t twouve kò Li, yo te vin di ke yo te wè yon aparisyon de zanj ki te di ke Li te vivan. <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>Kèk nan sila ki te avèk nou yo te ale nan tonm nan, e te twouve li vrèman menm jan ke fanm yo te di a; men Li menm, yo pa t wè L.”<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>Konsa, Li te reponn yo: <char style="wj">“O moun ki manke konprann, e ki gen kè lan pou kwè nan </char> <note caller="+" style="x"><char style="xo" closed="false">24:25 </char><char style="xt" closed="false"><ref loc="MAT 26:24">Mat 26:24</ref></char></note><char style="wj">tout sa ke pwofèt yo te pale yo;</char> <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/><note caller="+" style="x"><char style="xo" closed="false">24:26 </char><char style="xt" closed="false"><ref loc="LUK 24:7-44">Luc 24:7-44</ref></char></note> <char style="wj">Èske li pa t nesesè pou Kris la te soufri bagay sa yo, pou antre nan glwa Li?”</char> <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>Answit, Li te kòmanse avèk <note caller="+" style="x"><char style="xo" closed="false">24:27 </char><char style="xt" closed="false"><ref loc="GEN 3:15">Jen 3:15</ref></char></note>Moïse, ak tout pwofèt yo, e Li te eksplike yo bagay konsènan Li menm nan tout Ekriti Sen yo.<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>Konsa, yo te pwoche vil kote yo t ap prale a, e Li <note caller="+" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="MRK 6:48">Mc 6:48</ref></char></note>te fè tankou Li t ap prale pi lwen.<verse eid="LUK 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 24:29"/>Men yo te ankouraje Li, e te di L: “Rete avèk nou, paske nwit lan ap pwoche, e jounen an prèt pou fini.” Konsa, Li te antre pou rete avèk yo. <verse eid="LUK 24:29"/><verse number="30" style="v" sid="LUK 24:30"/>Lè Li te repoze sou tab avèk yo, Li te pran pen an; Li te <note caller="+" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="MAT 14:19">Mat 14:19</ref></char></note>beni li, kase li, e Li te kòmanse bay yo li. <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>Answit <note caller="+" style="x"><char style="xo" closed="false">24:31 </char><char style="xt" closed="false"><ref loc="LUK 24:16">Luc 24:16</ref></char></note>zye yo te vin ouvri e yo te rekonèt Li; epi Li te disparèt devan zye yo. <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>Yo te di youn ak lòt: “Èske kè nou pa t ap boule nan nou pandan Li t ap pale avèk nou sou wout la, pandan Li <note caller="+" style="x"><char style="xo" closed="false">24:32 </char><char style="xt" closed="false"><ref loc="LUK 24:45">Luc 24:45</ref></char></note>t ap eksplike nou Ekriti Sen yo?” <verse eid="LUK 24:32"/><verse number="33" style="v" sid="LUK 24:33"/>Epi yo te leve menm lè a; yo te retounen Jérusalem, e yo te twouve onz yo reyini ansanm avèk <note caller="+" style="x"><char style="xo" closed="false">24:33 </char><char style="xt" closed="false"><ref loc="ACT 1:14">Trav 1:14</ref></char></note>sila ki te avèk yo. <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>Yo te di yo ke <note caller="+" style="x"><char style="xo" closed="false">24:34 </char><char style="xt" closed="false"><ref loc="LUK 24:6">Luc 24:6</ref></char></note>Senyè a vrèman leve, e <note caller="+" style="x"><char style="xo" closed="false">24:34 </char><char style="xt" closed="false"><ref loc="1CH 15:5">I Kwo 15:5</ref></char></note>te parèt a Simon. <verse eid="LUK 24:34"/><verse number="35" style="v" sid="LUK 24:35"/>Yo te kòmanse pataje sa ki te pase nan wout la, ak jan <note caller="+" style="x"><char style="xo" closed="false">24:35 </char><char style="xt" closed="false"><ref loc="LUK 24:30">Luc 24:30</ref></char></note>yo te vin konnen Li nan kase pen an.<verse eid="LUK 24:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>Pandan yo t ap pale bagay sa yo, Li menm te kanpe nan mitan yo, e te di yo: <char style="wj">“Ke lapè rete avèk nou.” </char><verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>Men yo te etone, pè e te panse ke se te yon <note caller="+" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="MAT 14:26">Mat 14:26</ref></char></note>lespri ke yo te wè a.<verse eid="LUK 24:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 24:38"/>Epi Li te di yo: <char style="wj">“Poukisa nou twouble, e poukisa dout leve nan kè nou?</char> <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/><char style="wj">Gade men Mwen, ak pye Mwen, ke se Mwen menm; </char><note caller="+" style="x"><char style="xo" closed="false">24:39 </char><char style="xt" closed="false"><ref loc="JHN 20:27">Jn 20:27</ref></char></note><char style="wj">touche Mwen pou wè, paske yon lespri pa gen chè avèk zo, tankou nou wè ke M genyen an.” </char> <verse eid="LUK 24:39"/><verse number="40" style="v" sid="LUK 24:40"/>Lè l fin di sa, Li te montre yo men Li avèk pye Li. <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>Pandan yo te toujou <note caller="+" style="x"><char style="xo" closed="false">24:41 </char><char style="xt" closed="false"><ref loc="LUK 24:11">Luc 24:11</ref></char></note>mal pou kwè akoz lajwa ak sezisman yo, Li te di yo: <char style="wj">“Èske nou pa gen anyen isit la pou manje?” </char><verse eid="LUK 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 24:42"/>Yo te bay Li yon mòso pwason boukannen. <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>Li te pran l e te <note caller="+" style="x"><char style="xo" closed="false">24:43 </char><char style="xt" closed="false"><ref loc="ACT 10:41">Trav 10:41</ref></char></note>manje l devan yo. <verse eid="LUK 24:43"/><verse number="44" style="v" sid="LUK 24:44"/>Alò, Li te di yo: <char style="wj">“Sa se pawòl Mwen yo ke Mwen te pale avèk nou pandan Mwen te toujou avèk nou an. Ke tout bagay ki ekri sou Mwen menm nan</char> <note caller="+" style="x"><char style="xo" closed="false">24:44 </char><char style="xt" closed="false"><ref loc="LUK 24:27">Luc 24:27</ref></char></note><char style="wj">Lalwa Moïse avèk Pwofèt yo avèk Sòm yo ta oblije akonpli.” </char><verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>Answit Li te <note caller="+" style="x"><char style="xo" closed="false">24:45 </char><char style="xt" closed="false"><ref loc="LUK 24:32">Luc 24:32</ref></char></note>ouvri lespri pa yo pou konprann Ekriti Sen yo. <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>Li te di yo: <char style="wj">“Se</char> <note caller="+" style="x"><char style="xo" closed="false">24:46 </char><char style="xt" closed="false"><ref loc="LUK 24:26-44">Luc 24:26-44</ref></char></note> <char style="wj">konsa li ekri ke Kris la va soufri, e leve ankò soti nan lanmò nan twazyèm jou a. </char> <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/><char style="wj">Epi ke repantans pou padon peche yo ta pwoklame nan non Li a </char> <note caller="+" style="x"><char style="xo" closed="false">24:47 </char><char style="xt" closed="false"><ref loc="MAT 28:19">Mat 28:19</ref></char></note> <char style="wj">tout nasyon yo, kòmanse depi Jérusalem. </char> <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/><char style="wj">Nou menm se </char><note caller="+" style="x"><char style="xo" closed="false">24:48 </char><char style="xt" closed="false"><ref loc="ACT 1:8-22">Trav 1:8-22</ref></char></note><char style="wj">temwen a bagay sa yo. </char> <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/><char style="wj">Gade byen, Mwen ap voye kote nou pwomès Papa M nan. Men fòk nou rete nan vil la jiskaske nou vin abiye avèk pwisans ki sòti anwo a.” </char><verse eid="LUK 24:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>Li te mennen yo deyò jiska <note caller="+" style="x"><char style="xo" closed="false">24:50 </char><char style="xt" closed="false"><ref loc="MAT 21:17">Mat 21:17</ref></char></note>Béthanie, e Li te leve men L yo, e te beni yo. <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>Pandan Li t ap beni yo, Li te kite yo e te leve monte nan syèl la. <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>Yo menm, lè yo te fin adore Li, yo te retounen Jérusalem avèk gran jwa. <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>Yo te rete nan tanp lan tout tan e yo t ap bay lwanj a Bondye.<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
