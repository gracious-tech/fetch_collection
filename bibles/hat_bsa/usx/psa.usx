<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id"/>
  <para style="h">Sòm Yo</para>
  <para style="toc1">SÒM YO</para>
  <para style="toc2">Sòm Yo</para>
  <para style="toc3">Sòm</para>
  <para style="mt1">SÒM YO</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms1">Liv I</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>Beni se nonm ki <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="PRO 4:14">Pwov 4:14</ref></char></note>pa mache nan konsèy</para>
  <para style="q1" vid="PSA 1:1">mechan yo</para>
  <para style="q1" vid="PSA 1:1">ni kanpe nan pa pechè yo, ni chita nan chèz mokè yo,<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>men <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="PSA 119:14-35">Sòm 119:14-35</ref></char></note>gran plezi li se <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JOS 1:8">Jos 1:8</ref></char></note>nan lalwa SENYÈ a.</para>
  <para style="q1" vid="PSA 1:2">Sou lalwa Li, li reflechi lajounen kon lannwit.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>Li va tankou yon <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="PSA 92:12-14">Sòm 92:12-14</ref></char></note>pyebwa ki plante</para>
  <para style="q1" vid="PSA 1:3">bò kote flèv dlo ki bay fwi li nan sezon li.</para>
  <para style="q1" vid="PSA 1:3">Fèy li p ap janm fane, e tout sa li fè byen reyisi.<verse eid="PSA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>Mechan yo pa konsa.</para>
  <para style="q1" vid="PSA 1:4">Yo tankou <note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="PSA 5:5">Sòm 5:5</ref></char></note>pay ke van an pouse ale.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>Pou sa, mechan yo p ap kanpe nan chèz <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="PSA 9:7">Sòm 9:7</ref>,<ref loc="PSA 9:8">8</ref>,<ref loc="PSA 9:16">16</ref></char></note>jijman an,</para>
  <para style="q1" vid="PSA 1:5">ni pechè yo nan asanble ak moun dwat yo.<verse eid="PSA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>Paske SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="NAM 1:7">Na 1:7</ref></char></note>konnen chemen</para>
  <para style="q1" vid="PSA 1:6">a sila ki dwat yo,</para>
  <para style="q1" vid="PSA 1:6">men chemen a mechan yo va disparèt.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>Poukisa nasyon yo ap boulvèse konsa,</para>
  <para style="q1" vid="PSA 2:1">e pèp yo fòmante yon vye bagay?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>Wa latè yo pran pòz yo e chèf yo</para>
  <para style="q1" vid="PSA 2:2">pran konsèy ansanm kont SENYÈ a,</para>
  <para style="q1" vid="PSA 2:2">e <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="JHN 1:41">Jn 1:41</ref></char></note>kont onksyone pa Li a:<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>“Annou <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="JER 5:5">Jr 5:5</ref></char></note>chire chenn sa yo,</para>
  <para style="q1" vid="PSA 2:3">e jete kòd ki mare nou yo!”<verse eid="PSA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>Sila ki chita nan syèl la <note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="PSA 37:13">Sòm 37:13</ref></char></note>ri;</para>
  <para style="q1" vid="PSA 2:4">SENYÈ a ap moke yo.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>Anplis, Li va pale avèk yo nan <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="PSA 21:8-9">Sòm 21:8-9</ref></char></note>kòlè Li.</para>
  <para style="q1" vid="PSA 2:5">Li va fè yo sezi nan kòlè Li.<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>Men pou Mwen menm,</para>
  <para style="q1" vid="PSA 2:6">Mwen fin plase Wa Mwen an sou Sion,</para>
  <para style="q1" vid="PSA 2:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:1-2">Sòm 48:1-2</ref>
      </char>
    </note>mòn sen Mwen an.<verse eid="PSA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7"/>Anverite, Mwen va pale selon deklarasyon SENYÈ a;</para>
  <para style="q1" vid="PSA 2:7">SENYÈ a te di Mwen: “Ou se <note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ACT 13:33">Trav 13:33</ref></char></note>Fis Mwen.</para>
  <para style="q1" vid="PSA 2:7">Se jodi a, Mwen te fè Ou.<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>Mande Mwen, e Mwen va bay Ou</para>
  <para style="q1" vid="PSA 2:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">2:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:27">Sòm 22:27</ref>
      </char>
    </note>nasyon yo kon eritaj,</para>
  <para style="q1" vid="PSA 2:8">jis rive nan <note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="PSA 67:7">Sòm 67:7</ref></char></note>dènye pwent latè</para>
  <para style="q1" vid="PSA 2:8">kon posesyon pa Ou.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>Ou va <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:26-27">Rev 2:26-27</ref></char></note>kase yo avèk yon baton fè,</para>
  <para style="q1" vid="PSA 2:9">Ou va <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="PSA 28:5">Sòm 28:5</ref></char></note>kraze yo tankou veso kanari.”<verse eid="PSA 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>Konsa, O wa yo, <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="PRO 8:15">Pwov 8:15</ref></char></note>sèvi ak sajès.</para>
  <para style="q1" vid="PSA 2:10">Fè atansyon, O jij sou latè yo.<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>Adore SENYÈ a avèk gran respè e</para>
  <para style="q1" vid="PSA 2:11">rejwi avèk <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="PSA 119:119-120">Sòm 119:119-120</ref></char></note>tranbleman.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>Fè omaj a Fis la, pou L pa vin fache,</para>
  <para style="q1" vid="PSA 2:12">epi ou ta mouri nan chemen an.</para>
  <para style="q1" vid="PSA 2:12">Paske gwo chalè Li kab limen ase vit.</para>
  <para style="q1" vid="PSA 2:12">A la beni se tout sila ki <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 5:11">Sòm 5:11</ref></char></note>kache nan Li.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="d">Yon Sòm a David lè l te sove ale devan Absalom, fis li a</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>O SENYÈ, gade kijan <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="2SA 15:12">II Sam 15:12</ref></char></note>lènmi mwen</para>
  <para style="q1" vid="PSA 3:1">yo ap miltipliye;</para>
  <para style="q1" vid="PSA 3:1">Anpil moun leve kont mwen.<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>Anpil moun pale de nanm mwen,</para>
  <para style="q1" vid="PSA 3:2">“Nanpwen <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="PSA 22:7-8">Sòm 22:7-8</ref></char></note>delivrans pou li nan Bondye.” <char style="qs">Tan</char><verse eid="PSA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>Men Ou menm, O SENYÈ, se yon pwotèj ki antoure mwen,</para>
  <para style="q1" vid="PSA 3:3">glwa mwen, ak Sila ki <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="PSA 27:5">Sòm 27:5</ref></char></note>fè tèt mwen leve a.<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>Mwen t ap kriye a SENYÈ a ak vwa mwen;</para>
  <para style="q1" vid="PSA 3:4">Li te <note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="PSA 4:3">Sòm 4:3</ref></char></note>reponn mwen soti nan mòn sen Li an <char style="qs">Tan</char><verse eid="PSA 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="LEV 26:6">Lev 26:6</ref></char></note>te kouche e dòmi;</para>
  <para style="q1" vid="PSA 3:5">mwen te leve, paske se SENYÈ a ki ban m fòs.<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>Mwen p ap pè menm dè milye de moun</para>
  <para style="q1" vid="PSA 3:6">ki ta <note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="PSA 118:10-13">Sòm 118:10-13</ref></char></note>pran pozisyon kont mwen de tout kote.<verse eid="PSA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>Leve, O SENYÈ!</para>
  <para style="q1" vid="PSA 3:7">Sove mwen, O Bondye mwen!</para>
  <para style="q1" vid="PSA 3:7">Paske Ou te souflete tout lènmi mwen yo.</para>
  <para style="q1" vid="PSA 3:7">Ou te <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="PSA 57:4">Sòm 57:4</ref></char></note>kraze dan a mechan yo.<verse eid="PSA 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:8">Sòm 28:8</ref>
      </char>
    </note>Delivrans se nan SENYÈ a.</para>
  <para style="q1" vid="PSA 3:8">Ke benediksyon Ou toujou poze sou pèp Ou a.<verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="d">Pou direktè koral la; sou enstriman ak fil yo; yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>Reponn mwen lè m rele Ou, O Bondye ladwati mwen;</para>
  <para style="q1" vid="PSA 4:1">Ou te fè m pran souf nan gran twoub mwen an.</para>
  <para style="q1" vid="PSA 4:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:16">Sòm 25:16</ref>
      </char>
    </note>Fè m gras e tande lapriyè mwen.<verse eid="PSA 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>O fis a lòm yo, jiskilè laglwa Mwen va devni yon repwòch?</para>
  <para style="q1" vid="PSA 4:2">Jiskilè ou va renmen sa ki san valè</para>
  <para style="q1" vid="PSA 4:2">e <note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="PSA 31:18">Sòm 31:18</ref></char></note>tante twonpe moun? <char style="qs">Tan</char><verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>Men konnen ke SENYÈ a te mete nonm Bondye a apa pou Li menm.</para>
  <para style="q1" vid="PSA 4:3">SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="PSA 6:8-9">Sòm 6:8-9</ref></char></note>tande lè m fè apèl Li.<verse eid="PSA 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>Tranble, men <note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EPH 4:26">Ef 4:26</ref></char></note>pa fè peche.</para>
  <para style="q1" vid="PSA 4:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:6">Sòm 77:6</ref>
      </char>
    </note>Reflechi nan kè ou sou kabann ou, e rete kalm. <char style="qs">Tan</char><verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>Ofri sakrifis ladwati yo.</para>
  <para style="q1" vid="PSA 4:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">4:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:3-5">Sòm 37:3-5</ref>
      </char>
    </note>Mete konfyans nan SENYÈ a.<verse eid="PSA 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>Anpil ap di: <note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="JOB 7:7">Job 7:7</ref></char></note>“Kilès ki kab montre nou yon bagay ki bon?”</para>
  <para style="q1" vid="PSA 4:6">SENYÈ, leve wo limyè a vizaj Ou devan nou!<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>Ou te mete <note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="ISA 9:3">És 9:3</ref></char></note>lajwa nan kè m plis pase</para>
  <para style="q1" vid="PSA 4:7">lè gwo rekòlt sereyal mi ak diven nèf vin parèt.<verse eid="PSA 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>Anpè, mwen va kouche pou dòmi,</para>
  <para style="q1" vid="PSA 4:8">paske Ou sèl, SENYÈ, fè m viv ansekirite.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="d">Pou Direktè koral yo; fèt pou akonpanye ak flit. Yon Sòm David.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 54:2">Sòm 54:2</ref>
      </char>
    </note>Prete zòrèy Ou a pawòl mwen yo, O SENYÈ.</para>
  <para style="q1" vid="PSA 5:1">Konsidere refleksyon mwen yo.<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>Koute bri kri sekou mwen yo,</para>
  <para style="q1" vid="PSA 5:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 84:3">Sòm 84:3</ref>
      </char>
    </note>Wa mwen e Bondye mwen.</para>
  <para style="q1" vid="PSA 5:2">Pou Ou menm, mwen ap priye.<verse eid="PSA 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>Nan maten O SENYÈ, Ou va tande vwa mwen.</para>
  <para style="q1" vid="PSA 5:3">Nan maten mwen va vèse bay Ou lapriyè mwen yo.</para>
  <para style="q1" vid="PSA 5:3">M ap<note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="PSA 130:5">Sòm 130:5</ref></char></note>tann, m ap veye.<verse eid="PSA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>Paske Ou se pa yon Bondye ki gen plezi nan mechanste.</para>
  <para style="q1" vid="PSA 5:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:15">Sòm 92:15</ref>
      </char>
    </note>Nanpwen mal ki rete avèk Ou.<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>Sila ki plen ògèy p ap kab kanpe devan zye Ou.</para>
  <para style="q1" vid="PSA 5:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:5">Sòm 11:5</ref>
      </char>
    </note>Ou rayi tout sila ki fè inikite yo.<verse eid="PSA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6"/>Ou <note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="PSA 52:4-5">Sòm 52:4-5</ref></char></note>detwi sila ki pale sa ki fo yo.</para>
  <para style="q1" vid="PSA 5:6">SENYÈ a rayi yon nonm ki vèse san,</para>
  <para style="q1" vid="PSA 5:6">ki twonpe moun.<verse eid="PSA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>Men pou mwen, pa gran lanmou</para>
  <para style="q1" vid="PSA 5:7">dous Ou a mwen va antre lakay Ou.</para>
  <para style="q1" vid="PSA 5:7">Nan tanp sen Ou an mwen va pwostène</para>
  <para style="q1" vid="PSA 5:7">mwen nèt an adorasyon.<verse eid="PSA 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>O SENYÈ, mennen m <note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 31:1">Sòm 31:1</ref></char></note>nan ladwati Ou akoz lènmi mwen yo.</para>
  <para style="q1" vid="PSA 5:8">Fè chemen Ou dwat devan mwen.<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>Nanpwen anyen stab nan pawòl pa yo.</para>
  <para style="q1" vid="PSA 5:9">Anndan yo se pouriti menm.</para>
  <para style="q1" vid="PSA 5:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">5:9 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:13">Wo 3:13</ref> </char>
    </note>Gòj yo se yon tonm ki louvri.</para>
  <para style="q1" vid="PSA 5:9">Yo fè flatè ak lang yo.<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>Kenbe yo koupab, O Bondye.</para>
  <para style="q1" vid="PSA 5:10">Selon pwòp manèv pa yo, kite yo tonbe!</para>
  <para style="q1" vid="PSA 5:10">Nan fòs kantite peche yo pouse yo deyò, paske se <note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="PSA 107:10">Sòm 107:10</ref> </char></note>rebèl yo ye kont Ou.<verse eid="PSA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>Men kite tout sila ki pran refij nan Ou yo, <note caller="+" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="PSA 64:10">Sòm 64:10</ref></char></note>fè kè kontan.</para>
  <para style="q1" vid="PSA 5:11">Kite yo toujou chante ak kè kontan,</para>
  <para style="q1" vid="PSA 5:11">akoz Ou fè abri pou yo.</para>
  <para style="q1" vid="PSA 5:11">Kite sila ki renmen non Ou yo kapab</para>
  <para style="q1" vid="PSA 5:11">fè kè kontan nan Ou.<verse eid="PSA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>Paske se Ou menm ki beni nonm ki dwat la, O SENYÈ,</para>
  <para style="q1" vid="PSA 5:12">Ou ki <note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="PSA 32:7-10">Sòm 32:7-10</ref></char></note>antoure li avèk gras Ou,</para>
  <para style="q1" vid="PSA 5:12">tankou yon boukliye.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="d">Pou direktè koral la; avèk enstriman ak fil yo sou yon gita uit kòd.</para>
  <para style="d">Yon sòm David.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="PSA 38:1">Sòm 38:1</ref></char></note>pa repwoche mwen nan kòlè Ou,</para>
  <para style="q1" vid="PSA 6:1">ni ba m chatiman nan fachez Ou.<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>Fè m gras, O SENYÈ, paske mwen</para>
  <para style="q1" vid="PSA 6:2">chagren anpil.</para>
  <para style="q1" vid="PSA 6:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:2 </char>
      <char style="xt" closed="false">
        <ref loc="HOS 6:1">Os 6:1</ref>
      </char>
    </note>Geri mwen, O SENYÈ, paske zo m yo rele anmwey,<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>epi <note caller="+" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="PSA 88:3">Sòm 88:3</ref></char></note>nanm mwen fè gwo chagren.</para>
  <para style="q1" vid="PSA 6:3">Men Ou, O SENYÈ,—jiskilè?<verse eid="PSA 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>Retounen, O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="PSA 17:13">Sòm 17:13</ref></char></note>fè nanm mwen chape.</para>
  <para style="q1" vid="PSA 6:4">Sove mwen akoz lanmou dous Ou a.<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>Paske mò yo <note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="ECC 9:10">Ekl 9:10</ref></char></note>pa rele non Ou.</para>
  <para style="q1" vid="PSA 6:5">Nan andwa kote mò yo ye a,</para>
  <para style="q1" vid="PSA 6:5">se kilès k ap bay Ou remèsiman?<verse eid="PSA 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>Mwen bouke ak plent ki sòti anndan m.</para>
  <para style="q1" vid="PSA 6:6">Chak nwit, kabann mwen vin naje ak dlo.</para>
  <para style="q1" vid="PSA 6:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">6:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:3">Sòm 42:3</ref>
      </char>
    </note>Dlo ki sòt nan zye m yo fin gate kabann nan.<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:7 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 17:7">Job 17:7</ref>
      </char>
    </note>Zye m pouri nèt ak gwo doulè.</para>
  <para style="q1" vid="PSA 6:7">Yo vin vye nèt akoz tout advèsè mwen yo.<verse eid="PSA 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:8 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:23">Mat 7:23</ref>
      </char>
    </note>Sòti sou mwen, nou tout ki fè mechanste yo,</para>
  <para style="q1" vid="PSA 6:8">paske SENYÈ a te tande gwo kri mwen.<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>SENYÈ a te tande demand priyè mwen.</para>
  <para style="q1" vid="PSA 6:9">SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="PSA 66:19-20">Sòm 66:19-20</ref></char></note>te resevwa lapriyè mwen.<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>Tout lènmi mwen yo va wont e deranje nèt.</para>
  <para style="q1" vid="PSA 6:10">Yo va vire fè bak <note caller="+" style="x"><char style="xo" closed="false">6:10 </char><char style="xt" closed="false"><ref loc="PSA 73:19">Sòm 73:19</ref></char></note>sibitman.</para>
  <para style="q1" vid="PSA 6:10">Yo va vin wont anpil.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="d">Yon Sòm David, ke li te chante a SENYÈ a pou yon moun tribi Benjamin ki te rele Cush.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1"/>O SENYÈ Bondye mwen an, <note caller="+" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="PSA 31:1">Sòm 31:1</ref></char></note>nan Ou mwen kache.</para>
  <para style="q1" vid="PSA 7:1">Sove mwen de tout sila k ap kouri dèyè m yo e fè m sekou,<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>sof ke li ta chire nanm mwen <note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="PSA 57:4">Sòm 57:4</ref></char></note>tankou yon lyon,</para>
  <para style="q1" vid="PSA 7:2">epi rale m akote pandan pa gen moun pou delivre m.<verse eid="PSA 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>O SENYÈ mwen, si mwen menm te fè sa,</para>
  <para style="q1" vid="PSA 7:3">si gen <note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="1SA 24:11">I Sam 24:11</ref></char></note>enjistis nan men m,<verse eid="PSA 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4"/>si mwen te rekonpanse mal a zanmi mwen,</para>
  <para style="q1" vid="PSA 7:4">oswa te <note caller="+" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="1SA 24:7">I Sam 24:7</ref></char></note>piyaje sila ki te lènmi mwen a san koz la,<verse eid="PSA 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>kite lènmi an kouri dèyè nanm mwen</para>
  <para style="q1" vid="PSA 7:5">jiskaske li pran l,</para>
  <para style="q1" vid="PSA 7:5">epi kite li foule lavi mwen jis atè.</para>
  <para style="q1" vid="PSA 7:5">Fè glwa mwen kouche nèt nan pousyè a. <char style="qs">Tan</char><verse eid="PSA 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>Leve, O SENYÈ, nan kòlè Ou;</para>
  <para style="q1" vid="PSA 7:6">leve Ou menm kont <note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="PSA 138:7">Sòm 138:7</ref></char></note>raj ladvèsè mwen yo.</para>
  <para style="q1" vid="PSA 7:6">Leve Ou menm pou mwen;</para>
  <para style="q1" vid="PSA 7:6">Ou menm ki te etabli jijman an.<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>Kite asanble <note caller="+" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="PSA 22:27">Sòm 22:27</ref></char></note> a tout pèp yo antoure Ou.</para>
  <para style="q1" vid="PSA 7:7">Gouvènen yo, depi an wo.<verse eid="PSA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8"/>Se SENYÈ a ki jije pèp yo.</para>
  <para style="q1" vid="PSA 7:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">7:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:20">Sòm 18:20</ref>
      </char>
    </note>Fè m jistis O SENYÈ,</para>
  <para style="q1" vid="PSA 7:8">selon ladwati mwen ak jan mwen kanpe fèm.<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>Alò, mete fen a mechanste malfektè yo,</para>
  <para style="q1" vid="PSA 7:9">men etabli sila ki dwat yo.</para>
  <para style="q1" vid="PSA 7:9">Paske se ladwati Bondye ki <note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="JER 11:20">Jr 11:20</ref></char></note>fè prèv</para>
  <para style="q1" vid="PSA 7:9">nan kè avèk panse moun.<verse eid="PSA 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>Boukliye mwen se avèk Bondye,</para>
  <para style="q1" vid="PSA 7:10">ki <note caller="+" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="PSA 97:10-11">Sòm 97:10-11</ref></char></note>sove sila ki dwat yo.<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>Bondye se yon jij ki jis</para>
  <para style="q1" vid="PSA 7:11">e ki <note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="PSA 90:9">Sòm 90:9</ref></char></note> rayi enjistis chak jou.<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>Si yon nonm pa repanti, La p <note caller="+" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="DEU 32:41">Det 32:41</ref></char></note>file nepe Li.</para>
  <para style="q1" vid="PSA 7:12">Li deja koube banza Li; Li prèt.<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>Anplis, Li fin prepare pou kont Li zam mòtèl yo.</para>
  <para style="q1" vid="PSA 7:13">Li fè flèch ak shaf ki brile yo.<verse eid="PSA 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>Gade byen, l ap lite nan mechanste.</para>
  <para style="q1" vid="PSA 7:14">Wi, li plante jèm mechanste a,</para>
  <para style="q1" vid="PSA 7:14">epi li <note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="ISA 59:4">És 59:4</ref></char></note>vin bay nesans a tout sa ki fo.<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>Li te fouye yon twou, kreve l nèt,</para>
  <para style="q1" vid="PSA 7:15">e vin <note caller="+" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="JOB 4:8">Job 4:8</ref></char></note>tonbe nan twou ke li te fè a.<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:16 </char>
      <char style="xt" closed="false">
        <ref loc="EST 9:25">Est 9:25</ref>
      </char>
    </note>Mechanste li va retounen sou pwòp tèt li,</para>
  <para style="q1" vid="PSA 7:16">e vyolans pa l ap desann sou pwòp fwon li.<verse eid="PSA 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>Mwen va bay remèsiman a SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 71:15-16">Sòm 71:15-16</ref></char></note>selon ladwati Li.</para>
  <para style="q1" vid="PSA 7:17">Mwen va chante lwanj a non SENYÈ a,Toupwisan an.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="d">Pou direktè koral la; jwe sou gitia la.</para>
  <para style="d">Yon sòm David.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>O SENYÈ, Senyè nou an,</para>
  <para style="q1" vid="PSA 8:1">A la non Ou gran sou tout latè!</para>
  <para style="q1" vid="PSA 8:1">Ou te <note caller="+" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="PSA 57:5-11">Sòm 57:5-11</ref></char></note>fè parèt klè mayifisans Ou</para>
  <para style="q1" vid="PSA 8:1">piwo pase syèl yo!<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:16">Mat 21:16</ref>
      </char>
    </note>Soti nan bouch a ti bebe ki fenk fèt yo, ak timoun k ap tete yo,</para>
  <para style="q1" vid="PSA 8:2">Ou te etabli pwisans Ou, akoz advèsè Ou yo,</para>
  <para style="q1" vid="PSA 8:2">pou fè lènmi an avèk vanjè a sispann.<verse eid="PSA 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>Lè m reflechi sou syèl Ou yo, zèv men Ou yo,</para>
  <para style="q1" vid="PSA 8:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">8:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 136:9">Sòm 136:9</ref>
      </char>
    </note>lalin ak zetwal ke Ou te fè yo,<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 144:3">Sòm 144:3</ref>
      </char>
    </note>Kisa lòm nan ye, pou Ou reflechi sou li?</para>
  <para style="q1" vid="PSA 8:4">Oswa fis a lòm nan, pou Ou pran swen li?<verse eid="PSA 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>Malgre, Ou te fè li yon <note caller="+" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="GEN 1:26">Jen 1:26</ref></char></note>ti kras pi ba pase Bondye,</para>
  <para style="q1" vid="PSA 8:5">e te kouwone li ak glwa avèk lonè!<verse eid="PSA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>Ou fè li regne sou zèv men Ou yo.</para>
  <para style="q1" vid="PSA 8:6">Ou <note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="EPH 1:22">Ef 1:22</ref></char></note>te mete tout bagay anba pye li:<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>Tout mouton yo ak bèf yo, avèk bèt sovaj nan chan,<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>zwazo nan syèl yo, avèk pwason lanmè yo,</para>
  <para style="q1" vid="PSA 8:8">ak tout sa ki pase nan chemen lanmè yo.<verse eid="PSA 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>O SENYÈ, mèt nou an, a la non Ou gran sou tout latè a.<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="d">Pou direktè koral la; Yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1"/>Mwen va bay remèsiman a SENYÈ a ak <note caller="+" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="PSA 86:12">Sòm 86:12</ref></char></note>tout kè m;</para>
  <para style="q1" vid="PSA 9:1">Mwen va pale tout mèvèy Ou yo.<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>Mwen va fè kè kontan e rejwi nan Ou;</para>
  <para style="q1" vid="PSA 9:2">Mwen va chante lwanj non Ou, O <note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="PSA 83:18">Sòm 83:18</ref></char></note>Pi Wo a.<verse eid="PSA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>Lè lènmi m yo vire fè bak, yo <note caller="+" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="PSA 27:2">Sòm 27:2</ref></char></note>tonbe e peri devan Ou.<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>Paske Ou te bay soutyen a dwa m,</para>
  <para style="q1" vid="PSA 9:4">avèk koz mwen ki jis;</para>
  <para style="q1" vid="PSA 9:4">Ou chita sou twòn Ou e fè jijman avèk ladwati.<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>Ou te fè chatiman nasyon yo;</para>
  <para style="q1" vid="PSA 9:5">Ou te detwi mechan yo;</para>
  <para style="q1" vid="PSA 9:5">Ou te <note caller="+" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="PSA 69:28">Sòm 69:28</ref></char></note>efase non yo jis pou tout tan e pou tout tan.<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>Lènmi an te rive a nan fen, e li te kraze nèt.</para>
  <para style="q1" vid="PSA 9:6">Ou te dechouke vil yo, jiskaske <note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="PSA 34:1">Sòm 34:1</ref></char></note>memwa a yo vin disparèt.<verse eid="PSA 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>Men <note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="PSA 89:14">Sòm 89:14</ref></char></note>SENYÈ a la jis pou tout tan;</para>
  <para style="q1" vid="PSA 9:7">Li te etabli twòn Li pou jijman.<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>Li va jije mond lan avèk ladwati;</para>
  <para style="q1" vid="PSA 9:8">Li va rann jijman pou pèp yo avèk jistis.<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>SENYÈ a va osi yon sitadèl pou sila ki oprime yo;</para>
  <para style="q1" vid="PSA 9:9">yon sitadèl nan tan twoub la.<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>Sila ki konnen non Ou yo, va mete konfyans yo nan Ou,</para>
  <para style="q1" vid="PSA 9:10">paske Ou menm, SENYÈ, pa janm abandone</para>
  <para style="q1" vid="PSA 9:10">sila ki mete konfyans nan Ou yo.<verse eid="PSA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>Chante lwanj a SENYÈ a, ki <note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="PSA 76:2">Sòm 76:2</ref></char></note>rete nan Sion;</para>
  <para style="q1" vid="PSA 9:11">deklare pami pèp yo zèv Li yo.<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>Paske Sila ki egzije san an sonje yo;</para>
  <para style="q1" vid="PSA 9:12">Li pa janm bliye kri a sila ki oprime yo.<verse eid="PSA 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>Fè m gras, O SENYÈ;</para>
  <para style="q1" vid="PSA 9:13">gade byen soufrans mwen akoz sila ki rayi mwen yo,</para>
  <para style="q1" vid="PSA 9:13">e <note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="PSA 30:3">Sòm 30:3</ref></char></note>fè m leve soti nan pòtay lanmò yo,<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>pou m kab pale tout lwanj a Ou menm.</para>
  <para style="q1" vid="PSA 9:14">Konsa, nan pòtay a fi Sion yo,</para>
  <para style="q1" vid="PSA 9:14">mwen kapab <note caller="+" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="PSA 13:5">Sòm 13:5</ref></char></note>rejwi nan delivrans Ou.<verse eid="PSA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>Nasyon yo fin fonse kole nan twou fòs yo te fè a;</para>
  <para style="q1" vid="PSA 9:15">nan <note caller="+" style="x"><char style="xo" closed="false">9:15 </char><char style="xt" closed="false"><ref loc="PSA 57:6">Sòm 57:6</ref></char></note>pèlen yo te fè, pwòp pye yo vin kole ladann.<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>Senyè a te <note caller="+" style="x"><char style="xo" closed="false">9:16 </char><char style="xt" closed="false"><ref loc="EXO 7:5">Egz 7:5</ref></char></note>leve tèt Li pou yo wè;</para>
  <para style="q1" vid="PSA 9:16">Li te rann jijman an.</para>
  <para style="q1" vid="PSA 9:16">Nan zèv a pwòp men Li, mechan an</para>
  <para style="q1" vid="PSA 9:16">kole nan pwòp pèlen li. <char style="qs">Tan</char><verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:17 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 49:14">Sòm 49:14</ref>
      </char>
    </note>Mechan yo va retounen nan sejou lanmò a;</para>
  <para style="q1" vid="PSA 9:17">menm tout nasyon ki bliye Bondye yo.<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>Paske <note caller="+" style="x"><char style="xo" closed="false">9:18 </char><char style="xt" closed="false"><ref loc="PSA 9:12">Sòm 9:12</ref></char></note>malere yo p ap bliye jis pou tout tan,</para>
  <para style="q1" vid="PSA 9:18">ni espwa a aflije yo p ap peri pou tout tan.<verse eid="PSA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>Leve, <note caller="+" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="NUM 10:35">Nonb 10:35</ref></char></note>O SENYÈ, pa kite lòm vin genyen;</para>
  <para style="q1" vid="PSA 9:19">kite nasyon yo jije devan Ou.<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>Bay yo lakrent, O SENYÈ;</para>
  <para style="q1" vid="PSA 9:20">fè nasyon yo konnen ke se sèlman <note caller="+" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="PSA 62:9">Sòm 62:9</ref></char></note>lòm yo ye. <char style="qs">Tan</char><verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>Poukisa Ou kanpe tèlman lwen, O Senyè?</para>
  <para style="q1" vid="PSA 10:1">Poukisa <note caller="+" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Sòm 22:1</ref></char></note>Ou kache Ou menm nan tan twoub yo?<verse eid="PSA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>Nan ògèy pa yo, mechan yo kouri cho dèyè aflije yo.</para>
  <para style="q1" vid="PSA 10:2">Kite yo <note caller="+" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="PSA 7:16">Sòm 7:16</ref></char></note>kenbe nan menm pèlen ke yo te fè a.<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>Paske mechan a ap vin ògeye sou <note caller="+" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="PSA 94:3">Sòm 94:3</ref></char></note>dezi kè li a;</para>
  <para style="q1" vid="PSA 10:3">li beni moun voras la,</para>
  <para style="q1" vid="PSA 10:3">e eksprime madichon pou l rejte SENYÈ a.<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>Mechan an nan wotè rega li, refize chache Bondye,</para>
  <para style="q1" vid="PSA 10:4">Tout panse li se ke: <note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="PSA 14:1">Sòm 14:1</ref></char></note>“Nanpwen Bondye.”<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>Chemen pa li yo reyisi tout tan;</para>
  <para style="q1" vid="PSA 10:5">Jijman Ou yo tèlman wo, li pa wè yo.</para>
  <para style="q1" vid="PSA 10:5">Selon lènmi li yo, li giyonnen yo.<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>Li di a pwòp tèt li: <note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="REV 18:7">Rev 18:7</ref></char></note>“Mwen p ap ebranle menm;</para>
  <para style="q1" vid="PSA 10:6">Pandan tout jenerasyon yo,</para>
  <para style="q1" vid="PSA 10:6">mwen p ap gen pwoblèm ditou.”<verse eid="PSA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:7 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:14">Wo 3:14</ref>
      </char>
    </note>Bouch li plen ak malediksyon, avèk</para>
  <para style="q1" vid="PSA 10:7">twonpe moun avèk oprime moun.</para>
  <para style="q1" vid="PSA 10:7">Anba lang li, se twonpe moun avèk mechanste.<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>Li chita nan anbiskad pou veye vil yo;</para>
  <para style="q1" vid="PSA 10:8">nan anbiskad yo, li <note caller="+" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="PSA 94:6">Sòm 94:6</ref></char></note>touye inosan yo.</para>
  <para style="q1" vid="PSA 10:8">Zye li yo veye san bat sila ki pa gen espwa yo.<verse eid="PSA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9"/>Li kache yon kote an kachèt tankou lyon nan nan kav li.</para>
  <para style="q1" vid="PSA 10:9">Li kache pou kenbe aflije yo;</para>
  <para style="q1" vid="PSA 10:9">li kenbe aflije yo lè l rale mennen yo rive nan pèlen <note caller="+" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="PSA 140:5">Sòm 140:5</ref></char></note>an.<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>Li akwoupi, li pare kò l;</para>
  <para style="q1" vid="PSA 10:10">konsa malere a vin tonbe</para>
  <para style="q1" vid="PSA 10:10">pa grif pwisan li yo.<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>Li pale a tèt li: <note caller="+" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="PSA 10:4">Sòm 10:4</ref></char></note>“Bondye bliye.</para>
  <para style="q1" vid="PSA 10:11">Li kache figi Li; Li p ap janm wè sa.”<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>Leve O SENYÈ!</para>
  <para style="q1" vid="PSA 10:12">O Bondye, <note caller="+" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="PSA 17:7">Sòm 17:7</ref></char></note>leve men Ou wo!</para>
  <para style="q1" vid="PSA 10:12">Pa bliye aflije yo!<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>Poukisa mechan an te meprize Bondye?</para>
  <para style="q1" vid="PSA 10:13">Li te di nan tèt li: “Ou p ap egzije m sa”.<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>Ou te wè sa, paske Ou te wè kont</para>
  <para style="q1" vid="PSA 10:14">mechanste ak agase moun pou pran sa an men.</para>
  <para style="q1" vid="PSA 10:14">Malere a ap depann de Ou menm;</para>
  <para style="q1" vid="PSA 10:14">Se Ou ki konn ede <note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="PSA 68:5">Sòm 68:5</ref></char></note>òfelen an.<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:15 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:17">Sòm 37:17</ref>
      </char>
    </note>Kase bra a mechan yo avèk malfektè a!</para>
  <para style="q1" vid="PSA 10:15">Dekouvri mechanste li yo jiskaske</para>
  <para style="q1" vid="PSA 10:15">Ou pa twouve l ankò.<verse eid="PSA 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>SENYÈ a se Wa a pou tout tan!</para>
  <para style="q1" vid="PSA 10:16">
    <note caller="+" style="x">
      <char style="xo" closed="false">10:16 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 8:20">Det 8:20</ref>
      </char>
    </note>Nasyon yo va peri disparèt de peyi Li a.<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>O SENYÈ, Ou te tande <note caller="+" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="PSA 9:18">Sòm 9:18</ref></char></note>dezi a enb yo;</para>
  <para style="q1" vid="PSA 10:17">Ou va ranfòse kè yo, Ou va enkline zòrèy Ou,<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>pou bay jistis a òfelen an avèk <note caller="+" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="PSA 9:9">Sòm 9:9</ref></char></note>oprime a,</para>
  <para style="q1" vid="PSA 10:18">pou lòm ki mache sou tè a, pa koze laperèz ankò.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="d">Pou direktè koral la; yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>Se nan SENYÈ a ke m <note caller="+" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="PSA 2:12">Sòm 2:12</ref></char></note>kache.</para>
  <para style="q1" vid="PSA 11:1">Kijan ou kapab di a nanm mwen:</para>
  <para style="q1" vid="PSA 11:1">“Sove ale kon yon zwazo nan mòn ou;<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>Paske, gade byen, mechan yo koube banza,</para>
  <para style="q1" vid="PSA 11:2">Yo <note caller="+" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="PSA 64:3">Sòm 64:3</ref> </char></note>fè flèch yo parèt sou kòd la,</para>
  <para style="q1" vid="PSA 11:2">pou tire nan fènwa sou sila ak kè ki dwat yo.<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>Si <note caller="+" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="PSA 82:5">Sòm 82:5</ref></char></note>fondasyon yo vin detwi,</para>
  <para style="q1" vid="PSA 11:3">se kisa moun dwat yo kab fè?”<verse eid="PSA 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>SENYÈ a nan sen tanp Li an.</para>
  <para style="q1" vid="PSA 11:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">11:4 </char>
      <char style="xt" closed="false">
        <ref loc="REV 4:2">Rev 4:2</ref> </char>
    </note>SENYÈ a sou twon Li nan syèl la.</para>
  <para style="q1" vid="PSA 11:4">Zye Li veye.</para>
  <para style="q1" vid="PSA 11:4">Pòpyè zye Li sonde fis a lòm yo.<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="GEN 22:1">Jen 22:1</ref></char></note>sonde sila ki jis yo avèk sila ki mechan yo;</para>
  <para style="q1" vid="PSA 11:5">men sila ki renmen vyolans, Li rayi nan kè L.<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>Sou mechan yo, Li va <note caller="+" style="x"><char style="xo" closed="false">11:6 </char><char style="xt" closed="false"><ref loc="PSA 18:13-14">Sòm 18:13-14</ref></char></note>voye chabon cho tankou lapli;</para>
  <para style="q1" vid="PSA 11:6">dife avèk souf avèk chabon brile va mele nan bwason yo.<verse eid="PSA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>Paske Bondye dwat.</para>
  <para style="q1" vid="PSA 11:7">Li renmen ladwati.</para>
  <para style="q1" vid="PSA 11:7">Sila ki kanpe dwat yo va <note caller="+" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="PSA 16:11">Sòm 16:11</ref></char></note>wè figi Li.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="d">Pou direktè koral la; sou yon gita uit kòd</para>
  <para style="d">Yon sòm David.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>Sekou, SENYÈ, paske <note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ISA 57:1">És 57:1</ref></char></note>moun ladwati yo sispann egziste,</para>
  <para style="q1" vid="PSA 12:1">Paske fidèl yo vin disparèt pami fis a lòm yo.<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>Yo pale sa ki fo a youn lòt.</para>
  <para style="q1" vid="PSA 12:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">12:2 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 16:18">Wo 16:18</ref>
      </char>
    </note>Lèv flatè yo ak kè doub yo pale.<verse eid="PSA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>Ke SENYÈ a vin koupe tout lèv flatè yo,</para>
  <para style="q1" vid="PSA 12:3">ak lang ki <note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="DAN 7:8">Dan 7:8</ref></char></note>pale gwo bagay yo;<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>ki <note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="PSA 73:8-9">Sòm 73:8-9</ref></char></note>te di: “Avèk lang nou, nou va reyisi.</para>
  <para style="q1" vid="PSA 12:4">Lèv nou se pou nou.</para>
  <para style="q1" vid="PSA 12:4">Se kilès ki kab mèt sou nou?”<verse eid="PSA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>“Akoz dega a aflije yo, akoz kri a malere yo,</para>
  <para style="q1" vid="PSA 12:5">koulye a, <note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="ISA 33:10">És 33:10</ref></char></note>Mwen va leve”, pale SENYÈ a;</para>
  <para style="q1" vid="PSA 12:5">“Mwen va mete li ansekirite de sila ki maltrete l la.”<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>Pawòl a SENYÈ a se pawòl ki san tach;</para>
  <para style="q1" vid="PSA 12:6">tankou ajan ki <note caller="+" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="PRO 30:5">Pwov 30:5</ref></char></note>teste nan founo,</para>
  <para style="q1" vid="PSA 12:6">rafine nan tè sèt fwa.<verse eid="PSA 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>Ou menm, O SENYÈ, va pwoteje yo.</para>
  <para style="q1" vid="PSA 12:7">Ou va <note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="PSA 37:28">Sòm 37:28</ref></char></note>prezève yo soti nan</para>
  <para style="q1" vid="PSA 12:7">jenerasyon sila a jis pou tout tan.<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>Mechan yo pwomennen toupatou tout kote</para>
  <para style="q1" vid="PSA 12:8">lè <note caller="+" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="ISA 32:5">És 32:5</ref> </char></note>bagay ki lèd vin leve wo</para>
  <para style="q1" vid="PSA 12:8">pami fis a lòm yo.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="d">Pou direktè koral la; yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>Jiskilè SENYÈ?</para>
  <para style="q1" vid="PSA 13:1">Èske Ou ap <note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="JOB 13:24">Job 13:24</ref></char></note>bliye mwen jis pou tout tan?</para>
  <para style="q1" vid="PSA 13:1">Pou konbyen de tan, Ou va kache figi Ou de mwen?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>Pou konbyen de tan mwen va oblije</para>
  <para style="q1" vid="PSA 13:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">13:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:4">Sòm 42:4</ref>
      </char>
    </note>depann sou pwòp konsèy tèt mwen,</para>
  <para style="q1" vid="PSA 13:2">ak tristès nan kè m tout lajounen?</para>
  <para style="q1" vid="PSA 13:2">Jiskilè lènmi m va vin leve wo sou mwen?<verse eid="PSA 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>Okipe m, e reponn mwen, O SENYÈ, Bondye mwen;</para>
  <para style="q1" vid="PSA 13:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">13:3 </char>
      <char style="xt" closed="false">
        <ref loc="EZR 9:8">Esd 9:8</ref>
      </char>
    </note>Fè zye m wè, pou m pa mouri;<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>pou lènmi mwen an pa di: “Mwen fin genyen l,”</para>
  <para style="q1" vid="PSA 13:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">13:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:2">Sòm 25:2</ref>
      </char>
    </note>epi advèsè mwen yo rejwi lè m pran chòk.<verse eid="PSA 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>Men mwen va <note caller="+" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="PSA 52:8">Sòm 52:8</ref></char></note>mete konfyans mwen nan lanmou dous Ou a;</para>
  <para style="q1" vid="PSA 13:5">Kè m va rejwi nan delivrans ou<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="PSA 96:1">Sòm 96:1</ref></char></note>chante a SENYÈ a,</para>
  <para style="q1" vid="PSA 13:6">paske Li te aji ak bon kè avè m.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="d">Pou direktè koral la; yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1"/>Moun fou a di nan kè l: “Nanpwen Bondye.”</para>
  <para style="q1" vid="PSA 14:1">Yo konwonpi.</para>
  <para style="q1" vid="PSA 14:1">Yo te fè zak abominab.</para>
  <para style="q1" vid="PSA 14:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:10-12">Wo 3:10-12</ref>
      </char>
    </note>Nanpwen ki fè sa ki bon.<verse eid="PSA 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>SENYÈ a te gade anba soti nan syèl la</para>
  <para style="q1" vid="PSA 14:2">sou fis a lòm yo pou wè si genyen</para>
  <para style="q1" vid="PSA 14:2">ki <note caller="+" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="PSA 92:6">Sòm 92:6</ref></char></note>konprann, k ap chache Bondye.<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>Yo tout te vire akote.</para>
  <para style="q1" vid="PSA 14:3">Ansanm yo te vin konwonpi.</para>
  <para style="q1" vid="PSA 14:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">14:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 143:2">Sòm 143:2</ref>
      </char>
    </note>Nanpwen ki fè sa ki bon, pa menm youn.<verse eid="PSA 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>Èske tout malfektè inikite yo pa konnen,</para>
  <para style="q1" vid="PSA 14:4">sila Ki <note caller="+" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="JER 10:25">Jr 10:25</ref></char></note>manje pèp mwen yo</para>
  <para style="q1" vid="PSA 14:4">tankou y ap manje pen an,</para>
  <para style="q1" vid="PSA 14:4">san yo pa rele SENYÈ a?<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>La, yo nan gwo danje,</para>
  <para style="q1" vid="PSA 14:5">paske Bondye rete avèk jenerasyon ki dwat la.<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>Nou meprize bezwen aflije a,</para>
  <para style="q1" vid="PSA 14:6">men SENYÈ a se <note caller="+" style="x"><char style="xo" closed="false">14:6 </char><char style="xt" closed="false"><ref loc="PSA 46:1">Sòm 46:1</ref></char></note>refij li.<verse eid="PSA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>O ke sali Israël la ta sòti nan Sion!</para>
  <para style="q1" vid="PSA 14:7">Lè SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="PSA 85:1-2">Sòm 85:1-2</ref></char></note>restore pèp kaptif li a,</para>
  <para style="q1" vid="PSA 14:7">Jacob va rejwi, e Israël va gen kè kontan.<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="d">Yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>O SENYÈ, se kilès ki kab rete nan tant Ou?</para>
  <para style="q1" vid="PSA 15:1">Kilès ki kab demere sou <note caller="+" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="PSA 24:3">Sòm 24:3</ref></char></note> mòn sen Ou an?<verse eid="PSA 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>Sila ki mache nan entegrite a e ki fè zèv ladwati yo;</para>
  <para style="q1" vid="PSA 15:2">li ki pale verite a nan kè li a;<verse eid="PSA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3"/>ki pa fè kout lang sou lòt,</para>
  <para style="q1" vid="PSA 15:3">ni fè vwazen li mal,</para>
  <para style="q1" vid="PSA 15:3">ni patisipe nan fè repwòch kont zanmi li;<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>nan zye a sila yon vagabon meprize a,</para>
  <para style="q1" vid="PSA 15:4">men ki <note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="ACT 28:10">Trav 28:10</ref></char></note>bay lonè a sila ki fè lakrent SENYÈ yo;</para>
  <para style="q1" vid="PSA 15:4">li sèmante a pwòp pèt li, menm lè l fè l mal,</para>
  <para style="q1" vid="PSA 15:4">e li pa chanje menm;<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>Li pa vèse bay lajan li avèk enterè,</para>
  <para style="q1" vid="PSA 15:5">ni <note caller="+" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="EXO 23:8">Egz 23:8</ref></char></note>li pa aksepte yon kado anba tab kont inosan an.</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q1" vid="PSA 15:5">Sila ki fè bagay sa yo p ap janm ebranle.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="d">Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>Pwoteje m O Bondye, paske <note caller="+" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="PSA 7:1">Sòm 7:1</ref></char></note>mwen kache nan Ou.<verse eid="PSA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>Mwen te di a SENYÈ, Ou se Senyè mwen.</para>
  <para style="q1" vid="PSA 16:2">Mwen pa gen anyen ki bon sof ke Ou menm.<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>Selon sen sou latè yo, se moun manyifik yo ye;</para>
  <para style="q1" vid="PSA 16:3">sou yo menm mwen pran tout plezi m yo.<verse eid="PSA 16:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>Doulè a sila ki te fè donn a yon lòt dye va vin ogmante;</para>
  <para style="q1" vid="PSA 16:4">Mwen p ap vin vide ofrann bwason san pa yo,</para>
  <para style="q1" vid="PSA 16:4">ni non yo <note caller="+" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="EXO 23:13">Egz 23:13</ref> </char></note>p ap sòti sou lèv mwen.<verse eid="PSA 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>SENYÈ a se <note caller="+" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="PSA 73:26">Sòm 73:26</ref></char></note>pòsyon eritaj mwen ak tas mwen;</para>
  <para style="q1" vid="PSA 16:5">Se Ou menm ki bay soutyen a pati pa m nan.<verse eid="PSA 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:55">Sòm 78:55</ref>
      </char>
    </note>Lizyè yo vin tonbe nan kote ki tèlman bèl pou mwen.</para>
  <para style="q1" vid="PSA 16:6">Anverite, eritaj mwen bèl pou mwen.<verse eid="PSA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>Mwen va beni SENYÈ a ki te ban m konsèy la.</para>
  <para style="q1" vid="PSA 16:7">Anverite, <note caller="+" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="PSA 77:6">Sòm 77:6</ref></char></note>panse mwen toujou vin enstwi mwen pandan lannwit.<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:8-11">Sòm 16:8-11</ref>
      </char>
    </note>Mwen te mete SENYÈ a devan zye m tout tan.</para>
  <para style="q1" vid="PSA 16:8">Akoz Li se men dwat mwen, mwen p ap ebranle menm.<verse eid="PSA 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>Pou sa, <note caller="+" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="PSA 4:7">Sòm 4:7</ref></char></note>kè m kontan e glwa mwen fè rejwisans.</para>
  <para style="q1" vid="PSA 16:9">Anplis, chè m va toujou pwoteje.<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>Paske Ou p ap abandone nanm mwen</para>
  <para style="q1" vid="PSA 16:10">nan sejou mò yo;</para>
  <para style="q1" vid="PSA 16:10">ni Ou p ap <note caller="+" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="ACT 13:35">Trav 13:35</ref></char></note>pèmèt Sila Ki Sen Ou an vin tonbe an pouriti.<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>Ou va fè m rekonèt <note caller="+" style="x"><char style="xo" closed="false">16:11 </char><char style="xt" closed="false"><ref loc="PSA 139:24">Sòm 139:24</ref></char></note>chemen lavi a.</para>
  <para style="q1" vid="PSA 16:11">Nan prezans Ou, se lajwa ki an abondans nèt.</para>
  <para style="q1" vid="PSA 16:11">Nan men dwat Ou, se plezi ki dire jis pou tout tan.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="d">Yon Priyè a David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>Koute yon koz ki jis, O SENYÈ e okipe kri mwen.</para>
  <para style="q1" vid="PSA 17:1">Prete zòrèy a lapriyè mwen,</para>
  <para style="q1" vid="PSA 17:1">ki pa sòti nan <note caller="+" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="ISA 29:13">És 29:13</ref></char></note>lèv k ap twonpe moun.<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>Kite <note caller="+" style="x"><char style="xo" closed="false">17:2 </char><char style="xt" closed="false"><ref loc="PSA 103:6">Sòm 103:6</ref></char></note>pawòl mwen parèt akoz prezans Ou;</para>
  <para style="q1" vid="PSA 17:2">Kite zye Ou gade avèk jistis.<verse eid="PSA 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>Ou te teste kè m.</para>
  <para style="q1" vid="PSA 17:3">Ou te vizite mwen pandan lannwit.</para>
  <para style="q1" vid="PSA 17:3">Ou te <note caller="+" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="1PE 1:7">I Pi 1:7</ref></char></note>sonde mwen e Ou pa t jwenn anyen.</para>
  <para style="q1" vid="PSA 17:3">Mwen te fè desizyon eksprè pou bouch mwen pa fè tò.<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>Alò, pou zèv a lòm yo, <note caller="+" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="PSA 119:9">Sòm 119:9</ref></char></note>selon pawòl a lèv Ou yo,</para>
  <para style="q1" vid="PSA 17:4">Mwen te evite chemen a vyolan yo.<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:5 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 23:11">Job 23:11</ref>
      </char>
    </note>Pye mwen yo te kenbe fèm nan chemen pa W la.</para>
  <para style="q1" vid="PSA 17:5">Pye mwen pat janm glise.<verse eid="PSA 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">17:6 </char><char style="xt" closed="false"><ref loc="PSA 86:7">Sòm 86:7</ref></char></note>te rele Ou, paske Ou va reponn mwen, O Bondye.</para>
  <para style="q1" vid="PSA 17:6">Enkline zòrèy W bò kote m.</para>
  <para style="q1" vid="PSA 17:6">Tande pawòl mwen yo.<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>Kon mèvèy Ou yo, montre m lanmou dous Ou a,</para>
  <para style="q1" vid="PSA 17:7">O Sovè a sila ki kache nan men dwat Ou yo, kont sila ki leve kont yo.<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>Kenbe m tankou <note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="DEU 32:10">Det 32:10</ref></char></note>de zye nan tèt Ou.</para>
  <para style="q1" vid="PSA 17:8">Kache mwen anba lonbraj a zèl Ou,<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>kont mechan ki depouye m yo,</para>
  <para style="q1" vid="PSA 17:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">17:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:20">Sòm 31:20</ref>
      </char>
    </note>lènmi mòtèl mwen yo ki antoure m.<verse eid="PSA 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>Yo fin fèmen kè rèd yo.</para>
  <para style="q1" vid="PSA 17:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">17:10 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 15:27">Job 15:27</ref>
      </char>
    </note>Avèk bouch yo, yo pale awogans.<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>Koulye a, yo fin <note caller="+" style="x"><char style="xo" closed="false">17:11 </char><char style="xt" closed="false"><ref loc="PSA 88:17">Sòm 88:17</ref></char></note>antoure nou pandan n ap mache.</para>
  <para style="q1" vid="PSA 17:11">Yo fikse zye yo sou nou pou jete nou atè.<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>Se tankou yon lyon ki anvi devore,</para>
  <para style="q1" vid="PSA 17:12">tankou yon jenn lyon k ap <note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="PSA 10:9">Sòm 10:9</ref> </char></note>kache</para>
  <para style="q1" vid="PSA 17:12">nan fènwa.<verse eid="PSA 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>Leve, O SENYÈ, konfwonte li e bese li;</para>
  <para style="q1" vid="PSA 17:13">Delivre nanm mwen de mechan yo avèk <note caller="+" style="x"><char style="xo" closed="false">17:13 </char><char style="xt" closed="false"><ref loc="PSA 22:20">Sòm 22:20</ref> </char></note>nepe Ou,<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>Depi nan men mesye yo avèk men Ou, O SENYÈ,</para>
  <para style="q1" vid="PSA 17:14">depi nan men lòm de mond sa yo,</para>
  <para style="q1" vid="PSA 17:14">
    <note caller="+" style="x">
      <char style="xo" closed="false">17:14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 73:3-7">Sòm 73:3-7</ref>
      </char>
    </note>k ap resevwa pòsyon pa yo nan vi sa a.</para>
  <para style="q1" vid="PSA 17:14">Men Ou menm plen vant a sila Ou renmen yo.</para>
  <para style="q1" vid="PSA 17:14">Fis ou yo gen kont,</para>
  <para style="q1" vid="PSA 17:14">e yo mete an rezèv pou pitit pa yo.<verse eid="PSA 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>Pou mwen menm, mwen va <note caller="+" style="x"><char style="xo" closed="false">17:15 </char><char style="xt" closed="false"><ref loc="PSA 11:7">Sòm 11:7</ref></char></note>wè figi Ou nan ladwati a;</para>
  <para style="q1" vid="PSA 17:15">mwen va satisfè avèk vizaj Ou</para>
  <para style="q1" vid="PSA 17:15">lè m ouvri zye m.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="d">Pou direktè koral la. Yon sòm David, sèvitè SENYÈ a, ki te pale a SENYÈ a, pawòl a chan ke li te adrese bay SENYÈ a apre Li te delivre li soti nan men a tout lènmi li yo, e soti nan men a Saül. Konsa li te di:</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>Mwen renmen Ou, O SENYÈ, fòs mwen.<verse eid="PSA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>SENYÈ a se <note caller="+" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="DEU 32:18">Det 32:18</ref></char></note> wòch mwen, sitadèl mwen e Delivrans mwen;</para>
  <para style="q1" vid="PSA 18:2">Bondye mwen, wòch mwen, nan sila mwen jwenn pwoteksyon an.<verse eid="PSA 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>Mwen rele SENYÈ a, ki dign pou bay lwanj;</para>
  <para style="q1" vid="PSA 18:3">epi mwen <note caller="+" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="PSA 34:6">Sòm 34:6</ref></char></note>sove de lènmi mwen yo.<verse eid="PSA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 116:3">Sòm 116:3</ref>
      </char>
    </note>Kòd lanmò yo te antoure mwen.</para>
  <para style="q1" vid="PSA 18:4">Flèv mal ki sòti nan peyi a mò yo te teworize m.<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>Kòd peyi lanmò yo te antoure mwen;</para>
  <para style="q1" vid="PSA 18:5">pèlen lanmò yo te parèt devan m.<verse eid="PSA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>Nan gwo twoub mwen, mwen te rele SENYÈ a,</para>
  <para style="q1" vid="PSA 18:6">e te kriye a Bondye pou sekou.</para>
  <para style="q1" vid="PSA 18:6">Depi nan tanp li an, li te tande vwa m.</para>
  <para style="q1" vid="PSA 18:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">18:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:15">Sòm 34:15</ref>
      </char>
    </note>Kri mwen pou sekou devan L</para>
  <para style="q1" vid="PSA 18:6">te rive nan zòrèy Li.<verse eid="PSA 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>Konsa, latè a te tranble.</para>
  <para style="q1" vid="PSA 18:7">Fondasyon a mòn yo te tranble.</para>
  <para style="q1" vid="PSA 18:7">Yo te ebranle nèt, akoz kòlè Li.<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>Lafimen te sòti nan nen L.</para>
  <para style="q1" vid="PSA 18:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">18:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:3">Sòm 50:3</ref>
      </char>
    </note>Dife a devoran te soti nan bouch Li.</para>
  <para style="q1" vid="PSA 18:8">Chalè li te limen chabon.<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>Anplis, Li te bese syèl la e te desann</para>
  <para style="q1" vid="PSA 18:9">avèk <note caller="+" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="PSA 97:2">Sòm 97:2</ref></char></note>fènwa byen pwès anba pye Li.<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>Li te monte sou yon cheriben, e te vole;</para>
  <para style="q1" vid="PSA 18:10">Li te vole sou <note caller="+" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="PSA 104:3">Sòm 104:3</ref></char></note>zèl a van yo.<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>Li te sèvi <note caller="+" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="DEU 4:11">Det 4:11</ref></char></note>fènwa a tankou kote pou L kache, yon tant ki pou kouvri L.</para>
  <para style="q1" vid="PSA 18:11">Fènwa nan dlo yo, nwaj pwès nan syèl yo.<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>Soti nan gran <note caller="+" style="x"><char style="xo" closed="false">18:12 </char><char style="xt" closed="false"><ref loc="PSA 104:2">Sòm 104:2</ref></char></note>klate devan L,</para>
  <para style="q1" vid="PSA 18:12">gwo nwaj pwès Li yo,</para>
  <para style="q1" vid="PSA 18:12">Lagrèl avèk chabon dife te pase.<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>Anplis, SENYÈ a te eklate nan syèl yo.</para>
  <para style="q1" vid="PSA 18:13">Pi Pwisan an te fè vwa l sone:</para>
  <para style="q1" vid="PSA 18:13">wòch lagrèl yo avèk chabon dife.<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>Li te <note caller="+" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="PSA 144:6">Sòm 144:6</ref></char></note>voye flèch li yo deyò e te gaye yo.</para>
  <para style="q1" vid="PSA 18:14">Avèk anpil gwo klate, Li te fè yo sove ale.<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>Konsa, gwo kanal dlo yo te parèt;</para>
  <para style="q1" vid="PSA 18:15">Fondasyon mond yo te vin toutouni;</para>
  <para style="q1" vid="PSA 18:15">ak repwòch Ou, O SENYÈ,</para>
  <para style="q1" vid="PSA 18:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">18:15 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:9">Sòm 106:9</ref>
      </char>
    </note>lè gwo souf sòti nan nen Ou.<verse eid="PSA 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>Li te voye soti an wo.</para>
  <para style="q1" vid="PSA 18:16">Li te pran m.</para>
  <para style="q1" vid="PSA 18:16">Li te rale mwen sòti nan pil dlo yo.<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>Li te <note caller="+" style="x"><char style="xo" closed="false">18:17 </char><char style="xt" closed="false"><ref loc="PSA 59:1">Sòm 59:1</ref></char></note>delivre mwen nan men</para>
  <para style="q1" vid="PSA 18:17">advèsè mwen byen fò;</para>
  <para style="q1" vid="PSA 18:17">de sila yo ki te rayi mwen yo,</para>
  <para style="q1" vid="PSA 18:17">paske yo te twò fò pou mwen.<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>Yo te konfwonte mwen nan jou malè mwen,</para>
  <para style="q1" vid="PSA 18:18">men <note caller="+" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="PSA 16:8">Sòm 16:8</ref></char></note>SENYÈ a te pwotèj mwen.<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>Li te mennen mwen fè m parèt nan yon bèl plas byen laj.</para>
  <para style="q1" vid="PSA 18:19">Li te fè m sekou, akoz <note caller="+" style="x"><char style="xo" closed="false">18:19 </char><char style="xt" closed="false"><ref loc="PSA 37:23">Sòm 37:23</ref></char></note>Li te pran plezi nan mwen.<verse eid="PSA 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>SENYÈ a te byen <note caller="+" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="1SA 24:19">I Sam 24:19</ref></char></note>rekonpanse mwen selon ladwati mwen.</para>
  <para style="q1" vid="PSA 18:20">Selon men m ki pwòp, Li fè m rekonpans.<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>Paske mwen te kenbe chemen SENYÈ a,</para>
  <para style="q1" vid="PSA 18:21">epi mwen pa t janm kite Bondye mwen an.<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>Paske tout <note caller="+" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="PSA 119:30">Sòm 119:30</ref></char></note>òdonans Li yo te devan m.</para>
  <para style="q1" vid="PSA 18:22">Mwen pa t janm mete règleman Li yo akote.<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>Anplis, mwen te toujou san fot devan L,</para>
  <para style="q1" vid="PSA 18:23">e mwen te <note caller="+" style="x"><char style="xo" closed="false">18:23 </char><char style="xt" closed="false"><ref loc="PSA 19:12">Sòm 19:12</ref>,<ref loc="PSA 19:13">13</ref></char></note>rete lib de inikite m.<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>Pou sa, SENYÈ a te <note caller="+" style="x"><char style="xo" closed="false">18:24 </char><char style="xt" closed="false"><ref loc="1SA 26:23">I Sam 26:23</ref></char></note>fè m rekonpans selon ladwati mwen,</para>
  <para style="q1" vid="PSA 18:24">selon men pwòp ke Li te wè yo.<verse eid="PSA 18:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>Avèk sila ki gen bon kè, Ou montre kè ki bon.</para>
  <para style="q1" vid="PSA 18:25">Avèk sila ki san fot, Ou vin parèt san fot.<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>Avèk sila ki san tach, Ou montre li san tach Ou. <note caller="+" style="x"><char style="xo" closed="false">18:26 </char><char style="xt" closed="false"><ref loc="JOB 25:5">Job 25:5</ref></char></note></para>
  <para style="q1" vid="PSA 18:26">Epi avèk sila ki kwochi a, Ou parèt koken.<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>Paske Ou sove yon pèp aflije,</para>
  <para style="q1" vid="PSA 18:27">men sila ak zye ki leve wo yo, Ou bese yo.<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>Paske SENYÈ a va lime lanp mwen.</para>
  <para style="q1" vid="PSA 18:28">Se Bondye mwen an ki klere tenèb mwen.<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>Paske avèk Ou, mwen kapab <note caller="+" style="x"><char style="xo" closed="false">18:29 </char><char style="xt" closed="false"><ref loc="PSA 18:33">Sòm 18:33</ref></char></note>kouri sou yon ekip lame.</para>
  <para style="q1" vid="PSA 18:29">Avèk Bondye mwen, mwen kab vòltije sou yon mi.<verse eid="PSA 18:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>Pou Bondye, chemen Li <note caller="+" style="x"><char style="xo" closed="false">18:30 </char><char style="xt" closed="false"><ref loc="REV 15:3">Rev 15:3</ref></char></note>san fot.</para>
  <para style="q1" vid="PSA 18:30">Pawòl SENYÈ a pase a leprèv.</para>
  <para style="q1" vid="PSA 18:30">Li se yon boukliye pou tout moun</para>
  <para style="q1" vid="PSA 18:30">k ap pran sekou nan Li.<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>Paske <note caller="+" style="x"><char style="xo" closed="false">18:31 </char><char style="xt" closed="false"><ref loc="PSA 86:8-10">Sòm 86:8-10</ref></char></note>se kilès ke Bondye ye, sof ke SENYÈ a?</para>
  <para style="q1" vid="PSA 18:31">Epi se kilès ki wòch la, sof ke Bondye nou an.<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>Bondye ki <note caller="+" style="x"><char style="xo" closed="false">18:32 </char><char style="xt" closed="false"><ref loc="ISA 45:5">És 45:5</ref></char></note>mare senti m ak fòs,</para>
  <para style="q1" vid="PSA 18:32">epi fè chemen mwen san fot la?<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>Li fè pye m yo vin tankou sèf,</para>
  <para style="q1" vid="PSA 18:33">epi <note caller="+" style="x"><char style="xo" closed="false">18:33 </char><char style="xt" closed="false"><ref loc="DEU 32:13">Det 32:13</ref> </char></note>fè m vin plase kote ki wo yo.<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>Li antrene men m pou batay la,</para>
  <para style="q1" vid="PSA 18:34">jiskaske men m ka koube banza ki fèt an bwonz.<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>Anplis, Ou te ban mwen</para>
  <para style="q1" vid="PSA 18:35">
    <note caller="+" style="x">
      <char style="xo" closed="false">18:35 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:20">Sòm 33:20</ref>
      </char>
    </note>boukliye sali Ou e</para>
  <para style="q1" vid="PSA 18:35">men dwat Ou te ban soutyen.</para>
  <para style="q1" vid="PSA 18:35">Se bonte Ou ki fè m gran.<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>Ou <note caller="+" style="x"><char style="xo" closed="false">18:36 </char><char style="xt" closed="false"><ref loc="PSA 18:33">Sòm 18:33</ref></char></note>fè longè pa m yo lonje pi laj anba m,</para>
  <para style="q1" vid="PSA 18:36">epi pye m pa t janm chape.<verse eid="PSA 18:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">18:37 </char><char style="xt" closed="false"><ref loc="PSA 44:5">Sòm 44:5</ref></char></note>kouri dèyè lènmi m yo, e mwen te pran yo.</para>
  <para style="q1" vid="PSA 18:37">Mwen pa t fè bak jiskaske yo tout te fin manje nèt.<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>Mwen va frape yo jiskaske yo pa kab leve.</para>
  <para style="q1" vid="PSA 18:38">Yo va tonbe <note caller="+" style="x"><char style="xo" closed="false">18:38 </char><char style="xt" closed="false"><ref loc="PSA 47:3">Sòm 47:3</ref> </char></note>anba pye mwen.<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>Ou te mare senti m avèk fòs pou batay la.</para>
  <para style="q1" vid="PSA 18:39">Ou te <note caller="+" style="x"><char style="xo" closed="false">18:39 </char><char style="xt" closed="false"><ref loc="PSA 18:47">Sòm 18:47</ref></char></note>soumèt anba m sila ki te leve kont mwen yo.<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>Ou te, anplis, fè lènmi m yo vire do yo ban mwen;</para>
  <para style="q1" vid="PSA 18:40">konsa mwen te <note caller="+" style="x"><char style="xo" closed="false">18:40 </char><char style="xt" closed="false"><ref loc="PSA 94:23">Sòm 94:23</ref></char></note>detwi sila ki te rayi mwen yo.<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>Yo te kriye sekou, men <note caller="+" style="x"><char style="xo" closed="false">18:41 </char><char style="xt" closed="false"><ref loc="PSA 50:22">Sòm 50:22</ref></char></note>pa t gen moun pou sove yo;</para>
  <para style="q1" vid="PSA 18:41">menm a SENYÈ a, men Li pa t reponn yo.<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>Mwen te bat yo kraze fen tankou <note caller="+" style="x"><char style="xo" closed="false">18:42 </char><char style="xt" closed="false"><ref loc="PSA 83:13">Sòm 83:13</ref></char></note>pousyè devan van;</para>
  <para style="q1" vid="PSA 18:42">mwen te vide jete yo tankou labou nan lari.<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>Ou te delivre mwen devan yon pèp plen ak konfli;</para>
  <para style="q1" vid="PSA 18:43">Ou te plase mwen kon <note caller="+" style="x"><char style="xo" closed="false">18:43 </char><char style="xt" closed="false"><ref loc="2SA 8:1-18">II Sam 8:1-18</ref></char></note>chèf an tèt a nasyon yo;</para>
  <para style="q1" vid="PSA 18:43">Yon pèp ke m pa menm konnen,</para>
  <para style="q1" vid="PSA 18:43">se sèvitè mwen yo ye.<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>Depi yo tande, yo obeyi mwen.</para>
  <para style="q1" vid="PSA 18:44">Etranje yo <note caller="+" style="x"><char style="xo" closed="false">18:44 </char><char style="xt" closed="false"><ref loc="PSA 66:3">Sòm 66:3</ref></char></note>soumèt devan m.<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>Etranje yo vin disparèt devan m,</para>
  <para style="q1" vid="PSA 18:45">epi vin sòti tranblan nan fò yo.<verse eid="PSA 18:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">18:46 </char><char style="xt" closed="false"><ref loc="JOB 19:25">Job 19:25</ref></char></note>viv! Beni se wòch mwen an.</para>
  <para style="q1" vid="PSA 18:46">Leve byen wo, se Bondye a sali mwen an.<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>Bondye ki egzekite vanjans pou mwen an,</para>
  <para style="q1" vid="PSA 18:47">e ki fè pèp yo soumèt anba m nan.<verse eid="PSA 18:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48"/>Se Li menm ki delivre m de lènmi mwen yo.</para>
  <para style="q1" vid="PSA 18:48">Anverite, Ou leve m pi wo de sila ki</para>
  <para style="q1" vid="PSA 18:48">fè rebèl kont mwen yo.</para>
  <para style="q1" vid="PSA 18:48">Ou delivre mwen kont men lòm <note caller="+" style="x"><char style="xo" closed="false">18:48 </char><char style="xt" closed="false"><ref loc="PSA 11:5">Sòm 11:5</ref></char></note>vyolans lan.<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>Pou sa, mwen va <note caller="+" style="x"><char style="xo" closed="false">18:49 </char><char style="xt" closed="false"><ref loc="ROM 15:9">Wo 15:9</ref></char></note>bay remèsiman</para>
  <para style="q1" vid="PSA 18:49">a Ou menm pami nasyon yo, O SENYÈ,</para>
  <para style="q1" vid="PSA 18:49">epi mwen va chante lwanj a non Ou.<verse eid="PSA 18:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>Li bay gran delivrans a wa Li a,</para>
  <para style="q1" vid="PSA 18:50">epi montre lanmou dous Li a <note caller="+" style="x"><char style="xo" closed="false">18:50 </char><char style="xt" closed="false"><ref loc="PSA 28:8">Sòm 28:8</ref></char></note>onksyone Li a,</para>
  <para style="q1" vid="PSA 18:50">a David avèk desandan li yo jis pou tout tan.<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="d">Pou direktè koral la; yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 8:1">Sòm 8:1</ref>
      </char>
    </note>Syèl yo ap pale glwa Bondye a.</para>
  <para style="q1" vid="PSA 19:1">Jan yo tèlman gran deklare zèv men Li yo.<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>Jou apre jou, l ap pale san rete;</para>
  <para style="q1" vid="PSA 19:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">19:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 139:12">Sòm 139:12</ref>
      </char>
    </note>Nwit apre nwit, li revele konesans.<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>Nanpwen langaj, ni pa gen pawòl</para>
  <para style="q1" vid="PSA 19:3">kote nou pa tande vwa yo.<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:4 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 10:18">Wo 10:18</ref>
      </char>
    </note> Sepandan, eko yo retanti sou tout latè,</para>
  <para style="q1" vid="PSA 19:4">ak sa yo pale jis nan ekstremite latè a.</para>
  <para style="q1" vid="PSA 19:4">Nan mitan yo, Li te plase yon tant pou solèy la,<verse eid="PSA 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5"/>ki tankou yon jennonm ki fenk marye</para>
  <para style="q1" vid="PSA 19:5">k ap sòti nan chanm li.</para>
  <para style="q1" vid="PSA 19:5">Li rejwi kon yon nonm fò k ap fè kous.<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>Li <note caller="+" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="PSA 113:3">Sòm 113:3</ref></char></note>leve soti nan yon pwent syèl,</para>
  <para style="q1" vid="PSA 19:6">pou fè wonn li rive jis nan lòt pwent lan.</para>
  <para style="q1" vid="PSA 19:6">Anyen pa chape devan chalè li.<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>Lalwa SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="PSA 119:160">Sòm 119:160</ref></char></note>pafè</para>
  <para style="q1" vid="PSA 19:7">Li rekonfòte nanm.</para>
  <para style="q1" vid="PSA 19:7">Temwayaj SENYÈ a vrè,</para>
  <para style="q1" vid="PSA 19:7">k ap fè saj yo senp.<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>Prensip a SENYÈ yo dwat,</para>
  <para style="q1" vid="PSA 19:8">ki fè kè rejwi.</para>
  <para style="q1" vid="PSA 19:8">Kòmandman SENYÈ a san tach.</para>
  <para style="q1" vid="PSA 19:8">Li <note caller="+" style="x"><char style="xo" closed="false">19:8 </char><char style="xt" closed="false"><ref loc="PSA 36:9">Sòm 36:9</ref> </char></note>fè zye yo limen.<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>Lakrent SENYÈ a pi;</para>
  <para style="q1" vid="PSA 19:9">Li dire jis pou tout tan.</para>
  <para style="q1" vid="PSA 19:9">Jijman yo SENYÈ a vrè;</para>
  <para style="q1" vid="PSA 19:9">Yo <note caller="+" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="PSA 119:138">Sòm 119:138</ref> </char></note>jis san manke.<verse eid="PSA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>Yo <note caller="+" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="PSA 119:72">Sòm 119:72</ref></char></note>pi chè pase lò, wi, pase anpil lò fen.</para>
  <para style="q1" vid="PSA 19:10">Yo pi dous pase myèl, pase siwo a</para>
  <para style="q1" vid="PSA 19:10">ki tonbe nan gato myèl la.<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>Anplis, se pa yo menm ke sèvitè Ou a</para>
  <para style="q1" vid="PSA 19:11">resevwa avètisman pou fè atansyon.</para>
  <para style="q1" vid="PSA 19:11">Pou sila ki kenbe yo, gen gran <note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="PSA 24:5-6">Sòm 24:5-6</ref></char></note>rekonpans.<verse eid="PSA 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>Se kilès ki kab rekonèt fot li?</para>
  <para style="q1" vid="PSA 19:12">Padone mwen <note caller="+" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="PSA 139:23-24">Sòm 139:23-24</ref></char></note>pou fot ke m pa konnen yo.<verse eid="PSA 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>Anplis, pwoteje sèvitè ou a kont peche ògèy yo.</para>
  <para style="q1" vid="PSA 19:13">Pa kite yo vin domine m.</para>
  <para style="q1" vid="PSA 19:13">Konsa, mwen kab rete san fot,</para>
  <para style="q1" vid="PSA 19:13">epi va inosan a gran peche.<verse eid="PSA 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>Kite pawòl bouch mwen a avèk</para>
  <para style="q1" vid="PSA 19:14">
    <note caller="+" style="x">
      <char style="xo" closed="false">19:14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:34">Sòm 104:34</ref>
      </char>
    </note>refleksyon kè m</para>
  <para style="q1" vid="PSA 19:14">vin akseptab devan zye Ou,</para>
  <para style="q1" vid="PSA 19:14">O SENYÈ, wòch mwen, ak sovè mwen an.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="d">Pou direktè koral la; Yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>Ke SENYÈ a kapab reponn ou <note caller="+" style="x"><char style="xo" closed="false">20:1 </char><char style="xt" closed="false"><ref loc="PSA 50:15">Sòm 50:15</ref></char></note>nan jou gran twoub la!</para>
  <para style="q1" vid="PSA 20:1">Ke non Bondye Jacob la kapab</para>
  <para style="q1" vid="PSA 20:1">kenbe ou ansekirite an wo!<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>Ke Li kapab voye bay ou èd soti nan</para>
  <para style="q1" vid="PSA 20:2">sanktiyè a,</para>
  <para style="q1" vid="PSA 20:2">epi <note caller="+" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="PSA 110:2">Sòm 110:2</ref> </char></note>bay ou soutyen soti nan Sion.<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>Ke Li kapab <note caller="+" style="x"><char style="xo" closed="false">20:3 </char><char style="xt" closed="false"><ref loc="ACT 10:4">Trav 10:4</ref></char></note>sonje tout ofrann sereyal ou yo,</para>
  <para style="q1" vid="PSA 20:3">ke Li twouve tout ofrann brile ou yo byen akseptab!<verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>Ke Li kapab bay ou dezi a kè ou,</para>
  <para style="q1" vid="PSA 20:4">e <note caller="+" style="x"><char style="xo" closed="false">20:4 </char><char style="xt" closed="false"><ref loc="PSA 145:19">Sòm 145:19</ref> </char></note>akonpli tout plan ou yo!<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>Nou va chante avèk jwa akoz viktwa ou.</para>
  <para style="q1" vid="PSA 20:5">Nan non Bondye nou an, nou va monte drapo nou yo.</para>
  <para style="q1" vid="PSA 20:5">Ke SENYÈ a kapab <note caller="+" style="x"><char style="xo" closed="false">20:5 </char><char style="xt" closed="false"><ref loc="1SA 1:17">I Sam 1:17</ref></char></note>akonpli tout priyè ou yo.<verse eid="PSA 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>Alò, mwen konnen ke SENYÈ a</para>
  <para style="q1" vid="PSA 20:6">va delivre moun onksyone pa Li a.</para>
  <para style="q1" vid="PSA 20:6">Li va <note caller="+" style="x"><char style="xo" closed="false">20:6 </char><char style="xt" closed="false"><ref loc="ISA 58:9">És 58:9</ref></char></note>reponn li soti nan syèl sen Li an,</para>
  <para style="q1" vid="PSA 20:6">avèk delivrans pwisan men dwat Li a.<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>Genyen kèk ki fè konfyans nan cha yo, e kèk nan cheval yo,</para>
  <para style="q1" vid="PSA 20:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">20:7 </char>
      <char style="xt" closed="false">
        <ref loc="2CH 32:8">II Kwo 32:8</ref>
      </char>
    </note>Men nou va fè konfyans nan non SENYÈ a, Bondye nou an.<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>Yo te pliye e yo te tonbe,</para>
  <para style="q1" vid="PSA 20:8">men <note caller="+" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="PSA 37:24">Sòm 37:24</ref></char></note>nou te leve e nou te kanpe dwat.<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>Delivre nou O SENYÈ!</para>
  <para style="q1" vid="PSA 20:9">Ke <note caller="+" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="PSA 3:7">Sòm 3:7</ref></char></note>Wa a kapab reponn nou nan jou ke nou rele Non Li an.<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="d">Pou direktè koral la; Yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">21:1 </char><char style="xt" closed="false"><ref loc="PSA 59:16-17">Sòm 59:16-17</ref></char></note>nan fòs Ou, Wa a va fè kè kontan.</para>
  <para style="q1" vid="PSA 21:1">Nan delivrans Ou, ki gran rejwisans li va gen!<verse eid="PSA 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>Ou te bay li dezi a kè li,</para>
  <para style="q1" vid="PSA 21:2">ni Ou pa t refize demand a lèv li yo.<verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>Paske Ou te vin rankontre Li avèk</para>
  <para style="q1" vid="PSA 21:3">benediksyon de tout bon bagay.</para>
  <para style="q1" vid="PSA 21:3">Ou te mete yon <note caller="+" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="2SA 12:30">II Sam 12:30</ref> </char></note>kouwòn sou tèt li.<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>Li te mande Ou lavi e Ou te bay li.</para>
  <para style="q1" vid="PSA 21:4">Yon vi ki long ak <note caller="+" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="PSA 91:16">Sòm 91:16</ref></char></note>jou k ap dire</para>
  <para style="q1" vid="PSA 21:4">jis pou tout tan.<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>Glwa li gran nan sali pa Ou.</para>
  <para style="q1" vid="PSA 21:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">21:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:6">Sòm 96:6</ref> </char>
    </note>Onè ak majeste Ou te mete sou li.<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>Paske Ou te fè li beni pase tout moun, jis pou tout tan;</para>
  <para style="q1" vid="PSA 21:6">Ou te fè li plen ak lajwa <note caller="+" style="x"><char style="xo" closed="false">21:6 </char><char style="xt" closed="false"><ref loc="PSA 43:4">Sòm 43:4</ref></char></note>avèk kè kontan nan prezans Ou.<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>Paske wa a mete konfyans li nan SENYÈ a.</para>
  <para style="q1" vid="PSA 21:7">Epi akoz lanmou dous a Pi Wo a,</para>
  <para style="q1" vid="PSA 21:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">21:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 112:6">Sòm 112:6</ref>
      </char>
    </note>Li p ap ebranle menm.<verse eid="PSA 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>Men ou va <note caller="+" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="ISA 10:10">És 10:10</ref></char></note>dekouvri tout lènmi ou yo.</para>
  <para style="q1" vid="PSA 21:8">Men dwat ou va jwenn sila ki rayi ou yo.<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>Ou va fè yo tankou yon founo k ap brile nan tan kòlè ou.</para>
  <para style="q1" vid="PSA 21:9">SENYÈ a va <note caller="+" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="LAM 2:2">Lam 2:2</ref></char></note>vale yo nèt nan kòlè Li,</para>
  <para style="q1" vid="PSA 21:9">epi dife va devore yo.<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>Ou va detwi posterite pa yo soti sou latè,</para>
  <para style="q1" vid="PSA 21:10">epi <note caller="+" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="PSA 37:28">Sòm 37:28</ref></char></note>desandan yo ap disparèt pami fis a lòm yo.<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>Malgre yo te anvizaje mal kont Ou,</para>
  <para style="q1" vid="PSA 21:11">e te <note caller="+" style="x"><char style="xo" closed="false">21:11 </char><char style="xt" closed="false"><ref loc="PSA 10:2">Sòm 10:2</ref></char></note>fòme yon konplo,</para>
  <para style="q1" vid="PSA 21:11">yo p ap reyisi.<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>Paske Ou va fè yo vire do yo.</para>
  <para style="q1" vid="PSA 21:12">Ou va pwente <note caller="+" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="PSA 7:12-13">Sòm 7:12-13</ref></char></note>banza sou figi yo</para>
  <para style="q1" vid="PSA 21:12">ak bon kontwòl.<verse eid="PSA 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>Ke Ou leve wo, O SENYÈ,</para>
  <para style="q1" vid="PSA 21:13">ak tout fòs Ou!</para>
  <para style="q1" vid="PSA 21:13">Nou va <note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="PSA 59:16">Sòm 59:16</ref></char></note>chante e bay lwanj a pwisans Ou.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="d">Pou direktè koral la, avèk mizik bich granmaten an;</para>
  <para style="d">Yon sòm David.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:46">Mat 27:46</ref>
      </char>
    </note>Bondye mwen, Bondye mwen, poukisa Ou</para>
  <para style="q1" vid="PSA 22:1">te abandone m?</para>
  <para style="q1" vid="PSA 22:1">Kri a doulè sa a lwen delivrans mwen.<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>O Bondye mwen, mwen <note caller="+" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="PSA 42:3">Sòm 42:3</ref></char></note>kriye pandan lajounen, men Ou pa reponn.</para>
  <para style="q1" vid="PSA 22:2">E nan lannwit men m pa jwenn repo.<verse eid="PSA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>Sepandan, Ou sen;</para>
  <para style="q1" vid="PSA 22:3">Ou menm ki <note caller="+" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="DEU 10:21">Det 10:21</ref></char></note>sou twòn lwanj pèp Israël la.<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>Nan Ou menm, zansèt nou yo te mete konfyans yo.</para>
  <para style="q1" vid="PSA 22:4">Yo te mete konfyans yo nan Ou,</para>
  <para style="q1" vid="PSA 22:4">e Ou te <note caller="+" style="x"><char style="xo" closed="false">22:4 </char><char style="xt" closed="false"><ref loc="PSA 107:6">Sòm 107:6</ref></char></note>delivre yo.<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>A Ou menm, yo te kriye, e yo te delivre.</para>
  <para style="q1" vid="PSA 22:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">22:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:23">És 49:23</ref>
      </char>
    </note>Nan Ou, yo te mete konfyans yo, epi pa t desi.<verse eid="PSA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>Men mwen se yon <note caller="+" style="x"><char style="xo" closed="false">22:6 </char><char style="xt" closed="false"><ref loc="JOB 25:6">Job 25:6</ref></char></note>vè,</para>
  <para style="q1" vid="PSA 22:6">mwen pa menm yon moun.</para>
  <para style="q1" vid="PSA 22:6">Parèt abominab devan lèzòm,</para>
  <para style="q1" vid="PSA 22:6">e meprize pa tout moun.<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>Tout moun ki wè m vin moke mwen.</para>
  <para style="q1" vid="PSA 22:7">Yo <note caller="+" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="MAT 27:39">Mat 27:39</ref></char></note>separe avèk lèv yo e yo</para>
  <para style="q1" vid="PSA 22:7">souke tèt yo pou di:<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>Li mete konfyans nan SENYÈ a.</para>
  <para style="q1" vid="PSA 22:8">Kite Li menm delivre li.</para>
  <para style="q1" vid="PSA 22:8">Kite Li sove li, paske Li pran plezi nan li.<verse eid="PSA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>Sepandan, Ou menm se Sila ki te</para>
  <para style="q1" vid="PSA 22:9">fè m sòti nan vant manman m nan.</para>
  <para style="q1" vid="PSA 22:9">Ou te fè m gen konfyans depi m</para>
  <para style="q1" vid="PSA 22:9">t ap souse tete manman m.<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>Sou Ou, mwen te depann <note caller="+" style="x"><char style="xo" closed="false">22:10 </char><char style="xt" closed="false"><ref loc="ISA 46:3">És 46:3</ref></char></note>depi nesans mwen.</para>
  <para style="q1" vid="PSA 22:10">Ou te Bondye mwen depi nan vant manman m.<verse eid="PSA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:12">Sòm 71:12</ref>
      </char>
    </note>Pa rete lwen mwen, paske gwo twoub la toupre.</para>
  <para style="q1" vid="PSA 22:11">Paske nanpwen moun ki pou ede m.<verse eid="PSA 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>Anpil towo vin antoure m.</para>
  <para style="q1" vid="PSA 22:12">Towo fò a <note caller="+" style="x"><char style="xo" closed="false">22:12 </char><char style="xt" closed="false"><ref loc="DEU 32:14">Det 32:14</ref></char></note>Basan yo te ansèkle m.<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>Yo ouvri bouch yo byen laj sou mwen,</para>
  <para style="q1" vid="PSA 22:13">tankou yon <note caller="+" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="PSA 10:9">Sòm 10:9</ref></char></note>lyon voras k ap rele fò.<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>Mwen vin vide tankou dlo.</para>
  <para style="q1" vid="PSA 22:14">Tout zo m fin dejwente.<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>Fòs mwen vin sèch tankou cha kanari.</para>
  <para style="q1" vid="PSA 22:15">Lang mwen kole akote nan bouch mwen.</para>
  <para style="q1" vid="PSA 22:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">22:15 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:28">Jn 19:28</ref>
      </char>
    </note>Ou fè m kouche nan pousyè lanmò a.<verse eid="PSA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>Konsa, chen yo vin antoure mwen.</para>
  <para style="q1" vid="PSA 22:16">Yon bann malfektè vin ansèkle m.</para>
  <para style="q1" vid="PSA 22:16">Yo te <note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="MAT 27:35">Mat 27:35</ref></char></note>pèse dwat mwen avèk pye m.<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>Mwen kab kontwole tout zo m yo.</para>
  <para style="q1" vid="PSA 22:17">Yo <note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="LUK 23:27-35">Luc 23:27-35</ref></char></note>gade mwen, yo fikse zye yo sou mwen.<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>Yo <note caller="+" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="MAT 27:35">Mat 27:35</ref></char></note>divize rad mwen pami yo.</para>
  <para style="q1" vid="PSA 22:18">Pou vètman m, yo tire osò.<verse eid="PSA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>Men Ou menm, O SENYÈ, pa rete lwen!</para>
  <para style="q1" vid="PSA 22:19">Ou menm, sekou mwen, <note caller="+" style="x"><char style="xo" closed="false">22:19 </char><char style="xt" closed="false"><ref loc="PSA 70:5">Sòm 70:5</ref></char></note>fè vit, vin rive ede m!<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>Delivre nanm mwen devan <note caller="+" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="PSA 37:14">Sòm 37:14</ref></char></note>nepe a,</para>
  <para style="q1" vid="PSA 22:20">lavi mwen devan pouvwa a chen an.<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>Fè m sekou soti nan bouch a <note caller="+" style="x"><char style="xo" closed="false">22:21 </char><char style="xt" closed="false"><ref loc="PSA 22:13">Sòm 22:13</ref></char></note>lyon an,</para>
  <para style="q1" vid="PSA 22:21">soti sou kòn a bèf mawon.</para>
  <para style="q1" vid="PSA 22:21">Wi, Ou menm te reponn mwen.<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="PSA 40:10">Sòm 40:10</ref></char></note>pale non Ou a frè m yo.</para>
  <para style="q1" vid="PSA 22:22">Nan mitan asanble a, mwen va louwe Ou.<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:23 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:19-20">Sòm 135:19-20</ref>
      </char>
    </note>Ou menm ki krent SENYÈ a, louwe Li.</para>
  <para style="q1" vid="PSA 22:23">Nou tout, desandan Jacob yo, bay Li glwa!</para>
  <para style="q1" vid="PSA 22:23">Kanpe byen sezi devan L,</para>
  <para style="q1" vid="PSA 22:23">nou tout, desandan Israël yo.<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>Paske Li pa t meprize ni</para>
  <para style="q1" vid="PSA 22:24">rayi afliksyon a aflije yo.</para>
  <para style="q1" vid="PSA 22:24">Ni Li pa t kache figi Li a li menm,</para>
  <para style="q1" vid="PSA 22:24">men <note caller="+" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="PSA 31:22">Sòm 31:22</ref></char></note>lè li te kriye a Li pou sekou, Li te tande.<verse eid="PSA 22:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>Se depi a Ou menm ke lwanj mwen sòti</para>
  <para style="q1" vid="PSA 22:25">nan gran asanble a;</para>
  <para style="q1" vid="PSA 22:25">Mwen va <note caller="+" style="x"><char style="xo" closed="false">22:25 </char><char style="xt" closed="false"><ref loc="PSA 61:8">Sòm 61:8</ref></char></note>akonpli ve mwen yo devan sila ki krent Li yo.<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>Aflije yo va manje e <note caller="+" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="PSA 107:9">Sòm 107:9</ref></char></note>va satisfè.</para>
  <para style="q1" vid="PSA 22:26">Sila ki chache Li yo, va louwe SENYÈ a.</para>
  <para style="q1" vid="PSA 22:26">Ke kè Ou kapab viv jis pou tout tan!<verse eid="PSA 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>Tout <note caller="+" style="x"><char style="xo" closed="false">22:27 </char><char style="xt" closed="false"><ref loc="PSA 2:8">Sòm 2:8</ref></char></note>ekstremite tè a nèt va sonje.</para>
  <para style="q1" vid="PSA 22:27">Yo va vire bò kote SENYÈ a.</para>
  <para style="q1" vid="PSA 22:27">Konsa, tout fanmi nan nasyon yo va</para>
  <para style="q1" vid="PSA 22:27">adore devan Ou.<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>Paske <note caller="+" style="x"><char style="xo" closed="false">22:28 </char><char style="xt" closed="false"><ref loc="ZEC 14:9">Za 14:9</ref></char></note>wayòm nan se pou SENYÈ a,</para>
  <para style="q1" vid="PSA 22:28">e pouvwa Li se sou tout nasyon yo.<verse eid="PSA 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>Tout moun <note caller="+" style="x"><char style="xo" closed="false">22:29 </char><char style="xt" closed="false"><ref loc="HAB 1:16">Hab 1:16</ref></char></note> byen reyisi sou latè va manje e adore.</para>
  <para style="q1" vid="PSA 22:29">Tout sila ki desann nan pousyè a va bese devan Li,</para>
  <para style="q1" vid="PSA 22:29">Menm sila ki pa kab fè nanm li viv la.<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>Jenerasyon yo va sèvi Li.</para>
  <para style="q1" vid="PSA 22:30">Yo va pale de SENYÈ a</para>
  <para style="q1" vid="PSA 22:30">a <note caller="+" style="x"><char style="xo" closed="false">22:30 </char><char style="xt" closed="false"><ref loc="PSA 102:18">Sòm 102:18</ref></char></note>desandan yo k ap vini an.<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>Yo va vini.</para>
  <para style="q1" vid="PSA 22:31">Yo va deklare ladwati Li</para>
  <para style="q1" vid="PSA 22:31">a yon pèp ki <note caller="+" style="x"><char style="xo" closed="false">22:31 </char><char style="xt" closed="false"><ref loc="PSA 78:6">Sòm 78:6</ref></char></note>va vin fèt.</para>
  <para style="q1" vid="PSA 22:31">Paske Li te reyisi fè tout bagay sa a.<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="d">Yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>Bondye se <note caller="+" style="x"><char style="xo" closed="false">23:1 </char><char style="xt" closed="false"><ref loc="EZK 34:11-13">Éz 34:11-13</ref></char></note>bèje mwen;</para>
  <para style="q1" vid="PSA 23:1">mwen p ap janm manke anyen.<verse eid="PSA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2"/>Li fè m kouche nan patiraj vèt yo.</para>
  <para style="q1" vid="PSA 23:2">Li <note caller="+" style="x"><char style="xo" closed="false">23:2 </char><char style="xt" closed="false"><ref loc="REV 7:17">Rev 7:17</ref></char></note>mennen m akote dlo pezib yo.<verse eid="PSA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3"/>Li restore nanm mwen.</para>
  <para style="q1" vid="PSA 23:3">Li gide mwen nan <note caller="+" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="PRO 4:11">Pwov 4:11</ref> </char></note>chemen ladwati yo,</para>
  <para style="q1" vid="PSA 23:3">akoz non sen Li an.<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>Malgre mwen ta mache nan vale</para>
  <para style="q1" vid="PSA 23:4">lonbraj lanmò a,</para>
  <para style="q1" vid="PSA 23:4">mwen p ap pè okenn mal, paske Ou avè m.</para>
  <para style="q1" vid="PSA 23:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">23:4 </char>
      <char style="xt" closed="false">
        <ref loc="MIC 7:14">Mi 7:14</ref> </char>
    </note>Baton Ou avèk kwòk Ou fè m gen konfyans.<verse eid="PSA 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>Ou ranje yon tab devan mwen</para>
  <para style="q1" vid="PSA 23:5">nan prezans lènmi mwen yo.</para>
  <para style="q1" vid="PSA 23:5">Ou onksyone tèt mwen avèk lwil.</para>
  <para style="q1" vid="PSA 23:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">23:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:5">Sòm 16:5</ref> </char>
    </note>Tas mwen fin debòde nèt.<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>Anverite, bonte Ou avèk lanmou dous Ou</para>
  <para style="q1" vid="PSA 23:6">va swiv mwen pou tout jou lavi mwen yo,</para>
  <para style="q1" vid="PSA 23:6">E mwen va <note caller="+" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="PSA 27:4-6">Sòm 27:4-6</ref></char></note>viv lakay</para>
  <para style="q1" vid="PSA 23:6">SENYÈ a jis pou tout tan.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="d">Yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>Tè a se pou SENYÈ a, avèk <note caller="+" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="1CO 10:26">I Kor 10:26</ref></char></note>tout sa ki ladann;</para>
  <para style="q1" vid="PSA 24:1">lemonn avèk tout sila ki rete ladann yo.<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>Li te <note caller="+" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="PSA 104:3-5">Sòm 104:3-5</ref></char></note>fonde li sou lanmè yo,</para>
  <para style="q1" vid="PSA 24:2">e te etabli li sou rivyè yo.<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>Se kilès ki kab monte sou kolin SENYÈ a?</para>
  <para style="q1" vid="PSA 24:3">Epi kilès ki kab kanpe nan <note caller="+" style="x"><char style="xo" closed="false">24:3 </char><char style="xt" closed="false"><ref loc="PSA 65:4">Sòm 65:4</ref></char></note>lye sen pa Li an?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>Sila ki gen men pwòp avèk yon kè ki san tach,</para>
  <para style="q1" vid="PSA 24:4">ki pa <note caller="+" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="EZK 18:15">Éz 18:15</ref></char></note>leve nanm li vè sa ki fo,</para>
  <para style="q1" vid="PSA 24:4">ni ki pa fè fo temwayaj.<verse eid="PSA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>Li va resevwa yon benediksyon soti nan SENYÈ a,</para>
  <para style="q1" vid="PSA 24:5">ak <note caller="+" style="x"><char style="xo" closed="false">24:5 </char><char style="xt" closed="false"><ref loc="PSA 36:10">Sòm 36:10</ref></char></note>ladwati soti nan Bondye delivrans li an.<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>Sa se jenerasyon a sila k ap <note caller="+" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="PSA 27:4-8">Sòm 27:4-8</ref></char></note>chache Li yo,</para>
  <para style="q1" vid="PSA 24:6">ka p chache figi Ou—menm Jacob. <char style="qs">Tan</char><verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>Leve wo lento ou yo, o pòtay yo!</para>
  <para style="q1" vid="PSA 24:7">Leve wo, o pòt ansyen yo!</para>
  <para style="q1" vid="PSA 24:7">Pou Wa <note caller="+" style="x"><char style="xo" closed="false">24:7 </char><char style="xt" closed="false"><ref loc="ACT 7:2">Trav 7:2</ref></char></note>glwa la kapab antre!<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>Se kilès ki Wa a glwa a?</para>
  <para style="q1" vid="PSA 24:8">SENYÈ fò e pwisan an,</para>
  <para style="q1" vid="PSA 24:8">SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="PSA 76:3-6">Sòm 76:3-6</ref></char></note>pwisan nan batay la.<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>Leve wo lento ou yo, O Pòtay yo!</para>
  <para style="q1" vid="PSA 24:9">Leve wo, O pòt ansyen yo!</para>
  <para style="q1" vid="PSA 24:9">Pou Wa <note caller="+" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="PSA 26:8">Sòm 26:8</ref></char></note>glwa la kapab antre!<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>Se kilès ki Wa glwa a?</para>
  <para style="q1" vid="PSA 24:10">SENYÈ dèzame <note caller="+" style="x"><char style="xo" closed="false">24:10 </char><char style="xt" closed="false"><ref loc="2SA 5:10">II Sam 5:10</ref></char></note> yo!</para>
  <para style="q1" vid="PSA 24:10">Se Li menm ki Wa glwa a. <char style="qs">Tan.</char><verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="d">Yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>A Ou menm, O SENYÈ, mwen <note caller="+" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="2SA 5:10">II Sam 5:10</ref></char></note>leve nanm mwen.<verse eid="PSA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>O Bondye mwen, nan Ou, mwen mete konfyans mwen.</para>
  <para style="q1" vid="PSA 25:2">Pa kite mwen vin wont;</para>
  <para style="q1" vid="PSA 25:2">pa kite <note caller="+" style="x"><char style="xo" closed="false">25:2 </char><char style="xt" closed="false"><ref loc="PSA 13:4">Sòm 13:4</ref></char></note>lènmi m yo fè fèt sou mwen.<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>Anverite, nanpwen nan sila ki tann Ou yo ki va wont;</para>
  <para style="q1" vid="PSA 25:3">sila ki <note caller="+" style="x"><char style="xo" closed="false">25:3 </char><char style="xt" closed="false"><ref loc="HAB 1:13">Hab 1:13</ref></char></note>fè konplo kont Ou san koz yo, va wont.<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:4 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 33:13">Egz 33:13</ref>
      </char>
    </note>Fè m konnen pa Ou yo, O SENYÈ;</para>
  <para style="q1" vid="PSA 25:4">enstwi m nan chemen Ou yo.<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>Mennen mwen nan verite Ou e enstwi mwen,</para>
  <para style="q1" vid="PSA 25:5">Paske se Ou menm ki <note caller="+" style="x"><char style="xo" closed="false">25:5 </char><char style="xt" closed="false"><ref loc="PSA 79:9">Sòm 79:9</ref></char></note>Bondye delivrans mwen;</para>
  <para style="q1" vid="PSA 25:5">se Ou m ap tann tout lajounen.<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>Sonje, O SENYÈ, mizerikòd Ou ak lanmou dous Ou a,</para>
  <para style="q1" vid="PSA 25:6">Paske se yo ki la <note caller="+" style="x"><char style="xo" closed="false">25:6 </char><char style="xt" closed="false"><ref loc="PSA 103:17">Sòm 103:17</ref></char></note>depi tan ale nèt.<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>Pa sonje <note caller="+" style="x"><char style="xo" closed="false">25:7 </char><char style="xt" closed="false"><ref loc="JOB 13:26">Job 13:26</ref></char></note>peche jenès mwen yo, ni transgresyon mwen yo.</para>
  <para style="q1" vid="PSA 25:7">Selon lanmou dous Ou, sonje mwen,</para>
  <para style="q1" vid="PSA 25:7">Pou koz a bonte Ou, O SENYÈ.<verse eid="PSA 25:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>Bon e plen ladwati, se SENYÈ a;</para>
  <para style="q1" vid="PSA 25:8">pou sa, Li enstwi pechè yo nan chemen an.<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>Li <note caller="+" style="x"><char style="xo" closed="false">25:9 </char><char style="xt" closed="false"><ref loc="PSA 23:3">Sòm 23:3</ref></char></note>dirije enb yo nan jistis, e</para>
  <para style="q1" vid="PSA 25:9">Li va enstwi enb yo nan chemen Li.<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>Tout chemen Bondye se nan</para>
  <para style="q1" vid="PSA 25:10">lanmou dous avèk verite</para>
  <para style="q1" vid="PSA 25:10">pou <note caller="+" style="x"><char style="xo" closed="false">25:10 </char><char style="xt" closed="false"><ref loc="PSA 103:18">Sòm 103:18</ref></char></note>sila ki kenbe akò Li yo ak</para>
  <para style="q1" vid="PSA 25:10">temwayaj Li yo.<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>Pou koz a non Ou, O SENYÈ,</para>
  <para style="q1" vid="PSA 25:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">25:11 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 34:9">Egz 34:9</ref>
      </char>
    </note>padone inikite mwen, paske li anpil.<verse eid="PSA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>Kilès nonm nan ki gen krent SENYÈ a?</para>
  <para style="q1" vid="PSA 25:12">Li va <note caller="+" style="x"><char style="xo" closed="false">25:12 </char><char style="xt" closed="false"><ref loc="PSA 25:8">Sòm 25:8</ref> </char></note>enstwi li nan chemen li ta dwe chwazi a.<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>Nanm li va viv alèz.</para>
  <para style="q1" vid="PSA 25:13">Desandan li yo va resevwa eritaj peyi a.<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:14 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:32">Pwov 3:32</ref>
      </char>
    </note>Lamitye SENYÈ a se pou sila ki</para>
  <para style="q1" vid="PSA 25:14">gen lakrent Li yo.</para>
  <para style="q1" vid="PSA 25:14">Li va fè yo konnen akò Li.<verse eid="PSA 25:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>Zye m toujou vè SENYÈ a,</para>
  <para style="q1" vid="PSA 25:15">paske Li va <note caller="+" style="x"><char style="xo" closed="false">25:15 </char><char style="xt" closed="false"><ref loc="PSA 124:7">Sòm 124:7</ref> </char></note>retire pye mwen nan pèlen an.<verse eid="PSA 25:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:16 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:16">Sòm 69:16</ref>
      </char>
    </note>Vire vè mwen e fè m gras,</para>
  <para style="q1" vid="PSA 25:16">paske mwen abandone e aflije.<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>Twoub a kè m yo vin plis.</para>
  <para style="q1" vid="PSA 25:17">Mennen m sòti nan gwo detrès sa a.<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>Gade sou afliksyon mwen avèk twoub mwen yo,</para>
  <para style="q1" vid="PSA 25:18">e <note caller="+" style="x"><char style="xo" closed="false">25:18 </char><char style="xt" closed="false"><ref loc="PSA 103:3">Sòm 103:3</ref></char></note>padone tout peche mwen yo.<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>Gade sou tout lènmi mwen yo, paske yo anpil.</para>
  <para style="q1" vid="PSA 25:19">Epi yo <note caller="+" style="x"><char style="xo" closed="false">25:19 </char><char style="xt" closed="false"><ref loc="PSA 9:13">Sòm 9:13</ref></char></note>rayi mwen avèk yon rayisman ki vyolan.<verse eid="PSA 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>Gade nanm mwen e delivre mwen.</para>
  <para style="q1" vid="PSA 25:20">Pa kite m <note caller="+" style="x"><char style="xo" closed="false">25:20 </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sòm 25:2</ref></char></note>vin wont, paske mwen</para>
  <para style="q1" vid="PSA 25:20">pran refij nan Ou menm.<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>Kite <note caller="+" style="x"><char style="xo" closed="false">25:21 </char><char style="xt" closed="false"><ref loc="PSA 41:12">Sòm 41:12</ref></char></note>entegrite avèk ladwati pwoteje mwen,</para>
  <para style="q1" vid="PSA 25:21">paske se Ou m ap tann.<verse eid="PSA 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>Delivre Israël, O Bondye, sou</para>
  <para style="q1" vid="PSA 25:22">tout twoub li yo.<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="d">Yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>Fè m jistis, O SENYÈ, paske mwen te mache nan entegrite mwen.</para>
  <para style="q1" vid="PSA 26:1">Mwen te mete konfyans mwen nan SENYÈ a san varye.<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>Chache anndan m, O SENYÈ, e pase mwen a leprèv.</para>
  <para style="q1" vid="PSA 26:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">26:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:9">Sòm 7:9</ref>
      </char>
    </note>Sonde panse mwen avèk kè m.<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>Paske lanmou dous Ou a devan zye m.</para>
  <para style="q1" vid="PSA 26:3">Mwen <note caller="+" style="x"><char style="xo" closed="false">26:3 </char><char style="xt" closed="false"><ref loc="2KI 20:3">II Wa 20:3</ref></char></note>te mache nan verite Ou.<verse eid="PSA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>Mwen pa <note caller="+" style="x"><char style="xo" closed="false">26:4 </char><char style="xt" closed="false"><ref loc="PSA 1:1">Sòm 1:1</ref></char></note>chita avèk mesye k ap twonpe moun yo.</para>
  <para style="q1" vid="PSA 26:4">Ni mwen pa pale avèk sila k ap pran poz yo.<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>Mwen rayi asanble malfektè yo, e</para>
  <para style="q1" vid="PSA 26:5">mwen pa chita avèk mechan yo.<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>Mwen va lave men m nan inosans, e</para>
  <para style="q1" vid="PSA 26:6">mwen va antoure lotèl Ou, O SENYÈ,<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>pou m kapab pwoklame avèk vwa remèsiman a,</para>
  <para style="q1" vid="PSA 26:7">e deklare tout mèvèy Ou yo.<verse eid="PSA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>O SENYÈ, Mwen renmen abitasyon lakay Ou,</para>
  <para style="q1" vid="PSA 26:8">avèk kote ke <note caller="+" style="x"><char style="xo" closed="false">26:8 </char><char style="xt" closed="false"><ref loc="PSA 24:7">Sòm 24:7</ref></char></note>glwa Ou rete a.<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>Pa retire nanm mwen ansanm avèk pechè yo,</para>
  <para style="q1" vid="PSA 26:9">ni lavi m avèk <note caller="+" style="x"><char style="xo" closed="false">26:9 </char><char style="xt" closed="false"><ref loc="PSA 139:19">Sòm 139:19</ref></char></note>mesye ki vèse san yo,<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>nan men a sila ki gen manèv mechan yo,</para>
  <para style="q1" vid="PSA 26:10">ki nan mechanste pote <note caller="+" style="x"><char style="xo" closed="false">26:10 </char><char style="xt" closed="false"><ref loc="PSA 15:5">Sòm 15:5</ref></char></note>kado vèse anba tab yo.<verse eid="PSA 26:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>Men pou mwen, mwen va mache nan entegrite mwen.</para>
  <para style="q1" vid="PSA 26:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">26:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:26">Sòm 44:26</ref>
      </char>
    </note>Delivre mwen e fè m gras.<verse eid="PSA 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>Pye m kanpe sou yon plas byen plat.</para>
  <para style="q1" vid="PSA 26:12">Nan <note caller="+" style="x"><char style="xo" closed="false">26:12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">Sòm 22:22</ref></char></note>asanble a, mwen va beni SENYÈ a.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="d">Yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>SENYÈ a se limyè mwen e <note caller="+" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="ISA 33:2">És 33:2</ref></char></note>sali mwen.</para>
  <para style="q1" vid="PSA 27:1">Se kilès pou m ta pè? SENYÈ a se</para>
  <para style="q1" vid="PSA 27:1">defans lavi mwen.</para>
  <para style="q1" vid="PSA 27:1">Se kilès k ap fè m gen laperèz?<verse eid="PSA 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>Lè malfektè yo te rive sou mwen</para>
  <para style="q1" vid="PSA 27:2">pou yo ta devore chè m,</para>
  <para style="q1" vid="PSA 27:2">advèsè mwen yo ak lènmi m yo</para>
  <para style="q1" vid="PSA 27:2">te <note caller="+" style="x"><char style="xo" closed="false">27:2 </char><char style="xt" closed="false"><ref loc="PSA 9:3">Sòm 9:3</ref></char></note>chape tonbe.<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>Malgre yon lame ta fè kan kont mwen, kè m p ap pè.</para>
  <para style="q1" vid="PSA 27:3">Malgre lagè leve kont mwen,</para>
  <para style="q1" vid="PSA 27:3">malgre sa, m ap gen <note caller="+" style="x"><char style="xo" closed="false">27:3 </char><char style="xt" closed="false"><ref loc="JOB 4:6">Job 4:6</ref></char></note>konfyans.<verse eid="PSA 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>Yon sèl bagay ke m te mande a SENYÈ a;</para>
  <para style="q1" vid="PSA 27:4">se li mwen va chache:</para>
  <para style="q1" vid="PSA 27:4">pou m ta kab rete lakay SENYÈ a</para>
  <para style="q1" vid="PSA 27:4">tout jou lavi m yo,</para>
  <para style="q1" vid="PSA 27:4">pou m kab gade bèlte SENYÈ a, e</para>
  <para style="q1" vid="PSA 27:4">reflechi jis nan fon kè m nan tanp Li an.<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>Paske nan jou twoub la,</para>
  <para style="q1" vid="PSA 27:5">Li va <note caller="+" style="x"><char style="xo" closed="false">27:5 </char><char style="xt" closed="false"><ref loc="PSA 31:20">Sòm 31:20</ref> </char></note>kache mwen nan tabènak Li.</para>
  <para style="q1" vid="PSA 27:5">Nan plas sekrè kote tant Li an ye a,</para>
  <para style="q1" vid="PSA 27:5">se la Li va fè m kache.</para>
  <para style="q1" vid="PSA 27:5">Li va leve mwen sou yon wòch.<verse eid="PSA 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>Epi koulye a, <note caller="+" style="x"><char style="xo" closed="false">27:6 </char><char style="xt" closed="false"><ref loc="PSA 3:3">Sòm 3:3</ref></char></note>tèt mwen va vin leve wo</para>
  <para style="q1" vid="PSA 27:6">sou lènmi m ki antoure m yo.</para>
  <para style="q1" vid="PSA 27:6">Konsa, mwen va ofri nan tant Li sakrifis avèk gwo kri lajwa.</para>
  <para style="q1" vid="PSA 27:6">Mwen va chante, wi, mwen va chante lwanj a SENYÈ a.<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 4:3">Sòm 4:3</ref>
      </char>
    </note>Tande, O SENYÈ, lè m kriye avèk vwa m.</para>
  <para style="q1" vid="PSA 27:7">Fè m gras e reponn mwen.<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>Lè Ou te di m: <note caller="+" style="x"><char style="xo" closed="false">27:8 </char><char style="xt" closed="false"><ref loc="PSA 105:4">Sòm 105:4</ref></char></note>“Chache wè figi Mwen”,</para>
  <para style="q1" vid="PSA 27:8">kè m te di Ou: “Figi Ou menm, O SENYÈ,</para>
  <para style="q1" vid="PSA 27:8">se li mwen va chache.”<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>Pa kache figi Ou de mwen.</para>
  <para style="q1" vid="PSA 27:9">Pa detounen sèvitè Ou a pa deyò nan kòlè Ou.</para>
  <para style="q1" vid="PSA 27:9">Se Ou ki konn sekou mwen.</para>
  <para style="q1" vid="PSA 27:9">Pa abandone mwen, ni <note caller="+" style="x"><char style="xo" closed="false">27:9 </char><char style="xt" closed="false"><ref loc="PSA 37:28">Sòm 37:28</ref> </char></note>kite m sèl,</para>
  <para style="q1" vid="PSA 27:9">O Bondye delivrans mwen an.<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>Paske papa m ak manman m te abandone mwen,</para>
  <para style="q1" vid="PSA 27:10">Men <note caller="+" style="x"><char style="xo" closed="false">27:10 </char><char style="xt" closed="false"><ref loc="ISA 40:11">És 40:11</ref> </char></note>SENYÈ a va ranmase mwen.<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">27:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:4">Sòm 25:4</ref>
      </char>
    </note>Enstwi mwen nan chemen Ou, O SENYÈ.</para>
  <para style="q1" vid="PSA 27:11">Mennen m nan yon wout ki a nivo, akoz lènmi mwen yo.<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>Pa livre mwen de dezi lènmi mwen yo,</para>
  <para style="q1" vid="PSA 27:12">paske <note caller="+" style="x"><char style="xo" closed="false">27:12 </char><char style="xt" closed="false"><ref loc="MAT 26:60">Mat 26:60</ref></char></note>fo temwen yo vin leve kont mwen,</para>
  <para style="q1" vid="PSA 27:12">sila k ap respire vyolans yo.<verse eid="PSA 27:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>Mwen toujou gen konfyans sa a:</para>
  <para style="q1" vid="PSA 27:13">ke m va wè <note caller="+" style="x"><char style="xo" closed="false">27:13 </char><char style="xt" closed="false"><ref loc="PSA 31:19">Sòm 31:19</ref></char></note>bonte SENYÈ a nan peyi a vivan yo.<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>Tann SENYÈ a.</para>
  <para style="q1" vid="PSA 27:14">
    <note caller="+" style="x">
      <char style="xo" closed="false">27:14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:24">Sòm 31:24</ref>
      </char>
    </note>Kenbe fòs Ou e kite kè Ou pran kouraj.</para>
  <para style="q1" vid="PSA 27:14">Wi, tann SENYÈ a.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="d">Yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>A Ou menm, O SENYÈ, mwen rele!</para>
  <para style="q1" vid="PSA 28:1">Wòch mwen an, pa vin soud devan m,</para>
  <para style="q1" vid="PSA 28:1">paske si Ou <note caller="+" style="x"><char style="xo" closed="false">28:1 </char><char style="xt" closed="false"><ref loc="PSA 83:1">Sòm 83:1</ref></char></note>rete silan devan mwen,</para>
  <para style="q1" vid="PSA 28:1">mwen va devni kon sila ki desann nan twou fòs la nèt.<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>Tande <note caller="+" style="x"><char style="xo" closed="false">28:2 </char><char style="xt" closed="false"><ref loc="PSA 140:6">Sòm 140:6</ref></char></note>vwa a siplikasyon mwen yo</para>
  <para style="q1" vid="PSA 28:2">lè m kriye a Ou menm pou sekou,</para>
  <para style="q1" vid="PSA 28:2">lè m leve men m vè sanktiyè sen Ou an.<verse eid="PSA 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">28:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 26:9">Sòm 26:9</ref>
      </char>
    </note>Pa rale m sòti avèk mechan yo,</para>
  <para style="q1" vid="PSA 28:3">avèk sila ki fè inikite yo, ki pale lapè avèk vwazen yo,</para>
  <para style="q1" vid="PSA 28:3">pandan mechanste nan kè yo.<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>Rekonpanse yo <note caller="+" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="REV 18:6">Rev 18:6</ref></char></note>selon zèv yo ak selon mechanste yo abitye fè yo.</para>
  <para style="q1" vid="PSA 28:4">Rekonpanse yo selon zèv men yo.</para>
  <para style="q1" vid="PSA 28:4">Remèt yo tout rekonpans pa yo.<verse eid="PSA 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>Akoz yo <note caller="+" style="x"><char style="xo" closed="false">28:5 </char><char style="xt" closed="false"><ref loc="ISA 5:12">És 5:12</ref></char></note>pa okipe zèv a SENYÈ yo,</para>
  <para style="q1" vid="PSA 28:5">ni travay men Li yo.</para>
  <para style="q1" vid="PSA 28:5">Pou sa, Li va chire yo desann, e Li p ap fè yo remonte.<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>Beni se SENYÈ a,</para>
  <para style="q1" vid="PSA 28:6">akoz Li <note caller="+" style="x"><char style="xo" closed="false">28:6 </char><char style="xt" closed="false"><ref loc="PSA 28:2">Sòm 28:2</ref></char></note>te tande vwa a siplikasyon mwen yo.<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>SENYÈ a se fòs mwen ak boukliye mwen.</para>
  <para style="q1" vid="PSA 28:7">Kè m <note caller="+" style="x"><char style="xo" closed="false">28:7 </char><char style="xt" closed="false"><ref loc="PSA 13:5">Sòm 13:5</ref></char></note>mete konfyans nan Li, e mwen</para>
  <para style="q1" vid="PSA 28:7">jwenn sekou.</para>
  <para style="q1" vid="PSA 28:7">Pou sa, kè m leve wo nèt.</para>
  <para style="q1" vid="PSA 28:7">Avèk chanson mwen, mwen va di Li mèsi.<verse eid="PSA 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>SENYÈ a se <note caller="+" style="x"><char style="xo" closed="false">28:8 </char><char style="xt" closed="false"><ref loc="PSA 20:6">Sòm 20:6</ref></char></note>fòs yo.</para>
  <para style="q1" vid="PSA 28:8">Li se yon defans pou sove onksyone Li yo.<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">28:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 80:1">Sòm 80:1</ref>
      </char>
    </note> Sove pèp Ou a, e beni eritaj pa Ou a.</para>
  <para style="q1" vid="PSA 28:9">Devni bèje yo tou,</para>
  <para style="q1" vid="PSA 28:9">e bay yo soutyen jis pou tout tan.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="d">Yon sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">29:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:28-29">I Kwo 16:28-29</ref>
      </char>
    </note>Bay a SENYÈ a, O Fis a moun pwisan yo,</para>
  <para style="q1" vid="PSA 29:1">bay a SENYÈ a, glwa avèk gwo fòs.<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>Bay a SENYÈ a, glwa ke non Li merite a.</para>
  <para style="q1" vid="PSA 29:2">Adore SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">29:2 </char><char style="xt" closed="false"><ref loc="2CH 20:21">II Kwo 20:21</ref></char></note>avèk tout sa ki sen.<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>Vwa SENYÈ a sou dlo yo.</para>
  <para style="q1" vid="PSA 29:3">Bondye glwa la <note caller="+" style="x"><char style="xo" closed="false">29:3 </char><char style="xt" closed="false"><ref loc="JOB 37:4">Job 37:4</ref>,<ref loc="JOB 37:5">5</ref></char></note> fè tonnè gwonde, eklate.</para>
  <para style="q1" vid="PSA 29:3">SENYÈ a sou anpil dlo.<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>Vwa SENYÈ a gen <note caller="+" style="x"><char style="xo" closed="false">29:4 </char><char style="xt" closed="false"><ref loc="PSA 68:33">Sòm 68:33</ref></char></note>gwo fòs.</para>
  <para style="q1" vid="PSA 29:4">Vwa SENYÈ a ranpli ak majeste.<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>Vwa SENYÈ a fann bwa sèd yo.</para>
  <para style="q1" vid="PSA 29:5">Wi, SENYÈ a fann an mòso <note caller="+" style="x"><char style="xo" closed="false">29:5 </char><char style="xt" closed="false"><ref loc="PSA 104:16">Sòm 104:16</ref></char></note> bwa sèd Liban yo.<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>Li fè Liban sote. Li ponpe tankou yon ti bèf, e</para>
  <para style="q1" vid="PSA 29:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">29:6 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 3:9">Det 3:9</ref>
      </char>
    </note>Sirion tankou yon jèn bèf mawon.<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>Vwa SENYÈ a koupe fè flanm dife.<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>Vwa SENYÈ a souke savann nan.</para>
  <para style="q1" vid="PSA 29:8">Vwa SENYÈ a souke savann Kadès la.<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>Vwa SENYÈ a fè <note caller="+" style="x"><char style="xo" closed="false">29:9 </char><char style="xt" closed="false"><ref loc="JOB 39:1">Job 39:1</ref></char></note>bich la fè pitit.</para>
  <para style="q1" vid="PSA 29:9">Li fè forè a vin toutouni.</para>
  <para style="q1" vid="PSA 29:9">Nan tanp Li a, tout moun ki la yo rele: “Glwa”!<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>SENYÈ a te chita kon Wa nan gran inondasyon an.</para>
  <para style="q1" vid="PSA 29:10">Wi, SENYÈ a chita kon <note caller="+" style="x"><char style="xo" closed="false">29:10 </char><char style="xt" closed="false"><ref loc="PSA 10:16">Sòm 10:16</ref> </char></note>Wa jis pou tout tan.<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>SENYÈ a va bay fòs a pèp Li a.</para>
  <para style="q1" vid="PSA 29:11">SENYÈ a va beni pèp li a avèk <note caller="+" style="x"><char style="xo" closed="false">29:11 </char><char style="xt" closed="false"><ref loc="PSA 72:3">Sòm 72:3</ref> </char></note>lapè.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="d">Yon Sòm; yon chan nan Dedikasyon Kay La; Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>Mwen va leve Ou wo, O SENYÈ, paske Ou <note caller="+" style="x"><char style="xo" closed="false">30:1 </char><char style="xt" closed="false"><ref loc="PSA 3:3">Sòm 3:3</ref></char></note>te leve mwen.</para>
  <para style="q1" vid="PSA 30:1">Ou pa t kite lènmi m yo rejwi sou mwen.<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>O SENYÈ, Bondye mwen an, mwen te kriye a Ou menm,</para>
  <para style="q1" vid="PSA 30:2">e Ou te <note caller="+" style="x"><char style="xo" closed="false">30:2 </char><char style="xt" closed="false"><ref loc="ISA 53:5">És 53:5</ref></char></note>geri mwen.<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>O SENYÈ, Ou te fè nanm mwen monte kite sejou lanmò yo.</para>
  <para style="q1" vid="PSA 30:3">Ou te kenbe m vivan, pou m pa t desann nan gwo fòs la.<verse eid="PSA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>Chante lwanj a SENYÈ a, nou menm ki fidèl Li yo.</para>
  <para style="q1" vid="PSA 30:4">Bay remèsiman a <note caller="+" style="x"><char style="xo" closed="false">30:4 </char><char style="xt" closed="false"><ref loc="HOS 12:5">Os 12:5</ref> </char></note>sen non Li.<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>Paske kòlè Li se sèlman pou yon moman,</para>
  <para style="q1" vid="PSA 30:5">men Bonte Li se pou tout tan.</para>
  <para style="q1" vid="PSA 30:5">Kriye a kapab dire <note caller="+" style="x"><char style="xo" closed="false">30:5 </char><char style="xt" closed="false"><ref loc="2CH 4:17">II Kwo 4:17</ref> </char></note>pou nwit lan,</para>
  <para style="q1" vid="PSA 30:5">men kri lajwa a vin parèt nan maten.<verse eid="PSA 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>Alò, pou mwen, mwen te di nan bon tan mwen,</para>
  <para style="q1" vid="PSA 30:6">“Mwen <note caller="+" style="x"><char style="xo" closed="false">30:6 </char><char style="xt" closed="false"><ref loc="PSA 10:6">Sòm 10:6</ref></char></note>p ap janm ebranle.”<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>O SENYÈ, pa gras Ou, Ou te fè mòn mwen an kanpe fèm.</para>
  <para style="q1" vid="PSA 30:7">Lè Ou te kache figi Ou, mwen te dekouraje nèt.<verse eid="PSA 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>A Ou menm, SENYÈ, mwen te rele.</para>
  <para style="q1" vid="PSA 30:8">A SENYÈ mwen an, mwen te fè siplikasyon mwen yo:<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“Ki benefis ki genyen nan san mwen</para>
  <para style="q1" vid="PSA 30:9">si mwen <note caller="+" style="x"><char style="xo" closed="false">30:9 </char><char style="xt" closed="false"><ref loc="PSA 28:1">Sòm 28:1</ref></char></note>desann nan gwo fòs la?</para>
  <para style="q1" vid="PSA 30:9">Èske pousyè a kab louwe Ou?</para>
  <para style="q1" vid="PSA 30:9">Èske li va deklare fidelite Ou?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>Tande, O SENYÈ e fè m gras.</para>
  <para style="q1" vid="PSA 30:10">O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">30:10 </char><char style="xt" closed="false"><ref loc="PSA 27:9">Sòm 27:9</ref></char></note>ban m soutyen.”<verse eid="PSA 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>Ou te chanje doulè mwen, e</para>
  <para style="q1" vid="PSA 30:11">sa te fè m vin danse ak lajwa;</para>
  <para style="q1" vid="PSA 30:11">Ou te <note caller="+" style="x"><char style="xo" closed="false">30:11 </char><char style="xt" closed="false"><ref loc="ISA 20:2">És 20:2</ref></char></note>demare rad twal sak mwen an,</para>
  <para style="q1" vid="PSA 30:11">e te mare senti m avèk kè kontan.<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>Konsa, pou kè m kab chante lwanj Ou, e pa rete an silans.</para>
  <para style="q1" vid="PSA 30:12">O SENYÈ, Bondye mwen an, mwen va</para>
  <para style="q1" vid="PSA 30:12">bay Ou glwa pou tout tan, nèt.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="d">Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>Nan Ou menm, SENYÈ, mwen kache.</para>
  <para style="q1" vid="PSA 31:1">Pa janm kite mwen <note caller="+" style="x"><char style="xo" closed="false">31:1 </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sòm 25:2</ref></char></note>vin wont.</para>
  <para style="q1" vid="PSA 31:1">Nan ladwati Ou, delivre mwen.<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>Panche zòrèy W bò kote mwen.</para>
  <para style="q1" vid="PSA 31:2">Delivre mwen byen vit.</para>
  <para style="q1" vid="PSA 31:2">Devni pou mwen <note caller="+" style="x"><char style="xo" closed="false">31:2 </char><char style="xt" closed="false"><ref loc="PSA 18:2">Sòm 18:2</ref></char></note>wòch ki ban m fòs,</para>
  <para style="q1" vid="PSA 31:2">yon sitadèl ki pou sove m.<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>Paske Ou se wòch mwen ak sitadèl mwen,</para>
  <para style="q1" vid="PSA 31:3">konsa, pou koz a non Ou, Ou va gide mwen.<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>Ou va rale m sòti nan filè ke yo te</para>
  <para style="q1" vid="PSA 31:4">prepare an sekrè pou mwen an,</para>
  <para style="q1" vid="PSA 31:4">paske se Ou ki fòs mwen.<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">31:5 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 23:46">Luc 23:46</ref>
      </char>
    </note>Nan men Ou, mwen mete lespri mwen.</para>
  <para style="q1" vid="PSA 31:5">Ou te rachte m, O SENYÈ, Bondye verite a.<verse eid="PSA 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>Mwen rayi sila ki fè rega a fo zidòl yo,</para>
  <para style="q1" vid="PSA 31:6">men nan Bondye, mwen <note caller="+" style="x"><char style="xo" closed="false">31:6 </char><char style="xt" closed="false"><ref loc="PSA 52:8">Sòm 52:8</ref></char></note>mete konfyans mwen.<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>Mwen va rejwi e fè kè kontan nan</para>
  <para style="q1" vid="PSA 31:7">lanmou dous Ou, akoz Ou te wè soufrans mwen.</para>
  <para style="q1" vid="PSA 31:7">Ou te <note caller="+" style="x"><char style="xo" closed="false">31:7 </char><char style="xt" closed="false"><ref loc="PSA 10:14">Sòm 10:14</ref></char></note>wè soufrans a nanm mwen.<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">31:8 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:30">Det 32:30</ref>
      </char>
    </note>Ou pa t lage mwen nan men a lènmi an.</para>
  <para style="q1" vid="PSA 31:8">Ou te mete pye mwen nan yon kote byen laj.<verse eid="PSA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>Fè m gras, O SENYÈ, paske mwen nan gwo twoub.</para>
  <para style="q1" vid="PSA 31:9">Zye m ak kò m ak nanm mwen;</para>
  <para style="q1" vid="PSA 31:9">tout fin gate nèt akoz doulè m.<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>Paske lavi m fin pase nèt ak gwo doulè m,</para>
  <para style="q1" vid="PSA 31:10">ane mwen yo avèk soupi.</para>
  <para style="q1" vid="PSA 31:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">31:10 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:11">Sòm 39:11</ref>
      </char>
    </note>Fòs mwen fin ale akoz inikite m.</para>
  <para style="q1" vid="PSA 31:10">Kò mwen fin epwize.<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>Akoz tout advèsè mwen yo, mwen te</para>
  <para style="q1" vid="PSA 31:11">devni yon objè <note caller="+" style="x"><char style="xo" closed="false">31:11 </char><char style="xt" closed="false"><ref loc="PSA 69:19">Sòm 69:19</ref></char></note>abominab,</para>
  <para style="q1" vid="PSA 31:11">sitou a vwazen mwen yo, e yon</para>
  <para style="q1" vid="PSA 31:11">objè laperèz a sila ki rekonèt mwen yo.</para>
  <para style="q1" vid="PSA 31:11">Sila ki wè m nan lari yo sove ale devan m.<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>Mwen fin <note caller="+" style="x"><char style="xo" closed="false">31:12 </char><char style="xt" closed="false"><ref loc="PSA 88:5">Sòm 88:5</ref></char></note>bliye tankou yon moun mouri,</para>
  <para style="q1" vid="PSA 31:12">disparèt nan panse moun.</para>
  <para style="q1" vid="PSA 31:12">Mwen tankou yon veso ki fin kraze.<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>Paske mwen konn tande kout lang</para>
  <para style="q1" vid="PSA 31:13">anpil moun, laperèz toupatou.</para>
  <para style="q1" vid="PSA 31:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">31:13 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:1">Mat 27:1</ref>
      </char>
    </note>Yo pran konsèy ansanm kont mwen.</para>
  <para style="q1" vid="PSA 31:13">Yo te fè konplo pou rache lavi m.<verse eid="PSA 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>Men pou mwen, mwen mete konfyans nan Ou, O SENYÈ.</para>
  <para style="q1" vid="PSA 31:14">Mwen di: <note caller="+" style="x"><char style="xo" closed="false">31:14 </char><char style="xt" closed="false"><ref loc="PSA 140:6">Sòm 140:6</ref></char></note>“Se Ou menm ki Bondye mwen”.<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>Moman mwen yo nan men Ou.</para>
  <para style="q1" vid="PSA 31:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">31:15 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 143:9">Sòm 143:9</ref> </char>
    </note>Delivre mwen nan men a lènmi mwen yo,</para>
  <para style="q1" vid="PSA 31:15">avèk sila ki pèsekite mwen yo.<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>Fè limyè figi Ou vin parèt sou sèvitè Ou a.</para>
  <para style="q1" vid="PSA 31:16">
    <note caller="+" style="x">
      <char style="xo" closed="false">31:16 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:4">Sòm 6:4</ref>
      </char>
    </note>Sove mwen nan lanmou dous Ou a.<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>Pa kite mwen fè wont, O SENYÈ,</para>
  <para style="q1" vid="PSA 31:17">paske se Ou ke m rele.<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>Kite lèv ki manti yo sispann,</para>
  <para style="q1" vid="PSA 31:18">sila yo ka p <note caller="+" style="x"><char style="xo" closed="false">31:18 </char><char style="xt" closed="false"><ref loc="JUD 1:15">Jd 15</ref> </char></note>pale ak awogans kont moun dwat yo,</para>
  <para style="q1" vid="PSA 31:18">k ap fè ògèy pou desann moun.<verse eid="PSA 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>Men a la gran, <note caller="+" style="x"><char style="xo" closed="false">31:19 </char><char style="xt" closed="false"><ref loc="ISA 64:4">És 64:4</ref></char></note>bonte ke Ou</para>
  <para style="q1" vid="PSA 31:19">te konsève pou sila ki krent Ou yo,</para>
  <para style="q1" vid="PSA 31:19">ke Ou te fòje pou sila ki kache nan Ou yo, devan fis a lòm yo!<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>Ou kache yo nan kote sekrè a prezans Ou, kont tout <note caller="+" style="x"><char style="xo" closed="false">31:20 </char><char style="xt" closed="false"><ref loc="PSA 37:12">Sòm 37:12</ref> </char></note>manèv a lòm.</para>
  <para style="q1" vid="PSA 31:20">Ou konsève yo an sekrè nan yon pwotèj</para>
  <para style="q1" vid="PSA 31:20">kont konplo a tout lang lèzòm.<verse eid="PSA 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>Beni se SENYÈ a,</para>
  <para style="q1" vid="PSA 31:21">paske li te fè mèvèy a lanmou dous Li a</para>
  <para style="q1" vid="PSA 31:21">anvè mwen nan yon <note caller="+" style="x"><char style="xo" closed="false">31:21 </char><char style="xt" closed="false"><ref loc="1SA 23:7">I Sam 23:7</ref> </char></note>vil byen fò.<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>Pou mwen, mwen te di ak kè sote mwen:</para>
  <para style="q1" vid="PSA 31:22">“Mwen <note caller="+" style="x"><char style="xo" closed="false">31:22 </char><char style="xt" closed="false"><ref loc="ISA 38:11-12">És 38:11-12</ref></char></note>koupe retire nèt devan zye Ou”.</para>
  <para style="q1" vid="PSA 31:22">Sepandan, Ou te tande vwa a siplikasyon mwen yo</para>
  <para style="q1" vid="PSA 31:22">lè m te kriye a Ou menm.<verse eid="PSA 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>O renmen SENYÈ a, nou tout, moun fidèl yo!</para>
  <para style="q1" vid="PSA 31:23">SENYÈ a toujou <note caller="+" style="x"><char style="xo" closed="false">31:23 </char><char style="xt" closed="false"><ref loc="PSA 145:20">Sòm 145:20</ref></char></note>prezève moun fidèl yo,</para>
  <para style="q1" vid="PSA 31:23">e bay pwòp rekonpans a sila ki plen ògèy yo.<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>Kenbe fèm e <note caller="+" style="x"><char style="xo" closed="false">31:24 </char><char style="xt" closed="false"><ref loc="PSA 27:14">Sòm 27:14</ref></char></note>kite kè ou pran kouraj,</para>
  <para style="q1" vid="PSA 31:24">nou tout ki mete espwa nan SENYÈ a.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="d">Yon Sòm David. Yon Sòm Refleksyon</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">32:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 85:2">Sòm 85:2</ref>
      </char>
    </note>A la beni se sila ki padone pou transgresyon li,</para>
  <para style="q1" vid="PSA 32:1">pou peche li ki kouvri a!<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>A la nonm beni se sila SENYÈ a pa jije kon koupab la,</para>
  <para style="q1" vid="PSA 32:2">e nan lespri a sila <note caller="+" style="x"><char style="xo" closed="false">32:2 </char><char style="xt" closed="false"><ref loc="JHN 1:47">Jn 1:47</ref></char></note> ki pa gen manti a.<verse eid="PSA 32:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>Lè m te <note caller="+" style="x"><char style="xo" closed="false">32:3 </char><char style="xt" closed="false"><ref loc="PSA 39:2-3">Sòm 39:2-3</ref></char></note>kenbe silans selon peche mwen,</para>
  <para style="q1" vid="PSA 32:3">kò m te desann bese nèt e mwen t ap plenyen tout lajounen.<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>Paske lajounen kon lannwit,</para>
  <para style="q1" vid="PSA 32:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">32:4 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 5:6">I Sam 5:6</ref>
      </char>
    </note>men Ou te lou sou mwen.</para>
  <para style="q1" vid="PSA 32:4">Fòs mwen te epwize vin bese</para>
  <para style="q1" vid="PSA 32:4">tankou gwo chalè nan gran sezon ete. <char style="qs">Tan</char><verse eid="PSA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>Mwen te vin rekonèt peche m devan Ou,</para>
  <para style="q1" vid="PSA 32:5">e inikite mwen, mwen pa t ankò kache.</para>
  <para style="q1" vid="PSA 32:5">Mwen te di: <note caller="+" style="x"><char style="xo" closed="false">32:5 </char><char style="xt" closed="false"><ref loc="1JN 1:9">I Jn 1:9</ref></char></note>“Mwen va konfese transgresyon mwen yo a SENYÈ a”,</para>
  <para style="q1" vid="PSA 32:5">epi Ou te padone koupabilite m pou peche mwen yo.<verse eid="PSA 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>Konsa, kite tout sila ki fidèl yo priye vè Ou menm,</para>
  <para style="q1" vid="PSA 32:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">32:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:13">Sòm 69:13</ref>
      </char>
    </note>nan yon lè ke Ou toujou disponib.</para>
  <para style="q1" vid="PSA 32:6">Anverite, nan gran flèv dlo yo,</para>
  <para style="q1" vid="PSA 32:6">yo p ap kab rive kote Li ankò.<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>Ou se kote ke m konn kache a.</para>
  <para style="q1" vid="PSA 32:7">Ou <note caller="+" style="x"><char style="xo" closed="false">32:7 </char><char style="xt" closed="false"><ref loc="PSA 121:7">Sòm 121:7</ref> </char></note>pwoteje mwen kont gwo twoub.</para>
  <para style="q1" vid="PSA 32:7">Ou antoure mwen avèk chanson delivrans yo.<verse eid="PSA 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">32:8 </char><char style="xt" closed="false"><ref loc="PSA 25:8">Sòm 25:8</ref></char></note>enstwi ou e fè ou aprann chemen</para>
  <para style="q1" vid="PSA 32:8">nan sila ou dwe ale a.</para>
  <para style="q1" vid="PSA 32:8">Mwen va bay ou konsèy avèk zye M sou ou.<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>Pa fè <note caller="+" style="x"><char style="xo" closed="false">32:9 </char><char style="xt" closed="false"><ref loc="PRO 26:3">Pwov 26:3</ref></char></note>tankou cheval oswa milèt ki pa gen konprann menm,</para>
  <para style="q1" vid="PSA 32:9">ki nan tout sikonstans, oblije gen brid ak bosal ki pou ralanti yo.</para>
  <para style="q1" vid="PSA 32:9">Otreman, yo p ap vin kote ou.<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>Anpil se <note caller="+" style="x"><char style="xo" closed="false">32:10 </char><char style="xt" closed="false"><ref loc="ROM 2:9">Wo 2:9</ref></char></note>tristès a mechan yo,</para>
  <para style="q1" vid="PSA 32:10">men sila ki mete konfyans li nan SENYÈ a,</para>
  <para style="q1" vid="PSA 32:10">se lanmou dous ki va antoure li.<verse eid="PSA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>Fè kè kontan nan SENYÈ a e rejwi, nou menm ki jis!</para>
  <para style="q1" vid="PSA 32:11">Rele avèk jwa, nou tout <note caller="+" style="x"><char style="xo" closed="false">32:11 </char><char style="xt" closed="false"><ref loc="PSA 7:10">Sòm 7:10</ref></char></note>ki dwat nan kè nou yo.<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>Rejwi ak lajwa nan SENYÈ a, O moun ladwati yo!</para>
  <para style="q1" vid="PSA 33:1">Lwanj <note caller="+" style="x"><char style="xo" closed="false">33:1 </char><char style="xt" closed="false"><ref loc="PSA 92:1">Sòm 92:1</ref></char></note>bèl lè l sòti nan moun ki dwat.<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">33:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:22">Sòm 71:22</ref>
      </char>
    </note>Bay remèsiman a SENYÈ avèk gita.</para>
  <para style="q1" vid="PSA 33:2">Chante lwanj a Li menm avèk ap dis kòd.<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>Chante a Li menm yon chan tounèf.</para>
  <para style="q1" vid="PSA 33:3">Jwe ak kapasite e fò avèk yon <note caller="+" style="x"><char style="xo" closed="false">33:3 </char><char style="xt" closed="false"><ref loc="PSA 98:4">Sòm 98:4</ref></char></note>gwo kri lajwa.<verse eid="PSA 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>Paske pawòl SENYÈ a dwat.</para>
  <para style="q1" vid="PSA 33:4">Tout zèv Li yo fèt <note caller="+" style="x"><char style="xo" closed="false">33:4 </char><char style="xt" closed="false"><ref loc="PSA 119:90">Sòm 119:90</ref> </char></note>avèk fidelite.<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>Li <note caller="+" style="x"><char style="xo" closed="false">33:5 </char><char style="xt" closed="false"><ref loc="PSA 11:7">Sòm 11:7</ref></char></note>renmen ladwati avèk jistis.</para>
  <para style="q1" vid="PSA 33:5">Latè ranpli avèk lanmou dous SENYÈ a.<verse eid="PSA 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>Avèk pawòl SENYÈ a syèl yo te fèt:</para>
  <para style="q1" vid="PSA 33:6">pa souf a bouch Li, <note caller="+" style="x"><char style="xo" closed="false">33:6 </char><char style="xt" closed="false"><ref loc="GEN 2:1">Jen 2:1</ref></char></note>tout lame syèl yo.<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>Li ranmase tout <note caller="+" style="x"><char style="xo" closed="false">33:7 </char><char style="xt" closed="false"><ref loc="EXO 15:8">Egz 15:8</ref></char></note>dlo lanmè yo ansanm pou fè yon gwo pil.</para>
  <para style="q1" vid="PSA 33:7">Li fè tout pwofondè yo kouche fè kay depo.<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>Kite <note caller="+" style="x"><char style="xo" closed="false">33:8 </char><char style="xt" closed="false"><ref loc="PSA 67:7">Sòm 67:7</ref></char></note>tout latè krent SENYÈ a.</para>
  <para style="q1" vid="PSA 33:8">Kite tout sila ki rete nan mond lan</para>
  <para style="q1" vid="PSA 33:8">kanpe etone nèt pa Li menm.<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>Paske <note caller="+" style="x"><char style="xo" closed="false">33:9 </char><char style="xt" closed="false"><ref loc="GEN 1:3">Jen 1:3</ref></char></note>Li te pale e mond lan te fèt.</para>
  <para style="q1" vid="PSA 33:9">Li te kòmande e li te kanpe fèm.<verse eid="PSA 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">33:10 </char><char style="xt" closed="false"><ref loc="PSA 2:1-3">Sòm 2:1-3</ref></char></note>ranvèse konsèy a nasyon yo.</para>
  <para style="q1" vid="PSA 33:10">Li anile pwojè a pèp yo.<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">33:11 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 23:12">Job 23:12</ref>
      </char>
    </note>Konsèy SENYÈ a kanpe jis pou tout tan,</para>
  <para style="q1" vid="PSA 33:11">e pwojè a kè Li yo de jenerasyon an jenerasyon.<verse eid="PSA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>Beni se nasyon ki gen Bondye kon SENYÈ yo,<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>pèp ke Li te <note caller="+" style="x"><char style="xo" closed="false">33:13 </char><char style="xt" closed="false"><ref loc="EXO 19:5">Egz 19:5</ref> </char></note>chwazi pou pwòp eritaj Li a.</para>
  <para style="q1" vid="PSA 33:13">SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">33:13 </char><char style="xt" closed="false"><ref loc="JOB 28:24">Job 28:24</ref></char></note>gade depi nan syèl la.</para>
  <para style="q1" vid="PSA 33:13">Li wè tout fis a lòm yo.<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>Soti nan <note caller="+" style="x"><char style="xo" closed="false">33:14 </char><char style="xt" closed="false"><ref loc="1KI 8:39-43">I Wa 8:39-43</ref></char></note>abitasyon Li an,</para>
  <para style="q1" vid="PSA 33:14">Li veye sou tout sila ki rete sou latè yo.<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>Li menm ki <note caller="+" style="x"><char style="xo" closed="false">33:15 </char><char style="xt" closed="false"><ref loc="JOB 10:8">Job 10:8</ref></char></note>fòme kè a yo tout,</para>
  <para style="q1" vid="PSA 33:15">Li menm ki konprann tout zèv yo.<verse eid="PSA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">33:16 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:6">Sòm 44:6</ref>
      </char>
    </note>Wa a pa sove pa yon lame pwisan.</para>
  <para style="q1" vid="PSA 33:16">Yon gèrye pa delivre pa gran fòs Li.<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>Yon cheval se yon <note caller="+" style="x"><char style="xo" closed="false">33:17 </char><char style="xt" closed="false"><ref loc="PSA 20:7">Sòm 20:7</ref></char></note>fo espwa pou viktwa a,</para>
  <para style="q1" vid="PSA 33:17">ni li p ap delivre pèsòn ak pwisans li.<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>Veye byen, zye SENYÈ a sou sila ki krent Li yo,</para>
  <para style="q1" vid="PSA 33:18">sou sila ki <note caller="+" style="x"><char style="xo" closed="false">33:18 </char><char style="xt" closed="false"><ref loc="PSA 32:10">Sòm 32:10</ref></char></note>mete espwa yo nan lanmou dous Li a,<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>pou <note caller="+" style="x"><char style="xo" closed="false">33:19 </char><char style="xt" closed="false"><ref loc="PSA 56:13">Sòm 56:13</ref></char></note>delivre nanm pa yo devan lanmò,</para>
  <para style="q1" vid="PSA 33:19">e kenbe yo vivan nan gwo grangou.<verse eid="PSA 33:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>Nanm nou <note caller="+" style="x"><char style="xo" closed="false">33:20 </char><char style="xt" closed="false"><ref loc="ISA 8:17">És 8:17</ref></char></note>ap tann SENYÈ a.</para>
  <para style="q1" vid="PSA 33:20">Se Li menm ki sekou nou ak boukliye nou.<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>Paske <note caller="+" style="x"><char style="xo" closed="false">33:21 </char><char style="xt" closed="false"><ref loc="ZEC 10:7">Za 10:7</ref></char></note>kè nou rejwi nan Li, akoz</para>
  <para style="q1" vid="PSA 33:21">nou mete konfyans nou nan sen non Li.<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>Kite lanmou dous Ou, O SENYÈ, vin poze sou nou,</para>
  <para style="q1" vid="PSA 33:22">selon esperans ke nou te mete nan Ou a.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="d">Yon Sòm David lè l te parèt tankou moun fou devan Abimélec ki te pouse l ale, epi konsa, li te pati.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">34:1 </char><char style="xt" closed="false"><ref loc="EPH 5:20">Ef 5:20</ref></char></note>beni SENYÈ a nan tout tan.</para>
  <para style="q1" vid="PSA 34:1">Lwanj Li va toujou nan bouch mwen.<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>Nanm mwen va <note caller="+" style="x"><char style="xo" closed="false">34:2 </char><char style="xt" closed="false"><ref loc="JER 9:24">Jr 9:24</ref></char></note>fè glwa li nan SENYÈ a.</para>
  <para style="q1" vid="PSA 34:2">Enb yo va tande l, e yo va rejwi.<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>O leve SENYÈ a byen wo avè m.</para>
  <para style="q1" vid="PSA 34:3">Annou <note caller="+" style="x"><char style="xo" closed="false">34:3 </char><char style="xt" closed="false"><ref loc="PSA 18:46">Sòm 18:46</ref></char></note>leve non L wo ansanm.<verse eid="PSA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">34:4 </char><char style="xt" closed="false"><ref loc="MAT 7:7">Mat 7:7</ref></char></note>chache SENYÈ a e Li te reponn mwen,</para>
  <para style="q1" vid="PSA 34:4">epi te delivre mwen de tout perèz mwen yo.<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>Yo te gade vè Li, e te vin ranpli ak limyè.</para>
  <para style="q1" vid="PSA 34:5">Figi yo <note caller="+" style="x"><char style="xo" closed="false">34:5 </char><char style="xt" closed="false"><ref loc="PSA 25:3">Sòm 25:3</ref></char></note>p ap janm wont.<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>Malere sila a te rele, e SENYÈ a te tande li,</para>
  <para style="q1" vid="PSA 34:6">epi <note caller="+" style="x"><char style="xo" closed="false">34:6 </char><char style="xt" closed="false"><ref loc="PSA 34:4">Sòm 34:4</ref></char></note>te sove li sòti nan tout twoub li yo.<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">34:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:11">Sòm 91:11</ref>
      </char>
    </note>Zanj SENYÈ a fè kan antoure sila ki krent Li yo,</para>
  <para style="q1" vid="PSA 34:7">epi li sove yo nan gwo twoub.<verse eid="PSA 34:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>O goute e wè ke Bondye bon.</para>
  <para style="q1" vid="PSA 34:8">A la beni nonm <note caller="+" style="x"><char style="xo" closed="false">34:8 </char><char style="xt" closed="false"><ref loc="PSA 2:12">Sòm 2:12</ref></char></note>ki kache nan Li a beni!<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>Krent SENYÈ a, O nou menm ki <note caller="+" style="x"><char style="xo" closed="false">34:9 </char><char style="xt" closed="false"><ref loc="PSA 31:23">Sòm 31:23</ref></char></note>sen Li yo.</para>
  <para style="q1" vid="PSA 34:9">Pou sila ki krent Li yo, anyen pa manke.<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>Jenn ti lyon yo konn manke manje e soufri grangou,</para>
  <para style="q1" vid="PSA 34:10">men sila ki chache SENYÈ yo,</para>
  <para style="q1" vid="PSA 34:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">34:10 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 84:11">Sòm 84:11</ref>
      </char>
    </note>p ap manke okenn bon bagay.<verse eid="PSA 34:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>Vini, pitit, koute mwen.</para>
  <para style="q1" vid="PSA 34:11">Mwen va enstwi ou nan <note caller="+" style="x"><char style="xo" closed="false">34:11 </char><char style="xt" closed="false"><ref loc="PSA 111:10">Sòm 111:10</ref></char></note>lakrent SENYÈ a.<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>Se ki moun ki dezire lavi, e renmen</para>
  <para style="q1" vid="PSA 34:12">jou li yo pou li kapab <note caller="+" style="x"><char style="xo" closed="false">34:12 </char><char style="xt" closed="false"><ref loc="ECC 3:13">Ekl 3:13</ref></char></note>wè sa ki bon?<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>Kenbe <note caller="+" style="x"><char style="xo" closed="false">34:13 </char><char style="xt" closed="false"><ref loc="PRO 13:3">Pwov 13:3</ref></char></note>lang ou apa de sa ki mal,</para>
  <para style="q1" vid="PSA 34:13">e lèv ou pou pa bay manti.<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>Kite sa ki mal la epi fè sa ki bon.</para>
  <para style="q1" vid="PSA 34:14">
    <note caller="+" style="x">
      <char style="xo" closed="false">34:14 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:16">És 1:16</ref>
      </char>
    </note>Chache lapè e fè efò pou twouve li.<verse eid="PSA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">34:15 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 36:7">Job 36:7</ref>
      </char>
    </note>Zye a SENYÈ a sou sila ki dwat yo.</para>
  <para style="q1" vid="PSA 34:15">Zòrèy Li koute kri yo.<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>Figi SENYÈ a kont malfektè yo,</para>
  <para style="q1" vid="PSA 34:16">pou <note caller="+" style="x"><char style="xo" closed="false">34:16 </char><char style="xt" closed="false"><ref loc="AMO 9:4">Am 9:4</ref></char></note>efase memwa yo sou tè a.<verse eid="PSA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">34:17 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:6">Sòm 34:6</ref>
      </char>
    </note>Moun dwat kriye.</para>
  <para style="q1" vid="PSA 34:17">SENYÈ a tande e vin delivre yo tout nan tout twoub yo.<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>SENYÈ a pre sila ak kè kase yo,</para>
  <para style="q1" vid="PSA 34:18">epi sove sila ki <note caller="+" style="x"><char style="xo" closed="false">34:18 </char><char style="xt" closed="false"><ref loc="ISA 57:15">És 57:15</ref></char></note>kraze nan lespri yo.<verse eid="PSA 34:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>Anpil, se <note caller="+" style="x"><char style="xo" closed="false">34:19 </char><char style="xt" closed="false"><ref loc="2TI 3:11">II Tim 3:11</ref></char></note>afliksyon a moun dwat la,</para>
  <para style="q1" vid="PSA 34:19">men SENYÈ a delivre li sòti nan yo tout.<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>Li konsève tout zo li yo.</para>
  <para style="q1" vid="PSA 34:20">
    <note caller="+" style="x">
      <char style="xo" closed="false">34:20 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:33-36">Jn 19:33-36</ref>
      </char>
    </note>Pa menm youn nan yo va kase.<verse eid="PSA 34:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>Se <note caller="+" style="x"><char style="xo" closed="false">34:21 </char><char style="xt" closed="false"><ref loc="PSA 94:23">Sòm 94:23</ref></char></note>mechanste ki va touye mechan an.</para>
  <para style="q1" vid="PSA 34:21">Sila ki rayi moun ladwati yo va kondane.<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>SENYÈ a rachte nanm a sèvitè Li yo.</para>
  <para style="q1" vid="PSA 34:22">P ap gen nan sila ki <note caller="+" style="x"><char style="xo" closed="false">34:22 </char><char style="xt" closed="false"><ref loc="PSA 37:40">Sòm 37:40</ref></char></note>kache nan Li yo</para>
  <para style="q1" vid="PSA 34:22">k ap kondane.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="d">Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>Fè fòs SENYÈ, kont sila k ap sèvi ak fòs kont mwen yo.</para>
  <para style="q1" vid="PSA 35:1">Goumen ak sila k ap <note caller="+" style="x"><char style="xo" closed="false">35:1 </char><char style="xt" closed="false"><ref loc="PSA 56:2">Sòm 56:2</ref></char></note>goumen kont mwen yo.<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>Pran an men boukliye ak pwotèj la,</para>
  <para style="q1" vid="PSA 35:2">epi leve kon <note caller="+" style="x"><char style="xo" closed="false">35:2 </char><char style="xt" closed="false"><ref loc="PSA 44:26">Sòm 44:26</ref></char></note>sekou mwen.<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>Anplis rale lans ak rach batay la pou</para>
  <para style="q1" vid="PSA 35:3">rankontre sila k ap kouri dèyè m yo.</para>
  <para style="q1" vid="PSA 35:3">Pale ak nanm mwen “Se Mwen ki delivrans ou”!<verse eid="PSA 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>Kite sila k ap chache lavi m yo vin wont e dezonere.</para>
  <para style="q1" vid="PSA 35:4">Kite sa yo ki anvizaje mal pou mwen</para>
  <para style="q1" vid="PSA 35:4">Vire do fè bak plen imiliyasyon.<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>Kite yo vin <note caller="+" style="x"><char style="xo" closed="false">35:5 </char><char style="xt" closed="false"><ref loc="PSA 83:13">Sòm 83:13</ref></char></note>tankou pay nan van,</para>
  <para style="q1" vid="PSA 35:5">avèk zanj SENYÈ a k ap pouse yo ale.<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">35:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 73:18">Sòm 73:18</ref>
      </char>
    </note>Kite wout yo plen avèk tenèb e vin glisan,</para>
  <para style="q1" vid="PSA 35:6">Avèk zanj SENYÈ a k ap kouri dèyè yo.<verse eid="PSA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>Paske san koz, yo te kache <note caller="+" style="x"><char style="xo" closed="false">35:7 </char><char style="xt" closed="false"><ref loc="PSA 9:15">Sòm 9:15</ref></char></note>pèlen yo pou mwen.</para>
  <para style="q1" vid="PSA 35:7">San koz, yo te fouye yon fòs pou nanm mwen.<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>Kite l <note caller="+" style="x"><char style="xo" closed="false">35:8 </char><char style="xt" closed="false"><ref loc="1TH 5:3">I Tes 5:3</ref></char></note>fin detwi nèt san l pa konnen.</para>
  <para style="q1" vid="PSA 35:8">Kite pèlen ke li te prepare a, kenbe li menm.</para>
  <para style="q1" vid="PSA 35:8">Kite l tonbe nan destriksyon sa a.<verse eid="PSA 35:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>Nanm mwen va rejwi nan SENYÈ a.</para>
  <para style="q1" vid="PSA 35:9">Li va <note caller="+" style="x"><char style="xo" closed="false">35:9 </char><char style="xt" closed="false"><ref loc="PSA 9:14">Sòm 9:14</ref></char></note>leve wo nan delivrans Li.<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>Tout zo m menm va di: “SENYÈ, se <note caller="+" style="x"><char style="xo" closed="false">35:10 </char><char style="xt" closed="false"><ref loc="EXO 15:11">Egz 15:11</ref></char></note>kilès ki tankou Ou menm?</para>
  <para style="q1" vid="PSA 35:10">Kilès ki delivre aflije yo nan men a sila ki twò fò pou li yo?</para>
  <para style="q1" vid="PSA 35:10">Wi, ak aflije e malere yo k ap soti</para>
  <para style="q1" vid="PSA 35:10">nan men a sila menm k ap vòlè yo?”<verse eid="PSA 35:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">35:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:12">Sòm 27:12</ref>
      </char>
    </note>Fo temwen sovaj yo leve.</para>
  <para style="q1" vid="PSA 35:11">Yo mande mwen bagay ke m pa menm konnen.<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>Yo <note caller="+" style="x"><char style="xo" closed="false">35:12 </char><char style="xt" closed="false"><ref loc="JER 18:20">Jr 18:20</ref></char></note>remèt mwen mal pou byen,</para>
  <para style="q1" vid="PSA 35:12">jiskaske gwo tristès antre nan nanm mwen.<verse eid="PSA 35:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>Men pou mwen menm, lè yo te malad,</para>
  <para style="q1" vid="PSA 35:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">35:13 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:11">Sòm 69:11</ref>
      </char>
    </note>rad mwen te vin twal sak;</para>
  <para style="q1" vid="PSA 35:13">Mwen te imilye nanm mwen nan fè jèn,</para>
  <para style="q1" vid="PSA 35:13">epi lapriyè m te kontinye retounen</para>
  <para style="q1" vid="PSA 35:13">nan kè m.<verse eid="PSA 35:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14"/>Mwen te ale toupatou konsi se te zanmi mwen, oswa frè mwen.</para>
  <para style="q1" vid="PSA 35:14">Mwen te <note caller="+" style="x"><char style="xo" closed="false">35:14 </char><char style="xt" closed="false"><ref loc="PSA 38:6">Sòm 38:6</ref></char></note>koube ak gwo tristès,</para>
  <para style="q1" vid="PSA 35:14">tankou yon moun ta fè dèy pou manman li.<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>Men moman ke m te chape tonbe a,</para>
  <para style="q1" vid="PSA 35:15">yo te <note caller="+" style="x"><char style="xo" closed="false">35:15 </char><char style="xt" closed="false"><ref loc="OBA 1:12">Ab 12</ref></char></note>rejwi, e te reyini yo ansanm.</para>
  <para style="q1" vid="PSA 35:15">San ke mwen pa menm konnen,</para>
  <para style="q1" vid="PSA 35:15">agresè sa yo te rasanble kont mwen.</para>
  <para style="q1" vid="PSA 35:15">Yo t ap chire m san rete.<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>Kon giyon vilgè, yo te <note caller="+" style="x"><char style="xo" closed="false">35:16 </char><char style="xt" closed="false"><ref loc="PSA 37:12">Sòm 37:12</ref></char></note>fè konsi yo</para>
  <para style="q1" vid="PSA 35:16">ta mòde m ak dan yo.<verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">35:17 </char><char style="xt" closed="false"><ref loc="HAB 1:13">Hab 1:13</ref></char></note>jiskilè Ou va kontinye</para>
  <para style="q1" vid="PSA 35:17">gade bagay sa a konsa?</para>
  <para style="q1" vid="PSA 35:17">Sove nanm mwen kont ravaj yo,</para>
  <para style="q1" vid="PSA 35:17">Sèl lavi mwen genyen kont lyon yo.<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">35:18 </char><char style="xt" closed="false"><ref loc="PSA 22:22">Sòm 22:22</ref></char></note>bay Ou remèsiman nan gran asanble a.</para>
  <para style="q1" vid="PSA 35:18">Mwen va bay Ou glwa pami yon gran foul.<verse eid="PSA 35:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>Pa kite sila ki lènmi m san koz yo, rejwi sou mwen.</para>
  <para style="q1" vid="PSA 35:19">Ni pa kite sila ki rayi mwen san koz yo, fè kout zye sou mwen.<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>Paske yo pa pale lapè,</para>
  <para style="q1" vid="PSA 35:20">men yo divize pawòl nan <note caller="+" style="x"><char style="xo" closed="false">35:20 </char><char style="xt" closed="false"><ref loc="JER 9:7">Jr 9:7</ref></char></note>twonpe sila ki kalm nan peyi yo.<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>Yo te ouvri bouch yo laj kont mwen.</para>
  <para style="q1" vid="PSA 35:21">Yo te di: <note caller="+" style="x"><char style="xo" closed="false">35:21 </char><char style="xt" closed="false"><ref loc="PSA 40:15">Sòm 40:15</ref> </char></note>“Men li, men li, zye nou te wè l!”<verse eid="PSA 35:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>Ou te wè sa, O SENYÈ, pa rete an silans</para>
  <para style="q1" vid="PSA 35:22">O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">35:22 </char><char style="xt" closed="false"><ref loc="PSA 10:1">Sòm 10:1</ref></char></note>pa rete lwen m.<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">35:23 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:6">Sòm 7:6</ref>
      </char>
    </note>Reveye Ou! Reveye Ou pou dwa m ak koz mwen,</para>
  <para style="q1" vid="PSA 35:23">Bondye mwen ak SENYÈ mwen.<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">35:24 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:4">Sòm 9:4</ref>
      </char>
    </note>Jije mwen, O SENYÈ, Bondye mwen an, selon dwati Ou.</para>
  <para style="q1" vid="PSA 35:24">Pa kite yo rejwi sou mwen.<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>Pa kite yo di nan kè yo:</para>
  <para style="q1" vid="PSA 35:25">“Men konsa, men sa nou pi pito a!”</para>
  <para style="q1" vid="PSA 35:25">Pa kite yo di: “Nou gen tan <note caller="+" style="x"><char style="xo" closed="false">35:25 </char><char style="xt" closed="false"><ref loc="PRO 1:12">Pwov 1:12</ref></char></note>fin vale li nèt!”<verse eid="PSA 35:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>Kite sila ki rejwi nan gwo twoub mwen yo wont.</para>
  <para style="q1" vid="PSA 35:26">Kite sila ki leve yo menm sou mwen yo vin abiye ak wont avèk imilyasyon.<verse eid="PSA 35:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>Kite sila ki vle wè kòz dwat mwen yo rele avèk jwa e rejwi.</para>
  <para style="q1" vid="PSA 35:27">Kite yo di tout tan: “Leve SENYÈ a wo,</para>
  <para style="q1" vid="PSA 35:27">Li ki <note caller="+" style="x"><char style="xo" closed="false">35:27 </char><char style="xt" closed="false"><ref loc="PSA 147:11">Sòm 147:11</ref> </char></note>pran plezi lè sèvitè li byen reyisi.”<verse eid="PSA 35:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>Konsa, lang mwen va deklare ladwati Ou</para>
  <para style="q1" vid="PSA 35:28">avèk lwanj Ou tout lajounen.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="d">Pou direktè koral la; Yon Sòm David, sèvitè SENYÈ a</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>Se Peche ki pale nan fon kè a lòm ki san Bondye.</para>
  <para style="q1" vid="PSA 36:1">Nanpwen <note caller="+" style="x"><char style="xo" closed="false">36:1 </char><char style="xt" closed="false"><ref loc="ROM 3:18">Wo 3:18</ref></char></note>krent Bondye devan zye l.<verse eid="PSA 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>Jan li kontan ak pwòp tèt li,</para>
  <para style="q1" vid="PSA 36:2">li pa janm wè pwop peche pa l la.<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">36:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:7">Sòm 10:7</ref>
      </char>
    </note>Pawòl a bouch li se mechanste avèk manti.</para>
  <para style="q1" vid="PSA 36:3">Li fè yon chemen ki pa bon.<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>Sou kabann li, li fè plan mechan;</para>
  <para style="q1" vid="PSA 36:4">Li antre nan yon wout ki p ap sòti byen;</para>
  <para style="q1" vid="PSA 36:4">Li <note caller="+" style="x"><char style="xo" closed="false">36:4 </char><char style="xt" closed="false"><ref loc="ROM 12:9">Wo 12:9</ref></char></note>pa rayi mal.<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">36:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:10">Sòm 57:10</ref>
      </char>
    </note>Lanmou dous Ou, O SENYÈ, rive jis nan syèl yo,</para>
  <para style="q1" vid="PSA 36:5">fidelite Ou nan syèl la.<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>Ladwati Ou se tankou mòn Bondye yo,</para>
  <para style="q1" vid="PSA 36:6">e<note caller="+" style="x"><char style="xo" closed="false">36:6 </char><char style="xt" closed="false"><ref loc="ROM 11:33">Wo 11:33</ref></char></note>jijman Ou yo tankou yon gran pwofondè.</para>
  <para style="q1" vid="PSA 36:6">O SENYÈ, Ou prezève ni lòm, ni bèt.<verse eid="PSA 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>Lanmou dous Ou chè, O Bondye!</para>
  <para style="q1" vid="PSA 36:7">Pitit a lòm yo <note caller="+" style="x"><char style="xo" closed="false">36:7 </char><char style="xt" closed="false"><ref loc="RUT 2:12">Rt 2:12</ref></char></note>pran azil anba lonbraj zèl Ou.<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>Yo <note caller="+" style="x"><char style="xo" closed="false">36:8 </char><char style="xt" closed="false"><ref loc="ISA 25:6">És 25:6</ref></char></note>bwè jiskaske yo vin plen an abondans lakay Ou.</para>
  <para style="q1" vid="PSA 36:8">Konsa,Ou bay yo bwè nan rivyè plezi Ou yo.<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>Paske avèk Ou, se <note caller="+" style="x"><char style="xo" closed="false">36:9 </char><char style="xt" closed="false"><ref loc="JER 2:13">Jr 2:13</ref></char></note>fontèn dlo lavi a.</para>
  <para style="q1" vid="PSA 36:9">Nan limyè pa Ou a, nou wè limyè.<verse eid="PSA 36:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>O bay toujou lanmou dous Ou a pou sila ki konnen Ou yo,</para>
  <para style="q1" vid="PSA 36:10">ak <note caller="+" style="x"><char style="xo" closed="false">36:10 </char><char style="xt" closed="false"><ref loc="PSA 24:5">Sòm 24:5</ref></char></note>ladwati Ou pou sila ki dwat nan kè yo.<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>Pa kite pye ògèy vini sou mwen,</para>
  <para style="q1" vid="PSA 36:11">ni pa kite men a mechan yo chase mwen ale.<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>Se la <note caller="+" style="x"><char style="xo" closed="false">36:12 </char><char style="xt" closed="false"><ref loc="PSA 140:10">Sòm 140:10</ref></char></note>sila k ap fè inikite yo gen tan fin tonbe.</para>
  <para style="q1" vid="PSA 36:12">Yo te peze desann ak fòs, e yo p ap kab leve ankò.<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="d">Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>Pa twouble tèt ou akoz mechan yo. Pa vin <note caller="+" style="x"><char style="xo" closed="false">37:1 </char><char style="xt" closed="false"><ref loc="PSA 73:3">Sòm 73:3</ref></char></note>pote lanvi pou malfektè yo.<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>Paske yo va <note caller="+" style="x"><char style="xo" closed="false">37:2 </char><char style="xt" closed="false"><ref loc="JOB 14:2">Job 14:2</ref></char></note>fennen vit tankou zèb chan,</para>
  <para style="q1" vid="PSA 37:2">e disparèt tankou zèb ki vèt.<verse eid="PSA 37:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>Mete konfyans ou nan SENYÈ a, e fè sa ki bon.</para>
  <para style="q1" vid="PSA 37:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">37:3 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 34:13-14">Éz 34:13-14</ref>
      </char>
    </note>Demere nan peyi a e kiltive nan bon tè.<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>Pran plezi ou nan SENYÈ a.</para>
  <para style="q1" vid="PSA 37:4">Konsa, Li va <note caller="+" style="x"><char style="xo" closed="false">37:4 </char><char style="xt" closed="false"><ref loc="PSA 145:19">Sòm 145:19</ref></char></note>bay ou tout dezi a kè ou.<verse eid="PSA 37:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">37:5 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:3">Pwov 16:3</ref>
      </char>
    </note>Dedye chemen ou a SENYÈ a.</para>
  <para style="q1" vid="PSA 37:5">Mete konfyans nan Li, e sa L ap fè:<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>Li va mennen fè parèt ladwati ou kon limyè,</para>
  <para style="q1" vid="PSA 37:6">Ak jijman ou klere <note caller="+" style="x"><char style="xo" closed="false">37:6 </char><char style="xt" closed="false"><ref loc="JOB 11:17">Job 11:17</ref> </char></note>kon midi.<verse eid="PSA 37:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>Pran repo nan SENYÈ a, e <note caller="+" style="x"><char style="xo" closed="false">37:7 </char><char style="xt" closed="false"><ref loc="PSA 40:1">Sòm 40:1</ref></char></note>tann Li ak pasyans;</para>
  <para style="q1" vid="PSA 37:7">Pa twouble ou akoz sila ki reyisi nan chemen li an,</para>
  <para style="q1" vid="PSA 37:7">Akoz nonm nan ki reyisi fè manèv mechan li yo.<verse eid="PSA 37:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>Sispann fache pou l pa mennen ou nan fè mal.</para>
  <para style="q1" vid="PSA 37:8">Pa kite kè ou twouble; l ap mennen ou nan mechanste<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">37:9 </char><char style="xt" closed="false"><ref loc="PSA 37:2-22">Sòm 37:2-22</ref></char></note>malfektè yo va koupe retire nèt,</para>
  <para style="q1" vid="PSA 37:9">men sila k ap tann SENYÈ yo,</para>
  <para style="q1" vid="PSA 37:9">va vin genyen peyi a kon eritaj yo.<verse eid="PSA 37:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>Men yon <note caller="+" style="x"><char style="xo" closed="false">37:10 </char><char style="xt" closed="false"><ref loc="JOB 24:24">Job 24:24</ref></char></note>ti tan ankò, mechan an va disparèt.</para>
  <para style="q1" vid="PSA 37:10">Ou va chache avèk atansyon plas li,</para>
  <para style="q1" vid="PSA 37:10">men li p ap egziste.<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="MAT 5:5">Mat 5:5</ref></char></note>enb yo va fè eritaj peyi a.</para>
  <para style="q1" vid="PSA 37:11">Yo va pran plezi yo nan reyisi anpil.<verse eid="PSA 37:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>Mechan an <note caller="+" style="x"><char style="xo" closed="false">37:12 </char><char style="xt" closed="false"><ref loc="PSA 31:13-20">Sòm 31:13-20</ref></char></note>fè konplo kont sila ki dwat yo.</para>
  <para style="q1" vid="PSA 37:12">Li manje dan l sou li.<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>SENYÈ a ri sou li, paske Li wè ke <note caller="+" style="x"><char style="xo" closed="false">37:13 </char><char style="xt" closed="false"><ref loc="1SA 26:10">I Sam 26:10</ref> </char></note>jou li a ap rive.<verse eid="PSA 37:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>Mechan yo rale nepe e <note caller="+" style="x"><char style="xo" closed="false">37:14 </char><char style="xt" closed="false"><ref loc="LAM 2:4">Lam 2:4</ref></char></note>koube banza yo,</para>
  <para style="q1" vid="PSA 37:14">pou jete aflije yo avèk malere a,</para>
  <para style="q1" vid="PSA 37:14">pou touye sila ki dwat nan kondwit yo.<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>Nepe yo va antre nan pwòp kè yo.</para>
  <para style="q1" vid="PSA 37:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">37:15 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:4">I Sam 2:4</ref>
      </char>
    </note>Banza yo ap kase.<verse eid="PSA 37:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">37:16 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:16">Pwov 15:16</ref>
      </char>
    </note>Pi bon se ti kras a moun dwat yo,</para>
  <para style="q1" vid="PSA 37:16">pase abondans anpil a mechan yo.<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>Paske bra a mechan yo va kase,</para>
  <para style="q1" vid="PSA 37:17">men SENYÈ a va ranfòse moun dwat yo.<verse eid="PSA 37:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">37:18 </char><char style="xt" closed="false"><ref loc="PSA 1:6">Sòm 1:6</ref></char></note>konnen jou a sila ki dwat yo.</para>
  <para style="q1" vid="PSA 37:18">Eritaj yo va dire jis pou tout tan.<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>Yo p ap wont nan move tan.</para>
  <para style="q1" vid="PSA 37:19">Nan <note caller="+" style="x"><char style="xo" closed="false">37:19 </char><char style="xt" closed="false"><ref loc="JOB 5:20">Job 5:20</ref></char></note>jou gwo grangou yo, y ap jwenn kont.<verse eid="PSA 37:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>Men mechan yo va peri.</para>
  <para style="q1" vid="PSA 37:20">Lènmi a SENYÈ a, tankou laglwa a bèl chan yo.</para>
  <para style="q1" vid="PSA 37:20">Yo va vin disparèt.</para>
  <para style="q1" vid="PSA 37:20">Tankou <note caller="+" style="x"><char style="xo" closed="false">37:20 </char><char style="xt" closed="false"><ref loc="PSA 68:2">Sòm 68:2</ref> </char></note>lafimen,</para>
  <para style="q1" vid="PSA 37:20">yo ale nèt.<verse eid="PSA 37:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>Mechan an prete, men li pa remèt,</para>
  <para style="q1" vid="PSA 37:21">men moun dwat la <note caller="+" style="x"><char style="xo" closed="false">37:21 </char><char style="xt" closed="false"><ref loc="PSA 112:5-9">Sòm 112:5-9</ref></char></note>ranpli ak gras pou l ka bay an abondans.<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>Paske sila ke Bondye beni yo, va <note caller="+" style="x"><char style="xo" closed="false">37:22 </char><char style="xt" closed="false"><ref loc="PRO 3:33">Pwov 3:33</ref></char></note>eritye peyi a,</para>
  <para style="q1" vid="PSA 37:22">men sila ke Li modi yo, va vin koupe retire nèt.<verse eid="PSA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">37:23 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:9">I Sam 2:9</ref>
      </char>
    </note>Pa a yon nonm etabli pa SENYÈ a.</para>
  <para style="q1" vid="PSA 37:23">Konsa, Li pran plezi nan chemen li.<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>Lè <note caller="+" style="x"><char style="xo" closed="false">37:24 </char><char style="xt" closed="false"><ref loc="PRO 24:15">Pwov 24:15</ref></char></note>li tonbe, li p ap voye tèt anba nèt,</para>
  <para style="q1" vid="PSA 37:24">paske SENYÈ a se Sila ki kenbe men li an.<verse eid="PSA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>Mwen te jèn e koulye a, mwen fin granmoun,</para>
  <para style="q1" vid="PSA 37:25">men <note caller="+" style="x"><char style="xo" closed="false">37:25 </char><char style="xt" closed="false"><ref loc="HEB 13:5">Eb 13:5</ref></char></note>mwen poko wè moun dwat ki abandone,</para>
  <para style="q1" vid="PSA 37:25">ni desandan li yo k ap mande pen.<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>Tout lajounen, <note caller="+" style="x"><char style="xo" closed="false">37:26 </char><char style="xt" closed="false"><ref loc="DEU 15:8">Det 15:8</ref></char></note> moun dwat la</para>
  <para style="q1" vid="PSA 37:26">plen ak gras pou prete moun.</para>
  <para style="q1" vid="PSA 37:26">Desandan li yo se yon benediksyon.<verse eid="PSA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>Kite mal e fè sa ki bon,</para>
  <para style="q1" vid="PSA 37:27">pou ou kab viv <note caller="+" style="x"><char style="xo" closed="false">37:27 </char><char style="xt" closed="false"><ref loc="PSA 102:28">Sòm 102:28</ref> </char></note>jis pou tout tan.<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>Paske SENYÈ a renmen jistis,</para>
  <para style="q1" vid="PSA 37:28">e li pa abandone fidèl li yo.</para>
  <para style="q1" vid="PSA 37:28">Yo prezève pou tout tan,</para>
  <para style="q1" vid="PSA 37:28">men mechan yo va vin koupe retire nèt.<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>Moun ladwati yo va <note caller="+" style="x"><char style="xo" closed="false">37:29 </char><char style="xt" closed="false"><ref loc="PSA 37:9">Sòm 37:9</ref></char></note>eritye peyi a,</para>
  <para style="q1" vid="PSA 37:29">pou viv ladann pou tout tan.<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>Bouch a moun dwat yo va eksprime sajès,</para>
  <para style="q1" vid="PSA 37:30">epi lang li va <note caller="+" style="x"><char style="xo" closed="false">37:30 </char><char style="xt" closed="false"><ref loc="PSA 119:13">Sòm 119:13</ref> </char></note>pale jistis.<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">37:31 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:6">Det 6:6</ref>
      </char>
    </note>Lalwa Bondye nan kè li.</para>
  <para style="q1" vid="PSA 37:31">Pa li yo pa janm glise.<verse eid="PSA 37:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>Mechan an ap veye dwat la</para>
  <para style="q1" vid="PSA 37:32">pou <note caller="+" style="x"><char style="xo" closed="false">37:32 </char><char style="xt" closed="false"><ref loc="PSA 37:14">Sòm 37:14</ref></char></note>chache touye li.<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>SENYÈ a p ap kite l lantre nan men li,</para>
  <para style="q1" vid="PSA 37:33">ni <note caller="+" style="x"><char style="xo" closed="false">37:33 </char><char style="xt" closed="false"><ref loc="PSA 34:22">Sòm 34:22</ref></char></note>kite li kondane lè li jije.<verse eid="PSA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>Tann SENYÈ a e kenbe chemen Li an.</para>
  <para style="q1" vid="PSA 37:34">Konsa, Li va leve ou wo pou eritye peyi a.</para>
  <para style="q1" vid="PSA 37:34">Lè <note caller="+" style="x"><char style="xo" closed="false">37:34 </char><char style="xt" closed="false"><ref loc="PSA 52:5-6">Sòm 52:5-6</ref></char></note>mechan yo koupe retire, ou va gen tan wè l.<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>Mwen konn <note caller="+" style="x"><char style="xo" closed="false">37:35 </char><char style="xt" closed="false"><ref loc="JOB 5:3">Job 5:3</ref></char></note>wè yon nonm mechan e vyolan</para>
  <para style="q1" vid="PSA 37:35">Ki gaye kò l tankou yon gwo pyebwa nan tè peyi natal li.<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>Konsa, li mouri nèt, e vwala, li <note caller="+" style="x"><char style="xo" closed="false">37:36 </char><char style="xt" closed="false"><ref loc="JOB 20:5">Job 20:5</ref></char></note>pa t la ankò.</para>
  <para style="q1" vid="PSA 37:36">Mwen te chache li, men li pa t kab twouve.<verse eid="PSA 37:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>Byen remake nonm san tò a,</para>
  <para style="q1" vid="PSA 37:37">epi gade byen nonm ladwati a,</para>
  <para style="q1" vid="PSA 37:37">paske nonm lapè a va gen <note caller="+" style="x"><char style="xo" closed="false">37:37 </char><char style="xt" closed="false"><ref loc="ISA 57:1-2">És 57:1-2</ref></char></note>posterite.<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>Men pechè a va detwi nèt.</para>
  <para style="q1" vid="PSA 37:38">Posterite a mechan an va <note caller="+" style="x"><char style="xo" closed="false">37:38 </char><char style="xt" closed="false"><ref loc="PSA 37:9">Sòm 37:9</ref></char></note>koupe retire nèt.<verse eid="PSA 37:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>Men <note caller="+" style="x"><char style="xo" closed="false">37:39 </char><char style="xt" closed="false"><ref loc="PSA 3:8">Sòm 3:8</ref></char></note>delivrans a moun dwat yo soti nan SENYÈ a.</para>
  <para style="q1" vid="PSA 37:39">Se Li menm ki fòs yo nan tan twoub la.<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>SENYÈ a ede yo e delivre yo.</para>
  <para style="q1" vid="PSA 37:40">Li delivre yo soti nan men mechan yo e sove yo.</para>
  <para style="q1" vid="PSA 37:40">Li sove yo, akoz se nan Li ke yo <note caller="+" style="x"><char style="xo" closed="false">37:40 </char><char style="xt" closed="false"><ref loc="1CH 5:20">I Kwo 5:20</ref> </char></note>kache.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="d">Youn Sòm David; tankou yon sonj memorab</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">38:1 </char><char style="xt" closed="false"><ref loc="PSA 6:1">Sòm 6:1</ref></char></note>pa repwoche mwen nan kòlè Ou,</para>
  <para style="q1" vid="PSA 38:1">ni fè m chatiman nan kòlè Ou k ap brile.<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>Paske <note caller="+" style="x"><char style="xo" closed="false">38:2 </char><char style="xt" closed="false"><ref loc="JOB 6:4">Job 6:4</ref></char></note>flèch Ou yo fin antre fon anndan m,</para>
  <para style="q1" vid="PSA 38:2">epi men Ou fin peze m.<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">38:3 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:6">És 1:6</ref>
      </char>
    </note>Nanpwen anyen ki ansante nan chè m,</para>
  <para style="q1" vid="PSA 38:3">akoz endiyasyon Ou.</para>
  <para style="q1" vid="PSA 38:3">Nanpwen lasante nan zo m yo</para>
  <para style="q1" vid="PSA 38:3">akoz peche mwen.<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>Paske <note caller="+" style="x"><char style="xo" closed="false">38:4 </char><char style="xt" closed="false"><ref loc="EZR 9:6">Esd 9:6</ref></char></note>inikite mwen yo fin monte sou tèt mwen.</para>
  <para style="q1" vid="PSA 38:4">Tankou yon fado lou, yo peze twòp pou mwen.<verse eid="PSA 38:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>Blesi mwen yo vin santi e anfle akoz <note caller="+" style="x"><char style="xo" closed="false">38:5 </char><char style="xt" closed="false"><ref loc="PSA 69:5">Sòm 69:5</ref></char></note>foli mwen.<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>Mwen fin koube nèt e <note caller="+" style="x"><char style="xo" closed="false">38:6 </char><char style="xt" closed="false"><ref loc="PSA 35:14">Sòm 35:14</ref></char></note>bese anpil.</para>
  <para style="q1" vid="PSA 38:6">Mwen ap fè doulè tout lajounen.<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>Paske ren mwen plen ak <note caller="+" style="x"><char style="xo" closed="false">38:7 </char><char style="xt" closed="false"><ref loc="PSA 102:3">Sòm 102:3</ref></char></note>brile.</para>
  <para style="q1" vid="PSA 38:7">Nanpwen anyen ansante nan chè m.<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">38:8 </char><char style="xt" closed="false"><ref loc="LAM 1:13-20">Lam 1:13-20</ref></char></note>pa kab santi anyen ankò.</para>
  <para style="q1" vid="PSA 38:8">Mwen fin kraze nèt.</para>
  <para style="q1" vid="PSA 38:8">Vwa m plenyen akoz kè m ajite.<verse eid="PSA 38:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>SENYÈ, tout volonte m devan Ou.</para>
  <para style="q1" vid="PSA 38:9">Tout <note caller="+" style="x"><char style="xo" closed="false">38:9 </char><char style="xt" closed="false"><ref loc="PSA 6:5">Sòm 6:5</ref> </char></note>plent a vwa m yo pa kache a Ou menm.<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>Kè m bat fò, <note caller="+" style="x"><char style="xo" closed="false">38:10 </char><char style="xt" closed="false"><ref loc="PSA 31:10">Sòm 31:10</ref></char></note>fòs mwen kite m.</para>
  <para style="q1" vid="PSA 38:10">Menm limyè a zye m, menm sa fin kite mwen.<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>Pwòch mwen yo avèk zanmi mwen yo</para>
  <para style="q1" vid="PSA 38:11">kanpe nan distans akoz touman m.</para>
  <para style="q1" vid="PSA 38:11">Fanmi m yo <note caller="+" style="x"><char style="xo" closed="false">38:11 </char><char style="xt" closed="false"><ref loc="LUK 23:49">Luc 23:49</ref></char></note>kanpe byen lwen.<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>Sila ki chache lavi m yo, ap prepare pyèj yo pou mwen.</para>
  <para style="q1" vid="PSA 38:12">Sila ki chache fè m donmaj yo ap fè menas destriksyon.</para>
  <para style="q1" vid="PSA 38:12">Y ap manniganse trayizon tout lajounen.<verse eid="PSA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>Men mwen menm, tankou yon moun mouri,</para>
  <para style="q1" vid="PSA 38:13">mwen pa tande;</para>
  <para style="q1" vid="PSA 38:13">Epi se tankou yon bèbè, ki pa ouvri bouch li.<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>Wi, mwen tankou yon nonm ki pa tande.</para>
  <para style="q1" vid="PSA 38:14">E nan bouch mwen, pa gen repons.<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>Paske mwen mete espwa m nan Ou, O SENYÈ.</para>
  <para style="q1" vid="PSA 38:15">Ou <note caller="+" style="x"><char style="xo" closed="false">38:15 </char><char style="xt" closed="false"><ref loc="PSA 17:6">Sòm 17:6</ref></char></note>va reponn, O SENYÈ, Bondye mwen an.<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>Paske mwen te di: “Ke yo pa vin rejwi sou mwen.</para>
  <para style="q1" vid="PSA 38:16">Pou lè pye m chape, pou yo <note caller="+" style="x"><char style="xo" closed="false">38:16 </char><char style="xt" closed="false"><ref loc="PSA 35:26">Sòm 35:26</ref></char></note>ta vante tèt yo kont mwen.”<verse eid="PSA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>Paske mwen prèt pou tonbe.</para>
  <para style="q1" vid="PSA 38:17">
    <note caller="+" style="x">
      <char style="xo" closed="false">38:17 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 13:2">Sòm 13:2</ref>
      </char>
    </note>Tristès mwen devan m tout tan.<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>Konsa, mwen konfese inikite mwen.</para>
  <para style="q1" vid="PSA 38:18">Mwen ranpli avèk <note caller="+" style="x"><char style="xo" closed="false">38:18 </char><char style="xt" closed="false"><ref loc="2CO 7:9-10">II Kor 7:9-10</ref> </char></note>regrè akoz peche m.<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>Men lènmi m yo plen kouraj e fò.</para>
  <para style="q1" vid="PSA 38:19">Yo anpil ki <note caller="+" style="x"><char style="xo" closed="false">38:19 </char><char style="xt" closed="false"><ref loc="PSA 35:19">Sòm 35:19</ref></char></note>rayi mwen san koz.<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>Sila ki remèt mal pou byen yo</para>
  <para style="q1" vid="PSA 38:20">se lènmi m akoz mwen swiv sa ki bon.<verse eid="PSA 38:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>Pa abandone m, O SENYÈ.</para>
  <para style="q1" vid="PSA 38:21">O Bondye m nan, <note caller="+" style="x"><char style="xo" closed="false">38:21 </char><char style="xt" closed="false"><ref loc="PSA 22:19">Sòm 22:19</ref></char></note>pa rete lwen m!<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>Fè vit pou ede mwen,</para>
  <para style="q1" vid="PSA 38:22">O SENYÈ, delivrans mwen an!<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="d">Pou direktè koral la. Pou Jeduthyèn. Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>Mwen te di, mwen va veye chemen mwen,</para>
  <para style="q1" vid="PSA 39:1">pou m pa <note caller="+" style="x"><char style="xo" closed="false">39:1 </char><char style="xt" closed="false"><ref loc="JOB 2:10">Job 2:10</ref></char></note>fè peche ak lang mwen.</para>
  <para style="q1" vid="PSA 39:1">Mwen va veye bouch mwen,</para>
  <para style="q1" vid="PSA 39:1">konsi li gen yon brid ladann</para>
  <para style="q1" vid="PSA 39:1">toutotan mechan yo rete nan prezans mwen.<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">39:2 </char><char style="xt" closed="false"><ref loc="PSA 38:13">Sòm 38:13</ref></char></note>tankou bèbè e mwen te rete an silans.</para>
  <para style="q1" vid="PSA 39:2">Mwen te evite menm sa ki ta kab bon.</para>
  <para style="q1" vid="PSA 39:2">Konsa, tristès mwen te vin pi mal.<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">39:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:4">Sòm 32:4</ref>
      </char>
    </note>Kè m te cho anndan m.</para>
  <para style="q1" vid="PSA 39:3">Pandan mwen t ap reflechi dife a t ap brile.</para>
  <para style="q1" vid="PSA 39:3">Konsa, mwen te pale ak lang mwen:<verse eid="PSA 39:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>SENYÈ, fè m konnen <note caller="+" style="x"><char style="xo" closed="false">39:4 </char><char style="xt" closed="false"><ref loc="JOB 6:11">Job 6:11</ref></char></note>longè a jou mwen yo.</para>
  <para style="q1" vid="PSA 39:4">Fè m konnen ke m fèb anpil.<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>Gade byen, Ou te fè jou mwen yo kontwole</para>
  <para style="q1" vid="PSA 39:5">tankou lajè a men m ki louvri.</para>
  <para style="q1" vid="PSA 39:5">Lavi mwen konsi li pa anyen devan zye Ou.</para>
  <para style="q1" vid="PSA 39:5">Anverite, lavi chak moun, <note caller="+" style="x"><char style="xo" closed="false">39:5 </char><char style="xt" closed="false"><ref loc="PSA 89:47">Sòm 89:47</ref></char></note>se yon sèl grenn souf.<verse eid="PSA 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>Anverite, tout moun mache toupatou tankou yon lonbraj.</para>
  <para style="q1" vid="PSA 39:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">39:6 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 7:31">I Kor 7:31</ref>
      </char>
    </note>Anverite, yo fè gwo zen pou ryen.</para>
  <para style="q1" vid="PSA 39:6">Li ranmase byen yo, men l pa konnen kilès k ap rasanble yo.<verse eid="PSA 39:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>Konsa, SENYÈ, kisa m ap tann nan?</para>
  <para style="q1" vid="PSA 39:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">39:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:15">Sòm 38:15</ref>
      </char>
    </note>Espwa m se nan Ou.<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">39:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 51:9-14">Sòm 51:9-14</ref>
      </char>
    </note>Delivre mwen de tout transgresyon mwen yo.</para>
  <para style="q1" vid="PSA 39:8">Pa fè m repwòch a moun san sajès yo.<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>Mwen tounen tibebe.</para>
  <para style="q1" vid="PSA 39:9">Mwen pa ouvri bouch mwen,</para>
  <para style="q1" vid="PSA 39:9">akoz se <note caller="+" style="x"><char style="xo" closed="false">39:9 </char><char style="xt" closed="false"><ref loc="2SA 16:10">II Sam 16:10</ref></char></note>Ou ki te fè sa.<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">39:10 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 9:34">Job 9:34</ref>
      </char>
    </note>Rete touman Ou sou mwen.</para>
  <para style="q1" vid="PSA 39:10">Kou men Ou venk mwen.</para>
  <para style="q1" vid="PSA 39:10">M ap peri.<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>Avèk repwòch, Ou fè chatiman</para>
  <para style="q1" vid="PSA 39:11">a yon nonm pou inikite li.</para>
  <para style="q1" vid="PSA 39:11">Ou <note caller="+" style="x"><char style="xo" closed="false">39:11 </char><char style="xt" closed="false"><ref loc="JOB 13:28">Job 13:28</ref></char></note>manje tankou mit nan rad sa ki konsidere</para>
  <para style="q1" vid="PSA 39:11">pi chè pou li menm nan.</para>
  <para style="q1" vid="PSA 39:11">Anverite, tout moun se sèlman yon souf.<verse eid="PSA 39:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>Tande lapriyè mwen, O SENYÈ e</para>
  <para style="q1" vid="PSA 39:12">prete zòrèy Ou a kri mwen.</para>
  <para style="q1" vid="PSA 39:12">Pa rete an silans lè dlo ap koule nan zye m.</para>
  <para style="q1" vid="PSA 39:12">Paske mwen se yon etranje devan Ou,</para>
  <para style="q1" vid="PSA 39:12">yon vwayajè tankou tout papa zansèt mwen yo.<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">39:13 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 7:19">Job 7:19</ref>
      </char>
    </note>Vire rega figi Ou lwen m, pou m kab ri ankò,</para>
  <para style="q1" vid="PSA 39:13">avan ke m mouri pou m pa la ankò.”<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="d">Pou direktè koral la; Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">40:1 </char><char style="xt" closed="false"><ref loc="PSA 25:5">Sòm 25:5</ref></char></note>tann avèk pasyans SENYÈ a.</para>
  <para style="q1" vid="PSA 40:1">Li te enkline vè mwen e te tande kri mwen.<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>Li te mennen mwen sòti nan fòs k ap detwi a,</para>
  <para style="q1" vid="PSA 40:2">sòti deyò gwo ma ajil la.</para>
  <para style="q1" vid="PSA 40:2">Li te mete pye m sou wòch la e</para>
  <para style="q1" vid="PSA 40:2">te <note caller="+" style="x"><char style="xo" closed="false">40:2 </char><char style="xt" closed="false"><ref loc="PSA 37:23">Sòm 37:23</ref></char></note>fè m kanpe byen fèm.<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>Li te mete yon <note caller="+" style="x"><char style="xo" closed="false">40:3 </char><char style="xt" closed="false"><ref loc="PSA 32:7">Sòm 32:7</ref></char></note>chanson nèf nan bouch mwen,</para>
  <para style="q1" vid="PSA 40:3">yon chan lwanj Bondye nou an.</para>
  <para style="q1" vid="PSA 40:3">Anpil moun va wè, vin gen lakrent e va</para>
  <para style="q1" vid="PSA 40:3">mete konfyans nan Bondye.<verse eid="PSA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>A la <note caller="+" style="x"><char style="xo" closed="false">40:4 </char><char style="xt" closed="false"><ref loc="PSA 34:8">Sòm 34:8</ref></char></note>beni se nonm ki mete konfyans li nan SENYÈ a,</para>
  <para style="q1" vid="PSA 40:4">e ki pa t vire vè moun ògèy yo,</para>
  <para style="q1" vid="PSA 40:4">ni a sila ki vin vire nan sa ki fo yo.<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>Anpil, O SENYÈ Bondye mwen an,</para>
  <para style="q1" vid="PSA 40:5">se <note caller="+" style="x"><char style="xo" closed="false">40:5 </char><char style="xt" closed="false"><ref loc="JOB 5:9">Job 5:9</ref></char></note>mèvèy ke Ou te fè yo,</para>
  <para style="q1" vid="PSA 40:5">ak panse Ou yo anvè nou.</para>
  <para style="q1" vid="PSA 40:5">Nanpwen ki kab konpare avèk Ou.</para>
  <para style="q1" vid="PSA 40:5">Si m ta deklare yo e pale sou yo tout,</para>
  <para style="q1" vid="PSA 40:5">yo ta vin twòp pou m ta kab konte.<verse eid="PSA 40:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">40:6 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 15:22">I Sam 15:22</ref>
      </char>
    </note>Sakrifis avèk ofrann sereyal,</para>
  <para style="q1" vid="PSA 40:6">Ou pa t dezire yo.</para>
  <para style="q1" vid="PSA 40:6">Ou te ouvri zòrèy mwen.</para>
  <para style="q1" vid="PSA 40:6">Ofrann brile avèk ofrann peche yo,</para>
  <para style="q1" vid="PSA 40:6">Ou pa t mande yo.<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>Konsa mwen te di: “Gade byen, mwen vini.</para>
  <para style="q1" vid="PSA 40:7">Nan woulo liv la, li ekri de mwen menm.<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">40:8 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:34">Jn 4:34</ref>
      </char>
    </note>Mwen pran plezi nan fè volonte pa Ou, O SENYÈ.</para>
  <para style="q1" vid="PSA 40:8">Lalwa Ou nan kè m.”<verse eid="PSA 40:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">40:9 </char><char style="xt" closed="false"><ref loc="PSA 22:22">Sòm 22:22</ref></char></note>pwoklame bòn nouvèl ladwati yo nan gran asanble a;</para>
  <para style="q1" vid="PSA 40:9">Gade byen, mwen p ap anpeche lèv mwen;</para>
  <para style="q1" vid="PSA 40:9">O SENYÈ, Ou konnen.<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>Mwen pa t kache ladwati Ou anndan kè m.</para>
  <para style="q1" vid="PSA 40:10">Mwen te pale selon fidelite Ou, avèk sali Ou.</para>
  <para style="q1" vid="PSA 40:10">Mwen pa t kache lanmou dous Ou avèk</para>
  <para style="q1" vid="PSA 40:10">verite Ou devan gran asanble a.<verse eid="PSA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>Ou menm O SENYÈ, p ap refize mwen.</para>
  <para style="q1" vid="PSA 40:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">40:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 43:3">Sòm 43:3</ref>
      </char>
    </note>Lanmou dous Ou avèk verite Ou va</para>
  <para style="q1" vid="PSA 40:11">prezève mwen tout tan.<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>Paske malè ki depase kontwòl yo te antoure mwen.</para>
  <para style="q1" vid="PSA 40:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">40:12 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:4">Sòm 38:4</ref>
      </char>
    </note>Inikite mwen yo te fin pran m nèt</para>
  <para style="q1" vid="PSA 40:12">jiskaske mwen pa t kab wè.</para>
  <para style="q1" vid="PSA 40:12">Yo plis pase cheve sou tèt mwen.</para>
  <para style="q1" vid="PSA 40:12">Kè m fin fè fayit.<verse eid="PSA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">40:13 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:19">Sòm 22:19</ref>
      </char>
    </note>Fè l plezi Ou, O SENYÈ, pou delivre mwen.</para>
  <para style="q1" vid="PSA 40:13">Fè vit, O SENYÈ, pou ede mwen.<verse eid="PSA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>Kite sila yo vin wont e imilye ansanm,</para>
  <para style="q1" vid="PSA 40:14">sila ki <note caller="+" style="x"><char style="xo" closed="false">40:14 </char><char style="xt" closed="false"><ref loc="PSA 63:9">Sòm 63:9</ref></char></note>chache lavi mwen pou detwi li.</para>
  <para style="q1" vid="PSA 40:14">Kite sila yo vire fè bak e dezonore,</para>
  <para style="q1" vid="PSA 40:14">sila ki pran plezi nan fè m mal yo.<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>Kite sila yo etone nèt akoz wont yo,</para>
  <para style="q1" vid="PSA 40:15">sila ki <note caller="+" style="x"><char style="xo" closed="false">40:15 </char><char style="xt" closed="false"><ref loc="PSA 35:21">Sòm 35:21</ref></char></note>di mwen: “Wayan, wayan!”<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>Kite tout sila ki wè Ou yo rejwi e</para>
  <para style="q1" vid="PSA 40:16">fè kè kontan nan Ou.</para>
  <para style="q1" vid="PSA 40:16">Kite tout sila ki renmen sali Ou yo</para>
  <para style="q1" vid="PSA 40:16">
    <note caller="+" style="x">
      <char style="xo" closed="false">40:16 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:27">Sòm 35:27</ref>
      </char>
    </note>pale tout tan: “Ke SENYÈ a kapab</para>
  <para style="q1" vid="PSA 40:16">leve wo!”<verse eid="PSA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>Akoz mwen aflije e nan gwo bezwen,</para>
  <para style="q1" vid="PSA 40:17">
    <note caller="+" style="x">
      <char style="xo" closed="false">40:17 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:5">Sòm 40:5</ref>
      </char>
    </note>kite SENYÈ a toujou sonje mwen.</para>
  <para style="q1" vid="PSA 40:17">Se Ou menm ki soutyen mwen ak delivrans mwen.</para>
  <para style="q1" vid="PSA 40:17">Pa fè reta, O Bondye mwen an.<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="d">Pou direktè koral la; Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>A la beni sila ki konsidere ka malere a beni!</para>
  <para style="q1" vid="PSA 41:1">SENYÈ a va delivre li <note caller="+" style="x"><char style="xo" closed="false">41:1 </char><char style="xt" closed="false"><ref loc="PSA 27:5">Sòm 27:5</ref></char></note>nan jou twoub li.<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>SENYÈ a va pwoteje li e fè l viv.</para>
  <para style="q1" vid="PSA 41:2">Li va rele beni sou latè a.</para>
  <para style="q1" vid="PSA 41:2">Ni li <note caller="+" style="x"><char style="xo" closed="false">41:2 </char><char style="xt" closed="false"><ref loc="PSA 27:12">Sòm 27:12</ref> </char></note>p ap livre a volonte lènmi li yo.<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>SENYÈ a va bay li soutyen lè l malad sou kabann nan.</para>
  <para style="q1" vid="PSA 41:3">Nan maladi li, li va restore li a lasante.<verse eid="PSA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>Konsa, pou mwen, mwen te di: “O SENYÈ, fè m gras.</para>
  <para style="q1" vid="PSA 41:4">Geri nanm mwen paske <note caller="+" style="x"><char style="xo" closed="false">41:4 </char><char style="xt" closed="false"><ref loc="PSA 51:4">Sòm 51:4</ref> </char></note>mwen te peche kont Ou.”<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>Lènmi m yo <note caller="+" style="x"><char style="xo" closed="false">41:5 </char><char style="xt" closed="false"><ref loc="PSA 38:12">Sòm 38:12</ref></char></note>pale mal kont mwen:</para>
  <para style="q1" vid="PSA 41:5">“Kilè l ap mouri pou non li disparèt?”<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>Si li vin wè m, li <note caller="+" style="x"><char style="xo" closed="false">41:6 </char><char style="xt" closed="false"><ref loc="PSA 12:2">Sòm 12:2</ref></char></note>bay manti.</para>
  <para style="q1" vid="PSA 41:6">Kè li ranmase mechanste pou kont li.</para>
  <para style="q1" vid="PSA 41:6">Lè l sòti deyò, li pale sa.<verse eid="PSA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>Tout sila ki rayi mwen yo</para>
  <para style="q1" vid="PSA 41:7">soufle ti pawòl nan zòrèy youn lòt.</para>
  <para style="q1" vid="PSA 41:7">Kont mwen, yo <note caller="+" style="x"><char style="xo" closed="false">41:7 </char><char style="xt" closed="false"><ref loc="PSA 56:5">Sòm 56:5</ref></char></note>fè plan pou</para>
  <para style="q1" vid="PSA 41:7">donmaje mwen epi yo di:<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>“Yon bagay mechan gen tan pran l,</para>
  <para style="q1" vid="PSA 41:8">pou lè l kouche, pou l <note caller="+" style="x"><char style="xo" closed="false">41:8 </char><char style="xt" closed="false"><ref loc="PSA 71:10-11">Sòm 71:10-11</ref></char></note>pa leve ankò.”<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>Menm <note caller="+" style="x"><char style="xo" closed="false">41:9 </char><char style="xt" closed="false"><ref loc="2SA 15:12">II Sam 15:12</ref></char></note>zanmi ki te pre m nan,</para>
  <para style="q1" vid="PSA 41:9">nan sila mwen te mete konfyans la,</para>
  <para style="q1" vid="PSA 41:9">li ki te manje pen mwen,</para>
  <para style="q1" vid="PSA 41:9">te leve talon li kont mwen.<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>Men Ou menm, O SENYÈ, fè m gras e <note caller="+" style="x"><char style="xo" closed="false">41:10 </char><char style="xt" closed="false"><ref loc="PSA 3:3">Sòm 3:3</ref></char></note>fè m leve</para>
  <para style="q1" vid="PSA 41:10">pou m kab bay yo rekonpans yo.<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>Se konsa <note caller="+" style="x"><char style="xo" closed="false">41:11 </char><char style="xt" closed="false"><ref loc="PSA 37:23">Sòm 37:23</ref></char></note>mwen konnen ke Ou pran plezi nan mwen.</para>
  <para style="q1" vid="PSA 41:11">Akoz lènmi mwen an pa kriye viktwa sou mwen.<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>Pou mwen menm, Ou soutni mwen nan entegrite m,</para>
  <para style="q1" vid="PSA 41:12">epi Ou mete mwen <note caller="+" style="x"><char style="xo" closed="false">41:12 </char><char style="xt" closed="false"><ref loc="JOB 36:7">Job 36:7</ref></char></note>nan prezans Ou</para>
  <para style="q1" vid="PSA 41:12">jis pou tout tan.<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">41:13 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:18-19">Sòm 72:18-19</ref>
      </char>
    </note>Beni se SENYÈ a, Bondye Israël la,</para>
  <para style="q1" vid="PSA 41:13">soti pou tout tan, jis rive pou tout tan.</para>
  <para style="q1" vid="PSA 41:13">Amen e amen.<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms1">LIV 2</para>
  <para style="d">Pou direktè koral la. Yon refleksyon pa fis Kore yo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>Jan sèf la <note caller="+" style="x"><char style="xo" closed="false">42:1 </char><char style="xt" closed="false"><ref loc="PSA 119:131">Sòm 119:131</ref></char></note>rale souf ak swaf pou dlo ravin nan,</para>
  <para style="q1" vid="PSA 42:1">Konsa nanm mwen rale souf pou Ou, O Bondye.<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>Nanm mwen swaf pou Bondye,</para>
  <para style="q1" vid="PSA 42:2">Pou Bondye vivan an.</para>
  <para style="q1" vid="PSA 42:2">Se kilè mwen kab vini pou <note caller="+" style="x"><char style="xo" closed="false">42:2 </char><char style="xt" closed="false"><ref loc="EXO 23:17">Egz 23:17</ref></char></note> parèt devan Bondye?<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>Se dlo nan zye m ki manje mwen lajounen kon lannwit.</para>
  <para style="q1" vid="PSA 42:3">Pandan y ap <note caller="+" style="x"><char style="xo" closed="false">42:3 </char><char style="xt" closed="false"><ref loc="PSA 79:10">Sòm 79:10</ref></char></note>di m tout lajounen:</para>
  <para style="q1" vid="PSA 42:3">“Kote Bondye ou a?”<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>Bagay sa yo mwen sonje e mwen</para>
  <para style="q1" vid="PSA 42:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">42:4 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 1:15">I Sam 1:15</ref>
      </char>
    </note>vide nanm mwen nèt anndan m.</para>
  <para style="q1" vid="PSA 42:4">Paske mwen te konn ale ansanm ak foul la,</para>
  <para style="q1" vid="PSA 42:4">pou pran devan nan pwosesyon pou rive lakay Bondye,</para>
  <para style="q1" vid="PSA 42:4">avèk yon vwa lajwa, ak remèsiman, yon gran foul k ap fè fèt sakre a.<verse eid="PSA 42:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>Poukisa, o nanm mwen, ou nan dezespwa?</para>
  <para style="q1" vid="PSA 42:5">Epi poukisa ou twouble anndan m?</para>
  <para style="q1" vid="PSA 42:5">Mete espwa ou nan Bondye, paske mwen</para>
  <para style="q1" vid="PSA 42:5">va louwe Li ankò akoz <note caller="+" style="x"><char style="xo" closed="false">42:5 </char><char style="xt" closed="false"><ref loc="PSA 44:3">Sòm 44:3</ref></char></note>sekou a prezans Li an.<verse eid="PSA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>O Bondye mwen, nanm mwen pèdi espwa anndan mwen.</para>
  <para style="q1" vid="PSA 42:6">Pou sa, mwen sonje Ou soti nan peyi</para>
  <para style="q1" vid="PSA 42:6">Jourdain an avèk tèt mòn Hermon yo, soti kanpe nan Mòn Mitsear.<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>Pwofondè a rele pwofondè a nan son kaskad dlo Ou yo.</para>
  <para style="q1" vid="PSA 42:7">Tout <note caller="+" style="x"><char style="xo" closed="false">42:7 </char><char style="xt" closed="false"><ref loc="PSA 69:1-2">Sòm 69:1-2</ref></char></note>gwo dlo ak move lanmè Ou yo fin koule sou mwen.<verse eid="PSA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>SENYÈ a va òdone lanmou dous Li a nan lajounen,</para>
  <para style="q1" vid="PSA 42:8">chan Li yo va avèk mwen <note caller="+" style="x"><char style="xo" closed="false">42:8 </char><char style="xt" closed="false"><ref loc="JOB 35:10">Job 35:10</ref></char></note>pandan nwit lan:</para>
  <para style="q1" vid="PSA 42:8">Yon lapriyè a Bondye lavi mwen an.<verse eid="PSA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>Mwen va di a Bondye, wòch mwen an:</para>
  <para style="q1" vid="PSA 42:9">“Poukisa Ou te bliye mwen?</para>
  <para style="q1" vid="PSA 42:9">Poukisa mwen antre nan tristès akoz <note caller="+" style="x"><char style="xo" closed="false">42:9 </char><char style="xt" closed="false"><ref loc="PSA 17:9">Sòm 17:9</ref></char></note>opresyon lènmi an?”<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>Se tankou tout zo mwen yo kraze,</para>
  <para style="q1" vid="PSA 42:10">jan advèsè mwen yo anmède mwen,</para>
  <para style="q1" vid="PSA 42:10">pandan y ap <note caller="+" style="x"><char style="xo" closed="false">42:10 </char><char style="xt" closed="false"><ref loc="PSA 42:3">Sòm 42:3</ref></char></note>di m tout lajounen:</para>
  <para style="q1" vid="PSA 42:10">“Kote Bondye Ou a”?<verse eid="PSA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>Poukisa ou nan dezespwa, O nanm mwen?</para>
  <para style="q1" vid="PSA 42:11">Epi poukisa ou vin twouble anndan mwen?</para>
  <para style="q1" vid="PSA 42:11">Mete espwa ou nan Bondye, paske m ap louwe Li ankò,</para>
  <para style="q1" vid="PSA 42:11">O soutyen kè mwen an, e Bondye mwen an.<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">43:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 26:1">Sòm 26:1</ref>
      </char>
    </note>Deklare m inosan, O Bondye mwen!</para>
  <para style="q1" vid="PSA 43:1">Plede ka mwen kont yon nasyon enfidèl.</para>
  <para style="q1" vid="PSA 43:1">O delivre mwen soti nan men</para>
  <para style="q1" vid="PSA 43:1">a lezòm mantè e enjis yo!<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>Paske Ou se Bondye fòs mwen an.</para>
  <para style="q1" vid="PSA 43:2">Poukisa Ou rejte m?</para>
  <para style="q1" vid="PSA 43:2">Poukisa mwen <note caller="+" style="x"><char style="xo" closed="false">43:2 </char><char style="xt" closed="false"><ref loc="PSA 42:9">Sòm 42:9</ref></char></note>fè dèy akoz opresyon a lènmi an?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>Voye <note caller="+" style="x"><char style="xo" closed="false">43:3 </char><char style="xt" closed="false"><ref loc="PSA 36:9">Sòm 36:9</ref></char></note>limyè Ou deyò avèk verite Ou;</para>
  <para style="q1" vid="PSA 43:3">kite yo mennen mwen.</para>
  <para style="q1" vid="PSA 43:3">Kite yo mennen m nan mòn sen Ou an ak kote Ou abite yo.<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>Konsa, mwen va ale vè lotèl Bondye a,</para>
  <para style="q1" vid="PSA 43:4">Bondye <note caller="+" style="x"><char style="xo" closed="false">43:4 </char><char style="xt" closed="false"><ref loc="PSA 21:6">Sòm 21:6</ref></char></note>lajwa m ki depase limit lan.</para>
  <para style="q1" vid="PSA 43:4">Konsa, sou gita a, mwen va bay Ou lwanj,</para>
  <para style="q1" vid="PSA 43:4">O Bondye, Bondye mwen an.<verse eid="PSA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">43:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:5-11">Sòm 42:5-11</ref>
      </char>
    </note>Poukisa ou nan dezespwa, O nanm mwen?</para>
  <para style="q1" vid="PSA 43:5">E poukisa ou twouble anndan m?</para>
  <para style="q1" vid="PSA 43:5">Mete espwa ou nan Bondye!</para>
  <para style="q1" vid="PSA 43:5">Paske m ap louwe Li ankò:</para>
  <para style="q1" vid="PSA 43:5">O sove m, soutyen mwen an,</para>
  <para style="q1" vid="PSA 43:5">ak Bondye m.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="d">Pou direktè koral la; Yon Sòm refleksyon pa fis a Koré yo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>O Bondye, nou te tande avèk zòrèy nou.</para>
  <para style="q1" vid="PSA 44:1">Zansèt nou yo te pale nou</para>
  <para style="q1" vid="PSA 44:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">44:1 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:7">Det 32:7</ref>
      </char>
    </note>travay ke Ou te fè nan jou pa yo,</para>
  <para style="q1" vid="PSA 44:1">nan jou ansyen yo.<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>Ou menm, avèk pwòp men Ou,</para>
  <para style="q1" vid="PSA 44:2">Ou te <note caller="+" style="x"><char style="xo" closed="false">44:2 </char><char style="xt" closed="false"><ref loc="JOS 3:10">Jos 3:10</ref></char></note>chase mete nasyon yo deyò,</para>
  <para style="q1" vid="PSA 44:2">men Ou te plante yo.</para>
  <para style="q1" vid="PSA 44:2">Ou te foule yo anba. Ou te aflije yo,</para>
  <para style="q1" vid="PSA 44:2">Ou te gaye yo toupatou.<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">44:3 </char><char style="xt" closed="false"><ref loc="DEU 8:17-18">Det 8:17-18</ref></char></note>se pa ak pwòp nepe pa yo ke yo te posede peyi a,</para>
  <para style="q1" vid="PSA 44:3">ni se pa pwòp bra yo ki te sove yo,</para>
  <para style="q1" vid="PSA 44:3">men se men dwat Ou avèk bra Ou,</para>
  <para style="q1" vid="PSA 44:3">ak limyè prezans Ou an,</para>
  <para style="q1" vid="PSA 44:3">akoz Ou te bay yo favè.<verse eid="PSA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>Se Ou menm ki <note caller="+" style="x"><char style="xo" closed="false">44:4 </char><char style="xt" closed="false"><ref loc="PSA 74:12">Sòm 74:12</ref></char></note>Wa m, O Bondye.</para>
  <para style="q1" vid="PSA 44:4">Òdone viktwa pou Jacob.<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>Ak pouvwa Ou menm, nou va pouse fè advèsè nou fè bak;</para>
  <para style="q1" vid="PSA 44:5">Nan non Ou, nou va <note caller="+" style="x"><char style="xo" closed="false">44:5 </char><char style="xt" closed="false"><ref loc="PSA 108:13">Sòm 108:13</ref></char></note>pile fè desann</para>
  <para style="q1" vid="PSA 44:5">sila ki leve kont nou yo.<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>Paske mwen <note caller="+" style="x"><char style="xo" closed="false">44:6 </char><char style="xt" closed="false"><ref loc="1SA 17:47">I Sam 17:47</ref></char></note>p ap mete konfyans nan banza mwen,</para>
  <para style="q1" vid="PSA 44:6">ni se pa nepe m k ap sove mwen.<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>Men Ou <note caller="+" style="x"><char style="xo" closed="false">44:7 </char><char style="xt" closed="false"><ref loc="PSA 136:24">Sòm 136:24</ref></char></note>te sove nou kont advèsè nou yo,</para>
  <para style="q1" vid="PSA 44:7">Epi Ou te fè tout sila ki rayi nou yo wont.<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>Nan Bondye, nou te <note caller="+" style="x"><char style="xo" closed="false">44:8 </char><char style="xt" closed="false"><ref loc="PSA 34:2">Sòm 34:2</ref></char></note>louwe tout lajounen.</para>
  <para style="q1" vid="PSA 44:8">Nou va bay remèsiman a non Ou jis pou tout tan.<verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>Alò, koulye a, Ou rejte nou,</para>
  <para style="q1" vid="PSA 44:9">e mennen nou nan gwo wont.</para>
  <para style="q1" vid="PSA 44:9">Ou <note caller="+" style="x"><char style="xo" closed="false">44:9 </char><char style="xt" closed="false"><ref loc="PSA 60:10">Sòm 60:10</ref></char></note>pa sòti ankò avèk lame nou yo.<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>Ou fè nou vire <note caller="+" style="x"><char style="xo" closed="false">44:10 </char><char style="xt" closed="false"><ref loc="LEV 26:17">Lev 26:17</ref></char></note>fè bak devan advèsè a,</para>
  <para style="q1" vid="PSA 44:10">epi sila ki rayi nou yo fè piyaj pou kont yo.<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>Ou te fè nou kon mouton,</para>
  <para style="q1" vid="PSA 44:11">tankou mouton ki te livre pou manje,</para>
  <para style="q1" vid="PSA 44:11">epi te <note caller="+" style="x"><char style="xo" closed="false">44:11 </char><char style="xt" closed="false"><ref loc="LEV 26:33">Lev 26:33</ref> </char></note>gaye nou pami nasyon yo.<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>Ou <note caller="+" style="x"><char style="xo" closed="false">44:12 </char><char style="xt" closed="false"><ref loc="DEU 32:30">Det 32:30</ref></char></note>vann pèp Ou bon mache e Ou pa fè pwofi nan vant lan.<verse eid="PSA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>Ou fè nou repwòche devan vwazen nou yo,</para>
  <para style="q1" vid="PSA 44:13">yon objè ki moke e <note caller="+" style="x"><char style="xo" closed="false">44:13 </char><char style="xt" closed="false"><ref loc="PSA 80:6">Sòm 80:6</ref></char></note>giyonnen pa sila ki antoure nou yo.<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>Ou fè nou <note caller="+" style="x"><char style="xo" closed="false">44:14 </char><char style="xt" closed="false"><ref loc="2KI 19:21">II Wa 19:21</ref></char></note>tounen yon vye mò pami nasyon yo,</para>
  <para style="q1" vid="PSA 44:14">Yon rizib ki fè moun ri pami pèp yo.<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>Tout lajounen dezonè sa a rete la devan m,</para>
  <para style="q1" vid="PSA 44:15">epi imilyasyon mwen kraze m nèt.<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>Akoz vwa a sila ki <note caller="+" style="x"><char style="xo" closed="false">44:16 </char><char style="xt" closed="false"><ref loc="PSA 74:10">Sòm 74:10</ref></char></note>fè m repwòch e ki meprize mwen,</para>
  <para style="q1" vid="PSA 44:16">akoz prezans lènmi an avèk vanjè a.<verse eid="PSA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>Tout sa gen tan rive sou nou,</para>
  <para style="q1" vid="PSA 44:17">men nou pa te bliye Ou,</para>
  <para style="q1" vid="PSA 44:17">ni nou pa t <note caller="+" style="x"><char style="xo" closed="false">44:17 </char><char style="xt" closed="false"><ref loc="PSA 78:57">Sòm 78:57</ref></char></note>aji nan manti selon akò Ou a.<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>Kè nou pa t vire fè bak, ni pa nou yo</para>
  <para style="q1" vid="PSA 44:18">
    <note caller="+" style="x">
      <char style="xo" closed="false">44:18 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 23:11">Job 23:11</ref> </char>
    </note>pa t varye soti nan chemen Ou.<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>Malgre, Ou te kraze nou nan landwa chen mawon yo,</para>
  <para style="q1" vid="PSA 44:19">e te kouvri nou avèk <note caller="+" style="x"><char style="xo" closed="false">44:19 </char><char style="xt" closed="false"><ref loc="JOB 3:5">Job 3:5</ref></char></note>lonbraj lanmò a.<verse eid="PSA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>Si nou te bliye non a Bondye nou an,</para>
  <para style="q1" vid="PSA 44:20">oswa lonje men nou vè yon <note caller="+" style="x"><char style="xo" closed="false">44:20 </char><char style="xt" closed="false"><ref loc="DEU 6:14">Det 6:14</ref> </char></note>lòt dye etranje,<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>èske Bondye pa ta <note caller="+" style="x"><char style="xo" closed="false">44:21 </char><char style="xt" closed="false"><ref loc="PSA 139:1-2">Sòm 139:1-2</ref></char></note>dekouvri sa a?</para>
  <para style="q1" vid="PSA 44:21">Paske Li konnen tout sekrè a kè yo.<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>Men <note caller="+" style="x"><char style="xo" closed="false">44:22 </char><char style="xt" closed="false"><ref loc="ROM 8:36">Wo 8:36</ref></char></note>pou lakoz a Ou menm, nou vin touye tout lajounen.</para>
  <para style="q1" vid="PSA 44:22">Nou konsidere tankou mouton k ap rive labatwa.<verse eid="PSA 44:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>Leve Ou menm! Poukisa Ou ap dòmi, O SENYÈ?</para>
  <para style="q1" vid="PSA 44:23">Leve nan dòmi! <note caller="+" style="x"><char style="xo" closed="false">44:23 </char><char style="xt" closed="false"><ref loc="PSA 77:7">Sòm 77:7</ref></char></note>Pa rejte nou nèt.<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>Poukisa Ou <note caller="+" style="x"><char style="xo" closed="false">44:24 </char><char style="xt" closed="false"><ref loc="JOB 13:24">Job 13:24</ref></char></note>kache figi Ou e bliye ke n ap soufri e oprime?<verse eid="PSA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>Paske <note caller="+" style="x"><char style="xo" closed="false">44:25 </char><char style="xt" closed="false"><ref loc="PSA 119:25">Sòm 119:25</ref></char></note>nanm nou te neye jis rive nan pousyè.</para>
  <para style="q1" vid="PSA 44:25">Kò nou kole jis rive atè.<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">44:26 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:2">Sòm 35:2</ref>
      </char>
    </note>Leve monte! Bay nou sekou!</para>
  <para style="q1" vid="PSA 44:26">Rachte nou pou koz</para>
  <para style="q1" vid="PSA 44:26">lanmou dous Ou a.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="d">Pou direktè koral la; selon “Flè Lis Yo.” Yon Sòm a fis a Koré yo.</para>
  <para style="d">Yon Chanson Fèt Maryaj</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>Kè m debòde avèk yon bèl sijè.</para>
  <para style="q1" vid="PSA 45:1">Mwen resite vèsè mwen yo pou Wa a.</para>
  <para style="q1" vid="PSA 45:1">Lang mwen se plim a yon ekriven byen prepare.<verse eid="PSA 45:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>Ou pi bo pase tout lòt nan fis a lòm yo.</para>
  <para style="q1" vid="PSA 45:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">45:2 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 4:22">Luc 4:22</ref>
      </char>
    </note>Lagras debòde sou lèv ou.</para>
  <para style="q1" vid="PSA 45:2">Pou sa, Bondye te beni ou jis pou tout tan.<verse eid="PSA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>Mete nepe Ou sou kwis ou, O Sila Ki Pwisan an,</para>
  <para style="q1" vid="PSA 45:3">nan bèlte Ou avèk majeste Ou!<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>Nan majeste Ou, Ou va monte nèt an viktwa.</para>
  <para style="q1" vid="PSA 45:4">Pou koz verite avèk <note caller="+" style="x"><char style="xo" closed="false">45:4 </char><char style="xt" closed="false"><ref loc="ZEP 2:3">So 2:3</ref></char></note>imilite, avèk ladwati,</para>
  <para style="q1" vid="PSA 45:4">kite men dwat Ou enstwi Ou bagay mèvèy yo.<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>Flèch Ou yo filè.</para>
  <para style="q1" vid="PSA 45:5">Tout nasyon yo tonbe anba Ou,</para>
  <para style="q1" vid="PSA 45:5">epi flèch Ou yo <note caller="+" style="x"><char style="xo" closed="false">45:5 </char><char style="xt" closed="false"><ref loc="2SA 18:14">II Sam 18:14</ref> </char></note>lantre nan kè lènmi a Wa a.<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>Twòn Ou, O SENYÈ, se pou tout tan e pou tout tan;</para>
  <para style="q1" vid="PSA 45:6">Baton <note caller="+" style="x"><char style="xo" closed="false">45:6 </char><char style="xt" closed="false"><ref loc="PSA 98:9">Sòm 98:9</ref> </char></note>ladwati a se baton wayal a wayòm Ou an.<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>Ou te renmen ladwati e te rayi mechanste.</para>
  <para style="q1" vid="PSA 45:7">Pou sa, Bondye, Bondye pa Ou a,</para>
  <para style="q1" vid="PSA 45:7">te <note caller="+" style="x"><char style="xo" closed="false">45:7 </char><char style="xt" closed="false"><ref loc="PSA 2:2">Sòm 2:2</ref></char></note>onksyone Ou avèk lwil lajwa plis ke moun parèy Ou yo.<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>Tout vètman Ou yo santi tankou lami, womaren ak sitwonèl.</para>
  <para style="q1" vid="PSA 45:8">Soti nan palè livwa yo,lenstriman a kòd yo vin fè Ou kontan.<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>Fi a wa yo vin pami fanm pi onore yo.</para>
  <para style="q1" vid="PSA 45:9">Sou <note caller="+" style="x"><char style="xo" closed="false">45:9 </char><char style="xt" closed="false"><ref loc="1KI 2:19">I Wa 2:19</ref></char></note>men dwat Ou, kanpe rèn nan, abiye an lò ki sòti Ophir a.<verse eid="PSA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>Koute byen, O fi, prete atansyon e panche zòrèy ou.</para>
  <para style="q1" vid="PSA 45:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">45:10 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 21:13">Det 21:13</ref>
      </char>
    </note>Bliye pèp ou a avèk lakay papa ou.<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>Konsa, wa a va dezire bèlte ou.</para>
  <para style="q1" vid="PSA 45:11">Akoz li se senyè ou, <note caller="+" style="x"><char style="xo" closed="false">45:11 </char><char style="xt" closed="false"><ref loc="EPH 5:33">Ef 5:33</ref></char></note>vin bese ba devan L.<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>Fi <note caller="+" style="x"><char style="xo" closed="false">45:12 </char><char style="xt" closed="false"><ref loc="PSA 87:4">Sòm 87:4</ref></char></note>Tyr la va vini avèk yon kado.</para>
  <para style="q1" vid="PSA 45:12">Moun gwo riches pami pèp yo k ap chache favè ou.<verse eid="PSA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>Lamarye a wa a bèl nèt anndan.</para>
  <para style="q1" vid="PSA 45:13">Vètman li <note caller="+" style="x"><char style="xo" closed="false">45:13 </char><char style="xt" closed="false"><ref loc="EXO 39:2-3">Egz 39:2-3</ref></char></note>trese antre sòti avèk lò.<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>Li va <note caller="+" style="x"><char style="xo" closed="false">45:14 </char><char style="xt" closed="false"><ref loc="ZEP 1:4">So 1:4</ref></char></note>mennen kote Wa a nan yon zèv bwodri.</para>
  <para style="q1" vid="PSA 45:14">Vyèj yo, konpanyen li yo, k ap swiv li va mennen bò kote Ou.<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>Yo va mennen fè parèt avèk kè kontan ak anpil rejwisans.</para>
  <para style="q1" vid="PSA 45:15">Yo va antre nan palè a wa a.<verse eid="PSA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>Nan plas a papa zansèt ou yo, va gen fis ou yo.</para>
  <para style="q1" vid="PSA 45:16">Ou va fè yo prens sou tout latè.<verse eid="PSA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>Mwen va fè <note caller="+" style="x"><char style="xo" closed="false">45:17 </char><char style="xt" closed="false"><ref loc="MAL 1:11">Mal 1:11</ref></char></note>non Ou sonje nan tout jenerasyon yo.</para>
  <para style="q1" vid="PSA 45:17">Akoz sa, tout pèp yo va bay Ou</para>
  <para style="q1" vid="PSA 45:17">remèsiman pou tout tan e pou tout tan.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="d">Yon Sòm a fis a Koré yo, selon Alamot; Yon chanson</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>Bondye se <note caller="+" style="x"><char style="xo" closed="false">46:1 </char><char style="xt" closed="false"><ref loc="PSA 14:6">Sòm 14:6</ref></char></note>pwotèj nou ak fòs nou,</para>
  <para style="q1" vid="PSA 46:1">yon sekou ki toujou la nan tan twoub la.<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>Pou sa, nou <note caller="+" style="x"><char style="xo" closed="false">46:2 </char><char style="xt" closed="false"><ref loc="PSA 23:4">Sòm 23:4</ref></char></note>p ap pè anyen, malgre latè</para>
  <para style="q1" vid="PSA 46:2">ta chanje e malgre mòn yo</para>
  <para style="q1" vid="PSA 46:2">ta chape antre nan fon lanmè.<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>Malgre dlo li yo ta fè laraj e kimen,</para>
  <para style="q1" vid="PSA 46:3">malgre mòn yo souke nan anfle ak ògèy yo. <char style="qs">Tan</char><verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>Genyen yon rivyè ak flèv li yo</para>
  <para style="q1" vid="PSA 46:4">ki fè kè vil Bondye a kontan;</para>
  <para style="q1" vid="PSA 46:4">lye sen a kote Pi Wo a <note caller="+" style="x"><char style="xo" closed="false">46:4 </char><char style="xt" closed="false"><ref loc="PSA 43:3">Sòm 43:3</ref></char></note>demere a.<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>Bondye nan mitan li. Li p ap deplase menm.</para>
  <para style="q1" vid="PSA 46:5">Bondye va ede li vin parèt nan maten.<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>Nasyon yo te fè gwo boulvèsman.</para>
  <para style="q1" vid="PSA 46:6">Wayòm yo te souke.</para>
  <para style="q1" vid="PSA 46:6">Li te leve vwa l e latè te <note caller="+" style="x"><char style="xo" closed="false">46:6 </char><char style="xt" closed="false"><ref loc="AMO 9:5">Am 9:5</ref></char></note>fonn.<verse eid="PSA 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>SENYÈ dèzame yo <note caller="+" style="x"><char style="xo" closed="false">46:7 </char><char style="xt" closed="false"><ref loc="NUM 14:9">Nonb 14:9</ref></char></note>avèk nou.</para>
  <para style="q1" vid="PSA 46:7">Bondye Jacob la se sitadèl nou.<verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>Vini, <note caller="+" style="x"><char style="xo" closed="false">46:8 </char><char style="xt" closed="false"><ref loc="PSA 66:5">Sòm 66:5</ref></char></note>gade byen zèv a SENYÈ yo</para>
  <para style="q1" vid="PSA 46:8">ki gwo dega Li fè nan tout latè.<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>Li fè lagè yo sispann jis rive nan ekstremite latè.</para>
  <para style="q1" vid="PSA 46:9">Li kase banza a, e koupe lans lan an de bout.</para>
  <para style="q1" vid="PSA 46:9">Li brile cha yo avèk dife.<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>“Kanpe la e <note caller="+" style="x"><char style="xo" closed="false">46:10 </char><char style="xt" closed="false"><ref loc="PSA 100:3">Sòm 100:3</ref></char></note>konnen ke se Mwen menm ki Bondye.</para>
  <para style="q1" vid="PSA 46:10">Mwen va leve wo pami nasyon yo.</para>
  <para style="q1" vid="PSA 46:10">Mwen va leve wo sou tè a.”<verse eid="PSA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>SENYÈ dèzame yo avèk nou.</para>
  <para style="q1" vid="PSA 46:11">Bondye Jacob la se sitadèl nou. <char style="qs">Tan</char><verse eid="PSA 46:11"/></para>
  <para style="b"/>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="d">Pou direktè koral la; Yo Sòm pa fis Koré yo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>O bat men nou ansanm, tout pèp yo.</para>
  <para style="q1" vid="PSA 47:1">Rele fò a Bondye avèk yon vwa plen viktwa.<verse eid="PSA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>Paske SENYÈ Pi Wo a merite lakrent.</para>
  <para style="q1" vid="PSA 47:2">Li se <note caller="+" style="x"><char style="xo" closed="false">47:2 </char><char style="xt" closed="false"><ref loc="MAL 1:1">Mal 1:1</ref></char></note>Gran Wa a sou tout latè a.<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>Li fè soumèt pèp yo anba nou,</para>
  <para style="q1" vid="PSA 47:3">ak nasyon yo anba pye nou.<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>Pou nou menm, Li chwazi eritaj nou,</para>
  <para style="q1" vid="PSA 47:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">47:4 </char>
      <char style="xt" closed="false">
        <ref loc="AMO 6:8">Am 6:8</ref>
      </char>
    </note>glwa la a Jacob, ke Li renmen an. <char style="qs">Tan</char><verse eid="PSA 47:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>Bondye te monte avèk yon gwo rèl,</para>
  <para style="q1" vid="PSA 47:5">SENYÈ a avèk <note caller="+" style="x"><char style="xo" closed="false">47:5 </char><char style="xt" closed="false"><ref loc="PSA 98:6">Sòm 98:6</ref></char></note>son twonpèt la.<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>Chante lwanj Bondye a, chante lwanj yo!</para>
  <para style="q1" vid="PSA 47:6">Chante lwanj <note caller="+" style="x"><char style="xo" closed="false">47:6 </char><char style="xt" closed="false"><ref loc="PSA 89:18">Sòm 89:18</ref></char></note>Wa nou an, chante lwanj yo!<verse eid="PSA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>Paske Bondye se Wa a tout tè a.</para>
  <para style="q1" vid="PSA 47:7">Chante lwanj yo <note caller="+" style="x"><char style="xo" closed="false">47:7 </char><char style="xt" closed="false"><ref loc="1CO 14:15">I Kor 14:15</ref></char></note>avèk yon chan byen bèl.<verse eid="PSA 47:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>Bondye <note caller="+" style="x"><char style="xo" closed="false">47:8 </char><char style="xt" closed="false"><ref loc="1CH 16:31">I Kwo 16:31</ref></char></note>regne sou nasyon yo.</para>
  <para style="q1" vid="PSA 47:8">Bondye chita sou twòn wayal Li a.<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>Prens a pèp yo rasanble yo ansanm,</para>
  <para style="q1" vid="PSA 47:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">47:9 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:11-12">Wo 4:11-12</ref>
      </char>
    </note>pèp a Bondye Abraham nan.</para>
  <para style="q1" vid="PSA 47:9">Paske tout boukliye sou latè yo se pou Bondye.</para>
  <para style="q1" vid="PSA 47:9">Li leve byen wo.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="d">Yon Chan; yon Sòm fis a Koré yo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>Gran se Bondye e gran se lwanj Li merite a,</para>
  <para style="q1" vid="PSA 48:1">nan Jérusalem, vil Bondye nou an, mòn sen pa Li a.<verse eid="PSA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>Bèl nan wotè li, jwa tout latè a,</para>
  <para style="q1" vid="PSA 48:2">se Mòn Sion nan pati nò a,</para>
  <para style="q1" vid="PSA 48:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">48:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:35">Mat 5:35</ref> </char>
    </note>Vil gran Wa a.<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>Bondye te parèt nan sitadèl li yo.</para>
  <para style="q1" vid="PSA 48:3">La, Li te fè tèt Li rekonèt kon yon <note caller="+" style="x"><char style="xo" closed="false">48:3 </char><char style="xt" closed="false"><ref loc="PSA 46:7">Sòm 46:7</ref></char></note>refij.<verse eid="PSA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>Men gade, <note caller="+" style="x"><char style="xo" closed="false">48:4 </char><char style="xt" closed="false"><ref loc="2SA 10:6-19">II Sam 10:6-19</ref></char></note>wa yo te rasanble yo.</para>
  <para style="q1" vid="PSA 48:4">Yo pase akote vil la ansanm.<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>Yo te wè li, e yo te etone.</para>
  <para style="q1" vid="PSA 48:5">Yo te <note caller="+" style="x"><char style="xo" closed="false">48:5 </char><char style="xt" closed="false"><ref loc="EXO 15:15">Egz 15:15</ref></char></note>sezi nèt, yo te kouri nan laperèz.<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>La, yo pèdi ekilib yo nèt.</para>
  <para style="q1" vid="PSA 48:6">Doulè ak sezisman te pran yo tankou <note caller="+" style="x"><char style="xo" closed="false">48:6 </char><char style="xt" closed="false"><ref loc="ISA 13:8">És 13:8</ref></char></note>fanm k ap akouche.<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>Avèk <note caller="+" style="x"><char style="xo" closed="false">48:7 </char><char style="xt" closed="false"><ref loc="JER 18:17">Jr 18:17</ref></char></note>van lès la, Ou te kraze bato Tarsis yo.<verse eid="PSA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>Jan nou konn tande a, se konsa nou vin wè,</para>
  <para style="q1" vid="PSA 48:8">nan vil SENYÈ dèzame yo,</para>
  <para style="q1" vid="PSA 48:8">nan vil Bondye pa nou an.</para>
  <para style="q1" vid="PSA 48:8">Bondye va <note caller="+" style="x"><char style="xo" closed="false">48:8 </char><char style="xt" closed="false"><ref loc="PSA 87:5">Sòm 87:5</ref></char></note>etabli li nèt, jis pou tout tan.<verse eid="PSA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>Nou te reflechi sou <note caller="+" style="x"><char style="xo" closed="false">48:9 </char><char style="xt" closed="false"><ref loc="PSA 26:3">Sòm 26:3</ref></char></note>lanmou dous</para>
  <para style="q1" vid="PSA 48:9">Ou a, O Bondye, nan mitan tanp Ou a.<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>Jan <note caller="+" style="x"><char style="xo" closed="false">48:10 </char><char style="xt" closed="false"><ref loc="DEU 28:58">Det 28:58</ref></char></note>non Ou ye a, O Bondye,</para>
  <para style="q1" vid="PSA 48:10">Se konsa Lwanj Ou ye, jis rive nan dènye pwent tè a;</para>
  <para style="q1" vid="PSA 48:10">Men dwat Ou plen ladwati.<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>Kite Mòn Sion fè kè kontan!</para>
  <para style="q1" vid="PSA 48:11">Kite <note caller="+" style="x"><char style="xo" closed="false">48:11 </char><char style="xt" closed="false"><ref loc="PSA 97:8">Sòm 97:8</ref></char></note> fi a Juda yo rejwi akoz jijman Ou yo.<verse eid="PSA 48:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>Mache toupatou nan Sion e antoure li.</para>
  <para style="q1" vid="PSA 48:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">48:12 </char>
      <char style="xt" closed="false">
        <ref loc="NEH 3:1-27">Né 3:1-27</ref>
      </char>
    </note>Konte fò wo li yo.<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>Konsidere ranpa li yo.</para>
  <para style="q1" vid="PSA 48:13">Antre nan palè li yo, pou ou kab</para>
  <para style="q1" vid="PSA 48:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">48:13 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:5-7">Sòm 78:5-7</ref> </char>
    </note>pale jenerasyon k ap vini an.<verse eid="PSA 48:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>Paske Bondye se Bondye pa nou an jis pou tout tan.</para>
  <para style="q1" vid="PSA 48:14">
    <note caller="+" style="x">
      <char style="xo" closed="false">48:14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:4">Sòm 23:4</ref>
      </char>
    </note>Li va gide nou jiska lanmò.<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="d">Pou direktè koral la; Yon Sòm fis a Koré yo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>Tande sa, tout pèp yo!</para>
  <para style="q1" vid="PSA 49:1">Prete zòrèy nou, tout sila ki rete nan mond la!<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>Ni <note caller="+" style="x"><char style="xo" closed="false">49:2 </char><char style="xt" closed="false"><ref loc="PSA 62:9">Sòm 62:9</ref></char></note>ba, ni wo, rich ak malere ansanm.<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>Bouch mwen va <note caller="+" style="x"><char style="xo" closed="false">49:3 </char><char style="xt" closed="false"><ref loc="PSA 37:30">Sòm 37:30</ref></char></note>pale sajès,</para>
  <para style="q1" vid="PSA 49:3">epi meditasyon a kè m va vin konprann.<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>Mwen va apiye zòrèy mwen vè yon pwovèb.</para>
  <para style="q1" vid="PSA 49:4">Mwen va eksprime yon <note caller="+" style="x"><char style="xo" closed="false">49:4 </char><char style="xt" closed="false"><ref loc="NUM 12:8">Nonb 12:8</ref> </char></note>devinèt sou ap la.<verse eid="PSA 49:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>Poukisa mwen ta gen <note caller="+" style="x"><char style="xo" closed="false">49:5 </char><char style="xt" closed="false"><ref loc="PSA 23:4">Sòm 23:4</ref></char></note>krent nan move jou yo,</para>
  <para style="q1" vid="PSA 49:5">Lè inikite a lènmi m yo antoure m?<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>Malgre sila ki <note caller="+" style="x"><char style="xo" closed="false">49:6 </char><char style="xt" closed="false"><ref loc="JOB 31:24">Job 31:24</ref></char></note>mete konfyans nan richès yo,</para>
  <para style="q1" vid="PSA 49:6">ak ògeye nan kantite fòs lajan yo—<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>nanpwen moun ki kab sou okenn mwayen <note caller="+" style="x"><char style="xo" closed="false">49:7 </char><char style="xt" closed="false"><ref loc="MAT 25:8-9">Mat 25:8-9</ref></char></note>sove frè li,</para>
  <para style="q1" vid="PSA 49:7">ni li p ap kab bay Bondye yon racha pou li.<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>Paske <note caller="+" style="x"><char style="xo" closed="false">49:8 </char><char style="xt" closed="false"><ref loc="MAT 16:26">Mat 16:26</ref></char></note>redanmsyon nanm li koute chè.</para>
  <para style="q1" vid="PSA 49:8">Kèlkeswa sa li peye pa janm ase,<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>pou l ta <note caller="+" style="x"><char style="xo" closed="false">49:9 </char><char style="xt" closed="false"><ref loc="PSA 22:29">Sòm 22:29</ref></char></note>viv toujou jis pou letènite,</para>
  <para style="q1" vid="PSA 49:9">pou li <note caller="+" style="x"><char style="xo" closed="false">49:9 </char><char style="xt" closed="false"><ref loc="PSA 16:10">Sòm 16:10</ref> </char></note>pa ta janm tonbe nan pouriti menm.<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>Paske li wè ke menm moun saj yo mouri.</para>
  <para style="q1" vid="PSA 49:10">Sila ki bèt ak sila ki fou yo mouri menm jan.</para>
  <para style="q1" vid="PSA 49:10">Yo <note caller="+" style="x"><char style="xo" closed="false">49:10 </char><char style="xt" closed="false"><ref loc="PSA 39:6">Sòm 39:6</ref></char></note>kite byen yo pou lòt yo.<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>Yo <note caller="+" style="x"><char style="xo" closed="false">49:11 </char><char style="xt" closed="false"><ref loc="GEN 4:17">Jen 4:17</ref></char></note>reflechi anndan kè yo ke kay yo se pou tout tan,</para>
  <para style="q1" vid="PSA 49:11">epi kote yo rete a se pou tout jenerasyon yo.</para>
  <para style="q1" vid="PSA 49:11">Yo te rele peyi yo a menm non ak yo.<verse eid="PSA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>Men yon <note caller="+" style="x"><char style="xo" closed="false">49:12 </char><char style="xt" closed="false"><ref loc="PSA 49:20">Sòm 49:20</ref></char></note>nonm, malgre gran ògèy li, p ap dire.</para>
  <para style="q1" vid="PSA 49:12">Li tankou bèt yo ki peri.<verse eid="PSA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>Konsa, sa se <note caller="+" style="x"><char style="xo" closed="false">49:13 </char><char style="xt" closed="false"><ref loc="JER 17:11">Jr 17:11</ref></char></note>chemen a sila ki manke sajès yo,</para>
  <para style="q1" vid="PSA 49:13">ak sila ki swiv yo, e ki vin dakò avèk pawòl yo.<verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>Tankou mouton, yo fin apwente pou rive nan sejou lanmò.</para>
  <para style="q1" vid="PSA 49:14">Lanmò va bèje yo.</para>
  <para style="q1" vid="PSA 49:14">Moun dwat yo va domine sou yo nan maten.</para>
  <para style="q1" vid="PSA 49:14">Men fòm yo va <note caller="+" style="x"><char style="xo" closed="false">49:14 </char><char style="xt" closed="false"><ref loc="JOB 24:19">Job 24:19</ref></char></note>fini nèt pa sejou lanmò a, lwen gran kay yo.<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>Men <note caller="+" style="x"><char style="xo" closed="false">49:15 </char><char style="xt" closed="false"><ref loc="GEN 5:24">Jen 5:24</ref></char></note>Bondye va rachte nanm mwen soti</para>
  <para style="q1" vid="PSA 49:15">pouvwa a sejou lanmò a,</para>
  <para style="q1" vid="PSA 49:15">paske Bondye va resevwa m.<verse eid="PSA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>Ou pa bezwen pè <note caller="+" style="x"><char style="xo" closed="false">49:16 </char><char style="xt" closed="false"><ref loc="PSA 37:7">Sòm 37:7</ref></char></note>lè yon nonm vin rich,</para>
  <para style="q1" vid="PSA 49:16">lè glwa lakay li vin ogmante.<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>Paske lè l mouri li p ap pote anyen ale.</para>
  <para style="q1" vid="PSA 49:17">Glwa li a p ap swiv li desann.<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>Sepandan, pandan l ap viv, li <note caller="+" style="x"><char style="xo" closed="false">49:18 </char><char style="xt" closed="false"><ref loc="DEU 29:19">Det 29:19</ref></char></note>bat bravo pou pwòp tèt li—</para>
  <para style="q1" vid="PSA 49:18">Malgre moun ta bay ou glwa lè ou fè byen pou pwòp tèt ou—<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>li va ale nan jenerasyon a zansèt li yo.</para>
  <para style="q1" vid="PSA 49:19">Yo p ap janm wè <note caller="+" style="x"><char style="xo" closed="false">49:19 </char><char style="xt" closed="false"><ref loc="JOB 33:30">Job 33:30</ref></char></note>limyè an.<verse eid="PSA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>Lòm, nan pwòp glwa avèk ògèy li,</para>
  <para style="q1" vid="PSA 49:20">poutan, san konprann,</para>
  <para style="q1" vid="PSA 49:20">Se tankou bèt ki peri.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="d">Yon Sòm Asaph</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>Sila Ki Pwisan Nèt la, Bondye, SENYÈ a, fin pale.</para>
  <para style="q1" vid="PSA 50:1">Li rele lemonn lan soti nan <note caller="+" style="x"><char style="xo" closed="false">50:1 </char><char style="xt" closed="false"><ref loc="PSA 113:3">Sòm 113:3</ref> </char></note>leve solèy la</para>
  <para style="q1" vid="PSA 50:1">jis rive nan kote li kouche a.<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>Soti nan Sion, <note caller="+" style="x"><char style="xo" closed="false">50:2 </char><char style="xt" closed="false"><ref loc="PSA 48:2">Sòm 48:2</ref></char></note>bèlte pafè a,</para>
  <para style="q1" vid="PSA 50:2">Bondye fè limyè Li parèt.<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>Bondye nou <note caller="+" style="x"><char style="xo" closed="false">50:3 </char><char style="xt" closed="false"><ref loc="PSA 96:13">Sòm 96:13</ref></char></note>vin parèt.</para>
  <para style="q1" vid="PSA 50:3">Li pa rete an silans.</para>
  <para style="q1" vid="PSA 50:3">Dife devore devan L, e tanpèt yo antoure L.<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>Li <note caller="+" style="x"><char style="xo" closed="false">50:4 </char><char style="xt" closed="false"><ref loc="DEU 4:26">Det 4:26</ref></char></note>rele tout syèl yo anwo,</para>
  <para style="q1" vid="PSA 50:4">avèk latè pou jije pèp Li a:<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>“Rasanble fidèl Mwen yo kote M,</para>
  <para style="q1" vid="PSA 50:5">Sila ki te fè yon akò sakrifis yo avè M.<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>Epi syèl yo deklare ladwati Li,</para>
  <para style="q1" vid="PSA 50:6">paske <note caller="+" style="x"><char style="xo" closed="false">50:6 </char><char style="xt" closed="false"><ref loc="PSA 75:7">Sòm 75:7</ref></char></note>Bondye, Li menm, se Jij. <char style="qs">Tan</char><verse eid="PSA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“Koute O pèp Mwen an e Mwen va pale.</para>
  <para style="q1" vid="PSA 50:7">O Israël, Mwen va fè temwayaj kont ou.</para>
  <para style="q1" vid="PSA 50:7">Mwen se Bondye, <note caller="+" style="x"><char style="xo" closed="false">50:7 </char><char style="xt" closed="false"><ref loc="EXO 20:2">Egz 20:2</ref></char></note>Bondye pa ou a.<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>Mwen pa <note caller="+" style="x"><char style="xo" closed="false">50:8 </char><char style="xt" closed="false"><ref loc="PSA 40:6">Sòm 40:6</ref></char></note>repwoche ou pou sakrifis ou yo.</para>
  <para style="q1" vid="PSA 50:8">Ofrann brile nou yo devan m tout tan.<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>Mwen pa bezwen okenn <note caller="+" style="x"><char style="xo" closed="false">50:9 </char><char style="xt" closed="false"><ref loc="PSA 69:31">Sòm 69:31</ref></char></note>jenn towo sòti lakay ou,</para>
  <para style="q1" vid="PSA 50:9">Ni mal kabrit ki sòti nan pak ou yo.<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>Paske <note caller="+" style="x"><char style="xo" closed="false">50:10 </char><char style="xt" closed="false"><ref loc="PSA 104:24">Sòm 104:24</ref></char></note>tout bèt nan forè yo se pou mwen,</para>
  <para style="q1" vid="PSA 50:10">ak tout bèt domestik sou mil kolin yo.<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>Mwen konnen tout <note caller="+" style="x"><char style="xo" closed="false">50:11 </char><char style="xt" closed="false"><ref loc="MAT 6:26">Mat 6:26</ref></char></note>zwazo nan mòn yo.</para>
  <para style="q1" vid="PSA 50:11">Tout sa ki fè mouvman nan chan yo se pou Mwen.<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>Si mwen te grangou, mwen pa t ap di ou sa,</para>
  <para style="q1" vid="PSA 50:12">paske tout <note caller="+" style="x"><char style="xo" closed="false">50:12 </char><char style="xt" closed="false"><ref loc="EXO 19:5">Egz 19:5</ref></char></note>mond lan se pou Mwen, avèk tout sa ki ladann.<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>Èske m ta manje chè <note caller="+" style="x"><char style="xo" closed="false">50:13 </char><char style="xt" closed="false"><ref loc="PSA 50:9">Sòm 50:9</ref></char></note>towo yo,</para>
  <para style="q1" vid="PSA 50:13">oswa bwè san a mal kabrit yo?<verse eid="PSA 50:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>Ofri a Bondye <note caller="+" style="x"><char style="xo" closed="false">50:14 </char><char style="xt" closed="false"><ref loc="PSA 27:6">Sòm 27:6</ref></char></note>yon sakrifis remèsiman</para>
  <para style="q1" vid="PSA 50:14">e peye ve ou yo a Pi Wo a.<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>Rele Mwen nan jou twoub la.</para>
  <para style="q1" vid="PSA 50:15">Mwen va <note caller="+" style="x"><char style="xo" closed="false">50:15 </char><char style="xt" closed="false"><ref loc="PSA 81:7">Sòm 81:7</ref></char></note>delivre ou e ou va onore M.”<verse eid="PSA 50:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16"/>Men a mechan yo Bondye di:</para>
  <para style="q1" vid="PSA 50:16">“Ki dwa ou genyen pou pale sou règleman Mwen yo,</para>
  <para style="q1" vid="PSA 50:16">pou pran <note caller="+" style="x"><char style="xo" closed="false">50:16 </char><char style="xt" closed="false"><ref loc="ISA 29:13">És 29:13</ref></char></note>akò Mwen an nan bouch ou?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>Paske ou <note caller="+" style="x"><char style="xo" closed="false">50:17 </char><char style="xt" closed="false"><ref loc="PRO 5:12">Pwov 5:12</ref></char></note>rayi disiplin, e jete pawòl Mwen yo dèyè w.<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>Lè ou wè yon vòlè, ou vin dakò avè l,</para>
  <para style="q1" vid="PSA 50:18">epi ou asosye ou avèk moun adiltè yo.<verse eid="PSA 50:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>Ou lage bouch ou nèt nan mechanste.</para>
  <para style="q1" vid="PSA 50:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">50:19 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 36:3">Sòm 36:3</ref>
      </char>
    </note>Lang ou fè ankadreman pou manti.<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>Ou chita <note caller="+" style="x"><char style="xo" closed="false">50:20 </char><char style="xt" closed="false"><ref loc="JOB 19:18">Job 19:18</ref></char></note>pale kont frè ou.</para>
  <para style="q1" vid="PSA 50:20">Ou fè kout lang fò kont pwòp pitit manman ou.<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>Bagay sa yo, ou te fè yo,</para>
  <para style="q1" vid="PSA 50:21">e Mwen pa t di yon mo.</para>
  <para style="q1" vid="PSA 50:21">Ou te konprann ke M te menm jan ak ou.</para>
  <para style="q1" vid="PSA 50:21">Mwen va <note caller="+" style="x"><char style="xo" closed="false">50:21 </char><char style="xt" closed="false"><ref loc="PSA 90:8">Sòm 90:8</ref></char></note>repwoche ou</para>
  <para style="q1" vid="PSA 50:21">e pale ka a an lòd devan zye ou.<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>Alò, konsidere sa, nou menm ki <note caller="+" style="x"><char style="xo" closed="false">50:22 </char><char style="xt" closed="false"><ref loc="JOB 8:13">Job 8:13</ref></char></note>bliye Bondye,</para>
  <para style="q1" vid="PSA 50:22">oswa, Mwen va chire nou an mòso,</para>
  <para style="q1" vid="PSA 50:22">e p ap gen pèsòn ki pou sove nou.<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>Sila ki ofri yon sakrifis remèsiman onore M,</para>
  <para style="q1" vid="PSA 50:23">epi a sila ki fè chemen li dwat la,</para>
  <para style="q1" vid="PSA 50:23">Mwen va montre li sali Bondye a.”<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="d">Yon Sòm David lè pwofèt la, Nathan te rive kote li lè l te fin ale kote Bath-Schéba.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>Fè m gras, O Bondye, selon lanmou dous Ou a.</para>
  <para style="q1" vid="PSA 51:1">Selon grandè a mizerikòd ou,</para>
  <para style="q1" vid="PSA 51:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">51:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 51:9">Sòm 51:9</ref>
      </char>
    </note>efase transgresyon mwen yo.<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>Lave m nèt de inikite mwen yo e</para>
  <para style="q1" vid="PSA 51:2">netwaye m de peche mwen an.<verse eid="PSA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>Paske mwen konnen transgresyon mwen yo.</para>
  <para style="q1" vid="PSA 51:3">Peche mwen yo devan m tout tan.<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>Kont Ou, Ou menm sèlman, mwen te peche,</para>
  <para style="q1" vid="PSA 51:4">e te fè mal devan zye Ou.</para>
  <para style="q1" vid="PSA 51:4">Akoz sa, <note caller="+" style="x"><char style="xo" closed="false">51:4 </char><char style="xt" closed="false"><ref loc="ROM 3:4">Wo 3:4</ref></char></note>Ou jis lè Ou pale, e san tò lè Ou jije.<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>Gade byen, mwen te fèt nan inikite,</para>
  <para style="q1" vid="PSA 51:5">e se nan peche manman m te vin ansent mwen.<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>Men vwala, Ou vle verite a menm nan pati anndan m nèt.</para>
  <para style="q1" vid="PSA 51:6">Nan pati kache anndan m, Ou va <note caller="+" style="x"><char style="xo" closed="false">51:6 </char><char style="xt" closed="false"><ref loc="PRO 2:6">Pwov 2:6</ref></char></note>fè m konnen sajès.<verse eid="PSA 51:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>Pirifye m ak izòp e mwen va pwòp.</para>
  <para style="q1" vid="PSA 51:7">Lave mwen e mwen va <note caller="+" style="x"><char style="xo" closed="false">51:7 </char><char style="xt" closed="false"><ref loc="ISA 1:18">És 1:18</ref></char></note>pi blan ke lanèj.<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>Fè m tande lajwa avèk kè kontan,</para>
  <para style="q1" vid="PSA 51:8">pou <note caller="+" style="x"><char style="xo" closed="false">51:8 </char><char style="xt" closed="false"><ref loc="PSA 35:10">Sòm 35:10</ref></char></note>zo ke Ou te kase yo, vin rejwi.<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">51:9 </char>
      <char style="xt" closed="false">
        <ref loc="JER 16:17">Jr 16:17</ref>
      </char>
    </note>Kache figi Ou de peche m yo.</para>
  <para style="q1" vid="PSA 51:9">Efase tout inikite mwen yo.<verse eid="PSA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>Kreye nan mwen yon kè pwòp, O SENYÈ,</para>
  <para style="q1" vid="PSA 51:10">epi refè yon lespri ki <note caller="+" style="x"><char style="xo" closed="false">51:10 </char><char style="xt" closed="false"><ref loc="PSA 78:37">Sòm 78:37</ref></char></note>dwat anndan m.<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>Pa jete mwen lwen prezans Ou e</para>
  <para style="q1" vid="PSA 51:11">pa retire <note caller="+" style="x"><char style="xo" closed="false">51:11 </char><char style="xt" closed="false"><ref loc="ISA 63:10-11">És 63:10-11</ref></char></note>Lespri Sen Ou an sou mwen.<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>Restore nan mwen lajwa sali Ou a.</para>
  <para style="q1" vid="PSA 51:12">Ranfòse m avèk yon lespri bòn volonte.<verse eid="PSA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>Konsa, mwen va enstwi transgresè yo chemen Ou yo,</para>
  <para style="q1" vid="PSA 51:13">e <note caller="+" style="x"><char style="xo" closed="false">51:13 </char><char style="xt" closed="false"><ref loc="PSA 22:27">Sòm 22:27</ref></char></note>pechè yo va konvèti a Ou menm.<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>Delivre mwen de <note caller="+" style="x"><char style="xo" closed="false">51:14 </char><char style="xt" closed="false"><ref loc="2SA 12:9">II Sam 12:9</ref></char></note>koupabilite san vèse a,</para>
  <para style="q1" vid="PSA 51:14">O Bondye, Bondye a sali mwen an.</para>
  <para style="q1" vid="PSA 51:14">Konsa, lang mwen va chante avèk jwa</para>
  <para style="q1" vid="PSA 51:14">selon ladwati a Ou menm nan.<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>O Mèt mwen an, <note caller="+" style="x"><char style="xo" closed="false">51:15 </char><char style="xt" closed="false"><ref loc="EXO 4:15">Egz 4:15</ref></char></note>ouvri lèv mwen</para>
  <para style="q1" vid="PSA 51:15">pou m kab deklare lwanj Ou.<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>Paske Ou <note caller="+" style="x"><char style="xo" closed="false">51:16 </char><char style="xt" closed="false"><ref loc="1SA 15:22">I Sam 15:22</ref></char></note>pa pran plezi nan sakrifis.</para>
  <para style="q1" vid="PSA 51:16">Otreman, mwen ta bay li.</para>
  <para style="q1" vid="PSA 51:16">Ofrann brile yo pa fè Ou kontan.<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>Sakrifis a Bondye yo se yon <note caller="+" style="x"><char style="xo" closed="false">51:17 </char><char style="xt" closed="false"><ref loc="PSA 34:18">Sòm 34:18</ref></char></note>espri ki kraze.</para>
  <para style="q1" vid="PSA 51:17">Yon kè brize e ki repantan, O Bondye,</para>
  <para style="q1" vid="PSA 51:17">Ou p ap meprize l.<verse eid="PSA 51:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>Avèk <note caller="+" style="x"><char style="xo" closed="false">51:18 </char><char style="xt" closed="false"><ref loc="PSA 69:35">Sòm 69:35</ref></char></note>bonte Ou, fè byen pou Sion.</para>
  <para style="q1" vid="PSA 51:18">Bati miray a Jérusalem yo.<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>Konsa, Ou va rejwi nan <note caller="+" style="x"><char style="xo" closed="false">51:19 </char><char style="xt" closed="false"><ref loc="PSA 4:5">Sòm 4:5</ref></char></note>sakrifis ladwati yo,</para>
  <para style="q1" vid="PSA 51:19">nan ofrann brile avèk ofrann brile nèt yo.</para>
  <para style="q1" vid="PSA 51:19">Konsa, jenn towo yo va ofri sou lotèl Ou a.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="d">Pou direktè koral la. Yon Sòm David, lè Doeg, Edomit lan te vin di Saül “David gen tan rive lakay Achimélic.”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>Poukisa ou ògeye nan mechanste ou, O lòm pwisan?</para>
  <para style="q1" vid="PSA 52:1">Lanmou dous Bondye a dire tout lajounen.<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>Lang ou envante destriksyon,</para>
  <para style="q1" vid="PSA 52:2">tankou yon razwa ki file, plen desepsyon.<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>Ou <note caller="+" style="x"><char style="xo" closed="false">52:3 </char><char style="xt" closed="false"><ref loc="PSA 36:4">Sòm 36:4</ref></char></note>renmen mechanste plis pase sa ki bon.</para>
  <para style="q1" vid="PSA 52:3">Fo bagay plis pase pale verite a.<verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>Ou renmen tout pawòl ki devore,</para>
  <para style="q1" vid="PSA 52:4">yon lang <note caller="+" style="x"><char style="xo" closed="false">52:4 </char><char style="xt" closed="false"><ref loc="PSA 120:3">Sòm 120:3</ref></char></note>mantè.<verse eid="PSA 52:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>Men Bondye va kase fè ou desann nèt;</para>
  <para style="q1" vid="PSA 52:5">Li va kenbe ou byen vit e <note caller="+" style="x"><char style="xo" closed="false">52:5 </char><char style="xt" closed="false"><ref loc="ISA 22:18-19">És 22:18-19</ref></char></note>chire fè ou</para>
  <para style="q1" vid="PSA 52:5">sòti nan tant ou an,</para>
  <para style="q1" vid="PSA 52:5">Epi dechouke fè ou sòti nan peyi vivan yo. <char style="qs">Tan</char><verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>Moun dwat yo va <note caller="+" style="x"><char style="xo" closed="false">52:6 </char><char style="xt" closed="false"><ref loc="PSA 37:34">Sòm 37:34</ref></char></note>wè, va gen lakrent;</para>
  <para style="q1" vid="PSA 52:6">yo va ri sou li epi di:<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“Gade byen, men nonm ki refize pran refij nan Bondye a,</para>
  <para style="q1" vid="PSA 52:7">men ki te mete konfyans nan abondans richès li yo.</para>
  <para style="q1" vid="PSA 52:7">Li te ranfòse tèt li ak mechanste.”<verse eid="PSA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>Men pou mwen menm, mwen tankou yon pye doliv vèt lakay Bondye.</para>
  <para style="q1" vid="PSA 52:8">Mwen mete <note caller="+" style="x"><char style="xo" closed="false">52:8 </char><char style="xt" closed="false"><ref loc="PSA 13:5">Sòm 13:5</ref> </char></note>konfyans mwen nan lanmou dous Bondye a</para>
  <para style="q1" vid="PSA 52:8">pou tout tan e pou tout tan.<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">52:9 </char><char style="xt" closed="false"><ref loc="PSA 30:12">Sòm 30:12</ref></char></note>bay Ou remèsiman pou tout tan, paske Ou te fè sa.</para>
  <para style="q1" vid="PSA 52:9">Mwen va mete espwa nan non Ou,</para>
  <para style="q1" vid="PSA 52:9">paske sa bon nan prezans a fidèl Ou yo.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="d">Pou direktè koral la; selon mizik Mahalath</para>
  <para style="d">Yon refleksyon pa David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>Moun fou a di nan kè li: “Nanpwen Bondye”.</para>
  <para style="q1" vid="PSA 53:1">Yo konwonpi!</para>
  <para style="q1" vid="PSA 53:1">Yo fè zak enjis ki abominab.</para>
  <para style="q1" vid="PSA 53:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">53:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:10">Wo 3:10</ref>
      </char>
    </note>Nanpwen ki fè sa ki bon.<verse eid="PSA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>Bondye te gade anba soti nan syèl la sou fis a lòm yo,</para>
  <para style="q1" vid="PSA 53:2">pou wè si genyen <note caller="+" style="x"><char style="xo" closed="false">53:2 </char><char style="xt" closed="false"><ref loc="ROM 3:11">Wo 3:11</ref></char></note>youn ki gen bon konprann, ka p chache Bondye.<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">53:3 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:12">Wo 3:12</ref>
      </char>
    </note>Yo tout te vire akote.</para>
  <para style="q1" vid="PSA 53:3">Ansanm yo vin konwonpi.</para>
  <para style="q1" vid="PSA 53:3">Nanpwen nan yo ki fè byen, pa menm youn.<verse eid="PSA 53:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>Èske malfektè a mechanste sila yo pa gen okenn konesans,</para>
  <para style="q1" vid="PSA 53:4">ka p <note caller="+" style="x"><char style="xo" closed="false">53:4 </char><char style="xt" closed="false"><ref loc="JER 4:22">Jr 4:22</ref></char></note>manje pèp Mwen an konsi se pen yo manje,</para>
  <para style="q1" vid="PSA 53:4">epi ki pa rele Bondye?<verse eid="PSA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>La, yo te nan gwo laperèz kote pa te gen laperèz,</para>
  <para style="q1" vid="PSA 53:5">paske Bondye te gaye zo a sila ki fè kan kont ou yo.</para>
  <para style="q1" vid="PSA 53:5">Ou te fè yo vin wont, akoz <note caller="+" style="x"><char style="xo" closed="false">53:5 </char><char style="xt" closed="false"><ref loc="2KI 17:20">II Wa 17:20</ref></char></note>Bondye te rejte yo.<verse eid="PSA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>O ke <note caller="+" style="x"><char style="xo" closed="false">53:6 </char><char style="xt" closed="false"><ref loc="PSA 14:7">Sòm 14:7</ref></char></note>delivrans Israël ta parèt sòti Sion!</para>
  <para style="q1" vid="PSA 53:6">Lè Bondye restore pèp kaptif Li a,</para>
  <para style="q1" vid="PSA 53:6">kite Jacob rejwi, kite Israël fè kè kontan.<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="d">Pou direktè koral la; sou enstriman ak kòd yo. Yon sòm</para>
  <para style="d">a David, lè Zifyen yo te vin di Saül: “Èske David pa kache pami nou?”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>Sove mwen, O Bondye, ak non Ou</para>
  <para style="q1" vid="PSA 54:1">e fè vanjans mwen ak pouvwa Ou.<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>Koute lapriyè mwen, O Bondye.</para>
  <para style="q1" vid="PSA 54:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">54:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:1">Sòm 5:1</ref>
      </char>
    </note>Prete zòrèy a pawòl a bouch mwen.<verse eid="PSA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>Paske etranje yo fin leve kont mwen.</para>
  <para style="q1" vid="PSA 54:3">Moun vyolans yo te chache lavi mwen.</para>
  <para style="q1" vid="PSA 54:3">Yo <note caller="+" style="x"><char style="xo" closed="false">54:3 </char><char style="xt" closed="false"><ref loc="PSA 36:1">Sòm 36:1</ref> </char></note>pa t mete Bondye devan yo.<verse eid="PSA 54:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>Gade byen, Bondye se èd mwen.</para>
  <para style="q1" vid="PSA 54:4">SENYÈ a se <note caller="+" style="x"><char style="xo" closed="false">54:4 </char><char style="xt" closed="false"><ref loc="PSA 37:17-24">Sòm 37:17-24</ref> </char></note>soutyen a nanm mwen.<verse eid="PSA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>Li va rekonpanse mal a lènmi mwen yo.</para>
  <para style="q1" vid="PSA 54:5">Detwi yo <note caller="+" style="x"><char style="xo" closed="false">54:5 </char><char style="xt" closed="false"><ref loc="PSA 89:49">Sòm 89:49</ref> </char></note>nan fidelite Ou.<verse eid="PSA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">54:6 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 15:3">Nonb 15:3</ref>
      </char>
    </note>Avèk bòn volonte, mwen va fè sakrifis a Ou.</para>
  <para style="q1" vid="PSA 54:6">Mwen va bay remèsiman a non Ou, O SENYÈ, paske li bon.<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>Paske Li te <note caller="+" style="x"><char style="xo" closed="false">54:7 </char><char style="xt" closed="false"><ref loc="PSA 34:6">Sòm 34:6</ref></char></note>delivre mwen nan tout twoub.</para>
  <para style="q1" vid="PSA 54:7">Konsa, zye mwen te wè ak kè kontan, defèt lènmi m yo.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="d">Pou direktè koral la; sou enstriman ak kòd yo</para>
  <para style="d">Yon Refleksyon David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>Prete zòrèy a lapriyè mwen, O Bondye.</para>
  <para style="q1" vid="PSA 55:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">55:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:9">Sòm 27:9</ref>
      </char>
    </note>Pa kache Ou menm a siplikasyon mwen yo.<verse eid="PSA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2"/>Prete atansyon a mwen e reponn mwen.</para>
  <para style="q1" vid="PSA 55:2">Mwen pa alèz nan plent mwen yo.</para>
  <para style="q1" vid="PSA 55:2">Anverite, mwen deranje nèt<verse eid="PSA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3"/>akoz vwa lènmi an,</para>
  <para style="q1" vid="PSA 55:3">akoz presyon mechan an.</para>
  <para style="q1" vid="PSA 55:3">Paske yo <note caller="+" style="x"><char style="xo" closed="false">55:3 </char><char style="xt" closed="false"><ref loc="2SA 16:7-8">II Sam 16:7-8</ref></char></note>pote twoub desann sou mwen.</para>
  <para style="q1" vid="PSA 55:3">Nan kòlè yo, yo pote rankin kont mwen.<verse eid="PSA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">55:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:8">Sòm 38:8</ref>
      </char>
    </note>Kè m twouble anndan m.</para>
  <para style="q1" vid="PSA 55:4">Sezisman lanmò fin tonbe sou mwen.<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>Laperèz avèk tranbleman fin rive sou mwen.</para>
  <para style="q1" vid="PSA 55:5">Mwen <note caller="+" style="x"><char style="xo" closed="false">55:5 </char><char style="xt" closed="false"><ref loc="PSA 21:6">21:6</ref> </char></note>etone jiskaske m debòde.<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>Mwen te di: “O ke m te gen zèl kon toutrèl la!</para>
  <para style="q1" vid="PSA 55:6">Konsa, mwen ta sove ale pou <note caller="+" style="x"><char style="xo" closed="false">55:6 </char><char style="xt" closed="false"><ref loc="JOB 3:13">Job 3:13</ref></char></note>twouve repo.</para>
  <para style="q1" vid="PSA 55:6">Mwen ta demere nan dezè a.”<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>Tande byen, mwen ta rive byen lwen.</para>
  <para style="q1" vid="PSA 55:7">Mwen ta <note caller="+" style="x"><char style="xo" closed="false">55:7 </char><char style="xt" closed="false"><ref loc="1SA 23:14">I Sam 23:14</ref></char></note>ale rete nan savann nan. <char style="qs">Tan</char><verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>Mwen ta fè vit rive kote pou m kache kont <note caller="+" style="x"><char style="xo" closed="false">55:8 </char><char style="xt" closed="false"><ref loc="ISA 4:6">És 4:6</ref></char></note>van tanpèt la,</para>
  <para style="q1" vid="PSA 55:8">kont move tan an.<verse eid="PSA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>Mete yo nan konfizyon, O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">55:9 </char><char style="xt" closed="false"><ref loc="GEN 11:9">Jen 11:9</ref></char></note>divize lang yo,</para>
  <para style="q1" vid="PSA 55:9">paske mwen te wè vyolans avèk goumen nan vil la.<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>Lajounen kon lannwit, yo antoure vil la sou miray li yo.</para>
  <para style="q1" vid="PSA 55:10">Inikite avèk mechanste nan mitan li.<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>Destriksyon ladann.</para>
  <para style="q1" vid="PSA 55:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">55:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:7">Sòm 10:7</ref>
      </char>
    </note>Opresyon avèk desepsyon pa janm kite lari li yo.<verse eid="PSA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>Paske <note caller="+" style="x"><char style="xo" closed="false">55:12 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Sòm 41:9</ref></char></note>se pa lènmi an ki fè m repwòch.</para>
  <para style="q1" vid="PSA 55:12">Konsa, mwen ta kab sipòte l.</para>
  <para style="q1" vid="PSA 55:12">Ni se pa yon moun ki rayi mwen ki vin leve kont mwen.</para>
  <para style="q1" vid="PSA 55:12">Konsa, mwen ta kab kache de li.<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>Men se ou menm, yon nonm parèy mwen, konpanyen mwen ak zanmi mwen.<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>Nou menm, ki te fè kominyon dous ansanm,</para>
  <para style="q1" vid="PSA 55:14">ki te <note caller="+" style="x"><char style="xo" closed="false">55:14 </char><char style="xt" closed="false"><ref loc="PSA 42:4">Sòm 42:4</ref></char></note>mache nan kay Bondye a nan mitan tout pèp la.<verse eid="PSA 55:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>Pou sa a Kite lanmò rive sibitman sou yo.</para>
  <para style="q1" vid="PSA 55:15">Kite yo <note caller="+" style="x"><char style="xo" closed="false">55:15 </char><char style="xt" closed="false"><ref loc="NUM 16:30-33">Nonb 16:30-33</ref></char></note>desann tou vivan kote mò yo ye.</para>
  <para style="q1" vid="PSA 55:15">Paske mechanste a nan abitasyon yo, pami yo, kote yo rete a.<verse eid="PSA 55:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>Pou mwen, mwen va <note caller="+" style="x"><char style="xo" closed="false">55:16 </char><char style="xt" closed="false"><ref loc="PSA 57:2-3">Sòm 57:2-3</ref></char></note>rele Bondye.</para>
  <para style="q1" vid="PSA 55:16">SENYÈ a va sove mwen.<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">55:17 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 141:2">Sòm 141:2</ref>
      </char>
    </note>Nan aswè, nan maten ak midi, mwen va plenyen e bougonnen.</para>
  <para style="q1" vid="PSA 55:17">Li va tande vwa m.<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>Li te rachte nanm mwen anpè,</para>
  <para style="q1" vid="PSA 55:18">soti nan batay ki kont mwen an,</para>
  <para style="q1" vid="PSA 55:18">malgre yo <note caller="+" style="x"><char style="xo" closed="false">55:18 </char><char style="xt" closed="false"><ref loc="PSA 56:2">Sòm 56:2</ref> </char></note>anpil, k ap lite avè m yo.<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>Bondye ki sou fotèy L jis pou tout tan,</para>
  <para style="q1" vid="PSA 55:19">va tande e reponn <note caller="+" style="x"><char style="xo" closed="false">55:19 </char><char style="xt" closed="false"><ref loc="PSA 36:1">Sòm 36:1</ref> </char></note>yo. <char style="qs">Tan</char></para>
  <para style="b" vid="PSA 55:19"/>
  <para style="q1" vid="PSA 55:19">Nan sila pa gen chanjman an.</para>
  <para style="q1" vid="PSA 55:19">Yo pa gen krent Bondye a.<verse eid="PSA 55:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>Li te lonje men li kont moun ki te nan lapè avèk li a.</para>
  <para style="q1" vid="PSA 55:20">Li te <note caller="+" style="x"><char style="xo" closed="false">55:20 </char><char style="xt" closed="false"><ref loc="NUM 30:2">Nonb 30:2</ref> </char></note>vyole akò li a.<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>Pawòl li te pi dous pase bè,</para>
  <para style="q1" vid="PSA 55:21">men ak kè, li te fè lagè.</para>
  <para style="q1" vid="PSA 55:21">Pawòl li yo te <note caller="+" style="x"><char style="xo" closed="false">55:21 </char><char style="xt" closed="false"><ref loc="PSA 12:2">Sòm 12:2</ref></char></note>pi dous pase lwil,</para>
  <para style="q1" vid="PSA 55:21">men se nepe rale yo te ye.<verse eid="PSA 55:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">55:22 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:5">Sòm 37:5</ref>
      </char>
    </note>Voye fado ou sou SENYÈ a, e Li va bay ou soutyen.</para>
  <para style="q1" vid="PSA 55:22">Li p ap janm kite moun ladwati yo ebranle.<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>Men Ou menm, O Bondye, va rale yo desann nan fòs destriksyon an.</para>
  <para style="q1" vid="PSA 55:23">
    <note caller="+" style="x">
      <char style="xo" closed="false">55:23 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:6">Sòm 5:6</ref>
      </char>
    </note>Moun ki vèse san e ki bay manti</para>
  <para style="q1" vid="PSA 55:23">p ap rive fè mwatye nan jou yo.</para>
  <para style="q1" vid="PSA 55:23">Men mwen menm va mete konfyans nan Ou.<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="d">Pou direktè koral la. Yon powèm David lè Filisten yo te sezi li Gath.</para>
  <para style="d">Chante pa melodi “Toutrèl San Chanson Nan Peyi Lwen An”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>Fè m gras, O Bondye, paske lòm fin foule m anba pye;</para>
  <para style="q1" vid="PSA 56:1">Nan goumen tout lajounen, li vin <note caller="+" style="x"><char style="xo" closed="false">56:1 </char><char style="xt" closed="false"><ref loc="PSA 17:9">Sòm 17:9</ref></char></note>oprime mwen.<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>Lènmi m yo vle vale m tout lajounen.</para>
  <para style="q1" vid="PSA 56:2">Yo anpil! Tout sila ki goumen ak ògèy kont mwen yo.<verse eid="PSA 56:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>Lè mwen pè, mwen va mete konfyans nan Ou.<verse eid="PSA 56:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4"/>Nan Bondye, mwen fè lwanj pawòl Li!</para>
  <para style="q1" vid="PSA 56:4">Nan Bondye, mwen te mete konfyans mwen.</para>
  <para style="q1" vid="PSA 56:4">Mwen p ap pè.</para>
  <para style="q1" vid="PSA 56:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">56:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:6">Sòm 118:6</ref>
      </char>
    </note>Kisa lòm ka fè m?<verse eid="PSA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>Tout lajounen, yo <note caller="+" style="x"><char style="xo" closed="false">56:5 </char><char style="xt" closed="false"><ref loc="2PE 3:16">II Pi 3:16</ref></char></note>tòde pawòl mwen yo.</para>
  <para style="q1" vid="PSA 56:5">Tout panse yo kont mwen se pou mal.<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>Yo atake, yo kache, yo veye pa mwen yo.</para>
  <para style="q1" vid="PSA 56:6">Y ap <note caller="+" style="x"><char style="xo" closed="false">56:6 </char><char style="xt" closed="false"><ref loc="PSA 71:10">Sòm 71:10</ref></char></note>tann pou rache lavi m.<verse eid="PSA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>Akoz mechanste sa a, <note caller="+" style="x"><char style="xo" closed="false">56:7 </char><char style="xt" closed="false"><ref loc="PSA 36:12">Sòm 36:12</ref></char></note>jete yo deyò.</para>
  <para style="q1" vid="PSA 56:7">Nan kòlè Ou, fè desann moun sa yo, O Bondye!<verse eid="PSA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>Ou te byen konte tout egare mwen fè.</para>
  <para style="q1" vid="PSA 56:8">Mete tout gout dlo ki sòti nan zye m yo nan boutèy Ou.</para>
  <para style="q1" vid="PSA 56:8">Èske yo tout pa ekri nan <note caller="+" style="x"><char style="xo" closed="false">56:8 </char><char style="xt" closed="false"><ref loc="MAL 3:16">Mal 3:16</ref></char></note>liv Ou a?<verse eid="PSA 56:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>Konsa, lènmi mwen yo va vire fè bak nan jou ke m rele a.</para>
  <para style="q1" vid="PSA 56:9">Men sa m byen konnen: Bondye pou mwen.<verse eid="PSA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>Nan Bondye, ma louwe pawòl li.</para>
  <para style="q1" vid="PSA 56:10">Nan SENYÈ a, ma louwe pawòl li.<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>Nan Bondye, mwen te mete konfyans mwen.</para>
  <para style="q1" vid="PSA 56:11">Mwen p ap pè. Kisa lòm ka fè m?<verse eid="PSA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">56:12 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:14">Sòm 50:14</ref>
      </char>
    </note>Ve Ou yo mare sou mwen, O Bondye.</para>
  <para style="q1" vid="PSA 56:12">Mwen va rann ofrann remèsiman a Ou menm.<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>Paske Ou te delivre nanm mwen soti nan lanmò.</para>
  <para style="q1" vid="PSA 56:13">Ou te anpeche <note caller="+" style="x"><char style="xo" closed="false">56:13 </char><char style="xt" closed="false"><ref loc="PSA 116:8">Sòm 116:8</ref></char></note>pye mwen glise tonbe,</para>
  <para style="q1" vid="PSA 56:13">pou m ta kab mache devan Bondye</para>
  <para style="q1" vid="PSA 56:13">nan limyè a moun vivan yo.<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="d">Pou direktè koral la; jwe a son Al-tashheth</para>
  <para style="d">Yon Mikhtam David, lè l te sove ale devan Saül nan kav la</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>Fè m gras, SENYÈ, O Bondye, fè m gras,</para>
  <para style="q1" vid="PSA 57:1">paske nanm mwen kache nan Ou.</para>
  <para style="q1" vid="PSA 57:1">Wi, nan <note caller="+" style="x"><char style="xo" closed="false">57:1 </char><char style="xt" closed="false"><ref loc="RUT 2:12">Rt 2:12</ref></char></note>lonbraj a zèl Ou, mwen va kache,</para>
  <para style="q1" vid="PSA 57:1">jiskaske destriksyon an fin pase.<verse eid="PSA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>Mwen va kriye a Bondye Pi Wo a,</para>
  <para style="q1" vid="PSA 57:2">a Bondye ki <note caller="+" style="x"><char style="xo" closed="false">57:2 </char><char style="xt" closed="false"><ref loc="PSA 138:8">Sòm 138:8</ref></char></note>acheve tout sa m mande an.<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>Li va <note caller="+" style="x"><char style="xo" closed="false">57:3 </char><char style="xt" closed="false"><ref loc="PSA 18:16">Sòm 18:16</ref></char></note>voye sòti nan syèl la pou sove mwen.</para>
  <para style="q1" vid="PSA 57:3">Li fè repwòch a sila ki foule mwen an. <char style="qs">Tan</char></para>
  <para style="q1" vid="PSA 57:3">Bondye va voye fè rive lanmou dous Li ak verite Li.<verse eid="PSA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>Nanm mwen rete pami <note caller="+" style="x"><char style="xo" closed="false">57:4 </char><char style="xt" closed="false"><ref loc="PSA 35:17">Sòm 35:17</ref></char></note>lyon yo.</para>
  <para style="q1" vid="PSA 57:4">Mwen oblije kouche pami sila k ap respire dife yo.</para>
  <para style="q1" vid="PSA 57:4">Fis a lòm yo menm ak dan kon frenn file,</para>
  <para style="q1" vid="PSA 57:4">epi lang yo kon yon epe file.<verse eid="PSA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">57:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:11">Sòm 57:11</ref>
      </char>
    </note>Leve anwo syèl yo, O Bondye;</para>
  <para style="q1" vid="PSA 57:5">Kite glwa Ou vin pi wo sou tout latè!<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>Yo te prepare yon gwo filè pou pa mwen yo;</para>
  <para style="q1" vid="PSA 57:6">Nanm mwen koube ba.</para>
  <para style="q1" vid="PSA 57:6">Yo te <note caller="+" style="x"><char style="xo" closed="false">57:6 </char><char style="xt" closed="false"><ref loc="PSA 7:15">Sòm 7:15</ref></char></note>fouye yon fòs devan m.</para>
  <para style="q1" vid="PSA 57:6">Yo te tonbe nan mitan li. <char style="qs">Tan</char><verse eid="PSA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">57:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 112:7">Sòm 112:7</ref>
      </char>
    </note>Kè m kanpe fèm, O Bondye,</para>
  <para style="q1" vid="PSA 57:7">kè m fèm.</para>
  <para style="q1" vid="PSA 57:7">Mwen va chante, wi mwen va chante lwanj!<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>Leve, <note caller="+" style="x"><char style="xo" closed="false">57:8 </char><char style="xt" closed="false"><ref loc="PSA 16:9">Sòm 16:9</ref></char></note>glwa mwen! Leve ap avèk gita!</para>
  <para style="q1" vid="PSA 57:8">Mwen va fè maten vin leve.<verse eid="PSA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">57:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 108:3">Sòm 108:3</ref>
      </char>
    </note>Mwen va bay Ou remèsiman, O SENYÈ, pami pèp yo.</para>
  <para style="q1" vid="PSA 57:9">Mwen va chante lwanj ou pami nasyon yo.<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>Paske <note caller="+" style="x"><char style="xo" closed="false">57:10 </char><char style="xt" closed="false"><ref loc="PSA 36:5">Sòm 36:5</ref></char></note>lanmou dous Ou a gran jis rive nan syèl yo,</para>
  <para style="q1" vid="PSA 57:10">epi verite Ou jis rive nan nwaj yo.<verse eid="PSA 57:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">57:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:5">Sòm 57:5</ref>
      </char>
    </note>Leve anwo syèl yo, O Bondye.</para>
  <para style="q1" vid="PSA 57:11">Ke Glwa Ou kapab vin pi wo ke tout latè.<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="d">Pou direktè koral la; Nan melodi la “Pa Detwi”. Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>Vrèman, èske nou pale ladwati, O lòt dye yo?</para>
  <para style="q1" vid="PSA 58:1">Èske nou <note caller="+" style="x"><char style="xo" closed="false">58:1 </char><char style="xt" closed="false"><ref loc="PSA 82:2">Sòm 82:2</ref></char></note> jije san fòt, O fis a lòm yo?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>Non, nan kè, nou <note caller="+" style="x"><char style="xo" closed="false">58:2 </char><char style="xt" closed="false"><ref loc="MAL 3:15">Mal 3:15</ref></char></note> fòmante inikite.</para>
  <para style="q1" vid="PSA 58:2">Sou latè, nou peze balans pou separe</para>
  <para style="q1" vid="PSA 58:2">bay vyolans ak men nou.<verse eid="PSA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>Mechan yo pèvès depi nan vant.</para>
  <para style="q1" vid="PSA 58:3">Sila ki bay manti yo fè move wout depi nesans yo.<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>Yo gen pwazon tankou <note caller="+" style="x"><char style="xo" closed="false">58:4 </char><char style="xt" closed="false"><ref loc="DEU 32:33">Det 32:33</ref></char></note>pwazon sèpan.</para>
  <para style="q1" vid="PSA 58:4">Kon vipè soud ki bouche zòrèy li,<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>pou li pa tande vwa a sila k ap chame li yo,</para>
  <para style="q1" vid="PSA 58:5">malgre se yon <note caller="+" style="x"><char style="xo" closed="false">58:5 </char><char style="xt" closed="false"><ref loc="ECC 10:11">Ekl 10:11</ref></char></note> majisyen abil k ap fè wanga.<verse eid="PSA 58:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>O Bondye, <note caller="+" style="x"><char style="xo" closed="false">58:6 </char><char style="xt" closed="false"><ref loc="JOB 4:10">Job 4:10</ref></char></note>kraze dan nan bouch yo!</para>
  <para style="q1" vid="PSA 58:6">Kase gwo dan a jenn lyon an, O SENYÈ.<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>Kite yo <note caller="+" style="x"><char style="xo" closed="false">58:7 </char><char style="xt" closed="false"><ref loc="JOS 2:11">Jos 2:11</ref></char></note>koule disparèt tankou dlo k ap kouri sou tè.</para>
  <para style="q1" vid="PSA 58:7">Lè flèch li yo parèt, kite yo fèt tankou shaf san tèt.<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>Kite yo tankou kalmason ki fonn,</para>
  <para style="q1" vid="PSA 58:8">ki vin disparèt pandan l ap mache,</para>
  <para style="q1" vid="PSA 58:8">tankou <note caller="+" style="x"><char style="xo" closed="false">58:8 </char><char style="xt" closed="false"><ref loc="JOB 3:16">Job 3:16</ref></char></note>avòtman a yon fanm ki p ap janm wè solèy la.<verse eid="PSA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>Avan chodyè ou yo kab santi dife pikan yo,</para>
  <para style="q1" vid="PSA 58:9">Li va <note caller="+" style="x"><char style="xo" closed="false">58:9 </char><char style="xt" closed="false"><ref loc="JOB 27:21">Job 27:21</ref></char></note>bale yo fè yo disparèt nan van toubiyon;</para>
  <para style="q1" vid="PSA 58:9">vèt ak sila kap brile yo, ansanm.<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>Moun ladwati a va rejwi lè l wè <note caller="+" style="x"><char style="xo" closed="false">58:10 </char><char style="xt" closed="false"><ref loc="DEU 32:43">Det 32:43</ref></char></note>vanjans lan.</para>
  <para style="q1" vid="PSA 58:10">Li va lave pye li nan san a mechan yo,<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>pou moun yo di: “Anverite, gen yon rekonpans pou moun ladwati yo.</para>
  <para style="q1" vid="PSA 58:11">Anverite, genyen yon Bondye k ap jije latè!”<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="d">Pou direktè koral la; Nan melodi la “Pa Detwi”. Yon powèm David lè Saül te voye yo lakay pou touye l.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">59:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 143:9">Sòm 143:9</ref>
      </char>
    </note>Delivre mwen de lènmi m yo, O Bondye mwen;</para>
  <para style="q1" vid="PSA 59:1">Plase mwen byen wo an sekirite</para>
  <para style="q1" vid="PSA 59:1">byen lwen de sila ki leve kont mwen yo.<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>Delivre m de sila ki fè inikite yo,</para>
  <para style="q1" vid="PSA 59:2">e sove mwen de <note caller="+" style="x"><char style="xo" closed="false">59:2 </char><char style="xt" closed="false"><ref loc="PSA 26:9">Sòm 26:9</ref></char></note>moun ki vèse san yo.<verse eid="PSA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>Paske gade byen, yo <note caller="+" style="x"><char style="xo" closed="false">59:3 </char><char style="xt" closed="false"><ref loc="PSA 56:6">Sòm 56:6</ref></char></note>fè anbiskad pou lavi m.</para>
  <para style="q1" vid="PSA 59:3">Mesye fewòs ki fè atak kont mwen yo,</para>
  <para style="q1" vid="PSA 59:3">pa akoz transgresyon mwen, ni peche m, O SENYÈ.<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>Se pa akoz mwen koupab ke yo vin kouri mete yo kont mwen an.</para>
  <para style="q1" vid="PSA 59:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">59:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:6">Sòm 7:6</ref>
      </char>
    </note>Leve Ou menm pou wè, e fè m sekou!<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>Ou menm, O SENYÈ Bondye dèzame yo, Bondye Israël la,</para>
  <para style="q1" vid="PSA 59:5">leve e pini tout nasyon yo.</para>
  <para style="q1" vid="PSA 59:5">Pa bay gras a moun mechan yo ki fè trèt nan inikite. <char style="qs">Tan</char><verse eid="PSA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>Yo retounen nan aswè.</para>
  <para style="q1" vid="PSA 59:6">Yo rele tankou <note caller="+" style="x"><char style="xo" closed="false">59:6 </char><char style="xt" closed="false"><ref loc="PSA 22:16">Sòm 22:16</ref> </char></note>chen pandan yo antoure lavil la.<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>Gade byen, yo fè pete gwo gaz ak bouch yo.</para>
  <para style="q1" vid="PSA 59:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">59:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:4">Sòm 57:4</ref>
      </char>
    </note>Nepe yo nan lèv yo, paske yo di:</para>
  <para style="q1" vid="PSA 59:7">“Kilès ki tande”?<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>Men Ou menm, O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">59:8 </char><char style="xt" closed="false"><ref loc="PSA 37:13">Sòm 37:13</ref></char></note>ri sou yo!</para>
  <para style="q1" vid="PSA 59:8">Ou menm, giyonnen tout nasyon sa yo.<verse eid="PSA 59:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>O Fòs mwen, m ap veye tann Ou.</para>
  <para style="q1" vid="PSA 59:9">Bondye se <note caller="+" style="x"><char style="xo" closed="false">59:9 </char><char style="xt" closed="false"><ref loc="PSA 9:9">Sòm 9:9</ref></char></note> sitadèl mwen.<verse eid="PSA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10"/>Bondye mwen an ak lanmou dous Li a, va devan m.</para>
  <para style="q1" vid="PSA 59:10">Bondye va kite mwen <note caller="+" style="x"><char style="xo" closed="false">59:10 </char><char style="xt" closed="false"><ref loc="PSA 54:7">Sòm 54:7</ref> </char></note>triyonfè sou advèsè mwen yo.<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>Pa fin touye yo, <note caller="+" style="x"><char style="xo" closed="false">59:11 </char><char style="xt" closed="false"><ref loc="DEU 4:9">Det 4:9</ref></char></note> sinon moun mwen yo ka bliye.</para>
  <para style="q1" vid="PSA 59:11">Gaye yo avèk pouvwa Ou, e rale fè yo desann,</para>
  <para style="q1" vid="PSA 59:11">O SENYÈ, boukliye nou an.<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>Akoz peche a bouch yo avèk pawòl lèv yo,</para>
  <para style="q1" vid="PSA 59:12">Kite yo <note caller="+" style="x"><char style="xo" closed="false">59:12 </char><char style="xt" closed="false"><ref loc="ZEP 3:11">So 3:11</ref> </char></note>sezi pran nan pwòp ògèy yo.</para>
  <para style="q1" vid="PSA 59:12">Paske se malediksyon avèk manti yo bay.<verse eid="PSA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13"/>Detwi yo nan kòlè Ou!</para>
  <para style="q1" vid="PSA 59:13">Detwi yo pou yo disparèt nèt.</para>
  <para style="q1" vid="PSA 59:13">Pou Moun kab <note caller="+" style="x"><char style="xo" closed="false">59:13 </char><char style="xt" closed="false"><ref loc="PSA 83:18">Sòm 83:18</ref> </char></note>konnen se Bondye k ap renye sou Jacob,</para>
  <para style="q1" vid="PSA 59:13">jis rive sou tout latè. <char style="qs">Tan</char><verse eid="PSA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>Kite yo <note caller="+" style="x"><char style="xo" closed="false">59:14 </char><char style="xt" closed="false"><ref loc="PSA 59:6">Sòm 59:6</ref></char></note>retounen nan aswè.</para>
  <para style="q1" vid="PSA 59:14">Kite yo rele anlè tankou chen, pandan yo antoure vil la.<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>Yo <note caller="+" style="x"><char style="xo" closed="false">59:15 </char><char style="xt" closed="false"><ref loc="JOB 15:23">Job 15:23</ref></char></note>gaye toupatou.</para>
  <para style="q1" vid="PSA 59:15">Yap tan tout lanwit si yo pa satisfè.<verse eid="PSA 59:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>Men pou mwen, mwen va chante de fòs Ou.</para>
  <para style="q1" vid="PSA 59:16">Wi, avèk jwa, mwen va chante sou lanmou dous Ou nan maten.</para>
  <para style="q1" vid="PSA 59:16">Paske Ou te toujou sitadèl mwen,</para>
  <para style="q1" vid="PSA 59:16">yon <note caller="+" style="x"><char style="xo" closed="false">59:16 </char><char style="xt" closed="false"><ref loc="2SA 22:3">II Sam 22:3</ref> </char></note>pwotèj nan jou gran twoub mwen an.<verse eid="PSA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>A Ou menm, gran fòs mwen, mwen va chante lwanj a Ou menm.</para>
  <para style="q1" vid="PSA 59:17">Paske Bondye se sitadèl mwen,</para>
  <para style="q1" vid="PSA 59:17">Bondye ki montre mwen lanmou dous la.<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="d">Pou direktè koral la; selon melodi “Lis Akò La”.</para>
  <para style="d">Yon powèm David, pou enstwi; lè l te lite avèk Aram-Naharaim e avèk Aram-Zobah; epi, Joab te retounen e te frape douz-mil Edomit nan Vale Sèl la.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>O Bondye, <note caller="+" style="x"><char style="xo" closed="false">60:1 </char><char style="xt" closed="false"><ref loc="PSA 44:9">Sòm 44:9</ref></char></note> Ou te rejte nou.</para>
  <para style="q1" vid="PSA 60:1">Ou te kraze nou.</para>
  <para style="q1" vid="PSA 60:1">Ou te fache.</para>
  <para style="q1" vid="PSA 60:1">O restore nou ankò.<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>Ou te fè <note caller="+" style="x"><char style="xo" closed="false">60:2 </char><char style="xt" closed="false"><ref loc="PSA 18:7">Sòm 18:7</ref></char></note> latè tranble.</para>
  <para style="q1" vid="PSA 60:2">Ou te fann li pou l ouvri.</para>
  <para style="q1" vid="PSA 60:2">Geri brèch li yo, paske l ap sekwe.<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>Ou te <note caller="+" style="x"><char style="xo" closed="false">60:3 </char><char style="xt" closed="false"><ref loc="PSA 66:12">Sòm 66:12</ref></char></note> fè pèp Ou a wè anpil bagay di.</para>
  <para style="q1" vid="PSA 60:3">Ou te bay nou diven pou bwè ki fè nou toudi.<verse eid="PSA 60:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>Ou te bay yon drapo pou sila ki gen lakrent Ou yo,</para>
  <para style="q1" vid="PSA 60:4">pou fè l byen parèt akoz verite a. <char style="qs">Tan</char><verse eid="PSA 60:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>Pou <note caller="+" style="x"><char style="xo" closed="false">60:5 </char><char style="xt" closed="false"><ref loc="DEU 33:12">Det 33:12</ref></char></note> byeneme Ou yo kab delivre,</para>
  <para style="q1" vid="PSA 60:5">Sove avèk men dwat Ou e reponn nou!<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>Bondye te pale nan sentete Li:</para>
  <para style="q1" vid="PSA 60:6">“Mwen va triyonfe!</para>
  <para style="q1" vid="PSA 60:6">Mwen va divize Sichem</para>
  <para style="q1" vid="PSA 60:6">e tire yon lin nan vale <note caller="+" style="x"><char style="xo" closed="false">60:6 </char><char style="xt" closed="false"><ref loc="GEN 33:17">Jen 33:17</ref></char></note>Succoth la.<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>Galaad se pou Mwen e Manassé se pa M.</para>
  <para style="q1" vid="PSA 60:7">Anplis, Éphraïm se kas sou tèt Mwen.</para>
  <para style="q1" vid="PSA 60:7">Juda se <note caller="+" style="x"><char style="xo" closed="false">60:7 </char><char style="xt" closed="false"><ref loc="GEN 49:10">Jen 49:10</ref></char></note>baton wayal Mwen an.<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>Moab se basen lave Mwen.</para>
  <para style="q1" vid="PSA 60:8">Sou <note caller="+" style="x"><char style="xo" closed="false">60:8 </char><char style="xt" closed="false"><ref loc="2SA 8:2-14">II Sam 8:2-14</ref></char></note>Edom, Mwen va jete soulye Mwen.</para>
  <para style="q1" vid="PSA 60:8">Mwen rele viktwa sou peye Filisten yo.”<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>Kilès k ap fè m rive nan vil fòterès la?</para>
  <para style="q1" vid="PSA 60:9">Kilès k ap mennen mwen antre Edom?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>Èske Ou menm, SENYÈ a, pa t <note caller="+" style="x"><char style="xo" closed="false">60:10 </char><char style="xt" closed="false"><ref loc="PSA 60:1">Sòm 60:1</ref></char></note> rejte nou?</para>
  <para style="q1" vid="PSA 60:10">Epi èske Ou p ap sòti avèk lame nou yo, O Bondye?<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>O bannou sekou kont advèsè a,</para>
  <para style="q1" vid="PSA 60:11">paske delivrans pa lòm se an ven.<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>Nan Bondye, nou va fè bèl bagay yo ak gwo kouraj.</para>
  <para style="q1" vid="PSA 60:12">Se Li menm ki va foule lènmi nou yo anba pye.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="d">Pou direktè koral la; sou yon enstriman a kòd; Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>Koute kri mwen, O Bondye.</para>
  <para style="q1" vid="PSA 61:1">Prete atansyon a lapriyè mwen.<verse eid="PSA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>Soti nan dènye pwent latè,</para>
  <para style="q1" vid="PSA 61:2">mwen rele Ou lè kè m fèb;</para>
  <para style="q1" vid="PSA 61:2">Mennen mwen sou wòch</para>
  <para style="q1" vid="PSA 61:2">ki pi wo pase m nan.<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>Paske Ou te yon refij pou mwen,</para>
  <para style="q1" vid="PSA 61:3">yon fò ki wo,</para>
  <para style="q1" vid="PSA 61:3">yon gran fòs kont lènmi yo.<verse eid="PSA 61:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>Kite mwen <note caller="+" style="x"><char style="xo" closed="false">61:4 </char><char style="xt" closed="false"><ref loc="PSA 23:6">Sòm 23:6</ref></char></note> rete nan tant Ou an jis pou tout tan.</para>
  <para style="q1" vid="PSA 61:4">Kite mwen pran refij anba zèl Ou. <char style="qs">Tan</char><verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>Paske Ou te koute ve mwen yo, O Bondye.</para>
  <para style="q1" vid="PSA 61:5">Ou te ban mwen eritaj a sila ki <note caller="+" style="x"><char style="xo" closed="false">61:5 </char><char style="xt" closed="false"><ref loc="DEU 28:58">Det 28:58</ref> </char></note>gen krent non Ou yo.<verse eid="PSA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>Ou va fè lavi a wa a byen long.</para>
  <para style="q1" vid="PSA 61:6">Ane li yo va tankou anpil jenerasyon.<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>Li va abite devan SENYÈ a jis pou tout tan.</para>
  <para style="q1" vid="PSA 61:7">Senyè, bay li <note caller="+" style="x"><char style="xo" closed="false">61:7 </char><char style="xt" closed="false"><ref loc="PSA 40:11">Sòm 40:11</ref></char></note>lanmou dous avèk verite pou li kapab andire.<verse eid="PSA 61:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>Konsa, mwen va chante lwanj Ou jis pou tout tan.</para>
  <para style="q1" vid="PSA 61:8">Konsa, m kapab peye ve mwen yo jou apre jou.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="d">Pou direktè koral la; selon Jeduthun; Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>Nanm mwen ap poze sèl nan Bondye.</para>
  <para style="q1" vid="PSA 62:1">Sali m se nan Li.<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>Se Li sèl ki <note caller="+" style="x"><char style="xo" closed="false">62:2 </char><char style="xt" closed="false"><ref loc="PSA 89:26">Sòm 89:26</ref></char></note> wòch mwen, sali mwen, ak sitadèl mwen.</para>
  <para style="q1" vid="PSA 62:2">Menm gwo sò pa p boulvèse m.<verse eid="PSA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>Pou jiskilè, nou va atake yon nonm?</para>
  <para style="q1" vid="PSA 62:3">Alò, èske nou ta touye li, nou tout,</para>
  <para style="q1" vid="PSA 62:3">tankou yon <note caller="+" style="x"><char style="xo" closed="false">62:3 </char><char style="xt" closed="false"><ref loc="ISA 30:13">És 30:13</ref></char></note> miray k ap panche?</para>
  <para style="q1" vid="PSA 62:3">Tankou yon kloti k ap kraze?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>Yo plen entansyòn pou pouse li soti nan wo pozisyon li.</para>
  <para style="q1" vid="PSA 62:4">Yo <note caller="+" style="x"><char style="xo" closed="false">62:4 </char><char style="xt" closed="false"><ref loc="PSA 4:2">Sòm 4:2</ref></char></note> pran plezi nan tout sa ki fo.</para>
  <para style="q1" vid="PSA 62:4">Yo beni avèk bouch yo, men anndan yo bay madichon.<verse eid="PSA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>Nanm mwen <note caller="+" style="x"><char style="xo" closed="false">62:5 </char><char style="xt" closed="false"><ref loc="PSA 62:1">Sòm 62:1</ref></char></note> tann an silans sèlman Bondye.</para>
  <para style="q1" vid="PSA 62:5">Paske espwa mwen se nan Li.<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>Li se sèl ki <note caller="+" style="x"><char style="xo" closed="false">62:6 </char><char style="xt" closed="false"><ref loc="PSA 62:2">Sòm 62:2</ref></char></note> wòch mwen, sali mwen, ak sitadèl mwen.</para>
  <para style="q1" vid="PSA 62:6">Mwen p ap ebranle menm.<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">62:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 85:9">Sòm 85:9</ref>
      </char>
    </note> Sali mwen an, avèk glwa mwen rete nan Bondye.</para>
  <para style="q1" vid="PSA 62:7">Wòch fòs mwen an, ak kote pou m kache, se nan Bondye.<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>Mete konfyans nan Li tout tan, O pèp la.</para>
  <para style="q1" vid="PSA 62:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">62:8 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 1:15">I Sam 1:15</ref> </char>
    </note>Vide kè nou devan Li.</para>
  <para style="q1" vid="PSA 62:8">Bondye se yon refij pou nou.<verse eid="PSA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>Moun nan <note caller="+" style="x"><char style="xo" closed="false">62:9 </char><char style="xt" closed="false"><ref loc="PSA 49:2">Sòm 49:2</ref></char></note> pozisyon ba yo se se sèl yon souf nan van.</para>
  <para style="q1" vid="PSA 62:9">Moun ki plase wo yo se manti.</para>
  <para style="q1" vid="PSA 62:9">Nan pèz balans yo, se monte, yap monte.</para>
  <para style="q1" vid="PSA 62:9">Ansanm menm, yo pi fay ke yon souf.<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>Pa mete konfyans nan peze kou moun desann.</para>
  <para style="q1" vid="PSA 62:10">Ni pa mete fo espwa nan <note caller="+" style="x"><char style="xo" closed="false">62:10 </char><char style="xt" closed="false"><ref loc="ISA 61:8">És 61:8</ref> </char></note>vòlè.</para>
  <para style="q1" vid="PSA 62:10">Si richès nou ogmante, pa mete kè nou sou yo.<verse eid="PSA 62:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>Yon fwa, Bondye te pale.</para>
  <para style="q1" vid="PSA 62:11">De fwa, mwen gen tan tande sa:</para>
  <para style="q1" vid="PSA 62:11">Ke pouvwa, se pou Bondye.<verse eid="PSA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12"/>Epi anplis, lanmou dous se pou Ou, O Senyè.</para>
  <para style="q1" vid="PSA 62:12">Paske Ou bay rekonpans a lòm selon</para>
  <para style="q1" vid="PSA 62:12">zèv li yo.<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="d">Yon Sòm David, lè l te nan dezè Juda a.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>O Bondye, Ou se Bondye mwen.</para>
  <para style="q1" vid="PSA 63:1">Mwen va chache Ou ak tout kè m.</para>
  <para style="q1" vid="PSA 63:1">Nanm mwen <note caller="+" style="x"><char style="xo" closed="false">63:1 </char><char style="xt" closed="false"><ref loc="PSA 42:2">Sòm 42:2</ref></char></note> swaf pou Ou.</para>
  <para style="q1" vid="PSA 63:1">Chè m anvi Ou nan yon peyi epwize e sèch kote nanpwen dlo.<verse eid="PSA 63:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>Konsa, mwen <note caller="+" style="x"><char style="xo" closed="false">63:2 </char><char style="xt" closed="false"><ref loc="PSA 27:4">Sòm 27:4</ref></char></note> te wè Ou nan sanktiyè a,</para>
  <para style="q1" vid="PSA 63:2">ak pouvwa Ou, ak laglwa Ou.<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>Akoz <note caller="+" style="x"><char style="xo" closed="false">63:3 </char><char style="xt" closed="false"><ref loc="PSA 69:16">Sòm 69:16</ref></char></note> lanmou dous Ou pi bon pase lavi,</para>
  <para style="q1" vid="PSA 63:3">lèv mwen va louwe Ou.<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>Pou sa, mwen va beni Ou <note caller="+" style="x"><char style="xo" closed="false">63:4 </char><char style="xt" closed="false"><ref loc="PSA 104:33">Sòm 104:33</ref></char></note> tout tan ke m viv.</para>
  <para style="q1" vid="PSA 63:4">Mwen va leve men m nan non Ou.<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>Nanm mwen <note caller="+" style="x"><char style="xo" closed="false">63:5 </char><char style="xt" closed="false"><ref loc="PSA 36:8">Sòm 36:8</ref></char></note> satisfè konsi avèk ma zo ak grès,</para>
  <para style="q1" vid="PSA 63:5">e bouch mwen ap ofri lwanj</para>
  <para style="q1" vid="PSA 63:5">avèk lèv ranpli de jwa.<verse eid="PSA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>Lè m sonje Ou sou kabann mwen,</para>
  <para style="q1" vid="PSA 63:6">mwen medite sou Ou nan <note caller="+" style="x"><char style="xo" closed="false">63:6 </char><char style="xt" closed="false"><ref loc="PSA 16:7">Sòm 16:7</ref> </char></note>vèy de nwi la.<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>Paske Ou te konn sekou mwen.</para>
  <para style="q1" vid="PSA 63:7">Nan <note caller="+" style="x"><char style="xo" closed="false">63:7 </char><char style="xt" closed="false"><ref loc="PSA 17:8">Sòm 17:8</ref></char></note> lonbraj a zèl Ou, mwen chante ak jwa.<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>Nanm mwen <note caller="+" style="x"><char style="xo" closed="false">63:8 </char><char style="xt" closed="false"><ref loc="NUM 32:12">Nonb 32:12</ref></char></note> kole ak Ou.</para>
  <para style="q1" vid="PSA 63:8">Men dwat Ou fè m kenbe.<verse eid="PSA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>Men sila ki chache lavi mwen pou detwi li yo,</para>
  <para style="q1" vid="PSA 63:9">va desann <note caller="+" style="x"><char style="xo" closed="false">63:9 </char><char style="xt" closed="false"><ref loc="PSA 55:15">Sòm 55:15</ref> </char></note>jis nan fon latè.<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>Yo va <note caller="+" style="x"><char style="xo" closed="false">63:10 </char><char style="xt" closed="false"><ref loc="JER 18:21">Jr 18:21</ref></char></note> livre a pouvwa nepe.</para>
  <para style="q1" vid="PSA 63:10">Yo va tounen manje pou rena mawon.<verse eid="PSA 63:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>Men Wa a va rejwi nan Bondye.</para>
  <para style="q1" vid="PSA 63:11">Tout moun ki sèmante pa Li menm yo, va twouve glwa.</para>
  <para style="q1" vid="PSA 63:11">Paske bouch a sila ki bay manti yo, va fèmen.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="d">Pou direktè koral la. Yon Sòm David.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>Tande vwa m, O Bondye nan plent mwen an.</para>
  <para style="q1" vid="PSA 64:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">64:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 140:1">Sòm 140:1</ref>
      </char>
    </note>Konsève lavi m kont laperèz lènmi an.<verse eid="PSA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>Pwoteje m kont konsèy sekrè a malfektè yo,</para>
  <para style="q1" vid="PSA 64:2">kont boulvèsman a <note caller="+" style="x"><char style="xo" closed="false">64:2 </char><char style="xt" closed="false"><ref loc="PSA 59:2">Sòm 59:2</ref></char></note>sila ki fè mechanste yo.<verse eid="PSA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>Ki te file lang yo tankou nepe.</para>
  <para style="q1" vid="PSA 64:3">Yo te pwente flèch pawòl anmè yo,<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>pou tire an kachèt sou sila ki inosan yo.</para>
  <para style="q1" vid="PSA 64:4">Sibitman yo tire sou li, san lakrent.<verse eid="PSA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>Yo kenbe fèm a pwòp desen mechan yo.</para>
  <para style="q1" vid="PSA 64:5">Yo pale sou <note caller="+" style="x"><char style="xo" closed="false">64:5 </char><char style="xt" closed="false"><ref loc="PSA 140:5">Sòm 140:5</ref></char></note> pyèj ke y ap fòme an sekrè yo.</para>
  <para style="q1" vid="PSA 64:5">Yo di: “Se kilès ki kab wè yo?”<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>Yo fè manèv pou enjistis e di:</para>
  <para style="q1" vid="PSA 64:6">“Nou prè pou yon konplo byen fòme”.</para>
  <para style="q1" vid="PSA 64:6">Paske panse lenteryè a moun se byen fon.<verse eid="PSA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>Men <note caller="+" style="x"><char style="xo" closed="false">64:7 </char><char style="xt" closed="false"><ref loc="PSA 7:12-13">Sòm 7:12-13</ref></char></note> Bondye va tire sou yo avèk yon flèch.</para>
  <para style="q1" vid="PSA 64:7">Sibitman, yo va blese.<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>Konsa, yo va <note caller="+" style="x"><char style="xo" closed="false">64:8 </char><char style="xt" closed="false"><ref loc="PSA 9:3">Sòm 9:3</ref></char></note> chape tonbe.</para>
  <para style="q1" vid="PSA 64:8">Pwòp lang pa yo va kont yo.</para>
  <para style="q1" vid="PSA 64:8">Tout moun ki wè yo va souke tèt yo.<verse eid="PSA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>Nan moman sa a, tout moun va krent.</para>
  <para style="q1" vid="PSA 64:9">Konsa, yo va <note caller="+" style="x"><char style="xo" closed="false">64:9 </char><char style="xt" closed="false"><ref loc="JER 51:10">Jr 51:10</ref></char></note> deklare zèv Bondye yo.</para>
  <para style="q1" vid="PSA 64:9">Ak sajès yo va konsidere sa Li te fè a.<verse eid="PSA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>Nonm ladwati a va <note caller="+" style="x"><char style="xo" closed="false">64:10 </char><char style="xt" closed="false"><ref loc="JOB 22:19">Job 22:19</ref></char></note> kontan nan SENYÈ a!</para>
  <para style="q1" vid="PSA 64:10">Yo va pran refij nan Li,</para>
  <para style="q1" vid="PSA 64:10">epi tout moun dwat yo va fè kè kontan.<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="d">Pou direktè koral la; yon Sòm David. Yon chan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>Se lwanj k ap tan Ou, O Bondye nan Sion.</para>
  <para style="q1" vid="PSA 65:1">Ve yo va fèt anvè Ou.<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>O Ou menm ki tande priyè yo,</para>
  <para style="q1" vid="PSA 65:2">a Ou menm <note caller="+" style="x"><char style="xo" closed="false">65:2 </char><char style="xt" closed="false"><ref loc="PSA 86:9">Sòm 86:9</ref></char></note>tout moun vini.<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>Inikite m t ap kanpe kont mwen;</para>
  <para style="q1" vid="PSA 65:3">men pou transgresyon nou yo,</para>
  <para style="q1" vid="PSA 65:3">Ou kouvri yo.<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>A la <note caller="+" style="x"><char style="xo" closed="false">65:4 </char><char style="xt" closed="false"><ref loc="PSA 33:12">Sòm 33:12</ref></char></note> beni se sila ke Ou chwazi a e mennen toupre,</para>
  <para style="q1" vid="PSA 65:4">pou l ka rete nan lakou Ou.</para>
  <para style="q1" vid="PSA 65:4">Nou va satisfè ak tout bagay ki bon lakay Ou,</para>
  <para style="q1" vid="PSA 65:4">sen tanp Ou a.<verse eid="PSA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>Avèk <note caller="+" style="x"><char style="xo" closed="false">65:5 </char><char style="xt" closed="false"><ref loc="PSA 45:4">Sòm 45:4</ref></char></note> zèv mèvèy e dwat, Ou reponn nou,</para>
  <para style="q1" vid="PSA 65:5">O Bondye sali nou an.</para>
  <para style="q1" vid="PSA 65:5">Se Ou menm ki espwa tout pwen latè a,</para>
  <para style="q1" vid="PSA 65:5">jis rive nan lanmè pi lwen an.<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>Ki etabli mòn yo pa pwisans Ou,</para>
  <para style="q1" vid="PSA 65:6">Akoz Ou <note caller="+" style="x"><char style="xo" closed="false">65:6 </char><char style="xt" closed="false"><ref loc="PSA 93:1">Sòm 93:1</ref> </char></note>pran zam pwisans Ou.<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>Ou kalme raj vag lanmè yo,</para>
  <para style="q1" vid="PSA 65:7">Avèk gwo boulvèsman lanm yo.<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>Sila ki rete jis nan <note caller="+" style="x"><char style="xo" closed="false">65:8 </char><char style="xt" closed="false"><ref loc="PSA 2:8">Sòm 2:8</ref></char></note> dènye pwent latè yo</para>
  <para style="q1" vid="PSA 65:8">kanpe byen etone a mèvèy Ou yo.</para>
  <para style="q1" vid="PSA 65:8">Ou fè maten avèk aswè kriye ak jwa.<verse eid="PSA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>Ou vizite tè a e fè li gen abondans.</para>
  <para style="q1" vid="PSA 65:9">Ou anrichi li anpil.</para>
  <para style="q1" vid="PSA 65:9">Flèv Bondye a plen ak dlo.</para>
  <para style="q1" vid="PSA 65:9">Ou prepare sereyal yo, paske se konsa ou oganizè l.<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>Ou wouze tranch li yo an abondans.</para>
  <para style="q1" vid="PSA 65:10">Ou fè do li vin poze.</para>
  <para style="q1" vid="PSA 65:10">Ou fè l vin mou <note caller="+" style="x"><char style="xo" closed="false">65:10 </char><char style="xt" closed="false"><ref loc="DEU 32:2">Det 32:2</ref></char></note> ak lapli an abondans;</para>
  <para style="q1" vid="PSA 65:10">Ou beni kwasans plant li.<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>Ou te kouwone ane a avèk <note caller="+" style="x"><char style="xo" closed="false">65:11 </char><char style="xt" closed="false"><ref loc="PSA 104:28">Sòm 104:28</ref></char></note> bonte Ou.</para>
  <para style="q1" vid="PSA 65:11">Kabwa yo plen pwodwi rekòlt la.<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">65:12 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 38:26-27">Job 38:26-27</ref>
      </char>
    </note> Patiraj nan dezè yo gen abondans,</para>
  <para style="q1" vid="PSA 65:12">Epi kolin yo mare senti yo ak jwa.<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>Chan yo <note caller="+" style="x"><char style="xo" closed="false">65:13 </char><char style="xt" closed="false"><ref loc="PSA 144:13">Sòm 144:13</ref></char></note> abiye menm ak bann mouton.</para>
  <para style="q1" vid="PSA 65:13">Vale yo fin ranpli ak sereyal.</para>
  <para style="q1" vid="PSA 65:13">Yo rele fò ak lajwa!</para>
  <para style="q1" vid="PSA 65:13">Konsa, yo chante.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="d">Pou direktè koral la; yon chan, yon Sòm</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">66:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 81:1">Sòm 81:1</ref>
      </char>
    </note> Rele fò ak lajwa a Bondye, tout latè a!<verse eid="PSA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2"/>Chante <note caller="+" style="x"><char style="xo" closed="false">66:2 </char><char style="xt" closed="false"><ref loc="PSA 79:9">Sòm 79:9</ref></char></note> glwa a non Li!</para>
  <para style="q1" vid="PSA 66:2">Ranpli lwanj Li ak laglwa!<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>Di Bondye: “Zèv Ou yo <note caller="+" style="x"><char style="xo" closed="false">66:3 </char><char style="xt" closed="false"><ref loc="PSA 47:2">Sòm 47:2</ref></char></note> mèvèye”!</para>
  <para style="q1" vid="PSA 66:3">Akoz grandè a pwisans Ou, menm,</para>
  <para style="q1" vid="PSA 66:3">lènmi Ou yo va soumèt a Ou.<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">66:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:27">Sòm 22:27</ref>
      </char>
    </note> Tout latè va fè adorasyon a Ou menm.</para>
  <para style="q1" vid="PSA 66:4">Li va chante lwanj Ou.</para>
  <para style="q1" vid="PSA 66:4">Tout va chante lwanj a non Ou; <char style="qs">Tan</char><verse eid="PSA 66:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>Vini pou wè zèv Bondye yo.</para>
  <para style="q1" vid="PSA 66:5">Zèv etonnan anvè fis a lòm yo.<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>Li te <note caller="+" style="x"><char style="xo" closed="false">66:6 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Egz 14:21</ref></char></note> chanje lanmè a an tè sèch.</para>
  <para style="q1" vid="PSA 66:6">Yo te pase travèse <note caller="+" style="x"><char style="xo" closed="false">66:6 </char><char style="xt" closed="false"><ref loc="JOS 3:16">Jos 3:16</ref></char></note> rivyè apye.</para>
  <para style="q1" vid="PSA 66:6">La menm, nou te rejwi nan Li!<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>Li renye ak pwisans pou tout tan.</para>
  <para style="q1" vid="PSA 66:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">66:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:4">Sòm 11:4</ref>
      </char>
    </note> Zye Li veye sou nasyon yo.</para>
  <para style="q1" vid="PSA 66:7">Pa kite rebèl yo egzalte kont Li.<verse eid="PSA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>Beni Bondye nou an, O pèp yo!</para>
  <para style="q1" vid="PSA 66:8">Fè lwanj Li <note caller="+" style="x"><char style="xo" closed="false">66:8 </char><char style="xt" closed="false"><ref loc="PSA 98:4">Sòm 98:4</ref></char></note> sone,<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>ki <note caller="+" style="x"><char style="xo" closed="false">66:9 </char><char style="xt" closed="false"><ref loc="PSA 30:3">Sòm 30:3</ref></char></note> kenbe nou pami vivan yo,</para>
  <para style="q1" vid="PSA 66:9">e ki pa kite pye nou glise.<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>Paske Ou te fè nou pase a leprèv, O Bondye.</para>
  <para style="q1" vid="PSA 66:10">Ou te <note caller="+" style="x"><char style="xo" closed="false">66:10 </char><char style="xt" closed="false"><ref loc="ISA 48:10">És 48:10</ref></char></note>rafine nou tankou ajan konn rafine.<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>Ou te <note caller="+" style="x"><char style="xo" closed="false">66:11 </char><char style="xt" closed="false"><ref loc="LAM 1:13">Lam 1:13</ref></char></note> rale nou antre nan filè a.</para>
  <para style="q1" vid="PSA 66:11">Ou te mete yon fado lou sou ren nou.<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>Ou te fè moun <note caller="+" style="x"><char style="xo" closed="false">66:12 </char><char style="xt" closed="false"><ref loc="ISA 51:23">És 51:23</ref></char></note> monte sou tèt nou.</para>
  <para style="q1" vid="PSA 66:12">Nou te pase nan dife ak nan dlo,</para>
  <para style="q1" vid="PSA 66:12">men Ou te fè nou sòti antre yon kote avèk anpil abondans.<verse eid="PSA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>Mwen va vini lakay Ou avèk Ofrann brile.</para>
  <para style="q1" vid="PSA 66:13">Mwen va <note caller="+" style="x"><char style="xo" closed="false">66:13 </char><char style="xt" closed="false"><ref loc="PSA 22:25">Sòm 22:25</ref></char></note>peye Ou ve mwen yo,<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>ki te sòti nan lèv mwen,</para>
  <para style="q1" vid="PSA 66:14">ke bouch mwen te pale lè m te <note caller="+" style="x"><char style="xo" closed="false">66:14 </char><char style="xt" closed="false"><ref loc="PSA 18:6">Sòm 18:6</ref></char></note> nan gwo twoub yo.<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>Mwen va ofri a Ou menm yon ofrann brile nan grès a bèt gra yo,</para>
  <para style="q1" vid="PSA 66:15">avèk lafimen a <note caller="+" style="x"><char style="xo" closed="false">66:15 </char><char style="xt" closed="false"><ref loc="NUM 6:14">Nonb 6:14</ref></char></note>belye yo.</para>
  <para style="q1" vid="PSA 66:15">Mwen va fè ofrann a towo yo avèk mal kabrit yo.<verse eid="PSA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>Vin tande, nou tout ki gen lakrent Bondye</para>
  <para style="q1" vid="PSA 66:16">e mwen va <note caller="+" style="x"><char style="xo" closed="false">66:16 </char><char style="xt" closed="false"><ref loc="PSA 71:15-24">Sòm 71:15-24</ref></char></note> pale ou tout sa Li te fè pou nanm mwen.<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>Mwen te kriye a Li menm avèk bouch mwen.</para>
  <para style="q1" vid="PSA 66:17">Ak lang mwen, mwen te <note caller="+" style="x"><char style="xo" closed="false">66:17 </char><char style="xt" closed="false"><ref loc="PSA 31:1">Sòm 31:1</ref></char></note> leve Li wo.<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>Si mwen <note caller="+" style="x"><char style="xo" closed="false">66:18 </char><char style="xt" closed="false"><ref loc="JOB 36:21">Job 36:21</ref></char></note> gade inikite nan kè m,</para>
  <para style="q1" vid="PSA 66:18">Senyè a p ap koute mwen.<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>Men anverite, <note caller="+" style="x"><char style="xo" closed="false">66:19 </char><char style="xt" closed="false"><ref loc="PSA 18:6">Sòm 18:6</ref></char></note> Bondye te tande.</para>
  <para style="q1" vid="PSA 66:19">Li te teni kont de vwa a priyè mwen.<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>Beni se Bondye, ki pa t refize koute</para>
  <para style="q1" vid="PSA 66:20">lapriyè mwen,</para>
  <para style="q1" vid="PSA 66:20">ni ki pa t kache lanmou dous Li a sou mwen.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="d">Pou direktè koral la; avèk enstriman ak kòd yo. Yon Sòm; Yon Chan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>Ke Bondye ka fè nou gras,</para>
  <para style="q1" vid="PSA 67:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">67:1 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 6:25">Nonb 6:25</ref>
      </char>
    </note> beni nou e fè vizaj Li vin klere sou nou——<verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>Ke chemen Ou kapab byen koni sou tè a,</para>
  <para style="q1" vid="PSA 67:2">ak <note caller="+" style="x"><char style="xo" closed="false">67:2 </char><char style="xt" closed="false"><ref loc="ISA 52:10">És 52:10</ref></char></note>sali Ou pami tout nasyon yo.<verse eid="PSA 67:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>Kite <note caller="+" style="x"><char style="xo" closed="false">67:3 </char><char style="xt" closed="false"><ref loc="PSA 66:4">Sòm 66:4</ref></char></note> pèp yo louwe Ou, O Bondye.</para>
  <para style="q1" vid="PSA 67:3">Kite tout pèp yo louwe Ou.<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>Kite nasyon yo fè kè kontan e chante ak jwa,</para>
  <para style="q1" vid="PSA 67:4">paske Ou va jije pèp yo avèk ladwati e <note caller="+" style="x"><char style="xo" closed="false">67:4 </char><char style="xt" closed="false"><ref loc="PSA 47:8">Sòm 47:8</ref></char></note>gide nasyon yo sou tè a. <char style="qs">Tan</char><verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>Kite <note caller="+" style="x"><char style="xo" closed="false">67:5 </char><char style="xt" closed="false"><ref loc="PSA 67:3">Sòm 67:3</ref></char></note> pèp yo louwe Ou, O Bondye.</para>
  <para style="q1" vid="PSA 67:5">Kite tout pèp yo louwe Ou.<verse eid="PSA 67:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">67:6 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:4">Lev 26:4</ref>
      </char>
    </note> Latè te bay pwodwi li.</para>
  <para style="q1" vid="PSA 67:6">Bondye, Bondye pa nou an, ap toujou beni nou.<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>Bondye ap toujou beni nou.</para>
  <para style="q1" vid="PSA 67:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">67:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:27">Sòm 22:27</ref>
      </char>
    </note> Dènye pwent latè a va gen lakrent Li.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="d">Pou direktè koral la; avèk enstriman ak kòd yo. Yon Sòm; Yon Chan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>Kite <note caller="+" style="x"><char style="xo" closed="false">68:1 </char><char style="xt" closed="false"><ref loc="NUM 10:35">Nonb 10:35</ref></char></note> Bondye leve!</para>
  <para style="q1" vid="PSA 68:1">Kite lènmi Li yo vin gaye!</para>
  <para style="q1" vid="PSA 68:1">Kite sila ki rayi Li yo sove ale devan L.<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>Kon lafimen konn chase,</para>
  <para style="q1" vid="PSA 68:2">konsa, chase yo.</para>
  <para style="q1" vid="PSA 68:2">Kon <note caller="+" style="x"><char style="xo" closed="false">68:2 </char><char style="xt" closed="false"><ref loc="PSA 22:14">Sòm 22:14</ref></char></note> lasi kon fonn devan dife,</para>
  <para style="q1" vid="PSA 68:2">konsa, kite mechan yo peri devan Bondye.<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>Men kite moun <note caller="+" style="x"><char style="xo" closed="false">68:3 </char><char style="xt" closed="false"><ref loc="PSA 32:11">Sòm 32:11</ref></char></note> ladwati yo fè kè kontan.</para>
  <para style="q1" vid="PSA 68:3">Kite yo leve wo devan Bondye.</para>
  <para style="q1" vid="PSA 68:3">Wi, kite yo rejwi avèk kè kontan.<verse eid="PSA 68:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>Chante a Bondye! Chante lwanj a non Li!</para>
  <para style="q1" vid="PSA 68:4">Leve wo pou Sila ki monte sou nwaj yo:</para>
  <para style="q1" vid="PSA 68:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">68:4 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 6:3">Egz 6:3</ref> </char>
    </note>non l se SENYÈ a!</para>
  <para style="q1" vid="PSA 68:4">Rejwi devan Li an!<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>Yon <note caller="+" style="x"><char style="xo" closed="false">68:5 </char><char style="xt" closed="false"><ref loc="PSA 10:14">Sòm 10:14</ref></char></note> papa pou òfelen yo</para>
  <para style="q1" vid="PSA 68:5">e yon jij pou vèv yo,</para>
  <para style="q1" vid="PSA 68:5">se Bondye nan lye sen Li an.<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>Bondye <note caller="+" style="x"><char style="xo" closed="false">68:6 </char><char style="xt" closed="false"><ref loc="PSA 107:4-7">Sòm 107:4-7</ref></char></note> fè yon fanmi pou sila ki pa genyen an.</para>
  <para style="q1" vid="PSA 68:6">Li fè prizonye yo vin sòti deyò ak chan yo,</para>
  <para style="q1" vid="PSA 68:6">men rebèl yo viv nan yon peyi deseche.<verse eid="PSA 68:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>O Bondye, lè Ou <note caller="+" style="x"><char style="xo" closed="false">68:7 </char><char style="xt" closed="false"><ref loc="EXO 13:21">Egz 13:21</ref></char></note> te sòti devan pèp Ou a,</para>
  <para style="q1" vid="PSA 68:7">lè Ou te mache travèse dezè a,<verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">68:8 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 19:18">Egz 19:18</ref>
      </char>
    </note> tè a te souke.</para>
  <para style="q1" vid="PSA 68:8">Syèl yo tou te lage lapli devan prezans Bondye,</para>
  <para style="q1" vid="PSA 68:8">prezans Bondye Sinaï lan.</para>
  <para style="q1" vid="PSA 68:8">Mond la li menm tè a souke devan prezans</para>
  <para style="q1" vid="PSA 68:8">Bondye a, Bondye Israël la.<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>Ou, Bondye te voye nan tout kote yon gwo lapli.</para>
  <para style="q1" vid="PSA 68:9">Ou te konfime eritaj Ou lè li te fatige nèt.<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>Moun pa Ou yo te vin rete ladann.</para>
  <para style="q1" vid="PSA 68:10">Ou te <note caller="+" style="x"><char style="xo" closed="false">68:10 </char><char style="xt" closed="false"><ref loc="PSA 65:9">Sòm 65:9</ref></char></note> founi tout bonte Ou pou</para>
  <para style="q1" vid="PSA 68:10">malere yo, O Bondye.<verse eid="PSA 68:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>Senyè a te anonce pawòl la.</para>
  <para style="q1" vid="PSA 68:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">68:11 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:20">Egz 15:20</ref>
      </char>
    </note> Mesaje ki pwoklame bòn nouvèl yo se yon gwo lame.<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>“Wa lame yo sove ale! Yo kouri!</para>
  <para style="q1" vid="PSA 68:12">Fanm nan rete nan kay la <note caller="+" style="x"><char style="xo" closed="false">68:12 </char><char style="xt" closed="false"><ref loc="JDG 5:30">Jij 5:30</ref> </char></note>divize piyaj la!<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>Lè ou kouche <note caller="+" style="x"><char style="xo" closed="false">68:13 </char><char style="xt" closed="false"><ref loc="GEN 49:14">Jen 49:14</ref></char></note> nan pak mouton yo,</para>
  <para style="q1" vid="PSA 68:13">se tankou zèl toutrèl ki kouvri ak ajan e</para>
  <para style="q1" vid="PSA 68:13">plim li ak lò briyan.<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>Lè Toupwisan an te gaye wa yo la a,</para>
  <para style="q1" vid="PSA 68:14">Nèj t ap tonbe sou <note caller="+" style="x"><char style="xo" closed="false">68:14 </char><char style="xt" closed="false"><ref loc="JDG 9:48">Jij 9:48</ref></char></note>Tsalmon.<verse eid="PSA 68:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>Yon mòn Bondye se Mòn Basan.</para>
  <para style="q1" vid="PSA 68:15">Yon mòn apik e difisil se Mòn Basan.<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>Poukisa nou gade ak anvi,</para>
  <para style="q1" vid="PSA 68:16">O tout lòt mòn yo?</para>
  <para style="q1" vid="PSA 68:16">Sou mòn ke Bondye te <note caller="+" style="x"><char style="xo" closed="false">68:16 </char><char style="xt" closed="false"><ref loc="DEU 12:5">Det 12:5</ref></char></note> apwente</para>
  <para style="q1" vid="PSA 68:16">konn abitasyon Li an?</para>
  <para style="q1" vid="PSA 68:16">Anverite, SENYÈ a va abite la pou tout tan.<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>Cha Bondye yo anpil sou milye dè milye.</para>
  <para style="q1" vid="PSA 68:17">Senyè a pami yo sòti Sinaï, nan sentete Li.<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>Ou te monte an wo.</para>
  <para style="q1" vid="PSA 68:18">Ou te mennen kaptif yo sòti.</para>
  <para style="q1" vid="PSA 68:18">Anplis, Ou te resevwa kado pami lòm,</para>
  <para style="q1" vid="PSA 68:18">menm pami rebèl yo tou,</para>
  <para style="q1" vid="PSA 68:18">pou SENYÈ a, Bondye a, kapab abite la.<verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>Beni se Senyè a, ki <note caller="+" style="x"><char style="xo" closed="false">68:19 </char><char style="xt" closed="false"><ref loc="PSA 55:22">Sòm 55:22</ref></char></note> pote fado nou chak jou,</para>
  <para style="q1" vid="PSA 68:19">Bondye ki se delivrans nou an. <char style="qs">Tan</char><verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>Bondye pou nou se yon <note caller="+" style="x"><char style="xo" closed="false">68:20 </char><char style="xt" closed="false"><ref loc="PSA 106:43">Sòm 106:43</ref></char></note> Bondye delivrans.</para>
  <para style="q1" vid="PSA 68:20">Epi BONDYE, Senyè a sèl, ki fè nou chape devan lanmò.<verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>Anverite, Bondye va <note caller="+" style="x"><char style="xo" closed="false">68:21 </char><char style="xt" closed="false"><ref loc="PSA 110:6">Sòm 110:6</ref></char></note> kraze tèt lènmi Li yo,</para>
  <para style="q1" vid="PSA 68:21">tèt la menm ak cheve a sila ki pèsiste nan mechanste li yo.<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>Senyè a te di: <note caller="+" style="x"><char style="xo" closed="false">68:22 </char><char style="xt" closed="false"><ref loc="NUM 21:33">Nonb 21:33</ref></char></note> “Mwen va mennen fè yo sòti Basan.</para>
  <para style="q1" vid="PSA 68:22">Mwen va mennen yo retounen jis rive nan fon lanmè a,<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>pou pye ou kapab kraze yo bay san,</para>
  <para style="q1" vid="PSA 68:23">jis lang <note caller="+" style="x"><char style="xo" closed="false">68:23 </char><char style="xt" closed="false"><ref loc="1KI 21:19">I Wa 21:19</ref></char></note> chen ou yo kapab jwenn pòsyon pa yo sou lènmi a.”<verse eid="PSA 68:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>Yo te wè <note caller="+" style="x"><char style="xo" closed="false">68:24 </char><char style="xt" closed="false"><ref loc="PSA 77:13">Sòm 77:13</ref></char></note> pwosesyon solanèl Ou a, O Bondye,</para>
  <para style="q1" vid="PSA 68:24">pwosesyon a Bondye mwen an, Wa mwen,</para>
  <para style="q1" vid="PSA 68:24">pou antre nan sanktiyè a.<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>Chantè yo te ale, e mizisyen yo te swiv,</para>
  <para style="q1" vid="PSA 68:25">nan mitan a jenn fi ki t ap bat tanbouren yo.<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>Beni Bondye nan asanble yo,</para>
  <para style="q1" vid="PSA 68:26">SENYÈ a menm, <note caller="+" style="x"><char style="xo" closed="false">68:26 </char><char style="xt" closed="false"><ref loc="DEU 33:28">Det 33:28</ref></char></note> fontèn dlo Israël la.<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>Men gade <note caller="+" style="x"><char style="xo" closed="false">68:27 </char><char style="xt" closed="false"><ref loc="JDG 5:14">Jij 5:14</ref></char></note> Benjamin, pi piti an Israël la,</para>
  <para style="q1" vid="PSA 68:27">k ap renye sou yo,</para>
  <para style="q1" vid="PSA 68:27">prens a Juda ki konseyè yo,</para>
  <para style="q1" vid="PSA 68:27">prens Zabulon ak prens a Nephthali yo.<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>Bondye ou a te kòmande fòs Ou.</para>
  <para style="q1" vid="PSA 68:28">Montre Ou dyanm, O Bondye, <note caller="+" style="x"><char style="xo" closed="false">68:28 </char><char style="xt" closed="false"><ref loc="ISA 26:12">És 26:12</ref> </char></note>nan sa Ou te fè pou nou menm.<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>Akoz tanp Jérusalem Ou a,</para>
  <para style="q1" vid="PSA 68:29">
    <note caller="+" style="x">
      <char style="xo" closed="false">68:29 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 10:25">I Wa 10:25</ref>
      </char>
    </note> wa yo va mennen kado bay Ou.<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>Repwoche bèt sovaj yo nan mitan wozo a,</para>
  <para style="q1" vid="PSA 68:30">twoupo <note caller="+" style="x"><char style="xo" closed="false">68:30 </char><char style="xt" closed="false"><ref loc="PSA 22:12">Sòm 22:12</ref></char></note> towo yo avèk ti bèf a pèp yo.</para>
  <para style="q1" vid="PSA 68:30">Foule anba pye gwo bout pyès ajan yo.</para>
  <para style="q1" vid="PSA 68:30">Gaye pèp ki te renmen fè lagè yo.<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>Prens yo va sòti an <note caller="+" style="x"><char style="xo" closed="false">68:31 </char><char style="xt" closed="false"><ref loc="ISA 19:19-21">És 19:19-21</ref></char></note> Égypte.</para>
  <para style="q1" vid="PSA 68:31">Ethiopie va fè vit pou lonje men l vè Bondye.<verse eid="PSA 68:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>Chante a Bondye, O <note caller="+" style="x"><char style="xo" closed="false">68:32 </char><char style="xt" closed="false"><ref loc="PSA 102:22">Sòm 102:22</ref></char></note> wayòm sou latè yo,</para>
  <para style="q1" vid="PSA 68:32">Chante lwanj a Senyè a, <char style="qs">Tan</char><verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>A Sila ki vwayaje monte sou <note caller="+" style="x"><char style="xo" closed="false">68:33 </char><char style="xt" closed="false"><ref loc="DEU 10:14">Det 10:14</ref></char></note>pi wo syèl la,</para>
  <para style="q1" vid="PSA 68:33">ki la depi nan tan ansyen yo.</para>
  <para style="q1" vid="PSA 68:33">Gade byen, Li pale ak gwo vwa,</para>
  <para style="q1" vid="PSA 68:33">yon vwa plen pwisans.<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>Rekonèt fòs Bondye a!</para>
  <para style="q1" vid="PSA 68:34">Majeste Li sou tout Israël,</para>
  <para style="q1" vid="PSA 68:34">
    <note caller="+" style="x">
      <char style="xo" closed="false">68:34 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 150:1">Sòm 150:1</ref>
      </char>
    </note>pwisans Li nan syèl yo.<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>O Bondye, Ou <note caller="+" style="x"><char style="xo" closed="false">68:35 </char><char style="xt" closed="false"><ref loc="DEU 7:21">Det 7:21</ref></char></note> etonnan nan sanktiyè Ou yo.</para>
  <para style="q1" vid="PSA 68:35">Bondye Israël la ki bay fòs ak pouvwa a pèp Li yo.</para>
  <para style="q1" vid="PSA 68:35">Beni se Bondye!<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="d">Pou direktè koral la. Sou melodi “Lis Yo”. Yon Sòm David.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>Sove mwen, O Bondye,</para>
  <para style="q1" vid="PSA 69:1">paske <note caller="+" style="x"><char style="xo" closed="false">69:1 </char><char style="xt" closed="false"><ref loc="JOB 22:11">Job 22:11</ref></char></note> dlo yo fin monte jis nan kou m!<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>Mwen desann fon nan labou.</para>
  <para style="q1" vid="PSA 69:2">Nanpwen plas pou pye m kenbe.</para>
  <para style="q1" vid="PSA 69:2">Mwen fin rive nan dlo fon yo,</para>
  <para style="q1" vid="PSA 69:2">e yon <note caller="+" style="x"><char style="xo" closed="false">69:2 </char><char style="xt" closed="false"><ref loc="JON 2:3">Jon 2:3</ref></char></note> gwo inondasyon ap debòde sou mwen.<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">69:3 </char><char style="xt" closed="false"><ref loc="PSA 6:6">Sòm 6:6</ref></char></note> fatige nèt ak kriye mwen an.</para>
  <para style="q1" vid="PSA 69:3">Gòj mwen sèk nèt.</para>
  <para style="q1" vid="PSA 69:3">Zye m varye pandan mwen</para>
  <para style="q1" vid="PSA 69:3">ap tann Bondye mwen an.<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">69:4 </char><char style="xt" closed="false"><ref loc="PSA 35:19">Sòm 35:19</ref></char></note> rayi mwen san koz yo plis pase cheve sou tèt mwen.</para>
  <para style="q1" vid="PSA 69:4">Sila ki ta detwi mwen yo pwisan e san rezon, yo fè lènmi avè m.</para>
  <para style="q1" vid="PSA 69:4">Sa ke m pa t janm vòlè, mwen oblije remèt li.<verse eid="PSA 69:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>O Bondye, Ou konnen <note caller="+" style="x"><char style="xo" closed="false">69:5 </char><char style="xt" closed="false"><ref loc="PSA 38:5">Sòm 38:5</ref></char></note> foli mwen.</para>
  <para style="q1" vid="PSA 69:5">Koupabilite mwen pa kache devan Ou.<verse eid="PSA 69:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>Pa kite sila k ap tann Ou yo vin <note caller="+" style="x"><char style="xo" closed="false">69:6 </char><char style="xt" closed="false"><ref loc="2SA 12:14">II Sam 12:14</ref></char></note> wont akoz mwen,</para>
  <para style="q1" vid="PSA 69:6">O Senyè BONDYE dèzame yo.</para>
  <para style="q1" vid="PSA 69:6">Pa kite yo vin dezonere akoz mwen menm, O Bondye Israël la.<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>Paske pou koz Ou, mwen te pote repwòch.</para>
  <para style="q1" vid="PSA 69:7">Dezonè fin kouvri figi mwen.<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>Mwen vin izole de frè m yo,</para>
  <para style="q1" vid="PSA 69:8">tankou yon etranje de fis a manman m yo.<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>Epi akoz zèl mwen gen pou lakay Ou, yo manje m nèt.</para>
  <para style="q1" vid="PSA 69:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">69:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:139">Sòm 119:139</ref>
      </char>
    </note> Repwòch a sila ki te repwoche Ou yo te vin tonbe sou mwen.<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>Lè mwen te kriye <note caller="+" style="x"><char style="xo" closed="false">69:10 </char><char style="xt" closed="false"><ref loc="PSA 35:13">Sòm 35:13</ref></char></note> nan nanm mwen, e te fè jèn,</para>
  <para style="q1" vid="PSA 69:10">sa te vin yon repwòch pou mwen.<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>Lè m te fè <note caller="+" style="x"><char style="xo" closed="false">69:11 </char><char style="xt" closed="false"><ref loc="PSA 35:13">Sòm 35:13</ref></char></note> twal sak sèvi kon rad mwen,</para>
  <para style="q1" vid="PSA 69:11">mwen te vin yon vye pawòl,</para>
  <para style="q1" vid="PSA 69:11">yon rizib pou yo menm.<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">69:12 </char><char style="xt" closed="false"><ref loc="GEN 19:1">Jen 19:1</ref></char></note> chita nan pòtay yo pale afè mwen,</para>
  <para style="q1" vid="PSA 69:12">e moun sòt yo fè chan sou mwen.<verse eid="PSA 69:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>Men pou mwen, priyè mwen se a Ou menm, O SENYÈ,</para>
  <para style="q1" vid="PSA 69:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">69:13 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:6">Sòm 32:6</ref>
      </char>
    </note> nan yon lè ki bon,</para>
  <para style="q1" vid="PSA 69:13">nan grandè lanmou dous Ou a.</para>
  <para style="q1" vid="PSA 69:13">Reponn mwen avèk sali verite Ou a.<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>Delivre mwen sòti nan <note caller="+" style="x"><char style="xo" closed="false">69:14 </char><char style="xt" closed="false"><ref loc="PSA 69:2">Sòm 69:2</ref></char></note> labou a.</para>
  <para style="q1" vid="PSA 69:14">Pa kite mwen fonse nèt ladann.</para>
  <para style="q1" vid="PSA 69:14">Kite m delivre de sa yo ki rayi mwen yo, ak nan fon dlo yo.<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>Pa kite <note caller="+" style="x"><char style="xo" closed="false">69:15 </char><char style="xt" closed="false"><ref loc="PSA 124:4-5">Sòm 124:4-5</ref></char></note> inondasyon dlo yo vin anvayi mwen,</para>
  <para style="q1" vid="PSA 69:15">ni fon an vale m,</para>
  <para style="q1" vid="PSA 69:15">ni fòs la fèmen bouch li sou mwen.<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>Reponn mwen, O SENYÈ, paske lanmou dous Ou a bon;</para>
  <para style="q1" vid="PSA 69:16">Selon grandè a mizerikòd Ou, <note caller="+" style="x"><char style="xo" closed="false">69:16 </char><char style="xt" closed="false"><ref loc="PSA 25:16">Sòm 25:16</ref></char></note> vire kote mwen.<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">69:17 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:9">Sòm 27:9</ref>
      </char>
    </note> Pa kache figi Ou de sèvitè Ou a,</para>
  <para style="q1" vid="PSA 69:17">paske mwen nan gwo pwoblèm.</para>
  <para style="q1" vid="PSA 69:17">Reponn mwen vit.<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>Rale nanm mwen pre. Rachte l!</para>
  <para style="q1" vid="PSA 69:18">
    <note caller="+" style="x">
      <char style="xo" closed="false">69:18 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:134">Sòm 119:134</ref>
      </char>
    </note> Rachte mwen akoz lènmi mwen yo!<verse eid="PSA 69:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>Ou konnen <note caller="+" style="x"><char style="xo" closed="false">69:19 </char><char style="xt" closed="false"><ref loc="PSA 22:6">Sòm 22:6</ref></char></note> repwòch mwen, wont mwen, avèk dezonè mwen an.</para>
  <para style="q1" vid="PSA 69:19">Tout advèsè mwen yo devan Ou.<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>Repwòch fin kraze kè m.</para>
  <para style="q1" vid="PSA 69:20">Mwen vin ba nèt.</para>
  <para style="q1" vid="PSA 69:20">Mwen te chache pitye, men pa t genyen;</para>
  <para style="q1" vid="PSA 69:20">
    <note caller="+" style="x">
      <char style="xo" closed="false">69:20 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 16:2">Job 16:2</ref>
      </char>
    </note>kondoleyans, men nanpwen.<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>Anplis, yo te ban mwen fyèl kon manje ak <note caller="+" style="x"><char style="xo" closed="false">69:21 </char><char style="xt" closed="false"><ref loc="MAT 27:34-48">Mat 27:34-48</ref></char></note>vinèg pou swaf mwen.<verse eid="PSA 69:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>Ke <note caller="+" style="x"><char style="xo" closed="false">69:22 </char><char style="xt" closed="false"><ref loc="ROM 11:9-10">Wo 11:9-10</ref></char></note> tab devan yo devni yon pèlen.</para>
  <para style="q1" vid="PSA 69:22">Lè yo nan tan lapè, kite li tounen yon pyèj.<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>Ke <note caller="+" style="x"><char style="xo" closed="false">69:23 </char><char style="xt" closed="false"><ref loc="ISA 6:10">És 6:10</ref></char></note> zye yo vin twouble pou yo pa kab wè.</para>
  <para style="q1" vid="PSA 69:23">Ke do yo koube nèt.<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">69:24 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 79:6">Sòm 79:6</ref>
      </char>
    </note> Vide kòlè Ou sou yo.</para>
  <para style="q1" vid="PSA 69:24">Ke fachèz kòlè Ou ki brile ka vini sou yo.<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>Pou <note caller="+" style="x"><char style="xo" closed="false">69:25 </char><char style="xt" closed="false"><ref loc="MAT 23:38">Mat 23:38</ref></char></note> kan yo kapab dezole.</para>
  <para style="q1" vid="PSA 69:25">Pou pa gen moun ki rete ankò nan tant yo.<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>Paske yo te pèsekite sila ke Ou menm <note caller="+" style="x"><char style="xo" closed="false">69:26 </char><char style="xt" closed="false"><ref loc="ISA 53:4">És 53:4</ref> </char></note>te blese a.</para>
  <para style="q1" vid="PSA 69:26">Yo pale sou doulè a sila ke Ou menm te blese yo.<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>Ogmante inikite sou inikite yo.</para>
  <para style="q1" vid="PSA 69:27">Ni <note caller="+" style="x"><char style="xo" closed="false">69:27 </char><char style="xt" closed="false"><ref loc="ISA 26:10">És 26:10</ref></char></note> pa kite yo antre nan ladwati Ou.<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>Ke yo kapab efase soti nan liv lavi a.</para>
  <para style="q1" vid="PSA 69:28">Pou yo pa vin anrejistre nan achiv ak moun ladwati yo.<verse eid="PSA 69:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>Men mwen aflije e mwen nan doulè.</para>
  <para style="q1" vid="PSA 69:29">Ke delivrans Ou, O Bondye kapab plase mwen an sekirite an wo.<verse eid="PSA 69:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>Mwen va louwe non Bondye avèk chan yo,</para>
  <para style="q1" vid="PSA 69:30">epi <note caller="+" style="x"><char style="xo" closed="false">69:30 </char><char style="xt" closed="false"><ref loc="PSA 34:3">Sòm 34:3</ref> </char></note>leve Li wo avèk remèsiman.<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>Se sa k ap <note caller="+" style="x"><char style="xo" closed="false">69:31 </char><char style="xt" closed="false"><ref loc="PSA 50:13-14">Sòm 50:13-14</ref></char></note> fè kè SENYÈ kontan plis pase yon bèf,</para>
  <para style="q1" vid="PSA 69:31">ni pase yon jenn towo avèk kòn ak zago.<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>Enb yo te wè sa e yo kontan.</para>
  <para style="q1" vid="PSA 69:32">Nou menm ki chache Bondye, <note caller="+" style="x"><char style="xo" closed="false">69:32 </char><char style="xt" closed="false"><ref loc="PSA 22:26">Sòm 22:26</ref></char></note>kite kè nou reprann fòs.<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>Paske <note caller="+" style="x"><char style="xo" closed="false">69:33 </char><char style="xt" closed="false"><ref loc="PSA 12:5">Sòm 12:5</ref></char></note> SENYÈ a tande malere yo,</para>
  <para style="q1" vid="PSA 69:33">e Li pa meprize moun pa L ki prizonye yo.<verse eid="PSA 69:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>Kite syèl la avèk tè a louwe Li,</para>
  <para style="q1" vid="PSA 69:34">lanmè yo avèk <note caller="+" style="x"><char style="xo" closed="false">69:34 </char><char style="xt" closed="false"><ref loc="ISA 55:12">És 55:12</ref></char></note> tout sa ki fè mouvman ladann yo.<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>Paske Bondye va delivre Sion e bati vil Juda yo,</para>
  <para style="q1" vid="PSA 69:35">pou yo kab rete la e posede li.<verse eid="PSA 69:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36"/>Desandan a sèvitè Li yo va eritye li.</para>
  <para style="q1" vid="PSA 69:36">Sila ki renmen non Li yo <note caller="+" style="x"><char style="xo" closed="false">69:36 </char><char style="xt" closed="false"><ref loc="PSA 37:29">Sòm 37:29</ref></char></note> va rete ladann.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="d">Pou direktè koral la; Yon Sòm David. Yon souvni</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">70:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:13-17">Sòm 40:13-17</ref>
      </char>
    </note> O Bondye, fè vit pou delivre mwen.</para>
  <para style="q1" vid="PSA 70:1">O SENYÈ, fè vit pou ban m sekou!<verse eid="PSA 70:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">70:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:4-26">Sòm 35:4-26</ref>
      </char>
    </note> Kite sila k ap chache lavi m yo vin wont e imilye.</para>
  <para style="q1" vid="PSA 70:2">Kite sila ki pran plezi nan fè m mal yo vire fè bak ak dezonè.<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">70:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:15">Sòm 40:15</ref>
      </char>
    </note> Kite sila ki di: “ah, ah!” yo vire fè bak akoz wont yo.<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>Kite tout moun k ap chache Ou yo rejwi e fè kè kontan nan Ou.</para>
  <para style="q1" vid="PSA 70:4">Kite sila ki renmen sali Ou yo di tout tan:</para>
  <para style="q1" vid="PSA 70:4">“Kite Bondye egzalte”.<verse eid="PSA 70:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>Men mwen aflije e mwen nan nesesite.</para>
  <para style="q1" vid="PSA 70:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">70:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 141:1">Sòm 141:1</ref>
      </char>
    </note>Fè vit vin kote mwen, O Bondye!</para>
  <para style="q1" vid="PSA 70:5">Se Ou menm ki sekou mwen ak delivrans mwen.</para>
  <para style="q1" vid="PSA 70:5">O SENYÈ, pa mize.<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">71:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:2-3">Sòm 25:2-3</ref>
      </char>
    </note> Nan Ou, O SENYÈ, mwen te pran refij.</para>
  <para style="q1" vid="PSA 71:1">Pa janm kite mwen vin wont.<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">71:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:1">Sòm 31:1</ref>
      </char>
    </note> Nan ladwati Ou, delivre mwen e fè m sekou.</para>
  <para style="q1" vid="PSA 71:2">Panche zòrèy Ou bò kote m e sove mwen.<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>Devni pou mwen wòch abitasyon mwen an,</para>
  <para style="q1" vid="PSA 71:3">kote mwen kab vini tout tan.</para>
  <para style="q1" vid="PSA 71:3">Ou te pase lòd pou sove mwen,</para>
  <para style="q1" vid="PSA 71:3">paske Ou se <note caller="+" style="x"><char style="xo" closed="false">71:3 </char><char style="xt" closed="false"><ref loc="PSA 18:2">Sòm 18:2</ref></char></note>wòch mwen ak sitadèl mwen.<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">71:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 140:1-4">Sòm 140:1-4</ref>
      </char>
    </note> Delivre mwen, O Bondye mwen, nan men a mechan yo,</para>
  <para style="q1" vid="PSA 71:4">Fè m sòti nan ponyèt a malfektè a ak san pitye a,<verse eid="PSA 71:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>Paske Ou se espwa m, O SENYÈ Bondye,</para>
  <para style="q1" vid="PSA 71:5">Ou se <note caller="+" style="x"><char style="xo" closed="false">71:5 </char><char style="xt" closed="false"><ref loc="PSA 22:9">Sòm 22:9</ref></char></note> konfyans mwen soti nan jenès mwen.<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>Pa Ou menm, mwen te twouve <note caller="+" style="x"><char style="xo" closed="false">71:6 </char><char style="xt" closed="false"><ref loc="PSA 22:10">Sòm 22:10</ref></char></note> soutyen depi lè m te fèt.</para>
  <para style="q1" vid="PSA 71:6">Se Ou menm ki te retire mwen nan vant manman m.</para>
  <para style="q1" vid="PSA 71:6">Tout tan se Ou menm ke m louwe.<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>Mwen parèt kon yon <note caller="+" style="x"><char style="xo" closed="false">71:7 </char><char style="xt" closed="false"><ref loc="ISA 8:18">És 8:18</ref></char></note> mèvèy pou anpil moun,</para>
  <para style="q1" vid="PSA 71:7">men se Ou ki fò refij mwen.<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>Bouch mwen plen avèk lwanj Ou</para>
  <para style="q1" vid="PSA 71:8">ak <note caller="+" style="x"><char style="xo" closed="false">71:8 </char><char style="xt" closed="false"><ref loc="PSA 96:6">Sòm 96:6</ref></char></note> glwa Ou tout lajounen.<verse eid="PSA 71:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>Pa jete mwen akote nan <note caller="+" style="x"><char style="xo" closed="false">71:9 </char><char style="xt" closed="false"><ref loc="PSA 71:18">Sòm 71:18</ref></char></note> tan vyeyès mwen.</para>
  <para style="q1" vid="PSA 71:9">Pa abandone mwen lè fòs mwen vin febli.<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>Paske Lènmi m yo te pale kont mwen.</para>
  <para style="q1" vid="PSA 71:10">Sila k ap veye pou pran lavi m yo <note caller="+" style="x"><char style="xo" closed="false">71:10 </char><char style="xt" closed="false"><ref loc="PSA 31:13">Sòm 31:13</ref></char></note> ap pran konsèy ansanm,<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>Y ap di: <note caller="+" style="x"><char style="xo" closed="false">71:11 </char><char style="xt" closed="false"><ref loc="PSA 3:2">Sòm 3:2</ref></char></note> “Bondye fin abandone li.</para>
  <para style="q1" vid="PSA 71:11">Annou kouri dèyè l, e sezi li.</para>
  <para style="q1" vid="PSA 71:11">Paske nanpwen moun ki pou delivre l.”<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>O Bondye, <note caller="+" style="x"><char style="xo" closed="false">71:12 </char><char style="xt" closed="false"><ref loc="PSA 10:1">Sòm 10:1</ref></char></note> pa rete lwen mwen.</para>
  <para style="q1" vid="PSA 71:12">O Bondye m, fè vit a sekou mwen!<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>Kite sila ki advèsè a nanm mwen yo vin wont e manje nèt.</para>
  <para style="q1" vid="PSA 71:13">Kite yo kouvri avèk repwòch ak dezonè k ap <note caller="+" style="x"><char style="xo" closed="false">71:13 </char><char style="xt" closed="false"><ref loc="EST 9:2">Est 9:2</ref></char></note>chache blese mwen.<verse eid="PSA 71:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>Men pou mwen, mwen va kenbe espwa m pou tout tan.</para>
  <para style="q1" vid="PSA 71:14">Mwen va <note caller="+" style="x"><char style="xo" closed="false">71:14 </char><char style="xt" closed="false"><ref loc="PSA 71:8">Sòm 71:8</ref></char></note>bay Ou lwanj plis toujou.<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>Bouch mwen va pale ladwati Ou,</para>
  <para style="q1" vid="PSA 71:15">ak sali Ou tout lajounen,</para>
  <para style="q1" vid="PSA 71:15">menmsi mwen <note caller="+" style="x"><char style="xo" closed="false">71:15 </char><char style="xt" closed="false"><ref loc="PSA 40:5">Sòm 40:5</ref></char></note>pa kab fin konnen</para>
  <para style="q1" vid="PSA 71:15">fòs valè tout jou sa yo.<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>Mwen va vini ak zèv pwisan SENYÈ Bondye a.</para>
  <para style="q1" vid="PSA 71:16">Mwen va <note caller="+" style="x"><char style="xo" closed="false">71:16 </char><char style="xt" closed="false"><ref loc="PSA 51:14">Sòm 51:14</ref></char></note>pale ladwati Ou, sèl de Ou menm.<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>O Bondye, Ou <note caller="+" style="x"><char style="xo" closed="false">71:17 </char><char style="xt" closed="false"><ref loc="DEU 4:5">Det 4:5</ref></char></note> te enstwi mwen depi jenès mwen.</para>
  <para style="q1" vid="PSA 71:17">Jiska prezan, mwen toujou deklare mèvèy Ou yo.<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>Wi, menm lè m vye ak cheve blanch, O Bondye, pa abandone m,</para>
  <para style="q1" vid="PSA 71:18">jiskaske mwen fin <note caller="+" style="x"><char style="xo" closed="false">71:18 </char><char style="xt" closed="false"><ref loc="PSA 22:31">Sòm 22:31</ref></char></note>deklare fòs Ou a jenerasyon sila a,</para>
  <para style="q1" vid="PSA 71:18">ak pwisans Ou a tout sila k ap vini yo.<verse eid="PSA 71:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>Paske ladwati Ou, O Bondye, rive jis nan syèl yo.</para>
  <para style="q1" vid="PSA 71:19">Ou menm ki te fè gwo bagay yo.</para>
  <para style="q1" vid="PSA 71:19">O Bondye, se <note caller="+" style="x"><char style="xo" closed="false">71:19 </char><char style="xt" closed="false"><ref loc="DEU 3:24">Det 3:24</ref></char></note>kilès ki tankou Ou menm?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>Ou menm ki te fè m wè anpil twoub ak gwo pwoblèm,</para>
  <para style="q1" vid="PSA 71:20">va fè m viv.</para>
  <para style="q1" vid="PSA 71:20">Ou va mennen mwen monte soti nan <note caller="+" style="x"><char style="xo" closed="false">71:20 </char><char style="xt" closed="false"><ref loc="PSA 86:13">Sòm 86:13</ref></char></note>fon tè yo.<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>Ke Ou fè lonè mwen vin plis e vire ban m konsolasyon ankò.<verse eid="PSA 71:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>Konsa, mwen va louwe Ou avèk ap la pou fidelite Ou, O Bondye mwen.</para>
  <para style="q1" vid="PSA 71:22">A Ou menm, mwen va chante lwanj avèk gita,</para>
  <para style="q1" vid="PSA 71:22">O <note caller="+" style="x"><char style="xo" closed="false">71:22 </char><char style="xt" closed="false"><ref loc="2KI 19:22">II Wa 19:22</ref></char></note>Sila Ki Sen an Israël la.<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>Lèv mwen va rele ak jwa lè mwen chante lwanj a Ou menm</para>
  <para style="q1" vid="PSA 71:23">pou <note caller="+" style="x"><char style="xo" closed="false">71:23 </char><char style="xt" closed="false"><ref loc="PSA 34:22">Sòm 34:22</ref></char></note> nanm mwen ke Ou te rachte a.<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>Lang mwen, anplis, va pale ladwati Ou tout lajounen.</para>
  <para style="q1" vid="PSA 71:24">Paske yo wont, yo imilye,</para>
  <para style="q1" vid="PSA 71:24">Sila ki te chache fè m mal yo.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="d">Yon Sòm a Salomon</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>Bay a wa a <note caller="+" style="x"><char style="xo" closed="false">72:1 </char><char style="xt" closed="false"><ref loc="1KI 3:9">I Wa 3:9</ref></char></note> sajès lajistis Ou, O Bondye,</para>
  <para style="q1" vid="PSA 72:1">ak ladwati Ou a fis a wa a.<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>Li va <note caller="+" style="x"><char style="xo" closed="false">72:2 </char><char style="xt" closed="false"><ref loc="ISA 9:7">És 9:7</ref></char></note> jije pèp Ou a avèk ladwati,</para>
  <para style="q1" vid="PSA 72:2">e aflije Ou yo, avèk jistis.<verse eid="PSA 72:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>Mòn yo va pote <note caller="+" style="x"><char style="xo" closed="false">72:3 </char><char style="xt" closed="false"><ref loc="ISA 2:4">És 2:4</ref></char></note> lapè a pèp la,</para>
  <para style="q1" vid="PSA 72:3">e kolin yo, fwi ladwati a.<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>Li va jije malere a pèp la.</para>
  <para style="q1" vid="PSA 72:4">Li va fè sekou pou pitit a malere yo,</para>
  <para style="q1" vid="PSA 72:4">e kraze opresè a an mòso.<verse eid="PSA 72:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>Yo va krent Ou <note caller="+" style="x"><char style="xo" closed="false">72:5 </char><char style="xt" closed="false"><ref loc="PSA 72:17">Sòm 72:17</ref></char></note> pou tout tan ke solèy la klere</para>
  <para style="q1" vid="PSA 72:5">ak tout tan ke genyen lalin, pandan tout jenerasyon yo.<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>Li va desann <note caller="+" style="x"><char style="xo" closed="false">72:6 </char><char style="xt" closed="false"><ref loc="DEU 32:2">Det 32:2</ref></char></note> tankou lapli sou chan zèb fenk koupe yo,</para>
  <para style="q1" vid="PSA 72:6">tankou farinaj ki wouze tè a.<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>Nan jou li yo, moun ladwati yo va fleri,</para>
  <para style="q1" vid="PSA 72:7">avèk <note caller="+" style="x"><char style="xo" closed="false">72:7 </char><char style="xt" closed="false"><ref loc="ISA 2:4">És 2:4</ref> </char></note>lapè an abondans jiskaske lalin nan pa wè ankò.<verse eid="PSA 72:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>Anplis, l ap renye jiskaske yon <note caller="+" style="x"><char style="xo" closed="false">72:8 </char><char style="xt" closed="false"><ref loc="EXO 23:31">Egz 23:31</ref></char></note> lanmè rive nan yon lòt lanmè a,</para>
  <para style="q1" vid="PSA 72:8">e soti nan Rivyè a jis rive nan dènye pwent tè a.<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>Pèp ki abite nan dezè a va bese devan l,</para>
  <para style="q1" vid="PSA 72:9">e lènmi li yo <note caller="+" style="x"><char style="xo" closed="false">72:9 </char><char style="xt" closed="false"><ref loc="ISA 49:23">És 49:23</ref></char></note> va niche pousyè a.<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>Wa a Tarsis yo avèk lil yo va pote kado.</para>
  <para style="q1" vid="PSA 72:10">Wa a Séba avèk <note caller="+" style="x"><char style="xo" closed="false">72:10 </char><char style="xt" closed="false"><ref loc="GEN 10:7">Jen 10:7</ref> </char></note>Saba yo ap ofri kado.<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>Konsa, tout wa yo va bese ba devan l, pou tout <note caller="+" style="x"><char style="xo" closed="false">72:11 </char><char style="xt" closed="false"><ref loc="PSA 86:9">Sòm 86:9</ref></char></note>nasyon yo sèvi li.<verse eid="PSA 72:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>Paske li va <note caller="+" style="x"><char style="xo" closed="false">72:12 </char><char style="xt" closed="false"><ref loc="JOB 29:12">Job 29:12</ref></char></note> delivre malere a lè l kriye sekou;</para>
  <para style="q1" vid="PSA 72:12">aflije a tou, lè l san soutyen an.<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>Li va gen <note caller="+" style="x"><char style="xo" closed="false">72:13 </char><char style="xt" closed="false"><ref loc="PRO 19:17">Pwov 19:17</ref></char></note> mizerikòd sou malere a avèk endijan an.</para>
  <para style="q1" vid="PSA 72:13">Konsa, lavi a pòv yo, li va sove.<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>Li va rachte lavi yo soti nan opresyon avèk vyolans,</para>
  <para style="q1" vid="PSA 72:14">e san yo va chè nan zye Li.<verse eid="PSA 72:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>Konsa, li va viv, e <note caller="+" style="x"><char style="xo" closed="false">72:15 </char><char style="xt" closed="false"><ref loc="ISA 60:6">És 60:6</ref></char></note> lò a Séba va bay a li menm.</para>
  <para style="q1" vid="PSA 72:15">Moun va priye pou li san rete.</para>
  <para style="q1" vid="PSA 72:15">Yo va beni li tout lajounen.<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>Va genyen anpil sereyal sou tout kolin peye a,</para>
  <para style="q1" vid="PSA 72:16">fwi li yo k ap vannen nan van tankou pye sèd a Liban yo.</para>
  <para style="q1" vid="PSA 72:16">Sa ki nan vil yo va fleri tankou <note caller="+" style="x"><char style="xo" closed="false">72:16 </char><char style="xt" closed="false"><ref loc="JOB 5:25">Job 5:25</ref></char></note> vèdi latè.<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>Non li va dire jis pou tout tan.</para>
  <para style="q1" vid="PSA 72:17">Non li va la <note caller="+" style="x"><char style="xo" closed="false">72:17 </char><char style="xt" closed="false"><ref loc="PSA 89:36">Sòm 89:36</ref> </char></note>toutotan solèy la ap briye a.</para>
  <para style="q1" vid="PSA 72:17">Tout lezòm va beni pa li.</para>
  <para style="q1" vid="PSA 72:17">Tout nasyon yo va rele li beni.<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>Beni se SENYÈ Bondye a, Bondye Israël la!</para>
  <para style="q1" vid="PSA 72:18">Li sèl ki fè mèvèy!<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>Beni se <note caller="+" style="x"><char style="xo" closed="false">72:19 </char><char style="xt" closed="false"><ref loc="NEH 9:5">Né 9:5</ref></char></note> non laglwa Li jis pou tout tan!</para>
  <para style="q1" vid="PSA 72:19">Ke tout tè a kapab ranpli ak glwa Li!</para>
  <para style="q1" vid="PSA 72:19">Amen e amen.<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>Priyè yo a David, fis la a Jesse fini.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms1">LIV 3</para>
  <para style="d">Yon Sòm Asaph</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>Anverite, Bondye bon a Israël,</para>
  <para style="q1" vid="PSA 73:1">a sila avèk kè ki <note caller="+" style="x"><char style="xo" closed="false">73:1 </char><char style="xt" closed="false"><ref loc="PSA 24:4">Sòm 24:4</ref></char></note> san tach yo!<verse eid="PSA 73:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>Men pou mwen, <note caller="+" style="x"><char style="xo" closed="false">73:2 </char><char style="xt" closed="false"><ref loc="PSA 94:18">Sòm 94:18</ref></char></note> pye m te prèt pou glise tonbe,</para>
  <para style="q1" vid="PSA 73:2">Pa m yo te prèt pou chape.<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>Paske mwen te gen anvi awogan yo,</para>
  <para style="q1" vid="PSA 73:3">lè m te wè jan <note caller="+" style="x"><char style="xo" closed="false">73:3 </char><char style="xt" closed="false"><ref loc="JOB 21:7">Job 21:7</ref></char></note>mechan yo te byen reyisi.<verse eid="PSA 73:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>Paske nan lanmò yo, nanpwen soufrans e kò yo byen gra.<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>Yo pa nan pwoblèm tankou lòt moun,</para>
  <para style="q1" vid="PSA 73:5">ni yo pa toumante tankou limanite.<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>Pou sa, yo pote ògèy tankou yon bèl <note caller="+" style="x"><char style="xo" closed="false">73:6 </char><char style="xt" closed="false"><ref loc="GEN 41:42">Jen 41:42</ref></char></note> kolye.</para>
  <para style="q1" vid="PSA 73:6">Abiman vyolans kouvri kon yon bèl rad.<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>Zye yo anfle nan mitan <note caller="+" style="x"><char style="xo" closed="false">73:7 </char><char style="xt" closed="false"><ref loc="JOB 15:27">Job 15:27</ref></char></note> grès yo.</para>
  <para style="q1" vid="PSA 73:7">Imajinasyon a kè yo dechennen nèt.<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>Yo <note caller="+" style="x"><char style="xo" closed="false">73:8 </char><char style="xt" closed="false"><ref loc="PSA 1:1">Sòm 1:1</ref></char></note> giyonnen moun.</para>
  <para style="q1" vid="PSA 73:8">Ak mechanste, yo pale afè oprime lòt moun.</para>
  <para style="q1" vid="PSA 73:8">Yo pale konsi se anwo sa soti.<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>Nan bouch <note caller="+" style="x"><char style="xo" closed="false">73:9 </char><char style="xt" closed="false"><ref loc="REV 13:6">Rev 13:6</ref></char></note> yo rive nan syèl la,</para>
  <para style="q1" vid="PSA 73:9">pandan lang yo fè gwo pwomnad sou tout latè.<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>Akoz sa a, pèp pa yo retounen kote yo,</para>
  <para style="q1" vid="PSA 73:10">e yo kontinye bwè <note caller="+" style="x"><char style="xo" closed="false">73:10 </char><char style="xt" closed="false"><ref loc="PSA 23:5">Sòm 23:5</ref></char></note> gran sous yo nèt.<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>Yo di: “Kòman Bondye konnen?</para>
  <para style="q1" vid="PSA 73:11">Eske gen konesans kote Pi Wo a?”<verse eid="PSA 73:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>Gade byen, sila yo se mechan yo ye.</para>
  <para style="q1" vid="PSA 73:12">Konsi, toujou <note caller="+" style="x"><char style="xo" closed="false">73:12 </char><char style="xt" closed="false"><ref loc="JER 49:31">Jr 49:31</ref></char></note> alèz, yo te agrandi richès yo.<verse eid="PSA 73:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>Anverite, <note caller="+" style="x"><char style="xo" closed="false">73:13 </char><char style="xt" closed="false"><ref loc="JOB 21:15">Job 21:15</ref></char></note> se an ven mwen te kenbe kè m san tach,</para>
  <para style="q1" vid="PSA 73:13">ak lave men m nan inosans.<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>Paske mwen te twouble tout lajounen</para>
  <para style="q1" vid="PSA 73:14">e te resevwa <note caller="+" style="x"><char style="xo" closed="false">73:14 </char><char style="xt" closed="false"><ref loc="JOB 33:9">Job 33:9</ref></char></note> chatiman chak maten.<verse eid="PSA 73:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>Si mwen te di: “Mwen va pale konsa,”</para>
  <para style="q1" vid="PSA 73:15">gade byen, mwen ta trayi <note caller="+" style="x"><char style="xo" closed="false">73:15 </char><char style="xt" closed="false"><ref loc="PSA 14:5">Sòm 14:5</ref></char></note> jenerasyon pitit Ou yo.<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>Lè m te <note caller="+" style="x"><char style="xo" closed="false">73:16 </char><char style="xt" closed="false"><ref loc="ECC 8:17">Ekl 8:17</ref></char></note> reflechi pou konprann sa, zye m pa t wè klè menm.<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>Men jis lè m te antre nan sanktiyè Bondye a,</para>
  <para style="q1" vid="PSA 73:17">mwen te vin konprann jan yo ta <note caller="+" style="x"><char style="xo" closed="false">73:17 </char><char style="xt" closed="false"><ref loc="PSA 37:38">Sòm 37:38</ref></char></note> fini.<verse eid="PSA 73:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>Anverite, Ou te mete yo kote ki <note caller="+" style="x"><char style="xo" closed="false">73:18 </char><char style="xt" closed="false"><ref loc="PSA 35:6">Sòm 35:6</ref></char></note> glise anpil.</para>
  <para style="q1" vid="PSA 73:18">Ou te jete yo ba jiskaske yo fini nèt.<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>Men kijan yo va <note caller="+" style="x"><char style="xo" closed="false">73:19 </char><char style="xt" closed="false"><ref loc="NUM 16:21">Nonb 16:21</ref></char></note> detwi nan yon enstan!</para>
  <para style="q1" vid="PSA 73:19">Y ap bale nèt ale avèk gran perèz kap rive sibitman!<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>Tankou yon rèv lè moun leve, O SENYÈ,</para>
  <para style="q1" vid="PSA 73:20">lè Ou leve, Ou va <note caller="+" style="x"><char style="xo" closed="false">73:20 </char><char style="xt" closed="false"><ref loc="1SA 2:30">I Sam 2:30</ref></char></note> meprize pwòp fòm yo.</para>
  <para style="q1" vid="PSA 73:20">Ou va rayi rèv de lespri yo.<verse eid="PSA 73:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>Lè kè m te vin anmè,</para>
  <para style="q1" vid="PSA 73:21">e kè m te <note caller="+" style="x"><char style="xo" closed="false">73:21 </char><char style="xt" closed="false"><ref loc="ACT 2:37">Trav 2:37</ref> </char></note>pike anndan m,<verse eid="PSA 73:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22"/>alò, mwen te vin ensansib e san bon konprann.</para>
  <para style="q1" vid="PSA 73:22">Mwen te tankou yon <note caller="+" style="x"><char style="xo" closed="false">73:22 </char><char style="xt" closed="false"><ref loc="JOB 18:3">Job 18:3</ref></char></note>bèt devan Ou.<verse eid="PSA 73:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>Sepandan, <note caller="+" style="x"><char style="xo" closed="false">73:23 </char><char style="xt" closed="false"><ref loc="PSA 16:8">Sòm 16:8</ref></char></note> mwen avè W tout tan.</para>
  <para style="q1" vid="PSA 73:23">Ou te kenbe men dwat mwen.<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>Avèk konsèy Ou, Ou va gide mwen,</para>
  <para style="q1" vid="PSA 73:24">e apre, <note caller="+" style="x"><char style="xo" closed="false">73:24 </char><char style="xt" closed="false"><ref loc="GEN 5:24">Jen 5:24</ref></char></note>resevwa mwen nan laglwa.<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">73:25 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:2">Sòm 16:2</ref>
      </char>
    </note> Se kilès mwen gen nan syèl la sof ke Ou?</para>
  <para style="q1" vid="PSA 73:25">Epi anplis ke Ou, mwen pa vle anyen sou latè.<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">73:26 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:10">Sòm 38:10</ref>
      </char>
    </note> Chè mwen avèk kè mwen kab fè fayit,</para>
  <para style="q1" vid="PSA 73:26">men Bondye se fòs kè mwen ak pòsyon mwen jis pou tout tan.<verse eid="PSA 73:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>Paske gade byen, sila ki lwen yo va <note caller="+" style="x"><char style="xo" closed="false">73:27 </char><char style="xt" closed="false"><ref loc="PSA 37:20">Sòm 37:20</ref></char></note> peri.</para>
  <para style="q1" vid="PSA 73:27">Ou te detwi tout sila ki pa t fidèl a Ou menm yo.<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>Men pou mwen, rete pre Bondye se bonte mwen.</para>
  <para style="q1" vid="PSA 73:28">Mwen te fè Senyè a, BONDYE a, <note caller="+" style="x"><char style="xo" closed="false">73:28 </char><char style="xt" closed="false"><ref loc="PSA 14:6">Sòm 14:6</ref></char></note>refij mwen,</para>
  <para style="q1" vid="PSA 73:28">Pou m kab pale tout zèv Ou yo.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="d">Yon Sòm Asaph</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>O Bondye, poukisa Ou te rejte nou pou tout tan?</para>
  <para style="q1" vid="PSA 74:1">Poukisa kòlè Ou <note caller="+" style="x"><char style="xo" closed="false">74:1 </char><char style="xt" closed="false"><ref loc="DEU 29:20">Det 29:20</ref></char></note> fè lafimen kont mouton patiraj Ou an?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>Sonje asanble Ou a, ke Ou te achte depi tan ansyen yo,</para>
  <para style="q1" vid="PSA 74:2">sa yo ke Ou te <note caller="+" style="x"><char style="xo" closed="false">74:2 </char><char style="xt" closed="false"><ref loc="EXO 15:13">Egz 15:13</ref></char></note>rachte pou fè tribi eritaj pa Ou:</para>
  <para style="q1" vid="PSA 74:2">Mòn Sion sila a, kote Ou te abite.<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>Vire pa Ou yo pou rive kote mazi ki kraze nèt yo,</para>
  <para style="q1" vid="PSA 74:3">kote lènmi a <note caller="+" style="x"><char style="xo" closed="false">74:3 </char><char style="xt" closed="false"><ref loc="PSA 79:1">Sòm 79:1</ref></char></note> fin fè tout mechanste li anndan sanktiyè a.<verse eid="PSA 74:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>Advèsè Ou yo te vin anraje nan mitan kote asanble Ou a.</para>
  <para style="q1" vid="PSA 74:4">Yo fin monte <note caller="+" style="x"><char style="xo" closed="false">74:4 </char><char style="xt" closed="false"><ref loc="NUM 2:2">Nonb 2:2</ref></char></note> pwòp drapo yo kon avètisman an.<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>Yo aji kòn yon moun k ap</para>
  <para style="q1" vid="PSA 74:5">leve <note caller="+" style="x"><char style="xo" closed="false">74:5 </char><char style="xt" closed="false"><ref loc="JER 46:22">Jr 46:22</ref></char></note> rach li nan mitan yon forè bwa.<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>Epi koulye a, tout travay skilpti li yo, <note caller="+" style="x"><char style="xo" closed="false">74:6 </char><char style="xt" closed="false"><ref loc="1KI 6:18-35">I Wa 6:18-35</ref></char></note></para>
  <para style="q1" vid="PSA 74:6">yo kraze ak rach avèk mato.<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>Yo fin <note caller="+" style="x"><char style="xo" closed="false">74:7 </char><char style="xt" closed="false"><ref loc="2KI 25:9">II Wa 25:9</ref></char></note> brile sanktiyè Ou a jis rive atè.</para>
  <para style="q1" vid="PSA 74:7">Yo te souye abitasyon ki fèt nan non Ou an.<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>Yo te <note caller="+" style="x"><char style="xo" closed="false">74:8 </char><char style="xt" closed="false"><ref loc="PSA 83:4">Sòm 83:4</ref></char></note> pale nan kè yo: “Annou kraze yo nèt.”</para>
  <para style="q1" vid="PSA 74:8">Yo te brile tout kote asanble Bondye nan tout peyi a.<verse eid="PSA 74:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>Nou paz ankò wè mèvèy yo.</para>
  <para style="q1" vid="PSA 74:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">74:9 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 3:1">I Sam 3:1</ref>
      </char>
    </note>Nanpwen pwofèt ankò.</para>
  <para style="q1" vid="PSA 74:9">Ni pa genyen pami nou ki konnen konbyen de tan sa va dire.<verse eid="PSA 74:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>Konbyen de tan, O Bondye,</para>
  <para style="q1" vid="PSA 74:10">advèsè a va moke nou ak mo brile?</para>
  <para style="q1" vid="PSA 74:10">Èske se pou tout tan lènmi an va <note caller="+" style="x"><char style="xo" closed="false">74:10 </char><char style="xt" closed="false"><ref loc="LEV 24:16">Lev 24:16</ref></char></note>giyonnen non Ou konsa?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>Poukisa Ou retire men Ou?</para>
  <para style="q1" vid="PSA 74:11">Sitou men dwat Ou?</para>
  <para style="q1" vid="PSA 74:11">Fè l parèt sòti anndan lestonmak Ou pou <note caller="+" style="x"><char style="xo" closed="false">74:11 </char><char style="xt" closed="false"><ref loc="PSA 59:13">Sòm 59:13</ref></char></note>detwi yo!<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>Men Bondye se <note caller="+" style="x"><char style="xo" closed="false">74:12 </char><char style="xt" closed="false"><ref loc="PSA 44:4">Sòm 44:4</ref></char></note> Wa mwen depi nan tan ansyen yo.</para>
  <para style="q1" vid="PSA 74:12">Li te fè zèv delivrans nan mitan latè.<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>Ou te divize lanmè a ak fòs kouraj Ou.</para>
  <para style="q1" vid="PSA 74:13">Ou te kraze tèt <note caller="+" style="x"><char style="xo" closed="false">74:13 </char><char style="xt" closed="false"><ref loc="PSA 148:7">Sòm 148:7</ref></char></note>gwo bèt lanmè yo.<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>Ou te kraze tèt <note caller="+" style="x"><char style="xo" closed="false">74:14 </char><char style="xt" closed="false"><ref loc="JOB 41:1">Job 41:1</ref></char></note> Levyatan an.</para>
  <para style="q1" vid="PSA 74:14">Ou te bay li kon manje pou bèt sovaj.<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>Ou te fè pete sous ki koule dlo fre.</para>
  <para style="q1" vid="PSA 74:15">Ou te seche gwo rivyè pwisan yo.<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>Jou yo se pou Ou, anplis, nwit yo se pou Ou.</para>
  <para style="q1" vid="PSA 74:16">Ou te <note caller="+" style="x"><char style="xo" closed="false">74:16 </char><char style="xt" closed="false"><ref loc="GEN 1:14-18">Jen 1:14-18</ref></char></note> prepare limyè a avèk solèy la.<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>Ou te etabli tout lizyè latè yo.</para>
  <para style="q1" vid="PSA 74:17">Ou te fè <note caller="+" style="x"><char style="xo" closed="false">74:17 </char><char style="xt" closed="false"><ref loc="DEU 32:8">Det 32:8</ref></char></note> sezon ete ak sezon livè.<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>Sonje bagay sa a, O SENYÈ,</para>
  <para style="q1" vid="PSA 74:18">ke lènmi yo te meprize Ou,</para>
  <para style="q1" vid="PSA 74:18">e <note caller="+" style="x"><char style="xo" closed="false">74:18 </char><char style="xt" closed="false"><ref loc="DEU 32:6">Det 32:6</ref></char></note> yon pèp ki plen ak foli te refize non Ou.<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>Pa livre nanm a toutrèl Ou a bèt sovaj yo.</para>
  <para style="q1" vid="PSA 74:19">Pa bliye lavi aflije Ou yo pou tout tan.<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>Konsidere akò Ou, paske</para>
  <para style="q1" vid="PSA 74:20">
    <note caller="+" style="x">
      <char style="xo" closed="false">74:20 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 88:6">Sòm 88:6</ref>
      </char>
    </note> kote fènwa yo nan tout latè a,</para>
  <para style="q1" vid="PSA 74:20">plen ak abitasyon vyolans yo.<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>Pa kite <note caller="+" style="x"><char style="xo" closed="false">74:21 </char><char style="xt" closed="false"><ref loc="PSA 103:6">Sòm 103:6</ref></char></note> oprime yo retounen nan gwo wont.</para>
  <para style="q1" vid="PSA 74:21">Kite aflije yo ak malere yo louwe Non Ou.<verse eid="PSA 74:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>Leve, O Bondye! Plede koz Ou!</para>
  <para style="q1" vid="PSA 74:22">Sonje jan <note caller="+" style="x"><char style="xo" closed="false">74:22 </char><char style="xt" closed="false"><ref loc="PSA 14:1">Sòm 14:1</ref></char></note> lòm plen foli meprize Ou tout lajounen.<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>Pa bliye vwa advèsè Ou yo.</para>
  <para style="q1" vid="PSA 74:23">
    <note caller="+" style="x">
      <char style="xo" closed="false">74:23 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 65:7">Sòm 65:7</ref>
      </char>
    </note> Gwo zen a sila ki leve kont Ou yo monte tout tan, san rete.<verse eid="PSA 74:23"/></para>
  <para style="b"/>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="d">Pou direktè koral la; pou jwe a melodi “Pa Detwi”</para>
  <para style="d">Yon Sòm Asaph, yon Chanson</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>Nou bay remèsiman a Ou menm, O Bondye,</para>
  <para style="q1" vid="PSA 75:1">Nou bay remèsiman, paske Non Ou toupre.</para>
  <para style="q1" vid="PSA 75:1">Moun yo fè deklarasyon <note caller="+" style="x"><char style="xo" closed="false">75:1 </char><char style="xt" closed="false"><ref loc="PSA 26:7">Sòm 26:7</ref></char></note>zèv mèvèy Ou yo.<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>“Lè Mwen menm fikse yon tan ki apwente,</para>
  <para style="q1" vid="PSA 75:2">Mwen va <note caller="+" style="x"><char style="xo" closed="false">75:2 </char><char style="xt" closed="false"><ref loc="PSA 9:8">Sòm 9:8</ref></char></note>jije avèk jistis.<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>Latè avèk tout sa ki ladann souke.</para>
  <para style="q1" vid="PSA 75:3">Se Mwen menm ki kenbe pilye li yo.” <char style="qs">Tan</char><verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>Mwen te di a awogan yo: “Pa vin ògeye!”</para>
  <para style="q1" vid="PSA 75:4">A mechan an: <note caller="+" style="x"><char style="xo" closed="false">75:4 </char><char style="xt" closed="false"><ref loc="ZEC 1:21">Za 1:21</ref></char></note> “Pa leve kòn nan.<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>Pa leve kòn ou anwo.</para>
  <para style="q1" vid="PSA 75:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">75:5 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:3">I Sam 2:3</ref>
      </char>
    </note> Pa pale kou rèd avèk ògèy ensolan.”<verse eid="PSA 75:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>Paske ni sòti nan lès, ni nan lwès,</para>
  <para style="q1" vid="PSA 75:6">ni bò kote <note caller="+" style="x"><char style="xo" closed="false">75:6 </char><char style="xt" closed="false"><ref loc="PSA 3:3">Sòm 3:3</ref></char></note> dezè a,</para>
  <para style="q1" vid="PSA 75:6">kab gen fòs pou leve moun anwo;<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>Men Bondye se jij la.</para>
  <para style="q1" vid="PSA 75:7">Li <note caller="+" style="x"><char style="xo" closed="false">75:7 </char><char style="xt" closed="false"><ref loc="PSA 50:6">Sòm 50:6</ref></char></note> fè yon moun desann,</para>
  <para style="q1" vid="PSA 75:7">e li leve yon lòt fè l wo.<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>Paske gen yon tas nan men SENYÈ a,</para>
  <para style="q1" vid="PSA 75:8">e diven an ap kimen.</para>
  <para style="q1" vid="PSA 75:8">Li byen mele e Bondye vide fè l sòti ladann.</para>
  <para style="q1" vid="PSA 75:8">Anverite, <note caller="+" style="x"><char style="xo" closed="false">75:8 </char><char style="xt" closed="false"><ref loc="OBA 1:16">Ab 16</ref></char></note> tout mechan yo oblije bwè l jis rive nan dènye ti gout li.<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>Men pou mwen, mwen va <note caller="+" style="x"><char style="xo" closed="false">75:9 </char><char style="xt" closed="false"><ref loc="PSA 22:22">Sòm 22:22</ref></char></note> deklare sa, jis pou tout tan.</para>
  <para style="q1" vid="PSA 75:9">Mwen va chante lwanj a Bondye Jacob la.<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>Tout kòn a mechan yo, Mwen va koupe fè yo sòti nèt.</para>
  <para style="q1" vid="PSA 75:10">Men <note caller="+" style="x"><char style="xo" closed="false">75:10 </char><char style="xt" closed="false"><ref loc="1SA 2:1">I Sam 2:1</ref></char></note> kòn a moun ladwati yo va leve wo.<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="d">Pou direktè koral la; sou enstriman ak kòd</para>
  <para style="d">Yon Sòm Asaph, yon Chanson</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>Bondye byen rekonèt nan Juda.</para>
  <para style="q1" vid="PSA 76:1">Non Li <note caller="+" style="x"><char style="xo" closed="false">76:1 </char><char style="xt" closed="false"><ref loc="PSA 99:3">Sòm 99:3</ref></char></note>gran an Israël.<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>Tabènak Li a nan Salem.</para>
  <para style="q1" vid="PSA 76:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">76:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:5">Sòm 27:5</ref>
      </char>
    </note> Abitasyon Li an osi nan Sion.<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>La, Li te <note caller="+" style="x"><char style="xo" closed="false">76:3 </char><char style="xt" closed="false"><ref loc="PSA 46:9">Sòm 46:9</ref></char></note> kase flèch dife yo,</para>
  <para style="q1" vid="PSA 76:3">boukliye ak nepe ak zam lagè yo.<verse eid="PSA 76:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>Ou manyifik, pi majeste pase mòn</para>
  <para style="q1" vid="PSA 76:4">ak bèt lachas yo.<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>Sila ak <note caller="+" style="x"><char style="xo" closed="false">76:5 </char><char style="xt" closed="false"><ref loc="ISA 10:12">És 10:12</ref></char></note> gran kouraj yo te piyaje,</para>
  <para style="q1" vid="PSA 76:5">yo te fonse tonbe nan dòmi mò a.</para>
  <para style="q1" vid="PSA 76:5">Okenn nan gèrye yo ka sèvi men yo.<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>Nan repwòch Ou, O Bondye Jacob,</para>
  <para style="q1" vid="PSA 76:6">ni <note caller="+" style="x"><char style="xo" closed="false">76:6 </char><char style="xt" closed="false"><ref loc="EXO 15:1-21">Egz 15:1-21</ref></char></note> chevalye yo ak cheval la te tonbe nan yon pwofon somèy.<verse eid="PSA 76:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>Ou menm, Ou merite lakrent.</para>
  <para style="q1" vid="PSA 76:7">Se <note caller="+" style="x"><char style="xo" closed="false">76:7 </char><char style="xt" closed="false"><ref loc="EZR 9:15">Esd 9:15</ref></char></note> kilès ki kab kanpe nan prezans Ou lè Ou fache?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>Ou te fè jijman tande soti nan syèl la.</para>
  <para style="q1" vid="PSA 76:8">Latè te <note caller="+" style="x"><char style="xo" closed="false">76:8 </char><char style="xt" closed="false"><ref loc="1CH 16:30">I Kwo 16:30</ref></char></note> krent, e te kanpe rete an plas<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>lè Bondye te leve nan jijman an,</para>
  <para style="q1" vid="PSA 76:9">pou sove tout enb sou latè yo. <char style="qs">Tan</char><verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>Paske kòlè a lòm va bay Ou glwa.</para>
  <para style="q1" vid="PSA 76:10">Se retay kòlè pa W, ki sispann fè mal.<verse eid="PSA 76:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">76:11 </char>
      <char style="xt" closed="false">
        <ref loc="ECC 5:4-6">Ekl 5:4-6</ref>
      </char>
    </note> Fè ve Ou yo a SENYÈ a, Bondye Ou a e akonpli yo.</para>
  <para style="q1" vid="PSA 76:11">Kite tout sila ki antoure Li yo</para>
  <para style="q1" vid="PSA 76:11">mennen don a Sila ki merite lakrent lan.<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>Li va koupe retire nanm a prens yo.</para>
  <para style="q1" vid="PSA 76:12">Wa latè yo <note caller="+" style="x"><char style="xo" closed="false">76:12 </char><char style="xt" closed="false"><ref loc="PSA 47:2">Sòm 47:2</ref></char></note> gen lakrent Li.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="d">Pou direktè koral la: pou Jeduthun. Yon Sòm Asaph</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>Vwa m leve vè Bondye!</para>
  <para style="q1" vid="PSA 77:1">Mwen <note caller="+" style="x"><char style="xo" closed="false">77:1 </char><char style="xt" closed="false"><ref loc="PSA 3:4">Sòm 3:4</ref></char></note> kriye pou sekou.</para>
  <para style="q1" vid="PSA 77:1">Vwa m leve vè Bondye pou L tande mwen.<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>Nan <note caller="+" style="x"><char style="xo" closed="false">77:2 </char><char style="xt" closed="false"><ref loc="PSA 50:15">Sòm 50:15</ref></char></note> jou gwo twoub mwen an, mwen te chache SENYÈ a.</para>
  <para style="q1" vid="PSA 77:2">Nan nwit, mwen te lonje men m san poze.</para>
  <para style="q1" vid="PSA 77:2">Nanm mwen te refize rekonfòte.<verse eid="PSA 77:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>Lè mwen sonje Bondye, alò, lespri m twouble.</para>
  <para style="q1" vid="PSA 77:3">Mwen fè soupi; <note caller="+" style="x"><char style="xo" closed="false">77:3 </char><char style="xt" closed="false"><ref loc="PSA 61:2">Sòm 61:2</ref></char></note>lespri m febli nèt.<verse eid="PSA 77:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>Ou te kenbe zye mwen yo louvri.</para>
  <para style="q1" vid="PSA 77:4">Mwen tèlman twouble ke m <note caller="+" style="x"><char style="xo" closed="false">77:4 </char><char style="xt" closed="false"><ref loc="PSA 39:9">Sòm 39:9</ref></char></note> pa kab pale.<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>Mwen te reflechi sou <note caller="+" style="x"><char style="xo" closed="false">77:5 </char><char style="xt" closed="false"><ref loc="DEU 32:7">Det 32:7</ref></char></note> jou lansyen yo, ane lontan yo.<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>Chanson mwen, mwen va sonje pandan lannwit.</para>
  <para style="q1" vid="PSA 77:6">Mwen <note caller="+" style="x"><char style="xo" closed="false">77:6 </char><char style="xt" closed="false"><ref loc="PSA 4:4">Sòm 4:4</ref></char></note> reflechi tout tan nan kè mwen.</para>
  <para style="q1" vid="PSA 77:6">Lespri m reflechi jis rive nan fon kè m:<verse eid="PSA 77:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“Èske Senyè a va rejte nou pou tout tan?</para>
  <para style="q1" vid="PSA 77:7">Èske Li <note caller="+" style="x"><char style="xo" closed="false">77:7 </char><char style="xt" closed="false"><ref loc="PSA 85:1-5">Sòm 85:1-5</ref></char></note>p ap janm kite favè Li vini sou nou ankò?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>Èske lanmou dous Li a kite nou pou tout tan?</para>
  <para style="q1" vid="PSA 77:8">Èske <note caller="+" style="x"><char style="xo" closed="false">77:8 </char><char style="xt" closed="false"><ref loc="2PE 3:9">II Pi 3:9</ref></char></note>pwomès Li yo fini nèt?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>Èske Bondye te bliye gras Li,</para>
  <para style="q1" vid="PSA 77:9">Oswa nan kòlè Li, èske Li te retire mizerikòd Li a?” <char style="qs">Tan</char><verse eid="PSA 77:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>Epi mwen te di: “Se chagren mwen ki fè m panse</para>
  <para style="q1" vid="PSA 77:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">77:10 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:2-3">Sòm 44:2-3</ref>
      </char>
    </note> men dwat a Wo Pwisan an vin chanje.”<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>Mwen va sonje <note caller="+" style="x"><char style="xo" closed="false">77:11 </char><char style="xt" closed="false"><ref loc="PSA 105:5">Sòm 105:5</ref></char></note> zèv SENYÈ yo.</para>
  <para style="q1" vid="PSA 77:11">Anverite, Mwen va sonje mèvèy Ou yo nan tan ansyen yo.<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">77:12 </char><char style="xt" closed="false"><ref loc="PSA 145:5">Sòm 145:5</ref></char></note> reflechi tout tan sou tout zèv Ou yo,</para>
  <para style="q1" vid="PSA 77:12">pou m sonje nan kè m tout sa Ou te fè.<verse eid="PSA 77:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>Chemen Ou a, O Bondye, se apa.</para>
  <para style="q1" vid="PSA 77:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">77:13 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:11">Egz 15:11</ref>
      </char>
    </note> Ki dye ki gran tankou Bondye pa nou an?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>Ou se Bondye ki fè zèv mèvèy.</para>
  <para style="q1" vid="PSA 77:14">Ou te fè pwisans Ou rekonèt pami pèp yo.<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>Avèk pwòp pouvwa Ou, Ou te <note caller="+" style="x"><char style="xo" closed="false">77:15 </char><char style="xt" closed="false"><ref loc="EXO 6:6">Egz 6:6</ref></char></note> rachte pèp Ou a,</para>
  <para style="q1" vid="PSA 77:15">fis a Jacob yo avèk Joseph. <char style="qs">Tan</char><verse eid="PSA 77:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">77:16 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Egz 14:21</ref>
      </char>
    </note> Dlo yo te wè Ou, O Bondye.</para>
  <para style="q1" vid="PSA 77:16">Dlo yo te wè Ou.</para>
  <para style="q1" vid="PSA 77:16">Yo te nan gran doulè.</para>
  <para style="q1" vid="PSA 77:16">Anplis, fon yo te boulvèse.<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">77:17 </char>
      <char style="xt" closed="false">
        <ref loc="JDG 5:4">Jij 5:4</ref>
      </char>
    </note> Nwaj yo te vide gwo dlo.</para>
  <para style="q1" vid="PSA 77:17">Syèl yo te bay gwo kout loray.</para>
  <para style="q1" vid="PSA 77:17">Flèch Ou yo te lime pa isit e pa lòtbò.<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">77:18 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:13">Sòm 18:13</ref>
      </char>
    </note> Bwi tonnè a eklate nan toubiyon an.</para>
  <para style="q1" vid="PSA 77:18">Loray yo te klere tout tè a.</para>
  <para style="q1" vid="PSA 77:18">Mond lan te tranble.</para>
  <para style="q1" vid="PSA 77:18">Li te souke.<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">77:19 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 51:10">És 51:10</ref>
      </char>
    </note> Chemen Ou an te nan lanmè a,</para>
  <para style="q1" vid="PSA 77:19">e vwa Ou nan dlo pwisan yo.</para>
  <para style="q1" vid="PSA 77:19">Kote Ou mache p ap kab dekouvri menm.<verse eid="PSA 77:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>Ou te dirije pèp Ou a tankou yon bann,</para>
  <para style="q1" vid="PSA 77:20">pa men <note caller="+" style="x"><char style="xo" closed="false">77:20 </char><char style="xt" closed="false"><ref loc="EXO 6:26">Egz 6:26</ref></char></note>Moïse avèk Aaron.<verse eid="PSA 77:20"/></para>
  <para style="b"/>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="d">Yon Sòm a Asaph</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">78:1 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 51:4">És 51:4</ref>
      </char>
    </note> Koute, O pèp mwen an a lenstriksyon mwen.</para>
  <para style="q1" vid="PSA 78:1">Panche zòrèy Ou vè pawòl a bouch mwen.<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">78:2 </char><char style="xt" closed="false"><ref loc="PSA 49:4">Sòm 49:4</ref></char></note> ouvri bouch mwen avèk yon parabòl.</para>
  <para style="q1" vid="PSA 78:2">Mwen va pale pawòl fonse a tan ansyen yo,<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>ke nou te tande, konnen e ke</para>
  <para style="q1" vid="PSA 78:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">78:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:1">Sòm 44:1</ref>
      </char>
    </note> papa zansèt nou yo te fè nou konprann.<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>Nou p ap kache yo a pitit nou yo,</para>
  <para style="q1" vid="PSA 78:4">men nou va <note caller="+" style="x"><char style="xo" closed="false">78:4 </char><char style="xt" closed="false"><ref loc="EXO 13:8">Egz 13:8</ref></char></note>pale a jenerasyon k ap vini yo, tout lwanj SENYÈ a,</para>
  <para style="q1" vid="PSA 78:4">fòs Li ak gran mèvèy ke Li te konn fè yo.<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>Paske Li te etabli yon temwayaj</para>
  <para style="q1" vid="PSA 78:5">nan Jacob e te chwazi yon lwa an Israël,</para>
  <para style="q1" vid="PSA 78:5">sou sila Li te kòmande papa zansèt nou yo</para>
  <para style="q1" vid="PSA 78:5">pou yo ta <note caller="+" style="x"><char style="xo" closed="false">78:5 </char><char style="xt" closed="false"><ref loc="DEU 4:9">Det 4:9</ref></char></note> enstwi yo a pitit pa yo.<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>Ke jenerasyon k ap vini an ta kab konnen.</para>
  <para style="q1" vid="PSA 78:6">Menm pou sila ki poko fèt yo,</para>
  <para style="q1" vid="PSA 78:6">pou yo ta kab leve e <note caller="+" style="x"><char style="xo" closed="false">78:6 </char><char style="xt" closed="false"><ref loc="DEU 11:19">Det 11:19</ref></char></note> pale yo a pitit yo,<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>pou yo kab mete konfyans yo</para>
  <para style="q1" vid="PSA 78:7">nan Bondye e pa bliye zèv Bondye yo,</para>
  <para style="q1" vid="PSA 78:7">men <note caller="+" style="x"><char style="xo" closed="false">78:7 </char><char style="xt" closed="false"><ref loc="DEU 4:2">Det 4:2</ref> </char></note>kenbe kòmandman Li yo.<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>Pou yo <note caller="+" style="x"><char style="xo" closed="false">78:8 </char><char style="xt" closed="false"><ref loc="2KI 17:14">II Wa 17:14</ref></char></note> pa fè tankou papa zansèt yo,</para>
  <para style="q1" vid="PSA 78:8">yon jenerasyon tèt di e rebèl,</para>
  <para style="q1" vid="PSA 78:8">yon jenerasyon ki pa t gen kè fidèl,</para>
  <para style="q1" vid="PSA 78:8">ki pa t gen lespri fidèl a Bondye.<verse eid="PSA 78:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>Fis a Éphraïm yo ki kon tire flèch, te pote banza yo.</para>
  <para style="q1" vid="PSA 78:9">Sepandan, nan jou batay la, <note caller="+" style="x"><char style="xo" closed="false">78:9 </char><char style="xt" closed="false"><ref loc="JDG 20:39">Jij 20:39</ref></char></note> yo te fè bak.<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>Yo <note caller="+" style="x"><char style="xo" closed="false">78:10 </char><char style="xt" closed="false"><ref loc="JDG 2:20">Jij 2:20</ref></char></note> pa t kenbe akò yo ak Bondye</para>
  <para style="q1" vid="PSA 78:10">e te refize mache nan lalwa Li.<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>Yo te <note caller="+" style="x"><char style="xo" closed="false">78:11 </char><char style="xt" closed="false"><ref loc="PSA 106:13">Sòm 106:13</ref></char></note> bliye zèv Li yo avèk mirak ke Li te montre yo.<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>Li te fòje mirak yo devan zansèt yo,</para>
  <para style="q1" vid="PSA 78:12">nan peyi Égypte la ak nan <note caller="+" style="x"><char style="xo" closed="false">78:12 </char><char style="xt" closed="false"><ref loc="NUM 13:22">Nonb 13:22</ref></char></note>chan Tsoan an.<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>Li te divize lanmè a e te fè yo pase ladann.</para>
  <para style="q1" vid="PSA 78:13">Li te fè dlo yo <note caller="+" style="x"><char style="xo" closed="false">78:13 </char><char style="xt" closed="false"><ref loc="EXO 15:8">Egz 15:8</ref></char></note>kanpe wo tankou yon gwo pil.<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>Apre, Li te dirije yo avèk nwaj</para>
  <para style="q1" vid="PSA 78:14">nan lajounen e nan tout nwit lan avèk <note caller="+" style="x"><char style="xo" closed="false">78:14 </char><char style="xt" closed="false"><ref loc="EXO 14:24">Egz 14:24</ref></char></note> limyè dife.<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>Li te <note caller="+" style="x"><char style="xo" closed="false">78:15 </char><char style="xt" closed="false"><ref loc="EXO 17:6">Egz 17:6</ref></char></note> fann wòch yo nan dezè a</para>
  <para style="q1" vid="PSA 78:15">e te bay yo anpil dlo pou bwè tankou nan fon yo.<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>Li te <note caller="+" style="x"><char style="xo" closed="false">78:16 </char><char style="xt" closed="false"><ref loc="NUM 20:8">Nonb 20:8</ref></char></note> fè parèt sous ki te pete sòti nan wòch la,</para>
  <para style="q1" vid="PSA 78:16">e te fè dlo desann tankou larivyè.<verse eid="PSA 78:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>Sepandan, yo te kontinye peche kont Li,</para>
  <para style="q1" vid="PSA 78:17">e fè <note caller="+" style="x"><char style="xo" closed="false">78:17 </char><char style="xt" closed="false"><ref loc="DEU 9:22">Det 9:22</ref></char></note> rebèl kont Pi Wo a nan dezè a.<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>Konsa, nan kè yo, yo te pase Bondye a leprèv</para>
  <para style="q1" vid="PSA 78:18">lè yo te mande <note caller="+" style="x"><char style="xo" closed="false">78:18 </char><char style="xt" closed="false"><ref loc="NUM 11:4">Nonb 11:4</ref></char></note>manje selon dezi yo.<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>Wi, yo te pale kont Bondye.</para>
  <para style="q1" vid="PSA 78:19">Yo te di: <note caller="+" style="x"><char style="xo" closed="false">78:19 </char><char style="xt" closed="false"><ref loc="EXO 16:3">Egz 16:3</ref></char></note> “Èske Bondye kapab prepare yon tab nan dezè a?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>Gade byen, Li te frape wòch la pou dlo</para>
  <para style="q1" vid="PSA 78:20">kouri sòti e gwo sous yo t ap debòde.</para>
  <para style="q1" vid="PSA 78:20">Èske Li kapab bay pen tou?</para>
  <para style="q1" vid="PSA 78:20">Èske Li kab <note caller="+" style="x"><char style="xo" closed="false">78:20 </char><char style="xt" closed="false"><ref loc="NUM 11:18">Nonb 11:18</ref></char></note>founi vyann pou pèp Li a?”<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>Pou sa, SENYÈ a te tande e te <note caller="+" style="x"><char style="xo" closed="false">78:21 </char><char style="xt" closed="false"><ref loc="NUM 11:1">Nonb 11:1</ref></char></note> ranpli ak kòlè.</para>
  <para style="q1" vid="PSA 78:21">Konsa, yon dife te limen kont Jacob,</para>
  <para style="q1" vid="PSA 78:21">e chalè te monte tou kont Israël.<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>Paske yo <note caller="+" style="x"><char style="xo" closed="false">78:22 </char><char style="xt" closed="false"><ref loc="DEU 1:32">Det 1:32</ref></char></note> pa t kwè nan Bondye,</para>
  <para style="q1" vid="PSA 78:22">e pa t mete konfyans yo nan delivrans Li.<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>Men Li te kòmande nwaj anlè yo, e te <note caller="+" style="x"><char style="xo" closed="false">78:23 </char><char style="xt" closed="false"><ref loc="GEN 7:11">Jen 7:11</ref></char></note> louvri pòt syèl yo.<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>Li te fè lamàn vin tonbe tankou lapli sou yo,</para>
  <para style="q1" vid="PSA 78:24">pou yo manje e te bay yo manje soti nan syèl la.<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>Lòm te manje manje a zanj yo.</para>
  <para style="q1" vid="PSA 78:25">Li te voye manje ba yo an abondans.<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>Li te <note caller="+" style="x"><char style="xo" closed="false">78:26 </char><char style="xt" closed="false"><ref loc="NUM 11:31">Nonb 11:31</ref></char></note> fè van lès la vante nan syèl yo e avèk pwisans Li,</para>
  <para style="q1" vid="PSA 78:26">Li te dirije van sid la.<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>Li te fè tonbe vyann sou yo tankou lapli, tankou pousyè,</para>
  <para style="q1" vid="PSA 78:27">menm <note caller="+" style="x"><char style="xo" closed="false">78:27 </char><char style="xt" closed="false"><ref loc="EXO 16:13">Egz 16:13</ref></char></note> zwazo ak zèl tankou sab lanmè.<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>Alò, Li te kite yo tonbe nan mitan kan an, toupatou abitasyon yo.<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>Konsa, yo te <note caller="+" style="x"><char style="xo" closed="false">78:29 </char><char style="xt" closed="false"><ref loc="NUM 11:19-20">Nonb 11:19-20</ref></char></note> manje vant plen,</para>
  <para style="q1" vid="PSA 78:29">e sa yo te mande, se sa Li te bay yo.<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>Avan, yo te satisfè dezi yo,</para>
  <para style="q1" vid="PSA 78:30">
    <note caller="+" style="x">
      <char style="xo" closed="false">78:30 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 11:33">Nonb 11:33</ref>
      </char>
    </note> pandan manje a te toujou nan bouch yo,<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">78:31 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 11:33-34">Nonb 11:33-34</ref>
      </char>
    </note> kòlè Bondye te leve kont yo e</para>
  <para style="q1" vid="PSA 78:31">te touye kèk nan pi vayan pami yo.</para>
  <para style="q1" vid="PSA 78:31">Li te frape desann mesye pi chwazi Israël yo.<verse eid="PSA 78:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>Malgre tout sa, yo te peche toujou,</para>
  <para style="q1" vid="PSA 78:32">e pa t kwè nan zèv mèvèy Li yo.<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>Akoz sa, Li te fè <note caller="+" style="x"><char style="xo" closed="false">78:33 </char><char style="xt" closed="false"><ref loc="NUM 14:29-35">Nonb 14:29-35</ref></char></note> jou yo fini mal,</para>
  <para style="q1" vid="PSA 78:33">e ane yo nan laperèz sibit.<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>Lè Li te touye yo, nan lè sa a, yo te <note caller="+" style="x"><char style="xo" closed="false">78:34 </char><char style="xt" closed="false"><ref loc="NUM 21:7">Nonb 21:7</ref></char></note> chache Li.</para>
  <para style="q1" vid="PSA 78:34">Yo te retounen chache Li ak dilijans.<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>Konsa, yo te sonje ke Bondye te wòch yo, e Pi Wo a, <note caller="+" style="x"><char style="xo" closed="false">78:35 </char><char style="xt" closed="false"><ref loc="EXO 15:13">Egz 15:13</ref> </char></note>redanmtè yo.<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>Men yo te <note caller="+" style="x"><char style="xo" closed="false">78:36 </char><char style="xt" closed="false"><ref loc="EXO 24:7-8">Egz 24:7-8</ref></char></note> twonpe Li ak bouch yo.</para>
  <para style="q1" vid="PSA 78:36">Yo te manti a Li ak lang yo.<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>Paske kè yo pa t <note caller="+" style="x"><char style="xo" closed="false">78:37 </char><char style="xt" closed="false"><ref loc="PSA 51:10">Sòm 51:10</ref></char></note> fèm vè Li menm,</para>
  <para style="q1" vid="PSA 78:37">ni yo pa t fidèl selon akò Li.<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>Men Li menm, akoz mizerikòd Li,</para>
  <para style="q1" vid="PSA 78:38">te padone inikite yo, e pa t detwi yo.</para>
  <para style="q1" vid="PSA 78:38">Wi, souvan Li te ralanti kòlè Li e pa t kite tout kòlè li vin leve.<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>Konsa, Li te sonje ke se sèl chè yo te ye,</para>
  <para style="q1" vid="PSA 78:39">yon <note caller="+" style="x"><char style="xo" closed="false">78:39 </char><char style="xt" closed="false"><ref loc="JOB 7:7-16">Job 7:7-16</ref> </char></note>van pase ki pa retounen ankò.<verse eid="PSA 78:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>Konbyen fwa yo te fè rebèl kont Li nan dezè a,</para>
  <para style="q1" vid="PSA 78:40">e te <note caller="+" style="x"><char style="xo" closed="false">78:40 </char><char style="xt" closed="false"><ref loc="PSA 95:10">Sòm 95:10</ref></char></note>fè L soufri lapèn la nan savann an!<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>Anpil fwa, yo te pase Bondye a <note caller="+" style="x"><char style="xo" closed="false">78:41 </char><char style="xt" closed="false"><ref loc="NUM 14:22">Nonb 14:22</ref></char></note> leprèv,</para>
  <para style="q1" vid="PSA 78:41">epi te fè Sila Ki Sen A Israël la soufri doulè.<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>Yo <note caller="+" style="x"><char style="xo" closed="false">78:42 </char><char style="xt" closed="false"><ref loc="JDG 8:34">Jij 8:34</ref></char></note> pa t sonje pwisans Li,</para>
  <para style="q1" vid="PSA 78:42">ni jou ke Li te delivre yo nan men advèsè yo,<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>lè Li te akonpli mirak Li yo an Égypte</para>
  <para style="q1" vid="PSA 78:43">ak <note caller="+" style="x"><char style="xo" closed="false">78:43 </char><char style="xt" closed="false"><ref loc="EXO 4:21">Egz 4:21</ref></char></note>mèvèy Li yo nan chan Tsoan an.<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>Li te chanje rivyè yo an san.</para>
  <para style="q1" vid="PSA 78:44">Konsa, nan sous yo, yo pa t kab bwè.<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>Li te voye pami yo mouch</para>
  <para style="q1" vid="PSA 78:45">an gran kantite ki te devore yo,</para>
  <para style="q1" vid="PSA 78:45">avèk <note caller="+" style="x"><char style="xo" closed="false">78:45 </char><char style="xt" closed="false"><ref loc="EXO 8:6">Egz 8:6</ref></char></note>krapo ki te detwi yo.<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>Li te bay chan rekòlt a chwalbwa a,</para>
  <para style="q1" vid="PSA 78:46">ak pwodwi travay yo a <note caller="+" style="x"><char style="xo" closed="false">78:46 </char><char style="xt" closed="false"><ref loc="EXO 10:14">Egz 10:14</ref></char></note> krikèt la.<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>Li te detwi chan fwi yo ak <note caller="+" style="x"><char style="xo" closed="false">78:47 </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">Egz 9:23-25</ref></char></note> lagrèl e bwa sikomò yo ak fredi.<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>Li te bay <note caller="+" style="x"><char style="xo" closed="false">78:48 </char><char style="xt" closed="false"><ref loc="EXO 9:19">Egz 9:19</ref></char></note> bèt yo tou a lagrèl e twoupo yo a loray.<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>Li te <note caller="+" style="x"><char style="xo" closed="false">78:49 </char><char style="xt" closed="false"><ref loc="EXO 15:7">Egz 15:7</ref></char></note> voye sou yo chalè kòlè Li,</para>
  <para style="q1" vid="PSA 78:49">gwo kòlè avèk endiyasyon ak twoub,</para>
  <para style="q1" vid="PSA 78:49">ak yon bann zanj ki pou detwi yo.<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>Li te fè yon chemen pou lakòlè Li.</para>
  <para style="q1" vid="PSA 78:50">Li pa t epagne nanm yo de lanmò,</para>
  <para style="q1" vid="PSA 78:50">men te <note caller="+" style="x"><char style="xo" closed="false">78:50 </char><char style="xt" closed="false"><ref loc="EXO 12:29-30">Egz 12:29-30</ref></char></note> bay lavi yo a gwo fleyo.<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>Li te frape di tout premye ne an Égypte yo,</para>
  <para style="q1" vid="PSA 78:51">premye sòti a fòs kouraj yo nan tant a Cham yo.<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>Men Li te mennen fè sòti pwòp pèp li a tankou mouton.</para>
  <para style="q1" vid="PSA 78:52">Li te dirije yo nan dezè a <note caller="+" style="x"><char style="xo" closed="false">78:52 </char><char style="xt" closed="false"><ref loc="PSA 77:20">Sòm 77:20</ref> </char></note>tankou yon twoupo.<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>Li te dirije yo avèk swen pou yo pa pè, men <note caller="+" style="x"><char style="xo" closed="false">78:53 </char><char style="xt" closed="false"><ref loc="EXO 14:27-28">Egz 14:27-28</ref> </char></note>lanmè te vale lènmi yo.<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">78:54 </char><char style="xt" closed="false"><ref loc="EXO 15:7">Egz 15:7</ref></char></note> Li te mennen yo nan peyi sen Li an,</para>
  <para style="q1" vid="PSA 78:54">vè peyi ti kolin ke men dwat Li te vin posede a.<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>Anplis, li te chase nasyon yo devan yo,</para>
  <para style="q1" vid="PSA 78:55">te pataje pou yo yon eritaj selon mezi li, e</para>
  <para style="q1" vid="PSA 78:55">te fè tribi Israël yo abite nan tant yo.<verse eid="PSA 78:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>Sepandan, yo te tante e <note caller="+" style="x"><char style="xo" closed="false">78:56 </char><char style="xt" closed="false"><ref loc="JDG 2:11-13">Jij 2:11-13</ref></char></note> fè rebèl kont Bondye Pi Wo a,</para>
  <para style="q1" vid="PSA 78:56">e pa t kenbe temwayaj Li yo,<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>men te vire fè bak e te aji nan malveyans tankou papa zansèt yo.</para>
  <para style="q1" vid="PSA 78:57">Yo te vire akote tankou yon banza ki tòde.<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>Paske yo te pwovoke Li avèk <note caller="+" style="x"><char style="xo" closed="false">78:58 </char><char style="xt" closed="false"><ref loc="LEV 26:30">Lev 26:30</ref></char></note> wo plas yo,</para>
  <para style="q1" vid="PSA 78:58">e te fè L jalou avèk imaj taye yo.<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>Lè Bondye te tande, Li te vin ranpli avèk kòlè,</para>
  <para style="q1" vid="PSA 78:59">e te <note caller="+" style="x"><char style="xo" closed="false">78:59 </char><char style="xt" closed="false"><ref loc="LEV 26:30">Lev 26:30</ref></char></note>vin deteste Israël anpil.<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>Jiskaske Li te abandone abitasyon</para>
  <para style="q1" vid="PSA 78:60">Silo, tant ke li te konn monte pami lòm nan,<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>e te bay yo menm ki te fòs Li, an kaptivite,</para>
  <para style="q1" vid="PSA 78:61">glwa Li nan men advèsè a.<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>Anplis, Li te livre pèp Li a de nepe e</para>
  <para style="q1" vid="PSA 78:62">te vin ranpli avèk kòlè kont eritaj Li a.<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>Dife te devore jennonm Li yo e</para>
  <para style="q1" vid="PSA 78:63">
    <note caller="+" style="x">
      <char style="xo" closed="false">78:63 </char>
      <char style="xt" closed="false">
        <ref loc="JER 7:34">Jr 7:34</ref>
      </char>
    </note>vyèj Li yo pa t gen chan maryaj.<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">78:64 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 4:17">I Sam 4:17</ref>
      </char>
    </note> Prèt Li yo te tonbe pa nepe e</para>
  <para style="q1" vid="PSA 78:64">Vèv Li yo pa t kab kriye.<verse eid="PSA 78:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>Konsa, SENYÈ a te leve tankou se nan dòmi Li te ye,</para>
  <para style="q1" vid="PSA 78:65">tankou yon <note caller="+" style="x"><char style="xo" closed="false">78:65 </char><char style="xt" closed="false"><ref loc="ISA 42:13">És 42:13</ref></char></note> gèrye ki rele fò akoz diven.<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>Li <note caller="+" style="x"><char style="xo" closed="false">78:66 </char><char style="xt" closed="false"><ref loc="1SA 5:6">I Sam 5:6</ref></char></note> te pouse advèsè Li yo fè bak.</para>
  <para style="q1" vid="PSA 78:66">Li te mete sou yo yon repwòch ki pa t ap fini menm.<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>Anplis, Li te <note caller="+" style="x"><char style="xo" closed="false">78:67 </char><char style="xt" closed="false"><ref loc="PSA 78:60">Sòm 78:60</ref></char></note> rejte tant Jospeh la,</para>
  <para style="q1" vid="PSA 78:67">ni pa t chwazi tribi Éphraïm nan.<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>Men Li te chwazi tribi Juda a,</para>
  <para style="q1" vid="PSA 78:68">Mòn <note caller="+" style="x"><char style="xo" closed="false">78:68 </char><char style="xt" closed="false"><ref loc="PSA 87:2">Sòm 87:2</ref></char></note> Sion ke Li te renmen anpil la.<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>Li te <note caller="+" style="x"><char style="xo" closed="false">78:69 </char><char style="xt" closed="false"><ref loc="1KI 6:1-38">I Wa 6:1-38</ref></char></note> bati sanktiyè Li tankou wotè mòn yo,</para>
  <para style="q1" vid="PSA 78:69">tankou latè ke Li te etabli jis pou tout tan an.<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>Anplis, Li te chwazi David, sèvitè Li a.</para>
  <para style="q1" vid="PSA 78:70">Li te pran l sòti nan Pak mouton yo,<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>sòti nan okipe mouton k ap fè pitit, avèk ti mouton nouris,</para>
  <para style="q1" vid="PSA 78:71">Li te mennen li, pou vin bèje Jacob, pèp Li a,</para>
  <para style="q1" vid="PSA 78:71">avèk <note caller="+" style="x"><char style="xo" closed="false">78:71 </char><char style="xt" closed="false"><ref loc="1SA 10:1">I Sam 10:1</ref></char></note>Israël, eritaj Li a.<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>Konsa, Li te fè bèje yo selon <note caller="+" style="x"><char style="xo" closed="false">78:72 </char><char style="xt" closed="false"><ref loc="1KI 9:4">I Wa 9:4</ref></char></note> entegrite kè l,</para>
  <para style="q1" vid="PSA 78:72">e te gide yo avèk men abil li.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="d">Yon Sòm Asaph</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>O Bondye, nasyon yo te anvayi eritaj Ou a.</para>
  <para style="q1" vid="PSA 79:1">Yo te souye sen tanp Ou an.</para>
  <para style="q1" vid="PSA 79:1">Yo te fè Jérusalem kouche nan yon pil ranblè.<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>Yo te bay kadav sèvitè Ou yo kon manje pou zwazo syèl yo.</para>
  <para style="q1" vid="PSA 79:2">Chè a fidèl Ou yo, yo fin bay a bèt latè yo.<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>Yo te vide san yo tankou dlo toupatou Jérusalem.</para>
  <para style="q1" vid="PSA 79:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">79:3 </char>
      <char style="xt" closed="false">
        <ref loc="JER 14:16">Jr 14:16</ref>
      </char>
    </note> Pa t genyen moun ki pou antere yo.<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>Nou gen tan vin yon repwòch pou vwazen nou yo,</para>
  <para style="q1" vid="PSA 79:4">Yon rizib ak yon betiz pou sila ki antoure nou yo.<verse eid="PSA 79:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>Jiskilè, O SENYÈ?</para>
  <para style="q1" vid="PSA 79:5">Èske Ou va rete fache nèt?</para>
  <para style="q1" vid="PSA 79:5">Èske jalouzi Ou va <note caller="+" style="x"><char style="xo" closed="false">79:5 </char><char style="xt" closed="false"><ref loc="PSA 89:46">Sòm 89:46</ref> </char></note>brile tankou dife tout tan?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">79:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:24">Sòm 69:24</ref>
      </char>
    </note> Vide kòlè Ou sou nasyon ki pa rekonèt Ou yo,</para>
  <para style="q1" vid="PSA 79:6">ak sou wayòm yo ki pa rele non Ou yo.<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>Paske yo te <note caller="+" style="x"><char style="xo" closed="false">79:7 </char><char style="xt" closed="false"><ref loc="PSA 53:4">Sòm 53:4</ref></char></note> devore Jacob.</para>
  <para style="q1" vid="PSA 79:7">Yo te devaste abitasyon Li an.<verse eid="PSA 79:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">79:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:6">Sòm 106:6</ref>
      </char>
    </note> Pa sonje inikite a papa zansèt nou yo pou kenbe kont nou.</para>
  <para style="q1" vid="PSA 79:8">Kite mizerikòd Ou vini vit rankontre nou,</para>
  <para style="q1" vid="PSA 79:8">paske nou fin rive ba nèt.<verse eid="PSA 79:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">79:9 </char>
      <char style="xt" closed="false">
        <ref loc="2CH 14:11">II Kwo 14:11</ref>
      </char>
    </note> Fè nou sekou, O Bondye sali nou an, pou glwa a non Ou.</para>
  <para style="q1" vid="PSA 79:9">Delivre nou e padone peche nou yo, pou koz a non Ou.<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">79:10 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:10">Sòm 42:10</ref>
      </char>
    </note> Poukisa nasyon yo ta di: “Kote Bondye yo ye?”</para>
  <para style="q1" vid="PSA 79:10">Kite li vin rekonèt pami nasyon yo devan zye nou,</para>
  <para style="q1" vid="PSA 79:10">ke vanjans pou san sèvitè Ou yo ap vèse.<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>Kite <note caller="+" style="x"><char style="xo" closed="false">79:11 </char><char style="xt" closed="false"><ref loc="PSA 102:20">Sòm 102:20</ref></char></note> vwa prizonyè k ap plenyen yo rive devan Ou.</para>
  <para style="q1" vid="PSA 79:11">Selon grandè fòs Ou, prezève sila ki kondane a lamò.<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>Fè remet a vwazen nou yo, <note caller="+" style="x"><char style="xo" closed="false">79:12 </char><char style="xt" closed="false"><ref loc="GEN 4:15">Jen 4:15</ref></char></note> sèt fwa</para>
  <para style="q1" vid="PSA 79:12">antre nan vant yo, repwòch avèk sila</para>
  <para style="q1" vid="PSA 79:12">yo te repwoche Ou a, O SENYÈ.<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>Konsa nou menm, pèp Ou a,</para>
  <para style="q1" vid="PSA 79:13">ak <note caller="+" style="x"><char style="xo" closed="false">79:13 </char><char style="xt" closed="false"><ref loc="PSA 74:1">Sòm 74:1</ref></char></note> mouton a patiraj Ou a,</para>
  <para style="q1" vid="PSA 79:13">Va bay Ou remèsiman jis pou tout tan.</para>
  <para style="q1" vid="PSA 79:13">A tout jenerasyon yo, nou va pale lwanj Ou.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="d">Pou direktè koral la; pou jwe a “Lis Akò Yo”. Yon Sòm Asaph</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>O prete zòrèy Ou, Bèje Israël la,</para>
  <para style="q1" vid="PSA 80:1">Ou menm ki mennen Joseph tankou yon twoupo,</para>
  <para style="q1" vid="PSA 80:1">Ou menm ki <note caller="+" style="x"><char style="xo" closed="false">80:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Egz 25:22</ref></char></note> chita sou twòn anwo cheriben yo, se pou ou briye.<verse eid="PSA 80:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2"/>Devan Éphraïm avèk Benjamin ak Manassé, fè vire tout fòs Ou.</para>
  <para style="q1" vid="PSA 80:2">Vin bannou sekou!<verse eid="PSA 80:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>O Bondye, restore nou!</para>
  <para style="q1" vid="PSA 80:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">80:3 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 6:25">Nonb 6:25</ref>
      </char>
    </note>Fè vizaj Ou briye sou nou</para>
  <para style="q1" vid="PSA 80:3">e nou va sove.<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>O Bondye dèzame yo,</para>
  <para style="q1" vid="PSA 80:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">80:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 79:5">Sòm 79:5</ref>
      </char>
    </note> pou konbyen de tan Ou va fache kont lapriyè a pèp Ou a?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>Ou te bay yo <note caller="+" style="x"><char style="xo" closed="false">80:5 </char><char style="xt" closed="false"><ref loc="PSA 42:3">Sòm 42:3</ref></char></note> pen fèt ak dlo ki t ap sòti nan zye yo.</para>
  <para style="q1" vid="PSA 80:5">Ou te fè yo bwè dlo a zye yo an gran kantite.<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>Ou fè nou vin yon objè konfli devan <note caller="+" style="x"><char style="xo" closed="false">80:6 </char><char style="xt" closed="false"><ref loc="PSA 44:13">Sòm 44:13</ref></char></note> vwazen nou yo.</para>
  <para style="q1" vid="PSA 80:6">Lènmi nou yo ri pami yo menm.<verse eid="PSA 80:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>O Bondye dèzame yo, restore nou!</para>
  <para style="q1" vid="PSA 80:7">Fè vizaj Ou klere sou nou e nou va sove.<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>Ou te rachte yon pye rezen soti an Égypte.</para>
  <para style="q1" vid="PSA 80:8">Ou te chase mete nasyon yo deyò pou te <note caller="+" style="x"><char style="xo" closed="false">80:8 </char><char style="xt" closed="false"><ref loc="JER 11:17">Jr 11:17</ref></char></note>plante li la.<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>Ou te netwaye tè a devan l.</para>
  <para style="q1" vid="PSA 80:9">Li te <note caller="+" style="x"><char style="xo" closed="false">80:9 </char><char style="xt" closed="false"><ref loc="HOS 14:5">Os 14:5</ref></char></note>anrasine byen fon e te ranpli peyi a.<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>Mòn yo te kouvri ak lonbraj li.</para>
  <para style="q1" vid="PSA 80:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">80:10 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 49:22">Jen 49:22</ref>
      </char>
    </note> Branch li yo te kon bwa sèd Bondye yo.<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>Li te voye branch li yo rive <note caller="+" style="x"><char style="xo" closed="false">80:11 </char><char style="xt" closed="false"><ref loc="PSA 72:8">Sòm 72:8</ref></char></note> jis nan lanmè,</para>
  <para style="q1" vid="PSA 80:11">ak boujon li yo jis nan Rivyè a.<verse eid="PSA 80:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>Poukisa Ou te <note caller="+" style="x"><char style="xo" closed="false">80:12 </char><char style="xt" closed="false"><ref loc="PSA 89:40">Sòm 89:40</ref></char></note> kraze tout kloti li yo,</para>
  <para style="q1" vid="PSA 80:12">pou tout sila ki pase la yo kab rekòlte fwi li yo?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>Yon gwo mal kochon sovaj sòti nan forè pou manje ladann</para>
  <para style="q1" vid="PSA 80:13">e bèt sovaj chan an manje sou li.<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>O Bondye dèzame yo, vire fè bak depi koulye a,</para>
  <para style="q1" vid="PSA 80:14">nou sipliye Ou, souple.</para>
  <para style="q1" vid="PSA 80:14">
    <note caller="+" style="x">
      <char style="xo" closed="false">80:14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:19">Sòm 102:19</ref>
      </char>
    </note>Gade soti anwo nan syèl la pou wè,</para>
  <para style="q1" vid="PSA 80:14">e okipe pye rezen sila a.<verse eid="PSA 80:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15"/>Menm boujon ke men dwat Ou te plante a,</para>
  <para style="q1" vid="PSA 80:15">e branch ke Ou te bay fòs pou Ou menm nan.<verse eid="PSA 80:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>Li fin brile ak dife.</para>
  <para style="q1" vid="PSA 80:16">Li fin koupe atè nèt.</para>
  <para style="q1" vid="PSA 80:16">Yo peri ak repwòch devan Ou.<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>Kite <note caller="+" style="x"><char style="xo" closed="false">80:17 </char><char style="xt" closed="false"><ref loc="PSA 89:21">Sòm 89:21</ref></char></note> men Ou rete sou nonm nan</para>
  <para style="q1" vid="PSA 80:17">ki se moun men dwat Ou a,</para>
  <para style="q1" vid="PSA 80:17">sou fis a lòm ke ou te fè pwisan pou Ou menm nan.<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>Konsa, nou p ap vire fè bak kite Ou.</para>
  <para style="q1" vid="PSA 80:18">Fè nou leve ankò e nou va rele non Ou.<verse eid="PSA 80:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>O SENYÈ dezame yo, restore nou.</para>
  <para style="q1" vid="PSA 80:19">Fè figi Ou briye sou nou e nou va sove.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="d">Pou direktè koral la; pou jwe sou Gitia la. Yon Sòm Asaph</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>Chante avèk jwa a Bondye ki se fòs nou!</para>
  <para style="q1" vid="PSA 81:1">Rele fò ak jwa a <note caller="+" style="x"><char style="xo" closed="false">81:1 </char><char style="xt" closed="false"><ref loc="PSA 84:8">Sòm 84:8</ref></char></note>Bondye a Jacob la!<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>Leve yon chan, bat <note caller="+" style="x"><char style="xo" closed="false">81:2 </char><char style="xt" closed="false"><ref loc="EXO 15:20">Egz 15:20</ref></char></note> tanbouren an,</para>
  <para style="q1" vid="PSA 81:2">gita ak son ki dous la ansanm avèk ap la.<verse eid="PSA 81:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>Sone twonpèt la nan nouvèl lin nan,</para>
  <para style="q1" vid="PSA 81:3">sou plèn lin nan, nan jou <note caller="+" style="x"><char style="xo" closed="false">81:3 </char><char style="xt" closed="false"><ref loc="LEV 23:24">Lev 23:24</ref></char></note>fèt nou an.<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>Paske se yon règleman Israël,</para>
  <para style="q1" vid="PSA 81:4">yon òdonans a Bondye Jacob la.<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>Li te etabli li kon yon temwayaj nan Joseph</para>
  <para style="q1" vid="PSA 81:5">lè li te <note caller="+" style="x"><char style="xo" closed="false">81:5 </char><char style="xt" closed="false"><ref loc="EXO 11:4">Egz 11:4</ref></char></note> ale toupatou nan peyi Égypte la.</para>
  <para style="q1" vid="PSA 81:5">Mwen te tande yon lang ke M pa t konnen.<verse eid="PSA 81:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>Mwen te retire fado a sou zepòl li.</para>
  <para style="q1" vid="PSA 81:6">Men li yo te vin lib panyen an.<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>Ou te <note caller="+" style="x"><char style="xo" closed="false">81:7 </char><char style="xt" closed="false"><ref loc="EXO 2:23">Egz 2:23</ref></char></note> rele nan twoub la e Mwen</para>
  <para style="q1" vid="PSA 81:7">te fè ou sekou.</para>
  <para style="q1" vid="PSA 81:7">Mwen te reponn Ou nan plas kote tonnè a kache a.</para>
  <para style="q1" vid="PSA 81:7">Mwen te fè ou pase eprèv nan dlo Meriba yo. <char style="qs">Tan</char><verse eid="PSA 81:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>Tande, O pèp Mwen an e Mwen va korije nou.</para>
  <para style="q1" vid="PSA 81:8">O Israël, si ou <note caller="+" style="x"><char style="xo" closed="false">81:8 </char><char style="xt" closed="false"><ref loc="PSA 95:7">Sòm 95:7</ref></char></note> ta koute Mwen!<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>Pa kite okenn dye etranje rete pami nou.</para>
  <para style="q1" vid="PSA 81:9">Ni nou pa pou adore okenn dye etranje.<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">81:10 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:2">Egz 20:2</ref>
      </char>
    </note> Mwen menm, SENYÈ a, se Bondye nou an,</para>
  <para style="q1" vid="PSA 81:10">ki te mennen nou sòti nan peyi Égypte la.</para>
  <para style="q1" vid="PSA 81:10">Ouvri bouch nou byen laj e mwen va ranpli li.<verse eid="PSA 81:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>Men pèp Mwen an <note caller="+" style="x"><char style="xo" closed="false">81:11 </char><char style="xt" closed="false"><ref loc="DEU 32:15">Det 32:15</ref></char></note> pa t koute vwa M.</para>
  <para style="q1" vid="PSA 81:11">Ni Israël pa t obeyi Mwen.<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>Akoz sa, Mwen te <note caller="+" style="x"><char style="xo" closed="false">81:12 </char><char style="xt" closed="false"><ref loc="JOB 8:4">Job 8:4</ref></char></note> lage yo a kè di yo,</para>
  <para style="q1" vid="PSA 81:12">pou mache nan pwòp manèv yo.<verse eid="PSA 81:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>O ke pèp Mwen an ta koute Mwen,</para>
  <para style="q1" vid="PSA 81:13">ke Israël ta <note caller="+" style="x"><char style="xo" closed="false">81:13 </char><char style="xt" closed="false"><ref loc="PSA 128:1">Sòm 128:1</ref></char></note> mache nan vwa Mwen yo!<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>Mwen ta <note caller="+" style="x"><char style="xo" closed="false">81:14 </char><char style="xt" closed="false"><ref loc="PSA 18:47">Sòm 18:47</ref></char></note> soumèt lènmi yo byen vit</para>
  <para style="q1" vid="PSA 81:14">e ta vire men m kont advèsè yo.<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">81:15 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:30">Wo 1:30</ref>
      </char>
    </note> Sila ki rayi SENYÈ yo ta tresayi devan Li menm</para>
  <para style="q1" vid="PSA 81:15">e pinisyon yo ta pou tout tan.<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>Men ou menm, Mwen ta nouri ou avèk <note caller="+" style="x"><char style="xo" closed="false">81:16 </char><char style="xt" closed="false"><ref loc="DEU 32:14">Det 32:14</ref></char></note> pi bon kalite ble a.</para>
  <para style="q1" vid="PSA 81:16">Avèk siwo ki sòti nan wòch, Mwen ta satisfè ou.<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="d">Yon Sòm Asaph</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>Bondye vin kanpe nan mitan pwòp asanble Li a.</para>
  <para style="q1" vid="PSA 82:1">Li fè jijman nan mitan <note caller="+" style="x"><char style="xo" closed="false">82:1 </char><char style="xt" closed="false"><ref loc="EXO 21:6">Egz 21:6</ref></char></note>dye yo.<verse eid="PSA 82:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>Pou konbyen de tan nou va jije san jistis,</para>
  <para style="q1" vid="PSA 82:2">e <note caller="+" style="x"><char style="xo" closed="false">82:2 </char><char style="xt" closed="false"><ref loc="DEU 1:17">Det 1:17</ref></char></note>montre favè a mechan yo?<verse eid="PSA 82:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>“Fè defans fèb yo ak òfelen yo.</para>
  <para style="q1" vid="PSA 82:3">Fè jistis a aflije ak malere yo.<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">82:4 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 29:12">Job 29:12</ref>
      </char>
    </note> Sove fèb yo ak malere yo.</para>
  <para style="q1" vid="PSA 82:4">Delivre fè yo sòti nan men a mechan yo.”<verse eid="PSA 82:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>Yo pa konnen ni yo pa konprann.</para>
  <para style="q1" vid="PSA 82:5">Yo <note caller="+" style="x"><char style="xo" closed="false">82:5 </char><char style="xt" closed="false"><ref loc="PRO 2:13">Pwov 2:13</ref></char></note>mache toupatou nan fènwa.</para>
  <para style="q1" vid="PSA 82:5">Tout fondasyon tè yo fin souke nèt.<verse eid="PSA 82:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">82:6 </char><char style="xt" closed="false"><ref loc="PSA 82:1">Sòm 82:1</ref></char></note> te di: “Se dye ke nou ye,</para>
  <para style="q1" vid="PSA 82:6">e nou tout se fis a Pi Wo a.<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>Sepandan, <note caller="+" style="x"><char style="xo" closed="false">82:7 </char><char style="xt" closed="false"><ref loc="JOB 21:32">Job 21:32</ref></char></note> nou va mouri tankou moun,</para>
  <para style="q1" vid="PSA 82:7">e tonbe tankou nenpòt nan prens yo.”<verse eid="PSA 82:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>Leve, O Bondye, jije tè a!</para>
  <para style="q1" vid="PSA 82:8">Paske se Ou ki <note caller="+" style="x"><char style="xo" closed="false">82:8 </char><char style="xt" closed="false"><ref loc="PSA 2:8">Sòm 2:8</ref></char></note>posede tout nasyon yo.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="d">Yon Chan. Yon Sòm Asaph</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>O Bondye, <note caller="+" style="x"><char style="xo" closed="false">83:1 </char><char style="xt" closed="false"><ref loc="PSA 28:1">Sòm 28:1</ref></char></note> pa rete an silans.</para>
  <para style="q1" vid="PSA 83:1">Pa fè silans, O Bondye.</para>
  <para style="q1" vid="PSA 83:1">Pa rete trankil.<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>Paske gade byen, lènmi Ou yo ap fè zen.</para>
  <para style="q1" vid="PSA 83:2">Sila ki rayi Ou yo leve tèt yo byen wo.<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>Yo fè plan malen kont pèp Ou a.</para>
  <para style="q1" vid="PSA 83:3">Yo fè konplo ansanm kont sila ki se trezò Ou.<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>Yo te di: “Vini, <note caller="+" style="x"><char style="xo" closed="false">83:4 </char><char style="xt" closed="false"><ref loc="EST 3:6">Est 3:6</ref></char></note> annou disparèt yo nèt kon nasyon,</para>
  <para style="q1" vid="PSA 83:4">pou non Israël la pa sonje ankò menm.”<verse eid="PSA 83:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>Paske yo te <note caller="+" style="x"><char style="xo" closed="false">83:5 </char><char style="xt" closed="false"><ref loc="PSA 2:2">Sòm 2:2</ref></char></note> fè konplo ansanm ak yon sèl panse.</para>
  <para style="q1" vid="PSA 83:5">Kont Ou menm, yo fè yon akò.<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>Tant a Édom avèk Izmayelit yo, Moab ak Agarenyen yo,<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>Guebal, Ammon, Amalek, Filisten yo avèk pèp Tyr yo;<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>Anplis, Asiryen yo te vin jwenn ansanm avèk yo,</para>
  <para style="q1" vid="PSA 83:8">yo te prete lamen a <note caller="+" style="x"><char style="xo" closed="false">83:8 </char><char style="xt" closed="false"><ref loc="DEU 2:9">Det 2:9</ref></char></note> pitit a Lot yo. <char style="qs">Tan</char><verse eid="PSA 83:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>Aji avèk yo <note caller="+" style="x"><char style="xo" closed="false">83:9 </char><char style="xt" closed="false"><ref loc="JDG 7:1-24">Jij 7:1-24</ref></char></note> tankou Madian,</para>
  <para style="q1" vid="PSA 83:9">tankou avèk Sisera ak Jabin nan ravin Kison an!<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>Ki te fin detwi nan En-Dor,</para>
  <para style="q1" vid="PSA 83:10">ki te <note caller="+" style="x"><char style="xo" closed="false">83:10 </char><char style="xt" closed="false"><ref loc="ZEP 1:17">So 1:17</ref></char></note> vin tankou fimye sou latè.<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>Fè tout chèf yo tankou Oreb avèk Zeeb</para>
  <para style="q1" vid="PSA 83:11">e tout prens yo tankou <note caller="+" style="x"><char style="xo" closed="false">83:11 </char><char style="xt" closed="false"><ref loc="JDG 8:12-21">Jij 8:12-21</ref> </char></note>Zébach avèk Tsalmunna,<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>Ki te di: <note caller="+" style="x"><char style="xo" closed="false">83:12 </char><char style="xt" closed="false"><ref loc="2CH 20:11">II Kwo 20:11</ref></char></note> “Annou vin posede patiraj Bondye yo pou kont nou.”<verse eid="PSA 83:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>O Bondye mwen, fè yo tankou pousyè toubiyon!</para>
  <para style="q1" vid="PSA 83:13">Tankou pay devan van!<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>Tankou <note caller="+" style="x"><char style="xo" closed="false">83:14 </char><char style="xt" closed="false"><ref loc="ISA 9:18">És 9:18</ref></char></note> dife ki brile forè a, ak flanm ki</para>
  <para style="q1" vid="PSA 83:14">limen nan tout mòn nan pou yo brile nèt.<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>Konsa, kouri dèyè yo <note caller="+" style="x"><char style="xo" closed="false">83:15 </char><char style="xt" closed="false"><ref loc="JOB 9:17">Job 9:17</ref></char></note> avèk tanpèt Ou</para>
  <para style="q1" vid="PSA 83:15">e teworize yo ak gwo siklòn Ou.<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">83:16 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 10:15">Job 10:15</ref>
      </char>
    </note> Plen figi yo ak gwo wont,</para>
  <para style="q1" vid="PSA 83:16">pou yo kab chache non pa Ou, O SENYÈ.<verse eid="PSA 83:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>Kite yo vin <note caller="+" style="x"><char style="xo" closed="false">83:17 </char><char style="xt" closed="false"><ref loc="PSA 35:4">Sòm 35:4</ref></char></note> wont e dekouraje jis pou tout tan.</para>
  <para style="q1" vid="PSA 83:17">Wi, kite yo imilye e peri,<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>pou yo kapab konnen ke se Ou menm sèl</para>
  <para style="q1" vid="PSA 83:18">ki pote non “Bondye”, <note caller="+" style="x"><char style="xo" closed="false">83:18 </char><char style="xt" closed="false"><ref loc="PSA 9:2">Sòm 9:2</ref> </char></note>Pi Wo sou tout tè a.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="d">Pou direktè koral la; sou gitia la. Yon Sòm a fis a Koré yo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>A la abitasyon Ou yo bèl, O SENYÈ dèzame yo!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">84:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:1-2">Sòm 42:1-2</ref>
      </char>
    </note> Nanm mwen anvi e menm gen gwo dezi pou lakou SENYÈ a.</para>
  <para style="q1" vid="PSA 84:2">Kè m ak chè m chante avèk jwa a Bondye vivan an.<verse eid="PSA 84:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>Zwazo a osi te twouve yon kay, e</para>
  <para style="q1" vid="PSA 84:3">iwondèl la yon nich pou li menm,</para>
  <para style="q1" vid="PSA 84:3">kote li kapab swaye pitit li yo pre lòtel Ou yo,</para>
  <para style="q1" vid="PSA 84:3">Oh Wa m ak Bondye m.<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>A la <note caller="+" style="x"><char style="xo" closed="false">84:4 </char><char style="xt" closed="false"><ref loc="PSA 65:4">Sòm 65:4</ref></char></note> beni sila ki demere nan lakay Ou yo beni!</para>
  <para style="q1" vid="PSA 84:4">Y ap ba Ou lwanj jis pou tout tan.<verse eid="PSA 84:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>A la beni nonm ki <note caller="+" style="x"><char style="xo" closed="false">84:5 </char><char style="xt" closed="false"><ref loc="PSA 81:1">Sòm 81:1</ref></char></note> gen fòs li nan Ou,</para>
  <para style="q1" vid="PSA 84:5">Nan kè a sila lide fè wout nan gran chemen vè Sion an ye.<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>Lè yo pase nan vale Baca a, yo fè l fè yon sous;</para>
  <para style="q1" vid="PSA 84:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">84:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:35">Sòm 107:35</ref>
      </char>
    </note> Premye lapli a kouvri li avèk benediksyon.<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>Yo sòti nan fòs pou antre nan fòs yo.</para>
  <para style="q1" vid="PSA 84:7">Yo chak parèt devan Bondye nan Sion.<verse eid="PSA 84:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>O SENYÈ dèzame yo, tande lapriyè mwen.</para>
  <para style="q1" vid="PSA 84:8">Prete zorèy Ou, O <note caller="+" style="x"><char style="xo" closed="false">84:8 </char><char style="xt" closed="false"><ref loc="PSA 81:1">Sòm 81:1</ref></char></note> Bondye Jacob la! <char style="qs">Tan</char><verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>Gade byen boukliye nou an.</para>
  <para style="q1" vid="PSA 84:9">Gade sou vizaj <note caller="+" style="x"><char style="xo" closed="false">84:9 </char><char style="xt" closed="false"><ref loc="1SA 16:6">I Sam 16:6</ref></char></note> onksyone Ou a.<verse eid="PSA 84:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>Paske <note caller="+" style="x"><char style="xo" closed="false">84:10 </char><char style="xt" closed="false"><ref loc="PSA 27:4">Sòm 27:4</ref></char></note> yon sèl jou nan lakou Ou a,</para>
  <para style="q1" vid="PSA 84:10">pi bon pase mil jou deyò.</para>
  <para style="q1" vid="PSA 84:10">Pito m te geran pòt lakay Bondye mwen an,</para>
  <para style="q1" vid="PSA 84:10">pase pou m ta abite nan tant a mechan yo.<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>Paske SENYÈ a, Bondye a, se <note caller="+" style="x"><char style="xo" closed="false">84:11 </char><char style="xt" closed="false"><ref loc="ISA 60:19-20">És 60:19-20</ref></char></note> yon solèy ak yon boukliye.</para>
  <para style="q1" vid="PSA 84:11">SENYÈ a va bay gras avèk glwa.</para>
  <para style="q1" vid="PSA 84:11">Li pa refize anyen ki bon a sila ki mache dwat yo.<verse eid="PSA 84:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>O SENYÈ dèzame yo!</para>
  <para style="q1" vid="PSA 84:12">A la moun ki mete konfyans li nan Ou a beni!<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="d">Pou direktè koral la; Yon Sòm a fis a Koré yo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>O SENYÈ, Ou te montre favè Ou a peyi Ou a.</para>
  <para style="q1" vid="PSA 85:1">Ou te <note caller="+" style="x"><char style="xo" closed="false">85:1 </char><char style="xt" closed="false"><ref loc="EXO 1:11">Egz 1:11</ref></char></note> restore kaptivite a Jacob la.<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>Ou te <note caller="+" style="x"><char style="xo" closed="false">85:2 </char><char style="xt" closed="false"><ref loc="NUM 14:19">Nonb 14:19</ref></char></note> padone inikite a pèp Ou a.</para>
  <para style="q1" vid="PSA 85:2">Ou te kouvri tout peche yo.<verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>Ou te retire tout gran kòlè Ou.</para>
  <para style="q1" vid="PSA 85:3">Ou te <note caller="+" style="x"><char style="xo" closed="false">85:3 </char><char style="xt" closed="false"><ref loc="EXO 32:12">Egz 32:12</ref></char></note> detounen kòlè Ou ki brile a.<verse eid="PSA 85:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>Restore nou, O Bondye a sali nou an,</para>
  <para style="q1" vid="PSA 85:4">e <note caller="+" style="x"><char style="xo" closed="false">85:4 </char><char style="xt" closed="false"><ref loc="DAN 9:16">Dan 9:16</ref> </char></note>fè endiyasyon Ou anvè nou, sispann.<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>Èske <note caller="+" style="x"><char style="xo" closed="false">85:5 </char><char style="xt" closed="false"><ref loc="PSA 74:1">Sòm 74:1</ref></char></note> Ou va fache avèk nou jis pou tout tan?</para>
  <para style="q1" vid="PSA 85:5">Èske Ou va pwolonje kòlè Ou jis a tout jenerasyon yo?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>Èske se pa Ou menm ki pou fè nou <note caller="+" style="x"><char style="xo" closed="false">85:6 </char><char style="xt" closed="false"><ref loc="PSA 71:20">Sòm 71:20</ref></char></note> reprann ankò?</para>
  <para style="q1" vid="PSA 85:6">Pou pèp Ou a kapab rejwi nan Ou?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>Montre nou lanmou dous Ou a, O SENYÈ.</para>
  <para style="q1" vid="PSA 85:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">85:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:4">Sòm 106:4</ref>
      </char>
    </note> Pèmèt nou resevwa sali Ou a.<verse eid="PSA 85:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>Mwen va tande sa ke Bondye, SENYÈ a, va di.</para>
  <para style="q1" vid="PSA 85:8">Paske La p <note caller="+" style="x"><char style="xo" closed="false">85:8 </char><char style="xt" closed="false"><ref loc="PSA 29:11">Sòm 29:11</ref></char></note> pale lapè a pèp Li a, a fidèl Li yo,</para>
  <para style="q1" vid="PSA 85:8">men pa kite yo retounen nan foli yo.<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>Anverite, sekou Li toupre a sila ki gen lakrent Li yo,</para>
  <para style="q1" vid="PSA 85:9">pou laglwa Li kapab rete nan peyi nou an.<verse eid="PSA 85:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>Lanmou dous avèk verite te vin jwenn ansanm.</para>
  <para style="q1" vid="PSA 85:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">85:10 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:3">Sòm 72:3</ref>
      </char>
    </note>Ladwati avèk lapè te vin bo youn lòt.<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>Verite <note caller="+" style="x"><char style="xo" closed="false">85:11 </char><char style="xt" closed="false"><ref loc="ISA 45:8">És 45:8</ref></char></note> vòltije sòti nan latè, e</para>
  <para style="q1" vid="PSA 85:11">Ladwati veye depi anwo nan syèl la.<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>Anverite, SENYÈ a va bay sa ki bon,</para>
  <para style="q1" vid="PSA 85:12">e <note caller="+" style="x"><char style="xo" closed="false">85:12 </char><char style="xt" closed="false"><ref loc="LEV 26:4">Lev 26:4</ref></char></note> peyi nou an va bay rekòlt li.<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>Ladwati va mache devan L.</para>
  <para style="q1" vid="PSA 85:13">L ap prepare yon gran chemen pou mak pla pye Li yo.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="d">Yon priyè a David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>Prete m zòrèy Ou, O SENYÈ e reponn mwen.</para>
  <para style="q1" vid="PSA 86:1">Paske mwen <note caller="+" style="x"><char style="xo" closed="false">86:1 </char><char style="xt" closed="false"><ref loc="PSA 40:17">Sòm 40:17</ref></char></note> aflije e malere.<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">86:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:20">Sòm 25:20</ref>
      </char>
    </note> Konsève nanm mwen, paske mwen se yon nonm fidèl.</para>
  <para style="q1" vid="PSA 86:2">Ou menm, Bondye mwen an,</para>
  <para style="q1" vid="PSA 86:2">sove sèvitè Ou ki mete konfyans nan Ou a.<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>Montre m gras Ou, O SENYÈ, paske</para>
  <para style="q1" vid="PSA 86:3">se <note caller="+" style="x"><char style="xo" closed="false">86:3 </char><char style="xt" closed="false"><ref loc="PSA 25:5">Sòm 25:5</ref></char></note> a Ou menm mwen kriye tout lajounen.<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>Fè nanm a sèvitè Ou a kontan,</para>
  <para style="q1" vid="PSA 86:4">paske a Ou menm, SENYÈ, mwen leve nanm mwen.<verse eid="PSA 86:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>Paske Ou menm, Senyè a,</para>
  <para style="q1" vid="PSA 86:5">Ou plen bonte e Ou <note caller="+" style="x"><char style="xo" closed="false">86:5 </char><char style="xt" closed="false"><ref loc="PSA 130:4">Sòm 130:4</ref></char></note>prèt pou padone,</para>
  <para style="q1" vid="PSA 86:5">ranpli avèk lanmou dous, pou tout sila</para>
  <para style="q1" vid="PSA 86:5">ki rele sou non Ou yo.<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">86:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 55:1">Sòm 55:1</ref>
      </char>
    </note> Prete zòrèy Ou, O SENYÈ, a lapriyè mwen.</para>
  <para style="q1" vid="PSA 86:6">Prete atansyon a vwa siplikasyon mwen yo.<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>Nan jou twoub mwen an, mwen va rele Ou,</para>
  <para style="q1" vid="PSA 86:7">paske <note caller="+" style="x"><char style="xo" closed="false">86:7 </char><char style="xt" closed="false"><ref loc="PSA 17:6">Sòm 17:6</ref></char></note> Ou va reponn mwen.<verse eid="PSA 86:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>Nanpwen tankou Ou pami dye yo, O Senyè,</para>
  <para style="q1" vid="PSA 86:8">ni nanpwen zèv <note caller="+" style="x"><char style="xo" closed="false">86:8 </char><char style="xt" closed="false"><ref loc="DEU 3:24">Det 3:24</ref></char></note> tankou pa Ou yo.<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">86:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:27">Sòm 22:27</ref>
      </char>
    </note> Tout nasyon ke Ou te fè yo, va vini pou</para>
  <para style="q1" vid="PSA 86:9">adore devan Ou, O Senyè,</para>
  <para style="q1" vid="PSA 86:9">e yo va bay non Ou glwa.<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>Paske Ou gran e <note caller="+" style="x"><char style="xo" closed="false">86:10 </char><char style="xt" closed="false"><ref loc="EXO 15:11">Egz 15:11</ref></char></note>fè zèv ki mèvèye.</para>
  <para style="q1" vid="PSA 86:10">Se Ou sèl ki Bondye.<verse eid="PSA 86:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>Montre m chemen Ou an, O SENYÈ.</para>
  <para style="q1" vid="PSA 86:11">Mwen va mache nan verite Ou.</para>
  <para style="q1" vid="PSA 86:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">86:11 </char>
      <char style="xt" closed="false">
        <ref loc="JER 32:39">Jr 32:39</ref>
      </char>
    </note>Fè kè m dispoze pou krent non Ou.<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">86:12 </char><char style="xt" closed="false"><ref loc="PSA 111:1">Sòm 111:1</ref></char></note> ba Ou remèsiman,</para>
  <para style="q1" vid="PSA 86:12">O SENYÈ, Bondye mwen an, avèk tout kè m.</para>
  <para style="q1" vid="PSA 86:12">Mwen va bay glwa a non Ou jis pou tout tan.<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>Paske lanmou dous Ou anvè mwen gran,</para>
  <para style="q1" vid="PSA 86:13">e Ou te <note caller="+" style="x"><char style="xo" closed="false">86:13 </char><char style="xt" closed="false"><ref loc="PSA 30:3">Sòm 30:3</ref></char></note> delivre nanm mwen soti nan fon sejou lanmò yo.<verse eid="PSA 86:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>O Bondye, mesye awogan yo te <note caller="+" style="x"><char style="xo" closed="false">86:14 </char><char style="xt" closed="false"><ref loc="PSA 54:3">Sòm 54:3</ref></char></note> leve kont mwen,</para>
  <para style="q1" vid="PSA 86:14">yon bann mesye vyolan ap chache lavi mwen.</para>
  <para style="q1" vid="PSA 86:14">Yo pa mete Ou devan yo.<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>Men Ou menm, O SENYÈ,</para>
  <para style="q1" vid="PSA 86:15">Ou se yon Bondye ki <note caller="+" style="x"><char style="xo" closed="false">86:15 </char><char style="xt" closed="false"><ref loc="PSA 86:5">Sòm 86:5</ref></char></note> plen ak gras avèk mizerikòd,</para>
  <para style="q1" vid="PSA 86:15">lan nan kòlè e plen avèk lanmou dous ak verite.<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>Vire vè mwen e fè m gras.</para>
  <para style="q1" vid="PSA 86:16">O <note caller="+" style="x"><char style="xo" closed="false">86:16 </char><char style="xt" closed="false"><ref loc="PSA 68:35">Sòm 68:35</ref></char></note> dispoze fòs Ou a sèvitè Ou a,</para>
  <para style="q1" vid="PSA 86:16">e fè sekou a fis a sèvant Ou a.<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>Montre m yon sign bonte Ou,</para>
  <para style="q1" vid="PSA 86:17">pou sila ki rayi mwen yo kapab wè l e vin wont.</para>
  <para style="q1" vid="PSA 86:17">Paske Ou menm, O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">86:17 </char><char style="xt" closed="false"><ref loc="PSA 78:69">Sòm 78:69</ref></char></note> te fè m sekou, e te konsole mwen.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="d">Yon Sòm a fis a Koré yo; Yon Chan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">87:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:69">Sòm 78:69</ref>
      </char>
    </note> Fondasyon Li nan mòn sen yo.<verse eid="PSA 87:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">87:2 </char><char style="xt" closed="false"><ref loc="PSA 78:67-68">Sòm 78:67-68</ref></char></note> renmen pòtay Sion yo</para>
  <para style="q1" vid="PSA 87:2">plis pase tout lòt abitasyon a Jacob yo.<verse eid="PSA 87:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>Yo pale sou gran mèvèy ou,</para>
  <para style="q1" vid="PSA 87:3">O <note caller="+" style="x"><char style="xo" closed="false">87:3 </char><char style="xt" closed="false"><ref loc="PSA 46:4">Sòm 46:4</ref></char></note> gran vil Bondye. <char style="qs">Tan</char><verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>Mwen va mete <note caller="+" style="x"><char style="xo" closed="false">87:4 </char><char style="xt" closed="false"><ref loc="JOB 9:13">Job 9:13</ref></char></note> Rahab avèk Babylone</para>
  <para style="q1" vid="PSA 87:4">pami sila ki rekonèt Mwen yo.</para>
  <para style="q1" vid="PSA 87:4">Men vwala, Philistie, Tyr, avèk Éthiopie:</para>
  <para style="q1" vid="PSA 87:4">“Tèl moun te fèt la”.<verse eid="PSA 87:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>Men selon Sion, li va pale,</para>
  <para style="q1" vid="PSA 87:5">“Sa a ak sila a fèt ladann.”</para>
  <para style="q1" vid="PSA 87:5">Pi Wo a, Li menm, va <note caller="+" style="x"><char style="xo" closed="false">87:5 </char><char style="xt" closed="false"><ref loc="PSA 48:8">Sòm 48:8</ref></char></note> etabli Sion.<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>SENYÈ a va konte lè Li <note caller="+" style="x"><char style="xo" closed="false">87:6 </char><char style="xt" closed="false"><ref loc="PSA 69:28">Sòm 69:28</ref></char></note> anrejistre</para>
  <para style="q1" vid="PSA 87:6">tout pèp yo: “Sa a te fèt la”. <char style="qs">Tan</char><verse eid="PSA 87:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>Epi sila ki chante ansanm avèk sila ki jwe flit yo va di:</para>
  <para style="q1" vid="PSA 87:7">“Tout <note caller="+" style="x"><char style="xo" closed="false">87:7 </char><char style="xt" closed="false"><ref loc="PSA 36:9">Sòm 36:9</ref></char></note> sous bwote yo, se nan ou”.<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="d">Yon Chan. Yon Sòm a fis Koré yo</para>
  <para style="d">Pou direktè Koral la; selon melodi “Soufrans Afliksyon An”.</para>
  <para style="d">Yon refleksyon pa Héman, Ezrachit la</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>O SENYÈ, Bondye sali mwen an,</para>
  <para style="q1" vid="PSA 88:1">Mwen te kriye fò lajounen kon lannwit devan Ou.<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>Kite priyè mwen <note caller="+" style="x"><char style="xo" closed="false">88:2 </char><char style="xt" closed="false"><ref loc="PSA 18:6">Sòm 18:6</ref></char></note> vini devan Ou.</para>
  <para style="q1" vid="PSA 88:2">Panche zòrèy Ou vè kri mwen an!<verse eid="PSA 88:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>Paske nanm mwen gen kont twoub li.</para>
  <para style="q1" vid="PSA 88:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">88:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:18">Sòm 107:18</ref>
      </char>
    </note>Lavi m vin toupre sejou lanmò a.<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>Mwen vin konte pami sila ki <note caller="+" style="x"><char style="xo" closed="false">88:4 </char><char style="xt" closed="false"><ref loc="PSA 28:1">Sòm 28:1</ref></char></note> desann nan fòs yo.</para>
  <para style="q1" vid="PSA 88:4">Mwen parèt tankou yon nonm san fòs,<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>abandone pami mò yo, tankou sila</para>
  <para style="q1" vid="PSA 88:5">ki te touye e kouche nan tonm lan.</para>
  <para style="q1" vid="PSA 88:5">Sila a nou pa sonje ankò menm,</para>
  <para style="q1" vid="PSA 88:5">ki <note caller="+" style="x"><char style="xo" closed="false">88:5 </char><char style="xt" closed="false"><ref loc="PSA 31:22">Sòm 31:22</ref></char></note> koupe retire nan men Ou.<verse eid="PSA 88:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>Ou te mete m nan <note caller="+" style="x"><char style="xo" closed="false">88:6 </char><char style="xt" closed="false"><ref loc="PSA 86:13">Sòm 86:13</ref></char></note> fòs pi ba a, nan plas fènwa yo, nan fon yo.<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>Kòlè Ou <note caller="+" style="x"><char style="xo" closed="false">88:7 </char><char style="xt" closed="false"><ref loc="PSA 32:4">Sòm 32:4</ref></char></note> vin poze sou mwen.</para>
  <para style="q1" vid="PSA 88:7">Ou te aflije m ak tout vag lanmè Ou yo. <char style="qs">Tan</char><verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>Ou te retire tout moun mwen konnen byen lwen m.</para>
  <para style="q1" vid="PSA 88:8">Ou te fè m yon objè abominab devan yo.</para>
  <para style="q1" vid="PSA 88:8">Mwen fèmen anndan nèt e mwen pa kab sòti.<verse eid="PSA 88:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9"/>Zye m gen tan pouri akoz afliksyon.</para>
  <para style="q1" vid="PSA 88:9">Mwen te rele Ou chak jou, O SENYÈ.</para>
  <para style="q1" vid="PSA 88:9">Mwen te lonje men m yo vè Ou menm.<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>Èske Ou va fè mirak pou mò yo?</para>
  <para style="q1" vid="PSA 88:10">Èske <note caller="+" style="x"><char style="xo" closed="false">88:10 </char><char style="xt" closed="false"><ref loc="PSA 6:5">Sòm 6:5</ref></char></note> lespri ki fin pati yo va leve pou bay Ou lwanj? <char style="qs">Tan</char><verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>Èske lanmò dous Ou a va deklare nan tonbo a?</para>
  <para style="q1" vid="PSA 88:11">Fidelite Ou nan labim nan?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>Èske mirak Ou yo va fèt parèt nan <note caller="+" style="x"><char style="xo" closed="false">88:12 </char><char style="xt" closed="false"><ref loc="JOB 10:21">Job 10:21</ref></char></note> tenèb la?</para>
  <para style="q1" vid="PSA 88:12">Oswa ladwati Ou nan peyi kote tout bagay bliye yo?<verse eid="PSA 88:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>Men anvè Ou, O SENYÈ, mwen te kriye.</para>
  <para style="q1" vid="PSA 88:13">Nan maten, lapriyè mwen vini devan Ou.<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>O SENYÈ, poukisa Ou rejte nanm mwen?</para>
  <para style="q1" vid="PSA 88:14">Poukisa Ou <note caller="+" style="x"><char style="xo" closed="false">88:14 </char><char style="xt" closed="false"><ref loc="JOB 13:24">Job 13:24</ref></char></note>kache figi Ou kont mwen?<verse eid="PSA 88:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>Mwen te aflije e <note caller="+" style="x"><char style="xo" closed="false">88:15 </char><char style="xt" closed="false"><ref loc="PRO 24:11">Pwov 24:11</ref></char></note> prèt pou mouri depi nan jenès mwen.</para>
  <para style="q1" vid="PSA 88:15">Pandan mwen soufri gwo laperèz Ou yo, mwen distrè nèt.<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>Kòlè Ou ki brile, fin pase sou mwen.</para>
  <para style="q1" vid="PSA 88:16">Gwo laperèz Ou yo te <note caller="+" style="x"><char style="xo" closed="false">88:16 </char><char style="xt" closed="false"><ref loc="LAM 3:54">Lam 3:54</ref></char></note>koupe retire m.<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>Yo fin antoure mwen tankou dlo tout lajounen.</para>
  <para style="q1" vid="PSA 88:17">Yo <note caller="+" style="x"><char style="xo" closed="false">88:17 </char><char style="xt" closed="false"><ref loc="PSA 17:11">Sòm 17:11</ref></char></note>ansèkle m nèt.<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>Ou te retire renmen mwen ak zanmi m nan lwen m nèt,</para>
  <para style="q1" vid="PSA 88:18">ak zanmi m yo, nan tenèb.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="d">Yon Refleksyon pa Éthan, Ezrachit la</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>Mwen va chante lanmou dous SENYÈ a jis pou tout tan.</para>
  <para style="q1" vid="PSA 89:1">Ak bouch mwen, mwen va fè tout jenerasyon yo konnen fidelite Ou.<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>Paske mwen te di: “Lanmou dous Ou a</para>
  <para style="q1" vid="PSA 89:2">va kanpe janm jis pou tout tan.</para>
  <para style="q1" vid="PSA 89:2">Ou te etabli syèl yo.</para>
  <para style="q1" vid="PSA 89:2">Fidelite Ou rete nan yo.<verse eid="PSA 89:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>“Mwen, Bondye, te fè yon akò avèk <note caller="+" style="x"><char style="xo" closed="false">89:3 </char><char style="xt" closed="false"><ref loc="1KI 8:16">I Wa 8:16</ref></char></note> moun apwente mwen a.</para>
  <para style="q1" vid="PSA 89:3">Mwen te sèmante pa David, sèvitè mwen an,<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘Mwen va etabli <note caller="+" style="x"><char style="xo" closed="false">89:4 </char><char style="xt" closed="false"><ref loc="2SA 7:16">II Sam 7:16</ref></char></note> jèm ou nèt</para>
  <para style="q1" vid="PSA 89:4">e bati twòn Ou pandan tout jenerasyon yo.’” <char style="qs">Tan</char><verse eid="PSA 89:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>Syèl yo va louwe mèvèy Ou yo, O SENYÈ,</para>
  <para style="q1" vid="PSA 89:5">ansanm ak fidelite Ou nan asanble <note caller="+" style="x"><char style="xo" closed="false">89:5 </char><char style="xt" closed="false"><ref loc="JOB 5:1">Job 5:1</ref></char></note>sen yo.<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>Paske kilès nan syèl la ki konpare ak SENYÈ a?</para>
  <para style="q1" vid="PSA 89:6">Kilès pami <note caller="+" style="x"><char style="xo" closed="false">89:6 </char><char style="xt" closed="false"><ref loc="PSA 29:1">Sòm 29:1</ref></char></note> fis a pwisan yo ki tankou SENYÈ a,<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>Yon Bondye ki resevwa lakrent anpil nan asanble a sen yo,</para>
  <para style="q1" vid="PSA 89:7">e <note caller="+" style="x"><char style="xo" closed="false">89:7 </char><char style="xt" closed="false"><ref loc="PSA 96:4">Sòm 96:4</ref></char></note>mèvèye plis pase tout sila ki antoure Li yo?<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>O SENYÈ Bondye dèzame yo, <note caller="+" style="x"><char style="xo" closed="false">89:8 </char><char style="xt" closed="false"><ref loc="PSA 35:10">Sòm 35:10</ref></char></note> se kilès ki</para>
  <para style="q1" vid="PSA 89:8">tankou Ou, O SENYÈ pwisan an?</para>
  <para style="q1" vid="PSA 89:8">Anplis, fidelite Ou antoure Ou.<verse eid="PSA 89:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>Ou domine ògèy lanmè a.</para>
  <para style="q1" vid="PSA 89:9">Lè vag li yo vin leve, Ou <note caller="+" style="x"><char style="xo" closed="false">89:9 </char><char style="xt" closed="false"><ref loc="PSA 65:7">Sòm 65:7</ref></char></note> kalme yo.<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>Ou menm, Ou te kraze <note caller="+" style="x"><char style="xo" closed="false">89:10 </char><char style="xt" closed="false"><ref loc="PSA 87:4">Sòm 87:4</ref></char></note> Rahab (Égypte)</para>
  <para style="q1" vid="PSA 89:10">tankou yon moun ki fin touye.</para>
  <para style="q1" vid="PSA 89:10">Ou te gaye lènmi Ou yo avèk men pwisan Ou.<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">89:11 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:1">Jen 1:1</ref>
      </char>
    </note> Syèl yo se pou Ou.</para>
  <para style="q1" vid="PSA 89:11">Tè a se pa Ou tou.</para>
  <para style="q1" vid="PSA 89:11">Lemond ak tout sa ki ladann,</para>
  <para style="q1" vid="PSA 89:11">se Ou menm ki te etabli yo.<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">89:12 </char>
      <char style="xt" closed="false">
        <ref loc="JOS 19:22">Jos 19:22</ref>
      </char>
    </note> Nò ak sid, se Ou menm ki te kreye yo.</para>
  <para style="q1" vid="PSA 89:12">Thabor avèk Hermon kriye avèk jwa a non Ou.<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>Ou gen yon men byen fò.</para>
  <para style="q1" vid="PSA 89:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">89:13 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 98:1">Sòm 98:1</ref>
      </char>
    </note> Men dwat Ou leve byen wo.<verse eid="PSA 89:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>Ladwati avèk jistis se fondasyon twòn Ou an.</para>
  <para style="q1" vid="PSA 89:14">
    <note caller="+" style="x">
      <char style="xo" closed="false">89:14 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 85:13">Sòm 85:13</ref>
      </char>
    </note>Lanmou dous avèk verite mache devan Ou.<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>A la beni, pèp ki konnen son lajwa a beni!</para>
  <para style="q1" vid="PSA 89:15">O SENYÈ, yo mache nan <note caller="+" style="x"><char style="xo" closed="false">89:15 </char><char style="xt" closed="false"><ref loc="PSA 4:6">Sòm 4:6</ref></char></note> limyè a vizaj Ou a.<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>Nan <note caller="+" style="x"><char style="xo" closed="false">89:16 </char><char style="xt" closed="false"><ref loc="PSA 105:3">Sòm 105:3</ref></char></note> non Ou, yo rejwi tout lajounen,</para>
  <para style="q1" vid="PSA 89:16">e pa ladwati Ou, yo vin egzalte.<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>Paske Ou se glwa a <note caller="+" style="x"><char style="xo" closed="false">89:17 </char><char style="xt" closed="false"><ref loc="PSA 28:8">Sòm 28:8</ref></char></note> fòs yo,</para>
  <para style="q1" vid="PSA 89:17">e pa favè Ou, kòn nou vin egzalte.<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>Paske boukliye nou apatyen a SENYÈ a,</para>
  <para style="q1" vid="PSA 89:18">e wa nou an se Sila Ki Sen An Israël la. <note caller="+" style="x"><char style="xo" closed="false">89:18 </char><char style="xt" closed="false"><ref loc="1KI 11:34">I Wa 11:34</ref></char></note><verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>Yon fwa, Ou te pale nan yon vizyon a fidèl Ou yo.</para>
  <para style="q1" vid="PSA 89:19">Ou te di: “Mwen te bay soutyen a yon moun ki pwisan.</para>
  <para style="q1" vid="PSA 89:19">Mwen te fè leve yon jenn nom ki te chwazi pami pèp la.<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">89:20 </char><char style="xt" closed="false"><ref loc="1SA 13:14">I Sam 13:14</ref></char></note> twouve David, sèvitè Mwen an.</para>
  <para style="q1" vid="PSA 89:20">Avèk lwil sen Mwen an, mwen te onksyone l.<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>Avèk li menm, <note caller="+" style="x"><char style="xo" closed="false">89:21 </char><char style="xt" closed="false"><ref loc="PSA 18:35">Sòm 18:35</ref></char></note> men M va vin etabli.</para>
  <para style="q1" vid="PSA 89:21">Anplis, bra M va ranfòse li.<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>Lènmi an p ap <note caller="+" style="x"><char style="xo" closed="false">89:22 </char><char style="xt" closed="false"><ref loc="2SA 7:10">II Sam 7:10</ref></char></note> twonpe li.</para>
  <para style="q1" vid="PSA 89:22">Ni fis a mechanste a p ap aflije li.<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>Men Mwen va <note caller="+" style="x"><char style="xo" closed="false">89:23 </char><char style="xt" closed="false"><ref loc="2SA 7:9">II Sam 7:9</ref></char></note> kraze advèsè li yo devan l,</para>
  <para style="q1" vid="PSA 89:23">e frape sila ki rayi li yo.<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>Fidelite Mwen avèk lanmou dous Mwen va avèk li.</para>
  <para style="q1" vid="PSA 89:24">Nan non Mwen, <note caller="+" style="x"><char style="xo" closed="false">89:24 </char><char style="xt" closed="false"><ref loc="PSA 132:7">Sòm 132:7</ref></char></note>kòn li va vin egzalte.<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>Mwen va osi mete men li <note caller="+" style="x"><char style="xo" closed="false">89:25 </char><char style="xt" closed="false"><ref loc="PSA 72:8">Sòm 72:8</ref></char></note> sou lanmè a,</para>
  <para style="q1" vid="PSA 89:25">ak men dwat li sou rivyè yo.<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>Li va kriye a Mwen: ‘Ou se papa m,</para>
  <para style="q1" vid="PSA 89:26">Bondy m <note caller="+" style="x"><char style="xo" closed="false">89:26 </char><char style="xt" closed="false"><ref loc="2SA 22:47">II Sam 22:47</ref></char></note>Wòch a sali mwen an.<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>Anplis, Mwen va fè li premye ne Mwen,</para>
  <para style="q1" vid="PSA 89:27">pi wo pami tout wa latè yo.’<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>Lanmou dous Mwen va kenbe pou li jis pou tout tan,</para>
  <para style="q1" vid="PSA 89:28">
    <note caller="+" style="x">
      <char style="xo" closed="false">89:28 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:3-34">Sòm 89:3-34</ref>
      </char>
    </note> e akò Mwen va konfime a li menm.<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>Konsa, Mwen va etabli <note caller="+" style="x"><char style="xo" closed="false">89:29 </char><char style="xt" closed="false"><ref loc="PSA 18:50">Sòm 18:50</ref></char></note> desandan li yo jis pou tout tan,</para>
  <para style="q1" vid="PSA 89:29">e twòn li tankou jou syèl yo.<verse eid="PSA 89:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>Si fis li yo <note caller="+" style="x"><char style="xo" closed="false">89:30 </char><char style="xt" closed="false"><ref loc="2SA 7:14">II Sam 7:14</ref></char></note> abandone lalwa Mwen an, e</para>
  <para style="q1" vid="PSA 89:30">pa mache nan jijman Mwen yo,<verse eid="PSA 89:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>si yo vyole règleman Mwen yo, e</para>
  <para style="q1" vid="PSA 89:31">pa kenbe kòmandman Mwen yo,<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>alò Mwen va pini transgresyon yo</para>
  <para style="q1" vid="PSA 89:32">avèk yon <note caller="+" style="x"><char style="xo" closed="false">89:32 </char><char style="xt" closed="false"><ref loc="JOB 9:34">Job 9:34</ref></char></note> baton,</para>
  <para style="q1" vid="PSA 89:32">e inikite yo avèk kout fwèt.<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>Men Mwen p ap retire <note caller="+" style="x"><char style="xo" closed="false">89:33 </char><char style="xt" closed="false"><ref loc="2SA 7:15">II Sam 7:15</ref></char></note> lanmou dous sou li,</para>
  <para style="q1" vid="PSA 89:33">ni aji avèk movèz fwa selon fidelite mwen.<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>Mwen p ap vyole <note caller="+" style="x"><char style="xo" closed="false">89:34 </char><char style="xt" closed="false"><ref loc="DEU 7:9">Det 7:9</ref></char></note> akò mwen an,</para>
  <para style="q1" vid="PSA 89:34">ni fè okenn chanjman nan pawòl ki te sòti nan lèv Mwen yo.<verse eid="PSA 89:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>Depi Mwen fin <note caller="+" style="x"><char style="xo" closed="false">89:35 </char><char style="xt" closed="false"><ref loc="PSA 60:6">Sòm 60:6</ref></char></note> sèmante selon sentete Mwen,</para>
  <para style="q1" vid="PSA 89:35">Mwen p ap manti a David.<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>Desandan li yo va dire jis pou tout tan,</para>
  <para style="q1" vid="PSA 89:36">e twòn li va <note caller="+" style="x"><char style="xo" closed="false">89:36 </char><char style="xt" closed="false"><ref loc="PSA 72:17">Sòm 72:17</ref> </char></note>tankou solèy la devan M.<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>Li va etabli jis pou tout tan tankou lalin nan,</para>
  <para style="q1" vid="PSA 89:37">
    <note caller="+" style="x">
      <char style="xo" closed="false">89:37 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 16:19">Job 16:19</ref>
      </char>
    </note>temwen nan syèl la ki toujou fidèl.”<verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>Men koulye a Ou vin <note caller="+" style="x"><char style="xo" closed="false">89:38 </char><char style="xt" closed="false"><ref loc="DEU 32:19">Det 32:19</ref></char></note>refize ak rejete,</para>
  <para style="q1" vid="PSA 89:38">Ou te plen ak kòlè kont onksyone Ou a.<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>Ou te <note caller="+" style="x"><char style="xo" closed="false">89:39 </char><char style="xt" closed="false"><ref loc="PSA 60:6">Sòm 60:6</ref></char></note> desann e rejte akò a sèvitè ou a.</para>
  <para style="q1" vid="PSA 89:39">Ou te pwofane kouwòn li an nan pousyè.<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>Ou te <note caller="+" style="x"><char style="xo" closed="false">89:40 </char><char style="xt" closed="false"><ref loc="PSA 80:12">Sòm 80:12</ref></char></note> kraze tout miray li yo.</para>
  <para style="q1" vid="PSA 89:40">Ou te fè sitadèl li yo kraze nèt.<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">89:41 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 80:12">Sòm 80:12</ref>
      </char>
    </note> Tout moun ki pase akote piyaje li.</para>
  <para style="q1" vid="PSA 89:41">Li devni yon objè abominab pami vwazen li yo.<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>Ou te egzalte men dwat a advèsè li yo.</para>
  <para style="q1" vid="PSA 89:42">Ou te <note caller="+" style="x"><char style="xo" closed="false">89:42 </char><char style="xt" closed="false"><ref loc="PSA 80:6">Sòm 80:6</ref> </char></note>fè lènmi li yo rejwi.<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>Anplis, ou te plwaye lam nepe li a, e</para>
  <para style="q1" vid="PSA 89:43">
    <note caller="+" style="x">
      <char style="xo" closed="false">89:43 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:10">Sòm 44:10</ref>
      </char>
    </note> fè l pa kanpe pou batay la.<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>Ou te fè <note caller="+" style="x"><char style="xo" closed="false">89:44 </char><char style="xt" closed="false"><ref loc="EZK 28:7">Éz 28:7</ref></char></note> mayifisans li vin kraze fini e</para>
  <para style="q1" vid="PSA 89:44">te jete twòn li jis atè.<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>Ou te fè jou a jenès li yo <note caller="+" style="x"><char style="xo" closed="false">89:45 </char><char style="xt" closed="false"><ref loc="PSA 102:23">Sòm 102:23</ref></char></note> vin kout.</para>
  <para style="q1" vid="PSA 89:45">Ou te kouvri li ak gwo wont.<verse eid="PSA 89:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>Jiskilè, O SENYÈ?</para>
  <para style="q1" vid="PSA 89:46">Èske Ou va kache figi Ou jis pou tout tan?</para>
  <para style="q1" vid="PSA 89:46">Èske <note caller="+" style="x"><char style="xo" closed="false">89:46 </char><char style="xt" closed="false"><ref loc="PSA 79:5">Sòm 79:5</ref></char></note>kòlè Ou va brile tankou dife pou tout tan?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">89:47 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 7:7">Job 7:7</ref>
      </char>
    </note> Sonje longè lavi mwen genyen</para>
  <para style="q1" vid="PSA 89:47">tèlman kout ke li tankou yon foli!</para>
  <para style="q1" vid="PSA 89:47">Se Ou ki te kreye tout fis a lòm yo!<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>Ki moun ki kab viv e pa <note caller="+" style="x"><char style="xo" closed="false">89:48 </char><char style="xt" closed="false"><ref loc="PSA 22:29">Sòm 22:29</ref></char></note> wè lanmò?</para>
  <para style="q1" vid="PSA 89:48">Èske li kab delivre nanm li de pouvwa</para>
  <para style="q1" vid="PSA 89:48">sejou lanmò a? <char style="qs">Tan</char><verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>Kote lanmou dous Ou te kon genyen, O SENYÈ?</para>
  <para style="q1" vid="PSA 89:49">Sa Ou te <note caller="+" style="x"><char style="xo" closed="false">89:49 </char><char style="xt" closed="false"><ref loc="2SA 7:15">II Sam 7:15</ref></char></note> sèmante a David nan fidelite Ou a?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>Sonje, O Senyè, <note caller="+" style="x"><char style="xo" closed="false">89:50 </char><char style="xt" closed="false"><ref loc="PSA 69:9">Sòm 69:9</ref></char></note> repwòch a sèvitè Ou yo,</para>
  <para style="q1" vid="PSA 89:50">jan mwen pote nan lestonmak mwen,</para>
  <para style="q1" vid="PSA 89:50">repwòch a tout nasyon pwisant yo,<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>Avèk sila, <note caller="+" style="x"><char style="xo" closed="false">89:51 </char><char style="xt" closed="false"><ref loc="PSA 74:10-22">Sòm 74:10-22</ref></char></note> lènmi Ou yo te fè repwòch yo, O SENYÈ.</para>
  <para style="q1" vid="PSA 89:51">Se konsa yo te repwoche mak pla pye onksyone Ou a.<verse eid="PSA 89:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">89:52 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 41:13">Sòm 41:13</ref>
      </char>
    </note> Beni se SENYÈ a pou tout tan!</para>
  <para style="q1" vid="PSA 89:52">Amen, e Amen.<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms1">LIV 4</para>
  <para style="d">Yon priyè Moïse; Moun Bondye a.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>Senyè, se te kote Ou, lakay nou te ye</para>
  <para style="q1" vid="PSA 90:1">pandan tout jenerasyon yo.<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>Avan mòn yo te vin parèt,</para>
  <para style="q1" vid="PSA 90:2">oswa Ou te bay nesans a mond lan avèk tè a,</para>
  <para style="q1" vid="PSA 90:2">menm <note caller="+" style="x"><char style="xo" closed="false">90:2 </char><char style="xt" closed="false"><ref loc="PSA 93:2">Sòm 93:2</ref></char></note>pou tout tan e pou tout tan, Ou se Bondye.<verse eid="PSA 90:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>Ou fè lòm retounen nan pousyè a, epi di:</para>
  <para style="q1" vid="PSA 90:3">“Retounen, O pitit a lòm yo.”<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>Paske mil ane devan zye Ou</para>
  <para style="q1" vid="PSA 90:4">se tankou ayè lè l fenk pase, oswa tankou yon veye lannwit lan.<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>Ou <note caller="+" style="x"><char style="xo" closed="false">90:5 </char><char style="xt" closed="false"><ref loc="JOB 22:16">Job 22:16</ref></char></note> bale yo ale pandan y ap dòmi.<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>Nan maten, yo vin tankou yon chan zèb nèf ki fènk leve.</para>
  <para style="q1" vid="PSA 90:6">Vè aswè, chan an febli e fennen nèt ale.<verse eid="PSA 90:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>Paske nou <note caller="+" style="x"><char style="xo" closed="false">90:7 </char><char style="xt" closed="false"><ref loc="PSA 39:11">Sòm 39:11</ref></char></note> fin manje nèt akoz kòlè Ou.</para>
  <para style="q1" vid="PSA 90:7">E akoz kòlè Ou, nou boulvèse nèt.<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>Ou te <note caller="+" style="x"><char style="xo" closed="false">90:8 </char><char style="xt" closed="false"><ref loc="PSA 50:21">Sòm 50:21</ref></char></note> mete inikite nou yo devan Ou.</para>
  <para style="q1" vid="PSA 90:8">Peche ki kache yo vin parèt nan limyè prezans Ou.<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>Paske <note caller="+" style="x"><char style="xo" closed="false">90:9 </char><char style="xt" closed="false"><ref loc="PSA 78:33">Sòm 78:33</ref></char></note> tout jou nou yo pase nan gran kòlè Ou.</para>
  <para style="q1" vid="PSA 90:9">Ane nou yo ap fini kon souf.<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>Pou jou lavi nou yo, yo gen swasann-dizan,</para>
  <para style="q1" vid="PSA 90:10">oswa akoz gwo fòs, katre-ventan.</para>
  <para style="q1" vid="PSA 90:10">Men ògèy a jou sa yo se sèlman kòve ak tristès.</para>
  <para style="q1" vid="PSA 90:10">Paske byen vit li prale, e nou <note caller="+" style="x"><char style="xo" closed="false">90:10 </char><char style="xt" closed="false"><ref loc="JOB 20:8">Job 20:8</ref> </char></note>vole ale.<verse eid="PSA 90:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>Se kilès ki konprann <note caller="+" style="x"><char style="xo" closed="false">90:11 </char><char style="xt" closed="false"><ref loc="PSA 76:7">Sòm 76:7</ref></char></note> fòs a kòlè Ou a?</para>
  <para style="q1" vid="PSA 90:11">Avèk gwo kòlè Ou, selon krent ke Ou merite a?<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>Pou sa, montre nou jan pou konte jou nou yo,</para>
  <para style="q1" vid="PSA 90:12">pou nou kab <note caller="+" style="x"><char style="xo" closed="false">90:12 </char><char style="xt" closed="false"><ref loc="PRO 2:1-6">Pwov 2:1-6</ref></char></note>ofri Ou yon kè ki plen sajès.<verse eid="PSA 90:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>Lache, O SENYÈ!</para>
  <para style="q1" vid="PSA 90:13">Konbyen tan sa va ye?</para>
  <para style="q1" vid="PSA 90:13">Pran sa akè pou kòz sèvitè ou yo!<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>O fè nou satisfè nan maten avèk lanmou dous Ou a,</para>
  <para style="q1" vid="PSA 90:14">pou nou kab chante ak jwa e fè kè kontan pandan tout jou nou yo.<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>Fè nou rejwi pou menm kantite jou ke Ou te aflije nou yo,</para>
  <para style="q1" vid="PSA 90:15">tout <note caller="+" style="x"><char style="xo" closed="false">90:15 </char><char style="xt" closed="false"><ref loc="DEU 2:14-16">Det 2:14-16</ref></char></note>ane ke nou te wè mal yo.<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>Kite zèv Ou yo vin parèt a sèvitè Ou yo,</para>
  <para style="q1" vid="PSA 90:16">ak<note caller="+" style="x"><char style="xo" closed="false">90:16 </char><char style="xt" closed="false"><ref loc="1KI 8:11">I Wa 8:11</ref></char></note>majeste Ou a pitit yo.<verse eid="PSA 90:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>Kite favè SENYÈ a, Bondye nou an, vini sou nou,</para>
  <para style="q1" vid="PSA 90:17">epi <note caller="+" style="x"><char style="xo" closed="false">90:17 </char><char style="xt" closed="false"><ref loc="PSA 37:23">Sòm 37:23</ref></char></note>konfime pou nou menm, zèv men nou yo.</para>
  <para style="q1" vid="PSA 90:17">Wi, konfime zèv men nou yo.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>Sila ki rete nan abri Pi Wo a va poze nan <note caller="+" style="x"><char style="xo" closed="false">91:1 </char><char style="xt" closed="false"><ref loc="PSA 17:8">Sòm 17:8</ref></char></note>lonbraj Toupwisan an.<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>Mwen va di a SENYÈ a:</para>
  <para style="q1" vid="PSA 91:2">“Se Li ki sitadèl mwen an, ak Bondye mwen an.</para>
  <para style="q1" vid="PSA 91:2">Se nan Li mwen mete <note caller="+" style="x"><char style="xo" closed="false">91:2 </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sòm 25:2</ref></char></note>konfyans!”<verse eid="PSA 91:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>Paske se Li menm ki delivre ou soti nan pèlen a chasè a,</para>
  <para style="q1" vid="PSA 91:3">ak <note caller="+" style="x"><char style="xo" closed="false">91:3 </char><char style="xt" closed="false"><ref loc="1KI 8:37">I Wa 8:37</ref></char></note> ravaj gwo maladi yo.<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>Li va <note caller="+" style="x"><char style="xo" closed="false">91:4 </char><char style="xt" closed="false"><ref loc="ISA 51:16">És 51:16</ref></char></note> kouvri ou ak plim Li yo.</para>
  <para style="q1" vid="PSA 91:4">Anba zèl Li, ou kapab chache pwotèj.</para>
  <para style="q1" vid="PSA 91:4">Fidelite Li se yon boukliye ak yon ranpa.<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>Ou p ap pè laperèz lannwit, ni <note caller="+" style="x"><char style="xo" closed="false">91:5 </char><char style="xt" closed="false"><ref loc="PSA 64:4">Sòm 64:4</ref></char></note>flèch k ap vole lajounen,<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>ni gwo maladi ki swiv nan fènwa,</para>
  <para style="q1" vid="PSA 91:6">ni destriksyon ki devaste a midi.<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>Yon milye kapab tonbe bò kote dwat ou,</para>
  <para style="q1" vid="PSA 91:7">ak di mil sou men agoch ou,</para>
  <para style="q1" vid="PSA 91:7">men <note caller="+" style="x"><char style="xo" closed="false">91:7 </char><char style="xt" closed="false"><ref loc="GEN 7:23">Jen 7:23</ref></char></note> sa p ap pwoche ou.<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>Ou va sèlman gade avèk zye ou pou</para>
  <para style="q1" vid="PSA 91:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">91:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:34">Sòm 37:34</ref>
      </char>
    </note> wè rekonpans a mechan yo.<verse eid="PSA 91:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>Paske ou te fè SENYÈ a, vin <note caller="+" style="x"><char style="xo" closed="false">91:9 </char><char style="xt" closed="false"><ref loc="PSA 91:2">Sòm 91:2</ref></char></note> sekou ou,</para>
  <para style="q1" vid="PSA 91:9">menm Pi Wo a, kote pou ou rete.<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">91:10 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:21">Pwov 12:21</ref>
      </char>
    </note> Nanpwen mal k ap rive ou,</para>
  <para style="q1" vid="PSA 91:10">Ni okenn toumant k ap pwoche tant ou.<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>Paske Li va bay <note caller="+" style="x"><char style="xo" closed="false">91:11 </char><char style="xt" closed="false"><ref loc="PSA 34:7">Sòm 34:7</ref></char></note> zanj Li yo lòd konsènan ou menm,</para>
  <para style="q1" vid="PSA 91:11">pou veye ou nan tout chemen ou yo.<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>Yo va <note caller="+" style="x"><char style="xo" closed="false">91:12 </char><char style="xt" closed="false"><ref loc="MAT 4:6">Mat 4:6</ref></char></note> leve ou byen wo nan men yo,</para>
  <para style="q1" vid="PSA 91:12">pou ou pa frape pye ou kont wòch.<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>Ou va <note caller="+" style="x"><char style="xo" closed="false">91:13 </char><char style="xt" closed="false"><ref loc="JDG 14:6">Jij 14:6</ref></char></note> pile sou lyon an ak koulèv la.</para>
  <para style="q1" vid="PSA 91:13">Jenn lyon an avèk sèpan an, ou va foule yo nèt.<verse eid="PSA 91:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>Paske li te renmen M konsa,</para>
  <para style="q1" vid="PSA 91:14">pou sa, Mwen va delivre li.</para>
  <para style="q1" vid="PSA 91:14">Mwen va <note caller="+" style="x"><char style="xo" closed="false">91:14 </char><char style="xt" closed="false"><ref loc="PSA 59:1">Sòm 59:1</ref> </char></note>mete li byen solid an wo,</para>
  <para style="q1" vid="PSA 91:14">akoz li te rekonèt non Mwen.<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>Li va <note caller="+" style="x"><char style="xo" closed="false">91:15 </char><char style="xt" closed="false"><ref loc="JOB 12:4">Job 12:4</ref></char></note> fè apèl non Mwen e Mwen va reponn li.</para>
  <para style="q1" vid="PSA 91:15">Mwen va avèk Li nan tan twoub la.</para>
  <para style="q1" vid="PSA 91:15">Mwen va delivre li e bay li lonè.<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>Mwen va satisfè li avèk yon lavi ki long,</para>
  <para style="q1" vid="PSA 91:16">e kite li wè sali mwen.<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="d">Yon Sòm. Yon chan pou jou Saba a</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>Li bon pou bay lwanj a SENYÈ a,</para>
  <para style="q1" vid="PSA 92:1">pou chante lwanj a non Ou, O Pi Wo a,<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>pou deklare lanmou dous Ou nan maten</para>
  <para style="q1" vid="PSA 92:2">avèk <note caller="+" style="x"><char style="xo" closed="false">92:2 </char><char style="xt" closed="false"><ref loc="PSA 89:1">Sòm 89:1</ref></char></note>fidelite Ou nan lannwit,<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>avèk <note caller="+" style="x"><char style="xo" closed="false">92:3 </char><char style="xt" closed="false"><ref loc="1SA 10:5">I Sam 10:5</ref></char></note> lenstriman a kòd e avèk ap,</para>
  <para style="q1" vid="PSA 92:3">avèk mizik ki retanti sou lir.<verse eid="PSA 92:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>Paske Ou menm, O SENYÈ, te fè m kontan avèk sa Ou te fè a.</para>
  <para style="q1" vid="PSA 92:4">Mwen va chante chan viktwa a akoz <note caller="+" style="x"><char style="xo" closed="false">92:4 </char><char style="xt" closed="false"><ref loc="PSA 8:6">Sòm 8:6</ref></char></note>zèv men Ou yo.<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>A la zèv Ou yo gran, O SENYÈ!</para>
  <para style="q1" vid="PSA 92:5">Panse Ou yo byen pwofon.<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>Yon <note caller="+" style="x"><char style="xo" closed="false">92:6 </char><char style="xt" closed="false"><ref loc="PSA 49:10">Sòm 49:10</ref></char></note> nonm ensanse pa gen konesans,</para>
  <para style="q1" vid="PSA 92:6">ni yon nonm bèt pa konprann sa:<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>Ke lè mechan yo te pouse tankou zèb la,</para>
  <para style="q1" vid="PSA 92:7">e tout sa ki fè inikite t ap byen reyisi yo,</para>
  <para style="q1" vid="PSA 92:7">se te pou yo ta kapab <note caller="+" style="x"><char style="xo" closed="false">92:7 </char><char style="xt" closed="false"><ref loc="PSA 37:38">Sòm 37:38</ref></char></note>detwi jis pou tout tan.<verse eid="PSA 92:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>Men Ou menm O SENYÈ, Ou <note caller="+" style="x"><char style="xo" closed="false">92:8 </char><char style="xt" closed="false"><ref loc="PSA 83:18">Sòm 83:18</ref></char></note> an wo jis pou tout tan.<verse eid="PSA 92:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>Paske gade byen, lènmi Ou yo, O SENYÈ,</para>
  <para style="q1" vid="PSA 92:9">paske gade byen, <note caller="+" style="x"><char style="xo" closed="false">92:9 </char><char style="xt" closed="false"><ref loc="PSA 37:20">Sòm 37:20</ref></char></note> lènmi Ou yo va peri.</para>
  <para style="q1" vid="PSA 92:9">Tout moun ki fè inikite yo va gaye nèt.<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>Men Ou te fè kòn mwen an leve wo tankou bèf mawon.</para>
  <para style="q1" vid="PSA 92:10">Mwen te onksyone avèk lwil nèf.<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>Epi zye mwen vin <note caller="+" style="x"><char style="xo" closed="false">92:11 </char><char style="xt" closed="false"><ref loc="PSA 54:7">Sòm 54:7</ref></char></note> gade avèk kè kontan</para>
  <para style="q1" vid="PSA 92:11">malfektè ki leve kont mwen yo.<verse eid="PSA 92:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>Moun dwat la va fleri tankou palmis.</para>
  <para style="q1" vid="PSA 92:12">Li va grandi tankou pye sèd nan Liban.<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>Plante lakay SENYÈ a, yo va fleri tankou palmis.</para>
  <para style="q1" vid="PSA 92:13">Yo va fleri nan lakou kay Bondye nou an.<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>Yo va <note caller="+" style="x"><char style="xo" closed="false">92:14 </char><char style="xt" closed="false"><ref loc="PRO 11:30">Pwov 11:30</ref></char></note> bay fwi toujou lè yo vin vye.</para>
  <para style="q1" vid="PSA 92:14">Yo va plen ak dlo bwa vèt.</para>
  <para style="q1" vid="PSA 92:14">Y ap rete vèt nèt.<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>Konsa, yo deklare ke SENYÈ a toujou dwat.</para>
  <para style="q1" vid="PSA 92:15">Li se wòch mwen,</para>
  <para style="q1" vid="PSA 92:15">e <note caller="+" style="x"><char style="xo" closed="false">92:15 </char><char style="xt" closed="false"><ref loc="ROM 9:14">Wo 9:14</ref></char></note> nanpwen anyen ki pa dwat nan Li.<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>SENYÈ a renye!</para>
  <para style="q1" vid="PSA 93:1">Li abiye an majeste!</para>
  <para style="q1" vid="PSA 93:1">SENYÈ a te abiye Li ak fòs.</para>
  <para style="q1" vid="PSA 93:1">Anverite, mond lan etabli byen solid.</para>
  <para style="q1" vid="PSA 93:1">Li pa ebranle menm.<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>Twòn Ou etabli depi tan ansyen an.</para>
  <para style="q1" vid="PSA 93:2">Ou la depi nan etènite.<verse eid="PSA 93:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>Flèv yo te leve, O SENYÈ,</para>
  <para style="q1" vid="PSA 93:3">Flèv yo te leve vwa yo, flèv yo te leve gwo vag frapan yo.<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>Plis pase bri a anpil dlo, pase gwo vag lanmè debòde,</para>
  <para style="q1" vid="PSA 93:4">SENYÈ anwo a pwisan.<verse eid="PSA 93:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">93:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:7">Sòm 19:7</ref>
      </char>
    </note> Regleman Ou yo kanpe nèt;</para>
  <para style="q1" vid="PSA 93:5">Sentete byen bèl lakay Ou a</para>
  <para style="q1" vid="PSA 93:5">O SENYÈ, jis pou tout tan.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>O SENYÈ, Bondye a <note caller="+" style="x"><char style="xo" closed="false">94:1 </char><char style="xt" closed="false"><ref loc="DEU 32:35">Det 32:35</ref></char></note> vanjans lan,</para>
  <para style="q1" vid="PSA 94:1">Bondye a vanjans lan, kite limyè vin parèt!<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>Vin leve, O <note caller="+" style="x"><char style="xo" closed="false">94:2 </char><char style="xt" closed="false"><ref loc="GEN 18:25">Jen 18:25</ref></char></note> Jij sou tè a.</para>
  <para style="q1" vid="PSA 94:2">Bay rekonpans a moun ògeye yo.<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>Pou konbyen de tan mechan yo, O SENYÈ,</para>
  <para style="q1" vid="PSA 94:3">pou konbyen de tan <note caller="+" style="x"><char style="xo" closed="false">94:3 </char><char style="xt" closed="false"><ref loc="JOB 20:5">Job 20:5</ref></char></note> mechan yo va leve tèt yo wo?<verse eid="PSA 94:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>Yo vide pawòl yo, yo pale avèk ògèy.</para>
  <para style="q1" vid="PSA 94:4">Tout moun ki fè mechanste yo <note caller="+" style="x"><char style="xo" closed="false">94:4 </char><char style="xt" closed="false"><ref loc="PSA 10:3">Sòm 10:3</ref></char></note> vante tèt yo.<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>Yo kraze pèp Ou a, O SENYÈ.</para>
  <para style="q1" vid="PSA 94:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">94:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 3:15">És 3:15</ref>
      </char>
    </note>Yo aflije eritaj Ou a.<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>Yo <note caller="+" style="x"><char style="xo" closed="false">94:6 </char><char style="xt" closed="false"><ref loc="ISA 10:2">És 10:2</ref></char></note> touye vèv yo avèk etranje a.</para>
  <para style="q1" vid="PSA 94:6">Yo asasine òfelen yo.<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">94:7 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 22:13">Job 22:13</ref>
      </char>
    </note> Yo fin di: “SENYÈ a pa wè, ni Bondye</para>
  <para style="q1" vid="PSA 94:7">Jacob la p ap okipe sa a.”<verse eid="PSA 94:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>Veye sa a, nou menm ki <note caller="+" style="x"><char style="xo" closed="false">94:8 </char><char style="xt" closed="false"><ref loc="PSA 92:6">Sòm 92:6</ref></char></note> ensansib pami pèp la;</para>
  <para style="q1" vid="PSA 94:8">Kilè n ap konprann, nou menm ki bèt?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">94:9 </char><char style="xt" closed="false"><ref loc="EXO 4:11">Egz 4:11</ref></char></note> plante zòrèy la, èske Li pa tande?</para>
  <para style="q1" vid="PSA 94:9">Sila ke te fòme zye a, èske Li pa wè.<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>Sila ki fè chatiman nasyon yo,</para>
  <para style="q1" vid="PSA 94:10">èske Li p ap fè repwòch?</para>
  <para style="q1" vid="PSA 94:10">Sila ki <note caller="+" style="x"><char style="xo" closed="false">94:10 </char><char style="xt" closed="false"><ref loc="JOB 35:11">Job 35:11</ref> </char></note>enstwi lòm; Li konnen!<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">94:11 </char><char style="xt" closed="false"><ref loc="JOB 11:11">Job 11:11</ref></char></note> konnen panse a lòm,</para>
  <para style="q1" vid="PSA 94:11">ke se sèlman yon souf ke yo ye.<verse eid="PSA 94:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>Beni se nonm ke Ou bay chatiman an,</para>
  <para style="q1" vid="PSA 94:12">O SENYÈ,</para>
  <para style="q1" vid="PSA 94:12">ke Ou <note caller="+" style="x"><char style="xo" closed="false">94:12 </char><char style="xt" closed="false"><ref loc="PSA 119:171">Sòm 119:171</ref></char></note> enstwi nan lalwa Ou a,<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>pou Ou kapab bay li sekou nan <note caller="+" style="x"><char style="xo" closed="false">94:13 </char><char style="xt" closed="false"><ref loc="PSA 49:5">Sòm 49:5</ref></char></note>jou advèsite yo,</para>
  <para style="q1" vid="PSA 94:13">jiskaske yon fòs fin fouye pou mechan yo.<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>Paske SENYÈ a p ap abandone pèp Li a,</para>
  <para style="q1" vid="PSA 94:14">ni Li p ap <note caller="+" style="x"><char style="xo" closed="false">94:14 </char><char style="xt" closed="false"><ref loc="PSA 37:28">Sòm 37:28</ref></char></note> lage pèp eritaj Li a.<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>Paske <note caller="+" style="x"><char style="xo" closed="false">94:15 </char><char style="xt" closed="false"><ref loc="PSA 97:2">Sòm 97:2</ref></char></note> jijman an va devni dwat ankò e</para>
  <para style="q1" vid="PSA 94:15">tout pèp ladwati yo va swiv li.<verse eid="PSA 94:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>Se kilès ki va <note caller="+" style="x"><char style="xo" closed="false">94:16 </char><char style="xt" closed="false"><ref loc="NUM 10:35">Nonb 10:35</ref></char></note> kanpe pou mwen kont malfektè yo?</para>
  <para style="q1" vid="PSA 94:16">Se kilès ki va pran pozisyon li pou mwen kont sila ki fè mechanste yo?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>Si <note caller="+" style="x"><char style="xo" closed="false">94:17 </char><char style="xt" closed="false"><ref loc="PSA 124:1-2">Sòm 124:1-2</ref></char></note> SENYÈ a pa t sekou mwen,</para>
  <para style="q1" vid="PSA 94:17">nanm mwen ta fin abite nan andwa silans lan.<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>Si mwen ta di: <note caller="+" style="x"><char style="xo" closed="false">94:18 </char><char style="xt" closed="false"><ref loc="PSA 38:16">Sòm 38:16</ref></char></note> “Pye m glise,”</para>
  <para style="q1" vid="PSA 94:18">Lanmou dous Ou a, O SENYÈ, va kenbe m.<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>Lè panse twoub mwen yo vin ogmante anndan m,</para>
  <para style="q1" vid="PSA 94:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">94:19 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 57:18">És 57:18</ref>
      </char>
    </note> konsolasyon Ou yo fè kè m kontan.<verse eid="PSA 94:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>Èske yon <note caller="+" style="x"><char style="xo" closed="false">94:20 </char><char style="xt" closed="false"><ref loc="AMO 6:3">Am 6:3</ref></char></note> twòn mechan kapab fè amitye avèk Ou?</para>
  <para style="q1" vid="PSA 94:20">Yon moun ki imajine fè mal pa dekrè?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>Yo vin reyini ansanm kont lavi moun dwat yo,</para>
  <para style="q1" vid="PSA 94:21">e <note caller="+" style="x"><char style="xo" closed="false">94:21 </char><char style="xt" closed="false"><ref loc="EXO 23:7">Egz 23:7</ref></char></note> kondane inosan yo a lanmò.<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>Men SENYÈ a se toujou sitadèl mwen e</para>
  <para style="q1" vid="PSA 94:22">Bondye mwen an, <note caller="+" style="x"><char style="xo" closed="false">94:22 </char><char style="xt" closed="false"><ref loc="PSA 18:2">Sòm 18:2</ref> </char></note>wòch ki pwoteje mwen an.<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>Li te fè mechanste pa yo retounen sou yo, e</para>
  <para style="q1" vid="PSA 94:23">va <note caller="+" style="x"><char style="xo" closed="false">94:23 </char><char style="xt" closed="false"><ref loc="PSA 7:16">Sòm 7:16</ref></char></note> koupe retire yo nèt nan mechanste pa yo.</para>
  <para style="q1" vid="PSA 94:23">SENYÈ nou an va koupe retire yo.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>O vini, annou chante a SENYÈ a!</para>
  <para style="q1" vid="PSA 95:1">Annou rele fò avèk jwa a wòch ki sove nou an;<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>Annou vini devan prezans Li avèk remèsiman,</para>
  <para style="q1" vid="PSA 95:2">Annou rele fò a Li menm avèk sòm.<verse eid="PSA 95:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>Paske SENYÈ a se yon <note caller="+" style="x"><char style="xo" closed="false">95:3 </char><char style="xt" closed="false"><ref loc="PSA 48:1">Sòm 48:1</ref></char></note> gran Bondye, e</para>
  <para style="q1" vid="PSA 95:3">yon gran wa pi wo ke tout dye yo.<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>Nan men Sila <note caller="+" style="x"><char style="xo" closed="false">95:4 </char><char style="xt" closed="false"><ref loc="PSA 135:6">Sòm 135:6</ref></char></note> pwofondè latè yo ye a.</para>
  <para style="q1" vid="PSA 95:4">Pwent mòn yo osi se pou Li.<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>Lanmè a se pou Li, paske se te Li menm <note caller="+" style="x"><char style="xo" closed="false">95:5 </char><char style="xt" closed="false"><ref loc="GEN 1:9-10">Jen 1:9-10</ref></char></note> ki te fè l.</para>
  <para style="q1" vid="PSA 95:5">Ak men L, Li te fòme tè sèch la.<verse eid="PSA 95:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>Vini, annou fè adorasyon, e annou pwostène.</para>
  <para style="q1" vid="PSA 95:6">Annou mete ajenou devan SENYÈ <note caller="+" style="x"><char style="xo" closed="false">95:6 </char><char style="xt" closed="false"><ref loc="PSA 100:3">Sòm 100:3</ref></char></note> ki te fè nou an.<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>Paske se Li menm ki Bondye nou an.</para>
  <para style="q1" vid="PSA 95:7">Nou se moun patiraj Li ak mouton men Li yo.</para>
  <para style="q1" vid="PSA 95:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">95:7 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 3:7-11">Eb 3:7-11-15</ref>
      </char>
    </note> Jodi a, si nou ta vle tande vwa L,<verse eid="PSA 95:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8"/>pa fè kè nou vin di tankou nan <note caller="+" style="x"><char style="xo" closed="false">95:8 </char><char style="xt" closed="false"><ref loc="EXO 17:2-7">Egz 17:2-7</ref></char></note> Meriba,</para>
  <para style="q1" vid="PSA 95:8">tankou nan jou a Massa nan dezè yo,<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>“lè papa zansèt nou yo te <note caller="+" style="x"><char style="xo" closed="false">95:9 </char><char style="xt" closed="false"><ref loc="NUM 14:22">Nonb 14:22</ref></char></note> pase M a leprèv.</para>
  <para style="q1" vid="PSA 95:9">Yo te tante Mwen, malgre yo te deja wè zèv Mwen yo.<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>Pandan <note caller="+" style="x"><char style="xo" closed="false">95:10 </char><char style="xt" closed="false"><ref loc="ACT 7:36">Trav 7:36</ref></char></note> karantan, Mwen te rayi jenerasyon sila a e te di:</para>
  <para style="q1" vid="PSA 95:10">“Yo se yon pèp ki egare nan kè yo.</para>
  <para style="q1" vid="PSA 95:10">Yo pa rekonèt chemen Mwen yo.”<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>Akoz sa, Mwen te sèmante nan kòlè Mwen,</para>
  <para style="q1" vid="PSA 95:11">“Anverite, yo p ap antre nan <note caller="+" style="x"><char style="xo" closed="false">95:11 </char><char style="xt" closed="false"><ref loc="DEU 12:9">Det 12:9</ref></char></note>repo Mwen an.”<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>Chante a SENYÈ a yon <note caller="+" style="x"><char style="xo" closed="false">96:1 </char><char style="xt" closed="false"><ref loc="PSA 40:3">Sòm 40:3</ref></char></note> chan tounèf!</para>
  <para style="q1" vid="PSA 96:1">Chante a SENYÈ a tout latè a.<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>Chante a SENYÈ a!</para>
  <para style="q1" vid="PSA 96:2">Beni non Li!</para>
  <para style="q1" vid="PSA 96:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">96:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:15">Sòm 71:15</ref>
      </char>
    </note> Pwoklame bòn nouvèl Sali a Li de jou an jou.<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>Pale <note caller="+" style="x"><char style="xo" closed="false">96:3 </char><char style="xt" closed="false"><ref loc="PSA 145:12">Sòm 145:12</ref></char></note> glwa Li pami nasyon yo,</para>
  <para style="q1" vid="PSA 96:3">zèv mèvèy Li yo pami tout pèp yo.<verse eid="PSA 96:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>Paske gran se SENYÈ a!</para>
  <para style="q1" vid="PSA 96:4">Li merite gran lwanj.</para>
  <para style="q1" vid="PSA 96:4">Fòk Li resevwa krentif nou <note caller="+" style="x"><char style="xo" closed="false">96:4 </char><char style="xt" closed="false"><ref loc="PSA 95:3">Sòm 95:3</ref></char></note>pi wo ke tout dye yo.<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>Paske tout dye a pèp yo se zidòl,</para>
  <para style="q1" vid="PSA 96:5">men SENYÈ a te fè syèl yo.<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">96:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:1">Sòm 104:1</ref>
      </char>
    </note> Tout bèlte ak majeste devan L.</para>
  <para style="q1" vid="PSA 96:6">Pwisans ak bèlte rete nan sanktiyè Li a.<verse eid="PSA 96:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>Bay a SENYÈ a, O fanmi a pèp yo,</para>
  <para style="q1" vid="PSA 96:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">96:7 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:28-29">I Kwo 16:28-29</ref>
      </char>
    </note> bay a SENYÈ a glwa ak pwisans.<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>Bay a SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">96:8 </char><char style="xt" closed="false"><ref loc="PSA 79:9">Sòm 79:9</ref></char></note> glwa a non Li.</para>
  <para style="q1" vid="PSA 96:8">Pote yon ofrann e antre nan lakou Li yo.<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>Adore SENYÈ a nan abiman ki sen.</para>
  <para style="q1" vid="PSA 96:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">96:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:8">Sòm 33:8</ref>
      </char>
    </note> Tranble devan L, tout latè a.<verse eid="PSA 96:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>Pale pami nasyon yo, “SENYÈ a renye.”</para>
  <para style="q1" vid="PSA 96:10">Anverite, mond lan etabli byen solid.</para>
  <para style="q1" vid="PSA 96:10">Li p ap ebranle menm.</para>
  <para style="q1" vid="PSA 96:10">SENYÈ a va jije pèp yo avèk jistis.<verse eid="PSA 96:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>Kite <note caller="+" style="x"><char style="xo" closed="false">96:11 </char><char style="xt" closed="false"><ref loc="PSA 69:34">Sòm 69:34</ref></char></note> syèl yo vin kontan e kite latè rejwi.</para>
  <para style="q1" vid="PSA 96:11">Kite lanmè a fè gwo bri ansanm ak tout sa ki ladann.<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>Kite chan yo leve fè kè kontan, ak tout sa ki ladann yo.</para>
  <para style="q1" vid="PSA 96:12">Epi tout <note caller="+" style="x"><char style="xo" closed="false">96:12 </char><char style="xt" closed="false"><ref loc="ISA 44:23">És 44:23</ref> </char></note>bwa nan forè yo va chante ak jwa<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>devan SENYÈ a, paske La p vini.</para>
  <para style="q1" vid="PSA 96:13">Paske La p vini pou jije latè. <note caller="+" style="x"><char style="xo" closed="false">96:13 </char><char style="xt" closed="false"><ref loc="REV 19:11">Rev 19:11</ref></char></note> Li va jije mond lan</para>
  <para style="q1" vid="PSA 96:13">avèk ladwati e pèp yo ak fidelite Li.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>SENYÈ a renye, kite latè rejwi!</para>
  <para style="q1" vid="PSA 97:1">Kite tout <note caller="+" style="x"><char style="xo" closed="false">97:1 </char><char style="xt" closed="false"><ref loc="ISA 42:10-12">És 42:10-12</ref></char></note> lil yo fè kè kontan!<verse eid="PSA 97:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>Nwaj ak fènwa pwofon ap antoure Li.</para>
  <para style="q1" vid="PSA 97:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">97:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:14">Sòm 89:14</ref>
      </char>
    </note> Ladwati avèk jistis se fondasyon twòn Li an.<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>Se <note caller="+" style="x"><char style="xo" closed="false">97:3 </char><char style="xt" closed="false"><ref loc="MAL 4:1">Mal 4:1</ref></char></note> dife ki ale devan L pou brile tout</para>
  <para style="q1" vid="PSA 97:3">advèsè Li yo toupatou.<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">97:4 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 19:16">Egz 19:16</ref>
      </char>
    </note> Loray Li yo klere tout mond lan.</para>
  <para style="q1" vid="PSA 97:4">Latè wè e li tranble.<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>Mòn yo <note caller="+" style="x"><char style="xo" closed="false">97:5 </char><char style="xt" closed="false"><ref loc="PSA 46:6">Sòm 46:6</ref></char></note> fonn tankou lasi devan prezans SENYÈ a,</para>
  <para style="q1" vid="PSA 97:5">devan prezans SENYÈ tout latè a.<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">97:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:1">Sòm 19:1</ref>
      </char>
    </note> Syèl yo deklare ladwati Li e tout pèp yo te wè glwa Li.<verse eid="PSA 97:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>Kite tout sila ki sèvi limaj taye yo vin wont,</para>
  <para style="q1" vid="PSA 97:7">ki vin ògeye sou zafè <note caller="+" style="x"><char style="xo" closed="false">97:7 </char><char style="xt" closed="false"><ref loc="PSA 106:36">Sòm 106:36</ref></char></note>zidòl yo.</para>
  <para style="q1" vid="PSA 97:7">Adore Li, tout dye yo.<verse eid="PSA 97:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>Sion te tande sa e <note caller="+" style="x"><char style="xo" closed="false">97:8 </char><char style="xt" closed="false"><ref loc="PSA 48:11">Sòm 48:11</ref></char></note> te rejwi.</para>
  <para style="q1" vid="PSA 97:8">Fi a Sion yo te rejwi akoz jijman Ou, O SENYÈ.<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>Paske Ou menm se SENYÈ Pi Wo a sou tout latè.</para>
  <para style="q1" vid="PSA 97:9">Ou leve <note caller="+" style="x"><char style="xo" closed="false">97:9 </char><char style="xt" closed="false"><ref loc="PSA 83:18">Sòm 83:18</ref></char></note> pi wo anpil pase tout dye yo.<verse eid="PSA 97:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">97:10 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:14">Sòm 34:14</ref>
      </char>
    </note> Nou menm ki renmen SENYÈ a, rayi mal la!</para>
  <para style="q1" vid="PSA 97:10">Li pwoteje nanm a fidèl Li yo.</para>
  <para style="q1" vid="PSA 97:10">Li delivre yo nan men a mechan yo.<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>Se limyè ki simen kon semans pou moun ladwati yo,</para>
  <para style="q1" vid="PSA 97:11">ak <note caller="+" style="x"><char style="xo" closed="false">97:11 </char><char style="xt" closed="false"><ref loc="PSA 64:10">Sòm 64:10</ref> </char></note>kè kontan pou sila ak kè ki dwat yo.<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>Fè kè kontan nan SENYÈ a, nou menm ki moun dwat yo e</para>
  <para style="q1" vid="PSA 97:12">bay remèsiman a non sen Li an.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="d">Yon Sòm</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>O chante a SENYÈ a yon chan tounèf, paske Li te fè anpil bèl mèvèy.</para>
  <para style="q1" vid="PSA 98:1">Men dwat Li ak <note caller="+" style="x"><char style="xo" closed="false">98:1 </char><char style="xt" closed="false"><ref loc="ISA 52:10">És 52:10</ref></char></note> bra sen Li yo te vin genyen viktwa pou Li.<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>SENYÈ a te fè sali Li rekonèt.</para>
  <para style="q1" vid="PSA 98:2">Li te <note caller="+" style="x"><char style="xo" closed="false">98:2 </char><char style="xt" closed="false"><ref loc="ISA 62:2">És 62:2</ref></char></note>devwale ladwati Li pou tout nasyon yo wè.<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>Li te sonje lanmou dous Li a avèk fidelite Li pou lakay Israël.<verse eid="PSA 98:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>Rele fò ak jwa a SENYÈ a, tout latè!</para>
  <para style="q1" vid="PSA 98:4">Eklate ak chanson, wi chante lwanj Li yo!<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>Chante lwanj a SENYÈ a avèk ap,</para>
  <para style="q1" vid="PSA 98:5">avèk ap ak <note caller="+" style="x"><char style="xo" closed="false">98:5 </char><char style="xt" closed="false"><ref loc="ISA 51:3">És 51:3</ref></char></note> vwa melodi a.<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>Avèk <note caller="+" style="x"><char style="xo" closed="false">98:6 </char><char style="xt" closed="false"><ref loc="NUM 10:10">Nonb 10:10</ref></char></note> twonpèt ak son a kòn.</para>
  <para style="q1" vid="PSA 98:6">Rele fò devan Wa a, SENYÈ a.<verse eid="PSA 98:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>Kite <note caller="+" style="x"><char style="xo" closed="false">98:7 </char><char style="xt" closed="false"><ref loc="PSA 96:11">Sòm 96:11</ref></char></note> lanmè a fè gwo bri ak tout sa ki ladann,</para>
  <para style="q1" vid="PSA 98:7">Lemonn ak tout sa ki rete ladann yo.<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>Kite <note caller="+" style="x"><char style="xo" closed="false">98:8 </char><char style="xt" closed="false"><ref loc="PSA 93:3">Sòm 93:3</ref></char></note> larivyè yo bat men yo.</para>
  <para style="q1" vid="PSA 98:8">Kite mòn yo chante ansanm ak jwa<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>devan SENYÈ a,</para>
  <para style="q1" vid="PSA 98:9">paske l ap vini pou jije latè.</para>
  <para style="q1" vid="PSA 98:9">Li va jije lemonn ak ladwati Li</para>
  <para style="q1" vid="PSA 98:9">E <note caller="+" style="x"><char style="xo" closed="false">98:9 </char><char style="xt" closed="false"><ref loc="PSA 96:10">Sòm 96:10</ref></char></note>pèp yo avèk jistis.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>SENYÈ a renye! Kite pèp yo pran tranble.</para>
  <para style="q1" vid="PSA 99:1">Li <note caller="+" style="x"><char style="xo" closed="false">99:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Egz 25:22</ref></char></note> plase twòn Li an anwo cheriben yo.</para>
  <para style="q1" vid="PSA 99:1">Kite latè pran tranble!<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>SENYÈ a gran nan Sion.</para>
  <para style="q1" vid="PSA 99:2">Li <note caller="+" style="x"><char style="xo" closed="false">99:2 </char><char style="xt" closed="false"><ref loc="PSA 97:9">Sòm 97:9</ref></char></note> leve wo anwo tout pèp yo.<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>Kite yo louwe non Ou ki <note caller="+" style="x"><char style="xo" closed="false">99:3 </char><char style="xt" closed="false"><ref loc="DEU 28:58">Det 28:58</ref></char></note> gran e mèvèye;</para>
  <para style="q1" vid="PSA 99:3">Se sen ke Li ye.<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>Pwisans a Wa a <note caller="+" style="x"><char style="xo" closed="false">99:4 </char><char style="xt" closed="false"><ref loc="PSA 11:7">Sòm 11:7</ref></char></note> renmen lajistis.</para>
  <para style="q1" vid="PSA 99:4">Ou te etabli ekite.</para>
  <para style="q1" vid="PSA 99:4">Ou te fè jistis ak ladwati Ou vin rive nan Jacob.<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>Leve wo SENYÈ, Bondye nou an!</para>
  <para style="q1" vid="PSA 99:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">99:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 132:7">Sòm 132:7</ref> </char>
    </note>Adore nan machpye twòn Li an.</para>
  <para style="q1" vid="PSA 99:5">Se sen ke Li ye.<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>Moïse avèk Aaron te pami prèt Li yo e</para>
  <para style="q1" vid="PSA 99:6">Samuel te pami sila ki te rele non Li yo.</para>
  <para style="q1" vid="PSA 99:6">Yo te <note caller="+" style="x"><char style="xo" closed="false">99:6 </char><char style="xt" closed="false"><ref loc="EXO 15:25">Egz 15:25</ref> </char></note>rele non SENYÈ a e Li te reponn yo.<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>Li <note caller="+" style="x"><char style="xo" closed="false">99:7 </char><char style="xt" closed="false"><ref loc="EXO 33:9">Egz 33:9</ref></char></note> te pale ak yo nan pilye nwaj la.</para>
  <para style="q1" vid="PSA 99:7">Yo te kenbe temwayaj Li yo,</para>
  <para style="q1" vid="PSA 99:7">avèk règleman ke Li te bay yo.<verse eid="PSA 99:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>O SENYÈ, Bondye nou an, Ou te reponn yo.</para>
  <para style="q1" vid="PSA 99:8">Ou te pou yo yon Bondye ki padone,</para>
  <para style="q1" vid="PSA 99:8">men Ou te pran <note caller="+" style="x"><char style="xo" closed="false">99:8 </char><char style="xt" closed="false"><ref loc="EXO 32:28">Egz 32:28</ref></char></note>vanjans sou zak mechan yo.<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>Egzalte SENYÈ, Bondye nou an!</para>
  <para style="q1" vid="PSA 99:9">Adore nan mon sen Li an,</para>
  <para style="q1" vid="PSA 99:9">paske sen se SENYÈ a, Bondye nou an!<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="d">Yon Sòm Remèsiman an</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">100:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:1">Sòm 95:1</ref>
      </char>
    </note> Rele fò a SENYÈ tout latè a!<verse eid="PSA 100:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">100:2 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 12:11-12">Det 12:11-12</ref>
      </char>
    </note> Sèvi SENYÈ a avèk kè kontan!</para>
  <para style="q1" vid="PSA 100:2">Vini devan Li avèk chan lajwa.<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>Konnen ke SENYÈ a, Li menm, se Bondye.</para>
  <para style="q1" vid="PSA 100:3">Se Li menm ki te <note caller="+" style="x"><char style="xo" closed="false">100:3 </char><char style="xt" closed="false"><ref loc="JOB 10:3-8">Job 10:3-8</ref></char></note> fè nou, e se pou Li nou ye.</para>
  <para style="q1" vid="PSA 100:3">Nou se pèp Li e mouton patiraj Li.<verse eid="PSA 100:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>Antre nan pòtay Li yo avèk remèsiman,</para>
  <para style="q1" vid="PSA 100:4">e nan lakou Li yo avèk lwanj.</para>
  <para style="q1" vid="PSA 100:4">Ba Li remèsiman!</para>
  <para style="q1" vid="PSA 100:4">Beni non Li!<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>Paske Bondye bon.</para>
  <para style="q1" vid="PSA 100:5">Lanmou dous li a dire jis pou tout tan,</para>
  <para style="q1" vid="PSA 100:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">100:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:90">Sòm 119:90</ref>
      </char>
    </note> e fidelite Li a tout jenerasyon yo.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="d">Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">101:1 </char><char style="xt" closed="false"><ref loc="PSA 51:14">Sòm 51:14</ref></char></note> chante de lanmou dous avèk jistis.</para>
  <para style="q1" vid="PSA 101:1">A Ou menm, O SENYÈ, mwen va chante lwanj.<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>Mwen va prete atansyon a chemen san repwòch la.</para>
  <para style="q1" vid="PSA 101:2">Kilè Ou va vini kote mwen?</para>
  <para style="q1" vid="PSA 101:2">Mwen va mache anndan lakay mwen ak <note caller="+" style="x"><char style="xo" closed="false">101:2 </char><char style="xt" closed="false"><ref loc="1KI 9:4">I Wa 9:4</ref></char></note>entegrite nan kè m.<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>Mwen p ap mete okenn vye bagay devan zye m.</para>
  <para style="q1" vid="PSA 101:3">Mwen rayi zèv a sila ki <note caller="+" style="x"><char style="xo" closed="false">101:3 </char><char style="xt" closed="false"><ref loc="JOS 23:6">Jos 23:6</ref></char></note> chite yo.</para>
  <para style="q1" vid="PSA 101:3">Sa p ap tache men l sou mwen.<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>Yon <note caller="+" style="x"><char style="xo" closed="false">101:4 </char><char style="xt" closed="false"><ref loc="PRO 11:20">Pwov 11:20</ref></char></note> kè ki pèvès va oblije kite prezans mwen.</para>
  <para style="q1" vid="PSA 101:4">Mwen p ap aksepte konnen okenn mal.<verse eid="PSA 101:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>Nenpòt moun ki bay vwazen li kout lang an sekrè,</para>
  <para style="q1" vid="PSA 101:5">li menm, mwen va detwi.</para>
  <para style="q1" vid="PSA 101:5">Nenpòt moun ak <note caller="+" style="x"><char style="xo" closed="false">101:5 </char><char style="xt" closed="false"><ref loc="PSA 10:4">Sòm 10:4</ref></char></note>rega awogan oswa ògèy, mwen p ap sipòte li.<verse eid="PSA 101:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>Zye m va sou fidèl a peyi a pou yo kab rete avè m.</para>
  <para style="q1" vid="PSA 101:6">Sila ki mache nan chemen <note caller="+" style="x"><char style="xo" closed="false">101:6 </char><char style="xt" closed="false"><ref loc="PSA 119:1">Sòm 119:1</ref></char></note> san fot la, se li menm</para>
  <para style="q1" vid="PSA 101:6">ki va sèvitè mwen.<verse eid="PSA 101:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">101:7 </char><char style="xt" closed="false"><ref loc="PSA 43:1">Sòm 43:1</ref></char></note>pratike manti p ap rete lakay mwen.</para>
  <para style="q1" vid="PSA 101:7">Sila ki bay manti p ap kenbe pozisyon li devan m.<verse eid="PSA 101:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>Chak maten mwen va detwi tout mechan nan peyi yo,</para>
  <para style="q1" vid="PSA 101:8">Pou m kab <note caller="+" style="x"><char style="xo" closed="false">101:8 </char><char style="xt" closed="false"><ref loc="PSA 118:10-12">Sòm 118:10-12</ref></char></note>koupe retire nan vil SENYÈ a, tout moun ki fè inikite yo.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>Koute lapriyè mwen, O SENYÈ!</para>
  <para style="q1" vid="PSA 102:1">Epi kite kri sekou mwen <note caller="+" style="x"><char style="xo" closed="false">102:1 </char><char style="xt" closed="false"><ref loc="EXO 2:23">Egz 2:23</ref></char></note>rive bò kote Ou.<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>Pa kache figi Ou sou mwen nan jou gwo twoub mwen an;</para>
  <para style="q1" vid="PSA 102:2">Panche zòrèy Ou bò kote m.</para>
  <para style="q1" vid="PSA 102:2">Nan jou ke m rele Ou a, <note caller="+" style="x"><char style="xo" closed="false">102:2 </char><char style="xt" closed="false"><ref loc="PSA 69:17">Sòm 69:17</ref></char></note>reponn mwen vit.<verse eid="PSA 102:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>Paske jou m yo <note caller="+" style="x"><char style="xo" closed="false">102:3 </char><char style="xt" closed="false"><ref loc="PSA 37:20">Sòm 37:20</ref></char></note>te manje nèt nan lafimen,</para>
  <para style="q1" vid="PSA 102:3">e zo m te chofe tankou yon chemine.<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>Kè m <note caller="+" style="x"><char style="xo" closed="false">102:4 </char><char style="xt" closed="false"><ref loc="PSA 90:5-6">Sòm 90:5-6</ref></char></note>fin frape tankou zèb.</para>
  <para style="q1" vid="PSA 102:4">Li fennen nèt.</para>
  <para style="q1" vid="PSA 102:4">Anverite, mwen bliye manje pen mwen.<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>Akoz gwo bri kri mwen yo,</para>
  <para style="q1" vid="PSA 102:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">102:5 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 19:20">Job 19:20</ref>
      </char>
    </note>zo m yo kole sou chè m.<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>Mwen sanble ak yon <note caller="+" style="x"><char style="xo" closed="false">102:6 </char><char style="xt" closed="false"><ref loc="ISA 34:11">És 34:11</ref></char></note>grangozye nan dezè.</para>
  <para style="q1" vid="PSA 102:6">Mwen tankou yon frize nan gran savann.<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">102:7 </char><char style="xt" closed="false"><ref loc="PSA 77:4">Sòm 77:4</ref></char></note>kouche zye tou louvri.</para>
  <para style="q1" vid="PSA 102:7">Mwen tankou yon zwazo izole sou twati kay la.<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>Lènmi m yo repwoche m tout lajounen.</para>
  <para style="q1" vid="PSA 102:8">Sila ki <note caller="+" style="x"><char style="xo" closed="false">102:8 </char><char style="xt" closed="false"><ref loc="ACT 26:11">Trav 26:11</ref></char></note>moke m yo sèvi ak non mwen kon madichon.<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>Paske mwen te manje sann kon pen e</para>
  <para style="q1" vid="PSA 102:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">102:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:3">Sòm 42:3</ref>
      </char>
    </note>mele bwason m ak dlo zye m,<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>akoz endiyasyon avèk kòlè Ou.</para>
  <para style="q1" vid="PSA 102:10">Ou te <note caller="+" style="x"><char style="xo" closed="false">102:10 </char><char style="xt" closed="false"><ref loc="JOB 27:21">Job 27:21</ref></char></note>leve m wo e te jete m lwen.<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>Jou m yo tankou yon <note caller="+" style="x"><char style="xo" closed="false">102:11 </char><char style="xt" closed="false"><ref loc="JOB 14:2">Job 14:2</ref></char></note>lonbraj ki vin long.</para>
  <para style="q1" vid="PSA 102:11">Mwen vin fennen tankou zèb.<verse eid="PSA 102:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>Men Ou menm, O SENYÈ, Ou dire jis pou tout tan</para>
  <para style="q1" vid="PSA 102:12">E <note caller="+" style="x"><char style="xo" closed="false">102:12 </char><char style="xt" closed="false"><ref loc="EXO 3:15">Egz 3:15</ref></char></note>non Ou jis a tout jenerasyon yo.<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>Ou va leve pou fè pitye sou Sion,</para>
  <para style="q1" vid="PSA 102:13">paske se lè pou <note caller="+" style="x"><char style="xo" closed="false">102:13 </char><char style="xt" closed="false"><ref loc="ISA 60:10">És 60:10</ref></char></note>fè li gras.</para>
  <para style="q1" vid="PSA 102:13">Lè apwente a fin rive l.<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>Anverite, sèvitè Ou yo twouve plezi nan wòch li yo.</para>
  <para style="q1" vid="PSA 102:14">Yo plen tristès akoz pousyè li.<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>Pou sa, <note caller="+" style="x"><char style="xo" closed="false">102:15 </char><char style="xt" closed="false"><ref loc="1KI 8:43">I Wa 8:43</ref></char></note>nasyon yo va krent non SENYÈ a,</para>
  <para style="q1" vid="PSA 102:15">e tout wa latè yo va krent glwa Ou.<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>Paske se SENYÈ a ki te <note caller="+" style="x"><char style="xo" closed="false">102:16 </char><char style="xt" closed="false"><ref loc="PSA 142:2">Sòm 142:2</ref></char></note>ranfòse Sion.</para>
  <para style="q1" vid="PSA 102:16">Li te parèt nan glwa Li.<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>Li te <note caller="+" style="x"><char style="xo" closed="false">102:17 </char><char style="xt" closed="false"><ref loc="NEH 1:6">Né 1:6</ref></char></note>prete atansyon a lapriyè malere yo,</para>
  <para style="q1" vid="PSA 102:17">e pa t meprize priyè yo.<verse eid="PSA 102:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>Sa va ekri pou jenerasyon k ap vini an.</para>
  <para style="q1" vid="PSA 102:18">Pou <note caller="+" style="x"><char style="xo" closed="false">102:18 </char><char style="xt" closed="false"><ref loc="PSA 22:31">Sòm 22:31</ref></char></note>yon pèp ki poko kreye kapab bay lwanj a SENYÈ a.<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>Li te gade anba soti nan wotè sen Li an.</para>
  <para style="q1" vid="PSA 102:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">102:19 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:13">Sòm 33:13</ref>
      </char>
    </note>Soti nan syèl la, SENYÈ a te veye sou latè,<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>pou tande vwa plenyen a prizonye a,</para>
  <para style="q1" vid="PSA 102:20">pou <note caller="+" style="x"><char style="xo" closed="false">102:20 </char><char style="xt" closed="false"><ref loc="PSA 146:7">Sòm 146:7</ref></char></note>mete an libète sila ki te kondane a lanmò yo,<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>Pou lezòm ta kab <note caller="+" style="x"><char style="xo" closed="false">102:21 </char><char style="xt" closed="false"><ref loc="PSA 22:22">Sòm 22:22</ref></char></note>pale sou non SENYÈ a nan Sion,</para>
  <para style="q1" vid="PSA 102:21">e bay lwanj Li nan Jérusalem,<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>pandan <note caller="+" style="x"><char style="xo" closed="false">102:22 </char><char style="xt" closed="false"><ref loc="PSA 22:27">Sòm 22:27</ref></char></note>pèp yo rasanble ansanm ak</para>
  <para style="q1" vid="PSA 102:22">wayòm yo, pou sèvi SENYÈ a.<verse eid="PSA 102:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>Li fin febli fòs mwen nan chemen an.</para>
  <para style="q1" vid="PSA 102:23">Li <note caller="+" style="x"><char style="xo" closed="false">102:23 </char><char style="xt" closed="false"><ref loc="PSA 39:5">Sòm 39:5</ref></char></note>rakousi nonb de jou mwen yo.<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>Mwen te di: “O Bondye mwen an,</para>
  <para style="q1" vid="PSA 102:24">
    <note caller="+" style="x">
      <char style="xo" closed="false">102:24 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:13">Sòm 39:13</ref>
      </char>
    </note>pa rache m nan mitan jou mwen yo.</para>
  <para style="q1" vid="PSA 102:24">Ane pa Ou yo dire pandan tout jenerasyon yo.<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>Depi tan ansyen yo, Ou te <note caller="+" style="x"><char style="xo" closed="false">102:25 </char><char style="xt" closed="false"><ref loc="GEN 1:1">Jen 1:1</ref></char></note>fonde latè,</para>
  <para style="q1" vid="PSA 102:25">e syèl yo se zèv lamen Ou yo.<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>Malgre yo <note caller="+" style="x"><char style="xo" closed="false">102:26 </char><char style="xt" closed="false"><ref loc="ISA 34:4">És 34:4</ref></char></note>peri, Ou menm va rete toujou.</para>
  <para style="q1" vid="PSA 102:26">Wi, tout bagay nan yo va vin epwize tankou yon vètman.</para>
  <para style="q1" vid="PSA 102:26">Tankou rad, Ou va chanje yo, e yo va chanje.<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>Men Ou menm, se menm jan an Ou ye.</para>
  <para style="q1" vid="PSA 102:27">Ane pa Ou yo p ap janm fini.<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>Pitit a sèvitè Ou yo va kontinye,</para>
  <para style="q1" vid="PSA 102:28">e desandan pa yo va etabli devan Ou.”<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="d">Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">103:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:1-35">Sòm 104:1-35</ref>
      </char>
    </note>Beni SENYÈ a, O nanm mwen!</para>
  <para style="q1" vid="PSA 103:1">Tout sa ki nan mwen, beni sen non Li!<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>Beni SENYÈ a, O nanm mwen,</para>
  <para style="q1" vid="PSA 103:2">e pa janm <note caller="+" style="x"><char style="xo" closed="false">103:2 </char><char style="xt" closed="false"><ref loc="DEU 6:12">Det 6:12</ref></char></note>bliye benefis Li yo,<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>ki <note caller="+" style="x"><char style="xo" closed="false">103:3 </char><char style="xt" closed="false"><ref loc="EXO 34:7">Egz 34:7</ref></char></note>padone tout inikite ou yo,</para>
  <para style="q1" vid="PSA 103:3">ki geri tout maladi ou yo,<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>ki rachte lavi ou soti nan fòs la,</para>
  <para style="q1" vid="PSA 103:4">ki kouwone ou avèk lanmou dous avèk</para>
  <para style="q1" vid="PSA 103:4">mizerikòd;<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>ki satisfè ane ou yo avèk bon bagay,</para>
  <para style="q1" vid="PSA 103:5">Pou jenès ou vin <note caller="+" style="x"><char style="xo" closed="false">103:5 </char><char style="xt" closed="false"><ref loc="ISA 40:31">És 40:31</ref></char></note>renouvle tankou èg la.<verse eid="PSA 103:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">103:6 </char><char style="xt" closed="false"><ref loc="PSA 99:4">Sòm 99:4</ref></char></note>fè zèv ladwati pou tout sila ki oprime yo.<verse eid="PSA 103:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>Li te fè chemen Li yo byen klè a Moïse,</para>
  <para style="q1" vid="PSA 103:7">zèv Li yo a fis Israël yo.<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>SENYÈ a plen <note caller="+" style="x"><char style="xo" closed="false">103:8 </char><char style="xt" closed="false"><ref loc="EXO 34:6">Egz 34:6</ref> </char></note>mizerikòd ak gras,</para>
  <para style="q1" vid="PSA 103:8">lan nan kòlè e ranpli avèk lanmou dous.<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>Li p ap toujou goumen ak nou,</para>
  <para style="q1" vid="PSA 103:9">ni Li p ap <note caller="+" style="x"><char style="xo" closed="false">103:9 </char><char style="xt" closed="false"><ref loc="JER 3:5-12">Jr 3:5-12</ref></char></note>kenbe kòlè Li jis pou tout tan.<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>Li <note caller="+" style="x"><char style="xo" closed="false">103:10 </char><char style="xt" closed="false"><ref loc="EZR 9:13">Esd 9:13</ref></char></note>pa t aji avèk nou selon peche nou yo,</para>
  <para style="q1" vid="PSA 103:10">ni rekonpanse nou selon inikite nou yo.<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>Paske menm jan syèl yo pi wo pase tè a,</para>
  <para style="q1" vid="PSA 103:11">menm jan an lanmou dous Li a ye anvè sila ki krent Li yo.<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>Menm jan lès lwen lwès la,</para>
  <para style="q1" vid="PSA 103:12">Se konsa li te retire transgresyon nou yo lwen nou.<verse eid="PSA 103:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>Menm jan <note caller="+" style="x"><char style="xo" closed="false">103:13 </char><char style="xt" closed="false"><ref loc="MAL 3:17">Mal 3:17</ref></char></note>ke yon papa gen konpasyon pou pitit li yo,</para>
  <para style="q1" vid="PSA 103:13">se konsa ke SENYÈ a gen konpasyon pou sila ki krent Li yo.<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>Paske Li menm, Li konnen jan nou fèt.</para>
  <para style="q1" vid="PSA 103:14">Li sonje byen ke nou pa plis ke <note caller="+" style="x"><char style="xo" closed="false">103:14 </char><char style="xt" closed="false"><ref loc="GEN 3:19">Jen 3:19</ref></char></note>pousyè.<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>Men pou lòm, jou li yo se <note caller="+" style="x"><char style="xo" closed="false">103:15 </char><char style="xt" closed="false"><ref loc="PSA 90:5">Sòm 90:5</ref></char></note>tankou zèb.</para>
  <para style="q1" vid="PSA 103:15">Tankou yon flè nan chan, se konsa li fleri.<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>Depi <note caller="+" style="x"><char style="xo" closed="false">103:16 </char><char style="xt" closed="false"><ref loc="ISA 40:7">És 40:7</ref></char></note>van fin pase sou li, li pa la ankò e</para>
  <para style="q1" vid="PSA 103:16">plas li a pa rekonèt li ankò.<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>Men <note caller="+" style="x"><char style="xo" closed="false">103:17 </char><char style="xt" closed="false"><ref loc="PSA 25:6">Sòm 25:6</ref></char></note>lanmou dous a SENYÈ a,</para>
  <para style="q1" vid="PSA 103:17">soti pou tout tan jis rive pou tout tan</para>
  <para style="q1" vid="PSA 103:17">sou sila ki gen lakrent Li yo</para>
  <para style="q1" vid="PSA 103:17">e ladwati Li a pitit pitit li yo,<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>pou sila ki kenbe akò Li yo,</para>
  <para style="q1" vid="PSA 103:18">e sonje règleman Li yo pou fè yo.<verse eid="PSA 103:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>SENYÈ a te etabli twòn li nan syèl la</para>
  <para style="q1" vid="PSA 103:19">e souverènte li regne sou tout bagay.<verse eid="PSA 103:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>Beni SENYÈ a, nou menm, zanj Li yo,</para>
  <para style="q1" vid="PSA 103:20">pwisan nan fòs, ki akonpli pawòl Li,</para>
  <para style="q1" vid="PSA 103:20">ki obeyisan a vwa pawòl Li!<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>Beni SENYÈ a, nou tout, lame Li yo,</para>
  <para style="q1" vid="PSA 103:21">nou menm <note caller="+" style="x"><char style="xo" closed="false">103:21 </char><char style="xt" closed="false"><ref loc="PSA 104:4">Sòm 104:4</ref></char></note>ki sèvi Li nan fè volonte Li.<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>Beni SENYÈ a, nou tout, zèv Li yo,</para>
  <para style="q1" vid="PSA 103:22">nan tout kote nan wayòm Li an.</para>
  <para style="q1" vid="PSA 103:22">Beni SENYÈ a, O nanm mwen!<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>Beni SENYÈ a, O nanm mwen!</para>
  <para style="q1" vid="PSA 104:1">O SENYÈ, Bondye mwen an, Ou tèlman gran.</para>
  <para style="q1" vid="PSA 104:1">Ou <note caller="+" style="x"><char style="xo" closed="false">104:1 </char><char style="xt" closed="false"><ref loc="PSA 93:1">Sòm 93:1</ref></char></note>abiye avèk bèlte ak majeste.<verse eid="PSA 104:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>Li kouvri Li menm ak limyè kon yon manto.</para>
  <para style="q1" vid="PSA 104:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">104:2 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:22">És 40:22</ref>
      </char>
    </note>Ki ouvri syèl la tankou yon rido tant.<verse eid="PSA 104:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3"/>Li poze gran travès wo chanm nan nan dlo.</para>
  <para style="q1" vid="PSA 104:3">Li fè <note caller="+" style="x"><char style="xo" closed="false">104:3 </char><char style="xt" closed="false"><ref loc="ISA 19:1">És 19:1</ref></char></note>nwaj yo sèvi kon cha Li.</para>
  <para style="q1" vid="PSA 104:3">Li mache sou zèl van an.<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>Li fè van yo vin mesaje Li.</para>
  <para style="q1" vid="PSA 104:4">Flanm <note caller="+" style="x"><char style="xo" closed="false">104:4 </char><char style="xt" closed="false"><ref loc="2KI 2:11">II Wa 2:11</ref></char></note>dife yo se minis Li.<verse eid="PSA 104:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>Li te <note caller="+" style="x"><char style="xo" closed="false">104:5 </char><char style="xt" closed="false"><ref loc="JOB 38:4">Job 38:4</ref></char></note>etabli tè a sou pwòp fondasyon li,</para>
  <para style="q1" vid="PSA 104:5">pou l pa varye pou tout tan ni pou tout tan.<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>Ou te <note caller="+" style="x"><char style="xo" closed="false">104:6 </char><char style="xt" closed="false"><ref loc="GEN 1:2">Jen 1:2</ref></char></note>kouvri li avèk fon an tankou yon vètman.</para>
  <para style="q1" vid="PSA 104:6">Dlo yo te kanpe anwo mòn yo.<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>Ak repwòch Ou, yo te sove ale.</para>
  <para style="q1" vid="PSA 104:7">Lè vwa Ou te <note caller="+" style="x"><char style="xo" closed="false">104:7 </char><char style="xt" closed="false"><ref loc="PSA 29:3">Sòm 29:3</ref></char></note>sone, yo te kouri ale.<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>Mòn yo te leve, vale yo te vin fon</para>
  <para style="q1" vid="PSA 104:8">nan <note caller="+" style="x"><char style="xo" closed="false">104:8 </char><char style="xt" closed="false"><ref loc="PSA 33:7">Sòm 33:7</ref></char></note>plas ke Ou te kòmande pou yo a.<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>Ou te plase yon <note caller="+" style="x"><char style="xo" closed="false">104:9 </char><char style="xt" closed="false"><ref loc="JOB 38:10">Job 38:10</ref></char></note>limit pou dlo yo pa ta depase,</para>
  <para style="q1" vid="PSA 104:9">pou yo pa retounen kouvri tè a.<verse eid="PSA 104:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>Li fè <note caller="+" style="x"><char style="xo" closed="false">104:10 </char><char style="xt" closed="false"><ref loc="PSA 107:35">Sòm 107:35</ref></char></note>sous yo vin koule nan vale yo.</para>
  <para style="q1" vid="PSA 104:10">Yo koule antre mòn yo.<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>Yo bay dlo pou bwè a tout bèt chan yo.</para>
  <para style="q1" vid="PSA 104:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">104:11 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 39:5">Job 39:5</ref>
      </char>
    </note>Bourik mawon yo bwè pou satisfè swaf yo.<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>Akote yo, zwazo syèl yo va <note caller="+" style="x"><char style="xo" closed="false">104:12 </char><char style="xt" closed="false"><ref loc="MAT 8:20">Mat 8:20</ref></char></note>poze kay.</para>
  <para style="q1" vid="PSA 104:12">Yo va leve vwa yo pami branch bwa yo.<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>Li awoze mòn yo soti nan chanm anwo yo.</para>
  <para style="q1" vid="PSA 104:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">104:13 </char>
      <char style="xt" closed="false">
        <ref loc="JER 10:13">Jr 10:13</ref>
      </char>
    </note>Latè satisfè avèk fwi a zèv Li yo.<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>Li fè <note caller="+" style="x"><char style="xo" closed="false">104:14 </char><char style="xt" closed="false"><ref loc="JOB 38:27">Job 38:27</ref></char></note>zèb grandi pou bèt yo e vèdi</para>
  <para style="q1" vid="PSA 104:14">pou zèv a lòm nan,</para>
  <para style="q1" vid="PSA 104:14">pou li kab fè manje sòti nan tè a,<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>e diven ki fè kè a lòm kontan an,</para>
  <para style="q1" vid="PSA 104:15">pou li kab fè figi li klere ak lwil,</para>
  <para style="q1" vid="PSA 104:15">ak manje ki <note caller="+" style="x"><char style="xo" closed="false">104:15 </char><char style="xt" closed="false"><ref loc="GEN 18:5">Jen 18:5</ref></char></note>bay soutyen a kè lòm nan.<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>Pyebwa a SENYÈ yo bwè dlo jiskaske yo plen,</para>
  <para style="q1" vid="PSA 104:16">pye sèd Liban ke Li te plante yo,<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>kote zwazo yo fè nich yo.</para>
  <para style="q1" vid="PSA 104:17">Sigòy ki fè kay li nan pye sipre yo.<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>Mòn wo yo se pou kabrit mawon yo.</para>
  <para style="q1" vid="PSA 104:18">Gwo falèz yo se yon kote pou <note caller="+" style="x"><char style="xo" closed="false">104:18 </char><char style="xt" closed="false"><ref loc="LEV 11:5">Lev 11:5</ref> </char></note>daman yo kache.<verse eid="PSA 104:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>Li te fè lalin nan <note caller="+" style="x"><char style="xo" closed="false">104:19 </char><char style="xt" closed="false"><ref loc="GEN 1:14">Jen 1:14</ref></char></note>pou sezon yo.</para>
  <para style="q1" vid="PSA 104:19">Solèy la konnen plas kote pou l vin kouche a.<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>Ou te chwazi tenèb la e li te devni lannwit,</para>
  <para style="q1" vid="PSA 104:20">pou tout <note caller="+" style="x"><char style="xo" closed="false">104:20 </char><char style="xt" closed="false"><ref loc="PSA 50:10">Sòm 50:10</ref></char></note>bèt forè yo mache toupatou.<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>Jenn lyon yo rele fò dèyè viktim yo,</para>
  <para style="q1" vid="PSA 104:21">e <note caller="+" style="x"><char style="xo" closed="false">104:21 </char><char style="xt" closed="false"><ref loc="PSA 145:15">Sòm 145:15</ref></char></note>chache manje yo nan men Bondye.<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>Solèy la vin leve.</para>
  <para style="q1" vid="PSA 104:22">Yo retire yo pou ale kouche nan <note caller="+" style="x"><char style="xo" closed="false">104:22 </char><char style="xt" closed="false"><ref loc="JOB 37:8">Job 37:8</ref></char></note>tanyè yo.<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>Lòm ale fè <note caller="+" style="x"><char style="xo" closed="false">104:23 </char><char style="xt" closed="false"><ref loc="GEN 3:19">Jen 3:19</ref></char></note>travay li.</para>
  <para style="q1" vid="PSA 104:23">Li fè fòs jis lannwit rive.<verse eid="PSA 104:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>O SENYÈ, a la zèv Ou yo anpil!</para>
  <para style="q1" vid="PSA 104:24">Nan sajès, Ou te fè tout bagay.</para>
  <para style="q1" vid="PSA 104:24">Latè ranpli ak byen Ou yo.<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>Genyen <note caller="+" style="x"><char style="xo" closed="false">104:25 </char><char style="xt" closed="false"><ref loc="PSA 8:8">Sòm 8:8</ref></char></note>lanmè, gran e vast.</para>
  <para style="q1" vid="PSA 104:25">Ladann, gen gwo ekip pwason ki pa kab menm konte</para>
  <para style="q1" vid="PSA 104:25">gwo bèt, kòn ti bèt.<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>Genyen gwo bato k ap pase ladann, ak</para>
  <para style="q1" vid="PSA 104:26">levyatan ke Ou te fòme pou fè spò ladann nan.<verse eid="PSA 104:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>Yo tout ap tann Ou pou <note caller="+" style="x"><char style="xo" closed="false">104:27 </char><char style="xt" closed="false"><ref loc="JOB 36:31">Job 36:31</ref></char></note>bay yo manje nan lè yo.<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>Ou bay yo, e yo ranmase li.</para>
  <para style="q1" vid="PSA 104:28">Ou <note caller="+" style="x"><char style="xo" closed="false">104:28 </char><char style="xt" closed="false"><ref loc="PSA 145:16">Sòm 145:16</ref></char></note>ouvri men Ou, e yo satisfè ak bonte.<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>Ou kache figi Ou, e yo chagren nèt.</para>
  <para style="q1" vid="PSA 104:29">Ou retire <note caller="+" style="x"><char style="xo" closed="false">104:29 </char><char style="xt" closed="false"><ref loc="GEN 3:19">Jen 3:19</ref></char></note>lespri yo; yo mouri e yo retounen nan pousyè yo.<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>Ou voye <note caller="+" style="x"><char style="xo" closed="false">104:30 </char><char style="xt" closed="false"><ref loc="JOB 33:4">Job 33:4</ref></char></note>Lespri Ou deyò; yo vin kreye.</para>
  <para style="q1" vid="PSA 104:30">Konsa, Ou renouvle fas tè a.<verse eid="PSA 104:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>Kite <note caller="+" style="x"><char style="xo" closed="false">104:31 </char><char style="xt" closed="false"><ref loc="PSA 86:12">Sòm 86:12</ref></char></note>glwa SENYÈ a dire jis pou tout tan.</para>
  <para style="q1" vid="PSA 104:31">Kite SENYÈ a rejwi nan zèv Li yo.<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>Li gade tè a e tè a vin <note caller="+" style="x"><char style="xo" closed="false">104:32 </char><char style="xt" closed="false"><ref loc="HAB 3:10">Hab 3:10</ref></char></note>tranble.</para>
  <para style="q1" vid="PSA 104:32">Li touche mòn yo e yo fè lafimen.<verse eid="PSA 104:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>Mwen va chante a SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">104:33 </char><char style="xt" closed="false"><ref loc="PSA 63:4">Sòm 63:4</ref></char></note>toutotan ke m ap viv.</para>
  <para style="q1" vid="PSA 104:33">Mwen va chante lwanj a Bondye mwen an toutotan ke m la.<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>Kite <note caller="+" style="x"><char style="xo" closed="false">104:34 </char><char style="xt" closed="false"><ref loc="PSA 19:4">Sòm 19:4</ref></char></note>refleksyon mwen yo fè L plezi.</para>
  <para style="q1" vid="PSA 104:34">Pou kont mwen, mwen va kontan nan SENYÈ a.<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>Kite pechè yo vin disparèt sou tè a,</para>
  <para style="q1" vid="PSA 104:35">E <note caller="+" style="x"><char style="xo" closed="false">104:35 </char><char style="xt" closed="false"><ref loc="PSA 37:10">Sòm 37:10</ref></char></note>mechan yo vin pa la ankò.</para>
  <para style="q1" vid="PSA 104:35">Beni SENYÈ a, O nanm mwen.</para>
  <para style="q1" vid="PSA 104:35">Bay SENYÈ a lwanj!<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>O bay remèsiman a SENYÈ a! Rele non Li!</para>
  <para style="q1" vid="PSA 105:1">Fè zèv Li yo <note caller="+" style="x"><char style="xo" closed="false">105:1 </char><char style="xt" closed="false"><ref loc="PSA 145:12">Sòm 145:12</ref></char></note>rekonèt pami pèp yo.<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>Chante a Li menm. Chante lwanj a Li.</para>
  <para style="q1" vid="PSA 105:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">105:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:12">Sòm 77:12</ref>
      </char>
    </note>Pale sou tout mèvèy Li yo.<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>Bay non Li glwa!</para>
  <para style="q1" vid="PSA 105:3">Kite <note caller="+" style="x"><char style="xo" closed="false">105:3 </char><char style="xt" closed="false"><ref loc="PSA 33:21">Sòm 33:21</ref></char></note> kè a sila ki chache SENYÈ yo vin kontan.<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>Chache SENYÈ a ak fòs Li.</para>
  <para style="q1" vid="PSA 105:4">
    <note caller="+" style="x">
      <char style="xo" closed="false">105:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:8">Sòm 27:8</ref>
      </char>
    </note>Chache fas Li san rete.<verse eid="PSA 105:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>Sonje mèvèy ke Li te fè yo,</para>
  <para style="q1" vid="PSA 105:5">mirak Li yo avèk <note caller="+" style="x"><char style="xo" closed="false">105:5 </char><char style="xt" closed="false"><ref loc="PSA 119:13">Sòm 119:13</ref></char></note>jijman ke bouch Li te pale yo.<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>O jèm Abraham, sèvitè Li a, O fis Jacob la,</para>
  <para style="q1" vid="PSA 105:6">sila ke Li te <note caller="+" style="x"><char style="xo" closed="false">105:6 </char><char style="xt" closed="false"><ref loc="1CH 16:13">I Kwo 16:13</ref></char></note>chwazi yo!<verse eid="PSA 105:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>Li se SENYÈ a, Bondye nou an.</para>
  <para style="q1" vid="PSA 105:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">105:7 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 26:9">És 26:9</ref>
      </char>
    </note>Jijman Li yo nan tout latè.<verse eid="PSA 105:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>Li te sonje akò Li a jis pou tout tan,</para>
  <para style="q1" vid="PSA 105:8">pawòl ke Li te pase lòd bay pandan <note caller="+" style="x"><char style="xo" closed="false">105:8 </char><char style="xt" closed="false"><ref loc="DEU 7:9">Det 7:9</ref></char></note>mil jenerasyon.<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>Akò ke Li te fè avèk Abraham nan,</para>
  <para style="q1" vid="PSA 105:9">ak <note caller="+" style="x"><char style="xo" closed="false">105:9 </char><char style="xt" closed="false"><ref loc="GEN 26:3">Jen 26:3</ref></char></note>sèman ke Li te fè avèk Isaac la.<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>Li te <note caller="+" style="x"><char style="xo" closed="false">105:10 </char><char style="xt" closed="false"><ref loc="GEN 28:13-15">Jen 28:13-15</ref></char></note>konfime li a Jacob kon yon règleman,</para>
  <para style="q1" vid="PSA 105:10">a Israël kon yon akò ki la pou tout tan.<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>Konsa Li te di: “A ou menm, Mwen va bay peyi</para>
  <para style="q1" vid="PSA 105:11">Canaan kon <note caller="+" style="x"><char style="xo" closed="false">105:11 </char><char style="xt" closed="false"><ref loc="JOS 23:4">Jos 23:4</ref></char></note>pòsyon eritaj ou,”<verse eid="PSA 105:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>Sa te fèt lè se te sèlman kèk grenn moun ke yo te ye,</para>
  <para style="q1" vid="PSA 105:12">pa anpil menm, mele ak moun <note caller="+" style="x"><char style="xo" closed="false">105:12 </char><char style="xt" closed="false"><ref loc="GEN 23:4">Jen 23:4</ref></char></note>etranje yo ladann l.<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>Yo t ap mache toupatou</para>
  <para style="q1" vid="PSA 105:13">soti nan yon nasyon pou rive nan yon lòt,</para>
  <para style="q1" vid="PSA 105:13">soti nan yon wayòm pou rive kote yon lòt pèp.<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>Li <note caller="+" style="x"><char style="xo" closed="false">105:14 </char><char style="xt" closed="false"><ref loc="GEN 20:7">Jen 20:7</ref></char></note>pa t kite pèsòn peze yo.</para>
  <para style="q1" vid="PSA 105:14">Wi, Li te repwoche wa yo pou koz a yo menm:<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">105:15 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 26:11">Jen 26:11</ref>
      </char>
    </note>“Pa touche onksyone mwen yo!</para>
  <para style="q1" vid="PSA 105:15">Pa fè pwofèt Mwen yo okenn mal!”<verse eid="PSA 105:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>Li te <note caller="+" style="x"><char style="xo" closed="false">105:16 </char><char style="xt" closed="false"><ref loc="GEN 41:54">Jen 41:54</ref></char></note>rele gwo grangou rive nan peyi a.</para>
  <para style="q1" vid="PSA 105:16">Li te kraze sous pen an nèt.<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>Li te voye yon nonm devan yo, Joseph ki te vann kon esklav.<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>Yo te aflije <note caller="+" style="x"><char style="xo" closed="false">105:18 </char><char style="xt" closed="false"><ref loc="GEN 39:20">Jen 39:20</ref></char></note>pye li ak chenn.</para>
  <para style="q1" vid="PSA 105:18">Joseph, pou kont li, te kouche nan fè yo,<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>jiskaske pawòl li te vin acheve.</para>
  <para style="q1" vid="PSA 105:19">
    <note caller="+" style="x">
      <char style="xo" closed="false">105:19 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 40:20">Jen 40:20</ref>
      </char>
    </note>Pawòl SENYÈ a te fè l kanpe janm.<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">105:20 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:14">Jen 41:14</ref>
      </char>
    </note>Wa a te voye lage li.</para>
  <para style="q1" vid="PSA 105:20">Dirijan a pèp la menm, te bay li libète.<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>Li te <note caller="+" style="x"><char style="xo" closed="false">105:21 </char><char style="xt" closed="false"><ref loc="GEN 41:40-44">Jen 41:40-44</ref></char></note>fè li mèt lakay li ak chèf sou tout byen li yo,<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>pou mete prens li yo nan prizon lè l te pito,</para>
  <para style="q1" vid="PSA 105:22">pou l te kab enstwi ansyen sa yo sajès.<verse eid="PSA 105:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>Israël osi te rive an Égypte.</para>
  <para style="q1" vid="PSA 105:23">Konsa Jacob te <note caller="+" style="x"><char style="xo" closed="false">105:23 </char><char style="xt" closed="false"><ref loc="ACT 13:7">Trav 13:7</ref> </char></note>vin demere nan peyi Cham nan.<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>SENYÈ a te fè pèp pa Li vin peple anpil.</para>
  <para style="q1" vid="PSA 105:24">Li te <note caller="+" style="x"><char style="xo" closed="false">105:24 </char><char style="xt" closed="false"><ref loc="EXO 1:7-9">Egz 1:7-9</ref></char></note>fè yo vin pifò ke advèsè yo.<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>Li te <note caller="+" style="x"><char style="xo" closed="false">105:25 </char><char style="xt" closed="false"><ref loc="EXO 1:8">Egz 1:8</ref></char></note>vire kè yo pou yo rayi pèp Li a,</para>
  <para style="q1" vid="PSA 105:25">pou yo aji ak gwo mechanste avèk sèvitè Li yo.<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>Li te <note caller="+" style="x"><char style="xo" closed="false">105:26 </char><char style="xt" closed="false"><ref loc="EXO 3:10">Egz 3:10</ref></char></note> voye Moïse, sèvitè Li a,</para>
  <para style="q1" vid="PSA 105:26">avèk Aaron ke Li te chwazi.<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>Yo te <note caller="+" style="x"><char style="xo" closed="false">105:27 </char><char style="xt" closed="false"><ref loc="PSA 78:43-51">Sòm 78:43-51</ref></char></note>fè zèv mèvèy Li yo pami yo,</para>
  <para style="q1" vid="PSA 105:27">avèk mirak nan peyi Cham yo.<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>Li te <note caller="+" style="x"><char style="xo" closed="false">105:28 </char><char style="xt" closed="false"><ref loc="EXO 10:21-22">Egz 10:21-22</ref></char></note>voye tenèb e te fè l fènwa.</para>
  <para style="q1" vid="PSA 105:28">Epi yo pa t fè rebèl kont pawòl Li yo.<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>Li te <note caller="+" style="x"><char style="xo" closed="false">105:29 </char><char style="xt" closed="false"><ref loc="EXO 7:20-21">Egz 7:20-21</ref></char></note>fè dlo yo devni san</para>
  <para style="q1" vid="PSA 105:29">e te fè pwason yo mouri.<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>Peyi yo te ranvaye avèk <note caller="+" style="x"><char style="xo" closed="false">105:30 </char><char style="xt" closed="false"><ref loc="EXO 8:6">Egz 8:6</ref></char></note>krapo,</para>
  <para style="q1" vid="PSA 105:30">menm jis rive nan chanm a wa yo.<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>Li te pale e te vin rive yon <note caller="+" style="x"><char style="xo" closed="false">105:31 </char><char style="xt" closed="false"><ref loc="EXO 8:16-21">Egz 8:16-21</ref></char></note>epidemi</para>
  <para style="q1" vid="PSA 105:31">mouch yo, ak vèmin nan tout teritwa yo.<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>Li te bay yo <note caller="+" style="x"><char style="xo" closed="false">105:32 </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">Egz 9:23-25</ref></char></note>lagrèl pou lapli,</para>
  <para style="q1" vid="PSA 105:32">avèk dife brile nan peyi yo.<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>Li te frape fè desann tout chan fwi yo e</para>
  <para style="q1" vid="PSA 105:33">te kraze fann pyebwa nan teritwa yo.<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>Li te pale e <note caller="+" style="x"><char style="xo" closed="false">105:34 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">Egz 10:12-15</ref></char></note>krikèt volan yo te vini.</para>
  <para style="q1" vid="PSA 105:34">Ak jenn krikèt san kontwòl.<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>Yo te manje tout sa ki te vèt nan peyi yo,</para>
  <para style="q1" vid="PSA 105:35">e te manje fwi a teren yo.<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>Anplis, Li te frape touye tout premye ne nan peyi yo,</para>
  <para style="q1" vid="PSA 105:36">
    <note caller="+" style="x">
      <char style="xo" closed="false">105:36 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 49:3">Jen 49:3</ref> </char>
    </note>premye fwi a fòs yo.<verse eid="PSA 105:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>Li te fè yo sòti ak <note caller="+" style="x"><char style="xo" closed="false">105:37 </char><char style="xt" closed="false"><ref loc="EXO 12:35-36">Egz 12:35-36</ref></char></note>ajan ak lò.</para>
  <para style="q1" vid="PSA 105:37">Pami pèp Li yo, pa t gen yon grenn ki te tonbe.<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>Égypte te <note caller="+" style="x"><char style="xo" closed="false">105:38 </char><char style="xt" closed="false"><ref loc="EXO 12:33">Egz 12:33</ref></char></note>kontan lè yo te sòti,</para>
  <para style="q1" vid="PSA 105:38">paske laperèz yo te fin tonbe sou yo.<verse eid="PSA 105:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>Li te louvri yon <note caller="+" style="x"><char style="xo" closed="false">105:39 </char><char style="xt" closed="false"><ref loc="EXO 13:21">Egz 13:21</ref></char></note>nwaj kon kouvèti,</para>
  <para style="q1" vid="PSA 105:39">avèk dife ki pou klere nan nwit la.<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>Yo te mande e li te pote zòtolan pou</para>
  <para style="q1" vid="PSA 105:40">te satisfè yo avèk <note caller="+" style="x"><char style="xo" closed="false">105:40 </char><char style="xt" closed="false"><ref loc="EXO 16:15">Egz 16:15</ref> </char></note>pen syèl la.<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>Li te ouvri wòch la e <note caller="+" style="x"><char style="xo" closed="false">105:41 </char><char style="xt" closed="false"><ref loc="EXO 17:6">Egz 17:6</ref></char></note>dlo te sòti ladann.</para>
  <para style="q1" vid="PSA 105:41">Li te koule kote sèch yo tankou yon rivyè.<verse eid="PSA 105:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>Li te <note caller="+" style="x"><char style="xo" closed="false">105:42 </char><char style="xt" closed="false"><ref loc="GEN 15:13-14">Jen 15:13-14</ref></char></note>sonje pawòl sen Li yo avèk Abraham, sèvitè Li a.<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>Konsa, Li te mennen fè sòti pèp Li a avèk jwa,</para>
  <para style="q1" vid="PSA 105:43">sila ke Li te chwazi avèk <note caller="+" style="x"><char style="xo" closed="false">105:43 </char><char style="xt" closed="false"><ref loc="EXO 15:1">Egz 15:1</ref></char></note>gwo kri ak kè kontan yo.<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>Li te <note caller="+" style="x"><char style="xo" closed="false">105:44 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">Jos 11:16-23</ref></char></note>bay yo, anplis, peyi a nasyon yo,</para>
  <para style="q1" vid="PSA 105:44">Pou yo ta pran posesyon a zèv a pèp yo,<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>pou yo te kab <note caller="+" style="x"><char style="xo" closed="false">105:45 </char><char style="xt" closed="false"><ref loc="DEU 4:1-40">Det 4:1-40</ref></char></note>kenbe règleman Li yo, e swiv lwa Li yo.</para>
  <para style="q1" vid="PSA 105:45">Louwe SENYÈ a!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>Louwe SENYÈ la!</para>
  <para style="q1" vid="PSA 106:1">O bay remèsiman a SENYÈ a, paske Li bon,</para>
  <para style="q1" vid="PSA 106:1">paske <note caller="+" style="x"><char style="xo" closed="false">106:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34-41">I Kwo 16:34-41</ref></char></note>lanmou dous Li an se pou tout tan.<verse eid="PSA 106:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>Se kilès ki kab pale sou zèv pwisan a SENYÈ yo,</para>
  <para style="q1" vid="PSA 106:2">Oswa fè vin parèt tout lwanj Li yo?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>A la beni sila ki <note caller="+" style="x"><char style="xo" closed="false">106:3 </char><char style="xt" closed="false"><ref loc="PSA 15:2">Sòm 15:2</ref></char></note>kenbe jistis yo beni.</para>
  <para style="q1" vid="PSA 106:3">Beni se sila ki pratike ladwati nan tout tan yo!<verse eid="PSA 106:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>Sonje mwen, O SENYÈ, nan <note caller="+" style="x"><char style="xo" closed="false">106:4 </char><char style="xt" closed="false"><ref loc="PSA 44:3">Sòm 44:3</ref></char></note>favè Ou anvè pèp Ou a.</para>
  <para style="q1" vid="PSA 106:4">Vizite mwen avèk sali Ou,<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>pou m kab wè sila ke Ou te chwazi yo <note caller="+" style="x"><char style="xo" closed="false">106:5 </char><char style="xt" closed="false"><ref loc="PSA 1:3">Sòm 1:3</ref></char></note>byen reyisi;</para>
  <para style="q1" vid="PSA 106:5">pou m kab rejwi nan kè kontan a nasyon Ou an,</para>
  <para style="q1" vid="PSA 106:5">pou m ka bay glwa de eritaj Ou.<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>Nou te peche menm jan <note caller="+" style="x"><char style="xo" closed="false">106:6 </char><char style="xt" closed="false"><ref loc="2CH 30:7">II Kwo 30:7</ref> </char></note>ak papa zansèt nou yo.</para>
  <para style="q1" vid="PSA 106:6">Nou te fè inikite; nou te aji mal.<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>Papa zansèt nou yo an Égypte pa t konprann mèvèy Ou yo.</para>
  <para style="q1" vid="PSA 106:7">Yo pa t sonje lamou dous Ou,</para>
  <para style="q1" vid="PSA 106:7">men yo te <note caller="+" style="x"><char style="xo" closed="false">106:7 </char><char style="xt" closed="false"><ref loc="EXO 14:11-12">Egz 14:11-12</ref></char></note>fè rebèl bò lanmè a, nan Lanmè Wouj la.<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>Sepandan, Li te sove yo pou koz non Li,</para>
  <para style="q1" vid="PSA 106:8">pou L te kab <note caller="+" style="x"><char style="xo" closed="false">106:8 </char><char style="xt" closed="false"><ref loc="EXO 9:16">Egz 9:16</ref> </char></note>fè pwisans Li rekonèt.<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>Konsa, Li te repwoche Lanmè Wouj, e li te vin sèch,</para>
  <para style="q1" vid="PSA 106:9">Li te <note caller="+" style="x"><char style="xo" closed="false">106:9 </char><char style="xt" closed="false"><ref loc="ISA 63:11-13">És 63:11-13</ref></char></note>mennen yo pase nan fon yo,</para>
  <para style="q1" vid="PSA 106:9">menm jan yo te pase nan dezè a.<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>Konsa, Li te <note caller="+" style="x"><char style="xo" closed="false">106:10 </char><char style="xt" closed="false"><ref loc="EXO 14:30">Egz 14:30</ref></char></note>sove yo depi nan men a sila ki te rayi yo,</para>
  <para style="q1" vid="PSA 106:10">e te rachte yo soti nan men a lènmi an.<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">106:11 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:27-28">Egz 14:27-28</ref>
      </char>
    </note>Dlo yo te kouvri advèsè yo.</para>
  <para style="q1" vid="PSA 106:11">Nanpwen nan yo ki te rete.<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>Nan lè sa a, yo te kwè nan pawòl Li yo.</para>
  <para style="q1" vid="PSA 106:12">Yo te chante lwanj Li.<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>Men byen vit, yo te <note caller="+" style="x"><char style="xo" closed="false">106:13 </char><char style="xt" closed="false"><ref loc="EXO 15:24">Egz 15:24</ref></char></note>bliye zèv Li yo.</para>
  <para style="q1" vid="PSA 106:13">Yo pa t tann konsèy Li,<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>men yo te vin gen <note caller="+" style="x"><char style="xo" closed="false">106:14 </char><char style="xt" closed="false"><ref loc="NUM 11:4">Nonb 11:4</ref></char></note>gwo anvi nan savann nan,</para>
  <para style="q1" vid="PSA 106:14">e te pase Bondye a leprèv nan dezè a.<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>Pou sa, Li te <note caller="+" style="x"><char style="xo" closed="false">106:15 </char><char style="xt" closed="false"><ref loc="NUM 11:31">Nonb 11:31</ref></char></note>ba yo sa yo te mande a,</para>
  <para style="q1" vid="PSA 106:15">men te voye yon maladi epwizan pami yo.<verse eid="PSA 106:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>Yo te vin <note caller="+" style="x"><char style="xo" closed="false">106:16 </char><char style="xt" closed="false"><ref loc="NUM 16:1-3">Nonb 16:1-3</ref></char></note>jalou a Moïse nan kan an,</para>
  <para style="q1" vid="PSA 106:16">ak Aaron, fidèl sen a SENYÈ a.<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>Akòz sa a,<note caller="+" style="x"><char style="xo" closed="false">106:17 </char><char style="xt" closed="false"><ref loc="NUM 16:32">Nonb 16:32</ref></char></note>tè la te louvri vale Dathan,</para>
  <para style="q1" vid="PSA 106:17">epi te anglouti tout konpanyen Abiram yo.<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>Konsa, yon gwo <note caller="+" style="x"><char style="xo" closed="false">106:18 </char><char style="xt" closed="false"><ref loc="NUM 16:35">Nonb 16:35</ref></char></note>dife te vin monte nan mitan konpanyen yo.</para>
  <para style="q1" vid="PSA 106:18">Flanm nan te manje mechan yo.<verse eid="PSA 106:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>Yo te <note caller="+" style="x"><char style="xo" closed="false">106:19 </char><char style="xt" closed="false"><ref loc="EXO 32:4">Egz 32:4</ref></char></note>fè yon jèn bèf nan Horeb.</para>
  <para style="q1" vid="PSA 106:19">Yo te adore yon imaj fonn.<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>Yo te <note caller="+" style="x"><char style="xo" closed="false">106:20 </char><char style="xt" closed="false"><ref loc="JER 2:11">Jr 2:11</ref></char></note>fè echanj glwa yo pou imaj a yon bèf ki manje zèb.<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>Yo te <note caller="+" style="x"><char style="xo" closed="false">106:21 </char><char style="xt" closed="false"><ref loc="PSA 78:11">Sòm 78:11</ref></char></note>bliye Bondye, sovè yo a,</para>
  <para style="q1" vid="PSA 106:21">ki te fè gwo bagay an Égypte yo,<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">106:22 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:27">Sòm 105:27</ref>
      </char>
    </note>mèvèy nan peyi Cham yo, ak bagay mèvèy bò Lanmè Wouj la.<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>Akoz sa, Li te di Li ta detwi yo,</para>
  <para style="q1" vid="PSA 106:23">men se te <note caller="+" style="x"><char style="xo" closed="false">106:23 </char><char style="xt" closed="false"><ref loc="EXO 32:11-14">Egz 32:11-14</ref></char></note>Moïse ki te kanpe nan brèch la devan Li,</para>
  <para style="q1" vid="PSA 106:23">pou detounen kòlè Li pou l pa t detwi yo.<verse eid="PSA 106:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>Alò, yo te meprize bèl peyi a.</para>
  <para style="q1" vid="PSA 106:24">Yo <note caller="+" style="x"><char style="xo" closed="false">106:24 </char><char style="xt" closed="false"><ref loc="DEU 1:32">Det 1:32</ref></char></note>pa t kwè nan pawòl Li,<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>men te <note caller="+" style="x"><char style="xo" closed="false">106:25 </char><char style="xt" closed="false"><ref loc="NUM 14:2">Nonb 14:2</ref></char></note>plenyen nan tant yo.</para>
  <para style="q1" vid="PSA 106:25">Yo pa t koute vwa SENYÈ a.<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>Akoz sa, Li te <note caller="+" style="x"><char style="xo" closed="false">106:26 </char><char style="xt" closed="false"><ref loc="NUM 14:28-35">Nonb 14:28-35</ref></char></note>sèmante a yo ke Li ta jete yo nan dezè a,<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>ke Li ta voye desandan yo pami nasyon yo,</para>
  <para style="q1" vid="PSA 106:27">e <note caller="+" style="x"><char style="xo" closed="false">106:27 </char><char style="xt" closed="false"><ref loc="LEV 26:33">Lev 26:33</ref> </char></note>gaye yo nan peyi yo.<verse eid="PSA 106:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>Yo te vin <note caller="+" style="x"><char style="xo" closed="false">106:28 </char><char style="xt" closed="false"><ref loc="NUM 25:3">Nonb 25:3</ref></char></note>jwenn yo menm, anplis, ak Baal-Peor,</para>
  <para style="q1" vid="PSA 106:28">pou manje sakrifis ki te ofri a mò yo.<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>Konsa, yo te <note caller="+" style="x"><char style="xo" closed="false">106:29 </char><char style="xt" closed="false"><ref loc="NUM 25:4">Nonb 25:4</ref></char></note>pwovoke Li a lakòlè ak zèv yo.</para>
  <para style="q1" vid="PSA 106:29">E yon epidemi te kase vin parèt nan mitan yo.<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>Epi Phinées <note caller="+" style="x"><char style="xo" closed="false">106:30 </char><char style="xt" closed="false"><ref loc="NUM 25:7">Nonb 25:7</ref></char></note>te kanpe pou te entèsede,</para>
  <para style="q1" vid="PSA 106:30">epi epidemi an te vin sispann.<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>Sa a te <note caller="+" style="x"><char style="xo" closed="false">106:31 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Jen 15:6</ref></char></note>konte a li menm kon ladwati,</para>
  <para style="q1" vid="PSA 106:31">pou tout jenerasyon yo jis pou tout tan.<verse eid="PSA 106:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>Anplis, yo te <note caller="+" style="x"><char style="xo" closed="false">106:32 </char><char style="xt" closed="false"><ref loc="NUM 20:2-13">Nonb 20:2-13</ref></char></note>pwovoke Li a lakòlè bò dlo Meriba yo,</para>
  <para style="q1" vid="PSA 106:32">Jiskaske sa te sòti byen mal pou Moïse sou kont yo.<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>Akoz yo te <note caller="+" style="x"><char style="xo" closed="false">106:33 </char><char style="xt" closed="false"><ref loc="NUM 20:3-10">Nonb 20:3-10</ref></char></note>fè rebèl kont Lespri Li a,</para>
  <para style="q1" vid="PSA 106:33">Li te pale san reflechi avèk lèv li.<verse eid="PSA 106:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>Yo pa t detwi lòt pèp yo, jan <note caller="+" style="x"><char style="xo" closed="false">106:34 </char><char style="xt" closed="false"><ref loc="DEU 7:2-16">Det 7:2-16</ref></char></note>SENYÈ a te kòmande yo a,<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>men <note caller="+" style="x"><char style="xo" closed="false">106:35 </char><char style="xt" closed="false"><ref loc="JDG 3:5-6">Jij 3:5-6</ref></char></note>yo te fè melanj ak nasyon yo.</para>
  <para style="q1" vid="PSA 106:35">Yo te aprann abitid yo.<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>Yo te sèvi zidòl yo, <note caller="+" style="x"><char style="xo" closed="false">106:36 </char><char style="xt" closed="false"><ref loc="DEU 7:16">Det 7:16</ref></char></note>ki te devni yon pèlen pou yo.<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>Se te menm pwòp fi ak fis yo ke yo <note caller="+" style="x"><char style="xo" closed="false">106:37 </char><char style="xt" closed="false"><ref loc="DEU 12:31">Det 12:31</ref></char></note>ofri kon sakrifis a dyab yo.<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>Yo te vèse san inosan, san a pwop <note caller="+" style="x"><char style="xo" closed="false">106:38 </char><char style="xt" closed="false"><ref loc="DEU 18:10">Det 18:10</ref></char></note>fis ak fi yo,</para>
  <para style="q1" vid="PSA 106:38">ke yo te bay kon sakrifis a zidòl Canaan yo.</para>
  <para style="q1" vid="PSA 106:38">Peyi a te kontamine nèt ak san.<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>Konsa, yo te vin <note caller="+" style="x"><char style="xo" closed="false">106:39 </char><char style="xt" closed="false"><ref loc="LEV 18:24">Lev 18:24</ref></char></note>pa pwòp nan abitid yo,</para>
  <para style="q1" vid="PSA 106:39">e te jwe pwostitiye nan zèv yo.<verse eid="PSA 106:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>Akoz sa, kòlè SENYÈ a te limen kont pèp Li a.</para>
  <para style="q1" vid="PSA 106:40">Li te vin rayi eritaj Li a.<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>Konsa, <note caller="+" style="x"><char style="xo" closed="false">106:41 </char><char style="xt" closed="false"><ref loc="JDG 4:3">Jij 4:3</ref></char></note>Li te bay yo nan men a nasyon yo,</para>
  <para style="q1" vid="PSA 106:41">pou sila ki te rayi yo vin renye sou yo.<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>Lènmi yo, anplis, te oprime yo,</para>
  <para style="q1" vid="PSA 106:42">e yo te oblije soumèt anba pouvwa yo.<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>Anpil fwa, Li te delivre yo.</para>
  <para style="q1" vid="PSA 106:43">Malgre, yo menm te plen rebelyon nan konsèy yo,</para>
  <para style="q1" vid="PSA 106:43">e te plonje desann nan inikite yo.<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>Sepandan, Li te gade twoub yo lè Li te <note caller="+" style="x"><char style="xo" closed="false">106:44 </char><char style="xt" closed="false"><ref loc="JDG 3:9">Jij 3:9</ref></char></note>tande kri yo.<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>Li te vin <note caller="+" style="x"><char style="xo" closed="false">106:45 </char><char style="xt" closed="false"><ref loc="LEV 26:42">Lev 26:42</ref></char></note>sonje akò Li pou koz yo menm,</para>
  <para style="q1" vid="PSA 106:45">e te vin ralanti selon grandè lanmou dous Li a.<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>Anplis, Li te fè yo <note caller="+" style="x"><char style="xo" closed="false">106:46 </char><char style="xt" closed="false"><ref loc="1KI 8:50">I Wa 8:50</ref></char></note>resevwa mizerikòd Li,</para>
  <para style="q1" vid="PSA 106:46">menm nan men a tout nasyon ki te fè yo prizonye yo.<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">106:47 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:35-36">I Kwo 16:35-36</ref>
      </char>
    </note>Sove nou, O SENYÈ, Bondye nou an.</para>
  <para style="q1" vid="PSA 106:47">Ranmase nou pami nasyon yo,</para>
  <para style="q1" vid="PSA 106:47">pou bay remèsiman a non sen Ou an,</para>
  <para style="q1" vid="PSA 106:47">avèk viktwa ki sòti nan lwanj Ou yo.<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">106:48 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 41:13">Sòm 41:13</ref>
      </char>
    </note>Beni se SENYÈ a, Bondye Israël la,</para>
  <para style="q1" vid="PSA 106:48">pou tout tan jis pou tout tan.</para>
  <para style="q1" vid="PSA 106:48">Kite tout pèp la di: “Amen.”</para>
  <para style="q1" vid="PSA 106:48">Louwe SENYÈ a!<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms1">LIV 5</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>O bay remèsiman a Bondye, paske <note caller="+" style="x"><char style="xo" closed="false">107:1 </char><char style="xt" closed="false"><ref loc="2CH 5:13">II Kwo 5:13</ref></char></note>Li Bon,</para>
  <para style="q1" vid="PSA 107:1">paske lanmou dous Li dire jis pou tout tan.<verse eid="PSA 107:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>Kite <note caller="+" style="x"><char style="xo" closed="false">107:2 </char><char style="xt" closed="false"><ref loc="ISA 35:9-10">És 35:9-10</ref></char></note>rachte a SENYÈ yo pale: “Se sa!”</para>
  <para style="q1" vid="PSA 107:2">Sila ke Li fin rachte soti nan men advèsè a,<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>e te <note caller="+" style="x"><char style="xo" closed="false">107:3 </char><char style="xt" closed="false"><ref loc="DEU 30:20">Det 30:20</ref></char></note>ranmase soti nan peyi yo,</para>
  <para style="q1" vid="PSA 107:3">soti nan lès e soti nan lwès,</para>
  <para style="q1" vid="PSA 107:3">soti nan nò e soti nan sid.<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>Yo te <note caller="+" style="x"><char style="xo" closed="false">107:4 </char><char style="xt" closed="false"><ref loc="NUM 14:33">Nonb 14:33</ref></char></note>mache egare nan dezè yo.</para>
  <para style="q1" vid="PSA 107:4">Yo pa t jwenn yon vil pou yo ta rete.<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>Yo te grangou ak swaf.</para>
  <para style="q1" vid="PSA 107:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">107:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:3">Sòm 77:3</ref>
      </char>
    </note>Nanm yo te fennen anndan yo.<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>Yo te <note caller="+" style="x"><char style="xo" closed="false">107:6 </char><char style="xt" closed="false"><ref loc="PSA 50:15">Sòm 50:15</ref></char></note>kriye fò a SENYÈ a nan gran twoub yo,</para>
  <para style="q1" vid="PSA 107:6">Konsa, Li te delivre yo sòti nan twoub yo.<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>Anplis, Li te mennen yo pa yon chemen dwat,</para>
  <para style="q1" vid="PSA 107:7">pou rive nan yon vil ki deja etabli ak moun ladann.<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">107:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:15-31">Sòm 107:15-31</ref>
      </char>
    </note>Kite yo bay remèsiman a SENYÈ a pou lanmou dous Li a,</para>
  <para style="q1" vid="PSA 107:8">pou mèvèy Li yo anvè fis a lòm yo!<verse eid="PSA 107:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>Paske Li te satisfè nanm swaf la, e</para>
  <para style="q1" vid="PSA 107:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">107:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 146:7">Sòm 146:7</ref>
      </char>
    </note>nanm grangou a, Li te ranpli li ak sa ki bon.<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>Te gen sila ki te viv nan tenèb yo ak nan lonbraj lanmò yo,</para>
  <para style="q1" vid="PSA 107:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">107:10 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 36:8">Job 36:8</ref>
      </char>
    </note>Prizonye yo nan mizè ak chenn yo,<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>akoz yo te fè rebèl kont pawòl Bondye a,</para>
  <para style="q1" vid="PSA 107:11">e te meprize <note caller="+" style="x"><char style="xo" closed="false">107:11 </char><char style="xt" closed="false"><ref loc="PSA 73:24">Sòm 73:24</ref></char></note>konsèy a Pi Wo a.<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>Akoz sa, Li te imilye kè yo ak travay fòse.</para>
  <para style="q1" vid="PSA 107:12">Yo te chape tonbe e <note caller="+" style="x"><char style="xo" closed="false">107:12 </char><char style="xt" closed="false"><ref loc="PSA 22:11">Sòm 22:11</ref></char></note>pa t gen moun ki pou bay yo sekou.<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>Epi nan gwo pwoblèm yo, yo te <note caller="+" style="x"><char style="xo" closed="false">107:13 </char><char style="xt" closed="false"><ref loc="PSA 107:6">Sòm 107:6</ref></char></note>rele fò a SENYÈ a.</para>
  <para style="q1" vid="PSA 107:13">Li te delivre yo sòti nan gwo twoub yo.<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>Li te <note caller="+" style="x"><char style="xo" closed="false">107:14 </char><char style="xt" closed="false"><ref loc="PSA 86:13">Sòm 86:13</ref></char></note>mennen yo sòti nan tenèb la,</para>
  <para style="q1" vid="PSA 107:14">nan lonbraj lanmò a, e te kase chire kòd li yo.<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">107:15 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:8-31">Sòm 107:8-31</ref>
      </char>
    </note>Kite yo bay remèsiman a SENYÈ a pou</para>
  <para style="q1" vid="PSA 107:15">Lanmou dous Li a ak pou mèvèy Li yo anvè fis a lòm yo!<verse eid="PSA 107:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>Paske Li te <note caller="+" style="x"><char style="xo" closed="false">107:16 </char><char style="xt" closed="false"><ref loc="ISA 45:1-2">És 45:1-2</ref></char></note>kraze pòtay an bwonz yo,</para>
  <para style="q1" vid="PSA 107:16">e te koupe ba fè yo.<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>Yo te vin fou nèt nan rebelyon yo</para>
  <para style="q1" vid="PSA 107:17">e <note caller="+" style="x"><char style="xo" closed="false">107:17 </char><char style="xt" closed="false"><ref loc="ISA 65:6-7">És 65:6-7</ref></char></note>akoz inikite yo, yo te aflije.<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>Nanm yo te rayi tout kalite manje</para>
  <para style="q1" vid="PSA 107:18">e yo te rive toupre <note caller="+" style="x"><char style="xo" closed="false">107:18 </char><char style="xt" closed="false"><ref loc="JOB 38:17">Job 38:17</ref> </char></note>pòtay lanmò yo.<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>Konsa yo te kriye fò a SENYÈ a nan gran mizè yo,</para>
  <para style="q1" vid="PSA 107:19">e Li te sove yo sòti nan gwo pwoblèm yo.<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>Li te voye pawòl Li pou te geri yo,</para>
  <para style="q1" vid="PSA 107:20">pou te <note caller="+" style="x"><char style="xo" closed="false">107:20 </char><char style="xt" closed="false"><ref loc="JOB 33:28-30">Job 33:28-30</ref></char></note>delivre yo sòti nan destriksyon yo.<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>Kite yo bay remèsiman pou Lanmou dous Li a,</para>
  <para style="q1" vid="PSA 107:21">ak mèvèy Li yo anvè fis a lòm yo!<verse eid="PSA 107:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>Anplis, kite yo ofri <note caller="+" style="x"><char style="xo" closed="false">107:22 </char><char style="xt" closed="false"><ref loc="LEV 7:12">Lev 7:12</ref></char></note>sakrifis a remèsiman yo</para>
  <para style="q1" vid="PSA 107:22">e pale sou afè zèv Li yo ak chan lajwa.<verse eid="PSA 107:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>Sila ki <note caller="+" style="x"><char style="xo" closed="false">107:23 </char><char style="xt" closed="false"><ref loc="ISA 42:10">És 42:10</ref></char></note>desann bò kote lanmè nan bato yo,</para>
  <para style="q1" vid="PSA 107:23">ki fè komès sou gwo dlo yo,<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>yo te konn wè zèv SENYÈ yo,</para>
  <para style="q1" vid="PSA 107:24">avèk mèvèy Li yo nan gran fon an.<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>Paske Li te pale e fè leve yon gwo van tanpèt,</para>
  <para style="q1" vid="PSA 107:25">ki te <note caller="+" style="x"><char style="xo" closed="false">107:25 </char><char style="xt" closed="false"><ref loc="PSA 93:3">Sòm 93:3</ref>,<ref loc="PSA 93:4">4</ref></char></note>fè leve gwo vag lanmè yo.<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>Yo te leve jis rive nan syèl yo e te desann jis rive nan fon yo.</para>
  <para style="q1" vid="PSA 107:26">Nanm yo te <note caller="+" style="x"><char style="xo" closed="false">107:26 </char><char style="xt" closed="false"><ref loc="PSA 22:14">Sòm 22:14</ref></char></note>fann avèk mizè.<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>Yo te gaye, bite tankou moun sou.</para>
  <para style="q1" vid="PSA 107:27">Yo te fin about nèt.<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>Yo te kriye a Bondye nan mizè yo,</para>
  <para style="q1" vid="PSA 107:28">e Li te mennen yo sòti nan twoub yo.<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>Li <note caller="+" style="x"><char style="xo" closed="false">107:29 </char><char style="xt" closed="false"><ref loc="PSA 65:7">Sòm 65:7</ref></char></note>te fè tanpèt la vin kalm,</para>
  <para style="q1" vid="PSA 107:29">jiskaske vag lanmè yo te vin kalm.<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>Konsa, yo te kontan akoz yo te kalme,</para>
  <para style="q1" vid="PSA 107:30">e Li te gide yo pou rive nan pò ke yo te pito a.<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>Kite yo bay remèsiman a SENYÈ a pou lanmou dous Li a,</para>
  <para style="q1" vid="PSA 107:31">pou mèvèy Li yo anvè fis a lòm yo!<verse eid="PSA 107:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>Kite yo <note caller="+" style="x"><char style="xo" closed="false">107:32 </char><char style="xt" closed="false"><ref loc="PSA 34:3">Sòm 34:3</ref></char></note>leve L wo, anplis, nan asanble a pèp la,</para>
  <para style="q1" vid="PSA 107:32">e beni Li nan asanble ansyen yo.<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>Li <note caller="+" style="x"><char style="xo" closed="false">107:33 </char><char style="xt" closed="false"><ref loc="1KI 17:1-7">I Wa 17:1-7</ref></char></note>chanje rivyè yo vin tounen dezè,</para>
  <para style="q1" vid="PSA 107:33">e sous dlo yo an tè deseche.<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>Yon tè fètil vin tounen savann tè sale,</para>
  <para style="q1" vid="PSA 107:34">akoz mechanste a sila ki rete ladann yo.<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>Li <note caller="+" style="x"><char style="xo" closed="false">107:35 </char><char style="xt" closed="false"><ref loc="PSA 105:41">Sòm 105:41</ref></char></note>chanje dezè a vin tounen gwo sous dlo,</para>
  <para style="q1" vid="PSA 107:35">e tè deseche a an sous k ap koule.<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>Epi la, li fè moun grangou yo vin rete,</para>
  <para style="q1" vid="PSA 107:36">pou yo vin etabli <note caller="+" style="x"><char style="xo" closed="false">107:36 </char><char style="xt" closed="false"><ref loc="PSA 107:4-7">Sòm 107:4-7</ref></char></note>yon vil ki plen moun,<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>pou yo ka plante chan yo,</para>
  <para style="q1" vid="PSA 107:37">
    <note caller="+" style="x">
      <char style="xo" closed="false">107:37 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 19:29">II Wa 19:29</ref>
      </char>
    </note>plante chan rezen yo,</para>
  <para style="q1" vid="PSA 107:37">e ranmase yon gwo rekòlt.<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>Anplis, Li beni yo!</para>
  <para style="q1" vid="PSA 107:38">Yo <note caller="+" style="x"><char style="xo" closed="false">107:38 </char><char style="xt" closed="false"><ref loc="GEN 12:2">Jen 12:2</ref></char></note>miltipliye anpil,</para>
  <para style="q1" vid="PSA 107:38">e li pa kite bèt chan pa yo bese.<verse eid="PSA 107:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>Lè yo <note caller="+" style="x"><char style="xo" closed="false">107:39 </char><char style="xt" closed="false"><ref loc="2KI 10:32">II Wa 10:32</ref></char></note>vin febli, koube nèt,</para>
  <para style="q1" vid="PSA 107:39">akoz opresyon avèk mizè ak tristès,<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>Li <note caller="+" style="x"><char style="xo" closed="false">107:40 </char><char style="xt" closed="false"><ref loc="JOB 12:21">Job 12:21</ref></char></note>vide wont sou prens yo e</para>
  <para style="q1" vid="PSA 107:40">fè yo vin mache egare nan yon savann ki san chemen.<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>Men Li <note caller="+" style="x"><char style="xo" closed="false">107:41 </char><char style="xt" closed="false"><ref loc="1SA 2:8">I Sam 2:8</ref></char></note>fè malere a chita wo ansekirite,</para>
  <para style="q1" vid="PSA 107:41">byen lwen tout afliksyon,</para>
  <para style="q1" vid="PSA 107:41">e fè fanmi li yo byen pwoteje kon yon twoupo.<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>Moun <note caller="+" style="x"><char style="xo" closed="false">107:42 </char><char style="xt" closed="false"><ref loc="JOB 22:19">Job 22:19</ref></char></note>dwat yo wè l e yo kontan.</para>
  <para style="q1" vid="PSA 107:42">Men tout mechan yo fèmen bouch yo.<verse eid="PSA 107:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>Se kilès ki <note caller="+" style="x"><char style="xo" closed="false">107:43 </char><char style="xt" closed="false"><ref loc="PSA 64:9">Sòm 64:9</ref></char></note>saj? Kite li bay atansyon a bagay</para>
  <para style="q1" vid="PSA 107:43">sa yo e konsidere lanmou dous SENYÈ a.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="d">Yon chan. Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">108:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:7-11">Sòm 57:7-11</ref>
      </char>
    </note>Kè m fèm, O Bondye; mwen va chante.</para>
  <para style="q1" vid="PSA 108:1">Mwen va chante lwanj ou, menm avèk tout nanm mwen.<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>Fè leve ap avèk lir!</para>
  <para style="q1" vid="PSA 108:2">Mwen va fè leve solèy la!<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>Mwen va bay remèsiman a Ou menm, O SENYÈ, pami pèp yo.</para>
  <para style="q1" vid="PSA 108:3">Mwen va chante lwanj a Ou pami nasyon yo.<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>Paske lanmou dous Ou a gran <note caller="+" style="x"><char style="xo" closed="false">108:4 </char><char style="xt" closed="false"><ref loc="PSA 113:4">Sòm 113:4</ref></char></note>pase syèl yo,</para>
  <para style="q1" vid="PSA 108:4">e verite Ou rive jis nan syèl yo.<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">108:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:5">Sòm 57:5</ref>
      </char>
    </note>Leve wo, O Bondye, anwo syèl yo ak glwa Ou anwo tout tè a.<verse eid="PSA 108:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">108:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 60:5-12">Sòm 60:5-12</ref>
      </char>
    </note>Pou sila ke Ou tèlman renmen an, kapab delivre.</para>
  <para style="q1" vid="PSA 108:6">Sove avèk men dwat Ou e reponn mwen!<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>Bondye te pale nan sentete Li a: “Mwen va leve wo,</para>
  <para style="q1" vid="PSA 108:7">Mwen va divize Sichem, e mezire tout vale Succoth la.<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>Galaad se pou Mwen. Manassé se pa M.</para>
  <para style="q1" vid="PSA 108:8">Ephraïm se kas sou tèt Mwen.</para>
  <para style="q1" vid="PSA 108:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">108:8 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 49:10">Jen 49:10</ref>
      </char>
    </note>Juda se baton wayal Mwen.<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>Moab se basen lesiv Mwen.</para>
  <para style="q1" vid="PSA 108:9">Sou Edom, Mwen va jete soulye M.</para>
  <para style="q1" vid="PSA 108:9">Sou Philistie, Mwen va rele byen fò.”<verse eid="PSA 108:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>Se <note caller="+" style="x"><char style="xo" closed="false">108:10 </char><char style="xt" closed="false"><ref loc="PSA 60:9">Sòm 60:9</ref></char></note>kilès ki va mennen M antre nan vil fòtifye a?</para>
  <para style="q1" vid="PSA 108:10">Kilès ki va mennen M Edom?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>Se pa ke Ou, Ou menm, O Bondye, te <note caller="+" style="x"><char style="xo" closed="false">108:11 </char><char style="xt" closed="false"><ref loc="PSA 44:9">Sòm 44:9</ref></char></note>rejte nou an?</para>
  <para style="q1" vid="PSA 108:11">Èske Ou p ap sòti avèk lame nou yo, O Bondye?<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>O bannou sekou kont advèsè a,</para>
  <para style="q1" vid="PSA 108:12">paske delivrans a lòm se anven.<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>Avèk Bondye, nou va fè zèv vanyan.</para>
  <para style="q1" vid="PSA 108:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">108:13 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 60:12">És 60:12</ref>
      </char>
    </note>Se Li menm ki va foule advèsè nou yo anba pye L.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="d">Pou direktè koral la; Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>O Bondye lwanj mwen an, <note caller="+" style="x"><char style="xo" closed="false">109:1 </char><char style="xt" closed="false"><ref loc="PSA 28:1">Sòm 28:1</ref></char></note>pa rete an silans!<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>Paske yo te ouvri bouch <note caller="+" style="x"><char style="xo" closed="false">109:2 </char><char style="xt" closed="false"><ref loc="PSA 10:7">Sòm 10:7</ref></char></note>desepsyon ak mechanste a kont mwen.</para>
  <para style="q1" vid="PSA 109:2">Yo te pale kont mwen avèk yon lang k ap manti.<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>Anplis, yo te antoure mwen avèk pawòl ki plen rayisman</para>
  <para style="q1" vid="PSA 109:3">E yo te goumen kont mwen <note caller="+" style="x"><char style="xo" closed="false">109:3 </char><char style="xt" closed="false"><ref loc="PSA 35:7">Sòm 35:7</ref></char></note>san koz.<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>An echanj pou lanmou m, yo te aji kon akizatè mwen;</para>
  <para style="q1" vid="PSA 109:4">men mwen toujou ap priye.<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>Konsa, yo te rekonpanse mwen mal pou byen ak <note caller="+" style="x"><char style="xo" closed="false">109:5 </char><char style="xt" closed="false"><ref loc="JHN 7:7">Jn 7:7</ref></char></note>rayisman pou lanmou m.<verse eid="PSA 109:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>Plase yon nonm mechan sou li e kite</para>
  <para style="q1" vid="PSA 109:6">yon akizatè kanpe sou men dwat Li.<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>Lè l fin jije, kite li sòti koupab</para>
  <para style="q1" vid="PSA 109:7">e kite <note caller="+" style="x"><char style="xo" closed="false">109:7 </char><char style="xt" closed="false"><ref loc="PRO 28:9">Pwov 28:9</ref></char></note>lapriyè li devni peche.<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>Kite jou li yo vin mwens.</para>
  <para style="q1" vid="PSA 109:8">Kite <note caller="+" style="x"><char style="xo" closed="false">109:8 </char><char style="xt" closed="false"><ref loc="ACT 1:20">Trav 1:20</ref></char></note>yon lòt moun pran pozisyon li.<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>Kite pitit li yo rete san papa,</para>
  <para style="q1" vid="PSA 109:9">e kite <note caller="+" style="x"><char style="xo" closed="false">109:9 </char><char style="xt" closed="false"><ref loc="JER 18:21">Jr 18:21</ref></char></note>madanm li vin vèv.<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>Kite pitit li yo mache egare, e mande nan lari.</para>
  <para style="q1" vid="PSA 109:10">Kite yo chache yo nan kay kraze a kote yo rete.<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>Kite moun li dwe, sezi tout sa li posede</para>
  <para style="q1" vid="PSA 109:11">e etranje yo piyaje tout sa li pwodwi.<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>Kite l rive ke nanpwen moun ki pou ofri li lanmou dous,</para>
  <para style="q1" vid="PSA 109:12">Ni okenn moun ki pou fè gras a òfelen li yo.<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>Kite desandan li yo koupe retire nèt.</para>
  <para style="q1" vid="PSA 109:13">Nan jenerasyon ki swiv yo, kite <note caller="+" style="x"><char style="xo" closed="false">109:13 </char><char style="xt" closed="false"><ref loc="PSA 9:5">Sòm 9:5</ref></char></note>non yo</para>
  <para style="q1" vid="PSA 109:13">efase nèt.<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>Kite <note caller="+" style="x"><char style="xo" closed="false">109:14 </char><char style="xt" closed="false"><ref loc="EXO 20:5">Egz 20:5</ref></char></note>inikite a papa zansèt li yo vin sonje devan SENYÈ a,</para>
  <para style="q1" vid="PSA 109:14">E pa kite peche a manman l yo vin efase.<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>Kite yo devan SENYÈ a tout tan pou L</para>
  <para style="q1" vid="PSA 109:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">109:15 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 18:17">Job 18:17</ref>
      </char>
    </note>koupe retire memwa yo sou latè,<verse eid="PSA 109:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>akoz li pa t sonje montre lanmou dous,</para>
  <para style="q1" vid="PSA 109:16">men te pèsekite e te aflije malere a,</para>
  <para style="q1" vid="PSA 109:16">ak sila ki dekouraje nan kè l la,</para>
  <para style="q1" vid="PSA 109:16">pou l mete yo a lanmò.<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>Anplis, li te renmen bay madichon.</para>
  <para style="q1" vid="PSA 109:17">Konsa, <note caller="+" style="x"><char style="xo" closed="false">109:17 </char><char style="xt" closed="false"><ref loc="PRO 14:14">Pwov 14:14</ref></char></note>madichon an te retounen sou li.</para>
  <para style="q1" vid="PSA 109:17">Li pa t renmen beni.</para>
  <para style="q1" vid="PSA 109:17">Konsa, sa te rete lwen l.<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>Men li te abiye li menm ak madichon tankou vètman,</para>
  <para style="q1" vid="PSA 109:18">e sa te <note caller="+" style="x"><char style="xo" closed="false">109:18 </char><char style="xt" closed="false"><ref loc="NUM 5:22">Nonb 5:22</ref></char></note>fonse nan kò l tankou dlo, tankou lwil, sa rive nan zo li.<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>Kite sa rive li tankou yon <note caller="+" style="x"><char style="xo" closed="false">109:19 </char><char style="xt" closed="false"><ref loc="PSA 73:6">Sòm 73:6</ref></char></note>vètman k ap sèvi pou kouvri kò l,</para>
  <para style="q1" vid="PSA 109:19">paske sentiwon sa a ap toujou mare l.<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>Kite SENYÈ a bay sa kon rekonpans akizatè mwen yo,</para>
  <para style="q1" vid="PSA 109:20">ak sila ki <note caller="+" style="x"><char style="xo" closed="false">109:20 </char><char style="xt" closed="false"><ref loc="PSA 41:5">Sòm 41:5</ref></char></note>pale mal kont nanm mwen yo.<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>Men Ou menm, O Bondye, SENYÈ a,</para>
  <para style="q1" vid="PSA 109:21">aji dousman avè m <note caller="+" style="x"><char style="xo" closed="false">109:21 </char><char style="xt" closed="false"><ref loc="PSA 23:3">Sòm 23:3</ref></char></note>pou koz a non Ou.</para>
  <para style="q1" vid="PSA 109:21">Akoz lanmou dous Ou a bon, delivre m,<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>paske mwen aflije e malere.</para>
  <para style="q1" vid="PSA 109:22">Kè m blese anndan m.<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>Mwen ap pase tankou yon lonbraj ki vin long.</para>
  <para style="q1" vid="PSA 109:23">Mwen souke retire tankou <note caller="+" style="x"><char style="xo" closed="false">109:23 </char><char style="xt" closed="false"><ref loc="EXO 10:19">Egz 10:19</ref></char></note>krikèt volan.<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>Jenou m vin fèb nan fè <note caller="+" style="x"><char style="xo" closed="false">109:24 </char><char style="xt" closed="false"><ref loc="PSA 35:13">Sòm 35:13</ref></char></note>jèn</para>
  <para style="q1" vid="PSA 109:24">e chè m vin mèg, san grès.<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>Mwen menm, anplis, te vin yon repwòch a yo menm.</para>
  <para style="q1" vid="PSA 109:25">Lè yo wè m, yo <note caller="+" style="x"><char style="xo" closed="false">109:25 </char><char style="xt" closed="false"><ref loc="PSA 22:7">Sòm 22:7</ref></char></note>souke tèt yo.<verse eid="PSA 109:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">109:26 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:86">Sòm 119:86</ref>
      </char>
    </note>Fè m sekou, O SENYÈ, Bondye mwen an.</para>
  <para style="q1" vid="PSA 109:26">Sove mwen selon lanmou dous Ou a.<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>Konsa, ya konnen ke sa te fèt pa men Ou,</para>
  <para style="q1" vid="PSA 109:27">ke se Ou menm, SENYÈ a, ki te fè l.<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>Kite yo menm bay madichon sou mwen,</para>
  <para style="q1" vid="PSA 109:28">men pou Ou menm, bay benediksyon.</para>
  <para style="q1" vid="PSA 109:28">Lè yo leve, yo va wont, men <note caller="+" style="x"><char style="xo" closed="false">109:28 </char><char style="xt" closed="false"><ref loc="ISA 65:14">És 65:14</ref></char></note>sèvitè Ou a va fè kè kontan.<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>Kite <note caller="+" style="x"><char style="xo" closed="false">109:29 </char><char style="xt" closed="false"><ref loc="JOB 8:22">Job 8:22</ref></char></note>akizatè mwen yo vin abiye ak dezonè.</para>
  <para style="q1" vid="PSA 109:29">Kite yo kouvri yo menm ak pwòp wont</para>
  <para style="q1" vid="PSA 109:29">yo tankou se avèk yon manto.<verse eid="PSA 109:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>Avèk bouch mwen, mwen va bay</para>
  <para style="q1" vid="PSA 109:30">anpil remèsiman a SENYÈ a.</para>
  <para style="q1" vid="PSA 109:30">Nan mitan gwo foul la, <note caller="+" style="x"><char style="xo" closed="false">109:30 </char><char style="xt" closed="false"><ref loc="PSA 22:22">Sòm 22:22</ref></char></note>mwen va louwe Li.<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>Paske Li kanpe kote men dwat malere a</para>
  <para style="q1" vid="PSA 109:31">pou sove li de men a sila ki <note caller="+" style="x"><char style="xo" closed="false">109:31 </char><char style="xt" closed="false"><ref loc="PSA 37:33">Sòm 37:33</ref> </char></note>jije nanm li yo.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="d">Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">110:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:44">Mat 22:44</ref>
      </char>
    </note>SENYÈ a di a Senyè mwen an: “Chita bò kote men dwat Mwen</para>
  <para style="q1" vid="PSA 110:1">Jiskaske Mwen fè ènmi Ou yo vin yon machpye pou Ou.”<verse eid="PSA 110:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>SENYÈ a va lonje <note caller="+" style="x"><char style="xo" closed="false">110:2 </char><char style="xt" closed="false"><ref loc="PSA 45:6">Sòm 45:6</ref></char></note>baton wayal Ou a soti nan Sion e di:</para>
  <para style="q1" vid="PSA 110:2">“Se pou ou renye nan mitan ènmi Ou yo”.<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>Pèp Ou a va sèvi ak bòn volonte nan jou pouvwa Ou yo.</para>
  <para style="q1" vid="PSA 110:3">Yo parèt an sentete, soti nan zantray maten an;</para>
  <para style="q1" vid="PSA 110:3">ak jennes Ou, tankou <note caller="+" style="x"><char style="xo" closed="false">110:3 </char><char style="xt" closed="false"><ref loc="2SA 17:12">II Sam 17:12</ref></char></note>lawouzaj gran maten an.<verse eid="PSA 110:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>SENYÈ a fin sèmante. Li <note caller="+" style="x"><char style="xo" closed="false">110:4 </char><char style="xt" closed="false"><ref loc="NUM 23:19">Nonb 23:19</ref></char></note>p ap chanje panse L:</para>
  <para style="q1" vid="PSA 110:4">“Ou se yon prèt jis pou tout tan selon lòd Melchisédek.”<verse eid="PSA 110:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>SENYÈ a sou men dwat ou.</para>
  <para style="q1" vid="PSA 110:5">Li va <note caller="+" style="x"><char style="xo" closed="false">110:5 </char><char style="xt" closed="false"><ref loc="PSA 68:14">Sòm 68:14</ref></char></note>kraze wa yo nan jou kòlè Li a.<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>Li va <note caller="+" style="x"><char style="xo" closed="false">110:6 </char><char style="xt" closed="false"><ref loc="ISA 2:4">És 2:4</ref></char></note>jije pami nasyon yo.</para>
  <para style="q1" vid="PSA 110:6">Li fè gwo pil kadav yo,</para>
  <para style="q1" vid="PSA 110:6">Li va brize tèt a chèf tout latè a.<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>Li va <note caller="+" style="x"><char style="xo" closed="false">110:7 </char><char style="xt" closed="false"><ref loc="JDG 7:5-6">Jij 7:5-6</ref></char></note>bwè nan flèv pandan L an wout;</para>
  <para style="q1" vid="PSA 110:7">konsa, Li va leve tèt Li wo.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>Louwe SENYÈ a!</para>
  <para style="q1" vid="PSA 111:1">Mwen va bay lwanj a SENYÈ a ak tout kè m,</para>
  <para style="q1" vid="PSA 111:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">111:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:7">Sòm 89:7</ref>
      </char>
    </note>Ansanm ak moun ladwati yo ak nan asanble a.<verse eid="PSA 111:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">111:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:5">Sòm 92:5</ref>
      </char>
    </note>Gran se zèv a SENYÈ yo!</para>
  <para style="q1" vid="PSA 111:2">Yo etidye pa tout moun ki pran plezi nan yo.<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>Ranpli ak bèlte avèk majeste se zèv Li yo.</para>
  <para style="q1" vid="PSA 111:3">Ladwati Li dire jis pou tout tan.<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>Li te fè mèvèy Li yo pou nou sonje nèt.</para>
  <para style="q1" vid="PSA 111:4">SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">111:4 </char><char style="xt" closed="false"><ref loc="PSA 86:5-17">Sòm 86:5-17</ref></char></note>ranpli ak gras avèk mizerikòd.<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>Li te <note caller="+" style="x"><char style="xo" closed="false">111:5 </char><char style="xt" closed="false"><ref loc="MAT 6:31-33">Mat 6:31-33</ref></char></note>bay manje a sila ki gen lakrent Li yo.</para>
  <para style="q1" vid="PSA 111:5">Li va sonje akò Li a jis pou tout tan.<verse eid="PSA 111:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>Li te fè pèp Li wè pouvwa a a zèv Li yo,</para>
  <para style="q1" vid="PSA 111:6">lè L te bay yo nasyon yo kòn eritaj.<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>Zèv men Li yo se <note caller="+" style="x"><char style="xo" closed="false">111:7 </char><char style="xt" closed="false"><ref loc="REV 13:3">Rev 13:3</ref></char></note>verite avèk jistis.</para>
  <para style="q1" vid="PSA 111:7">Tout prensip Li yo vrè.<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>Yo va <note caller="+" style="x"><char style="xo" closed="false">111:8 </char><char style="xt" closed="false"><ref loc="PSA 119:160">Sòm 119:160</ref></char></note>andire jis pou tout tan.</para>
  <para style="q1" vid="PSA 111:8">Yo fèt nan verite avèk ladwati.<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>Li te voye <note caller="+" style="x"><char style="xo" closed="false">111:9 </char><char style="xt" closed="false"><ref loc="LUK 1:69">Luc 1:69</ref></char></note>delivrans a pèp Li a.</para>
  <para style="q1" vid="PSA 111:9">Li te òdone akò Li a jis pou tout tan.</para>
  <para style="q1" vid="PSA 111:9">Sen e mèvèye, se non Li.<verse eid="PSA 111:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">111:10 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:28">Job 28:28</ref>
      </char>
    </note>Lakrent SENYÈ a se kòmansman sajès.</para>
  <para style="q1" vid="PSA 111:10">Tout sila ki fè kòmandman Li yo gen bon konprann.</para>
  <para style="q1" vid="PSA 111:10">Lwanj Li dire jis pou tout tan!<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>Louwe SENYÈ a!</para>
  <para style="q1" vid="PSA 112:1">A la beni nonm <note caller="+" style="x"><char style="xo" closed="false">112:1 </char><char style="xt" closed="false"><ref loc="PSA 128:1">Sòm 128:1</ref></char></note> ki krent SENYÈ a beni!</para>
  <para style="q1" vid="PSA 112:1">Sila ki pran gwo plezi nan kòmandman Li yo.<verse eid="PSA 112:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>Desandan li yo va pwisan sou latè.</para>
  <para style="q1" vid="PSA 112:2">Jenerasyon ladwati a va beni.<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>Anpil byen ak gwo richès rete lakay li.</para>
  <para style="q1" vid="PSA 112:3">Ladwati li dire pou tout tan.<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>Limyè vin leve nan tenèb <note caller="+" style="x"><char style="xo" closed="false">112:4 </char><char style="xt" closed="false"><ref loc="JOB 11:17">Job 11:17</ref></char></note>pou moun ladwati a;</para>
  <para style="q1" vid="PSA 112:4">Li plen gras ak mizerikòd, ak jistis.<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>L ale byen pou nonm nan ki <note caller="+" style="x"><char style="xo" closed="false">112:5 </char><char style="xt" closed="false"><ref loc="PSA 37:21">Sòm 37:21</ref></char></note>gen mizerikòd e ki prete;</para>
  <para style="q1" vid="PSA 112:5">Li va prezève koz li a nan jijman an.<verse eid="PSA 112:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>Paske li p ap janm ebranle.</para>
  <para style="q1" vid="PSA 112:6">Moun <note caller="+" style="x"><char style="xo" closed="false">112:6 </char><char style="xt" closed="false"><ref loc="PSA 15:5">Sòm 15:5</ref></char></note>dwat la va sonje jis pou tout tan.<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>Li p ap krent move nouvèl.</para>
  <para style="q1" vid="PSA 112:7">Kè Li fèm <note caller="+" style="x"><char style="xo" closed="false">112:7 </char><char style="xt" closed="false"><ref loc="PSA 56:4">Sòm 56:4</ref> </char></note>ak konfyans nan SENYÈ a.<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">112:8 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 13:9">Eb 13:9</ref>
      </char>
    </note>Kè li kanpe janm.</para>
  <para style="q1" vid="PSA 112:8">Li pa pè anyen, jiskaske denyè moman an lè</para>
  <para style="q1" vid="PSA 112:8">li gade ak kè kontan advèsè li yo.<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>Li <note caller="+" style="x"><char style="xo" closed="false">112:9 </char><char style="xt" closed="false"><ref loc="2CO 9:9">II Kor 9:9</ref></char></note>te bay ak jenewozite a pòv yo.</para>
  <para style="q1" vid="PSA 112:9">Ladwati li dire jis pou tout tan.</para>
  <para style="q1" vid="PSA 112:9">Kòn li va egzalte nan lonè.<verse eid="PSA 112:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>Mechan an va wè l e l ap vekse nèt.</para>
  <para style="q1" vid="PSA 112:10">Li va <note caller="+" style="x"><char style="xo" closed="false">112:10 </char><char style="xt" closed="false"><ref loc="PSA 35:16">Sòm 35:16</ref></char></note>manje dan l e vin fonn pou l disparèt.</para>
  <para style="q1" vid="PSA 112:10">Dezi a mechan an va peri.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>Louwe SENYÈ a!</para>
  <para style="q1" vid="PSA 113:1">Louwe, O <note caller="+" style="x"><char style="xo" closed="false">113:1 </char><char style="xt" closed="false"><ref loc="PSA 34:22">Sòm 34:22</ref></char></note>sèvitè a SENYÈ yo,</para>
  <para style="q1" vid="PSA 113:1">Louwe non SENYÈ a.<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">113:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 145:21">Sòm 145:21</ref>
      </char>
    </note>Beni se non SENYÈ a,</para>
  <para style="q1" vid="PSA 113:2">soti nan tan sa a e jis pou tout tan.<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">113:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:1">Sòm 50:1</ref>
      </char>
    </note>Depi solèy leve jiskaske li kouche,</para>
  <para style="q1" vid="PSA 113:3">non SENYÈ a dwe louwe.<verse eid="PSA 113:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">113:4 </char><char style="xt" closed="false"><ref loc="PSA 8:1">Sòm 8:1</ref></char></note>wo, anwo tout nasyon yo!</para>
  <para style="q1" vid="PSA 113:4">Glwa Li pi wo syèl yo!<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>Se <note caller="+" style="x"><char style="xo" closed="false">113:5 </char><char style="xt" closed="false"><ref loc="EXO 15:11">Egz 15:11</ref></char></note>kilès ki tankou SENYÈ a, Bondye nou an,</para>
  <para style="q1" vid="PSA 113:5">Ki sou twòn Li anwo a,<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>ki <note caller="+" style="x"><char style="xo" closed="false">113:6 </char><char style="xt" closed="false"><ref loc="PSA 11:4">Sòm 11:4</ref></char></note>abese tèt Li pou gade tout bagay</para>
  <para style="q1" vid="PSA 113:6">ki nan syèl yo ak sou latè yo?<verse eid="PSA 113:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>Li <note caller="+" style="x"><char style="xo" closed="false">113:7 </char><char style="xt" closed="false"><ref loc="1SA 2:6">I Sam 2:6</ref></char></note>fè malere a leve sòti nan pousyè a</para>
  <para style="q1" vid="PSA 113:7">e leve endijan an sòti nan pil sann nan,<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>pou fè yo <note caller="+" style="x"><char style="xo" closed="false">113:8 </char><char style="xt" closed="false"><ref loc="JOB 36:7">Job 36:7</ref></char></note>chita avèk prens yo.</para>
  <para style="q1" vid="PSA 113:8">Menm avèk prens a pèp Li yo.<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>Li <note caller="+" style="x"><char style="xo" closed="false">113:9 </char><char style="xt" closed="false"><ref loc="1SA 2:5">I Sam 2:5</ref></char></note>fè fanm steril la vin rete nan kay</para>
  <para style="q1" vid="PSA 113:9">kon yon manman pitit ak kè kontan.</para>
  <para style="q1" vid="PSA 113:9">Louwe SENYÈ a!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>Lè Israël te sòti <note caller="+" style="x"><char style="xo" closed="false">114:1 </char><char style="xt" closed="false"><ref loc="EXO 12:51">Egz 12:51</ref></char></note>an Égypte,</para>
  <para style="q1" vid="PSA 114:1">lakay Jacob soti de yon pèp lang etranje,<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>Juda te vin sanktiyè Li a,</para>
  <para style="q1" vid="PSA 114:2">Israël, <note caller="+" style="x"><char style="xo" closed="false">114:2 </char><char style="xt" closed="false"><ref loc="EXO 19:6">Egz 19:6</ref></char></note>wayòm Li.<verse eid="PSA 114:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>Lanmè a te gade e te sove ale.</para>
  <para style="q1" vid="PSA 114:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">114:3 </char>
      <char style="xt" closed="false">
        <ref loc="JOS 3:13-16">Jos 3:13-16</ref>
      </char>
    </note>Jourdain an te vire fè bak.<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>Mòn yo te <note caller="+" style="x"><char style="xo" closed="false">114:4 </char><char style="xt" closed="false"><ref loc="EXO 19:18">Egz 19:18</ref></char></note>sote tankou belye,</para>
  <para style="q1" vid="PSA 114:4">kolin yo tankou ti mouton.<verse eid="PSA 114:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">114:5 </char>
      <char style="xt" closed="false">
        <ref loc="HAB 3:8">Hab 3:8</ref>
      </char>
    </note>Sa k pase ou menm, O lanmè, ke ou te sove ale konsa?</para>
  <para style="q1" vid="PSA 114:5">O Jourdain an, ke Ou te vire fè bak konsa?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>O mòn yo, ke ou sote tankou belye konsa?</para>
  <para style="q1" vid="PSA 114:6">O kolin yo, tankou ti mouton konsa?<verse eid="PSA 114:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">114:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:9">Sòm 96:9</ref>
      </char>
    </note>Pran tranble, O latè, devan SENYÈ a,</para>
  <para style="q1" vid="PSA 114:7">Devan Bondye a Jacob la,<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>Ki te fè wòch la devni yon ma dlo,</para>
  <para style="q1" vid="PSA 114:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">114:8 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 8:15">Det 8:15</ref>
      </char>
    </note>wòch silèks la yon sous k ap koule.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>Pa pou nou, O SENYÈ, pa pou nou,</para>
  <para style="q1" vid="PSA 115:1">men <note caller="+" style="x"><char style="xo" closed="false">115:1 </char><char style="xt" closed="false"><ref loc="PSA 29:2">Sòm 29:2</ref></char></note>pou Non Ou glwa bay,</para>
  <para style="q1" vid="PSA 115:1">akoz lanmou dous Ou, akoz verite Ou.<verse eid="PSA 115:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>Poukisa nasyon yo ta di:</para>
  <para style="q1" vid="PSA 115:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">115:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:3-10">Sòm 42:3-10</ref>
      </char>
    </note>“Kote Bondye yo a ye koulye a?”<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>Men <note caller="+" style="x"><char style="xo" closed="false">115:3 </char><char style="xt" closed="false"><ref loc="PSA 103:19">Sòm 103:19</ref></char></note>Bondye nou an nan syèl yo.</para>
  <para style="q1" vid="PSA 115:3">Li fè sa Li pito.<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>Zidòl yo se ajan ak lò, <note caller="+" style="x"><char style="xo" closed="false">115:4 </char><char style="xt" closed="false"><ref loc="DEU 4:28">Det 4:28</ref> </char></note>zèv men a lòm.<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>Yo gen bouch, men yo <note caller="+" style="x"><char style="xo" closed="false">115:5 </char><char style="xt" closed="false"><ref loc="JER 10:5">Jr 10:5</ref></char></note>pa kab pale.</para>
  <para style="q1" vid="PSA 115:5">Yo gen zye, men yo pa kab wè.<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>Yo gen zòrèy, men yo pa kab tande.</para>
  <para style="q1" vid="PSA 115:6">Yo gen nen, men yo pa kab santi anyen.<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>Yo gen men, men yo pa kab manyen.</para>
  <para style="q1" vid="PSA 115:7">Yo gen pye, men yo pa kab mache.</para>
  <para style="q1" vid="PSA 115:7">Nanpwen okenn bri ki sòti nan gòj yo.<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">115:8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:18">Sòm 135:18</ref>
      </char>
    </note>Sila ki mete konfyans nan yo va tankou yo.</para>
  <para style="q1" vid="PSA 115:8">Wi, tankou tout moun ki fè yo konfyans yo.<verse eid="PSA 115:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>O Israël, mete konfyans ou nan SENYÈ a!</para>
  <para style="q1" vid="PSA 115:9">Se Li menm ki <note caller="+" style="x"><char style="xo" closed="false">115:9 </char><char style="xt" closed="false"><ref loc="PSA 33:20">Sòm 33:20</ref></char></note>sekou ak boukliye yo.<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>O lakay <note caller="+" style="x"><char style="xo" closed="false">115:10 </char><char style="xt" closed="false"><ref loc="PSA 118:3">Sòm 118:3</ref></char></note>Aaron, mete konfyans ou nan SENYÈ a;</para>
  <para style="q1" vid="PSA 115:10">Se Li menm ki sekou ak boukliye yo.<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>Nou menm ki <note caller="+" style="x"><char style="xo" closed="false">115:11 </char><char style="xt" closed="false"><ref loc="PSA 22:23">Sòm 22:23</ref></char></note>gen lakrent SENYÈ a,</para>
  <para style="q1" vid="PSA 115:11">mete konfyans nou nan SENYÈ a.</para>
  <para style="q1" vid="PSA 115:11">Se Li menm ki sekou yo ak boukliye yo.<verse eid="PSA 115:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">115:12 </char><char style="xt" closed="false"><ref loc="PSA 98:3">Sòm 98:3</ref></char></note>te toujou sonje nou.</para>
  <para style="q1" vid="PSA 115:12">Li va beni nou.</para>
  <para style="q1" vid="PSA 115:12">Li va beni lakay Israël la.</para>
  <para style="q1" vid="PSA 115:12">Li va beni lakay Aaron an.<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>Li va beni sila ki krent SENYÈ yo,</para>
  <para style="q1" vid="PSA 115:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">115:13 </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:18">Rev 11:18</ref>
      </char>
    </note>piti kon gran.<verse eid="PSA 115:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>Ke SENYÈ a kab <note caller="+" style="x"><char style="xo" closed="false">115:14 </char><char style="xt" closed="false"><ref loc="DEU 1:11">Det 1:11</ref></char></note>fè nou grandi plis,</para>
  <para style="q1" vid="PSA 115:14">nou menm ak pitit nou yo.<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>Ke nou ta vin beni pa SENYÈ a,</para>
  <para style="q1" vid="PSA 115:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">115:15 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:1">Jen 1:1</ref>
      </char>
    </note>Kreyatè syèl la ak tè a.<verse eid="PSA 115:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>Syèl yo se <note caller="+" style="x"><char style="xo" closed="false">115:16 </char><char style="xt" closed="false"><ref loc="PSA 89:11">Sòm 89:11</ref></char></note>Syèl SENYÈ a,</para>
  <para style="q1" vid="PSA 115:16">Men latè, Li te bay li a fis a lòm yo.<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">115:17 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:5">Sòm 6:5</ref>
      </char>
    </note>Mò yo pa louwe SENYÈ a,</para>
  <para style="q1" vid="PSA 115:17">ni sila ki desann antre nan silans yo.<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>Men nou va beni SENYÈ a,</para>
  <para style="q1" vid="PSA 115:18">soti nan moman sa a e rive jis pou tout tan.</para>
  <para style="q1" vid="PSA 115:18">Louwe SENYÈ la!<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>Mwen renmen SENYÈ a, paske Li tande vwa m,</para>
  <para style="q1" vid="PSA 116:1">avèk siplikasyon mwen yo.<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>Akoz Li te <note caller="+" style="x"><char style="xo" closed="false">116:2 </char><char style="xt" closed="false"><ref loc="PSA 17:6">Sòm 17:6</ref></char></note>panche zòrèy Li bò kote m,</para>
  <para style="q1" vid="PSA 116:2">pou sa, mwen va rele non Li pandan tout tan ke m viv.<verse eid="PSA 116:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>Kòd lanmò yo te antoure m,</para>
  <para style="q1" vid="PSA 116:3">e laperèz fòs lanmò te vini sou mwen.</para>
  <para style="q1" vid="PSA 116:3">Mwen te jwenn twoub ak gwo tristès.<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>Alò, mwen te rele non SENYÈ a.</para>
  <para style="q1" vid="PSA 116:4">O SENYÈ, mwen sipliye Ou, <note caller="+" style="x"><char style="xo" closed="false">116:4 </char><char style="xt" closed="false"><ref loc="PSA 17:13">Sòm 17:13</ref></char></note>sove lavi mwen!<verse eid="PSA 116:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>Ranpli ak gras ak ladwati, se SENYÈ a.</para>
  <para style="q1" vid="PSA 116:5">Wi, Bondye nou an plen ak <note caller="+" style="x"><char style="xo" closed="false">116:5 </char><char style="xt" closed="false"><ref loc="EXO 34:6">Egz 34:6</ref></char></note>mizerikòd.<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>SENYÈ a toujou pwoteje <note caller="+" style="x"><char style="xo" closed="false">116:6 </char><char style="xt" closed="false"><ref loc="PSA 19:7">Sòm 19:7</ref></char></note> moun senp yo.</para>
  <para style="q1" vid="PSA 116:6">Mwen te abese mwen nèt e Li te sove mwen.<verse eid="PSA 116:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>Reprann <note caller="+" style="x"><char style="xo" closed="false">116:7 </char><char style="xt" closed="false"><ref loc="JER 6:16">Jr 6:16</ref></char></note>repo ou, O nanm mwen, paske</para>
  <para style="q1" vid="PSA 116:7">Bondye te aji nan bonte Li avèk ou.<verse eid="PSA 116:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>Paske Ou te <note caller="+" style="x"><char style="xo" closed="false">116:8 </char><char style="xt" closed="false"><ref loc="PSA 49:15">Sòm 49:15</ref></char></note>delivre nanm mwen devan lanmò,</para>
  <para style="q1" vid="PSA 116:8">zye m pou m pa kriye, pye m pou m pa glise tonbe.<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>Mwen va mache devan SENYÈ a nan</para>
  <para style="q1" vid="PSA 116:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">116:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:13">Sòm 27:13</ref>
      </char>
    </note>peyi moun vivan an.<verse eid="PSA 116:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">116:10 </char><char style="xt" closed="false"><ref loc="2CO 4:13">II Kor 4:13</ref></char></note>te kwè, pou sa mwen te di: “Mwen te vrèman aflije.”<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>Mwen te di nan mitan gwo twoub mwen yo:</para>
  <para style="q1" vid="PSA 116:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">116:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 62:9">Sòm 62:9</ref>
      </char>
    </note>“Tout moun se mantè”.<verse eid="PSA 116:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>Kisa mwen kapab <note caller="+" style="x"><char style="xo" closed="false">116:12 </char><char style="xt" closed="false"><ref loc="2CH 32:25">II Kwo 32:25</ref></char></note>bay a SENYÈ a</para>
  <para style="q1" vid="PSA 116:12">Pou tout bonte Li anvè mwen?<verse eid="PSA 116:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>Mwen va leve wo <note caller="+" style="x"><char style="xo" closed="false">116:13 </char><char style="xt" closed="false"><ref loc="PSA 16:5">Sòm 16:5</ref></char></note>koup sali a,</para>
  <para style="q1" vid="PSA 116:13">e rele non SENYÈ a.<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">116:14 </char><char style="xt" closed="false"><ref loc="PSA 50:14">Sòm 50:14</ref></char></note>peye tout ve mwen yo anvè SENYÈ a.</para>
  <para style="q1" vid="PSA 116:14">Wi, nan prezans tout pèp Li a!<verse eid="PSA 116:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">116:15 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:14">Sòm 72:14</ref>
      </char>
    </note>Byen chè nan zye SENYÈ a, se lanmò a fidèl Li yo.<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>O SENYÈ, anverite, mwen se sèvitè Ou.</para>
  <para style="q1" vid="PSA 116:16">Mwen se sèvitè Ou, fis a sèvant Ou an.</para>
  <para style="q1" vid="PSA 116:16">Ou fin <note caller="+" style="x"><char style="xo" closed="false">116:16 </char><char style="xt" closed="false"><ref loc="PSA 107:14">Sòm 107:14</ref></char></note>lache kòd mwen yo.<verse eid="PSA 116:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>A Ou menm, mwen va ofri yon <note caller="+" style="x"><char style="xo" closed="false">116:17 </char><char style="xt" closed="false"><ref loc="LEV 7:12">Lev 7:12</ref></char></note>sakrifis remèsiman,</para>
  <para style="q1" vid="PSA 116:17">e va rele sou non SENYÈ a.<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">116:18 </char><char style="xt" closed="false"><ref loc="PSA 116:14">Sòm 116:14</ref></char></note>peye ve mwen yo a SENYÈ a.</para>
  <para style="q1" vid="PSA 116:18">Wi, kite l fèt nan prezans a tout pèp Li a!<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>Nan <note caller="+" style="x"><char style="xo" closed="false">116:19 </char><char style="xt" closed="false"><ref loc="PSA 92:13">Sòm 92:13</ref></char></note>lakou lakay SENYÈ a, nan mitan nou menm,</para>
  <para style="q1" vid="PSA 116:19">O Jérusalem, Louwe SENYÈ a!<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">117:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:11">Wo 15:11</ref>
      </char>
    </note>Louwe SENYÈ a, tout nasyon yo!</para>
  <para style="q1" vid="PSA 117:1">Selebre Li, tout pèp yo!<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>Paske lanmou dous Li a gran anvè nou.</para>
  <para style="q1" vid="PSA 117:2">Verite SENYÈ a dire jis pou tout tan.</para>
  <para style="q1" vid="PSA 117:2">Beni SENYÈ a!<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>Bay remèsiman a SENYÈ a, paske Li bon.</para>
  <para style="q1" vid="PSA 118:1">Lanmou dous Li a dire jis pou tout tan.<verse eid="PSA 118:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>O kite <note caller="+" style="x"><char style="xo" closed="false">118:2 </char><char style="xt" closed="false"><ref loc="PSA 115:9">Sòm 115:9</ref></char></note>Israël di: “Lanmou dous Li a se pou tout tan”.<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>O kite <note caller="+" style="x"><char style="xo" closed="false">118:3 </char><char style="xt" closed="false"><ref loc="PSA 115:10">Sòm 115:10</ref></char></note>lakay Aaron di: “Lanmou dous Li a se pou tout tan.”<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>O kite sila <note caller="+" style="x"><char style="xo" closed="false">118:4 </char><char style="xt" closed="false"><ref loc="PSA 115:11">Sòm 115:11</ref></char></note>ki krent SENYÈ yo di:</para>
  <para style="q1" vid="PSA 118:4">“Lanmou dous Li a se pou tout tan.”<verse eid="PSA 118:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>Depi nan <note caller="+" style="x"><char style="xo" closed="false">118:5 </char><char style="xt" closed="false"><ref loc="PSA 18:6">Sòm 18:6</ref></char></note>gran pwoblèm mwen yo, mwen te rele SENYÈ a;</para>
  <para style="q1" vid="PSA 118:5">SENYÈ a te reponn mwen e te mete m yon kote byen laj.<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>SENYÈ a pou mwen; mwen pa pè.</para>
  <para style="q1" vid="PSA 118:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">118:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 56:4-11">Sòm 56:4-11</ref>
      </char>
    </note>Kisa lòm kab fè m?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>SENYÈ a pou mwen pami sila ki ede mwen yo;</para>
  <para style="q1" vid="PSA 118:7">Akoz sa, mwen va gade ak kè kontan sila ki rayi mwen yo.<verse eid="PSA 118:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>Li <note caller="+" style="x"><char style="xo" closed="false">118:8 </char><char style="xt" closed="false"><ref loc="2CH 32:7-8">II Kwo 32:7-8</ref></char></note>pi bon pou kache nan SENYÈ a,</para>
  <para style="q1" vid="PSA 118:8">pase pou mete konfyans nan lòm.<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>Li <note caller="+" style="x"><char style="xo" closed="false">118:9 </char><char style="xt" closed="false"><ref loc="PSA 146:3">Sòm 146:3</ref></char></note>pi bon pou kache nan SENYÈ a,</para>
  <para style="q1" vid="PSA 118:9">pase pou mete konfyans nan prens yo.<verse eid="PSA 118:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>Tout nasyon yo <note caller="+" style="x"><char style="xo" closed="false">118:10 </char><char style="xt" closed="false"><ref loc="PSA 3:6">Sòm 3:6</ref></char></note>te antoure mwen.</para>
  <para style="q1" vid="PSA 118:10">Nan non SENYÈ a, mwen te anverite, koupe retire yo nèt.<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>Yo te antoure mwen, wi, yo te antoure mwen.</para>
  <para style="q1" vid="PSA 118:11">Nan non SENYÈ a, mwen va anverite, koupe retire yo nèt.<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>Yo te antoure mwen <note caller="+" style="x"><char style="xo" closed="false">118:12 </char><char style="xt" closed="false"><ref loc="DEU 1:44">Det 1:44</ref></char></note>tankou myèl.</para>
  <para style="q1" vid="PSA 118:12">Yo te efase nèt tankou dife nan bwa pikan.</para>
  <para style="q1" vid="PSA 118:12">Nan non SENYÈ a, mwen va anverite, koupe retire yo nèt.<verse eid="PSA 118:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>Ou te pouse mwen ak vyolans jiskaske mwen t ap tonbe,</para>
  <para style="q1" vid="PSA 118:13">Men SENYÈ a te <note caller="+" style="x"><char style="xo" closed="false">118:13 </char><char style="xt" closed="false"><ref loc="PSA 86:17">Sòm 86:17</ref> </char></note>fè m sekou.<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>SENYÈ a se fòs mwen ak chanson mwen.</para>
  <para style="q1" vid="PSA 118:14">Li te vin sali mwen.<verse eid="PSA 118:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>Son lajwa eklate ak delivrans nan tant a moun ki dwat yo.</para>
  <para style="q1" vid="PSA 118:15">Men <note caller="+" style="x"><char style="xo" closed="false">118:15 </char><char style="xt" closed="false"><ref loc="EXO 15:6">Egz 15:6</ref></char></note>dwat a SENYÈ a se vanyan!<verse eid="PSA 118:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16"/>Men dwat a SENYÈ a leve wo!</para>
  <para style="q1" vid="PSA 118:16">Men <note caller="+" style="x"><char style="xo" closed="false">118:16 </char><char style="xt" closed="false"><ref loc="EXO 15:6">Egz 15:6</ref></char></note>dwat a SENYÈ a se vanyan!<verse eid="PSA 118:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>Mwen p ap mouri, men m ap viv,</para>
  <para style="q1" vid="PSA 118:17">e mwen va <note caller="+" style="x"><char style="xo" closed="false">118:17 </char><char style="xt" closed="false"><ref loc="PSA 73:28">Sòm 73:28</ref></char></note>pale sou zèv a SENYÈ yo.<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>SENYÈ a te <note caller="+" style="x"><char style="xo" closed="false">118:18 </char><char style="xt" closed="false"><ref loc="PSA 73:14">Sòm 73:14</ref></char></note>korije m ak severite,</para>
  <para style="q1" vid="PSA 118:18">men Li pa t lage mwen a lanmò.<verse eid="PSA 118:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">118:19 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 26:2">És 26:2</ref>
      </char>
    </note>Ouvri pòtay ladwati yo pou mwen.</para>
  <para style="q1" vid="PSA 118:19">Mwen va antre nan yo.</para>
  <para style="q1" vid="PSA 118:19">Mwen va bay remèsiman a SENYÈ a.<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>Sa se pòtay SENYÈ a.</para>
  <para style="q1" vid="PSA 118:20">
    <note caller="+" style="x">
      <char style="xo" closed="false">118:20 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 15:1-2">Sòm 15:1-2</ref>
      </char>
    </note>Moun ladwati yo va antre ladann.<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>Mwen va bay Ou remèsiman,</para>
  <para style="q1" vid="PSA 118:21">paske Ou te <note caller="+" style="x"><char style="xo" closed="false">118:21 </char><char style="xt" closed="false"><ref loc="PSA 116:1">Sòm 116:1</ref></char></note>reponn mwen,</para>
  <para style="q1" vid="PSA 118:21">e Ou te vin sali mwen.<verse eid="PSA 118:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">118:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:42">Mat 21:42</ref>
      </char>
    </note>Wòch ke sila ki t ap bati yo te refize a,</para>
  <para style="q1" vid="PSA 118:22">gen tan vini wòch ang prensipal la.<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>Sa fèt pa SENYÈ a.</para>
  <para style="q1" vid="PSA 118:23">Li se yon mèvèy nan zye nou.<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>Sa se jou ke SENYÈ a te fè.</para>
  <para style="q1" vid="PSA 118:24">Annou <note caller="+" style="x"><char style="xo" closed="false">118:24 </char><char style="xt" closed="false"><ref loc="PSA 31:7">Sòm 31:7</ref></char></note>rejwi nou e fè kè kontan ladann.<verse eid="PSA 118:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>O SENYÈ, sove nou koulye a, nou sipliye Ou!</para>
  <para style="q1" vid="PSA 118:25">O SENYÈ, nou sipliye Ou, voye <note caller="+" style="x"><char style="xo" closed="false">118:25 </char><char style="xt" closed="false"><ref loc="PSA 122:6-7">Sòm 122:6-7</ref></char></note> abondans!<verse eid="PSA 118:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">118:26 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:9">Mat 21:9</ref>
      </char>
    </note>Beni se sila ki vini nan non SENYÈ a!</para>
  <para style="q1" vid="PSA 118:26">Nou te beni Ou depi lakay SENYÈ a.<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>SENYÈ a se Bondye, e Li te bannou <note caller="+" style="x"><char style="xo" closed="false">118:27 </char><char style="xt" closed="false"><ref loc="EST 8:16">Est 8:16</ref></char></note>limyè.</para>
  <para style="q1" vid="PSA 118:27">Mare sakrifis la ak kòd sou kòn lotèl yo.<verse eid="PSA 118:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>Ou se Bondye mwen e mwen va bay Ou remèsiman;</para>
  <para style="q1" vid="PSA 118:28">Ou se Bondye mwen e mwen va leve Ou wo.<verse eid="PSA 118:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>Bay remèsiman a SENYÈ a, paske Li bon!</para>
  <para style="q1" vid="PSA 118:29">Paske lanmou dous Li a dire jis pou tout tan.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="d">ALÈPH.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>A la beni se sila ak chemen ki <note caller="+" style="x"><char style="xo" closed="false">119:1 </char><char style="xt" closed="false"><ref loc="PSA 128:1">Sòm 128:1</ref></char></note>san fot yo,</para>
  <para style="q1" vid="PSA 119:1">ki mache nan lalwa SENYÈ a.<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>A la beni se sila ki kenbe temwayaj Li yo,</para>
  <para style="q1" vid="PSA 119:2">Ki chache Li <note caller="+" style="x"><char style="xo" closed="false">119:2 </char><char style="xt" closed="false"><ref loc="DEU 6:5">Det 6:5</ref></char></note>ak tout kè yo.<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>Ki <note caller="+" style="x"><char style="xo" closed="false">119:3 </char><char style="xt" closed="false"><ref loc="1JN 3:9">I Jn 3:9</ref></char></note>pa fè okenn inikite. Yo mache nan chemen Li yo.<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>Ou te <note caller="+" style="x"><char style="xo" closed="false">119:4 </char><char style="xt" closed="false"><ref loc="DEU 4:13">Det 4:13</ref></char></note>òdone règleman Ou yo, pou nou ta kenbe yo ak dilijans.<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>O ke chemen mwen yo kapab vin etabli</para>
  <para style="q1" vid="PSA 119:5">pou kenbe règleman Ou yo!<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>Konsa, mwen p ap vin desi lè m gade</para>
  <para style="q1" vid="PSA 119:6">kòmandman Ou yo.<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>Mwen va bay Ou remèsiman avèk yon kè ki dwat,</para>
  <para style="q1" vid="PSA 119:7">lè mwen aprann jijman dwat Ou yo.<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>Mwen va kenbe règleman Ou yo.</para>
  <para style="q1" vid="PSA 119:8">Pa abandone m nèt!</para>
  <para style="d" vid="PSA 119:8">BETH<verse eid="PSA 119:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>Kijan yon jennonm kapab kenbe wout li yo san fot?</para>
  <para style="q1" vid="PSA 119:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">119:9 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 2:4">I Wa 2:4</ref>
      </char>
    </note>Nan kenbe li selon pawòl Ou.<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>Ak <note caller="+" style="x"><char style="xo" closed="false">119:10 </char><char style="xt" closed="false"><ref loc="2CH 15:15">II Kwo 15:15</ref></char></note>tout kè mwen, mwen te chache Ou.</para>
  <para style="q1" vid="PSA 119:10">Pa kite mwen vin egare e kite lòd Ou yo.<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>Pawòl Ou yo, mwen te kenbe yo nan kè m,</para>
  <para style="q1" vid="PSA 119:11">pou m pa t peche kont Ou.<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>Beni se Ou menm SENYÈ a.</para>
  <para style="q1" vid="PSA 119:12">Enstwi mwen nan règleman Ou yo.<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>Avèk lèv mwen, mwen te pale selon</para>
  <para style="q1" vid="PSA 119:13">tout òdonans bouch Ou yo.<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>Mwen te rejwi nan chemen temwayaj Ou yo,</para>
  <para style="q1" vid="PSA 119:14">konsi se nan tout richès yo.<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>Mwen va reflechi sou règleman Ou yo,</para>
  <para style="q1" vid="PSA 119:15">e okipe chemen Ou yo.<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">119:16 </char><char style="xt" closed="false"><ref loc="PSA 1:2">Sòm 1:2</ref></char></note>rejwi nan lòd Ou yo.</para>
  <para style="q1" vid="PSA 119:16">Mwen p ap bliye pawòl Ou.</para>
  <para style="d" vid="PSA 119:16">GIMEL<verse eid="PSA 119:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>Aji ak gras avèk sèvitè Ou a,</para>
  <para style="q1" vid="PSA 119:17">pou m kab viv e kenbe pawòl Ou.<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>Ouvri zye m pou m kab wè bèl bagay nan lalwa Ou yo.<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>Mwen se yon <note caller="+" style="x"><char style="xo" closed="false">119:19 </char><char style="xt" closed="false"><ref loc="GEN 47:9">Jen 47:9</ref></char></note>etranje sou latè.</para>
  <para style="q1" vid="PSA 119:19">Pa kache kòmandman Ou yo de mwen.<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>Nanm mwen kraze ak anvi pou òdonans Ou yo tout tan.<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>Ou repwoche ògeye yo, moun madichonnen <note caller="+" style="x"><char style="xo" closed="false">119:21 </char><char style="xt" closed="false"><ref loc="DEU 27:26">Det 27:26</ref></char></note>yo,</para>
  <para style="q1" vid="PSA 119:21">k ap egare kite kòmandman Ou yo.<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>Retire repwòch ak mepri a sou mwen,</para>
  <para style="q1" vid="PSA 119:22">paske mwen obsève temwayaj Ou yo.<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>Malgre prens yo vin chita pou pale kont mwen,</para>
  <para style="q1" vid="PSA 119:23">Sèvitè Ou va reflechi tout tan sou règleman Ou yo.<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>Anplis, temwayaj Ou yo se plezi mwen ak konseye mwen yo.</para>
  <para style="d" vid="PSA 119:24">DALETH<verse eid="PSA 119:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>Nanm mwen kole rèd nan pousyè a.</para>
  <para style="q1" vid="PSA 119:25">Fè m leve selon pawòl Ou.<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>Mwen te pale sou chemen mwen yo,</para>
  <para style="q1" vid="PSA 119:26">e Ou te reponn mwen.</para>
  <para style="q1" vid="PSA 119:26">
    <note caller="+" style="x">
      <char style="xo" closed="false">119:26 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:4">Sòm 25:4</ref>
      </char>
    </note>Enstwi mwen nan règleman Ou yo.<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>Fè m konprann chemen òdonans Ou yo,</para>
  <para style="q1" vid="PSA 119:27">pou m kab reflechi tout tan sou mèvèy Ou yo.<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">119:28 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:14">Sòm 22:14</ref>
      </char>
    </note>Nanm mwen ap kriye akoz doulè.</para>
  <para style="q1" vid="PSA 119:28">Ban m fòs selon pawòl Ou a.<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>Retire sou mwen fo chemen an e</para>
  <para style="q1" vid="PSA 119:29">ban mwen gras nan lalwa Ou a.<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>Mwen te chwazi chemen fidèl Ou a.</para>
  <para style="q1" vid="PSA 119:30">Mwen te mete òdonans Ou yo devan m.<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">119:31 </char><char style="xt" closed="false"><ref loc="DEU 11:22">Det 11:22</ref></char></note>kole rèd de temwayaj Ou yo.</para>
  <para style="q1" vid="PSA 119:31">O SENYÈ, pa fè m desi.<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>Mwen va kouri nan vwa kòmandman Ou yo,</para>
  <para style="q1" vid="PSA 119:32">paske Ou va fè kè m vin grandi.</para>
  <para style="d" vid="PSA 119:32">HE<verse eid="PSA 119:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>Enstwi mwen, O SENYÈ, nan chemen règleman Ou yo</para>
  <para style="q1" vid="PSA 119:33">e mwen va obsève li jiska lafen.<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>Ban mwen bon konprann, pou m kab obsève lalwa Ou.</para>
  <para style="q1" vid="PSA 119:34">Konsa, mwen va kenbe li ak tout kè m.<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>Fè m mache nan pa kòmandman Ou yo,</para>
  <para style="q1" vid="PSA 119:35">paske sa fè kè m kontan.<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>Enkline kè m a temwayaj Ou yo,</para>
  <para style="q1" vid="PSA 119:36">e pa nan ranmase richès malonèt.<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>Vire zye m pou yo pa gade vanite e</para>
  <para style="q1" vid="PSA 119:37">fè m reprann mwen nan chemen Ou yo.<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">119:38 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:25">II Sam 7:25</ref>
      </char>
    </note>Etabli pawòl Ou a Sèvitè Ou a,</para>
  <para style="q1" vid="PSA 119:38">kon sila ki gen lakrent Ou.<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>Detounen lwen m repwòch Ou ke mwen</para>
  <para style="q1" vid="PSA 119:39">krent anpil, paske òdonans Ou yo bon.<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>Gade byen, mwen gen anpil anvi pou òdonans Ou yo!</para>
  <para style="q1" vid="PSA 119:40">Fè m remonte nan ladwati Ou.</para>
  <para style="d" vid="PSA 119:40">VAV<verse eid="PSA 119:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>Anplis, ke lanmou dous Ou a kapab rive kote mwen,</para>
  <para style="q1" vid="PSA 119:41">O SENYÈ, sali Ou a selon pawòl Ou.<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>Pou m kab genyen yon repons pou sila ki repwoche m nan,</para>
  <para style="q1" vid="PSA 119:42">paske mwen mete konfyans mwen nan pawòl Ou.<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>Pa retire pawòl verite a pou l ta kite bouch mwen nèt,</para>
  <para style="q1" vid="PSA 119:43">Paske se òdonans Ou yo ke m ap tann.<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>Konsa, mwen va kenbe lalwa Ou tout tan nèt,</para>
  <para style="q1" vid="PSA 119:44">pou tout tan e pou tout tan.<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>Epi mwen va <note caller="+" style="x"><char style="xo" closed="false">119:45 </char><char style="xt" closed="false"><ref loc="PRO 4:12">Pwov 4:12</ref></char></note>mache nan libète,</para>
  <para style="q1" vid="PSA 119:45">paske se òdonans Ou ke m chache.<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>Anplis, mwen va pale sou temwayaj Ou yo</para>
  <para style="q1" vid="PSA 119:46">
    <note caller="+" style="x">
      <char style="xo" closed="false">119:46 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:18">Mat 10:18</ref>
      </char>
    </note>devan wa yo, e mwen p ap desi.<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>Mwen va pran plezi nan kòmandman Ou yo,</para>
  <para style="q1" vid="PSA 119:47">ke mwen tèlman renmen.<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>Mwen va lonje men m vè kòmandman Ou yo</para>
  <para style="q1" vid="PSA 119:48">ke m tèlman renmen.</para>
  <para style="q1" vid="PSA 119:48">Mwen va reflechi tout tan sou règleman Ou yo.</para>
  <para style="d" vid="PSA 119:48">ZAYIN<verse eid="PSA 119:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>Sonje pawòl a sèvitè Ou a.</para>
  <para style="q1" vid="PSA 119:49">Se nan li Ou te fè m gen espwa a.<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>Se sa ki ban m rekonfò nan mizè mwen an,</para>
  <para style="q1" vid="PSA 119:50">paske se pawòl Ou ki fè m rekouvri fòs.<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>Moun awogan yo meprize m nèt,</para>
  <para style="q1" vid="PSA 119:51">men mwen pa <note caller="+" style="x"><char style="xo" closed="false">119:51 </char><char style="xt" closed="false"><ref loc="JOB 23:11">Job 23:11</ref></char></note>vire kite lalwa Ou.<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>Mwen te sonje òdonans Ou yo depi nan tan ansyen, O SENYÈ,</para>
  <para style="q1" vid="PSA 119:52">e yo rekonfòte mwen.<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>Chalè endiyasyon gen tan pran m akoz mechan yo,</para>
  <para style="q1" vid="PSA 119:53">ki <note caller="+" style="x"><char style="xo" closed="false">119:53 </char><char style="xt" closed="false"><ref loc="PSA 89:30">Sòm 89:30</ref></char></note>abandone lalwa Ou.<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>Règleman Ou yo se chanson mwen</para>
  <para style="q1" vid="PSA 119:54">nan kay kote m <note caller="+" style="x"><char style="xo" closed="false">119:54 </char><char style="xt" closed="false"><ref loc="GEN 47:9">Jen 47:9</ref></char></note>demere.<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>O SENYÈ, Mwen sonje non Ou nan lannwit e</para>
  <para style="q1" vid="PSA 119:55">mwen kenbe lalwa Ou.<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>Se sa ki chemen m,</para>
  <para style="q1" vid="PSA 119:56">mwen kenbe tout òdonans Ou yo.</para>
  <para style="d" vid="PSA 119:56">HETH<verse eid="PSA 119:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>Se SENYÈ a ki pòsyon mwen.</para>
  <para style="q1" vid="PSA 119:57">Mwen te fè pwomès pou <note caller="+" style="x"><char style="xo" closed="false">119:57 </char><char style="xt" closed="false"><ref loc="DEU 33:9">Det 33:9</ref></char></note>kenbe pawòl Ou yo.<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">119:58 </char><char style="xt" closed="false"><ref loc="1KI 13:6">I Wa 13:6</ref></char></note>chache favè Ou ak tout kè m.</para>
  <para style="q1" vid="PSA 119:58">Fè m gras selon pawòl Ou.<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">119:59 </char><char style="xt" closed="false"><ref loc="MRK 14:72">Mc 14:72</ref></char></note>konsidere chemen mwen yo,</para>
  <para style="q1" vid="PSA 119:59">e te vire pye m vè temwayaj Ou yo.<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>Mwen te fè vit e mwen pa t fè reta</para>
  <para style="q1" vid="PSA 119:60">pou obeyi kòmandman Ou yo.<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">119:61 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 36:8">Job 36:8</ref>
      </char>
    </note>Kòd a mechan yo te antoure m,</para>
  <para style="q1" vid="PSA 119:61">men mwen pa t bliye lalwa Ou.<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>A minwi, mwen va leve bay Ou remèsiman,</para>
  <para style="q1" vid="PSA 119:62">akoz òdonans dwat Ou yo.<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>Mwen se zanmi parèy a tout sila ki</para>
  <para style="q1" vid="PSA 119:63">gen lakrent Ou yo ak sila ki swiv règleman Ou yo.<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>Latè ranpli ak lanmou dous Ou a, O SENYÈ.</para>
  <para style="q1" vid="PSA 119:64">Enstwi m règleman Ou yo.</para>
  <para style="d" vid="PSA 119:64">TETH<verse eid="PSA 119:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>Ou te aji ak sèvitè Ou a, O SENYÈ, selon pawòl Ou.<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>Enstwi mwen pou m <note caller="+" style="x"><char style="xo" closed="false">119:66 </char><char style="xt" closed="false"><ref loc="PHM 1:9">Phm 1:9</ref></char></note>sèvi bon jijman ak konesans,</para>
  <para style="q1" vid="PSA 119:66">Paske mwen kwè nan kòmandman Ou yo.<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>Avan mwen te aflije, mwen te mache nan wout egare,</para>
  <para style="q1" vid="PSA 119:67">men koulye a, mwen swiv pawòl Ou.<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>Ou bon e Ou <note caller="+" style="x"><char style="xo" closed="false">119:68 </char><char style="xt" closed="false"><ref loc="DEU 8:16">Det 8:16</ref> </char></note>fè sa ki bon.</para>
  <para style="q1" vid="PSA 119:68">Enstwi mwen nan règleman Ou yo.<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>Awogan yo te fòje yon manti kont mwen.</para>
  <para style="q1" vid="PSA 119:69">Avèk tout kè m, mwen va obsève tout òdonans Ou yo.<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>Kè yo rèd, <note caller="+" style="x"><char style="xo" closed="false">119:70 </char><char style="xt" closed="false"><ref loc="DEU 32:15">Det 32:15</ref></char></note>kouvri ak grès, men mwen pran plezi nan lalwa Ou.<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>Li bon pou mwen ke m te aflije,</para>
  <para style="q1" vid="PSA 119:71">pou m te kab aprann règleman Ou yo.<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>Lalwa bouch Ou pi bon pou mwen,</para>
  <para style="q1" vid="PSA 119:72">pase pyès lò ak ajan pa milye.</para>
  <para style="d" vid="PSA 119:72">YODH<verse eid="PSA 119:72"/></para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>Men Ou te fè m e te fòme mwen.</para>
  <para style="q1" vid="PSA 119:73">Ban m bon konprann pou m kab aprann kòmandman Ou yo.<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>Ke sila ki krent Ou yo kapab wè m e fè kè kontan.</para>
  <para style="q1" vid="PSA 119:74">Paske mwen mete espwa m pawòl Ou yo.<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>Mwen konnen, O SENYÈ, ke jijman Ou yo dwat,</para>
  <para style="q1" vid="PSA 119:75">ke se nan nan <note caller="+" style="x"><char style="xo" closed="false">119:75 </char><char style="xt" closed="false"><ref loc="HEB 12:10">Eb 12:10</ref></char></note>fidelite, Ou te aflije mwen.<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>O ke lanmou dous Ou a kapab konsole mwen,</para>
  <para style="q1" vid="PSA 119:76">Selon pawòl Ou a sèvitè Ou a.<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>Ke mizerikòd Ou kapab rive kote mwen, pou m kab viv,</para>
  <para style="q1" vid="PSA 119:77">paske lalwa Ou se plezi mwen.<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>Ke <note caller="+" style="x"><char style="xo" closed="false">119:78 </char><char style="xt" closed="false"><ref loc="JER 50:32">Jr 50:32</ref></char></note>awogan yo kapab vin desi, paske</para>
  <para style="q1" vid="PSA 119:78">yo desann mwen, ranvèse mwen ak manti.</para>
  <para style="q1" vid="PSA 119:78">Men mwen va reflechi tout tan sou òdonans Ou yo.<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>Ke sila ki krent Ou yo kapab vire kote mwen.</para>
  <para style="q1" vid="PSA 119:79">Yo va konnen règleman Ou yo.<verse eid="PSA 119:79"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>Ke kè m kapab san tò nan règleman Ou yo,</para>
  <para style="q1" vid="PSA 119:80">pou m pa vin desi.</para>
  <para style="d" vid="PSA 119:80">KAPH<verse eid="PSA 119:80"/></para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>Nanm mwen fè gwo anvi pou sali Ou.</para>
  <para style="q1" vid="PSA 119:81">Se pawòl Ou m ap tann.<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>Zye m vin ba ak anvi pawòl Ou,</para>
  <para style="q1" vid="PSA 119:82">pandan m ap di: “Kilè W ap vin konsole mwen?”<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>Sepandan, mwen vin tankou yon vye kwi diven k ap pran lafimen,</para>
  <para style="q1" vid="PSA 119:83">Mwen pa bliye règleman Ou yo.<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>Konbyen jou sèvitè Ou gen?</para>
  <para style="q1" vid="PSA 119:84">Se kilè Ou va <note caller="+" style="x"><char style="xo" closed="false">119:84 </char><char style="xt" closed="false"><ref loc="REV 6:10">Rev 6:10</ref></char></note>pase jijman sou sila ki pèsekite mwen yo?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>Awogan yo fin fouye fòs yo pou mwen,</para>
  <para style="q1" vid="PSA 119:85">Sila ki pa an akò ak lalwa Ou yo.<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>Tout kòmandman Ou yo fidèl.</para>
  <para style="q1" vid="PSA 119:86">Se ak manti yo te pèsekite mwen.</para>
  <para style="q1" vid="PSA 119:86">Fè m sekou!<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>Yo te prèske fin detwi m sou latè,</para>
  <para style="q1" vid="PSA 119:87">Men pou mwen, mwen <note caller="+" style="x"><char style="xo" closed="false">119:87 </char><char style="xt" closed="false"><ref loc="ISA 58:2">És 58:2</ref></char></note>pa t kite</para>
  <para style="q1" vid="PSA 119:87">òdonans Ou yo.<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>Fè m reprann mwen selon lanmou dous Ou a,</para>
  <para style="q1" vid="PSA 119:88">Pou m kab kenbe temwayaj a bouch Ou yo.</para>
  <para style="d" vid="PSA 119:88">LAMEDH<verse eid="PSA 119:88"/></para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>Jis pou tout tan, O SENYÈ, pawòl Ou fin</para>
  <para style="q1" vid="PSA 119:89">etabli nan syèl la.<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>Fidelite Ou pandan tout jenerasyon yo.</para>
  <para style="q1" vid="PSA 119:90">Ou te etabli tè a e li vin kanpe nèt.<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>Yo kanpe nan jou sa a selon <note caller="+" style="x"><char style="xo" closed="false">119:91 </char><char style="xt" closed="false"><ref loc="JER 31:35">Jr 31:35</ref></char></note>lòd Ou.</para>
  <para style="q1" vid="PSA 119:91">Paske tout bagay se sèvitè Ou.<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>Si lalwa Ou pa t plezi mwen,</para>
  <para style="q1" vid="PSA 119:92">mwen t ap gen tan peri nan mizè mwen an.<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>Mwen p ap janm bliye òdonans Ou yo,</para>
  <para style="q1" vid="PSA 119:93">Paske se avèk yo menm ke Ou fè m reprann fòs.<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>Se pa W mwen ye. Fè m sekou!</para>
  <para style="q1" vid="PSA 119:94">Paske mwen te chache òdonans Ou yo.<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>Mechan yo ap tann mwen pou detwi m.</para>
  <para style="q1" vid="PSA 119:95">Se ak dilijans ke mwen konsidere temwayaj Ou yo.<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>Mwen gen tan fin wè lizyè a tout pèfèksyon,</para>
  <para style="q1" vid="PSA 119:96">men kòmandman Ou an vrèman vast.</para>
  <para style="d" vid="PSA 119:96">MEM<verse eid="PSA 119:96"/></para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>O! A la mwen renmen lalwa Ou a!</para>
  <para style="q1" vid="PSA 119:97">Se sou li ke m <note caller="+" style="x"><char style="xo" closed="false">119:97 </char><char style="xt" closed="false"><ref loc="PSA 1:2">Sòm 1:2</ref></char></note>reflechi tout lajounen.<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">119:98 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:6">Det 4:6</ref>
      </char>
    </note>Kòmandman Ou yo fè m pi saj pase ènmi m yo,</para>
  <para style="q1" vid="PSA 119:98">Paske yo toujou pou mwen.<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>Mwen vin gen plis konprann pase tout pwofesè mwen yo,</para>
  <para style="q1" vid="PSA 119:99">Paske temwayaj Ou yo se meditasyon mwen.<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>Mwen gen konprann plis pase granmoun yo,</para>
  <para style="q1" vid="PSA 119:100">akoz mwen te swiv òdonans Ou yo.<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">119:101 </char><char style="xt" closed="false"><ref loc="PRO 1:15">Pwov 1:15</ref></char></note>anpeche pye m antre</para>
  <para style="q1" vid="PSA 119:101">nan tout wout ki gen mechanste,</para>
  <para style="q1" vid="PSA 119:101">Pou m te kab kenbe pawòl Ou.<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>Mwen pa t <note caller="+" style="x"><char style="xo" closed="false">119:102 </char><char style="xt" closed="false"><ref loc="DEU 17:20">Det 17:20</ref></char></note>vire kite règleman Ou yo,</para>
  <para style="q1" vid="PSA 119:102">paske se Ou menm ki te enstwi m.<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>A la pawòl Ou yo dous nan gou mwen!</para>
  <para style="q1" vid="PSA 119:103">Wi, pi dous pase siwo myèl nan bouch mwen!<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>Soti nan òdonans Ou yo, mwen jwenn bon konprann.</para>
  <para style="q1" vid="PSA 119:104">Pou sa, mwen rayi tout fo chemen yo.</para>
  <para style="d" vid="PSA 119:104">NUN<verse eid="PSA 119:104"/></para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>Pawòl Ou se yon lanp pou pye m, e</para>
  <para style="q1" vid="PSA 119:105">yon limyè nan pa pye mwen.<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>Mwen te sèmante e mwen va konfime sa,</para>
  <para style="q1" vid="PSA 119:106">Ke m va kenbe òdonans Ou yo.<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>Mwen vin aflije anpil, anpil; fè m reprann fòs mwen,</para>
  <para style="q1" vid="PSA 119:107">O SENYÈ, selon pawòl Ou.<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>O aksepte <note caller="+" style="x"><char style="xo" closed="false">119:108 </char><char style="xt" closed="false"><ref loc="HOS 14:2">Os 14:2</ref></char></note>ofrann bòn volonte a bouch mwen an,</para>
  <para style="q1" vid="PSA 119:108">O SENYÈ, enstwi mwen nan òdonans Ou yo.<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">119:109 </char>
      <char style="xt" closed="false">
        <ref loc="JDG 12:3">Jij 12:3</ref>
      </char>
    </note>Lavi m tout tan nan men m,</para>
  <para style="q1" vid="PSA 119:109">malgre, mwen pa bliye lalwa Ou a.<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>Mechan yo te poze yon pèlen pou mwen,</para>
  <para style="q1" vid="PSA 119:110">malgre, mwen pa t varye soti nan òdonans Ou yo.<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">119:111 </char><char style="xt" closed="false"><ref loc="DEU 33:4">Det 33:4</ref></char></note>eritye temwayaj Ou yo pou tout tan,</para>
  <para style="q1" vid="PSA 119:111">paske se yo ki lajwa kè m.<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>Mwen te enkline kè m pou fè règleman Ou yo</para>
  <para style="q1" vid="PSA 119:112">jis pou tout tan, jiska lafen.</para>
  <para style="d" vid="PSA 119:112">SAMEKH<verse eid="PSA 119:112"/></para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>Mwen rayi moun ki <note caller="+" style="x"><char style="xo" closed="false">119:113 </char><char style="xt" closed="false"><ref loc="1KI 18:21">I Wa 18:21</ref></char></note>gen de fas, men mwen renmen lalwa Ou a.<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>Ou se kote a pou m kache a ak <note caller="+" style="x"><char style="xo" closed="false">119:114 </char><char style="xt" closed="false"><ref loc="PSA 84:9">Sòm 84:9</ref></char></note>boukliye mwen,</para>
  <para style="q1" vid="PSA 119:114">Mwen ap mete espwa m nan pawòl Ou.<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>Kite mwen, malfektè, pou m kab swiv</para>
  <para style="q1" vid="PSA 119:115">kòmandman a Bondye mwen yo.<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>Soutni mwen selon pawòl Ou, pou m kab viv.</para>
  <para style="q1" vid="PSA 119:116">Pa kite mwen vin wont nan espwa mwen.<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>Kenbe mwen pou m kab jwenn sekou, pou m gen</para>
  <para style="q1" vid="PSA 119:117">konsiderasyon pou règleman Ou yo tout tan.<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>Ou te rejte tout sila ki te egare kite règleman Ou yo,</para>
  <para style="q1" vid="PSA 119:118">paske sediksyon yo a pa reyisi.<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>Ou te fè tout mechan sou latè yo disparèt tankou <note caller="+" style="x"><char style="xo" closed="false">119:119 </char><char style="xt" closed="false"><ref loc="ISA 1:22-25">És 1:22-25</ref></char></note>kim initil.</para>
  <para style="q1" vid="PSA 119:119">Pou sa, mwen renmen temwayaj Ou yo.<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>Chè m ap tranble akoz lakrent Ou menm, e mwen gen laperèz jijman Ou yo.</para>
  <para style="d" vid="PSA 119:120">AYIN<verse eid="PSA 119:120"/></para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">119:121 </char><char style="xt" closed="false"><ref loc="2SA 8:15">II Sam 8:15</ref></char></note>fè sa ki jis e dwat.</para>
  <para style="q1" vid="PSA 119:121">Pa kite mwen nan men opresè mwen yo.<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>Aji kon <note caller="+" style="x"><char style="xo" closed="false">119:122 </char><char style="xt" closed="false"><ref loc="JOB 17:3">Job 17:3</ref></char></note>soutyèn pou bonte a sèvitè Ou a.</para>
  <para style="q1" vid="PSA 119:122">Pa kite awogan yo oprime mwen.<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>Zye m bese ak anvi wè delivrans Ou,</para>
  <para style="q1" vid="PSA 119:123">avèk pawòl ladwati Ou.<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>Aji avèk sèvitè Ou <note caller="+" style="x"><char style="xo" closed="false">119:124 </char><char style="xt" closed="false"><ref loc="PSA 51:1">Sòm 51:1</ref></char></note>selon lanmou dous Ou a</para>
  <para style="q1" vid="PSA 119:124">e enstwi mwen nan règleman Ou yo.<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>Mwen se sèvitè Ou. Fè m konprann</para>
  <para style="q1" vid="PSA 119:125">pou m konnen temwayaj Ou yo.<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>Se lè pou Ou <note caller="+" style="x"><char style="xo" closed="false">119:126 </char><char style="xt" closed="false"><ref loc="JER 18:23">Jr 18:23</ref></char></note>aji, SENYÈ,</para>
  <para style="q1" vid="PSA 119:126">paske yo te vyole lalwa Ou a.<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>Pou sa, mwen renmen kòmandman Ou yo,</para>
  <para style="q1" vid="PSA 119:127">plis pase lò, wi plis pase lò fen.<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>Pou sa, mwen konsidere byen tout</para>
  <para style="q1" vid="PSA 119:128">òdonans Ou yo selon tout bagay.</para>
  <para style="q1" vid="PSA 119:128">Mwen rayi tout sa ki fo.</para>
  <para style="d" vid="PSA 119:128">PE<verse eid="PSA 119:128"/></para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>Temwayaj Ou yo mèvèye.</para>
  <para style="q1" vid="PSA 119:129">Akoz sa, nanm mwen toujou swiv yo.<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>Lè pawòl <note caller="+" style="x"><char style="xo" closed="false">119:130 </char><char style="xt" closed="false"><ref loc="PRO 6:23">Pwov 6:23</ref></char></note>Ou antre, li bay limyè.</para>
  <para style="q1" vid="PSA 119:130">Li bay bon konprann a sila ki senp yo.<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>Mwen te louvri bouch mwen byen laj e</para>
  <para style="q1" vid="PSA 119:131">te rale souf mwen byen vit.</para>
  <para style="q1" vid="PSA 119:131">Se konsa mwen te gen anvi pou kòmandman Ou yo.<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>Vire kote mwen e fè m gras,</para>
  <para style="q1" vid="PSA 119:132">menm jan ke Ou konn fè ak sila ki renmen non Ou yo.<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>Byen etabli tout pa mwen yo nan pawòl Ou,</para>
  <para style="q1" vid="PSA 119:133">e pa kite inikite vin domine sou mwen.<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>Rachte mwen anba opresyon a lòm,</para>
  <para style="q1" vid="PSA 119:134">pou m kab kenbe òdonans Ou yo.<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">119:135 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 6:25">Nonb 6:25</ref>
      </char>
    </note>Fè figi Ou klere sou sèvitè Ou a,</para>
  <para style="q1" vid="PSA 119:135">e enstwi mwen nan règleman Ou yo.<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>Se <note caller="+" style="x"><char style="xo" closed="false">119:136 </char><char style="xt" closed="false"><ref loc="JER 9:1-18">Jr 9:1-18</ref></char></note>rivyè dlo menm ki koule sòti nan zye m,</para>
  <para style="q1" vid="PSA 119:136">akoz yo menm ki pa kenbe lalwa Ou a.</para>
  <para style="d" vid="PSA 119:136">TZADHE<verse eid="PSA 119:136"/></para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>Ou<note caller="+" style="x"><char style="xo" closed="false">119:137 </char><char style="xt" closed="false"><ref loc="EZR 9:15">Esd 9:15</ref></char></note>dwat, O SENYÈ e jis se jijman Ou yo.<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>Ou te kòmande tout temwayaj Ou yo ak ladwati.</para>
  <para style="q1" vid="PSA 119:138">Yo fidèl nèt.<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>Zèl mwen fin manje m nèt,</para>
  <para style="q1" vid="PSA 119:139">akoz advèsè mwen yo te bliye pawòl Ou yo.<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>Pawòl Ou san tach; akoz sa, sèvitè Ou a renmen yo anpil.<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>Mwen vin piti e meprize.</para>
  <para style="q1" vid="PSA 119:141">Mwen pa janm bliye òdonans Ou yo.<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>Ladwati Ou se yon dwati ki jis pou tout tan e lalwa Ou se verite.<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>Twoub ak doulè gen tan rive sou mwen.</para>
  <para style="q1" vid="PSA 119:143">Malgre kòmandman Ou yo se plezi mwen.<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>Temwayaj Ou yo dwat jis pou tout tan.</para>
  <para style="q1" vid="PSA 119:144">Ban mwen bon konprann pou m kab viv.</para>
  <para style="d" vid="PSA 119:144">QOPH<verse eid="PSA 119:144"/></para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>Mwen te kriye ak tout kè mwen.</para>
  <para style="q1" vid="PSA 119:145">Reponn mwen, O SENYÈ!</para>
  <para style="q1" vid="PSA 119:145">Mwen va swiv tout règleman Ou yo.<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>Mwen te kriye a Ou menm. Sove mwen!</para>
  <para style="q1" vid="PSA 119:146">Mwen va obeyi tout regleman Ou yo.<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>Mwen leve avan solèy leve pou kriye pou sekou.</para>
  <para style="q1" vid="PSA 119:147">Mwen ap tann pawòl Ou yo.<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>Zye m rete ovèt pandan vè lanwit la,</para>
  <para style="q1" vid="PSA 119:148">konsa, pou m kab reflechi san rete sou pawòl Ou.<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>Tande vwa m selon lanmou dous Ou a.</para>
  <para style="q1" vid="PSA 119:149">Fè m reprann fòs mwen, O SENYÈ, selon règleman Ou yo.<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>Sila ki swiv mechanste yo apwoche. Yo lwen lalwa Ou a.<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>Ou toupre, O SENYÈ e tout kòmandman Ou yo se verite.<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>Depi nan tan ansyen yo, mwen te <note caller="+" style="x"><char style="xo" closed="false">119:152 </char><char style="xt" closed="false"><ref loc="PSA 119:125">Sòm 119:125</ref></char></note>konnen de temwayaj Ou yo,</para>
  <para style="q1" vid="PSA 119:152">ke Ou te etabli yo jis pou tout tan yo.</para>
  <para style="d" vid="PSA 119:152">RESH<verse eid="PSA 119:152"/></para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">119:153 </char>
      <char style="xt" closed="false">
        <ref loc="LAM 5:1">Lam 5:1</ref>
      </char>
    </note>Gade sou afliksyon mwen an e delivre m,</para>
  <para style="q1" vid="PSA 119:153">paske mwen pa bliye lalwa Ou a.<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">119:154 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 24:15">I Sam 24:15</ref>
      </char>
    </note>Plede kòz mwen e rachte mwen!</para>
  <para style="q1" vid="PSA 119:154">Fè m reprann fòs mwen selon pawòl Ou.<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>Sali a <note caller="+" style="x"><char style="xo" closed="false">119:155 </char><char style="xt" closed="false"><ref loc="JOB 5:4">Job 5:4</ref></char></note>lwen mechan yo, paske yo pa chache règleman pa W yo.<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">119:156 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 24:14">II Sam 24:14</ref>
      </char>
    </note>Gran se mizerikòd Ou yo, O SENYÈ.</para>
  <para style="q1" vid="PSA 119:156">Fè m reprann fòs mwen selon òdonans Ou yo.<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>Anpil se pèsekitè mwen yo, ak advèsè mwen yo.</para>
  <para style="q1" vid="PSA 119:157">Malgre mwen pa vire kite temwayaj Ou yo.<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>Mwen gade <note caller="+" style="x"><char style="xo" closed="false">119:158 </char><char style="xt" closed="false"><ref loc="ISA 21:2">És 21:2</ref></char></note>moun trèt yo e mwen rayi yo nèt,</para>
  <para style="q1" vid="PSA 119:158">akoz yo pa kenbe pawòl Ou.<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>Konsidere jan mwen renmen òdonans Ou yo.</para>
  <para style="q1" vid="PSA 119:159">Fè m reprann fòs, O SENYÈ, selon lanmou dous Ou a.<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>Fòs Kantite tout pawòl Ou yo se verite, e</para>
  <para style="q1" vid="PSA 119:160">tout règleman dwat Ou yo la jis pou tout tan.</para>
  <para style="d" vid="PSA 119:160">SIN AK SHIN<verse eid="PSA 119:160"/></para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">119:161 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 24:11">I Sam 24:11</ref>
      </char>
    </note>Prens yo pèsekite mwen san koz,</para>
  <para style="q1" vid="PSA 119:161">men kè m kanpe etonnen devan pawòl Ou yo.<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>Mwen rejwi nan pawòl Ou kon</para>
  <para style="q1" vid="PSA 119:162">yon moun ki <note caller="+" style="x"><char style="xo" closed="false">119:162 </char><char style="xt" closed="false"><ref loc="1SA 30:16">I Sam 30:16</ref></char></note>jwenn gwo piyaj.<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>Mwen rayi tankou bagay abominab, tout sa ki fo.</para>
  <para style="q1" vid="PSA 119:163">Men lalwa Ou a, mwen renmen l nèt.<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>Sèt fwa pa jou mwen louwe Ou,</para>
  <para style="q1" vid="PSA 119:164">akoz òdonans dwat Ou yo.<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>Sila ki renmen lalwa Ou yo gen gwo lapè.</para>
  <para style="q1" vid="PSA 119:165">Pa gen anyen pou ta fè yo chite.<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>Mwen espere <note caller="+" style="x"><char style="xo" closed="false">119:166 </char><char style="xt" closed="false"><ref loc="GEN 49:18">Jen 49:18</ref></char></note>gen Sali Ou, O SENYÈ.</para>
  <para style="q1" vid="PSA 119:166">Mwen te fè kòmandman Ou yo.<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>Nanm mwen kenbe temwayaj Ou yo.</para>
  <para style="q1" vid="PSA 119:167">Mwen renmen yo anpil anpil.<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>Mwen kenbe òdonans Ou yo avèk temwayaj Ou yo,</para>
  <para style="q1" vid="PSA 119:168">Paske se <note caller="+" style="x"><char style="xo" closed="false">119:168 </char><char style="xt" closed="false"><ref loc="JOB 24:23">Job 24:23</ref></char></note>tout chemen mwen yo ki devan Ou.</para>
  <para style="d" vid="PSA 119:168">TAV<verse eid="PSA 119:168"/></para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>Kite kri mwen vini devan Ou, O SENYÈ.</para>
  <para style="q1" vid="PSA 119:169">Ban mwen konesans selon pawòl Ou.<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>Kite siplikasyon mwen yo parèt devan Ou.</para>
  <para style="q1" vid="PSA 119:170">
    <note caller="+" style="x">
      <char style="xo" closed="false">119:170 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:20">Sòm 22:20</ref>
      </char>
    </note>Delivre mwen selon pawòl Ou.<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>Kite lèv mwen eksprime lwanj,</para>
  <para style="q1" vid="PSA 119:171">paske Ou enstwi mwen nan règleman Ou yo.<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>Kite lang mwen chante de pawòl Ou,</para>
  <para style="q1" vid="PSA 119:172">paske tout kòmandman Ou yo dwat.<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>Kite men Ou parèt pou fè m sekou,</para>
  <para style="q1" vid="PSA 119:173">paske mwen te <note caller="+" style="x"><char style="xo" closed="false">119:173 </char><char style="xt" closed="false"><ref loc="JOS 24:22">Jos 24:22</ref></char></note>chwazi òdonans Ou yo.<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>Mwen anvi wè delivrans Ou, O SENYÈ.</para>
  <para style="q1" vid="PSA 119:174">Lalwa Ou se gran plezi mwen.<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>Kite <note caller="+" style="x"><char style="xo" closed="false">119:175 </char><char style="xt" closed="false"><ref loc="ISA 55:3">És 55:3</ref></char></note>nanm mwen viv pou l kapab louwe Ou.</para>
  <para style="q1" vid="PSA 119:175">Kite òdonans Ou yo ban m sekou.<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>Mwen te <note caller="+" style="x"><char style="xo" closed="false">119:176 </char><char style="xt" closed="false"><ref loc="ISA 53:6">És 53:6</ref></char></note>vin egare tankou yon mouton pèdi.</para>
  <para style="q1" vid="PSA 119:176">Chache jwenn sèvitè Ou a, paske mwen pa bliye kòmandman Ou yo.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="d">Yon chanson pou monte vè tanp lan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">120:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:6">Sòm 18:6</ref>
      </char>
    </note>Nan gran twoub mwen an, mwen te kriye a SENYÈ a.</para>
  <para style="q1" vid="PSA 120:1">Li te reponn mwen.<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>Delivre nanm mwen, O SENYÈ, de lèv k ap bay desepsyon,</para>
  <para style="q1" vid="PSA 120:2">de lang ki plen manti yo.<verse eid="PSA 120:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>Kisa pou W ta resevwa, e kisa pou m ta fè ou, O <note caller="+" style="x"><char style="xo" closed="false">120:3 </char><char style="xt" closed="false"><ref loc="PSA 52:4">Sòm 52:4</ref></char></note>lang mansonjè?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>Flèch pwent file a gèrye yo, avèk chabon pye gayak tou limen.<verse eid="PSA 120:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>Malè a mwen, paske mwen demere nan tant a <note caller="+" style="x"><char style="xo" closed="false">120:5 </char><char style="xt" closed="false"><ref loc="GEN 10:2">Jen 10:2</ref></char></note>Méschec,</para>
  <para style="q1" vid="PSA 120:5">Paske mwen rete pami tant a Kédar yo!<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>Nanm mwen gen demè li avèk sila ki</para>
  <para style="q1" vid="PSA 120:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">120:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:20">Sòm 35:20</ref>
      </char>
    </note>rayi lapè yo pandan twòp tan.<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>Mwen <note caller="+" style="x"><char style="xo" closed="false">120:7 </char><char style="xt" closed="false"><ref loc="PSA 109:4">Sòm 109:4</ref></char></note>vle lapè, men lè m pale, se lagè yo pito.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="d">Yon Sòm pou monte vè tanp lan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>Mwen leve zye m vè <note caller="+" style="x"><char style="xo" closed="false">121:1 </char><char style="xt" closed="false"><ref loc="PSA 87:1">Sòm 87:1</ref></char></note>mòn yo.</para>
  <para style="q1" vid="PSA 121:1">Se kibò sekou mwen va sòti?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>Sekou m sòti nan SENYÈ a,</para>
  <para style="q1" vid="PSA 121:2">ki <note caller="+" style="x"><char style="xo" closed="false">121:2 </char><char style="xt" closed="false"><ref loc="PSA 115:15">Sòm 115:15</ref></char></note>te fè syèl la ak tè a.<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>Li <note caller="+" style="x"><char style="xo" closed="false">121:3 </char><char style="xt" closed="false"><ref loc="1SA 2:9">I Sam 2:9</ref></char></note>p ap kite pye ou chape.</para>
  <para style="q1" vid="PSA 121:3">Sila ki kenbe ou a p ap kabicha, ni dòmi.<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>Gade byen, Sila ki kenbe Israël p ap kabicha, ni Li p ap dòmi.<verse eid="PSA 121:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>SENYÈ a se <note caller="+" style="x"><char style="xo" closed="false">121:5 </char><char style="xt" closed="false"><ref loc="PSA 91:4">Sòm 91:4</ref></char></note>gadyen ou.</para>
  <para style="q1" vid="PSA 121:5">SENYÈ a se lonbraj a men dwat ou.<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">121:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:5">Sòm 91:5</ref>
      </char>
    </note>Solèy p ap frape ou lajounen,</para>
  <para style="q1" vid="PSA 121:6">ni lalin pandan lannwit.<verse eid="PSA 121:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>SENYÈ a va pwoteje ou de tout mal.</para>
  <para style="q1" vid="PSA 121:7">Li va kenbe nanm ou.<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>Li va <note caller="+" style="x"><char style="xo" closed="false">121:8 </char><char style="xt" closed="false"><ref loc="DEU 28:6">Det 28:6</ref></char></note>pwoteje ou lè ou sòti ak lè ou antre,</para>
  <para style="q1" vid="PSA 121:8">depi nan moman sa a e jis rive pou tout tan.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="d">Yon Sòm pou monte vè tanp lan. Yon Sòm David.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>Mwen te kontan lè yo te di mwen,</para>
  <para style="q1" vid="PSA 122:1">“Annou <note caller="+" style="x"><char style="xo" closed="false">122:1 </char><char style="xt" closed="false"><ref loc="PSA 42:4">Sòm 42:4</ref></char></note>ale lakay SENYÈ a.”<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>Pye nou kanpe anndan pòtay ou yo, O Jérusalem!<verse eid="PSA 122:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>Jérusalem, ki bati kon yon vil ki <note caller="+" style="x"><char style="xo" closed="false">122:3 </char><char style="xt" closed="false"><ref loc="2SA 5:9">II Sam 5:9</ref></char></note>kole dyanm ansanm,<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>sou sila, tribi yo konn <note caller="+" style="x"><char style="xo" closed="false">122:4 </char><char style="xt" closed="false"><ref loc="EXO 23:17">Egz 23:17</ref></char></note>monte, menm tribi a SENYÈ yo,</para>
  <para style="q1" vid="PSA 122:4">yon òdonans pou Israël, pou bay remèsiman a non SENYÈ a.<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>Paske la, <note caller="+" style="x"><char style="xo" closed="false">122:5 </char><char style="xt" closed="false"><ref loc="DEU 17:8">Det 17:8</ref></char></note>twòn yo te plase pou jijman,</para>
  <para style="q1" vid="PSA 122:5">twòn lakay David yo.<verse eid="PSA 122:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>Priye pou lapè Jérusalem.</para>
  <para style="q1" vid="PSA 122:6">Sila ki renmen ou yo va <note caller="+" style="x"><char style="xo" closed="false">122:6 </char><char style="xt" closed="false"><ref loc="PSA 102:14">Sòm 102:14</ref></char></note>pwospere.<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>Ke lapè kapab anndan miray ou yo, e pwosperite nan <note caller="+" style="x"><char style="xo" closed="false">122:7 </char><char style="xt" closed="false"><ref loc="PSA 48:3-13">Sòm 48:3-13</ref></char></note>palè ou yo.<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>Pou koz a frè m yo ak zanmi mwen yo, m ap di koulye a,</para>
  <para style="q1" vid="PSA 122:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">122:8 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 25:6">I Sam 25:6</ref>
      </char>
    </note>“Ke lapè anndan ou”.<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">122:9 </char>
      <char style="xt" closed="false">
        <ref loc="NEH 2:10">Né 2:10</ref>
      </char>
    </note>Pou koz a kay SENYÈ a, Bondye nou an, mwen va chache byen ou.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="d">Yon chan pou monte vè tanp lan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>A Ou menm, mwen leve zye mwen,</para>
  <para style="q1" vid="PSA 123:1">O Ou menm <note caller="+" style="x"><char style="xo" closed="false">123:1 </char><char style="xt" closed="false"><ref loc="PSA 2:4">Sòm 2:4</ref></char></note>ki chita sou</para>
  <para style="q1" vid="PSA 123:1">twòn Ou nan syèl la!<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>Men gade, jan zye a <note caller="+" style="x"><char style="xo" closed="false">123:2 </char><char style="xt" closed="false"><ref loc="PRO 27:18">Pwov 27:18</ref></char></note>sèvitè yo rete sou men a mèt yo,</para>
  <para style="q1" vid="PSA 123:2">Jan zye a yon sèvant sou men mètrès li,</para>
  <para style="q1" vid="PSA 123:2">Se konsa, zye nou ye vè SENYÈ a, Bondye nou an, jiskaske li fè nou gras.<verse eid="PSA 123:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>Bannou gras, O SENYÈ, bannou gras,</para>
  <para style="q1" vid="PSA 123:3">paske nou ranpli <note caller="+" style="x"><char style="xo" closed="false">123:3 </char><char style="xt" closed="false"><ref loc="NEH 4:4">Né 4:4</ref> </char></note>ak mepriz.<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>Nanm nou ranpli ak <note caller="+" style="x"><char style="xo" closed="false">123:4 </char><char style="xt" closed="false"><ref loc="NEH 2:19">Né 2:19</ref></char></note>ensilt a sila ki alèz yo,</para>
  <para style="q1" vid="PSA 123:4">avèk mepriz a sila ki plen ògèy yo.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="d">Yon Sòm pou monte vè tanp lan. Yon Sòm David.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">124:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 94:17">Sòm 94:17</ref>
      </char>
    </note>Si se pa t SENYÈ a ki te pou nou,</para>
  <para style="q1" vid="PSA 124:1">kite Israël di koulye a,<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>Si se pa t SENYÈ a ki te pou nou,</para>
  <para style="q1" vid="PSA 124:2">lè lezòm te leve kont nou yo,<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>Alò, yo t ap gen tan fin <note caller="+" style="x"><char style="xo" closed="false">124:3 </char><char style="xt" closed="false"><ref loc="NUM 16:30">Nonb 16:30</ref></char></note>vale nou tou vivan,</para>
  <para style="q1" vid="PSA 124:3">lè kòlè yo te limen kont nou an.<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>Nan lè sa a, <note caller="+" style="x"><char style="xo" closed="false">124:4 </char><char style="xt" closed="false"><ref loc="JOB 22:11">Job 22:11</ref></char></note>dlo yo t ap fin anglouti nou nèt.</para>
  <para style="q1" vid="PSA 124:4">Kouran dlo yo ta fin pase sou nanm nou.<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>Nan lè sa a, <note caller="+" style="x"><char style="xo" closed="false">124:5 </char><char style="xt" closed="false"><ref loc="JOB 38:11">Job 38:11</ref></char></note>dlo anraje yo t ap fin pase sou nanm nou.<verse eid="PSA 124:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>Beni se SENYÈ a, ki pa t livre nou pou <note caller="+" style="x"><char style="xo" closed="false">124:6 </char><char style="xt" closed="false"><ref loc="PSA 27:2">Sòm 27:2</ref></char></note>chire nan dan yo.<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>Nanm nou gen tan fin chape tankou yon zwazo</para>
  <para style="q1" vid="PSA 124:7">ki sòti nan <note caller="+" style="x"><char style="xo" closed="false">124:7 </char><char style="xt" closed="false"><ref loc="PSA 91:3">Sòm 91:3</ref></char></note>pèlen a moun k ap fè lachas yo.</para>
  <para style="q1" vid="PSA 124:7">Pèlen an fin kase e nou chape.<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>Sekou nou se nan non SENYÈ a, ki te</para>
  <para style="q1" vid="PSA 124:8">
    <note caller="+" style="x">
      <char style="xo" closed="false">124:8 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:1">Jen 1:1</ref>
      </char>
    </note>fè syèl la ak tè a.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="d">Yon chan pou monte vè tanp lan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>Sila ki mete konfyans yo nan SENYÈ a tankou Mòn Sion,</para>
  <para style="q1" vid="PSA 125:1">ki pa kab deplase, men ki dire jis pou tout tan.<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>Kon mòn antoure Jérusalem yo,</para>
  <para style="q1" vid="PSA 125:2">se konsa <note caller="+" style="x"><char style="xo" closed="false">125:2 </char><char style="xt" closed="false"><ref loc="ZEC 2:5">Za 2:5</ref></char></note>SENYÈ a antoure pèp Li a</para>
  <para style="q1" vid="PSA 125:2">depi moman sa a, e jis rive pou tout tan.<verse eid="PSA 125:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>Paske baton wayal plen mechanste p ap poze sou peyi a moun ladwati yo,</para>
  <para style="q1" vid="PSA 125:3">jis pou moun dwat yo pa leve men yo pou fè mal.<verse eid="PSA 125:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>Fè byen, SENYÈ, a sila ki bon yo, ak sila ki <note caller="+" style="x"><char style="xo" closed="false">125:4 </char><char style="xt" closed="false"><ref loc="PSA 7:10">Sòm 7:10</ref></char></note>dwat nan kè yo.<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>Men pou sila ki vire akote pou <note caller="+" style="x"><char style="xo" closed="false">125:5 </char><char style="xt" closed="false"><ref loc="PRO 2:15">Pwov 2:15</ref></char></note>chemen kwochi pa yo,</para>
  <para style="q1" vid="PSA 125:5">SENYÈ a va mennen yo sòti avèk</para>
  <para style="q1" vid="PSA 125:5">sila ki fè inikite yo.</para>
  <para style="q1" vid="PSA 125:5">Ke lapè rete sou Israël.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="d">Yon chan pou monte vè tanp lan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>Lè SENYÈ a te fè mennen tounen kaptif Sion yo,</para>
  <para style="q1" vid="PSA 126:1">nou te <note caller="+" style="x"><char style="xo" closed="false">126:1 </char><char style="xt" closed="false"><ref loc="ACT 12:9">Trav 12:9</ref></char></note>tankou sila ki fè rèv yo.<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>Nan lè sa a, bouch nou te plen</para>
  <para style="q1" vid="PSA 126:2">ak ri lajwa e lang nou avèk kri lajwa.</para>
  <para style="q1" vid="PSA 126:2">Konsa, yo te di pami nasyon yo:</para>
  <para style="q1" vid="PSA 126:2">“SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">126:2 </char><char style="xt" closed="false"><ref loc="1SA 12:24">I Sam 12:24</ref></char></note>te fè gwo bagay pou yo.”<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>SENYÈ a te fè gwo bagay yo pou nou.</para>
  <para style="q1" vid="PSA 126:3">Nou <note caller="+" style="x"><char style="xo" closed="false">126:3 </char><char style="xt" closed="false"><ref loc="ISA 25:9">És 25:9</ref></char></note>kontan.<verse eid="PSA 126:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>Fè retounen kaptif nou yo, O SENYÈ,</para>
  <para style="q1" vid="PSA 126:4">kon <note caller="+" style="x"><char style="xo" closed="false">126:4 </char><char style="xt" closed="false"><ref loc="ISA 35:6">És 35:6</ref></char></note>rivyè nan dezè a.<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>Sila ki simen ak dlo nan zye yo</para>
  <para style="q1" vid="PSA 126:5">Va rekòlte avèk <note caller="+" style="x"><char style="xo" closed="false">126:5 </char><char style="xt" closed="false"><ref loc="ISA 35:10">És 35:10</ref></char></note>gwo kri lajwa.<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>Sila ki soti ap kriye akoz chàj makout semans lan.</para>
  <para style="q1" vid="PSA 126:6">Men l ap retounen ankò ak kri lajwa,</para>
  <para style="q1" vid="PSA 126:6">akoz chàj pakèt rekòlt l ap pote a.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="d">Yon chan pou monte vè tanp lan. Yon chan Salomon.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>Amwenske se SENYÈ a ki bati kay la,</para>
  <para style="q1" vid="PSA 127:1">sila ki bati li yo, travay anven.</para>
  <para style="q1" vid="PSA 127:1">Amwenske SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">127:1 </char><char style="xt" closed="false"><ref loc="PSA 121:4">Sòm 121:4</ref></char></note>veye pòtay la,</para>
  <para style="q1" vid="PSA 127:1">gadyen an rete zye louvri anven.<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>Se an ven pou ou leve bonè e ale dòmi ta,</para>
  <para style="q1" vid="PSA 127:2">pou <note caller="+" style="x"><char style="xo" closed="false">127:2 </char><char style="xt" closed="false"><ref loc="GEN 3:17">Jen 3:17</ref></char></note>manje pen a travay di yo,</para>
  <para style="q1" vid="PSA 127:2">paske se domi Li bay a moun li renmen.<verse eid="PSA 127:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>Veye byen, pitit se yon don SENYÈ a.</para>
  <para style="q1" vid="PSA 127:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">127:3 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 7:13">Det 7:13</ref>
      </char>
    </note>Fwi a vant la se yon rekonpans.<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>Tankou flèch nan men a yon <note caller="+" style="x"><char style="xo" closed="false">127:4 </char><char style="xt" closed="false"><ref loc="PSA 112:2">Sòm 112:2</ref></char></note>gèrye,</para>
  <para style="q1" vid="PSA 127:4">Se konsa pitit a jèn yo ye.<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>A la <note caller="+" style="x"><char style="xo" closed="false">127:5 </char><char style="xt" closed="false"><ref loc="PSA 128:2-3">Sòm 128:2-3</ref></char></note>beni se nonm ke veso l plen ak yo.</para>
  <para style="q1" vid="PSA 127:5">Yo p ap wont lè yo pale ak lènmi yo nan pòtay la.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="d">Yon chan pou monte vè tanp lan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">128:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 112:1">Sòm 112:1</ref>
      </char>
    </note>A la beni se tout sila ki gen lakrent SENYÈ yo,</para>
  <para style="q1" vid="PSA 128:1">ki mache nan chemen Li yo.<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>Lè ou manje nan <note caller="+" style="x"><char style="xo" closed="false">128:2 </char><char style="xt" closed="false"><ref loc="PSA 109:11">Sòm 109:11</ref></char></note>fwi a men ou yo,</para>
  <para style="q1" vid="PSA 128:2">ou va kontan e sa va ale byen pou ou.<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>Madanm ou ap tankou yon <note caller="+" style="x"><char style="xo" closed="false">128:3 </char><char style="xt" closed="false"><ref loc="EZK 19:10">Éz 19:10</ref></char></note>chan rezen</para>
  <para style="q1" vid="PSA 128:3">ki bay anpil rezen lakay ou.</para>
  <para style="q1" vid="PSA 128:3">Pitit ou yo va tankou plan bwa doliv ki antoure tab ou.<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>Gade byen, paske se konsa nonm ki krent SENYÈ a va beni.<verse eid="PSA 128:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">128:5 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 134:3">Sòm 134:3</ref>
      </char>
    </note>Ke SENYÈ a beni ou depi nan Sion;</para>
  <para style="q1" vid="PSA 128:5">ke ou wè pwosperite Jérusalem nan pandan tout jou lavi ou yo!<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>Wi, pou ou ka wè <note caller="+" style="x"><char style="xo" closed="false">128:6 </char><char style="xt" closed="false"><ref loc="GEN 48:11">Jen 48:11</ref></char></note>pitit a pitit ou yo!</para>
  <para style="q1" vid="PSA 128:6">Ke lapè rete sou Israël!<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="d">Yon chan pou monte vè tanp lan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>“Anpil fwa, yo te pèsekite mwen soti nan <note caller="+" style="x"><char style="xo" closed="false">129:1 </char><char style="xt" closed="false"><ref loc="ISA 47:12">És 47:12</ref></char></note>jenès mwen.</para>
  <para style="q1" vid="PSA 129:1">Kite Israël di koulye a:<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>“Anpil fwa, yo te pèsekite mwen soti nan jenès mwen,</para>
  <para style="q1" vid="PSA 129:2">men yo pa janm reyisi kont mwen.<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>Labourè yo te laboure chan yo sou do m.</para>
  <para style="q1" vid="PSA 129:3">Yo fè tranch tè yo vin pi long.”<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>SENYÈ a dwat.</para>
  <para style="q1" vid="PSA 129:4">Kòd a mechan yo, Li te koupe yo fè bout.<verse eid="PSA 129:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>Ke tout sila ki <note caller="+" style="x"><char style="xo" closed="false">129:5 </char><char style="xt" closed="false"><ref loc="MIC 4:11">Mi 4:11</ref></char></note>rayi Sion yo vin wont!</para>
  <para style="q1" vid="PSA 129:5">Ke yo retounen fè bak menm.<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>Kite yo vin tankou <note caller="+" style="x"><char style="xo" closed="false">129:6 </char><char style="xt" closed="false"><ref loc="2KI 19:26">II Wa 19:26</ref></char></note>zèb sou kay la;</para>
  <para style="q1" vid="PSA 129:6">zèb ki fennen avan li grandi,<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>jis moun rekòlt la p ap kapab plen men l,</para>
  <para style="q1" vid="PSA 129:7">oubyen sila ki mare pote pake a,</para>
  <para style="q1" vid="PSA 129:7">pa p ka plen lestomak li.<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>Ni sila ki pase yo, p ap di:</para>
  <para style="q1" vid="PSA 129:8">“Ke <note caller="+" style="x"><char style="xo" closed="false">129:8 </char><char style="xt" closed="false"><ref loc="RUT 2:4">Rt 2:4</ref></char></note>benediksyon SENYÈ a rete avèk ou.</para>
  <para style="q1" vid="PSA 129:8">Nou beni ou nan non SENYÈ a.”<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="d">Yon chan pou monte vè tanp lan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>Soti nan <note caller="+" style="x"><char style="xo" closed="false">130:1 </char><char style="xt" closed="false"><ref loc="PSA 42:7">Sòm 42:7</ref></char></note>pwofondè abim nan, mwen te kriye a Ou menm, O SENYÈ.<verse eid="PSA 130:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2"/>SENYÈ, koute vwa mwen!</para>
  <para style="q1" vid="PSA 130:2">Kite zòrèy Ou rete atantif a vwa siplikasyon mwen yo.<verse eid="PSA 130:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>Si Ou menm, SENYÈ, ta sonje inikite yo,</para>
  <para style="q1" vid="PSA 130:3">O SENYÈ, se kilès ki ta kab <note caller="+" style="x"><char style="xo" closed="false">130:3 </char><char style="xt" closed="false"><ref loc="PSA 76:7">Sòm 76:7</ref></char></note>kanpe?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>Men avèk Ou menm, gen padon,</para>
  <para style="q1" vid="PSA 130:4">pou moun ta gen reverans Ou.<verse eid="PSA 130:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>Mwen tann SENYÈ a.</para>
  <para style="q1" vid="PSA 130:5">Nanm mwen ap tann e nan pawòl Li,</para>
  <para style="q1" vid="PSA 130:5">mwen mete espwa m.<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>Nanm mwen ap tann SENYÈ a plis</para>
  <para style="q1" vid="PSA 130:6">pase gadyen k ap tann maten rive a.</para>
  <para style="q1" vid="PSA 130:6">Anverite, plis pase gadyen k ap tann maten rive a.<verse eid="PSA 130:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>O Israël, mete espwa nan SENYÈ a.</para>
  <para style="q1" vid="PSA 130:7">Paske kote SENYÈ a ye, gen mizerikòd.</para>
  <para style="q1" vid="PSA 130:7">Avèk Li, gen redanmsyon an <note caller="+" style="x"><char style="xo" closed="false">130:7 </char><char style="xt" closed="false"><ref loc="PSA 111:9">Sòm 111:9</ref></char></note>abondans.<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>Li va fè <note caller="+" style="x"><char style="xo" closed="false">130:8 </char><char style="xt" closed="false"><ref loc="PSA 103:3-4">Sòm 103:3-4</ref></char></note>redanmsyon Israël de tout inikite Li yo.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="d">Yon chan pou monte vè tanp lan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>O SENYÈ, kè m pa ògeye, ni zye m pa <note caller="+" style="x"><char style="xo" closed="false">131:1 </char><char style="xt" closed="false"><ref loc="PRO 30:13">Pwov 30:13</ref></char></note>gen awogans.</para>
  <para style="q1" vid="PSA 131:1">Ni m pa fouye kò m nan gwo zafè,</para>
  <para style="q1" vid="PSA 131:1">ni nan sa ki twò wo pou mwen.<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>Anverite, mwen te fin ranje e kalme nanm mwen.</para>
  <para style="q1" vid="PSA 131:2">Menm jan ke yon <note caller="+" style="x"><char style="xo" closed="false">131:2 </char><char style="xt" closed="false"><ref loc="MAT 18:3">Mat 18:3</ref></char></note>pitit poze sou manman l,</para>
  <para style="q1" vid="PSA 131:2">anndan m, nanm mwen tankou yon pitit ki sevre.<verse eid="PSA 131:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>O Israël, <note caller="+" style="x"><char style="xo" closed="false">131:3 </char><char style="xt" closed="false"><ref loc="PSA 130:7">Sòm 130:7</ref></char></note>mete espwa nan SENYÈ a</para>
  <para style="q1" vid="PSA 131:3">depi koulye a e jis rive pou tout tan.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="d">Yon chan pou monte vè tanp lan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>Sonje, SENYÈ, pou koz David, ak <note caller="+" style="x"><char style="xo" closed="false">132:1 </char><char style="xt" closed="false"><ref loc="GEN 49:24">Jen 49:24</ref></char></note>tout soufrans li an,<verse eid="PSA 132:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>jan li te sèmante a SENYÈ a,</para>
  <para style="q1" vid="PSA 132:2">e te fè ve a Toupwisan a Jacob la:<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>Anverite, mwen p ap antre <note caller="+" style="x"><char style="xo" closed="false">132:3 </char><char style="xt" closed="false"><ref loc="JOB 21:28">Job 21:28</ref></char></note>lakay mwen,</para>
  <para style="q1" vid="PSA 132:3">ni kouche sou kabann mwen;<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>mwen p ap <note caller="+" style="x"><char style="xo" closed="false">132:4 </char><char style="xt" closed="false"><ref loc="PRO 6:4">Pwov 6:4</ref></char></note>kite zye m dòmi,</para>
  <para style="q1" vid="PSA 132:4">ni pòpyè zye m fèmen,<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>jiskaske m jwenn yon <note caller="+" style="x"><char style="xo" closed="false">132:5 </char><char style="xt" closed="false"><ref loc="1KI 8:17">I Wa 8:17</ref></char></note>kote pou SENYÈ a,</para>
  <para style="q1" vid="PSA 132:5">yon abitasyon pou Toupwisan a Jacob la.<verse eid="PSA 132:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>Men koute, nou te tande koze sa a nan <note caller="+" style="x"><char style="xo" closed="false">132:6 </char><char style="xt" closed="false"><ref loc="GEN 35:19">Jen 35:19</ref></char></note>Éphrata,</para>
  <para style="q1" vid="PSA 132:6">nou te twouve l nan plèn Jaar a.<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>Annou antre nan abitasyon Li a.</para>
  <para style="q1" vid="PSA 132:7">Annou fè adorasyon kote machpye twòn Li an ye a.<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>Leve, O SENYÈ, vini nan plas repo Ou a,</para>
  <para style="q1" vid="PSA 132:8">Ou menm avèk lach fòs Ou.<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>Kite prèt Ou yo <note caller="+" style="x"><char style="xo" closed="false">132:9 </char><char style="xt" closed="false"><ref loc="GEN 35:19">Jen 35:19</ref></char></note>abiye nan ladwati, e</para>
  <para style="q1" vid="PSA 132:9">kite fidèl Ou yo chante ak lajwa.<verse eid="PSA 132:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>Pou koz David, sèvitè Ou a, pa vire fas kont <note caller="+" style="x"><char style="xo" closed="false">132:10 </char><char style="xt" closed="false"><ref loc="PSA 2:2">Sòm 2:2</ref></char></note>onksyone Ou a.<verse eid="PSA 132:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>SENYÈ a te sèmante a David anverite.</para>
  <para style="q1" vid="PSA 132:11">Sou sila Li p ap fè bak:</para>
  <para style="q1" vid="PSA 132:11">“Nan fwi a kò Ou, mwen va etabli sou twòn Ou.<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>Si fis ou yo kenbe akò Mwen ak</para>
  <para style="q1" vid="PSA 132:12">temwayaj ke Mwen va enstwi yo,</para>
  <para style="q1" vid="PSA 132:12">fis pa yo tou va <note caller="+" style="x"><char style="xo" closed="false">132:12 </char><char style="xt" closed="false"><ref loc="LUK 1:32">Luc 1:32</ref></char></note>chita sou twòn Ou an jis pou tout tan.”<verse eid="PSA 132:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>Paske SENYÈ a te <note caller="+" style="x"><char style="xo" closed="false">132:13 </char><char style="xt" closed="false"><ref loc="PSA 48:1-2">Sòm 48:1-2</ref></char></note> chwazi Sion.</para>
  <para style="q1" vid="PSA 132:13">Li te vle l pou abitasyon Li.<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“Sa se <note caller="+" style="x"><char style="xo" closed="false">132:14 </char><char style="xt" closed="false"><ref loc="PSA 132:8">Sòm 132:8</ref></char></note>plas repo Mwen, jis pou tout tan.</para>
  <para style="q1" vid="PSA 132:14">Isit la Mwen va rete, paske Mwen te vle sa.<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>Mwen va beni pwovizyon li ak abondans.</para>
  <para style="q1" vid="PSA 132:15">Mwen va satisfè malere li yo ak pen.<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>Anplis, Mwen va abiye <note caller="+" style="x"><char style="xo" closed="false">132:16 </char><char style="xt" closed="false"><ref loc="2CH 6:41">II Kwo 6:41</ref></char></note>prèt li yo ak Sali,</para>
  <para style="q1" vid="PSA 132:16">e fidèl li yo va chante byen fò ak lajwa.<verse eid="PSA 132:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>La Mwen va koze kòn a David la boujonnen pou l parèt.</para>
  <para style="q1" vid="PSA 132:17">Mwen te prepare yon <note caller="+" style="x"><char style="xo" closed="false">132:17 </char><char style="xt" closed="false"><ref loc="1KI 11:36">I Wa 11:36</ref></char></note>lanp pou onksyone pa M nan.<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>Lènmi li yo, Mwen va abiye yo ak wont.</para>
  <para style="q1" vid="PSA 132:18">Men sou li menm, <note caller="+" style="x"><char style="xo" closed="false">132:18 </char><char style="xt" closed="false"><ref loc="PSA 21:3">Sòm 21:3</ref></char></note>kouwòn li an va briye.”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="d">Yon chan pou monte vè tanp lan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>Gade byen, a la bon e agreyab</para>
  <para style="q1" vid="PSA 133:1">pou <note caller="+" style="x"><char style="xo" closed="false">133:1 </char><char style="xt" closed="false"><ref loc="GEN 13:8">Jen 13:8</ref></char></note>frè yo viv ak tèt ansanm!<verse eid="PSA 133:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>Se tankou <note caller="+" style="x"><char style="xo" closed="false">133:2 </char><char style="xt" closed="false"><ref loc="EXO 29:7">Egz 29:7</ref></char></note>lwil presye ki koule sou tèt,</para>
  <para style="q1" vid="PSA 133:2">vin desann jis sou bab, menm bab Aaron,</para>
  <para style="q1" vid="PSA 133:2">vin desann rive sou kote vètman li.<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>Se tankou lawouze Mòn Hermon</para>
  <para style="q1" vid="PSA 133:3">ki vin desann sou mòn Sion nan;</para>
  <para style="q1" vid="PSA 133:3">paske la, SENYÈ a te kòmande</para>
  <para style="q1" vid="PSA 133:3">benediksyon an——<note caller="+" style="x"><char style="xo" closed="false">133:3 </char><char style="xt" closed="false"><ref loc="PSA 21:4">Sòm 21:4</ref></char></note>lavi jis pou tout tan.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="d">Yon chan pou monte vè tanp lan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>Gade byen! <note caller="+" style="x"><char style="xo" closed="false">134:1 </char><char style="xt" closed="false"><ref loc="PSA 103:21">Sòm 103:21</ref></char></note>Beni SENYÈ a, tout sèvitè SENYÈ yo,</para>
  <para style="q1" vid="PSA 134:1">Ki sèvi pandan lannwit lakay SENYÈ a!<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">134:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:2">Sòm 28:2</ref>
      </char>
    </note>Leve men nou vè sanktiyè a, e beni SENYÈ a.<verse eid="PSA 134:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>Ke SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">134:3 </char><char style="xt" closed="false"><ref loc="PSA 128:5">Sòm 128:5</ref></char></note>beni ou soti nan Sion,</para>
  <para style="q1" vid="PSA 134:3">Sila ki te fè syèl la avèk tè a.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">135:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 113:1">Sòm 113:1</ref>
      </char>
    </note>Beni SENYÈ a!</para>
  <para style="q1" vid="PSA 135:1">Beni non SENYÈ a!</para>
  <para style="q1" vid="PSA 135:1">Beni Li, O sèvitè a SENYÈ yo,<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>nou menm ki kanpe lakay SENYÈ a,</para>
  <para style="q1" vid="PSA 135:2">nan <note caller="+" style="x"><char style="xo" closed="false">135:2 </char><char style="xt" closed="false"><ref loc="PSA 92:13">Sòm 92:13</ref></char></note>lakou lakay SENYÈ nou an!<verse eid="PSA 135:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>Beni SENYÈ a, paske <note caller="+" style="x"><char style="xo" closed="false">135:3 </char><char style="xt" closed="false"><ref loc="PSA 100:5">Sòm 100:5</ref></char></note>SENYÈ a bon.</para>
  <para style="q1" vid="PSA 135:3">Chante lwanj a non Li, paske sa bèl.<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>Paske SENYÈ a te chwazi Jacob pou Li menm,</para>
  <para style="q1" vid="PSA 135:4">Israël pou pwòp <note caller="+" style="x"><char style="xo" closed="false">135:4 </char><char style="xt" closed="false"><ref loc="EXO 19:5">Egz 19:5</ref></char></note>posesyon pa Li.<verse eid="PSA 135:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>Paske mwen konnen ke SENYÈ a gran,</para>
  <para style="q1" vid="PSA 135:5">e ke SENYÈ nou an <note caller="+" style="x"><char style="xo" closed="false">135:5 </char><char style="xt" closed="false"><ref loc="PSA 97:9">Sòm 97:9</ref></char></note>pi wo ke tout dye yo.<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">135:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:3">Sòm 115:3</ref>
      </char>
    </note>Nenpòt sa ke SENYÈ a vle, Li fè l,</para>
  <para style="q1" vid="PSA 135:6">nan syèl la oswa sou tè a,</para>
  <para style="q1" vid="PSA 135:6">nan lanmè yo ak nan tout fon yo.<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>Li fè vapè monte soti nan tout pwent tè yo.</para>
  <para style="q1" vid="PSA 135:7">Ki <note caller="+" style="x"><char style="xo" closed="false">135:7 </char><char style="xt" closed="false"><ref loc="JER 10:13">Jr 10:13</ref></char></note>fè rive loray avèk lapli yo,</para>
  <para style="q1" vid="PSA 135:7">ki fè van vin parèt sòti nan trezò Li yo.<verse eid="PSA 135:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>Li te <note caller="+" style="x"><char style="xo" closed="false">135:8 </char><char style="xt" closed="false"><ref loc="EXO 12:12">Egz 12:12</ref></char></note>frape premye ne Égypte yo,</para>
  <para style="q1" vid="PSA 135:8">ni lòm, ni bèt.<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>Li te voye <note caller="+" style="x"><char style="xo" closed="false">135:9 </char><char style="xt" closed="false"><ref loc="EXO 7:10">Egz 7:10</ref></char></note>sign ak mèvèy nan mitan nou, O Égypte,</para>
  <para style="q1" vid="PSA 135:9">sou Farawon avèk tout sèvitè Li yo.<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>Li te <note caller="+" style="x"><char style="xo" closed="false">135:10 </char><char style="xt" closed="false"><ref loc="PSA 44:2">Sòm 44:2</ref></char></note>frape anpil nasyon,</para>
  <para style="q1" vid="PSA 135:10">e te detwi wa pwisan yo,<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>Sihon, wa Amoreyen yo, Og,</para>
  <para style="q1" vid="PSA 135:11">wa Basan ak tout wayòm a Canaan yo.<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>Epi Li te <note caller="+" style="x"><char style="xo" closed="false">135:12 </char><char style="xt" closed="false"><ref loc="DEU 29:8">Det 29:8</ref></char></note>bay yo peyi yo kon eritaj,</para>
  <para style="q1" vid="PSA 135:12">yon eritaj a Israël, pèp Li a.<verse eid="PSA 135:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">135:13 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 3:15">Egz 3:15</ref>
      </char>
    </note>Non Ou, O SENYÈ, dire jis pou tout tan,</para>
  <para style="q1" vid="PSA 135:13">Memwa Ou, O SENYÈ, pou tout jenerasyon yo.<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>Paske SENYÈ a va <note caller="+" style="x"><char style="xo" closed="false">135:14 </char><char style="xt" closed="false"><ref loc="DEU 32:26">Det 32:26</ref></char></note>jije pèp Li a, e</para>
  <para style="q1" vid="PSA 135:14">va gen konpasyon pou sèvitè Li yo.<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">135:15 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:4-8">Sòm 115:4-8</ref>
      </char>
    </note>Zidòl a nasyon yo pa anyen sof ke ajan ak lò,</para>
  <para style="q1" vid="PSA 135:15">zèv a men a lòm.<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>Yo gen bouch, men yo pa pale.</para>
  <para style="q1" vid="PSA 135:16">Yo gen zye, men yo pa wè.<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>Yo gen zòrèy, men yo pa tande,</para>
  <para style="q1" vid="PSA 135:17">ni nanpwen souf nan bouch yo.<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>Sila ki fè yo va vin tankou yo.</para>
  <para style="q1" vid="PSA 135:18">Wi, tout sila ki mete konfyans nan yo.<verse eid="PSA 135:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>O lakay <note caller="+" style="x"><char style="xo" closed="false">135:19 </char><char style="xt" closed="false"><ref loc="PSA 115:9">Sòm 115:9</ref></char></note>Israël, beni SENYÈ a!</para>
  <para style="q1" vid="PSA 135:19">O lakay Aaron, Beni SENYÈ a!<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>O lakay Lévi, beni SENYÈ a!</para>
  <para style="q1" vid="PSA 135:20">Nou menm <note caller="+" style="x"><char style="xo" closed="false">135:20 </char><char style="xt" closed="false"><ref loc="PSA 118:4">Sòm 118:4</ref></char></note>ki gen lakrent SENYÈ a, beni SENYÈ a!<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>Ke SENYÈ a beni soti <note caller="+" style="x"><char style="xo" closed="false">135:21 </char><char style="xt" closed="false"><ref loc="PSA 128:5">Sòm 128:5</ref></char></note>nan Sion,</para>
  <para style="q1" vid="PSA 135:21">Sila ki abite Jérusalem nan,</para>
  <para style="q1" vid="PSA 135:21">Beni SENYÈ a!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">136:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">I Kwo 16:34</ref>
      </char>
    </note>Bay remèsiman a SENYÈ a, paske Li Bon,</para>
  <para style="q1" vid="PSA 136:1">paske lanmou dous Li a dire jis pou tout tan.<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>Bay remèsiman a <note caller="+" style="x"><char style="xo" closed="false">136:2 </char><char style="xt" closed="false"><ref loc="DEU 10:17">Det 10:17</ref></char></note> Bondye anwo tout dye yo,</para>
  <para style="q1" vid="PSA 136:2">paske lanmou dous Li a dire jis pou tout tan.<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>Bay remèsiman a Senyè de tout senyè yo,</para>
  <para style="q1" vid="PSA 136:3">paske lanmou dous li a dire jis pou tout tan;<verse eid="PSA 136:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>A Sila <note caller="+" style="x"><char style="xo" closed="false">136:4 </char><char style="xt" closed="false"><ref loc="DEU 6:22">Det 6:22</ref></char></note>sèl ki fè gwo mèvèy yo,</para>
  <para style="q1" vid="PSA 136:4">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>A Sila ki ak gran kapasite te fè syèl la,</para>
  <para style="q1" vid="PSA 136:5">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>a Sila ki te <note caller="+" style="x"><char style="xo" closed="false">136:6 </char><char style="xt" closed="false"><ref loc="GEN 1:2-9">Jen 1:2-9</ref></char></note>ranje tè a anwo dlo yo,</para>
  <para style="q1" vid="PSA 136:6">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>a Sila ki te <note caller="+" style="x"><char style="xo" closed="false">136:7 </char><char style="xt" closed="false"><ref loc="GEN 1:14-18">Jen 1:14-18</ref></char></note>fè gran limyè yo,</para>
  <para style="q1" vid="PSA 136:7">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">136:8 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:16">Jen 1:16</ref>
      </char>
    </note>solèy ki pou domine lajounen an,</para>
  <para style="q1" vid="PSA 136:8">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>Lalin ak zetwal pou domine lannwit,</para>
  <para style="q1" vid="PSA 136:9">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>A Sila ki te <note caller="+" style="x"><char style="xo" closed="false">136:10 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Egz 12:29</ref></char></note>frape Ejipsyen yo nan premye ne yo,</para>
  <para style="q1" vid="PSA 136:10">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>ki te <note caller="+" style="x"><char style="xo" closed="false">136:11 </char><char style="xt" closed="false"><ref loc="EXO 12:51">Egz 12:51</ref></char></note>mennen Israël fè l sòti nan mitan yo,</para>
  <para style="q1" vid="PSA 136:11">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>Avèk yon men fò ak yon bra <note caller="+" style="x"><char style="xo" closed="false">136:12 </char><char style="xt" closed="false"><ref loc="EXO 6:1-6">Egz 6:1-6</ref> </char></note>lonje nèt,</para>
  <para style="q1" vid="PSA 136:12">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>a Sila ki te <note caller="+" style="x"><char style="xo" closed="false">136:13 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Egz 14:21</ref></char></note>divize Lanmè Wouj fè de bò a,</para>
  <para style="q1" vid="PSA 136:13">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>ki te fè Israël pase nan mitan li,</para>
  <para style="q1" vid="PSA 136:14">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>men <note caller="+" style="x"><char style="xo" closed="false">136:15 </char><char style="xt" closed="false"><ref loc="EXO 14:27">Egz 14:27</ref></char></note>Li te boulvèse Farawon ak lame li a nan Lanmè Wouj la,</para>
  <para style="q1" vid="PSA 136:15">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>a Sila ki te <note caller="+" style="x"><char style="xo" closed="false">136:16 </char><char style="xt" closed="false"><ref loc="EXO 13:18">Egz 13:18</ref></char></note>mennen pèp Li a nan dezè a,</para>
  <para style="q1" vid="PSA 136:16">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>a Sila ki te <note caller="+" style="x"><char style="xo" closed="false">136:17 </char><char style="xt" closed="false"><ref loc="PSA 135:10-12">Sòm 135:10-12</ref></char></note>frape gran wa yo,</para>
  <para style="q1" vid="PSA 136:17">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>ki te <note caller="+" style="x"><char style="xo" closed="false">136:18 </char><char style="xt" closed="false"><ref loc="DEU 29:7">Det 29:7</ref></char></note>touye wa pwisan yo,</para>
  <para style="q1" vid="PSA 136:18">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">136:19 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:21-24">Nonb 21:21-24</ref>
      </char>
    </note>Sihon, wa Amoreyen an,</para>
  <para style="q1" vid="PSA 136:19">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>ak <note caller="+" style="x"><char style="xo" closed="false">136:20 </char><char style="xt" closed="false"><ref loc="NUM 21:33-35">Nonb 21:33-35</ref></char></note>Og, wa Basan an,</para>
  <para style="q1" vid="PSA 136:20">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>e te <note caller="+" style="x"><char style="xo" closed="false">136:21 </char><char style="xt" closed="false"><ref loc="JOS 12:1">Jos 12:1</ref></char></note>bay peyi yo kon eritaj,</para>
  <para style="q1" vid="PSA 136:21">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>menm yon eritaj a Israël, <note caller="+" style="x"><char style="xo" closed="false">136:22 </char><char style="xt" closed="false"><ref loc="PSA 105:6">Sòm 105:6</ref></char></note>sèvitè Li a,</para>
  <para style="q1" vid="PSA 136:22">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>ki te <note caller="+" style="x"><char style="xo" closed="false">136:23 </char><char style="xt" closed="false"><ref loc="PSA 9:12">Sòm 9:12</ref></char></note>sonje nou nan eta imilyasyon nou yo,</para>
  <para style="q1" vid="PSA 136:23">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>epi ki te <note caller="+" style="x"><char style="xo" closed="false">136:24 </char><char style="xt" closed="false"><ref loc="JDG 6:9">Jij 6:9</ref></char></note>delivre nou nan men advèsè nou yo,</para>
  <para style="q1" vid="PSA 136:24">paske lanmou dous Li a dire jis pou tout tan;<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>ki <note caller="+" style="x"><char style="xo" closed="false">136:25 </char><char style="xt" closed="false"><ref loc="PSA 104:27">Sòm 104:27</ref></char></note>bay manje a tout chè,</para>
  <para style="q1" vid="PSA 136:25">paske lanmou dous Li a dire jis pou tout tan.<verse eid="PSA 136:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>Bay remèsiman a <note caller="+" style="x"><char style="xo" closed="false">136:26 </char><char style="xt" closed="false"><ref loc="PSA 104:27">Sòm 104:27</ref></char></note>Bondye syèl la,</para>
  <para style="q1" vid="PSA 136:26">paske lanmou dous Li a dire jis pou tout tan.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>Bò rivyè a Babylone yo, se la nou te chita.</para>
  <para style="q1" vid="PSA 137:1">Nou te <note caller="+" style="x"><char style="xo" closed="false">137:1 </char><char style="xt" closed="false"><ref loc="NEH 1:4">Né 1:4</ref></char></note>kriye, lè nou te sonje Sion.<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>Sou pye <note caller="+" style="x"><char style="xo" closed="false">137:2 </char><char style="xt" closed="false"><ref loc="LEV 23:40">Lev 23:40</ref></char></note>sikrèn nan mitan li an, nou te pandye ap nou yo.<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>Paske la, ravisè nou yo te mande nou chante pou yo,</para>
  <para style="q1" vid="PSA 137:3">e <note caller="+" style="x"><char style="xo" closed="false">137:3 </char><char style="xt" closed="false"><ref loc="ISA 49:17">És 49:17</ref></char></note>bouwo nou yo ak gwo kè kontan, t ap di:</para>
  <para style="q1" vid="PSA 137:3">“Chante pou nou youn nan chanson Sion yo.”<verse eid="PSA 137:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>Kijan pou nou ta chante <note caller="+" style="x"><char style="xo" closed="false">137:4 </char><char style="xt" closed="false"><ref loc="2CH 29:27">II Kwo 29:27</ref></char></note>chan SENYÈ a nan yon peyi etranje?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>Si mwen <note caller="+" style="x"><char style="xo" closed="false">137:5 </char><char style="xt" closed="false"><ref loc="ISA 65:11">És 65:11</ref></char></note>ta bliye ou, O Jérusalem, kite men</para>
  <para style="q1" vid="PSA 137:5">dwat mwen bliye kapasite li.<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>Ke lang mwen kole rèd anlè bouch mwen,</para>
  <para style="q1" vid="PSA 137:6">Si m pa ta sonje ou, si m pa ta <note caller="+" style="x"><char style="xo" closed="false">137:6 </char><char style="xt" closed="false"><ref loc="NEH 2:3">Né 2:3</ref></char></note>leve Jérusalem wo,</para>
  <para style="q1" vid="PSA 137:6">pi wo ke pi gwo plezi m yo.<verse eid="PSA 137:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>Sonje, O SENYÈ, kont fis a Édom yo, jou a Jérusalem nan,</para>
  <para style="q1" vid="PSA 137:7">ke yo te di: “Raze l nèt!</para>
  <para style="q1" vid="PSA 137:7">Raze l <note caller="+" style="x"><char style="xo" closed="false">137:7 </char><char style="xt" closed="false"><ref loc="PSA 74:7">Sòm 74:7</ref> </char></note>jis rive nan fondasyon li.”<verse eid="PSA 137:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>O fi a Babylone nan, Ou menm ki te <note caller="+" style="x"><char style="xo" closed="false">137:8 </char><char style="xt" closed="false"><ref loc="ISA 13:1-22">És 13:1-22</ref></char></note>devaste nou an,</para>
  <para style="q1" vid="PSA 137:8">A la beni sila ki rekonpanse ou ak menm</para>
  <para style="q1" vid="PSA 137:8">rekonpans ke ou te rekonpanse nou an va beni!<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>A la beni sila ki sezi pitit ou yo,</para>
  <para style="q1" vid="PSA 137:9">e ki <note caller="+" style="x"><char style="xo" closed="false">137:9 </char><char style="xt" closed="false"><ref loc="2KI 8:12">II Wa 8:12</ref></char></note>kraze yo nan wòch la va beni!<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="d">Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">138:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 111:1">Sòm 111:1</ref>
      </char>
    </note>Mwen va bay Ou remèsiman avèk tout kè m.</para>
  <para style="q1" vid="PSA 138:1">Mwen va chante lwanj a Ou devan lòt dye yo.<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>Mwen va pwostène mwen <note caller="+" style="x"><char style="xo" closed="false">138:2 </char><char style="xt" closed="false"><ref loc="1KI 8:29">I Wa 8:29</ref></char></note>vè sen tanp Ou a,</para>
  <para style="q1" vid="PSA 138:2">e bay remèsiman a non Ou pou lanmou dous Ou ak verite Ou a;</para>
  <para style="q1" vid="PSA 138:2">Paske Ou te bay glwa a Non ak Pawòl Ou plis ke tout bagay.<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>Nan jou ke m te rele Ou a, Ou te reponn mwen.</para>
  <para style="q1" vid="PSA 138:3">Ou te fè m plen ak kouraj ak <note caller="+" style="x"><char style="xo" closed="false">138:3 </char><char style="xt" closed="false"><ref loc="PSA 28:7">Sòm 28:7</ref></char></note>fòs nan nanm mwen.<verse eid="PSA 138:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">138:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:11">Sòm 72:11</ref>
      </char>
    </note>Tout wa sou latè yo va ba Ou remèsiman, O SENYÈ,</para>
  <para style="q1" vid="PSA 138:4">lè yo fin tande pawòl a bouch Ou.<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>Wi, yo va chante sou chemen SENYÈ a,</para>
  <para style="q1" vid="PSA 138:5">paske <note caller="+" style="x"><char style="xo" closed="false">138:5 </char><char style="xt" closed="false"><ref loc="PSA 21:5">Sòm 21:5</ref></char></note>gran se glwa SENYÈ a.<verse eid="PSA 138:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>Paske malgre SENYÈ a egzalte,</para>
  <para style="q1" vid="PSA 138:6">Li toujou okipe sila ki ba yo.</para>
  <para style="q1" vid="PSA 138:6">Men moun ki <note caller="+" style="x"><char style="xo" closed="false">138:6 </char><char style="xt" closed="false"><ref loc="PSA 40:4">Sòm 40:4</ref></char></note>ògeye yo,</para>
  <para style="q1" vid="PSA 138:6">Li rekonèt yo de lwen.<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>Malgre mwen mache nan mitan gwo twoub,</para>
  <para style="q1" vid="PSA 138:7">Ou va fè m <note caller="+" style="x"><char style="xo" closed="false">138:7 </char><char style="xt" closed="false"><ref loc="EZK 9:8-9">Éz 9:8-9</ref></char></note>reprann mwen.</para>
  <para style="q1" vid="PSA 138:7">Ou va lonje fè parèt men Ou kont kòlè ènmi m yo.</para>
  <para style="q1" vid="PSA 138:7">Men dwat Ou va sove mwen.<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>SENYÈ a va akonpli sa ki konsène mwen an.</para>
  <para style="q1" vid="PSA 138:8">Lanmou dous Ou a, O SENYÈ, se pou tout tan.</para>
  <para style="q1" vid="PSA 138:8">Pa abandone zèv men Ou yo.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="d">Pou direktè koral la; Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>O SENYÈ, Ou te <note caller="+" style="x"><char style="xo" closed="false">139:1 </char><char style="xt" closed="false"><ref loc="PSA 17:3">Sòm 17:3</ref></char></note>sonde mwen e te konnen mwen.<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>Ou konnen lè m chita ak lè m leve.</para>
  <para style="q1" vid="PSA 139:2">Ou konprann panse mwen yo de lwen.<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>Ou konn <note caller="+" style="x"><char style="xo" closed="false">139:3 </char><char style="xt" closed="false"><ref loc="JOB 14:16">Job 14:16</ref></char></note>egzamine chemen mwen fè avèk</para>
  <para style="q1" vid="PSA 139:3">kouche mwen, e rekonèt bagay pi entim nan chemen mwen yo.<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>Menm avan mwen gen yon pawòl sou bouch mwen,</para>
  <para style="q1" vid="PSA 139:4">Men gade, O SENYÈ, Ou <note caller="+" style="x"><char style="xo" closed="false">139:4 </char><char style="xt" closed="false"><ref loc="HEB 4:13">Eb 4:13</ref></char></note>konnen tout li menm.<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>Ou fin antoure mwen ni devan, ni dèyè e</para>
  <para style="q1" vid="PSA 139:5">Ou te <note caller="+" style="x"><char style="xo" closed="false">139:5 </char><char style="xt" closed="false"><ref loc="JOB 9:33">Job 9:33</ref></char></note>poze men Ou sou mwen.<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">139:6 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 11:33">Wo 11:33</ref>
      </char>
    </note>Konesans konsa twò mèvèye pou mwen.</para>
  <para style="q1" vid="PSA 139:6">Li twò wo.</para>
  <para style="q1" vid="PSA 139:6">Mwen pa kab rive kote l.<verse eid="PSA 139:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">139:7 </char>
      <char style="xt" closed="false">
        <ref loc="JER 23:24">Jr 23:24</ref>
      </char>
    </note>Kibò mwen kab ale kite lespri Ou?</para>
  <para style="q1" vid="PSA 139:7">Oswa kibò mwen kab sove ale pou m ta kite prezans Ou?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">139:8 </char>
      <char style="xt" closed="false">
        <ref loc="AMO 9:2-4">Am 9:2-4</ref>
      </char>
    </note>Si mwen monte nan syèl la, Ou la.</para>
  <para style="q1" vid="PSA 139:8">Si m fè kabann mwen nan sejou mò yo, men vwala, Ou la.<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>Si mwen pran zèl nan maten,</para>
  <para style="q1" vid="PSA 139:9">si m ta rete nan pati lanmè pi lwen an,<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>menm la, se men Ou k ap <note caller="+" style="x"><char style="xo" closed="false">139:10 </char><char style="xt" closed="false"><ref loc="PSA 23:2-3">Sòm 23:2-3</ref></char></note>mennen mwen,</para>
  <para style="q1" vid="PSA 139:10">e se men dwat Ou k ap kenbe m.<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>Si mwen di: “Anverite, <note caller="+" style="x"><char style="xo" closed="false">139:11 </char><char style="xt" closed="false"><ref loc="JOB 22:13">Job 22:13</ref></char></note>tenèb la va kouvri mwen,</para>
  <para style="q1" vid="PSA 139:11">e limyè ki antoure mwen an va vin fènwa,”<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>menm tenèb la pa tenèb pou Ou,</para>
  <para style="q1" vid="PSA 139:12">e fènwa a klere menm jan ak lajounen.</para>
  <para style="q1" vid="PSA 139:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">139:12 </char>
      <char style="xt" closed="false">
        <ref loc="1JN 1:5">I Jn 1:5</ref> </char>
    </note>Tenèb ak limyè se menm pou Ou menm.<verse eid="PSA 139:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>Paske se Ou menm ki te fòme pati anndan m yo.</para>
  <para style="q1" vid="PSA 139:13">Ou te <note caller="+" style="x"><char style="xo" closed="false">139:13 </char><char style="xt" closed="false"><ref loc="JOB 10:11">Job 10:11</ref></char></note>tise mwen, pyese m soti nan vant Manman m.<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>Mwen va bay Ou anpil remèsiman,</para>
  <para style="q1" vid="PSA 139:14">paske mwen fèt yon fason mèvèye.</para>
  <para style="q1" vid="PSA 139:14">Zèv Ou yo <note caller="+" style="x"><char style="xo" closed="false">139:14 </char><char style="xt" closed="false"><ref loc="PSA 40:5">Sòm 40:5</ref></char></note>depase bon konprann</para>
  <para style="q1" vid="PSA 139:14">e nanm mwen byen konnen sa.<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">139:15 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 10:8-10">Job 10:8-10</ref>
      </char>
    </note>Fòm mwen pa t kache a Ou menm lè m te fèt nan sekrè a,</para>
  <para style="q1" vid="PSA 139:15">e tise kon mèvèy etonnan nan fon tè a.<verse eid="PSA 139:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16"/>Zye Ou te wè matyè san fòm mwen.</para>
  <para style="q1" vid="PSA 139:16">Epi nan liv <note caller="+" style="x"><char style="xo" closed="false">139:16 </char><char style="xt" closed="false"><ref loc="PSA 56:8">Sòm 56:8</ref></char></note>Ou a, te deja ekri tout jou ki te</para>
  <para style="q1" vid="PSA 139:16">òdone pou mwen yo, menm lè youn nan yo potko fin rive.<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>Anplis, SENYÈ, a la presye se <note caller="+" style="x"><char style="xo" closed="false">139:17 </char><char style="xt" closed="false"><ref loc="PSA 40:5">Sòm 40:5</ref></char></note>panse Ou yo yo pou mwen!</para>
  <para style="q1" vid="PSA 139:17">A la gran, yo gran anpil!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>Si m te konte yo, yo t ap an kantite depase sab.</para>
  <para style="q1" vid="PSA 139:18">Lè m <note caller="+" style="x"><char style="xo" closed="false">139:18 </char><char style="xt" closed="false"><ref loc="PSA 3:5">Sòm 3:5</ref></char></note>leve nan dòmi, mwen toujou avèk Ou.<verse eid="PSA 139:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>O ke Ou ta <note caller="+" style="x"><char style="xo" closed="false">139:19 </char><char style="xt" closed="false"><ref loc="ISA 11:4">És 11:4</ref></char></note>touye mechan yo, O Bondye.</para>
  <para style="q1" vid="PSA 139:19">Soti sou mwen, O moun ki vèse san.<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>Paske yo <note caller="+" style="x"><char style="xo" closed="false">139:20 </char><char style="xt" closed="false"><ref loc="JUD 1:15">Jd 15</ref></char></note>pale kont Ou ak mechanste,</para>
  <para style="q1" vid="PSA 139:20">e lènmi Ou yo pran non Ou an ven.<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>Èske m pa <note caller="+" style="x"><char style="xo" closed="false">139:21 </char><char style="xt" closed="false"><ref loc="2CH 19:2">II Kwo 19:2</ref></char></note>rayi sila ki rayi Ou yo, O SENYÈ?</para>
  <para style="q1" vid="PSA 139:21">Epi èske mwen pa t blese menm de sila ki leve kont Ou yo?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>Mwen rayi yo ak yon rayisman ale nèt.</para>
  <para style="q1" vid="PSA 139:22">Yo devni lènmi m.<verse eid="PSA 139:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>Sonde mwen, O Bondye e konnen kè mwen.</para>
  <para style="q1" vid="PSA 139:23">Mete mwen a leprèv e konnen panse mwen yo.<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>Konsa, wè si gen okenn move chemen nan mwen e</para>
  <para style="q1" vid="PSA 139:24">mennen mwen nan chemen etènèl la.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="d">Pou direktè koral la; Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">140:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:13">Sòm 17:13</ref>
      </char>
    </note>Delivre m, O SENYÈ, de moun mechan yo.</para>
  <para style="q1" vid="PSA 140:1">Delivre m de moun vyolan yo:<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>ka p <note caller="+" style="x"><char style="xo" closed="false">140:2 </char><char style="xt" closed="false"><ref loc="PSA 7:14">Sòm 7:14</ref></char></note> fè manèv mechan nan kè yo.</para>
  <para style="q1" vid="PSA 140:2">Tout tan, y ap fè pwovokasyon pou fè lagè.<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>Yo file lang yo tankou koulèv.</para>
  <para style="q1" vid="PSA 140:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">140:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 58:4">Sòm 58:4</ref>
      </char>
    </note>Pwazon a sèpan mòtèl la anba lèv yo. <char style="qs">Tan</char><verse eid="PSA 140:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>Kenbe m, O SENYÈ, de men moun mechan yo.</para>
  <para style="q1" vid="PSA 140:4">Pwoteje m de moun vyolan ki te <note caller="+" style="x"><char style="xo" closed="false">140:4 </char><char style="xt" closed="false"><ref loc="PSA 36:11">Sòm 36:11</ref> </char></note>fè plan pou pye m yo ta tonbe yo.<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>Ògeye yo fin ranje yon pèlen pou mwen.</para>
  <para style="q1" vid="PSA 140:5">Avèk kòd, yo te ouvri yon pèlen bò wout la.</para>
  <para style="q1" vid="PSA 140:5">Yo fin plase yon <note caller="+" style="x"><char style="xo" closed="false">140:5 </char><char style="xt" closed="false"><ref loc="PSA 141:9">Sòm 141:9</ref></char></note>pyèj pou mwen. <char style="qs">Tan</char><verse eid="PSA 140:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>Mwen te di a SENYÈ a: “Se Ou ki Bondye mwen.”</para>
  <para style="q1" vid="PSA 140:6">Bay zòrèy, O SENYÈ, a vwa a siplikasyon mwen yo.<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>O BONDYE Senyè a, fòs a sali mwen an,</para>
  <para style="q1" vid="PSA 140:7">Ou te <note caller="+" style="x"><char style="xo" closed="false">140:7 </char><char style="xt" closed="false"><ref loc="PSA 144:10">Sòm 144:10</ref></char></note>kouvri tèt mwen nan jou batay la.<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>Pa akonpli, O SENYÈ, dezi a mechan an.</para>
  <para style="q1" vid="PSA 140:8">Pa pèmèt manèv mechan li yo, pou l pa vin leve wo. <char style="qs">Tan</char><verse eid="PSA 140:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>Epi pou chèf an tèt a sila ki antoure mwen yo,</para>
  <para style="q1" vid="PSA 140:9">pou <note caller="+" style="x"><char style="xo" closed="false">140:9 </char><char style="xt" closed="false"><ref loc="PSA 7:16">Sòm 7:16</ref></char></note>malveyans a pwòp lèv yo kapab vin kouvri yo.<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>Kite <note caller="+" style="x"><char style="xo" closed="false">140:10 </char><char style="xt" closed="false"><ref loc="PSA 11:6">Sòm 11:6</ref></char></note>chabon tou limen vin tonbe sou yo.</para>
  <para style="q1" vid="PSA 140:10">Kite yo jete nan dife,</para>
  <para style="q1" vid="PSA 140:10">nan fòs fon kote yo p ap kab leve sòti.<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>Sila ki bay kout lang yo pap vin etabli sou latè.</para>
  <para style="q1" vid="PSA 140:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">140:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:2-10">Sòm 24:2-10</ref>
      </char>
    </note>Mal la va kouri vit dèyè moun vyolans lan.<verse eid="PSA 140:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>Mwen konnen ke SENYÈ a va bay soutyen a aflije yo,</para>
  <para style="q1" vid="PSA 140:12">e fè <note caller="+" style="x"><char style="xo" closed="false">140:12 </char><char style="xt" closed="false"><ref loc="PSA 12:5">Sòm 12:5</ref></char></note>jistis pou malere a.<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>Anverite, moun dwat yo va bay remèsiman a non Ou.</para>
  <para style="q1" vid="PSA 140:13">Epi moun dwat yo va abite nan prezans Ou.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="d">Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">141:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:19">Sòm 22:19</ref>
      </char>
    </note>O SENYÈ, mwen rele non Ou.</para>
  <para style="q1" vid="PSA 141:1">Fè vit! Vin kote m!</para>
  <para style="q1" vid="PSA 141:1">Prete zòrèy Ou a vwa mwen lè m rele Ou!<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>Ke lapriyè mwen kapab konte kon lansan devan Ou;</para>
  <para style="q1" vid="PSA 141:2">lè m <note caller="+" style="x"><char style="xo" closed="false">141:2 </char><char style="xt" closed="false"><ref loc="1TI 2:8">I Tim 2:8</ref></char></note>leve men m, kon sakrifis ofrann aswè a.<verse eid="PSA 141:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>Plase yon gadyen sou bouch mwen, O SENYÈ.</para>
  <para style="q1" vid="PSA 141:3">Veye dri sou <note caller="+" style="x"><char style="xo" closed="false">141:3 </char><char style="xt" closed="false"><ref loc="MIC 7:5">Mi 7:5</ref></char></note>pòt lèv mwen yo.<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>Pa mennen kè m vè okenn mal,</para>
  <para style="q1" vid="PSA 141:4">pou pratike zèv mechan yo, avèk moun ki <note caller="+" style="x"><char style="xo" closed="false">141:4 </char><char style="xt" closed="false"><ref loc="ISA 32:6">És 32:6</ref> </char></note>fè inikite yo.</para>
  <para style="q1" vid="PSA 141:4">Ni pa kite mwen manje manje ki fèt pa yo.<verse eid="PSA 141:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>Kite moun <note caller="+" style="x"><char style="xo" closed="false">141:5 </char><char style="xt" closed="false"><ref loc="PRO 9:8">Pwov 9:8</ref></char></note>ladwati yo frape mwen.</para>
  <para style="q1" vid="PSA 141:5">Konsa, li dous.</para>
  <para style="q1" vid="PSA 141:5">Kite li korije mwen.</para>
  <para style="q1" vid="PSA 141:5">L ap tankou lwil ki koule sou tèt la.</para>
  <para style="q1" vid="PSA 141:5">Pa kite tèt mwen refize li,</para>
  <para style="q1" vid="PSA 141:5">paske lapriyè mwen toujou kont zak mechan yo.<verse eid="PSA 141:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>Jij pa yo <note caller="+" style="x"><char style="xo" closed="false">141:6 </char><char style="xt" closed="false"><ref loc="2CH 25:12">II Kwo 25:12</ref></char></note> fin jete a tè bò kote wòch yo.</para>
  <para style="q1" vid="PSA 141:6">Yo va tande pawòl mwen yo, paske yo byen pale.<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>Tankou lè yon moun laboure pou fann tè a,</para>
  <para style="q1" vid="PSA 141:7">se konsa zo nou yo fin gaye nan <note caller="+" style="x"><char style="xo" closed="false">141:7 </char><char style="xt" closed="false"><ref loc="NUM 16:32-33">Nonb 16:32-33</ref> </char></note>bouch sejou mò a.<verse eid="PSA 141:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>Paske zye mwen se sou Ou, O BONDYE, Senyè a.</para>
  <para style="q1" vid="PSA 141:8">Nan Ou, mwen kache.</para>
  <para style="q1" vid="PSA 141:8">Pa kite nanm mwen san pwotèj.<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>Sove m de dan pyèj ke yo te prepare pou mwen yo,</para>
  <para style="q1" vid="PSA 141:9">avèk <note caller="+" style="x"><char style="xo" closed="false">141:9 </char><char style="xt" closed="false"><ref loc="PSA 140:5">Sòm 140:5</ref> </char></note>pèlen a sila ki fè inikite yo.<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>Kite mechan yo <note caller="+" style="x"><char style="xo" closed="false">141:10 </char><char style="xt" closed="false"><ref loc="PSA 7:15">Sòm 7:15</ref></char></note>tonbe nan pwòp filè yo,</para>
  <para style="q1" vid="PSA 141:10">pandan mwen pase akote.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="d">Yon Sòm Refleksyon pa David lè l te nan kav la. Yon lapriyè</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>Mwen kriye fò avèk vwa mwen vè SENYÈ a.</para>
  <para style="q1" vid="PSA 142:1">Ak vwa m, mwen <note caller="+" style="x"><char style="xo" closed="false">142:1 </char><char style="xt" closed="false"><ref loc="PSA 30:8">Sòm 30:8</ref></char></note>fè siplikasyon a SENYÈ a pou m mande L mizerikòd.<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>Mwen vide plent mwen yo devan L.</para>
  <para style="q1" vid="PSA 142:2">Mwen deklare <note caller="+" style="x"><char style="xo" closed="false">142:2 </char><char style="xt" closed="false"><ref loc="PSA 77:2">Sòm 77:2</ref></char></note>pwoblèm mwen yo devan L.<verse eid="PSA 142:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>Lè <note caller="+" style="x"><char style="xo" closed="false">142:3 </char><char style="xt" closed="false"><ref loc="PSA 77:3">Sòm 77:3</ref></char></note>lespri m te fin bat anndan m,</para>
  <para style="q1" vid="PSA 142:3">Ou te konnen chemen mwen.</para>
  <para style="q1" vid="PSA 142:3">Nan wout kote m mache a, yo te sere yon pyèj pou mwen.<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>Gade adwat pou wè. Nanpwen moun ki veye pou mwen.</para>
  <para style="q1" vid="PSA 142:4">Nanpwen moun ki pou fè m chape.</para>
  <para style="q1" vid="PSA 142:4">Nanpwen moun ki pou pran swen m.<verse eid="PSA 142:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>Mwen te kriye a Ou menm, O SENYÈ.</para>
  <para style="q1" vid="PSA 142:5">Mwen te di “Se Ou menm ki <note caller="+" style="x"><char style="xo" closed="false">142:5 </char><char style="xt" closed="false"><ref loc="PSA 91:2-9">Sòm 91:2-9</ref></char></note>sekou mwen,</para>
  <para style="q1" vid="PSA 142:5">pòsyon mwen nan peyi moun vivan yo.”<verse eid="PSA 142:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>“Prete atansyon a kri mwen yo, paske mwen vin desann ba nèt.</para>
  <para style="q1" vid="PSA 142:6">Delivre mwen nan men pèsekitè mwen yo,</para>
  <para style="q1" vid="PSA 142:6">paske yo <note caller="+" style="x"><char style="xo" closed="false">142:6 </char><char style="xt" closed="false"><ref loc="PSA 18:17">Sòm 18:17</ref> </char></note>twò fò pou mwen.<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">142:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 143:11">Sòm 143:11</ref>
      </char>
    </note>Mennen nanm mwen sòti nan prizon,</para>
  <para style="q1" vid="PSA 142:7">pou m kab bay remèsiman a non Ou.</para>
  <para style="q1" vid="PSA 142:7">Moun ladwati mwen yo va antoure mwen,</para>
  <para style="q1" vid="PSA 142:7">paske Ou va aji nan bonte Ou anvè mwen.”<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="d">Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>Tande lapriyè mwen, O SENYÈ.</para>
  <para style="q1" vid="PSA 143:1">Prete zòrèy Ou a siplikasyon mwen yo.</para>
  <para style="q1" vid="PSA 143:1">Nan fidelite Ou, reponn mwen, ak <note caller="+" style="x"><char style="xo" closed="false">143:1 </char><char style="xt" closed="false"><ref loc="PSA 71:2">Sòm 71:2</ref></char></note>ladwati Ou!<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>Konsa, pa antre nan jijman avèk sèvitè Ou a,</para>
  <para style="q1" vid="PSA 143:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">143:2 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 14:3">Job 14:3</ref>
      </char>
    </note>paske nan zye Ou, nanpwen moun vivan ki jis.<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>Paske lènmi an te pèsekite nanm mwen.</para>
  <para style="q1" vid="PSA 143:3">Li fin kraze lavi m jis rive atè.</para>
  <para style="q1" vid="PSA 143:3">Li <note caller="+" style="x"><char style="xo" closed="false">143:3 </char><char style="xt" closed="false"><ref loc="PSA 88:6">Sòm 88:6</ref></char></note>te fè m rete kote fènwa, tankou sila ki mouri lontan yo.<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>Pou sa, lespri m kraze nèt anndan m.</para>
  <para style="q1" vid="PSA 143:4">Kè m <note caller="+" style="x"><char style="xo" closed="false">143:4 </char><char style="xt" closed="false"><ref loc="LAM 3:11">Lam 3:11</ref></char></note>nan gwo twoub anndan m.<verse eid="PSA 143:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>Mwen sonje ansyen jou yo.</para>
  <para style="q1" vid="PSA 143:5">Mwen reflechi tout tan sou tout sa Ou te fè.</para>
  <para style="q1" vid="PSA 143:5">Mwen panse sou zèv men Ou yo.<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>Mwen lonje men m vè Ou menm.</para>
  <para style="q1" vid="PSA 143:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">143:6 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:2">Sòm 42:2</ref>
      </char>
    </note>Nanm mwen fè gwo anvi pou Ou, kon yon peyi deseche.<verse eid="PSA 143:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>Reponn mwen vit, O SENYÈ, lespri m vin febli;</para>
  <para style="q1" vid="PSA 143:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">143:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:9">Sòm 27:9</ref>
      </char>
    </note>Pa kache figi Ou sou mwen, oswa mwen va vini kon sila ki desann nan fòs yo.<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>Kite mwen tande lanmou dous Ou a nan granmmaten,</para>
  <para style="q1" vid="PSA 143:8">paske mwen mete konfyans mwen nan Ou.</para>
  <para style="q1" vid="PSA 143:8">Enstwi mwen nan chemen ke m ta dwe mache a,</para>
  <para style="q1" vid="PSA 143:8">paske se a Ou ke mwen <note caller="+" style="x"><char style="xo" closed="false">143:8 </char><char style="xt" closed="false"><ref loc="PSA 86:4">Sòm 86:4</ref> </char></note>leve nanm mwen.<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">143:9 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:15">Sòm 31:15</ref>
      </char>
    </note>Delivre mwen, O SENYÈ, de lènmi mwen yo.</para>
  <para style="q1" vid="PSA 143:9">Mwen kache nan Ou.<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>Enstwi mwen pou fè volonte Ou,</para>
  <para style="q1" vid="PSA 143:10">paske se Ou menm ki Bondye mwen.</para>
  <para style="q1" vid="PSA 143:10">Lespri Ou bon.</para>
  <para style="q1" vid="PSA 143:10">Kondwi mwen sou tèren ladwati a.<verse eid="PSA 143:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">143:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:11">Sòm 25:11</ref>
      </char>
    </note>Pou koz a non Ou, O SENYÈ, fè m reprann fòs mwen.</para>
  <para style="q1" vid="PSA 143:11">Nan ladwati Ou, mennen nanm mwen sòti nan gwo twoub la.<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>Epi nan lanmou dous Ou a, fè lennmi m yo koupe retire nèt.</para>
  <para style="q1" vid="PSA 143:12">
    <note caller="+" style="x">
      <char style="xo" closed="false">143:12 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 54:5">Sòm 54:5</ref>
      </char>
    </note>Detwi tout sila ki aflije nanm mwen yo,</para>
  <para style="q1" vid="PSA 143:12">paske mwen se sèvitè Ou.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="d">Yon Sòm David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>Beni se SENYÈ a, wòch mwen an,</para>
  <para style="q1" vid="PSA 144:1">ki <note caller="+" style="x"><char style="xo" closed="false">144:1 </char><char style="xt" closed="false"><ref loc="2SA 22:35">II Sam 22:35</ref></char></note>enstwi men m pou fè lagè,</para>
  <para style="q1" vid="PSA 144:1">ak dwèt mwen pou batay.<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>Lanmou dous mwen e sitadèl mwen an,</para>
  <para style="q1" vid="PSA 144:2">
    <note caller="+" style="x">
      <char style="xo" closed="false">144:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 59:9">Sòm 59:9</ref>
      </char>
    </note>Fòterès mwen ak liberatè mwen an,</para>
  <para style="q1" vid="PSA 144:2">Boukliye mwen an nan sila mwen kache a,</para>
  <para style="q1" vid="PSA 144:2">Ki soumèt pèp mwen an anba m.<verse eid="PSA 144:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>O SENYÈ, <note caller="+" style="x"><char style="xo" closed="false">144:3 </char><char style="xt" closed="false"><ref loc="PSA 8:4">Sòm 8:4</ref></char></note>se kisa lòm nan ye pou Ou panse a li?</para>
  <para style="q1" vid="PSA 144:3">Oswa fis a lòm nan pou Ou panse a Li?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">144:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:11">Sòm 39:11</ref>
      </char>
    </note>Lòm se tankou yon sèl souf.</para>
  <para style="q1" vid="PSA 144:4">Jou li yo se tankou yon lonbraj k ap pase.<verse eid="PSA 144:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>Bese syèl Ou yo, O SENYÈ e desann.</para>
  <para style="q1" vid="PSA 144:5">Touche mòn yo pou yo kab fè lafimen.<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>Fè parèt <note caller="+" style="x"><char style="xo" closed="false">144:6 </char><char style="xt" closed="false"><ref loc="PSA 18:14">Sòm 18:14</ref></char></note>eklè pou gaye yo.</para>
  <para style="q1" vid="PSA 144:6">Voye flèch Ou pou mete yo nan konfizyon.<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>Lonje men Ou soti anwo.</para>
  <para style="q1" vid="PSA 144:7">Fè m sekou!</para>
  <para style="q1" vid="PSA 144:7">Delivre m sòti nan gwo dlo yo,</para>
  <para style="q1" vid="PSA 144:7">nan men <note caller="+" style="x"><char style="xo" closed="false">144:7 </char><char style="xt" closed="false"><ref loc="PSA 18:44">Sòm 18:44</ref> </char></note>etranje yo ak<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>bouch kap pale manti yo e <note caller="+" style="x"><char style="xo" closed="false">144:8 </char><char style="xt" closed="false"><ref loc="GEN 14:22">Jen 14:22</ref></char></note>men</para>
  <para style="q1" vid="PSA 144:8">dwat a sila ki se men dwat a manti yo.<verse eid="PSA 144:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>Mwen va chante yon <note caller="+" style="x"><char style="xo" closed="false">144:9 </char><char style="xt" closed="false"><ref loc="PSA 33:3">Sòm 33:3</ref></char></note>chan tounèf a Ou menm, O Bondye;</para>
  <para style="q1" vid="PSA 144:9">Sou ap dis kòd yo, mwen va chante lwanj a Ou menm,<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>Ki konn sove wa yo, ki fè David, sèvitè Li a,</para>
  <para style="q1" vid="PSA 144:10">
    <note caller="+" style="x">
      <char style="xo" closed="false">144:10 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 18:7">II Sam 18:7</ref> </char>
    </note>chape de nepe lanmò a.<verse eid="PSA 144:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>Fè m sekou e delivre m de men a <note caller="+" style="x"><char style="xo" closed="false">144:11 </char><char style="xt" closed="false"><ref loc="PSA 18:44">Sòm 18:44</ref></char></note>etranje yo,</para>
  <para style="q1" vid="PSA 144:11">Bouch a sila ki pale desepsyon yo,</para>
  <para style="q1" vid="PSA 144:11">e men dwat a sila ki men dwat a manti yo.<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>Kite fis nou yo nan jenès yo parèt tankou plant ki fin grandi,</para>
  <para style="q1" vid="PSA 144:12">e fi nou yo tankou pilye taye ki pou ta embeli yon palè wayal.<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>Kite <note caller="+" style="x"><char style="xo" closed="false">144:13 </char><char style="xt" closed="false"><ref loc="PRO 3:9-10">Pwov 3:9-10</ref></char></note>depo nou yo toujou plen, nan bay tout kalite pwodwi.</para>
  <para style="q1" vid="PSA 144:13">Kite twoupo nou yo pwodwi dè milye e dè di milye nan chan nou yo.<verse eid="PSA 144:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14"/>Kite bèf nou yo ka pote gwo chaj.</para>
  <para style="q1" vid="PSA 144:14">Pou nou pa gen kase kay, ni kouri kite, e</para>
  <para style="q1" vid="PSA 144:14">nanpwen moun k ap <note caller="+" style="x"><char style="xo" closed="false">144:14 </char><char style="xt" closed="false"><ref loc="ISA 24:11">És 24:11</ref></char></note>rele “anmwey” nan lari nou yo.<verse eid="PSA 144:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>A la beni pèp ki ranje konsa beni!</para>
  <para style="q1" vid="PSA 144:15">A la <note caller="+" style="x"><char style="xo" closed="false">144:15 </char><char style="xt" closed="false"><ref loc="PSA 33:12">Sòm 33:12</ref></char></note>beni pèp ki gen Bondye pou SENYÈ yo beni.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="d">Yon chan lwanj pa David</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>Mwen va <note caller="+" style="x"><char style="xo" closed="false">145:1 </char><char style="xt" closed="false"><ref loc="PSA 30:1">Sòm 30:1</ref></char></note>leve Ou wo,</para>
  <para style="q1" vid="PSA 145:1">O Bondye mwen, O Wa a.</para>
  <para style="q1" vid="PSA 145:1">Mwen va beni non Ou pou tout tan e pou tout tan.<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>Chak jou, mwen va beni Ou e mwen</para>
  <para style="q1" vid="PSA 145:2">va louwe non Ou pou tout tan e pou tout tan.<verse eid="PSA 145:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>Gran se SENYÈ a, dign de lwanj.</para>
  <para style="q1" vid="PSA 145:3">
    <note caller="+" style="x">
      <char style="xo" closed="false">145:3 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:9">Job 5:9</ref>
      </char>
    </note>Grandè Li pa kab fin sonde menm.<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>Yon <note caller="+" style="x"><char style="xo" closed="false">145:4 </char><char style="xt" closed="false"><ref loc="PSA 22:30-31">Sòm 22:30-31</ref></char></note>jenerasyon va louwe zèv Ou yo jis rive nan yon lòt.</para>
  <para style="q1" vid="PSA 145:4">Yo va pwoklame zèv pwisan Ou yo.<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>Sou bèlte e glwa a majeste Ou</para>
  <para style="q1" vid="PSA 145:5">avèk <note caller="+" style="x"><char style="xo" closed="false">145:5 </char><char style="xt" closed="false"><ref loc="PSA 119:27">Sòm 119:27</ref></char></note>zèv mèvèy Ou yo,</para>
  <para style="q1" vid="PSA 145:5">mwen va reflechi tout tan.<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>Lezòm va pale sou pouvwa a <note caller="+" style="x"><char style="xo" closed="false">145:6 </char><char style="xt" closed="false"><ref loc="DEU 10:21">Det 10:21</ref></char></note>zèv mèvèy Ou yo</para>
  <para style="q1" vid="PSA 145:6">e mwen va pale jan Ou gran.<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>Yo va pouse pale ak enpasyans sou memwa a bonte Ou.</para>
  <para style="q1" vid="PSA 145:7">Yo va rele fò ak lajwa de ladwati Ou.<verse eid="PSA 145:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">145:8 </char><char style="xt" closed="false"><ref loc="EXO 34:6">Egz 34:6</ref></char></note>plen gras avèk mizerikòd,</para>
  <para style="q1" vid="PSA 145:8">lan nan kòlè e gran nan lanmou dous Li a.<verse eid="PSA 145:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>SENYÈ a bon pou tout moun e gras Li</para>
  <para style="q1" vid="PSA 145:9">lonje rive sou tout zèv Li yo.<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">145:10 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:1">Sòm 19:1</ref>
      </char>
    </note>Tout zèv Ou yo va di Ou:</para>
  <para style="q1" vid="PSA 145:10">“Mèsi O SENYÈ,”</para>
  <para style="q1" vid="PSA 145:10">e fidèl Ou yo va beni Ou.<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>Yo va pale <note caller="+" style="x"><char style="xo" closed="false">145:11 </char><char style="xt" closed="false"><ref loc="JER 14:21">Jr 14:21</ref></char></note>glwa a wayòm Ou an, e</para>
  <para style="q1" vid="PSA 145:11">pale sou zafè pouvwa Ou yo;<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>Pou <note caller="+" style="x"><char style="xo" closed="false">145:12 </char><char style="xt" closed="false"><ref loc="JER 14:21">Jr 14:21</ref></char></note>fè rekonèt a fis a lòm yo,</para>
  <para style="q1" vid="PSA 145:12">zèv pwisan Ou yo avèk glwa ak</para>
  <para style="q1" vid="PSA 145:12">majeste a wayòm Ou an.<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>Wayòm Ou an se yon <note caller="+" style="x"><char style="xo" closed="false">145:13 </char><char style="xt" closed="false"><ref loc="PSA 10:16">Sòm 10:16</ref></char></note>wayòm etènèl</para>
  <para style="q1" vid="PSA 145:13">e règn Ou an dire pou tout jenerasyon yo.<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>SENYÈ a bay soutyen a tout moun ki tonbe.</para>
  <para style="q1" vid="PSA 145:14">Li <note caller="+" style="x"><char style="xo" closed="false">145:14 </char><char style="xt" closed="false"><ref loc="PSA 146:8">Sòm 146:8</ref></char></note>leve wo tout sila ki vin pwostène yo.<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>Zye a tout moun genyen espwa sou Ou.</para>
  <para style="q1" vid="PSA 145:15">Ou <note caller="+" style="x"><char style="xo" closed="false">145:15 </char><char style="xt" closed="false"><ref loc="PSA 104:27">Sòm 104:27</ref></char></note>bay yo manje yo nan lè yo.<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>Ou <note caller="+" style="x"><char style="xo" closed="false">145:16 </char><char style="xt" closed="false"><ref loc="PSA 104:28">Sòm 104:28</ref></char></note>ouvri men Ou pou satisfè dezi</para>
  <para style="q1" vid="PSA 145:16">a tout sila k ap viv yo.<verse eid="PSA 145:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>Senyè a <note caller="+" style="x"><char style="xo" closed="false">145:17 </char><char style="xt" closed="false"><ref loc="PSA 116:5">Sòm 116:5</ref></char></note>dwat nan tout chemen Li yo, e</para>
  <para style="q1" vid="PSA 145:17">ranpli ak bonte nan tout zèv Li yo.<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>SENYÈ a toupre tout sila ki rele Li yo,</para>
  <para style="q1" vid="PSA 145:18">tout sila ki rele li<note caller="+" style="x"><char style="xo" closed="false">145:18 </char><char style="xt" closed="false"><ref loc="JHN 4:24">Jn 4:24</ref></char></note> ak verite yo.<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>Li va <note caller="+" style="x"><char style="xo" closed="false">145:19 </char><char style="xt" closed="false"><ref loc="PSA 21:2">Sòm 21:2</ref></char></note>ranpli dezi a sila ki gen lakrent Li yo.</para>
  <para style="q1" vid="PSA 145:19">Anplis Li va tande kri yo e Li va sove yo.<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>SENYÈ a kenbe tout sila ki renmen Li yo,</para>
  <para style="q1" vid="PSA 145:20">men <note caller="+" style="x"><char style="xo" closed="false">145:20 </char><char style="xt" closed="false"><ref loc="PSA 9:5">Sòm 9:5</ref></char></note>mechan yo, Li va detwi<verse eid="PSA 145:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>Bouch mwen va pale lwanj SENYÈ a,</para>
  <para style="q1" vid="PSA 145:21">e <note caller="+" style="x"><char style="xo" closed="false">145:21 </char><char style="xt" closed="false"><ref loc="PSA 65:2">Sòm 65:2</ref></char></note>tout chè va beni sen non Li an jis pou</para>
  <para style="q1" vid="PSA 145:21">tout tan e pou tout tan.<verse eid="PSA 145:21"/></para>
  <para style="b"/>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>Beni SENYÈ a!</para>
  <para style="q1" vid="PSA 146:1">
    <note caller="+" style="x">
      <char style="xo" closed="false">146:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:1">Sòm 103:1</ref>
      </char>
    </note>Beni SENYÈ a, O nanm mwen!<verse eid="PSA 146:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>Mwen va beni SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">146:2 </char><char style="xt" closed="false"><ref loc="PSA 63:4">Sòm 63:4</ref></char></note>pandan mwen ap viv.</para>
  <para style="q1" vid="PSA 146:2">Mwen va chante lwanj a Bondye pa mwen an</para>
  <para style="q1" vid="PSA 146:2">pandan mwen sou latè a.<verse eid="PSA 146:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">146:3 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:9">Sòm 118:9</ref>
      </char>
    </note>Pa mete konfyans nan prens yo.</para>
  <para style="q1" vid="PSA 146:3">Nan lòm mòtèl, nan sila nanpwen Sali a.<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">146:4 </char>
      <char style="xt" closed="false">
        <ref loc="ECC 12:7">Ekl 12:7</ref>
      </char>
    </note>Lespri li pa rete; li retounen nan tè a.</para>
  <para style="q1" vid="PSA 146:4">Nan menm jou sa a, panse li yo vin peri.<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>A la beni sila ki gen sekou nan Bondye Jacob la beni,</para>
  <para style="q1" vid="PSA 146:5">sila ki <note caller="+" style="x"><char style="xo" closed="false">146:5 </char><char style="xt" closed="false"><ref loc="PSA 71:5">Sòm 71:5</ref> </char></note>mete espwa li nan SENYÈ a, Bondye li a,<verse eid="PSA 146:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>Ki te fè syèl la avèk tè a,</para>
  <para style="q1" vid="PSA 146:6">
    <note caller="+" style="x">
      <char style="xo" closed="false">146:6 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 14:15">Trav 14:15</ref> </char>
    </note>lanmè ak tout sa ki ladann.</para>
  <para style="q1" vid="PSA 146:6">Ki fidèl jis pou tout tan.<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>Ki <note caller="+" style="x"><char style="xo" closed="false">146:7 </char><char style="xt" closed="false"><ref loc="PSA 103:6">Sòm 103:6</ref></char></note>egzekite jistis pou oprime yo.</para>
  <para style="q1" vid="PSA 146:7">Ki bay manje a moun grangou yo.</para>
  <para style="q1" vid="PSA 146:7">SENYÈ a mete prizonye yo an libète.<verse eid="PSA 146:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">146:8 </char><char style="xt" closed="false"><ref loc="MAT 9:30">Mat 9:30</ref></char></note>ouvri zye a avèg yo.</para>
  <para style="q1" vid="PSA 146:8">SENYÈ a leve sila ki vin pwostène yo.</para>
  <para style="q1" vid="PSA 146:8">SENYÈ a renmen moun ladwati yo.<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>SENYÈ a <note caller="+" style="x"><char style="xo" closed="false">146:9 </char><char style="xt" closed="false"><ref loc="EXO 22:21">Egz 22:21</ref></char></note>pwoteje etranje yo.</para>
  <para style="q1" vid="PSA 146:9">Li bay soutyen a òfelen an ak vèv la,</para>
  <para style="q1" vid="PSA 146:9">men Li jennen wout mechan an.<verse eid="PSA 146:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>SENYÈ a va renye jis pou tout tan,</para>
  <para style="q1" vid="PSA 146:10">Bondye pa Ou a, O Sion, jis pou tout jenerasyon yo.</para>
  <para style="q1" vid="PSA 146:10">Louwe SENYÈ a!<verse eid="PSA 146:10"/></para>
  <para style="b"/>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>Louwe SENYÈ a!</para>
  <para style="q1" vid="PSA 147:1">Paske li bon pou chante lwanj a Bondye nou an.</para>
  <para style="q1" vid="PSA 147:1">Paske se agreyab epi lwanj Li se <note caller="+" style="x"><char style="xo" closed="false">147:1 </char><char style="xt" closed="false"><ref loc="PSA 33:1">Sòm 33:1</ref></char></note>dous.<verse eid="PSA 147:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>SENYÈ a ap ranfòse Jérusalem.</para>
  <para style="q1" vid="PSA 147:2">Li <note caller="+" style="x"><char style="xo" closed="false">147:2 </char><char style="xt" closed="false"><ref loc="DEU 30:3">Det 30:3</ref></char></note>ranmase egzile Israël yo.<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>Li geri sila ak <note caller="+" style="x"><char style="xo" closed="false">147:3 </char><char style="xt" closed="false"><ref loc="PSA 34:8">Sòm 34:8</ref></char></note>kè kase yo e mete pansman sou blesi yo.<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>Li konte fòs kantite zetwal yo.</para>
  <para style="q1" vid="PSA 147:4">Li <note caller="+" style="x"><char style="xo" closed="false">147:4 </char><char style="xt" closed="false"><ref loc="ISA 40:26">És 40:26</ref></char></note>bay non a yo tout.<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>Gran se SENYÈ nou an e Li ranpli ak fòs.</para>
  <para style="q1" vid="PSA 147:5">
    <note caller="+" style="x">
      <char style="xo" closed="false">147:5 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:28">És 40:28</ref>
      </char>
    </note>Bon konprann Li an san limit nèt.<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>SENYÈ a bay <note caller="+" style="x"><char style="xo" closed="false">147:6 </char><char style="xt" closed="false"><ref loc="PSA 37:24">Sòm 37:24</ref></char></note>soutyen a aflije yo.</para>
  <para style="q1" vid="PSA 147:6">Li fè mechan yo bese desann jis rive atè.<verse eid="PSA 147:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">147:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:2">Sòm 33:2</ref>
      </char>
    </note>Chante a SENYÈ a ak remèsiman.</para>
  <para style="q1" vid="PSA 147:7">Chante lwanj a Bondye nou an sou gita,<verse eid="PSA 147:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>ki kouvri syèl la ak nwaj yo,</para>
  <para style="q1" vid="PSA 147:8">ki <note caller="+" style="x"><char style="xo" closed="false">147:8 </char><char style="xt" closed="false"><ref loc="JOB 5:10">Job 5:10</ref></char></note>founi lapli pou tè a,</para>
  <para style="q1" vid="PSA 147:8">ki fè zèb yo grandi sou mòn yo.<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>Li bay bèt la manje li,</para>
  <para style="q1" vid="PSA 147:9">ak <note caller="+" style="x"><char style="xo" closed="false">147:9 </char><char style="xt" closed="false"><ref loc="JOB 38:41">Job 38:41</ref></char></note>jenn kòbo k ap kriye yo.<verse eid="PSA 147:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>Li pa pran plezi nan fòs cheval la.</para>
  <para style="q1" vid="PSA 147:10">Li <note caller="+" style="x"><char style="xo" closed="false">147:10 </char><char style="xt" closed="false"><ref loc="1SA 16:7">I Sam 16:7</ref></char></note>pa pran plezi nan janm a moun.<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>SENYÈ a bay favè a sila ki krent Li yo,</para>
  <para style="q1" vid="PSA 147:11">
    <note caller="+" style="x">
      <char style="xo" closed="false">147:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:18">Sòm 33:18</ref>
      </char>
    </note>sila ki tann lanmou dous Li yo.<verse eid="PSA 147:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>Louwe SENYÈ a, O Jérusalem!</para>
  <para style="q1" vid="PSA 147:12">Louwe Bondye ou a, O Sion!<verse eid="PSA 147:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>Paske Li te fòtifye ba fè nan pòtay ou yo;</para>
  <para style="q1" vid="PSA 147:13">Li te <note caller="+" style="x"><char style="xo" closed="false">147:13 </char><char style="xt" closed="false"><ref loc="PSA 37:26">Sòm 37:26</ref></char></note> beni fis ou yo anndan w.<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>Li <note caller="+" style="x"><char style="xo" closed="false">147:14 </char><char style="xt" closed="false"><ref loc="PSA 29:11">Sòm 29:11</ref></char></note>fè lapè anndan lizyè ou yo.</para>
  <para style="q1" vid="PSA 147:14">Li satisfè ou ak meyè kalite ble.<verse eid="PSA 147:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>Li voye lòd Li sou latè.</para>
  <para style="q1" vid="PSA 147:15">
    <note caller="+" style="x">
      <char style="xo" closed="false">147:15 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:4">Sòm 104:4</ref>
      </char>
    </note>Pawòl Li kouri byen vit.<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>Li bay lanèj kon lenn.</para>
  <para style="q1" vid="PSA 147:16">Li gaye <note caller="+" style="x"><char style="xo" closed="false">147:16 </char><char style="xt" closed="false"><ref loc="JOB 38:29">Job 38:29</ref></char></note>lawouze glase kon sann.<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>Li jete voye glas Li kon ti mòso.</para>
  <para style="q1" vid="PSA 147:17">Se kilès ki kab kanpe devan <note caller="+" style="x"><char style="xo" closed="false">147:17 </char><char style="xt" closed="false"><ref loc="JOB 37:9">Job 37:9</ref></char></note>fredi Li a?<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>Li voye pawòl Li pou fonn yo.</para>
  <para style="q1" vid="PSA 147:18">Li fè <note caller="+" style="x"><char style="xo" closed="false">147:18 </char><char style="xt" closed="false"><ref loc="PSA 107:25">Sòm 107:25</ref></char></note>van Li soufle e dlo yo koule.<verse eid="PSA 147:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>Li <note caller="+" style="x"><char style="xo" closed="false">147:19 </char><char style="xt" closed="false"><ref loc="DEU 33:3-4">Det 33:3-4</ref></char></note>deklare pawòl Li yo a Jacob,</para>
  <para style="q1" vid="PSA 147:19">règleman Li yo ak òdonans Li yo a Israël.<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>Li <note caller="+" style="x"><char style="xo" closed="false">147:20 </char><char style="xt" closed="false"><ref loc="DEU 4:7-34">Det 4:7-34</ref></char></note>pa t aji konsa avèk okenn lòt nasyon.</para>
  <para style="q1" vid="PSA 147:20">Selon òdonans Li yo, yo pa konnen yo.</para>
  <para style="q1" vid="PSA 147:20">Louwe SENYÈ a!<verse eid="PSA 147:20"/></para>
  <para style="b"/>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">148:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:34">Sòm 69:34</ref>
      </char>
    </note>Louwe SENYÈ a!</para>
  <para style="q1" vid="PSA 148:1">Louwe SENYÈ a soti nan syèl yo!</para>
  <para style="q1" vid="PSA 148:1">Louwe Li kote ki wo yo!<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>Louwe Li, tout zanj Li yo.</para>
  <para style="q1" vid="PSA 148:2">Louwe Li <note caller="+" style="x"><char style="xo" closed="false">148:2 </char><char style="xt" closed="false"><ref loc="PSA 103:20-21">Sòm 103:20-21</ref></char></note>tout lame Li yo!<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>Louwe Li, solèy ak lalin nan.</para>
  <para style="q1" vid="PSA 148:3">Louwe Li, tout zetwal ki limen yo!<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>Louwe Li, pi wo syèl yo,</para>
  <para style="q1" vid="PSA 148:4">ak <note caller="+" style="x"><char style="xo" closed="false">148:4 </char><char style="xt" closed="false"><ref loc="GEN 1:7">Jen 1:7</ref></char></note>dlo ki anwo syèl yo.<verse eid="PSA 148:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>Kite yo louwe non SENYÈ a,</para>
  <para style="q1" vid="PSA 148:5">paske <note caller="+" style="x"><char style="xo" closed="false">148:5 </char><char style="xt" closed="false"><ref loc="GEN 1:1">Jen 1:1</ref></char></note>Li te pase lòd, e sa te fèt.<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>Anplis, Li te etabli yo jis pou tout tan.</para>
  <para style="q1" vid="PSA 148:6">Li te pase yon <note caller="+" style="x"><char style="xo" closed="false">148:6 </char><char style="xt" closed="false"><ref loc="JOB 38:33">Job 38:33</ref></char></note>dekrè ki p ap janm disparèt.<verse eid="PSA 148:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>Louwe SENYÈ a soti sou latè,</para>
  <para style="q1" vid="PSA 148:7">
    <note caller="+" style="x">
      <char style="xo" closed="false">148:7 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:21">Jen 1:21</ref>
      </char>
    </note>gwo bèt voras lanmè a ak tout fon an.<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>Dife ak lagrèl, lanèj ak nwaj,</para>
  <para style="q1" vid="PSA 148:8">van tanpèt ki <note caller="+" style="x"><char style="xo" closed="false">148:8 </char><char style="xt" closed="false"><ref loc="JOB 37:12">Job 37:12</ref></char></note>akonpli pawòl Li yo.<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>Mòn yo ak tout kolin yo,</para>
  <para style="q1" vid="PSA 148:9">
    <note caller="+" style="x">
      <char style="xo" closed="false">148:9 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 55:12">És 55:12</ref>
      </char>
    </note>pye fwi yo ak tout pye sèd yo,<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>Bèt sovaj yo ak tout bèt chan yo,</para>
  <para style="q1" vid="PSA 148:10">sa ki <note caller="+" style="x"><char style="xo" closed="false">148:10 </char><char style="xt" closed="false"><ref loc="HOS 2:18">Os 2:18</ref></char></note>trennen atè ak bèt ki vole yo,<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">148:11 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:15">Sòm 102:15</ref>
      </char>
    </note>wa latè yo ak tout pèp yo,</para>
  <para style="q1" vid="PSA 148:11">prens yo ak tout jij latè yo,<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>ni jennonm, ni vyèj,</para>
  <para style="q1" vid="PSA 148:12">granmoun ak timoun.<verse eid="PSA 148:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>Kite yo louwe non SENYÈ a,</para>
  <para style="q1" vid="PSA 148:13">paske se sèl non Li ki leve wo.</para>
  <para style="q1" vid="PSA 148:13">
    <note caller="+" style="x">
      <char style="xo" closed="false">148:13 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 12:4">És 12:4</ref>
      </char>
    </note>Glwa Li pi wo tè a ak syèl la.<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>Li te leve yon kòn pou pèp Li a,</para>
  <para style="q1" vid="PSA 148:14">Lwanj pou tout fidèl Li yo,</para>
  <para style="q1" vid="PSA 148:14">menm pou fis Israël yo, yon pèp toupre Li.</para>
  <para style="q1" vid="PSA 148:14">Louwe SENYÈ a.<verse eid="PSA 148:14"/></para>
  <para style="b"/>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>Louwe SENYÈ a!</para>
  <para style="q1" vid="PSA 149:1">Chante a SENYÈ a yon chan tounèf,</para>
  <para style="q1" vid="PSA 149:1">avèk lwanj Li <note caller="+" style="x"><char style="xo" closed="false">149:1 </char><char style="xt" closed="false"><ref loc="PSA 35:18">Sòm 35:18</ref></char></note>nan asanble fidèl Li yo.<verse eid="PSA 149:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>Kite Israël fè kè kontan nan Kreyatè li a.</para>
  <para style="q1" vid="PSA 149:2">Kite fis a Sion yo rejwi nan <note caller="+" style="x"><char style="xo" closed="false">149:2 </char><char style="xt" closed="false"><ref loc="JDG 8:23">Jij 8:23</ref></char></note>Wa yo a.<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>Kite yo louwe non Li avèk dans!</para>
  <para style="q1" vid="PSA 149:3">Kite yo chante lwanj a Li</para>
  <para style="q1" vid="PSA 149:3">avèk <note caller="+" style="x"><char style="xo" closed="false">149:3 </char><char style="xt" closed="false"><ref loc="EXO 15:20">Egz 15:20</ref></char></note>tanbouren ak gita.<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>Paske SENYÈ a pran plezi nan pèp Li a.</para>
  <para style="q1" vid="PSA 149:4">Li va <note caller="+" style="x"><char style="xo" closed="false">149:4 </char><char style="xt" closed="false"><ref loc="PSA 132:16">Sòm 132:16</ref></char></note>anbeli enb yo avèk sali Li.<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>Kite fidèl yo leve wo nan glwa.</para>
  <para style="q1" vid="PSA 149:5">Kite yo chante ak lajwa sou kabann yo.<verse eid="PSA 149:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>Ke <note caller="+" style="x"><char style="xo" closed="false">149:6 </char><char style="xt" closed="false"><ref loc="PSA 66:17">Sòm 66:17</ref></char></note> gwo lwanj a Bondye yo kapab nan bouch yo,</para>
  <para style="q1" vid="PSA 149:6">ak yon nepe file de bò nan men yo,<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>pou <note caller="+" style="x"><char style="xo" closed="false">149:7 </char><char style="xt" closed="false"><ref loc="EZK 25:17">Éz 25:17</ref></char></note>fè vanjans sou nasyon yo,</para>
  <para style="q1" vid="PSA 149:7">avèk pinisyon sou lòt pèp yo;<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>pou mare wa yo ak chenn,</para>
  <para style="q1" vid="PSA 149:8">ak <note caller="+" style="x"><char style="xo" closed="false">149:8 </char><char style="xt" closed="false"><ref loc="NAM 3:10">Na 3:10</ref></char></note>moun pwisan yo nan gwo chenn an fè,<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>pou <note caller="+" style="x"><char style="xo" closed="false">149:9 </char><char style="xt" closed="false"><ref loc="DEU 7:12">Det 7:12</ref></char></note>egzekite sou yo jijman ki te ekri a.</para>
  <para style="q1" vid="PSA 149:9">Sa se lonè de tout fidèl Li yo.</para>
  <para style="q1" vid="PSA 149:9">Louwe SENYÈ a!<verse eid="PSA 149:9"/></para>
  <para style="b"/>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>Louwe SENYÈ a!</para>
  <para style="q1" vid="PSA 150:1">Louwe SENYÈ a nan <note caller="+" style="x"><char style="xo" closed="false">150:1 </char><char style="xt" closed="false"><ref loc="PSA 73:17">Sòm 73:17</ref></char></note>sanktiyè Li a!</para>
  <para style="q1" vid="PSA 150:1">Louwe Li nan gran espas syèl la pou tout zak pouvwa Li yo!<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>Louwe Li pou <note caller="+" style="x"><char style="xo" closed="false">150:2 </char><char style="xt" closed="false"><ref loc="PSA 145:12">Sòm 145:12</ref></char></note>zèv pwisan Li yo!</para>
  <para style="q1" vid="PSA 150:2">Louwe Li selon bèlte a grandè Li!<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>Louwe Li ak son <note caller="+" style="x"><char style="xo" closed="false">150:3 </char><char style="xt" closed="false"><ref loc="PSA 98:6">Sòm 98:6</ref></char></note>twonpèt la!</para>
  <para style="q1" vid="PSA 150:3">Louwe Li ak ap avèk gita!<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>Louwe Li ak <note caller="+" style="x"><char style="xo" closed="false">150:4 </char><char style="xt" closed="false"><ref loc="PSA 149:3">Sòm 149:3</ref></char></note>tanbouren ak dans!</para>
  <para style="q1" vid="PSA 150:4">Louwe Li ak enstriman a kòd ak flit!<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>Louwe Li ak <note caller="+" style="x"><char style="xo" closed="false">150:5 </char><char style="xt" closed="false"><ref loc="2SA 6:5">II Sam 6:5</ref></char></note> senbal byen fò!</para>
  <para style="q1" vid="PSA 150:5">Louwe Li ak senbal k ap retanti!<verse eid="PSA 150:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>Kite <note caller="+" style="x"><char style="xo" closed="false">150:6 </char><char style="xt" closed="false"><ref loc="PSA 103:22">Sòm 103:22</ref></char></note>tout sa ki gen souf louwe SENYÈ a!</para>
  <para style="q1" vid="PSA 150:6">Louwe SENYÈ a!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
