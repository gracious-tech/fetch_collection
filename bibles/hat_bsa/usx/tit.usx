<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="TIT" style="id"/>
  <para style="h">Tite</para>
  <para style="toc1">TITE</para>
  <para style="toc2">Tite</para>
  <para style="toc3">Tit</para>
  <para style="mt1">TITE</para>
  <chapter number="1" style="c" sid="TIT 1"/>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1"/>Paul, yon sèvitè-atache nèt a Bondye, e yon apot Jésus Kri, pou lafwa a sila ki te chwazi pa Bondye yo, ak <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1TI 2:4">I Tim 2:4</ref></char></note>konesans verite ki <note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1TI 6:3">I Tim 6:3</ref></char></note>an akò avèk vi sentete a, <verse eid="TIT 1:1"/><verse number="2" style="v" sid="TIT 1:2"/>nan <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2TI 1:1">II Tim 1:1</ref></char></note>espwa lavi etènèl la, ke Bondye, ki pa kapab bay manti a, te pwomèt depi nan tan ansyen yo. <verse eid="TIT 1:2"/><verse number="3" style="v" sid="TIT 1:3"/>Men <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="1TI 2:6">I Tim 2:6</ref></char></note>nan tan konvenab la, pawòl Li te manifeste, ak mesaj sila a ki te konfye m nan, selon kòmandman a <note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="LUK 1:47">Luc 1:47</ref></char></note>Bondye a, Sovè nou an, <verse eid="TIT 1:3"/><verse number="4" style="v" sid="TIT 1:4"/>a Tite <note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2TI 1:2">II Tim 1:2</ref></char></note>vrè pitit mwen nan yon lafwa ke nou <note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2PE 1:1">II Pi 1:1</ref></char></note>pataje ansanm: Lagras ak lapè Bondye, Papa a, ak Kris Jésus, sovè nou an.<verse eid="TIT 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5"/>Pou rezon sa a, mwen te kite ou Crète, pou ou ta kapab mete nan lòd bagay ki potko fèt yo, e <note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 14:23">Trav 14:23</ref></char></note>chwazi ansyen yo nan chak vil selon jan mwen te dirije ou a.<verse eid="TIT 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 1:6"/>Kidonk, <note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="TIT 3:2-4">Tit 3:2-4</ref></char></note>si yon nonm san repwòch, mari a yon sèl fanm, ki gen pitit ki kwayan, e ki pa akize de dezòd ak rebelyon.<verse eid="TIT 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="TIT 1:7"/>Paske pastè an tèt la dwe san repwòch, kòm <note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="1CO 4:1">I Kor 4:1</ref></char></note>jeran zafè a Bondye, pa <note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="2PE 2:10">II Pi 2:10</ref></char></note>awogan, pa fache souvan, pa bwè diven twòp, pa agresif kont lòt, ni renmen lajan twòp; <verse eid="TIT 1:7"/><verse number="8" style="v" sid="TIT 1:8"/>men <note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="1TI 3:2">I Tim 3:2</ref></char></note>emab, renmen sa ki bon, rezonab, jis, devwe, gen kontwòl tèt li, <verse eid="TIT 1:8"/><verse number="9" style="v" sid="TIT 1:9"/>ki <note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="2TH 2:15">II Tes 2:15</ref></char></note>kenbe fèm a pawòl lafwa a ki gen akò avèk ansèyman an, pou li kapab egzòte nan bon doktrin nan, e demanti sila ki kontredi l yo.<verse eid="TIT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10"/>Paske gen anpil <note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="TIT 1:6">Tit 1:6</ref></char></note>moun rebèl <note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="1TI 1:6">I Tim 1:6</ref></char></note>moun k ap pale pawòl anven ak moun k ap twonpe moun, sitou sila sikonsizyon yo, <verse eid="TIT 1:10"/><verse number="11" style="v" sid="TIT 1:11"/>ki dwe rete an silans paske y ap boulvèse <note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1TI 5:4">I Tim 5:4</ref></char></note>tout kay yo nèt, nan enstwi <note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1TI 5:15">I Tim 5:15</ref></char></note>bagay ke yo pa ta dwe enstwi, pou koz a kòb ki sal.<verse eid="TIT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 1:12"/>Youn nan yo, yon pwofèt de pèp yo menm te di: <note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 2:11">Trav 2:11</ref></char></note>“Moun Crète yo se toujou mantè yo ye, bèt mechan, parese ki manje twòp”. <verse eid="TIT 1:12"/><verse number="13" style="v" sid="TIT 1:13"/>Temwayaj sa a vrè. Pou rezon sa a <note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="1TI 5:20">I Tim 5:20</ref></char></note>repwoche yo sevèman pou yo kapab vin solid nan lafwa, <verse eid="TIT 1:13"/><verse number="14" style="v" sid="TIT 1:14"/>pa nan prete atansyon a <note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="1TI 1:4">I Tim 1:4</ref></char></note>vye istwa Jwif yo, ak kòmandman a lèzòm ki vire kite verite a.<verse eid="TIT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 1:15"/>Pou sila ki san tach la, tout bagay san tach, men <note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ROM 14:14">Wo 14:14</ref>,<ref loc="ROM 14:23">23</ref></char></note>pou sila ki souye e ki pa kwè yo, nanpwen anyen ki san tach, men lespri yo ak konsyans yo deja souye. <verse eid="TIT 1:15"/><verse number="16" style="v" sid="TIT 1:16"/><note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1JN 2:4">I Jn 2:4</ref></char></note>Yo di yo konnen Bondye, men ak zèv pa yo, yo nye Li. Konsa, yo vin detestab, dezobeyisan, e san valè pou okenn bon zèv.<verse eid="TIT 1:16"/></para>
  <chapter eid="TIT 1"/>
  <chapter number="2" style="c" sid="TIT 2"/>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1"/>Men pou ou menm, pale bagay ki apwopriye a <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="TIT 1:9">Tit 1:9</ref></char></note>bon doktrin nan.<verse eid="TIT 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="TIT 2:2"/>Mesye nan laj avanse yo dwe <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="1TI 3:2">I Tim 3:2</ref></char></note>tanpere, dign, rezonab <note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="TIT 1:13">Tit 1:13</ref></char></note>solid nan lafwa, nan lanmou, ak nan pèseverans.<verse eid="TIT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 2:3"/>Fanm nan laj avanse yo, menm jan an, yo dwe sen nan konpòtman yo <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="1TI 3:11">I Tim 3:11</ref></char></note>pa nan fè medizans, ni <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="TIT 1:13">Tit 1:13</ref></char></note>vin esklav a anpil diven, e yo dwe ap enstwi sa ki bon <verse eid="TIT 2:3"/><verse number="4" style="v" sid="TIT 2:4"/>pou yo kapab ankouraje jèn fanm yo pou renmen mari yo, e pou renmen pitit yo, <verse eid="TIT 2:4"/><verse number="5" style="v" sid="TIT 2:5"/>pou yo kapab reflechi kon moun serye, rete san tach, <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="1TI 5:14">I Tim 5:14</ref></char></note>fè travay lakay yo, janti, <note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="EPH 5:22">Ef 5:22</ref></char></note>soumèt a pwòp mari yo, pou yo pa dezonore pawòl Bondye a.<verse eid="TIT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6"/>Menm jan an, ankouraje <note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="1TI 5:1">I Tim 5:1</ref></char></note>jennonm yo pou yo toujou reflechi kon moun serye. <verse eid="TIT 2:6"/><verse number="7" style="v" sid="TIT 2:7"/>Nan tout bagay, montre tèt ou kòm <note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1TI 4:12">I Tim 4:12</ref></char></note>yon egzanp a bon zèv. Lè ou enstwi, fè l avèk tout verite nan doktrin nan, konpòtman ki dign, ak yon bi verite ki pa konwonpi, <verse eid="TIT 2:7"/><verse number="8" style="v" sid="TIT 2:8"/>rezonab ak pawòl ki san repwòch, pou <note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="2TH 3:14">II Tes 3:14</ref></char></note>sila ki opoze yo kapab vin wont, pou yo pa gen anyen mal pou di sou nou.<verse eid="TIT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9"/>Ankouraje <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="EPH 6:5">Ef 6:5</ref></char></note>esklav yo pou soumèt a pwòp mèt yo nan tout bagay, pou fè yo plezi, san diskisyon, <verse eid="TIT 2:9"/><verse number="10" style="v" sid="TIT 2:10"/>pa nan vòlè, men nan montre tout bon lafwa nan tout bagay pou yo kapab anbeli doktrin <note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="TIT 1:3">Tit 1:3</ref></char></note>Bondye a, Sovè nou an, nan tout jan.<verse eid="TIT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11"/>Paske lagras Bondye <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="2TI 1:10">II Tim 1:10</ref></char></note>gen tan parèt, e <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="1TI 2:4">I Tim 2:4</ref></char></note>pote sali pou tout moun <verse eid="TIT 2:11"/><verse number="12" style="v" sid="TIT 2:12"/>kap enstwi nou pou rejte sa ki pa a Bondye ak <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="1TI 6:9">I Tim 6:9</ref></char></note>dezi mond lan pou <note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="2TI 3:12">II Tim 3:12</ref></char></note>viv avèk bon rezon, ladwati, ak yon vi fidèl nan tan prezan sila a; <verse eid="TIT 2:12"/><verse number="13" style="v" sid="TIT 2:13"/>nan chèche lesperans beni ak aparisyon laglwa a <note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="TIT 1:4">Tit 1:4</ref></char></note>gran Bondye ak Sovè nou an, Jésus Kri <verse eid="TIT 2:13"/><verse number="14" style="v" sid="TIT 2:14"/>ki te <note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="1TI 2:6">I Tim 2:6</ref></char></note>bay tèt Li pou nou, pou <note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="PSA 130:8">Sòm 130:8</ref></char></note>rachte nou de tout zèv malveyan, e pirifye pou tèt Li yon pèp pou pwòp posesyon pa Li, ki zele pou fè bon zèv.<verse eid="TIT 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15"/>Pale, <note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="1TI 4:13">I Tim 4:13</ref></char></note>egzòte, e repwoche nan bagay sa yo avèk tout otorite. Pa kite pèsòn meprize ou.<verse eid="TIT 2:15"/></para>
  <chapter eid="TIT 2"/>
  <chapter number="3" style="c" sid="TIT 3"/>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1"/>Raple yo <note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="ROM 13:1">Wo 13:1</ref></char></note>pou soumèt yo a tout wayòm ak otorite yo, pou yo rete obeyisan, e<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="2TI 2:21">II Tim 2:21</ref></char></note>prè pou tout bon zèv <verse eid="TIT 3:1"/><verse number="2" style="v" sid="TIT 3:2"/>pou pa di mal de pèsòn, men toujou <note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="1TI 3:3">I Tim 3:3</ref></char></note>pezib; janti, e montre tout konsiderasyon pou tout moun.<verse eid="TIT 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 3:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:3 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 11:30">Wo 11:30</ref>
      </char>
    </note>Paske nou menm tou, yon fwa nou te ensanse, dezobeyisan <note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="2TI 3:13">II Tim 3:13</ref></char></note>twonpè, esklav a tout kalite move dezi ak plezi, e nou t ap pase lavi nou nan mechanste, lanvi, rayisman, nan rayi youn lòt.<verse eid="TIT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 3:4"/>Men lè <note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="ROM 2:4">Wo 2:4</ref></char></note>bonte a Bondye, Sovè nou an, ak lanmou Li pou tout limanite a te parèt, <verse eid="TIT 3:4"/><verse number="5" style="v" sid="TIT 3:5"/>Li te sove nou, <note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="EPH 2:9">Ef 2:9</ref></char></note>pa sou baz a zèv ladwati ke nou fè, men selon mizerikòd Li, pa lavaj a rejenerasyon an, e renouvèlman pa Lespri Sen an, <verse eid="TIT 3:5"/><verse number="6" style="v" sid="TIT 3:6"/><note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ROM 5:5">Wo 5:5</ref></char></note>ke Li te vide sou nou an abondans atravè Jésus Kri, Sovè nou an. <verse eid="TIT 3:6"/><verse number="7" style="v" sid="TIT 3:7"/>Konsa nou te vin jistifye pa lagras Li, pou nou ta kapab vin <note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 25:34">Mat 25:34</ref></char></note>eritye selon esperans a lavi etènèl la.<verse eid="TIT 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="TIT 3:8"/>Sa se yon pawòl ki fidèl; epi konsènan bagay sa yo, mwen vle ou pale avèk konfyans, pou sila ki te kwè nan Bondye yo, kapab pridan pou <note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="TIT 2:7">Tit 2:7</ref>,<ref loc="TIT 2:14">14</ref></char></note>angaje yo nan bon zèv. Bagay sa yo bon, e pwofitab pou moun.<verse eid="TIT 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 3:9"/>Men <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="2TI 2:16">II Tim 2:16</ref></char></note>evite <note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="1TI 1:4">I Tim 1:4</ref></char></note>konfli ak jeneyaloji ki ranpli ak foli, avèk diskisyon sou Lalwa yo, paske yo san pwofi, e san valè.<verse eid="TIT 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 3:10"/>Apre yon premye ak yon dezyèm avètisman <note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="2JN 1:10">II Jn 10</ref></char></note>rejte yon nonm <note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="ROM 16:17">Wo 16:17</ref></char></note>k ap mete divizyon. <verse eid="TIT 3:10"/><verse number="11" style="v" sid="TIT 3:11"/>Byen konnen ke yon moun konsa <note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="TIT 1:14">Tit 1:14</ref></char></note>pèvèti. Li nan peche, e ap kondane pwòp tèt li.<verse eid="TIT 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12"/>Lè mwen voye Artémas oswa Tychique kote ou <note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="2TI 4:9">II Tim 4:9</ref></char></note>fè tout efò pou vini kote mwen nan Nicopolis, paske mwen deside pase sezon livè a la.<verse eid="TIT 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="TIT 3:13"/>Byen vit, voye avoka a, Zénas ak <note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ACT 18:24">Trav 18:24</ref></char></note>Apollos nan wout yo pou yo pa manke anyen.<verse eid="TIT 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="TIT 3:14"/>Moun pa nou yo dwe osi aprann <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="TIT 3:8">Tit 3:8</ref></char></note>angaje yo nan bon zèv pou satisfè bezwen imedya yo, pou yo pa manke <note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 7:19">Mat 7:19</ref></char></note>bay fwi.<verse eid="TIT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15"/>Tout sila ki avè m yo salye ou. Salye sila ki renmen nou <note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="1TI 1:2">I Tim 1:2</ref></char></note>nan lafwa yo. <note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="COL 4:18">Kol 4:18</ref></char></note>Ke lagras avèk nou tout.<verse eid="TIT 3:15"/></para>
  <chapter eid="TIT 3"/>
</usx>
