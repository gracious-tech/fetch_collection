<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2TH" style="id">Sanskrit Bible (NT) in Khmer Script (សត្យវេទះ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Thessalonians</para>
  <para style="toc1">២ ថិឞលនីកិនះ បត្រំ</para>
  <para style="toc2">២ ថិឞលនីកិនះ</para>
  <para style="toc3">២ ថិឞលនីកិនះ</para>
  <para style="mt1">២ ថិឞលនីកិនះ បត្រំ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>បៅលះ សិល្វានស្តីមថិយឝ្ចេតិនាមានោ វយម៑ អស្មទីយតាតម៑ ឦឝ្វរំ ប្រភុំ យីឝុខ្រីឞ្ដញ្ចាឝ្រិតាំ ថិឞលនីកិនាំ សមិតិំ ប្រតិ បត្រំ លិខាមះ។</para>
  <para style="p">
    <verse number="2" style="v"/>អស្មាកំ តាត ឦឝ្វរះ ប្រភុ រ្យីឝុខ្រីឞ្ដឝ្ច យុឞ្មាស្វនុគ្រហំ ឝាន្តិញ្ច ក្រិយាស្តាំ។</para>
  <para style="p">
    <verse number="3" style="v"/>ហេ ភ្រាតរះ, យុឞ្មាកំ ក្ឫតេ សវ៌្វទា យថាយោគ្យម៑ ឦឝ្វរស្យ ធន្យវាទោ ៜស្មាភិះ កត៌្តវ្យះ, យតោ ហេតោ រ្យុឞ្មាកំ វិឝ្វាស ឧត្តរោត្តរំ វទ៌្ធតេ បរស្បរម៑ ឯកៃកស្យ ប្រេម ច ពហុផលំ ភវតិ។</para>
  <para style="p">
    <verse number="4" style="v"/>តស្មាទ៑ យុឞ្មាភិ រ្យាវន្ត ឧបទ្រវក្លេឝាះ សហ្យន្តេ តេឞុ យទ៑ ធេैរ្យ្យំ យឝ្ច វិឝ្វាសះ ប្រកាឝ្យតេ តត្ការណាទ៑ វយម៑ ឦឝ្វរីយសមិតិឞុ យុឞ្មាភិះ ឝ្លាឃាមហេ។</para>
  <para style="p">
    <verse number="5" style="v"/>តច្ចេឝ្វរស្យ ន្យាយវិចារស្យ ប្រមាណំ ភវតិ យតោ យូយំ យស្យ ក្ឫតេ ទុះខំ សហធ្វំ តស្យេឝ្វរីយរាជ្យស្យ យោគ្យា ភវថ។</para>
  <para style="p">
    <verse number="6" style="v"/>យតះ ស្វកីយស្វគ៌ទូតានាំ ពលៃះ សហិតស្យ ប្រភោ រ្យីឝោះ ស្វគ៌ាទ៑ អាគមនកាលេ យុឞ្មាកំ ក្លេឝកេភ្យះ ក្លេឝេន ផលទានំ សាទ៌្ធមស្មាភិឝ្ច</para>
  <para style="p">
    <verse number="7" style="v"/>ក្លិឝ្យមានេភ្យោ យុឞ្មភ្យំ ឝាន្តិទានម៑ ឦឝ្វរេណ ន្យាយ្យំ ភោត្ស្យតេ;</para>
  <para style="p">
    <verse number="8" style="v"/>តទានីម៑ ឦឝ្វរានភិជ្ញេភ្យោ ៜស្មត្ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ សុសំវាទាគ្រាហកេភ្យឝ្ច លោកេភ្យោ ជាជ្វល្យមានេន វហ្និនា សមុចិតំ ផលំ យីឝុនា ទាស្យតេ;</para>
  <para style="p">
    <verse number="9" style="v"/>តេ ច ប្រភោ រ្វទនាត៑ បរាក្រមយុក្តវិភវាច្ច សទាតនវិនាឝរូបំ ទណ្ឌំ លប្ស្យន្តេ,</para>
  <para style="p">
    <verse number="10" style="v"/>កិន្តុ តស្មិន៑ ទិនេ ស្វកីយបវិត្រលោកេឞុ វិរាជិតុំ យុឞ្មាន៑ អបរាំឝ្ច សវ៌្វាន៑ វិឝ្វាសិលោកាន៑ វិស្មាបយិតុញ្ច ស អាគមិឞ្យតិ យតោ ៜស្មាកំ ប្រមាណេ យុឞ្មាភិ រ្វិឝ្វាសោៜការិ។</para>
  <para style="p">
    <verse number="11" style="v"/>អតោៜស្មាកម៑ ឦឝ្វរោ យុឞ្មាន៑ តស្យាហ្វានស្យ យោគ្យាន៑ ករោតុ សៅជន្យស្យ ឝុភផលំ វិឝ្វាសស្យ គុណញ្ច បរាក្រមេណ សាធយត្វិតិ ប្រាត៌្ហនាស្មាភិះ សវ៌្វទា យុឞ្មន្និមិត្តំ ក្រិយតេ,</para>
  <para style="p">
    <verse number="12" style="v"/>យតស្តថា សត្យស្មាកម៑ ឦឝ្វរស្យ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ ចានុគ្រហាទ៑ អស្មត្ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ នាម្នោ គៅរវំ យុឞ្មាសុ យុឞ្មាកមបិ គៅរវំ តស្មិន៑ ប្រកាឝិឞ្យតេ។</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ហេ ភ្រាតរះ, អស្មាកំ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យាគមនំ តស្យ សមីបេ ៜស្មាកំ សំស្ថិតិញ្ចាធិ វយំ យុឞ្មាន៑ ឥទំ ប្រាត៌្ហយាមហេे,</para>
  <para style="p">
    <verse number="2" style="v"/>ប្រភេស្តទ៑ ទិនំ ប្រាយេណោបស្ថិតម៑ ឥតិ យទិ កឝ្ចិទ៑ អាត្មនា វាចា វា បត្រេណ វាស្មាកម៑ អាទេឝំ កល្បយន៑ យុឞ្មាន៑ គទតិ តហ៌ិ យូយំ តេន ចញ្ចលមនស ឧទ្វិគ្នាឝ្ច ន ភវត។</para>
  <para style="p">
    <verse number="3" style="v"/>កេនាបិ ប្រការេណ កោៜបិ យុឞ្មាន៑ ន វញ្ចយតុ យតស្តស្មាទ៑ ទិនាត៑ បូវ៌្វំ ធម៌្មលោបេនោបស្យាតវ្យំ,</para>
  <para style="p">
    <verse number="4" style="v"/>យឝ្ច ជនោ វិបក្ឞតាំ កុវ៌្វន៑ សវ៌្វស្មាទ៑ ទេវាត៑ បូជនីយវស្តុឝ្ចោន្នំស្យតេ ស្វម៑ ឦឝ្វរមិវ ទឝ៌យន៑ ឦឝ្វរវទ៑ ឦឝ្វរស្យ មន្ទិរ ឧបវេក្ឞ្យតិ ច តេន វិនាឝបាត្រេណ បាបបុរុឞេណោទេតវ្យំ។</para>
  <para style="p">
    <verse number="5" style="v"/>យទាហំ យុឞ្មាកំ សន្និធាវាសំ តទានីម៑ ឯតទ៑ អកថយមិតិ យូយំ កិំ ន ស្មរថ?</para>
  <para style="p">
    <verse number="6" style="v"/>សាម្ប្រតំ ស យេន និវាយ៌្យតេ តទ៑ យូយំ ជានីថ, កិន្តុ ស្វសមយេ តេនោទេតវ្យំ។</para>
  <para style="p">
    <verse number="7" style="v"/>វិធម៌្មស្យ និគូឍោ គុណ ឥទានីមបិ ផលតិ កិន្តុ យស្តំ និវារយតិ សោៜទ្យាបិ ទូរីក្ឫតោ នាភវត៑។</para>
  <para style="p">
    <verse number="8" style="v"/>តស្មិន៑ ទូរីក្ឫតេ ស វិធម៌្ម្យុទេឞ្យតិ កិន្តុ ប្រភុ រ្យីឝុះ ស្វមុខបវនេន តំ វិធ្វំសយិឞ្យតិ និជោបស្ថិតេស្តេជសា វិនាឝយិឞ្យតិ ច។</para>
  <para style="p">
    <verse number="9" style="v"/>ឝយតានស្យ ឝក្តិប្រកាឝនាទ៑ វិនាឝ្យមានានាំ មធ្យេ សវ៌្វវិធាះ បរាក្រមា ភ្រមិកា អាឝ្ចយ៌្យក្រិយា លក្ឞណាន្យធម៌្មជាតា សវ៌្វវិធប្រតារណា ច តស្យោបស្ថិតេះ ផលំ ភវិឞ្យតិ;</para>
  <para style="p">
    <verse number="10" style="v"/>យតោ ហេតោស្តេ បរិត្រាណប្រាប្តយេ សត្យធម៌្មស្យានុរាគំ ន គ្ឫហីតវន្តស្តស្មាត៑ ការណាទ្</para>
  <para style="p">
    <verse number="11" style="v"/>ឦឝ្វរេណ តាន៑ ប្រតិ ភ្រាន្តិករមាយាយាំ ប្រេឞិតាយាំ តេ ម្ឫឞាវាក្យេ វិឝ្វសិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="12" style="v"/>យតោ យាវន្តោ មានវាះ សត្យធម៌្មេ ន វិឝ្វស្យាធម៌្មេណ តុឞ្យន្តិ តៃះ សវ៌្វៃ រ្ទណ្ឌភាជនៃ រ្ភវិតវ្យំ។</para>
  <para style="p">
    <verse number="13" style="v"/>ហេ ប្រភោះ ប្រិយា ភ្រាតរះ, យុឞ្មាកំ ក្ឫត ឦឝ្វរស្យ ធន្យវាទោៜស្មាភិះ សវ៌្វទា កត៌្តវ្យោ យត ឦឝ្វរ អា ប្រថមាទ៑ អាត្មនះ បាវនេន សត្យធម៌្មេ វិឝ្វាសេន ច បរិត្រាណាត៌្ហំ យុឞ្មាន៑ វរីតវាន្</para>
  <para style="p">
    <verse number="14" style="v"/>តទត៌្ហញ្ចាស្មាភិ រ្ឃោឞិតេន សុសំវាទេន យុឞ្មាន៑ អាហូយាស្មាកំ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ តេជសោៜធិការិណះ ករិឞ្យតិ។</para>
  <para style="p">
    <verse number="15" style="v"/>អតោ ហេ ភ្រាតរះ យូយម៑ អស្មាកំ វាក្យៃះ បត្រៃឝ្ច យាំ ឝិក្ឞាំ លព្ធវន្តស្តាំ ក្ឫត្ស្នាំ ឝិក្ឞាំ ធារយន្តះ សុស្ថិរា ភវត។</para>
  <para style="p">
    <verse number="16" style="v"/>អស្មាកំ ប្រភុ រ្យីឝុខ្រីឞ្ដស្តាត ឦឝ្វរឝ្ចាត៌្ហតោ យោ យុឞ្មាសុ ប្រេម ក្ឫតវាន៑ និត្យាញ្ច សាន្ត្វនាម៑ អនុគ្រហេណោត្តមប្រត្យាឝាញ្ច យុឞ្មភ្យំ ទត្តវាន្</para>
  <para style="p">
    <verse number="17" style="v"/>ស ស្វយំ យុឞ្មាកម៑ អន្តះករណានិ សាន្ត្វយតុ សវ៌្វស្មិន៑ សទ្វាក្យេ សត្កម៌្មណិ ច សុស្ថិរីករោតុ ច។</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ហេ ភ្រាតរះ, ឝេឞេ វទាមិ, យូយម៑ អស្មភ្យមិទំ ប្រាត៌្ហយធ្វំ យត៑ ប្រភោ រ្វាក្យំ យុឞ្មាកំ មធ្យេ យថា តថៃវាន្យត្រាបិ ប្រចរេត៑ មាន្យញ្ច ភវេត៑;</para>
  <para style="p">
    <verse number="2" style="v"/>យច្ច វយម៑ អវិវេចកេភ្យោ ទុឞ្ដេភ្យឝ្ច លោកេភ្យោ រក្ឞាំ ប្រាប្នុយាម យតះ សវ៌្វេឞាំ វិឝ្វាសោ ន ភវតិ។</para>
  <para style="p">
    <verse number="3" style="v"/>កិន្តុ ប្រភុ រ្វិឝ្វាស្យះ ស ឯវ យុឞ្មាន៑ ស្ថិរីករិឞ្យតិ ទុឞ្ដស្យ ករាទ៑ ឧទ្ធរិឞ្យតិ ច។</para>
  <para style="p">
    <verse number="4" style="v"/>យូយម៑ អស្មាភិ រ្យទ៑ អាទិឝ្យធ្វេ តត៑ កុរុថ ករិឞ្យថ ចេតិ វិឝ្វាសោ យុឞ្មានធិ ប្រភុនាស្មាកំ ជាយតេ។</para>
  <para style="p">
    <verse number="5" style="v"/>ឦឝ្វរស្យ ប្រេម្និ ខ្រីឞ្ដស្យ សហិឞ្ណុតាយាញ្ច ប្រភុះ ស្វយំ យុឞ្មាកម៑ អន្តះករណានិ វិនយតុ។</para>
  <para style="p">
    <verse number="6" style="v"/>ហេ ភ្រាតរះ, អស្មត្ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ នាម្នា វយំ យុឞ្មាន៑ ឥទម៑ អាទិឝាមះ, អស្មត្តោ យុឞ្មាភិ រ្យា ឝិក្ឞលម្ភិ តាំ វិហាយ កឝ្ចិទ៑ ភ្រាតា យទ្យវិហិតាចារំ ករោតិ តហ៌ិ យូយំ តស្មាត៑ ប្ឫថគ៑ ភវត។</para>
  <para style="p">
    <verse number="7" style="v"/>យតោ វយំ យុឞ្មាភិះ កថម៑ អនុកត៌្តវ្យាស្តទ៑ យូយំ ស្វយំ ជានីថ។ យុឞ្មាកំ មធ្យេ វយម៑ អវិហិតាចារិណោ នាភវាម,</para>
  <para style="p">
    <verse number="8" style="v"/>វិនាមូល្យំ កស្យាប្យន្នំ នាភុំជ្មហិ កិន្តុ កោៜបិ យទ៑ អស្មាភិ រ្ភារគ្រស្តោ ន ភវេត៑ តទត៌្ហំ ឝ្រមេណ ក្លេឝេន ច ទិវានិឝំ កាយ៌្យម៑ អកុម៌្ម។</para>
  <para style="p">
    <verse number="9" style="v"/>អត្រាស្មាកម៑ អធិការោ នាស្តីត្ថំ នហិ កិន្ត្វស្មាកម៑ អនុករណាយ យុឞ្មាន៑ ទ្ឫឞ្ដាន្តំ ទឝ៌យិតុម៑ ឥច្ឆន្តស្តទ៑ អកុម៌្ម។</para>
  <para style="p">
    <verse number="10" style="v"/>យតោ យេន កាយ៌្យំ ន ក្រិយតេ តេនាហារោៜបិ ន ក្រិយតាមិតិ វយំ យុឞ្មត្សមីប ឧបស្ថិតិកាលេៜបិ យុឞ្មាន៑ អាទិឝាម។</para>
  <para style="p">
    <verse number="11" style="v"/>យុឞ្មន្មធ្យេ ៜវិហិតាចារិណះ កេៜបិ ជនា វិទ្យន្តេ តេ ច កាយ៌្យម៑ អកុវ៌្វន្ត អាលស្យម៑ អាចរន្តីត្យស្មាភិះ ឝ្រូយតេ។</para>
  <para style="p">
    <verse number="12" style="v"/>តាទ្ឫឝាន៑ លោកាន៑ អស្មតប្រភោ រ្យីឝុខ្រីឞ្ដស្យ នាម្នា វយម៑ ឥទម៑ អាទិឝាម អាជ្ញាបយាមឝ្ច, តេ ឝាន្តភាវេន កាយ៌្យំ កុវ៌្វន្តះ ស្វកីយមន្នំ ភុញ្ជតាំ។</para>
  <para style="p">
    <verse number="13" style="v"/>អបរំ ហេ ភ្រាតរះ, យូយំ សទាចរណេ ន ក្លាម្យត។</para>
  <para style="p">
    <verse number="14" style="v"/>យទិ ច កឝ្ចិទេតត្បត្រេ លិខិតាម៑ អស្មាកម៑ អាជ្ញាំ ន គ្ឫហ្លាតិ តហ៌ិ យូយំ តំ មានុឞំ លក្ឞយត តស្យ សំសគ៌ំ ត្យជត ច តេន ស ត្របិឞ្យតេ។</para>
  <para style="p">
    <verse number="15" style="v"/>កិន្តុ តំ ន ឝត្រុំ មន្យមានា ភ្រាតរមិវ ចេតយត។</para>
  <para style="p">
    <verse number="16" style="v"/>ឝាន្តិទាតា ប្រភុះ សវ៌្វត្រ សវ៌្វថា យុឞ្មភ្យំ ឝាន្តិំ ទេយាត៑។ ប្រភុ រ្យុឞ្មាកំ សវ៌្វេឞាំ សង្គី ភូយាត៑។</para>
  <para style="p">
    <verse number="17" style="v"/>នមស្ការ ឯឞ បៅលស្យ មម ករេណ លិខិតោៜភូត៑ សវ៌្វស្មិន៑ បត្រ ឯតន្មម ចិហ្នម៑ ឯតាទ្ឫឝៃរក្ឞរៃ រ្មយា លិខ្យតេ។</para>
  <para style="p">
    <verse number="18" style="v"/>អស្មាកំ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យានុुគ្រហះ សវ៌្វេឞុ យុឞ្មាសុ ភូយាត៑។ អាមេន៑។</para>
</usx>
