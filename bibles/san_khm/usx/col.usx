<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="COL" style="id">Sanskrit Bible (NT) in Khmer Script (សត្យវេទះ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Colossians</para>
  <para style="toc1">កលសិនះ បត្រំ</para>
  <para style="toc2">កលសិនះ</para>
  <para style="toc3">កលសិនះ</para>
  <para style="mt1">កលសិនះ បត្រំ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ឦឝ្វរស្យេច្ឆយា យីឝុខ្រីឞ្ដស្យ ប្រេរិតះ បៅលស្តីមថិយោ ភ្រាតា ច កលសីនគរស្ថាន៑ បវិត្រាន៑ វិឝ្វស្តាន៑ ខ្រីឞ្ដាឝ្រិតភ្រាត្ឫន៑ ប្រតិ បត្រំ លិខតះ។</para>
  <para style="p">
    <verse number="2" style="v"/>អស្មាកំ តាត ឦឝ្វរះ ប្រភុ រ្យីឝុខ្រីឞ្ដឝ្ច យុឞ្មាន៑ ប្រតិ ប្រសាទំ ឝាន្តិញ្ច ក្រិយាស្តាំ។</para>
  <para style="p">
    <verse number="3" style="v"/>ខ្រីឞ្ដេ យីឝៅ យុឞ្មាកំ វិឝ្វាសស្យ សវ៌្វាន៑ បវិត្រលោកាន៑ ប្រតិ ប្រេម្នឝ្ច វាត៌្តាំ ឝ្រុត្វា</para>
  <para style="p">
    <verse number="4" style="v"/>វយំ សទា យុឞ្មទត៌្ហំ ប្រាត៌្ហនាំ កុវ៌្វន្តះ ស្វគ៌េ និហិតាយា យុឞ្មាកំ ភាវិសម្បទះ ការណាត៑ ស្វកីយប្រភោ រ្យីឝុខ្រីឞ្ដស្យ តាតម៑ ឦឝ្វរំ ធន្យំ វទាមះ។</para>
  <para style="p">
    <verse number="5" style="v"/>យូយំ តស្យា ភាវិសម្បទោ វាត៌្តាំ យយា សុសំវាទរូបិណ្យា សត្យវាណ្យា ជ្ញាបិតាះ</para>
  <para style="p">
    <verse number="6" style="v"/>សា យទ្វត៑ ក្ឫស្នំ ជគទ៑ អភិគច្ឆតិ តទ្វទ៑ យុឞ្មាន៑ អប្យភ្យគមត៑, យូយញ្ច យទ៑ ទិនម៑ អារភ្យេឝ្វរស្យានុគ្រហស្យ វាត៌្តាំ ឝ្រុត្វា សត្យរូបេណ ជ្ញាតវន្តស្តទារភ្យ យុឞ្មាកំ មធ្យេៜបិ ផលតិ វទ៌្ធតេ ច។</para>
  <para style="p">
    <verse number="7" style="v"/>អស្មាកំ ប្រិយះ សហទាសោ យុឞ្មាកំ ក្ឫតេ ច ខ្រីឞ្ដស្យ វិឝ្វស្តបរិចារកោ យ ឥបផ្រាស្តទ៑ វាក្យំ</para>
  <para style="p">
    <verse number="8" style="v"/>យុឞ្មាន៑ អាទិឞ្ដវាន៑ ស ឯវាស្មាន៑ អាត្មនា ជនិតំ យុឞ្មាកំ ប្រេម ជ្ញាបិតវាន៑។</para>
  <para style="p">
    <verse number="9" style="v"/>វយំ យទ៑ ទិនម៑ អារភ្យ តាំ វាត៌្តាំ ឝ្រុតវន្តស្តទារភ្យ និរន្តរំ យុឞ្មាកំ ក្ឫតេ ប្រាត៌្ហនាំ កុម៌្មះ ផលតោ យូយំ យត៑ បូណ៌ាភ្យាម៑ អាត្មិកជ្ញានវុទ្ធិភ្យាម៑ ឦឝ្វរស្យាភិតមំ សម្បូណ៌រូបេណាវគច្ឆេត,</para>
  <para style="p">
    <verse number="10" style="v"/>ប្រភោ រ្យោគ្យំ សវ៌្វថា សន្តោឞជនកញ្ចាចារំ កុយ៌្យាតាត៌្ហត ឦឝ្វរជ្ញានេ វទ៌្ធមានាះ សវ៌្វសត្កម៌្មរូបំ ផលំ ផលេត,</para>
  <para style="p">
    <verse number="11" style="v"/>យថា ចេឝ្វរស្យ មហិមយុក្តយា ឝក្ត្យា សានន្ទេន បូណ៌ាំ សហិឞ្ណុតាំ តិតិក្ឞាញ្ចាចរិតុំ ឝក្ឞ្យថ តាទ្ឫឝេន បូណ៌ពលេន យទ៑ ពលវន្តោ ភវេត,</para>
  <para style="p">
    <verse number="12" style="v"/>យឝ្ច បិតា តេជោវាសិនាំ បវិត្រលោកានាម៑ អធិការស្យាំឝិត្វាយាស្មាន៑ យោគ្យាន៑ ក្ឫតវាន៑ តំ យទ៑ ធន្យំ វទេត វរម៑ ឯនំ យាចាមហេ។</para>
  <para style="p">
    <verse number="13" style="v"/>យតះ សោៜស្មាន៑ តិមិរស្យ កត៌្ត្ឫត្វាទ៑ ឧទ្ធ្ឫត្យ ស្វកីយស្យ ប្រិយបុត្រស្យ រាជ្យេ ស្ថាបិតវាន៑។</para>
  <para style="p">
    <verse number="14" style="v"/>តស្មាត៑ បុត្រាទ៑ វយំ បរិត្រាណម៑ អត៌្ហតះ បាបមោចនំ ប្រាប្តវន្តះ។</para>
  <para style="p">
    <verse number="15" style="v"/>ស ចាទ្ឫឝ្យស្យេឝ្វរស្យ ប្រតិមូត៌ិះ ក្ឫត្ស្នាយាះ ស្ឫឞ្ដេរាទិកត៌្តា ច។</para>
  <para style="p">
    <verse number="16" style="v"/>យតះ សវ៌្វមេវ តេន សស្ឫជេ សិំហាសនរាជត្វបរាក្រមាទីនិ ស្វគ៌មត៌្ត្យស្ថិតានិ ទ្ឫឝ្យាទ្ឫឝ្យានិ វស្តូនិ សវ៌្វាណិ តេនៃវ តស្មៃ ច សស្ឫជិរេ។</para>
  <para style="p">
    <verse number="17" style="v"/>ស សវ៌្វេឞាម៑ អាទិះ សវ៌្វេឞាំ ស្ថិតិការកឝ្ច។</para>
  <para style="p">
    <verse number="18" style="v"/>ស ឯវ សមិតិរូបាយាស្តនោ រ្មូទ៌្ធា កិញ្ច សវ៌្វវិឞយេ ស យទ៑ អគ្រិយោ ភវេត៑ តទត៌្ហំ ស ឯវ ម្ឫតានាំ មធ្យាត៑ ប្រថមត ឧត្ថិតោៜគ្រឝ្ច។</para>
  <para style="p">
    <verse number="19" style="v"/>យត ឦឝ្វរស្យ ក្ឫត្ស្នំ បូណ៌ត្វំ តមេវាវាសយិតុំ</para>
  <para style="p">
    <verse number="20" style="v"/>ក្រុឝេ បាតិតេន តស្យ រក្តេន សន្ធិំ វិធាយ តេនៃវ ស្វគ៌មត៌្ត្យស្ថិតានិ សវ៌្វាណិ ស្វេន សហ សន្ធាបយិតុញ្ចេឝ្វរេណាភិលេឞេ។</para>
  <para style="p">
    <verse number="21" style="v"/>បូវ៌្វំ ទូរស្ថា ទុឞ្ក្រិយារតមនស្កត្វាត៑ តស្យ រិបវឝ្ចាស្ត យេ យូយំ តាន៑ យុឞ្មាន៑ អបិ ស ឥទានីំ តស្យ មាំសលឝរីរេ មរណេន ស្វេន សហ សន្ធាបិតវាន៑។</para>
  <para style="p">
    <verse number="22" style="v"/>យតះ ស ស្វសម្មុខេ បវិត្រាន៑ និឞ្កលង្កាន៑ អនិន្ទនីយាំឝ្ច យុឞ្មាន៑ ស្ថាបយិតុម៑ ឥច្ឆតិ។</para>
  <para style="p">
    <verse number="23" style="v"/>កិន្ត្វេតទត៌្ហំ យុឞ្មាភិ រ្ពទ្ធមូលៃះ សុស្ថិរៃឝ្ច ភវិតវ្យម៑, អាកាឝមណ្ឌលស្យាធះស្ថិតានាំ សវ៌្វលោកានាំ មធ្យេ ច ឃុឞ្យមាណោ យះ សុសំវាទោ យុឞ្មាភិរឝ្រាវិ តជ្ជាតាយាំ ប្រត្យាឝាយាំ យុឞ្មាភិរចលៃ រ្ភវិតវ្យំ។</para>
  <para style="p">
    <verse number="24" style="v"/>តស្យ សុសំវាទស្យៃកះ បរិចារកោ យោៜហំ បៅលះ សោៜហម៑ ឥទានីម៑ អានន្ទេន យុឞ្មទត៌្ហំ ទុះខានិ សហេ ខ្រីឞ្ដស្យ ក្លេឝភោគស្យ យោំឝោៜបូណ៌ស្តមេវ តស្យ តនោះ សមិតេះ ក្ឫតេ ស្វឝរីរេ បូរយាមិ ច។</para>
  <para style="p">
    <verse number="25" style="v"/>យត ឦឝ្វរស្យ មន្ត្រណយា យុឞ្មទត៌្ហម៑ ឦឝ្វរីយវាក្យស្យ ប្រចារស្យ ភារោ មយិ សមបិតស្តស្មាទ៑ អហំ តស្យាះ សមិតេះ បរិចារកោៜភវំ។</para>
  <para style="p">
    <verse number="26" style="v"/>តត៑ និគូឍំ វាក្យំ បូវ៌្វយុគេឞុ បូវ៌្វបុរុឞេភ្យះ ប្រច្ឆន្នម៑ អាសីត៑ កិន្ត្វិទានីំ តស្យ បវិត្រលោកានាំ សន្និធៅ តេន ប្រាកាឝ្យត។</para>
  <para style="p">
    <verse number="27" style="v"/>យតោ ភិន្នជាតីយានាំ មធ្យេ តត៑ និគូឍវាក្យំ កីទ្ឫគ្គៅរវនិធិសម្ពលិតំ តត៑ បវិត្រលោកាន៑ ជ្ញាបយិតុម៑ ឦឝ្វរោៜភ្យលឞត៑។ យុឞ្មន្មធ្យវត៌្តី ខ្រីឞ្ដ ឯវ ស និធិ រ្គៃរវាឝាភូមិឝ្ច។</para>
  <para style="p">
    <verse number="28" style="v"/>តស្មាទ៑ វយំ តមេវ ឃោឞយន្តោ យទ៑ ឯកៃកំ មានវំ សិទ្ធីភូតំ ខ្រីឞ្ដេ ស្ថាបយេម តទត៌្ហមេកៃកំ មានវំ ប្រពោធយាមះ បូណ៌ជ្ញានេន ចៃកៃកំ មានវំ ឧបទិឝាមះ។</para>
  <para style="p">
    <verse number="29" style="v"/>ឯតទត៌្ហំ តស្យ យា ឝក្តិះ ប្រពលរូបេណ មម មធ្យេ ប្រកាឝតេ តយាហំ យតមានះ ឝ្រាភ្យាមិ។</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យុឞ្មាកំ លាយទិកេយាស្ថភ្រាត្ឫណាញ្ច ក្ឫតេ យាវន្តោ ភ្រាតរឝ្ច មម ឝារីរិកមុខំ ន ទ្ឫឞ្ដវន្តស្តេឞាំ ក្ឫតេ មម កិយាន៑ យត្នោ ភវតិ តទ៑ យុឞ្មាន៑ ជ្ញាបយិតុម៑ ឥច្ឆាមិ។</para>
  <para style="p">
    <verse number="2" style="v"/>ផលតះ បូណ៌ពុទ្ធិរូបធនភោគាយ ប្រេម្នា សំយុក្តានាំ តេឞាំ មនាំសិ យត៑ បិតុរីឝ្វរស្យ ខ្រីឞ្ដស្យ ច និគូឍវាក្យស្យ ជ្ញានាត៌្ហំ សាន្ត្វនាំ ប្រាប្នុយុរិត្យត៌្ហមហំ យតេ។</para>
  <para style="p">
    <verse number="3" style="v"/>យតោ វិទ្យាជ្ញានយោះ សវ៌្វេ និធយះ ខ្រីឞ្ដេ គុប្តាះ សន្តិ។</para>
  <para style="p">
    <verse number="4" style="v"/>កោៜបិ យុឞ្មាន៑ វិនយវាក្យេន យន្ន វញ្ចយេត៑ តទត៌្ហម៑ ឯតានិ មយា កថ្យន្តេ។</para>
  <para style="p">
    <verse number="5" style="v"/>យុឞ្មត្សន្និធៅ មម ឝរីរេៜវត៌្តមានេៜបិ មមាត្មា វត៌្តតេ តេន យុឞ្មាកំ សុរីតិំ ខ្រីឞ្ដវិឝ្វាសេ ស្ថិរត្វញ្ច ទ្ឫឞ្ដ្វាហម៑ អានន្ទាមិ។</para>
  <para style="p">
    <verse number="6" style="v"/>អតោ យូយំ ប្រភុំ យីឝុខ្រីឞ្ដំ យាទ្ឫគ៑ គ្ឫហីតវន្តស្តាទ្ឫក៑ តម៑ អនុចរត។</para>
  <para style="p">
    <verse number="7" style="v"/>តស្មិន៑ ពទ្ធមូលាះ ស្ថាបិតាឝ្ច ភវត យា ច ឝិក្ឞា យុឞ្មាភិ រ្លព្ធា តទនុសារាទ៑ វិឝ្វាសេ សុស្ថិរាះ សន្តស្តេនៃវ និត្យំ ធន្យវាទំ កុរុត។</para>
  <para style="p">
    <verse number="8" style="v"/>សាវធានា ភវត មានុឞិកឝិក្ឞាត ឥហលោកស្យ វណ៌មាលាតឝ្ចោត្បន្នា ខ្រីឞ្ដស្យ វិបក្ឞា យា ទឝ៌នវិទ្យា មិថ្យាប្រតារណា ច តយា កោៜបិ យុឞ្មាកំ ក្ឞតិំ ន ជនយតុ។</para>
  <para style="p">
    <verse number="9" style="v"/>យត ឦឝ្វរស្យ ក្ឫត្ស្នា បូណ៌តា មូត៌្តិមតី ខ្រីឞ្ដេ វសតិ។</para>
  <para style="p">
    <verse number="10" style="v"/>យូយញ្ច តេន បូណ៌ា ភវថ យតះ ស សវ៌្វេឞាំ រាជត្វកត៌្ត្ឫត្វបទានាំ មូទ៌្ធាស្តិ,</para>
  <para style="p">
    <verse number="11" style="v"/>តេន ច យូយម៑ អហស្តក្ឫតត្វក្ឆេទេនាត៌្ហតោ យេន ឝារីរបាបានាំ វិគ្រសត្យជ្យតេ តេន ខ្រីឞ្ដស្យ ត្វក្ឆេទេន ឆិន្នត្វចោ ជាតា</para>
  <para style="p">
    <verse number="12" style="v"/>មជ្ជនេ ច តេន សាទ៌្ធំ ឝ្មឝានំ ប្រាប្តាះ បុន រ្ម្ឫតានាំ មធ្យាត៑ តស្យោត្ថាបយិតុរីឝ្វរស្យ ឝក្តេះ ផលំ យោ វិឝ្វាសស្តទ្វារា តស្មិន្នេវ មជ្ជនេ តេន សាទ៌្ធម៑ ឧត្ថាបិតា អភវត។</para>
  <para style="p">
    <verse number="13" style="v"/>ស ច យុឞ្មាន៑ អបរាធៃះ ឝារីរិកាត្វក្ឆេទេន ច ម្ឫតាន៑ ទ្ឫឞ្ដ្វា តេន សាទ៌្ធំ ជីវិតវាន៑ យុឞ្មាកំ សវ៌្វាន៑ អបរាធាន៑ ក្ឞមិតវាន៑,</para>
  <para style="p">
    <verse number="14" style="v"/>យច្ច ទណ្ឌាជ្ញារូបំ ឫណបត្រម៑ អស្មាកំ វិរុទ្ធម៑ អាសីត៑ តត៑ ប្រមាជ៌្ជិតវាន៑ ឝលាកាភិះ ក្រុឝេ ពទ្ធ្វា ទូរីក្ឫតវាំឝ្ច។</para>
  <para style="p">
    <verse number="15" style="v"/>កិញ្ច តេន រាជត្វកត៌្ត្ឫត្វបទានិ និស្តេជាំសិ ក្ឫត្វា បរាជិតាន៑ រិបូនិវ ប្រគល្ភតយា សវ៌្វេឞាំ ទ្ឫឞ្ដិគោចរេ ហ្រេបិតវាន៑។</para>
  <para style="p">
    <verse number="16" style="v"/>អតោ ហេតោះ ខាទ្យាខាទ្យេ បេយាបេយេ ឧត្សវះ ប្រតិបទ៑ វិឝ្រាមវារឝ្ចៃតេឞុ សវ៌្វេឞុ យុឞ្មាកំ ន្យាយាធិបតិរូបំ កមបិ មា គ្ឫហ្លីត។</para>
  <para style="p">
    <verse number="17" style="v"/>យត ឯតានិ ឆាយាស្វរូបាណិ កិន្តុ សត្យា មូត៌្តិះ ខ្រីឞ្ដះ។</para>
  <para style="p">
    <verse number="18" style="v"/>អបរញ្ច នម្រតា ស្វគ៌ទូតានាំ សេវា ចៃតាទ្ឫឝម៑ ឥឞ្ដកម៌្មាចរន៑ យះ កឝ្ចិត៑ បរោក្ឞវិឞយាន៑ ប្រវិឝតិ ស្វកីយឝារីរិកភាវេន ច មុធា គវ៌្វិតះ សន្</para>
  <para style="p">
    <verse number="19" style="v"/>សន្ធិភិះ ឝិរាភិឝ្ចោបក្ឫតំ សំយុក្តញ្ច ក្ឫត្ស្នំ ឝរីរំ យស្មាត៑ មូទ៌្ធត ឦឝ្វរីយវ្ឫទ្ធិំ ប្រាប្នោតិ តំ មូទ៌្ធានំ ន ធារយតិ តេន មានវេន យុឞ្មត្តះ ផលាបហរណំ នានុជានីត។</para>
  <para style="p">
    <verse number="20" style="v"/>យទិ យូយំ ខ្រីឞ្ដេន សាទ៌្ធំ សំសារស្យ វណ៌មាលាយៃ ម្ឫតា អភវត តហ៌ិ យៃै រ្ទ្រវ្យៃ រ្ភោគេន ក្ឞយំ គន្តវ្យំ</para>
  <para style="p">
    <verse number="21" style="v"/>តានិ មា ស្ប្ឫឝ មា ភុំក្ឞ្វ មា គ្ឫហាណេតិ មានវៃរាទិឞ្ដាន៑ ឝិក្ឞិតាំឝ្ច វិធីន្</para>
  <para style="p">
    <verse number="22" style="v"/>អាចរន្តោ យូយំ កុតះ សំសារេ ជីវន្ត ឥវ ភវថ?</para>
  <para style="p">
    <verse number="23" style="v"/>តេ វិធយះ ស្វេច្ឆាភក្ត្យា នម្រតយា ឝរីរក្លេឝនេន ច ជ្ញានវិធិវត៑ ប្រកាឝន្តេ តថាបិ តេៜគណ្យាះ ឝារីរិកភាវវទ៌្ធកាឝ្ច សន្តិ។</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យទិ យូយំ ខ្រីឞ្ដេន សាទ៌្ធម៑ ឧត្ថាបិតា អភវត តហ៌ិ យស្មិន៑ ស្ថានេ ខ្រីឞ្ដ ឦឝ្វរស្យ ទក្ឞិណបាឝ៌្វេ ឧបវិឞ្ដ អាស្តេ តស្យោទ៌្ធ្វស្ថានស្យ វិឞយាន៑ ចេឞ្ដធ្វំ។</para>
  <para style="p">
    <verse number="2" style="v"/>បាត៌្ហិវវិឞយេឞុ ន យតមានា ឩទ៌្ធ្វស្ថវិឞយេឞុ យតធ្វំ។</para>
  <para style="p">
    <verse number="3" style="v"/>យតោ យូយំ ម្ឫតវន្តោ យុឞ្មាកំ ជីវិតញ្ច ខ្រីឞ្ដេន សាទ៌្ធម៑ ឦឝ្វរេ គុប្តម៑ អស្តិ។</para>
  <para style="p">
    <verse number="4" style="v"/>អស្មាកំ ជីវនស្វរូបះ ខ្រីឞ្ដោ យទា ប្រកាឝិឞ្យតេ តទា តេន សាទ៌្ធំ យូយមបិ វិភវេន ប្រកាឝិឞ្យធ្វេ។</para>
  <para style="p">
    <verse number="5" style="v"/>អតោ វេឝ្យាគមនម៑ អឝុចិក្រិយា រាគះ កុត្សិតាភិលាឞោ ទេវបូជាតុល្យោ លោភឝ្ចៃតានិ រ្បាिថវបុរុឞស្យាង្គានិ យុឞ្មាភិ រ្និហន្យន្តាំ។</para>
  <para style="p">
    <verse number="6" style="v"/>យត ឯតេភ្យះ កម៌្មភ្យ អាជ្ញាលង្ឃិនោ លោកាន៑ ប្រតីឝ្វរស្យ ក្រោធោ វត៌្តតេ។</para>
  <para style="p">
    <verse number="7" style="v"/>បូវ៌្វំ យទា យូយំ តាន្យុបាជីវត តទា យូយមបិ តាន្យេវាចរត;</para>
  <para style="p">
    <verse number="8" style="v"/>កិន្ត្វិទានីំ ក្រោធោ រោឞោ ជិហិំសិឞា ទុម៌ុខតា វទននិគ៌តកទាលបឝ្ចៃតានិ សវ៌្វាណិ ទូរីកុរុធ្វំ។</para>
  <para style="p">
    <verse number="9" style="v"/>យូយំ បរស្បរំ ម្ឫឞាកថាំ ន វទត យតោ យូយំ ស្វកម៌្មសហិតំ បុរាតនបុរុឞំ ត្យក្តវន្តះ</para>
  <para style="p">
    <verse number="10" style="v"/>ស្វស្រឞ្ដុះ ប្រតិមូត៌្យា តត្ត្វជ្ញានាយ នូតនីក្ឫតំ នវីនបុរុឞំ បរិហិតវន្តឝ្ច។</para>
  <para style="p">
    <verse number="11" style="v"/>តេន ច យិហូទិភិន្នជាតីយយោឝ្ឆិន្នត្វគច្ឆិន្នត្វចោ រ្ម្លេច្ឆស្កុថីយយោ រ្ទាសមុក្តយោឝ្ច កោៜបិ វិឝេឞោ នាស្តិ កិន្តុ សវ៌្វេឞុ សវ៌្វះ ខ្រីឞ្ដ ឯវាស្តេ។</para>
  <para style="p">
    <verse number="12" style="v"/>អតឯវ យូយម៑ ឦឝ្វរស្យ មនោភិលឞិតាះ បវិត្រាះ ប្រិយាឝ្ច លោកា ឥវ ស្នេហយុក្តាម៑ អនុកម្បាំ ហិតៃឞិតាំ នម្រតាំ តិតិក្ឞាំ សហិឞ្ណុតាញ្ច បរិធទ្ធ្វំ។</para>
  <para style="p">
    <verse number="13" style="v"/>យូយម៑ ឯកៃកស្យាចរណំ សហធ្វំ យេន ច យស្យ កិមប្យបរាធ្យតេ តស្យ តំ ទោឞំ ស ក្ឞមតាំ, ខ្រីឞ្ដោ យុឞ្មាកំ ទោឞាន៑ យទ្វទ៑ ក្ឞមិតវាន៑ យូយមបិ តទ្វត៑ កុរុធ្វំ។</para>
  <para style="p">
    <verse number="14" style="v"/>វិឝេឞតះ សិទ្ធិជនកេន ប្រេមពន្ធនេន ពទ្ធា ភវត។</para>
  <para style="p">
    <verse number="15" style="v"/>យស្យាះ ប្រាប្តយេ យូយម៑ ឯកស្មិន៑ ឝរីរេ សមាហូតា អភវត សេឝ្វរីយា ឝាន្តិ រ្យុឞ្មាកំ មនាំស្យធិតិឞ្ឋតុ យូយញ្ច ក្ឫតជ្ញា ភវត។</para>
  <para style="p">
    <verse number="16" style="v"/>ខ្រីឞ្ដស្យ វាក្យំ សវ៌្វវិធជ្ញានាយ សម្បូណ៌រូបេណ យុឞ្មទន្តរេ និវមតុ, យូយញ្ច គីតៃ រ្គានៃះ បារមាត៌្ហិកសង្កីត៌្តនៃឝ្ច បរស្បរម៑ អាទិឝត ប្រពោធយត ច, អនុគ្ឫហីតត្វាត៑ ប្រភុម៑ ឧទ្ទិឝ្យ ស្វមនោភិ រ្គាយត ច។</para>
  <para style="p">
    <verse number="17" style="v"/>វាចា កម៌្មណា វា យទ៑ យត៑ កុរុត តត៑ សវ៌្វំ ប្រភោ រ្យីឝោ រ្នាម្នា កុរុត តេន បិតរម៑ ឦឝ្វរំ ធន្យំ វទត ច។</para>
  <para style="p">
    <verse number="18" style="v"/>ហេ យោឞិតះ, យូយំ ស្វាមិនាំ វឝ្យា ភវត យតស្តទេវ ប្រភវេ រោចតេ។</para>
  <para style="p">
    <verse number="19" style="v"/>ហេ ស្វាមិនះ, យូយំ ភាយ៌្យាសុ ប្រីយធ្វំ តាះ ប្រតិ បរុឞាលាបំ មា កុរុធ្វំ។</para>
  <para style="p">
    <verse number="20" style="v"/>ហេ ពាលាះ, យូយំ សវ៌្វវិឞយេ បិត្រោរាជ្ញាគ្រាហិណោ ភវត យតស្តទេវ ប្រភោះ សន្តោឞជនកំ។</para>
  <para style="p">
    <verse number="21" style="v"/>ហេ បិតរះ, យុឞ្មាកំ សន្តានា យត៑ កាតរា ន ភវេយុស្តទត៌្ហំ តាន៑ ប្រតិ មា រោឞយត។</para>
  <para style="p">
    <verse number="22" style="v"/>ហេ ទាសាះ, យូយំ សវ៌្វវិឞយ ឰហិកប្រភូនាម៑ អាជ្ញាគ្រាហិណោ ភវត ទ្ឫឞ្ដិគោចរីយសេវយា មានវេភ្យោ រោចិតុំ មា យតធ្វំ កិន្តុ សរលាន្តះករណៃះ ប្រភោ រ្ភាीត្យា កាយ៌្យំ កុរុធ្វំ។</para>
  <para style="p">
    <verse number="23" style="v"/>យច្ច កុរុធ្វេ តត៑ មានុឞមនុទ្ទិឝ្យ ប្រភុម៑ ឧទ្ទិឝ្យ ប្រផុល្លមនសា កុរុធ្វំ,</para>
  <para style="p">
    <verse number="24" style="v"/>យតោ វយំ ប្រភុតះ ស្វគ៌ាធិការរូបំ ផលំ លប្ស្យាមហ ឥតិ យូយំ ជានីថ យស្មាទ៑ យូយំ ប្រភោះ ខ្រីឞ្ដស្យ ទាសា ភវថ។</para>
  <para style="p">
    <verse number="25" style="v"/>កិន្តុ យះ កឝ្ចិទ៑ អនុចិតំ កម៌្ម ករោតិ ស តស្យានុចិតកម៌្មណះ ផលំ លប្ស្យតេ តត្រ កោៜបិ បក្ឞបាតោ ន ភវិឞ្យតិ។</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អបរញ្ច ហេ អធិបតយះ, យូយំ ទាសាន៑ ប្រតិ ន្យាយ្យំ យថាត៌្ហញ្ចាចរណំ កុរុធ្វំ យុឞ្មាកមប្យេកោៜធិបតិះ ស្វគ៌េ វិទ្យត ឥតិ ជានីត។</para>
  <para style="p">
    <verse number="2" style="v"/>យូយំ ប្រាត៌្ហនាយាំ និត្យំ ប្រវត៌្តធ្វំ ធន្យវាទំ កុវ៌្វន្តស្តត្រ ប្រពុទ្ធាស្តិឞ្ឋត ច។</para>
  <para style="p">
    <verse number="3" style="v"/>ប្រាត៌្ហនាកាលេ មមាបិ ក្ឫតេ ប្រាត៌្ហនាំ កុរុធ្វំ,</para>
  <para style="p">
    <verse number="4" style="v"/>ផលតះ ខ្រីឞ្ដស្យ យន្និគូឍវាក្យការណាទ៑ អហំ ពទ្ធោៜភវំ តត្ប្រកាឝាយេឝ្វរោ យត៑ មទត៌្ហំ វាគ្ទ្វារំ កុយ៌្យាត៑, អហញ្ច យថោចិតំ តត៑ ប្រកាឝយិតុំ ឝក្នុយាម៑ ឯតត៑ ប្រាត៌្ហយធ្វំ។</para>
  <para style="p">
    <verse number="5" style="v"/>យូយំ សមយំ ពហុមូល្យំ ជ្ញាត្វា ពហិះស្ថាន៑ លោកាន៑ ប្រតិ ជ្ញានាចារំ កុរុធ្វំ។</para>
  <para style="p">
    <verse number="6" style="v"/>យុឞ្មាកម៑ អាលាបះ សវ៌្វទានុគ្រហសូចកោ លវណេន សុស្វាទុឝ្ច ភវតុ យស្មៃ យទុត្តរំ ទាតវ្យំ តទ៑ យុឞ្មាភិរវគម្យតាំ។</para>
  <para style="p">
    <verse number="7" style="v"/>មម យា ទឝាក្តិ តាំ តុខិកនាមា ប្រភៅ ប្រិយោ មម ភ្រាតា វិឝ្វសនីយះ បរិចារកះ សហទាសឝ្ច យុឞ្មាន៑ ជ្ញាបយិឞ្យតិ។</para>
  <para style="p">
    <verse number="8" style="v"/>ស យទ៑ យុឞ្មាកំ ទឝាំ ជានីយាត៑ យុឞ្មាកំ មនាំសិ សាន្ត្វយេច្ច តទត៌្ហមេវាហំ</para>
  <para style="p">
    <verse number="9" style="v"/>តម៑ ឱនីឞិមនាមានញ្ច យុឞ្មទ្ទេឝីយំ វិឝ្វស្តំ ប្រិយញ្ច ភ្រាតរំ ប្រេឞិតវាន៑ តៅ យុឞ្មាន៑ អត្រត្យាំ សវ៌្វវាត៌្តាំ ជ្ញាបយិឞ្យតះ។</para>
  <para style="p">
    <verse number="10" style="v"/>អារិឞ្ដាក៌្ហនាមា មម សហពន្ទី ពណ៌ព្ពា ភាគិនេយោ មាក៌ោ យុឞ្ដនាម្នា វិខ្យាតោ យីឝុឝ្ចៃតេ ឆិន្នត្វចោ ភ្រាតរោ យុឞ្មាន៑ នមស្ការំ ជ្ញាបយន្តិ, តេឞាំ មធ្យេ មាក៌មធិ យូយំ បូវ៌្វម៑ អាជ្ញាបិតាះ ស យទិ យុឞ្មត្សមីបម៑ ឧបតិឞ្ឋេត៑ តហ៌ិ យុឞ្មាភិ រ្គ្ឫហ្យតាំ។</para>
  <para style="p">
    <verse number="11" style="v"/>កេវលមេត ឦឝ្វររាជ្យេ មម សាន្ត្វនាជនកាះ សហការិណោៜភវន៑។</para>
  <para style="p">
    <verse number="12" style="v"/>ខ្រីឞ្ដស្យ ទាសោ យោ យុឞ្មទ្ទេឝីយ ឥបផ្រាះ ស យុឞ្មាន៑ នមស្ការំ ជ្ញាបយតិ យូយញ្ចេឝ្វរស្យ សវ៌្វស្មិន៑ មនោៜភិលាឞេ យត៑ សិទ្ធាះ បូណ៌ាឝ្ច ភវេត តទត៌្ហំ ស និត្យំ ប្រាត៌្ហនយា យុឞ្មាកំ ក្ឫតេ យតតេ។</para>
  <para style="p">
    <verse number="13" style="v"/>យុឞ្មាកំ លាយទិកេយាស្ថិតានាំ ហិយរាបលិស្ថិតានាញ្ច ភ្រាត្ឫណាំ ហិតាយ សោៜតីវ ចេឞ្ដត ឥត្យស្មិន៑ អហំ តស្យ សាក្ឞី ភវាមិ។</para>
  <para style="p">
    <verse number="14" style="v"/>លូកនាមា ប្រិយឝ្ចិកិត្សកោ ទីមាឝ្ច យុឞ្មភ្យំ នមស្កុវ៌្វាតេ។</para>
  <para style="p">
    <verse number="15" style="v"/>យូយំ លាយទិកេយាស្ថាន៑ ភ្រាត្ឫន៑ នុម្ផាំ តទ្គ្ឫហស្ថិតាំ សមិតិញ្ច មម នមស្ការំ ជ្ញាបយត។</para>
  <para style="p">
    <verse number="16" style="v"/>អបរំ យុឞ្មត្សន្និធៅ បត្រស្យាស្យ បាឋេ ក្ឫតេ លាយទិកេយាស្ថសមិតាវបិ តស្យ បាឋោ យថា ភវេត៑ លាយទិកេយាញ្ច យត៑ បត្រំ មយា ប្រហិតំ តទ៑ យថា យុឞ្មាភិរបិ បឋ្យេត តថា ចេឞ្ដធ្វំ។</para>
  <para style="p">
    <verse number="17" style="v"/>អបរម៑ អាក៌្ហិប្បំ វទត ប្រភោ រ្យត៑ បរិចយ៌្យាបទំ ត្វយាប្រាបិ តត្សាធនាយ សាវធានោ ភវ។</para>
  <para style="p">
    <verse number="18" style="v"/>អហំ បៅលះ ស្វហស្តាក្ឞរេណ យុឞ្មាន៑ នមស្ការំ ជ្ញាបយាមិ យូយំ មម ពន្ធនំ ស្មរត។ យុឞ្មាន៑ ប្រត្យនុគ្រហោ ភូយាត៑។ អាមេន។</para>
</usx>
