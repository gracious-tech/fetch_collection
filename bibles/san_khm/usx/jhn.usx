<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JHN" style="id">Sanskrit Bible (NT) in Khmer Script (សត្យវេទះ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">John</para>
  <para style="toc1">យោហនលិខិតះ សុសំវាទះ</para>
  <para style="toc2">យោហនះ</para>
  <para style="toc3">យោហនះ</para>
  <para style="mt1">យោហនលិខិតះ សុសំវាទះ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អាទៅ វាទ អាសីត៑ ស ច វាទ ឦឝ្វរេណ សាទ៌្ហមាសីត៑ ស វាទះ ស្វយមីឝ្វរ ឯវ។</para>
  <para style="p">
    <verse number="2" style="v"/>ស អាទាវីឝ្វរេណ សហាសីត៑។</para>
  <para style="p">
    <verse number="3" style="v"/>តេន សវ៌្វំ វស្តុ សស្ឫជេ សវ៌្វេឞុ ស្ឫឞ្ដវស្តុឞុ កិមបិ វស្តុ តេនាស្ឫឞ្ដំ នាស្តិ។</para>
  <para style="p">
    <verse number="4" style="v"/>ស ជីវនស្យាការះ, តច្ច ជីវនំ មនុឞ្យាណាំ ជ្យោតិះ</para>
  <para style="p">
    <verse number="5" style="v"/>តជ្ជ្យោតិរន្ធការេ ប្រចកាឝេ កិន្ត្វន្ធការស្តន្ន ជគ្រាហ។</para>
  <para style="p">
    <verse number="6" style="v"/>យោហន៑ នាមក ឯកោ មនុជ ឦឝ្វរេណ ប្រេឞយាញ្ចក្រេ។</para>
  <para style="p">
    <verse number="7" style="v"/>តទ្វារា យថា សវ៌្វេ វិឝ្វសន្តិ តទត៌្ហំ ស តជ្ជ្យោតិឞិ ប្រមាណំ ទាតុំ សាក្ឞិស្វរូបោ ភូត្វាគមត៑,</para>
  <para style="p">
    <verse number="8" style="v"/>ស ស្វយំ តជ្ជ្យោតិ រ្ន កិន្តុ តជ្ជ្យោតិឞិ ប្រមាណំ ទាតុមាគមត៑។</para>
  <para style="p">
    <verse number="9" style="v"/>ជគត្យាគត្យ យះ សវ៌្វមនុជេភ្យោ ទីប្តិំ ទទាតិ តទេវ សត្យជ្យោតិះ។</para>
  <para style="p">
    <verse number="10" style="v"/>ស យជ្ជគទស្ឫជត៑ តន្មទ្យ ឯវ ស អាសីត៑ កិន្តុ ជគតោ លោកាស្តំ នាជានន៑។</para>
  <para style="p">
    <verse number="11" style="v"/>និជាធិការំ ស អាគច្ឆត៑ កិន្តុ ប្រជាស្តំ នាគ្ឫហ្លន៑។</para>
  <para style="p">
    <verse number="12" style="v"/>តថាបិ យេ យេ តមគ្ឫហ្លន៑ អត៌្ហាត៑ តស្យ នាម្និ វ្យឝ្វសន៑ តេភ្យ ឦឝ្វរស្យ បុត្រា ភវិតុម៑ អធិការម៑ អទទាត៑។</para>
  <para style="p">
    <verse number="13" style="v"/>តេឞាំ ជនិះ ឝោណិតាន្ន ឝារីរិកាភិលាឞាន្ន មានវានាមិច្ឆាតោ ន កិន្ត្វីឝ្វរាទភវត៑។</para>
  <para style="p">
    <verse number="14" style="v"/>ស វាទោ មនុឞ្យរូបេណាវតីយ៌្យ សត្យតានុគ្រហាភ្យាំ បរិបូណ៌ះ សន៑ សាទ៌្ហម៑ អស្មាភិ រ្ន្យវសត៑ តតះ បិតុរទ្វិតីយបុត្រស្យ យោគ្យោ យោ មហិមា តំ មហិមានំ តស្យាបឝ្យាម។</para>
  <para style="p">
    <verse number="15" style="v"/>តតោ យោហនបិ ប្រចាយ៌្យ សាក្ឞ្យមិទំ ទត្តវាន៑ យោ មម បឝ្ចាទ៑ អាគមិឞ្យតិ ស មត្តោ គុរុតរះ; យតោ មត្បូវ៌្វំ ស វិទ្យមាន អាសីត៑; យទត៌្ហម៑ អហំ សាក្ឞ្យមិទម៑ អទាំ ស ឯឞះ។</para>
  <para style="p">
    <verse number="16" style="v"/>អបរញ្ច តស្យ បូណ៌តាយា វយំ សវ៌្វេ ក្រមឝះ ក្រមឝោនុគ្រហំ ប្រាប្តាះ។</para>
  <para style="p">
    <verse number="17" style="v"/>មូសាទ្វារា វ្យវស្ថា ទត្តា កិន្ត្វនុគ្រហះ សត្យត្វញ្ច យីឝុខ្រីឞ្ដទ្វារា សមុបាតិឞ្ឋតាំ។</para>
  <para style="p">
    <verse number="18" style="v"/>កោបិ មនុជ ឦឝ្វរំ កទាបិ នាបឝ្យត៑ កិន្តុ បិតុះ ក្រោឌស្ថោៜទ្វិតីយះ បុត្រស្តំ ប្រកាឝយត៑។</para>
  <para style="p">
    <verse number="19" style="v"/>ត្វំ កះ? ឥតិ វាក្យំ ប្រេឞ្ដុំ យទា យិហូទីយលោកា យាជកាន៑ លេវិលោកាំឝ្ច យិរូឝាលមោ យោហនះ សមីបេ ប្រេឞយាមាសុះ,</para>
  <para style="p">
    <verse number="20" style="v"/>តទា ស ស្វីក្ឫតវាន៑ នាបហ្នូតវាន៑ នាហម៑ អភិឞិក្ត ឥត្យង្គីក្ឫតវាន៑។</para>
  <para style="p">
    <verse number="21" style="v"/>តទា តេៜប្ឫច្ឆន៑ តហ៌ិ កោ ភវាន៑? កិំ ឯលិយះ? សោវទត៑ ន; តតស្តេៜប្ឫច្ឆន៑ តហ៌ិ ភវាន៑ ស ភវិឞ្យទ្វាទី? សោវទត៑ នាហំ សះ។</para>
  <para style="p">
    <verse number="22" style="v"/>តទា តេៜប្ឫច្ឆន៑ តហ៌ិ ភវាន៑ កះ? វយំ គត្វា ប្រេរកាន៑ ត្វយិ កិំ វក្ឞ្យាមះ? ស្វស្មិន៑ កិំ វទសិ?</para>
  <para style="p">
    <verse number="23" style="v"/>តទា សោវទត៑។ បរមេឝស្យ បន្ថានំ បរិឞ្កុរុត សវ៌្វតះ។ ឥតីទំ ប្រាន្តរេ វាក្យំ វទតះ កស្យចិទ្រវះ។ កថាមិមាំ យស្មិន៑ យិឝយិយោ ភវិឞ្យទ្វាទី លិខិតវាន៑ សោហម៑។</para>
  <para style="p">
    <verse number="24" style="v"/>យេ ប្រេឞិតាស្តេ ផិរូឝិលោកាះ។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា តេៜប្ឫច្ឆន៑ យទិ នាភិឞិក្តោសិ ឯលិយោសិ ន ស ភវិឞ្យទ្វាទ្យបិ នាសិ ច, តហ៌ិ លោកាន៑ មជ្ជយសិ កុតះ?</para>
  <para style="p">
    <verse number="26" style="v"/>តតោ យោហន៑ ប្រត្យវោចត៑, តោយេៜហំ មជ្ជយាមីតិ សត្យំ កិន្តុ យំ យូយំ ន ជានីថ តាទ្ឫឝ ឯកោ ជនោ យុឞ្មាកំ មធ្យ ឧបតិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="27" style="v"/>ស មត្បឝ្ចាទ៑ អាគតោបិ មត្បូវ៌្វំ វត៌្តមាន អាសីត៑ តស្យ បាទុកាពន្ធនំ មោចយិតុមបិ នាហំ យោគ្យោស្មិ។</para>
  <para style="p">
    <verse number="28" style="v"/>យទ៌្ទននទ្យាះ បារស្ថពៃថពារាយាំ យស្មិន្ស្ថានេ យោហនមជ្ជយត៑ តស្មិន ស្ថានេ សវ៌្វមេតទ៑ អឃដត។</para>
  <para style="p">
    <verse number="29" style="v"/>បរេៜហនិ យោហន៑ ស្វនិកដមាគច្ឆន្តំ យិឝុំ វិលោក្យ ប្រាវោចត៑ ជគតះ បាបមោចកម៑ ឦឝ្វរស្យ មេឞឝាវកំ បឝ្យត។</para>
  <para style="p">
    <verse number="30" style="v"/>យោ មម បឝ្ចាទាគមិឞ្យតិ ស មត្តោ គុរុតរះ, យតោ ហេតោម៌ត្បូវ៌្វំ សោៜវត៌្តត យស្មិន្នហំ កថាមិមាំ កថិតវាន៑ ស ឯវាយំ។</para>
  <para style="p">
    <verse number="31" style="v"/>អបរំ នាហមេនំ ប្រត្យភិជ្ញាតវាន៑ កិន្តុ ឥស្រាយេល្លោកា ឯនំ យថា បរិចិន្វន្តិ តទភិប្រាយេណាហំ ជលេ មជ្ជយិតុមាគច្ឆម៑។</para>
  <para style="p">
    <verse number="32" style="v"/>បុនឝ្ច យោហនបរមេកំ ប្រមាណំ ទត្វា កថិតវាន៑ វិហាយសះ កបោតវទ៑ អវតរន្តមាត្មានម៑ អស្យោបយ៌្យវតិឞ្ឋន្តំ ច ទ្ឫឞ្ដវានហម៑។</para>
  <para style="p">
    <verse number="33" style="v"/>នាហមេនំ ប្រត្យភិជ្ញាតវាន៑ ឥតិ សត្យំ កិន្តុ យោ ជលេ មជ្ជយិតុំ មាំ ប្រៃរយត៑ ស ឯវេមាំ កថាមកថយត៑ យស្យោបយ៌្យាត្មានម៑ អវតរន្តម៑ អវតិឞ្ឋន្តញ្ច ទ្រក្ឞយសិ សឯវ បវិត្រេ អាត្មនិ មជ្ជយិឞ្យតិ។</para>
  <para style="p">
    <verse number="34" style="v"/>អវស្តន្និរីក្ឞ្យាយម៑ ឦឝ្វរស្យ តនយ ឥតិ ប្រមាណំ ទទាមិ។</para>
  <para style="p">
    <verse number="35" style="v"/>បរេៜហនិ យោហន៑ ទ្វាភ្យាំ ឝិឞ្យាភ្យាំ សាទ៌្ធេំ តិឞ្ឋន្</para>
  <para style="p">
    <verse number="36" style="v"/>យិឝុំ គច្ឆន្តំ វិលោក្យ គទិតវាន៑, ឦឝ្វរស្យ មេឞឝាវកំ បឝ្យតំ។</para>
  <para style="p">
    <verse number="37" style="v"/>ឥមាំ កថាំ ឝ្រុត្វា ទ្វៅ ឝិឞ្យៅ យីឝោះ បឝ្ចាទ៑ ឦយតុះ។</para>
  <para style="p">
    <verse number="38" style="v"/>តតោ យីឝុះ បរាវ្ឫត្យ តៅ បឝ្ចាទ៑ អាគច្ឆន្តៅ ទ្ឫឞ្ដ្វា ប្ឫឞ្ដវាន៑ យុវាំ កិំ គវេឝយថះ? តាវប្ឫច្ឆតាំ ហេ រព្ពិ អត៌្ហាត៑ ហេ គុរោ ភវាន៑ កុត្រ តិឞ្ឋតិ?</para>
  <para style="p">
    <verse number="39" style="v"/>តតះ សោវាទិត៑ ឯត្យ បឝ្យតំ។ តតោ ទិវសស្យ ត្ឫតីយប្រហរស្យ គតត្វាត៑ តៅ តទ្ទិនំ តស្យ សង្គេៜស្ថាតាំ។</para>
  <para style="p">
    <verse number="40" style="v"/>យៅ ទ្វៅ យោហនោ វាក្យំ ឝ្រុត្វា យិឝោះ បឝ្ចាទ៑ អាគមតាំ តយោះ ឝិមោន្បិតរស្យ ភ្រាតា អាន្ទ្រិយះ</para>
  <para style="p">
    <verse number="41" style="v"/>ស ឥត្វា ប្រថមំ និជសោទរំ ឝិមោនំ សាក្ឞាត្ប្រាប្យ កថិតវាន៑ វយំ ខ្រីឞ្ដម៑ អត៌្ហាត៑ អភិឞិក្តបុរុឞំ សាក្ឞាត្ក្ឫតវន្តះ។</para>
  <para style="p">
    <verse number="42" style="v"/>បឝ្ចាត៑ ស តំ យិឝោះ សមីបម៑ អានយត៑។ តទា យីឝុស្តំ ទ្ឫឞ្ដ្វាវទត៑ ត្វំ យូនសះ បុត្រះ ឝិមោន៑ កិន្តុ ត្វន្នាមធេយំ កៃផាះ វា បិតរះ អត៌្ហាត៑ ប្រស្តរោ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="43" style="v"/>បរេៜហនិ យីឝៅ គាលីលំ គន្តុំ និឝ្ចិតចេតសិ សតិ ផិលិបនាមានំ ជនំ សាក្ឞាត្ប្រាប្យាវោចត៑ មម បឝ្ចាទ៑ អាគច្ឆ។</para>
  <para style="p">
    <verse number="44" style="v"/>ពៃត្សៃទានាម្និ យស្មិន៑ គ្រាមេ បិតរាន្ទ្រិយយោវ៌ាស អាសីត៑ តស្មិន៑ គ្រាមេ តស្យ ផិលិបស្យ វសតិរាសីត៑។</para>
  <para style="p">
    <verse number="45" style="v"/>បឝ្ចាត៑ ផិលិបោ និថនេលំ សាក្ឞាត្ប្រាប្យាវទត៑ មូសា វ្យវស្ថា គ្រន្ថេ ភវិឞ្យទ្វាទិនាំ គ្រន្ថេឞុ ច យស្យាខ្យានំ លិខិតមាស្តេ តំ យូឞផះ បុត្រំ នាសរតីយំ យីឝុំ សាក្ឞាទ៑ អកាឞ៌្ម វយំ។</para>
  <para style="p">
    <verse number="46" style="v"/>តទា និថនេល៑ កថិតវាន៑ នាសរន្នគរាត កិំ កឝ្ចិទុត្តម ឧត្បន្តុំ ឝក្នោតិ? តតះ ផិលិបោ ៜវោចត៑ ឯត្យ បឝ្យ។</para>
  <para style="p">
    <verse number="47" style="v"/>អបរញ្ច យីឝុះ ស្វស្យ សមីបំ តម៑ អាគច្ឆន្តំ ទ្ឫឞ្ដ្វា វ្យាហ្ឫតវាន៑, បឝ្យាយំ និឞ្កបដះ សត្យ ឥស្រាយេល្លោកះ។</para>
  <para style="p">
    <verse number="48" style="v"/>តតះ សោវទទ៑, ភវាន៑ មាំ កថំ ប្រត្យភិជានាតិ? យីឝុរវាទីត៑ ផិលិបស្យ អាហ្វានាត៑ បូវ៌្វំ យទា ត្វមុឌុម្ពរស្យ តរោម៌ូលេៜស្ថាស្តទា ត្វាមទឝ៌ម៑។</para>
  <para style="p">
    <verse number="49" style="v"/>និថនេល៑ អចកថត៑, ហេ គុរោ ភវាន៑ និតាន្តម៑ ឦឝ្វរស្យ បុត្រោសិ, ភវាន៑ ឥស្រាយេល្វំឝស្យ រាជា។</para>
  <para style="p">
    <verse number="50" style="v"/>តតោ យីឝុ រ្វ្យាហរត៑, ត្វាមុឌុម្ពរស្យ បាទបស្យ មូលេ ទ្ឫឞ្ដវានាហំ មមៃតស្មាទ្វាក្យាត៑ កិំ ត្វំ វ្យឝ្វសីះ? ឯតស្មាទប្យាឝ្ចយ៌្យាណិ កាយ៌្យាណិ ទ្រក្ឞ្យសិ។</para>
  <para style="p">
    <verse number="51" style="v"/>អន្យច្ចាវាទីទ៑ យុឞ្មានហំ យថាត៌្ហំ វទាមិ, ឥតះ បរំ មោចិតេ មេឃទ្វារេ តស្មាន្មនុជសូនុនា ឦឝ្វរស្យ ទូតគណម៑ អវរោហន្តមារោហន្តញ្ច ទ្រក្ឞ្យថ។</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ ត្រុតីយទិវសេ គាលីល៑ ប្រទេឝិយេ កាន្នានាម្និ នគរេ វិវាហ អាសីត៑ តត្រ ច យីឝោម៌ាតា តិឞ្ឋត៑។</para>
  <para style="p">
    <verse number="2" style="v"/>តស្មៃ វិវាហាយ យីឝុស្តស្យ ឝិឞ្យាឝ្ច និមន្ត្រិតា អាសន៑។</para>
  <para style="p">
    <verse number="3" style="v"/>តទនន្តរំ ទ្រាក្ឞារសស្យ ន្យូនត្វាទ៑ យីឝោម៌ាតា តមវទត៑ ឯតេឞាំ ទ្រាក្ឞារសោ នាស្តិ។</para>
  <para style="p">
    <verse number="4" style="v"/>តទា ស តាមវោចត៑ ហេ នារិ មយា សហ តវ កិំ កាយ៌្យំ? មម សមយ ឥទានីំ នោបតិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="5" style="v"/>តតស្តស្យ មាតា ទាសានវោចទ៑ អយំ យទ៑ វទតិ តទេវ កុរុត។</para>
  <para style="p">
    <verse number="6" style="v"/>តស្មិន៑ ស្ថានេ យិហូទីយានាំ ឝុចិត្វករណវ្យវហារានុសារេណាឍកៃកជលធរាណិ បាឞាណមយានិ ឞឌ្វ្ឫហត្បាត្រាណិអាសន៑។</para>
  <para style="p">
    <verse number="7" style="v"/>តទា យីឝុស្តាន៑ សវ៌្វកលឝាន៑ ជលៃះ បូរយិតុំ តានាជ្ញាបយត៑, តតស្តេ សវ៌្វាន៑ កុម្ភានាកណ៌ំ ជលៃះ បយ៌្យបូរយន៑។</para>
  <para style="p">
    <verse number="8" style="v"/>អថ តេភ្យះ កិញ្ចិទុត្តាយ៌្យ ភោជ្យាធិបាតេះសមីបំ នេតុំ ស តានាទិឝត៑, តេ តទនយន៑។</para>
  <para style="p">
    <verse number="9" style="v"/>អបរញ្ច តជ្ជលំ កថំ ទ្រាក្ឞារសោៜភវត៑ តជ្ជលវាហកាទាសា ជ្ញាតុំ ឝក្តាះ កិន្តុ តទ្ភោជ្យាធិបោ ជ្ញាតុំ នាឝក្នោត៑ តទវលិហ្យ វរំ សំម្ពោទ្យាវទត,</para>
  <para style="p">
    <verse number="10" style="v"/>លោកាះ ប្រថមំ ឧត្តមទ្រាក្ឞារសំ ទទតិ តឞុ យថេឞ្ដំ បិតវត្សុ តស្មា កិញ្ចិទនុត្តមញ្ច ទទតិ កិន្តុ ត្វមិទានីំ យាវត៑ ឧត្តមទ្រាក្ឞារសំ ស្ថាបយសិ។</para>
  <para style="p">
    <verse number="11" style="v"/>ឥត្ថំ យីឝុគ៌ាលីលប្រទេឝេ អាឝ្ចយ៌្យកាម៌្ម ប្រារម្ភ និជមហិមានំ ប្រាកាឝយត៑ តតះ ឝិឞ្យាស្តស្មិន៑ វ្យឝ្វសន៑។</para>
  <para style="p">
    <verse number="12" style="v"/>តតះ បរម៑ ស និជមាត្រុភ្រាត្រុស្ឝិឞ្យៃះ សាទ៌្ធ្ំ កផន៌ាហូមម៑ អាគមត៑ កិន្តុ តត្រ ពហូទិនានិ អាតិឞ្ឋត៑។</para>
  <para style="p">
    <verse number="13" style="v"/>តទនន្តរំ យិហូទិយានាំ និស្តារោត្សវេ និកដមាគតេ យីឝុ រ្យិរូឝាលម៑ នគរម៑ អាគច្ឆត៑។</para>
  <para style="p">
    <verse number="14" style="v"/>តតោ មន្ទិរស្យ មធ្យេ គោមេឞបារាវតវិក្រយិណោ វាណិជក្ឞ្ចោបវិឞ្ដាន៑ វិលោក្យ</para>
  <para style="p">
    <verse number="15" style="v"/>រជ្ជុភិះ កឝាំ និម៌្មាយ សវ៌្វគោមេឞាទិភិះ សាទ៌្ធំ តាន៑ មន្ទិរាទ៑ ទូរីក្ឫតវាន៑។</para>
  <para style="p">
    <verse number="16" style="v"/>វណិជាំ មុទ្រាទិ វិកីយ៌្យ អាសនានិ ន្យូព្ជីក្ឫត្យ បារាវតវិក្រយិភ្យោៜកថយទ៑ អស្មាត៑ ស្ថានាត៑ សវ៌ាណ្យេតានិ នយត, មម បិតុគ្ឫហំ វាណិជ្យគ្ឫហំ មា កាឞ៌្ដ។</para>
  <para style="p">
    <verse number="17" style="v"/>តស្មាត៑ តន្មន្ទិរាត៌្ហ ឧទ្យោគោ យស្តុ ស គ្រសតីវ មាម៑។ ឥមាំ ឝាស្ត្រីយលិបិំ ឝិឞ្យាះសមស្មរន៑។</para>
  <para style="p">
    <verse number="18" style="v"/>តតះ បរម៑ យិហូទីយលោកា យីឞិមវទន៑ តវមិទ្ឫឝកម៌្មករណាត៑ កិំ ចិហ្នមស្មាន៑ ទឝ៌យសិ?</para>
  <para style="p">
    <verse number="19" style="v"/>តតោ យីឝុស្តានវោចទ៑ យុឞ្មាភិរេ តស្មិន៑ មន្ទិរេ នាឝិតេ ទិនត្រយមធ្យេៜហំ តទ៑ ឧត្ថាបយិឞ្យាមិ។</para>
  <para style="p">
    <verse number="20" style="v"/>តទា យិហូទិយា វ្យាហាឞ៌ុះ, ឯតស្យ មន្ទិរស និម៌្មាណេន ឞដ្ចត្វារិំឝទ៑ វត្សរា គតាះ, ត្វំ កិំ ទិនត្រយមធ្យេ តទ៑ ឧត្ថាបយិឞ្យសិ?</para>
  <para style="p">
    <verse number="21" style="v"/>កិន្តុ ស និជទេហរូបមន្ទិរេ កថាមិមាំ កថិតវាន៑។</para>
  <para style="p">
    <verse number="22" style="v"/>ស យទេតាទ្ឫឝំ គទិតវាន៑ តច្ឆិឞ្យាះ ឝ្មឝានាត៑ តទីយោត្ថានេ សតិ ស្ម្ឫត្វា ធម៌្មគ្រន្ថេ យីឝុនោក្តកថាយាំ ច វ្យឝ្វសិឞុះ។</para>
  <para style="p">
    <verse number="23" style="v"/>អនន្តរំ និស្តារោត្សវស្យ ភោជ្យសមយេ យិរូឝាលម៑ នគរេ តត្ក្រុតាឝ្ចយ៌្យកម៌្មាណិ វិលោក្យ ពហុភិស្តស្យ នាមនិ វិឝ្វសិតំ។</para>
  <para style="p">
    <verse number="24" style="v"/>កិន្តុ ស តេឞាំ ករេឞុ ស្វំ ន សមប៌យត៑, យតះ ស សវ៌្វានវៃត៑។</para>
  <para style="p">
    <verse number="25" style="v"/>ស មានវេឞុ កស្យចិត៑ ប្រមាណំ នាបេក្ឞត យតោ មនុជានាំ មធ្យេ យទ្យទស្តិ តត្តត៑ សោជានាត៑។</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>និកទិមនាមា យិហូទីយានាម៑ អធិបតិះ ផិរូឝី ក្ឞណទាយាំ</para>
  <para style="p">
    <verse number="2" style="v"/>យីឝៅរភ្យណ៌ម៑ អាវ្រជ្យ វ្យាហាឞ៌ីត៑, ហេ គុរោ ភវាន៑ ឦឝ្វរាទ៑ អាគត៑ ឯក ឧបទេឞ្ដា, ឯតទ៑ អស្មាភិជ៌្ញាយតេ; យតោ ភវតា យាន្យាឝ្ចយ៌្យកម៌្មាណិ ក្រិយន្តេ បរមេឝ្វរស្យ សាហាយ្យំ វិនា កេនាបិ តត្តត្កម៌្មាណិ កត៌្តុំ ន ឝក្យន្តេ។</para>
  <para style="p">
    <verse number="3" style="v"/>តទា យីឝុរុត្តរំ ទត្តវាន៑ តវាហំ យថាត៌្ហតរំ វ្យាហរាមិ បុនជ៌ន្មនិ ន សតិ កោបិ មានវ ឦឝ្វរស្យ រាជ្យំ ទ្រឞ្ដុំ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="4" style="v"/>តតោ និកទីមះ ប្រត្យវោចត៑ មនុជោ វ្ឫទ្ធោ ភូត្វា កថំ ជនិឞ្យតេ? ស កិំ បុន រ្មាត្ឫជ៌ឋរំ ប្រវិឝ្យ ជនិតុំ ឝក្នោតិ?</para>
  <para style="p">
    <verse number="5" style="v"/>យីឝុរវាទីទ៑ យថាត៌្ហតរម៑ អហំ កថយាមិ មនុជេ តោយាត្មភ្យាំ បុន រ្ន ជាតេ ស ឦឝ្វរស្យ រាជ្យំ ប្រវេឞ្ដុំ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="6" style="v"/>មាំសាទ៑ យត៑ ជាយតេ តន៑ មាំសមេវ តថាត្មនោ យោ ជាយតេ ស អាត្មៃវ។</para>
  <para style="p">
    <verse number="7" style="v"/>យុឞ្មាភិះ បុន រ្ជនិតវ្យំ មមៃតស្យាំ កថាយាម៑ អាឝ្ចយ៌ំ មា មំស្ថាះ។</para>
  <para style="p">
    <verse number="8" style="v"/>សទាគតិយ៌ាំ ទិឝមិច្ឆតិ តស្យាមេវ ទិឝិ វាតិ, ត្វំ តស្យ ស្វនំ ឝុណោឞិ កិន្តុ ស កុត អាយាតិ កុត្រ យាតិ វា កិមបិ ន ជានាសិ តទ្វាទ៑ អាត្មនះ សកាឝាត៑ សវ៌្វេឞាំ មនុជានាំ ជន្ម ភវតិ។</para>
  <para style="p">
    <verse number="9" style="v"/>តទា និកទីមះ ប្ឫឞ្ដវាន៑ ឯតត៑ កថំ ភវិតុំ ឝក្នោតិ?</para>
  <para style="p">
    <verse number="10" style="v"/>យីឝុះ ប្រត្យក្តវាន៑ ត្វមិស្រាយេលោ គុរុព៌្ហូត្វាបិ កិមេតាំ កថាំ ន វេត្សិ?</para>
  <para style="p">
    <verse number="11" style="v"/>តុភ្យំ យថាត៌្ហំ កថយាមិ, វយំ យទ៑ វិទ្មស្តទ៑ វច្មះ យំច្ច បឝ្យាមស្តស្យៃវ សាក្ឞ្យំ ទទ្មះ កិន្តុ យុឞ្មាភិរស្មាកំ សាក្ឞិត្វំ ន គ្ឫហ្យតេ។</para>
  <para style="p">
    <verse number="12" style="v"/>ឯតស្យ សំសារស្យ កថាយាំ កថិតាយាំ យទិ យូយំ ន វិឝ្វសិថ តហ៌ិ ស្វគ៌ីយាយាំ កថាយាំ កថំ វិឝ្វសិឞ្យថ?</para>
  <para style="p">
    <verse number="13" style="v"/>យះ ស្វគ៌េៜស្តិ យំ ច ស្វគ៌ាទ៑ អវារោហត៑ តំ មានវតនយំ វិនា កោបិ ស្វគ៌ំ នារោហត៑។</para>
  <para style="p">
    <verse number="14" style="v"/>អបរញ្ច មូសា យថា ប្រាន្តរេ សប៌ំ ប្រោត្ថាបិតវាន៑ មនុឞ្យបុត្រោៜបិ តថៃវោត្ថាបិតវ្យះ;</para>
  <para style="p">
    <verse number="15" style="v"/>តស្មាទ៑ យះ កឝ្ចិត៑ តស្មិន៑ វិឝ្វសិឞ្យតិ សោៜវិនាឝ្យះ សន៑ អនន្តាយុះ ប្រាប្ស្យតិ។</para>
  <para style="p">
    <verse number="16" style="v"/>ឦឝ្វរ ឥត្ថំ ជគទទយត យត៑ ស្វមទ្វិតីយំ តនយំ ប្រាទទាត៑ តតោ យះ កឝ្ចិត៑ តស្មិន៑ វិឝ្វសិឞ្យតិ សោៜវិនាឝ្យះ សន៑ អនន្តាយុះ ប្រាប្ស្យតិ។</para>
  <para style="p">
    <verse number="17" style="v"/>ឦឝ្វរោ ជគតោ លោកាន៑ ទណ្ឌយិតុំ ស្វបុត្រំ ន ប្រេឞ្យ តាន៑ បរិត្រាតុំ ប្រេឞិតវាន៑។</para>
  <para style="p">
    <verse number="18" style="v"/>អតឯវ យះ កឝ្ចិត៑ តស្មិន៑ វិឝ្វសិតិ ស ទណ្ឌាហ៌ោ ន ភវតិ កិន្តុ យះ កឝ្ចិត៑ តស្មិន៑ ន វិឝ្វសិតិ ស ឥទានីមេវ ទណ្ឌាហ៌ោ ភវតិ,យតះ ស ឦឝ្វរស្យាទ្វិតីយបុត្រស្យ នាមនិ ប្រត្យយំ ន ករោតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>ជគតោ មធ្យេ ជ្យោតិះ ប្រាកាឝត កិន្តុ មនុឞ្យាណាំ កម៌្មណាំ ទ្ឫឞ្ដត្វាត៑ តេ ជ្យោតិឞោបិ តិមិរេ ប្រីយន្តេ ឯតទេវ ទណ្ឌស្យ ការណាំ ភវតិ។</para>
  <para style="p">
    <verse number="20" style="v"/>យះ កុកម៌្ម ករោតិ តស្យាចារស្យ ទ្ឫឞ្ដត្វាត៑ ស ជ្យោតិរ្ឬតីយិត្វា តន្និកដំ នាយាតិ;</para>
  <para style="p">
    <verse number="21" style="v"/>កិន្តុ យះ សត្កម៌្ម ករោតិ តស្យ សវ៌្វាណិ កម៌្មាណីឝ្វរេណ ក្ឫតានីតិ សថា ប្រកាឝតេ តទភិប្រាយេណ ស ជ្យោតិឞះ សន្និធិម៑ អាយាតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>តតះ បរម៑ យីឝុះ ឝិឞ្យៃះ សាទ៌្ធំ យិហូទីយទេឝំ គត្វា តត្រ ស្ថិត្វា មជ្ជយិតុម៑ អារភត។</para>
  <para style="p">
    <verse number="23" style="v"/>តទា ឝាលម៑ នគរស្យ សមីបស្ថាយិនិ ឰនន៑ គ្រាមេ ពហុតរតោយស្ថិតេស្តត្រ យោហន៑ អមជ្ជយត៑ តថា ច លោកា អាគត្យ តេន មជ្ជិតា អភវន៑។</para>
  <para style="p">
    <verse number="24" style="v"/>តទា យោហន៑ ការាយាំ ន ពទ្ធះ។</para>
  <para style="p">
    <verse number="25" style="v"/>អបរញ្ច ឝាចកម៌្មណិ យោហានះ ឝិឞ្យៃះ សហ យិហូទីយលោកានាំ វិវាទេ ជាតេ, តេ យោហនះ សំន្និធិំ គត្វាកថយន៑,</para>
  <para style="p">
    <verse number="26" style="v"/>ហេ គុរោ យទ៌្ទននទ្យាះ បារេ ភវតា សាទ៌្ធំ យ អាសីត៑ យស្មិំឝ្ច ភវាន៑ សាក្ឞ្យំ ប្រទទាត៑ បឝ្យតុ សោបិ មជ្ជយតិ សវ៌្វេ តស្យ សមីបំ យាន្តិ ច។</para>
  <para style="p">
    <verse number="27" style="v"/>តទា យោហន៑ ប្រត្យវោចទ៑ ឦឝ្វរេណ ន ទត្តេ កោបិ មនុជះ កិមបិ ប្រាប្តុំ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="28" style="v"/>អហំ អភិឞិក្តោ ន ភវាមិ កិន្តុ តទគ្រេ ប្រេឞិតោស្មិ យាមិមាំ កថាំ កថិតវានាហំ តត្រ យូយំ សវ៌្វេ សាក្ឞិណះ ស្ថ។</para>
  <para style="p">
    <verse number="29" style="v"/>យោ ជនះ កន្យាំ លភតេ ស ឯវ វរះ កិន្តុ វរស្យ សន្និធៅ ទណ្ឌាយមានំ តស្យ យន្មិត្រំ តេន វរស្យ ឝព្ទេ ឝ្រុតេៜតីវាហ្លាទ្យតេ មមាបិ តទ្វទ៑ អានន្ទសិទ្ធិជ៌ាតា។</para>
  <para style="p">
    <verse number="30" style="v"/>តេន ក្រមឝោ វទ៌្ធិតវ្យំ កិន្តុ មយា ហ្សិតវ្យំ។</para>
  <para style="p">
    <verse number="31" style="v"/>យ ឩទ៌្ហ្វាទាគច្ឆត៑ ស សវ៌្វេឞាំ មុខ្យោ យឝ្ច សំសារាទ៑ ឧទបទ្យត ស សាំសារិកះ សំសារីយាំ កថាញ្ច កថយតិ យស្តុ ស្វគ៌ាទាគច្ឆត៑ ស សវ៌្វេឞាំ មុខ្យះ។</para>
  <para style="p">
    <verse number="32" style="v"/>ស យទបឝ្យទឝ្ឫណោច្ច តស្មិន្នេវ សាក្ឞ្យំ ទទាតិ តថាបិ ប្រាយឝះ កឝ្ចិត៑ តស្យ សាក្ឞ្យំ ន គ្ឫហ្លាតិ;</para>
  <para style="p">
    <verse number="33" style="v"/>កិន្តុ យោ គ្ឫហ្លាតិ ស ឦឝ្វរស្យ សត្យវាទិត្វំ មុទ្រាង្គិតំ ករោតិ។</para>
  <para style="p">
    <verse number="34" style="v"/>ឦឝ្វរេណ យះ ប្រេរិតះ សឯវ ឦឝ្វរីយកថាំ កថយតិ យត ឦឝ្វរ អាត្មានំ តស្មៃ អបរិមិតម៑ អទទាត៑។</para>
  <para style="p">
    <verse number="35" style="v"/>បិតា បុត្រេ ស្នេហំ ក្ឫត្វា តស្យ ហស្តេ សវ៌្វាណិ សមប៌ិតវាន៑។</para>
  <para style="p">
    <verse number="36" style="v"/>យះ កឝ្ចិត៑ បុត្រេ វិឝ្វសិតិ ស ឯវានន្តម៑ បរមាយុះ ប្រាប្នោតិ កិន្តុ យះ កឝ្ចិត៑ បុត្រេ ន វិឝ្វសិតិ ស បរមាយុឞោ ទឝ៌នំ ន ប្រាប្នោតិ កិន្ត្វីឝ្វរស្យ កោបភាជនំ ភូត្វា តិឞ្ឋតិ។</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យីឝុះ ស្វយំ នាមជ្ជយត៑ កេវលំ តស្យ ឝិឞ្យា អមជ្ជយត៑ កិន្តុ យោហនោៜធិកឝិឞ្យាន៑ ស ករោតិ មជ្ជយតិ ច,</para>
  <para style="p">
    <verse number="2" style="v"/>ផិរូឝិន ឥមាំ វាត៌្តាមឝ្ឫណ្វន៑ ឥតិ ប្រភុរវគត្យ</para>
  <para style="p">
    <verse number="3" style="v"/>យិហូទីយទេឝំ វិហាយ បុន រ្គាលីលម៑ អាគត៑។</para>
  <para style="p">
    <verse number="4" style="v"/>តតះ ឝោមិរោណប្រទេឝស្យ មទ្យេន តេន គន្តវ្យេ សតិ</para>
  <para style="p">
    <verse number="5" style="v"/>យាកូព៑ និជបុត្រាយ យូឞផេ យាំ ភូមិម៑ អទទាត៑ តត្សមីបស្ថាយិ ឝោមិរោណប្រទេឝស្យ សុខារ៑ នាម្នា វិខ្យាតស្យ នគរស្យ សន្និធាវុបាស្ថាត៑។</para>
  <para style="p">
    <verse number="6" style="v"/>តត្រ យាកូពះ ប្រហិរាសីត៑; តទា ទ្វិតីយយាមវេលាយាំ ជាតាយាំ ស មាគ៌េ ឝ្រមាបន្នស្តស្យ ប្រហេះ បាឝ៌្វេ ឧបាវិឝត៑។</para>
  <para style="p">
    <verse number="7" style="v"/>ឯតហ៌ិ កាចិត៑ ឝោមិរោណីយា យោឞិត៑ តោយោត្តោលនាត៌្ហម៑ តត្រាគមត្</para>
  <para style="p">
    <verse number="8" style="v"/>តទា ឝិឞ្យាះ ខាទ្យទ្រវ្យាណិ ក្រេតុំ នគរម៑ អគច្ឆន៑។</para>
  <para style="p">
    <verse number="9" style="v"/>យីឝុះ ឝោមិរោណីយាំ តាំ យោឞិតម៑ វ្យាហាឞ៌ីត៑ មហ្យំ កិញ្ចិត៑ បានីយំ បាតុំ ទេហិ។ កិន្តុ ឝោមិរោណីយៃះ សាកំ យិហូទីយលោកា ន វ្យវាហរន៑ តស្មាទ្ធេតោះ សាកថយត៑ ឝោមិរោណីយា យោឞិតទហំ ត្វំ យិហូទីយោសិ កថំ មត្តះ បានីយំ បាតុម៑ ឥច្ឆសិ?</para>
  <para style="p">
    <verse number="10" style="v"/>តតោ យីឝុរវទទ៑ ឦឝ្វរស្យ យទ្ទានំ តត្កីទ្ឫក៑ បានីយំ បាតុំ មហ្យំ ទេហិ យ ឥត្ថំ ត្វាំ យាចតេ ស វា ក ឥតិ ចេទជ្ញាស្យថាស្តហ៌ិ តមយាចិឞ្យថាះ ស ច តុភ្យមម្ឫតំ តោយមទាស្យត៑។</para>
  <para style="p">
    <verse number="11" style="v"/>តទា សា សីមន្តិនី ភាឞិតវតិ, ហេ មហេច្ឆ ប្រហិគ៌ម្ភីរោ ភវតោ នីរោត្តោលនបាត្រំ នាស្តី ច តស្មាត៑ តទម្ឫតំ កីលាលំ កុតះ ប្រាប្ស្យសិ?</para>
  <para style="p">
    <verse number="12" style="v"/>យោស្មភ្យម៑ ឥមមន្ធូំ ទទៅ, យស្យ ច បរិជនា គោមេឞាទយឝ្ច សវ៌្វេៜស្យ ប្រហេះ បានីយំ បបុរេតាទ្ឫឝោ យោស្មាកំ បូវ៌្វបុរុឞោ យាកូព៑ តស្មាទបិ ភវាន៑ មហាន៑ កិំ?</para>
  <para style="p">
    <verse number="13" style="v"/>តតោ យីឝុរកថយទ៑ ឥទំ បានីយំ សះ បិវតិ ស បុនស្ត្ឫឞាត៌្តោ ភវិឞ្យតិ,</para>
  <para style="p">
    <verse number="14" style="v"/>កិន្តុ មយា ទត្តំ បានីយំ យះ បិវតិ ស បុនះ កទាបិ ត្ឫឞាត៌្តោ ន ភវិឞ្យតិ។ មយា ទត្តម៑ ឥទំ តោយំ តស្យាន្តះ ប្រស្រវណរូបំ ភូត្វា អនន្តាយុយ៌ាវត៑ ស្រោឞ្យតិ។</para>
  <para style="p">
    <verse number="15" style="v"/>តទា សា វនិតាកថយត៑ ហេ មហេច្ឆ តហ៌ិ មម បុនះ បីបាសា យថា ន ជាយតេ តោយោត្តោលនាយ យថាត្រាគមនំ ន ភវតិ ច តទត៌្ហំ មហ្យំ តត្តោយំ ទេហី។</para>
  <para style="p">
    <verse number="16" style="v"/>តតោ យីឝូរវទទ្យាហិ តវ បតិមាហូយ ស្ថានេៜត្រាគច្ឆ។</para>
  <para style="p">
    <verse number="17" style="v"/>សា វាមាវទត៑ មម បតិន៌ាស្តិ។ យីឝុរវទត៑ មម បតិន៌ាស្តីតិ វាក្យំ ភទ្រមវោចះ។</para>
  <para style="p">
    <verse number="18" style="v"/>យតស្តវ បញ្ច បតយោភវន៑ អធុនា តុ ត្វយា សាទ៌្ធំ យស្តិឞ្ឋតិ ស តវ ភត៌្តា ន វាក្យមិទំ សត្យមវាទិះ។</para>
  <para style="p">
    <verse number="19" style="v"/>តទា សា មហិលា គទិតវតិ ហេ មហេច្ឆ ភវាន៑ ឯកោ ភវិឞ្យទ្វាទីតិ ពុទ្ធំ មយា។</para>
  <para style="p">
    <verse number="20" style="v"/>អស្មាកំ បិត្ឫលោកា ឯតស្មិន៑ ឝិលោច្ចយេៜភជន្ត, កិន្តុ ភវទ្ភិរុច្យតេ យិរូឝាលម៑ នគរេ ភជនយោគ្យំ ស្ថានមាស្តេ។</para>
  <para style="p">
    <verse number="21" style="v"/>យីឝុរវោចត៑ ហេ យោឞិត៑ មម វាក្យេ វិឝ្វសិហិ យទា យូយំ កេវលឝៃលេៜស្មិន៑ វា យិរូឝាលម៑ នគរេ បិតុព៌្ហជនំ ន ករិឞ្យធ្វេ កាល ឯតាទ្ឫឝ អាយាតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>យូយំ យំ ភជធ្វេ តំ ន ជានីថ, កិន្តុ វយំ យំ ភជាមហេ តំ ជានីមហេ, យតោ យិហូទីយលោកានាំ មធ្យាត៑ បរិត្រាណំ ជាយតេ។</para>
  <para style="p">
    <verse number="23" style="v"/>កិន្តុ យទា សត្យភក្តា អាត្មនា សត្យរូបេណ ច បិតុព៌្ហជនំ ករិឞ្យន្តេ សមយ ឯតាទ្ឫឝ អាយាតិ, វរម៑ ឥទានីមបិ វិទ្យតេ ; យត ឯតាទ្ឫឝោ ភត្កាន៑ បិតា ចេឞ្ដតេ។</para>
  <para style="p">
    <verse number="24" style="v"/>ឦឝ្វរ អាត្មា; តតស្តស្យ យេ ភក្តាស្តៃះ ស អាត្មនា សត្យរូបេណ ច ភជនីយះ។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា សា មហិលាវាទីត៑ ខ្រីឞ្ដនាម្នា វិខ្យាតោៜភិឞិក្តះ បុរុឞ អាគមិឞ្យតីតិ ជានាមិ ស ច សវ៌្វាះ កថា អស្មាន៑ ជ្ញាបយិឞ្យតិ។</para>
  <para style="p">
    <verse number="26" style="v"/>តតោ យីឝុរវទត៑ ត្វយា សាទ៌្ធំ កថនំ ករោមិ យោៜហម៑ អហមេវ ស បុរុឞះ។</para>
  <para style="p">
    <verse number="27" style="v"/>ឯតស្មិន៑ សមយេ ឝិឞ្យា អាគត្យ តថា ស្ត្រិយា សាទ៌្ធំ តស្យ កថោបកថនេ មហាឝ្ចយ៌្យម៑ អមន្យន្ត តថាបិ ភវាន៑ កិមិច្ឆតិ? យទ្វា កិមត៌្ហម៑ ឯតយា សាទ៌្ធំ កថាំ កថយតិ? ឥតិ កោបិ នាប្ឫច្ឆត៑។</para>
  <para style="p">
    <verse number="28" style="v"/>តតះ បរំ សា នារី កលឝំ ស្ថាបយិត្វា នគរមធ្យំ គត្វា លោកេភ្យោកថាយទ្</para>
  <para style="p">
    <verse number="29" style="v"/>អហំ យទ្យត៑ កម៌្មាករវំ តត្សវ៌្វំ មហ្យមកថយទ៑ ឯតាទ្ឫឝំ មានវមេកម៑ អាគត្យ បឝ្យត រុ កិម៑ អភិឞិក្តោ ន ភវតិ ?</para>
  <para style="p">
    <verse number="30" style="v"/>តតស្តេ នគរាទ៑ ពហិរាគត្យ តាតស្យ សមីបម៑ អាយន៑។</para>
  <para style="p">
    <verse number="31" style="v"/>ឯតហ៌ិ ឝិឞ្យាះ សាធយិត្វា តំ វ្យាហាឞ៌ុះ ហេ គុរោ ភវាន៑ កិញ្ចិទ៑ ភូក្តាំ។</para>
  <para style="p">
    <verse number="32" style="v"/>តតះ សោវទទ៑ យុឞ្មាភិយ៌ន្ន ជ្ញាយតេ តាទ្ឫឝំ ភក្ឞ្យំ មមាស្តេ។</para>
  <para style="p">
    <verse number="33" style="v"/>តទា ឝិឞ្យាះ បរស្បរំ ប្រឞ្ដុម៑ អារម្ភន្ត, កិមស្មៃ កោបិ កិមបិ ភក្ឞ្យមានីយ ទត្តវាន៑?</para>
  <para style="p">
    <verse number="34" style="v"/>យីឝុរវោចត៑ មត្ប្រេរកស្យាភិមតានុរូបករណំ តស្យៃវ កម៌្មសិទ្ធិការណញ្ច មម ភក្ឞ្យំ។</para>
  <para style="p">
    <verse number="35" style="v"/>មាសចតុឞ្ដយេ ជាតេ ឝស្យកត៌្តនសមយោ ភវិឞ្យតីតិ វាក្យំ យុឞ្មាភិះ កិំ នោទ្យតេ? កិន្ត្វហំ វទាមិ, ឝិរ ឧត្តោល្យ ក្ឞេត្រាណិ ប្រតិ និរីក្ឞ្យ បឝ្យត, ឥទានីំ កត៌្តនយោគ្យានិ ឝុក្លវណ៌ាន្យភវន៑។</para>
  <para style="p">
    <verse number="36" style="v"/>យឝ្ឆិនត្តិ ស វេតនំ លភតេ អនន្តាយុះស្វរូបំ ឝស្យំ ស គ្ឫហ្លាតិ ច, តេនៃវ វប្តា ឆេត្តា ច យុគបទ៑ អានន្ទតះ។</para>
  <para style="p">
    <verse number="37" style="v"/>ឥត្ថំ សតិ វបត្យេកឝ្ឆិនត្យន្យ ឥតិ វចនំ សិទ្ធ្យតិ។</para>
  <para style="p">
    <verse number="38" style="v"/>យត្រ យូយំ ន បយ៌្យឝ្រាម្យត តាទ្ឫឝំ ឝស្យំ ឆេត្តុំ យុឞ្មាន៑ ប្រៃរយម៑ អន្យេ ជនាះបយ៌្យឝ្រាម្យន៑ យូយំ តេឞាំ ឝ្រគស្យ ផលម៑ អលភធ្វម៑។</para>
  <para style="p">
    <verse number="39" style="v"/>យស្មិន៑ កាលេ យទ្យត៑ កម៌្មាកាឞ៌ំ តត្សវ៌្វំ ស មហ្យម៑ អកថយត៑ តស្យា វនិតាយា ឥទំ សាក្ឞ្យវាក្យំ ឝ្រុត្វា តន្នគរនិវាសិនោ ពហវះ ឝោមិរោណីយលោកា វ្យឝ្វសន៑។</para>
  <para style="p">
    <verse number="40" style="v"/>តថា ច តស្យាន្តិកេ សមុបស្ថាយ ស្វេឞាំ សន្និធៅ កតិចិទ៑ ទិនានិ ស្ថាតុំ តស្មិន៑ វិនយម៑ អកុវ៌្វាន តស្មាត៑ ស ទិនទ្វយំ តត្ស្ថានេ ន្យវឞ្ដត្</para>
  <para style="p">
    <verse number="41" style="v"/>តតស្តស្យោបទេឝេន ពហវោៜបរេ វិឝ្វស្យ</para>
  <para style="p">
    <verse number="42" style="v"/>តាំ យោឞាមវទន៑ កេវលំ តវ វាក្យេន ប្រតីម ឥតិ ន, កិន្តុ ស ជគតោៜភិឞិក្តស្ត្រាតេតិ តស្យ កថាំ ឝ្រុត្វា វយំ ស្វយមេវាជ្ញាសមហិ។</para>
  <para style="p">
    <verse number="43" style="v"/>ស្វទេឝេ ភវិឞ្យទ្វក្តុះ សត្ការោ នាស្តីតិ យទ្យបិ យីឝុះ ប្រមាណំ ទត្វាកថយត្</para>
  <para style="p">
    <verse number="44" style="v"/>តថាបិ ទិវសទ្វយាត៑ បរំ ស តស្មាត៑ ស្ថានាទ៑ គាលីលំ គតវាន៑។</para>
  <para style="p">
    <verse number="45" style="v"/>អនន្តរំ យេ គាលីលី លិយលោកា ឧត្សវេ គតា ឧត្សវសមយេ យិរូឝលម៑ នគរេ តស្យ សវ៌្វាះ ក្រិយា អបឝ្យន៑ តេ គាលីលម៑ អាគតំ តម៑ អាគ្ឫហ្លន៑។</para>
  <para style="p">
    <verse number="46" style="v"/>តតះ បរម៑ យីឝុ រ្យស្មិន៑ កាន្នានគរេ ជលំ ទ្រាក្ឞារសម៑ អាករោត៑ តត៑ ស្ថានំ បុនរគាត៑។ តស្មិន្នេវ សមយេ កស្យចិទ៑ រាជសភាស្តារស្យ បុត្រះ កផន៌ាហូមបុរី រោគគ្រស្ត អាសីត៑។</para>
  <para style="p">
    <verse number="47" style="v"/>ស យេហូទីយទេឝាទ៑ យីឝោ រ្គាលីលាគមនវាត៌្តាំ និឝម្យ តស្យ សមីបំ គត្វា ប្រាត៌្ហ្យ វ្យាហ្ឫតវាន៑ មម បុត្រស្យ ប្រាយេណ កាល អាសន្នះ ភវាន៑ អាគត្យ តំ ស្វស្ថំ ករោតុ។</para>
  <para style="p">
    <verse number="48" style="v"/>តទា យីឝុរកថយទ៑ អាឝ្ចយ៌្យំ កម៌្ម ចិត្រំ ចិហ្នំ ច ន ទ្ឫឞ្ដា យូយំ ន ប្រត្យេឞ្យថ។</para>
  <para style="p">
    <verse number="49" style="v"/>តតះ ស សភាសទវទត៑ ហេ មហេច្ឆ មម បុត្រេ ន ម្ឫតេ ភវានាគច្ឆតុ។</para>
  <para style="p">
    <verse number="50" style="v"/>យីឝុស្តមវទទ៑ គច្ឆ តវ បុត្រោៜជីវីត៑ តទា យីឝុនោក្តវាក្យេ ស វិឝ្វស្យ គតវាន៑។</para>
  <para style="p">
    <verse number="51" style="v"/>គមនកាលេ មាគ៌មធ្យេ ទាសាស្តំ សាក្ឞាត្ប្រាប្យាវទន៑ ភវតះ បុត្រោៜជីវីត៑។</para>
  <para style="p">
    <verse number="52" style="v"/>តតះ កំ កាលមារភ្យ រោគប្រតីការារម្ភោ ជាតា ឥតិ ប្ឫឞ្ដេ តៃរុក្តំ ហ្យះ សាទ៌្ធទណ្ឌទ្វយាធិកទ្វិតីយយាមេ តស្យ ជ្វរត្យាគោៜភវត៑។</para>
  <para style="p">
    <verse number="53" style="v"/>តទា យីឝុស្តស្មិន៑ ក្ឞណេ ប្រោក្តវាន៑ តវ បុត្រោៜជីវីត៑ បិតា តទ្ពុទ្ធ្វា សបរិវារោ វ្យឝ្វសីត៑។</para>
  <para style="p">
    <verse number="54" style="v"/>យិហូទីយទេឝាទ៑ អាគត្យ គាលីលិ យីឝុរេតទ៑ ទ្វិតីយម៑ អាឝ្ចយ៌្យកម៌្មាករោត៑។</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តតះ បរំ យិហូទីយានាម៑ ឧត្សវ ឧបស្ថិតេ យីឝុ រ្យិរូឝាលមំ គតវាន៑។</para>
  <para style="p">
    <verse number="2" style="v"/>តស្មិន្នគរេ មេឞនាម្នោ ទ្វារស្យ សមីបេ ឥព្រីយភាឞយា ពៃថេស្ទា នាម្នា បិឞ្ករិណី បញ្ចឃដ្ដយុក្តាសីត៑។</para>
  <para style="p">
    <verse number="3" style="v"/>តស្យាស្តេឞុ ឃដ្ដេឞុ កិលាលកម្បនម៑ អបេក្ឞ្យ អន្ធខញ្ចឝុឞ្កាង្គាទយោ ពហវោ រោគិណះ បតន្តស្តិឞ្ឋន្តិ ស្ម។</para>
  <para style="p">
    <verse number="4" style="v"/>យតោ វិឝេឞកាលេ តស្យ សរសោ វារិ ស្វគ៌ីយទូត ឯត្យាកម្បយត៑ តត្កីលាលកម្បនាត៑ បរំ យះ កឝ្ចិទ៑ រោគី ប្រថមំ បានីយមវារោហត៑ ស ឯវ តត្ក្ឞណាទ៑ រោគមុក្តោៜភវត៑។</para>
  <para style="p">
    <verse number="5" style="v"/>តទាឞ្ដាត្រិំឝទ្វឞ៌ាណិ យាវទ៑ រោគគ្រស្ត ឯកជនស្តស្មិន៑ ស្ថានេ ស្ថិតវាន៑។</para>
  <para style="p">
    <verse number="6" style="v"/>យីឝុស្តំ ឝយិតំ ទ្ឫឞ្ដ្វា ពហុកាលិករោគីតិ ជ្ញាត្វា វ្យាហ្ឫតវាន៑ ត្វំ កិំ ស្វស្ថោ ពុភូឞសិ?</para>
  <para style="p">
    <verse number="7" style="v"/>តតោ រោគី កថិតវាន៑ ហេ មហេច្ឆ យទា កីលាលំ កម្បតេ តទា មាំ បុឞ្ករិណីម៑ អវរោហយិតុំ មម កោបិ នាស្តិ, តស្មាន៑ មម គមនកាលេ កឝ្ចិទន្យោៜគ្រោ គត្វា អវរោហតិ។</para>
  <para style="p">
    <verse number="8" style="v"/>តទា យីឝុរកថយទ៑ ឧត្តិឞ្ឋ, តវ ឝយ្យាមុត្តោល្យ គ្ឫហីត្វា យាហិ។</para>
  <para style="p">
    <verse number="9" style="v"/>ស តត្ក្ឞណាត៑ ស្វស្ថោ ភូត្វា ឝយ្យាមុត្តោល្យាទាយ គតវាន៑ កិន្តុ តទ្ទិនំ វិឝ្រាមវារះ។</para>
  <para style="p">
    <verse number="10" style="v"/>តស្មាទ៑ យិហូទីយាះ ស្វស្ថំ នរំ វ្យាហរន៑ អទ្យ វិឝ្រាមវារេ ឝយនីយមាទាយ ន យាតវ្យម៑។</para>
  <para style="p">
    <verse number="11" style="v"/>តតះ ស ប្រត្យវោចទ៑ យោ មាំ ស្វស្ថម៑ អកាឞ៌ីត៑ ឝយនីយម៑ ឧត្តោល្យាទាយ យាតុំ មាំ ស ឯវាទិឝត៑។</para>
  <para style="p">
    <verse number="12" style="v"/>តទា តេៜប្ឫច្ឆន៑ ឝយនីយម៑ ឧត្តោល្យាទាយ យាតុំ យ អាជ្ញាបយត៑ ស កះ?</para>
  <para style="p">
    <verse number="13" style="v"/>កិន្តុ ស ក ឥតិ ស្វស្ថីភូតោ នាជានាទ៑ យតស្តស្មិន៑ ស្ថានេ ជនតាសត្ត្វាទ៑ យីឝុះ ស្ថានាន្តរម៑ អាគមត៑។</para>
  <para style="p">
    <verse number="14" style="v"/>តតះ បរំ យេឝុ រ្មន្ទិរេ តំ នរំ សាក្ឞាត្ប្រាប្យាកថយត៑ បឝ្យេទានីម៑ អនាមយោ ជាតោសិ យថាធិកា ទុទ៌ឝា ន ឃដតេ តទ្ធេតោះ បាបំ កម៌្ម បុនម៌ាកាឞ៌ីះ។</para>
  <para style="p">
    <verse number="15" style="v"/>តតះ ស គត្វា យិហូទីយាន៑ អវទទ៑ យីឝុ រ្មាម៑ អរោគិណម៑ អកាឞ៌ីត៑។</para>
  <para style="p">
    <verse number="16" style="v"/>តតោ យីឝុ រ្វិឝ្រាមវារេ កម៌្មេទ្ឫឝំ ក្ឫតវាន៑ ឥតិ ហេតោ រ្យិហូទីយាស្តំ តាឌយិត្វា ហន្តុម៑ អចេឞ្ដន្ត។</para>
  <para style="p">
    <verse number="17" style="v"/>យីឝុស្តានាខ្យត៑ មម បិតា យត៑ កាយ៌្យំ ករោតិ តទនុរូបម៑ អហមបិ ករោតិ។</para>
  <para style="p">
    <verse number="18" style="v"/>តតោ យិហូទីយាស្តំ ហន្តុំ បុនរយតន្ត យតោ វិឝ្រាមវារំ នាមន្យត តទេវ កេវលំ ន អធិកន្តុ ឦឝ្វរំ ស្វបិតរំ ប្រោច្យ ស្វមបីឝ្វរតុល្យំ ក្ឫតវាន៑។</para>
  <para style="p">
    <verse number="19" style="v"/>បឝ្ចាទ៑ យីឝុរវទទ៑ យុឞ្មានហំ យថាត៌្ហតរំ វទាមិ បុត្រះ បិតរំ យទ្យត៑ កម៌្ម កុវ៌្វន្តំ បឝ្យតិ តទតិរិក្តំ ស្វេច្ឆាតះ កិមបិ កម៌្ម កត៌្តុំ ន ឝក្នោតិ។ បិតា យត៑ ករោតិ បុត្រោបិ តទេវ ករោតិ។</para>
  <para style="p">
    <verse number="20" style="v"/>បិតា បុត្រេ ស្នេហំ ករោតិ តស្មាត៑ ស្វយំ យទ្យត៑ កម៌្ម ករោតិ តត្សវ៌្វំ បុត្រំ ទឝ៌យតិ ; យថា ច យុឞ្មាកំ អាឝ្ចយ៌្យជ្ញានំ ជនិឞ្យតេ តទត៌្ហម៑ ឥតោបិ មហាកម៌្ម តំ ទឝ៌យិឞ្យតិ។</para>
  <para style="p">
    <verse number="21" style="v"/>វស្តុតស្តុ បិតា យថា ប្រមិតាន៑ ឧត្ថាប្យ សជិវាន៑ ករោតិ តទ្វត៑ បុត្រោបិ យំ យំ ឥច្ឆតិ តំ តំ សជីវំ ករោតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>សវ៌្វេ បិតរំ យថា សត្កុវ៌្វន្តិ តថា បុត្រមបិ សត្ការយិតុំ បិតា ស្វយំ កស្យាបិ វិចារមក្ឫត្វា សវ៌្វវិចារាណាំ ភារំ បុត្រេ សមប៌ិតវាន៑។</para>
  <para style="p">
    <verse number="23" style="v"/>យះ បុត្រំ សត៑ ករោតិ ស តស្យ ប្រេរកមបិ សត៑ ករោតិ។</para>
  <para style="p">
    <verse number="24" style="v"/>យុឞ្មានាហំ យថាត៌្ហតរំ វទាមិ យោ ជនោ មម វាក្យំ ឝ្រុត្វា មត្ប្រេរកេ វិឝ្វសិតិ សោនន្តាយុះ ប្រាប្នោតិ កទាបិ ទណ្ឌពាជនំ ន ភវតិ និធនាទុត្ថាយ បរមាយុះ ប្រាប្នោតិ។</para>
  <para style="p">
    <verse number="25" style="v"/>អហំ យុឞ្មានតិយថាត៌្ហំ វទាមិ យទា ម្ឫតា ឦឝ្វរបុត្រស្យ និនាទំ ឝ្រោឞ្យន្តិ យេ ច ឝ្រោឞ្យន្តិ តេ សជីវា ភវិឞ្យន្តិ សមយ ឯតាទ្ឫឝ អាយាតិ វរម៑ ឥទានីមប្យុបតិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="26" style="v"/>បិតា យថា ស្វយញ្ជីវី តថា បុត្រាយ ស្វយញ្ជីវិត្វាធិការំ ទត្តវាន៑។</para>
  <para style="p">
    <verse number="27" style="v"/>ស មនុឞ្យបុត្រះ ឯតស្មាត៑ ការណាត៑ បិតា ទណ្ឌករណាធិការមបិ តស្មិន៑ សមប៌ិតវាន៑។</para>
  <para style="p">
    <verse number="28" style="v"/>ឯតទត៌្ហេ យូយម៑ អាឝ្ចយ៌្យំ ន មន្យធ្វំ យតោ យស្មិន៑ សមយេ តស្យ និនាទំ ឝ្រុត្វា ឝ្មឝានស្ថាះ សវ៌្វេ ពហិរាគមិឞ្យន្តិ សមយ ឯតាទ្ឫឝ ឧបស្ថាស្យតិ។</para>
  <para style="p">
    <verse number="29" style="v"/>តស្មាទ៑ យេ សត្កម៌្មាណិ ក្ឫតវន្តស្ត ឧត្ថាយ អាយុះ ប្រាប្ស្យន្តិ យេ ច កុកម៌ាណិ ក្ឫតវន្តស្ត ឧត្ថាយ ទណ្ឌំ ប្រាប្ស្យន្តិ។</para>
  <para style="p">
    <verse number="30" style="v"/>អហំ ស្វយំ កិមបិ កត៌្តុំ ន ឝក្នោមិ យថា ឝុណោមិ តថា វិចារយាមិ មម វិចារញ្ច ន្យាយ្យះ យតោហំ ស្វីយាភីឞ្ដំ នេហិត្វា មត្ប្រេរយិតុះ បិតុរិឞ្ដម៑ ឦហេ។</para>
  <para style="p">
    <verse number="31" style="v"/>យទិ ស្វស្មិន៑ ស្វយំ សាក្ឞ្យំ ទទាមិ តហ៌ិ តត្សាក្ឞ្យម៑ អាគ្រាហ្យំ ភវតិ ;</para>
  <para style="p">
    <verse number="32" style="v"/>កិន្តុ មទត៌្ហេៜបរោ ជនះ សាក្ឞ្យំ ទទាតិ មទត៌្ហេ តស្យ យត៑ សាក្ឞ្យំ តត៑ សត្យម៑ ឯតទប្យហំ ជានាមិ។</para>
  <para style="p">
    <verse number="33" style="v"/>យុឞ្មាភិ រ្យោហនំ ប្រតិ លោកេឞុ ប្រេរិតេឞុ ស សត្យកថាយាំ សាក្ឞ្យមទទាត៑។</para>
  <para style="p">
    <verse number="34" style="v"/>មានុឞាទហំ សាក្ឞ្យំ នោបេក្ឞេ តថាបិ យូយំ យថា បរិត្រយធ្វេ តទត៌្ហម៑ ឥទំ វាក្យំ វទាមិ។</para>
  <para style="p">
    <verse number="35" style="v"/>យោហន៑ ទេទីប្យមានោ ទីប ឥវ តេជស្វី ស្ថិតវាន៑ យូយម៑ អល្បកាលំ តស្យ ទីប្ត្យានន្ទិតុំ សមមន្យធ្វំ។</para>
  <para style="p">
    <verse number="36" style="v"/>កិន្តុ តត្ប្រមាណាទបិ មម គុរុតរំ ប្រមាណំ វិទ្យតេ បិតា មាំ ប្រេឞ្យ យទ្យត៑ កម៌្ម សមាបយិតុំ ឝក្ត្តិមទទាត៑ មយា ក្ឫតំ តត្តត៑ កម៌្ម មទត៌្ហេ ប្រមាណំ ទទាតិ។</para>
  <para style="p">
    <verse number="37" style="v"/>យះ បិតា មាំ ប្រេរិតវាន៑ មោបិ មទត៌្ហេ ប្រមាណំ ទទាតិ។ តស្យ វាក្យំ យុឞ្មាភិះ កទាបិ ន ឝ្រុតំ តស្យ រូបញ្ច ន ទ្ឫឞ្ដំ</para>
  <para style="p">
    <verse number="38" style="v"/>តស្យ វាក្យញ្ច យុឞ្មាកម៑ អន្តះ កទាបិ ស្ថានំ នាប្នោតិ យតះ ស យំ ប្រេឞិតវាន៑ យូយំ តស្មិន៑ ន វិឝ្វសិថ។</para>
  <para style="p">
    <verse number="39" style="v"/>ធម៌្មបុស្តកានិ យូយម៑ អាលោចយធ្វំ តៃ រ្វាក្យៃរនន្តាយុះ ប្រាប្ស្យាម ឥតិ យូយំ ពុធ្យធ្វេ តទ្ធម៌្មបុស្តកានិ មទត៌្ហេ ប្រមាណំ ទទតិ។</para>
  <para style="p">
    <verse number="40" style="v"/>តថាបិ យូយំ បរមាយុះប្រាប្តយេ មម សំនិធិម៑ ន ជិគមិឞថ។</para>
  <para style="p">
    <verse number="41" style="v"/>អហំ មានុឞេភ្យះ សត្ការំ ន គ្ឫហ្លាមិ។</para>
  <para style="p">
    <verse number="42" style="v"/>អហំ យុឞ្មាន៑ ជានាមិ; យុឞ្មាកមន្តរ ឦឝ្វរប្រេម នាស្តិ។</para>
  <para style="p">
    <verse number="43" style="v"/>អហំ និជបិតុ រ្នាម្នាគតោស្មិ តថាបិ មាំ ន គ្ឫហ្លីថ កិន្តុ កឝ្ចិទ៑ យទិ ស្វនាម្នា សមាគមិឞ្យតិ តហ៌ិ តំ គ្រហីឞ្យថ។</para>
  <para style="p">
    <verse number="44" style="v"/>យូយម៑ ឦឝ្វរាត៑ សត្ការំ ន ចិឞ្ដត្វា កេវលំ បរស្បរំ សត្ការម៑ ចេទ៑ អាទធ្វ្វេ តហ៌ិ កថំ វិឝ្វសិតុំ ឝក្នុថ?</para>
  <para style="p">
    <verse number="45" style="v"/>បុតុះ សមីបេៜហំ យុឞ្មាន៑ អបវទិឞ្យាមីតិ មា ចិន្តយត យស្មិន៑ , យស្មិន៑ យុឞ្មាកំ វិឝ្វសះ សឯវ មូសា យុឞ្មាន៑ អបវទតិ។</para>
  <para style="p">
    <verse number="46" style="v"/>យទិ យូយំ តស្មិន៑ វ្យឝ្វសិឞ្យត តហ៌ិ មយ្យបិ វ្យឝ្វសិឞ្យត, យត៑ ស មយិ លិខិតវាន៑។</para>
  <para style="p">
    <verse number="47" style="v"/>តតោ យទិ តេន លិខិតវានិ ន ប្រតិថ តហ៌ិ មម វាក្យានិ កថំ ប្រត្យេឞ្យថ?</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តតះ បរំ យីឝុ រ្គាលីល៑ ប្រទេឝីយស្យ តិវិរិយានាម្នះ សិន្ធោះ បារំ គតវាន៑។</para>
  <para style="p">
    <verse number="2" style="v"/>តតោ វ្យាធិមល្លោកស្វាស្ថ្យករណរូបាណិ តស្យាឝ្ចយ៌្យាណិ កម៌្មាណិ ទ្ឫឞ្ដ្វា ពហវោ ជនាស្តត្បឝ្ចាទ៑ អគច្ឆន៑។</para>
  <para style="p">
    <verse number="3" style="v"/>តតោ យីឝុះ បវ៌្វតមារុហ្យ តត្រ ឝិឞ្យៃះ សាកម៑។</para>
  <para style="p">
    <verse number="4" style="v"/>តស្មិន៑ សមយ និស្តារោត្សវនាម្និ យិហូទីយានាម ឧត្សវ ឧបស្ថិតេ</para>
  <para style="p">
    <verse number="5" style="v"/>យីឝុ រ្នេត្រេ ឧត្តោល្យ ពហុលោកាន៑ ស្វសមីបាគតាន៑ វិលោក្យ ផិលិបំ ប្ឫឞ្ដវាន៑ ឯតេឞាំ ភោជនាយ ភោជទ្រវ្យាណិ វយំ កុត្រ ក្រេតុំ ឝក្រុមះ?</para>
  <para style="p">
    <verse number="6" style="v"/>វាក្យមិទំ តស្យ បរីក្ឞាត៌្ហម៑ អវាទីត៑ កិន្តុ យត៑ ករិឞ្យតិ តត៑ ស្វយម៑ អជានាត៑។</para>
  <para style="p">
    <verse number="7" style="v"/>ផិលិបះ ប្រត្យវោចត៑ ឯតេឞាម៑ ឯកៃកោ យទ្យល្បម៑ អល្បំ ប្រាប្នោតិ តហ៌ិ មុទ្រាបាទទ្វិឝតេន ក្រីតបូបា អបិ ន្យូនា ភវិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="8" style="v"/>ឝិមោន៑ បិតរស្យ ភ្រាតា អាន្ទ្រិយាខ្យះ ឝិឞ្យាណាមេកោ វ្យាហ្ឫតវាន្</para>
  <para style="p">
    <verse number="9" style="v"/>អត្រ កស្យចិទ៑ ពាលកស្យ សមីបេ បញ្ច យាវបូបាះ ក្ឞុទ្រមត្ស្យទ្វយញ្ច សន្តិ កិន្តុ លោកានាំ ឯតាវាតាំ មធ្យេ តៃះ កិំ ភវិឞ្យតិ?</para>
  <para style="p">
    <verse number="10" style="v"/>បឝ្ចាទ៑ យីឝុរវទត៑ លោកានុបវេឝយត តត្រ ពហុយវសសត្ត្វាត៑ បញ្ចសហស្ត្រេភ្យោ ន្យូនា អធិកា វា បុរុឞា ភូម្យាម៑ ឧបាវិឝន៑។</para>
  <para style="p">
    <verse number="11" style="v"/>តតោ យីឝុស្តាន៑ បូបានាទាយ ឦឝ្វរស្យ គុណាន៑ កីត៌្តយិត្វា ឝិឞ្យេឞុ សមាប៌យត៑ តតស្តេ តេភ្យ ឧបវិឞ្ដលោកេភ្យះ បូបាន៑ យថេឞ្ដមត្ស្យញ្ច ប្រាទុះ។</para>
  <para style="p">
    <verse number="12" style="v"/>តេឞុ ត្ឫប្តេឞុ ស តានវោចទ៑ ឯតេឞាំ កិញ្ចិទបិ យថា នាបចីយតេ តថា សវ៌្វាណ្យវឝិឞ្ដានិ សំគ្ឫហ្លីត។</para>
  <para style="p">
    <verse number="13" style="v"/>តតះ សវ៌្វេឞាំ ភោជនាត៑ បរំ តេ តេឞាំ បញ្ចានាំ យាវបូបានាំ អវឝិឞ្ដាន្យខិលានិ សំគ្ឫហ្យ ទ្វាទឝឌល្លកាន៑ អបូរយន៑។</para>
  <para style="p">
    <verse number="14" style="v"/>អបរំ យីឝោរេតាទ្ឫឝីម៑ អាឝ្ចយ៌្យក្រិយាំ ទ្ឫឞ្ដ្វា លោកា មិថោ វក្តុមារេភិរេ ជគតិ យស្យាគមនំ ភវិឞ្យតិ ស ឯវាយម៑ អវឝ្យំ ភវិឞ្យទ្វក្ត្តា។</para>
  <para style="p">
    <verse number="15" style="v"/>អតឯវ លោកា អាគត្យ តមាក្រម្យ រាជានំ ករិឞ្យន្តិ យីឝុស្តេឞាម៑ ឦទ្ឫឝំ មានសំ វិជ្ញាយ បុនឝ្ច បវ៌្វតម៑ ឯកាកី គតវាន៑។</para>
  <para style="p">
    <verse number="16" style="v"/>សាយំកាល ឧបស្ថិតេ ឝិឞ្យា ជលធិតដំ វ្រជិត្វា នាវមារុហ្យ នគរទិឝិ សិន្ធៅ វាហយិត្វាគមន៑។</para>
  <para style="p">
    <verse number="17" style="v"/>តស្មិន៑ សមយេ តិមិរ ឧបាតិឞ្ឋត៑ កិន្តុ យីឞុស្តេឞាំ សមីបំ នាគច្ឆត៑។</para>
  <para style="p">
    <verse number="18" style="v"/>តទា ប្រពលបវនវហនាត៑ សាគរេ មហាតរង្គោ ភវិតុម៑ អារេភេ។</para>
  <para style="p">
    <verse number="19" style="v"/>តតស្តេ វាហយិត្វា ទ្វិត្រាន៑ ក្រោឝាន៑ គតាះ បឝ្ចាទ៑ យីឝុំ ជលធេរុបរិ បទ្ភ្យាំ វ្រជន្តំ នៅកាន្តិកម៑ អាគច្ឆន្តំ វិលោក្យ ត្រាសយុក្តា អភវន្</para>
  <para style="p">
    <verse number="20" style="v"/>កិន្តុ ស តានុក្ត្តវាន៑ អយមហំ មា ភៃឞ្ដ។</para>
  <para style="p">
    <verse number="21" style="v"/>តទា តេ តំ ស្វៃរំ នាវិ គ្ឫហីតវន្តះ តទា តត្ក្ឞណាទ៑ ឧទ្ទិឞ្ដស្ថានេ នៅរុបាស្ថាត៑។</para>
  <para style="p">
    <verse number="22" style="v"/>យយា នាវា ឝិឞ្យា អគច្ឆន៑ តទន្យា កាបិ នៅកា តស្មិន៑ ស្ថានេ នាសីត៑ តតោ យីឝុះ ឝិឞ្យៃះ សាកំ នាគមត៑ កេវលាះ ឝិឞ្យា អគមន៑ ឯតត៑ បារស្ថា លោកា ជ្ញាតវន្តះ។</para>
  <para style="p">
    <verse number="23" style="v"/>កិន្តុ តតះ បរំ ប្រភុ រ្យត្រ ឦឝ្វរស្យ គុណាន៑ អនុកីត៌្ត្យ លោកាន៑ បូបាន៑ អភោជយត៑ តត្ស្ថានស្យ សមីបស្ថតិវិរិយាយា អបរាស្តរណយ អាគមន៑។</para>
  <para style="p">
    <verse number="24" style="v"/>យីឝុស្តត្រ នាស្តិ ឝិឞ្យា អបិ តត្រ នា សន្តិ លោកា ឥតិ វិជ្ញាយ យីឝុំ គវេឞយិតុំ តរណិភិះ កផន៌ាហូម៑ បុរំ គតាះ។</para>
  <para style="p">
    <verse number="25" style="v"/>តតស្តេ សរិត្បតេះ បារេ តំ សាក្ឞាត៑ ប្រាប្យ ប្រាវោចន៑ ហេ គុរោ ភវាន៑ អត្រ ស្ថានេ កទាគមត៑?</para>
  <para style="p">
    <verse number="26" style="v"/>តទា យីឝុស្តាន៑ ប្រត្យវាទីទ៑ យុឞ្មានហំ យថាត៌្ហតរំ វទាមិ អាឝ្ចយ៌្យកម៌្មទឝ៌នាទ្ធេតោ រ្ន កិន្តុ បូបភោជនាត៑ តេន ត្ឫប្តត្វាញ្ច មាំ គវេឞយថ។</para>
  <para style="p">
    <verse number="27" style="v"/>ក្ឞយណីយភក្ឞ្យាត៌្ហំ មា ឝ្រាមិឞ្ដ កិន្ត្វន្តាយុព៌្ហក្ឞ្យាត៌្ហំ ឝ្រាម្យត, តស្មាត៑ តាទ្ឫឝំ ភក្ឞ្យំ មនុជបុត្រោ យុឞ្មាភ្យំ ទាស្យតិ; តស្មិន៑ តាត ឦឝ្វរះ ប្រមាណំ ប្រាទាត៑។</para>
  <para style="p">
    <verse number="28" style="v"/>តទា តេៜប្ឫច្ឆន៑ ឦឝ្វរាភិមតំ កម៌្ម កត៌្តុម៑ អស្មាភិះ កិំ កត៌្តវ្យំ?</para>
  <para style="p">
    <verse number="29" style="v"/>តតោ យីឝុរវទទ៑ ឦឝ្វរោ យំ ប្រៃរយត៑ តស្មិន៑ វិឝ្វសនម៑ ឦឝ្វរាភិមតំ កម៌្ម។</para>
  <para style="p">
    <verse number="30" style="v"/>តទា តេ វ្យាហរន៑ ភវតា កិំ លក្ឞណំ ទឝ៌ិតំ យទ្ទ្ឫឞ្ដ្វា ភវតិ វិឝ្វសិឞ្យាមះ? ត្វយា កិំ កម៌្ម ក្ឫតំ?</para>
  <para style="p">
    <verse number="31" style="v"/>អស្មាកំ បូវ៌្វបុរុឞា មហាប្រាន្តរេ មាន្នាំ ភោក្ត្តុំ ប្រាបុះ យថា លិបិរាស្តេ។ ស្វគ៌ីយាណិ តុ ភក្ឞ្យាណិ ប្រទទៅ បរមេឝ្វរះ។</para>
  <para style="p">
    <verse number="32" style="v"/>តទា យីឝុរវទទ៑ អហំ យុឞ្មានតិយថាត៌្ហំ វទាមិ មូសា យុឞ្មាភ្យំ ស្វគ៌ីយំ ភក្ឞ្យំ នាទាត៑ កិន្តុ មម បិតា យុឞ្មាភ្យំ ស្វគ៌ីយំ បរមំ ភក្ឞ្យំ ទទាតិ។</para>
  <para style="p">
    <verse number="33" style="v"/>យះ ស្វគ៌ាទវរុហ្យ ជគតេ ជីវនំ ទទាតិ ស ឦឝ្វរទត្តភក្ឞ្យរូបះ។</para>
  <para style="p">
    <verse number="34" style="v"/>តទា តេ ប្រាវោចន៑ ហេ ប្រភោ ភក្ឞ្យមិទំ និត្យមស្មភ្យំ ទទាតុ។</para>
  <para style="p">
    <verse number="35" style="v"/>យីឝុរវទទ៑ អហមេវ ជីវនរូបំ ភក្ឞ្យំ យោ ជនោ មម សន្និធិម៑ អាគច្ឆតិ ស ជាតុ ក្ឞុធាត៌្តោ ន ភវិឞ្យតិ, តថា យោ ជនោ មាំ ប្រត្យេតិ ស ជាតុ ត្ឫឞាត៌្តោ ន ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="36" style="v"/>មាំ ទ្ឫឞ្ដ្វាបិ យូយំ ន វិឝ្វសិថ យុឞ្មានហម៑ ឥត្យវោចំ។</para>
  <para style="p">
    <verse number="37" style="v"/>បិតា មហ្យំ យាវតោ លោកានទទាត៑ តេ សវ៌្វ ឯវ មមាន្តិកម៑ អាគមិឞ្យន្តិ យះ កឝ្ចិច្ច មម សន្និធិម៑ អាយាស្យតិ តំ កេនាបិ ប្រការេណ ន ទូរីករិឞ្យាមិ។</para>
  <para style="p">
    <verse number="38" style="v"/>និជាភិមតំ សាធយិតុំ ន ហិ កិន្តុ ប្រេរយិតុរភិមតំ សាធយិតុំ ស្វគ៌ាទ៑ អាគតោស្មិ។</para>
  <para style="p">
    <verse number="39" style="v"/>ស យាន៑ យាន៑ លោកាន៑ មហ្យមទទាត៑ តេឞាមេកមបិ ន ហារយិត្វា ឝេឞទិនេ សវ៌្វានហម៑ ឧត្ថាបយាមិ ឥទំ មត្ប្រេរយិតុះ បិតុរភិមតំ។</para>
  <para style="p">
    <verse number="40" style="v"/>យះ កឝ្ចិន៑ មានវសុតំ វិលោក្យ វិឝ្វសិតិ ស ឝេឞទិនេ មយោត្ថាបិតះ សន៑ អនន្តាយុះ ប្រាប្ស្យតិ ឥតិ មត្ប្រេរកស្យាភិមតំ។</para>
  <para style="p">
    <verse number="41" style="v"/>តទា ស្វគ៌ាទ៑ យទ៑ ភក្ឞ្យម៑ អវារោហត៑ តទ៑ ភក្ឞ្យម៑ អហមេវ យិហូទីយលោកាស្តស្យៃតទ៑ វាក្យេ វិវទមានា វក្ត្តុមារេភិរេ</para>
  <para style="p">
    <verse number="42" style="v"/>យូឞផះ បុត្រោ យីឝុ រ្យស្យ មាតាបិតរៅ វយំ ជានីម ឯឞ កិំ សឯវ ន? តហ៌ិ ស្វគ៌ាទ៑ អវារោហម៑ ឥតិ វាក្យំ កថំ វក្ត្តិ?</para>
  <para style="p">
    <verse number="43" style="v"/>តទា យីឝុស្តាន៑ ប្រត្យវទត៑ បរស្បរំ មា វិវទធ្វំ</para>
  <para style="p">
    <verse number="44" style="v"/>មត្ប្រេរកេណ បិត្រា នាក្ឫឞ្ដះ កោបិ ជនោ មមាន្តិកម៑ អាយាតុំ ន ឝក្នោតិ កិន្ត្វាគតំ ជនំ ចរមេៜហ្និ ប្រោត្ថាបយិឞ្យាមិ។</para>
  <para style="p">
    <verse number="45" style="v"/>តេ សវ៌្វ ឦឝ្វរេណ ឝិក្ឞិតា ភវិឞ្យន្តិ ភវិឞ្យទ្វាទិនាំ គ្រន្ថេឞុ លិបិរិត្ថមាស្តេ អតោ យះ កឝ្ចិត៑ បិតុះ សកាឝាត៑ ឝ្រុត្វា ឝិក្ឞតេ ស ឯវ មម សមីបម៑ អាគមិឞ្យតិ។</para>
  <para style="p">
    <verse number="46" style="v"/>យ ឦឝ្វរាទ៑ អជាយត តំ វិនា កោបិ មនុឞ្យោ ជនកំ នាទឝ៌ត៑ កេវលះ សឯវ តាតម៑ អទ្រាក្ឞីត៑។</para>
  <para style="p">
    <verse number="47" style="v"/>អហំ យុឞ្មាន៑ យថាត៌្ហតរំ វទាមិ យោ ជនោ មយិ វិឝ្វាសំ ករោតិ សោនន្តាយុះ ប្រាប្នោតិ។</para>
  <para style="p">
    <verse number="48" style="v"/>អហមេវ តជ្ជីវនភក្ឞ្យំ។</para>
  <para style="p">
    <verse number="49" style="v"/>យុឞ្មាកំ បូវ៌្វបុរុឞា មហាប្រាន្តរេ មន្នាភក្ឞ្យំ ភូក្ត្តាបិ ម្ឫតាះ</para>
  <para style="p">
    <verse number="50" style="v"/>កិន្តុ យទ្ភក្ឞ្យំ ស្វគ៌ាទាគច្ឆត៑ តទ៑ យទិ កឝ្ចិទ៑ ភុង្ក្ត្តេ តហ៌ិ ស ន ម្រិយតេ។</para>
  <para style="p">
    <verse number="51" style="v"/>យជ្ជីវនភក្ឞ្យំ ស្វគ៌ាទាគច្ឆត៑ សោហមេវ ឥទំ ភក្ឞ្យំ យោ ជនោ ភុង្ក្ត្តេ ស និត្យជីវី ភវិឞ្យតិ។ បុនឝ្ច ជគតោ ជីវនាត៌្ហមហំ យត៑ ស្វកីយបិឝិតំ ទាស្យាមិ តទេវ មយា វិតរិតំ ភក្ឞ្យម៑។</para>
  <para style="p">
    <verse number="52" style="v"/>តស្មាទ៑ យិហូទីយាះ បរស្បរំ វិវទមានា វក្ត្តុមារេភិរេ ឯឞ ភោជនាត៌្ហំ ស្វីយំ បលលំ កថម៑ អស្មភ្យំ ទាស្យតិ?</para>
  <para style="p">
    <verse number="53" style="v"/>តទា យីឝុស្តាន៑ អាវោចទ៑ យុឞ្មានហំ យថាត៌្ហតរំ វទាមិ មនុឞ្យបុត្រស្យាមិឞេ យុឞ្មាភិ រ្ន ភុក្ត្តេ តស្យ រុធិរេ ច ន បីតេ ជីវនេន សាទ៌្ធំ យុឞ្មាកំ សម្ពន្ធោ នាស្តិ។</para>
  <para style="p">
    <verse number="54" style="v"/>យោ មមាមិឞំ ស្វាទតិ មម សុធិរញ្ច បិវតិ សោនន្តាយុះ ប្រាប្នោតិ តតះ ឝេឞេៜហ្និ តមហម៑ ឧត្ថាបយិឞ្យាមិ។</para>
  <para style="p">
    <verse number="55" style="v"/>យតោ មទីយមាមិឞំ បរមំ ភក្ឞ្យំ តថា មទីយំ ឝោណិតំ បរមំ បេយំ។</para>
  <para style="p">
    <verse number="56" style="v"/>យោ ជនោ មទីយំ បលលំ ស្វាទតិ មទីយំ រុធិរញ្ច បិវតិ ស មយិ វសតិ តស្មិន្នហញ្ច វសាមិ។</para>
  <para style="p">
    <verse number="57" style="v"/>មត្ប្រេរយិត្រា ជីវតា តាតេន យថាហំ ជីវាមិ តទ្វទ៑ យះ កឝ្ចិន៑ មាមត្តិ សោបិ មយា ជីវិឞ្យតិ។</para>
  <para style="p">
    <verse number="58" style="v"/>យទ្ភក្ឞ្យំ ស្វគ៌ាទាគច្ឆត៑ តទិទំ យន្មាន្នាំ ស្វាទិត្វា យុឞ្មាកំ បិតរោៜម្រិយន្ត តាទ្ឫឝម៑ ឥទំ ភក្ឞ្យំ ន ភវតិ ឥទំ ភក្ឞ្យំ យោ ភក្ឞតិ ស និត្យំ ជីវិឞ្យតិ។</para>
  <para style="p">
    <verse number="59" style="v"/>យទា កផន៌ាហូម៑ បុយ៌្យាំ ភជនគេហេ ឧបាទិឝត៑ តទា កថា ឯតា អកថយត៑។</para>
  <para style="p">
    <verse number="60" style="v"/>តទេត្ថំ ឝ្រុត្វា តស្យ ឝិឞ្យាណាម៑ អនេកេ បរស្បរម៑ អកថយន៑ ឥទំ គាឍំ វាក្យំ វាក្យមីទ្ឫឝំ កះ ឝ្រោតុំ ឝក្រុយាត៑?</para>
  <para style="p">
    <verse number="61" style="v"/>កិន្តុ យីឝុះ ឝិឞ្យាណាម៑ ឥត្ថំ វិវាទំ ស្វចិត្តេ វិជ្ញាយ កថិតវាន៑ ឥទំ វាក្យំ កិំ យុឞ្មាកំ វិឃ្នំ ជនយតិ?</para>
  <para style="p">
    <verse number="62" style="v"/>យទិ មនុជសុតំ បូវ៌្វវាសស្ថានម៑ ឩទ៌្វ្វំ គច្ឆន្តំ បឝ្យថ តហ៌ិ កិំ ភវិឞ្យតិ?</para>
  <para style="p">
    <verse number="63" style="v"/>អាត្មៃវ ជីវនទាយកះ វបុ រ្និឞ្ផលំ យុឞ្មភ្យមហំ យានិ វចាំសិ កថយាមិ តាន្យាត្មា ជីវនញ្ច។</para>
  <para style="p">
    <verse number="64" style="v"/>កិន្តុ យុឞ្មាកំ មធ្យេ កេចន អវិឝ្វាសិនះ សន្តិ កេ កេ ន វិឝ្វសន្តិ កោ វា តំ បរករេឞុ សមប៌យិឞ្យតិ តាន៑ យីឝុរាប្រថមាទ៑ វេត្តិ។</para>
  <para style="p">
    <verse number="65" style="v"/>អបរមបិ កថិតវាន៑ អស្មាត៑ ការណាទ៑ អកថយំ បិតុះ សកាឝាត៑ ឝក្ត្តិមប្រាប្យ កោបិ មមាន្តិកម៑ អាគន្តុំ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="66" style="v"/>តត្កាលេៜនេកេ ឝិឞ្យា វ្យាឃុដ្យ តេន សាទ៌្ធំ បុន រ្នាគច្ឆន៑។</para>
  <para style="p">
    <verse number="67" style="v"/>តទា យីឝុ រ្ទ្វាទឝឝិឞ្យាន៑ ឧក្ត្តវាន៑ យូយមបិ កិំ យាស្យថ?</para>
  <para style="p">
    <verse number="68" style="v"/>តតះ ឝិមោន៑ បិតរះ ប្រត្យវោចត៑ ហេ ប្រភោ កស្យាភ្យណ៌ំ គមិឞ្យាមះ?</para>
  <para style="p">
    <verse number="69" style="v"/>អនន្តជីវនទាយិន្យោ យាះ កថាស្តាស្តវៃវ។ ភវាន៑ អមរេឝ្វរស្យាភិឞិក្ត្តបុត្រ ឥតិ វិឝ្វស្យ និឝ្ចិតំ ជានីមះ។</para>
  <para style="p">
    <verse number="70" style="v"/>តទា យីឝុរវទត៑ កិមហំ យុឞ្មាកំ ទ្វាទឝជនាន៑ មនោនីតាន៑ ន ក្ឫតវាន៑? កិន្តុ យុឞ្មាកំ មធ្យេបិ កឝ្ចិទេកោ វិឃ្នការី វិទ្យតេ។</para>
  <para style="p">
    <verse number="71" style="v"/>ឥមាំ កថំ ស ឝិមោនះ បុត្រម៑ ឦឞ្ករីយោតីយំ យិហូទាម៑ ឧទ្ទិឝ្យ កថិតវាន៑ យតោ ទ្វាទឝានាំ មធ្យេ គណិតះ ស តំ បរករេឞុ សមប៌យិឞ្យតិ។</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តតះ បរំ យិហូទីយលោកាស្តំ ហន្តុំ សមៃហន្ត តស្មាទ៑ យីឝុ រ្យិហូទាប្រទេឝេ បយ៌្យដិតុំ នេច្ឆន៑ គាលីល៑ ប្រទេឝេ បយ៌្យដិតុំ ប្រារភត។</para>
  <para style="p">
    <verse number="2" style="v"/>កិន្តុ តស្មិន៑ សមយេ យិហូទីយានាំ ទូឞ្យវាសនាមោត្សវ ឧបស្ថិតេ</para>
  <para style="p">
    <verse number="3" style="v"/>តស្យ ភ្រាតរស្តម៑ អវទន៑ យានិ កម៌្មាណិ ត្វយា ក្រិយន្តេ តានិ យថា តវ ឝិឞ្យាះ បឝ្យន្តិ តទត៌្ហំ ត្វមិតះ ស្ថានាទ៑ យិហូទីយទេឝំ វ្រជ។</para>
  <para style="p">
    <verse number="4" style="v"/>យះ កឝ្ចិត៑ ស្វយំ ប្រចិកាឝិឞតិ ស កទាបិ គុប្តំ កម៌្ម ន ករោតិ យទីទ្ឫឝំ កម៌្ម ករោឞិ តហ៌ិ ជគតិ និជំ បរិចាយយ។</para>
  <para style="p">
    <verse number="5" style="v"/>យតស្តស្យ ភ្រាតរោបិ តំ ន វិឝ្វសន្តិ។</para>
  <para style="p">
    <verse number="6" style="v"/>តទា យីឝុស្តាន៑ អវោចត៑ មម សមយ ឥទានីំ នោបតិឞ្ឋតិ កិន្តុ យុឞ្មាកំ សមយះ សតតម៑ ឧបតិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="7" style="v"/>ជគតោ លោកា យុឞ្មាន៑ ឫតីយិតុំ ន ឝក្រុវន្តិ កិន្តុ មាមេវ ឫតីយន្តេ យតស្តេឞាំ កម៌ាណិ ទុឞ្ដានិ តត្រ សាក្ឞ្យមិទម៑ អហំ ទទាមិ។</para>
  <para style="p">
    <verse number="8" style="v"/>អតឯវ យូយម៑ ឧត្សវេៜស្មិន៑ យាត នាហម៑ ឥទានីម៑ អស្មិន្នុត្សវេ យាមិ យតោ មម សមយ ឥទានីំ ន សម្បូណ៌ះ។</para>
  <para style="p">
    <verse number="9" style="v"/>ឥតិ វាក្យម៑ ឧក្ត្ត្វា ស គាលីលិ ស្ថិតវាន្</para>
  <para style="p">
    <verse number="10" style="v"/>កិន្តុ តស្យ ភ្រាត្ឫឞុ តត្រ ប្រស្ថិតេឞុ សត្សុ សោៜប្រកដ ឧត្សវម៑ អគច្ឆត៑។</para>
  <para style="p">
    <verse number="11" style="v"/>អនន្តរម៑ ឧត្សវម៑ ឧបស្ថិតា យិហូទីយាស្តំ ម្ឫគយិត្វាប្ឫច្ឆន៑ ស កុត្រ?</para>
  <para style="p">
    <verse number="12" style="v"/>តតោ លោកានាំ មធ្យេ តស្មិន៑ នានាវិធា វិវាទា ភវិតុម៑ អារព្ធវន្តះ។ កេចិទ៑ អវោចន៑ ស ឧត្តមះ បុរុឞះ កេចិទ៑ អវោចន៑ ន តថា វរំ លោកានាំ ភ្រមំ ជនយតិ។</para>
  <para style="p">
    <verse number="13" style="v"/>កិន្តុ យិហូទីយានាំ ភយាត៑ កោបិ តស្យ បក្ឞេ ស្បឞ្ដំ នាកថយត៑។</para>
  <para style="p">
    <verse number="14" style="v"/>តតះ បរម៑ ឧត្សវស្យ មធ្យសមយេ យីឝុ រ្មន្ទិរំ គត្វា សមុបទិឝតិ ស្ម។</para>
  <para style="p">
    <verse number="15" style="v"/>តតោ យិហូទីយា លោកា អាឝ្ចយ៌្យំ ជ្ញាត្វាកថយន៑ ឯឞា មានុឞោ នាធីត្យា កថម៑ ឯតាទ្ឫឝោ វិទ្វានភូត៑?</para>
  <para style="p">
    <verse number="16" style="v"/>តទា យីឝុះ ប្រត្យវោចទ៑ ឧបទេឝោយំ ន មម កិន្តុ យោ មាំ ប្រេឞិតវាន៑ តស្យ។</para>
  <para style="p">
    <verse number="17" style="v"/>យោ ជនោ និទេឝំ តស្យ គ្រហីឞ្យតិ មមោបទេឝោ មត្តោ ភវតិ កិម៑ ឦឝ្វរាទ៑ ភវតិ ស គនស្តជ្ជ្ញាតុំ ឝក្ឞ្យតិ។</para>
  <para style="p">
    <verse number="18" style="v"/>យោ ជនះ ស្វតះ កថយតិ ស ស្វីយំ គៅរវម៑ ឦហតេ កិន្តុ យះ ប្រេរយិតុ រ្គៅរវម៑ ឦហតេ ស សត្យវាទី តស្មិន៑ កោប្យធម៌្មោ នាស្តិ។</para>
  <para style="p">
    <verse number="19" style="v"/>មូសា យុឞ្មភ្យំ វ្យវស្ថាគ្រន្ថំ កិំ នាទទាត៑? កិន្តុ យុឞ្មាកំ កោបិ តាំ វ្យវស្ថាំ ន សមាចរតិ។ មាំ ហន្តុំ កុតោ យតធ្វេ?</para>
  <para style="p">
    <verse number="20" style="v"/>តទា លោកា អវទន៑ ត្វំ ភូតគ្រស្តស្ត្វាំ ហន្តុំ កោ យតតេ?</para>
  <para style="p">
    <verse number="21" style="v"/>តតោ យីឝុរវោចទ៑ ឯកំ កម៌្ម មយាការិ តស្មាទ៑ យូយំ សវ៌្វ មហាឝ្ចយ៌្យំ មន្យធ្វេ។</para>
  <para style="p">
    <verse number="22" style="v"/>មូសា យុឞ្មភ្យំ ត្វក្ឆេទវិធិំ ប្រទទៅ ស មូសាតោ ន ជាតះ កិន្តុ បិត្ឫបុរុឞេភ្យោ ជាតះ តេន វិឝ្រាមវារេៜបិ មានុឞាណាំ ត្វក្ឆេទំ កុរុថ។</para>
  <para style="p">
    <verse number="23" style="v"/>អតឯវ វិឝ្រាមវារេ មនុឞ្យាណាំ ត្វក្ឆេទេ ក្ឫតេ យទិ មូសាវ្យវស្ថាមង្គនំ ន ភវតិ តហ៌ិ មយា វិឝ្រាមវារេ មានុឞះ សម្បូណ៌រូបេណ ស្វស្ថោៜការិ តត្ការណាទ៑ យូយំ កិំ មហ្យំ កុប្យថ?</para>
  <para style="p">
    <verse number="24" style="v"/>សបក្ឞបាតំ វិចារមក្ឫត្វា ន្យាយ្យំ វិចារំ កុរុត។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា យិរូឝាលម៑ និវាសិនះ កតិបយជនា អកថយន៑ ឥមេ យំ ហន្តុំ ចេឞ្ដន្តេ ស ឯវាយំ កិំ ន?</para>
  <para style="p">
    <verse number="26" style="v"/>កិន្តុ បឝ្យត និព៌្ហយះ សន៑ កថាំ កថយតិ តថាបិ កិមបិ អ វទន្ត្យេតេ អយមេវាភិឞិក្ត្តោ ភវតីតិ និឝ្ចិតំ កិមធិបតយោ ជានន្តិ?</para>
  <para style="p">
    <verse number="27" style="v"/>មនុជោយំ កស្មាទាគមទ៑ ឥតិ វយំ ជានោមះ កិន្ត្វភិឞិក្ត្ត អាគតេ ស កស្មាទាគតវាន៑ ឥតិ កោបិ ជ្ញាតុំ ន ឝក្ឞ្យតិ។</para>
  <para style="p">
    <verse number="28" style="v"/>តទា យីឝុ រ្មធ្យេមន្ទិរម៑ ឧបទិឝន៑ ឧច្ចៃះការម៑ ឧក្ត្តវាន៑ យូយំ កិំ មាំ ជានីថ? កស្មាច្ចាគតោស្មិ តទបិ កិំ ជានីថ? នាហំ ស្វត អាគតោស្មិ កិន្តុ យះ សត្យវាទី សឯវ មាំ ប្រេឞិតវាន៑ យូយំ តំ ន ជានីថ។</para>
  <para style="p">
    <verse number="29" style="v"/>តមហំ ជានេ តេនាហំ ប្រេរិត អគតោស្មិ។</para>
  <para style="p">
    <verse number="30" style="v"/>តស្មាទ៑ យិហូទីយាស្តំ ធត៌្តុម៑ ឧទ្យតាស្តថាបិ កោបិ តស្យ គាត្រេ ហស្តំ នាប៌យទ៑ យតោ ហេតោស្តទា តស្យ សមយោ នោបតិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="31" style="v"/>កិន្តុ ពហវោ លោកាស្តស្មិន៑ វិឝ្វស្យ កថិតវាន្តោៜភិឞិក្ត្តបុរុឞ អាគត្យ មានុឞស្យាស្យ ក្រិយាភ្យះ កិម៑ អធិកា អាឝ្ចយ៌្យាះ ក្រិយាះ ករិឞ្យតិ?</para>
  <para style="p">
    <verse number="32" style="v"/>តតះ បរំ លោកាស្តស្មិន៑ ឥត្ថំ វិវទន្តេ ផិរូឝិនះ ប្រធានយាជកាញ្ចេតិ ឝ្រុតវន្តស្តំ ធ្ឫត្វា នេតុំ បទាតិគណំ ប្រេឞយាមាសុះ។</para>
  <para style="p">
    <verse number="33" style="v"/>តតោ យីឝុរវទទ៑ អហម៑ អល្បទិនានិ យុឞ្មាភិះ សាទ៌្ធំ ស្ថិត្វា មត្ប្រេរយិតុះ សមីបំ យាស្យាមិ។</para>
  <para style="p">
    <verse number="34" style="v"/>មាំ ម្ឫគយិឞ្យធ្វេ កិន្តូទ្ទេឝំ ន លប្ស្យធ្វេ រត្រ ស្ថាស្យាមិ តត្រ យូយំ គន្តុំ ន ឝក្ឞ្យថ។</para>
  <para style="p">
    <verse number="35" style="v"/>តទា យិហូទីយាះ បរស្បរំ វក្ត្តុមារេភិរេ អស្យោទ្ទេឝំ ន ប្រាប្ស្យាម ឯតាទ្ឫឝំ កិំ ស្ថានំ យាស្យតិ? ភិន្នទេឝេ វិកីណ៌ានាំ យិហូទីយានាំ សន្និធិម៑ ឯឞ គត្វា តាន៑ ឧបទេក្ឞ្យតិ កិំ?</para>
  <para style="p">
    <verse number="36" style="v"/>នោ ចេត៑ មាំ គវេឞយិឞ្យថ កិន្តូទ្ទេឝំ ន ប្រាប្ស្យថ ឯឞ កោទ្ឫឝំ វាក្យមិទំ វទតិ?</para>
  <para style="p">
    <verse number="37" style="v"/>អនន្តរម៑ ឧត្សវស្យ ចរមេៜហនិ អត៌្ហាត៑ ប្រធានទិនេ យីឝុរុត្តិឞ្ឋន៑ ឧច្ចៃះការម៑ អាហ្វយន៑ ឧទិតវាន៑ យទិ កឝ្ចិត៑ ត្ឫឞាត៌្តោ ភវតិ តហ៌ិ មមាន្តិកម៑ អាគត្យ បិវតុ។</para>
  <para style="p">
    <verse number="38" style="v"/>យះ កឝ្ចិន្មយិ វិឝ្វសិតិ ធម៌្មគ្រន្ថស្យ វចនានុសារេណ តស្យាភ្យន្តរតោៜម្ឫតតោយស្យ ស្រោតាំសិ និគ៌មិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="39" style="v"/>យេ តស្មិន៑ វិឝ្វសន្តិ ត អាត្មានំ ប្រាប្ស្យន្តីត្យត៌្ហេ ស ឥទំ វាក្យំ វ្យាហ្ឫតវាន៑ ឯតត្កាលំ យាវទ៑ យីឝុ រ្វិភវំ ន ប្រាប្តស្តស្មាត៑ បវិត្រ អាត្មា នាទីយត។</para>
  <para style="p">
    <verse number="40" style="v"/>ឯតាំ វាណីំ ឝ្រុត្វា ពហវោ លោកា អវទន៑ អយមេវ និឝ្ចិតំ ស ភវិឞ្យទ្វាទី។</para>
  <para style="p">
    <verse number="41" style="v"/>កេចិទ៑ អកថយន៑ ឯឞឯវ សោភិឞិក្ត្តះ កិន្តុ កេចិទ៑ អវទន៑ សោភិឞិក្ត្តះ កិំ គាលីល៑ ប្រទេឝេ ជនិឞ្យតេ?</para>
  <para style="p">
    <verse number="42" style="v"/>សោភិឞិក្ត្តោ ទាយូទោ វំឝេ ទាយូទោ ជន្មស្ថានេ ពៃត្លេហមិ បត្តនេ ជនិឞ្យតេ ធម៌្មគ្រន្ថេ កិមិត្ថំ លិខិតំ នាស្តិ?</para>
  <para style="p">
    <verse number="43" style="v"/>ឥត្ថំ តស្មិន៑ លោកានាំ ភិន្នវាក្យតា ជាតា។</para>
  <para style="p">
    <verse number="44" style="v"/>កតិបយលោកាស្តំ ធត៌្តុម៑ ឰច្ឆន៑ តថាបិ តទ្វបុឞិ កោបិ ហស្តំ នាប៌យត៑។</para>
  <para style="p">
    <verse number="45" style="v"/>អនន្តរំ បាទាតិគណេ ប្រធានយាជកានាំ ផិរូឝិនាញ្ច សមីបមាគតវតិ តេ តាន៑ អប្ឫច្ឆន៑ កុតោ ហេតោស្តំ នានយត?</para>
  <para style="p">
    <verse number="46" style="v"/>តទា បទាតយះ ប្រត្យវទន៑ ស មានវ ឥវ កោបិ កទាបិ នោបាទិឝត៑។</para>
  <para style="p">
    <verse number="47" style="v"/>តតះ ផិរូឝិនះ ប្រាវោចន៑ យូយមបិ កិមភ្រាមិឞ្ដ?</para>
  <para style="p">
    <verse number="48" style="v"/>អធិបតីនាំ ផិរូឝិនាញ្ច កោបិ កិំ តស្មិន៑ វ្យឝ្វសីត៑?</para>
  <para style="p">
    <verse number="49" style="v"/>យេ ឝាស្ត្រំ ន ជានន្តិ ត ឥមេៜធមលោកាឯវ ឝាបគ្រស្តាះ។</para>
  <para style="p">
    <verse number="50" style="v"/>តទា និកទីមនាមា តេឞាមេកោ យះ ក្ឞណទាយាំ យីឝោះ សន្និធិម៑ អគាត៑ ស ឧក្ត្តវាន្</para>
  <para style="p">
    <verse number="51" style="v"/>តស្យ វាក្យេ ន ឝ្រុតេ កម៌្មណិ ច ន វិទិតេ ៜស្មាកំ វ្យវស្ថា កិំ កញ្ចន មនុជំ ទោឞីករោតិ?</para>
  <para style="p">
    <verse number="52" style="v"/>តតស្តេ វ្យាហរន៑ ត្វមបិ កិំ គាលីលីយលោកះ? វិវិច្យ បឝ្យ គលីលិ កោបិ ភវិឞ្យទ្វាទី នោត្បទ្យតេ។</para>
  <para style="p">
    <verse number="53" style="v"/>តតះ បរំ សវ៌្វេ ស្វំ ស្វំ គ្ឫហំ គតាះ កិន្តុ យីឝុ រ្ជៃតុននាមានំ ឝិលោច្ចយំ គតវាន៑។</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ប្រត្យូឞេ យីឝុះ បនម៌ន្ទិរម៑ អាគច្ឆត្</para>
  <para style="p">
    <verse number="2" style="v"/>តតះ សវ៌្វេឞុ លោកេឞុ តស្យ សមីប អាគតេឞុ ស ឧបវិឝ្យ តាន៑ ឧបទេឞ្ដុម៑ អារភត។</para>
  <para style="p">
    <verse number="3" style="v"/>តទា អធ្យាបកាះ ផិរូឝិនញ្ច វ្យភិចារកម៌្មណិ ធ្ឫតំ ស្ត្រិយមេកាម៑ អានិយ សវ៌្វេឞាំ មធ្យេ ស្ថាបយិត្វា វ្យាហរន្</para>
  <para style="p">
    <verse number="4" style="v"/>ហេ គុរោ យោឞិតម៑ ឥមាំ វ្យភិចារកម៌្ម កុវ៌្វាណាំ លោកា ធ្ឫតវន្តះ។</para>
  <para style="p">
    <verse number="5" style="v"/>ឯតាទ្ឫឝលោកាះ បាឞាណាឃាតេន ហន្តវ្យា ឥតិ វិធិម៌ូសាវ្យវស្ថាគ្រន្ថេ លិខិតោស្តិ កិន្តុ ភវាន៑ កិមាទិឝតិ?</para>
  <para style="p">
    <verse number="6" style="v"/>តេ តមបវទិតុំ បរីក្ឞាភិប្រាយេណ វាក្យមិទម៑ អប្ឫច្ឆន៑ កិន្តុ ស ប្រហ្វីភូយ ភូមាវង្គល្យា លេខិតុម៑ អារភត។</para>
  <para style="p">
    <verse number="7" style="v"/>តតស្តៃះ បុនះ បុនះ ប្ឫឞ្ដ ឧត្ថាយ កថិតវាន៑ យុឞ្មាកំ មធ្យេ យោ ជនោ និរបរាធី សឯវ ប្រថមម៑ ឯនាំ បាឞាណេនាហន្តុ។</para>
  <para style="p">
    <verse number="8" style="v"/>បឝ្ចាត៑ ស បុនឝ្ច ប្រហ្វីភូយ ភូមៅ លេខិតុម៑ អារភត។</para>
  <para style="p">
    <verse number="9" style="v"/>តាំ កថំ ឝ្រុត្វា តេ ស្វស្វមនសិ ប្រពោធំ ប្រាប្យ ជ្យេឞ្ឋានុក្រមំ ឯកៃកឝះ សវ៌្វេ ពហិរគច្ឆន៑ តតោ យីឝុរេកាកី តយក្ត្តោភវត៑ មធ្យស្ថានេ ទណ្ឌាយមានា សា យោឞា ច ស្ថិតា។</para>
  <para style="p">
    <verse number="10" style="v"/>តត្បឝ្ចាទ៑ យីឝុរុត្ថាយ តាំ វនិតាំ វិនា កមប្យបរំ ន វិលោក្យ ប្ឫឞ្ដវាន៑ ហេ វាមេ តវាបវាទកាះ កុត្រ? កោបិ ត្វាំ កិំ ន ទណ្ឌយតិ?</para>
  <para style="p">
    <verse number="11" style="v"/>សាវទត៑ ហេ មហេច្ឆ កោបិ ន តទា យីឝុរវោចត៑ នាហមបិ ទណ្ឌយាមិ យាហិ បុនះ បាបំ មាកាឞ៌ីះ។</para>
  <para style="p">
    <verse number="12" style="v"/>តតោ យីឝុះ បុនរបិ លោកេភ្យ ឥត្ថំ កថយិតុម៑ អារភត ជគតោហំ ជ្យោតិះស្វរូបោ យះ កឝ្ចិន៑ មត្បឝ្ចាទ គច្ឆតិ ស តិមិរេ ន ភ្រមិត្វា ជីវនរូបាំ ទីប្តិំ ប្រាប្ស្យតិ។</para>
  <para style="p">
    <verse number="13" style="v"/>តតះ ផិរូឝិនោៜវាទិឞុស្ត្វំ ស្វាត៌្ហេ ស្វយំ សាក្ឞ្យំ ទទាសិ តស្មាត៑ តវ សាក្ឞ្យំ គ្រាហ្យំ ន ភវតិ។</para>
  <para style="p">
    <verse number="14" style="v"/>តទា យីឝុះ ប្រត្យុទិតវាន៑ យទ្យបិ ស្វាត៌្ហេៜហំ ស្វយំ សាក្ឞ្យំ ទទាមិ តថាបិ មត៑ សាក្ឞ្យំ គ្រាហ្យំ យស្មាទ៑ អហំ កុត អាគតោស្មិ ក្វ យាមិ ច តទហំ ជានាមិ កិន្តុ កុត អាគតោស្មិ កុត្រ គច្ឆាមិ ច តទ៑ យូយំ ន ជានីថ។</para>
  <para style="p">
    <verse number="15" style="v"/>យូយំ លៅកិកំ វិចារយថ នាហំ កិមបិ វិចារយាមិ។</para>
  <para style="p">
    <verse number="16" style="v"/>កិន្តុ យទិ វិចារយាមិ តហ៌ិ មម វិចារោ គ្រហីតវ្យោ យតោហម៑ ឯកាកី នាស្មិ ប្រេរយិតា បិតា មយា សហ វិទ្យតេ។</para>
  <para style="p">
    <verse number="17" style="v"/>ទ្វយោ រ្ជនយោះ សាក្ឞ្យំ គ្រហណីយំ ភវតីតិ យុឞ្មាកំ វ្យវស្ថាគ្រន្ថេ លិខិតមស្តិ។</para>
  <para style="p">
    <verse number="18" style="v"/>អហំ ស្វាត៌្ហេ ស្វយំ សាក្ឞិត្វំ ទទាមិ យឝ្ច មម តាតោ មាំ ប្រេរិតវាន៑ សោបិ មទត៌្ហេ សាក្ឞ្យំ ទទាតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>តទា តេៜប្ឫច្ឆន៑ តវ តាតះ កុត្រ? តតោ យីឝុះ ប្រត្យវាទីទ៑ យូយំ មាំ ន ជានីថ មត្បិតរញ្ច ន ជានីថ យទិ មាម៑ អក្ឞាស្យត តហ៌ិ មម តាតមប្យក្ឞាស្យត។</para>
  <para style="p">
    <verse number="20" style="v"/>យីឝុ រ្មន្ទិរ ឧបទិឝ្យ ភណ្ឌាគារេ កថា ឯតា អកថយត៑ តថាបិ តំ ប្រតិ កោបិ ករំ នោទតោលយត៑។</para>
  <para style="p">
    <verse number="21" style="v"/>តតះ បរំ យីឝុះ បុនរុទិតវាន៑ អធុនាហំ គច្ឆាមិ យូយំ មាំ គវេឞយិឞ្យថ កិន្តុ និជៃះ បាបៃ រ្មរិឞ្យថ យត៑ ស្ថានម៑ អហំ យាស្យាមិ តត៑ ស្ថានម៑ យូយំ យាតុំ ន ឝក្ឞ្យថ។</para>
  <para style="p">
    <verse number="22" style="v"/>តទា យិហូទីយាះ ប្រាវោចន៑ កិមយម៑ អាត្មឃាតំ ករិឞ្យតិ? យតោ យត៑ ស្ថានម៑ អហំ យាស្យាមិ តត៑ ស្ថានម៑ យូយំ យាតុំ ន ឝក្ឞ្យថ ឥតិ វាក្យំ ព្រវីតិ។</para>
  <para style="p">
    <verse number="23" style="v"/>តតោ យីឝុស្តេភ្យះ កថិតវាន៑ យូយម៑ អធះស្ថានីយា លោកា អហម៑ ឩទ៌្វ្វស្ថានីយះ យូយម៑ ឯតជ្ជគត្សម្ពន្ធីយា អហម៑ ឯតជ្ជគត្សម្ពន្ធីយោ ន។</para>
  <para style="p">
    <verse number="24" style="v"/>តស្មាត៑ កថិតវាន៑ យូយំ និជៃះ បាបៃ រ្មរិឞ្យថ យតោហំ ស បុមាន៑ ឥតិ យទិ ន វិឝ្វសិថ តហ៌ិ និជៃះ បាបៃ រ្មរិឞ្យថ។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា តេ ៜប្ឫច្ឆន៑ កស្ត្វំ? តតោ យីឝុះ កថិតវាន៑ យុឞ្មាកំ សន្និធៅ យស្យ ប្រស្តាវម៑ អា ប្រថមាត៑ ករោមិ សឯវ បុរុឞោហំ។</para>
  <para style="p">
    <verse number="26" style="v"/>យុឞ្មាសុ មយា ពហុវាក្យំ វក្ត្តវ្យំ វិចារយិតវ្យញ្ច កិន្តុ មត្ប្រេរយិតា សត្យវាទី តស្យ សមីបេ យទហំ ឝ្រុតវាន៑ តទេវ ជគតេ កថយាមិ។</para>
  <para style="p">
    <verse number="27" style="v"/>កិន្តុ ស ជនកេ វាក្យមិទំ ប្រោក្ត្តវាន៑ ឥតិ តេ នាពុធ្យន្ត។</para>
  <para style="p">
    <verse number="28" style="v"/>តតោ យីឝុរកថយទ៑ យទា មនុឞ្យបុត្រម៑ ឩទ៌្វ្វ ឧត្ថាបយិឞ្យថ តទាហំ ស បុមាន៑ កេវលះ ស្វយំ កិមបិ កម៌្ម ន ករោមិ កិន្តុ តាតោ យថា ឝិក្ឞយតិ តទនុសារេណ វាក្យមិទំ វទាមីតិ ច យូយំ ជ្ញាតុំ ឝក្ឞ្យថ។</para>
  <para style="p">
    <verse number="29" style="v"/>មត្ប្រេរយិតា បិតា មាម៑ ឯកាកិនំ ន ត្យជតិ ស មយា សាទ៌្ធំ តិឞ្ឋតិ យតោហំ តទភិមតំ កម៌្ម សទា ករោមិ។</para>
  <para style="p">
    <verse number="30" style="v"/>តទា តស្យៃតានិ វាក្យានិ ឝ្រុត្វា ពហុវស្តាស្មិន៑ វ្យឝ្វសន៑។</para>
  <para style="p">
    <verse number="31" style="v"/>យេ យិហូទីយា វ្យឝ្វសន៑ យីឝុស្តេភ្យោៜកថយត្</para>
  <para style="p">
    <verse number="32" style="v"/>មម វាក្យេ យទិ យូយម៑ អាស្ថាំ កុរុថ តហ៌ិ មម ឝិឞ្យា ភូត្វា សត្យត្វំ ជ្ញាស្យថ តតះ សត្យតយា យុឞ្មាកំ មោក្ឞោ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="33" style="v"/>តទា តេ ប្រត្យវាទិឞុះ វយម៑ ឥព្រាហីមោ វំឝះ កទាបិ កស្យាបិ ទាសា ន ជាតាស្តហ៌ិ យុឞ្មាកំ មុក្ត្តិ រ្ភវិឞ្យតីតិ វាក្យំ កថំ ព្រវីឞិ?</para>
  <para style="p">
    <verse number="34" style="v"/>តទា យីឝុះ ប្រត្យវទទ៑ យុឞ្មានហំ យថាត៌្ហតរំ វទាមិ យះ បាបំ ករោតិ ស បាបស្យ ទាសះ។</para>
  <para style="p">
    <verse number="35" style="v"/>ទាសឝ្ច និរន្តរំ និវេឝនេ ន តិឞ្ឋតិ កិន្តុ បុត្រោ និរន្តរំ តិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="36" style="v"/>អតះ បុត្រោ យទិ យុឞ្មាន៑ មោចយតិ តហ៌ិ និតាន្តមេវ មុក្ត្តា ភវិឞ្យថ។</para>
  <para style="p">
    <verse number="37" style="v"/>យុយម៑ ឥព្រាហីមោ វំឝ ឥត្យហំ ជានាមិ កិន្តុ មម កថា យុឞ្មាកម៑ អន្តះករណេឞុ ស្ថានំ ន ប្រាប្នុវន្តិ តស្មាទ្ធេតោ រ្មាំ ហន្តុម៑ ឦហធ្វេ។</para>
  <para style="p">
    <verse number="38" style="v"/>អហំ ស្វបិតុះ សមីបេ យទបឝ្យំ តទេវ កថយាមិ តថា យូយមបិ ស្វបិតុះ សមីបេ យទបឝ្យត តទេវ កុរុធ្វេ។</para>
  <para style="p">
    <verse number="39" style="v"/>តទា តេ ប្រត្យវោចន៑ ឥព្រាហីម៑ អស្មាកំ បិតា តតោ យីឝុរកថយទ៑ យទិ យូយម៑ ឥព្រាហីមះ សន្តានា អភវិឞ្យត តហ៌ិ ឥព្រាហីម អាចារណវទ៑ អាចរិឞ្យត។</para>
  <para style="p">
    <verse number="40" style="v"/>ឦឝ្វរស្យ មុខាត៑ សត្យំ វាក្យំ ឝ្រុត្វា យុឞ្មាន៑ ជ្ញាបយាមិ យោហំ តំ មាំ ហន្តុំ ចេឞ្ដធ្វេ ឥព្រាហីម៑ ឯតាទ្ឫឝំ កម៌្ម ន ចការ។</para>
  <para style="p">
    <verse number="41" style="v"/>យូយំ ស្វស្វបិតុះ កម៌្មាណិ កុរុថ តទា តៃរុក្ត្តំ ន វយំ ជារជាតា អស្មាកម៑ ឯកឯវ បិតាស្តិ ស ឯវេឝ្វរះ</para>
  <para style="p">
    <verse number="42" style="v"/>តតោ យីឝុនា កថិតម៑ ឦឝ្វរោ យទិ យុឞ្មាកំ តាតោភវិឞ្យត៑ តហ៌ិ យូយំ មយិ ប្រេមាករិឞ្យត យតោហម៑ ឦឝ្វរាន្និគ៌ត្យាគតោស្មិ ស្វតោ នាគតោហំ ស មាំ ប្រាហិណោត៑។</para>
  <para style="p">
    <verse number="43" style="v"/>យូយំ មម វាក្យមិទំ ន ពុធ្យធ្វេ កុតះ? យតោ យូយំ មមោបទេឝំ សោឍុំ ន ឝក្នុថ។</para>
  <para style="p">
    <verse number="44" style="v"/>យូយំ ឝៃតាន៑ បិតុះ សន្តានា ឯតស្មាទ៑ យុឞ្មាកំ បិតុរភិលាឞំ បូរយថ ស អា ប្រថមាត៑ នរឃាតី តទន្តះ សត្យត្វស្យ លេឝោបិ នាស្តិ ការណាទតះ ស សត្យតាយាំ នាតិឞ្ឋត៑ ស យទា ម្ឫឞា កថយតិ តទា និជស្វភាវានុសារេណៃវ កថយតិ យតោ ស ម្ឫឞាភាឞី ម្ឫឞោត្បាទកឝ្ច។</para>
  <para style="p">
    <verse number="45" style="v"/>អហំ តថ្យវាក្យំ វទាមិ ការណាទស្មាទ៑ យូយំ មាំ ន ប្រតីថ។</para>
  <para style="p">
    <verse number="46" style="v"/>មយិ បាបមស្តីតិ ប្រមាណំ យុឞ្មាកំ កោ ទាតុំ ឝក្នោតិ? យទ្យហំ តថ្យវាក្យំ វទាមិ តហ៌ិ កុតោ មាំ ន ប្រតិថ?</para>
  <para style="p">
    <verse number="47" style="v"/>យះ កឝ្ចន ឦឝ្វរីយោ លោកះ ស ឦឝ្វរីយកថាយាំ មនោ និធត្តេ យូយម៑ ឦឝ្វរីយលោកា ន ភវថ តន្និទានាត៑ តត្រ ន មនាំសិ និធទ្វេ។</para>
  <para style="p">
    <verse number="48" style="v"/>តទា យិហូទីយាះ ប្រត្យវាទិឞុះ ត្វមេកះ ឝោមិរោណីយោ ភូតគ្រស្តឝ្ច វយំ កិមិទំ ភទ្រំ នាវាទិឞ្ម?</para>
  <para style="p">
    <verse number="49" style="v"/>តតោ យីឝុះ ប្រត្យវាទីត៑ នាហំ ភូតគ្រស្តះ កិន្តុ និជតាតំ សម្មន្យេ តស្មាទ៑ យូយំ មាម៑ អបមន្យធ្វេ។</para>
  <para style="p">
    <verse number="50" style="v"/>អហំ ស្វសុខ្យាតិំ ន ចេឞ្ដេ កិន្តុ ចេឞ្ដិតា វិចារយិតា ចាបរ ឯក អាស្តេ។</para>
  <para style="p">
    <verse number="51" style="v"/>អហំ យុឞ្មភ្យម៑ អតីវ យថាត៌្ហំ កថយាមិ យោ នរោ មទីយំ វាចំ មន្យតេ ស កទាចន និធនំ ន ទ្រក្ឞ្យតិ។</para>
  <para style="p">
    <verse number="52" style="v"/>យិហូទីយាស្តមវទន៑ ត្វំ ភូតគ្រស្ត ឥតីទានីម៑ អវៃឞ្ម។ ឥព្រាហីម៑ ភវិឞ្យទ្វាទិនញ្ច សវ៌្វេ ម្ឫតាះ កិន្តុ ត្វំ ភាឞសេ យោ នរោ មម ភារតីំ គ្ឫហ្លាតិ ស ជាតុ និធានាស្វាទំ ន លប្ស្យតេ។</para>
  <para style="p">
    <verse number="53" style="v"/>តហ៌ិ ត្វំ កិម៑ អស្មាកំ បូវ៌្វបុរុឞាទ៑ ឥព្រាហីមោបិ មហាន៑? យស្មាត៑ សោបិ ម្ឫតះ ភវិឞ្យទ្វាទិនោបិ ម្ឫតាះ ត្វំ ស្វំ កំ បុមាំសំ មនុឞេ?</para>
  <para style="p">
    <verse number="54" style="v"/>យីឝុះ ប្រត្យវោចទ៑ យទ្យហំ ស្វំ ស្វយំ សម្មន្យេ តហ៌ិ មម តត៑ សម្មននំ កិមបិ ន កិន្តុ មម តាតោ យំ យូយំ ស្វីយម៑ ឦឝ្វរំ ភាឞធ្វេ សឯវ មាំ សម្មនុតេ។</para>
  <para style="p">
    <verse number="55" style="v"/>យូយំ តំ នាវគច្ឆថ កិន្ត្វហំ តមវគច្ឆាមិ តំ នាវគច្ឆាមីតិ វាក្យំ យទិ វទាមិ តហ៌ិ យូយមិវ ម្ឫឞាភាឞី ភវាមិ កិន្ត្វហំ តមវគច្ឆាមិ តទាក្ឞាមបិ គ្ឫហ្លាមិ។</para>
  <para style="p">
    <verse number="56" style="v"/>យុឞ្មាកំ បូវ៌្វបុរុឞ ឥព្រាហីម៑ មម សមយំ ទ្រឞ្ដុម៑ អតីវាវាញ្ឆត៑ តន្និរីក្ឞ្យានន្ទច្ច។</para>
  <para style="p">
    <verse number="57" style="v"/>តទា យិហូទីយា អប្ឫច្ឆន៑ តវ វយះ បញ្ចាឝទ្វត្សរា ន ត្វំ កិម៑ ឥព្រាហីមម៑ អទ្រាក្ឞីះ?</para>
  <para style="p">
    <verse number="58" style="v"/>យីឝុះ ប្រត្យវាទីទ៑ យុឞ្មានហំ យថាត៌្ហតរំ វទាមិ ឥព្រាហីមោ ជន្មនះ បូវ៌្វកាលមារភ្យាហំ វិទ្យេ។</para>
  <para style="p">
    <verse number="59" style="v"/>តទា តេ បាឞាណាន៑ ឧត្តោល្យ តមាហន្តុម៑ ឧទយច្ឆន៑ កិន្តុ យីឝុ រ្គុប្តោ មន្តិរាទ៑ ពហិគ៌ត្យ តេឞាំ មធ្យេន ប្រស្ថិតវាន៑។</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តតះ បរំ យីឝុគ៌ច្ឆន៑ មាគ៌មធ្យេ ជន្មាន្ធំ នរម៑ អបឝ្យត៑។</para>
  <para style="p">
    <verse number="2" style="v"/>តតះ ឝិឞ្យាស្តម៑ អប្ឫច្ឆន៑ ហេ គុរោ នរោយំ ស្វបាបេន វា ស្វបិត្រាះ បាបេនាន្ធោៜជាយត?</para>
  <para style="p">
    <verse number="3" style="v"/>តតះ ស ប្រត្យុទិតវាន៑ ឯតស្យ វាស្យ បិត្រោះ បាបាទ៑ ឯតាទ្ឫឝោភូទ ឥតិ នហិ កិន្ត្វនេន យថេឝ្វរស្យ កម៌្ម ប្រកាឝ្យតេ តទ្ធេតោរេវ។</para>
  <para style="p">
    <verse number="4" style="v"/>ទិនេ តិឞ្ឋតិ មត្ប្រេរយិតុះ កម៌្ម មយា កត៌្តវ្យំ យទា កិមបិ កម៌្ម ន ក្រិយតេ តាទ្ឫឝី និឝាគច្ឆតិ។</para>
  <para style="p">
    <verse number="5" style="v"/>អហំ យាវត្កាលំ ជគតិ តិឞ្ឋាមិ តាវត្កាលំ ជគតោ ជ្យោតិះស្វរូបោស្មិ។</para>
  <para style="p">
    <verse number="6" style="v"/>ឥត្យុក្ត្តា ភូមៅ និឞ្ឋីវំ និក្ឞិប្យ តេន បង្កំ ក្ឫតវាន្</para>
  <para style="p">
    <verse number="7" style="v"/>បឝ្ចាត៑ តត្បង្កេន តស្យាន្ធស្យ នេត្រេ ប្រលិប្យ តមិត្យាទិឝត៑ គត្វា ឝិលោហេ ៜរ្ថាត៑ ប្រេរិតនាម្និ សរសិ ស្នាហិ។ តតោន្ធោ គត្វា តត្រាស្នាត៑ តតះ ប្រន្នចក្ឞុ រ្ភូត្វា វ្យាឃុដ្យាគាត៑។</para>
  <para style="p">
    <verse number="8" style="v"/>អបរញ្ច សមីបវាសិនោ លោកា យេ ច តំ បូវ៌្វមន្ធម៑ អបឝ្យន៑ តេ ពក្ត្តុម៑ អារភន្ត យោន្ធលោកោ វត៌្មន្យុបវិឝ្យាភិក្ឞត ស ឯវាយំ ជនះ កិំ ន ភវតិ?</para>
  <para style="p">
    <verse number="9" style="v"/>កេចិទវទន៑ ស ឯវ កេចិទវោចន៑ តាទ្ឫឝោ ភវតិ កិន្តុ ស ស្វយមព្រវីត៑ ស ឯវាហំ ភវាមិ។</para>
  <para style="p">
    <verse number="10" style="v"/>អតឯវ តេ ៜប្ឫច្ឆន៑ ត្វំ កថំ ទ្ឫឞ្ដិំ បាប្តវាន៑?</para>
  <para style="p">
    <verse number="11" style="v"/>តតះ សោវទទ៑ យីឝនាមក ឯកោ ជនោ មម នយនេ បង្កេន ប្រលិប្យ ឥត្យាជ្ញាបយត៑ ឝិលោហកាសារំ គត្វា តត្រ ស្នាហិ។ តតស្តត្រ គត្វា មយិ ស្នាតេ ទ្ឫឞ្ដិមហំ លព្ធវាន៑។</para>
  <para style="p">
    <verse number="12" style="v"/>តទា តេ ៜវទន៑ ស បុមាន៑ កុត្រ? តេនោក្ត្តំ នាហំ ជានាមិ។</para>
  <para style="p">
    <verse number="13" style="v"/>អបរំ តស្មិន៑ បូវ៌្វាន្ធេ ជនេ ផិរូឝិនាំ និកដម៑ អានីតេ សតិ ផិរូឝិនោបិ តមប្ឫច្ឆន៑ កថំ ទ្ឫឞ្ដិំ ប្រាប្តោសិ?</para>
  <para style="p">
    <verse number="14" style="v"/>តតះ ស កថិតវាន៑ ស បង្កេន មម នេត្រេ ៜលិម្បត៑ បឝ្ចាទ៑ ស្នាត្វា ទ្ឫឞ្ដិមលភេ។</para>
  <para style="p">
    <verse number="15" style="v"/>កិន្តុ យីឝុ រ្វិឝ្រាមវារេ កទ៌្ទមំ ក្ឫត្វា តស្យ នយនេ ប្រសន្នេៜករោទ៑ ឥតិការណាត៑ កតិបយផិរូឝិនោៜវទន្</para>
  <para style="p">
    <verse number="16" style="v"/>ស បុមាន៑ ឦឝ្វរាន្ន យតះ ស វិឝ្រាមវារំ ន មន្យតេ។ តតោន្យេ កេចិត៑ ប្រត្យវទន៑ បាបី បុមាន៑ កិម៑ ឯតាទ្ឫឝម៑ អាឝ្ចយ៌្យំ កម៌្ម កត៌្តុំ ឝក្នោតិ?</para>
  <para style="p">
    <verse number="17" style="v"/>ឥត្ថំ តេឞាំ បរស្បរំ ភិន្នវាក្យត្វម៑ អភវត៑។ បឝ្ចាត៑ តេ បុនរបិ តំ បូវ៌្វាន្ធំ មានុឞម៑ អប្រាក្ឞុះ យោ ជនស្តវ ចក្ឞុឞី ប្រសន្នេ ក្ឫតវាន៑ តស្មិន៑ ត្វំ កិំ វទសិ? ស ឧក្ត្តវាន៑ ស ភវិឝទ្វាទី។</para>
  <para style="p">
    <verse number="18" style="v"/>ស ទ្ឫឞ្ដិម៑ អាប្តវាន៑ ឥតិ យិហូទីយាស្តស្យ ទ្ឫឞ្ដិំ ប្រាប្តស្យ ជនស្យ បិត្រោ រ្មុខាទ៑ អឝ្រុត្វា ន ប្រត្យយន៑។</para>
  <para style="p">
    <verse number="19" style="v"/>អតឯវ តេ តាវប្ឫច្ឆន៑ យុវយោ រ្យំ បុត្រំ ជន្មាន្ធំ វទថះ ស កិមយំ? តហ៌ីទានីំ កថំ ទ្រឞ្ដុំ ឝក្នោតិ?</para>
  <para style="p">
    <verse number="20" style="v"/>តតស្តស្យ បិតរៅ ប្រត្យវោចតាម៑ អយម៑ អាវយោះ បុត្រ អា ជនេរន្ធឝ្ច តទប្យាវាំ ជានីវះ</para>
  <para style="p">
    <verse number="21" style="v"/>កិន្ត្វធុនា កថំ ទ្ឫឞ្ដិំ ប្រាប្តវាន៑ តទាវាំ ន៑ ជានីវះ កោស្យ ចក្ឞុឞី ប្រសន្នេ ក្ឫតវាន៑ តទបិ ន ជានីវ ឯឞ វយះប្រាប្ត ឯនំ ប្ឫច្ឆត ស្វកថាំ ស្វយំ វក្ឞ្យតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>យិហូទីយានាំ ភយាត៑ តស្យ បិតរៅ វាក្យមិទម៑ អវទតាំ យតះ កោបិ មនុឞ្យោ យទិ យីឝុម៑ អភិឞិក្តំ វទតិ តហ៌ិ ស ភជនគ្ឫហាទ៑ ទូរីការិឞ្យតេ យិហូទីយា ឥតិ មន្ត្រណាម៑ អកុវ៌្វន្</para>
  <para style="p">
    <verse number="23" style="v"/>អតស្តស្យ បិតរៅ វ្យាហរតាម៑ ឯឞ វយះប្រាប្ត ឯនំ ប្ឫច្ឆត។</para>
  <para style="p">
    <verse number="24" style="v"/>តទា តេ បុនឝ្ច តំ បូវ៌្វាន្ធម៑ អាហូយ វ្យាហរន៑ ឦឝ្វរស្យ គុណាន៑ វទ ឯឞ មនុឞ្យះ បាបីតិ វយំ ជានីមះ។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា ស ឧក្ត្តវាន៑ ស បាបី ន វេតិ នាហំ ជានេ បូវ៌ាមន្ធ អាសមហម៑ អធុនា បឝ្យាមីតិ មាត្រំ ជានាមិ។</para>
  <para style="p">
    <verse number="26" style="v"/>តេ បុនរប្ឫច្ឆន៑ ស ត្វាំ ប្រតិ កិមករោត៑? កថំ នេត្រេ ប្រសន្នេ ៜករោត៑?</para>
  <para style="p">
    <verse number="27" style="v"/>តតះ សោវាទីទ៑ ឯកក្ឫត្វោកថយំ យូយំ ន ឝ្ឫណុថ តហ៌ិ កុតះ បុនះ ឝ្រោតុម៑ ឥច្ឆថ? យូយមបិ កិំ តស្យ ឝិឞ្យា ភវិតុម៑ ឥច្ឆថ?</para>
  <para style="p">
    <verse number="28" style="v"/>តទា តេ តំ តិរស្ក្ឫត្យ វ្យាហរន៑ ត្វំ តស្យ ឝិឞ្យោ វយំ មូសាះ ឝិឞ្យាះ។</para>
  <para style="p">
    <verse number="29" style="v"/>មូសាវក្ត្រេណេឝ្វរោ ជគាទ តជ្ជានីមះ កិន្ត្វេឞ កុត្រត្យលោក ឥតិ ន ជានីមះ។</para>
  <para style="p">
    <verse number="30" style="v"/>សោវទទ៑ ឯឞ មម លោចនេ ប្រសន្នេ ៜករោត៑ តថាបិ កុត្រត្យលោក ឥតិ យូយំ ន ជានីថ ឯតទ៑ អាឝ្ចយ៌្យំ ភវតិ។</para>
  <para style="p">
    <verse number="31" style="v"/>ឦឝ្វរះ បាបិនាំ កថាំ ន ឝ្ឫណោតិ កិន្តុ យោ ជនស្តស្មិន៑ ភក្តិំ ក្ឫត្វា តទិឞ្ដក្រិយាំ ករោតិ តស្យៃវ កថាំ ឝ្ឫណោតិ ឯតទ៑ វយំ ជានីមះ។</para>
  <para style="p">
    <verse number="32" style="v"/>កោបិ មនុឞ្យោ ជន្មាន្ធាយ ចក្ឞុឞី អទទាត៑ ជគទារម្ភាទ៑ ឯតាទ្ឫឝីំ កថាំ កោបិ កទាបិ នាឝ្ឫណោត៑។</para>
  <para style="p">
    <verse number="33" style="v"/>អស្មាទ៑ ឯឞ មនុឞ្យោ យទីឝ្វរាន្នាជាយត តហ៌ិ កិញ្ចិទបីទ្ឫឝំ កម៌្ម កត៌្តុំ នាឝក្នោត៑។</para>
  <para style="p">
    <verse number="34" style="v"/>តេ វ្យាហរន៑ ត្វំ បាបាទ៑ អជាយថាះ កិមស្មាន៑ ត្វំ ឝិក្ឞយសិ? បឝ្ចាត្តេ តំ ពហិរកុវ៌្វន៑។</para>
  <para style="p">
    <verse number="35" style="v"/>តទនន្តរំ យិហូទីយៃះ ស ពហិរក្រិយត យីឝុរិតិ វាត៌្តាំ ឝ្រុត្វា តំ សាក្ឞាត៑ ប្រាប្យ ប្ឫឞ្ដវាន៑ ឦឝ្វរស្យ បុត្រេ ត្វំ វិឝ្វសិឞិ?</para>
  <para style="p">
    <verse number="36" style="v"/>តទា ស ប្រត្យវោចត៑ ហេ ប្រភោ ស កោ យត៑ តស្មិន្នហំ វិឝ្វសិមិ?</para>
  <para style="p">
    <verse number="37" style="v"/>តតោ យីឝុះ កថិតវាន៑ ត្វំ តំ ទ្ឫឞ្ដវាន៑ ត្វយា សាកំ យះ កថំ កថយតិ សឯវ សះ។</para>
  <para style="p">
    <verse number="38" style="v"/>តទា ហេ ប្រភោ វិឝ្វសិមីត្យុក្ត្វា ស តំ ប្រណាមត៑។</para>
  <para style="p">
    <verse number="39" style="v"/>បឝ្ចាទ៑ យីឝុះ កថិតវាន៑ នយនហីនា នយនានិ ប្រាប្នុវន្តិ នយនវន្តឝ្ចាន្ធា ភវន្តីត្យភិប្រាយេណ ជគទាហម៑ អាគច្ឆម៑។</para>
  <para style="p">
    <verse number="40" style="v"/>ឯតត៑ ឝ្រុត្វា និកដស្ថាះ កតិបយាះ ផិរូឝិនោ វ្យាហរន៑ វយមបិ កិមន្ធាះ?</para>
  <para style="p">
    <verse number="41" style="v"/>តទា យីឝុរវាទីទ៑ យទ្យន្ធា អភវត តហ៌ិ បាបានិ នាតិឞ្ឋន៑ កិន្តុ បឝ្យាមីតិ វាក្យវទនាទ៑ យុឞ្មាកំ បាបានិ តិឞ្ឋន្តិ។</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អហំ យុឞ្មានតិយថាត៌្ហំ វទាមិ, យោ ជនោ ទ្វារេណ ន ប្រវិឝ្យ កេនាប្យន្យេន មេឞគ្ឫហំ ប្រវិឝតិ ស ឯវ ស្តេនោ ទស្យុឝ្ច។</para>
  <para style="p">
    <verse number="2" style="v"/>យោ ទ្វារេណ ប្រវិឝតិ ស ឯវ មេឞបាលកះ។</para>
  <para style="p">
    <verse number="3" style="v"/>ទៅវារិកស្តស្មៃ ទ្វារំ មោចយតិ មេឞគណឝ្ច តស្យ វាក្យំ ឝ្ឫណោតិ ស និជាន៑ មេឞាន៑ ស្វស្វនាម្នាហូយ ពហិះ ក្ឫត្វា នយតិ។</para>
  <para style="p">
    <verse number="4" style="v"/>តថា និជាន៑ មេឞាន៑ ពហិះ ក្ឫត្វា ស្វយំ តេឞាម៑ អគ្រេ គច្ឆតិ, តតោ មេឞាស្តស្យ ឝព្ទំ ពុធ្យន្តេ, តស្មាត៑ តស្យ បឝ្ចាទ៑ វ្រជន្តិ។</para>
  <para style="p">
    <verse number="5" style="v"/>កិន្តុ បរស្យ ឝព្ទំ ន ពុធ្យន្តេ តស្មាត៑ តស្យ បឝ្ចាទ៑ វ្រជិឞ្យន្តិ វរំ តស្យ សមីបាត៑ បលាយិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="6" style="v"/>យីឝុស្តេភ្យ ឥមាំ ទ្ឫឞ្ដាន្តកថាម៑ អកថយត៑ កិន្តុ តេន កថិតកថាយាស្តាត្បយ៌្យំ តេ នាពុធ្យន្ត។</para>
  <para style="p">
    <verse number="7" style="v"/>អតោ យីឝុះ បុនរកថយត៑, យុឞ្មានាហំ យថាត៌្ហតរំ វ្យាហរាមិ, មេឞគ្ឫហស្យ ទ្វារម៑ អហមេវ។</para>
  <para style="p">
    <verse number="8" style="v"/>មយា ន ប្រវិឝ្យ យ អាគច្ឆន៑ តេ ស្តេនា ទស្យវឝ្ច កិន្តុ មេឞាស្តេឞាំ កថា នាឝ្ឫណ្វន៑។</para>
  <para style="p">
    <verse number="9" style="v"/>អហមេវ ទ្វារស្វរូបះ, មយា យះ កឝ្ចិត ប្រវិឝតិ ស រក្ឞាំ ប្រាប្ស្យតិ តថា ពហិរន្តឝ្ច គមនាគមនេ ក្ឫត្វា ចរណស្ថានំ ប្រាប្ស្យតិ។</para>
  <para style="p">
    <verse number="10" style="v"/>យោ ជនស្តេនះ ស កេវលំ ស្តៃន្យពធវិនាឝាន៑ កត៌្តុមេវ សមាយាតិ កិន្ត្វហម៑ អាយុ រ្ទាតុម៑ អត៌្ហាត៑ ពាហូល្យេន តទេវ ទាតុម៑ អាគច្ឆម៑។</para>
  <para style="p">
    <verse number="11" style="v"/>អហមេវ សត្យមេឞបាលកោ យស្តុ សត្យោ មេឞបាលកះ ស មេឞាត៌្ហំ ប្រាណត្យាគំ ករោតិ;</para>
  <para style="p">
    <verse number="12" style="v"/>កិន្តុ យោ ជនោ មេឞបាលកោ ន, អត៌្ហាទ៑ យស្យ មេឞា និជា ន ភវន្តិ, យ ឯតាទ្ឫឝោ វៃតនិកះ ស វ្ឫកម៑ អាគច្ឆន្តំ ទ្ឫឞ្ដ្វា មេជវ្រជំ វិហាយ បលាយតេ, តស្មាទ៑ វ្ឫកស្តំ វ្រជំ ធ្ឫត្វា វិកិរតិ។</para>
  <para style="p">
    <verse number="13" style="v"/>វៃតនិកះ បលាយតេ យតះ ស វេតនាត៌្ហី មេឞាត៌្ហំ ន ចិន្តយតិ។</para>
  <para style="p">
    <verse number="14" style="v"/>អហមេវ សត្យោ មេឞបាលកះ, បិតា មាំ យថា ជានាតិ, អហញ្ច យថា បិតរំ ជានាមិ,</para>
  <para style="p">
    <verse number="15" style="v"/>តថា និជាន៑ មេឞានបិ ជានាមិ, មេឞាឝ្ច មាំ ជានាន្តិ, អហញ្ច មេឞាត៌្ហំ ប្រាណត្យាគំ ករោមិ។</para>
  <para style="p">
    <verse number="16" style="v"/>អបរញ្ច ឯតទ៑ គ្ឫហីយ មេឞេភ្យោ ភិន្នា អបិ មេឞា មម សន្តិ តេ សកលា អានយិតវ្យាះ; តេ មម ឝព្ទំ ឝ្រោឞ្យន្តិ តត ឯកោ វ្រជ ឯកោ រក្ឞកោ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="17" style="v"/>ប្រាណានហំ ត្យក្ត្វា បុនះ ប្រាណាន៑ គ្រហីឞ្យាមិ, តស្មាត៑ បិតា មយិ ស្នេហំ ករោតិ។</para>
  <para style="p">
    <verse number="18" style="v"/>កឝ្ចិជ្ជនោ មម ប្រាណាន៑ ហន្តុំ ន ឝក្នោតិ កិន្តុ ស្វយំ តាន៑ សមប៌យាមិ តាន៑ សមប៌យិតុំ បុនគ៌្រហីតុញ្ច មម ឝក្តិរាស្តេ ភារមិមំ ស្វបិតុះ សកាឝាត៑ ប្រាប្តោហម៑។</para>
  <para style="p">
    <verse number="19" style="v"/>អស្មាទុបទេឝាត៑ បុនឝ្ច យិហូទីយានាំ មធ្យេ ភិន្នវាក្យតា ជាតា។</para>
  <para style="p">
    <verse number="20" style="v"/>តតោ ពហវោ វ្យាហរន៑ ឯឞ ភូតគ្រស្ត ឧន្មត្តឝ្ច, កុត ឯតស្យ កថាំ ឝ្ឫណុថ?</para>
  <para style="p">
    <verse number="21" style="v"/>កេចិទ៑ អវទន៑ ឯតស្យ កថា ភូតគ្រស្តស្យ កថាវន្ន ភវន្តិ, ភូតះ កិម៑ អន្ធាយ ចក្ឞុឞី ទាតុំ ឝក្នោតិ?</para>
  <para style="p">
    <verse number="22" style="v"/>ឝីតកាលេ យិរូឝាលមិ មន្ទិរោត្សគ៌បវ៌្វណ្យុបស្ថិតេ</para>
  <para style="p">
    <verse number="23" style="v"/>យីឝុះ សុលេមានោ និះសារេណ គមនាគមនេ ករោតិ,</para>
  <para style="p">
    <verse number="24" style="v"/>ឯតស្មិន៑ សមយេ យិហូទីយាស្តំ វេឞ្ដយិត្វា វ្យាហរន៑ កតិ កាលាន៑ អស្មាកំ វិចិកិត្សាំ ស្ថាបយិឞ្យាមិ? យទ្យភិឞិក្តោ ភវតិ តហ៌ិ តត៑ ស្បឞ្ដំ វទ។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា យីឝុះ ប្រត្យវទទ៑ អហម៑ អចកថំ កិន្តុ យូយំ ន ប្រតីថ, និជបិតុ រ្នាម្នា យាំ យាំ ក្រិយាំ ករោមិ សា ក្រិយៃវ មម សាក្ឞិស្វរូបា។</para>
  <para style="p">
    <verse number="26" style="v"/>កិន្ត្វហំ បូវ៌្វមកថយំ យូយំ មម មេឞា ន ភវថ, ការណាទស្មាន៑ ន វិឝ្វសិថ។</para>
  <para style="p">
    <verse number="27" style="v"/>មម មេឞា មម ឝព្ទំ ឝ្ឫណ្វន្តិ តានហំ ជានាមិ តេ ច មម បឝ្ចាទ៑ គច្ឆន្តិ។</para>
  <para style="p">
    <verse number="28" style="v"/>អហំ តេភ្យោៜនន្តាយុ រ្ទទាមិ, តេ កទាបិ ន នំក្ឞ្យន្តិ កោបិ មម ករាត៑ តាន៑ ហត៌្តុំ ន ឝក្ឞ្យតិ។</para>
  <para style="p">
    <verse number="29" style="v"/>យោ មម បិតា តាន៑ មហ្យំ ទត្តវាន៑ ស សវ៌្វស្មាត៑ មហាន៑, កោបិ មម បិតុះ ករាត៑ តាន៑ ហត៌្តុំ ន ឝក្ឞ្យតិ។</para>
  <para style="p">
    <verse number="30" style="v"/>អហំ បិតា ច ទ្វយោរេកត្វម៑។</para>
  <para style="p">
    <verse number="31" style="v"/>តតោ យិហូទីយាះ បុនរបិ តំ ហន្តុំ បាឞាណាន៑ ឧទតោលយន៑។</para>
  <para style="p">
    <verse number="32" style="v"/>យីឝុះ កថិតវាន៑ បិតុះ សកាឝាទ៑ ពហូន្យុត្តមកម៌្មាណិ យុឞ្មាកំ ប្រាកាឝយំ តេឞាំ កស្យ កម៌្មណះ ការណាន៑ មាំ បាឞាណៃរាហន្តុម៑ ឧទ្យតាះ ស្ថ?</para>
  <para style="p">
    <verse number="33" style="v"/>យិហូទីយាះ ប្រត្យវទន៑ ប្រឝស្តកម៌្មហេតោ រ្ន កិន្តុ ត្វំ មានុឞះ ស្វមីឝ្វរម៑ ឧក្ត្វេឝ្វរំ និន្ទសិ ការណាទស្មាត៑ ត្វាំ បាឞាណៃហ៌ន្មះ។</para>
  <para style="p">
    <verse number="34" style="v"/>តទា យីឝុះ ប្រត្យុក្តវាន៑ មយា កថិតំ យូយម៑ ឦឝ្វរា ឯតទ្វចនំ យុឞ្មាកំ ឝាស្ត្រេ លិខិតំ នាស្តិ កិំ?</para>
  <para style="p">
    <verse number="35" style="v"/>តស្មាទ៑ យេឞាម៑ ឧទ្ទេឝេ ឦឝ្វរស្យ កថា កថិតា តេ យទីឝ្វរគណា ឧច្យន្តេ ធម៌្មគ្រន្ថស្យាប្យន្យថា ភវិតុំ ន ឝក្យំ,</para>
  <para style="p">
    <verse number="36" style="v"/>តហ៌្យាហម៑ ឦឝ្វរស្យ បុត្រ ឥតិ វាក្យស្យ កថនាត៑ យូយំ បិត្រាភិឞិក្តំ ជគតិ ប្រេរិតញ្ច បុមាំសំ កថម៑ ឦឝ្វរនិន្ទកំ វាទយ?</para>
  <para style="p">
    <verse number="37" style="v"/>យទ្យហំ បិតុះ កម៌្ម ន ករោមិ តហ៌ិ មាំ ន ប្រតីត;</para>
  <para style="p">
    <verse number="38" style="v"/>កិន្តុ យទិ ករោមិ តហ៌ិ មយិ យុឞ្មាភិះ ប្រត្យយេ ន ក្ឫតេៜបិ កាយ៌្យេ ប្រត្យយះ ក្រិយតាំ, តតោ មយិ បិតាស្តីតិ បិតយ៌្យហម៑ អស្មីតិ ច ក្ឞាត្វា វិឝ្វសិឞ្យថ។</para>
  <para style="p">
    <verse number="39" style="v"/>តទា តេ បុនរបិ តំ ធត៌្តុម៑ អចេឞ្ដន្ត កិន្តុ ស តេឞាំ ករេភ្យោ និស្តីយ៌្យ</para>
  <para style="p">
    <verse number="40" style="v"/>បុន រ្យទ៌្ទន៑ អទ្យាស្តដេ យត្រ បុវ៌្វំ យោហន៑ អមជ្ជយត៑ តត្រាគត្យ ន្យវសត៑។</para>
  <para style="p">
    <verse number="41" style="v"/>តតោ ពហវោ លោកាស្តត្សមីបម៑ អាគត្យ វ្យាហរន៑ យោហន៑ កិមប្យាឝ្ចយ៌្យំ កម៌្ម នាករោត៑ កិន្ត្វស្មិន៑ មនុឞ្យេ យា យះ កថា អកថយត៑ តាះ សវ៌្វាះ សត្យាះ;</para>
  <para style="p">
    <verse number="42" style="v"/>តត្រ ច ពហវោ លោកាស្តស្មិន៑ វ្យឝ្វសន៑។</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ មរិយម៑ តស្យា ភគិនី មត៌្ហា ច យស្មិន៑ វៃថនីយាគ្រាមេ វសតស្តស្មិន៑ គ្រាមេ ឥលិយាសរ៑ នាមា បីឌិត ឯក អាសីត៑។</para>
  <para style="p">
    <verse number="2" style="v"/>យា មរិយម៑ ប្រភុំ សុគន្ធិតេលៃន មទ៌្ទយិត្វា ស្វកេឝៃស្តស្យ ចរណៅ សមមាជ៌ត៑ តស្យា ភ្រាតា ស ឥលិយាសរ៑ រោគី។</para>
  <para style="p">
    <verse number="3" style="v"/>អបរញ្ច ហេ ប្រភោ ភវាន៑ យស្មិន៑ ប្រីយតេ ស ឯវ បីឌិតោស្តីតិ កថាំ កថយិត្វា តស្យ ភគិន្យៅ ប្រេឞិតវត្យៅ។</para>
  <para style="p">
    <verse number="4" style="v"/>តទា យីឝុរិមាំ វាត៌្តាំ ឝ្រុត្វាកថយត បីឌេយំ មរណាត៌្ហំ ន កិន្ត្វីឝ្វរស្យ មហិមាត៌្ហម៑ ឦឝ្វរបុត្រស្យ មហិមប្រកាឝាត៌្ហញ្ច ជាតា។</para>
  <para style="p">
    <verse number="5" style="v"/>យីឝុ រ្យទ្យបិមត៌្ហាយាំ តទ្ភគិន្យាម៑ ឥលិយាសរិ ចាប្រីយត,</para>
  <para style="p">
    <verse number="6" style="v"/>តថាបិ ឥលិយាសរះ បីឌាយាះ កថំ ឝ្រុត្វា យត្រ អាសីត៑ តត្រៃវ ទិនទ្វយមតិឞ្ឋត៑។</para>
  <para style="p">
    <verse number="7" style="v"/>តតះ បរម៑ ស ឝិឞ្យានកថយទ៑ វយំ បុន រ្យិហូទីយប្រទេឝំ យាមះ។</para>
  <para style="p">
    <verse number="8" style="v"/>តតស្តេ ប្រត្យវទន៑, ហេ គុរោ ស្វល្បទិនានិ គតានិ យិហូទីយាស្ត្វាំ បាឞាណៃ រ្ហន្តុម៑ ឧទ្យតាស្តថាបិ កិំ បុនស្តត្រ យាស្យសិ?</para>
  <para style="p">
    <verse number="9" style="v"/>យីឝុះ ប្រត្យវទត៑, ឯកស្មិន៑ ទិនេ កិំ ទ្វាទឝឃដិកា ន ភវន្តិ? កោបិ ទិវា គច្ឆន៑ ន ស្ខលតិ យតះ ស ឯតជ្ជគតោ ទីប្តិំ ប្រាប្នោតិ។</para>
  <para style="p">
    <verse number="10" style="v"/>កិន្តុ រាត្រៅ គច្ឆន៑ ស្ខលតិ យតោ ហេតោស្តត្រ ទីប្តិ រ្នាស្តិ។</para>
  <para style="p">
    <verse number="11" style="v"/>ឥមាំ កថាំ កថយិត្វា ស តានវទទ៑, អស្មាកំ ពន្ធុះ ឥលិយាសរ៑ និទ្រិតោភូទ៑ ឥទានីំ តំ និទ្រាតោ ជាគរយិតុំ គច្ឆាមិ។</para>
  <para style="p">
    <verse number="12" style="v"/>យីឝុ រ្ម្ឫតៅ កថាមិមាំ កថិតវាន៑ កិន្តុ វិឝ្រាមាត៌្ហំ និទ្រាយាំ កថិតវាន៑ ឥតិ ជ្ញាត្វា ឝិឞ្យា អកថយន៑,</para>
  <para style="p">
    <verse number="13" style="v"/>ហេ គុរោ ស យទិ និទ្រាតិ តហ៌ិ ភទ្រមេវ។</para>
  <para style="p">
    <verse number="14" style="v"/>តទា យីឝុះ ស្បឞ្ដំ តាន៑ វ្យាហរត៑, ឥលិយាសរ៑ អម្រិយត;</para>
  <para style="p">
    <verse number="15" style="v"/>កិន្តុ យូយំ យថា ប្រតីថ តទត៌្ហមហំ តត្រ ន ស្ថិតវាន៑ ឥត្យស្មាទ៑ យុឞ្មន្និមិត្តម៑ អាហ្លាទិតោហំ, តថាបិ តស្យ សមីបេ យាម។</para>
  <para style="p">
    <verse number="16" style="v"/>តទា ថោមា យំ ទិទុមំ វទន្តិ ស សង្គិនះ ឝិឞ្យាន៑ អវទទ៑ វយមបិ គត្វា តេន សាទ៌្ធំ ម្រិយាមហៃ។</para>
  <para style="p">
    <verse number="17" style="v"/>យីឝុស្តត្រោបស្ថាយ ឥលិយាសរះ ឝ្មឝានេ ស្ថាបនាត៑ ចត្វារិ ទិនានិ គតានីតិ វាត៌្តាំ ឝ្រុតវាន៑។</para>
  <para style="p">
    <verse number="18" style="v"/>វៃថនីយា យិរូឝាលមះ សមីបស្ថា ក្រោឝៃកមាត្រាន្តរិតា;</para>
  <para style="p">
    <verse number="19" style="v"/>តស្មាទ៑ ពហវោ យិហូទីយា មត៌្ហាំ មរិយមញ្ច ភ្យាត្ឫឝោកាបន្នាំ សាន្ត្វយិតុំ តយោះ សមីបម៑ អាគច្ឆន៑។</para>
  <para style="p">
    <verse number="20" style="v"/>មត៌្ហា យីឝោរាគមនវាត៌ាំ ឝ្រុត្វៃវ តំ សាក្ឞាទ៑ អករោត៑ កិន្តុ មរិយម៑ គេហ ឧបវិឝ្យ ស្ថិតា។</para>
  <para style="p">
    <verse number="21" style="v"/>តទា មត៌្ហា យីឝុមវាទត៑, ហេ ប្រភោ យទិ ភវាន៑ អត្រាស្ថាស្យត៑ តហ៌ិ មម ភ្រាតា នាមរិឞ្យត៑។</para>
  <para style="p">
    <verse number="22" style="v"/>កិន្ត្វិទានីមបិ យទ៑ ឦឝ្វរេ ប្រាត៌្ហយិឞ្យតេ ឦឝ្វរស្តទ៑ ទាស្យតីតិ ជានេៜហំ។</para>
  <para style="p">
    <verse number="23" style="v"/>យីឝុរវាទីត៑ តវ ភ្រាតា សមុត្ថាស្យតិ។</para>
  <para style="p">
    <verse number="24" style="v"/>មត៌្ហា វ្យាហរត៑ ឝេឞទិវសេ ស ឧត្ថានសមយេ ប្រោត្ថាស្យតីតិ ជានេៜហំ។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា យីឝុះ កថិតវាន៑ អហមេវ ឧត្ថាបយិតា ជីវយិតា ច យះ កឝ្ចន មយិ វិឝ្វសិតិ ស ម្ឫត្វាបិ ជីវិឞ្យតិ;</para>
  <para style="p">
    <verse number="26" style="v"/>យះ កឝ្ចន ច ជីវន៑ មយិ វិឝ្វសិតិ ស កទាបិ ន មរិឞ្យតិ, អស្យាំ កថាយាំ កិំ វិឝ្វសិឞិ?</para>
  <para style="p">
    <verse number="27" style="v"/>សាវទត៑ ប្រភោ យស្យាវតរណាបេក្ឞាស្តិ ភវាន៑ សឯវាភិឞិក្ត្ត ឦឝ្វរបុត្រ ឥតិ វិឝ្វសិមិ។</para>
  <para style="p">
    <verse number="28" style="v"/>ឥតិ កថាំ កថយិត្វា សា គត្វា ស្វាំ ភគិនីំ មរិយមំ គុប្តមាហូយ វ្យាហរត៑ គុរុរុបតិឞ្ឋតិ ត្វាមាហូយតិ ច។</para>
  <para style="p">
    <verse number="29" style="v"/>កថាមិមាំ ឝ្រុត្វា សា តូណ៌ម៑ ឧត្ថាយ តស្យ សមីបម៑ អគច្ឆត៑។</para>
  <para style="p">
    <verse number="30" style="v"/>យីឝុ រ្គ្រាមមធ្យំ ន ប្រវិឝ្យ យត្រ មត៌្ហា តំ សាក្ឞាទ៑ អករោត៑ តត្រ ស្ថិតវាន៑។</para>
  <para style="p">
    <verse number="31" style="v"/>យេ យិហូទីយា មរិយមា សាកំ គ្ឫហេ តិឞ្ឋន្តស្តាម៑ អសាន្ត្វយន តេ តាំ ក្ឞិប្រម៑ ឧត្ថាយ គច្ឆន្តិំ វិលោក្យ វ្យាហរន៑, ស ឝ្មឝានេ រោទិតុំ យាតិ, ឥត្យុក្ត្វា តេ តស្យាះ បឝ្ចាទ៑ អគច្ឆន៑។</para>
  <para style="p">
    <verse number="32" style="v"/>យត្រ យីឝុរតិឞ្ឋត៑ តត្រ មរិយម៑ ឧបស្ថាយ តំ ទ្ឫឞ្ដ្វា តស្យ ចរណយោះ បតិត្វា វ្យាហរត៑ ហេ ប្រភោ យទិ ភវាន៑ អត្រាស្ថាស្យត៑ តហ៌ិ មម ភ្រាតា នាមរិឞ្យត៑។</para>
  <para style="p">
    <verse number="33" style="v"/>យីឝុស្តាំ តស្យាះ សង្គិនោ យិហូទីយាំឝ្ច រុទតោ វិលោក្យ ឝោកាត៌្តះ សន៑ ទីគ៌្ហំ និឝ្វស្យ កថិតវាន៑ តំ កុត្រាស្ថាបយត?</para>
  <para style="p">
    <verse number="34" style="v"/>តេ វ្យាហរន៑, ហេ ប្រភោ ភវាន៑ អាគត្យ បឝ្យតុ។</para>
  <para style="p">
    <verse number="35" style="v"/>យីឝុនា ក្រន្ទិតំ។</para>
  <para style="p">
    <verse number="36" style="v"/>អតឯវ យិហូទីយា អវទន៑, បឝ្យតាយំ តស្មិន៑ កិទ្ឫគ៑ អប្រិយត។</para>
  <para style="p">
    <verse number="37" style="v"/>តេឞាំ កេចិទ៑ អវទន៑ យោន្ធាយ ចក្ឞុឞី ទត្តវាន៑ ស កិម៑ អស្យ ម្ឫត្យុំ និវារយិតុំ នាឝក្នោត៑?</para>
  <para style="p">
    <verse number="38" style="v"/>តតោ យីឝុះ បុនរន្តទ៌ីគ៌្ហំ និឝ្វស្យ ឝ្មឝានាន្តិកម៑ អគច្ឆត៑។ តត៑ ឝ្មឝានម៑ ឯកំ គហ្វរំ តន្មុខេ បាឞាណ ឯក អាសីត៑។</para>
  <para style="p">
    <verse number="39" style="v"/>តទា យីឝុរវទទ៑ ឯនំ បាឞាណម៑ អបសារយត, តតះ ប្រមីតស្យ ភគិនី មត៌្ហាវទត៑ ប្រភោ, អធុនា តត្រ ទុគ៌ន្ធោ ជាតះ, យតោទ្យ ចត្វារិ ទិនានិ ឝ្មឝានេ ស តិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="40" style="v"/>តទា យីឝុរវាទីត៑, យទិ វិឝ្វសិឞិ តហ៌ីឝ្វរស្យ មហិមប្រកាឝំ ទ្រក្ឞ្យសិ កថាមិមាំ កិំ តុភ្យំ នាកថយំ?</para>
  <para style="p">
    <verse number="41" style="v"/>តទា ម្ឫតស្យ ឝ្មឝានាត៑ បាឞាណោៜបសារិតេ យីឝុរូទ៌្វ្វំ បឝ្យន៑ អកថយត៑, ហេ បិត រ្មម នេវេសនម៑ អឝ្ឫណោះ ការណាទស្មាត៑ ត្វាំ ធន្យំ វទាមិ។</para>
  <para style="p">
    <verse number="42" style="v"/>ត្វំ សតតំ ឝ្ឫណោឞិ តទប្យហំ ជានាមិ, កិន្តុ ត្វំ មាំ យត៑ ប្រៃរយស្តទ៑ យថាស្មិន៑ ស្ថានេ ស្ថិតា លោកា វិឝ្វសន្តិ តទត៌្ហម៑ ឥទំ វាក្យំ វទាមិ។</para>
  <para style="p">
    <verse number="43" style="v"/>ឥមាំ កថាំ កថយិត្វា ស ប្រោច្ចៃរាហ្វយត៑, ហេ ឥលិយាសរ៑ ពហិរាគច្ឆ។</para>
  <para style="p">
    <verse number="44" style="v"/>តតះ ស ប្រមីតះ ឝ្មឝានវស្ត្រៃ រ្ពទ្ធហស្តបាទោ គាត្រមាជ៌នវាសសា ពទ្ធមុខឝ្ច ពហិរាគច្ឆត៑។ យីឝុរុទិតវាន៑ ពន្ធនានិ មោចយិត្វា ត្យជតៃនំ។</para>
  <para style="p">
    <verse number="45" style="v"/>មរិយមះ សមីបម៑ អាគតា យេ យិហូទីយលោកាស្តទា យីឝោរេតត៑ កម៌្មាបឝ្យន៑ តេឞាំ ពហវោ វ្យឝ្វសន៑,</para>
  <para style="p">
    <verse number="46" style="v"/>កិន្តុ កេចិទន្យេ ផិរូឝិនាំ សមីបំ គត្វា យីឝោរេតស្យ កម៌្មណោ វាត៌្តាម៑ អវទន៑។</para>
  <para style="p">
    <verse number="47" style="v"/>តតះ បរំ ប្រធានយាជកាះ ផិរូឝិនាឝ្ច សភាំ ក្ឫត្វា វ្យាហរន៑ វយំ កិំ កុម៌្មះ? ឯឞ មានវោ ពហូន្យាឝ្ចយ៌្យកម៌្មាណិ ករោតិ។</para>
  <para style="p">
    <verse number="48" style="v"/>យទីទ្ឫឝំ កម៌្ម កត៌្តុំ ន វារយាមស្តហ៌ិ សវ៌្វេ លោកាស្តស្មិន៑ វិឝ្វសិឞ្យន្តិ រោមិលោកាឝ្ចាគត្យាស្មាកម៑ អនយា រាជធាន្យា សាទ៌្ធំ រាជ្យម៑ អាឆេត្ស្យន្តិ។</para>
  <para style="p">
    <verse number="49" style="v"/>តទា តេឞាំ កិយផានាមា យស្តស្មិន៑ វត្សរេ មហាយាជកបទេ ន្យយុជ្យត ស ប្រត្យវទទ៑ យូយំ កិមបិ ន ជានីថ;</para>
  <para style="p">
    <verse number="50" style="v"/>សមគ្រទេឝស្យ វិនាឝតោបិ សវ៌្វលោកាត៌្ហម៑ ឯកស្យ ជនស្យ មរណម៑ អស្មាកំ មង្គលហេតុកម៑ ឯតស្យ វិវេចនាមបិ ន កុរុថ។</para>
  <para style="p">
    <verse number="51" style="v"/>ឯតាំ កថាំ ស និជពុទ្ធ្យា វ្យាហរទ៑ ឥតិ ន,</para>
  <para style="p">
    <verse number="52" style="v"/>កិន្តុ យីឝូស្តទ្ទេឝីយានាំ ការណាត៑ ប្រាណាន៑ ត្យក្ឞ្យតិ, ទិឝិ ទិឝិ វិកីណ៌ាន៑ ឦឝ្វរស្យ សន្តានាន៑ សំគ្ឫហ្យៃកជាតិំ ករិឞ្យតិ ច, តស្មិន៑ វត្សរេ កិយផា មហាយាជកត្វបទេ និយុក្តះ សន៑ ឥទំ ភវិឞ្យទ្វាក្យំ កថិតវាន៑។</para>
  <para style="p">
    <verse number="53" style="v"/>តទ្ទិនមារភ្យ តេ កថំ តំ ហន្តុំ ឝក្នុវន្តីតិ មន្ត្រណាំ កត៌្តុំ ប្រារេភិរេ។</para>
  <para style="p">
    <verse number="54" style="v"/>អតឯវ យិហូទីយានាំ មធ្យេ យីឝុះ សប្រកាឝំ គមនាគមនេ អក្ឫត្វា តស្មាទ៑ គត្វា ប្រាន្តរស្យ សមីបស្ថាយិប្រទេឝស្យេផ្រាយិម៑ នាម្និ នគរេ ឝិឞ្យៃះ សាកំ កាលំ យាបយិតុំ ប្រារេភេ។</para>
  <para style="p">
    <verse number="55" style="v"/>អនន្តរំ យិហូទីយានាំ និស្តារោត្សវេ និកដវត៌្តិនិ សតិ តទុត្សវាត៑ បូវ៌្វំ ស្វាន៑ ឝុចីន៑ កត៌្តុំ ពហវោ ជនា គ្រាមេភ្យោ យិរូឝាលម៑ នគរម៑ អាគច្ឆន៑,</para>
  <para style="p">
    <verse number="56" style="v"/>យីឝោរន្វេឞណំ ក្ឫត្វា មន្ទិរេ ទណ្ឌាយមានាះ សន្តះ បរស្បរំ វ្យាហរន៑, យុឞ្មាកំ កីទ្ឫឝោ ពោធោ ជាយតេ? ស កិម៑ ឧត្សវេៜស្មិន៑ អត្រាគមិឞ្យតិ?</para>
  <para style="p">
    <verse number="57" style="v"/>ស ច កុត្រាស្តិ យទ្យេតត៑ កឝ្ចិទ៑ វេត្តិ តហ៌ិ ទឝ៌យតុ ប្រធានយាជកាះ ផិរូឝិនឝ្ច តំ ធត៌្តុំ បូវ៌្វម៑ ឥមាម៑ អាជ្ញាំ ប្រាចារយន៑។</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>និស្តារោត្សវាត៑ បូវ៌្វំ ទិនឞដ្កេ ស្ថិតេ យីឝុ រ្យំ ប្រមីតម៑ ឥលិយាសរំ ឝ្មឝានាទ៑ ឧទស្ថាបរត៑ តស្យ និវាសស្ថានំ ពៃថនិយាគ្រាមម៑ អាគច្ឆត៑។</para>
  <para style="p">
    <verse number="2" style="v"/>តត្រ តទត៌្ហំ រជន្យាំ ភោជ្យេ ក្ឫតេ មត៌្ហា បយ៌្យវេឞយទ៑ ឥលិយាសរ៑ ច តស្យ សង្គិភិះ សាទ៌្ធំ ភោជនាសន ឧបាវិឝត៑។</para>
  <para style="p">
    <verse number="3" style="v"/>តទា មរិយម៑ អទ៌្ធសេដកំ ពហុមូល្យំ ជដាមាំសីយំ តៃលម៑ អានីយ យីឝោឝ្ចរណយោ រ្មទ៌្ទយិត្វា និជកេឝ រ្មាឞ៌្ដុម៑ អារភត; តទា តៃលស្យ បរិមលេន គ្ឫហម៑ អាមោទិតម៑ អភវត៑។</para>
  <para style="p">
    <verse number="4" style="v"/>យះ ឝិមោនះ បុត្រ រិឞ្ករិយោតីយោ យិហូទានាមា យីឝុំ បរករេឞុ សមប៌យិឞ្យតិ ស ឝិឞ្យស្តទា កថិតវាន៑,</para>
  <para style="p">
    <verse number="5" style="v"/>ឯតត្តៃលំ ត្រិភិះ ឝតៃ រ្មុទ្រាបទៃ រ្វិក្រីតំ សទ៑ ទរិទ្រេភ្យះ កុតោ នាទីយត?</para>
  <para style="p">
    <verse number="6" style="v"/>ស ទរិទ្រលោកាត៌្ហម៑ អចិន្តយទ៑ ឥតិ ន, កិន្តុ ស ចៅរ ឯវំ តន្និកដេ មុទ្រាសម្បុដកស្ថិត្យា តន្មធ្យេ យទតិឞ្ឋត៑ តទបាហរត៑ តស្មាត៑ ការណាទ៑ ឥមាំ កថាមកថយត៑។</para>
  <para style="p">
    <verse number="7" style="v"/>តទា យីឝុរកថយទ៑ ឯនាំ មា វារយ សា មម ឝ្មឝានស្ថាបនទិនាត៌្ហំ តទរក្ឞយត៑។</para>
  <para style="p">
    <verse number="8" style="v"/>ទរិទ្រា យុឞ្មាកំ សន្និធៅ សវ៌្វទា តិឞ្ឋន្តិ កិន្ត្វហំ សវ៌្វទា យុឞ្មាកំ សន្និធៅ ន តិឞ្ឋាមិ។</para>
  <para style="p">
    <verse number="9" style="v"/>តតះ បរំ យីឝុស្តត្រាស្តីតិ វាត៌្តាំ ឝ្រុត្វា ពហវោ យិហូទីយាស្តំ ឝ្មឝានាទុត្ថាបិតម៑ ឥលិយាសរញ្ច ទ្រឞ្ដុំ តត៑ ស្ថានម៑ អាគច្ឆន។</para>
  <para style="p">
    <verse number="10" style="v"/>តទា ប្រធានយាជកាស្តម៑ ឥលិយាសរមបិ សំហត៌្តុម៑ អមន្ត្រយន៑ ;</para>
  <para style="p">
    <verse number="11" style="v"/>យតស្តេន ពហវោ យិហូទីយា គត្វា យីឝៅ វ្យឝ្វសន៑។</para>
  <para style="p">
    <verse number="12" style="v"/>អនន្តរំ យីឝុ រ្យិរូឝាលម៑ នគរម៑ អាគច្ឆតីតិ វាត៌្តាំ ឝ្រុត្វា បរេៜហនិ ឧត្សវាគតា ពហវោ លោកាះ</para>
  <para style="p">
    <verse number="13" style="v"/>ខជ៌្ជូរបត្រាទ្យានីយ តំ សាក្ឞាត៑ កត៌្តុំ ពហិរាគត្យ ជយ ជយេតិ វាចំ ប្រោច្ចៃ រ្វក្តុម៑ អារភន្ត, ឥស្រាយេលោ យោ រាជា បរមេឝ្វរស្យ នាម្នាគច្ឆតិ ស ធន្យះ។</para>
  <para style="p">
    <verse number="14" style="v"/>តទា "ហេ សិយោនះ កន្យេ មា ភៃឞីះ បឝ្យាយំ តវ រាជា គទ៌្ទភឝាវកម៑ អារុហ្យាគច្ឆតិ"</para>
  <para style="p">
    <verse number="15" style="v"/>ឥតិ ឝាស្ត្រីយវចនានុសារេណ យីឝុរេកំ យុវគទ៌្ទភំ ប្រាប្យ តទុបយ៌្យារោហត៑។</para>
  <para style="p">
    <verse number="16" style="v"/>អស្យាះ ឃដនាយាស្តាត្បយ៌្យំ ឝិឞ្យាះ ប្រថមំ នាពុធ្យន្ត, កិន្តុ យីឝៅ មហិមានំ ប្រាប្តេ សតិ វាក្យមិទំ តស្មិន អកថ្យត លោកាឝ្ច តម្ប្រតីត្ថម៑ អកុវ៌្វន៑ ឥតិ តេ ស្ម្ឫតវន្តះ។</para>
  <para style="p">
    <verse number="17" style="v"/>ស ឥលិយាសរំ ឝ្មឝានាទ៑ អាគន្តុម៑ អាហ្វតវាន៑ ឝ្មឝានាញ្ច ឧទស្ថាបយទ៑ យេ យេ លោកាស្តត្កម៌្យ សាក្ឞាទ៑ អបឝ្យន៑ តេ ប្រមាណំ ទាតុម៑ អារភន្ត។</para>
  <para style="p">
    <verse number="18" style="v"/>ស ឯតាទ្ឫឝម៑ អទ្ភុតំ កម៌្មករោត៑ តស្យ ជនឝ្រុតេ រ្លោកាស្តំ សាក្ឞាត៑ កត៌្តុម៑ អាគច្ឆន៑។</para>
  <para style="p">
    <verse number="19" style="v"/>តតះ ផិរូឝិនះ បរស្បរំ វក្តុម៑ អារភន្ត យុឞ្មាកំ សវ៌្វាឝ្ចេឞ្ដា វ្ឫថា ជាតាះ, ឥតិ កិំ យូយំ ន ពុធ្យធ្វេ? បឝ្យត សវ៌្វេ លោកាស្តស្យ បឝ្ចាទ្វត៌្តិនោភវន៑។</para>
  <para style="p">
    <verse number="20" style="v"/>ភជនំ កត៌្តុម៑ ឧត្សវាគតានាំ លោកានាំ កតិបយា ជនា អន្យទេឝីយា អាសន៑ ,</para>
  <para style="p">
    <verse number="21" style="v"/>តេ គាលីលីយពៃត្សៃទានិវាសិនះ ផិលិបស្យ សមីបម៑ អាគត្យ វ្យាហរន៑ ហេ មហេច្ឆ វយំ យីឝុំ ទ្រឞ្ដុម៑ ឥច្ឆាមះ។</para>
  <para style="p">
    <verse number="22" style="v"/>តតះ ផិលិបោ គត្វា អាន្ទ្រិយម៑ អវទត៑ បឝ្ចាទ៑ អាន្ទ្រិយផិលិបៅ យីឝវេ វាត៌្តាម៑ អកថយតាំ។</para>
  <para style="p">
    <verse number="23" style="v"/>តទា យីឝុះ ប្រត្យុទិតវាន៑ មានវសុតស្យ មហិមប្រាប្តិសមយ ឧបស្ថិតះ។</para>
  <para style="p">
    <verse number="24" style="v"/>អហំ យុឞ្មានតិយថាត៌្ហំ វទាមិ, ធាន្យពីជំ ម្ឫត្តិកាយាំ បតិត្វា យទិ ន ម្ឫយតេ តហ៌្យេកាកី តិឞ្ឋតិ កិន្តុ យទិ ម្ឫយតេ តហ៌ិ ពហុគុណំ ផលំ ផលតិ។</para>
  <para style="p">
    <verse number="25" style="v"/>យោ ជនេा និជប្រាណាន៑ ប្រិយាន៑ ជានាតិ ស តាន៑ ហារយិឞ្យតិ កិន្តុ យេा ជន ឥហលោកេ និជប្រាណាន៑ អប្រិយាន៑ ជានាតិ សេाនន្តាយុះ ប្រាប្តុំ តាន៑ រក្ឞិឞ្យតិ។</para>
  <para style="p">
    <verse number="26" style="v"/>កឝ្ចិទ៑ យទិ មម សេវកោ ភវិតុំ វាញ្ឆតិ តហ៌ិ ស មម បឝ្ចាទ្គាមី ភវតុ, តស្មាទ៑ អហំ យត្រ តិឞ្ឋាមិ មម សេវកេाបិ តត្រ ស្ថាស្យតិ; យោ ជនោ មាំ សេវតេ មម បិតាបិ តំ សម្មំស្យតេ។</para>
  <para style="p">
    <verse number="27" style="v"/>សាម្ប្រតំ មម ប្រាណា វ្យាកុលា ភវន្តិ, តស្មាទ៑ ហេ បិតរ ឯតស្មាត៑ សមយាន៑ មាំ រក្ឞ, ឥត្យហំ កិំ ប្រាត៌្ហយិឞ្យេ? កិន្ត្វហម៑ ឯតត្សមយាត៌្ហម៑ អវតីណ៌វាន៑។</para>
  <para style="p">
    <verse number="28" style="v"/>ហេ បិត: ស្វនាម្នោ មហិមានំ ប្រកាឝយ; តនៃវ ស្វនាម្នោ មហិមានម៑ អហំ ប្រាកាឝយំ បុនរបិ ប្រកាឝយិឞ្យាមិ, ឯឞា គគណីយា វាណី តស្មិន៑ សមយេៜជាយត។</para>
  <para style="p">
    <verse number="29" style="v"/>តច្ឝ្រុត្វា សមីបស្ថលោកានាំ កេចិទ៑ អវទន៑ មេឃោៜគជ៌ីត៑, កេចិទ៑ អវទន៑ ស្វគ៌ីយទូតោៜនេន សហ កថាមចកថត៑។</para>
  <para style="p">
    <verse number="30" style="v"/>តទា យីឝុះ ប្រត្យវាទីត៑, មទត៌្ហំ ឝព្ទោយំ នាភូត៑ យុឞ្មទត៌្ហមេវាភូត៑។</para>
  <para style="p">
    <verse number="31" style="v"/>អធុនា ជគតោស្យ វិចារ: សម្បត្ស្យតេ, អធុនាស្យ ជគត: បតី រាជ្យាត៑ ច្យោឞ្យតិ។</para>
  <para style="p">
    <verse number="32" style="v"/>យទ្យឦ ប្ឫថិវ្យា ឩទ៌្វ្វេ ប្រោត្ថាបិតោស្មិ តហ៌ិ សវ៌្វាន៑ មានវាន៑ ស្វសមីបម៑ អាកឞ៌ិឞ្យាមិ។</para>
  <para style="p">
    <verse number="33" style="v"/>កថំ តស្យ ម្ឫតិ រ្ភវិឞ្យតិ, ឯតទ៑ ពោធយិតុំ ស ឥមាំ កថាម៑ អកថយត៑។</para>
  <para style="p">
    <verse number="34" style="v"/>តទា លោកា អកថយន៑ សោភិឞិក្តះ សវ៌្វទា តិឞ្ឋតីតិ វ្យវស្ថាគ្រន្ថេ ឝ្រុតម៑ អស្មាភិះ, តហ៌ិ មនុឞ្យបុត្រះ ប្រោត្ថាបិតោ ភវិឞ្យតីតិ វាក្យំ កថំ វទសិ? មនុឞ្យបុត្រោយំ កះ?</para>
  <para style="p">
    <verse number="35" style="v"/>តទា យីឝុរកថាយទ៑ យុឞ្មាភិះ សាទ៌្ធម៑ អល្បទិនានិ ជ្យោតិរាស្តេ, យថា យុឞ្មាន៑ អន្ធការោ នាច្ឆាទយតិ តទត៌្ហំ យាវត្កាលំ យុឞ្មាភិះ សាទ៌្ធំ ជ្យោតិស្តិឞ្ឋតិ តាវត្កាលំ គច្ឆត; យោ ជនោៜន្ធការេ គច្ឆតិ ស កុត្រ យាតីតិ ន ជានាតិ។</para>
  <para style="p">
    <verse number="36" style="v"/>អតឯវ យាវត្កាលំ យុឞ្មាកំ និកដេ ជ្យោតិរាស្តេ តាវត្កាលំ ជ្យោតីរូបសន្តានា ភវិតុំ ជ្យោតិឞិ វិឝ្វសិត; ឥមាំ កថាំ កថយិត្វា យីឝុះ ប្រស្ថាយ តេភ្យះ ស្វំ គុប្តវាន៑។</para>
  <para style="p">
    <verse number="37" style="v"/>យទ្យបិ យីឝុស្តេឞាំ សមក្ឞម៑ ឯតាវទាឝ្ចយ៌្យកម៌្មាណិ ក្ឫតវាន៑ តថាបិ តេ តស្មិន៑ ន វ្យឝ្វសន៑។</para>
  <para style="p">
    <verse number="38" style="v"/>អតឯវ កះ ប្រត្យេតិ សុសំវាទំ បរេឝាស្មត៑ ប្រចារិតំ? ប្រកាឝតេ បរេឝស្យ ហស្តះ កស្យ ច សន្និធៅ? យិឝយិយភវិឞ្យទ្វាទិនា យទេតទ៑ វាក្យមុក្តំ តត៑ សផលម៑ អភវត៑។</para>
  <para style="p">
    <verse number="39" style="v"/>តេ ប្រត្យេតុំ នាឝន្កុវន៑ តស្មិន៑ យិឝយិយភវិឞ្យទ្វាទិ បុនរវាទីទ៑,</para>
  <para style="p">
    <verse number="40" style="v"/>យទា, "តេ នយនៃ រ្ន បឝ្យន្តិ ពុទ្ធិភិឝ្ច ន ពុធ្យន្តេ តៃ រ្មនះសុ បរិវត៌្តិតេឞុ ច តានហំ យថា ស្វស្ថាន៑ ន ករោមិ តថា ស តេឞាំ លោចនាន្យន្ធានិ ក្ឫត្វា តេឞាមន្តះករណានិ គាឍានិ ករិឞ្យតិ។ "</para>
  <para style="p">
    <verse number="41" style="v"/>យិឝយិយោ យទា យីឝោ រ្មហិមានំ វិលោក្យ តស្មិន៑ កថាមកថយត៑ តទា ភវិឞ្យទ្វាក្យម៑ ឦទ្ឫឝំ ប្រកាឝយត៑។</para>
  <para style="p">
    <verse number="42" style="v"/>តថាប្យធិបតិនាំ ពហវស្តស្មិន៑ ប្រត្យាយន៑។ កិន្តុ ផិរូឝិនស្តាន៑ ភជនគ្ឫហាទ៑ ទូរីកុវ៌្វន្តីតិ ភយាត៑ តេ តំ ន ស្វីក្ឫតវន្តះ។</para>
  <para style="p">
    <verse number="43" style="v"/>យត ឦឝ្វរស្យ ប្រឝំសាតោ មានវានាំ ប្រឝំសាយាំ តេៜប្រិយន្ត។</para>
  <para style="p">
    <verse number="44" style="v"/>តទា យីឝុរុច្ចៃះការម៑ អកថយទ៑ យោ ជនោ មយិ វិឝ្វសិតិ ស កេវលេ មយិ វិឝ្វសិតីតិ ន, ស មត្ប្រេរកេៜបិ វិឝ្វសិតិ។</para>
  <para style="p">
    <verse number="45" style="v"/>យោ ជនោ មាំ បឝ្យតិ ស មត្ប្រេរកមបិ បឝ្យតិ។</para>
  <para style="p">
    <verse number="46" style="v"/>យោ ជនោ មាំ ប្រត្យេតិ ស យថាន្ធការេ ន តិឞ្ឋតិ តទត៌្ហម៑ អហំ ជ្យោតិះស្វរូបោ ភូត្វា ជគត្យស្មិន៑ អវតីណ៌វាន៑។</para>
  <para style="p">
    <verse number="47" style="v"/>មម កថាំ ឝ្រុត្វា យទិ កឝ្ចិន៑ ន វិឝ្វសិតិ តហ៌ិ តមហំ ទោឞិណំ ន ករោមិ, យតោ ហេតោ រ្ជគតោ ជនានាំ ទោឞាន៑ និឝ្ចិតាន៑ កត៌្តុំ នាគត្យ តាន៑ បរិចាតុម៑ អាគតោស្មិ។</para>
  <para style="p">
    <verse number="48" style="v"/>យះ កឝ្ចិន៑ មាំ ន ឝ្រទ្ធាយ មម កថំ ន គ្ឫហ្លាតិ, អន្យស្តំ ទោឞិណំ ករិឞ្យតិ វស្តុតស្តុ យាំ កថាមហម៑ អចកថំ សា កថា ចរមេៜន្ហិ តំ ទោឞិណំ ករិឞ្យតិ។</para>
  <para style="p">
    <verse number="49" style="v"/>យតោ ហេតោរហំ ស្វតះ កិមបិ ន កថយាមិ, កិំ កិំ មយា កថយិតវ្យំ កិំ សមុបទេឞ្ដវ្យញ្ច ឥតិ មត្ប្រេរយិតា បិតា មាមាជ្ញាបយត៑។</para>
  <para style="p">
    <verse number="50" style="v"/>តស្យ សាជ្ញា អនន្តាយុរិត្យហំ ជានាមិ, អតឯវាហំ យត៑ កថយាមិ តត៑ បិតា យថាជ្ញាបយត៑ តថៃវ កថយាម្យហម៑។</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>និស្តារោត្សវស្យ កិញ្ចិត្កាលាត៑ បូវ៌្វំ ប្ឫថិវ្យាះ បិតុះ សមីបគមនស្យ សមយះ សន្និកឞ៌ោភូទ៑ ឥតិ ជ្ញាត្វា យីឝុរាប្រថមាទ៑ យេឞុ ជគត្ប្រវាសិឞ្វាត្មីយលោកេឞ ប្រេម ករោតិ ស្ម តេឞុ ឝេឞំ យាវត៑ ប្រេម ក្ឫតវាន៑។</para>
  <para style="p">
    <verse number="2" style="v"/>បិតា តស្យ ហស្តេ សវ៌្វំ សមប៌ិតវាន៑ ស្វយម៑ ឦឝ្វរស្យ សមីបាទ៑ អាគច្ឆទ៑ ឦឝ្វរស្យ សមីបំ យាស្យតិ ច, សវ៌្វាណ្យេតានិ ជ្ញាត្វា រជន្យាំ ភោជនេ សម្បូណ៌េ សតិ,</para>
  <para style="p">
    <verse number="3" style="v"/>យទា ឝៃតាន៑ តំ បរហស្តេឞុ សមប៌យិតុំ ឝិមោនះ បុត្រស្យ ឦឞ្ការិយោតិយស្យ យិហូទា អន្តះករណេ កុប្រវ្ឫត្តិំ សមាប៌យត៑,</para>
  <para style="p">
    <verse number="4" style="v"/>តទា យីឝុ រ្ភោជនាសនាទ៑ ឧត្ថាយ គាត្រវស្ត្រំ មោចយិត្វា គាត្រមាជ៌នវស្ត្រំ គ្ឫហីត្វា តេន ស្វកដិម៑ អពធ្នាត៑,</para>
  <para style="p">
    <verse number="5" style="v"/>បឝ្ចាទ៑ ឯកបាត្រេ ជលម៑ អភិឞិច្យ ឝិឞ្យាណាំ បាទាន៑ ប្រក្ឞាល្យ តេន កដិពទ្ធគាត្រមាជ៌នវាសសា មាឞ៌្ដុំ ប្រារភត។</para>
  <para style="p">
    <verse number="6" style="v"/>តតះ ឝិមោន្បិតរស្យ សមីបមាគតេ ស ឧក្តវាន៑ ហេ ប្រភោ ភវាន៑ កិំ មម បាទៅ ប្រក្ឞាលយិឞ្យតិ?</para>
  <para style="p">
    <verse number="7" style="v"/>យីឝុរុទិតវាន៑ អហំ យត៑ ករោមិ តត៑ សម្ប្រតិ ន ជានាសិ កិន្តុ បឝ្ចាជ៑ ជ្ញាស្យសិ។</para>
  <para style="p">
    <verse number="8" style="v"/>តតះ បិតរះ កថិតវាន៑ ភវាន៑ កទាបិ មម បាទៅ ន ប្រក្ឞាលយិឞ្យតិ។ យីឝុរកថយទ៑ យទិ ត្វាំ ន ប្រក្ឞាលយេ តហ៌ិ មយិ តវ កោប្យំឝោ នាស្តិ។</para>
  <para style="p">
    <verse number="9" style="v"/>តទា ឝិមោន្បិតរះ កថិតវាន៑ ហេ ប្រភោ តហ៌ិ កេវលបាទៅ ន, មម ហស្តៅ ឝិរឝ្ច ប្រក្ឞាលយតុ។</para>
  <para style="p">
    <verse number="10" style="v"/>តតោ យីឝុរវទទ៑ យោ ជនោ ធៅតស្តស្យ សវ៌្វាង្គបរិឞ្ក្ឫតត្វាត៑ បាទៅ វិនាន្យាង្គស្យ ប្រក្ឞាលនាបេក្ឞា នាស្តិ។ យូយំ បរិឞ្ក្ឫតា ឥតិ សត្យំ កិន្តុ ន សវ៌្វេ,</para>
  <para style="p">
    <verse number="11" style="v"/>យតោ យោ ជនស្តំ បរករេឞុ សមប៌យិឞ្យតិ តំ ស ជ្ញាតវាន; អតឯវ យូយំ សវ៌្វេ ន បរិឞ្ក្ឫតា ឥមាំ កថាំ កថិតវាន៑។</para>
  <para style="p">
    <verse number="12" style="v"/>ឥត្ថំ យីឝុស្តេឞាំ បាទាន៑ ប្រក្ឞាល្យ វស្ត្រំ បរិធាយាសនេ សមុបវិឝ្យ កថិតវាន៑ អហំ យុឞ្មាន៑ ប្រតិ កិំ កម៌្មាកាឞ៌ំ ជានីថ?</para>
  <para style="p">
    <verse number="13" style="v"/>យូយំ មាំ គុរុំ ប្រភុញ្ច វទថ តត៑ សត្យមេវ វទថ យតោហំ សឯវ ភវាមិ។</para>
  <para style="p">
    <verse number="14" style="v"/>យទ្យហំ ប្រភុ រ្គុរុឝ្ច សន៑ យុឞ្មាកំ បាទាន៑ ប្រក្ឞាលិតវាន៑ តហ៌ិ យុឞ្មាកមបិ បរស្បរំ បាទប្រក្ឞាលនម៑ ឧចិតម៑។</para>
  <para style="p">
    <verse number="15" style="v"/>អហំ យុឞ្មាន៑ ប្រតិ យថា វ្យវាហរំ យុឞ្មាន៑ តថា វ្យវហត៌្តុម៑ ឯកំ បន្ថានំ ទឝ៌ិតវាន៑។</para>
  <para style="p">
    <verse number="16" style="v"/>អហំ យុឞ្មានតិយថាត៌្ហំ វទាមិ, ប្រភោ រ្ទាសោ ន មហាន៑ ប្រេរកាច្ច ប្រេរិតោ ន មហាន៑។</para>
  <para style="p">
    <verse number="17" style="v"/>ឥមាំ កថាំ វិទិត្វា យទិ តទនុសារតះ កម៌្មាណិ កុរុថ តហ៌ិ យូយំ ធន្យា ភវិឞ្យថ។</para>
  <para style="p">
    <verse number="18" style="v"/>សវ៌្វេឞុ យុឞ្មាសុ កថាមិមាំ កថយាមិ ឥតិ ន, យេ មម មនោនីតាស្តានហំ ជានាមិ, កិន្តុ មម ភក្ឞ្យាណិ យោ ភុង្ក្តេ មត្ប្រាណប្រាតិកូល្យតះ។ ឧត្ថាបយតិ បាទស្យ មូលំ ស ឯឞ មានវះ។ យទេតទ៑ ធម៌្មបុស្តកស្យ វចនំ តទនុសារេណាវឝ្យំ ឃដិឞ្យតេ។</para>
  <para style="p">
    <verse number="19" style="v"/>អហំ ស ជន ឥត្យត្រ យថា យុឞ្មាកំ វិឝ្វាសោ ជាយតេ តទត៌្ហំ ឯតាទ្ឫឝឃដនាត៑ បូវ៌្វម៑ អហមិទានីំ យុឞ្មភ្យមកថយម៑។</para>
  <para style="p">
    <verse number="20" style="v"/>អហំ យុឞ្មានតីវ យថាត៌្ហំ វទាមិ, មយា ប្រេរិតំ ជនំ យោ គ្ឫហ្លាតិ ស មាមេវ គ្ឫហ្លាតិ យឝ្ច មាំ គ្ឫហ្លាតិ ស មត្ប្រេរកំ គ្ឫហ្លាតិ។</para>
  <para style="p">
    <verse number="21" style="v"/>ឯតាំ កថាំ កថយិត្វា យីឝុ រ្ទុះខី សន៑ ប្រមាណំ ទត្ត្វា កថិតវាន៑ អហំ យុឞ្មានតិយថាត៌្ហំ វទាមិ យុឞ្មាកម៑ ឯកោ ជនោ មាំ បរករេឞុ សមប៌យិឞ្យតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>តតះ ស កមុទ្ទិឝ្យ កថាមេតាំ កថិតវាន៑ ឥត្យត្រ សន្ទិគ្ធាះ ឝិឞ្យាះ បរស្បរំ មុខមាលោកយិតុំ ប្រារភន្ត។</para>
  <para style="p">
    <verse number="23" style="v"/>តស្មិន៑ សមយេ យីឝុ រ្យស្មិន៑ អប្រីយត ស ឝិឞ្យស្តស្យ វក្ឞះស្ថលម៑ អវាលម្ពត។</para>
  <para style="p">
    <verse number="24" style="v"/>ឝិមោន្បិតរស្តំ សង្កេតេនាវទត៑, អយំ កមុទ្ទិឝ្យ កថាមេតាម៑ កថយតីតិ ប្ឫច្ឆ។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា ស យីឝោ រ្វក្ឞះស្ថលម៑ អវលម្ព្យ ប្ឫឞ្ឋវាន៑, ហេ ប្រភោ ស ជនះ កះ?</para>
  <para style="p">
    <verse number="26" style="v"/>តតោ យីឝុះ ប្រត្យវទទ៑ ឯកខណ្ឌំ បូបំ មជ្ជយិត្វា យស្មៃ ទាស្យាមិ សឯវ សះ; បឝ្ចាត៑ បូបខណ្ឌមេកំ មជ្ជយិត្វា ឝិមោនះ បុត្រាយ ឦឞ្ករិយោតីយាយ យិហូទៃ ទត្តវាន៑។</para>
  <para style="p">
    <verse number="27" style="v"/>តស្មិន៑ ទត្តេ សតិ ឝៃតាន៑ តមាឝ្រយត៑; តទា យីឝុស្តម៑ អវទត៑ ត្វំ យត៑ ករិឞ្យសិ តត៑ ក្ឞិប្រំ កុរុ។</para>
  <para style="p">
    <verse number="28" style="v"/>កិន្តុ ស យេនាឝយេន តាំ កថាមកថាយត៑ តម៑ ឧបវិឞ្ដលោកានាំ កោបិ នាពុធ្យត;</para>
  <para style="p">
    <verse number="29" style="v"/>កិន្តុ យិហូទាះ សមីបេ មុទ្រាសម្បុដកស្ថិតេះ កេចិទ៑ ឥត្ថម៑ អពុធ្យន្ត បាវ៌្វណាសាទនាត៌្ហំ កិមបិ ទ្រវ្យំ ក្រេតុំ វា ទរិទ្រេភ្យះ កិញ្ចិទ៑ វិតរិតុំ កថិតវាន៑។</para>
  <para style="p">
    <verse number="30" style="v"/>តទា បូបខណ្ឌគ្រហណាត៑ បរំ ស តូណ៌ំ ពហិរគច្ឆត៑; រាត្រិឝ្ច សមុបស្យិតា។</para>
  <para style="p">
    <verse number="31" style="v"/>យិហូទេ ពហិគ៌តេ យីឝុរកថយទ៑ ឥទានីំ មានវសុតស្យ មហិមា ប្រកាឝតេ តេនេឝ្វរស្យាបិ មហិមា ប្រកាឝតេ។</para>
  <para style="p">
    <verse number="32" style="v"/>យទិ តេនេឝ្វរស្យ មហិមា ប្រកាឝតេ តហ៌ីឝ្វរោបិ ស្វេន តស្យ មហិមានំ ប្រកាឝយិឞ្យតិ តូណ៌មេវ ប្រកាឝយិឞ្យតិ។</para>
  <para style="p">
    <verse number="33" style="v"/>ហេ វត្សា អហំ យុឞ្មាភិះ សាទ៌្ធំ កិញ្ចិត្កាលមាត្រម៑ អាសេ, តតះ បរំ មាំ ម្ឫគយិឞ្យធ្វេ កិន្ត្វហំ យត្ស្ថានំ យាមិ តត្ស្ថានំ យូយំ គន្តុំ ន ឝក្ឞ្យថ, យាមិមាំ កថាំ យិហូទីយេភ្យះ កថិតវាន៑ តថាធុនា យុឞ្មភ្យមបិ កថយាមិ។</para>
  <para style="p">
    <verse number="34" style="v"/>យូយំ បរស្បរំ ប្រីយធ្វម៑ អហំ យុឞ្មាសុ យថា ប្រីយេ យូយមបិ បរស្បរម៑ តថៃវ ប្រីយធ្វំ, យុឞ្មាន៑ ឥមាំ នវីនាម៑ អាជ្ញាម៑ អាទិឝាមិ។</para>
  <para style="p">
    <verse number="35" style="v"/>តេនៃវ យទិ បរស្បរំ ប្រីយធ្វេ តហ៌ិ លក្ឞណេនានេន យូយំ មម ឝិឞ្យា ឥតិ សវ៌្វេ ជ្ញាតុំ ឝក្ឞ្យន្តិ។</para>
  <para style="p">
    <verse number="36" style="v"/>ឝិមោនបិតរះ ប្ឫឞ្ឋវាន៑ ហេ ប្រភោ ភវាន៑ កុត្រ យាស្យតិ? តតោ យីឝុះ ប្រត្យវទត៑, អហំ យត្ស្ថានំ យាមិ តត្ស្ថានំ សាម្ប្រតំ មម បឝ្ចាទ៑ គន្តុំ ន ឝក្នោឞិ កិន្តុ បឝ្ចាទ៑ គមិឞ្យសិ។</para>
  <para style="p">
    <verse number="37" style="v"/>តទា បិតរះ ប្រត្យុទិតវាន៑, ហេ ប្រភោ សាម្ប្រតំ កុតោ ហេតោស្តវ បឝ្ចាទ៑ គន្តុំ ន ឝក្នោមិ? ត្វទត៌្ហំ ប្រាណាន៑ ទាតុំ ឝក្នោមិ។</para>
  <para style="p">
    <verse number="38" style="v"/>តតោ យីឝុះ ប្រត្យុក្តវាន៑ មន្និមិត្តំ កិំ ប្រាណាន៑ ទាតុំ ឝក្នោឞិ? ត្វាមហំ យថាត៌្ហំ វទាមិ, កុក្កុដរវណាត៑ បូវ៌្វំ ត្វំ ត្រិ រ្មាម៑ អបហ្នោឞ្យសេ។</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>មនោទុះខិនោ មា ភូត; ឦឝ្វរេ វិឝ្វសិត មយិ ច វិឝ្វសិត។</para>
  <para style="p">
    <verse number="2" style="v"/>មម បិតុ គ្ឫហេ ពហូនិ វាសស្ថានិ សន្តិ នោ ចេត៑ បូវ៌្វំ យុឞ្មាន៑ អជ្ញាបយិឞ្យំ យុឞ្មទត៌្ហំ ស្ថានំ សជ្ជយិតុំ គច្ឆាមិ។</para>
  <para style="p">
    <verse number="3" style="v"/>យទិ គត្វាហំ យុឞ្មន្និមិត្តំ ស្ថានំ សជ្ជយាមិ តហ៌ិ បនរាគត្យ យុឞ្មាន៑ ស្វសមីបំ នេឞ្យាមិ, តតោ យត្រាហំ តិឞ្ឋាមិ តត្រ យូយមបិ ស្ថាស្យថ។</para>
  <para style="p">
    <verse number="4" style="v"/>អហំ យត្ស្ថានំ ព្រជាមិ តត្ស្ថានំ យូយំ ជានីថ តស្យ បន្ថានមបិ ជានីថ។</para>
  <para style="p">
    <verse number="5" style="v"/>តទា ថោមា អវទត៑, ហេ ប្រភោ ភវាន៑ កុត្រ យាតិ តទ្វយំ ន ជានីមះ, តហ៌ិ កថំ បន្ថានំ ជ្ញាតុំ ឝក្នុមះ?</para>
  <para style="p">
    <verse number="6" style="v"/>យីឝុរកថយទ៑ អហមេវ សត្យជីវនរូបបថោ មយា ន គន្តា កោបិ បិតុះ សមីបំ គន្តុំ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="7" style="v"/>យទិ មាម៑ អជ្ញាស្យត តហ៌ិ មម បិតរមប្យជ្ញាស្យត កិន្ត្វធុនាតស្តំ ជានីថ បឝ្យថ ច។</para>
  <para style="p">
    <verse number="8" style="v"/>តទា ផិលិបះ កថិតវាន៑, ហេ ប្រភោ បិតរំ ទឝ៌យ តស្មាទស្មាកំ យថេឞ្ដំ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="9" style="v"/>តតោ យីឝុះ ប្រត្យាវាទីត៑, ហេ ផិលិប យុឞ្មាភិះ សាទ៌្ធម៑ ឯតាវទ្ទិនានិ ស្ថិតមបិ មាំ កិំ ន ប្រត្យភិជានាសិ? យោ ជនោ មាម៑ អបឝ្យត៑ ស បិតរមប្យបឝ្យត៑ តហ៌ិ បិតរម៑ អស្មាន៑ ទឝ៌យេតិ កថាំ កថំ កថយសិ?</para>
  <para style="p">
    <verse number="10" style="v"/>អហំ បិតរិ តិឞ្ឋាមិ បិតា មយិ តិឞ្ឋតីតិ កិំ ត្វំ ន ប្រត្យឞិ? អហំ យទ្វាក្យំ វទាមិ តត៑ ស្វតោ ន វទាមិ កិន្តុ យះ បិតា មយិ វិរាជតេ ស ឯវ សវ៌្វកម៌្មាណិ ករាតិ។</para>
  <para style="p">
    <verse number="11" style="v"/>អតឯវ បិតយ៌្យហំ តិឞ្ឋាមិ បិតា ច មយិ តិឞ្ឋតិ មមាស្យាំ កថាយាំ ប្រត្យយំ កុរុត, នោ ចេត៑ កម៌្មហេតោះ ប្រត្យយំ កុរុត។</para>
  <para style="p">
    <verse number="12" style="v"/>អហំ យុឞ្មានតិយថាត៌្ហំ វទាមិ, យោ ជនោ មយិ វិឝ្វសិតិ សោហមិវ កម៌្មាណិ ករិឞ្យតិ វរំ តតោបិ មហាកម៌្មាណិ ករិឞ្យតិ យតោ ហេតោរហំ បិតុះ សមីបំ គច្ឆាមិ។</para>
  <para style="p">
    <verse number="13" style="v"/>យថា បុត្រេណ បិតុ រ្មហិមា ប្រកាឝតេ តទត៌្ហំ មម នាម ប្រោច្យ យត៑ ប្រាត៌្ហយិឞ្យធ្វេ តត៑ សផលំ ករិឞ្យាមិ។</para>
  <para style="p">
    <verse number="14" style="v"/>យទិ មម នាម្នា យត៑ កិញ្ចិទ៑ យាចធ្វេ តហ៌ិ តទហំ សាធយិឞ្យាមិ។</para>
  <para style="p">
    <verse number="15" style="v"/>យទិ មយិ ប្រីយធ្វេ តហ៌ិ មមាជ្ញាះ សមាចរត។</para>
  <para style="p">
    <verse number="16" style="v"/>តតោ មយា បិតុះ សមីបេ ប្រាត៌្ហិតេ បិតា និរន្តរំ យុឞ្មាភិះ សាទ៌្ធំ ស្ថាតុម៑ ឥតរមេកំ សហាយម៑ អត៌្ហាត៑ សត្យមយម៑ អាត្មានំ យុឞ្មាកំ និកដំ ប្រេឞយិឞ្យតិ។</para>
  <para style="p">
    <verse number="17" style="v"/>ឯតជ្ជគតោ លោកាស្តំ គ្រហីតុំ ន ឝក្នុវន្តិ យតស្តេ តំ នាបឝ្យន៑ នាជនំឝ្ច កិន្តុ យូយំ ជានីថ យតោ ហេតោះ ស យុឞ្មាកមន្ត រ្និវសតិ យុឞ្មាកំ មធ្យេ ស្ថាស្យតិ ច។</para>
  <para style="p">
    <verse number="18" style="v"/>អហំ យុឞ្មាន៑ អនាថាន៑ ក្ឫត្វា ន យាស្យាមិ បុនរបិ យុឞ្មាកំ សមីបម៑ អាគមិឞ្យាមិ។</para>
  <para style="p">
    <verse number="19" style="v"/>កិយត្កាលរត៑ បរម៑ អស្យ ជគតោ លោកា មាំ បុន រ្ន ទ្រក្ឞ្យន្តិ កិន្តុ យូយំ ទ្រក្ឞ្យថ;អហំ ជីវិឞ្យាមិ តស្មាត៑ ការណាទ៑ យូយមបិ ជីវិឞ្យថ។</para>
  <para style="p">
    <verse number="20" style="v"/>បិតយ៌្យហមស្មិ មយិ ច យូយំ ស្ថ, តថាហំ យុឞ្មាស្វស្មិ តទបិ តទា ជ្ញាស្យថ។</para>
  <para style="p">
    <verse number="21" style="v"/>យោ ជនោ មមាជ្ញា គ្ឫហីត្វា តា អាចរតិ សឯវ មយិ ប្រីយតេ; យោ ជនឝ្ច មយិ ប្រីយតេ សឯវ មម បិតុះ ប្រិយបាត្រំ ភវិឞ្យតិ, តថាហមបិ តស្មិន៑ ប្រីត្វា តស្មៃ ស្វំ ប្រកាឝយិឞ្យាមិ។</para>
  <para style="p">
    <verse number="22" style="v"/>តទា ឦឞ្ករិយោតីយាទ៑ អន្យោ យិហូទាស្តមវទត៑, ហេ ប្រភោ ភវាន៑ ជគតោ លោកានាំ សន្និធៅ ប្រកាឝិតោ ន ភូត្វាស្មាកំ សន្និធៅ កុតះ ប្រកាឝិតោ ភវិឞ្យតិ?</para>
  <para style="p">
    <verse number="23" style="v"/>តតោ យីឝុះ ប្រត្យុទិតវាន៑, យោ ជនោ មយិ ប្រីយតេ ស មមាជ្ញា អបិ គ្ឫហ្លាតិ, តេន មម បិតាបិ តស្មិន៑ ប្រេឞ្យតេ, អាវាញ្ច តន្និកដមាគត្យ តេន សហ និវត្ស្យាវះ។</para>
  <para style="p">
    <verse number="24" style="v"/>យោ ជនោ មយិ ន ប្រីយតេ ស មម កថា អបិ ន គ្ឫហ្លាតិ បុនឝ្ច យាមិមាំ កថាំ យូយំ ឝ្ឫណុថ សា កថា កេវលស្យ មម ន កិន្តុ មម ប្រេរកោ យះ បិតា តស្យាបិ កថា។</para>
  <para style="p">
    <verse number="25" style="v"/>ឥទានីំ យុឞ្មាកំ និកដេ វិទ្យមានោហម៑ ឯតាះ សកលាះ កថាះ កថយាមិ។</para>
  <para style="p">
    <verse number="26" style="v"/>កិន្ត្វិតះ បរំ បិត្រា យះ សហាយោៜរ្ថាត៑ បវិត្រ អាត្មា មម នាម្និ ប្រេរយិឞ្យតិ ស សវ៌្វំ ឝិក្ឞយិត្វា មយោក្តាះ សមស្តាះ កថា យុឞ្មាន៑ ស្មារយិឞ្យតិ។</para>
  <para style="p">
    <verse number="27" style="v"/>អហំ យុឞ្មាកំ និកដេ ឝាន្តិំ ស្ថាបយិត្វា យាមិ, និជាំ ឝាន្តិំ យុឞ្មភ្យំ ទទាមិ, ជគតោ លោកា យថា ទទាតិ តថាហំ ន ទទាមិ; យុឞ្មាកម៑ អន្តះករណានិ ទុះខិតានិ ភីតានិ ច ន ភវន្តុ។</para>
  <para style="p">
    <verse number="28" style="v"/>អហំ គត្វា បុនរបិ យុឞ្មាកំ សមីបម៑ អាគមិឞ្យាមិ មយោក្តំ វាក្យមិទំ យូយម៑ អឝ្រៅឞ្ដ; យទិ មយ្យប្រេឞ្យធ្វំ តហ៌្យហំ បិតុះ សមីបំ គច្ឆាមិ មមាស្យាំ កថាយាំ យូយម៑ អហ្លាទិឞ្យធ្វំ យតោ មម បិតា មត្តោបិ មហាន៑។</para>
  <para style="p">
    <verse number="29" style="v"/>តស្យា ឃដនាយាះ សមយេ យថា យុឞ្មាកំ ឝ្រទ្ធា ជាយតេ តទត៌្ហម៑ អហំ តស្យា ឃដនាយាះ បូវ៌្វម៑ ឥទានីំ យុឞ្មាន៑ ឯតាំ វាត៌្តាំ វទាមិ។</para>
  <para style="p">
    <verse number="30" style="v"/>ឥតះ បរំ យុឞ្មាភិះ សហ មម ពហវ អាលាបា ន ភវិឞ្យន្តិ យតះ ការណាទ៑ ឯតស្យ ជគតះ បតិរាគច្ឆតិ កិន្តុ មយា សហ តស្យ កោបិ សម្ពន្ធោ នាស្តិ។</para>
  <para style="p">
    <verse number="31" style="v"/>អហំ បិតរិ ប្រេម ករោមិ តថា បិតុ រ្វិធិវត៑ កម៌្មាណិ ករោមីតិ យេន ជគតោ លោកា ជានន្តិ តទត៌្ហម៑ ឧត្តិឞ្ឋត វយំ ស្ថានាទស្មាទ៑ គច្ឆាម។</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អហំ សត្យទ្រាក្ឞាលតាស្វរូបោ មម បិតា តូទ្យានបរិចារកស្វរូបញ្ច។</para>
  <para style="p">
    <verse number="2" style="v"/>មម យាសុ ឝាខាសុ ផលានិ ន ភវន្តិ តាះ ស ឆិនត្តិ តថា ផលវត្យះ ឝាខា យថាធិកផលានិ ផលន្តិ តទត៌្ហំ តាះ បរិឞ្ករោតិ។</para>
  <para style="p">
    <verse number="3" style="v"/>ឥទានីំ មយោក្តោបទេឝេន យូយំ បរិឞ្ក្ឫតាះ។</para>
  <para style="p">
    <verse number="4" style="v"/>អតះ ការណាត៑ មយិ តិឞ្ឋត តេនាហមបិ យុឞ្មាសុ តិឞ្ឋាមិ, យតោ ហេតោ រ្ទ្រាក្ឞាលតាយាម៑ អសំលគ្នា ឝាខា យថា ផលវតី ភវិតុំ ន ឝក្នោតិ តថា យូយមបិ មយ្យតិឞ្ឋន្តះ ផលវន្តោ ភវិតុំ ន ឝក្នុថ។</para>
  <para style="p">
    <verse number="5" style="v"/>អហំ ទ្រាក្ឞាលតាស្វរូបោ យូយញ្ច ឝាខាស្វរូបោះ; យោ ជនោ មយិ តិឞ្ឋតិ យត្រ ចាហំ តិឞ្ឋាមិ, ស ប្រចូរផលៃះ ផលវាន៑ ភវតិ, កិន្តុ មាំ វិនា យូយំ កិមបិ កត៌្តុំ ន ឝក្នុថ។</para>
  <para style="p">
    <verse number="6" style="v"/>យះ កឝ្ចិន៑ មយិ ន តិឞ្ឋតិ ស ឝុឞ្កឝាខេវ ពហិ រ្និក្ឞិប្យតេ លោកាឝ្ច តា អាហ្ឫត្យ វហ្នៅ និក្ឞិប្យ ទាហយន្តិ។</para>
  <para style="p">
    <verse number="7" style="v"/>យទិ យូយំ មយិ តិឞ្ឋថ មម កថា ច យុឞ្មាសុ តិឞ្ឋតិ តហ៌ិ យទ៑ វាញ្ឆិត្វា យាចិឞ្យធ្វេ យុឞ្មាកំ តទេវ សផលំ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="8" style="v"/>យទិ យូយំ ប្រចូរផលវន្តោ ភវថ តហ៌ិ តទ្វារា មម បិតុ រ្មហិមា ប្រកាឝិឞ្យតេ តថា យូយំ មម ឝិឞ្យា ឥតិ បរិក្ឞាយិឞ្យធ្វេ។</para>
  <para style="p">
    <verse number="9" style="v"/>បិតា យថា មយិ ប្រីតវាន៑ អហមបិ យុឞ្មាសុ តថា ប្រីតវាន៑ អតោ ហេតោ រ្យូយំ និរន្តរំ មម ប្រេមបាត្រាណិ ភូត្វា តិឞ្ឋត។</para>
  <para style="p">
    <verse number="10" style="v"/>អហំ យថា បិតុរាជ្ញា គ្ឫហីត្វា តស្យ ប្រេមភាជនំ តិឞ្ឋាមិ តថៃវ យូយមបិ យទិ មមាជ្ញា គុហ្លីថ តហ៌ិ មម ប្រេមភាជនានិ ស្ថាស្យថ។</para>
  <para style="p">
    <verse number="11" style="v"/>យុឞ្មន្និមិត្តំ មម យ អាហ្លាទះ ស យថា ចិរំ តិឞ្ឋតិ យុឞ្មាកម៑ អានន្ទឝ្ច យថា បូយ៌្យតេ តទត៌្ហំ យុឞ្មភ្យម៑ ឯតាះ កថា អត្រកថម៑។</para>
  <para style="p">
    <verse number="12" style="v"/>អហំ យុឞ្មាសុ យថា ប្រីយេ យូយមបិ បរស្បរំ តថា ប្រីយធ្វម៑ ឯឞា មមាជ្ញា។</para>
  <para style="p">
    <verse number="13" style="v"/>មិត្រាណាំ ការណាត៑ ស្វប្រាណទានបយ៌្យន្តំ យត៑ ប្រេម តស្មាន៑ មហាប្រេម កស្យាបិ នាស្តិ។</para>
  <para style="p">
    <verse number="14" style="v"/>អហំ យទ្យទ៑ អាទិឝាមិ តត្តទេវ យទិ យូយម៑ អាចរត តហ៌ិ យូយមេវ មម មិត្រាណិ។</para>
  <para style="p">
    <verse number="15" style="v"/>អទ្យារភ្យ យុឞ្មាន៑ ទាសាន៑ ន វទិឞ្យាមិ យត៑ ប្រភុ រ្យត៑ ករោតិ ទាសស្តទ៑ ន ជានាតិ; កិន្តុ បិតុះ សមីបេ យទ្យទ៑ អឝ្ឫណវំ តត៑ សវ៌្វំ យូឞ្មាន៑ អជ្ញាបយម៑ តត្ការណាទ៑ យុឞ្មាន៑ មិត្រាណិ ប្រោក្តវាន៑។</para>
  <para style="p">
    <verse number="16" style="v"/>យូយំ មាំ រោចិតវន្ត ឥតិ ន, កិន្ត្វហមេវ យុឞ្មាន៑ រោចិតវាន៑ យូយំ គត្វា យថា ផលាន្យុត្បាទយថ តានិ ផលានិ ចាក្ឞយាណិ ភវន្តិ, តទត៌្ហំ យុឞ្មាន៑ ន្យជុនជំ តស្មាន៑ មម នាម ប្រោច្យ បិតរំ យត៑ កិញ្ចិទ៑ យាចិឞ្យធ្វេ តទេវ ស យុឞ្មភ្យំ ទាស្យតិ។</para>
  <para style="p">
    <verse number="17" style="v"/>យូយំ បរស្បរំ ប្រីយធ្វម៑ អហម៑ ឥត្យាជ្ញាបយាមិ។</para>
  <para style="p">
    <verse number="18" style="v"/>ជគតោ លោកៃ រ្យុឞ្មាសុ ឫតីយិតេឞុ តេ បូវ៌្វំ មាមេវាត៌្តីយន្ត ឥតិ យូយំ ជានីថ។</para>
  <para style="p">
    <verse number="19" style="v"/>យទិ យូយំ ជគតោ លោកា អភវិឞ្យត តហ៌ិ ជគតោ លោកា យុឞ្មាន៑ អាត្មីយាន៑ ពុទ្ធ្វាប្រេឞ្យន្ត; កិន្តុ យូយំ ជគតោ លោកា ន ភវថ, អហំ យុឞ្មាន៑ អស្មាជ្ជគតោៜរោចយម៑ ឯតស្មាត៑ ការណាជ្ជគតោ លោកា យុឞ្មាន៑ ឫតីយន្តេ។</para>
  <para style="p">
    <verse number="20" style="v"/>ទាសះ ប្រភោ រ្មហាន៑ ន ភវតិ មមៃតត៑ បូវ៌្វីយំ វាក្យំ ស្មរត; តេ យទិ មាមេវាតាឌយន៑ តហ៌ិ យុឞ្មានបិ តាឌយិឞ្យន្តិ, យទិ មម វាក្យំ គ្ឫហ្លន្តិ តហ៌ិ យុឞ្មាកមបិ វាក្យំ គ្រហីឞ្យន្តិ។</para>
  <para style="p">
    <verse number="21" style="v"/>កិន្តុ តេ មម នាមការណាទ៑ យុឞ្មាន៑ ប្រតិ តាទ្ឫឝំ វ្យវហរិឞ្យន្តិ យតោ យោ មាំ ប្រេរិតវាន៑ តំ តេ ន ជានន្តិ។</para>
  <para style="p">
    <verse number="22" style="v"/>តេឞាំ សន្និធិម៑ អាគត្យ យទ្យហំ នាកថយិឞ្យំ តហ៌ិ តេឞាំ បាបំ នាភវិឞ្យត៑ កិន្ត្វធុនា តេឞាំ បាបមាច្ឆាទយិតុម៑ ឧបាយោ នាស្តិ។</para>
  <para style="p">
    <verse number="23" style="v"/>យោ ជនោ មាម៑ ឫតីយតេ ស មម បិតរមបិ ឫតីយតេ។</para>
  <para style="p">
    <verse number="24" style="v"/>យាទ្ឫឝានិ កម៌្មាណិ កេនាបិ កទាបិ នាក្រិយន្ត តាទ្ឫឝានិ កម៌្មាណិ យទិ តេឞាំ សាក្ឞាទ៑ អហំ នាករិឞ្យំ តហ៌ិ តេឞាំ បាបំ នាភវិឞ្យត៑ កិន្ត្វធុនា តេ ទ្ឫឞ្ដ្វាបិ មាំ មម បិតរញ្ចាត៌្តីយន្ត។</para>
  <para style="p">
    <verse number="25" style="v"/>តស្មាត៑ តេៜការណំ មាម៑ ឫតីយន្តេ យទេតទ៑ វចនំ តេឞាំ ឝាស្ត្រេ លិខិតមាស្តេ តត៑ សផលម៑ អភវត៑។</para>
  <para style="p">
    <verse number="26" style="v"/>កិន្តុ បិតុ រ្និគ៌តំ យំ សហាយមត៌្ហាត៑ សត្យមយម៑ អាត្មានំ បិតុះ សមីបាទ៑ យុឞ្មាកំ សមីបេ ប្រេឞយិឞ្យាមិ ស អាគត្យ មយិ ប្រមាណំ ទាស្យតិ។</para>
  <para style="p">
    <verse number="27" style="v"/>យូយំ ប្រថមមារភ្យ មយា សាទ៌្ធំ តិឞ្ឋថ តស្មាទ្ធេតោ រ្យូយមបិ ប្រមាណំ ទាស្យថ។</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យុឞ្មាកំ យថា វាធា ន ជាយតេ តទត៌្ហំ យុឞ្មាន៑ ឯតានិ សវ៌្វវាក្យានិ វ្យាហរំ។</para>
  <para style="p">
    <verse number="2" style="v"/>លោកា យុឞ្មាន៑ ភជនគ្ឫហេភ្យោ ទូរីករិឞ្យន្តិ តថា យស្មិន៑ សមយេ យុឞ្មាន៑ ហត្វា ឦឝ្វរស្យ តុឞ្ដិ ជនកំ កម៌្មាកុម៌្ម ឥតិ មំស្យន្តេ ស សមយ អាគច្ឆន្តិ។</para>
  <para style="p">
    <verse number="3" style="v"/>តេ បិតរំ មាញ្ច ន ជានន្តិ, តស្មាទ៑ យុឞ្មាន៑ ប្រតីទ្ឫឝម៑ អាចរិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="4" style="v"/>អតោ ហេតាះ សមយេ សមុបស្ថិតេ យថា មម កថា យុឞ្មាកំ មនះសុះ សមុបតិឞ្ឋតិ តទត៌្ហំ យុឞ្មាភ្យម៑ ឯតាំ កថាំ កថយាមិ យុឞ្មាភិះ សាទ៌្ធម៑ អហំ តិឞ្ឋន៑ ប្រថមំ តាំ យុឞ្មភ្យំ នាកថយំ។</para>
  <para style="p">
    <verse number="5" style="v"/>សាម្ប្រតំ ស្វស្យ ប្រេរយិតុះ សមីបំ គច្ឆាមិ តថាបិ ត្វំ ក្ក គច្ឆសិ កថាមេតាំ យុឞ្មាកំ កោបិ មាំ ន ប្ឫច្ឆតិ។</para>
  <para style="p">
    <verse number="6" style="v"/>កិន្តុ មយោក្តាភិរាភិះ កថាភិ រ្យូឞ្មាកម៑ អន្តះករណានិ ទុះខេន បូណ៌ាន្យភវន៑។</para>
  <para style="p">
    <verse number="7" style="v"/>តថាប្យហំ យថាត៌្ហំ កថយាមិ មម គមនំ យុឞ្មាកំ ហិតាត៌្ហមេវ, យតោ ហេតោ រ្គមនេ ន ក្ឫតេ សហាយោ យុឞ្មាកំ សមីបំ នាគមិឞ្យតិ កិន្តុ យទិ គច្ឆាមិ តហ៌ិ យុឞ្មាកំ សមីបេ តំ ប្រេឞយិឞ្យាមិ។</para>
  <para style="p">
    <verse number="8" style="v"/>តតះ ស អាគត្យ បាបបុណ្យទណ្ឌេឞុ ជគតោ លោកានាំ ប្រពោធំ ជនយិឞ្យតិ។</para>
  <para style="p">
    <verse number="9" style="v"/>តេ មយិ ន វិឝ្វសន្តិ តស្មាទ្ធេតោះ បាបប្រពោធំ ជនយិឞ្យតិ។</para>
  <para style="p">
    <verse number="10" style="v"/>យុឞ្មាកម៑ អទ្ឫឝ្យះ សន្នហំ បិតុះ សមីបំ គច្ឆាមិ តស្មាទ៑ បុណ្យេ ប្រពោធំ ជនយិឞ្យតិ។</para>
  <para style="p">
    <verse number="11" style="v"/>ឯតជ្ជគតោៜធិបតិ រ្ទណ្ឌាជ្ញាំ ប្រាប្នោតិ តស្មាទ៑ ទណ្ឌេ ប្រពោធំ ជនយិឞ្យតិ។</para>
  <para style="p">
    <verse number="12" style="v"/>យុឞ្មភ្យំ កថយិតុំ មមានេកាះ កថា អាសតេ, តាះ កថា ឥទានីំ យូយំ សោឍុំ ន ឝក្នុថ;</para>
  <para style="p">
    <verse number="13" style="v"/>កិន្តុ សត្យមយ អាត្មា យទា សមាគមិឞ្យតិ តទា សវ៌្វំ សត្យំ យុឞ្មាន៑ នេឞ្យតិ, ស ស្វតះ កិមបិ ន វទិឞ្យតិ កិន្តុ យច្ឆ្រោឞ្យតិ តទេវ កថយិត្វា ភាវិកាយ៌្យំ យុឞ្មាន៑ ជ្ញាបយិឞ្យតិ។</para>
  <para style="p">
    <verse number="14" style="v"/>មម មហិមានំ ប្រកាឝយិឞ្យតិ យតោ មទីយាំ កថាំ គ្ឫហីត្វា យុឞ្មាន៑ ពោធយិឞ្យតិ។</para>
  <para style="p">
    <verse number="15" style="v"/>បិតុ រ្យទ្យទ៑ អាស្តេ តត៑ សវ៌្វំ មម តស្មាទ៑ ការណាទ៑ អវាទិឞំ ស មទីយាំ កថាំ គ្ឫហីត្វា យុឞ្មាន៑ ពោធយិឞ្យតិ។</para>
  <para style="p">
    <verse number="16" style="v"/>កិយត្កាលាត៑ បរំ យូយំ មាំ ទ្រឞ្ដុំ ន លប្ស្យធ្វេ កិន្តុ កិយត្កាលាត៑ បរំ បុន រ្ទ្រឞ្ដុំ លប្ស្យធ្វេ យតោហំ បិតុះ សមីបំ គច្ឆាមិ។</para>
  <para style="p">
    <verse number="17" style="v"/>តតះ ឝិឞ្យាណាំ កិយន្តោ ជនាះ បរស្បរំ វទិតុម៑ អារភន្ត, កិយត្កាលាត៑ បរំ មាំ ទ្រឞ្ដុំ ន លប្ស្យធ្វេ កិន្តុ កិយត្កាលាត៑ បរំ បុន រ្ទ្រឞ្ដុំ លប្ស្យធ្វេ យតោហំ បិតុះ សមីបំ គច្ឆាមិ, ឥតិ យទ៑ វាក្យម៑ អយំ វទតិ តត៑ កិំ?</para>
  <para style="p">
    <verse number="18" style="v"/>តតះ កិយត្កាលាត៑ បរម៑ ឥតិ តស្យ វាក្យំ កិំ? តស្យ វាក្យស្យាភិប្រាយំ វយំ ពោទ្ធុំ ន ឝក្នុមស្តៃរិតិ</para>
  <para style="p">
    <verse number="19" style="v"/>និគទិតេ យីឝុស្តេឞាំ ប្រឝ្នេច្ឆាំ ជ្ញាត្វា តេភ្យោៜកថយត៑ កិយត្កាលាត៑ បរំ មាំ ទ្រឞ្ដុំ ន លប្ស្យធ្វេ, កិន្តុ កិយត្កាលាត៑ បរំ បូន រ្ទ្រឞ្ដុំ លប្ស្យធ្វេ, យាមិមាំ កថាមកថយំ តស្យា អភិប្រាយំ កិំ យូយំ បរស្បរំ ម្ឫគយធ្វេ?</para>
  <para style="p">
    <verse number="20" style="v"/>យុឞ្មានហម៑ អតិយថាត៌្ហំ វទាមិ យូយំ ក្រន្ទិឞ្យថ វិលបិឞ្យថ ច, កិន្តុ ជគតោ លោកា អានន្ទិឞ្យន្តិ; យូយំ ឝោកាកុលា ភវិឞ្យថ កិន្តុ ឝោកាត៑ បរំ អានន្ទយុក្តា ភវិឞ្យថ។</para>
  <para style="p">
    <verse number="21" style="v"/>ប្រសវកាល ឧបស្ថិតេ នារី យថា ប្រសវវេទនយា វ្យាកុលា ភវតិ កិន្តុ បុត្រេ ភូមិឞ្ឋេ សតិ មនុឞ្យៃកោ ជន្មនា នរលោកេ ប្រវិឞ្ដ ឥត្យានន្ទាត៑ តស្យាស្តត្សវ៌្វំ ទុះខំ មនសិ ន តិឞ្ឋតិ,</para>
  <para style="p">
    <verse number="22" style="v"/>តថា យូយមបិ សាម្ប្រតំ ឝោកាកុលា ភវថ កិន្តុ បុនរបិ យុឞ្មភ្យំ ទឝ៌នំ ទាស្យាមិ តេន យុឞ្មាកម៑ អន្តះករណានិ សានន្ទានិ ភវិឞ្យន្តិ, យុឞ្មាកំ តម៑ អានន្ទញ្ច កោបិ ហត៌្តុំ ន ឝក្ឞ្យតិ។</para>
  <para style="p">
    <verse number="23" style="v"/>តស្មិន៑ ទិវសេ កាមបិ កថាំ មាំ ន ប្រក្ឞ្យថ។ យុឞ្មានហម៑ អតិយថាត៌្ហំ វទាមិ, មម នាម្នា យត៑ កិញ្ចិទ៑ បិតរំ យាចិឞ្យធ្វេ តទេវ ស ទាស្យតិ។</para>
  <para style="p">
    <verse number="24" style="v"/>បូវ៌្វេ មម នាម្នា កិមបិ នាយាចធ្វំ, យាចធ្វំ តតះ ប្រាប្ស្យថ តស្មាទ៑ យុឞ្មាកំ សម្បូណ៌ានន្ទោ ជនិឞ្យតេ។</para>
  <para style="p">
    <verse number="25" style="v"/>ឧបមាកថាភិះ សវ៌្វាណ្យេតានិ យុឞ្មាន៑ ជ្ញាបិតវាន៑ កិន្តុ យស្មិន៑ សមយេ ឧបមយា នោក្ត្វា បិតុះ កថាំ ស្បឞ្ដំ ជ្ញាបយិឞ្យាមិ សមយ ឯតាទ្ឫឝ អាគច្ឆតិ។</para>
  <para style="p">
    <verse number="26" style="v"/>តទា មម នាម្នា ប្រាត៌្ហយិឞ្យធ្វេ ៜហំ យុឞ្មន្និមិត្តំ បិតរំ វិនេឞ្យេ កថាមិមាំ ន វទាមិ;</para>
  <para style="p">
    <verse number="27" style="v"/>យតោ យូយំ មយិ ប្រេម កុរុថ, តថាហម៑ ឦឝ្វរស្យ សមីបាទ៑ អាគតវាន៑ ឥត្យបិ ប្រតីថ, តស្មាទ៑ ការណាត៑ ការណាត៑ បិតា ស្វយំ យុឞ្មាសុ ប្រីយតេ។</para>
  <para style="p">
    <verse number="28" style="v"/>បិតុះ សមីបាជ្ជជទ៑ អាគតោស្មិ ជគត៑ បរិត្យជ្យ ច បុនរបិ បិតុះ សមីបំ គច្ឆាមិ។</para>
  <para style="p">
    <verse number="29" style="v"/>តទា ឝិឞ្យា អវទន៑, ហេ ប្រភោ ភវាន៑ ឧបមយា នោក្ត្វាធុនា ស្បឞ្ដំ វទតិ។</para>
  <para style="p">
    <verse number="30" style="v"/>ភវាន៑ សវ៌្វជ្ញះ កេនចិត៑ ប្ឫឞ្ដោ ភវិតុមបិ ភវតះ ប្រយោជនំ នាស្តីត្យធុនាស្មាកំ ស្ថិរជ្ញានំ ជាតំ តស្មាទ៑ ភវាន៑ ឦឝ្វរស្យ សមីបាទ៑ អាគតវាន៑ ឥត្យត្រ វយំ វិឝ្វសិមះ។</para>
  <para style="p">
    <verse number="31" style="v"/>តតោ យីឝុះ ប្រត្យវាទីទ៑ ឥទានីំ កិំ យូយំ វិឝ្វសិថ?</para>
  <para style="p">
    <verse number="32" style="v"/>បឝ្យត សវ៌្វេ យូយំ វិកីណ៌ាះ សន្តោ មាម៑ ឯកាកិនំ បីរត្យជ្យ ស្វំ ស្វំ ស្ថានំ គមិឞ្យថ, ឯតាទ្ឫឝះ សមយ អាគច្ឆតិ វរំ ប្រាយេណោបស្ថិតវាន៑; តថាប្យហំ នៃកាកី ភវាមិ យតះ បិតា មយា សាទ៌្ធម៑ អាស្តេ។</para>
  <para style="p">
    <verse number="33" style="v"/>យថា មយា យុឞ្មាកំ ឝាន្តិ រ្ជាយតេ តទត៌្ហម៑ ឯតាះ កថា យុឞ្មភ្យម៑ អចកថំ; អស្មិន៑ ជគតិ យុឞ្មាកំ ក្លេឝោ ឃដិឞ្យតេ កិន្ត្វក្ឞោភា ភវត យតោ មយា ជគជ្ជិតំ។</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តតះ បរំ យីឝុរេតាះ កថាះ កថយិត្វា ស្វគ៌ំ វិលោក្យៃតត៑ ប្រាត៌្ហយត៑, ហេ បិតះ សមយ ឧបស្ថិតវាន៑; យថា តវ បុត្រស្តវ មហិមានំ ប្រកាឝយតិ តទត៌្ហំ ត្វំ និជបុត្រស្យ មហិមានំ ប្រកាឝយ។</para>
  <para style="p">
    <verse number="2" style="v"/>ត្វំ យោល្លោកាន៑ តស្យ ហស្តេ សមប៌ិតវាន៑ ស យថា តេភ្យោៜនន្តាយុ រ្ទទាតិ តទត៌្ហំ ត្វំ ប្រាណិមាត្រាណាម៑ អធិបតិត្វភារំ តស្មៃ ទត្តវាន៑។</para>
  <para style="p">
    <verse number="3" style="v"/>យស្ត្វម៑ អទ្វិតីយះ សត្យ ឦឝ្វរស្ត្វយា ប្រេរិតឝ្ច យីឝុះ ខ្រីឞ្ដ ឯតយោរុភយោះ បរិចយេ ប្រាប្តេៜនន្តាយុ រ្ភវតិ។</para>
  <para style="p">
    <verse number="4" style="v"/>ត្វំ យស្យ កម៌្មណោ ភារំ មហ្យំ ទត្តវាន៑, តត៑ សម្បន្នំ ក្ឫត្វា ជគត្យស្មិន៑ តវ មហិមានំ ប្រាកាឝយំ។</para>
  <para style="p">
    <verse number="5" style="v"/>អតឯវ ហេ បិត រ្ជគត្យវិទ្យមានេ ត្វយា សហ តិឞ្ឋតោ មម យោ មហិមាសីត៑ សម្ប្រតិ តវ សមីបេ មាំ តំ មហិមានំ ប្រាបយ។</para>
  <para style="p">
    <verse number="6" style="v"/>អន្យច្ច ត្វម៑ ឯតជ្ជគតោ យាល្លោកាន៑ មហ្យម៑ អទទា អហំ តេភ្យស្តវ នាម្នស្តត្ត្វជ្ញានម៑ អទទាំ, តេ តវៃវាសន៑, ត្វំ តាន៑ មហ្យមទទាះ, តស្មាត្តេ តវោបទេឝម៑ អគ្ឫហ្លន៑។</para>
  <para style="p">
    <verse number="7" style="v"/>ត្វំ មហ្យំ យត៑ កិញ្ចិទ៑ អទទាស្តត្សវ៌្វំ ត្វត្តោ ជាយតេ ឥត្យធុនាជានន៑។</para>
  <para style="p">
    <verse number="8" style="v"/>មហ្យំ យមុបទេឝម៑ អទទា អហមបិ តេភ្យស្តមុបទេឝម៑ អទទាំ តេបិ តមគ្ឫហ្លន៑ ត្វត្តោហំ និគ៌ត្យ ត្វយា ប្រេរិតោភវម៑ អត្រ ច វ្យឝ្វសន៑។</para>
  <para style="p">
    <verse number="9" style="v"/>តេឞាមេវ និមិត្តំ ប្រាត៌្ហយេៜហំ ជគតោ លោកនិមិត្តំ ន ប្រាត៌្ហយេ កិន្តុ យាល្លោកាន៑ មហ្យម៑ អទទាស្តេឞាមេវ និមិត្តំ ប្រាត៌្ហយេៜហំ យតស្តេ តវៃវាសតេ។</para>
  <para style="p">
    <verse number="10" style="v"/>យេ មម តេ តវ យេ ច តវ តេ មម តថា តៃ រ្មម មហិមា ប្រកាឝ្យតេ។</para>
  <para style="p">
    <verse number="11" style="v"/>សាម្ប្រតម៑ អស្មិន៑ ជគតិ មមាវស្ថិតេះ ឝេឞម៑ អភវត៑ អហំ តវ សមីបំ គច្ឆាមិ កិន្តុ តេ ជគតិ ស្ថាស្យន្តិ; ហេ បវិត្រ បិតរាវយោ រ្យថៃកត្វមាស្តេ តថា តេឞាមប្យេកត្វំ ភវតិ តទត៌្ហំ យាល្លោកាន៑ មហ្យម៑ អទទាស្តាន៑ ស្វនាម្នា រក្ឞ។</para>
  <para style="p">
    <verse number="12" style="v"/>យាវន្តិ ទិនានិ ជគត្យស្មិន៑ តៃះ សហាហមាសំ តាវន្តិ ទិនានិ តាន៑ តវ នាម្នាហំ រក្ឞិតវាន៑; យាល្លោកាន៑ មហ្យម៑ អទទាស្តាន៑ សវ៌្វាន៑ អហមរក្ឞំ, តេឞាំ មធ្យេ កេវលំ វិនាឝបាត្រំ ហារិតំ តេន ធម៌្មបុស្តកស្យ វចនំ ប្រត្យក្ឞំ ភវតិ។</para>
  <para style="p">
    <verse number="13" style="v"/>កិន្ត្វធុនា តវ សន្និធិំ គច្ឆាមិ មយា យថា តេឞាំ សម្បូណ៌ានន្ទោ ភវតិ តទត៌្ហមហំ ជគតិ តិឞ្ឋន៑ ឯតាះ កថា អកថយម៑។</para>
  <para style="p">
    <verse number="14" style="v"/>តវោបទេឝំ តេភ្យោៜទទាំ ជគតា សហ យថា មម សម្ពន្ធោ នាស្តិ តថា ជជតា សហ តេឞាមបិ សម្ពន្ធាភាវាជ៑ ជគតោ លោកាស្តាន៑ ឫតីយន្តេ។</para>
  <para style="p">
    <verse number="15" style="v"/>ត្វំ ជគតស្តាន៑ គ្ឫហាណេតិ ន ប្រាត៌្ហយេ កិន្ត្វឝុភាទ៑ រក្ឞេតិ ប្រាត៌្ហយេហម៑។</para>
  <para style="p">
    <verse number="16" style="v"/>អហំ យថា ជគត្សម្ពន្ធីយោ ន ភវាមិ តថា តេបិ ជគត្សម្ពន្ធីយា ន ភវន្តិ។</para>
  <para style="p">
    <verse number="17" style="v"/>តវ សត្យកថយា តាន៑ បវិត្រីកុរុ តវ វាក្យមេវ សត្យំ។</para>
  <para style="p">
    <verse number="18" style="v"/>ត្វំ យថា មាំ ជគតិ ប្រៃរយស្តថាហមបិ តាន៑ ជគតិ ប្រៃរយំ។</para>
  <para style="p">
    <verse number="19" style="v"/>តេឞាំ ហិតាត៌្ហំ យថាហំ ស្វំ បវិត្រីករោមិ តថា សត្យកថយា តេបិ បវិត្រីភវន្តុ។</para>
  <para style="p">
    <verse number="20" style="v"/>កេវលំ ឯតេឞាមត៌្ហេ ប្រាត៌្ហយេៜហម៑ ឥតិ ន កិន្ត្វេតេឞាមុបទេឝេន យេ ជនា មយិ វិឝ្វសិឞ្យន្តិ តេឞាមប្យត៌្ហេ ប្រាត៌្ហេយេៜហម៑។</para>
  <para style="p">
    <verse number="21" style="v"/>ហេ បិតស្តេឞាំ សវ៌្វេឞាម៑ ឯកត្វំ ភវតុ តវ យថា មយិ មម ច យថា ត្វយ្យេកត្វំ តថា តេឞាមប្យាវយោរេកត្វំ ភវតុ តេន ត្វំ មាំ ប្រេរិតវាន៑ ឥតិ ជគតោ លោកាះ ប្រតិយន្តុ។</para>
  <para style="p">
    <verse number="22" style="v"/>យថាវយោរេកត្វំ តថា តេឞាមប្យេកត្វំ ភវតុ តេឞ្វហំ មយិ ច ត្វម៑ ឥត្ថំ តេឞាំ សម្បូណ៌មេកត្វំ ភវតុ, ត្វំ ប្រេរិតវាន៑ ត្វំ មយិ យថា ប្រីយសេ ច តថា តេឞ្វបិ ប្រីតវាន៑ ឯតទ្យថា ជគតោ លោកា ជានន្តិ</para>
  <para style="p">
    <verse number="23" style="v"/>តទត៌្ហំ ត្វំ យំ មហិមានំ មហ្យម៑ អទទាស្តំ មហិមានម៑ អហមបិ តេភ្យោ ទត្តវាន៑។</para>
  <para style="p">
    <verse number="24" style="v"/>ហេ បិត រ្ជគតោ និម៌្មាណាត៑ បូវ៌្វំ មយិ ស្នេហំ ក្ឫត្វា យំ មហិមានំ ទត្តវាន៑ មម តំ មហិមានំ យថា តេ បឝ្យន្តិ តទត៌្ហំ យាល្លោកាន៑ មហ្យំ ទត្តវាន៑ អហំ យត្រ តិឞ្ឋាមិ តេបិ យថា តត្រ តិឞ្ឋន្តិ មមៃឞា វាញ្ឆា។</para>
  <para style="p">
    <verse number="25" style="v"/>ហេ យថាត៌្ហិក បិត រ្ជគតោ លោកៃស្ត្វយ្យជ្ញាតេបិ ត្វាមហំ ជានេ ត្វំ មាំ ប្រេរិតវាន៑ ឥតីមេ ឝិឞ្យា ជានន្តិ។</para>
  <para style="p">
    <verse number="26" style="v"/>យថាហំ តេឞុ តិឞ្ឋាមិ តថា មយិ យេន ប្រេម្នា ប្រេមាករោស្តត៑ តេឞុ តិឞ្ឋតិ តទត៌្ហំ តវ នាមាហំ តាន៑ ជ្ញាបិតវាន៑ បុនរបិ ជ្ញាបយិឞ្យាមិ។</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តាះ កថាះ កថយិត្វា យីឝុះ ឝិឞ្យានាទាយ កិទ្រោន្នាមកំ ស្រោត ឧត្តីយ៌្យ ឝិឞ្យៃះ សហ តត្រត្យោទ្យានំ ប្រាវិឝត៑។</para>
  <para style="p">
    <verse number="2" style="v"/>កិន្តុ វិឝ្វាសឃាតិយិហូទាស្តត៑ ស្ថានំ បរិចីយតេ យតោ យីឝុះ ឝិឞ្យៃះ សាទ៌្ធំ កទាចិត៑ តត៑ ស្ថានម៑ អគច្ឆត៑។</para>
  <para style="p">
    <verse number="3" style="v"/>តទា ស យិហូទាះ សៃន្យគណំ ប្រធានយាជកានាំ ផិរូឝិនាញ្ច បទាតិគណញ្ច គ្ឫហីត្វា ប្រទីបាន៑ ឧល្កាន៑ អស្ត្រាណិ ចាទាយ តស្មិន៑ ស្ថាន ឧបស្ថិតវាន៑។</para>
  <para style="p">
    <verse number="4" style="v"/>ស្វំ ប្រតិ យទ៑ ឃដិឞ្យតេ តជ៑ ជ្ញាត្វា យីឝុរគ្រេសរះ សន៑ តានប្ឫច្ឆត៑ កំ គវេឞយថ?</para>
  <para style="p">
    <verse number="5" style="v"/>តេ ប្រត្យវទន៑, នាសរតីយំ យីឝុំ; តតោ យីឝុរវាទីទ៑ អហមេវ សះ; តៃះ សហ វិឝ្វាសឃាតី យិហូទាឝ្ចាតិឞ្ឋត៑។</para>
  <para style="p">
    <verse number="6" style="v"/>តទាហមេវ ស តស្យៃតាំ កថាំ ឝ្រុត្វៃវ តេ បឝ្ចាទេត្យ ភូមៅ បតិតាះ។</para>
  <para style="p">
    <verse number="7" style="v"/>តតោ យីឝុះ បុនរបិ ប្ឫឞ្ឋវាន៑ កំ គវេឞយថ? តតស្តេ ប្រត្យវទន៑ នាសរតីយំ យីឝុំ។</para>
  <para style="p">
    <verse number="8" style="v"/>តទា យីឝុះ ប្រត្យុទិតវាន៑ អហមេវ ស ឥមាំ កថាមចកថម៑; យទិ មាមន្វិច្ឆថ តហ៌ីមាន៑ គន្តុំ មា វារយត។</para>
  <para style="p">
    <verse number="9" style="v"/>ឥត្ថំ ភូតេ មហ្យំ យាល្លោកាន៑ អទទាស្តេឞាម៑ ឯកមបិ នាហារយម៑ ឥមាំ យាំ កថាំ ស ស្វយមកថយត៑ សា កថា សផលា ជាតា។</para>
  <para style="p">
    <verse number="10" style="v"/>តទា ឝិមោន្បិតរស្យ និកដេ ខង្គល្ស្ថិតេះ ស តំ និឞ្កោឞំ ក្ឫត្វា មហាយាជកស្យ មាល្ខនាមានំ ទាសម៑ អាហត្យ តស្យ ទក្ឞិណកណ៌ំ ឆិន្នវាន៑។</para>
  <para style="p">
    <verse number="11" style="v"/>តតោ យីឝុះ បិតរម៑ អវទត៑, ខង្គំ កោឞេ ស្ថាបយ មម បិតា មហ្យំ បាតុំ យំ កំសម៑ អទទាត៑ តេនាហំ កិំ ន បាស្យាមិ?</para>
  <para style="p">
    <verse number="12" style="v"/>តទា សៃន្យគណះ សេនាបតិ រ្យិហូទីយានាំ បទាតយឝ្ច យីឝុំ ឃ្ឫត្វា ពទ្ធ្វា ហានន្នាម្នះ កិយផាះ ឝ្វឝុរស្យ សមីបំ ប្រថមម៑ អនយន៑។</para>
  <para style="p">
    <verse number="13" style="v"/>ស កិយផាស្តស្មិន៑ វត្សរេ មហាយាជត្វបទេ និយុក្តះ</para>
  <para style="p">
    <verse number="14" style="v"/>សន៑ សាធារណលោកានាំ មង្គលាត៌្ហម៑ ឯកជនស្យ មរណមុចិតម៑ ឥតិ យិហូទីយៃះ សាទ៌្ធម៑ អមន្ត្រយត៑។</para>
  <para style="p">
    <verse number="15" style="v"/>តទា ឝិមោន្បិតរោៜន្យៃកឝិឞ្យឝ្ច យីឝោះ បឝ្ចាទ៑ អគច្ឆតាំ តស្យាន្យឝិឞ្យស្យ មហាយាជកេន បរិចិតត្វាត៑ ស យីឝុនា សហ មហាយាជកស្យាដ្ដាលិកាំ ប្រាវិឝត៑។</para>
  <para style="p">
    <verse number="16" style="v"/>កិន្តុ បិតរោ ពហិទ៌្វារស្យ សមីបេៜតិឞ្ឋទ៑ អតឯវ មហាយាជកេន បរិចិតះ ស ឝិឞ្យះ បុនព៌ហិគ៌ត្វា ទៅវាយិកាយៃ កថយិត្វា បិតរម៑ អភ្យន្តរម៑ អានយត៑។</para>
  <para style="p">
    <verse number="17" style="v"/>តទា ស ទ្វាររក្ឞិកា បិតរម៑ អវទត៑ ត្វំ កិំ ន តស្យ មានវស្យ ឝិឞ្យះ? តតះ សោវទទ៑ អហំ ន ភវាមិ។</para>
  <para style="p">
    <verse number="18" style="v"/>តតះ បរំ យត្ស្ថានេ ទាសាះ បទាតយឝ្ច ឝីតហេតោរង្គារៃ រ្វហ្និំ ប្រជ្វាល្យ តាបំ សេវិតវន្តស្តត្ស្ថានេ បិតរស្តិឞ្ឋន៑ តៃះ សហ វហ្និតាបំ សេវិតុម៑ អារភត។</para>
  <para style="p">
    <verse number="19" style="v"/>តទា ឝិឞ្យេឞូបទេឝេ ច មហាយាជកេន យីឝុះ ប្ឫឞ្ដះ</para>
  <para style="p">
    <verse number="20" style="v"/>សន៑ ប្រត្យុក្តវាន៑ សវ៌្វលោកានាំ សមក្ឞំ កថាមកថយំ គុប្តំ កាមបិ កថាំ ន កថយិត្វា យត៑ ស្ថានំ យិហូទីយាះ សតតំ គច្ឆន្តិ តត្រ ភជនគេហេ មន្ទិរេ ចាឝិក្ឞយំ។</para>
  <para style="p">
    <verse number="21" style="v"/>មត្តះ កុតះ ប្ឫច្ឆសិ? យេ ជនា មទុបទេឝម៑ អឝ្ឫណ្វន៑ តានេវ ប្ឫច្ឆ យទ្យទ៑ អវទំ តេ តត៑ ជានិន្ត។</para>
  <para style="p">
    <verse number="22" style="v"/>តទេត្ថំ ប្រត្យុទិតត្វាត៑ និកដស្ថបទាតិ រ្យីឝុំ ចបេដេនាហត្យ វ្យាហរត៑ មហាយាជកម៑ ឯវំ ប្រតិវទសិ?</para>
  <para style="p">
    <verse number="23" style="v"/>តតោ យីឝុះ ប្រតិគទិតវាន៑ យទ្យយថាត៌្ហម៑ អចកថំ តហ៌ិ តស្យាយថាត៌្ហស្យ ប្រមាណំ ទេហិ, កិន្តុ យទិ យថាត៌្ហំ តហ៌ិ កុតោ ហេតោ រ្មាម៑ អតាឌយះ?</para>
  <para style="p">
    <verse number="24" style="v"/>បូវ៌្វំ ហានន៑ សពន្ធនំ តំ កិយផាមហាយាជកស្យ សមីបំ ប្រៃឞយត៑។</para>
  <para style="p">
    <verse number="25" style="v"/>ឝិមោន្បិតរស្តិឞ្ឋន៑ វហ្និតាបំ សេវតេ, ឯតស្មិន៑ សមយេ កិយន្តស្តម៑ អប្ឫច្ឆន៑ ត្វំ កិម៑ ឯតស្យ ជនស្យ ឝិឞ្យោ ន? តតះ សោបហ្នុត្យាព្រវីទ៑ អហំ ន ភវាមិ។</para>
  <para style="p">
    <verse number="26" style="v"/>តទា មហាយាជកស្យ យស្យ ទាសស្យ បិតរះ កណ៌មច្ឆិនត៑ តស្យ កុដុម្ពះ ប្រត្យុទិតវាន៑ ឧទ្យានេ តេន សហ តិឞ្ឋន្តំ ត្វាំ កិំ នាបឝ្យំ?</para>
  <para style="p">
    <verse number="27" style="v"/>កិន្តុ បិតរះ បុនរបហ្នុត្យ កថិតវាន៑; តទានីំ កុក្កុដោៜរៅត៑។</para>
  <para style="p">
    <verse number="28" style="v"/>តទនន្តរំ ប្រត្យូឞេ តេ កិយផាគ្ឫហាទ៑ អធិបតេ រ្គ្ឫហំ យីឝុម៑ អនយន៑ កិន្តុ យស្មិន៑ អឝុចិត្វេ ជាតេ តៃ រ្និស្តារោត្សវេ ន ភោក្តវ្យំ, តស្យ ភយាទ៑ យិហូទីយាស្តទ្គ្ឫហំ នាវិឝន៑។</para>
  <para style="p">
    <verse number="29" style="v"/>អបរំ បីលាតោ ពហិរាគត្យ តាន៑ ប្ឫឞ្ឋវាន៑ ឯតស្យ មនុឞ្យស្យ កំ ទោឞំ វទថ?</para>
  <para style="p">
    <verse number="30" style="v"/>តទា តេ បេត្យវទន៑ ទុឞ្កម៌្មការិណិ ន សតិ ភវតះ សមីបេ នៃនំ សមាប៌យិឞ្យាមះ។</para>
  <para style="p">
    <verse number="31" style="v"/>តតះ បីលាតោៜវទទ៑ យូយមេនំ គ្ឫហីត្វា ស្វេឞាំ វ្យវស្ថយា វិចារយត។ តទា យិហូទីយាះ ប្រត្យវទន៑ កស្យាបិ មនុឞ្យស្យ ប្រាណទណ្ឌំ កត៌្តុំ នាស្មាកម៑ អធិការោៜស្តិ។</para>
  <para style="p">
    <verse number="32" style="v"/>ឯវំ សតិ យីឝុះ ស្វស្យ ម្ឫត្យៅ យាំ កថាំ កថិតវាន៑ សា សផលាភវត៑។</para>
  <para style="p">
    <verse number="33" style="v"/>តទនន្តរំ បីលាតះ បុនរបិ តទ៑ រាជគ្ឫហំ គត្វា យីឝុមាហូយ ប្ឫឞ្ដវាន៑ ត្វំ កិំ យិហូទីយានាំ រាជា?</para>
  <para style="p">
    <verse number="34" style="v"/>យីឝុះ ប្រត្យវទត៑ ត្វម៑ ឯតាំ កថាំ ស្វតះ កថយសិ កិមន្យះ កឝ្ចិន៑ មយិ កថិតវាន៑?</para>
  <para style="p">
    <verse number="35" style="v"/>បីលាតោៜវទទ៑ អហំ កិំ យិហូទីយះ? តវ ស្វទេឝីយា វិឝេឞតះ ប្រធានយាជកា មម និកដេ ត្វាំ សមាប៌យន, ត្វំ កិំ ក្ឫតវាន៑?</para>
  <para style="p">
    <verse number="36" style="v"/>យីឝុះ ប្រត្យវទត៑ មម រាជ្យម៑ ឯតជ្ជគត្សម្ពន្ធីយំ ន ភវតិ យទិ មម រាជ្យំ ជគត្សម្ពន្ធីយម៑ អភវិឞ្យត៑ តហ៌ិ យិហូទីយានាំ ហស្តេឞុ យថា សមប៌ិតោ នាភវំ តទត៌្ហំ មម សេវកា អយោត្ស្យន៑ កិន្តុ មម រាជ្យម៑ ឰហិកំ ន។</para>
  <para style="p">
    <verse number="37" style="v"/>តទា បីលាតះ កថិតវាន៑, តហ៌ិ ត្វំ រាជា ភវសិ? យីឝុះ ប្រត្យុក្តវាន៑ ត្វំ សត្យំ កថយសិ, រាជាហំ ភវាមិ; សត្យតាយាំ សាក្ឞ្យំ ទាតុំ ជនិំ គ្ឫហីត្វា ជគត្យស្មិន៑ អវតីណ៌វាន៑, តស្មាត៑ សត្យធម៌្មបក្ឞបាតិនោ មម កថាំ ឝ្ឫណ្វន្តិ។</para>
  <para style="p">
    <verse number="38" style="v"/>តទា សត្យំ កិំ? ឯតាំ កថាំ បឞ្ដ្វា បីលាតះ បុនរបិ ពហិគ៌ត្វា យិហូទីយាន៑ អភាឞត, អហំ តស្យ កមប្យបរាធំ ន ប្រាប្នោមិ។</para>
  <para style="p">
    <verse number="39" style="v"/>និស្តារោត្សវសមយេ យុឞ្មាភិរភិរុចិត ឯកោ ជនោ មយា មោចយិតវ្យ ឯឞា យុឞ្មាកំ រីតិរស្តិ, អតឯវ យុឞ្មាកំ និកដេ យិហូទីយានាំ រាជានំ កិំ មោចយាមិ, យុឞ្មាកម៑ ឥច្ឆា កា?</para>
  <para style="p">
    <verse number="40" style="v"/>តទា តេ សវ៌្វេ រុវន្តោ វ្យាហរន៑ ឯនំ មានុឞំ នហិ ពរព្ពាំ មោចយ។ កិន្តុ ស ពរព្ពា ទស្យុរាសីត៑។</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>បីលាតោ យីឝុម៑ អានីយ កឝយា ប្រាហារយត៑។</para>
  <para style="p">
    <verse number="2" style="v"/>បឝ្ចាត៑ សេនាគណះ កណ្ដកនិម៌្មិតំ មុកុដំ តស្យ មស្តកេ សមប៌្យ វាត៌្តាកីវណ៌ំ រាជបរិច្ឆទំ បរិធាប្យ,</para>
  <para style="p">
    <verse number="3" style="v"/>ហេ យិហូទីយានាំ រាជន៑ នមស្ការ ឥត្យុក្ត្វា តំ ចបេដេនាហន្តុម៑ អារភត។</para>
  <para style="p">
    <verse number="4" style="v"/>តទា បីលាតះ បុនរបិ ពហិគ៌ត្វា លោកាន៑ អវទត៑, អស្យ កមប្យបរាធំ ន លភេៜហំ, បឝ្យត តទ៑ យុឞ្មាន៑ ជ្ញាបយិតុំ យុឞ្មាកំ សន្និធៅ ពហិរេនម៑ អានយាមិ។</para>
  <para style="p">
    <verse number="5" style="v"/>តតះ បរំ យីឝុះ កណ្ដកមុកុដវាន៑ វាត៌្តាកីវណ៌វសនវាំឝ្ច ពហិរាគច្ឆត៑។ តតះ បីលាត ឧក្តវាន៑ ឯនំ មនុឞ្យំ បឝ្យត។</para>
  <para style="p">
    <verse number="6" style="v"/>តទា ប្រធានយាជកាះ បទាតយឝ្ច តំ ទ្ឫឞ្ដ្វា, ឯនំ ក្រុឝេ វិធ, ឯនំ ក្រុឝេ វិធ, ឥត្យុក្ត្វា រវិតុំ អារភន្ត។ តតះ បីលាតះ កថិតវាន៑ យូយំ ស្វយម៑ ឯនំ នីត្វា ក្រុឝេ វិធត, អហម៑ ឯតស្យ កមប្យបរាធំ ន ប្រាប្តវាន៑។</para>
  <para style="p">
    <verse number="7" style="v"/>យិហូទីយាះ ប្រត្យវទន៑ អស្មាកំ យា វ្យវស្ថាស្តេ តទនុសារេណាស្យ ប្រាណហននម៑ ឧចិតំ យតោយំ ស្វម៑ ឦឝ្វរស្យ បុត្រមវទត៑។</para>
  <para style="p">
    <verse number="8" style="v"/>បីលាត ឥមាំ កថាំ ឝ្រុត្វា មហាត្រាសយុក្តះ</para>
  <para style="p">
    <verse number="9" style="v"/>សន៑ បុនរបិ រាជគ្ឫហ អាគត្យ យីឝុំ ប្ឫឞ្ដវាន៑ ត្វំ កុត្រត្យោ លោកះ? កិន្តុ យីឝស្តស្យ កិមបិ ប្រត្យុត្តរំ នាវទត៑។</para>
  <para style="p">
    <verse number="10" style="v"/>១× តតះ បីលាត៑ កថិតវាន ត្វំ កិំ មយា សាទ៌្ធំ ន សំលបិឞ្យសិ ? ត្វាំ ក្រុឝេ វេធិតុំ វា មោចយិតុំ ឝក្តិ រ្មមាស្តេ ឥតិ កិំ ត្វំ ន ជានាសិ ? តទា យីឝុះ ប្រត្យវទទ៑ ឦឝ្វរេណាទŸाំ មមោបរិ តវ កិមប្យធិបតិត្វំ ន វិទ្យតេ, តថាបិ យោ ជនោ មាំ តវ ហស្តេ សមាប៌យត៑ តស្យ មហាបាតកំ ជាតម៑។</para>
  <para style="p">
    <verse number="11" style="v"/>តទា យីឝុះ ប្រត្យវទទ៑ ឦឝ្វរេណាទត្តំ មមោបរិ តវ កិមប្យធិបតិត្វំ ន វិទ្យតេ, តថាបិ យោ ជនោ មាំ តវ ហស្តេ សមាប៌យត៑ តស្យ មហាបាតកំ ជាតម៑។</para>
  <para style="p">
    <verse number="12" style="v"/>តទារភ្យ បីលាតស្តំ មោចយិតុំ ចេឞ្ដិតវាន៑ កិន្តុ យិហូទីយា រុវន្តោ វ្យាហរន៑ យទីមំ មានវំ ត្យជសិ តហ៌ិ ត្វំ កៃសរស្យ មិត្រំ ន ភវសិ, យោ ជនះ ស្វំ រាជានំ វក្តិ សឯវ កៃមរស្យ វិរុទ្ធាំ កថាំ កថយតិ។</para>
  <para style="p">
    <verse number="13" style="v"/>ឯតាំ កថាំ ឝ្រុត្វា បីលាតោ យីឝុំ ពហិរានីយ និស្តារោត្សវស្យ អាសាទនទិនស្យ ទ្វិតីយប្រហរាត៑ បូវ៌្វំ ប្រស្តរពន្ធននាម្និ ស្ថានេ ៜរ្ថាត៑ ឥព្រីយភាឞយា យទ៑ គព្ពិថា កថ្យតេ តស្មិន៑ ស្ថានេ វិចារាសន ឧបាវិឝត៑។</para>
  <para style="p">
    <verse number="14" style="v"/>អនន្តរំ បីលាតោ យិហូទីយាន៑ អវទត៑, យុឞ្មាកំ រាជានំ បឝ្យត។</para>
  <para style="p">
    <verse number="15" style="v"/>កិន្តុ ឯនំ ទូរីកុរុ, ឯនំ ទូរីកុរុ, ឯនំ ក្រុឝេ វិធ, ឥតិ កថាំ កថយិត្វា តេ រវិតុម៑ អារភន្ត; តទា បីលាតះ កថិតវាន៑ យុឞ្មាកំ រាជានំ កិំ ក្រុឝេ វេធិឞ្យាមិ? ប្រធានយាជកា ឧត្តរម៑ អវទន៑ កៃសរំ វិនា កោបិ រាជាស្មាកំ នាស្តិ។</para>
  <para style="p">
    <verse number="16" style="v"/>តតះ បីលាតោ យីឝុំ ក្រុឝេ វេធិតុំ តេឞាំ ហស្តេឞុ សមាប៌យត៑, តតស្តេ តំ ធ្ឫត្វា នីតវន្តះ។</para>
  <para style="p">
    <verse number="17" style="v"/>តតះ បរំ យីឝុះ ក្រុឝំ វហន៑ ឝិរះកបាលម៑ អត៌្ហាទ៑ យទ៑ ឥព្រីយភាឞយា គុល្គល្តាំ វទន្តិ តស្មិន៑ ស្ថាន ឧបស្ថិតះ។</para>
  <para style="p">
    <verse number="18" style="v"/>តតស្តេ មធ្យស្ថានេ តំ តស្យោភយបាឝ៌្វេ ទ្វាវបរៅ ក្រុឝេៜវិធន៑។</para>
  <para style="p">
    <verse number="19" style="v"/>អបរម៑ ឯឞ យិហូទីយានាំ រាជា នាសរតីយយីឝុះ, ឥតិ វិជ្ញាបនំ លិខិត្វា បីលាតស្តស្យ ក្រុឝោបរិ សមយោជយត៑។</para>
  <para style="p">
    <verse number="20" style="v"/>សា លិបិះ ឥព្រីយយូនានីយរោមីយភាឞាភិ រ្លិខិតា; យីឝោះ ក្រុឝវេធនស្ថានំ នគរស្យ សមីបំ, តស្មាទ៑ ពហវោ យិហូទីយាស្តាំ បឋិតុម៑ អារភន្ត។</para>
  <para style="p">
    <verse number="21" style="v"/>យិហូទីយានាំ ប្រធានយាជកាះ បីលាតមិតិ ន្យវេទយន៑ យិហូទីយានាំ រាជេតិ វាក្យំ ន កិន្តុ ឯឞ ស្វំ យិហូទីយានាំ រាជានម៑ អវទទ៑ ឥត្ថំ លិខតុ។</para>
  <para style="p">
    <verse number="22" style="v"/>តតះ បីលាត ឧត្តរំ ទត្តវាន៑ យល្លេខនីយំ តល្លិខិតវាន៑។</para>
  <para style="p">
    <verse number="23" style="v"/>ឥត្ថំ សេនាគណោ យីឝុំ ក្រុឝេ វិធិត្វា តស្យ បរិធេយវស្ត្រំ ចតុរោ ភាគាន៑ ក្ឫត្វា ឯកៃកសេនា ឯកៃកភាគម៑ អគ្ឫហ្លត៑ តស្យោត្តរីយវស្ត្រញ្ចាគ្ឫហ្លត៑។ កិន្តូត្តរីយវស្ត្រំ សូចិសេវនំ វិនា សវ៌្វម៑ ឩតំ។</para>
  <para style="p">
    <verse number="24" style="v"/>តស្មាត្តេ វ្យាហរន៑ ឯតត៑ កះ ប្រាប្ស្យតិ? តន្ន ខណ្ឌយិត្វា តត្រ គុដិកាបាតំ ករវាម។ វិភជន្តេៜធរីយំ មេ វសនំ តេ បរស្បរំ។ មមោត្តរីយវស្ត្រាត៌្ហំ គុដិកាំ បាតយន្តិ ច។ ឥតិ យទ្វាក្យំ ធម៌្មបុស្តកេ លិខិតមាស្តេ តត៑ សេនាគណេនេត្ថំ វ្យវហរណាត៑ សិទ្ធមភវត៑។</para>
  <para style="p">
    <verse number="25" style="v"/>តទានីំ យីឝោ រ្មាតា មាតុ រ្ភគិនី ច យា ក្លិយបា ភាយ៌្យា មរិយម៑ មគ្ទលីនី មរិយម៑ ច ឯតាស្តស្យ ក្រុឝស្យ សន្និធៅ សមតិឞ្ឋន៑។</para>
  <para style="p">
    <verse number="26" style="v"/>តតោ យីឝុះ ស្វមាតរំ ប្រិយតមឝិឞ្យញ្ច សមីបេ ទណ្ឌាយមានៅ វិលោក្យ មាតរម៑ អវទត៑, ហេ យោឞិទ៑ ឯនំ តវ បុត្រំ បឝ្យ,</para>
  <para style="p">
    <verse number="27" style="v"/>ឝិឞ្យន្ត្វវទត៑, ឯនាំ តវ មាតរំ បឝ្យ។ តតះ ស ឝិឞ្យស្តទ្ឃដិកាយាំ តាំ និជគ្ឫហំ នីតវាន៑។</para>
  <para style="p">
    <verse number="28" style="v"/>អនន្តរំ សវ៌្វំ កម៌្មាធុនា សម្បន្នមភូត៑ យីឝុរិតិ ជ្ញាត្វា ធម៌្មបុស្តកស្យ វចនំ យថា សិទ្ធំ ភវតិ តទត៌្ហម៑ អកថយត៑ មម បិបាសា ជាតា។</para>
  <para style="p">
    <verse number="29" style="v"/>តតស្តស្មិន៑ ស្ថានេ អម្លរសេន បូណ៌បាត្រស្ថិត្យា តេ ស្បញ្ជមេកំ តទម្លរសេនាទ៌្រីក្ឫត្យ ឯសោព្នលេ តទ៑ យោជយិត្វា តស្យ មុខស្យ សន្និធាវស្ថាបយន៑។</para>
  <para style="p">
    <verse number="30" style="v"/>តទា យីឝុរម្លរសំ គ្ឫហីត្វា សវ៌្វំ សិទ្ធម៑ ឥតិ កថាំ កថយិត្វា មស្តកំ នមយន៑ ប្រាណាន៑ បយ៌្យត្យជត៑។</para>
  <para style="p">
    <verse number="31" style="v"/>តទ្វិនម៑ អាសាទនទិនំ តស្មាត៑ បរេៜហនិ វិឝ្រាមវារេ ទេហា យថា ក្រុឝោបរិ ន តិឞ្ឋន្តិ, យតះ ស វិឝ្រាមវារោ មហាទិនមាសីត៑, តស្មាទ៑ យិហូទីយាះ បីលាតនិកដំ គត្វា តេឞាំ បាទភញ្ជនស្យ ស្ថានាន្តរនយនស្យ ចានុមតិំ ប្រាត៌្ហយន្ត។</para>
  <para style="p">
    <verse number="32" style="v"/>អតះ សេនា អាគត្យ យីឝុនា សហ ក្រុឝេ ហតយោះ ប្រថមទ្វិតីយចោរយោះ បាទាន៑ អភញ្ជន៑;</para>
  <para style="p">
    <verse number="33" style="v"/>កិន្តុ យីឝោះ សន្និធិំ គត្វា ស ម្ឫត ឥតិ ទ្ឫឞ្ដ្វា តស្យ បាទៅ នាភញ្ជន៑។</para>
  <para style="p">
    <verse number="34" style="v"/>បឝ្ចាទ៑ ឯកោ យោទ្ធា ឝូលាឃាតេន តស្យ កុក្ឞិម៑ អវិធត៑ តត្ក្ឞណាត៑ តស្មាទ៑ រក្តំ ជលញ្ច និរគច្ឆត៑។</para>
  <para style="p">
    <verse number="35" style="v"/>យោ ជនោៜស្យ សាក្ឞ្យំ ទទាតិ ស ស្វយំ ទ្ឫឞ្ដវាន៑ តស្យេទំ សាក្ឞ្យំ សត្យំ តស្យ កថា យុឞ្មាកំ វិឝ្វាសំ ជនយិតុំ យោគ្យា តត៑ ស ជានាតិ។</para>
  <para style="p">
    <verse number="36" style="v"/>តស្យៃកម៑ អស្ធ្យបិ ន ភំក្ឞ្យតេ,</para>
  <para style="p">
    <verse number="37" style="v"/>តទ្វទ៑ អន្យឝាស្ត្រេបិ លិខ្យតេ, យថា, "ទ្ឫឞ្ដិបាតំ ករិឞ្យន្តិ តេៜវិធន៑ យន្តុ តម្ប្រតិ។ "</para>
  <para style="p">
    <verse number="38" style="v"/>អរិមថីយនគរស្យ យូឞផ្នាមា ឝិឞ្យ ឯក អាសីត៑ កិន្តុ យិហូទីយេភ្យោ ភយាត៑ ប្រកាឝិតោ ន ភវតិ; ស យីឝោ រ្ទេហំ នេតុំ បីលាតស្យានុមតិំ ប្រាត៌្ហយត, តតះ បីលាតេនានុមតេ សតិ ស គត្វា យីឝោ រ្ទេហម៑ អនយត៑។</para>
  <para style="p">
    <verse number="39" style="v"/>អបរំ យោ និកទីមោ រាត្រៅ យីឝោះ សមីបម៑ អគច្ឆត៑ សោបិ គន្ធរសេន មិឝ្រិតំ ប្រាយេណ បញ្ចាឝត្សេដកមគុរុំ គ្ឫហីត្វាគច្ឆត៑។</para>
  <para style="p">
    <verse number="40" style="v"/>តតស្តេ យិហូទីយានាំ ឝ្មឝានេ ស្ថាបនរីត្យនុសារេណ តត្សុគន្ធិទ្រវ្យេណ សហិតំ តស្យ ទេហំ វស្ត្រេណាវេឞ្ដយន៑។</para>
  <para style="p">
    <verse number="41" style="v"/>អបរញ្ច យត្រ ស្ថានេ តំ ក្រុឝេៜវិធន៑ តស្យ និកដស្ថោទ្យានេ យត្រ កិមបិ ម្ឫតទេហំ កទាបិ នាស្ថាប្យត តាទ្ឫឝម៑ ឯកំ នូតនំ ឝ្មឝានម៑ អាសីត៑។</para>
  <para style="p">
    <verse number="42" style="v"/>យិហូទីយានាម៑ អាសាទនទិនាគមនាត៑ តេ តស្មិន៑ សមីបស្ថឝ្មឝានេ យីឝុម៑ អឝាយយន៑។</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ សប្តាហស្យ ប្រថមទិនេ ៜតិប្រត្យូឞេ ៜន្ធការេ តិឞ្ឋតិ មគ្ទលីនី មរិយម៑ តស្យ ឝ្មឝានស្យ និកដំ គត្វា ឝ្មឝានស្យ មុខាត៑ ប្រស្តរមបសារិតម៑ អបឝ្យត៑។</para>
  <para style="p">
    <verse number="2" style="v"/>បឝ្ចាទ៑ ធាវិត្វា ឝិមោន្បិតរាយ យីឝោះ ប្រិយតមឝិឞ្យាយ ចេទម៑ អកថយត៑, លោកាះ ឝ្មឝានាត៑ ប្រភុំ នីត្វា កុត្រាស្ថាបយន៑ តទ៑ វក្តុំ ន ឝក្នោមិ។</para>
  <para style="p">
    <verse number="3" style="v"/>អតះ បិតរះ សោន្យឝិឞ្យឝ្ច ពហ៌ិ រ្ភុត្វា ឝ្មឝានស្ថានំ គន្តុម៑ អារភេតាំ។</para>
  <para style="p">
    <verse number="4" style="v"/>ឧភយោទ៌្ហាវតោះ សោន្យឝិឞ្យះ បិតរំ បឝ្ចាត៑ ត្យក្ត្វា បូវ៌្វំ ឝ្មឝានស្ថាន ឧបស្ថិតវាន៑។</para>
  <para style="p">
    <verse number="5" style="v"/>តទា ប្រហ្វីភូយ ស្ថាបិតវស្ត្រាណិ ទ្ឫឞ្ដវាន៑ កិន្តុ ន ប្រាវិឝត៑។</para>
  <para style="p">
    <verse number="6" style="v"/>អបរំ ឝិមោន្បិតរ អាគត្យ ឝ្មឝានស្ថានំ ប្រវិឝ្យ</para>
  <para style="p">
    <verse number="7" style="v"/>ស្ថាបិតវស្ត្រាណិ មស្តកស្យ វស្ត្រញ្ច ប្ឫថក៑ ស្ថានាន្តរេ ស្ថាបិតំ ទ្ឫឞ្ដវាន៑។</para>
  <para style="p">
    <verse number="8" style="v"/>តតះ ឝ្មឝានស្ថានំ បូវ៌្វម៑ អាគតោ យោន្យឝិឞ្យះ សោបិ ប្រវិឝ្យ តាទ្ឫឝំ ទ្ឫឞ្ដា វ្យឝ្វសីត៑។</para>
  <para style="p">
    <verse number="9" style="v"/>យតះ ឝ្មឝានាត៑ ស ឧត្ថាបយិតវ្យ ឯតស្យ ធម៌្មបុស្តកវចនស្យ ភាវំ តេ តទា វោទ្ធុំ នាឝន្កុវន៑។</para>
  <para style="p">
    <verse number="10" style="v"/>អនន្តរំ តៅ ទ្វៅ ឝិឞ្យៅ ស្វំ ស្វំ គ្ឫហំ បរាវ្ឫត្យាគច្ឆតាម៑។</para>
  <para style="p">
    <verse number="11" style="v"/>តតះ បរំ មរិយម៑ ឝ្មឝានទ្វារស្យ ពហិះ ស្ថិត្វា រោទិតុម៑ អារភត តតោ រុទតី ប្រហ្វីភូយ ឝ្មឝានំ វិលោក្យ</para>
  <para style="p">
    <verse number="12" style="v"/>យីឝោះ ឝយនស្ថានស្យ ឝិរះស្ថានេ បទតលេ ច ទ្វយោ រ្ទិឝោ ទ្វៅ ស្វគ៌ីយទូតាវុបវិឞ្ដៅ សមបឝ្យត៑។</para>
  <para style="p">
    <verse number="13" style="v"/>តៅ ប្ឫឞ្ដវន្តៅ ហេ នារិ កុតោ រោទិឞិ? សាវទត៑ លោកា មម ប្រភុំ នីត្វា កុត្រាស្ថាបយន៑ ឥតិ ន ជានាមិ។</para>
  <para style="p">
    <verse number="14" style="v"/>ឥត្យុក្ត្វា មុខំ បរាវ្ឫត្យ យីឝុំ ទណ្ឌាយមានម៑ អបឝ្យត៑ កិន្តុ ស យីឝុរិតិ សា ជ្ញាតុំ នាឝក្នោត៑។</para>
  <para style="p">
    <verse number="15" style="v"/>តទា យីឝុស្តាម៑ អប្ឫច្ឆត៑ ហេ នារិ កុតោ រោទិឞិ? កំ វា ម្ឫគយសេ? តតះ សា តម៑ ឧទ្យានសេវកំ ជ្ញាត្វា វ្យាហរត៑, ហេ មហេច្ឆ ត្វំ យទីតះ ស្ថានាត៑ តំ នីតវាន៑ តហ៌ិ កុត្រាស្ថាបយស្តទ៑ វទ តត្ស្ថានាត៑ តម៑ អានយាមិ។</para>
  <para style="p">
    <verse number="16" style="v"/>តទា យីឝុស្តាម៑ អវទត៑ ហេ មរិយម៑។ តតះ សា បរាវ្ឫត្យ ប្រត្យវទត៑ ហេ រព្ពូនី អត៌្ហាត៑ ហេ គុរោ។</para>
  <para style="p">
    <verse number="17" style="v"/>តទា យីឝុរវទត៑ មាំ មា ធរ, ឥទានីំ បិតុះ សមីបេ ឩទ៌្ធ្វគមនំ ន ករោមិ កិន្តុ យោ មម យុឞ្មាកញ្ច បិតា មម យុឞ្មាកញ្ចេឝ្វរស្តស្យ និកដ ឩទ៌្ធ្វគមនំ កត៌្តុម៑ ឧទ្យតោស្មិ, ឥមាំ កថាំ ត្វំ គត្វា មម ភ្រាត្ឫគណំ ជ្ញាបយ។</para>
  <para style="p">
    <verse number="18" style="v"/>តតោ មគ្ទលីនីមរិយម៑ តត្ក្ឞណាទ៑ គត្វា ប្រភុស្តស្យៃ ទឝ៌នំ ទត្ត្វា កថា ឯតា អកថយទ៑ ឥតិ វាត៌្តាំ ឝិឞ្យេភ្យោៜកថយត៑។</para>
  <para style="p">
    <verse number="19" style="v"/>តតះ បរំ សប្តាហស្យ ប្រថមទិនស្យ សន្ធ្យាសមយេ ឝិឞ្យា ឯកត្រ មិលិត្វា យិហូទីយេភ្យោ ភិយា ទ្វាររុទ្ធម៑ អកុវ៌្វន៑, ឯតស្មិន៑ កាលេ យីឝុស្តេឞាំ មធ្យស្ថានេ តិឞ្ឋន៑ អកថយទ៑ យុឞ្មាកំ កល្យាណំ ភូយាត៑។</para>
  <para style="p">
    <verse number="20" style="v"/>ឥត្យុក្ត្វា និជហស្តំ កុក្ឞិញ្ច ទឝ៌ិតវាន៑, តតះ ឝិឞ្យាះ ប្រភុំ ទ្ឫឞ្ដ្វា ហ្ឫឞ្ដា អភវន៑។</para>
  <para style="p">
    <verse number="21" style="v"/>យីឝុះ បុនរវទទ៑ យុឞ្មាកំ កល្យាណំ ភូយាត៑ បិតា យថា មាំ ប្រៃឞយត៑ តថាហមបិ យុឞ្មាន៑ ប្រេឞយាមិ។</para>
  <para style="p">
    <verse number="22" style="v"/>ឥត្យុក្ត្វា ស តេឞាមុបរិ ទីគ៌្ហប្រឝ្វាសំ ទត្ត្វា កថិតវាន៑ បវិត្រម៑ អាត្មានំ គ្ឫហ្លីត។</para>
  <para style="p">
    <verse number="23" style="v"/>យូយំ យេឞាំ បាបានិ មោចយិឞ្យថ តេ មោចយិឞ្យន្តេ យេឞាញ្ច បាបាតិ ន មោចយិឞ្យថ តេ ន មោចយិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="24" style="v"/>ទ្វាទឝមធ្យេ គណិតោ យមជោ ថោមានាមា ឝិឞ្យោ យីឝោរាគមនកាលៃ តៃះ សាទ៌្ធំ នាសីត៑។</para>
  <para style="p">
    <verse number="25" style="v"/>អតោ វយំ ប្រភូម៑ អបឝ្យាមេតិ វាក្យេៜន្យឝិឞ្យៃរុក្តេ សោវទត៑, តស្យ ហស្តយោ រ្លៅហកីលកានាំ ចិហ្នំ ន វិលោក្យ តច្ចិហ្នម៑ អង្គុល្យា ន ស្ប្ឫឞ្ដ្វា តស្យ កុក្ឞៅ ហស្តំ នារោប្យ ចាហំ ន វិឝ្វសិឞ្យាមិ។</para>
  <para style="p">
    <verse number="26" style="v"/>អបរម៑ អឞ្ដមេៜហ្និ គតេ សតិ ថោមាសហិតះ ឝិឞ្យគណ ឯកត្រ មិលិត្វា ទ្វារំ រុទ្ធ្វាភ្យន្តរ អាសីត៑, ឯតហ៌ិ យីឝុស្តេឞាំ មធ្យស្ថានេ តិឞ្ឋន៑ អកថយត៑, យុឞ្មាកំ កុឝលំ ភូយាត៑។</para>
  <para style="p">
    <verse number="27" style="v"/>បឝ្ចាត៑ ថាមៃ កថិតវាន៑ ត្វម៑ អង្គុលីម៑ អត្រាប៌យិត្វា មម ករៅ បឝ្យ ករំ ប្រសាយ៌្យ មម កុក្ឞាវប៌យ នាវិឝ្វស្យ។</para>
  <para style="p">
    <verse number="28" style="v"/>តទា ថោមា អវទត៑, ហេ មម ប្រភោ ហេ មទីឝ្វរ។</para>
  <para style="p">
    <verse number="29" style="v"/>យីឝុរកថយត៑, ហេ ថោមា មាំ និរីក្ឞ្យ វិឝ្វសិឞិ យេ ន ទ្ឫឞ្ដ្វា វិឝ្វសន្តិ តឯវ ធន្យាះ។</para>
  <para style="p">
    <verse number="30" style="v"/>ឯតទន្យានិ បុស្តកេៜស្មិន៑ អលិខិតានិ ពហូន្យាឝ្ចយ៌្យកម៌្មាណិ យីឝុះ ឝិឞ្យាណាំ បុរស្តាទ៑ អករោត៑។</para>
  <para style="p">
    <verse number="31" style="v"/>កិន្តុ យីឝុរីឝ្វរស្យាភិឞិក្តះ សុត ឯវេតិ យថា យូយំ វិឝ្វសិថ វិឝ្វស្យ ច តស្យ នាម្នា បរមាយុះ ប្រាប្នុថ តទត៌្ហម៑ ឯតានិ សវ៌្វាណ្យលិខ្យន្ត។</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តតះ បរំ តិពិរិយាជលធេស្តដេ យីឝុះ បុនរបិ ឝិឞ្យេភ្យោ ទឝ៌នំ ទត្តវាន៑ ទឝ៌នស្យាខ្យានមិទម៑។</para>
  <para style="p">
    <verse number="2" style="v"/>ឝិមោន្បិតរះ យមជថោមា គាលីលីយកាន្នានគរនិវាសី និថនេល៑ សិវទេះ បុត្រាវន្យៅ ទ្វៅ ឝិឞ្យៅ ចៃតេឞ្វេកត្រ មិលិតេឞុ ឝិមោន្បិតរោៜកថយត៑ មត្ស្យាន៑ ធត៌ុំ យាមិ។</para>
  <para style="p">
    <verse number="3" style="v"/>តតស្តេ វ្យាហរន៑ តហ៌ិ វយមបិ ត្វយា សាទ៌្ធំ យាមះ តទា តេ ពហិគ៌តាះ សន្តះ ក្ឞិប្រំ នាវម៑ អារោហន៑ កិន្តុ តស្យាំ រជន្យាម៑ ឯកមបិ ន ប្រាប្នុវន៑។</para>
  <para style="p">
    <verse number="4" style="v"/>ប្រភាតេ សតិ យីឝុស្តដេ ស្ថិតវាន៑ កិន្តុ ស យីឝុរិតិ ឝិឞ្យា ជ្ញាតុំ នាឝក្នុវន៑។</para>
  <para style="p">
    <verse number="5" style="v"/>តទា យីឝុរប្ឫច្ឆត៑, ហេ វត្សា សន្និធៅ កិញ្ចិត៑ ខាទ្យទ្រវ្យម៑ អាស្តេ? តេៜវទន៑ កិមបិ នាស្តិ។</para>
  <para style="p">
    <verse number="6" style="v"/>តទា សោៜវទត៑ នៅកាយា ទក្ឞិណបាឝ៌្វេ ជាលំ និក្ឞិបត តតោ លប្ស្យធ្វេ, តស្មាត៑ តៃ រ្និក្ឞិប្តេ ជាលេ មត្ស្យា ឯតាវន្តោៜបតន៑ យេន តេ ជាលមាក្ឫឞ្យ នោត្តោលយិតុំ ឝក្តាះ។</para>
  <para style="p">
    <verse number="7" style="v"/>តស្មាទ៑ យីឝោះ ប្រិយតមឝិឞ្យះ បិតរាយាកថយត៑ ឯឞ ប្រភុ រ្ភវេត៑, ឯឞ ប្រភុរិតិ វាចំ ឝ្រុត្វៃវ ឝិមោន៑ នគ្នតាហេតោ រ្មត្ស្យធារិណ ឧត្តរីយវស្ត្រំ បរិធាយ ហ្រទំ ប្រត្យុទលម្ផយត៑។</para>
  <para style="p">
    <verse number="8" style="v"/>អបរេ ឝិឞ្យា មត្ស្យៃះ សាទ៌្ធំ ជាលម៑ អាកឞ៌ន្តះ ក្ឞុទ្រនៅកាំ វាហយិត្វា កូលមានយន៑ តេ កូលាទ៑ អតិទូរេ នាសន៑ ទ្វិឝតហស្តេភ្យោ ទូរ អាសន៑ ឥត្យនុមីយតេ។</para>
  <para style="p">
    <verse number="9" style="v"/>តីរំ ប្រាប្តៃស្តៃស្តត្រ ប្រជ្វលិតាគ្និស្តទុបរិ មត្ស្យាះ បូបាឝ្ច ទ្ឫឞ្ដាះ។</para>
  <para style="p">
    <verse number="10" style="v"/>តតោ យីឝុរកថយទ៑ យាន៑ មត្ស្យាន៑ អធរត តេឞាំ កតិបយាន៑ អានយត។</para>
  <para style="p">
    <verse number="11" style="v"/>អតះ ឝិមោន្បិតរះ បរាវ្ឫត្យ គត្វា ព្ឫហទ្ភិស្ត្រិបញ្ចាឝទធិកឝតមត្ស្យៃះ បរិបូណ៌ំ តជ្ជាលម៑ អាក្ឫឞ្យោទតោលយត៑ កិន្ត្វេតាវទ្ភិ រ្មត្ស្យៃរបិ ជាលំ នាឆិទ្យត។</para>
  <para style="p">
    <verse number="12" style="v"/>អនន្តរំ យីឝុស្តាន៑ អវាទីត៑ យូយមាគត្យ ភុំគ្ធ្វំ; តទា សឯវ ប្រភុរិតិ ជ្ញាតត្វាត៑ ត្វំ កះ? ឥតិ ប្រឞ្ដុំ ឝិឞ្យាណាំ កស្យាបិ ប្រគល្ភតា នាភវត៑។</para>
  <para style="p">
    <verse number="13" style="v"/>តតោ យីឝុរាគត្យ បូបាន៑ មត្ស្យាំឝ្ច គ្ឫហីត្វា តេភ្យះ បយ៌្យវេឞយត៑។</para>
  <para style="p">
    <verse number="14" style="v"/>ឥត្ថំ ឝ្មឝានាទុត្ថានាត៑ បរំ យីឝុះ ឝិឞ្យេភ្យស្ត្ឫតីយវារំ ទឝ៌នំ ទត្តវាន៑។</para>
  <para style="p">
    <verse number="15" style="v"/>ភោជនេ សមាប្តេ សតិ យីឝុះ ឝិមោន្បិតរំ ប្ឫឞ្ដវាន៑, ហេ យូនសះ បុត្រ ឝិមោន៑ ត្វំ កិម៑ ឯតេភ្យោធិកំ មយិ ប្រីយសេ? តតះ ស ឧទិតវាន៑ សត្យំ ប្រភោ ត្វយិ ប្រីយេៜហំ តទ៑ ភវាន៑ ជានាតិ; តទា យីឝុរកថយត៑ តហ៌ិ មម មេឞឝាវកគណំ បាលយ។</para>
  <para style="p">
    <verse number="16" style="v"/>តតះ ស ទ្វិតីយវារំ ប្ឫឞ្ដវាន៑ ហេ យូនសះ បុត្រ ឝិមោន៑ ត្វំ កិំ មយិ ប្រីយសេ? តតះ ស ឧក្តវាន៑ សត្យំ ប្រភោ ត្វយិ ប្រីយេៜហំ តទ៑ ភវាន៑ ជានាតិ; តទា យីឝុរកថយត តហ៌ិ មម មេឞគណំ បាលយ។</para>
  <para style="p">
    <verse number="17" style="v"/>បឝ្ចាត៑ ស ត្ឫតីយវារំ ប្ឫឞ្ដវាន៑, ហេ យូនសះ បុត្រ ឝិមោន៑ ត្វំ កិំ មយិ ប្រីយសេ? ឯតទ្វាក្យំ ត្ឫតីយវារំ ប្ឫឞ្ដវាន៑ តស្មាត៑ បិតរោ ទុះខិតោ ភូត្វាៜកថយត៑ ហេ ប្រភោ ភវតះ កិមប្យគោចរំ នាស្តិ ត្វយ្យហំ ប្រីយេ តទ៑ ភវាន៑ ជានាតិ; តតោ យីឝុរវទត៑ តហ៌ិ មម មេឞគណំ បាលយ។</para>
  <para style="p">
    <verse number="18" style="v"/>អហំ តុភ្យំ យថាត៌្ហំ កថយាមិ យៅវនកាលេ ស្វយំ ពទ្ធកដិ រ្យត្រេច្ឆា តត្រ យាតវាន៑ កិន្ត្វិតះ បរំ វ្ឫទ្ធេ វយសិ ហស្តំ វិស្តារយិឞ្យសិ, អន្យជនស្ត្វាំ ពទ្ធ្វា យត្រ គន្តុំ តវេច្ឆា ន ភវតិ ត្វាំ ធ្ឫត្វា តត្រ នេឞ្យតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>ផលតះ កីទ្ឫឝេន មរណេន ស ឦឝ្វរស្យ មហិមានំ ប្រកាឝយិឞ្យតិ តទ៑ ពោធយិតុំ ស ឥតិ វាក្យំ ប្រោក្តវាន៑។ ឥត្យុក្តេ សតិ ស តមវោចត៑ មម បឝ្ចាទ៑ អាគច្ឆ។</para>
  <para style="p">
    <verse number="20" style="v"/>យោ ជនោ រាត្រិកាលេ យីឝោ រ្វក្ឞោៜវលម្ព្យ, ហេ ប្រភោ កោ ភវន្តំ បរករេឞុ សមប៌យិឞ្យតីតិ វាក្យំ ប្ឫឞ្ដវាន៑, តំ យីឝោះ ប្រិយតមឝិឞ្យំ បឝ្ចាទ៑ អាគច្ឆន្តំ</para>
  <para style="p">
    <verse number="21" style="v"/>បិតរោ មុខំ បរាវត៌្ត្យ វិលោក្យ យីឝុំ ប្ឫឞ្ដវាន៑, ហេ ប្រភោ ឯតស្យ មានវស្យ កីទ្ឫឝី គតិ រ្ភវិឞ្យតិ?</para>
  <para style="p">
    <verse number="22" style="v"/>ស ប្រត្យវទត៑, មម បុនរាគមនបយ៌្យន្តំ យទិ តំ ស្ថាបយិតុម៑ ឥច្ឆាមិ តត្រ តវ កិំ? ត្វំ មម បឝ្ចាទ៑ អាគច្ឆ។</para>
  <para style="p">
    <verse number="23" style="v"/>តស្មាត៑ ស ឝិឞ្យោ ន មរិឞ្យតីតិ ភ្រាត្ឫគណមធ្យេ កិំវទន្តី ជាតា កិន្តុ ស ន មរិឞ្យតីតិ វាក្យំ យីឝុ រ្នាវទត៑ កេវលំ មម បុនរាគមនបយ៌្យន្តំ យទិ តំ ស្ថាបយិតុម៑ ឥច្ឆាមិ តត្រ តវ កិំ? ឥតិ វាក្យម៑ ឧក្តវាន៑។</para>
  <para style="p">
    <verse number="24" style="v"/>យោ ជន ឯតានិ សវ៌្វាណិ លិខិតវាន៑ អត្រ សាក្ឞ្យញ្ច ទត្តវាន៑ សឯវ ស ឝិឞ្យះ, តស្យ សាក្ឞ្យំ ប្រមាណមិតិ វយំ ជានីមះ។</para>
  <para style="p">
    <verse number="25" style="v"/>យីឝុរេតេភ្យោៜបរាណ្យបិ ពហូនិ កម៌្មាណិ ក្ឫតវាន៑ តានិ សវ៌្វាណិ យទ្យេកៃកំ ក្ឫត្វា លិខ្យន្តេ តហ៌ិ គ្រន្ថា ឯតាវន្តោ ភវន្តិ តេឞាំ ធារណេ ប្ឫថិវ្យាំ ស្ថានំ ន ភវតិ។ ឥតិ៕</para>
</usx>
