<usx version="2.6">
  <book code="MAT" style="id">Sanskrit Bible (NT) in Khmer Script (សត្យវេទះ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Matthew</para>
  <para style="toc1">មថិលិខិតះ សុសំវាទះ</para>
  <para style="toc2">មថិះ</para>
  <para style="toc3">មថិះ</para>
  <para style="mt1">មថិលិខិតះ សុសំវាទះ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ឥព្រាហីមះ សន្តានោ ទាយូទ៑ តស្យ សន្តានោ យីឝុខ្រីឞ្ដស្តស្យ បូវ៌្វបុរុឞវំឝឝ្រេណី។</para>
  <para style="p">
    <verse number="2" style="v"/>ឥព្រាហីមះ បុត្រ ឥស្ហាក៑ តស្យ បុត្រោ យាកូព៑ តស្យ បុត្រោ យិហូទាស្តស្យ ភ្រាតរឝ្ច។</para>
  <para style="p">
    <verse number="3" style="v"/>តស្មាទ៑ យិហូទាតស្តាមរោ គព៌្ហេ បេរស្សេរហៅ ជជ្ញាតេ, តស្យ បេរសះ បុត្រោ ហិឞ្រោណ៑ តស្យ បុត្រោ ៜរាម៑។</para>
  <para style="p">
    <verse number="4" style="v"/>តស្យ បុត្រោ ៜម្មីនាទព៑ តស្យ បុត្រោ នហឝោន៑ តស្យ បុត្រះ សល្មោន៑។</para>
  <para style="p">
    <verse number="5" style="v"/>តស្មាទ៑ រាហពោ គព៌្ហេ ពោយម៑ ជជ្ញេ, តស្មាទ៑ រូតោ គព៌្ហេ ឱពេទ៑ ជជ្ញេ, តស្យ បុត្រោ យិឝយះ។</para>
  <para style="p">
    <verse number="6" style="v"/>តស្យ បុត្រោ ទាយូទ៑ រាជះ តស្មាទ៑ ម្ឫតោរិយស្យ ជាយាយាំ សុលេមាន៑ ជជ្ញេ។</para>
  <para style="p">
    <verse number="7" style="v"/>តស្យ បុត្រោ រិហពិយាម៑, តស្យ បុត្រោៜពិយះ, តស្យ បុត្រ អាសា:។</para>
  <para style="p">
    <verse number="8" style="v"/>តស្យ សុតោ យិហោឝាផដ៑ តស្យ សុតោ យិហោរាម តស្យ សុត ឧឞិយះ។</para>
  <para style="p">
    <verse number="9" style="v"/>តស្យ សុតោ យោថម៑ តស្យ សុត អាហម៑ តស្យ សុតោ ហិឞ្កិយះ។</para>
  <para style="p">
    <verse number="10" style="v"/>តស្យ សុតោ មិនឝិះ, តស្យ សុត អាមោន៑ តស្យ សុតោ យោឝិយះ។</para>
  <para style="p">
    <verse number="11" style="v"/>ពាពិល្នគរេ ប្រវសនាត៑ បូវ៌្វំ ស យោឝិយោ យិខនិយំ តស្យ ភ្រាត្ឫំឝ្ច ជនយាមាស។</para>
  <para style="p">
    <verse number="12" style="v"/>តតោ ពាពិលិ ប្រវសនកាលេ យិខនិយះ ឝល្តីយេលំ ជនយាមាស, តស្យ សុតះ សិរុព្ពាវិល៑។</para>
  <para style="p">
    <verse number="13" style="v"/>តស្យ សុតោ ៜពោហុទ៑ តស្យ សុត ឥលីយាកីម៑ តស្យ សុតោៜសោរ៑។</para>
  <para style="p">
    <verse number="14" style="v"/>អសោរះ សុតះ សាទោក៑ តស្យ សុត អាខីម៑ តស្យ សុត ឥលីហូទ៑។</para>
  <para style="p">
    <verse number="15" style="v"/>តស្យ សុត ឥលិយាសរ៑ តស្យ សុតោ មត្តន៑។</para>
  <para style="p">
    <verse number="16" style="v"/>តស្យ សុតោ យាកូព៑ តស្យ សុតោ យូឞផ៑ តស្យ ជាយា មរិយម៑; តស្យ គព៌្ហេ យីឝុរជនិ, តមេវ ខ្រីឞ្ដម៑ (អត៌្ហាទ៑ អភិឞិក្តំ) វទន្តិ។</para>
  <para style="p">
    <verse number="17" style="v"/>ឥត្ថម៑ ឥព្រាហីមោ ទាយូទំ យាវត៑ សាកល្យេន ចតុទ៌ឝបុរុឞាះ; អា ទាយូទះ កាលាទ៑ ពាពិលិ ប្រវសនកាលំ យាវត៑ ចតុទ៌ឝបុរុឞា ភវន្តិ។ ពាពិលិ ប្រវាសនកាលាត៑ ខ្រីឞ្ដស្យ កាលំ យាវត៑ ចតុទ៌ឝបុរុឞា ភវន្តិ។</para>
  <para style="p">
    <verse number="18" style="v"/>យីឝុខ្រីឞ្ដស្យ ជន្ម កថ្ថតេ។ មរិយម៑ នាមិកា កន្យា យូឞផេ វាគ្ទត្តាសីត៑, តទា តយោះ សង្គមាត៑ ប្រាក៑ សា កន្យា  បវិត្រេណាត្មនា គព៌្ហវតី ពភូវ។</para>
  <para style="p">
    <verse number="19" style="v"/>តត្រ តស្យាះ បតិ រ្យូឞផ៑ សៅជន្យាត៑ តស្យាះ កលង្គំ ប្រកាឝយិតុម៑ អនិច្ឆន៑ គោបនេនេ តាំ បារិត្យក្តុំ មនឝ្ចក្រេ។</para>
  <para style="p">
    <verse number="20" style="v"/>ស តថៃវ ភាវយតិ, តទានីំ បរមេឝ្វរស្យ ទូតះ ស្វប្នេ តំ ទឝ៌នំ ទត្ត្វា វ្យាជហារ, ហេ ទាយូទះ សន្តាន យូឞផ៑ ត្វំ និជាំ ជាយាំ មរិយមម៑ អាទាតុំ មា ភៃឞីះ។</para>
  <para style="p">
    <verse number="21" style="v"/>យតស្តស្យា គព៌្ហះ បវិត្រាទាត្មនោៜភវត៑, សា ច បុត្រំ ប្រសវិឞ្យតេ, តទា ត្វំ តស្យ នាម យីឝុម៑ (អត៌្ហាត៑ ត្រាតារំ) ករីឞ្យសេ, យស្មាត៑ ស និជមនុជាន៑ តេឞាំ កលុឞេភ្យ ឧទ្ធរិឞ្យតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>ឥត្ថំ សតិ, បឝ្យ គព៌្ហវតី កន្យា តនយំ ប្រសវិឞ្យតេ។ ឥម្មានូយេល៑ តទីយញ្ច នាមធេយំ ភវិឞ្យតិ៕ ឥម្មានូយេល៑ អស្មាកំ សង្គីឝ្វរឥត្យត៌្ហះ។</para>
  <para style="p">
    <verse number="23" style="v"/>ឥតិ យទ៑ វចនំ បុវ៌្វំ ភវិឞ្យទ្វក្ត្រា ឦឝ្វរះ កថាយាមាស, តត៑ តទានីំ សិទ្ធមភវត៑។</para>
  <para style="p">
    <verse number="24" style="v"/>អនន្តរំ យូឞផ៑ និទ្រាតោ ជាគរិត ឧត្ថាយ បរមេឝ្វរីយទូតស្យ និទេឝានុសារេណ និជាំ ជាយាំ ជគ្រាហ,</para>
  <para style="p">
    <verse number="25" style="v"/>កិន្តុ យាវត៑ សា និជំ ប្រថមសុតំ អ សុឞុវេ, តាវត៑ តាំ នោបាគច្ឆត៑, តតះ សុតស្យ នាម យីឝុំ ចក្រេ។</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ ហេរោទ៑ សំជ្ញកេ រាជ្ញិ រាជ្យំ ឝាសតិ យិហូទីយទេឝស្យ ពៃត្លេហមិ នគរេ យីឝៅ ជាតវតិ ច, កតិបយា ជ្យោតិវ៌្វុទះ បូវ៌្វស្យា ទិឝោ យិរូឝាលម្នគរំ សមេត្យ កថយមាសុះ,</para>
  <para style="p">
    <verse number="2" style="v"/>យោ យិហូទីយានាំ រាជា ជាតវាន៑, ស កុត្រាស្តេ? វយំ បូវ៌្វស្យាំ ទិឝិ តិឞ្ឋន្តស្តទីយាំ តារកាម៑ អបឝ្យាម តស្មាត៑ តំ ប្រណន្តុម៑ អाគមាម។</para>
  <para style="p">
    <verse number="3" style="v"/>តទា ហេរោទ៑ រាជា កថាមេតាំ និឝម្យ យិរូឝាលម្នគរស្ថិតៃះ សវ៌្វមានវៃះ សាទ៌្ធម៑ ឧទ្វិជ្យ</para>
  <para style="p">
    <verse number="4" style="v"/>សវ៌្វាន៑ ប្រធានយាជកាន៑ អធ្យាបកាំឝ្ច សមាហូយានីយ បប្រច្ឆ, ខ្រីឞ្ដះ កុត្រ ជនិឞ្យតេ?</para>
  <para style="p">
    <verse number="5" style="v"/>តទា តេ កថយាមាសុះ, យិហូទីយទេឝស្យ ពៃត្លេហមិ នគរេ, យតោ ភវិឞ្យទ្វាទិនា ឥត្ថំ លិខិតមាស្តេ,</para>
  <para style="p">
    <verse number="6" style="v"/>សវ៌្វាភ្យោ រាជធានីភ្យោ យិហូទីយស្យ នីវ្ឫតះ។ ហេ យីហូទីយទេឝស្យេ ពៃត្លេហម៑ ត្វំ ន ចាវរា។ ឥស្រាយេលីយលោកាន៑ មេ យតោ យះ បាលយិឞ្យតិ។ តាទ្ឫគេកោ មហារាជស្ត្វន្មធ្យ ឧទ្ភវិឞ្យតី៕</para>
  <para style="p">
    <verse number="7" style="v"/>តទានីំ ហេរោទ៑ រាជា តាន៑ ជ្យោតិវ៌្វិទោ គោបនម៑ អាហូយ សា តារកា កទា ទ្ឫឞ្ដាភវត៑ , តទ៑ វិនិឝ្ចយាមាស។</para>
  <para style="p">
    <verse number="8" style="v"/>អបរំ តាន៑ ពៃត្លេហមំ ប្រហីត្យ គទិតវាន៑, យូយំ យាត, យត្នាត៑ តំ ឝិឝុម៑ អន្វិឞ្យ តទុទ្ទេឝេ ប្រាប្តេ មហ្យំ វាត៌្តាំ ទាស្យថ, តតោ មយាបិ គត្វា ស ប្រណំស្យតេ។</para>
  <para style="p">
    <verse number="9" style="v"/>តទានីំ រាជ្ញ ឯតាទ្ឫឝីម៑ អាជ្ញាំ ប្រាប្យ តេ ប្រតស្ថិរេ, តតះ បូវ៌្វស៌្យាំ ទិឝិ ស្ថិតៃស្តៃ រ្យា តារកា ទ្ឫឞ្ដា សា តារកា តេឞាមគ្រេ គត្វា យត្រ ស្ថានេ ឝិឝូរាស្តេ, តស្យ ស្ថានស្យោបរិ ស្ថគិតា តស្យៅ។</para>
  <para style="p">
    <verse number="10" style="v"/>តទ៑ ទ្ឫឞ្ដ្វា តេ មហានន្ទិតា ពភូវុះ,</para>
  <para style="p">
    <verse number="11" style="v"/>តតោ គេហមធ្យ ប្រវិឝ្យ តស្យ មាត្រា មរិយមា សាទ្ធំ តំ ឝិឝុំ និរីក្ឞយ ទណ្ឌវទ៑ ភូត្វា ប្រណេមុះ, អបរំ ស្វេឞាំ ឃនសម្បត្តិំ មោចយិត្វា សុវណ៌ំ កុន្ទុរុំ គន្ធរមញ្ច តស្មៃ ទឝ៌នីយំ ទត្តវន្តះ។</para>
  <para style="p">
    <verse number="12" style="v"/>បឝ្ចាទ៑ ហេរោទ៑ រាជស្យ សមីបំ បុនរបិ គន្តុំ ស្វប្ន ឦឝ្វរេណ និឞិទ្ធាះ សន្តោ ៜន្យេន បថា តេ និជទេឝំ ប្រតិ ប្រតស្ថិរេ។</para>
  <para style="p">
    <verse number="13" style="v"/>អនន្តរំ តេឞុ គតវត្មុ បរមេឝ្វរស្យ ទូតោ យូឞផេ ស្វប្នេ ទឝ៌នំ ទត្វា ជគាទ, ត្វម៑ ឧត្ថាយ ឝិឝុំ តន្មាតរញ្ច គ្ឫហីត្វា មិសទ៌េឝំ បលាយស្វ, អបរំ យាវទហំ តុភ្យំ វាត៌្តាំ ន កថយិឞ្យាមិ, តាវត៑ តត្រៃវ និវស, យតោ រាជា ហេរោទ៑ ឝិឝុំ នាឝយិតុំ ម្ឫគយិឞ្យតេ។</para>
  <para style="p">
    <verse number="14" style="v"/>តទានីំ យូឞផ៑ ឧត្ថាយ រជន្យាំ ឝិឝុំ តន្មាតរញ្ច គ្ឫហីត្វា មិសទ៌េឝំ ប្រតិ ប្រតស្ថេ,</para>
  <para style="p">
    <verse number="15" style="v"/>គត្វា ច ហេរោទោ ន្ឫបតេ រ្មរណបយ៌្យន្តំ តត្រ ទេឝេ ន្យុវាស, តេន មិសទ៌េឝាទហំ បុត្រំ ស្វកីយំ សមុបាហូយម៑។ យទេតទ្វចនម៑ ឦឝ្វរេណ ភវិឞ្យទ្វាទិនា កថិតំ តត៑ សផលមភូត៑។</para>
  <para style="p">
    <verse number="16" style="v"/>អនន្តរំ ហេរោទ៑ ជ្យោតិវ៌ិទ្ភិរាត្មានំ ប្រវញ្ចិតំ វិជ្ញាយ ភ្ឫឝំ ចុកោប; អបរំ ជ្យោតិវ៌្វិទ្ភ្យស្តេន វិនិឝ្ចិតំ យទ៑ ទិនំ តទ្ទិនាទ៑ គណយិត្វា ទ្វិតីយវត្សរំ ប្រវិឞ្ដា យាវន្តោ ពាលកា អស្មិន៑ ពៃត្លេហម្នគរេ តត្សីមមធ្យេ ចាសន៑, លោកាន៑ ប្រហិត្យ តាន៑ សវ៌្វាន៑ ឃាតយាមាស។</para>
  <para style="p">
    <verse number="17" style="v"/>អតះ អនេកស្យ វិលាបស្យ និនាទ: ក្រន្ទនស្យ ច។ ឝោកេន ក្ឫតឝព្ទឝ្ច រាមាយាំ សំនិឝម្យតេ។ ស្វពាលគណហេតោវ៌ៃ រាហេល៑ នារី តុ រោទិនី។ ន មន្យតេ ប្រពោធន្តុ យតស្តេ នៃវ មន្តិ ហិ៕</para>
  <para style="p">
    <verse number="18" style="v"/>យទេតទ៑ វចនំ យិរីមិយនាមកភវិឞ្យទ្វាទិនា កថិតំ តត៑ តទានីំ សផលម៑ អភូត៑។</para>
  <para style="p">
    <verse number="19" style="v"/>តទនន្តរំ ហេរេទិ រាជនិ ម្ឫតេ បរមេឝ្វរស្យ ទូតោ មិសទ៌េឝេ ស្វប្នេ ទឝ៌នំ ទត្ត្វា យូឞផេ កថិតវាន្</para>
  <para style="p">
    <verse number="20" style="v"/>ត្វម៑ ឧត្ថាយ ឝិឝុំ តន្មាតរញ្ច គ្ឫហីត្វា បុនរបីស្រាយេលោ ទេឝំ យាហី, យេ ជនាះ ឝិឝុំ នាឝយិតុម៑ អម្ឫគយន្ត, តេ ម្ឫតវន្តះ។</para>
  <para style="p">
    <verse number="21" style="v"/>តទានីំ ស ឧត្ថាយ ឝិឝុំ តន្មាតរញ្ច គ្ឫហ្លន៑ ឥស្រាយេល្ទេឝម៑ អាជគាម។</para>
  <para style="p">
    <verse number="22" style="v"/>កិន្តុ យិហូទីយទេឝេ អក៌្ហិលាយនាម រាជកុមារោ និជបិតុ រ្ហេរោទះ បទំ ប្រាប្យ រាជត្វំ ករោតីតិ និឝម្យ តត៑ ស្ថានំ យាតុំ ឝង្កិតវាន៑, បឝ្ចាត៑ ស្វប្ន ឦឝ្វរាត៑ ប្រពោធំ ប្រាប្យ គាលីល្ទេឝស្យ ប្រទេឝៃកំ ប្រស្ថាយ នាសរន្នាម នគរំ គត្វា តត្រ ន្យុឞិតវាន៑,</para>
  <para style="p">
    <verse number="23" style="v"/>តេន តំ នាសរតីយំ កថយិឞ្យន្តិ, យទេតទ្វាក្យំ ភវិឞ្យទ្វាទិភិរុក្ត្តំ តត៑ សផលមភវត៑។</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តទានោំ យោហ្ន្នាមា មជ្ជយិតា យិហូទីយទេឝស្យ ប្រាន្តរម៑ ឧបស្ថាយ ប្រចារយន៑ កថយាមាស,</para>
  <para style="p">
    <verse number="2" style="v"/>មនាំសិ បរាវត៌្តយត, ស្វគ៌ីយរាជត្វំ សមីបមាគតម៑។</para>
  <para style="p">
    <verse number="3" style="v"/>បរមេឝស្យ បន្ថានំ បរិឞ្កុរុត សវ៌្វតះ។ តស្យ រាជបថាំឝ្ចៃវ សមីកុរុត សវ៌្វថា។ ឥត្យេតត៑ ប្រាន្តរេ វាក្យំ វទតះ កស្យចិទ៑ រវះ៕</para>
  <para style="p">
    <verse number="4" style="v"/>ឯតទ្វចនំ យិឝយិយភវិឞ្យទ្វាទិនា យោហនមុទ្ទិឝ្យ ភាឞិតម៑។ យោហនោ វសនំ មហាង្គរោមជំ តស្យ កដៅ ចម៌្មកដិពន្ធនំ; ស ច ឝូកកីដាន៑ មធុ ច ភុក្តវាន៑។</para>
  <para style="p">
    <verse number="5" style="v"/>តទានីំ យិរូឝាលម្នគរនិវាសិនះ សវ៌្វេ យិហូទិទេឝីយា យទ៌្ទន្តដិន្យា ឧភយតដស្ថាឝ្ច មានវា ពហិរាគត្យ តស្យ សមីបេ</para>
  <para style="p">
    <verse number="6" style="v"/>ស្វីយំ ស្វីយំ ទុរិតម៑ អង្គីក្ឫត្យ តស្យាំ យទ៌្ទនិ តេន មជ្ជិតា ពភូវុះ។</para>
  <para style="p">
    <verse number="7" style="v"/>អបរំ ពហូន៑ ផិរូឝិនះ សិទូកិនឝ្ច មនុជាន៑ មំក្តុំ ស្វសមីបម៑ អាគច្ឆ្តោ វិលោក្យ ស តាន៑ អភិទធៅ, រេ រេ ភុជគវំឝា អាគាមីនះ កោបាត៑ បលាយិតុំ យុឞ្មាន៑ កឝ្ចេតិតវាន៑?</para>
  <para style="p">
    <verse number="8" style="v"/>មនះបរាវត៌្តនស្យ សមុចិតំ ផលំ ផលត។</para>
  <para style="p">
    <verse number="9" style="v"/>កិន្ត្វស្មាកំ តាត ឥព្រាហីម៑ អស្តីតិ ស្វេឞុ មនះសុ ចីន្តយន្តោ មា វ្យាហរត។ យតោ យុឞ្មាន៑ អហំ វទាមិ, ឦឝ្វរ ឯតេភ្យះ បាឞាណេភ្យ ឥព្រាហីមះ សន្តានាន៑ ឧត្បាទយិតុំ ឝក្នោតិ។</para>
  <para style="p">
    <verse number="10" style="v"/>អបរំ បាទបានាំ មូលេ កុឋារ ឥទានីមបិ លគន៑ អាស្តេ, តស្មាទ៑ យស្មិន៑ បាទបេ ឧត្តមំ ផលំ ន ភវតិ, ស ក្ឫត្តោ មធ្យេៜគ្និំ និក្ឞេប្ស្យតេ។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរម៑ អហំ មនះបរាវត៌្តនសូចកេន មជ្ជនេន យុឞ្មាន៑ មជ្ជយាមីតិ សត្យំ, កិន្តុ មម បឝ្ចាទ៑ យ អាគច្ឆតិ, ស មត្តោបិ មហាន៑, អហំ តទីយោបានហៅ វោឍុមបិ នហិ យោគ្យោស្មិ, ស យុឞ្មាន៑ វហ្និរូបេ បវិត្រ អាត្មនិ សំមជ្ជយិឞ្យតិ។</para>
  <para style="p">
    <verse number="12" style="v"/>តស្យ ការេ សូប៌ អាស្តេ, ស ស្វីយឝស្យានិ សម្យក៑ ប្រស្ផោដ្យ និជាន៑ សកលគោធូមាន៑ សំគ្ឫហ្យ ភាណ្ឌាគារេ ស្ថាបយិឞ្យតិ, កិំន្តុ សវ៌្វាណិ វុឞាណ្យនិវ៌្វាណវហ្និនា ទាហយិឞ្យតិ។</para>
  <para style="p">
    <verse number="13" style="v"/>អនន្តរំ យីឝុ រ្យោហនា មជ្ជិតោ ភវិតុំ គាលីល្ប្រទេឝាទ៑ យទ៌្ទនិ តស្យ សមីបម៑ អាជគាម។</para>
  <para style="p">
    <verse number="14" style="v"/>កិន្តុ យោហន៑ តំ និឞិធ្យ ពភាឞេ, ត្វំ កិំ មម សមីបម៑ អាគច្ឆសិ? វរំ ត្វយា មជ្ជនំ មម ប្រយោជនម៑ អាស្តេ។</para>
  <para style="p">
    <verse number="15" style="v"/>តទានីំ យីឝុះ ប្រត្យវោចត៑; ឦទានីម៑ អនុមន្យស្វ, យត ឥត្ថំ សវ៌្វធម៌្មសាធនម៑ អស្មាកំ កត៌្តវ្យំ, តតះ សោៜន្វមន្យត។</para>
  <para style="p">
    <verse number="16" style="v"/>អនន្តរំ យីឝុរម្មសិ មជ្ជិតុះ សន៑ តត្ក្ឞណាត៑ តោយមធ្យាទ៑ ឧត្ថាយ ជគាម, តទា ជីមូតទ្វារេ មុក្តេ ជាតេ, ស ឦឝ្វរស្យាត្មានំ កបោតវទ៑ អវរុហ្យ ស្វោបយ៌្យាគច្ឆន្តំ វីក្ឞាញ្ចក្រេ។</para>
  <para style="p">
    <verse number="17" style="v"/>អបរម៑ ឯឞ មម ប្រិយះ បុត្រ ឯតស្មិន្នេវ មម មហាសន្តោឞ ឯតាទ្ឫឝី វ្យោមជា វាគ៑ ពភូវ។</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តតះ បរំ យីឝុះ ប្រតារកេណ បរីក្ឞិតោ ភវិតុម៑ អាត្មនា ប្រាន្តរម៑ អាក្ឫឞ្ដះ</para>
  <para style="p">
    <verse number="2" style="v"/>សន៑ ចត្វារិំឝទហោរាត្រាន៑ អនាហារស្តិឞ្ឋន៑ ក្ឞុធិតោ ពភូវ។</para>
  <para style="p">
    <verse number="3" style="v"/>តទានីំ បរីក្ឞិតា តត្សមីបម៑ អាគត្យ វ្យាហ្ឫតវាន៑, យទិ ត្វមីឝ្វរាត្មជោ ភវេស្តហ៌្យាជ្ញយា បាឞាណានេតាន៑ បូបាន៑ វិធេហិ។</para>
  <para style="p">
    <verse number="4" style="v"/>តតះ ស ប្រត្យព្រវីត៑, ឥត្ថំ លិខិតមាស្តេ, "មនុជះ កេវលបូបេន ន ជីវិឞ្យតិ, កិន្ត្វីឝ្វរស្យ វទនាទ៑ យានិ យានិ វចាំសិ និះសរន្តិ តៃរេវ ជីវិឞ្យតិ។ "</para>
  <para style="p">
    <verse number="5" style="v"/>តទា ប្រតារកស្តំ បុណ្យនគរំ នីត្វា មន្ទិរស្យ ចូឌោបរិ និធាយ គទិតវាន៑,</para>
  <para style="p">
    <verse number="6" style="v"/>ត្វំ យទិឝ្វរស្យ តនយោ ភវេស្តហ៌ីតោៜធះ បត, យត ឥត្ថំ លិខិតមាស្តេ, អាទេក្ឞ្យតិ និជាន៑ ទូតាន៑ រក្ឞិតុំ ត្វាំ បរមេឝ្វរះ។ យថា សវ៌្វេឞុ មាគ៌េឞុ ត្វទីយចរណទ្វយេ។ ន លគេត៑ ប្រស្តរាឃាតស្ត្វាំ ឃរិឞ្យន្តិ តេ ករៃះ៕</para>
  <para style="p">
    <verse number="7" style="v"/>តទានីំ យីឝុស្តស្មៃ កថិតវាន៑ ឯតទបិ លិខិតមាស្តេ, "ត្វំ និជប្រភុំ បរមេឝ្វរំ មា បរីក្ឞស្វ។ "</para>
  <para style="p">
    <verse number="8" style="v"/>អនន្តរំ ប្រតារកះ បុនរបិ តម៑ អត្យុញ្ចធរាធរោបរិ នីត្វា ជគតះ សកលរាជ្យានិ តទៃឝ្វយ៌្យាណិ ច ទឝ៌យាឝ្ចការ កថយាញ្ចការ ច,</para>
  <para style="p">
    <verse number="9" style="v"/>យទិ ត្វំ ទណ្ឌវទ៑ ភវន៑ មាំ ប្រណមេស្តហ៌្យហម៑ ឯតានិ តុភ្យំ ប្រទាស្យាមិ។</para>
  <para style="p">
    <verse number="10" style="v"/>តទានីំ យីឝុស្តមវោចត៑, ទូរីភវ ប្រតារក, លិខិតមិទម៑ អាស្តេ, "ត្វយា និជះ ប្រភុះ បរមេឝ្វរះ ប្រណម្យះ កេវលះ ស សេវ្យឝ្ច។ "</para>
  <para style="p">
    <verse number="11" style="v"/>តតះ ប្រតារកេណ ស បយ៌្យត្យាជិ, តទា ស្វគ៌ីយទូតៃរាគត្យ ស សិឞេវេ។</para>
  <para style="p">
    <verse number="12" style="v"/>តទនន្តរំ យោហន៑ ការាយាំ ពពន្ធេ, តទ្វាត៌្តាំ និឝម្យ យីឝុនា គាលីល៑ ប្រាស្ថីយត។</para>
  <para style="p">
    <verse number="13" style="v"/>តតះ បរំ ស នាសរន្នគរំ វិហាយ ជលឃេស្តដេ សិពូលូន្នប្តាលី ឯតយោរុវភយោះ ប្រទេឝយោះ សីម្នោម៌ធ្យវត៌្តី យ: កផន៌ាហូម៑ តន្នគរម៑ ឥត្វា ន្យវសត៑។</para>
  <para style="p">
    <verse number="14" style="v"/>តស្មាត៑, អន្យាទេឝីយគាលីលិ យទ៌្ទន្បារេៜព្ធិរោធសិ។ នប្តាលិសិពូលូន្ទេឝៅ យត្រ ស្ថានេ ស្ថិតៅ បុរា។</para>
  <para style="p">
    <verse number="15" style="v"/>តត្រត្យា មនុជា យេ យេ បយ៌្យភ្រាម្យន៑ តមិស្រកេ។ តៃជ៌នៃព៌្ឫហទាលោកះ បរិទឝ៌ិឞ្យតេ តទា។ អវសន៑ យេ ជនា ទេឝេ ម្ឫត្យុច្ឆាយាស្វរូបកេ។ តេឞាមុបរិ លោកានាមាលោកះ សំប្រកាឝិតះ៕</para>
  <para style="p">
    <verse number="16" style="v"/>យទេតទ្វចនំ យិឝយិយភវិឞ្យទ្វាទិនា ប្រោក្តំ, តត៑ តទា សផលម៑ អភូត៑។</para>
  <para style="p">
    <verse number="17" style="v"/>អនន្តរំ យីឝុះ សុសំវាទំ ប្រចារយន៑ ឯតាំ កថាំ កថយិតុម៑ អារេភេ, មនាំសិ បរាវត៌្តយត, ស្វគ៌ីយរាជត្វំ សវិធមភវត៑។</para>
  <para style="p">
    <verse number="18" style="v"/>តតះ បរំ យីឝុ រ្គាលីលោ ជលធេស្តដេន គច្ឆន៑ គច្ឆន៑ អាន្ទ្រិយស្តស្យ ភ្រាតា ឝិមោន៑ អត៌្ហតោ យំ បិតរំ វទន្តិ ឯតាវុភៅ ជលឃៅ ជាលំ ក្ឞិបន្តៅ ទទឝ៌, យតស្តៅ មីនធារិណាវាស្តាម៑។</para>
  <para style="p">
    <verse number="19" style="v"/>តទា ស តាវាហូយ វ្យាជហារ, យុវាំ មម បឝ្ចាទ៑ អាគច្ឆតំ, យុវាមហំ មនុជធារិណៅ ករិឞ្យាមិ។</para>
  <para style="p">
    <verse number="20" style="v"/>តេនៃវ តៅ ជាលំ វិហាយ តស្យ បឝ្ចាត៑ អាគច្ឆតាម៑។</para>
  <para style="p">
    <verse number="21" style="v"/>អនន្តរំ តស្មាត៑ ស្ថានាត៑ វ្រជន៑ វ្រជន៑ សិវទិយស្យ សុតៅ យាកូព៑ យោហន្នាមានៅ ទ្វៅ សហជៅ តាតេន សាទ៌្ធំ នៅកោបរិ ជាលស្យ ជីណ៌ោទ្ធារំ កុវ៌្វន្តៅ វីក្ឞ្យ តាវាហូតវាន៑។</para>
  <para style="p">
    <verse number="22" style="v"/>តត្ក្ឞណាត៑ តៅ នាវំ ស្វតាតញ្ច វិហាយ តស្យ បឝ្ចាទ្គាមិនៅ ពភូវតុះ។</para>
  <para style="p">
    <verse number="23" style="v"/>អនន្តរំ ភជនភវនេ សមុបទិឝន៑ រាជ្យស្យ សុសំវាទំ ប្រចារយន៑ មនុជានាំ សវ៌្វប្រការាន៑ រោគាន៑ សវ៌្វប្រការបីឌាឝ្ច ឝមយន៑ យីឝុះ ក្ឫត្ស្នំ គាលីល្ទេឝំ ភ្រមិតុម៑ អារភត។</para>
  <para style="p">
    <verse number="24" style="v"/>តេន ក្ឫត្ស្នសុរិយាទេឝស្យ មធ្យំ តស្យ យឝោ វ្យាប្នោត៑, អបរំ ភូតគ្រស្តា អបស្មារគ៌ីណះ បក្ឞាធាតិប្រភ្ឫតយឝ្ច យាវន្តោ មនុជា នានាវិធវ្យាធិភិះ ក្លិឞ្ដា អាសន៑, តេឞុ សវ៌្វេឞុ តស្យ សមីបម៑ អានីតេឞុ ស តាន៑ ស្វស្ថាន៑ ចការ។</para>
  <para style="p">
    <verse number="25" style="v"/>ឯតេន គាលីល៑-ទិកាបនិ-យិរូឝាលម៑-យិហូទីយទេឝេភ្យោ យទ៌្ទនះ បារាញ្ច ពហវោ មនុជាស្តស្យ បឝ្ចាទ៑ អាគច្ឆន៑។</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ ស ជននិវហំ និរីក្ឞ្យ ភូធរោបរិ វ្រជិត្វា សមុបវិវេឝ។</para>
  <para style="p">
    <verse number="2" style="v"/>តទានីំ ឝិឞ្យេឞុ តស្យ សមីបមាគតេឞុ តេន តេភ្យ ឯឞា កថា កថ្យាញ្ចក្រេ។</para>
  <para style="p">
    <verse number="3" style="v"/>អភិមានហីនា ជនា ធន្យាះ, យតស្តេ ស្វគ៌ីយរាជ្យម៑ អធិករិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="4" style="v"/>ខិទ្យមានា មនុជា ធន្យាះ, យស្មាត៑ តេ សាន្ត្វនាំ ប្រាប្សន្តិ។</para>
  <para style="p">
    <verse number="5" style="v"/>នម្រា មានវាឝ្ច ធន្យាះ, យស្មាត៑ តេ មេទិនីម៑ អធិករិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="6" style="v"/>ធម៌្មាយ ពុភុក្ឞិតាះ ត្ឫឞាត៌្តាឝ្ច មនុជា ធន្យាះ, យស្មាត៑ តេ បរិតប៌្ស្យន្តិ។</para>
  <para style="p">
    <verse number="7" style="v"/>ក្ឫបាលវោ មានវា ធន្យាះ, យស្មាត៑ តេ ក្ឫបាំ ប្រាប្ស្យន្តិ។</para>
  <para style="p">
    <verse number="8" style="v"/>និម៌្មលហ្ឫទយា មនុជាឝ្ច ធន្យាះ, យស្មាត៑ ត ឦឝ្ចរំ ទ្រក្ឞ្យន្តិ។</para>
  <para style="p">
    <verse number="9" style="v"/>មេលយិតារោ មានវា ធន្យាះ, យស្មាត៑ ត ឦឝ្ចរស្យ សន្តានត្វេន វិខ្យាស្យន្តិ។</para>
  <para style="p">
    <verse number="10" style="v"/>ធម៌្មការណាត៑ តាឌិតា មនុជា ធន្យា, យស្មាត៑ ស្វគ៌ីយរាជ្យេ តេឞាមធិករោ វិទ្យតេ។</para>
  <para style="p">
    <verse number="11" style="v"/>យទា មនុជា មម នាមក្ឫតេ យុឞ្មាន៑ និន្ទន្តិ តាឌយន្តិ ម្ឫឞា នានាទុវ៌្វាក្យានិ វទន្តិ ច, តទា យុយំ ធន្យាះ។</para>
  <para style="p">
    <verse number="12" style="v"/>តទា អានន្ទត, តថា ភ្ឫឝំ ហ្លាទធ្វញ្ច, យតះ ស្វគ៌េ ភូយាំសិ ផលានិ លប្ស្យធ្វេ; តេ យុឞ្មាកំ បុរាតនាន៑ ភវិឞ្យទ្វាទិនោៜបិ តាទ្ឫគ៑ អតាឌយន៑។</para>
  <para style="p">
    <verse number="13" style="v"/>យុយំ មេទិន្យាំ លវណរូបាះ, កិន្តុ យទិ លវណស្យ លវណត្វម៑ អបយាតិ, តហ៌ិ តត៑ កេន ប្រការេណ ស្វាទុយុក្តំ ភវិឞ្យតិ? តត៑ កស្យាបិ កាយ៌្យស្យាយោគ្យត្វាត៑ កេវលំ ពហិះ ប្រក្ឞេប្តុំ នរាណាំ បទតលេន ទលយិតុញ្ច យោគ្យំ ភវតិ។</para>
  <para style="p">
    <verse number="14" style="v"/>យូយំ ជគតិ ទីប្តិរូបាះ, ភូធរោបរិ ស្ថិតំ នគរំ គុប្តំ ភវិតុំ នហិ ឝក្ឞ្យតិ។</para>
  <para style="p">
    <verse number="15" style="v"/>អបរំ មនុជាះ ប្រទីបាន៑ ប្រជ្វាល្យ ទ្រោណាធោ ន ស្ថាបយន្តិ, កិន្តុ ទីបាធារោបយ៌្យេវ ស្ថាបយន្តិ, តេន តេ ទីបា គេហស្ថិតាន៑ សកលាន៑ ប្រកាឝយន្តិ។</para>
  <para style="p">
    <verse number="16" style="v"/>យេន មានវា យុឞ្មាកំ សត្កម៌្មាណិ វិលោក្យ យុឞ្មាកំ ស្វគ៌ស្ថំ បិតរំ ធន្យំ វទន្តិ, តេឞាំ សមក្ឞំ យុឞ្មាកំ ទីប្តិស្តាទ្ឫក៑ ប្រកាឝតាម៑។</para>
  <para style="p">
    <verse number="17" style="v"/>អហំ វ្យវស្ថាំ ភវិឞ្យទ្វាក្យញ្ច លោប្តុម៑ អាគតវាន៑, ឥត្ថំ មានុភវត, តេ ទ្វេ លោប្តុំ នាគតវាន៑, កិន្តុ សផលេ កត៌្តុម៑ អាគតោស្មិ។</para>
  <para style="p">
    <verse number="18" style="v"/>អបរំ យុឞ្មាន៑ អហំ តថ្យំ វទាមិ យាវត៑ វ្យោមមេទិន្យោ រ្ធ្វំសោ ន ភវិឞ្យតិ, តាវត៑ សវ៌្វស្មិន៑ សផលេ ន ជាតេ វ្យវស្ថាយា ឯកា មាត្រា ពិន្ទុរេកោបិ វា ន លោប្ស្យតេ។</para>
  <para style="p">
    <verse number="19" style="v"/>តស្មាត៑ យោ ជន ឯតាសាម៑ អាជ្ញានាម៑ អតិក្ឞុទ្រាម៑ ឯកាជ្ញាមបី លំឃតេ មនុជាំញ្ច តថៃវ ឝិក្ឞយតិ, ស ស្វគ៌ីយរាជ្យេ សវ៌្វេភ្យះ ក្ឞុទ្រត្វេន វិខ្យាស្យតេ, កិន្តុ យោ ជនស្តាំ បាលយតិ, តថៃវ ឝិក្ឞយតិ ច, ស ស្វគ៌ីយរាជ្យេ ប្រធានត្វេន វិខ្យាស្យតេ។</para>
  <para style="p">
    <verse number="20" style="v"/>អបរំ យុឞ្មាន៑ អហំ វទាមិ, អធ្យាបកផិរូឝិមានវានាំ ធម៌្មានុឞ្ឋានាត៑ យុឞ្មាកំ ធម៌្មានុឞ្ឋានេ នោត្តមេ ជាតេ យូយម៑ ឦឝ្វរីយរាជ្យំ ប្រវេឞ្ដុំ ន ឝក្ឞ្យថ។</para>
  <para style="p">
    <verse number="21" style="v"/>អបរញ្ច ត្វំ នរំ មា វធីះ, យស្មាត៑ យោ នរំ ហន្តិ, ស វិចារសភាយាំ ទណ្ឌាហ៌ោ ភវិឞ្យតិ, បូវ៌្វកាលីនជនេភ្យ ឥតិ កថិតមាសីត៑, យុឞ្មាភិរឝ្រាវិ។</para>
  <para style="p">
    <verse number="22" style="v"/>កិន្ត្វហំ យុឞ្មាន៑ វទាមិ, យះ កឝ្ចិត៑ ការណំ វិនា និជភ្រាត្រេ កុប្យតិ, ស វិចារសភាយាំ ទណ្ឌាហ៌ោ ភវិឞ្យតិ; យះ កឝ្ចិច្ច ស្វីយសហជំ និព៌្ពោធំ វទតិ, ស មហាសភាយាំ ទណ្ឌាហ៌ោ ភវិឞ្យតិ; បុនឝ្ច ត្វំ មូឍ ឥតិ វាក្យំ យទិ កឝ្ចិត៑ ស្វីយភ្រាតរំ វក្តិ, តហ៌ិ នរកាគ្នៅ ស ទណ្ឌាហ៌ោ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="23" style="v"/>អតោ វេទ្យាះ សមីបំ និជនៃវេទ្យេ សមានីតេៜបិ និជភ្រាតរំ ប្រតិ កស្មាច្ចិត៑ ការណាត៑ ត្វំ យទិ ទោឞី វិទ្យសេ, តទានីំ តវ តស្យ ស្ម្ឫតិ រ្ជាយតេ ច,</para>
  <para style="p">
    <verse number="24" style="v"/>តហ៌ិ តស្យា វេទ្យាះ សមីបេ និជនៃវៃទ្យំ និធាយ តទៃវ គត្វា បូវ៌្វំ តេន សាទ៌្ធំ មិល, បឝ្ចាត៑ អាគត្យ និជនៃវេទ្យំ និវេទយ។</para>
  <para style="p">
    <verse number="25" style="v"/>អន្យញ្ច យាវត៑ វិវាទិនា សាទ៌្ធំ វត៌្មនិ តិឞ្ឋសិ, តាវត៑ តេន សាទ៌្ធំ មេលនំ កុរុ; នោ ចេត៑ វិវាទី វិចារយិតុះ សមីបេ ត្វាំ សមប៌យតិ វិចារយិតា ច រក្ឞិណះ សន្និធៅ សមប៌យតិ តទា ត្វំ ការាយាំ ពធ្យេថាះ។</para>
  <para style="p">
    <verse number="26" style="v"/>តហ៌ិ ត្វាមហំ តថ្ថំ ព្រវីមិ, ឝេឞកបទ៌កេៜបិ ន បរិឝោធិតេ តស្មាត៑ ស្ថានាត៑ កទាបិ ពហិរាគន្តុំ ន ឝក្ឞ្យសិ។</para>
  <para style="p">
    <verse number="27" style="v"/>អបរំ ត្វំ មា វ្យភិចរ, យទេតទ៑ វចនំ បូវ៌្វកាលីនលោកេភ្យះ កថិតមាសីត៑, តទ៑ យូយំ ឝ្រុតវន្តះ;</para>
  <para style="p">
    <verse number="28" style="v"/>កិន្ត្វហំ យុឞ្មាន៑ វទាមិ, យទិ កឝ្ចិត៑ កាមតះ កាញ្ចន យោឞិតំ បឝ្យតិ, តហ៌ិ ស មនសា តទៃវ វ្យភិចរិតវាន៑។</para>
  <para style="p">
    <verse number="29" style="v"/>តស្មាត៑ តវ ទក្ឞិណំ នេត្រំ យទិ ត្វាំ ពាធតេ, តហ៌ិ តន្នេត្រម៑ ឧត្បាដ្យ ទូរេ និក្ឞិប, យស្មាត៑ តវ សវ៌្វវបុឞោ នរកេ និក្ឞេបាត៑ តវៃកាង្គស្យ នាឝោ វរំ។</para>
  <para style="p">
    <verse number="30" style="v"/>យទ្វា តវ ទក្ឞិណះ ករោ យទិ ត្វាំ ពាធតេ, តហ៌ិ តំ ករំ ឆិត្ត្វា ទូរេ និក្ឞិប, យតះ សវ៌្វវបុឞោ នរកេ និក្ឞេបាត៑ ឯកាង្គស្យ នាឝោ វរំ។</para>
  <para style="p">
    <verse number="31" style="v"/>ឧក្តមាស្តេ, យទិ កឝ្ចិន៑ និជជាយាំ បរិត្យក្ត្តុម៑ ឥច្ឆតិ, តហ៌ិ ស តស្យៃ ត្យាគបត្រំ ទទាតុ។</para>
  <para style="p">
    <verse number="32" style="v"/>កិន្ត្វហំ យុឞ្មាន៑ វ្យាហរាមិ, វ្យភិចារទោឞេ ន ជាតេ យទិ កឝ្ចិន៑ និជជាយាំ បរិត្យជតិ, តហ៌ិ ស តាំ វ្យភិចារយតិ; យឝ្ច តាំ ត្យក្តាំ ស្ត្រិយំ វិវហតិ, សោបិ វ្យភិចរតិ។</para>
  <para style="p">
    <verse number="33" style="v"/>បុនឝ្ច ត្វំ ម្ឫឞា ឝបថម៑ ន កុវ៌្វន៑ ឦឝ្ចរាយ និជឝបថំ បាលយ, បូវ៌្វកាលីនលោកេភ្យោ យៃឞា កថា កថិតា, តាមបិ យូយំ ឝ្រុតវន្តះ។</para>
  <para style="p">
    <verse number="34" style="v"/>កិន្ត្វហំ យុឞ្មាន៑ វទាមិ, កមបិ ឝបថំ មា កាឞ៌្ដ, អត៌្ហតះ ស្វគ៌នាម្នា ន, យតះ ស ឦឝ្វរស្យ សិំហាសនំ;</para>
  <para style="p">
    <verse number="35" style="v"/>ប្ឫថិវ្យា នាម្នាបិ ន, យតះ សា តស្យ បាទបីឋំ; យិរូឝាលមោ នាម្នាបិ ន, យតះ សា មហារាជស្យ បុរី;</para>
  <para style="p">
    <verse number="36" style="v"/>និជឝិរោនាម្នាបិ ន, យស្មាត៑ តស្យៃកំ កចមបិ សិតម៑ អសិតំ វា កត៌្តុំ ត្វយា ន ឝក្យតេ។</para>
  <para style="p">
    <verse number="37" style="v"/>អបរំ យូយំ សំលាបសមយេ កេវលំ ភវតីតិ ន ភវតីតិ ច វទត យត ឥតោៜធិកំ យត៑ តត៑ បាបាត្មនោ ជាយតេ។</para>
  <para style="p">
    <verse number="38" style="v"/>អបរំ លោចនស្យ វិនិមយេន លោចនំ ទន្តស្យ វិនិមយេន ទន្តះ បូវ៌្វក្តមិទំ វចនញ្ច យុឞ្មាភិរឝ្រូយត។</para>
  <para style="p">
    <verse number="39" style="v"/>កិន្ត្វហំ យុឞ្មាន៑ វទាមិ យូយំ ហិំសកំ នរំ មា វ្យាឃាតយត។ កិន្តុ កេនចិត៑ តវ ទក្ឞិណកបោលេ ចបេដាឃាតេ ក្ឫតេ តំ ប្រតិ វាមំ កបោលញ្ច វ្យាឃោដយ។</para>
  <para style="p">
    <verse number="40" style="v"/>អបរំ កេនចិត៑ ត្វយា សាទ៌្ហ្ទំ វិវាទំ ក្ឫត្វា តវ បរិធេយវសនេ ជិឃ្ឫតិតេ តស្មាយុត្តរីយវសនមបិ ទេហិ។</para>
  <para style="p">
    <verse number="41" style="v"/>យទិ កឝ្ចិត៑ ត្វាំ ក្រោឝមេកំ នយនាត៌្ហំ អន្យាយតោ ធរតិ, តទា តេន សាទ៌្ហ្ទំ ក្រោឝទ្វយំ យាហិ។</para>
  <para style="p">
    <verse number="42" style="v"/>យឝ្ច មានវស្ត្វាំ យាចតេ, តស្មៃ ទេហិ, យទិ កឝ្ចិត៑ តុភ្យំ ធារយិតុម៑ ឥច្ឆតិ, តហ៌ិ តំ ប្រតិ បរាំមុខោ មា ភូះ។</para>
  <para style="p">
    <verse number="43" style="v"/>និជសមីបវសិនិ ប្រេម កុរុ, កិន្តុ ឝត្រុំ ប្រតិ ទ្វេឞំ កុរុ, យទេតត៑ បុរោក្តំ វចនំ ឯតទបិ យូយំ ឝ្រុតវន្តះ។</para>
  <para style="p">
    <verse number="44" style="v"/>កិន្ត្វហំ យុឞ្មាន៑ វទាមិ, យូយំ រិបុវ្វបិ ប្រេម កុរុត, យេ ច យុឞ្មាន៑ ឝបន្តេ, តាន, អាឝិឞំ វទត, យេ ច យុឞ្មាន៑ ឫृតីយន្តេ, តេឞាំ មង្គលំ កុរុត, យេ ច យុឞ្មាន៑ និន្ទន្តិ, តាឌយន្តិ ច, តេឞាំ ក្ឫតេ ប្រាត៌្ហយធ្វំ។</para>
  <para style="p">
    <verse number="45" style="v"/>តត្រ យះ សតាមសតាញ្ចោបរិ ប្រភាករម៑ ឧទាយយតិ, តថា ធាម៌្មិកានាមធាម៌្មិកានាញ្ចោបរិ នីរំ វឞ៌យតិ តាទ្ឫឝោ យោ យុឞ្មាកំ ស្វគ៌ស្ថះ បិតា, យូយំ តស្យៃវ សន្តានា ភវិឞ្យថ។</para>
  <para style="p">
    <verse number="46" style="v"/>យេ យុឞ្មាសុ ប្រេម កុវ៌្វន្តិ, យូយំ យទិ កេវលំ តេវ្វេវ ប្រេម កុរុថ, តហ៌ិ យុឞ្មាកំ កិំ ផលំ ភវិឞ្យតិ? ចណ្ឌាលា អបិ តាទ្ឫឝំ កិំ ន កុវ៌្វន្តិ?</para>
  <para style="p">
    <verse number="47" style="v"/>អបរំ យូយំ យទិ កេវលំ ស្វីយភ្រាត្ឫត្វេន នមត, តហ៌ិ កិំ មហត៑ កម៌្ម កុរុថ? ចណ្ឌាលា អបិ តាទ្ឫឝំ កិំ ន កុវ៌្វន្តិ?</para>
  <para style="p">
    <verse number="48" style="v"/>តស្មាត៑ យុឞ្មាកំ ស្វគ៌ស្ថះ បិតា យថា បូណ៌ោ ភវតិ, យូយមបិ តាទ្ឫឝា ភវត។</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>សាវធានា ភវត, មនុជាន៑ ទឝ៌យិតុំ តេឞាំ គោចរេ ធម៌្មកម៌្ម មា កុរុត, តថា ក្ឫតេ យុឞ្មាកំ ស្វគ៌ស្ថបិតុះ សកាឝាត៑ កិញ្ចន ផលំ ន ប្រាប្ស្យថ។</para>
  <para style="p">
    <verse number="2" style="v"/>ត្វំ យទា ទទាសិ តទា កបដិនោ ជនា យថា មនុជេភ្យះ ប្រឝំសាំ ប្រាប្តុំ ភជនភវនេ រាជមាគ៌េ ច តូរីំ វាទយន្តិ, តថា មា កុរិु, អហំ តុភ្យំ យថាត៌្ហំ កថយាមិ, តេ ស្វកាយំ ផលម៑ អលភន្ត។</para>
  <para style="p">
    <verse number="3" style="v"/>កិន្តុ ត្វំ យទា ទទាសិ, តទា និជទក្ឞិណករោ យត៑ ករោតិ, តទ៑ វាមករំ មា ជ្ញាបយ។</para>
  <para style="p">
    <verse number="4" style="v"/>តេន តវ ទានំ គុប្តំ ភវិឞ្យតិ យស្តុ តវ បិតា គុប្តទឝ៌ី, ស ប្រកាឝ្យ តុភ្យំ ផលំ ទាស្យតិ។</para>
  <para style="p">
    <verse number="5" style="v"/>អបរំ យទា ប្រាត៌្ហយសេ, តទា កបដិនឥវ មា កុរុ, យស្មាត៑ តេ ភជនភវនេ រាជមាគ៌ស្យ កោណេ តិឞ្ឋន្តោ លោកាន៑ ទឝ៌យន្តះ ប្រាត៌្ហយិតុំ ប្រីយន្តេ; អហំ យុឞ្មាន៑ តថ្យំ វទាមិ, តេ ស្វកីយផលំ ប្រាប្នុវន៑។</para>
  <para style="p">
    <verse number="6" style="v"/>តស្មាត៑ ប្រាត៌្ហនាកាលេ អន្តរាគារំ ប្រវិឝ្យ ទ្វារំ រុទ្វ្វា គុប្តំ បឝ្យតស្តវ បិតុះ សមីបេ ប្រាត៌្ហយស្វ; តេន តវ យះ បិតា គុប្តទឝ៌ី, ស ប្រកាឝ្យ តុភ្យំ ផលំ ទាស្យតិl</para>
  <para style="p">
    <verse number="7" style="v"/>អបរំ ប្រាត៌្ហនាកាលេ ទេវបូជកាឥវ មុធា បុនរុក្តិំ មា កុរុ, យស្មាត៑ តេ ពោធន្តេ, ពហុវារំ កថាយាំ កថិតាយាំ តេឞាំ ប្រាត៌្ហនា គ្រាហិឞ្យតេ។</para>
  <para style="p">
    <verse number="8" style="v"/>យូយំ តេឞាមិវ មា កុរុត, យស្មាត៑ យុឞ្មាកំ យទ៑ យត៑ ប្រយោជនំ យាចនាតះ ប្រាគេវ យុឞ្មាកំ បិតា តត៑ ជានាតិ។</para>
  <para style="p">
    <verse number="9" style="v"/>អតឯវ យូយម ឦទ្ឫក៑ ប្រាត៌្ហយធ្វំ, ហេ អស្មាកំ ស្វគ៌ស្ថបិតះ, តវ នាម បូជ្យំ ភវតុ។</para>
  <para style="p">
    <verse number="10" style="v"/>តវ រាជត្វំ ភវតុ; តវេច្ឆា ស្វគ៌េ យថា តថៃវ មេទិន្យាមបិ សផលា ភវតុ។</para>
  <para style="p">
    <verse number="11" style="v"/>អស្មាកំ ប្រយោជនីយម៑ អាហារម៑ អទ្យ ទេហិ។</para>
  <para style="p">
    <verse number="12" style="v"/>វយំ យថា និជាបរាធិនះ ក្ឞមាមហេ, តថៃវាស្មាកម៑ អបរាធាន៑ ក្ឞមស្វ។</para>
  <para style="p">
    <verse number="13" style="v"/>អស្មាន៑ បរីក្ឞាំ មានយ, កិន្តុ បាបាត្មនោ រក្ឞ; រាជត្វំ គៅរវំ បរាក្រមះ ឯតេ សវ៌្វេ សវ៌្វទា តវ; តថាស្តុ។</para>
  <para style="p">
    <verse number="14" style="v"/>យទិ យូយម៑ អន្យេឞាម៑ អបរាធាន៑ ក្ឞមធ្វេ តហ៌ិ យុឞ្មាកំ ស្វគ៌ស្ថបិតាបិ យុឞ្មាន៑ ក្ឞមិឞ្យតេ;</para>
  <para style="p">
    <verse number="15" style="v"/>កិន្តុ យទិ យូយម៑ អន្យេឞាម៑ អបរាធាន៑ ន ក្ឞមធ្វេ, តហ៌ិ យុឞ្មាកំ ជនកោបិ យុឞ្មាកម៑ អបរាធាន៑ ន ក្ឞមិឞ្យតេ។</para>
  <para style="p">
    <verse number="16" style="v"/>អបរម៑ ឧបវាសកាលេ កបដិនោ ជនា មានុឞាន៑ ឧបវាសំ ជ្ញាបយិតុំ ស្វេឞាំ វទនានិ ម្លានានិ កុវ៌្វន្តិ, យូយំ តឥវ វិឞណវទនា មា ភវត; អហំ យុឞ្មាន៑ តថ្យំ វទាមិ តេ ស្វកីយផលម៑ អលភន្ត។</para>
  <para style="p">
    <verse number="17" style="v"/>យទា ត្វម៑ ឧបវសសិ, តទា យថា លោកៃស្ត្វំ ឧបវាសីវ ន ទ្ឫឝ្យសេ, កិន្តុ តវ យោៜគោចរះ បិតា តេនៃវ ទ្ឫឝ្យសេ, តត្ក្ឫតេ និជឝិរសិ តៃលំ មទ៌្ទយ វទនញ្ច ប្រក្ឞាលយ;</para>
  <para style="p">
    <verse number="18" style="v"/>តេន តវ យះ បិតា គុប្តទឝ៌ី ស ប្រកាឝ្យ តុភ្យំ ផលំ ទាស្យតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>អបរំ យត្រ ស្ថានេ កីដាះ កលង្កាឝ្ច ក្ឞយំ នយន្តិ, ចៅរាឝ្ច សន្ធិំ កត៌្តយិត្វា ចោរយិតុំ ឝក្នុវន្តិ, តាទ្ឫឝ្យាំ មេទិន្យាំ ស្វាត៌្ហំ ធនំ មា សំចិនុត។</para>
  <para style="p">
    <verse number="20" style="v"/>កិន្តុ យត្រ ស្ថានេ កីដាះ កលង្កាឝ្ច ក្ឞយំ ន នយន្តិ, ចៅរាឝ្ច សន្ធិំ កត៌្តយិត្វា ចោរយិតុំ ន ឝក្នុវន្តិ, តាទ្ឫឝេ ស្វគ៌េ ធនំ សញ្ចិនុត។</para>
  <para style="p">
    <verse number="21" style="v"/>យស្មាត៑ យត្រ ស្ថានេ យុឞ្មាំក ធនំ តត្រៃវ ខានេ យុឞ្មាកំ មនាំសិ។</para>
  <para style="p">
    <verse number="22" style="v"/>លោចនំ ទេហស្យ ប្រទីបកំ, តស្មាត៑ យទិ តវ លោចនំ ប្រសន្នំ ភវតិ, តហ៌ិ តវ ក្ឫត្ស្នំ វបុ រ្ទីប្តិយុក្តំ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="23" style="v"/>កិន្តុ លោចនេៜប្រសន្នេ តវ ក្ឫត្ស្នំ វបុះ តមិស្រយុក្តំ ភវិឞ្យតិ។ អតឯវ យា ទីប្តិស្ត្វយិ វិទ្យតេ, សា យទិ តមិស្រយុក្តា ភវតិ, តហ៌ិ តត៑ តមិស្រំ កិយន៑ មហត៑។</para>
  <para style="p">
    <verse number="24" style="v"/>កោបិ មនុជោ ទ្វៅ ប្រភូ សេវិតុំ ន ឝក្នោតិ, យស្មាទ៑ ឯកំ សំមន្យ តទន្យំ ន សម្មន្យតេ, យទ្វា ឯកត្រ មនោ និធាយ តទន្យម៑ អវមន្យតេ; តថា យូយមបីឝ្វរំ លក្ឞ្មីញ្ចេត្យុភេ សេវិតុំ ន ឝក្នុថ។</para>
  <para style="p">
    <verse number="25" style="v"/>អបរម៑ អហំ យុឞ្មភ្យំ តថ្យំ កថយាមិ, កិំ ភក្ឞិឞ្យាមះ? កិំ បាស្យាមះ? ឥតិ ប្រាណធារណាយ មា ចិន្តយត; កិំ បរិធាស្យាមះ? ឥតិ កាយរក្ឞណាយ ន ចិន្តយត; ភក្ឞ្យាត៑ ប្រាណា វសនាញ្ច វបូំឞិ កិំ ឝ្រេឞ្ឋាណិ ន ហិ?</para>
  <para style="p">
    <verse number="26" style="v"/>វិហាយសោ វិហង្គមាន៑ វិលោកយត; តៃ រ្នោប្យតេ ន ក្ឫត្យតេ ភាណ្ឌាគារេ ន សញ្ចីយតេៜបិ; តថាបិ យុឞ្មាកំ ស្វគ៌ស្ថះ បិតា តេភ្យ អាហារំ វិតរតិ។</para>
  <para style="p">
    <verse number="27" style="v"/>យូយំ តេភ្យះ កិំ ឝ្រេឞ្ឋា ន ភវថ? យុឞ្មាកំ កឝ្ចិត៑ មនុជះ ចិន្តយន៑ និជាយុឞះ ក្ឞណមបិ វទ៌្ធយិតុំ ឝក្នោតិ?</para>
  <para style="p">
    <verse number="28" style="v"/>អបរំ វសនាយ កុតឝ្ចិន្តយត? ក្ឞេត្រោត្បន្នានិ បុឞ្បាណិ កថំ វទ៌្ធន្តេ តទាលោចយត។ តានិ តន្តូន៑ នោត្បាទយន្តិ កិមបិ កាយ៌្យំ ន កុវ៌្វន្តិ;</para>
  <para style="p">
    <verse number="29" style="v"/>តថាប្យហំ យុឞ្មាន៑ វទាមិ, សុលេមាន៑ តាទ្ឫគ៑ ឰឝ្វយ៌្យវានបិ តត្បុឞ្បមិវ វិភូឞិតោ នាសីត៑។</para>
  <para style="p">
    <verse number="30" style="v"/>តស្មាត៑ ក្ឞទ្យ វិទ្យមានំ ឝ្ចះ ចុល្ល្យាំ និក្ឞេប្ស្យតេ តាទ្ឫឝំ យត៑ ក្ឞេត្រស្ថិតំ កុសុមំ តត៑ យទីឝ្ចរ ឥត្ថំ ពិភូឞយតិ, តហ៌ិ ហេ ស្តោកប្រត្យយិនោ យុឞ្មាន៑ កិំ ន បរិធាបយិឞ្យតិ?</para>
  <para style="p">
    <verse number="31" style="v"/>តស្មាត៑ អស្មាភិះ កិមត្ស្យតេ? កិញ្ច បាយិឞ្យតេ? កិំ វា បរិធាយិឞ្យតេ, ឥតិ ន ចិន្តយត។</para>
  <para style="p">
    <verse number="32" style="v"/>យស្មាត៑ ទេវាច៌្ចកា អបីតិ ចេឞ្ដន្តេ; ឯតេឞុ ទ្រវ្យេឞុ ប្រយោជនមស្តីតិ យុឞ្មាកំ ស្វគ៌ស្ថះ បិតា ជានាតិ។</para>
  <para style="p">
    <verse number="33" style="v"/>អតឯវ ប្រថមត ឦឝ្វរីយរាជ្យំ ធម៌្មញ្ច ចេឞ្ដធ្វំ, តត ឯតានិ វស្តូនិ យុឞ្មភ្យំ ប្រទាយិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="34" style="v"/>ឝ្វះ ក្ឫតេ មា ចិន្តយត, ឝ្វឯវ ស្វយំ ស្វមុទ្ទិឝ្យ ចិន្តយិឞ្យតិ; អទ្យតនី យា ចិន្តា សាទ្យក្ឫតេ ប្រចុរតរា។</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យថា យូយំ ទោឞីក្ឫតា ន ភវថ, តត្ក្ឫតេៜន្យំ ទោឞិណំ មា កុរុត។</para>
  <para style="p">
    <verse number="2" style="v"/>យតោ យាទ្ឫឝេន ទោឞេណ យូយំ បរាន៑ ទោឞិណះ កុរុថ, តាទ្ឫឝេន ទោឞេណ យូយមបិ ទោឞីក្ឫតា ភវិឞ្យថ, អន្យញ្ច យេន បរិមាណេន យុឞ្មាភិះ បរិមីយតេ, តេនៃវ បរិមាណេន យុឞ្មត្ក្ឫតេ បរិមាយិឞ្យតេ។</para>
  <para style="p">
    <verse number="3" style="v"/>អបរញ្ច និជនយនេ យា នាសា វិទ្យតេ, តាម៑ អនាលោច្យ តវ សហជស្យ លោចនេ យត៑ ត្ឫណម៑ អាស្តេ, តទេវ កុតោ វីក្ឞសេ?</para>
  <para style="p">
    <verse number="4" style="v"/>តវ និជលោចនេ នាសាយាំ វិទ្យមានាយាំ, ហេ ភ្រាតះ, តវ នយនាត៑ ត្ឫណំ ពហិឞ្យត៌ុំ អនុជានីហិ, កថាមេតាំ និជសហជាយ កថំ កថយិតុំ ឝក្នោឞិ?</para>
  <para style="p">
    <verse number="5" style="v"/>ហេ កបដិន៑, អាទៅ និជនយនាត៑ នាសាំ ពហិឞ្កុរុ តតោ និជទ្ឫឞ្ដៅ សុប្រសន្នាយាំ តវ ភ្រាត្ឫ រ្លោចនាត៑ ត្ឫណំ ពហិឞ្កត៌ុំ ឝក្ឞ្យសិ។</para>
  <para style="p">
    <verse number="6" style="v"/>អន្យញ្ច សារមេយេភ្យះ បវិត្រវស្តូនិ មា វិតរត, វរាហាណាំ សមក្ឞញ្ច មុក្តា មា និក្ឞិបត; និក្ឞេបណាត៑ តេ តាះ សវ៌្វាះ បទៃ រ្ទលយិឞ្យន្តិ, បរាវ្ឫត្យ យុឞ្មានបិ វិទារយិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="7" style="v"/>យាចធ្វំ តតោ យុឞ្មភ្យំ ទាយិឞ្យតេ; ម្ឫគយធ្វំ តត ឧទ្ទេឝំ លប្ស្យធ្វេ; ទ្វារម៑ អាហត, តតោ យុឞ្មត្ក្ឫតេ មុក្តំ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="8" style="v"/>យស្មាទ៑ យេន យាច្យតេ, តេន លភ្យតេ; យេន ម្ឫគ្យតេ តេនោទ្ទេឝះ ប្រាប្យតេ; យេន ច ទ្វារម៑ អាហន្យតេ, តត្ក្ឫតេ ទ្វារំ មោច្យតេ។</para>
  <para style="p">
    <verse number="9" style="v"/>អាត្មជេន បូបេ ប្រាត៌្ហិតេ តស្មៃ បាឞាណំ វិឝ្រាណយតិ,</para>
  <para style="p">
    <verse number="10" style="v"/>មីនេ យាចិតេ ច តស្មៃ ភុជគំ វិតរតិ, ឯតាទ្ឫឝះ បិតា យុឞ្មាកំ មធ្យេ ក អាស្តេ?</para>
  <para style="p">
    <verse number="11" style="v"/>តស្មាទ៑ យូយម៑ អភទ្រាះ សន្តោៜបិ យទិ និជពាលកេភ្យ ឧត្តមំ ទ្រវ្យំ ទាតុំ ជានីថ, តហ៌ិ យុឞ្មាកំ ស្វគ៌ស្ថះ បិតា ស្វីយយាចកេភ្យះ កិមុត្តមានិ វស្តូនិ ន ទាស្យតិ?</para>
  <para style="p">
    <verse number="12" style="v"/>យូឞ្មាន៑ ប្រតីតរេឞាំ យាទ្ឫឝោ វ្យវហារោ យុឞ្មាកំ ប្រិយះ, យូយំ តាន៑ ប្រតិ តាទ្ឫឝានេវ វ្យវហារាន៑ វិធត្ត; យស្មាទ៑ វ្យវស្ថាភវិឞ្យទ្វាទិនាំ វចនានាម៑ ឥតិ សារម៑។</para>
  <para style="p">
    <verse number="13" style="v"/>សង្កីណ៌ទ្វារេណ ប្រវិឝត; យតោ នរកគមនាយ យទ៑ ទ្វារំ តទ៑ វិស្តីណ៌ំ យច្ច វត៌្ម តទ៑ ព្ឫហត៑ តេន ពហវះ ប្រវិឝន្តិ។</para>
  <para style="p">
    <verse number="14" style="v"/>អបរំ ស្វគ៌គមនាយ យទ៑ ទ្វារំ តត៑ កីទ្ឫក៑ សំកីណ៌ំ។ យច្ច វត៌្ម តត៑ កីទ្ឫគ៑ ទុគ៌មម៑។ តទុទ្ទេឞ្ដារះ កិយន្តោៜល្បាះ។</para>
  <para style="p">
    <verse number="15" style="v"/>អបរញ្ច យេ ជនា មេឞវេឝេន យុឞ្មាកំ សមីបម៑ អាគច្ឆន្តិ, កិន្ត្វន្តទ៌ុរន្តា វ្ឫកា ឯតាទ្ឫឝេភ្យោ ភវិឞ្យទ្វាទិភ្យះ សាវធានា ភវត, យូយំ ផលេន តាន៑ បរិចេតុំ ឝក្នុថ។</para>
  <para style="p">
    <verse number="16" style="v"/>មនុជាះ កិំ កណ្ដកិនោ វ្ឫក្ឞាទ៑ ទ្រាក្ឞាផលានិ ឝ្ឫគាលកោលិតឝ្ច ឧឌុម្ពរផលានិ ឝាតយន្តិ?</para>
  <para style="p">
    <verse number="17" style="v"/>តទ្វទ៑ ឧត្តម ឯវ បាទប ឧត្តមផលានិ ជនយតិ, អធមបាទបឯវាធមផលានិ ជនយតិ។</para>
  <para style="p">
    <verse number="18" style="v"/>កិន្តូត្តមបាទបះ កទាប្យធមផលានិ ជនយិតុំ ន ឝក្នោតិ, តថាធមោបិ បាទប ឧត្តមផលានិ ជនយិតុំ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>អបរំ យេ យេ បាទបា អធមផលានិ ជនយន្តិ, តេ ក្ឫត្តា វហ្នៅ ក្ឞិប្យន្តេ។</para>
  <para style="p">
    <verse number="20" style="v"/>អតឯវ យូយំ ផលេន តាន៑ បរិចេឞ្យថ។</para>
  <para style="p">
    <verse number="21" style="v"/>យេ ជនា មាំ ប្រភុំ វទន្តិ, តេ សវ៌្វេ ស្វគ៌រាជ្យំ ប្រវេក្ឞ្យន្តិ តន្ន, កិន្តុ យោ មានវោ មម ស្វគ៌ស្ថស្យ បិតុរិឞ្ដំ កម៌្ម ករោតិ ស ឯវ ប្រវេក្ឞ្យតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>តទ៑ ទិនេ ពហវោ មាំ វទិឞ្យន្តិ, ហេ ប្រភោ ហេ ប្រភោ, តវ នាម្នា កិមស្មាមិ រ្ភវិឞ្យទ្វាក្យំ ន វ្យាហ្ឫតំ? តវ នាម្នា ភូតាះ កិំ ន ត្យាជិតាះ? តវ នាម្នា កិំ នានាទ្ភុតានិ កម៌្មាណិ ន ក្ឫតានិ?</para>
  <para style="p">
    <verse number="23" style="v"/>តទាហំ វទិឞ្យាមិ, ហេ កុកម៌្មការិណោ យុឞ្មាន៑ អហំ ន វេទ្មិ, យូយំ មត្សមីបាទ៑ ទូរីភវត។</para>
  <para style="p">
    <verse number="24" style="v"/>យះ កឝ្ចិត៑ មមៃតាះ កថាះ ឝ្រុត្វា បាលយតិ, ស បាឞាណោបរិ គ្ឫហនិម៌្មាត្រា ជ្ញានិនា សហ មយោបមីយតេ។</para>
  <para style="p">
    <verse number="25" style="v"/>យតោ វ្ឫឞ្ដៅ សត្យាម៑ អាប្លាវ អាគតេ វាយៅ វាតេ ច តេឞុ តទ្គេហំ លគ្នេឞុ បាឞាណោបរិ តស្យ ភិត្តេស្តន្ន បតតិl</para>
  <para style="p">
    <verse number="26" style="v"/>កិន្តុ យះ កឝ្ចិត៑ មមៃតាះ កថាះ ឝ្រុត្វា ន បាលយតិ ស សៃកតេ គេហនិម៌្មាត្រា ៜជ្ញានិនា ឧបមីយតេ។</para>
  <para style="p">
    <verse number="27" style="v"/>យតោ ជលវ្ឫឞ្ដៅ សត្យាម៑ អាប្លាវ អាគតេ បវនេ វាតេ ច តៃ រ្គ្ឫហេ សមាឃាតេ តត៑ បតតិ តត្បតនំ មហទ៑ ភវតិ។</para>
  <para style="p">
    <verse number="28" style="v"/>យីឝុនៃតេឞុ វាក្យេឞុ សមាបិតេឞុ មានវាស្តទីយោបទេឝម៑ អាឝ្ចយ៌្យំ មេនិរេ។</para>
  <para style="p">
    <verse number="29" style="v"/>យស្មាត៑ ស ឧបាធ្យាយា ឥវ តាន៑ នោបទិទេឝ កិន្តុ សមត៌្ហបុរុឞឥវ សមុបទិទេឝ។</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យទា ស បវ៌្វតាទ៑ អវារោហត៑ តទា ពហវោ មានវាស្តត្បឝ្ចាទ៑ វវ្រជុះ។</para>
  <para style="p">
    <verse number="2" style="v"/>ឯកះ កុឞ្ឋវាន៑ អាគត្យ តំ ប្រណម្យ ពភាឞេ, ហេ ប្រភោ, យទិ ភវាន៑ សំមន្យតេ, តហ៌ិ មាំ និរាមយំ កត៌្តុំ ឝក្នោតិ។</para>
  <para style="p">
    <verse number="3" style="v"/>តតោ យីឝុះ ករំ ប្រសាយ៌្យ តស្យាង្គំ ស្ប្ឫឝន៑ វ្យាជហារ, សម្មន្យេៜហំ ត្វំ និរាមយោ ភវ; តេន ស តត្ក្ឞណាត៑ កុឞ្ឋេនាមោចិ។</para>
  <para style="p">
    <verse number="4" style="v"/>តតោ យីឝុស្តំ ជគាទ, អវធេហិ កថាមេតាំ កឝ្ចិទបិ មា ព្រូហិ, កិន្តុ យាជកស្យ សន្និធិំ គត្វា ស្វាត្មានំ ទឝ៌យ មនុជេភ្យោ និជនិរាមយត្វំ ប្រមាណយិតុំ មូសានិរូបិតំ ទ្រវ្យម៑ ឧត្ស្ឫជ ច។</para>
  <para style="p">
    <verse number="5" style="v"/>តទនន្តរំ យីឝុនា កផន៌ាហូម្នាមនិ នគរេ ប្រវិឞ្ដេ កឝ្ចិត៑ ឝតសេនាបតិស្តត្សមីបម៑ អាគត្យ វិនីយ ពភាឞេ,</para>
  <para style="p">
    <verse number="6" style="v"/>ហេ ប្រភោ, មទីយ ឯកោ ទាសះ បក្ឞាឃាតវ្យាធិនា ភ្ឫឝំ វ្យថិតះ, សតុ ឝយនីយ អាស្តេ។</para>
  <para style="p">
    <verse number="7" style="v"/>តទានីំ យីឝុស្តស្មៃ កថិតវាន៑, អហំ គត្វា តំ និរាមយំ ករិឞ្យាមិ។</para>
  <para style="p">
    <verse number="8" style="v"/>តតះ ស ឝតសេនាបតិះ ប្រត្យវទត៑, ហេ ប្រភោ, ភវាន៑ យត៑ មម គេហមធ្យំ យាតិ តទ្យោគ្យភាជនំ នាហមស្មិ; វាង្មាត្រម៑ អាទិឝតុ, តេនៃវ មម ទាសោ និរាមយោ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="9" style="v"/>យតោ មយិ បរនិធ្នេៜបិ មម និទេឝវឝ្យាះ កតិ កតិ សេនាះ សន្តិ, តត ឯកស្មិន៑ យាហីត្យុក្តេ ស យាតិ, តទន្យស្មិន៑ ឯហីត្យុក្តេ ស អាយាតិ, តថា មម និជទាសេ កម៌្មៃតត៑ កុវ៌្វិត្យុក្តេ ស តត៑ ករោតិ។</para>
  <para style="p">
    <verse number="10" style="v"/>តទានីំ យីឝុស្តស្យៃតត៑ វចោ និឝម្យ វិស្មយាបន្នោៜភូត៑; និជបឝ្ចាទ្គាមិនោ មានវាន៑ អវោច្ច, យុឞ្មាន៑ តថ្យំ វច្មិ, ឥស្រាយេលីយលោកានាំ មធ្យេៜបិ នៃតាទ្ឫឝោ វិឝ្វាសោ មយា ប្រាប្តះ។</para>
  <para style="p">
    <verse number="11" style="v"/>អន្យច្ចាហំ យុឞ្មាន៑ វទាមិ, ពហវះ បូវ៌្វស្យាះ បឝ្ចិមាយាឝ្ច ទិឝ អាគត្យ ឥព្រាហីមា ឥស្ហាកា យាកូពា ច សាកម៑ មិលិត្វា សមុបវេក្ឞ្យន្តិ;</para>
  <para style="p">
    <verse number="12" style="v"/>កិន្តុ យត្រ ស្ថានេ រោទនទន្តឃឞ៌ណេ ភវតស្តស្មិន៑ ពហិព៌្ហូតតមិស្រេ រាជ្យស្យ សន្តានា និក្ឞេស្យន្តេ។</para>
  <para style="p">
    <verse number="13" style="v"/>តតះ បរំ យីឝុស្តំ ឝតសេនាបតិំ ជគាទ, យាហិ, តវ ប្រតីត្យនុសារតោ មង្គលំ ភូយាត៑; តទា តស្មិន្នេវ ទណ្ឌេ តទីយទាសោ និរាមយោ ពភូវ។</para>
  <para style="p">
    <verse number="14" style="v"/>អនន្តរំ យីឝុះ បិតរស្យ គេហមុបស្ថាយ ជ្វរេណ បីឌិតាំ ឝយនីយស្ថិតាំ តស្យ ឝ្វឝ្រូំ វីក្ឞាញ្ចក្រេ។</para>
  <para style="p">
    <verse number="15" style="v"/>តតស្តេន តស្យាះ ករស្យ ស្ប្ឫឞ្ដតវាត៑ ជ្វរស្តាំ តត្យាជ, តទា សា សមុត្ថាយ តាន៑ សិឞេវេ។</para>
  <para style="p">
    <verse number="16" style="v"/>អនន្តរំ សន្ធ្យាយាំ សត្យាំ ពហុឝោ ភូតគ្រស្តមនុជាន៑ តស្យ សមីបម៑ អានិន្យុះ ស ច វាក្យេន ភូតាន៑ ត្យាជយាមាស, សវ៌្វប្រការបីឌិតជនាំឝ្ច និរាមយាន៑ ចការ;</para>
  <para style="p">
    <verse number="17" style="v"/>តស្មាត៑, សវ៌្វា ទុព៌្ពលតាស្មាកំ តេនៃវ បរិធារិតា។ អស្មាកំ សកលំ វ្យាធិំ សឯវ សំគ្ឫហីតវាន៑។ យទេតទ្វចនំ យិឝយិយភវិឞ្យទ្វាទិនោក្តមាសីត៑, តត្តទា សផលមភវត៑។</para>
  <para style="p">
    <verse number="18" style="v"/>អនន្តរំ យីឝុឝ្ចតុទ៌ិក្ឞុ ជននិវហំ វិលោក្យ តដិន្យាះ បារំ យាតុំ ឝិឞ្យាន៑ អាទិទេឝ។</para>
  <para style="p">
    <verse number="19" style="v"/>តទានីម៑ ឯក ឧបាធ្យាយ អាគត្យ កថិតវាន៑, ហេ គុរោ, ភវាន៑ យត្រ យាស្យតិ តត្រាហមបិ ភវតះ បឝ្ចាទ៑ យាស្យាមិ។</para>
  <para style="p">
    <verse number="20" style="v"/>តតោ យីឝុ រ្ជគាទ, ក្រោឞ្ដុះ ស្ថាតុំ ស្ថានំ វិទ្យតេ, វិហាយសោ វិហង្គមានាំ នីឌានិ ច សន្តិ; កិន្តុ មនុឞ្យបុត្រស្យ ឝិរះ ស្ថាបយិតុំ ស្ថានំ ន វិទ្យតេ។</para>
  <para style="p">
    <verse number="21" style="v"/>អនន្តរម៑ អបរ ឯកះ ឝិឞ្យស្តំ ពភាឞេ, ហេ ប្រភោ, ប្រថមតោ មម បិតរំ ឝ្មឝានេ និធាតុំ គមនាត៌្ហំ មាម៑ អនុមន្យស្វ។</para>
  <para style="p">
    <verse number="22" style="v"/>តតោ យីឝុរុក្តវាន៑ ម្ឫតា ម្ឫតាន៑ ឝ្មឝានេ និទធតុ, ត្វំ មម បឝ្ចាទ៑ អាគច្ឆ។</para>
  <para style="p">
    <verse number="23" style="v"/>អនន្តរំ តស្មិន៑ នាវមារូឍេ តស្យ ឝិឞ្យាស្តត្បឝ្ចាត៑ ជគ្មុះ។</para>
  <para style="p">
    <verse number="24" style="v"/>បឝ្ចាត៑ សាគរស្យ មធ្យំ តេឞុ គតេឞុ តាទ្ឫឝះ ប្រពលោ ឈញ្ភ្ឝនិល ឧទតិឞ្ឋត៑, យេន មហាតរង្គ ឧត្ថាយ តរណិំ ឆាទិតវាន៑, កិន្តុ ស និទ្រិត អាសីត៑។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា ឝិឞ្យា អាគត្យ តស្យ និទ្រាភង្គំ ក្ឫត្វា កថយាមាសុះ, ហេ ប្រភោ, វយំ ម្រិយាមហេ, ភវាន៑ អស្មាកំ ប្រាណាន៑ រក្ឞតុ។</para>
  <para style="p">
    <verse number="26" style="v"/>តទា ស តាន៑ ឧក្តវាន៑, ហេ អល្បវិឝ្វាសិនោ យូយំ កុតោ វិភីថ? តតះ ស ឧត្ថាយ វាតំ សាគរញ្ច តជ៌យាមាស, តតោ និវ៌្វាតមភវត៑។</para>
  <para style="p">
    <verse number="27" style="v"/>អបរំ មនុជា វិស្មយំ វិលោក្យ កថយាមាសុះ, អហោ វាតសរិត្បតី អស្យ កិមាជ្ញាគ្រាហិណៅ? កីទ្ឫឝោៜយំ មានវះ។</para>
  <para style="p">
    <verse number="28" style="v"/>អនន្តរំ ស បារំ គត្វា គិទេរីយទេឝម៑ ឧបស្ថិតវាន៑; តទា ទ្វៅ ភូតគ្រស្តមនុជៅ ឝ្មឝានស្ថានាទ៑ ពហិ រ្ភូត្វា តំ សាក្ឞាត៑ ក្ឫតវន្តៅ, តាវេតាទ្ឫឝៅ ប្រចណ្ឌាវាស្តាំ យត៑ តេន ស្ថានេន កោបិ យាតុំ នាឝក្នោត៑។</para>
  <para style="p">
    <verse number="29" style="v"/>តាវុចៃះ កថយាមាសតុះ, ហេ ឦឝ្វរស្យ សូនោ យីឝោ, ត្វយា សាកម៑ អាវយោះ កះ សម្ពន្ធះ? និរូបិតកាលាត៑ ប្រាគេវ កិមាវាភ្យាំ យាតនាំ ទាតុម៑ អត្រាគតោសិ?</para>
  <para style="p">
    <verse number="30" style="v"/>តទានីំ តាភ្យាំ កិញ្ចិទ៑ ទូរេ វរាហាណាម៑ ឯកោ មហាវ្រជោៜចរត៑។</para>
  <para style="p">
    <verse number="31" style="v"/>តតោ ភូតៅ តៅ តស្យាន្តិកេ វិនីយ កថយាមាសតុះ, យទ្យាវាំ ត្យាជយសិ, តហ៌ិ វរាហាណាំ មធ្យេវ្រជម៑ អាវាំ ប្រេរយ។</para>
  <para style="p">
    <verse number="32" style="v"/>តទា យីឝុរវទត៑ យាតំ, អនន្តរំ តៅ យទា មនុជៅ វិហាយ វរាហាន៑ អាឝ្រិតវន្តៅ, តទា តេ សវ៌្វេ វរាហា ឧច្ចស្ថានាត៑ មហាជវេន ធាវន្តះ សាគរីយតោយេ មជ្ជន្តោ មម្រុះ។</para>
  <para style="p">
    <verse number="33" style="v"/>តតោ វរាហរក្ឞកាះ បលាយមានា មធ្យេនគរំ តៅ ភូតគ្រស្តៅ ប្រតិ យទ្យទ៑ អឃដត, តាះ សវ៌្វវាត៌្តា អវទន៑។</para>
  <para style="p">
    <verse number="34" style="v"/>តតោ នាគរិកាះ សវ៌្វេ មនុជា យីឝុំ សាក្ឞាត៑ កត៌្តុំ ពហិរាយាតាះ តញ្ច វិលោក្យ ប្រាត៌្ហយាញ្ចក្រិរេ ភវាន៑ អស្មាកំ សីមាតោ យាតុ។</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ យីឝុ រ្នៅកាមារុហ្យ បុនះ បារមាគត្យ និជគ្រាមម៑ អាយយៅ។</para>
  <para style="p">
    <verse number="2" style="v"/>តតះ កតិបយា ជនា ឯកំ បក្ឞាឃាតិនំ ស្វដ្ដោបរិ ឝាយយិត្វា តត្សមីបម៑ អានយន៑; តតោ យីឝុស្តេឞាំ ប្រតីតិំ វិជ្ញាយ តំ បក្ឞាឃាតិនំ ជគាទ, ហេ បុត្រ, សុស្ថិរោ ភវ, តវ កលុឞស្យ មឞ៌ណំ ជាតម៑។</para>
  <para style="p">
    <verse number="3" style="v"/>តាំ កថាំ និឝម្យ កិយន្ត ឧបាធ្យាយា មនះសុ ចិន្តិតវន្ត ឯឞ មនុជ ឦឝ្វរំ និន្ទតិ។</para>
  <para style="p">
    <verse number="4" style="v"/>តតះ ស តេឞាម៑ ឯតាទ្ឫឝីំ ចិន្តាំ វិជ្ញាយ កថិតវាន៑, យូយំ មនះសុ ក្ឫត ឯតាទ្ឫឝីំ កុចិន្តាំ កុរុថ?</para>
  <para style="p">
    <verse number="5" style="v"/>តវ បាបមឞ៌ណំ ជាតំ, យទ្វា ត្វមុត្ថាយ គច្ឆ, ទ្វយោរនយោ រ្វាក្យយោះ កិំ វាក្យំ វក្តុំ សុគមំ?</para>
  <para style="p">
    <verse number="6" style="v"/>កិន្តុ មេទិន្យាំ កលុឞំ ក្ឞមិតុំ មនុជសុតស្យ សាមត៌្ហ្យមស្តីតិ យូយំ យថា ជានីថ, តទត៌្ហំ ស តំ បក្ឞាឃាតិនំ គទិតវាន៑, ឧត្តិឞ្ឋ, និជឝយនីយំ អាទាយ គេហំ គច្ឆ។</para>
  <para style="p">
    <verse number="7" style="v"/>តតះ ស តត្ក្ឞណាទ៑ ឧត្ថាយ និជគេហំ ប្រស្ថិតវាន៑។</para>
  <para style="p">
    <verse number="8" style="v"/>មានវា ឥត្ថំ វិលោក្យ វិស្មយំ មេនិរេ, ឦឝ្វរេណ មានវាយ សាមត៌្ហ្យម៑ ឦទ្ឫឝំ ទត្តំ ឥតិ ការណាត៑ តំ ធន្យំ ពភាឞិរេ ច។</para>
  <para style="p">
    <verse number="9" style="v"/>អនន្តរំ យីឝុស្តត្ស្ថានាទ៑ គច្ឆន៑ គច្ឆន៑ ករសំគ្រហស្ថានេ សមុបវិឞ្ដំ មថិនាមានម៑ ឯកំ មនុជំ វិលោក្យ តំ ពភាឞេ, មម បឝ្ចាទ៑ អាគច្ឆ, តតះ ស ឧត្ថាយ តស្យ បឝ្ចាទ៑ វវ្រាជ។</para>
  <para style="p">
    <verse number="10" style="v"/>តតះ បរំ យីឝៅ គ្ឫហេ ភោក្តុម៑ ឧបវិឞ្ដេ ពហវះ ករសំគ្រាហិណះ កលុឞិណឝ្ច មានវា អាគត្យ តេន សាកំ តស្យ ឝិឞ្យៃឝ្ច សាកម៑ ឧបវិវិឝុះ។</para>
  <para style="p">
    <verse number="11" style="v"/>ផិរូឝិនស្តទ៑ ទ្ឫឞ្ដ្វា តស្យ ឝិឞ្យាន៑ ពភាឞិរេ, យុឞ្មាកំ គុរុះ កិំ និមិត្តំ ករសំគ្រាហិភិះ កលុឞិភិឝ្ច សាកំ ភុំក្តេ?</para>
  <para style="p">
    <verse number="12" style="v"/>យីឝុស្តត៑ ឝ្រុត្វា តាន៑ ប្រត្យវទត៑, និរាមយលោកានាំ ចិកិត្សកេន ប្រយោជនំ នាស្តិ, កិន្តុ សាមយលោកានាំ ប្រយោជនមាស្តេ។</para>
  <para style="p">
    <verse number="13" style="v"/>អតោ យូយំ យាត្វា វចនស្យាស្យាត៌្ហំ ឝិក្ឞធ្វម៑, ទយាយាំ មេ យថា ប្រីតិ រ្ន តថា យជ្ញកម៌្មណិ។ យតោៜហំ ធាម៌្មិកាន៑ អាហ្វាតុំ នាគតោៜស្មិ កិន្តុ មនះ បរិវត៌្តយិតុំ បាបិន អាហ្វាតុម៑ អាគតោៜស្មិ។</para>
  <para style="p">
    <verse number="14" style="v"/>អនន្តរំ យោហនះ ឝិឞ្យាស្តស្យ សមីបម៑ អាគត្យ កថយាមាសុះ, ផិរូឝិនោ វយញ្ច បុនះ បុនរុបវសាមះ, កិន្តុ តវ ឝិឞ្យា នោបវសន្តិ, កុតះ?</para>
  <para style="p">
    <verse number="15" style="v"/>តទា យីឝុស្តាន៑ អវោចត៑ យាវត៑ សខីនាំ សំង្គេ កន្យាយា វរស្តិឞ្ឋតិ, តាវត៑ កិំ តេ វិលាបំ កត៌្តុំ ឝក្លុវន្តិ? កិន្តុ យទា តេឞាំ សំង្គាទ៑ វរំ នយន្តិ, តាទ្ឫឝះ សមយ អាគមិឞ្យតិ, តទា តេ ឧបវត្ស្យន្តិ។</para>
  <para style="p">
    <verse number="16" style="v"/>បុរាតនវសនេ កោបិ នវីនវស្ត្រំ ន យោជយតិ, យស្មាត៑ តេន យោជិតេន បុរាតនវសនំ ឆិនត្តិ តច្ឆិទ្រញ្ច ពហុកុត្សិតំ ទ្ឫឝ្យតេ។</para>
  <para style="p">
    <verse number="17" style="v"/>អន្យញ្ច បុរាតនកុត្វាំ កោបិ នវានគោស្តនីរសំ ន និទធាតិ, យស្មាត៑ តថា ក្ឫតេ កុតូ រ្វិទីយ៌្យតេ តេន គោស្តនីរសះ បតតិ កុតូឝ្ច នឝ្យតិ; តស្មាត៑ នវីនាយាំ កុត្វាំ នវីនោ គោស្តនីរសះ ស្ថាប្យតេ, តេន ទ្វយោរវនំ ភវតិ។</para>
  <para style="p">
    <verse number="18" style="v"/>អបរំ តេនៃតត្កថាកថនកាលេ ឯកោៜធិបតិស្តំ ប្រណម្យ ពភាឞេ, មម ទុហិតា ប្រាយេណៃតាវត្កាលេ ម្ឫតា, តស្មាទ៑ ភវានាគត្យ តស្យា គាត្រេ ហស្តមប៌យតុ, តេន សា ជីវិឞ្យតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>តទានីំ យីឝុះ ឝិឞ្យៃះ សាកម៑ ឧត្ថាយ តស្យ បឝ្ចាទ៑ វវ្រាជ។</para>
  <para style="p">
    <verse number="20" style="v"/>ឥត្យនន្តរេ ទ្វាទឝវត្សរាន៑ យាវត៑ ប្រទរាមយេន ឝីណ៌ៃកា នារី តស្យ បឝ្ចាទ៑ អាគត្យ តស្យ វសនស្យ គ្រន្ថិំ បស្បឝ៌;</para>
  <para style="p">
    <verse number="21" style="v"/>យស្មាត៑ មយា កេវលំ តស្យ វសនំ ស្ប្ឫឞ្ដ្វា ស្វាស្ថ្យំ ប្រាប្ស្យតេ, សា នារីតិ មនសិ និឝ្ចិតវតី។</para>
  <para style="p">
    <verse number="22" style="v"/>តតោ យីឝុវ៌ទនំ បរាវត៌្ត្យ តាំ ជគាទ, ហេ កន្យេ, ត្វំ សុស្ថិរា ភវ, តវ វិឝ្វាសស្ត្វាំ ស្វស្ថាមកាឞ៌ីត៑។ ឯតទ្វាក្យេ គទិតឯវ សា យោឞិត៑ ស្វស្ថាភូត៑។</para>
  <para style="p">
    <verse number="23" style="v"/>អបរំ យីឝុស្តស្យាធ្យក្ឞស្យ គេហំ គត្វា វាទកប្រភ្ឫតីន៑ ពហូន៑ លោកាន៑ ឝព្ទាយមានាន៑ វិលោក្យ តាន៑ អវទត៑,</para>
  <para style="p">
    <verse number="24" style="v"/>បន្ថានំ ត្យជ, កន្យេយំ នាម្រិយត និទ្រិតាស្តេ; កថាមេតាំ ឝ្រុត្វា តេ តមុបជហសុះ។</para>
  <para style="p">
    <verse number="25" style="v"/>កិន្តុ សវ៌្វេឞុ ពហិឞ្ក្ឫតេឞុ សោៜភ្យន្តរំ គត្វា កន្យាយាះ ករំ ធ្ឫតវាន៑, តេន សោទតិឞ្ឋត៑;</para>
  <para style="p">
    <verse number="26" style="v"/>តតស្តត្កម៌្មណោ យឝះ ក្ឫត្ស្នំ តំ ទេឝំ វ្យាប្តវត៑។</para>
  <para style="p">
    <verse number="27" style="v"/>តតះ បរំ យីឝុស្តស្មាត៑ ស្ថានាទ៑ យាត្រាំ ចការ; តទា ហេ ទាយូទះ សន្តាន, អស្មាន៑ ទយស្វ, ឥតិ វទន្តៅ ទ្វៅ ជនាវន្ធៅ ប្រោចៃរាហូយន្តៅ តត្បឝ្ចាទ៑ វវ្រជតុះ។</para>
  <para style="p">
    <verse number="28" style="v"/>តតោ យីឝៅ គេហមធ្យំ ប្រវិឞ្ដំ តាវបិ តស្យ សមីបម៑ ឧបស្ថិតវន្តៅ, តទានីំ ស តៅ ប្ឫឞ្ដវាន៑ កម៌្មៃតត៑ កត៌្តុំ មម សាមត៌្ហ្យម៑ អាស្តេ, យុវាំ កិមិតិ ប្រតីថះ? តទា តៅ ប្រត្យូចតុះ, សត្យំ ប្រភោ។</para>
  <para style="p">
    <verse number="29" style="v"/>តទានីំ ស តយោ រ្លោចនានិ ស្ប្ឫឝន៑ ពភាឞេ, យុវយោះ ប្រតីត្យនុសារាទ៑ យុវយោ រ្មង្គលំ ភូយាត៑។ តេន តត្ក្ឞណាត៑ តយោ រ្នេត្រាណិ ប្រសន្នាន្យភវន៑,</para>
  <para style="p">
    <verse number="30" style="v"/>បឝ្ចាទ៑ យីឝុស្តៅ ទ្ឫឍមាជ្ញាប្យ ជគាទ, អវធត្តម៑ ឯតាំ កថាំ កោបិ មនុជោ ម ជានីយាត៑។</para>
  <para style="p">
    <verse number="31" style="v"/>កិន្តុ តៅ ប្រស្ថាយ តស្មិន៑ ក្ឫត្ស្នេ ទេឝេ តស្យ កីត៌្តិំ ប្រកាឝយាមាសតុះ។</para>
  <para style="p">
    <verse number="32" style="v"/>អបរំ តៅ ពហិយ៌ាត ឯតស្មិន្នន្តរេ មនុជា ឯកំ ភូតគ្រស្តមូកំ តស្យ សមីបម៑ អានីតវន្តះ។</para>
  <para style="p">
    <verse number="33" style="v"/>តេន ភូតេ ត្យាជិតេ ស មូកះ កថាំ កថយិតុំ ប្រារភត, តេន ជនា វិស្មយំ វិជ្ញាយ កថយាមាសុះ, ឥស្រាយេលោ វំឝេ កទាបិ នេទ្ឫគទ្ឫឝ្យត;</para>
  <para style="p">
    <verse number="34" style="v"/>កិន្តុ ផិរូឝិនះ កថយាញ្ចក្រុះ ភូតាធិបតិនា ស ភូតាន៑ ត្យាជយតិ។</para>
  <para style="p">
    <verse number="35" style="v"/>តតះ បរំ យីឝុស្តេឞាំ ភជនភវន ឧបទិឝន៑ រាជ្យស្យ សុសំវាទំ ប្រចារយន៑ លោកានាំ យស្យ យ អាមយោ យា ច បីឌាសីត៑, តាន៑ ឝមយន៑ ឝមយំឝ្ច សវ៌្វាណិ នគរាណិ គ្រាមាំឝ្ច ពភ្រាម។</para>
  <para style="p">
    <verse number="36" style="v"/>អន្យញ្ច មនុជាន៑ វ្យាកុលាន៑ អរក្ឞកមេឞានិវ ច ត្យក្តាន៑ និរីក្ឞ្យ តេឞុ ការុណិកះ សន៑ ឝិឞ្យាន៑ អវទត៑,</para>
  <para style="p">
    <verse number="37" style="v"/>ឝស្យានិ ប្រចុរាណិ សន្តិ, កិន្តុ ឆេត្តារះ ស្តោកាះ។</para>
  <para style="p">
    <verse number="38" style="v"/>ក្ឞេត្រំ ប្រត្យបរាន៑ ឆេទកាន៑ ប្រហេតុំ ឝស្យស្វាមិនំ ប្រាត៌្ហយធ្វម៑។</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ យីឝុ រ្ទ្វាទឝឝិឞ្យាន៑ អាហូយាមេធ្យភូតាន៑ ត្យាជយិតុំ សវ៌្វប្រការរោគាន៑ បីឌាឝ្ច ឝមយិតុំ តេភ្យះ សាមត៌្ហ្យមទាត៑។</para>
  <para style="p">
    <verse number="2" style="v"/>តេឞាំ ទ្វាទឝប្រេឞ្យាណាំ នាមាន្យេតានិ។ ប្រថមំ ឝិមោន៑ យំ បិតរំ វទន្តិ, តតះ បរំ តស្យ សហជ អាន្ទ្រិយះ, សិវទិយស្យ បុត្រោ យាកូព្</para>
  <para style="p">
    <verse number="3" style="v"/>តស្យ សហជោ យោហន៑; ផិលិប៑ ពត៌្ហលមយ៑ ថោមាះ ករសំគ្រាហី មថិះ, អាល្ផេយបុត្រោ យាកូព៑,</para>
  <para style="p">
    <verse number="4" style="v"/>កិនានីយះ ឝិមោន៑, យ ឦឞ្ករិយោតីយយិហូទាះ ខ្រីឞ្ដំ បរករេៜរ្បយត៑។</para>
  <para style="p">
    <verse number="5" style="v"/>ឯតាន៑ ទ្វាទឝឝិឞ្យាន៑ យីឝុះ ប្រេឞយន៑ ឥត្យាជ្ញាបយត៑, យូយម៑ អន្យទេឝីយានាំ បទវីំ ឝេមិរោណីយានាំ កិមបិ នគរញ្ច ន ប្រវិឝ្យេ</para>
  <para style="p">
    <verse number="6" style="v"/>ឥស្រាយេល្គោត្រស្យ ហារិតា យេ យេ មេឞាស្តេឞាមេវ សមីបំ យាត។</para>
  <para style="p">
    <verse number="7" style="v"/>គត្វា គត្វា ស្វគ៌ស្យ រាជត្វំ សវិធមភវត៑, ឯតាំ កថាំ ប្រចារយត។</para>
  <para style="p">
    <verse number="8" style="v"/>អាមយគ្រស្តាន៑ ស្វស្ថាន៑ កុរុត, កុឞ្ឋិនះ បរិឞ្កុរុត, ម្ឫតលោកាន៑ ជីវយត, ភូតាន៑ ត្យាជយត, វិនា មូល្យំ យូយម៑ អលភធ្វំ វិនៃវ មូល្យំ វិឝ្រាណយត។</para>
  <para style="p">
    <verse number="9" style="v"/>កិន្តុ ស្វេឞាំ កដិពន្ធេឞុ ស្វណ៌រូប្យតាម្រាណាំ កិមបិ ន គ្ឫហ្លីត។</para>
  <para style="p">
    <verse number="10" style="v"/>អន្យច្ច យាត្រាយៃ ចេលសម្បុដំ វា ទ្វិតីយវសនំ វា បាទុកេ វា យឞ្ដិះ, ឯតាន៑ មា គ្ឫហ្លីត, យតះ កាយ៌្យក្ឫត៑ ភត៌្តុំ យោគ្យោ ភវតិ។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរំ យូយំ យត៑ បុរំ យញ្ច គ្រាមំ ប្រវិឝថ, តត្រ យោ ជនោ យោគ្យបាត្រំ តមវគត្យ យានកាលំ យាវត៑ តត្រ តិឞ្ឋត។</para>
  <para style="p">
    <verse number="12" style="v"/>យទា យូយំ តទ្គេហំ ប្រវិឝថ, តទា តមាឝិឞំ វទត។</para>
  <para style="p">
    <verse number="13" style="v"/>យទិ ស យោគ្យបាត្រំ ភវតិ, តហ៌ិ តត្កល្យាណំ តស្មៃ ភវិឞ្យតិ, នោចេត៑ សាឝីយ៌ុឞ្មភ្យមេវ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="14" style="v"/>កិន្តុ យេ ជនា យុឞ្មាកមាតិថ្យំ ន វិទធតិ យុឞ្មាកំ កថាញ្ច ន ឝ្ឫណ្វន្តិ តេឞាំ គេហាត៑ បុរាទ្វា ប្រស្ថានកាលេ ស្វបទូលីះ បាតយត។</para>
  <para style="p">
    <verse number="15" style="v"/>យុឞ្មានហំ តថ្យំ វច្មិ វិចារទិនេ តត្បុរស្យ ទឝាតះ សិទោមមោរាបុរយោទ៌ឝា សហ្យតរា ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="16" style="v"/>បឝ្យត, វ្ឫកយូថមធ្យេ មេឞះ យថាវិស្តថា យុឞ្មាន ប្រហិណោមិ, តស្មាទ៑ យូយម៑ អហិរិវ សតក៌ាះ កបោតាឥវាហិំសកា ភវត។</para>
  <para style="p">
    <verse number="17" style="v"/>ន្ឫភ្យះ សាវធានា ភវត; យតស្តៃ រ្យូយំ រាជសំសទិ សមប៌ិឞ្យធ្វេ តេឞាំ ភជនគេហេ ប្រហារិឞ្យធ្វេ។</para>
  <para style="p">
    <verse number="18" style="v"/>យូយំ មន្នាមហេតោះ ឝាស្ត្ឫណាំ រាជ្ញាញ្ច សមក្ឞំ តានន្យទេឝិនឝ្ចាធិ សាក្ឞិត្វាត៌្ហមានេឞ្យធ្វេ។</para>
  <para style="p">
    <verse number="19" style="v"/>កិន្ត្វិត្ថំ សមប៌ិតា យូយំ កថំ កិមុត្តរំ វក្ឞ្យថ តត្រ មា ចិន្តយត, យតស្តទា យុឞ្មាភិ រ្យទ៑ វក្តវ្យំ តត៑ តទ្ទណ្ឌេ យុឞ្មន្មនះ សុ សមុបស្ថាស្យតិ។</para>
  <para style="p">
    <verse number="20" style="v"/>យស្មាត៑ តទា យោ វក្ឞ្យតិ ស ន យូយំ កិន្តុ យុឞ្មាកមន្តរស្ថះ បិត្រាត្មា។</para>
  <para style="p">
    <verse number="21" style="v"/>សហជះ សហជំ តាតះ សុតញ្ច ម្ឫតៅ សមប៌យិឞ្យតិ, អបត្យាគិ ស្វស្វបិត្រោे រ្វិបក្ឞីភូយ តៅ ឃាតយិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="22" style="v"/>មន្នមហេតោះ សវ៌្វេ ជនា យុឞ្មាន៑ ឫृតីយិឞ្យន្តេ, កិន្តុ យះ ឝេឞំ យាវទ៑ ធៃយ៌្យំ ឃ្ឫត្វា ស្ថាស្យតិ, ស ត្រាយិឞ្យតេ។</para>
  <para style="p">
    <verse number="23" style="v"/>តៃ រ្យទា យូយមេកបុរេ តាឌិឞ្យធ្វេ, តទា យូយមន្យបុរំ បលាយធ្វំ យុឞ្មានហំ តថ្យំ វច្មិ យាវន្មនុជសុតោ នៃតិ តាវទ៑ ឥស្រាយេល្ទេឝីយសវ៌្វនគរភ្រមណំ សមាបយិតុំ ន ឝក្ឞ្យថ។</para>
  <para style="p">
    <verse number="24" style="v"/>គុរោះ ឝិឞ្យោ ន មហាន៑, ប្រភោទ៌ាសោ ន មហាន៑។</para>
  <para style="p">
    <verse number="25" style="v"/>យទិ ឝិឞ្យោ និជគុរោ រ្ទាសឝ្ច ស្វប្រភោះ សមានោ ភវតិ តហ៌ិ តទ៑ យថេឞ្ដំ។ ចេត្តៃគ៌្ឫហបតិព៌្ហូតរាជ ឧច្យតេ, តហ៌ិ បរិវារាះ កិំ តថា ន វក្ឞ្យន្តេ?</para>
  <para style="p">
    <verse number="26" style="v"/>កិន្តុ តេភ្យោ យូយំ មា ពិភីត, យតោ យន្ន ប្រកាឝិឞ្យតេ, តាទ្ឫក៑ ឆាទិតំ កិមបិ នាស្តិ, យច្ច ន វ្យញ្ចិឞ្យតេ, តាទ្ឫគ៑ គុប្តំ កិមបិ នាស្តិ។</para>
  <para style="p">
    <verse number="27" style="v"/>យទហំ យុឞ្មាន៑ តមសិ វច្មិ តទ៑ យុឞ្មាភិទ៌ីប្តៅ កថ្យតាំ; កណ៌ាភ្យាំ យត៑ ឝ្រូយតេ តទ៑ គេហោបរិ ប្រចាយ៌្យតាំ។</para>
  <para style="p">
    <verse number="28" style="v"/>យេ កាយំ ហន្តុំ ឝក្នុវន្តិ នាត្មានំ, តេភ្យោ មា ភៃឞ្ដ; យះ កាយាត្មានៅ និរយេ នាឝយិតុំ, ឝក្នោតិ, តតោ ពិភីត។</para>
  <para style="p">
    <verse number="29" style="v"/>ទ្វៅ ចដកៅ កិមេកតាម្រមុទ្រយា ន វិក្រីយេតេ? តថាបិ យុឞ្មត្តាតានុមតិំ វិនា តេឞាមេកោបិ ភុវិ ន បតតិ។</para>
  <para style="p">
    <verse number="30" style="v"/>យុឞ្មច្ឆិរសាំ សវ៌្វកចា គណិតាំះ សន្តិ។</para>
  <para style="p">
    <verse number="31" style="v"/>អតោ មា ពិភីត, យូយំ ពហុចដកេភ្យោ ពហុមូល្យាះ។</para>
  <para style="p">
    <verse number="32" style="v"/>យោ មនុជសាក្ឞាន្មាមង្គីកុរុតេ តមហំ ស្វគ៌ស្ថតាតសាក្ឞាទង្គីករិឞ្យេ។</para>
  <para style="p">
    <verse number="33" style="v"/>ប្ឫថ្វ្យាមហំ ឝាន្តិំ ទាតុមាគតឥតិ មានុភវត, ឝាន្តិំ ទាតុំ ន កិន្ត្វសិំ។</para>
  <para style="p">
    <verse number="34" style="v"/>បិត្ឫមាត្ឫឝ្ចឝ្រូភិះ សាកំ សុតសុតាពធូ រ្វិរោធយិតុញ្ចាគតេाស្មិ។</para>
  <para style="p">
    <verse number="35" style="v"/>តតះ ស្វស្វបរិវារឯវ ន្ឫឝត្រុ រ្ភវិតា។</para>
  <para style="p">
    <verse number="36" style="v"/>យះ បិតរិ មាតរិ វា មត្តោធិកំ ប្រីយតេ, ស ន មទហ៌ះ;</para>
  <para style="p">
    <verse number="37" style="v"/>យឝ្ច សុតេ សុតាយាំ វា មត្តោធិកំ ប្រីយតេ, សេाបិ ន មទហ៌ះ។</para>
  <para style="p">
    <verse number="38" style="v"/>យះ ស្វក្រុឝំ គ្ឫហ្លន៑ មត្បឝ្ចាន្នៃតិ, សេाបិ ន មទហ៌ះ។</para>
  <para style="p">
    <verse number="39" style="v"/>យះ ស្វប្រាណានវតិ, ស តាន៑ ហារយិឞ្យតេ, យស្តុ មត្ក្ឫតេ ស្វប្រាណាន៑ ហារយតិ, ស តានវតិ។</para>
  <para style="p">
    <verse number="40" style="v"/>យោ យុឞ្មាកមាតិថ្យំ វិទធាតិ, ស មមាតិថ្យំ វិទធាតិ, យឝ្ច មមាតិថ្យំ វិទធាតិ, ស មត្ប្រេរកស្យាតិថ្យំ វិទធាតិ។</para>
  <para style="p">
    <verse number="41" style="v"/>យោ ភវិឞ្យទ្វាទីតិ ជ្ញាត្វា តស្យាតិថ្យំ វិធត្តេ, ស ភវិឞ្យទ្វាទិនះ ផលំ លប្ស្យតេ, យឝ្ច ធាម៌្មិក ឥតិ វិទិត្វា តស្យាតិថ្យំ វិធត្តេ ស ធាម៌្មិកមានវស្យ ផលំ ប្រាប្ស្យតិ។</para>
  <para style="p">
    <verse number="42" style="v"/>យឝ្ច កឝ្ចិត៑ ឯតេឞាំ ក្ឞុទ្រនរាណាម៑ យំ កញ្ចនៃកំ ឝិឞ្យ ឥតិ វិទិត្វា កំសៃកំ ឝីតលសលិលំ តស្មៃ ទត្តេ, យុឞ្មានហំ តថ្យំ វទាមិ, ស កេនាបិ ប្រការេណ ផលេន ន វញ្ចិឞ្យតេ។</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ឥត្ថំ យីឝុះ ស្វទ្វាទឝឝិឞ្យាណាមាជ្ញាបនំ សមាប្យ បុរេ បុរ ឧបទេឞ្ដុំ សុសំវាទំ ប្រចារយិតុំ តត្ស្ថានាត៑ ប្រតស្ថេ។</para>
  <para style="p">
    <verse number="2" style="v"/>អនន្តរំ យោហន៑ ការាយាំ តិឞ្ឋន៑ ខ្រិឞ្ដស្យ កម៌្មណាំ វាត៌្តំ ប្រាប្យ យស្យាគមនវាត៌្តាសីត៑ សឯវ កិំ ត្វំ? វា វយមន្យម៑ អបេក្ឞិឞ្យាមហេ?</para>
  <para style="p">
    <verse number="3" style="v"/>ឯតត៑ ប្រឞ្ដុំ និជៅ ទ្វៅ ឝិឞ្យៅ ប្រាហិណោត៑។</para>
  <para style="p">
    <verse number="4" style="v"/>យីឝុះ ប្រត្យវោចត៑, អន្ធា នេត្រាណិ លភន្តេ, ខញ្ចា គច្ឆន្តិ, កុឞ្ឋិនះ ស្វស្ថា ភវន្តិ, ពធិរាះ ឝ្ឫណ្វន្តិ, ម្ឫតា ជីវន្ត ឧត្តិឞ្ឋន្តិ, ទរិទ្រាណាំ សមីបេ សុសំវាទះ ប្រចាយ៌្យត,</para>
  <para style="p">
    <verse number="5" style="v"/>ឯតានិ យទ្យទ៑ យុវាំ ឝ្ឫណុថះ បឝ្យថឝ្ច គត្វា តទ្វាត៌្តាំ យោហនំ គទតំ។</para>
  <para style="p">
    <verse number="6" style="v"/>យស្យាហំ ន វិឃ្នីភវាមិ, សឯវ ធន្យះ។</para>
  <para style="p">
    <verse number="7" style="v"/>អនន្តរំ តយោះ ប្រស្ថិតយោ រ្យីឝុ រ្យោហនម៑ ឧទ្ទិឝ្យ ជនាន៑ ជគាទ, យូយំ កិំ ទ្រឞ្ដុំ វហិម៌ធ្យេប្រាន្តរម៑ អគច្ឆត? កិំ វាតេន កម្បិតំ នលំ?</para>
  <para style="p">
    <verse number="8" style="v"/>វា កិំ វីក្ឞិតុំ វហិគ៌តវន្តះ? កិំ បរិហិតសូក្ឞ្មវសនំ មនុជមេកំ? បឝ្យត, យេ សូក្ឞ្មវសនានិ បរិទធតិ, តេ រាជធាន្យាំ តិឞ្ឋន្តិ។</para>
  <para style="p">
    <verse number="9" style="v"/>តហ៌ិ យូយំ កិំ ទ្រឞ្ដុំ ពហិរគមត, កិមេកំ ភវិឞ្យទ្វាទិនំ? តទេវ សត្យំ។ យុឞ្មានហំ វទាមិ, ស ភវិឞ្យទ្វាទិនោបិ មហាន៑;</para>
  <para style="p">
    <verse number="10" style="v"/>យតះ, បឝ្យ ស្វកីយទូតោយំ ត្វទគ្រេ ប្រេឞ្យតេ មយា។ ស គត្វា តវ បន្ថានំ ស្មយក៑ បរិឞ្ករិឞ្យតិ៕ ឯតទ្វចនំ យមធិ លិខិតមាស្តេ សោៜយំ យោហន៑។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរំ យុឞ្មានហំ តថ្យំ ព្រវីមិ, មជ្ជយិតុ រ្យោហនះ ឝ្រេឞ្ឋះ កោបិ នារីតោ នាជាយត; តថាបិ ស្វគ៌រាជ្យមធ្យេ សវ៌្វេភ្យោ យះ ក្ឞុទ្រះ ស យោហនះ ឝ្រេឞ្ឋះ។</para>
  <para style="p">
    <verse number="12" style="v"/>អបរញ្ច អា យោហនោៜទ្យ យាវត៑ ស្វគ៌រាជ្យំ ពលាទាក្រាន្តំ ភវតិ អាក្រមិនឝ្ច ជនា ពលេន តទធិកុវ៌្វន្តិ។</para>
  <para style="p">
    <verse number="13" style="v"/>យតោ យោហនំ យាវត៑ សវ៌្វភវិឞ្យទ្វាទិភិ រ្វ្យវស្ថយា ច ឧបទេឝះ ប្រាកាឝ្យត។</para>
  <para style="p">
    <verse number="14" style="v"/>យទិ យូយមិទំ វាក្យំ គ្រហីតុំ ឝក្នុថ, តហ៌ិ ឝ្រេយះ, យស្យាគមនស្យ វចនមាស្តេ សោៜយម៑ ឯលិយះ។</para>
  <para style="p">
    <verse number="15" style="v"/>យស្យ ឝ្រោតុំ កណ៌ៅ ស្តះ ស ឝ្ឫណោតុ។</para>
  <para style="p">
    <verse number="16" style="v"/>ឯតេ វិទ្យមានជនាះ កៃ រ្មយោបមីយន្តេ? យេ ពាលកា ហដ្ដ ឧបវិឝ្យ ស្វំ ស្វំ ពន្ធុមាហូយ វទន្តិ,</para>
  <para style="p">
    <verse number="17" style="v"/>វយំ យុឞ្មាកំ សមីបេ វំឝីរវាទយាម, កិន្តុ យូយំ នាន្ឫត្យត; យុឞ្មាកំ សមីបេ ច វយមរោទិម, កិន្តុ យូយំ ន វ្យលបត, តាទ្ឫឝៃ រ្ពាលកៃស្ត ឧបមាយិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="18" style="v"/>យតោ យោហន៑ អាគត្យ ន ភុក្តវាន៑ ន បីតវាំឝ្ច, តេន លោកា វទន្តិ, ស ភូតគ្រស្ត ឥតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>មនុជសុត អាគត្យ ភុក្តវាន៑ បីតវាំឝ្ច, តេន លោកា វទន្តិ, បឝ្យត ឯឞ ភោក្តា មទ្យបាតា ចណ្ឌាលបាបិនាំ ពន្ធឝ្ច, កិន្តុ ជ្ញានិនោ ជ្ញានវ្យវហារំ និទ៌ោឞំ ជានន្តិ។</para>
  <para style="p">
    <verse number="20" style="v"/>ស យត្រ យត្រ បុរេ ពហ្វាឝ្ចយ៌្យំ កម៌្ម ក្ឫតវាន៑, តន្និវាសិនាំ មនះបរាវ្ឫត្ត្យភាវាត៑ តានិ នគរាណិ ប្រតិ ហន្តេត្យុក្តា កថិតវាន៑,</para>
  <para style="p">
    <verse number="21" style="v"/>ហា កោរាសីន៑, ហា ពៃត្សៃទេ, យុឞ្មន្មធ្យេ យទ្យទាឝ្ចយ៌្យំ កម៌្ម ក្ឫតំ យទិ តត៑ សោរសីទោន្នគរ អការិឞ្យត, តហ៌ិ បូវ៌្វមេវ តន្និវាសិនះ ឝាណវសនេ ភស្មនិ ចោបវិឝន្តោ មនាំសិ បរាវត៌្តិឞ្យន្ត។</para>
  <para style="p">
    <verse number="22" style="v"/>តស្មាទហំ យុឞ្មាន៑ វទាមិ, វិចារទិនេ យុឞ្មាកំ ទឝាតះ សោរសីទោនោ រ្ទឝា សហ្យតរា ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="23" style="v"/>អបរញ្ច ពត កផន៌ាហូម៑, ត្វំ ស្វគ៌ំ យាវទុន្នតោសិ, កិន្តុ នរកេ និក្ឞេប្ស្យសេ, យស្មាត៑ ត្វយិ យាន្យាឝ្ចយ៌្យាណិ កម៌្មណ្យការិឞត, យទិ តានិ សិទោម្នគរ អការិឞ្យន្ត, តហ៌ិ តទទ្យ យាវទស្ថាស្យត៑។</para>
  <para style="p">
    <verse number="24" style="v"/>កិន្ត្វហំ យុឞ្មាន៑ វទាមិ, វិចារទិនេ តវ ទណ្ឌតះ សិទោមោ ទណ្ឌោ សហ្យតរោ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="25" style="v"/>ឯតស្មិន្នេវ សមយេ យីឝុះ បុនរុវាច, ហេ ស្វគ៌ប្ឫថិវ្យោរេកាធិបតេ បិតស្ត្វំ ជ្ញានវតោ វិទុឞឝ្ច លោកាន៑ ប្រត្យេតានិ ន ប្រកាឝ្យ ពាលកាន៑ ប្រតិ ប្រកាឝិតវាន៑, ឥតិ ហេតោស្ត្វាំ ធន្យំ វទាមិ។</para>
  <para style="p">
    <verse number="26" style="v"/>ហេ បិតះ, ឥត្ថំ ភវេត៑ យត ឥទំ ត្វទ្ឫឞ្ដាវុត្តមំ។</para>
  <para style="p">
    <verse number="27" style="v"/>បិត្រា មយិ សវ៌្វាណិ សមប៌ិតានិ, បិតរំ វិនា កោបិ បុត្រំ ន ជានាតិ, យាន៑ ប្រតិ បុត្រេណ បិតា ប្រកាឝ្យតេ តាន៑ វិនា បុត្រាទ៑ អន្យះ កោបិ បិតរំ ន ជានាតិ។</para>
  <para style="p">
    <verse number="28" style="v"/>ហេ បរិឝ្រាន្តា ភារាក្រាន្តាឝ្ច លោកា យូយំ មត្សន្និធិម៑ អាគច្ឆត, អហំ យុឞ្មាន៑ វិឝ្រមយិឞ្យាមិ។</para>
  <para style="p">
    <verse number="29" style="v"/>អហំ ក្ឞមណឝីលោ នម្រមនាឝ្ច, តស្មាត៑ មម យុគំ ស្វេឞាមុបរិ ធារយត មត្តះ ឝិក្ឞធ្វញ្ច, តេន យូយំ ស្វេ ស្វេ មនសិ វិឝ្រាមំ លប្ស្យធ្ពេ។</para>
  <para style="p">
    <verse number="30" style="v"/>យតោ មម យុគម៑ អនាយាសំ មម ភារឝ្ច លឃុះ។</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ យីឝុ រ្វិឝ្រាមវារេ ឝ្ស្យមធ្យេន គច្ឆតិ, តទា តច្ឆិឞ្យា ពុភុក្ឞិតាះ សន្តះ ឝ្ស្យមញ្ជរីឝ្ឆត្វា ឆិត្វា ខាទិតុមារភន្ត។</para>
  <para style="p">
    <verse number="2" style="v"/>តទ៑ វិលោក្យ ផិរូឝិនោ យីឝុំ ជគទុះ, បឝ្យ វិឝ្រាមវារេ យត៑ កម៌្មាកត៌្តវ្យំ តទេវ តវ ឝិឞ្យាះ កុវ៌្វន្តិ។</para>
  <para style="p">
    <verse number="3" style="v"/>ស តាន៑ ប្រត្យាវទត, ទាយូទ៑ តត្សង្គិនឝ្ច ពុភុក្ឞិតាះ សន្តោ យត៑ កម៌្មាកុវ៌្វន៑ តត៑ កិំ យុឞ្មាភិ រ្នាបាឋិ?</para>
  <para style="p">
    <verse number="4" style="v"/>យេ ទឝ៌នីយាះ បូបាះ យាជកាន៑ វិនា តស្យ តត្សង្គិមនុជានាញ្ចាភោជនីយាស្ត ឦឝ្វរាវាសំ ប្រវិឞ្ដេន តេន ភុក្តាះ។</para>
  <para style="p">
    <verse number="5" style="v"/>អន្យច្ច វិឝ្រាមវារេ មធ្យេមន្ទិរំ វិឝ្រាមវារីយំ និយមំ លង្វន្តោបិ យាជកា និទ៌ោឞា ភវន្តិ, ឝាស្ត្រមធ្យេ កិមិទមបិ យុឞ្មាភិ រ្ន បឋិតំ?</para>
  <para style="p">
    <verse number="6" style="v"/>យុឞ្មានហំ វទាមិ, អត្រ ស្ថានេ មន្ទិរាទបិ គរីយាន៑ ឯក អាស្តេ។</para>
  <para style="p">
    <verse number="7" style="v"/>កិន្តុ ទយាយាំ មេ យថា ប្រីតិ រ្ន តថា យជ្ញកម៌្មណិ។ ឯតទ្វចនស្យាត៌្ហំ យទិ យុយម៑ អជ្ញាសិឞ្ដ តហ៌ិ និទ៌ោឞាន៑ ទោឞិណោ នាកាឞ៌្ដ។</para>
  <para style="p">
    <verse number="8" style="v"/>អន្យច្ច មនុជសុតោ វិឝ្រាមវារស្យាបិ បតិរាស្តេ។</para>
  <para style="p">
    <verse number="9" style="v"/>អនន្តរំ ស តត្ស្ថានាត៑ ប្រស្ថាយ តេឞាំ ភជនភវនំ ប្រវិឞ្ដវាន៑, តទានីម៑ ឯកះ ឝុឞ្កករាមយវាន៑ ឧបស្ថិតវាន៑។</para>
  <para style="p">
    <verse number="10" style="v"/>តតោ យីឝុម៑ អបវទិតុំ មានុឞាះ បប្រច្ឆុះ, វិឝ្រាមវារេ និរាមយត្វំ ករណីយំ ន វា?</para>
  <para style="p">
    <verse number="11" style="v"/>តេន ស ប្រត្យុវាច, វិឝ្រាមវារេ យទិ កស្យចិទ៑ អវិ រ្គត៌្តេ បតតិ, តហ៌ិ យស្តំ ឃ្ឫត្វា ន តោលយតិ, ឯតាទ្ឫឝោ មនុជោ យុឞ្មាកំ មធ្យេ ក អាស្តេ?</para>
  <para style="p">
    <verse number="12" style="v"/>អវេ រ្មានវះ កិំ នហិ ឝ្រេយាន៑? អតោ វិឝ្រាមវារេ ហិតកម៌្ម កត៌្តវ្យំ។</para>
  <para style="p">
    <verse number="13" style="v"/>អនន្តរំ ស តំ មានវំ គទិតវាន៑, ករំ ប្រសារយ; តេន ករេ ប្រសារិតេ សោន្យករវត៑ ស្វស្ថោៜភវត៑។</para>
  <para style="p">
    <verse number="14" style="v"/>តទា ផិរូឝិនោ ពហិព៌្ហូយ កថំ តំ ហនិឞ្យាម ឥតិ កុមន្ត្រណាំ តត្ប្រាតិកូល្យេន ចក្រុះ។</para>
  <para style="p">
    <verse number="15" style="v"/>តតោ យីឝុស្តទ៑ វិទិត្វា ស្ថនាន្តរំ គតវាន៑; អន្យេឞុ ពហុនរេឞុ តត្បឝ្ចាទ៑ គតេឞុ តាន៑ ស និរាមយាន៑ ក្ឫត្វា ឥត្យាជ្ញាបយត៑,</para>
  <para style="p">
    <verse number="16" style="v"/>យូយំ មាំ ន បរិចាយយត។</para>
  <para style="p">
    <verse number="17" style="v"/>តស្មាត៑ មម ប្រីយោ មនោនីតោ មនសស្តុឞ្ដិការកះ។ មទីយះ សេវកោ យស្តុ វិទ្យតេ តំ សមីក្ឞតាំ។ តស្យោបរិ ស្វកីយាត្មា មយា សំស្ថាបយិឞ្យតេ។ តេនាន្យទេឝជាតេឞុ វ្យវស្ថា សំប្រកាឝ្យតេ។</para>
  <para style="p">
    <verse number="18" style="v"/>កេនាបិ ន វិរោធំ ស វិវាទញ្ច ករិឞ្យតិ។ ន ច រាជបថេ តេន វចនំ ឝ្រាវយិឞ្យតេ។</para>
  <para style="p">
    <verse number="19" style="v"/>វ្យវស្ថា ចលិតា យាវត៑ នហិ តេន ករិឞ្យតេ។ តាវត៑ នលោ វិទីណ៌ោៜបិ ភំក្ឞ្យតេ នហិ តេន ច។ តថា សធូមវត៌្តិញ្ច ន ស និវ៌្វាបយិឞ្យតេ។</para>
  <para style="p">
    <verse number="20" style="v"/>ប្រត្យាឝាញ្ច ករិឞ្យន្តិ តន្នាម្និ ភិន្នទេឝជាះ។</para>
  <para style="p">
    <verse number="21" style="v"/>យាន្យេតានិ វចនានិ យិឝយិយភវិឞ្យទ្វាទិនា ប្រោក្តាន្យាសន៑, តានិ សផលាន្យភវន៑។</para>
  <para style="p">
    <verse number="22" style="v"/>អនន្តរំ លោកៃ ស្តត្សមីបម៑ អានីតោ ភូតគ្រស្តាន្ធមូកៃកមនុជស្តេន ស្វស្ថីក្ឫតះ, តតះ សោៜន្ធោ មូកោ ទ្រឞ្ដុំ វក្តុញ្ចារព្ធវាន៑។</para>
  <para style="p">
    <verse number="23" style="v"/>អនេន សវ៌្វេ វិស្មិតាះ កថយាញ្ចក្រុះ, ឯឞះ កិំ ទាយូទះ សន្តានោ នហិ?</para>
  <para style="p">
    <verse number="24" style="v"/>កិន្តុ ផិរូឝិនស្តត៑ ឝ្រុត្វា គទិតវន្តះ, ពាល្សិពូព្នាម្នោ ភូតរាជស្យ សាហាយ្យំ វិនា នាយំ ភូតាន៑ ត្យាជយតិ។</para>
  <para style="p">
    <verse number="25" style="v"/>តទានីំ យីឝុស្តេឞាម៑ ឥតិ មានសំ វិជ្ញាយ តាន៑ អវទត៑ កិញ្ចន រាជ្យំ យទិ ស្វវិបក្ឞាទ៑ ភិទ្យតេ, តហ៌ិ តត៑ ឧច្ឆិទ្យតេ; យច្ច កិញ្ចន នគរំ វា គ្ឫហំ ស្វវិបក្ឞាទ៑ វិភិទ្យតេ, តត៑ ស្ថាតុំ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="26" style="v"/>តទ្វត៑ ឝយតានោ យទិ ឝយតានំ ពហិះ ក្ឫត្វា ស្វវិបក្ឞាត៑ ប្ឫថក៑ ប្ឫថក៑ ភវតិ, តហ៌ិ តស្យ រាជ្យំ កេន ប្រការេណ ស្ថាស្យតិ?</para>
  <para style="p">
    <verse number="27" style="v"/>អហញ្ច យទិ ពាល្សិពូពា ភូតាន៑ ត្យាជយាមិ, តហ៌ិ យុឞ្មាកំ សន្តានាះ កេន ភូតាន៑ ត្យាជយន្តិ? តស្មាទ៑ យុឞ្មាកម៑ ឯតទ្វិចារយិតារស្ត ឯវ ភវិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="28" style="v"/>កិន្តវហំ យទីឝ្វរាត្មនា ភូតាន៑ ត្យាជយាមិ, តហ៌ីឝ្វរស្យ រាជ្យំ យុឞ្មាកំ សន្និធិមាគតវត៑។</para>
  <para style="p">
    <verse number="29" style="v"/>អន្យញ្ច កោបិ ពលវន្ត ជនំ ប្រថមតោ ន ពទ្វ្វា កេន ប្រការេណ តស្យ គ្ឫហំ ប្រវិឝ្យ តទ្ទ្រវ្យាទិ លោឋយិតុំ ឝក្នោតិ? កិន្តុ តត៑ ក្ឫត្វា តទីយគ្ឫស្យ ទ្រវ្យាទិ លោឋយិតុំ ឝក្នោតិ។</para>
  <para style="p">
    <verse number="30" style="v"/>យះ កឝ្ចិត៑ មម ស្វបក្ឞីយោ នហិ ស វិបក្ឞីយ អាស្តេ, យឝ្ច មយា សាកំ ន សំគ្ឫហ្លាតិ, ស វិកិរតិ។</para>
  <para style="p">
    <verse number="31" style="v"/>អតឯវ យុឞ្មានហំ វទាមិ, មនុជានាំ សវ៌្វប្រការបាបានាំ និន្ទាយាឝ្ច មឞ៌ណំ ភវិតុំ ឝក្នោតិ, កិន្តុ បវិត្រស្យាត្មនោ វិរុទ្ធនិន្ទាយា មឞ៌ណំ ភវិតុំ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="32" style="v"/>យោ មនុជសុតស្យ វិរុទ្ធាំ កថាំ កថយតិ, តស្យាបរាធស្យ ក្ឞមា ភវិតុំ ឝក្នោតិ, កិន្តុ យះ កឝ្ចិត៑ បវិត្រស្យាត្មនោ វិរុទ្ធាំ កថាំ កថយតិ នេហលោកេ ន ប្រេត្យ តស្យាបរាធស្យ ក្ឞមា ភវិតុំ ឝក្នោតិ។</para>
  <para style="p">
    <verse number="33" style="v"/>បាទបំ យទិ ភទ្រំ វទថ, តហ៌ិ តស្យ ផលមបិ សាធុ វក្តវ្យំ, យទិ ច បាទបំ អសាធុំ វទថ, តហ៌ិ តស្យ ផលមប្យសាធុ វក្តវ្យំ; យតះ ស្វីយស្វីយផលេន បាទបះ បរិចីយតេ។</para>
  <para style="p">
    <verse number="34" style="v"/>រេ ភុជគវំឝា យូយមសាធវះ សន្តះ កថំ សាធុ វាក្យំ វក្តុំ ឝក្ឞ្យថ? យស្មាទ៑ អន្តះករណស្យ បូណ៌ភាវានុសារាទ៑ វទនាទ៑ វចោ និគ៌ច្ឆតិ។</para>
  <para style="p">
    <verse number="35" style="v"/>តេន សាធុម៌ានវោៜន្តះករណរូបាត៑ សាធុភាណ្ឌាគារាត៑ សាធុ ទ្រវ្យំ និគ៌មយតិ, អសាធុម៌ានុឞស្ត្វសាធុភាណ្ឌាគារាទ៑ អសាធុវស្តូនិ និគ៌មយតិ។</para>
  <para style="p">
    <verse number="36" style="v"/>កិន្ត្វហំ យុឞ្មាន៑ វទាមិ, មនុជា យាវន្ត្យាលស្យវចាំសិ វទន្តិ, វិចារទិនេ តទុត្តរមវឝ្យំ ទាតវ្យំ,</para>
  <para style="p">
    <verse number="37" style="v"/>យតស្ត្វំ ស្វីយវចោភិ រ្និរបរាធះ ស្វីយវចោភិឝ្ច សាបរាធោ គណិឞ្យសេ។</para>
  <para style="p">
    <verse number="38" style="v"/>តទានីំ កតិបយា ឧបាធ្យាយាះ ផិរូឝិនឝ្ច ជគទុះ, ហេ គុរោ វយំ ភវត្តះ កិញ្ចន លក្ឞ្ម ទិទ្ឫក្ឞាមះ។</para>
  <para style="p">
    <verse number="39" style="v"/>តទា ស ប្រត្យុក្តវាន៑, ទុឞ្ដោ វ្យភិចារី ច វំឝោ លក្ឞ្ម ម្ឫគយតេ, កិន្តុ ភវិឞ្យទ្វាទិនោ យូនសោ លក្ឞ្ម វិហាយាន្យត៑ កិមបិ លក្ឞ្ម តេ ន ប្រទឝ៌យិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="40" style="v"/>យតោ យូនម៑ យថា ត្រ្យហោរាត្រំ ព្ឫហន្មីនស្យ កុក្ឞាវាសីត៑, តថា មនុជបុត្រោបិ ត្រ្យហោរាត្រំ មេទិន្យា មធ្យេ ស្ថាស្យតិ។</para>
  <para style="p">
    <verse number="41" style="v"/>អបរំ នីនិវីយា មានវា វិចារទិន ឯតទ្វំឝីយានាំ ប្រតិកូលម៑ ឧត្ថាយ តាន៑ ទោឞិណះ ករិឞ្យន្តិ, យស្មាត្តេ យូនស ឧបទេឝាត៑ មនាំសិ បរាវត៌្តយាញ្ចក្រិរេ, កិន្ត្វត្រ យូនសោបិ គុរុតរ ឯក អាស្តេ។</para>
  <para style="p">
    <verse number="42" style="v"/>បុនឝ្ច ទក្ឞិណទេឝីយា រាជ្ញី វិចារទិន ឯតទ្វំឝីយានាំ ប្រតិកូលមុត្ថាយ តាន៑ ទោឞិណះ ករិឞ្យតិ យតះ សា រាជ្ញី សុលេមនោ វិទ្យាយាះ កថាំ ឝ្រោតុំ មេទិន្យាះ សីម្ន អាគច្ឆត៑, កិន្តុ សុលេមនោបិ គុរុតរ ឯកោ ជនោៜត្រ អាស្តេ។</para>
  <para style="p">
    <verse number="43" style="v"/>អបរំ មនុជាទ៑ ពហិគ៌តោ ៜបវិត្រភូតះ ឝុឞ្កស្ថានេន គត្វា វិឝ្រាមំ គវេឞយតិ, កិន្តុ តទលភមានះ ស វក្តិ, យស្មា; និកេតនាទ៑ អាគមំ, តទេវ វេឝ្ម បកាវ្ឫត្យ យាមិ។</para>
  <para style="p">
    <verse number="44" style="v"/>បឝ្ចាត៑ ស តត៑ ស្ថានម៑ ឧបស្ថាយ តត៑ ឝូន្យំ មាជ៌្ជិតំ ឝោភិតញ្ច វិលោក្យ វ្រជន៑ ស្វតោបិ ទុឞ្ដតរាន៑ អន្យសប្តភូតាន៑ សង្គិនះ ករោតិ។</para>
  <para style="p">
    <verse number="45" style="v"/>តតស្តេ តត៑ ស្ថានំ ប្រវិឝ្យ និវសន្តិ, តេន តស្យ មនុជស្យ ឝេឞទឝា បូវ៌្វទឝាតោតីវាឝុភា ភវតិ, ឯតេឞាំ ទុឞ្ដវំឝ្យានាមបិ តថៃវ ឃដិឞ្យតេ។</para>
  <para style="p">
    <verse number="46" style="v"/>មានវេភ្យ ឯតាសាំ កថនាំ កថនកាលេ តស្យ មាតា សហជាឝ្ច តេន សាកំ កាញ្ចិត៑ កថាំ កថយិតុំ វាញ្ឆន្តោ ពហិរេវ ស្ថិតវន្តះ។</para>
  <para style="p">
    <verse number="47" style="v"/>តតះ កឝ្ចិត៑ តស្មៃ កថិតវាន៑, បឝ្យ តវ ជននី សហជាឝ្ច ត្វយា សាកំ កាញ្ចន កថាំ កថយិតុំ កាមយមានា ពហិស្តិឞ្ឋន្តិ។</para>
  <para style="p">
    <verse number="48" style="v"/>កិន្តុ ស តំ ប្រត្យវទត៑, មម កា ជននី? កេ វា មម សហជាះ?</para>
  <para style="p">
    <verse number="49" style="v"/>បឝ្ចាត៑ ឝិឞ្យាន៑ ប្រតិ ករំ ប្រសាយ៌្យ កថិតវាន៑, បឝ្យ មម ជននី មម សហជាឝ្ចៃតេ;</para>
  <para style="p">
    <verse number="50" style="v"/>យះ កឝ្ចិត៑ មម ស្វគ៌ស្ថស្យ បិតុរិឞ្ដំ កម៌្ម កុរុតេ, សឯវ មម ភ្រាតា ភគិនី ជននី ច។</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អបរញ្ច តស្មិន៑ ទិនេ យីឝុះ សទ្មនោ គត្វា សរិត្បតេ រោធសិ សមុបវិវេឝ។</para>
  <para style="p">
    <verse number="2" style="v"/>តត្រ តត្សន្និធៅ ពហុជនានាំ និវហោបស្ថិតេះ ស តរណិមារុហ្យ សមុបាវិឝត៑, តេន មានវា រោធសិ ស្ថិតវន្តះ។</para>
  <para style="p">
    <verse number="3" style="v"/>តទានីំ ស ទ្ឫឞ្ដាន្តៃស្តាន៑ ឥត្ថំ ពហុឝ ឧបទិឞ្ដវាន៑។ បឝ្យត, កឝ្ចិត៑ ក្ឫឞីវលោ ពីជានិ វប្តុំ ពហិជ៌គាម,</para>
  <para style="p">
    <verse number="4" style="v"/>តស្យ វបនកាលេ កតិបយពីជេឞុ មាគ៌បាឝ៌្វេ បតិតេឞុ វិហគាស្តានិ ភក្ឞិតវន្តះ។</para>
  <para style="p">
    <verse number="5" style="v"/>អបរំ កតិបយពីជេឞុ ស្តោកម្ឫទ្យុក្តបាឞាណេ បតិតេឞុ ម្ឫទល្បត្វាត៑ តត្ក្ឞណាត៑ តាន្យង្កុរិតានិ,</para>
  <para style="p">
    <verse number="6" style="v"/>កិន្តុ រវាវុទិតេ ទគ្ធានិ តេឞាំ មូលាប្រវិឞ្ដត្វាត៑ ឝុឞ្កតាំ គតានិ ច។</para>
  <para style="p">
    <verse number="7" style="v"/>អបរំ កតិបយពីជេឞុ កណ្ដកានាំ មធ្យេ បតិតេឞុ កណ្ដកាន្យេធិត្វា តានិ ជគ្រសុះ។</para>
  <para style="p">
    <verse number="8" style="v"/>អបរញ្ច កតិបយពីជានិ ឧវ៌្វរាយាំ បតិតានិ; តេឞាំ មធ្យេ កានិចិត៑ ឝតគុណានិ កានិចិត៑ ឞឞ្ដិគុណានិ កានិចិត៑ ត្រិំឝគុំណានិ ផលានិ ផលិតវន្តិ។</para>
  <para style="p">
    <verse number="9" style="v"/>ឝ្រោតុំ យស្យ ឝ្រុតី អាសាតេ ស ឝ្ឫណុយាត៑។</para>
  <para style="p">
    <verse number="10" style="v"/>អនន្តរំ ឝិឞ្យៃរាគត្យ សោៜប្ឫច្ឆ្យត, ភវតា តេភ្យះ កុតោ ទ្ឫឞ្ដាន្តកថា កថ្យតេ?</para>
  <para style="p">
    <verse number="11" style="v"/>តតះ ស ប្រត្យវទត៑, ស្វគ៌រាជ្យស្យ និគូឍាំ កថាំ វេទិតុំ យុឞ្មភ្យំ សាមត៌្ហ្យមទាយិ, កិន្តុ តេភ្យោ នាទាយិ។</para>
  <para style="p">
    <verse number="12" style="v"/>យស្មាទ៑ យស្យាន្តិកេ វទ៌្ធតេ, តស្មាយេវ ទាយិឞ្យតេ, តស្មាត៑ តស្យ ពាហុល្យំ ភវិឞ្យតិ, កិន្តុ យស្យាន្តិកេ ន វទ៌្ធតេ, តស្យ យត៑ កិញ្ចនាស្តេ, តទបិ តស្មាទ៑ អាទាយិឞ្យតេ។</para>
  <para style="p">
    <verse number="13" style="v"/>តេ បឝ្យន្តោបិ ន បឝ្យន្តិ, ឝ្ឫណ្វន្តោបិ ន ឝ្ឫណ្វន្តិ, ពុធ្យមានា អបិ ន ពុធ្យន្តេ ច, តស្មាត៑ តេភ្យោ ទ្ឫឞ្ដាន្តកថា កថ្យតេ។</para>
  <para style="p">
    <verse number="14" style="v"/>យថា កណ៌ៃះ ឝ្រោឞ្យថ យូយំ វៃ កិន្តុ យូយំ ន ភោត្ស្យថ។ នេត្រៃទ៌្រក្ឞ្យថ យូយញ្ច បរិជ្ញាតុំ ន ឝក្ឞ្យថ។ តេ មានុឞា យថា នៃវ បរិបឝ្យន្តិ លោចនៃះ។ កណ៌ៃ រ្យថា ន ឝ្ឫណ្វន្តិ ន ពុធ្យន្តេ ច មានសៃះ។ វ្យាវត៌្តិតេឞុ ចិត្តេឞុ កាលេ កុត្រាបិ តៃជ៌នៃះ។ មត្តស្តេ មនុជាះ ស្វស្ថា យថា នៃវ ភវន្តិ ច។ តថា តេឞាំ មនុឞ្យាណាំ ក្រិយន្តេ ស្ថូលពុទ្ធយះ។ ពធិរីភូតកណ៌ាឝ្ច ជាតាឝ្ច មុទ្រិតា ទ្ឫឝះ។</para>
  <para style="p">
    <verse number="15" style="v"/>យទេតានិ វចនានិ យិឝយិយភវិឞ្យទ្វាទិនា ប្រោក្តានិ តេឞុ តានិ ផលន្តិ។</para>
  <para style="p">
    <verse number="16" style="v"/>កិន្តុ យុឞ្មាកំ នយនានិ ធន្យានិ, យស្មាត៑ តានិ វីក្ឞន្តេ; ធន្យាឝ្ច យុឞ្មាកំ ឝព្ទគ្រហាះ, យស្មាត៑ តៃរាកណ៌្យតេ។</para>
  <para style="p">
    <verse number="17" style="v"/>មយា យូយំ តថ្យំ វចាមិ យុឞ្មាភិ រ្យទ្យទ៑ វីក្ឞ្យតេ, តទ៑ ពហវោ ភវិឞ្យទ្វាទិនោ ធាម៌្មិកាឝ្ច មានវា ទិទ្ឫក្ឞន្តោបិ ទ្រឞ្ដុំ នាលភន្ត, បុនឝ្ច យូយំ យទ្យត៑ ឝ្ឫណុថ, តត៑ តេ ឝុឝ្រូឞមាណា អបិ ឝ្រោតុំ នាលភន្ត។</para>
  <para style="p">
    <verse number="18" style="v"/>ក្ឫឞីវលីយទ្ឫឞ្ដាន្តស្យាត៌្ហំ ឝ្ឫណុត។</para>
  <para style="p">
    <verse number="19" style="v"/>មាគ៌បាឝ៌្វេ ពីជាន្យុប្តានិ តស្យាត៌្ហ ឯឞះ, យទា កឝ្ចិត៑ រាជ្យស្យ កថាំ និឝម្យ ន ពុធ្យតេ, តទា បាបាត្មាគត្យ តទីយមនស ឧប្តាំ កថាំ ហរន៑ នយតិ។</para>
  <para style="p">
    <verse number="20" style="v"/>អបរំ បាឞាណស្ថលេ ពីជាន្យុប្តានិ តស្យាត៌្ហ ឯឞះ; កឝ្ចិត៑ កថាំ ឝ្រុត្វៃវ ហឞ៌ចិត្តេន គ្ឫហ្លាតិ,</para>
  <para style="p">
    <verse number="21" style="v"/>កិន្តុ តស្យ មនសិ មូលាប្រវិឞ្ដត្វាត៑ ស កិញ្ចិត្កាលមាត្រំ ស្ថិរស្តិឞ្ឋតិ; បឝ្ចាត តត្កថាការណាត៑ កោបិ ក្លេស្តាឌនា វា ចេត៑ ជាយតេ, តហ៌ិ ស តត្ក្ឞណាទ៑ វិឃ្នមេតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>អបរំ កណ្ដកានាំ មធ្យេ ពីជាន្យុប្តានិ តទត៌្ហ ឯឞះ; កេនចិត៑ កថាយាំ ឝ្រុតាយាំ សាំសារិកចិន្តាភិ រ្ភ្រាន្តិភិឝ្ច សា គ្រស្យតេ, តេន សា មា វិផលា ភវតិ។</para>
  <para style="p">
    <verse number="23" style="v"/>អបរម៑ ឧវ៌្វរាយាំ ពីជាន្យុប្តានិ តទត៌្ហ ឯឞះ; យេ តាំ កថាំ ឝ្រុត្វា វុធ្យន្តេ, តេ ផលិតាះ សន្តះ កេចិត៑ ឝតគុណានិ កេចិត ឞឞ្ដិគុណានិ កេចិច្ច ត្រិំឝទ្គុណានិ ផលានិ ជនយន្តិ។</para>
  <para style="p">
    <verse number="24" style="v"/>អនន្តរំ សោបរាមេកាំ ទ្ឫឞ្ដាន្តកថាមុបស្ថាប្យ តេភ្យះ កថយាមាស; ស្វគ៌ីយរាជ្យំ តាទ្ឫឝេន កេនចិទ៑ គ្ឫហស្ថេនោបមីយតេ, យេន ស្វីយក្ឞេត្រេ ប្រឝស្តពីជាន្យៅប្យន្ត។</para>
  <para style="p">
    <verse number="25" style="v"/>កិន្តុ ក្ឞណទាយាំ សកលលោកេឞុ សុប្តេឞុ តស្យ រិបុរាគត្យ តេឞាំ គោធូមពីជានាំ មធ្យេ វន្យយវមពីជាន្យុប្ត្វា វវ្រាជ។</para>
  <para style="p">
    <verse number="26" style="v"/>តតោ យទា ពីជេភ្យោៜង្ករា ជាយមានាះ កណិឝានិ ឃ្ឫតវន្តះ; តទា វន្យយវសាន្យបិ ទ្ឫឝ្យមានាន្យភវន៑។</para>
  <para style="p">
    <verse number="27" style="v"/>តតោ គ្ឫហស្ថស្យ ទាសេយា អាគម្យ តស្មៃ កថយាញ្ចក្រុះ, ហេ មហេច្ឆ, ភវតា កិំ ក្ឞេត្រេ ភទ្រពីជានិ នៅប្យន្ត? តថាត្វេ វន្យយវសានិ ក្ឫត អាយន៑?</para>
  <para style="p">
    <verse number="28" style="v"/>តទានីំ តេន តេ ប្រតិគទិតាះ, កេនចិត៑ រិបុណា កម៌្មទមការិ។ ទាសេយាះ កថយាមាសុះ, វយំ គត្វា តាន្យុត្បាយ្យ ក្ឞិបាមោ ភវតះ កីទ្ឫឝីច្ឆា ជាយតេ?</para>
  <para style="p">
    <verse number="29" style="v"/>តេនាវាទិ, នហិ, ឝង្កេៜហំ វន្យយវសោត្បាដនកាលេ យុឞ្មាភិស្តៃះ សាកំ គោធូមា អប្យុត្បាដិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="30" style="v"/>អតះ ឝ្ស្យកត៌្តនកាលំ យាវទ៑ ឧភយាន្យបិ សហ វទ៌្ធន្តាំ, បឝ្ចាត៑ កត៌្តនកាលេ កត៌្តកាន៑ វក្ឞ្យាមិ, យូយមាទៅ វន្យយវសានិ សំគ្ឫហ្យ ទាហយិតុំ វីដិកា ពទ្វ្វា ស្ថាបយត; កិន្តុ សវ៌្វេ គោធូមា យុឞ្មាភិ រ្ភាណ្ឌាគារំ នីត្វា ស្ថាប្យន្តាម៑។</para>
  <para style="p">
    <verse number="31" style="v"/>អនន្តរំ សោបរាមេកាំ ទ្ឫឞ្ដាន្តកថាមុត្ថាប្យ តេភ្យះ កថិតវាន៑ កឝ្ចិន្មនុជះ សឞ៌បពីជមេកំ នីត្វា ស្វក្ឞេត្រ ឧវាប។</para>
  <para style="p">
    <verse number="32" style="v"/>សឞ៌បពីជំ សវ៌្វស្មាទ៑ ពីជាត៑ ក្ឞុទ្រមបិ សទង្កុរិតំ សវ៌្វស្មាត៑ ឝាកាត៑ ព្ឫហទ៑ ភវតិ; ស តាទ្ឫឝស្តរុ រ្ភវតិ, យស្យ ឝាខាសុ នភសះ ខគា អាគត្យ និវសន្តិ; ស្វគ៌ីយរាជ្យំ តាទ្ឫឝស្យ សឞ៌បៃកស្យ សមម៑។</para>
  <para style="p">
    <verse number="33" style="v"/>បុនរបិ ស ឧបមាកថាមេកាំ តេភ្យះ កថយាញ្ចការ; កាចន យោឞិត៑ យត៑ កិណ្វមាទាយ ទ្រោណត្រយមិតគោធូមចូណ៌ានាំ មធ្យេ សវ៌្វេឞាំ មិឝ្រីភវនបយ៌្យន្តំ សមាច្ឆាទ្យ និធត្តវតី, តត្កិណ្វមិវ ស្វគ៌រាជ្យំ។</para>
  <para style="p">
    <verse number="34" style="v"/>ឥត្ថំ យីឝុ រ្មនុជនិវហានាំ សន្និធាវុបមាកថាភិរេតាន្យាខ្យានានិ កថិតវាន៑ ឧបមាំ វិនា តេភ្យះ កិមបិ កថាំ នាកថយត៑។</para>
  <para style="p">
    <verse number="35" style="v"/>ឯតេន ទ្ឫឞ្ដាន្តីយេន វាក្យេន វ្យាទាយ វទនំ និជំ។ អហំ ប្រកាឝយិឞ្យាមិ គុប្តវាក្យំ បុរាភវំ។ យទេតទ្វចនំ ភវិឞ្យទ្វាទិនា ប្រោក្តមាសីត៑, តត៑ សិទ្ធមភវត៑។</para>
  <para style="p">
    <verse number="36" style="v"/>សវ៌្វាន៑ មនុជាន៑ វិស្ឫជ្យ យីឝៅ គ្ឫហំ ប្រវិឞ្ដេ តច្ឆិឞ្យា អាគត្យ យីឝវេ កថិតវន្តះ, ក្ឞេត្រស្យ វន្យយវសីយទ្ឫឞ្ដាន្តកថាម៑ ភវាន អស្មាន៑ ស្បឞ្ដីក្ឫត្យ វទតុ។</para>
  <para style="p">
    <verse number="37" style="v"/>តតះ ស ប្រត្យុវាច, យេន ភទ្រពីជាន្យុប្យន្តេ ស មនុជបុត្រះ,</para>
  <para style="p">
    <verse number="38" style="v"/>ក្ឞេត្រំ ជគត៑, ភទ្រពីជានី រាជ្យស្យ សន្តានាះ,</para>
  <para style="p">
    <verse number="39" style="v"/>វន្យយវសានិ បាបាត្មនះ សន្តានាះ។ យេន រិបុណា តាន្យុប្តានិ ស ឝយតានះ, កត៌្តនសមយឝ្ច ជគតះ ឝេឞះ, កត៌្តកាះ ស្វគ៌ីយទូតាះ។</para>
  <para style="p">
    <verse number="40" style="v"/>យថា វន្យយវសានិ សំគ្ឫហ្យ ទាហ្យន្តេ, តថា ជគតះ ឝេឞេ ភវិឞ្យតិ;</para>
  <para style="p">
    <verse number="41" style="v"/>អត៌្ហាត៑ មនុជសុតះ ស្វាំយទូតាន៑ ប្រេឞយិឞ្យតិ, តេន តេ ច តស្យ រាជ្យាត៑ សវ៌្វាន៑ វិឃ្នការិណោៜធាម៌្មិកលោកាំឝ្ច សំគ្ឫហ្យ</para>
  <para style="p">
    <verse number="42" style="v"/>យត្រ រោទនំ ទន្តឃឞ៌ណញ្ច ភវតិ, តត្រាគ្និកុណ្ឌេ និក្ឞេប្ស្យន្តិ។</para>
  <para style="p">
    <verse number="43" style="v"/>តទានីំ ធាម៌្មិកលោកាះ ស្វេឞាំ បិតូ រាជ្យេ ភាស្ករឥវ តេជស្វិនោ ភវិឞ្យន្តិ។ ឝ្រោតុំ យស្យ ឝ្រុតី អាសាតេ, ម ឝ្ឫណុយាត៑។</para>
  <para style="p">
    <verse number="44" style="v"/>អបរញ្ច ក្ឞេត្រមធ្យេ និធិំ បឝ្យន៑ យោ គោបយតិ, តតះ បរំ សានន្ទោ គត្វា ស្វីយសវ៌្វស្វំ វិក្រីយ ត្តក្ឞេត្រំ ក្រីណាតិ, ស ឥវ ស្វគ៌រាជ្យំ។</para>
  <para style="p">
    <verse number="45" style="v"/>អន្យញ្ច យោ វណិក៑ ឧត្តមាំ មុក្តាំ គវេឞយន្</para>
  <para style="p">
    <verse number="46" style="v"/>មហាគ៌្ហាំ មុក្តាំ វិលោក្យ និជសវ៌្វស្វំ វិក្រីយ តាំ ក្រីណាតិ, ស ឥវ ស្វគ៌រាជ្យំ។</para>
  <para style="p">
    <verse number="47" style="v"/>បុនឝ្ច សមុទ្រោ និក្ឞិប្តះ សវ៌្វប្រការមីនសំគ្រាហ្យានាយឥវ ស្វគ៌រាជ្យំ។</para>
  <para style="p">
    <verse number="48" style="v"/>តស្មិន៑ អានាយេ បូណ៌េ ជនា យថា រោធស្យុត្តោល្យ សមុបវិឝ្យ ប្រឝស្តមីនាន៑ សំគ្រហ្យ ភាជនេឞុ និទធតេ, កុត្សិតាន៑ និក្ឞិបន្តិ;</para>
  <para style="p">
    <verse number="49" style="v"/>តថៃវ ជគតះ ឝេឞេ ភវិឞ្យតិ, ផលតះ ស្វគ៌ីយទូតា អាគត្យ បុណ្យវជ្ជនានាំ មធ្យាត៑ បាបិនះ ប្ឫថក៑ ក្ឫត្វា វហ្និកុណ្ឌេ និក្ឞេប្ស្យន្តិ,</para>
  <para style="p">
    <verse number="50" style="v"/>តត្រ រោទនំ ទន្តៃ រ្ទន្តឃឞ៌ណញ្ច ភវិឞ្យតះ។</para>
  <para style="p">
    <verse number="51" style="v"/>យីឝុនា តេ ប្ឫឞ្ដា យុឞ្មាភិះ កិមេតាន្យាខ្យានាន្យពុធ្យន្ត? តទា តេ ប្រត្យវទន៑, សត្យំ ប្រភោ។</para>
  <para style="p">
    <verse number="52" style="v"/>តទានីំ ស កថិតវាន៑, និជភាណ្ឌាគារាត៑ នវីនបុរាតនានិ វស្តូនិ និគ៌មយតិ យោ គ្ឫហស្ថះ ស ឥវ ស្វគ៌រាជ្យមធិ ឝិក្ឞិតាះ ស្វវ៌ ឧបទេឞ្ដារះ។</para>
  <para style="p">
    <verse number="53" style="v"/>អនន្តរំ យីឝុរេតាះ សវ៌្វា ទ្ឫឞ្ដាន្តកថាះ សមាប្យ តស្មាត៑ ស្ថានាត៑ ប្រតស្ថេ។ អបរំ ស្វទេឝមាគត្យ ជនាន៑ ភជនភវន ឧបទិឞ្ដវាន៑;</para>
  <para style="p">
    <verse number="54" style="v"/>តេ វិស្មយំ គត្វា កថិតវន្ត ឯតស្យៃតាទ្ឫឝំ ជ្ញានម៑ អាឝ្ចយ៌្យំ កម៌្ម ច កស្មាទ៑ អជាយត?</para>
  <para style="p">
    <verse number="55" style="v"/>កិមយំ សូត្រធារស្យ បុត្រោ នហិ? ឯតស្យ មាតុ រ្នាម ច កិំ មរិយម៑ នហិ? យាកុព៑-យូឞផ៑-ឝិមោន៑-យិហូទាឝ្ច កិមេតស្យ ភ្រាតរោ នហិ?</para>
  <para style="p">
    <verse number="56" style="v"/>ឯតស្យ ភគិន្យឝ្ច កិមស្មាកំ មធ្យេ ន សន្តិ? តហ៌ិ កស្មាទយមេតានិ លព្ធវាន៑? ឥត្ថំ ស តេឞាំ វិឃ្នរូបោ ពភូវ;</para>
  <para style="p">
    <verse number="57" style="v"/>តតោ យីឝុនា និគទិតំ ស្វទេឝីយជនានាំ មធ្យំ វិនា ភវិឞ្យទ្វាទី កុត្រាប្យន្យត្រ នាសម្មាន្យោ ភវតី។</para>
  <para style="p">
    <verse number="58" style="v"/>តេឞាមវិឝ្វាសហេតោះ ស តត្រ ស្ថានេ ពហ្វាឝ្ចយ៌្យកម៌្មាណិ ន ក្ឫតវាន៑។</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តទានីំ រាជា ហេរោទ៑ យីឝោ រ្យឝះ ឝ្រុត្វា និជទាសេយាន៑ ជគាទ៑,</para>
  <para style="p">
    <verse number="2" style="v"/>ឯឞ មជ្ជយិតា យោហន៑, ប្រមិតេភយស្តស្យោត្ថានាត៑ តេនេត្ថមទ្ភុតំ កម៌្ម ប្រកាឝ្យតេ។</para>
  <para style="p">
    <verse number="3" style="v"/>បុរា ហេរោទ៑ និជភ្រាតុ: ផិលិបោ ជាយាយា ហេរោទីយាយា អនុរោធាទ៑ យោហនំ ធារយិត្វា ពទ្ធា ការាយាំ ស្ថាបិតវាន៑។</para>
  <para style="p">
    <verse number="4" style="v"/>យតោ យោហន៑ ឧក្តវាន៑, ឯត្សយាះ សំគ្រហោ ភវតោ នោចិតះ។</para>
  <para style="p">
    <verse number="5" style="v"/>តស្មាត៑ ន្ឫបតិស្តំ ហន្តុមិច្ឆន្នបិ លោកេភ្យោ វិភយាញ្ចការ; យតះ សវ៌្វេ យោហនំ ភវិឞ្យទ្វាទិនំ មេនិរេ។</para>
  <para style="p">
    <verse number="6" style="v"/>កិន្តុ ហេរោទោ ជន្មាហីយមហ ឧបស្ថិតេ ហេរោទីយាយា ទុហិតា តេឞាំ សមក្ឞំ ន្ឫតិត្វា ហេរោទមប្រីណ្យត៑។</para>
  <para style="p">
    <verse number="7" style="v"/>តស្មាត៑ ភូបតិះ ឝបថំ កុវ៌្វន៑ ឥតិ ប្រត្យជ្ញាសីត៑, ត្វយា យទ៑ យាច្យតេ, តទេវាហំ ទាស្យាមិ។</para>
  <para style="p">
    <verse number="8" style="v"/>សា កុមារី ស្វីយមាតុះ ឝិក្ឞាំ លព្ធា ពភាឞេ, មជ្ជយិតុយ៌ោហន ឧត្តមាង្គំ ភាជនេ សមានីយ មហ្យំ វិឝ្រាណយ។</para>
  <para style="p">
    <verse number="9" style="v"/>តតោ រាជា ឝុឝោច, កិន្តុ ភោជនាយោបវិឝតាំ សង្គិនាំ ស្វក្ឫតឝបថស្យ ចានុរោធាត៑ តត៑ ប្រទាតុម អាទិទេឝ។</para>
  <para style="p">
    <verse number="10" style="v"/>បឝ្ចាត៑ ការាំ ប្រតិ នរំ ប្រហិត្យ យោហន ឧត្តមាង្គំ ឆិត្ត្វា</para>
  <para style="p">
    <verse number="11" style="v"/>តត៑ ភាជន អានាយ្យ តស្យៃ កុមាយ៌្យៃ វ្យឝ្រាណយត៑, តតះ សា ស្វជនន្យាះ សមីបំ តន្និនាយ។</para>
  <para style="p">
    <verse number="12" style="v"/>បឝ្ចាត៑ យោហនះ ឝិឞ្យា អាគត្យ កាយំ នីត្វា ឝ្មឝានេ ស្ថាបយាមាសុស្តតោ យីឝោះ សន្និធិំ វ្រជិត្វា តទ្វាត៌្តាំ ពភាឞិរេ។</para>
  <para style="p">
    <verse number="13" style="v"/>អនន្តរំ យីឝុរិតិ និឝភ្យ នាវា និជ៌នស្ថានម៑ ឯកាកី គតវាន៑, បឝ្ចាត៑ មានវាស្តត៑ ឝ្រុត្វា នានានគរេភ្យ អាគត្យ បទៃស្តត្បឝ្ចាទ៑ ឦយុះ។</para>
  <para style="p">
    <verse number="14" style="v"/>តទានីំ យីឝុ រ្ពហិរាគត្យ មហាន្តំ ជននិវហំ និរីក្ឞ្យ តេឞុ ការុណិកះ មន៑ តេឞាំ បីឌិតជនាន៑ និរាមយាន៑ ចការ។</para>
  <para style="p">
    <verse number="15" style="v"/>តតះ បរំ សន្ធ្យាយាំ ឝិឞ្យាស្តទន្តិកមាគត្យ កថយាញ្ចក្រុះ, ឥទំ និជ៌នស្ថានំ វេលាប្យវសន្នា; តស្មាត៑ មនុជាន៑ ស្វស្វគ្រាមំ គន្តុំ ស្វាត៌្ហំ ភក្ឞ្យាណិ ក្រេតុញ្ច ភវាន៑ តាន៑ វិស្ឫជតុ។</para>
  <para style="p">
    <verse number="16" style="v"/>កិន្តុ យីឝុស្តានវាទីត៑, តេឞាំ គមនេ ប្រយោជនំ នាស្តិ, យូយមេវ តាន៑ ភោជយត។</para>
  <para style="p">
    <verse number="17" style="v"/>តទា តេ ប្រត្យវទន៑, អស្មាកមត្រ បូបបញ្ចកំ មីនទ្វយញ្ចាស្តេ។</para>
  <para style="p">
    <verse number="18" style="v"/>តទានីំ តេនោក្តំ តានិ មទន្តិកមានយត។</para>
  <para style="p">
    <verse number="19" style="v"/>អនន្តរំ ស មនុជាន៑ យវសោបយ៌្យុបវេឞ្ដុម៑ អាជ្ញាបយាមាស; អបរ តត៑ បូបបញ្ចកំ មីនទ្វយញ្ច គ្ឫហ្លន៑ ស្វគ៌ំ ប្រតិ និរីក្ឞ្យេឝ្វរីយគុណាន៑ អនូទ្យ ភំក្ត្វា ឝិឞ្យេភ្យោ ទត្តវាន៑, ឝិឞ្យាឝ្ច លោកេភ្យោ ទទុះ។</para>
  <para style="p">
    <verse number="20" style="v"/>តតះ សវ៌្វេ ភុក្ត្វា បរិត្ឫប្តវន្តះ, តតស្តទវឝិឞ្ដភក្ឞ្យៃះ បូណ៌ាន៑ ទ្វាទឝឌលកាន៑ គ្ឫហីតវន្តះ។</para>
  <para style="p">
    <verse number="21" style="v"/>តេ ភោក្តារះ ស្ត្រីព៌ាលកាំឝ្ច វិហាយ ប្រាយេណ បញ្ច សហស្រាណិ បុមាំស អាសន៑។</para>
  <para style="p">
    <verse number="22" style="v"/>តទនន្តរំ យីឝុ រ្លោកានាំ វិសជ៌នកាលេ ឝិឞ្យាន៑ តរណិមារោឍុំ ស្វាគ្រេ បារំ យាតុញ្ច គាឍមាទិឞ្ដវាន៑។</para>
  <para style="p">
    <verse number="23" style="v"/>តតោ លោកេឞុ វិស្ឫឞ្ដេឞុ ស វិវិក្តេ ប្រាត៌្ហយិតុំ គិរិមេកំ គត្វា សន្ធ្យាំ យាវត៑ តត្រៃកាកី ស្ថិតវាន៑។</para>
  <para style="p">
    <verse number="24" style="v"/>កិន្តុ តទានីំ សម្មុខវាតត្វាត៑ សរិត្បតេ រ្មធ្យេ តរង្គៃស្តរណិទ៌ោលាយមានាភវត៑។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា ស យាមិន្យាឝ្ចតុត៌្ហប្រហរេ បទ្ភ្យាំ វ្រជន៑ តេឞាមន្តិកំ គតវាន៑។</para>
  <para style="p">
    <verse number="26" style="v"/>កិន្តុ ឝិឞ្យាស្តំ សាគរោបរិ វ្រជន្តំ វិលោក្យ សមុទ្វិគ្នា ជគទុះ, ឯឞ ភូត ឥតិ ឝង្កមានា ឧច្ចៃះ ឝព្ទាយាញ្ចក្រិរេ ច។</para>
  <para style="p">
    <verse number="27" style="v"/>តទៃវ យីឝុស្តានវទត៑, សុស្ថិរា ភវត, មា ភៃឞ្ដ, ឯឞោៜហម៑។</para>
  <para style="p">
    <verse number="28" style="v"/>តតះ បិតរ ឥត្យុក្តវាន៑, ហេ ប្រភោ, យទិ ភវានេវ, តហ៌ិ មាំ ភវត្សមីបំ យាតុមាជ្ញាបយតុ។</para>
  <para style="p">
    <verse number="29" style="v"/>តតះ តេនាទិឞ្ដះ បិតរស្តរណិតោៜវរុហ្យ យីឝេाរន្តិកំ ប្រាប្តុំ តោយោបរិ វវ្រាជ។</para>
  <para style="p">
    <verse number="30" style="v"/>កិន្តុ ប្រចណ្ឌំ បវនំ វិលោក្យ ភយាត៑ តោយេ មំក្តុម៑ អារេភេ, តស្មាទ៑ ឧច្ចៃះ ឝព្ទាយមានះ កថិតវាន៑, ហេ ប្រភោ, មាមវតុ។</para>
  <para style="p">
    <verse number="31" style="v"/>យីឝុស្តត្ក្ឞណាត៑ ករំ ប្រសាយ៌្យ តំ ធរន៑ ឧក្តវាន៑, ហ ស្តោកប្រត្យយិន៑ ត្វំ កុតះ សមឝេថាះ?</para>
  <para style="p">
    <verse number="32" style="v"/>អនន្តរំ តយោស្តរណិមារូឍយោះ បវនោ និវវ្ឫតេ។</para>
  <para style="p">
    <verse number="33" style="v"/>តទានីំ យេ តរណ្យាមាសន៑, ត អាគត្យ តំ ប្រណភ្យ កថិតវន្តះ, យថាត៌្ហស្ត្វមេវេឝ្វរសុតះ។</para>
  <para style="p">
    <verse number="34" style="v"/>អនន្តរំ បារំ ប្រាប្យ តេ គិនេឞរន្នាមកំ នគរមុបតស្ថុះ,</para>
  <para style="p">
    <verse number="35" style="v"/>តទា តត្រត្យា ជនា យីឝុំ បរិចីយ តទ្ទេឝ្ស្យ ចតុទ៌ិឝោ វាត៌្តាំ ប្រហិត្យ យត្រ យាវន្តះ បីឌិតា អាសន៑, តាវតឯវ តទន្តិកមានយាមាសុះ។</para>
  <para style="p">
    <verse number="36" style="v"/>អបរំ តទីយវសនស្យ គ្រន្ថិមាត្រំ ស្ប្រឞ្ដុំ វិនីយ យាវន្តោ ជនាស្តត៑ ស្បឝ៌ំ ចក្រិរេ, តេ សវ៌្វឯវ និរាមយា ពភូវុះ។</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អបរំ យិរូឝាលម្នគរីយាះ កតិបយា អធ្យាបកាះ ផិរូឝិនឝ្ច យីឝោះ សមីបមាគត្យ កថយាមាសុះ,</para>
  <para style="p">
    <verse number="2" style="v"/>តវ ឝិឞ្យាះ កិមត៌្ហម៑ អប្រក្ឞាលិតករៃ រ្ភក្ឞិត្វា បរម្បរាគតំ ប្រាចីនានាំ វ្យវហារំ លង្វន្តេ?</para>
  <para style="p">
    <verse number="3" style="v"/>តតោ យីឝុះ ប្រត្យុវាច, យូយំ បរម្បរាគតាចារេណ កុត ឦឝ្វរាជ្ញាំ លង្វធ្វេ។</para>
  <para style="p">
    <verse number="4" style="v"/>ឦឝ្វរ ឥត្យាជ្ញាបយត៑, ត្វំ និជបិតរៅ សំមន្យេថាះ, យេន ច និជបិតរៅ និន្ទ្យេតេ, ស និឝ្ចិតំ ម្រិយេត;</para>
  <para style="p">
    <verse number="5" style="v"/>កិន្តុ យូយំ វទថ, យះ ស្វជនកំ ស្វជននីំ វា វាក្យមិទំ វទតិ, យុវាំ មត្តោ យល្លភេថេ, តត៑ ន្យវិទ្យត,</para>
  <para style="p">
    <verse number="6" style="v"/>ស និជបិតរៅ បុន រ្ន សំមំស្យតេ។ ឥត្ថំ យូយំ បរម្បរាគតេន ស្វេឞាមាចារេណេឝ្វរីយាជ្ញាំ លុម្បថ។</para>
  <para style="p">
    <verse number="7" style="v"/>រេ កបដិនះ សវ៌្វេ យិឝយិយោ យុឞ្មានធិ ភវិឞ្យទ្វចនាន្យេតានិ សម្យគ៑ ឧក្តវាន៑។</para>
  <para style="p">
    <verse number="8" style="v"/>វទនៃ រ្មនុជា ឯតេ សមាយាន្តិ មទន្តិកំ។ តថាធរៃ រ្មទីយញ្ច មានំ កុវ៌្វន្តិ តេ នរាះ។</para>
  <para style="p">
    <verse number="9" style="v"/>កិន្តុ តេឞាំ មនោ មត្តោ វិទូរឯវ តិឞ្ឋតិ។ ឝិក្ឞយន្តោ វិធីន៑ ន្រាជ្ញា ភជន្តេ មាំ មុធៃវ តេ។</para>
  <para style="p">
    <verse number="10" style="v"/>តតោ យីឝុ រ្លោកាន៑ អាហូយ ប្រោក្តវាន៑, យូយំ ឝ្រុត្វា ពុធ្យធ្ពំ។</para>
  <para style="p">
    <verse number="11" style="v"/>យន្មុខំ ប្រវិឝតិ, តត៑ មនុជម៑ អមេធ្យំ ន ករោតិ, កិន្តុ យទាស្យាត៑ និគ៌ច្ឆតិ, តទេវ មានុឞមមេធ្យី ករោតី។</para>
  <para style="p">
    <verse number="12" style="v"/>តទានីំ ឝិឞ្យា អាគត្យ តស្មៃ កថយាញ្ចក្រុះ, ឯតាំ កថាំ ឝ្រុត្វា ផិរូឝិនោ វ្យរជ្យន្ត, តត៑ កិំ ភវតា ជ្ញាយតេ?</para>
  <para style="p">
    <verse number="13" style="v"/>ស ប្រត្យវទត៑, មម ស្វគ៌ស្ថះ បិតា យំ កញ្ចិទង្កុរំ នារោបយត៑, ស ឧត្បាវ្ទ្យតេ។</para>
  <para style="p">
    <verse number="14" style="v"/>តេ តិឞ្ឋន្តុ, តេ អន្ធមនុជានាម៑ អន្ធមាគ៌ទឝ៌កា ឯវ; យទ្យន្ធោៜន្ធំ បន្ថានំ ទឝ៌យតិ, តហ៌្យុភៅ គត៌្តេ បតតះ។</para>
  <para style="p">
    <verse number="15" style="v"/>តទា បិតរស្តំ ប្រត្យវទត៑, ទ្ឫឞ្ដាន្តមិមមស្មាន៑ ពោធយតុ។</para>
  <para style="p">
    <verse number="16" style="v"/>យីឝុនា ប្រោក្តំ, យូយមទ្យ យាវត៑ កិមពោធាះ ស្ថ?</para>
  <para style="p">
    <verse number="17" style="v"/>កថាមិមាំ កិំ ន ពុធ្យធ្ពេ ? យទាស្យំ ប្រេវិឝតិ, តទ៑ ឧទរេ បតន៑ ពហិន៌ិយ៌ាតិ,</para>
  <para style="p">
    <verse number="18" style="v"/>កិន្ត្វាស្យាទ៑ យន្និយ៌ាតិ, តទ៑ អន្តះករណាត៑ និយ៌ាតត្វាត៑ មនុជមមេធ្យំ ករោតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>យតោៜន្តះករណាត៑ កុចិន្តា ពធះ បារទារិកតា វេឝ្យាគមនំ ចៃយ៌្យំ មិថ្យាសាក្ឞ្យម៑ ឦឝ្វរនិន្ទា ចៃតានិ សវ៌្វាណិ និយ៌្យាន្តិ។</para>
  <para style="p">
    <verse number="20" style="v"/>ឯតានិ មនុឞ្យមបវិត្រី កុវ៌្វន្តិ កិន្ត្វប្រក្ឞាលិតករេណ ភោជនំ មនុជមមេធ្យំ ន ករោតិ។</para>
  <para style="p">
    <verse number="21" style="v"/>អនន្តរំ យីឝុស្តស្មាត៑ ស្ថានាត៑ ប្រស្ថាយ សោរសីទោន្នគរយោះ សីមាមុបតស្យៅ។</para>
  <para style="p">
    <verse number="22" style="v"/>តទា តត្សីមាតះ កាចិត៑ កិនានីយា យោឞិទ៑ អាគត្យ តមុច្ចៃរុវាច, ហេ ប្រភោ ទាយូទះ សន្តាន, មមៃកា ទុហិតាស្តេ សា ភូតគ្រស្តា សតី មហាក្លេឝំ ប្រាប្នោតិ មម ទយស្វ។</para>
  <para style="p">
    <verse number="23" style="v"/>កិន្តុ យីឝុស្តាំ កិមបិ នោក្តវាន៑, តតះ ឝិឞ្យា អាគត្យ តំ និវេទយាមាសុះ, ឯឞា យោឞិទ៑ អស្មាកំ បឝ្ចាទ៑ ឧច្ចៃរាហូយាគច្ឆតិ, ឯនាំ វិស្ឫជតុ។</para>
  <para style="p">
    <verse number="24" style="v"/>តទា ស ប្រត្យវទត៑, ឥស្រាយេល្គោត្រស្យ ហារិតមេឞាន៑ វិនា កស្យាប្យន្យស្យ សមីបំ នាហំ ប្រេឞិតោស្មិ។</para>
  <para style="p">
    <verse number="25" style="v"/>តតះ សា នារីសមាគត្យ តំ ប្រណម្យ ជគាទ, ហេ ប្រភោ មាមុបកុរុ។</para>
  <para style="p">
    <verse number="26" style="v"/>ស ឧក្តវាន៑, ពាលកានាំ ភក្ឞ្យមាទាយ សារមេយេភ្យោ ទានំ នោចិតំ។</para>
  <para style="p">
    <verse number="27" style="v"/>តទា សា ពភាឞេ, ហេ ប្រភោ, តត៑ សត្យំ, តថាបិ ប្រភោ រ្ភញ្ចាទ៑ យទុច្ឆិឞ្ដំ បតតិ, តត៑ សារមេយាះ ខាទន្តិ។</para>
  <para style="p">
    <verse number="28" style="v"/>តតោ យីឝុះ ប្រត្យវទត៑, ហេ យោឞិត៑, តវ វិឝ្វាសោ មហាន៑ តស្មាត៑ តវ មនោភិលឞិតំ សិទ្យ្យតុ, តេន តស្យាះ កន្យា តស្មិន្នេវ ទណ្ឌេ និរាមយាភវត៑។</para>
  <para style="p">
    <verse number="29" style="v"/>អនន្តរំ យីឝស្តស្មាត៑ ស្ថានាត៑ ប្រស្ថាយ គាលីល្សាគរស្យ សន្និធិមាគត្យ ធរាធរមារុហ្យ តត្រោបវិវេឝ។</para>
  <para style="p">
    <verse number="30" style="v"/>បឝ្ចាត៑ ជននិវហោ ពហូន៑ ខញ្ចាន្ធមូកឝុឞ្កករមានុឞាន៑ អាទាយ យីឝោះ សមីបមាគត្យ តច្ចរណាន្តិកេ ស្ថាបយាមាសុះ, តតះ សា តាន៑ និរាមយាន៑ អករោត៑។</para>
  <para style="p">
    <verse number="31" style="v"/>ឥត្ថំ មូកា វាក្យំ វទន្តិ, ឝុឞ្កករាះ ស្វាស្ថ្យមាយាន្តិ, បង្គវោ គច្ឆន្តិ, អន្ធា វីក្ឞន្តេ, ឥតិ វិលោក្យ លោកា វិស្មយំ មន្យមានា ឥស្រាយេល ឦឝ្វរំ ធន្យំ ពភាឞិរេ។</para>
  <para style="p">
    <verse number="32" style="v"/>តទានីំ យីឝុះ ស្វឝិឞ្យាន៑ អាហូយ គទិតវាន៑, ឯតជ្ជននិវហេឞុ មម ទយា ជាយតេ, ឯតេ ទិនត្រយំ មយា សាកំ សន្តិ, ឯឞាំ ភក្ឞ្យវស្តុ ច កញ្ចិទបិ នាស្តិ, តស្មាទហមេតានក្ឫតាហារាន៑ ន វិស្រក្ឞ្យាមិ, តថាត្វេ វត៌្មមធ្យេ ក្លាម្យេឞុះ។</para>
  <para style="p">
    <verse number="33" style="v"/>តទា ឝិឞ្យា ឩចុះ, ឯតស្មិន៑ ប្រាន្តរមធ្យ ឯតាវតោ មត៌្យាន៑ តប៌យិតុំ វយំ កុត្រ បូបាន៑ ប្រាប្ស្យាមះ?</para>
  <para style="p">
    <verse number="34" style="v"/>យីឝុរប្ឫច្ឆត៑, យុឞ្មាកំ និកដេ កតិ បូបា អាសតេ? ត ឩចុះ, សប្តបូបា អល្បាះ ក្ឞុទ្រមីនាឝ្ច សន្តិ។</para>
  <para style="p">
    <verse number="35" style="v"/>តទានីំ ស លោកនិវហំ ភូមាវុបវេឞ្ដុម៑ អាទិឝ្យ</para>
  <para style="p">
    <verse number="36" style="v"/>តាន៑ សប្តបូបាន៑ មីនាំឝ្ច គ្ឫហ្លន៑ ឦឝ្វរីយគុណាន៑ អនូទ្យ ភំក្ត្វា ឝិឞ្យេភ្យោ ទទៅ, ឝិឞ្យា លោកេភ្យោ ទទុះ។</para>
  <para style="p">
    <verse number="37" style="v"/>តតះ សវ៌្វេ ភុក្ត្វា ត្ឫប្តវន្តះ; តទវឝិឞ្ដភក្ឞ្យេណ សប្តឌលកាន៑ បរិបូយ៌្យ សំជគ្ឫហុះ។</para>
  <para style="p">
    <verse number="38" style="v"/>តេ ភោក្តារោ យោឞិតោ ពាលកាំឝ្ច វិហាយ ប្រាយេណ ចតុះសហស្រាណិ បុរុឞា អាសន៑។</para>
  <para style="p">
    <verse number="39" style="v"/>តតះ បរំ ស ជននិវហំ វិស្ឫជ្យ តរិមារុហ្យ មគ្ទលាប្រទេឝំ គតវាន៑។</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តទានីំ ផិរូឝិនះ សិទូកិនឝ្ចាគត្យ តំ បរីក្ឞិតុំ នភមីយំ កិញ្ចន លក្ឞ្ម ទឝ៌យិតុំ តស្មៃ និវេទយាមាសុះ។</para>
  <para style="p">
    <verse number="2" style="v"/>តតះ ស ឧក្តវាន៑, សន្ធ្យាយាំ នភសោ រក្តត្វាទ៑ យូយំ វទថ, ឝ្វោ និម៌្មលំ ទិនំ ភវិឞ្យតិ;</para>
  <para style="p">
    <verse number="3" style="v"/>ប្រាតះកាលេ ច នភសោ រក្តត្វាត៑ មលិនត្វាញ្ច វទថ, ឈញ្ភ្ឝទ្យ ភវិឞ្យតិ។ ហេ កបដិនោ យទិ យូយម៑ អន្តរីក្ឞស្យ លក្ឞ្ម ពោទ្ធុំ ឝក្នុថ, តហ៌ិ កាលស្យៃតស្យ លក្ឞ្ម កថំ ពោទ្ធុំ ន ឝក្នុថ?</para>
  <para style="p">
    <verse number="4" style="v"/>ឯតត្កាលស្យ ទុឞ្ដោ វ្យភិចារី ច វំឝោ លក្ឞ្ម គវេឞយតិ, កិន្តុ យូនសោ ភវិឞ្យទ្វាទិនោ លក្ឞ្ម វិនាន្យត៑ កិមបិ លក្ឞ្ម តាន៑ ន ទឝ៌យិយ្យតេ។ តទានីំ ស តាន៑ វិហាយ ប្រតស្ថេ។</para>
  <para style="p">
    <verse number="5" style="v"/>អនន្តរមន្យបារគមនកាលេ តស្យ ឝិឞ្យាះ បូបមានេតុំ វិស្ម្ឫតវន្តះ។</para>
  <para style="p">
    <verse number="6" style="v"/>យីឝុស្តានវាទីត៑, យូយំ ផិរូឝិនាំ សិទូកិនាញ្ច កិណ្វំ ប្រតិ សាវធានាះ សតក៌ាឝ្ច ភវត។</para>
  <para style="p">
    <verse number="7" style="v"/>តេន តេ បរស្បរំ វិវិច្យ កថយិតុមារេភិរេ, វយំ បូបានានេតុំ វិស្ម្ឫតវន្ត ឯតត្ការណាទ៑ ឥតិ កថយតិ។</para>
  <para style="p">
    <verse number="8" style="v"/>កិន្តុ យីឝុស្តទ្វិជ្ញាយ តានវោចត៑, ហេ ស្តោកវិឝ្វាសិនោ យូយំ បូបានានយនមធិ កុតះ បរស្បរមេតទ៑ វិវិំក្យ?</para>
  <para style="p">
    <verse number="9" style="v"/>យុឞ្មាភិះ កិមទ្យាបិ ន ជ្ញាយតេ? បញ្ចភិះ បូបៃះ បញ្ចសហស្របុរុឞេឞុ ភោជិតេឞុ ភក្ឞ្យោច្ឆិឞ្ដបូណ៌ាន៑ កតិ ឌលកាន៑ សមគ្ឫហ្លីតំ;</para>
  <para style="p">
    <verse number="10" style="v"/>តថា សប្តភិះ បូបៃឝ្ចតុះសហស្របុរុឞេឞុ ភេជិតេឞុ កតិ ឌលកាន៑ សមគ្ឫហ្លីត, តត៑ កិំ យុឞ្មាភិន៌ ស្មយ៌្យតេ?</para>
  <para style="p">
    <verse number="11" style="v"/>តស្មាត៑ ផិរូឝិនាំ សិទូកិនាញ្ច កិណ្វំ ប្រតិ សាវធានាស្តិឞ្ឋត, កថាមិមាម៑ អហំ បូបានធិ នាកថយំ, ឯតទ៑ យូយំ កុតោ ន ពុធ្យធ្វេ?</para>
  <para style="p">
    <verse number="12" style="v"/>តទានីំ បូបកិណ្វំ ប្រតិ សាវធានាស្តិឞ្ឋតេតិ នោក្ត្វា ផិរូឝិនាំ សិទូកិនាញ្ច ឧបទេឝំ ប្រតិ សាវធានាស្តិឞ្ឋតេតិ កថិតវាន៑, ឥតិ តៃរពោធិ។</para>
  <para style="p">
    <verse number="13" style="v"/>អបរញ្ច យីឝុះ កៃសរិយា-ផិលិបិប្រទេឝមាគត្យ ឝិឞ្យាន៑ អប្ឫច្ឆត៑, យោៜហំ មនុជសុតះ សោៜហំ កះ? លោកៃរហំ កិមុច្យេ?</para>
  <para style="p">
    <verse number="14" style="v"/>តទានីំ តេ កថិតវន្តះ, កេចិទ៑ វទន្តិ ត្វំ មជ្ជយិតា យោហន៑, កេចិទ្វទន្តិ, ត្វម៑ ឯលិយះ, កេចិច្ច វទន្តិ, ត្វំ យិរិមិយោ វា កឝ្ចិទ៑ ភវិឞ្យទ្វាទីតិ។</para>
  <para style="p">
    <verse number="15" style="v"/>បឝ្ចាត៑ ស តាន៑ បប្រច្ឆ, យូយំ មាំ កំ វទថ? តតះ ឝិមោន៑ បិតរ ឧវាច,</para>
  <para style="p">
    <verse number="16" style="v"/>ត្វមមរេឝ្វរស្យាភិឞិក្តបុត្រះ។</para>
  <para style="p">
    <verse number="17" style="v"/>តតោ យីឝុះ កថិតវាន៑, ហេ យូនសះ បុត្រ ឝិមោន៑ ត្វំ ធន្យះ; យតះ កោបិ អនុជស្ត្វយ្យេតជ្ជ្ញានំ នោទបាទយត៑, កិន្តុ មម ស្វគ៌ស្យះ បិតោទបាទយត៑។</para>
  <para style="p">
    <verse number="18" style="v"/>អតោៜហំ ត្វាំ វទាមិ, ត្វំ បិតរះ (ប្រស្តរះ) អហញ្ច តស្យ ប្រស្តរស្យោបរិ ស្វមណ្ឌលីំ និម៌្មាស្យាមិ, តេន និរយោ ពលាត៑ តាំ បរាជេតុំ ន ឝក្ឞ្យតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>អហំ តុភ្យំ ស្វគ៌ីយរាជ្យស្យ កុញ្ជិកាំ ទាស្យាមិ, តេន យត៑ កិញ្ចន ត្វំ ប្ឫថិវ្យាំ ភំត្ស្យសិ តត្ស្វគ៌េ ភំត្ស្យតេ, យច្ច កិញ្ចន មហ្យាំ មោក្ឞ្យសិ តត៑ ស្វគ៌េ មោក្ឞ្យតេ។</para>
  <para style="p">
    <verse number="20" style="v"/>បឝ្ចាត៑ ស ឝិឞ្យានាទិឝត៑, អហមភិឞិក្តោ យីឝុរិតិ កថាំ កស្មៃចិទបិ យូយំ មា កថយត។</para>
  <para style="p">
    <verse number="21" style="v"/>អន្យញ្ច យិរូឝាលម្នគរំ គត្វា ប្រាចីនលោកេភ្យះ ប្រធានយាជកេភ្យ ឧបាធ្យាយេភ្យឝ្ច ពហុទុះខភោគស្តៃ រ្ហតត្វំ ត្ឫតីយទិនេ បុនរុត្ថានញ្ច មមាវឝ្យកម៑ ឯតាះ កថា យីឝុស្តត្កាលមារភ្យ ឝិឞ្យាន៑ ជ្ញាបយិតុម៑ អារព្ធវាន៑។</para>
  <para style="p">
    <verse number="22" style="v"/>តទានីំ បិតរស្តស្យ ករំ ឃ្ឫត្វា តជ៌យិត្វា កថយិតុមារព្ធវាន៑, ហេ ប្រភោ, តត៑ ត្វត្តោ ទូរំ យាតុ, ត្វាំ ប្រតិ កទាបិ ន ឃដិឞ្យតេ។</para>
  <para style="p">
    <verse number="23" style="v"/>កិន្តុ ស វទនំ បរាវត៌្យ បិតរំ ជគាទ, ហេ វិឃ្នការិន៑, មត្សម្មុខាទ៑ ទូរីភវ, ត្វំ មាំ ពាធសេ, ឦឝ្វរីយកាយ៌្យាត៑ មានុឞីយកាយ៌្យំ តុភ្យំ រោចតេ។</para>
  <para style="p">
    <verse number="24" style="v"/>អនន្តរំ យីឝុះ ស្វីយឝិឞ្យាន៑ ឧក្តវាន៑ យះ កឝ្ចិត៑ មម បឝ្ចាទ្គាមី ភវិតុម៑ ឥច្ឆតិ, ស ស្វំ ទាម្យតុ, តថា ស្វក្រុឝំ គ្ឫហ្លន៑ មត្បឝ្ចាទាយាតុ។</para>
  <para style="p">
    <verse number="25" style="v"/>យតោ យះ ប្រាណាន៑ រក្ឞិតុមិច្ឆតិ, ស តាន៑ ហារយិឞ្យតិ, កិន្តុ យោ មទត៌្ហំ និជប្រាណាន៑ ហារយតិ, ស តាន៑ ប្រាប្ស្យតិ។</para>
  <para style="p">
    <verse number="26" style="v"/>មានុឞោ យទិ សវ៌្វំ ជគត៑ លភតេ និជប្រណាន៑ ហារយតិ, តហ៌ិ តស្យ កោ លាភះ? មនុជោ និជប្រាណានាំ វិនិមយេន វា កិំ ទាតុំ ឝក្នោតិ?</para>
  <para style="p">
    <verse number="27" style="v"/>មនុជសុតះ ស្វទូតៃះ សាកំ បិតុះ ប្រភាវេណាគមិឞ្យតិ; តទា ប្រតិមនុជំ ស្វស្វកម៌្មានុសារាត៑ ផលំ ទាស្យតិ។</para>
  <para style="p">
    <verse number="28" style="v"/>អហំ យុឞ្មាន៑ តថ្យំ វច្មិ, សរាជ្យំ មនុជសុតម៑ អាគតំ ន បឝ្យន្តោ ម្ឫត្យុំ ន ស្វាទិឞ្យន្តិ, ឯតាទ្ឫឝាះ កតិបយជនា អត្រាបិ ទណ្ឌាយមានាះ សន្តិ។</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ ឞឌ្ទិនេភ្យះ បរំ យីឝុះ បិតរំ យាកូពំ តត្សហជំ យោហនញ្ច គ្ឫហ្លន៑ ឧច្ចាទ្រេ រ្វិវិក្តស្ថានម៑ អាគត្យ តេឞាំ សមក្ឞំ រូបមន្យត៑ ទធារ។</para>
  <para style="p">
    <verse number="2" style="v"/>តេន តទាស្យំ តេជស្វិ, តទាភរណម៑ អាលោកវត៑ បាណ្ឌរមភវត៑។</para>
  <para style="p">
    <verse number="3" style="v"/>អន្យច្ច តេន សាកំ សំលបន្តៅ មូសា ឯលិយឝ្ច តេភ្យោ ទឝ៌នំ ទទតុះ។</para>
  <para style="p">
    <verse number="4" style="v"/>តទានីំ បិតរោ យីឝុំ ជគាទ, ហេ ប្រភោ ស្ថិតិរត្រាស្មាកំ ឝុភា, យទិ ភវតានុមន្យតេ, តហ៌ិ ភវទត៌្ហមេកំ មូសាត៌្ហមេកម៑ ឯលិយាត៌្ហញ្ចៃកម៑ ឥតិ ត្រីណិ ទូឞ្យាណិ និម៌្មម។</para>
  <para style="p">
    <verse number="5" style="v"/>ឯតត្កថនកាល ឯក ឧជ្ជវលះ បយោទស្តេឞាមុបរិ ឆាយាំ ក្ឫតវាន៑, វារិទាទ៑ ឯឞា នភសីយា វាគ៑ ពភូវ, មមាយំ ប្រិយះ បុត្រះ, អស្មិន៑ មម មហាសន្តោឞ ឯតស្យ វាក្យំ យូយំ និឝាមយត។</para>
  <para style="p">
    <verse number="6" style="v"/>កិន្តុ វាចមេតាំ ឝ្ឫណ្វន្តឯវ ឝិឞ្យា ម្ឫឝំ ឝង្កមានា ន្យុព្ជា ន្យបតន៑។</para>
  <para style="p">
    <verse number="7" style="v"/>តទា យីឝុរាគត្យ តេឞាំ គាត្រាណិ ស្ប្ឫឝន៑ ឧវាច, ឧត្តិឞ្ឋត, មា ភៃឞ្ដ។</para>
  <para style="p">
    <verse number="8" style="v"/>តទានីំ នេត្រាណ្យុន្មីល្យ យីឝុំ វិនា កមបិ ន ទទ្ឫឝុះ។</para>
  <para style="p">
    <verse number="9" style="v"/>តតះ បរម៑ អទ្រេរវរោហណកាលេ យីឝុស្តាន៑ ឥត្យាទិទេឝ, មនុជសុតស្យ ម្ឫតានាំ មធ្យាទុត្ថានំ យាវន្ន ជាយតេ, តាវត៑ យុឞ្មាភិរេតទ្ទឝ៌នំ កស្មៃចិទបិ ន កថយិតវ្យំ។</para>
  <para style="p">
    <verse number="10" style="v"/>តទា ឝិឞ្យាស្តំ បប្រច្ឆុះ, ប្រថមម៑ ឯលិយ អាយាស្យតីតិ កុត ឧបាធ្យាយៃរុច្យតេ?</para>
  <para style="p">
    <verse number="11" style="v"/>តតោ យីឝុះ ប្រត្យវាទីត៑, ឯលិយះ ប្រាគេត្យ សវ៌្វាណិ សាធយិឞ្យតីតិ សត្យំ,</para>
  <para style="p">
    <verse number="12" style="v"/>កិន្ត្វហំ យុឞ្មាន៑ វច្មិ, ឯលិយ ឯត្យ គតះ, តេ តមបរិចិត្យ តស្មិន៑ យថេច្ឆំ វ្យវជហុះ; មនុជសុតេនាបិ តេឞាមន្តិកេ តាទ្ឫគ៑ ទុះខំ ភោក្តវ្យំ។</para>
  <para style="p">
    <verse number="13" style="v"/>តទានីំ ស មជ្ជយិតារំ យោហនមធិ កថាមេតាំ វ្យាហ្ឫតវាន៑, ឥត្ថំ តច្ឆិឞ្យា ពុពុធិរេ។</para>
  <para style="p">
    <verse number="14" style="v"/>បឝ្ចាត៑ តេឞុ ជននិវហស្យាន្តិកមាគតេឞុ កឝ្ចិត៑ មនុជស្តទន្តិកមេត្យ ជានូនី បាតយិត្វា កថិតវាន៑,</para>
  <para style="p">
    <verse number="15" style="v"/>ហេ ប្រភោ, មត្បុត្រំ ប្រតិ ក្ឫបាំ វិទធាតុ, សោបស្មារាមយេន ភ្ឫឝំ វ្យថិតះ សន៑ បុនះ បុន រ្វហ្នៅ មុហុ រ្ជលមធ្យេ បតតិ។</para>
  <para style="p">
    <verse number="16" style="v"/>តស្មាទ៑ ភវតះ ឝិឞ្យាណាំ សមីបេ តមានយំ កិន្តុ តេ តំ ស្វាស្ថំ កត៌្តុំ ន ឝក្តាះ។</para>
  <para style="p">
    <verse number="17" style="v"/>តទា យីឝុះ កថិតវាន៑ រេ អវិឝ្វាសិនះ, រេ វិបថគាមិនះ, បុនះ កតិកាលាន៑ អហំ យុឞ្មាកំ សន្និធៅ ស្ថាស្យាមិ? កតិកាលាន៑ វា យុឞ្មាន៑ សហិឞ្យេ? តមត្រ មមាន្តិកមានយត។</para>
  <para style="p">
    <verse number="18" style="v"/>បឝ្ចាទ៑ យីឝុនា តជ៌តឯវ ស ភូតស្តំ វិហាយ គតវាន៑, តទ្ទណ្ឌឯវ ស ពាលកោ និរាមយោៜភូត៑។</para>
  <para style="p">
    <verse number="19" style="v"/>តតះ ឝិឞ្យា គុប្តំ យីឝុមុបាគត្យ ពភាឞិរេ, កុតោ វយំ តំ ភូតំ ត្យាជយិតុំ ន ឝក្តាះ?</para>
  <para style="p">
    <verse number="20" style="v"/>យីឝុនា តេ ប្រោក្តាះ, យុឞ្មាកមប្រត្យយាត៑;</para>
  <para style="p">
    <verse number="21" style="v"/>យុឞ្មានហំ តថ្យំ វច្មិ យទិ យុឞ្មាកំ សឞ៌បៃកមាត្រោបិ វិឝ្វាសោ ជាយតេ, តហ៌ិ យុឞ្មាភិរស្មិន៑ ឝៃលេ ត្វមិតះ ស្ថានាត៑ តត៑ ស្ថានំ យាហីតិ ព្រូតេ ស តទៃវ ចលិឞ្យតិ, យុឞ្មាកំ កិមប្យសាធ្យញ្ច កម៌្ម ន ស្ថាស្យាតិ។ កិន្តុ ប្រាត៌្ហនោបវាសៅ វិនៃតាទ្ឫឝោ ភូតោ ន ត្យាជ្យេត។</para>
  <para style="p">
    <verse number="22" style="v"/>អបរំ តេឞាំ គាលីល្ប្រទេឝេ ភ្រមណកាលេ យីឝុនា តេ គទិតាះ, មនុជសុតោ ជនានាំ ករេឞុ សមប៌យិឞ្យតេ តៃ រ្ហនិឞ្យតេ ច,</para>
  <para style="p">
    <verse number="23" style="v"/>កិន្តុ ត្ឫតីយេៜហិ्ន ម ឧត្ថាបិឞ្យតេ, តេន តេ ភ្ឫឝំ ទុះខិតា ពភូវះ។</para>
  <para style="p">
    <verse number="24" style="v"/>តទនន្តរំ តេឞុ កផន៌ាហូម្នគរមាគតេឞុ ករសំគ្រាហិណះ បិតរាន្តិកមាគត្យ បប្រច្ឆុះ, យុឞ្មាកំ គុរុះ កិំ មន្ទិរាត៌្ហំ ករំ ន ទទាតិ? តតះ បិតរះ កថិតវាន៑ ទទាតិ។</para>
  <para style="p">
    <verse number="25" style="v"/>តតស្តស្មិន៑ គ្ឫហមធ្យមាគតេ តស្យ កថាកថនាត៑ បូវ៌្វមេវ យីឝុរុវាច, ហេ ឝិមោន៑, មេទិន្យា រាជានះ ស្វស្វាបត្យេភ្យះ កិំ វិទេឝិភ្យះ កេភ្យះ ករំ គ្ឫហ្លន្តិ? អត្រ ត្វំ កិំ ពុធ្យសេ? តតះ បិតរ ឧក្តវាន៑, វិទេឝិភ្យះ។</para>
  <para style="p">
    <verse number="26" style="v"/>តទា យីឝុរុក្តវាន៑, តហ៌ិ សន្តានា មុក្តាះ សន្តិ។</para>
  <para style="p">
    <verse number="27" style="v"/>តថាបិ យថាស្មាភិស្តេឞាមន្តរាយោ ន ជន្យតេ, តត្ក្ឫតេ ជលធេស្តីរំ គត្វា វឌិឝំ ក្ឞិប, តេនាទៅ យោ មីន ឧត្ថាស្យតិ, តំ ឃ្ឫត្វា តន្មុខេ មោចិតេ តោលកៃកំ រូប្យំ ប្រាប្ស្យសិ, តទ៑ គ្ឫហីត្វា តវ មម ច ក្ឫតេ តេភ្យោ ទេហិ។</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តទានីំ ឝិឞ្យា យីឝោះ សមីបមាគត្យ ប្ឫឞ្ដវន្តះ ស្វគ៌រាជ្យេ កះ ឝ្រេឞ្ឋះ?</para>
  <para style="p">
    <verse number="2" style="v"/>តតោ យីឝុះ ក្ឞុទ្រមេកំ ពាលកំ ស្វសមីបមានីយ តេឞាំ មធ្យេ និធាយ ជគាទ,</para>
  <para style="p">
    <verse number="3" style="v"/>យុឞ្មានហំ សត្យំ ព្រវីមិ, យូយំ មនោវិនិមយេន ក្ឞុទ្រពាលវត៑ ន សន្តះ ស្វគ៌រាជ្យំ ប្រវេឞ្ដុំ ន ឝក្នុថ។</para>
  <para style="p">
    <verse number="4" style="v"/>យះ កឝ្ចិទ៑ ឯតស្យ ក្ឞុទ្រពាលកស្យ សមមាត្មានំ នម្រីករោតិ, សឯវ ស្វគ៌រាជយេ ឝ្រេឞ្ឋះ។</para>
  <para style="p">
    <verse number="5" style="v"/>យះ កឝ្ចិទ៑ ឯតាទ្ឫឝំ ក្ឞុទ្រពាលកមេកំ មម នាម្និ គ្ឫហ្លាតិ, ស មាមេវ គ្ឫហ្លាតិ។</para>
  <para style="p">
    <verse number="6" style="v"/>កិន្តុ យោ ជនោ មយិ ក្ឫតវិឝ្វាសានាមេតេឞាំ ក្ឞុទ្រប្រាណិនាម៑ ឯកស្យាបិ វិធ្និំ ជនយតិ, កណ្ឋពទ្ធបេឞណីកស្យ តស្យ សាគរាគាធជលេ មជ្ជនំ ឝ្រេយះ។</para>
  <para style="p">
    <verse number="7" style="v"/>វិឃ្នាត៑ ជគតះ សន្តាបោ ភវិឞ្យតិ, វិឃ្នោៜវឝ្យំ ជនយិឞ្យតេ, កិន្តុ យេន មនុជេន វិឃ្នោ ជនិឞ្យតេ តស្យៃវ សន្តាបោ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="8" style="v"/>តស្មាត៑ តវ ករឝ្ចរណោ វា យទិ ត្វាំ ពាធតេ, តហ៌ិ តំ ឆិត្ត្វា និក្ឞិប, ទ្វិករស្យ ទ្វិបទស្យ វា តវានប្តវហ្នៅ និក្ឞេបាត៑, ខញ្ជស្យ វា ឆិន្នហស្តស្យ តវ ជីវនេ ប្រវេឝោ វរំ។</para>
  <para style="p">
    <verse number="9" style="v"/>អបរំ តវ នេត្រំ យទិ ត្វាំ ពាធតេ, តហ៌ិ តទប្យុត្បាវ្យ និក្ឞិប, ទ្វិនេត្រស្យ នរកាគ្នៅ និក្ឞេបាត៑ កាណស្យ តវ ជីវនេ ប្រវេឝោ វរំ។</para>
  <para style="p">
    <verse number="10" style="v"/>តស្មាទវធទ្ធំ, ឯតេឞាំ ក្ឞុទ្រប្រាណិនាម៑ ឯកមបិ មា តុច្ឆីកុរុត,</para>
  <para style="p">
    <verse number="11" style="v"/>យតោ យុឞ្មានហំ តថ្យំ ព្រវីមិ, ស្វគ៌េ តេឞាំ ទូតា មម ស្វគ៌ស្ថស្យ បិតុរាស្យំ និត្យំ បឝ្យន្តិ។ ឯវំ យេ យេ ហារិតាស្តាន៑ រក្ឞិតុំ មនុជបុត្រ អាគច្ឆត៑។</para>
  <para style="p">
    <verse number="12" style="v"/>យូយមត្រ កិំ វិវិំគ្ឃ្វេ? កស្យចិទ៑ យទិ ឝតំ មេឞាះ សន្តិ, តេឞាមេកោ ហាយ៌្យតេ ច, តហ៌ិ ស ឯកោនឝតំ មេឞាន៑ វិហាយ បវ៌្វតំ គត្វា តំ ហារិតមេកំ កិំ ន ម្ឫគយតេ?</para>
  <para style="p">
    <verse number="13" style="v"/>យទិ ច កទាចិត៑ តន្មេឞោទ្ទេឝំ លមតេ, តហ៌ិ យុឞ្មានហំ សត្យំ កថយាមិ, សោៜវិបថគាមិភ្យ ឯកោនឝតមេឞេភ្យោបិ តទេកហេតោរធិកម៑ អាហ្លាទតេ។</para>
  <para style="p">
    <verse number="14" style="v"/>តទ្វទ៑ ឯតេឞាំ ក្ឞុទ្រប្រាឯिនាម៑ ឯកោបិ នឝ្យតីតិ យុឞ្មាកំ ស្វគ៌ស្ថបិតុ រ្នាភិមតម៑។</para>
  <para style="p">
    <verse number="15" style="v"/>យទ្យបិ តវ ភ្រាតា ត្វយិ កិមប្យបរាធ្យតិ, តហ៌ិ គត្វា យុវយោទ៌្វយោះ ស្ថិតយោស្តស្យាបរាធំ តំ ជ្ញាបយ។ តត្រ ស យទិ តវ វាក្យំ ឝ្ឫណោតិ, តហ៌ិ ត្វំ ស្វភ្រាតរំ ប្រាប្តវាន៑,</para>
  <para style="p">
    <verse number="16" style="v"/>កិន្តុ យទិ ន ឝ្ឫណោតិ, តហ៌ិ ទ្វាភ្យាំ ត្រិភិ រ្វា សាក្ឞីភិះ សវ៌្វំ វាក្យំ យថា និឝ្ចិតំ ជាយតេ, តទត៌្ហម៑ ឯកំ ទ្វៅ វា សាក្ឞិណៅ គ្ឫហីត្វា យាហិ។</para>
  <para style="p">
    <verse number="17" style="v"/>តេន ស យទិ តយោ រ្វាក្យំ ន មាន្យតេ, តហ៌ិ សមាជំ តជ្ជ្ញាបយ, កិន្តុ យទិ សមាជស្យាបិ វាក្យំ ន មាន្យតេ,តហ៌ិ ស តវ សមីបេ ទេវបូជកឥវ ចណ្ឌាលឥវ ច ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="18" style="v"/>អហំ យុឞ្មាន៑ សត្យំ វទាមិ, យុឞ្មាភិះ ប្ឫថិវ្យាំ យទ៑ ពធ្យតេ តត៑ ស្វគ៌េ ភំត្ស្យតេ; មេទិន្យាំ យត៑ ភោច្យតេ, ស្វគ៌េៜបិ តត៑ មោក្ឞ្យតេ។</para>
  <para style="p">
    <verse number="19" style="v"/>បុនរហំ យុឞ្មាន៑ វទាមិ, មេទិន្យាំ យុឞ្មាកំ យទិ ទ្វាវេកវាក្យីភូយ កិញ្ចិត៑ ប្រាត៌្ហយេតេ, តហ៌ិ មម ស្វគ៌ស្ថបិត្រា តត៑ តយោះ ក្ឫតេ សម្បន្នំ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="20" style="v"/>យតោ យត្រ ទ្វៅ ត្រយោ វា មម នាន្និ មិលន្តិ, តត្រៃវាហំ តេឞាំ មធ្យេៜស្មិ។</para>
  <para style="p">
    <verse number="21" style="v"/>តទានីំ បិតរស្តត្សមីបមាគត្យ កថិតវាន៑ ហេ ប្រភោ, មម ភ្រាតា មម យទ្យបរាធ្យតិ, តហ៌ិ តំ កតិក្ឫត្វះ ក្ឞមិឞ្យេ?</para>
  <para style="p">
    <verse number="22" style="v"/>កិំ សប្តក្ឫត្វះ? យីឝុស្តំ ជគាទ, ត្វាំ កេវលំ សប្តក្ឫត្វោ យាវត៑ ន វទាមិ, កិន្តុ សប្តត្យា គុណិតំ សប្តក្ឫត្វោ យាវត៑។</para>
  <para style="p">
    <verse number="23" style="v"/>អបរំ និជទាសៃះ សហ ជិគណយិឞុះ កឝ្ចិទ៑ រាជេវ ស្វគ៌រាជយំ។</para>
  <para style="p">
    <verse number="24" style="v"/>អារព្ធេ តស្មិន៑ គណនេ សាទ៌្ធសហស្រមុទ្រាបូរិតានាំ ទឝសហស្របុដកានាម៑ ឯកោៜឃមណ៌ស្តត្សមក្ឞមានាយិ។</para>
  <para style="p">
    <verse number="25" style="v"/>តស្យ បរិឝោធនាយ ទ្រវ្យាភាវាត៑ បរិឝោធនាត៌្ហំ ស តទីយភាយ៌្យាបុត្រាទិសវ៌្វស្វញ្ច វិក្រីយតាមិតិ តត្ប្រភុរាទិទេឝ។</para>
  <para style="p">
    <verse number="26" style="v"/>តេន ស ទាសស្តស្យ បាទយោះ បតន៑ ប្រណម្យ កថិតវាន៑ , ហេ ប្រភោ ភវតា ឃៃយ៌្យេ ក្ឫតេ មយា សវ៌្វំ បរិឝោធិឞ្យតេ។</para>
  <para style="p">
    <verse number="27" style="v"/>តទានីំ ទាសស្យ ប្រភុះ សករុណះ សន៑ សកលណ៌ំ ក្ឞមិត្វា តំ តត្យាជ។</para>
  <para style="p">
    <verse number="28" style="v"/>កិន្តុ តស្មិន៑ ទាសេ ពហិ រ្យាតេ, តស្យ ឝតំ មុទ្រាចតុត៌្ហាំឝាន៑ យោ ធារយតិ, តំ សហទាសំ ទ្ឫឞ្ទ្វា តស្យ កណ្ឋំ និឞ្បីឌ្យ គទិតវាន៑, មម យត៑ ប្រាប្យំ តត៑ បរិឝោធយ។</para>
  <para style="p">
    <verse number="29" style="v"/>តទា តស្យ សហទាសស្តត្បាទយោះ បតិត្វា វិនីយ ពភាឞេ, ត្វយា ធៃយ៌្យេ ក្ឫតេ មយា សវ៌្វំ បរិឝោធិឞ្យតេ។</para>
  <para style="p">
    <verse number="30" style="v"/>តថាបិ ស តត៑ នាងគីក្ឫត្យ យាវត៑ សវ៌្វម្ឫណំ ន បរិឝោធិតវាន៑ តាវត៑ តំ ការាយាំ ស្ថាបយាមាស។</para>
  <para style="p">
    <verse number="31" style="v"/>តទា តស្យ សហទាសាស្តស្យៃតាទ្ឫគ៑ អាចរណំ វិលោក្យ ប្រភោះ សមីបំ គត្វា សវ៌្វំ វ្ឫត្តាន្តំ និវេទយាមាសុះ។</para>
  <para style="p">
    <verse number="32" style="v"/>តទា តស្យ ប្រភុស្តមាហូយ ជគាទ, រេ ទុឞ្ដ ទាស, ត្វយា មត្សន្និធៅ ប្រាត៌្ហិតេ មយា តវ សវ៌្វម្ឫណំ ត្យក្តំ;</para>
  <para style="p">
    <verse number="33" style="v"/>យថា ចាហំ ត្វយិ ករុណាំ ក្ឫតវាន៑, តថៃវ ត្វត្សហទាសេ ករុណាករណំ កិំ តវ នោចិតំ?</para>
  <para style="p">
    <verse number="34" style="v"/>ឥតិ កថយិត្វា តស្យ ប្រភុះ ក្រុទ្ធ្យន៑ និជប្រាប្យំ យាវត៑ ស ន បរិឝោធិតវាន៑, តាវត៑ ប្រហារកានាំ ករេឞុ តំ សមប៌ិតវាន៑។</para>
  <para style="p">
    <verse number="35" style="v"/>យទិ យូយំ ស្វាន្តះករណៃះ ស្វស្វសហជានាម៑ អបរាធាន៑ ន ក្ឞមធ្វេ, តហ៌ិ មម ស្វគ៌ស្យះ បិតាបិ យុឞ្មាន៑ ប្រតីត្ថំ ករិឞ្យតិ។</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរម៑ ឯតាសុ កថាសុ សមាប្តាសុ យីឝុ រ្គាលីលប្រទេឝាត៑ ប្រស្ថាយ យទ៌ន្តីរស្ថំ យិហូទាប្រទេឝំ ប្រាប្តះ។</para>
  <para style="p">
    <verse number="2" style="v"/>តទា តត្បឝ្ចាត៑ ជននិវហេ គតេ ស តត្រ តាន៑ និរាមយាន៑ អករោត៑។</para>
  <para style="p">
    <verse number="3" style="v"/>តទនន្តរំ ផិរូឝិនស្តត្សមីបមាគត្យ បារីក្ឞិតុំ តំ បប្រច្ឆុះ, កស្មាទបិ ការណាត៑ នរេណ ស្វជាយា បរិត្យាជ្យា ន វា?</para>
  <para style="p">
    <verse number="4" style="v"/>ស ប្រត្យុវាច, ប្រថមម៑ ឦឝ្វរោ នរត្វេន នារីត្វេន ច មនុជាន៑ សសជ៌, តស្មាត៑ កថិតវាន៑,</para>
  <para style="p">
    <verse number="5" style="v"/>មានុឞះ ស្វបិតរៅ បរិត្យជ្យ ស្វបត្ន្យាម៑ អាសក្ឞ្យតេ, តៅ ទ្វៅ ជនាវេកាង្គៅ ភវិឞ្យតះ, កិមេតទ៑ យុឞ្មាភិ រ្ន បឋិតម៑?</para>
  <para style="p">
    <verse number="6" style="v"/>អតស្តៅ បុន រ្ន ទ្វៅ តយោរេកាង្គត្វំ ជាតំ, ឦឝ្វរេណ យច្ច សមយុជ្យត, មនុជោ ន តទ៑ ភិន្ទ្យាត៑។</para>
  <para style="p">
    <verse number="7" style="v"/>តទានីំ តេ តំ ប្រត្យវទន៑, តថាត្វេ ត្យាជ្យបត្រំ ទត្ត្វា ស្វាំ ស្វាំ ជាយាំ ត្យក្តុំ វ្យវស្ថាំ មូសាះ កថំ លិលេខ?</para>
  <para style="p">
    <verse number="8" style="v"/>តតះ ស កថិតវាន៑, យុឞ្មាកំ មនសាំ កាឋិន្យាទ៑ យុឞ្មាន៑ ស្វាំ ស្វាំ ជាយាំ ត្យក្តុម៑ អន្វមន្យត កិន្តុ ប្រថមាទ៑ ឯឞោ វិធិន៌ាសីត៑។</para>
  <para style="p">
    <verse number="9" style="v"/>អតោ យុឞ្មានហំ វទាមិ, វ្យភិចារំ វិនា យោ និជជាយាំ ត្យជេត៑ អន្យាញ្ច វិវហេត៑, ស បរទារាន៑ គច្ឆតិ; យឝ្ច ត្យក្តាំ នារីំ វិវហតិ សោបិ បរទារេឞុ រមតេ។</para>
  <para style="p">
    <verse number="10" style="v"/>តទា តស្យ ឝិឞ្យាស្តំ ពភាឞិរេ, យទិ ស្វជាយយា សាកំ បុំស ឯតាទ្ឫក៑ សម្ពន្ធោ ជាយតេ, តហ៌ិ វិវហនមេវ ន ភទ្រំ។</para>
  <para style="p">
    <verse number="11" style="v"/>តតះ ស ឧក្តវាន៑, យេភ្យស្តត្សាមត៌្ហ្យំ អាទាយិ, តាន៑ វិនាន្យះ កោបិ មនុជ ឯតន្មតំ គ្រហីតុំ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="12" style="v"/>កតិបយា ជននក្លីពះ កតិបយា នរក្ឫតក្លីពះ ស្វគ៌រាជ្យាយ កតិបយាះ ស្វក្ឫតក្លីពាឝ្ច សន្តិ, យេ គ្រហីតុំ ឝក្នុវន្តិ តេ គ្ឫហ្លន្តុ។</para>
  <para style="p">
    <verse number="13" style="v"/>អបរម៑ យថា ស ឝិឝូនាំ គាត្រេឞុ ហស្តំ ទត្វា ប្រាត៌្ហយតេ, តទត៌្ហំ តត្សមីំបំ ឝិឝវ អានីយន្ត, តត អានយិត្ឫន៑ ឝិឞ្យាស្តិរស្ក្ឫតវន្តះ។</para>
  <para style="p">
    <verse number="14" style="v"/>កិន្តុ យីឝុរុវាច, ឝិឝវោ មទន្តិកម៑ អាគច្ឆន្តុ, តាន៑ មា វារយត, ឯតាទ្ឫឝាំ ឝិឝូនាមេវ ស្វគ៌រាជ្យំ។</para>
  <para style="p">
    <verse number="15" style="v"/>តតះ ស តេឞាំ គាត្រេឞុ ហស្តំ ទត្វា តស្មាត៑ ស្ថានាត៑ ប្រតស្ថេ។</para>
  <para style="p">
    <verse number="16" style="v"/>អបរម៑ ឯក អាគត្យ តំ បប្រច្ឆ, ហេ បរមគុរោ, អនន្តាយុះ ប្រាប្តុំ មយា កិំ កិំ សត្កម៌្ម កត៌្តវ្យំ?</para>
  <para style="p">
    <verse number="17" style="v"/>តតះ ស ឧវាច, មាំ បរមំ កុតោ វទសិ? វិនេឝ្ចរំ ន កោបិ បរមះ, កិន្តុ យទ្យនន្តាយុះ ប្រាប្តុំ វាញ្ឆសិ, តហ៌្យាជ្ញាះ បាលយ។</para>
  <para style="p">
    <verse number="18" style="v"/>តទា ស ប្ឫឞ្ដវាន៑, កាះ កា អាជ្ញាះ? តតោ យីឝុះ កថិតវាន៑, នរំ មា ហន្យាះ, បរទារាន៑ មា គច្ឆេះ, មា ចោរយេះ, ម្ឫឞាសាក្ឞ្យំ មា ទទ្យាះ,</para>
  <para style="p">
    <verse number="19" style="v"/>និជបិតរៅ សំមន្យស្វ, ស្វសមីបវាសិនិ ស្វវត៑ ប្រេម កុរុ។</para>
  <para style="p">
    <verse number="20" style="v"/>ស យុវា កថិតវាន៑, អា ពាល្យាទ៑ ឯតាះ បាលយាមិ, ឥទានីំ កិំ ន្យូនមាស្តេ?</para>
  <para style="p">
    <verse number="21" style="v"/>តតោ យីឝុរវទត៑, យទិ សិទ្ធោ ភវិតុំ វាញ្ឆសិ, តហ៌ិ គត្វា និជសវ៌្វស្វំ វិក្រីយ ទរិទ្រេភ្យោ វិតរ, តតះ ស្វគ៌េ វិត្តំ លប្ស្យសេ; អាគច្ឆ, មត្បឝ្ចាទ្វត៌្តី ច ភវ។</para>
  <para style="p">
    <verse number="22" style="v"/>ឯតាំ វាចំ ឝ្រុត្វា ស យុវា ស្វីយពហុសម្បត្តេ រ្វិឞណះ សន៑ ចលិតវាន៑។</para>
  <para style="p">
    <verse number="23" style="v"/>តទា យីឝុះ ស្វឝិឞ្យាន៑ អវទត៑, ធនិនាំ ស្វគ៌រាជ្យប្រវេឝោ មហាទុឞ្ករ ឥតិ យុឞ្មានហំ តថ្យំ វទាមិ។</para>
  <para style="p">
    <verse number="24" style="v"/>បុនរបិ យុឞ្មានហំ វទាមិ, ធនិនាំ ស្វគ៌រាជ្យប្រវេឝាត៑ សូចីឆិទ្រេណ មហាង្គគមនំ សុករំ។</para>
  <para style="p">
    <verse number="25" style="v"/>ឥតិ វាក្យំ និឝម្យ ឝិឞ្យា អតិចមត្ក្ឫត្យ កថយាមាសុះ; តហ៌ិ កស្យ បរិត្រាណំ ភវិតុំ ឝក្នោតិ?</para>
  <para style="p">
    <verse number="26" style="v"/>តទា ស តាន៑ ទ្ឫឞ្ទ្វា កថយាមាស, តត៑ មានុឞាណាមឝក្យំ ភវតិ, កិន្ត្វីឝ្វរស្យ សវ៌្វំ ឝក្យម៑។</para>
  <para style="p">
    <verse number="27" style="v"/>តទា បិតរស្តំ គទិតវាន៑, បឝ្យ, វយំ សវ៌្វំ បរិត្យជ្យ ភវតះ បឝ្ចាទ្វត៌្តិនោ ៜភវាម; វយំ កិំ ប្រាប្ស្យាមះ?</para>
  <para style="p">
    <verse number="28" style="v"/>តតោ យីឝុះ កថិតវាន៑, យុឞ្មានហំ តថ្យំ វទាមិ, យូយំ មម បឝ្ចាទ្វត៌្តិនោ ជាតា ឥតិ ការណាត៑ នវីនស្ឫឞ្ដិកាលេ យទា មនុជសុតះ ស្វីយៃឝ្ចយ៌្យសិំហាសន ឧបវេក្ឞ្យតិ, តទា យូយមបិ ទ្វាទឝសិំហាសនេឞូបវិឝ្យ ឥស្រាយេលីយទ្វាទឝវំឝានាំ វិចារំ ករិឞ្យថ។</para>
  <para style="p">
    <verse number="29" style="v"/>អន្យច្ច យះ កឝ្ចិត៑ មម នាមការណាត៑ គ្ឫហំ វា ភ្រាតរំ វា ភគិនីំ វា បិតរំ វា មាតរំ វា ជាយាំ វា ពាលកំ វា ភូមិំ បរិត្យជតិ, ស តេឞាំ ឝតគុណំ លប្ស្យតេ, អនន្តាយុមោៜធិការិត្វញ្ច ប្រាប្ស្យតិ។</para>
  <para style="p">
    <verse number="30" style="v"/>កិន្តុ អគ្រីយា អនេកេ ជនាះ បឝ្ចាត៑, បឝ្ចាតីយាឝ្ចានេកេ លោកា អគ្រេ ភវិឞ្យន្តិ។</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ស្វគ៌រាជ្យម៑ ឯតាទ្ឫឝា កេនចិទ៑ គ្ឫហស្យេន សមំ, យោៜតិប្រភាតេ និជទ្រាក្ឞាក្ឞេត្រេ ក្ឫឞកាន៑ និយោក្តុំ គតវាន៑។</para>
  <para style="p">
    <verse number="2" style="v"/>បឝ្ចាត៑ តៃះ សាកំ ទិនៃកភ្ឫតិំ មុទ្រាចតុត៌្ហាំឝំ និរូប្យ តាន៑ ទ្រាក្ឞាក្ឞេត្រំ ប្រេរយាមាស។</para>
  <para style="p">
    <verse number="3" style="v"/>អនន្តរំ ប្រហរៃកវេលាយាំ គត្វា ហដ្ដេ កតិបយាន៑ និឞ្កម៌្មកាន៑ វិលោក្យ តានវទត៑,</para>
  <para style="p">
    <verse number="4" style="v"/>យូយមបិ មម ទ្រាក្ឞាក្ឞេត្រំ យាត, យុឞ្មភ្យមហំ យោគ្យភ្ឫតិំ ទាស្យាមិ, តតស្តេ វវ្រជុះ។</para>
  <para style="p">
    <verse number="5" style="v"/>បុនឝ្ច ស ទ្វិតីយត្ឫតីយយោះ ប្រហរយោ រ្ពហិ រ្គត្វា តថៃវ ក្ឫតវាន៑។</para>
  <para style="p">
    <verse number="6" style="v"/>តតោ ទណ្ឌទ្វយាវឝិឞ្ដាយាំ វេលាយាំ ពហិ រ្គត្វាបរាន៑ កតិបយជនាន៑ និឞ្កម៌្មកាន៑ វិលោក្យ ប្ឫឞ្ដវាន៑, យូយំ កិមត៌្ហម៑ អត្រ សវ៌្វំ ទិនំ និឞ្កម៌្មាណស្តិឞ្ឋថ?</para>
  <para style="p">
    <verse number="7" style="v"/>តេ ប្រត្យវទន៑, អស្មាន៑ ន កោបិ កម៌មណិ និយុំក្តេ។ តទានីំ ស កថិតវាន៑, យូយមបិ មម ទ្រាក្ឞាក្ឞេត្រំ យាត, តេន យោគ្យាំ ភ្ឫតិំ លប្ស្យថ។</para>
  <para style="p">
    <verse number="8" style="v"/>តទនន្តរំ សន្ធ្យាយាំ សត្យាំ សឯវ ទ្រាក្ឞាក្ឞេត្របតិរធ្យក្ឞំ គទិវាន៑, ក្ឫឞកាន៑ អាហូយ ឝេឞជនមារភ្យ ប្រថមំ យាវត៑ តេភ្យោ ភ្ឫតិំ ទេហិ។</para>
  <para style="p">
    <verse number="9" style="v"/>តេន យេ ទណ្ឌទ្វយាវស្ថិតេ សមាយាតាស្តេឞាម៑ ឯកៃកោ ជនោ មុទ្រាចតុត៌្ហាំឝំ ប្រាប្នោត៑។</para>
  <para style="p">
    <verse number="10" style="v"/>តទានីំ ប្រថមនិយុក្តា ជនា អាគត្យានុមិតវន្តោ វយមធិកំ ប្រប្ស្យាមះ, កិន្តុ តៃរបិ មុទ្រាចតុត៌្ហាំឝោៜលាភិ។</para>
  <para style="p">
    <verse number="11" style="v"/>តតស្តេ តំ គ្ឫហីត្វា តេន ក្ឞេត្របតិនា សាកំ វាគ្យុទ្ធំ កុវ៌្វន្តះ កថយាមាសុះ,</para>
  <para style="p">
    <verse number="12" style="v"/>វយំ ក្ឫត្ស្នំ ទិនំ តាបក្លេឝៅ សោឍវន្តះ, កិន្តុ បឝ្ចាតាយា សេ ជនា ទណ្ឌទ្វយមាត្រំ បរិឝ្រាន្តវន្តស្តេៜស្មាភិះ សមានាំឝាះ ក្ឫតាះ។</para>
  <para style="p">
    <verse number="13" style="v"/>តតះ ស តេឞាមេកំ ប្រត្យុវាច, ហេ វត្ស, មយា ត្វាំ ប្រតិ កោប្យន្យាយោ ន ក្ឫតះ កិំ ត្វយា មត្សមក្ឞំ មុទ្រាចតុត៌្ហាំឝោ នាង្គីក្ឫតះ?</para>
  <para style="p">
    <verse number="14" style="v"/>តស្មាត៑ តវ យត៑ ប្រាប្យំ តទាទាយ យាហិ, តុភ្យំ យតិ, បឝ្ចាតីយនិយុក្តលោកាយាបិ តតិ ទាតុមិច្ឆាមិ។</para>
  <para style="p">
    <verse number="15" style="v"/>ស្វេច្ឆយា និជទ្រវ្យវ្យវហរណំ កិំ មយា ន កត៌្តវ្យំ? មម ទាត្ឫត្វាត៑ ត្វយា កិម៑ ឦឞ៌្យាទ្ឫឞ្ដិះ ក្រិយតេ?</para>
  <para style="p">
    <verse number="16" style="v"/>ឥត្ថម៑ អគ្រីយលោកាះ បឝ្ចតីយា ភវិឞ្យន្តិ, បឝ្ចាតីយជនាឝ្ចគ្រីយា ភវិឞ្យន្តិ, អហូតា ពហវះ កិន្ត្វល្បេ មនោភិលឞិតាះ។</para>
  <para style="p">
    <verse number="17" style="v"/>តទនន្តរំ យីឝុ រ្យិរូឝាលម្នគរំ គច្ឆន៑ មាគ៌មធ្យេ ឝិឞ្យាន៑ ឯកាន្តេ វភាឞេ,</para>
  <para style="p">
    <verse number="18" style="v"/>បឝ្យ វយំ យិរូឝាលម្នគរំ យាមះ, តត្រ ប្រធានយាជកាធ្យាបកានាំ ករេឞុ មនុឞ្យបុត្រះ សមប៌ិឞ្យតេ;</para>
  <para style="p">
    <verse number="19" style="v"/>តេ ច តំ ហន្តុមាជ្ញាប្យ តិរស្ក្ឫត្យ វេត្រេណ ប្រហត៌្តុំ ក្រុឝេ ធាតយិតុញ្ចាន្យទេឝីយានាំ ករេឞុ សមប៌យិឞ្យន្តិ, កិន្តុ ស ត្ឫតីយទិវសេ ឝ្មឝានាទ៑ ឧត្ថាបិឞ្យតេ។</para>
  <para style="p">
    <verse number="20" style="v"/>តទានីំ សិវទីយស្យ នារី ស្វបុត្រាវាទាយ យីឝោះ សមីបម៑ ឯត្យ ប្រណម្យ កញ្ចនានុគ្រហំ តំ យយាចេ។</para>
  <para style="p">
    <verse number="21" style="v"/>តទា យីឝុស្តាំ ប្រោក្តវាន៑, ត្វំ កិំ យាចសេ? តតះ សា ពភាឞេ, ភវតោ រាជត្វេ មមានយោះ សុតយោរេកំ ភវទ្ទក្ឞិណបាឝ៌្វេ ទ្វិតីយំ វាមបាឝ៌្វ ឧបវេឞ្ដុម៑ អាជ្ញាបយតុ។</para>
  <para style="p">
    <verse number="22" style="v"/>យីឝុះ ប្រត្យុវាច, យុវាភ្យាំ យទ៑ យាច្យតេ, តន្ន ពុធ្យតេ, អហំ យេន កំសេន បាស្យាមិ យុវាភ្យាំ កិំ តេន បាតុំ ឝក្យតេ? អហញ្ច យេន មជ្ជេនេន មជ្ជិឞ្យេ, យុវាភ្យាំ កិំ តេន មជ្ជយិតុំ ឝក្យតេ? តេ ជគទុះ ឝក្យតេ។</para>
  <para style="p">
    <verse number="23" style="v"/>តទា ស ឧក្តវាន៑, យុវាំ មម កំសេនាវឝ្យំ បាស្យថះ, មម មជ្ជនេន ច យុវាមបិ មជ្ជិឞ្យេថេ, កិន្តុ យេឞាំ ក្ឫតេ មត្តាតេន និរូបិតម៑ ឥទំ តាន៑ វិហាយាន្យំ កមបិ មទ្ទក្ឞិណបាឝ៌្វេ វាមបាឝ៌្វេ ច សមុបវេឝយិតុំ មមាធិការោ នាស្តិ។</para>
  <para style="p">
    <verse number="24" style="v"/>ឯតាំ កថាំ ឝ្រុត្វាន្យេ ទឝឝិឞ្យាស្តៅ ភ្រាតរៅ ប្រតិ ចុកុបុះ។</para>
  <para style="p">
    <verse number="25" style="v"/>កិន្តុ យីឝុះ ស្វសមីបំ តានាហូយ ជគាទ, អន្យទេឝីយលោកានាំ នរបតយស្តាន៑ អធិកុវ៌្វន្តិ, យេ តុ មហាន្តស្តេ តាន៑ ឝាសតិ, ឥតិ យូយំ ជានីថ។</para>
  <para style="p">
    <verse number="26" style="v"/>កិន្តុ យុឞ្មាកំ មធ្យេ ន តថា ភវេត៑, យុឞ្មាកំ យះ កឝ្ចិត៑ មហាន៑ ពុភូឞតិ, ស យុឞ្មាន៑ សេវេត;</para>
  <para style="p">
    <verse number="27" style="v"/>យឝ្ច យុឞ្មាកំ មធ្យេ មុខ្យោ ពុភូឞតិ, ស យុឞ្មាកំ ទាសោ ភវេត៑។</para>
  <para style="p">
    <verse number="28" style="v"/>ឥត្ថំ មនុជបុត្រះ សេវ្យោ ភវិតុំ នហិ, កិន្តុ សេវិតុំ ពហូនាំ បរិត្រាណមូល្យាត៌្ហំ ស្វប្រាណាន៑ ទាតុញ្ចាគតះ។</para>
  <para style="p">
    <verse number="29" style="v"/>អនន្តរំ យិរីហោនគរាត៑ តេឞាំ ពហិគ៌មនសមយេ តស្យ បឝ្ចាទ៑ ពហវោ លោកា វវ្រជុះ។</para>
  <para style="p">
    <verse number="30" style="v"/>អបរំ វត៌្មបាឝ៌្វ ឧបវិឝន្តៅ ទ្វាវន្ធៅ តេន មាគ៌េណ យីឝោ រ្គមនំ និឝម្យ ប្រោច្ចៃះ កថយាមាសតុះ, ហេ ប្រភោ ទាយូទះ សន្តាន, អាវយោ រ្ទយាំ វិធេហិ។</para>
  <para style="p">
    <verse number="31" style="v"/>តតោ លោកាះ សវ៌្វេ តុឞ្ណីម្ភវតមិត្យុក្ត្វា តៅ តជ៌យាមាសុះ; តថាបិ តៅ បុនរុច្ចៃះ កថយាមាសតុះ ហេ ប្រភោ ទាយូទះ សន្តាន, អាវាំ ទយស្វ។</para>
  <para style="p">
    <verse number="32" style="v"/>តទានីំ យីឝុះ ស្ថគិតះ សន៑ តាវាហូយ ភាឞិតវាន៑, យុវយោះ ក្ឫតេ មយា កិំ កត៌្តវ៌្យំ? យុវាំ កិំ កាមយេថេ?</para>
  <para style="p">
    <verse number="33" style="v"/>តទា តាវុក្តវន្តៅ, ប្រភោ នេត្រាណិ នៅ ប្រសន្នានិ ភវេយុះ។</para>
  <para style="p">
    <verse number="34" style="v"/>តទានីំ យីឝុស្តៅ ប្រតិ ប្រមន្នះ សន៑ តយោ រ្នេត្រាណិ បស្បឝ៌, តេនៃវ តៅ សុវីក្ឞាញ្ចក្រាតេ តត្បឝ្ចាត៑ ជគ្មុតុឝ្ច។</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ តេឞុ យិរូឝាលម្នគរស្យ សមីបវេត៌្តិនោ ជៃតុននាមកធរាធរស្យ សមីបស្ថ្តិំ ពៃត្ផគិគ្រាមម៑ អាគតេឞុ, យីឝុះ ឝិឞ្យទ្វយំ ប្រេឞយន៑ ជគាទ,</para>
  <para style="p">
    <verse number="2" style="v"/>យុវាំ សម្មុខស្ថគ្រាមំ គត្វា ពទ្ធាំ យាំ សវត្សាំ គទ៌្ទភីំ ហឋាត៑ ប្រាប្ស្យថះ, តាំ មោចយិត្វា មទន្តិកម៑ អានយតំ។</para>
  <para style="p">
    <verse number="3" style="v"/>តត្រ យទិ កឝ្ចិត៑ កិញ្ចិទ៑ វក្ឞ្យតិ, តហ៌ិ វទិឞ្យថះ, ឯតស្យាំ ប្រភោះ ប្រយោជនមាស្តេ, តេន ស តត្ក្ឞណាត៑ ប្រហេឞ្យតិ។</para>
  <para style="p">
    <verse number="4" style="v"/>សីយោនះ កន្យកាំ យូយំ ភាឞធ្វមិតិ ភារតីំ។ បឝ្យ តេ នម្រឝីលះ សន៑ ន្ឫប អារុហ្យ គទ៌ភីំ។ អត៌្ហាទារុហ្យ តទ្វត្សមាយាស្យតិ ត្វទន្តិកំ។</para>
  <para style="p">
    <verse number="5" style="v"/>ភវិឞ្យទ្វាទិនោក្តំ វចនមិទំ តទា សផលមភូត៑។</para>
  <para style="p">
    <verse number="6" style="v"/>អនន្តរំ តៅ ឝ្ឞ្យិौ យីឝោ រ្យថានិទេឝំ តំ គ្រាមំ គត្វា</para>
  <para style="p">
    <verse number="7" style="v"/>គទ៌ភីំ តទ្វត្សញ្ច សមានីតវន្តៅ, បឝ្ចាត៑ តទុបរិ ស្វីយវសនានី បាតយិត្វា តមារោហយាមាសតុះ។</para>
  <para style="p">
    <verse number="8" style="v"/>តតោ ពហវោ លោកា និជវសនានិ បថិ ប្រសារយិតុមារេភិរេ, កតិបយា ជនាឝ្ច បាទបបណ៌ាទិកំ ឆិត្វា បថិ វិស្តារយាមាសុះ។</para>
  <para style="p">
    <verse number="9" style="v"/>អគ្រគាមិនះ បឝ្ចាទ្គាមិនឝ្ច មនុជា ឧច្ចៃជ៌យ ជយ ទាយូទះ សន្តានេតិ ជគទុះ បរមេឝ្វរស្យ នាម្នា យ អាយាតិ ស ធន្យះ, សវ៌្វោបរិស្ថស្វគ៌េបិ ជយតិ។</para>
  <para style="p">
    <verse number="10" style="v"/>ឥត្ថំ តស្មិន៑ យិរូឝាលមំ ប្រវិឞ្ដេ កោៜយមិតិ កថនាត៑ ក្ឫត្ស្នំ នគរំ ចញ្ចលមភវត៑។</para>
  <para style="p">
    <verse number="11" style="v"/>តត្រ លោកោះ កថយាមាសុះ, ឯឞ គាលីល្ប្រទេឝីយ-នាសរតីយ-ភវិឞ្យទ្វាទី យីឝុះ។</para>
  <para style="p">
    <verse number="12" style="v"/>អនន្តរំ យីឝុរីឝ្វរស្យ មន្ទិរំ ប្រវិឝ្យ តន្មធ្យាត៑ ក្រយវិក្រយិណោ វហិឝ្ចការ; វណិជាំ មុទ្រាសនានី កបោតវិក្រយិណាញ្ចសនានី ច ន្យុវ្ជយាមាស។</para>
  <para style="p">
    <verse number="13" style="v"/>អបរំ តានុវាច, ឯឞា លិបិរាស្តេ, "មម គ្ឫហំ ប្រាត៌្ហនាគ្ឫហមិតិ វិខ្យាស្យតិ", កិន្តុ យូយំ តទ៑ ទស្យូនាំ គហ្វរំ ក្ឫតវន្តះ។</para>
  <para style="p">
    <verse number="14" style="v"/>តទនន្តរម៑ អន្ធខញ្ចលោកាស្តស្យ សមីបមាគតាះ, ស តាន៑ និរាមយាន៑ ក្ឫតវាន៑។</para>
  <para style="p">
    <verse number="15" style="v"/>យទា ប្រធានយាជកា អធ្យាបកាឝ្ច តេន ក្ឫតាន្យេតានិ ចិត្រកម៌្មាណិ ទទ្ឫឝុះ, ជយ ជយ ទាយូទះ សន្តាន, មន្ទិរេ ពាលកានាម៑ ឯតាទ្ឫឝម៑ ឧច្ចធ្វនិំ ឝុឝ្រុវុឝ្ច, តទា មហាក្រុទ្ធា ពភូវះ,</para>
  <para style="p">
    <verse number="16" style="v"/>តំ បប្រច្ឆុឝ្ច, ឥមេ យទ៑ វទន្តិ, តត៑ កិំ ត្វំ ឝ្ឫណោឞិ? តតោ យីឝុស្តាន៑ អវោចត៑, សត្យម៑; ស្តន្យបាយិឝិឝូនាញ្ច ពាលកានាញ្ច វក្ត្រតះ។ ស្វកីយំ មហិមានំ ត្វំ សំប្រកាឝយសិ ស្វយំ។ ឯតទ្វាក្យំ យូយំ កិំ នាបឋត?</para>
  <para style="p">
    <verse number="17" style="v"/>តតស្តាន៑ វិហាយ ស នគរាទ៑ ពៃថនិយាគ្រាមំ គត្វា តត្រ រជនីំ យាបយាមាស។</para>
  <para style="p">
    <verse number="18" style="v"/>អនន្តរំ ប្រភាតេ សតិ យីឝុះ បុនរបិ នគរមាគច្ឆន៑ ក្ឞុធាត៌្តោ ពភូវ។</para>
  <para style="p">
    <verse number="19" style="v"/>តតោ មាគ៌បាឝ៌្វ ឧឌុម្ពរវ្ឫក្ឞមេកំ វិលោក្យ តត្សមីបំ គត្វា បត្រាណិ វិនា កិមបិ ន ប្រាប្យ តំ បាទបំ ប្រោវាច, អទ្យារភ្យ កទាបិ ត្វយិ ផលំ ន ភវតុ; តេន តត្ក្ឞណាត៑ ស ឧឌុម្ពរមាហីរុហះ ឝុឞ្កតាំ គតះ។</para>
  <para style="p">
    <verse number="20" style="v"/>តទ៑ ទ្ឫឞ្ដ្វា ឝិឞ្យា អាឝ្ចយ៌្យំ វិជ្ញាយ កថយាមាសុះ, អាះ, ឧឌុម្វរបាទបោៜតិតូណ៌ំ ឝុឞ្កោៜភវត៑។</para>
  <para style="p">
    <verse number="21" style="v"/>តតោ យីឝុស្តានុវាច, យុឞ្មានហំ សត្យំ វទាមិ, យទិ យូយមសន្ទិគ្ធាះ ប្រតីថ, តហ៌ិ យូយមបិ កេវលោឌុម្វរបាទបំ ប្រតីត្ថំ កត៌្តុំ ឝក្ឞ្យថ, តន្ន, ត្វំ ចលិត្វា សាគរេ បតេតិ វាក្យំ យុឞ្មាភិរស្មិន ឝៃលេ ប្រោក្តេបិ តទៃវ តទ៑ ឃដិឞ្យតេ។</para>
  <para style="p">
    <verse number="22" style="v"/>តថា វិឝ្វស្យ ប្រាត៌្ហ្យ យុឞ្មាភិ រ្យទ៑ យាចិឞ្យតេ, តទេវ ប្រាប្ស្យតេ។</para>
  <para style="p">
    <verse number="23" style="v"/>អនន្តរំ មន្ទិរំ ប្រវិឝ្យោបទេឝនសមយេ តត្សមីបំ ប្រធានយាជកាះ ប្រាចីនលោកាឝ្ចាគត្យ បប្រច្ឆុះ, ត្វយា កេន សាមត៌្ហ្យនៃតានិ កម៌្មាណិ ក្រិយន្តេ? កេន វា តុភ្យមេតានិ សាមត៌្ហ្យានិ ទត្តានិ?</para>
  <para style="p">
    <verse number="24" style="v"/>តតោ យីឝុះ ប្រត្យវទត៑, អហមបិ យុឞ្មាន៑ វាចមេកាំ ប្ឫច្ឆាមិ, យទិ យូយំ តទុត្តរំ ទាតុំ ឝក្ឞ្យថ, តទា កេន សាមត៌្ហ្យេន កម៌្មាណ្យេតានិ ករោមិ, តទហំ យុឞ្មាន៑ វក្ឞ្យាមិ។</para>
  <para style="p">
    <verse number="25" style="v"/>យោហនោ មជ្ជនំ កស្យាជ្ញយាភវត៑? កិមីឝ្វរស្យ មនុឞ្យស្យ វា? តតស្តេ បរស្បរំ វិវិច្យ កថយាមាសុះ, យទីឝ្វរស្យេតិ វទាមស្តហ៌ិ យូយំ តំ កុតោ ន ប្រត្យៃត? វាចមេតាំ វក្ឞ្យតិ។</para>
  <para style="p">
    <verse number="26" style="v"/>មនុឞ្យស្យេតិ វក្តុមបិ លោកេភ្យោ ពិភីមះ, យតះ សវ៌្វៃរបិ យោហន៑ ភវិឞ្យទ្វាទីតិ ជ្ញាយតេ។</para>
  <para style="p">
    <verse number="27" style="v"/>តស្មាត៑ តេ យីឝុំ ប្រត្យវទន៑, តទ៑ វយំ ន វិទ្មះ។ តទា ស តានុក្តវាន៑, តហ៌ិ កេន សាមរថ្យេន កម៌្មាណ្យេតាន្យហំ ករោមិ, តទប្យហំ យុឞ្មាន៑ ន វក្ឞ្យាមិ។</para>
  <para style="p">
    <verse number="28" style="v"/>កស្យចិជ្ជនស្យ ទ្វៅ សុតាវាស្តាំ ស ឯកស្យ សុតស្យ សមីបំ គត្វា ជគាទ, ហេ សុត, ត្វមទ្យ មម ទ្រាក្ឞាក្ឞេត្រេ កម៌្ម កត៌ុំ វ្រជ។</para>
  <para style="p">
    <verse number="29" style="v"/>តតះ ស ឧក្តវាន៑, ន យាស្យាមិ, កិន្តុ ឝេឞេៜនុតប្យ ជគាម។</para>
  <para style="p">
    <verse number="30" style="v"/>អនន្តរំ សោន្យសុតស្យ សមីបំ គត្វា តថៃវ កថ្តិវាន៑; តតះ ស ប្រត្យុវាច, មហេច្ឆ យាមិ, កិន្តុ ន គតះ។</para>
  <para style="p">
    <verse number="31" style="v"/>ឯតយោះ បុត្រយោ រ្មធ្យេ បិតុរភិមតំ កេន បាលិតំ? យុឞ្មាភិះ កិំ ពុធ្យតេ? តតស្តេ ប្រត្យូចុះ, ប្រថមេន បុुត្រេណ។ តទានីំ យីឝុស្តានុវាច, អហំ យុឞ្មាន៑ តថ្យំ វទាមិ, ចណ្ឌាលា គណិកាឝ្ច យុឞ្មាកមគ្រត ឦឝ្វរស្យ រាជ្យំ ប្រវិឝន្តិ។</para>
  <para style="p">
    <verse number="32" style="v"/>យតោ យុឞ្មាកំ សមីបំ យោហនិ ធម៌្មបថេនាគតេ យូយំ តំ ន ប្រតីថ, កិន្តុ ចណ្ឌាលា គណិកាឝ្ច តំ ប្រត្យាយន៑, តទ៑ វិលោក្យាបិ យូយំ ប្រត្យេតុំ នាខិទ្យធ្វំ។</para>
  <para style="p">
    <verse number="33" style="v"/>អបរមេកំ ទ្ឫឞ្ដាន្តំ ឝ្ឫណុត, កឝ្ចិទ៑ គ្ឫហស្ថះ ក្ឞេត្រេ ទ្រាក្ឞាលតា រោបយិត្វា តច្ចតុទ៌ិក្ឞុ វារណីំ វិធាយ តន្មធ្យេ ទ្រាក្ឞាយន្ត្រំ ស្ថាបិតវាន៑, មាញ្ចញ្ច និម៌្មិតវាន៑, តតះ ក្ឫឞកេឞុ តត៑ ក្ឞេត្រំ សមប៌្យ ស្វយំ ទូរទេឝំ ជគាម។</para>
  <para style="p">
    <verse number="34" style="v"/>តទនន្តរំ ផលសមយ ឧបស្ថិតេ ស ផលានិ ប្រាប្តុំ ក្ឫឞីវលានាំ សមីបំ និជទាសាន៑ ប្រេឞយាមាស។</para>
  <para style="p">
    <verse number="35" style="v"/>កិន្តុ ក្ឫឞីវលាស្តស្យ តាន៑ ទាសេយាន៑ ធ្ឫត្វា កញ្ចន ប្រហ្ឫតវន្តះ, កញ្ចន បាឞាណៃរាហតវន្តះ, កញ្ចន ច ហតវន្តះ។</para>
  <para style="p">
    <verse number="36" style="v"/>បុនរបិ ស ប្រភុះ ប្រថមតោៜធិកទាសេយាន៑ ប្រេឞយាមាស, កិន្តុ តេ តាន៑ ប្រត្យបិ តថៃវ ចក្រុះ។</para>
  <para style="p">
    <verse number="37" style="v"/>អនន្តរំ មម សុតេ គតេ តំ សមាទរិឞ្យន្តេ, ឥត្យុក្ត្វា ឝេឞេ ស និជសុតំ តេឞាំ សន្និធិំ ប្រេឞយាមាស។</para>
  <para style="p">
    <verse number="38" style="v"/>កិន្តុ តេ ក្ឫឞីវលាះ សុតំ វីក្ឞ្យ បរស្បរម៑ ឥតិ មន្ត្រយិតុម៑ អារេភិរេ, អយមុត្តរាធិការី វយមេនំ និហត្យាស្យាធិការំ ស្វវឝីករិឞ្យាមះ។</para>
  <para style="p">
    <verse number="39" style="v"/>បឝ្ចាត៑ តេ តំ ធ្ឫត្វា ទ្រាក្ឞាក្ឞេត្រាទ៑ ពហិះ បាតយិត្វាពធិឞុះ។</para>
  <para style="p">
    <verse number="40" style="v"/>យទា ស ទ្រាក្ឞាក្ឞេត្របតិរាគមិឞ្យតិ, តទា តាន៑ ក្ឫឞីវលាន៑ កិំ ករិឞ្យតិ?</para>
  <para style="p">
    <verse number="41" style="v"/>តតស្តេ ប្រត្យវទន៑, តាន៑ កលុឞិណោ ទារុណយាតនាភិរាហនិឞ្យតិ, យេ ច សមយានុក្រមាត៑ ផលានិ ទាស្យន្តិ, តាទ្ឫឝេឞុ ក្ឫឞីវលេឞុ ក្ឞេត្រំ សមប៌យិឞ្យតិ។</para>
  <para style="p">
    <verse number="42" style="v"/>តទា យីឝុនា តេ គទិតាះ, គ្រហណំ ន ក្ឫតំ យស្យ បាឞាណស្យ និចាយកៃះ។ ប្រធានប្រស្តរះ កោណេ សឯវ សំភវិឞ្យតិ។ ឯតត៑ បរេឝិតុះ កម៌្មាស្មទ្ឫឞ្ដាវទ្ភុតំ ភវេត៑។ ធម៌្មគ្រន្ថេ លិខិតមេតទ្វចនំ យុឞ្មាភិះ កិំ នាបាឋិ?</para>
  <para style="p">
    <verse number="43" style="v"/>តស្មាទហំ យុឞ្មាន៑ វទាមិ, យុឞ្មត្ត ឦឝ្វរីយរាជ្យមបនីយ ផលោត្បាទយិត្រន្យជាតយេ ទាយិឞ្យតេ។</para>
  <para style="p">
    <verse number="44" style="v"/>យោ ជន ឯតត្បាឞាណោបរិ បតិឞ្យតិ, តំ ស ភំក្ឞ្យតេ, កិន្ត្វយំ បាឞាណោ យស្យោបរិ បតិឞ្យតិ, តំ ស ធូលិវត៑ ចូណ៌ីករិឞ្យតិ។</para>
  <para style="p">
    <verse number="45" style="v"/>តទានីំ ប្រាធនយាជកាះ ផិរូឝិនឝ្ច តស្យេមាំ ទ្ឫឞ្ដាន្តកថាំ ឝ្រុត្វា សោៜស្មានុទ្ទិឝ្យ កថិតវាន៑, ឥតិ វិជ្ញាយ តំ ធត៌្តុំ ចេឞ្ដិតវន្តះ;</para>
  <para style="p">
    <verse number="46" style="v"/>កិន្តុ លោកេភ្យោ ពិភ្យុះ, យតោ លោកៃះ ស ភវិឞ្យទ្វាទីត្យជ្ញាយិ។</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ យីឝុះ បុនរបិ ទ្ឫឞ្ដាន្តេន តាន៑ អវាទីត៑,</para>
  <para style="p">
    <verse number="2" style="v"/>ស្វគ៌ីយរាជ្យម៑ ឯតាទ្ឫឝស្យ ន្ឫបតេះ សមំ, យោ និជ បុត្រំ វិវាហយន៑ សវ៌្វាន៑ និមន្ត្រិតាន៑ អានេតុំ ទាសេយាន៑ ប្រហិតវាន៑,</para>
  <para style="p">
    <verse number="3" style="v"/>កិន្តុ តេ សមាគន្តុំ នេឞ្ដវន្តះ។</para>
  <para style="p">
    <verse number="4" style="v"/>តតោ រាជា បុនរបិ ទាសានន្យាន៑ ឥត្យុក្ត្វា ប្រេឞយាមាស, និមន្ត្រិតាន៑ វទត, បឝ្យត, មម ភេជ្យមាសាទិតមាស្តេ, និជវ្ដឞាទិបុឞ្ដជន្តូន៑ មារយិត្វា សវ៌្វំ ខាទ្យទ្រវ្យមាសាទិតវាន៑, យូយំ វិវាហមាគច្ឆត។</para>
  <para style="p">
    <verse number="5" style="v"/>តថបិ តេ តុច្ឆីក្ឫត្យ កេចិត៑ និជក្ឞេត្រំ កេចិទ៑ វាណិជ្យំ ប្រតិ ស្វស្វមាគ៌េណ ចលិតវន្តះ។</para>
  <para style="p">
    <verse number="6" style="v"/>អន្យេ លោកាស្តស្យ ទាសេយាន៑ ធ្ឫត្វា ទៅរាត្ម្យំ វ្យវហ្ឫត្យ តានវធិឞុះ។</para>
  <para style="p">
    <verse number="7" style="v"/>អនន្តរំ ស ន្ឫបតិស្តាំ វាត៌្តាំ ឝ្រុត្វា ក្រុធ្យន៑ សៃន្យានិ ប្រហិត្យ តាន៑ ឃាតកាន៑ ហត្វា តេឞាំ នគរំ ទាហយាមាស។</para>
  <para style="p">
    <verse number="8" style="v"/>តតះ ស និជទាសេយាន៑ ពភាឞេ, វិវាហីយំ ភោជ្យមាសាទិតមាស្តេ, កិន្តុ និមន្ត្រិតា ជនា អយោគ្យាះ។</para>
  <para style="p">
    <verse number="9" style="v"/>តស្មាទ៑ យូយំ រាជមាគ៌ំ គត្វា យាវតោ មនុជាន៑ បឝ្យត, តាវតឯវ វិវាហីយភោជ្យាយ និមន្ត្រយត។</para>
  <para style="p">
    <verse number="10" style="v"/>តទា តេ ទាសេយា រាជមាគ៌ំ គត្វា ភទ្រាន៑ អភទ្រាន៑ វា យាវតោ ជនាន៑ ទទ្ឫឝុះ, តាវតឯវ សំគ្ឫហ្យានយន៑; តតោៜភ្យាគតមនុជៃ រ្វិវាហគ្ឫហម៑ អបូយ៌្យត។</para>
  <para style="p">
    <verse number="11" style="v"/>តទានីំ ស រាជា សវ៌្វានភ្យាគតាន៑ ទ្រឞ្ដុម៑ អភ្យន្តរមាគតវាន៑; តទា តត្រ វិវាហីយវសនហីនមេកំ ជនំ វីក្ឞ្យ តំ ជគាទ៑,</para>
  <para style="p">
    <verse number="12" style="v"/>ហេ មិត្រ,ត្វំ វិវាហីយវសនំ វិនា កថមត្រ ប្រវិឞ្ដវាន៑? តេន ស និរុត្តរោ ពភូវ។</para>
  <para style="p">
    <verse number="13" style="v"/>តទា រាជា និជានុចរាន៑ អវទត៑, ឯតស្យ ករចរណាន៑ ពទ្ធា យត្រ រោទនំ ទន្តៃទ៌ន្តឃឞ៌ណញ្ច ភវតិ, តត្រ វហិព៌្ហូតតមិស្រេ តំ និក្ឞិបត។</para>
  <para style="p">
    <verse number="14" style="v"/>ឥត្ថំ ពហវ អាហូតា អល្បេ មនោភិមតាះ។</para>
  <para style="p">
    <verse number="15" style="v"/>អនន្តរំ ផិរូឝិនះ ប្រគត្យ យថា សំលាបេន តម៑ ឧន្មាថេ បាតយេយុស្តថា មន្ត្រយិត្វា</para>
  <para style="p">
    <verse number="16" style="v"/>ហេរោទីយមនុជៃះ សាកំ និជឝិឞ្យគណេន តំ ប្រតិ កថយាមាសុះ, ហេ គុរោ, ភវាន៑ សត្យះ សត្យមីឝ្វរីយមាគ៌មុបទិឝតិ, កមបិ មានុឞំ នានុរុធ្យតេ, កមបិ នាបេក្ឞតេ ច, តទ៑ វយំ ជានីមះ។</para>
  <para style="p">
    <verse number="17" style="v"/>អតះ កៃសរភូបាយ ករោៜស្មាកំ ទាតវ្យោ ន វា? អត្រ ភវតា កិំ ពុធ្យតេ? តទ៑ អស្មាន៑ វទតុ។</para>
  <para style="p">
    <verse number="18" style="v"/>តតោ យីឝុស្តេឞាំ ខលតាំ វិជ្ញាយ កថិតវាន៑, រេ កបដិនះ យុយំ កុតោ មាំ បរិក្ឞធ្វេ?</para>
  <para style="p">
    <verse number="19" style="v"/>តត្ករទានស្យ មុទ្រាំ មាំ ទឝ៌យត។ តទានីំ តៃស្តស្យ សមីបំ មុទ្រាចតុត៌្ហភាគ អានីតេ</para>
  <para style="p">
    <verse number="20" style="v"/>ស តាន៑ បប្រច្ឆ, អត្រ កស្យេយំ មូត៌្តិ រ្នាម ចាស្តេ? តេ ជគទុះ, កៃសរភូបស្យ។</para>
  <para style="p">
    <verse number="21" style="v"/>តតះ ស ឧក្តវាន, កៃសរស្យ យត៑ តត៑ កៃសរាយ ទត្ត, ឦឝ្វរស្យ យត៑ តទ៑ ឦឝ្វរាយ ទត្ត។</para>
  <para style="p">
    <verse number="22" style="v"/>ឥតិ វាក្យំ និឝម្យ តេ វិស្មយំ វិជ្ញាយ តំ វិហាយ ចលិតវន្តះ។</para>
  <para style="p">
    <verse number="23" style="v"/>តស្មិន្នហនិ សិទូកិនោៜរ្ថាត៑ ឝ្មឝានាត៑ នោត្ថាស្យន្តីតិ វាក្យំ យេ វទន្តិ, តេ យីឝេाរន្តិកម៑ អាគត្យ បប្រច្ឆុះ,</para>
  <para style="p">
    <verse number="24" style="v"/>ហេ គុរោ, កឝ្ចិន្មនុជឝ្ចេត៑ និះសន្តានះ សន៑ ប្រាណាន៑ ត្យជតិ, តហ៌ិ តស្យ ភ្រាតា តស្យ ជាយាំ វ្យុហ្យ ភ្រាតុះ សន្តានម៑ ឧត្បាទយិឞ្យតីតិ មូសា អាទិឞ្ដវាន៑។</para>
  <para style="p">
    <verse number="25" style="v"/>កិន្ត្វស្មាកមត្រ កេៜបិ ជនាះ សប្តសហោទរា អាសន៑, តេឞាំ ជ្យេឞ្ឋ ឯកាំ កន្យាំ វ្យវហាត៑, អបរំ ប្រាណត្យាគកាលេ ស្វយំ និះសន្តានះ សន៑ តាំ ស្ត្រិយំ ស្វភ្រាតរិ សមប៌ិតវាន៑,</para>
  <para style="p">
    <verse number="26" style="v"/>តតោ ទ្វិតីយាទិសប្តមាន្តាឝ្ច តថៃវ ចក្រុះ។</para>
  <para style="p">
    <verse number="27" style="v"/>ឝេឞេ សាបី នារី មមារ។</para>
  <para style="p">
    <verse number="28" style="v"/>ម្ឫតានាម៑ ឧត្ថានសមយេ តេឞាំ សប្តានាំ មធ្យេ សា នារី កស្យ ភាយ៌្យា ភវិឞ្យតិ? យស្មាត៑ សវ៌្វឯវ តាំ វ្យវហន៑។</para>
  <para style="p">
    <verse number="29" style="v"/>តតោ យីឝុះ ប្រត្យវាទីត៑, យូយំ ធម៌្មបុស្តកម៑ ឦឝ្វរីយាំ ឝក្តិញ្ច ន វិជ្ញាយ ភ្រាន្តិមន្តះ។</para>
  <para style="p">
    <verse number="30" style="v"/>ឧត្ថានប្រាប្តា លោកា ន វិវហន្តិ, ន ច វាចា ទីយន្តេ, កិន្ត្វីឝ្វរស្យ ស្វគ៌ស្ថទូតានាំ សទ្ឫឝា ភវន្តិ។</para>
  <para style="p">
    <verse number="31" style="v"/>អបរំ ម្ឫតានាមុត្ថានមធិ យុឞ្មាន៑ ប្រតីយមីឝ្វរោក្តិះ,</para>
  <para style="p">
    <verse number="32" style="v"/>"អហមិព្រាហីម ឦឝ្វរ ឥស្ហាក ឦឝ្វរោ យាកូព ឦឝ្វរ" ឥតិ កិំ យុឞ្មាភិ រ្នាបាឋិ? កិន្ត្វីឝ្វរោ ជីវតាម៑ ឦឝ្វរ:, ស ម្ឫតានាមីឝ្វរោ នហិ។</para>
  <para style="p">
    <verse number="33" style="v"/>ឥតិ ឝ្រុត្វា សវ៌្វេ លោកាស្តស្យោបទេឝាទ៑ វិស្មយំ គតាះ។</para>
  <para style="p">
    <verse number="34" style="v"/>អនន្តរំ សិទូកិនាម៑ និរុត្តរត្វវាត៌ាំ និឝម្យ ផិរូឝិន ឯកត្រ មិលិតវន្តះ,</para>
  <para style="p">
    <verse number="35" style="v"/>តេឞាមេកោ វ្យវស្ថាបកោ យីឝុំ បរីក្ឞិតុំ បបច្ឆ,</para>
  <para style="p">
    <verse number="36" style="v"/>ហេ គុរោ វ្យវស្ថាឝាស្ត្រមធ្យេ កាជ្ញា ឝ្រេឞ្ឋា?</para>
  <para style="p">
    <verse number="37" style="v"/>តតោ យីឝុរុវាច, ត្វំ សវ៌្វាន្តះករណៃះ សវ៌្វប្រាណៃះ សវ៌្វចិត្តៃឝ្ច សាកំ ប្រភៅ បរមេឝ្វរេ ប្រីយស្វ,</para>
  <para style="p">
    <verse number="38" style="v"/>ឯឞា ប្រថមមហាជ្ញា។ តស្យាះ សទ្ឫឝី ទ្វិតីយាជ្ញៃឞា,</para>
  <para style="p">
    <verse number="39" style="v"/>តវ សមីបវាសិនិ ស្វាត្មនីវ ប្រេម កុរុ។</para>
  <para style="p">
    <verse number="40" style="v"/>អនយោ រ្ទ្វយោរាជ្ញយោះ ក្ឫត្ស្នវ្យវស្ថាយា ភវិឞ្យទ្វក្ត្ឫគ្រន្ថស្យ ច ភារស្តិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="41" style="v"/>អនន្តរំ ផិរូឝិនាម៑ ឯកត្រ ស្ថិតិកាលេ យីឝុស្តាន៑ បប្រច្ឆ,</para>
  <para style="p">
    <verse number="42" style="v"/>ខ្រីឞ្ដមធិ យុឞ្មាកំ កីទ្ឫគ្ពោធោ ជាយតេ? ស កស្យ សន្តានះ? តតស្តេ ប្រត្យវទន៑, ទាយូទះ សន្តានះ។</para>
  <para style="p">
    <verse number="43" style="v"/>តទា ស ឧក្តវាន៑, តហ៌ិ ទាយូទ៑ កថម៑ អាត្មាធិឞ្ឋានេន តំ ប្រភុំ វទតិ ?</para>
  <para style="p">
    <verse number="44" style="v"/>យថា មម ប្រភុមិទំ វាក្យមវទត៑ បរមេឝ្វរះ។ តវារីន៑ បាទបីឋំ តេ យាវន្នហិ ករោម្យហំ។ តាវត៑ កាលំ មទីយេ ត្វំ ទក្ឞបាឝ៌្វ ឧបាវិឝ។ អតោ យទិ ទាយូទ៑ តំ ប្រភុំ វទតិ, រ្តិហ ស កថំ តស្យ សន្តានោ ភវតិ?</para>
  <para style="p">
    <verse number="45" style="v"/>តទានីំ តេឞាំ កោបិ តទ្វាក្យស្យ កិមប្យុត្តរំ ទាតុំ នាឝក្នោត៑;</para>
  <para style="p">
    <verse number="46" style="v"/>តទ្ទិនមារភ្យ តំ កិមបិ វាក្យំ ប្រឞ្ដុំ កស្យាបិ សាហសោ នាភវត៑។</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ យីឝុ រ្ជននិវហំ ឝិឞ្យាំឝ្ចាវទត៑,</para>
  <para style="p">
    <verse number="2" style="v"/>អធ្យាបកាះ ផិរូឝិនឝ្ច មូសាសនេ ឧបវិឝន្តិ,</para>
  <para style="p">
    <verse number="3" style="v"/>អតស្តេ យុឞ្មាន៑ យទ្យត៑ មន្តុម៑ អាជ្ញាបយន្តិ, តត៑ មន្យធ្វំ បាលយធ្វញ្ច, កិន្តុ តេឞាំ កម៌្មានុរូបំ កម៌្ម ន កុរុធ្វំ; យតស្តេឞាំ វាក្យមាត្រំ សារំ កាយ៌្យេ កិមបិ នាស្តិ។</para>
  <para style="p">
    <verse number="4" style="v"/>តេ ទុវ៌្វហាន៑ គុរុតរាន៑ ភារាន៑ ពទ្វ្វា មនុឞ្យាណាំ ស្កន្ធេបរិ សមប៌យន្តិ, កិន្តុ ស្វយមង្គុល្យៃកយាបិ ន ចាលយន្តិ។</para>
  <para style="p">
    <verse number="5" style="v"/>កេវលំ លោកទឝ៌នាយ សវ៌្វកម៌្មាណិ កុវ៌្វន្តិ; ផលតះ បដ្ដពន្ធាន៑ ប្រសាយ៌្យ ធារយន្តិ, ស្វវស្ត្រេឞុ ច ទីគ៌្ហគ្រន្ថីន៑ ធារយន្តិ;</para>
  <para style="p">
    <verse number="6" style="v"/>ភោជនភវន ឧច្ចស្ថានំ, ភជនភវនេ ប្រធានមាសនំ,</para>
  <para style="p">
    <verse number="7" style="v"/>ហដ្ឋេ នមស្ការំ គុរុរិតិ សម្ពោធនញ្ចៃតានិ សវ៌្វាណិ វាញ្ឆន្តិ។</para>
  <para style="p">
    <verse number="8" style="v"/>កិន្តុ យូយំ គុរវ ឥតិ សម្ពោធនីយា មា ភវត, យតោ យុឞ្មាកម៑ ឯកះ ខ្រីឞ្ដឯវ គុរុ</para>
  <para style="p">
    <verse number="9" style="v"/>រ្យូយំ សវ៌្វេ មិថោ ភ្រាតរឝ្ច។ បុនះ ប្ឫថិវ្យាំ កមបិ បិតេតិ មា សម្ពុធ្យធ្វំ, យតោ យុឞ្មាកមេកះ ស្វគ៌ស្ថឯវ បិតា។</para>
  <para style="p">
    <verse number="10" style="v"/>យូយំ នាយកេតិ សម្ភាឞិតា មា ភវត, យតោ យុឞ្មាកមេកះ ខ្រីឞ្ដឯវ នាយកះ។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរំ យុឞ្មាកំ មធ្យេ យះ បុមាន៑ ឝ្រេឞ្ឋះ ស យុឞ្មាន៑ សេវិឞ្យតេ។</para>
  <para style="p">
    <verse number="12" style="v"/>យតោ យះ ស្វមុន្នមតិ, ស នតះ ករិឞ្យតេ; កិន្តុ យះ កឝ្ចិត៑ ស្វមវនតំ ករោតិ, ស ឧន្នតះ ករិឞ្យតេ។</para>
  <para style="p">
    <verse number="13" style="v"/>ហន្ត កបដិន ឧបាធ្យាយាះ ផិរូឝិនឝ្ច, យូយំ មនុជានាំ សមក្ឞំ ស្វគ៌ទ្វារំ រុន្ធ, យូយំ ស្វយំ តេន ន ប្រវិឝថ, ប្រវិវិក្ឞូនបិ វារយថ។ វត កបដិន ឧបាធ្យាយាះ ផិរូឝិនឝ្ច យូយំ ឆលាទ៑ ទីគ៌្ហំ ប្រាត៌្ហ្យ វិធវានាំ សវ៌្វស្វំ គ្រសថ, យុឞ្មាកំ ឃោរតរទណ្ឌោ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="14" style="v"/>ហន្ត កបដិន ឧបាធ្យាយាះ ផិរូឝិនឝ្ច, យូយមេកំ ស្វធម៌្មាវលម្ពិនំ កត៌្តុំ សាគរំ ភូមណ្ឌលញ្ច ប្រទក្ឞិណីកុរុថ,</para>
  <para style="p">
    <verse number="15" style="v"/>កញ្ចន ប្រាប្យ ស្វតោ ទ្វិគុណនរកភាជនំ តំ កុរុថ។</para>
  <para style="p">
    <verse number="16" style="v"/>វត អន្ធបថទឝ៌កាះ សវ៌្វេ, យូយំ វទថ, មន្ទិរស្យ ឝបថករណាត៑ កិមបិ ន ទេយំ; កិន្តុ មន្ទិរស្ថសុវណ៌ស្យ ឝបថករណាទ៑ ទេយំ។</para>
  <para style="p">
    <verse number="17" style="v"/>ហេ មូឍា ហេ អន្ធាះ សុវណ៌ំ តត្សុវណ៌បាវកមន្ទិរម៑ ឯតយោរុភយោ រ្មធ្យេ កិំ ឝ្រេយះ?</para>
  <para style="p">
    <verse number="18" style="v"/>អន្យច្ច វទថ, យជ្ញវេទ្យាះ ឝបថករណាត៑ កិមបិ ន ទេយំ, កិន្តុ តទុបរិស្ថិតស្យ នៃវេទ្យស្យ ឝបថករណាទ៑ ទេយំ។</para>
  <para style="p">
    <verse number="19" style="v"/>ហេ មូឍា ហេ អន្ធាះ, នៃវេទ្យំ តន្នៃវេទ្យបាវកវេទិរេតយោរុភយោ រ្មធ្យេ កិំ ឝ្រេយះ?</para>
  <para style="p">
    <verse number="20" style="v"/>អតះ កេនចិទ៑ យជ្ញវេទ្យាះ ឝបថេ ក្ឫតេ តទុបរិស្ថស្យ សវ៌្វស្យ ឝបថះ ក្រិយតេ។</para>
  <para style="p">
    <verse number="21" style="v"/>កេនចិត៑ មន្ទិរស្យ ឝបថេ ក្ឫតេ មន្ទិរតន្និវាសិនោះ ឝបថះ ក្រិយតេ។</para>
  <para style="p">
    <verse number="22" style="v"/>កេនចិត៑ ស្វគ៌ស្យ ឝបថេ ក្ឫតេ ឦឝ្វរីយសិំហាសនតទុបយ៌្យុបវិឞ្ដយោះ ឝបថះ ក្រិយតេ។</para>
  <para style="p">
    <verse number="23" style="v"/>ហន្ត កបដិន ឧបាធ្យាយាះ ផិរូឝិនឝ្ច, យូយំ បោទិនាយាះ សិតច្ឆត្រាយា ជីរកស្យ ច ទឝមាំឝាន៑ ទត្ថ, កិន្តុ វ្យវស្ថាយា គុរុតរាន៑ ន្យាយទយាវិឝ្វាសាន៑ បរិត្យជថ; ឥមេ យុឞ្មាភិរាចរណីយា អមី ច ន លំឃនីយាះ។</para>
  <para style="p">
    <verse number="24" style="v"/>ហេ អន្ធបថទឝ៌កា យូយំ មឝកាន៑ អបសារយថ, កិន្តុ មហាង្គាន៑ គ្រសថ។</para>
  <para style="p">
    <verse number="25" style="v"/>ហន្ត កបដិន ឧបាធ្យាយាះ ផិរូឝិនឝ្ច, យូយំ បានបាត្រាណាំ ភោជនបាត្រាណាញ្ច ពហិះ បរិឞ្កុរុថ; កិន្តុ តទភ្យន្តរំ ទុរាត្មតយា កលុឞេណ ច បរិបូណ៌មាស្តេ។</para>
  <para style="p">
    <verse number="26" style="v"/>ហេ អន្ធាះ ផិរូឝិលោកា អាទៅ បានបាត្រាណាំ ភោជនបាត្រាណាញ្ចាភ្យន្តរំ បរិឞ្កុរុត, តេន តេឞាំ ពហិរបិ បរិឞ្ការិឞ្យតេ។</para>
  <para style="p">
    <verse number="27" style="v"/>ហន្ត កបដិន ឧបាធ្យាយាះ ផិរូឝិនឝ្ច, យូយំ ឝុក្លីក្ឫតឝ្មឝានស្វរូបា ភវថ, យថា ឝ្មឝានភវនស្យ ពហិឝ្ចារុ, កិន្ត្វភ្យន្តរំ ម្ឫតលោកានាំ កីកឝៃះ សវ៌្វប្រការមលេន ច បរិបូណ៌ម៑;</para>
  <para style="p">
    <verse number="28" style="v"/>តថៃវ យូយមបិ លោកានាំ សមក្ឞំ ពហិទ៌្ហាម៌្មិកាះ កិន្ត្វន្តះករណេឞុ កេវលកាបដ្យាធម៌្មាភ្យាំ បរិបូណ៌ាះ។</para>
  <para style="p">
    <verse number="29" style="v"/>ហា ហា កបដិន ឧបាធ្យាយាះ ផិរូឝិនឝ្ច, យូយំ ភវិឞ្យទ្វាទិនាំ ឝ្មឝានគេហំ និម៌្មាថ, សាធូនាំ ឝ្មឝាននិកេតនំ ឝោភយថ</para>
  <para style="p">
    <verse number="30" style="v"/>វទថ ច យទិ វយំ ស្វេឞាំ បូវ៌្វបុរុឞាណាំ កាល អស្ថាស្យាម, តហ៌ិ ភវិឞ្យទ្វាទិនាំ ឝោណិតបាតនេ តេឞាំ សហភាគិនោ នាភវិឞ្យាម។</para>
  <para style="p">
    <verse number="31" style="v"/>អតោ យូយំ ភវិឞ្យទ្វាទិឃាតកានាំ សន្តានា ឥតិ ស្វយមេវ ស្វេឞាំ សាក្ឞ្យំ ទត្ថ។</para>
  <para style="p">
    <verse number="32" style="v"/>អតោ យូយំ និជបូវ៌្វបុរុឞាណាំ បរិមាណបាត្រំ បរិបូរយត។</para>
  <para style="p">
    <verse number="33" style="v"/>រេ ភុជគាះ ក្ឫឞ្ណភុជគវំឝាះ, យូយំ កថំ នរកទណ្ឌាទ៑ រក្ឞិឞ្យធ្វេ។</para>
  <para style="p">
    <verse number="34" style="v"/>បឝ្យត, យុឞ្មាកមន្តិកម៑ អហំ ភវិឞ្យទ្វាទិនោ ពុទ្ធិមត ឧបាធ្យាយាំឝ្ច ប្រេឞយិឞ្យាមិ, កិន្តុ តេឞាំ កតិបយា យុឞ្មាភិ រ្ឃានិឞ្យន្តេ, ក្រុឝេ ច ឃានិឞ្យន្តេ, កេចិទ៑ ភជនភវនេ កឞាភិរាឃានិឞ្យន្តេ, នគរេ នគរេ តាឌិឞ្យន្តេ ច;</para>
  <para style="p">
    <verse number="35" style="v"/>តេន សត្បុរុឞស្យ ហាពិលោ រក្តបាតមារភ្យ ពេរិខិយះ បុត្រំ យំ សិខរិយំ យូយំ មន្ទិរយជ្ញវេទ្យោ រ្មធ្យេ ហតវន្តះ, តទីយឝោណិតបាតំ យាវទ៑ អស្មិន៑ ទេឝេ យាវតាំ សាធុបុរុឞាណាំ ឝោណិតបាតោ ៜភវត៑ តត៑ សវ៌្វេឞាមាគសាំ ទណ្ឌា យុឞ្មាសុ វត៌្តិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="36" style="v"/>អហំ យុឞ្មាន្ត តថ្យំ វទាមិ, វិទ្យមានេៜស្មិន៑ បុរុឞេ សវ៌្វេ វត៌្តិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="37" style="v"/>ហេ យិរូឝាលម៑ ហេ យិរូឝាលម៑ នគរិ ត្វំ ភវិឞ្យទ្វាទិនោ ហតវតី, តវ សមីបំ ប្រេរិតាំឝ្ច បាឞាណៃរាហតវតី, យថា កុក្កុដី ឝាវកាន៑ បក្ឞាធះ សំគ្ឫហ្លាតិ, តថា តវ សន្តានាន៑ សំគ្រហីតុំ អហំ ពហុវារម៑ ឰច្ឆំ; កិន្តុ ត្វំ ន សមមន្យថាះ។</para>
  <para style="p">
    <verse number="38" style="v"/>បឝ្យត យឞ្មាកំ វាសស្ថានម៑ ឧច្ឆិន្នំ ត្យក្ឞ្យតេ។</para>
  <para style="p">
    <verse number="39" style="v"/>អហំ យុឞ្មាន៑ តថ្យំ វទាមិ, យះ បរមេឝ្វរស្យ នាម្នាគច្ឆតិ, ស ធន្យ ឥតិ វាណីំ យាវន្ន វទិឞ្យថ, តាវត៑ មាំ បុន រ្ន ទ្រក្ឞ្យថ។</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អនន្តរំ យីឝុ រ្យទា មន្ទិរាទ៑ ពហិ រ្គច្ឆតិ, តទានីំ ឝិឞ្យាស្តំ មន្ទិរនិម៌្មាណំ ទឝ៌យិតុមាគតាះ។</para>
  <para style="p">
    <verse number="2" style="v"/>តតោ យីឝុស្តានុវាច, យូយំ កិមេតានិ ន បឝ្យថ? យុឞ្មានហំ សត្យំ វទាមិ, ឯតន្និចយនស្យ បាឞាណៃកមប្យន្យបាឞាណេाបរិ ន ស្ថាស្យតិ សវ៌្វាណិ ភូមិសាត៑ ការិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="3" style="v"/>អនន្តរំ តស្មិន៑ ជៃតុនបវ៌្វតោបរិ សមុបវិឞ្ដេ ឝិឞ្យាស្តស្យ សមីបមាគត្យ គុប្តំ បប្រច្ឆុះ, ឯតា ឃដនាះ កទា ភវិឞ្យន្តិ? ភវត អាគមនស្យ យុគាន្តស្យ ច កិំ លក្ឞ្ម? តទស្មាន៑ វទតុ។</para>
  <para style="p">
    <verse number="4" style="v"/>តទានីំ យីឝុស្តានវោចត៑, អវធទ្វ្វំ, កោបិ យុឞ្មាន៑ ន ភ្រមយេត៑។</para>
  <para style="p">
    <verse number="5" style="v"/>ពហវោ មម នាម គ្ឫហ្លន្ត អាគមិឞ្យន្តិ, ខ្រីឞ្ដោៜហមេវេតិ វាចំ វទន្តោ ពហូន៑ ភ្រមយិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="6" style="v"/>យូយញ្ច សំគ្រាមស្យ រណស្យ ចាឌម្ពរំ ឝ្រោឞ្យថ, អវធទ្វ្វំ តេន ចញ្ចលា មា ភវត, ឯតាន្យវឝ្យំ ឃដិឞ្យន្តេ, កិន្តុ តទា យុគាន្តោ នហិ។</para>
  <para style="p">
    <verse number="7" style="v"/>អបរំ ទេឝស្យ វិបក្ឞោ ទេឝោ រាជ្យស្យ វិបក្ឞោ រាជ្យំ ភវិឞ្យតិ, ស្ថានេ ស្ថានេ ច ទុព៌្ហិក្ឞំ មហាមារី ភូកម្បឝ្ច ភវិឞ្យន្តិ,</para>
  <para style="p">
    <verse number="8" style="v"/>ឯតានិ ទុះខោបក្រមាះ។</para>
  <para style="p">
    <verse number="9" style="v"/>តទានីំ លោកា ទុះខំ ភោជយិតុំ យុឞ្មាន៑ បរករេឞុ សមប៌យិឞ្យន្តិ ហនិឞ្យន្តិ ច, តថា មម នាមការណាទ៑ យូយំ សវ៌្វទេឝីយមនុជានាំ សមីបេ ឃ្ឫណាហ៌ា ភវិឞ្យថ។</para>
  <para style="p">
    <verse number="10" style="v"/>ពហុឞុ វិឃ្នំ ប្រាប្តវត្សុ បរស្បរម៑ ឫृតីយាំ ក្ឫតវត្សុ ច ឯកោៜបរំ បរករេឞុ សមប៌យិឞ្យតិ។</para>
  <para style="p">
    <verse number="11" style="v"/>តថា ពហវោ ម្ឫឞាភវិឞ្យទ្វាទិន ឧបស្ថាយ ពហូន៑ ភ្រមយិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="12" style="v"/>ទុឞ្កម៌្មណាំ ពាហុល្យាញ្ច ពហូនាំ ប្រេម ឝីតលំ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="13" style="v"/>កិន្តុ យះ កឝ្ចិត៑ ឝេឞំ យាវទ៑ ធៃយ៌្យមាឝ្រយតេ, សឯវ បរិត្រាយិឞ្យតេ។</para>
  <para style="p">
    <verse number="14" style="v"/>អបរំ សវ៌្វទេឝីយលោកាន៑ ប្រតិមាក្ឞី ភវិតុំ រាជស្យ ឝុភសមាចារះ សវ៌្វជគតិ ប្រចារិឞ្យតេ, ឯតាទ្ឫឝិ សតិ យុគាន្ត ឧបស្ថាស្យតិ។</para>
  <para style="p">
    <verse number="15" style="v"/>អតោ យត៑ សវ៌្វនាឝក្ឫទ្ឃ្ឫណាហ៌ំ វស្តុ ទានិយេល្ភវិឞ្យទ្វទិនា ប្រោក្តំ តទ៑ យទា បុណ្យស្ថានេ ស្ថាបិតំ ទ្រក្ឞ្យថ, (យះ បឋតិ, ស ពុធ្យតាំ)</para>
  <para style="p">
    <verse number="16" style="v"/>តទានីំ យេ យិហូទីយទេឝេ តិឞ្ឋន្តិ, តេ បវ៌្វតេឞុ បលាយន្តាំ។</para>
  <para style="p">
    <verse number="17" style="v"/>យះ កឝ្ចិទ៑ គ្ឫហប្ឫឞ្ឋេ តិឞ្ឋតិ, ស គ្ឫហាត៑ កិមបិ វស្ត្វានេតុម៑ អធេा នាវរោហេត៑។</para>
  <para style="p">
    <verse number="18" style="v"/>យឝ្ច ក្ឞេត្រេ តិឞ្ឋតិ, សោបិ វស្ត្រមានេតុំ បរាវ្ឫត្យ ន យាយាត៑។</para>
  <para style="p">
    <verse number="19" style="v"/>តទានីំ គព៌្ហិណីស្តន្យបាយយិត្រីណាំ ទុគ៌តិ រ្ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="20" style="v"/>អតោ យឞ្មាកំ បលាយនំ ឝីតកាលេ វិឝ្រាមវារេ វា យន្ន ភវេត៑, តទត៌្ហំ ប្រាត៌្ហយធ្វម៑។</para>
  <para style="p">
    <verse number="21" style="v"/>អា ជគទារម្ភាទ៑ ឯតត្កាលបយ៌្យនន្តំ យាទ្ឫឝះ កទាបិ នាភវត៑ ន ច ភវិឞ្យតិ តាទ្ឫឝោ មហាក្លេឝស្តទានីម៑ ឧបស្ថាស្យតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>តស្យ ក្លេឝស្យ សមយោ យទិ ហ្ស្វោ ន ក្រិយេត, តហ៌ិ កស្យាបិ ប្រាណិនោ រក្ឞណំ ភវិតុំ ន ឝក្នុយាត៑, កិន្តុ មនោនីតមនុជានាំ ក្ឫតេ ស កាលោ ហ្ស្វីករិឞ្យតេ។</para>
  <para style="p">
    <verse number="23" style="v"/>អបរញ្ច បឝ្យត, ខ្រីឞ្ដោៜត្រ វិទ្យតេ, វា តត្រ វិទ្យតេ, តទានីំ យទី កឝ្ចិទ៑ យុឞ្មាន ឥតិ វាក្យំ វទតិ, តថាបិ តត៑ ន ប្រតីត៑។</para>
  <para style="p">
    <verse number="24" style="v"/>យតោ ភាក្តខ្រីឞ្ដា ភាក្តភវិឞ្យទ្វាទិនឝ្ច ឧបស្ថាយ យានិ មហន្តិ លក្ឞ្មាណិ ចិត្រកម៌្មាណិ ច ប្រកាឝយិឞ្យន្តិ, តៃ រ្យទិ សម្ភវេត៑ តហ៌ិ មនោនីតមានវា អបិ ភ្រាមិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="25" style="v"/>បឝ្យត, ឃដនាតះ បូវ៌្វំ យុឞ្មាន៑ វាត៌្តាម៑ អវាទិឞម៑។</para>
  <para style="p">
    <verse number="26" style="v"/>អតះ បឝ្យត, ស ប្រាន្តរេ វិទ្យត ឥតិ វាក្យេ កេនចិត៑ កថិតេបិ ពហិ រ្មា គច្ឆត, វា បឝ្យត, សោន្តះបុរេ វិទ្យតេ, ឯតទ្វាក្យ ឧក្តេបិ មា ប្រតីត។</para>
  <para style="p">
    <verse number="27" style="v"/>យតោ យថា វិទ្យុត៑ បូវ៌្វទិឝោ និគ៌ត្យ បឝ្ចិមទិឝំ យាវត៑ ប្រកាឝតេ, តថា មានុឞបុត្រស្យាប្យាគមនំ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="28" style="v"/>យត្រ ឝវស្តិឞ្ឋតិ, តត្រេវ គ្ឫធ្រា មិលន្តិ។</para>
  <para style="p">
    <verse number="29" style="v"/>អបរំ តស្យ ក្លេឝសមយស្យាវ្យវហិតបរត្រ សូយ៌្យស្យ តេជោ លោប្ស្យតេ, ចន្ទ្រមា ជ្យោស្នាំ ន ករិឞ្យតិ, នភសោ នក្ឞត្រាណិ បតិឞ្យន្តិ, គគណីយា គ្រហាឝ្ច វិចលិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="30" style="v"/>តទានីម៑ អាកាឝមធ្យេ មនុជសុតស្យ លក្ឞ្ម ទឝ៌ិឞ្យតេ, តតោ និជបរាក្រមេណ មហាតេជសា ច មេឃារូឍំ មនុជសុតំ នភសាគច្ឆន្តំ វិលោក្យ ប្ឫថិវ្យាះ សវ៌្វវំឝីយា វិលបិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="31" style="v"/>តទានីំ ស មហាឝព្ទាយមានតូយ៌្យា វាទកាន៑ និជទូតាន៑ ប្រហេឞ្យតិ, តេ វ្យោម្ន ឯកសីមាតោៜបរសីមាំ យាវត៑ ចតុទ៌ិឝស្តស្យ មនោនីតជនាន៑ អានីយ មេលយិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="32" style="v"/>ឧឌុម្ពរបាទបស្យ ទ្ឫឞ្ដាន្តំ ឝិក្ឞធ្វំ; យទា តស្យ នវីនាះ ឝាខា ជាយន្តេ, បល្លវាទិឝ្ច និគ៌ច្ឆតិ, តទា និទាឃកាលះ សវិធោ ភវតីតិ យូយំ ជានីថ;</para>
  <para style="p">
    <verse number="33" style="v"/>តទ្វទ៑ ឯតា ឃដនា ទ្ឫឞ្ដ្វា ស សមយោ ទ្វារ ឧបាស្ថាទ៑ ឥតិ ជានីត។</para>
  <para style="p">
    <verse number="34" style="v"/>យុឞ្មានហំ តថ្យំ វទាមិ, ឥទានីន្តនជនានាំ គមនាត៑ បូវ៌្វមេវ តានិ សវ៌្វាណិ ឃដិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="35" style="v"/>នភោមេទិន្យោ រ្លុប្តយោរបិ មម វាក៑ កទាបិ ន លោប្ស្យតេ។</para>
  <para style="p">
    <verse number="36" style="v"/>អបរំ មម តាតំ វិនា មានុឞះ ស្វគ៌ស្ថោ ទូតោ វា កោបិ តទ្ទិនំ តទ្ទណ្ឌញ្ច ន ជ្ញាបយតិ។</para>
  <para style="p">
    <verse number="37" style="v"/>អបរំ នោហេ វិទ្យមានេ យាទ្ឫឝមភវត៑ តាទ្ឫឝំ មនុជសុតស្យាគមនកាលេបិ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="38" style="v"/>ផលតោ ជលាប្លាវនាត៑ បូវ៌្វំ យទ្ទិនំ យាវត៑ នោហះ បោតំ នារោហត៑, តាវត្កាលំ យថា មនុឞ្យា ភោជនេ បានេ វិវហនេ វិវាហនេ ច ប្រវ្ឫត្តា អាសន៑;</para>
  <para style="p">
    <verse number="39" style="v"/>អបរម៑ អាប្លាវិតោយមាគត្យ យាវត៑ សកលមនុជាន៑ ប្លាវយិត្វា នានយត៑, តាវត៑ តេ យថា ន វិទាមាសុះ, តថា មនុជសុតាគមនេបិ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="40" style="v"/>តទា ក្ឞេត្រស្ថិតយោទ៌្វយោរេកោ ធារិឞ្យតេ, អបរស្ត្យាជិឞ្យតេ។</para>
  <para style="p">
    <verse number="41" style="v"/>តថា បេឞណ្យា បិំឞត្យោរុភយោ រ្យោឞិតោរេកា ធារិឞ្យតេៜបរា ត្យាជិឞ្យតេ។</para>
  <para style="p">
    <verse number="42" style="v"/>យុឞ្មាកំ ប្រភុះ កស្មិន៑ ទណ្ឌ អាគមិឞ្យតិ, តទ៑ យុឞ្មាភិ រ្នាវគម្យតេ, តស្មាត៑ ជាគ្រតះ សន្តស្តិឞ្ឋត។</para>
  <para style="p">
    <verse number="43" style="v"/>កុត្រ យាមេ ស្តេន អាគមិឞ្យតីតិ ចេទ៑ គ្ឫហស្ថោ ជ្ញាតុម៑ អឝក្ឞ្យត៑, តហ៌ិ ជាគរិត្វា តំ សន្ធិំ កត៌្តិតុម៑ អវារយិឞ្យត៑ តទ៑ ជានីត។</para>
  <para style="p">
    <verse number="44" style="v"/>យុឞ្មាភិរវធីយតាំ, យតោ យុឞ្មាភិ រ្យត្រ ន ពុធ្យតេ, តត្រៃវ ទណ្ឌេ មនុជសុត អាយាស្យតិ។</para>
  <para style="p">
    <verse number="45" style="v"/>ប្រភុ រ្និជបរិវារាន៑ យថាកាលំ ភោជយិតុំ យំ ទាសម៑ អធ្យក្ឞីក្ឫត្យ ស្ថាបយតិ, តាទ្ឫឝោ វិឝ្វាស្យោ ធីមាន៑ ទាសះ កះ?</para>
  <para style="p">
    <verse number="46" style="v"/>ប្រភុរាគត្យ យំ ទាសំ តថាចរន្តំ វីក្ឞតេ, សឯវ ធន្យះ។</para>
  <para style="p">
    <verse number="47" style="v"/>យុឞ្មានហំ សត្យំ វទាមិ, ស តំ និជសវ៌្វស្វស្យាធិបំ ករិឞ្យតិ។</para>
  <para style="p">
    <verse number="48" style="v"/>កិន្តុ ប្រភុរាគន្តុំ វិលម្ពត ឥតិ មនសិ ចិន្តយិត្វា យោ ទុឞ្ដោ ទាសោ</para>
  <para style="p">
    <verse number="49" style="v"/>ៜបរទាសាន៑ ប្រហត៌្តុំ មត្តានាំ សង្គេ ភោក្តុំ បាតុញ្ច ប្រវត៌្តតេ,</para>
  <para style="p">
    <verse number="50" style="v"/>ស ទាសោ យទា នាបេក្ឞតេ, យញ្ច ទណ្ឌំ ន ជានាតិ, តត្កាលឯវ តត្ប្រភុរុបស្ថាស្យតិ។</para>
  <para style="p">
    <verse number="51" style="v"/>តទា តំ ទណ្ឌយិត្វា យត្រ ស្ថានេ រោទនំ ទន្តឃឞ៌ណញ្ចាសាតេ, តត្រ កបដិភិះ សាកំ តទ្ទឝាំ និរូបយិឞ្យតិ។</para>
  <chapter number="25" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យា ទឝ កន្យាះ ប្រទីបាន៑ គ្ឫហ្លត្យោ វរំ សាក្ឞាត៑ កត៌្តុំ ពហិរិតាះ, តាភិស្តទា ស្វគ៌ីយរាជ្យស្យ សាទ្ឫឝ្យំ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="2" style="v"/>តាសាំ កន្យានាំ មធ្យេ បញ្ច សុធិយះ បញ្ច ទុទ៌្ហិយ អាសន៑។</para>
  <para style="p">
    <verse number="3" style="v"/>យា ទុទ៌្ហិយស្តាះ ប្រទីបាន៑ សង្គេ គ្ឫហីត្វា តៃលំ ន ជគ្ឫហុះ,</para>
  <para style="p">
    <verse number="4" style="v"/>កិន្តុ សុធិយះ ប្រទីបាន៑ បាត្រេណ តៃលញ្ច ជគ្ឫហុះ។</para>
  <para style="p">
    <verse number="5" style="v"/>អនន្តរំ វរេ វិលម្ពិតេ តាះ សវ៌្វា និទ្រាវិឞ្ដា និទ្រាំ ជគ្មុះ។</para>
  <para style="p">
    <verse number="6" style="v"/>អនន្តរម៑ អទ៌្ធរាត្រេ បឝ្យត វរ អាគច្ឆតិ, តំ សាក្ឞាត៑ កត៌្តុំ ពហិយ៌ាតេតិ ជនរវាត្</para>
  <para style="p">
    <verse number="7" style="v"/>តាះ សវ៌្វាះ កន្យា ឧត្ថាយ ប្រទីបាន៑ អាសាទយិតុំ អារភន្ត។</para>
  <para style="p">
    <verse number="8" style="v"/>តតោ ទុទ៌្ហិយះ សុធិយ ឩចុះ, កិញ្ចិត៑ តៃលំ ទត្ត, ប្រទីបា អស្មាកំ និវ៌្វាណាះ។</para>
  <para style="p">
    <verse number="9" style="v"/>កិន្តុ សុធិយះ ប្រត្យវទន៑, ទត្តេ យុឞ្មានស្មាំឝ្ច ប្រតិ តៃលំ ន្យូនីភវេត៑, តស្មាទ៑ វិក្រេត្ឫណាំ សមីបំ គត្វា ស្វាត៌្ហំ តៃលំ ក្រីណីត។</para>
  <para style="p">
    <verse number="10" style="v"/>តទា តាសុ ក្រេតុំ គតាសុ វរ អាជគាម, តតោ យាះ សជ្ជិតា អាសន៑, តាស្តេន សាកំ វិវាហីយំ វេឝ្ម ប្រវិវិឝុះ។</para>
  <para style="p">
    <verse number="11" style="v"/>អនន្តរំ ទ្វារេ រុទ្ធេ អបរាះ កន្យា អាគត្យ ជគទុះ, ហេ ប្រភោ, ហេ ប្រភោ, អស្មាន៑ ប្រតិ ទ្វារំ មោចយ។</para>
  <para style="p">
    <verse number="12" style="v"/>កិន្តុ ស ឧក្តវាន៑, តថ្យំ វទាមិ, យុឞ្មានហំ ន វេទ្មិ។</para>
  <para style="p">
    <verse number="13" style="v"/>អតោ ជាគ្រតះ សន្តស្តិឞ្ឋត, មនុជសុតះ កស្មិន៑ ទិនេ កស្មិន៑ ទណ្ឌេ វាគមិឞ្យតិ, តទ៑ យុឞ្មាភិ រ្ន ជ្ញាយតេ។</para>
  <para style="p">
    <verse number="14" style="v"/>អបរំ ស ឯតាទ្ឫឝះ កស្យចិត៑ បុំសស្តុល្យះ, យោ ទូរទេឝំ ប្រតិ យាត្រាកាលេ និជទាសាន៑ អាហូយ តេឞាំ ស្វស្វសាមត៌្ហ្យានុរូបម្</para>
  <para style="p">
    <verse number="15" style="v"/>ឯកស្មិន៑ មុទ្រាណាំ បញ្ច បោដលិកាះ អន្យស្មិំឝ្ច ទ្វេ បោដលិកេ អបរស្មិំឝ្ច បោដលិកៃកាម៑ ឥត្ថំ ប្រតិជនំ សមប៌្យ ស្វយំ ប្រវាសំ គតវាន៑។</para>
  <para style="p">
    <verse number="16" style="v"/>អនន្តរំ យោ ទាសះ បញ្ច បោដលិកាះ លព្ធវាន៑, ស គត្វា វាណិជ្យំ វិធាយ តា ទ្វិគុណីចការ។</para>
  <para style="p">
    <verse number="17" style="v"/>យឝ្ច ទាសោ ទ្វេ បោដលិកេ អលភត, សោបិ តា មុទ្រា ទ្វិគុណីចការ។</para>
  <para style="p">
    <verse number="18" style="v"/>កិន្តុ យោ ទាស ឯកាំ បោដលិកាំ លព្ធវាន៑, ស គត្វា ភូមិំ ខនិត្វា តន្មធ្យេ និជប្រភោស្តា មុទ្រា គោបយាញ្ចការ។</para>
  <para style="p">
    <verse number="19" style="v"/>តទនន្តរំ ពហុតិថេ កាលេ គតេ តេឞាំ ទាសានាំ ប្រភុរាគត្យ តៃទ៌ាសៃះ សមំ គណយាញ្ចការ។</para>
  <para style="p">
    <verse number="20" style="v"/>តទានីំ យះ បញ្ច បោដលិកាះ ប្រាប្តវាន៑ ស តា ទ្វិគុណីក្ឫតមុទ្រា អានីយ ជគាទ; ហេ ប្រភោ, ភវតា មយិ បញ្ច បោដលិកាះ សមប៌ិតាះ, បឝ្យតុ, តា មយា ទ្វិគុណីក្ឫតាះ។</para>
  <para style="p">
    <verse number="21" style="v"/>តទានីំ តស្យ ប្រភុស្តមុវាច, ហេ ឧត្តម វិឝ្វាស្យ ទាស, ត្វំ ធន្យោសិ, ស្តោកេន វិឝ្វាស្យោ ជាតះ, តស្មាត៑ ត្វាំ ពហុវិត្តាធិបំ ករោមិ, ត្វំ ស្វប្រភោះ សុខស្យ ភាគី ភវ។</para>
  <para style="p">
    <verse number="22" style="v"/>តតោ យេន ទ្វេ បោដលិកេ លព្ធេ សោប្យាគត្យ ជគាទ, ហេ ប្រភោ, ភវតា មយិ ទ្វេ បោដលិកេ សមប៌ិតេ, បឝ្យតុ តេ មយា ទ្វិគុណីក្ឫតេ។</para>
  <para style="p">
    <verse number="23" style="v"/>តេន តស្យ ប្រភុស្តមវោចត៑, ហេ ឧត្តម វិឝ្វាស្យ ទាស, ត្វំ ធន្យោសិ, ស្តោកេន វិឝ្វាស្យោ ជាតះ, តស្មាត៑ ត្វាំ ពហុទ្រវិណាធិបំ ករោមិ, ត្វំ និជប្រភោះ សុខស្យ ភាគី ភវ។</para>
  <para style="p">
    <verse number="24" style="v"/>អនន្តរំ យ ឯកាំ បោដលិកាំ លព្ធវាន៑, ស ឯត្យ កថិតវាន៑, ហេ ប្រភោ, ត្វាំ កឋិននរំ ជ្ញាតវាន៑, ត្វយា យត្រ នោប្តំ, តត្រៃវ ក្ឫត្យតេ, យត្រ ច ន កីណ៌ំ, តត្រៃវ សំគ្ឫហ្យតេ។</para>
  <para style="p">
    <verse number="25" style="v"/>អតោហំ សឝង្កះ សន៑ គត្វា តវ មុទ្រា ភូមធ្យេ សំគោប្យ ស្ថាបិតវាន៑, បឝ្យ, តវ យត៑ តទេវ គ្ឫហាណ។</para>
  <para style="p">
    <verse number="26" style="v"/>តទា តស្យ ប្រភុះ ប្រត្យវទត៑ រេ ទុឞ្ដាលស ទាស, យត្រាហំ ន វបាមិ, តត្រ ឆិនទ្មិ, យត្រ ច ន កិរាមិ, តត្រេវ សំគ្ឫហ្លាមីតិ ចេទជានាស្តហ៌ិ</para>
  <para style="p">
    <verse number="27" style="v"/>វណិក្ឞុ មម វិត្តាប៌ណំ តវោចិតមាសីត៑, យេនាហមាគត្យ វ្ឫទ្វ្យា សាកំ មូលមុទ្រាះ ប្រាប្ស្យម៑។</para>
  <para style="p">
    <verse number="28" style="v"/>អតោស្មាត៑ តាំ បោដលិកាម៑ អាទាយ យស្យ ទឝ បោដលិកាះ សន្តិ តស្មិន្នប៌យត។</para>
  <para style="p">
    <verse number="29" style="v"/>យេន វទ៌្វ្យតេ តស្មិន្នៃវាប៌ិឞ្យតេ, តស្យៃវ ច ពាហុល្យំ ភវិឞ្យតិ, កិន្តុ យេន ន វទ៌្វ្យតេ, តស្យាន្តិកេ យត៑ កិញ្ចន តិឞ្ឋតិ, តទបិ បុនន៌េឞ្យតេ។</para>
  <para style="p">
    <verse number="30" style="v"/>អបរំ យូយំ តមកម៌្មណ្យំ ទាសំ នីត្វា យត្រ ស្ថានេ ក្រន្ទនំ ទន្តឃឞ៌ណញ្ច វិទ្យេតេ, តស្មិន៑ ពហិព៌្ហូតតមសិ និក្ឞិបត។</para>
  <para style="p">
    <verse number="31" style="v"/>យទា មនុជសុតះ បវិត្រទូតាន៑ សង្គិនះ ក្ឫត្វា និជប្រភាវេនាគត្យ និជតេជោមយេ សិំហាសនេ និវេក្ឞ្យតិ,</para>
  <para style="p">
    <verse number="32" style="v"/>តទា តត្សម្មុខេ សវ៌្វជាតីយា ជនា សំមេលិឞ្យន្តិ។ តតោ មេឞបាលកោ យថា ឆាគេភ្យោៜវីន៑ ប្ឫថក៑ ករោតិ តថា សោប្យេកស្មាទន្យម៑ ឥត្ថំ តាន៑ ប្ឫថក ក្ឫត្វាវីន្</para>
  <para style="p">
    <verse number="33" style="v"/>ទក្ឞិណេ ឆាគាំឝ្ច វាមេ ស្ថាបយិឞ្យតិ។</para>
  <para style="p">
    <verse number="34" style="v"/>តតះ បរំ រាជា ទក្ឞិណស្ថិតាន៑ មានវាន៑ វទិឞ្យតិ, អាគច្ឆត មត្តាតស្យានុគ្រហភាជនានិ, យុឞ្មត្ក្ឫត អា ជគទារម្ភត៑ យទ៑ រាជ្យម៑ អាសាទិតំ តទធិកុរុត។</para>
  <para style="p">
    <verse number="35" style="v"/>យតោ ពុភុក្ឞិតាយ មហ្យំ ភោជ្យម៑ អទត្ត, បិបាសិតាយ បេយមទត្ត, វិទេឝិនំ មាំ ស្វស្ថានមនយត,</para>
  <para style="p">
    <verse number="36" style="v"/>វស្ត្រហីនំ មាំ វសនំ បយ៌្យធាបយត, បីឌីតំ មាំ ទ្រឞ្ដុមាគច្ឆត, ការាស្ថញ្ច មាំ វីក្ឞិតុម អាគច្ឆត។</para>
  <para style="p">
    <verse number="37" style="v"/>តទា ធាម៌្មិកាះ ប្រតិវទិឞ្យន្តិ, ហេ ប្រភោ, កទា ត្វាំ ក្ឞុធិតំ វីក្ឞ្យ វយមភោជយាម? វា បិបាសិតំ វីក្ឞ្យ អបាយយាម?</para>
  <para style="p">
    <verse number="38" style="v"/>កទា វា ត្វាំ វិទេឝិនំ វិលោក្យ ស្វស្ថានមនយាម? កទា វា ត្វាំ នគ្នំ វីក្ឞ្យ វសនំ បយ៌្យធាបយាម?</para>
  <para style="p">
    <verse number="39" style="v"/>កទា វា ត្វាំ បីឌិតំ ការាស្ថញ្ច វីក្ឞ្យ ត្វទន្តិកមគច្ឆាម?</para>
  <para style="p">
    <verse number="40" style="v"/>តទានីំ រាជា តាន៑ ប្រតិវទិឞ្យតិ, យុឞ្មានហំ សត្យំ វទាមិ, មមៃតេឞាំ ភ្រាត្ឫណាំ មធ្យេ កញ្ចនៃកំ ក្ឞុទ្រតមំ ប្រតិ យទ៑ អកុរុត, តន្មាំ ប្រត្យកុរុត។</para>
  <para style="p">
    <verse number="41" style="v"/>បឝ្ចាត៑ ស វាមស្ថិតាន៑ ជនាន៑ វទិឞ្យតិ, រេ ឝាបគ្រស្តាះ សវ៌្វេ, ឝៃតានេ តស្យ ទូតេភ្យឝ្ច យោៜនន្តវហ្និរាសាទិត អាស្តេ, យូយំ មទន្តិកាត៑ តមគ្និំ គច្ឆត។</para>
  <para style="p">
    <verse number="42" style="v"/>យតោ ក្ឞុធិតាយ មហ្យមាហារំ នាទត្ត, បិបាសិតាយ មហ្យំ បេយំ នាទត្ត,</para>
  <para style="p">
    <verse number="43" style="v"/>វិទេឝិនំ មាំ ស្វស្ថានំ នានយត, វសនហីនំ មាំ វសនំ ន បយ៌្យធាបយត, បីឌិតំ ការាស្ថញ្ច មាំ វីក្ឞិតុំ នាគច្ឆត។</para>
  <para style="p">
    <verse number="44" style="v"/>តទា តេ ប្រតិវទិឞ្យន្តិ, ហេ ប្រភោ, កទា ត្វាំ ក្ឞុធិតំ វា បិបាសិតំ វា វិទេឝិនំ វា នគ្នំ វា បីឌិតំ វា ការាស្ថំ វីក្ឞ្យ ត្វាំ នាសេវាមហិ?</para>
  <para style="p">
    <verse number="45" style="v"/>តទា ស តាន៑ វទិឞ្យតិ, តថ្យមហំ យុឞ្មាន៑ ព្រវីមិ, យុឞ្មាភិរេឞាំ កញ្ចន ក្ឞោទិឞ្ឋំ ប្រតិ យន្នាការិ, តន្មាំ ប្រត្យេវ នាការិ។</para>
  <para style="p">
    <verse number="46" style="v"/>បឝ្ចាទម្យនន្តឝាស្តិំ កិន្តុ ធាម៌្មិកា អនន្តាយុឞំ ភោក្តុំ យាស្យន្តិ។</para>
  <chapter number="26" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យីឝុរេតាន៑ ប្រស្តាវាន៑ សមាប្យ ឝិឞ្យានូចេ,</para>
  <para style="p">
    <verse number="2" style="v"/>យុឞ្មាភិ រ្ជ្ញាតំ ទិនទ្វយាត៑ បរំ និស្តារមហ ឧបស្ថាស្យតិ, តត្រ មនុជសុតះ ក្រុឝេន ហន្តុំ បរករេឞុ សមប៌ិឞ្យតេ។</para>
  <para style="p">
    <verse number="3" style="v"/>តតះ បរំ ប្រធានយាជកាធ្យាបកប្រាញ្ចះ កិយផានាម្នោ មហាយាជកស្យាដ្ដាលិកាយាំ មិលិត្វា</para>
  <para style="p">
    <verse number="4" style="v"/>កេនោបាយេន យីឝុំ ធ្ឫត្វា ហន្តុំ ឝក្នុយុរិតិ មន្ត្រយាញ្ចក្រុះ។</para>
  <para style="p">
    <verse number="5" style="v"/>កិន្តុ តៃរុក្តំ មហកាលេ ន ធត៌្តវ្យះ, ធ្ឫតេ ប្រជានាំ កលហេន ភវិតុំ ឝក្យតេ។</para>
  <para style="p">
    <verse number="6" style="v"/>តតោ ពៃថនិយាបុរេ ឝិមោនាខ្យស្យ កុឞ្ឋិនោ វេឝ្មនិ យីឝៅ តិឞ្ឋតិ</para>
  <para style="p">
    <verse number="7" style="v"/>កាចន យោឞា ឝ្វេតោបលភាជនេន មហាគ៌្ហ្យំ សុគន្ធិ តៃលមានីយ ភោជនាយោបវិឝតស្តស្យ ឝិរោភ្យឞេចត៑។</para>
  <para style="p">
    <verse number="8" style="v"/>កិន្តុ តទាលោក្យ តច្ឆិឞ្យៃះ កុបិតៃរុក្តំ, កុត ឥត្ថមបវ្យយតេ?</para>
  <para style="p">
    <verse number="9" style="v"/>ចេទិទំ វ្យក្រេឞ្យត, តហ៌ិ ភូរិមូល្យំ ប្រាប្យ ទរិទ្រេភ្យោ វ្យតារិឞ្យត។</para>
  <para style="p">
    <verse number="10" style="v"/>យីឝុនា តទវគត្យ តេ សមុទិតាះ, យោឞាមេនាំ កុតោ ទុះខិនីំ កុរុថ, សា មាំ ប្រតិ សាធុ កម៌្មាកាឞ៌ីត៑។</para>
  <para style="p">
    <verse number="11" style="v"/>យុឞ្មាកមំ សមីបេ ទរិទ្រាះ សតតមេវាសតេ, កិន្តុ យុឞ្មាកមន្តិកេហំ នាសេ សតតំ។</para>
  <para style="p">
    <verse number="12" style="v"/>សា មម កាយោបរិ សុគន្ធិតៃលំ សិក្ត្វា មម ឝ្មឝានទានកម៌្មាកាឞ៌ីត៑។</para>
  <para style="p">
    <verse number="13" style="v"/>អតោហំ យុឞ្មាន៑ តថ្យំ វទាមិ សវ៌្វស្មិន៑ ជគតិ យត្រ យត្រៃឞ សុសមាចារះ ប្រចារិឞ្យតេ, តត្រ តត្រៃតស្យា នាយ៌្យាះ ស្មរណាត៌្ហម៑ កម៌្មេទំ ប្រចារិឞ្យតេ។</para>
  <para style="p">
    <verse number="14" style="v"/>តតោ ទ្វាទឝឝិឞ្យាណាម៑ ឦឞ្ករិយោតីយយិហូទានាមក ឯកះ ឝិឞ្យះ ប្រធានយាជកានាមន្តិកំ គត្វា កថិតវាន៑,</para>
  <para style="p">
    <verse number="15" style="v"/>យទិ យុឞ្មាកំ ករេឞុ យីឝុំ សមប៌យាមិ, តហ៌ិ កិំ ទាស្យថ? តទានីំ តេ តស្មៃ ត្រិំឝន្មុទ្រា ទាតុំ ស្ថិរីក្ឫតវន្តះ។</para>
  <para style="p">
    <verse number="16" style="v"/>ស តទារភ្យ តំ បរករេឞុ សមប៌យិតុំ សុយោគំ ចេឞ្ដិតវាន៑។</para>
  <para style="p">
    <verse number="17" style="v"/>អនន្តរំ កិណ្វឝូន្យបូបបវ៌្វណះ ប្រថមេហ្និ ឝិឞ្យា យីឝុម៑ ឧបគត្យ បប្រច្ឆុះ ភវត្ក្ឫតេ កុត្រ វយំ និស្តារមហភោជ្យម៑ អាយោជយិឞ្យាមះ? ភវតះ កេច្ឆា?</para>
  <para style="p">
    <verse number="18" style="v"/>តទា ស គទិតវាន៑, មធ្យេនគរមមុកបុំសះ សមីបំ វ្រជិត្វា វទត, គុរុ រ្គទិតវាន៑, មត្កាលះ សវិធះ, សហ ឝិឞ្យៃស្ត្វទាលយេ និស្តារមហភោជ្យំ ភោក្ឞ្យេ។</para>
  <para style="p">
    <verse number="19" style="v"/>តទា ឝិឞ្យា យីឝោស្តាទ្ឫឝនិទេឝានុរូបកម៌្ម វិធាយ តត្រ និស្តារមហភោជ្យមាសាទយាមាសុះ។</para>
  <para style="p">
    <verse number="20" style="v"/>តតះ សន្ធ្យាយាំ សត្យាំ ទ្វាទឝភិះ ឝិឞ្យៃះ សាកំ ស ន្យវិឝត៑។</para>
  <para style="p">
    <verse number="21" style="v"/>អបរំ ភុញ្ជាន ឧក្តវាន៑ យុឞ្មាន៑ តថ្យំ វទាមិ, យុឞ្មាកមេកោ មាំ បរករេឞុ សមប៌យិឞ្យតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>តទា តេៜតីវ ទុះខិតា ឯកៃកឝោ វក្តុមារេភិរេ, ហេ ប្រភោ, ស កិមហំ?</para>
  <para style="p">
    <verse number="23" style="v"/>តតះ ស ជគាទ, មយា សាកំ យោ ជនោ ភោជនបាត្រេ ករំ សំក្ឞិបតិ, ស ឯវ មាំ បរករេឞុ សមប៌យិឞ្យតិ។</para>
  <para style="p">
    <verse number="24" style="v"/>មនុជសុតមធិ យាទ្ឫឝំ លិខិតមាស្តេ, តទនុរូបា តទ្គតិ រ្ភវិឞ្យតិ; កិន្តុ យេន បុំសា ស បរករេឞុ សមប៌យិឞ្យតេ, ហា ហា ចេត៑ ស នាជនិឞ្យត, តទា តស្យ ក្ឞេមមភវិឞ្យត៑។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា យិហូទានាមា យោ ជនស្តំ បរករេឞុ សមប៌យិឞ្យតិ, ស ឧក្តវាន៑, ហេ គុរោ, ស កិមហំ? តតះ ស ប្រត្យុក្តវាន៑, ត្វយា សត្យំ គទិតម៑។</para>
  <para style="p">
    <verse number="26" style="v"/>អនន្តរំ តេឞាមឝនកាលេ យីឝុះ បូបមាទាយេឝ្វរីយគុណាននូទ្យ ភំក្ត្វា ឝិឞ្យេភ្យះ ប្រទាយ ជគាទ, មទ្វបុះស្វរូបមិមំ គ្ឫហីត្វា ខាទត។</para>
  <para style="p">
    <verse number="27" style="v"/>បឝ្ចាត៑ ស កំសំ គ្ឫហ្លន៑ ឦឝ្វរីយគុណាននូទ្យ តេភ្យះ ប្រទាយ កថិតវាន៑, សវ៌្វៃ រ្យុឞ្មាភិរនេន បាតវ្យំ,</para>
  <para style="p">
    <verse number="28" style="v"/>យស្មាទនេកេឞាំ បាបមឞ៌ណាយ បាតិតំ យន្មន្នូត្ននិយមរូបឝោណិតំ តទេតត៑។</para>
  <para style="p">
    <verse number="29" style="v"/>អបរមហំ នូត្នគោស្តនីរសំ ន បាស្យាមិ, តាវត៑ គោស្តនីផលរសំ បុនះ កទាបិ ន បាស្យាមិ។</para>
  <para style="p">
    <verse number="30" style="v"/>បឝ្ចាត៑ តេ គីតមេកំ សំគីយ ជៃតុនាខ្យគិរិំ គតវន្តះ។</para>
  <para style="p">
    <verse number="31" style="v"/>តទានីំ យីឝុស្តានវោចត៑, អស្យាំ រជន្យាមហំ យុឞ្មាកំ សវ៌្វេឞាំ វិឃ្នរូបោ ភវិឞ្យាមិ, យតោ លិខិតមាស្តេ, "មេឞាណាំ រក្ឞកោ យស្តំ ប្រហរិឞ្យាម្យហំ តតះ។ មេឞាណាំ និវហោ នូនំ ប្រវិកីណ៌ោ ភវិឞ្យតិ"៕</para>
  <para style="p">
    <verse number="32" style="v"/>កិន្តុ ឝ្មឝានាត៑ សមុត្ថាយ យុឞ្មាកមគ្រេៜហំ គាលីលំ គមិឞ្យាមិ។</para>
  <para style="p">
    <verse number="33" style="v"/>បិតរស្តំ ប្រោវាច, ភវាំឝ្ចេត៑ សវ៌្វេឞាំ វិឃ្នរូបោ ភវតិ, តថាបិ មម ន ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="34" style="v"/>តតោ យីឝុនា ស ឧក្តះ, តុភ្យមហំ តថ្យំ កថយាមិ, យាមិន្យាមស្យាំ ចរណាយុធស្យ រវាត៑ បូវ៌្វំ ត្វំ មាំ ត្រិ រ្នាង្គីករិឞ្យសិ។</para>
  <para style="p">
    <verse number="35" style="v"/>តតះ បិតរ ឧទិតវាន៑, យទ្យបិ ត្វយា សមំ មត៌្តវ្យំ, តថាបិ កទាបិ ត្វាំ ន នាង្គីករិឞ្យាមិ; តថៃវ សវ៌្វេ ឝិឞ្យាឝ្ចោចុះ។</para>
  <para style="p">
    <verse number="36" style="v"/>អនន្តរំ យីឝុះ ឝិឞ្យៃះ សាកំ គេត្ឝិមានីនាមកំ ស្ថានំ ប្រស្ថាយ តេភ្យះ កថិតវាន៑, អទះ ស្ថានំ គត្វា យាវទហំ ប្រាត៌្ហយិឞ្យេ តាវទ៑ យូយមត្រោបវិឝត។</para>
  <para style="p">
    <verse number="37" style="v"/>បឝ្ចាត៑ ស បិតរំ សិវទិយសុតៅ ច សង្គិនះ ក្ឫត្វា គតវាន៑, ឝោកាកុលោៜតីវ វ្យថិតឝ្ច ពភូវ។</para>
  <para style="p">
    <verse number="38" style="v"/>តានវាទីច្ច ម្ឫតិយាតនេវ មត្ប្រាណានាំ យាតនា ជាយតេ, យូយមត្រ មយា សាទ៌្ធំ ជាគ្ឫត។</para>
  <para style="p">
    <verse number="39" style="v"/>តតះ ស កិញ្ចិទ្ទូរំ គត្វាធោមុខះ បតន៑ ប្រាត៌្ហយាញ្ចក្រេ, ហេ មត្បិតយ៌ទិ ភវិតុំ ឝក្នោតិ, តហ៌ិ កំសោៜយំ មត្តោ ទូរំ យាតុ; កិន្តុ មទិច្ឆាវត៑ ន ភវតុ, ត្វទិច្ឆាវទ៑ ភវតុ។</para>
  <para style="p">
    <verse number="40" style="v"/>តតះ ស ឝិឞ្យានុបេត្យ តាន៑ និទ្រតោ និរីក្ឞ្យ បិតរាយ កថយាមាស, យូយំ មយា សាកំ ទណ្ឌមេកមបិ ជាគរិតុំ នាឝន្កុត?</para>
  <para style="p">
    <verse number="41" style="v"/>បរីក្ឞាយាំ ន បតិតុំ ជាគ្ឫត ប្រាត៌្ហយធ្វញ្ច; អាត្មា សមុទ្យតោស្តិ, កិន្តុ វបុ រ្ទុព៌្ពលំ។</para>
  <para style="p">
    <verse number="42" style="v"/>ស ទ្វិតីយវារំ ប្រាត៌្ហយាញ្ចក្រេ, ហេ មត្តាត, ន បីតេ យទិ កំសមិទំ មត្តោ ទូរំ យាតុំ ន ឝក្នោតិ, តហ៌ិ ត្វទិច្ឆាវទ៑ ភវតុ។</para>
  <para style="p">
    <verse number="43" style="v"/>ស បុនរេត្យ តាន៑ និទ្រតោ ទទឝ៌, យតស្តេឞាំ នេត្រាណិ និទ្រយា បូណ៌ាន្យាសន៑។</para>
  <para style="p">
    <verse number="44" style="v"/>បឝ្ចាត៑ ស តាន៑ វិហាយ វ្រជិត្វា ត្ឫតីយវារំ បូវ៌្វវត៑ កថយន៑ ប្រាត៌្ហិតវាន៑។</para>
  <para style="p">
    <verse number="45" style="v"/>តតះ ឝិឞ្យានុបាគត្យ គទិតវាន៑, សាម្ប្រតំ ឝយានាះ កិំ វិឝ្រាម្យថ? បឝ្យត, សមយ ឧបាស្ថាត៑, មនុជសុតះ បាបិនាំ ករេឞុ សមប៌្យតេ។</para>
  <para style="p">
    <verse number="46" style="v"/>ឧត្តិឞ្ឋត, វយំ យាមះ, យោ មាំ បរករេឞុ មសប៌យិឞ្យតិ, បឝ្យត, ស សមីបមាយាតិ។</para>
  <para style="p">
    <verse number="47" style="v"/>ឯតត្កថាកថនកាលេ ទ្វាទឝឝិឞ្យាណាមេកោ យិហូទានាមកោ មុខ្យយាជកលោកប្រាចីនៃះ ប្រហិតាន៑ អសិធារិយឞ្ដិធារិណោ មនុជាន៑ គ្ឫហីត្វា តត្សមីបមុបតស្ថៅ។</para>
  <para style="p">
    <verse number="48" style="v"/>អសៅ បរករេឞ្វប៌យិតា បូវ៌្វំ តាន៑ ឥត្ថំ សង្កេតយាមាស, យមហំ ចុម្ពិឞ្យេ, សោៜសៅ មនុជះ,សឯវ យុឞ្មាភិ រ្ធាយ៌្យតាំ។</para>
  <para style="p">
    <verse number="49" style="v"/>តទា ស សបទិ យីឝុមុបាគត្យ ហេ គុរោ, ប្រណមាមីត្យុក្ត្វា តំ ចុចុម្ពេ។</para>
  <para style="p">
    <verse number="50" style="v"/>តទា យីឝុស្តមុវាច, ហេ មិត្រំ កិមត៌្ហមាគតោសិ? តទា តៃរាគត្យ យីឝុរាក្រម្យ ទឃ្រេ។</para>
  <para style="p">
    <verse number="51" style="v"/>តតោ យីឝោះ សង្គិនាមេកះ ករំ ប្រសាយ៌្យ កោឞាទសិំ ពហិឞ្ក្ឫត្យ មហាយាជកស្យ ទាសមេកមាហត្យ តស្យ កណ៌ំ ចិច្ឆេទ។</para>
  <para style="p">
    <verse number="52" style="v"/>តតោ យីឝុស្តំ ជគាទ, ខឌ្គំ ស្វស្ថានេे និធេហិ យតោ យេ យេ ជនា អសិំ ធារយន្តិ, តឯវាសិនា វិនឝ្យន្តិ។</para>
  <para style="p">
    <verse number="53" style="v"/>អបរំ បិតា យថា មទន្តិកំ ស្វគ៌ីយទូតានាំ ទ្វាទឝវាហិនីតោៜធិកំ ប្រហិណុយាត៑ មយា តមុទ្ទិឝ្យេទានីមេវ តថា ប្រាត៌្ហយិតុំ ន ឝក្យតេ, ត្វយា កិមិត្ថំ ជ្ញាយតេ?</para>
  <para style="p">
    <verse number="54" style="v"/>តថា សតីត្ថំ ឃដិឞ្យតេ ធម៌្មបុស្តកស្យ យទិទំ វាក្យំ តត៑ កថំ សិធ្យេត៑?</para>
  <para style="p">
    <verse number="55" style="v"/>តទានីំ យីឝុ រ្ជននិវហំ ជគាទ, យូយំ ខឌ្គយឞ្ដីន៑ អាទាយ មាំ កិំ ចៅរំ ធត៌្តុមាយាតាះ? អហំ ប្រត្យហំ យុឞ្មាភិះ សាកមុបវិឝ្យ សមុបាទិឝំ, តទា មាំ នាធរត;</para>
  <para style="p">
    <verse number="56" style="v"/>កិន្តុ ភវិឞ្យទ្វាទិនាំ វាក្យានាំ សំសិទ្ធយេ សវ៌្វមេតទភូត៑។ តទា សវ៌្វេ ឝិឞ្យាស្តំ វិហាយ បលាយន្ត។</para>
  <para style="p">
    <verse number="57" style="v"/>អនន្តរំ តេ មនុជា យីឝុំ ធ្ឫត្វា យត្រាធ្យាបកប្រាញ្ចះ បរិឞទំ កុវ៌្វន្ត ឧបាវិឝន៑ តត្រ កិយផានាाមកមហាយាជកស្យាន្តិកំ និន្យុះ។</para>
  <para style="p">
    <verse number="58" style="v"/>កិន្តុ ឝេឞេ កិំ ភវិឞ្យតីតិ វេត្តុំ បិតរោ ទូរេ តត្បឝ្ចាទ៑ វ្រជិត្វា មហាយាជកស្យាដ្ដាលិកាំ ប្រវិឝ្យ ទាសៃះ សហិត ឧបាវិឝត៑។</para>
  <para style="p">
    <verse number="59" style="v"/>តទានីំ ប្រធានយាជកប្រាចីនមន្ត្រិណះ សវ៌្វេ យីឝុំ ហន្តុំ ម្ឫឞាសាក្ឞ្យម៑ អលិប្សន្ត,</para>
  <para style="p">
    <verse number="60" style="v"/>កិន្តុ ន លេភិរេ។ អនេកេឞុ ម្ឫឞាសាក្ឞិឞ្វាគតេឞ្វបិ តន្ន ប្រាបុះ។</para>
  <para style="p">
    <verse number="61" style="v"/>ឝេឞេ ទ្វៅ ម្ឫឞាសាក្ឞិណាវាគត្យ ជគទតុះ, បុមានយមកថយត៑, អហមីឝ្វរមន្ទិរំ ភំក្ត្វា ទិនត្រយមធ្យេ តន្និម៌្មាតុំ ឝក្នោមិ។</para>
  <para style="p">
    <verse number="62" style="v"/>តទា មហាយាជក ឧត្ថាយ យីឝុម៑ អវាទីត៑។ ត្វំ កិមបិ ន ប្រតិវទសិ? ត្វាមធិ កិមេតេ សាក្ឞ្យំ វទន្តិ?</para>
  <para style="p">
    <verse number="63" style="v"/>កិន្តុ យីឝុ រ្មៅនីភូយ តស្យៅ។ តតោ មហាយាជក ឧក្តវាន៑, ត្វាម៑ អមរេឝ្វរនាម្នា ឝបយាមិ, ត្វមីឝ្វរស្យ បុត្រោៜភិឞិក្តោ ភវសិ នវេតិ វទ។</para>
  <para style="p">
    <verse number="64" style="v"/>យីឝុះ ប្រត្យវទត៑, ត្វំ សត្យមុក្តវាន៑; អហំ យុឞ្មាន៑ តថ្យំ វទាមិ, ឥតះបរំ មនុជសុតំ សវ៌្វឝក្តិមតោ ទក្ឞិណបាឝ៌្វេ ស្ថាតុំ គគណស្ថំ ជលធរានារុហ្យាយាន្តំ វីក្ឞធ្វេ។</para>
  <para style="p">
    <verse number="65" style="v"/>តទា មហាយាជកោ និជវសនំ ឆិត្ត្វា ជគាទ, ឯឞ ឦឝ្វរំ និន្ទិតវាន៑, អស្មាកមបរសាក្ឞ្យេណ កិំ ប្រយោជនំ? បឝ្យត, យូយមេវាស្យាស្យាទ៑ ឦឝ្វរនិន្ទាំ ឝ្រុតវន្តះ,</para>
  <para style="p">
    <verse number="66" style="v"/>យុឞ្មាភិះ កិំ វិវិច្យតេ? តេ ប្រត្យូចុះ, វធាហ៌ោៜយំ។</para>
  <para style="p">
    <verse number="67" style="v"/>តតោ លោកៃស្តទាស្យេ និឞ្ឋីវិតំ កេចិត៑ ប្រតលមាហត្យ កេចិច្ច ចបេដមាហត្យ ពភាឞិរេ,</para>
  <para style="p">
    <verse number="68" style="v"/>ហេ ខ្រីឞ្ដ ត្វាំ កឝ្ចបេដមាហតវាន៑? ឥតិ គណយិត្វា វទាស្មាន៑។</para>
  <para style="p">
    <verse number="69" style="v"/>បិតរោ ពហិរង្គន ឧបវិឝតិ, តទានីមេកា ទាសី តមុបាគត្យ ពភាឞេ, ត្វំ គាលីលីយយីឝោះ សហចរឯកះ។</para>
  <para style="p">
    <verse number="70" style="v"/>កិន្តុ ស សវ៌្វេឞាំ សមក្ឞម៑ អនង្គីក្ឫត្យាវាទីត៑, ត្វយា យទុច្យតេ, តទត៌្ហមហំ ន វេទ្មិ។</para>
  <para style="p">
    <verse number="71" style="v"/>តទា តស្មិន៑ ពហិទ៌្វារំ គតេ ៜន្យា ទាសី តំ និរីក្ឞ្យ តត្រត្យជនានវទត៑, អយមបិ នាសរតីយយីឝុនា សាទ៌្ធម៑ អាសីត៑។</para>
  <para style="p">
    <verse number="72" style="v"/>តតះ ស ឝបថេន បុនរនង្គីក្ឫត្យ កថិតវាន៑, តំ នរំ ន បរិចិនោមិ។</para>
  <para style="p">
    <verse number="73" style="v"/>ក្ឞណាត៑ បរំ តិឞ្ឋន្តោ ជនា ឯត្យ បិតរម៑ អវទន៑, ត្វមវឝ្យំ តេឞាមេក ឥតិ ត្វទុច្ចារណមេវ ទ្យោតយតិ។</para>
  <para style="p">
    <verse number="74" style="v"/>កិន្តុ សោៜភិឝប្យ កថិតវាន៑, តំ ជនំ នាហំ បរិចិនោមិ, តទា សបទិ កុក្កុដោ រុរាវ។</para>
  <para style="p">
    <verse number="75" style="v"/>កុក្កុដរវាត៑ ប្រាក៑ ត្វំ មាំ ត្រិរបាហ្នោឞ្យសេ, យៃឞា វាគ៑ យីឝុនាវាទិ តាំ បិតរះ សំស្ម្ឫត្យ ពហិរិត្វា ខេទាទ៑ ភ្ឫឝំ ចក្រន្ទ។</para>
  <chapter number="27" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ប្រភាតេ ជាតេ ប្រធានយាជកលោកប្រាចីនា យីឝុំ ហន្តុំ តត្ប្រតិកូលំ មន្ត្រយិត្វា</para>
  <para style="p">
    <verse number="2" style="v"/>តំ ពទ្វ្វា នីត្វា បន្តីយបីលាតាខ្យាធិបេ សមប៌យាមាសុះ។</para>
  <para style="p">
    <verse number="3" style="v"/>តតោ យីឝោះ បរករេវ្វប៌យិតា យិហូទាស្តត្ប្រាណាទណ្ឌាជ្ញាំ វិទិត្វា សន្តប្តមនាះ ប្រធានយាជកលោកប្រាចីនានាំ សមក្ឞំ តាស្ត្រីំឝន្មុទ្រាះ ប្រតិទាយាវាទីត៑,</para>
  <para style="p">
    <verse number="4" style="v"/>ឯតន្និរាគោនរប្រាណបរករាប៌ណាត៑ កលុឞំ ក្ឫតវានហំ។ តទា ត ឧទិតវន្តះ, តេនាស្មាកំ កិំ? ត្វយា តទ៑ ពុធ្យតាម៑។</para>
  <para style="p">
    <verse number="5" style="v"/>តតោ យិហូទា មន្ទិរមធ្យេ តា មុទ្រា និក្ឞិប្យ ប្រស្ថិតវាន៑ ឥត្វា ច ស្វយមាត្មានមុទ្ពពន្ធ។</para>
  <para style="p">
    <verse number="6" style="v"/>បឝ្ចាត៑ ប្រធានយាជកាស្តា មុទ្រា អាទាយ កថិតវន្តះ, ឯតា មុទ្រាះ ឝោណិតមូល្យំ តស្មាទ៑ ភាណ្ឌាគារេ ន និធាតវ្យាះ។</para>
  <para style="p">
    <verse number="7" style="v"/>អនន្តរំ តេ មន្ត្រយិត្វា វិទេឝិនាំ ឝ្មឝានស្ថានាយ តាភិះ កុលាលស្យ ក្ឞេត្រមក្រីណន៑។</para>
  <para style="p">
    <verse number="8" style="v"/>អតោៜទ្យាបិ តត្ស្ថានំ រក្តក្ឞេត្រំ វទន្តិ។</para>
  <para style="p">
    <verse number="9" style="v"/>ឥត្ថំ សតិ ឥស្រាយេលីយសន្តានៃ រ្យស្យ មូល្យំ និរុបិតំ, តស្យ ត្រិំឝន្មុទ្រាមានំ មូល្យំ</para>
  <para style="p">
    <verse number="10" style="v"/>មាំ ប្រតិ បរមេឝ្វរស្យាទេឝាត៑ តេភ្យ អាទីយត, តេន ច កុលាលស្យ ក្ឞេត្រំ ក្រីតមិតិ យទ្វចនំ យិរិមិយភវិឞ្យទ្វាទិនា ប្រោក្តំ តត៑ តទាសិធ្យត៑។</para>
  <para style="p">
    <verse number="11" style="v"/>អនន្តរំ យីឝៅ តទធិបតេះ សម្មុខ ឧបតិឞ្ឋតិ ស តំ បប្រច្ឆ, ត្វំ កិំ យិហូទីយានាំ រាជា? តទា យីឝុស្តមវទត៑, ត្វំ សត្យមុក្តវាន៑។</para>
  <para style="p">
    <verse number="12" style="v"/>កិន្តុ ប្រធានយាជកប្រាចីនៃរភិយុក្តេន តេន កិមបិ ន ប្រត្យវាទិ។</para>
  <para style="p">
    <verse number="13" style="v"/>តតះ បីលាតេន ស ឧទិតះ, ឥមេ ត្វត្ប្រតិកូលតះ កតិ កតិ សាក្ឞ្យំ ទទតិ, តត៑ ត្វំ ន ឝ្ឫណោឞិ?</para>
  <para style="p">
    <verse number="14" style="v"/>តថាបិ ស តេឞាមេកស្យាបិ វចស ឧត្តរំ នោទិតវាន៑; តេន សោៜធិបតិ រ្មហាចិត្រំ វិទាមាស។</para>
  <para style="p">
    <verse number="15" style="v"/>អន្យច្ច តន្មហកាលេៜធិបតេរេតាទ្ឫឝី រាតិរាសីត៑, ប្រជា យំ កញ្ចន ពន្ធិនំ យាចន្តេ, តមេវ ស មោចយតីតិ។</para>
  <para style="p">
    <verse number="16" style="v"/>តទានីំ ពរព្ពានាមា កឝ្ចិត៑ ខ្យាតពន្ធ្យាសីត៑។</para>
  <para style="p">
    <verse number="17" style="v"/>តតះ បីលាតស្តត្រ មិលិតាន៑ លោកាន៑ អប្ឫច្ឆត៑, ឯឞ ពរព្ពា ពន្ធី ខ្រីឞ្ដវិខ្យាតោ យីឝុឝ្ចៃតយោះ កំ មោចយិឞ្យាមិ? យុឞ្មាកំ កិមីប្សិតំ?</para>
  <para style="p">
    <verse number="18" style="v"/>តៃរីឞ៌្យយា ស សមប៌ិត ឥតិ ស ជ្ញាតវាន៑។</para>
  <para style="p">
    <verse number="19" style="v"/>អបរំ វិចារាសនោបវេឝនកាលេ បីលាតស្យ បត្នី ភ្ឫត្យំ ប្រហិត្យ តស្មៃ កថយាមាស, តំ ធាម៌្មិកមនុជំ ប្រតិ ត្វយា កិមបិ ន កត៌្តវ្យំ; យស្មាត៑ តត្ក្ឫតេៜទ្យាហំ ស្វប្នេ ប្រភូតកឞ្ដមលភេ។</para>
  <para style="p">
    <verse number="20" style="v"/>អនន្តរំ ប្រធានយាជកប្រាចីនា ពរព្ពាំ យាចិត្វាទាតុំ យីឝុញ្ច ហន្តុំ សកលលោកាន៑ ប្រាវត៌្តយន៑។</para>
  <para style="p">
    <verse number="21" style="v"/>តតោៜធិបតិស្តាន៑ ប្ឫឞ្ដវាន៑, ឯតយោះ កមហំ មោចយិឞ្យាមិ? យុឞ្មាកំ កេច្ឆា? តេ ប្រោចុ រ្ពរព្ពាំ។</para>
  <para style="p">
    <verse number="22" style="v"/>តទា បីលាតះ បប្រច្ឆ, តហ៌ិ យំ ខ្រីឞ្ដំ វទន្តិ, តំ យីឝុំ កិំ ករិឞ្យាមិ? សវ៌្វេ កថយាមាសុះ, ស ក្រុឝេន វិធ្យតាំ។</para>
  <para style="p">
    <verse number="23" style="v"/>តតោៜធិបតិរវាទីត៑, កុតះ? កិំ តេនាបរាទ្ធំ? កិន្តុ តេ បុនរុចៃ រ្ជគទុះ, ស ក្រុឝេន វិធ្យតាំ។</para>
  <para style="p">
    <verse number="24" style="v"/>តទា និជវាក្យមគ្រាហ្យមភូត៑, កលហឝ្ចាប្យភូត៑, បីលាត ឥតិ វិលោក្យ លោកានាំ សមក្ឞំ តោយមាទាយ ករៅ ប្រក្ឞាល្យាវោចត៑, ឯតស្យ ធាម៌្មិកមនុឞ្យស្យ ឝោណិតបាតេ និទ៌ោឞោៜហំ, យុឞ្មាភិរេវ តទ៑ ពុធ្យតាំ។</para>
  <para style="p">
    <verse number="25" style="v"/>តទា សវ៌្វាះ ប្រជាះ ប្រត្យវោចន៑, តស្យ ឝោណិតបាតាបរាធោៜស្មាកម៑ អស្មត្សន្តានានាញ្ចោបរិ ភវតុ។</para>
  <para style="p">
    <verse number="26" style="v"/>តតះ ស តេឞាំ សមីបេ ពរព្ពាំ មោចយាមាស យីឝុន្តុ កឞាភិរាហត្យ ក្រុឝេន វេធិតុំ សមប៌យាមាស។</para>
  <para style="p">
    <verse number="27" style="v"/>អនន្តរម៑ អធិបតេះ សេនា អធិបតេ រ្គ្ឫហំ យីឝុមានីយ តស្យ សមីបេ សេនាសមូហំ សំជគ្ឫហុះ។</para>
  <para style="p">
    <verse number="28" style="v"/>តតស្តេ តស្យ វសនំ មោចយិត្វា ក្ឫឞ្ណលោហិតវណ៌វសនំ បរិធាបយាមាសុះ</para>
  <para style="p">
    <verse number="29" style="v"/>កណ្ដកានាំ មុកុដំ និម៌្មាយ តច្ឆិរសិ ទទុះ, តស្យ ទក្ឞិណករេ វេត្រមេកំ ទត្ត្វា តស្យ សម្មុខេ ជានូនិ បាតយិត្វា, ហេ យិហូទីយានាំ រាជន៑, តុភ្យំ នម ឥត្យុក្ត្វា តំ តិរឝ្ចក្រុះ,</para>
  <para style="p">
    <verse number="30" style="v"/>តតស្តស្យ គាត្រេ និឞ្ឋីវំ ទត្វា តេន វេត្រេណ ឝិរ អាជឃ្នុះ។</para>
  <para style="p">
    <verse number="31" style="v"/>ឥត្ថំ តំ តិរស្ក្ឫត្យ តទ៑ វសនំ មោចយិត្វា បុនន៌ិជវសនំ បរិធាបយាញ្ចក្រុះ, តំ ក្រុឝេន វេធិតុំ នីតវន្តះ។</para>
  <para style="p">
    <verse number="32" style="v"/>បឝ្ចាត្តេ ពហិព៌្ហូយ កុរីណីយំ ឝិមោន្នាមកមេកំ វិលោក្យ ក្រុឝំ វោឍុំ តមាទទិរេ។</para>
  <para style="p">
    <verse number="33" style="v"/>អនន្តរំ គុល្គល្តាម៑ អត៌្ហាត៑ ឝិរស្កបាលនាមកស្ថានមុ បស្ថាយ តេ យីឝវេ បិត្តមិឝ្រិតាម្លរសំ បាតុំ ទទុះ,</para>
  <para style="p">
    <verse number="34" style="v"/>កិន្តុ ស តមាស្វាទ្យ ន បបៅ។</para>
  <para style="p">
    <verse number="35" style="v"/>តទានីំ តេ តំ ក្រុឝេន សំវិធ្យ តស្យ វសនានិ គុដិកាបាតេន វិភជ្យ ជគ្ឫហុះ, តស្មាត៑, វិភជន្តេៜធរីយំ មេ តេ មនុឞ្យាះ បរស្បរំ។ មទុត្តរីយវស្ត្រាត៌្ហំ គុដិកាំ បាតយន្តិ ច៕ យទេតទ្វចនំ ភវិឞ្យទ្វាទិភិរុក្តមាសីត៑, តទា តទ៑ អសិធ្យត៑,</para>
  <para style="p">
    <verse number="36" style="v"/>បឝ្ចាត៑ តេ តត្រោបវិឝ្យ តទ្រក្ឞណកវ៌្វណិ និយុក្តាស្តស្ថុះ។</para>
  <para style="p">
    <verse number="37" style="v"/>អបរម៑ ឯឞ យិហូទីយានាំ រាជា យីឝុរិត្យបវាទលិបិបត្រំ តច្ឆិរស ឩទ៌្វ្វេ យោជយាមាសុះ។</para>
  <para style="p">
    <verse number="38" style="v"/>តតស្តស្យ វាមេ ទក្ឞិណេ ច ទ្វៅ ចៃរៅ តេន សាកំ ក្រុឝេន វិវិធុះ។</para>
  <para style="p">
    <verse number="39" style="v"/>តទា បាន្ថា និជឝិរោ លាឌយិត្វា តំ និន្ទន្តោ ជគទុះ,</para>
  <para style="p">
    <verse number="40" style="v"/>ហេ ឦឝ្វរមន្ទិរភញ្ជក ទិនត្រយេ តន្និម៌្មាតះ ស្វំ រក្ឞ, ចេត្ត្វមីឝ្វរសុតស្តហ៌ិ ក្រុឝាទវរោហ។</para>
  <para style="p">
    <verse number="41" style="v"/>ប្រធានយាជកាធ្យាបកប្រាចីនាឝ្ច តថា តិរស្ក្ឫត្យ ជគទុះ,</para>
  <para style="p">
    <verse number="42" style="v"/>សោៜន្យជនានាវត៑, កិន្តុ ស្វមវិតុំ ន ឝក្នោតិ។ យទីស្រាយេលោ រាជា ភវេត៑, តហ៌ីទានីមេវ ក្រុឝាទវរោហតុ, តេន តំ វយំ ប្រត្យេឞ្យាមះ។</para>
  <para style="p">
    <verse number="43" style="v"/>ស ឦឝ្វរេ ប្រត្យាឝាមករោត៑, យទីឝ្វរស្តស្មិន៑ សន្តុឞ្ដស្តហ៌ីទានីមេវ តមវេត៑, យតះ ស ឧក្តវាន៑ អហមីឝ្វរសុតះ។</para>
  <para style="p">
    <verse number="44" style="v"/>យៅ ស្តេនៅ សាកំ តេន ក្រុឝេន វិទ្ធៅ តៅ តទ្វទេវ តំ និនិន្ទតុះ។</para>
  <para style="p">
    <verse number="45" style="v"/>តទា ទ្វិតីយយាមាត៑ ត្ឫតីយយាមំ យាវត៑ សវ៌្វទេឝេ តមិរំ ពភូវ,</para>
  <para style="p">
    <verse number="46" style="v"/>ត្ឫតីយយាមេ "ឯលី ឯលី លាមា ឝិវក្តនី", អត៌្ហាត៑ មទីឝ្វរ មទីឝ្វរ កុតោ មាមត្យាក្ឞីះ? យីឝុរុច្ចៃរិតិ ជគាទ។</para>
  <para style="p">
    <verse number="47" style="v"/>តទា តត្រ ស្ថិតាះ កេចិត៑ តត៑ ឝ្រុត្វា ពភាឞិរេ, អយម៑ ឯលិយមាហូយតិ។</para>
  <para style="p">
    <verse number="48" style="v"/>តេឞាំ មធ្យាទ៑ ឯកះ ឝីឃ្រំ គត្វា ស្បញ្ជំ គ្ឫហីត្វា តត្រាម្លរសំ ទត្ត្វា នលេន បាតុំ តស្មៃ ទទៅ។</para>
  <para style="p">
    <verse number="49" style="v"/>ឥតរេៜកថយន៑ តិឞ្ឋត, តំ រក្ឞិតុម៑ ឯលិយ អាយាតិ នវេតិ បឝ្យាមះ។</para>
  <para style="p">
    <verse number="50" style="v"/>យីឝុះ បុនរុចៃរាហូយ ប្រាណាន៑ ជហៅ។</para>
  <para style="p">
    <verse number="51" style="v"/>តតោ មន្ទិរស្យ វិច្ឆេទវសនម៑ ឩទ៌្វ្វាទធោ យាវត៑ ឆិទ្យមានំ ទ្វិធាភវត៑,</para>
  <para style="p">
    <verse number="52" style="v"/>ភូមិឝ្ចកម្បេ ភូធរោវ្យទីយ៌្យត ច។ ឝ្មឝានេ មុក្តេ ភូរិបុណ្យវតាំ សុប្តទេហា ឧទតិឞ្ឋន៑,</para>
  <para style="p">
    <verse number="53" style="v"/>ឝ្មឝានាទ៑ វហិព៌្ហូយ តទុត្ថានាត៑ បរំ បុណ្យបុរំ គត្វា ពហុជនាន៑ ទឝ៌យាមាសុះ។</para>
  <para style="p">
    <verse number="54" style="v"/>យីឝុរក្ឞណាយ និយុក្តះ ឝតសេនាបតិស្តត្សង្គិនឝ្ច តាទ្ឫឝីំ ភូកម្បាទិឃដនាំ ទ្ឫឞ្ដ្វា ភីតា អវទន៑, ឯឞ ឦឝ្វរបុត្រោ ភវតិ។</para>
  <para style="p">
    <verse number="55" style="v"/>យា ពហុយោឞិតោ យីឝុំ សេវមានា គាលីលស្តត្បឝ្ចាទាគតាស្តាសាំ មធ្យេ</para>
  <para style="p">
    <verse number="56" style="v"/>មគ្ទលីនី មរិយម៑ យាកូព្យោឝ្យោ រ្មាតា យា មរិយម៑ សិពទិយបុត្រយោ រ្មាតា ច យោឞិត ឯតា ទូរេ តិឞ្ឋន្ត្យោ ទទ្ឫឝុះ។</para>
  <para style="p">
    <verse number="57" style="v"/>សន្ធ្យាយាំ សត្យម៑ អរិមថិយានគរស្យ យូឞផ្នាមា ធនី មនុជោ យីឝោះ ឝិឞ្យត្វាត្</para>
  <para style="p">
    <verse number="58" style="v"/>បីលាតស្យ សមីបំ គត្វា យីឝោះ កាយំ យយាចេ, តេន បីលាតះ កាយំ ទាតុម៑ អាទិទេឝ។</para>
  <para style="p">
    <verse number="59" style="v"/>យូឞផ៑ តត្កាយំ នីត្វា ឝុចិវស្ត្រេណាច្ឆាទ្យ</para>
  <para style="p">
    <verse number="60" style="v"/>ស្វាត៌្ហំ ឝៃលេ យត៑ ឝ្មឝានំ ចខាន, តន្មធ្យេ តត្កាយំ និធាយ តស្យ ទ្វារិ វ្ឫហត្បាឞាណំ ទទៅ។</para>
  <para style="p">
    <verse number="61" style="v"/>កិន្តុ មគ្ទលីនី មរិយម៑ អន្យមរិយម៑ ឯតេ ស្ត្រិយៅ តត្រ ឝ្មឝានសម្មុខ ឧបវិវិឝតុះ។</para>
  <para style="p">
    <verse number="62" style="v"/>តទនន្តរំ និស្តារោត្សវស្យាយោជនទិនាត៑ បរេៜហនិ ប្រធានយាជកាះ ផិរូឝិនឝ្ច មិលិត្វា បីលាតមុបាគត្យាកថយន៑,</para>
  <para style="p">
    <verse number="63" style="v"/>ហេ មហេច្ឆ ស ប្រតារកោ ជីវន អកថយត៑, ទិនត្រយាត៑ បរំ ឝ្មឝានាទុត្ថាស្យាមិ តទ្វាក្យំ ស្មរាមោ វយំ;</para>
  <para style="p">
    <verse number="64" style="v"/>តស្មាត៑ ត្ឫតីយទិនំ យាវត៑ តត៑ ឝ្មឝានំ រក្ឞិតុមាទិឝតុ, នោចេត៑ តច្ឆិឞ្យា យាមិន្យាមាគត្យ តំ ហ្ឫត្វា លោកាន៑ វទិឞ្យន្តិ, ស ឝ្មឝានាទុទតិឞ្ឋត៑, តថា សតិ ប្រថមភ្រាន្តេះ ឝេឞីយភ្រាន្តិ រ្មហតី ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="65" style="v"/>តទា បីលាត អវាទីត៑, យុឞ្មាកំ សមីបេ រក្ឞិគណ អាស្តេ, យូយំ គត្វា យថា សាធ្យំ រក្ឞយត។</para>
  <para style="p">
    <verse number="66" style="v"/>តតស្តេ គត្វា តទ្ទូाរបាឞាណំ មុទ្រាង្កិតំ ក្ឫត្វា រក្ឞិគណំ និយោជ្យ ឝ្មឝានំ រក្ឞយាមាសុះ។</para>
  <chapter number="28" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>តតះ បរំ វិឝ្រាមវារស្យ ឝេឞេ សប្តាហប្រថមទិនស្យ ប្រភោតេ ជាតេ មគ្ទលីនី មរិយម៑ អន្យមរិយម៑ ច ឝ្មឝានំ ទ្រឞ្ដុមាគតា។</para>
  <para style="p">
    <verse number="2" style="v"/>តទា មហាន៑ ភូកម្បោៜភវត៑; បរមេឝ្វរីយទូតះ ស្វគ៌ាទវរុហ្យ ឝ្មឝានទ្វារាត៑ បាឞាណមបសាយ៌្យ តទុបយ៌្យុបវិវេឝ។</para>
  <para style="p">
    <verse number="3" style="v"/>តទ្វទនំ វិទ្យុទ្វត៑ តេជោមយំ វសនំ ហិមឝុភ្រញ្ច។</para>
  <para style="p">
    <verse number="4" style="v"/>តទានីំ រក្ឞិណស្តទ្ភយាត៑ កម្បិតា ម្ឫតវទ៑ ពភូវះ។</para>
  <para style="p">
    <verse number="5" style="v"/>ស ទូតោ យោឞិតោ ជគាទ, យូយំ មា ភៃឞ្ដ, ក្រុឝហតយីឝុំ ម្ឫគយធ្វេ តទហំ វេទ្មិ។</para>
  <para style="p">
    <verse number="6" style="v"/>សោៜត្រ នាស្តិ, យថាវទត៑ តថោត្ថិតវាន៑; ឯតត៑ ប្រភោះ ឝយនស្ថានំ បឝ្យត។</para>
  <para style="p">
    <verse number="7" style="v"/>តូណ៌ំ គត្វា តច្ឆិឞ្យាន៑ ឥតិ វទត, ស ឝ្មឝានាទ៑ ឧទតិឞ្ឋត៑, យុឞ្មាកមគ្រេ គាលីលំ យាស្យតិ យូយំ តត្រ តំ វីក្ឞិឞ្យធ្វេ, បឝ្យតាហំ វាត៌្តាមិមាំ យុឞ្មានវាទិឞំ។</para>
  <para style="p">
    <verse number="8" style="v"/>តតស្តា ភយាត៑ មហានន្ទាញ្ច ឝ្មឝានាត៑ តូណ៌ំ ពហិព៌្ហូយ តច្ឆិឞ្យាន៑ វាត៌្តាំ វក្តុំ ធាវិតវត្យះ។ កិន្តុ ឝិឞ្យាន៑ វាត៌្តាំ វក្តុំ យាន្តិ, តទា យីឝុ រ្ទឝ៌នំ ទត្ត្វា តា ជគាទ,</para>
  <para style="p">
    <verse number="9" style="v"/>យុឞ្មាកំ កល្យាណំ ភូយាត៑, តតស្តា អាគត្យ តត្បាទយោះ បតិត្វា ប្រណេមុះ។</para>
  <para style="p">
    <verse number="10" style="v"/>យីឝុស្តា អវាទីត៑, មា ពិភីត, យូយំ គត្វា មម ភ្រាត្ឫន៑ គាលីលំ យាតុំ វទត, តត្រ តេ មាំ ទ្រក្ឞ្យន្តិ។</para>
  <para style="p">
    <verse number="11" style="v"/>ស្ត្រិយោ គច្ឆន្តិ, តទា រក្ឞិណាំ កេចិត៑ បុរំ គត្វា យទ្យទ៑ ឃដិតំ តត្សវ៌្វំ ប្រធានយាជកាន៑ ជ្ញាបិតវន្តះ។</para>
  <para style="p">
    <verse number="12" style="v"/>តេ ប្រាចីនៃះ សមំ សំសទំ ក្ឫត្វា មន្ត្រយន្តោ ពហុមុទ្រាះ សេនាភ្យោ ទត្ត្វាវទន៑,</para>
  <para style="p">
    <verse number="13" style="v"/>អស្មាសុ និទ្រិតេឞុ តច្ឆិឞ្យា យាមិន្យាមាគត្យ តំ ហ្ឫត្វានយន៑, ឥតិ យូយំ ប្រចារយត។</para>
  <para style="p">
    <verse number="14" style="v"/>យទ្យេតទធិបតេះ ឝ្រោត្រគោចរីភវេត៑, តហ៌ិ តំ ពោធយិត្វា យុឞ្មានវិឞ្យាមះ។</para>
  <para style="p">
    <verse number="15" style="v"/>តតស្តេ មុទ្រា គ្ឫហីត្វា ឝិក្ឞានុរូបំ កម៌្ម ចក្រុះ, យិហូទីយានាំ មធ្យេ តស្យាទ្យាបិ កិំវទន្តី វិទ្យតេ។</para>
  <para style="p">
    <verse number="16" style="v"/>ឯកាទឝ ឝិឞ្យា យីឝុនិរូបិតាគាលីលស្យាទ្រិំ គត្វា</para>
  <para style="p">
    <verse number="17" style="v"/>តត្រ តំ សំវីក្ឞ្យ ប្រណេមុះ, កិន្តុ កេចិត៑ សន្ទិគ្ធវន្តះ។</para>
  <para style="p">
    <verse number="18" style="v"/>យីឝុស្តេឞាំ សមីបមាគត្យ វ្យាហ្ឫតវាន៑, ស្វគ៌មេទិន្យោះ សវ៌្វាធិបតិត្វភារោ មយ្យប៌ិត អាស្តេ។</para>
  <para style="p">
    <verse number="19" style="v"/>អតោ យូយំ ប្រយាយ សវ៌្វទេឝីយាន៑ ឝិឞ្យាន៑ ក្ឫត្វា បិតុះ បុត្រស្យ បវិត្រស្យាត្មនឝ្ច នាម្នា តានវគាហយត; អហំ យុឞ្មាន៑ យទ្យទាទិឝំ តទបិ បាលយិតុំ តានុបាទិឝត។</para>
  <para style="p">
    <verse number="20" style="v"/>បឝ្យត, ជគទន្តំ យាវត៑ សទាហំ យុឞ្មាភិះ សាកំ តិឞ្ឋាមិ។ ឥតិ។</para>
</usx>
