<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2TI" style="id">Sanskrit Bible (NT) in Khmer Script (សត្យវេទះ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Timothy</para>
  <para style="toc1">២ តីមថិយំ បត្រំ</para>
  <para style="toc2">២ តីមថិយះ</para>
  <para style="toc3">២ តីមថិយះ</para>
  <para style="mt1">២ តីមថិយំ បត្រំ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ខ្រីឞ្ដេន យីឝុនា យា ជីវនស្យ ប្រតិជ្ញា តាមធីឝ្វរស្យេច្ឆយា យីឝោះ ខ្រីឞ្ដស្យៃកះ ប្រេរិតះ បៅលោៜហំ ស្វកីយំ ប្រិយំ ធម៌្មបុត្រំ តីមថិយំ ប្រតិ បត្រំ លិខាមិ។</para>
  <para style="p">
    <verse number="2" style="v"/>តាត ឦឝ្វរោៜស្មាកំ ប្រភុ រ្យីឝុខ្រីឞ្ដឝ្ច ត្វយិ ប្រសាទំ ទយាំ ឝាន្តិញ្ច ក្រិយាស្តាំ។</para>
  <para style="p">
    <verse number="3" style="v"/>អហម៑ អា បូវ៌្វបុរុឞាត៑ យម៑ ឦឝ្វរំ បវិត្រមនសា សេវេ តំ ធន្យំ វទនំ កថយាមិ, អហម៑ អហោរាត្រំ ប្រាត៌្ហនាសមយេ ត្វាំ និរន្តរំ ស្មរាមិ។</para>
  <para style="p">
    <verse number="4" style="v"/>យឝ្ច វិឝ្វាសះ ប្រថមេ លោយីនាមិកាយាំ តវ មាតាមហ្យាម៑ ឧនីកីនាមិកាយាំ មាតរិ ចាតិឞ្ឋត៑ តវាន្តរេៜបិ តិឞ្ឋតីតិ មន្យេ</para>
  <para style="p">
    <verse number="5" style="v"/>តវ តំ និឞ្កបដំ វិឝ្វាសំ មនសិ កុវ៌្វន៑ តវាឝ្រុបាតំ ស្មរន៑ យថានន្ទេន ប្រផល្លោ ភវេយំ តទត៌្ហំ តវ ទឝ៌នម៑ អាកាង្ក្ឞេ។</para>
  <para style="p">
    <verse number="6" style="v"/>អតោ ហេតោ រ្មម ហស្តាប៌ណេន លព្ធោ យ ឦឝ្វរស្យ វរស្ត្វយិ វិទ្យតេ តម៑ ឧជ្ជ្វាលយិតុំ ត្វាំ ស្មារយាមិ។</para>
  <para style="p">
    <verse number="7" style="v"/>យត ឦឝ្វរោៜស្មភ្យំ ភយជនកម៑ អាត្មានម៑ អទត្ត្វា ឝក្តិប្រេមសតក៌តានាម៑ អាករម៑ អាត្មានំ ទត្តវាន៑។</para>
  <para style="p">
    <verse number="8" style="v"/>អតឯវាស្មាកំ ប្រភុមធិ តស្យ វន្ទិទាសំ មាមធិ ច ប្រមាណំ ទាតុំ ន ត្របស្វ កិន្ត្វីឝ្វរីយឝក្ត្យា សុសំវាទស្យ ក្ឫតេ ទុះខស្យ សហភាគី ភវ។</para>
  <para style="p">
    <verse number="9" style="v"/>សោៜស្មាន៑ បរិត្រាណបាត្រាណិ ក្ឫតវាន៑ បវិត្រេណាហ្វានេនាហូតវាំឝ្ច; អស្មត្កម៌្មហេតុនេតិ នហិ ស្វីយនិរូបាណស្យ ប្រសាទស្យ ច ក្ឫតេ តត៑ ក្ឫតវាន៑។ ស ប្រសាទះ ស្ឫឞ្ដេះ បូវ៌្វកាលេ ខ្រីឞ្ដេន យីឝុនាស្មភ្យម៑ អទាយិ,</para>
  <para style="p">
    <verse number="10" style="v"/>កិន្ត្វធុនាស្មាកំ បរិត្រាតុ រ្យីឝោះ ខ្រីឞ្ដស្យាគមនេន ប្រាកាឝត។ ខ្រីឞ្ដោ ម្ឫត្យុំ បរាជិតវាន៑ សុសំវាទេន ច ជីវនម៑ អមរតាញ្ច ប្រកាឝិតវាន៑។</para>
  <para style="p">
    <verse number="11" style="v"/>តស្យ ឃោឞយិតា ទូតឝ្ចាន្យជាតីយានាំ ឝិក្ឞកឝ្ចាហំ និយុក្តោៜស្មិ។</para>
  <para style="p">
    <verse number="12" style="v"/>តស្មាត៑ ការណាត៑ មមាយំ ក្លេឝោ ភវតិ តេន មម លជ្ជា ន ជាយតេ យតោៜហំ យស្មិន៑ វិឝ្វសិតវាន៑ តមវគតោៜស្មិ មហាទិនំ យាវត៑ មមោបនិធេ រ្គោបនស្យ ឝក្តិស្តស្យ វិទ្យត ឥតិ និឝ្ចិតំ ជានាមិ។</para>
  <para style="p">
    <verse number="13" style="v"/>ហិតទាយកានាំ វាក្យានាម៑ អាទឝ៌រូបេណ មត្តះ ឝ្រុតាះ ខ្រីឞ្ដេ យីឝៅ វិឝ្វាសប្រេម្នោះ កថា ធារយ។</para>
  <para style="p">
    <verse number="14" style="v"/>អបរម៑ អស្មទន្តវ៌ាសិនា បវិត្រេណាត្មនា តាមុត្តមាម៑ ឧបនិធិំ គោបយ។</para>
  <para style="p">
    <verse number="15" style="v"/>អាឝិយាទេឝីយាះ សវ៌្វេ មាំ ត្យក្តវន្ត ឥតិ ត្វំ ជានាសិ តេឞាំ មធ្យេ ផូគិល្លោ ហម៌្មគិនិឝ្ច វិទ្យេតេ។</para>
  <para style="p">
    <verse number="16" style="v"/>ប្រភុរនីឞិផរស្យ បរិវារាន៑ ប្រតិ ក្ឫបាំ វិទធាតុ យតះ ស បុនះ បុន រ្មាម៑ អាប្យាយិតវាន្</para>
  <para style="p">
    <verse number="17" style="v"/>មម ឝ្ឫង្ខលេន ន ត្របិត្វា រោមានគរេ ឧបស្ថិតិសមយេ យត្នេន មាំ ម្ឫគយិត្វា មមោទ្ទេឝំ ប្រាប្តវាន៑។</para>
  <para style="p">
    <verse number="18" style="v"/>អតោ វិចារទិនេ ស យថា ប្រភោះ ក្ឫបាភាជនំ ភវេត៑ តាទ្ឫឝំ វរំ ប្រភុស្តស្មៃ ទេយាត៑។ ឥផិឞនគរេៜបិ ស កតិ ប្រការៃ រ្មាម៑ ឧបក្ឫតវាន៑ តត៑ ត្វំ សម្យគ៑ វេត្សិ។</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ហេ មម បុត្រ, ខ្រីឞ្ដយីឝុតោ យោៜនុគ្រហស្តស្យ ពលេន ត្វំ ពលវាន៑ ភវ។</para>
  <para style="p">
    <verse number="2" style="v"/>អបរំ ពហុភិះ សាក្ឞិភិះ ប្រមាណីក្ឫតាំ យាំ ឝិក្ឞាំ ឝ្រុតវានសិ តាំ វិឝ្វាស្យេឞុ បរស្មៃ ឝិក្ឞាទានេ និបុណេឞុ ច លោកេឞុ សមប៌យ។</para>
  <para style="p">
    <verse number="3" style="v"/>ត្វំ យីឝុខ្រីឞ្ដស្យោត្តមោ យោទ្ធេវ ក្លេឝំ សហស្វ។</para>
  <para style="p">
    <verse number="4" style="v"/>យោ យុទ្ធំ ករោតិ ស សាំសារិកេ វ្យាបារេ មគ្នោ ន ភវតិ កិន្តុ ស្វនិយោជយិត្រេ រោចិតុំ ចេឞ្ដតេ។</para>
  <para style="p">
    <verse number="5" style="v"/>អបរំ យោ មល្លៃ រ្យុធ្យតិ ស យទិ និយមានុសារេណ ន យុទ្ធ្យតិ តហ៌ិ កិរីដំ ន លប្ស្យតេ។</para>
  <para style="p">
    <verse number="6" style="v"/>អបរំ យះ ក្ឫឞីវលះ កម៌្ម ករោតិ តេន ប្រថមេន ផលភាគិនា ភវិតវ្យំ។</para>
  <para style="p">
    <verse number="7" style="v"/>មយា យទុច្យតេ តត៑ ត្វយា ពុធ្យតាំ យតះ ប្រភុស្តុភ្យំ សវ៌្វត្រ ពុទ្ធិំ ទាស្យតិ។</para>
  <para style="p">
    <verse number="8" style="v"/>មម សុសំវាទស្យ វចនានុសារាទ៑ ទាយូទ្វំឝីយំ ម្ឫតគណមធ្យាទ៑ ឧត្ថាបិតញ្ច យីឝុំ ខ្រីឞ្ដំ ស្មរ។</para>
  <para style="p">
    <verse number="9" style="v"/>តត្សុសំវាទការណាទ៑ អហំ ទុឞ្កម៌្មេវ ពន្ធនទឝាបយ៌្យន្តំ ក្លេឝំ ភុញ្ជេ កិន្ត្វីឝ្វរស្យ វាក្យម៑ អពទ្ធំ តិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="10" style="v"/>ខ្រីឞ្ដេន យីឝុនា យទ៑ អនន្តគៅរវសហិតំ បរិត្រាណំ ជាយតេ តទភិរុចិតៃ រ្លោកៃរបិ យត៑ លភ្យេត តទត៌្ហមហំ តេឞាំ និមិត្តំ សវ៌្វាណ្យេតានិ សហេ។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរម៑ ឯឞា ភារតី សត្យា យទិ វយំ តេន សាទ៌្ធំ ម្រិយាមហេ តហ៌ិ តេន សាទ៌្ធំ ជីវិវ្យាមះ, យទិ ច ក្លេឝំ សហាមហេ តហ៌ិ តេន សាទ៌្ធំ រាជត្វមបិ ករិឞ្យាមហេ។</para>
  <para style="p">
    <verse number="12" style="v"/>យទិ វយំ តម៑ អនង្គីកុម៌្មស្តហ៌ិ សោ ៜស្មានប្យនង្គីករិឞ្យតិ។</para>
  <para style="p">
    <verse number="13" style="v"/>យទិ វយំ ន វិឝ្វាសាមស្តហ៌ិ ស វិឝ្វាស្យស្តិឞ្ឋតិ យតះ ស្វម៑ អបហ្នោតុំ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="14" style="v"/>ត្វមេតានិ ស្មារយន៑ តេ យថា និឞ្ផលំ ឝ្រោត្ឫណាំ ភ្រំឝជនកំ វាគ្យុទ្ធំ ន កុយ៌្យស្តថា ប្រភោះ សមក្ឞំ ទ្ឫឍំ វិនីយាទិឝ។</para>
  <para style="p">
    <verse number="15" style="v"/>អបរំ ត្វម៑ ឦឝ្វរស្យ សាក្ឞាត៑ ស្វំ បរីក្ឞិតម៑ អនិន្ទនីយកម៌្មការិណញ្ច សត្យមតស្យ វាក្យានាំ សទ្វិភជនេ និបុណញ្ច ទឝ៌យិតុំ យតស្វ។</para>
  <para style="p">
    <verse number="16" style="v"/>កិន្ត្វបវិត្រា អនត៌្ហកកថា ទូរីកុរុ យតស្តទាលម្ពិន ឧត្តរោត្តរម៑ អធម៌្មេ វទ៌្ធិឞ្យន្តេ,</para>
  <para style="p">
    <verse number="17" style="v"/>តេឞាញ្ច វាក្យំ គលិតក្ឞតវត៑ ក្ឞយវទ៌្ធកោ ភវិឞ្យតិ តេឞាំ មធ្យេ ហុមិនាយះ ផិលីតឝ្ចេតិនាមានៅ ទ្វៅ ជនៅ សត្យមតាទ៑ ភ្រឞ្ដៅ ជាតៅ,</para>
  <para style="p">
    <verse number="18" style="v"/>ម្ឫតានាំ បុនរុត្ថិតិ រ្វ្យតីតេតិ វទន្តៅ កេឞាញ្ចិទ៑ វិឝ្វាសម៑ ឧត្បាដយតឝ្ច។</para>
  <para style="p">
    <verse number="19" style="v"/>តថាបីឝ្វរស្យ ភិត្តិមូលម៑ អចលំ តិឞ្ឋតិ តស្មិំឝ្ចេយំ លិបិ រ្មុទ្រាង្កិតា វិទ្យតេ។ យថា, ជានាតិ បរមេឝស្តុ ស្វកីយាន៑ សវ៌្វមានវាន៑។ អបគច្ឆេទ៑ អធម៌្មាច្ច យះ កឝ្ចិត៑ ខ្រីឞ្ដនាមក្ឫត៑៕</para>
  <para style="p">
    <verse number="20" style="v"/>កិន្តុ ព្ឫហន្និកេតនេ កេវល សុវណ៌មយានិ រៅប្យមយាណិ ច ភាជនានិ វិទ្យន្ត ឥតិ តហ៌ិ កាឞ្ឋមយានិ ម្ឫណ្មយាន្យបិ វិទ្យន្តេ តេឞាញ្ច កិយន្តិ សម្មានាយ កិយន្តបមានាយ ច ភវន្តិ។</para>
  <para style="p">
    <verse number="21" style="v"/>អតោ យទិ កឝ្ចិទ៑ ឯតាទ្ឫឝេភ្យះ ស្វំ បរិឞ្ករោតិ តហ៌ិ ស បាវិតំ ប្រភោះ កាយ៌្យយោគ្យំ សវ៌្វសត្កាយ៌្យាយោបយុក្តំ សម្មានាត៌្ហកញ្ច ភាជនំ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>យៅវនាវស្ថាយា អភិលាឞាស្ត្វយា បរិត្យជ្យន្តាំ ធម៌្មោ វិឝ្វាសះ ប្រេម យេ ច ឝុចិមនោភិះ ប្រភុម៑ ឧទ្ទិឝ្យ ប្រាត៌្ហនាំ កុវ៌្វតេ តៃះ សាទ៌្ធម៑ ឰក្យភាវឝ្ចៃតេឞុ ត្វយា យត្នោ វិធីយតាំ។</para>
  <para style="p">
    <verse number="23" style="v"/>អបរំ ត្វម៑ អនត៌្ហកាន៑ អជ្ញានាំឝ្ច ប្រឝ្នាន៑ វាគ្យុទ្ធោត្បាទកាន៑ ជ្ញាត្វា ទូរីកុរុ។</para>
  <para style="p">
    <verse number="24" style="v"/>យតះ ប្រភោ រ្ទាសេន យុទ្ធម៑ អកត៌្តវ្យំ កិន្តុ សវ៌្វាន៑ ប្រតិ ឝាន្តេន ឝិក្ឞាទានេច្ឆុកេន សហិឞ្ណុនា ច ភវិតវ្យំ, វិបក្ឞាឝ្ច តេន នម្រត្វេន ចេតិតវ្យាះ។</para>
  <para style="p">
    <verse number="25" style="v"/>តថា ក្ឫតេ យទីឝ្វរះ សត្យមតស្យ ជ្ញានាត៌្ហំ តេភ្យោ មនះបរិវត៌្តនរូបំ វរំ ទទ្យាត៑,</para>
  <para style="p">
    <verse number="26" style="v"/>តហ៌ិ តេ យេន ឝយតានេន និជាភិលាឞសាធនាយ ធ្ឫតាស្តស្យ ជាលាត៑ ចេតនាំ ប្រាប្យោទ្ធារំ លព្ធុំ ឝក្ឞ្យន្តិ។</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ចរមទិនេឞុ ក្លេឝជនកាះ សមយា ឧបស្ថាស្យន្តីតិ ជានីហិ។</para>
  <para style="p">
    <verse number="2" style="v"/>យតស្តាត្កាលិកា លោកា អាត្មប្រេមិណោ ៜរ្ថប្រេមិណ អាត្មឝ្លាឃិនោ ៜភិមានិនោ និន្ទកាះ បិត្រោរនាជ្ញាគ្រាហិណះ ក្ឫតឃ្នា អបវិត្រាះ</para>
  <para style="p">
    <verse number="3" style="v"/>ប្រីតិវជ៌ិតា អសន្ធេយា ម្ឫឞាបវាទិនោ ៜជិតេន្ទ្រិយាះ ប្រចណ្ឌា ភទ្រទ្វេឞិណោ</para>
  <para style="p">
    <verse number="4" style="v"/>វិឝ្វាសឃាតកា ទុះសាហសិនោ ទប៌ធ្មាតា ឦឝ្វរាប្រេមិណះ កិន្តុ សុខប្រេមិណោ</para>
  <para style="p">
    <verse number="5" style="v"/>ភក្តវេឝាះ កិន្ត្វស្វីក្ឫតភក្តិគុណា ភវិឞ្យន្តិ; ឯតាទ្ឫឝានាំ លោកានាំ សំមគ៌ំ បរិត្យជ។</para>
  <para style="p">
    <verse number="6" style="v"/>យតោ យេ ជនាះ ប្រច្ឆន្នំ គេហាន៑ ប្រវិឝន្តិ បាបៃ រ្ភារគ្រស្តា នានាវិធាភិលាឞៃឝ្ចាលិតា យាះ កាមិន្យោ</para>
  <para style="p">
    <verse number="7" style="v"/>និត្យំ ឝិក្ឞន្តេ កិន្តុ សត្យមតស្យ តត្ត្វជ្ញានំ ប្រាប្តុំ កទាចិត៑ ន ឝក្នុវន្តិ តា ទាសីវទ៑ វឝីកុវ៌្វតេ ច តេ តាទ្ឫឝា លោកាះ។</para>
  <para style="p">
    <verse number="8" style="v"/>យាន្និ រ្យាម្ព្រិឝ្ច យថា មូសមំ ប្រតិ វិបក្ឞត្វម៑ អកុរុតាំ តថៃវ ភ្រឞ្ដមនសោ វិឝ្វាសវិឞយេ ៜគ្រាហ្យាឝ្ចៃតេ លោកា អបិ សត្យមតំ ប្រតិ វិបក្ឞតាំ កុវ៌្វន្តិ។</para>
  <para style="p">
    <verse number="9" style="v"/>កិន្តុ តេ ពហុទូរម៑ អគ្រសរា ន ភវិឞ្យន្តិ យតស្តយោ រ្មូឍតា យទ្វត៑ តទ្វទ៑ ឯតេឞាមបិ មូឍតា សវ៌្វទ្ឫឝ្យា ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="10" style="v"/>មមោបទេឝះ ឝិឞ្ដតាភិប្រាយោ វិឝ្វាសោ រ្ធយ៌្យំ ប្រេម សហិឞ្ណុតោបទ្រវះ ក្លេឝា</para>
  <para style="p">
    <verse number="11" style="v"/>អាន្តិយខិយាយាម៑ ឥកនិយេ លូស្ត្រាយាញ្ច មាំ ប្រតិ យទ្យទ៑ អឃដត យាំឝ្ចោបទ្រវាន៑ អហម៑ អសហេ សវ៌្វមេតត៑ ត្វម៑ អវគតោៜសិ កិន្តុ តត្សវ៌្វតះ ប្រភុ រ្មាម៑ ឧទ្ធ្ឫតវាន៑។</para>
  <para style="p">
    <verse number="12" style="v"/>បរន្តុ យាវន្តោ លោកាះ ខ្រីឞ្ដេន យីឝុនេឝ្វរភក្តិម៑ អាចរិតុម៑ ឥច្ឆន្តិ តេឞាំ សវ៌្វេឞាម៑ ឧបទ្រវោ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="13" style="v"/>អបរំ បាបិឞ្ឋាះ ខលាឝ្ច លោកា ភ្រាម្យន្តោ ភ្រមយន្តឝ្ចោត្តរោត្តរំ ទុឞ្ដត្វេន វទ៌្ធិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="14" style="v"/>កិន្តុ ត្វំ យទ៑ យទ៑ អឝិក្ឞថាះ, យច្ច ត្វយិ សមប៌ិតម៑ អភូត៑ តស្មិន៑ អវតិឞ្ឋ, យតះ កស្មាត៑ ឝិក្ឞាំ ប្រាប្តោៜសិ តទ៑ វេត្សិ;</para>
  <para style="p">
    <verse number="15" style="v"/>យានិ ច ធម៌្មឝាស្ត្រាណិ ខ្រីឞ្ដេ យីឝៅ វិឝ្វាសេន បរិត្រាណប្រាប្តយេ ត្វាំ ជ្ញានិនំ កត៌្តុំ ឝក្នុវន្តិ តានិ ត្វំ ឝៃឝវកាលាទ៑ អវគតោៜសិ។</para>
  <para style="p">
    <verse number="16" style="v"/>តត៑ សវ៌្វំ ឝាស្ត្រម៑ ឦឝ្វរស្យាត្មនា ទត្តំ ឝិក្ឞាយៃ ទោឞពោធាយ ឝោធនាយ ធម៌្មវិនយាយ ច ផលយូក្តំ ភវតិ</para>
  <para style="p">
    <verse number="17" style="v"/>តេន ចេឝ្វរស្យ លោកោ និបុណះ សវ៌្វស្មៃ សត្កម៌្មណេ សុសជ្ជឝ្ច ភវតិ។</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ឦឝ្វរស្យ គោចរេ យឝ្ច យីឝុះ ខ្រីឞ្ដះ ស្វីយាគមនកាលេ ស្វរាជត្វេន ជីវតាំ ម្ឫតានាញ្ច លោកានាំ វិចារំ ករិឞ្យតិ តស្យ គោចរេ ៜហំ ត្វាម៑ ឥទំ ទ្ឫឍម៑ អាជ្ញាបយាមិ។</para>
  <para style="p">
    <verse number="2" style="v"/>ត្វំ វាក្យំ ឃោឞយ កាលេៜកាលេ ចោត្សុកោ ភវ បូណ៌យា សហិឞ្ណុតយា ឝិក្ឞយា ច លោកាន៑ ប្រពោធយ ភត៌្សយ វិនយស្វ ច។</para>
  <para style="p">
    <verse number="3" style="v"/>យត ឯតាទ្ឫឝះ សមយ អាយាតិ យស្មិន៑ លោកា យថាត៌្ហម៑ ឧបទេឝម៑ អសហ្យមានាះ កណ៌កណ្ឌូយនវិឝិឞ្ដា ភូត្វា និជាភិលាឞាត៑ ឝិក្ឞកាន៑ សំគ្រហីឞ្យន្តិ</para>
  <para style="p">
    <verse number="4" style="v"/>សត្យមតាច្ច ឝ្រោត្រាណិ និវត៌្ត្យ វិបថគាមិនោ ភូត្វោបាខ្យានេឞុ ប្រវត៌្តិឞ្យន្តេ;</para>
  <para style="p">
    <verse number="5" style="v"/>កិន្តុ ត្វំ សវ៌្វវិឞយេ ប្រពុទ្ធោ ភវ ទុះខភោគំ ស្វីកុរុ សុសំវាទប្រចារកស្យ កម៌្ម សាធយ និជបរិចយ៌្យាំ បូណ៌ត្វេន កុរុ ច។</para>
  <para style="p">
    <verse number="6" style="v"/>មម ប្រាណានាម៑ ឧត្សគ៌ោ ភវតិ មម ប្រស្ថានកាលឝ្ចោបាតិឞ្ឋត៑។</para>
  <para style="p">
    <verse number="7" style="v"/>អហម៑ ឧត្តមយុទ្ធំ ក្ឫតវាន៑ គន្តវ្យមាគ៌ស្យាន្តំ យាវទ៑ ធាវិតវាន៑ វិឝ្វាសញ្ច រក្ឞិតវាន៑។</para>
  <para style="p">
    <verse number="8" style="v"/>ឝេឞំ បុណ្យមុកុដំ មទត៌្ហំ រក្ឞិតំ វិទ្យតេ តច្ច តស្មិន៑ មហាទិនេ យថាត៌្ហវិចារកេណ ប្រភុនា មហ្យំ ទាយិឞ្យតេ កេវលំ មហ្យម៑ ឥតិ នហិ កិន្តុ យាវន្តោ លោកាស្តស្យាគមនម៑ អាកាង្ក្ឞន្តេ តេភ្យះ សវ៌្វេភ្យោ ៜបិ ទាយិឞ្យតេ។</para>
  <para style="p">
    <verse number="9" style="v"/>ត្វំ ត្វរយា មត្សមីបម៑ អាគន្តុំ យតស្វ,</para>
  <para style="p">
    <verse number="10" style="v"/>យតោ ទីមា ឰហិកសំសារម៑ ឦហមានោ មាំ បរិត្យជ្យ ថិឞលនីកីំ គតវាន៑ តថា ក្រីឞ្កិ រ្គាលាតិយាំ គតវាន៑ តីតឝ្ច ទាល្មាតិយាំ គតវាន៑។</para>
  <para style="p">
    <verse number="11" style="v"/>កេវលោ លូកោ មយា សាទ៌្ធំ វិទ្យតេ។ ត្វំ មាក៌ំ សង្គិនំ ក្ឫត្វាគច្ឆ យតះ ស បរិចយ៌្យយា មមោបការី ភវិឞ្យតិ,</para>
  <para style="p">
    <verse number="12" style="v"/>តុខិកញ្ចាហម៑ ឥផិឞនគរំ ប្រេឞិតវាន៑។</para>
  <para style="p">
    <verse number="13" style="v"/>យទ៑ អាច្ឆាទនវស្ត្រំ ត្រោយានគរេ កាប៌ស្យ សន្និធៅ មយា និក្ឞិប្តំ ត្វមាគមនសមយេ តត៑ បុស្តកានិ ច វិឝេឞតឝ្ចម៌្មគ្រន្ថាន៑ អានយ។</para>
  <para style="p">
    <verse number="14" style="v"/>កាំស្យការះ សិកន្ទរោ មម ពហ្វនិឞ្ដំ ក្ឫតវាន៑ ប្រភុស្តស្យ កម៌្មណាំ សមុចិតផលំ ទទាតុ។</para>
  <para style="p">
    <verse number="15" style="v"/>ត្វមបិ តស្មាត៑ សាវធានាស្តិឞ្ឋ យតះ សោៜស្មាកំ វាក្យានាម៑ អតីវ វិបក្ឞោ ជាតះ។</para>
  <para style="p">
    <verse number="16" style="v"/>មម ប្រថមប្រត្យុត្តរសមយេ កោៜបិ មម សហាយោ នាភវត៑ សវ៌្វេ មាំ បយ៌្យត្យជន៑ តាន៑ ប្រតិ តស្យ ទោឞស្យ គណនា ន ភូយាត៑;</para>
  <para style="p">
    <verse number="17" style="v"/>កិន្តុ ប្រភុ រ្មម សហាយោ ៜភវត៑ យថា ច មយា ឃោឞណា សាធ្យេត ភិន្នជាតីយាឝ្ច សវ៌្វេ សុសំវាទំ ឝ្ឫណុយុស្តថា មហ្យំ ឝក្តិម៑ អទទាត៑ តតោ ៜហំ សិំហស្យ មុខាទ៑ ឧទ្ធ្ឫតះ។</para>
  <para style="p">
    <verse number="18" style="v"/>អបរំ សវ៌្វស្មាទ៑ ទុឞ្កម៌្មតះ ប្រភុ រ្មាម៑ ឧទ្ធរិឞ្យតិ និជស្វគ៌ីយរាជ្យំ នេតុំ មាំ តារយិឞ្យតិ ច។ តស្យ ធន្យវាទះ សទាកាលំ ភូយាត៑។ អាមេន៑។</para>
  <para style="p">
    <verse number="19" style="v"/>ត្វំ ប្រិឞ្កាម៑ អាក្កិលម៑ អនីឞិផរស្យ បរិជនាំឝ្ច នមស្កុរុ។</para>
  <para style="p">
    <verse number="20" style="v"/>ឥរាស្តះ ករិន្ថនគរេ ៜតិឞ្ឋត៑ ត្រផិមឝ្ច បីឌិតត្វាត៑ មិលីតនគរេ មយា វ្យហីយត។</para>
  <para style="p">
    <verse number="21" style="v"/>ត្វំ ហេមន្តកាលាត៑ បូវ៌្វម៑ អាគន្តុំ យតស្វ។ ឧពូលះ បូទិ រ្លីនះ ក្លៅទិយា សវ៌្វេ ភ្រាតរឝ្ច ត្វាំ នមស្កុវ៌្វតេ។</para>
  <para style="p">
    <verse number="22" style="v"/>ប្រភុ រ្យីឝុះ ខ្រីឞ្ដស្តវាត្មនា សហ ភូយាត៑។ យុឞ្មាស្វនុគ្រហោ ភូយាត៑។ អាមេន៑។</para>
</usx>
