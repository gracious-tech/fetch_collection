<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JUD" style="id">Sanskrit Bible (NT) in Khmer Script (សត្យវេទះ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Jude</para>
  <para style="toc1">យិហូទាះ បត្រំ</para>
  <para style="toc2">យិហូទាះ</para>
  <para style="toc3">យិហូទាះ</para>
  <para style="mt1">យិហូទាះ បត្រំ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យីឝុខ្រីឞ្ដស្យ ទាសោ យាកូពោ ភ្រាតា យិហូទាស្តាតេនេឝ្វរេណ បវិត្រីក្ឫតាន៑ យីឝុខ្រីឞ្ដេន រក្ឞិតាំឝ្ចាហូតាន៑ លោកាន៑ ប្រតិ បត្រំ លិខតិ។</para>
  <para style="p">
    <verse number="2" style="v"/>ក្ឫបា ឝាន្តិះ ប្រេម ច ពាហុល្យរូបេណ យុឞ្មាស្វធិតិឞ្ឋតុ។</para>
  <para style="p">
    <verse number="3" style="v"/>ហេ ប្រិយាះ, សាធារណបរិត្រាណមធិ យុឞ្មាន៑ ប្រតិ លេខិតុំ មម ពហុយត្នេ ជាតេ បូវ៌្វកាលេ បវិត្រលោកេឞុ សមប៌ិតោ យោ ធម៌្មស្តទត៌្ហំ យូយំ ប្រាណវ្យយេនាបិ សចេឞ្ដា ភវតេតិ វិនយាត៌្ហំ យុឞ្មាន៑ ប្រតិ បត្រលេខនមាវឝ្យកម៑ អមន្យេ។</para>
  <para style="p">
    <verse number="4" style="v"/>យស្មាទ៑ ឯតទ្រូបទណ្ឌប្រាប្តយេ បូវ៌្វំ លិខិតាះ កេចិជ្ជនា អស្មាន៑ ឧបស្ឫប្តវន្តះ, តេ ៜធាម៌្មិកលោកា អស្មាកម៑ ឦឝ្វរស្យានុគ្រហំ ធ្វជីក្ឫត្យ លម្បដតាម៑ អាចរន្តិ, អទ្វិតីយោ ៜធិបតិ រ្យោ ៜស្មាកំ ប្រភុ រ្យីឝុខ្រីឞ្ដស្តំ នាង្គីកុវ៌្វន្តិ។</para>
  <para style="p">
    <verse number="5" style="v"/>តស្មាទ៑ យូយំ បុរា យទ៑ អវគតាស្តត៑ បុន រ្យុឞ្មាន៑ ស្មារយិតុម៑ ឥច្ឆាមិ, ផលតះ ប្រភុរេកក្ឫត្វះ ស្វប្រជា មិសរទេឝាទ៑ ឧទធារ យត៑ តតះ បរម៑ អវិឝ្វាសិនោ វ្យនាឝយត៑។</para>
  <para style="p">
    <verse number="6" style="v"/>យេ ច ស្វគ៌ទូតាះ ស្វីយកត៌្ឫត្វបទេ ន ស្ថិត្វា ស្វវាសស្ថានំ បរិត្យក្តវន្តស្តាន៑ ស មហាទិនស្យ វិចារាត៌្ហម៑ អន្ធការមយេ ៜធះស្ថានេ សទាស្ថាយិភិ រ្ពន្ធនៃរពធ្នាត៑។</para>
  <para style="p">
    <verse number="7" style="v"/>អបរំ សិទោមម៑ អមោរា តន្និកដស្ថនគរាណិ ចៃតេឞាំ និវាសិនស្តត្សមរូបំ វ្យភិចារំ ក្ឫតវន្តោ វិឞមមៃថុនស្យ ចេឞ្ដយា វិបថំ គតវន្តឝ្ច តស្មាត៑ តាន្យបិ ទ្ឫឞ្ដាន្តស្វរូបាណិ ភូត្វា សទាតនវហ្និនា ទណ្ឌំ ភុញ្ជតេ។</para>
  <para style="p">
    <verse number="8" style="v"/>តថៃវេមេ ស្វប្នាចារិណោៜបិ ស្វឝរីរាណិ កលង្កយន្តិ រាជាធីនតាំ ន ស្វីកុវ៌្វន្ត្យុច្ចបទស្ថាន៑ និន្ទន្តិ ច។</para>
  <para style="p">
    <verse number="9" style="v"/>កិន្តុ ប្រធានទិវ្យទូតោ មីខាយេលោ យទា មូសសោ ទេហេ ឝយតានេន វិវទមានះ សមភាឞត តទា តិស្មន៑ និន្ទារូបំ ទណ្ឌំ សមប៌យិតុំ សាហសំ ន ក្ឫត្វាកថយត៑ ប្រភុស្ត្វាំ ភត៌្សយតាំ។</para>
  <para style="p">
    <verse number="10" style="v"/>កិន្ត្វិមេ យន្ន ពុធ្យន្តេ តន្និន្ទន្តិ យច្ច និព៌្ពោធបឝវ ឥវេន្ទ្រិយៃរវគច្ឆន្តិ តេន នឝ្យន្តិ។</para>
  <para style="p">
    <verse number="11" style="v"/>តាន៑ ធិក៑, តេ កាពិលោ មាគ៌េ ចរន្តិ បារិតោឞិកស្យាឝាតោ ពិលិយមោ ភ្រាន្តិមនុធាវន្តិ កោរហស្យ ទុម៌្មុខត្វេន វិនឝ្យន្តិ ច។</para>
  <para style="p">
    <verse number="12" style="v"/>យុឞ្មាកំ ប្រេមភោជ្យេឞុ តេ វិឃ្នជនកា ភវន្តិ, អាត្មម្ភរយឝ្ច ភូត្វា និល៌ជ្ជយា យុឞ្មាភិះ សាទ៌្ធំ ភុញ្ជតេ។ តេ វាយុភិឝ្ចាលិតា និស្តោយមេឃា ហេមន្តកាលិកា និឞ្ផលា ទ្វិ រ្ម្ឫតា ឧន្មូលិតា វ្ឫក្ឞាះ,</para>
  <para style="p">
    <verse number="13" style="v"/>ស្វកីយលជ្ជាផេណោទ្វមកាះ ប្រចណ្ឌាះ សាមុទ្រតរង្គាះ សទាកាលំ យាវត៑ ឃោរតិមិរភាគីនិ ភ្រមណការីណិ នក្ឞត្រាណិ ច ភវន្តិ។</para>
  <para style="p">
    <verse number="14" style="v"/>អាទមតះ សប្តមះ បុរុឞោ យោ ហនោកះ ស តានុទ្ទិឝ្យ ភវិឞ្យទ្វាក្យមិទំ កថិតវាន៑, យថា, បឝ្យ ស្វកីយបុណ្យានាម៑ អយុតៃ រ្វេឞ្ដិតះ ប្រភុះ។</para>
  <para style="p">
    <verse number="15" style="v"/>សវ៌្វាន៑ ប្រតិ វិចារាជ្ញាសាធនាយាគមិឞ្យតិ។ តទា ចាធាម៌្មិកាះ សវ៌្វេ ជាតា យៃរបរាធិនះ។ វិធម៌្មកម៌្មណាំ តេឞាំ សវ៌្វេឞាមេវ ការណាត៑។ តថា តទ្វៃបរីត្យេនាប្យធម៌្មាចារិបាបិនាំ។ ឧក្តកឋោរវាក្យានាំ សវ៌្វេឞាមបិ ការណាត៑។ បរមេឝេន ទោឞិត្វំ តេឞាំ ប្រកាឝយិឞ្យតេ៕</para>
  <para style="p">
    <verse number="16" style="v"/>តេ វាក្កលហការិណះ ស្វភាគ្យនិន្ទកាះ ស្វេច្ឆាចារិណោ ទប៌វាទិមុខវិឝិឞ្ដា លាភាត៌្ហំ មនុឞ្យស្តាវកាឝ្ច សន្តិ។</para>
  <para style="p">
    <verse number="17" style="v"/>កិន្តុ ហេ ប្រិយតមាះ, អស្មាកំ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ ប្រេរិតៃ រ្យទ៑ វាក្យំ បូវ៌្វំ យុឞ្មភ្យំ កថិតំ តត៑ ស្មរត,</para>
  <para style="p">
    <verse number="18" style="v"/>ផលតះ ឝេឞសមយេ ស្វេច្ឆាតោ ៜធម៌្មាចារិណោ និន្ទកា ឧបស្ថាស្យន្តីតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>ឯតេ លោកាះ ស្វាន៑ ប្ឫថក៑ កុវ៌្វន្តះ សាំសារិកា អាត្មហីនាឝ្ច សន្តិ។</para>
  <para style="p">
    <verse number="20" style="v"/>កិន្តុ ហេ ប្រិយតមាះ, យូយំ ស្វេឞាម៑ អតិបវិត្រវិឝ្វាសេ និចីយមានាះ បវិត្រេណាត្មនា ប្រាត៌្ហនាំ កុវ៌្វន្ត</para>
  <para style="p">
    <verse number="21" style="v"/>ឦឝ្វរស្យ ប្រេម្នា ស្វាន៑ រក្ឞត, អនន្តជីវនាយ ចាស្មាកំ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ ក្ឫបាំ ប្រតីក្ឞធ្វំ។</para>
  <para style="p">
    <verse number="22" style="v"/>អបរំ យូយំ វិវិច្យ កាំឝ្ចិទ៑ អនុកម្បធ្វំ</para>
  <para style="p">
    <verse number="23" style="v"/>កាំឝ្ចិទ៑ អគ្និត ឧទ្ធ្ឫត្យ ភយំ ប្រទឝ៌្យ រក្ឞត, ឝារីរិកភាវេន កលង្កិតំ វស្ត្រមបិ ឫតីយធ្វំ។</para>
  <para style="p">
    <verse number="24" style="v"/>អបរញ្ច យុឞ្មាន៑ ស្ខលនាទ៑ រក្ឞិតុម៑ ឧល្លាសេន ស្វីយតេជសះ សាក្ឞាត៑ និទ៌្ទោឞាន៑ ស្ថាបយិតុញ្ច សមត៌្ហោ</para>
  <para style="p">
    <verse number="25" style="v"/>យោ ៜស្មាកម៑ អទ្វិតីយស្ត្រាណកត៌្តា សវ៌្វជ្ញ ឦឝ្វរស្តស្យ គៅរវំ មហិមា បរាក្រមះ កត៌្ឫត្វញ្ចេទានីម៑ អនន្តកាលំ យាវទ៑ ភូយាត៑។ អាមេន៑។</para>
</usx>
