<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1TI" style="id">Sanskrit Bible (NT) in Khmer Script (សត្យវេទះ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">១ តីមថិយំ បត្រំ</para>
  <para style="toc2">១ តីមថិយះ</para>
  <para style="toc3">១ តីមថិយះ</para>
  <para style="mt1">១ តីមថិយំ បត្រំ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អស្មាកំ ត្រាណកត៌្តុរីឝ្វរស្យាស្មាកំ ប្រត្យាឝាភូមេះ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ ចាជ្ញានុសារតោ យីឝុខ្រីឞ្ដស្យ ប្រេរិតះ បៅលះ ស្វកីយំ សត្យំ ធម៌្មបុត្រំ តីមថិយំ ប្រតិ បត្រំ លិខតិ។</para>
  <para style="p">
    <verse number="2" style="v"/>អស្មាកំ តាត ឦឝ្វរោៜស្មាកំ ប្រភុ រ្យីឝុខ្រីឞ្ដឝ្ច ត្វយិ អនុគ្រហំ ទយាំ ឝាន្តិញ្ច កុយ៌្យាស្តាំ។</para>
  <para style="p">
    <verse number="3" style="v"/>មាកិទនិយាទេឝេ មម គមនកាលេ ត្វម៑ ឥផិឞនគរេ តិឞ្ឋន៑ ឥតរឝិក្ឞា ន គ្រហីតវ្យា, អនន្តេឞូបាខ្យានេឞុ វំឝាវលិឞុ ច យុឞ្មាភិ រ្មនោ ន និវេឝិតវ្យម្</para>
  <para style="p">
    <verse number="4" style="v"/>ឥតិ កាំឝ្ចិត៑ លោកាន៑ យទ៑ ឧបទិឝេរេតត៑ មយាទិឞ្ដោៜភវះ, យតះ សវ៌្វៃរេតៃ រ្វិឝ្វាសយុក្តេឝ្វរីយនិឞ្ឋា ន ជាយតេ កិន្តុ វិវាទោ ជាយតេ។</para>
  <para style="p">
    <verse number="5" style="v"/>ឧបទេឝស្យ ត្វភិប្រេតំ ផលំ និម៌្មលាន្តះករណេន សត្សំវេទេន និឞ្កបដវិឝ្វាសេន ច យុក្តំ ប្រេម។</para>
  <para style="p">
    <verse number="6" style="v"/>កេចិត៑ ជនាឝ្ច សវ៌្វាណ្យេតានិ វិហាយ និរត៌្ហកកថានាម៑ អនុគមនេន វិបថគាមិនោៜភវន៑,</para>
  <para style="p">
    <verse number="7" style="v"/>យទ៑ ភាឞន្តេ យច្ច និឝ្ចិន្វន្តិ តន្ន ពុធ្យមានា វ្យវស្ថោបទេឞ្ដារោ ភវិតុម៑ ឥច្ឆន្តិ។</para>
  <para style="p">
    <verse number="8" style="v"/>សា វ្យវស្ថា យទិ យោគ្យរូបេណ គ្ឫហ្យតេ តហ៌្យុត្តមា ភវតីតិ វយំ ជានីមះ។</para>
  <para style="p">
    <verse number="9" style="v"/>អបរំ សា វ្យវស្ថា ធាម៌្មិកស្យ វិរុទ្ធា ន ភវតិ កិន្ត្វធាម៌្មិកោ ៜវាធ្យោ ទុឞ្ដះ បាបិឞ្ឋោ ៜបវិត្រោ ៜឝុចិះ បិត្ឫហន្តា មាត្ឫហន្តា នរហន្តា</para>
  <para style="p">
    <verse number="10" style="v"/>វេឝ្យាគាមី បុំមៃថុនី មនុឞ្យវិក្រេតា មិថ្យាវាទី មិថ្យាឝបថការី ច សវ៌្វេឞាមេតេឞាំ វិរុទ្ធា,</para>
  <para style="p">
    <verse number="11" style="v"/>តថា សច្ចិទានន្ទេឝ្វរស្យ យោ វិភវយុក្តះ សុសំវាទោ មយិ សមប៌ិតស្តទនុយាយិហិតោបទេឝស្យ វិបរីតំ យត៑ កិញ្ចិទ៑ ភវតិ តទ្វិរុទ្ធា សា វ្យវស្ថេតិ តទ្គ្រាហិណា ជ្ញាតវ្យំ។</para>
  <para style="p">
    <verse number="12" style="v"/>មហ្យំ ឝក្តិទាតា យោៜស្មាកំ ប្រភុះ ខ្រីឞ្ដយីឝុស្តមហំ ធន្យំ វទាមិ។</para>
  <para style="p">
    <verse number="13" style="v"/>យតះ បុរា និន្ទក ឧបទ្រាវី ហិំសកឝ្ច ភូត្វាប្យហំ តេន វិឝ្វាស្យោ ៜមន្យេ បរិចារកត្វេ ន្យយុជ្យេ ច។ តទ៑ អវិឝ្វាសាចរណម៑ អជ្ញានេន មយា ក្ឫតមិតិ ហេតោរហំ តេនានុកម្បិតោៜភវំ។</para>
  <para style="p">
    <verse number="14" style="v"/>អបរំ ខ្រីឞ្ដេ យីឝៅ វិឝ្វាសប្រេមភ្យាំ សហិតោៜស្មត្ប្រភោរនុគ្រហោ ៜតីវ ប្រចុរោៜភត៑។</para>
  <para style="p">
    <verse number="15" style="v"/>បាបិនះ បរិត្រាតុំ ខ្រីឞ្ដោ យីឝុ រ្ជគតិ សមវតីណ៌ោៜភវត៑, ឯឞា កថា វិឝ្វាសនីយា សវ៌្វៃ គ្រហណីយា ច។</para>
  <para style="p">
    <verse number="16" style="v"/>តេឞាំ បាបិនាំ មធ្យេៜហំ ប្រថម អាសំ កិន្តុ យេ មានវា អនន្តជីវនប្រាប្ត្យត៌្ហំ តស្មិន៑ វិឝ្វសិឞ្យន្តិ តេឞាំ ទ្ឫឞ្ដាន្តេ មយិ ប្រថមេ យីឝុនា ខ្រីឞ្ដេន ស្វកីយា ក្ឫត្ស្នា ចិរសហិឞ្ណុតា យត៑ ប្រកាឝ្យតេ តទត៌្ហមេវាហម៑ អនុកម្បាំ ប្រាប្តវាន៑។</para>
  <para style="p">
    <verse number="17" style="v"/>អនាទិរក្ឞយោៜទ្ឫឝ្យោ រាជា យោៜទ្វិតីយះ សវ៌្វជ្ញ ឦឝ្វរស្តស្យ គៅរវំ មហិមា ចានន្តកាលំ យាវទ៑ ភូយាត៑។ អាមេន៑។</para>
  <para style="p">
    <verse number="18" style="v"/>ហេ បុត្រ តីមថិយ ត្វយិ យានិ ភវិឞ្យទ្វាក្យានិ បុរា កថិតានិ តទនុសារាទ៑ អហម៑ ឯនមាទេឝំ ត្វយិ សមប៌យាមិ, តស្យាភិប្រាយោៜយំ យត្ត្វំ តៃ រ្វាក្យៃរុត្តមយុទ្ធំ ករោឞិ</para>
  <para style="p">
    <verse number="19" style="v"/>វិឝ្វាសំ សត្សំវេទញ្ច ធារយសិ ច។ អនយោះ បរិត្យាគាត៑ កេឞាញ្ចិទ៑ វិឝ្វាសតរី ភគ្នាភវត៑។</para>
  <para style="p">
    <verse number="20" style="v"/>ហុមិនាយសិកន្ទរៅ តេឞាំ យៅ ទ្វៅ ជនៅ, តៅ យទ៑ ធម៌្មនិន្ទាំ បុន រ្ន កត៌្តុំ ឝិក្ឞេតេ តទត៌្ហំ មយា ឝយតានស្យ ករេ សមប៌ិតៅ។</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>មម ប្រថម អាទេឝោៜយំ, ប្រាត៌្ហនាវិនយនិវេទនធន្យវាទាះ កត៌្តវ្យាះ,</para>
  <para style="p">
    <verse number="2" style="v"/>សវ៌្វេឞាំ មានវានាំ ក្ឫតេ វិឝេឞតោ វយំ យត៑ ឝាន្តត្វេន និវ៌្វិរោធត្វេន ចេឝ្ចរភក្តិំ វិនីតត្វញ្ចាចរន្តះ កាលំ យាបយាមស្តទត៌្ហំ ន្ឫបតីនាម៑ ឧច្ចបទស្ថានាញ្ច ក្ឫតេ តេ កត៌្តវ្យាះ។</para>
  <para style="p">
    <verse number="3" style="v"/>យតោៜស្មាកំ តារកស្យេឝ្វរស្យ សាក្ឞាត៑ តទេវោត្តមំ គ្រាហ្យញ្ច ភវតិ,</para>
  <para style="p">
    <verse number="4" style="v"/>ស សវ៌្វេឞាំ មានវានាំ បរិត្រាណំ សត្យជ្ញានប្រាប្តិញ្ចេច្ឆតិ។</para>
  <para style="p">
    <verse number="5" style="v"/>យត ឯកោៜទ្វិតីយ ឦឝ្វរោ វិទ្យតេ កិញ្ចេឝ្វរេ មានវេឞុ ចៃកោ ៜទ្វិតីយោ មធ្យស្ថះ</para>
  <para style="p">
    <verse number="6" style="v"/>ស នរាវតារះ ខ្រីឞ្ដោ យីឝុ រ្វិទ្យតេ យះ សវ៌្វេឞាំ មុក្តេ រ្មូល្យម៑ អាត្មទានំ ក្ឫតវាន៑។ ឯតេន យេន ប្រមាណេនោបយុក្តេ សមយេ ប្រកាឝិតវ្យំ,</para>
  <para style="p">
    <verse number="7" style="v"/>តទ្ឃោឞយិតា ទូតោ វិឝ្វាសេ សត្យធម៌្មេ ច ភិន្នជាតីយានាម៑ ឧបទេឝកឝ្ចាហំ ន្យយូជ្យេ, ឯតទហំ ខ្រីឞ្ដស្យ នាម្នា យថាតថ្យំ វទាមិ នាន្ឫតំ កថយាមិ។</para>
  <para style="p">
    <verse number="8" style="v"/>អតោ មមាភិមតមិទំ បុរុឞៃះ ក្រោធសន្ទេហៅ វិនា បវិត្រករាន៑ ឧត្តោល្យ សវ៌្វស្មិន៑ ស្ថានេ ប្រាត៌្ហនា ក្រិយតាំ។</para>
  <para style="p">
    <verse number="9" style="v"/>តទ្វត៑ នាយ៌្យោៜបិ សលជ្ជាះ សំយតមនសឝ្ច សត្យោ យោគ្យមាច្ឆាទនំ បរិទធតុ កិញ្ច កេឝសំស្ការៃះ កណកមុក្តាភិ រ្មហាគ៌្ហ្យបរិច្ឆទៃឝ្ចាត្មភូឞណំ ន កុវ៌្វត្យះ</para>
  <para style="p">
    <verse number="10" style="v"/>ស្វីក្ឫតេឝ្វរភក្តីនាំ យោឞិតាំ យោគ្យៃះ សត្យម៌្មភិះ ស្វភូឞណំ កុវ៌្វតាំ។</para>
  <para style="p">
    <verse number="11" style="v"/>នារី សម្បូណ៌វិនីតត្វេន និវ៌ិរោធំ ឝិក្ឞតាំ។</para>
  <para style="p">
    <verse number="12" style="v"/>នាយ៌្យាះ ឝិក្ឞាទានំ បុរុឞាយាជ្ញាទានំ វាហំ នានុជានាមិ តយា និវ៌្វិរោेធត្វម៑ អាចរិតវ្យំ។</para>
  <para style="p">
    <verse number="13" style="v"/>យតះ ប្រថមម៑ អាទមស្តតះ បរំ ហវាយាះ ស្ឫឞ្ដិ រ្ពភូវ។</para>
  <para style="p">
    <verse number="14" style="v"/>កិញ្ចាទម៑ ភ្រាន្តិយុក្តោ នាភវត៑ យោឞិទេវ ភ្រាន្តិយុក្តា ភូត្វាត្យាចារិណី ពភូវ។</para>
  <para style="p">
    <verse number="15" style="v"/>តថាបិ នារីគណោ យទិ វិឝ្វាសេ ប្រេម្និ បវិត្រតាយាំ សំយតមនសិ ច តិឞ្ឋតិ តហ៌្យបត្យប្រសវវត៌្មនា បរិត្រាណំ ប្រាប្ស្យតិ។</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យទិ កឝ្ចិទ៑ អធ្យក្ឞបទម៑ អាកាង្ក្ឞតេ តហ៌ិ ស ឧត្តមំ កម៌្ម លិប្សត ឥតិ សត្យំ។</para>
  <para style="p">
    <verse number="2" style="v"/>អតោៜធ្យក្ឞេណានិន្ទិតេនៃកស្យា យោឞិតោ ភត៌្រា បរិមិតភោគេន សំយតមនសា សភ្យេនាតិថិសេវកេន ឝិក្ឞណេ និបុណេន</para>
  <para style="p">
    <verse number="3" style="v"/>ន មទ្យបេន ន ប្រហារកេណ កិន្តុ ម្ឫទុភាវេន និវ៌្វិវាទេន និល៌ោភេន</para>
  <para style="p">
    <verse number="4" style="v"/>ស្វបរិវារាណាម៑ ឧត្តមឝាសកេន បូណ៌វិនីតត្វាទ៑ វឝ្យានាំ សន្តានានាំ និយន្ត្រា ច ភវិតវ្យំ។</para>
  <para style="p">
    <verse number="5" style="v"/>យត អាត្មបរិវារាន៑ ឝាសិតុំ យោ ន ឝក្នោតិ តេនេឝ្វរស្យ សមិតេស្តត្ត្វាវធារណំ កថំ ការិឞ្យតេ?</para>
  <para style="p">
    <verse number="6" style="v"/>អបរំ ស គវ៌្វិតោ ភូត្វា យត៑ ឝយតាន ឥវ ទណ្ឌយោគ្យោ ន ភវេត៑ តទត៌្ហំ តេន នវឝិឞ្យេណ ន ភវិតវ្យំ។</para>
  <para style="p">
    <verse number="7" style="v"/>យច្ច និន្ទាយាំ ឝយតានស្យ ជាលេ ច ន បតេត៑ តទត៌្ហំ តេន ពហិះស្ថលោកានាមបិ មធ្យេ សុខ្យាតិយុក្តេន ភវិតវ្យំ។</para>
  <para style="p">
    <verse number="8" style="v"/>តទ្វត៑ បរិចារកៃរបិ វិនីតៃ រ្ទ្វិវិធវាក្យរហិតៃ រ្ពហុមទ្យបានេ ៜនាសក្តៃ រ្និល៌ោភៃឝ្ច ភវិតវ្យំ,</para>
  <para style="p">
    <verse number="9" style="v"/>និម៌្មលសំវេទេន ច វិឝ្វាសស្យ និគូឍវាក្យំ ធាតិវ្យញ្ច។</para>
  <para style="p">
    <verse number="10" style="v"/>អគ្រេ តេឞាំ បរីក្ឞា ក្រិយតាំ តតះ បរម៑ អនិន្ទិតា ភូត្វា តេ បរិចយ៌្យាំ កុវ៌្វន្តុ។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរំ យោឞិទ្ភិរបិ វិនីតាភិរនបវាទិកាភិះ សតក៌ាភិះ សវ៌្វត្រ វិឝ្វាស្យាភិឝ្ច ភវិតវ្យំ។</para>
  <para style="p">
    <verse number="12" style="v"/>បរិចារកា ឯកៃកយោឞិតោ ភត៌្តារោ ភវេយុះ, និជសន្តានានាំ បរិជនានាញ្ច សុឝាសនំ កុយ៌្យុឝ្ច។</para>
  <para style="p">
    <verse number="13" style="v"/>យតះ សា បរិចយ៌្យា យៃ រ្ភទ្ររូបេណ សាធ្យតេ តេ ឝ្រេឞ្ឋបទំ ប្រាប្នុវន្តិ ខ្រីឞ្ដេ យីឝៅ វិឝ្វាសេន មហោត្សុកា ភវន្តិ ច។</para>
  <para style="p">
    <verse number="14" style="v"/>ត្វាំ ប្រត្យេតត្បត្រលេខនសមយេ ឝីឃ្រំ ត្វត្សមីបគមនស្យ ប្រត្យាឝា មម វិទ្យតេ។</para>
  <para style="p">
    <verse number="15" style="v"/>យទិ វា វិលម្ពេយ តហ៌ីឝ្វរស្យ គ្ឫហេ ៜរ្ថតះ សត្យធម៌្មស្យ ស្តម្ភភិត្តិមូលស្វរូបាយាម៑ អមរេឝ្វរស្យ សមិតៅ ត្វយា កីទ្ឫឝ អាចារះ កត៌្តវ្យស្តត៑ ជ្ញាតុំ ឝក្ឞ្យតេ។</para>
  <para style="p">
    <verse number="16" style="v"/>អបរំ យស្យ មហត្ត្វំ សវ៌្វស្វីក្ឫតម៑ ឦឝ្វរភក្តេស្តត៑ និគូឍវាក្យមិទម៑ ឦឝ្វរោ មានវទេហេ ប្រកាឝិត អាត្មនា សបុណ្យីក្ឫតោ ទូតៃះ សន្ទ្ឫឞ្ដះ សវ៌្វជាតីយានាំ និកដេ ឃោឞិតោ ជគតោ វិឝ្វាសបាត្រីភូតស្តេជះប្រាប្តយេ ស្វគ៌ំ នីតឝ្ចេតិ។</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>បវិត្រ អាត្មា ស្បឞ្ដម៑ ឥទំ វាក្យំ វទតិ ចរមកាលេ កតិបយលោកា វហ្និនាង្កិតត្វាត្</para>
  <para style="p">
    <verse number="2" style="v"/>កឋោរមនសាំ កាបដ្យាទ៑ អន្ឫតវាទិនាំ វិវាហនិឞេធកានាំ ភក្ឞ្យវិឝេឞនិឞេធកានាញ្ច</para>
  <para style="p">
    <verse number="3" style="v"/>ភូតស្វរូបាណាំ ឝិក្ឞាយាំ ភ្រមកាត្មនាំ វាក្យេឞុ ច មនាំសិ និវេឝ្យ ធម៌្មាទ៑ ភ្រំឝិឞ្យន្តេ។ តានិ តុ ភក្ឞ្យាណិ វិឝ្វាសិនាំ ស្វីក្ឫតសត្យធម៌្មាណាញ្ច ធន្យវាទសហិតាយ ភោគាយេឝ្វរេណ សស្ឫជិរេ។</para>
  <para style="p">
    <verse number="4" style="v"/>យត ឦឝ្វរេណ យទ្យត៑ ស្ឫឞ្ដំ តត៑ សវ៌្វម៑ ឧត្តមំ យទិ ច ធន្យវាទេន ភុជ្យតេ តហ៌ិ តស្យ កិមបិ នាគ្រាហ្យំ ភវតិ,</para>
  <para style="p">
    <verse number="5" style="v"/>យត ឦឝ្វរស្យ វាក្យេន ប្រាត៌្ហនយា ច តត៑ បវិត្រីភវតិ។</para>
  <para style="p">
    <verse number="6" style="v"/>ឯតានិ វាក្យានិ យទិ ត្វំ ភ្រាត្ឫន៑ ជ្ញាបយេស្តហ៌ិ យីឝុខ្រីឞ្ដស្យោត្តម្ះ បរិចារកោ ភវិឞ្យសិ យោ វិឝ្វាសោ ហិតោបទេឝឝ្ច ត្វយា គ្ឫហីតស្តទីយវាក្យៃរាប្យាយិឞ្យសេ ច។</para>
  <para style="p">
    <verse number="7" style="v"/>យាន្យុបាខ្យានានិ ទុព៌្ហាវានិ វ្ឫទ្ធយោឞិតាមេវ យោគ្យានិ ច តានិ ត្វយា វិស្ឫជ្យន្តាម៑ ឦឝ្វរភក្តយេ យត្នះ ក្រិយតាញ្ច។</para>
  <para style="p">
    <verse number="8" style="v"/>យតះ ឝារីរិកោ យត្នះ ស្វល្បផលទោ ភវតិ កិន្ត្វីឝ្វរភក្តិរៃហិកបារត្រិកជីវនយោះ ប្រតិជ្ញាយុក្តា សតី សវ៌្វត្រ ផលទា ភវតិ។</para>
  <para style="p">
    <verse number="9" style="v"/>វាក្យមេតទ៑ វិឝ្វសនីយំ សវ៌្វៃ រ្គ្រហណីយញ្ច វយញ្ច តទត៌្ហមេវ ឝ្រាម្យាមោ និន្ទាំ ភុំជ្មហេ ច។</para>
  <para style="p">
    <verse number="10" style="v"/>យតោ ហេតោះ សវ៌្វមានវានាំ វិឝេឞតោ វិឝ្វាសិនាំ ត្រាតា យោៜមរ ឦឝ្វរស្តស្មិន៑ វយំ វិឝ្វសាមះ។</para>
  <para style="p">
    <verse number="11" style="v"/>ត្វម៑ ឯតានិ វាក្យានិ ប្រចារយ សមុបទិឝ ច។</para>
  <para style="p">
    <verse number="12" style="v"/>អល្បវយឞ្កត្វាត៑ កេនាប្យវជ្ញេយោ ន ភវ កិន្ត្វាលាបេនាចរណេន ប្រេម្នា សទាត្មត្វេន វិឝ្វាសេន ឝុចិត្វេន ច វិឝ្វាសិនាម៑ អាទឝ៌ោ ភវ។</para>
  <para style="p">
    <verse number="13" style="v"/>យាវន្នាហម៑ អាគមិឞ្យាមិ តាវត៑ ត្វ បាឋេ ចេតយនេ ឧបទេឝេ ច មនោ និធត្ស្វ។</para>
  <para style="p">
    <verse number="14" style="v"/>ប្រាចីនគណហស្តាប៌ណសហិតេន ភវិឞ្យទ្វាក្យេន យទ្ទានំ តុភ្យំ វិឝ្រាណិតំ តវាន្តះស្ថេ តស្មិន៑ ទានេ ឝិថិលមនា មា ភវ។</para>
  <para style="p">
    <verse number="15" style="v"/>ឯតេឞុ មនោ និវេឝយ, ឯតេឞុ វត៌្តស្វ, ឥត្ថញ្ច សវ៌្វវិឞយេ តវ គុណវ្ឫទ្ធិះ ប្រកាឝតាំ។</para>
  <para style="p">
    <verse number="16" style="v"/>ស្វស្មិន៑ ឧបទេឝេ ច សាវធានោ ភូត្វាវតិឞ្ឋស្វ តត៑ ក្ឫត្វា ត្វយាត្មបរិត្រាណំ ឝ្រោត្ឫណាញ្ច បរិត្រាណំ សាធយិឞ្យតេ។</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ត្វំ ប្រាចីនំ ន ភត៌្សយ កិន្តុ តំ បិតរមិវ យូនឝ្ច ភ្រាត្ឫនិវ</para>
  <para style="p">
    <verse number="2" style="v"/>វ្ឫទ្ធាះ ស្ត្រិយឝ្ច មាត្ឫនិវ យុវតីឝ្ច បូណ៌ឝុចិត្វេន ភគិនីរិវ វិនយស្វ។</para>
  <para style="p">
    <verse number="3" style="v"/>អបរំ សត្យវិធវាះ សម្មន្យស្វ។</para>
  <para style="p">
    <verse number="4" style="v"/>កស្យាឝ្ចិទ៑ វិធវាយា យទិ បុត្រាះ បៅត្រា វា វិទ្យន្តេ តហ៌ិ តេ ប្រថមតះ ស្វីយបរិជនាន៑ សេវិតុំ បិត្រោះ ប្រត្យុបកត៌្តុញ្ច ឝិក្ឞន្តាំ យតស្តទេវេឝ្វរស្យ សាក្ឞាទ៑ ឧត្តមំ គ្រាហ្យញ្ច កម៌្ម។</para>
  <para style="p">
    <verse number="5" style="v"/>អបរំ យា នារី សត្យវិធវា នាថហីនា ចាស្តិ សា ឦឝ្វរស្យាឝ្រយេ តិឞ្ឋន្តី ទិវានិឝំ និវេទនប្រាត៌្ហនាភ្យាំ កាលំ យាបយតិ។</para>
  <para style="p">
    <verse number="6" style="v"/>កិន្តុ យា វិធវា សុខភោគាសក្តា សា ជីវត្យបិ ម្ឫតា ភវតិ។</para>
  <para style="p">
    <verse number="7" style="v"/>អតឯវ តា យទ៑ អនិន្ទិតា ភវេយូស្តទត៌្ហម៑ ឯតានិ ត្វយា និទិឝ្យន្តាំ។</para>
  <para style="p">
    <verse number="8" style="v"/>យទិ កឝ្ចិត៑ ស្វជាតីយាន៑ លោកាន៑ វិឝេឞតះ ស្វីយបរិជនាន៑ ន បាលយតិ តហ៌ិ ស វិឝ្វាសាទ៑ ភ្រឞ្ដោ ៜប្យធមឝ្ច ភវតិ។</para>
  <para style="p">
    <verse number="9" style="v"/>វិធវាវគ៌េ យស្យា គណនា ភវតិ តយា ឞឞ្ដិវត្សរេភ្យោ ន្យូនវយស្កយា ន ភវិតវ្យំ; អបរំ បូវ៌្វម៑ ឯកស្វាមិកា ភូត្វា</para>
  <para style="p">
    <verse number="10" style="v"/>សា យត៑ ឝិឝុបោឞណេនាតិថិសេវនេន បវិត្រលោកានាំ ចរណប្រក្ឞាលនេន ក្លិឞ្ដានាម៑ ឧបការេណ សវ៌្វវិធសត្កម៌្មាចរណេន ច សត្កម៌្មករណាត៑ សុខ្យាតិប្រាប្តា ភវេត៑ តទប្យាវឝ្យកំ។</para>
  <para style="p">
    <verse number="11" style="v"/>កិន្តុ យុវតី រ្វិធវា ន គ្ឫហាណ យតះ ខ្រីឞ្ដស្យ វៃបរីត្យេន តាសាំ ទប៌េ ជាតេ តា វិវាហម៑ ឥច្ឆន្តិ។</para>
  <para style="p">
    <verse number="12" style="v"/>តស្មាច្ច បូវ៌្វធម៌្មំ បរិត្យជ្យ ទណ្ឌនីយា ភវន្តិ។</para>
  <para style="p">
    <verse number="13" style="v"/>អនន្តរំ តា គ្ឫហាទ៑ គ្ឫហំ បយ៌្យដន្ត្យ អាលស្យំ ឝិក្ឞន្តេ កេវលមាលស្យំ នហិ កិន្ត្វនត៌្ហកាលាបំ បរាធិការចច៌្ចាញ្ចាបិ ឝិក្ឞមាណា អនុចិតានិ វាក្យានិ ភាឞន្តេ។</para>
  <para style="p">
    <verse number="14" style="v"/>អតោ មមេច្ឆេយំ យុវត្យោ វិធវា វិវាហំ កុវ៌្វតាម៑ អបត្យវត្យោ ភវន្តុ គ្ឫហកម៌្ម កុវ៌្វតាញ្ចេត្ថំ វិបក្ឞាយ កិមបិ និន្ទាទ្វារំ ន ទទតុ។</para>
  <para style="p">
    <verse number="15" style="v"/>យត ឥតះ បូវ៌្វម៑ អបិ កាឝ្ចិត៑ ឝយតានស្យ បឝ្ចាទ្គាមិន្យោ ជាតាះ។</para>
  <para style="p">
    <verse number="16" style="v"/>អបរំ វិឝ្វាសិន្យា វិឝ្វាសិនោ វា កស្យាបិ បរិវារាណាំ មធ្យេ យទិ វិធវា វិទ្យន្តេ តហ៌ិ ស តាះ ប្រតិបាលយតុ តស្មាត៑ សមិតៅ ភារេ ៜនារោបិតេ សត្យវិធវានាំ ប្រតិបាលនំ កត៌្តុំ តយា ឝក្យតេ។</para>
  <para style="p">
    <verse number="17" style="v"/>យេ ប្រាញ្ចះ សមិតិំ សម្យគ៑ អធិតិឞ្ឋន្តិ វិឝេឞត ឦឝ្វរវាក្យេនោបទេឝេន ច យេ យត្នំ វិទធតេ តេ ទ្វិគុណស្យាទរស្យ យោគ្យា មាន្យន្តាំ។</para>
  <para style="p">
    <verse number="18" style="v"/>យស្មាត៑ ឝាស្ត្រេ លិខិតមិទមាស្តេ, ត្វំ ឝស្យមទ៌្ទកវ្ឫឞស្យាស្យំ មា ពធានេតិ, អបរមបិ កាយ៌្យក្ឫទ៑ វេតនស្យ យោគ្យោ ភវតីតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>ទ្វៅ ត្រីន៑ វា សាក្ឞិណោ វិនា កស្យាចិត៑ ប្រាចីនស្យ វិរុទ្ធម៑ អភិយោគស្ត្វយា ន គ្ឫហ្យតាំ។</para>
  <para style="p">
    <verse number="20" style="v"/>អបរំ យេ បាបមាចរន្តិ តាន៑ សវ៌្វេឞាំ សមក្ឞំ ភត៌្សយស្វ តេនាបរេឞាមបិ ភីតិ រ្ជនិឞ្យតេ។</para>
  <para style="p">
    <verse number="21" style="v"/>អហម៑ ឦឝ្វរស្យ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ មនោនីតទិវ្យទូតានាញ្ច គោចរេ ត្វាម៑ ឥទម៑ អាជ្ញាបយាមិ ត្វំ កស្យាប្យនុរោធេន កិមបិ ន កុវ៌្វន វិនាបក្ឞបាតម៑ ឯតាន វិធីន៑ បាលយ។</para>
  <para style="p">
    <verse number="22" style="v"/>កស្យាបិ មូទ៌្ធិ ហស្តាបណ៌ំ ត្វរយា មាកាឞ៌ីះ។ បរបាបានាញ្ចាំឝី មា ភវ។ ស្វំ ឝុចិំ រក្ឞ។</para>
  <para style="p">
    <verse number="23" style="v"/>អបរំ តវោទរបីឌាយាះ បុនះ បុន ទុព៌្ពលតាយាឝ្ច និមិត្តំ កេវលំ តោយំ ន បិវន៑ កិញ្ចិន៑ មទ្យំ បិវ។</para>
  <para style="p">
    <verse number="24" style="v"/>កេឞាញ្ចិត៑ មានវានាំ បាបានិ វិចារាត៑ បូវ៌្វំ កេឞាញ្ចិត៑ បឝ្ចាត៑ ប្រកាឝន្តេ។</para>
  <para style="p">
    <verse number="25" style="v"/>តថៃវ សត្កម៌្មាណ្យបិ ប្រកាឝន្តេ តទន្យថា សតិ ប្រច្ឆន្នានិ ស្ថាតុំ ន ឝក្នុវន្តិ។</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យាវន្តោ លោកា យុគធារិណោ ទាសាះ សន្តិ តេ ស្វស្វស្វាមិនំ បូណ៌សមាទរយោគ្យំ មន្យន្តាំ នោ ចេទ៑ ឦឝ្វរស្យ នាម្ន ឧបទេឝស្យ ច និន្ទា សម្ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="2" style="v"/>យេឞាញ្ច ស្វាមិនោ វិឝ្វាសិនះ ភវន្តិ តៃស្តេ ភ្រាត្ឫត្វាត៑ នាវជ្ញេយាះ កិន្តុ តេ កម៌្មផលភោគិនោ វិឝ្វាសិនះ ប្រិយាឝ្ច ភវន្តីតិ ហេតោះ សេវនីយា ឯវ, ត្វម៑ ឯតានិ ឝិក្ឞយ សមុបទិឝ ច។</para>
  <para style="p">
    <verse number="3" style="v"/>យះ កឝ្ចិទ៑ ឥតរឝិក្ឞាំ ករោតិ, អស្មាកំ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ ហិតវាក្យានីឝ្វរភក្តេ រ្យោគ្យាំ ឝិក្ឞាញ្ច ន ស្វីករោតិ</para>
  <para style="p">
    <verse number="4" style="v"/>ស ទប៌ធ្មាតះ សវ៌្វថា ជ្ញានហីនឝ្ច វិវាទៃ រ្វាគ្យុទ្ធៃឝ្ច រោគយុក្តឝ្ច ភវតិ។</para>
  <para style="p">
    <verse number="5" style="v"/>តាទ្ឫឝាទ៑ ភាវាទ៑ ឦឞ៌្យាវិរោធាបវាទទុឞ្ដាសូយា ភ្រឞ្ដមនសាំ សត្យជ្ញានហីនានាម៑ ឦឝ្វរភក្តិំ លាភោបាយម៑ ឥវ មន្យមានានាំ លោកានាំ វិវាទាឝ្ច ជាយន្តេ តាទ្ឫឝេភ្យោ លោកេភ្យស្ត្វំ ប្ឫថក៑ តិឞ្ឋ។</para>
  <para style="p">
    <verse number="6" style="v"/>សំយតេច្ឆយា យុក្តា យេឝ្វរភក្តិះ សា មហាលាភោបាយោ ភវតីតិ សត្យំ។</para>
  <para style="p">
    <verse number="7" style="v"/>ឯតជ្ជគត្ប្រវេឝនកាលេៜស្មាភិះ កិមបិ នានាយិ តត្តយជនកាលេៜបិ កិមបិ នេតុំ ន ឝក្ឞ្យត ឥតិ និឝ្ចិតំ។</para>
  <para style="p">
    <verse number="8" style="v"/>អតឯវ ខាទ្យាន្យាច្ឆាទនានិ ច ប្រាប្យាស្មាភិះ សន្តុឞ្ដៃ រ្ភវិតវ្យំ។</para>
  <para style="p">
    <verse number="9" style="v"/>យេ តុ ធនិនោ ភវិតុំ ចេឞ្ដន្តេ តេ បរីក្ឞាយាម៑ ឧន្មាថេ បតន្តិ យេ ចាភិលាឞា មានវាន៑ វិនាឝេ នរកេ ច មជ្ជយន្តិ តាទ្ឫឝេឞ្វជ្ញានាហិតាភិលាឞេឞ្វបិ បតន្តិ។</para>
  <para style="p">
    <verse number="10" style="v"/>យតោៜរ្ថស្ប្ឫហា សវ៌្វេឞាំ ទុរិតានាំ មូលំ ភវតិ តាមវលម្ព្យ កេចិទ៑ វិឝ្វាសាទ៑ អភ្រំឝន្ត នានាក្លេឝៃឝ្ច ស្វាន៑ អវិធ្យន៑។</para>
  <para style="p">
    <verse number="11" style="v"/>ហេ ឦឝ្វរស្យ លោក ត្វម៑ ឯតេភ្យះ បលាយ្យ ធម៌្ម ឦឝ្វរភក្តិ រ្វិឝ្វាសះ ប្រេម សហិឞ្ណុតា ក្ឞាន្តិឝ្ចៃតាន្យាចរ។</para>
  <para style="p">
    <verse number="12" style="v"/>វិឝ្វាសរូបម៑ ឧត្តមយុទ្ធំ កុរុ, អនន្តជីវនម៑ អាលម្ពស្វ យតស្តទត៌្ហំ ត្វម៑ អាហូតោ ៜភវះ, ពហុសាក្ឞិណាំ សមក្ឞញ្ចោត្តមាំ ប្រតិជ្ញាំ ស្វីក្ឫតវាន៑។</para>
  <para style="p">
    <verse number="13" style="v"/>អបរំ សវ៌្វេឞាំ ជីវយិតុរីឝ្វរស្យ សាក្ឞាទ៑ យឝ្ច ខ្រីឞ្ដោ យីឝុះ បន្តីយបីលាតស្យ សមក្ឞម៑ ឧត្តមាំ ប្រតិជ្ញាំ ស្វីក្ឫតវាន៑ តស្យ សាក្ឞាទ៑ អហំ ត្វាម៑ ឥទម៑ អាជ្ញាបយាមិ។</para>
  <para style="p">
    <verse number="14" style="v"/>ឦឝ្វរេណ ស្វសមយេ ប្រកាឝិតវ្យម៑ អស្មាកំ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យាគមនំ យាវត៑ ត្វយា និឞ្កលង្កត្វេន និទ៌្ទោឞត្វេន ច វិធី រក្ឞ្យតាំ។</para>
  <para style="p">
    <verse number="15" style="v"/>ស ឦឝ្វរះ សច្ចិទានន្ទះ, អទ្វិតីយសម្រាដ៑, រាជ្ញាំ រាជា, ប្រភូនាំ ប្រភុះ,</para>
  <para style="p">
    <verse number="16" style="v"/>អមរតាយា អទ្វិតីយ អាករះ, អគម្យតេជោនិវាសី, មត៌្ត្យានាំ កេនាបិ ន ទ្ឫឞ្ដះ កេនាបិ ន ទ្ឫឝ្យឝ្ច។ តស្យ គៅរវបរាក្រមៅ សទាតនៅ ភូយាស្តាំ។ អាមេន៑។</para>
  <para style="p">
    <verse number="17" style="v"/>ឥហលោកេ យេ ធនិនស្តេ ចិត្តសមុន្នតិំ ចបលេ ធនេ វិឝ្វាសញ្ច ន កុវ៌្វតាំ កិន្តុ ភោគាត៌្ហម៑ អស្មភ្យំ ប្រចុរត្វេន សវ៌្វទាតា</para>
  <para style="p">
    <verse number="18" style="v"/>យោៜមរ ឦឝ្វរស្តស្មិន៑ វិឝ្វសន្តុ សទាចារំ កុវ៌្វន្តុ សត្កម៌្មធនេន ធនិនោ សុកលា ទាតារឝ្ច ភវន្តុ,</para>
  <para style="p">
    <verse number="19" style="v"/>យថា ច សត្យំ ជីវនំ បាប្នុយុស្តថា បារត្រិកាម៑ ឧត្តមសម្បទំ សញ្ចិន្វន្ត្វេតិ ត្វយាទិឝ្យន្តាំ។</para>
  <para style="p">
    <verse number="20" style="v"/>ហេ តីមថិយ, ត្វម៑ ឧបនិធិំ គោបយ កាល្បនិកវិទ្យាយា អបវិត្រំ ប្រលាបំ វិរោធោក្តិញ្ច ត្យជ ច,</para>
  <para style="p">
    <verse number="21" style="v"/>យតះ កតិបយា លោកាស្តាំ វិទ្យាមវលម្ព្យ វិឝ្វាសាទ៑ ភ្រឞ្ដា អភវន។ ប្រសាទស្តវ សហាយោ ភូយាត៑។ អាមេន៑។</para>
</usx>
