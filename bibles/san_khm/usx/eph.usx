<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="EPH" style="id">Sanskrit Bible (NT) in Khmer Script (សត្យវេទះ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Ephesians</para>
  <para style="toc1">ឥផិឞិណះ បត្រំ</para>
  <para style="toc2">ឥផិឞិណះ</para>
  <para style="toc3">ឥផិឞិណះ</para>
  <para style="mt1">ឥផិឞិណះ បត្រំ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ឦឝ្វរស្យេច្ឆយា យីឝុខ្រីឞ្ដស្យ ប្រេរិតះ បៅល ឥផិឞនគរស្ថាន៑ បវិត្រាន៑ ខ្រីឞ្ដយីឝៅ វិឝ្វាសិនោ លោកាន៑ ប្រតិ បត្រំ លិខតិ។</para>
  <para style="p">
    <verse number="2" style="v"/>អស្មាកំ តាតស្យេឝ្វរស្យ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ ចានុគ្រហះ ឝាន្តិឝ្ច យុឞ្មាសុ វត៌្តតាំ។</para>
  <para style="p">
    <verse number="3" style="v"/>អស្មាកំ ប្រភោ រ្យីឝោះ ខ្រីឞ្ដស្យ តាត ឦឝ្វរោ ធន្យោ ភវតុ; យតះ ស ខ្រីឞ្ដេនាស្មភ្យំ សវ៌្វម៑ អាធ្យាត្មិកំ ស្វគ៌ីយវរំ ទត្តវាន៑។</para>
  <para style="p">
    <verse number="4" style="v"/>វយំ យត៑ តស្យ សមក្ឞំ ប្រេម្នា បវិត្រា និឞ្កលង្កាឝ្ច ភវាមស្តទត៌្ហំ ស ជគតះ ស្ឫឞ្ដេ បូវ៌្វំ តេនាស្មាន៑ អភិរោចិតវាន៑, និជាភិលឞិតានុរោធាច្ច</para>
  <para style="p">
    <verse number="5" style="v"/>យីឝុនា ខ្រីឞ្ដេន ស្វស្យ និមិត្តំ បុត្រត្វបទេៜស្មាន៑ ស្វកីយានុគ្រហស្យ មហត្ត្វស្យ ប្រឝំសាត៌្ហំ បូវ៌្វំ និយុក្តវាន៑។</para>
  <para style="p">
    <verse number="6" style="v"/>តស្មាទ៑ អនុគ្រហាត៑ ស យេន ប្រិយតមេន បុត្រេណាស្មាន៑ អនុគ្ឫហីតវាន៑,</para>
  <para style="p">
    <verse number="7" style="v"/>វយំ តស្យ ឝោណិតេន មុក្តិម៑ អត៌្ហតះ បាបក្ឞមាំ លព្ធវន្តះ។</para>
  <para style="p">
    <verse number="8" style="v"/>តស្យ យ ឦទ្ឫឝោៜនុគ្រហនិធិស្តស្មាត៑ សោៜស្មភ្យំ សវ៌្វវិធំ ជ្ញានំ ពុទ្ធិញ្ច ពាហុល្យរូបេណ វិតរិតវាន៑។</para>
  <para style="p">
    <verse number="9" style="v"/>ស្វគ៌ប្ឫថិវ្យោ រ្យទ្យទ៑ វិទ្យតេ តត្សវ៌្វំ ស ខ្រីឞ្ដេ សំគ្រហីឞ្យតីតិ ហិតៃឞិណា</para>
  <para style="p">
    <verse number="10" style="v"/>តេន ក្ឫតោ យោ មនោរថះ សម្បូណ៌តាំ គតវត្សុ សមយេឞុ សាធយិតវ្យស្តមធិ ស ស្វកីយាភិលាឞស្យ និគូឍំ ភាវម៑ អស្មាន៑ ជ្ញាបិតវាន៑។</para>
  <para style="p">
    <verse number="11" style="v"/>បូវ៌្វំ ខ្រីឞ្ដេ វិឝ្វាសិនោ យេ វយម៑ អស្មត្តោ យត៑ តស្យ មហិម្នះ ប្រឝំសា ជាយតេ,</para>
  <para style="p">
    <verse number="12" style="v"/>តទត៌្ហំ យះ ស្វកីយេច្ឆាយាះ មន្ត្រណាតះ សវ៌្វាណិ សាធយតិ តស្យ មនោរថាទ៑ វយំ ខ្រីឞ្ដេន បូវ៌្វំ និរូបិតាះ សន្តោៜធិការិណោ ជាតាះ។</para>
  <para style="p">
    <verse number="13" style="v"/>យូយមបិ សត្យំ វាក្យម៑ អត៌្ហតោ យុឞ្មត្បរិត្រាណស្យ សុសំវាទំ និឝម្យ តស្មិន្នេវ ខ្រីឞ្ដេ វិឝ្វសិតវន្តះ ប្រតិជ្ញាតេន បវិត្រេណាត្មនា មុទ្រយេវាង្កិតាឝ្ច។</para>
  <para style="p">
    <verse number="14" style="v"/>យតស្តស្យ មហិម្នះ ប្រកាឝាយ តេន ក្រីតានាំ លោកានាំ មុក្តិ រ្យាវន្ន ភវិឞ្យតិ តាវត៑ ស អាត្មាស្មាកម៑ អធិការិត្វស្យ សត្យង្ការស្យ បណស្វរូបោ ភវតិ។</para>
  <para style="p">
    <verse number="15" style="v"/>ប្រភៅ យីឝៅ យុឞ្មាកំ វិឝ្វាសះ សវ៌្វេឞុ បវិត្រលោកេឞុ ប្រេម ចាស្ត ឥតិ វាត៌្តាំ ឝ្រុត្វាហមបិ</para>
  <para style="p">
    <verse number="16" style="v"/>យុឞ្មានធិ និរន្តរម៑ ឦឝ្វរំ ធន្យំ វទន៑ ប្រាត៌្ហនាសមយេ ច យុឞ្មាន៑ ស្មរន៑ វរមិមំ យាចាមិ។</para>
  <para style="p">
    <verse number="17" style="v"/>អស្មាកំ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ តាតោ យះ ប្រភាវាករ ឦឝ្វរះ ស ស្វកីយតត្ត្វជ្ញានាយ យុឞ្មភ្យំ ជ្ញានជនកម៑ ប្រកាឝិតវាក្យពោធកញ្ចាត្មានំ ទេយាត៑។</para>
  <para style="p">
    <verse number="18" style="v"/>យុឞ្មាកំ ជ្ញានចក្ឞូំឞិ ច ទីប្តិយុក្តានិ ក្ឫត្វា តស្យាហ្វានំ កីទ្ឫឝ្យា ប្រត្យាឝយា សម្ពលិតំ បវិត្រលោកានាំ មធ្យេ តេន ទត្តោៜធិការះ កីទ្ឫឝះ ប្រភាវនិធិ រ្វិឝ្វាសិឞុ ចាស្មាសុ ប្រកាឝមានស្យ</para>
  <para style="p">
    <verse number="19" style="v"/>តទីយមហាបរាក្រមស្យ មហត្វំ កីទ្ឫគ៑ អនុបមំ តត៑ សវ៌្វំ យុឞ្មាន៑ ជ្ញាបយតុ។</para>
  <para style="p">
    <verse number="20" style="v"/>យតះ ស យស្យាះ ឝក្តេះ ប្រពលតាំ ខ្រីឞ្ដេ ប្រកាឝយន៑ ម្ឫតគណមធ្យាត៑ តម៑ ឧត្ថាបិតវាន៑,</para>
  <para style="p">
    <verse number="21" style="v"/>អធិបតិត្វបទំ ឝាសនបទំ បរាក្រមោ រាជត្វញ្ចេតិនាមានិ យាវន្តិ បទានីហ លោកេ បរលោកេ ច វិទ្យន្តេ តេឞាំ សវ៌្វេឞាម៑ ឩទ៌្ធ្វេ ស្វគ៌េ និជទក្ឞិណបាឝ៌្វេ តម៑ ឧបវេឝិតវាន៑,</para>
  <para style="p">
    <verse number="22" style="v"/>សវ៌្វាណិ តស្យ ចរណយោរធោ និហិតវាន៑ យា សមិតិស្តស្យ ឝរីរំ សវ៌្វត្រ សវ៌្វេឞាំ បូរយិតុះ បូរកញ្ច ភវតិ តំ តស្យា មូទ៌្ធានំ ក្ឫត្វា</para>
  <para style="p">
    <verse number="23" style="v"/>សវ៌្វេឞាម៑ ឧបយ៌្យុបរិ និយុក្តវាំឝ្ច សៃវ ឝក្តិរស្មាស្វបិ តេន ប្រកាឝ្យតេ។</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>បុរា យូយម៑ អបរាធៃះ បាបៃឝ្ច ម្ឫតាះ សន្តស្តាន្យាចរន្ត ឥហលោកស្យ សំសារានុសារេណាកាឝរាជ្យស្យាធិបតិម្</para>
  <para style="p">
    <verse number="2" style="v"/>អត៌្ហតះ សាម្ប្រតម៑ អាជ្ញាលង្ឃិវំឝេឞុ កម៌្មការិណម៑ អាត្មានម៑ អន្វវ្រជត។</para>
  <para style="p">
    <verse number="3" style="v"/>តេឞាំ មធ្យេ សវ៌្វេ វយមបិ បូវ៌្វំ ឝរីរស្យ មនស្កាមនាយាញ្ចេហាំ សាធយន្តះ ស្វឝរីរស្យាភិលាឞាន៑ អាចរាម សវ៌្វេៜន្យ ឥវ ច ស្វភាវតះ ក្រោធភជនាន្យភវាម។</para>
  <para style="p">
    <verse number="4" style="v"/>កិន្តុ ករុណានិធិរីឝ្វរោ យេន មហាប្រេម្នាស្មាន៑ ទយិតវាន្</para>
  <para style="p">
    <verse number="5" style="v"/>តស្យ ស្វប្រេម្នោ ពាហុល្យាទ៑ អបរាធៃ រ្ម្ឫតានប្យស្មាន៑ ខ្រីឞ្ដេន សហ ជីវិតវាន៑ យតោៜនុគ្រហាទ៑ យូយំ បរិត្រាណំ ប្រាប្តាះ។</para>
  <para style="p">
    <verse number="6" style="v"/>ស ច ខ្រីឞ្ដេន យីឝុនាស្មាន៑ តេន សាទ៌្ធម៑ ឧត្ថាបិតវាន៑ ស្វគ៌ ឧបវេឝិតវាំឝ្ច។</para>
  <para style="p">
    <verse number="7" style="v"/>ឥត្ថំ ស ខ្រីឞ្ដេន យីឝុនាស្មាន៑ ប្រតិ ស្វហិតៃឞិតយា ភាវិយុគេឞុ ស្វកីយានុគ្រហស្យានុបមំ និធិំ ប្រកាឝយិតុម៑ ឥច្ឆតិ។</para>
  <para style="p">
    <verse number="8" style="v"/>យូយម៑ អនុគ្រហាទ៑ វិឝ្វាសេន បរិត្រាណំ ប្រាប្តាះ, តច្ច យុឞ្មន្មូលកំ នហិ កិន្ត្វីឝ្វរស្យៃវ ទានំ,</para>
  <para style="p">
    <verse number="9" style="v"/>តត៑ កម៌្មណាំ ផលម៑ អបិ នហិ, អតះ កេនាបិ ន ឝ្លាឃិតវ្យំ។</para>
  <para style="p">
    <verse number="10" style="v"/>យតោ វយំ តស្យ កាយ៌្យំ ប្រាគ៑ ឦឝ្វរេណ និរូបិតាភិះ សត្ក្រិយាភិះ កាលយាបនាយ ខ្រីឞ្ដេ យីឝៅ តេន ម្ឫឞ្ដាឝ្ច។</para>
  <para style="p">
    <verse number="11" style="v"/>បុរា ជន្មនា ភិន្នជាតីយា ហស្តក្ឫតំ ត្វក្ឆេទំ ប្រាប្តៃ រ្លោកៃឝ្ចាច្ឆិន្នត្វច ឥតិនាម្នា ខ្យាតា យេ យូយំ តៃ រ្យុឞ្មាភិរិទំ ស្មត៌្តវ្យំ</para>
  <para style="p">
    <verse number="12" style="v"/>យត៑ តស្មិន៑ សមយេ យូយំ ខ្រីឞ្ដាទ៑ ភិន្នា ឥស្រាយេលលោកានាំ សហវាសាទ៑ ទូរស្ថាះ ប្រតិជ្ញាសម្ពលិតនិយមានាំ ពហិះ ស្ថិតាះ សន្តោ និរាឝា និរីឝ្វរាឝ្ច ជគត្យាធ្វម៑ ឥតិ។</para>
  <para style="p">
    <verse number="13" style="v"/>កិន្ត្វធុនា ខ្រីឞ្ដេ យីឝាវាឝ្រយំ ប្រាប្យ បុរា ទូរវត៌្តិនោ យូយំ ខ្រីឞ្ដស្យ ឝោណិតេន និកដវត៌្តិនោៜភវត។</para>
  <para style="p">
    <verse number="14" style="v"/>យតះ ស ឯវាស្មាកំ សន្ធិះ ស ទ្វយម៑ ឯកីក្ឫតវាន៑ ឝត្រុតារូបិណីំ មធ្យវត៌្តិនីំ ប្រភេទកភិត្តិំ ភគ្នវាន៑ ទណ្ឌាជ្ញាយុក្តំ វិធិឝាស្ត្រំ ស្វឝរីរេណ លុប្តវាំឝ្ច។</para>
  <para style="p">
    <verse number="15" style="v"/>យតះ ស សន្ធិំ វិធាយ តៅ ទ្វៅ ស្វស្មិន៑ ឯកំ នុតនំ មានវំ កត៌្តុំ</para>
  <para style="p">
    <verse number="16" style="v"/>ស្វកីយក្រុឝេ ឝត្រុតាំ និហត្យ តេនៃវៃកស្មិន៑ ឝរីរេ តយោ រ្ទ្វយោរីឝ្វរេណ សន្ធិំ ការយិតុំ និឝ្ចតវាន៑។</para>
  <para style="p">
    <verse number="17" style="v"/>ស ចាគត្យ ទូរវត៌្តិនោ យុឞ្មាន៑ និកដវត៌្តិនោ ៜស្មាំឝ្ច សន្ធេ រ្មង្គលវាត៌្តាំ ជ្ញាបិតវាន៑។</para>
  <para style="p">
    <verse number="18" style="v"/>យតស្តស្មាទ៑ ឧភយបក្ឞីយា វយម៑ ឯកេនាត្មនា បិតុះ សមីបំ គមនាយ សាមត៌្ហ្យំ ប្រាប្តវន្តះ។</para>
  <para style="p">
    <verse number="19" style="v"/>អត ឥទានីំ យូយម៑ អសម្បក៌ីយា វិទេឝិនឝ្ច ន តិឞ្ឋនតះ បវិត្រលោកៃះ សហវាសិន ឦឝ្វរស្យ វេឝ្មវាសិនឝ្ចាធ្វេ។</para>
  <para style="p">
    <verse number="20" style="v"/>អបរំ ប្រេរិតា ភវិឞ្យទ្វាទិនឝ្ច យត្រ ភិត្តិមូលស្វរូបាស្តត្រ យូយំ តស្មិន៑ មូលេ និចីយធ្វេ តត្រ ច ស្វយំ យីឝុះ ខ្រីឞ្ដះ ប្រធានះ កោណស្ថប្រស្តរះ។</para>
  <para style="p">
    <verse number="21" style="v"/>តេន ក្ឫត្ស្នា និម៌្មិតិះ សំគ្រថ្យមានា ប្រភោះ បវិត្រំ មន្ទិរំ ភវិតុំ វទ៌្ធតេ។</para>
  <para style="p">
    <verse number="22" style="v"/>យូយមបិ តត្រ សំគ្រថ្យមានា អាត្មនេឝ្វរស្យ វាសស្ថានំ ភវថ។</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អតោ ហេតោ រ្ភិន្នជាតីយានាំ យុឞ្មាកំ និមិត្តំ យីឝុខ្រីឞ្ដស្យ ពន្ទី យះ សោៜហំ បៅលោ ព្រវីមិ។</para>
  <para style="p">
    <verse number="2" style="v"/>យុឞ្មទត៌្ហម៑ ឦឝ្វរេណ មហ្យំ ទត្តស្យ វរស្យ និយមះ កីទ្ឫឝស្តទ៑ យុឞ្មាភិរឝ្រាវីតិ មន្យេ។</para>
  <para style="p">
    <verse number="3" style="v"/>អត៌្ហតះ បូវ៌្វំ មយា សំក្ឞេបេណ យថា លិខិតំ តថាហំ ប្រកាឝិតវាក្យេនេឝ្វរស្យ និគូឍំ ភាវំ ជ្ញាបិតោៜភវំ។</para>
  <para style="p">
    <verse number="4" style="v"/>អតោ យុឞ្មាភិស្តត៑ បឋិត្វា ខ្រីឞ្ដមធិ តស្មិន្និគូឍេ ភាវេ មម ជ្ញានំ កីទ្ឫឝំ តទ៑ ភោត្ស្យតេ។</para>
  <para style="p">
    <verse number="5" style="v"/>បូវ៌្វយុគេឞុ មានវសន្តានាស្តំ ជ្ញាបិតា នាសន៑ កិន្ត្វធុនា ស ភាវស្តស្យ បវិត្រាន៑ ប្រេរិតាន៑ ភវិឞ្យទ្វាទិនឝ្ច ប្រត្យាត្មនា ប្រកាឝិតោៜភវត៑;</para>
  <para style="p">
    <verse number="6" style="v"/>អត៌្ហត ឦឝ្វរស្យ ឝក្តេះ ប្រកាឝាត៑ តស្យានុគ្រហេណ យោ វរោ មហ្យម៑ អទាយិ តេនាហំ យស្យ សុសំវាទស្យ បរិចារកោៜភវំ,</para>
  <para style="p">
    <verse number="7" style="v"/>តទ្វារា ខ្រីឞ្ដេន ភិន្នជាតីយា អន្យៃះ សាទ៌្ធម៑ ឯកាធិការា ឯកឝរីរា ឯកស្យាះ ប្រតិជ្ញាយា អំឝិនឝ្ច ភវិឞ្យន្តីតិ។</para>
  <para style="p">
    <verse number="8" style="v"/>សវ៌្វេឞាំ បវិត្រលោកានាំ ក្ឞុទ្រតមាយ មហ្យំ វរោៜយម៑ អទាយិ យទ៑ ភិន្នជាតីយានាំ មធ្យេ ពោធាគយស្យ គុណនិធេះ ខ្រីឞ្ដស្យ មង្គលវាត៌្តាំ ប្រចារយាមិ,</para>
  <para style="p">
    <verse number="9" style="v"/>កាលាវស្ថាតះ បូវ៌្វស្មាច្ច យោ និគូឍភាវ ឦឝ្វរេ គុប្ត អាសីត៑ តទីយនិយមំ សវ៌្វាន៑ ជ្ញាបយាមិ។</para>
  <para style="p">
    <verse number="10" style="v"/>យត ឦឝ្វរស្យ នានារូបំ ជ្ញានំ យត៑ សាម្ប្រតំ សមិត្យា ស្វគ៌េ ប្រាធាន្យបរាក្រមយុក្តានាំ ទូតានាំ និកដេ ប្រកាឝ្យតេ តទត៌្ហំ ស យីឝុនា ខ្រីឞ្ដេន សវ៌្វាណិ ស្ឫឞ្ដវាន៑។</para>
  <para style="p">
    <verse number="11" style="v"/>យតោ វយំ យស្មិន៑ វិឝ្វស្យ ទ្ឫឍភក្ត្យា និព៌្ហយតាម៑ ឦឝ្វរស្យ សមាគមេ សាមត៌្ហ្យញ្ច</para>
  <para style="p">
    <verse number="12" style="v"/>ប្រាប្តវន្តស្តមស្មាកំ ប្រភុំ យីឝុំ ខ្រីឞ្ដមធិ ស កាលាវស្ថាយាះ បូវ៌្វំ តំ មនោរថំ ក្ឫតវាន៑។</para>
  <para style="p">
    <verse number="13" style="v"/>អតោៜហំ យុឞ្មន្និមិត្តំ ទុះខភោគេន ក្លាន្តិំ យន្ន គច្ឆាមីតិ ប្រាត៌្ហយេ យតស្តទេវ យុឞ្មាកំ គៅរវំ។</para>
  <para style="p">
    <verse number="14" style="v"/>អតោ ហេតោះ ស្វគ៌ប្ឫថិវ្យោះ ស្ថិតះ ក្ឫត្ស្នោ វំឝោ យស្យ នាម្នា វិខ្យាតស្តម្</para>
  <para style="p">
    <verse number="15" style="v"/>អស្មត្ប្រភោ រ្យីឝុខ្រីឞ្ដស្យ បិតរមុទ្ទិឝ្យាហំ ជានុនី បាតយិត្វា តស្យ ប្រភាវនិធិតោ វរមិមំ ប្រាត៌្ហយេ។</para>
  <para style="p">
    <verse number="16" style="v"/>តស្យាត្មនា យុឞ្មាកម៑ អាន្តរិកបុរុឞស្យ ឝក្តេ រ្វ្ឫទ្ធិះ ក្រិយតាំ។</para>
  <para style="p">
    <verse number="17" style="v"/>ខ្រីឞ្ដស្តុ វិឝ្វាសេន យុឞ្មាកំ ហ្ឫទយេឞុ និវសតុ។ ប្រេមណិ យុឞ្មាកំ ពទ្ធមូលត្វំ សុស្ថិរត្វញ្ច ភវតុ។</para>
  <para style="p">
    <verse number="18" style="v"/>ឥត្ថំ ប្រស្ថតាយា ទីគ៌្ហតាយា គភីរតាយា ឧច្ចតាយាឝ្ច ពោធាយ សវ៌្វៃះ បវិត្រលោកៃះ ប្រាប្យំ សាមត៌្ហ្យំ យុឞ្មាភិ រ្លភ្យតាំ,</para>
  <para style="p">
    <verse number="19" style="v"/>ជ្ញានាតិរិក្តំ ខ្រីឞ្ដស្យ ប្រេម ជ្ញាយតាម៑ ឦឝ្វរស្យ សម្បូណ៌វ្ឫទ្ធិបយ៌្យន្តំ យុឞ្មាកំ វ្ឫទ្ធិ រ្ភវតុ ច។</para>
  <para style="p">
    <verse number="20" style="v"/>អស្មាកម៑ អន្តរេ យា ឝក្តិះ ប្រកាឝតេ តយា សវ៌្វាតិរិក្តំ កម៌្ម កុវ៌្វន៑ អស្មាកំ ប្រាត៌្ហនាំ កល្បនាញ្ចាតិក្រមិតុំ យះ ឝក្នោតិ</para>
  <para style="p">
    <verse number="21" style="v"/>ខ្រីឞ្ដយីឝុនា សមិតេ រ្មធ្យេ សវ៌្វេឞុ យុគេឞុ តស្យ ធន្យវាទោ ភវតុ។ ឥតិ។</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អតោ ពន្ទិរហំ ប្រភោ រ្នាម្នា យុឞ្មាន៑ វិនយេ យូយំ យេនាហ្វានេនាហូតាស្តទុបយុក្តរូបេណ</para>
  <para style="p">
    <verse number="2" style="v"/>សវ៌្វថា នម្រតាំ ម្ឫទុតាំ តិតិក្ឞាំ បរស្បរំ ប្រម្នា សហិឞ្ណុតាញ្ចាចរត។</para>
  <para style="p">
    <verse number="3" style="v"/>ប្រណយពន្ធនេន ចាត្មន ឯैក្យំ រក្ឞិតុំ យតធ្វំ។</para>
  <para style="p">
    <verse number="4" style="v"/>យូយម៑ ឯកឝរីរា ឯកាត្មានឝ្ច តទ្វទ៑ អាហ្វានេន យូយម៑ ឯកប្រត្យាឝាប្រាប្តយេ សមាហូតាះ។</para>
  <para style="p">
    <verse number="5" style="v"/>យុឞ្មាកម៑ ឯកះ ប្រភុរេកោ វិឝ្វាស ឯកំ មជ្ជនំ, សវ៌្វេឞាំ តាតះ</para>
  <para style="p">
    <verse number="6" style="v"/>សវ៌្វោបរិស្ថះ សវ៌្វវ្យាបី សវ៌្វេឞាំ យុឞ្មាកំ មធ្យវត៌្តី ចៃក ឦឝ្វរ អាស្តេ។</para>
  <para style="p">
    <verse number="7" style="v"/>កិន្តុ ខ្រីឞ្ដស្យ ទានបរិមាណានុសារាទ៑ អស្មាកម៑ ឯកៃកស្មៃ វិឝេឞោ វរោៜទាយិ។</para>
  <para style="p">
    <verse number="8" style="v"/>យថា លិខិតម៑ អាស្តេ, "ឩទ៌្ធ្វម៑ អារុហ្យ ជេត្ឫន៑ ស វិជិត្យ ពន្ទិនោៜករោត៑។ តតះ ស មនុជេភ្យោៜបិ ស្វីយាន៑ វ្យឝ្រាណយទ៑ វរាន៑៕ "</para>
  <para style="p">
    <verse number="9" style="v"/>ឩទ៌្ធ្វម៑ អារុហ្យេតិវាក្យស្យាយមត៌្ហះ ស បូវ៌្វំ ប្ឫថិវីរូបំ សវ៌្វាធះស្ថិតំ ស្ថានម៑ អវតីណ៌វាន៑;</para>
  <para style="p">
    <verse number="10" style="v"/>យឝ្ចាវតីណ៌វាន៑ ស ឯវ ស្វគ៌ាណាម៑ ឧបយ៌្យុបយ៌្យារូឍវាន៑ យតះ សវ៌្វាណិ តេន បូរយិតវ្យានិ។</para>
  <para style="p">
    <verse number="11" style="v"/>ស ឯវ ច កាំឝ្ចន ប្រេរិតាន៑ អបរាន៑ ភវិឞ្យទ្វាទិនោៜបរាន៑ សុសំវាទប្រចារកាន៑ អបរាន៑ បាលកាន៑ ឧបទេឝកាំឝ្ច និយុក្តវាន៑។</para>
  <para style="p">
    <verse number="12" style="v"/>យាវទ៑ វយំ សវ៌្វេ វិឝ្វាសស្យេឝ្វរបុត្រវិឞយកស្យ តត្ត្វជ្ញានស្យ ចៃក្យំ សម្បូណ៌ំ បុរុឞត៌្ហញ្ចាត៌្ហតះ ខ្រីឞ្ដស្យ សម្បូណ៌បរិមាណស្យ សមំ បរិមាណំ ន ប្រាប្នុមស្តាវត្</para>
  <para style="p">
    <verse number="13" style="v"/>ស បរិចយ៌្យាកម៌្មសាធនាយ ខ្រីឞ្ដស្យ ឝរីរស្យ និឞ្ឋាយៃ ច បវិត្រលោកានាំ សិទ្ធតាយាស្តាទ្ឫឝម៑ ឧបាយំ និឝ្ចិតវាន៑។</para>
  <para style="p">
    <verse number="14" style="v"/>អតឯវ មានុឞាណាំ ចាតុរីតោ ភ្រមកធូត៌្តតាយាឝ្ឆលាច្ច ជាតេន សវ៌្វេណ ឝិក្ឞាវាយុនា វយំ យទ៑ ពាលកា ឥវ ទោលាយមានា ន ភ្រាម្យាម ឥត្យស្មាភិ រ្យតិតវ្យំ,</para>
  <para style="p">
    <verse number="15" style="v"/>ប្រេម្នា សត្យតាម៑ អាចរទ្ភិះ សវ៌្វវិឞយេ ខ្រីឞ្ដម៑ ឧទ្ទិឝ្យ វទ៌្ធិតវ្យញ្ច, យតះ ស មូទ៌្ធា,</para>
  <para style="p">
    <verse number="16" style="v"/>តស្មាច្ចៃកៃកស្យាង្គស្យ ស្វស្វបរិមាណានុសារេណ សាហាយ្យករណាទ៑ ឧបការកៃះ សវ៌្វៃះ សន្ធិភិះ ក្ឫត្ស្នស្យ ឝរីរស្យ សំយោគេ សម្មិលនេ ច ជាតេ ប្រេម្នា និឞ្ឋាំ លភមានំ ក្ឫត្ស្នំ ឝរីរំ វ្ឫទ្ធិំ ប្រាប្នោតិ។</para>
  <para style="p">
    <verse number="17" style="v"/>យុឞ្មាន៑ អហំ ប្រភុនេទំ ព្រវីម្យាទិឝាមិ ច, អន្យេ ភិន្នជាតីយា ឥវ យូយំ បូន រ្មាចរត។</para>
  <para style="p">
    <verse number="18" style="v"/>យតស្តេ ស្វមនោមាយាម៑ អាចរន្ត្យាន្តរិកាជ្ញានាត៑ មានសិកកាឋិន្យាច្ច តិមិរាវ្ឫតពុទ្ធយ ឦឝ្វរីយជីវនស្យ ពគីព៌្ហូតាឝ្ច ភវន្តិ,</para>
  <para style="p">
    <verse number="19" style="v"/>ស្វាន៑ ចៃតន្យឝូន្យាន៑ ក្ឫត្វា ច លោភេន សវ៌្វវិធាឝៅចាចរណាយ លម្បដតាយាំ ស្វាន៑ សមប៌ិតវន្តះ។</para>
  <para style="p">
    <verse number="20" style="v"/>កិន្តុ យូយំ ខ្រីឞ្ដំ ន តាទ្ឫឝំ បរិចិតវន្តះ,</para>
  <para style="p">
    <verse number="21" style="v"/>យតោ យូយំ តំ ឝ្រុតវន្តោ យា សត្យា ឝិក្ឞា យីឝុតោ លភ្យា តទនុសារាត៑ តទីយោបទេឝំ ប្រាប្តវន្តឝ្ចេតិ មន្យេ។</para>
  <para style="p">
    <verse number="22" style="v"/>តស្មាត៑ បូវ៌្វកាលិកាចារការី យះ បុរាតនបុរុឞោ មាយាភិលាឞៃ រ្នឝ្យតិ តំ ត្យក្ត្វា យុឞ្មាភិ រ្មានសិកភាវោ នូតនីកត៌្តវ្យះ,</para>
  <para style="p">
    <verse number="23" style="v"/>យោ នវបុរុឞ ឦឝ្វរានុរូបេណ បុណ្យេន សត្យតាសហិតេន</para>
  <para style="p">
    <verse number="24" style="v"/>ធាម៌្មិកត្វេន ច ស្ឫឞ្ដះ ស ឯវ បរិធាតវ្យឝ្ច។</para>
  <para style="p">
    <verse number="25" style="v"/>អតោ យូយំ សវ៌្វេ មិថ្យាកថនំ បរិត្យជ្យ សមីបវាសិភិះ សហ សត្យាលាបំ កុរុត យតោ វយំ បរស្បរម៑ អង្គប្រត្យង្គា ភវាមះ។</para>
  <para style="p">
    <verse number="26" style="v"/>អបរំ ក្រោធេ ជាតេ បាបំ មា កុរុធ្វម៑, អឝាន្តេ យុឞ្មាកំ រោឞេសូយ៌្យោៜស្តំ ន គច្ឆតុ។</para>
  <para style="p">
    <verse number="27" style="v"/>អបរំ ឝយតានេ ស្ថានំ មា ទត្ត។</para>
  <para style="p">
    <verse number="28" style="v"/>ចោរះ បុនឝ្ចៃយ៌្យំ ន ករោតុ កិន្តុ ទីនាយ ទានេ សាមត៌្ហ្យំ យជ្ជាយតេ តទត៌្ហំ ស្វករាភ្យាំ សទ្វ្ឫត្ត្យា បរិឝ្រមំ ករោតុ។</para>
  <para style="p">
    <verse number="29" style="v"/>អបរំ យុឞ្មាកំ វទនេភ្យះ កោៜបិ កទាលាបោ ន និគ៌ច្ឆតុ, កិន្តុ យេន ឝ្រោតុរុបការោ ជាយតេ តាទ្ឫឝះ ប្រយោជនីយនិឞ្ឋាយៃ ផលទាយក អាលាបោ យុឞ្មាកំ ភវតុ។</para>
  <para style="p">
    <verse number="30" style="v"/>អបរញ្ច យូយំ មុក្តិទិនបយ៌្យន្តម៑ ឦឝ្វរស្យ យេន បវិត្រេណាត្មនា មុទ្រយាង្កិតា អភវត តំ ឝោកាន្វិតំ មា កុរុត។</para>
  <para style="p">
    <verse number="31" style="v"/>អបរំ កដុវាក្យំ រោឞះ កោឞះ កលហោ និន្ទា សវ៌្វវិធទ្វេឞឝ្ចៃតានិ យុឞ្មាកំ មធ្យាទ៑ ទូរីភវន្តុ។</para>
  <para style="p">
    <verse number="32" style="v"/>យូយំ បរស្បរំ ហិតៃឞិណះ កោមលាន្តះករណាឝ្ច ភវត។ អបរម៑ ឦឝ្វរះ ខ្រីឞ្ដេន យទ្វទ៑ យុឞ្មាកំ ទោឞាន៑ ក្ឞមិតវាន៑ តទ្វទ៑ យូយមបិ បរស្បរំ ក្ឞមធ្វំ។</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អតោ យូយំ ប្រិយពាលកា ឥវេឝ្វរស្យានុការិណោ ភវត,</para>
  <para style="p">
    <verse number="2" style="v"/>ខ្រីឞ្ដ ឥវ ប្រេមាចារំ កុរុត ច, យតះ សោៜស្មាសុ ប្រេម ក្ឫតវាន៑ អស្មាកំ វិនិមយេន ចាត្មនិវេទនំ ក្ឫត្វា គ្រាហ្យសុគន្ធាត៌្ហកម៑ ឧបហារំ ពលិញ្ចេឝ្វរាច ទត្តវាន៑។</para>
  <para style="p">
    <verse number="3" style="v"/>កិន្តុ វេឝ្យាគមនំ សវ៌្វវិធាឝៅចក្រិយា លោភឝ្ចៃតេឞាម៑ ឧច្ចារណមបិ យុឞ្មាកំ មធ្យេ ន ភវតុ, ឯតទេវ បវិត្រលោកានាម៑ ឧចិតំ។</para>
  <para style="p">
    <verse number="4" style="v"/>អបរំ កុត្សិតាលាបះ ប្រលាបះ ឝ្លេឞោក្តិឝ្ច ន ភវតុ យត ឯតាន្យនុចិតានិ កិន្ត្វីឝ្វរស្យ ធន្យវាទោ ភវតុ។</para>
  <para style="p">
    <verse number="5" style="v"/>វេឝ្យាគាម្យឝៅចាចារី ទេវបូជក ឥវ គណ្យោ លោភី ចៃតេឞាំ កោឞិ ខ្រីឞ្ដស្យ រាជ្យេៜរ្ថត ឦឝ្វរស្យ រាជ្យេ កមប្យធិការំ ន ប្រាប្ស្យតីតិ យុឞ្មាភិះ សម្យក៑ ជ្ញាយតាំ។</para>
  <para style="p">
    <verse number="6" style="v"/>អនត៌្ហកវាក្យេន កោៜបិ យុឞ្មាន៑ ន វញ្ចយតុ យតស្តាទ្ឫគាចារហេតោរនាជ្ញាគ្រាហិឞុ លោកេឞ្វីឝ្វរស្យ កោបោ វត៌្តតេ។</para>
  <para style="p">
    <verse number="7" style="v"/>តស្មាទ៑ យូយំ តៃះ សហភាគិនោ ន ភវត។</para>
  <para style="p">
    <verse number="8" style="v"/>បូវ៌្វំ យូយម៑ អន្ធការស្វរូបា អាធ្វំ កិន្ត្វិទានីំ ប្រភុនា ទីប្តិស្វរូបា ភវថ តស្មាទ៑ ទីប្តេះ សន្តានា ឥវ សមាចរត។</para>
  <para style="p">
    <verse number="9" style="v"/>ទីប្តេ រ្យត៑ ផលំ តត៑ សវ៌្វវិធហិតៃឞិតាយាំ ធម៌្មេ សត្យាលាបេ ច ប្រកាឝតេ។</para>
  <para style="p">
    <verse number="10" style="v"/>ប្រភវេ យទ៑ រោចតេ តត៑ បរីក្ឞធ្វំ។</para>
  <para style="p">
    <verse number="11" style="v"/>យូយំ តិមិរស្យ វិផលកម៌្មណាម៑ អំឝិនោ ន ភូត្វា តេឞាំ ទោឞិត្វំ ប្រកាឝយត។</para>
  <para style="p">
    <verse number="12" style="v"/>យតស្តេ លោកា រហមិ យទ៑ យទ៑ អាចរន្តិ តទុច្ចារណម៑ អបិ លជ្ជាជនកំ។</para>
  <para style="p">
    <verse number="13" style="v"/>យតោ ទីប្ត្យា យទ៑ យត៑ ប្រកាឝ្យតេ តត៑ តយា ចកាស្យតេ យច្ច ចកាស្តិ តទ៑ ទីប្តិស្វរូបំ ភវតិ។</para>
  <para style="p">
    <verse number="14" style="v"/>ឯតត្ការណាទ៑ ឧក្តម៑ អាស្តេ, "ហេ និទ្រិត ប្រពុធ្យស្វ ម្ឫតេភ្យឝ្ចោត្ថិតិំ កុរុ។ តត្ក្ឫតេ សូយ៌្យវត៑ ខ្រីឞ្ដះ ស្វយំ ត្វាំ ទ្យោតយិឞ្យតិ។ "</para>
  <para style="p">
    <verse number="15" style="v"/>អតះ សាវធានា ភវត, អជ្ញានា ឥវ មាចរត កិន្តុ ជ្ញានិន ឥវ សតក៌ម៑ អាចរត។</para>
  <para style="p">
    <verse number="16" style="v"/>សមយំ ពហុមូល្យំ គណយធ្វំ យតះ កាលា អភទ្រាះ។</para>
  <para style="p">
    <verse number="17" style="v"/>តស្មាទ៑ យូយម៑ អជ្ញានា ន ភវត កិន្តុ ប្រភោរភិមតំ កិំ តទវគតា ភវត។</para>
  <para style="p">
    <verse number="18" style="v"/>សវ៌្វនាឝជនកេន សុរាបានេន មត្តា មា ភវត កិន្ត្វាត្មនា បូយ៌្យធ្វំ។</para>
  <para style="p">
    <verse number="19" style="v"/>អបរំ គីតៃ រ្គានៃះ បារមាត៌្ហិកកីត៌្តនៃឝ្ច បរស្បរម៑ អាលបន្តោ មនសា សាទ៌្ធំ ប្រភុម៑ ឧទ្ទិឝ្យ គាយត វាទយត ច។</para>
  <para style="p">
    <verse number="20" style="v"/>សវ៌្វទា សវ៌្វវិឞយេៜស្មត្ប្រភោ យីឝោះ ខ្រីឞ្ដស្យ នាម្នា តាតម៑ ឦឝ្វរំ ធន្យំ វទត។</para>
  <para style="p">
    <verse number="21" style="v"/>យូយម៑ ឦឝ្វរាទ៑ ភីតាះ សន្ត អន្យេៜបរេឞាំ វឝីភូតា ភវត។</para>
  <para style="p">
    <verse number="22" style="v"/>ហេ យោឞិតះ, យូយំ យថា ប្រភោស្តថា ស្វស្វស្វាមិនោ វឝង្គតា ភវត។</para>
  <para style="p">
    <verse number="23" style="v"/>យតះ ខ្រីឞ្ដោ យទ្វត៑ សមិតេ រ្មូទ៌្ធា ឝរីរស្យ ត្រាតា ច ភវតិ តទ្វត៑ ស្វាមី យោឞិតោ មូទ៌្ធា។</para>
  <para style="p">
    <verse number="24" style="v"/>អតះ សមិតិ រ្យទ្វត៑ ខ្រីឞ្ដស្យ វឝីភូតា តទ្វទ៑ យោឞិទ្ភិរបិ ស្វស្វស្វាមិនោ វឝតា ស្វីកត៌្តវ្យា។</para>
  <para style="p">
    <verse number="25" style="v"/>អបរញ្ច ហេ បុរុឞាះ, យូយំ ខ្រីឞ្ដ ឥវ ស្វស្វយោឞិត្សុ ប្រីយធ្វំ។</para>
  <para style="p">
    <verse number="26" style="v"/>ស ខ្រីឞ្ដោៜបិ សមិតៅ ប្រីតវាន៑ តស្យាះ ក្ឫតេ ច ស្វប្រាណាន៑ ត្យក្តវាន៑ យតះ ស វាក្យេ ជលមជ្ជនេន តាំ បរិឞ្ក្ឫត្យ បាវយិតុម្</para>
  <para style="p">
    <verse number="27" style="v"/>អបរំ តិលកវល្យាទិវិហីនាំ បវិត្រាំ និឞ្កលង្កាញ្ច តាំ សមិតិំ តេជស្វិនីំ ក្ឫត្វា ស្វហស្តេ សមប៌យិតុញ្ចាភិលឞិតវាន៑។</para>
  <para style="p">
    <verse number="28" style="v"/>តស្មាត៑ ស្វតនុវត៑ ស្វយោឞិតិ ប្រេមករណំ បុរុឞស្យោចិតំ, យេន ស្វយោឞិតិ ប្រេម ក្រិយតេ តេនាត្មប្រេម ក្រិយតេ។</para>
  <para style="p">
    <verse number="29" style="v"/>កោៜបិ កទាបិ ន ស្វកីយាំ តនុម៑ ឫតីយិតវាន៑ កិន្តុ សវ៌្វេ តាំ វិភ្រតិ បុឞ្ណន្តិ ច។ ខ្រីឞ្ដោៜបិ សមិតិំ ប្រតិ តទេវ ករោតិ,</para>
  <para style="p">
    <verse number="30" style="v"/>យតោ វយំ តស្យ ឝរីរស្យាង្គានិ មាំសាស្ថីនិ ច ភវាមះ។</para>
  <para style="p">
    <verse number="31" style="v"/>ឯតទត៌្ហំ មានវះ ស្វមាតាបិតរោै បរិត្យជ្យ ស្វភាយ៌្យាយាម៑ អាសំក្ឞ្យតិ តៅ ទ្វៅ ជនាវេកាង្គៅ ភវិឞ្យតះ។</para>
  <para style="p">
    <verse number="32" style="v"/>ឯតន្និគូឍវាក្យំ គុរុតរំ មយា ច ខ្រីឞ្ដសមិតី អធិ តទ៑ ឧច្យតេ។</para>
  <para style="p">
    <verse number="33" style="v"/>អតឯវ យុឞ្មាកម៑ ឯកៃកោ ជន អាត្មវត៑ ស្វយោឞិតិ ប្រីយតាំ ភាយ៌្យាបិ ស្វាមិនំ សមាទត៌្តុំ យតតាំ។</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ហេ ពាលកាះ, យូយំ ប្រភុម៑ ឧទ្ទិឝ្យ បិត្រោរាជ្ញាគ្រាហិណោ ភវត យតស្តត៑ ន្យាយ្យំ។</para>
  <para style="p">
    <verse number="2" style="v"/>ត្វំ និជបិតរំ មាតរញ្ច សម្មន្យស្វេតិ យោ វិធិះ ស ប្រតិជ្ញាយុក្តះ ប្រថមោ វិធិះ</para>
  <para style="p">
    <verse number="3" style="v"/>ផលតស្តស្មាត៑ តវ កល្យាណំ ទេឝេ ច ទីគ៌្ហកាលម៑ អាយុ រ្ភវិឞ្យតីតិ។</para>
  <para style="p">
    <verse number="4" style="v"/>អបរំ ហេ បិតរះ, យូយំ ស្វពាលកាន៑ មា រោឞយត កិន្តុ ប្រភោ រ្វិនីត្យាទេឝាភ្យាំ តាន៑ វិនយត។</para>
  <para style="p">
    <verse number="5" style="v"/>ហេ ទាសាះ, យូយំ ខ្រីឞ្ដម៑ ឧទ្ទិឝ្យ សភយាះ កម្បាន្វិតាឝ្ច ភូត្វា សរលាន្តះករណៃរៃហិកប្រភូនាម៑ អាជ្ញាគ្រាហិណោ ភវត។</para>
  <para style="p">
    <verse number="6" style="v"/>ទ្ឫឞ្ដិគោចរីយបរិចយ៌្យយា មានុឞេភ្យោ រោចិតុំ មា យតធ្វំ កិន្តុ ខ្រីឞ្ដស្យ ទាសា ឥវ និវិឞ្ដមនោភិរីឝ្ចរស្យេច្ឆាំ សាធយត។</para>
  <para style="p">
    <verse number="7" style="v"/>មានវាន៑ អនុទ្ទិឝ្យ ប្រភុមេវោទ្ទិឝ្យ សទ្ភាវេន ទាស្យកម៌្ម កុរុធ្វំ។</para>
  <para style="p">
    <verse number="8" style="v"/>ទាសមុក្តយោ រ្យេន យត៑ សត្កម៌្ម ក្រិយតេ តេន តស្យ ផលំ ប្រភុតោ លប្ស្យត ឥតិ ជានីត ច។</para>
  <para style="p">
    <verse number="9" style="v"/>អបរំ ហេ ប្រភវះ, យុឞ្មាភិ រ្ភត៌្សនំ វិហាយ តាន៑ ប្រតិ ន្យាយ្យាចរណំ ក្រិយតាំ យឝ្ច កស្យាបិ បក្ឞបាតំ ន ករោតិ យុឞ្មាកមបិ តាទ្ឫឝ ឯកះ ប្រភុះ ស្វគ៌េ វិទ្យត ឥតិ ជ្ញាយតាំ។</para>
  <para style="p">
    <verse number="10" style="v"/>អធិកន្តុ ហេ ភ្រាតរះ, យូយំ ប្រភុនា តស្យ វិក្រមយុក្តឝក្ត្យា ច ពលវន្តោ ភវត។</para>
  <para style="p">
    <verse number="11" style="v"/>យូយំ យត៑ ឝយតានឝ្ឆលានិ និវារយិតុំ ឝក្នុថ តទត៌្ហម៑ ឦឝ្វរីយសុសជ្ជាំ បរិធទ្ធ្វំ។</para>
  <para style="p">
    <verse number="12" style="v"/>យតះ កេវលំ រក្តមាំសាភ្យាម៑ ឥតិ នហិ កិន្តុ កត៌្ឫត្វបរាក្រមយុក្តៃស្តិមិររាជ្យស្យេហលោកស្យាធិបតិភិះ ស្វគ៌ោទ្ភវៃ រ្ទុឞ្ដាត្មភិរេវ សាទ៌្ធម៑ អស្មាភិ រ្យុទ្ធំ ក្រិយតេ។</para>
  <para style="p">
    <verse number="13" style="v"/>អតោ ហេតោ រ្យូយំ យយា សំកុेលេ ទិនេៜវស្ថាតុំ សវ៌្វាណិ បរាជិត្យ ទ្ឫឍាះ ស្ថាតុញ្ច ឝក្ឞ្យថ តាម៑ ឦឝ្វរីយសុសជ្ជាំ គ្ឫហ្លីត។</para>
  <para style="p">
    <verse number="14" style="v"/>វស្តុតស្តុ សត្យត្វេន ឝ្ឫង្ខលេន កដិំ ពទ្ធ្វា បុណ្យេន វម៌្មណា វក្ឞ អាច្ឆាទ្យ</para>
  <para style="p">
    <verse number="15" style="v"/>ឝាន្តេះ សុវាត៌្តយា ជាតម៑ ឧត្សាហំ បាទុកាយុគលំ បទេ សមប៌្យ តិឞ្ឋត។</para>
  <para style="p">
    <verse number="16" style="v"/>យេន ច ទុឞ្ដាត្មនោៜគ្និពាណាន៑ សវ៌្វាន៑ និវ៌្វាបយិតុំ ឝក្ឞ្យថ តាទ្ឫឝំ សវ៌្វាច្ឆាទកំ ផលកំ វិឝ្វាសំ ធារយត។</para>
  <para style="p">
    <verse number="17" style="v"/>ឝិរស្ត្រំ បរិត្រាណម៑ អាត្មនះ ខង្គញ្ចេឝ្វរស្យ វាក្យំ ធារយត។</para>
  <para style="p">
    <verse number="18" style="v"/>សវ៌្វសមយេ សវ៌្វយាចនេន សវ៌្វប្រាត៌្ហនេន ចាត្មនា ប្រាត៌្ហនាំ កុរុធ្វំ តទត៌្ហំ ទ្ឫឍាកាង្ក្ឞយា ជាគ្រតះ សវ៌្វេឞាំ បវិត្រលោកានាំ ក្ឫតេ សទា ប្រាត៌្ហនាំ កុរុធ្វំ។</para>
  <para style="p">
    <verse number="19" style="v"/>អហញ្ច យស្យ សុសំវាទស្យ ឝ្ឫង្ខលពទ្ធះ ប្រចារកទូតោៜស្មិ តម៑ ឧបយុក្តេនោត្សាហេន ប្រចារយិតុំ យថា ឝក្នុយាំ</para>
  <para style="p">
    <verse number="20" style="v"/>តថា និព៌្ហយេន ស្វរេណោត្សាហេន ច សុសំវាទស្យ និគូឍវាក្យប្រចារាយ វក្ត្ឫाតា យត៑ មហ្យំ ទីយតេ តទត៌្ហំ មមាបិ ក្ឫតេ ប្រាត៌្ហនាំ កុរុធ្វំ។</para>
  <para style="p">
    <verse number="21" style="v"/>អបរំ មម យាវស្ថាស្តិ យច្ច មយា ក្រិយតេ តត៑ សវ៌្វំ យទ៑ យុឞ្មាភិ រ្ជ្ញាយតេ តទត៌្ហំ ប្រភុនា ប្រិយភ្រាតា វិឝ្វាស្យះ បរិចារកឝ្ច តុខិកោ យុឞ្មាន៑ តត៑ ជ្ញាបយិឞ្យតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>យូយំ យទ៑ អស្មាកម៑ អវស្ថាំ ជានីថ យុឞ្មាកំ មនាំសិ ច យត៑ សាន្ត្វនាំ លភន្តេ តទត៌្ហមេវាហំ យុឞ្មាកំ សន្និធិំ តំ ប្រេឞិតវាន។</para>
  <para style="p">
    <verse number="23" style="v"/>អបរម៑ ឦឝ្វរះ ប្រភុ រ្យីឝុខ្រីឞ្ដឝ្ច សវ៌្វេភ្យោ ភ្រាត្ឫភ្យះ ឝាន្តិំ វិឝ្វាសសហិតំ ប្រេម ច ទេយាត៑។</para>
  <para style="p">
    <verse number="24" style="v"/>យេ កេចិត៑ ប្រភៅ យីឝុខ្រីឞ្ដេៜក្ឞយំ ប្រេម កុវ៌្វន្តិ តាន៑ ប្រតិ ប្រសាទោ ភូយាត៑។ តថាស្តុ។</para>
</usx>
