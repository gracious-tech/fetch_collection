<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="HEB" style="id">Sanskrit Bible (NT) in Khmer Script (សត្យវេទះ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Hebrews</para>
  <para style="toc1">ឥព្រិណះ បត្រំ</para>
  <para style="toc2">ឥព្រិណះ</para>
  <para style="toc3">ឥព្រិណះ</para>
  <para style="mt1">ឥព្រិណះ បត្រំ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>បុរា យ ឦឝ្វរោ ភវិឞ្យទ្វាទិភិះ បិត្ឫលោកេភ្យោ នានាសមយេ នានាប្រការំ កថិតវាន្</para>
  <para style="p">
    <verse number="2" style="v"/>ស ឯតស្មិន៑ ឝេឞកាលេ និជបុត្រេណាស្មភ្យំ កថិតវាន៑។ ស តំ បុត្រំ សវ៌្វាធិការិណំ ក្ឫតវាន៑ តេនៃវ ច សវ៌្វជគន្តិ ស្ឫឞ្ដវាន៑។</para>
  <para style="p">
    <verse number="3" style="v"/>ស បុត្រស្តស្យ ប្រភាវស្យ ប្រតិពិម្ពស្តស្យ តត្ត្វស្យ មូត៌្តិឝ្ចាស្តិ ស្វីយឝក្តិវាក្យេន សវ៌្វំ ធត្តេ ច ស្វប្រាណៃរស្មាកំ បាបមាជ៌្ជនំ ក្ឫត្វា ឩទ៌្ធ្វស្ថានេ មហាមហិម្នោ ទក្ឞិណបាឝ៌្វេ សមុបវិឞ្ដវាន៑។</para>
  <para style="p">
    <verse number="4" style="v"/>ទិវ្យទូតគណាទ៑ យថា ស វិឝិឞ្ដនាម្នោ ៜធិការី ជាតស្តថា តេភ្យោៜបិ ឝ្រេឞ្ឋោ ជាតះ។</para>
  <para style="p">
    <verse number="5" style="v"/>យតោ ទូតានាំ មធ្យេ កទាចិទីឝ្វរេណេទំ ក ឧក្តះ? យថា, "មទីយតនយោ ៜសិ ត្វម៑ អទ្យៃវ ជនិតោ មយា។ " បុនឝ្ច "អហំ តស្យ បិតា ភវិឞ្យាមិ ស ច មម បុត្រោ ភវិឞ្យតិ។ "</para>
  <para style="p">
    <verse number="6" style="v"/>អបរំ ជគតិ ស្វកីយាទ្វិតីយបុត្រស្យ បុនរានយនកាលេ តេនោក្តំ, យថា, "ឦឝ្វរស្យ សកលៃ រ្ទូតៃរេឞ ឯវ ប្រណម្យតាំ។ "</para>
  <para style="p">
    <verse number="7" style="v"/>ទូតាន៑ អធិ តេនេទម៑ ឧក្តំ, យថា, "ស ករោតិ និជាន៑ ទូតាន៑ គន្ធវាហស្វរូបកាន៑។ វហ្និឝិខាស្វរូបាំឝ្ច ករោតិ និជសេវកាន៑៕ "</para>
  <para style="p">
    <verse number="8" style="v"/>កិន្តុ បុត្រមុទ្ទិឝ្យ តេនោក្តំ, យថា, "ហេ ឦឝ្វរ សទា ស្ថាយិ តវ សិំហាសនំ ភវេត៑។ យាថាត៌្ហ្យស្យ ភវេទ្ទណ្ឌោ រាជទណ្ឌស្ត្វទីយកះ។</para>
  <para style="p">
    <verse number="9" style="v"/>បុណ្យេ ប្រេម ករោឞិ ត្វំ កិញ្ចាធម៌្មម៑ ឫតីយសេ។ តស្មាទ៑ យ ឦឝ ឦឝស្តេ ស តេ មិត្រគណាទបិ។ អធិកាហ្លាទតៃលេន សេចនំ ក្ឫតវាន៑ តវ៕ "</para>
  <para style="p">
    <verse number="10" style="v"/>បុនឝ្ច, យថា, "ហេ ប្រភោ ប្ឫថិវីមូលម៑ អាទៅ សំស្ថាបិតំ ត្វយា។ តថា ត្វទីយហស្តេន ក្ឫតំ គគនមណ្ឌលំ។</para>
  <para style="p">
    <verse number="11" style="v"/>ឥមេ វិនំក្ឞ្យតស្ត្វន្តុ និត្យមេវាវតិឞ្ឋសេ។ ឥទន្តុ សកលំ វិឝ្វំ សំជរិឞ្យតិ វស្ត្រវត៑។</para>
  <para style="p">
    <verse number="12" style="v"/>សង្កោចិតំ ត្វយា តត្តុ វស្ត្រវត៑ បរិវត៌្ស្យតេ។ ត្វន្តុ និត្យំ ស ឯវាសី រ្និរន្តាស្តវ វត្សរាះ៕ "</para>
  <para style="p">
    <verse number="13" style="v"/>អបរំ ទូតានាំ មធ្យេ កះ កទាចិទីឝ្វរេណេទមុក្តះ? យថា, "តវារីន៑ បាទបីឋំ តេ យាវន្នហិ ករោម្យហំ។ មម ទក្ឞិណទិគ្ភាគេ តាវត៑ ត្វំ សមុបាវិឝ៕ "</para>
  <para style="p">
    <verse number="14" style="v"/>យេ បរិត្រាណស្យាធិការិណោ ភវិឞ្យន្តិ តេឞាំ បរិចយ៌្យាត៌្ហំ ប្រេឞ្យមាណាះ សេវនការិណ អាត្មានះ កិំ តេ សវ៌្វេ ទូតា នហិ?</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អតោ វយំ យទ៑ ភ្រមស្រោតសា នាបនីយាមហេ តទត៌្ហមស្មាភិ រ្យទ្យទ៑ អឝ្រាវិ តស្មិន៑ មនាំសិ និធាតវ្យានិ។</para>
  <para style="p">
    <verse number="2" style="v"/>យតោ ហេតោ ទូតៃះ កថិតំ វាក្យំ យទ្យមោឃម៑ អភវទ៑ យទិ ច តល្លង្ឃនការិណេ តស្យាគ្រាហកាយ ច សវ៌្វស្មៃ សមុចិតំ ទណ្ឌម៑ អទីយត,</para>
  <para style="p">
    <verse number="3" style="v"/>តហ៌្យស្មាភិស្តាទ្ឫឝំ មហាបរិត្រាណម៑ អវជ្ញាយ កថំ រក្ឞា ប្រាប្ស្យតេ, យត៑ ប្រថមតះ ប្រភុនា ប្រោក្តំ តតោៜស្មាន៑ យាវត៑ តស្យ ឝ្រោត្ឫភិះ ស្ថិរីក្ឫតំ,</para>
  <para style="p">
    <verse number="4" style="v"/>អបរំ លក្ឞណៃរទ្ភុតកម៌្មភិ រ្វិវិធឝក្តិប្រកាឝេន និជេច្ឆាតះ បវិត្រស្យាត្មនោ វិភាគេន ច យទ៑ ឦឝ្វរេណ ប្រមាណីក្ឫតម៑ អភូត៑។</para>
  <para style="p">
    <verse number="5" style="v"/>វយំ តុ យស្យ ភាវិរាជ្យស្យ កថាំ កថយាមះ, តត៑ តេន៑ ទិវ្យទូតានាម៑ អធីនីក្ឫតមិតិ នហិ។</para>
  <para style="p">
    <verse number="6" style="v"/>កិន្តុ កុត្រាបិ កឝ្ចិត៑ ប្រមាណម៑ ឦទ្ឫឝំ ទត្តវាន៑, យថា, "កិំ វស្តុ មានវោ យត៑ ស និត្យំ សំស្មយ៌្យតេ ត្វយា។ កិំ វា មានវសន្តានោ យត៑ ស អាលោច្យតេ ត្វយា។</para>
  <para style="p">
    <verse number="7" style="v"/>ទិវ្យទតគណេភ្យះ ស កិញ្ចិន៑ ន្យូនះ ក្ឫតស្ត្វយា។ តេជោគៅរវរូបេណ កិរីដេន វិភូឞិតះ។ ស្ឫឞ្ដំ យត៑ តេ ករាភ្យាំ ស តត្ប្រភុត្វេ និយោជិតះ។</para>
  <para style="p">
    <verse number="8" style="v"/>ចរណាធឝ្ច តស្យៃវ ត្វយា សវ៌្វំ វឝីក្ឫតំ៕ " តេន សវ៌្វំ យស្យ វឝីក្ឫតំ តស្យាវឝីភូតំ កិមបិ នាវឝេឞិតំ កិន្ត្វធុនាបិ វយំ សវ៌្វាណិ តស្យ វឝីភូតានិ ន បឝ្យាមះ។</para>
  <para style="p">
    <verse number="9" style="v"/>តថាបិ ទិវ្យទូតគណេភ្យោ យះ កិញ្ចិន៑ ន្យូនីក្ឫតោៜភវត៑ តំ យីឝុំ ម្ឫត្យុភោគហេតោស្តេជោគៅរវរូបេណ កិរីដេន វិភូឞិតំ បឝ្យាមះ, យត ឦឝ្វរស្យានុគ្រហាត៑ ស សវ៌្វេឞាំ ក្ឫតេ ម្ឫត្យុម៑ អស្វទត។</para>
  <para style="p">
    <verse number="10" style="v"/>អបរញ្ច យស្មៃ យេន ច ក្ឫត្ស្នំ វស្តុ ស្ឫឞ្ដំ វិទ្យតេ ពហុសន្តានានាំ វិភវាយានយនកាលេ តេឞាំ បរិត្រាណាគ្រសរស្យ ទុះខភោគេន សិទ្ធីករណមបិ តស្យោបយុក្តម៑ អភវត៑។</para>
  <para style="p">
    <verse number="11" style="v"/>យតះ បាវកះ បូយមានាឝ្ច សវ៌្វេ ឯកស្មាទេវោត្បន្នា ភវន្តិ, ឥតិ ហេតោះ ស តាន៑ ភ្រាត្ឫន៑ វទិតុំ ន លជ្ជតេ។</para>
  <para style="p">
    <verse number="12" style="v"/>តេន ស ឧក្តវាន៑, យថា, "ទ្យោតយិឞ្យាមិ តេ នាម ភ្រាត្ឫណាំ មធ្យតោ មម។ បរន្តុ សមិតេ រ្មធ្យេ ករិឞ្យេ តេ ប្រឝំសនំ៕ "</para>
  <para style="p">
    <verse number="13" style="v"/>បុនរបិ, យថា, "តស្មិន៑ វិឝ្វស្យ ស្ថាតាហំ។ " បុនរបិ, យថា, "បឝ្យាហម៑ អបត្យានិ ច ទត្តានិ មហ្យម៑ ឦឝ្វរាត៑។ "</para>
  <para style="p">
    <verse number="14" style="v"/>តេឞាម៑ អបត្យានាំ រុធិរបលលវិឝិឞ្ដត្វាត៑ សោៜបិ តទ្វត៑ តទ្វិឝិឞ្ដោៜភូត៑ តស្យាភិប្រាយោៜយំ យត៑ ស ម្ឫត្យុពលាធិការិណំ ឝយតានំ ម្ឫត្យុនា ពលហីនំ កុយ៌្យាត្</para>
  <para style="p">
    <verse number="15" style="v"/>យេ ច ម្ឫត្យុភយាទ៑ យាវជ្ជីវនំ ទាសត្វស្យ និឃ្នា អាសន៑ តាន៑ ឧទ្ធារយេត៑។</para>
  <para style="p">
    <verse number="16" style="v"/>ស ទូតានាម៑ ឧបការី ន ភវតិ កិន្ត្វិព្រាហីមោ វំឝស្យៃវោបការី ភវតី។</para>
  <para style="p">
    <verse number="17" style="v"/>អតោ ហេតោះ ស យថា ក្ឫបាវាន៑ ប្រជានាំ បាបឝោធនាត៌្ហម៑ ឦឝ្វរោទ្ទេឝ្យវិឞយេ វិឝ្វាស្យោ មហាយាជកោ ភវេត៑ តទត៌្ហំ សវ៌្វវិឞយេ ស្វភ្រាត្ឫណាំ សទ្ឫឝីភវនំ តស្យោចិតម៑ អាសីត៑។</para>
  <para style="p">
    <verse number="18" style="v"/>យតះ ស ស្វយំ បរីក្ឞាំ គត្វា យំ ទុះខភោគម៑ អវគតស្តេន បរីក្ឞាក្រាន្តាន៑ ឧបកត៌្តុំ ឝក្នោតិ។</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ហេ ស្វគ៌ីយស្យាហ្វានស្យ សហភាគិនះ បវិត្រភ្រាតរះ, អស្មាកំ ធម៌្មប្រតិជ្ញាយា ទូតោៜគ្រសរឝ្ច យោ យីឝុស្តម៑ អាលោចធ្វំ។</para>
  <para style="p">
    <verse number="2" style="v"/>មូសា យទ្វត៑ តស្យ សវ៌្វបរិវារមធ្យេ វិឝ្វាស្យ អាសីត៑, តទ្វត៑ អយមបិ ស្វនិយោជកស្យ សមីបេ វិឝ្វាស្យោ ភវតិ។</para>
  <para style="p">
    <verse number="3" style="v"/>បរិវារាច្ច យទ្វត៑ តត្ស្ថាបយិតុរធិកំ គៅរវំ ភវតិ តទ្វត៑ មូសសោៜយំ ពហុតរគៅរវស្យ យោគ្យោ ភវតិ។</para>
  <para style="p">
    <verse number="4" style="v"/>ឯកៃកស្យ និវេឝនស្យ បរិជនានាំ ស្ថាបយិតា កឝ្ចិទ៑ វិទ្យតេ យឝ្ច សវ៌្វស្ថាបយិតា ស ឦឝ្វរ ឯវ។</para>
  <para style="p">
    <verse number="5" style="v"/>មូសាឝ្ច វក្ឞ្យមាណានាំ សាក្ឞី ភ្ឫត្យ ឥវ តស្យ សវ៌្វបរិជនមធ្យេ វិឝ្វាស្យោៜភវត៑ កិន្តុ ខ្រីឞ្ដស្តស្យ បរិជនានាមធ្យក្ឞ ឥវ។</para>
  <para style="p">
    <verse number="6" style="v"/>វយំ តុ យទិ វិឝ្វាសស្យោត្សាហំ ឝ្លាឃនញ្ច ឝេឞំ យាវទ៑ ធារយាមស្តហ៌ិ តស្យ បរិជនា ភវាមះ។</para>
  <para style="p">
    <verse number="7" style="v"/>អតោ ហេតោះ បវិត្រេណាត្មនា យទ្វត៑ កថិតំ, តទ្វត៑, "អទ្យ យូយំ កថាំ តស្យ យទិ សំឝ្រោតុមិច្ឆថ។</para>
  <para style="p">
    <verse number="8" style="v"/>តហ៌ិ បុរា បរីក្ឞាយា ទិនេ ប្រាន្តរមធ្យតះ។ មទាជ្ញានិគ្រហស្ថានេ យុឞ្មាភិស្តុ ក្ឫតំ យថា។ តថា មា កុរុតេទានីំ កឋិនានិ មនាំសិ វះ។</para>
  <para style="p">
    <verse number="9" style="v"/>យុឞ្មាកំ បិតរស្តត្រ មត្បរីក្ឞាម៑ អកុវ៌្វត។ កុវ៌្វទ្ភិ រ្មេៜនុសន្ធានំ តៃរទ្ឫឝ្យន្ត មត្ក្រិយាះ។ ចត្វារិំឝត្សមា យាវត៑ ក្រុទ្ធ្វាហន្តុ តទន្វយេ។</para>
  <para style="p">
    <verse number="10" style="v"/>អវាទិឞម៑ ឥមេ លោកា ភ្រាន្តាន្តះករណាះ សទា។ មាមកីនានិ វត៌្មានិ បរិជានន្តិ នោ ឥមេ។</para>
  <para style="p">
    <verse number="11" style="v"/>ឥតិ ហេតោរហំ កោបាត៑ ឝបថំ ក្ឫតវាន៑ ឥមំ។ ប្រេវេក្ឞ្យតេ ជនៃរេតៃ រ្ន វិឝ្រាមស្ថលំ មម៕ "</para>
  <para style="p">
    <verse number="12" style="v"/>ហេ ភ្រាតរះ សាវធានា ភវត, អមរេឝ្វរាត៑ និវត៌្តកោ យោៜវិឝ្វាសស្តទ្យុក្តំ ទុឞ្ដាន្តះករណំ យុឞ្មាកំ កស្យាបិ ន ភវតុ។</para>
  <para style="p">
    <verse number="13" style="v"/>កិន្តុ យាវទ៑ អទ្យនាមា សមយោ វិទ្យតេ តាវទ៑ យុឞ្មន្មធ្យេ កោៜបិ បាបស្យ វញ្ចនយា យត៑ កឋោរីក្ឫតោ ន ភវេត៑ តទត៌្ហំ ប្រតិទិនំ បរស្បរម៑ ឧបទិឝត។</para>
  <para style="p">
    <verse number="14" style="v"/>យតោ វយំ ខ្រីឞ្ដស្យាំឝិនោ ជាតាះ កិន្តុ ប្រថមវិឝ្វាសស្យ ទ្ឫឍត្វម៑ អស្មាភិះ ឝេឞំ យាវទ៑ អមោឃំ ធារយិតវ្យំ។</para>
  <para style="p">
    <verse number="15" style="v"/>អទ្យ យូយំ កថាំ តស្យ យទិ សំឝ្រោតុមិច្ឆថ, តហ៌្យាជ្ញាលង្ឃនស្ថានេ យុឞ្មាភិស្តុ ក្ឫតំ យថា, តថា មា កុរុតេទានីំ កឋិនានិ មនាំសិ វ ឥតិ តេន យទុក្តំ,</para>
  <para style="p">
    <verse number="16" style="v"/>តទនុសារាទ៑ យេ ឝ្រុត្វា តស្យ កថាំ ន គ្ឫហីតវន្តស្តេ កេ? កិំ មូសសា មិសរទេឝាទ៑ អាគតាះ សវ៌្វេ លោកា នហិ?</para>
  <para style="p">
    <verse number="17" style="v"/>កេភ្យោ វា ស ចត្វារិំឝទ្វឞ៌ាណិ យាវទ៑ អក្រុធ្យត៑? បាបំ កុវ៌្វតាំ យេឞាំ កុណបាះ ប្រាន្តរេ ៜបតន៑ កិំ តេភ្យោ នហិ?</para>
  <para style="p">
    <verse number="18" style="v"/>ប្រវេក្ឞ្យតេ ជនៃរេតៃ រ្ន វិឝ្រាមស្ថលំ មមេតិ ឝបថះ កេឞាំ វិរុទ្ធំ តេនាការិ? កិម៑ អវិឝ្វាសិនាំ វិរុទ្ធំ នហិ?</para>
  <para style="p">
    <verse number="19" style="v"/>អតស្តេ តត៑ ស្ថានំ ប្រវេឞ្ដុម៑ អវិឝ្វាសាត៑ នាឝក្នុវន៑ ឥតិ វយំ វីក្ឞាមហេ។</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អបរំ តទ្វិឝ្រាមប្រាប្តេះ ប្រតិជ្ញា យទិ តិឞ្ឋតិ តហ៌្យស្មាកំ កឝ្ចិត៑ ចេត៑ តស្យាះ ផលេន វញ្ចិតោ ភវេត៑ វយម៑ ឯតស្មាទ៑ ពិភីមះ។</para>
  <para style="p">
    <verse number="2" style="v"/>យតោ ៜស្មាកំ សមីបេ យទ្វត៑ តទ្វត៑ តេឞាំ សមីបេៜបិ សុសំវាទះ ប្រចារិតោ ៜភវត៑ កិន្តុ តៃះ ឝ្រុតំ វាក្យំ តាន៑ ប្រតិ និឞ្ផលម៑ អភវត៑, យតស្តេ ឝ្រោតារោ វិឝ្វាសេន សាទ៌្ធំ តន្នាមិឝ្រយន៑។</para>
  <para style="p">
    <verse number="3" style="v"/>តទ៑ វិឝ្រាមស្ថានំ វិឝ្វាសិភិរស្មាភិះ ប្រវិឝ្យតេ យតស្តេនោក្តំ, "អហំ កោបាត៑ ឝបថំ ក្ឫតវាន៑ ឥមំ, ប្រវេក្ឞ្យតេ ជនៃរេតៃ រ្ន វិឝ្រាមស្ថលំ មម។ " កិន្តុ តស្យ កម៌្មាណិ ជគតះ ស្ឫឞ្ដិកាលាត៑ សមាប្តានិ សន្តិ។</para>
  <para style="p">
    <verse number="4" style="v"/>យតះ កស្មិំឝ្ចិត៑ ស្ថានេ សប្តមំ ទិនមធិ តេនេទម៑ ឧក្តំ, យថា, "ឦឝ្វរះ សប្តមេ ទិនេ ស្វក្ឫតេភ្យះ សវ៌្វកម៌្មភ្យោ វិឝឝ្រាម។ "</para>
  <para style="p">
    <verse number="5" style="v"/>កិន្ត្វេតស្មិន៑ ស្ថានេ បុនស្តេនោច្យតេ, យថា, "ប្រវេក្ឞ្យតេ ជនៃរេតៃ រ្ន វិឝ្រាមស្ថលំ មម។ "</para>
  <para style="p">
    <verse number="6" style="v"/>ផលតស្តត៑ ស្ថានំ កៃឝ្ចិត៑ ប្រវេឞ្ដវ្យំ កិន្តុ យេ បុរា សុសំវាទំ ឝ្រុតវន្តស្តៃរវិឝ្វាសាត៑ តន្ន ប្រវិឞ្ដម៑,</para>
  <para style="p">
    <verse number="7" style="v"/>ឥតិ ហេតោះ ស បុនរទ្យនាមកំ ទិនំ និរូប្យ ទីគ៌្ហកាលេ គតេៜបិ បូវ៌្វោក្តាំ វាចំ ទាយូទា កថយតិ, យថា, "អទ្យ យូយំ កថាំ តស្យ យទិ សំឝ្រោតុមិច្ឆថ, តហ៌ិ មា កុរុតេទានីំ កឋិនានិ មនាំសិ វះ។ "</para>
  <para style="p">
    <verse number="8" style="v"/>អបរំ យិហោឝូយោ យទិ តាន៑ វ្យឝ្រាមយិឞ្យត៑ តហ៌ិ តតះ បរម៑ អបរស្យ ទិនស្យ វាគ៑ ឦឝ្វរេណ នាកថយិឞ្យត។</para>
  <para style="p">
    <verse number="9" style="v"/>អត ឦឝ្វរស្យ ប្រជាភិះ កត៌្តវ្យ ឯកោ វិឝ្រាមស្តិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="10" style="v"/>អបរម៑ ឦឝ្វរោ យទ្វត៑ ស្វក្ឫតកម៌្មភ្យោ វិឝឝ្រាម តទ្វត៑ តស្យ វិឝ្រាមស្ថានំ ប្រវិឞ្ដោ ជនោៜបិ ស្វក្ឫតកម៌្មភ្យោ វិឝ្រាម្យតិ។</para>
  <para style="p">
    <verse number="11" style="v"/>អតោ វយំ តទ៑ វិឝ្រាមស្ថានំ ប្រវេឞ្ដុំ យតាមហៃ, តទវិឝ្វាសោទាហរណេន កោៜបិ ន បតតុ។</para>
  <para style="p">
    <verse number="12" style="v"/>ឦឝ្វរស្យ វាទោៜមរះ ប្រភាវវិឝិឞ្ដឝ្ច សវ៌្វស្មាទ៑ ទ្វិធារខង្គាទបិ តីក្ឞ្ណះ, អបរំ ប្រាណាត្មនោ រ្គ្រន្ថិមជ្ជយោឝ្ច បរិភេទាយ វិច្ឆេទការី មនសឝ្ច សង្កល្បានាម៑ អភិប្រេតានាញ្ច វិចារកះ។</para>
  <para style="p">
    <verse number="13" style="v"/>អបរំ យស្យ សមីបេ ស្វីយា ស្វីយា កថាស្មាភិះ កថយិតវ្យា តស្យាគោចរះ កោៜបិ ប្រាណី នាស្តិ តស្យ ទ្ឫឞ្ដៅ សវ៌្វមេវានាវ្ឫតំ ប្រកាឝិតញ្ចាស្តេ។</para>
  <para style="p">
    <verse number="14" style="v"/>អបរំ យ ឧច្ចតមំ ស្វគ៌ំ ប្រវិឞ្ដ ឯតាទ្ឫឝ ឯកោ វ្យក្តិរត៌្ហត ឦឝ្វរស្យ បុត្រោ យីឝុរស្មាកំ មហាយាជកោៜស្តិ, អតោ ហេតោ រ្វយំ ធម៌្មប្រតិជ្ញាំ ទ្ឫឍម៑ អាលម្ពាមហៃ។</para>
  <para style="p">
    <verse number="15" style="v"/>អស្មាកំ យោ មហាយាជកោ ៜស្តិ សោៜស្មាកំ ទុះខៃ រ្ទុះខិតោ ភវិតុម៑ អឝក្តោ នហិ កិន្តុ បាបំ វិនា សវ៌្វវិឞយេ វយមិវ បរីក្ឞិតះ។</para>
  <para style="p">
    <verse number="16" style="v"/>អតឯវ ក្ឫបាំ គ្រហីតុំ ប្រយោជនីយោបការាត៌្ហម៑ អនុគ្រហំ ប្រាប្តុញ្ច វយម៑ ឧត្សាហេនានុគ្រហសិំហាសនស្យ សមីបំ យាមះ។</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>យះ កឝ្ចិត៑ មហាយាជកោ ភវតិ ស មានវានាំ មធ្យាត៑ នីតះ សន៑ មានវានាំ ក្ឫត ឦឝ្វរោទ្ទេឝ្យវិឞយេៜរ្ថត ឧបហារាណាំ បាបាត៌្ហកពលីនាញ្ច ទាន និយុជ្យតេ។</para>
  <para style="p">
    <verse number="2" style="v"/>ស ចាជ្ញានាំ ភ្រាន្តានាញ្ច លោកានាំ ទុះខេន ទុះខី ភវិតុំ ឝក្នោតិ, យតោ ហេតោះ ស ស្វយមបិ ទៅព៌្ពល្យវេឞ្ដិតោ ភវតិ។</para>
  <para style="p">
    <verse number="3" style="v"/>ឯតស្មាត៑ ការណាច្ច យទ្វត៑ លោកានាំ ក្ឫតេ តទ្វទ៑ អាត្មក្ឫតេៜបិ បាបាត៌្ហកពលិទានំ តេន កត៌្តវ្យំ។</para>
  <para style="p">
    <verse number="4" style="v"/>ស ឃោច្ចបទះ ស្វេច្ឆាតះ កេនាបិ ន គ្ឫហ្យតេ កិន្តុ ហារោណ ឥវ យ ឦឝ្វរេណាហូយតេ តេនៃវ គ្ឫហ្យតេ។</para>
  <para style="p">
    <verse number="5" style="v"/>ឯវម្ប្រការេណ ខ្រីឞ្ដោៜបិ មហាយាជកត្វំ គ្រហីតុំ ស្វីយគៅរវំ ស្វយំ ន ក្ឫតវាន៑, កិន្តុ "មទីយតនយោៜសិ ត្វម៑ អទ្យៃវ ជនិតោ មយេតិ" វាចំ យស្តំ ភាឞិតវាន៑ ស ឯវ តស្យ គៅរវំ ក្ឫតវាន៑។</para>
  <para style="p">
    <verse number="6" style="v"/>តទ្វទ៑ អន្យគីតេៜបីទមុក្តំ, ត្វំ មល្កីឞេទកះ ឝ្រេណ្យាំ យាជកោៜសិ សទាតនះ។</para>
  <para style="p">
    <verse number="7" style="v"/>ស ច ទេហវាសកាលេ ពហុក្រន្ទនេនាឝ្រុបាតេន ច ម្ឫត្យុត ឧទ្ធរណេ សមត៌្ហស្យ បិតុះ សមីបេ បុនះ បុនវ៌ិនតិំ ប្រត៌្ហនាញ្ច ក្ឫត្វា តត្ផលរូបិណីំ ឝង្កាតោ រក្ឞាំ ប្រាប្យ ច</para>
  <para style="p">
    <verse number="8" style="v"/>យទ្យបិ បុត្រោៜភវត៑ តថាបិ យៃរក្លិឝ្យត តៃរាជ្ញាគ្រហណម៑ អឝិក្ឞត។</para>
  <para style="p">
    <verse number="9" style="v"/>ឥត្ថំ សិទ្ធីភូយ និជាជ្ញាគ្រាហិណាំ សវ៌្វេឞាម៑ អនន្តបរិត្រាណស្យ ការណស្វរូបោ ៜភវត៑។</para>
  <para style="p">
    <verse number="10" style="v"/>តស្មាត៑ ស មល្កីឞេទកះ ឝ្រេណីភុក្តោ មហាយាជក ឦឝ្វរេណាខ្យាតះ។</para>
  <para style="p">
    <verse number="11" style="v"/>តមធ្យស្មាកំ ពហុកថាះ កថយិតវ្យាះ កិន្តុ តាះ ស្តព្ធកណ៌ៃ រ្យុឞ្មាភិ រ្ទុគ៌ម្យាះ។</para>
  <para style="p">
    <verse number="12" style="v"/>យតោ យូយំ យទ្យបិ សមយស្យ ទីគ៌្ហត្វាត៑ ឝិក្ឞកា ភវិតុម៑ អឝក្ឞ្យត តថាបីឝ្វរស្យ វាក្យានាំ យា ប្រថមា វណ៌មាលា តាមធិ ឝិក្ឞាប្រាប្តិ រ្យុឞ្មាកំ បុនរាវឝ្យកា ភវតិ, តថា កឋិនទ្រវ្យេ នហិ កិន្តុ ទុគ្ធេ យុឞ្មាកំ ប្រយោជនម៑ អាស្តេ។</para>
  <para style="p">
    <verse number="13" style="v"/>យោ ទុគ្ធបាយី ស ឝិឝុរេវេតិការណាត៑ ធម៌្មវាក្យេ តត្បរោ នាស្តិ។</para>
  <para style="p">
    <verse number="14" style="v"/>កិន្តុ សទសទ្វិចារេ យេឞាំ ចេតាំសិ វ្យវហារេណ ឝិក្ឞិតានិ តាទ្ឫឝានាំ សិទ្ធលោកានាំ កឋោរទ្រវ្យេឞុ ប្រយោជនមស្តិ។</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>វយំ ម្ឫតិជនកកម៌្មភ្យោ មនះបរាវត៌្តនម៑ ឦឝ្វរេ វិឝ្វាសោ មជ្ជនឝិក្ឞណំ ហស្តាប៌ណំ ម្ឫតលោកានាម៑ ឧត្ថានម្</para>
  <para style="p">
    <verse number="2" style="v"/>អនន្តកាលស្ថាយិវិចារាជ្ញា ចៃតៃះ បុនព៌្ហិត្តិមូលំ ន ស្ថាបយន្តះ ខ្រីឞ្ដវិឞយកំ ប្រថមោបទេឝំ បឝ្ចាត្ក្ឫត្យ សិទ្ធិំ យាវទ៑ អគ្រសរា ភវាម។</para>
  <para style="p">
    <verse number="3" style="v"/>ឦឝ្វរស្យានុមត្យា ច តទ៑ អស្មាភិះ ការិឞ្យតេ។</para>
  <para style="p">
    <verse number="4" style="v"/>យ ឯកក្ឫត្វោ ទីប្តិមយា ភូត្វា ស្វគ៌ីយវររសម៑ អាស្វទិតវន្តះ បវិត្រស្យាត្មនោៜំឝិនោ ជាតា</para>
  <para style="p">
    <verse number="5" style="v"/>ឦឝ្វរស្យ សុវាក្យំ ភាវិកាលស្យ ឝក្តិញ្ចាស្វទិតវន្តឝ្ច តេ ភ្រឞ្ដ្វា យទិ</para>
  <para style="p">
    <verse number="6" style="v"/>ស្វមនោភិរីឝ្វរស្យ បុត្រំ បុនះ ក្រុឝេ ឃ្នន្តិ លជ្ជាស្បទំ កុវ៌្វតេ ច តហ៌ិ មនះបរាវត៌្តនាយ បុនស្តាន៑ នវីនីកត៌្តុំ កោៜបិ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="7" style="v"/>យតោ យា ភូមិះ ស្វោបរិ ភូយះ បតិតំ វ្ឫឞ្ដិំ បិវតី តត្ផលាធិការិណាំ និមិត្តម៑ ឥឞ្ដានិ ឝាកាទីន្យុត្បាទយតិ សា ឦឝ្វរាទ៑ អាឝិឞំ ប្រាប្តា។</para>
  <para style="p">
    <verse number="8" style="v"/>កិន្តុ យា ភូមិ រ្គោក្ឞុរកណ្ដកវ្ឫក្ឞាន៑ ឧត្បាទយតិ សា ន គ្រាហ្យា ឝាបាហ៌ា ច ឝេឞេ តស្យា ទាហោ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="9" style="v"/>ហេ ប្រិយតមាះ, យទ្យបិ វយម៑ ឯតាទ្ឫឝំ វាក្យំ ភាឞាមហេ តថាបិ យូយំ តត ឧត្ក្ឫឞ្ដាះ បរិត្រាណបថស្យ បថិកាឝ្ចាធ្វ ឥតិ វិឝ្វសាមះ។</para>
  <para style="p">
    <verse number="10" style="v"/>យតោ យុឞ្មាភិះ បវិត្រលោកានាំ យ ឧបការោ ៜការិ ក្រិយតេ ច តេនេឝ្វរស្យ នាម្នេ ប្រកាឝិតំ ប្រេម ឝ្រមញ្ច វិស្មត៌្តុម៑ ឦឝ្វរោៜន្យាយការី ន ភវតិ។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរំ យុឞ្មាកម៑ ឯកៃកោ ជនោ យត៑ ប្រត្យាឝាបូរណាត៌្ហំ ឝេឞំ យាវត៑ តមេវ យត្នំ ប្រកាឝយេទិត្យហម៑ ឥច្ឆាមិ។</para>
  <para style="p">
    <verse number="12" style="v"/>អតះ ឝិថិលា ន ភវត កិន្តុ យេ វិឝ្វាសេន សហិឞ្ណុតយា ច ប្រតិជ្ញានាំ ផលាធិការិណោ ជាតាស្តេឞាម៑ អនុគាមិនោ ភវត។</para>
  <para style="p">
    <verse number="13" style="v"/>ឦឝ្វរោ យទា ឥព្រាហីមេ ប្រត្យជានាត៑ តទា ឝ្រេឞ្ឋស្យ កស្យាប្យបរស្យ នាម្នា ឝបថំ កត៌្តុំ នាឝក្នោត៑, អតោ ហេតោះ ស្វនាម្នា ឝបថំ ក្ឫត្វា តេនោក្តំ យថា,</para>
  <para style="p">
    <verse number="14" style="v"/>"សត្យម៑ អហំ ត្វាម៑ អាឝិឞំ គទិឞ្យាមិ តវាន្វយំ វទ៌្ធយិឞ្យាមិ ច។ "</para>
  <para style="p">
    <verse number="15" style="v"/>អនេន ប្រការេណ ស សហិឞ្ណុតាំ វិធាយ តស្យាះ ប្រត្យាឝាយាះ ផលំ លព្ធវាន៑។</para>
  <para style="p">
    <verse number="16" style="v"/>អថ មានវាះ ឝ្រេឞ្ឋស្យ កស្យចិត៑ នាម្នា ឝបន្តេ, ឝបថឝ្ច ប្រមាណាត៌្ហំ តេឞាំ សវ៌្វវិវាទាន្តកោ ភវតិ។</para>
  <para style="p">
    <verse number="17" style="v"/>ឥត្យស្មិន៑ ឦឝ្វរះ ប្រតិជ្ញាយាះ ផលាធិការិណះ ស្វីយមន្ត្រណាយា អមោឃតាំ ពាហុល្យតោ ទឝ៌យិតុមិច្ឆន៑ ឝបថេន ស្វប្រតិជ្ញាំ ស្ថិរីក្ឫតវាន៑។</para>
  <para style="p">
    <verse number="18" style="v"/>អតឯវ យស្មិន៑ អន្ឫតកថនម៑ ឦឝ្វរស្យ ន សាធ្យំ តាទ្ឫឝេនាចលេន វិឞយទ្វយេន សម្មុខស្ថរក្ឞាស្ថលស្យ ប្រាប្តយេ បលាយិតានាម៑ អស្មាកំ សុទ្ឫឍា សាន្ត្វនា ជាយតេ។</para>
  <para style="p">
    <verse number="19" style="v"/>សា ប្រត្យាឝាស្មាកំ មនោនៅកាយា អចលោ លង្គរោ ភូត្វា វិច្ឆេទកវស្ត្រស្យាភ្យន្តរំ ប្រវិឞ្ដា។</para>
  <para style="p">
    <verse number="20" style="v"/>តត្រៃវាស្មាកម៑ អគ្រសរោ យីឝុះ ប្រវិឝ្យ មល្កីឞេទកះ ឝ្រេណ្យាំ និត្យស្ថាយី យាជកោៜភវត៑។</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ឝាលមស្យ រាជា សវ៌្វោបរិស្ថស្យេឝ្វរស្យ យាជកឝ្ច សន៑ យោ ន្ឫបតីនាំ មារណាត៑ ប្រត្យាគតម៑ ឥព្រាហីមំ សាក្ឞាត្ក្ឫត្យាឝិឞំ គទិតវាន៑,</para>
  <para style="p">
    <verse number="2" style="v"/>យស្មៃ ចេព្រាហីម៑ សវ៌្វទ្រវ្យាណាំ ទឝមាំឝំ ទត្តវាន៑ ស មល្កីឞេទក៑ ស្វនាម្នោៜរ្ថេន ប្រថមតោ ធម៌្មរាជះ បឝ្ចាត៑ ឝាលមស្យ រាជាត៌្ហតះ ឝាន្តិរាជោ ភវតិ។</para>
  <para style="p">
    <verse number="3" style="v"/>អបរំ តស្យ បិតា មាតា វំឝស្យ និណ៌យ អាយុឞ អារម្ភោ ជីវនស្យ ឝេឞឝ្ចៃតេឞាម៑ អភាវោ ភវតិ, ឥត្ថំ ស ឦឝ្វរបុត្រស្យ សទ្ឫឝីក្ឫតះ, ស ត្វនន្តកាលំ យាវទ៑ យាជកស្តិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="4" style="v"/>អតឯវាស្មាកំ បូវ៌្វបុរុឞ ឥព្រាហីម៑ យស្មៃ លុឋិតទ្រវ្យាណាំ ទឝមាំឝំ ទត្តវាន៑ ស កីទ្ឫក៑ មហាន៑ តទ៑ អាលោចយត។</para>
  <para style="p">
    <verse number="5" style="v"/>យាជកត្វប្រាប្តា លេវេះ សន្តានា វ្យវស្ថានុសារេណ លោកេភ្យោៜរ្ថត ឥព្រាហីមោ ជាតេភ្យះ ស្វីយភ្រាត្ឫភ្យោ ទឝមាំឝគ្រហណស្យាទេឝំ លព្ធវន្តះ។</para>
  <para style="p">
    <verse number="6" style="v"/>កិន្ត្វសៅ យទ្យបិ តេឞាំ វំឝាត៑ នោត្បន្នស្តថាបីព្រាហីមោ ទឝមាំឝំ គ្ឫហីតវាន៑ ប្រតិជ្ញានាម៑ អធិការិណម៑ អាឝិឞំ គទិតវាំឝ្ច។</para>
  <para style="p">
    <verse number="7" style="v"/>អបរំ យះ ឝ្រេយាន៑ ស ក្ឞុទ្រតរាយាឝិឞំ ទទាតីត្យត្រ កោៜបិ សន្ទេហោ នាស្តិ។</para>
  <para style="p">
    <verse number="8" style="v"/>អបរម៑ ឥទានីំ យេ ទឝមាំឝំ គ្ឫហ្លន្តិ តេ ម្ឫត្យោរធីនា មានវាះ កិន្តុ តទានីំ យោ គ្ឫហីតវាន៑ ស ជីវតីតិប្រមាណប្រាប្តះ។</para>
  <para style="p">
    <verse number="9" style="v"/>អបរំ ទឝមាំឝគ្រាហី លេវិរបីព្រាហីម្ទ្វារា ទឝមាំឝំ ទត្តវាន៑ ឯតទបិ កថយិតុំ ឝក្យតេ។</para>
  <para style="p">
    <verse number="10" style="v"/>យតោ យទា មល្កីឞេទក៑ តស្យ បិតរំ សាក្ឞាត៑ ក្ឫតវាន៑ តទានីំ ស លេវិះ បិតុរុរស្យាសីត៑។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរំ យស្យ សម្ពន្ធេ លោកា វ្យវស្ថាំ លព្ធវន្តស្តេន លេវីយយាជកវគ៌េណ យទិ សិទ្ធិះ សមភវិឞ្យត៑ តហ៌ិ ហារោណស្យ ឝ្រេណ្យា មធ្យាទ៑ យាជកំ ន និរូប្យេឝ្វរេណ មល្កីឞេទកះ ឝ្រេណ្យា មធ្យាទ៑ អបរស្យៃកស្យ យាជកស្យោត្ថាបនំ កុត អាវឝ្យកម៑ អភវិឞ្យត៑?</para>
  <para style="p">
    <verse number="12" style="v"/>យតោ យាជកវគ៌ស្យ វិនិមយេន សុតរាំ វ្យវស្ថាយា អបិ វិនិមយោ ជាយតេ។</para>
  <para style="p">
    <verse number="13" style="v"/>អបរញ្ច តទ៑ វាក្យំ យស្យោទ្ទេឝ្យំ សោៜបរេណ វំឝេន សំយុក្តាៜស្តិ តស្យ វំឝស្យ ច កោៜបិ កទាបិ វេទ្យាះ កម៌្ម ន ក្ឫតវាន៑។</para>
  <para style="p">
    <verse number="14" style="v"/>វស្តុតស្តុ យំ វំឝមធិ មូសា យាជកត្វស្យៃកាំ កថាមបិ ន កថិតវាន៑ តស្មិន៑ យិហូទាវំឝេៜស្មាកំ ប្រភុ រ្ជន្ម គ្ឫហីតវាន៑ ឥតិ សុស្បឞ្ដំ។</para>
  <para style="p">
    <verse number="15" style="v"/>តស្យ ស្បឞ្ដតរម៑ អបរំ ប្រមាណមិទំ យត៑ មល្កីឞេទកះ សាទ្ឫឝ្យវតាបរេណ តាទ្ឫឝេន យាជកេនោទេតវ្យំ,</para>
  <para style="p">
    <verse number="16" style="v"/>យស្យ និរូបណំ ឝរីរសម្ពន្ធីយវិធិយុក្តយា វ្យវស្ថាយា ន ភវតិ កិន្ត្វក្ឞយជីវនយុក្តយា ឝក្ត្យា ភវតិ។</para>
  <para style="p">
    <verse number="17" style="v"/>យត ឦឝ្វរ ឥទំ សាក្ឞ្យំ ទត្តវាន៑, យថា, "ត្វំ មក្លីឞេទកះ ឝ្រេណ្យាំ យាជកោៜសិ សទាតនះ។ "</para>
  <para style="p">
    <verse number="18" style="v"/>អនេនាគ្រវត៌្តិនោ វិធេ ទុព៌្ពលតាយា និឞ្ផលតាយាឝ្ច ហេតោរត៌្ហតោ វ្យវស្ថយា កិមបិ សិទ្ធំ ន ជាតមិតិហេតោស្តស្យ លោបោ ភវតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>យយា ច វយម៑ ឦឝ្វរស្យ និកដវត៌្តិនោ ភវាម ឯតាទ្ឫឝី ឝ្រេឞ្ឋប្រត្យាឝា សំស្ថាប្យតេ។</para>
  <para style="p">
    <verse number="20" style="v"/>អបរំ យីឝុះ ឝបថំ វិនា ន និយុក្តស្តស្មាទបិ ស ឝ្រេឞ្ឋនិយមស្យ មធ្យស្ថោ ជាតះ។</para>
  <para style="p">
    <verse number="21" style="v"/>យតស្តេ ឝបថំ វិនា យាជកា ជាតាះ កិន្ត្វសៅ ឝបថេន ជាតះ យតះ ស ឥទមុក្តះ, យថា,</para>
  <para style="p">
    <verse number="22" style="v"/>"បរមេឝ ឥទំ ឝេបេ ន ច តស្មាន្និវត៌្ស្យតេ។ ត្វំ មល្កីឞេទកះ ឝ្រេណ្យាំ យាជកោៜសិ សទាតនះ។ "</para>
  <para style="p">
    <verse number="23" style="v"/>តេ ច ពហវោ យាជកា អភវន៑ យតស្តេ ម្ឫត្យុនា និត្យស្ថាយិត្វាត៑ និវារិតាះ,</para>
  <para style="p">
    <verse number="24" style="v"/>កិន្ត្វសាវនន្តកាលំ យាវត៑ តិឞ្ឋតិ តស្មាត៑ តស្យ យាជកត្វំ ន បរិវត៌្តនីយំ។</para>
  <para style="p">
    <verse number="25" style="v"/>តតោ ហេតោ រ្យេ មានវាស្តេនេឝ្វរស្យ សន្និធិំ គច្ឆន្តិ តាន៑ ស ឝេឞំ យាវត៑ បរិត្រាតុំ ឝក្នោតិ យតស្តេឞាំ ក្ឫតេ ប្រាត៌្ហនាំ កត៌្តុំ ស សតតំ ជីវតិ។</para>
  <para style="p">
    <verse number="26" style="v"/>អបរម៑ អស្មាកំ តាទ្ឫឝមហាយាជកស្យ ប្រយោជនមាសីទ៑ យះ បវិត្រោ ៜហិំសកោ និឞ្កលង្កះ បាបិភ្យោ ភិន្នះ ស្វគ៌ាទប្យុច្ចីក្ឫតឝ្ច ស្យាត៑។</para>
  <para style="p">
    <verse number="27" style="v"/>អបរំ មហាយាជកានាំ យថា តថា តស្យ ប្រតិទិនំ ប្រថមំ ស្វបាបានាំ ក្ឫតេ តតះ បរំ លោកានាំ បាបានាំ ក្ឫតេ ពលិទានស្យ ប្រយោជនំ នាស្តិ យត អាត្មពលិទានំ ក្ឫត្វា តទ៑ ឯកក្ឫត្វស្តេន សម្បាទិតំ។</para>
  <para style="p">
    <verse number="28" style="v"/>យតោ វ្យវស្ថយា យេ មហាយាជកា និរូប្យន្តេ តេ ទៅព៌្ពល្យយុក្តា មានវាះ កិន្តុ វ្យវស្ថាតះ បរំ ឝបថយុក្តេន វាក្យេន យោ មហាយាជកោ និរូបិតះ សោ ៜនន្តកាលាត៌្ហំ សិទ្ធះ បុត្រ ឯវ។</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>កថ្យមានានាំ វាក្យានាំ សារោៜយម៑ អស្មាកម៑ ឯតាទ្ឫឝ ឯកោ មហាយាជកោៜស្តិ យះ ស្វគ៌េ មហាមហិម្នះ សិំហាសនស្យ ទក្ឞិណបាឝ៌្វោ សមុបវិឞ្ដវាន្</para>
  <para style="p">
    <verse number="2" style="v"/>យច្ច ទូឞ្យំ ន មនុជៃះ កិន្ត្វីឝ្វរេណ ស្ថាបិតំ តស្យ សត្យទូឞ្យស្យ បវិត្រវស្តូនាញ្ច សេវកះ ស ភវតិ។</para>
  <para style="p">
    <verse number="3" style="v"/>យត ឯកៃកោ មហាយាជកោ នៃវេទ្យានាំ ពលីនាញ្ច ទានេ និយុជ្យតេ, អតោ ហេតោរេតស្យាបិ កិញ្ចិទ៑ ឧត្សជ៌នីយំ វិទ្យត ឥត្យាវឝ្យកំ។</para>
  <para style="p">
    <verse number="4" style="v"/>កិញ្ច ស យទិ ប្ឫថិវ្យាម៑ អស្ថាស្យត៑ តហ៌ិ យាជកោ នាភវិឞ្យត៑, យតោ យេ វ្យវស្ថានុសារាត៑ នៃវេទ្យានិ ទទត្យេតាទ្ឫឝា យាជកា វិទ្យន្តេ។</para>
  <para style="p">
    <verse number="5" style="v"/>តេ តុ ស្វគ៌ីយវស្តូនាំ ទ្ឫឞ្ដាន្តេន ឆាយយា ច សេវាមនុតិឞ្ឋន្តិ យតោ មូសសិ ទូឞ្យំ សាធយិតុម៑ ឧទ្យតេ សតីឝ្វរស្តទេវ តមាទិឞ្ដវាន៑ ផលតះ ស តមុក្តវាន៑, យថា, "អវធេហិ គិរៅ ត្វាំ យទ្យន្និទឝ៌នំ ទឝ៌ិតំ តទ្វត៑ សវ៌្វាណិ ត្វយា ក្រិយន្តាំ។ "</para>
  <para style="p">
    <verse number="6" style="v"/>កិន្ត្វិទានីម៑ អសៅ តស្មាត៑ ឝ្រេឞ្ឋំ សេវកបទំ ប្រាប្តវាន៑ យតះ ស ឝ្រេឞ្ឋប្រតិជ្ញាភិះ ស្ថាបិតស្យ ឝ្រេឞ្ឋនិយមស្យ មធ្យស្ថោៜភវត៑។</para>
  <para style="p">
    <verse number="7" style="v"/>ស ប្រថមោ និយមោ យទិ និទ៌្ទោឞោៜភវិឞ្យត តហ៌ិ ទ្វិតីយស្យ និយមស្យ កិមបិ ប្រយោជនំ នាភវិឞ្យត៑។</para>
  <para style="p">
    <verse number="8" style="v"/>កិន្តុ ស ទោឞមារោបយន៑ តេភ្យះ កថយតិ, យថា, "បរមេឝ្វរ ឥទំ ភាឞតេ បឝ្យ យស្មិន៑ សមយេៜហម៑ ឥស្រាយេលវំឝេន យិហូទាវំឝេន ច សាទ៌្ធម៑ ឯកំ នវីនំ និយមំ ស្ថិរីករិឞ្យាម្យេតាទ្ឫឝះ សមយ អាយាតិ។</para>
  <para style="p">
    <verse number="9" style="v"/>បរមេឝ្វរោៜបរមបិ កថយតិ តេឞាំ បូវ៌្វបុរុឞាណាំ មិសរទេឝាទ៑ អានយនាត៌្ហំ យស្មិន៑ ទិនេៜហំ តេឞាំ ករំ ធ្ឫត្វា តៃះ សហ និយមំ ស្ថិរីក្ឫតវាន៑ តទ្ទិនស្យ និយមានុសារេណ នហិ យតស្តៃ រ្មម និយមេ លង្ឃិតេៜហំ តាន៑ ប្រតិ ចិន្តាំ នាករវំ។</para>
  <para style="p">
    <verse number="10" style="v"/>កិន្តុ បរមេឝ្វរះ កថយតិ តទ្ទិនាត៑ បរមហំ ឥស្រាយេលវំឝីយៃះ សាទ៌្ធម៑ ឥមំ និយមំ ស្ថិរីករិឞ្យាមិ, តេឞាំ ចិត្តេ មម វិធីន៑ ស្ថាបយិឞ្យាមិ តេឞាំ ហ្ឫត្បត្រេ ច តាន៑ លេខិឞ្យាមិ, អបរមហំ តេឞាម៑ ឦឝ្វរោ ភវិឞ្យាមិ តេ ច មម លោកា ភវិឞ្យន្តិ។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរំ ត្វំ បរមេឝ្វរំ ជានីហីតិវាក្យេន តេឞាមេកៃកោ ជនះ ស្វំ ស្វំ សមីបវាសិនំ ភ្រាតរញ្ច បុន រ្ន ឝិក្ឞយិឞ្យតិ យត អាក្ឞុទ្រាត៑ មហាន្តំ យាវត៑ សវ៌្វេ មាំ ជ្ញាស្យន្តិ។</para>
  <para style="p">
    <verse number="12" style="v"/>យតោ ហេតោរហំ តេឞាម៑ អធម៌្មាន៑ ក្ឞមិឞ្យេ តេឞាំ បាបាន្យបរាធាំឝ្ច បុនះ កទាបិ ន ស្មរិឞ្យាមិ។ "</para>
  <para style="p">
    <verse number="13" style="v"/>អនេន តំ និយមំ នូតនំ គទិត្វា ស ប្រថមំ និយមំ បុរាតនីក្ឫតវាន៑; យច្ច បុរាតនំ ជីណ៌ាញ្ច ជាតំ តស្យ លោបោ និកដោ ៜភវត៑។</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ស ប្រថមោ និយម អារាធនាយា វិវិធរីតិភិរៃហិកបវិត្រស្ថានេន ច វិឝិឞ្ដ អាសីត៑។</para>
  <para style="p">
    <verse number="2" style="v"/>យតោ ទូឞ្យមេកំ និរមីយត តស្យ ប្រថមកោឞ្ឋស្យ នាម បវិត្រស្ថានមិត្យាសីត៑ តត្រ ទីបវ្ឫក្ឞោ ភោជនាសនំ ទឝ៌នីយបូបានាំ ឝ្រេណី ចាសីត៑។</para>
  <para style="p">
    <verse number="3" style="v"/>តត្បឝ្ចាទ៑ ទ្វិតីយាយាស្តិរឞ្ករិណ្យា អភ្យន្តរេ ៜតិបវិត្រស្ថានមិតិនាមកំ កោឞ្ឋមាសីត៑,</para>
  <para style="p">
    <verse number="4" style="v"/>តត្រ ច សុវណ៌មយោ ធូបាធារះ បរិតះ សុវណ៌មណ្ឌិតា និយមមញ្ជូឞា ចាសីត៑ តន្មធ្យេ មាន្នាយាះ សុវណ៌ឃដោ ហារោណស្យ មញ្ជរិតទណ្ឌស្តក្ឞិតៅ និយមប្រស្តរៅ,</para>
  <para style="p">
    <verse number="5" style="v"/>តទុបរិ ច ករុណាសនេ ឆាយាការិណៅ តេជោមយៅ កិរូពាវាស្តាម៑, ឯតេឞាំ វិឝេឞវ្ឫត្តាន្តកថនាយ នាយំ សមយះ។</para>
  <para style="p">
    <verse number="6" style="v"/>ឯតេឞ្វីទ្ឫក៑ និម៌្មិតេឞុ យាជកា ឦឝ្វរសេវាម៑ អនុតិឞ្ឋនតោ ទូឞ្យស្យ ប្រថមកោឞ្ឋំ និត្យំ ប្រវិឝន្តិ។</para>
  <para style="p">
    <verse number="7" style="v"/>កិន្តុ ទ្វិតីយំ កោឞ្ឋំ ប្រតិវឞ៌ម៑ ឯកក្ឫត្វ ឯកាកិនា មហាយាជកេន ប្រវិឝ្យតេ កិន្ត្វាត្មនិមិត្តំ លោកានាម៑ អជ្ញានក្ឫតបាបានាញ្ច និមិត្តម៑ ឧត្សជ៌្ជនីយំ រុធិរម៑ អនាទាយ តេន ន ប្រវិឝ្យតេ។</para>
  <para style="p">
    <verse number="8" style="v"/>ឥត្យនេន បវិត្រ អាត្មា យត៑ ជ្ញាបយតិ តទិទំ តត៑ ប្រថមំ ទូឞ្យំ យាវត៑ តិឞ្ឋតិ តាវត៑ មហាបវិត្រស្ថានគាមី បន្ថា អប្រកាឝិតស្តិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="9" style="v"/>តច្ច ទូឞ្យំ វត៌្តមានសមយស្យ ទ្ឫឞ្ដាន្តះ, យតោ ហេតោះ សាម្ប្រតំ សំឝោធនកាលំ យាវទ៑ យន្និរូបិតំ តទនុសារាត៑ សេវាការិណោ មានសិកសិទ្ធិករណេៜសមត៌្ហាភិះ</para>
  <para style="p">
    <verse number="10" style="v"/>កេវលំ ខាទ្យបេយេឞុ វិវិធមជ្ជនេឞុ ច ឝារីរិករីតិភិ រ្យុក្តានិ នៃវេទ្យានិ ពលិទានានិ ច ភវន្តិ។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរំ ភាវិមង្គលានាំ មហាយាជកះ ខ្រីឞ្ដ ឧបស្ថាយាហស្តនិម៌្មិតេនាត៌្ហត ឯតត្ស្ឫឞ្ដេ រ្ពហិព៌្ហូតេន ឝ្រេឞ្ឋេន សិទ្ធេន ច ទូឞ្យេណ គត្វា</para>
  <para style="p">
    <verse number="12" style="v"/>ឆាគានាំ គោវត្សានាំ វា រុធិរម៑ អនាទាយ ស្វីយរុធិរម៑ អាទាយៃកក្ឫត្វ ឯវ មហាបវិត្រស្ថានំ ប្រវិឝ្យានន្តកាលិកាំ មុក្តិំ ប្រាប្តវាន៑។</para>
  <para style="p">
    <verse number="13" style="v"/>វ្ឫឞឆាគានាំ រុធិរេណ គវីភស្មនះ ប្រក្ឞេបេណ ច យទ្យឝុចិលោកាះ ឝារីរិឝុចិត្វាយ បូយន្តេ,</para>
  <para style="p">
    <verse number="14" style="v"/>តហ៌ិ កិំ មន្យធ្វេ យះ សទាតនេនាត្មនា និឞ្កលង្កពលិមិវ ស្វមេវេឝ្វរាយ ទត្តវាន៑, តស្យ ខ្រីឞ្ដស្យ រុធិរេណ យុឞ្មាកំ មនាំស្យមរេឝ្វរស្យ សេវាយៃ កិំ ម្ឫត្យុជនកេភ្យះ កម៌្មភ្យោ ន បវិត្រីការិឞ្យន្តេ?</para>
  <para style="p">
    <verse number="15" style="v"/>ស នូតននិយមស្យ មធ្យស្ថោៜភវត៑ តស្យាភិប្រាយោៜយំ យត៑ ប្រថមនិយមលង្ឃនរូបបាបេភ្យោ ម្ឫត្យុនា មុក្តៅ ជាតាយាម៑ អាហូតលោកា អនន្តកាលីយសម្បទះ ប្រតិជ្ញាផលំ លភេរន៑។</para>
  <para style="p">
    <verse number="16" style="v"/>យត្រ និយមោ ភវតិ តត្រ និយមសាធកស្យ ពលេ រ្ម្ឫត្យុនា ភវិតវ្យំ។</para>
  <para style="p">
    <verse number="17" style="v"/>យតោ ហតេន ពលិនា និយមះ ស្ថិរីភវតិ កិន្តុ និយមសាធកោ ពលិ រ្យាវត៑ ជីវតិ តាវត៑ និយមោ និរត៌្ហកស្តិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="18" style="v"/>តស្មាត៑ ស បូវ៌្វនិយមោៜបិ រុធិរបាតំ វិនា ន សាធិតះ។</para>
  <para style="p">
    <verse number="19" style="v"/>ផលតះ សវ៌្វលោកាន៑ ប្រតិ វ្យវស្ថានុសារេណ សវ៌្វា អាជ្ញាះ កថយិត្វា មូសា ជលេន សិន្ទូរវណ៌លោម្នា ឯឞោវត្ឫណេន ច សាទ៌្ធំ គោវត្សានាំ ឆាគានាញ្ច រុធិរំ គ្ឫហីត្វា គ្រន្ថេ សវ៌្វលោកេឞុ ច ប្រក្ឞិប្យ ពភាឞេ,</para>
  <para style="p">
    <verse number="20" style="v"/>យុឞ្មាន៑ អធីឝ្វរោ យំ និយមំ និរូបិតវាន៑ តស្យ រុធិរមេតត៑។</para>
  <para style="p">
    <verse number="21" style="v"/>តទ្វត៑ ស ទូឞ្យេៜបិ សេវាត៌្ហកេឞុ សវ៌្វបាត្រេឞុ ច រុធិរំ ប្រក្ឞិប្តវាន៑។</para>
  <para style="p">
    <verse number="22" style="v"/>អបរំ វ្យវស្ថានុសារេណ ប្រាយឝះ សវ៌្វាណិ រុធិរេណ បរិឞ្ក្រិយន្តេ រុធិរបាតំ វិនា បាបមោចនំ ន ភវតិ ច។</para>
  <para style="p">
    <verse number="23" style="v"/>អបរំ យានិ ស្វគ៌ីយវស្តូនាំ ទ្ឫឞ្ដាន្តាស្តេឞាម៑ ឯតៃះ បាវនម៑ អាវឝ្យកម៑ អាសីត៑ កិន្តុ សាក្ឞាត៑ ស្វគ៌ីយវស្តូនាម៑ ឯតេភ្យះ ឝ្រេឞ្ឋេै រ្ពលិទានៃះ បាវនមាវឝ្យកំ។</para>
  <para style="p">
    <verse number="24" style="v"/>យតះ ខ្រីឞ្ដះ សត្យបវិត្រស្ថានស្យ ទ្ឫឞ្ដាន្តរូបំ ហស្តក្ឫតំ បវិត្រស្ថានំ ន ប្រវិឞ្ដវាន៑ កិន្ត្វស្មន្និមិត្តម៑ ឥទានីម៑ ឦឝ្វរស្យ សាក្ឞាទ៑ ឧបស្ថាតុំ ស្វគ៌មេវ ប្រវិឞ្ដះ។</para>
  <para style="p">
    <verse number="25" style="v"/>យថា ច មហាយាជកះ ប្រតិវឞ៌ំ បរឝោណិតមាទាយ មហាបវិត្រស្ថានំ ប្រវិឝតិ តថា ខ្រីឞ្ដេន បុនះ បុនរាត្មោត្សគ៌ោ ន កត៌្តវ្យះ,</para>
  <para style="p">
    <verse number="26" style="v"/>កត៌្តវ្យេ សតិ ជគតះ ស្ឫឞ្ដិកាលមារភ្យ ពហុវារំ តស្យ ម្ឫត្យុភោគ អាវឝ្យកោៜភវត៑; កិន្ត្វិទានីំ ស អាត្មោត្សគ៌េណ បាបនាឝាត៌្ហម៑ ឯកក្ឫត្វោ ជគតះ ឝេឞកាលេ ប្រចកាឝេ។</para>
  <para style="p">
    <verse number="27" style="v"/>អបរំ យថា មានុឞស្យៃកក្ឫត្វោ មរណំ តត៑ បឝ្ចាទ៑ វិចារោ និរូបិតោៜស្តិ,</para>
  <para style="p">
    <verse number="28" style="v"/>តទ្វត៑ ខ្រីឞ្ដោៜបិ ពហូនាំ បាបវហនាត៌្ហំ ពលិរូបេណៃកក្ឫត្វ ឧត្សស្ឫជេ, អបរំ ទ្វិតីយវារំ បាបាទ៑ ភិន្នះ សន៑ យេ តំ ប្រតីក្ឞន្តេ តេឞាំ បរិត្រាណាត៌្ហំ ទឝ៌នំ ទាស្យតិ។</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>វ្យវស្ថា ភវិឞ្យន្មង្គលានាំ ឆាយាស្វរូបា ន ច វស្តូនាំ មូត៌្តិស្វរូបា តតោ ហេតោ រ្និត្យំ ទីយមានៃរេកវិធៃ រ្វាឞ៌ិកពលិភិះ ឝរណាគតលោកាន៑ សិទ្ធាន៑ កត៌្តុំ កទាបិ ន ឝក្នោតិ។</para>
  <para style="p">
    <verse number="2" style="v"/>យទ្យឝក្ឞ្យត៑ តហ៌ិ តេឞាំ ពលីនាំ ទានំ កិំ ន ន្យវត៌្តិឞ្យត? យតះ សេវាការិឞ្វេកក្ឫត្វះ បវិត្រីភូតេឞុ តេឞាំ កោៜបិ បាបពោធះ បុន រ្នាភវិឞ្យត៑។</para>
  <para style="p">
    <verse number="3" style="v"/>កិន្តុ តៃ រ្ពលិទានៃះ ប្រតិវត្សរំ បាបានាំ ស្មារណំ ជាយតេ។</para>
  <para style="p">
    <verse number="4" style="v"/>យតោ វ្ឫឞាណាំ ឆាគានាំ វា រុធិរេណ បាបមោចនំ ន សម្ភវតិ។</para>
  <para style="p">
    <verse number="5" style="v"/>ឯតត្ការណាត៑ ខ្រីឞ្ដេន ជគត៑ ប្រវិឝ្យេទម៑ ឧច្យតេ, យថា, "នេឞ្ដ្វា ពលិំ ន នៃវេទ្យំ ទេហោ មេ និម៌្មិតស្ត្វយា។</para>
  <para style="p">
    <verse number="6" style="v"/>ន ច ត្វំ ពលិភិ រ្ហវ្យៃះ បាបឃ្នៃ រ្វា ប្រតុឞ្យសិ។</para>
  <para style="p">
    <verse number="7" style="v"/>អវាទិឞំ តទៃវាហំ បឝ្យ កុវ៌្វេ សមាគមំ។ ធម៌្មគ្រន្ថស្យ សគ៌េ មេ វិទ្យតេ លិខិតា កថា។ ឦឝ មនោៜភិលាឞស្តេ មយា សម្បូរយិឞ្យតេ។ "</para>
  <para style="p">
    <verse number="8" style="v"/>ឥត្យស្មិន៑ ប្រថមតោ យេឞាំ ទានំ វ្យវស្ថានុសារាទ៑ ភវតិ តាន្យធិ តេនេទមុក្តំ យថា, ពលិនៃវេទ្យហវ្យានិ បាបឃ្នញ្ចោបចារកំ, នេមានិ វាញ្ឆសិ ត្វំ ហិ ន ចៃតេឞុ ប្រតុឞ្យសីតិ។</para>
  <para style="p">
    <verse number="9" style="v"/>តតះ បរំ តេនោក្តំ យថា, "បឝ្យ មនោៜភិលាឞំ តេ កត៌្តុំ កុវ៌្វេ សមាគមំ;" ទ្វិតីយម៑ ឯតទ៑ វាក្យំ ស្ថិរីកត៌្តុំ ស ប្រថមំ លុម្បតិ។</para>
  <para style="p">
    <verse number="10" style="v"/>តេន មនោៜភិលាឞេណ ច វយំ យីឝុខ្រីឞ្ដស្យៃកក្ឫត្វះ ស្វឝរីរោត្សគ៌ាត៑ បវិត្រីក្ឫតា អភវាម។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរម៑ ឯកៃកោ យាជកះ ប្រតិទិនម៑ ឧបាសនាំ កុវ៌្វន៑ យៃឝ្ច បាបានិ នាឝយិតុំ កទាបិ ន ឝក្យន្តេ តាទ្ឫឝាន៑ ឯករូបាន៑ ពលីន៑ បុនះ បុនរុត្ស្ឫជន៑ តិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="12" style="v"/>កិន្ត្វសៅ បាបនាឝកម៑ ឯកំ ពលិំ ទត្វានន្តកាលាត៌្ហម៑ ឦឝ្វរស្យ ទក្ឞិណ ឧបវិឝ្យ</para>
  <para style="p">
    <verse number="13" style="v"/>យាវត៑ តស្យ ឝត្រវស្តស្យ បាទបីឋំ ន ភវន្តិ តាវត៑ ប្រតីក្ឞមាណស្តិឞ្ឋតិ។</para>
  <para style="p">
    <verse number="14" style="v"/>យត ឯកេន ពលិទានេន សោៜនន្តកាលាត៌្ហំ បូយមានាន៑ លោកាន៑ សាធិតវាន៑។</para>
  <para style="p">
    <verse number="15" style="v"/>ឯតស្មិន៑ បវិត្រ អាត្មាប្យស្មាកំ បក្ឞេ ប្រមាណយតិ</para>
  <para style="p">
    <verse number="16" style="v"/>"យតោ ហេតោស្តទ្ទិនាត៑ បរម៑ អហំ តៃះ សាទ៌្ធម៑ ឥមំ និយមំ ស្ថិរីករិឞ្យាមីតិ ប្រថមត ឧក្ត្វា បរមេឝ្វរេណេទំ កថិតំ, តេឞាំ ចិត្តេ មម វិធីន៑ ស្ថាបយិឞ្យាមិ តេឞាំ មនះសុ ច តាន៑ លេខិឞ្យាមិ ច,</para>
  <para style="p">
    <verse number="17" style="v"/>អបរញ្ច តេឞាំ បាបាន្យបរាធាំឝ្ច បុនះ កទាបិ ន ស្មារិឞ្យាមិ។ "</para>
  <para style="p">
    <verse number="18" style="v"/>កិន្តុ យត្រ បាបមោចនំ ភវតិ តត្រ បាបាត៌្ហកពលិទានំ បុន រ្ន ភវតិ។</para>
  <para style="p">
    <verse number="19" style="v"/>អតោ ហេ ភ្រាតរះ, យីឝោ រុធិរេណ បវិត្រស្ថានប្រវេឝាយាស្មាកម៑ ឧត្សាហោ ភវតិ,</para>
  <para style="p">
    <verse number="20" style="v"/>យតះ សោៜស្មទត៌្ហំ តិរស្ករិណ្យាត៌្ហតះ ស្វឝរីរេណ នវីនំ ជីវនយុក្តញ្ចៃកំ បន្ថានំ និម៌្មិតវាន៑,</para>
  <para style="p">
    <verse number="21" style="v"/>អបរញ្ចេឝ្វរីយបរិវារស្យាធ្យក្ឞ ឯកោ មហាយាជកោៜស្មាកមស្តិ។</para>
  <para style="p">
    <verse number="22" style="v"/>អតោ ហេតោរស្មាភិះ សរលាន្តះករណៃ រ្ទ្ឫឍវិឝ្វាសៃះ បាបពោធាត៑ ប្រក្ឞាលិតមនោភិ រ្និម៌្មលជលេ ស្នាតឝរីរៃឝ្ចេឝ្វរម៑ ឧបាគត្យ ប្រត្យាឝាយាះ ប្រតិជ្ញា និឝ្ចលា ធារយិតវ្យា។</para>
  <para style="p">
    <verse number="23" style="v"/>យតោ យស្តាម៑ អង្គីក្ឫតវាន៑ ស វិឝ្វសនីយះ។</para>
  <para style="p">
    <verse number="24" style="v"/>អបរំ ប្រេម្និ សត្ក្រិយាសុ ចៃកៃកស្យោត្សាហវ្ឫទ្ធ្យត៌្ហម៑ អស្មាភិះ បរស្បរំ មន្ត្រយិតវ្យំ។</para>
  <para style="p">
    <verse number="25" style="v"/>អបរំ កតិបយលោកា យថា កុវ៌្វន្តិ តថាស្មាភិះ សភាករណំ ន បរិត្យក្តវ្យំ បរស្បរម៑ ឧបទេឞ្ដវ្យញ្ច យតស្តត៑ មហាទិនម៑ ឧត្តរោត្តរំ និកដវត៌្តិ ភវតីតិ យុឞ្មាភិ រ្ទ្ឫឝ្យតេ។</para>
  <para style="p">
    <verse number="26" style="v"/>សត្យមតស្យ ជ្ញានប្រាប្តេះ បរំ យទិ វយំ ស្វំច្ឆយា បាបាចារំ កុម៌្មស្តហ៌ិ បាបានាំ ក្ឫតេ ៜន្យត៑ កិមបិ ពលិទានំ នាវឝិឞ្យតេ</para>
  <para style="p">
    <verse number="27" style="v"/>កិន្តុ វិចារស្យ ភយានកា ប្រតីក្ឞា រិបុនាឝកានលស្យ តាបឝ្ចាវឝិឞ្យតេ។</para>
  <para style="p">
    <verse number="28" style="v"/>យះ កឝ្ចិត៑ មូសសោ វ្យវស្ថាម៑ អវមន្យតេ ស ទយាំ វិនា ទ្វយោស្តិស្ឫណាំ វា សាក្ឞិណាំ ប្រមាណេន ហន្យតេ,</para>
  <para style="p">
    <verse number="29" style="v"/>តស្មាត៑ កិំ ពុធ្យធ្វេ យោ ជន ឦឝ្វរស្យ បុត្រម៑ អវជានាតិ យេន ច បវិត្រីក្ឫតោ ៜភវត៑ តត៑ និយមស្យ រុធិរម៑ អបវិត្រំ ជានាតិ, អនុគ្រហករម៑ អាត្មានម៑ អបមន្យតេ ច, ស កិយន្មហាឃោរតរទណ្ឌស្យ យោគ្យោ ភវិឞ្យតិ?</para>
  <para style="p">
    <verse number="30" style="v"/>យតះ បរមេឝ្វរះ កថយតិ, "ទានំ ផលស្យ មត្កម៌្ម សូចិតំ ប្រទទាម្យហំ។ " បុនរបិ, "តទា វិចារយិឞ្យន្តេ បរេឝេន និជាះ ប្រជាះ។ " ឥទំ យះ កថិតវាន៑ តំ វយំ ជានីមះ។</para>
  <para style="p">
    <verse number="31" style="v"/>អមរេឝ្វរស្យ ករយោះ បតនំ មហាភយានកំ។</para>
  <para style="p">
    <verse number="32" style="v"/>ហេ ភ្រាតរះ, បូវ៌្វទិនានិ ស្មរត យតស្តទានីំ យូយំ ទីប្តិំ ប្រាប្យ ពហុទុគ៌តិរូបំ សំគ្រាមំ សហមានា ឯកតោ និន្ទាក្លេឝៃះ កៅតុកីក្ឫតា អភវត,</para>
  <para style="p">
    <verse number="33" style="v"/>អន្យតឝ្ច តទ្ភោគិនាំ សមាំឝិនោ ៜភវត។</para>
  <para style="p">
    <verse number="34" style="v"/>យូយំ មម ពន្ធនស្យ ទុះខេន ទុះខិនោ ៜភវត, យុឞ្មាកម៑ ឧត្តមា និត្យា ច សម្បត្តិះ ស្វគ៌េ វិទ្យត ឥតិ ជ្ញាត្វា សានន្ទំ សវ៌្វស្វស្យាបហរណម៑ អសហធ្វញ្ច។</para>
  <para style="p">
    <verse number="35" style="v"/>អតឯវ មហាបុរស្ការយុក្តំ យុឞ្មាកម៑ ឧត្សាហំ ន បរិត្យជត។</para>
  <para style="p">
    <verse number="36" style="v"/>យតោ យូយំ យេនេឝ្វរស្យេច្ឆាំ បាលយិត្វា ប្រតិជ្ញាយាះ ផលំ លភធ្វំ តទត៌្ហំ យុឞ្មាភិ រ្ធៃយ៌្យាវលម្ពនំ កត៌្តវ្យំ។</para>
  <para style="p">
    <verse number="37" style="v"/>យេនាគន្តវ្យំ ស ស្វល្បកាលាត៑ បរម៑ អាគមិឞ្យតិ ន ច វិលម្ពិឞ្យតេ។</para>
  <para style="p">
    <verse number="38" style="v"/>"បុណ្យវាន៑ ជនោ វិឝ្វាសេន ជីវិឞ្យតិ កិន្តុ យទិ និវត៌្តតេ តហ៌ិ មម មនស្តស្មិន៑ ន តោឞំ យាស្យតិ។ "</para>
  <para style="p">
    <verse number="39" style="v"/>កិន្តុ វយំ វិនាឝជនិកាំ ធម៌្មាត៑ និវ្ឫត្តិំ ន កុវ៌្វាណា អាត្មនះ បរិត្រាណាយ វិឝ្វាសំ កុវ៌្វាមហេे។</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>វិឝ្វាស អាឝំសិតានាំ និឝ្ចយះ, អទ្ឫឝ្យានាំ វិឞយាណាំ ទឝ៌នំ ភវតិ។</para>
  <para style="p">
    <verse number="2" style="v"/>តេន វិឝ្វាសេន ប្រាញ្ចោ លោកាះ ប្រាមាណ្យំ ប្រាប្តវន្តះ។</para>
  <para style="p">
    <verse number="3" style="v"/>អបរម៑ ឦឝ្វរស្យ វាក្យេន ជគន្ត្យស្ឫជ្យន្ត, ទ្ឫឞ្ដវស្តូនិ ច ប្រត្យក្ឞវស្តុភ្យោ នោទបទ្យន្តៃតទ៑ វយំ វិឝ្វាសេន ពុធ្យាមហេ។</para>
  <para style="p">
    <verse number="4" style="v"/>វិឝ្វាសេន ហាពិល៑ ឦឝ្វរមុទ្ទិឝ្យ កាពិលះ ឝ្រេឞ្ឋំ ពលិទានំ ក្ឫតវាន៑ តស្មាច្ចេឝ្វរេណ តស្យ ទានាន្យធិ ប្រមាណេ ទត្តេ ស ធាម៌្មិក ឥត្យស្យ ប្រមាណំ លព្ធវាន៑ តេន វិឝ្វាសេន ច ស ម្ឫតះ សន៑ អទ្យាបិ ភាឞតេ។</para>
  <para style="p">
    <verse number="5" style="v"/>វិឝ្វាសេន ហនោក៑ យថា ម្ឫត្យុំ ន បឝ្យេត៑ តថា លោកាន្តរំ នីតះ, តស្យោទ្ទេឝឝ្ច កេនាបិ ន ប្រាបិ យត ឦឝ្វរស្តំ លោកាន្តរំ នីតវាន៑, តត្ប្រមាណមិទំ តស្យ លោកាន្តរីករណាត៑ បូវ៌្វំ ស ឦឝ្វរាយ រោចិតវាន៑ ឥតិ ប្រមាណំ ប្រាប្តវាន៑។</para>
  <para style="p">
    <verse number="6" style="v"/>កិន្តុ វិឝ្វាសំ វិនា កោៜបីឝ្វរាយ រោចិតុំ ន ឝក្នោតិ យត ឦឝ្វរោៜស្តិ ស្វាន្វេឞិលោកេភ្យះ បុរស្ការំ ទទាតិ ចេតិកថាយាម៑ ឦឝ្វរឝរណាគតៃ រ្វិឝ្វសិតវ្យំ។</para>
  <para style="p">
    <verse number="7" style="v"/>អបរំ តទានីំ យាន្យទ្ឫឝ្យាន្យាសន៑ តានីឝ្វរេណាទិឞ្ដះ សន៑ នោហោ វិឝ្វាសេន ភីត្វា ស្វបរិជនានាំ រក្ឞាត៌្ហំ បោតំ និម៌្មិតវាន៑ តេន ច ជគជ្ជនានាំ ទោឞាន៑ ទឝ៌ិតវាន៑ វិឝ្វាសាត៑ លភ្យស្យ បុណ្យស្យាធិការី ពភូវ ច។</para>
  <para style="p">
    <verse number="8" style="v"/>វិឝ្វាសេនេព្រាហីម៑ អាហូតះ សន៑ អាជ្ញាំ គ្ឫហីត្វា យស្យ ស្ថានស្យាធិការស្តេន ប្រាប្តវ្យស្តត៑ ស្ថានំ ប្រស្ថិតវាន៑ កិន្តុ ប្រស្ថានសមយេ ក្ក យាមីតិ នាជានាត៑។</para>
  <para style="p">
    <verse number="9" style="v"/>វិឝ្វាសេន ស ប្រតិជ្ញាតេ ទេឝេ បរទេឝវត៑ ប្រវសន៑ តស្យាះ ប្រតិជ្ញាយាះ សមានាំឝិភ្យាម៑ ឥស្ហាកា យាកូពា ច សហ ទូឞ្យវាស្យភវត៑។</para>
  <para style="p">
    <verse number="10" style="v"/>យស្មាត៑ ស ឦឝ្វរេណ និម៌្មិតំ ស្ថាបិតញ្ច ភិត្តិមូលយុក្តំ នគរំ ប្រត្យៃក្ឞត។</para>
  <para style="p">
    <verse number="11" style="v"/>អបរញ្ច វិឝ្វាសេន សារា វយោតិក្រាន្តា សន្ត្យបិ គព៌្ហធារណាយ ឝក្តិំ ប្រាប្យ បុត្រវត្យភវត៑, យតះ សា ប្រតិជ្ញាការិណំ វិឝ្វាស្យម៑ អមន្យត។</para>
  <para style="p">
    <verse number="12" style="v"/>តតោ ហេតោ រ្ម្ឫតកល្បាទ៑ ឯកស្មាត៑ ជនាទ៑ អាកាឝីយនក្ឞត្រាណីវ គណនាតីតាះ សមុទ្រតីរស្ថសិកតា ឥវ ចាសំខ្យា លោកា ឧត្បេទិរេ។</para>
  <para style="p">
    <verse number="13" style="v"/>ឯតេ សវ៌្វេ ប្រតិជ្ញាយាះ ផលាន្យប្រាប្យ កេវលំ ទូរាត៑ តានិ និរីក្ឞ្យ វន្ទិត្វា ច, ប្ឫថិវ្យាំ វយំ វិទេឝិនះ ប្រវាសិនឝ្ចាស្មហ ឥតិ ស្វីក្ឫត្យ វិឝ្វាសេន ប្រាណាន៑ តត្យជុះ។</para>
  <para style="p">
    <verse number="14" style="v"/>យេ តុ ជនា ឥត្ថំ កថយន្តិ តៃះ បៃត្ឫកទេឝោ ៜស្មាភិរន្វិឞ្យត ឥតិ ប្រកាឝ្យតេ។</para>
  <para style="p">
    <verse number="15" style="v"/>តេ យស្មាទ៑ ទេឝាត៑ និគ៌តាស្តំ យទ្យស្មរិឞ្យន៑ តហ៌ិ បរាវត៌្តនាយ សមយម៑ អលប្ស្យន្ត។</para>
  <para style="p">
    <verse number="16" style="v"/>កិន្តុ តេ សវ៌្វោត្ក្ឫឞ្ដម៑ អត៌្ហតះ ស្វគ៌ីយំ ទេឝម៑ អាកាង្ក្ឞន្តិ តស្មាទ៑ ឦឝ្វរស្តានធិ ន លជ្ជមានស្តេឞាម៑ ឦឝ្វរ ឥតិ នាម គ្ឫហីតវាន៑ យតះ ស តេឞាំ ក្ឫតេ នគរមេកំ សំស្ថាបិតវាន៑។</para>
  <para style="p">
    <verse number="17" style="v"/>អបរម៑ ឥព្រាហីមះ បរីក្ឞាយាំ ជាតាយាំ ស វិឝ្វាសេនេស្ហាកម៑ ឧត្សសជ៌,</para>
  <para style="p">
    <verse number="18" style="v"/>វស្តុត ឥស្ហាកិ តវ វំឝោ វិខ្យាស្យត ឥតិ វាគ៑ យមធិ កថិតា តម៑ អទ្វិតីយំ បុត្រំ ប្រតិជ្ញាប្រាប្តះ ស ឧត្សសជ៌។</para>
  <para style="p">
    <verse number="19" style="v"/>យត ឦឝ្វរោ ម្ឫតានប្យុត្ថាបយិតុំ ឝក្នោតីតិ ស មេនេ តស្មាត៑ ស ឧបមារូបំ តំ លេភេ។</para>
  <para style="p">
    <verse number="20" style="v"/>អបរម៑ ឥស្ហាក៑ វិឝ្វាសេន យាកូព៑ ឯឞាវេ ច ភាវិវិឞយានធ្យាឝិឞំ ទទៅ។</para>
  <para style="p">
    <verse number="21" style="v"/>អបរំ យាកូព៑ មរណកាលេ វិឝ្វាសេន យូឞផះ បុត្រយោរេកៃកស្មៃ ជនាយាឝិឞំ ទទៅ យឞ្ដ្យា អគ្រភាគេ សមាលម្ព្យ ប្រណនាម ច។</para>
  <para style="p">
    <verse number="22" style="v"/>អបរំ យូឞផ៑ ចរមកាលេ វិឝ្វាសេនេស្រាយេល្វំឝីយានាំ មិសរទេឝាទ៑ ពហិគ៌មនស្យ វាចំ ជគាទ និជាស្ថីនិ ចាធិ សមាទិទេឝ។</para>
  <para style="p">
    <verse number="23" style="v"/>នវជាតោ មូសាឝ្ច វិឝ្វាសាត៑ ត្រាीន៑ មាសាន៑ ស្វបិត្ឫភ្យាម៑ អគោប្យត យតស្តៅ ស្វឝិឝុំ បរមសុន្ទរំ ទ្ឫឞ្ដវន្តៅ រាជាជ្ញាញ្ច ន ឝង្កិតវន្តៅ។</para>
  <para style="p">
    <verse number="24" style="v"/>អបរំ វយះប្រាប្តោ មូសា វិឝ្វាសាត៑ ផិរៅណោ ទៅហិត្រ ឥតិ នាម នាង្គីចការ។</para>
  <para style="p">
    <verse number="25" style="v"/>យតះ ស ក្ឞណិកាត៑ បាបជសុខភោគាទ៑ ឦឝ្វរស្យ ប្រជាភិះ សាទ៌្ធំ ទុះខភោគំ វវ្រេ។</para>
  <para style="p">
    <verse number="26" style="v"/>តថា មិសរទេឝីយនិធិភ្យះ ខ្រីឞ្ដនិមិត្តាំ និន្ទាំ មហតីំ សម្បត្តិំ មេនេ យតោ ហេតោះ ស បុរស្ការទានម៑ អបៃក្ឞត។</para>
  <para style="p">
    <verse number="27" style="v"/>អបរំ ស វិឝ្វាសេន រាជ្ញះ ក្រោធាត៑ ន ភីត្វា មិសរទេឝំ បរិតត្យាជ, យតស្តេនាទ្ឫឝ្យំ វីក្ឞមាណេនេវ ធៃយ៌្យម៑ អាលម្ពិ។</para>
  <para style="p">
    <verse number="28" style="v"/>អបរំ ប្រថមជាតានាំ ហន្តា យត៑ ស្វីយលោកាន៑ ន ស្ប្ឫឝេត៑ តទត៌្ហំ ស វិឝ្វាសេន និស្តារបវ៌្វីយពលិច្ឆេទនំ រុធិរសេចនញ្ចានុឞ្ឋិតាវាន៑។</para>
  <para style="p">
    <verse number="29" style="v"/>អបរំ តេ វិឝ្វាសាត៑ ស្ថលេនេវ សូផ្សាគរេណ ជគ្មុះ កិន្តុ មិស្រីយលោកាស្តត៑ កត៌្តុម៑ ឧបក្រម្យ តោយេឞុ មមជ្ជុះ។</para>
  <para style="p">
    <verse number="30" style="v"/>អបរញ្ច វិឝ្វាសាត៑ តៃះ សប្តាហំ យាវទ៑ យិរីហោះ ប្រាចីរស្យ ប្រទក្ឞិណេ ក្ឫតេ តត៑ និបបាត។</para>
  <para style="p">
    <verse number="31" style="v"/>វិឝ្វាសាទ៑ រាហព្នាមិកា វេឝ្យាបិ ប្រីត្យា ចារាន៑ អនុគ្ឫហ្យាវិឝ្វាសិភិះ សាទ៌្ធំ ន វិននាឝ។</para>
  <para style="p">
    <verse number="32" style="v"/>អធិកំ កិំ កថយិឞ្យាមិ? គិទិយោនោ ពារកះ ឝិម្ឝោនោ យិប្តហោ ទាយូទ៑ ឝិមូយេលោ ភវិឞ្យទ្វាទិនឝ្ចៃតេឞាំ វ្ឫត្តាន្តកថនាយ មម សមយាភាវោ ភវិឞ្យតិ។</para>
  <para style="p">
    <verse number="33" style="v"/>វិឝ្វាសាត៑ តេ រាជ្យានិ វឝីក្ឫតវន្តោ ធម៌្មកម៌្មាណិ សាធិតវន្តះ ប្រតិជ្ញានាំ ផលំ លព្ធវន្តះ សិំហានាំ មុខានិ រុទ្ធវន្តោ</para>
  <para style="p">
    <verse number="34" style="v"/>វហ្នេទ៌ាហំ និវ៌្វាបិតវន្តះ ខង្គធារាទ៑ រក្ឞាំ ប្រាប្តវន្តោ ទៅព៌្ពល្យេ សពលីក្ឫតា យុទ្ធេ បរាក្រមិណោ ជាតាះ បរេឞាំ សៃន្យានិ ទវយិតវន្តឝ្ច។</para>
  <para style="p">
    <verse number="35" style="v"/>យោឞិតះ បុនរុត្ថានេន ម្ឫតាន៑ អាត្មជាន៑ លេភិរេे, អបរេ ច ឝ្រេឞ្ឋោត្ថានស្យ ប្រាប្តេរាឝយា រក្ឞាម៑ អគ្ឫហីត្វា តាឌនេន ម្ឫតវន្តះ។</para>
  <para style="p">
    <verse number="36" style="v"/>អបរេ តិរស្ការៃះ កឝាភិ រ្ពន្ធនៃះ ការយា ច បរីក្ឞិតាះ។</para>
  <para style="p">
    <verse number="37" style="v"/>ពហវឝ្ច ប្រស្តរាឃាតៃ រ្ហតាះ ករបត្រៃ រ្វា វិទីណ៌ា យន្ត្រៃ រ្វា ក្លិឞ្ដាះ ខង្គធារៃ រ្វា វ្យាបាទិតាះ។ តេ មេឞាណាំ ឆាគានាំ វា ចម៌្មាណិ បរិធាយ ទីនាះ បីឌិតា ទុះខាត៌្តាឝ្ចាភ្រាម្យន៑។</para>
  <para style="p">
    <verse number="38" style="v"/>សំសារោ យេឞាម៑ អយោគ្យស្តេ និជ៌នស្ថានេឞុ បវ៌្វតេឞុ គហ្វរេឞុ ប្ឫថិវ្យាឝ្ឆិទ្រេឞុ ច បយ៌្យដន៑។</para>
  <para style="p">
    <verse number="39" style="v"/>ឯតៃះ សវ៌្វៃ រ្វិឝ្វាសាត៑ ប្រមាណំ ប្រាបិ កិន្តុ ប្រតិជ្ញាយាះ ផលំ ន ប្រាបិ។</para>
  <para style="p">
    <verse number="40" style="v"/>យតស្តេ យថាស្មាន៑ វិនា សិទ្ធា ន ភវេយុស្តថៃវេឝ្វរេណាស្មាកំ ក្ឫតេ ឝ្រេឞ្ឋតរំ កិមបិ និទ៌ិទិឝេ។</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>អតោ ហេតោរេតាវត្សាក្ឞិមេឃៃ រ្វេឞ្ដិតាះ សន្តោ វយមបិ សវ៌្វភារម៑ អាឝុពាធកំ បាបញ្ច និក្ឞិប្យាស្មាកំ គមនាយ និរូបិតេ មាគ៌េ ធៃយ៌្យេណ ធាវាម។</para>
  <para style="p">
    <verse number="2" style="v"/>យឝ្ចាស្មាកំ វិឝ្វាសស្យាគ្រេសរះ សិទ្ធិកត៌្តា ចាស្តិ តំ យីឝុំ វីក្ឞាមហៃ យតះ ស ស្វសម្មុខស្ថិតានន្ទស្យ ប្រាប្ត្យត៌្ហម៑ អបមានំ តុច្ឆីក្ឫត្យ ក្រុឝស្យ យាតនាំ សោឍវាន៑ ឦឝ្វរីយសិំហាសនស្យ ទក្ឞិណបាឝ៌្វេ សមុបវិឞ្ដវាំឝ្ច។</para>
  <para style="p">
    <verse number="3" style="v"/>យះ បាបិភិះ ស្វវិរុទ្ធម៑ ឯតាទ្ឫឝំ វៃបរីត្យំ សោឍវាន៑ តម៑ អាលោចយត តេន យូយំ ស្វមនះសុ ឝ្រាន្តាះ ក្លាន្តាឝ្ច ន ភវិឞ្យថ។</para>
  <para style="p">
    <verse number="4" style="v"/>យូយំ បាបេន សហ យុធ្យន្តោៜទ្យាបិ ឝោណិតវ្យយបយ៌្យន្តំ ប្រតិរោធំ នាកុរុត។</para>
  <para style="p">
    <verse number="5" style="v"/>តថា ច បុត្រាន៑ ប្រតីវ យុឞ្មាន៑ ប្រតិ យ ឧបទេឝ ឧក្តស្តំ កិំ វិស្ម្ឫតវន្តះ? "បរេឝេន ក្ឫតាំ ឝាស្តិំ ហេ មត្បុត្រ ន តុច្ឆយ។ តេន សំភត៌្សិតឝ្ចាបិ នៃវ ក្លាម្យ កទាចន។</para>
  <para style="p">
    <verse number="6" style="v"/>បរេឝះ ប្រីយតេ យស្មិន៑ តស្មៃ ឝាស្តិំ ទទាតិ យត៑។ យន្តុ បុត្រំ ស គ្ឫហ្លាតិ តមេវ ប្រហរត្យបិ។ "</para>
  <para style="p">
    <verse number="7" style="v"/>យទិ យូយំ ឝាស្តិំ សហធ្វំ តហ៌ីឝ្វរះ បុត្រៃរិវ យុឞ្មាភិះ សាទ៌្ធំ វ្យវហរតិ យតះ បិតា យស្មៃ ឝាស្តិំ ន ទទាតិ តាទ្ឫឝះ បុត្រះ កះ?</para>
  <para style="p">
    <verse number="8" style="v"/>សវ៌្វេ យស្យាះ ឝាស្តេរំឝិនោ ភវន្តិ សា យទិ យុឞ្មាកំ ន ភវតិ តហ៌ិ យូយម៑ អាត្មជា ន កិន្តុ ជារជា អាធ្វេ។</para>
  <para style="p">
    <verse number="9" style="v"/>អបរម៑ អស្មាកំ ឝារីរិកជន្មទាតារោៜស្មាកំ ឝាស្តិការិណោៜភវន៑ តេ ចាស្មាភិះ សម្មានិតាស្តស្មាទ៑ យ អាត្មនាំ ជនយិតា វយំ កិំ តតោៜធិកំ តស្យ វឝីភូយ ន ជីវិឞ្យាមះ?</para>
  <para style="p">
    <verse number="10" style="v"/>តេ ត្វល្បទិនានិ យាវត៑ ស្វមនោៜមតានុសារេណ ឝាស្តិំ ក្ឫតវន្តះ កិន្ត្វេឞោៜស្មាកំ ហិតាយ តស្យ បវិត្រតាយា អំឝិត្វាយ ចាស្មាន៑ ឝាស្តិ។</para>
  <para style="p">
    <verse number="11" style="v"/>ឝាស្តិឝ្ច វត៌្តមានសមយេ កេនាបិ នានន្ទជនិកា កិន្តុ ឝោកជនិកៃវ មន្យតេ តថាបិ យេ តយា វិនីយន្តេ តេភ្យះ សា បឝ្ចាត៑ ឝាន្តិយុក្តំ ធម៌្មផលំ ទទាតិ។</para>
  <para style="p">
    <verse number="12" style="v"/>អតឯវ យូយំ ឝិថិលាន៑ ហស្តាន៑ ទុព៌្ពលានិ ជានូនិ ច សពលានិ កុរុធ្វំ។</para>
  <para style="p">
    <verse number="13" style="v"/>យថា ច ទុព៌្ពលស្យ សន្ធិស្ថានំ ន ភជ្យេត ស្វស្ថំ តិឞ្ឋេត៑ តថា ស្វចរណាត៌្ហំ សរលំ មាគ៌ំ និម៌្មាត។</para>
  <para style="p">
    <verse number="14" style="v"/>អបរញ្ច សវ៌្វៃះ សាត៌្ហម៑ ឯेក្យភាវំ យច្ច វិនា បរមេឝ្វរស្យ ទឝ៌នំ កេនាបិ ន លប្ស្យតេ តត៑ បវិត្រត្វំ ចេឞ្ដធ្វំ។</para>
  <para style="p">
    <verse number="15" style="v"/>យថា កឝ្ចិទ៑ ឦឝ្វរស្យានុគ្រហាត៑ ន បតេត៑, យថា ច តិក្តតាយា មូលំ ប្ររុហ្យ ពាធាជនកំ ន ភវេត៑ តេន ច ពហវោៜបវិត្រា ន ភវេយុះ,</para>
  <para style="p">
    <verse number="16" style="v"/>យថា ច កឝ្ចិត៑ លម្បដោ វា ឯកក្ឫត្វ អាហារាត៌្ហំ ស្វីយជ្យេឞ្ឋាធិការវិក្រេតា យ ឯឞៅស្តទ្វទ៑ អធម៌្មាចារី ន ភវេត៑ តថា សាវធានា ភវត។</para>
  <para style="p">
    <verse number="17" style="v"/>យតះ ស ឯឞៅះ បឝ្ចាទ៑ អាឝីវ៌្វាទាធិការី ភវិតុម៑ ឥច្ឆន្នបិ នានុគ្ឫហីត ឥតិ យូយំ ជានីថ, ស ចាឝ្រុបាតេន មត្យន្តរំ ប្រាត៌្ហយមានោៜបិ តទុបាយំ ន លេភេ។</para>
  <para style="p">
    <verse number="18" style="v"/>អបរញ្ច ស្ប្ឫឝ្យះ បវ៌្វតះ ប្រជ្វលិតោ វហ្និះ ក្ឫឞ្ណាវណ៌ោ មេឃោ ៜន្ធការោ ឈញ្ភ្ឝ តូរីវាទ្យំ វាក្យានាំ ឝព្ទឝ្ច នៃតេឞាំ សន្និធៅ យូយម៑ អាគតាះ។</para>
  <para style="p">
    <verse number="19" style="v"/>តំ ឝព្ទំ ឝ្រុត្វា ឝ្រោតារស្តាទ្ឫឝំ សម្ភាឞណំ យត៑ បុន រ្ន ជាយតេ តត៑ ប្រាត៌្ហិតវន្តះ។</para>
  <para style="p">
    <verse number="20" style="v"/>យតះ បឝុរបិ យទិ ធរាធរំ ស្ប្ឫឝតិ តហ៌ិ ស បាឞាណាឃាតៃ រ្ហន្តវ្យ ឥត្យាទេឝំ សោឍុំ តេ នាឝក្នុវន៑។</para>
  <para style="p">
    <verse number="21" style="v"/>តច្ច ទឝ៌នម៑ ឯវំ ភយានកំ យត៑ មូសសោក្តំ ភីតស្ត្រាសយុក្តឝ្ចាស្មីតិ។</para>
  <para style="p">
    <verse number="22" style="v"/>កិន្តុ សីយោន្បវ៌្វតោ ៜមរេឝ្វរស្យ នគរំ ស្វគ៌ស្ថយិរូឝាលមម៑ អយុតានិ ទិវ្យទូតាះ</para>
  <para style="p">
    <verse number="23" style="v"/>ស្វគ៌េ លិខិតានាំ ប្រថមជាតានាម៑ ឧត្សវះ សមិតិឝ្ច សវ៌្វេឞាំ វិចារាធិបតិរីឝ្វរះ សិទ្ធីក្ឫតធាម៌្មិកានាម៑ អាត្មានោ</para>
  <para style="p">
    <verse number="24" style="v"/>នូតននិយមស្យ មធ្យស្ថោ យីឝុះ, អបរំ ហាពិលោ រក្តាត៑ ឝ្រេយះ ប្រចារកំ ប្រោក្ឞណស្យ រក្តញ្ចៃតេឞាំ សន្និធៅ យូយម៑ អាគតាះ។</para>
  <para style="p">
    <verse number="25" style="v"/>សាវធានា ភវត តំ វក្តារំ នាវជានីត យតោ ហេតោះ ប្ឫថិវីស្ថិតះ ស វក្តា យៃរវជ្ញាតស្តៃ រ្យទិ រក្ឞា នាប្រាបិ តហ៌ិ ស្វគ៌ីយវក្តុះ បរាង្មុខីភូយាស្មាភិះ កថំ រក្ឞា ប្រាប្ស្យតេ?</para>
  <para style="p">
    <verse number="26" style="v"/>តទា តស្យ រវាត៑ ប្ឫថិវី កម្បិតា កិន្ត្វិទានីំ តេនេទំ ប្រតិជ្ញាតំ យថា, "អហំ បុនរេកក្ឫត្វះ ប្ឫថិវីំ កម្បយិឞ្យាមិ កេវលំ តន្នហិ គគនមបិ កម្បយិឞ្យាមិ។ "</para>
  <para style="p">
    <verse number="27" style="v"/>ស ឯកក្ឫត្វះ ឝព្ទោ និឝ្ចលវិឞយាណាំ ស្ថិតយេ និម៌្មិតានាមិវ ចញ្ចលវស្តូនាំ ស្ថានាន្តរីករណំ ប្រកាឝយតិ។</para>
  <para style="p">
    <verse number="28" style="v"/>អតឯវ និឝ្ចលរាជ្យប្រាប្តៃរស្មាភិះ សោៜនុគ្រហ អាលម្ពិតវ្យោ យេន វយំ សាទរំ សភយញ្ច តុឞ្ដិជនករូបេណេឝ្វរំ សេវិតុំ ឝក្នុយាម។</para>
  <para style="p">
    <verse number="29" style="v"/>យតោៜស្មាកម៑ ឦឝ្វរះ សំហារកោ វហ្និះ។</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ភ្រាត្ឫឞុ ប្រេម តិឞ្ឋតុ។ អតិថិសេវា យុឞ្មាភិ រ្ន វិស្មយ៌្យតាំ</para>
  <para style="p">
    <verse number="2" style="v"/>យតស្តយា ប្រច្ឆន្នរូបេណ ទិវ្យទូតាះ កេឞាញ្ចិទ៑ អតិថយោៜភវន៑។</para>
  <para style="p">
    <verse number="3" style="v"/>ពន្ទិនះ សហពន្ទិភិរិវ ទុះខិនឝ្ច ទេហវាសិភិរិវ យុឞ្មាភិះ ស្មយ៌្យន្តាំ។</para>
  <para style="p">
    <verse number="4" style="v"/>វិវាហះ សវ៌្វេឞាំ សមីបេ សម្មានិតវ្យស្តទីយឝយ្យា ច ឝុចិះ កិន្តុ វេឝ្យាគាមិនះ បារទារិកាឝ្ចេឝ្វរេណ ទណ្ឌយិឞ្យន្តេ។</para>
  <para style="p">
    <verse number="5" style="v"/>យូយម៑ អាចារេ និល៌ោភា ភវត វិទ្យមានវិឞយេ សន្តុឞ្យត ច យស្មាទ៑ ឦឝ្វរ ឯវេទំ កថិតវាន៑, យថា, "ត្វាំ ន ត្យក្ឞ្យាមិ ន ត្វាំ ហាស្យាមិ។ "</para>
  <para style="p">
    <verse number="6" style="v"/>អតឯវ វយម៑ ឧត្សាហេនេទំ កថយិតុំ ឝក្នុមះ, "មត្បក្ឞេ បរមេឝោៜស្តិ ន ភេឞ្យាមិ កទាចន។ យស្មាត៑ មាំ ប្រតិ កិំ កត៌្តុំ មានវះ បារយិឞ្យតិ៕ "</para>
  <para style="p">
    <verse number="7" style="v"/>យុឞ្មាកំ យេ នាយកា យុឞ្មភ្យម៑ ឦឝ្វរស្យ វាក្យំ កថិតវន្តស្តេ យុឞ្មាភិះ ស្មយ៌្យន្តាំ តេឞាម៑ អាចារស្យ បរិណាមម៑ អាលោច្យ យុឞ្មាភិស្តេឞាំ វិឝ្វាសោៜនុក្រិយតាំ។</para>
  <para style="p">
    <verse number="8" style="v"/>យីឝុះ ខ្រីឞ្ដះ ឝ្វោៜទ្យ សទា ច ស ឯវាស្តេ។</para>
  <para style="p">
    <verse number="9" style="v"/>យូយំ នានាវិធនូតនឝិក្ឞាភិ រ្ន បរិវត៌្តធ្វំ យតោៜនុគ្រហេណាន្តះករណស្យ សុស្ថិរីភវនំ ក្ឞេមំ ន ច ខាទ្យទ្រវ្យៃះ។ យតស្តទាចារិណស្តៃ រ្នោបក្ឫតាះ។</para>
  <para style="p">
    <verse number="10" style="v"/>យេ ទឞ្យស្យ សេវាំ កុវ៌្វន្តិ តេ យស្យា ទ្រវ្យភោជនស្យានធិការិណស្តាទ្ឫឝី យជ្ញវេទិរស្មាកម៑ អាស្តេ។</para>
  <para style="p">
    <verse number="11" style="v"/>យតោ យេឞាំ បឝូនាំ ឝោណិតំ បាបនាឝាយ មហាយាជកេន មហាបវិត្រស្ថានស្យាភ្យន្តរំ នីយតេ តេឞាំ ឝរីរាណិ ឝិពិរាទ៑ ពហិ រ្ទហ្យន្តេ។</para>
  <para style="p">
    <verse number="12" style="v"/>តស្មាទ៑ យីឝុរបិ យត៑ ស្វរុធិរេណ ប្រជាះ បវិត្រីកុយ៌្យាត៑ តទត៌្ហំ នគរទ្វារស្យ ពហិ រ្ម្ឫតិំ ភុក្តវាន៑។</para>
  <para style="p">
    <verse number="13" style="v"/>អតោ ហេតោរស្មាភិរបិ តស្យាបមានំ សហមានៃះ ឝិពិរាទ៑ ពហិស្តស្យ សមីបំ គន្តវ្យំ។</para>
  <para style="p">
    <verse number="14" style="v"/>យតោ ៜត្រាស្មាកំ ស្ថាយិ នគរំ ន វិទ្យតេ កិន្តុ ភាវិ នគរម៑ អស្មាភិរន្វិឞ្យតេ។</para>
  <para style="p">
    <verse number="15" style="v"/>អតឯវ យីឝុនាស្មាភិ រ្និត្យំ ប្រឝំសារូបោ ពលិរត៌្ហតស្តស្យ នាមាង្គីកុវ៌្វតាម៑ ឱឞ្ឋាធរាណាំ ផលម៑ ឦឝ្វរាយ ទាតវ្យំ។</para>
  <para style="p">
    <verse number="16" style="v"/>អបរញ្ច បរោបការោ ទានញ្ច យុឞ្មាភិ រ្ន វិស្មយ៌្យតាំ យតស្តាទ្ឫឝំ ពលិទានម៑ ឦឝ្វរាយ រោចតេ។</para>
  <para style="p">
    <verse number="17" style="v"/>យូយំ ស្វនាយកានាម៑ អាជ្ញាគ្រាហិណោ វឝ្យាឝ្ច ភវត យតោ យៃរុបនិធិះ ប្រតិទាតវ្យស្តាទ្ឫឝា លោកា ឥវ តេ យុឞ្មទីយាត្មនាំ រក្ឞណាត៌្ហំ ជាគ្រតិ, អតស្តេ យថា សានន្ទាស្តត៑ កុយ៌្យុ រ្ន ច សាត៌្តស្វរា អត្រ យតធ្វំ យតស្តេឞាម៑ អាត៌្តស្វរោ យុឞ្មាកម៑ ឥឞ្ដជនកោ ន ភវេត៑។</para>
  <para style="p">
    <verse number="18" style="v"/>អបរញ្ច យូយម៑ អស្មន្និមិត្តិំ ប្រាត៌្ហនាំ កុរុត យតោ វយម៑ ឧត្តមមនោវិឝិឞ្ដាះ សវ៌្វត្រ សទាចារំ កត៌្តុម៑ ឥច្ឆុកាឝ្ច ភវាម ឥតិ និឝ្ចិតំ ជានីមះ។</para>
  <para style="p">
    <verse number="19" style="v"/>វិឝេឞតោៜហំ យថា ត្វរយា យុឞ្មភ្យំ បុន រ្ទីយេ តទត៌្ហំ ប្រាត៌្ហនាយៃ យុឞ្មាន៑ អធិកំ វិនយេ។</para>
  <para style="p">
    <verse number="20" style="v"/>អនន្តនិយមស្យ រុធិរេណ វិឝិឞ្ដោ មហាន៑ មេឞបាលកោ យេន ម្ឫតគណមធ្យាត៑ បុនរានាយិ ស ឝាន្តិទាយក ឦឝ្វរោ</para>
  <para style="p">
    <verse number="21" style="v"/>និជាភិមតសាធនាយ សវ៌្វស្មិន៑ សត្កម៌្មណិ យុឞ្មាន៑ សិទ្ធាន៑ ករោតុ, តស្យ ទ្ឫឞ្ដៅ ច យទ្យត៑ តុឞ្ដិជនកំ តទេវ យុឞ្មាកំ មធ្យេ យីឝុនា ខ្រីឞ្ដេន សាធយតុ។ តស្មៃ មហិមា សវ៌្វទា ភូយាត៑។ អាមេន៑។</para>
  <para style="p">
    <verse number="22" style="v"/>ហេ ភ្រាតរះ, វិនយេៜហំ យូយម៑ ឥទម៑ ឧបទេឝវាក្យំ សហធ្វំ យតោៜហំ សំក្ឞេបេណ យុឞ្មាន៑ ប្រតិ លិខិតវាន៑។</para>
  <para style="p">
    <verse number="23" style="v"/>អស្មាកំ ភ្រាតា តីមថិយោ មុក្តោៜភវទ៑ ឥតិ ជានីត, ស ច យទិ ត្វរយា សមាគច្ឆតិ តហ៌ិ តេន សាទ៌្ធំម៑ អហំ យុឞ្មាន៑ សាក្ឞាត៑ ករិឞ្យាមិ។</para>
  <para style="p">
    <verse number="24" style="v"/>យុឞ្មាកំ សវ៌្វាន៑ នាយកាន៑ បវិត្រលោកាំឝ្ច នមស្កុរុត។ អបរម៑ ឥតាលិយាទេឝីយានាំ នមស្ការំ ជ្ញាស្យថ។</para>
  <para style="p">
    <verse number="25" style="v"/>អនុគ្រហោ យុឞ្មាកំ សវ៌្វេឞាំ សហាយោ ភូយាត៑។ អាមេន៑។</para>
</usx>
