<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="PHM" style="id">Sanskrit Bible (NT) in Khmer Script (សត្យវេទះ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Philemon</para>
  <para style="toc1">ផិលោមោនំ បត្រំ</para>
  <para style="toc2">ផិលោមោនះ</para>
  <para style="toc3">ផិលោមោនះ</para>
  <para style="mt1">ផិលោមោនំ បត្រំ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ខ្រីឞ្ដស្យ យីឝោ រ្ពន្ទិទាសះ បៅលស្តីថិយនាមា ភ្រាតា ច ប្រិយំ សហការិណំ ផិលីមោនំ</para>
  <para style="p">
    <verse number="2" style="v"/>ប្រិយាម៑ អាប្បិយាំ សហសេនាម៑ អាក៌្ហិប្បំ ផិលីមោនស្យ គ្ឫហេ ស្ថិតាំ សមិតិញ្ច ប្រតិ បត្រំ លិខតះ។</para>
  <para style="p">
    <verse number="3" style="v"/>អស្មាកំ តាត ឦឝ្វរះ ប្រភុ រ្យីឝុខ្រីឞ្ដឝ្ច យុឞ្មាន៑ ប្រតិ ឝាន្តិម៑ អនុគ្រហញ្ច ក្រិយាស្តាំ។</para>
  <para style="p">
    <verse number="4" style="v"/>ប្រភុំ យីឝុំ ប្រតិ សវ៌្វាន៑ បវិត្រលោកាន៑ ប្រតិ ច តវ ប្រេមវិឝ្វាសយោ រ្វ្ឫត្តាន្តំ និឝម្យាហំ</para>
  <para style="p">
    <verse number="5" style="v"/>ប្រាត៌្ហនាសមយេ តវ នាមោច្ចារយន៑ និរន្តរំ មមេឝ្វរំ ធន្យំ វទាមិ។</para>
  <para style="p">
    <verse number="6" style="v"/>អស្មាសុ យទ្យត៑ សៅជន្យំ វិទ្យតេ តត៑ សវ៌្វំ ខ្រីឞ្ដំ យីឝុំ យត៑ ប្រតិ ភវតីតិ ជ្ញានាយ តវ វិឝ្វាសមូលិកា ទានឝីលតា យត៑ សផលា ភវេត៑ តទហម៑ ឥច្ឆាមិ។</para>
  <para style="p">
    <verse number="7" style="v"/>ហេ ភ្រាតះ, ត្វយា បវិត្រលោកានាំ ប្រាណ អាប្យាយិតា អភវន៑ ឯតស្មាត៑ តវ ប្រេម្នាស្មាកំ មហាន៑ អានន្ទះ សាន្ត្វនា ច ជាតះ។</para>
  <para style="p">
    <verse number="8" style="v"/>ត្វយា យត៑ កត៌្តវ្យំ តត៑ ត្វាម៑ អាជ្ញាបយិតុំ យទ្យប្យហំ ខ្រីឞ្ដេនាតីវោត្សុកោ ភវេយំ តថាបិ វ្ឫទ្ធ</para>
  <para style="p">
    <verse number="9" style="v"/>ឥទានីំ យីឝុខ្រីឞ្ដស្យ ពន្ទិទាសឝ្ចៃវម្ភូតោ យះ បៅលះ សោៜហំ ត្វាំ វិនេតុំ វរំ មន្យេ។</para>
  <para style="p">
    <verse number="10" style="v"/>អតះ ឝ្ឫង្ខលពទ្ធោៜហំ យមជនយំ តំ មទីយតនយម៑ ឱនីឞិមម៑ អធិ ត្វាំ វិនយេ។</para>
  <para style="p">
    <verse number="11" style="v"/>ស បូវ៌្វំ តវានុបការក អាសីត៑ កិន្ត្វិទានីំ តវ មម ចោបការី ភវតិ។</para>
  <para style="p">
    <verse number="12" style="v"/>តមេវាហំ តវ សមីបំ ប្រេឞយាមិ, អតោ មទីយប្រាណស្វរូបះ ស ត្វយានុគ្ឫហ្យតាំ។</para>
  <para style="p">
    <verse number="13" style="v"/>សុសំវាទស្យ ក្ឫតេ ឝ្ឫង្ខលពទ្ធោៜហំ បរិចារកមិវ តំ ស្វសន្និធៅ វត៌្តយិតុម៑ ឰច្ឆំ។</para>
  <para style="p">
    <verse number="14" style="v"/>កិន្តុ តវ សៅជន្យំ យទ៑ ពលេន ន ភូត្វា ស្វេច្ឆាយាះ ផលំ ភវេត៑ តទត៌្ហំ តវ សម្មតិំ វិនា កិមបិ កត៌្តវ្យំ នាមន្យេ។</para>
  <para style="p">
    <verse number="15" style="v"/>កោ ជានាតិ ក្ឞណកាលាត៌្ហំ ត្វត្តស្តស្យ វិច្ឆេទោៜភវទ៑ ឯតស្យាយម៑ អភិប្រាយោ យត៑ ត្វម៑ អនន្តកាលាត៌្ហំ តំ លប្ស្យសេ</para>
  <para style="p">
    <verse number="16" style="v"/>បុន រ្ទាសមិវ លប្ស្យសេ តន្នហិ កិន្តុ ទាសាត៑ ឝ្រេឞ្ឋំ មម ប្រិយំ តវ ច ឝារីរិកសម្ពន្ធាត៑ ប្រភុសម្ពន្ធាច្ច តតោៜធិកំ ប្រិយំ ភ្រាតរមិវ។</para>
  <para style="p">
    <verse number="17" style="v"/>អតោ ហេតោ រ្យទិ មាំ សហភាគិនំ ជានាសិ តហ៌ិ មាមិវ តមនុគ្ឫហាណ។</para>
  <para style="p">
    <verse number="18" style="v"/>តេន យទិ តវ កិមប្យបរាទ្ធំ តុភ្យំ កិមបិ ធាយ៌្យតេ វា តហ៌ិ តត៑ មមេតិ វិទិត្វា គណយ។</para>
  <para style="p">
    <verse number="19" style="v"/>អហំ តត៑ បរិឝោត្ស្យាមិ, ឯតត៑ បៅលោៜហំ ស្វហស្តេន លិខាមិ, យតស្ត្វំ ស្វប្រាណាន៑ អបិ មហ្យំ ធារយសិ តទ៑ វក្តុំ នេច្ឆាមិ។</para>
  <para style="p">
    <verse number="20" style="v"/>ភោ ភ្រាតះ, ប្រភោះ ក្ឫតេ មម វាញ្ឆាំ បូរយ ខ្រីឞ្ដស្យ ក្ឫតេ មម ប្រាណាន៑ អាប្យាយយ។</para>
  <para style="p">
    <verse number="21" style="v"/>តវាជ្ញាគ្រាហិត្វេ វិឝ្វស្យ មយា ឯតត៑ លិខ្យតេ មយា យទុច្យតេ តតោៜធិកំ ត្វយា ការិឞ្យត ឥតិ ជានាមិ។</para>
  <para style="p">
    <verse number="22" style="v"/>តត្ករណសមយេ មទត៌្ហមបិ វាសគ្ឫហំ ត្វយា សជ្ជីក្រិយតាំ យតោ យុឞ្មាកំ ប្រាត៌្ហនានាំ ផលរូបោ វរ ឥវាហំ យុឞ្មភ្យំ ទាយិឞ្យេ មមេតិ ប្រត្យាឝា ជាយតេ។</para>
  <para style="p">
    <verse number="23" style="v"/>ខ្រីឞ្ដស្យ យីឝាះ ក្ឫតេ មយា សហ ពន្ទិរិបាផ្រា</para>
  <para style="p">
    <verse number="24" style="v"/>មម សហការិណោ មាក៌ អារិឞ្ដាក៌្ហោ ទីមា លូកឝ្ច ត្វាំ នមស្ការំ វេទយន្តិ។</para>
  <para style="p">
    <verse number="25" style="v"/>អស្មាកំ ប្រភោ រ្យីឝុខ្រីឞ្ដស្យានុគ្រហោ យុឞ្មាកម៑ អាត្មនា សហ ភូយាត៑។ អាមេន៑។</para>
</usx>
