  <book code="COL" style="id">EN_VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:37:29 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Colossians</para>
  <para style="toc1">Thư Cô-lô-se</para>
  <para style="toc2">Cô-lô-se</para>
  <para style="toc3">Col</para>
  <para style="mt">Cô-lô-se</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />Phao-lô, sứ đồ của Chúa Cứu Thế Giê-xu theo ý muốn Thiên Chúa, và Ti-mô-thê, người anh em của chúng ta, <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />gửi cho các thánh đồ và anh chị em trung tín trong Chúa Cứu Thế tại Cô-lô-se. Nguyện ân điển và sự bình an từ Thiên Chúa, là Cha và Chúa chúng ta, là Chúa Cứu Thế Giê-xu, đến trên anh chị em.<note caller="+" style="f"><char style="ft" closed="false">Một số bản lúc đầu bỏ đi cụm từ </char><char style="fqa">và Chúa chúng ta, là Chúa Cứu Thế Giê-xu</char>.</note><verse eid="COL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />Chúng tôi tạ ơn Thiên Chúa, Cha của Chúa chúng ta, là Chúa Cứu Thế Giê-xu, trong mọi lúc cầu nguyện cho anh chị em, <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />vì đã nghe về đức tin của anh chị em trong Chúa Cứu Thế Giê-xu và về tình yêu thương mà anh chị em có đối với tất cả các thánh đồ, <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />bởi cớ niềm hy vọng được dành sẵn cho anh chị em trên các tầng trời, là điều mà anh chị em đã nghe lúc trước trong lẽ đạo của chân lý, tức là Phúc Âm, <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />là điều đang hiện diện giữa vòng anh chị em, mà Phúc Âm ấy đang kết quả và được phát triển trên toàn thế giới thể nào, thì cũng như vậy ở trong anh chị em, kể từ ngày anh chị em đã nghe và học biết ân điển của Thiên Chúa trong chân lý, <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />y như anh chị em đã học biết từ Ê-pháp-ra, người đồng lao yêu quý của chúng tôi, anh là một tôi tớ trung thành của Chúa Cứu Thế thay mặt chúng tôi, <note caller="+" style="f"><char style="ft" closed="false">Một số phiên bản đọc: </char><char style="fqa">thay mặt anh chị em</char>.</note> <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />và là người đã tỏ cho chúng tôi biết tình yêu thương của anh chị em trong Thánh Linh.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />Do đó, từ ngày chúng tôi nghe như thế, thì chúng tôi không ngừng cầu nguyện cho anh chị em và nài xin, hầu cho anh chị em được đầy dẫy sự hiểu biết ý muốn Ngài trong mọi sự khôn ngoan và thông hiểu thuộc linh, <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />để bước đi cách xứng đáng với Chúa trong mọi sự đẹp ý Ngài, kết quả trong từng việc thiện lành, được tăng trưởng trong sự nhận biết Thiên Chúa, <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />được mạnh mẽ với đầy dẫy sức lực tùy theo năng quyền vinh hiển của Ngài, để đạt đến mọi sự chịu đựng và nhẫn nại với lòng vui mừng, <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />dâng lời cảm tạ Cha, Đấng đã khiến anh chị em đủ điều kiện ở trong sự dự phần cơ nghiệp với các thánh đồ trong sự sáng.<note caller="+" style="f"><char style="ft" closed="false">Một số phiên bản đọc: </char><char style="fqa">Đấng khiến chúng ta được cùng hưởng</char>.</note> <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />Chính Đấng ấy đã giải cứu chúng ta khỏi quyền lực của sự tối tăm, và đưa chúng ta đến vương quốc của Con yêu dấu của Ngài, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />trong Con ấy, chúng ta có sự cứu chuộc, tức là sự tha thứ tội lỗi.<note caller="+" style="f"><char style="ft" closed="false">Một số phiên bản đọc: </char><char style="fqa">trong Con ấy chúng ta được cứu chuộc nhờ huyết Ngài, tức là sự tha tội</char>.</note> <verse eid="COL 1:14" /><verse number="15" style="v" sid="COL 1:15" />Con ấy là hình ảnh của Thiên Chúa không thấy được, là Đấng sanh ra trước nhất trong mọi tạo vật. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />Vì trong Con, mọi vật trên trời lẫn dưới đất, hữu hình lẫn vô hình, đều đã được tạo dựng. Dẫu có là vương quyền, hoặc chủ quyền, hoặc uy quyền, hoặc thẩm quyền, thì tất cả đều được tạo ra bởi Con và vì Con. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />Con ấy có trước mọi vật, và mọi vật gắn kết với nhau trong Con. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />Con ấy cũng là đầu của thân thể, tức hội thánh. Chính Con ấy là khởi nguyên, là Đấng sanh ra trước nhất từ giữa vòng kẻ chết, hầu cho Con ấy làm Đấng đứng đầu trên muôn vật. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />Vì Thiên Chúa đã hài lòng để cho mọi sự trọn vẹn ở trong Con, <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />và thông qua Con để giải hòa muôn vật với chính Ngài, dầu là các vật dưới đất, hay các vật trên trời, vì đã đem đến sự giải hòa qua Con ấy, nhờ huyết trên thập tự giá của Con. <verse eid="COL 1:20" /><verse number="21" style="v" sid="COL 1:21" />Lúc trước, khi anh chị em bị xem là người xa lạ và là kẻ thù nghịch trong suy nghĩ, trong các việc gian ác, <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />mà giờ đây, anh chị em đã được giải hòa nhờ sự chết trong thể xác của Con, để trình diện anh chị em trước mặt Ngài, là những người thánh sạch, không tì vết, và không chỗ chê trách, <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />ít ra là nếu anh chị em cứ ở trong đức tin, chịu đâm rễ, vững vàng, và không bị dời khỏi niềm hy vọng của Phúc Âm mà anh chị em đã nghe, là Phúc Âm đã được công bố cho mọi tạo vật dưới trời, mà bởi đó, tôi, Phao-lô, đã trở nên một tôi tớ.<verse eid="COL 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Giờ đây tôi vui mừng trong những khổ nạn của mình vì anh chị em, và bằng xác thịt mình, tôi đang lấp đầy các phần còn thiếu trong những nỗi đau đớn của Chúa Cứu Thế, vì cớ thân thể Ngài, tức là hội thánh, <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />mà bởi đó, tôi đã trở nên một tôi tớ, theo sự quản trị của Thiên Chúa, mà việc ấy đã được trao cho tôi vì anh chị em, để hoàn tất việc rao truyền lời của Thiên Chúa, <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />tức là điều huyền nhiệm đã được giấu kín trải các thời đại và suốt nhiều thế hệ, mà giờ đây, huyện nhiệm ấy đã được mạc khải cho các thánh đồ của Ngài, <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />là những người mà Thiên Chúa muốn bày tỏ thể nào là sự giàu có vinh hiển của điều huyền nhiệm này giữa vòng các dân ngoại, ấy là Chúa Cứu Thế trong anh chị em, tức là niềm hy vọng vinh hiển. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />Ấy là Đấng mà chúng tôi công bố, khi cảnh báo mọi người, và dạy dỗ mọi người với tất cả sự khôn ngoan, để chúng tôi có thể trình diện mọi người là trọn vẹn trong Chúa Cứu Thế. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />Cũng vì điều đó mà tôi lao nhọc, chiến đấu theo như tác động của Ngài đang vận hành với năng quyền trong tôi.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />Vì tôi muốn anh chị em biết tôi có cuộc chiến đấu lớn dường nào cho anh chị em, và cho các tín hữu tại Lao-đi-xê, cùng với biết bao người nữa chưa từng thấy mặt tôi về phần xác, <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />để lòng họ được khích lệ, khi được gắn kết với nhau trong tình yêu thương, và hướng tới mọi sự phong phú của việc am hiểu đầy đủ chắc chắn, dẫn đến sự nhận biết điều huyền nhiệm của Thiên Chúa, tức là Chúa Cứu Thế, <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />mà trong Ngài là sự ẩn chứa tất cả các kho tàng khôn ngoan và hiểu biết. <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />Tôi nói điều này để chẳng ai có thể lừa dối anh chị em bằng lời lẽ ngon ngọt. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Vì dù đúng là tôi không hiện diện trong xác thịt, nhưng tôi ở với anh chị em trong tâm linh, vui mừng và nhìn thấy trật tự hẳn hoi trong anh chị em, cùng với sức mạnh của đức tin của anh chị em trong Chúa Cứu Thế.<verse eid="COL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Vậy nên, ngay khi anh chị em đã tiếp nhận Chúa Cứu Thế Giê-xu làm Chúa, thì hãy bước đi trong Ngài, <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />chịu đâm rễ và được xây dựng trong Ngài, cùng được làm cho vững chắc trong đức tin y như anh chị em đã được dạy dỗ, và dư dật trong sự tạ ơn.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />Hãy cẩn thận, kẻo một ai đó sẽ là kẻ bắt giữ anh chị em bằng triết lý và mánh khóe rỗng tuếch, theo truyền thống của loài người, theo các nguyên tắc của thế gian, mà không theo Chúa Cứu Thế. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />Vì trong Ngài, toàn bộ sự đầy đủ của thần tánh Thiên Chúa ở trong thân thể vật chất, <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />và anh chị em đã được làm cho đầy đủ trong Ngài, Đấng là đầu của mọi thế lực và thẩm quyền, <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />mà trong Đấng ấy, anh chị em cũng được cắt bì với phép cắt bì không do tay người thực hiện, nhưng bằng việc lột bỏ bản chất xác thịt, tức là bằng phép cắt bì của Chúa Cứu Thế, <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />vì đã được chôn với Ngài trong phép báp-têm, và trong Ngài anh chị em đã được sống lại nhờ đức tin nơi quyền năng của Thiên Chúa, Đấng đã khiến Ngài sống lại từ cõi chết. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />Về phần anh chị em, đang khi chết mất trong những vi phạm và trong tình trạng xác thịt chưa cắt bì của mình, thì Ngài đã làm cho anh chị em cùng sống với Ngài, vì đã tha thứ mọi vi phạm cho chúng ta, <note caller="+" style="f"><char style="ft" closed="false">Một số phiên bản cũ hơn đọc: </char><char style="fqa">và tha thứ cho anh chị em mọi vi phạm của anh chị em</char>.</note> <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />đã xóa sạch hồ sơ ghi chép về bản án chống nghịch chúng ta, đó vốn là điều đối địch với chúng ta, và Ngài đã cất nó khỏi giữa chúng ra, khi đóng đinh nó vào thập tự giá, <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />truất phế các thế lực và thẩm quyền, Ngài đã khiến chúng làm trò cười cho thiên hạ, khi chiến thắng chúng trên thập tự giá.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />Vậy nên, đừng để ai đoán xét anh chị em về món ăn và về thức uống, hoặc trong khía cạnh của ngày lễ, ngày trăng mới, hay ngày Sa-bát, <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />mà chúng chỉ là cái bóng của những điều sắp đến, còn thực thể thuộc về Chúa Cứu Thế. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Đừng để kẻ nào làm anh chị em mất đi phần thưởng, khi tỏ ra yêu thích vẻ khiêm nhường và sự thờ lạy thiên sứ, dựa vào những gì bản thân đã nhìn thấy, trở nên ngạo mạn cách vô lý bởi suy nghĩ theo xác thịt của mình, <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />và chẳng gắn chặt với Đầu, mà từ nơi Ngài, toàn thân thông qua các khớp nối và dây chằng được cấp dưỡng và kết hiệp với nhau; thân thể ấy lớn lên với sức tăng trưởng đến từ Thiên Chúa.<verse eid="COL 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />Nếu anh chị em đã chết cùng với Chúa Cứu Thế, ra khỏi các nguyên tắc của thế gian, thì vì sao trong khi đang còn sống giữa thế gian, anh chị em lại phục dưới các lề lối của nó: <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />“Không cầm, không nếm, không sờ!” <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />tức là những nguyên tắc mà cả thảy đều dẫn đến sự hủy hoại khi áp dụng, theo các giới luật và giáo huấn của loài người? <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />Bất luận đó là việc gì, dù chứa đựng dáng vẻ khôn ngoan trong lễ nghi tự lập ra, cùng sự bình dị và khắc khổ của thân xác, thì chẳng có bất kỳ giá trị nào chống lại tham muốn của xác thịt.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />Thế nên, nếu anh chị em đã được làm cho sống lại với Chúa Cứu Thế, thì hãy tìm kiếm những điều ở trên trời, nơi Chúa Cứu Thế đang ngồi bên phải Thiên Chúa. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />Hãy hướng tâm trí đến những điều ở trên trời, không phải những thứ ở trên đất. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Vì anh chị em đã chết, và sự sống anh chị em đã được giấu với Chúa Cứu Thế trong Thiên Chúa. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />Khi Chúa Cứu Thế, là sự sống của anh chị em, xuất hiện, thì anh chị em cũng sẽ xuất hiện với Ngài trong vinh hiển.<note caller="+" style="f"><char style="ft" closed="false">Một số phiên bản đọc: </char><char style="fqa">Khi Chúa Cứu Thế, sự sống của chúng ta, xuất hiện, thì anh chị em cũng sẽ xuất hiện với Ngài trong vinh hiển</char>.</note><verse eid="COL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />Vậy nên, hãy làm chết các phần dưới đất — như gian dâm, ô uế, dục vọng, ham muốn xấu xa, và tham lam, mà tham lam là thờ hình tượng, <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />vì những điều này mà cơn thịnh nộ của Thiên Chúa đang đến, <note caller="+" style="f"><char style="ft" closed="false">Một số cổ bản thêm: </char><char style="fqa">trên các con cái không vâng lời</char>.</note> <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />mà trước kia, anh chị em cũng đã bước đi trong những điều ấy, khi anh chị em còn sống trong chúng. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />Nhưng giờ đây anh chị em phải loại bỏ mọi điều này — như giận dỗi, nóng nảy, tà ý, lăng mạ, cùng lời tục tĩu ra từ miệng mình. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />Đừng nói dối nhau, vì đã lột bỏ con người cũ cùng các lề thói của nó, <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />và đã mặc vào con người mới, tức là người đang được làm mới trong sự hiểu biết theo hình ảnh của Đấng tạo dựng nó, <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />là nơi mà không có người Hy Lạp và người Do Thái, người cắt bì và người không cắt bì, người kém văn minh, người Sy-the, người nô lệ, người tự chủ, nhưng Chúa Cứu Thế là mọi sự, và trong mọi sự.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />Vậy nên, như kẻ được chọn của Thiên Chúa, là người thánh và được yêu quý, hãy mặc lấy lòng thương cảm, tử tế, khiêm nhường, hiền hòa, kiên nhẫn, <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />chịu đựng nhau và tha thứ nhau, giả như ai đó có điều phàn nàn với người khác, thì như Chúa đã tha thứ anh chị em thể nào, anh chị em cũng cần phải như thể ấy. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />Nhưng trên mọi điều ấy, phải mặc lấy tình yêu thương, tức là mối liên kết của sự toàn hảo. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />Hãy để sự bình an của Chúa Cứu Thế cai trị trong lòng anh chị em, mà anh chị em cũng đã được gọi đến sự bình an đó trong một thân thể và hãy bày tỏ lòng biết ơn. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />Hãy để cho lời Chúa Cứu Thế ngự trong anh chị em cách dồi dào, khi dạy dỗ bằng tất cả sự khôn sáng, khích lệ nhau bằng các thi thiên, các bài thánh ca và các linh khúc, hát xướng với sự biết ơn trong lòng mình dành cho Thiên Chúa. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Mọi việc mà anh chị em làm, dù bằng lời nói hay bằng hành động, hãy làm tất cả trong danh Chúa, là Chúa Giê-xu, thông qua Ngài cảm tạ Thiên Chúa, là Cha.<verse eid="COL 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />Người làm vợ, hãy thuận phục chồng mình, như đó là điều xứng hợp trong Chúa. <verse eid="COL 3:18" /><verse number="19" style="v" sid="COL 3:19" />Người làm chồng, hãy yêu vợ mình, và đừng gay gắt với vợ. <verse eid="COL 3:19" /><verse number="20" style="v" sid="COL 3:20" />Người làm con, hãy vâng lời cha mẹ mình trong mọi việc, vì đây là điều đẹp lòng Chúa. <verse eid="COL 3:20" /><verse number="21" style="v" sid="COL 3:21" />Người làm cha, chớ chọc tức con cái mình, để chúng không ngã lòng. <verse eid="COL 3:21" /><verse number="22" style="v" sid="COL 3:22" />Người làm tôi tớ, hãy vâng lời chủ mình về phần xác trong mọi việc, không phải với sự giám sát của chủ như mấy kẻ hay lấy lòng người ta, nhưng với lòng thành thật, kính sợ Chúa. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Dầu anh chị em làm một điều gì, hãy thực hiện từ nơi tâm hồn như thể cho Chúa mà không phải cho người ta, <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />vì biết rằng mình sẽ nhận phần thưởng về cơ nghiệp mình từ nơi Chúa. Anh chị em đang làm tôi tớ cho Chúa, chính là Chúa Cứu Thế. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />Bởi người nào làm điều bất chính sẽ nhận lại điều mà người đó đã làm cách bất chính, và không có sự thiên vị.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />Người làm chủ, hãy đem đến cho các tôi tớ của mình điều ngay thẳng và công bằng, vì biết rằng mình cũng có một Chủ trên trời.<verse eid="COL 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Hãy bền đỗ trong sự cầu nguyện, khi tỉnh thức trong việc làm này bằng sự tạ ơn, <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />cũng như hiệp nhau cầu thay cho chúng tôi, hầu cho Thiên Chúa mở cho chúng tôi cánh cửa của việc giảng đạo, để nói ra sự huyền nhiệm về Chúa Cứu Thế, cũng vì huyền nhiệm đó mà tôi bị xiềng xích, <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />sao cho tôi có thể trình bày huyền nhiệm ấy cách rõ ràng, như tôi phải nói. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />Hãy ăn ở trong sự khôn ngoan đối với người ngoài, khi tận dụng thì giờ. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Lời nói anh chị em phải luôn có ân hậu, khi nêm muối vào, để biết điều ấy cần thiết cho anh chị em ra sao để đối đáp với mỗi một người.<verse eid="COL 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />Mọi việc liên quan đến tôi, thì một người anh em yêu dấu, một tôi tớ trung thành, và một người đồng lao trong Chúa, là Ti-chi-cơ sẽ tỏ cho anh chị em biết, <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />anh ấy là người mà tôi sai đến gặp anh chị em vì lý do này, đó là để anh chị em biết tình cảnh về chúng tôi, và để anh ấy có thể khích lệ lòng anh chị em, <note caller="+" style="f"><char style="ft" closed="false">Một số phiên bản cổ hơn đọc: </char><char style="fqa">Tôi phái cậu ấy đến gặp anh chị em vì việc này, để cậu ấy biết tình cảnh của anh chị em, cũng như để cậu ấy khích lệ lòng anh chị em</char>.</note> <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />đi cùng là Ô-nê-sim, người anh em trung tín và yêu dấu, anh ấy có xuất thân từ anh chị em, họ sẽ cho anh chị em biết mọi việc ở đây.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />A-ri-tạt, bạn tù của tôi, chào thăm anh chị em, cùng với Mác, em họ của Ba-na-ba (anh chị em đã nhận được lời căn dặn về anh ấy; nếu anh ấy đến với anh chị em, thì hãy tiếp đón anh ấy), <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />cũng như Giê-su, người được gọi là Giúc-tu nữa. Trong những người có xuất thân là người đã cắt bì, họ là các bạn đồng lao duy nhất cùng tôi vì vương quốc của Thiên Chúa, họ là niềm an ủi cho tôi. <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" />Ê-pháp-ra chào thăm anh chị em, anh ấy ra từ anh chị em, là một đầy tớ của Chúa Cứu Thế Giê-xu, khi luôn chiến đấu vì anh chị em trong sự cầu nguyện, để anh chị em được làm cho vững vàng, trưởng thành, và tin quyết trong mọi ý muốn của Thiên Chúa. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Vì tôi làm chứng về anh ấy, rằng anh ấy đã chịu khó nhọc rất nhiều vì anh chị em, cũng như vì các tín hữu tại Lao-đi-xê và tại Hi-ê-ra-bô-li. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />Lu-ca, người thầy thuốc yêu quý, cùng Đê-ma, chào thăm anh chị em. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />Xin chào thăm các anh chị em tại Lao-đi-xê, và Nim-pha, cùng hội thánh nhóm tại nhà của chị ấy. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />Khi bức thư này đã được đọc xong giữa vòng anh chị em, phải chắc rằng nó cũng được đọc tại Hội thánh Lao-đi-xê, và chắc rằng anh chị em cũng cần đọc thư từ Lao-đi-xê nữa. <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />Xin nói với A-chíp, rằng: “Hãy chú tâm vào chức vụ mà anh đã nhận trong Chúa, để anh có thể chu toàn chức vụ đó.”<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />Lời chào này do chính tay tôi — Phao-lô. Hãy nhớ đến các xiềng xích của tôi. Nguyện ân điển ở cùng anh chị em.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>