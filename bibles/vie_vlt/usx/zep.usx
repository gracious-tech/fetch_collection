<usx version="3.0">
  <book code="ZEP" style="id">EN_VLT vi_Vietnamese_ltr Thu Apr 25 2024 14:26:05 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Zephaniah</para>
  <para style="toc1">Sách Sô-phô-ni</para>
  <para style="toc2">Sô-phô-ni</para>
  <para style="toc3">Zep</para>
  <para style="mt">Sô-phô-ni</para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />Lời của Chúa Hằng Hữu, tức là lời đã đến với Sô-phô-ni, con trai Cu-si, cháu Ghê-đa-lia, chắt A-ma-ria, chít Ê-xê-chia, trong đời Giô-si-a, con trai A-môn, vua Giu-đa:<verse eid="ZEP 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2" />“Ta sẽ đặt dấu chấm hết để quét sạch mọi thứ trên mặt đất” — đây là lời tuyên phán của Chúa Hằng Hữu.<verse eid="ZEP 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3" />“Ta sẽ quét sạch người lẫn thú;</para>
  <para style="q2" vid="ZEP 1:3">Ta sẽ quét sạch chim trời cùng cá biển</para>
  <para style="q1" vid="ZEP 1:3">và những cớ gây vấp phạm cùng với kẻ gian ác,</para>
  <para style="q2" vid="ZEP 1:3">và Ta sẽ diệt trừ loài người trên mặt đất”</para>
  <para style="q1" vid="ZEP 1:3">— đây là lời tuyên phán của Chúa Hằng Hữu.<verse eid="ZEP 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4" />“Ta sẽ dang tay mình chống nghịch với Giu-đa</para>
  <para style="q2" vid="ZEP 1:4">và chống nghịch mọi kẻ đang sống tại Giê-ru-sa-lem,</para>
  <para style="q1" vid="ZEP 1:4">Ta sẽ diệt trừ khỏi nơi này phần sót lại của Ba-anh,</para>
  <para style="q2" vid="ZEP 1:4">danh xưng của bọn tu sĩ thờ thần tượng cùng với các thầy tế lễ,<verse eid="ZEP 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5" />những kẻ ở trên mái nhà</para>
  <para style="q2" vid="ZEP 1:5">cúi lạy binh đoàn trên các tầng trời,</para>
  <para style="q1" vid="ZEP 1:5">và những kẻ quỳ xuống</para>
  <para style="q2" vid="ZEP 1:5">thề thốt với Chúa Hằng Hữu nhưng cũng thề nhân danh Minh-côm,<verse eid="ZEP 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6" />những kẻ quay lưng dang xa khỏi Chúa Hằng Hữu,</para>
  <para style="q2" vid="ZEP 1:6">và những kẻ chẳng tìm kiếm Chúa Hằng Hữu, cũng chẳng cầu khẩn Ngài.”<verse eid="ZEP 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7" />Hãy im lặng trước mặt Chúa, là Chúa Hằng Hữu,</para>
  <para style="q2" vid="ZEP 1:7">vì ngày của Chúa Hằng Hữu đã gần.</para>
  <para style="q1" vid="ZEP 1:7">Bởi Chúa Hằng Hữu đã chuẩn bị một sinh tế,</para>
  <para style="q2" vid="ZEP 1:7">Ngài đã biệt riêng những khách mời của mình.<verse eid="ZEP 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8" />“Việc sẽ xảy ra vào ngày dâng sinh tế của Chúa Hằng Hữu,</para>
  <para style="q2" vid="ZEP 1:8">ấy là Ta sẽ thăm phạt nơi các tướng lĩnh và nơi các vương tử</para>
  <para style="q2" vid="ZEP 1:8">cùng mọi kẻ mặc y phục ngoại quốc,<verse eid="ZEP 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9" />Ta cũng sẽ thăm phạt trên tất cả những kẻ nhảy qua ngạch cửa trong ngày đó,</para>
  <para style="q2" vid="ZEP 1:9">những kẻ khiến nhà của chủ mình đầy dẫy sự hung bạo và lừa dối.<verse eid="ZEP 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10" />Việc sẽ xảy ra vào ngày đó”</para>
  <para style="q2" vid="ZEP 1:10">— đây là lời tuyên phán của Chúa Hằng Hữu —</para>
  <para style="q1" vid="ZEP 1:10">“ấy là âm thanh ồn ào của tiếng gào thét từ Cửa Cá,</para>
  <para style="q2" vid="ZEP 1:10">tiếng than van từ Quận Nhì,</para>
  <para style="q2" vid="ZEP 1:10">và tiếng va chạm mạnh từ vùng đồi núi.<verse eid="ZEP 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11" />Cư dân của Phố Chợ, hãy than khóc,</para>
  <para style="q2" vid="ZEP 1:11">vì toàn bộ giới thương buôn sẽ bị phá hủy,</para>
  <para style="q2" vid="ZEP 1:11">hết thảy những kẻ cân đo bạc sẽ bị diệt trừ.<verse eid="ZEP 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12" />Rồi việc sẽ xảy ra vào lúc đó,</para>
  <para style="q1" vid="ZEP 1:12">ấy là Ta sẽ lùng sục Giê-ru-sa-lem bằng đèn,</para>
  <para style="q2" vid="ZEP 1:12">và Ta sẽ thăm phạt trên bọn người đóng sệt ra lớp cặn rượu,</para>
  <para style="q1" vid="ZEP 1:12">tức là những kẻ nói trong lòng mình:</para>
  <para style="q2" vid="ZEP 1:12">‘Chúa Hằng Hữu sẽ chẳng ban phước, Ngài cũng sẽ chẳng giáng họa,’<verse eid="ZEP 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13" />còn của cải chúng sẽ thành của cướp,</para>
  <para style="q2" vid="ZEP 1:13">nhà chúng sẽ nên chốn hoang phế,</para>
  <para style="q1" vid="ZEP 1:13">và chúng sẽ xây nhà nhưng sẽ chẳng ở được,</para>
  <para style="q2" vid="ZEP 1:13">chúng sẽ trồng vườn nho nhưng sẽ chẳng uống rượu nho đó được.<verse eid="ZEP 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14" />Gần thay ngày trọng đại của Chúa Hằng Hữu,</para>
  <para style="q2" vid="ZEP 1:14">đến gần rồi và rất nhanh chóng!</para>
  <para style="q1" vid="ZEP 1:14">Âm thanh ngày của Chúa Hằng Hữu thật đắng cay,</para>
  <para style="q2" vid="ZEP 1:14">khi vang tiếng chiến binh khóc la vào lúc đó!<verse eid="ZEP 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15" />Ngày đó sẽ là ngày thịnh nộ,</para>
  <para style="q2" vid="ZEP 1:15">ngày nguy khốn và đớn đau,</para>
  <para style="q1" vid="ZEP 1:15">ngày tàn phá và đổ nát,</para>
  <para style="q2" vid="ZEP 1:15">ngày tối tăm và ảm đạm,</para>
  <para style="q1" vid="ZEP 1:15">ngày đầy mây và đen kịt,<verse eid="ZEP 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 1:16" />ngày của tiếng kèn hiệu và tiếng hô xung trận</para>
  <para style="q2" vid="ZEP 1:16">đánh vào các thành kiên cố và vào các tháp góc tường cao vút.<verse eid="ZEP 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17" />Vì Ta sẽ giáng đau khổ trên loài người,</para>
  <para style="q2" vid="ZEP 1:17">rồi chúng sẽ bước đi như kẻ mù,</para>
  <para style="q2" vid="ZEP 1:17">bởi chúng đã phạm tội chống nghịch Chúa Hằng Hữu.</para>
  <para style="q1" vid="ZEP 1:17">Huyết chúng sẽ bị đổ ra như bụi,</para>
  <para style="q2" vid="ZEP 1:17">và nội tạng chúng sẽ như phân.<verse eid="ZEP 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18" />Ngay cả bạc của chúng, thậm chí vàng của chúng sẽ chẳng thể nào giải cứu chúng</para>
  <para style="q2" vid="ZEP 1:18">trong ngày thịnh nộ của Chúa Hằng Hữu.”</para>
  <para style="q1" vid="ZEP 1:18">Bởi cớ lửa ghen tuông của Ngài, khắp cả đất sẽ bị thiêu đốt.</para>
  <para style="q2" vid="ZEP 1:18">Vì Ngài sẽ thực thi sự hủy diệt chắc chắn mau chóng</para>
  <para style="q2" vid="ZEP 1:18">cho tất cả cư dân trên đất.<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1" />Hãy cùng nhau tập hợp lại!</para>
  <para style="q2" vid="ZEP 2:1">Phải, này dân chẳng biết sợ, hãy tập hợp,<verse eid="ZEP 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2" />trước khi ban bố sắc lệnh,</para>
  <para style="q2" vid="ZEP 2:2">khiến ngày qua đi như trấu,</para>
  <para style="q1" vid="ZEP 2:2">trước khi cơn thịnh nộ phừng phừng của Chúa Hằng Hữu chưa giáng trên anh chị em,</para>
  <para style="q2" vid="ZEP 2:2">trước khi ngày thịnh nộ của Chúa Hằng Hữu chưa giáng trên anh chị em.<verse eid="ZEP 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3" />Hết thảy những ai nhu mì trên đất,</para>
  <para style="q2" vid="ZEP 2:3">là những người thực hiện mệnh lệnh của Ngài,</para>
  <para style="q1" vid="ZEP 2:3">hãy tìm kiếm Chúa Hằng Hữu.</para>
  <para style="q1" vid="ZEP 2:3">Hãy tìm kiếm sự công chính. Hãy tìm kiếm sự khiêm nhường.</para>
  <para style="q2" vid="ZEP 2:3">Biết đâu anh chị em sẽ được giấu kín trong ngày thịnh nộ của Chúa Hằng Hữu.<verse eid="ZEP 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4" />Vì Ga-xa sẽ trở nên nơi bị ruồng bỏ,</para>
  <para style="q2" vid="ZEP 2:4">và Ách-ca-lôn thì thành một chỗ hoang phế.</para>
  <para style="q1" vid="ZEP 2:4">Ách-đốt kia, người ta sẽ trục xuất nó lúc giữa trưa,</para>
  <para style="q2" vid="ZEP 2:4">và Éc-rôn sẽ bị nhổ bật gốc.<verse eid="ZEP 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5" />Khốn cho cư dân vùng ven biển,</para>
  <para style="q2" vid="ZEP 2:5">đất nước của dân Cơ-rết!</para>
  <para style="q1" vid="ZEP 2:5">Phán ngôn của Chúa Hằng Hữu chống lại các người,</para>
  <para style="q2" vid="ZEP 2:5">hỡi Ca-na-an, xứ của dân Phi-li-tin,</para>
  <para style="q1" vid="ZEP 2:5">“Ta sẽ tàn phá ngươi cho đến khi không còn cư dân.”<verse eid="ZEP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6" />Rồi vùng ven biển sẽ trở nên</para>
  <para style="q2" vid="ZEP 2:6">nơi sinh trưởng của những thảo nguyên cho các mục đồng, và nơi dựng chuồng cho bầy chiên.<verse eid="ZEP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7" />Vùng này sẽ thuộc về dân sót lại của nhà Giu-đa.</para>
  <para style="q1" vid="ZEP 2:7">Họ sẽ chăn bầy chiên tại các nơi ấy;</para>
  <para style="q2" vid="ZEP 2:7">vào chiều tối, họ sẽ nằm nghỉ trong những ngôi nhà của Ách-ca-lôn,</para>
  <para style="q1" vid="ZEP 2:7">vì Chúa Hằng Hữu, Thiên Chúa của họ, sẽ thăm viếng họ,</para>
  <para style="q2" vid="ZEP 2:7">và Ngài sẽ phục hồi sản nghiệp của họ.<verse eid="ZEP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8" />“Ta đã nghe lời nhạo báng của Mô-áp</para>
  <para style="q2" vid="ZEP 2:8">và lời sỉ vả của con cháu Am-môn,</para>
  <para style="q1" vid="ZEP 2:8">khi chúng chế giễu dân Ta</para>
  <para style="q2" vid="ZEP 2:8">và hống hách xâm phạm biên giới của họ.<verse eid="ZEP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9" />Vì vậy, thật như Ta hằng sống” —</para>
  <para style="q2" vid="ZEP 2:9">đây là lời tuyên phán nơi Chúa Hằng Hữu của các đạo binh, Thiên Chúa của Y-sơ-ra-ên —</para>
  <para style="q1" vid="ZEP 2:9">rằng “Mô-áp sẽ giống Sô-đôm,</para>
  <para style="q2" vid="ZEP 2:9">và con cháu Am-môn sẽ như Gô-mô-rơ,</para>
  <para style="q1" vid="ZEP 2:9">một mảnh đất đầy cỏ dại và hầm muối,</para>
  <para style="q2" vid="ZEP 2:9">một nơi hoang phế mãi mãi.</para>
  <para style="q1" vid="ZEP 2:9">Phần sót lại nơi dân của Ta sẽ cướp bóc chúng,</para>
  <para style="q2" vid="ZEP 2:9">và số còn lại của nước Ta sẽ chiếm hữu chúng.”<verse eid="ZEP 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEP 2:10" />Việc ấy đến trên chúng đáp lại tính kiêu căng của chúng,</para>
  <para style="q2" vid="ZEP 2:10">vì chúng đã chế nhạo và hống hách</para>
  <para style="q2" vid="ZEP 2:10">chống lại dân thuộc Chúa Hằng Hữu của các đạo binh.<verse eid="ZEP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11" />Chúa Hằng Hữu thật đáng kinh sợ đối với chúng,</para>
  <para style="q2" vid="ZEP 2:11">vì Ngài sẽ bỏ đói tất cả các thần trên đất.</para>
  <para style="q1" vid="ZEP 2:11">Rồi hết thảy các đảo quốc,</para>
  <para style="q2" vid="ZEP 2:11">mỗi người từ chỗ mình, sẽ quỳ xuống trước Ngài.<verse eid="ZEP 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12" />“Dân Cút các người cũng như vậy,</para>
  <para style="q2" vid="ZEP 2:12">là những kẻ sẽ bị đâm bởi gươm của Ta.”<verse eid="ZEP 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13" />Ngài sẽ dang tay mình nghịch với phương bắc,</para>
  <para style="q2" vid="ZEP 2:13">và Ngài sẽ hủy diệt A-ri-si.</para>
  <para style="q2" vid="ZEP 2:13">Rồi Ngài sẽ làm cho Ni-ni-ve trở nên một nơi hoang phế,</para>
  <para style="q2" vid="ZEP 2:13">một chốn khô cằn như sa mạc.<verse eid="ZEP 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14" />Các bầy súc vật, mọi loài thú của nước ấy</para>
  <para style="q2" vid="ZEP 2:14">sẽ nằm nghỉ ở giữa thành.</para>
  <para style="q1" vid="ZEP 2:14">Cả cú sa mạc lẫn cò vạc</para>
  <para style="q2" vid="ZEP 2:14">sẽ trú ngụ trên các đầu trụ.</para>
  <para style="q1" vid="ZEP 2:14">Tiếng kêu sẽ vang lên nơi cửa sổ;</para>
  <para style="q2" vid="ZEP 2:14">đống đổ nát ở nơi ngạch cửa;</para>
  <para style="q1" vid="ZEP 2:14">còn ván gỗ tuyết tùng thì tan hoang trơ trọi.<verse eid="ZEP 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15" />Đây là thành hoan lạc,</para>
  <para style="q2" vid="ZEP 2:15">thành sinh sống trong an ninh,</para>
  <para style="q2" vid="ZEP 2:15">thành tự nhủ trong lòng:</para>
  <para style="q2" vid="ZEP 2:15">“Chính ta, chẳng có ai khác ngoài ta.”</para>
  <para style="q1" vid="ZEP 2:15">Thể nào nó đã trở nên một phế tích,</para>
  <para style="q2" vid="ZEP 2:15">nơi trú ngụ dành cho loài thú.</para>
  <para style="q1" vid="ZEP 2:15">Hễ người nào đi ngang qua nó thì sẽ xuýt xoa khinh thường</para>
  <para style="q2" vid="ZEP 2:15">và xua tay mình chê bai.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1" />Khốn thay cho thành phản loạn và bị ô uế,</para>
  <para style="q2" vid="ZEP 3:1">thành phố tàn bạo kia!<verse eid="ZEP 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2" />Nó chẳng nghe tiếng phán;</para>
  <para style="q2" vid="ZEP 3:2">nó chẳng chịu sửa dạy.</para>
  <para style="q1" vid="ZEP 3:2">Nó chẳng tin cậy nơi Chúa Hằng Hữu;</para>
  <para style="q2" vid="ZEP 3:2">và nó chẳng đến gần với Thiên Chúa của mình.<verse eid="ZEP 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3" />Các tướng lĩnh nó là đám sư tử gầm thét ở giữa nó.</para>
  <para style="q2" vid="ZEP 3:3">Các quan xét nó là lũ chó sói ban đêm;</para>
  <para style="q2" vid="ZEP 3:3">chúng chẳng còn gì gặm vào buổi sáng.<verse eid="ZEP 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4" />Các tiên tri nó thật huênh hoang, là những kẻ xảo trá.</para>
  <para style="q2" vid="ZEP 3:4">Các thầy tế lễ nó báng bổ nơi thánh; chúng vi phạm luật pháp.<verse eid="ZEP 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5" />Chúa Hằng Hữu công chính ở giữa thành.</para>
  <para style="q2" vid="ZEP 3:5">Ngài không làm điều bất chính.</para>
  <para style="q1" vid="ZEP 3:5">Buổi sáng này đến buổi sáng kia, Ngài thi hành công lý của Ngài;</para>
  <para style="q2" vid="ZEP 3:5">dưới ánh sáng, Ngài chẳng hề thất bại.</para>
  <para style="q1" vid="ZEP 3:5">Nhưng kẻ bất chính chẳng biết xấu hổ.<verse eid="ZEP 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6" />“Ta đã diệt trừ các nước, các tháp góc tường của chúng đã bị đánh đổ;</para>
  <para style="q2" vid="ZEP 3:6">Ta đã hủy phá các đường phố chúng nó, chẳng một ai đi ngang qua.</para>
  <para style="q1" vid="ZEP 3:6">Các thành của chúng bị hoang phế, không có một người,</para>
  <para style="q2" vid="ZEP 3:6">hoàn toàn vắng cư dân.<verse eid="ZEP 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7" />Ta đã nói: ‘Hẳn là con sẽ kính sợ Ta; con sẽ chịu sửa dạy.</para>
  <para style="q2" vid="ZEP 3:7">Rồi chỗ ở của nó sẽ không bị hủy diệt</para>
  <para style="q2" vid="ZEP 3:7">bởi mọi thứ mà Ta đã định trên nó.’</para>
  <para style="q1" vid="ZEP 3:7">Dầu vậy, chúng nó đã dậy sớm,</para>
  <para style="q2" vid="ZEP 3:7">làm mọi công việc của mình ra đồi bại.<verse eid="ZEP 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8" />Vậy nên, hãy đợi Ta” — đây là lời tuyên phán của Chúa Hằng Hữu —</para>
  <para style="q2" vid="ZEP 3:8">“trong ngày trỗi dậy của Ta để bắt mồi.</para>
  <para style="q1" vid="ZEP 3:8">Vì phán quyết của Ta là gom các dân lại,</para>
  <para style="q2" vid="ZEP 3:8">để Ta nhóm họp các vương quốc,</para>
  <para style="q1" vid="ZEP 3:8">hầu cho trút đổ trên chúng nó cơn giận của Ta —</para>
  <para style="q2" vid="ZEP 3:8">toàn bộ cơn thịnh nộ phừng phừng của Ta.</para>
  <para style="q1" vid="ZEP 3:8">Vì với lửa ghen tuông của Ta,</para>
  <para style="q2" vid="ZEP 3:8">toàn cõi đất sẽ bị thiêu nuốt.<verse eid="ZEP 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9" />Sau đó, Ta chắc chắn sẽ ban cho các dân tộc môi miệng thanh sạch,</para>
  <para style="q2" vid="ZEP 3:9">để tất cả họ kêu cầu danh của Chúa Hằng Hữu,</para>
  <para style="q2" vid="ZEP 3:9">để kề vai hiệp nhất phục vụ Ngài.<verse eid="ZEP 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10" />Từ bên kia các sông của Cút, những người thờ phượng Ta,</para>
  <para style="q2" vid="ZEP 3:10">con gái dân bị phân tán của Ta,</para>
  <para style="q2" vid="ZEP 3:10">sẽ đem lễ vật cho Ta.<verse eid="ZEP 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11" />Trong ngày ấy, con sẽ không bị xấu hổ vì mọi việc làm của mình, là những tội con đã phạm chống nghịch Ta,</para>
  <para style="q2" vid="ZEP 3:11">vì lúc đó Ta sẽ loại bỏ khỏi giữa con những kẻ vui thích sự kiêu căng của con,</para>
  <para style="q2" vid="ZEP 3:11">và con sẽ không còn tiếp tục ngạo mạn trên núi thánh của Ta.<verse eid="ZEP 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12" />Ta sẽ chừa lại giữa con một dân nghèo thiếu và non kém,</para>
  <para style="q2" vid="ZEP 3:12">mà họ sẽ đặt niềm trông cậy nơi danh Chúa Hằng Hữu.<verse eid="ZEP 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13" />Dân sót lại của Y-sơ-ra-ên sẽ không làm điều bất chính hoặc nói lời dối trá,</para>
  <para style="q2" vid="ZEP 3:13">và lưỡi lừa lọc sẽ không tìm được nơi miệng họ.</para>
  <para style="q1" vid="ZEP 3:13">Trái lại, họ sẽ ăn rồi nằm nghỉ, và sẽ chẳng có ai khiến họ sợ hãi.”<verse eid="ZEP 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14" />Hãy hát lên, con gái Si-ôn ơi!</para>
  <para style="q2" vid="ZEP 3:14">Hãy hô vang, Y-sơ-ra-ên ơi!</para>
  <para style="q1" vid="ZEP 3:14">Hãy hết lòng vui mừng và hoan hỉ,</para>
  <para style="q2" vid="ZEP 3:14">hỡi con gái Giê-ru-sa-lem!<verse eid="ZEP 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15" />Chúa Hằng Hữu đã cất bỏ những án phạt của nàng;</para>
  <para style="q2" vid="ZEP 3:15">Ngài đã khiến các kẻ thù nàng trở lui!</para>
  <para style="q1" vid="ZEP 3:15">Chúa Hằng Hữu, Vua của Y-sơ-ra-ên, ở giữa nàng.</para>
  <para style="q2" vid="ZEP 3:15">Nàng sẽ chẳng bao giờ sợ tai họa nữa!<verse eid="ZEP 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16" />Trong ngày đó, người ta sẽ nói với Giê-ru-sa-lem:</para>
  <para style="q1" vid="ZEP 3:16">“Si-ôn ơi, đừng sợ!</para>
  <para style="q2" vid="ZEP 3:16">Chớ buông lỏng tay mình.<verse eid="ZEP 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17" />Chúa Hằng Hữu, Thiên Chúa của nàng, ở giữa nàng;</para>
  <para style="q2" vid="ZEP 3:17">Đấng Quyền Năng, Ngài sẽ cứu giúp.</para>
  <para style="q1" vid="ZEP 3:17">Ngài sẽ hân hoan vì cớ nàng với niềm vui sướng;</para>
  <para style="q2" vid="ZEP 3:17">Ngài sẽ vỗ về bằng tình yêu của Ngài;</para>
  <para style="q1" vid="ZEP 3:17">Ngài sẽ hoan hỉ vì cớ nàng trong tiếng reo vui.”<verse eid="ZEP 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18" />“Ta sẽ tập hợp những người ưu sầu vì cớ buổi lễ trọng thể, chúng ra từ con;</para>
  <para style="q2" vid="ZEP 3:18">sự sỉ nhục là gánh nặng trên nó.<verse eid="ZEP 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19" />Nhìn xem, Ta sắp xử lý với hết thảy những kẻ áp bức con vào lúc đó.</para>
  <para style="q2" vid="ZEP 3:19">Rồi Ta sẽ cứu giúp người què và nhóm lại người bị ruồng bỏ.</para>
  <para style="q1" vid="ZEP 3:19">Ta cũng sẽ đổi sự xấu hổ của họ thành lời tán dương,</para>
  <para style="q2" vid="ZEP 3:19">và nên danh tiếng trên khắp cả đất.<verse eid="ZEP 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20" />Khi ấy, Ta sẽ đem các con vào,</para>
  <para style="q2" vid="ZEP 3:20">là thời điểm của Ta nhóm hiệp các con.</para>
  <para style="q1" vid="ZEP 3:20">Sau đó, Ta sẽ ban cho các con danh tiếng và sự khen ngợi giữa vòng tất cả các dân trên đất,</para>
  <para style="q2" vid="ZEP 3:20">khi Ta phục hồi sản nghiệp của các con trước mắt các con.”</para>
  <para style="q1" vid="ZEP 3:20">Chúa Hằng Hữu đã phán.<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>