  <book code="1PE" style="id">EN_VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:25:43 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Peter</para>
  <para style="toc1">Thư Phi-e-rơ thứ nhất</para>
  <para style="toc2">1 Phi-e-rơ</para>
  <para style="toc3">1Pe</para>
  <para style="mt">1 Phi-e-rơ</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />Phi-e-rơ, sứ đồ của Chúa Cứu Thế Giê-xu, gửi cho những người được chọn giữa các kiều dân phân tán khắp nơi tại tỉnh Bông, Ga-la-ti, Cáp-ba-đốc, A-si và Bi-thi-ni, <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />theo sự biết trước của Thiên Chúa, là Cha, bởi sự biệt riêng của Thánh Linh cho sự vâng phục và sự rảy huyết của Chúa Cứu Thế Giê-xu. Nguyện xin ân điển và sự bình an được gia thêm dư dật trên anh chị em.<verse eid="1PE 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />Đáng chúc tụng thay Thiên Chúa và Cha của Chúa chúng ta, là Chúa Cứu Thế Giê-xu, Đấng tùy theo lòng thương xót lớn lao của Ngài, đã tái sinh chúng ta vào trong niềm hy vọng sống nhờ sự phục sinh của Chúa Cứu Thế Giê-xu từ cõi chết, <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />hướng về một cơ nghiệp không hư hoại, không ô uế và không phai tàn, đã được gìn giữ trên trời cho anh chị em, <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />là dành cho những người nhờ đức tin, được bảo vệ bởi quyền năng Thiên Chúa cho sự cứu rỗi, là điều sẵn sàng để được bày tỏ ra trong thời kỳ cuối cùng. <verse eid="1PE 1:5" /><verse number="6" style="v" sid="1PE 1:6" />Nhờ vậy, anh chị em rất vui mừng, cho dù hiện lúc này cần phải chịu buồn rầu ít lâu trong muôn kiểu thử thách <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />hầu cho sự chứng thực về đức tin của anh chị em — điều quý báu hơn vàng, là thứ bị hư nát mà còn chịu thử nghiệm bằng lửa — có thể được nhìn nhận để dẫn đến sự ngợi khen, vinh hiển và tôn quý trong sự hiện ra của Chúa Cứu Thế Giê-xu, <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />Đấng mà anh chị em yêu mến dù chưa thấy, hiện nay dẫu không thấy Ngài nhưng vì tin cậy nơi Ngài, nên anh chị em hân hoan với niềm vui khôn tả và được tràn đầy vinh hiển, <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />nhận lãnh kết quả nơi đức tin của anh chị em, ấy là sự cứu rỗi linh hồn. <verse eid="1PE 1:9" /><verse number="10" style="v" sid="1PE 1:10" />Các nhà tiên tri đã tìm hiểu và tra xét kỹ càng về sự cứu rỗi này, đó là những người đã tiên báo về ân điển dành cho anh chị em, <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />khi tìm hiểu về người nào hay khi nào mà Thánh Linh của Chúa Cứu Thế trong họ vốn đã bày tỏ, cho biết trước về sự thương khó của Chúa Cứu Thế và sự vinh hiển sau những việc ấy. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />Điều đã được bày tỏ cho họ, đó là họ vốn không phục vụ cho chính mình, nhưng cho anh chị em, về những điều mà giờ đây đã được công bố cho anh chị em qua những người rao giảng Phúc Âm cho anh chị em bởi Chúa Thánh Linh được sai phái từ trời — đối với những điều đó, các thiên sứ cũng ước ao nhìn thấy.<verse eid="1PE 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />Vì vậy, bằng cách chuẩn bị tâm trí anh chị em như thể thắt lưng, giữ tỉnh táo, hãy đặt trọn hy vọng vào ân điển được đem đến cho anh chị em trong sự hiện ra của Chúa Cứu Thế Giê-xu. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />Như con cái biết vâng lời, không chiều theo những dục vọng trước kia trong sự khinh lờn của anh chị em, <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />trái lại, y như Đấng đã kêu gọi anh chị em là thánh, chính anh chị em cũng phải được nên thánh trong toàn bộ cách ăn ở của mình. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />Vì có lời chép: “Các con sẽ nên thánh vì Ta là thánh.” <verse eid="1PE 1:16" /><verse number="17" style="v" sid="1PE 1:17" />Và nếu anh chị em gọi Đấng phân xử cách không thiên vị tùy theo công việc của mỗi người là “Cha”, thì hãy sống với lòng kính sợ trong thời gian tha hương của mình, <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />vì biết rằng chẳng phải nhờ những thứ có thể hư nát như bạc hoặc vàng mà anh chị em đã được chuộc ra khỏi nếp sống vô nghĩa của mình do cha ông truyền lại, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />nhưng là nhờ huyết báu của Chúa Cứu Thế, như chiên con không tì vết và không ô uế, <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />đã được định trước khi sáng thế, nhưng được tỏ ra trong thời kỳ cuối cùng này vì cớ anh chị em, <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />là những người nhờ Ngài tin nơi Thiên Chúa, Đấng đã khiến Ngài sống lại từ cõi chết và ban vinh quang cho Ngài, để đức tin và niềm hy vọng của anh chị em ở trong Thiên Chúa. <verse eid="1PE 1:21" /><verse number="22" style="v" sid="1PE 1:22" />Khi đã thanh tẩy linh hồn mình nhờ sự vâng phục chân lý hướng đến tình huynh đệ chân thành, anh chị em hãy yêu thương nhau cách sốt sắng với lòng thanh sạch,<note caller="+" style="f"><char style="ft" closed="false">Một số phiên bản cổ hơn đọc: </char><char style="fqa">Anh chị em đã khiến linh hồn mình được sạch bằng cách nhờ Chúa Thánh Linh mà vâng phục lẽ thật.</char></note> <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />vì đã được tái sinh, chẳng phải từ giống có thể hư nát, mà từ giống không thể hư nát, nhờ lời hằng sống và trường tồn của Thiên Chúa. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />Bởi vì:</para>
  <para style="q1" vid="1PE 1:24">“Mọi xác thịt giống như cỏ,</para>
  <para style="q1" vid="1PE 1:24">và mọi vinh quang của nó giống như hoa cỏ.</para>
  <para style="q1" vid="1PE 1:24">Cỏ khô, và hoa rụng,<verse eid="1PE 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1PE 1:25" />nhưng lời Chúa còn đến đời đời.”</para>
  <para style="m" vid="1PE 1:25">Đó là Phúc Âm đã được công bố cho anh chị em.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />Vậy nên, khi đã bỏ đi mọi điều tà ác, mọi điều gian dối và đạo đức giả, sự đố kỵ cùng mọi lời nói hành, <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />thì như các bé sơ sinh, hãy thèm khát sữa thiêng liêng tinh khiết, để nhờ đó anh chị em có thể được làm cho tăng trưởng cho đến sự cứu rỗi, <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />nếu anh chị em đã nếm biết rằng Chúa nhân lành, <verse eid="1PE 2:3" /><verse number="4" style="v" sid="1PE 2:4" />khi đến gần với Ngài, là hòn đá sống, đã bị người ta loại bỏ, nhưng lại là sự lựa chọn quý báu trước mặt Thiên Chúa, <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />và chính anh chị em, giống như những viên đá sống, đang được xây lên thành ngôi nhà thuộc linh, dành cho chức thầy tế lễ thánh để dâng sinh tế thuộc linh đẹp lòng Thiên Chúa qua Chúa Cứu Thế Giê-xu. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />Cho nên, nội dung này có viết trong Kinh Thánh:</para>
  <para style="q1" vid="1PE 2:6">“Nhìn này, Ta đặt tại Si-ôn một hòn đá góc,</para>
  <para style="q1" vid="1PE 2:6">được lựa chọn, rất quý giá.</para>
  <para style="q1" vid="1PE 2:6">Và ai tin nơi Ngài chắc chắn không bị hổ thẹn.”<verse eid="1PE 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7" />Vì vậy, sự tôn quý ấy dành cho anh chị em là những người tin. Còn đối với những kẻ không tin:</para>
  <para style="q1" vid="1PE 2:7">“Hòn đá mà các thợ xây loại bỏ,</para>
  <para style="q1" vid="1PE 2:7">đá ấy đã được trở thành đá chuẩn góc nhà”<verse eid="1PE 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 2:8" />và là</para>
  <para style="q1" vid="1PE 2:8">“Hòn đá gây vấp chân, tảng đá làm cho té ngã.”</para>
  <para style="p" vid="1PE 2:8">Họ vấp ngã vì không vâng theo lời Chúa, mà về chuyện này họ cũng đã được định sẵn rồi. <verse eid="1PE 2:8" /><verse number="9" style="v" sid="1PE 2:9" />Nhưng anh chị em là dòng giống được lựa chọn, là chức tế lễ hoàng gia, là dân tộc thánh, một dân thuộc quyền sở hữu của Thiên Chúa, để anh chị em rao báo những việc lạ lùng của Đấng đã gọi anh chị em ra khỏi bóng tối vào trong ánh sáng diệu kỳ của Ngài, <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />mà anh chị em trước kia “không phải là một dân”, nhưng nay là “dân của Thiên Chúa”; là những người từng “không được thương xót”, mà nay đã “được thương xót”.<verse eid="1PE 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />Anh chị em yêu dấu, tôi nài khuyên anh chị em, như những kiều dân và khách tha hương, phải trách xa các dục vọng xác thịt, là thứ tranh chiến nghịch với linh hồn anh chị em, <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />khi giữ cách ăn ở của anh chị em cho ngay lành giữa vòng những người ngoại quốc, để rồi, trong điều gì họ nói xấu về anh chị em như những kẻ làm ác, thì bởi quan sát các việc lành của anh chị em, họ có thể chúc tụng Thiên Chúa trong ngày Ngài viếng thăm.<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />Vì cớ Chúa, hãy thuận phục mọi thẩm quyền con người, có thể đó là vua như người nắm quyền tối cao, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />hoặc các quan tổng đốc, như những người được vua sai phái đem đến sự trừng phạt kẻ làm ác và sự khen thưởng người làm lành. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />Vì đây là ý muốn của Thiên Chúa: làm việc lành để khiến cho những con người dại dột ăn nói thiếu hiểu biết phải ngậm miệng, <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />trong tâm thế như những người tự do, và chẳng dùng sự tự do của mình như màn che cho việc ác, nhưng như những tôi tớ của Thiên Chúa. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />Hãy tôn trọng mọi người. Hãy yêu thương anh chị em mình. Phải kính sợ Thiên Chúa. Phải tôn trọng vua.<verse eid="1PE 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />Này các anh chị em làm gia nhân, cần thuận phục chủ mình với tất cả lòng kính trọng, chẳng phải chỉ người chủ tốt và hiền từ, mà còn người chủ khắc nghiệt nữa. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />Vì hễ ai chịu đựng đau khổ trong khi trải nghiệm sự bất công bởi cớ lương tâm hướng về Thiên Chúa, thì đó là một ơn phước. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />Có vẻ vang gì nếu phạm tội rồi anh chị em phải chịu bị đánh đập? Nhưng nếu làm lành rồi anh chị em phải chịu đựng trải nghiệm khốn khó, thì đó là một ơn phước trước mặt Thiên Chúa. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />Vì anh chị em đã được kêu gọi cho điều ấy, bởi Chúa Cứu Thế cũng đã chịu khổ thay anh chị em, để lại một gương cho anh chị em hầu cho anh chị em có thể noi theo bước chân Ngài,<verse eid="1PE 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1PE 2:22" />“Đấng không phạm tội,</para>
  <para style="q1" vid="1PE 2:22">cũng chẳng có lời dối trá nào được tìm thấy nơi miệng Ngài”;<verse eid="1PE 2:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="1PE 2:23" />là Đấng khi bị mắng nhiếc, Ngài không mắng nhiếc lại; khi chịu khổ, Ngài không đe dọa, mà Ngài phó mình cho Đấng xét đoán công bình; <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />chính Đấng ấy đã mang tội lỗi chúng ta trong thân thể Ngài lên cây gỗ, để sau khi đã chết đối với tội lỗi, chúng ta có thể sống cho sự công chính, nhờ những thương tích của Ngài mà anh chị em đã được chữa lành. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />Vì anh chị em vốn như chiên bị lạc, nhưng nay anh chị em đã được trở về với Đấng chăn chiên và Vị Giám Mục của linh hồn mình.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />Thưa các chị em là những người vợ, cũng như vậy, cần thuận phục chồng mình, để thậm chí nếu một số người chồng không vâng theo đạo, nhưng nhờ cách ăn ở của vợ tuy không dùng lời nói, thì những người chồng ấy sẽ được chinh phục, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />sau khi chứng kiến nếp sống tinh sạch cùng với sự cung kính của các chị em, <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />mà trang sức của các chị em không phải ở bề ngoài bện tóc và đeo đồ vàng, hoặc ăn diện quần áo sang trọng, <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />nhưng là tấm lòng con người bề trong, với vẻ đẹp trường tồn của tinh thần dịu dàng và yên lặng, điều đó là quý giá trước mặt Thiên Chúa. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />Vì các thánh nữ xưa kia, là những người đặt hy vọng nơi Thiên Chúa, cũng đã trang điểm bản thân như vậy khi thuận phục chồng mình, <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />như Sa-ra đã vâng lời Áp-ra-ham khi gọi ông là chúa, các chị em được trở nên con cháu của bà khi làm lành và không e ngại bất kỳ nỗi kinh sợ nào.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />Thưa các anh em là những người chồng, cũng như vậy, bằng sự hiểu biết, cần phải chung sống với vợ như với phái yếu hơn, đồng thời san sẻ sự tôn quý như người cùng dự phần ân điển của sự sống, hầu cho sự cầu nguyện của anh em không bị ngăn trở.<verse eid="1PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />Sau cùng, hết thảy cần có đồng tâm trí, sự cảm thông, tình anh chị em thân ái, lòng nhân hậu, sự khiêm nhường, <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />đừng lấy ác trả ác, hay lời xúc phạm đáp lại lời xúc phạm, mà trái lại, cứ chúc lành, vì anh chị em đã được gọi đến điều đó, để anh chị em được hưởng phước lành.<verse eid="1PE 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1PE 3:10" />Vì,</para>
  <para style="q1" vid="1PE 3:10">“Ai muốn yêu sự sống và thấy ngày tháng tốt lành</para>
  <para style="q2" vid="1PE 3:10">phải ngăn chặn lưỡi mình khỏi điều ác, và môi mình chẳng nói điều gian dối.<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />Người ấy phải xoay khỏi điều dữ và phải thực hiện điều lành.</para>
  <para style="q1" vid="1PE 3:11">Người ấy phải mưu cầu hòa bình và phải đeo đuổi điều đó, <verse eid="1PE 3:11" /><verse number="12" style="v" sid="1PE 3:12" />vì</para>
  <para style="q1" vid="1PE 3:12">mắt Chúa ở trên người công chính và tai Ngài ở gần lời cầu xin của họ,</para>
  <para style="q2" vid="1PE 3:12">nhưng mặt Chúa nghịch lại kẻ làm ác.”<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />Ai là kẻ sẽ hãm hại anh chị em nếu anh chị em trở nên những người sốt sắng về điều lành? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />Tuy nhiên, cho dù anh chị em thậm chí phải chịu khổ vì sự công chính, thì anh chị em thật có phước. Mặt khác, đừng bị kinh hãi theo nỗi sợ của họ, cũng đừng bị nao núng, <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />mà hãy tôn thánh Chúa Cứu Thế, là Chúa trong lòng mình, luôn luôn sẵn sàng cho việc đối đáp bất cứ ai chất vấn anh chị em lý do cho niềm hy vọng trong anh chị em, <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />nhưng với sự ôn hòa và tôn trọng, vì có một lương tâm tốt, để trong điều gì mà anh chị em bị vu cáo, thì những kẻ sỉ nhục nếp sống thiện lành của anh chị em trong Chúa Cứu Thế phải xấu hổ. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />Vì nếu là ý Thiên Chúa muốn, thì thà chịu khổ làm lành, hơn là làm ác. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />Bởi vì Chúa Cứu Thế cũng đã từng chịu khổ vì tội lỗi — Đấng công chính chết thay kẻ bất chính — để Ngài có thể đem chúng ta đến với Thiên Chúa, khi bị chết về phần xác mà được làm cho sống về phần tâm linh, <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />trong tâm linh đó, Ngài cũng đã rao giảng khi được đến với linh hồn trong ngục, <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />là những kẻ trước kia không vâng phục khi sự kiên nhẫn của Thiên Chúa vốn chờ đợi trong đời Nô-ê, đang khi con tàu được đóng, mà trong tàu ấy, vài người — đó là tám linh hồn — đã được cứu qua nước, <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />mà đây cũng là hình bóng hiện nay cứu rỗi anh chị em, tức là phép báp-têm — không phải việc loại bỏ bụi bẩn trên thân thể, nhưng là sự cam kết của một lương tâm tốt dành cho Thiên Chúa — nhờ sự phục sinh của Chúa Cứu Thế Giê-xu, <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />là Đấng, sau khi đi lên trời, đang ngự bên phải Thiên Chúa, mà các thiên sứ và các đấng có thẩm quyền cùng các thế lực đều thuận phục Ngài.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />Thế thì, vì Chúa Cứu Thế đã chịu khổ trong xác thịt, nên anh chị em cũng hãy chịu trang bị cùng tư tưởng ấy, bởi người nào đã chịu khổ trong xác thịt thì đã đoạn tuyệt với tội lỗi, <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />để suốt thời gian còn lại trong xác thịt, người ấy không còn sống cho dục vọng của con người nữa, nhưng cho ý muốn của Thiên Chúa. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />Vì thời gian đã trôi qua quá đủ để đạt được ý muốn của dân ngoại quốc, khi sống trong sự phóng đãng, mê tham, say xỉn, nhậu nhẹt, trác táng và thờ lạy hình tượng đáng kinh tởm, <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />mà trong chuyện này, họ bị kinh ngạc khi anh chị em không chạy theo họ trong cùng dòng thác lũ của sự trác táng trụy lạc, nên buông lời xúc phạm; <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />bọn họ sẽ đưa ra lời khai trình trước Đấng sẵn sàng phán xét người sống lẫn kẻ chết. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />Bởi vì điều đó, Phúc Âm cũng đã được rao giảng cho những người hiện chết rồi, để cho dù họ đã chịu đoán xét theo loài người trong xác thịt, thì nay họ có thể sống theo Thiên Chúa trong tâm linh.<verse eid="1PE 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />Mặt khác, sự cuối cùng của muôn vật đã đến gần. Vì vậy, hãy sáng suốt và tỉnh táo trình dâng các lời cầu nguyện; <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />khi trên hết có lòng yêu thương sốt sắng dành cho nhau, vì tình yêu thương sẽ che lấp vô số tội lỗi; <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />có lòng hiếu khách với nhau mà không chút phàn nàn; <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />và theo như mỗi người đã nhận ân tứ, sử dụng nó phục vụ cho nhau, khác nào những người quản lý giỏi đối với ân điển muôn hình vạn trạng của Thiên Chúa. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />Nếu ai thuyết giảng — thì như thể nói lời của Thiên Chúa; nếu ai phục vụ — thì thực hiện như bằng sức mà Thiên Chúa ban cho, để trong mọi sự Thiên Chúa được tôn vinh qua Chúa Cứu Thế Giê-xu, là Đấng đáng được vinh quang và quyền năng cho đến đời đời vô cùng. A-men.<verse eid="1PE 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />Anh chị em yêu dấu, đừng bị hoang mang về lò lửa hừng ở giữa anh chị em, khi xuất hiện nơi anh chị em để thử luyện, như thể điều khác lạ xảy đến cho mình, <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />trái lại, tùy theo anh chị em dự phần bao nhiêu vào những khổ nạn của Chúa Cứu Thế, thì hãy vui mừng bấy nhiêu, hầu cho trong sự bày tỏ vinh quang của Ngài, anh chị em được hân hoan, ngập tràn vui sướng. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />Nếu anh chị em bị sỉ nhục vì danh Chúa Cứu Thế, thì có phước thay, bởi Thánh Linh của sự vinh hiển và của Thiên Chúa, ngự trên anh chị em. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />Đừng ai trong anh chị em chịu khổ như kẻ giết người, kẻ trộm cắp, kẻ làm ác, hay như kẻ xen vào chuyện người khác, <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />nhưng nếu chịu khổ vì là Cơ Đốc nhân, thì người đó chớ xấu hổ, mà trong danh hiệu ấy hãy tôn vinh Thiên Chúa. <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />Bởi vì đã đến lúc bắt đầu sự phán xét từ nhà của Thiên Chúa; mà nếu trước tiên từ chúng ta, thì sự cuối cùng của những kẻ không vâng phục Phúc Âm của Thiên Chúa sẽ thế nào?<verse eid="1PE 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1PE 4:18" />Và “Nếu người công chính khó được cứu,</para>
  <para style="q1" vid="1PE 4:18">thì người không tin kính và kẻ có tội sẽ ở đâu?”<verse eid="1PE 4:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19" />Do đó, những ai chịu khổ theo ý muốn của Thiên Chúa hãy phó thác linh hồn mình cho Đấng Sáng Tạo thành tín trong việc làm lành.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />Vì vậy, tôi — cùng là trưởng lão và là nhân chứng về những khổ nạn của Chúa Cứu Thế, cũng là người dự phần vinh quang sắp được bày tỏ — nài khuyên các trưởng lão giữa vòng anh chị em: <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />Hãy chăn dắt bầy nhỏ của Thiên Chúa ở giữa anh em, thực hiện công tác chăm sóc — không làm cách miễn cưỡng, mà sẵn lòng tự nguyện tùy vào Thiên Chúa — cũng chẳng làm với tinh thần tham muốn lợi lộc nhưng làm cách sốt sắng vui mừng; <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />và cũng không làm như thể là ông chủ thống trị những người mà Thiên Chúa đã giao phó, thay vào đó, là trở nên tấm gương cho bầy nhỏ. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />Rồi sau khi Đấng Chăn Chiên Chí Cao được bày tỏ, anh em sẽ nhận lãnh vương miện vinh quang không phai tàn. <verse eid="1PE 5:4" /><verse number="5" style="v" sid="1PE 5:5" />Tương tự, các bạn trẻ ơi, hãy thuận phục các trưởng lão. Hết thảy phải mặc lấy sự khiêm nhường đối với nhau, vì Thiên Chúa chống cự kẻ kiêu ngạo, nhưng ban ân điển cho người khiêm nhường. <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />Vì vậy, hãy hạ mình xuống dưới tay quyền năng của Thiên Chúa để Ngài nâng anh chị em lên trong thời điểm phù hợp, <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />khi đã trao mọi lo âu của mình cho Ngài, vì Ngài chăm sóc anh chị em. <verse eid="1PE 5:7" /><verse number="8" style="v" sid="1PE 5:8" />Hãy tỉnh táo, hãy cảnh giác. Kẻ thù của anh chị em, là ma quỷ, giống như sư tử gầm thét, đang rảo quanh, tìm ai đó để cắn nuốt. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />Hãy chống cự nó, đứng vững trong đức tin, biết rằng cộng đồng tín hữu của mình trên khắp thế giới phải chịu cùng những khổ nạn như vậy. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />Nhưng khi đã chịu khổ ít lâu, Thiên Chúa của mọi ân điển, Đấng đã gọi anh chị em đến với vinh quang đời đời của Ngài trong Chúa Cứu Thế, chính Ngài sẽ phục hồi, củng cố, làm cho mạnh mẽ và kiên cường. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />Nguyện quyền thống trị thuộc về Ngài cho đến đời đời. A-men.<verse eid="1PE 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />Nhờ Sin-vanh, một người anh em trung tín theo cách tôi nhìn nhận, tôi đã viết cách vắn tắt cho anh chị em, khích lệ và xác chứng đây là ân điển chân thật của Thiên Chúa. Hãy đứng vững trong ân điển đó. <verse eid="1PE 5:12" /><verse number="13" style="v" sid="1PE 5:13" />Hội thánh tại Ba-by-lôn, hội được chọn như anh chị em, chào thăm anh chị em. Mác, con trai tôi, cũng thế. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />Hãy chào nhau bằng nụ hôn yêu thương.</para>
  <para style="p" vid="1PE 5:14">Nguyện xin sự bình an ở với hết thảy anh chị em là những người trong Chúa Cứu Thế.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>