<usx version="3.0">
  <book code="HAB" style="id">EN_VLT vi_Vietnamese_ltr Thu May 30 2024 17:09:27 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Habakkuk</para>
  <para style="toc1">Sách Ha-ba-cúc</para>
  <para style="toc2">Ha-ba-cúc</para>
  <para style="toc3">Hab</para>
  <para style="mt">Ha-ba-cúc</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="m">
    <verse number="1" style="v" sid="HAB 1:1" />Gánh nặng mà nhà tiên tri Ha-ba-cúc đã nhận thấy:<verse eid="HAB 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 1:2" />“Lạy Chúa Hằng Hữu, con kêu cứu mà Ngài chẳng lắng nghe cho đến bao giờ?</para>
  <para style="q" vid="HAB 1:2">Con kêu gào với Chúa: ‘Thật tàn bạo!’ nhưng Ngài không cứu giúp.<verse eid="HAB 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 1:3" />Sao Ngài bắt con chứng kiến điều gian ác và nhìn xem chuyện thương tâm?</para>
  <para style="q" vid="HAB 1:3">Cảnh hủy diệt và tàn bạo ở trước mắt con; xung đột xảy ra và tranh cãi nổi lên.<verse eid="HAB 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 1:4" />Vì thế, luật pháp bị tê liệt, và công lý chẳng khi nào lộ diện.</para>
  <para style="q" vid="HAB 1:4">Bởi kẻ ác bủa vây người công chính, thế là thứ công lý méo mó được đem ra dùng.”<verse eid="HAB 1:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="HAB 1:5" />“Hãy nhìn các nước và theo dõi; hãy kinh ngạc và sững sờ!</para>
  <para style="q" vid="HAB 1:5">Bởi Ta chắc chắn thực hiện một việc trong thời của các con mà các con sẽ không tin cho dù việc ấy được tường thuật lại.<verse eid="HAB 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 1:6" />Vì này, Ta sắp khiến cho dân Canh-đê trỗi dậy — một nước hung tợn và dữ dằn —</para>
  <para style="q" vid="HAB 1:6">đi tung hoàng khắp cả đất để chiếm lấy những nơi ở không phải thuộc về nó.<verse eid="HAB 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 1:7" />Nó ghê rợn và đáng sợ; phán quyết và quyền thế phát ra từ nó.<verse eid="HAB 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 1:8" />Bầy ngựa của nó lẹ làng hơn loài báo, nhanh nhẹn hơn lũ sói ban đêm.</para>
  <para style="q" vid="HAB 1:8">Thế nên lính kỵ của nó phi nước đại tiến tới,</para>
  <para style="q" vid="HAB 1:8">và các kỵ binh nó đến từ rất xa — bọn chúng bay như đại bàng, hăm hở để cắn nuốt.<verse eid="HAB 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 1:9" />Hết thảy dân nó tiến đến trong sự tàn bạo;</para>
  <para style="q" vid="HAB 1:9">mặt mày bọn nó hầm hầm hướng thẳng tới trước, và nó dồn tù binh giống như cát.<note caller="+" style="f"><char style="ft" closed="false">Văn bản tiếng Hy Bá Lai được dịch ở đây là </char><char style="fqa">các đám đông của chúng đi như gió hoang mạc</char> rất khó hiểu; nhiều bản hiện đại có những cách hiểu khác.</note><verse eid="HAB 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 1:10" />Vậy nên nó chế nhạo các vua, và giới cầm quyền chỉ là trò giễu cợt đối với nó.</para>
  <para style="q" vid="HAB 1:10">Nó chê cười mọi đồn lũy, vì nó đắp đất lên và chiếm lấy.<verse eid="HAB 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 1:11" />Rồi nó càng quét qua như gió và lấn tới — nó phạm tội, cho rằng sức mạnh trong nó là thần thánh của nó.”<verse eid="HAB 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="HAB 1:12" />“Lạy Chúa Hằng Hữu, là Thiên Chúa của con, Đấng Thánh của con, chẳng phải Ngài có từ đời đời sao? Chúng con sẽ không chết.</para>
  <para style="q" vid="HAB 1:12">Lạy Chúa Hằng Hữu, Ngài đã chỉ định dân ấy để thực thi việc phán xét, và, ôi Vầng Đá của con, Ngài đã lập ra nó để tiến hành việc sửa phạt.<verse eid="HAB 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 1:13" />Mắt Ngài quá tinh sạch để ngó xem điều dữ, và Ngài không thể nào nhìn vào việc làm sai trái cách vui thích;</para>
  <para style="q" vid="HAB 1:13">thế sao Ngài nhìn bọn phản bội như thể có thiện cảm?</para>
  <para style="q" vid="HAB 1:13">Vì sao Ngài lặng yên trong lúc kẻ ác nuốt chửng người công chính hơn nó?<verse eid="HAB 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 1:14" />Ngài khiến người ta giống như cá dưới biển, như loài sâu bọ chẳng có một kẻ cai quản trên chúng nó.<verse eid="HAB 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 1:15" />Nó kéo mọi người lên bằng móc câu;</para>
  <para style="q" vid="HAB 1:15">nó lôi người ta đi trong lưới mình;</para>
  <para style="q" vid="HAB 1:15">nó thâu người này kẻ kia lại trong chài của nó;</para>
  <para style="q" vid="HAB 1:15">cho nên nó vui mừng và sung sướng.<verse eid="HAB 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 1:16" />Bởi vậy, nó dâng sinh tế cho lưới của nó</para>
  <para style="q" vid="HAB 1:16">và thắp hương cho chài mình,</para>
  <para style="q" vid="HAB 1:16">vì nhờ lưới ấy mà phần nó béo bở,</para>
  <para style="q" vid="HAB 1:16">và lương thực của nó hết sức dồi dào.<verse eid="HAB 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 1:17" />Thế thì lẽ nào nó sẽ giũ sạch lưới mình</para>
  <para style="q" vid="HAB 1:17">và cứ tiếp tục như thế để tàn sát các nước không thương xót sao?”<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="q">
    <verse number="1" style="v" sid="HAB 2:1" />Tôi sẽ đứng nơi trạm gác mình và bám trụ nơi tháp canh,</para>
  <para style="q" vid="HAB 2:1">rồi cẩn thận canh chừng để trông ngóng điều mà Ngài sẽ phán với tôi</para>
  <para style="q" vid="HAB 2:1">và tôi cần xoay khỏi lập luận than phiền của mình ra làm sao.<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fqa">tôi cần xoay khỏi lập luận than phiền của mình ra làm sao</char>, như đọc thấy trong văn bản tiếng Hy Bá Lai, một số bản hiện đại đọc <char style="fqa">tôi phải trả lời thế nào khi Ngài đáp lại lời than phiền của mình</char> hay <char style="fqa">tôi phải trả lời thế nào khi Ngài quở trách mình</char>.</note><verse eid="HAB 2:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="HAB 2:2" />Chúa Hằng Hữu trả lời tôi, Ngài phán:</para>
  <para style="q" vid="HAB 2:2">“Hãy ghi lại khải tượng này và viết rõ ràng trên các bảng đá để ai đọc nó thì có thể chạy nhanh.<verse eid="HAB 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 2:3" />Vì khải tượng vẫn chưa đến thời điểm được ấn định, nhưng sự việc sẽ mau chóng đến hồi kết thúc và chẳng thất bại đâu.</para>
  <para style="q" vid="HAB 2:3">Dù nó trì hoãn, hãy đợi nó. Bởi nó chắc chắc sẽ đến và sẽ không muộn màng.<verse eid="HAB 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 2:4" />Nhìn kìa! Kẻ kiêu ngạo là kẻ có tâm hồn không ngay thẳng trong mình. Nhưng người công chính sẽ sống bởi đức tin của mình.<verse eid="HAB 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 2:5" />Hơn nữa, vì rượu đánh lừa chiến binh kiêu ngạo để nó chẳng cứ ở yên,</para>
  <para style="q" vid="HAB 2:5">nhưng khiến lòng thèm khát của nó lớn thêm như Âm Phủ và giống sự chết, lòng nó chẳng bao giờ thỏa mãn.</para>
  <para style="q" vid="HAB 2:5">Nó thâu tóm cho mình mọi nước và gom về cho mình tất cả các dân.<verse eid="HAB 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 2:6" />Thế nhưng, chẳng phải hết thảy các dân ấy sẽ sáng tác tục ngữ nhạo cười nó, và bài hát châm chọc cùng các câu đố về nó hay sao, rằng:</para>
  <para style="q" vid="HAB 2:6">‘Khốn thay cho kẻ chất chứa thêm thứ chẳng thuộc về mình! Vì ngươi làm cho mình nặng gánh về vật cầm cố trong bao lâu nữa?’<verse eid="HAB 2:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="HAB 2:7" />Chẳng phải các con nợ của ngươi sẽ thình lình nổi dậy, và những kẻ nổi dậy đó sẽ khiến ngươi run sợ hay sao?</para>
  <para style="q2" vid="HAB 2:7">Ngươi sẽ bị chúng nó cướp bóc.<verse eid="HAB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HAB 2:8" />Vì ngươi đã cướp bóc nhiều nước, nên toàn bộ phần sót lại của các dân tộc sẽ cướp bóc ngươi.</para>
  <para style="q2" vid="HAB 2:8">Vì ngươi đã làm đổ máu người ta và hành xử tàn bạo với xứ sở, thành trì, và mọi cư dân sống trong đó.<verse eid="HAB 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 2:9" />‘Khốn thay cho kẻ trục lợi bất nghĩa cho nhà mình,</para>
  <para style="q2" vid="HAB 2:9">sao cho nó có thể làm tổ mình trên cao để giữ mình an toàn khỏi bàn tay ác hại.’<verse eid="HAB 2:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 2:10" />Ngươi đã chuốc lấy điều xấu hổ cho nhà mình khi tiêu diệt nhiều dân tộc, và đã phạm tội chống lại chính mình.<verse eid="HAB 2:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="HAB 2:11" />Vì đá từ trong vách tường sẽ kêu gào, và thanh xà gỗ sẽ đáp lại nó,<verse eid="HAB 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 2:12" />‘Khốn thay cho kẻ xây thành bằng máu, và lập ra phố xá trong sự gian ác.’<verse eid="HAB 2:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="HAB 2:13" />Thật, chẳng phải do Chúa Hằng Hữu của các đạo binh</para>
  <para style="q2" vid="HAB 2:13">mà các dân tộc phải lao khổ cho lửa và các nước chịu nhọc nhằn cho sự hư không hay sao?<verse eid="HAB 2:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="HAB 2:14" />Thế nhưng đất sẽ được làm cho đầy dẫy sự nhận biết về vinh quang của Chúa Hằng Hữu như nước bao phủ biển.<verse eid="HAB 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 2:15" />‘Khốn thay cho kẻ ép người láng giềng mình uống —</para>
  <para style="q" vid="HAB 2:15">ngươi rót cơn giận của mình ra,<note caller="+" style="f"><char style="ft" closed="false">Không có sự chắc chắn liệu tiếng Hy Bá Lai ở đây nên dịch là </char><char style="fqa">cơn giận</char>, hay <char style="fqa">bình rượu</char>.</note> thậm chí ngươi chuốc cho người say</para>
  <para style="q" vid="HAB 2:15">với mục đích nhìn vào sự trần truồng của người.’<verse eid="HAB 2:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="HAB 2:16" />Ngươi sẽ nhận trọn sự xấu hổ thay vì vinh quang.</para>
  <para style="q" vid="HAB 2:16">Bây giờ đến lượt ngươi! Hãy uống, rồi ngươi sẽ phơi bày bao quy đầu chưa cắt của mình!</para>
  <para style="q2" vid="HAB 2:16">Cái chén trong tay phải của Chúa Hằng Hữu sắp đến chỗ ngươi,</para>
  <para style="q2" vid="HAB 2:16">và sự hổ nhục sẽ che hết vinh quang ngươi.<verse eid="HAB 2:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="HAB 2:17" />Vì điều độc ác trên Li-ban sẽ bao trùm lấy ngươi và sự tàn bạo trên thú vật sẽ làm cho ngươi kinh hãi.</para>
  <para style="q2" vid="HAB 2:17">Vì ngươi đã làm đổ máu người ta và ngươi đã hành xử tàn bạo với xứ sở, thành trì, cùng mọi cư dân sống trong đó.<verse eid="HAB 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HAB 2:18" />Thần tượng có ích lợi gì khi mà kẻ tạo hình cho nó đã phải đục đẽo, một thứ kim loại được đúc theo lời dạy dối trá?</para>
  <para style="q" vid="HAB 2:18">Bởi kẻ làm ra nó tin vào trí tưởng tượng của mình để làm ra các tượng câm ấy.<verse eid="HAB 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 2:19" />‘Khốn thay cho kẻ nói với gỗ: Hãy thức! Hay nói với đá câm lặng: Hãy dậy!’ Mấy thứ đó dạy dỗ được sao?</para>
  <para style="q" vid="HAB 2:19">Nhìn kìa, nó được dát vàng và bạc, nhưng chẳng có hơi thở gì bên trong nó cả.<verse eid="HAB 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="HAB 2:20" />Nhưng Chúa Hằng Hữu ở trong đền thánh Ngài. Khắp cả đất hãy yên lặng trước Ngài.”<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="m">
    <verse number="1" style="v" sid="HAB 3:1" />Lời cầu nguyện của tiên tri Ha-ba-cúc, theo thể Si-ghi-ô-nốt.<note caller="+" style="f"><char style="ft" closed="false">Văn bản tiếng Hy Bá Lai có thêm cụm từ </char><char style="fqa">theo thể Si-ghi-ô-nốt</char>, có thể là lời chỉ dẫn cho người hát.</note><verse eid="HAB 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 3:2" />Lạy Chúa Hằng Hữu, con đã nghe lời thông cáo của Ngài, và con kính cẩn run sợ.</para>
  <para style="q" vid="HAB 3:2">Chúa Hẵng Hữu ôi, xin làm công việc Ngài sống động ở giữa các năm; xin khiến việc ấy được nhận biết giữa các niên đại;</para>
  <para style="q" vid="HAB 3:2">xin Ngài nhớ bày tỏ lòng thương xót trong cơn giận của Ngài.<verse eid="HAB 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 3:3" />Thiên Chúa đến từ Thê-man, và Đấng Thánh đến từ Núi Pha-ran.</para>
  <para style="m" vid="HAB 3:3">(Sê-la)</para>
  <para style="q" vid="HAB 3:3">Vinh quang Ngài bao phủ các tầng trời, và sự ngợi khen Ngài đầy dẫy khắp đất.<verse eid="HAB 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 3:4" />Vẻ rực rỡ của Ngài giống như ánh sáng; tia hào quang nơi tay của Ngài;</para>
  <para style="q" vid="HAB 3:4">và quyền năng Ngài ẩn giấu ở đó.<verse eid="HAB 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 3:5" />Dịch lệ đi phía trước Ngài,</para>
  <para style="q" vid="HAB 3:5">và tai vạ theo sau bước chân Ngài.<verse eid="HAB 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 3:6" />Ngài đứng và đo lường trái đất; Ngài nhìn xem và khiến các nước hoảng loạn.</para>
  <para style="q" vid="HAB 3:6">Thậm chí các dãy núi ngàn đời phải bị vỡ vụn, và các ngọn đồi lâu bền phải quỳ mọp xuống.</para>
  <para style="q" vid="HAB 3:6">Các đường lối Ngài trường tồn bất diệt.<verse eid="HAB 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 3:7" />Con đã thấy các trại của dân Cút trong cảnh tai họa, và những màn che lều trong xứ Ma-đi-an bị rung chuyển.<verse eid="HAB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 3:8" />Lạy Chúa Hằng Hữu, Ngài nổi giận với các sông ngòi sao? Có phải cơn thịnh nộ của Ngài nghịch với các dòng sông,</para>
  <para style="q" vid="HAB 3:8">hay sự tức giận của Ngài nghịch với biển cả,</para>
  <para style="q" vid="HAB 3:8">khi Ngài cưỡi trên những đoàn xe chiến mã khải hoàn của mình?<verse eid="HAB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 3:9" />Ngài lấy cung mình ra khỏi vỏ bọc; Ngài gọi đến các mũi tên, tức những lời thề!</para>
  <para style="m" vid="HAB 3:9">(Sê-la)</para>
  <para style="q" vid="HAB 3:9">Ngài chia đất ra bằng các dòng sông.<verse eid="HAB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 3:10" />Những dãy núi nhìn thấy Ngài thì đau đớn quằn quại.</para>
  <para style="q" vid="HAB 3:10">Dòng nước cuồn cuộn chảy tràn lan; biển sâu cất vang tiếng gào.</para>
  <para style="q" vid="HAB 3:10">Nó trào dâng con sóng mình lên cao.<verse eid="HAB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 3:11" />Mặt trời và mặt trăng đứng yên tại chỗ nó</para>
  <para style="q" vid="HAB 3:11">trước ánh sáng của các mũi tên Ngài bay lướt qua,</para>
  <para style="q" vid="HAB 3:11">trước sự chói lòa từ ngọn giáo lóe sáng của Ngài.<verse eid="HAB 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 3:12" />Chúa rảo qua trên đất với sự tức giận. Trong cơn thịnh nộ, Ngài giẫm đạp các nước.<verse eid="HAB 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 3:13" />Ngài đã đi ra vì sự cứu rỗi cho dân mình, vì sự cứu rỗi cho người chịu xức dầu của Ngài.</para>
  <para style="q" vid="HAB 3:13">Ngài nghiền nát đầu của nhà kẻ ác để khiến nó trần trụi từ phía dưới cùng lên đến tận cổ.</para>
  <para style="m" vid="HAB 3:13">(Sê-la)<verse eid="HAB 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 3:14" />Ngài đâm thủng đầu các thủ lĩnh của nó bằng những mũi tên của chính nó vì chúng càng quét như vũ bão để đánh đuổi con,</para>
  <para style="q" vid="HAB 3:14">sự hả hê của chúng như thể ăn tươi nuốt sống người khốn cùng tại nơi ẩn nấp.<verse eid="HAB 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 3:15" />Với những chiến mã của mình, Ngài đạp bước trên biển cả, trên bọt sóng của các luồng nước lớn.<verse eid="HAB 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 3:16" />Con đã nghe rồi thì lòng dạ con run rẩy! Trước âm thanh ấy, môi con mấp máy.</para>
  <para style="q" vid="HAB 3:16">Sự mục nát nhập vào xương cốt con, và chân cẳng dưới người con run lẩy bẩy.</para>
  <para style="q" vid="HAB 3:16">Nhưng con sẽ yên lặng chờ đợi ngày hoạn nạn ập xuống những kẻ xâm chiếm chúng con.<verse eid="HAB 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 3:17" />Dù cây vả không đâm chồi</para>
  <para style="q2" vid="HAB 3:17">và chẳng có trái trên những cây nho;</para>
  <para style="q2" vid="HAB 3:17">dù sản vật từ cây ô liu bị thất bát</para>
  <para style="q2" vid="HAB 3:17">và các cánh đồng chẳng sinh ra lương thực;</para>
  <para style="q2" vid="HAB 3:17">dù bầy chiên bị diệt mất khỏi ràn</para>
  <para style="q2" vid="HAB 3:17">và chẳng có đàn bò trong các chuồng trại,<verse eid="HAB 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HAB 3:18" />nhưng con sẽ vui mừng nơi Chúa Hằng Hữu.</para>
  <para style="q2" vid="HAB 3:18">Con sẽ hớn hở vì cớ Thiên Chúa của sự cứu rỗi con.<verse eid="HAB 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 3:19" />Chúa, tức Chúa Hằng Hữu, là sức mạnh của tôi;</para>
  <para style="q2" vid="HAB 3:19">và Ngài làm cho chân tôi giống như chân con nai.</para>
  <para style="q2" vid="HAB 3:19">Ngài khiến tôi bước đi trên các nơi cao của mình.</para>
  <para style="q3" vid="HAB 3:19">Dành cho nhạc trưởng, chơi trên đàn dây.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>