  <book code="1TH" style="id">EN_VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:25:50 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Thessalonians</para>
  <para style="toc1">Thư Tê-sa-lô-ni-ca thứ nhất</para>
  <para style="toc2">1 Tê-sa-lô-ni-ca</para>
  <para style="toc3">1Th</para>
  <para style="mt">1 Tê-sa-lô-ni-ca</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />Phao-lô và Sin-vanh cùng với Ti-mô-thê, gửi cho Hội Thánh Tê-sa-lô-ni-ca trong Thiên Chúa, là Cha và Chúa, là Chúa Cứu Thế Giê-xu. Nguyện ân điển và sự bình an ở trên anh chị em. <note caller="+" style="f"><char style="ft" closed="false">Một số phiên bản cổ hơn đọc: </char><char style="fqa">Nguyện anh chị em được ân điển và sự bình an từ Thiên Chúa, là Cha, và Chúa Cứu Thế Giê-xu</char>. </note><verse eid="1TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Chúng tôi luôn cảm tạ Thiên Chúa về tất cả anh chị em, khi không ngừng nhắc đến anh chị em trong những lời cầu nguyện của mình, <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />vì nhớ đến công việc bởi đức tin, và sự khó nhọc bởi tình yêu thương, cùng tính bền đỗ bởi niềm hy vọng của anh chị em nơi Chúa chúng ta, là Chúa Cứu Thế Giê-xu, trước mặt Thiên Chúa, Cha chúng ta; <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />vì biết anh chị em, những người được Thiên Chúa yêu thương, anh chị em được Thiên Chúa lựa chọn, <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />bởi cớ Phúc Âm của chúng tôi đã được truyền cho anh chị em không chỉ bằng lời nói, mà cũng bằng quyền năng và bằng Chúa Thánh Linh, cùng với niềm tin quả quyết — như anh chị em biết chúng tôi đã sống như thế nào giữa vòng anh chị em vì ích lợi của anh chị em. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />Anh chị em cũng đã trở nên những người theo gương của chúng tôi và của Chúa, khi tiếp nhận đạo giữa nhiều khó khăn với sự vui mừng của Chúa Thánh Linh. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Đến nỗi, anh chị em đã trở thành tấm gương cho tất cả những người có đức tin tại Ma-xê-đoan và tại A-chai. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Vì từ anh chị em, đạo Chúa đã được vang ra, không chỉ trong xứ Ma-xê-đoan và trong xứ A-chai, nhưng đức tin của anh chị em nơi Thiên Chúa đã lan truyền đến khắp nơi. Thế nên, chúng tôi không thấy cần phải nói gì nữa. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />Bởi khi nhắc về chúng tôi, chính họ thường thuật lại sự tiếp đón mà chúng tôi đã có nơi anh chị em ra sao, và thể nào anh chị em đã xoay khỏi hình tượng, hướng về Thiên Chúa để phục vụ Thiên Chúa hằng sống và chân thật, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />và để chờ đợi Con Ngài từ trời, Đấng mà Ngài đã khiến sống lại từ cõi chết — tức là Chúa Giê-xu, Đấng giải cứu chúng ta khỏi cơn thịnh nộ đang đến.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Thưa anh chị em, chính anh chị em biết rằng việc chúng tôi đến cùng anh chị em đã chẳng trở nên vô ích. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />Nhưng sau khi chịu khổ và bị sỉ nhục tại thành Phi-líp theo như anh chị em đã biết, chúng tôi được dạn dĩ trong Thiên Chúa của chúng tôi để rao truyền cho anh chị em Phúc Âm của Thiên Chúa giữa nhiều sự tranh đấu. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Vì việc khuyên nài của chúng tôi không phải ra từ điều sai lầm, cũng không đến từ lòng bất khiết, hoặc bởi ý đồ lừa gạt, <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />nhưng chúng tôi đã được Thiên Chúa thử luyện để được ủy thác Phúc Âm như thể nào, thì chúng tôi cũng nói ra thể ấy, không phải để làm hài lòng người ta, mà để làm vui lòng Thiên Chúa, là Đấng tra xét lòng chúng tôi. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Như anh chị em đã biết, khi ấy chúng tôi không đến bằng những lời xu nịnh, hoặc bởi lòng tham trá hình — Thiên Chúa chứng giám — <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />cũng không tìm kiếm vinh quang từ loài người, chẳng phải từ anh chị em hay từ người khác, <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />tuy có thể được trọng đãi vì là sứ đồ của Chúa Cứu Thế, nhưng ở giữa anh chị em, chúng tôi như thể sinh hạ các bé thơ, khác nào người mẹ cần phải chăm sóc con mình. <note caller="+" style="f"><char style="ft" closed="false">Một số cổ bản đọc: </char><char style="fqa">nhưng chúng tôi cư xử dịu dàng ở giữa anh chị em như người mẹ vỗ về con mình</char>.</note> <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />Vì tríu mến anh chị em như vậy, nên chúng tôi vui lòng chia sẻ với anh chị em không chỉ Phúc Âm của Thiên Chúa, mà còn mạng sống của chính mình. Ấy là do anh chị em đã trở nên những người yêu dấu đối với chúng tôi. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />Thưa anh chị em, hẳn là anh chị em còn nhớ sự lao nhọc và vất vả của chúng tôi, chúng tôi đã rao giảng Phúc Âm của Thiên Chúa cho anh chị em khi vẫn làm việc đêm ngày để không làm gánh nặng cho bất cứ ai trong anh chị em. <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />Anh chị em là nhân chứng, và cả Thiên Chúa nữa, rằng đối với anh chị em, là những người có lòng tin, chúng tôi đã sống thánh khiết, công chính, và không chỗ trách được ra sao, <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />cũng như anh chị em đã biết, thể nào chúng tôi đối với mỗi một người trong anh chị em, như người cha đối với con cái mình, <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />khuyên nhủ anh chị em, khích lệ và thúc giục anh chị em để ăn ở cách xứng hợp với Thiên Chúa, Đấng gọi anh chị em vào trong vương quốc và vinh quang của Ngài.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Bởi cớ đó, chúng tôi cũng không ngừng cảm tạ Thiên Chúa, vì khi tiếp lấy lời Thiên Chúa qua việc lắng nghe nơi chúng tôi, anh chị em đã đón nhận không phải như lời của con người, mà theo thực chất đó là lời của Thiên Chúa, cũng là điều đang hành động trong anh chị em, tức là trong những người có lòng tin. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />Thưa anh chị em, anh chị em đã trở nên những người noi theo các hội thánh của Thiên Chúa, là các hội thánh trong Chúa Cứu Thế Giê-xu ở tại vùng Giu-đê, vì anh chị em đã chịu cùng những khốn khổ bởi chính dân tộc mình, y như các hội thánh ấy cũng đã chịu từ người Do Thái, <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />là những kẻ đã vừa giết Chúa, là Chúa Giê-xu, cùng các tiên tri, vừa bắt bớ chúng tôi, và cũng là những kẻ chẳng làm vui lòng Thiên Chúa, lại còn thù địch với mọi người, <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />khi cấm cản chúng tôi rao giảng cho dân ngoại để nhiều người có thể được cứu, dẫn đến tội lỗi của họ cứ luôn lấp đầy thêm. Nhưng đến cuối cùng, cơn thịnh nộ ắt giáng trên họ.<verse eid="1TH 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />Thưa anh chị em, dù bị chia cách với anh chị em trong một khoảng thời gian, tuy xa mặt nhưng không cách lòng, chúng tôi hết sức nôn nóng trong niềm khao khát quá đỗi để gặp mặt anh chị em. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Cho nên, chúng tôi muốn đi đến với anh chị em — nhất là tôi, Phao-lô, một hai lần định đi — nhưng Sa-tan đã ngăn trở chúng tôi. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Vì niềm hy vọng, hay sự vui mừng, hoặc mão miện hãnh diện của chúng tôi là gì? <note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fq">hãnh diện,</char> hai phiên bản cổ có từ ngữ được dịch là <char style="fqa">reo hò lớn tiếng </char> hay <char style="fqa">sự tán dương. </char></note> Chẳng phải đó là anh chị em ở trước mặt Chúa chúng ta, là Chúa Giê-xu, trong sự hiện đến của Ngài hay sao? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Thật, anh chị em là vinh quang và sự vui mừng của chúng tôi.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Do đó, khi không chịu lâu hơn được, chúng tôi nghĩ tốt hơn là bị ở lại một mình tại A-thên, <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />và chúng tôi đã sai phái Ti-mô-thê, người anh em của chúng tôi và tôi tớ của Thiên Chúa trong Phúc Âm của Chúa Cứu Thế, để làm vững mạnh và khích lệ anh chị em về đức tin của mình, <note caller="+" style="f"><char style="ft" closed="false">Một số phiên bản khác đọc: </char><char style="fqa">và chúng tôi sai phái Ti-mô-thê, người anh em và bạn đồng lao của chúng tôi cùng phục vụ Thiên Chúa trong Phúc âm của Chúa Cứu Thế</char>.</note> <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />để không ai bị rúng động giữa những hoạn nạn này. Vì chính anh chị em biết rằng chúng ta được định đối diện chuyện như vậy. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Thậm chí khi chúng tôi còn ở với anh chị em, chúng tôi đã bảo trước cho anh chị em rằng chúng ta sẽ chịu hoạn nạn, và việc xảy ra y như anh chị em đã biết. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Vì lý do ấy, khi không thể chịu lâu hơn được nữa, tôi đã cử người đi để biết đức tin anh chị em như thế nào, biết đâu kẻ cám dỗ bằng cách nào đó đã dỗ dành anh chị em và công lao của chúng tôi thành ra vô ích. <verse eid="1TH 3:5" /><verse number="6" style="v" sid="1TH 3:6" />Nhưng ngay lúc này, Ti-mô-thê, sau khi đi từ chỗ anh chị em về với chúng tôi, đã đem cho chúng tôi tin vui về đức tin và tình yêu thương của anh chị em, rằng anh chị em luôn giữ những ký ức tốt đẹp về chúng tôi, mong mỏi gặp chúng tôi cũng giống như chúng tôi mong gặp anh chị em. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />Vì cớ đó, thưa anh chị em, chúng tôi được yên ủi bởi anh chị em khi đối mặt với mọi hiểm nguy và hoạn nạn của mình, vì đức tin của anh chị em. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Kể từ lúc này, nếu chính anh chị em đứng vững trong Chúa, thì chúng tôi sống. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Chúng tôi có thể dâng lên Thiên Chúa lời cảm tạ thế nào về anh chị em dựa trên tất cả niềm hân hoan mà vì cớ anh chị em, chúng tôi vui mừng trước mặt Thiên Chúa chúng tôi, <note caller="+" style="f"><char style="ft" closed="false">Một số thủ bản cổ thay thể 2 lần xuất hiện của </char><char style="fq">Thiên Chúa</char> bằng <char style="fqa">Chúa.</char></note> <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />đêm ngày cầu nguyện khẩn thiết để được gặp mặt anh chị em và bổ sung những gì còn thiếu trong đức tin anh chị em?<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Cầu xin chính Thiên Chúa, Cha chúng ta, và Chúa Giê-xu, Chúa chúng ta, đưa đường chúng tôi đến cùng anh chị em. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Nguyện Chúa khiến anh chị em thêm lên và dư dật trong tình yêu thương đối với nhau và đối với mọi người, cũng như cách chúng tôi đối với anh chị em, <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />để làm cho lòng anh chị em vững mạnh, không có gì đáng trách trong sự thánh khiết trước mặt Thiên Chúa, Cha chúng ta, trong sự hiện đến của Chúa chúng ta, là Chúa Giê-xu, cùng với hết thảy các thánh đồ Ngài. A-men!<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Vậy nên, sau hết, thưa anh chị em, chúng tôi nài xin và khuyên nhủ anh chị em trong Chúa, là Chúa Giê-xu, y như anh chị em đã nhận lãnh từ chúng tôi thế nào là điều cần thiết cho anh chị em để sống và làm đẹp lòng Thiên Chúa, cũng như cách anh chị em đang sống, hầu cho anh chị em có thể tấn tới hơn nữa. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Vì anh chị em biết những giáo huấn nào chúng tôi đã truyền cho anh chị em bởi Chúa Giê-xu. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />Vì đây là ý muốn của Thiên Chúa, tức là sự nên thánh của anh chị em: phải giữ mình tránh xa sự gian dâm; <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />mỗi người trong anh chị em phải biết kiểm soát thân thể mình trong sự thánh khiết và tôn trọng, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />không chiều theo đam mê nhục dục (giống như dân ngoại là kẻ không biết Thiên Chúa); <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />để đừng ai vi phạm và lợi dụng anh chị em mình trong vấn đề này, bởi vì Chúa là Đấng báo trả về mọi điều đó, như chúng tôi cũng đã nói trước và nghiêm túc cảnh báo cho anh chị em. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Vì Thiên Chúa không kêu gọi chúng ta đến sự ô uế, nhưng vào trong sự nên thánh. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Vì vậy, ai khước từ huấn thị này không phải khước từ con người, mà là khước từ Thiên Chúa, Đấng ban<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fq">Đấng ban</char>, một số thủ bản cổ đọc <char style="fqa">Đấng đã ban.</char></note> Chúa Thánh Linh Ngài cho anh chị em<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fq">anh chị em</char>, một số thủ bản cổ đọc <char style="fqa">chúng ta</char>.</note>.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Còn về tình huynh đệ thân ái, anh chị em chẳng cần chúng tôi<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fq">anh chị em chẳng cần chúng tôi</char>, một số thủ bản cổ đọc <char style="fqa">chúng tôi chẳng cần</char>.</note> viết cho anh chị em, vì chính anh chị em được Thiên Chúa dạy phải yêu thương nhau. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Vì thật, anh chị em có làm như vậy đối với tất cả anh chị em trong toàn tỉnh Ma-xê-đoan. Nhưng thưa anh chị em, chúng tôi nài khuyên anh chị em cứ tấn tới hơn nữa, <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />và phải rán sức sống yên lành, chăm lo các việc của mình, tự tay mình lao động, như chúng tôi đã truyền dạy anh chị em, <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />để anh chị em có thể ăn ở cách đứng đắn trước mặt người ngoài và không có thiếu thốn gì.<verse eid="1TH 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />Thưa anh chị em, chúng tôi không muốn anh chị em chẳng biết gì về những người đang ngủ, để anh chị em khỏi đau buồn như những người khác là những kẻ không có niềm hy vọng. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Vì nếu chúng ta tin rằng Chúa Giê-xu đã chết và đã sống lại, thì Thiên Chúa cũng sẽ đem những kẻ đã ngủ đến với Ngài thông qua Chúa Giê-xu. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />Dựa vào lời của Chúa, chúng tôi nói điều này cho anh chị em, rằng chúng ta, những người hiện đang sống, những người còn ở lại cho đến lúc Chúa tái tâm, chắc chắn không đi trước những người đã ngủ. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />Vì chính Chúa sẽ từ trời giáng xuống với hiệu lệnh, với tiếng của thiên sứ trưởng, cùng với tiếng kèn của Thiên Chúa, rồi những người đã chết trong Chúa Cứu Thế sẽ sống lại trước hết. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />Kế đến, chúng ta, là những người hiện đang sống, những người còn ở lại, sẽ được cất lên cùng với họ trong đám mây để gặp Chúa trên không trung, và như vậy, chúng ta sẽ ở với Chúa luôn luôn. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Do đó, hãy an ủi nhau bằng những lời này.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Thưa anh chị em, về ngày giờ và thời kỳ, anh chị em chẳng cần chúng tôi viết cho anh chị em. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />Vì chính anh chị em biết rất rõ rằng ngày của Chúa đến như thể nào — như kẻ trộm trong ban đêm. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />Khi người ta nói: “Hòa bình và an ninh,” thì sự hủy diệt thình lình ập xuống trên họ, giống như cơn đau chuyển dạ đối với người phụ nữ đang mang thai, và họ chắc chắn không thoát khỏi. <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />Nhưng, thưa anh chị em, anh chị em không ở trong bóng tối để rồi ngày ấy xảy đến cho anh chị em thình lình như kẻ trộm. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Vì anh chị em đều là con của ánh sáng và con của ban ngày. Chúng ta không thuộc về ban đêm hay bóng tối, <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />vậy nên, chúng ta đừng ngủ như những người khác, trái lại, chúng ta cần thức canh và tỉnh táo. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Vì người ngủ là ngủ vào ban đêm, và kẻ say thì say trong ban đêm. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />Nhưng vì thuộc về ban ngày, nên chúng ta phải tỉnh táo, mặc áo giáp của đức tin và tình yêu thương, với nón giáp — là hy vọng cứu rỗi. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />Vì Thiên Chúa đã không định cho chúng ta chịu cơn thịnh nộ, mà để hưởng sự cứu rỗi nhờ Chúa chúng ta, là Chúa Cứu Thế Giê-xu, <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />Đấng đã chết vì chúng ta, để chúng ta dù thức hay ngủ, chúng ta đều cùng sống với Ngài. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Do đó, hãy động viên nhau, người này hãy gây dựng người kia, như anh chị em vẫn đang làm.<verse eid="1TH 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Thưa anh chị em, chúng tôi xin anh chị em hãy trân trọng những người chịu khó nhọc giữa vòng anh chị em, dẫn dắt anh chị em trong Chúa, khuyên bảo anh chị em, <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />và hãy nghĩ đến họ một cách tôn kính trong tình yêu thương vì công tác của họ. Hãy sống hòa thuận với nhau. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />Mặt khác, thưa anh chị em, chúng tôi thúc giục anh chị em: phải khiển trách người vô kỷ luật, phải an ủi người ngã lòng, phải nâng đỡ người yếu đuối, phải kiên nhẫn với tất cả mọi người. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />Hãy cẩn trọng, đừng ai lấy ác trả ác cho ai, trái lại, hãy luôn theo đuổi điều tốt đẹp dành cho nhau và cho mọi người. <verse eid="1TH 5:15" /><verse number="16" style="v" sid="1TH 5:16" />Hãy luôn luôn vui mừng. <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />Hãy cầu nguyện không ngưng. <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />Trong bất cứ điều gì, hãy tạ ơn, vì điều đó là ý muốn của Thiên Chúa dành cho anh chị em trong Chúa Cứu Thế Giê-xu. <verse eid="1TH 5:18" /><verse number="19" style="v" sid="1TH 5:19" />Đừng dập tắt Thánh Linh. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />Đừng khinh dể các lời tiên tri. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />Hãy tra xét mọi sự. <note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fq">Hãy tra xét mọi sự, </char> nhiều cổ bản đọc <char style="fqa">Nhưng hãy tra xét mọi sự </char></note> Hãy giữ lấy điều gì là thiện lành. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />Hãy tránh xa khỏi mọi hình thức tà ác.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Cầu xin chính Thiên Chúa bình an thánh hóa anh chị em hoàn toàn, và nguyện toàn bộ tâm thần, linh hồn, thân thể của anh chị em được gìn giữ cho không chỗ trách được khi Chúa chúng ta, là Chúa Cứu Thế Giê-xu, ngự đến. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Thành tín thay là Đấng kêu gọi anh chị em, cũng là Đấng sẽ thực hiện việc ấy.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />Thưa anh chị em, cũng hãy cầu nguyện cho chúng tôi nữa.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />Xin chào thăm tất cả anh chị em bằng nụ hôn thánh. <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />Tôi nhân danh Chúa truyền cho anh chị em phải để bức thư này được đọc cho toàn thể anh chị em.<note caller="+" style="f"><char style="ft" closed="false">Một vài thủ bản cổ đọc </char><char style="fqa">toàn thể anh chị em thánh.</char></note><verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Nguyện xin ân điển của Chúa chúng ta, là Chúa Cứu Thế Giê-xu, ở cùng anh chị em. <note caller="+" style="f"><char style="ft" closed="false">Một vài thủ bản cổ thêm </char><char style="fqa">A-men.</char></note><verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>