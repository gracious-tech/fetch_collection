<usx version="3.0">
  <book code="1TI" style="id">EN_VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:26:08 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">Thư Ti-mô-thê thứ nhất</para>
  <para style="toc2">1 Ti-mô-thê</para>
  <para style="toc3">1Ti</para>
  <para style="mt">1 Ti-mô-thê</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Phao-lô, sứ đồ của Chúa Cứu Thế Giê-xu theo mạng lịnh của Thiên Chúa, Cứu Chúa chúng ta, và của Chúa, là Chúa Cứu Thế Giê-xu, niềm hy vọng của chúng ta,<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />gửi cho Ti-mô-thê, con thật của ta trong đức tin:</para>
  <para style="p" vid="1TI 1:2">Nguyện con được ân điển, sự thương xót, bình an từ Thiên Chúa, là Cha và Chúa Cứu Thế Giê-xu, Chúa chúng ta.<verse eid="1TI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Như lúc lên đường đến Ma-xê-đoan, ta đã khuyên giục con ở lại tại Ê-phê-sô để con có thể truyền bảo mấy người kia không dạy giáo lý khác, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />cũng đừng lưu tâm đến mấy chuyện hoang đường và các bảng gia phả bất tận, là những thứ mang đến sự tranh cãi, hơn là công tác quản trị nhà Thiên Chúa, là công tác bởi đức tin. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Nhưng mục tiêu của mạng lịnh này là tình yêu xuất phát từ lòng thanh sạch và lương tâm tốt cùng với đức tin không giả tạo, <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />mà một số người, vì chệch mục tiêu, đã xoay bỏ để hướng đến việc bàn luận ngốc nghếch, <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />muốn làm thầy dạy luật, khi chẳng hiểu không chỉ những lời mình nói mà còn về những điều mình quả quyết.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Tuy nhiên, chúng ta biết rằng luật pháp là tốt lành nếu người ta sử dụng nó cách đúng đắn, <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />vì biết điều này, đó là luật pháp không được đặt ra cho người công chính, mà cho kẻ vô luật pháp và bất phục tùng, kẻ bất kính và tội lỗi, kẻ vô đạo và báng bổ, kẻ giết cha và giết mẹ, kẻ sát nhân, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />kẻ gian dâm, kẻ đồng tính, kẻ bắt cóc buôn người, kẻ nói dối, kẻ làm chứng gian, và bất kỳ kẻ nào khác đối nghịch với sự dạy dỗ lành mạnh <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />đúng theo Phúc Âm vinh hiển của Thiên Chúa hạnh phước, là điều mà ta đã được giao phó.<verse eid="1TI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Ta tạ ơn Đấng ban năng lực cho ta, tức là Chúa Cứu Thế Giê-xu, Chúa chúng ta, vì Ngài đã xét ta là đáng tin cậy, khi đặt ta vào chức vụ, <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />dù trước kia ta là kẻ phạm thượng, bức hại và hung bạo, nhưng ta đã được thương xót vì đang lúc không hiểu biết, ta đã hành động trong sự vô tín. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Nhưng, ân điển của Chúa chúng ta là vô cùng dư dật cùng với đức tin và tình yêu thương trong Chúa Cứu Thế Giê-xu.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />Sứ điệp này là đáng tin và đáng đón nhận hoàn toàn, đó là: “Chúa Cứu Thế Giê-xu đã đến trong thế gian để cứu tội nhân” — mà trong đó ta là kẻ đứng đầu. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />Tuy nhiên, ta đã được thương xót vì lý do này, ấy là để Chúa Cứu Thế Giê-xu có thể chứng tỏ tất cả lòng nhẫn nhục trong ta, kẻ tội lỗi hàng đầu, như một minh họa cho những người sẽ tin nơi Ngài để được sự sống đời đời. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Nguyện sự tôn quý và vinh hiển thuộc về Vua của mọi thời đại, là Thiên Chúa độc nhất<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fqa">Thiên Chúa độc nhất</char> thì vài thủ bản đọc <char style="fqa">Thiên Chúa khôn ngoan độc nhất</char>.</note> bất diệt, vô hình, cho đến đời đời mãi mãi. A-men.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Ti-mô-thê, con ta, ta giao thác mạng lịnh này cho con, theo những lời tiên tri trước đây về con, để nhờ chúng, con có thể xông pha trong cuộc chiến cao quý, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />khi cầm giữ đức tin và lương tâm tốt, mà một số người, vì cự tuyệt, đã làm chìm đắm đức tin mình, <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />trong số đó là Hy-mê-nê và A-léc-xan-đơ, là những kẻ mà ta đã phó cho Sa-tan hầu cho họ có thể được dạy dỗ để không phạm thượng.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Vậy nên, trước hết, ta thúc giục những lời nài xin, cầu nguyện, cầu thay, tạ ơn cần được dâng lên cho mọi người, <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />cho các vua và hết thảy những ai đang ở trong vị trí quyền lực, để chúng ta có thể sống cuộc đời bình tịnh và yên ổn với mọi sự tin kính và phẩm hạnh. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Đó là điều tốt lành và chính đáng trước mặt Thiên Chúa, Cứu Chúa chúng ta, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />là Đấng muốn mọi người được cứu và đi đến chỗ nhận biết chân lý. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Vì chỉ có một Thiên Chúa và một Đấng trung gian giữa Thiên Chúa và loài người — đó là Chúa Cứu Thế Giê-xu, một con người, <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />Đấng đã phó chính mình làm giá chuộc cho mọi người, như lời chứng vào đúng thời điểm, <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />bởi lời chứng ấy mà ta đã được lập làm người giảng đạo và sứ đồ — ta nói thật trong Chúa Cứu Thế,<note caller="+" style="f"><char style="ft" closed="false">Vài thủ bản không bao gồm cụm từ </char><char style="fqa">trong Chúa Cứu Thế</char> tại đây.</note> ta không nói dối — tức là làm giáo sư cho các dân ngoại quốc về đức tin và chân lý.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Vì vậy, ta muốn quý ông ở khắp nơi phải cầu nguyện, đưa tay thánh khiết lên không kèm theo sự giận dữ và tranh cãi, <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />tương tự, các chị em phụ nữ phải làm đẹp chính mình trong trang phục đứng đắn với lòng khiêm tốn và tự chủ, không phải bằng việc tết tóc cùng với vàng hay ngọc, hoặc quần áo đắt tiền, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />mà bằng điều xứng hợp với người phụ nữ tuyên xưng lòng kính sợ Thiên Chúa nhờ các việc lành.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />Phụ nữ phải học hỏi trong yên lặng, trong sự thuận phục hoàn toàn. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Mặt khác, ta không cho phép phụ nữ dạy dỗ hay cầm quyền trên đàn ông, mà phải yên lặng. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Vì A-đam đã được tạo dựng trước, rồi mới đến Ê-va, <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />và A-đam không bị lừa dối, nhưng người nữ, khi hoàn toàn bị dụ dỗ, đã tiến đến chỗ phạm tội. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Tuy nhiên, người nữ sẽ được cứu qua việc sinh con, nếu như họ cứ ở trong đức tin, tình yêu thương và sự thánh khiết, với tâm trí lành mạnh.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Lời này là đáng tin cậy: “Nếu ai đó mong làm người chăn bầy, thì người ấy ước muốn một việc cao quý.” <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Thế nên, người chăn bầy phải là người không chê trách được, chồng của một vợ, cẩn trọng, tự chủ, nề nếp, hiếu khách, có khả năng dạy dỗ, <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />không nghiện rượu, không hay gây sự, mà phải hiền lành, hòa nhã, không tham tiền,<note caller="+" style="f"><char style="ft" closed="false">Vài thủ bản không thêm </char><char style="fqa">không tham tiền</char> vào đây.</note> <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />quản lý tốt nhà mình, có con cái vâng phục với tất cả lòng kính trọng <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />(vì nếu một người không biết cách quản lý nhà mình, thì người ấy sẽ chăm sóc Hội Thánh của Thiên Chúa như thế nào?), <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />không thể là tân tín hữu, để không vì cớ lên mình kiêu ngạo mà người ấy sa vào sự đoán phạt như ma quỷ. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Trái lại, người chăn bầy cũng phải có lời chứng tốt từ người ngoài Hội Thánh, để người ấy không rơi vào sự sỉ nhục và cạm bẫy của ma quỷ.<verse eid="1TI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Tương tự, các chấp sự phải nghiêm trang, không nói hai lời, không lạm dụng rượu, không tham lam, <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />gìn giữ sự huyền nhiệm của đức tin bằng lương tâm thanh sạch. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Mặt khác, họ cũng phải được thử luyện trước, rồi sau đó hãy để họ phục vụ khi không bị chê trách.<verse eid="1TI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11" />Những người vợ cũng vậy, phải nghiêm trang, không nói xấu, tiết độ, trung tín trong mọi sự.<verse eid="1TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12" />Các chấp sự phải là chồng của một vợ, quản lý tốt con cái và cả nhà mình. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Vì những người phục vụ ngay lành đem về cho mình vị thế tốt đẹp và nhiều sự bạo dạn trong đức tin nơi Chúa Cứu Thế Giê-xu.<verse eid="1TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Ta viết mấy lời này cho con, mong đến thăm con thật sớm, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />nhưng nếu ta chậm đến, thì con có thể biết phải hành xử thế nào trong nhà của Thiên Chúa, mà đó là Hội Thánh của Thiên Chúa hằng sống, trụ và cột chống đỡ của chân lý. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Huyền nhiệm về sự tin kính thật là vĩ đại không thể bàn cãi, là:</para>
  <para style="q1" vid="1TI 3:16">“Đấng<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fqa">Đấng</char> thì vài thủ bản đọc <char style="fqa">Thiên Chúa</char>.</note> được tỏ ra trong xác thịt,</para>
  <para style="q1" vid="1TI 3:16">được xưng công chính trong Thánh Linh,</para>
  <para style="q1" vid="1TI 3:16">được trông thấy bởi thiên sứ,</para>
  <para style="q1" vid="1TI 3:16">được công bố giữa các dân,</para>
  <para style="q1" vid="1TI 3:16">được tin cậy trên thế giới,</para>
  <para style="q1" vid="1TI 3:16">được cất lên trong vinh hiển.”<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Thánh Linh phán rõ ràng rằng trong thời kỳ sau này, nhiều người sẽ lìa bỏ đức tin, dấn thân theo những linh lừa dối và đạo lý của ma quỷ, <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />bởi sự giả hình của bọn giả dối, lương tâm của bọn đó đã bị chai lì, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />khi cấm đoán cưới gả, đòi kiêng kỵ những thức ăn mà Thiên Chúa dựng nên để hưởng lấy với lòng biết ơn bởi người tin cậy và hiểu biết chân lý. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Vì mọi tạo vật của Thiên Chúa là tốt lành, và chẳng có vật gì đáng vứt bỏ khi được nhận lãnh với lòng biết ơn, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />bởi thức ăn được thánh hóa nhờ lời Thiên Chúa và lời cầu nguyện.<verse eid="1TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Khi đặt những điều ấy trước mặt anh chị em, con sẽ là đầy tớ ngay lành của Chúa Cứu Thế Giê-xu, được nuôi dưỡng bởi lời của đức tin và giáo huấn tốt lành mà con đã vâng theo. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Nhưng hãy khước từ những chuyện hảo huyền trần tục của mấy bà già. Thay vào đó, hãy rèn luyện chính mình cho sự tin kính, <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />bởi “sự rèn luyện thân thể thì ích lợi trong thời gian ngắn, nhưng rèn luyện lòng tin kính thì ích lợi cho mọi việc, vì có lời hứa cho đời này và đời sau.” <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Lời ấy là đáng tin cậy và đáng đón nhận hoàn toàn, <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />bởi chúng ta lao nhọc và tranh chiến cho điều này,<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fqa">tranh chiến</char> thì vài thủ bản đọc <char style="fqa">chịu sỉ nhục</char></note> vì chúng ta đặt hy vọng nơi Thiên Chúa hằng sống, Ngài là Cứu Chúa của mọi người, nhất là của tín nhân.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Hãy truyền bảo và dạy dỗ các điều ấy. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Đừng để ai coi thường tuổi trẻ của con, mà hãy trở nên gương mẫu cho các tín hữu, trong lời nói, trong cách ứng xử, trong tình yêu thương,<note caller="+" style="f"><char style="ft" closed="false">Tại đây, vài thủ bản thêm vào cụm từ </char><char style="fqa">trong tâm thần</char>.</note> trong đức tin, trong sự tinh sạch. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Hãy chú tâm vào việc đọc sách, khuyên răn, dạy dỗ cho tới khi ta đến. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Đừng bỏ bê ơn ở trong con, là ơn đã được ban cho con qua lời tiên tri, cùng với sự đặt tay của các trưởng lão.<verse eid="1TI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15" />Hãy rèn luyện những việc ấy, hãy chuyên chú vào chúng, để sự tiến bộ của con trở nên rõ ràng đối với mọi người. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Hãy cẩn thận lưu ý chính mình con và công tác dạy dỗ. Hãy bền đỗ trong những việc ấy, vì làm vậy con sẽ cứu cả bản thân mình lẫn những người nghe con.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Không nên nặng lời với quý ông lớn tuổi, nhưng hãy khuyên giải người ấy như cha, thanh niên thì như anh em, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />quý bà lớn tuổi thì như mẹ, các thiếu nữ thì như chị em, trong sự thanh sạch hoàn toàn.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Hãy tôn trọng các góa phụ — những góa phụ thật sự. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Nhưng nếu góa phụ nào có con hoặc cháu, thì trước nhất con cháu họ phải học để tôn trọng người nhà của chính mình, và tỏ lòng đền đáp cho các bậc sinh thành ấy, vì đây là điều hợp lẽ trước mặt Thiên Chúa. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Tuy nhiên, người góa bụa thật sự và chỉ một thân một mình, thì trông đợi nơi Thiên Chúa và cứ bền đỗ trong sự nài xin và nguyện cầu đêm ngày. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Còn kẻ tìm kiếm sự vui thú thì đã chết, cho dù vẫn còn sống. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Cũng hãy truyền các mạng lịnh này, để họ có thể không chỗ nào đáng trách. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Nhưng nếu ai đó không chu cấp cho người thân thuộc, mà đặc biệt là người nhà mình, thì người ấy đã chối bỏ đức tin và là kẻ tệ hơn người không tin.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Một góa phụ cần phải được ghi danh thì không ít hơn sáu mươi tuổi, là vợ của một chồng, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />được kiểm chứng qua các việc lành: bà có nuôi dạy con cái chăng, bà có tiếp đãi khách lạ chăng, bà có rửa chân các thánh đồ chăng, bà có cứu giúp kẻ hoạn nạn chăng, bà có hết lòng với mọi việc lành chăng.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Nhưng hãy từ chối các góa phụ còn trẻ, vì khi ham muốn nhục dục trỗi dậy nghịch với Chúa Cứu Thế, thì họ muốn tái hôn, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />nhận lấy sự phán xét vì họ đã hủy bỏ kết ước trước nhất của mình. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Đồng thời, họ cũng sẽ quen thói biếng nhác, cứ lê la đến nhà này nhà nọ, mà không chỉ thói biếng nhác, nhưng còn thói nói nhảm và thích xen vào việc của người khác, nói những điều họ chẳng nên nói. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Vì thế, ta muốn các góa phụ còn trẻ hãy kết hôn, sinh con, chăm sóc nhà mình, để không tạo cơ hội cho kẻ chống đối có lời gièm chê. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Vì một số người đã tẻ tách đi theo Sa-tan rồi.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />Nếu nữ tín hữu<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fqa">nữ tín hữu</char> thì vào thủ bản đọc <char style="fqa">nam hay nữ tín hữu</char>.</note> nào có góa phụ trong nhà, thì hãy giúp đỡ họ, và đừng để Hội Thánh bị nặng gánh, hầu cho Hội Thánh có thể giúp đỡ các góa phụ thật sự.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Những trưởng lão khéo quản trị phải được xem là đáng kính nể bội phần, đặc biệt là những người lao khổ trong Lời Chúa và sự dạy dỗ. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />Vì Kinh Thánh dạy: “Ngươi chẳng nên khớp miệng con bò đang khi nó đạp lúa,” và “Người làm công xứng đáng với thù lao của mình.” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />Đừng tiếp nhận lời cáo buộc chống lại một trưởng lão, ngoại trừ nếu dựa trên chí ít là hai hoặc ba nhân chứng. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Hãy khiển trách kẻ phạm tội trước mặt mọi người để những người còn lại có thể cũng biết sợ. <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />Ta long trọng truyền bảo con trước mặt Thiên Chúa và Chúa Cứu Thế Giê-xu, cùng các thiên sứ được chọn, rằng con phải giữ những mạng lịnh này mà không kèm với thành kiến, chẳng làm gì theo lòng thiên vị.<verse eid="1TI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22" />Đừng vội đặt tay trên ai, cũng đừng can dự vào tội lỗi của người khác. Hãy giữ mình thanh sạch.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Con đừng nên chỉ uống nước, mà hãy dùng chút ít rượu vì cớ dạ dày của con và các chứng bệnh hay gặp.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Tội của một số người thì rõ ràng, dẫn đến chỗ phán xét, nhưng cũng có những tội chỉ lộ ra sau khi xét xử. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Tương tự, cũng có những việc lành thì rõ ràng, còn những việc lành có tính thầm lặng thì không thể cứ được giấu kín.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Bất cứ ai đang ở dưới ách nô lệ, phải xem chủ mình là đáng hết lòng tôn trọng, để danh Thiên Chúa và sự dạy dỗ khỏi bị xúc phạm. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Mặt khác, các nô lệ có những người chủ là tín nhân không được bởi cớ họ là anh em mà xem thường, nhưng phải phục vụ càng hơn nữa, vì họ là tín hữu và người được yêu mến, người dự phần vào sự phục vụ. Con hãy dạy dỗ và khuyên giục những điều ấy.<verse eid="1TI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />Nếu người nào dạy dỗ khác đi và không chấp nhận những lời lành mạnh, tức là lời của Chúa chúng ta, là Chúa Cứu Thế Giê-xu, cùng với giáo huấn về sự tin kính, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />thì người đó là kẻ tự phụ, chẳng hiểu biết gì, mà có sở thích bệnh hoạn trong việc tranh cãi và đấu đá về chữ nghĩa, từ đó gây ra sự đố kỵ, xung khắc, xúc phạm, định kiến xấu xa, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />xích mích, giữa những kẻ bị hư hoại trong tâm trí và bị thiếu mất lẽ thật, xem sự tin kính là phương tiện trục lợi.<note caller="+" style="f"><char style="ft" closed="false">Một số thủ bản thêm câu </char><char style="fqa">Hãy tránh xa những điều ấy</char>.</note><verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />Nhưng sự tin kính cùng với sự thỏa lòng là nguồn lợi lớn. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Vì chúng ta đã không đem gì vào trần gian, nên<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fqa">nên</char>, một số thủ bản đọc <char style="fqa">thì rõ ràng là</char>.</note> chúng ta cũng chẳng có thể đem gì đi được. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Mặt khác, khi có cơm ăn, áo mặc, thì chúng ta sẽ được thỏa lòng với những điều ấy. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Còn những kẻ muốn trở nên giàu có thì sa vào cám dỗ và cạm bẫy, với nhiều đam mê ngu xuẩn, tai hại, tức là những thứ nhận chìm người ta vào sự sa bại và hủy diệt. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Vì gốc rễ của đủ thứ điều ác là sự tham tiền, mà một số người, vì thèm khát nó, đã bị dẫn dụ ra khỏi đức tin và gây tổn hại cho mình với nhiều sầu khổ.<verse eid="1TI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Nhưng con, người của Thiên Chúa ơi, hãy lánh xa những điều ấy, mà đeo đuổi sự công chính, tin kính, đức tin, tình yêu thương, tính kiên trì, hòa nhã. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Hãy tranh chiến trong cuộc thi đấu cao đẹp của đức tin, hãy giữ chặt sự sống đời đời, là điều mà con đã được gọi đến và đã tuyên thệ lời xưng nhận tốt lành trước nhiều nhân chứng. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Ta truyền lịnh cho con trước mặt Thiên Chúa, Đấng khiến cho muôn vật được sống, và trước mặt Chúa Cứu Thế Giê-xu, Đấng đưa ra lời xưng nhận tốt lành nơi Bôn-xơ Phi-lát, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />rằng con phải vâng giữ lời răn dạy này cách không hoen ố, không chỗ chê trách, cho đến ngày hiện ra của Chúa chúng ta, là Chúa Cứu Thế Giê-xu, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />là Đấng mà Thiên Chúa Chí Cao đáng tôn ngợi và độc nhất, là Vua của các vua và Chúa của các chúa, sẽ bày tỏ vào đúng thời điểm, <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />chỉ một mình Ngài có sự bất tử, ngự trong sự sáng không thể đến gần được, là Đấng chẳng ai từng nhìn thấy, cũng không ai có thể thấy được, nguyện sự tôn kính và quyền phép đời đời quy về Ngài. A-men.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Hãy truyền bảo người giàu trong đời này đừng kiêu ngạo, cũng đừng trông cậy nơi của cải không chắc chắn, mà trông cậy nơi Thiên Chúa,<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fqa">Thiên Chúa</char>, một số thủ bản đọc <char style="fqa">Thiên Chúa hằng sống</char>.</note> Đấng ban cho chúng ta mọi thứ cách dồi dào để vui hưởng, <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />và truyền bảo họ làm điều lành, dư dật trong việc thiện, có lòng rộng rãi, sẵn sàng chia sẻ, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />tích lũy cho chính mình một nền tảng tốt đẹp cho điều sắp đến, để họ có thể giữ chặt sự sống thật.<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fqa">sự sống thật</char>, một số thủ bản đọc <char style="fqa">sự sống đời đời</char>.</note><verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Ti-mô-thê ơi, con hãy bảo vệ điều được tín thác cho con, tránh đi mấy chuyện vô bổ phàm tục, và những tranh cãi mạo nhận là tri thức, <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />mà một số người, vì tuyên bố như thế, đã đi chệch hướng đức tin.</para>
  <para style="p" vid="1TI 6:21">Nguyện ân điển ở cùng các anh chị em.<note caller="+" style="f"><char style="ft" closed="false">Một số thủ bản thêm </char><char style="fqa">A-men</char> tại đây.</note><verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>