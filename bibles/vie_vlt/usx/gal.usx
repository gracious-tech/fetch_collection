  <book code="GAL" style="id">EN_VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:38:09 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Galatians</para>
  <para style="toc1">Thư Ga-la-ti</para>
  <para style="toc2">Ga-la-ti</para>
  <para style="toc3">Gal</para>
  <para style="mt">Ga-la-ti</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Phao-lô, một sứ đồ — không đến từ loài người, cũng không bởi một người nào, nhưng bởi Chúa Cứu Thế Giê-xu và bởi Thiên Chúa, là Cha, Đấng đã khiến Ngài sống lại từ cõi chết — <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />cùng tất cả các anh em ở với tôi, gửi các hội thánh tại Ga-la-ti: <verse eid="GAL 1:2" /><verse number="3" style="v" sid="GAL 1:3" />Nguyện ân điển đến trên anh chị em cùng với sự bình an từ Thiên Chúa, là Cha, và Chúa chúng ta, là Chúa Cứu Thế Giê-xu, <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />Đấng đã phó mình vì tội lỗi chúng ta, để Ngài có thể giải cứu chúng ta khỏi thời đại gian ác hiện nay, theo ý muốn của Thiên Chúa, Cha chúng ta. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Nguyện vinh quang quy về Ngài cho đến đời đời mãi mãi. A-men.<verse eid="GAL 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Tôi kinh ngạc khi anh chị em quá vội xoay khỏi Đấng đã kêu gọi mình bởi ân điển của Chúa Cứu Thế để theo một phúc âm khác, <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />mà Phúc Âm thì chẳng thể khác đâu, chỉ là bởi mấy người kia là những kẻ gây rối anh chị em và muốn xuyên tạc Phúc Âm của Chúa Cứu Thế. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Nhưng cho dù ngay cả chúng tôi, hay một thiên sứ từ trời, công bố cho anh chị em một phúc âm khác với Phúc Âm mà chúng tôi đã công bố cho anh chị em, thì kẻ đó phải bị nguyền rủa. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Như chúng tôi đã từng nói trước kia, và giờ đây tôi nói lần nữa: “Nếu ai đó công bố cho anh chị em một phúc âm khác với Phúc Âm mà anh chị em đã tiếp nhận, thì kẻ đó phải bị nguyền rủa.” <verse eid="GAL 1:9" /><verse number="10" style="v" sid="GAL 1:10" />Vì hiện giờ, tôi đang làm vừa lòng loài người hay là Thiên Chúa? Hoặc có phải tôi tìm cách làm vừa lòng người ta? Nếu tôi vẫn đang làm vừa lòng người ta, thì ắt hẳn tôi không phải là đầy tớ của Chúa Cứu Thế.<verse eid="GAL 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Thưa anh chị em, tôi xin tỏ cho anh chị em biết về Phúc Âm đã được tôi công bố, rằng Phúc Âm ấy chẳng phải là dựa theo một người nào. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Vì tôi đã không nhận lấy Phúc Âm ấy từ một người nào, tôi cũng không được dạy cho, nhưng đó là bởi sự mạc khải của Chúa Cứu Thế Giê-xu. <verse eid="GAL 1:12" /><verse number="13" style="v" sid="GAL 1:13" />Bởi anh chị em đã nghe về cách sống lúc trước của tôi trong Do Thái giáo, ấy là tôi vốn bức hại quá mức hội thánh của Thiên Chúa, và cứ tìm cách tiêu diệt hội ấy. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Và tôi tấn tớn trong Do Thái giáo hơn hẳn nhiều người cùng trang lứa giữa dân tộc tôi, khi trở nên cực kỳ sốt sắng về các truyền thống của cha ông mình. <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />Nhưng khi Thiên Chúa, Đấng đã biệt riêng tôi từ trong lòng mẹ mình, và đã kêu gọi tôi bởi ân điển Ngài, vui lòng <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />mạc khải Con Ngài trong tôi, để tôi có thể rao giảng về Con ấy giữa vòng các dân ngoại quốc, thì ngay lập tức tôi chẳng bàn với thịt và máu, <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />tôi cũng không đi lên đến Giê-ru-sa-lem để gặp những vị làm sứ đồ trước tôi. Thay vào đó, tôi đã đi tới A-ra-bi, rồi lại quay về tại Đa-mách.<verse eid="GAL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18" />Kế đến, sau ba năm, tôi đi lên đến Giê-ru-sa-lem để làm quen với Sê-pha và ở lại cùng ông ấy mười lăm ngày. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Nhưng tôi đã không gặp một vị nào khác trong các sứ đồ, ngoại trừ Gia-cơ, người em trai của Chúa. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Về những điều tôi viết cho anh chị em, hãy xem đây này, trước mặt Thiên Chúa, tôi không nói dối. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />Sau đó, tôi đi đến các vùng của Sy-ri và Si-li-si. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Bấy giờ, tôi vẫn chưa được các hội thánh trong Chúa Cứu Thế tại Giu-đê biết mặt. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Nhưng các tín hữu vốn chỉ nghe rằng: “Kẻ trước kia bức hại chúng ta hiện đang công bố đức tin mà người ấy từng tìm cách tiêu diệt,” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />nên họ tôn vinh Thiên Chúa vì cớ tôi.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Sau suốt mười bốn năm, tôi lại đi lên đến Giê-ru-sa-lem với Ba-na-ba, khi cũng dẫn Tít cùng đi. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Bấy giờ, theo sự mạc khải, tôi đã đi lên và trình bày trước họ Phúc Âm mà tôi công bố giữa vòng các dân ngoại quốc, nhưng theo cách riêng tư với những vị có vai vế, e rằng cách nào đó mà mình đang chạy hoặc đã chạy trong vô ích. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Dù như thế, ngay cả Tít, người cùng đi với tôi, là người Hy Lạp, cũng không bị buộc phải chịu cắt bì. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Mà chuyện ấy là bởi những anh em giả tạo lén lút, là những kẻ đã thâm nhập vào để theo dõi sự tự do của chúng tôi, là tự do mà chúng tôi có trong Chúa Cứu Thế Giê-xu, hầu cho họ có thể bắt chúng tôi làm nô lệ, <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />nên chúng tôi cũng đã không đưa ra sự nhượng bộ trước họ trong một khoảnh khắc nào, để chân lý của Phúc Âm có thể trường tồn với anh chị em. <verse eid="GAL 2:5" /><verse number="6" style="v" sid="GAL 2:6" />Còn về phần các vị có vẻ là bậc vai vế nào đó (dầu trước kia họ có là bậc nào, thì chẳng làm nên khác biệt gì đối với tôi; Thiên Chúa không nhìn nhận nơi bề ngoài của con người) — thật, những người dường cao trọng đó chẳng cộng thêm điều gì cho tôi cả. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Nhưng trái lại, khi nhận biết rằng tôi đã được tín thác việc công bố Phúc Âm dành cho người chưa chịu cắt bì, giống như Phi-e-rơ là dành cho người chịu cắt bì <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />(vì Đấng hành động trong Phi-e-rơ để thi hành chức sứ đồ hướng đến người chịu cắt bì, cũng hành động trong tôi hướng đến người ngoại quốc), <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />và sau khi hiểu được ân điển đã được ban cho tôi, thì Gia-cơ, Sê-pha, và Giăng, những người giống như là các trụ cột, đã trao tay hữu hiệp thông với Ba-na-ba và tôi, để chúng tôi thì hướng đến các dân ngoại quốc, còn họ hướng về những người chịu cắt bì, <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />chỉ dặn rằng chúng tôi cần nhớ đến người nghèo, chính là điều mà tôi cũng đã sốt sắng thực hiện.<verse eid="GAL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Nhưng khi Sê-pha đi đến An-ti-ốt thì tôi đã chống đối ngay trước mặt ông vì ông vốn đáng bị khiển trách. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Vì trước khi những người từ Gia-cơ đến, ông vốn ăn chung với những người ngoại quốc. Nhưng khi họ đến, ông đã lui khỏi và tách mình riêng ra, vì sợ mấy kẻ thuộc nhóm chủ trương chịu phép cắt bì. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Và những người Do Thái còn lại cũng nhập bọn cách giả tạo theo ông, đến nỗi ngay cả Ba-na-ba cũng bị dẫn dụ theo thói đạo đức giả của họ. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Nhưng khi tôi thấy rằng họ đang không cư xử ngay thật theo chân lý của Phúc Âm, tôi đã nói với Sê-pha trước mặt mọi người: “Nếu anh, là người Do Thái, sống như người ngoại quốc mà không như người Do Thái, thì làm sao anh có thể ép người ngoại quốc phải sống giống người Do Thái?” <verse eid="GAL 2:14" /><verse number="15" style="v" sid="GAL 2:15" />Chúng tôi là người Do Thái từ lúc sanh ra, chứ chẳng phải tội nhân ra từ người ngoại quốc; <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />nhưng vì biết rằng chẳng một ai được xưng công chính nhờ việc làm theo luật pháp, trừ ra là nhờ đức tin nơi Chúa Cứu Thế Giê-xu, nên chúng tôi đã đặt lòng tin nơi Chúa Cứu Thế Giê-xu, để chúng tôi được xưng công chính nhờ đức tin nơi Chúa Cứu Thế mà không phải nhờ việc làm theo luật pháp. Vì mọi xác thịt sẽ không được xưng công chính bởi việc làm theo luật pháp. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />Nhưng nếu, đang khi tìm cách được xưng công chính trong Chúa Cứu Thế, chính chúng tôi cũng bị xét thấy là người có tội, thì chẳng lẽ Chúa Cứu Thế là người phục vụ cho tội lỗi? Điều đó là không thể nào! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Vì nếu tôi xây dựng lại những điều mà mình đã hủy phá, thì tôi chứng tỏ mình là kẻ phạm pháp. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Bởi thông qua luật pháp, tôi đã chết đối với luật pháp, để tôi có thể sống cho Thiên Chúa. Tôi đã bị đóng đinh vào thập tự giá với Chúa Cứu Thế, <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />dù tôi không còn sống nữa, nhưng Chúa Cứu Thế sống trong tôi. Còn cuộc đời mà tôi hiện đang sống trong thân xác, thì tôi sống trong đức tin nơi Con Thiên Chúa, Đấng đã yêu tôi và phó chính mình Ngài thay cho tôi. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Tôi không gạt bỏ ân điển của Thiên Chúa đâu, vì nếu sự công chính là bởi luật pháp, thế thì Chúa Cứu Thế đã chết cách vô ích!<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Ôi, những người Ga-la-ti dại dột! Ai đã bùa ếm anh chị em, khi mà trước mắt anh chị em, Chúa Cứu Thế Giê-xu chịu đóng đinh trên thập tự giá đã được mô tả cách tỏ tường? <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Tôi chỉ muốn tìm hiểu điều này từ anh chị em: Anh chị em đã nhận được Thánh Linh bởi việc làm theo luật pháp hay bởi sự nghe theo trong đức tin? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Anh chị em dại dột như vậy sao? Khi đã khởi đầu bằng Thánh Linh, phải chăng giờ đây anh chị em đang hoàn tất bằng xác thịt? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Có phải anh chị em đã chịu biết bao gian khổ để chẳng được gì? — nếu thật vậy thì quả là vô ích! <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Vậy, Đấng ban Thánh Linh cho anh chị em và thực hiện những việc năng quyền giữa vòng anh chị em, ấy là bởi việc làm theo luật pháp, hay bởi sự nghe theo trong đức tin? <verse eid="GAL 3:5" /><verse number="6" style="v" sid="GAL 3:6" />Như Áp-ra-ham “tin cậy Thiên Chúa và đó là điều để ông được kể là công chính,” <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />thế thì phải hiểu rằng những ai có đức tin, đó là con của Áp-ra-ham. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Nhưng khi thấy trước rằng Thiên Chúa xưng người ngoại quốc là công chính bởi đức tin, thì Kinh Thánh đã rao giảng Phúc Âm trước cho Áp-ra-ham rằng: “Mọi dân tộc sẽ được phước nơi con.” <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Cho nên, ai có đức tin thì được phước cùng với Áp-ra-ham, người có đức tin. <verse eid="GAL 3:9" /><verse number="10" style="v" sid="GAL 3:10" />Biết bao người cậy vào việc làm theo luật pháp thì ở dưới lời nguyền rủa; vì có chép rằng: “Đáng nguyền rủa mọi kẻ không bền lòng với mọi điều được chép trong sách luật để thực hiện chúng.” <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Nhưng rõ ràng rằng chẳng ai nhờ luật pháp được xưng công chính trước mặt Thiên Chúa, vì “người công chính sẽ sống bởi đức tin.” <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Còn luật pháp thì không ra từ đức tin, nhưng “Người làm các việc của luật pháp sẽ sống nhờ chúng.” <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />Chúa Cứu Thế đã chuộc chúng ta khỏi sự nguyền rủa của luật pháp khi chịu nguyền rủa thế cho chúng ta — vì có lời chép: “Đáng nguyền rủa kẻ nào bị treo trên cây gỗ” — <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />để phước lành của Áp-ra-ham đến với người ngoại quốc trong Chúa Cứu Thế Giê-xu, hầu cho chúng ta có thể nhận được lời hứa về Thánh Linh nhờ đức tin.<verse eid="GAL 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Thưa anh chị em, tôi nói theo cách con người. Bất luận thế nào, chẳng ai có thể hủy bỏ hoặc thêm vào giao ước đã được người ta lập ra. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Mặt khác, các lời hứa thì đã được phán với Áp-ra-ham và cho hậu tự của ông. Lời ấy không nói “và cho các hậu tự” như chỉ về nhiều người, nhưng là “và cho hậu tự của con” như chỉ về một người, mà đó là Chúa Cứu Thế. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Nhưng về điều tôi muốn nói đó là: Khi xuất hiện sau bốn trăm ba mươi năm, luật pháp không hủy bỏ giao ước đã được Thiên Chúa thiết lập trước đó nhằm vô hiệu hóa lời hứa. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Vì nếu cơ nghiệp đến từ luật pháp, thì cơ nghiệp ấy không còn là bởi lời hứa. Nhưng Thiên Chúa đã ban ơn cho Áp-ra-ham thông qua lời hứa. <verse eid="GAL 3:18" /><verse number="19" style="v" sid="GAL 3:19" />Thế thì, luật pháp để làm gì? Luật pháp đã được thêm vào vì cớ những sự vi phạm, sau khi được ban hành bởi các thiên sứ qua tay của một người trung gian, cho đến khi nào hậu tự xuất hiện, mà lời hứa đã được lập nên về hậu tự ấy. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Nhưng người trung gian thì không dành cho một bên, mà Thiên Chúa thì có một. <verse eid="GAL 3:20" /><verse number="21" style="v" sid="GAL 3:21" />Vậy, luật pháp đi ngược lại lời hứa hay sao? Điều đó là không thể nào! Vì nếu luật pháp được ban cho mà có thể đem lại sự sống, thì ắt hẳn sự công chính thực sự đến bởi luật pháp. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Nhưng Kinh Thánh đã nhốt hết thảy dưới tội lỗi để bởi đức tin nơi Chúa Cứu Thế Giê-xu, lời hứa có thể được ban cho những người có lòng tin.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Thế nhưng, trước lúc đức tin ấy đến, chúng ta vốn bị giam cầm dưới luật pháp, khi bị nhốt cho tới lúc đức tin được tỏ ra. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Đến nỗi, luật pháp đã trở thành người quản giáo của chúng ta hướng tới Chúa Cứu Thế, để chúng ta có thể được xưng công chính bởi đức tin. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Nhưng sau khi đức tin đến, chúng ta không còn ở dưới người quản giáo nữa. <verse eid="GAL 3:25" /><verse number="26" style="v" sid="GAL 3:26" />Vì hết thảy anh chị em là con của Thiên Chúa nhờ đức tin nơi Chúa Cứu Thế Giê-xu. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Bởi hễ những ai đã chịu báp-têm trong Chúa Cứu Thế thì đều mặc lấy Chúa Cứu Thế. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Không phân biệt Do Thái hay Hy Lạp, không phân biệt nô lệ hay tự do, không phân biệt nam hay nữ, vì hết thảy anh chị em là một trong Chúa Cứu Thế Giê-xu. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Mà nếu anh chị em thuộc Chúa Cứu Thế, thì anh chị em là hậu tự của Áp-ra-ham, là những người thừa kế theo lời hứa.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Nhưng tôi muốn nói rằng cho đến bao giờ người thừa kế còn là trẻ con, thì người ấy chẳng khác gì một nô lệ, dù là chủ nhân của toàn bộ tài sản. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Trái lại, người ấy ở dưới những người giám hộ và các quản gia cho đến thời điểm đã định trước của người cha. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Cũng một thể ấy, khi chúng ta còn là trẻ nhỏ, chúng ta bị làm nô lệ cho các nguyên tắc sơ đẳng của thế gian. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Nhưng khi hồi viên mãn về kỳ hạn đã đến, Thiên Chúa đã sai phái Con Ngài, khi sinh ra từ một người nữ, sinh ra dưới luật pháp, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />để Ngài cứu chuộc những kẻ ở dưới luật pháp, hầu cho chúng ta có thể nhận lấy quyền làm con nuôi. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />Mặt khác, vì anh chị em là con, nên Thiên Chúa đã sai Thánh Linh của Con Ngài vào lòng chúng ta, kêu lớn rằng: “A-ba, Cha.” <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Do đó, anh chị em không còn là nô lệ nữa, nhưng là con, mà nếu là con, thì cũng là người thừa kế nhờ Thiên Chúa.<verse eid="GAL 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Nhưng lúc trước, khi chưa biết Thiên Chúa, anh chị em đã bị nô lệ cho những thứ mà về bản chất chẳng phải là thần gì cả. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Còn hiện nay khi đã nhìn biết Thiên Chúa, mà đúng hơn là đã được Thiên Chúa biết đến, thì làm sao anh chị em lại quay về với các nguyên tắc sơ đẳng kém cỏi và vô dụng, anh chị em mong muốn làm nô lệ cho chúng thêm một lần nữa hay sao? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Anh chị em vẫn xem ngày, tháng, mùa và năm! <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Tôi lo ngại cho anh chị em, e rằng thể nào tôi đã lao nhọc cách vô ích giữa vòng anh chị em.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Thưa anh chị em, tôi xin anh chị em hãy trở nên giống như tôi, vì tôi cũng như anh chị em. Anh chị em chẳng làm tổn hại tôi chút nào. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Anh chị em biết rằng thông qua sự đau yếu trong thân thể này, tôi đã công bố Phúc Âm cho anh chị em lần đầu tiên. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Với sự thử thách trên anh chị em nơi tình trạng thân thể tôi, anh chị em đã chẳng coi thường, cũng không khước từ, trái lại, anh chị em đã đón tiếp tôi như thiên sứ của Thiên Chúa, như Chúa Cứu Thế Giê-xu. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Thế thì, niềm vui sướng ấy của anh chị em đâu rồi? Vì tôi làm chứng về anh chị em rằng, nếu có thể được, anh chị em hẳn đã móc mắt của mình, hiến tặng cho tôi. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Vậy là, tôi đã trở thành kẻ thù của anh chị em vì nói sự thật cho anh chị em sao? <verse eid="GAL 4:16" /><verse number="17" style="v" sid="GAL 4:17" />Những người ấy sốt sắng với anh chị em, chẳng phải có ý tốt, nhưng họ muốn tách riêng anh chị em ra, để anh chị em sốt sắng với họ. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Nhưng chịu sốt sắng mọi lúc cho điều thiện thì tốt, và không phải chỉ khi tôi có mặt với anh chị em. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Các con của ta ơi, vì các con mà ta đang chịu cơn đau chuyển dạ lần nữa cho đến khi Chúa Cứu Thế được thành hình trong các con — <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />mặt khác, ta mong ước ở gần với các con ngay lúc này và thay đổi giọng điệu của ta, vì ta đang nghi ngại về các con.<verse eid="GAL 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Này những người muốn ở dưới luật pháp, hãy cho tôi biết, anh chị em không lắng nghe luật pháp sao? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Vì có lời chép rằng Áp-ra-ham có hai con trai, một là bởi người nữ nô lệ, và một là bởi người nữ tự do. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Tuy nhiên, đứa con từ người nữ nô lệ được sinh ra theo xác thịt, còn đứa con từ người nữ tự do được sinh ra bởi lời hứa. <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />Các việc này thì được nói đến như một ẩn dụ, vì hai người nữ ấy là hai giao ước. Một giao ước tại núi Si-nai, sinh con ra làm nô lệ. Đó là A-ga. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />A-ga là núi Si-nai tại A-ra-bi, và tương ứng với thành Giê-ru-sa-lem hiện nay, vì thành ấy cùng với con cái mình đang làm nô lệ. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Nhưng Giê-ru-sa-lem trên trời thì tự do, mà đó là mẹ của chúng ta. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Vì có lời chép:</para>
  <para style="q" vid="GAL 4:27">“Hãy vui mừng, hỡi người son sẻ, là người nữ không sinh nở;</para>
  <para style="q" vid="GAL 4:27">Hãy cất tiếng lên và reo hò, hỡi người không đau đớn vì sinh con;</para>
  <para style="q" vid="GAL 4:27">Vì con cái của người nữ bị bỏ nhiều hơn con cái của người nữ có chồng.”<verse eid="GAL 4:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="GAL 4:28" />Thưa anh chị em, giống như Y-sác, anh chị em là con của lời hứa. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Tuy nhiên, y như lúc xưa, đứa con được sinh ra theo xác thịt bức hại đứa con theo Thánh Linh như thể nào, thì bây giờ cũng như thể ấy. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Nhưng Kinh Thánh nói gì? “Hãy đuổi người nữ nô lệ và con của nàng. Vì con của người nữ nô lệ chắc chắn sẽ không thừa hưởng cùng với con của người nữ tự do.” <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Vì vậy, thưa anh chị em, chúng ta không phải là con của người nữ nô lệ, nhưng là con của người nữ tự do.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Chúa Cứu Thế đã giải phóng chúng ta để được tự do. Vậy nên, hãy đứng vững và đừng chịu gánh lấy ách nô lệ nữa.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Xin hãy chú ý, tôi, Phao-lô, nói với anh chị em rằng nếu anh chị em cần chịu cắt bì, thì Chúa Cứu Thế sẽ chẳng đem ích lợi gì cho anh chị em cả. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Tôi khẳng định lần nữa với mỗi người chịu cắt bì rằng người ấy có nghĩa vụ phải vâng giữ toàn bộ luật pháp. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Anh chị em nào muốn được xưng công chính bởi luật pháp thì đã bị dứt bỏ khỏi Chúa Cứu Thế, đã trật khỏi ân điển. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Về phần chúng ta, nhờ Thánh Linh, bởi đức tin, chúng ta háo hức trông chờ niềm hy vọng về sự công chính. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Vì trong Chúa Cứu Thế Giê-xu, điều giá trị chẳng phải là cắt bì hay không cắt bì, mà là đức tin được vận hành thông qua tình yêu thương. <verse eid="GAL 5:6" /><verse number="7" style="v" sid="GAL 5:7" />Anh chị em vốn đang chạy tốt. Ai đã ngăn trở anh chị em để không được chân lý bắt phục? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Sự xui giục đó chẳng đến từ Đấng kêu gọi anh chị em! <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Một chút men làm dậy lên cả tảng bột. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Trong Chúa, tôi có lòng tin chắc về anh chị em, rằng anh chị em sẽ không suy nghĩ khác đi. Mặt khác, kẻ nào làm rối trí anh chị em sẽ chịu hình phạt, dù bất kể kẻ đó là ai. <verse eid="GAL 5:10" /><verse number="11" style="v" sid="GAL 5:11" />Nhưng, thưa anh chị em, giả như tôi vẫn rao giảng phép cắt bì thì tại sao tôi còn bị bắt bớ? Nếu thế thì sự vấp phạm vì cớ thập tự giá đã được dẹp bỏ rồi. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Tôi thậm chí ước những kẻ quấy rối anh chị em sẽ tự hoạn mình đi.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Thưa anh chị em, vì anh chị em đã được kêu gọi đến sự tự do, chỉ là sự tự do không phải để đem lại cơ hội cho bản tánh xác thịt, thay vào đó, hãy phục vụ lẫn nhau bởi tình yêu thương. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Vì toàn bộ luật pháp được làm trọn trong một mệnh lệnh: “Con phải yêu thương người lân cận con như chính mình.” <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Còn nếu anh chị em xâu xé và cắn nuốt nhau, thì hãy coi chừng, kẻo anh chị em tiêu diệt lẫn nhau.<verse eid="GAL 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Trái lại, tôi truyền rằng, hãy bước đi theo Thánh Linh, thì anh chị em chắc chắn không làm thỏa mãn các ham muốn của xác thịt. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Vì xác thịt ham muốn trái với Thánh Linh, còn Thánh Linh nghịch với xác thịt. Bởi hai bên xung khắc với nhau, cho nên không có chuyện hễ anh chị em muốn những điều này, thì cứ làm. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Nhưng nếu anh chị em được Thánh Linh dẫn dắt, thì anh chị em không ở dưới luật pháp. <verse eid="GAL 5:18" /><verse number="19" style="v" sid="GAL 5:19" />Các việc làm của xác thịt là rõ ràng, chúng là: gian dâm, bất khiết, phóng đãng, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />thờ hình tượng, ma thuật, thù địch, tranh cạnh, ghen tị, nóng giận, ganh đua, bất hòa, bè phái, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />đố kỵ, say sưa, chè chén cùng những gì tương tự những điều trên, mà về các việc đó, tôi cảnh cáo anh chị em, như tôi đã cảnh cáo trước đây, rằng những ai làm các việc như thế sẽ không hưởng được vương quốc Thiên Chúa. <verse eid="GAL 5:21" /><verse number="22" style="v" sid="GAL 5:22" />Nhưng trái của Thánh Linh là yêu thương, vui mừng, bình an, kiên nhẫn, tử tế, nhân hậu, trung tín, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />hiền hòa, tự chủ; chẳng có luật pháp nào nghịch với những điều như vậy. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Mặt khác, những người thuộc về Chúa Cứu Thế Giê-xu đã đóng đinh bản tánh xác thịt cùng với những ham mê và tham muốn trên thập tự giá.<verse eid="GAL 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GAL 5:25" />Nếu chúng ta sống nhờ Thánh Linh, thì chúng ta cũng cần bước đi theo Thánh Linh. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Đừng trở nên kiêu căng tự phụ khi trêu tức nhau, đố kỵ nhau.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Thưa anh chị em, nếu một người bị phát hiện trong lầm lỗi nào, thì anh chị em là người thuộc linh hãy phục hồi người đó trong tinh thần hiền hòa, khi tự coi chừng bản thân, kẻo mình cũng bị cám dỗ. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Hãy mang gánh nặng cho nhau, và như vậy anh chị em sẽ làm trọn luật pháp của Chúa Cứu Thế. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Vì nếu ai tưởng mình là một bậc nào đó, trong khi chẳng là gì cả, thì người ấy tự lừa dối mình. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Nhưng mỗi người phải tra xét công việc mình, rồi khi ấy người đó sẽ có cớ để khoe ra về riêng mình, mà không phải so với một ai khác. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Vì mỗi người sẽ mang gánh nặng của chính mình.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Mặt khác, người được dạy đạo phải chia sẻ trong mọi vật tốt với người dạy dỗ mình. <verse eid="GAL 6:6" /><verse number="7" style="v" sid="GAL 6:7" />Đừng để bị lừa dối. Thiên Chúa không chịu chế nhạo đâu, vì hễ người ta gieo gì thì sẽ gặt nấy. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Kẻ gieo cho xác thịt mình sẽ từ xác thịt gặt lấy sự hủy diệt. Còn người gieo cho Thánh Linh sẽ từ Thánh Linh gặt được sự sống đời đời. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Chúng ta đừng nên chán mệt khi làm điều lành, vì đến đúng thời điểm, chúng ta sẽ gặt hái kết quả nếu không ngã lòng. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Vậy nên, trong lúc chúng ta có cơ hội, thì chúng ta cần làm điều lành cho mọi người, mà đặc biệt là cho những người trong gia đình đức tin.<verse eid="GAL 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Hãy xem những chữ lớn làm sao mà tôi đã viết cho anh chị em bằng chính tay mình. <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Biết bao kẻ muốn tạo ấn tượng tốt trong xác thịt, họ buộc anh chị em chịu cắt bì, chỉ để họ khỏi phải bị bắt bớ về thập tự giá của Chúa Cứu Thế Giê-xu. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Vì thậm chí chính những kẻ chịu cắt bì đó cũng chẳng tuân giữ luật pháp, nhưng họ muốn anh chị em chịu cắt bì để họ có thể khoe khoang trong xác thịt của anh chị em. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Còn đối với tôi, nguyện chẳng điều gì trở nên cớ để khoe khoang ngoại trừ về thập giá của Chúa Cứu Thế Giê-xu, Chúa chúng ta, bởi thập giá ấy, thế gian đối với tôi đã bị đóng đinh, và tôi đối với thế gian cũng vậy. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Vì không phải việc cắt bì là vấn đề gì, cũng chẳng phải việc không cắt bì, nhưng vấn đề là một tạo vật mới. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Và hễ bất cứ ai sẽ bước đi theo tiêu chuẩn này, thì nguyện bình an và sự thương xót ở trên họ, và trên dân Y-sơ-ra-ên của Thiên Chúa.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Từ nay trở đi, xin đừng ai gây phiền phức cho tôi, vì tôi đang mang trên thân mình các dấu vết của Chúa Giê-xu.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Thưa anh chị em, nguyện ân điển của Chúa chúng ta, Chúa Cứu Thế Giê-xu ở cùng tâm thần anh chị em. A-men.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>