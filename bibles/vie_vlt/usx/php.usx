  <book code="PHP" style="id">EN_VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:39:23 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Philippians</para>
  <para style="toc1">Thư Phi-líp</para>
  <para style="toc2">Phi-líp</para>
  <para style="toc3">Php</para>
  <para style="mt">Phi-líp</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />Phao-lô và Ti-mô-thê, tôi tớ của Chúa Cứu Thế Giê-xu, gửi cho tất cả thánh đồ trong Chúa Cứu Thế Giê-xu, là các tín hữu ở tại thành Phi-líp, cùng với các giám mục và chấp sự. <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />Nguyện ân điển và sự bình an từ Thiên Chúa, là Cha và Chúa chúng ta, là Chúa Cứu Thế Giê-xu, ở trên anh chị em.<verse eid="PHP 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />Tôi cảm tạ Thiên Chúa của tôi trong mọi niềm nhớ nhung về anh chị em, <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />trong mọi lời cầu nguyện của mình cho tất cả anh chị em, luôn dâng lời cầu nguyện với lòng hớn hở <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />vì cớ sự dự phần của anh chị em trong Phúc Âm từ ngày đầu cho đến bây giờ; <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />bởi tin chắc về chính điều này, rằng Đấng đã khởi đầu thực hiện việc lành trong anh chị em sẽ làm trọn cho đến ngày của Chúa Cứu Thế Giê-xu; <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />đối với tôi, thật là điều chính đáng để nghĩ như vậy về tất cả anh chị em, vì tôi giữ anh chị em trong lòng mình, hết thảy anh chị em đều là những cộng sự với tôi bởi ân điển, cả trong xiềng xích của tôi, lẫn trong sự biện hộ và xác chứng cho Phúc Âm. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Vì Thiên Chúa là Đấng chứng thực của tôi, thể nào tôi tha thiết mong mỏi tất cả anh chị em bằng tấm lòng trìu mến của Chúa Cứu Thế Giê-xu. <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />Và điều tôi cầu nguyện đó là tình yêu thương của anh chị em tuôn tràn dư dật, cứ thêm lên càng hơn trong tri thức cùng mọi sự am hiểu, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />để anh chị em có thể xác định điều nào là tốt nhất, hầu cho anh chị em được tinh sạch và không chỗ chê trách cho đến ngày của Chúa Cứu Thế, <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />được đầy dẫy bông trái của sự công chính nhờ Chúa Cứu Thế Giê-xu, hướng đến sự vinh hiển và sự ngợi khen Thiên Chúa.<verse eid="PHP 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />Thưa anh chị em, tôi muốn anh chị em biết rằng những gì xảy đến với tôi thực sự đã diễn ra vì sự tấn tới của Phúc Âm. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />Đến nỗi, vòng xiềng xích của tôi trong Chúa Cứu Thế đã trở nên rõ ràng ở giữa toàn thể lính canh dinh tổng đốc cùng mọi người khác, <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />và phần đông anh chị em, nhờ vòng xiềng xích của tôi, đã vững tin nơi Chúa, càng quyết tâm để rao truyền đạo Chúa cách không sợ hãi. <verse eid="PHP 1:14" /><verse number="15" style="v" sid="PHP 1:15" />Dù thậm chí một số người rao giảng Chúa Cứu Thế vì ganh tị và tranh cạnh, nhưng cũng có người rao giảng với thiện ý, <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />là những người vì tình yêu thương, biết rằng tôi được chỉ định để bênh vực Phúc Âm, <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />nhưng những kẻ bởi tham vọng ích kỷ, họ rao giảng Chúa Cứu Thế cách không thành thật, tưởng gia thêm phiền não vào vòng xiềng xích của tôi. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />Vậy thì sao? Cho dù là bởi cách nào — hoặc là giả vờ hay là ngay thật — thì Chúa Cứu Thế được rao giảng, và tôi vui mừng về điều đó. Mặt khác, tôi cũng sẽ được làm cho vui mừng, <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />vì tôi biết rằng điều này sẽ đem sự giải cứu đến cho tôi, nhờ sự cầu nguyện của anh chị em và sự giúp đỡ từ Thánh Linh của Chúa Cứu Thế Giê-xu, <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />theo như sự háo hức mong chờ và niềm hy vọng của tôi, đó là tôi sẽ không bị làm cho hổ thẹn trong bất cứ chuyện gì, nhưng dạn dĩ trong mọi sự, để lúc này cũng như bất kỳ lúc nào, Chúa Cứu Thế sẽ được tôn cao nơi thân thể tôi, bất luận sống hay chết. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />Vì đối với tôi, sống là Chúa Cứu Thế, và chết là điều ích lợi. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />Còn nếu vẫn sống trong xác thịt, thì đối với tôi ấy là việc kết quả ích lợi cho công tác, nên tôi không biết mình sẽ lựa chọn bên nào. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />Tôi bị ép giữa hai bên, khi có mong muốn để ra đi và ở với Chúa Cứu Thế, vì đó là điều tốt hơn rất nhiều, <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />nhưng cứ ở lại trong xác thịt là điều cần hơn cho anh chị em. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Khi đã tin chắc điều đó, tôi biết rằng mình sẽ ở lại và còn ở tiếp tục với tất cả anh chị em, vì sự tăng trưởng và niềm vui trong đức tin của anh chị em, <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />để sự hãnh diện của anh chị em trong Chúa Cứu Thế Giê-xu về tôi sẽ dâng tràn qua việc tôi đến gặp anh chị em lần nữa. <verse eid="PHP 1:26" /><verse number="27" style="v" sid="PHP 1:27" />Chỉ có điều anh chị em phải sống cách xứng hiệp với Phúc Âm của Chúa Cứu Thế, để dù khi tôi đến và xem xét anh chị em hay khi vắng mặt, thì tôi có thể nghe về anh chị em rằng anh chị em đứng vững trong một tâm thần, với một tâm trí cùng chiến đấu vì đức tin của Phúc Âm, <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />và không bị những kẻ chống đối làm cho kinh hãi trong bất kỳ điều gì. Đây là dấu hiệu về sự hư nát dành cho họ, nhưng là dấu hiệu về sự cứu rỗi của anh chị em — và điều này từ Thiên Chúa. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Vì nhờ Chúa Cứu Thế, ân phước đã được ban cho anh chị em không chỉ để tin nơi Ngài, nhưng cũng để chịu khổ vì Ngài, <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />khi có cùng sự tranh đấu mà anh chị em đã thấy nơi tôi, và hiện đang nghe nơi tôi.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Vậy nên, nếu trong Chúa Cứu Thế có sự khích lệ nào, nếu có sự yên ủi nào bởi tình yêu thương, nếu có mối thông công nào trong Thánh Linh, nếu có lòng yêu mến và sự thương xót nào, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />thì hãy làm trọn vẹn niềm vui mừng của tôi, đó là anh chị em có đồng tâm trí, khi có đồng tình yêu thương, hiệp một trong tâm hồn, suy nghĩ về một hướng. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Không làm việc gì do lòng ích kỷ hoặc vì hư vinh, trái lại, với lòng khiêm nhường, xem người khác tôn trọng hơn mình, <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />mỗi người không chỉ quan tâm đến quyền lợi của riêng mình, mà còn quyền lợi của những người khác nữa. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />Hãy có tâm trí như thế trong anh chị em, cũng là tâm trí trong Chúa Cứu Thế Giê-xu,<verse eid="PHP 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PHP 2:6" />là Đấng hiện hữu trong hình trạng Thiên Chúa,</para>
  <para style="q" vid="PHP 2:6">đã không xem điều cần phải giữ lấy</para>
  <para style="q" vid="PHP 2:6">là sự bình đẳng với Thiên Chúa.<verse eid="PHP 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PHP 2:7" />Thay vào đó, Ngài đã tự làm cho mình ra trống không</para>
  <para style="q" vid="PHP 2:7">khi mặc lấy hình trạng đầy tớ,</para>
  <para style="q" vid="PHP 2:7">được sinh ra trong hình ảnh giống như loài người,</para>
  <para style="q" vid="PHP 2:7">và được nhìn thấy trong dáng vẻ như một con người,<verse eid="PHP 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PHP 2:8" />Ngài đã tự hạ mình xuống khi chịu vâng phục cho đến chết,</para>
  <para style="q" vid="PHP 2:8">thậm chí chết trên cây thập tự.<verse eid="PHP 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PHP 2:9" />Vì thế, Thiên Chúa cũng đã tôn Ngài lên rất cao</para>
  <para style="q" vid="PHP 2:9">và đã ban cho Ngài danh trên mọi danh,<verse eid="PHP 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PHP 2:10" />hầu cho nghe đến danh Chúa Giê-xu,</para>
  <para style="q" vid="PHP 2:10">mọi đầu gối trên trời, dưới đất, bên dưới đất, phải quỳ xuống,<verse eid="PHP 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PHP 2:11" />và mọi lưỡi đều xưng nhận rằng Chúa Cứu Thế Giê-xu là Chúa,</para>
  <para style="q" vid="PHP 2:11">quy vinh quang thuộc Thiên Chúa, là Cha.<verse eid="PHP 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Vậy nên, những người yêu dấu của tôi ơi, theo như cách anh chị em đã luôn vâng lời, khi không chỉ ở trong sự hiện diện của tôi, mà bây giờ càng nhiều hơn trong sự vắng mặt của tôi, anh chị em hãy cứ thực hành ơn cứu rỗi của mình với sự kính sợ và run rẩy. <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />Vì Thiên Chúa là Đấng đang hành động trong anh chị em để vừa muốn vừa làm theo ý tốt của Ngài. <verse eid="PHP 2:13" /><verse number="14" style="v" sid="PHP 2:14" />Hãy làm mọi việc mà không càm ràm hoặc cãi cọ, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />để anh chị em được trở nên những người con không chỗ chê trách và thanh sạch của Thiên Chúa, chẳng tì vết ở giữa một thế hệ gian tà và sa đọa, mà tại đó anh chị em chiếu sáng như những ngọn đèn trong thế gian, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />khi giữ vững lời sự sống, vì sự hãnh diện của tôi trong ngày của Chúa Cứu Thế đó là mình đã không chạy trong vô ích, cũng không lao nhọc cách luống công. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />Nhưng thậm chí cho dù tôi bị đổ huyết ra để rưới trên sinh tế và lễ vật của đức tin anh chị em, thì tôi vẫn hân hoan, và chung vui với tất cả anh chị em. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />Anh chị em cũng như vậy, hãy hân hoan và chung vui với tôi.<verse eid="PHP 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />Trong Chúa, là Chúa Giê-xu, tôi hy vọng sớm gửi gắm Ti-mô-thê đến thăm anh chị em, để tôi cũng cảm thấy phấn chấn khi biết tin tức về anh chị em. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />Vì tôi không có ai khác đồng tâm tình như cậu ấy, là người thật lòng lo nghĩ những lợi ích đối với anh chị em, <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />vì những người khác đều tìm kiếm các lợi ích riêng, chẳng phải những điều thuộc về Chúa Cứu Thế Giê-xu. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Nhưng anh chị em biết phẩm hạnh của cậu ấy, vì giống như con với cha, cậu ấy đã phục vụ cho Phúc Âm cùng với tôi. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />Cho nên tôi hy vọng sai phái cậu ấy ngay khi tôi biết sự tình của mình sẽ thế nào. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />Nhưng tôi tin chắc nơi Chúa rằng chính tôi cũng sẽ sớm đến thăm anh chị em. <verse eid="PHP 2:24" /><verse number="25" style="v" sid="PHP 2:25" />Mặt khác, tôi nghĩ cần phải gửi Ép-ba-phô-đích về lại cho anh chị em, cậu ấy là người anh em và bạn đồng lao cũng là chiến hữu của tôi, là sứ giả từ anh chị em và là người phục vụ cho nhu cầu của tôi, <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />vì nhận ra rằng cậu hết sức mong mỏi được ở với tất cả anh chị em, và cảm thấy phiền muộn vì anh chị em đã nghe rằng cậu ấy bị bệnh. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />Vì đúng là cậu ấy đã bị bệnh gần chết, nhưng Thiên Chúa đã thương xót cậu ấy, mà không chỉ cậu ấy thôi đâu, nhưng còn tôi nữa, để tôi khỏi chịu buồn rầu càng thêm buồn rầu. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />Cho nên, tôi nôn nóng sai cậu ấy đi, để khi gặp lại cậu ấy, anh chị em có thể vui mừng, và tôi cũng được bớt buồn rầu. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Vì vậy, hãy tiếp đón cậu ấy trong Chúa bằng tất cả niềm vui, đồng thời hãy có lòng tôn trọng những ai như vậy, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />bởi vì công việc của Chúa Cứu Thế mà cậu ấy thậm chí suýt chết, khi liều mạng sống mình để có thể làm trọn phần hạn chế trong sự phục vụ của anh chị em dành cho tôi.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />Sau cùng, thưa anh chị em của tôi, hãy vui mừng trong Chúa. Đối với tôi, chẳng phiền hà gì khi viết lại cùng những điều này cho anh chị em, vì là sự an toàn dành cho anh chị em. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />Hãy coi chừng lũ chó, hãy coi chừng những kẻ làm công gian tà, hãy coi chừng phép cắt bì giả. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />Vì chúng ta chịu phép cắt bì thật — tức là những người thờ phượng bằng Thánh Linh của Thiên Chúa, hãnh diện trong Chúa Cứu Thế Giê-xu, và không trông cậy nơi xác thịt, <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />mặc dù tôi thậm chí có lý cớ trông cậy nơi xác thịt. Nếu ai khác nghĩ có lý cớ để cậy nơi xác thịt, thì tôi còn có nhiều hơn: <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />tôi chịu phép cắt bì vào ngày thứ tám, thuộc dân tộc Y-sơ-ra-ên, chi phái Bên-gia-min, người Hê-bơ-rơ, con của người Hê-bơ-rơ; về luật pháp, là người Pha-ri-si; <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />về lòng nhiệt thành thì bức hại hội thánh; về sự công chính theo luật pháp thì được cho là không chỗ chê trách. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />Tuy nhiên, bất cứ điều gì vốn là lợi đối với tôi, thì vì cớ Chúa Cứu Thế, tôi đã xem chúng là lỗ. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Nhưng còn hơn thế nữa, tôi thậm chí xem hết thảy đều là lỗ vì cớ giá trị trổi hơn hết của sự nhận biết về Chúa Cứu Thế Giê-xu, Chúa của tôi, vì Ngài mà tôi đã chịu mất tất cả — thật, tôi xem chúng như rác rưởi — hầu cho tôi được Chúa Cứu Thế <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />và được tìm thấy trong Ngài, không phải vì có sự công chính nơi bản thân mình từ luật pháp nhưng là sự công chính nhờ đức tin nơi Chúa Cứu Thế — tức là sự công chính đến từ Thiên Chúa trên căn bản đức tin — <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />để nhận biết Ngài và quyền năng sự sống lại của Ngài cùng với sự thông công trong những khổ nạn của Ngài, khi được đem đến chỗ đồng dạng với sự chết của Ngài, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />dù bằng phương cách nào, thì tôi có thể đạt đến sự sống lại từ cõi chết. <verse eid="PHP 3:11" /><verse number="12" style="v" sid="PHP 3:12" />Ấy không phải là tôi đã đoạt giải rồi, hoặc đã được hoàn hảo rồi, nhưng tôi đang đeo đuổi sao cho mình có thể giành lấy giải mà vì cớ đó, tôi cũng đã được Chúa Cứu Thế Giê-xu giành lấy. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />Thưa anh chị em, tôi không cho là bản thân mình đã giành được. Nhưng tôi cứ làm một điều: khi quên đi những gì đằng sau mà vươn tới những điều phía trước, <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />hướng tới mục tiêu, tôi đang đeo đuổi cho được giải thưởng về sự kêu gọi ở trên trời của Thiên Chúa trong Chúa Cứu Thế Giê-xu. <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />Vậy nên, tất cả những ai trưởng thành đều cần quan niệm như vậy, còn giả như có điểm nào anh chị em nghĩ cách khác biệt, Thiên Chúa cũng sẽ bày tỏ điều đó cho anh chị em. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Tuy nhiên, chúng ta đã đạt đến mức nào thì nên bước đi theo mức đó.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />Thưa anh chị em, hãy trở nên những người bắt chước tôi, và hãy chăm xem những người đang sống trong mẫu mực ấy, theo như gương mẫu anh chị em thấy nơi chúng tôi. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />Vì có nhiều người — là những kẻ mà tôi đã thường nói với anh chị em, nhưng bây giờ tôi thậm chí phải khóc mà nói — họ đang sống như kẻ thù nghịch thập tự giá của Chúa Cứu Thế, <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />kết cục của những kẻ đó là hư nát, chúa của họ là cái bụng, và vinh quang của họ ở trong việc làm đáng xấu hổ của họ, tức là những kẻ chỉ nghĩ đến các việc trần gian. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />Nhưng vì địa vị công dân của chúng ta sẵn có trên trời, mà từ nơi đó chúng ta háo hức chờ đợi Đấng Giải Cứu, là Chúa, tức Chúa Cứu Thế Giê-xu, <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />là Đấng sẽ biến hóa thân thể thấp hèn của chúng ta trở nên đồng dạng với thân thể vinh quang của Ngài, y theo sự vận hành của năng quyền Ngài để bắt phục muôn vật cho mình.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Thế thì, thưa anh chị em yêu quý và mong nhớ của tôi, niềm vui và mão miện của tôi, anh chị em yêu quý ơi, hãy cứ đứng vững như vậy trong Chúa.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />Tôi nài khuyên Ê-vô-đi và nài khuyên Sin-ty-cơ có đồng tâm trí trong Chúa. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />Chắc chắn rằng, tôi cũng xin anh, người đồng lao chân thật ơi, anh hãy hỗ trợ các cô ấy, họ đã cùng tôi tranh đấu cho Phúc Âm, cùng với Cơ-lê-măn và các bạn đồng lao khác của tôi, mà tên của họ ở trong Sách Sự Sống.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />Hãy cứ luôn vui mừng trong Chúa. Tôi sẽ nói nữa, hãy vui mừng lên! <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />Hãy để mọi người biết tính nết hiền hòa của anh chị em. Chúa đã gần rồi. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />Đừng lo lắng gì cả, thay vào đó, trong mọi việc, bằng sự cầu nguyện và nài xin cùng với sự tạ ơn, hãy để các lời khẩn cầu của anh chị em được thổ lộ cho Thiên Chúa, <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />rồi sự bình an của Thiên Chúa, là điều vượt quá mọi hiểu biết, sẽ giữ gìn lòng anh chị em và tâm trí của anh chị em trong Chúa Cứu Thế Giê-xu.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />Sau cùng, thưa anh chị em, hễ điều gì là chân thật, hễ điều gì đáng tôn quý, hễ điều gì công chính, hễ điều gì thanh sạch, hễ điều gì đáng yêu, hễ điều gì có tiếng tốt, nếu điều nào đức hạnh và nếu điều nào đáng khen, thì anh chị em phải nghĩ đến chúng. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />Những gì anh chị em đã học biết, đã tiếp thu, đã nghe và đã thấy nơi tôi, thì hãy thực hành những điều đó, rồi Thiên Chúa bình an sẽ ở cùng anh chị em.<verse eid="PHP 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Tôi rất được vui mừng trong Chúa vì hiện cuối cùng anh chị em lại quan tâm đến tôi, thật ra, trong chuyện này, anh chị em vốn đã quan tâm đến tôi, nhưng không có cơ hội bày tỏ. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />Ấy chẳng phải là tôi nói về nhu cầu mình, vì tôi đã học phải thỏa lòng dù tôi ở trong hoàn cảnh nào. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />Tôi vừa biết bị nghèo nàn, vừa biết có dư dật. Trong từng biến cố và trong mọi hoàn cảnh, tôi đã học cả lúc được no và khi chịu đói, cả lúc có dư dật và khi bị thiếu thốn. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />Tôi có đủ sức đối diện tất cả nhờ Đấng làm cho tôi mạnh mẽ. <verse eid="PHP 4:13" /><verse number="14" style="v" sid="PHP 4:14" />Tuy nhiên, anh chị em đã làm tốt khi cùng chia sẻ khó khăn của tôi. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Thưa anh chị em thành Phi-líp, anh chị em cũng biết rằng trong buổi đầu của Phúc Âm, khi tôi rời khỏi Ma-xê-đoan, không có hội thánh nào san sẻ với tôi trong vấn đề chi thu, ngoại trừ một mình anh chị em, <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />vì ngay tại Tê-sa-lô-ni-ca, anh chị em đã một hai lần gửi đồ cần dùng cho tôi. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />Ấy không phải là tôi mong tìm quà cáp, mà tôi mong tìm kết quả gia thêm dư dật vào phần ích lợi của anh chị em. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />Tôi đang có đủ mọi thứ và dư dật nữa. Tôi đã được đầy đủ, khi nhận nơi Ép-ba-phô-đích tặng phẩm đến từ anh chị em, là hương thơm, là sinh tế được chấp nhận, là điều đẹp lòng Thiên Chúa. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />Thiên Chúa của tôi sẽ đáp ứng đầy đủ mọi nhu cầu của anh chị em theo sự giàu có của Ngài trong sự vinh hiển nơi Chúa Cứu Thế Giê-xu. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />Nguyện vinh quang thuộc về Thiên Chúa, Cha chúng ta, cho đến đời đời vô cùng. A-men.<verse eid="PHP 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Xin chào thăm mọi thánh đồ trong Chúa Cứu Thế Giê-xu. Các anh em ở cùng tôi chào thăm anh chị em. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Tất cả thánh đồ chào thăm anh chị em, mà đặc biệt là những người thuộc nhà Xê-xa.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />Nguyện ân điển của Chúa, là Chúa Cứu Thế Giê-xu ở cùng tâm linh anh chị em. A-men.<note caller="+" style="f"><char style="ft" closed="false">Một số cổ bản không có từ: </char><char style="fqa">A-men</char>.</note><verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>