<usx version="3.0">
  <book code="AMO" style="id">EN_VLT vi_Vietnamese_ltr Thu Jun 13 2024 11:05:08 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Amos</para>
  <para style="toc1">Sách A-mốt</para>
  <para style="toc2">A-mốt</para>
  <para style="toc3">Amo</para>
  <para style="mt">A-mốt</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />Đây là những lời của A-mốt, người ở trong số các mục đồng tại Thê-cô-a, là sứ điệp mà ông đã thấy về Y-sơ-ra-ên trong thời Ô-xia, vua Giu-đa, và trong thời Giê-rô-bô-am, con trai Giô-ách, vua Y-sơ-ra-ên, hai năm trước trận động đất. <verse eid="AMO 1:1" /><verse number="2" style="v" sid="AMO 1:2" />Ông nói:</para>
  <para style="q" vid="AMO 1:2">“Chúa Hằng Hữu sẽ gầm thét từ Si-ôn;</para>
  <para style="q" vid="AMO 1:2">Ngài sẽ khiến tiếng Ngài vang ra từ Giê-ru-sa-lem.</para>
  <para style="q" vid="AMO 1:2">Những đồng cỏ của các mục đồng sẽ héo úa;</para>
  <para style="q" vid="AMO 1:2">đỉnh núi Cạt-mên sẽ khô cằn.”<verse eid="AMO 1:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="AMO 1:3" />Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 1:3">“Vì tội lỗi của Đa-mách gấp ba,</para>
  <para style="q" vid="AMO 1:3">thậm chí gấp bốn lần,</para>
  <para style="q" vid="AMO 1:3">nên Ta sẽ không rút hình phạt lại,</para>
  <para style="q" vid="AMO 1:3">bởi nó đã đánh đập Ga-la-át với những công cụ bằng sắt.<verse eid="AMO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 1:4" />Ta sẽ sai lửa đi vào trong nhà Ha-xa-ên,</para>
  <para style="q" vid="AMO 1:4">và nó sẽ thiêu nuốt các đền đài của Bên Ha-đát.<verse eid="AMO 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 1:5" />Ta sẽ bẻ gãy các then cài cổng của Đa-mách</para>
  <para style="q" vid="AMO 1:5">và diệt trừ kẻ cai trị Thung Lũng A-vên,</para>
  <para style="q" vid="AMO 1:5">cũng như kẻ cầm quyền trượng tại Bết Ê-đen.</para>
  <para style="q" vid="AMO 1:5">Dân A-ram sẽ bị bắt lưu đày qua Ki-rơ,”</para>
  <para style="q" vid="AMO 1:5">Chúa Hằng Hữu đã phán như vậy.<verse eid="AMO 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 1:6" />Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 1:6">“Vì tội lỗi của Ga-xa gấp ba,</para>
  <para style="q" vid="AMO 1:6">thậm chí gấp bốn lần,</para>
  <para style="q" vid="AMO 1:6">nên Ta sẽ không rút hình phạt lại,</para>
  <para style="q" vid="AMO 1:6">bởi nó đã đem đi toàn bộ phu tù,</para>
  <para style="q" vid="AMO 1:6">để giao nộp cho Ê-đôm.<verse eid="AMO 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 1:7" />Ta sẽ sai lửa đến trên các vách thành Ga-xa,</para>
  <para style="q" vid="AMO 1:7">và nó sẽ thiêu nuốt các đền đài của nơi ấy.<verse eid="AMO 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 1:8" />Ta sẽ diệt trừ kẻ cư ngụ tại Ách-đốt</para>
  <para style="q" vid="AMO 1:8">và đứa cầm quyền trượng khỏi Ách-ca-lôn.</para>
  <para style="q" vid="AMO 1:8">Ta sẽ trở tay chống lại Éc-rôn,</para>
  <para style="q" vid="AMO 1:8">và làm cho phần còn lại của dân Phi-li-tin diệt vong,”</para>
  <para style="q" vid="AMO 1:8">Chúa là Chúa Hằng Hữu đã phán như vậy.<verse eid="AMO 1:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 1:9" />Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 1:9">“Vì tội lỗi của Ty-rơ gấp ba,</para>
  <para style="q" vid="AMO 1:9">thậm chí gấp bốn lần,</para>
  <para style="q" vid="AMO 1:9">nên Ta sẽ không rút hình phạt lại,</para>
  <para style="q" vid="AMO 1:9">bởi nó đã giao nộp toàn bộ phu tù cho Ê-đôm,</para>
  <para style="q" vid="AMO 1:9">và chúng chẳng nhớ đến giao ước huynh đệ của mình.<verse eid="AMO 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 1:10" />Ta sẽ sai lửa đến trên các vách thành Ty-rơ,</para>
  <para style="q" vid="AMO 1:10">và nó sẽ thiêu nuốt các đền đài của nơi ấy.”<verse eid="AMO 1:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 1:11" />Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 1:11">“Vì tội lỗi của Ê-đôm gấp ba,</para>
  <para style="q" vid="AMO 1:11">thậm chí gấp bốn lần,</para>
  <para style="q" vid="AMO 1:11">nên Ta sẽ không rút hình phạt lại,</para>
  <para style="q" vid="AMO 1:11">vì nó truy đuổi anh em mình bằng gươm</para>
  <para style="q" vid="AMO 1:11">và gạt bỏ hết lòng thương xót.</para>
  <para style="q" vid="AMO 1:11">Cơn giận của nó không ngừng sôi sục,</para>
  <para style="q" vid="AMO 1:11">và cơn thịnh nộ nó kéo dài mãi mãi.<verse eid="AMO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 1:12" />Ta sẽ sai lửa đến trên Thê-man,</para>
  <para style="q" vid="AMO 1:12">và nó sẽ thiêu nuốt các đền đài của Bốt-ra.”<verse eid="AMO 1:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="AMO 1:13" />Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 1:13">“Vì tội lỗi của con cháu Am-môn gấp ba,</para>
  <para style="q" vid="AMO 1:13">thậm chí gấp bốn lần,</para>
  <para style="q" vid="AMO 1:13">nên Ta sẽ không rút hình phạt lại,</para>
  <para style="q" vid="AMO 1:13">bởi nó đã mổ banh những phụ nữ mang thai của Ga-la-át,</para>
  <para style="q" vid="AMO 1:13">để nó có thể mở rộng bờ cõi mình.<verse eid="AMO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 1:14" />Ta sẽ đốt lửa trong các vách thành của Ráp-ba,</para>
  <para style="q" vid="AMO 1:14">và nó sẽ thiêu nuốt các đền đài của nơi ấy,</para>
  <para style="q" vid="AMO 1:14">giữa tiếng hò hét trong ngày chiến trận,</para>
  <para style="q" vid="AMO 1:14">giữa cơn cuồng phong trong ngày bão tố.<verse eid="AMO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 1:15" />Vua chúng sẽ đi lưu đày,</para>
  <para style="q" vid="AMO 1:15">hắn cùng với các quan chức của hắn,”</para>
  <para style="q" vid="AMO 1:15">Chúa Hằng Hữu đã phán như vậy.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="q">
    <verse number="1" style="v" sid="AMO 2:1" />Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 2:1">“Vì tội lỗi của Mô-áp gấp ba,</para>
  <para style="q" vid="AMO 2:1">thậm chí gấp bốn lần,</para>
  <para style="q" vid="AMO 2:1">nên Ta sẽ không rút hình phạt lại,</para>
  <para style="q" vid="AMO 2:1">bởi nó đã đốt hài cốt</para>
  <para style="q" vid="AMO 2:1">của vua Ê-đôm thành vôi.<verse eid="AMO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 2:2" />Ta sẽ sai lửa đến trên Mô-áp,</para>
  <para style="q" vid="AMO 2:2">và nó sẽ thiêu nuốt các đền đài của Kê-ri-giốt.</para>
  <para style="q" vid="AMO 2:2">Mô-áp sẽ chết trong cơn náo loạn,</para>
  <para style="q" vid="AMO 2:2">với sự la hét cùng tiếng tù và.<verse eid="AMO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 2:3" />Ta sẽ diệt trừ kẻ cai trị ở nơi nó,</para>
  <para style="q" vid="AMO 2:3">và Ta sẽ giết hết thảy các tướng lĩnh chung với hắn,”</para>
  <para style="q" vid="AMO 2:3">Chúa Hằng Hữu đã phán như vậy.<verse eid="AMO 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="AMO 2:4" />Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 2:4">“Vì tội lỗi của Giu-đa gấp ba,</para>
  <para style="q" vid="AMO 2:4">thậm chí gấp bốn lần,</para>
  <para style="q" vid="AMO 2:4">nên Ta sẽ không rút hình phạt lại,</para>
  <para style="q" vid="AMO 2:4">bởi chúng nó đã khước từ luật pháp của Chúa Hằng Hữu</para>
  <para style="q" vid="AMO 2:4">và không tuân giữ các quy định của Ngài.</para>
  <para style="q" vid="AMO 2:4">Những thứ giả dối nơi chúng làm cho chúng lầm lạc,</para>
  <para style="q" vid="AMO 2:4">tức là những thứ mà tổ phụ chúng nó đã đi theo.<verse eid="AMO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 2:5" />Ta sẽ sai lửa đến trên Giu-đa,</para>
  <para style="q" vid="AMO 2:5">và nó sẽ thiêu nuốt các đền đài của Giê-ru-sa-lem.”<verse eid="AMO 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 2:6" />Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 2:6">“Vì tội lỗi của Y-sơ-ra-ên gấp ba,</para>
  <para style="q" vid="AMO 2:6">thậm chí gấp bốn lần,</para>
  <para style="q" vid="AMO 2:6">nên Ta sẽ không rút hình phạt lại,</para>
  <para style="q" vid="AMO 2:6">bởi chúng nó đã bán người ngay thẳng lấy bạc,</para>
  <para style="q" vid="AMO 2:6">và người thiếu thốn lấy một đôi dép.<verse eid="AMO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 2:7" />Chúng đạp đầu những người nghèo yếu vào bùn đất;</para>
  <para style="q" vid="AMO 2:7">chúng làm cho lệch lạc con đường của những ai khiêm nhường.</para>
  <para style="q" vid="AMO 2:7">Con và cha đến ăn nằm với cùng một cô gái</para>
  <para style="q" vid="AMO 2:7">để rồi làm cho ô uế danh thánh của Ta.<verse eid="AMO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 2:8" />Bên cạnh mọi bàn thờ, chúng nằm xuống trên các y phục bị cầm cố;</para>
  <para style="q" vid="AMO 2:8">và trong nhà của Thiên Chúa mình, chúng uống rượu bằng tiền những kẻ bị phạt.<verse eid="AMO 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 2:9" />Thế mà Ta đã tuyệt diệt dân A-mô-rít trước mặt chúng,</para>
  <para style="q" vid="AMO 2:9">tức là dân cao lớn như thể chiều cao cây tuyết tùng;</para>
  <para style="q" vid="AMO 2:9">dân nó mạnh mẽ như những cây sồi.</para>
  <para style="q" vid="AMO 2:9">Dẫu vậy, Ta đã tuyệt diệt trái của nó bên trên</para>
  <para style="q" vid="AMO 2:9">lẫn rễ của nó bên dưới.<verse eid="AMO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 2:10" />Ta cũng đã đem các con lên khỏi xứ Ai Cập</para>
  <para style="q" vid="AMO 2:10">và dẫn dắt các con trong hoang mạc bốn mươi năm</para>
  <para style="q" vid="AMO 2:10">để chiếm hữu xứ của dân A-mô-rít.<verse eid="AMO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 2:11" />Ta đã dấy lên các vị tiên tri từ trong số con cháu các con</para>
  <para style="q" vid="AMO 2:11">và những người Na-xi-rê từ các trai tráng của các con.</para>
  <para style="q" vid="AMO 2:11">Mọi việc chẳng phải như vậy sao,</para>
  <para style="q" vid="AMO 2:11">hỡi con cháu Y-sơ-ra-ên? —</para>
  <para style="q" vid="AMO 2:11">đó là lời tuyên phán của Chúa Hằng Hữu.<verse eid="AMO 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 2:12" />Nhưng các con ép người Na-xi-rê uống rượu</para>
  <para style="q" vid="AMO 2:12">và ra lệnh cho các vị tiên tri, rằng: ‘Đừng nói tiên tri!’<verse eid="AMO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 2:13" />Xem này, Ta sẽ đè nát các con</para>
  <para style="q" vid="AMO 2:13">như thể chiếc xe đầy thóc lúa đè nát người ta.<verse eid="AMO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 2:14" />Kẻ lanh lẹ bị lạc mất nơi trú ẩn;</para>
  <para style="q" vid="AMO 2:14">kẻ mạnh khỏe sẽ chẳng phát huy sức lực mình;</para>
  <para style="q" vid="AMO 2:14">kẻ cường tráng cũng chẳng cứu được bản thân.<verse eid="AMO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 2:15" />Người cầm cung sẽ chẳng đứng vững;</para>
  <para style="q" vid="AMO 2:15">người nhanh chân sẽ chạy không thoát;</para>
  <para style="q" vid="AMO 2:15">người cưỡi ngựa sẽ không trốn được mà còn sống.<verse eid="AMO 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="AMO 2:16" />Thậm chí các chiến binh gan dạ nhất</para>
  <para style="q" vid="AMO 2:16">sẽ trần trụi chạy trốn trong ngày ấy —</para>
  <para style="q" vid="AMO 2:16">đó là lời tuyên phán của Chúa Hằng Hữu.”<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />Này con dân Y-sơ-ra-ên, hãy nghe lời này, tức là lời Chúa Hằng Hữu phán nghịch với các con, nghịch với cả dòng tộc mà Ta đã đem lên khỏi xứ Ai Cập, rằng:<verse eid="AMO 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 3:2" />“Ta đã biết chỉ một mình con</para>
  <para style="q" vid="AMO 3:2">giữa hết thảy các dòng tộc trên đất.</para>
  <para style="q" vid="AMO 3:2">Thế nên, Ta sẽ hình phạt con</para>
  <para style="q" vid="AMO 3:2">vì hết thảy tội lỗi của con.”<verse eid="AMO 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 3:3" />Hai người sẽ cùng đi với nhau được không</para>
  <para style="q" vid="AMO 3:3">nếu họ chẳng nhất trí?<verse eid="AMO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 3:4" />Sư tử sẽ rống vang trong rừng</para>
  <para style="q" vid="AMO 3:4">khi nó không có con mồi sao?</para>
  <para style="q" vid="AMO 3:4">Sư tử tơ sẽ gầm gừ trong hang nếu nó chẳng bắt được gì sao?<verse eid="AMO 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 3:5" />Liệu con chim sẽ sa vào bẫy dưới đất</para>
  <para style="q" vid="AMO 3:5">khi không có mồi đặt để bắt nó?</para>
  <para style="q" vid="AMO 3:5">Liệu chiếc bẫy sẽ bật lên khỏi đất</para>
  <para style="q" vid="AMO 3:5">khi nó chẳng bắt được chi?<verse eid="AMO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 3:6" />Chẳng lẽ kèn thổi vang trong thành,</para>
  <para style="q" vid="AMO 3:6">mà dân chúng chẳng run sợ sao?</para>
  <para style="q" vid="AMO 3:6">Chẳng lẽ tai vạ nào ập xuống một thành</para>
  <para style="q" vid="AMO 3:6">mà không phải là do Chúa Hằng Hữu sao?<verse eid="AMO 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 3:7" />Chắc chắn Chúa là Chúa Hằng Hữu sẽ chẳng làm việc gì</para>
  <para style="q" vid="AMO 3:7">mà Ngài không tỏ bày chương trình của Ngài cho đầy tớ Ngài là các tiên tri.<verse eid="AMO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 3:8" />Sư tử đã gầm thét;</para>
  <para style="q" vid="AMO 3:8">ai mà chẳng sợ?</para>
  <para style="q" vid="AMO 3:8">Chúa là Chúa Hằng Hữu đã phán;</para>
  <para style="q" vid="AMO 3:8">ai mà chẳng nói tiên tri?<verse eid="AMO 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 3:9" />Hãy công bố trong các đền đài tại Ách-đốt,</para>
  <para style="q" vid="AMO 3:9">và trong các đền đài trong xứ Ai Cập,</para>
  <para style="q" vid="AMO 3:9">rao ra rằng: “Hãy nhóm hiệp lại trên các dãy núi của Sa-ma-ri</para>
  <para style="q" vid="AMO 3:9">và nhìn xem có sự rối loạn lớn ra sao tại đó,</para>
  <para style="q" vid="AMO 3:9">cùng sự áp bức dường nào ở nơi nó.<verse eid="AMO 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 3:10" />Vì chúng chẳng biết cách làm lành —</para>
  <para style="q" vid="AMO 3:10">đó là lời tuyên phán của Chúa Hằng Hữu —</para>
  <para style="q" vid="AMO 3:10">khi chất chứa bạo lực</para>
  <para style="q" vid="AMO 3:10">và sự hủy diệt trong các đền đài của chúng.”<verse eid="AMO 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 3:11" />Vì vậy, Chúa là Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 3:11">“Kẻ thù sẽ bao vây xứ,</para>
  <para style="q" vid="AMO 3:11">đánh hạ các đồn lũy</para>
  <para style="q" vid="AMO 3:11">và cướp bóc các đền đài của con.”<verse eid="AMO 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 3:12" />Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 3:12">“Như mục đồng giải cứu khỏi miệng sư tử</para>
  <para style="q" vid="AMO 3:12">chỉ được hai cẳng hay một mảnh tai;</para>
  <para style="q" vid="AMO 3:12">thì cũng vậy, con cháu Y-sơ-ra-ên sống tại Sa-ma-ri sẽ được giải cứu chỉ với một góc giường hay một mảnh trường kỷ.”<verse eid="AMO 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 3:13" />Hãy nghe và làm chứng</para>
  <para style="q" vid="AMO 3:13">chống lại nhà Gia-cốp —</para>
  <para style="q" vid="AMO 3:13">đây là lời tuyên phán của Chúa, tức là Chúa Hằng Hữu, Thiên Chúa của các đạo binh:<verse eid="AMO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 3:14" />“Vì vào ngày mà Ta giáng hình phạt trên Y-sơ-ra-ên vì tội lỗi nó,</para>
  <para style="q" vid="AMO 3:14">Ta cũng sẽ giáng hình phạt trên các bàn thờ của Bê-tên.</para>
  <para style="q" vid="AMO 3:14">Các sừng của bàn thờ sẽ bị chặt đứt</para>
  <para style="q" vid="AMO 3:14">và rơi xuống đất.<verse eid="AMO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 3:15" />Ta sẽ hủy diệt ngôi nhà mùa đông</para>
  <para style="q" vid="AMO 3:15">cùng ngôi nhà mùa hạ.</para>
  <para style="q" vid="AMO 3:15">Các cung điện bằng ngà sẽ tiêu vong,</para>
  <para style="q" vid="AMO 3:15">và các dinh thự rộng lớn sẽ tan biến —</para>
  <para style="q" vid="AMO 3:15">đó là lời tuyên phán của Chúa Hằng Hữu.”<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="q">
    <verse number="1" style="v" sid="AMO 4:1" />Hãy nghe lời này,</para>
  <para style="q" vid="AMO 4:1">hỡi lũ bò cái Ba-san,</para>
  <para style="q" vid="AMO 4:1">tức những kẻ ở trên núi Sa-ma-ri,</para>
  <para style="q" vid="AMO 4:1">là bọn áp bức người nghèo,</para>
  <para style="q" vid="AMO 4:1">chà đạp người thiếu thốn,</para>
  <para style="q" vid="AMO 4:1">đòi hỏi chồng mình rằng:</para>
  <para style="q" vid="AMO 4:1">“Ông hãy đem tới đây và chúng ta sẽ uống say.”<verse eid="AMO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 4:2" />Chúa là Chúa Hằng Hữu đã thề trên đức thánh khiết của Ngài, rằng:</para>
  <para style="q" vid="AMO 4:2">“Kìa, những ngày sẽ đến trên các con</para>
  <para style="q" vid="AMO 4:2">khi người ta sẽ lôi các con đi bằng móc,</para>
  <para style="q" vid="AMO 4:2">và kéo lê những kẻ cuối cùng của các con bằng lưỡi câu.<verse eid="AMO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 4:3" />Các con sẽ đi thông qua những chỗ nứt vỡ trên vách thành,</para>
  <para style="q" vid="AMO 4:3">mỗi người đi thẳng tới trước,</para>
  <para style="q" vid="AMO 4:3">rồi các con sẽ bị ném ra hướng Hạc-môn —</para>
  <para style="q" vid="AMO 4:3">đó là lời tuyên phán của Chúa Hằng Hữu.”<verse eid="AMO 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 4:4" />“Hãy đến Bê-tên và phạm tội,</para>
  <para style="q" vid="AMO 4:4">đến Ghinh-ganh và cố phạm nhiều tội lên,</para>
  <para style="q" vid="AMO 4:4">hãy đem những sinh tế của các con đến mỗi buổi sáng,</para>
  <para style="q" vid="AMO 4:4">và những phần mười của mình mỗi ba ngày.<verse eid="AMO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 4:5" />Hãy dâng một sinh tế cảm tạ cùng với bánh có men;</para>
  <para style="q" vid="AMO 4:5">hãy công bố các của lễ lạc ý; hỡi con cháu Y-sơ-ra-ên,</para>
  <para style="q" vid="AMO 4:5">hãy rao lớn tiếng về chúng,</para>
  <para style="q" vid="AMO 4:5">vì việc ấy khiến các con vui thích —</para>
  <para style="q" vid="AMO 4:5">đó là lời tuyên phán của Chúa là Chúa Hằng Hữu.<verse eid="AMO 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 4:6" />Vì Ta cũng đã ban cho các con hàm răng sạch trơn trong tất cả các thành mình,</para>
  <para style="q" vid="AMO 4:6">và sự túng thiếu về lương thực tại mọi nơi ở của các con.</para>
  <para style="q" vid="AMO 4:6">Thế mà các con không trở lại với Ta —</para>
  <para style="q" vid="AMO 4:6">đó là lời tuyên phán của Chúa Hằng Hữu.<verse eid="AMO 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 4:7" />Ta cũng đã rút cơn mưa khỏi các con</para>
  <para style="q" vid="AMO 4:7">khi vẫn còn ba tháng cho đến vụ thu hoạch.</para>
  <para style="q" vid="AMO 4:7">Ta khiến trời mưa trên thành này</para>
  <para style="q" vid="AMO 4:7">mà khiến trời không mưa trên thành khác.</para>
  <para style="q" vid="AMO 4:7">Mảnh đất này thì được mưa,</para>
  <para style="q" vid="AMO 4:7">còn mảnh đất mà không có mưa trên nó thì khô cằn.<verse eid="AMO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 4:8" />Hai hay ba thành lảo đảo tìm đến một thành khác để uống nước,</para>
  <para style="q" vid="AMO 4:8">nhưng chẳng đã khát.</para>
  <para style="q" vid="AMO 4:8">Thế mà các con không trở lại với Ta —</para>
  <para style="q" vid="AMO 4:8">đó là lời tuyên phán của Chúa Hằng Hữu.<verse eid="AMO 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 4:9" />Ta hành hại các con bằng sâu bệnh và nấm mốc.</para>
  <para style="q" vid="AMO 4:9">Rất nhiều khu vườn các con,</para>
  <para style="q" vid="AMO 4:9">vườn nho các con,</para>
  <para style="q" vid="AMO 4:9">cây vả các con,</para>
  <para style="q" vid="AMO 4:9">và cây ô liu các con —</para>
  <para style="q" vid="AMO 4:9">châu chấu ăn nuốt sạch cả.</para>
  <para style="q" vid="AMO 4:9">Thế mà các con không trở lại với Ta —</para>
  <para style="q" vid="AMO 4:9">đó là lời tuyên phán của Chúa Hằng Hữu.<verse eid="AMO 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 4:10" />Ta giáng tai vạ trên các con như cách thức với Ai Cập.</para>
  <para style="q" vid="AMO 4:10">Ta giết chết bọn trai trẻ các con bằng gươm,</para>
  <para style="q" vid="AMO 4:10">lấy mất lũ ngựa của các con,</para>
  <para style="q" vid="AMO 4:10">và khiến mùi hôi thối của trại các con bốc lên</para>
  <para style="q" vid="AMO 4:10">tận trong lỗ mũi các con.</para>
  <para style="q" vid="AMO 4:10">Nhưng các con không trở lại với Ta —</para>
  <para style="q" vid="AMO 4:10">đó là lời tuyên phán của Chúa Hằng Hữu.<verse eid="AMO 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 4:11" />Ta lật đổ các thành giữa vòng các con,</para>
  <para style="q" vid="AMO 4:11">như khi Thiên Chúa lật đổ Sô-đôm và Gô-mô-rơ.</para>
  <para style="q" vid="AMO 4:11">Các con như que củi đang cháy được rút ra khỏi lửa.</para>
  <para style="q" vid="AMO 4:11">Nhưng các con không trở về với Ta —</para>
  <para style="q" vid="AMO 4:11">đó là lời tuyên phán của Chúa Hằng Hữu.<verse eid="AMO 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 4:12" />Bởi vậy, Y-sơ-ra-ên ơi, Ta sẽ làm như thế đối với con;</para>
  <para style="q" vid="AMO 4:12">và vì cớ Ta sẽ làm điều đó với con,</para>
  <para style="q" vid="AMO 4:12">cho nên, Y-sơ-ra-ên ơi, hãy sửa soạn để gặp Thiên Chúa của con!<verse eid="AMO 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 4:13" />Vì, xem kìa, Ngài là Đấng nhào nặn các núi</para>
  <para style="q" vid="AMO 4:13">cũng tạo ra gió,</para>
  <para style="q" vid="AMO 4:13">Đấng tỏ bày ý tưởng mình cho loài người,</para>
  <para style="q" vid="AMO 4:13">Đấng khiến ban ngày thành bóng tối,</para>
  <para style="q" vid="AMO 4:13">và bước đi trên các nơi cao của đất.</para>
  <para style="q" vid="AMO 4:13">Chúa Hằng Hữu, Thiên Chúa của các đạo binh, chính là danh Ngài.”<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />Hỡi nhà Y-sơ-ra-ên, hãy nghe lời này, là lời mà tôi hát lên như bài ai ca về anh chị em.<verse eid="AMO 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 5:2" />“Trinh nữ Y-sơ-ra-ên đã ngã xuống;</para>
  <para style="q" vid="AMO 5:2">nàng sẽ không đứng dậy nữa;</para>
  <para style="q" vid="AMO 5:2">nàng bị ruồng bỏ trên đất mình;</para>
  <para style="q" vid="AMO 5:2">chẳng ai đỡ nàng dậy.”<verse eid="AMO 5:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="AMO 5:3" />Vì Chúa là Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 5:3">“Thành xuất một ngàn quân sẽ còn sót lại một trăm,</para>
  <para style="q" vid="AMO 5:3">và xuất một trăm quân sẽ còn sót lại mười người</para>
  <para style="q" vid="AMO 5:3">dành cho nhà Y-sơ-ra-ên.”<verse eid="AMO 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 5:4" />Vì Chúa Hằng Hữu phán thế này với nhà Y-sơ-ra-ên:</para>
  <para style="q" vid="AMO 5:4">“Các con hãy tìm kiếm Ta và được sống!<verse eid="AMO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 5:5" />Đừng tìm kiếm Bê-tên;</para>
  <para style="q" vid="AMO 5:5">cũng đừng vào Ghinh-ganh;</para>
  <para style="q" vid="AMO 5:5">chớ đi đến Bê-e-sê-ba.</para>
  <para style="q" vid="AMO 5:5">Vì Ghinh-ganh chắc chắn sẽ đi lưu đày,</para>
  <para style="q" vid="AMO 5:5">Bê-tên sẽ trở nên chỗ trống không.”<verse eid="AMO 5:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 5:6" />Anh chị em hãy tìm kiếm Chúa Hằng Hữu và được sống,</para>
  <para style="q" vid="AMO 5:6">nếu không, Ngài sẽ như ngọn lửa bùng lên</para>
  <para style="q" vid="AMO 5:6">trong nhà Giô-sép.</para>
  <para style="q" vid="AMO 5:6">Lửa ấy sẽ thiêu nuốt,</para>
  <para style="q" vid="AMO 5:6">và chẳng thể dập tắt được tại Bê-tên.<verse eid="AMO 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 5:7" />Ấy bởi anh chị em là những kẻ biến công lý thành nỗi cay đắng</para>
  <para style="q" vid="AMO 5:7">và vứt sự công chính xuống đất.<verse eid="AMO 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 5:8" />Thiên Chúa tạo ra cụm sao Thất Nữ và chòm sao Thợ Săn;</para>
  <para style="q" vid="AMO 5:8">Ngài đổi bóng tối thành buổi mai;</para>
  <para style="q" vid="AMO 5:8">Ngài làm ban ngày nên tối đen bởi màn đêm</para>
  <para style="q" vid="AMO 5:8">và sai gọi các dòng nước của biển cả;</para>
  <para style="q" vid="AMO 5:8">Ngài đổ chúng ra trên mặt đất.</para>
  <para style="q" vid="AMO 5:8">Chúa Hằng Hữu là danh Ngài!<verse eid="AMO 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 5:9" />Ngài giáng sự hủy hoại trên kẻ mạnh,</para>
  <para style="q" vid="AMO 5:9">và sự tàn phá ập xuống trên thành lũy kiên cố.<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="AMO 5:10" />Chúng căm ghét người liêm chính phân xử nơi cổng thành,</para>
  <para style="q" vid="AMO 5:10">và chúng ghê tởm người ngay thật phát ngôn.<verse eid="AMO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 5:11" />Thế thì, bởi cớ các con chà đạp người nghèo</para>
  <para style="q" vid="AMO 5:11">và thu phí bằng lúa mì từ nơi người —</para>
  <para style="q" vid="AMO 5:11">cho nên, dù các con đã xây những ngôi nhà bằng đá đẽo,</para>
  <para style="q" vid="AMO 5:11">các con sẽ không sống trong những nơi đó.</para>
  <para style="q" vid="AMO 5:11">Các con có những vườn nho xinh tốt</para>
  <para style="q" vid="AMO 5:11">nhưng các con sẽ không uống rượu của chúng.<verse eid="AMO 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 5:12" />Vì Ta biết những vi phạm của các con nhiều thể nào</para>
  <para style="q" vid="AMO 5:12">và tội lỗi các con lớn dường bao —</para>
  <para style="q" vid="AMO 5:12">khi áp bức người công chính,</para>
  <para style="q" vid="AMO 5:12">nhận của hối lộ,</para>
  <para style="q" vid="AMO 5:12">và các con hành hạ người nghèo hèn nơi cổng thành.<verse eid="AMO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 5:13" />Do đó, vào thời buổi như thế, người biết cẩn trọng sẽ làm thinh,</para>
  <para style="q" vid="AMO 5:13">vì đó là thời buổi tồi tệ.<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="AMO 5:14" />Hãy tìm kiếm điều lành chứ không phải điều dữ,</para>
  <para style="q" vid="AMO 5:14">hầu cho anh chị em sẽ sống.</para>
  <para style="q" vid="AMO 5:14">Để rồi Chúa Hằng Hữu, Thiên Chúa của các đạo binh, sẽ thật sự ở với anh chị em,</para>
  <para style="q" vid="AMO 5:14">như anh chị em đã nói.<verse eid="AMO 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 5:15" />Hãy căm ghét điều dữ, hãy yêu thích điều lành,</para>
  <para style="q" vid="AMO 5:15">hãy thiết lập công lý tại cổng thành.</para>
  <para style="q" vid="AMO 5:15">Biết đâu Chúa Hằng Hữu, Thiên Chúa của các đạo binh, sẽ ban ân huệ</para>
  <para style="q" vid="AMO 5:15">cho số còn lại của Giô-sép.<verse eid="AMO 5:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="AMO 5:16" />Vì vậy, Chúa là Chúa Hằng Hữu,</para>
  <para style="q" vid="AMO 5:16">Thiên Chúa của các đạo binh, phán thế này:</para>
  <para style="q" vid="AMO 5:16">“Tiếng than thở ở khắp các quảng trường,</para>
  <para style="q" vid="AMO 5:16">và trên mọi con phố người ta sẽ nói:</para>
  <para style="q" vid="AMO 5:16">‘Khốn khổ thay! Khốn khổ thay!’</para>
  <para style="q" vid="AMO 5:16">Họ sẽ gọi người nông phu đến chỗ tang chế</para>
  <para style="q" vid="AMO 5:16">và những kẻ khóc mướn để thể hiện nỗi sầu thảm.<verse eid="AMO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="AMO 5:17" />Nỗi phiền muộn ở trong mọi vườn nho,</para>
  <para style="q" vid="AMO 5:17">vì Ta sẽ đi qua giữa các con,”</para>
  <para style="q" vid="AMO 5:17">Chúa Hằng Hữu đã phán.<verse eid="AMO 5:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="AMO 5:18" />Thảm hại thay cho những kẻ mong mỏi ngày của Chúa Hằng Hữu!</para>
  <para style="q" vid="AMO 5:18">Ngày của Chúa Hằng Hữu có điều gì dành cho các con?</para>
  <para style="q" vid="AMO 5:18">Ấy là ngày tối tăm chứ chẳng phải ngày tươi sáng,<verse eid="AMO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="AMO 5:19" />giống như khi một người chạy khỏi sư tử</para>
  <para style="q" vid="AMO 5:19">rồi gặp phải con gấu,</para>
  <para style="q" vid="AMO 5:19">hay khi người ấy lánh vào một ngôi nhà rồi dựa tay mình lên tường</para>
  <para style="q" vid="AMO 5:19">thì một con rắn cắn anh ta.<verse eid="AMO 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="AMO 5:20" />Chẳng phải ngày của Chúa Hằng Hữu là ngày tối tăm mà không hề tươi sáng,</para>
  <para style="q" vid="AMO 5:20">thật ảm đạm và chẳng có vẻ rực rỡ trong nó, hay sao?<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="AMO 5:21" />“Ta ghét, Ta xem thường những lễ hội của các con,</para>
  <para style="q" vid="AMO 5:21">Ta chẳng vui thích về những kỳ nhóm họp trọng thể của các con.<verse eid="AMO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="AMO 5:22" />Cho dù các con dâng cho Ta những của lễ thiêu và của lễ chay,</para>
  <para style="q" vid="AMO 5:22">Ta sẽ không nhận lấy,</para>
  <para style="q" vid="AMO 5:22">Ta cũng sẽ chẳng ngó tới những của lễ cầu an bằng nhiều thú vật mập béo của các con.<verse eid="AMO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="AMO 5:23" />Hãy dẹp tiếng om sòm nơi những bài hát của các con khỏi Ta;</para>
  <para style="q" vid="AMO 5:23">Ta sẽ chẳng lắng nghe tiếng nhạc từ những cây đàn hạc của các con.<verse eid="AMO 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="AMO 5:24" />Thay vào đó, hãy để cho công lý cuộn trào như nước,</para>
  <para style="q" vid="AMO 5:24">và sự chính trực như dòng suối ào ào không ngưng.<verse eid="AMO 5:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="AMO 5:25" />Này nhà Y-sơ-ra-ên, có phải các con đã đem cho Ta những sinh tế và của lễ</para>
  <para style="q" vid="AMO 5:25">suốt bốn mươi năm trong sa mạc?<verse eid="AMO 5:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="AMO 5:26" />Thực tế thì, các con khiêng những hình tượng của Xi-cút, vua các con,</para>
  <para style="q" vid="AMO 5:26">và Ki-giun, thần ngôi sao của các con,</para>
  <para style="q" vid="AMO 5:26">là những thứ mà các con đã làm ra cho mình.<verse eid="AMO 5:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="AMO 5:27" />Vì vậy, Ta sẽ đày các con đến một nơi xa hơn Đa-mách,”</para>
  <para style="q" vid="AMO 5:27">Chúa Hằng Hữu đã phán,</para>
  <para style="q" vid="AMO 5:27">danh Ngài là Thiên Chúa của các đạo binh.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="q">
    <verse number="1" style="v" sid="AMO 6:1" />Thảm hại thay cho bọn yên ổn nhàn hạ tại Si-ôn,</para>
  <para style="q" vid="AMO 6:1">và cho những kẻ tự tin về sự an toàn nơi vùng đồi núi Sa-ma-ri,</para>
  <para style="q" vid="AMO 6:1">tức là giới quyền quý của tầng lớp ưu tú nhất trong các nước,</para>
  <para style="q" vid="AMO 6:1">mà nhà Y-sơ-ra-ên tìm đến nhờ vả!<verse eid="AMO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 6:2" />“Hãy đi đến Ca-ne và nhìn xem;</para>
  <para style="q" vid="AMO 6:2">rồi từ đó hãy đi đến thành Ha-mát vĩ đại;</para>
  <para style="q" vid="AMO 6:2">kế tiếp hãy đi xuống thành Gát của dân Phi-li-tin.</para>
  <para style="q" vid="AMO 6:2">Chúng tốt hơn hai vương quốc này sao?</para>
  <para style="q" vid="AMO 6:2">Phải chăng biên giới chúng rộng hơn biên giới này?”<verse eid="AMO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 6:3" />Bọn chúng là những kẻ xua đuổi ngày tai họa</para>
  <para style="q" vid="AMO 6:3">mà làm cho ngai tàn bạo đến gần.<verse eid="AMO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 6:4" />Ấy là bọn nằm trên gường bằng ngà</para>
  <para style="q" vid="AMO 6:4">và duỗi người phè phỡn trên trường kỷ của mình,</para>
  <para style="q" vid="AMO 6:4">ăn chiên con từ trong đàn</para>
  <para style="q" vid="AMO 6:4">và bò con từ trong chuồng.<verse eid="AMO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 6:5" />Nghêu ngao bỡn cợt theo tiếng đàn hạc,</para>
  <para style="q" vid="AMO 6:5">bọn chúng ứng tấu trên các nhạc cụ như thể Đa-vít.<verse eid="AMO 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 6:6" />Vì uống rượu bằng chén</para>
  <para style="q" vid="AMO 6:6">và xức những thứ dầu hảo hạng,</para>
  <para style="q" vid="AMO 6:6">nên chúng chẳng đau buồn về sự đổ nát của Giô-sép.<verse eid="AMO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 6:7" />Bởi thế, giờ đây chúng sẽ lưu vong với những kẻ bị đi đày đầu tiên,</para>
  <para style="q" vid="AMO 6:7">và yến tiệc của bọn duỗi người phè phỡn ấy sẽ không còn.<verse eid="AMO 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 6:8" />Chúa, là Chúa Hằng Hữu, đã chỉ chính mình mà thề —</para>
  <para style="q" vid="AMO 6:8">đây là lời tuyên phán của Chúa Hằng Hữu, Thiên Chúa của các đạo binh:</para>
  <para style="q" vid="AMO 6:8">“Ta kinh tởm thói kiêu hãnh của Gia-cốp;</para>
  <para style="q" vid="AMO 6:8">Ta căm ghét các đền đài của nó.</para>
  <para style="q" vid="AMO 6:8">Cho nên Ta sẽ phó thành cùng với mọi thứ trong đó.”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />Việc sẽ xảy ra thế này, nếu mười người còn lại trong một ngôi nhà, thì chúng sẽ chết hết. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />Khi người bà con của kẻ chết đến để nhận xác — người sẽ cho hỏa thiêu kẻ chết ấy sau khi đem các thây ra khỏi nhà — nếu người ấy nói cùng kẻ trong nhà: “Còn ai ở với anh không?” Rồi kẻ đó đáp: “Không.” Thế là người ấy sẽ bảo: “Im đi, vì không được nhắc đến danh Chúa Hằng Hữu.”<verse eid="AMO 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 6:11" />Vì kìa, Chúa Hằng Hữu sẽ truyền lệnh,</para>
  <para style="q" vid="AMO 6:11">thì nhà lớn sẽ bị đập thành những đống đổ nát,</para>
  <para style="q" vid="AMO 6:11">còn nhà nhỏ trở nên nhiều mảnh vụn.<verse eid="AMO 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 6:12" />Phải chăng ngựa phi trên vách đá?</para>
  <para style="q" vid="AMO 6:12">Phải chăng người ta cày ở đó bằng bò?</para>
  <para style="q" vid="AMO 6:12">Thế mà các con đã đổi công lý thành thuốc độc</para>
  <para style="q" vid="AMO 6:12">và bông trái công chính ra ngải đắng.<verse eid="AMO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 6:13" />“Các con là những kẻ vui mừng về Lô Đê-ba,</para>
  <para style="q" vid="AMO 6:13">khi nói: ‘Chẳng phải chúng ta đã chiếm được Các-na-im bằng sức riêng của mình hay sao?’<verse eid="AMO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 6:14" />Vì vậy, nhìn đây, hỡi nhà Y-sơ-ra-ên, Ta sẽ dấy lên một dân chống lại các con</para>
  <para style="q" vid="AMO 6:14">— đó là lời tuyên phán của Chúa Hằng Hữu, Thiên Chúa của các đạo binh.</para>
  <para style="q" vid="AMO 6:14">Chúng sẽ làm cho các con khốn khổ,</para>
  <para style="q" vid="AMO 6:14">từ Lê-bô Ha-mát cho đến suối A-ra-ba.”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />Chúa, là Chúa Hằng Hữu, đã tỏ cho tôi thấy như sau: Nhìn này, Ngài tạo nên một đàn châu chấu khi vụ mùa trễ bắt đầu nảy mầm và, kìa, đó là vụ mùa trễ sau những kỳ cắt cỏ của vua. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />Việc xảy ra khi chúng ăn hết cây cỏ trong xứ, thì tôi thưa: “Ôi Chúa là Chúa Hằng Hữu, xin Ngài tha thứ; làm sao Gia-cốp vực dậy lại được? Vì nó nhỏ bé quá.” <verse eid="AMO 7:2" /><verse number="3" style="v" sid="AMO 7:3" />Chúa Hằng Hữu đổi ý về việc ấy. Ngài phán: “Chuyện đó sẽ không xảy ra.”<verse eid="AMO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />Chúa, là Chúa Hằng Hữu, đã tỏ cho tôi thấy như sau: Kìa, Chúa, là Chúa Hằng Hữu, gọi lửa đến để đoán phạt. Nó làm khô cạn biển sâu thăm thẳm và thiêu nuốt đất đai. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />Nhưng tôi thưa: “Ôi Chúa là Chúa Hằng Hữu, xin Ngài dừng lại; làm sao Gia-cốp vực dậy lại được? Vì nó nhỏ bé quá.” <verse eid="AMO 7:5" /><verse number="6" style="v" sid="AMO 7:6" />Chúa Hằng Hữu đổi ý về việc ấy. Chúa, là Chúa Hằng Hữu, phán: “Chuyện này cũng sẽ không xảy ra.”<verse eid="AMO 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />Ngài đã tỏ cho tôi thấy như sau: Kìa, Chúa đứng cạnh một bức tường với một dây dọi, và dây dọi ở trong tay Ngài. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />Chúa Hằng Hữu phán với tôi: “A-mốt, con thấy gì?” Tôi thưa: “Một dây dọi.” Rồi Chúa phán: “Nhìn này, Ta sẽ đặt một dây dọi ở giữa dân Y-sơ-ra-ên của Ta. Ta sẽ chẳng tiếp tục bỏ qua cho nó nữa.<verse eid="AMO 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 7:9" />Những nơi cao của Y-sác sẽ bị tàn phá,</para>
  <para style="q" vid="AMO 7:9">các nơi thánh của Y-sơ-ra-ên sẽ bị hủy hoại,</para>
  <para style="q" vid="AMO 7:9">và Ta sẽ vùng dậy chống nghịch nhà Giê-rô-bô-am bằng gươm.”<verse eid="AMO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />Rồi A-ma-xia, thầy tế lễ của Bê-tên, cho gửi tin tức tới Giê-rô-bô-am, vua Y-sơ-ra-ên, rằng: “A-mốt âm mưu chống lại vua ngay giữa nhà Y-sơ-ra-ên. Xứ không thể chịu nổi hết thảy những lời nói của ông ta. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />Vì, A-mốt nói thế này:</para>
  <para style="q" vid="AMO 7:11">‘Giê-rô-bô-am sẽ chết bởi gươm,</para>
  <para style="q" vid="AMO 7:11">còn Y-sơ-ra-ên chắc chắn sẽ đi lưu đày khỏi xứ sở mình.’”<verse eid="AMO 7:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />A-ma-xia nói với A-mốt: “Ông tiên kiến kia, đi đi, hãy tự mình trốn về đất Giu-đa, và hãy ăn bánh ở đó rồi nói tiên tri tại nơi ấy. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />Nhưng tại Bê-tên, ông chớ tiếp tục nói tiên tri nữa, vì đây là nơi thánh của vua và là nơi ở của hoàng gia.”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />Thế rồi A-mốt đáp lại và nói cùng A-ma-xia: “Tôi không phải là tiên tri, mà tôi cũng không phải là con trai của một vị tiên tri, mà tôi là người chăn nuôi gia súc, và tôi chăm sóc cây vả. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />Nhưng Chúa Hằng Hữu đã rút tôi ra khỏi việc chăn bầy, và Chúa Hằng Hữu phán với tôi: ‘Đi đi, hãy nói tiên tri cho dân Y-sơ-ra-ên của Ta.’ <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />Bây giờ, hãy nghe lời của Chúa Hằng Hữu. Ông bảo: ‘Chớ nói tiên tri chống lại Y-sơ-ra-ên, và đừng lên tiếng chống lại nhà Y-sác.’ <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />Vậy nên, Chúa Hằng Hữu phán thế này:</para>
  <para style="q" vid="AMO 7:17">‘Vợ ngươi sẽ làm gái điếm trong thành;</para>
  <para style="q" vid="AMO 7:17">các con trai và con gái của ngươi sẽ ngã chết bởi gươm;</para>
  <para style="q" vid="AMO 7:17">đất ngươi sẽ bị phân chia bằng dây;</para>
  <para style="q" vid="AMO 7:17">và ngươi sẽ chết tại một đất ô uế,</para>
  <para style="q" vid="AMO 7:17">còn Y-sơ-ra-ên chắc chắn sẽ đi lưu đày khỏi xứ mình.’”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />Chúa, là Chúa Hằng Hữu, đã tỏ cho tôi thấy như sau: Xem kìa, một giỏ trái cây mùa hạ! <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />Ngài hỏi: “A-mốt, con thấy gì?” Tôi thưa: “Một giỏ trái cây mùa hạ.” Rồi Chúa Hằng Hữu phán với tôi:</para>
  <para style="q" vid="AMO 8:2">“Giới hạn cuối cùng đã đến cho dân Y-sơ-ra-ên của Ta;</para>
  <para style="q" vid="AMO 8:2">Ta sẽ chẳng tiếp tục bỏ qua cho nó nữa.<verse eid="AMO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 8:3" />Trong ngày đó, các bài ca của cung đền sẽ trở thành những tiếng khóc than —</para>
  <para style="q" vid="AMO 8:3">đây là lời tuyên phán của Chúa, là Chúa Hằng Hữu —</para>
  <para style="q" vid="AMO 8:3">quá nhiều xác chết, thứ ấy bị đem quăng ở khắp nơi!</para>
  <para style="q" vid="AMO 8:3">Hãy nín lặng!”<verse eid="AMO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 8:4" />Hãy nghe lời này, các người là bọn chà đạp người thiếu thốn</para>
  <para style="q" vid="AMO 8:4">và trừ khử kẻ nghèo trong xứ. <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />Chúng nó nói:</para>
  <para style="q" vid="AMO 8:5">“Khi nào kỳ trăng mới sẽ qua,</para>
  <para style="q" vid="AMO 8:5">để chúng ta có thể buôn ngũ cốc?</para>
  <para style="q" vid="AMO 8:5">Còn bao lâu nữa mới hết ngày Sa-bát,</para>
  <para style="q" vid="AMO 8:5">để chúng ta mở bán lúa mì?</para>
  <para style="q" vid="AMO 8:5">Chúng ta sẽ làm cho cái lường ê-pha nhỏ bớt</para>
  <para style="q" vid="AMO 8:5">và tăng giá siếc-lơ lên,</para>
  <para style="q" vid="AMO 8:5">để gian lận bằng cái cân giả.<verse eid="AMO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 8:6" />Chúng ta sẽ bán lúa lép hầu cho có thể mua lấy kẻ nghèo bằng bạc,</para>
  <para style="q" vid="AMO 8:6">và kẻ thiếu thốn bằng một đôi dép.”<verse eid="AMO 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 8:7" />Chúa Hằng Hữu đã chỉ sự kiêu hãnh của Gia-cốp mà thề:</para>
  <para style="q" vid="AMO 8:7">“Chắc chắn Ta sẽ không hề quên hết thảy những việc làm của chúng nó.”<verse eid="AMO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 8:8" />Vì cớ điều đó, đất chẳng phải sẽ rúng động,</para>
  <para style="q" vid="AMO 8:8">và mọi cư dân trên đất than khóc hay sao?</para>
  <para style="q" vid="AMO 8:8">Cả đất sẽ trồi lên như Sông Nin,</para>
  <para style="q" vid="AMO 8:8">rồi nó sẽ bị dập xuống và lại chìm lắng,</para>
  <para style="q" vid="AMO 8:8">giống như sông Ai Cập.<verse eid="AMO 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 8:9" />“Sự việc sẽ đến trong ngày đó —</para>
  <para style="q" vid="AMO 8:9">đây là lời tuyên phán của Chúa, là Chúa Hằng Hữu —</para>
  <para style="q" vid="AMO 8:9">ấy là Ta sẽ khiến mặt trời lặn lúc giữa trưa,</para>
  <para style="q" vid="AMO 8:9">và Ta sẽ làm cho đất tối đen giữa ban ngày.<verse eid="AMO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 8:10" />Ta sẽ đổi các lễ hội của các con thành sự than khóc</para>
  <para style="q" vid="AMO 8:10">và mọi bài hát các con thành lời ai ca.</para>
  <para style="q" vid="AMO 8:10">Ta sẽ khiến tất cả các con phải mặc đồ tang</para>
  <para style="q" vid="AMO 8:10">và cạo hết đầu mình.</para>
  <para style="q" vid="AMO 8:10">Ta sẽ khiến nó như thể người ta than khóc con trai một,</para>
  <para style="q" vid="AMO 8:10">và sự kết thúc của nó như một ngày đắng cay.<verse eid="AMO 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 8:11" />Kìa, khi những ngày ấy tới —</para>
  <para style="q" vid="AMO 8:11">đây là lời tuyên phán của Chúa, là Chúa Hằng Hữu —</para>
  <para style="q" vid="AMO 8:11">đó là lúc Ta sẽ sai nạn đói đến trong xứ,</para>
  <para style="q" vid="AMO 8:11">chẳng phải sự đói kém về bánh,</para>
  <para style="q" vid="AMO 8:11">cũng không phải sự thèm khát về nước,</para>
  <para style="q" vid="AMO 8:11">nhưng là cơn đói khát để lắng nghe các lời phán của Chúa Hằng Hữu.<verse eid="AMO 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 8:12" />Chúng nó sẽ đi vật vờ từ biển này đến biển khác;</para>
  <para style="q" vid="AMO 8:12">chúng sẽ chạy từ phương bắc đến phương đông</para>
  <para style="q" vid="AMO 8:12">để tìm kiếm lời của Chúa Hằng Hữu,</para>
  <para style="q" vid="AMO 8:12">nhưng chúng nó sẽ chẳng tìm được.<verse eid="AMO 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 8:13" />Trong ngày đó, các trinh nữ xinh đẹp</para>
  <para style="q" vid="AMO 8:13">và bọn trai tráng sẽ ngất xỉu vì khát.<verse eid="AMO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 8:14" />Là những kẻ chỉ tội lỗi của Sa-ma-ri mà thề, <note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fq">tội lỗi của Sa-ma-ri</char>, một số bản đọc <char style="fqa">A-si-ma của Sa-ma-ri</char>. A-si-ma là tên gọi một nữ thần ngoại giáo được một số vùng của Sy-ri thờ phụng.</note></para>
  <para style="q" vid="AMO 8:14">chúng nó nói rằng: ‘Ôi Đan, thật như thần của ngươi vẫn sống,’</para>
  <para style="q" vid="AMO 8:14">và: ‘Thật như đường đến Bê-e-sê-ba vẫn còn’ — <note caller="+" style="f"><char style="ft" closed="false">Văn bản trong tiếng Hy Bá Lai đọc </char><char style="fq">Thật như đường đến Bê-e-sê-ba vẫn còn</char>, trong khi đây có thể chỉ về lời mà những kẻ thờ phượng các thần tượng của Bê-e-sê-ba có thể đã nói. Tuy nhiên, một số bản đổi văn bản tiếng Hy Bá Lai thành ra <char style="fqa">Thật như đấng được yêu kính của Bê-e-sê-ba vẫn sống</char>. Ở đây “đấng được yêu kính” chỉ về một thần tượng được thờ phụng tại Bê-e-sê-ba.</note></para>
  <para style="q" vid="AMO 8:14">thì chúng nó sẽ té ngã và không bao giờ trỗi dậy lại.”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />Tôi nhìn thấy Chúa đứng cạnh bàn thờ, và Ngài phán: “Hãy đánh các đầu cột để các ngạch cửa sẽ phải rung chuyển.</para>
  <para style="q" vid="AMO 9:1">Hãy đập nát những thứ ấy trên đầu hết thảy chúng nó,</para>
  <para style="q" vid="AMO 9:1">rồi Ta sẽ giết chết kẻ cuối cùng của chúng nó bằng gươm.</para>
  <para style="q" vid="AMO 9:1">Chẳng ai trong số chúng sẽ chạy thoát,</para>
  <para style="q" vid="AMO 9:1">và không một kẻ nào của chúng sẽ trốn được đến nơi trú ẩn.<verse eid="AMO 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 9:2" />Dù chúng nó đào xuống Âm Phủ,</para>
  <para style="q" vid="AMO 9:2">thì ở đó tay Ta sẽ bắt lấy chúng.</para>
  <para style="q" vid="AMO 9:2">Dù chúng nó leo lên trời,</para>
  <para style="q" vid="AMO 9:2">thì ở đó Ta sẽ lôi chúng xuống.<verse eid="AMO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 9:3" />Dù chúng nó trốn trên đỉnh Cạt-mên,</para>
  <para style="q" vid="AMO 9:3">thì ở đó Ta sẽ săn lùng và bắt lấy chúng.</para>
  <para style="q" vid="AMO 9:3">Dù chúng nó được ẩn mình tại đáy biển để xa khỏi mắt Ta,</para>
  <para style="q" vid="AMO 9:3">thì ở đó Ta sẽ truyền lệnh cho rắn, và nó sẽ cắn chúng.<verse eid="AMO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 9:4" />Dù chúng nó đi đến xứ lưu đày trước mặt kẻ thù mình,</para>
  <para style="q" vid="AMO 9:4">thì ở đó Ta sẽ truyền lệnh cho gươm và gươm sẽ giết chúng nó.</para>
  <para style="q" vid="AMO 9:4">Ta sẽ dõi mắt theo chúng nó để giáng họa chứ chẳng phải ban phước.”<verse eid="AMO 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 9:5" />Chúa là Chúa Hằng Hữu của các đạo binh</para>
  <para style="q" vid="AMO 9:5">chạm vào đất thì đất tan chảy;</para>
  <para style="q" vid="AMO 9:5">mọi cư dân trên đất kêu than khóc lóc;</para>
  <para style="q" vid="AMO 9:5">hết cả đất sẽ trồi lên như Sông Cái,</para>
  <para style="q" vid="AMO 9:5">rồi lại chìm xuống như sông Ai Cập.<verse eid="AMO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 9:6" />Chính Ngài xây cất các bậc thang trên trời,</para>
  <para style="q" vid="AMO 9:6">và đã thiết lập vòm trời trên đất.</para>
  <para style="q" vid="AMO 9:6">Ngài gọi nước biển lại,</para>
  <para style="q" vid="AMO 9:6">rồi đổ chúng ra trên mặt đất,</para>
  <para style="q" vid="AMO 9:6">Chúa Hằng Hữu là danh Ngài.<verse eid="AMO 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 9:7" />“Đối với Ta, chẳng phải các con giống như con cháu của Cút hay sao,</para>
  <para style="q" vid="AMO 9:7">hỡi con cháu Y-sơ-ra-ên —</para>
  <para style="q" vid="AMO 9:7">đó là lời tuyên phán của Chúa Hằng Hữu —</para>
  <para style="q" vid="AMO 9:7">chẳng phải Ta đã đem Y-sơ-ra-ên lên khỏi xứ Ai Cập,</para>
  <para style="q" vid="AMO 9:7">dân Phi-li-tin khỏi Cáp-tô,</para>
  <para style="q" vid="AMO 9:7">và dân A-ram khỏi Ki-rơ, hay sao?<verse eid="AMO 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 9:8" />Kìa, mắt của Chúa, là Chúa Hằng Hữu, ở trên vương quốc tội lỗi,</para>
  <para style="q" vid="AMO 9:8">và Ta sẽ phá hủy nó khỏi mặt đất,</para>
  <para style="q" vid="AMO 9:8">trừ ra việc Ta sẽ không phá hủy nhà Gia-cốp đến mức bị diệt vong —</para>
  <para style="q" vid="AMO 9:8">đó là lời tuyên phán của Chúa Hằng Hữu.<verse eid="AMO 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 9:9" />Vì này, Ta là Đấng truyền lệnh,</para>
  <para style="q" vid="AMO 9:9">và Ta sẽ sàng sảy nhà Y-sơ-ra-ên giữa tất cả các nước,</para>
  <para style="q" vid="AMO 9:9">như người ta sàng sảy trong cái rây,</para>
  <para style="q" vid="AMO 9:9">mà không một hạt bé tí nào sẽ rơi xuống đất.<verse eid="AMO 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 9:10" />Hết thảy những kẻ phạm tội trong dân Ta sẽ chết bởi gươm,</para>
  <para style="q" vid="AMO 9:10">tức là những kẻ nói: ‘Tai họa sẽ không đến gần hoặc chạm mặt chúng ta.’<verse eid="AMO 9:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 9:11" />Trong ngày đó, Ta sẽ dựng lên lều trại đã sập của Đa-vít,</para>
  <para style="q" vid="AMO 9:11">và sửa chữa những chỗ hư hại của nó.</para>
  <para style="q" vid="AMO 9:11">Ta sẽ dựng đống đổ nát của nó lên,</para>
  <para style="q" vid="AMO 9:11">và xây nó lại như thời trước,<verse eid="AMO 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 9:12" />sao cho chúng có thể chiếm hữu phần sót lại của Ê-đôm,</para>
  <para style="q" vid="AMO 9:12">và tất cả các nước mà được gọi bằng danh Ta ở trên chúng —</para>
  <para style="q" vid="AMO 9:12">đó là lời tuyên phán của Chúa Hằng Hữu, Đấng thực hiện việc này.<verse eid="AMO 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 9:13" />Kìa, sắp đến những ngày — đây là lời tuyên phán của Chúa Hằng Hữu —</para>
  <para style="q" vid="AMO 9:13">mà người cày sẽ tiến sát thợ gặt,</para>
  <para style="q" vid="AMO 9:13">và người đạp nho tiến sát người gieo giống.</para>
  <para style="q" vid="AMO 9:13">Các núi đồi sẽ nhỏ giọt rượu ngọt,</para>
  <para style="q" vid="AMO 9:13">và tất cả các gò đất sẽ tràn lan rượu ấy.<verse eid="AMO 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 9:14" />Ta sẽ đem dân Y-sơ-ra-ên của Ta trở về từ chốn lưu đày.</para>
  <para style="q" vid="AMO 9:14">Chúng sẽ xây dựng các thành bị đổ nát và sống ở đó,</para>
  <para style="q" vid="AMO 9:14">chúng sẽ trồng các vườn nho và uống rượu của những vườn ấy,</para>
  <para style="q" vid="AMO 9:14">chúng sẽ lập các vườn tược và ăn trái nơi chúng.<verse eid="AMO 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 9:15" />Ta sẽ trồng chúng trên đất của chúng,</para>
  <para style="q" vid="AMO 9:15">và chúng sẽ không bao giờ lại bị bứng khỏi đất</para>
  <para style="q" vid="AMO 9:15">mà Ta đã ban cho chúng.”</para>
  <para style="q" vid="AMO 9:15">Chúa Hằng Hữu, Thiên Chúa của anh chị em, đã phán như vậy.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>