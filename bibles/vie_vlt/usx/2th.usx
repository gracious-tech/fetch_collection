  <book code="2TH" style="id">EN_VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:26:35 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">2 Thessalonians</para>
  <para style="toc1">Thư Tê-sa-lô-ni-ca thứ nhì</para>
  <para style="toc2">2 Tê-sa-lô-ni-ca</para>
  <para style="toc3">2Th</para>
  <para style="mt">2 Tê-sa-lô-ni-ca</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />Phao-lô và Sin-vanh cùng với Ti-mô-thê, gửi cho Hội Thánh Tê-sa-lô-ni-ca trong Thiên Chúa, là Cha và Chúa chúng ta, là Chúa Cứu Thế Giê-xu. <verse eid="2TH 1:1" /><verse number="2" style="v" sid="2TH 1:2" />Nguyện ân điển và sự bình an từ nơi Thiên Chúa, là Cha, và Chúa, là Chúa Cứu Thế Giê-xu, ở trên anh chị em.<verse eid="2TH 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />Thưa anh chị em, chúng tôi phải luôn cảm tạ Thiên Chúa về anh chị em, như đó là điều hợp lẽ, vì đức tin anh chị em ngày càng tấn tới, và tình yêu thương của mỗi một người trong hết thảy anh chị em đối với nhau cứ thêm lên; <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />đến nỗi chúng tôi khoe mình nơi anh chị em trong vòng các hội thánh của Thiên Chúa về sự bền lòng của anh chị em và đức tin giữa mọi cơn bức hại của anh chị em, cùng với những hoạn nạn mà anh chị em đang phải chịu, <verse eid="2TH 1:4" /><verse number="5" style="v" sid="2TH 1:5" />tức là chứng cớ về sự phán xét công bình của Thiên Chúa dành cho anh chị em để được kể là xứng đáng với vương quốc của Thiên Chúa, vì vương quốc đó mà anh chị em cũng đang chịu khổ; <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />vì thật là công bình khi Thiên Chúa báo trả sự hoạn nạn trên những kẻ gây hoạn nạn cho anh chị em, <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />và ban cho anh chị em, là những người chịu hoạn nạn, sự nghỉ ngơi cùng chúng tôi khi sự hiện đến của Chúa Giê-xu tỏ ra từ trời với các thiên sứ mạnh mẽ của Ngài, <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />trong ngọn lửa hừng, đem sự trừng phạt đến cho những kẻ không nhìn biết Thiên Chúa và cho những kẻ không vâng phục Phúc Âm của Chúa chúng ta, là Chúa Giê-xu, <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />đó là những kẻ sẽ gánh lấy hình phạt — là sự hủy diệt đời đời, xa cách mặt Chúa và khỏi vinh quang của quyền năng Ngài, <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />khi Ngài đến để được tôn vinh bởi các thánh đồ của Ngài và được chiêm ngưỡng giữa mọi người đã đặt lòng tin, bởi lời chứng của chúng tôi đến với anh chị em trong ngày đó đã được tin nhận. <verse eid="2TH 1:10" /><verse number="11" style="v" sid="2TH 1:11" />Vì cớ đó, chúng tôi vẫn luôn cầu nguyện cho anh chị em để Thiên Chúa chúng ta kể anh chị em là xứng đáng với sự kêu gọi, và để Ngài làm thành mọi ước muốn về điều lành và công việc của đức tin bởi năng quyền, <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />hầu cho danh của Chúa chúng ta, là Chúa Giê-xu, được tôn vinh nơi anh chị em và anh chị em được vinh hiển nơi Ngài, theo ân điển của Thiên Chúa và Chúa chúng ta, là Chúa Cứu Thế Giê-xu.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />Thưa anh chị em, còn về sự đến của Chúa chúng ta, là Chúa Cứu Thế Giê-xu, và sự hội hiệp của chúng ta với Ngài, chúng tôi xin anh chị em <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />rằng anh chị em đừng dễ dàng bị xao động hoặc hoảng hốt trong tâm trí mình, cũng đừng bởi một linh, hoặc bởi một sứ điệp, hay bởi một bức thư dường như đến từ chúng tôi, khi nói rằng ngày của Chúa đã đến rồi. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Nguyện không một ai theo bất cứ cách nào có thể lừa dối anh chị em, vì trừ phi sự bội đạo đến trước, và con người của sự vô luật pháp được tiết lộ, tức là đứa con của sự hủy diệt, <note caller="+" style="f"><char style="ft" closed="false">Vài bản dịch cũ hơn chép, </char><char style="fqa">con người của tội lỗi</char>. </note> <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />là kẻ chống nghịch và tự tôn mình lên đối địch với mọi điều được xưng là thần hoặc là đối tượng thờ phượng, đến nỗi, tự hắn ngồi trong đền thờ của Thiên Chúa, thể hiện rằng chính hắn là Thiên Chúa. <verse eid="2TH 2:4" /><verse number="5" style="v" sid="2TH 2:5" />Anh chị em không nhớ rằng, khi còn ở với anh chị em, tôi vốn đã cho anh chị em biết những việc này sao? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />Và giờ đây anh chị em đã biết ai đang ngăn trở, để hắn chỉ được xuất hiện vào đúng thời điểm của hắn. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />Vì điều huyền bí của sự vô luật pháp đang hành động rồi, Đấng duy nhất đang ngăn trở hắn hiện nay vẫn còn cho tới lúc Đấng ấy ra khỏi điểm ngăn chặn chính giữa, <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />và rồi kẻ vô luật pháp sẽ được tiết lộ, là kẻ mà Chúa Giê-xu sẽ tiêu diệt bằng hơi thở của miệng Ngài, và sẽ khiến hắn trở thành hư không bởi vinh quang sự hiện đến của Ngài, <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />mà sự xuất hiện của kẻ vô luật pháp kia là nhờ vào việc làm của Sa-tan bằng tất cả quyền năng cùng dấu lạ, cũng như phép mầu giả tạo, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />và với mọi kiểu gian dối bất chính dành cho những kẻ hư mất, mà họ hư mất là vì họ đã chẳng tiếp nhận tình yêu chân lý cho mình để được cứu. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />Và vì lý do đó, Thiên Chúa phó họ vào tác động của sự lầm lạc để họ tin điều giả dối, <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />hầu cho hết thảy họ sẽ bị phán xét, tức là những kẻ không tin chân lý, mà lại vui thích sự bất chính.<verse eid="2TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Nhưng, thưa anh chị em, là những người được Chúa yêu, chúng tôi phải luôn cảm tạ Thiên Chúa về anh chị em. Vì Thiên Chúa đã chọn anh chị em như những trái đầu mùa <note caller="+" style="f"><char style="ft" closed="false">Vài thủ bản cổ đọc </char><char style="fqa">từ lúc ban đầu</char> </note> để hưởng ơn cứu rỗi nhờ sự thánh hóa của Thánh Linh và niềm tin nơi chân lý. <note caller="+" style="f"><char style="ft" closed="false">Một số phiên bản khác đọc: </char><char style="fqa">Vì Thiên Chúa ngay từ đầu đã chọn anh chị em cho sự cứu rỗi</char>. </note> <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Vì để hưởng ơn ấy, Ngài đã kêu gọi anh chị em qua Phúc Âm của chúng tôi, đến với sự hưởng nhận vinh quang của Chúa chúng ta, là Chúa Cứu Thế Giê-xu. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />Vì vậy, thưa anh chị em, hãy đứng vững và giữ chặt những truyền thống mà anh chị em đã được dạy dỗ, bất luận bằng lời nói hoặc bằng thư từ của chúng tôi.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />Nguyện chính Chúa chúng ta, là Chúa Cứu Thế Giê-xu, và Thiên Chúa, Cha chúng ta, Đấng yêu thương chúng ta và đã ban cho chúng ta sự yên ủi đời đời cùng với niềm hy vọng tốt lành bởi ân điển, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />xin Ngài khích lệ và làm cho vững mạnh tấm lòng anh chị em trong mọi hành động cùng lời nói tốt lành.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />Cuối cùng, thưa anh chị em, xin cầu nguyện cho chúng tôi, để lời của Chúa nhanh chóng lan tỏa và được tôn vinh, cũng như đã được thấy nơi anh chị em, <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />và để chúng tôi được giải cứu khỏi những kẻ ngoan cố và gian ác, vì không phải mọi người đều có đức tin. <verse eid="2TH 3:2" /><verse number="3" style="v" sid="2TH 3:3" />Nhưng Chúa, Đấng sẽ làm cho vững mạnh và gìn giữ anh chị em khỏi kẻ ác, Ngài là thành tín. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Chúng tôi tin chắc nơi Chúa về anh chị em rằng anh chị em đang làm và sẽ làm những điều chúng tôi truyền dạy. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />Cầu xin Chúa chỉ dẫn lòng anh chị em hướng về tình yêu của Thiên Chúa và đến với sự kiên nhẫn của Chúa Cứu Thế.<verse eid="2TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />Tuy nhiên, thưa anh chị em, nhân danh Chúa chúng ta là Chúa Cứu Thế Giê-xu, chúng tôi truyền bảo anh chị em, để anh chị em tránh xa mọi tín hữu sống vô kỷ luật và không theo các truyền thống mà anh chị em đã nhận từ chúng tôi. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Vì chính anh chị em biết cần phải noi theo gương chúng tôi ra sao, bởi chúng tôi đã không sống vô kỷ luật giữa anh chị em, <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />chúng tôi cũng không ăn dưng thực phẩm từ một người nào, nhưng đêm ngày làm việc trong nỗi cực nhọc và vất vả để không làm gánh nặng cho bất cứ ai trong anh chị em, <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />chẳng phải vì chúng tôi không có quyền, mà để chúng tôi có thể tự đặt mình như tấm gương cho anh chị em để bắt chước chúng tôi. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />Vì thậm chí khi chúng tôi còn ở với anh chị em, chúng tôi vốn đã truyền bảo anh chị em điều này, rằng: “Nếu người nào không muốn làm việc thì người đó cũng đừng ăn.” <verse eid="2TH 3:10" /><verse number="11" style="v" sid="2TH 3:11" />Bởi chúng tôi nghe nói giữa vòng anh chị em có một số người sống vô kỷ luật, không làm việc mà hay xía vào chuyện chẳng phải của mình. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />Nhưng trong Chúa, là Chúa Cứu Thế Giê-xu, chúng tôi truyền bảo và nài khuyên những người như vậy, hầu cho họ có thể dùng thức ăn của mình khi làm việc cùng với sự yên tịnh. <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />Còn anh chị em, anh chị em đừng chán mệt khi làm điều phải. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />Mặt khác, nếu người nào không tuân giữ lời chúng tôi qua thư này, thì hãy lưu ý người ấy — để không giao du với người, hầu cho người đó tự thấy hổ thẹn. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />Đừng xem người ấy như kẻ thù, mà hãy khuyên răn như một người anh em.<verse eid="2TH 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />Cầu xin chính Chúa bình an ban cho anh chị em sự bình an qua mọi việc trong mọi phương diện. Nguyện Chúa ở cùng hết thảy anh chị em. <verse eid="2TH 3:16" /><verse number="17" style="v" sid="2TH 3:17" />Lời chào này bởi chính tay tôi — Phao-lô — đó là chữ ký trong mọi bức thư. Tôi thường viết như thế. <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />Nguyện ân điển của Chúa chúng ta, là Chúa Cứu Thế Giê-xu, ở với hết thảy anh chị em.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>