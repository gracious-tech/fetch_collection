  <book code="1CO" style="id">EN_VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:24:47 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Corinthians</para>
  <para style="toc1">Thư Cô-rinh-tô thứ nhất</para>
  <para style="toc2">1 Cô-rinh-tô</para>
  <para style="toc3">1Co</para>
  <para style="mt">1 Cô-rinh-tô</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Phao-lô, được kêu gọi làm sứ đồ của Chúa Cứu Thế Giê-xu bởi ý muốn của Thiên Chúa, và người anh em Sốt-then, <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" />gửi cho hội thánh của Thiên Chúa ở tại Cô-rinh-tô, là những người đã được thánh hóa trong Chúa Cứu Thế Giê-xu, tức là các thánh đồ được kêu gọi, cùng với mọi người ở khắp nơi kêu cầu danh Chúa chúng ta, là Chúa Cứu Thế Giê-xu, là Chúa của họ và của chúng ta. <verse eid="1CO 1:2" /><verse number="3" style="v" sid="1CO 1:3" />Nguyện xin ân điển và sự bình an từ Thiên Chúa, là Cha chúng ta, và từ Chúa, là Chúa Cứu Thế Giê-xu, ở với anh chị em.<verse eid="1CO 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Tôi luôn cảm tạ Thiên Chúa của tôi về anh chị em vì cớ ân điển của Ngài, là điều đã được ban cho anh chị em trong Chúa Cứu Thế Giê-xu. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Vì trong mọi sự anh chị em đã được làm cho giàu có trong Ngài, trong mọi lời nói và mọi sự hiểu biết, <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />y như lời chứng về Chúa Cứu Thế đã được xác nhận chắc chắn giữa vòng anh chị em, <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />đến nỗi anh chị em chẳng thiếu hụt ở bất kỳ ân tứ nào, khi sốt sắng chờ đợi sự tỏ bày của Chúa chúng ta, là Chúa Cứu Thế Giê-xu, <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />là Đấng cũng sẽ làm anh chị em vững vàng cho đến cuối cùng, cho không chỗ trách được trong ngày của Chúa chúng ta, là Chúa Cứu Thế Giê-xu. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Thiên Chúa là thành tín, bởi Ngài mà anh chị em đã được kêu gọi vào trong mối thông công với Con của Ngài, là Chúa Cứu Thế Giê-xu, Chúa chúng ta.<verse eid="1CO 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Nhưng thưa anh chị em, tôi nài khuyên anh chị em bởi danh của Chúa chúng ta, là Chúa Cứu Thế Giê-xu, rằng tất cả anh chị em cần có chung tiếng nói, và chớ tồn tại những sự chia rẽ giữa anh chị em, mà anh chị em cần được hiệp với nhau trong cùng tâm trí và trong cùng mục tiêu. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Vì, thưa anh chị em của tôi, nhờ người nhà của Cơ-lô-ê, tình trạng về anh chị em đã được tỏ rỏ cho tôi, rằng có các bè phái xung đột giữa vòng anh chị em. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Tôi có ý như thế này, đó là mỗi người trong anh chị em nói rằng: “Tôi thuộc về Phao-lô,” hoặc “Tôi thuộc về A-bô-lô,” hoặc “Tôi thuộc về Sê-pha,” hoặc “Tôi thuộc về Chúa Cứu Thế.” <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />Chúa Cứu Thế đã bị chia cắt sao? Chẳng lẽ Phao-lô đã bị đóng đinh trên thập tự giá thay cho anh chị em? Hay anh chị em đã chịu báp-têm nhân danh Phao-lô? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />Tôi cảm tạ Thiên Chúa vì tôi đã chẳng làm báp-têm cho ai trong anh chị em, ngoại trừ Cơ-rít-bu và Gai-út, <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />để không người nào có thể nói rằng anh chị em đã nhân danh tôi chịu báp-têm. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />(Tôi cũng đã làm báp-têm cho nhà Sê-pha-na. Ngoài ra, tôi không biết mình có chăng đã làm báp-têm cho ai khác.) <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Bởi Chúa Cứu Thế đã chẳng sai tôi đi làm báp-têm, mà là rao giảng Phúc Âm — không phải bằng lời nói khôn ngoan, hầu cho thập tự giá của Chúa Cứu Thế không bị xem là vô dụng.<verse eid="1CO 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Vì sứ điệp của thập tự giá tuy là điều ngớ ngẩn đối với những kẻ hư mất, nhưng đối với chúng ta, những người được cứu, đó là quyền phép của Thiên Chúa. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />Bởi có lời chép:</para>
  <para style="q1" vid="1CO 1:19">“Ta sẽ hủy phá sự khôn ngoan của những kẻ khôn ngoan;</para>
  <para style="q1" vid="1CO 1:19">và Ta sẽ làm hỏng sự thông sáng của các kẻ thông sáng.”<verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />Người khôn ngoan ở đâu? Học giả ở đâu? Kẻ biện luận của đời này ở đâu? Chẳng phải Thiên Chúa đã biến sự khôn ngoan của thế gian thành sự ngu dại rồi hay sao? <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />Vì xét thấy rằng, trong sự khôn ngoan của Thiên Chúa, thế gian đã không nhận biết Thiên Chúa bằng sự khôn ngoan ấy, nên Thiên Chúa đã vui lòng, thông qua sự rao giảng ngớ ngẩn, để cứu những ai tin. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Vì cớ người Do Thái thì đòi hỏi các dấu lạ, còn người Hy Lạp thì tìm kiếm sự khôn ngoan. <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />Còn chúng tôi thì rao giảng Chúa Cứu Thế bị đóng đinh trên thập tự giá, tuy là hòn đá vấp chân đối với người Do Thái, nhưng là điều ngớ ngẩn đối với các dân ngoại quốc. <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />Mặt khác, đối với họ, là những người được kêu gọi, cả Do Thái lẫn Hy Lạp, Chúa Cứu Thế là quyền phép của Thiên Chúa và sự khôn ngoan của Thiên Chúa. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Vì sự rồ dại của Thiên Chúa là khôn ngoan hơn loài người, và sự yếu đuối của Thiên Chúa thì mạnh mẽ hơn loài người.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Thưa anh chị em, sự thật là anh chị em suy xét sự kêu gọi của mình, thấy rằng không nhiều người khôn ngoan theo xác thịt, không nhiều bậc quyền thế, cũng chẳng nhiều nhân vật xuất thân quý tộc. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Tuy nhiên, Thiên Chúa đã chọn những điều rồ dại của thế gian để Ngài có thể làm cho các kẻ khôn ngoan hổ thẹn, Thiên Chúa đã chọn những điều yếu đuối của thế gian để Ngài có thể làm cho các kẻ mạnh sức xấu hổ, <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />và Thiên Chúa đã chọn những gì thấp hèn, cùng những thứ bị khinh khi trong thế gian, những điều không có, để Ngài có thể khiến những điều có thành ra hư không, <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />hầu cho mọi xác thịt chẳng thể khoe khoang gì trước mặt Thiên Chúa. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Nhưng nhờ Ngài, anh chị em ở trong Chúa Cứu Thế Giê-xu, là Đấng được trở nên sự khôn ngoan đến từ Thiên Chúa, đồng thời là sự công chính lẫn sự nên thánh, cùng sự cứu chuộc dành cho chúng ta, <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />hầu cho, như có lời chép: “Ai khoe mình, hãy khoe mình trong Chúa.”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Thưa anh chị em, lúc đến cùng anh chị em, tôi cũng đã chẳng đến với sự cao siêu của lời lẽ hay của sự khôn ngoan, khi công bố cho anh chị em điều huyền nhiệm của Thiên Chúa. <note caller="+" style="f"><char style="ft" closed="false">Nhiều phiên bản khác đọc </char><char style="fqa">để công bố lời chứng về Thiên Chúa.</char></note> <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Vì ở giữa vòng anh chị em, tôi đã quyết định chẳng biết gì ngoại trừ Chúa Cứu Thế Giê-xu và Ngài đã bị đóng đinh trên cây thập tự. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Tôi cũng đã ở với anh chị em trong sự yếu đuối, trong nỗi sợ sệt và run rẩy lắm. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />Lời nói của tôi và sự rao giảng của tôi không bằng những phát ngôn đầy thuyết phục của tâm trí khôn khéo, nhưng là bằng sự minh chứng của Thánh Linh và năng quyền, <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />để đức tin anh chị em không ở nơi sự khôn ngoan của con người, mà là nơi quyền phép của Thiên Chúa.<verse eid="1CO 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Nhưng giữa những người trưởng thành, chúng tôi giảng sự khôn ngoan, mà không phải sự khôn ngoan của đời này, cũng chẳng phải của các bậc cai trị đời này, là những người bị tan biến đi. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Thay vào đó, chúng tôi giảng sự khôn ngoan của Thiên Chúa trong sự huyền nhiệm, là điều từng được giấu kín mà Thiên Chúa đã định sẵn từ trước các thời đại dành cho sự vinh hiển của chúng ta, <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />là điều mà không một ai trong các bậc cai trị của đời này hiểu được, vì nếu họ hiểu, thì ắt hẳn họ đã không đóng đinh Chúa vinh hiển trên cây thập tự. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Tuy nhiên, như có lời chép:</para>
  <para style="q1" vid="1CO 2:9">“Điều mắt chưa thấy,</para>
  <para style="q1" vid="1CO 2:9">tai chưa nghe,</para>
  <para style="q1" vid="1CO 2:9">và chưa nảy sinh trong lòng người,</para>
  <para style="q1" vid="1CO 2:9">là những điều mà Thiên Chúa đã chuẩn bị sẵn cho những ai yêu mến Ngài.”<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Bởi Thiên Chúa đã mạc khải cho chúng tôi qua Thánh Linh. Do Thánh Linh tra xét mọi sự, ngay cả những điều thâm sâu của Thiên Chúa. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Vì ai giữa vòng loài người biết được những điều trong một người, nếu không phải là tâm thần của người đó bên trong chính mình? Cũng như vậy, không ai nhận biết những điều thuộc Thiên Chúa, ngoại trừ Thánh Linh của Thiên Chúa. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Nhưng chúng tôi đã không nhận lãnh linh của thế gian này, mà là Thánh Linh đến từ Thiên Chúa, để chúng tôi có thể biết những điều được ban tặng miễn phí bởi Thiên Chúa cho chúng ta, <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />cũng là những điều mà chúng tôi giảng, chẳng phải bằng sự dạy bảo bởi các lời lẽ khôn ngoan của con người, nhưng là bằng sự dạy bảo của Thánh Linh, khi giãi bày những điều thuộc linh bởi các lời thuộc linh. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Nhưng người theo bản tánh tự nhiên thì không đón nhận những điều thuộc về Thánh Linh của Thiên Chúa, vì chúng là sự ngớ ngẩn đối với kẻ ấy, và kẻ ấy không có khả năng để hiểu bởi chúng phải được thẩm định theo cách thuộc linh. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Còn người thuộc linh thẩm định mọi sự, nhưng chính mình thì không bị ai thẩm định.<verse eid="1CO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CO 2:16" />“Vì ai nhận biết tâm trí của Chúa — ai sẽ chỉ bảo Ngài?”</para>
  <para style="m" vid="1CO 2:16">Nhưng chúng ta thì có tâm trí của Chúa Cứu Thế.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Thưa anh chị em, tôi lại chẳng thể nói với anh chị em như với những người thuộc linh, nhưng là như với những người xác thịt, như với các trẻ sơ sinh trong Chúa Cứu Thế. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Tôi đã cho anh chị em uống sữa chứ chẳng phải thức ăn đặc, vì anh chị em chưa có khả năng. Thế mà, thậm chí bây giờ, anh chị em cũng chưa có khả năng. <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />Vì anh chị em vẫn còn tính xác thịt. Bởi ở giữa anh chị em, là nơi có sự đố kỵ và tranh chấp, thì chẳng phải anh chị em là tính xác thịt, và ăn ở như người đời sao? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Bởi, khi người này nói: “Tôi thuộc về Phao-lô,” còn người khác: “Tôi thuộc về A-bô-lô,” thì chẳng phải anh chị em là người đời sao? <verse eid="1CO 3:4" /><verse number="5" style="v" sid="1CO 3:5" />Thế thì, A-bô-lô là ai? Còn Phao-lô là ai? Là các tôi tớ, mà anh chị em có đức tin qua họ, thậm chí tùy vào chỗ Chúa đã đặt cho mỗi người. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Tôi đã trồng, A-bô-lô đã tưới, nhưng Thiên Chúa làm cho tăng trưởng. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Thế nên, không phải người trồng, cũng chẳng phải người tưới là gì đó, nhưng Đấng làm cho tăng trưởng là Thiên Chúa. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Còn người trồng và người tưới là một, nhưng mỗi người sẽ nhận được tiền công mình tùy theo sự lao nhọc của bản thân. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Vì chúng tôi là những bạn đồng lao thuộc về Thiên Chúa. Anh chị em là cánh đồng của Thiên Chúa, ngôi nhà của Thiên Chúa.<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />Tùy theo ân điển của Thiên Chúa đã ban cho tôi, tôi đã lập nền giống như người thợ cả lành nghề, rồi người khác xây cất trên đó, nhưng mỗi người phải thận trọng về cách mình xây lên trên, <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />vì không ai có thể lập một nền khác ngoài nền được lập, mà đó là Chúa Cứu Thế Giê-xu. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Thế rồi, nếu người nào xây trên nền ấy với vàng, bạc, đá quý, gỗ, cỏ khô, rơm rạ, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />thì công việc của mỗi người sẽ trở nên rõ ràng, vì ngày ấy sẽ tỏ ra; bởi nó được phơi bày trong lửa, và chính lửa sẽ kiểm nghiệm công việc của mỗi người có tính chất gì. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Nếu công việc của ai vẫn cứ còn lại, tức là công trình mà người đó đã xây, thì người đó sẽ nhận được phần thưởng; <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />nếu công việc của ai bị thiêu hủy, thì người đó sẽ chịu thiệt hại, còn chính mình sẽ được cứu, nhưng theo cách giống như qua lửa.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Anh chị em không biết rằng anh chị em là đền thờ của Thiên Chúa và Thánh Linh Thiên Chúa sống trong mình hay sao? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Nếu kẻ nào phá hủy đền thờ của Thiên Chúa, thì Thiên Chúa sẽ phá hủy kẻ ấy. Vì đền thờ của Thiên Chúa là thánh, mà đền thờ ấy là anh chị em.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Đừng ai tự lừa dối mình. Nếu người nào trong anh chị em có vẻ như là khôn ngoan trong đời này, thì người ấy hãy để cho mình trở thành “kẻ dại”, hầu cho có thể được trở nên khôn ngoan. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Vì sự khôn ngoan của thế gian này là sự ngớ ngẩn trước mặt Thiên Chúa. Vì có lời chép, rằng:</para>
  <para style="q1" vid="1CO 3:19">“Ngài bắt giữ những kẻ khôn trong sự tinh ranh của họ.”<verse eid="1CO 3:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 3:20" />Và lại có chép:</para>
  <para style="q1" vid="1CO 3:20">“Chúa biết các lý lẽ của những kẻ khôn ngoan, rằng chúng là vô ích.”<verse eid="1CO 3:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="1CO 3:21" />Thế nên, đừng ai khoe khoang nơi loài người. Vì hết thảy là của anh chị em, <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />dầu là Phao-lô, hay A-bô-lô, hay Sê-pha, dầu là thế giới, hoặc sự sống, hay sự chết, hoặc việc hiện có, hay việc sắp đến. Tất cả đều thuộc về anh chị em, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />còn anh chị em thuộc về Chúa Cứu Thế, và Chúa Cứu Thế thuộc về Thiên Chúa.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Do đó, mỗi người hãy xem chúng tôi như những đầy tớ của Chúa Cứu Thế và những người quản lý các sự huyền nhiệm của Thiên Chúa. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Còn vấn đề ở đây, ấy là điều được đòi hỏi nơi những người quản lý là sao cho mỗi người được thấy là trung tín. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Nhưng vấn đề này là chuyện quá nhỏ nhoi đối với tôi, dầu cho tôi có thể bị thẩm tra bởi anh chị em hay bởi tòa án của con người. Mặt khác, tôi cũng không tự thẩm định bản thân mình. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Vì tôi nhận thấy chẳng có vấn đề gì chống nghịch chính mình, tuy nhiên tôi không được xưng công chính nhờ việc ấy; nhưng Chúa là Đấng thẩm định tôi. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Thế nên, đừng xét đoán điều gì trước kỳ hạn, là tới khi Chúa đến, là Đấng vừa sẽ đưa những việc kín giấu của sự tối tăm ra ánh sáng, vừa sẽ phơi bày các ý định trong lòng. Rồi vào lúc đó, sự khen ngợi từ Thiên Chúa sẽ đến với từng người.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Thưa anh chị em, tôi đã vận dụng những điều này đối với chính mình và A-bô-lô vì ích lợi của anh chị em, để qua chúng tôi, anh chị em có thể học biết câu này:</para>
  <para style="q1" vid="1CO 4:6">“Đừng vượt quá lời được chép,”</para>
  <para style="m" vid="1CO 4:6">hầu cho không một ai lên mình kiêu ngạo nhân danh người này chống lại người kia. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Vì ai phân chia anh chị em tách biệt nhau? Mặt khác, điều gì anh chị em đang có mà mình đã không nhận lấy? Nhưng nếu anh chị em đã nhận, thì sao anh chị em khoe khoang như thể đã chẳng nhận? <verse eid="1CO 4:7" /><verse number="8" style="v" sid="1CO 4:8" />Anh chị em thì đã được thỏa mãn rồi! Anh chị em đã trở nên giàu có rồi! Anh chị em đã bắt đầu cai trị mà không cần chúng tôi, và tôi ước anh chị em thật sự cai trị, để chúng tôi cũng có thể cai trị chung với anh chị em. <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Vì tôi thiết nghĩ Thiên Chúa đã bày chúng tôi ra làm các sứ đồ cuối chót, như những kẻ bị kết án tử hình. Vì chúng tôi đã trở thành một màn trình diễn cho thế gian — cả cho thiên sứ lẫn cho loài người. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Chúng tôi thì rồ dại vì cớ Chúa Cứu Thế, còn anh chị em thì khôn ngoan trong Chúa Cứu Thế. Chúng tôi yếu đuối, còn anh chị em mạnh mẽ. Anh chị em được tôn trọng, còn chúng tôi bị khinh khi. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Cho đến giờ này, chúng tôi vừa chịu đói, chịu khát, vừa ăn mặc tồi tàn, lẫn bị đánh đập tàn nhẫn, vừa không có nơi ở ổn định, <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />lẫn lao nhọc vất vả, làm việc bằng chính đôi tay mình. Khi bị chửi rủa, chúng tôi chúc phước; khi bị bức hại, chúng tôi cam chịu; <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />khi bị vu cáo, chúng tôi xoa dịu. Chúng tôi đã trở nên như những thứ cặn bã của thế gian, rác rưởi của mọi vật, cho đến tận bây giờ.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Tôi không viết những lời này để làm xấu hổ anh chị em, nhưng tôi khuyên dạy anh chị em như con yêu dấu của tôi. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Vì dù anh chị em có hàng vạn người hướng dẫn trong Chúa Cứu Thế, thì vẫn không có nhiều cha; bởi tôi đã sinh ra anh chị em trong Chúa Cứu Thế Giê-xu nhờ Phúc Âm. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Vậy, tôi nài khuyên anh chị em hãy trờ nên những người bắt chước tôi. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Vì lý do này tôi sai Ti-mô-thê đi, tức là người con yêu dấu và trung tín của tôi trong Chúa, đến với anh chị em, cậu ấy sẽ nhắc nhở anh chị em về những đường lối của tôi trong Chúa Cứu Thế Giê-xu, y như tôi giảng dạy trong từng hội thánh khắp nơi. <verse eid="1CO 4:17" /><verse number="18" style="v" sid="1CO 4:18" />Tuy nhiên, như thể vì tôi không đến với anh chị em, nên một số kẻ đã lên mình kiêu ngạo. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Nhưng tôi sẽ sớm đến với anh chị em, nếu Chúa muốn, và tôi sẽ nhận biết chẳng phải lời nói của những kẻ kiêu ngạo kia, nhưng là năng lực của họ. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Vì vương quốc Thiên Chúa không phải ở lời nói, nhưng là ở năng quyền. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Anh chị em muốn gì? Tôi cần đến cùng anh chị em với cây roi, hay với tình yêu thương và tinh thần hiền hòa?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Vấn đề thực sự được nghe nói ở giữa vòng anh chị em là một việc gian dâm, và kiểu gian dâm như thế là điều thậm chí không có giữa vòng các dân ngoại quốc — đến mức mà một kẻ nọ lấy vợ của cha mình. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Còn anh chị em thì vẫn kiêu ngạo, lại càng chẳng hề than khóc gì, hầu cho kẻ đã làm việc ấy có thể bị loại trừ khỏi giữa vòng anh chị em. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Vì tôi, tuy xa cách trong thân xác nhưng hiện diện trong tâm thần, đã tuyên án kẻ phạm tội dường ấy rồi, như thể đang có mặt ở đó. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Trong danh Chúa chúng ta, là Chúa Cứu Thế Giê-xu, khi anh chị em đã được nhóm hiệp lại, cùng tâm thần của tôi, với quyền năng của Chúa chúng ta, là Chúa Giê-xu, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />để phó người đó cho Sa-tan hầu chịu sự hủy hoại xác thịt, sao cho tâm linh người đó có thể được cứu trong ngày của Chúa. <verse eid="1CO 5:5" /><verse number="6" style="v" sid="1CO 5:6" />Sự khoe khoang của anh chị em chẳng tốt lành gì. Anh chị em không biết rằng một ít men làm dậy cả tảng bột sao? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Hãy tẩy sạch men cũ, để anh chị em có thể là tảng bột mới, giống như anh chị em là bánh không men. Vì Chúa Cứu Thế, là chiên con Lễ Vượt Qua của chúng ta, cũng đã bị giết làm sinh tế. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Thế nên, chúng ta cần dự lễ, không phải với men cũ, cũng chẳng phải với men gian tà và độc ác, nhưng là với bánh không men của sự thành thật và chân lý.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Trong thư tôi đã viết cho anh chị em là đừng giao du với bọn gian dâm — <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />dĩ nhiên không phải những kẻ gian dâm của thế gian này, hay là những kẻ tham lam và lừa đảo, hoặc những kẻ thờ hình tượng, vì như vậy, anh chị em cần phải đi ra khỏi thế gian. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Nhưng như bây giờ, tôi đã viết cho anh chị em đừng giao du với bất luận người nào được gọi là anh em mà là kẻ gian dâm, tham lam, thờ hình tượng, quen mắng chửi, say xỉn, hoặc lừa đảo; thậm chí cũng đừng ăn chung với một kẻ như thế. <verse eid="1CO 5:11" /><verse number="12" style="v" sid="1CO 5:12" />Vì xét đoán những kẻ ở ngoài can hệ gì đến tôi? Anh chị em không xét đoán những người ở trong sao? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Nhưng Thiên Chúa sẽ xét đoán những kẻ ngoài kia.</para>
  <para style="q1" vid="1CO 5:13">“Hãy loại bỏ điều gian ác khỏi giữa chính anh chị em.”<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Khi có vụ việc nghịch với người khác, ai đó trong anh chị em dám để bị xét đoán trước mặt những kẻ không công chính, mà không phải trước mặt các thánh đồ sao? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Hay anh chị em không biết rằng các thánh đồ sẽ xét đoán thế gian? Và nếu thế gian sẽ bị xét đoán bởi anh chị em, thì anh chị em không đủ năng lực về những vụ kiện tụng quá nhỏ nhặt này sao? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Anh chị em không biết rằng chúng ta sẽ xét đoán các thiên sứ sao? Nói chi đến những vấn đề của đời này? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Vậy thì, dù anh chị em có những vụ kiện tụng thuộc về đời này, tại sao anh chị em đặt những kẻ đó ngồi xét xử, tức là những kẻ bị coi chẳng có phần chi trong hội thánh? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Tôi đang nói về điều đáng hổ thẹn của anh chị em. Như vậy, chẳng lẽ không có người khôn ngoan nào trong anh chị em, là người sẽ có thể phân xử ở giữa anh chị em mình sao? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Trái lại, anh em này chịu đưa ra xét xử nghịch lại anh em kia, và vụ việc đó ở trước mặt những người vô tín? <verse eid="1CO 6:6" /><verse number="7" style="v" sid="1CO 6:7" />Thế nên, tình trạng này vốn dĩ là một thất bại hoàn toàn đối với anh chị em rồi, vì anh chị em có các vụ kiện tụng giữa vòng chính mình. Vì sao chẳng thà chịu thiệt? Vì sao chẳng thà chịu lừa gạt? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Tuy nhiên, anh chị em cư xử bất công và gian lận, rồi làm vậy với anh chị em mình! <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />Hay anh chị em không biết rằng kẻ không công chính sẽ chẳng thừa hưởng vương quốc Thiên Chúa? Đừng để bị lừa dối; chẳng kẻ gian dâm, kẻ thờ hình tượng, kẻ ngoại tình, kẻ ẻo lả, kẻ đồng tính luyến ái, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />kẻ trộm cắp, kẻ tham lam, kẻ say xỉn, kẻ vu khống hay kẻ lừa đảo, sẽ thừa hưởng vương quốc Thiên Chúa. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Và một số trong anh chị em đã từng như vậy. Tuy nhiên, anh chị em đã được thanh tẩy, đã được thánh hóa, đã được xưng công chính trong danh Chúa, là Chúa Cứu Thế Giê-xu, và bởi Thánh Linh của Thiên Chúa chúng ta.<verse eid="1CO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />“Mọi sự đối với tôi là được phép,” nhưng không phải mọi sự đem đến ích lợi. “Mọi sự đối với tôi là được phép,” nhưng tôi sẽ không bị nô dịch bởi bất kỳ điều gì. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />“Đồ ăn dành cho dạ dày, và dạ dày dành cho đồ ăn,” nhưng Thiên Chúa sẽ hủy hoại cả cái này lẫn cái kia. Nhưng thân thể không phải dành cho sự dâm dục, mà dành cho Chúa, và Chúa dành cho thân thể. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Thiên Chúa đã khiến Chúa sống lại, cũng sẽ khiến chúng ta sống lại bởi năng quyền của Ngài. <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />Anh chị em không biết rằng thân thể mình là chi thể của Chúa Cứu Thế sao? Vậy thì, sau khi lấy chi thể của Chúa Cứu Thế, tôi nên biến chúng thành chi thể của đĩ điếm không? Không bao giờ có chuyện đó! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Hay anh chị em không biết rằng người kết hiệp chính mình với đĩ điếm là một thịt với nó? Vì có chép: “Hai người sẽ trở nên một thịt.” <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Nhưng ai kết hiệp chính mình với Chúa thì là một thể thuộc linh cùng Ngài. <verse eid="1CO 6:17" /><verse number="18" style="v" sid="1CO 6:18" />Hãy lánh xa sự gian dâm! Mọi tội mà người ta phạm có chăng là ở bên ngoài thân thể, nhưng kẻ làm sự gian dâm thì phạm tội với chính thân thể mình. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Hay anh chị em không biết rằng thân thể mình là đền thờ của Chúa Thánh Linh ở trong anh chị em, là Đấng mà anh chị em nhận từ Thiên Chúa? Và anh chị em chẳng thuộc về chính mình, <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />vì anh chị em đã được chuộc mua bằng giá cao rồi. Vì vậy, hãy làm vinh hiển Thiên Chúa bằng thân thể mình. <note caller="+" style="f"><char style="ft" closed="false">Một số bản cổ hơn đọc </char><char style="fqa">Vì vậy, hãy làm vinh hiển Thiên Chúa bằng cả thân thể và tâm linh mình, vốn giờ đây đã thuộc về Thiên Chúa</char> Nhưng các bản đáng tin cậy nhất không có phần thêm vào này.</note><verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Còn về những điều mà anh chị em đã viết: “Thật tốt cho người đàn ông không chung đụng với phụ nữ.” <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Nhưng vì cám dỗ gian dâm, mỗi người đàn ông hãy lấy vợ cho mình, và mỗi phụ nữ hãy lấy chồng cho mình. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Chồng phải làm tròn trách nhiệm đối với vợ, còn vợ đối với chồng cũng giống như vậy. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Vợ không có quyền trên thân thể của mình, nhưng là chồng. Mà giống như vậy, chồng cũng không có quyền trên thân thể của mình, nhưng là vợ. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Đừng từ chối nhau, trừ phi là bởi sự đồng thuận trong một thời gian nhất định để anh chị em có thể chuyên tâm cầu nguyện, rồi lại ở cùng nhau, hầu cho Sa-tan chẳng có thể cám dỗ anh chị em bởi sự thiếu tự chủ của mình.<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />Tuy nhiên, tôi nói điều này như một sự nhân nhượng, không phải như mạng lịnh. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Nhưng tôi ước ao mọi người thậm chí được như tôi. Dầu vậy, mỗi người có ân tứ riêng từ Thiên Chúa, tuy có người thế này, nhưng có kẻ thế khác. <verse eid="1CO 7:7" /><verse number="8" style="v" sid="1CO 7:8" />Còn đối với những người chưa kết hôn và các góa phụ, tôi bảo rằng nếu họ cứ tiếp tục như tôi là tốt. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Nhưng nếu họ không kiềm giữ mình được, thì họ hãy kết hôn. Vì kết hôn thì tốt hơn chịu un đốt. <verse eid="1CO 7:9" /><verse number="10" style="v" sid="1CO 7:10" />Còn đối với những ai đã kết hôn thì tôi truyền lệnh — không phải tôi, mà là Chúa — rằng vợ không chịu chia lìa khỏi chồng <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />(nhưng thậm chí nếu cô ấy đã bị chia lìa, thì cô phải cứ tiếp tục không tái hôn, hoặc phải hòa giải với chồng), và chồng thì không ly dị vợ. <verse eid="1CO 7:11" /><verse number="12" style="v" sid="1CO 7:12" />Nhưng đối với những người còn lại thì tôi truyền — tôi, chứ không phải Chúa — nếu anh em nào có vợ chưa tin, và cô ấy bằng lòng sống với mình, thì anh em không được phép ly dị cô ấy. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Nếu một phụ nữ nào có chồng chưa tin và người ấy thuận tình sống với mình, thì vợ không được ly dị chồng. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Vì chồng chưa tin được thánh hóa nhờ vợ mình, và vợ chưa tin được thánh hóa nhờ người anh em đó. Vì nếu không thì con cái anh chị em là không thanh sạch, nhưng giờ đây chúng được thánh. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />Còn nếu người không tin đó tự phân rẽ, thì hãy để người ấy được phân rẽ. Người anh em hay chị em ấy không bị ràng buộc trong trường hợp đó, mà là Thiên Chúa đã kêu gọi chúng ta ở trong sự bình an. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Vì, thưa người chị em, làm sao chị em biết có chăng rằng chị em sẽ cứu được chồng mình? Hay, thưa người anh em, làm sao anh em biết có chăng rằng anh em sẽ cứu được vợ mình? <verse eid="1CO 7:16" /><verse number="17" style="v" sid="1CO 7:17" />Nếu không có, thì Chúa đã phân phát cho từng người ra sao, Thiên Chúa đã kêu gọi mỗi người thế nào, hãy bước đi thế ấy. Và tôi quy định như vậy trong tất cả các hội thánh. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Ai đã được gọi sau khi chịu cắt bì chăng? Người ấy đừng như chưa cắt bì. Ai đã được gọi trong tình trạng chưa cắt bì chăng? Người đó đừng chịu cắt bì. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Cắt bì chẳng là gì, không cắt bì cũng chẳng là gì, mà quan trọng là sự tuân giữ các điều răn của Thiên Chúa. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Mỗi người, trong tiếng gọi mà mình đã được kêu gọi, hãy cứ tiếp tục trong cương vị ấy. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Anh chị em được kêu gọi trong thân phận nô lệ chăng? Đừng để điều đó làm cho anh chị em bận tâm. Tuy nhiên, nếu anh chị em thật có thể trở nên tự do, thì hãy nắm lấy cơ hội. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Vì một người, là nô lệ, được kêu gọi trong Chúa thì trở thành người tự do của Chúa. Cũng vậy, người tự do được kêu gọi thì trở thành nô lệ của Chúa Cứu Thế. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Anh chị em đã được mua chuộc bằng giá cao rồi; đừng trở thành nô lệ của loài người. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Thưa anh chị em, mỗi người ở trong tình trạng nào khi được kêu gọi, thì hãy cứ tiếp tục với Thiên Chúa trong tình trạng đó.<verse eid="1CO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Nhưng liên quan đến những người độc thân, tôi không có mạng lịnh của Chúa. Tuy nhiên, tôi đưa ra ý kiến vì đã nhận được ơn thương xót từ Chúa để là một người đáng tin cậy. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />Do đó, tôi cho rằng tình trạng ấy là tốt, bởi cớ sự khó khăn hạn chế đã đến gần, rằng thật tốt cho một người tiếp tục ở trong hiện trạng như vậy. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Phải chăng anh em được ràng buộc với vợ? Đừng tìm cách thoát ly. Phải chăng anh em được thoát ly khỏi vợ? Đừng tìm vợ. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Còn nếu anh em cưới vợ, thì anh em không phạm tội; và nếu một trinh nữ lấy chồng, thì cô ấy không phạm tội. Tuy nhiên, những người thể ấy sẽ có nỗi khốn khổ trong xác thịt, mà tôi muốn anh chị em tránh điều đó. <verse eid="1CO 7:28" /><verse number="29" style="v" sid="1CO 7:29" />Nhưng, thưa anh chị em, tôi bảo điều này: Thời gian thì đã bị gói gọn, hầu cho từ nay trở đi, kể cả những ai có vợ thì nên như không có; <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />những ai khóc, thì như không khóc; ai vui mừng, thì như chẳng vui; những ai mua sắm, thì như chẳng sở hữu gì; <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />và những ai dùng của cải thế gian, thì như không tận dụng; vì hiện trạng của thế gian này đang qua đi. <verse eid="1CO 7:31" /><verse number="32" style="v" sid="1CO 7:32" />Mặt khác, tôi mong muốn anh chị em được khỏi phiền hà. Người độc thân bận tâm những điều thuộc về Chúa, cách nào mà mình có thể làm vui lòng Chúa. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Nhưng đàn ông đã kết hôn bận tậm những việc của đời này, cách nào người chồng có thể làm vui lòng vợ mình, và người đó bị phân tâm. Phụ nữ độc thân hay trinh nữ <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />bận tâm những điều thuộc về Chúa, sao cho mình có thể được thánh khiết cả trong thân thể lẫn trong tâm linh. Nhưng phụ nữ đã kết hôn bận tâm những việc của đời này, cách nào người vợ có thể làm vui lòng chồng mình. <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />Tuy nhiên, tôi đang nói điều này vì ích lợi của chính anh chị em, không phải để tôi có thể đặt bẫy khống chế anh chị em, nhưng để hướng đến sự phục vụ chính đáng và chuyên tâm cho Chúa một cách không xao lãng. <verse eid="1CO 7:35" /><verse number="36" style="v" sid="1CO 7:36" />Nhưng nếu người nào cho rằng đang hành xử không đúng đối với con gái đồng trinh của mình — phải chăng cô ấy có thể bị lỡ thì và vì thế việc kết hôn nên được xảy ra — thì người ấy hãy làm điều mình mong muốn. Người ấy chẳng phạm tội; hãy để họ kết hôn. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Còn ai kiên định trong lòng mình, chẳng có sự thúc ép, mà có quyền trên ý muốn của chính mình và người ấy đã quyết định như vậy trong lòng mình — để gìn giữ con gái đồng trinh của mình — thì người ấy sẽ hành xử cách đúng đắn. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Như vậy, người gả con gái đồng trinh mình làm phải, và người không gả thậm chí sẽ làm tốt hơn. <verse eid="1CO 7:38" /><verse number="39" style="v" sid="1CO 7:39" />Người vợ bị ràng buộc suốt bao lâu chồng mình còn sống. Nhưng nếu chồng chết, thì cô ấy được tự do kết hôn với người nào mình muốn, miễn là trong Chúa. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Tuy nhiên, theo ý kiến của tôi thì cô ấy được phước hơn nếu có thể tiếp tục ở như vậy. Nhưng, tôi cho rằng mình cũng có Thánh Linh của Thiên Chúa.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Về những thứ cúng cho thần tượng: Chúng ta biết rằng hết thảy chúng ta có tri thức. Tri thức thì khiến kiêu căng, nhưng tình yêu thương thì gây dựng. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Nếu ai tưởng mình biết điều gì đó, thì người ấy vẫn chưa biết như mình nên biết. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Nhưng nếu ai kính mến Thiên Chúa, thì người đó được Ngài nhận biết. <verse eid="1CO 8:3" /><verse number="4" style="v" sid="1CO 8:4" />Vậy, về việc ăn những thứ cúng tế cho thần tượng: Chúng ta biết rằng thần tượng trong thế gian là hư không, và rằng chẳng có thần thánh nào ngoài Chân Thần duy nhất. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Vì ngay cả giả sử có những thứ được gọi là thần, hoặc ở trên trời hay dưới đất, giống như có nhiều “thần” và nhiều “chúa”, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />nhưng đối với chúng ta chỉ có một Thiên Chúa, là Cha, Đấng mà muôn vật bắt nguồn, và là Đấng mà chúng ta hướng về, cùng một Chúa là Chúa Cứu Thế Giê-xu, nhờ Ngài mà muôn vật được dựng nên, và nhờ Ngài mà chúng ta được hiện hữu.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Tuy nhiên, tri thức này không ở trong mọi người. Nhưng nhiều người nọ theo thói quen từ trước đến nay với thần tượng, họ ăn những thứ ấy như thể đồ đã cúng cho thần tượng, rồi lương tâm vốn yếu đuối của họ bị ô uế. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Mặt khác, thức ăn sẽ chẳng đem chúng ta đến gần Thiên Chúa; nếu không ăn, chúng ta cũng chẳng kém đi, nếu ăn chúng ta cũng chẳng thêm hơn. <verse eid="1CO 8:8" /><verse number="9" style="v" sid="1CO 8:9" />Nhưng hãy cẩn thận, kẻo bằng cách nào đó, quyền tự do này của anh chị em có thể trở thành cớ vấp phạm cho người yếu đuối. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Vì nếu ai đó nhìn thấy người có tri thức ngồi ăn trong đền thờ thần tượng, thì chẳng phải lương tâm vốn yếu đuối của họ sẽ bị thúc giục để ăn những thứ được cúng cho thần tượng sao? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Thế thì, một người yếu đuối, một người anh em mà Chúa Cứu Thế đã chết thay, bị hủy hoại bởi tri thức của anh chị em. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Mặt khác, theo cách đó, khi phạm tội nghịch với các anh chị em mình và làm tổn thương lương tâm yếu đuối của họ, thì anh chị em phạm tội nghịch với Chúa Cứu Thế. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Cho nên nếu đồ ăn làm cho một người anh em của tôi phạm tội, thì tôi chắc chắn sẽ không bao giờ ăn thịt, hầu cho tôi chẳng gây vấp phạm cho người anh em của mình.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Tôi không được tự do sao? Tôi không phải là một sứ đồ sao? Tôi chưa từng gặp Chúa Giê-xu, Chúa chúng ta sao? Chẳng phải anh chị em là công việc của tôi trong Chúa sao? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Dù tôi không phải là sứ đồ đối với những người khác, nhưng ít nhất tôi là sứ đồ đối với anh chị em. Vì anh chị em là chứng cớ về vai trò sứ đồ của tôi trong Chúa. <verse eid="1CO 9:2" /><verse number="3" style="v" sid="1CO 9:3" />Lời biện hộ của tôi đối với những kẻ chất vấn tôi là thế này: <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Chẳng lẽ chúng tôi không có quyền ăn và uống? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Chẳng lẽ chúng tôi không có quyền dẫn theo một người vợ tin Chúa, cũng như các sứ đồ khác cùng những người em trai của Chúa và Sê-pha? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Hay chỉ mỗi Ba-na-ba và tôi chẳng có quyền không làm việc? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />Ai đi lính bằng lương nhà mình bao giờ? Ai trồng vườn nho mà không ăn trái nó? Hay ai chăn bầy mà không uống sữa của bầy? <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />Không phải tôi đang nói những điều này theo cách người đời sao, hay luật pháp cũng chẳng nói các điều ấy? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Vì có lời chép trong luật pháp Môi-se: “Đừng đeo rọ vào mồm con bò đang đạp lúa.” Chẳng lẽ Thiên Chúa lo cho con bò? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Hay Ngài phán hoàn toàn vì ích lợi của chúng ta? Thật, lời được chép vì ích lợi của chúng ta, rằng người cày ruộng phải cày trong hy vọng, và người đập lúa thì làm trong sự mong đợi về phần chia cho mình. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Nếu chúng tôi đã gieo những điều thuộc linh giữa vòng anh chị em, thì có quá đáng không nếu chúng tôi sẽ gặt hái những vật thuộc thể từ anh chị em? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Nếu những người khác có phần về quyền đó trên anh chị em, thì chẳng phải chúng tôi càng nhiều hơn sao? Tuy nhiên, chúng tôi không lợi dụng quyền này. Thay vào đó, chúng tôi chịu đựng mọi điều để chúng tôi không đưa đến bất kỳ rào cản nào cho Phúc Âm của Chúa Cứu Thế. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />Anh chị em không biết rằng những ai phục vụ trong đền thờ thì ăn những thứ thuộc đền thờ, những người phục vụ tại bàn thờ thì có phần nơi bàn thờ, hay sao? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Cũng một cách đó, Chúa đã truyền dạy rằng những người công bố Phúc Âm thì sống nhờ Phúc Âm. <verse eid="1CO 9:14" /><verse number="15" style="v" sid="1CO 9:15" />Nhưng tôi chẳng lợi dụng bất kỳ điều nào trong các quyền đó. Mặt khác, tôi không viết những lời này để quyền ấy được áp dụng cho mình như thế, vì đối với tôi, thà chết còn hơn là bất kỳ ai sẽ làm cho niềm hãnh diện của tôi ra hư không. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Bởi nếu tôi rao giảng Phúc Âm, thì chẳng có gì cho tôi để hãnh diện, do bổn phận bắt buộc được áp đặt trên tôi. Vì thật là khốn thay cho tôi nếu tôi không rao giảng Phúc Âm! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Nếu tôi sẵn lòng làm việc ấy, thì tôi được phần thưởng. Còn nếu không sẵn lòng, thì tôi đã chịu ủy thác chức vụ quản gia rồi. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Vậy, phần thưởng của tôi là gì? Đó là khi rao giảng Phúc Âm không kèm thù lao, tôi có thể trình bày Phúc Âm sao cho không tận dụng quyền của mình trong Phúc Âm. <verse eid="1CO 9:18" /><verse number="19" style="v" sid="1CO 9:19" />Vì dù được tự do khỏi mọi điều, tôi đã khiến bản thân làm đầy tớ cho mọi người, để tôi có thể chinh phục nhiều người hơn. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Đối với người Do Thái, tôi trở nên như người Do Thái, để tôi có thể chinh phục người Do Thái. Đối với những ai ở dưới luật pháp, tôi trở nên như người ở dưới luật pháp, dù bản thân không ở dưới luật pháp, để tôi có thể chinh phục những ai ở dưới luật pháp. <note caller="+" style="f"><char style="ft" closed="false">Bản ULT và UST đọc </char><char style="fqa">Tôi làm như vậy dầu chính tôi không ở dưới luật pháp. </char> Một số bản cổ hơn thì bỏ đi phần này.</note> <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Đối với những người không có luật pháp, tôi trở nên như người không có luật pháp (dù chẳng phải là không có luật pháp của Thiên Chúa, nhưng là ở dưới luật pháp của Chúa Cứu Thế), để tôi có thể chinh phục những người không có luật pháp. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Đối với những người yếu đuối, tôi trở nên yếu đuối, để tôi có thể chinh phục những người yếu đuối. Tôi đã trở nên mọi cách đối với mọi người, hầu cho tôi có thể bằng mọi cách cứu được một số người. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />Mặt khác, tôi làm mọi việc vì cớ Phúc Âm, để tôi có thể trở nên người dự phần trong đó. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />Anh chị em không biết rằng tất cả những người chạy trong trường đua đều chạy, nhưng chỉ một người nhận giải thưởng sao? Hãy chạy theo cách đó để anh chị em có thể đạt được phần thưởng. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Mặt khác, mỗi người tranh đua trong các cuộc thi đấu thì rèn luyện tính tự chủ trong mọi việc. Tuy họ chịu vậy để họ có thể nhận mão miện mau hư nát, nhưng chúng ta là mão miện không hư nát. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Vậy nên, tôi chạy như thế, chẳng phải như không có mục đích; tôi đánh đấm như thế, chẳng phải như đánh không khí. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />Trái lại, tôi bắt phục thân thể mình và nô dịch nó, kẻo e bằng cách nào đó, sau khi giảng dạy nhiều người khác, chính mình tôi có thể bị loại ra.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Vì thưa anh chị em, tôi chẳng muốn anh chị em không biết rằng tổ phụ chúng ta hết thảy đã ở dưới đám mây, hết thảy đã vượt qua biển, <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />hết thảy hướng theo Môi-se đã được làm báp-têm trong đám mây và dưới biển, <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />hết thảy đã ăn cùng một thức ăn thuộc linh, <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />và hết thảy đã uống cùng một thức uống thuộc linh, vì họ uống từ một hòn đá thuộc linh theo mình, mà đá đó là Chúa Cứu Thế. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Tuy nhiên, Thiên Chúa đã không đẹp lòng với đa số những người ấy, nên họ đã bị ngã rạp đây đó trong hoang mạc. <verse eid="1CO 10:5" /><verse number="6" style="v" sid="1CO 10:6" />Mặt khác, những điều này đã trở thành các minh họa cho chúng ta, để chẳng khiến chúng ta là các kẻ ham muốn những điều xấu xa cũng giống như họ đã ham muốn. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />Cũng đừng trở thành những kẻ thờ hình tượng như mấy kẻ kia trong số họ; đến nỗi như có lời chép: “Dân chúng ngồi xuống để ăn và uống, rồi đứng dậy đùa giỡn.” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Chúng ta cũng chẳng nên phạm tội tà dâm như nhiều người trong số họ đã hành dâm, mà hai mươi ba ngàn người đã ngã chết trong một ngày. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Cũng không nên thử Chúa<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fq">Chúa</char>, nhiều thủ bản cổ đọc <char style="fqa">Chúa Cứu Thế</char>.</note> như nhiều người trong số họ đã thử Ngài rồi bị giết chết bởi rắn. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />Cũng đừng lằm bằm như nhiều người trong số họ đã lằm bằm và bị đấng hủy diệt giết chết. <verse eid="1CO 10:10" /><verse number="11" style="v" sid="1CO 10:11" />Tuy nhiên, các việc ấy đã xảy ra cho họ như những minh họa, mà chúng đã được ghi lại dành cho việc răn bảo chúng ta, là trên những người mà những sự cuối cùng của các thời đại đã đến rồi. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />Vì vậy, ai nghĩ mình đứng, hãy cẩn thận kẻo ngã. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Chẳng sự cám dỗ nào đã đến cùng anh chị em trừ ra điều thuộc về loài người; mặt khác, Thiên Chúa thành tín, là Đấng sẽ không để anh chị em bị cám dỗ vượt quá sức anh chị em có thể, nhưng với sự cám dỗ đó, Ngài cũng sẽ tạo ra lối thoát để anh chị em có thể chịu đựng được.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Vì vậy, anh chị em yêu dấu của tôi ơi, hãy lánh xa khỏi sự thờ hình tượng. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Như thể tôi đang truyền bảo với những người khôn sáng. Anh chị em hãy tự suy xét điều tôi nói. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Chén phước lành mà chúng ta chúc tạ, chẳng phải đó là sự dự phần trong huyết của Chúa Cứu Thế sao? Bánh mà chúng ta bẻ ra, chẳng phải đó là sự dự phần trong thân của Chúa Cứu Thế sao? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Vì có một ổ bánh, nên chúng ta, dù nhiều, chỉ là một thân, bởi tất cả chúng ta dự phần trong một ổ bánh. <verse eid="1CO 10:17" /><verse number="18" style="v" sid="1CO 10:18" />Hãy nhìn dân Y-sơ-ra-ên theo phần xác. Chẳng phải những ai ăn sinh tế là những người dự phần nơi bàn thờ sao? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Vậy, tôi đang nói điều gì? Của cúng thần tượng là thứ gì, hay thần tượng là cái chi? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Dẫu vậy, những thứ mà các dân ngoại quốc cúng tế là cúng tế cho ma quỷ, không phải cho Thiên Chúa. Mà tôi không muốn anh chị em trở thành những kẻ dự phần với các quỷ! <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Anh chị em chẳng thể nào uống chén của Chúa và chén của ma quỷ được. Anh chị em chẳng thể nào dự phần nơi bàn của Chúa và tại bàn của ma quỷ được. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Hay chúng ta khiêu khích cho Chúa nổi giận chăng? Chẳng lẽ chúng ta thì mạnh hơn Ngài?<verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />“Mọi sự thì được phép,” nhưng không phải mọi sự đem đến ích lợi. “Mọi sự thì được phép,” nhưng không phải mọi sự mang tính gây dựng. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Đừng ai tìm kiếm ích lợi của riêng mình, nhưng là lợi ích của người khác. <verse eid="1CO 10:24" /><verse number="25" style="v" sid="1CO 10:25" />Hãy ăn mọi thứ được buôn bán ngoài chợ, không thắc mắc gì vì cớ lương tâm. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />Vì “đất cùng mọi thứ trong nó thuộc về Chúa.” <verse eid="1CO 10:26" /><verse number="27" style="v" sid="1CO 10:27" />Nếu bất kỳ người chưa tin nào mời anh chị em và anh chị em muốn đi, thì hãy ăn mọi món được dọn trước mặt mình, không thắc mắc điều gì vì cớ lương tâm. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Nhưng nếu ai đó nói với anh chị em: “Đây là đồ cúng,” thì đừng ăn, vì cớ người đó, là người đã cho anh chị em biết, và lương tâm —<note caller="+" style="f"><char style="ft" closed="false">Một số bản cổ hơn thêm câu </char><char style="fqa">Vì đất và mọi vật trong đó đều thuộc về Chúa.</char> Nhưng các bản đáng tin cậy nhất không có câu này.</note> <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />nhưng tôi nói về lương tâm, không phải là của bản thân anh chị em, mà là lương tâm của người đó. Ấy là vì sao sự tự do của tôi bị lương tâm của người khác xét đoán? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Nếu tôi chung dự với lòng biết ơn, thì sao tôi bị xúc phạm vì món mà tôi tạ ơn? <verse eid="1CO 10:30" /><verse number="31" style="v" sid="1CO 10:31" />Do đó, bất luận anh chị em ăn hay uống, hoặc làm một việc nào đó, hãy làm tất cả cho sự vinh hiển của Thiên Chúa. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Đừng gây cớ cấp phạm cho cả người Do Thái lẫn người Hy Lạp và hội thánh của Thiên Chúa, <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />giống như tôi cũng sẵn lòng phục vụ mọi người trong mọi việc, không tìm lợi ích của riêng mình, nhưng là lợi ích của nhiều người, để họ có thể được cứu.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="nb">
    <verse number="1" style="v" sid="1CO 11:1" />Hãy trở nên những người noi gương tôi, như tôi cũng là người noi gương Chúa Cứu Thế.<verse eid="1CO 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Tôi khen anh chị em vì anh chị em đã nhớ đến tôi trong mọi việc, và anh chị em giữ vững các truyền thống, y như tôi đã truyền cho anh chị em. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />Tuy nhiên, tôi muốn anh chị em hiểu rằng Chúa Cứu Thế là đầu của mọi người đàn ông, mà đàn ông là đầu của người phụ nữ, còn Thiên Chúa là đầu của Chúa Cứu Thế. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Mọi người đàn ông cầu nguyện hoặc nói tiên tri, nếu có gì đó trùm trên đầu, thì bôi nhọ đầu mình. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />Nhưng mọi người phụ nữ cầu nguyện hoặc nói tiên tri với đầu không được trùm lại, thì bôi nhọ đầu mình. Vì điều này là một với việc đầu đã bị cạo. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Vì nếu một phụ nữ không trùm đầu, thì cô ấy cũng hãy cắt tóc đi. Còn nếu cắt tóc hoặc cạo đầu là sự ô nhục đối với người phụ nữ, thì cô ấy phải trùm đầu lại. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Bởi một mặt, người đàn ông chẳng nên trùm đầu mình vì mang hình ảnh và vinh quang của Thiên Chúa. Mặt khác, người phụ nữ là vinh quang của người đàn ông. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Vì đàn ông thì chẳng ra từ phụ nữ, mà là phụ nữ ra từ đàn ông. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Cũng vì đàn ông không được tạo dựng vì phụ nữ, mà là phụ nữ vì đàn ông. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Bởi lý do ấy, phụ nữ cần phải đội dấu hiệu thẩm quyền trên đầu mình, vì cớ các thiên sứ. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Dẫu vậy, trong Chúa, phụ nữ không độc lập với đàn ông, đàn ông cũng chẳng độc lập với phụ nữ. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />Vì phụ nữ ra từ đàn ông thể nào, thì đàn ông cũng nhờ phụ nữ mà có thế ấy, nhưng muôn vật ra từ Thiên Chúa. <verse eid="1CO 11:12" /><verse number="13" style="v" sid="1CO 11:13" />Hãy tra xét ở giữa chính mình anh chị em: Người phụ nữ không trùm đầu cầu nguyện với Thiên Chúa thì phù hợp không? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Chẳng phải ngay cả chính lẽ tự nhiên dạy anh chị em rằng một mặt, nếu đàn ông để tóc dài, thì đó là nỗi ô nhục cho người, <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />mặt khác, nếu phụ nữ có mái tóc dài, thì đó là vinh quang dành cho cô ấy sao? Vì mái tóc dài đã được ban cho cô ấy ví như khăn trùm đầu. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Còn nếu ai dường như có lòng tranh cãi về việc này, thì chúng tôi không có kiểu thói quen như thế, các hội thánh của Thiên Chúa cũng không.<verse eid="1CO 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Nhưng khi đưa ra huấn lệnh sau đây, tôi chẳng khen anh chị em, vì anh chị em nhóm họp với nhau không tiến đến điều tốt hơn nhưng là hướng tới chỗ tệ hơn. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Bởi trước hết, khi anh chị em nhóm lại trong hội thánh, tôi nghe về nhiều sự chia rẽ ở giữa vòng anh chị em, và tôi tin điều đó phần nào. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />Vì cần phải có các bè phái giữa vòng anh chị em, hầu cho những ai đã chịu thử luyện cũng có thể được tỏ ra rõ ràng giữa vòng anh chị em. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Bởi thế, khi anh chị em nhóm lại tại cùng một chỗ, việc ấy chẳng phải là để dự Tiệc Thánh của Chúa. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Vì trong lúc ăn, mỗi người lo dùng bữa ăn của mình trước; nên tuy có người thì đói meo, nhưng có kẻ thì say xỉn. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Chẳng lẽ anh chị em không có nhà để ăn và uống trong đó sao? Hay anh chị em khinh dể hội thánh của Thiên Chúa và làm bẽ mặt những người chẳng có gì? Tôi nên nói gì với anh chị em? Nên khen ngợi anh chị em về việc này chăng? Tôi chẳng khen anh chị em đâu! <verse eid="1CO 11:22" /><verse number="23" style="v" sid="1CO 11:23" />Vì tôi đã nhận từ Chúa điều tôi cũng đã truyền lại cho anh chị em, đó là Chúa Giê-xu, trong đêm mà Ngài bị phản nộp, đã lấy bánh, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />rồi sau khi tạ ơn, Ngài bẻ nó ra và nói: “Đây là thân thể của thầy thay cho anh em. Hãy làm điều này trong sự tưởng nhớ về thầy.” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Cũng một cách đó đối với chén sau khi ăn, rằng: “Chén này là giao ước mới trong huyết thầy. Hễ khi nào anh chị em uống chén, hãy làm điều này trong sự tưởng nhớ về thầy.” <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />Vì hễ khi nào anh chị em ăn bánh này và uống chén này, thì anh chị em công bố sự chết của Chúa cho tới khi Ngài đến. <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />Cho nên, bất kỳ ai ăn bánh hoặc uống chén của Chúa một cách không xứng đáng thì sẽ có tội với thân và huyết của Chúa. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Trái lại, mỗi người phải tự xét mình, rồi trong thái độ đó hãy ăn bánh và uống chén. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Bởi kẻ ăn và uống mà không phân biệt thân Chúa là ăn và uống sự đoán xét cho mình. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Vì lý do đó, nhiều người trong anh chị em đau ốm, bệnh tật và lắm kẻ ngủ. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Nhưng nếu chúng ta tự tra xét mình, thì ắt hẳn chúng ta không bị xét đoán. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Còn khi bị Chúa xét đoán, chúng ta bị sửa phạt để khỏi bị kết án chung với thế gian. <verse eid="1CO 11:32" /><verse number="33" style="v" sid="1CO 11:33" />Thế nên, anh chị em của tôi ơi, khi nhóm lại để ăn, hãy chờ đợi nhau. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Nếu người nào đói, thì hãy ăn ở nhà, để anh chị em không nhóm họp ở trong sự xét đoán. Còn về những việc khác, tôi sẽ đưa ra lời chỉ dẫn ngay lúc nào tôi đến.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Còn về những ơn thuộc linh, thưa anh chị em, tôi không muốn anh chị em chẳng hay biết gì. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Anh chị em biết rằng khi mình còn là người ngoại, anh chị em đã bị dẫn dắt theo cách nào đó, khi bị dụ dỗ hướng về các thần tượng câm. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Vì vậy, tôi tỏ cho anh chị em biết rằng không ai phát ngôn bởi Thánh Linh của Thiên Chúa mà lại nói: “Giê-xu là kẻ đáng nguyền rủa!”, và nếu không bởi Chúa Thánh Linh, chẳng ai có thể xưng nhận “Chúa Giê-xu là Chúa.”<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Mặt khác, có nhiều sự khác biệt về các ân tứ, nhưng cùng một Thánh Linh. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />Có nhiều sự khác biệt về các việc phục vụ, mà cùng một Chúa. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Có nhiều sự khác biệt về các công việc, mà cùng một Thiên Chúa, là Đấng làm mọi việc trong mọi người. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />Nhưng sự thể hiện của Thánh Linh được ban cho mỗi người để đem lại ích lợi chung. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Vì nhờ Thánh Linh, lời khôn ngoan được ban cho người này, còn lời tri thức được ban cho kẻ khác theo cùng một Thánh Linh ấy; <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />bởi cùng một Thánh Linh đức tin được ban cho người này, còn ơn chữa bệnh được ban cho người khác bởi một Thánh Linh ấy, <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />rồi cho người này, những công việc quyền năng; cho người kia, lời nói tiên tri; cho người nọ, khả năng phân biệt các thần; cho người khác, các kiểu thứ tiếng khác nhau; mà cho người khác nữa, sự thông giải các thứ tiếng. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Nhưng chỉ duy nhất và cùng một Thánh Linh thực hiện mọi việc ấy, khi phân phát chúng cách riêng biệt cho mỗi người tùy theo ý Ngài muốn.<verse eid="1CO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Vì giống như thân là một mà có nhiều chi thể, còn tất cả các chi thể của thân, dù có nhiều, thì chỉ là một thân; Chúa Cứu Thế cũng như vậy. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Vì thật bởi một Thánh Linh, tất cả chúng ta được làm báp-têm vào trong một thân, dù là người Do Thái hay người Hy Lạp, dù là nô lệ hay tự do, thì tất cả được khiến cho uống một Thánh Linh. <verse eid="1CO 12:13" /><verse number="14" style="v" sid="1CO 12:14" />Do thân không phải là một chi thể, nhưng là nhiều chi thể. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Giả sử chân nói: “Vì tôi không phải là tay, nên tôi không thuộc về thân,” thì không thể vì cớ ấy mà nó chẳng thuộc về thân. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Và giả như tai nói: “Vì tôi không phải là mắt, nên tôi không thuộc về thân,” thì không thể vì cớ ấy mà nó chẳng thuộc về thân. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Nếu toàn thân là con mắt, thì việc nghe ở đâu? Nếu toàn thân là lỗ tai, thì chuyện ngửi ở đâu? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Thế nên, trái lại, Thiên Chúa đã sắp đặt các chi thể trong thân, từng cái một trong số chúng, tùy theo ý Ngài muốn. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Còn nếu tất cả vốn là một chi thể, thì thân ở đâu? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Mà bởi thế, tuy nhiều chi thể, nhưng chỉ một thân. <verse eid="1CO 12:20" /><verse number="21" style="v" sid="1CO 12:21" />Mặt khác, mắt chẳng có thể nói với tay: “Tôi không có nhu cầu về anh”, hoặc đầu cũng thế đối với chân: “Tôi không có nhu cầu về anh.” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Trái lại, những chi thể trong thân có vẻ như là yếu ớt hơn thì là thiết yếu càng hơn; <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />bộ phận nào trong thân mà chúng ta thấy có vẻ là tầm thường hơn thì chúng ta dành cho chúng sự tôn trọng lớn hơn; và những chi thể không đẹp của chúng ta thì có sự tô điểm nhiều hơn, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />còn các chi thể đã đẹp của chúng ta thì không có nhu cầu ấy. Tuy nhiên, Thiên Chúa đã kết hợp thân thể với nhau, ban thêm sự tôn trọng cho cái nào ít được tôn trọng, <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />hầu cho không có sự chia rẽ trong thân, nhưng mà các chi thể cùng quan tâm đến nhau. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Nếu một chi thể bị đau, thì tất cả các chi thể cùng chịu; nếu một chi thể được tôn trọng, thì mọi chi thể chung vui với nó. <verse eid="1CO 12:26" /><verse number="27" style="v" sid="1CO 12:27" />Mặt khác, anh chị em là thân thể của Chúa Cứu Thế, và là những chi thể của từng phần riêng biệt. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Thiên Chúa đã chỉ định một số người trong hội thánh, trước nhất là sứ đồ, thứ hai là các tiên tri, thứ ba là các giáo sư, rồi đến các phép lạ, sau đó là các ân tứ chữa bệnh, giúp đỡ, quản trị, và các kiểu thứ tiếng khác nhau. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Chẳng lẽ hết thảy là sứ đồ? Chẳng lẽ hết thảy là tiên tri? Chẳng lẽ hết thảy là giáo sư? Chẳng lẽ hết thảy đều làm phép lạ? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Chẳng lẽ hết thảy có ơn chữa bệnh? Chẳng lẽ hết thảy nói tiếng lạ? Chẳng lẽ hết thảy thông giải được? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Nhưng hãy tha thiết ao ước các ân tứ lớn lao hơn. Còn ngay bây giờ, tôi chỉ cho anh chị em thấy một con đường tuyệt vời hơn.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Dù tôi có thể nói các thứ tiếng của loài người và thiên sứ, mà tôi không có tình yêu thương, thì tôi đã trở nên cái cồng vang tiếng hay chập chõa inh ỏi. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Dù tôi có ơn nói tiên tri và có thể hiểu tất cả huyền nhiệm cùng mọi tri thức, và dù tôi có hết cả đức tin đến nỗi di chuyển núi đồi, mà tôi không có tình yêu thương, thì tôi chẳng là gì cả. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Thậm chí dẫu khi tôi cho đi mọi của cải cá nhân, và dù tôi phó thân mình hầu cho tôi có thể khoe ra, mà tôi không có tình yêu thương, thì tôi chẳng được gì. <note caller="+" style="f"><char style="ft" closed="false">Các cổ bản đáng tin cậy nhất đọc </char><char style="fqa">Tôi phó thân để có thể khoe ra.</char> Một số phiên bản khác đọc <char style="fqa">Tôi hiến thân mình để chịu đốt.</char></note> <verse eid="1CO 13:3" /><verse number="4" style="v" sid="1CO 13:4" />Tình yêu thương có lòng nhẫn nhục và bày tỏ sự hiền lành, tình yêu thương chẳng ghen tị, tình yêu thương không khoe khoang, không kiêu ngạo, <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />không hành xử lỗ mãng, không tìm kiếm đòi hỏi những gì của riêng mình, chẳng dễ bị chọc giận, không toan tính điều gian ác, <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />chẳng mừng về điều bất chính, nhưng vui sướng trong chân lý; <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />tình yêu thương bao dung mọi sự, tin tưởng mọi sự, hy vọng mọi sự, chịu đựng mọi sự. <verse eid="1CO 13:7" /><verse number="8" style="v" sid="1CO 13:8" />Tình yêu thương chẳng bao giờ tàn lụi. Mặt khác, dù là ơn nói tiên tri, thì chúng sẽ bị dứt; dù là ơn nói nhiều thứ tiếng, thì chúng sẽ ngưng; dù là tri thức khôn ngoan, thì nó sẽ bị bỏ đi. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Vì chúng ta học biết phần nào, và chúng ta nói tiên tri phần nào. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />Nhưng khi sự đầy trọn đến, cái chưa trọn của phần ấy sẽ bị bỏ đi. <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />Khi tôi còn là trẻ con, tôi nói như trẻ con, tôi suy nghĩ như trẻ con, tôi lý luận như trẻ con. Khi tôi đã nên người, tôi bỏ đi những việc của trẻ con. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Vì lúc này, chúng ta nhìn thấy qua gương với bóng mờ, nhưng đến lúc đó thì mặt đối mặt. Hiện giờ, tôi có hiểu biết phần nào, nhưng đến lúc đó, tôi sẽ nhận biết cách đầy đủ, cũng như tôi đã được nhận biết cách đầy đủ. <verse eid="1CO 13:12" /><verse number="13" style="v" sid="1CO 13:13" />Nhưng bây giờ còn lại ba điều này: đức tin, hy vọng, và tình yêu thương. Mà điều cao trọng hơn hết trong ba điều ấy là tình yêu thương.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Hãy theo đuổi tình yêu thương, nhưng phải sốt sắng về các ân tứ thuộc linh, mà nhất là để anh chị em có thể nói tiên tri. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Vì người nói tiếng lạ thì không nói với người ta, nhưng là với Thiên Chúa; vì chẳng ai hiểu, dẫu vậy, người nói những điều huyền nhiệm trong tâm thần. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Nhưng người nói tiên tri thì nói ra điều gây dựng, và khích lệ cùng sự an ủi dành cho người ta. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Người nói tiếng lạ thì gây dựng bản thân, còn người nói tiên tri thì gây dựng Hội Thánh. <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />Mặt khác, tôi ước ao tất cả anh chị em nói tiếng lạ, mà còn hơn thế nữa, đó là anh chị em có thể nói tiên tri. Nhưng người nói tiên tri quan trọng hơn người nói tiếng lạ, trừ phi ai đó có thể thông giải, hầu cho hội thánh nhận được sự gây dựng. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />Nhưng, thưa anh chị em, giả như bây giờ tôi đến nói các thứ tiếng lạ với anh chị em, thì tôi sẽ giúp ích gì cho anh chị em nếu tôi không nói với anh chị em trong sự mạc khải, hay tri thức khôn ngoan, hoặc bằng lời tiên tri hay lời giáo huấn? <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />Thậm chí các vật vô tri phát ra âm thanh — dù là ống sáo hay đàn hạc — nếu mỗi thứ không tạo ra những âm thanh riêng biệt, thì tiếng được thổi trên ống sáo hoặc tiếng được chơi trên đàn hạc sẽ được nhận biết bằng cách nào? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Vì nếu kèn phát ra âm thanh không rõ ràng thì ai sẽ chuẩn bị cho trận chiến? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Anh chị em cũng giống như vậy, nếu thông qua miệng lưỡi mình, anh chị em không trình bày lời nói rõ ràng dễ hiểu, thì làm sao điều được phát ngôn sẽ có thể hiểu được? Vì anh chị em chỉ là đang nói chuyện với không khí. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Có các kiểu ngôn ngữ khác nhau trên thế giới, hẳn có lẽ là nhiều vô vàn, và chẳng có cái nào là vô nghĩa. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />Vậy, nếu tôi không biết nghĩa của ngôn ngữ, thì tôi sẽ là người ngoại quốc đối với người đang nói, và người đang nói ấy sẽ là người ngoại quốc đối với tôi. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Anh chị em cũng giống như vậy, vì anh chị em là những người sốt sắng trong các ân tứ thuộc linh hướng tới việc gây dựng hội thánh, nên hãy tìm kiếm hầu cho anh chị em có dư dật. <verse eid="1CO 14:12" /><verse number="13" style="v" sid="1CO 14:13" />Bởi vậy, người nói tiếng lạ hãy cầu nguyện để ai đó có thể thông giải. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Nếu tôi cầu nguyện bằng tiếng lạ, thì tâm linh của tôi cầu nguyện, nhưng tâm trí tôi thì chẳng kết quả gì. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Vậy thì sao đây? Tôi sẽ cầu nguyện bằng tâm linh, nhưng cũng sẽ cầu nguyện bằng tâm trí. Tôi sẽ hát bằng tâm linh, nhưng cũng sẽ hát bằng tâm trí. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Bằng không, nếu anh chị em chúc tụng bằng tâm linh, thì làm thế nào người đứng vào chỗ của người tầm thường sẽ nói “A-men” đối với lời tạ ơn của anh chị em, vì người ấy chẳng biết anh chị em đang nói gì? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Vì dù rằng anh chị em dâng lời tạ ơn cách tốt lành, nhưng người khác không được gây dựng. <verse eid="1CO 14:17" /><verse number="18" style="v" sid="1CO 14:18" />Tôi cảm tạ Thiên Chúa rằng tôi nói nhiều tiếng lạ hơn tất cả anh chị em, <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />nhưng trong hội thánh, tôi thà nói năm từ bằng tâm trí mình để tôi cũng có thể dạy dỗ những người khác, hơn là hàng vạn từ bằng tiếng lạ.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Anh chị em ơi, đừng trở nên trẻ con trong suy nghĩ của mình. Trái lại, phải như trẻ con đối với điều ác, nhưng hãy trở nên người trưởng thành trong suy nghĩ. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Trong luật pháp có lời chép rằng:</para>
  <para style="m" vid="1CO 14:21">Chúa phán:</para>
  <para style="q1" vid="1CO 14:21">“Ta sẽ nói với dân này</para>
  <para style="q1" vid="1CO 14:21">bởi những người nói các thứ tiếng khác và bằng môi miệng của những kẻ xa lạ;</para>
  <para style="q1" vid="1CO 14:21">mà thậm chí như vậy, họ cũng sẽ chẳng nghe Ta.”<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />Chính vì thế, các tiếng lạ để làm một dấu hiệu, không phải cho người tin, mà là cho người chưa tin; còn nói tiên tri thì không phải cho người chưa tin, mà là cho người tin. <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />Vậy thì, giả như cả hội thánh nhóm lại tại cùng một chỗ và hết thảy nói tiếng lạ, mà người tầm thường hay người chưa tin đến dự, thì chẳng phải họ sẽ nói rằng anh chị em điên khùng hay sao? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Nhưng nếu hết thảy nói tiên tri, mà một số người chưa tin hoặc người tầm thường đến dự, thì người đó sẽ được mọi người khiển trách và được mọi người tra vấn, <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />những điều kín giấu trong lòng người ấy được nên rõ ràng, và vì vậy, khi đã sấp mặt xuống, người ấy sẽ thờ phượng Thiên Chúa, tuyên bố rằng “Thiên Chúa thật sự ở giữa anh chị em.”<verse eid="1CO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Vậy, thưa anh chị em, tóm lại là gì? Khi anh chị em nhóm họp lại, mỗi người có thi thiên, có lời dạy dỗ, có sự mạc khải, có tiếng lạ, hoặc có sự thông giải. Hãy để mọi điều xảy ra hướng tới việc gây dựng. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Phải chăng ai đó nói tiếng lạ, thì mỗi lần hai hoặc nhiều nhất là ba người, theo thứ tự, và một người phải thông giải. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Còn nếu không có người thông giải, thì người đó phải nín lặng trong hội thánh. Thay vào đó, hãy nói với chính mình và với Thiên Chúa. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />Còn những người được ơn nói tiên tri, hãy để hai hoặc ba người phát biểu, và những người khác phải suy xét. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Nhưng nếu có điều chi được bày tỏ cho một ai đó khác đang ngồi nhóm, thì người thứ nhất phải im tiếng. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Vì tất cả có thể nói tiên tri từng người một, để mọi người có thể học biết và mọi người được khích lệ. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Tâm linh của các tiên tri chịu phục các tiên tri. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />Vì Thiên Chúa không phải là của sự hỗn loạn, mà là của sự hòa bình.</para>
  <para style="p" vid="1CO 14:33">Như trong tất cả hội thánh của các thánh đồ, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />phụ nữ phải yên lặng trong hội thánh. Vì họ không được phép nói, mà phải thuận phục, cũng như luật pháp dạy. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Nhưng nếu họ muốn học biết điều gì, thì họ phải hỏi chồng của mình ở nhà, vì thật là đáng xấu hổ đối với phụ nữ lên tiếng giữa hội thánh. <verse eid="1CO 14:35" /><verse number="36" style="v" sid="1CO 14:36" />Hay lời của Thiên Chúa xuất phát từ anh chị em sao? Hoặc lời Ngài chỉ đến với anh chị em mà thôi?<verse eid="1CO 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1CO 14:37" />Nếu người nào cho rằng mình là tiên tri hay người thuộc linh, thì người ấy phải nhận biết rằng những điều tôi viết cho anh chị em là mạng lịnh của Chúa. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Nhưng nếu kẻ nào không chịu nhìn biết như vậy, thì hãy để kẻ đó không được nhìn biết. <note caller="+" style="f"><char style="ft" closed="false">Các cổ bản đáng tin cậy nhất đọc </char><char style="fqa">Nhưng nếu người nào không nhìn biết như vậy, thì cứ để mặc người.</char> Một số phiên bản cổ hơn đọc<char style="fqa">Nhưng nếu ai không công nhận như vậy thì đừng công nhận người.</char></note><verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Chính vì vậy, thưa anh chị em, hãy khao khát nói tiên tri và đừng cấm nói tiếng lạ. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />Nhưng hãy thực hiện mọi việc cách đúng đắn và trong trật tự.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Thưa anh chị em, tôi tỏ cho anh chị em biết về Phúc Âm mà tôi đã công bố cho anh chị em, là điều mà anh chị em cũng đã tiếp nhận, và đứng vững trên đó, <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />cũng bởi Phúc Âm ấy mà anh chị em được cứu, nếu anh chị em nắm chặt lấy sứ điệp mà tôi đã rao giảng cho anh chị em, nếu không phải vậy, thì anh chị em đã tin cách vô ích. <verse eid="1CO 15:2" /><verse number="3" style="v" sid="1CO 15:3" />Vì trong số những điều trước nhất tôi đã truyền cho anh chị em, là điều mà tôi cũng đã tiếp nhận — đó là Chúa Cứu Thế đã chết vì tội lỗi của chúng ta theo lời Kinh Thánh, <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />Ngài đã bị chôn, và đã được khiến sống lại vào ngày thứ ba theo lời Kinh Thánh, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />và Ngài đã hiện ra cho Sê-pha, rồi cho mười hai sứ đồ. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Tiếp theo, Ngài đã tỏ mình cho hơn năm trăm anh em nhìn thấy cùng một lúc, hầu hết nhiều người trong số họ hiện vẫn còn sống, nhưng một số đã ngủ. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Sau đó, Ngài đã hiện ra cho Gia-cơ, rồi cho tất cả các sứ đồ. <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />Thế rồi, cho tới cuối chót của mọi người, Ngài cũng đã tỏ mình cho tôi xem thấy, như thể cho một đứa trẻ sinh non. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />Vì tôi là người nhỏ nhất trong các sứ đồ, là người chẳng có xứng đáng gì để được gọi là sứ đồ, vì tôi đã bức hại hội thánh của Thiên Chúa. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Nhưng bởi ân điển của Thiên Chúa mà tôi là chính mình hiện tại, và ân điển của Ngài trong tôi chẳng phải là vô ích. Thay vào đó, tôi đã lao khổ nhiều hơn hẳn tất cả các vị đó, nhưng không phải tôi, mà là ân điển của Thiên Chúa ở với tôi. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Vậy, dù là tôi hay là các vị ấy, thì chúng tôi rao giảng như thế và anh chị em đã tin như vậy.<verse eid="1CO 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Tuy nhiên, nếu Chúa Cứu Thế được rao giảng rằng Ngài đã được khiến sống lại từ cõi chết, thì làm sao một số người trong anh chị em nói rằng không có sự sống lại của người chết? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Nhưng nếu không có sự sống lại của người chết, thì ngay cả Chúa Cứu Thế cũng đã không được khiến sống lại; <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />mà nếu Chúa Cứu Thế đã không được khiến sống lại, thì sự giảng dạy của chúng tôi là vô ích, và đức tin của anh chị em cũng vô giá trị. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Còn chúng tôi thậm chí bị xem là mấy kẻ làm chứng dối của Thiên Chúa, bởi chúng tôi đã làm chứng về Thiên Chúa rằng Ngài đã khiến Chúa Cứu Thế sống lại, thế nên giả như người chết không được làm cho sống lại, thì Ngài đã chẳng khiến Đấng ấy sống lại. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Bởi nếu người chết không được làm cho sống lại, thì ngay cả Chúa Cứu Thế cũng đã không được khiến sống lại, <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />mà nếu Chúa Cứu Thế đã không được khiến sống lại, thì đức tin của anh chị em là vô ích; anh chị em vẫn còn ở trong tội lỗi mình. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Thế nên những người đã ngủ trong Chúa Cứu Thế cũng bị hư mất. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Nếu chúng ta có hy vọng nơi Chúa Cứu Thế chỉ trong cuộc sống này, thì chúng ta là những kẻ đáng thương hơn hết trong tất cả mọi người.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Nhưng bây giờ, Chúa Cứu Thế đã được khiến sống lại từ cõi chết, là trái đầu mùa của những kẻ đã ngủ. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Bởi vì qua một người mà có sự chết, thì cũng qua một người mà có sự sống lại của kẻ chết. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Vì thể nào trong A-đam, mọi người đều chết, thì cũng thể ấy, trong Chúa Cứu Thế, mọi người sẽ được làm cho sống. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Nhưng mỗi người theo thứ tự riêng của mình: Chúa Cứu Thế là trái đầu mùa; kế đến là những kẻ thuộc về Chúa Cứu Thế vào lúc tái lâm của Ngài. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Sau đó sẽ là sự cuối cùng, lúc Ngài giao vương quốc lại cho Thiên Chúa là Cha, khi Ngài đã diệt hết thảy quyền cai trị, cùng mọi thẩm quyền và thế lực. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Vì Đấng ấy phải cai trị cho đến khi Ngài đã đặt hết thảy các kẻ thù nghịch dưới chân mình. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Kẻ thù cuối cùng bị hủy diệt là sự chết. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Vì “Ngài đã đặt muôn vật dưới chân mình.” Nhưng khi nói rằng “Ngài đã đặt muôn vật,” thì rõ ràng là không bao gồm Đấng khiến muôn vật thuận phục Ngài. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Bấy giờ, khi muôn vật đã bị bắt phải phục Ngài, thì lúc ấy, chính Con cũng sẽ chịu phục Đấng đã bắt muôn vật phục mình, để Thiên Chúa có thể là tất cả trong mọi sự.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Nếu không phải vậy, thì những kẻ chịu báp-têm thay cho người chết sẽ làm gì? Nếu người chết không thật sự được khiến cho sống lại, thì tại sao mấy kẻ ấy chịu báp-têm thay cho những người kia? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Rồi vì sao chúng tôi chịu nguy hiểm hằng giờ? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Anh chị em ơi, tôi chết hằng ngày, bởi sự tự hào về anh chị em, là điều tôi có trong Chúa Cứu Thế Giê-xu, Chúa chúng ta. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Giả như theo cách của loài người, tôi đã đấu địch với các thú dữ tại Ê-phê-sô, thì điều ích lợi gì dành cho tôi? Nếu kẻ chết chẳng được khiến sống lại, thì “Hãy ăn và uống, vì ngày mai chúng ta chết.” <verse eid="1CO 15:32" /><verse number="33" style="v" sid="1CO 15:33" />Đừng để bị lừa dối: “Những kẻ đồng hành xấu làm bại hoại các thói nết tốt.” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Hãy tỉnh táo trở lại như đáng phải có! Và đừng tiếp tục phạm tội. Vì một số kẻ chẳng có hiểu biết gì về Thiên Chúa — Tôi nói điều này chỉ về nỗi xấu hổ của anh chị em.<verse eid="1CO 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Tuy nhiên, một kẻ nọ sẽ bảo: “Người chết được khiến sống lại bằng cách nào, mà họ đến với kiểu thân thể gì?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Người dại dột kia ơi! Thứ mà anh đem gieo chẳng được làm cho sống nếu nó không chết đi. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Và thứ anh đem gieo thì không phải hình thể nó sẽ trở thành, trái lại, anh đem gieo chỉ là hạt giống — chẳng hạn nó có thể là hạt lúa mì hay hạt gì khác. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Nhưng Thiên Chúa ban cho nó một hình thể tùy theo ý Ngài muốn, và cho mỗi hạt giống một hình thể riêng. <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />Chẳng phải mọi xác thịt là cùng một xác thịt. Trái lại là xác thịt khác biệt của loài người, xác thịt khác biệt của các loài thú, xác thịt khác biệt của các loài chim và xác thịt khác biệt của các loài cá. <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />Cũng có các hình thể trên trời và các hình thể dưới đất. Tuy nhiên, vinh quang thuộc về trời là thế này, còn vinh quang thuộc về đất là thế kia. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Vinh quang của mặt trời là thế này, vinh quang của mặt trăng là thế kia, và vinh quang của các ngôi sao thì khác nữa. Vì ngôi sao này khác biệt với ngôi sao kia về vinh quang. <verse eid="1CO 15:41" /><verse number="42" style="v" sid="1CO 15:42" />Sự sống lại của người chết cũng như vậy. Thân thể được gieo xuống trong tình trạng mục rữa, thân thể được sống lại trong trạng thái bất diệt; <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />được gieo xuống trong nhục nhã; được sống lại trong vinh quang; được gieo xuống trong yếu đuối, được sống lại trong năng quyền; <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />được gieo xuống là thân thể tự nhiên, được sống lại là thân thể thiêng liêng. Nếu có thân thể tự nhiên, thì cũng có thân thể thiêng liêng. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />Cho nên cũng có lời chép: “Người đầu tiên là A-đam đã trở thành linh hồn sống.” A-đam cuối cùng là thần linh ban sự sống. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Nhưng không phải thân thể thiêng liêng có trước, mà là thân thể tự nhiên, sau đó mới đến thân thể thiêng liêng. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Người thứ nhất ra từ đất, là người thuộc về đất. Người thứ hai đến từ trời. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Người thuộc về đất ấy thể nào, thì những kẻ thuộc về đất cũng thể ấy; và Đấng thuộc về trời thể nào, thì những người thuộc về trời cũng thể ấy. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Như chúng ta đã mang hình ảnh của người thuộc về đất, thì chúng ta cũng cần mang<note caller="+" style="f"><char style="ft" closed="false">Thay vì </char><char style="fq">cần mang</char>, một số thủ bản cổ đọc <char style="fqa">sẽ mang</char>.</note> hình ảnh của Đấng thuộc về trời.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Mặt khác, thưa anh chị em, tôi xin nói điều này, rằng thịt và huyết không thể hưởng được vương quốc của Thiên Chúa. Điều hư hoại cũng chẳng hưởng được điều không hư hoại. <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" />Xem này, tôi cho anh chị em biết một huyền nhiệm: Chẳng phải tất cả chúng ta sẽ ngủ, nhưng tất cả chúng ta sẽ được biến hóa, <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />trong tích tắc, trong chớp mắt, vào tiếng kèn chót. Vì kèn sẽ vang lên, và những người chết sẽ được khiến sống lại trong tình trạng không hư hoại, rồi chúng ta sẽ được biến hóa. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Vì bắt buộc thân thể hư hoại này mặc lấy sự bất diệt, và thân thể phải chết này mặc lấy sự bất tử. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Rồi khi thân thể hư hoại này đã mặc lấy sự bất diệt, và thân thể phải chết này đã mặc lấy sự bất tử, thì lúc ấy, lời đã chép sẽ xảy ra, rằng:</para>
  <para style="q1" vid="1CO 15:54">“Sự chết đã bị nuốt chửng trong sự đắc thắng.”<verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />“Hỡi sự chết, sự thắng của ngươi ở đâu?</para>
  <para style="q1" vid="1CO 15:55">Hỡi sự chết, cái nọc của ngươi ở đâu?”<verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />Mà cái nọc của sự chết là tội lỗi, còn quyền lực của tội lỗi là luật pháp. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Nhưng dâng lên Thiên Chúa lời cảm tạ, Đấng ban cho chúng ta sự đắc thắng qua Chúa chúng ta, là Chúa Cứu Thế Giê-xu! <verse eid="1CO 15:57" /><verse number="58" style="v" sid="1CO 15:58" />Bởi vậy, anh chị em yêu dấu của tôi ơi, hãy trở nên vững vàng, không dời đổi, khi luôn luôn dư dật trong công việc Chúa, vì biết rằng sự khó nhọc của anh chị em chẳng phải là vô ích trong Chúa.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Về việc quyên góp cho các thánh đồ, theo như tôi đã hướng dẫn cho các hội thánh vùng Ga-la-ti, anh chị em cũng hãy làm như vậy. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Mỗi ngày đầu tuần, từng người trong anh chị em hãy để riêng ra, khi tích góp tài vật nào đó nếu người ấy được ban huê lợi, để khi tôi đến, sẽ không cần phải quyên góp gì nữa lúc đó. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Mặt khác, khi tôi đến, nếu anh chị em ưng thuận những người nào, thì tôi sẽ sai phái họ mang tặng phẩm của anh chị em cùng với thư từ đến Giê-ru-sa-lem. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Còn nếu việc ấy cũng là điều đáng để tôi phải đi, thì họ sẽ lên đường với tôi. <verse eid="1CO 16:4" /><verse number="5" style="v" sid="1CO 16:5" />Nhưng tôi sẽ đến với anh chị em sau khi bản thân đã đi qua Ma-xê-đoan, vì tôi đang đi ngang qua Ma-xê-đoan. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />Rồi có thể tôi sẽ ở lại với anh chị em, hay thậm chí trải qua suốt mùa đông, để anh chị em có thể tiễn tôi lên đường nếu tôi cần đi đâu đó. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Bởi tôi không muốn gặp anh chị em lúc này trên đường đi ngang qua, vì tôi hy vọng cứ ở với anh chị em một thời gian, nếu Chúa cho phép. <verse eid="1CO 16:7" /><verse number="8" style="v" sid="1CO 16:8" />Nhưng tôi sẽ ở lại tại Ê-phê-sô cho đến Lễ Ngũ Tuần, <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />vì một cánh cửa rộng và hiệu quả đã mở ra cho tôi, mà nhiều cái khác thì đang ngăn cản tôi.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Mặt khác, nếu Ti-mô-thê đến, hãy chú ý để cậu ấy ở với anh chị em theo cách không gì phải e ngại, vì cậu ấy đang làm công việc Chúa, y như tôi. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Do đó, chẳng một ai nên xem thường cậu ấy. Nhưng hãy giúp cậu ấy lên đường bình an, để cậu ấy có thể đến với tôi, vì tôi đang mong đợi cậu ấy cùng với những anh em khác. <verse eid="1CO 16:11" /><verse number="12" style="v" sid="1CO 16:12" />Còn về người anh em A-bô-lô, tôi đã ra sức khích lệ anh ấy để cho anh ấy đến với anh chị em cùng những anh em khác, mà đó không phải là ý muốn của anh ấy gì cả sao cho anh ấy đến vào lúc này. Tuy nhiên anh ấy sẽ đến khi có cơ hội.<verse eid="1CO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Hãy cảnh giác; hãy đứng vững trong đức tin; hãy can đảm đáng bậc trượng phu; hãy mạnh mẽ. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Hãy để mọi việc của anh chị em được diễn ra trong tình yêu thương.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />Mặt khác, thưa anh chị em, tôi khích lệ anh chị em (anh chị em biết người nhà của Sê-pha-na, rằng họ là trái đầu mùa tại A-chai, và họ đã tự dẫn thân vào công tác phục vụ các thánh đồ), <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />để cho anh chị em cũng thuận phục những người như thế lẫn tất cả những ai đang đồng công và lao nhọc. <verse eid="1CO 16:16" /><verse number="17" style="v" sid="1CO 16:17" />Tôi vui mừng về việc Sê-pha-na, Phốt-tu-na và A-chai-cơ đến, vì họ đã bù đắp điều chi còn thiếu từ nơi anh chị em; <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />vì họ đã làm tươi mới lại tinh thần của tôi và của anh chị em. Vậy, hãy công nhận những người như thế.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Các hội thánh tỉnh A-si gửi lời chào đến anh chị em. A-qui-la và Bê-rít-sin, cùng với hội thánh nhóm tại nhà của họ, nồng nhiệt chào thăm anh chị em trong Chúa. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Tất cả các anh em chào thăm anh chị em. Hãy chào nhau bằng nụ hôn thánh.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Lời chào này là bởi chính tay tôi — Phao-lô. <verse eid="1CO 16:21" /><verse number="22" style="v" sid="1CO 16:22" />Nếu kẻ nào không kính mến Chúa, thì kẻ đó phải chịu sự nguyền rủa! Lạy Chúa chúng con, xin Ngài đến! <verse eid="1CO 16:22" /><verse number="23" style="v" sid="1CO 16:23" />Nguyện xin ân điển của Chúa Giê-xu ở với anh chị em. <verse eid="1CO 16:23" /><verse number="24" style="v" sid="1CO 16:24" />Tình yêu thương của tôi ở với tất cả anh chị em trong Chúa Cứu Thế Giê-xu. A-men. <note caller="+" style="f"><char style="ft" closed="false">Một số phiên bản bỏ chữ </char><char style="fqa">A-men.</char></note><verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>