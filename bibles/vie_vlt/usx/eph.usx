<usx version="3.0">
  <book code="EPH" style="id">EN_VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:37:43 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Ephesians</para>
  <para style="toc1">Thư Ê-phê-sô</para>
  <para style="toc2">Ê-phê-sô</para>
  <para style="toc3">Eph</para>
  <para style="mt">Ê-phê-sô</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Phao-lô, sứ đồ của Chúa Cứu Thế Giê-xu bởi ý muốn của Thiên Chúa, gửi cho các thánh đồ, là các tín hữu ở tại Ê-phê-sô <note caller="+" style="f"><char style="ft" closed="false">Nhiều phiên bản cũ hơn không bao gồm </char><char style="fqa">ở tại Ê-phê-sô</char></note> và là những người trung thành trong Chúa Cứu Thế Giê-xu. <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />Nguyện ân điển và sự bình an từ Thiên Chúa, Cha chúng ta, và Chúa, là Chúa Cứu Thế Giê-xu, đến trên anh chị em.<verse eid="EPH 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Đáng ngợi khen Thiên Chúa, Cha của Chúa Cứu Thế Giê-xu, Chúa chúng ta, là Đấng đã xuống phước cho chúng ta với mọi phước hạnh thuộc linh ở các nơi trên trời trong Chúa Cứu Thế, <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />cũng như Ngài đã chọn chúng ta trong Chúa Cứu Thế từ trước khi sáng lập thế giới, để chúng ta được nên thánh và không chỗ chê trách trước mặt Ngài. Bởi tình yêu thương <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />Ngài đã định trước chúng ta cho địa vị con nuôi của Ngài qua Chúa Cứu Thế Giê-xu, theo sự vui thỏa của ý muốn Ngài, <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />để kết quả bằng sự ngợi khen vinh hiển của ân điển Ngài mà Ngài đã rộng rãi ban tặng cho chúng ta trong Con Yêu Dấu của Ngài, <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />mà trong Con ấy, chúng ta có sự cứu chuộc nhờ huyết Ngài, sự tha thứ tội lỗi theo sự giàu có của ân điển Ngài, <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />là ân điển mà Ngài đã ban cho chúng ta cách dư dật trong mọi sự khôn ngoan và thông sáng, <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />khiến cho chúng ta nhận biết sự huyền nhiệm của ý muốn Ngài theo điều vui lòng Ngài, là điều mà Ngài đã hoạch định từ trước trong Chúa Cứu Thế, <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />để khi đến kỳ hạn hoàn tất chương trình đã ấn định, thì quy tụ muôn vật lại trong Chúa Cứu Thế, gồm các vật trên trời lẫn các vật dưới đất, trong Ngài, <verse eid="EPH 1:10" /><verse number="11" style="v" sid="EPH 1:11" />tức trong Đấng mà chúng ta cũng được chia phần cơ nghiệp, vì đã được định trước theo mục đích của Đấng làm nên mọi việc y như chương trình của ý muốn Ngài, <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />hầu cho chúng ta, những người trước hết đặt hy vọng nơi Chúa Cứu Thế, được kết quả bằng sự ngợi khen về vinh hiển của Ngài. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />Lại cũng trong Ngài, sau khi nghe đạo của chân lý, là Phúc Âm về sự cứu rỗi anh chị em, và khi đã tin nơi Ngài, thì anh chị em đã được ấn chứng bằng Chúa Thánh Linh theo lời hứa, <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />mà Đấng ấy là sự bảo chứng về cơ nghiệp của chúng ta cho đến khi chuộc mua toàn bộ sản nghiệp, để kết quả bằng sự ngợi khen về vinh hiển của Ngài.<verse eid="EPH 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Vì vậy, kể từ khi tôi nghe về đức tin của anh chị em trong Chúa, là Chúa Giê-xu, và tình yêu thương <note caller="+" style="f"><char style="ft" closed="false">Một số thủ bản không có từ </char><char style="fqa">tình yêu thương</char>, nhưng các thủ bản đáng tin cậy nhất có từ này. </note> dành cho tất cả các thánh đồ, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />thì tôi không ngừng dâng lời cảm tạ vì anh chị em, nhắc đến anh chị em trong lời cầu nguyện của mình, <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />hầu cho Thiên Chúa của Chúa Cứu Thế Giê-xu, Chúa chúng ta, là Cha vinh hiển, sẽ ban cho anh chị em thần linh của sự khôn ngoan và sự mạc khải trong việc nhận biết Ngài, <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />khiến con mắt của lòng anh chị em được soi sáng, để anh chị em biết niềm hy vọng về sự kêu gọi của Ngài là gì, sự giàu có của cơ nghiệp vinh hiển Ngài trong các thánh đồ ra sao, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />và sự vĩ đại không gì ví sánh của quyền năng Ngài là thể nào đối với chúng ta, là những người có lòng tin, theo sự vận hành bởi sức mạnh năng quyền của Ngài, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />mà Ngài đã thực hiện trong Chúa Cứu Thế khi khiến Chúa Cứu Thế từ cõi chết sống lại và đặt ngồi bên phải Ngài ở các nơi trên trời, <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />vượt xa trên mọi uy quyền, thẩm quyền, năng quyền, và chủ quyền, cùng mọi tước hiệu được xướng danh, không chỉ trong đời này mà cả trong đời sắp đến nữa. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Ngài đã khiến muôn vật phục dưới chân Chúa Cứu Thế và đặt Chúa Cứu Thế làm đầu ở trên mọi sự đối với hội thánh, <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />mà hội thánh là thân thể Ngài, là sự đầy trọn của Đấng làm đầy trọn mọi sự trong mọi loài.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Về phần anh chị em, là kẻ chết trong các vi phạm và tội lỗi mình, <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />là trong những điều mà khi trước, anh chị em đã ăn ở theo dòng chảy của thế gian này, theo kẻ cai trị với thẩm quyền chốn không trung, là tà linh hiện đang hành động trong các con cái không vâng phục, <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />mà trước kia, ở giữa họ, hết thảy chúng ta cũng đã sống trong các dục vọng của xác thịt mình, thực hiện những ham muốn của xác thịt và tâm trí. Theo bản chất tự nhiên, chúng ta vốn là con cái của sự thịnh nộ cũng như mọi người khác. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Nhưng Thiên Chúa, là Đấng giàu lòng thương xót, vì tình yêu lớn lao của Ngài mà Ngài đã yêu chúng ta, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />nên khi chúng ta là những kẻ chết trong các vi phạm mình, thì Ngài đã khiến chúng ta cùng sống trong Chúa Cứu Thế — đó là nhờ ân điển mà anh chị em đã được cứu — <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Ngài khiến chúng ta cùng sống lại, và đặt ngồi cùng với Ngài ở các nơi trên trời trong Chúa Cứu Thế Giê-xu, <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />để trong các thời đại sắp đến, Ngài có thể tỏ ra sự giàu có vô hạn của ân điển Ngài qua sự nhân từ đối với chúng ta trong Chúa Cứu Thế Giê-xu. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Vì bởi ân điển, anh chị em được cứu nhờ đức tin, điều này không xuất phát từ anh chị em, mà là tặng phẩm của Thiên Chúa, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />chẳng phải ra từ các việc làm, để không một ai có thể khoe khoang. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Vì chúng ta là tác phẩm của Ngài, được tạo dựng trong Chúa Cứu Thế Giê-xu cho những việc lành mà Thiên Chúa đã chuẩn bị trước để chúng ta có thể sống trong những việc ấy.<verse eid="EPH 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Do đó, hãy nhớ rằng trước đây, anh chị em là dân ngoại quốc trong xác thịt, dân bị gọi là “chưa chịu cắt bì” bởi dân được gọi là “đã được cắt bì” trong xác thịt, một nghi thức do tay con người thực hiện, <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />vì khi đó, anh chị em vốn bị tách biệt với Chúa Cứu Thế, khi bị để bên ngoài cộng đồng Y-sơ-ra-ên, và vốn là khách lạ đối với các giao ước của lời hứa, nên chẳng có hy vọng, cũng không có Thiên Chúa trong thế gian này. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Nhưng, trong Chúa Cứu Thế Giê-xu, anh chị em, những người lúc trước vốn xa cách, giờ đây đã được đem đến gần nhờ huyết của Chúa Cứu Thế. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Vì chính Ngài là sự hòa bình của chúng ta, là Đấng đã làm cho cả hai trở nên một và phá hủy bức tường của sự chia rẽ, tức là sự thù địch, trong thân xác Ngài, <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />khi đã bãi bỏ luật của các điều răn trong những quy định, hầu cho Ngài có thể khiến cả hai trở nên một người mới trong Ngài, thiết lập hòa bình, <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />và để Ngài có thể hòa giải cả hai với Thiên Chúa trong một thân thể qua thập tự giá, sau khi tiêu diệt tình trạng thù địch trên đó. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Lúc Ngài đã đến, Ngài rao truyền sự hòa bình cho anh chị em, là những người ở xa, và sự hòa bình cho những người ở gần, <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />vì nhờ Ngài, cả hai có quyền bước đến gần trong một Thánh Linh để đến với Cha. <verse eid="EPH 2:18" /><verse number="19" style="v" sid="EPH 2:19" />Vậy nên, anh chị em không còn là khách lạ hay người ngoại quốc nữa. Thay vào đó, anh chị em là người đồng hương với các thánh đồ và là thành viên trong gia đình của Thiên Chúa, <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />vì đã được xây dựng trên nền của các sứ đồ và các tiên tri, khi chính Chúa Cứu Thế Giê-xu là đá góc nhà, <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />mà trong Ngài, cả công trình xây cất, khi được liên kết với nhau, thì hình thành nên một đền thờ thánh trong Chúa, <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />và cũng trong Ngài, anh chị em được gây dựng chung với nhau thành nơi ngự của Thiên Chúa trong Thánh Linh.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Vì lý do đó, tôi, Phao-lô, là tù nhân của Chúa Cứu Thế Giê-xu vì cớ anh chị em dân ngoại — <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />vì hẳn là anh chị em đã nghe về việc quản trị ân điển của Thiên Chúa, là điều đã được giao cho tôi vì anh chị em, <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />theo sự mạc khải đã được tỏ cho tôi, tức là sự huyền nhiệm như tôi đã viết cách vắn tắt ở trên. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Khi đọc đến điều ấy, anh chị em sẽ có thể nhận ra sự am hiểu của tôi về sự huyền nhiệm của Chúa Cứu Thế, <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />là điều đã không được bày tỏ cho con cái loài người trong các thế hệ trước, trong khi hiện nay, bởi Thánh Linh, điều ấy đã được bày tỏ cho các sứ đồ thánh của Ngài cùng các tiên tri — <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />đó là: các dân ngoại là kẻ đồng kế tự, là các chi thể trong cùng một thân, và là những người cùng chia sẻ lời hứa trong Chúa Cứu Thế Giê-xu thông qua Phúc Âm, <verse eid="EPH 3:6" /><verse number="7" style="v" sid="EPH 3:7" />vì Phúc Âm đó mà tôi đã được trở nên một tôi tớ dựa trên tặng phẩm ân điển của Thiên Chúa, là điều đã được ban cho tôi theo sự vận hành của quyền năng Ngài. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Ân điển ấy đã được ban cho tôi — kẻ thấp kém nhất trong tất cả các thánh đồ — để rao giảng cho các dân ngoại sự giàu có không dò được của Chúa Cứu Thế, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />và để làm sáng tỏ cho mọi người đâu là việc quản trị sự huyền nhiệm, là điều đã được giấu kín trải qua các thời đại trong Thiên Chúa, Đấng sáng tạo muôn vật, <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />hầu cho giờ đây, qua hội thánh, sự khôn ngoan thiên hình vạn trạng của Thiên Chúa có thể được bày tỏ cho các đấng cai trị và những bậc thẩm quyền ở các nơi trên trời, <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />theo mục đích đời đời mà Ngài đã hoàn tất trong Chúa Cứu Thế Giê-xu, Chúa chúng ta, <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />mà trong Đấng ấy, chúng ta có lòng mạnh dạn và lối đi đến gần Thiên Chúa với sự tự tin nhờ đức tin nơi Ngài. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Thế nên, tôi xin anh chị em đừng nản lòng bởi những hoạn nạn của tôi vì cớ anh chị em, mà những hoạn nạn ấy là sự vinh hiển của anh chị em.<verse eid="EPH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Vì lý do đó, tôi quỳ gối trước mặt Cha, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />là Đấng mà từ Ngài, mọi gia tộc trên trời và dưới đất được đặt tên, <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />để xin Ngài, tùy theo sự giàu có của vinh hiển Ngài, khiến anh chị em được mạnh mẽ với năng quyền qua Thánh Linh của Ngài nơi con người bề trong, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />để Chúa Cứu Thế cư ngụ trong lòng anh chị em thông qua đức tin, khi đã được đâm rễ và vững nền trong tình yêu thương, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />hầu cho anh chị em cùng với hết thảy các thánh đồ, có đủ sức để hiểu thấu như thế nào là rộng, dài, cao, sâu, <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />và để nhận ra điều vượt quá sự hiểu biết, chính là tình yêu của Chúa Cứu Thế, hầu cho anh chị em được đổ đầy bằng mọi sự đầy trọn của Thiên Chúa.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Xin hướng về Đấng có thể thực hiện vượt quá mọi điều mà chúng ta cầu xin hoặc suy tưởng, theo quyền năng đang vận hành trong chúng ta, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />nguyện Ngài được vinh hiển trong hội thánh và trong Chúa Cứu Thế Giê-xu trải qua mọi thế hệ đời đời vô cùng. A-men.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Thế nên, tôi, người tù trong Chúa, nài khuyên anh chị em phải sống cách xứng đáng với sự kêu gọi mà anh chị em đã được gọi đến, <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />bằng tất cả sự khiêm nhường và hiền hòa, cùng với lòng kiên nhẫn, chịu đựng lẫn nhau trong tình yêu thương, <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />cố gắng hết sức để giữ sự hiệp một của Thánh Linh trong mối liên kết thuận hòa. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Chỉ một thân thể và một Thánh Linh, cũng như anh em đã được gọi đến một niềm hy vọng trong sự kêu gọi của mình, <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />chỉ một Chúa, một đức tin, một phép báp-têm, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />chỉ một Thiên Chúa, Cha của mọi người, Đấng ở trên mọi người, qua mọi người và trong mọi người. <verse eid="EPH 4:6" /><verse number="7" style="v" sid="EPH 4:7" />Nhưng, ân điển đã được ban cho mỗi một người chúng ta tùy theo mức độ trong sự ban cho của Chúa Cứu Thế. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Do đó, có lời chép:</para>
  <para style="q1" vid="EPH 4:8">“Khi Ngài ngự lên các nơi cao,</para>
  <para style="q1" vid="EPH 4:8">Ngài đi trước dẫn theo đoàn phu tù,</para>
  <para style="q1" vid="EPH 4:8">và ban nhiều tặng phẩm cho loài người.”<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />Tuy nhiên, “Ngài ngự lên” nghĩa là gì nếu không phải là Ngài cũng đã xuống đến các nơi thấp của đất? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Chính Đấng đã xuống cũng là Đấng đã ngự lên cao hơn hết thảy các tầng trời, để Ngài có thể làm đầy dẫy mọi sự. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Chính Ngài đã đặt một số làm sứ đồ, một số làm tiên tri, một số làm nhà truyền giảng Phúc Âm, một số làm mục sư và thầy giáo, <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />để đem đến sự trang bị các thánh đồ cho công tác phục vụ, hướng tới sự gây dựng thân thể của Chúa Cứu Thế, <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />cho đến khi tất cả chúng ta đạt đến sự hiệp một trong đức tin và sự hiểu biết Con Thiên Chúa, trở nên người trưởng thành, đạt đến tầm vóc trọn vẹn của Chúa Cứu Thế, <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />để chúng ta không còn là trẻ con, bị xô đẩy và cuốn lôi theo mọi chiều gió học thuyết bởi thủ đoạn của người ta nhờ tính mưu mẹo với sự gian dối, xảo quyệt. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Thay vào đó, khi nói ra chân lý trong tình yêu thương, chúng ta có thể tăng trưởng ở mọi phương diện hướng đến Ngài, Đấng là đầu, tức là Chúa Cứu Thế, <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />từ nơi Ngài mà cả thân thể được hiệp lại và liên kết với nhau nhờ mọi mối ràng buộc hỗ trợ, theo như mức độ hoạt động trong mỗi một bộ phận, làm cho thân thể tăng trưởng để tự gây dựng trong tình yêu thương.<verse eid="EPH 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Do đó, tôi nói điều này và khuyên giục anh chị em trong Chúa để không còn ăn ở giống như dân ngoại nữa, họ sống trong sự hư không của tâm trí mình. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Vì tâm trí họ đã bị làm cho tăm tối, trở nên xa lạ với sự sống của Thiên Chúa bởi sự ngu muội ở trong họ, bởi lòng họ cứng cỏi. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Khi trở nên vô cảm bất cần, họ đã buông mình vào sự khoái lạc để phạm mọi điều ô uế với lòng mê tham. <verse eid="EPH 4:19" /><verse number="20" style="v" sid="EPH 4:20" />Nhưng anh chị em đã không học biết Chúa Cứu Thế như vậy, <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />vì hẳn là anh chị em đã nghe về Ngài và đã được dạy dỗ trong Ngài, theo như chân lý ở trong Chúa Giê-xu, <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />rằng phải cởi bỏ khỏi anh chị em những gì thuộc về lối sống trước đây, tức là con người cũ bị hư hoại vì dục vọng gian trá, <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />mà được làm nên mới nhờ thần linh trong tâm trí mình, <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />và mặc vào con người mới, là người được dựng nên theo Thiên Chúa — trong sự công chính và sự thánh khiết của chân lý.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Thế nên, khi đã từ bỏ sự dối trá, mỗi người phải nói điều chân thật với người lân cận mình, vì cớ chúng ta là chi thể của nhau. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Anh chị em được nổi giận mà không phạm tội. Hãy để mặt trời không lặn trên điều chọc giận anh chị em, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />cũng đừng tạo cơ hội cho ma quỷ. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Kẻ trộm cắp đừng trộm cắp nữa. Nhưng, tốt hơn, người ấy phải gắng sức làm việc thiện lành bằng chính đôi tay mình, hầu cho người ấy có vật chi để chia sẻ với những ai đang ở trong hoàn cảnh thiếu thốn. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Đừng để lời nói bẩn thỉu nào thốt ra từ miệng anh chị em, mà hãy nói những lời nào tốt lành hướng đến sự gây dựng người nào trong cảnh khó khăn, để lời ấy có thể đem ân huệ cho người nghe, <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />và đừng làm buồn Chúa Thánh Linh của Thiên Chúa, bởi Ngài mà anh chị em được ấn chứng cho ngày cứu chuộc. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Hãy loại bỏ khỏi anh chị em tất cả cay đắng, phẫn nộ, giận dữ, cãi vả, xúc phạm, cùng mọi điều gian ác. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Thay vào đó, hãy bày tỏ cho nhau lòng nhân từ, thương xót, tha thứ nhau cũng như Thiên Chúa đã tha thứ anh chị em trong Chúa Cứu Thế.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Vậy, hãy trở nên những người noi theo Thiên Chúa, như con cái rất được yêu dấu của Ngài, <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />và hãy sống trong tình yêu thương, cũng như Chúa Cứu Thế đã yêu chúng ta và hy sinh chính Ngài vì chúng ta như một lễ vật và sinh tế với hương thơm ngào ngạt dâng lên Thiên Chúa.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Còn sự gian dâm, cùng mọi điều bất khiết hay tham lam thì thậm chí chớ được nhắc đến giữa vòng anh chị em, như điều ấy là phù hợp với các thánh đồ, <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />cũng đừng nói lời tục tĩu, lời nhảm nhí, hay lời đùa cợt thô bỉ — là những thứ không thích hợp — mà thay vào đó bằng lời cảm tạ. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Thật vậy, hãy biết điều này cho chắc chắn rằng mọi kẻ gian dâm, bất khiết, hoặc tham lam — tức là kẻ thờ hình tượng — đều không có cơ nghiệp trong vương quốc của Chúa Cứu Thế và Thiên Chúa. <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />Đừng để ai lừa dối anh chị em bằng những lời lẽ rỗng tuếch, vì bởi những điều ấy, cơn thịnh nộ của Thiên Chúa giáng xuống trên các con cái không vâng phục. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Cho nên, anh chị em đừng trở nên những kẻ dự phần với họ, <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />vì trước kia anh chị em còn tăm tối, nhưng nay là ánh sáng trong Chúa. Hãy ăn ở như con cái của sự sáng <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />(vì bông trái của sự sáng ở giữa mọi điều tốt lành, công chính, và chân thật), <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />khi cẩn thận xem xét đâu là điều đẹp lòng Chúa. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Đừng dự phần vào các việc vô ích của sự tối tăm, nhưng hãy phơi bày chúng ra thì hơn, <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />vì thật là xấu hổ khi chỉ nhắc đến những việc họ thực hiện cách kín giấu. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Nhưng mọi vật được thấy rõ khi được phơi bày bởi ánh sáng, vì mọi vật được thấy rõ đều là ánh sáng. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Do đó, có lời phán:</para>
  <para style="q1" vid="EPH 5:14">“Hãy tỉnh dậy, hỡi người đang ngủ,</para>
  <para style="q1" vid="EPH 5:14">hãy trỗi dậy từ trong đám người chết,</para>
  <para style="q1" vid="EPH 5:14">Chúa Cứu Thế sẽ chiếu sáng ngươi.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Thế nên, hãy coi chừng cẩn thận cách anh chị em đang ăn ở — đừng như kẻ dại dột nhưng như người khôn ngoan, <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />khi tận dụng thì giờ, vì những ngày là xấu. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Vì vậy, đừng trở nên kẻ dại dột, nhưng phải hiểu đâu là ý muốn của Chúa. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />Đừng say rượu, bởi điều đó là buông tuồng. Trái lại, hãy được đầy dẫy với Thánh Linh, <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />đối đáp với nhau bằng thi thiên, thánh ca và khúc hát thiêng liêng, với tấm lòng mình hát xướng và chúc tụng Chúa, <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />dâng lời tạ ơn Thiên Chúa, là Cha, trong mọi lúc về mọi điều nhân danh Chúa Cứu Thế Giê-xu, Chúa chúng ta, <verse eid="EPH 5:20" /><verse number="21" style="v" sid="EPH 5:21" />và thuận phục nhau trong sự kính sợ Chúa Cứu Thế —<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />người làm vợ, phải thuận phục chồng mình như thuận phục Chúa. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Vì chồng là đầu vợ, cũng như Chúa Cứu Thế là đầu hội thánh — chính Ngài là Cứu Chúa của thân thể. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Tuy nhiên, hội thánh thuận phục Chúa Cứu Thế thể nào thì vợ cũng thuận phục chồng mình trong mọi việc thế ấy. <verse eid="EPH 5:24" /><verse number="25" style="v" sid="EPH 5:25" />Người làm chồng, hãy yêu vợ mình, cũng như Chúa Cứu Thế đã yêu hội thánh và hy sinh chính mình vì hội thánh, <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />để Ngài có thể thánh hóa hội ấy, sau khi làm cho thanh sạch bằng sự tẩy rửa của nước cùng với lẽ đạo, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />hầu cho Ngài đem trình diện cho chính mình một hội thánh vinh hiển, không có vết ố hay nếp nhăn, hoặc bất kỳ điều nào như thế, nhưng để hội được thánh khiết và không chỗ chê trách. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Theo cách như thế thì chồng cũng phải yêu vợ mình như chính thân mình. Người chồng yêu vợ của mình là yêu chính mình. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Bởi chẳng ai ghét thân mình bao giờ, nhưng nuôi dưỡng và chăm sóc nó, cũng như cách Chúa Cứu Thế đối với hội thánh, <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />vì chúng ta là các chi thể của thân Ngài. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />“Vì lý do đó, người đàn ông sẽ lìa cha mẹ và sẽ được kết hiệp với vợ mình, cả hai sẽ trở nên một thịt.” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Điều huyền nhiệm này thật lớn lao — nhưng tôi đang nói về Chúa Cứu Thế và về hội thánh. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Dầu vậy, anh chị em cũng theo cách đó — từng người một — mỗi người chồng phải yêu vợ mình như chính mình, còn người vợ ấy là cần kính phục chồng mình.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Người làm con, hãy vâng lời cha mẹ của các con trong Chúa, vì đó là điều phải lẽ. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“Hãy hiếu kính cha mẹ của con” (đó là điều răn đầu tiên kèm theo lời hứa), <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“để phước lành đến với con và con có thể được sống lâu trên đất.” <verse eid="EPH 6:3" /><verse number="4" style="v" sid="EPH 6:4" />Người làm cha, đừng chọc giận con cái mình. Thay vào đó, hãy nuôi dưỡng chúng trong sự sửa trị và chỉ dẫn của Chúa.<verse eid="EPH 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Người làm tôi tớ, hãy vâng phục người chủ theo phần xác với sự kính nể và run sợ nơi lòng thành thật của mình, giống như đối với Chúa Cứu Thế, <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />không phải với kiểu phục vụ khi chủ giám sát như những kẻ muốn lấy lòng, nhưng như tôi tớ của Chúa Cứu Thế, thực hiện ý muốn của Thiên Chúa bằng cả tâm hồn, <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />vâng phục với lòng nhiệt thành, như phục vụ cho Chúa mà không phải cho người ta, <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />vì biết rằng mỗi người, dù nô lệ hay tự do, hễ làm việc lành nào, thì người ấy sẽ nhận điều tương ứng từ nơi Chúa.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Và, người làm chủ, phải đối xử cùng cách đó với các tôi tớ, khi ngừng việc dọa nạt, vì biết rằng Người Chủ vừa của họ vừa của anh em đang ở trên trời, và không có sự thiên vị nơi Ngài.<verse eid="EPH 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Sau cùng, hãy được làm cho mạnh mẽ trong Chúa, và trong sức mạnh năng quyền của Ngài. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Hãy mặc vào toàn bộ binh giáp của Thiên Chúa, để làm cho anh chị em có thể đứng vững, chống lại các gian kế của ma quỷ. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Vì cuộc chiến đấu của chúng ta không phải là nghịch với máu và xác thịt, nhưng là chống lại các bá chủ, chống lại các đấng thẩm quyền, chống lại các bậc thống trị thế gian tăm tối này, chống lại các tà linh ở các nơi trên trời. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Vì cớ đó, hãy mặc vào toàn bộ binh giáp của Thiên Chúa, để anh chị em có thể chống chọi trong ngày tàn ác, và đứng vững vàng sau khi hoàn tất mọi sự. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />Thế nên, hãy đứng vững, khi thắt dây lưng của anh chị em bằng chân lý, mặc lấy áo giáp của sự công chính, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />mang vào chân sự sẵn sàng của Phúc Âm bình an, <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />nâng cao tấm khiên của đức tin trong mọi sự, bởi đó mà anh chị em sẽ có thể dập tắt mọi tên lửa của kẻ ác. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Hãy dùng mũ giáp cứu rỗi và gươm Thánh Linh, mà đó là lời của Thiên Chúa, <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />khi cầu nguyện mọi lúc trong Thánh Linh thông qua mọi lời cầu khẩn và nài xin, và hướng đến kết quả trong khi tỉnh thức bằng tất cả sự kiên trì và sự cầu thay dành cho hết thảy các thánh đồ, <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />và dành cho tôi, để sứ điệp có thể được ban cho tôi, trong việc mở miệng của tôi với sự dạn dĩ để công bố sự huyền nhiệm của Phúc Âm <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />(vì Phúc Âm ấy mà tôi trở nên sứ giả giữa vòng xiềng xích), hầu cho trong hoàn cảnh đó, tôi có thể mạnh dạn rao giảng theo như bổn phận tôi phải nói.<verse eid="EPH 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Nhưng để anh chị em cũng có thể biết những chuyện liên hệ đến tôi, tôi đang làm gì, thì Ty-chi-cơ, người anh em yêu dấu và đầy tớ trung thành trong Chúa, sẽ cho anh chị em biết mọi chuyện, <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />anh ấy là người mà tôi đã phái đến với anh chị em vì mục đích này, để anh chị em có thể biết tình hình về chúng tôi và lòng anh chị em được khích lệ.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Nguyện sự bình an ban cho anh chị em, cùng với tình yêu thương và đức tin từ Thiên Chúa, là Cha và Chúa, là Chúa Cứu Thế Giê-xu. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Nguyện ân điển ở cùng tất cả những người yêu mến Chúa Cứu Thế Giê-xu, Chúa chúng ta, bằng tình yêu bất diệt.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>