  <book code="TIT" style="id">EN_VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:39:47 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Titus</para>
  <para style="toc1">Thư Tít</para>
  <para style="toc2">Tít</para>
  <para style="toc3">Tit</para>
  <para style="mt">Tít</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />Phao-lô, tôi tớ của Thiên Chúa và sứ đồ của Chúa Cứu Thế Giê-xu, vì đức tin của những người được Thiên Chúa lựa chọn và sự am hiểu chân lý phù hợp với lòng tin kính Chúa, <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />với hy vọng chắc chắn về sự sống đời đời mà Thiên Chúa, Đấng không nói dối, đã hứa từ trước mọi thời đại. <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />Nhưng vào đúng thời điểm, Ngài đã mạc khải lời Ngài qua việc công bố sứ điệp mà ta đã được giao phó theo mệnh lệnh của Thiên Chúa, Cứu Chúa của chúng ta. <verse eid="TIT 1:3" /><verse number="4" style="v" sid="TIT 1:4" />Gửi cho Tít, con thật của ta trong đức tin chung. Nguyện ân điển và sự bình an từ Thiên Chúa, là Cha, và Chúa Cứu Thế Giê-xu, Cứu Chúa của chúng ta, đến trên con.<verse eid="TIT 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />Ta đã để con lại tại Cơ-rết vì mục đích này, đó là để con có thể sắp xếp những việc còn dở dang và bổ nhiệm các trưởng lão trong mỗi thành như ta đã chỉ dẫn con — <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />người đó phải không chỗ chê trách, là chồng của một vợ, có con cái trung tín, không bị cáo buộc về lối sống buông thả hoặc vô kỷ luật. <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />Vì người chăn bầy bắt buộc phải không chỗ chê trách, như là người quản lý nhà của Thiên Chúa, không kiêu ngạo, không nhạy giận, không nghiện rượu, không gây gổ, và không tham lam, <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />thay vào đó là phải hiếu khách, yêu mến điều tốt lành, điềm tĩnh, ngay thẳng, thánh thiện, tự chủ, <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />giữ vững sứ điệp đáng tin cậy phù hợp với giáo lý, hầu cho người ấy có năng lực để vừa khích lệ người khác bằng sự dạy dỗ lành mạnh, vừa chỉnh sửa kẻ chống đối.<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />Vì có nhiều kẻ phản loạn, đám nói năng huênh hoang, và bọn lừa lọc, đặc biệt là những kẻ thuộc nhóm cắt bì. <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />Việc thiết yếu là buộc bọn họ im miệng. Họ đang gây xào xáo toàn thể các gia đình khi dạy những điều không nên dạy, vì cớ lợi lộc đáng xấu hổ. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />Một trong số họ, tức là các nhà tiên tri của chính họ, đã nói rằng: “Người Cơ-rết luôn là những kẻ nói dối, những con thú dữ, những cái bụng căng tròn lười biếng.” <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />Lời làm chứng này là thật. Vì lý do ấy, hãy quở trách họ cách nghiêm khắc, để họ có thể được lành mạnh trong đức tin, <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />không để tâm vào các chuyện hoang đường của người Do Thái hay lời răn dạy của những kẻ xoay lưng với chân lý. <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />Mọi vật đều tinh sạch cho những ai tinh sạch. Nhưng đối với kẻ bại hoại và vô tín, thì chẳng có gì tinh sạch, mà cả tâm trí lẫn lương tâm họ đều đã bị làm cho hư hoại. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />Họ tuyên bố mình biết Thiên Chúa, tuy nhiên, trong việc làm của họ, họ chối bỏ Ngài, trở nên đáng ghê tởm, không vâng lời, và không xứng với bất kỳ việc thiện lành nào.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />Nhưng con, hãy nói những gì là đúng đắn với sự dạy dỗ lành mạnh. <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />Hãy khích lệ quý ông có tuổi phải tiết độ, nghiêm trang, biết chừng mực, lành mạnh trong đức tin, trong tình yêu thương, và trong sự nhịn nhục. <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />Cũng vậy, hãy khích lệ quý bà có tuổi thể hiện sự đáng kính trong cách cư xử, không nói xấu hoặc bị nô lệ cho rượu, nhưng phải là người dạy dỗ điều tốt lành, <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />hầu cho họ có thể dạy bảo giới phụ nữ trẻ trở nên những người yêu chồng, thương con, <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />biết chừng mực, tinh sạch, giỏi trông nom việc nhà và vâng phục chồng mình, để lời của Thiên Chúa không bị xúc phạm. <verse eid="TIT 2:5" /><verse number="6" style="v" sid="TIT 2:6" />Tương tự, con hãy khuyên dạy các thanh niên phải biết chừng mực, <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />khi bày tỏ chính mình con trong mọi phương diện như tấm gương về các việc lành, bày tỏ sự liêm chính, nghiêm trang trong việc dạy dỗ, <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />với sứ điệp đúng đắn không thể chỉ trích được, để bất kỳ ai từ phe chống đối phải bị hổ thẹn vì chẳng có điều xấu nào để nói về chúng ta. <verse eid="TIT 2:8" /><verse number="9" style="v" sid="TIT 2:9" />Hãy dạy các nô lệ phải vâng phục chủ mình, làm vui lòng chủ trong mọi việc, chứ không cãi trả, <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />không ăn cắp, mà thay vào đó phải chứng tỏ hoàn toàn đáng tín nhiệm, để trong mọi cách, họ có thể đem lại tiếng thơm cho việc dạy dỗ về Thiên Chúa, Cứu Chúa chúng ta. <verse eid="TIT 2:10" /><verse number="11" style="v" sid="TIT 2:11" />Vì ân điển của Thiên Chúa để cứu rỗi mọi người đã được bày tỏ, <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />hiện đang đào luyện chúng ta, để khi đã bỏ đi sự bất kính cùng những đam mê của thế gian, chúng ta có thể sống một cách cẩn trọng, công chính và số sắng trong đời này, <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />đang khi trông đợi niềm hy vọng phước hạnh và sự hiện đến vinh quang của Thiên Chúa cao cả và Cứu Chúa chúng ta là Chúa Cứu Thế Giê-xu, <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />Đấng đã phó chính mình Ngài vì chúng ta để chuộc mua chúng ta khỏi mọi sự gian ác và để thanh tẩy cho Ngài một dân đặc biệt, là dân sốt sắng với việc lành.<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />Hãy dạy những điều đó, khích lệ và sửa trị với tất cả thẩm quyền. Đừng để ai coi thường con.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />Hãy nhắc họ vâng phục và tuân lệnh các bậc vua chúa cùng các nhà cầm quyền, phải sẵn sàng cho mọi việc lành, <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />không sỉ vả ai, không hiếu chiến, mà phải hiền hòa, tỏ ra hết sức khiêm nhường với mọi người. <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" />Vì chúng ta trước đây cũng là những kẻ ngu dại và bất tuân, bị dẫn dụ và làm nô lệ cho đủ thứ đam mê cùng lạc thú, sống trong sự gian ác và đố kỵ, đáng ghét, và thù hận nhau. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />Nhưng khi sự tốt lành và lòng nhân ái của Thiên Chúa, Cứu Chúa chúng ta, được tỏ bày, <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />thì Ngài cứu chúng ta, chẳng phải bởi các việc làm ra từ sự công chính mà chúng ta đã thực hiện, nhưng bởi lòng thương xót của Ngài, qua việc rửa sạch của ơn tái sinh và sự đổi mới bởi Chúa Thánh Linh, <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />là Đấng mà Thiên Chúa đã tuôn đổ cách dư dật trên chúng ta qua Cứu Chúa chúng ta là Chúa Cứu Thế Giê-xu, <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />để sau khi được xưng công chính nhờ ân điển Ngài, chúng ta được trở nên những người thừa kế theo như niềm hy vọng chắc chắn về sự sống đời đời. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />Sứ điệp này là đáng tin cậy, và ta muốn con nhấn mạnh vào những điều ấy, sao cho những ai đã tin Thiên Chúa sẽ cẩn thận lưu ý để dấn thân vào việc thiện lành. Những việc đó là tốt lành và hữu ích cho nhiều người. <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />Nhưng hãy tránh những cuộc tranh luận khờ dại, các bảng phả hệ, sự cãi cọ và xung khắc về luật pháp vì chúng là những thứ vô bổ và vô giá trị. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />Hãy loại trừ người nào theo dị giáo sau một hoặc hai lần cảnh cáo, <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />vì biết rằng người như thế đã bị lầm lạc và cứ phạm tội, là kẻ tự kết án mình.<verse eid="TIT 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />Khi ta sai A-tê-ma hoặc Ti-chi-cơ đến chỗ con, thì con hãy mau đến gặp ta tại Ni-cô-bô-li, vì ta đã quyết định trải qua mùa đông tại đó. <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />Hãy đưa luật sư Xê-na và A-bô-lô lên đường thật chu đáo, sao cho họ không thiếu thốn gì. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />Các anh chị em tín hữu của chúng ta cũng phải học dấn thân vào các việc thiện lành đáp ứng những nhu cầu cần thiết, để chẳng trở nên không kết quả.<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />Tất cả những người ở với ta chào thăm con. Hãy gởi lời chào thăm những người yêu mến chúng ta trong đức tin. Nguyện ân điển ở với tất cả anh chị em.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>